{"n":96,"a":[{"n":1,"w":[["ٱقْرَأْ","iq'ra","Read","(হে নবী) পড়"],["بِٱسْمِ","bi-is'mi","in (the) name","নামে"],["رَبِّكَ","rabbika","(of) your Lord","তোমার রবের"],["ٱلَّذِى","alladhī","the One Who","যিনি"],["خَلَقَ","khalaqa","created ","সৃষ্টি করেছেন"]],"t":"ٱ<q>قْ</>رَأْ بِ<h>ٱ</>سْمِ رَبِّكَ <h>ٱ</>لَّذِى خَلَ<q>قَ</>"},{"n":2,"w":[["خَلَقَ","khalaqa","He created","সৃষ্টি করেছেন"],["ٱلْإِنسَـٰنَ","l-insāna","man","মানুষকে"],["مِنْ","min","from","থেকে"],["عَلَقٍ","‘alaqin","a clinging substance","জমাট রক্তপিণ্ড"]],"t":"خَلَقَ <h>ٱ</>لْإِ<k>نسَٰ</>نَ مِنْ عَلَ<q>قٍ</>"},{"n":3,"w":[["ٱقْرَأْ","iq'ra","Read","পড়"],["وَرَبُّكَ","warabbuka","and your Lord","আর তোমার রব"],["ٱلْأَكْرَمُ","l-akramu","(is) the Most Generous","বড়ই অনুগ্রহশীল"]],"t":"ٱ<q>قْ</>رَأْ وَرَبُّكَ <h>ٱ</>لْأَكْرَمُ"},{"n":4,"w":[["ٱلَّذِى","alladhī","The One Who","যিনি"],["عَلَّمَ","‘allama","taught","শিখিয়েছেন"],["بِٱلْقَلَمِ","bil-qalami","by the pen","কলম দিয়ে"]],"t":"ٱلَّذِى عَلَّمَ بِ<h>ٱ</>لْقَلَمِ"},{"n":5,"w":[["عَلَّمَ","‘allama","Taught","শিখিয়েছেন"],["ٱلْإِنسَـٰنَ","l-insāna","man","মানুষকে (এমন জ্ঞান)"],["مَا","mā","what","যা"],["لَمْ","lam","not","না"],["يَعْلَمْ","ya‘lam","he knew","সে জানতো"]],"t":"عَلَّمَ <h>ٱ</>لْإِ<k>نسَٰ</>نَ مَا لَمْ يَعْلَمْ"},{"n":6,"w":[["كَلَّآ","kallā","Nay","কখনও নয়"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلْإِنسَـٰنَ","l-insāna","man","মানুষ"],["لَيَطْغَىٰٓ","layaṭghā","surely transgresses","অবশ্যই সীমালঙ্ঘন করে"]],"t":"كَ<o>لَّآ</> إِ<g>نَّ</> <h>ٱ</>لْإِ<k>نسَٰ</>نَ لَيَ<q>طْ</>غَىٰٓ"},{"n":7,"w":[["أَن","an","That","(এ কারণে) যে"],["رَّءَاهُ","raāhu","he sees himself","নিজেকে মনে করে"],["ٱسْتَغْنَىٰٓ","is'taghnā","self-sufficient","অভাবমুক্ত"]],"t":"<w>أَن رَّ</>ءَاهُ <h>ٱ</>سْتَغْنَىٰٓ"},{"n":8,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["إِلَىٰ","ilā","to","কাছে"],["رَبِّكَ","rabbika","your Lord","তোমার রবের"],["ٱلرُّجْعَىٰٓ","l-ruj'‘ā","(is) the return","প্রত্যাবর্তন হবে"]],"t":"إِ<g>نَّ</> إِلَىٰ رَبِّكَ <h>ٱ</><l>ل</>رُّ<q>جْ</>عَىٰٓ"},{"n":9,"w":[["أَرَءَيْتَ","ara-ayta","Have you seen","তুমি দেখেছ কি"],["ٱلَّذِى","alladhī","the one who","(তাকে) যে"],["يَنْهَىٰ","yanhā","forbids","বাধা দেয়"]],"t":"أَرَءَيْتَ <h>ٱ</>لَّذِى يَنْهَىٰ"},{"n":10,"w":[["عَبْدًا","‘abdan","A slave","এক বান্দাকে"],["إِذَا","idhā","when","যখন"],["صَلَّىٰٓ","ṣallā","he prays","সে সালাত পড়ে"]],"t":"عَ<q>بْ</>دًا إِذَا صَلَّىٰٓ"},{"n":11,"w":[["أَرَءَيْتَ","ara-ayta","Have you seen","তুমি (ভেবে) দেখেছ কি"],["إِن","in","if","যদি"],["كَانَ","kāna","he is","সে হয়"],["عَلَى","‘alā","upon","উপর"],["ٱلْهُدَىٰٓ","l-hudā","[the] guidance","সঠিক পথের"]],"t":"أَرَءَيْتَ إِ<k>ن كَ</>انَ عَلَى <h>ٱ</>لْهُدَىٰٓ"},{"n":12,"w":[["أَوْ","aw","Or","অথবা"],["أَمَرَ","amara","he enjoins","নির্দেশ দেয়"],["بِٱلتَّقْوَىٰٓ","bil-taqwā","[of the] righteousness","তাকওয়ার"]],"t":"أَوْ أَمَرَ بِ<h>ٱ</><l>ل</>تَّ<q>قْ</>وَىٰٓ"},{"n":13,"w":[["أَرَءَيْتَ","ara-ayta","Have you seen","তুমি (ভেবে) দেখেছ কি"],["إِن","in","if","যদি"],["كَذَّبَ","kadhaba","he denies","সে মিথ্যা আরোপ করে"],["وَتَوَلَّىٰٓ","watawallā","and turns away","ও মুখ ফিরায় (কি পরিণাম হবে)"]],"t":"أَرَءَيْتَ إِ<k>ن كَ</>ذَّبَ وَتَوَلَّىٰٓ"},{"n":14,"w":[["أَلَمْ","alam","Does not","নাকি"],["يَعْلَم","ya‘lam","he know","সে জানে"],["بِأَنَّ","bi-anna","that","যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يَرَىٰ","yarā","sees","দেখেন (সব কিছু)"]],"t":"أَلَمْ يَعْ<f>لَم بِ</>أَ<g>نَّ</> <h>ٱ</>للَّهَ يَرَىٰ"},{"n":15,"w":[["كَلَّا","kallā","Nay","সাবধান"],["لَئِن","la-in","If","অবশ্যই যদি"],["لَّمْ","lam","not","না"],["يَنتَهِ","yantahi","he desists","সে বিরত হয়"],["لَنَسْفَعًۢا","lanasfa‘an","surely We will drag him","আমরা অবশ্যই টানবো"],["بِٱلنَّاصِيَةِ","bil-nāṣiyati","by the forelock","মাথার সামনের চুল ধরে"]],"t":"كَلَّا لَ<w>ئِن لَّ</>مْ يَ<k>نتَ</>هِ لَنَسْفَ<i>عًۢا بِ</><h>ٱ</><l>ل</><g>نَّ</>اصِيَةِ"},{"n":16,"w":[["نَاصِيَةٍۢ","nāṣiyatin","A forelock","সামনের চুল (টানবো)"],["كَـٰذِبَةٍ","kādhibatin","lying","মিথ্যুকের"],["خَاطِئَةٍۢ","khāṭi-atin","sinful","পাপীর"]],"t":"نَاصِيَ