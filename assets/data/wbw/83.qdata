{"n":83,"a":[{"n":1,"w":[["وَيْلٌۭ","waylun","Woe","দুর্ভোগ"],["لِّلْمُطَفِّفِينَ","lil'muṭaffifīna","to those who give less","যারা ওজনে/ মাপে কম দেয়"]],"t":"وَيْ<w>لٌۭ لِّ</>لْمُطَفِّ<p>فِي</>نَ"},{"n":2,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["إِذَا","idhā","when","যখন"],["ٱكْتَالُوا۟","ik'tālū","they take a measure","মেপে নেয়"],["عَلَى","‘alā","from","থেকে"],["ٱلنَّاسِ","l-nāsi","the people","লোকদের"],["يَسْتَوْفُونَ","yastawfūna","they take in full","তারা পূর্ণমাত্রায় নেয়"]],"t":"ٱلَّذِينَ إِذَا <h>ٱ</>كْتَالُو<s>ا۟</> عَلَى <h>ٱ</><l>ل</><g>نَّ</>اسِ يَسْتَوْ<p>فُو</>نَ"},{"n":3,"w":[["وَإِذَا","wa-idhā","But when","কিন্তু যখন"],["كَالُوهُمْ","kālūhum","they give by measure (to) them","তাদের মেপে দেয়"],["أَو","aw","or","বা"],["وَّزَنُوهُمْ","wazanūhum","they weigh (for) them","তাদের ওজন করে দেয়"],["يُخْسِرُونَ","yukh'sirūna","they give less","তারা কম করে দেয়"]],"t":"وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِ<p>رُو</>نَ"},{"n":4,"w":[["أَلَا","alā","Do not","না কি"],["يَظُنُّ","yaẓunnu","think","চিন্তা করে"],["أُو۟لَـٰٓئِكَ","ulāika","those","ঐসব লোকেরা"],["أَنَّهُم","annahum","that they","যে তারা"],["مَّبْعُوثُونَ","mab‘ūthūna","(will be) resurrected","আবার ওঠানো হবে"]],"t":"أَلَا يَظُ<g>نُّ</> أُ<s>و۟</><o>لَٰٓ</>ئِكَ أَ<g>نَّ</><y>هُم مَّ</><q>بْ</>عُو<p>ثُو</>نَ"},{"n":5,"w":[["لِيَوْمٍ","liyawmin","For a Day","দিনের জন্যে"],["عَظِيمٍۢ","‘aẓīmin","Great","এক মহা"]],"t":"لِيَوْمٍ عَ<p>ظِي</>مٍۢ"},{"n":6,"w":[["يَوْمَ","yawma","(The) Day","যেদিন"],["يَقُومُ","yaqūmu","will stand","দাঁড়াবে"],["ٱلنَّاسُ","l-nāsu","mankind","মানুষ"],["لِرَبِّ","lirabbi","before (the) Lord","রবের সামনে"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","(of) the worlds","বিশ্বজগতের"]],"t":"يَوْمَ يَقُومُ <h>ٱ</><l>ل</><g>نَّ</>اسُ لِرَبِّ <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":7,"w":[["كَلَّآ","kallā","Nay","কখনও না"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["كِتَـٰبَ","kitāba","(the) record","আমলনামা"],["ٱلْفُجَّارِ","l-fujāri","(of) the wicked","পাপীদের"],["لَفِى","lafī","(is) surely in","অবশ্যই মধ্যে (আছে)"],["سِجِّينٍۢ","sijjīnin","Sijjin","কয়েদখানার"]],"t":"كَ<o>لَّآ</> إِ<g>نَّ</> كِ<m>تَٰ</>بَ <h>ٱ</>لْفُجَّارِ لَفِى سِ<p>جِّي</>نٍۢ"},{"n":8,"w":[["وَمَآ","wamā","And what","এবং কিসে"],["أَدْرَىٰكَ","adrāka","can make you know","তোমাকে বুঝাবে/ জানাবে"],["مَا","mā","what","(কি) সেই"],["سِجِّينٌۭ","sijjīnun","(is) Sijjin","কয়েদখানা"]],"t":"وَ<o>مَآ</> أَ<q>دْ</>رَ<m>ىٰ</>كَ مَا سِ<p>جِّي</>نٌۭ"},{"n":9,"w":[["كِتَـٰبٌۭ","kitābun","A book","খাতা/ আমলনামা"],["مَّرْقُومٌۭ","marqūmun","written","চিহ্নিত"]],"t":"كِ<m>تَٰ</><d>بٌۭ مَّ</>رْ<p>قُو</>مٌۭ"},{"n":10,"w":[["وَيْلٌۭ","waylun","Woe","ধ্বংস"],["يَوْمَئِذٍۢ","yawma-idhin","that Day","সেদিন"],["لِّلْمُكَذِّبِينَ","lil'mukadhibīna","to the deniers","মিথ্যারোপকারীদের জন্যে"]],"t":"وَيْ<d>لٌۭ يَ</>وْمَئِ<w>ذٍۢ لِّ</>لْمُكَذِّ<p>بِي</>نَ"},{"n":11,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["يُكَذِّبُونَ","yukadhibūna","deny","মিথ্যারোপ করে"],["بِيَوْمِ","biyawmi","(the) Day","দিন সম্পর্কে"],["ٱلدِّينِ","l-dīni","(of) the Judgment","বিচারের"]],"t":"ٱلَّذِينَ يُكَذِّبُونَ بِيَوْمِ <h>ٱ</><l>ل</><p>دِّي</>نِ"},{"n":12,"w":[["وَمَا","wamā","And not","এবং না"],["يُكَذِّبُ","yukadhibu","can deny","মিথ্যারোপ করে"],["بِهِۦٓ","bihi","[of] it","এতে"],["إِلَّا","illā","except","এ ছাড়া"],["كُلُّ","kullu","every","প্রত্যেক"],["مُعْتَدٍ","mu‘'tadin","transgressor","সীমালঙ্ঘনকারী"],["أَثِيمٍ","athīmin","sinful","পাপী"]],"t":"وَمَا يُكَذِّبُ بِ<o>هِۦٓ</> إِلَّا كُلُّ مُعْتَدٍ أَ<p>ثِي</>مٍ"},{"n":13,"w":[["إِذَا","idhā","When","যখন"],["تُتْلَىٰ","tut'lā","are recited","পাঠ করা হয়"],["عَلَيْهِ","‘alayhi","to him","তার উপর"],["ءَايَـٰتُنَا","āyātunā","Our Verses","আমাদের আয়াতসমূহ"],["قَالَ","qāla","he says","সে বলে"],["أَسَـٰطِيرُ","asāṭīru","Stories","\"(এসব) উপকথা"],["ٱلْأَوَّلِينَ","l-awalīna","(of) the former (people)","পূর্ববর্তীদের\""]],"t":"إِذَا تُتْلَىٰ عَلَيْهِ ءَا<m>يَٰ</>تُنَا قَالَ أَ<m>سَٰ</>طِيرُ <h>ٱ</>لْأَوَّ<p>لِي</>نَ"},{"n":14,"w":[["كَلَّا ۖ","kallā","Nay","কখনও না"],["بَلْ ۜ","bal","But","বরং"],["رَانَ","rāna","(the) stain has covered","মরচে ধরিয়েছে"],["عَلَىٰ","‘alā","[over]","উপর"],["قُلُوبِهِم","qulūbihim","their hearts","তাদের অন্তরগুলোর"],["مَّا","mā","(for) what","যা"],["كَانُوا۟","kānū","they used to","করছিল"],["يَكْسِبُونَ","yaksibūna","earn","তারা অর্জন"]],"t":"كَلَّا ۖ بَلْ ۜ رَانَ عَلَىٰ قُلُوبِ<y>هِم مَّ</>ا كَانُو<s>ا۟</> يَكْسِ<p>بُو</>نَ"},{"n":15,"w":[["كَلَّآ","kallā","Nay","কখনও না"],["إِنَّهُمْ","innahum","Indeed, they","নিশ্চয়ই তারা"],["عَن","‘an","from","থেকে"],["رَّبِّهِمْ","rabbihim","their Lord","তাদের রবের"],["يَوْمَئِذٍۢ","yawma-idhin","that Day","সেদিন"],["لَّمَحْجُوبُونَ","lamaḥjūbūna","surely will be partitioned","তারা দর্শন বঞ্চিত হবেই"]],"t":"كَ<o>لَّآ</> إِ<g>نَّ</>هُمْ <w>عَن رَّ</>بِّهِمْ يَوْمَئِ<w>ذٍۢ لَّ</>مَحْجُو<p>بُو</>نَ"},{"n":16,"w":[["ثُمَّ","thumma","Then","অতঃপর"],["إِنَّهُمْ","innahum","indeed, they","নিশ্চয়ই তারা"],["لَصَالُوا۟","laṣālū","(surely) will burn","অবশ্যই প্রবেশ করবে"],["ٱلْجَحِيمِ","l-jaḥīmi","(in) the Hellfire","জাহান্নামে"]],"t":"ثُ<g>مَّ</> إِ<g>نَّ</>هُمْ لَصَالُو<s>ا۟</> <h>ٱ</>لْجَ<p>حِي</>مِ"},{"n":17,"w":[["ثُمَّ","thumma","Then","অতঃপর"],["يُقَالُ","yuqālu","it will be said","(তাদেরকে) বলা হবে"],["هَـٰذَا","hādhā","This","\"এই"],["ٱلَّذِى","alladhī","(is) what","সেই (দিন)"],["كُنتُم","kuntum","you used to","তোমরা ছিলে"],["بِهِۦ","bihi","[of it]","যে ব্যাপারে"],["تُكَذِّبُونَ","tukadhibūna","deny","মিথ্যারোপ করতে\""]],"t":"ثُ<g>مَّ</> يُقَالُ <m>هَٰ</>ذَا <h>ٱ</>لَّذِى كُ<k>نتُ</><f>م بِ</><m>هِۦ</> تُكَذِّ<p>بُو</>نَ"},{"n":18,"w":[["كَلَّآ","kallā","Nay","কখনও না"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["كِتَـٰبَ","kitāba","(the) record","আমলনামা"],["ٱلْأَبْرَارِ","l-abrāri","(of) the righteous","সৎ লোকদের"],["لَفِى","lafī","(will be) surely in","অবশ্যই মধ্যে"],["عِلِّيِّينَ","‘illiyyīna","Illiyin","উচ্চ মর্যাদাসম্পন্ন (দফতরে)"]],"t":"كَ<o>لَّآ</> إِ<g>نَّ</> كِ<m>تَٰ</>بَ <h>ٱ</>لْأَ<q>بْ</>رَارِ لَفِى عِلِّ<p>يِّي</>نَ"},{"n":19,"w":[["وَمَآ","wamā","And what","এবং কিসে"],["أَدْرَىٰكَ","adrāka","can make you know","তোমাকে বুঝাবে"],["مَا","mā","what","কি সেই"],["عِلِّيُّونَ","‘illiyyūna","(is) Illiyun","উচ্চ মর্যাদাসম্পন্ন (দফতর)"]],"t":"وَ<o>مَآ</> أَ<q>دْ</>رَ<m>ىٰ</>كَ مَا عِلِّ<p>يُّو</>نَ"},{"n":20,"w":[["كِتَـٰبٌۭ","kitābun","A book","খাতা/ আমলনামা"],["مَّرْقُومٌۭ","marqūmun","written","চিহ্নিত"]],"t":"كِ<m>تَٰ</><d>بٌۭ مَّ</>رْ<p>قُو</>مٌۭ"},{"n":21,"w":[["يَشْهَدُهُ","yashhaduhu","Witness it","তা অবলোকন করছে"],["ٱلْمُقَرَّبُونَ","l-muqarabūna","those brought near","নৈকট্যপ্রাপ্ত (ফেরেশতারা)"]],"t":"يَشْهَدُهُ <h>ٱ</>لْمُقَرَّ<p>بُو</>نَ"},{"n":22,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلْأَبْرَارَ","l-abrāra","the righteous","সৎ লোকেরা"],["لَفِى","lafī","(will be) surely in","অবশ্যই মধ্যে (থাকবে)"],["نَعِيمٍ","na‘īmin","bliss","স্বাচ্ছন্দ্যের"]],"t":"إِ<g>نَّ</> <h>ٱ</>لْأَ<q>بْ</>رَارَ لَفِى نَ<p>عِي</>مٍ"},{"n":23,"w":[["عَلَى","‘alā","On","উপর"],["ٱلْأَرَآئِكِ","l-arāiki","thrones","সুসজ্জিত আসন"],["يَنظُرُونَ","yanẓurūna","observing","তারা দেখবে"]],"t":"عَلَى <h>ٱ</>لْأَ<o>رَآ</>ئِكِ يَ<k>نظُ</><p>رُو</>نَ"},{"n":24,"w":[["تَعْرِفُ","ta‘rifu","You will recognize","তুমি চিনবে"],["فِى","fī","in","মধ্যে"],["وُجُوهِهِمْ","wujūhihim","their faces","তাদের চেহারার"],["نَضْرَةَ","naḍrata","(the) radiance","দীপ্তি"],["ٱلنَّعِيمِ","l-na‘īmi","(of) bliss","স্বাচ্ছন্দ্যের"]],"t":"تَعْرِفُ فِى وُجُوهِهِمْ نَضْرَةَ <h>ٱ</><l>ل</><g>نَّ</><p>عِي</>مِ"},{"n":25,"w":[["يُسْقَوْنَ","yus'qawna","They will be given to drink","তাদের পান করানো হবে"],["مِن","min","of","হতে"],["رَّحِيقٍۢ","raḥīqin","a pure wine","বিশুদ্ধ পানীয়"],["مَّخْتُومٍ","makhtūmin","sealed","মোহর করা"]],"t":"يُسْقَوْنَ <w>مِن رَّ</>حِي<d>قٍۢ مَّ</>خْ<p>تُو</>مٍ"},{"n":26,"w":[["خِتَـٰمُهُۥ","khitāmuhu","Its seal","তার মোহর (হবে)"],["مِسْكٌۭ ۚ","mis'kun","(will be of) musk","কস্তুরির"],["وَفِى","wafī","And for","এবং ক্ষেত্রে"],["ذَٰلِكَ","dhālika","that","এই"],["فَلْيَتَنَافَسِ","falyatanāfasi","let aspire","প্রতিযোগিতা করুক"],["ٱلْمُتَنَـٰفِسُونَ","l-mutanāfisūna","the aspirers","প্রতিযোগীরা"]],"t":"خِ<m>تَٰ</>مُهُ<m>ۥ</> مِسْ<d>كٌۭ ۚ وَ</>فِى <m>ذَٰ</>لِكَ فَلْيَتَنَافَسِ <h>ٱ</>لْمُتَ<m>نَٰ</>فِ<p>سُو</>نَ"},{"n":27,"w":[["وَمِزَاجُهُۥ","wamizājuhu","And its mixture","এবং তার মিশ্রণ হবে"],["مِن","min","(is) of","এর"],["تَسْنِيمٍ","tasnīmin","Tasneem","তাসনীম"]],"t":"وَمِزَاجُهُ<m>ۥ</> مِ<k>ن تَ</>سْ<p>نِي</>مٍ"},{"n":28,"w":[["عَيْنًۭا","‘aynan","A spring","(এই তাসনীম) একটি ঝর্ণা"],["يَشْرَبُ","yashrabu","will drink","পান করবে"],["بِهَا","bihā","from it","তা থেকে"],["ٱلْمُقَرَّبُونَ","l-muqarabūna","those brought near","নৈকট্যপ্রাপ্তগণ"]],"t":"عَيْ<d>نًۭا يَ</>شْرَبُ بِهَا <h>ٱ</>لْمُقَرَّ<p>بُو</>نَ"},{"n":29,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["أَجْرَمُوا۟","ajramū","committed crimes","অপরাধ করেছে"],["كَانُوا۟","kānū","used to","তারা ছিলো"],["مِنَ","mina","at","সাথে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ءَامَنُوا۟","āmanū","believed","ঈমান এনেছে"],["يَضْحَكُونَ","yaḍḥakūna","laugh","বিদ্রুপ করত (তাদের সাথে)"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ أَ<q>جْ</>رَمُو<s>ا۟</> كَانُو<s>ا۟</> مِنَ <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> يَضْحَ<p>كُو</>نَ"},{"n":30,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["مَرُّوا۟","marrū","they passed","অতিক্রম করত"],["بِهِمْ","bihim","by them","তাদের কাছ দিয়ে"],["يَتَغَامَزُونَ","yataghāmazūna","they winked at one another","তারা কটাক্ষ করতো"]],"t":"وَإِذَا مَرُّو<s>ا۟</> بِهِمْ يَتَغَامَ<p>زُو</>نَ"},{"n":31,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["ٱنقَلَبُوٓا۟","inqalabū","they returned","ফিরে যেতো"],["إِلَىٰٓ","ilā","to","কাছে"],["أَهْلِهِمُ","ahlihimu","their people","তাদের পরিজনের"],["ٱنقَلَبُوا۟","inqalabū","they would return","তারা ফিরে যেতো"],["فَكِهِينَ","fakihīna","jesting","উৎফুল্ল হয়ে"]],"t":"وَإِذَا <h>ٱ</><k>نقَ</>لَ<o>بُوٓ</><s>ا۟</> إِلَ<o>ىٰٓ</> أَهْلِهِمُ <h>ٱ</><k>نقَ</>لَبُو<s>ا۟</> فَكِ<p>هِي</>نَ"},{"n":32,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["رَأَوْهُمْ","ra-awhum","they saw them","তাদেরকে দেখত"],["قَالُوٓا۟","qālū","they said","তারা বলত"],["إِنَّ","inna","Indeed","\"নিশ্চয়ই"],["هَـٰٓؤُلَآءِ","hāulāi","these","এসব লোক"],["لَضَآلُّونَ","laḍāllūna","surely have gone astray","অবশ্যই বিভ্রান্ত\""]],"t":"وَإِذَا رَأَوْهُمْ قَا<o>لُوٓ</><s>ا۟</> إِ<g>نَّ</> <o>هَٰٓؤُلَآ</>ءِ لَ<n>ضَآ</><p>لُّو</>نَ"},{"n":33,"w":[["وَمَآ","wamā","But not","এবং না"],["أُرْسِلُوا۟","ur'silū","they had been sent","পাঠানো হয়েছে (কাফেরদেরকে)"],["عَلَيْهِمْ","‘alayhim","over them","তাদের উপর"],["حَـٰفِظِينَ","ḥāfiẓīna","(as) guardians","তত্ত্বাবধায়ক রূপে"]],"t":"وَ<o>مَآ</> أُرْسِلُو<s>ا۟</> عَلَيْهِمْ <m>حَٰ</>فِ<p>ظِي</>نَ"},{"n":34,"w":[["فَٱلْيَوْمَ","fal-yawma","So today","অতএব আজ"],["ٱلَّذِينَ","alladhīna","those who","(সেদিন) যারা"],["ءَامَنُوا۟","āmanū","believed ","ঈমান এনেছিলো"],["مِنَ","mina","at","সাথে"],["ٱلْكُفَّارِ","l-kufāri","the disbelievers","কাফেরদের"],["يَضْحَكُونَ","yaḍḥakūna","they will laugh","উপহাস করবে"]],"t":"فَ<h>ٱ</>لْيَوْمَ <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> مِنَ <h>ٱ</>لْكُفَّارِ يَضْحَ<p>كُو</>نَ"},{"n":35,"w":[["عَلَى","‘alā","On","উপর"],["ٱلْأَرَآئِكِ","l-arāiki","the thrones","সুসজ্জিত আসন সমূহের (বসে)"],["يَنظُرُونَ","yanẓurūna","observing","তারা দেখবে"]],"t":"عَلَى <h>ٱ</>لْأَ<o>رَآ</>ئِكِ يَ<k>نظُ</><p>رُو</>نَ"},{"n":36,"w":[["هَلْ","hal","Have (not)","কি"],["ثُوِّبَ","thuwwiba","been rewarded","ফল দেয়া হলো"],["ٱلْكُفَّارُ","l-kufāru","the disbelievers","কাফেরদের"],["مَا","mā","(for) what","যা"],["كَانُوا۟","kānū","they used to","(ছিল)"],["يَفْعَلُونَ","yaf‘alūna","do","তারা করছিল"]],"t":"هَلْ ثُوِّبَ <h>ٱ</>لْكُفَّارُ مَا كَانُو<s>ا۟</> يَفْعَ<p>لُو</>نَ"}]}