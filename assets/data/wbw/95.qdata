{"n":95,"a":[{"n":1,"w":[["وَٱلتِّينِ","wal-tīni","By the fig","শপথ তীন (ডুমুর)"],["وَٱلزَّيْتُونِ","wal-zaytūni","and the olive","এবং যয়তুনের (জলপাই)"]],"t":"وَ<h>ٱ</><l>ل</>تِّينِ وَ<h>ٱ</><l>ل</>زَّيْ<p>تُو</>نِ"},{"n":2,"w":[["وَطُورِ","waṭūri","And (the) Mount","শপথ তুর পর্বতের"],["سِينِينَ","sīnīna","Sinai","সিনাই"]],"t":"وَطُورِ سِي<p>نِي</>نَ"},{"n":3,"w":[["وَهَـٰذَا","wahādhā","And this","শপথ এই"],["ٱلْبَلَدِ","l-baladi","[the] city","নগরীর"],["ٱلْأَمِينِ","l-amīni","[the] secure","নিরাপদ"]],"t":"وَ<m>هَٰ</>ذَا <h>ٱ</>لْبَلَدِ <h>ٱ</>لْأَ<p>مِي</>نِ"},{"n":4,"w":[["لَقَدْ","laqad","Indeed","নিশ্চয়ই"],["خَلَقْنَا","khalaqnā","We created","আমরা সৃষ্টি করেছি"],["ٱلْإِنسَـٰنَ","l-insāna","man","মানুষকে"],["فِىٓ","fī","in","মধ্যে"],["أَحْسَنِ","aḥsani","(the) best","সুন্দরতম"],["تَقْوِيمٍۢ","taqwīmin","mould","গঠনে"]],"t":"لَقَ<q>دْ</> خَلَ<q>قْ</>نَا <h>ٱ</>لْإِ<k>نسَٰ</>نَ <o>فِىٓ</> أَحْسَنِ تَ<q>قْ</><p>وِي</>مٍۢ"},{"n":5,"w":[["ثُمَّ","thumma","Then","এরপরে"],["رَدَدْنَـٰهُ","radadnāhu","We returned him","আমরা তাকে ফিরিয়ে দিয়েছি"],["أَسْفَلَ","asfala","(to the) lowest","অতি নীচে"],["سَـٰفِلِينَ","sāfilīna","(of the) low","সব নীচুর"]],"t":"ثُ<g>مَّ</> رَدَ<q>دْ</><m>نَٰ</>هُ أَسْفَلَ <m>سَٰ</>فِ<p>لِي</>نَ"},{"n":6,"w":[["إِلَّا","illā","Except","(তবে) ব্যতিক্রম"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["وَعَمِلُوا۟","wa‘amilū","and do","এবং করেছে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","righteous deeds","সৎকর্ম"],["فَلَهُمْ","falahum","then for them","তাদের জন্য (রয়েছে)"],["أَجْرٌ","ajrun","(is a) reward","প্রতিফল"],["غَيْرُ","ghayru","never","অশেষ"],["مَمْنُونٍۢ","mamnūnin","ending","অশেষ"]],"t":"إِلَّا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ فَلَهُمْ أَ<q>جْ</>رٌ غَيْرُ مَمْ<p>نُو</>نٍۢ"},{"n":7,"w":[["فَمَا","famā","Then what","সুতরাং কিসে"],["يُكَذِّبُكَ","yukadhibuka","causes you to deny","তোমাকে অস্বীকার করায়"],["بَعْدُ","ba‘du","after (this)","এরপরে"]