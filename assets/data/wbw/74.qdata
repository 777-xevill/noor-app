{"n":74,"a":[{"n":1,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you","হে"],["ٱلْمُدَّثِّرُ","l-mudathiru","who covers himself","চাদরাবৃত"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لْمُدَّثِّرُ"},{"n":2,"w":[["قُمْ","qum","Stand up","উঠ"],["فَأَنذِرْ","fa-andhir","and warn","সতর্ক কর অতঃপর"]],"t":"قُمْ فَأَ<k>نذِ</>رْ"},{"n":3,"w":[["وَرَبَّكَ","warabbaka","And your Lord","ও তোমার রবের"],["فَكَبِّرْ","fakabbir","magnify","অতঃপর শ্রেষ্ঠত্ব ঘোষণা কর"]],"t":"وَرَبَّكَ فَكَبِّرْ"},{"n":4,"w":[["وَثِيَابَكَ","wathiyābaka","And your clothing","এবং তোমার কাপড়"],["فَطَهِّرْ","faṭahhir","purify","অতঃপর পবিত্র কর"]],"t":"وَثِيَابَكَ فَطَهِّرْ"},{"n":5,"w":[["وَٱلرُّجْزَ","wal-ruj'za","And uncleanliness","এবং অপবিত্রতা"],["فَٱهْجُرْ","fa-uh'jur","avoid","অতএব দূরে থাক"]],"t":"وَ<h>ٱ</><l>ل</>رُّ<q>جْ</>زَ فَ<h>ٱ</>هْجُرْ"},{"n":6,"w":[["وَلَا","walā","And (do) not","এবং না"],["تَمْنُن","tamnun","confer favor","অনুগ্রহ করো"],["تَسْتَكْثِرُ","tastakthiru","(to) acquire more","বেশী পাওয়ার আশায়"]],"t":"وَلَا تَمْنُ<k>ن تَ</>سْتَكْثِرُ"},{"n":7,"w":[["وَلِرَبِّكَ","walirabbika","And for your Lord","এবং তোমার রবের জন্যে"],["فَٱصْبِرْ","fa-iṣ'bir","be patient","অতএব সবর কর"]],"t":"وَلِرَبِّكَ فَ<h>ٱ</>صْبِرْ"},{"n":8,"w":[["فَإِذَا","fa-idhā","Then when","অতঃপর যখন"],["نُقِرَ","nuqira","is blown","ফুক দেয়া হবে"],["فِى","fī","in","মধ্যে"],["ٱلنَّاقُورِ","l-nāqūri","the trumpet","সিঙ্গায়"]],"t":"فَإِذَا نُقِرَ فِى <h>ٱ</><l>ل</><g>نَّ</>ا<p>قُو</>رِ"},{"n":9,"w":[["فَذَٰلِكَ","fadhālika","That","অতএব সেই"],["يَوْمَئِذٍۢ","yawma-idhin","Day","(হবে) দিন"],["يَوْمٌ","yawmun","(will be) a Day","দিন"],["عَسِيرٌ","‘asīrun","difficult","কঠিন"]],"t":"فَ<m>ذَٰ</>لِكَ يَوْمَئِ<d>ذٍۢ يَ</>وْمٌ عَ<p>سِي</>رٌ"},{"n":10,"w":[["عَلَى","‘alā","For","উপর"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","the disbelievers ","কাফিরদের"],["غَيْرُ","ghayru","not","নয়"],["يَسِيرٍۢ","yasīrin","easy","সহজ"]],"t":"عَلَى <h>ٱ</>لْ<m>كَٰ</>فِرِينَ غَيْرُ يَ<p>سِي</>رٍۢ"},{"n":11,"w":[["ذَرْنِى","dharnī","Leave Me","আমাকে ছাড়"],["وَمَنْ","waman","