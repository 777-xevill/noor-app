n","Nuh","নূহ"],["وَإِبْرَٰهِيمَ","wa-ib'rāhīma","and Ibrahim","এবং ইবরাহীম"],["وَمُوسَىٰ","wamūsā","and Musa","এবং মূসা"],["وَعِيسَى","wa‘īsā","and Isa","ও ঈসা"],["ٱبْنِ","ib'ni","son","তনয়"],["مَرْيَمَ ۖ","maryama","(of) Maryam","মারইয়াম (থেকেও)"],["وَأَخَذْنَا","wa-akhadhnā","And We took","এবং নিয়েছিলাম আমরা"],["مِنْهُم","min'hum","from them","থেকে তাদের"],["مِّيثَـٰقًا","mīthāqan","a covenant","অঙ্গীকার"],["غَلِيظًۭا","ghalīẓan","strong","দৃঢ়"]],"t":"وَإِذْ أَخَذْنَا مِنَ <h>ٱ</><l>ل</><g>نَّ</>بِيِّۦنَ مِي<m>ثَٰ</>قَهُمْ وَمِ<k>نكَ</> وَ<d>مِن نُّوحٍۢ وَ</>إِ<q>بْ</><m>رَٰ</>هِيمَ وَمُوسَىٰ وَعِيسَى <h>ٱ</><q>بْ</>نِ مَرْيَمَ ۖ وَأَخَذْنَا مِنْ<y>هُم مِّ</>ي<m>ثَٰ</>قًا غَلِيظًۭا"},{"n":8,"w":[["لِّيَسْـَٔلَ","liyasala","That He may ask","যেন সে জিজ্ঞেস করতে পারে"],["ٱلصَّـٰدِقِينَ","l-ṣādiqīna","the truthful","সত্যবাদীদেরকে"],["عَن","‘an","about","সম্বন্ধে"],["صِدْقِهِمْ ۚ","ṣid'qihim","their truth","সত্যবাদীতা তাদের"],["وَأَعَدَّ","wa-a‘adda","And He has prepared","এবং তিনি প্রস্তুত করে রেখেছেন"],["لِلْكَـٰفِرِينَ","lil'kāfirīna","for the disbelievers","জন্যে কাফিরদের"],["عَذَابًا","‘adhāban","a punishment","শাস্তি"],["أَلِيمًۭا","alīman","painful","নিদারুণ"]],"t":"لِّيَسْـَٔلَ <h>ٱ</><l>ل</><m>صَّٰ</>دِقِينَ عَ<k>ن صِ</><q>دْ</>قِهِمْ ۚ وَأَعَدَّ لِلْ<m>كَٰ</>فِرِينَ عَذَابًا أَلِيمًۭا"},{"n":9,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you","হে"],["ٱلَّذِينَ","alladhīna","who","যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছো"],["ٱذْكُرُوا۟","udh'kurū","Remember","তোমরা স্মরণ করো"],["نِعْمَةَ","ni‘'mata","(the) Favor","অনুগ্রহের"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["عَلَيْكُمْ","‘alaykum","upon you","প্রতি তোমাদের"],["إِذْ","idh","when","যখন"],["جَآءَتْكُمْ","jāatkum","came to you","এসেছিলো তোমাদের (উপর)"],["جُنُودٌۭ","junūdun","(the) hosts","(শত্রু) সৈন্যবাহিনী"],["فَأَرْسَلْنَا","fa-arsalnā","and We sent","তখন পাঠিয়েছিলাম আমরা"],["عَلَيْهِمْ","‘alayhim","upon them","বিরুদ্ধে তাদের"],["رِيحًۭا","rīḥan","a wind","প্রবল ঝড়"],["وَجُنُودًۭا","wajunūdan","and hosts","ও সৈন্যবাহিনী"],["لَّمْ","lam","not","নাই"],["تَرَوْهَا ۚ","tarawhā","you (could) see them","তোমরা দেখো তা"],["وَكَانَ","wakāna","And Allah is","এবং হলেন"],["ٱللَّهُ","l-lahu","And Allah is","আল্লাহ"],["بِمَا","bimā","of what","ঐ বিষয়ে যা"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা করো"],["بَصِيرًا","baṣīran","All-Seer","খুব দৃষ্টিমান"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> <h>ٱ</>ذْكُرُو<s>ا۟</> نِعْمَةَ <h>ٱ</>للَّهِ عَلَيْكُمْ إِذْ <o>جَآ</>ءَتْكُمْ جُنُو<k>دٌۭ فَ</>أَرْسَلْنَا عَلَيْهِمْ رِي<d>حًۭا وَ</>جُنُو<w>دًۭا لَّ</>مْ تَرَوْهَا ۚ وَكَانَ <h>ٱ</>للَّهُ بِمَا تَعْمَلُونَ بَصِيرًا"},{"n":10,"w":[["إِذْ","idh","When","যখন"],["جَآءُوكُم","jāūkum","they came upon you","তারা এসেছিলো বিরুদ্ধে তোমাদের"],["مِّن","min","from","হতে"],["فَوْقِكُمْ","fawqikum","above you","উপর তোমাদের(অঞ্চল)"],["وَمِنْ","wamin","and from","ও হ'তে"],["أَسْفَلَ","asfala","below","নিচ (অঞ্চল)"],["مِنكُمْ","minkum","you","হ'তে তোমাদের"],["وَإِذْ","wa-idh","and when","এবং যখন"],["زَاغَتِ","zāghati","grew wild","বিস্ফোরিত হয়েছিলো"],["ٱلْأَبْصَـٰرُ","l-abṣāru","the eyes","চোখসমূহ"],["وَبَلَغَتِ","wabalaghati","and reached","ও পৌঁছে গিয়েছিলো"],["ٱلْقُلُوبُ","l-qulūbu","the hearts","প্রাণসমূহ"],["ٱلْحَنَاجِرَ","l-ḥanājira","the throats","কণ্ঠসমূহে"],["وَتَظُنُّونَ","wataẓunnūna","and you assumed","এবং তোমরা মনে করতে"],["بِٱللَّهِ","bil-lahi","about Allah","সম্পর্কে আল্লাহ"],["ٱلظُّنُونَا۠","l-ẓunūnā","the assumptions","নানাবিধ ধারণা"]],"t":"إِذْ <o>جَآ</>ءُو<y>كُم مِّ</><k>ن فَ</>وْقِكُمْ وَمِنْ أَسْفَلَ مِ<k>نكُ</>مْ وَإِذْ زَاغَتِ <h>ٱ</>لْأَ<q>بْ</><m>صَٰ</>رُ وَبَلَغَتِ <h>ٱ</>لْقُلُوبُ <h>ٱ</>لْحَنَاجِرَ وَتَظُ<g>نُّ</>ونَ بِ<h>ٱ</>للَّهِ <h>ٱ</><l>ل</>ظُّنُونَا۠"},{"n":11,"w":[["هُنَالِكَ","hunālika","There ","তখনই"],["ٱبْتُلِىَ","ub'tuliya","were tried","পরীক্ষা করা হয়েছিলো"],["ٱلْمُؤْمِنُونَ","l-mu'minūna","the believers","মু’মিনদেরকে"],["وَزُلْزِلُوا۟","wazul'zilū","and shaken","এবং প্রকম্পিত করা হয়েছিলো"],["زِلْزَالًۭا","zil'zālan","(with a) shake","প্রকম্পন"],["شَدِيدًۭا","shadīdan","severe","ভীষণভাবে"]],"t":"هُنَالِكَ <h>ٱ</><q>بْ</>تُلِىَ <h>ٱ</>لْمُؤْمِنُونَ وَزُلْزِلُو<s>ا۟</> زِلْزَالًۭ<k>ا شَ</>دِيدًۭا"},{"n":12,"w":[["وَإِذْ","wa-idh","And when","এবং যখন"],["يَقُولُ","yaqūlu","said","বলেছিলো"],["ٱلْمُنَـٰفِقُونَ","l-munāfiqūna","the hypocrites","মুনাফিকরা"],["وَٱلَّذِينَ","wa-alladhīna","and those","ও যাদের"],["فِى","fī","in","মধ্যে"],["قُلُوبِهِم","qulūbihim","their hearts","অন্তরসমূহের তাদের"],["مَّرَضٌۭ","maraḍun","(was) a disease","রোগ (ছিলো)"],["مَّا","mā","Not","\"না"],["وَعَدَنَا","wa‘adanā","Allah promised us","প্রতিশ্রুতি দিয়েছেন আমাদের"],["ٱللَّهُ","l-lahu","Allah promised us","আল্লাহ"],["وَرَسُولُهُۥٓ","warasūluhu","and His messenger","ও রাসূল তাঁর"],["إِلَّا","illā","except","ছাড়া"],["غُرُورًۭا","ghurūran","delusion","প্রতারণা\""]],"t":"وَإِذْ يَقُولُ <h>ٱ</>لْمُ<m>نَٰ</>فِقُونَ وَ<h>ٱ</>لَّذِينَ فِى قُلُوبِ<y>هِم مَّ</>رَ<d>ضٌۭ مَّ</>ا وَعَدَنَا <h>ٱ</>للَّهُ وَرَسُولُهُ<o>ۥٓ</> إِلَّا غُرُورًۭا"},{"n":13,"w":[["وَإِذْ","wa-idh","And when","এবং যখন"],["قَالَت","qālat","said","বলেছিলো"],["طَّآئِفَةٌۭ","ṭāifatun","a party","একদল"],["مِّنْهُمْ","min'hum","of them","মধ্যে হ'তে তাদের"],["يَـٰٓأَهْلَ","yāahla","O People","\"হে অধিবাসীরা"],["يَثْرِبَ","yathriba","(of) Yathrib","ইযাসরিবের (অর্থাৎ মাদীনাহর)"],["لَا","lā","No","নেই"],["مُقَامَ","muqāma","stand","দাঁড়াবার স্থান"],["لَكُمْ","lakum","for you","জন্যে তোমাদের"],["فَٱرْجِعُوا۟ ۚ","fa-ir'ji‘ū","so return","সুতরাং তোমরা ফিরে যাও\""],["وَيَسْتَـْٔذِنُ","wayastadhinu","And asked permission","এবং অনুমতি (অব্যাহতি) নিতে চায়"],["فَرِيقٌۭ","farīqun","a group","একদল"],["مِّنْهُمُ","min'humu","of them","মধ্যে হ'তে তাদের"],["ٱلنَّبِىَّ","l-nabiya","(from) the Prophet","নাবী (থেকে)"],["يَقُولُونَ","yaqūlūna","saying","তারা বলে"],["إِنَّ","inna","Indeed","\"নিশ্চয়ই"],["بُيُوتَنَا","buyūtanā","our houses","ঘরসমূহ আমাদের"],["عَوْرَةٌۭ","‘awratun","(are) exposed","অরক্ষিত\""],["وَمَا","wamā","and not","অথচ না"],["هِىَ","hiya","they","তা (ছিলো)"],["بِعَوْرَةٍ ۖ","bi‘awratin","(were) exposed","অবস্থায় অরক্ষিত"],["إِن","in","Not","না"],["يُرِيدُونَ","yurīdūna","they wished","তারা চায়"],["إِلَّا","illā","but","এ ছাড়া"],["فِرَارًۭا","firāran","to flee","পালিয়ে যাওয়া"]],"t":"وَإِذْ قَالَ<j>ت</> <o>طَّآ</>ئِفَ<d>ةٌۭ مِّ</>نْهُمْ <o>يَٰٓ</>أَهْلَ يَثْرِبَ لَا مُقَامَ لَكُمْ فَ<h>ٱ</>رْجِعُو<s>ا۟ ۚ</> وَيَسْتَـْٔذِنُ فَرِي<d>قٌۭ مِّ</>نْهُمُ <h>ٱ</><l>ل</><g>نَّ</>بِىَّ يَقُولُونَ إِ<g>نَّ</> بُيُوتَنَا عَوْرَ<d>ةٌۭ وَ</>مَا هِىَ بِعَوْرَةٍ ۖ <d>إِن يُ</>رِيدُونَ إِلَّا فِرَارًۭا"},{"n":14,"w":[["وَلَوْ","walaw","And if","এবং যদি"],["دُخِلَتْ","dukhilat","had been entered","প্রবেশ করতো"],["عَلَيْهِم","‘alayhim","upon them","মধ্যে তাদের"],["مِّنْ","min","from","হ'তে"],["أَقْطَارِهَا","aqṭārihā","all its sides","চারদিক তার"],["ثُمَّ","thumma","then","এরপর"],["سُئِلُوا۟","su-ilū","they had been asked","তাদের কাছে চাওয়া (আহ্বান করা) হতো"],["ٱلْفِتْنَةَ","l-fit'nata","the treachery","বিদ্রোহের"],["لَـَٔاتَوْهَا","laātawhā","they (would) have certainly done it","অবশ্যই তারা করে বসতো তা"],["وَمَا","wamā","and not","আর না"],["تَلَبَّثُوا۟","talabbathū","they (would) have hesitated","তারা অবস্থান করতো"],["بِهَآ","bihā","over it","জন্যে তার"],["إِلَّا","illā","except","কিন্তু"],["يَسِيرًۭا","yasīran","a little","সামান্য"]],"t":"وَلَوْ دُخِلَتْ عَلَيْ<y>هِم مِّ</>نْ أَ<q>قْ</>طَارِهَا ثُ<g>مَّ</> سُئِلُو<s>ا۟</> <h>ٱ</>لْفِتْنَةَ لَءَاتَوْهَا وَمَا تَلَبَّثُو<s>ا۟</> بِ<o>هَآ</> إِلَّا يَسِيرًۭا"},{"n":15,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["كَانُوا۟","kānū","they had","তারা ছিলো"],["عَـٰهَدُوا۟","‘āhadū","promised","তারা অঙ্গীকার করেছিলো"],["ٱللَّهَ","l-laha","Allah","আল্লাহর (সাথে)"],["مِن","min","before","থেকে"],["قَبْلُ","qablu","before","ইতিপূর্ব (যে)"],["لَا","lā","not","না"],["يُوَلُّونَ","yuwallūna","they would turn","তারা ফিরাবে"],["ٱلْأَدْبَـٰرَ ۚ","l-adbāra","their backs","পিঠসমূহ"],["وَكَانَ","wakāna","And is","এবং হবে"],["عَهْدُ","‘ahdu","(the) promise","অঙ্গীকার"],["ٱللَّهِ","l-lahi","(to) Allah","আল্লাহর (সাথে কৃত)"],["مَسْـُٔولًۭا","masūlan","to be questioned","জিজ্ঞাসিত"]],"t":"وَلَقَ<q>دْ</> كَانُو<s>ا۟</> <m>عَٰ</>هَدُو<s>ا۟</> <h>ٱ</>للَّهَ مِ<k>ن قَ</><q>بْ</>لُ لَا يُوَلُّونَ <h>ٱ</>لْأَ<q>دْ</><m>بَٰ</>رَ ۚ وَكَانَ عَهْدُ <h>ٱ</>للَّهِ مَسْـُٔولًۭا"},{"n":16,"w":[["قُل","qul","Say","বলো"],["لَّن","lan","Never","\"কখনও না"],["يَنفَعَكُمُ","yanfa‘akumu","will benefit you","উপকার দিবে তোমাদের"],["ٱلْفِرَارُ","l-firāru","the fleeing","পালিয়ে যাওয়া"],["إِن","in","if","যদিও"],["فَرَرْتُم","farartum","you flee","তোমরা পালাও"],["مِّنَ","mina","from","হ'তে"],["ٱلْمَوْتِ","l-mawti","death","মৃত্যু"],["أَوِ","awi","or","অথবা"],["ٱلْقَتْلِ","l-qatli","killing","হত্যা (হ'তে)"],["وَإِذًۭا","wa-idhan","and then","এবং তখন"],["لَّا","lā","not","না"],["تُمَتَّعُونَ","tumatta‘ūna","you will be allowed to enjoy","তোমাদের ভোগ করতে দেয়া হবে"],["إِلَّا","illā","except","কিন্তু"],["قَلِيلًۭا","qalīlan","a little","অতি সামান্য\""]],"t":"قُل <d>لَّن يَ</><k>نفَ</>عَكُمُ <h>ٱ</>لْفِرَارُ إِ<k>ن فَ</>رَرْ<y>تُم مِّ</>نَ <h>ٱ</>لْمَوْتِ أَوِ <h>ٱ</>لْقَتْلِ وَإِ<w>ذًۭا لَّ</>ا تُمَتَّعُونَ إِلَّا قَلِيلًۭا"},{"n":17,"w":[["قُلْ","qul","Say","বলো"],["مَن","man","Who","\"কে"],["ذَا","dhā","(is) it that","এমন"],["ٱلَّذِى","alladhī","(is) it that","যে"],["يَعْصِمُكُم","ya‘ṣimukum","(can) protect you","রক্ষা করবে তোমাদেরকে"],["مِّنَ","mina","from","হ'তে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌"],["إِنْ","in","If","যদি"],["أَرَادَ","arāda","He intends","তিনি ইচ্ছে করেন"],["بِكُمْ","bikum","for you","সাথে তোমাদের"],["سُوٓءًا","sūan","any harm","অমঙ্গলের"],["أَوْ","aw","or","অথবা (যদি)"],["أَرَادَ","arāda","He intends","তিনি ইচ্ছে করেন"],["بِكُمْ","bikum","for you","সাথে তোমাদের"],["رَحْمَةًۭ ۚ","raḥmatan","a mercy","অনুগ্রহের (তবে কে বন্ধ করতে পারে)\""],["وَلَا","walā","And not","এবং না"],["يَجِدُونَ","yajidūna","they will find","তারা পাবে"],["لَهُم","lahum","for them","জন্যে তাদের"],["مِّن","min","besides","থেকে"],["دُونِ","dūni","besides","ছাড়া"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["وَلِيًّۭا","waliyyan","any protector","কোনো অভিভাবক"],["وَلَا","walā","and not","আর না"],["نَصِيرًۭا","naṣīran","any helper","কোন সাহায্যকারী"]],"t":"قُلْ مَ<k>ن ذَ</>ا <h>ٱ</>لَّذِى يَعْصِمُ<y>كُم مِّ</>نَ <h>ٱ</>للَّهِ إِنْ أَرَادَ بِكُمْ <o>سُوٓ</>ءًا أَوْ أَرَادَ بِكُمْ رَحْمَ<d>ةًۭ ۚ وَ</>لَا يَجِدُونَ لَ<y>هُم مِّ</><k>ن دُ</>ونِ <h>ٱ</>للَّهِ وَلِ<d>يًّۭا وَ</>لَا نَصِيرًۭا"},{"n":18,"w":[["۞ قَدْ","qad","Verily","অবশ্যই"],["يَعْلَمُ","ya‘lamu","Allah knows","জানেন"],["ٱللَّهُ","l-lahu","Allah knows","আল্লাহ"],["ٱلْمُعَوِّقِينَ","l-mu‘awiqīna","those who hinder","বাধাদানকারীদেরকে"],["مِنكُمْ","minkum","among you","মধ্য হ'তে তোমাদের"],["وَٱلْقَآئِلِينَ","wal-qāilīna","and those who say","কথকদেরকে (যারা বলে)"],["لِإِخْوَٰنِهِمْ","li-ikh'wānihim","to their brothers","উদ্দেশ্যে ভাইদের তাদের"],["هَلُمَّ","halumma","Come","\"চলে এসো"],["إِلَيْنَا ۖ","ilaynā","to us","দিকে আমাদের\""],["وَلَا","walā","and not","কিন্তু না"],["يَأْتُونَ","yatūna","they come","তারা আসে"],["ٱلْبَأْسَ","l-basa","(to) the battle","যুদ্ধে"],["إِلَّا","illā","except","ছাড়া"],["قَلِيلًا","qalīlan","a few","অল্পই"]],"t":"۞ قَ<q>دْ</> يَعْلَمُ <h>ٱ</>للَّهُ <h>ٱ</>لْمُعَوِّقِينَ مِ<k>نكُ</>مْ وَ<h>ٱ</>لْ<o>قَآ</>ئِلِينَ لِإِخْ<m>وَٰ</>نِهِمْ هَلُ<g>مَّ</> إِلَيْنَا ۖ وَلَا يَأْتُونَ <h>ٱ</>لْبَأْسَ إِلَّا قَلِيلًا"},{"n":19,"w":[["أَشِحَّةً","ashiḥḥatan","Miserly","কৃপণতাবশত"],["عَلَيْكُمْ ۖ","‘alaykum","towards you","ব্যাপারে তোমাদের"],["فَإِذَا","fa-idhā","But when","অতঃপর যখন"],["جَآءَ","jāa","comes","আসে"],["ٱلْخَوْفُ","l-khawfu","the fear","ভয় (বিপদ)"],["رَأَيْتَهُمْ","ra-aytahum","you see them","তুমি দেখবে তাদেরকে"],["يَنظُرُونَ","yanẓurūna","looking","তারা তাকাচ্ছে"],["إِلَيْكَ","ilayka","at you","প্রতি তোমার"],["تَدُورُ","tadūru","revolving","ঘুরছে"],["أَعْيُنُهُمْ","a‘yunuhum","their eyes","চোখগুলো তাদের"],["كَٱلَّذِى","ka-alladhī","like one who","(তার) মতো যাকে"],["يُغْشَىٰ","yugh'shā","faints","অচেতনতা চেপে বসেছে"],["عَلَيْهِ","‘alayhi","faints","উপর তার"],["مِنَ","mina","from","ভয়ে"],["ٱلْمَوْتِ ۖ","l-mawti","[the] death","মৃত্যু"],["فَإِذَا","fa-idhā","But when","কিন্তু যখন"],["ذَهَبَ","dhahaba","departs","চলে যায়"],["ٱلْخَوْفُ","l-khawfu","the fear","ভয় (বিপদ)"],["سَلَقُوكُم","salaqūkum","they smite you","শীঘ্রই সাথে মিলবে তোমাদের"],["بِأَلْسِنَةٍ","bi-alsinatin","with tongues","নিয়ে ভাষা"],["حِدَادٍ","ḥidādin","sharp","তীক্ষ্ণ"],["أَشِحَّةً","ashiḥḥatan","miserly","লোভবশত"],["عَلَى","‘alā","towards","ক্ষেত্রে"],["ٱلْخَيْرِ ۚ","l-khayri","the good","ধনমালের (বা স্বার্থ সুযোগের)"],["أُو۟لَـٰٓئِكَ","ulāika","Those ","ঐ সব (লোক)"],["لَمْ","lam","not","না"],["يُؤْمِنُوا۟","yu'minū","they have believed","ঈমান আনে"],["فَأَحْبَطَ","fa-aḥbaṭa","so Allah made worthless","সুতরাং নষ্ট করে দিয়েছেন"],["ٱللَّهُ","l-lahu","so Allah made worthless","আল্লাহ"],["أَعْمَـٰلَهُمْ ۚ","a‘mālahum","their deeds","কর্মসমূহ তাদের"],["وَكَانَ","wakāna","And is","এবং হলো"],["ذَٰلِكَ","dhālika","that","এটা"],["عَلَى","‘alā","for","পক্ষে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["يَسِيرًۭا","yasīran","easy","সহজ"]],"t":"أَشِحَّةً عَلَيْكُمْ ۖ فَإِذَا <o>جَآ</>ءَ <h>ٱ</>لْخَوْفُ رَأَيْتَهُمْ يَ<k>نظُ</>رُونَ إِلَيْكَ تَدُورُ أَعْيُنُهُمْ كَ<h>ٱ</>لَّذِى يُغْشَىٰ عَلَيْهِ مِنَ <h>ٱ</>لْمَوْتِ ۖ فَإِذَا ذَهَبَ <h>ٱ</>لْخَوْفُ سَلَقُو<f>كُم بِ</>أَلْسِنَةٍ حِدَادٍ أَشِحَّةً عَلَى <h>ٱ</>لْخَيْرِ ۚ أُ<s>و۟</><o>لَٰٓ</>ئِكَ لَمْ يُؤْمِنُو<s>ا۟</> فَأَحْبَطَ <h>ٱ</>للَّهُ أَعْ<m>مَٰ</>لَهُمْ ۚ وَكَانَ <m>ذَٰ</>لِكَ عَلَى <h>ٱ</>للَّهِ يَسِيرًۭا"},{"n":20,"w":[["يَحْسَبُونَ","yaḥsabūna","They think","তারা মনে করে"],["ٱلْأَحْزَابَ","l-aḥzāba","the confederates","(আক্রমণকারী) দলসমূহ"],["لَمْ","lam","(have) not","না"],["يَذْهَبُوا۟ ۖ","yadhhabū","withdrawn","চলে যায়"],["وَإِن","wa-in","And if","এবং যদি"],["يَأْتِ","yati","(should) come","(ফিরে) আসে"],["ٱلْأَحْزَابُ","l-aḥzābu","the confederates","দলসমূহ"],["يَوَدُّوا۟","yawaddū","they would wish","তারা কামনা করবে"],["لَوْ","law","if","যদি"],["أَنَّهُم","annahum","that they (were)","(এমন হতো) যে তারা"],["بَادُونَ","bādūna","living in (the) desert","অবস্হানকারী"],["فِى","fī","among","মধ্যে"],["ٱلْأَعْرَابِ","l-a‘rābi","the Bedouins","মরুবাসীদের"],["يَسْـَٔلُونَ","yasalūna","asking","জিজ্ঞাসাবাদ করতো"],["عَنْ","‘an","about","সম্পর্কে"],["أَنۢبَآئِكُمْ ۖ","anbāikum","your news","সংবাদ তোমাদের (সেখানে বসে)"],["وَلَوْ","walaw","And if","এবং যদি"],["كَانُوا۟","kānū","they were","তারা হতো"],["فِيكُم","fīkum","among you","মাঝে তোমাদের"],["مَّا","mā","not","না"],["قَـٰتَلُوٓا۟","qātalū","they would fight","তারা যুদ্ধ করতো"],["إِلَّا","illā","except","ছাড়া"],["قَلِيلًۭا","qalīlan","a little","অল্পই"]],"t":"يَحْسَبُونَ <h>ٱ</>لْأَحْزَابَ لَمْ يَذْهَبُو<s>ا۟ ۖ</> وَ<d>إِن يَ</>أْتِ <h>ٱ</>لْأَحْزَابُ يَوَدُّو<s>ا۟</> لَوْ أَ<g>نَّ</><f>هُم بَ</>ادُونَ فِى <h>ٱ</>لْأَعْرَابِ يَسْـَٔلُونَ عَنْ أَ<i>نۢبَ</><o>آ</>ئِكُمْ ۖ وَلَوْ كَانُو<s>ا۟</> فِي<y>كُم مَّ</>ا <m>قَٰ</>تَ<o>لُوٓ</><s>ا۟</> إِلَّا قَلِيلًۭا"},{"n":21,"w":[["لَّقَدْ","laqad","Certainly","নিশ্চয়ই"],["كَانَ","kāna","is","রয়েছে"],["لَكُمْ","lakum","for you","জন্যে তোমাদের"],["فِى","fī","in","মধ্যে"],["رَسُولِ","rasūli","(the) Messenger","রাসূলের"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["أُسْوَةٌ","us'watun","an excellent example","আদর্শ"],["حَسَنَةٌۭ","ḥasanatun","an excellent example","উত্তম"],["لِّمَن","liman","for (one) who","(তার) জন্যে যে"],["كَانَ","kāna","has","হলো"],["يَرْجُوا۟","yarjū","hope","আশা রাখে"],["ٱللَّهَ","l-laha","(in) Allah","আল্লাহর"],["وَٱلْيَوْمَ","wal-yawma","and the Day","ও দিনের"],["ٱلْـَٔاخِرَ","l-ākhira","the Last","শেষ"],["وَذَكَرَ","wadhakara","and remembers","এবং স্মরণ করে"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["كَثِيرًۭا","kathīran","much","অধিক"]],"t":"لَّقَ<q>دْ</> كَانَ لَكُمْ فِى رَسُولِ <h>ٱ</>للَّهِ أُسْوَةٌ حَسَنَ<w>ةٌۭ لِّ</>مَ<k>ن كَ</>انَ يَرْجُو<s>ا۟</> <h>ٱ</>للَّهَ وَ<h>ٱ</>لْيَوْمَ <h>ٱ</>لْءَاخِرَ وَذَكَرَ <h>ٱ</>للَّهَ كَثِيرًۭا"},{"n":22,"w":[["وَلَمَّا","walammā","And when","এবং যখন"],["رَءَا","raā","saw","দেখলো"],["ٱلْمُؤْمِنُونَ","l-mu'minūna","the believers","মু’মিনরা"],["ٱلْأَحْزَابَ","l-aḥzāba","the confederates","(শত্রু) দলগুলোকে"],["قَالُوا۟","qālū","they said","তারা বললো"],["هَـٰذَا","hādhā","This","\"এটাই"],["مَا","mā","(is) what","(তা) যা"],["وَعَدَنَا","wa‘adanā","Allah promised us","আমাদের কাছে অঙ্গীকার করেছেন"],["ٱللَّهُ","l-lahu","Allah promised us","আল্লাহ"],["وَرَسُولُهُۥ","warasūluhu","and His Messenger","ও তাঁর রাসূল"],["وَصَدَقَ","waṣadaqa","and Allah spoke the truth","এবং সত্য বলেছেন"],["ٱللَّهُ","l-lahu","and Allah spoke the truth","আল্লাহ"],["وَرَسُولُهُۥ ۚ","warasūluhu","and His Messenger","ও তাঁর রাসূল"],["وَمَا","wamā","And not","এবং না"],["زَادَهُمْ","zādahum","it increased them","বৃদ্ধি পায় তাদের(অন্য কিছু)"],["إِلَّآ","illā","except","ছাড়া"],["إِيمَـٰنًۭا","īmānan","(in) faith","ঈমান"],["وَتَسْلِيمًۭا","wataslīman","and submission","ও (তাঁর) আনুগত্য"]],"t":"وَلَ<g>مَّ</>ا رَءَا <h>ٱ</>لْمُؤْمِنُونَ <h>ٱ</>لْأَحْزَابَ قَالُو<s>ا۟</> <m>هَٰ</>ذَا مَا وَعَدَنَا <h>ٱ</>للَّهُ وَرَسُولُهُ<m>ۥ</> وَصَدَقَ <h>ٱ</>للَّهُ وَرَسُولُهُ<m>ۥ</> ۚ وَمَا زَادَهُمْ إِ<o>لَّآ</> إِي<m>مَٰ</><d>نًۭا وَ</>تَسْلِيمًۭا"},{"n":23,"w":[["مِّنَ","mina","Among","মধ্য হ'তে"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believers","মু'মিনদের"],["رِجَالٌۭ","rijālun","(are) men","(কিছু) লোক"],["صَدَقُوا۟","ṣadaqū","(who) have been true","সত্য প্রমাণ করেছে"],["مَا","mā","(to) what","যা"],["عَـٰهَدُوا۟","‘āhadū","they promised Allah","তারা অঙ্গীকার করেছিলো"],["ٱللَّهَ","l-laha","they promised Allah","আল্লাহকে"],["عَلَيْهِ ۖ","‘alayhi","[on it]","উপর তার"],["فَمِنْهُم","famin'hum","And among them","অতঃপর মধ্য থেকে তাদের"],["مَّن","man","(is he) who","কেউ"],["قَضَىٰ","qaḍā","has fulfilled","পূর্ণ করেছে"],["نَحْبَهُۥ","naḥbahu","his vow","ব্রত তার (শহীদ হয়েছে)"],["وَمِنْهُم","wamin'hum","and among them","আবার মধ্যে হ'তে তাদের"],["مَّن","man","(is he) who","কেউ"],["يَنتَظِرُ ۖ","yantaẓiru","awaits","অপেক্ষায় আছে"],["وَمَا","wamā","And not","এবং না"],["بَدَّلُوا۟","baddalū","they alter","তারা পরিবর্তন করেছে"],["تَبْدِيلًۭا","tabdīlan","(by) any alteration ","কোনো পরিবর্তন"]],"t":"مِّنَ <h>ٱ</>لْمُؤْمِنِينَ رِجَا<k>لٌۭ صَ</>دَقُو<s>ا۟</> مَا <m>عَٰ</>هَدُو<s>ا۟</> <h>ٱ</>للَّهَ عَلَيْهِ ۖ فَمِنْ<y>هُم مَّ</><k>ن قَ</>ضَىٰ نَحْبَهُ<m>ۥ</> وَمِنْ<y>هُم مَّ</><d>ن يَ</><k>نتَ</>ظِرُ ۖ وَمَا بَدَّلُو<s>ا۟</> تَ<q>بْ</>دِيلًۭا"},{"n":24,"w":[["لِّيَجْزِىَ","liyajziya","That Allah may reward","যেন পুরস্কার দেন"],["ٱللَّهُ","l-lahu","That Allah may reward","আল্লাহ"],["ٱلصَّـٰدِقِينَ","l-ṣādiqīna","the truthful","সত্যবাদীদেরকে"],["بِصِدْقِهِمْ","biṣid'qihim","for their truth","কারণে সত্যবাদীতার তাদের"],["وَيُعَذِّبَ","wayu‘adhiba","and punish","এবং শাস্তি দেন"],["ٱلْمُنَـٰفِقِينَ","l-munāfiqīna","the hypocrites","মুনাফিকদেরকে"],["إِن","in","if","যদি"],["شَآءَ","shāa","He wills","তিনি ইচ্ছে করেন"],["أَوْ","aw","or","অথবা"],["يَتُوبَ","yatūba","turn in mercy","ক্ষমা করে দিবেন"],["عَلَيْهِمْ ۚ","‘alayhim","to them","প্রতি তাদের"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["كَانَ","kāna","is","হলেন"],["غَفُورًۭا","ghafūran","Oft-Forgiving","ক্ষমাশীল"],["رَّحِيمًۭا","raḥīman","Most Merciful","পরম দয়ালু"]],"t":"لِّيَ<q>جْ</>زِىَ <h>ٱ</>للَّهُ <h>ٱ</><l>ل</><m>صَّٰ</>دِقِينَ بِصِ<q>دْ</>قِهِمْ وَيُعَذِّبَ <h>ٱ</>لْمُ<m>نَٰ</>فِقِينَ إِ<k>ن شَ</><o>آ</>ءَ أَوْ يَتُوبَ عَلَيْهِمْ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ كَانَ غَفُو<w>رًۭا رَّ</>حِيمًۭا"},{"n":25,"w":[["وَرَدَّ","waradda","And Allah turned back","এবং ফিরিয়ে দিলেন"],["ٱللَّهُ","l-lahu","And Allah turned back","আল্লাহ"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["كَفَرُوا۟","kafarū","disbelieved","অবিশ্বাস করেছে"],["بِغَيْظِهِمْ","bighayẓihim","in their rage","সহ মনের জ্বালা তাদের"],["لَمْ","lam","not","নি"],["يَنَالُوا۟","yanālū","they obtained","তারা পায়"],["خَيْرًۭا ۚ","khayran","any good","কল্যাণ"],["وَكَفَى","wakafā","And sufficient is","এবং যথেষ্ট"],["ٱللَّهُ","l-lahu","Allah","আল্লাহই"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","(for) the believers","মু'মিনদের (জন্যে)"],["ٱلْقِتَالَ ۚ","l-qitāla","(in) the battle","যুদ্ধে"],["وَكَانَ","wakāna","and Allah is","এবং হলেন"],["ٱللَّهُ","l-lahu","and Allah is","আল্লাহ"],["قَوِيًّا","qawiyyan","All-Strong","শক্তিমান"],["عَزِيزًۭا","‘azīzan","All-Mighty","মহাপরাক্রমশালী"]],"t":"وَرَدَّ <h>ٱ</>للَّهُ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> بِغَيْظِهِمْ لَمْ يَنَالُو<s>ا۟</> خَيْ<d>رًۭا ۚ وَ</>كَفَى <h>ٱ</>للَّهُ <h>ٱ</>لْمُؤْمِنِينَ <h>ٱ</>لْقِتَالَ ۚ وَكَانَ <h>ٱ</>للَّهُ قَوِيًّا عَزِيزًۭا"},{"n":26,"w":[["وَأَنزَلَ","wa-anzala","And He brought down","এবং নামিয়ে দিলেন"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["ظَـٰهَرُوهُم","ẓāharūhum","backed them","সাহায্য করেছিলো তাদের"],["مِّنْ","min","among","মধ্য হ'তে"],["أَهْلِ","ahli","(the) People","অধিকারীদের"],["ٱلْكِتَـٰبِ","l-kitābi","(of) the Scripture","কিতাবের"],["مِن","min","from","হ'তে"],["صَيَاصِيهِمْ","ṣayāṣīhim","their fortresses","দূর্গসমূহ তাদের"],["وَقَذَفَ","waqadhafa","and cast","এবং সঞ্চার করলেন"],["فِى","fī","into","মধ্যে"],["قُلُوبِهِمُ","qulūbihimu","their hearts","অন্তসমূহের তাদের"],["ٱلرُّعْبَ","l-ru‘'ba","[the] terror","ভয়"],["فَرِيقًۭا","farīqan","a group","(এখন) এক দলকে"],["تَقْتُلُونَ","taqtulūna","you killed","তোমরা হত্যা করছো"],["وَتَأْسِرُونَ","watasirūna","and you took captive","এবং তোমরা বন্দী করছো"],["فَرِيقًۭا","farīqan","a group","(অপর) দলকে"]],"t":"وَأَ<k>نزَ</>لَ <h>ٱ</>لَّذِينَ <m>ظَٰ</>هَرُو<y>هُم مِّ</>نْ أَهْلِ <h>ٱ</>لْكِ<m>تَٰ</>بِ مِ<k>ن صَ</>يَاصِيهِمْ وَقَذَفَ فِى قُلُوبِهِمُ <h>ٱ</><l>ل</>رُّعْبَ فَرِي<k>قًۭا تَ</><q>قْ</>تُلُونَ وَتَأْسِرُونَ فَرِيقًۭا"},{"n":27,"w":[["وَأَوْرَثَكُمْ","wa-awrathakum","And He caused you to inherit","এবং উত্তরাধিকারী বানালেন তোমাদেরকে"],["أَرْضَهُمْ","arḍahum","their land","জায়গা জমির তাদের"],["وَدِيَـٰرَهُمْ","wadiyārahum","and their houses","ও ঘর বাড়িসমূহের তাদের"],["وَأَمْوَٰلَهُمْ","wa-amwālahum","and their properties","ও ধনসম্পদের তাদের"],["وَأَرْضًۭا","wa-arḍan","and a land","এবং (এমন)এক দেশের"],["لَّمْ","lam","not","(যা) নি"],["تَطَـُٔوهَا ۚ","taṭaūhā","you (had) trodden","তোমরা পা রাখো তাতে"],["وَكَانَ","wakāna","And Allah is","এবং হলেন"],["ٱللَّهُ","l-lahu","And Allah is","আল্লাহ"],["عَلَىٰ","‘alā","on","উপর"],["كُلِّ","kulli","every","সব"],["شَىْءٍۢ","shayin","thing","কিছুর"],["قَدِيرًۭا","qadīran","All-Powerful","সর্বশক্তিমান"]],"t":"وَأَوْرَثَكُمْ أَرْضَهُمْ وَدِ<m>يَٰ</>رَهُمْ وَأَمْ<m>وَٰ</>لَهُمْ وَأَرْ<w>ضًۭا لَّ</>مْ تَطَـُٔوهَا ۚ وَكَانَ <h>ٱ</>للَّهُ عَلَىٰ كُلِّ <k>شَىْءٍۢ قَ</>دِيرًۭا"},{"n":28,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O Prophet","হে"],["ٱلنَّبِىُّ","l-nabiyu","O Prophet","নাবী"],["قُل","qul","Say","বলো"],["لِّأَزْوَٰجِكَ","li-azwājika","to your wives","উদ্দেশ্যে তোমার স্ত্রীদের"],["إِن","in","If","\"যদি"],["كُنتُنَّ","kuntunna","you","তোমরা হও (এমন যে)"],["تُرِدْنَ","turid'na","desire","তোমরা পেতে চাও"],["ٱلْحَيَوٰةَ","l-ḥayata","the life","জীবন"],["ٱلدُّنْيَا","l-dun'yā","(of) the world","পার্থিব"],["وَزِينَتَهَا","wazīnatahā","and its adornment","ও চাকচিক্য তার"],["فَتَعَالَيْنَ","fata‘ālayna","then come","তবে তোমরা এসো"],["أُمَتِّعْكُنَّ","umatti‘'kunna","I will provide for you","আমি ভোগসামগ্রী দিয়ে দিই তোমাদেরকে"],["وَأُسَرِّحْكُنَّ","wa-usarriḥ'kunna","and release you","ও আমি বিদায় দিই তোমাদেরকে"],["سَرَاحًۭا","sarāḥan","(with) a release","বিদায়"],["جَمِيلًۭا","jamīlan","good","সৌজন্যের সাথে"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</><l>ل</><g>نَّ</>بِىُّ قُل لِّأَزْ<m>وَٰ</>جِكَ إِ<k>ن كُنتُ</><g>نَّ</> تُرِ<q>دْ</>نَ <h>ٱ</>لْحَيَ<s>وٰ</>ةَ <h>ٱ</><l>ل</>دُّنْيَا وَزِينَتَهَا فَتَعَالَيْنَ أُمَتِّعْكُ<g>نَّ</> وَأُسَرِّحْكُ<g>نَّ</> سَرَا<k>حًۭا جَ</>مِيلًۭا"},{"n":29,"w":[["وَإِن","wa-in","But if","আর যদি"],["كُنتُنَّ","kuntunna","you","তোমরা হও (এমন যে)"],["تُرِدْنَ","turid'na","desire","তোমরা চাও"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["وَرَسُولَهُۥ","warasūlahu","and His Messenger","ও তাঁর রাসূলকে"],["وَٱلدَّارَ","wal-dāra","and the Home","ও ঘরকে"],["ٱلْـَٔاخِرَةَ","l-ākhirata","(of) the Hereafter","আখিরাতের"],["فَإِنَّ","fa-inna","then indeed","তবে নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["أَعَدَّ","a‘adda","has prepared","প্রস্তুত করে রেখেছেন"],["لِلْمُحْسِنَـٰتِ","lil'muḥ'sināti","for the good-doers","জন্যে সৎকর্মশীলদের"],["مِنكُنَّ","minkunna","among you","মধ্য হ'তে তোমাদের"],["أَجْرًا","ajran","a reward","পুরস্কার"],["عَظِيمًۭا","‘aẓīman","great","মহা\""]],"t":"وَإِ<k>ن كُنتُ</><g>نَّ</> تُرِ<q>دْ</>نَ <h>ٱ</>للَّهَ وَرَسُولَهُ<m>ۥ</> وَ<h>ٱ</><l>ل</>دَّارَ <h>ٱ</>لْءَاخِرَةَ فَإِ<g>نَّ</> <h>ٱ</>للَّهَ أَعَدَّ لِلْمُحْسِ<m>نَٰ</>تِ مِ<k>نكُ</><g>نَّ</> أَ<q>جْ</>رًا عَظِيمًۭا"},{"n":30,"w":[["يَـٰنِسَآءَ","yānisāa","O wives","হে স্ত্রীগণ"],["ٱلنَّبِىِّ","l-nabiyi","(of) the Prophet","নাবীর"],["مَن","man","Whoever","যে"],["يَأْتِ","yati","commits","আসবে"],["مِنكُنَّ","minkunna","from you","মধ্য হ'তে তোমাদের"],["بِفَـٰحِشَةٍۢ","bifāḥishatin","immorality","নিয়ে (করে)অশ্লীল কাজ"],["مُّبَيِّنَةٍۢ","mubayyinatin","clear","সুস্পষ্ট"],["يُضَـٰعَفْ","yuḍā‘af","will be doubled","দ্বিগুণ দেয়া হবে"],["لَهَا","lahā","for her","জন্যে তার"],["ٱلْعَذَابُ","l-‘adhābu","the punishment","শাস্তি"],["ضِعْفَيْنِ ۚ","ḍi‘'fayni","two fold","দ্বিগুণ"],["وَكَانَ","wakāna","And that is","এবং হ'লে"],["ذَٰلِكَ","dhālika","And that is","এটা"],["عَلَى","‘alā","for","জন্যে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["يَسِيرًۭا","yasīran","easy","সহজ"]],"t":"<m>يَٰ</>نِ<o>سَآ</>ءَ <h>ٱ</><l>ل</><g>نَّ</>بِىِّ <d>مَن يَ</>أْتِ مِ<k>نكُ</><g>نَّ</> بِ<m>فَٰ</>حِشَ<d>ةٍۢ مُّ</>بَيِّنَ<d>ةٍۢ يُ</><m>ضَٰ</>عَفْ لَهَا <h>ٱ</>لْعَذَابُ ضِعْفَيْنِ ۚ وَكَانَ <m>ذَٰ</>لِكَ عَلَى <h>ٱ</>للَّهِ يَسِيرًۭا"},{"n":31,"w":[["۞ وَمَن","waman","And whoever","এবং যে"],["يَقْنُتْ","yaqnut","is obedient","অনুগত হবে"],["مِنكُنَّ","minkunna","among you","মধ্য হ'তে তোমাদের"],["لِلَّهِ","lillahi","to Allah","প্রতি আল্লাহরই"],["وَرَسُولِهِۦ","warasūlihi","and His Messenger","ও রাসূলের তাঁর"],["وَتَعْمَلْ","wata‘mal","and does","ও কাজ করবে"],["صَـٰلِحًۭا","ṣāliḥan","righteousness","সৎ"],["نُّؤْتِهَآ","nu'tihā","We will give her","আমরা দিবো তাকে"],["أَجْرَهَا","ajrahā","her reward","পুরস্কার তার"],["مَرَّتَيْنِ","marratayni","twice","দু’বার"],["وَأَعْتَدْنَا","wa-a‘tadnā","and We have prepared","এবং প্রস্তুত করে রেখেছি আমরা"],["لَهَا","lahā","for her","জন্যে তার"],["رِزْقًۭا","riz'qan","a provision","জীবিকা"],["كَرِيمًۭا","karīman","noble","সম্মানজনক"]],"t":"۞ وَ<d>مَن يَ</><q>قْ</>نُتْ مِ<k>نكُ</><g>نَّ</> لِلَّهِ وَرَسُولِ<m>هِۦ</> وَتَعْمَلْ <m>صَٰ</>لِ<d>حًۭا نُّ</>ؤْتِ<o>هَآ</> أَ<q>جْ</>رَهَا مَرَّتَيْنِ وَأَعْتَ<q>دْ</>نَا لَهَا رِزْ<k>قًۭا كَ</>رِيمًۭا"},{"n":32,"w":[["يَـٰنِسَآءَ","yānisāa","O wives","হে স্ত্রীগণ"],["ٱلنَّبِىِّ","l-nabiyi","(of) the Prophet","নাবীর"],["لَسْتُنَّ","lastunna","You are not","তোমরা নও"],["كَأَحَدٍۢ","ka-aḥadin","like anyone","মতো একজনের"],["مِّنَ","mina","among","অন্য কোনো"],["ٱلنِّسَآءِ ۚ","l-nisāi","the women","নারীদের"],["إِنِ","ini","If","যদি"],["ٱتَّقَيْتُنَّ","ittaqaytunna","you fear (Allah)","তোমরা ভয় করো"],["فَلَا","falā","then (do) not","তবে না"],["تَخْضَعْنَ","takhḍa‘na","be soft","কোমল করো"],["بِٱلْقَوْلِ","bil-qawli","in speech","(অন্য পুরুষদের সাথে) কথাকে"],["فَيَطْمَعَ","fayaṭma‘a","lest should be moved with desire","ফলে প্রলুদ্ধ হয়"],["ٱلَّذِى","alladhī","he who","(সে) যার"],["فِى","fī","in","আছে"],["قَلْبِهِۦ","qalbihi","his heart","অন্তরে তার"],["مَرَضٌۭ","maraḍun","(is) a disease","রোগ"],["وَقُلْنَ","waqul'na","but say","বরং তোমরা বলো"],["قَوْلًۭا","qawlan","a word","কথা"],["مَّعْرُوفًۭا","ma‘rūfan","appropriate","সঙ্গতভাবে"]],"t":"<m>يَٰ</>نِ<o>سَآ</>ءَ <h>ٱ</><l>ل</><g>نَّ</>بِىِّ لَسْتُ<g>نَّ</> كَأَحَ<d>دٍۢ مِّ</>نَ <h>ٱ</><l>ل</><g>نِّ</><o>سَآ</>ءِ ۚ إِنِ <h>ٱ</>تَّقَيْتُ<g>نَّ</> فَلَا تَخْضَعْنَ بِ<h>ٱ</>لْقَوْلِ فَيَ<q>طْ</>مَعَ <h>ٱ</>لَّذِى فِى قَلْبِ<m>هِۦ</> مَرَ<d>ضٌۭ وَ</>قُلْنَ قَوْلًۭ<d>ا مَّ</>عْرُوفًۭا"},{"n":33,"w":[["وَقَرْنَ","waqarna","And stay","এবং তোমরা অবস্থান করো"],["فِى","fī","in","মধ্যে"],["بُيُوتِكُنَّ","buyūtikunna","your houses","ঘরগুলোর তোমাদের"],["وَلَا","walā","and (do) not","এবং না"],["تَبَرَّجْنَ","tabarrajna","display yourselves","তোমরা প্রদর্শন করো"],["تَبَرُّجَ","tabarruja","(as was the) display","প্রদর্শনী"],["ٱلْجَـٰهِلِيَّةِ","l-jāhiliyati","(of the times of) ignorance","অজ্ঞযুগের"],["ٱلْأُولَىٰ ۖ","l-ūlā","the former","প্রাচীন"],["وَأَقِمْنَ","wa-aqim'na","And establish","এবং তোমরা প্রতিষ্ঠিত করো"],["ٱلصَّلَوٰةَ","l-ṣalata","the prayer","সালাত"],["وَءَاتِينَ","waātīna","and give","ও তোমরা আদায় করো"],["ٱلزَّكَوٰةَ","l-zakata","zakah","যাকাত"],["وَأَطِعْنَ","wa-aṭi‘'na","and obey","এবং তোমরা আনুগত্য করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহর"],["وَرَسُولَهُۥٓ ۚ","warasūlahu","and His Messenger","ও রাসূলের তাঁর"],["إِنَّمَا","innamā","Only","কেবল"],["يُرِيدُ","yurīdu","Allah wishes","চান"],["ٱللَّهُ","l-lahu","Allah wishes","আল্লাহ্‌"],["لِيُذْهِبَ","liyudh'hiba","to remove","যাতে দূর করে দেন"],["عَنكُمُ","‘ankumu","from you","হ'তে তোমাদের"],["ٱلرِّجْسَ","l-rij'sa","the impurity","অপবিত্রতা"],["أَهْلَ","ahla","(O) People","(অর্থাৎ হ'তে) বাসিন্দাদের"],["ٱلْبَيْتِ","l-bayti","(of) the House","(নাবীর) ঘরের"],["وَيُطَهِّرَكُمْ","wayuṭahhirakum","And to purify you","এবং পবিত্র করবেন তোমাদেরকে"],["تَطْهِيرًۭا","taṭhīran","(with thorough) purification","সম্পূর্ণ পবিত্র"]],"t":"وَقَرْنَ فِى بُيُوتِكُ<g>نَّ</> وَلَا تَبَرَّ<q>جْ</>نَ تَبَرُّجَ <h>ٱ</>لْ<m>جَٰ</>هِلِيَّةِ <h>ٱ</>لْأُولَىٰ ۖ وَأَقِمْنَ <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةَ وَءَاتِينَ <h>ٱ</><l>ل</>زَّكَ<s>وٰ</>ةَ وَأَطِعْنَ <h>ٱ</>للَّهَ وَرَسُولَهُ<o>ۥٓ</> ۚ إِ<g>نَّ</>مَا يُرِيدُ <h>ٱ</>للَّهُ لِيُذْهِبَ عَ<k>نكُ</>مُ <h>ٱ</><l>ل</>رِّ<q>جْ</>سَ أَهْلَ <h>ٱ</>لْبَيْتِ وَيُطَهِّرَكُمْ تَ<q>طْ</>هِيرًۭا"},{"n":34,"w":[["وَٱذْكُرْنَ","wa-udh'kur'na","And remember","এবং তোমরা স্মরণ করো"],["مَا","mā","what","যা"],["يُتْلَىٰ","yut'lā","is recited","তিলাওয়াত করা হয়"],["فِى","fī","in","মধ্যে"],["بُيُوتِكُنَّ","buyūtikunna","your houses","তোমাদের ঘরগুলোর"],["مِنْ","min","of","থেকে"],["ءَايَـٰتِ","āyāti","(the) Verses","আয়াতসমূহ"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَٱلْحِكْمَةِ ۚ","wal-ḥik'mati","and the wisdom","ও প্রজ্ঞার কথা"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["كَانَ","kāna","is","হলেন"],["لَطِيفًا","laṭīfan","All-Subtle","সূক্ষ্মদর্শী"],["خَبِيرًا","khabīran","All-Aware","খুব অবহিত"]],"t":"وَ<h>ٱ</>ذْكُرْنَ مَا يُتْلَىٰ فِى بُيُوتِكُ<g>نَّ</> مِنْ ءَا<m>يَٰ</>تِ <h>ٱ</>للَّهِ وَ<h>ٱ</>لْحِكْمَةِ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ كَانَ لَطِيفًا خَبِيرًا"},{"n":35,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلْمُسْلِمِينَ","l-mus'limīna","the Muslim men","মুসলমান পুরুষগণ"],["وَٱلْمُسْلِمَـٰتِ","wal-mus'limāti","and the Muslim women","ও মুসলমান নারীগণ"],["وَٱلْمُؤْمِنِينَ","wal-mu'minīna","and the believing men","এবং মু’মিন পুরুষগণ"],["وَٱلْمُؤْمِنَـٰتِ","wal-mu'mināti","and the believing women","ও মুু’মিনা নারীগণ"],["وَٱلْقَـٰنِتِينَ","wal-qānitīna","and the obedient men","এবং অনুগত পুরুষগণ"],["وَٱلْقَـٰنِتَـٰتِ","wal-qānitāti","and the obedient women","ও অনুগত নারীগণ"],["وَٱلصَّـٰدِقِينَ","wal-ṣādiqīna","and the truthful men","এবং সত্যবাদী পুরুষগণ"],["وَٱلصَّـٰدِقَـٰتِ","wal-ṣādiqāti","and the truthful women","ও সত্যবাদী নারীগণ"],["وَٱلصَّـٰبِرِينَ","wal-ṣābirīna","and the patient men","এবং ধৈয্যশীল পুরুষগণ"],["وَٱلصَّـٰبِرَٰتِ","wal-ṣābirāti","and the patient women","ও ধৈয্যশীল নারীগণ"],["وَٱلْخَـٰشِعِينَ","wal-khāshi‘īna","and the humble men","এবং নম্র পুরুষগণ"],["وَٱلْخَـٰشِعَـٰتِ","wal-khāshi‘āti","and the humble women","ও নম্র নারীগণ"],["وَٱلْمُتَصَدِّقِينَ","wal-mutaṣadiqīna","and the men who give charity","এবং দানশীল পুরুষগণ"],["وَٱلْمُتَصَدِّقَـٰتِ","wal-mutaṣadiqāti","and the women who give charity","ও দানশীল নারীগণ"],["وَٱلصَّـٰٓئِمِينَ","wal-ṣāimīna","and the men who fast","এবং সাওমপালনকারী পুরুষগণ"],["وَٱلصَّـٰٓئِمَـٰتِ","wal-ṣāimāti","and the women who fast","ও সাওমপালনকারী নারীগণ"],["وَٱلْحَـٰفِظِينَ","wal-ḥāfiẓīna","and the men who guard","এবং পুরুষ সংরক্ষকগণ"],["فُرُوجَهُمْ","furūjahum","their chastity","লজ্জাস্থানগুলোর তাদের"],["وَٱلْحَـٰفِظَـٰتِ","wal-ḥāfiẓāti","and the women who guard (it)","ও নারী সংরক্ষকগণ"],["وَٱلذَّٰكِرِينَ","wal-dhākirīna","and the men who remember","এবং পুরুষ স্মরণকারীগণ"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["كَثِيرًۭا","kathīran","much","অধিকমাত্রায়"],["وَٱلذَّٰكِرَٰتِ","wal-dhākirāti","and the women who remember","ও নারী স্মরণকারীগণ (আল্লাহকে)"],["أَعَدَّ","a‘adda","Allah has prepared","নির্দিষ্ট করে রেখেছেন"],["ٱللَّهُ","l-lahu","Allah has prepared","আল্লাহ"],["لَهُم","lahum","for them","জন্যে তাদের"],["مَّغْفِرَةًۭ","maghfiratan","forgiveness","ক্ষমা"],["وَأَجْرًا","wa-ajran","and a reward","ও পুরস্কার"],["عَظِيمًۭا","‘aẓīman","great","মহা"]],"t":"إِ<g>نَّ</> <h>ٱ</>لْمُسْلِمِينَ وَ<h>ٱ</>لْمُسْلِ<m>مَٰ</>تِ وَ<h>ٱ</>لْمُؤْمِنِينَ وَ<h>ٱ</>لْمُؤْمِ<m>نَٰ</>تِ وَ<h>ٱ</>لْ<m>قَٰ</>نِتِينَ وَ<h>ٱ</>لْ<m>قَٰنِتَٰ</>تِ وَ<h>ٱ</><l>ل</><m>صَّٰ</>دِقِينَ وَ<h>ٱ</><l>ل</><m>صَّٰدِقَٰ</>تِ وَ<h>ٱ</><l>ل</><m>صَّٰ</>بِرِينَ وَ<h>ٱ</><l>ل</><m>صَّٰبِرَٰ</>تِ وَ<h>ٱ</>لْ<m>خَٰ</>شِعِينَ وَ<h>ٱ</>لْ<m>خَٰشِعَٰ</>تِ وَ<h>ٱ</>لْمُتَصَدِّقِينَ وَ<h>ٱ</>لْمُتَصَدِّ<m>قَٰ</>تِ وَ<h>ٱ</><l>ل</><o>صَّٰٓ</>ئِمِينَ وَ<h>ٱ</><l>ل</><o>صَّٰٓ</>ئِ<m>مَٰ</>تِ وَ<h>ٱ</>لْ<m>حَٰ</>فِظِينَ فُرُوجَهُمْ وَ<h>ٱ</>لْ<m>حَٰفِظَٰ</>تِ وَ<h>ٱ</><l>ل</><m>ذَّٰ</>كِرِينَ <h>ٱ</>للَّهَ كَثِي<d>رًۭا وَ</><h>ٱ</><l>ل</><m>ذَّٰكِرَٰ</>تِ أَعَدَّ <h>ٱ</>للَّهُ لَ<y>هُم مَّ</>غْفِرَ<d>ةًۭ وَ</>أَ<q>جْ</>رًا عَظِيمًۭا"},{"n":36,"w":[["وَمَا","wamā","And not","এবং নেই"],["كَانَ","kāna","(it) is","অধিকার"],["لِمُؤْمِنٍۢ","limu'minin","for a believing man","কোন মু'মিন পুরুষের জন্যে"],["وَلَا","walā","and not","আর না"],["مُؤْمِنَةٍ","mu'minatin","(for) a believing woman","মু'মিন নারীর (জন্যে)"],["إِذَا","idhā","when","যখন"],["قَضَى","qaḍā","Allah has decided","সিদ্ধান্ত দেন"],["ٱللَّهُ","l-lahu","Allah has decided","আল্লাহ"],["وَرَسُولُهُۥٓ","warasūluhu","and His Messenger","ও রাসূল তাঁর"],["أَمْرًا","amran","a matter","কোনো বিষয়ের"],["أَن","an","that","যে"],["يَكُونَ","yakūna","(there) should be","থাকবে"],["لَهُمُ","lahumu","for them","জন্যে তাদের"],["ٱلْخِيَرَةُ","l-khiyaratu","(any) choice","স্বাধীন ইচ্ছা"],["مِنْ","min","about","কোনো"],["أَمْرِهِمْ ۗ","amrihim","their affair","(সে) বিষয়ের তাদের"],["وَمَن","waman","And whoever","এবং যে"],["يَعْصِ","ya‘ṣi","disobeys","অমান্য করবে"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["وَرَسُولَهُۥ","warasūlahu","and His Messenger","ও রাসূলকে তাঁর"],["فَقَدْ","faqad","certainly","তবে নিশ্চয়ই"],["ضَلَّ","ḍalla","he (has) strayed","সে পথভ্রষ্ট হবে"],["ضَلَـٰلًۭا","ḍalālan","(into) error","পথভ্রষ্টতা"],["مُّبِينًۭا","mubīnan","clear","সুস্পষ্ট"]],"t":"وَمَا كَانَ لِمُؤْمِ<d>نٍۢ وَ</>لَا مُؤْمِنَةٍ إِذَا قَضَى <h>ٱ</>للَّهُ وَرَسُولُهُ<o>ۥٓ</> أَمْرًا <d>أَن يَ</>كُونَ لَهُمُ <h>ٱ</>لْخِيَرَةُ مِنْ أَمْرِهِمْ ۗ وَ<d>مَن يَ</>عْصِ <h>ٱ</>للَّهَ وَرَسُولَهُ<m>ۥ</> فَقَ<q>دْ</> ضَلَّ ضَ<m>لَٰ</>لًۭ<d>ا مُّ</>بِينًۭا"},{"n":37,"w":[["وَإِذْ","wa-idh","And when","এবং (স্মরণ কর) যখন"],["تَقُولُ","taqūlu","you said","তুমি বলেছিলে"],["لِلَّذِىٓ","lilladhī","to the one","উদ্দেশ্যে সেই(ব্যক্তির)"],["أَنْعَمَ","an‘ama","Allah bestowed favor","অনুগ্রহ করেছেন (যাকে)"],["ٱللَّهُ","l-lahu","Allah bestowed favor","আল্লাহ"],["عَلَيْهِ","‘alayhi","on him","উপর তার"],["وَأَنْعَمْتَ","wa-an‘amta","and you bestowed favor","ও তুমি অনুগ্রহ করেছো"],["عَلَيْهِ","‘alayhi","on him","উপর তার"],["أَمْسِكْ","amsik","Keep","\"(বিবাহাধীনে) তুমি রাখো"],["عَلَيْكَ","‘alayka","to yourself","সাথে তোমার"],["زَوْجَكَ","zawjaka","your wife","স্ত্রীকে তোমার"],["وَٱتَّقِ","wa-ittaqi","and fear","এবং ভয় করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে\""],["وَتُخْفِى","watukh'fī","But you concealed","আর তুমি গোপন করেছিলে"],["فِى","fī","within","মধ্যে"],["نَفْسِكَ","nafsika","yourself","মনের তোমার"],["مَا","mā","what","যা"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["مُبْدِيهِ","mub'dīhi","(was to) disclose","প্রকাশকারী তা"],["وَتَخْشَى","watakhshā","And you fear","এবং তুমি ভয় করছিলে"],["ٱلنَّاسَ","l-nāsa","the people","মানুষকে"],["وَٱللَّهُ","wal-lahu","while Allah","অথচ আল্লাহ"],["أَحَقُّ","aḥaqqu","has more right","অধিক সংগত"],["أَن","an","that","যে"],["تَخْشَىٰهُ ۖ","takhshāhu","you (should) fear Him","ভয় করো তুমি তাঁকে"],["فَلَمَّا","falammā","So when","অত:পর যখন"],["قَضَىٰ","qaḍā","ended","শেষ (পূর্ণ) করলো"],["زَيْدٌۭ","zaydun","Zaid","যায়েদ"],["مِّنْهَا","min'hā","from her","থেকে তার"],["وَطَرًۭا","waṭaran","necessary (formalities)","(তালাক দেয়ার) প্রয়োজন"],["زَوَّجْنَـٰكَهَا","zawwajnākahā","We married her to you","তোমার সাথে আমরা বিয়ে দিলাম তাকে"],["لِكَىْ","likay","so that","যেন"],["لَا","lā","not","না"],["يَكُونَ","yakūna","there be","হয়"],["عَلَى","‘alā","on","উপর"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believers","মু'মিনদের"],["حَرَجٌۭ","ḥarajun","any discomfort","কোনো সংকীর্ণতা"],["فِىٓ","fī","concerning","(বিবাহের)ব্যাপারে"],["أَزْوَٰجِ","azwāji","the wives","স্ত্রীদের"],["أَدْعِيَآئِهِمْ","ad‘iyāihim","(of) their adopted sons","পোষ্য-পুত্রদের তাদের"],["إِذَا","idhā","when","যখন"],["قَضَوْا۟","qaḍaw","they have ended","তারা শেষ (পূর্ণ) করে"],["مِنْهُنَّ","min'hunna","from them","থেকে তাদের"],["وَطَرًۭا ۚ","waṭaran","necessary (formalities)","(তালাক দেয়ার) প্রয়োজন"],["وَكَانَ","wakāna","And is","এবং হয়"],["أَمْرُ","amru","(the) Command","আদেশ"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["مَفْعُولًۭا","maf‘ūlan","accomplished","কার্যকর"]],"t":"وَإِذْ تَقُولُ لِلَّ<o>ذِىٓ</> أَنْعَمَ <h>ٱ</>للَّهُ عَلَيْهِ وَأَنْعَمْتَ عَلَيْهِ أَمْسِكْ عَلَيْكَ زَوْجَكَ وَ<h>ٱ</>تَّقِ <h>ٱ</>للَّهَ وَتُخْفِى فِى نَفْسِكَ مَا <h>ٱ</>للَّهُ مُ<q>بْ</>دِيهِ وَتَخْشَى <h>ٱ</><l>ل</><g>نَّ</>اسَ وَ<h>ٱ</>للَّهُ أَحَقُّ أَ<k>ن تَ</>خْشَ<m>ىٰ</>هُ ۖ فَلَ<g>مَّ</>ا قَضَىٰ زَيْ<d>دٌۭ مِّ</>نْهَا وَطَ<k>رًۭا زَ</>وَّ<q>جْ</><m>نَٰ</>كَهَا لِكَىْ لَا يَكُونَ عَلَى <h>ٱ</>لْمُؤْمِنِينَ حَرَ<k>جٌۭ فِ</><o>ىٓ</> أَزْ<m>وَٰ</>جِ أَ<q>دْ</>عِ<o>يَآ</>ئِهِمْ إِذَا قَضَوْ<s>ا۟</> مِنْهُ<g>نَّ</> وَطَ<d>رًۭا ۚ وَ</>كَانَ أَمْرُ <h>ٱ</>للَّهِ مَفْعُولًۭا"},{"n":38,"w":[["مَّا","mā","Not","না"],["كَانَ","kāna","(there can) be","ছিলো"],["عَلَى","‘alā","upon","উপর"],["ٱلنَّبِىِّ","l-nabiyi","the Prophet","নাবীর"],["مِنْ","min","any","কোনো"],["حَرَجٍۢ","ḥarajin","discomfort","বাধা"],["فِيمَا","fīmā","in what","ঐ বিষয়ে যা"],["فَرَضَ","faraḍa","Allah has imposed","বিধিসম্মত করেছেন"],["ٱللَّهُ","l-lahu","Allah has imposed","আল্লাহ"],["لَهُۥ ۖ","lahu","on him","জন্যে তার"],["سُنَّةَ","sunnata","(That is the) Way","নীতি (ছিলো)"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["فِى","fī","concerning","(তাদের) ক্ষেত্রেও"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["خَلَوْا۟","khalaw","passed away","অতীত হয়েছে"],["مِن","min","before","থেকে"],["قَبْلُ ۚ","qablu","before","পূর্ব"],["وَكَانَ","wakāna","And is","এবং হয়"],["أَمْرُ","amru","(the) Command","বিধান"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["قَدَرًۭا","qadaran","a decree","সুনির্ধারিত"],["مَّقْدُورًا","maqdūran","destined","অবশ্যম্ভাবী"]],"t":"مَّا كَانَ عَلَى <h>ٱ</><l>ل</><g>نَّ</>بِىِّ مِنْ حَرَ<k>جٍۢ فِ</>يمَا فَرَضَ <h>ٱ</>للَّهُ لَهُۥ ۖ سُ<g>نَّ</>ةَ <h>ٱ</>للَّهِ فِى <h>ٱ</>لَّذِينَ خَلَوْ<s>ا۟</> مِ<k>ن قَ</><q>بْ</>لُ ۚ وَكَانَ أَمْرُ <h>ٱ</>للَّهِ قَدَ<d>رًۭا مَّ</><q>قْ</>دُورًا"},{"n":39,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["يُبَلِّغُونَ","yuballighūna","convey","পৌঁছায়"],["رِسَـٰلَـٰتِ","risālāti","(the) Messages","বাণীসমূহ"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَيَخْشَوْنَهُۥ","wayakhshawnahu","and fear Him","ও তারা ভয় করে তাঁকে"],["وَلَا","walā","and (do) not","আর না"],["يَخْشَوْنَ","yakhshawna","fear","তারা ভয় করে"],["أَحَدًا","aḥadan","anyone","কাউকেও"],["إِلَّا","illā","except","ছাড়া"],["ٱللَّهَ ۗ","l-laha","Allah","আল্লাহ"],["وَكَفَىٰ","wakafā","And sufficient is Allah","এবং যথেষ্ট"],["بِٱللَّهِ","bil-lahi","And sufficient is Allah","আল্লাহই"],["حَسِيبًۭا","ḥasīban","(as) a Reckoner","হিসাব গ্রহণকারীরূপে"]],"t":"ٱلَّذِينَ يُبَلِّغُونَ رِ<m>سَٰلَٰ</>تِ <h>ٱ</>للَّهِ وَيَخْشَوْنَهُ<m>ۥ</> وَلَا يَخْشَوْنَ أَحَدًا إِلَّا <h>ٱ</>للَّهَ ۗ وَكَفَىٰ بِ<h>ٱ</>للَّهِ حَسِيبًۭا"},{"n":40,"w":[["مَّا","mā","Not","না"],["كَانَ","kāna","is","ছিলো"],["مُحَمَّدٌ","muḥammadun","Muhammad","মুহাম্মাদ"],["أَبَآ","abā","(the) father","পিতা"],["أَحَدٍۢ","aḥadin","(of) anyone","কারো"],["مِّن","min","of","মধ্যেকার"],["رِّجَالِكُمْ","rijālikum","your men","পুরুষদের তোমাদের"],["وَلَـٰكِن","walākin","but","কিন্তু"],["رَّسُولَ","rasūla","(he is the) Messenger","রাসূল"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَخَاتَمَ","wakhātama","and Seal","সর্বশেষ (সমাপ্তির ও সিলমোহর)"],["ٱلنَّبِيِّـۧنَ ۗ","l-nabiyīna","(of) the Prophets","নাবীদের (আগমনের)"],["وَكَانَ","wakāna","And Allah is","এবং হলেন"],["ٱللَّهُ","l-lahu","And Allah is","আল্লাহ"],["بِكُلِّ","bikulli","of every","সম্পর্কে সব"],["شَىْءٍ","shayin","thing","কিছুই"],["عَلِيمًۭا","‘alīman","All-Knower","সর্বজ্ঞ"]],"t":"مَّا كَانَ مُحَ<g>مَّ</>دٌ أَ<o>بَآ</> أَحَ<d>دٍۢ مِّ</><w>ن رِّ</>جَالِكُمْ وَ<m>لَٰ</><w>كِن رَّ</>سُولَ <h>ٱ</>للَّهِ وَخَاتَمَ <h>ٱ</><l>ل</><g>نَّ</>بِيِّۦنَ ۗ وَكَانَ <h>ٱ</>للَّهُ بِكُلِّ شَىْءٍ عَلِيمًۭا"},{"n":41,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you who believe","হে"],["ٱلَّذِينَ","alladhīna","O you who believe","যারা"],["ءَامَنُوا۟","āmanū","O you who believe","ঈমান এনেছো"],["ٱذْكُرُوا۟","udh'kurū","Remember","তোমরা স্মরণ করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহর"],["ذِكْرًۭا","dhik'ran","(with) remembrance","স্মরণ"],["كَثِيرًۭا","kathīran","much","অধিক"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> <h>ٱ</>ذْكُرُو<s>ا۟</> <h>ٱ</>للَّهَ ذِكْ<k>رًۭا كَ</>ثِيرًۭا"},{"n":42,"w":[["وَسَبِّحُوهُ","wasabbiḥūhu","And glorify Him","এবং তাঁর পবিত্রতা ঘোষণা করো"],["بُكْرَةًۭ","buk'ratan","morning","সকালে"],["وَأَصِيلًا","wa-aṣīlan","and evening","ও সন্ধ্যায়"]],"t":"وَسَبِّحُوهُ بُكْرَ<d>ةًۭ وَ</>أَصِيلًا"},{"n":43,"w":[["هُوَ","huwa","He","তিনিই"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["يُصَلِّى","yuṣallī","sends His blessings","অনুগ্রহ করেন"],["عَلَيْكُمْ","‘alaykum","upon you","উপর তোমাদের"],["وَمَلَـٰٓئِكَتُهُۥ","wamalāikatuhu","and His Angels","ফেরেশতাগণ তাঁর(দোয়া করে)"],["لِيُخْرِجَكُم","liyukh'rijakum","so that He may bring you out","যেন তিনি বের করেন তোমাদেরকে"],["مِّنَ","mina","from","হ'তে"],["ٱلظُّلُمَـٰتِ","l-ẓulumāti","the darkness[es]","অন্ধকারসমূহ"],["إِلَى","ilā","to","দিকে"],["ٱلنُّورِ ۚ","l-nūri","the light","আলোর"],["وَكَانَ","wakāna","And He is","এবং তিনি হলেন"],["بِٱلْمُؤْمِنِينَ","bil-mu'minīna","to the believers","প্রতি মু'মিনদের"],["رَحِيمًۭا","raḥīman","Merciful","বড় অনুগ্রহশীল"]],"t":"هُوَ <h>ٱ</>لَّذِى يُصَلِّى عَلَيْكُمْ وَمَ<o>لَٰٓ</>ئِكَتُهُ<m>ۥ</> لِيُخْرِجَ<y>كُم مِّ</>نَ <h>ٱ</><l>ل</>ظُّلُ<m>مَٰ</>تِ إِلَى <h>ٱ</><l>ل</><g>نُّ</>ورِ ۚ وَكَانَ بِ<h>ٱ</>لْمُؤْمِنِينَ رَحِيمًۭا"},{"n":44,"w":[["تَحِيَّتُهُمْ","taḥiyyatuhum","Their greetings","অভিবাদন (হবে)তাদের যেদিন"],["يَوْمَ","yawma","(on the) Day","যে দিন"],["يَلْقَوْنَهُۥ","yalqawnahu","they will meet Him","তারা সাক্ষাৎ করবে তাঁর সাথে"],["سَلَـٰمٌۭ ۚ","salāmun","(will be), \"Peace","সালাম (দিয়ে)\""],["وَأَعَدَّ","wa-a‘adda","and He has prepared","এবং প্রস্তুত করে রেখেছেন"],["لَهُمْ","lahum","for them","জন্যে তাদের"],["أَجْرًۭا","ajran","a reward","কর্মফল"],["كَرِيمًۭا","karīman","noble","সম্মানজনক"]],"t":"تَحِيَّتُهُمْ يَوْمَ يَلْقَوْنَهُ<m>ۥ</> سَ<m>لَٰ</><d>مٌۭ ۚ وَ</>أَعَدَّ لَهُمْ أَ<q>جْ</><k>رًۭا كَ</>رِيمًۭا"},{"n":45,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O Prophet","হে"],["ٱلنَّبِىُّ","l-nabiyu","O Prophet","নাবী"],["إِنَّآ","innā","Indeed, We","নিশ্চয়ই আমরা"],["أَرْسَلْنَـٰكَ","arsalnāka","have sent you","আমরা পাঠিয়েছি তোমাকে"],["شَـٰهِدًۭا","shāhidan","(as) a witness","সাক্ষীরূপে"],["وَمُبَشِّرًۭا","wamubashiran","and a bearer of glad tidings","এবং সুসংবাদদাতা"],["وَنَذِيرًۭا","wanadhīran","and (as) a warner","ও সতর্ককারী হিসেবে"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</><l>ل</><g>نَّ</>بِىُّ إِ<g>نَّ</><o>آ</> أَرْسَلْ<m>نَٰ</>كَ <m>شَٰ</>هِ<d>دًۭا وَ</>مُبَشِّ<d>رًۭا وَ</>نَذِيرًۭا"},{"n":46,"w":[["وَدَاعِيًا","wadā‘iyan","And as one who invites","এবং আহবানকারীরূপে"],["إِلَى","ilā","to","দিকে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["بِإِذْنِهِۦ","bi-idh'nihi","by His permission","অনুসারে অনুমতি তাঁর"],["وَسِرَاجًۭا","wasirājan","and (as) a lamp","ও প্রদীপস্বরূপ"],["مُّنِيرًۭا","munīran","illuminating","উজ্জ্বল"]],"t":"وَدَاعِيًا إِلَى <h>ٱ</>للَّهِ بِإِذْنِ<m>هِۦ</> وَسِرَا<d>جًۭا مُّ</>نِيرًۭا"},{"n":47,"w":[["وَبَشِّرِ","wabashiri","And give glad tidings","এবং সুসংবাদ দাও"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","(to) the believers","মু'মিনদেরকে"],["بِأَنَّ","bi-anna","that","যে অবশ্যই"],["لَهُم","lahum","for them","জন্যে (আছে)তাদের"],["مِّنَ","mina","(is) from","পক্ষ থেকে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["فَضْلًۭا","faḍlan","a Bounty","অনুগ্র্রহ"],["كَبِيرًۭا","kabīran","great","বিরাট"]],"t":"وَبَشِّرِ <h>ٱ</>لْمُؤْمِنِينَ بِأَ<g>نَّ</> لَ<y>هُم مِّ</>نَ <h>ٱ</>للَّهِ فَضْلًۭ<k>ا كَ</>بِيرًۭا"},{"n":48,"w":[["وَلَا","walā","And (do) not","এবং না"],["تُطِعِ","tuṭi‘i","obey","আনুগত্য করো"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","the disbelievers","কাফিরদের"],["وَٱلْمُنَـٰفِقِينَ","wal-munāfiqīna","and the hypocrites","ও মুনাফিকদের"],["وَدَعْ","wada‘","and disregard","এবং উপেক্ষা করো"],["أَذَىٰهُمْ","adhāhum","their harm","নির্যাতনকে তাদের"],["وَتَوَكَّلْ","watawakkal","and put your trust","এবং নির্ভর করো"],["عَلَى","‘alā","in","উপর"],["ٱللَّهِ ۚ","l-lahi","Allah","আল্লাহর"],["وَكَفَىٰ","wakafā","And sufficient is Allah","এবং যথেষ্ট"],["بِٱللَّهِ","bil-lahi","And sufficient is Allah","আল্লাহই"],["وَكِيلًۭا","wakīlan","(as) a Trustee","কর্মবিধায়ক হিসেবে"]],"t":"وَلَا تُطِعِ <h>ٱ</>لْ<m>كَٰ</>فِرِينَ وَ<h>ٱ</>لْمُ<m>نَٰ</>فِقِينَ وَدَعْ أَذَ<m>ىٰ</>هُمْ وَتَوَكَّلْ عَلَى <h>ٱ</>للَّهِ ۚ وَكَفَىٰ بِ<h>ٱ</>للَّهِ وَكِيلًۭا"},{"n":49,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you who believe","হে"],["ٱلَّذِينَ","alladhīna","O you who believe","যারা"],["ءَامَنُوٓا۟","āmanū","O you who believe","ঈমান এনেছো"],["إِذَا","idhā","When","যখন"],["نَكَحْتُمُ","nakaḥtumu","you marry","তোমরা বিয়ে করবে"],["ٱلْمُؤْمِنَـٰتِ","l-mu'mināti","believing women","মু’মিন নারীদেরকে"],["ثُمَّ","thumma","and then","এরপর"],["طَلَّقْتُمُوهُنَّ","ṭallaqtumūhunna","divorce them","তালাক দিবে তাদেরকে"],["مِن","min","before","থেকে (এর)"],["قَبْلِ","qabli","before","পূর্বই"],["أَن","an","[that]","যে"],["تَمَسُّوهُنَّ","tamassūhunna","you have touched them","তোমরা স্পর্শ করেছো তাদেরকে"],["فَمَا","famā","then not","তখন নেই"],["لَكُمْ","lakum","for you","জন্যে তোমাদের"],["عَلَيْهِنَّ","‘alayhinna","on them","উপর তাদের"],["مِنْ","min","any","কোনো"],["عِدَّةٍۢ","‘iddatin","waiting period","ইদ্দত পালন"],["تَعْتَدُّونَهَا ۖ","ta‘taddūnahā","(to) count concerning them","তোমরা গণনা করে থাকো যা"],["فَمَتِّعُوهُنَّ","famatti‘ūhunna","So provide for them","সুতরাং তোমরা ভোগ্যসামগ্রী দাও (কিছু) তাদেরকে"],["وَسَرِّحُوهُنَّ","wasarriḥūhunna","and release them","এবং  বিদায় দাও তাদের"],["سَرَاحًۭا","sarāḥan","(with) a release","বিদায়"],["جَمِيلًۭا","jamīlan","good","সৌজন্যের সাথে"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَ<o>نُوٓ</><s>ا۟</> إِذَا نَكَحْتُمُ <h>ٱ</>لْمُؤْمِ<m>نَٰ</>تِ ثُ<g>مَّ</> طَلَّ<q>قْ</>تُمُوهُ<g>نَّ</> مِ<k>ن قَ</><q>بْ</>لِ أَ<k>ن تَ</>مَسُّوهُ<g>نَّ</> فَمَا لَكُمْ عَلَيْهِ<g>نَّ</> مِنْ عِدَّ<k>ةٍۢ تَ</>عْتَدُّونَهَا ۖ فَمَتِّعُوهُ<g>نَّ</> وَسَرِّحُوهُ<g>نَّ</> سَرَا<k>حًۭا جَ</>مِيلًۭا"},{"n":50,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O Prophet","হে"],["ٱلنَّبِىُّ","l-nabiyu","O Prophet","নাবী"],["إِنَّآ","innā","Indeed, We","নিশ্চয়ই আমরা"],["أَحْلَلْنَا","aḥlalnā","[We] have made lawful","বৈধ করেছি"],["لَكَ","laka","to you","জন্যে তোমার"],["أَزْوَٰجَكَ","azwājaka","your wives","স্ত্রীদেরকে তোমার"],["ٱلَّـٰتِىٓ","allātī","(to) whom","যাদের"],["ءَاتَيْتَ","ātayta","you have given","তুমি দিয়েছো"],["أُجُورَهُنَّ","ujūrahunna","their bridal money","মোহরগুলো তাদের"],["وَمَا","wamā","and whom","এবং যা"],["مَلَكَتْ","malakat","you rightfully possess","মালিক হয়েছে"],["يَمِينُكَ","yamīnuka","you rightfully possess","তোমার ডান হাত (অর্থাৎ দাসী)"],["مِمَّآ","mimmā","from those (whom)","(তাদের) মধ্য হ'তে যা"],["أَفَآءَ","afāa","Allah has given","গণীমত করে দিয়েছেন"],["ٱللَّهُ","l-lahu","Allah has given","আল্লাহ"],["عَلَيْكَ","‘alayka","to you","কাছে তোমার"],["وَبَنَاتِ","wabanāti","and (the) daughters","এবং মেয়েদেরকে"],["عَمِّكَ","‘ammika","(of) your paternal uncles","তোমার চাচার"],["وَبَنَاتِ","wabanāti","and (the) daughters","ও মেয়েদের"],["عَمَّـٰتِكَ","‘ammātika","(of) your paternal aunts","তোমার ফুফুর"],["وَبَنَاتِ","wabanāti","and (the) daughters","ও মেয়েদের"],["خَالِكَ","khālika","(of) your maternal uncles","তোমার মামার"],["وَبَنَاتِ","wabanāti","and (the) daughters","ও মেয়েদেরকে"],["خَـٰلَـٰتِكَ","khālātika","(of) your maternal aunts","তোমার খালার"],["ٱلَّـٰتِى","allātī","who","যারা"],["هَاجَرْنَ","hājarna","emigrated","হিজরত করেছে"],["مَعَكَ","ma‘aka","with you","সাথে তোমার"],["وَٱمْرَأَةًۭ","wa-im'ra-atan","and a woman","এবং (সেই) নারী"],["مُّؤْمِنَةً","mu'minatan","believing","মু’মিন"],["إِن","in","if","যদি"],["وَهَبَتْ","wahabat","she gives","নিবেদন করে"],["نَفْسَهَا","nafsahā","herself","নিজেকে তার"],["لِلنَّبِىِّ","lilnnabiyyi","to the Prophet","জন্যে নাবীর"],["إِنْ","in","if","(আর) যদি"],["أَرَادَ","arāda","wishes","চায়"],["ٱلنَّبِىُّ","l-nabiyu","the Prophet","নাবী"],["أَن","an","to","যে"],["يَسْتَنكِحَهَا","yastankiḥahā","marry her ","সে তাকে বিয়ে করবে"],["خَالِصَةًۭ","khāliṣatan","only","(এটা) বিশেষভাবে"],["لَّكَ","laka","for you","জন্যে তোমার"],["مِن","min","excluding","মধ্য হতে"],["دُونِ","dūni","excluding","নয়"],["ٱلْمُؤْمِنِينَ ۗ","l-mu'minīna","the believers","(অন্য) মু’মিনদের"],["قَدْ","qad","Certainly","নিশ্চয়ই"],["عَلِمْنَا","‘alim'nā","We know","আমরা জানি"],["مَا","mā","what","যা"],["فَرَضْنَا","faraḍnā","We have made obligatory","বিধিসম্মত করেছি আমরা"],["عَلَيْهِمْ","‘alayhim","upon them","উপর তাদের"],["فِىٓ","fī","concerning","ব্যাপারে"],["أَزْوَٰجِهِمْ","azwājihim","their wives","স্ত্রীদের তাদের"],["وَمَا","wamā","and whom","এবং যা"],["مَلَكَتْ","malakat","they rightfully possess","মালিক হয়েছে"],["أَيْمَـٰنُهُمْ","aymānuhum","they rightfully possess","ডান হাত তাদের (অর্থাৎ দাসী)"],["لِكَيْلَا","likaylā","that not","যেন না"],["يَكُونَ","yakūna","should be","হয়"],["عَلَيْكَ","‘alayka","on you","উপর তোমার"],["حَرَجٌۭ ۗ","ḥarajun","any discomfort","কোনো অসুবিধা"],["وَكَانَ","wakāna","And Allah is","আর হলেন"],["ٱللَّهُ","l-lahu","And Allah is","আল্লাহ"],["غَفُورًۭا","ghafūran","Oft-Forgiving","ক্