more just","অধিক ন্যায়সঙ্গত"],["عِندَ","‘inda","near","কাছে"],["ٱللَّهِ ۚ","l-lahi","Allah","আল্লাহর"],["فَإِن","fa-in","But if","অতঃপর যদি"],["لَّمْ","lam","not","না"],["تَعْلَمُوٓا۟","ta‘lamū","you know","তোমরা জানো"],["ءَابَآءَهُمْ","ābāahum","their fathers ","পিতাদের তাদের(পরিচয়)"],["فَإِخْوَٰنُكُمْ","fa-ikh'wānukum","then (they are) your brothers","তবে ভাই তোমাদের"],["فِى","fī","in","ভিত্তিতে"],["ٱلدِّينِ","l-dīni","[the] religion","দ্বীনের"],["وَمَوَٰلِيكُمْ ۚ","wamawālīkum","and your friends","ও  বন্ধু তোমাদের"],["وَلَيْسَ","walaysa","But not is","এবং নেই"],["عَلَيْكُمْ","‘alaykum","upon you","উপর তোমাদের"],["جُنَاحٌۭ","junāḥun","any blame","কোনো ত্রুটি"],["فِيمَآ","fīmā","in what","(এসব বিষয়ে) যা"],["أَخْطَأْتُم","akhṭatum","you made a mistake","তোমরা ভুল করে ফেলেছো"],["بِهِۦ","bihi","in it","সম্পর্কে সে"],["وَلَـٰكِن","walākin","but","কিন্তু"],["مَّا","mā","what","যা"],["تَعَمَّدَتْ","ta‘ammadat","intended","ইচ্ছাকৃতভাবে করে"],["قُلُوبُكُمْ ۚ","qulūbukum","your hearts","অন্তর তোমাদের"],["وَكَانَ","wakāna","And Allah","এবং হলেন"],["ٱللَّهُ","l-lahu","And Allah","আল্লাহ্‌"],["غَفُورًۭا","ghafūran","(is) Oft-Forgiving","ক্ষমাশীল"],["رَّحِيمًا","raḥīman","Most Merciful","পরম দয়ালু"]],"t":"ٱ<q>دْ</>عُوهُمْ لِءَا<o>بَآ</>ئِهِمْ هُوَ أَ<q>قْ</>سَطُ عِ<k>ندَ</> <h>ٱ</>للَّهِ ۚ فَ<w>إِن لَّ</>مْ تَعْلَ<o>مُوٓ</><s>ا۟</> ءَا<o>بَآ</>ءَهُمْ فَإِخْ<m>وَٰ</>نُكُمْ فِى <h>ٱ</><l>ل</>دِّينِ وَمَ<m>وَٰ</>لِيكُمْ ۚ وَلَيْسَ عَلَيْكُمْ جُنَا<k>حٌۭ فِ</>ي<o>مَآ</> أَخْطَأْ<f>تُم بِ</><m>هِۦ</> وَ<m>لَٰ</><d>كِن مَّ</>ا تَعَ<g>مَّ</>دَتْ قُلُوبُكُمْ ۚ وَكَانَ <h>ٱ</>للَّهُ غَفُو<w>رًۭا رَّ</>حِيمًا"},{"n":6,"w":[["ٱلنَّبِىُّ","al-nabiyu","The Prophet","নাবীই"],["أَوْلَىٰ","awlā","(is) closer","অধিক ঘনিষ্ঠ"],["بِٱلْمُؤْمِنِينَ","bil-mu'minīna","to the believers","কাছে মু’মিনদের"],["مِنْ","min","than","অপেক্ষা"],["أَنفُسِهِمْ ۖ","anfusihim","their own selves","নিজেদের তাদের"],["وَأَزْوَٰجُهُۥٓ","wa-azwājuhu","and his wives","এবং স্ত্রীগণ তার"],["أُمَّهَـٰتُهُمْ ۗ","ummahātu