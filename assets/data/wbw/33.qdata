া"],["فِى","fī","in","মধ্যে"],["ٱلْمَدِينَةِ","l-madīnati","the city","মদিনা (শহরের)"],["لَنُغْرِيَنَّكَ","lanugh'riyannaka","We will let you overpower them","অবশ্যই আমরা প্রবল করবো তোমাকে"],["بِهِمْ","bihim","We will let you overpower them","বিরুদ্ধে তাদের"],["ثُمَّ","thumma","then","এরপর"],["لَا","lā","not","না"],["يُجَاوِرُونَكَ","yujāwirūnaka","they will remain your neighbors","তোমার প্রতিবেশী হয়ে তারা থাকবে"],["فِيهَآ","fīhā","therein","মধ্যে তার"],["إِلَّا","illā","except","ছাড়া"],["قَلِيلًۭا","qalīlan","(for) a little","স্বল্প"]],"t":"۞ لَّ<w>ئِن لَّ</>مْ يَ<k>نتَ</>هِ <h>ٱ</>لْمُ<m>نَٰ</>فِقُونَ وَ<h>ٱ</>لَّذِينَ فِى قُلُوبِ<y>هِم مَّ</>رَ<d>ضٌۭ وَ</><h>ٱ</>لْمُرْجِفُونَ فِى <h>ٱ</>لْمَدِينَةِ لَنُغْرِيَ<g>نَّ</>كَ بِهِمْ ثُ<g>مَّ</> لَا يُجَاوِرُونَكَ فِي<o>هَآ</> إِلَّا قَلِيلًۭا"},{"n":61,"w":[["مَّلْعُونِينَ ۖ","mal‘ūnīna","Accursed","তারা অভিশপ্ত হয়ে"],["أَيْنَمَا","aynamā","wherever","যেখানেই"],["ثُقِفُوٓا۟","thuqifū","they are found","তাদের পাওয়া যাবে"],["أُخِذُوا۟","ukhidhū","they are seized","তাদের ধরা হবে"],["وَقُتِّلُوا۟","waquttilū","and massacred completely","ও তাদের হত্যা করা হবে"],["تَقْتِيلًۭا","taqtīlan","and massacred completely","(নির্মমভাবে) হত্যা"]],"t":"مَّلْعُونِينَ ۖ أَيْنَمَا ثُقِ<o>فُوٓ</><s>ا۟</> أُخِذُو<s>ا۟</> وَقُتِّلُو<s>ا۟</> تَ<q>قْ</>تِيلًۭا"},{"n":62,"w":[["سُنَّةَ","sunnata","(Such is the) Way","রীতি"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["فِى","fī","with","(তাদের) ক্ষেত্রেও"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["خَلَوْا۟","khalaw","passed away","অতীত হয়েছে"],["مِن","min","before","থেকে"],["قَبْلُ ۖ","qablu","before","পূর্ব"],["وَلَن","walan","and never","এবং কখনও না"],["تَجِدَ","tajida","you will find","পাবে তুমি"],["لِسُنَّةِ","lisunnati","in (the) Way","মধ্যে রীতির"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["تَبْدِيلًۭا","tabdīlan","any change","কোনো পরিবর্তন"]],"t":"سُ<g>نَّ</>ةَ <h>ٱ</>للَّهِ فِى <h>ٱ</>لَّذِينَ خَلَوْ<s>ا۟</> مِ<k>ن قَ</><q>بْ</>لُ ۖ وَلَ<k>ن تَ</>جِدَ لِسُ<g>نَّ</>ةِ <h>ٱ</>للَّهِ تَ<q>بْ</>دِيلًۭا"},{"n":63,"w":[["يَسْـَٔلُكَ","yasaluka","Ask you","তোমাকে প্রশ্ন করছে"],["ٱلنَّاسُ","l-nāsu","the people","মানুষ"],["عَنِ","‘ani","about","সম্পর্কে"],["ٱلسَّاعَةِ ۖ","l-sā‘ati","the Hour","ক্বিয়ামাত"],["قُلْ","qul","Say","বলো"],["إِنَّمَا","innamā","Only","\"কেবল"],["عِلْمُهَا","‘il'muhā","its knowledge","জ্ঞান তার"],["عِندَ","‘inda","(is) with","কাছে"],["ٱللَّهِ ۚ","l-lahi","Allah","আল্লাহর"],["وَمَا","wamā","And what","এবং কিসে"],["يُدْرِيكَ","yud'rīka","will make you know","তোমাকে জানাবে"],["لَعَلَّ","la‘alla","Perhaps","সম্ভবত"],["ٱلسَّاعَةَ","l-sā‘ata","the Hour","ক্বিয়ামাত"],["تَكُونُ","takūnu","is","হবে"],["قَرِيبًا","qarīban","near","নিকটে\""]],"t":"يَسْـَٔلُكَ <h>ٱ</><l>ل</><g>نَّ</>اسُ عَنِ <h>ٱ</><l>ل</>سَّاعَةِ ۖ قُلْ إِ<g>نَّ</>مَا عِلْمُهَا عِ<k>ندَ</> <h>ٱ</>للَّهِ ۚ وَمَا يُ<q>دْ</>رِيكَ لَعَلَّ <h>ٱ</><l>ل</>سَّاعَةَ تَكُونُ قَرِيبًا"},{"n":64,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَعَنَ","la‘ana","has cursed","অভিশাপ দেন"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","the disbelievers","কাফিরদেরকে"],["وَأَعَدَّ","wa-a‘adda","and has prepared","এবং প্রস্তুত করে রেখেছেন"],["لَهُمْ","lahum","for them","জন্যে তাদের"],["سَعِيرًا","sa‘īran","a Blaze","জ্বলন্ত আগুন"]],"t":"إِ<g>نَّ</> <h>ٱ</>للَّهَ لَعَنَ <h>ٱ</>لْ<m>كَٰ</>فِرِينَ وَأَعَدَّ لَهُمْ سَعِيرًا"},{"n":65,"w":[["خَـٰلِدِينَ","khālidīna","Abiding","তারা স্থায়ীভাবে থাকবে"],["فِيهَآ","fīhā","therein","মধ্যে তার"],["أَبَدًۭا ۖ","abadan","forever","চিরকাল"],["لَّا","lā","not","না"],["يَجِدُونَ","yajidūna","they will find","তারা পাবে"],["وَلِيًّۭا","waliyyan","any protector","কোনো অভিভাবক"],["وَلَا","walā","and not","আর না"],["نَصِيرًۭا","naṣīran","any helper","কোনো সাহায্যকারী"]],"t":"<m>خَٰ</>لِدِينَ فِي<o>هَآ</> أَبَ<w>دًۭا ۖ لَّ</>ا يَجِدُونَ وَلِ<d>يًّۭا وَ</>لَا نَصِيرًۭا"},{"n":66,"w":[["يَوْمَ","yawma","(The) Day","যে দিন"],["تُقَلَّبُ","tuqallabu","will be turned about","উলট-পালট করা হবে"],["وُجُوهُهُمْ","wujūhuhum","their faces","মুখমণ্ডল তাদের"],["فِى","fī","in","মধ্যে"],["ٱلنَّارِ","l-nāri","the Fire","আগুনের"],["يَقُولُونَ","yaqūlūna","they will say","তারা বলবে"],["يَـٰلَيْتَنَآ","yālaytanā","O we wish","\"হায়! আমাদের পরিতাপ"],["أَطَعْنَا","aṭa‘nā","we (had) obeyed","আমরা আনুগত্য করতাম (যদি)"],["ٱللَّهَ","l-laha","Allah","আল্লাহর"],["وَأَطَعْنَا","wa-aṭa‘nā","and obeyed","ও আমরা আনুগত্য করতাম (যদি)"],["ٱلرَّسُولَا۠","l-rasūlā","the Messenger","রাসূলের\""]],"t":"يَوْمَ تُقَلَّبُ وُجُوهُهُمْ فِى <h>ٱ</><l>ل</><g>نَّ</>ارِ يَقُولُونَ <m>يَٰ</>لَيْتَ<o>نَآ</> أَطَعْنَا <h>ٱ</>للَّهَ وَأَطَعْنَا <h>ٱ</><l>ل</>رَّسُولَا۠"},{"n":67,"w":[["وَقَالُوا۟","waqālū","And they will say","এবং তারা বলবে"],["رَبَّنَآ","rabbanā","Our Lord","\"হে আমাদের রব"],["إِنَّآ","innā","Indeed, we","নিশ্চয়ই আমরা"],["أَطَعْنَا","aṭa‘nā","[we] obeyed","আনুগত্য করেছি আমরা"],["سَادَتَنَا","sādatanā","our chiefs","নেতাদের আমাদের"],["وَكُبَرَآءَنَا","wakubarāanā","and our great men","ও বড়দের আমাদের"],["فَأَضَلُّونَا","fa-aḍallūnā","and they misled us","অতঃপর তারা ভ্রষ্ট করেছে আমাদেরকে"],["ٱلسَّبِيلَا۠","l-sabīlā","(from) the Way","পথ"]],"t":"وَقَالُو<s>ا۟</> رَبَّ<o>نَآ</> إِ<g>نَّ</><o>آ</> أَطَعْنَا سَادَتَنَا وَكُبَ<o>رَآ</>ءَنَا فَأَضَلُّونَا <h>ٱ</><l>ل</>سَّبِيلَا۠"},{"n":68,"w":[["رَبَّنَآ","rabbanā","Our Lord","হে আমাদের রব"],["ءَاتِهِمْ","ātihim","Give them","দিন তাদের"],["ضِعْفَيْنِ","ḍi‘'fayni","double","দ্বিগুণ"],["مِنَ","mina","[of]","থেকে"],["ٱلْعَذَابِ","l-‘adhābi","punishment","শাস্তি"],["وَٱلْعَنْهُمْ","wal-‘anhum","and curse them","এবং অভিশপ্ত করুন তাদেরকে"],["لَعْنًۭا","la‘nan","(with) a curse","অভিশাপে"],["كَبِيرًۭا","kabīran","great","বড়\""]],"t":"رَبَّ<o>نَآ</> ءَاتِهِمْ ضِعْفَيْنِ مِنَ <h>ٱ</>لْعَذَابِ وَ<h>ٱ</>لْعَنْهُمْ لَعْ<k>نًۭا كَ</>بِيرًۭا"},{"n":69,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you who believe","হে"],["ٱلَّذِينَ","alladhīna","O you who believe","যারা"],["ءَامَنُوا۟","āmanū","O you who believe","ঈমান এনেছো"],["لَا","lā","(Do) not","না"],["تَكُونُوا۟","takūnū","be","তোমরা হয়ো"],["كَٱلَّذِينَ","ka-alladhīna","like those who","(তাদের) মতো যারা"],["ءَاذَوْا۟","ādhaw","abused","কষ্ট দিয়েছিলো"],["مُوسَىٰ","mūsā","Musa","মূসাকে"],["فَبَرَّأَهُ","fabarra-ahu","then Allah cleared him","অতঃপর নির্দোষ প্রমাণ করলেন তাকে"],["ٱللَّهُ","l-lahu","then Allah cleared him","আল্লাহ"],["مِمَّا","mimmā","of what","ঐ বিষয় হ'তে যা"],["قَالُوا۟ ۚ","qālū","they said","তারা বলেছিলো"],["وَكَانَ","wakāna","And he was","এবং সে ছিলো"],["عِندَ","‘inda","near","কাছে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["وَجِيهًۭا","wajīhan","honorable","মর্যাদাবান"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> لَا تَكُونُو<s>ا۟</> كَ<h>ٱ</>لَّذِينَ ءَاذَوْ<s>ا۟</> مُوسَىٰ فَبَرَّأَهُ <h>ٱ</>للَّهُ مِ<g>مَّ</>ا قَالُو<s>ا۟ ۚ</> وَكَانَ عِ<k>ندَ</> <h>ٱ</>للَّهِ وَجِيهًۭا"},{"n":70,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you who believe","হে"],["ٱلَّذِينَ","alladhīna","O you who believe","যারা"],["ءَامَنُوا۟","āmanū","O you who believe","ঈমান এনেছো"],["ٱتَّقُوا۟","ittaqū","Fear","তোমরা ভয় করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["وَقُولُوا۟","waqūlū","and speak","এবং তোমরা বলো"],["قَوْلًۭا","qawlan","a word","কথা"],["سَدِيدًۭا","sadīdan","right","সঠিক"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> <h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</>للَّهَ وَقُولُو<s>ا۟</> قَوْلًۭ<k>ا سَ</>دِيدًۭا"},{"n":71,"w":[["يُصْلِحْ","yuṣ'liḥ","He will amend","তিনি সংশোধন করবেন"],["لَكُمْ","lakum","for you","জন্যে তোমাদের"],["أَعْمَـٰلَكُمْ","a‘mālakum","your deeds","কর্মসমূহকে তোমাদের"],["وَيَغْفِرْ","wayaghfir","and forgive","এবং ক্ষমা করে দিবেন"],["لَكُمْ","lakum","for you","জন্যে তোমাদের"],["ذُنُوبَكُمْ ۗ","dhunūbakum","your sins","পাপগুলোকে তোমাদের"],["وَمَن","waman","And whoever","এবং যে"],["يُطِعِ","yuṭi‘i","obeys","আনুগত্য করে"],["ٱللَّهَ","l-laha","Allah","আল্লাহর"],["وَرَسُولَهُۥ","warasūlahu","and His Messenger","ও রাসূলের তাঁর"],["فَقَدْ","faqad","certainly","তাহ'লে নিশ্চয়ই"],["فَازَ","fāza","has attained","সে সফল হলো"],["فَوْزًا","fawzan","an attainment","সাফল্য"],["عَظِيمًا","‘aẓīman","great","মহা"]],"t":"يُصْلِحْ لَكُمْ أَعْ<m>مَٰ</>لَكُمْ وَيَغْفِرْ لَكُمْ ذُنُوبَكُمْ ۗ وَ<d>مَن يُ</>طِعِ <h>ٱ</>للَّهَ وَرَسُولَهُ<m>ۥ</> فَقَ<q>دْ</> فَازَ فَوْزًا عَظِيمًا"},{"n":72,"w":[["إِنَّا","innā","Indeed, We","নিশ্চয়ই আমরা"],["عَرَضْنَا","‘araḍnā","[We] offered","পেশ করেছিলাম আমরা"],["ٱلْأَمَانَةَ","l-amānata","the Trust","এ-আমানত (কুরআন)"],["عَلَى","‘alā","to","উপর"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশসমূহের"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীর"],["وَٱلْجِبَالِ","wal-jibāli","and the mountains","ও পর্বতমালার"],["فَأَبَيْنَ","fa-abayna","but they refused","কিন্তু তারা অস্বীকার করলো"],["أَن","an","to","যে"],["يَحْمِلْنَهَا","yaḥmil'nahā","bear it","তারা বহন করবে তা"],["وَأَشْفَقْنَ","wa-ashfaqna","and they feared","আর তারা ভয় পেলো"],["مِنْهَا","min'hā","from it","থেকে তা"],["وَحَمَلَهَا","waḥamalahā","but bore it","এবং বহন করলো তা"],["ٱلْإِنسَـٰنُ ۖ","l-insānu","the man","মানুষ"],["إِنَّهُۥ","innahu","Indeed, he","নিশ্চয়ই সে"],["كَانَ","kāna","was","হলো"],["ظَلُومًۭا","ẓalūman","unjust","বড় সীমালঙ্ঘনকারী"],["جَهُولًۭا","jahūlan","ignorant","বড় অজ্ঞ"]],"t":"إِ<g>نَّ</>ا عَرَضْنَا <h>ٱ</>لْأَمَانَةَ عَلَى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ وَ<h>ٱ</>لْجِبَالِ فَأَبَيْنَ <d>أَن يَ</>حْمِلْنَهَا وَأَشْفَ<q>قْ</>نَ مِنْهَا وَحَمَلَهَا <h>ٱ</>لْإِ<k>نسَٰ</>نُ ۖ إِ<g>نَّ</>هُ<m>ۥ</> كَانَ ظَلُو<k>مًۭا جَ</>هُولًۭا"},{"n":73,"w":[["لِّيُعَذِّبَ","liyu‘adhiba","So that Allah may punish","(এর পরিণাম হলো এই যে) যেন শাস্তি দিবেন"],["ٱللَّهُ","l-lahu","So that Allah may punish","আল্লাহ"],["ٱلْمُنَـٰفِقِينَ","l-munāfiqīna","the hypocrite men","মুনাফিক পুরুষদেরকে"],["وَٱلْمُنَـٰفِقَـٰتِ","wal-munāfiqāti","and the hypocrite women","ও মুনাফিক নারীদেরকে"],["وَٱلْمُشْرِكِينَ","wal-mush'rikīna","and the polytheist men","এবং মুশরিক পুরুষদেরকে"],["وَٱلْمُشْرِكَـٰتِ","wal-mush'rikāti","and the polytheist women","ও মুশরিক নারীদেরকে"],["وَيَتُوبَ","wayatūba","and Allah will turn (in Mercy)","এবং ক্ষমা করবেন"],["ٱللَّهُ","l-lahu","and Allah will turn (in Mercy)","আল্লাহ"],["عَلَى","‘alā","to","উপর"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believing men","মু’মিন পুরুষদের"],["وَٱلْمُؤْمِنَـٰتِ ۗ","wal-mu'mināti","and the believing women","ও মু’মিন নারীদেরকে"],["وَكَانَ","wakāna","And Allah is","এবং হলেন"],["ٱللَّهُ","l-lahu","And Allah is","আল্লাহ"],["غَفُورًۭا","ghafūran","Oft-Forgiving","ক্ষমাশীল"],["رَّحِيمًۢا","raḥīman","Most Merciful","পরম দয়ালু"]],"t":"لِّيُعَذِّبَ <h>ٱ</>للَّهُ <h>ٱ</>لْمُ<m>نَٰ</>فِقِينَ وَ<h>ٱ</>لْمُ<m>نَٰفِقَٰ</>تِ وَ<h>ٱ</>لْمُشْرِكِينَ وَ<h>ٱ</>لْمُشْرِ<m>كَٰ</>تِ وَيَتُوبَ <h>ٱ</>للَّهُ عَلَى <h>ٱ</>لْمُؤْمِنِينَ وَ<h>ٱ</>لْمُؤْمِ<m>نَٰ</>تِ ۗ وَكَانَ <h>ٱ</>للَّهُ غَفُو<w>رًۭا رَّ</>حِيمًۢا"}]}