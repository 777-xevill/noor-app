{"n":33,"a":[{"n":1,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O Prophet","হে"],["ٱلنَّبِىُّ","l-nabiyu","O Prophet","নাবী"],["ٱتَّقِ","ittaqi","Fear","ভয় করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["وَلَا","walā","and (do) not","এবং না"],["تُطِعِ","tuṭi‘i","obey","আনুগত্য করো"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","the disbelievers","কাফিরদের"],["وَٱلْمُنَـٰفِقِينَ ۗ","wal-munāfiqīna","and the hypocrites","আর (না) মুনাফিকদেরকে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["كَانَ","kāna","is","হলেন"],["عَلِيمًا","‘alīman","All-Knower","সর্বজ্ঞ"],["حَكِيمًۭا","ḥakīman","All-Wise","প্রজ্ঞাময়"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</><l>ل</><g>نَّ</>بِىُّ <h>ٱ</>تَّقِ <h>ٱ</>للَّهَ وَلَا تُطِعِ <h>ٱ</>لْ<m>كَٰ</>فِرِينَ وَ<h>ٱ</>لْمُ<m>نَٰ</>فِقِينَ ۗ إِ<g>نَّ</> <h>ٱ</>للَّهَ كَانَ عَلِيمًا حَكِيمًۭا"},{"n":2,"w":[["وَٱتَّبِعْ","wa-ittabi‘","And follow","এবং অনুসরণ করো"],["مَا","mā","what","যা"],["يُوحَىٰٓ","yūḥā","is inspired","ওহী করা হয়েছে"],["إِلَيْكَ","ilayka","to you","প্রতি তোমার"],["مِن","min","from","পক্ষ হ'তে"],["رَّبِّكَ ۚ","rabbika","your Lord","রবের তোমার"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["كَانَ","kāna","is","হলেন"],["بِمَا","bimā","of what","ঐ বিষয়ে যা"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা কাজ করো"],["خَبِيرًۭا","khabīran","All-Aware","খুব অবহিত"]],"t":"وَ<h>ٱ</>تَّبِعْ مَا يُوحَ<o>ىٰٓ</> إِلَيْكَ <w>مِن رَّ</>بِّكَ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ كَانَ بِمَا تَعْمَلُونَ خَبِيرًۭا"},{"n":3,"w":[["وَتَوَكَّلْ","watawakkal","And put your trust","এবং নির্ভর করো"],["عَلَى","‘alā","in","উপর"],["ٱللَّهِ ۚ","l-lahi","Allah","আল্লাহর"],["وَكَفَىٰ","wakafā","And Allah is sufficient","এবং যথেষ্ট"],["بِٱللَّهِ","bil-lahi","And Allah is sufficient","আল্লাহই"],["وَكِيلًۭا","wakīlan","(as) Disposer of affairs","(দায়িত্বশীল বা) কর্মবিধায়করূপে"]],"t":"وَتَوَكَّلْ عَلَى <h>ٱ</>للَّهِ ۚ وَكَفَىٰ بِ<h>ٱ</>للَّهِ وَكِيلًۭا"},{"n":4,"w":[["مَّا","mā","Not","না"],["جَعَلَ","ja‘ala","Allah (has) made","সৃষ্টি করেছেন"],["