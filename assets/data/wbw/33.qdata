َّ","l-nabiya","the Prophet","নাবীকে"],["فَيَسْتَحْىِۦ","fayastaḥyī","and he is shy","কিন্তু সে সংকোচ বোধ করে (বলতে)"],["مِنكُمْ ۖ","minkum","of (dismissing) you","হ'তে তোমাদের"],["وَٱللَّهُ","wal-lahu","But Allah","অথচ আল্লাহ"],["لَا","lā","is not shy","না"],["يَسْتَحْىِۦ","yastaḥyī","is not shy","সংকোচ বোধ করেন"],["مِنَ","mina","of","হ'তে"],["ٱلْحَقِّ ۚ","l-ḥaqi","the truth","সত্য (বলা)"],["وَإِذَا","wa-idhā","And when","এবং যখন"],["سَأَلْتُمُوهُنَّ","sa-altumūhunna","you ask them","তাদের (অর্থাৎ নাবী স্ত্রীদের) হ'তে তোমরা চাও"],["مَتَـٰعًۭا","matā‘an","(for) anything","কোনো সামগ্রী"],["فَسْـَٔلُوهُنَّ","fasalūhunna","then ask them","তবে তোমরা তাদের কাছে চাও"],["مِن","min","from","হ'তে"],["وَرَآءِ","warāi","behind","পিছন"],["حِجَابٍۢ ۚ","ḥijābin","a screen","পর্দার"],["ذَٰلِكُمْ","dhālikum","That","সেটাই"],["أَطْهَرُ","aṭharu","(is) purer","পবিত্রতর"],["لِقُلُوبِكُمْ","liqulūbikum","for your hearts","জন্যে অন্তরসমূহের তোমাদের"],["وَقُلُوبِهِنَّ ۚ","waqulūbihinna","and their hearts","এবং অন্তরসমূহের তাদের (জন্যও)"],["وَمَا","wamā","And not","এবং না"],["كَانَ","kāna","is","ছিলো (সঙ্গত)"],["لَكُمْ","lakum","for you","জন্যে তোমাদের"],["أَن","an","that","যে"],["تُؤْذُوا۟","tu'dhū","you trouble","তোমরা কষ্ট দিবে"],["رَسُولَ","rasūla","(the) Messenger","রাসূলকে"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَلَآ","walā","and not","আর না"],["أَن","an","that","(সঙ্গত) যে"],["تَنكِحُوٓا۟","tankiḥū","you should marry","তোমরা বিয়ে করবে"],["أَزْوَٰجَهُۥ","azwājahu","his wives","স্ত্রীদেরকে তার"],["مِنۢ","min","after him","থেকে"],["بَعْدِهِۦٓ","ba‘dihi","after him","পর তার"],["أَبَدًا ۚ","abadan","ever","কখনও"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ذَٰلِكُمْ","dhālikum","that","সেটা"],["كَانَ","kāna","is","হলো"],["عِندَ","‘inda","near","কাছে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["عَظِيمًا","‘aẓīman","an enormity","গুরুতর (অপরাধ)"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> لَا تَ<q>دْ</>خُلُو<s>ا۟</> بُيُوتَ <h>ٱ</><l>ل</><g>نَّ</>بِىِّ إِ<o>لَّآ</> <d>أَن يُ</>ؤْذَنَ لَكُمْ إِلَىٰ طَعَامٍ غَيْرَ <m>نَٰ</>ظِرِينَ إِنَ<m>ىٰ</>هُ وَ<m>لَٰ</>كِنْ إِذَا دُعِيتُمْ فَ<h>ٱ</><q>دْ</>خُلُو<s>ا۟</> فَإِذَا طَعِمْتُمْ فَ<h>ٱ</><k>نتَ</>شِرُو<s>ا۟</> وَلَا مُسْتَـْٔنِسِينَ لِحَدِيثٍ ۚ إِ<g>نَّ</> <m>ذَٰ</>لِكُمْ كَانَ يُؤْذِى <h>ٱ</><l>ل</><g>نَّ</>بِىَّ فَيَسْتَحْ<m>ىِۦ</> مِ<k>نكُ</>مْ ۖ وَ<h>ٱ</>للَّهُ لَا يَسْتَحْ<m>ىِۦ</> مِنَ <h>ٱ</>لْحَقِّ ۚ وَإِذَا سَأَلْتُمُوهُ<g>نَّ</> مَ<m>تَٰ</><k>عًۭا فَ</>سْـَٔلُوهُ<g>نَّ</> <d>مِن وَ</><o>رَآ</>ءِ حِجَا<k>بٍۢ ۚ ذَٰ</>لِكُمْ أَ<q>طْ</>هَرُ لِقُلُوبِكُمْ وَقُلُوبِهِ<g>نَّ</> ۚ وَمَا كَانَ لَكُمْ أَ<k>ن تُ</>ؤْذُو<s>ا۟</> رَسُولَ <h>ٱ</>للَّهِ وَ<o>لَآ</> أَ<k>ن تَنكِ</><o>حُوٓ</><s>ا۟</> أَزْ<m>وَٰ</>جَهُ<m>ۥ</> <i>مِنۢ بَ</>عْدِ<o>هِۦٓ</> أَبَدًا ۚ إِ<g>نَّ</> <m>ذَٰ</>لِكُمْ كَانَ عِ<k>ندَ</> <h>ٱ</>للَّهِ عَظِيمًا"},{"n":54,"w":[["إِن","in","Whether","যদি"],["تُبْدُوا۟","tub'dū","you reveal","তোমরা প্রকাশ করো"],["شَيْـًٔا","shayan","a thing","কিছুু"],["أَوْ","aw","or","অথবা"],["تُخْفُوهُ","tukh'fūhu","conceal it","গোপন করো তা"],["فَإِنَّ","fa-inna","indeed","তবুও নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["كَانَ","kāna","is","হলেন"],["بِكُلِّ","bikulli","of all","সম্পর্কে সব"],["شَىْءٍ","shayin","things","কিছুরই"],["عَلِيمًۭا","‘alīman","All-Knower","খুব অবগত"]],"t":"إِ<k>ن تُ</><q>بْ</>دُو<s>ا۟</> شَيْـًٔا أَوْ تُخْفُوهُ فَإِ<g>نَّ</> <h>ٱ</>للَّهَ كَانَ بِكُلِّ شَىْءٍ عَلِيمًۭا"},{"n":55,"w":[["لَّا","lā","(There is) no","নেই"],["جُنَاحَ","junāḥa","blame","অপরাধ"],["عَلَيْهِنَّ","‘alayhinna","upon them","উপর তাদের"],["فِىٓ","fī","concerning","ক্ষেত্রে"],["ءَابَآئِهِنَّ","ābāihinna","their fathers","পিতাদের তাদের(সাথে দেখা সাক্ষাতের)"],["وَلَآ","walā","and not","আর না"],["أَبْنَآئِهِنَّ","abnāihinna","their sons","পুত্রদের তাদের"],["وَلَآ","walā","and not","আর না"],["إِخْوَٰنِهِنَّ","ikh'wānihinna","their brothers","ভাইদের তাদের"],["وَلَآ","walā","and not","আর না"],["أَبْنَآءِ","abnāi","sons","ছেলেদের"],["إِخْوَٰنِهِنَّ","ikh'wānihinna","(of) their brothers","ভা