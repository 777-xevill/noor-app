{"n":59,"a":[{"n":1,"w":[["سَبَّحَ","sabbaḥa","Glorifies","তাসবিহ করে"],["لِلَّهِ","lillahi","[to] Allah","আল্লাহর জন্য"],["مَا","mā","whatever","যা কিছু"],["فِى","fī","(is) in","মধ্যে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশসমূহের"],["وَمَا","wamā","and whatever","ও যা কিছু"],["فِى","fī","(is) in","মধ্যে"],["ٱلْأَرْضِ ۖ","l-arḍi","the earth","পৃথিবীর"],["وَهُوَ","wahuwa","And He","এবং তিনিই"],["ٱلْعَزِيزُ","l-‘azīzu","(is) the All-Mighty","পরাক্রমশালী"],["ٱلْحَكِيمُ","l-ḥakīmu","the All-Wise","মহাবিজ্ঞ"]],"t":"سَبَّحَ لِلَّهِ مَا فِى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَمَا فِى <h>ٱ</>لْأَرْضِ ۖ وَهُوَ <h>ٱ</>لْعَزِيزُ <h>ٱ</>لْحَ<p>كِي</>مُ"},{"n":2,"w":[["هُوَ","huwa","He","তিনিই"],["ٱلَّذِىٓ","alladhī","(is) the One Who","যিনি"],["أَخْرَجَ","akhraja","expelled","বের করেছেন"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieved","কুফুরি করেছিল"],["مِنْ","min","from","মধ্যে"],["أَهْلِ","ahli","(the) People","আহলে"],["ٱلْكِتَـٰبِ","l-kitābi","(of) the Scripture","কিতাবদের"],["مِن","min","from","হতে"],["دِيَـٰرِهِمْ","diyārihim","their homes","ঘরবাড়ি গুলো তাদের"],["لِأَوَّلِ","li-awwali","at (the) first","প্রথম"],["ٱلْحَشْرِ ۚ","l-ḥashri","gathering","সমাবেশেই"],["مَا","mā","Not","নাই"],["ظَنَنتُمْ","ẓanantum","you think","তোমরা ধারণা কর"],["أَن","an","that","যে"],["يَخْرُجُوا۟ ۖ","yakhrujū","they would leave","তারা বের হবে"],["وَظَنُّوٓا۟","waẓannū","and they thought","ও তারা ধারণা করেছিল"],["أَنَّهُم","annahum","that [they]","তারা যে"],["مَّانِعَتُهُمْ","māni‘atuhum","would defend them","তাদের রক্ষাকারী"],["حُصُونُهُم","ḥuṣūnuhum","their fortresses","তাদের দুর্গগুলো"],["مِّنَ","mina","against","হতে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["فَأَتَىٰهُمُ","fa-atāhumu","But came to them","তাদের (কাছে) আসলেন কিন্তু"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["مِنْ","min","from","(এমনদিক) হতে"],["حَيْثُ","ḥaythu","where","যেখানে"],["لَمْ","lam","not","নাই"],["يَحْتَسِبُوا۟ ۖ","yaḥtasibū","they expected","তারা ভাবেও"],["وَقَذَفَ","waqadhafa","and He cast","ও সঞ্চার করলেন"],["فِى","fī","into","মধ্যে"],["قُلُوبِهِمُ","qulūbihimu","their hearts","তাদের অন্তর সমূহের"],["ٱلرُّعْبَ ۚ","l-ru‘'ba","[the] terror","ক্রাস"],["يُخْرِبُونَ","yukh'ribūna","they destroyed","তারা ধ্বংস করল"],["بُيُوتَهُم","buyūtahum","their houses","তাদের ঘরগুলো"],["بِأَيْدِيهِمْ","bi-aydīhim","with their hands","তাদের হাত দিয়ে"],["وَأَيْدِى","wa-aydī","and the hands","ও হাতগুলো"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","(of) the believers","মুমিনদের"],["فَٱعْتَبِرُوا۟","fa-i‘'tabirū","So take a lesson","তোমরা শিক্ষা অতএব গ্রহণ কর"],["يَـٰٓأُو۟لِى","yāulī","O those endowed","হে"],["ٱلْأَبْصَـٰرِ","l-abṣāri","(with) insight","দৃষ্টিবানরা"]],"t":"هُوَ <h>ٱ</>لَّ<o>ذِىٓ</> أَخْرَجَ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> مِنْ أَهْلِ <h>ٱ</>لْكِ<m>تَٰ</>بِ مِ<k>ن دِ</><m>يَٰ</>رِهِمْ لِأَوَّلِ <h>ٱ</>لْحَشْرِ ۚ مَا ظَنَ<k>نتُ</>مْ <d>أَن يَ</>خْرُجُو<s>ا۟ ۖ</> وَظَ<g>نُّ</><o>وٓ</><s>ا۟</> أَ<g>نَّ</><y>هُم مَّ</>انِعَتُهُمْ حُصُونُ<y>هُم مِّ</>نَ <h>ٱ</>للَّهِ فَأَتَ<m>ىٰ</>هُمُ <h>ٱ</>للَّهُ مِنْ حَيْثُ لَمْ يَحْتَسِبُو<s>ا۟ ۖ</> وَقَذَفَ فِى قُلُوبِهِمُ <h>ٱ</><l>ل</>رُّعْبَ ۚ يُخْرِبُونَ بُيُوتَ<f>هُم بِ</>أَيْدِيهِمْ وَأَيْدِى <h>ٱ</>لْمُؤْمِنِينَ فَ<h>ٱ</>عْتَبِرُو<s>ا۟</> <o>يَٰٓ</>أُ<s>و۟</>لِى <h>ٱ</>لْأَ<q>بْ</><p>صَٰ</>رِ"},{"n":3,"w":[["وَلَوْلَآ","walawlā","And if not","এবং যদি না"],["أَن","an","[that]","যে"],["كَتَبَ","kataba","(had) decreed","লিখতেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["عَلَيْهِمُ","‘alayhimu","for them","তাদের উপর"],["ٱلْجَلَآءَ","l-jalāa","the exile","নির্বাসন"],["لَعَذَّبَهُمْ","la‘adhabahum","certainly He (would) have punished them","তাদের শাস্তি অবশ্যই দিতেন"],["فِى","fī","in","মধ্যে"],["ٱلدُّنْيَا ۖ","l-dun'yā","the world","দুনিয়ার"],["وَلَهُمْ","walahum","and for them","এবং তাদের জন্য"],["فِى","fī","in","(আছে)"],["ٱلْـَٔاخِرَةِ","l-ākhirati","the Hereafter","আখেরাতে"],["عَذَابُ","‘adhābu","(is) a punishment","শাস্তি"],["ٱلنَّارِ","l-nāri","(of) the Fire","আগুনের"]],"t":"وَلَوْ<o>لَآ</> أَ<k>ن كَ</>تَبَ <h>ٱ</>للَّهُ عَلَيْهِمُ <h>ٱ</>لْجَ<o>لَآ</>ءَ لَعَذَّبَهُمْ فِى <h>ٱ</><l>ل</>دُّنْيَا ۖ وَلَهُمْ فِى <h>ٱ</>لْءَاخِرَةِ عَذَابُ <h>ٱ</><l>ل</><g>نَّ</><p>ا</>رِ"},{"n":4,"w":[["ذَٰلِكَ","dhālika","That","এটা"],["بِأَنَّهُمْ","bi-annahum","(is) because [they]","তারা যে এজন্যে"],["شَآقُّوا۟","shāqqū","they opposed","বিরুদ্ধচারণ করেছিল"],["ٱللَّهَ","l-laha","Allah","আল্লাহর"],["وَرَسُولَهُۥ ۖ","warasūlahu","and His Messenger","ও তার রসুলের"],["وَمَن","waman","And whoever","এবং যে"],["يُشَآقِّ","yushāqqi","opposes","বিরুদ্ধচারণ করে"],["ٱللَّهَ","l-laha","Allah","আল্লাহর"],["فَإِنَّ","fa-inna","then indeed","নিশ্চয় অতঃপর"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["شَدِيدُ","shadīdu","(is) severe","কঠোর"],["ٱلْعِقَابِ","l-‘iqābi","(in) penalty","শাস্তিদানে"]],"t":"<m>ذَٰ</>لِكَ بِأَ<g>نَّ</>هُمْ <n>شَآ</>قُّو<s>ا۟</> <h>ٱ</>للَّهَ وَرَسُولَهُ<m>ۥ</> ۖ وَ<d>مَن يُ</><n>شَآ</>قِّ <h>ٱ</>للَّهَ فَإِ<g>نَّ</> <h>ٱ</>للَّهَ شَدِيدُ <h>ٱ</>لْعِ<p>قَا</><q>بِ</>"},{"n":5,"w":[["مَا","mā","Whatever","যা"],["قَطَعْتُم","qaṭa‘tum","you cut down","তোমরা কেটেছ"],["مِّن","min","of","মধ্য হতে"],["لِّينَةٍ","līnatin","(the) palm-trees","খেজুর গাছের"],["أَوْ","aw","or","বা"],["تَرَكْتُمُوهَا","taraktumūhā","you left them","তা তোমরা ছেড়ে দিয়েছ"],["قَآئِمَةً","qāimatan","standing","দাঁড়ান অবস্থায়"],["عَلَىٰٓ","‘alā","on","উপর"],["أُصُولِهَا","uṣūlihā","their roots","তারা শিকড়গুলোর"],["فَبِإِذْنِ","fabi-idh'ni","it (was) by the permission","অনুমতিক্রমে তা'তো"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَلِيُخْزِىَ","waliyukh'ziya","and that He may disgrace","এবং লাঞ্ছিত করার জন্যে"],["ٱلْفَـٰسِقِينَ","l-fāsiqīna","the defiantly disobedient","ফাসেকদের"]],"t":"مَا قَطَعْ<y>تُم مِّ</><w>ن لِّ</>ينَةٍ أَوْ تَرَكْتُمُوهَا <o>قَآ</>ئِمَةً عَلَ<o>ىٰٓ</> أُصُولِهَا فَبِإِذْنِ <h>ٱ</>للَّهِ وَلِيُخْزِىَ <h>ٱ</>لْ<m>فَٰ</>سِ<p>قِي</>نَ"},{"n":6,"w":[["وَمَآ","wamā","And what","এবং যা"],["أَفَآءَ","afāa","(was) restored","ফায় দিয়েছে"],["ٱللَّهُ","l-lahu","(by) Allah","আল্লাহ"],["عَلَىٰ","‘alā","to","নিকট"],["رَسُولِهِۦ","rasūlihi","His Messenger","তার রসূলের"],["مِنْهُمْ","min'hum","from them","তাদের থেকে"],["فَمَآ","famā","then not","নাই এ জন্য"],["أَوْجَفْتُمْ","awjaftum","you made expedition","তোমরা দৌড়াও"],["عَلَيْهِ","‘alayhi","for it","তার উপর"],["مِنْ","min","of","কোন"],["خَيْلٍۢ","khaylin","horses","ঘোড়া"],["وَلَا","walā","and not","এবং না"],["رِكَابٍۢ","rikābin","camels","উট"],["وَلَـٰكِنَّ","walākinna","but","কিন্তু"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يُسَلِّطُ","yusalliṭu","gives power","আধিপত্য দেন"],["رُسُلَهُۥ","rusulahu","(to) His Messengers","তার রসূলদেরকে"],["عَلَىٰ","‘alā","over","উপর"],["مَن","man","whom","যার"],["يَشَآءُ ۚ","yashāu","He wills","তিনি ইচ্ছে করেন"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["عَلَىٰ","‘alā","(is) on","উপর"],["كُلِّ","kulli","every","সব"],["شَىْءٍۢ","shayin","thing","কিছুুর"],["قَدِيرٌۭ","qadīrun","All-Powerful","ক্ষমতাবান"]],"t":"وَ<o>مَآ</> أَ<o>فَآ</>ءَ <h>ٱ</>للَّهُ عَلَىٰ رَسُولِ<m>هِۦ</> مِنْهُمْ فَ<o>مَآ</> أَوْجَفْتُمْ عَلَيْهِ مِنْ خَيْ<d>لٍۢ وَ</>لَا رِكَا<d>بٍۢ وَ</><m>لَٰ</>كِ<g>نَّ</> <h>ٱ</>للَّهَ يُسَلِّطُ رُسُلَهُ<m>ۥ</> عَلَىٰ <d>مَن يَ</><o>شَآ</>ءُ ۚ وَ<h>ٱ</>للَّهُ عَلَىٰ كُلِّ <k>شَىْءٍۢ قَ</><p>دِي</>رٌۭ"},{"n":7,"w":[["مَّآ","mā","What","যা"],["أَفَآءَ","afāa","(was) restored","ফায় দিয়েছেন"],["ٱللَّهُ","l-lahu","(by) Allah","আল্লাহ"],["عَلَىٰ","‘alā","to","(উপর)"],["رَسُولِهِۦ","rasūlihi","His Messenger","তার রাসূলকে"],["مِنْ","min","from","হতে"],["أَهْلِ","ahli","(the) people","বাসীদের"],["ٱلْقُرَىٰ","l-qurā","(of) the towns","জনপদ"],["فَلِلَّهِ","falillahi","(it is) for Allah","আল্লাহর জন্যে তা"],["وَلِلرَّسُولِ","walilrrasūli","and His Messenger","ও রসূলের জন্যে"],["وَلِذِى","walidhī","and for those","এবং জন্যে"],["ٱلْقُرْبَىٰ","l-qur'bā","(of) the kindred","নিকট আত্মীয় স্বজনদের"],["وَٱلْيَتَـٰمَىٰ","wal-yatāmā","and the orphans","ও য়াতীমদের"],["وَٱلْمَسَـٰكِينِ","wal-masākīni","and the needy","ও অভাবগ্রস্তদের"],["وَٱبْنِ","wa-ib'ni","and","ও"],["ٱلسَّبِيلِ","l-sabīli","the wayfarer","পথিকদের"],["كَىْ","kay","that","যাতে"],["لَا","lā","not","না"],["يَكُونَ","yakūna","it becomes","হয়"],["دُولَةًۢ","dūlatan","a (perpetual) circulation","আবর্তিত"],["بَيْنَ","bayna","between","মাঝে"],["ٱلْأَغْنِيَآءِ","l-aghniyāi","the rich","ধনীদের"],["مِنكُمْ ۚ","minkum","among you","তোমাদের মধ্যে"],["وَمَآ","wamā","And whatever","এবং যা"],["ءَاتَىٰكُمُ","ātākumu","gives you","তোমাদের দান করেন"],["ٱلرَّسُولُ","l-rasūlu","the Messenger","রসূল"],["فَخُذُوهُ","fakhudhūhu","take it","তা তোমরা গ্রহণ অতঃপর কর"],["وَمَا","wamā","and whatever","এবং যা"],["نَهَىٰكُمْ","nahākum","he forbids you","তোমাদের নিষেধ করেন"],["عَنْهُ","‘anhu","from it","তা থেকে"],["فَٱنتَهُوا۟ ۚ","fa-intahū","refrain","তোমরা বিরত অতঃপর হও"],["وَٱتَّقُوا۟","wa-ittaqū","And fear","এবং তোমরা ভয়কর"],["ٱللَّهَ ۖ","l-laha","Allah","আল্লাহকে"],["إِنَّ","inna","Indeed","নিশ্চয়"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["شَدِيدُ","shadīdu","(is) severe","কঠোর"],["ٱلْعِقَابِ","l-‘iqābi","(in) penalty","শাস্তিদানে"]],"t":"<o>مَّآ</> أَ<o>فَآ</>ءَ <h>ٱ</>للَّهُ عَلَىٰ رَسُولِ<m>هِۦ</> مِنْ أَهْلِ <h>ٱ</>لْقُرَىٰ فَلِلَّهِ وَلِلرَّسُولِ وَلِذِى <h>ٱ</>لْقُرْبَىٰ وَ<h>ٱ</>لْيَ<m>تَٰ</>مَىٰ وَ<h>ٱ</>لْمَ<m>سَٰ</>كِينِ وَ<h>ٱ</><q>بْ</>نِ <h>ٱ</><l>ل</>سَّبِيلِ كَىْ لَا يَكُونَ دُولَ<i>ةًۢ بَ</>يْنَ <h>ٱ</>لْأَغْنِ<o>يَآ</>ءِ مِ<k>نكُ</>مْ ۚ وَ<o>مَآ</> ءَاتَ<m>ىٰ</>كُمُ <h>ٱ</><l>ل</>رَّسُولُ فَخُذُوهُ وَمَا نَهَ<m>ىٰ</>كُمْ عَنْهُ فَ<h>ٱ</><k>نتَ</>هُو<s>ا۟ ۚ</> وَ<h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</>للَّهَ ۖ إِ<g>نَّ</> <h>ٱ</>للَّهَ شَدِيدُ <h>ٱ</>لْعِ<p>قَا</><q>بِ</>"},{"n":8,"w":[["لِلْفُقَرَآءِ","lil'fuqarāi","For the poor","অভাবগ্রস্তদের জন্যে"],["ٱلْمُهَـٰجِرِينَ","l-muhājirīna","emigrants","মাোহাজিরদের"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["أُخْرِجُوا۟","ukh'rijū","were expelled","বহিষ্কৃত হয়েছে"],["مِن","min","from","হতে"],["دِيَـٰرِهِمْ","diyārihim","their homes","তাদের ঘোড়বাড়ী গুলো"],["وَأَمْوَٰلِهِمْ","wa-amwālihim","and their properties","ও তাদের সম্পদগুলো"],["يَبْتَغُونَ","yabtaghūna","seeking","তারা পেতে চা্য়"],["فَضْلًۭا","faḍlan","bounty","অনুগ্রহ"],["مِّنَ","mina","from","থেকে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["وَرِضْوَٰنًۭا","wariḍ'wānan","and pleasure","ও সন্তুষ্টি"],["وَيَنصُرُونَ","wayanṣurūna","and helping","এবং তারা সাহায্য করে"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["وَرَسُولَهُۥٓ ۚ","warasūlahu","and His Messenger","ও তার রসূলকে"],["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসবলোক"],["هُمُ","humu","they","তারাই"],["ٱلصَّـٰدِقُونَ","l-ṣādiqūna","(are) the truthful","সত্যবাদী"]],"t":"لِلْفُقَ<o>رَآ</>ءِ <h>ٱ</>لْمُ<m>هَٰ</>جِرِينَ <h>ٱ</>لَّذِينَ أُخْرِجُو<s>ا۟</> مِ<k>ن دِ</><m>يَٰ</>رِهِمْ وَأَمْ<m>وَٰ</>لِهِمْ يَ<q>بْ</>تَغُونَ فَضْلًۭ<d>ا مِّ</>نَ <h>ٱ</>للَّهِ وَرِضْ<m>وَٰ</><d>نًۭا وَ</>يَ<k>نصُ</>رُونَ <h>ٱ</>للَّهَ وَرَسُولَهُ<o>ۥٓ ۚ</> أُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</><l>ل</><m>صَّٰ</>دِ<p>قُو</>نَ"},{"n":9,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["تَبَوَّءُو","tabawwaū","settled","বসবাস করেছে"],["ٱلدَّارَ","l-dāra","(in) the home","(এই) নগরীতে"],["وَٱلْإِيمَـٰنَ","wal-īmāna","and (accepted) faith","এবং ঈমান (এনেছে)"],["مِن","min","from","মধ্য হতে"],["قَبْلِهِمْ","qablihim","before them","তাদের  পূর্বে"],["يُحِبُّونَ","yuḥibbūna","love","তারা ভালোবাসে"],["مَنْ","man","(those) who","(তাদেরকে) যারা"],["هَاجَرَ","hājara","emigrated","হিজরত করেছে"],["إِلَيْهِمْ","ilayhim","to them","তাদের দিকে"],["وَلَا","walā","and not","এবং না"],["يَجِدُونَ","yajidūna","they find","তারাপায়"],["فِى","fī","in","মধ্যে"],["صُدُورِهِمْ","ṣudūrihim","their breasts","তাদের অন্তরগুলোর"],["حَاجَةًۭ","ḥājatan","any want","প্রয়োজনের (অনুভূতি)"],["مِّمَّآ","mimmā","of what","(যা) তা থেকে"],["أُوتُوا۟","ūtū","they were given","তাদের দেয়া হয়"],["وَيُؤْثِرُونَ","wayu'thirūna","but prefer","এবং তারা প্রাধান্য দেয়"],["عَلَىٰٓ","‘alā","over","উপর"],["أَنفُسِهِمْ","anfusihim","themselves","তাদের নিজেদের"],["وَلَوْ","walaw","even though","এবং যদিও"],["كَانَ","kāna","was","আছে"],["بِهِمْ","bihim","with them","তাদের সাথে"],["خَصَاصَةٌۭ ۚ","khaṣāṣatun","poverty","অঅভাব অনটন"],["وَمَن","waman","And whoever","এবং যে"],["يُوقَ","yūqa","is saved","রক্ষা করবে"],["شُحَّ","shuḥḥa","(from) stinginess","কৃপণতা (থেকে)"],["نَفْسِهِۦ","nafsihi","(of) his soul","তার নিজেকে"],["فَأُو۟لَـٰٓئِكَ","fa-ulāika","then those","ঐসব অতঃপর লোক"],["هُمُ","humu","[they]","তারাই"],["ٱلْمُفْلِحُونَ","l-muf'liḥūna","(are) the successful ones","সফলকাম"]],"t":"وَ<h>ٱ</>لَّذِينَ تَبَوَّءُو <h>ٱ</><l>ل</>دَّارَ وَ<h>ٱ</>لْإِي<m>مَٰ</>نَ مِ<k>ن قَ</><q>بْ</>لِهِمْ يُحِبُّونَ مَنْ هَاجَرَ إِلَيْهِمْ وَلَا يَجِدُونَ فِى صُدُورِهِمْ حَاجَ<d>ةًۭ مِّ</><g>مَّ</><o>آ</> أُوتُو<s>ا۟</> وَيُؤْثِرُونَ عَلَ<o>ىٰٓ</> أَ<k>نفُ</>سِهِمْ وَلَوْ كَانَ بِهِمْ خَصَاصَ<d>ةٌۭ ۚ وَمَن يُ</>وقَ شُحَّ نَفْسِ<m>هِۦ</> فَأُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</>لْمُفْلِ<p>حُو</>نَ"},{"n":10,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["جَآءُو","jāū","came","এসেছে"],["مِنۢ","min","from","মধ্য হতে"],["بَعْدِهِمْ","ba‘dihim","after them","তাদের পরে"],["يَقُولُونَ","yaqūlūna","they say","তারা বলে"],["رَبَّنَا","rabbanā","Our Lord","\"হে আমাদের রব"],["ٱغْفِرْ","igh'fir","forgive","ক্ষমা কর"],["لَنَا","lanā","us","আমাদের"],["وَلِإِخْوَٰنِنَا","wali-ikh'wāninā","and our brothers","ও আমাদের ভাই দেরকে"],["ٱلَّذِينَ","alladhīna","who","যারা"],["سَبَقُونَا","sabaqūnā","preceded us","আমাদের অগ্রণী হয়েছে"],["بِٱلْإِيمَـٰنِ","bil-īmāni","in faith","ইমানের ক্ষেত্রে"],["وَلَا","walā","and (do) not","এবং না"],["تَجْعَلْ","taj‘al","put","রেখো"],["فِى","fī","in","মধ্যে"],["قُلُوبِنَا","qulūbinā","our hearts","আমদের অন্তর গুলোর"],["غِلًّۭا","ghillan","any rancor","হিংসা বিদ্বেষ"],["لِّلَّذِينَ","lilladhīna","towards those who","যারাা (তাদের) জন্য"],["ءَامَنُوا۟","āmanū","believed","ইমান এনেছে"],["رَبَّنَآ","rabbanā","Our Lord","হে আমাাদের রব"],["إِنَّكَ","innaka","indeed You","তুমি নিশ্চয়"],["رَءُوفٌۭ","raūfun","(are) Full of Kindness","দয়ালু"],["رَّحِيمٌ","raḥīmun","Most Merciful","মেহেরবান\""]],"t":"وَ<h>ٱ</>لَّذِينَ <o>جَآ</>ءُو <i>مِنۢ بَ</>عْدِهِمْ يَقُولُونَ رَبَّنَا <h>ٱ</>غْفِرْ لَنَا وَلِإِخْ<m>وَٰ</>نِنَا <h>ٱ</>لَّذِينَ سَبَقُونَا بِ<h>ٱ</>لْإِي<m>مَٰ</>نِ وَلَا تَ<q>جْ</>عَلْ فِى قُلُوبِنَا غِ<w>لًّۭا لِّ</>لَّذِينَ ءَامَنُو<s>ا۟</> رَبَّ<o>نَآ</> إِ<g>نَّ</>كَ رَءُو<w>فٌۭ رَّ</><p>حِي</>مٌ"},{"n":11,"w":[["۞ أَلَمْ","alam","Do not","নাইকি"],["تَرَ","tara","you see","তুমি দেখ"],["إِلَى","ilā","[to]","প্রতি"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["نَافَقُوا۟","nāfaqū","(were) hypocrites","মুনাফেকী করেছে"],["يَقُولُونَ","yaqūlūna","saying","তারা বলেে"],["لِإِخْوَٰنِهِمُ","li-ikh'wānihimu","to their brothers","তাদের ভাই দের"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieved","কুফুরি করেছে"],["مِنْ","min","among","মধ্যে"],["أَهْلِ","ahli","the People","আহলে"],["ٱلْكِتَـٰبِ","l-kitābi","(of) the Scripture","কিতাবদের"],["لَئِنْ","la-in","If","\"যদি নিশ্চয়"],["أُخْرِجْتُمْ","ukh'rij'tum","you are expelled","তোমরা বহিষ্কৃত হও"],["لَنَخْرُجَنَّ","lanakhrujanna","surely we will leave","আমরা বের হব অবশ্যই"],["مَعَكُمْ","ma‘akum","with you","তোমাদের সাথে"],["وَلَا","walā","and not","এবং না"],["نُطِيعُ","nuṭī‘u","we will obey","আনুগত্য করব আমরা"],["فِيكُمْ","fīkum","concerning you","তোমাদের ব্যাপারে"],["أَحَدًا","aḥadan","anyone","কারও"],["أَبَدًۭا","abadan","ever","কখনও"],["وَإِن","wa-in","and if","এবং যদি"],["قُوتِلْتُمْ","qūtil'tum","you are fought","তোমাদের (বিরুদ্ধে) যুদ্ধ করা হয়"],["لَنَنصُرَنَّكُمْ","lananṣurannakum","certainly we will help you","তোমাদের সাহায্য আমরা অবশ্যই করব\""],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["يَشْهَدُ","yashhadu","bears witness","সাক্ষ্য দিচ্ছেন"],["إِنَّهُمْ","innahum","that they","তারা নিশ্চয়"],["لَكَـٰذِبُونَ","lakādhibūna","(are) surely liars","অবশ্যই মিথ্যাবাদী"]],"t":"۞ أَلَمْ تَرَ إِلَى <h>ٱ</>لَّذِينَ نَافَقُو<s>ا۟</> يَقُولُونَ لِإِخْ<m>وَٰ</>نِهِمُ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> مِنْ أَهْلِ <h>ٱ</>لْكِ<m>تَٰ</>بِ لَئِنْ أُخْرِ<q>جْ</>تُمْ لَنَخْرُجَ<g>نَّ</> مَعَكُمْ وَلَا نُطِيعُ فِيكُمْ أَحَدًا أَبَ<d>دًۭا وَ</>إِ<k>ن قُ</>وتِلْتُمْ لَنَ<k>نصُ</>رَ<g>نَّ</>كُمْ وَ<h>ٱ</>للَّهُ يَشْهَدُ إِ<g>نَّ</>هُمْ لَ<m>كَٰ</>ذِ<p>بُو</>نَ"},{"n":12,"w":[["لَئِنْ","la-in","If","যদি বস্তুত"],["أُخْرِجُوا۟","ukh'rijū","they are expelled","তারা বহিষ্কৃত হয়"],["لَا","lā","not","না"],["يَخْرُجُونَ","yakhrujūna","they will leave","তারা বের হবে"],["مَعَهُمْ","ma‘ahum","with them","তাদের সাথে"],["وَلَئِن","wala-in","and if","এবং যদি নিশ্চয়"],["قُوتِلُوا۟","qūtilū","they are fought","তাদের (বিরুদ্ধে) যুদ্ধ করা হয়"],["لَا","lā","not","না"],["يَنصُرُونَهُمْ","yanṣurūnahum","they will help them","তাদের সাহায্য তারা করবে"],["وَلَئِن","wala-in","And if","এবং যদি নিশ্চয়"],["نَّصَرُوهُمْ","naṣarūhum","they help them","তাদের তারা সাহায্য করেও"],["لَيُوَلُّنَّ","layuwallunna","certainly they will turn","অবশ্যই"],["ٱلْأَدْبَـٰرَ","l-adbāra","(their) backs","পৃষ্ঠ প্রদর্শন করবে"],["ثُمَّ","thumma","then","এরপর"],["لَا","lā","not","না"],["يُنصَرُونَ","yunṣarūna","they will be helped","তাদের  সাহায্য করা হবে"]],"t":"لَئِنْ أُخْرِجُو<s>ا۟</> لَا يَخْرُجُونَ مَعَهُمْ وَلَئِ<k>ن قُ</>وتِلُو<s>ا۟</> لَا يَ<k>نصُ</>رُونَهُمْ وَلَ<d>ئِن نَّ</>صَرُوهُمْ لَيُوَلُّ<g>نَّ</> <h>ٱ</>لْأَ<q>دْ</><m>بَٰ</>رَ ثُ<g>مَّ</> لَا يُ<k>نصَ</><p>رُو</>نَ"},{"n":13,"w":[["لَأَنتُمْ","la-antum","Certainly you","তোমরা প্রকৃত পক্ষে"],["أَشَدُّ","ashaddu","(are) more intense","অধিকতর"],["رَهْبَةًۭ","rahbatan","(in) fear","ভয়ংকর"],["فِى","fī","in","মধ্যে"],["صُدُورِهِم","ṣudūrihim","their breasts","তাদের বুকের"],["مِّنَ","mina","than","চেয়েও"],["ٱللَّهِ ۚ","l-lahi","Allah","আল্লাহর"],["ذَٰلِكَ","dhālika","That","এটা"],["بِأَنَّهُمْ","bi-annahum","(is) because they","তারা যে একারণে"],["قَوْمٌۭ","qawmun","(are) a people","(এমন) একজাতি"],["لَّا","lā","(who do) not","না"],["يَفْقَهُونَ","yafqahūna","understand","তারা বুঝে"]],"t":"لَأَ<k>نتُ</>مْ أَشَدُّ رَهْبَ<k>ةًۭ فِ</>ى صُدُورِ<y>هِم مِّ</>نَ <h>ٱ</>للَّهِ ۚ <m>ذَٰ</>لِكَ بِأَ<g>نَّ</>هُمْ قَوْ<w>مٌۭ لَّ</>ا يَفْقَ<p>هُو</>نَ"},{"n":14,"w":[["لَا","lā","Not","না"],["يُقَـٰتِلُونَكُمْ","yuqātilūnakum","will they fight you","তোমাদের সাথে লড়বে তারা"],["جَمِيعًا","jamī‘an","all","একত্রে"],["إِلَّا","illā","except","কিন্তু"],["فِى","fī","in","মধ্যে"],["قُرًۭى","quran","towns","জনপদের"],["مُّحَصَّنَةٍ","muḥaṣṣanatin","fortified","দুর্গ পরিবেষ্টিত"],["أَوْ","aw","or","অথবা"],["مِن","min","from","থেকে"],["وَرَآءِ","warāi","behind","পিছনে"],["جُدُرٍۭ ۚ","judurin","walls","প্রাচীরসমূহের"],["بَأْسُهُم","basuhum","Their violence","তাদের বিরুদ্ধতা"],["بَيْنَهُمْ","baynahum","among themselves","তাদের মধ্য"],["شَدِيدٌۭ ۚ","shadīdun","(is) severe","প্রবল"],["تَحْسَبُهُمْ","taḥsabuhum","You think they","তাদের মনে কর তুমি"],["جَمِيعًۭا","jamī‘an","(are) united","ঐক্যবদ্ধ"],["وَقُلُوبُهُمْ","waqulūbuhum","but their hearts","তাদের অন্তরগুলো কিন্তু"],["شَتَّىٰ ۚ","shattā","(are) divided","দ্বিধাবিভক্ত"],["ذَٰلِكَ","dhālika","That","এটা"],["بِأَنَّهُمْ","bi-annahum","(is) because they","তারা যে কারণে"],["قَوْمٌۭ","qawmun","(are) a people","একজাতি"],["لَّا","lā","not","না"],["يَعْقِلُونَ","ya‘qilūna","they reason","তারা জানে"]],"t":"لَا يُ<m>قَٰ</>تِلُونَكُمْ جَمِيعًا إِلَّا فِى قُ<d>رًۭى مُّ</>حَصَّنَةٍ أَوْ <d>مِن وَ</><o>رَآ</>ءِ جُدُ<i>رٍۭ ۚ بَ</>أْسُ<f>هُم بَ</>يْنَهُمْ شَدِي<k>دٌۭ ۚ تَ</>حْسَبُهُمْ جَمِي<d>عًۭا وَ</>قُلُوبُهُمْ شَتَّىٰ ۚ <m>ذَٰ</>لِكَ بِأَ<g>نَّ</>هُمْ قَوْ<w>مٌۭ لَّ</>ا يَعْقِ<p>لُو</>نَ"},{"n":15,"w":[["كَمَثَلِ","kamathali","Like (the) example","দৃষ্ঠান্ত যেমন"],["ٱلَّذِينَ","alladhīna","(of) those","যারা"],["مِن","min","from","মধ্য হতে"],["قَبْلِهِمْ","qablihim","before them","তাদের পূর্বে ছিল"],["قَرِيبًۭا ۖ","qarīban","shortly","কিছুকাল"],["ذَاقُوا۟","dhāqū","they tasted","তারা স্বাদ নিয়েছে"],["وَبَالَ","wabāla","(the) evil result","কুফলের"],["أَمْرِهِمْ","amrihim","(of) their affair","তাদের কাজের"],["وَلَهُمْ","walahum","and for them","ও তাদের জন্যে"],["عَذَابٌ","‘adhābun","(is) a punishment","আজাব"],["أَلِيمٌۭ","alīmun","painful","কষ্টদায়ক"]],"t":"كَمَثَلِ <h>ٱ</>لَّذِينَ مِ<k>ن قَ</><q>بْ</>لِهِمْ قَرِي<k>بًۭا ۖ ذَ</>اقُو<s>ا۟</> وَبَالَ أَمْرِهِمْ وَلَهُمْ عَذَابٌ أَ<p>لِي</>مٌۭ"},{"n":16,"w":[["كَمَثَلِ","kamathali","Like (the) example","দৃষ্ঠান্ত যেমন"],["ٱلشَّيْطَـٰنِ","l-shayṭāni","(of) the Shaitaan","শয়তানের"],["إِذْ","idh","when","যখন"],["قَالَ","qāla","he says","সে বলেছিল"],["لِلْإِنسَـٰنِ","lil'insāni","to man","মানুুষকে"],["ٱكْفُرْ","uk'fur","Disbelieve","\"তুমি কুফরিকর\""],["فَلَمَّا","falammā","But when","যখন অতঃপর"],["كَفَرَ","kafara","he disbelieves","কুফুরি করল"],["قَالَ","qāla","he says","সে বলেল"],["إِنِّى","innī","Indeed, I am","\"আমি নিশ্চয়"],["بَرِىٓءٌۭ","barīon","disassociated","দ্বায়িত্বমুক্ত"],["مِّنكَ","minka","from you","তোমার হতে"],["إِنِّىٓ","innī","Indeed, [I]","আমি নিশ্চয়"],["أَخَافُ","akhāfu","I fear","ভয়করি"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["رَبَّ","rabba","(the) Lord","রব"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","(of) the worlds","সারা বিশ্বের\""]],"t":"كَمَثَلِ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نِ إِذْ قَالَ لِلْإِ<k>نسَٰ</>نِ <h>ٱ</>كْفُرْ فَلَ<g>مَّ</>ا كَفَرَ قَالَ إِ<g>نِّ</>ى بَ<o>رِىٓ</><d>ءٌۭ مِّ</><k>نكَ</> إِ<g>نِّ</><o>ىٓ</> أَخَافُ <h>ٱ</>للَّهَ رَبَّ <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":17,"w":[["فَكَانَ","fakāna","So will be","হল অতঃপর"],["عَـٰقِبَتَهُمَآ","‘āqibatahumā","(the) end of both of them","তাদের দুজনের পরিনতি"],["أَنَّهُمَا","annahumā","that they","দুজনই যে হবে"],["فِى","fī","(will be) in","মধ্যে"],["ٱلنَّارِ","l-nāri","the Fire","জাহান্নামের"],["خَـٰلِدَيْنِ","khālidayni","abiding forever","দুজনে চিরকাল থাকবে"],["فِيهَا ۚ","fīhā","therein","তার মধ্যে"],["وَذَٰلِكَ","wadhālika","And that","এবং এটা"],["جَزَٰٓؤُا۟","jazāu","(is the) recompense","প্রতিদান"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","(of) the wrongdoers","যালিমদের"]],"t":"فَكَانَ <m>عَٰ</>قِبَتَهُ<o>مَآ</> أَ<g>نَّ</>هُمَا فِى <h>ٱ</><l>ل</><g>نَّ</>ارِ <m>خَٰ</>لِدَيْنِ فِيهَا ۚ وَ<m>ذَٰ</>لِكَ جَ<o>زَٰٓ</>ؤُ<s>ا۟</> <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":18,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O","ওহে"],["ٱلَّذِينَ","alladhīna","you (who)","যারা"],["ءَامَنُوا۟","āmanū","believe","ইমান এনেছ"],["ٱتَّقُوا۟","ittaqū","Fear","তোমরা ভয়কর"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["وَلْتَنظُرْ","waltanẓur","and let look","এবং যেন লক্ষ্য করে"],["نَفْسٌۭ","nafsun","every soul","প্রত্যেক ব্যক্তি"],["مَّا","mā","what","যা"],["قَدَّمَتْ","qaddamat","it has sent forth","আগে পাঠিয়েছে"],["لِغَدٍۢ ۖ","lighadin","for tomorrow","আগামীকালে জন্যে"],["وَٱتَّقُوا۟","wa-ittaqū","and fear","ও তোমরা ভয়কর"],["ٱللَّهَ ۚ","l-laha","Allah","আল্লাহকে"],["إِنَّ","inna","Indeed","নিশ্চয়"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["خَبِيرٌۢ","khabīrun","(is) All-Aware","খুব অবহিত"],["بِمَا","bimā","of what","যা"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা কাজ কর"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> <h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</>للَّهَ وَلْتَ<k>نظُ</>رْ نَفْ<d>سٌۭ مَّ</>ا قَدَّمَتْ لِغَ<d>دٍۢ ۖ وَ</><h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</>للَّهَ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ خَبِي<i>رٌۢ بِ</>مَا تَعْمَ<p>لُو</>نَ"},{"n":19,"w":[["وَلَا","walā","And (do) not","এবং না"],["تَكُونُوا۟","takūnū","be","তোমরা হয়ো"],["كَٱلَّذِينَ","ka-alladhīna","like those who","(তাদের) মত যারা"],["نَسُوا۟","nasū","forgot","ভূলে গিয়েছিল"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["فَأَنسَىٰهُمْ","fa-ansāhum","so He made them forget","তাদের ভুলালেন অতঃপর তিনি"],["أَنفُسَهُمْ ۚ","anfusahum","themselves","তারা নিজেদেরকে"],["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব লোক"],["هُمُ","humu","[they]","তারাই"],["ٱلْفَـٰسِقُونَ","l-fāsiqūna","(are) the defiantly disobedient","ফাসেক"]],"t":"وَلَا تَكُونُو<s>ا۟</> كَ<h>ٱ</>لَّذِينَ نَسُو<s>ا۟</> <h>ٱ</>للَّهَ فَأَ<k>نسَ</><m>ىٰ</>هُمْ أَ<k>نفُ</>سَهُمْ ۚ أُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</>لْ<m>فَٰ</>سِ<p>قُو</>نَ"},{"n":20,"w":[["لَا","lā","Not","না"],["يَسْتَوِىٓ","yastawī","equal","সমান হয়"],["أَصْحَـٰبُ","aṣḥābu","(are the) companions","অধিবাসীরা"],["ٱلنَّارِ","l-nāri","(of) the Fire","দোজখের"],["وَأَصْحَـٰبُ","wa-aṣḥābu","and (the) companions","ও অধিবাসীরা"],["ٱلْجَنَّةِ ۚ","l-janati","(of) Paradise","জান্নাতের"],["أَصْحَـٰبُ","aṣḥābu","(The) companions","অধধিবাসীরা"],["ٱلْجَنَّةِ","l-janati","(of) Paradise","জান্নাতের"],["هُمُ","humu","they","তারাই"],["ٱلْفَآئِزُونَ","l-fāizūna","(are) the achievers","সফলকাম"]],"t":"لَا يَسْتَ<o>وِىٓ</> أَصْ<m>حَٰ</>بُ <h>ٱ</><l>ل</><g>نَّ</>ارِ وَأَصْ<m>حَٰ</>بُ <h>ٱ</>لْجَ<g>نَّ</>ةِ ۚ أَصْ<m>حَٰ</>بُ <h>ٱ</>لْجَ<g>نَّ</>ةِ هُمُ <h>ٱ</>لْ<o>فَآ</>ئِ<p>زُو</>نَ"},{"n":21,"w":[["لَوْ","law","If","যদি"],["أَنزَلْنَا","anzalnā","We (had) sent down","আমরা অবতীর্ণ করতাম"],["هَـٰذَا","hādhā","this","এই"],["ٱلْقُرْءَانَ","l-qur'āna","Quran","কুরআন"],["عَلَىٰ","‘alā","on","উপর"],["جَبَلٍۢ","jabalin","a mountain","একটি পর্বতের"],["لَّرَأَيْتَهُۥ","lara-aytahu","surely you (would) have seen it","নিশ্চয় আপনি তা দেখতেন"],["خَـٰشِعًۭا","khāshi‘an","humbled","বিনীত ,"],["مُّتَصَدِّعًۭا","mutaṣaddi‘an","breaking asunder","দুভাগে বিভক্ত ভঙ্গ"],["مِّنْ","min","from","থেকে"],["خَشْيَةِ","khashyati","(the) fear","ভয়"],["ٱللَّهِ ۚ","l-lahi","(of) Allah","আল্লাহর"],["وَتِلْكَ","watil'ka","And these","আর এই"],["ٱلْأَمْثَـٰلُ","l-amthālu","examples","উদাহরণ ( সম্পূর্ণ ) ,"],["نَضْرِبُهَا","naḍribuhā","We present them","আমরা তাদের উপস্থাপন করি"],["لِلنَّاسِ","lilnnāsi","to the people","মানুষের কাছে"],["لَعَلَّهُمْ","la‘allahum","so that they may","যেন তারা"],["يَتَفَكَّرُونَ","yatafakkarūna","give thought","চিন্তা-ভাবনা করে"]],"t":"لَوْ أَ<k>نزَ</>لْنَا <m>هَٰ</>ذَا <h>ٱ</>لْقُرْءَانَ عَلَىٰ جَبَ<w>لٍۢ لَّ</>رَأَيْتَهُ<m>ۥ خَٰ</>شِ<d>عًۭا مُّ</>تَصَدِّ<d>عًۭا مِّ</>نْ خَشْيَةِ <h>ٱ</>للَّهِ ۚ وَتِلْكَ <h>ٱ</>لْأَمْ<m>ثَٰ</>لُ نَضْرِبُهَا لِل<g>نَّ</>اسِ لَعَلَّهُمْ يَتَفَكَّ<p>رُو</>نَ"},{"n":22,"w":[["هُوَ","huwa","He","তিনিই"],["ٱللَّهُ","l-lahu","(is) Allah","আল্লাহ"],["ٱلَّذِى","alladhī","the One Who","যে"],["لَآ","lā","(there is) no","নাই"],["إِلَـٰهَ","ilāha","god","কোনো ইলাহ"],["إِلَّا","illā","but","ব্যতীত"],["هُوَ ۖ","huwa","He","তাঁর,"],["عَـٰلِمُ","‘ālimu","(the) All-Knower","জানেন"],["ٱلْغَيْبِ","l-ghaybi","(of) the unseen","গোপন"],["وَٱلشَّهَـٰدَةِ ۖ","wal-shahādati","and the witnessed","ও প্রকাশ্য"],["هُوَ","huwa","He","তিনি"],["ٱلرَّحْمَـٰنُ","l-raḥmānu","(is) the Most Gracious","পরম করুণাময়"],["ٱلرَّحِيمُ","l-raḥīmu","the Most Merciful","অসীম দয়ালু"]],"t":"هُوَ <h>ٱ</>للَّهُ <h>ٱ</>لَّذِى <o>لَآ</> إِ<m>لَٰ</>هَ إِلَّا هُوَ ۖ <m>عَٰ</>لِمُ <h>ٱ</>لْغَيْبِ وَ<h>ٱ</><l>ل</>شَّ<m>هَٰ</>دَةِ ۖ هُوَ <h>ٱ</><l>ل</>رَّحْ<m>مَٰ</>نُ <h>ٱ</><l>ل</>رَّ<p>حِي</>مُ"},{"n":23,"w":[["هُوَ","huwa","He","তিনিই"],["ٱللَّهُ","l-lahu","(is) Allah","আল্লাহ"],["ٱلَّذِى","alladhī","the One Who","যে"],["لَآ","lā","(there is) no","নাই"],["إِلَـٰهَ","ilāha","god","কোনো ইলাহ"],["إِلَّا","illā","but","ব্যতীত"],["هُوَ","huwa","He","তাঁর,"],["ٱلْمَلِكُ","l-maliku","the Sovereign","বাদশাহ,"],["ٱلْقُدُّوسُ","l-qudūsu","the Holy One","অতীব প্রবিত্র,"],["ٱلسَّلَـٰمُ","l-salāmu","the Giver of Peace","শান্তিদাতা,"],["ٱلْمُؤْمِنُ","l-mu'minu","the Giver of Security","নিরাপত্তাদাতা,"],["ٱلْمُهَيْمِنُ","l-muhayminu","the Guardian","সংরক্ষক,"],["ٱلْعَزِيزُ","l-‘azīzu","the All-Mighty","পরাক্রমশালী,"],["ٱلْجَبَّارُ","l-jabāru","the Irresistible","প্রবল,"],["ٱلْمُتَكَبِّرُ ۚ","l-mutakabiru","the Supreme","মহিমান্বিত,"],["سُبْحَـٰنَ","sub'ḥāna","Glory (be to)","পবিত্র"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ (র)"],["عَمَّا","‘ammā","from what","যা হতে"],["يُشْرِكُونَ","yush'rikūna","they associate (with Him)","তারা শরীক করে"]],"t":"هُوَ <h>ٱ</>للَّهُ <h>ٱ</>لَّذِى <o>لَآ</> إِ<m>لَٰ</>هَ إِلَّا هُوَ <h>ٱ</>لْمَلِكُ <h>ٱ</>لْقُدُّوسُ <h>ٱ</><l>ل</>سَّ<m>لَٰ</>مُ <h>ٱ</>لْمُؤْمِنُ <h>ٱ</>لْمُهَيْمِنُ <h>ٱ</>لْعَزِيزُ <h>ٱ</>لْجَبَّارُ <h>ٱ</>لْمُتَكَبِّرُ ۚ سُ<q>بْ</><m>حَٰ</>نَ <h>ٱ</>للَّهِ عَ<g>مَّ</>ا يُشْرِ<p>كُو</>نَ"},{"n":24,"w":[["هُوَ","huwa","He","তিনিই"],["ٱللَّهُ","l-lahu","(is) Allah","আল্লাহ"],["ٱلْخَـٰلِقُ","l-khāliqu","the Creator","সৃষ্টিকর্তা,"],["ٱلْبَارِئُ","l-bāri-u","the Inventor","উদ্ভাবনকর্তা,"],["ٱلْمُصَوِّرُ ۖ","l-muṣawiru","the Fashioner","আকৃতিদাতা,"],["لَهُ","lahu","For Him","তাঁর জন্যই"],["ٱلْأَسْمَآءُ","l-asmāu","(are) the names","নামসমুহ"],["ٱلْحُسْنَىٰ ۚ","l-ḥus'nā","the beautiful","উত্তম"],["يُسَبِّحُ","yusabbiḥu","Glorifies","গৌরব বর্ণনা করে"],["لَهُۥ","lahu","Him","তারই"],["مَا","mā","whatever","যা কিছু"],["فِى","fī","(is) in","আছে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আসমানে"],["وَٱلْأَرْضِ ۖ","wal-arḍi","and the earth","এবং পৃথিবীতে"],["وَهُوَ","wahuwa","And He","এবং তিনি"],["ٱلْعَزِيزُ","l-‘azīzu","(is) the All-Mighty","পরাক্রমশালী,"],["ٱلْحَكِيمُ","l-ḥakīmu","the All-Wise","মহাবিজ্ঞ"]],"t":"هُوَ <h>ٱ</>للَّهُ <h>ٱ</>لْ<m>خَٰ</>لِقُ <h>ٱ</>لْبَارِئُ <h>ٱ</>لْمُصَوِّرُ ۖ لَهُ <h>ٱ</>لْأَسْ<o>مَآ</>ءُ <h>ٱ</>لْحُسْنَىٰ ۚ يُسَبِّحُ لَهُ<m>ۥ</> مَا فِى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ ۖ وَهُوَ <h>ٱ</>لْعَزِيزُ <h>ٱ</>لْحَ<p>كِي</>مُ"}]}