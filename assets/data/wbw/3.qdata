r","কাছে"],["رَبِّكُمْ ۗ","rabbikum","your Lord","তোমাদের রবের''"],["قُلْ","qul","Say","তুমি বল"],["إِنَّ","inna","Indeed","''নিশ্চয়"],["ٱلْفَضْلَ","l-faḍla","the Bounty","সব অনুগ্রহ"],["بِيَدِ","biyadi","(is) in the Hand","হাতে"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহরই"],["يُؤْتِيهِ","yu'tīhi","He gives it","তিনি দেন"],["مَن","man","(to) whom","যাকে"],["يَشَآءُ ۗ","yashāu","He wills","তিনি ইচ্ছে করেন"],["وَٱللَّهُ","wal-lahu","and Allah","এবং আল্লাহ"],["وَٰسِعٌ","wāsi‘un","(is) All-Encompassing","প্রাচুর্যময়"],["عَلِيمٌۭ","‘alīmun","All-Knowing","সর্বজ্ঞ''"]],"t":"وَلَا تُؤْمِ<o>نُوٓ</><s>ا۟</> إِلَّا لِمَ<k>ن تَ</>بِعَ دِينَكُمْ قُلْ إِ<g>نَّ</> <h>ٱ</>لْهُدَىٰ هُدَى <h>ٱ</>للَّهِ <d>أَن يُ</>ؤْتَ<o>ىٰٓ</> أَحَ<d>دٌۭ مِّ</>ثْلَ <o>مَآ</> أُوتِيتُمْ أَوْ يُ<n>حَآ</>جُّوكُمْ عِ<k>ندَ</> رَبِّكُمْ ۗ قُلْ إِ<g>نَّ</> <h>ٱ</>لْفَضْلَ بِيَدِ <h>ٱ</>للَّهِ يُؤْتِيهِ <d>مَن يَ</><o>شَآ</>ءُ ۗ وَ<h>ٱ</>للَّهُ <m>وَٰ</>سِعٌ عَ<p>لِي</>مٌۭ"},{"n":74,"w":[["يَخْتَصُّ","yakhtaṣṣu","He chooses","তিনি বাছাই করেন"],["بِرَحْمَتِهِۦ","biraḥmatihi","for His Mercy","তাঁর রহমতের জন্যে"],["مَن","man","whom","যাকে"],["يَشَآءُ ۗ","yashāu","He wills","তিনি ইচ্ছে করেন"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["ذُو","dhū","(is) the Possessor","(একটি)"],["ٱلْفَضْلِ","l-faḍli","(of) Bounty ","অনুগ্রহশীল"],["ٱلْعَظِيمِ","l-‘aẓīmi","[the] great","মহান"]],"t":"يَخْتَصُّ بِرَحْمَتِ<m>هِۦ</> <d>مَن يَ</><o>شَآ</>ءُ ۗ وَ<h>ٱ</>للَّهُ ذُو <h>ٱ</>لْفَضْلِ <h>ٱ</>لْعَ<p>ظِي</>مِ"},{"n":75,"w":[["۞ وَمِنْ","wamin","And from","এবং মধ্য হতে"],["أَهْلِ","ahli","(the) People","আহলি"],["ٱلْكِتَـٰبِ","l-kitābi","(of) the Book","কিতাবদের (এমনও আছে)"],["مَنْ","man","(is he) who","যে"],["إِن","in","if","যদি"],["تَأْمَنْهُ","tamanhu","you entrust him","তাকে আমানত দাও"],["بِقِنطَارٍۢ","biqinṭārin","with a great amount of wealth","ধন সম্পদের স্তুপ"],["يُؤَدِّهِۦٓ","yu-addihi","he will return it","তা ফেরত দেবে"],["إِلَيْكَ","ilayka","to you","তোমার নিকট"],["وَمِنْهُم","wamin'hum","And from them"