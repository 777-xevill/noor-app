ا۟","āmanū","believe[d]","ঈমান এনেছ"],["إِن","in","If","যদি"],["تُطِيعُوا۟","tuṭī‘ū","you obey","তোমরা আনুগত্য কর"],["فَرِيقًۭا","farīqan","a group","(কোন এক) দলের ও"],["مِّنَ","mina","from","মধ্য হতে"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যাদের"],["أُوتُوا۟","ūtū","were given","দেয়া হয়েছে"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","কিতাব"],["يَرُدُّوكُم","yaruddūkum","they will turn you back","তোমাদেরকে ফিরাবে"],["بَعْدَ","ba‘da","after","পরে"],["إِيمَـٰنِكُمْ","īmānikum","your belief","তোমাদের ঈমানের"],["كَـٰفِرِينَ","kāfirīna","(as) disbelievers","কাফির হিসেবে"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَ<o>نُوٓ</><s>ا۟</> إِ<k>ن تُ</>طِيعُو<s>ا۟</> فَرِي<d>قًۭا مِّ</>نَ <h>ٱ</>لَّذِينَ أُوتُو<s>ا۟</> <h>ٱ</>لْكِ<m>تَٰ</>بَ يَرُدُّو<f>كُم بَ</>عْدَ إِي<m>مَٰ</>نِكُمْ <m>كَٰ</>فِ<p>رِي</>نَ"},{"n":101,"w":[["وَكَيْفَ","wakayfa","And how (could)","এবং কিরূপে"],["تَكْفُرُونَ","takfurūna","you disbelieve","তোমরা অস্বীকার করলে"],["وَأَنتُمْ","wa-antum","while [you]","অথচ তোমরা (এমন যে)"],["تُتْلَىٰ","tut'lā","is recited","পাঠ করা হয়"],["عَلَيْكُمْ","‘alaykum","upon you","তোমাদের নিকট"],["ءَايَـٰتُ","āyātu","(the) Verses","আয়াত সমূহকে"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহ্‌র"],["وَفِيكُمْ","wafīkum","and among you","এবং তোমাদের মধ্যে (আছেন)"],["رَسُولُهُۥ ۗ","rasūluhu","(is) His Messenger","তাঁর রাসূল"],["وَمَن","waman","And whoever","এবং যে কেউ"],["يَعْتَصِم","ya‘taṣim","holds firmly","দৃঢ়ভাবে ধারণ করবে"],["بِٱللَّهِ","bil-lahi","to Allah","আল্লাহর (রজ্জুকে)"],["فَقَدْ","faqad","then surely","তাহলে নিশ্চয়"],["هُدِىَ","hudiya","he is guided","সে পরিচালিত হবে"],["إِلَىٰ","ilā","to","দিকে"],["صِرَٰطٍۢ","ṣirāṭin","a path","পথের"],["مُّسْتَقِيمٍۢ","mus'taqīmin","straight","সরল সঠিক"]],"t":"وَكَيْفَ تَكْفُرُونَ وَأَ<k>نتُ</>مْ تُتْلَىٰ عَلَيْكُمْ ءَا<m>يَٰ</>تُ <h>ٱ</>للَّهِ وَفِيكُمْ رَسُولُهُ<m>ۥ</> ۗ وَ<d>مَن يَ</>عْتَ<f>صِم بِ</><h>ٱ</>للَّهِ فَقَ<q>دْ</> هُدِىَ إِلَىٰ صِ<m>رَٰ</><d>طٍۢ مُّ</>سْتَ<p>قِي</>مٍۢ"},{"n":102,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you","ওহে"],["ٱلَّذِينَ","alladhīna","who","যারা"],["ءَامَنُوا۟","āmanū","believe[d]","ঈমান এনেছে"],["ٱتَّقُوا۟","ittaqū","Fear","তোমরা ভয় কর"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["حَقَّ","ḥaqqa","(as is His) right","যথোপযুক্ত"],["تُقَاتِهِۦ","tuqātihi","(that) He (should) be feared","তাঁর ভয়"],["وَلَا","walā","and (do) not","এবং না"],["تَمُوتُنَّ","tamūtunna","die","তোমরা মৃত্যু বরণ করো"],["إِلَّا","illā","except","এছাড়া"],["وَأَنتُم","wa-antum","[while you]","যখন তোমরা"],["مُّسْلِمُونَ","mus'limūna","(as) Muslims","মুসলমান"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> <h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</>للَّهَ حَقَّ تُقَاتِ<m>هِۦ</> وَلَا تَمُوتُ<g>نَّ</> إِلَّا وَأَ<k>نتُ</><y>م مُّ</>سْلِ<p>مُو</>نَ"},{"n":103,"w":[["وَٱعْتَصِمُوا۟","wa-i‘'taṣimū","And hold firmly","এবং তোমরা শক্ত ভাবে ধর"],["بِحَبْلِ","biḥabli","to (the) rope","রজ্জুকে"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["جَمِيعًۭا","jamī‘an","all together","সবাই একত্রে"],["وَلَا","walā","and (do) not","আর না"],["تَفَرَّقُوا۟ ۚ","tafarraqū","be divided","তোমরা বিচ্ছিন্ন হয়ো"],["وَٱذْكُرُوا۟","wa-udh'kurū","And remember","এবং তোমরা স্মরণ কর"],["نِعْمَتَ","ni‘'mata","(the) Favor","নিয়ামাতের"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["عَلَيْكُمْ","‘alaykum","on you","তোমাদের উপর"],["إِذْ","idh","when","যখন"],["كُنتُمْ","kuntum","you were","তোমরা ছিলে"],["أَعْدَآءًۭ","a‘dāan","enemies","(পরস্পর) শত্রু"],["فَأَلَّفَ","fa-allafa","then He made friendship","তখন মিলিয়ে দিলেন"],["بَيْنَ","bayna","between","মাঝে"],["قُلُوبِكُمْ","qulūbikum","your hearts","তোমাদের অন্তরের"],["فَأَصْبَحْتُم","fa-aṣbaḥtum","then you became","তোমরা তাই হয়ে গেলে"],["بِنِعْمَتِهِۦٓ","bini‘'matihi","by His Favor","তাঁর অনুগ্রহে"],["إِخْوَٰنًۭا","ikh'wānan","brothers","ভাই ভাই"],["وَكُنتُمْ","wakuntum","And you were","এবং তোমরা ছিলে"],["عَلَىٰ","‘alā","on","উপর"],["شَفَا","shafā","(the) brink","কিনারার"],["حُفْرَةٍۢ","ḥuf'ratin","(of) pit","গর্তের"],["مِّنَ","mina","of","(থেকে)"],["ٱلنَّارِ","l-nāri","the Fire","আগুনের"],["فَأَنقَذَكُم","fa-anqadhakum","then He saved you","তোমাদের অতঃপর উদ্ধার করলেন"],["مِّنْهَا ۗ","min'hā","from it","তা হতে"],["كَذَٰلِكَ","kadhālika","Thus","এভাবে"],["يُبَيِّنُ","yubayyinu","makes clear","বর্ণনা করেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["لَكُمْ","lakum","for you","তোমাদের জন্য"],["ءَايَـٰتِهِۦ","āyātihi","His Verses","তাঁর আয়াত সমূহকে"],["لَعَلَّكُمْ","la‘allakum","so that you may","তোমরা যাতে"],["تَهْتَدُونَ","tahtadūna","(be) guided","সঠিক পথ পাও"]],"t":"وَ<h>ٱ</>عْتَصِمُو<s>ا۟</> بِحَ<q>بْ</>لِ <h>ٱ</>للَّهِ جَمِي<d>عًۭا وَ</>لَا تَفَرَّقُو<s>ا۟ ۚ</> وَ<h>ٱ</>ذْكُرُو<s>ا۟</> نِعْمَتَ <h>ٱ</>للَّهِ عَلَيْكُمْ إِذْ كُ<k>نتُ</>مْ أَعْ<o>دَآ</><k>ءًۭ فَ</>أَلَّفَ بَيْنَ قُلُوبِكُمْ فَأَصْبَحْ<f>تُم بِ</>نِعْمَتِ<o>هِۦٓ</> إِخْ<m>وَٰ</><d>نًۭا وَ</>كُ<k>نتُ</>مْ عَلَىٰ شَفَا حُفْرَ<d>ةٍۢ مِّ</>نَ <h>ٱ</><l>ل</><g>نَّ</>ارِ فَأَ<k>نقَ</>ذَ<y>كُم مِّ</>نْهَا ۗ كَ<m>ذَٰ</>لِكَ يُبَيِّنُ <h>ٱ</>للَّهُ لَكُمْ ءَا<m>يَٰتِهِۦ</> لَعَلَّكُمْ تَهْتَ<p>دُو</>نَ"},{"n":104,"w":[["وَلْتَكُن","waltakun","And let there be","এবং অবশ্যই থাকবে"],["مِّنكُمْ","minkum","among you","তোমাদের মধ্যে"],["أُمَّةٌۭ","ummatun","[a] people","(এমন) একদল"],["يَدْعُونَ","yad‘ūna","inviting","(যারা) ডাকবে"],["إِلَى","ilā","to","দিকে"],["ٱلْخَيْرِ","l-khayri","the good","কল্যাণের"],["وَيَأْمُرُونَ","wayamurūna","[and] enjoining","ও তারা নির্দেশ দিবে"],["بِٱلْمَعْرُوفِ","bil-ma‘rūfi","the right","ভাল (কাজের)"],["وَيَنْهَوْنَ","wayanhawna","and forbidding","এবং তারা নিষেধ করবে"],["عَنِ","‘ani","from","হতে"],["ٱلْمُنكَرِ ۚ","l-munkari","the wrong","মন্দ (কাজ)"],["وَأُو۟لَـٰٓئِكَ","wa-ulāika","and those ","এবং ঐসব লোক"],["هُمُ","humu","they","তারাই"],["ٱلْمُفْلِحُونَ","l-muf'liḥūna","(are) the successful ones","সফলকাম"]],"t":"وَلْتَ<d>كُن مِّ</><k>نكُ</>مْ أُ<g>مَّ</><d>ةٌۭ يَ</><q>دْ</>عُونَ إِلَى <h>ٱ</>لْخَيْرِ وَيَأْمُرُونَ بِ<h>ٱ</>لْمَعْرُوفِ وَيَنْهَوْنَ عَنِ <h>ٱ</>لْمُ<k>نكَ</>رِ ۚ وَأُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</>لْمُفْلِ<p>حُو</>نَ"},{"n":105,"w":[["وَلَا","walā","And (do) not","এবং না"],["تَكُونُوا۟","takūnū","be","তোমরা হয়ো"],["كَٱلَّذِينَ","ka-alladhīna","like those who","(তাদের) মত যারা"],["تَفَرَّقُوا۟","tafarraqū","became divided","বিচ্ছিন্ন হয়েছিল"],["وَٱخْتَلَفُوا۟","wa-ikh'talafū","and differed","এবং মতভেদ করেছিল"],["مِنۢ","min","from","(থেকে)"],["بَعْدِ","ba‘di","after","এর পরেও"],["مَا","mā","what","যা"],["جَآءَهُمُ","jāahumu","came to them ","এসেছিল তাদের (কাছে)"],["ٱلْبَيِّنَـٰتُ ۚ","l-bayinātu","the clear proofs","স্পষ্ট নিদর্শনসমূহ"],["وَأُو۟لَـٰٓئِكَ","wa-ulāika","And those","এবং ঐসব লোক"],["لَهُمْ","lahum","for them","তাদের জন্য (রয়েছে)"],["عَذَابٌ","‘adhābun","(is) a punishment","আযাব"],["عَظِيمٌۭ","‘aẓīmun","great","কঠিন"]],"t":"وَلَا تَكُونُو<s>ا۟</> كَ<h>ٱ</>لَّذِينَ تَفَرَّقُو<s>ا۟</> وَ<h>ٱ</>خْتَلَفُو<s>ا۟</> <i>مِنۢ بَ</>عْدِ مَا <o>جَآ</>ءَهُمُ <h>ٱ</>لْبَيِّ<m>نَٰ</>تُ ۚ وَأُ<s>و۟</><o>لَٰٓ</>ئِكَ لَهُمْ عَذَابٌ عَ<p>ظِي</>مٌۭ"},{"n":106,"w":[["يَوْمَ","yawma","(On the) Day","সে দিন"],["تَبْيَضُّ","tabyaḍḍu","would become white","উজ্জ্বল হবে"],["وُجُوهٌۭ","wujūhun","(some) faces","(অনেক) চেহারা"],["وَتَسْوَدُّ","wataswaddu","and would become black","ও মলিন হবে"],["وُجُوهٌۭ ۚ","wujūhun","(some) faces","(অনেক) চেহারা"],["فَأَمَّا","fa-ammā","As for","অতঃপর"],["ٱلَّذِينَ","alladhīna","those whose","যাদের"],["ٱسْوَدَّتْ","is'waddat","turn black","মলিন হবে"],["وُجُوهُهُمْ","wujūhuhum","[their] faces ","তাদের চেহারা"],["أَكَفَرْتُم","akafartum","Did you disbelieve","''(তাদের বলা হবে) তোমরা কুফরী করেছ কি"],["بَعْدَ","ba‘da","after","পরেও"],["إِيمَـٰنِكُمْ","īmānikum","your belief","তোমাদের ঈমানের"],["فَذُوقُوا۟","fadhūqū","Then taste","তোমরা তাই স্বাদ গ্রহণ কর"],["ٱلْعَذَابَ","l-‘adhāba","the punishment","আযাবের"],["بِمَا","bimā","for what","একারণে যা"],["كُنتُمْ","kuntum","you used to","করতেছিলে"],["تَكْفُرُونَ","takfurūna","disbelieve","তোমরা কুফরী''"]],"t":"يَوْمَ تَ<q>بْ</>يَضُّ وُجُو<d>هٌۭ وَ</>تَسْوَدُّ وُجُو<k>هٌۭ ۚ فَ</>أَ<g>مَّ</>ا <h>ٱ</>لَّذِينَ <h>ٱ</>سْوَدَّتْ وُجُوهُهُمْ أَكَفَرْ<f>تُم بَ</>عْدَ إِي<m>مَٰ</>نِكُمْ فَذُوقُو<s>ا۟</> <h>ٱ</>لْعَذَابَ بِمَا كُ<k>نتُ</>مْ تَكْفُ<p>رُو</>نَ"},{"n":107,"w":[["وَأَمَّا","wa-ammā","But as for","আর"],["ٱلَّذِينَ","alladhīna","those whose","যাদের"],["ٱبْيَضَّتْ","ib'yaḍḍat","turn white","উজ্জ্বল হবে"],["وُجُوهُهُمْ","wujūhuhum","[their] faces","তাদের চেহারা"],["فَفِى","fafī","then (they will be) in","অতঃপর মধ্যে"],["رَحْمَةِ","raḥmati","(the) Mercy","রহমতে"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর (আশ্রয় পাবে)"],["هُمْ","hum","they","তারা"],["فِيهَا","fīhā","in it","তার মধ্যে"],["خَـٰلِدُونَ","khālidūna","(will) abide forever","চিরস্থায়ী হবে"]],"t":"وَأَ<g>مَّ</>ا <h>ٱ</>لَّذِينَ <h>ٱ</><q>بْ</>يَضَّتْ وُجُوهُهُمْ فَفِى رَحْمَةِ <h>ٱ</>للَّهِ هُمْ فِيهَا <m>خَٰ</>لِ<p>دُو</>نَ"},{"n":108,"w":[["تِلْكَ","til'ka","These","এগুলো"],["ءَايَـٰتُ","āyātu","(are the) Verses","আয়াত"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["نَتْلُوهَا","natlūhā","We recite them","তা পড়ছি আমরা"],["عَلَيْكَ","‘alayka","to you","তোমার নিকট"],["بِٱلْحَقِّ ۗ","bil-ḥaqi","in truth","যথাযথভাবে"],["وَمَا","wamā","And not","এবং না"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["يُرِيدُ","yurīdu","wants","চান"],["ظُلْمًۭا","ẓul'man","injustice","যুলুম করতে"],["لِّلْعَـٰلَمِينَ","lil'‘ālamīna","to the worlds","দুনিয়াবাসীর উপর"]],"t":"تِلْكَ ءَا<m>يَٰ</>تُ <h>ٱ</>للَّهِ نَتْلُوهَا عَلَيْكَ بِ<h>ٱ</>لْحَقِّ ۗ وَمَا <h>ٱ</>للَّهُ يُرِيدُ ظُلْ<w>مًۭا لِّ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":109,"w":[["وَلِلَّهِ","walillahi","And to Allah (belongs)","এবং আল্লাহর জন্যে"],["مَا","mā","whatever","যা কিছু"],["فِى","fī","(is) in","মধ্যে আছে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আসমানসমূহের"],["وَمَا","wamā","and whatever","ও যা কিছু"],["فِى","fī","(is) in","মধ্যে আছে"],["ٱلْأَرْضِ ۚ","l-arḍi","the earth","যমীনের"],["وَإِلَى","wa-ilā","And to","এবং দিকে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহরই"],["تُرْجَعُ","tur'ja‘u","will be returned","ফিরানো হয়"],["ٱلْأُمُورُ","l-umūru","the matters","সকল বিষয়"]],"t":"وَلِلَّهِ مَا فِى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَمَا فِى <h>ٱ</>لْأَرْضِ ۚ وَإِلَى <h>ٱ</>للَّهِ تُرْجَعُ <h>ٱ</>لْأُ<p>مُو</>رُ"},{"n":110,"w":[["كُنتُمْ","kuntum","You are","তোমরা হলে"],["خَيْرَ","khayra","(the) best","উত্তম"],["أُمَّةٍ","ummatin","(of) people","জাতি"],["أُخْرِجَتْ","ukh'rijat","raised","(তোমাদেরকে) বের করা হয়েছে"],["لِلنَّاسِ","lilnnāsi","for the mankind ","মানুষের (কল্যাণের) জন্যে"],["تَأْمُرُونَ","tamurūna","enjoining","তোমরা নির্দেশ দাও"],["بِٱلْمَعْرُوفِ","bil-ma‘rūfi","the right","সৎকাজের"],["وَتَنْهَوْنَ","watanhawna","and forbidding","ও তোমরা নিষেধ কর"],["عَنِ","‘ani","[from]","হতে"],["ٱلْمُنكَرِ","l-munkari","the wrong","অসৎকাজ"],["وَتُؤْمِنُونَ","watu'minūna","and believing","এবং তোমরা ঈমান রাখ"],["بِٱللَّهِ ۗ","bil-lahi","in Allah","আল্লাহর উপর"],["وَلَوْ","walaw","And if","এবং যদি"],["ءَامَنَ","āmana","believed","ঈমান আনত"],["أَهْلُ","ahlu","(the) People","আহলি"],["ٱلْكِتَـٰبِ","l-kitābi","(of) the Book","কিতাবরা"],["لَكَانَ","lakāna","surely would have been","অবশ্যই হত"],["خَيْرًۭا","khayran","good","উত্তম"],["لَّهُم ۚ","lahum","for them","তাদের জন্যে"],["مِّنْهُمُ","min'humu","Among them","তাদের মধ্যে কিছু"],["ٱلْمُؤْمِنُونَ","l-mu'minūna","(are) [the] believers","ঈমানদার (আছে)"],["وَأَكْثَرُهُمُ","wa-aktharuhumu","but most of them","কিন্তু অধিকাংশই তাদের"],["ٱلْفَـٰسِقُونَ","l-fāsiqūna","(are) defiantly disobedient","নাফরমান"]],"t":"كُ<k>نتُ</>مْ خَيْرَ أُ<g>مَّ</>ةٍ أُخْرِجَتْ لِل<g>نَّ</>اسِ تَأْمُرُونَ بِ<h>ٱ</>لْمَعْرُوفِ وَتَنْهَوْنَ عَنِ <h>ٱ</>لْمُ<k>نكَ</>رِ وَتُؤْمِنُونَ بِ<h>ٱ</>للَّهِ ۗ وَلَوْ ءَامَنَ أَهْلُ <h>ٱ</>لْكِ<m>تَٰ</>بِ لَكَانَ خَيْ<w>رًۭا لَّ</><y>هُم ۚ مِّ</>نْهُمُ <h>ٱ</>لْمُؤْمِنُونَ وَأَكْثَرُهُمُ <h>ٱ</>لْ<m>فَٰ</>سِ<p>قُو</>نَ"},{"n":111,"w":[["لَن","lan","Never","কক্ষণ না"],["يَضُرُّوكُمْ","yaḍurrūkum","will they harm you","তোমাদেরকে ক্ষতি করতে পারবে"],["إِلَّآ","illā","except","এছাড়া"],["أَذًۭى ۖ","adhan","a hurt","কষ্ট দেওয়া"],["وَإِن","wa-in","And if","আর যদি"],["يُقَـٰتِلُوكُمْ","yuqātilūkum","they fight you","তোমাদের সাথে লড়ে তারা"],["يُوَلُّوكُمُ","yuwallūkumu","they will turn (towards) you","তোমাদের দিকে ফিরাবে"],["ٱلْأَدْبَارَ","l-adbāra","the backs","পিঠসমূহ"],["ثُمَّ","thumma","then","এরপর"],["لَا","lā","not","না"],["يُنصَرُونَ","yunṣarūna","they will be helped","তাদের সাহায্যও করা হবে"]],"t":"<d>لَن يَ</>ضُرُّوكُمْ إِ<o>لَّآ</> أَ<d>ذًۭى ۖ وَإِن يُ</><m>قَٰ</>تِلُوكُمْ يُوَلُّوكُمُ <h>ٱ</>لْأَ<q>دْ</>بَارَ ثُ<g>مَّ</> لَا يُ<k>نصَ</><p>رُو</>نَ"},{"n":112,"w":[["ضُرِبَتْ","ḍuribat","Struck","মার পড়েছে"],["عَلَيْهِمُ","‘alayhimu","on them","তাদের উপর"],["ٱلذِّلَّةُ","l-dhilatu","the humiliation","লাঞ্ছনা ও অপমানের"],["أَيْنَ","ayna","wherever","যেখানেই"],["مَا","mā","that","(কি)"],["ثُقِفُوٓا۟","thuqifū","they are found","তাদের পাওয়া গিয়েছে"],["إِلَّا","illā","except","তবে এছাড়া"],["بِحَبْلٍۢ","biḥablin","with a rope","আশ্রয়ে"],["مِّنَ","mina","from","পক্ষ হতে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["وَحَبْلٍۢ","waḥablin","and a rope","অথবা আশ্রয়ে"],["مِّنَ","mina","from","পক্ষ হতে"],["ٱلنَّاسِ","l-nāsi","the people","মানুষের"],["وَبَآءُو","wabāū","And they incurred","ও তারা ঘেরা পড়েছে"],["بِغَضَبٍۢ","bighaḍabin","wrath","গযব দ্বারা"],["مِّنَ","mina","from","পক্ষ হতে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["وَضُرِبَتْ","waḍuribat","and struck","ও মার পড়েছে"],["عَلَيْهِمُ","‘alayhimu","on them","তাদের উপর"],["ٱلْمَسْكَنَةُ ۚ","l-maskanatu","the poverty","দারিদ্রের"],["ذَٰلِكَ","dhālika","That","এটা"],["بِأَنَّهُمْ","bi-annahum","(is) because","এই জন্যে যে"],["كَانُوا۟","kānū","they used to","তারা"],["يَكْفُرُونَ","yakfurūna","disbelieve","অস্বীকার করেছিল"],["بِـَٔايَـٰتِ","biāyāti","in (the) Verses","আয়াতগুলোকে"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَيَقْتُلُونَ","wayaqtulūna","and they killed","ও তারা কতল করেছে"],["ٱلْأَنۢبِيَآءَ","l-anbiyāa","the Prophets","নবীদেরকে"],["بِغَيْرِ","bighayri","without","অন্যায়ভাবে"],["حَقٍّۢ ۚ","ḥaqqin","right","(অধিকার)"],["ذَٰلِكَ","dhālika","That","এটা"],["بِمَا","bimā","(is) because","এ জন্যে যে"],["عَصَوا۟","‘aṣaw","they disobeyed","তারা অবাধ্যতা করেছিল"],["وَّكَانُوا۟","wakānū","and they used to","এবং করত"],["يَعْتَدُونَ","ya‘tadūna","transgress","তারা সীমালংঘন"]],"t":"ضُرِبَتْ عَلَيْهِمُ <h>ٱ</><l>ل</>ذِّلَّةُ أَيْنَ مَا ثُقِ<o>فُوٓ</><s>ا۟</> إِلَّا بِحَ<q>بْ</><d>لٍۢ مِّ</>نَ <h>ٱ</>للَّهِ وَحَ<q>بْ</><d>لٍۢ مِّ</>نَ <h>ٱ</><l>ل</><g>نَّ</>اسِ وَ<o>بَآ</>ءُو بِغَضَ<d>بٍۢ مِّ</>نَ <h>ٱ</>للَّهِ وَضُرِبَتْ عَلَيْهِمُ <h>ٱ</>لْمَسْكَنَةُ ۚ <m>ذَٰ</>لِكَ بِأَ<g>نَّ</>هُمْ كَانُو<s>ا۟</> يَكْفُرُونَ بِـَٔا<m>يَٰ</>تِ <h>ٱ</>للَّهِ وَيَ<q>قْ</>تُلُونَ <h>ٱ</>لْأَ<i>نۢبِ</><o>يَآ</>ءَ بِغَيْرِ حَ<k>قٍّۢ ۚ ذَٰ</>لِكَ بِمَا عَصَو<s>ا۟</> وَّكَانُو<s>ا۟</> يَعْتَ<p>دُو</>نَ"},{"n":113,"w":[["۞ لَيْسُوا۟","laysū","They are not","তারা নয়"],["سَوَآءًۭ ۗ","sawāan","(the) same","(সব) সমান"],["مِّنْ","min","among","মধ্য হতে"],["أَهْلِ","ahli","(the) People","আহলে"],["ٱلْكِتَـٰبِ","l-kitābi","(of) the Book","কিতাবদের"],["أُمَّةٌۭ","ummatun","(is) a community","(তাদের) একদল"],["قَآئِمَةٌۭ","qāimatun","standing","(সত্যের উপর) দাঁড়িয়ে আছে"],["يَتْلُونَ","yatlūna","(and) reciting","তারা পাঠ করে"],["ءَايَـٰتِ","āyāti","(the) Verses","আয়াত সমূহকে"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["ءَانَآءَ","ānāa","(in the) hours","সময়"],["ٱلَّيْلِ","al-layli","(of) the night","রাতের"],["وَهُمْ","wahum","and they","ও তারা"],["يَسْجُدُونَ","yasjudūna","prostrate","সিজদা অবনত হয়"]],"t":"۞ لَيْسُو<s>ا۟</> سَ<o>وَآ</><d>ءًۭ ۗ مِّ</>نْ أَهْلِ <h>ٱ</>لْكِ<m>تَٰ</>بِ أُ<g>مَّ</><k>ةٌۭ قَ</><o>آ</>ئِمَ<d>ةٌۭ يَ</>تْلُونَ ءَا<m>يَٰ</>تِ <h>ٱ</>للَّهِ ءَا<o>نَآ</>ءَ <h>ٱ</>لَّيْلِ وَهُمْ يَسْجُ<p>دُو</>نَ"},{"n":114,"w":[["يُؤْمِنُونَ","yu'minūna","They believe","তারা ঈমান আনে"],["بِٱللَّهِ","bil-lahi","in Allah","আল্লাহর উপর"],["وَٱلْيَوْمِ","wal-yawmi","and the Day","ও দিনে"],["ٱلْـَٔاخِرِ","l-ākhiri","the Last","আখেরাতের"],["وَيَأْمُرُونَ","wayamurūna","and they enjoin","এবং তারা নির্দেশ দেয়"],["بِٱلْمَعْرُوفِ","bil-ma‘rūfi","[with] the right","সৎকাজের"],["وَيَنْهَوْنَ","wayanhawna","and forbid","ও তারা নিষেধ করে"],["عَنِ","‘ani","[from]","হতে"],["ٱلْمُنكَرِ","l-munkari","the wrong","অসৎ কাজ"],["وَيُسَـٰرِعُونَ","wayusāri‘ūna","and they hasten","ও তারা তৎপর হয়"],["فِى","fī","in","ক্ষেত্রে"],["ٱلْخَيْرَٰتِ","l-khayrāti","the good deeds","কল্যাণকর কাজগুলোর ক্ষেত্রে"],["وَأُو۟لَـٰٓئِكَ","wa-ulāika","And those","এবং তারাই"],["مِنَ","mina","(are) from","অন্তর্ভুক্ত"],["ٱلصَّـٰلِحِينَ","l-ṣāliḥīna","the righteous","সৎলোকদের"]],"t":"يُؤْمِنُونَ بِ<h>ٱ</>للَّهِ وَ<h>ٱ</>لْيَوْمِ <h>ٱ</>لْءَاخِرِ وَيَأْمُرُونَ بِ<h>ٱ</>لْمَعْرُوفِ وَيَنْهَوْنَ عَنِ <h>ٱ</>لْمُ<k>نكَ</>رِ وَيُ<m>سَٰ</>رِعُونَ فِى <h>ٱ</>لْخَيْ<m>رَٰ</>تِ وَأُ<s>و۟</><o>لَٰٓ</>ئِكَ مِنَ <h>ٱ</><l>ل</><m>صَّٰ</>لِ<p>حِي</>نَ"},{"n":115,"w":[["وَمَا","wamā","And whatever","এবং যা কিছু"],["يَفْعَلُوا۟","yaf‘alū","they do","তারা করবে"],["مِنْ","min","of","কোন"],["خَيْرٍۢ","khayrin","a good","কল্যাণ"],["فَلَن","falan","then never","কক্ষণ না"],["يُكْفَرُوهُ ۗ","yuk'farūhu","will they be denied it","তা অস্বীকার করা হবে"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["عَلِيمٌۢ","‘alīmun","(is) All-Knowing","অধিক অবহিত"],["بِٱلْمُتَّقِينَ","bil-mutaqīna","of the God-fearing","মুত্তাকীদের সম্পর্কে"]],"t":"وَمَا يَفْعَلُو<s>ا۟</> مِنْ خَيْ<k>رٍۢ فَ</><d>لَن يُ</>كْفَرُوهُ ۗ وَ<h>ٱ</>للَّهُ عَلِي<i>مٌۢ بِ</><h>ٱ</>لْمُتَّ<p>قِي</>نَ"},{"n":116,"w":[["إِنَّ","inna","Indeed","নিশ্চয়"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieved","কুফরী করেছে"],["لَن","lan","never","কক্ষণ না"],["تُغْنِىَ","tugh'niya","will avail","উপকারে আসবে"],["عَنْهُمْ","‘anhum","[for] them","তাদের জন্যে"],["أَمْوَٰلُهُمْ","amwāluhum","their wealth","তাদের ধনসম্পদ"],["وَلَآ","walā","and not","আর না"],["أَوْلَـٰدُهُم","awlāduhum","their children","সন্তান সন্ততি তাদের"],["مِّنَ","mina","against","হতে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["شَيْـًۭٔا ۖ","shayan","anything","কিছু মাত্রই"],["وَأُو۟لَـٰٓئِكَ","wa-ulāika","and those","এবং ঐসব লোক"],["أَصْحَـٰبُ","aṣḥābu","(are the) companions","অধিবাসী"],["ٱلنَّارِ ۚ","l-nāri","(of) the Fire","জাহান্নামের আগুনের"],["هُمْ","hum","they","তারা"],["فِيهَا","fīhā","in it","তার মধ্যে"],["خَـٰلِدُونَ","khālidūna","(will) abide forever","চিরস্থায়ী হবে"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> لَ<k>ن تُ</>غْنِىَ عَنْهُمْ أَمْ<m>وَٰ</>لُهُمْ وَ<o>لَآ</> أَوْ<m>لَٰ</>دُ<y>هُم مِّ</>نَ <h>ٱ</>للَّهِ شَ<d>يْـًۭٔا ۖ وَ</>أُ<s>و۟</><o>لَٰٓ</>ئِكَ أَصْ<m>حَٰ</>بُ <h>ٱ</><l>ل</><g>نَّ</>ارِ ۚ هُمْ فِيهَا <m>خَٰ</>لِ<p>دُو</>نَ"},{"n":117,"w":[["مَثَلُ","mathalu","Example","উদাহরণ"],["مَا","mā","(of) what","যা"],["يُنفِقُونَ","yunfiqūna","they spend","তারা খরচ করে"],["فِى","fī","in","মধ্যে"],["هَـٰذِهِ","hādhihi","this","এই"],["ٱلْحَيَوٰةِ","l-ḥayati","[the] life","জীবনে"],["ٱلدُّنْيَا","l-dun'yā","(of) the world","দুনিয়ার"],["كَمَثَلِ","kamathali","(is) like (the) example","উদাহরণ যেমন"],["رِيحٍۢ","rīḥin","(of) a wind","বায়ু"],["فِيهَا","fīhā","in it","তার মধ্যে আছে"],["صِرٌّ","ṣirrun","(is) frost","ভীষণ ঠান্ডা"],["أَصَابَتْ","aṣābat","it struck","তা পড়ে"],["حَرْثَ","ḥartha","(the) harvest","ক্ষেতে"],["قَوْمٍۢ","qawmin","(of) a people","লোকদের"],["ظَلَمُوٓا۟","ẓalamū","who wronged","জুলুম করেছে (যারা)"],["أَنفُسَهُمْ","anfusahum","themselves","তাদের নিজেদের (উপর)"],["فَأَهْلَكَتْهُ ۚ","fa-ahlakathu","then destroyed it","অতঃপর তা বরবাদ করে দেয়"],["وَمَا","wamā","And not","এবং না"],["ظَلَمَهُمُ","ẓalamahumu","(has) wronged them","তাদের উপর জুলুম করেছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["وَلَـٰكِنْ","walākin","[and] but","কিন্তু"],["أَنفُسَهُمْ","anfusahum","themselves","তারা নিজেরা (নিজেদের উপর)"],["يَظْلِمُونَ","yaẓlimūna","they wronged","জুলুম করেছিল"]],"t":"مَثَلُ مَا يُ<k>نفِ</>قُونَ فِى <m>هَٰ</>ذِهِ <h>ٱ</>لْحَيَ<s>وٰ</>ةِ <h>ٱ</><l>ل</>دُّنْيَا كَمَثَلِ رِي<k>حٍۢ فِ</>يهَا صِرٌّ أَصَابَتْ حَرْثَ قَوْ<k>مٍۢ ظَ</>لَ<o>مُوٓ</><s>ا۟</> أَ<k>نفُ</>سَهُمْ فَأَهْلَكَتْهُ ۚ وَمَا ظَلَمَهُمُ <h>ٱ</>للَّهُ وَ<m>لَٰ</>كِنْ أَ<k>نفُ</>سَهُمْ يَظْلِ<p>مُو</>نَ"},{"n":118,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you","ওহে"],["ٱلَّذِينَ","alladhīna","who","যারা"],["ءَامَنُوا۟","āmanū","believe[d]","ঈমান এনেছ"],["لَا","lā","(Do) not","না"],["تَتَّخِذُوا۟","tattakhidhū","take","তোমরা গ্রহণ করো"],["بِطَانَةًۭ","biṭānatan","(as) intimates","অন্তরঙ্গ বন্ধু (হিসেবে)"],["مِّن","min","from","(থেকে)"],["دُونِكُمْ","dūnikum","other than yourselves","তোমাদের ছাড়া (অমুসলমানদেরকে)"],["لَا","lā","not","না"],["يَأْلُونَكُمْ","yalūnakum","they will spare you","তারা তোমাদের সুযোগ ছাড়ে"],["خَبَالًۭا","khabālan","(any) ruin","অনিষ্ট সাধনে"],["وَدُّوا۟","waddū","They wish","তারা কামনা করে"],["مَا","mā","what","(তাই) যাতে"],["عَنِتُّمْ","‘anittum","distresses you","তোমরা অসুবিধায় পড়"],["قَدْ","qad","Indeed","নিশ্চয়"],["بَدَتِ","badati","(has become) apparent","প্রকাশ পেয়েছে"],["ٱلْبَغْضَآءُ","l-baghḍāu","the hatred","বিদ্বেষ"],["مِنْ","min","from","হতে"],["أَفْوَٰهِهِمْ","afwāhihim","their mouths","তাদের মুখগুলো"],["وَمَا","wamā","and what","এবং যা"],["تُخْفِى","tukh'fī","conceals","গোপন করে"],["صُدُورُهُمْ","ṣudūruhum","their breasts","অন্তরগুলো তাদের"],["أَكْبَرُ ۚ","akbaru","(is) greater","(তা আরও) গুরুতর"],["قَدْ","qad","Certainly","নিশ্চয়"],["بَيَّنَّا","bayyannā","We made clear","আমরা বর্ণনা করেছি"],["لَكُمُ","lakumu","for you","তোমাদের জন্যে"],["ٱلْـَٔايَـٰتِ ۖ","l-āyāti","the Verses","নিদর্শনগুলোকে"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you were","তোমরা"],["تَعْقِلُونَ","ta‘qilūna","(to use) reason","অনুধাবন কর"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> لَا تَتَّخِذُو<s>ا۟</> بِطَانَ<d>ةًۭ مِّ</><k>ن دُ</>ونِكُمْ لَا يَأْلُونَكُمْ خَبَالًۭ<d>ا وَ</>دُّو<s>ا۟</> مَا عَنِتُّمْ قَ<q>دْ</> بَدَتِ <h>ٱ</>لْبَغْ<o>ضَآ</>ءُ مِنْ أَفْ<m>وَٰ</>هِهِمْ وَمَا تُخْفِى صُدُورُهُمْ أَكْبَرُ ۚ قَ<q>دْ</> بَيَّ<g>نَّ</>ا لَكُمُ <h>ٱ</>لْءَا<m>يَٰ</>تِ ۖ إِ<k>ن كُنتُ</>مْ تَعْقِ<p>لُو</>نَ"},{"n":119,"w":[["هَـٰٓأَنتُمْ","hāantum","Lo! You are","তোমরাই তো"],["أُو۟لَآءِ","ulāi","those","ঐসব লোক"],["تُحِبُّونَهُمْ","tuḥibbūnahum","you love them","তাদেরকে ভালবাস"],["وَلَا","walā","but not","অথচ না"],["يُحِبُّونَكُمْ","yuḥibbūnakum","they love you","তোমাদেরকে তারা ভালবাসে"],["وَتُؤْمِنُونَ","watu'minūna","and you believe","এবং তোমরা বিশ্বাস কর"],["بِٱلْكِتَـٰبِ","bil-kitābi","in the Book ","কিতাবের উপর"],["كُلِّهِۦ","kullihi","all of it","সবগুলোর"],["وَإِذَا","wa-idhā","And when","এবং যখন"],["لَقُوكُمْ","laqūkum","they meet you","তারা তোমাদের সাথে সাক্ষাৎ করে"],["قَالُوٓا۟","qālū","they say","তারা বলে"],["ءَامَنَّا","āmannā","We believe","''আমরাও ঈমান এনেছি''"],["وَإِذَا","wa-idhā","And when","আর যখন"],["خَلَوْا۟","khalaw","they are alone","তারা একান্তে মিলে"],["عَضُّوا۟","‘aḍḍū","they bite","তারা কামড়ায়"],["عَلَيْكُمُ","‘alaykumu","at you","তোমাদের বিরুদ্ধে"],["ٱلْأَنَامِلَ","l-anāmila","the finger tips","(তাদের) আঙ্গুলগুলোকে"],["مِنَ","mina","(out) of","কারণে"],["ٱلْغَيْظِ ۚ","l-ghayẓi","[the] rage","আক্রোশের"],["قُلْ","qul","Say","বলো"],["مُوتُوا۟","mūtū","Die","তোমরা মরো"],["بِغَيْظِكُمْ ۗ","bighayẓikum","in your rage","তোমাদের আক্রোশে"],["إِنَّ","inna","Indeed","নিশ্চয়"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["عَلِيمٌۢ","‘alīmun","(is) All-Knowing","অধিক অবহিত"],["بِذَاتِ","bidhāti","of what","অবস্থা সম্পর্কে"],["ٱلصُّدُورِ","l-ṣudūri","(is in) the breasts","(তোমাদের) বুকের (অর্থাৎ অন্তরের)''"]],"t":"<o>هَٰٓ</>أَ<k>نتُ</>مْ أُ<s>و۟</><o>لَآ</>ءِ تُحِبُّونَهُمْ وَلَا يُحِبُّونَكُمْ وَتُؤْمِنُونَ بِ<h>ٱ</>لْكِ<m>تَٰ</>بِ كُلِّ<m>هِۦ</> وَإِذَا لَقُوكُمْ قَا<o>لُوٓ</><s>ا۟</> ءَامَ<g>نَّ</>ا وَإِذَا خَلَوْ<s>ا۟</> عَضُّو<s>ا۟</> عَلَيْكُمُ <h>ٱ</>لْأَنَامِلَ مِنَ <h>ٱ</>لْغَيْظِ ۚ قُلْ مُوتُو<s>ا۟</> بِغَيْظِكُمْ ۗ إِ<g>نَّ</> <h>ٱ</>للَّهَ عَلِي<i>مٌۢ بِ</>ذَاتِ <h>ٱ</><l>ل</>صُّ<p>دُو</>رِ"},{"n":120,"w":[["إِن","in","If","যদি"],["تَمْسَسْكُمْ","tamsaskum","touches you","তোমাদেরকে স্পর্শ করে"],["حَسَنَةٌۭ","ḥasanatun","a good","কোন কল্যাণ"],["تَسُؤْهُمْ","tasu'hum","it grieves them","খারাপ লাগে তাদের"],["وَإِن","wa-in","and if","আর যদি"],["تُصِبْكُمْ","tuṣib'kum","strikes you","তোমাদের পৌঁছে"],["سَيِّئَةٌۭ","sayyi-atun","misfortune","কোন অকল্যাণ"],["يَفْرَحُوا۟","yafraḥū","they rejoice","তারা আনন্দ করে"],["بِهَا ۖ","bihā","at it","তাতে"],["وَإِن","wa-in","And if","এবং যদি"],["تَصْبِرُوا۟","taṣbirū","you are patient","তোমরা সবর কর"],["وَتَتَّقُوا۟","watattaqū","and fear (Allah)","ও তোমরা তাকওয়া অবলম্বন কর"],["لَا","lā","not","না"],["يَضُرُّكُمْ","yaḍurrukum","will harm you","তোমাদের ক্ষতি করতে পারবে"],["كَيْدُهُمْ","kayduhum","their plot","তাদের চক্রান্ত"],["شَيْـًٔا ۗ","shayan","(in) anything","কিছুমাত্রই"],["إِنَّ","inna","Indeed","নিশ্চয়"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["بِمَا","bimā","of what","ঐ বিষয়ে যা"],["يَعْمَلُونَ","ya‘malūna","they do","তারা কাজ করছে"],["مُحِيطٌۭ","muḥīṭun","(is) All-Encompassing","বেষ্টন করে আছেন"]],"t":"إِ<k>ن تَ</>مْسَسْكُمْ حَسَنَ<k>ةٌۭ تَ</>سُؤْهُمْ وَإِ<k>ن تُ</>صِ<q>بْ</>كُمْ سَيِّئَ<d>ةٌۭ يَ</>فْرَحُو<s>ا۟</> بِهَا ۖ وَإِ<k>ن تَ</>صْبِرُو<s>ا۟</> وَتَتَّقُو<s>ا۟</> لَا يَضُرُّكُمْ كَيْدُهُمْ شَيْـًٔا ۗ إِ<g>نَّ</> <h>ٱ</>للَّهَ بِمَا يَعْمَلُونَ مُ<p>حِي</><q>طٌۭ</>"},{"n":121,"w":[["وَإِذْ","wa-idh","And when","এবং (স্মরণ কর) যখন"],["غَدَوْتَ","ghadawta","you left early morning","তুমি সকালে বের হয়েছিলে"],["مِنْ","min","from","হতে"],["أَهْلِكَ","ahlika","your household","তোমার পরিবার"],["تُبَوِّئُ","tubawwi-u","to post","মোতায়েন করছিলে"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believers","ঈমানদারদেরকে"],["مَقَـٰعِدَ","maqā‘ida","(to take) positions","ঘাঁটিসমূহে"],["لِلْقِتَالِ ۗ","lil'qitāli","for the battle","লড়াইয়ের জন্য"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["سَمِيعٌ","samī‘un","(is) All-Hearing","সবকিছু শুনেন"],["عَلِيمٌ","‘alīmun","All-Knowing","সব কিছু জানেন"]],"t":"وَإِذْ غَدَوْتَ مِنْ أَهْلِكَ تُبَوِّئُ <h>ٱ</>لْمُؤْمِنِينَ مَ<m>قَٰ</>عِدَ لِلْقِتَالِ ۗ وَ<h>ٱ</>للَّهُ سَمِيعٌ عَ<p>لِي</>مٌ"},{"n":122,"w":[["إِذْ","idh","When","(স্মরণ কর) যখন"],["هَمَّت","hammat","inclined","মনস্থ করেছিলে"],["طَّآئِفَتَانِ","ṭāifatāni","two parties","দুইদল"],["مِنكُمْ","minkum","among you","তোমাদের মধ্যকার"],["أَن","an","that","(যে)"],["تَفْشَلَا","tafshalā","they lost heart","দুর্বলতা প্রদর্শনের"],[