died","তারা মরতো"],["وَمَا","wamā","and not","আর না"],["قُتِلُوا۟","qutilū","they (would have) been killed","তারা নিহত হত''"],["لِيَجْعَلَ","liyaj‘ala","So makes","(এরূপ হয়েছে) করেন যেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["ذَٰلِكَ","dhālika","that","এরূপ (কথাবার্তা)"],["حَسْرَةًۭ","ḥasratan","a regret","মনস্তাপের (কারণ)"],["فِى","fī","in","মধ্যে"],["قُلُوبِهِمْ ۗ","qulūbihim","their hearts","তাদের অন্তরগুলোর"],["وَٱللَّهُ","wal-lahu","And Allah","আর আল্লাহই"],["يُحْىِۦ","yuḥ'yī","gives life","জীবন দেন"],["وَيُمِيتُ ۗ","wayumītu","and causes death","ও মৃত্যু দেন"],["وَٱللَّهُ","wal-lahu","and Allah","এবং আল্লাহ"],["بِمَا","bimā","of what","ঐ বিষয়ে যা"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা কাজ করছ"],["بَصِيرٌۭ","baṣīrun","(is) All-Seer","ভালোভাবে দেখছেন"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> لَا تَكُونُو<s>ا۟</> كَ<h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> وَقَالُو<s>ا۟</> لِإِخْ<m>وَٰ</>نِهِمْ إِذَا ضَرَبُو<s>ا۟</> فِى <h>ٱ</>لْأَرْضِ أَوْ كَانُو<s>ا۟</> غُ<w>زًّۭى لَّ</>وْ كَانُو<s>ا۟</> عِ<k>ندَ</>نَا مَا مَاتُو<s>ا۟</> وَمَا قُتِلُو<s>ا۟</> لِيَ<q>جْ</>عَلَ <h>ٱ</>للَّهُ <m>ذَٰ</>لِكَ حَسْرَ<k>ةًۭ فِ</>ى قُلُوبِهِمْ ۗ وَ<h>ٱ</>للَّهُ يُحْ<m>ىِۦ</> وَيُمِيتُ ۗ وَ<h>ٱ</>للَّهُ بِمَا تَعْمَلُونَ بَ<p>صِي</>رٌۭ"},{"n":157,"w":[["وَلَئِن","wala-in","And if","এবং অবশ্যই যদি"],["قُتِلْتُمْ","qutil'tum","you are killed","তোমরা নিহত হও"],["فِى","fī","in","(মধ্যে)"],["سَبِيلِ","sabīli","(the) way","পথে"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["أَوْ","aw","or","অথবা"],["مُتُّمْ","muttum","die[d] ","তোমরা মরে যাও"],["لَمَغْفِرَةٌۭ","lamaghfiratun","certainly forgiveness","ক্ষমা অবশ্যই"],["مِّنَ","mina","from","পক্ষ হতে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["وَرَحْمَةٌ","waraḥmatun","and Mercy","ও রহমাত"],["خَيْرٌۭ","khayrun","(are) better","উত্তম"],["مِّمَّا","mimmā","than what","তা হতে যা"],["يَجْمَعُونَ","yajma‘ūna","they accumulate","তোমরা জমা করেছ"]],"t":"وَلَئِ<k>ن قُ</>تِلْتُمْ فِى سَبِيلِ <h>ٱ</>للَّهِ أَوْ مُتُّمْ لَمَغْفِرَ<d>ةٌۭ مِّ</>نَ <h>ٱ</>للَّهِ وَرَحْمَةٌ خَيْ<d>رٌۭ مِّ</><g>مَّ</>ا يَ<q>جْ</>مَ<p>عُو</>نَ"},{"n":158,"w":[["وَلَئِن","wala-in","And if","এবং অবশ্যই যদি"],["مُّتُّمْ","muttum","you die","তোমরা মারা যাও"],["أَوْ","aw","or","অথবা"],["قُتِلْتُمْ","qutil'tum","are killed","তোমরা নিহত হও"],["لَإِلَى","la-ilā","surely to","দিকে অবশ্যই"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["تُحْشَرُونَ","tuḥ'sharūna","you will be gathered","তোমাদের একত্রিত করা হবে"]],"t":"وَلَ<d>ئِن مُّ</>تُّمْ أَوْ قُتِلْتُمْ لَإِلَى <h>ٱ</>للَّهِ تُحْشَ<p>رُو</>نَ"},{"n":159,"w":[["فَبِمَا","fabimā","So because","বস্তুত কারণে"],["رَحْمَةٍۢ","raḥmatin","(of) Mercy","অনুগ্রহের"],["مِّنَ","mina","from","পক্ষ হতে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["لِنتَ","linta","you dealt gently","তুমি নরম হয়েছ"],["لَهُمْ ۖ","lahum","with them","তাদের জন্য"],["وَلَوْ","walaw","And if","এবং যদি"],["كُنتَ","kunta","you had been","তুমি হতে"],["فَظًّا","faẓẓan","rude","উগ্র স্বভাব"],["غَلِيظَ","ghalīẓa","(and) harsh","পাষাণ"],["ٱلْقَلْبِ","l-qalbi","(at) [the] heart","হৃদয়ের"],["لَٱنفَضُّوا۟","la-infaḍḍū","surely they (would have) dispersed","তারা অবশ্যই সরে যেত"],["مِنْ","min","from","হতে"],["حَوْلِكَ ۖ","ḥawlika","around you","তোমার চতুর্দিক"],["فَٱعْفُ","fa-u‘'fu","Then pardon","অতএব মাফকর"],["عَنْهُمْ","‘anhum","[from] them","তাদেরকে"],["وَٱسْتَغْفِرْ","wa-is'taghfir","and ask forgiveness","ও ক্ষমা চাও"],["لَهُمْ","lahum","for them","তাদের জন্য"],["وَشَاوِرْهُمْ","washāwir'hum","and consult them","এবং পরামর্শ কর তাদের (সাথে)"],["فِى","fī","in","ক্ষেত্রে"],["ٱلْأَمْرِ ۖ","l-amri","the matter","কাজের"],["فَإِذَا","fa-idhā","Then when","অতঃপর যখন"],["عَزَمْتَ","‘azamta","you have decided","তুমি সংকল্প কর"],["فَتَوَكَّلْ","fatawakkal","then put trust","তখন ভরসা কর"],["عَلَى","‘alā","on","উপর"],["ٱللَّهِ ۚ","l-lahi","Allah","আল্লাহর"],["إِنَّ","inna","Indeed","নিশ্চয়"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["يُحِبُّ","yuḥibbu","loves","ভালোবাসেন"],["ٱلْمُتَوَكِّلِينَ","l-mutawakilīna","the ones who put trust (in Him)","ভরসাকারীদেরকে"]],"t":"فَبِمَا رَحْمَ<d>ةٍۢ مِّ</>نَ <h>ٱ</>للَّهِ لِ<k>نتَ</> لَهُمْ ۖ وَلَوْ كُ<k>نتَ</> فَظًّا غَلِيظَ <h>ٱ</>لْقَلْبِ لَ<h>ٱ</><k>نفَ</>ضُّو<s>ا۟</> مِنْ حَوْلِكَ ۖ فَ<h>ٱ</>عْفُ عَنْهُمْ وَ<h>ٱ</>سْتَغْفِرْ لَهُمْ وَشَاوِرْهُمْ فِى <h>ٱ</>لْأَمْرِ ۖ فَإِذَا عَزَمْتَ فَتَوَكَّلْ عَلَى <h>ٱ</>للَّهِ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ يُحِبُّ <h>ٱ</>لْمُتَوَكِّ<p>لِي</>نَ"},{"n":160,"w":[["إِن","in","If","যদি"],["يَنصُرْكُمُ","yanṣur'kumu","helps you","তোমাদের সাহায্য করেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["فَلَا","falā","then not","না তবে"],["غَالِبَ","ghāliba","(can) overcome","বিজয়ী হবে কেউ"],["لَكُمْ ۖ","lakum","[for] you","তোমাদের উপর"],["وَإِن","wa-in","and if","আর যদি"],["يَخْذُلْكُمْ","yakhdhul'kum","He forsakes you","তোমাদের তিনি ত্যাগ করেন"],["فَمَن","faman","then who","কে তবে"],["ذَا","dhā","(is)","এমন"],["ٱلَّذِى","alladhī","the one who","(আছে) যে"],["يَنصُرُكُم","yanṣurukum","can help you","তোমাদের সাাহায্য করতে পারে"],["مِّنۢ","min","from","(থেকে)"],["بَعْدِهِۦ ۗ","ba‘dihi","after Him","তারপরে"],["وَعَلَى","wa‘alā","And on","এবং উপর"],["ٱللَّهِ","l-lahi","Allah ","আল্লাহ্‌রই"],["فَلْيَتَوَكَّلِ","falyatawakkali","let put (their) trust","ভরসা করা উচিত"],["ٱلْمُؤْمِنُونَ","l-mu'minūna","the believers","ঈমানদারদের"]],"t":"<d>إِن يَ</><k>نصُ</>رْكُمُ <h>ٱ</>للَّهُ فَلَا غَالِبَ لَكُمْ ۖ وَ<d>إِن يَ</>خْذُلْكُمْ فَمَ<k>ن ذَ</>ا <h>ٱ</>لَّذِى يَ<k>نصُ</>رُ<y>كُم مِّ</><i>نۢ بَ</>عْدِ<m>هِۦ</> ۗ وَعَلَى <h>ٱ</>للَّهِ فَلْيَتَوَكَّلِ <h>ٱ</>لْمُؤْمِ<p>نُو</>نَ"},{"n":161,"w":[["وَمَا","wamā","And not","এবং না"],["كَانَ","kāna","is","(শোভনীয়) হতে পারে"],["لِنَبِىٍّ","linabiyyin","for a Prophet","নবীর জন্য"],["أَن","an","that","যে"],["يَغُلَّ ۚ","yaghulla","he defrauds","সে খিয়ানত করবে"],["وَمَن","waman","And whoever","এবং যে"],["يَغْلُلْ","yaghlul","defrauds","খিয়ানত করবে"],["يَأْتِ","yati","will bring","সে আসবে"],["بِمَا","bimā","what","তা নিয়ে যা"],["غَلَّ","ghalla","he had defrauded","খিয়ানত করেছিল"],["يَوْمَ","yawma","(on the) Day","দিনে"],["ٱلْقِيَـٰمَةِ ۚ","l-qiyāmati","(of) Resurrection","কিয়ামাতের"],["ثُمَّ","thumma","Then","অতঃপর"],["تُوَفَّىٰ","tuwaffā","is repaid in full","দেয়া হবে পুরাপুরি"],["كُلُّ","kullu","every","প্রত্যেক"],["نَفْسٍۢ","nafsin","soul","ব্যক্তিকে"],["مَّا","mā","what","যা"],["كَسَبَتْ","kasabat","it earned","সে অর্জন করেছে"],["وَهُمْ","wahum","and they","এবং তাদের উপর"],["لَا","lā","(will) not","না"],["يُظْلَمُونَ","yuẓ'lamūna","be wronged","জুলুম করা হবে"]],"t":"وَمَا كَانَ لِنَبِىٍّ <d>أَن يَ</>غُلَّ ۚ وَ<d>مَن يَ</>غْلُلْ يَأْتِ بِمَا غَلَّ يَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ ۚ ثُ<g>مَّ</> تُوَفَّىٰ كُلُّ نَفْ<d>سٍۢ مَّ</>ا كَسَبَتْ وَهُمْ لَا يُظْلَ<p>مُو</>نَ"},{"n":162,"w":[["أَفَمَنِ","afamani","So is (the one) who","তবে কি যে"],["ٱتَّبَعَ","ittaba‘a","pursues","অনুসরণ করল"],["رِضْوَٰنَ","riḍ'wāna","(the) pleasure","সন্তুষ্টির"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["كَمَنۢ","kaman","like (the one) who","তার মত যে"],["بَآءَ","bāa","draws","পরিবেষ্টিত হয়েছে"],["بِسَخَطٍۢ","bisakhaṭin","on (himself) wrath","অসন্তুষ্টি দ্বারা"],["مِّنَ","mina","of","পক্ষ হতে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["وَمَأْوَىٰهُ","wamawāhu","and his abode","এবং তার ঠিকানা"],["جَهَنَّمُ ۚ","jahannamu","(is) hell","জাহান্নাম"],["وَبِئْسَ","wabi'sa","and wretched","এবং (তা) অতি খারাপ"],["ٱلْمَصِيرُ","l-maṣīru","(is) the destination","গন্তব্যস্থান"]],"t":"أَفَمَنِ <h>ٱ</>تَّبَعَ رِضْ<m>وَٰ</>نَ <h>ٱ</>للَّهِ كَ<i>مَنۢ بَ</><o>آ</>ءَ بِسَخَ<d>طٍۢ مِّ</>نَ <h>ٱ</>للَّهِ وَمَأْوَ<m>ىٰ</>هُ جَهَ<g>نَّ</>مُ ۚ وَبِئْسَ <h>ٱ</>لْمَ<p>صِي</>رُ"},{"n":163,"w":[["هُمْ","hum","They","তারা"],["دَرَجَـٰتٌ","darajātun","(are in varying) degrees","মর্যাদার (এক নয়)"],["عِندَ","‘inda","near","কাছে"],["ٱللَّهِ ۗ","l-lahi","Allah","আল্লাহ"],["وَٱللَّهُ","wal-lahu","and Allah","এবং আল্লাহ"],["بَصِيرٌۢ","baṣīrun","(is) All-Seer","খুব দেখেন"],["بِمَا","bimā","of what","ঐ বিষয়ে যা"],["يَعْمَلُونَ","ya‘malūna","they do","তারা কাজ করছে"]],"t":"هُمْ دَرَ<m>جَٰ</>تٌ عِ<k>ندَ</> <h>ٱ</>للَّهِ ۗ وَ<h>ٱ</>للَّهُ بَصِي<i>رٌۢ بِ</>مَا يَعْمَ<p>لُو</>نَ"},{"n":164,"w":[["لَقَدْ","laqad","Certainly","নিশ্চয়"],["مَنَّ","manna","bestowed a Favor","অনুগ্রহ করেছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["عَلَى","‘alā","upon","উপর"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believers","মু'মিনদের"],["إِذْ","idh","as","যখন"],["بَعَثَ","ba‘atha","He raised","প্রেরণ করেন"],["فِيهِمْ","fīhim","among them","তাদের মধ্যে"],["رَسُولًۭا","rasūlan","a Messenger","একজন রাসূল"],["مِّنْ","min","from","মধ্য হতে"],["أَنفُسِهِمْ","anfusihim","themselves","তাদের নিজেদের"],["يَتْلُوا۟","yatlū","reciting","সে পাঠ করে"],["عَلَيْهِمْ","‘alayhim","to them","তাদের কাছে"],["ءَايَـٰتِهِۦ","āyātihi","His Verses","তাঁর নিদর্শনগুলো"],["وَيُزَكِّيهِمْ","wayuzakkīhim","and purifying them","ও পরিশুদ্ধ করে তাদেরকে"],["وَيُعَلِّمُهُمُ","wayu‘allimuhumu","and teaching them","এবং শিক্ষা দেয় তাদেরকে"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","কিতাব"],["وَٱلْحِكْمَةَ","wal-ḥik'mata","and the wisdom","ও প্রজ্ঞা"],["وَإِن","wa-in","although","এবং যদিও"],["كَانُوا۟","kānū","they were","তারা ছিল"],["مِن","min","from","(থেকে)"],["قَبْلُ","qablu","before (that)","ইতিপূর্বে"],["لَفِى","lafī","certainly in","অবশ্যই মধ্যে"],["ضَلَـٰلٍۢ","ḍalālin","(the) error","বিভ্রান্তির"],["مُّبِينٍ","mubīnin","clear","সুস্পষ্ট"]],"t":"لَقَ<q>دْ</> مَ<g>نَّ</> <h>ٱ</>للَّهُ عَلَى <h>ٱ</>لْمُؤْمِنِينَ إِذْ بَعَثَ فِيهِمْ رَسُولًۭ<d>ا مِّ</>نْ أَ<k>نفُ</>سِهِمْ يَتْلُو<s>ا۟</> عَلَيْهِمْ ءَا<m>يَٰتِهِۦ</> وَيُزَكِّيهِمْ وَيُعَلِّمُهُمُ <h>ٱ</>لْكِ<m>تَٰ</>بَ وَ<h>ٱ</>لْحِكْمَةَ وَإِ<k>ن كَ</>انُو<s>ا۟</> مِ<k>ن قَ</><q>بْ</>لُ لَفِى ضَ<m>لَٰ</><d>لٍۢ مُّ</><p>بِي</>نٍ"},{"n":165,"w":[["أَوَلَمَّآ","awalammā","Or when","না কি যখন"],["أَصَـٰبَتْكُم","aṣābatkum","struck you","তোমাদের কাছে পৌঁছে"],["مُّصِيبَةٌۭ","muṣībatun","disaster","কোন মুসিবত"],["قَدْ","qad","surely","(অথচ) নিশ্চয়"],["أَصَبْتُم","aṣabtum","you (had) struck (them)","তোমরা পৌঁছেছো (তাদের মুসিবতে)"],["مِّثْلَيْهَا","mith'layhā","twice of it","তার দ্বিগুণ"],["قُلْتُمْ","qul'tum","you said","তোমরা বলেছিলে"],["أَنَّىٰ","annā","From where","কোথা থেকে"],["هَـٰذَا ۖ","hādhā","(is) this","''এটা (আসল)"],["قُلْ","qul","Say","তুমি বল''"],["هُوَ","huwa","It","তা (এসেছে)"],["مِنْ","min","(is)","''থেকে"],["عِندِ","‘indi","from","কাছ"],["أَنفُسِكُمْ ۗ","anfusikum","yourselves","তোমাদের নিজেদের''"],["إِنَّ","inna","Indeed","নিশ্চয়"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["عَلَىٰ","‘alā","(is) on","উপর"],["كُلِّ","kulli","every","সব"],["شَىْءٍۢ","shayin","thing","কিছুর"],["قَدِيرٌۭ","qadīrun","All-Powerful","ক্ষমতাবান"]],"t":"أَوَلَ<g>مَّ</><o>آ</> أَ<m>صَٰ</>بَتْ<y>كُم مُّ</>صِيبَ<k>ةٌۭ قَ</><q>دْ</> أَصَ<q>بْ</><y>تُم مِّ</>ثْلَيْهَا قُلْتُمْ أَ<g>نَّ</>ىٰ <m>هَٰ</>ذَا ۖ قُلْ هُوَ مِنْ عِ<k>ندِ</> أَ<k>نفُ</>سِكُمْ ۗ إِ<g>نَّ</> <h>ٱ</>للَّهَ عَلَىٰ كُلِّ <k>شَىْءٍۢ قَ</><p>دِي</>رٌۭ"},{"n":166,"w":[["وَمَآ","wamā","And what","এবং যা (মুসিবত)"],["أَصَـٰبَكُمْ","aṣābakum","struck you","পৌঁছেছে তোমাদের"],["يَوْمَ","yawma","(on the) day","দিনে"],["ٱلْتَقَى","l-taqā","(when) met","মুকাবিলার"],["ٱلْجَمْعَانِ","l-jam‘āni","the two hosts","দুই দলের"],["فَبِإِذْنِ","fabi-idh'ni","(was) by (the) permission","তা (এসেছে) অনুমতিক্রমে"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَلِيَعْلَمَ","waliya‘lama","and that He (might) make evident","এবং তিনি যেন জানেন"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believers","মু'মিনদেরকে"]],"t":"وَ<o>مَآ</> أَ<m>صَٰ</>بَكُمْ يَوْمَ <h>ٱ</><l>لْ</>تَقَى <h>ٱ</>لْجَمْعَانِ فَبِإِذْنِ <h>ٱ</>للَّهِ وَلِيَعْلَمَ <h>ٱ</>لْمُؤْمِ<p>نِي</>نَ"},{"n":167,"w":[["وَلِيَعْلَمَ","waliya‘lama","And that He (might) make evident","ও জানেন যেন"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["نَافَقُوا۟ ۚ","nāfaqū","(are) hypocrites","মুনাফিকি করেছে"],["وَقِيلَ","waqīla","And it was said","এবং বলা হল"],["لَهُمْ","lahum","to them","তাদেরকে"],["تَعَالَوْا۟","ta‘ālaw","Come","''তোমরা এস"],["قَـٰتِلُوا۟","qātilū","fight","তোমরা যুদ্ধ কর"],["فِى","fī","in","(মধ্যে)"],["سَبِيلِ","sabīli","(the) way","পথে"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["أَوِ","awi","or","বা"],["ٱدْفَعُوا۟ ۖ","id'fa‘ū","defend","তোমরা প্রতিরক্ষা কর''"],["قَالُوا۟","qālū","They said","তারা বলেছিল"],["لَوْ","law","If","''যদি"],["نَعْلَمُ","na‘lamu","we knew","আমরা জানতাম"],["قِتَالًۭا","qitālan","fighting","যুদ্ধ (হবে)"],["لَّٱتَّبَعْنَـٰكُمْ ۗ","la-ittaba‘nākum","certainly we (would have) followed you","অবশ্যই তোমাদের আমরা অনুসরণ করতাম''"],["هُمْ","hum","They ","তারা"],["لِلْكُفْرِ","lil'kuf'ri","to disbelief","কুফরীর ক্ষেত্রে"],["يَوْمَئِذٍ","yawma-idhin","that day","সেদিন (ছিল)"],["أَقْرَبُ","aqrabu","(were) nearer","বেশী নিকটে"],["مِنْهُمْ","min'hum","than [them]","তাদের মধ্যে"],["لِلْإِيمَـٰنِ ۚ","lil'īmāni","to the faith","ঈমানের চেয়ে"],["يَقُولُونَ","yaqūlūna","saying","তারা বলে (এমন কথা)"],["بِأَفْوَٰهِهِم","bi-afwāhihim","with their mouths","তাদের মুখগুলো দিয়ে"],["مَّا","mā","what","যা"],["لَيْسَ","laysa","was not","নাই"],["فِى","fī","in","মধ্যে"],["قُلُوبِهِمْ ۗ","qulūbihim","their hearts","তাদের অন্তরে"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["أَعْلَمُ","a‘lamu","(is) Most Knowing","খুব জানেন"],["بِمَا","bimā","of what","ঐ বিষয়ে যা"],["يَكْتُمُونَ","yaktumūna","they conceal","তারা গোপন করেছে"]],"t":"وَلِيَعْلَمَ <h>ٱ</>لَّذِينَ نَافَقُو<s>ا۟ ۚ</> وَقِيلَ لَهُمْ تَعَالَوْ<s>ا۟</> <m>قَٰ</>تِلُو<s>ا۟</> فِى سَبِيلِ <h>ٱ</>للَّهِ أَوِ <h>ٱ</><q>دْ</>فَعُو<s>ا۟ ۖ</> قَالُو<s>ا۟</> لَوْ نَعْلَمُ قِتَالًۭ<w>ا لَّ</><h>ٱ</>تَّبَعْ<m>نَٰ</>كُمْ ۗ هُمْ لِلْكُفْرِ يَوْمَئِذٍ أَ<q>قْ</>رَبُ مِنْهُمْ لِلْإِي<m>مَٰ</>نِ ۚ يَقُولُونَ بِأَفْ<m>وَٰ</>هِ<y>هِم مَّ</>ا لَيْسَ فِى قُلُوبِهِمْ ۗ وَ<h>ٱ</>للَّهُ أَعْلَمُ بِمَا يَكْتُ<p>مُو</>نَ"},{"n":168,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["قَالُوا۟","qālū","said","বলেছিল"],["لِإِخْوَٰنِهِمْ","li-ikh'wānihim","about their brothers","তাদের ভাইদের সম্পর্কে"],["وَقَعَدُوا۟","waqa‘adū","while they sat","ও তারা বসে ছিল (ঘরে)"],["لَوْ","law","If","''যদি"],["أَطَاعُونَا","aṭā‘ūnā","they (had) obeyed us","আমাদের আনুগত্য করত"],["مَا","mā","not","না"],["قُتِلُوا۟ ۗ","qutilū","they would have been killed","তারা নিহত হতো''"],["قُلْ","qul","Say","বল"],["فَٱدْرَءُوا۟","fa-id'raū","Then avert","''তোমরা তাহলে দূরে সরাও"],["عَنْ","‘an","from","হতে"],["أَنفُسِكُمُ","anfusikumu","yourselves","তোমাদের নিজেদের"],["ٱلْمَوْتَ","l-mawta","[the] death","মৃত্যুকে"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you are","তোমরা হও"],["صَـٰدِقِينَ","ṣādiqīna","truthful","সত্যবাদী"]],"t":"ٱلَّذِينَ قَالُو<s>ا۟</> لِإِخْ<m>وَٰ</>نِهِمْ وَقَعَدُو<s>ا۟</> لَوْ أَطَاعُونَا مَا قُتِلُو<s>ا۟ ۗ</> قُلْ فَ<h>ٱ</><q>دْ</>رَءُو<s>ا۟</> عَنْ أَ<k>نفُ</>سِكُمُ <h>ٱ</>لْمَوْتَ إِ<k>ن كُنتُ</>مْ <m>صَٰ</>دِ<p>قِي</>نَ"},{"n":169,"w":[["وَلَا","walā","And (do) not","এবং না"],["تَحْسَبَنَّ","taḥsabanna","think","মনে করো"],["ٱلَّذِينَ","alladhīna","(of) those who","(তাদেরকে) যারা"],["قُتِلُوا۟","qutilū","are killed","নিহত হয়েছে"],["فِى","fī","in","(মধ্যে)"],["سَبِيلِ","sabīli","(the) way","পথে"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["أَمْوَٰتًۢا ۚ","amwātan","(as) dead","(তারা) মৃত"],["بَلْ","bal","Nay","বরং"],["أَحْيَآءٌ","aḥyāon","They are alive","তারা জীবিত"],["عِندَ","‘inda","near","কাছে"],["رَبِّهِمْ","rabbihim","their Lord","তাদের রবের"],["يُرْزَقُونَ","yur'zaqūna","they are given provision","তাদের রিয্ক‌ দেয়া হয়"]],"t":"وَلَا تَحْسَبَ<g>نَّ</> <h>ٱ</>لَّذِينَ قُتِلُو<s>ا۟</> فِى سَبِيلِ <h>ٱ</>للَّهِ أَمْ<m>وَٰ</><i>تًۢا ۚ بَ</>لْ أَحْ<o>يَآ</>ءٌ عِ<k>ندَ</> رَبِّهِمْ يُرْزَ<p>قُو</>نَ"},{"n":170,"w":[["فَرِحِينَ","fariḥīna","Rejoicing","তারা খুশী হয়েছে"],["بِمَآ","bimā","in what","যা কিছু"],["ءَاتَىٰهُمُ","ātāhumu","bestowed them","তাদের দিয়েছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["مِن","min","of","(থেকে)"],["فَضْلِهِۦ","faḍlihi","His Bounty","তাঁর অনুগ্রহে"],["وَيَسْتَبْشِرُونَ","wayastabshirūna","and they receive good tidings","এবং তারা আনন্দিত হবে (এসব জেনে)"],["بِٱلَّذِينَ","bi-alladhīna","about those who","(তাদের) জন্য যারা"],["لَمْ","lam","(have) not","নাই"],["يَلْحَقُوا۟","yalḥaqū","yet joined","মিলিত হয়"],["بِهِم","bihim","[with] them","তাদের সাথে"],["مِّنْ","min","[from]","(থেকে)"],["خَلْفِهِمْ","khalfihim","(but are) left behind ","তাদের পিছনে (রয়ে গেছে এখনো)"],["أَلَّا","allā","that (there will be) no","যে না"],["خَوْفٌ","khawfun","fear","কোন ভয় (আছে)"],["عَلَيْهِمْ","‘alayhim","on them","তাদের জন্য"],["وَلَا","walā","and not","এবং না"],["هُمْ","hum","they","তারা"],["يَحْزَنُونَ","yaḥzanūna","will grieve","দুঃখিত হবে"]],"t":"فَرِحِينَ بِ<o>مَآ</> ءَاتَ<m>ىٰ</>هُمُ <h>ٱ</>للَّهُ مِ<k>ن فَ</>ضْلِ<m>هِۦ</> وَيَسْتَ<q>بْ</>شِرُونَ بِ<h>ٱ</>لَّذِينَ لَمْ يَلْحَقُو<s>ا۟</> بِ<y>هِم مِّ</>نْ خَلْفِهِمْ أَلَّا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَ<p>نُو</>نَ"},{"n":171,"w":[["۞ يَسْتَبْشِرُونَ","yastabshirūna","They receive good tidings","তারা আনন্দিত হবে"],["بِنِعْمَةٍۢ","bini‘'matin","of Favor","নিয়ামতের কারণে"],["مِّنَ","mina","from","পক্ষ হতে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["وَفَضْلٍۢ","wafaḍlin","and Bounty","ও অনুগ্রহে"],["وَأَنَّ","wa-anna","and that","এবং (এও) যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَا","lā","(does) not","না"],["يُضِيعُ","yuḍī‘u","let go waste","নষ্ট করেন"],["أَجْرَ","ajra","(the) reward","পুরস্কার"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","(of) the believers","ঈমানদারদের"]],"t":"۞ يَسْتَ<q>بْ</>شِرُونَ بِنِعْمَ<d>ةٍۢ مِّ</>نَ <h>ٱ</>للَّهِ وَفَضْ<d>لٍۢ وَ</>أَ<g>نَّ</> <h>ٱ</>للَّهَ لَا يُضِيعُ أَ<q>جْ</>رَ <h>ٱ</>لْمُؤْمِ<p>نِي</>نَ"},{"n":172,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["ٱسْتَجَابُوا۟","is'tajābū","responded","সাড়া দেয়"],["لِلَّهِ","lillahi","to Allah","আল্লাহর"],["وَٱلرَّسُولِ","wal-rasūli","and the Messenger","ও রাসূলের (ডাকে)"],["مِنۢ","min","from","(থেকে)"],["بَعْدِ","ba‘di","after","এরপরেও"],["مَآ","mā","what","যা"],["أَصَابَهُمُ","aṣābahumu","befell them ","তাদের পৌঁছেছে"],["ٱلْقَرْحُ ۚ","l-qarḥu","the injury ","আঘাত"],["لِلَّذِينَ","lilladhīna","for those who","তাদের জন্য"],["أَحْسَنُوا۟","aḥsanū","did good","নেকী করেছে (যারা)"],["مِنْهُمْ","min'hum","among them","তাদের মধ্যে"],["وَٱتَّقَوْا۟","wa-ittaqaw","and feared Allah","ও ভয় করেছে (আল্লাহকে)"],["أَجْرٌ","ajrun","(is) a reward ","পুরস্কার (রয়েছে)"],["عَظِيمٌ","‘aẓīmun","great","বিরাট"]],"t":"ٱلَّذِينَ <h>ٱ</>سْتَجَابُو<s>ا۟</> لِلَّهِ وَ<h>ٱ</><l>ل</>رَّسُولِ <i>مِنۢ بَ</>عْدِ <o>مَآ</> أَصَابَهُمُ <h>ٱ</>لْقَرْحُ ۚ لِلَّذِينَ أَحْسَنُو<s>ا۟</> مِنْهُمْ وَ<h>ٱ</>تَّقَوْ<s>ا۟</> أَ<q>جْ</>رٌ عَ<p>ظِي</>مٌ"},{"n":173,"w":[["ٱلَّذِينَ","alladhīna","Those who","(এমন) যারা"],["قَالَ","qāla","said","বলেছিল"],["لَهُمُ","lahumu","to them","তাদেরকে"],["ٱلنَّاسُ","l-nāsu","[the people]","লোকেরা"],["إِنَّ","inna","Indeed","''নিশ্চয়"],["ٱلنَّاسَ","l-nāsa","the people","সব লোক (অর্থাৎ বড় বাহিনী)"],["قَدْ","qad","(have) certainly","অবশ্যই"],["جَمَعُوا۟","jama‘ū","gathered","জমা হয়েছে"],["لَكُمْ","lakum","against you","তোমাদের জন্য"],["فَٱخْشَوْهُمْ","fa-ikh'shawhum","so fear them","তাই ভয় কর তাদেরকে''"],["فَزَادَهُمْ","fazādahum","But it increased them","কিন্তু তাদের বেড়ে গেল"],["إِيمَـٰنًۭا","īmānan","(in) faith","ঈমান"],["وَقَالُوا۟","waqālū","and they said","এবং তারা বলেছিল"],["حَسْبُنَا","ḥasbunā","Sufficient for us","''আমাদের জন্য যথেষ্ট"],["ٱللَّهُ","l-lahu","(is) Allah","আল্লাহই"],["وَنِعْمَ","wani‘'ma","and (He is the) best","এবং (তিনিই) উত্তম"],["ٱلْوَكِيلُ","l-wakīlu","[the] Disposer of affairs","অভিভাবক''"]],"t":"ٱلَّذِينَ قَالَ لَهُمُ <h>ٱ</><l>ل</><g>نَّ</>اسُ إِ<g>نَّ</> <h>ٱ</><l>ل</><g>نَّ</>اسَ قَ<q>دْ</> جَمَعُو<s>ا۟</> لَكُمْ فَ<h>ٱ</>خْشَوْهُمْ فَزَادَهُمْ إِي<m>مَٰ</><d>نًۭا وَ</>قَالُو<s>ا۟</> حَسْبُنَا <h>ٱ</>للَّهُ وَنِعْمَ <h>ٱ</>لْوَ<p>كِي</>لُ"},{"n":174,"w":[["فَٱنقَلَبُوا۟","fa-inqalabū","So they returned","তারা ফলে ফিরে এল"],["بِنِعْمَةٍۢ","bini‘'matin","with (the) Favor","অবদানে"],["مِّنَ","mina","of","(থেকে)"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["وَفَضْلٍۢ","wafaḍlin","and Bounty","ও (তাঁর) অনুগ্রহে"],["لَّمْ","lam","not","নাই"],["يَمْسَسْهُمْ","yamsashum","touched them","তাদের স্পর্শ করে"],["سُوٓءٌۭ","sūon","any harm","কোন অকল্যাণ"],["وَٱتَّبَعُوا۟","wa-ittaba‘ū","And they followed","এবং তারা অনুসরণ করেছিল"],["رِضْوَٰنَ","riḍ'wāna","(the) pleasure","সন্তুষ্টির"],["ٱللَّهِ ۗ","l-lahi","(of) Allah","আল্লাহর"],["وَٱللَّهُ","wal-lahu","and Allah","এবং আল্লাহ"],["ذُو","dhū","(is) Possessor","(একটি)"],["فَضْلٍ","faḍlin","(of) Bounty","অনুগ্রহশীল"],["عَظِيمٍ","‘aẓīmin","great","মহান"]],"t":"فَ<h>ٱ</><k>نقَ</>لَبُو<s>ا۟</> بِنِعْمَ<d>ةٍۢ مِّ</>نَ <h>ٱ</>للَّهِ وَفَضْ<w>لٍۢ لَّ</>مْ يَمْسَسْهُمْ <o>سُوٓ</><d>ءٌۭ وَ</><h>ٱ</>تَّبَعُو<s>ا۟</> رِضْ<m>وَٰ</>نَ <h>ٱ</>للَّهِ ۗ وَ<h>ٱ</>للَّهُ ذُو فَضْلٍ عَ<p>ظِي</>مٍ"},{"n":175,"w":[["إِنَّمَا","innamā","(It is) only","মূলত"],["ذَٰلِكُمُ","dhālikumu","that","তোমাদের এই"],["ٱلشَّيْطَـٰنُ","l-shayṭānu","the Shaitaan","শয়তানই"],["يُخَوِّفُ","yukhawwifu","frightens (you)","ভয় দেখায়"],["أَوْلِيَآءَهُۥ","awliyāahu","(of) his allies","তার বন্ধুদেরকে"],["فَلَا","falā","So (do) not","অতএব না"],["تَخَافُوهُمْ","takhāfūhum","fear them","তোমরা ভয় কর তাদেরকে"],["وَخَافُونِ","wakhāfūni","but fear Me","বরং আমাকেই তোমরা ভয় কর"],["إِن","in","if","যদি"],["كُنتُم","kuntum","you are","তোমরা হও"],["مُّؤْمِنِينَ","mu'minīna","believers","মু'মিন"]],"t":"إِ<g>نَّ</>مَا <m>ذَٰ</>لِكُمُ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نُ يُخَوِّفُ أَوْلِ<o>يَآ</>ءَهُ<m>ۥ</> فَلَا تَخَافُوهُمْ وَخَافُونِ إِ<k>ن كُنتُ</><y>م مُّ</>ؤْمِ<p>نِي</>نَ"},{"n":176,"w":[["وَلَا","walā","And (let) not","এবং না"],["يَحْزُنكَ","yaḥzunka","grieve you","তোমাকে (যেন) চিন্তিত করে"],["ٱلَّذِينَ","alladhīna","those who","(তারা) যারা"],["يُسَـٰرِعُونَ","yusāri‘ūna","hasten","তৎপর হয়েছে"],["فِى","fī","in(to)","মধ্যে"],["ٱلْكُفْرِ ۚ","l-kuf'ri","[the] disbelief","কুফরীর"],["إِنَّهُمْ","innahum","Indeed, they","তারা নিশ্চয়"],["لَن","lan","never","কক্ষনো না"],["يَضُرُّوا۟","yaḍurrū","will harm","ক্ষতি করতে পারবে"],["ٱللَّهَ","l-laha","Allah","আল্লাহর"],["شَيْـًۭٔا ۗ","shayan","(in) anything","কিছুমাত্রও"],["يُرِيدُ","yurīdu","intends","চান"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["أَلَّا","allā","that not","যে না"],["يَجْعَلَ","yaj‘ala","He will set","রাখবেন"],["لَهُمْ","lahum","for them","তাদের জন্য"],["حَظًّۭا","ḥaẓẓan","any portion","কোন অংশ"],["فِى","fī","in","মধ্যে"],["ٱلْـَٔاخِرَةِ ۖ","l-ākhirati","the Hereafter","আখিরাতের"],["وَلَهُمْ","walahum","And for them","এবং তাদের জন্য রয়েছে"],["عَذَابٌ","‘adhābun","(is) a punishment","শাস্তি"],["عَظِيمٌ","‘aẓīmun","great","বড় কঠিন"]],"t":"وَلَا يَحْزُ<k>نكَ</> <h>ٱ</>لَّذِينَ يُ<m>سَٰ</>رِعُونَ فِى <h>ٱ</>لْكُفْرِ ۚ إِ<g>نَّ</>هُمْ <d>لَن يَ</>ضُرُّو<s>ا۟</> <h>ٱ</>للَّهَ شَ<d>يْـًۭٔا ۗ يُ</>رِيدُ <h>ٱ</>للَّهُ أَلَّا يَ<q>جْ</>عَلَ لَهُمْ حَ<k>ظًّۭا فِ</>ى <h>ٱ</>لْءَاخِرَةِ ۖ وَلَهُمْ عَذَابٌ عَ<p>ظِي</>مٌ"},{"n":177,"w":[["إِنَّ","inna","Indeed","নিশ্চয়"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ٱشْتَرَوُا۟","ish'tarawū","(have) purchased","ক্রয় করেছে"],["ٱلْكُفْرَ","l-kuf'ra","[the] disbelief","কুফরীকে"],["بِٱلْإِيمَـٰنِ","bil-īmāni","with the faith","ঈমানের বদলে"],["لَن","lan","never","কক্ষনো না"],["يَضُرُّوا۟","yaḍurrū","will they harm","ক্ষতি করতে পারবে"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["شَيْـًۭٔا","shayan","(in) anything","কিছুমাত্রও"],["وَلَهُمْ","walahum","and for them","এবং তাদের জন্য রয়েছে"],["عَذَابٌ","‘adhābun","(is) a punishment","শাস্তি"],["أَلِيمٌۭ","alīmun","painful","বড়ই কষ্টদায়ক"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ <h>ٱ</>شْتَرَوُ<s>ا۟</> <h>ٱ</>لْكُفْرَ بِ<h>ٱ</>لْإِي<m>مَٰ</>نِ <d>لَن يَ</>ضُرُّو<s>ا۟</> <h>ٱ</>للَّهَ شَ<d>يْـًۭٔا وَ</>لَهُمْ عَذَابٌ أَ<p>لِي</>مٌۭ"},{"n":178,"w":[["وَلَا","walā","And (let) not","এবং না"],["يَحْسَبَنَّ","yaḥsabanna","think","(যেন) তারা মনে করে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوٓا۟","kafarū","disbelieved","কুফরী করেছে"],["أَنَّمَا","annamā","that","এই যে"],["نُمْلِى","num'lī","We give respite","আমরা ঢিল দিই"],["لَهُمْ","lahum","to them","তাদেরকে"],["خَيْرٌۭ","khayrun","(is) good","উত্তম"],["لِّأَنفُسِهِمْ ۚ","li-anfusihim","for themselves","তাদের নিজেদের জন্য"],["إِنَّمَا","innamā","Only","মূলত"],["نُمْلِى","num'lī","We give respite","আমরা ঢিল দিই"],["لَهُمْ","lahum","to them","তাদেরকে"],["لِيَزْدَادُوٓا۟","liyazdādū","so that they may increase","তারা বৃদ্ধি করে যেন"],["إِثْمًۭا ۚ","ith'man","(in) sins","পাপ"],["وَلَهُمْ","walahum","and for them","এবং তাদের জন্য (রয়েছে)"],["عَذَابٌۭ","‘adhābun","(is) a punishment","শাস্তি"],["مُّهِينٌۭ","muhīnun","humiliating","বড় অপমানকর"]],"t":"وَلَا يَحْسَبَ<g>نَّ</> <h>ٱ</>لَّذِينَ كَفَ<o>رُوٓ</><s>ا۟</> أَ<g>نَّ</>مَا نُمْلِى لَهُمْ خَيْ<w>رٌۭ لِّ</>أَ<k>نفُ</>سِهِمْ ۚ إِ<g>نَّ</>مَا نُمْلِى لَهُمْ لِيَزْدَا<o>دُوٓ</><s>ا۟</> إِثْ<d>مًۭا ۚ وَ</>لَهُمْ عَذَا<d>بٌۭ مُّ</><p>هِي</>نٌۭ"},{"n":179,"w":[["مَّا","mā","Not","নয়"],["كَانَ","kāna","is","(পদ্ধতি)"],["ٱللَّهُ","l-lahu","Allah","আল্লাহর"],["لِيَذَرَ","liyadhara","to leave","যে ছেড়ে দিবেন"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believers","মু'মিনদেরকে (এমনি)"],["عَلَىٰ","‘alā","on","উপর"],["مَآ","mā","what","যেমন"],["أَنتُمْ","antum","you (are)","তোমরা (আছ)"],["عَلَيْهِ","‘alayhi","in [it]","তার উপর"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["يَمِيزَ","yamīza","He separates","পৃথক করবেন"],["ٱلْخَبِيثَ","l-khabītha","the evil","নাপাক (অসৎ লোকদের)"],["مِنَ","mina","from","হতে"],["ٱلطَّيِّبِ ۗ","l-ṭayibi","the good","পাক (সৎ লোকদের)"],["وَمَا","wamā","And not","এবং নয়"],["كَانَ","kāna","is","(পদ্ধতি)"],["ٱللَّهُ","l-lahu","Allah","আল্লাহর"],["لِيُطْلِعَكُمْ","liyuṭ'li‘akum","to inform you","তোমাদের খবর দেয়া"],["عَلَى","‘alā","about","সম্পর্কে"],["ٱلْغَيْبِ","l-ghaybi","the unseen","গায়েবের"],["وَلَـٰكِنَّ","walākinna","[and] but","কিন্তু"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يَجْتَبِى","yajtabī","chooses","বাছাই করে নেন"],["مِن","min","from","মধ্য হতে"],["رُّسُلِهِۦ","rusulihi","His Messengers","তাঁর রাসূলগণের"],["مَن","man","whom","যাকে"],["يَشَآءُ ۖ","yashāu","He wills","তিনি চান"],["فَـَٔامِنُوا۟","faāminū","so believe","তোমরা তাই ঈমান আন"],["بِٱللَّهِ","bil-lahi","in Allah","আল্লাহর উপর"],["وَرُسُلِهِۦ ۚ","warusulihi","and His Messengers","ও তাঁর রাসূলদের (উপর)"],["وَإِن","wa-in","and if","এবং যদি"],["تُؤْمِنُوا۟","tu'minū","you believe","তোমরা ঈমান আন"],["وَتَتَّقُوا۟","watattaqū","and fear (Allah)","ও তোমরা ভ