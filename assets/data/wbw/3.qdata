ে যা"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা কাজ করছ"],["خَبِيرٌۭ","khabīrun","(is) All-Aware","খুবই অবহিত"]],"t":"وَلَا يَحْسَبَ<g>نَّ</> <h>ٱ</>لَّذِينَ يَ<q>بْ</>خَلُونَ بِ<o>مَآ</> ءَاتَ<m>ىٰ</>هُمُ <h>ٱ</>للَّهُ مِ<k>ن فَ</>ضْلِ<m>هِۦ</> هُوَ خَيْ<w>رًۭا لَّ</><f>هُم ۖ بَ</>لْ هُوَ شَ<w>رٌّۭ لَّ</>هُمْ ۖ سَيُطَوَّقُونَ مَا بَخِلُو<s>ا۟</> بِ<m>هِۦ</> يَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ ۗ وَلِلَّهِ مِي<m>رَٰ</>ثُ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ ۗ وَ<h>ٱ</>للَّهُ بِمَا تَعْمَلُونَ خَ<p>بِي</>رٌۭ"},{"n":181,"w":[["لَّقَدْ","laqad","Certainly","নিশ্চয়"],["سَمِعَ","sami‘a","heard","শুনেছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["قَوْلَ","qawla","(the) saying","(তাদের) কথা"],["ٱلَّذِينَ","alladhīna","(of) those who","যারা"],["قَالُوٓا۟","qālū","said","বলেছিল"],["إِنَّ","inna","Indeed","''নিশ্চয়"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["فَقِيرٌۭ","faqīrun","(is) poor","দরিদ্র"],["وَنَحْنُ","wanaḥnu","while we","আর আমরা"],["أَغْنِيَآءُ ۘ","aghniyāu","(are) rich","ধনী''"],["سَنَكْتُبُ","sanaktubu","We will record","আমরা লিখে রাখবো"],["مَا","mā","what","যা"],["قَالُوا۟","qālū","they said","তারা বলেছিল"],["وَقَتْلَهُمُ","waqatlahumu","and their killing","ও তাদের হত্যা করা"],["ٱلْأَنۢبِيَآءَ","l-anbiyāa","the Prophets","নবীদেরকে"],["بِغَيْرِ","bighayri","without","ব্যাতিত"],["حَقٍّۢ","ḥaqqin","(any) right","ন্যায়ভাবে"],["وَنَقُولُ","wanaqūlu","and We will say","এবং আমরা বলব"],["ذُوقُوا۟","dhūqū","Taste","''তোমরা স্বাদ নাও"],["عَذَابَ","‘adhāba","(the) punishment","শাস্তির"],["ٱلْحَرِيقِ","l-ḥarīqi","(of) the Burning Fire","দহনের''"]],"t":"لَّقَ<q>دْ</> سَمِعَ <h>ٱ</>للَّهُ قَوْلَ <h>ٱ</>لَّذِينَ قَا<o>لُوٓ</><s>ا۟</> إِ<g>نَّ</> <h>ٱ</>للَّهَ فَقِي<d>رٌۭ وَ</>نَحْنُ أَغْنِ<o>يَآ</>ءُ ۘ سَنَكْتُبُ مَا قَالُو<s>ا۟</> وَقَتْلَهُمُ <h>ٱ</>لْأَ<i>نۢبِ</><o>يَآ</>ءَ بِغَيْرِ حَ<d>قٍّۢ وَ</>نَقُولُ ذُوقُو<s>ا۟</> عَذَابَ <h>ٱ</>لْحَ<p>رِي</><q>قِ</>"},{"n":182,"w":[["ذَٰلِكَ","dhālika","That","এটা"],["بِمَا","bimā","(is) because","একারণে যা"],["قَدَّمَتْ","qaddamat","(of what) sent forth","আগে পাঠিয়েছে"],["أَيْدِيكُمْ","aydīkum","your hands","তোমাদের হাত (অর্থাৎ) কৃতকর্ম"],["وَأَنَّ","wa-anna","and that","এবং নিশ্চয়"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَيْسَ","laysa","is not","নন"],["بِظَلَّامٍۢ","biẓallāmin","unjust","জুলুমকারী"],["لِّلْعَبِيدِ","lil'‘abīdi","to (His) slaves","বান্দাদের উপর"]],"t":"<m>ذَٰ</>لِكَ بِمَا قَدَّمَتْ أَيْدِيكُمْ وَأَ<g>نَّ</> <h>ٱ</>للَّهَ لَيْسَ بِظَلَّا<w>مٍۢ لِّ</>لْعَ<p>بِي</><q>دِ</>"},{"n":183,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["قَالُوٓا۟","qālū","said","বলে"],["إِنَّ","inna","Indeed","''নিশ্চয়"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["عَهِدَ","‘ahida","(has) taken promise","নির্দেশ দিয়েছেন"],["إِلَيْنَآ","ilaynā","from us","আমাদের প্রতি"],["أَلَّا","allā","that not","যে না"],["نُؤْمِنَ","nu'mina","we (should) believe","আমরা ঈমান আনব"],["لِرَسُولٍ","lirasūlin","in a Messenger","কোন রাসূলের উপর"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["يَأْتِيَنَا","yatiyanā","he brings to us","আমাদের কাছে নিয়ে আসবে"],["بِقُرْبَانٍۢ","biqur'bānin","a sacrifice ","এক কুরবানী"],["تَأْكُلُهُ","takuluhu","consumes it","তা খেয়ে ফেলবে"],["ٱلنَّارُ ۗ","l-nāru","the fire","(অদৃশ্যের) আগুন''"],["قُلْ","qul","Say","বল"],["قَدْ","qad","Surely","''নিশ্চয়"],["جَآءَكُمْ","jāakum","came to you","তোমাদের কাছে এসেছে"],["رُسُلٌۭ","rusulun","Messengers","অনেক রাসূল"],["مِّن","min","from","(থেকে)"],["قَبْلِى","qablī","before me","আমার পূর্বে"],["بِٱلْبَيِّنَـٰتِ","bil-bayināti","with the clear Signs","উজ্জ্বল নিদর্শন সহকারে"],["وَبِٱلَّذِى","wabi-alladhī","and with what","এবং ঐ বিষয়ে যা"],["قُلْتُمْ","qul'tum","you speak","তোমরা বলেছ"],["فَلِمَ","falima","So why","তবে কেন"],["قَتَلْتُمُوهُمْ","qataltumūhum","you killed them","তোমরা হত্যা করেছ তাদেরকে"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you are","তোমরা হও"],["صَـٰدِقِينَ","ṣādiqīna","truthful","সত্যবাদী"]],"t":"ٱلَّذِينَ قَا<o>لُوٓ</><s>ا۟</> إِ<g>نَّ</> <h>ٱ</>للَّهَ عَهِدَ إِلَيْ<o>نَآ</> أَلَّا نُؤْمِنَ لِرَسُولٍ حَتَّىٰ يَأْتِيَنَا بِقُرْبَا<k>نٍۢ تَ</>أْكُلُهُ <h>ٱ</><l>ل</><g>نَّ</>ارُ ۗ قُلْ قَ<q>دْ</> <o>جَآ</>ءَكُمْ رُسُ<d>لٌۭ مِّ</><k>ن قَ</><q>بْ</>لِى بِ<h>ٱ</>لْبَيِّ<m>نَٰ</>تِ وَبِ<h>ٱ</>لَّذِى قُلْتُمْ فَلِمَ قَتَلْتُمُوهُمْ إِ<k>ن كُنتُ</>مْ <m>صَٰ</>دِ<p>قِي</>نَ"},{"n":184,"w":[["فَإِن","fa-in","Then if","যদি তবুও"],["كَذَّبُوكَ","kadhabūka","they reject you","তোমাকে অস্বীকার করে"],["فَقَدْ","faqad","then certainly","তবে (নতুন কিছু নয়)"],["كُذِّبَ","kudhiba","were rejected","অস্বীকার করেছে"],["رُسُلٌۭ","rusulun","Messengers","রাসূলদেরকে"],["مِّن","min","from","(থেকে)"],["قَبْلِكَ","qablika","before you","তোমার পূর্বেও"],["جَآءُو","jāū","(who) came","তারা এসেছিল"],["بِٱلْبَيِّنَـٰتِ","bil-bayināti","with the clear Signs","সুস্পষ্ট নিদর্শনসহ"],["وَٱلزُّبُرِ","wal-zuburi","and the Scriptures","ও (অনেক) সহীফা"],["وَٱلْكِتَـٰبِ","wal-kitābi","and the Book ","ও কিতাব"],["ٱلْمُنِيرِ","l-munīri","[the] Enlightening","আলোকদানকারী (সাথে নিয়ে)"]],"t":"فَإِ<k>ن كَ</>ذَّبُوكَ فَقَ<q>دْ</> كُذِّبَ رُسُ<d>لٌۭ مِّ</><k>ن قَ</><q>بْ</>لِكَ <o>جَآ</>ءُو بِ<h>ٱ</>لْبَيِّ<m>نَٰ</>تِ وَ<h>ٱ</><l>ل</>زُّبُرِ وَ<h>ٱ</>لْكِ<m>تَٰ</>بِ <h>ٱ</>لْمُ<p>نِي</>رِ"},{"n":185,"w":[["كُلُّ","kullu","Every","প্রত্যেক"],["نَفْسٍۢ","nafsin","soul","ব্যক্তিই"],["ذَآئِقَةُ","dhāiqatu","(will) taste","স্বাদ গ্রহণকারী (হবে)"],["ٱلْمَوْتِ ۗ","l-mawti","[the] death","মৃত্যুর"],["وَإِنَّمَا","wa-innamā","and only","এবং প্রকৃতপক্ষে"],["تُوَفَّوْنَ","tuwaffawna","you will be paid in full","তোমাদের পূর্ণ দেয়া হবে"],["أُجُورَكُمْ","ujūrakum","your reward","তোমাদের পুরস্কার সমূহ"],["يَوْمَ","yawma","(on the) Day","দিনে"],["ٱلْقِيَـٰمَةِ ۖ","l-qiyāmati","(of) [the] Resurrection","কিয়ামাতের"],["فَمَن","faman","Then whoever","অতঃপর যাকে"],["زُحْزِحَ","zuḥ'ziḥa","is drawn away","রক্ষা করা হবে"],["عَنِ","‘ani","from","থেকে"],["ٱلنَّارِ","l-nāri","the Fire","আগুন"],["وَأُدْخِلَ","wa-ud'khila","and admitted","এবং প্রবেশ করানো হবে"],["ٱلْجَنَّةَ","l-janata","(to) Paradise","জান্নাতে"],["فَقَدْ","faqad","then surely","তবে নিশ্চয়"],["فَازَ ۗ","fāza","he is successful","সে সফল হবে"],["وَمَا","wamā","And not","এবং নয়"],["ٱلْحَيَوٰةُ","l-ḥayatu","(is) the life","জীবন"],["ٱلدُّنْيَآ","l-dun'yā","(of) the world","দুনিয়ার"],["إِلَّا","illā","except","এ ছাড়া"],["مَتَـٰعُ","matā‘u","enjoyment","সামগ্রী"],["ٱلْغُرُورِ","l-ghurūri","(of) delusion","ধোঁকার"]],"t":"كُلُّ نَفْ<k>سٍۢ ذَ</><o>آ</>ئِقَةُ <h>ٱ</>لْمَوْتِ ۗ وَإِ<g>نَّ</>مَا تُوَفَّوْنَ أُجُورَكُمْ يَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ ۖ فَمَ<k>ن زُ</>حْزِحَ عَنِ <h>ٱ</><l>ل</><g>نَّ</>ارِ وَأُ<q>دْ</>خِلَ <h>ٱ</>لْجَ<g>نَّ</>ةَ فَقَ<q>دْ</> فَازَ ۗ وَمَا <h>ٱ</>لْحَيَ<s>وٰ</>ةُ <h>ٱ</><l>ل</>دُّنْ<o>يَآ</> إِلَّا مَ<m>تَٰ</>عُ <h>ٱ</>لْغُ<p>رُو</>رِ"},{"n":186,"w":[["۞ لَتُبْلَوُنَّ","latub'lawunna","You will certainly be tested","তোমাদের অবশ্যই পরীক্ষা করা হবে"],["فِىٓ","fī","in","মধ্যে"],["أَمْوَٰلِكُمْ","amwālikum","your wealth","তোমাদের সম্পদ সমূহের"],["وَأَنفُسِكُمْ","wa-anfusikum","and yourselves","ও তোমাদের জান সমূহে"],["وَلَتَسْمَعُنَّ","walatasma‘unna","And you will certainly hear","এবং তোমরা অবশ্যই শুনবে"],["مِنَ","mina","from","তাদের থেকে"],["ٱلَّذِينَ","alladhīna","those who","যাদের"],["أُوتُوا۟","ūtū","were given","দেয়া হয়েছে"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","কিতাব"],["مِن","min","from","(থেকে)"],["قَبْلِكُمْ","qablikum","before you","তোমাদের পূর্বে"],["وَمِنَ","wamina","and from","এবং হতেও"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["أَشْرَكُوٓا۟","ashrakū","associate partners with Allah ","শিরক করেছে"],["أَذًۭى","adhan","hurtful things","কষ্টদায়ক (কথা)"],["كَثِيرًۭا ۚ","kathīran","many","অনেক"],["وَإِن","wa-in","and if","এবং যদি"],["تَصْبِرُوا۟","taṣbirū","you are patient","তোমরা সবর কর"],["وَتَتَّقُوا۟","watattaqū","and fear (Allah)","ও তোমরা তাকওয়া অবলম্বন কর"],["فَإِنَّ","fa-inna","then indeed","তবে নিশ্চয়"],["ذَٰلِكَ","dhālika","that","এটা"],["مِنْ","min","(is) of","অন্যতম"],["عَزْمِ","‘azmi","the matters","দৃঢ় সংকল্পের"],["ٱلْأُمُورِ","l-umūri","(of) determination","ব্যাপার"]],"t":"۞ لَتُ<q>بْ</>لَوُ<g>نَّ</> <o>فِىٓ</> أَمْ<m>وَٰ</>لِكُمْ وَأَ<k>نفُ</>سِكُمْ وَلَتَسْمَعُ<g>نَّ</> مِنَ <h>ٱ</>لَّذِينَ أُوتُو<s>ا۟</> <h>ٱ</>لْكِ<m>تَٰ</>بَ مِ<k>ن قَ</><q>بْ</>لِكُمْ وَمِنَ <h>ٱ</>لَّذِينَ أَشْرَ<o>كُوٓ</><s>ا۟</> أَ<k>ذًۭى كَ</>ثِي<d>رًۭا ۚ وَ</>إِ<k>ن تَ</>صْبِرُو<s>ا۟</> وَتَتَّقُو<s>ا۟</> فَإِ<g>نَّ</> <m>ذَٰ</>لِكَ مِنْ عَزْمِ <h>ٱ</>لْأُ<p>مُو</>رِ"},{"n":187,"w":[["وَإِذْ","wa-idh","And when","এবং (স্মরণ কর) যখন"],["أَخَذَ","akhadha","took","নিয়েছিলেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["مِيثَـٰقَ","mīthāqa","a Covenant","প্রতিশ্রুতি"],["ٱلَّذِينَ","alladhīna","(from) those who","(তাদের থেকে) যাদেরকে"],["أُوتُوا۟","ūtū","were given","দেয়া হয়েছিল"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","কিতাব"],["لَتُبَيِّنُنَّهُۥ","latubayyinunnahu","You certainly make it clear","''তা অবশ্যই তোমরা প্রচার করবে"],["لِلنَّاسِ","lilnnāsi","to the mankind","লোকদের জন্য"],["وَلَا","walā","and (do) not","এবং না"],["تَكْتُمُونَهُۥ","taktumūnahu","conceal it","তোমরা গোপন করবে তা"],["فَنَبَذُوهُ","fanabadhūhu","Then they threw it","অতঃপর তারা ফেলে দিল তা"],["وَرَآءَ","warāa","behind","পিছনে"],["ظُهُورِهِمْ","ẓuhūrihim","their backs","তাদের পিঠের (অর্থাৎ অগ্রাহ্য করল)"],["وَٱشْتَرَوْا۟","wa-ish'taraw","and they exchanged","এবং তারা ক্রয় করল"],["بِهِۦ","bihi","[with] it","তা দিয়ে"],["ثَمَنًۭا","thamanan","(for) a price","মূল্যের (জিনিস)"],["قَلِيلًۭا ۖ","qalīlan","little","অতি অল্প"],["فَبِئْسَ","fabi'sa","And wretched","অতএব কত নিকৃষ্ট"],["مَا","mā","(is) what","যা"],["يَشْتَرُونَ","yashtarūna","they purchase","তারা ক্রয় করে"]],"t":"وَإِذْ أَخَذَ <h>ٱ</>للَّهُ مِي<m>ثَٰ</>قَ <h>ٱ</>لَّذِينَ أُوتُو<s>ا۟</> <h>ٱ</>لْكِ<m>تَٰ</>بَ لَتُبَيِّنُ<g>نَّ</>هُ<m>ۥ</> لِل<g>نَّ</>اسِ وَلَا تَكْتُمُونَهُ<m>ۥ</> فَنَبَذُوهُ وَ<o>رَآ</>ءَ ظُهُورِهِمْ وَ<h>ٱ</>شْتَرَوْ<s>ا۟</> بِ<m>هِۦ</> ثَمَ<k>نًۭا قَ</>لِيلًۭ<k>ا ۖ فَ</>بِئْسَ مَا يَشْتَ<p>رُو</>نَ"},{"n":188,"w":[["لَا","lā","(Do) not","না"],["تَحْسَبَنَّ","taḥsabanna","think","তারা (যেন) মনে করে"],["ٱلَّذِينَ","alladhīna","(that) those who","মনে করে"],["يَفْرَحُونَ","yafraḥūna","rejoice","যারা আনুন্দ করে"],["بِمَآ","bimā","in what","ঐ বিষয়ে যা"],["أَتَوا۟","ataw","(they have) brought","তারা করেছে"],["وَّيُحِبُّونَ","wayuḥibbūna","and they love","তারা পছন্দ করে"],["أَن","an","that","যে"],["يُحْمَدُوا۟","yuḥ'madū","they be praised","তাদের প্রশংসা করা হোক"],["بِمَا","bimā","for what","ঐবিষয়ে যা"],["لَمْ","lam","not","নাই"],["يَفْعَلُوا۟","yaf‘alū","they do ","তারা করেও"],["فَلَا","falā","so (do) not","অতএব না"],["تَحْسَبَنَّهُم","taḥsabannahum","think (that) they","তাদের মনে করবে"],["بِمَفَازَةٍۢ","bimafāzatin","(will) escape","নিরাপদ স্থানে"],["مِّنَ","mina","from","হতে"],["ٱلْعَذَابِ ۖ","l-‘adhābi","the punishment","আজাব"],["وَلَهُمْ","walahum","and for them","এবং তাদের জন্য রয়েছে"],["عَذَابٌ","‘adhābun","(is a) punishment","শাস্তি"],["أَلِيمٌۭ","alīmun","painful","কষ্টদায়ক"]],"t":"لَا تَحْسَبَ<g>نَّ</> <h>ٱ</>لَّذِينَ يَفْرَحُونَ بِ<o>مَآ</> أَتَو<s>ا۟</> وَّيُحِبُّونَ <d>أَن يُ</>حْمَدُو<s>ا۟</> بِمَا لَمْ يَفْعَلُو<s>ا۟</> فَلَا تَحْسَبَ<g>نَّ</><f>هُم بِ</>مَفَازَ<d>ةٍۢ مِّ</>نَ <h>ٱ</>لْعَذَابِ ۖ وَلَهُمْ عَذَابٌ أَ<p>لِي</>مٌۭ"},{"n":189,"w":[["وَلِلَّهِ","walillahi","And for Allah","এবং আল্লাহর জন্য"],["مُلْكُ","mul'ku","(is the) dominion","রাজত্ব"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশমন্ডলীর"],["وَٱلْأَرْضِ ۗ","wal-arḍi","and the earth","ও পৃথিবীর"],["وَٱللَّهُ","wal-lahu","and Allah","এবং আল্লাহ"],["عَلَىٰ","‘alā","(is) on","উপর"],["كُلِّ","kulli","every","সব"],["شَىْءٍۢ","shayin","thing","কিছুর"],["قَدِيرٌ","qadīrun","All-Powerful","ক্ষমতাবান"]],"t":"وَلِلَّهِ مُلْكُ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ ۗ وَ<h>ٱ</>للَّهُ عَلَىٰ كُلِّ <k>شَىْءٍۢ قَ</><p>دِي</>رٌ"},{"n":190,"w":[["إِنَّ","inna","Indeed","নিশ্চয়"],["فِى","fī","in","মধ্যে রয়েছে"],["خَلْقِ","khalqi","(the) creation","সৃষ্টির"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশ সমূহের"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীর"],["وَٱخْتِلَـٰفِ","wa-ikh'tilāfi","and (in the) alternation","ও আবর্তনে"],["ٱلَّيْلِ","al-layli","(of) the night","রাতের"],["وَٱلنَّهَارِ","wal-nahāri","and the day","এবং দিনের"],["لَـَٔايَـٰتٍۢ","laāyātin","(are) surely Signs","অবশ্যই নিদর্শন সমূহ"],["لِّأُو۟لِى","li-ulī","for men","জন্য"],["ٱلْأَلْبَـٰبِ","l-albābi","(of) understanding","বুদ্ধিমানদের"]],"t":"إِ<g>نَّ</> فِى خَلْقِ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ وَ<h>ٱ</>خْتِ<m>لَٰ</>فِ <h>ٱ</>لَّيْلِ وَ<h>ٱ</><l>ل</><g>نَّ</>هَارِ لَءَا<m>يَٰ</><w>تٍۢ لِّ</>أُ<s>و۟</>لِى <h>ٱ</>لْأَلْ<p>بَٰ</><q>بِ</>"},{"n":191,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["يَذْكُرُونَ","yadhkurūna","remember","স্মরণ করে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌কে"],["قِيَـٰمًۭا","qiyāman","standing","দাঁড়িয়ে"],["وَقُعُودًۭا","waqu‘ūdan","and sitting","ও বসে"],["وَعَلَىٰ","wa‘alā","and on","এবং উপর"],["جُنُوبِهِمْ","junūbihim","their sides","তাদের পার্শ্ব সমূহের (শুয়ে)"],["وَيَتَفَكَّرُونَ","wayatafakkarūna","and they reflect","আর তারা চিন্তা গবেষণা করে"],["فِى","fī","on","বিষয়ে"],["خَلْقِ","khalqi","(the) creation","সৃষ্টির"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশ মন্ডলীর"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীর"],["رَبَّنَا","rabbanā","Our Lord","''(তারা বলে) হে আমাদের রব"],["مَا","mā","not","না"],["خَلَقْتَ","khalaqta","You have created","তুমি সৃষ্টি করেছ"],["هَـٰذَا","hādhā","this","এটা"],["بَـٰطِلًۭا","bāṭilan","(in) vain","অর্থহীন"],["سُبْحَـٰنَكَ","sub'ḥānaka","Glory be to You","তুমিই পবিত্র"],["فَقِنَا","faqinā","so save us","অতঃপর আমাদেরকে বাঁচাও"],["عَذَابَ","‘adhāba","(from the) punishment","শাস্তি (হতে)"],["ٱلنَّارِ","l-nāri","(of) the Fire","আগুনের"]],"t":"ٱلَّذِينَ يَذْكُرُونَ <h>ٱ</>للَّهَ قِ<m>يَٰ</><d>مًۭا وَ</>قُعُو<d>دًۭا وَ</>عَلَىٰ جُنُوبِهِمْ وَيَتَفَكَّرُونَ فِى خَلْقِ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ رَبَّنَا مَا خَلَ<q>قْ</>تَ <m>هَٰ</>ذَا <m>بَٰ</>طِلًۭ<k>ا سُ</><q>بْ</><m>حَٰ</>نَكَ فَقِنَا عَذَابَ <h>ٱ</><l>ل</><g>نَّ</><p>ا</>رِ"},{"n":192,"w":[["رَبَّنَآ","rabbanā","Our Lord","হে আমাদের রব"],["إِنَّكَ","innaka","indeed [You]","নিশ্চয় তুমি"],["مَن","man","whom","যাকে"],["تُدْخِلِ","tud'khili","You admit","প্রবেশ করাও"],["ٱلنَّارَ","l-nāra","(to) the Fire","আগুনে"],["فَقَدْ","faqad","then surely","তাহলে নিশ্চয়"],["أَخْزَيْتَهُۥ ۖ","akhzaytahu","You (have) disgraced him","তাকে তুমি অপমান করলে"],["وَمَا","wamā","and not","এবং নাই"],["لِلظَّـٰلِمِينَ","lilẓẓālimīna","for the wrongdoers","জালিমদের জন্য"],["مِنْ","min","(are) any","কোন"],["أَنصَارٍۢ","anṣārin","helpers","সাহায্যকারী"]],"t":"رَبَّ<o>نَآ</> إِ<g>نَّ</>كَ مَ<k>ن تُ</><q>دْ</>خِلِ <h>ٱ</><l>ل</><g>نَّ</>ارَ فَقَ<q>دْ</> أَخْزَيْتَهُ<m>ۥ</> ۖ وَمَا لِل<m>ظَّٰ</>لِمِينَ مِنْ أَ<k>نصَ</><p>ا</>رٍۢ"},{"n":193,"w":[["رَّبَّنَآ","rabbanā","Our Lord","হে আমাদের রব"],["إِنَّنَا","innanā","indeed we","আমরা নিশ্চয়"],["سَمِعْنَا","sami‘'nā","[we] heard","আমরা শুনেছি"],["مُنَادِيًۭا","munādiyan","a caller","একজন আহ্বানকারীকে"],["يُنَادِى","yunādī","calling","আহ্বান করতে"],["لِلْإِيمَـٰنِ","lil'īmāni","to the faith","ঈমানের দিকে"],["أَنْ","an","that","(এ বলে) যে"],["ءَامِنُوا۟","āminū","Believe","''তোমরা ঈমান আন"],["بِرَبِّكُمْ","birabbikum","in your Lord","তোমাদের রবের প্রতি''"],["فَـَٔامَنَّا ۚ","faāmannā","so we have believed","ফলে আমরা ঈমান এনেছি"],["رَبَّنَا","rabbanā","Our Lord","হে আমাদের রব"],["فَٱغْفِرْ","fa-igh'fir","so forgive","অতএব মাফ কর"],["لَنَا","lanā","for us","আমাদের জন্য"],["ذُنُوبَنَا","dhunūbanā","our sins","আমাদের অপরাধগুলোকে"],["وَكَفِّرْ","wakaffir","and remove","ও দুর কর"],["عَنَّا","‘annā","from us","আমাদের থেকে"],["سَيِّـَٔاتِنَا","sayyiātinā","our evil deeds","আমাদের দোষত্রুটি"],["وَتَوَفَّنَا","watawaffanā","and cause us to die","এবং আমাদের মৃত্যু দাও"],["مَعَ","ma‘a","with","সাথে"],["ٱلْأَبْرَارِ","l-abrāri","the righteous","নেক লোকদের"]],"t":"رَّبَّ<o>نَآ</> إِ<g>نَّ</>نَا سَمِعْنَا مُنَادِ<d>يًۭا يُ</>نَادِى لِلْإِي<m>مَٰ</>نِ أَنْ ءَامِنُو<s>ا۟</> بِرَبِّكُمْ فَـَٔامَ<g>نَّ</>ا ۚ رَبَّنَا فَ<h>ٱ</>غْفِرْ لَنَا ذُنُوبَنَا وَكَفِّرْ عَ<g>نَّ</>ا سَيِّـَٔاتِنَا وَتَوَفَّنَا مَعَ <h>ٱ</>لْأَ<q>بْ</><p>رَا</>رِ"},{"n":194,"w":[["رَبَّنَا","rabbanā","Our Lord","হে আমাদের রব"],["وَءَاتِنَا","waātinā","grant us","আমাদেরকে দাও এবং"],["مَا","mā","what","যা"],["وَعَدتَّنَا","wa‘adttanā","You promised us","আমাদেরকে তুমি ওয়াদা করেছ"],["عَلَىٰ","‘alā","through","নিকট"],["رُسُلِكَ","rusulika","Your Messengers","তোমার রাসূলদের"],["وَلَا","walā","and (do) not","না এবং"],["تُخْزِنَا","tukh'zinā","disgrace us","আমাদেরকে অপমান করো"],["يَوْمَ","yawma","(on the) Day","দিন"],["ٱلْقِيَـٰمَةِ ۗ","l-qiyāmati","(of) [the] Resurrection","কিয়ামাতের"],["إِنَّكَ","innaka","Indeed, You","নিশ্চয় তুমি"],["لَا","lā","(do) not","না"],["تُخْلِفُ","tukh'lifu","break","খেলাফ কর"],["ٱلْمِيعَادَ","l-mī‘āda","the promise","ওয়াদার''"]],"t":"رَبَّنَا وَءَاتِنَا مَا وَعَ<j>د</>تَّنَا عَلَىٰ رُسُلِكَ وَلَا تُخْزِنَا يَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ ۗ إِ<g>نَّ</>كَ لَا تُخْلِفُ <h>ٱ</>لْمِي<p>عَا</><q>دَ</>"},{"n":195,"w":[["فَٱسْتَجَابَ","fa-is'tajāba","Then responded","তাই সাড়া দিলেন"],["لَهُمْ","lahum","to them","তাদেরকে"],["رَبُّهُمْ","rabbuhum","their Lord","তাদের রব"],["أَنِّى","annī","Indeed, I","''(এ বলে) যে আমি"],["لَآ","lā","(will) not","না"],["أُضِيعُ","uḍī‘u","(let go) waste","নষ্ট করব"],["عَمَلَ","‘amala","deeds","আমল"],["عَـٰمِلٍۢ","‘āmilin","(of the) doer","কোনো আমলকারীর"],["مِّنكُم","minkum","among you","তোমাদের মধ্যকার"],["مِّن","min","[from]","মধ্য হতে"],["ذَكَرٍ","dhakarin","(whether) male","পুরুষ (লোকদের)"],["أَوْ","aw","or","অথবা"],["أُنثَىٰ ۖ","unthā","female","স্ত্রী (লোকদের)"],["بَعْضُكُم","ba‘ḍukum","each of you","তোমাদের একে"],["مِّنۢ","min","from","হতে"],["بَعْضٍۢ ۖ","ba‘ḍin","(the) other","অন্যের (অর্থাত্‌ সমশ্রেণী ভুক্ত)"],["فَٱلَّذِينَ","fa-alladhīna","So those who","কাজেই যারা"],["هَاجَرُوا۟","hājarū","emigrated","হিজরত করেছে"],["وَأُخْرِجُوا۟","wa-ukh'rijū","and were driven out","ও বহিস্কৃত হয়েছে"],["مِن","min","from","হতে"],["دِيَـٰرِهِمْ","diyārihim","their homes","তাদের ঘরবাড়ি"],["وَأُوذُوا۟","waūdhū","and were harmed","এবং নির্যাতিত হয়েছে"],["فِى","fī","in","(মধ্যে)"],["سَبِيلِى","sabīlī","My way","আমার পথে"],["وَقَـٰتَلُوا۟","waqātalū","and fought","এবং তারা যুদ্ধ করেছে"],["وَقُتِلُوا۟","waqutilū","and were killed ","ও নিহত হয়েছে"],["لَأُكَفِّرَنَّ","la-ukaffiranna","surely I (will) remove","আমি অবশ্যই দূর করে দিবই"],["عَنْهُمْ","‘anhum","from them","তাদের থেকে"],["سَيِّـَٔاتِهِمْ","sayyiātihim","their evil deeds","তাদের দোষত্রুটি"],["وَلَأُدْخِلَنَّهُمْ","wala-ud'khilannahum","and surely I will admit them","এবং তাদেরকে অবশ্যই আমি প্রবেশ করাবই"],["جَنَّـٰتٍۢ","jannātin","(to) Gardens","জান্নাতে"],["تَجْرِى","tajrī","flowing","প্রবাহিত হয়"],["مِن","min","from","(থেকে)"],["تَحْتِهَا","taḥtihā","underneath them","তার পাদদেশে"],["ٱلْأَنْهَـٰرُ","l-anhāru","the rivers ","ঝর্নাধারা"],["ثَوَابًۭا","thawāban","a reward","প্রতিফল"],["مِّنْ","min","from","থেকে"],["عِندِ","‘indi","[near]","নিকট"],["ٱللَّهِ ۗ","l-lahi","Allah","আল্লাহ্‌র"],["وَٱللَّهُ","wal-lahu","And Allah ","এবং আল্লাহ (এমন যে)"],["عِندَهُۥ","‘indahu","with Him","তাঁরই কাছে (আছে)"],["حُسْنُ","ḥus'nu","(is the) best","উত্তম"],["ٱلثَّوَابِ","l-thawābi","reward","প্রতিফল''"]],"t":"فَ<h>ٱ</>سْتَجَابَ لَهُمْ رَبُّهُمْ أَ<g>نِّ</>ى <o>لَآ</> أُضِيعُ عَمَلَ <m>عَٰ</>مِ<d>لٍۢ مِّ</><k>نكُ</><y>م مِّ</><k>ن ذَ</>كَرٍ أَوْ أُ<k>نثَ</>ىٰ ۖ بَعْضُ<y>كُم مِّ</><i>نۢ بَ</>عْ<k>ضٍۢ ۖ فَ</><h>ٱ</>لَّذِينَ هَاجَرُو<s>ا۟</> وَأُخْرِجُو<s>ا۟</> مِ<k>ن دِ</><m>يَٰ</>رِهِمْ وَأُوذُو<s>ا۟</> فِى سَبِيلِى وَ<m>قَٰ</>تَلُو<s>ا۟</> وَقُتِلُو<s>ا۟</> لَأُكَفِّرَ<g>نَّ</> عَنْهُمْ سَيِّـَٔاتِهِمْ وَلَأُ<q>دْ</>خِلَ<g>نَّ</>هُمْ جَ<g>نَّٰ</><k>تٍۢ تَ</><q>جْ</>رِى مِ<k>ن تَ</>حْتِهَا <h>ٱ</>لْأَنْ<m>هَٰ</>رُ ثَوَا<d>بًۭا مِّ</>نْ عِ<k>ندِ</> <h>ٱ</>للَّهِ ۗ وَ<h>ٱ</>للَّهُ عِ<k>ندَ</>هُ<m>ۥ</> حُسْنُ <h>ٱ</><l>ل</>ثَّ<p>وَا</><q>بِ</>"},{"n":196,"w":[["لَا","lā","(Let) not","না  (যেন)"],["يَغُرَّنَّكَ","yaghurrannaka","deceive you","তোমাকে ধোঁকা দেয়"],["تَقَلُّبُ","taqallubu","(the) movement","(দম্ভপূর্ণ) চলাফেরা"],["ٱلَّذِينَ","alladhīna","(of) those who","(তাদের) যারা"],["كَفَرُوا۟","kafarū","disbelieved","কুফরী করেছে"],["فِى","fī","in","(মধ্যে)"],["ٱلْبِلَـٰدِ","l-bilādi","the land","দেশ দেশে"]],"t":"لَا يَغُرَّ<g>نَّ</>كَ تَقَلُّبُ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> فِى <h>ٱ</>لْبِ<p>لَٰ</><q>دِ</>"},{"n":197,"w":[["مَتَـٰعٌۭ","matā‘un","An enjoyment","(এটা) ভোগবিলাস ও ফূর্তি"],["قَلِيلٌۭ","qalīlun","little","অতি সামান্য"],["ثُمَّ","thumma","then","এরপর"],["مَأْوَىٰهُمْ","mawāhum","their abode","তাদের ঠিকানা (হবে)"],["جَهَنَّمُ ۚ","jahannamu","(is) hell ","জাহান্নাম"],["وَبِئْسَ","wabi'sa","[and] a wretched","এবং অতি নিকৃষ্ট"],["ٱلْمِهَادُ","l-mihādu","[the] resting place","বিশ্রামস্থল"]],"t":"مَ<m>تَٰ</><k>عٌۭ قَ</>لِي<k>لٌۭ ثُ</><g>مَّ</> مَأْوَ<m>ىٰ</>هُمْ جَهَ<g>نَّ</>مُ ۚ وَبِئْسَ <h>ٱ</>لْمِ<p>هَا</><q>دُ</>"},{"n":198,"w":[["لَـٰكِنِ","lākini","But","কিন্তু"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ٱتَّقَوْا۟","ittaqaw","fear","ভয় করে"],["رَبَّهُمْ","rabbahum","their Lord","তাদের রবকে"],["لَهُمْ","lahum","for them","তাদের জন্য (রয়েছে)"],["جَنَّـٰتٌۭ","jannātun","(will be) Gardens","জান্নাত সমূহ"],["تَجْرِى","tajrī","flows","প্রবাহিত হবে"],["مِن","min","from","(থেকে)"],["تَحْتِهَا","taḥtihā","underneath them","তার পাদদেশে"],["ٱلْأَنْهَـٰرُ","l-anhāru","the rivers","ঝর্নাধারা সমূহ"],["خَـٰلِدِينَ","khālidīna","will abide forever","তারা চিরস্থায়ী হবে"],["فِيهَا","fīhā","in it ","তার মধ্যে"],["نُزُلًۭا","nuzulan","a hospitality","মেহমানদারী (পাবে)"],["مِّنْ","min","from","হতে"],["عِندِ","‘indi","[near]","নিকট"],["ٱللَّهِ ۗ","l-lahi","Allah","আল্লাহ্‌র"],["وَمَا","wamā","And what","এবং যা কিছু"],["عِندَ","‘inda","(is) with","কাছে (রয়েছে)"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌র"],["خَيْرٌۭ","khayrun","(is) best","(তাই) উত্তম"],["لِّلْأَبْرَارِ","lil'abrāri","for the righteous","নেক লোকদের জন্য"]],"t":"<m>لَٰ</>كِنِ <h>ٱ</>لَّذِينَ <h>ٱ</>تَّقَوْ<s>ا۟</> رَبَّهُمْ لَهُمْ جَ<g>نَّٰ</><k>تٌۭ تَ</><q>جْ</>رِى مِ<k>ن تَ</>حْتِهَا <h>ٱ</>لْأَنْ<m>هَٰ</>رُ <m>خَٰ</>لِدِينَ فِيهَا نُزُلًۭ<d>ا مِّ</>نْ عِ<k>ندِ</> <h>ٱ</>للَّهِ ۗ وَمَا عِ<k>ندَ</> <h>ٱ</>للَّهِ خَيْ<w>رٌۭ لِّ</>لْأَ<q>بْ</><p>رَا</>رِ"},{"n":199,"w":[["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়"],["مِنْ","min","among","মধ্যে"],["أَهْلِ","ahli","(the) People","আহলি"],["ٱلْكِتَـٰبِ","l-kitābi","(of) the Book","কিতাবদের (এমনও আছে)"],["لَمَن","laman","(are those) who","অবশ্যই যে"],["يُؤْمِنُ","yu'minu","believe","ঈমান আনে"],["بِٱللَّهِ","bil-lahi","in Allah","আল্লাহ্‌র উপর"],["وَمَآ","wamā","and what","এবং যা"],["أُنزِلَ","unzila","was revealed","নাযিল হয়েছে"],["إِلَيْكُمْ","ilaykum","to you","তোমাদের প্রতি"],["وَمَآ","wamā","and what","যা এবং"],["أُنزِلَ","unzila","was revealed","নাযিল হয়েছে"],["إِلَيْهِمْ","ilayhim","to them ","তাদের প্রতি"],["خَـٰشِعِينَ","khāshi‘īna","humbly submissive","বিনয়ী হয়ে"],["لِلَّهِ","lillahi","to Allah","আল্লাহর জন্য"],["لَا","lā","Not","না"],["يَشْتَرُونَ","yashtarūna","(do) they exchange","তারা ক্রয় করে"],["بِـَٔايَـٰتِ","biāyāti","[with] (the) Verses","আয়াতের বিনিময়ে"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহ্‌র"],["ثَمَنًۭا","thamanan","(for) a price","মূল্যের (জিনিস)"],["قَلِيلًا ۗ","qalīlan","little","সামান্য"],["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব লোক"],["لَهُمْ","lahum","for them","তাদের জন্য (রয়েছে)"],["أَجْرُهُمْ","ajruhum","their reward","তাদের প্রতিফল"],["عِندَ","‘inda","(is) with","কাছে"],["رَبِّهِمْ ۗ","rabbihim","their Lord","তাদের রবের"],["إِنَّ","inna","Indeed","নিশ্চয়"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["سَرِيعُ","sarī‘u","(is) swift","ত্বরিত"],["ٱلْحِسَابِ","l-ḥisābi","(in taking) the account","হিসাব গ্রহণকারী"]],"t":"وَإِ<g>نَّ</> مِنْ أَهْلِ <h>ٱ</>لْكِ<m>تَٰ</>بِ لَ<d>مَن يُ</>ؤْمِنُ بِ<h>ٱ</>للَّهِ وَ<o>مَآ</> أُ<k>نزِ</>لَ إِلَيْكُمْ وَ<o>مَآ</> أُ<k>نزِ</>لَ إِلَيْهِمْ <m>خَٰ</>شِعِينَ لِلَّهِ لَا يَشْتَرُونَ بِـَٔا<m>يَٰ</>تِ <h>ٱ</>للَّهِ ثَمَ<k>نًۭا قَ</>لِيلًا ۗ أُ<s>و۟</><o>لَٰٓ</>ئِكَ لَهُمْ أَ<q>جْ</>رُهُمْ عِ<k>ندَ</> رَبِّهِمْ ۗ إِ<g>نَّ</> <h>ٱ</>للَّهَ سَرِيعُ <h>ٱ</>لْحِ<p>سَا</><q>بِ</>"},{"n":200,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you","ওহে"],["ٱلَّذِينَ","alladhīna","who","যারা"],["ءَامَنُوا۟","āmanū","believe[d]","ঈমান এনেছ"],["ٱصْبِرُوا۟","iṣ'birū","Be steadfast","তোমরা সবর কর"],["وَصَابِرُوا۟","waṣābirū","and [be] patient","ও ধৈর্যে দৃঢ় থাক"],["وَرَابِطُوا۟","warābiṭū","and [be] constant","এবং তোমরা প্রস্তুত থাক"],["وَٱتَّقُوا۟","wa-ittaqū","and fear","তোমরা ভয় কর এবং"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["لَعَلَّكُمْ","la‘allakum","so that you may","আশা করা যায়  তোমরা"],["تُفْلِحُونَ","tuf'liḥūna","(be) successful","সফলকাম হবে"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> <h>ٱ</>صْبِرُو<s>ا۟</> وَصَابِرُو<s>ا۟</> وَرَابِطُو<s>ا۟</> وَ<h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</>للَّهَ لَعَلَّكُمْ تُفْلِ<p>حُو</>نَ"}]}