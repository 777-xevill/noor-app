>كْفِيَكُمْ <d>أَن يُ</>مِدَّكُمْ رَبُّ<f>كُم بِ</>ثَ<m>لَٰ</>ثَةِ ءَا<m>لَٰ</><d>فٍۢ مِّ</>نَ <h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةِ مُ<k>نزَ</><p>لِي</>نَ"},{"n":125,"w":[["بَلَىٰٓ ۚ","balā","Yes","হ্যাঁ (নিশ্চয়)"],["إِن","in","if","যদি"],["تَصْبِرُوا۟","taṣbirū","you are patient","তোমরা সবর কর"],["وَتَتَّقُوا۟","watattaqū","and fear (Allah)","ও (আল্লাহ্‌কে) ভয় কর"],["وَيَأْتُوكُم","wayatūkum","and they come upon you","আর (যদি) তোমাদের উপর আসবে (চড়াও হয়ে)"],["مِّن","min","[of]","(থেকে)"],["فَوْرِهِمْ","fawrihim","suddenly","তাদের ত্বরিত গতিতে"],["هَـٰذَا","hādhā","[this]","এই (মুহূর্তে)"],["يُمْدِدْكُمْ","yum'did'kum","will reinforce you","তোমাদেরকে সাহায্য করবেন"],["رَبُّكُم","rabbukum","your Lord","তোমাদের রব"],["بِخَمْسَةِ","bikhamsati","with five","দিয়ে পাঁচ"],["ءَالَـٰفٍۢ","ālāfin","thousand[s]","সহস্র (ফেরেশতা)"],["مِّنَ","mina","[of]","মধ্য হতে"],["ٱلْمَلَـٰٓئِكَةِ","l-malāikati","[the] Angels","ফেরেশতাদের"],["مُسَوِّمِينَ","musawwimīna","[the ones] having marks","(যারা হবে) চিহ্ন যুক্ত"]],"t":"بَلَ<o>ىٰٓ ۚ</> إِ<k>ن تَ</>صْبِرُو<s>ا۟</> وَتَتَّقُو<s>ا۟</> وَيَأْتُو<y>كُم مِّ</><k>ن فَ</>وْرِهِمْ <m>هَٰ</>ذَا يُمْدِ<q>دْ</>كُمْ رَبُّ<f>كُم بِ</>خَمْسَةِ ءَا<m>لَٰ</><d>فٍۢ مِّ</>نَ <h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةِ مُسَوِّ<p>مِي</>نَ"},{"n":126,"w":[["وَمَا","wamā","And not","এবং না"],["جَعَلَهُ","ja‘alahu","made it","তা করেছিলেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["إِلَّا","illā","except","এছাড়া"],["بُشْرَىٰ","bush'rā","(as) good news","সুসংবাদ হিসেবে"],["لَكُمْ","lakum","for you","তোমাদের জন্য"],["وَلِتَطْمَئِنَّ","walitaṭma-inna","and to reassure","ও আশ্বস্ত করার জন্য"],["قُلُوبُكُم","qulūbukum","your hearts","তোমাদের অন্তরগুলো"],["بِهِۦ ۗ","bihi","with it","তা দিয়ে"],["وَمَا","wamā","And (there is) no","আর না"],["ٱلنَّصْرُ","l-naṣru","[the] victory","বিজয় (আসে)"],["إِلَّا","illā","except","এছাড়া"],["مِنْ","min","from","হতে"],["عِندِ","‘indi","[near]","নিকট"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌র"],["ٱلْعَزِيزِ","l-‘azīzi","the All-Mighty","পরাক্রমশালী"],["ٱلْحَكِيمِ","l-ḥakīmi","the All-Wise","মহাবিজ্ঞ"]],"t":"وَمَا جَعَلَهُ <h>ٱ</>للَّهُ إِلَّا بُشْرَىٰ لَكُمْ وَلِتَ<q>طْ</>مَئِ<g>نَّ</> قُلُوبُ<f>كُم بِ</><m>هِۦ</> ۗ وَمَا <h>ٱ</><l>ل</><g>نَّ</>صْرُ إِلَّا مِنْ عِ<k>ندِ</> <h>ٱ</>للَّهِ <h>ٱ</>لْعَزِيزِ <h>ٱ</>لْحَ<p>كِي</>مِ"},{"n":127,"w":[["لِيَقْطَعَ","liyaqṭa‘a","That He may cut off","কাটার জন্য"],["طَرَفًۭا","ṭarafan","a part","একটি অংশকে"],["مِّنَ","mina","of","মধ্য হতে"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["كَفَرُوٓا۟","kafarū","disbelieved","কুফরী করেছে"],["أَوْ","aw","or","অথবা"],["يَكْبِتَهُمْ","yakbitahum","suppress them","তাদের লাঞ্ছনা দেয়ার (জন্য)"],["فَيَنقَلِبُوا۟","fayanqalibū","so (that) they turn back","ফলে তারা ফিরে যাবে"],["خَآئِبِينَ","khāibīna","disappointed","ব্যর্থ হয়ে"]],"t":"لِيَ<q>قْ</>طَعَ طَرَ<d>فًۭا مِّ</>نَ <h>ٱ</>لَّذِينَ كَفَ<o>رُوٓ</><s>ا۟</> أَوْ يَكْبِتَهُمْ فَيَ<k>نقَ</>لِبُو<s>ا۟</> <o>خَآ</>ئِ<p>بِي</>نَ"},{"n":128,"w":[["لَيْسَ","laysa","Not","নাই"],["لَكَ","laka","for you","তোমার জন্য"],["مِنَ","mina","of","কোন"],["ٱلْأَمْرِ","l-amri","the decision","এখতিয়ার"],["شَىْءٌ","shayon","(of) anything","কোন কিছুরই"],["أَوْ","aw","whether","অথবা"],["يَتُوبَ","yatūba","He turns","তিনি মাফ করবেন"],["عَلَيْهِمْ","‘alayhim","to them","তাদেরকে"],["أَوْ","aw","or","অথবা"],["يُعَذِّبَهُمْ","yu‘adhibahum","punishes them","তাদেরকে আজাব দিবেন"],["فَإِنَّهُمْ","fa-innahum","for indeed, they","কেননা তারা নিশ্চয়"],["ظَـٰلِمُونَ","ẓālimūna","(are) wrongdoers","জালিম"]],"t":"لَيْسَ لَكَ مِنَ <h>ٱ</>لْأَمْرِ شَىْءٌ أَوْ يَتُوبَ عَلَيْهِمْ أَوْ يُعَذِّبَهُمْ فَإِ<g>نَّ</>هُمْ <m>ظَٰ</>لِ<p>مُو</>نَ"},{"n":129,"w":[["وَلِلَّهِ","walillahi","And to Allah (belongs)","এবং আল্লাহর জন্য"],["مَا","mā","what","যা (কিছু)"],["فِى","fī","(is) in","মধ্যে আছে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আসমান সমুহের"],["وَمَا","wamā","and what","আর যা কিছু"],["فِى","fī","(is) in","মধ্যে আছে"],["ٱلْأَرْضِ ۚ","l-arḍi","the earth","পৃথিবীর"],["يَغْفِرُ","yaghfiru","He forgives","তিনি মাফ করেন"],["لِمَن","liman","[for] whom","যাকে"],["يَشَآءُ","yashāu","He wills","তিনি ইচ্ছা করেন"],["وَيُعَذِّبُ","wayu‘adhibu","and punishes","ও তিনি আজাব দেন"],["مَن","man","whom","যাকে"],["يَشَآءُ ۚ","yashāu","He wills","তিনি ইচ্ছা করেন"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["غَفُورٌۭ","ghafūrun","(is) Oft-Forgiving","ক্ষমাশীল"],["رَّحِيمٌۭ","raḥīmun","Most Merciful","মেহেরবান"]],"t":"وَلِلَّهِ مَا فِى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَمَا فِى <h>ٱ</>لْأَرْضِ ۚ يَغْفِرُ لِ<d>مَن يَ</><o>شَآ</>ءُ وَيُعَذِّبُ <d>مَن يَ</><o>شَآ</>ءُ ۚ وَ<h>ٱ</>للَّهُ غَفُو<w>رٌۭ رَّ</><p>حِي</>مٌۭ"},{"n":130,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you","ওহে"],["ٱلَّذِينَ","alladhīna","who","যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছ"],["لَا","lā","(Do) not","না"],["تَأْكُلُوا۟","takulū","eat","তোমরা খেয়ো"],["ٱلرِّبَوٰٓا۟","l-riba","the usury","সুদ"],["أَضْعَـٰفًۭا","aḍ‘āfan","doubled","বহুগুণে"],["مُّضَـٰعَفَةًۭ ۖ","muḍā‘afatan","multiplied","গুণ করা (অর্থাৎ চক্রবৃদ্ধিহারে)"],["وَٱتَّقُوا۟","wa-ittaqū","And fear","এবং তোমরা ভয় কর"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["لَعَلَّكُمْ","la‘allakum","so that you may","আশা করা যায় তোমরা"],["تُفْلِحُونَ","tuf'liḥūna","(be) successful","কল্যাণ লাভ করবে"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> لَا تَأْكُلُو<s>ا۟</> <h>ٱ</><l>ل</>رِّبَ<s>وٰٓ</>ا۟ أَضْ<m>عَٰ</><d>فًۭا مُّ</><m>ضَٰ</>عَفَ<d>ةًۭ ۖ وَ</><h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</>للَّهَ لَعَلَّكُمْ تُفْلِ<p>حُو</>نَ"},{"n":131,"w":[["وَٱتَّقُوا۟","wa-ittaqū","And fear","এবং তোমরা আত্মরক্ষা কর"],["ٱلنَّارَ","l-nāra","the Fire","(সেই) আগুন হতে"],["ٱلَّتِىٓ","allatī","which","যা"],["أُعِدَّتْ","u‘iddat","is prepared","তৈরী করা হয়েছে"],["لِلْكَـٰفِرِينَ","lil'kāfirīna","for the disbelievers","কাফিরদের জন্য"]],"t":"وَ<h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</><l>ل</><g>نَّ</>ارَ <h>ٱ</>لَّ<o>تِىٓ</> أُعِدَّتْ لِلْ<m>كَٰ</>فِ<p>رِي</>نَ"},{"n":132,"w":[["وَأَطِيعُوا۟","wa-aṭī‘ū","And obey","এবং তোমরা আনুগত্য কর"],["ٱللَّهَ","l-laha","Allah","আল্লাহর"],["وَٱلرَّسُولَ","wal-rasūla","and the Messenger","ও রাসূলের"],["لَعَلَّكُمْ","la‘allakum","so that you may","আশা করা যায়"],["تُرْحَمُونَ","tur'ḥamūna","receive mercy","রহম করা হবে তোমাদেরকে"]],"t":"وَأَطِيعُو<s>ا۟</> <h>ٱ</>للَّهَ وَ<h>ٱ</><l>ل</>رَّسُولَ لَعَلَّكُمْ تُرْحَ<p>مُو</>نَ"},{"n":133,"w":[["۞ وَسَارِعُوٓا۟","wasāri‘ū","And hasten","এবং তোমরা দ্রুত আস"],["إِلَىٰ","ilā","to","দিকে"],["مَغْفِرَةٍۢ","maghfiratin","forgiveness","ক্ষমার"],["مِّن","min","from","পক্ষ হতে"],["رَّبِّكُمْ","rabbikum","your Lord","তোমাদের রবের"],["وَجَنَّةٍ","wajannatin","and a Garden ","ও জান্নাতের"],["عَرْضُهَا","‘arḍuhā","its width","যার প্রশস্ততা"],["ٱلسَّمَـٰوَٰتُ","l-samāwātu","(is like that of) the heavens","আসমান সমূহের"],["وَٱلْأَرْضُ","wal-arḍu","and the earth","ও জমিনের (সমান)"],["أُعِدَّتْ","u‘iddat","prepared","তৈরী করা হয়েছে"],["لِلْمُتَّقِينَ","lil'muttaqīna","for the pious","মুত্তাকীদের জন্য"]],"t":"۞ وَسَارِ<o>عُوٓ</><s>ا۟</> إِلَىٰ مَغْفِرَ<d>ةٍۢ مِّ</><w>ن رَّ</>بِّكُمْ وَجَ<g>نَّ</>ةٍ عَرْضُهَا <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تُ وَ<h>ٱ</>لْأَرْضُ أُعِدَّتْ لِلْمُتَّ<p>قِي</>نَ"},{"n":134,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["يُنفِقُونَ","yunfiqūna","spend","খরচ করে"],["فِى","fī","in","মধ্যে"],["ٱلسَّرَّآءِ","l-sarāi","[the] ease","খুশীর (স্বচ্ছল অবস্থায়)"],["وَٱلضَّرَّآءِ","wal-ḍarāi","and (in) the hardship","ও কষ্টে (দুরাবস্থায়)"],["وَٱلْكَـٰظِمِينَ","wal-kāẓimīna","and those who restrain","এবং দমনকারী"],["ٱلْغَيْظَ","l-ghayẓa","the anger","রাগ"],["وَٱلْعَافِينَ","wal-‘āfīna","and those who pardon","ও মাফকারী"],["عَنِ","‘ani","[from]","(প্রায়)"],["ٱلنَّاسِ ۗ","l-nāsi","the people ","লোকদের"],["وَٱللَّهُ","wal-lahu","and Allah","আর আল্লাহ"],["يُحِبُّ","yuḥibbu","loves","ভালোবাসেন"],["ٱلْمُحْسِنِينَ","l-muḥ'sinīna","the good-doers","নেক লোকদেরকে"]],"t":"ٱلَّذِينَ يُ<k>نفِ</>قُونَ فِى <h>ٱ</><l>ل</>سَّ<o>رَّآ</>ءِ وَ<h>ٱ</><l>ل</>ضَّ<o>رَّآ</>ءِ وَ<h>ٱ</>لْ<m>كَٰ</>ظِمِينَ <h>ٱ</>لْغَيْظَ وَ<h>ٱ</>لْعَافِينَ عَنِ <h>ٱ</><l>ل</><g>نَّ</>اسِ ۗ وَ<h>ٱ</>للَّهُ يُحِبُّ <h>ٱ</>لْمُحْسِ<p>نِي</>نَ"},{"n":135,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those","এবং যারা (এমন যে)"],["إِذَا","idhā","when","যখন"],["فَعَلُوا۟","fa‘alū","they did","তারা করে ফেলে"],["فَـٰحِشَةً","fāḥishatan","immorality","অশ্লীলতা"],["أَوْ","aw","or","অথবা"],["ظَلَمُوٓا۟","ẓalamū","wronged","যুলুম করে ফেলে"],["أَنفُسَهُمْ","anfusahum","themselves ","তাদের নিজেদের (উপর)"],["ذَكَرُوا۟","dhakarū","they remember","স্মরণ করে (তৎক্ষণাৎ)"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["فَٱسْتَغْفَرُوا۟","fa-is'taghfarū","then ask forgiveness","অতঃপর তারা মাফ চায়"],["لِذُنُوبِهِمْ","lidhunūbihim","for their sins ","তাদের গুনাহর জন্য"],["وَمَن","waman","and who","আর কে (আছে)"],["يَغْفِرُ","yaghfiru","(can) forgive","(এমন যে) মাফ করতে পারে"],["ٱلذُّنُوبَ","l-dhunūba","the sins","গুনাহ সমূহকে"],["إِلَّا","illā","except","ব্যতীত"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["وَلَمْ","walam","And not","এবং না"],["يُصِرُّوا۟","yuṣirrū","they persist","বাড়া বাড়ি করে"],["عَلَىٰ","‘alā","on","(তার) উপর"],["مَا","mā","what","যা"],["فَعَلُوا۟","fa‘alū","they did","তারা করে ফেলেছে"],["وَهُمْ","wahum","while they","যখন তারা"],["يَعْلَمُونَ","ya‘lamūna","know","জানেও"]],"t":"وَ<h>ٱ</>لَّذِينَ إِذَا فَعَلُو<s>ا۟</> <m>فَٰ</>حِشَةً أَوْ ظَلَ<o>مُوٓ</><s>ا۟</> أَ<k>نفُ</>سَهُمْ ذَكَرُو<s>ا۟</> <h>ٱ</>للَّهَ فَ<h>ٱ</>سْتَغْفَرُو<s>ا۟</> لِذُنُوبِهِمْ وَ<d>مَن يَ</>غْفِرُ <h>ٱ</><l>ل</>ذُّنُوبَ إِلَّا <h>ٱ</>للَّهُ وَلَمْ يُصِرُّو<s>ا۟</> عَلَىٰ مَا فَعَلُو<s>ا۟</> وَهُمْ يَعْلَ<p>مُو</>نَ"},{"n":136,"w":[["أُو۟لَـٰٓئِكَ","ulāika","Those ","(তারা) ঐসব লোক"],["جَزَآؤُهُم","jazāuhum","their reward","যাদেরে প্রতিফল (হলো)"],["مَّغْفِرَةٌۭ","maghfiratun","(is) forgiveness","ক্ষমা"],["مِّن","min","from","পক্ষ হতে"],["رَّبِّهِمْ","rabbihim","their Lord","তাদের রবের"],["وَجَنَّـٰتٌۭ","wajannātun","and Gardens","ও জান্নাত"],["تَجْرِى","tajrī","flows","প্রবাহিত হয়"],["مِن","min","from","(থেকে)"],["تَحْتِهَا","taḥtihā","underneath it","তার তলদেশে"],["ٱلْأَنْهَـٰرُ","l-anhāru","the rivers","ঝর্ণা সমূহ"],["خَـٰلِدِينَ","khāli