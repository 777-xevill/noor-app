তীর্ণ করেছেন"],["عَلَيْكَ","‘alayka","to you","তোমার উপর"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","কিতাব"],["مِنْهُ","min'hu","of it","তাতে কিছু আছে"],["ءَايَـٰتٌۭ","āyātun","(are) Verses","আয়াতসমূহ"],["مُّحْكَمَـٰتٌ","muḥ'kamātun","absolutely clear ","মুহকাম (সুদৃঢ়)"],["هُنَّ","hunna","they (are)","সেগুলো"],["أُمُّ","ummu","the foundation","জননী (মূল অংশ)"],["ٱلْكِتَـٰبِ","l-kitābi","(of) the Book","কিতাবের"],["وَأُخَرُ","wa-ukharu","and others","এবং অন্যগুলো"],["مُتَشَـٰبِهَـٰتٌۭ ۖ","mutashābihātun","(are) allegorical","মুতাশাবিহ (রূপক সদৃশ)"],["فَأَمَّا","fa-ammā","Then as for","সুতরাং"],["ٱلَّذِينَ","alladhīna","those","যারা"],["فِى","fī","in","মধ্যে (আছে)"],["قُلُوبِهِمْ","qulūbihim","their hearts","তাদের অন্তরে"],["زَيْغٌۭ","zayghun","(is) perversity ","বক্রতা"],["فَيَتَّبِعُونَ","fayattabi‘ūna","[so] they follow","ফলে তারা অনুসরণ করে"],["مَا","mā","what","(তার) যা"],["تَشَـٰبَهَ","tashābaha","(is) allegorical","মুতাশাবিহাতের ফলে (রূপক অর্থ দেয়)"],["مِنْهُ","min'hu","of it","তার মধ্যে"],["ٱبْتِغَآءَ","ib'tighāa","seeking","অনুসন্ধানে"],["ٱلْفِتْنَةِ","l-fit'nati","[the] discord","ফেতনা(বিরোধ)"],["وَٱبْتِغَآءَ","wa-ib'tighāa","and seeking","এবং অনুসন্ধানে"],["تَأْوِيلِهِۦ ۗ","tawīlihi","its interpretation","তার ব্যখ্যা"],["وَمَا","wamā","And not","এবং না"],["يَعْلَمُ","ya‘lamu","knows","কেউ জানে"],["تَأْوِيلَهُۥٓ","tawīlahu","its interpretation","তার ব্যখ্যা"],["إِلَّا","illā","except","ছাড়া"],["ٱللَّهُ ۗ","l-lahu","Allah","আল্লাহ"],["وَٱلرَّٰسِخُونَ","wal-rāsikhūna","And those firm","এবং (যারা) সুগভীর"],["فِى","fī","in","ব্যাপারে"],["ٱلْعِلْمِ","l-‘il'mi","[the] knowledge","জ্ঞানের"],["يَقُولُونَ","yaqūlūna","they say","তারা বলে"],["ءَامَنَّا","āmannā","We believe","আমরা বিশ্বাস করেছি"],["بِهِۦ","bihi","in it","তার উপর"],["كُلٌّۭ","kullun","All","সবই (এসেছে)"],["مِّنْ","min","(is)","থেকে"],["عِندِ","‘indi","from","নিকট"],["رَبِّنَا ۗ","rabbinā","our Lord","আমাদের রবের"],["وَمَا","wamā","And not","এবং না"],["يَذَّكَّرُ","yadhakkaru","will take heed","শিক্ষা নেয় (তা হতে)"],["إِلَّآ","illā","except","এছাড়া"],["أُو۟لُوا۟","ulū","men","লোকেরা"],["ٱلْأَلْبَـٰبِ","l-albābi","(of) understanding","বোধশক্তি সম্পন্ন"]],"t":"هُوَ <h>ٱ</>لَّ<o>ذِىٓ</> أَ<k>نزَ</>لَ عَلَيْكَ <h>ٱ</>لْكِ<m>تَٰ</>بَ مِنْهُ ءَا<m>يَٰ</><d>تٌۭ مُّ</>حْكَ<m>مَٰ</>تٌ هُ<g>نَّ</> أُ<g>مُّ</> <h>ٱ</>لْكِ<m>تَٰ</>بِ وَأُخَرُ مُتَ<m>شَٰبِهَٰ</><k>تٌۭ ۖ فَ</>أَ<g>مَّ</>ا <h>ٱ</>لَّذِينَ فِى قُلُوبِهِمْ زَيْ<k>غٌۭ فَ</>يَتَّبِعُونَ مَا تَ<m>شَٰ</>بَهَ مِنْهُ <h>ٱ</><q>بْ</>تِ<o>غَآ</>ءَ <h>ٱ</>لْفِتْنَةِ وَ<h>ٱ</><q>بْ</>تِ<o>غَآ</>ءَ تَأْوِيلِ<m>هِۦ</> ۗ وَمَا يَعْلَمُ تَأْوِيلَهُ<o>ۥٓ</> إِلَّا <h>ٱ</>للَّهُ ۗ وَ<h>ٱ</><l>ل</><m>رَّٰ</>سِخُونَ فِى <h>ٱ</>لْعِلْمِ يَقُولُونَ ءَامَ<g>نَّ</>ا بِ<m>هِۦ</> كُ<d>لٌّۭ مِّ</>نْ عِ<k>ندِ</> رَبِّنَا ۗ وَمَا يَذَّكَّرُ إِ<o>لَّآ</> أُ<s>و۟</>لُو<s>ا۟</> <h>ٱ</>لْأَلْ<p>بَٰ</><q>بِ</>"},{"n":8,"w":[["رَبَّنَا","rabbanā","Our Lord","(তারা বলে) হে আমাদের রব"],["لَا","lā","(Do) not","না"],["تُزِغْ","tuzigh","deviate","বাঁকা করো"],["قُلُوبَنَا","qulūbanā","our hearts","আমাদের অন্তরগুলো"],["بَعْدَ","ba‘da","after","এর পরে"],["إِذْ","idh","[when]","যখন"],["هَدَيْتَنَا","hadaytanā","You (have) guided us","আমাদের পথ প্রদর্শন করেছ তুমি"],["وَهَبْ","wahab","and grant","এবং দাও"],["لَنَا","lanā","(for) us","আমাদের জন্য"],["مِن","min","from","থেকে"],["لَّدُنكَ","ladunka","Yourself","তোমার নিকট"],["رَحْمَةً ۚ","raḥmatan","mercy","দয়া"],["إِنَّكَ","innaka","Indeed You","তুমি নিশ্চয়ই"],["أَنتَ","anta","You","তুমিই"],["ٱلْوَهَّابُ","l-wahābu","(are) the Bestower","মহাদাতা"]],"t":"رَبَّنَا لَا تُزِغْ قُلُوبَنَا بَعْدَ إِذْ هَدَيْتَنَا وَهَ<q>بْ</> لَنَا <w>مِن لَّ</>دُ<k>نكَ</> رَحْمَةً ۚ إِ<g>نَّ</>كَ أَ<k>نتَ</> <h>ٱ</>لْوَ<p>هَّا</><q>بُ</>"},{"n":9,"w":[["رَبَّنَآ","rabbanā","Our Lord","(তারা বলে) হে আমাদের রব"],["إِنَّكَ","innaka","Indeed, You","তুমি নিশ্চয়ই"],["جَامِعُ","jāmi‘u","will gather","সমবেতকারী"],["ٱلنَّاسِ","l-nāsi","[the] mankind","মানুষদের"],["لِيَوْمٍۢ","liyawmin","on a Day","সে দিনের"],["لَّا","lā","(there is) no","নেই (যাতে)"],["رَيْبَ","rayba","doubt","কোনো সন্দেহ"],["فِيهِ ۚ","fīhi","in it","তার মধ্যে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَا","lā","(does) not","না"],["يُخْلِفُ","yukh'lifu","break","ব্যতিক্রম করেন"],["ٱلْمِيعَادَ","l-mī‘āda","the Promise","প্রতিশ্রুতির"]],"t":"رَبَّ<o>نَآ</> إِ<g>نَّ</>كَ جَامِعُ <h>ٱ</><l>ل</><g>نَّ</>اسِ لِيَوْ<w>مٍۢ لَّ</>ا رَيْبَ فِيهِ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ لَا يُخْلِفُ <h>ٱ</>لْمِي<p>عَا</><q>دَ</>"},{"n":10,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieve[d]","অস্বীকার করেছে"],["لَن","lan","never","কখনও না"],["تُغْنِىَ","tugh'niya","will avail","উপকার দিবে"],["عَنْهُمْ","‘anhum","[for] them","তাদের জন্য"],["أَمْوَٰلُهُمْ","amwāluhum","their wealth","তাদের ধনসম্পদগুলো"],["وَلَآ","walā","and not","আর না"],["أَوْلَـٰدُهُم","awlāduhum","their children","সন্তানাদি তাদের"],["مِّنَ","mina","against","কাছে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["شَيْـًۭٔا ۖ","shayan","anything","কিছুমাত্রই"],["وَأُو۟لَـٰٓئِكَ","wa-ulāika","and those ","এবং ঐসব লোক"],["هُمْ","hum","they (are)","তারাই (হবে)"],["وَقُودُ","waqūdu","(the) fuel","ইন্ধন"],["ٱلنَّارِ","l-nāri","(for) the Fire","আগুনের (দোজখের)"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> لَ<k>ن تُ</>غْنِىَ عَنْهُمْ أَمْ<m>وَٰ</>لُهُمْ وَ<o>لَآ</> أَوْ<m>لَٰ</>دُ<y>هُم مِّ</>نَ <h>ٱ</>للَّهِ شَ<d>يْـًۭٔا ۖ وَ</>أُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمْ وَقُودُ <h>ٱ</><l>ل</><g>نَّ</><p>ا</>رِ"},{"n":11,"w":[["كَدَأْبِ","kadabi","Like behavior","পরিণতি মতো (হয়েছে)"],["ءَالِ","āli","(of the) people","সম্প্রদায়ের"],["فِرْعَوْنَ","fir'‘awna","(of) Firaun","ফিরআউনের"],["وَٱلَّذِينَ","wa-alladhīna","and those who","এবং যারা"],["مِن","min","(were) from","(থেকে)"],["قَبْلِهِمْ ۚ","qablihim","before them","তাদের পূর্ব থেকে (ছিল)"],["كَذَّبُوا۟","kadhabū","They denied","তারা অস্বীকার করেছিল"],["بِـَٔايَـٰتِنَا","biāyātinā","Our Signs","আমাদের নিদর্শনগুলোর প্রতি"],["فَأَخَذَهُمُ","fa-akhadhahumu","so seized them","অতঃপর ধরলেন তাদেরকে"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["بِذُنُوبِهِمْ ۗ","bidhunūbihim","for their sins","তাদের পাপের কারণে"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["شَدِيدُ","shadīdu","(is) severe","বড় কঠোর"],["ٱلْعِقَابِ","l-‘iqābi","(in) [the] punishment","শাস্তিদানে"]],"t":"كَدَأْبِ ءَالِ فِرْعَوْنَ وَ<h>ٱ</>لَّذِينَ مِ<k>ن قَ</><q>بْ</>لِهِمْ ۚ كَذَّبُو<s>ا۟</> بِـَٔا<m>يَٰ</>تِنَا فَأَخَذَهُمُ <h>ٱ</>للَّهُ بِذُنُوبِهِمْ ۗ وَ<h>ٱ</>للَّهُ شَدِيدُ <h>ٱ</>لْعِ<p>قَا</><q>بِ</>"},{"n":12,"w":[["قُل","qul","Say","বলো তুমি"],["لِّلَّذِينَ","lilladhīna","to those who","তাদের উদ্দেশে (যারা)"],["كَفَرُوا۟","kafarū","disbelieve[d]","অস্বীকার করেছে"],["سَتُغْلَبُونَ","satugh'labūna","You will be overcome","শীঘ্রই তোমাদের পরাজিত হবে"],["وَتُحْشَرُونَ","watuḥ'sharūna","and you will be gathered","ও তোমাদের একত্র করা হবে"],["إِلَىٰ","ilā","to","দিকে"],["جَهَنَّمَ ۚ","jahannama","Hell","জাহান্নামের"],["وَبِئْسَ","wabi'sa","[and] an evil","এবং (তা) অতিনিকৃষ্ট"],["ٱلْمِهَادُ","l-mihādu","[the] resting place","আবাসস্থল"]],"t":"قُل لِّلَّذِينَ كَفَرُو<s>ا۟</> سَتُغْلَبُونَ وَتُحْشَرُونَ إِلَىٰ جَهَ<g>نَّ</>مَ ۚ وَبِئْسَ <h>ٱ</>لْمِ<p>هَا</><q>دُ</>"},{"n":13,"w":[["قَدْ","qad","Surely","নিশ্চয়ই"],["كَانَ","kāna","it was","রয়েছে"],["لَكُمْ","lakum","for you","তোমাদের জন্য"],["ءَايَةٌۭ","āyatun","a sign","নিদর্শন"],["فِى","fī","in","মধ্যে"],["فِئَتَيْنِ","fi-atayni","(the) two hosts","দুই দলের"],["ٱلْتَقَتَا ۖ","l-taqatā","which met ","সম্মুখীন হয়েছিল পরস্পর (বদরের যুদ্ধে)"],["فِئَةٌۭ","fi-atun","one group","একদল"],["تُقَـٰتِلُ","tuqātilu","fighting","লড়াই করেছে"],["فِى","fī","in","মধ্যে"],["سَبِيلِ","sabīli","(the) way","পথের"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَأُخْرَىٰ","wa-ukh'rā","and another","এবং অন্যটি"],["كَافِرَةٌۭ","kāfiratun","disbelievers","কাফির"],["يَرَوْنَهُم","yarawnahum","They were seeing them","তাদেরকে তারা(মুসলিমদেরকে) দেখে"],["مِّثْلَيْهِمْ","mith'layhim","twice of them","তাদের দ্বিগুণ"],["رَأْىَ","raya","with the sight","(দেখ)"],["ٱلْعَيْنِ ۚ","l-‘ayni","(of) their eyes","চাক্ষুসভাবে"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["يُؤَيِّدُ","yu-ayyidu","supports","শক্তিশালী করেন"],["بِنَصْرِهِۦ","binaṣrihi","with His help","তাঁর সাহায্য দিয়ে"],["مَن","man","whom","যাকে"],["يَشَآءُ ۗ","yashāu","He wills","তিনি চান"],["إِنَّ","inna","Indeed","নিশ্চয়"],["فِى","fī","in","মধ্যে (আছে)"],["ذَٰلِكَ","dhālika","that","এর"],["لَعِبْرَةًۭ","la‘ib'ratan","surely (is) a lesson","শিক্ষা অবশ্যই"],["لِّأُو۟لِى","li-ulī","for the owners","জন্য"],["ٱلْأَبْصَـٰرِ","l-abṣāri","(of) vision","অন্তর্দৃষ্টি সম্পন্নদের"]],"t":"قَ<q>دْ</> كَانَ لَكُمْ ءَايَ<k>ةٌۭ فِ</>ى فِئَتَيْنِ <h>ٱ</><l>لْ</>تَقَتَا ۖ فِئَ<k>ةٌۭ تُ</><m>قَٰ</>تِلُ فِى سَبِيلِ <h>ٱ</>للَّهِ وَأُخْرَىٰ كَافِرَ<d>ةٌۭ يَ</>رَوْنَ<y>هُم مِّ</>ثْلَيْهِمْ رَأْىَ <h>ٱ</>لْعَيْنِ ۚ وَ<h>ٱ</>للَّهُ يُؤَيِّدُ بِنَصْرِ<m>هِۦ</> <d>مَن يَ</><o>شَآ</>ءُ ۗ إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَعِ<q>بْ</>رَ<w>ةًۭ لِّ</>أُ<s>و۟</>لِى <h>ٱ</>لْأَ<q>بْ</><p>صَٰ</>رِ"},{"n":14,"w":[["زُيِّنَ","zuyyina","Beautified","মনোরম করা হয়েছে"],["لِلنَّاسِ","lilnnāsi","for mankind","লোকদের জন্য"],["حُبُّ","ḥubbu","(is) love","আসক্তি"],["ٱلشَّهَوَٰتِ","l-shahawāti","(of) the (things they) desire ","কামনার"],["مِنَ","mina","of","হতে"],["ٱلنِّسَآءِ","l-nisāi","[the] women","নারীদের"],["وَٱلْبَنِينَ","wal-banīna","and [the] sons","ও সন্তানাদির"],["وَٱلْقَنَـٰطِيرِ","wal-qanāṭīri","and [the] heaps","এবং স্তুপ"],["ٱلْمُقَنطَرَةِ","l-muqanṭarati","[the] stored up","রাশিকৃত"],["مِنَ","mina","of","(থেকে)"],["ٱلذَّهَبِ","l-dhahabi","[the] gold","সোনার"],["وَٱلْفِضَّةِ","wal-fiḍati","and [the] silver","ও রূপার"],["وَٱلْخَيْلِ","wal-khayli","and [the] horses","ও ঘোড়ার"],["ٱلْمُسَوَّمَةِ","l-musawamati","[the] branded","(যা) চিহ্নিত"],["وَٱلْأَنْعَـٰمِ","wal-an‘āmi","and [the] cattle","ও গবাদিপশুর"],["وَٱلْحَرْثِ ۗ","wal-ḥarthi","and [the] tilled land","এবং ক্ষেতখামারে"],["ذَٰلِكَ","dhālika","That","এটা"],["مَتَـٰعُ","matā‘u","(is) provision","ভোগসামগ্রী"],["ٱلْحَيَوٰةِ","l-ḥayati","(of) life","জীবনের"],["ٱلدُّنْيَا ۖ","l-dun'yā","(of) the world","দুনিয়ার"],["وَٱللَّهُ","wal-lahu","but Allah ","কিন্তু আল্লাহ (এমন সত্তা)"],["عِندَهُۥ","‘indahu","with Him","যার কাছে আছে"],["حُسْنُ","ḥus'nu","(is an) excellent","উত্তম"],["ٱلْمَـَٔابِ","l-maābi","[the] abode to return","আশ্রয়স্থল"]],"t":"زُيِّنَ لِل<g>نَّ</>اسِ حُبُّ <h>ٱ</><l>ل</>شَّهَ<m>وَٰ</>تِ مِنَ <h>ٱ</><l>ل</><g>نِّ</><o>سَآ</>ءِ وَ<h>ٱ</>لْبَنِينَ وَ<h>ٱ</>لْقَ<m>نَٰ</>طِيرِ <h>ٱ</>لْمُقَ<k>نطَ</>رَةِ مِنَ <h>ٱ</><l>ل</>ذَّهَبِ وَ<h>ٱ</>لْفِضَّةِ وَ<h>ٱ</>لْخَيْلِ <h>ٱ</>لْمُسَوَّمَةِ وَ<h>ٱ</>لْأَنْ<m>عَٰ</>مِ وَ<h>ٱ</>لْحَرْثِ ۗ <m>ذَٰ</>لِكَ مَ<m>تَٰ</>عُ <h>ٱ</>لْحَيَ<s>وٰ</>ةِ <h>ٱ</><l>ل</>دُّنْيَا ۖ وَ<h>ٱ</>للَّهُ عِ<k>ندَ</>هُ<m>ۥ</> حُسْنُ <h>ٱ</>لْمَـَٔ<p>ا</><q>بِ</>"},{"n":15,"w":[["۞ قُلْ","qul","Say","তুমি বল"],["أَؤُنَبِّئُكُم","a-unabbi-ukum","Shall I inform you","''তোমাদেরকে আমি বলে দেব কি"],["بِخَيْرٍۢ","bikhayrin","of better","উত্তম (জিনিসের কথা)"],["مِّن","min","than","অপেক্ষা"],["ذَٰلِكُمْ ۚ","dhālikum","that","এসব,"],["لِلَّذِينَ","lilladhīna","For those who","(তাদের) জন্য যারা"],["ٱتَّقَوْا۟","ittaqaw","fear[ed]","তাকওয়া অবলম্বন করেছে"],["عِندَ","‘inda","with","কাছে"],["رَبِّهِمْ","rabbihim","their Lord","তাদের রবের (রয়েছে)"],["جَنَّـٰتٌۭ","jannātun","(are) Gardens","জান্নাত"],["تَجْرِى","tajrī","flows","প্রবাহিত হয়"],["مِن","min","from","হতে"],["تَحْتِهَا","taḥtihā","underneath them","তার পাদদেশ"],["ٱلْأَنْهَـٰرُ","l-anhāru","[the] rivers ","ঝর্ণাধারা"],["خَـٰلِدِينَ","khālidīna","abiding forever","তারা চিরস্থায়ী হবে"],["فِيهَا","fīhā","in it","তার মধ্যে"],["وَأَزْوَٰجٌۭ","wa-azwājun","and spouses","এবং স্ত্রীসমূহ (রয়েছে)"],["مُّطَهَّرَةٌۭ","muṭahharatun","pure","পবিত্র"],["وَرِضْوَٰنٌۭ","wariḍ'wānun","and approval","এবং সন্তুষ্টি"],["مِّنَ","mina","from","পক্ষ হতে"],["ٱللَّهِ ۗ","l-lahi","Allah","আল্লাহর"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["بَصِيرٌۢ","baṣīrun","(is) All-Seer","খুব দৃষ্টি রাখেন"],["بِٱلْعِبَادِ","bil-‘ibādi","of (His) slaves","বান্দাদের উপর''"]],"t":"۞ قُلْ أَؤُنَبِّئُ<f>كُم بِ</>خَيْ<d>رٍۢ مِّ</><k>ن ذَٰ</>لِكُمْ ۚ لِلَّذِينَ <h>ٱ</>تَّقَوْ<s>ا۟</> عِ<k>ندَ</> رَبِّهِمْ جَ<g>نَّٰ</><k>تٌۭ تَ</><q>جْ</>رِى مِ<k>ن تَ</>حْتِهَا <h>ٱ</>لْأَنْ<m>هَٰ</>رُ <m>خَٰ</>لِدِينَ فِيهَا وَأَزْ<m>وَٰ</><d>جٌۭ مُّ</>طَهَّرَ<d>ةٌۭ وَ</>رِضْ<m>وَٰ</><d>نٌۭ مِّ</>نَ <h>ٱ</>للَّهِ ۗ وَ<h>ٱ</>للَّهُ بَصِي<i>رٌۢ بِ</><h>ٱ</>لْعِ<p>بَا</><q>دِ</>"},{"n":16,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["يَقُولُونَ","yaqūlūna","say","বলে"],["رَبَّنَآ","rabbanā","Our Lord","''হে আমাদের রব"],["إِنَّنَآ","innanā","Indeed, we","নিশ্চয়ই আমরা"],["ءَامَنَّا","āmannā","(have) believed","আমরা ঈমান এনেছি"],["فَٱغْفِرْ","fa-igh'fir","so forgive","অতএব ক্ষমা কর"],["لَنَا","lanā","for us","আমাদের"],["ذُنُوبَنَا","dhunūbanā","our sins","আমাদের গুনাহগুলোকে"],["وَقِنَا","waqinā","and save us","এবং বাঁচাও আমাদের"],["عَذَابَ","‘adhāba","(from) punishment","শাস্তি (হতে)"],["ٱلنَّارِ","l-nāri","(of) the Fire","জাহান্নামের''"]],"t":"ٱلَّذِينَ يَقُولُونَ رَبَّ<o>نَآ</> إِ<g>نَّ</><o>نَآ</> ءَامَ<g>نَّ</>ا فَ<h>ٱ</>غْفِرْ لَنَا ذُنُوبَنَا وَقِنَا عَذَابَ <h>ٱ</><l>ل</><g>نَّ</><p>ا</>رِ"},{"n":17,"w":[["ٱلصَّـٰبِرِينَ","al-ṣābirīna","The patient","(তারা হবে) ধৈর্য্যশীল"],["وَٱلصَّـٰدِقِينَ","wal-ṣādiqīna","and the truthful","ও সত্যবাদী-সত্যপন্থী"],["وَٱلْقَـٰنِتِينَ","wal-qānitīna","and the obedient","ও বিনীত-অনুগত"],["وَٱلْمُنفِقِينَ","wal-munfiqīna","and those who spend","ও দাতা"],["وَٱلْمُسْتَغْفِرِينَ","wal-mus'taghfirīna","and those who seek forgiveness","এবং ক্ষমাপ্রার্থী"],["بِٱلْأَسْحَارِ","bil-asḥāri","[in the] before dawn","রাতের শেষপ্রান্তে"]],"t":"ٱ<l>ل</><m>صَّٰ</>بِرِينَ وَ<h>ٱ</><l>ل</><m>صَّٰ</>دِقِينَ وَ<h>ٱ</>لْ<m>قَٰ</>نِتِينَ وَ<h>ٱ</>لْمُ<k>نفِ</>قِينَ وَ<h>ٱ</>لْمُسْتَغْفِرِينَ بِ<h>ٱ</>لْأَسْ<p>حَا</>رِ"},{"n":18,"w":[["شَهِدَ","shahida","Bears witness","সাক্ষী দিচ্ছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["أَنَّهُۥ","annahu","that [He]","তিনি নিশ্চয় (এমন যে)"],["لَآ","lā","(there i