َنتُمُ","wa-antumu","and you (will be)","এবং তোমরাই"],["ٱلْأَعْلَوْنَ","l-a‘lawna","[the] superior","সমুন্নত হবে (বিজয়ী হবে)"],["إِن","in","if","যদি"],["كُنتُم","kuntum","you are","তোমরা হও"],["مُّؤْمِنِينَ","mu'minīna","believers","ঈমানদার"]],"t":"وَلَا تَهِنُو<s>ا۟</> وَلَا تَحْزَنُو<s>ا۟</> وَأَ<k>نتُ</>مُ <h>ٱ</>لْأَعْلَوْنَ إِ<k>ن كُنتُ</><y>م مُّ</>ؤْمِ<p>نِي</>نَ"},{"n":140,"w":[["إِن","in","If","যদিও"],["يَمْسَسْكُمْ","yamsaskum","touched you","তোমাদের স্পর্শ করেছে (ওহুদে)"],["قَرْحٌۭ","qarḥun","a wound","আঘাত"],["فَقَدْ","faqad","so certainly","তবে নিশ্চয়"],["مَسَّ","massa","(has) touched","স্পর্শ করেছিল"],["ٱلْقَوْمَ","l-qawma","the people","(ঐ সব) লোকদেরও"],["قَرْحٌۭ","qarḥun","wound","আঘাত (বদরে)"],["مِّثْلُهُۥ ۚ","mith'luhu","like it","এর মত"],["وَتِلْكَ","watil'ka","And this","আর এই"],["ٱلْأَيَّامُ","l-ayāmu","[the] days","দিনগুলো"],["نُدَاوِلُهَا","nudāwiluhā","We alternate them","তা আবর্তিত করি আমরা"],["بَيْنَ","bayna","among","মাঝে"],["ٱلنَّاسِ","l-nāsi","the people","লোকদের"],["وَلِيَعْلَمَ","waliya‘lama","[and] so that makes evident","এবং জানেন যেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["ءَامَنُوا۟","āmanū","believe[d]","(প্রকৃত) ঈমান এনেছে"],["وَيَتَّخِذَ","wayattakhidha","and take","ও গ্রহণ করেন"],["مِنكُمْ","minkum","from you","তোমাদের মধ্যে কতককে"],["شُهَدَآءَ ۗ","shuhadāa","martyrs","(সত্যের সাক্ষ্য) শহীদ হিসেবে"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["لَا","lā","(does) not","না"],["يُحِبُّ","yuḥibbu","love","ভালোবাসেন"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","জালিমমদেরকে"]],"t":"<d>إِن يَ</>مْسَسْكُمْ قَرْ<k>حٌۭ فَ</>قَ<q>دْ</> مَسَّ <h>ٱ</>لْقَوْمَ قَرْ<d>حٌۭ مِّ</>ثْلُهُ<m>ۥ</> ۚ وَتِلْكَ <h>ٱ</>لْأَيَّامُ نُدَاوِلُهَا بَيْنَ <h>ٱ</><l>ل</><g>نَّ</>اسِ وَلِيَعْلَمَ <h>ٱ</>للَّهُ <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَيَتَّخِذَ مِ<k>نكُ</>مْ شُهَ<o>دَآ</>ءَ ۗ وَ<h>ٱ</>للَّهُ لَا يُحِبُّ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":141,"w":[["وَلِيُمَحِّصَ","waliyumaḥḥiṣa","And so that may purify","এবং যেন ছেঁটে বাছাই করেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["وَيَمْحَقَ","wayamḥaqa","and destroy","এবং চূর্ণ করেন (যেন)"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","the disbelievers","কাফিরদেরকে"]],"t":"وَلِيُمَحِّصَ <h>ٱ</>للَّهُ <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَيَمْحَقَ <h>ٱ</>لْ<m>كَٰ</>فِ<p>رِي</>نَ"},{"n":142,"w":[["أَمْ","am","Or","কি"],["حَسِبْتُمْ","ḥasib'tum","do you think","তোমরা ধারণা করেছ"],["أَن","an","that","যে"],["تَدْخُلُوا۟","tadkhulū","you will enter","তোমরা প্রবেশ করবে"],["ٱلْجَنَّةَ","l-janata","Paradise","জান্নাতে"],["وَلَمَّا","walammā","while has not yet","অথচ (এখনও) না"],["يَعْلَمِ","ya‘lami","made evident","জেনেছেন (অর্থাৎ বাস্তবে দেখেননি)"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["جَـٰهَدُوا۟","jāhadū","strove hard","জিহাদ করেছে"],["مِنكُمْ","minkum","among you","তোমাদের মধ্যে"],["وَيَعْلَمَ","waya‘lama","and made evident","এবং তিনি জানেন"],["ٱلصَّـٰبِرِينَ","l-ṣābirīna","the steadfast","ধৈর্যশীলদেরকে"]],"t":"أَمْ حَسِ<q>بْ</>تُمْ أَ<k>ن تَ</><q>دْ</>خُلُو<s>ا۟</> <h>ٱ</>لْجَ<g>نَّ</>ةَ وَلَ<g>مَّ</>ا يَعْلَمِ <h>ٱ</>للَّهُ <h>ٱ</>لَّذِينَ <m>جَٰ</>هَدُو<s>ا۟</> مِ<k>نكُ</>مْ وَيَعْلَمَ <h>ٱ</><l>ل</><m>صَّٰ</>بِ<p>رِي</>نَ"},{"n":143,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়"],["كُنتُمْ","kuntum","you used to","তোমরা"],["تَمَنَّوْنَ","tamannawna","wish","কামনা করছিলে"],["ٱلْمَوْتَ","l-mawta","(for) death","মৃত্যুর"],["مِن","min","from","(থেকে)"],["قَبْلِ","qabli","before","ইতিপূর্বে"],["أَن","an","[that]","(যে)"],["تَلْقَوْهُ","talqawhu","you met it","তার সাক্ষাৎ পেতে"],["فَقَدْ","faqad","then indeed","অতঃপর নিশ্চয়"],["رَأَيْتُمُوهُ","ra-aytumūhu","you have seen it","তা তোমরা দেখছ"],["وَأَنتُمْ","wa-antum","while you (were)","এবং তোমরা"],["تَنظُرُونَ","tanẓurūna","looking on","প্রত্যক্ষ করছ"]],"t":"وَلَقَ<q>دْ</> كُ<k>نتُ</>مْ تَمَ<g>نَّ</>وْنَ <h>ٱ</>لْمَوْتَ مِ<k>ن قَ</><q>بْ</>لِ أَ<k>ن تَ</>لْقَوْهُ فَقَ<q>دْ</> رَأَيْتُمُوهُ وَأَ<k>نتُ</>مْ تَ<k>نظُ</><p>رُو</>نَ"},{"n":144,"w":[["وَمَا","wamā","And not","এবং নয়"],["مُحَمَّدٌ","muḥammadun","(is) Muhammad ","মুহাম্মদ (সাঃ)"],["إِلَّا","illā","except","এছাড়া"],["رَسُولٌۭ","rasūlun","a Messenger","একজন রাসূল"],["قَدْ","qad","certainly","নিশ্চয়"],["خَلَتْ","khalat","passed away","অতীত হয়েছে"],["مِن","min","from","(থেকে)"],["قَبْلِهِ","qablihi","before him","তাঁর পূর্বে"],["ٱلرُّسُلُ ۚ","l-rusulu","[the] (other) Messengers","(অনেক) রাসূল"],["أَفَإِي۟ن","afa-in","So if","কি তবে যদি"],["مَّاتَ","māta","he died","সে মারা যায়"],["أَوْ","aw","or","বা"],["قُتِلَ","qutila","is slain","নিহত হয়"],["ٱنقَلَبْتُمْ","inqalabtum","will you turn back","তোমরা ফিরে যাবে"],["عَلَىٰٓ","‘alā","on","উপর"],["أَعْقَـٰبِكُمْ ۚ","a‘qābikum","your heels","তোমাদের গোড়ালির (অর্থাৎ পিছন দিকে)"],["وَمَن","waman","And whoever","আর যে"],["يَنقَلِبْ","yanqalib","turns back","ফিরে যাবে"],["عَلَىٰ","‘alā","on","উপর"],["عَقِبَيْهِ","‘aqibayhi","his heels","তার দুই গোড়ালির"],["فَلَن","falan","then never","তাহলে কক্ষনো না"],["يَضُرَّ","yaḍurra","will he harm","ক্ষতি করতে পারবে"],["ٱللَّهَ","l-laha","Allah","আল্লাহর"],["شَيْـًۭٔا ۗ","shayan","(in) anything","কিছুই"],["وَسَيَجْزِى","wasayajzī","And will reward","এবং প্রতিফল দিবেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["ٱلشَّـٰكِرِينَ","l-shākirīna","the grateful ones","শোকরকারীদেরকে"]],"t":"وَمَا مُحَ<g>مَّ</>دٌ إِلَّا رَسُو<k>لٌۭ قَ</><q>دْ</> خَلَتْ مِ<k>ن قَ</><q>بْ</>لِهِ <h>ٱ</><l>ل</>رُّسُلُ ۚ أَفَإِ<s>ي۟</><d>ن مَّ</>اتَ أَوْ قُتِلَ <h>ٱ</><k>نقَ</>لَ<q>بْ</>تُمْ عَلَ<o>ىٰٓ</> أَعْ<m>قَٰ</>بِكُمْ ۚ وَ<d>مَن يَ</><k>نقَ</>لِ<q>بْ</> عَلَىٰ عَقِبَيْهِ فَ<d>لَن يَ</>ضُرَّ <h>ٱ</>للَّهَ شَ<d>يْـًۭٔا ۗ وَ</>سَيَ<q>جْ</>زِى <h>ٱ</>للَّهُ <h>ٱ</><l>ل</><m>شَّٰ</>كِ<p>رِي</>نَ"},{"n":145,"w":[["وَمَا","wamā","And not","এবং নয়"],["كَانَ","kāna","is","(সম্ভব)"],["لِنَفْسٍ","linafsin","for a soul","জন্য কোন প্রাণীর"],["أَن","an","that","যে"],["تَمُوتَ","tamūta","he dies","সে মরবে"],["إِلَّا","illā","except","এছাড়া"],["بِإِذْنِ","bi-idh'ni","by (the) permission","অনুমতিক্রমে"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["كِتَـٰبًۭا","kitāban","(at a) decree","লিখিত"],["مُّؤَجَّلًۭا ۗ","mu-ajjalan","determined","নির্দিষ্ট সময়"],["وَمَن","waman","And whoever","এবং যে"],["يُرِدْ","yurid","desires","চায়"],["ثَوَابَ","thawāba","reward","সওয়াব"],["ٱلدُّنْيَا","l-dun'yā","(of) the world ","দুনিয়ার"],["نُؤْتِهِۦ","nu'tihi","We will give him","তাকে দিব আমরা"],["مِنْهَا","min'hā","thereof","তা হতে"],["وَمَن","waman","and whoever","আর যে"],["يُرِدْ","yurid","desires","চায়"],["ثَوَابَ","thawāba","reward","সওয়াব"],["ٱلْـَٔاخِرَةِ","l-ākhirati","(of) the Hereafter","আখিরাতের"],["نُؤْتِهِۦ","nu'tihi","We will give him","তাকে দিব আমরা"],["مِنْهَا ۚ","min'hā","thereof","তা হতে"],["وَسَنَجْزِى","wasanajzī","And We will reward","এবং আমরা শিগগীর প্রতিফল দিব"],["ٱلشَّـٰكِرِينَ","l-shākirīna","the grateful ones","শোকরকারীদেরকে"]],"t":"وَمَا كَانَ لِنَفْسٍ أَ<k>ن تَ</>مُوتَ إِلَّا بِإِذْنِ <h>ٱ</>للَّهِ كِ<m>تَٰ</><d>بًۭا مُّ</>ؤَجَّلًۭ<d>ا ۗ وَمَن يُ</>رِ<q>دْ</> ثَوَابَ <h>ٱ</><l>ل</>دُّنْيَا نُؤْتِ<m>هِۦ</> مِنْهَا وَ<d>مَن يُ</>رِ<q>دْ</> ثَوَابَ <h>ٱ</>لْءَاخِرَةِ نُؤْتِ<m>هِۦ</> مِنْهَا ۚ وَسَنَ<q>جْ</>زِى <h>ٱ</><l>ل</><m>شَّٰ</>كِ<p>رِي</>نَ"},{"n":146,"w":[["وَكَأَيِّن","waka-ayyin","And how many","এবং কত (ছিল)"],["مِّن","min","from","(থেকে)"],["نَّبِىٍّۢ","nabiyyin","a Prophet","নবী (যারা)"],["قَـٰتَلَ","qātala","fought","লড়াই করেছে (আল্লাহর পথে)"],["مَعَهُۥ","ma‘ahu","with him","তাঁর সাথে (ছিল)"],["رِبِّيُّونَ","ribbiyyūna","(were) religious scholars","আল্লাহ ওয়ালা লোকেরা"],["كَثِيرٌۭ","kathīrun","many","অনেক"],["فَمَا","famā","But not","অতঃপর না"],["وَهَنُوا۟","wahanū","they lost heart","তারা হতাশ হয়েছে"],["لِمَآ","limā","for what","(তারা) জন্য যা"],["أَصَابَهُمْ","aṣābahum","befell them","তাদের (উপর) আপতিত হয়েছে"],["فِى","fī","in","(মধ্যে)"],["سَبِيلِ","sabīli","(the) way","পথে"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَمَا","wamā","and not","এবং না"],["ضَعُفُوا۟","ḍa‘ufū","they weakened","দুর্বলতা দেখিয়েছে"],["وَمَا","wamā","and not","আর না"],["ٱسْتَكَانُوا۟ ۗ","is'takānū","they gave in","তারা মাথা নত করেছে"],["وَٱللَّهُ","wal-lahu","And Allah","আর আল্লাহ"],["يُحِبُّ","yuḥibbu","loves","ভালোবাসেন"],["ٱلصَّـٰبِرِينَ","l-ṣābirīna","the patient ones","সবরকারীদেরকে"]],"t":"وَكَأَ<d>يِّن مِّن نَّ</>بِ<k>ىٍّۢ قَٰ</>تَلَ مَعَهُ<m>ۥ</> رِبِّيُّونَ كَثِي<k>رٌۭ فَ</>مَا وَهَنُو<s>ا۟</> لِ<o>مَآ</> أَصَابَهُمْ فِى سَبِيلِ <h>ٱ</>للَّهِ وَمَا ضَعُفُو<s>ا۟</> وَمَا <h>ٱ</>سْتَكَانُو<s>ا۟ ۗ</> وَ<h>ٱ</>للَّهُ يُحِبُّ <h>ٱ</><l>ل</><m>صَّٰ</>بِ<p>رِي</>نَ"},{"n":147,"w":[["وَمَا","wamā","And not","এবং না"],["كَانَ","kāna","were","ছিল"],["قَوْلَهُمْ","qawlahum","their words","তাদের কথা"],["إِلَّآ","illā","except","এছাড়া"],["أَن","an","that","যে"],["قَالُوا۟","qālū","they said","তারা বলেছিল"],["رَبَّنَا","rabbanā","Our Lord","''হে আমাদের রব"],["ٱغْفِرْ","igh'fir","forgive","মাফ কর"],["لَنَا","lanā","for us","আমাদের জন্য"],["ذُنُوبَنَا","dhunūbanā","our sins","আমাদের গুনাহ সমূহকে"],["وَإِسْرَافَنَا","wa-is'rāfanā","and our excesses","ও আমাদের বাড়াবাড়িকে"],["فِىٓ","fī","in","ক্ষেত্রে"],["أَمْرِنَا","amrinā","our affairs","আমাদের কাজের"],["وَثَبِّتْ","wathabbit","and make firm","এবং দৃঢ় কর"],["أَقْدَامَنَا","aqdāmanā","our feet","আমাদের পদক্ষেপ"],["وَٱنصُرْنَا","wa-unṣur'nā","and give us victory","এবং আমাদের সাহায্য কর"],["عَلَى","‘alā","over","বিরুদ্ধে"],["ٱلْقَوْمِ","l-qawmi","[the people]","জাতির"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","the disbelievers","কাফির''"]],"t":"وَمَا كَانَ قَوْلَهُمْ إِ<o>لَّآ</> أَ<k>ن قَ</>الُو<s>ا۟</> رَبَّنَا <h>ٱ</>غْفِرْ لَنَا ذُنُوبَنَا وَإِسْرَافَنَا <o>فِىٓ</> أَمْرِنَا وَثَبِّتْ أَ<q>قْ</>دَامَنَا وَ<h>ٱ</><k>نصُ</>رْنَا عَلَى <h>ٱ</>لْقَوْمِ <h>ٱ</>لْ<m>كَٰ</>فِ<p>رِي</>نَ"},{"n":148,"w":[["فَـَٔاتَىٰهُمُ","faātāhumu","So gave them","অবশেষে তাদের দিলেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["ثَوَابَ","thawāba","reward","সওয়াব"],["ٱلدُّنْيَا","l-dun'yā","(in) the world","দুনিয়ায়"],["وَحُسْنَ","waḥus'na","and good","ও উত্তম"],["ثَوَابِ","thawābi","reward","সওয়াব"],["ٱلْـَٔاخِرَةِ ۗ","l-ākhirati","(in) the Hereafter","আখিরাতের"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["يُحِبُّ","yuḥibbu","loves","পছন্দ করেন"],["ٱلْمُحْسِنِينَ","l-muḥ'sinīna","the good-doers","সৎকর্মশালীদেরকে"]],"t":"فَـَٔاتَ<m>ىٰ</>هُمُ <h>ٱ</>للَّهُ ثَوَابَ <h>ٱ</><l>ل</>دُّنْيَا وَحُسْنَ ثَوَابِ <h>ٱ</>لْءَاخِرَةِ ۗ وَ<h>ٱ</>للَّهُ يُحِبُّ <h>ٱ</>لْمُحْسِ<p>نِي</>نَ"},{"n":149,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you","ওহে"],["ٱلَّذِينَ","alladhīna","who","যারা"],["ءَامَنُوٓا۟","āmanū","believe","ঈমান এনেছ"],["إِن","in","If","যদি"],["تُطِيعُوا۟","tuṭī‘ū","you obey","তোমরা আনুগত্য কর"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["كَفَرُوا۟","kafarū","disbelieve","কুফরী করেছে"],["يَرُدُّوكُمْ","yaruddūkum","they will turn you back","তোমাদের তারা ফিরিয়ে দিবে"],["عَلَىٰٓ","‘alā","on","উপর"],["أَعْقَـٰبِكُمْ","a‘qābikum","your heels","তোমাদের গোড়ালির (অর্থাৎ পিছন দিকে)"],["فَتَنقَلِبُوا۟","fatanqalibū","then you will turn back","ফলে তোমরা ফিরবে"],["خَـٰسِرِينَ","khāsirīna","(as) losers","ক্ষতিগ্রস্ত হয়ে"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَ<o>نُوٓ</><s>ا۟</> إِ<k>ن تُ</>طِيعُو<s>ا۟</> <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> يَرُدُّوكُمْ عَلَ<o>ىٰٓ</> أَعْ<m>قَٰ</>بِكُمْ فَتَ<k>نقَ</>لِبُو<s>ا۟</> <m>خَٰ</>سِ<p>رِي</>نَ"},{"n":150,"w":[["بَلِ","bali","Nay","বরং"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["مَوْلَىٰكُمْ ۖ","mawlākum","(is) your Protector","তোমাদের অভিভাবক"],["وَهُوَ","wahuwa","and He","এবং তিনিই"],["خَيْرُ","khayru","(is the) best","উত্তম"],["ٱلنَّـٰصِرِينَ","l-nāṣirīna","(of) the Helpers","সাহায্যকারীদের (মধ্যে)"]],"t":"بَلِ <h>ٱ</>للَّهُ مَوْلَ<m>ىٰ</>كُمْ ۖ وَهُوَ خَيْرُ <h>ٱ</><l>ل</><g>نَّٰ</>صِ<p>رِي</>نَ"},{"n":151,"w":[["سَنُلْقِى","sanul'qī","We will cast","আমরা শীঘ্রই সঞ্চার করব"],["فِى","fī","in","মধ্যে"],["قُلُوبِ","qulūbi","(the) hearts","অন্তরগুলোর"],["ٱلَّذِينَ","alladhīna","(of) those who","(তাদের) যারা"],["كَفَرُوا۟","kafarū","disbelieve","কুফরী করেছে"],["ٱلرُّعْبَ","l-ru‘'ba","[the] terror","ভীতি"],["بِمَآ","bimā","because","এ কারণে যে"],["أَشْرَكُوا۟","ashrakū","they associated partners","তারা শিরক করেছে"],["بِٱللَّهِ","bil-lahi","with Allah","আল্লাহর সাথে"],["مَا","mā","what","যার"],["لَمْ","lam","not","না"],["يُنَزِّلْ","yunazzil","He sent down","তিনি অবতীর্ণ করেছেন"],["بِهِۦ","bihi","about it","সে ব্যাপারে"],["سُلْطَـٰنًۭا ۖ","sul'ṭānan","any authority","কোনো প্রমাণ"],["وَمَأْوَىٰهُمُ","wamawāhumu","and their refuge","এবং তাদের ঠিকানা (হবে)"],["ٱلنَّارُ ۚ","l-nāru","(will be) the Fire","(জাহান্নামের) আগুন"],["وَبِئْسَ","wabi'sa","and wretched","এবং অতি নিকৃষ্ট"],["مَثْوَى","mathwā","(is the) abode","আবাসস্থল"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","[of] the wrongdoers","জালিমদের (জন্য)"]],"t":"سَنُلْقِى فِى قُلُوبِ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> <h>ٱ</><l>ل</>رُّعْبَ بِ<o>مَآ</> أَشْرَكُو<s>ا۟</> بِ<h>ٱ</>للَّهِ مَا لَمْ يُنَزِّلْ بِ<m>هِۦ</> سُلْ<m>طَٰ</><d>نًۭا ۖ وَ</>مَأْوَ<m>ىٰ</>هُمُ <h>ٱ</><l>ل</><g>نَّ</>ارُ ۚ وَبِئْسَ مَثْوَى <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":152,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়"],["صَدَقَكُمُ","ṣadaqakumu","fulfilled to you","তোমাদেরকে সত্য করে দেখিয়েছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["وَعْدَهُۥٓ","wa‘dahu","His promise","তাঁর ওয়াদা"],["إِذْ","idh","when","যখন"],["تَحُسُّونَهُم","taḥussūnahum","you were killing them","তাদেরকে তোমরা হত্যা করছিলে"],["بِإِذْنِهِۦ ۖ","bi-idh'nihi","by His permission","তাঁর নির্দেশে"],["حَتَّىٰٓ","ḥattā","until","এমনকি"],["إِذَا","idhā","when","যখন"],["فَشِلْتُمْ","fashil'tum","you lost courage","তোমরা দূর্বলতা দেখালে"],["وَتَنَـٰزَعْتُمْ","watanāza‘tum","and you fell into dispute","এবং তোমরা মতবিরোধ করলে"],["فِى","fī","concerning","ক্ষেত্রে"],["ٱلْأَمْرِ","l-amri","the order","কাজের"],["وَعَصَيْتُم","wa‘aṣaytum","and you disobeyed","ও তোমরা অবাধ্য হলে"],["مِّنۢ","min","from","(থেকে)"],["بَعْدِ","ba‘di","after","এরপরও"],["مَآ","mā","[what]","যা"],["أَرَىٰكُم","arākum","He (had) shown you","তোমাদের তিনি দেখালেন"],["مَّا","mā","what","যা"],["تُحِبُّونَ ۚ","tuḥibbūna","you love","তোমরা ভালবাস"],["مِنكُم","minkum","Among you","তোমাদের মধ্যে (কিছু আছে)"],["مَّن","man","(are some) who","(এমন) যারা"],["يُرِيدُ","yurīdu","desire","চায়"],["ٱلدُّنْيَا","l-dun'yā","the world","দুনিয়া"],["وَمِنكُم","waminkum","and among you","এবং তোমাদের মধ্যে কিছু (আছে)"],["مَّن","man","(are some) who","(এমনও) যারা"],["يُرِيدُ","yurīdu","desire","চায়"],["ٱلْـَٔاخِرَةَ ۚ","l-ākhirata","the Hereafter","আখিরাত"],["ثُمَّ","thumma","Then","এরপর"],["صَرَفَكُمْ","ṣarafakum","He diverted you","তোমাদেরকে ফিরালেন"],["عَنْهُمْ","‘anhum","from them","তাদের থেকে"],["لِيَبْتَلِيَكُمْ ۖ","liyabtaliyakum","so that He may test you","তোমাদেরকে পরীক্ষা করার জন্য"],["وَلَقَدْ","walaqad","And surely","এবং অবশ্য"],["عَفَا","‘afā","He forgave","মাফ করেছেন"],["عَنكُمْ ۗ","‘ankum","you","তোমাদেরকে"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["ذُو","dhū","(is the) Possessor","(একটি)"],["فَضْلٍ","faḍlin","(of) Bounty","অনুগ্রহশীল"],["عَلَى","‘alā","for","উপর"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believers","ঈমানদারদের"]],"t":"وَلَقَ<q>دْ</> صَدَقَكُمُ <h>ٱ</>للَّهُ وَعْدَهُ<o>ۥٓ</> إِذْ تَحُسُّونَ<f>هُم بِ</>إِذْنِ<m>هِۦ</> ۖ حَتَّ<o>ىٰٓ</> إِذَا فَشِلْتُمْ وَتَ<m>نَٰ</>زَعْتُمْ فِى <h>ٱ</>لْأَمْرِ وَعَصَيْ<y>تُم مِّ</><i>نۢ بَ</>عْدِ <o>مَآ</> أَرَ<m>ىٰ</><y>كُم مَّ</>ا تُحِبُّونَ ۚ مِ<k>نكُ</><y>م مَّ</><d>ن يُ</>رِيدُ <h>ٱ</><l>ل</>دُّنْيَا وَمِ<k>نكُ</><y>م مَّ</><d>ن يُ</>رِيدُ <h>ٱ</>لْءَاخِرَةَ ۚ ثُ<g>مَّ</> صَرَفَكُمْ عَنْهُمْ لِيَ<q>بْ</>تَلِيَكُمْ ۖ وَلَقَ<q>دْ</> عَفَا عَ<k>نكُ</>مْ ۗ وَ<h>ٱ</>للَّهُ ذُو فَضْلٍ عَلَى <h>ٱ</>لْمُؤْمِ<p>نِي</>نَ"},{"n":153,"w":[["۞ إِذْ","idh","When","(স্মরণ কর) যখন"],["تُصْعِدُونَ","tuṣ'‘idūna","you were running uphill","তোমরা উর্ধ্বমুখে চলছিলে"],["وَلَا","walā","and not","এবং না"],["تَلْوُۥنَ","talwūna","casting a glance","তোমরা ফিরে তাকাচ্ছিলে"],["عَلَىٰٓ","‘alā","on","প্রতি"],["أَحَدٍۢ","aḥadin","anyone","কারো"],["وَٱلرَّسُولُ","wal-rasūlu","while the Messenger","এবং রাসূল"],["يَدْعُوكُمْ","yad‘ūkum","was calling you","তোমাদেরকে ডাকছিল"],["فِىٓ","fī","[in]","(মধ্যে)"],["أُخْرَىٰكُمْ","ukh'rākum","(from) behind you","তোমাদের পিছনে"],["فَأَثَـٰبَكُمْ","fa-athābakum","So (He) repaid you","তোমাদেরকে তখন পৌঁছালেন"],["غَمًّۢا","ghamman","(with) distress","দুঃখ"],["بِغَمٍّۢ","bighammin","on distress","দুঃখের পর"],["لِّكَيْلَا","likaylā","so that not","না যেন"],["تَحْزَنُوا۟","taḥzanū","you grieve","তোমরা বিষণ্ন হও"],["عَلَىٰ","‘alā","over","(তা) জন্য"],["مَا","mā","what","যা"],["فَاتَكُمْ","fātakum","escaped you","তোমরা হারিয়েছ"],["وَلَا","walā","and not","আর না (দুঃখ কর)"],["مَآ","mā","what","যা"],["أَصَـٰبَكُمْ ۗ","aṣābakum","(had) befallen you","তোমাদের পৌঁছেছে"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["خَبِيرٌۢ","khabīrun","(is) All-Aware","খুব অবহিত"],["بِمَا","bimā","of what","ঐবিষয়ে যা"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা কাজ করছ"]],"t":"۞ إِذْ تُصْعِدُونَ وَلَا تَلْوُ<m>ۥ</>نَ عَلَ<o>ىٰٓ</> أَحَ<d>دٍۢ وَ</><h>ٱ</><l>ل</>رَّسُولُ يَ<q>دْ</>عُوكُمْ <o>فِىٓ</> أُخْرَ<m>ىٰ</>كُمْ فَأَ<m>ثَٰ</>بَكُمْ غَ<g>مًّۢ</><i>ا بِ</>غَ<g>مٍّۢ</> لِّكَيْلَا تَحْزَنُو<s>ا۟</> عَلَىٰ مَا فَاتَكُمْ وَلَا <o>مَآ</> أَ<m>صَٰ</>بَكُمْ ۗ وَ<h>ٱ</>للَّهُ خَبِي<i>رٌۢ بِ</>مَا تَعْمَ<p>لُو</>نَ"},{"n":154,"w":[["ثُمَّ","thumma","Then","এরপর"],["أَنزَلَ","anzala","He sent down","তিনি অবতীর্ণ করলেন"],["عَلَيْكُم","‘alaykum","upon you","তোমাদের উপর"],["مِّنۢ","min","from","(থেকে)"],["بَعْدِ","ba‘di","after","পরে"],["ٱلْغَمِّ","l-ghami","the distress","দুঃখের"],["أَمَنَةًۭ","amanatan","security ","প্রশান্তি"],["نُّعَاسًۭا","nu‘āsan","slumber","তন্দ্রারূপে"],["يَغْشَىٰ","yaghshā","overcoming","আচ্ছন্ন করে"],["طَآئِفَةًۭ","ṭāifatan","a group","একটি দলকে (মুমিনদেরকে)"],["مِّنكُمْ ۖ","minkum","of you","তোমাদের মধ্য হতে"],["وَطَآئِفَةٌۭ","waṭāifatun","while a group","কিন্তু (আর) একটি দল (অর্থাৎ মুনাফিকরা)"],["قَدْ","qad","certainly","নিশ্চয়"],["أَهَمَّتْهُمْ","ahammathum","worried [them]","ত