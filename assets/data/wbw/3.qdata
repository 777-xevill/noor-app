{"n":3,"a":[{"n":1,"w":[["الٓمٓ","alif-lam-meem","Alif Laam Meem","আলিফ লা-ম মী-ম"]],"t":"ا<n>لٓمٓ</>"},{"n":2,"w":[["ٱللَّهُ","al-lahu","Allah ","আল্লাহ (এমন সত্তা)"],["لَآ","lā","(there is) no","নেই"],["إِلَـٰهَ","ilāha","God","কোনো ইলাহ"],["إِلَّا","illā","except","ছাড়া"],["هُوَ","huwa","Him","তিনি"],["ٱلْحَىُّ","l-ḥayu","the Ever-Living","(তিনিই) চিরঞ্জীব"],["ٱلْقَيُّومُ","l-qayūmu","the Sustainer of all that exists","সর্বসত্তার ধারক"]],"t":"ٱللَّهُ <o>لَآ</> إِ<m>لَٰ</>هَ إِلَّا هُوَ <h>ٱ</>لْحَىُّ <h>ٱ</>لْقَ<p>يُّو</>مُ"},{"n":3,"w":[["نَزَّلَ","nazzala","He revealed","তিনি অবতীর্ণ করেছেন"],["عَلَيْكَ","‘alayka","to you","তোমার উপর"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","কিতাব"],["بِٱلْحَقِّ","bil-ḥaqi","in [the] truth","সত্যসহ"],["مُصَدِّقًۭا","muṣaddiqan","confirming","সত্যায়নকারী"],["لِّمَا","limā","that which","তার জন্য যা"],["بَيْنَ","bayna","(was)","মাঝে"],["يَدَيْهِ","yadayhi","before it","(এসেছে হাতের) তার পূর্বে"],["وَأَنزَلَ","wa-anzala","and He revealed","এবং তিনি অবতীর্ণ করেছেন"],["ٱلتَّوْرَىٰةَ","l-tawrāta","the Taurat","তওরাত"],["وَٱلْإِنجِيلَ","wal-injīla","and the Injeel","ও ইঞ্জীল"]],"t":"نَزَّلَ عَلَيْكَ <h>ٱ</>لْكِ<m>تَٰ</>بَ بِ<h>ٱ</>لْحَقِّ مُصَدِّ<w>قًۭا لِّ</>مَا بَيْنَ يَدَيْهِ وَأَ<k>نزَ</>لَ <h>ٱ</><l>ل</>تَّوْرَ<m>ىٰ</>ةَ وَ<h>ٱ</>لْإِ<k>نجِ</><p>ي</>لَ"},{"n":4,"w":[["مِن","min","From","থেকে"],["قَبْلُ","qablu","before (this)","ইতিপূর্ব"],["هُدًۭى","hudan","(as) guidance","সঠিকপথ (হিসেবে)"],["لِّلنَّاسِ","lilnnāsi","for the mankind","মানুষের জন্য"],["وَأَنزَلَ","wa-anzala","And (He) revealed","এবং তিনি অবতীর্ণ করেছেন"],["ٱلْفُرْقَانَ ۗ","l-fur'qāna","the Criterion","ফুরকান(ন্যায়-অন্যায়ের মীমাংসা)"],["إِنَّ","inna","Verily","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieve[d]","অস্বীকার করেছে"],["بِـَٔايَـٰتِ","biāyāti","in (the) Verses","নিদর্শনগুলোর প্রতি"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["لَهُمْ","lahum","for them","তাদের জন্য"],["عَذَابٌۭ","‘adhābun","(is) a punishment","শাস