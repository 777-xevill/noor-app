a","Allah","আল্লাহ"],["يُحِبُّ","yuḥibbu","loves","ভালবাসবেন"],["ٱلْمُتَّقِينَ","l-mutaqīna","those who fear (Him)","নাফরমানী থেকে বেঁচে চলা লোকদের"]],"t":"بَلَىٰ مَنْ أَوْفَىٰ بِعَهْدِ<m>هِۦ</> وَ<h>ٱ</>تَّقَىٰ فَإِ<g>نَّ</> <h>ٱ</>للَّهَ يُحِبُّ <h>ٱ</>لْمُتَّ<p>قِي</>نَ"},{"n":77,"w":[["إِنَّ","inna","Indeed","নিশ্চয়"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["يَشْتَرُونَ","yashtarūna","exchange","বিক্রয় করে"],["بِعَهْدِ","bi‘ahdi","(the) Covenant","প্রতিশ্রুতিকে"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর (সাথে কৃত)"],["وَأَيْمَـٰنِهِمْ","wa-aymānihim","and their oaths","ও তাদের শপথসমূহকে"],["ثَمَنًۭا","thamanan","(for) a price","মূল্যে"],["قَلِيلًا","qalīlan","little","সামান্য"],["أُو۟لَـٰٓئِكَ","ulāika","those ","ঐসব লোক"],["لَا","lā","no","নাই"],["خَلَـٰقَ","khalāqa","share","কোন অংশ"],["لَهُمْ","lahum","for them","তাদের জন্যে"],["فِى","fī","in","(মধ্যে)"],["ٱلْـَٔاخِرَةِ","l-ākhirati","the Hereafter","আখেরাতে"],["وَلَا","walā","and not","এবং না"],["يُكَلِّمُهُمُ","yukallimuhumu","will speak to them","তাদের সাথে কথা বলবেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["وَلَا","walā","and not","এবং না"],["يَنظُرُ","yanẓuru","look","(দয়ার দৃষ্টিতে) তাকাবেন"],["إِلَيْهِمْ","ilayhim","at them","তাদের প্রতি"],["يَوْمَ","yawma","(on the) Day","দিনে"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) the Resurrection","কিয়ামতের"],["وَلَا","walā","and not","এবং না"],["يُزَكِّيهِمْ","yuzakkīhim","purify them","তাদের পরিশুদ্ধ করবেন"],["وَلَهُمْ","walahum","and for them","এবং তাদের জন্যে রয়েছে"],["عَذَابٌ","‘adhābun","(is) a punishment","শাস্তি"],["أَلِيمٌۭ","alīmun","painful","অতি কষ্টদায়ক"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ يَشْتَرُونَ بِعَهْدِ <h>ٱ</>للَّهِ وَأَيْ<m>مَٰ</>نِهِمْ ثَمَ<k>نًۭا قَ</>لِيلًا أُ<s>و۟</><o>لَٰٓ</>ئِكَ لَا خَ<m>لَٰ</>قَ لَهُمْ فِى <h>ٱ</>لْءَاخِرَةِ وَلَا يُكَلِّمُهُمُ <h>ٱ</>للَّهُ وَلَا يَ<k>نظُ</>رُ إِلَيْهِمْ يَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ وَلَا يُزَكِّيهِمْ وَلَهُمْ عَذَابٌ أَ<p>لِي</>مٌۭ"},{"n":78,"w":[["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়"],["مِنْهُمْ","min'hum","among them","তাদের মধ্যে"],["لَفَرِيقًۭا","lafarīqan","surely (is) a group ","অবশ্যই একদল (আছে)"],["يَلْوُۥنَ","yalwūna","they distort","তারা মুড়াতে থাকে"],["أَلْسِنَتَهُم","alsinatahum","their tongues","তাদের জিহবাগুলোকে"],["بِٱلْكِتَـٰبِ","bil-kitābi","in (reciting) the Book","কিতাব (পাঠে)"],["لِتَحْسَبُوهُ","litaḥsabūhu","so that you may think it","তাকে তোমরা যেন মনে কর"],["مِنَ","mina","(is) from","অংশ (হিসেবে)"],["ٱلْكِتَـٰبِ","l-kitābi","the Book","কিতাবের"],["وَمَا","wamā","and not","অথচ না"],["هُوَ","huwa","it","তা"],["مِنَ","mina","(is) from","অংশ"],["ٱلْكِتَـٰبِ","l-kitābi","the Book","কিতাবের"],["وَيَقُولُونَ","wayaqūlūna","And they say","এবং তারা বলে"],["هُوَ","huwa","It","''তা (এসেছে)"],["مِنْ","min","(is)","থেকে''"],["عِندِ","‘indi","from","কাছ''"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর''"],["وَمَا","wamā","But not","অথচ না"],["هُوَ","huwa","it","তা (এসেছে)"],["مِنْ","min","(is)","থেকে"],["عِندِ","‘indi","from","নিকট"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["وَيَقُولُونَ","wayaqūlūna","And they say","এবং তারা বলে"],["عَلَى","‘alā","about","বিরুদ্ধে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["ٱلْكَذِبَ","l-kadhiba","the lie","মিথ্যা"],["وَهُمْ","wahum","while they","অথচ তারা"],["يَعْلَمُونَ","ya‘lamūna","know","(ভালভাবে) জানে"]],"t":"وَإِ<g>نَّ</> مِنْهُمْ لَفَرِي<d>قًۭا يَ</>لْوُ<m>ۥ</>نَ أَلْسِنَتَ<f>هُم بِ</><h>ٱ</>لْكِ<m>تَٰ</>بِ لِتَحْسَبُوهُ مِنَ <h>ٱ</>لْكِ<m>تَٰ</>بِ وَمَا هُوَ مِنَ <h>ٱ</>لْكِ<m>تَٰ</>بِ وَيَقُولُونَ هُوَ مِنْ عِ<k>ندِ</> <h>ٱ</>للَّهِ وَمَا هُوَ مِنْ عِ<k>ندِ</> <h>ٱ</>للَّهِ وَيَقُولُونَ عَلَى <h>ٱ</>للَّهِ <h>ٱ</>لْكَذِبَ وَهُمْ يَعْلَ<p>مُو</>نَ"},{"n":79,"w":[["مَا","mā","Not","নয়"],["كَانَ","kāna","is","শোভনীয়"],["لِبَشَرٍ","libasharin","for a human","কোন মানুষের জন্যে"],["أَن","an","that","যে"],["يُؤْتِيَهُ","yu'tiyahu","gives him","তাকে দেবেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","কিতাব"],["وَٱلْحُكْمَ","wal-ḥuk'ma","and the wisdom","ও জ্ঞান"],["وَٱلنُّبُوَّةَ","wal-nubuwata","and the Prophethood","ও নবূয়্যত"],["ثُمَّ","thumma","then","এরপর"],["يَقُولَ","yaqūla","he says","সে বলবে"],["لِلنَّاسِ","lilnnāsi","to the people","মানুষকে"],["كُونُوا۟","kūnū","Be","''তোমরা হয়ে যাও"],["عِبَادًۭا","‘ibādan","worshippers","দাস"],["لِّى","lī","of me","আমার"],["مِن","min","from","(থেকে)"],["دُونِ","dūni","besides","ব্যতীত"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["وَلَـٰكِن","walākin","but (would say)","কিন্তু (সে বলবে)"],["كُونُوا۟","kūnū","Be","''তোমরা হও"],["رَبَّـٰنِيِّـۧنَ","rabbāniyyīna","worshippers of the Lord","আল্লাহওয়ালা"],["بِمَا","bimā","because","যেহেতু"],["كُنتُمْ","kuntum","you have been","তোমরা"],["تُعَلِّمُونَ","tu‘allimūna","teaching","শিখিয়ে থাক"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","কিতাব"],["وَبِمَا","wabimā","and because","ও যেহেতু"],["كُنتُمْ","kuntum","you have been","(আপনি)"],["تَدْرُسُونَ","tadrusūna","studying (it)","তোমরা অধ্যয়ন করে থাক''"]],"t":"مَا كَانَ لِبَشَرٍ <d>أَن يُ</>ؤْتِيَهُ <h>ٱ</>للَّهُ <h>ٱ</>لْكِ<m>تَٰ</>بَ وَ<h>ٱ</>لْحُكْمَ وَ<h>ٱ</><l>ل</><g>نُّ</>بُوَّةَ ثُ<g>مَّ</> يَقُولَ لِل<g>نَّ</>اسِ كُونُو<s>ا۟</> عِبَا<w>دًۭا لِّ</>ى مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ وَ<m>لَٰ</>كِ<k>ن كُ</>ونُو<s>ا۟</> رَ<m>بَّٰ</>نِيِّۦنَ بِمَا كُ<k>نتُ</>مْ تُعَلِّمُونَ <h>ٱ</>لْكِ<m>تَٰ</>بَ وَبِمَا كُ<k>نتُ</>مْ تَ<q>دْ</>رُ<p>سُو</>نَ"},{"n":80,"w":[["وَلَا","walā","And not","এবং না"],["يَأْمُرَكُمْ","yamurakum","he will order you","তোমাদেরকে নির্দেশ দিবে সে"],["أَن","an","that","যে"],["تَتَّخِذُوا۟","tattakhidhū","you take","তোমরা গ্রহণ করবে"],["ٱلْمَلَـٰٓئِكَةَ","l-malāikata","the Angels","ফেরেশতাদেরকে"],["وَٱلنَّبِيِّـۧنَ","wal-nabiyīna","and the Prophets","ও নবীদেরকে"],["أَرْبَابًا ۗ","arbāban","(as) lords","প্রভু হিসেবে"],["أَيَأْمُرُكُم","ayamurukum","Would he order you","তোমাদের নির্দেশ দেবে কি"],["بِٱلْكُفْرِ","bil-kuf'ri","to [the] disbelief","কুফরীর"],["بَعْدَ","ba‘da","after","এরপরেও"],["إِذْ","idh","[when]","যখন"],["أَنتُم","antum","you (have become)","তোমরা"],["مُّسْلِمُونَ","mus'limūna","Muslims","মুসলমান (তা কি সম্ভব?)"]],"t":"وَلَا يَأْمُرَكُمْ أَ<k>ن تَ</>تَّخِذُو<s>ا۟</> <h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةَ وَ<h>ٱ</><l>ل</><g>نَّ</>بِيِّۦنَ أَرْبَابًا ۗ أَيَأْمُرُ<f>كُم بِ</><h>ٱ</>لْكُفْرِ بَعْدَ إِذْ أَ<k>نتُ</><y>م مُّ</>سْلِ<p>مُو</>نَ"},{"n":81,"w":[["وَإِذْ","wa-idh","And when","এবং (স্মরণ কর) যখন"],["أَخَذَ","akhadha","took","গ্রহণ করেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["مِيثَـٰقَ","mīthāqa","covenant","অঙ্গীকার"],["ٱلنَّبِيِّـۧنَ","l-nabiyīna","(of) the Prophets","নবীদের (থেকে এই বলে যে)"],["لَمَآ","lamā","Certainly, whatever","''অবশ্যই যা"],["ءَاتَيْتُكُم","ātaytukum","I (have) given you","তোমাদের আমি দিয়েছি"],["مِّن","min","of","(থেকে)"],["كِتَـٰبٍۢ","kitābin","(the) Book","কিতাব"],["وَحِكْمَةٍۢ","waḥik'matin","and wisdom","ও হেকমত"],["ثُمَّ","thumma","then","এরপর (যখন)"],["جَآءَكُمْ","jāakum","comes to you","তোমাদের কাছে আসবে"],["رَسُولٌۭ","rasūlun","a Messenger","কোন রসূল"],["مُّصَدِّقٌۭ","muṣaddiqun","confirming","সত্যায়নকারী"],["لِّمَا","limā","that which","তার যা"],["مَعَكُمْ","ma‘akum","(is) with you","তোমাদের সাথে আছে"],["لَتُؤْمِنُنَّ","latu'minunna","you must believe","তোমরা অবশ্যই বিশ্বাস করবে"],["بِهِۦ","bihi","in him","তার উপর"],["وَلَتَنصُرُنَّهُۥ ۚ","walatanṣurunnahu","and you must help him","ও তাকে তোমরা অবশ্যই সাহায্য করবে''"],["قَالَ","qāla","He said","তিনি বললেন"],["ءَأَقْرَرْتُمْ","a-aqrartum","Do you affirm","''তোমরা অঙ্গীকার করলে কি"],["وَأَخَذْتُمْ","wa-akhadhtum","and take","ও তোমরা গ্রহণ করলে (কি)"],["عَلَىٰ","‘alā","on","উপর"],["ذَٰلِكُمْ","dhālikum","that (condition)","এসবের"],["إِصْرِى ۖ","iṣ'rī","My Covenant","দায়িত্বভার"],["قَالُوٓا۟","qālū","They said","তারা বলল"],["أَقْرَرْنَا ۚ","aqrarnā","We affirm","''আমরা অঙ্গীকার করলাম''"],["قَالَ","qāla","He said","তিনি বললেন"],["فَٱشْهَدُوا۟","fa-ish'hadū","Then bear witness","''তোমরা সাক্ষী থাকো"],["وَأَنَا۠","wa-anā","and I (am)","এবং আমিও"],["مَعَكُم","ma‘akum","with you","তোমাদের সাথে"],["مِّنَ","mina","among","অন্তর্ভুক্ত (রইলাম)"],["ٱلشَّـٰهِدِينَ","l-shāhidīna","the witnesses","সাক্ষীদাতাদের''"]],"t":"وَإِذْ أَخَذَ <h>ٱ</>للَّهُ مِي<m>ثَٰ</>قَ <h>ٱ</><l>ل</><g>نَّ</>بِيِّۦنَ لَ<o>مَآ</> ءَاتَيْتُ<y>كُم مِّ</><k>ن كِ</><m>تَٰ</><d>بٍۢ وَ</>حِكْمَ<k>ةٍۢ ثُ</><g>مَّ</> <o>جَآ</>ءَكُمْ رَسُو<d>لٌۭ مُّ</>صَدِّ<w>قٌۭ لِّ</>مَا مَعَكُمْ لَتُؤْمِنُ<g>نَّ</> بِ<m>هِۦ</> وَلَتَ<k>نصُ</>رُ<g>نَّ</>هُ<m>ۥ</> ۚ قَالَ ءَأَ<q>قْ</>رَرْتُمْ وَأَخَذْتُمْ عَلَىٰ <m>ذَٰ</>لِكُمْ إِصْرِى ۖ قَا<o>لُوٓ</><s>ا۟</> أَ<q>قْ</>رَرْنَا ۚ قَالَ فَ<h>ٱ</>شْهَدُو<s>ا۟</> وَأَنَا۠ مَعَ<y>كُم مِّ</>نَ <h>ٱ</><l>ل</><m>شَّٰ</>هِ<p>دِي</>نَ"},{"n":82,"w":[["فَمَن","faman","Then whoever","অতঃপর যে"],["تَوَلَّىٰ","tawallā","turns away","ফিরে যাবে"],["بَعْدَ","ba‘da","after","পরও"],["ذَٰلِكَ","dhālika","that","এর"],["فَأُو۟لَـٰٓئِكَ","fa-ulāika","then those","তাহলে ঐসব লোকই"],["هُمُ","humu","they","তারাই"],["ٱلْفَـٰسِقُونَ","l-fāsiqūna","(are) the defiantly disobedient","নাফরমান"]],"t":"فَمَ<k>ن تَ</>وَلَّىٰ بَعْدَ <m>ذَٰ</>لِكَ فَأُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</>لْ<m>فَٰ</>سِ<p>قُو</>نَ"},{"n":83,"w":[["أَفَغَيْرَ","afaghayra","So is (it) other than","তাহলে কি ব্যতীত"],["دِينِ","dīni","(the) religion","দ্বীন"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["يَبْغُونَ","yabghūna","they seek","তারা চায় (অন্যদ্বীন)"],["وَلَهُۥٓ","walahu","While to Him","তার কাছে"],["أَسْلَمَ","aslama","(have) submitted","আত্মসমর্পণ করেছে"],["مَن","man","whatever","যা কিছু"],["فِى","fī","(is) in","মধ্যে আছে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আসমান সমূহের"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও যমীনে"],["طَوْعًۭا","ṭaw‘an","willingly","ইচ্ছায়"],["وَكَرْهًۭا","wakarhan","or unwillingly","বা অনিচ্ছায়"],["وَإِلَيْهِ","wa-ilayhi","and towards Him","আর তারই দিকে"],["يُرْجَعُونَ","yur'ja‘ūna","they will be returned","তাদের প্রত্যাবর্তন করা হবে"]],"t":"أَفَغَيْرَ دِينِ <h>ٱ</>للَّهِ يَ<q>بْ</>غُونَ وَلَهُ<o>ۥٓ</> أَسْلَمَ مَ<k>ن فِ</>ى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ طَوْ<d>عًۭا وَ</>كَرْ<d>هًۭا وَ</>إِلَيْهِ يُرْجَ<p>عُو</>نَ"},{"n":84,"w":[["قُلْ","qul","Say","তুমি বল"],["ءَامَنَّا","āmannā","We believed","''আমরা ঈমান এনেছি"],["بِٱللَّهِ","bil-lahi","in Allah","আল্লাহর উপর"],["وَمَآ","wamā","and what","ও যা কিছু"],["أُنزِلَ","unzila","(is) revealed","নাযিল করা হয়েছে"],["عَلَيْنَا","‘alaynā","on us","আমাদের উপর"],["وَمَآ","wamā","and what","ও যা কিছু"],["أُنزِلَ","unzila","was revealed","নাযিল করা হয়েছে"],["عَلَىٰٓ","‘alā","on","উপর"],["إِبْرَٰهِيمَ","ib'rāhīma","Ibrahim","ইবরাহীমের"],["وَإِسْمَـٰعِيلَ","wa-is'mā‘īla","and Ishmael","ও ইসমাঈলের"],["وَإِسْحَـٰقَ","wa-is'ḥāqa","and Isaac","ও ইসহাকের"],["وَيَعْقُوبَ","waya‘qūba","and Yaqub","ও ইয়াকুবের"],["وَٱلْأَسْبَاطِ","wal-asbāṭi","and the descendents","এবং (তাদের) বংশধরদের (উপর)"],["وَمَآ","wamā","and what","এবং যা কিছু"],["أُوتِىَ","ūtiya","was given","দেওয়া হয়েছে"],["مُوسَىٰ","mūsā","(to) Musa","মূসাকে"],["وَعِيسَىٰ","wa‘īsā","and Isa","ও ঈসাকে"],["وَٱلنَّبِيُّونَ","wal-nabiyūna","and the Prophets","ও নবীদেরকে"],["مِن","min","from","পক্ষ হতে"],["رَّبِّهِمْ","rabbihim","their Lord","তাদের রবের"],["لَا","lā","Not","না"],["نُفَرِّقُ","nufarriqu","we make distinction","আমরা পার্থক্য করি"],["بَيْنَ","bayna","between","মাঝে"],["أَحَدٍۢ","aḥadin","any","কারো"],["مِّنْهُمْ","min'hum","of them","তাদের মধ্যকার"],["وَنَحْنُ","wanaḥnu","and we","আর আমরা"],["لَهُۥ","lahu","to Him","তারই কাছে"],["مُسْلِمُونَ","mus'limūna","(are) submissive","আত্মসমর্পণকারী (অর্থাৎ মুসলমান)"]],"t":"قُلْ ءَامَ<g>نَّ</>ا بِ<h>ٱ</>للَّهِ وَ<o>مَآ</> أُ<k>نزِ</>لَ عَلَيْنَا وَ<o>مَآ</> أُ<k>نزِ</>لَ عَلَ<o>ىٰٓ</> إِ<q>بْ</><m>رَٰ</>هِيمَ وَإِسْ<m>مَٰ</>عِيلَ وَإِسْ<m>حَٰ</>قَ وَيَعْقُوبَ وَ<h>ٱ</>لْأَسْبَاطِ وَ<o>مَآ</> أُوتِىَ مُوسَىٰ وَعِيسَىٰ وَ<h>ٱ</><l>ل</><g>نَّ</>بِيُّونَ <w>مِن رَّ</>بِّهِمْ لَا نُفَرِّقُ بَيْنَ أَحَ<d>دٍۢ مِّ</>نْهُمْ وَنَحْنُ لَهُ<m>ۥ</> مُسْلِ<p>مُو</>نَ"},{"n":85,"w":[["وَمَن","waman","And whoever","এবং যে কেউ"],["يَبْتَغِ","yabtaghi","seeks","গ্রহণ করতে চায়"],["غَيْرَ","ghayra","other than","ব্যতীত"],["ٱلْإِسْلَـٰمِ","l-is'lāmi","[the] Islam","ইসলাম"],["دِينًۭا","dīnan","(as) religion","(অন্যকোন) দ্বীন"],["فَلَن","falan","then never","তা কক্ষণ না"],["يُقْبَلَ","yuq'bala","will be accepted","কবুল করা হবে"],["مِنْهُ","min'hu","from him","তার থেকে"],["وَهُوَ","wahuwa","and he","এবং সে (হবে)"],["فِى","fī","in","(মধ্যে)"],["ٱلْـَٔاخِرَةِ","l-ākhirati","the Hereafter","আখেরাতে"],["مِنَ","mina","(will be) from","অন্তর্ভুক্ত"],["ٱلْخَـٰسِرِينَ","l-khāsirīna","the losers","ক্ষতিগ্রস্থদের"]],"t":"وَ<d>مَن يَ</><q>بْ</>تَغِ غَيْرَ <h>ٱ</>لْإِسْ<m>لَٰ</>مِ دِي<k>نًۭا فَ</><d>لَن يُ</><q>قْ</>بَلَ مِنْهُ وَهُوَ فِى <h>ٱ</>لْءَاخِرَةِ مِنَ <h>ٱ</>لْ<m>خَٰ</>سِ<p>رِي</>نَ"},{"n":86,"w":[["كَيْفَ","kayfa","How","কিরূপে"],["يَهْدِى","yahdī","(shall) guide","হেদায়াত দিবেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["قَوْمًۭا","qawman","a people","কোন সম্প্রদায়কে"],["كَفَرُوا۟","kafarū","(who) disbelieved","(যারা) কুফরী করল"],["بَعْدَ","ba‘da","after","পরেও"],["إِيمَـٰنِهِمْ","īmānihim","their belief","আদের ঈমানের"],["وَشَهِدُوٓا۟","washahidū","and (had) witnessed","অথচ তারা সাক্ষী দিল"],["أَنَّ","anna","that","যে"],["ٱلرَّسُولَ","l-rasūla","the Messenger","(এই) রসূল"],["حَقٌّۭ","ḥaqqun","(is) true","সত্য"],["وَجَآءَهُمُ","wajāahumu","and came to them","ও তাদের কাছে এসেছে"],["ٱلْبَيِّنَـٰتُ ۚ","l-bayinātu","the clear proofs","স্পষ্ট নিদর্শনাবলী"],["وَٱللَّهُ","wal-lahu","And Allah","আর আল্লাহ"],["لَا","lā","(does) not","না"],["يَهْدِى","yahdī","guide","হেদায়াত দেন"],["ٱلْقَوْمَ","l-qawma","the people","সম্প্রদায়কে"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","[the] wrongdoers","(যারা) জালেম"]],"t":"كَيْفَ يَهْدِى <h>ٱ</>للَّهُ قَوْ<k>مًۭا كَ</>فَرُو<s>ا۟</> بَعْدَ إِي<m>مَٰ</>نِهِمْ وَشَهِ<o>دُوٓ</><s>ا۟</> أَ<g>نَّ</> <h>ٱ</><l>ل</>رَّسُولَ حَ<d>قٌّۭ وَ</><o>جَآ</>ءَهُمُ <h>ٱ</>لْبَيِّ<m>نَٰ</>تُ ۚ وَ<h>ٱ</>للَّهُ لَا يَهْدِى <h>ٱ</>لْقَوْمَ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":87,"w":[["أُو۟لَـٰٓئِكَ","ulāika","Those ","ঐসব লোক"],["جَزَآؤُهُمْ","jazāuhum","their recompense","তাদের প্রতিফল"],["أَنَّ","anna","that","এই যে"],["عَلَيْهِمْ","‘alayhim","on them","তাদের উপর"],["لَعْنَةَ","la‘nata","(is the) curse","অভিশাপ (বর্ষিত হয়)"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَٱلْمَلَـٰٓئِكَةِ","wal-malāikati","and the Angels","ও ফেরেশতাদের"],["وَٱلنَّاسِ","wal-nāsi","and the people","ও মানুষদের"],["أَجْمَعِينَ","ajma‘īna","all together","সকলকেই"]],"t":"أُ<s>و۟</><o>لَٰٓ</>ئِكَ جَ<o>زَآ</>ؤُهُمْ أَ<g>نَّ</> عَلَيْهِمْ لَعْنَةَ <h>ٱ</>للَّهِ وَ<h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةِ وَ<h>ٱ</><l>ل</><g>نَّ</>اسِ أَ<q>جْ</>مَ<p>عِي</>نَ"},{"n":88,"w":[["خَـٰلِدِينَ","khālidīna","(They will) abide forever","তারা চিরস্থায়ী হবে"],["فِيهَا","fīhā","in it","তার মধ্যে"],["لَا","lā","Not","না"],["يُخَفَّفُ","yukhaffafu","will be lightened","হালকা করা হবে"],["عَنْهُمُ","‘anhumu","for them","তাদের থেকে"],["ٱلْعَذَابُ","l-‘adhābu","the punishment","শাস্তি"],["وَلَا","walā","and not","আর না"],["هُمْ","hum","they","তাদের"],["يُنظَرُونَ","yunẓarūna","will be reprieved","অবকাশ দেয়া হবে"]],"t":"<m>خَٰ</>لِدِينَ فِيهَا لَا يُخَفَّفُ عَنْهُمُ <h>ٱ</>لْعَذَابُ وَلَا هُمْ يُ<k>نظَ</><p>رُو</>نَ"},{"n":89,"w":[["إِلَّا","illā","Except","তবে"],["ٱلَّذِينَ","alladhīna","those who","(ঐসব লোক) যারা"],["تَابُوا۟","tābū","repent","তওবা করেছে"],["مِنۢ","min","from","(থেকে)"],["بَعْدِ","ba‘di","after","পরে"],["ذَٰلِكَ","dhālika","that","এর"],["وَأَصْلَحُوا۟","wa-aṣlaḥū","and reform[ed] themselves","ও তারা সংশোধন করেছে (নিজেদেরকে)"],["فَإِنَّ","fa-inna","Then indeed","তখন নিশ্চয়"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["غَفُورٌۭ","ghafūrun","(is) Oft-Forgiving","বড় ক্ষমাশীল"],["رَّحِيمٌ","raḥīmun","Most Merciful","মেহেরবান"]],"t":"إِلَّا <h>ٱ</>لَّذِينَ تَابُو<s>ا۟</> <i>مِنۢ بَ</>عْدِ <m>ذَٰ</>لِكَ وَأَصْلَحُو<s>ا۟</> فَإِ<g>نَّ</> <h>ٱ</>للَّهَ غَفُو<w>رٌۭ رَّ</><p>حِي</>مٌ"},{"n":90,"w":[["إِنَّ","inna","Indeed","নিশ্চয়"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieved","অস্বীকার করেছে"],["بَعْدَ","ba‘da","after","পরে"],["إِيمَـٰنِهِمْ","īmānihim","their belief","তাদের ঈমানের"],["ثُمَّ","thumma","then","এরপর"],["ٱزْدَادُوا۟","iz'dādū","they increased","তারা বৃদ্ধি করেছে"],["كُفْرًۭا","kuf'ran","(in) disbelief","কুফরী"],["لَّن","lan","never","কক্ষণ না"],["تُقْبَلَ","tuq'bala","will be accepted","কবুল করা হবে"],["تَوْبَتُهُمْ","tawbatuhum","their repentance","তাদের তওবা"],["وَأُو۟لَـٰٓئِكَ","wa-ulāika","and those ","এবং ঐসব লোক"],["هُمُ","humu","they","তারাই"],["ٱلضَّآلُّونَ","l-ḍālūna","(are) those who have gone astray","পথভ্রষ্ট"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> بَعْدَ إِي<m>مَٰ</>نِهِمْ ثُ<g>مَّ</> <h>ٱ</>زْدَادُو<s>ا۟</> كُفْ<w>رًۭا لَّ</><k>ن تُ</><q>قْ</>بَلَ تَوْبَتُهُمْ وَأُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</><l>ل</><n>ضَّآ</><p>لُّو</>نَ"},{"n":91,"w":[["إِنَّ","inna","Indeed","নিশ্চয়"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieve[d]","কুফরী করেছে"],["وَمَاتُوا۟","wamātū","and died","এবং মরে গেছে"],["وَهُمْ","wahum","while they","এ অবস্থায় তারা (ছিল)"],["كُفَّارٌۭ","kuffārun","(are) disbelievers","কাফির"],["فَلَن","falan","then never","সেক্ষেত্রে কক্ষনো না"],["يُقْبَلَ","yuq'bala","will be accepted","কবুল করা হবে"],["مِنْ","min","from","হতে (কোন বিনিময়)"],["أَحَدِهِم","aḥadihim","any one of them","কারও তাদের"],["مِّلْءُ","mil'u","full","(যদি হয়) পূর্ণ"],["ٱلْأَرْضِ","l-arḍi","earth","পৃথিবী"],["ذَهَبًۭا","dhahaban","(of) gold","সোনা (দিয়ে)"],["وَلَوِ","walawi","[and] (even) if","এবং যদি"],["ٱفْتَدَىٰ","if'tadā","he offered as ransom","বিনিময় দেয়ও"],["بِهِۦٓ ۗ","bihi","it","তা"],["أُو۟لَـٰٓئِكَ","ulāika","Those ","ঐসব লোক"],["لَهُمْ","lahum","for them","তাদের জন্য (রয়েছে)"],["عَذَابٌ","‘adhābun","(is) a punishment","শাস্তি"],["أَلِيمٌۭ","alīmun","painful","অতি কষ্টদায়ক"],["وَمَا","wamā","and not","এবং নাই"],["لَهُم","lahum","(will be) for them","তাদের জন্য"],["مِّن","min","any","কেউ"],["نَّـٰصِرِينَ","nāṣirīna","helpers","সাহায্যকারীদের"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> وَمَاتُو<s>ا۟</> وَهُمْ كُفَّا<k>رٌۭ فَ</><d>لَن يُ</><q>قْ</>بَلَ مِنْ أَحَدِ<y>هِم مِّ</>لْءُ <h>ٱ</>لْأَرْضِ ذَهَ<d>بًۭا وَ</>لَوِ <h>ٱ</>فْتَدَىٰ بِ<o>هِۦٓ ۗ</> أُ<s>و۟</><o>لَٰٓ</>ئِكَ لَهُمْ عَذَابٌ أَلِي<d>مٌۭ وَ</>مَا لَ<y>هُم مِّ</><d>ن نَّٰ</>صِ<p>رِي</>نَ"},{"n":92,"w":[["لَن","lan","Never","কক্ষনো না"],["تَنَالُوا۟","tanālū","will you attain","তোমরা পাবে"],["ٱلْبِرَّ","l-bira","[the] righteousness","কল্যাণ"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["تُنفِقُوا۟","tunfiqū","you spend","তোমরা খরচ করবে"],["مِمَّا","mimmā","from what","তা থেকে যা"],["تُحِبُّونَ ۚ","tuḥibbūna","you love","তোমার ভালোবাস"],["وَمَا","wamā","And whatever","এবং যা"],["تُنفِقُوا۟","tunfiqū","you spend","তোমরা খরচ কর"],["مِن","min","of","(থেকে)"],["شَىْءٍۢ","shayin","a thing","কোন কিছু"],["فَإِنَّ","fa-inna","then indeed","নিশ্চয়"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["بِهِۦ","bihi","of it","সে সম্পর্কে আল্লাহ"],["عَلِيمٌۭ","‘alīmun","(is) All-Knowing","খুব অবগত"]],"t":"لَ<k>ن تَ</>نَالُو<s>ا۟</> <h>ٱ</>لْبِرَّ حَتَّىٰ تُ<k>نفِ</>قُو<s>ا۟</> مِ<g>مَّ</>ا تُحِبُّونَ ۚ وَمَا تُ<k>نفِ</>قُو<s>ا۟</> مِ<k>ن شَىْءٍۢ فَ</>إِ<g>نَّ</> <h>ٱ</>للَّهَ بِ<m>هِۦ</> عَ<p>لِي</>مٌۭ"},{"n":93,"w":[["۞ كُلُّ","kullu","All","সব"],["ٱلطَّعَامِ","l-ṭa‘āmi","[the] food","খাদ্য"],["كَانَ","kāna","was","ছিল"],["حِلًّۭا","ḥillan","lawful","হালাল"],["لِّبَنِىٓ","libanī","for (the) Children","জন্য বনী"],["إِسْرَٰٓءِيلَ","is'rāīla","(of) Israel","ইসরাঈলের"],["إِلَّا","illā","except","এছাড়া"],["مَا","mā","what","যা"],["حَرَّمَ","ḥarrama","made unlawful","হারাম করেছিল"],["إِسْرَٰٓءِيلُ","is'rāīlu","Israel","ইসরাঈল (হযরত ইয়াকুব আঃ)"],["عَلَىٰ","‘alā","upon","উপর"],["نَفْسِهِۦ","nafsihi","himself","তার নিজের"],["مِن","min","from","(থেকে)"],["قَبْلِ","qabli","before","পূর্বে"],["أَن","an","[that]","(যে)"],["تُنَزَّلَ","tunazzala","(was) revealed","নাযিল হওয়ার"],["ٱلتَّوْرَىٰةُ ۗ","l-tawrātu","the Taurat","তাওরাত"],["قُلْ","qul","Say","তুমি বল"],["فَأْتُوا۟","fatū","So bring","''তবে তোমরা আন"],["بِٱلتَّوْرَىٰةِ","bil-tawrāti","the Taurat","তাওরাত"],["فَٱتْلُوهَآ","fa-it'lūhā","and recite it","তোমরা অতঃপর পাঠ কর তা"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you are","তোমরা হও"],["صَـٰدِقِينَ","ṣādiqīna","truthful","সত্যবাদী''"]],"t":"۞ كُلُّ <h>ٱ</><l>ل</>طَّعَامِ كَانَ حِ<w>لًّۭا لِّ</>بَ<o>نِىٓ</> إِسْ<o>رَٰٓ</>ءِيلَ إِلَّا مَا حَرَّمَ إِسْ<o>رَٰٓ</>ءِيلُ عَلَىٰ نَفْسِ<m>هِۦ</> مِ<k>ن قَ</><q>بْ</>لِ أَ<k>ن تُ</>نَزَّلَ <h>ٱ</><l>ل</>تَّوْرَ<m>ىٰ</>ةُ ۗ قُلْ فَأْتُو<s>ا۟</> بِ<h>ٱ</><l>ل</>تَّوْرَ<m>ىٰ</>ةِ فَ<h>ٱ</>تْلُو<o>هَآ</> إِ<k>ن كُنتُ</>مْ <m>صَٰ</>دِ<p>قِي</>نَ"},{"n":94,"w":[["فَمَنِ","famani","Then whoever","যে অতঃপর"],["ٱفْتَرَىٰ","if'tarā","fabricates","আরোপ করে"],["عَلَى","‘alā","about","উপর"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["ٱلْكَذِبَ","l-kadhiba","[the] lie","মিথ্যা"],["مِنۢ","min","from","(থেকে)"],["بَعْدِ","ba‘di","after","পরেও"],["ذَٰلِكَ","dhālika","that","এর"],["فَأُو۟لَـٰٓئِكَ","fa-ulāika","then those ","ফলে ঐ সব লোক"],["هُمُ","humu","they","তারাই"],["ٱلظَّـٰلِمُونَ","l-ẓālimūna","(are) the wrongdoers","জালিম"]],"t":"فَمَنِ <h>ٱ</>فْتَرَىٰ عَلَى <h>ٱ</>للَّهِ <h>ٱ</>لْكَذِبَ <i>مِنۢ بَ</>عْدِ <m>ذَٰ</>لِكَ فَأُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مُو</>نَ"},{"n":95,"w":[["قُلْ","qul","Say","তুমি বল"],["صَدَقَ","ṣadaqa","(has) spoken the truth","সত্য বলেছেন"],["ٱللَّهُ ۗ","l-lahu","Allah","আল্লাহ"],["فَٱتَّبِعُوا۟","fa-ittabi‘ū","then follow","তোমরা অতঃপর অনুসরণ কর"],["مِلَّةَ","millata","(the) religion","পন্থা"],["إِبْرَٰهِيمَ","ib'rāhīma","(of) Ibrahim","ইব্রাহীমের"],["حَنِيفًۭا","ḥanīfan","(the) upright","একমুখী হয়ে"],["وَمَا","wamā","and not","এবং না"],["كَانَ","kāna","he was","সে ছিল"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْمُشْرِكِينَ","l-mush'rikīna","the polytheists","মুশরিকদের"]],"t":"قُلْ صَدَقَ <h>ٱ</>للَّهُ ۗ فَ<h>ٱ</>تَّبِعُو<s>ا۟</> مِلَّةَ إِ<q>بْ</><m>رَٰ</>هِيمَ حَنِي<d>فًۭا وَ</>مَا كَانَ مِنَ <h>ٱ</>لْمُشْرِ<p>كِي</>نَ"},{"n":96,"w":[["إِنَّ","inna","Indeed","নিশ্চয়"],["أَوَّلَ","awwala","(the) First","প্রথম"],["بَيْتٍۢ","baytin","House","ঘর"],["وُضِعَ","wuḍi‘a","set up","তৈরি করা হয়েছিল"],["لِلنَّاسِ","lilnnāsi","for the mankind","লোকদের জন্য"],["لَلَّذِى","lalladhī","(is) the one which","যা অবশ্যই"],["بِبَكَّةَ","bibakkata","(is) at Bakkah","মক্কায় (অবস্থিত)"],["مُبَارَكًۭا","mubārakan","blessed","বরকতময়"],["وَهُدًۭى","wahudan","and a guidance","ও হিদায়াতের (কেন্দ্র)"],["لِّلْعَـٰلَمِينَ","lil'‘ālamīna","for the worlds","বিশ্ববাসীদের জন্য"]],"t":"إِ<g>نَّ</> أَوَّلَ بَيْ<d>تٍۢ وُ</>ضِعَ لِل<g>نَّ</>اسِ لَلَّذِى بِبَكَّةَ مُبَارَ<d>كًۭا وَ</>هُ<w>دًۭى لِّ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":97,"w":[["فِيهِ","fīhi","In it","তার মধ্যে (আছে)"],["ءَايَـٰتٌۢ","āyātun","(are) signs","নিদর্শনাবলী"],["بَيِّنَـٰتٌۭ","bayyinātun","clear","সুস্পষ্ট"],["مَّقَامُ","maqāmu","standing place","মাকামে"],["إِبْرَٰهِيمَ ۖ","ib'rāhīma","(of) Ibrahim","ইব্রাহীম"],["وَمَن","waman","and whoever","এবং যে"],["دَخَلَهُۥ","dakhalahu","enters it ","তাতে প্রবেশ করল"],["كَانَ","kāna","is","সে হল"],["ءَامِنًۭا ۗ","āminan","safe","নিরাপদ"],["وَلِلَّهِ","walillahi","And (due) to Allah","এবং আল্লাহরই জন্য"],["عَلَى","‘alā","upon","উপর"],["ٱلنَّاسِ","l-nāsi","the mankind","লোকদের"],["حِجُّ","ḥijju","(is) pilgrimage","হজ্জ করা (ফরজ)"],["ٱلْبَيْتِ","l-bayti","(of) the House","ঐ ঘরের"],["مَنِ","mani","(for one) who","(তারাক্ষেত্রে) সে"],["ٱسْتَطَاعَ","is'taṭā‘a","is able","সমর্থ রাখে"],["إِلَيْهِ","ilayhi","to [it]","তার কাছে (পৌঁছুবার)"],["سَبِيلًۭا ۚ","sabīlan","(find) a way","উপকরণের"],["وَمَن","waman","And whoever","এবং যে"],["كَفَرَ","kafara","disbelieved","অস্বীকার করল"],["فَإِنَّ","fa-inna","then indeed","তবে নিশ্চয়"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["غَنِىٌّ","ghaniyyun","(is) free from need","মুখাপেক্ষীহীন"],["عَنِ","‘ani","of","থেকে"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","the universe","দুনিয়াবাসীদের"]],"t":"فِيهِ ءَا<m>يَٰ</><i>تٌۢ بَ</>يِّ<m>نَٰ</><d>تٌۭ مَّ</>قَامُ إِ<q>بْ</><m>رَٰ</>هِيمَ ۖ وَمَ<k>ن دَ</>خَلَهُ<m>ۥ</> كَانَ ءَامِ<d>نًۭا ۗ وَ</>لِلَّهِ عَلَى <h>ٱ</><l>ل</><g>نَّ</>اسِ حِجُّ <h>ٱ</>لْبَيْتِ مَنِ <h>ٱ</>سْتَطَاعَ إِلَيْهِ سَبِيلًۭ<d>ا ۚ وَ</>مَ<k>ن كَ</>فَرَ فَإِ<g>نَّ</> <h>ٱ</>للَّهَ غَنِىٌّ ع