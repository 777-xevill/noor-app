{"n":79,"a":[{"n":1,"w":[["وَٱلنَّـٰزِعَـٰتِ","wal-nāzi‘āti","By those who extract","শপথ সজোরে (প্রাণ) নির্গতকারী (ফেরেশতাদের)"],["غَرْقًۭا","gharqan","violently","(যারা নির্গত করে) ডুবে"]],"t":"وَ<h>ٱ</><l>ل</><g>نَّٰ</>زِ<m>عَٰ</>تِ غَرْقًۭا"},{"n":2,"w":[["وَٱلنَّـٰشِطَـٰتِ","wal-nāshiṭāti","And those who draw out","শপথ (আত্মার) বাঁধন উন্মুক্তকারী (ফেরেশতাদের)"],["نَشْطًۭا","nashṭan","gently","(যারা মৃদুভাবে) উন্মুক্ত (করে)"]],"t":"وَ<h>ٱ</><l>ل</><g>نَّٰ</>شِ<m>طَٰ</>تِ نَشْطًۭا"},{"n":3,"w":[["وَٱلسَّـٰبِحَـٰتِ","wal-sābiḥāti","And those who glide","শপথ সাঁতারকারী (ফেরেশতাদের)"],["سَبْحًۭا","sabḥan","swimming","(যারা তীব্র গতিতে) সাঁতরায়"]],"t":"وَ<h>ٱ</><l>ل</><m>سَّٰبِحَٰ</>تِ سَ<q>بْ</>حًۭا"},{"n":4,"w":[["فَٱلسَّـٰبِقَـٰتِ","fal-sābiqāti","And those who race each other","অতঃপর (শপথ) অগ্রগামী (ফেরেশতাদের)"],["سَبْقًۭا","sabqan","(in) a race","দ্রুতবেগে"]],"t":"فَ<h>ٱ</><l>ل</><m>سَّٰبِقَٰ</>تِ سَ<q>بْ</>قًۭا"},{"n":5,"w":[["فَٱلْمُدَبِّرَٰتِ","fal-mudabirāti","And those who arrange","অতঃপর (শপথ) কার্যনির্বাহী (ফেরেশতাদের)"],["أَمْرًۭا","amran","(the) matter","(যারা পরিচালনা করে) কর্ম"]],"t":"فَ<h>ٱ</>لْمُدَبِّ<m>رَٰ</>تِ أَمْرًۭا"},{"n":6,"w":[["يَوْمَ","yawma","(The) Day","সেদিন"],["تَرْجُفُ","tarjufu","will quake","প্রকম্পিত করবে"],["ٱلرَّاجِفَةُ","l-rājifatu","the quaking one","প্রথম শিংগাধ্বনি"]],"t":"يَوْمَ تَرْجُفُ <h>ٱ</><l>ل</>رَّاجِفَةُ"},{"n":7,"w":[["تَتْبَعُهَا","tatba‘uhā","Follows it","তার অনুসরণ করবে"],["ٱلرَّادِفَةُ","l-rādifatu","the subsequent","(আরো একটি) শিংগাধ্বনি"]],"t":"تَتْبَعُهَا <h>ٱ</><l>ل</>رَّادِفَةُ"},{"n":8,"w":[["قُلُوبٌۭ","qulūbun","Hearts","(কতিপয়) হৃদয়"],["يَوْمَئِذٍۢ","yawma-idhin","that Day","সেদিন"],["وَاجِفَةٌ","wājifatun","will palpitate","ভীত-কম্পিত (হবে)"]],"t":"قُلُو<d>بٌۭ يَ</>وْمَئِ<d>ذٍۢ وَ</>اجِفَةٌ"},{"n":9,"w":[["أَبْصَـٰرُهَا","abṣāruhā","Their eyes","তার দৃষ্টি সমূহ"],["خَـٰشِعَةٌۭ","khāshi‘atun","humbled","ভীতসন্ত্রস্ত (হবে)"]],"t":"أَ<q>بْ</><m>صَٰ</>رُهَا <m>خَٰ</>شِعَةٌۭ"},{"n":10,"w":[["يَقُولُونَ","yaqūlūna","They say","তারা বলে"],["أَءِنَّا","a-innā","Will we","\"অবশ্যই কি আমরা"],["لَمَرْدُودُونَ","lamardūdūna","indeed be returned","অবশ্যই প্রত্যাবর্তিত হবো"],["فِى","fī","to","মধ্যে"],["ٱلْحَافِرَةِ","l-ḥāfirati","the former state","পূর্বাবস্থার"]],"t":"يَقُولُونَ أَءِ<g>نَّ</>ا لَمَرْدُودُونَ فِى <h>ٱ</>لْحَافِرَةِ"},{"n":11,"w":[["أَءِذَا","a-idhā","What! When","যখন কি"],["كُنَّا","kunnā","we are","আমরা হবো (পরিণত)"],["عِظَـٰمًۭا","‘iẓāman","bones","হাড়গুলোয়"],["نَّخِرَةًۭ","nakhiratan","decayed","গলিত\""]],"t":"أَءِذَا كُ<g>نَّ</>ا عِ<m>ظَٰ</><d>مًۭا نَّ</>خِرَةًۭ"},{"n":12,"w":[["قَالُوا۟","qālū","They say","তারা বলল"],["تِلْكَ","til'ka","This","\"এটা"],["إِذًۭا","idhan","then","তা হলে"],["كَرَّةٌ","karratun","(would be) a return","প্রত্যাবর্তন"],["خَاسِرَةٌۭ","khāsiratun","losing","বড়ই ক্ষতিকর (হবে)\""]],"t":"قَالُو<s>ا۟</> تِلْكَ إِ<k>ذًۭا كَ</>رَّةٌ خَاسِرَةٌۭ"},{"n":13,"w":[["فَإِنَّمَا","fa-innamā","Then only","প্রকৃতপক্ষে"],["هِىَ","hiya","it","তা"],["زَجْرَةٌۭ","zajratun","(will be) a shout","বিকট আওয়াজ"],["وَٰحِدَةٌۭ","wāḥidatun","single","একটি মাত্র"]],"t":"فَإِ<g>نَّ</>مَا هِىَ زَ<q>جْ</>رَ<d>ةٌۭ وَٰ</>حِدَةٌۭ"},{"n":14,"w":[["فَإِذَا","fa-idhā","And behold","অতঃপর তখনই"],["هُم","hum","They","তারা"],["بِٱلسَّاهِرَةِ","bil-sāhirati","(will be) awakened","খোলা ময়দানে (হবে)"]],"t":"فَإِذَا <f>هُم بِ</><h>ٱ</><l>ل</>سَّاهِرَةِ"},{"n":15,"w":[["هَلْ","hal","Has","কি"],["أَتَىٰكَ","atāka","(there) come to you","তোমার কাছে এসেছে"],["حَدِيثُ","ḥadīthu","(the) story","বৃত্তান্ত"],["مُوسَىٰٓ","mūsā","(of) Musa","মূসার"]],"t":"هَلْ أَتَ<m>ىٰ</>كَ حَدِيثُ مُوسَىٰٓ"},{"n":16,"w":[["إِذْ","idh","When","যখন"],["نَادَىٰهُ","nādāhu","called him","তাকে ডেকেছিলেন"],["رَبُّهُۥ","rabbuhu","his Lord","তার রব"],["بِٱلْوَادِ","bil-wādi","in the valley","উপত্যকায়"],["ٱلْمُقَدَّسِ","l-muqadasi","the sacred","পবিত্র"],["طُوًى","ṭuwan","(of) Tuwa","তুয়ার"]],"t":"إِذْ نَادَ<m>ىٰ</>هُ رَبُّهُ<m>ۥ</> بِ<h>ٱ</>لْوَادِ <h>ٱ</>لْمُقَدَّسِ طُوًى"},{"n":17,"w":[["ٱذْهَبْ","idh'hab","Go","\"(আল্লাহ বললেন তাকে) যাও"],["إِلَىٰ","ilā","to","নিকট"],["فِرْعَوْنَ","fir'‘awna","Firaun","ফিরআউনের"],["إِنَّهُۥ","innahu","Indeed, he","সে নিশ্চয়ই"],["طَغَىٰ","ṭaghā","(has) transgressed","সীমালঙ্ঘন করেছে"]],"t":"ٱذْهَ<q>بْ</> إِلَىٰ فِرْعَوْنَ إِ<g>نَّ</>هُ<m>ۥ</> طَغَىٰ"},{"n":18,"w":[["فَقُلْ","faqul","And say","অতঃপর বল"],["هَل","hal","Would","\"(আছে) কি"],["لَّكَ","laka","[for] you","তোমার (আগ্রহ)"],["إِلَىٰٓ","ilā","[to]","(এর) প্রতি"],["أَن","an","[that]","যে"],["تَزَكَّىٰ","tazakkā","purify yourself","তুমি পবিত্র হবে"]],"t":"فَقُلْ هَل لَّكَ إِلَ<o>ىٰٓ</> أَ<k>ن تَ</>زَكَّىٰ"},{"n":19,"w":[["وَأَهْدِيَكَ","wa-ahdiyaka","And I will guide you","এবং তোমাকে আমি পথ দেখাবো"],["إِلَىٰ","ilā","to","দিকে"],["رَبِّكَ","rabbika","your Lord","তোমার রবের"],["فَتَخْشَىٰ","fatakhshā","so you would fear","তুমি যেন ভয় করো\""]],"t":"وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ"},{"n":20,"w":[["فَأَرَىٰهُ","fa-arāhu","Then he showed him","অতঃপর  সে তাকে দেখালো"],["ٱلْـَٔايَةَ","l-āyata","the sign","একটি নিদর্শন"],["ٱلْكُبْرَىٰ","l-kub'rā","the great","বড়"]],"t":"فَأَرَ<m>ىٰ</>هُ <h>ٱ</>لْءَايَةَ <h>ٱ</>لْكُ<q>بْ</>رَىٰ"},{"n":21,"w":[["فَكَذَّبَ","fakadhaba","But he denied","কিন্তু সে মিথ্যারোপ করলো"],["وَعَصَىٰ","wa‘aṣā","and disobeyed","এবং অবাধ্য হলো"]],"t":"فَكَذَّبَ وَعَصَىٰ"},{"n":22,"w":[["ثُمَّ","thumma","Then","এর পরে"],["أَدْبَرَ","adbara","he turned his back","পিঠ ফিরালো"],["يَسْعَىٰ","yas‘ā","striving","(প্রতিকারে) সচেষ্ট হলো"]],"t":"ثُ<g>مَّ</> أَ<q>دْ</>بَرَ يَسْعَىٰ"},{"n":23,"w":[["فَحَشَرَ","faḥashara","And he gathered","পরে সমবেত করল"],["فَنَادَىٰ","fanādā","and called out","আর ঘোষণা করল"]],"t":"فَحَشَرَ فَنَادَىٰ"},{"n":24,"w":[["فَقَالَ","faqāla","Then he said","অতঃপর বললো"],["أَنَا۠","anā","I am","\"আমি"],["رَبُّكُمُ","rabbukumu","your Lord","তোমাদের রব"],["ٱلْأَعْلَىٰ","l-a‘lā","the Most High","সর্বশ্রেষ্ঠ\""]],"t":"فَقَالَ أَنَا۠ رَبُّكُمُ <h>ٱ</>لْأَعْلَىٰ"},{"n":25,"w":[["فَأَخَذَهُ","fa-akhadhahu","So seized him","তখন তাকে ধরলেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["نَكَالَ","nakāla","(with) an exemplary punishment","শাস্তি (দিয়ে)"],["ٱلْـَٔاخِرَةِ","l-ākhirati","(for) the last","আখেরাতের"],["وَٱلْأُولَىٰٓ","wal-ūlā","and the first","ও দুনিয়ার"]],"t":"فَأَخَذَهُ <h>ٱ</>للَّهُ نَكَالَ <h>ٱ</>لْءَاخِرَةِ وَ<h>ٱ</>لْأُولَىٰٓ"},{"n":26,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে আছে"],["ذَٰلِكَ","dhālika","that","এর"],["لَعِبْرَةًۭ","la‘ib'ratan","surely (is) a lesson","অবশ্যই শিক্ষা"],["لِّمَن","liman","for whoever","তার জন্যে যে"],["يَخْشَىٰٓ","yakhshā","fears","ভয় করে"]],"t":"إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَعِ<q>بْ</>رَ<w>ةًۭ لِّ</><d>مَن يَ</>خْشَىٰٓ"},{"n":27,"w":[["ءَأَنتُمْ","a-antum","Are you","তোমরা কি"],["أَشَدُّ","ashaddu","a more difficult","কঠিনতর"],["خَلْقًا","khalqan","creation","সৃষ্টি"],["أَمِ","ami","or","নাকি"],["ٱلسَّمَآءُ ۚ","l-samāu","the heaven","আকাশ"],["بَنَىٰهَا","banāhā","He constructed it","তা তিনি নির্মাণ করেছেন"]],"t":"ءَأَ<k>نتُ</>مْ أَشَدُّ خَلْقًا أَمِ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءُ ۚ بَنَ<m>ىٰ</>هَا"},{"n":28,"w":[["رَفَعَ","rafa‘a","He raised","তিনি উঁচু করেছেন"],["سَمْكَهَا","samkahā","its ceiling","তার উচ্চতর স্তরকে (ছাদ)"],["فَسَوَّىٰهَا","fasawwāhā","and proportioned it","অতঃপর তিনি তা সুবিন্যস্ত করেছেন"]],"t":"رَفَعَ سَمْكَهَا فَسَوَّ<m>ىٰ</>هَا"},{"n":29,"w":[["وَأَغْطَشَ","wa-aghṭasha","And He darkened","এবং অন্ধকারাচ্ছন্ন করেছেন"],["لَيْلَهَا","laylahā","its night","তার রাতকে"],["وَأَخْرَجَ","wa-akhraja","and brought out","এবং বের করেছেন"],["ضُحَىٰهَا","ḍuḥāhā","its brightness","তার সূর্যের আলো"]],"t":"وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَ<m>ىٰ</>هَا"},{"n":30,"w":[["وَٱلْأَرْضَ","wal-arḍa","And the earth","এবং পৃথিবীকে"],["بَعْدَ","ba‘da","after","পরে"],["ذَٰلِكَ","dhālika","that","এর"],["دَحَىٰهَآ","daḥāhā","He spread it","তা বিস্তৃত করেছেন"]],"t":"وَ<h>ٱ</>لْأَرْضَ بَعْدَ <m>ذَٰ</>لِكَ دَحَ<m>ىٰ</>هَآ"},{"n":31,"w":[["أَخْرَجَ","akhraja","He brought forth","বের করেছেন"],["مِنْهَا","min'hā","from it","তা হতে"],["مَآءَهَا","māahā","its water","তার পানি"],["وَمَرْعَىٰهَا","wamar‘āhā","and its pasture","ও তার উদ্ভিদ/ তৃণ"]],"t":"أَخْرَجَ مِنْهَا <o>مَآ</>ءَهَا وَمَرْعَ<m>ىٰ</>هَا"},{"n":32,"w":[["وَٱلْجِبَالَ","wal-jibāla","And the mountains","এবং পর্বতমালাকে"],["أَرْسَىٰهَا","arsāhā","He made them firm","তা দৃঢ়ভাবে প্রোথিত করেছেন"]],"t":"وَ<h>ٱ</>لْجِبَالَ أَرْسَ<m>ىٰ</>هَا"},{"n":33,"w":[["مَتَـٰعًۭا","matā‘an","(As) a provision","জীবিকা সামগ্রীরূপে"],["لَّكُمْ","lakum","for you","তোমাদের জন্য"],["وَلِأَنْعَـٰمِكُمْ","wali-an‘āmikum","and for your cattle","এবং তোমাদের গৃহপালিত পশুর জন্য"]],"t":"مَ<m>تَٰ</><w>عًۭا لَّ</>كُمْ وَلِأَنْ<m>عَٰ</>مِكُمْ"},{"n":34,"w":[["فَإِذَا","fa-idhā","But when","অতঃপর যখন"],["جَآءَتِ","jāati","comes","আসবে"],["ٱلطَّآمَّةُ","l-ṭāmatu","the Overwhelming Calamity","মহাসংকট"],["ٱلْكُبْرَىٰ","l-kub'rā","the great","মহা"]],"t":"فَإِذَا <o>جَآ</>ءَتِ <h>ٱ</><l>ل</><n>طَّآ</><g>مَّ</>ةُ <h>ٱ</>لْكُ<q>بْ</>رَىٰ"},{"n":35,"w":[["يَوْمَ","yawma","(The) Day","সেদিন"],["يَتَذَكَّرُ","yatadhakkaru","will remember","স্মরণ করবে"],["ٱلْإِنسَـٰنُ","l-insānu","man","মানুষ"],["مَا","mā","what","যা"],["سَعَىٰ","sa‘ā","he strove (for)","সে চেষ্টা করেছিল"]],"t":"يَوْمَ يَتَذَكَّرُ <h>ٱ</>لْإِ<k>نسَٰ</>نُ مَا سَعَىٰ"},{"n":36,"w":[["وَبُرِّزَتِ","waburrizati","And will be made manifest","এবং প্রকাশ করা হবে"],["ٱلْجَحِيمُ","l-jaḥīmu","the Hellfire","জাহান্নাম"],["لِمَن","liman","to (him) who","তার জন্যে যে"],["يَرَىٰ","yarā","sees","দেখে"]],"t":"وَبُرِّزَتِ <h>ٱ</>لْجَحِيمُ لِ<d>مَن يَ</>رَىٰ"},{"n":37,"w":[["فَأَمَّا","fa-ammā","Then as for","অনন্তর"],["مَن","man","(him) who","যে"],["طَغَىٰ","ṭaghā","transgressed","সীমালঙ্ঘন করেছে"]],"t":"فَأَ<g>مَّ</>ا مَ<k>ن طَ</>غَىٰ"},{"n":38,"w":[["وَءَاثَرَ","waāthara","And preferred","এবং অগ্রাধিকার দিয়েছে"],["ٱلْحَيَوٰةَ","l-ḥayata","the life","জীবনকে"],["ٱلدُّنْيَا","l-dun'yā","(of) the world","দুনিয়ার"]],"t":"وَءَاثَرَ <h>ٱ</>لْحَيَ<s>وٰ</>ةَ <h>ٱ</><l>ل</>دُّنْيَا"},{"n":39,"w":[["فَإِنَّ","fa-inna","Then indeed","অতঃপর নিশ্চয়ই"],["ٱلْجَحِيمَ","l-jaḥīma","the Hellfire","দোযখই (হবে)"],["هِىَ","hiya","it","তাই"],["ٱلْمَأْوَىٰ","l-mawā","(is) the refuge","(তার) বাসস্থান"]],"t":"فَإِ<g>نَّ</> <h>ٱ</>لْجَحِيمَ هِىَ <h>ٱ</>لْمَأْوَىٰ"},{"n":40,"w":[["وَأَمَّا","wa-ammā","But as for","অপরদিকে"],["مَنْ","man","(him) who","যে"],["خَافَ","khāfa","feared","ভয় করেছে"],["مَقَامَ","maqāma","standing","দাঁড়াতে"],["رَبِّهِۦ","rabbihi","(before) his Lord","তার রবের সামনে"],["وَنَهَى","wanahā","and restrained","এবং বিরত রেখেছে"],["ٱلنَّفْسَ","l-nafsa","his soul","প্রবৃত্তিকে"],["عَنِ","‘ani","from","হতে"],["ٱلْهَوَىٰ","l-hawā","the vain desires","খারাপ কামনা"]],"t":"وَأَ<g>مَّ</>ا مَنْ خَافَ مَقَامَ رَبِّ<m>هِۦ</> وَنَهَى <h>ٱ</><l>ل</><g>نَّ</>فْسَ عَنِ <h>ٱ</>لْهَوَىٰ"},{"n":41,"w":[["فَإِنَّ","fa-inna","Then indeed","অতঃপর নিশ্চয়ই"],["ٱلْجَنَّةَ","l-janata","Paradise ","জান্নাত (হবে)"],["هِىَ","hiya","it (is)","তাই"],["ٱلْمَأْوَىٰ","l-mawā","the refuge","(তার) বাসস্থান"]],"t":"فَإِ<g>نَّ</> <h>ٱ</>لْجَ<g>نَّ</>ةَ هِىَ <h>ٱ</>لْمَأْوَىٰ"},{"n":42,"w":[["يَسْـَٔلُونَكَ","yasalūnaka","They ask you","তারা তোমাকে জিজ্ঞাসা করে"],["عَنِ","‘ani","about","সম্পর্কে"],["ٱلسَّاعَةِ","l-sā‘ati","the Hour","কিয়ামত"],["أَيَّانَ","ayyāna","when","কখন"],["مُرْسَىٰهَا","mur'sāhā","(is) its arrival","তা ঘটবে"]],"t":"يَسْـَٔلُونَكَ عَنِ <h>ٱ</><l>ل</>سَّاعَةِ أَيَّانَ مُرْسَ<m>ىٰ</>هَا"},{"n":43,"w":[["فِيمَ","fīma","In what","সে ব্যাপারে"],["أَنتَ","anta","(are) you","তোমার (কী সম্পর্ক)"],["مِن","min","[of]","সঙ্গে"],["ذِكْرَىٰهَآ","dhik'rāhā","(to) mention it","তার উল্লেখ করার"]],"t":"فِيمَ أَ<k>نتَ</> مِ<k>ن ذِ</>كْرَ<m>ىٰ</>هَآ"},{"n":44,"w":[["إِلَىٰ","ilā","To","নিকট"],["رَبِّكَ","rabbika","your Lord","তোমার রবের"],["مُنتَهَىٰهَآ","muntahāhā","(is) its finality","তার চূড়ান্ত (জ্ঞান)"]],"t":"إِلَىٰ رَبِّكَ مُ<k>نتَ</>هَ<m>ىٰ</>هَآ"},{"n":45,"w":[["إِنَّمَآ","innamā","Only","কেবল"],["أَنتَ","anta","you","তুমি"],["مُنذِرُ","mundhiru","(are) a warner","সতর্ককারী (মাত্র)"],["مَن","man","(for him) who","যে"],["يَخْشَىٰهَا","yakhshāhā","fears it","তা ভয় করে"]],"t":"إِ<g>نَّ</><o>مَآ</> أَ<k>نتَ</> مُ<k>نذِ</>رُ <d>مَن يَ</>خْشَ<m>ىٰ</>هَا"},{"n":46,"w":[["كَأَنَّهُمْ","ka-annahum","As though they","তারা যেন"],["يَوْمَ","yawma","(the) Day","যেদিন"],["يَرَوْنَهَا","yarawnahā","they see it","তা দেখবে (মনে করবে)"],["لَمْ","lam","not","করে নি"],["يَلْبَثُوٓا۟","yalbathū","they had remained","তারা অবস্থান"],["إِلَّا","illā","except","এ ছাড়া"],["عَشِيَّةً","‘ashiyyatan","an evening","এক সন্ধ্যা"],["أَوْ","aw","or","অথবা"],["ضُحَىٰهَا","ḍuḥāhā","a morning thereof","তার এক সকাল"]],"t":"كَأَ<g>نَّ</>هُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَ<o>ثُوٓ</><s>ا۟</> إِلَّا عَشِيَّةً أَوْ ضُحَ<m>ىٰ</>هَا"}]}