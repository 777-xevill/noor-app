{"n":53,"a":[{"n":1,"w":[["وَٱلنَّجْمِ","wal-najmi","By the star","শপথ তারকার"],["إِذَا","idhā","when","যখন"],["هَوَىٰ","hawā","it goes down","অস্তমিত হয়"]],"t":"وَ<h>ٱ</><l>ل</><g>نَّ</><q>جْ</>مِ إِذَا هَوَىٰ"},{"n":2,"w":[["مَا","mā","Not","না"],["ضَلَّ","ḍalla","has strayed","পথভ্রষ্ট হয়েছে"],["صَاحِبُكُمْ","ṣāḥibukum","your companion","তোমাদের সঙ্গী"],["وَمَا","wamā","and not","আর না"],["غَوَىٰ","ghawā","has he erred","বিপথগামী হয়েছে"]],"t":"مَا ضَلَّ صَاحِبُكُمْ وَمَا غَوَىٰ"},{"n":3,"w":[["وَمَا","wamā","And not","এবং না"],["يَنطِقُ","yanṭiqu","he speaks","সে কথা বলে"],["عَنِ","‘ani","from","হতে"],["ٱلْهَوَىٰٓ","l-hawā","the desire","প্রবৃত্তির তাড়না"]],"t":"وَمَا يَ<k>نطِ</>قُ عَنِ <h>ٱ</>لْهَوَىٰٓ"},{"n":4,"w":[["إِنْ","in","Not","নয়"],["هُوَ","huwa","it","তা"],["إِلَّا","illā","(is) except","এছাড়া"],["وَحْىٌۭ","waḥyun","a revelation","ওহী"],["يُوحَىٰ","yūḥā","revealed","অবতীর্ণ করা হয় (যা)"]],"t":"إِنْ هُوَ إِلَّا وَحْ<d>ىٌۭ يُ</>وحَىٰ"},{"n":5,"w":[["عَلَّمَهُۥ","‘allamahu","Has taught him","তাকে শিক্ষা দিয়েছে"],["شَدِيدُ","shadīdu","the (one) mighty","(জিবরাইল) অত্যন্তপ্রবল"],["ٱلْقُوَىٰ","l-quwā","(in) power","শক্তিতে"]],"t":"عَلَّمَهُ<m>ۥ</> شَدِيدُ <h>ٱ</>لْقُوَىٰ"},{"n":6,"w":[["ذُو","dhū","Possessor of soundness","আছে"],["مِرَّةٍۢ","mirratin","Possessor of soundness","কৌশলসম্পন্ন"],["فَٱسْتَوَىٰ","fa-is'tawā","And he rose","অতঃপর সে স্থির হয়ে (দাঁড়িয়ে) ছিল"]],"t":"ذُو مِرَّ<k>ةٍۢ فَ</><h>ٱ</>سْتَوَىٰ"},{"n":7,"w":[["وَهُوَ","wahuwa","While he","এমতাবস্থায় সে (ছিল)"],["بِٱلْأُفُقِ","bil-ufuqi","(was) in the horizon ","দিগন্তে"],["ٱلْأَعْلَىٰ","l-a‘lā","the highest","ঊর্ধ্ব"]],"t":"وَهُوَ بِ<h>ٱ</>لْأُفُقِ <h>ٱ</>لْأَعْلَىٰ"},{"n":8,"w":[["ثُمَّ","thumma","Then","এরপর"],["دَنَا","danā","he approached","সে কাছে এল"],["فَتَدَلَّىٰ","fatadallā","and came down","অতঃপর শূন্যে ভেসে রইল"]],"t":"ثُ<g>مَّ</> دَنَا فَتَدَلَّىٰ"},{"n":9,"w":[["فَكَانَ","fakāna","And was","ফলে সে হল"],["قَابَ","qāba","(at) a distance","দূরত্বে"],["قَوْسَيْنِ","qawsayni","(of) two