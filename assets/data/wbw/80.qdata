{"n":80,"a":[{"n":1,"w":[["عَبَسَ","‘abasa","He frowned","সে ভ্রুকুঞ্চিত করল"],["وَتَوَلَّىٰٓ","watawallā","and turned away","ও (মুখ ফিরালো) অনাগ্রহ দেখালো"]],"t":"عَبَسَ وَتَوَلَّىٰٓ"},{"n":2,"w":[["أَن","an","Because","(এ জন্যে) যে"],["جَآءَهُ","jāahu","came to him","তার (কাছে) এসেছে"],["ٱلْأَعْمَىٰ","l-a‘mā","the blind man","এক অন্ধ"]],"t":"أَ<k>ن جَ</><o>آ</>ءَهُ <h>ٱ</>لْأَعْمَىٰ"},{"n":3,"w":[["وَمَا","wamā","But what","এবং কিসে"],["يُدْرِيكَ","yud'rīka","would make you know","তোমাকে জানাবে"],["لَعَلَّهُۥ","la‘allahu","that he might","সে হয়তো"],["يَزَّكَّىٰٓ","yazzakkā","purify himself","পরিশুদ্ধ হতো"]],"t":"وَمَا يُ<q>دْ</>رِيكَ لَعَلَّهُ<m>ۥ</> يَزَّكَّىٰٓ"},{"n":4,"w":[["أَوْ","aw","Or","বা"],["يَذَّكَّرُ","yadhakkaru","be reminded","উপদেশ গ্রহণ করতো"],["فَتَنفَعَهُ","fatanfa‘ahu","so would benefit him","তাকে অতঃপর উপকার দিত"],["ٱلذِّكْرَىٰٓ","l-dhik'rā","the reminder","উপদেশ"]],"t":"أَوْ يَذَّكَّرُ فَتَ<k>نفَ</>عَهُ <h>ٱ</><l>ل</>ذِّكْرَىٰٓ"},{"n":5,"w":[["أَمَّا","ammā","As for","পক্ষান্তরে"],["مَنِ","mani","(him) who","যে"],["ٱسْتَغْنَىٰ","is'taghnā","considers himself free from need","বেপরোয়া হলো (উন্নাসিকতা দেখালো)"]],"t":"أَ<g>مَّ</>ا مَنِ <h>ٱ</>سْتَغْنَىٰ"},{"n":6,"w":[["فَأَنتَ","fa-anta","So you","অথচ তুমি"],["لَهُۥ","lahu","to him","তার জন্যে"],["تَصَدَّىٰ","taṣaddā","give attention","মনযোগ দিচ্ছো"]],"t":"فَأَ<k>نتَ</> لَهُ<m>ۥ</> تَصَدَّىٰ"},{"n":7,"w":[["وَمَا","wamā","And not","কিন্তু নাই"],["عَلَيْكَ","‘alayka","upon you","তোমার উপর (দায়িত্ব)"],["أَلَّا","allā","that not","যদি না"],["يَزَّكَّىٰ","yazzakkā","he purifies himself","সে পরিশুদ্ধ হয়"]],"t":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ"},{"n":8,"w":[["وَأَمَّا","wa-ammā","But as for","আর অন্যপক্ষে"],["مَن","man","(he) who","যে"],["جَآءَكَ","jāaka","came to you","তোমার কাছে আসল"],["يَسْعَىٰ","yas‘ā","striving","দৌড়ে"]],"t":"وَأَ<g>مَّ</>ا مَ<k>ن جَ</><o>آ</>ءَكَ يَسْعَىٰ"},{"n":9,"w":[["وَهُوَ","wahuwa","While he","এবং সে"],["يَخْشَىٰ","yakhshā","fears","ভয় করে"]],"t":"وَهُوَ يَخْشَىٰ"},{"n":10,"w":[["فَأَنتَ","fa-anta","But you","অথচ তুমি"],["عَنْهُ","‘anhu","from him","তার থেকে"],["تَلَهَّىٰ","talahhā","(are) distracted","অনীহা প্রকাশ করছ"]],"t":"فَأَ<k>نتَ</> عَنْهُ تَلَهَّىٰ"},{"n":11,"w":[["كَلَّآ","kallā","Nay","কখনও না"],["إِنَّهَا","innahā","Indeed, it","নিশ্চয়ই তা"],["تَذْكِرَةٌۭ","tadhkiratun","(is) a reminder","উপদেশ"]],"t":"كَ<o>لَّآ</> إِ<g>نَّ</>هَا تَذْكِرَةٌۭ"},{"n":12,"w":[["فَمَن","faman","So whosoever","অতএব যে"],["شَآءَ","shāa","wills","চায়"],["ذَكَرَهُۥ","dhakarahu","may remember it","(তা স্মরণ করবে) তা গ্রহণ করবে"]],"t":"فَمَ<k>ن شَ</><o>آ</>ءَ ذَكَرَهُۥ"},{"n":13,"w":[["فِى","fī","In","মধ্যে (লিপিবদ্ধ)"],["صُحُفٍۢ","ṣuḥufin","sheets","সহিফাসমূহের"],["مُّكَرَّمَةٍۢ","mukarramatin","honored","(যা) সম্মানিত"]],"t":"فِى صُحُ<d>فٍۢ مُّ</>كَرَّمَةٍۢ"},{"n":14,"w":[["مَّرْفُوعَةٍۢ","marfū‘atin","Exalted","উচ্চ মর্যাদাসম্পন্ন"],["مُّطَهَّرَةٍۭ","muṭahharatin","purified","পবিত্র"]],"t":"مَّرْفُوعَ<d>ةٍۢ مُّ</>طَهَّرَةٍۭ"},{"n":15,"w":[["بِأَيْدِى","bi-aydī","In (the) hands","হাতে"],["سَفَرَةٍۢ","safaratin","(of) scribes","দূতদের"]],"t":"بِأَيْدِى سَفَرَةٍۢ"},{"n":16,"w":[["كِرَامٍۭ","kirāmin","Noble","সম্মানিত"],["بَرَرَةٍۢ","bararatin","dutiful","সততাসম্পন্ন"]],"t":"كِرَا<i>مٍۭ بَ</>رَرَةٍۢ"},{"n":17,"w":[["قُتِلَ","qutila","Is destroyed","ধ্বংস হোক"],["ٱلْإِنسَـٰنُ","l-insānu","[the] man","মানুষ"],["مَآ","mā","how","কতই না"],["أَكْفَرَهُۥ","akfarahu","ungrateful is he","তা অমান্যকারী"]],"t":"قُتِلَ <h>ٱ</>لْإِ<k>نسَٰ</>نُ <o>مَآ</> أَكْفَرَهُۥ"},{"n":18,"w":[["مِنْ","min","From","থেকে"],["أَىِّ","ayyi","what","কোন"],["شَىْءٍ","shayin","thing","বস্তু"],["خَلَقَهُۥ","khalaqahu","He created him","তিনি তাকে সৃষ্টি করেছেন"]],"t":"مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ"},{"n":19,"w":[["مِن","min","From","হতে"],["نُّطْفَةٍ","nuṭ'fatin","a semen-drop","শুক্র ফোঁটা"],["خَلَقَهُۥ","khalaqahu","He created him","তিনি তাকে সৃষ্টি করেছেন"],["فَقَدَّرَهُۥ","faqaddarahu","then He proportioned him","অতঃপর তার নিয়তি নির্দিষ্ট করেছেন"]],"t":"<d>مِن نُّ</><q>طْ</>فَةٍ خَلَقَهُ<m>ۥ</> فَقَدَّرَهُۥ"},{"n":20,"w":[["ثُمَّ","thumma","Then","এরপর"],["ٱلسَّبِيلَ","l-sabīla","the way","পথ"],["يَسَّرَهُۥ","yassarahu","He made easy for him","তার (জন্যে) সহজ করেছেন"]],"t":"ثُ<g>مَّ</> <h>ٱ</><l>ل</>سَّبِيلَ يَسَّرَهُۥ"},{"n":21,"w":[["ثُمَّ","thumma","Then","এরপর"],["أَمَاتَهُۥ","amātahu","He causes him to die","তাকে মৃত্যু দেন"],["فَأَقْبَرَهُۥ","fa-aqbarahu","and provides a grave for him","অতঃপর তাকে  কবরস্থ করেন"]],"t":"ثُ<g>مَّ</> أَمَاتَهُ<m>ۥ</> فَأَ<q>قْ</>بَرَهُۥ"},{"n":22,"w":[["ثُمَّ","thumma","Then","এরপর"],["إِذَا","idhā","when","যখন"],["شَآءَ","shāa","He wills","চাইবেন"],["أَنشَرَهُۥ","ansharahu","He will resurrect him","তাকে পুনরায়  জীবিত করবেন"]],"t":"ثُ<g>مَّ</> إِذَا <o>شَآ</>ءَ أَ<k>نشَ</>رَهُۥ"},{"n":23,"w":[["كَلَّا","kallā","Nay","কখনও না"],["لَمَّا","lammā","Not","না যা"],["يَقْضِ","yaqḍi","he has accomplished","সে পালন করে"],["مَآ","mā","what","যা"],["أَمَرَهُۥ","amarahu","He commanded him","তাকে আদেশ করেছেন তিনি"]],"t":"كَلَّا لَ<g>مَّ</>ا يَ<q>قْ</>ضِ <o>مَآ</> أَمَرَهُۥ"},{"n":24,"w":[["فَلْيَنظُرِ","falyanẓuri","Then let look","অতঃপর লক্ষ্য করুক"],["ٱلْإِنسَـٰنُ","l-insānu","the man","মানুষ"],["إِلَىٰ","ilā","at","প্রতি"],["طَعَامِهِۦٓ","ṭa‘āmihi","his food","তার খাদ্যের"]],"t":"فَلْيَ<k>نظُ</>رِ <h>ٱ</>لْإِ<k>نسَٰ</>نُ إِلَىٰ طَعَامِهِۦٓ"},{"n":25,"w":[["اَنَّا","annā","That [We]","নিশ্চয়ই আমরা"],["صَبَبْنَا","ṣababnā","[We] poured","আমরা বর্ষণ করেছি"],["ٱلْمَآءَ","l-māa","the water","পানি"],["صَبًّۭا","ṣabban","(in) abundance","(প্রচুর) বর্ষণ"]],"t":"أَ<g>نَّ</>ا صَبَ<q>بْ</>نَا <h>ٱ</>لْ<o>مَآ</>ءَ صَبًّۭا"},{"n":26,"w":[["ثُمَّ","thumma","Then","এরপর"],["شَقَقْنَا","shaqaqnā","We cleaved","আমরা বিদীর্ণ করেছি"],["ٱلْأَرْضَ","l-arḍa","the earth","মাটিকে"],["شَقًّۭا","shaqqan","splitting","(খুব) বিদীর্ণ"]],"t":"ثُ<g>مَّ</> شَقَ<q>قْ</>نَا <h>ٱ</>لْأَرْضَ شَقًّۭا"},{"n":27,"w":[["فَأَنۢبَتْنَا","fa-anbatnā","Then We caused to grow","অতঃপর আমরা উৎপন্ন করেছি"],["فِيهَا","fīhā","therein","তার মধ্যে"],["حَبًّۭا","ḥabban","grain","শস্য"]],"t":"فَأَ<i>نۢبَ</>تْنَا فِيهَا حَبًّۭا"},{"n":28,"w":[["وَعِنَبًۭا","wa‘inaban","And grapes","ও আঙুর"],["وَقَضْبًۭا","waqaḍban","and green fodder","ও শাকসবজি"]],"t":"وَعِنَ<d>بًۭا وَ</>قَضْبًۭا"},{"n":29,"w":[["وَزَيْتُونًۭا","wazaytūnan","And olive","এবং যয়তুন"],["وَنَخْلًۭا","wanakhlan","and date-palms","ও খেজুর"]],"t":"وَزَيْتُو<d>نًۭا وَ</>نَخْلًۭا"},{"n":30,"w":[["وَحَدَآئِقَ","waḥadāiqa","And gardens","এবং বাগানসমূহ"],["غُلْبًۭا","ghul'ban","(of) thick foliage","ঘন গাছপালাবিশিষ্ট"]],"t":"وَحَ<o>دَآ</>ئِقَ غُلْبًۭا"},{"n":31,"w":[["وَفَـٰكِهَةًۭ","wafākihatan","And fruits","এবং ফল"],["وَأَبًّۭا","wa-abban","and grass","গবাদি খাদ্য"]],"t":"وَ<m>فَٰ</>كِهَ<d>ةًۭ وَ</>أَبًّۭا"},{"n":32,"w":[["مَّتَـٰعًۭا","matā‘an","(As) a provision","ভোগ্য সামগ্রী (রূপে)"],["لَّكُمْ","lakum","for you","তোমাদের জন্যে"],["وَلِأَنْعَـٰمِكُمْ","wali-an‘āmikum","and for your cattle","ও তোমাদের চতুষ্পদ জন্তুর জন্যে"]],"t":"مَّ<m>تَٰ</><w>عًۭا لَّ</>كُمْ وَلِأَنْ<m>عَٰ</>مِكُمْ"},{"n":33,"w":[["فَإِذَا","fa-idhā","But when","অতঃপর যখন"],["جَآءَتِ","jāati","comes","আসবে"],["ٱلصَّآخَّةُ","l-ṣākhatu","the Deafening Blast","কর্ণবিদারক ধ্বনি"]],"t":"فَإِذَا <o>جَآ</>ءَتِ <h>ٱ</><l>ل</><n>صَّآ</>خَّةُ"},{"n":34,"w":[["يَوْمَ","yawma","(The) Day","সেদিন"],["يَفِرُّ","yafirru","will flee","পালাবে"],["ٱلْمَرْءُ","l-maru","a man","মানুষ"],["مِنْ","min","from","হতে"],["أَخِيهِ","akhīhi","his brother","তার ভাই"]],"t":"يَوْمَ يَفِرُّ <h>ٱ</>لْمَرْءُ مِنْ أَ<p>خِي</>هِ"},{"n":35,"w":[["وَأُمِّهِۦ","wa-ummihi","And his mother","ও তার মা"],["وَأَبِيهِ","wa-abīhi","and his father","ও তার বাপ (হতে)"]],"t":"وَأُ<g>مِّ</><m>هِۦ</> وَأَ<p>بِي</>هِ"},{"n":36,"w":[["وَصَـٰحِبَتِهِۦ","waṣāḥibatihi","And his wife","ও তার স্ত্রী"],["وَبَنِيهِ","wabanīhi","and his children","এবং তার সন্তানদের (হতে)"]],"t":"وَ<m>صَٰ</>حِبَتِ<m>هِۦ</> وَبَ<p>نِي</>هِ"},{"n":37,"w":[["لِكُلِّ","likulli","For every","জন্যে প্রত্যেক"],["ٱمْرِئٍۢ","im'ri-in","man","ব্যক্তির"],["مِّنْهُمْ","min'hum","among them","তাদের মধ্যকার"],["يَوْمَئِذٍۢ","yawma-idhin","that Day","সেদিন"],["شَأْنٌۭ","shanun","(will be) a matter","(বিশেষ) অবস্থা"],["يُغْنِيهِ","yugh'nīhi","occupying him","তাকে ব্যতিব্যস্ত করবে"]],"t":"لِكُلِّ <h>ٱ</>مْرِ<d>ئٍۢ مِّ</>نْهُمْ يَوْمَئِ<k>ذٍۢ شَ</>أْ<d>نٌۭ يُ</>غْ<p>نِي</>هِ"},{"n":38,"w":[["وُجُوهٌۭ","wujūhun","Faces","(অনেক) মুখ"],["يَوْمَئِذٍۢ","yawma-idhin","that Day","সেদিন"],["مُّسْفِرَةٌۭ","mus'firatun","(will be) bright","উজ্জ্বল (হবে)"]],"t":"وُجُو<d>هٌۭ يَ</>وْمَئِ<d>ذٍۢ مُّ</>سْفِرَةٌۭ"},{"n":39,"w":[["ضَاحِكَةٌۭ","ḍāḥikatun","Laughing","সহাস্য"],["مُّسْتَبْشِرَةٌۭ","mus'tabshiratun","rejoicing at good news","প্রফুল্ল (হবে)"]],"t":"ضَاحِكَ<d>ةٌۭ مُّ</>سْتَ<q>بْ</>شِرَةٌۭ"},{"n":40,"w":[["وَوُجُوهٌۭ","wawujūhun","And faces","এবং (অনেক) মুখ"],["يَوْمَئِذٍ","yawma-idhin","that Day","সেদিন"],["عَلَيْهَا","‘alayhā","upon them","তার উপর"],["غَبَرَةٌۭ","ghabaratun","(will be) dust","মলিনতা (আসবে)"]],"t":"وَوُجُو<d>هٌۭ يَ</>وْمَئِذٍ عَلَيْهَا غَبَرَةٌۭ"},{"n":41,"w":[["تَرْهَقُهَا","tarhaquhā","Will cover them","তাকে আচ্ছন্ন করবে"],["قَتَرَةٌ","qataratun","darkness","অন্ধকার"]],"t":"تَرْهَقُهَا قَتَرَةٌ"},{"n":42,"w":[["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব লোক"],["هُمُ","humu","[they]","তারাই (যারা)"],["ٱلْكَفَرَةُ","l-kafaratu","(are) the disbelievers","কাফের"],["ٱلْفَجَرَةُ","l-fajaratu","the wicked ones","পাপী"]],"t":"أُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</>لْكَفَرَةُ <h>ٱ</>لْفَجَرَةُ"}]}