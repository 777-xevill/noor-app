{"n":45,"a":[{"n":1,"w":[["حمٓ","hha-meem","Ha Meem","হা-মীম"]],"t":"ح<n>مٓ</>"},{"n":2,"w":[["تَنزِيلُ","tanzīlu","(The) revelation","অবতীর্ণ করা"],["ٱلْكِتَـٰبِ","l-kitābi","(of) the Book","এই কিতাব"],["مِنَ","mina","(is) from","পক্ষ হতে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["ٱلْعَزِيزِ","l-‘azīzi","the All-Mighty","(যিনি) পরাক্রমশালী"],["ٱلْحَكِيمِ","l-ḥakīmi","the All-Wise","প্রজ্ঞাময়"]],"t":"تَ<k>نزِ</>يلُ <h>ٱ</>لْكِ<m>تَٰ</>بِ مِنَ <h>ٱ</>للَّهِ <h>ٱ</>لْعَزِيزِ <h>ٱ</>لْحَ<p>كِي</>مِ"},{"n":3,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে রয়েছে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশমণ্ডলীর"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীর"],["لَـَٔايَـٰتٍۢ","laāyātin","surely (are) Signs","অবশ্যই নির্দশনাবলী"],["لِّلْمُؤْمِنِينَ","lil'mu'minīna","for the believers","মু'মিনদের জন্যে"]],"t":"إِ<g>نَّ</> فِى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ لَءَا<m>يَٰ</><w>تٍۢ لِّ</>لْمُؤْمِ<p>نِي</>نَ"},{"n":4,"w":[["وَفِى","wafī","And in","এবং মধ্যেও"],["خَلْقِكُمْ","khalqikum","your creation","তোমাদের সৃষ্টির"],["وَمَا","wamā","and what","এবং যা কিছু"],["يَبُثُّ","yabuthu","He disperses","তিনি (যমীনে) ছড়িয়ে দিয়েছেন"],["مِن","min","of","থেকে"],["دَآبَّةٍ","dābbatin","(the) moving creatures","জীবজন্তু"],["ءَايَـٰتٌۭ","āyātun","(are) Signs","নিদর্শনাবলী (রয়েছে)"],["لِّقَوْمٍۢ","liqawmin","for a people","লোকদের জন্যে"],["يُوقِنُونَ","yūqinūna","who are certain","(যারা) দৃঢ় বিশ্বাস করে"]],"t":"وَفِى خَلْقِكُمْ وَمَا يَبُثُّ مِ<k>ن دَ</><n>آ</>بَّةٍ ءَا<m>يَٰ</><w>تٌۭ لِّ</>قَوْ<d>مٍۢ يُ</>وقِ<p>نُو</>نَ"},{"n":5,"w":[["وَٱخْتِلَـٰفِ","wa-ikh'tilāfi","And (in the) alternation","এবং পরিবর্তনে"],["ٱلَّيْلِ","al-layli","(of) the night","রাতের"],["وَٱلنَّهَارِ","wal-nahāri","and the day","ও দিনের"],["وَمَآ","wamā","and what","এবং যা কিছু"],["أَنزَلَ","anzala","Allah sends down","অবতীর্ণ করেন"],["ٱللَّهُ","l-lahu","Allah sends down","আল্লাহ"],["مِنَ","mina","from","থেকে"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশ"],["مِن","min","of","মধ্য থেকে"],["رِّزْقٍۢ","riz'qin","(the) provision","আহার্য (অর্থাৎ পানি)"],["فَأَحْيَا","fa-aḥyā","and gives life","অতঃপর জীবন্ত করেন"],["بِهِ","bihi","thereby","তা দিয়ে"],["ٱلْأَرْضَ","l-arḍa","(to) the earth","পৃথিবীকে"],["بَعْدَ","ba‘da","after","পরে"],["مَوْتِهَا","mawtihā","its death","তার মৃত্যুর"],["وَتَصْرِيفِ","wataṣrīfi","and (in) directing","এবং আবর্তনে"],["ٱلرِّيَـٰحِ","l-riyāḥi","(the) winds","বায়ুর"],["ءَايَـٰتٌۭ","āyātun","(are) Signs","নির্দশনাবলী (রয়েছে)"],["لِّقَوْمٍۢ","liqawmin","for a people","লোকদের জন্যে (যারা)"],["يَعْقِلُونَ","ya‘qilūna","who reason","বুদ্ধিবিবেক কাজে লাগায়"]],"t":"وَ<h>ٱ</>خْتِ<m>لَٰ</>فِ <h>ٱ</>لَّيْلِ وَ<h>ٱ</><l>ل</><g>نَّ</>هَارِ وَ<o>مَآ</> أَ<k>نزَ</>لَ <h>ٱ</>للَّهُ مِنَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ <w>مِن رِّ</>زْ<k>قٍۢ فَ</>أَحْيَا بِهِ <h>ٱ</>لْأَرْضَ بَعْدَ مَوْتِهَا وَتَصْرِيفِ <h>ٱ</><l>ل</>رِّ<m>يَٰ</>حِ ءَا<m>يَٰ</><w>تٌۭ لِّ</>قَوْ<d>مٍۢ يَ</>عْقِ<p>لُو</>نَ"},{"n":6,"w":[["تِلْكَ","til'ka","These","এসব"],["ءَايَـٰتُ","āyātu","(are the) Verses","নির্দশনাবলী"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["نَتْلُوهَا","natlūhā","We recite them","তার আবৃত্তি/ তিলাওয়াত করছি আমরা"],["عَلَيْكَ","‘alayka","to you","তোমার কাছে"],["بِٱلْحَقِّ ۖ","bil-ḥaqi","in truth","যথাযথভাবে"],["فَبِأَىِّ","fabi-ayyi","Then in what","সুতরাং কোন"],["حَدِيثٍۭ","ḥadīthin","statement","কথার (উপর)"],["بَعْدَ","ba‘da","after","পরে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["وَءَايَـٰتِهِۦ","waāyātihi","and His Verses","ও তাঁর আয়াত গুলোর"],["يُؤْمِنُونَ","yu'minūna","will they believe","তারা বিশ্বাস করবে?"]],"t":"تِلْكَ ءَا<m>يَٰ</>تُ <h>ٱ</>للَّهِ نَتْلُوهَا عَلَيْكَ بِ<h>ٱ</>لْحَقِّ ۖ فَبِأَىِّ حَدِي<i>ثٍۭ بَ</>عْدَ <h>ٱ</>للَّهِ وَءَا<m>يَٰتِهِۦ</> يُؤْمِ<p>نُو</>نَ"},{"n":7,"w":[["وَيْلٌۭ","waylun","Woe","দুর্ভোগ"],["لِّكُلِّ","likulli","to every","প্রত্যেকের জন্য"],["أَفَّاكٍ","affākin","liar","ঘোর মিথ্যাবাদীর"],["أَثِيمٍۢ","athīmin","sinful","পাপীর"]],"t":"وَيْ<w>لٌۭ لِّ</>كُلِّ أَفَّاكٍ أَ<p>ثِي</>مٍۢ"},{"n":8,"w":[["يَسْمَعُ","yasma‘u","Who hears","(যে) শুনে"],["ءَايَـٰتِ","āyāti","(the) Verses","আয়াত সমূহ"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["تُتْلَىٰ","tut'lā","recited","পাঠ করা হয় (যা)"],["عَلَيْهِ","‘alayhi","to him","তার কাছে"],["ثُمَّ","thumma","then","এরপর"],["يُصِرُّ","yuṣirru","persists","অটল থাকে"],["مُسْتَكْبِرًۭا","mus'takbiran","arrogantly","ঔদ্ধত্যের সাথে"],["كَأَن","ka-an","as if","যেন"],["لَّمْ","lam","not","নি"],["يَسْمَعْهَا ۖ","yasma‘hā","he heard them","তা শুনেই"],["فَبَشِّرْهُ","fabashir'hu","So give him tidings","তাই তাকে সুসংবাদ দাও"],["بِعَذَابٍ","bi‘adhābin","(of) a punishment","শাস্তির"],["أَلِيمٍۢ","alīmin","painful","যন্ত্রণাদায়ক"]],"t":"يَسْمَعُ ءَا<m>يَٰ</>تِ <h>ٱ</>للَّهِ تُتْلَىٰ عَلَيْهِ ثُ<g>مَّ</> يُصِرُّ مُسْتَكْبِ<k>رًۭا كَ</><w>أَن لَّ</>مْ يَسْمَعْهَا ۖ فَبَشِّرْهُ بِعَذَابٍ أَ<p>لِي</>مٍۢ"},{"n":9,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["عَلِمَ","‘alima","he knows","সে অবগত হয়"],["مِنْ","min","of","মধ্য হতে"],["ءَايَـٰتِنَا","āyātinā","Our Verses","আমাদের আয়াত সমূহের"],["شَيْـًٔا","shayan","anything","কোনো কিছু"],["ٱتَّخَذَهَا","ittakhadhahā","he takes them","সে গ্রহণ করে তা"],["هُزُوًا ۚ","huzuwan","(in) ridicule","বিদ্রুপ রূপে"],["أُو۟لَـٰٓئِكَ","ulāika","Those ","ঐসব লোক"],["لَهُمْ","lahum","for them","তাদের জন্যে রয়েছে"],["عَذَابٌۭ","‘adhābun","(is) a punishment","শাস্তি"],["مُّهِينٌۭ","muhīnun","humiliating","অপমানকর"]],"t":"وَإِذَا عَلِمَ مِنْ ءَا<m>يَٰ</>تِنَا شَيْـًٔا <h>ٱ</>تَّخَذَهَا هُزُوًا ۚ أُ<s>و۟</><o>لَٰٓ</>ئِكَ لَهُمْ عَذَا<d>بٌۭ مُّ</><p>هِي</>نٌۭ"},{"n":10,"w":[["مِّن","min","Before them","থেকে"],["وَرَآئِهِمْ","warāihim","Before them","তাদের পিছনে (রয়েছে)"],["جَهَنَّمُ ۖ","jahannamu","(is) Hell","জাহান্নাম"],["وَلَا","walā","and not","এবং না"],["يُغْنِى","yugh'nī","will avail","কাজে আসবে"],["عَنْهُم","‘anhum","them","তাদের জন্যে"],["مَّا","mā","what","যা কিছু"],["كَسَبُوا۟","kasabū","they had earned","তারা অর্জন করেছে"],["شَيْـًۭٔا","shayan","anything","(তার) কোন কিছুই"],["وَلَا","walā","and not","এবং না"],["مَا","mā","what","যা কিছু"],["ٱتَّخَذُوا۟","ittakhadhū","they had taken","তারা গ্রহণ করেছে"],["مِن","min","besides","মধ্য হতে"],["دُونِ","dūni","besides","ছাড়া/ পরিবর্তে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহকে"],["أَوْلِيَآءَ ۖ","awliyāa","(as) protectors","অভিভাবক রূপে"],["وَلَهُمْ","walahum","And for them","এবং তাদের জন্যে রয়েছে"],["عَذَابٌ","‘adhābun","(is) a punishment","শাস্তি"],["عَظِيمٌ","‘aẓīmun","great","ভয়ানক"]],"t":"<d>مِّن وَ</><o>رَآ</>ئِهِمْ جَهَ<g>نَّ</>مُ ۖ وَلَا يُغْنِى عَنْ<y>هُم مَّ</>ا كَسَبُو<s>ا۟</> شَ<d>يْـًۭٔا وَ</>لَا مَا <h>ٱ</>تَّخَذُو<s>ا۟</> مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ أَوْلِ<o>يَآ</>ءَ ۖ وَلَهُمْ عَذَابٌ عَ<p>ظِي</>مٌ"},{"n":11,"w":[["هَـٰذَا","hādhā","This","এই (কুরআন)"],["هُدًۭى ۖ","hudan","(is) guidance","সৎপথের দিশারি"],["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["كَفَرُوا۟","kafarū","disbelieve","অস্বীকার করেছে"],["بِـَٔايَـٰتِ","biāyāti","in (the) Verses","নিদর্শনাবলীকে"],["رَبِّهِمْ","rabbihim","(of) their Lord","তাদের রবের"],["لَهُمْ","lahum","for them","তাদের জন্যে রয়েছে"],["عَذَابٌۭ","‘adhābun","(is) a punishment","শাস্তি"],["مِّن","min","of","থেকে"],["رِّجْزٍ","rij'zin","filth","(বড় কঠিন) শাস্তি"],["أَلِيمٌ","alīmun","painful","যন্ত্রণাদায়ক"]],"t":"<m>هَٰ</>ذَا هُ<d>دًۭى ۖ وَ</><h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> بِـَٔا<m>يَٰ</>تِ رَبِّهِمْ لَهُمْ عَذَا<d>بٌۭ مِّ</><w>ن رِّ</><q>جْ</>زٍ أَ<p>لِي</>مٌ"},{"n":12,"w":[["۞ ٱللَّهُ","al-lahu","Allah","(তিনিই) আল্লাহ"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["سَخَّرَ","sakhara","subjected","অধীন করে দিয়েছেন"],["لَكُمُ","lakumu","to you","তোমাদের জন্যে"],["ٱلْبَحْرَ","l-baḥra","the sea","সমুদ্রকে"],["لِتَجْرِىَ","litajriya","that may sail","যেন চলাচল করতে থাকে"],["ٱلْفُلْكُ","l-ful'ku","the ships","নৌযানসমূহ"],["فِيهِ","fīhi","therein","তার মধ্যে"],["بِأَمْرِهِۦ","bi-amrihi","by His Command","তাঁর নির্দেশের মাধ্যমে"],["وَلِتَبْتَغُوا۟","walitabtaghū","and that you may seek","এবং যেন তোমরা সন্ধান করতে পার"],["مِن","min","of","হতে"],["فَضْلِهِۦ","faḍlihi","His Bounty","তাঁর অনুগ্রহ"],["وَلَعَلَّكُمْ","wala‘allakum","and that you may","এবং যাতে তোমরা"],["تَشْكُرُونَ","tashkurūna","give thanks","কৃতজ্ঞ হও"]],"t":"۞ ٱللَّهُ <h>ٱ</>لَّذِى سَخَّرَ لَكُمُ <h>ٱ</>لْبَحْرَ لِتَ<q>جْ</>رِىَ <h>ٱ</>لْفُلْكُ فِيهِ بِأَمْرِ<m>هِۦ</> وَلِتَ<q>بْ</>تَغُو<s>ا۟</> مِ<k>ن فَ</>ضْلِ<m>هِۦ</> وَلَعَلَّكُمْ تَشْكُ<p>رُو</>نَ"},{"n":13,"w":[["وَسَخَّرَ","wasakhara","And He has subjected","এবং অধীন করে দিয়েছেন"],["لَكُم","lakum","to you","তোমাদের জন্যে"],["مَّا","mā","whatever","যা কিছু"],["فِى","fī","(is) in","মধ্যে আছে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশের"],["وَمَا","wamā","and whatever","ও যা কিছু"],["فِى","fī","(is) in","মধ্যে আছে"],["ٱلْأَرْضِ","l-arḍi","the earth ","পৃথিবীর"],["جَمِيعًۭا","jamī‘an","all","সবকিছুকেই"],["مِّنْهُ ۚ","min'hu","from Him","তাঁর নিকট হতে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে রয়েছে"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَـٰتٍۢ","laāyātin","surely are Signs","অবশ্যই নিদর্শনাবলী"],["لِّقَوْمٍۢ","liqawmin","for a people","লোকদের জন্যে (যারা)"],["يَتَفَكَّرُونَ","yatafakkarūna","who give thought","চিন্তাভাবনা করে"]],"t":"وَسَخَّرَ لَ<y>كُم مَّ</>ا فِى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَمَا فِى <h>ٱ</>لْأَرْضِ جَمِي<d>عًۭا مِّ</>نْهُ ۚ إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَا<m>يَٰ</><w>تٍۢ لِّ</>قَوْ<d>مٍۢ يَ</>تَفَكَّ<p>رُو</>نَ"},{"n":14,"w":[["قُل","qul","Say","(হে নাবী) বলো"],["لِّلَّذِينَ","lilladhīna","to those who","(তাদের)-কে যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["يَغْفِرُوا۟","yaghfirū","(to) forgive","তারা যেন ক্ষমা করে"],["لِلَّذِينَ","lilladhīna","those who","(তাদের)-কে যারা"],["لَا","lā","(do) not","না"],["يَرْجُونَ","yarjūna","hope","প্রত্যাশা করে"],["أَيَّامَ","ayyāma","(for the) days","(খারাপ) দিনগুলোর"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["لِيَجْزِىَ","liyajziya","that He may recompense","যেন প্রতিদান দেন তিনি"],["قَوْمًۢا","qawman","a people","লোকদেরকে"],["بِمَا","bimā","for what","এ বিষয়ে যা"],["كَانُوا۟","kānū","they used to","তারা"],["يَكْسِبُونَ","yaksibūna","earn","অর্জন করছিল"]],"t":"قُل لِّلَّذِينَ ءَامَنُو<s>ا۟</> يَغْفِرُو<s>ا۟</> لِلَّذِينَ لَا يَرْجُونَ أَيَّامَ <h>ٱ</>للَّهِ لِيَ<q>جْ</>زِىَ قَوْ<i>مًۢا بِ</>مَا كَانُو<s>ا۟</> يَكْسِ<p>بُو</>نَ"},{"n":15,"w":[["مَنْ","man","Whoever","যে"],["عَمِلَ","‘amila","does","কাজ করবে"],["صَـٰلِحًۭا","ṣāliḥan","a righteous deed","সৎ"],["فَلِنَفْسِهِۦ ۖ","falinafsihi","then it is for his soul","তা তার নিজের জন্যে"],["وَمَنْ","waman","and whoever","এবং যে"],["أَسَآءَ","asāa","does evil","মন্দ করবে"],["فَعَلَيْهَا ۖ","fa‘alayhā","then it (is) against it","তা তার উপর পড়বে"],["ثُمَّ","thumma","Then","এরপর"],["إِلَىٰ","ilā","to","দিকে"],["رَبِّكُمْ","rabbikum","your Lord","তোমার রবের"],["تُرْجَعُونَ","tur'ja‘ūna","you will be returned","তোমাদেরকে ফিরিয়ে আনা হবে"]],"t":"مَنْ عَمِلَ <m>صَٰ</>لِ<k>حًۭا فَ</>لِنَفْسِ<m>هِۦ</> ۖ وَمَنْ أَ<o>سَآ</>ءَ فَعَلَيْهَا ۖ ثُ<g>مَّ</> إِلَىٰ رَبِّكُمْ تُرْجَ<p>عُو</>نَ"},{"n":16,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["ءَاتَيْنَا","ātaynā","We gave","আমরা দিয়েছিলাম"],["بَنِىٓ","banī","(the) Children of Israel","বনী"],["إِسْرَٰٓءِيلَ","is'rāīla","(the) Children of Israel","ইসরাইলকে"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","কিতাব"],["وَٱلْحُكْمَ","wal-ḥuk'ma","and the wisdom","ও কর্তৃত্ব"],["وَٱلنُّبُوَّةَ","wal-nubuwata","and the Prophethood","ও নবুয়ত"],["وَرَزَقْنَـٰهُم","warazaqnāhum","and We provided them","এবং তাদের আমরা জীবিকা দিয়েছিলাম"],["مِّنَ","mina","of","হতে"],["ٱلطَّيِّبَـٰتِ","l-ṭayibāti","the good things","উত্তম বস্তু"],["وَفَضَّلْنَـٰهُمْ","wafaḍḍalnāhum","and We preferred them","এবং আমরা তাদেরকে মর্যাদা দিয়েছিলাম"],["عَلَى","‘alā","over","উপর"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","the worlds","সারা দুনিয়ার (মানুষের)"]],"t":"وَلَقَ<q>دْ</> ءَاتَيْنَا بَ<o>نِىٓ</> إِسْ<o>رَٰٓ</>ءِيلَ <h>ٱ</>لْكِ<m>تَٰ</>بَ وَ<h>ٱ</>لْحُكْمَ وَ<h>ٱ</><l>ل</><g>نُّ</>بُوَّةَ وَرَزَ<q>قْ</><m>نَٰ</><y>هُم مِّ</>نَ <h>ٱ</><l>ل</>طَّيِّ<m>بَٰ</>تِ وَفَضَّلْ<m>نَٰ</>هُمْ عَلَى <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":17,"w":[["وَءَاتَيْنَـٰهُم","waātaynāhum","And We gave them","এবং তাদেরকে আমরা দিয়েছি"],["بَيِّنَـٰتٍۢ","bayyinātin","clear proofs","সুস্পষ্ট প্রমাণ"],["مِّنَ","mina","of","সম্পর্কে"],["ٱلْأَمْرِ ۖ","l-amri","the matter","(দ্বীনের) নির্দেশ"],["فَمَا","famā","And not","অতঃপর নি"],["ٱخْتَلَفُوٓا۟","ikh'talafū","they differed","(মতবিরোধ করেছিল) বাড়াবাড়ি করে"],["إِلَّا","illā","except","কিন্তু"],["مِنۢ","min","after","মধ্য হতে"],["بَعْدِ","ba‘di","after","এরপরে"],["مَا","mā","[what]","যা"],["جَآءَهُمُ","jāahumu","came to them","তাদের কাছে এসেছিল"],["ٱلْعِلْمُ","l-‘il'mu","the knowledge","(নির্ভুল) জ্ঞান"],["بَغْيًۢا","baghyan","(out of) envy","বাড়াবাড়ি করে"],["بَيْنَهُمْ ۚ","baynahum","between themselves","তাদের মাঝে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["رَبَّكَ","rabbaka","your Lord","তোমার রব"],["يَقْضِى","yaqḍī","will judge","মীমাংসা করে দিবেন"],["بَيْنَهُمْ","baynahum","between them","তাদের মাঝে"],["يَوْمَ","yawma","(on the) Day","দিনে"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) the Resurrection","কিয়ামতের"],["فِيمَا","fīmā","about what","সে বিষয়ে"],["كَانُوا۟","kānū","they used to","তারা ছিল"],["فِيهِ","fīhi","therein","যার মধ্যে"],["يَخْتَلِفُونَ","yakhtalifūna","differ","মতবিরোধ করত"]],"t":"وَءَاتَيْ<m>نَٰ</><f>هُم بَ</>يِّ<m>نَٰ</><d>تٍۢ مِّ</>نَ <h>ٱ</>لْأَمْرِ ۖ فَمَا <h>ٱ</>خْتَلَ<o>فُوٓ</><s>ا۟</> إِلَّا <i>مِنۢ بَ</>عْدِ مَا <o>جَآ</>ءَهُمُ <h>ٱ</>لْعِلْمُ بَغْ<i>يًۢا بَ</>يْنَهُمْ ۚ إِ<g>نَّ</> رَبَّكَ يَ<q>قْ</>ضِى بَيْنَهُمْ يَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ فِيمَا كَانُو<s>ا۟</> فِيهِ يَخْتَلِ<p>فُو</>نَ"},{"n":18,"w":[["ثُمَّ","thumma","Then","এরপর"],["جَعَلْنَـٰكَ","ja‘alnāka","We put you","তোমাকে আমরা প্রতিষ্ঠিত করেছি"],["عَلَىٰ","‘alā","on","উপর"],["شَرِيعَةٍۢ","sharī‘atin","an ordained way","শরীয়তের"],["مِّنَ","mina","of","সম্পর্কিত"],["ٱلْأَمْرِ","l-amri","the matter","(দ্বীনের) নির্দেশ"],["فَٱتَّبِعْهَا","fa-ittabi‘'hā","so follow it","তাই তার অনুসরণ করো"],["وَلَا","walā","and (do) not","এবং না"],["تَتَّبِعْ","tattabi‘","follow","অনুসরণ করো"],["أَهْوَآءَ","ahwāa","(the) desires","খেয়াল খুশির"],["ٱلَّذِينَ","alladhīna","(of) those who","(তাদের) যারা"],["لَا","lā","(do) not","না"],["يَعْلَمُونَ","ya‘lamūna","know","জানে"]],"t":"ثُ<g>مَّ</> جَعَلْ<m>نَٰ</>كَ عَلَىٰ شَرِيعَ<d>ةٍۢ مِّ</>نَ <h>ٱ</>لْأَمْرِ فَ<h>ٱ</>تَّبِعْهَا وَلَا تَتَّبِعْ أَهْ<o>وَآ</>ءَ <h>ٱ</>لَّذِينَ لَا يَعْلَ<p>مُو</>نَ"},{"n":19,"w":[["إِنَّهُمْ","innahum","Indeed, they","তারা নিশ্চয়ই"],["لَن","lan","never","কখনও না"],["يُغْنُوا۟","yugh'nū","will avail","তারা কাজে আসবে"],["عَنكَ","‘anka","you","তোমার জন্যে"],["مِنَ","mina","against","(পাকড়াও) হতে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["شَيْـًۭٔا ۚ","shayan","(in) anything","কিছুমাত্র"],["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","সীমালঙ্ঘনকারীরা"],["بَعْضُهُمْ","ba‘ḍuhum","some of them","তাদের একে"],["أَوْلِيَآءُ","awliyāu","(are) allies","বন্ধু"],["بَعْضٍۢ ۖ","ba‘ḍin","(of) others","অপরের"],["وَٱللَّهُ","wal-lahu","and Allah","এবং আল্লাহ"],["وَلِىُّ","waliyyu","(is the) Protector","বন্ধু"],["ٱلْمُتَّقِينَ","l-mutaqīna","(of) the righteous","মুত্তাকীদের"]],"t":"إِ<g>نَّ</>هُمْ <d>لَن يُ</>غْنُو<s>ا۟</> عَ<k>نكَ</> مِنَ <h>ٱ</>للَّهِ شَ<d>يْـًۭٔا ۚ وَ</>إِ<g>نَّ</> <h>ٱ</><l>ل</><m>ظَّٰ</>لِمِينَ بَعْضُهُمْ أَوْلِ<o>يَآ</>ءُ بَعْ<d>ضٍۢ ۖ وَ</><h>ٱ</>للَّهُ وَلِىُّ <h>ٱ</>لْمُتَّ<p>قِي</>نَ"},{"n":20,"w":[["هَـٰذَا","hādhā","This","এটা"],["بَصَـٰٓئِرُ","baṣāiru","(is) enlightenment","(সঠিক পথের) আলো"],["لِلنَّاسِ","lilnnāsi","for mankind","সব লোকের জন্যে"],["وَهُدًۭى","wahudan","and guidance","এবং পথনির্দেশ"],["وَرَحْمَةٌۭ","waraḥmatun","and mercy","ও অনুগ্রহ"],["لِّقَوْمٍۢ","liqawmin","for a people","(এমন) লোকদের জন্যে"],["يُوقِنُونَ","yūqinūna","who are certain","(যারা) দৃঢ় বিশ্বাস করে"]],"t":"<m>هَٰ</>ذَا بَ<o>صَٰٓ</>ئِرُ لِل<g>نَّ</>اسِ وَهُ<d>دًۭى وَ</>رَحْمَ<w>ةٌۭ لِّ</>قَوْ<d>مٍۢ يُ</>وقِ<p>نُو</>نَ"},{"n":21,"w":[["أَمْ","am","Do","কি"],["حَسِبَ","ḥasiba","think","মনে করেছে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ٱجْتَرَحُوا۟","ij'taraḥū","commit","লিপ্ত রয়েছে"],["ٱلسَّيِّـَٔاتِ","l-sayiāti","evil deeds","পাপকাজ"],["أَن","an","that","যে"],["نَّجْعَلَهُمْ","naj‘alahum","We will make them","তাদেরকে করব আমরা"],["كَٱلَّذِينَ","ka-alladhīna","like those who","(তাদের) মতো যারা"],["ءَامَنُوا۟","āmanū","believed","ঈমান এনেছে"],["وَعَمِلُوا۟","wa‘amilū","and did","ও কাজ করেছে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","righteous deeds","সৎ"],["سَوَآءًۭ","sawāan","equal","(উভয়ে) সমান"],["مَّحْيَاهُمْ","maḥyāhum","(in) their life","তাদের জীবন"],["وَمَمَاتُهُمْ ۚ","wamamātuhum","and their death","ও তাদের মৃত্যু (এক রকম হবে)"],["سَآءَ","sāa","Evil is","কত মন্দ"],["مَا","mā","what","যা"],["يَحْكُمُونَ","yaḥkumūna","they judge","তারা মীমাংসা করে"]],"t":"أَمْ حَسِبَ <h>ٱ</>لَّذِينَ <h>ٱ</><q>جْ</>تَرَحُو<s>ا۟</> <h>ٱ</><l>ل</>سَّيِّـَٔاتِ <d>أَن نَّ</><q>جْ</>عَلَهُمْ كَ<h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ سَ<o>وَآ</><d>ءًۭ مَّ</>حْيَاهُمْ وَمَمَاتُهُمْ ۚ <o>سَآ</>ءَ مَا يَحْكُ<p>مُو</>نَ"},{"n":22,"w":[["وَخَلَقَ","wakhalaqa","And Allah created","এবং সৃষ্টি করেছেন"],["ٱللَّهُ","l-lahu","And Allah created","আল্লাহ"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশ"],["وَٱلْأَرْضَ","wal-arḍa","and the earth","ও পৃথিবী"],["بِٱلْحَقِّ","bil-ḥaqi","in truth","যথাযথভাবে"],["وَلِتُجْزَىٰ","walituj'zā","and that may be recompensed","এবং যেন প্রতিদান দেওয়া যায়"],["كُلُّ","kullu","every","প্রত্যেক"],["نَفْسٍۭ","nafsin","soul","ব্যক্তিকে"],["بِمَا","bimā","for what","ঐ বিষয়ে যা"],["كَسَبَتْ","kasabat","it has earned","সে অর্জন করেছে"],["وَهُمْ","wahum","and they","এবং তাদের (উপর)"],["لَا","lā","will not be wronged","না"],["يُظْلَمُونَ","yuẓ'lamūna","will not be wronged","যুলুম করা হবে"]],"t":"وَخَلَقَ <h>ٱ</>للَّهُ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضَ بِ<h>ٱ</>لْحَقِّ وَلِتُ<q>جْ</>زَىٰ كُلُّ نَفْ<i>سٍۭ بِ</>مَا كَسَبَتْ وَهُمْ لَا يُظْلَ<p>مُو</>نَ"},{"n":23,"w":[["أَفَرَءَيْتَ","afara-ayta","Have you seen","তুমি (ভেবে) দেখেছ কি"],["مَنِ","mani","(he) who","যে"],["ٱتَّخَذَ","ittakhadha","takes","বানিয়েছে"],["إِلَـٰهَهُۥ","ilāhahu","(as) his god","তার ইলাহ"],["هَوَىٰهُ","hawāhu","his desire","নিজ প্রবৃত্তিকে"],["وَأَضَلَّهُ","wa-aḍallahu","and Allah lets him go astray","এবং তাকে পথভ্রষ্ট করেছে"],["ٱللَّهُ","l-lahu","and Allah lets him go astray","আল্লাহ"],["عَلَىٰ","‘alā","knowingly","ভিত্তিতে"],["عِلْمٍۢ","‘il'min","knowingly","জ্ঞানের"],["وَخَتَمَ","wakhatama","and He sets a seal","এবং মোহর মেরে দিয়েছেন"],["عَلَىٰ","‘alā","upon","উপর"],["سَمْعِهِۦ","sam‘ihi","his hearing","তার কানের"],["وَقَلْبِهِۦ","waqalbihi","and his heart","ও তার অন্তরের"],["وَجَعَلَ","waja‘ala","and puts","ও রেখে দিয়েছেন"],["عَلَىٰ","‘alā","over","উপর"],["بَصَرِهِۦ","baṣarihi","his vision","তার চোখের"],["غِشَـٰوَةًۭ","ghishāwatan","a veil","আবরণ"],["فَمَن","faman","Then who","সুতরাং কে"],["يَهْدِيهِ","yahdīhi","will guide him","তাকে সৎপথ দেখাবে"],["مِنۢ","min","after","মধ্য হতে"],["بَعْدِ","ba‘di","after","পরে"],["ٱللَّهِ ۚ","l-lahi","Allah","আল্লাহর"],["أَفَلَا","afalā","Then will not","তবুও কি না"],["تَذَكَّرُونَ","tadhakkarūna","you receive admonition","তোমরা শিক্ষা গ্রহণ করবে"]],"t":"أَفَرَءَيْتَ مَنِ <h>ٱ</>تَّخَذَ إِ<m>لَٰ</>هَهُ<m>ۥ</> هَوَ<m>ىٰ</>هُ وَأَضَلَّهُ <h>ٱ</>للَّهُ عَلَىٰ عِلْ<d>مٍۢ وَ</>خَتَمَ عَلَىٰ سَمْعِ<m>هِۦ</> وَقَلْبِ<m>هِۦ</> وَجَعَلَ عَلَىٰ بَصَرِ<m>هِۦ</> غِ<m>شَٰ</>وَ<k>ةًۭ فَ</><d>مَن يَ</>هْدِيهِ <i>مِنۢ بَ</>عْدِ <h>ٱ</>للَّهِ ۚ أَفَلَا تَذَكَّ<p>رُو</>نَ"},{"n":24,"w":[["وَقَالُوا۟","waqālū","And they say","এবং তারা বলে"],["مَا","mā","Not","\"না"],["هِىَ","hiya","it","সেটা (অর্থাৎ পূনরুত্থান)"],["إِلَّا","illā","(is) but","(যদি থাকে) তবে"],["حَيَاتُنَا","ḥayātunā","our life","আমাদের এ জীবন"],["ٱلدُّنْيَا","l-dun'yā","(of) the world","দুনিয়ার"],["نَمُوتُ","namūtu","we die","আমরা মরি"],["وَنَحْيَا","wanaḥyā","and we live","ও আমরা বাঁচি (তা সব এখানেই)"],["وَمَا","wamā","and not","এবং না"],["يُهْلِكُنَآ","yuh'likunā","destroys us","আমাদের ধ্বংস করে"],["إِلَّا","illā","except","এ ব্যতীত"],["ٱلدَّهْرُ ۚ","l-dahru","the time","কালের (আবর্তন)\""],["وَمَا","wamā","And not","এবং নেই"],["لَهُم","lahum","for them","তাদের কাছে"],["بِذَٰلِكَ","bidhālika","of that","এ সম্বন্ধে"],["مِنْ","min","any","কোনো"],["عِلْمٍ ۖ","‘il'min","knowledge","জ্ঞান"],["إِنْ","in","not","না"],["هُمْ","hum","they","তারা"],["إِلَّا","illā","(do) but","এ ব্যতীত"],["يَظُنُّونَ","yaẓunnūna","guess","অনুমান করে"]],"t":"وَقَالُو<s>ا۟</> مَا هِىَ إِلَّا حَيَاتُنَا <h>ٱ</><l>ل</>دُّنْيَا نَمُوتُ وَنَحْيَا وَمَا يُهْلِكُ<o>نَآ</> إِلَّا <h>ٱ</><l>ل</>دَّهْرُ ۚ وَمَا لَ<f>هُم بِ</><m>ذَٰ</>لِكَ مِنْ عِلْمٍ ۖ إِنْ هُمْ إِلَّا يَظُ<g>نُّ</><p>و</>نَ"},{"n":25,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["تُتْلَىٰ","tut'lā","are recited","আবৃত্তি করা হয়"],["عَلَيْهِمْ","‘alayhim","to them","তাদের কাছে"],["ءَايَـٰتُنَا","āyātunā","Our Verses","আমাদের আয়াতসমূহকে"],["بَيِّنَـٰتٍۢ","bayyinātin","clear","সুস্পষ্ট"],["مَّا","mā","not","না"],["كَانَ","kāna","is","থাকে"],["حُجَّتَهُمْ","ḥujjatahum","their argument","তাদের যুক্তি"],["إِلَّآ","illā","except","এ ব্যতীত"],["أَن","an","that","যে"],["قَالُوا۟","qālū","they say","তারা বলে"],["ٱئْتُوا۟","i'tū","Bring","\"তোমরা উপস্থিত হও"],["بِـَٔابَآئِنَآ","biābāinā","our forefathers","আমাদের পিতৃপুরুষদেরকে নিয়ে"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you are","তোমরা হও"],["صَـٰدِقِينَ","ṣādiqīna","truthful","সত্যবাদী\""]],"t":"وَإِذَا تُتْلَىٰ عَلَيْهِمْ ءَا<m>يَٰ</>تُنَا بَيِّ<m>نَٰ</><d>تٍۢ مَّ</>ا كَانَ حُجَّتَهُمْ إِ<o>لَّآ</> أَ<k>ن قَ</>الُو<s>ا۟</> <h>ٱ</>ئْتُو<s>ا۟</> بِـَٔا<o>بَآئِنَآ</> إِ<k>ن كُنتُ</>مْ <m>صَٰ</>دِ<p>قِي</>نَ"},{"n":26,"w":[["قُلِ","quli","Say","বলো"],["ٱللَّهُ","l-lahu","Allah","\"আল্লাহই"],["يُحْيِيكُمْ","yuḥ'yīkum","gives you life","তোমাদেরকে জীবন দেন"],["ثُمَّ","thumma","then","এরপর"],["يُمِيتُكُمْ","yumītukum","causes you to die","তোমাদেরকে মৃত্যু দেন"],["ثُمَّ","thumma","then","এরপর"],["يَجْمَعُكُمْ","yajma‘ukum","He will gather you","তোমাদেরকে একত্র করবেন"],["إِلَىٰ","ilā","to","দিকে"],["يَوْمِ","yawmi","(the) Day","দিনের"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) the Resurrection","কিয়ামতের"],["لَا","lā","no","নেই"],["رَيْبَ","rayba","doubt","কোন সন্দেহ"],["فِيهِ","fīhi","about it","তার মধ্যে\""],["وَلَـٰكِنَّ","walākinna","But","কিন্তু"],["أَكْثَرَ","akthara","most","অধিকাংশ"],["ٱلنَّاسِ","l-nāsi","(of) the people","মানুষই"],["لَا","lā","(do) not","না"],["يَعْلَمُونَ","ya‘lamūna","know","তারা জানে"]],"t":"قُلِ <h>ٱ</>للَّهُ يُحْيِيكُمْ ثُ<g>مَّ</> يُمِيتُكُمْ ثُ<g>مَّ</> يَ<q>جْ</>مَعُكُمْ إِلَىٰ يَوْمِ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ لَا رَيْبَ فِيهِ وَ<m>لَٰ</>كِ<g>نَّ</> أَكْثَرَ <h>ٱ</><l>ل</><g>نَّ</>اسِ لَا يَعْلَ<p>مُو</>نَ"},{"n":27,"w":[["وَلِلَّهِ","walillahi","And for Allah","এবং আল্লাহরই জন্য"],["مُلْكُ","mul'ku","(is the) dominion","সার্বভৌমত্ব"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশের"],["وَٱلْأَرْضِ ۚ","wal-arḍi","and the earth","ও পৃথিবীর"],["وَيَوْمَ","wayawma","and (the) Day","এবং যেদিন"],["تَقُومُ","taqūmu","is established","সংঘটিত হবে"],["ٱلسَّاعَةُ","l-sā‘atu","the Hour","কিয়ামত"],["يَوْمَئِذٍۢ","yawma-idhin","that Day","সেদিন"],["يَخْسَرُ","yakhsaru","will lose","ক্ষতিগ্রস্ত হবে"],["ٱلْمُبْطِلُونَ","l-mub'ṭilūna","the falsifiers","মিথ্যাশ্রয়ীরা"]],"t":"وَلِلَّهِ مُلْكُ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ ۚ وَيَوْمَ تَقُومُ <h>ٱ</><l>ل</>سَّاعَةُ يَوْمَئِ<d>ذٍۢ يَ</>خْسَرُ <h>ٱ</>لْمُ<q>بْ</>طِ<p>لُو</>نَ"},{"n":28,"w":[["وَتَرَىٰ","watarā","And you will see","এবং তুমি দেখবে"],["كُلَّ","kulla","every","প্রত্যেক"],["أُمَّةٍۢ","ummatin","nation","দলকে"],["جَاثِيَةًۭ ۚ","jāthiyatan","kneeling","নতজানু অবস্থায়"],["كُلُّ","kullu","Every","প্রত্যেক"],["أُمَّةٍۢ","ummatin","nation","দলকে"],["تُدْعَىٰٓ","tud'‘ā","will be called","ডাকা হবে"],["إِلَىٰ","ilā","to","প্রতি"],["كِتَـٰبِهَا","kitābihā","its record","তার আমলনামার"],["ٱلْيَوْمَ","l-yawma","Today","\"(বলা হবে) আজ"],["تُجْزَوْنَ","tuj'zawna","you will be recompensed","তোমাদের প্রতিফল দেওয়া হবে"],["مَا","mā","(for) what","যা"],["كُنتُمْ","kuntum","you used to","তোমরা"],["تَعْمَلُونَ","ta‘malūna","do","কাজ করছিলে"]],"t":"وَتَرَىٰ كُلَّ أُ<g>مَّ</><k>ةٍۢ جَ</>اثِيَ<k>ةًۭ ۚ كُ</>لُّ أُ<g>مَّ</><k>ةٍۢ تُ</><q>دْ</>عَ<o>ىٰٓ</> إِلَىٰ كِ<m>تَٰ</>بِهَا <h>ٱ</>لْيَوْمَ تُ<q>جْ</>زَوْنَ مَا كُ<k>نتُ</>مْ تَعْمَ<p>لُو</>نَ"},{"n":29,"w":[["هَـٰذَا","hādhā","This","এই"],["كِتَـٰبُنَا","kitābunā","Our Record","আমাদের (তৈরী করা) আমলনামা"],["يَنطِقُ","yanṭiqu","speaks","কথা বলছে"],["عَلَيْكُم","‘alaykum","about you","তোমাদের বিরুদ্ধে"],["بِٱلْحَقِّ ۚ","bil-ḥaqi","in truth","যথাযথভাবে"],["إِنَّا","innā","Indeed, We","আমরা নিশ্চয়ই"],["كُنَّا","kunnā","[We] used to","আমরা ছিলাম"],["نَسْتَنسِخُ","nastansikhu","transcribe","আমরা সংরক্ষণ করি"],["مَا","mā","what","যা কিছু"],["كُنتُمْ","kuntum","you used to","তোমরা ছিলে"],["تَعْمَلُونَ","ta‘malūna","do","তোমরা কাজ করতে\""]],"t":"<m>هَٰ</>ذَا كِ<m>تَٰ</>بُنَا يَ<k>نطِ</>قُ عَلَيْ<f>كُم بِ</><h>ٱ</>لْحَقِّ ۚ إِ<g>نَّ</>ا كُ<g>نَّ</>ا نَسْتَ<k>نسِ</>خُ مَا كُ<k>نتُ</>مْ تَعْمَ<p>لُو</>نَ"},{"n":30,"w":[["فَأَمَّا","fa-ammā","Then as for","আর"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ءَامَنُوا۟","āmanū","believed","ঈমান আনবে"],["وَعَمِلُوا۟","wa‘amilū","and did","ও কাজ করবে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","[the] righteous deeds","নেকীর"],["فَيُدْخِلُهُمْ","fayud'khiluhum","will admit them","তখন তাদের প্রবেশ করাবেন"],["رَبُّهُمْ","rabbuhum","their Lord","তাদের রব"],["فِى","fī","in(to)","মধ্যে"],["رَحْمَتِهِۦ ۚ","raḥmatihi","His mercy","তাঁর রহমতের"],["ذَٰلِكَ","dhālika","That","এটাাই"],["هُوَ","huwa","[it]","সেই"],["ٱلْفَوْزُ","l-fawzu","(is) the success","সাফল্য"],["ٱلْمُبِينُ","l-mubīnu","clear","সুস্পষ্ট"]],"t":"فَأَ<g>مَّ</>ا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ فَيُ<q>دْ</>خِلُهُمْ رَبُّهُمْ فِى رَحْمَتِ<m>هِۦ</> ۚ <m>ذَٰ</>لِكَ هُوَ <h>ٱ</>لْفَوْزُ <h>ٱ</>لْمُ<p>بِي</>نُ"},{"n":31,"w":[["وَأَمَّا","wa-ammā","But as for","আর"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوٓا۟","kafarū","disbelieved","অস্বীকার করেছিল"],["أَفَلَمْ","afalam","Then were not","\"(তাদের বলা হবে) তবে কি"],["تَكُنْ","takun","Then were not","\"হয় নি"],["ءَايَـٰتِى","āyātī","My Verses","আমার নিদর্শনগুলো"],["تُتْلَىٰ","tut'lā","recited","পঠিত"],["عَلَيْكُمْ","‘alaykum","to you","তোমাদের নিকট"],["فَٱسْتَكْبَرْتُمْ","fa-is'takbartum","but you were proud","কিন্তু তোমরা অহংকার করেছিলে"],["وَكُنتُمْ","wakuntum","and you became","এবং তোমরা ছিলে"],["قَوْمًۭا","qawman","a people","সম্প্রদায়"],["مُّجْرِمِينَ","muj'rimīna","criminals","অপরাধী\""]],"t":"وَأَ<g>مَّ</>ا <h>ٱ</>لَّذِينَ كَفَ<o>رُوٓ</><s>ا۟</> أَفَلَمْ تَكُنْ ءَا<m>يَٰ</>تِى تُتْلَىٰ عَلَيْكُمْ فَ<h>ٱ</>سْتَكْبَرْتُمْ وَكُ<k>نتُ</>مْ قَوْ<d>مًۭا مُّ</><q>جْ</>رِ<p>مِي</>نَ"},{"n":32,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["قِيلَ","qīla","it was said","বলা হতো"],["إِنَّ","inna","Indeed","\"নিশ্চয়ই"],["وَعْدَ","wa‘da","(the) Promise","ওয়াদা"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["حَقٌّۭ","ḥaqqun","(is) true","সত্য"],["وَٱلسَّاعَةُ","wal-sā‘atu","and the Hour ","এবং কিয়ামত (এমন যে)"],["لَا","lā","(there is) no","নেই"],["رَيْبَ","rayba","doubt","কোনো সন্দেহ"],["فِيهَا","fīhā","about it","তার মধ্যে"],["قُلْتُم","qul'tum","you said","তোমরা বলতে"],["مَّا","mā","Not","\"না"],["نَدْرِى","nadrī","we know","আমরা জানি"],["مَا","mā","what","কি (জিনিস)"],["ٱلسَّاعَةُ","l-sā‘atu","the Hour (is)","কিয়ামত"],["إِن","in","Not","না"],["نَّظُنُّ","naẓunnu","we think","আমরা ধারণা করি"],["إِلَّا","illā","except","এ ব্যতীত"],["ظَنًّۭا","ẓannan","an assumption","(সাধারণ) অনুমান নির্ভর কথা"],["وَمَا","wamā","and not","এবং নই"],["نَحْنُ","naḥnu","we","আমরা"],["بِمُسْتَيْقِنِينَ","bimus'tayqinīna","(are) convinced","দৃঢ় বিশ্বাসী\""]],"t":"وَإِذَا قِيلَ إِ<g>نَّ</> وَعْدَ <h>ٱ</>للَّهِ حَ<d>قٌّۭ وَ</><h>ٱ</><l>ل</>سَّاعَةُ لَا رَيْبَ فِيهَا قُلْ<y>تُم مَّ</>ا نَ<q>دْ</>رِى مَا <h>ٱ</><l>ل</>سَّاعَةُ <d>إِن نَّ</>ظُ<g>نُّ</> إِلَّا ظَ<d>نًّۭا وَ</>مَا نَحْنُ بِمُسْتَيْقِ<p>نِي</>نَ"},{"n":33,"w":[["وَبَدَا","wabadā","And (will) appear","এবং প্রকাশ হবে"],["لَهُمْ","lahum","to them","তাদের কাছে"],["سَيِّـَٔاتُ","sayyiātu","(the) evil","মন্দ কাজগুলো"],["مَا","mā","(of) what","যা কিছু"],["عَمِلُوا۟","‘amilū","they did","তারা করেছিলো"],["وَحَاقَ","waḥāqa","and (will) envelop","এবং ঘিরে ফেলবে"],["بِهِم","bihim","them","তাদেরকে"],["مَّا","mā","what","যা"],["كَانُوا۟","kānū","they used","তারা ছিল"],["بِهِۦ","bihi","[at it]","সে সম্বন্ধে"],["يَسْتَهْزِءُونَ","yastahziūna","(to) mock","বিদ্রুপ করত"]],"t":"وَبَدَا لَهُمْ سَيِّـَٔاتُ مَا عَمِلُو<s>ا۟</> وَحَاقَ بِ<y>هِم مَّ</>ا كَانُو<s>ا۟</> بِ<m>هِۦ</> يَسْتَهْزِ<p>ءُو</>نَ"},{"n":34,"w":[["وَقِيلَ","waqīla","And it will be said","এবং বলা হবে"],["ٱلْيَوْمَ","l-yawma","Today","\"আজ"],["نَنسَىٰكُمْ","nansākum","We forget you","তোমাদেরকে ভুলে যাব আমরা"],["كَمَا","kamā","as","যেমন"],["نَسِيتُمْ","nasītum","you forgot","তোমরা ভুলে গিয়েছিলে"],["لِقَآءَ","liqāa","(the) meeting","সাক্ষাতকে"],["يَوْمِكُمْ","yawmikum","(of) this Day of yours","তোমাদের দিনের"],["هَـٰذَا","hādhā","(of) this Day of yours","এই"],["وَمَأْوَىٰكُمُ","wamawākumu","and your abode","এবং তোমাদের আশ্রয়স্থল"],["ٱلنَّارُ","l-nāru","(is) the Fire","আগুন"],["وَمَا","wamā","and not","এবং নেই"],["لَكُم","lakum","for you","তোমাদের জন্য"],["مِّن","min","any","কেউ"],["نَّـٰصِرِينَ","nāṣirīna","helpers","সাহায্যকারীদের"]],"t":"وَقِيلَ <h>ٱ</>لْيَوْمَ نَ<k>نسَ</><m>ىٰ</>كُمْ كَمَا نَسِيتُمْ لِ<o>قَآ</>ءَ يَوْمِكُمْ <m>هَٰ</>ذَا وَمَأْوَ<m>ىٰ</>كُمُ <h>ٱ</><l>ل</><g>نَّ</>ارُ وَمَا لَ<y>كُم مِّ</><d>ن نَّٰ</>صِ<p>رِي</>نَ"},{"n":35,"w":[["ذَٰلِكُم","dhālikum","That","এটা তোমাদের"],["بِأَنَّكُمُ","bi-annakumu","(is) because you","এ কারণে যে"],["ٱتَّخَذْتُمْ","ittakhadhtum","took","তোমরা গ্রহণ করেছিলে"],["ءَايَـٰتِ","āyāti","(the) Verses","নিদর্শনাবলীকে"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["هُزُوًۭا","huzuwan","(in) ridicule","বিদ্রুপরূপে"],["وَغَرَّتْكُمُ","wagharratkumu","and deceived you","ও তোমাদেরকে ধোঁকা দিয়েছিল"],["ٱلْحَيَوٰةُ","l-ḥayatu","the life","জীবন"],["ٱلدُّنْيَا ۚ","l-dun'yā","(of) the world","পার্থিব\""],["فَٱلْيَوْمَ","fal-yawma","So this Day","সুতরাং আজ"],["لَا","lā","not","না"],["يُخْرَجُونَ","yukh'rajūna","they will be brought forth","তাদের বের করা হবে"],["مِنْهَا","min'hā","from it","তা থেকে"],["وَلَا","walā","and not","এবং না"],["هُمْ","hum","they","তাদেরকে"],["يُسْتَعْتَبُونَ","yus'ta‘tabūna","will be asked to appease","সন্তুষ্টি লাভের সুযোগ দেওয়া হবে"]],"t":"<m>ذَٰ</>لِ<f>كُم بِ</>أَ<g>نَّ</>كُمُ <h>ٱ</>تَّخَذْتُمْ ءَا<m>يَٰ</>تِ <h>ٱ</>للَّهِ هُزُ<d>وًۭا وَ</>غَرَّتْكُمُ <h>ٱ</>لْحَيَ<s>وٰ</>ةُ <h>ٱ</><l>ل</>دُّنْيَا ۚ فَ<h>ٱ</>لْيَوْمَ لَا يُخْرَجُونَ مِنْهَا وَلَا هُمْ يُسْتَعْتَ<p>بُو</>نَ"},{"n":36,"w":[["فَلِلَّهِ","falillahi","Then for Allah","সুতরাং আল্লাহর জন্যে"],["ٱلْحَمْدُ","l-ḥamdu","(is) all the praise","সকল প্রশংসা"],["رَبِّ","rabbi","(the) Lord","(যিনি) রব"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশের"],["وَرَبِّ","warabbi","and (the) Lord","ও রব"],["ٱلْأَرْضِ","l-arḍi","(of) the earth","পৃথিবীর"],["رَبِّ","rabbi","(the) lord","রব"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","(of) the worlds","বিশ্বজগতের"]],"t":"فَلِلَّهِ <h>ٱ</>لْحَمْدُ رَبِّ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَرَبِّ <h>ٱ</>لْأَرْضِ رَبِّ <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":37,"w":[["وَلَهُ","walahu","And for Him","এবং তাঁরই জন্যে"],["ٱلْكِبْرِيَآءُ","l-kib'riyāu","(is) the greatness","গৌরব-গরিমা"],["فِى","fī","in","মধ্যে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশের"],["وَٱلْأَرْضِ ۖ","wal-arḍi","and the earth","এবং পৃথিবীর"],["وَهُوَ","wahuwa","and He","এবং তিনিই"],["ٱلْعَزِيزُ","l-‘azīzu","(is) the All-Mighty","পরাক্রমশালী"],["ٱلْحَكِيمُ","l-ḥakīmu","the All-Wise","প্রজ্ঞাময়"]],"t":"وَلَهُ <h>ٱ</>لْكِ<q>بْ</>رِ<o>يَآ</>ءُ فِى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ ۖ وَهُوَ <h>ٱ</>لْعَزِيزُ <h>ٱ</>لْحَ<p>كِي</>مُ"}]}