p>حِي</>مِ"},{"n":69,"w":[["إِنَّهُمْ","innahum","Indeed, they","তারা নিশ্চয়ই"],["أَلْفَوْا۟","alfaw","found","পেয়েছিলো"],["ءَابَآءَهُمْ","ābāahum","their fathers","তাদের পিতৃপুরুষদেরকে"],["ضَآلِّينَ","ḍāllīna","astray","বিপথগামী"]],"t":"إِ<g>نَّ</>هُمْ أَلْفَوْ<s>ا۟</> ءَا<o>بَآ</>ءَهُمْ <n>ضَآ</><p>لِّي</>نَ"},{"n":70,"w":[["فَهُمْ","fahum","So they","অতঃপর তারা"],["عَلَىٰٓ","‘alā","on","উপর"],["ءَاثَـٰرِهِمْ","āthārihim","their footsteps","তাদের পদাঙ্কের"],["يُهْرَعُونَ","yuh'ra‘ūna","they hastened","ছুটে চলছে"]],"t":"فَهُمْ عَلَ<o>ىٰٓ</> ءَا<m>ثَٰ</>رِهِمْ يُهْرَ<p>عُو</>نَ"},{"n":71,"w":[["وَلَقَدْ","walaqad","And verily","এবং নিশ্চয়ই"],["ضَلَّ","ḍalla","went astray","পথভ্রষ্ট হয়েছিলো"],["قَبْلَهُمْ","qablahum","before them","তাদের পূর্বেও"],["أَكْثَرُ","aktharu","most","অধিকাংশ"],["ٱلْأَوَّلِينَ","l-awalīna","(of) the former (people)","পূর্ববর্তীদের"]],"t":"وَلَقَ<q>دْ</> ضَلَّ قَ<q>بْ</>لَهُمْ أَكْثَرُ <h>ٱ</>لْأَوَّ<p>لِي</>نَ"},{"n":72,"w":[["وَلَقَدْ","walaqad","And verily","এবং নিশ্চয়ই"],["أَرْسَلْنَا","arsalnā","We sent","আমরা পাঠিয়েছিলাম"],["فِيهِم","fīhim","among them","তাদের মধ্যে"],["مُّنذِرِينَ","mundhirīna","warners","সতর্ককারীদেরকে (রাসূলরূপে)"]],"t":"وَلَقَ<q>دْ</> أَرْسَلْنَا فِي<y>هِم مُّ</><k>نذِ</><p>رِي</>نَ"},{"n":73,"w":[["فَٱنظُرْ","fa-unẓur","Then see","দেখো অতঃপর"],["كَيْفَ","kayfa","how","কেমন"],["كَانَ","kāna","was","হয়েছিলো"],["عَـٰقِبَةُ","‘āqibatu","(the) end","পরিণাম (সেই লোকদের)"],["ٱلْمُنذَرِينَ","l-mundharīna","(of) those who were warned","যাদের সতর্ক করা হয়েছিলো"]],"t":"فَ<h>ٱ</><k>نظُ</>رْ كَيْفَ كَانَ <m>عَٰ</>قِبَةُ <h>ٱ</>لْمُ<k>نذَ</><p>رِي</>نَ"},{"n":74,"w":[["إِلَّا","illā","Except","তবে স্বতন্ত্র (কথা)"],["عِبَادَ","‘ibāda","(the) slaves","দাসদের"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["ٱلْمُخْلَصِينَ","l-mukh'laṣīna","the chosen ones","খাঁটি (যাদের)"]],"t":"إِلَّا عِبَادَ <h>ٱ</>للَّهِ <h>ٱ</>لْمُخْلَ<p>صِي</>نَ"},{"n":75,"w":[["وَلَقَدْ","walaqad","And verily","এবং নিশ্চয়ই"],["نَادَىٰنَا","nādānā","called Us","আমাদেরকে ডেকেছিলো"],["نُوحٌۭ","nūḥun","Nuh","নূহ"],["فَلَنِعْمَ","falani‘'ma","and Best","অতঃপর কত উত্তম"],["ٱلْمُجِيبُونَ","l-mujībūna","(are We as) Responders","সাড়াদানকারী (আমরা)"]],"t":"وَلَقَ<q>دْ</> نَادَ<m>ىٰ</>نَا نُو<k>حٌۭ فَ</>لَنِعْمَ <h>ٱ</>لْمُجِي<p>بُو</>نَ"},{"n":76,"w":[["وَنَجَّيْنَـٰهُ","wanajjaynāhu","And We saved him","এবং তাকে আমরা করেছিলাম উদ্ধার"],["وَأَهْلَهُۥ","wa-ahlahu","and his family","ও তার পরিবারকে"],["مِنَ","mina","from","হ'তে"],["ٱلْكَرْبِ","l-karbi","the distress","সংকট"],["ٱلْعَظِيمِ","l-‘aẓīmi","the great","মহা"]],"t":"وَنَجَّيْ<m>نَٰ</>هُ وَأَهْلَهُ<m>ۥ</> مِنَ <h>ٱ</>لْكَرْبِ <h>ٱ</>لْعَ<p>ظِي</>مِ"},{"n":77,"w":[["وَجَعَلْنَا","waja‘alnā","And We made","এবং আমরা রাখলাম"],["ذُرِّيَّتَهُۥ","dhurriyyatahu","his offspring","তার বংশধরকে (এমন যে)"],["هُمُ","humu","[they]","তারাই"],["ٱلْبَاقِينَ","l-bāqīna","the survivors","অবশিষ্ট"]],"t":"وَجَعَلْنَا ذُرِّيَّتَهُ<m>ۥ</> هُمُ <h>ٱ</>لْبَا<p>قِي</>نَ"},{"n":78,"w":[["وَتَرَكْنَا","wataraknā","And We left","এবং আমরা ছেড়েছি (প্রশংসা)"],["عَلَيْهِ","‘alayhi","for him","তার সম্বন্ধে"],["فِى","fī","among","মধ্যে"],["ٱلْـَٔاخِرِينَ","l-ākhirīna","the later generations","পরবর্তীদের"]],"t":"وَتَرَكْنَا عَلَيْهِ فِى <h>ٱ</>لْءَاخِ<p>رِي</>نَ"},{"n":79,"w":[["سَلَـٰمٌ","salāmun","Peace be","\"শান্তি (বর্ষিত হোক)"],["عَلَىٰ","‘alā","upon","উপর"],["نُوحٍۢ","nūḥin","Nuh","নূহের"],["فِى","fī","among","মধ্যে"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","the worlds","সমগ্র বিশ্বের\""]],"t":"سَ<m>لَٰ</>مٌ عَلَىٰ نُو<k>حٍۢ فِ</>ى <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":80,"w":[["إِنَّا","innā","Indeed, We","নিশ্চয়ই আমরা"],["كَذَٰلِكَ","kadhālika","thus","এভাবে"],["نَجْزِى","najzī","[We] reward","পুরস্কার দিই আমরা"],["ٱلْمُحْسِنِينَ","l-muḥ'sinīna","the good-doers","সৎকর্মপরায়ণদেরকে"]],"t":"إِ<g>نَّ</>ا كَ<m>ذَٰ</>لِكَ نَ<q>جْ</>زِى <h>ٱ</>لْمُحْسِ<p>نِي</>نَ"},{"n":81,"w":[["إِنَّهُۥ","innahu","Indeed, he","সে নিশ্চয়ই (ছিলো)"],["مِنْ","min","(was) of","অন্তর্ভুক্ত"],["عِبَادِنَا","‘ibādinā","Our slaves","আমাদের দাসদের"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","believing","মু'মিন"]],"t":"إِ<g>نَّ</>هُ<m>ۥ</> مِنْ عِبَادِنَا <h>ٱ</>لْمُؤْمِ<p>نِي</>نَ"},{"n":82,"w":[["ثُمَّ","thumma","Then","এরপর"],["أَغْرَقْنَا","aghraqnā","We drowned","আমরা ডুবিয়ে দিই"],["ٱلْـَٔاخَرِينَ","l-ākharīna","the others","অন্যদেরকে"]],"t":"ثُ<g>مَّ</> أَغْرَ<q>قْ</>نَا <h>ٱ</>لْءَاخَ<p>رِي</>نَ"},{"n":83,"w":[["۞ وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["مِن","min","among","মধ্য হ'তে"],["شِيعَتِهِۦ","shī‘atihi","his kind","তার পথের অনুসারীদের"],["لَإِبْرَٰهِيمَ","la-ib'rāhīma","(was) surely Ibrahim","ইব্রাহীম অবশ্যই (অন্তর্ভক্ত ছিলো)"]],"t":"۞ وَإِ<g>نَّ</> مِ<k>ن شِ</>يعَتِ<m>هِۦ</> لَإِ<q>بْ</><m>رَٰ</><p>هِي</>مَ"},{"n":84,"w":[["إِذْ","idh","When","(স্মরণ করো) যখন"],["جَآءَ","jāa","he came","সে এসেছিলো"],["رَبَّهُۥ","rabbahu","(to) his Lord","তার রবের (কাছে)"],["بِقَلْبٍۢ","biqalbin","with a heart","নিয়ে অন্তর"],["سَلِيمٍ","salīmin","sound","বিশুদ্ধ"]],"t":"إِذْ <o>جَآ</>ءَ رَبَّهُ<m>ۥ</> بِقَلْ<k>بٍۢ سَ</><p>لِي</>مٍ"},{"n":85,"w":[["إِذْ","idh","When","যখন"],["قَالَ","qāla","he said","সে বলেছিলো"],["لِأَبِيهِ","li-abīhi","to his father","তার পিতাকে"],["وَقَوْمِهِۦ","waqawmihi","and his people","ও তার জাতিকে"],["مَاذَا","mādhā","What is it","\"কিসের"],["تَعْبُدُونَ","ta‘budūna","you worship","তোমরা উপাসনা করছো"]],"t":"إِذْ قَالَ لِأَبِيهِ وَقَوْمِ<m>هِۦ</> مَاذَا تَعْبُ<p>دُو</>نَ"},{"n":86,"w":[["أَئِفْكًا","a-if'kan","Is it falsehood ","কি মিথ্যা"],["ءَالِهَةًۭ","ālihatan","gods","উপাস্যদের"],["دُونَ","dūna","other than","ব্যতীত"],["ٱللَّهِ","l-lahi","Allah ","আল্লাহকে"],["تُرِيدُونَ","turīdūna","(that) you desire","তোমরা পেতে চাও"]],"t":"أَئِفْكًا ءَالِهَ<k>ةًۭ دُ</>ونَ <h>ٱ</>للَّهِ تُرِي<p>دُو</>نَ"},{"n":87,"w":[["فَمَا","famā","Then what","কি তাহ'লে"],["ظَنُّكُم","ẓannukum","(do) you think","তোমরা মনে করো"],["بِرَبِّ","birabbi","about (the) Lord","রব সম্বন্ধে"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","(of) the worlds","বিশ্বজগতের\""]],"t":"فَمَا ظَ<g>نُّ</><f>كُم بِ</>رَبِّ <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":88,"w":[["فَنَظَرَ","fanaẓara","Then he glanced","অতঃপর সে তাকালো"],["نَظْرَةًۭ","naẓratan","a glance","একবার"],["فِى","fī","at","দিকে"],["ٱلنُّجُومِ","l-nujūmi","the stars","তারকাদের"]],"t":"فَنَظَرَ نَظْرَ<k>ةًۭ فِ</>ى <h>ٱ</><l>ل</><g>نُّ</><p>جُو</>مِ"},{"n":89,"w":[["فَقَالَ","faqāla","And he said","অতঃপর বললো"],["إِنِّى","innī","Indeed, I am","\"নিশ্চয়ই আমি"],["سَقِيمٌۭ","saqīmun","sick","অসুস্থ\""]],"t":"فَقَالَ إِ<g>نِّ</>ى سَ<p>قِي</>مٌۭ"},{"n":90,"w":[["فَتَوَلَّوْا۟","fatawallaw","So they turned away","তারা অতঃপর ফিরে গেল"],["عَنْهُ","‘anhu","from him","তার থেকে"],["مُدْبِرِينَ","mud'birīna","departing","পিঠ ফিরিয়ে"]],"t":"فَتَوَلَّوْ<s>ا۟</> عَنْهُ مُ<q>دْ</>بِ<p>رِي</>نَ"},{"n":91,"w":[["فَرَاغَ","farāgha","Then he turned","সে অতঃপর চুপিসারে  গেলো"],["إِلَىٰٓ","ilā","to","দিকে"],["ءَالِهَتِهِمْ","ālihatihim","their gods","তাদের দেবতাগুলোর"],["فَقَالَ","faqāla","and said","অতঃপর বললো"],["أَلَا","alā","Do not","\"কেন না"],["تَأْكُلُونَ","takulūna","you eat","তোমরা খাচ্ছো"]],"t":"فَرَاغَ إِلَ<o>ىٰٓ</> ءَالِهَتِهِمْ فَقَالَ أَلَا تَأْكُ<p>لُو</>نَ"},{"n":92,"w":[["مَا","mā","What (is)","কি"],["لَكُمْ","lakum","for you","তোমাদের হয়েছে"],["لَا","lā","not","না"],["تَنطِقُونَ","tanṭiqūna","you speak","তোমরা কথা বলো\""]],"t":"مَا لَكُمْ لَا تَ<k>نطِ</><p>قُو</>نَ"},{"n":93,"w":[["فَرَاغَ","farāgha","Then he turned","সে অতঃপর ঝাঁপিয়ে পড়লো"],["عَلَيْهِمْ","‘alayhim","upon them","তাদের উপর"],["ضَرْبًۢا","ḍarban","striking","আঘাত"],["بِٱلْيَمِينِ","bil-yamīni","with the right hand","দিয়ে ডান হাত"]],"t":"فَرَاغَ عَلَيْهِمْ ضَرْ<i>بًۢا بِ</><h>ٱ</>لْيَ<p>مِي</>نِ"},{"n":94,"w":[["فَأَقْبَلُوٓا۟","fa-aqbalū","Then they advanced","তারা অতঃপর এগিয়ে এলো"],["إِلَيْهِ","ilayhi","towards him","তার দিকে"],["يَزِفُّونَ","yaziffūna","hastening","ছুটে"]],"t":"فَأَ<q>قْ</>بَ<o>لُوٓ</><s>ا۟</> إِلَيْهِ يَزِ<p>فُّو</>نَ"},{"n":95,"w":[["قَالَ","qāla","He said","সে বললো"],["أَتَعْبُدُونَ","ata‘budūna","Do you worship","\"তোমরা পূজা করো কি"],["مَا","mā","what","যাকে"],["تَنْحِتُونَ","tanḥitūna","you carve","তোমরা খোদাই করে তৈরী কর"]],"t":"قَالَ أَتَعْبُدُونَ مَا تَنْحِ<p>تُو</>نَ"},{"n":96,"w":[["وَٱللَّهُ","wal-lahu","While Allah","অথচ আল্লাহই"],["خَلَقَكُمْ","khalaqakum","created you","তোমাদেরকে সৃষ্টি করেছেন"],["وَمَا","wamā","and what","এবং (তাদেরকেও) যাদের"],["تَعْمَلُونَ","ta‘malūna","you make","তোমরা তৈরী করো\""]],"t":"وَ<h>ٱ</>للَّهُ خَلَقَكُمْ وَمَا تَعْمَ<p>لُو</>نَ"},{"n":97,"w":[["قَالُوا۟","qālū","They said","তারা বললো"],["ٱبْنُوا۟","ib'nū","Build","\"তোমরা তৈরী করো"],["لَهُۥ","lahu","for him","তার জন্যে"],["بُنْيَـٰنًۭا","bun'yānan","a structure","প্রাচীর বেষ্টনী (অগ্নিকুন্ডের)"],["فَأَلْقُوهُ","fa-alqūhu","and throw him","তাকে অতঃপর নিক্ষেপ করো"],["فِى","fī","into","মধ্যে"],["ٱلْجَحِيمِ","l-jaḥīmi","the blazing Fire","জ্বলন্ত আগুনে\""]],"t":"قَالُو<s>ا۟</> <h>ٱ</><q>بْ</>نُو<s>ا۟</> لَهُ<m>ۥ</> بُنْ<m>يَٰ</><k>نًۭا فَ</>أَلْقُوهُ فِى <h>ٱ</>لْجَ<p>حِي</>مِ"},{"n":98,"w":[["فَأَرَادُوا۟","fa-arādū","And they intended","তারা অতঃপর সংকল্প করলো"],["بِهِۦ","bihi","for him","তাঁর বিরুদ্ধে"],["كَيْدًۭا","kaydan","a plot","একটি ষড়যন্ত্রের"],["فَجَعَلْنَـٰهُمُ","faja‘alnāhumu","but We made them","তাদেরকে তখন আমরা করলাম"],["ٱلْأَسْفَلِينَ","l-asfalīna","the lowest","অতিশয় হীন"]],"t":"فَأَرَادُو<s>ا۟</> بِ<m>هِۦ</> كَيْ<k>دًۭا فَ</>جَعَلْ<m>نَٰ</>هُمُ <h>ٱ</>لْأَسْفَ<p>لِي</>نَ"},{"n":99,"w":[["وَقَالَ","waqāla","And he said","এবং সে বললো"],["إِنِّى","innī","Indeed, I am","\"নিশ্চয়ই আমি"],["ذَاهِبٌ","dhāhibun","going","চললাম"],["إِلَىٰ","ilā","to","দিকে"],["رَبِّى","rabbī","my Lord","আমার রবের"],["سَيَهْدِينِ","sayahdīni","He will guide me","পথ দেখাবেন শীঘ্রই তিনি আমাকে"]],"t":"وَقَالَ إِ<g>نِّ</>ى ذَاهِبٌ إِلَىٰ رَبِّى سَيَهْ<p>دِي</>نِ"},{"n":100,"w":[["رَبِّ","rabbi","My Lord","(সে দোয়া করলো) হে আমার রব"],["هَبْ","hab","grant","দাও"],["لِى","lī","me","আমাকে (সন্তান)"],["مِنَ","mina","of","মধ্য হ'তে"],["ٱلصَّـٰلِحِينَ","l-ṣāliḥīna","the righteous","সৎপরায়ণদের\""]],"t":"رَبِّ هَ<q>بْ</> لِى مِنَ <h>ٱ</><l>ل</><m>صَّٰ</>لِ<p>حِي</>نَ"},{"n":101,"w":[["فَبَشَّرْنَـٰهُ","fabasharnāhu","So We gave him the glad tidings","তাকে আমরা ফলে সুসংবাদ দিলাম"],["بِغُلَـٰمٍ","bighulāmin","of a boy","এক পুত্রের"],["حَلِيمٍۢ","ḥalīmin","forbearing","ধীরস্থির"]],"t":"فَبَشَّرْ<m>نَٰ</>هُ بِغُ<m>لَٰ</>مٍ حَ<p>لِي</>مٍۢ"},{"n":102,"w":[["فَلَمَّا","falammā","Then when","অতঃপর যখন"],["بَلَغَ","balagha","he reached","পৌঁছলো"],["مَعَهُ","ma‘ahu","the (age of) working with him","তার সাথে"],["ٱلسَّعْىَ","l-sa‘ya","the (age of) working with him","চলাফেরার (বয়সে)"],["قَالَ","qāla","he said","সে বললো"],["يَـٰبُنَىَّ","yābunayya","O my son","\"হে আমার পুত্র"],["إِنِّىٓ","innī","Indeed, I","নিশ্চয়ই আমি"],["أَرَىٰ","arā","have seen","দেখেছি"],["فِى","fī","in","মধ্যে"],["ٱلْمَنَامِ","l-manāmi","the dream","স্বপ্নের"],["أَنِّىٓ","annī","that I am","যে আমি"],["أَذْبَحُكَ","adhbaḥuka","sacrificing you","তোমাকে জবাই করছি"],["فَٱنظُرْ","fa-unẓur","so look","তাই ভেবে দেখো"],["مَاذَا","mādhā","what","কি"],["تَرَىٰ ۚ","tarā","you see","তোমার মত\""],["قَالَ","qāla","He said","সে বললো"],["يَـٰٓأَبَتِ","yāabati","O my father","\"হে আমার পিতা"],["ٱفْعَلْ","if'‘al","Do","আপনি করুন"],["مَا","mā","what","যা"],["تُؤْمَرُ ۖ","tu'maru","you are commanded","আপনাকে আদেশ করা হয়েছে"],["سَتَجِدُنِىٓ","satajidunī","You will find me","আমাকে আপনি পাবেন"],["إِن","in","if","যদি"],["شَآءَ","shāa","Allah wills","ইচ্ছে করে"],["ٱللَّهُ","l-lahu","Allah wills","আল্লাহ"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلصَّـٰبِرِينَ","l-ṣābirīna","the patient ones","ধৈর্য্যশীলদের\""]],"t":"فَلَ<g>مَّ</>ا بَلَغَ مَعَهُ <h>ٱ</><l>ل</>سَّعْىَ قَالَ <m>يَٰ</>بُنَىَّ إِ<g>نِّ</><o>ىٓ</> أَرَىٰ فِى <h>ٱ</>لْمَنَامِ أَ<g>نِّ</><o>ىٓ</> أَذْبَحُكَ فَ<h>ٱ</><k>نظُ</>رْ مَاذَا تَرَىٰ ۚ قَالَ <o>يَٰٓ</>أَبَتِ <h>ٱ</>فْعَلْ مَا تُؤْمَرُ ۖ سَتَجِدُ<o>نِىٓ</> إِ<k>ن شَ</><o>آ</>ءَ <h>ٱ</>للَّهُ مِنَ <h>ٱ</><l>ل</><m>صَّٰ</>بِ<p>رِي</>نَ"},{"n":103,"w":[["فَلَمَّآ","falammā","Then when","যখন অতঃপর"],["أَسْلَمَا","aslamā","both of them had submitted","অনুগত হয়ে গেলো উভয়ে"],["وَتَلَّهُۥ","watallahu","and he put him down","এবং তাকে শুইয়ে দিলো"],["لِلْجَبِينِ","lil'jabīni","upon his forehead","উপুড় করে"]],"t":"فَلَ<g>مَّ</><o>آ</> أَسْلَمَا وَتَلَّهُ<m>ۥ</> لِلْجَ<p>بِي</>نِ"},{"n":104,"w":[["وَنَـٰدَيْنَـٰهُ","wanādaynāhu","And We called out to him","এবং তাকে আমরা ডাক দিলাম"],["أَن","an","that","যে"],["يَـٰٓإِبْرَٰهِيمُ","yāib'rāhīmu","O Ibrahim","\"হে ইব্রাহীম"]],"t":"وَ<m>نَٰ</>دَيْ<m>نَٰ</>هُ <d>أَن يَٰٓ</>إِ<q>بْ</><m>رَٰ</><p>هِي</>مُ"},{"n":105,"w":[["قَدْ","qad","Verily","নিশ্চয়ই"],["صَدَّقْتَ","ṣaddaqta","you have fulfilled","তুমি সত্য করেছো"],["ٱلرُّءْيَآ ۚ","l-ru'yā","the vision","স্বপ্নকে\""],["إِنَّا","innā","Indeed, We","নিশ্চয়ই আমরা"],["كَذَٰلِكَ","kadhālika","thus","এরূপে"],["نَجْزِى","najzī","[We] reward","প্রতিফল দিই আমরা"],["ٱلْمُحْسِنِينَ","l-muḥ'sinīna","the good-doers","সৎকর্মপরায়ণদের"]],"t":"قَ<q>دْ</> صَدَّ<q>قْ</>تَ <h>ٱ</><l>ل</>رُّءْ<o>يَآ ۚ</> إِ<g>نَّ</>ا كَ<m>ذَٰ</>لِكَ نَ<q>جْ</>زِى <h>ٱ</>لْمُحْسِ<p>نِي</>نَ"},{"n":106,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["هَـٰذَا","hādhā","this","এটা"],["لَهُوَ","lahuwa","(was) surely [it]","তা অবশ্যই (ছিলো)"],["ٱلْبَلَـٰٓؤُا۟","l-balāu","the trial","পরীক্ষা"],["ٱلْمُبِينُ","l-mubīnu","clear","সুস্পষ্ট"]],"t":"إِ<g>نَّ</> <m>هَٰ</>ذَا لَهُوَ <h>ٱ</>لْبَ<o>لَٰٓ</>ؤُ<s>ا۟</> <h>ٱ</>لْمُ<p>بِي</>نُ"},{"n":107,"w":[["وَفَدَيْنَـٰهُ","wafadaynāhu","And We ransomed him","এবং তাকে আমরা ছাড়িয়ে নিই"],["بِذِبْحٍ","bidhib'ḥin","with a sacrifice","জবাই পশুর বিনিময়ে"],["عَظِيمٍۢ","‘aẓīmin","great","বড়"]],"t":"وَفَدَيْ<m>نَٰ</>هُ بِذِ<q>بْ</>حٍ عَ<p>ظِي</>مٍۢ"},{"n":108,"w":[["وَتَرَكْنَا","wataraknā","And We left","এবং আমরা প্রচলিত রাখলাম"],["عَلَيْهِ","‘alayhi","for him","তাঁর উপর"],["فِى","fī","among","মধ্যে"],["ٱلْـَٔاخِرِينَ","l-ākhirīna","the later generations","পরবর্তীদের (তাঁর স্মরণ)"]],"t":"وَتَرَكْنَا عَلَيْهِ فِى <h>ٱ</>لْءَاخِ<p>رِي</>نَ"},{"n":109,"w":[["سَلَـٰمٌ","salāmun","Peace be","\"সালাম (বর্ষিত হোক)"],["عَلَىٰٓ","‘alā","on","উপর"],["إِبْرَٰهِيمَ","ib'rāhīma","Ibrahim","ইবরাহীমের\""]],"t":"سَ<m>لَٰ</>مٌ عَلَ<o>ىٰٓ</> إِ<q>بْ</><m>رَٰ</><p>هِي</>مَ"},{"n":110,"w":[["كَذَٰلِكَ","kadhālika","Thus","এরূপে"],["نَجْزِى","najzī","We reward","প্রতিফল দিই আমরা"],["ٱلْمُحْسِنِينَ","l-muḥ'sinīna","the good-doers","উত্তম কর্মশীলদেরকে"]],"t":"كَ<m>ذَٰ</>لِكَ نَ<q>جْ</>زِى <h>ٱ</>لْمُحْسِ<p>نِي</>نَ"},{"n":111,"w":[["إِنَّهُۥ","innahu","Indeed, he (was)","সে নিশ্চয়ই (ছিলো)"],["مِنْ","min","of","অন্তর্ভুক্ত"],["عِبَادِنَا","‘ibādinā","Our slaves","আমাদের দাসদের"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","believing","(যারা ছিলো) মু'মিন"]],"t":"إِ<g>نَّ</>هُ<m>ۥ</> مِنْ عِبَادِنَا <h>ٱ</>لْمُؤْمِ<p>نِي</>نَ"},{"n":112,"w":[["وَبَشَّرْنَـٰهُ","wabasharnāhu","And We gave him glad tidings","এবং তাকে আমরা সুসংবাদ দিলাম"],["بِإِسْحَـٰقَ","bi-is'ḥāqa","of Isaac","ইসহাক সম্পর্কে"],["نَبِيًّۭا","nabiyyan","a Prophet","একজন নাবী হিসেবে"],["مِّنَ","mina","among","অন্যতম"],["ٱلصَّـٰلِحِينَ","l-ṣāliḥīna","the righteous","সৎকর্মশীলদের"]],"t":"وَبَشَّرْ<m>نَٰ</>هُ بِإِسْ<m>حَٰ</>قَ نَبِ<d>يًّۭا مِّ</>نَ <h>ٱ</><l>ل</><m>صَّٰ</>لِ<p>حِي</>نَ"},{"n":113,"w":[["وَبَـٰرَكْنَا","wabāraknā","And We blessed","এবং আমরা সমৃদ্ধি দিলাম"],["عَلَيْهِ","‘alayhi","him","তাঁর উপর"],["وَعَلَىٰٓ","wa‘alā","and [on]","ও উপর"],["إِسْحَـٰقَ ۚ","is'ḥāqa","Isaac","ইসহাকের"],["وَمِن","wamin","And of","এবং মধ্য হ'তে"],["ذُرِّيَّتِهِمَا","dhurriyyatihimā","their offspring","তাদের দু'জনের বংশধরদের"],["مُحْسِنٌۭ","muḥ'sinun","(are) good-doers","(কেউ হয়) সৎকর্মপরায়ণ"],["وَظَالِمٌۭ","waẓālimun","and unjust","ও (কেউ হয়) সীমালঙ্ঘনকারী"],["لِّنَفْسِهِۦ","linafsihi","to himself","তার নিজের উপর"],["مُبِينٌۭ","mubīnun","clear","সুস্পষ্ট"]],"t":"وَ<m>بَٰ</>رَكْنَا عَلَيْهِ وَعَلَ<o>ىٰٓ</> إِسْ<m>حَٰ</>قَ ۚ وَمِ<k>ن ذُ</>رِّيَّتِهِمَا مُحْسِ<d>نٌۭ وَ</>ظَالِ<w>مٌۭ لِّ</>نَفْسِ<m>هِۦ</> مُ<p>بِي</>نٌۭ"},{"n":114,"w":[["وَلَقَدْ","walaqad","And verily","এবং নিশ্চয়ই"],["مَنَنَّا","manannā","We conferred Favor","আমরা অনুগ্রহ করেছি"],["عَلَىٰ","‘alā","upon","উপর"],["مُوسَىٰ","mūsā","Musa","মূসার"],["وَهَـٰرُونَ","wahārūna","and Harun","ও হারূনের"]],"t":"وَلَقَ<q>دْ</> مَنَ<g>نَّ</>ا عَلَىٰ مُوسَىٰ وَ<m>هَٰ</><p>رُو</>نَ"},{"n":115,"w":[["وَنَجَّيْنَـٰهُمَا","wanajjaynāhumā","And We saved both of them","এবং উদ্ধার করেছি আমরা উভয়কে"],["وَقَوْمَهُمَا","waqawmahumā","and their people","ও উভয়ের জাতিকে"],["مِنَ","mina","from","হ'তে"],["ٱلْكَرْبِ","l-karbi","the distress","সংকট"],["ٱلْعَظِيمِ","l-‘aẓīmi","the great","মহা"]],"t":"وَنَجَّيْ<m>نَٰ</>هُمَا وَقَوْمَهُمَا مِنَ <h>ٱ</>لْكَرْبِ <h>ٱ</>لْعَ<p>ظِي</>مِ"},{"n":116,"w":[["وَنَصَرْنَـٰهُمْ","wanaṣarnāhum","And We helped them","এবং তাদেরকে আমরা সাহায্য করেছি"],["فَكَانُوا۟","fakānū","so they became","অতঃপর তারা হয়েছিলো"],["هُمُ","humu","so they became","তারাই"],["ٱلْغَـٰلِبِينَ","l-ghālibīna","the victors","বিজয়ী"]],"t":"وَنَصَرْ<m>نَٰ</>هُمْ فَكَانُو<s>ا۟</> هُمُ <h>ٱ</>لْ<m>غَٰ</>لِ<p>بِي</>نَ"},{"n":117,"w":[["وَءَاتَيْنَـٰهُمَا","waātaynāhumā","And We gave both of them","এবং উভয়কে আমরা দিয়েছি"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","কিতাব"],["ٱلْمُسْتَبِينَ","l-mus'tabīna","the clear","স্পষ্ট"]],"t":"وَءَاتَيْ<m>نَٰ</>هُمَا <h>ٱ</>لْكِ<m>تَٰ</>بَ <h>ٱ</>لْمُسْتَ<p>بِي</>نَ"},{"n":118,"w":[["وَهَدَيْنَـٰهُمَا","wahadaynāhumā","And We guided both of them","এবং উভয়কে আমরা পরিচালিত করেছি"],["ٱلصِّرَٰطَ","l-ṣirāṭa","(to) the Path","পথে"],["ٱلْمُسْتَقِيمَ","l-mus'taqīma","the Straight","সরল সঠিক"]],"t":"وَهَدَيْ<m>نَٰ</>هُمَا <h>ٱ</><l>ل</>صِّ<m>رَٰ</>طَ <h>ٱ</>لْمُسْتَ<p>قِي</>مَ"},{"n":119,"w":[["وَتَرَكْنَا","wataraknā","And We left","এবং আমরা অবশিষ্ট রেখেছি"],["عَلَيْهِمَا","‘alayhimā","for both of them","তাদের উভয়ের সম্বন্ধে"],["فِى","fī","among","মধ্যে"],["ٱلْـَٔاخِرِينَ","l-ākhirīna","the later generations","পরবর্তীদের (উত্তম স্মরণ)"]],"t":"وَتَرَكْنَا عَلَيْهِمَا فِى <h>ٱ</>لْءَاخِ<p>رِي</>نَ"},{"n":120,"w":[["سَلَـٰمٌ","salāmun","Peace be","\"সালাম (বর্ষিত হউক)"],["عَلَىٰ","‘alā","upon","উপর"],["مُوسَىٰ","mūsā","Musa","মূসার"],["وَهَـٰرُونَ","wahārūna","and Harun","ও হারূনের\""]],"t":"سَ<m>لَٰ</>مٌ عَلَىٰ مُوسَىٰ وَ<m>هَٰ</><p>رُو</>نَ"},{"n":121,"w":[["إِنَّا","innā","Indeed, We","নিশ্চয়ই আমরা"],["كَذَٰلِكَ","kadhālika","thus","এরূপে"],["نَجْزِى","najzī","reward","প্রতিফল দিই আমরা"],["ٱلْمُحْسِنِينَ","l-muḥ'sinīna","the good-doers","সৎকর্মপরায়ণদের"]],"t":"إِ<g>نَّ</>ا كَ<m>ذَٰ</>لِكَ نَ<q>جْ</>زِى <h>ٱ</>لْمُحْسِ<p>نِي</>نَ"},{"n":122,"w":[["إِنَّهُمَا","innahumā","Indeed, both of them","নিশ্চয়ই তারা দু'জনও"],["مِنْ","min","(were) of","অন্তর্ভুক্ত"],["عِبَادِنَا","‘ibādinā","Our slaves","আমাদের দাসদের"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","believing","(যারা ছিলো) মু'মিন"]],"t":"إِ<g>نَّ</>هُمَا مِنْ عِبَادِنَا <h>ٱ</>لْمُؤْمِ<p>نِي</>نَ"},{"n":123,"w":[["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["إِلْيَاسَ","il'yāsa","Elijah","ইলয়াস"],["لَمِنَ","lamina","(was) surely of","অবশ্যই অন্যতম"],["ٱلْمُرْسَلِينَ","l-mur'salīna","the Messengers","রাসূলদের"]],"t":"وَإِ<g>نَّ</> إِلْيَاسَ لَمِنَ <h>ٱ</>لْمُرْسَ<p>لِي</>نَ"},{"n":124,"w":[["إِذْ","idh","When","(স্মরণ করো) যখন"],["قَالَ","qāla","he said","সে বলেছিলো"],["لِقَوْمِهِۦٓ","liqawmihi","to his people","তার জাতিকে"],["أَلَا","alā","Will not","\"না কি"],["تَتَّقُونَ","tattaqūna","you fear","তোমরা সাবধান হবে"]],"t":"إِذْ قَالَ لِقَوْمِ<o>هِۦٓ</> أَلَا تَتَّ<p>قُو</>نَ"},{"n":125,"w":[["أَتَدْعُونَ","atad‘ūna","Do you call","তোমরা ডাকবে কি"],["بَعْلًۭا","ba‘lan","Baal","বা'আল (নামক মূর্তিকে)"],["وَتَذَرُونَ","watadharūna","and you forsake","আর ত্যাগ করবে"],["أَحْسَنَ","aḥsana","(the) Best","সর্বশ্রেষ্ঠ"],["ٱلْخَـٰلِقِينَ","l-khāliqīna","(of) Creators ","স্রষ্টা"]],"t":"أَتَ<q>دْ</>عُونَ بَعْلًۭ<d>ا وَ</>تَذَرُونَ أَحْسَنَ <h>ٱ</>لْ<m>خَٰ</>لِ<p>قِي</>نَ"},{"n":126,"w":[["ٱللَّهَ","al-laha","Allah","(অর্থাৎ) আল্লাহকে"],["رَبَّكُمْ","rabbakum","your Lord","(যিনি) তোমাদের রব"],["وَرَبَّ","warabba","and (the) Lord","ও রব"],["ءَابَآئِكُمُ","ābāikumu","(of) your forefathers","তোমাদের পিতৃপুরুষদেরও\""],["ٱلْأَوَّلِينَ","l-awalīna","(of) your forefathers","পূর্বের\""]],"t":"ٱللَّهَ رَبَّكُمْ وَرَبَّ ءَا<o>بَآ</>ئِكُمُ <h>ٱ</>لْأَوَّ<p>لِي</>نَ"},{"n":127,"w":[["فَكَذَّبُوهُ","fakadhabūhu","But they denied him","তাকে তারা তখন অমান্য করলো"],["فَإِنَّهُمْ","fa-innahum","so indeed, they","নিশ্চয় তাই তাদের"],["لَمُحْضَرُونَ","lamuḥ'ḍarūna","(will) surely be brought","উপস্থিত করা হবে অবশ্যই (শাস্তির জন্যে)"]],"t":"فَكَذَّبُوهُ فَإِ<g>نَّ</>هُمْ لَمُحْضَ<p>رُو</>نَ"},{"n":128,"w":[["إِلَّا","illā","Except","তবে (ব্যতিক্রম)"],["عِبَادَ","‘ibāda","(the) slaves","দাসরা"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["ٱلْمُخْلَصِينَ","l-mukh'laṣīna","the chosen ones","(যারা) একনিষ্ঠ"]],"t":"إِلَّا عِبَادَ <h>ٱ</>للَّهِ <h>ٱ</>لْمُخْلَ<p>صِي</>نَ"},{"n":129,"w":[["وَتَرَكْنَا","wataraknā","And We left","এবং আমরা রেখেছি"],["عَلَيْهِ","‘alayhi","for him","তার সমন্ধে"],["فِى","fī","among","মধ্যে"],["ٱلْـَٔاخِرِينَ","l-ākhirīna","the later generations","পরবর্তীদের (উত্তম স্মরণ)"]],"t":"وَتَرَكْنَا عَلَيْهِ فِى <h>ٱ</>لْءَاخِ<p>رِي</>نَ"},{"n":130,"w":[["سَلَـٰمٌ","salāmun","Peace be","\"সালাম (বর্ষিত হোক)"],["عَلَىٰٓ","‘alā","upon","উপর"],["إِلْ يَاسِينَ","il yāsīna","Elijah","ইলিয়াসের\""]],"t":"سَ<m>لَٰ</>مٌ عَلَ<o>ىٰٓ</> إِلْ يَا<p>سِي</>نَ"},{"n":131,"w":[["إِنَّا","innā","Indeed, We","নিশ্চয়ই আমরা"],["كَذَٰلِكَ","kadhālika","thus","এরূপে"],["نَجْزِى","najzī","reward","প্রতিফল দিই আমরা"],["ٱلْمُحْسِنِينَ","l-muḥ'sinīna","the good-doers","সৎকর্মশীলদের"]],"t":"إِ<g>نَّ</>ا كَ<m>ذَٰ</>لِكَ نَ<q>جْ</>زِى <h>ٱ</>لْمُحْسِ<p>نِي</>نَ"},{"n":132,"w":[["إِنَّهُۥ","innahu","Indeed, he (was)","সে নিশ্চয়ই"],["مِنْ","min","of","অন্তর্ভুক্ত"],["عِبَادِنَا","‘ibādinā","Our slaves","আমাদের দাসদের"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","believing","(যারা) মু'মিন"]],"t":"إِ<g>نَّ</>هُ<m>ۥ</> مِنْ عِبَادِنَا <h>ٱ</>لْمُؤْمِ<p>نِي</>نَ"},{"n":133,"w":[["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["لُوطًۭا","lūṭan","Lut","লুতও (ছিলো)"],["لَّمِنَ","lamina","(was) of","অন্যতম অবশ্যই"],["ٱلْمُرْسَلِينَ","l-mur'salīna","the Messengers","রাসূলদের"]],"t":"وَإِ<g>نَّ</> لُو<w>طًۭا لَّ</>مِنَ <h>ٱ</>لْمُرْسَ<p>لِي</>نَ"},{"n":134,"w":[["إِذْ","idh","When","(স্মরণ করো) যখন"],["نَجَّيْنَـٰهُ","najjaynāhu","We saved him","তাকে আমরা উদ্ধার করেছিলাম"],["وَأَهْلَهُۥٓ","wa-ahlahu","and his family","এবং তারা পরিবারের"],["أَجْمَعِينَ","ajma‘īna","all","সকলকে"]],"t":"إِذْ نَجَّيْ<m>نَٰ</>هُ وَأَهْلَهُ<o>ۥٓ</> أَ<q>جْ</>مَ<p>عِي</>نَ"},{"n":135,"w":[["إِلَّا","illā","Except","ব্যতীত"],["عَجُوزًۭا","‘ajūzan","an old woman","এক বৃদ্ধাকে (অর্থাৎ তার স্ত্রীকে)"],["فِى","fī","(was) among","(সে ছিলো) অন্তর্ভুক্ত"],["ٱلْغَـٰبِرِينَ","l-ghābirīna","those who remained behind","পিছনে অবস্থানকারীদের"]],"t":"إِلَّا عَجُو<k>زًۭا فِ</>ى <h>ٱ</>لْ<m>غَٰ</>بِ<p>رِي</>نَ"},{"n":136,"w":[["ثُمَّ","thumma","Then","এরপর"],["دَمَّرْنَا","dammarnā","We destroyed","আমরা ধ্বংস করেছিলাম"],["ٱلْـَٔاخَرِينَ","l-ākharīna","the others","বাকিদেরকে"]],"t":"ثُ<g>مَّ</> دَ<g>مَّ</>رْنَا <h>ٱ</>لْءَاخَ<p>رِي</>نَ"},{"n":137,"w":[["وَإِنَّكُمْ","wa-innakum","And indeed, you","এবং নিশ্চয়ই তোমরা"],["لَتَمُرُّونَ","latamurrūna","surely pass","অবশ্যই আসা-যাওয়া করে থাকো"],["عَلَيْهِم","‘alayhim","by them","তাদের (ধ্বংসপ্রাপ্ত এলাকার) উপর দিয়ে"],["مُّصْبِحِينَ","muṣ'biḥīna","(in the) morning","সকালে"]],"t":"وَإِ<g>نَّ</>كُمْ لَتَمُرُّونَ عَلَيْ<y>هِم مُّ</>صْبِ<p>حِي</>نَ"},{"n":138,"w":[["وَبِٱلَّيْلِ ۗ","wabi-al-layli","And at night","ও সন্ধ্যায়"],["أَفَلَا","afalā","Then will not","তবুও কিনা"],["تَعْقِلُونَ","ta‘qilūna","you use reason","তোমরা জ্ঞান কাজে লাগাও"]],"t":"وَبِ<h>ٱ</>لَّيْلِ ۗ أَفَلَا تَعْقِ<p>لُو</>نَ"},{"n":139,"w":[["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["يُونُسَ","yūnusa","Yunus","ইউনূসও (ছিলো)"],["لَمِنَ","lamina","(was) surely of","অবশ্যই অন্যতম"],["ٱلْمُرْسَلِينَ","l-mur'salīna","the Messengers","রাসূলদের"]],"t":"وَإِ<g>نَّ</> يُونُسَ لَمِنَ <h>ٱ</>لْمُرْسَ<p>لِي</>نَ"},{"n":140,"w":[["إِذْ","idh","When","(স্মরণ করো) যখন"],["أَبَقَ","abaqa","he ran away","সে পালিয়েছিলো"],["إِلَى","ilā","to","দিকে"],["ٱلْفُلْكِ","l-ful'ki","the ship","নৌকার"],["ٱلْمَشْحُونِ","l-mashḥūni","laden","বোঝাই"]],"t":"إِذْ أَبَقَ إِلَى <h>ٱ</>لْفُلْكِ <h>ٱ</>لْمَشْ<p>حُو</>نِ"},{"n":141,"w":[["فَسَاهَمَ","fasāhama","Then he drew lots","অতঃপর সে লটারীতে অংশ নিলো"],["فَكَانَ","fakāna","and was","তখন সে হলো"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْمُدْحَضِينَ","l-mud'ḥaḍīna","the losers","পরাস্তদের (আর পানিতে নিক্ষিপ্ত হলো)"]],"t":"فَسَاهَمَ فَكَانَ مِنَ <h>ٱ</>لْمُ<q>دْ</>حَ<p>ضِي</>نَ"},{"n":142,"w":[["فَٱلْتَقَمَهُ","fal-taqamahu","Then swallowed him","তাকে অতঃপর গিলে ফেললো"],["ٱلْحُوتُ","l-ḥūtu","the fish","মাছ"],["وَهُوَ","wahuwa","while he","এবং সে"],["مُلِيمٌۭ","mulīmun","(was) blameworthy","নিজেকে ধিক্কারকারী হলো"]],"t":"فَ<h>ٱ</>لْتَقَمَهُ <h>ٱ</>لْحُوتُ وَهُوَ مُ<p>لِي</>مٌۭ"},{"n":143,"w":[["فَلَوْلَآ","falawlā","And if not","তখন যদি না"],["أَنَّهُۥ","annahu","that he","সে"],["كَانَ","kāna","was","হতো"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْمُسَبِّحِينَ","l-musabiḥīna","those who glorify","মহিমা ঘোষণাকারীদের"]],"t":"فَلَوْ<o>لَآ</> أَ<g>نَّ</>هُ<m>ۥ</> كَانَ مِنَ <h>ٱ</>لْمُسَبِّ<p>حِي</>نَ"},{"n":144,"w":[["لَلَبِثَ","lalabitha","Certainly, he (would have) remained","অবশ্যই সে থাকতো"],["فِى","fī","in","মধ্যে"],["بَطْنِهِۦٓ","baṭnihi","its belly","তার পেটের"],["إِلَىٰ","ilā","until","পর্যন্ত"],["يَوْمِ","yawmi","the Day","দিন"],["يُبْعَثُونَ","yub'‘athūna","they are resurrected","উত্থানের"]],"t":"لَلَبِثَ فِى بَ<q>طْ</>نِ<o>هِۦٓ</> إِلَىٰ يَوْمِ يُ<q>بْ</>عَ<p>ثُو</>نَ"},{"n":145,"w":[["۞ فَنَبَذْنَـٰهُ","fanabadhnāhu","But We cast him","তাকে আমরা এরপর নিক্ষেপ করলাম"],["بِٱلْعَرَآءِ","bil-‘arāi","onto the open shore","তৃণহীন প্রান্তরে"],["وَهُوَ","wahuwa","while he","এমনাবস্হায় যে সে"],["سَقِيمٌۭ","saqīmun","(was) ill","(ছিলো) অসুস্থ"]],"t":"۞ فَنَبَذْ<m>نَٰ</>هُ بِ<h>ٱ</>لْعَ<o>رَآ</>ءِ وَهُوَ سَ<p>قِي</>مٌۭ"},{"n":146,"w":[["وَأَنۢبَتْنَا","wa-anbatnā","And We caused to grow","এবং আমরা উৎপন্ন করলাম"],["عَلَيْهِ","‘alayhi","over him","তার জন্যে"],["شَجَرَةًۭ","shajaratan","a plant","গাছ"],["مِّن","min","of","থেকে"],["يَقْطِينٍۢ","yaqṭīnin","gourd","লাউগাছ"]],"t":"وَأَ<i>نۢبَ</>تْنَا عَلَيْهِ شَجَرَ<d>ةًۭ مِّن يَ</><q>قْ</><p>طِي</>نٍۢ"},{"n":147,"w":[["وَأَرْسَلْنَـٰهُ","wa-arsalnāhu","And We sent him","এবং তাকে আমরা পাঠালাম"],["إِلَىٰ","ilā","to","প্রতি"],["مِا۟ئَةِ","mi-ati","a hundred","একশত"],["أَلْفٍ","alfin","thousand","হাজার (অর্থাৎ এক লক্ষ)"],["أَوْ","aw","or","বা"],["يَزِيدُونَ","yazīdūna","more","আরও বেশী (লোকদের কাছে)"]],"t":"وَأَرْسَلْ<m>نَٰ</>هُ إِلَىٰ مِ<s>ا۟</>ئَةِ أَلْفٍ أَوْ يَزِي<p>دُو</>نَ"},{"n":148,"w":[["فَـَٔامَنُوا۟","faāmanū","And they believed","তারা অতঃপর ঈমান আনে"],["فَمَتَّعْنَـٰهُمْ","famatta‘nāhum","so We gave them enjoyment","তাদেরকে আমরা অতঃপর জীবন উপভোগ করতে দিলাম"],["إِلَىٰ","ilā","for","পর্যন্ত"],["حِينٍۢ","ḥīnin","a while","নির্দিষ্টকাল"]],"t":"فَـَٔامَنُو<s>ا۟</> فَمَتَّعْ<m>نَٰ</>هُمْ إِلَىٰ <p>حِي</>نٍۢ"},{"n":149,"w":[["فَٱسْتَفْتِهِمْ","fa-is'taftihim","Then ask them","তাদেরকে অতঃপর জিজ্ঞাসা করো"],["أَلِرَبِّكَ","alirabbika","Does your Lord","\"তোমার রবের জন্যে কি"],["ٱلْبَنَاتُ","l-banātu","(have) daughters","কন্যাসমূহ (আছে)"],["وَلَهُمُ","walahumu","while for them","এবং তাদের জন্যে (আছে)"],["ٱلْبَنُونَ","l-banūna","(are) sons","পুত্রসমূহ\""]],"t":"فَ<h>ٱ</>سْتَفْتِهِمْ أَلِرَبِّكَ <h>ٱ</>لْبَنَاتُ وَلَهُمُ <h>ٱ</>لْبَ<p>نُو</>نَ"},{"n":150,"w":[["أَمْ","am","Or","অথবা"],["خَلَقْنَا","khalaqnā","did We create","আমরা সৃষ্টি করেছি"],["ٱلْمَلَـٰٓئِكَةَ","l-malāikata","the Angels","ফেরেশতাদেরকে"],["إِنَـٰثًۭا","ināthan","females","নারীরূপে"],["وَهُمْ","wahum","while they","আর তারা"],["شَـٰهِدُونَ","shāhidūna","(were) witnesses","দেখেছে"]],"t":"أَمْ خَلَ<q>قْ</>نَا <h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةَ إِ<m>نَٰ</><d>ثًۭا وَ</>هُمْ <m>شَٰ</>هِ<p>دُو</>نَ"},{"n":151,"w":[["أَلَآ","alā","No doubt","সাবধান"],["إِنَّهُم","innahum","indeed, they","তারা নিশ্চয়ই"],["مِّنْ","min","of","হ'তে"],["إِفْكِهِمْ","if'kihim","their falsehood","তাদের মনগড়া কথা"],["لَيَقُولُونَ","layaqūlūna","[they] say","বলছে অবশ্যই (যে)"]],"t":"أَ<o>لَآ</> إِ<g>نَّ</><y>هُم مِّ</>نْ إِفْكِهِمْ لَيَقُو<p>لُو</>نَ"},{"n":152,"w":[["وَلَدَ","walada","Allah has begotten","\"সন্তান জন্ম দিয়েছেন\""],["ٱللَّهُ","l-lahu","Allah has begotten","\"আল্লাহ\""],["وَإِنَّهُمْ","wa-innahum","and indeed, they","এবং তারা নিশ্চয়ই"],["لَكَـٰذِبُونَ","lakādhibūna","surely (are) liars","মিথ্যাবাদী অবশ্যই"]],"t":"وَلَدَ <h>ٱ</>للَّهُ وَإِ<g>نَّ</>هُمْ لَ<m>كَٰ</>ذِ<p>بُو</>نَ"},{"n":153,"w":[["أَصْطَفَى","aṣṭafā","Has He chosen","তিনি পছন্দ করেছেন কি"],["ٱلْبَنَاتِ","l-banāti","[the] daughters","কন্যাদেরকে"],["عَلَى","‘alā","over","পরিবর্তে"],["ٱلْبَنِينَ","l-banīna","sons","পুত্রসন্তানদের"]],"t":"أَصْطَفَى <h>ٱ</>لْبَنَاتِ عَلَى <h>ٱ</>لْبَ<p>نِي</>نَ"},{"n":154,"w":[["مَا","mā","What is with you","কি"],["لَكُمْ","lakum","What is with you","তোমাদের হয়েছে"],["كَيْفَ","kayfa","How","কেমন"],["تَحْكُمُونَ","taḥkumūna","you judge","তোমরা বিচার করো"]],"t":"مَا لَكُمْ كَيْفَ تَحْكُ<p>مُو</>نَ"},{"n":155,"w":[["أَفَلَا","afalā","Then will not","তবে কি না"],["تَذَكَّرُونَ","tadhakkarūna","you pay heed","তোমরা উপদেশ গ্রহণ করবে"]],"t":"أَفَلَا تَذَكَّ<p>رُو</>نَ"},{"n":156,"w":[["أَمْ","am","Or","অথবা"],["لَكُمْ","lakum","(is) for you","তোমাদের (আছে)"],["سُلْطَـٰنٌۭ","sul'ṭānun","an authority","প্রমাণ"],["مُّبِينٌۭ","mubīnun","clear","সুস্পষ্ট"]],"t":"أَمْ لَكُمْ سُلْ<m>طَٰ</><d>نٌۭ مُّ</><p>بِي</>نٌۭ"},{"n":157,"w":[["فَأْتُوا۟","fatū","Then bring","তাহ'লে তোমরা আনো"],["بِكِتَـٰبِكُمْ","bikitābikum","your book","তোমাদের কিতাব"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you are","তোমরা হও"],["صَـٰدِقِينَ","ṣādiqīna","truthful","সত্যবাদী"]],"t":"فَأْتُو<s>ا۟</> بِكِ<m>تَٰ</>بِكُمْ إِ<k>ن كُنتُ</>مْ <m>صَٰ</>دِ<p>قِي</>نَ"},{"n":158,"w":[["وَجَعَلُوا۟","waja‘alū","And they have made","এবং তারা স্হির করেছে"],["بَيْنَهُۥ","baynahu","between Him","তাঁর মাঝে"],["وَبَيْنَ","wabayna","and between","ও মাঝে"],["ٱلْجِنَّةِ","l-jinati","the jinn","জিনদের"],["نَسَبًۭا ۚ","nasaban","a relationship","বংশীয় সম্পর্ক"],["وَلَقَدْ","walaqad","but certainly","অথচ নিশ্চয়ই"],["عَلِمَتِ","‘alimati","know","জেনেছে"],["ٱلْجِنَّةُ","l-jinatu","the jinn","জিনরা"],["إِنَّهُمْ","innahum","that they","নিশ্চয়ই তাদেরকে"],["لَمُحْضَرُونَ","lamuḥ'ḍarūna","(will) surely be brought","অবশ্যই উপস্থিত করা হবে"]],"t":"وَجَعَلُو<s>ا۟</> بَيْنَهُ<m>ۥ</> وَبَيْنَ <h>ٱ</>لْجِ<g>نَّ</>ةِ نَسَ<d>بًۭا ۚ وَ</>لَقَ<q>دْ</> عَلِمَتِ <h>ٱ</>لْجِ<g>نَّ</>ةُ إِ<g>نَّ</>هُمْ لَمُحْضَ<p>رُو</>نَ"},{"n":159,"w":[["سُبْحَـٰنَ","sub'ḥāna","Glory be","পবিত্র"],["ٱللَّهِ","l-lahi","(to) Allah","আল্লাহ"],["عَمَّا","‘ammā","above what","তা হ'তে যা"],["يَصِفُونَ","yaṣifūna","they attribute","তারা আরোপ করে"]],"t":"سُ<q>بْ</><m>حَٰ</>نَ <h>ٱ</>للَّهِ عَ<g>مَّ</>ا يَصِ<p>فُو</>نَ"},{"n":160,"w":[["إِلَّا","illā","Except","তবে ব্যতিক্রম"],["عِبَادَ","‘ibāda","(the) slaves","(ঐসব) দাস"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["ٱلْمُخْلَصِينَ","l-mukh'laṣīna","the chosen","(যারা) একনিষ্ঠ"]],"t":"إِلَّا عِبَادَ <h>ٱ</>للَّهِ <h>ٱ</>لْمُخْلَ<p>صِي</>نَ"},{"n":161,"w":[["فَإِنَّكُمْ","fa-innakum","So indeed, you","সুতরাং তোমরা নিশ্চয়ই"],["وَمَا","wamā","and what","এবং যাদেরকে"],["تَعْبُدُونَ","ta‘budūna","you worship","তোমরা উপাসনা করো"]],"t":"فَإِ<g>نَّ</>كُمْ وَمَا تَعْبُ<p>دُو</>نَ"},{"n":162,"w":[["مَآ","mā","Not","না"],["أَنتُمْ","antum","you","তোমরা"],["عَلَيْهِ","‘alayhi","from Him","তাঁর সম্বন্ধে (কাউকে)"],["بِفَـٰتِنِينَ","bifātinīna","can tempt away (anyone)","বিভ্রান্ত করতে পারবে"]],"t":"<o>مَآ</> أَ<k>نتُ</>مْ عَلَيْهِ بِ<m>فَٰ</>تِ<p>نِي</>نَ"},{"n":163,"w":[["إِلَّا","illā","Except","তবে (পারবে)"],["مَنْ","man","who","তাকে"],["هُوَ","huwa","he","যে"],["صَالِ","ṣāli","(is) to burn","প্রবেশকারী"],["ٱلْجَحِيمِ","l-jaḥīmi","(in) the Hellfire","প্রজ্জ্বলিত আগুনে"]],"t":"إِلَّا مَنْ هُوَ صَالِ <h>ٱ</>لْجَ<p>حِي</>مِ"},{"n":164,"w":[["وَمَا","wamā","And not","\"এবং নাই"],["مِنَّآ","minnā","among us","আমাদের মধ্য কেউ"],["إِلَّا","illā","except","এ ব্যতীত যে"],["لَهُۥ","lahu","for him","তার জন্যে"],["مَقَامٌۭ","maqāmun","(is) a position","স্থান"],["مَّعْلُومٌۭ","ma‘lūmun","known","নির্দিষ্ট (রয়েছে)"]],"t":"وَمَا مِ<g>نَّ</><o>آ</> إِلَّا لَهُ<m>ۥ</> مَقَا<d>مٌۭ مَّ</>عْ<p>لُو</>مٌۭ"},{"n":165,"w":[["وَإِنَّا","wa-innā","And indeed, we","এবং নিশ্চয়ই"],["لَنَحْنُ","lanaḥnu","surely, [we]","আমরা অবশ্যই"],["ٱلصَّآفُّونَ","l-ṣāfūna","stand in rows","সারি বেঁধে দাঁড়িয়ে আছি"]],"t":"وَإِ<g>نَّ</>ا لَنَحْنُ <h>ٱ</><l>ل</><n>صَّآ</><p>فُّو</>نَ"},{"n":166,"w":[["وَإِنَّا","wa-innā","And indeed, we","এবং নিশ্চয়ই আমরা"],["لَنَحْنُ","lanaḥnu","surely, [we]","আমরা অবশ্যই"],["ٱلْمُسَبِّحُونَ","l-musabiḥūna","glorify (Allah)","মহিমা ঘোষণাকারী\""]],"t":"وَإِ<g>نَّ</>ا لَنَحْنُ <h>ٱ</>لْمُسَبِّ<p>حُو</>نَ"},{"n":167,"w":[["وَإِن","wa-in","And indeed","এবং যদিও"],["كَانُوا۟","kānū","they used to","(তারা)"],["لَيَقُولُونَ","layaqūlūna","say","তারা বলেই আসছে"]],"t":"وَإِ<k>ن كَ</>انُو<s>ا۟</> لَيَقُو<p>لُو</>نَ"},{"n":168,"w":[["لَوْ","law","If","\"যদি"],["أَنَّ","anna","that","নিশ্চিত"],["عِندَنَا","‘indanā","we had","আমাদের কাছে"],["ذِكْرًۭا","dhik'ran","a reminder","কোনো কিতাব"],["مِّنَ","mina","from","মতো"],["ٱلْأَوَّلِينَ","l-awalīna","the former (people)","পূর্ববর্তীদের"]],"t":"لَوْ أَ<g>نَّ</> عِ<k>ندَ</>نَا ذِكْ<d>رًۭا مِّ</>نَ <h>ٱ</>لْأَوَّ<p>لِي</>نَ"},{"n":169,"w":[["لَكُنَّا","lakunnā","Certainly, we (would) have been","অবশ্যই আমরা হতাম"],["عِبَادَ","‘ibāda","slaves","দাস"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["ٱلْمُخْلَصِينَ","l-mukh'laṣīna","the chosen","(যারা) একনিষ্ঠ\""]],"t":"لَكُ<g>نَّ</>ا عِبَادَ <h>ٱ</>للَّهِ <h>ٱ</>لْمُخْلَ<p>صِي</>نَ"},{"n":170,"w":[["فَكَفَرُوا۟","fakafarū","But they disbelieved","কিন্তু তারা অস্বীকার করলো"],["بِهِۦ ۖ","bihi","in it","তাকে"],["فَسَوْفَ","fasawfa","so soon","শীঘ্রই তাই"],["يَعْلَمُونَ","ya‘lamūna","they will know","তারা জানবে"]],"t":"فَكَفَرُو<s>ا۟</> بِ<m>هِۦ</> ۖ فَسَوْفَ يَعْلَ<p>مُو</>نَ"},{"n":171,"w":[["وَلَقَدْ","walaqad","And verily","এবং নিশ্চয়ই"],["سَبَقَتْ","sabaqat","has preceded","পূর্বে স্থির হয়েছে"],["كَلِمَتُنَا","kalimatunā","Our Word","আমাদের বাণী (ওয়াদা)"],["لِعِبَادِنَا","li‘ibādinā","for Our slaves","আমাদের দাসদের জন্যে"],["ٱلْمُرْسَلِينَ","l-mur'salīna","the Messengers","যারা প্রেরিত রাসূল"]],"t":"وَلَقَ<q>دْ</> سَبَقَتْ كَلِمَتُنَا لِعِبَادِنَا <h>ٱ</>لْمُرْسَ<p>لِي</>نَ"},{"n":172,"w":[["إِنَّهُمْ","innahum","Indeed they","(ঐ বিষয়ে যে) তারা নিশ্চয়ই"],["لَهُمُ","lahumu","surely they","তারাই"],["ٱلْمَنصُورُونَ","l-manṣūrūna","(would be) the victorious","সাহায্যপ্রাপ্ত হবে"]],"t":"إِ<g>نَّ</>هُمْ لَهُمُ <h>ٱ</>لْمَ<k>نصُ</>و<p>رُو</>نَ"},{"n":173,"w":[["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["جُندَنَا","jundanā","Our host","আমাদের সৈন্যরা"],["لَهُمُ","lahumu","surely, they","তারাই"],["ٱلْغَـٰلِبُونَ","l-ghālibūna","(will be) those who overcome","বিজয়ী হবে"]],"t":"وَإِ<g>نَّ</> جُ<k>ندَ</>نَا لَهُمُ <h>ٱ</>لْ<m>غَٰ</>لِ<p>بُو</>نَ"},{"n":174,"w":[["فَتَوَلَّ","fatawalla","So turn away","সুতরাং উপেক্ষা করো"],["عَنْهُمْ","‘anhum","from them","তাদেরকে"],["حَتَّىٰ","ḥattā","until","পর্যন্ত"],["حِينٍۢ","ḥīnin","a time","কিছুকাল"]],"t":"فَتَوَلَّ عَنْهُمْ حَتَّىٰ <p>حِي</>نٍۢ"},{"n":175,"w":[["وَأَبْصِرْهُمْ","wa-abṣir'hum","And see them","এবং দেখতে থাকো তাদেরকে"],["فَسَوْفَ","fasawfa","so soon","অতঃপর শীঘ্রই"],["يُبْصِرُونَ","yub'ṣirūna","they will see","তারাই দেখবে"]],"t":"وَأَ<q>بْ</>صِرْهُمْ فَسَوْفَ يُ<q>بْ</>صِ<p>رُو</>نَ"},{"n":176,"w":[["أَفَبِعَذَابِنَا","afabi‘adhābinā","Then is (it) for Our punishment","আমাদের শাস্তি সম্পর্কে তবে কি"],["يَسْتَعْجِلُونَ","yasta‘jilūna","they hasten","তারা তাড়াহুড়া করছে"]],"t":"أَفَبِعَذَابِنَا يَسْتَعْجِ<p>لُو</>نَ"},{"n":177,"w":[["فَإِذَا","fa-idhā","But when","অতঃপর যখন"],["نَزَلَ","nazala","it descends","নেমে আসবে (তা)"],["بِسَاحَتِهِمْ","bisāḥatihim","in their territory","তাদের আঙ্গিনায়"],["فَسَآءَ","fasāa","then evil (will be)","কত মন্দ হবে তখন"],["صَبَاحُ","ṣabāḥu","(the) morning","প্রভাত"],["ٱلْمُنذَرِينَ","l-mundharīna","(for) those who were warned","সতর্কীকৃতদের"]],"t":"فَإِذَا نَزَلَ بِسَاحَتِهِمْ فَ<o>سَآ</>ءَ صَبَاحُ <h>ٱ</>لْمُ<k>نذَ</><p>رِي</>نَ"},{"n":178,"w":[["وَتَوَلَّ","watawalla","So turn away","উপেক্ষা করো এবং"],["عَنْهُمْ","‘anhum","from them","তাদেরকে"],["حَتَّىٰ","ḥattā","for","পর্যন্ত"],["حِينٍۢ","ḥīnin","a time","কিছুুকাল"]],"t":"وَتَوَلَّ عَنْهُمْ حَتَّىٰ <p>حِي</>نٍۢ"},{"n":179,"w":[["وَأَبْصِرْ","wa-abṣir","And see","আর দেখতে থাকো"],["فَسَوْفَ","fasawfa","so soon","শীঘ্র্রই"],["يُبْصِرُونَ","yub'ṣirūna","they will see","তারাও দেখতে পাবে"]],"t":"وَأَ<q>بْ</>صِرْ فَسَوْفَ يُ<q>بْ</>صِ<p>رُو</>نَ"},{"n":180,"w":[["سُبْحَـٰنَ","sub'ḥāna","Glory","পবিত্র"],["رَبِّكَ","rabbika","(be to) your Lord","তোমার রব"],["رَبِّ","rabbi","(the) Lord","রব"],["ٱلْعِزَّةِ","l-‘izati","(of) Honor","সম্মানের (মালিক)"],["عَمَّا","‘ammā","above what","তাহ'তে যা"],["يَصِفُونَ","yaṣifūna","they attribute","তারা আরোপ করে"]],"t":"سُ<q>بْ</><m>حَٰ</>نَ رَبِّكَ رَبِّ <h>ٱ</>لْعِزَّةِ عَ<g>مَّ</>ا يَصِ<p>فُو</>نَ"},{"n":181,"w":[["وَسَلَـٰمٌ","wasalāmun","And peace be","এবং শান্তি (বর্ষিত হোক)"],["عَلَى","‘alā","upon","উপর"],["ٱلْمُرْسَلِينَ","l-mur'salīna","the Messengers","রাসূলদের"]],"t":"وَسَ<m>لَٰ</>مٌ عَلَى <h>ٱ</>لْمُرْسَ<p>لِي</>نَ"},{"n":182,"w":[["وَٱلْحَمْدُ","wal-ḥamdu","And all praise","এবং সমস্ত প্রশংসা"],["لِلَّهِ","lillahi","(be) to Allah","আল্লাহরই"],["رَبِّ","rabbi","(the) Lord","(যিনি) রব"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","(of) the worlds","বিশ্বজগতের"]],"t":"وَ<h>ٱ</>لْحَمْدُ لِلَّهِ رَبِّ <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"}]}