{"n":37,"a":[{"n":1,"w":[["وَٱلصَّـٰٓفَّـٰتِ","wal-ṣāfāti","By those lined","শপথ সারি বেঁধে দাঁড়ায় যারা"],["صَفًّۭا","ṣaffan","(in) rows","সারি সারি"]],"t":"وَ<h>ٱ</><l>ل</><n>صَّٰٓ</><m>فَّٰ</>تِ صَفًّۭا"},{"n":2,"w":[["فَٱلزَّٰجِرَٰتِ","fal-zājirāti","And those who drive","অতঃপর (শপথ) ধমকদানকারীদের"],["زَجْرًۭا","zajran","strongly","সজোরে"]],"t":"فَ<h>ٱ</><l>ل</><m>زَّٰجِرَٰ</>تِ زَ<q>جْ</>رًۭا"},{"n":3,"w":[["فَٱلتَّـٰلِيَـٰتِ","fal-tāliyāti","And those who recite","অতঃপর (শপথ তাদের) পাঠকদের"],["ذِكْرًا","dhik'ran","(the) Message","উপদেশবাণী"]],"t":"فَ<h>ٱ</><l>ل</><m>تَّٰلِيَٰ</>تِ ذِكْرًا"},{"n":4,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["إِلَـٰهَكُمْ","ilāhakum","your Lord","তোমাদের ইলাহ"],["لَوَٰحِدٌۭ","lawāḥidun","(is) surely One","একজন অবশ্যই"]],"t":"إِ<g>نَّ</> إِ<m>لَٰ</>هَكُمْ لَ<m>وَٰ</>حِ<q>دٌۭ</>"},{"n":5,"w":[["رَّبُّ","rabbu","Lord","(তিনি) রব"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশের"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃৃথিবীর"],["وَمَا","wamā","and what","এবং যা কিছু (আছে)"],["بَيْنَهُمَا","baynahumā","(is) between both of them","তাদের উভয়ের মাঝে"],["وَرَبُّ","warabbu","and Lord","এবং রব"],["ٱلْمَشَـٰرِقِ","l-mashāriqi","(of) each point of sunrise","উদয়স্থলসমূহের"]],"t":"رَّبُّ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ <h>ٱ</>لْمَ<m>شَٰ</>رِ<q>قِ</>"},{"n":6,"w":[["إِنَّا","innā","Indeed, We","নিশ্চয়ই আমরা"],["زَيَّنَّا","zayyannā","[We] adorned","আমরা সৃুশোভিত করেছি"],["ٱلسَّمَآءَ","l-samāa","the sky","আকাশকে"],["ٱلدُّنْيَا","l-dun'yā","[the world]","কাছের"],["بِزِينَةٍ","bizīnatin","with an adornment","চাকচিক্য দ্বারা"],["ٱلْكَوَاكِبِ","l-kawākibi","(of) the stars","তারকাদের"]],"t":"إِ<g>نَّ</>ا زَيَّ<g>نَّ</>ا <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءَ <h>ٱ</><l>ل</>دُّنْيَا بِزِينَةٍ <h>ٱ</>لْكَوَاكِ<q>بِ</>"},{"n":7,"w":[["وَحِفْظًۭا","waḥif'ẓan","And (to) guard","এবং (তাকে) (আমরা করেছি) সংরক্ষণ"],["مِّن","min","against","হ'তে"],["كُلِّ","kulli","every","প্রত্যেক"],["شَيْطَـٰنٍۢ","shayṭānin","devil","শয়তানের"],["مَّارِدٍۢ","māridin","rebellious","(যারা) অবাধ্য"]],"t":"وَحِفْ<d>ظًۭا مِّ</><k>ن كُ</>لِّ شَيْ<m>طَٰ</><d>نٍۢ مَّ</>ارِ<q>دٍۢ</>"},{"n":8,"w":[["لَّا","lā","Not","না"],["يَسَّمَّعُونَ","yassamma‘ūna","they may listen","তারা শুনতে পায়"],["إِلَى","ilā","to","(কোন কথা) হ'তে"],["ٱلْمَلَإِ","l-mala-i","the assembly","জগৎ"],["ٱلْأَعْلَىٰ","l-a‘lā","[the] exalted","ওপরের"],["وَيُقْذَفُونَ","wayuq'dhafūna","are pelted","এবং নিক্ষেপ করা হয়"],["مِن","min","from","থেকে"],["كُلِّ","kulli","every","প্রত্যেক"],["جَانِبٍۢ","jānibin","side","দিক"]],"t":"لَّا يَسَّ<g>مَّ</>عُونَ إِلَى <h>ٱ</>لْمَلَإِ <h>ٱ</>لْأَعْلَىٰ وَيُ<q>قْ</>ذَفُونَ مِ<k>ن كُ</>لِّ جَانِ<q>بٍۢ</>"},{"n":9,"w":[["دُحُورًۭا ۖ","duḥūran","Repelled","তাড়ানোর (জন্যে)"],["وَلَهُمْ","walahum","and for them","এবং তাদের জন্যে রয়েছে"],["عَذَابٌۭ","‘adhābun","(is) a punishment","শাস্তি"],["وَاصِبٌ","wāṣibun","perpetual","অবিরাম"]],"t":"دُحُو<d>رًۭا ۖ وَ</>لَهُمْ عَذَا<d>بٌۭ وَ</>اصِ<q>بٌ</>"},{"n":10,"w":[["إِلَّا","illā","Except","তবে"],["مَنْ","man","(him) who","যে"],["خَطِفَ","khaṭifa","snatches","হঠাৎ করে (শুনে) নেয়"],["ٱلْخَطْفَةَ","l-khaṭfata","(by) theft","হঠাৎ নেওয়া"],["فَأَتْبَعَهُۥ","fa-atba‘ahu","but follows him","তাকে তখন অনুসরণ করে"],["شِهَابٌۭ","shihābun","a burning flame","উল্কা"],["ثَاقِبٌۭ","thāqibun","piercing","জ্বলন্ত"]],"t":"إِلَّا مَنْ خَطِفَ <h>ٱ</>لْخَ<q>طْ</>فَةَ فَأَتْبَعَهُ<m>ۥ</> شِهَا<k>بٌۭ ثَ</>اقِ<q>بٌۭ</>"},{"n":11,"w":[["فَٱسْتَفْتِهِمْ","fa-is'taftihim","Then ask them","তাদেরকে অতঃপর জিজ্ঞেস করো"],["أَهُمْ","ahum","Are they","\"তারা কি"],["أَشَدُّ","ashaddu","a stronger","বেশী কঠিন"],["خَلْقًا","khalqan","creation","সৃষ্টি হিসেবে"],["أَم","am","or","অথবা"],["مَّنْ","man","(those) whom","(অন্য) যা কিছু"],["خَلَقْنَآ ۚ","khalaqnā","We have created","আমরা সৃষ্টি করেছি\""],["إِنَّا","innā","Indeed, We","নিশ্চয়ই আমরা"],["خَلَقْنَـٰهُم","khalaqnāhum","created them","তাদেরকে আমরা সৃষ্টি করেছি"],["مِّن","min","from","থেকে"],["طِينٍۢ","ṭīnin","a clay","মাটি"],["لَّازِبٍۭ","lāzibin","sticky","(যা) এঁটেল"]],"t":"فَ<h>ٱ</>سْتَفْتِهِمْ أَهُمْ أَشَدُّ خَلْقًا <y>أَم مَّ</>نْ خَلَ<q>قْ</><o>نَآ ۚ</> إِ<g>نَّ</>ا خَلَ<q>قْ</><m>نَٰ</><y>هُم مِّ</><k>ن طِ</>ي<w>نٍۢ لَّ</>ازِ<q>بٍۭ</>"},{"n":12,"w":[["بَلْ","bal","Nay","বরং"],["عَجِبْتَ","‘ajib'ta","you wonder","তুমি অবাক হচ্ছো"],["وَيَسْخَرُونَ","wayaskharūna","while they mock","আর তারা বিদ্রূপ করছে"]],"t":"بَلْ عَجِ<q>بْ</>تَ وَيَسْخَ<p>رُو</>نَ"},{"n":13,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["ذُكِّرُوا۟","dhukkirū","they are reminded","তাদের উপদেশ দেয়া হয়"],["لَا","lā","not","না"],["يَذْكُرُونَ","yadhkurūna","they receive admonition","তারা উপদেশ গ্রহণ করে"]],"t":"وَإِذَا ذُكِّرُو<s>ا۟</> لَا يَذْكُ<p>رُو</>نَ"},{"n":14,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["رَأَوْا۟","ra-aw","they see","তারা দেখে"],["ءَايَةًۭ","āyatan","a Sign","কোনো নিদর্শন"],["يَسْتَسْخِرُونَ","yastaskhirūna","they mock","তারা উপহাস করে"]],"t":"وَإِذَا رَأَوْ<s>ا۟</> ءَايَ<d>ةًۭ يَ</>سْتَسْخِ<p>رُو</>نَ"},{"n":15,"w":[["وَقَالُوٓا۟","waqālū","And they say","এবং তারা বলে"],["إِنْ","in","Not","\"নয়"],["هَـٰذَآ","hādhā","(is) this","এটা"],["إِلَّا","illā","except","এ ব্যতীত"],["سِحْرٌۭ","siḥ'run","a magic","জাদু"],["مُّبِينٌ","mubīnun","clear","সুস্পষ্ট"]],"t":"وَقَا<o>لُوٓ</><s>ا۟</> إِنْ <m>هَٰ</><o>ذَآ</> إِلَّا سِحْ<d>رٌۭ مُّ</><p>بِي</>نٌ"},{"n":16,"w":[["أَءِذَا","a-idhā","Is it when","কি যখন"],["مِتْنَا","mit'nā","we are dead","আমরা মরে যাব"],["وَكُنَّا","wakunnā","and have become","এবং আমরা হয়ে যাব"],["تُرَابًۭا","turāban","dust","মাটি"],["وَعِظَـٰمًا","wa‘iẓāman","and bones","ও হাড়"],["أَءِنَّا","a-innā","shall we then","নিশ্চয়ই কি আমরা"],["لَمَبْعُوثُونَ","lamab‘ūthūna","be certainly resurrected","আমাদেরকে উঠানো হবে অবশ্যই"]],"t":"أَءِذَا مِتْنَا وَكُ<g>نَّ</>ا تُرَا<d>بًۭا وَ</>عِ<m>ظَٰ</>مًا أَءِ<g>نَّ</>ا لَمَ<q>بْ</>عُو<p>ثُو</>نَ"},{"n":17,"w":[["أَوَءَابَآؤُنَا","awaābāunā","Or our fathers","এবং কি (উঠানো হবে) আমাদের পিতৃপুরুষদেরকেও"],["ٱلْأَوَّلُونَ","l-awalūna","former","পূর্বকালের\""]],"t":"أَوَءَا<o>بَآ</>ؤُنَا <h>ٱ</>لْأَوَّ<p>لُو</>نَ"},{"n":18,"w":[["قُلْ","qul","Say","বলো"],["نَعَمْ","na‘am","Yes","\"হ্যাঁ"],["وَأَنتُمْ","wa-antum","and you","এবং তোমরা"],["دَٰخِرُونَ","dākhirūna","(will be) humiliated","অপমানিত হবে\""]],"t":"قُلْ نَعَمْ وَأَ<k>نتُ</>مْ <m>دَٰ</>خِ<p>رُو</>نَ"},{"n":19,"w":[["فَإِنَّمَا","fa-innamā","Then only","মূলতঃ"],["هِىَ","hiya","it","তা (হবে)"],["زَجْرَةٌۭ","zajratun","(will be) a cry","বিকট শব্দ কম্পন"],["وَٰحِدَةٌۭ","wāḥidatun","single","একটি (মাত্র)"],["فَإِذَا","fa-idhā","then, behold","অতঃপর তখন"],["هُمْ","hum","They","তারা"],["يَنظُرُونَ","yanẓurūna","will see","দেখবে"]],"t":"فَإِ<g>نَّ</>مَا هِىَ زَ<q>جْ</>رَ<d>ةٌۭ وَٰ</>حِدَ<k>ةٌۭ فَ</>إِذَا هُمْ يَ<k>نظُ</><p>رُو</>نَ"},{"n":20,"w":[["وَقَالُوا۟","waqālū","And they will say","এবং তারা বলবে"],["يَـٰوَيْلَنَا","yāwaylanā","O woe to us","\"আমাদের দুর্ভোগ হায়"],["هَـٰذَا","hādhā","This","এটাই"],["يَوْمُ","yawmu","(is the) Day","দিন"],["ٱلدِّينِ","l-dīni","(of) the Recompense","বিচারের\""]],"t":"وَقَالُو<s>ا۟</> <m>يَٰ</>وَيْلَنَا <m>هَٰ</>ذَا يَوْمُ <h>ٱ</><l>ل</><p>دِّي</>نِ"},{"n":21,"w":[["هَـٰذَا","hādhā","This","\"এটাই"],["يَوْمُ","yawmu","(is the) Day","দিন"],["ٱلْفَصْلِ","l-faṣli","(of) Judgment","মীমাংসার"],["ٱلَّذِى","alladhī","which","যা"],["كُنتُم","kuntum","you used to","তোমরা ছিলে"],["بِهِۦ","bihi","[of it]","তা সম্পর্কে"],["تُكَذِّبُونَ","tukadhibūna","deny","মিথ্যা বলতে\""]],"t":"<m>هَٰ</>ذَا يَوْمُ <h>ٱ</>لْفَصْلِ <h>ٱ</>لَّذِى كُ<k>نتُ</><f>م بِ</><m>هِۦ</> تُكَذِّ<p>بُو</>نَ"},{"n":22,"w":[["۞ ٱحْشُرُوا۟","uḥ'shurū","Gather","(বলা হবে) একত্র করে আনো"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["ظَلَمُوا۟","ẓalamū","wronged","সীমালঙ্ঘন করেছিলো"],["وَأَزْوَٰجَهُمْ","wa-azwājahum","and their kinds","এবং তাদের দোসরদেরকে"],["وَمَا","wamā","and what","এবং যাদের"],["كَانُوا۟","kānū","they used (to)","তারা"],["يَعْبُدُونَ","ya‘budūna","worship","উপাসনা করতো"]],"t":"۞ ٱحْشُرُو<s>ا۟</> <h>ٱ</>لَّذِينَ ظَلَمُو<s>ا۟</> وَأَزْ<m>وَٰ</>جَهُمْ وَمَا كَانُو<s>ا۟</> يَعْبُ<p>دُو</>نَ"},{"n":23,"w":[["مِن","min","Besides","মধ্য হতে"],["دُونِ","dūni","Besides","ছাড়া"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["فَٱهْدُوهُمْ","fa-ih'dūhum","then lead them","তাই তাদেরকে পরিচালিত করো"],["إِلَىٰ","ilā","to","দিকে"],["صِرَٰطِ","ṣirāṭi","(the) Path","পথের"],["ٱلْجَحِيمِ","l-jaḥīmi","(of) the Hellfire","জাহান্নামের"]],"t":"مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ فَ<h>ٱ</>هْدُوهُمْ إِلَىٰ صِ<m>رَٰ</>طِ <h>ٱ</>لْجَ<p>حِي</>مِ"},{"n":24,"w":[["وَقِفُوهُمْ ۖ","waqifūhum","And stop them","এবং থামাও তাদেরকে"],["إِنَّهُم","innahum","indeed, they","তারা নিশ্চয়ই"],["مَّسْـُٔولُونَ","masūlūna","(are) to be questioned","জিজ্ঞাসিত হবে\""]],"t":"وَقِفُوهُمْ ۖ إِ<g>نَّ</><y>هُم مَّ</>سْـُٔو<p>لُو</>نَ"},{"n":25,"w":[["مَا","mā","What","\"(বলা হবে) কি"],["لَكُمْ","lakum","(is) for you","তোমাদের হলো (যে)"],["لَا","lā","(Why) not","না"],["تَنَاصَرُونَ","tanāṣarūna","you help one another","তোমরা পরস্পরে সাহায্য করছো\""]],"t":"مَا لَكُمْ لَا تَنَاصَ<p>رُو</>نَ"},{"n":26,"w":[["بَلْ","bal","Nay","বরং"],["هُمُ","humu","they","তারা"],["ٱلْيَوْمَ","l-yawma","(on) that Day","আজ"],["مُسْتَسْلِمُونَ","mus'taslimūna","(will) surrender","আত্মসমর্পণকারী"]],"t":"بَلْ هُمُ <h>ٱ</>لْيَوْمَ مُسْتَسْلِ<p>مُو</>نَ"},{"n":27,"w":[["وَأَقْبَلَ","wa-aqbala","And will approach","এবং মুখোমুখী হবে"],["بَعْضُهُمْ","ba‘ḍuhum","some of them","তাদের একে"],["عَلَىٰ","‘alā","to","দিকে"],["بَعْضٍۢ","ba‘ḍin","others","অপরের"],["يَتَسَآءَلُونَ","yatasāalūna","questioning one another","তারা পরস্পরে জিজ্ঞাসাবাদ করবে"]],"t":"وَأَ<q>قْ</>بَلَ بَعْضُهُمْ عَلَىٰ بَعْ<d>ضٍۢ يَ</>تَ<o>سَآ</>ءَ<p>لُو</>نَ"},{"n":28,"w":[["قَالُوٓا۟","qālū","They will say","(অনুসারীরা) বলবে"],["إِنَّكُمْ","innakum","Indeed, you","\"তোমরা নিশ্চয়ই"],["كُنتُمْ","kuntum","[you] used (to)","আমাদের"],["تَأْتُونَنَا","tatūnanā","come (to) us","কাছে আসতে"],["عَنِ","‘ani","from","থেকে"],["ٱلْيَمِينِ","l-yamīni","the right","ডানদিক (অর্থাৎ শক্তি নিয়ে)\""]],"t":"قَا<o>لُوٓ</><s>ا۟</> إِ<g>نَّ</>كُمْ كُ<k>نتُ</>مْ تَأْتُونَنَا عَنِ <h>ٱ</>لْيَ<p>مِي</>نِ"},{"n":29,"w":[["قَالُوا۟","qālū","They will say","(নেতারা) বলবে"],["بَل","bal","Nay","\"বরং"],["لَّمْ","lam","not","না"],["تَكُونُوا۟","takūnū","you were","তোমরা ছিলে"],["مُؤْمِنِينَ","mu'minīna","believers","মু'মিন"]],"t":"قَالُو<s>ا۟</> بَل لَّمْ تَكُونُو<s>ا۟</> مُؤْمِ<p>نِي</>نَ"},{"n":30,"w":[["وَمَا","wamā","And not","এবং না"],["كَانَ","kāna","was","ছিলো"],["لَنَا","lanā","for us","আমাদের জন্যে"],["عَلَيْكُم","‘alaykum","over you","তোমাদের উপর"],["مِّن","min","any","কোনো"],["سُلْطَـٰنٍۭ ۖ","sul'ṭānin","authority","কর্তৃত্ব"],["بَلْ","bal","Nay","বরং"],["كُنتُمْ","kuntum","you were","তোমরা ছিলে"],["قَوْمًۭا","qawman","a people","সম্প্রদায়"],["طَـٰغِينَ","ṭāghīna","transgressing","অবাধ্য"]],"t":"وَمَا كَانَ لَنَا عَلَيْ<y>كُم مِّ</><k>ن سُ</>لْ<m>طَٰ</><i>نٍۭ ۖ بَ</>لْ كُ<k>نتُ</>مْ قَوْ<k>مًۭا طَٰ</><p>غِي</>نَ"},{"n":31,"w":[["فَحَقَّ","faḥaqqa","So has been proved true","সুতরাং সত্য হলো"],["عَلَيْنَا","‘alaynā","against us","আমাদের বিরুদ্ধে"],["قَوْلُ","qawlu","(the) Word","কথা"],["رَبِّنَآ ۖ","rabbinā","(of) our Lord","আমাদের রবের"],["إِنَّا","innā","indeed, we","নিশ্চয়ই আমরা"],["لَذَآئِقُونَ","ladhāiqūna","(will) certainly taste","অবশ্যই (শাস্তির) স্বাদ ভোগ করতে হবে"]],"t":"فَحَقَّ عَلَيْنَا قَوْلُ رَبِّ<o>نَآ ۖ</> إِ<g>نَّ</>ا لَ<o>ذَآ</>ئِ<p>قُو</>نَ"},{"n":32,"w":[["فَأَغْوَيْنَـٰكُمْ","fa-aghwaynākum","So we led you astray","কারণ তোমাদেরকে আমরা বিভ্রান্ত করেছিলাম"],["إِنَّا","innā","indeed, we","নিশ্চয়ই আমরা"],["كُنَّا","kunnā","were","ছিলাম"],["غَـٰوِينَ","ghāwīna","astray","বিভ্রান্ত\""]],"t":"فَأَغْوَيْ<m>نَٰ</>كُمْ إِ<g>نَّ</>ا كُ<g>نَّ</>ا <m>غَٰ</><p>وِي</>نَ"},{"n":33,"w":[["فَإِنَّهُمْ","fa-innahum","Then indeed, they","অতঃপর তারা নিশ্চয়ই"],["يَوْمَئِذٍۢ","yawma-idhin","that Day","সেদিন"],["فِى","fī","in","মধ্যে"],["ٱلْعَذَابِ","l-‘adhābi","the punishment","শাস্তির"],["مُشْتَرِكُونَ","mush'tarikūna","(will be) sharers","সম অংশীদার হবে"]],"t":"فَإِ<g>نَّ</>هُمْ يَوْمَئِ<k>ذٍۢ فِ</>ى <h>ٱ</>لْعَذَ