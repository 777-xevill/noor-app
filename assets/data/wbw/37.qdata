َ<o>ذَآ</>ئِقُو<s>ا۟</> <h>ٱ</>لْعَذَابِ <h>ٱ</>لْأَ<p>لِي</>مِ"},{"n":39,"w":[["وَمَا","wamā","And not","এবং না"],["تُجْزَوْنَ","tuj'zawna","you will be recompensed","প্রতিফল দেয়া হবে"],["إِلَّا","illā","except","এ ছাড়া"],["مَا","mā","what","যা"],["كُنتُمْ","kuntum","you used to","(তোমরা)"],["تَعْمَلُونَ","ta‘malūna","do","কাজ করতেছিলে"]],"t":"وَمَا تُ<q>جْ</>زَوْنَ إِلَّا مَا كُ<k>نتُ</>مْ تَعْمَ<p>لُو</>نَ"},{"n":40,"w":[["إِلَّا","illā","Except","তবে"],["عِبَادَ","‘ibāda","(the) slaves","দাসরা"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["ٱلْمُخْلَصِينَ","l-mukh'laṣīna","the chosen ones","(যারা ছিলো) নিষ্ঠাবান (রক্ষা পাবে)"]],"t":"إِلَّا عِبَادَ <h>ٱ</>للَّهِ <h>ٱ</>لْمُخْلَ<p>صِي</>نَ"},{"n":41,"w":[["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব লোক"],["لَهُمْ","lahum","for them","তাদের জন্যে আছে"],["رِزْقٌۭ","riz'qun","(will be) a provision","জীবিকা"],["مَّعْلُومٌۭ","ma‘lūmun","determined","নির্ধারিত"]],"t":"أُ<s>و۟</><o>لَٰٓ</>ئِكَ لَهُمْ رِزْ<d>قٌۭ مَّ</>عْ<p>لُو</>مٌۭ"},{"n":42,"w":[["فَوَٰكِهُ ۖ","fawākihu","Fruits","ফলমূলসমূহ"],["وَهُم","wahum","and they","এবং তারা (হবে)"],["مُّكْرَمُونَ","muk'ramūna","(will) be honored","সম্মানিত"]],"t":"فَ<m>وَٰ</>كِهُ ۖ وَ<y>هُم مُّ</>كْرَ<p>مُو</>نَ"},{"n":43,"w":[["فِى","fī","In","মধ্যে"],["جَنَّـٰتِ","jannāti","Gardens","জান্নাতের"],["ٱلنَّعِيمِ","l-na‘īmi","(of) Delight","সুখকর"]],"t":"فِى جَ<g>نَّٰ</>تِ <h>ٱ</><l>ل</><g>نَّ</><p>عِي</>مِ"},{"n":44,"w":[["عَلَىٰ","‘alā","On","উপর"],["سُرُرٍۢ","sururin","thrones","আসনসমূহের (সমাসীন হবে)"],["مُّتَقَـٰبِلِينَ","mutaqābilīna","facing each other","মুখোমুখী হয়ে"]],"t":"عَلَىٰ سُرُ<d>رٍۢ مُّ</>تَ<m>قَٰ</>بِ<p>لِي</>نَ"},{"n":45,"w":[["يُطَافُ","yuṭāfu","Will be circulated","ঘুরে ঘুরে পরিবেশন করা হবে"],["عَلَيْهِم","‘alayhim","among them","তাদের কাছে"],["بِكَأْسٍۢ","bikasin","a cup","পান পাত্রকে (যা ভরা হবে)"],["مِّن","min","from","থেকে"],["مَّعِينٍۭ","ma‘īnin","a flowing spring","বিশুদ্ধ পানীয় পূর্ণ"]],"t":"يُطَافُ عَلَيْ<f>هِم بِ</>كَأْ<d>سٍۢ مِّن مَّ</><p>عِي</>نٍۭ"},{"n":46,"w":[["بَيْضَآءَ","bayḍāa","White","শুভ্র উজ্জ্বল"],["لَذَّةٍۢ","ladhatin","delicious","সুস্বাদু সুপেয়"],["لِّلشَّـٰرِبِينَ","lilshāribīna","for the drinkers","পানকারীদের জন্যে"]],"t":"بَيْ<o>ضَآ</>ءَ لَذَّ<w>ةٍۢ لِّ</>ل<m>شَّٰ</>رِ<p>بِي</>نَ"},{"n":47,"w":[["لَا","lā","Not","না"],["فِيهَا","fīhā","in it","তার মধ্যে (থাকবে)"],["غَوْلٌۭ","ghawlun","(is) bad effect","কোনো মানসিক বিকৃতি"],["وَلَا","walā","and not","আর না"],["هُمْ","hum","they","তারা"],["عَنْهَا","‘anhā","from it","তা হ'তে"],["يُنزَفُونَ","yunzafūna","will be intoxicated","মাতাল হবে"]],"t":"لَا فِيهَا غَوْ<d>لٌۭ وَ</>لَا هُمْ عَنْهَا يُ<k>نزَ</><p>فُو</>نَ"},{"n":48,"w":[["وَعِندَهُمْ","wa‘indahum","And with them","এবং কাছে তাদের (এমন তরুণী থাকবে)"],["قَـٰصِرَٰتُ","qāṣirātu","(will be) companions of modest gaze","(যারা) নতকারিণী"],["ٱلطَّرْفِ","l-ṭarfi","(will be) companions of modest gaze","দৃষ্টি"],["عِينٌۭ","‘īnun","(having) beautiful eyes","আয়তলোচনা"]],"t":"وَعِ<k>ندَ</>هُمْ <m>قَٰصِرَٰ</>تُ <h>ٱ</><l>ل</>طَّرْفِ <p>عِي</>نٌۭ"},{"n":49,"w":[["كَأَنَّهُنَّ","ka-annahunna","As if they were","তারা যেন"],["بَيْضٌۭ","bayḍun","eggs","ডিম"],["مَّكْنُونٌۭ","maknūnun","well protected","সুরক্ষিত"]],"t":"كَأَ<g>نَّهُنَّ</> بَيْ<d>ضٌۭ مَّ</>كْ<p>نُو</>نٌۭ"},{"n":50,"w":[["فَأَقْبَلَ","fa-aqbala","And (will) approach","অতঃপর সামনা-সামনি হবে"],["بَعْضُهُمْ","ba‘ḍuhum","some of them","তাদের একে"],["عَلَىٰ","‘alā","to","দিকে"],["بَعْضٍۢ","ba‘ḍin","others","অপরের"],["يَتَسَآءَلُونَ","yatasāalūna","questioning one another","তারা জিজ্ঞাসাবাদ করবে"]],"t":"فَأَ<q>قْ</>بَلَ بَعْضُهُمْ عَلَىٰ بَعْ<d>ضٍۢ يَ</>تَ<o>سَآ</>ءَ<p>لُو</>نَ"},{"n":51,"w":[["قَالَ","qāla","Will say","বলবে,"],["قَآئِلٌۭ","qāilun","a speaker","এক বক্তা"],["مِّنْهُمْ","min'hum","among them","তাদের মধ্যে হ'তে"],["إِنِّى","innī","Indeed, I","\"নিশ্চয়ই আমার"],["كَانَ","kāna","had","ছিলো"],["لِى","lī","for me","আমার"],["قَرِينٌۭ","qarīnun","a companion","একজন সঙ্গী"]],"t":"قَالَ <o>قَآ</>ئِ<d>لٌۭ مِّ</>نْهُمْ إِ<g>نِّ</>ى كَانَ لِى قَ<p>رِي</>نٌۭ"},{"n":52,"w":[["يَقُولُ","yaqūlu","Who (would) say","সে বলতো"],["أَءِنَّكَ","a-innaka","Are you indeed","\"তুমি কি নিশ্চয়ই"],["لَمِنَ","lamina","surely of","অবশ্যই অন্তর্ভুক্ত"],["ٱلْمُصَدِّقِينَ","l-muṣadiqīna","those who believe","সত্যতা স্বীকারকারীদের"]],"t":"يَقُولُ أَءِ<g>نَّ</>كَ لَمِنَ <h>ٱ</>لْمُصَدِّ<p>قِي</>نَ"},{"n":53,"w":[["أَءِذَا","a-idhā","Is (it) when","কি যখন"],["مِتْنَا","mit'nā","we have died","আমরা মারা যাবো"],["وَكُنَّا","wakunnā","and become","এবং আমরা হবো"],["تُرَابًۭا","turāban","dust","মাটি"],["وَعِظَـٰمًا","wa‘iẓāman","and bones","ও হাড় (সর্বস্ব)"],["أَءِنَّا","a-innā","will we","আমরা কি নিশ্চয়ই"],["لَمَدِينُونَ","lamadīnūna","surely be brought to Judgment","প্রতিফলপ্রাপ্ত হবো অবশ্যই\""]],"t":"أَءِذَا مِتْنَا وَكُ<g>نَّ</>ا تُرَا<d>بًۭا وَ</>عِ<m>ظَٰ</>مًا أَءِ<g>نَّ</>ا لَمَدِي<p>نُو</>نَ"},{"n":54,"w":[["قَالَ","qāla","He (will) say","বলবে"],["هَلْ","hal","Will","\"কি"],["أَنتُم","antum","you","তোমরা"],["مُّطَّلِعُونَ","muṭṭali‘ūna","be looking","(সেসব লোকদেরকে) উঁকি মেরে দেখতে পাও\""]],"t":"قَالَ هَلْ أَ<k>نتُ</><y>م مُّ</>طَّلِ<p>عُو</>نَ"},{"n":55,"w":[["فَٱطَّلَعَ","fa-iṭṭala‘a","Then he (will) look","সে তখন উঁকি মেরে দেখবে"],["فَرَءَاهُ","faraāhu","and see him","তাকে ফলে দেখতে পাবে"],["فِى","fī","in","মধ্যে"],["سَوَآءِ","sawāi","(the) midst","মাঝখানে"],["ٱلْجَحِيمِ","l-jaḥīmi","(of) the Hellfire","জাহান্নামের"]],"t":"فَ<h>ٱ</>طَّلَعَ فَرَءَاهُ فِى سَ<o>وَآ</>ءِ <h>ٱ</>لْجَ<p>حِي</>مِ"},{"n":56,"w":[["قَالَ","qāla","He (will) say","সে বলবে"],["تَٱللَّهِ","tal-lahi","By Allah","\"আল্লাহর শপথ"],["إِن","in","verily","যে"],["كِدتَّ","kidtta","you almost","তুমি প্রায়"],["لَتُرْدِينِ","latur'dīni","ruined me","আমাকে ধ্বংস করেই ফেলেছিলে"]],"t":"قَالَ تَ<h>ٱ</>للَّهِ إِ<k>ن كِ</><j>د</>تَّ لَتُرْ<p>دِي</>نِ"},{"n":57,"w":[["وَلَوْلَا","walawlā","And if not","এবং যদি না"],["نِعْمَةُ","ni‘'matu","(for the) Grace","অনুগ্রহ (হতো)"],["رَبِّى","rabbī","(of) my Lord","আমার রবের"],["لَكُنتُ","lakuntu","certainly, I (would) have been","অবশ্যই আমি হতাম"],["مِنَ","mina","among","অন্তর্ভুক্ত"],["ٱلْمُحْضَرِينَ","l-muḥ'ḍarīna","those brought","(জাহান্নামে) উপস্থিত করা লোকদের"]],"t":"وَلَوْلَا نِعْمَةُ رَبِّى لَكُ<k>نتُ</> مِنَ <h>ٱ</>لْمُحْضَ<p>رِي</>نَ"},{"n":58,"w":[["أَفَمَا","afamā","Then are not","তবে কি না"],["نَحْنُ","naḥnu","we","আমরা"],["بِمَيِّتِينَ","bimayyitīna","(to) die","মৃত্যুবরণকারী হবো"]],"t":"أَفَمَا نَحْنُ بِمَيِّ<p>تِي</>نَ"},{"n":59,"w":[["إِلَّا","illā","Except","ব্যতীত"],["مَوْتَتَنَا","mawtatanā","our death","আমাদের মৃত্যু"],["ٱلْأُولَىٰ","l-ūlā","the first","প্রথম"],["وَمَا","wamā","and not","এবং না"],["نَحْنُ","naḥnu","we","আমরা"],["بِمُعَذَّبِينَ","bimu‘adhabīna","will be punished","শাস্তিপ্রাপ্ত হবো\""]],"t":"إِلَّا مَوْتَتَنَا <h>ٱ</>لْأُولَىٰ وَمَا نَحْنُ بِمُعَذَّ<p>بِي</>نَ"},{"n":60,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["هَـٰذَا","hādhā","this","এটা"],["لَهُوَ","lahuwa","surely","অবশ্যই সেই"],["ٱلْفَوْزُ","l-fawzu","(is) the attainment","সাফল্য"],["ٱلْعَظِيمُ","l-‘aẓīmu","great","মহা"]],"t":"إِ<g>نَّ</> <m>هَٰ</>ذَا لَهُوَ <h>ٱ</>لْفَوْزُ <h>ٱ</>لْعَ<p>ظِي</>مُ"},{"n":61,"w":[["لِمِثْلِ","limith'li","For (the) like","অনুরূপ (সাফল্যের) জন্যে"],["هَـٰذَا","hādhā","(of) this","এর"],["فَلْيَعْمَلِ","falya‘mali","let work","সাধনা করা উচিৎ"],["ٱلْعَـٰمِلُونَ","l-‘āmilūna","the workers","পরিশ্রমীদের"]],"t":"لِمِثْلِ <m>هَٰ</>ذَا فَلْيَعْمَلِ <h>ٱ</>لْ<m>عَٰ</>مِ<p>لُو</>نَ"},{"n":62,"w":[["أَذَٰلِكَ","adhālika","Is that","এটা কি"],["خَيْرٌۭ","khayrun","better","উত্তম"],["نُّزُلًا","nuzulan","(as) hospitality","আপ্যায়ন"],["أَمْ","am","or","না"],["شَجَرَةُ","shajaratu","(the) tree","গাছ"],["ٱلزَّقُّومِ","l-zaqūmi","(of) Zaqqum","যাক্কুমের"]],"t":"أَ<m>ذَٰ</>لِكَ خَيْ<d>رٌۭ نُّ</>زُلًا أَمْ شَجَرَةُ <h>ٱ</><l>ل</>زَّ<p>قُّو</>مِ"},{"n":63,"w":[["إِنَّا","innā","Indeed, We","নিশ্চয়ই আমরা"],["جَعَلْنَـٰهَا","ja‘alnāhā","[We] have made it","তা আমরা সৃষ্টি করেছি"],["فِتْنَةًۭ","fit'natan","a trial","পরীক্ষা স্বরূপ"],["لِّلظَّـٰلِمِينَ","lilẓẓālimīna","for the wrongdoers","সীমালঙ্ঘনকারী