{"n":112,"a":[{"n":1,"w":[["قُلْ","qul","Say","বলো"],["هُوَ","huwa","He","\"তিনি"],["ٱللَّهُ","l-lahu","(is) Allah","আল্লাহ"],["أَحَدٌ","aḥadun","the One","এক-অদ্বিতীয়"]],"t":"قُلْ هُوَ <h>ٱ</>للَّهُ أَحَ<q>دٌ</>"},{"n":2,"w":[["ٱللَّهُ","al-lahu","Allah","আল্লাহ"],["ٱلصَّمَدُ","l-ṣamadu","the Eternal, the Absolute","অমুখাপেক্ষী"]],"t":"ٱللَّهُ <h>ٱ</><l>ل</>صَّمَ<q>دُ</>"},{"n":3,"w":[["لَمْ","lam","Not","নি"],["يَلِدْ","yalid","He begets","তিনি (কাউকে) জন্ম দেন"],["وَلَمْ","walam","and not","এবং নি"],["يُولَدْ","yūlad","He is begotten","তাঁকে জন্ম দেয়া হয়"]],"t":"لَمْ يَلِ<q>دْ</> وَلَمْ يُولَ<q>دْ</>"},{"n":4,"w":[["وَلَمْ","walam","And not","এবং নাই"],["يَكُن","yakun","is","(হয়)"],["لَّهُۥ","lahu","for Him","তাঁর"],["كُفُوًا","kufuwan","equivalent","সমতুল্য/ সমান"],["أَحَدٌۢ","aḥadun","any [one]","কেউই\""]],"t":"وَلَمْ يَ<w>كُن لَّ</>هُ<m>ۥ</> كُفُوًا أَحَ<q>دٌۢ</>"}]}