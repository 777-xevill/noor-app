{"n":61,"a":[{"n":1,"w":[["سَبَّحَ","sabbaḥa","Glorifies","তসবীহ করে"],["لِلَّهِ","lillahi","Allah","আল্লাহর"],["مَا","mā","whatever","যা কিছু"],["فِى","fī","(is) in","মধ্যে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আসমানসমূহের"],["وَمَا","wamā","and whatever","ও যা"],["فِى","fī","(is) in","মধ্যে"],["ٱلْأَرْضِ ۖ","l-arḍi","the earth","পৃথিবীর"],["وَهُوَ","wahuwa","And He","এবং তিনিই"],["ٱلْعَزِيزُ","l-‘azīzu","(is) the All-Mighty","পরাক্রমশালী"],["ٱلْحَكِيمُ","l-ḥakīmu","the All-Wise","প্রজ্ঞাময়"]],"t":"سَبَّحَ لِلَّهِ مَا فِى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَمَا فِى <h>ٱ</>لْأَرْضِ ۖ وَهُوَ <h>ٱ</>لْعَزِيزُ <h>ٱ</>لْحَ<p>كِي</>مُ"},{"n":2,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O","ওহে"],["ٱلَّذِينَ","alladhīna","(you) who","যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছো"],["لِمَ","lima","Why","কেন"],["تَقُولُونَ","taqūlūna","(do) you say","তোমরা বলো"],["مَا","mā","what","যা"],["لَا","lā","not","না"],["تَفْعَلُونَ","taf‘alūna","you do","তোমরা করো"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> لِمَ تَقُولُونَ مَا لَا تَفْعَ<p>لُو</>نَ"},{"n":3,"w":[["كَبُرَ","kabura","Great is","অতিশয়"],["مَقْتًا","maqtan","hatred","ক্রোধজনক"],["عِندَ","‘inda","with","কাছে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["أَن","an","that","যে"],["تَقُولُوا۟","taqūlū","you say","তোমরা বলো"],["مَا","mā","what","যা"],["لَا","lā","not","না"],["تَفْعَلُونَ","taf‘alūna","you do","তোমরা করো"]],"t":"كَبُرَ مَ<q>قْ</>تًا عِ<k>ندَ</> <h>ٱ</>للَّهِ أَ<k>ن تَ</>قُولُو<s>ا۟</> مَا لَا تَفْعَ<p>لُو</>نَ"},{"n":4,"w":[["إِنَّ","inna","Indeed","নিশ্চয়"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يُحِبُّ","yuḥibbu","loves","পছন্দ করেন"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["يُقَـٰتِلُونَ","yuqātilūna","fight","লড়াই করে"],["فِى","fī","in","(পথে)"],["سَبِيلِهِۦ","sabīlihi","His Way","তাঁর পথে"],["صَفًّۭا","ṣaffan","(in) a row","সারিবদ্ধ হয়ে"],["كَأَنَّهُم","ka-annahum","as if they","তারা যেন"],["بُنْيَـٰنٌۭ","bun'yānun","(were) a structure","প্রাচীর"],["مَّرْصُوصٌۭ","marṣūṣun","joined firmly","সুদৃঢ়"]],"t":"إِ<g>نَّ</> <h>ٱ</>للَّهَ يُحِبُّ <h>ٱ</>لَّذِينَ يُ<m>قَٰ</>تِلُونَ فِى سَبِيلِ<m>هِۦ</> صَ<k>فًّۭا كَ</>أَ<g>نَّ</><f>هُم بُ</>نْ<m>يَٰ</><d>نٌۭ مَّ</>رْ<p>صُو</>صٌۭ"},{"n":5,"w":[["وَإِذْ","wa-idh","And when","এবং যখন"],["قَالَ","qāla","said","বলেছিল"],["مُوسَىٰ","mūsā","Musa","মূসা"],["لِقَوْمِهِۦ","liqawmihi","to his people","তার জাতিকে"],["يَـٰقَوْمِ","yāqawmi","O my people","\"হে আমার জাতি"],["لِمَ","lima","Why","কেন"],["تُؤْذُونَنِى","tu'dhūnanī","do you hurt me","তোমরা আমাকে কষ্ট দাও"],["وَقَد","waqad","while certainly","অথচ নিশ্চয়"],["تَّعْلَمُونَ","ta‘lamūna","you know","তোমরা জানো"],["أَنِّى","annī","that I am","যে আমি"],["رَسُولُ","rasūlu","(the) Messenger","রাসূল"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["إِلَيْكُمْ ۖ","ilaykum","to you","তোমাদের প্রতি\""],["فَلَمَّا","falammā","Then when","অতঃপর যখন"],["زَاغُوٓا۟","zāghū","they deviated","তারা বক্রতা অবলম্বন করল"],["أَزَاغَ","azāgha","(was caused to) deviate","বক্র করে দিলেন"],["ٱللَّهُ","l-lahu","(by) Allah","আল্লাহ"],["قُلُوبَهُمْ ۚ","qulūbahum","their hearts","তাদের অন্তরসমূহকে"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["لَا","lā","(does) not","না"],["يَهْدِى","yahdī","guide","পথ দেখান"],["ٱلْقَوْمَ","l-qawma","the people","জাতিকে"],["ٱلْفَـٰسِقِينَ","l-fāsiqīna","the defiantly disobedient","ফাসেক"]],"t":"وَإِذْ قَالَ مُوسَىٰ لِقَوْمِ<m>هِۦ يَٰ</>قَوْمِ لِمَ تُؤْذُونَنِى وَقَ<j>د</> تَّعْلَمُونَ أَ<g>نِّ</>ى رَسُولُ <h>ٱ</>للَّهِ إِلَيْكُمْ ۖ فَلَ<g>مَّ</>ا زَا<o>غُوٓ</><s>ا۟</> أَزَاغَ <h>ٱ</>للَّهُ قُلُوبَهُمْ ۚ وَ<h>ٱ</>للَّهُ لَا يَهْدِى <h>ٱ</>لْقَوْمَ <h>ٱ</>لْ<m>فَٰ</>سِ<p>قِي</>نَ"},{"n":6,"w":[["وَإِذْ","wa-idh","And when","এবং যখন"],["قَالَ","qāla","said","বলল"],["عِيسَى","‘īsā","Isa","ঈসা"],["ٱبْنُ","ub'nu","son","পুত্র"],["مَرْيَمَ","maryama","(of) Maryam","মারয়ামের"],["يَـٰبَنِىٓ","yābanī","O Children","\"হে বনী"],["إِسْرَٰٓءِيلَ","is'rāīla","(of) Israel","\"ইসরাইল"],["إِنِّى","innī","Indeed, I am","আমি নিশ্চয়"],["رَسُولُ","rasūlu","(the) Messenger","রাসূূল"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["إِلَيْكُم","ilaykum","to you","তোমাদের প্রতি"],["مُّصَدِّقًۭا","muṣaddiqan","confirming","সত্যায়নকারী"],["لِّمَا","limā","that which","যা জন্যে"],["بَيْنَ","bayna","(was) between","আমার পূর্বে (এসেছে)"],["يَدَىَّ","yadayya","my hands","আমার পূর্বে (এসেছে)"],["مِنَ","mina","of","মধ্য হতে"],["ٱلتَّوْرَىٰةِ","l-tawrāti","the Taurat","তাওরাত"],["وَمُبَشِّرًۢا","wamubashiran","and bringing glad tidings","এবং সুসংবাদদাতা"],["بِرَسُولٍۢ","birasūlin","(of) a Messenger","একজন রাসূলের"],["يَأْتِى","yatī","to come","আসবেন"],["مِنۢ","min","from","মধ্য হতে"],["بَعْدِى","ba‘dī","after me","আমার পরে"],["ٱسْمُهُۥٓ","us'muhu","whose name (will be)","তার নাম (হবে)"],["أَحْمَدُ ۖ","aḥmadu","Ahmad","আহ্‌মদ\""],["فَلَمَّا","falammā","But when","অতঃপর যখন"],["جَآءَهُم","jāahum","he came to them","তাদের তিনি (কাছে) আসলেন"],["بِٱلْبَيِّنَـٰتِ","bil-bayināti","with clear proofs","সুস্পষ্ট প্রমাণাদিসহ"],["قَالُوا۟","qālū","they said","তারা বলল"],["هَـٰذَا","hādhā","This","\"এটা"],["سِحْرٌۭ","siḥ'run","(is) a magic","জাদু"],["مُّبِينٌۭ","mubīnun","clear","প্রকাশ্য\""]],"t":"وَإِذْ قَالَ عِيسَى <h>ٱ</><q>بْ</>نُ مَرْيَمَ <m>يَٰ</>بَ<o>نِىٓ</> إِسْ<o>رَٰٓ</>ءِيلَ إِ<g>نِّ</>ى رَسُولُ <h>ٱ</>للَّهِ إِلَيْ<y>كُم مُّ</>صَدِّ<w>قًۭا لِّ</>مَا بَيْنَ يَدَىَّ مِنَ <h>ٱ</><l>ل</>تَّوْرَ<m>ىٰ</>ةِ وَمُبَشِّ<i>رًۢا بِ</>رَسُو<d>لٍۢ يَ</>أْتِى <i>مِنۢ بَ</>عْدِى <h>ٱ</>سْمُهُ<o>ۥٓ</> أَحْمَدُ ۖ فَلَ<g>مَّ</>ا <o>جَآ</>ءَ<f>هُم بِ</><h>ٱ</>لْبَيِّ<m>نَٰ</>تِ قَالُو<s>ا۟</> <m>هَٰ</>ذَا سِحْ<d>رٌۭ مُّ</><p>بِي</>نٌۭ"},{"n":7,"w":[["وَمَنْ","waman","And who","এবং কে"],["أَظْلَمُ","aẓlamu","(is) more wrong","অধিক যালেম"],["مِمَّنِ","mimmani","than (one) who","(তার) অপেক্ষা"],["ٱفْتَرَىٰ","if'tarā","invents","যে রচনা করে"],["عَلَى","‘alā","upon","উপর"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["ٱلْكَذِبَ","l-kadhiba","the lie","মিথ্যা"],["وَهُوَ","wahuwa","while he","অথচ তাকে"],["يُدْعَىٰٓ","yud'‘ā","is invited","আহ্বান করা হয়"],["إِلَى","ilā","to","দিকে"],["ٱلْإِسْلَـٰمِ ۚ","l-is'lāmi","Islam","ইসলামের"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["لَا","lā","(does) not","না"],["يَهْدِى","yahdī","guide","পথ দেখান"],["ٱلْقَوْمَ","l-qawma","the people","লোকদের"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","[the] wrongdoers","যালেম"]],"t":"وَمَنْ أَظْلَمُ مِ<g>مَّ</>نِ <h>ٱ</>فْتَرَىٰ عَلَى <h>ٱ</>للَّهِ <h>ٱ</>لْكَذِبَ وَهُوَ يُ<q>دْ</>عَ<o>ىٰٓ</> إِلَى <h>ٱ</>لْإِسْ<m>لَٰ</>مِ ۚ وَ<h>ٱ</>للَّهُ لَا يَهْدِى <h>ٱ</>لْقَوْمَ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":8,"w":[["يُرِيدُونَ","yurīdūna","They intend","তারা চায়"],["لِيُطْفِـُٔوا۟","liyuṭ'fiū","to put out","নিভিয়ে দিতে"],["نُورَ","nūra","(the) light","নূর"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["بِأَفْوَٰهِهِمْ","bi-afwāhihim","with their mouths","তাদের মুখের (ফুঁৎকার) দিয়ে"],["وَٱللَّهُ","wal-lahu","but Allah","এবং আল্লাহ"],["مُتِمُّ","mutimmu","will perfect","সম্পূর্নকারী"],["نُورِهِۦ","nūrihi","His Light","তাঁর নূর"],["وَلَوْ","walaw","although","এবং যদিও"],["كَرِهَ","kariha","dislike","অপছন্দ করে"],["ٱلْكَـٰفِرُونَ","l-kāfirūna","the disbelievers","কাফিররা"]],"t":"يُرِيدُونَ لِيُ<q>طْ</>فِـُٔو<s>ا۟</> نُورَ <h>ٱ</>للَّهِ بِأَفْ<m>وَٰ</>هِهِمْ وَ<h>ٱ</>للَّهُ مُتِ<g>مُّ</> نُورِ<m>هِۦ</> وَلَوْ كَرِهَ <h>ٱ</>لْ<m>كَٰ</>فِ<p>رُو</>نَ"},{"n":9,"w":[["هُوَ","huwa","He","তিনিই"],["ٱلَّذِىٓ","alladhī","(is) the One Who","যিনি"],["أَرْسَلَ","arsala","sent","পাঠিয়েছেন"],["رَسُولَهُۥ","rasūlahu","His Messenger","তাঁর রাসূলকে"],["بِٱلْهُدَىٰ","bil-hudā","with guidance","হেদায়াতসহ"],["وَدِينِ","wadīni","and (the) religion","ও দ্বীন"],["ٱلْحَقِّ","l-ḥaqi","(of) the truth","সত্য"],["لِيُظْهِرَهُۥ","liyuẓ'hirahu","to make it prevail","তা বিজয়ী করে যেন"],["عَلَى","‘alā","over","উপর"],["ٱلدِّينِ","l-dīni","the religion","দ্বীনের"],["كُلِّهِۦ","kullihi","all of them","সর্বপ্রকারের"],["وَلَوْ","walaw","although","এবং যদিও"],["كَرِهَ","kariha","dislike (it)","অপছন্দ করে"],["ٱلْمُشْرِكُونَ","l-mush'rikūna","the polytheists","মুশরিকরা"]],"t":"هُوَ <h>ٱ</>لَّ<o>ذِىٓ</> أَرْسَلَ رَسُولَهُ<m>ۥ</> بِ<h>ٱ</>لْهُدَىٰ وَدِينِ <h>ٱ</>لْحَقِّ لِيُظْهِرَهُ<m>ۥ</> عَلَى <h>ٱ</><l>ل</>دِّينِ كُلِّ<m>هِۦ</> وَلَوْ كَرِهَ <h>ٱ</>لْمُشْرِ<p>كُو</>نَ"},{"n":10,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O","ওহে"],["ٱلَّذِينَ","alladhīna","(you) who","যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছো"],["هَلْ","hal","Shall","কি"],["أَدُلُّكُمْ","adullukum","I guide you","আমি তোমাদের সন্ধান দিবো"],["عَلَىٰ","‘alā","to","সম্বন্ধে"],["تِجَـٰرَةٍۢ","tijāratin","a transaction","ব্যবসা (যা)"],["تُنجِيكُم","tunjīkum","(that) will save you","তোমাদের মুক্তি দিবে"],["مِّنْ","min","from","থেকে"],["عَذَابٍ","‘adhābin","a punishment","আযাব"],["أَلِيمٍۢ","alīmin","painful","কষ্টদায়ক"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> هَلْ أَدُلُّكُمْ عَلَىٰ تِ<m>جَٰ</>رَ<k>ةٍۢ تُنجِ</>ي<y>كُم مِّ</>نْ عَذَابٍ أَ<p>لِي</>مٍۢ"},{"n":11,"w":[["تُؤْمِنُونَ","tu'minūna","Believe","তোমরা ঈমান আনো"],["بِٱللَّهِ","bil-lahi","in Allah","আল্লাহর উপর"],["وَرَسُولِهِۦ","warasūlihi","and His Messenger","ও তাঁর রাসূলের"],["وَتُجَـٰهِدُونَ","watujāhidūna","and strive","এবং তোমরা জিহাদ করো"],["فِى","fī","in","(মধ্যে)"],["سَبِيلِ","sabīli","(the) way","পথে"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["بِأَمْوَٰلِكُمْ","bi-amwālikum","with your wealth","তোমাদের মালসমূহ দিয়ে"],["وَأَنفُسِكُمْ ۚ","wa-anfusikum","and your lives","ও তোমাদের জানপ্রাণ (দিয়ে)"],["ذَٰلِكُمْ","dhālikum","That","এটাই"],["خَيْرٌۭ","khayrun","(is) better","উত্তম"],["لَّكُمْ","lakum","for you","তোমাদের জন্যে"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you","তোমরা"],["تَعْلَمُونَ","ta‘lamūna","know","জানো"]],"t":"تُؤْمِنُونَ بِ<h>ٱ</>للَّهِ وَرَسُولِ<m>هِۦ</> وَتُ<m>جَٰ</>هِدُونَ فِى سَبِيلِ <h>ٱ</>للَّهِ بِأَمْ<m>وَٰ</>لِكُمْ وَأَ<k>نفُ</>سِكُمْ ۚ <m>ذَٰ</>لِكُمْ خَيْ<w>رٌۭ لَّ</>كُمْ إِ<k>ن كُنتُ</>مْ تَعْلَ<p>مُو</>نَ"},{"n":12,"w":[["يَغْفِرْ","yaghfir","He will forgive","তিনি মাফ করবেন"],["لَكُمْ","lakum","for you","তোমাদের"],["ذُنُوبَكُمْ","dhunūbakum","your sins","তোমাদের গুনাহসমূহকে"],["وَيُدْخِلْكُمْ","wayud'khil'kum","and admit you","ও তোমাদের প্রবেশ করাবেন"],["جَنَّـٰتٍۢ","jannātin","(in) Gardens","জান্নাতে"],["تَجْرِى","tajrī","flow","প্রবাহিত হয়"],["مِن","min","from","মধ্য হতে"],["تَحْتِهَا","taḥtihā","underneath it","তার পাদদেশে"],["ٱلْأَنْهَـٰرُ","l-anhāru","the rivers","ঝর্ণাধারাসমূহ"],["وَمَسَـٰكِنَ","wamasākina","and dwellings","এবং বাসগৃহসমূহ"],["طَيِّبَةًۭ","ṭayyibatan","pleasant","উত্তম"],["فِى","fī","in","মধ্যে"],["جَنَّـٰتِ","jannāti","Gardens","জান্নাতের"],["عَدْنٍۢ ۚ","‘adnin","(of) Eternity","চিরস্থায়ী"],["ذَٰلِكَ","dhālika","That","এটা"],["ٱلْفَوْزُ","l-fawzu","(is) the success","সাফল্য"],["ٱلْعَظِيمُ","l-‘aẓīmu","the great","মহা"]],"t":"يَغْفِرْ لَكُمْ ذُنُوبَكُمْ وَيُ<q>دْ</>خِلْكُمْ جَ<g>نَّٰ</><k>تٍۢ تَ</><q>جْ</>رِى مِ<k>ن تَ</>حْتِهَا <h>ٱ</>لْأَنْ<m>هَٰ</>رُ وَمَ<m>سَٰ</>كِنَ طَيِّبَ<k>ةًۭ فِ</>ى جَ<g>نَّٰ</>تِ عَ<q>دْ</><k>نٍۢ ۚ ذَٰ</>لِكَ <h>ٱ</>لْفَوْزُ <h>ٱ</>لْعَ<p>ظِي</>مُ"},{"n":13,"w":[["وَأُخْرَىٰ","wa-ukh'rā","And another","এবং অন্যটি"],["تُحِبُّونَهَا ۖ","tuḥibbūnahā","that you love ","যা তোমরা পছন্দ করো"],["نَصْرٌۭ","naṣrun","a help","সাহায্য"],["مِّنَ","mina","from","থেকে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["وَفَتْحٌۭ","wafatḥun","and a victory","ও বিজয়"],["قَرِيبٌۭ ۗ","qarībun","near","আসন্ন"],["وَبَشِّرِ","wabashiri","and give glad tidings","এবং সুসংবাদ দাও"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","(to) the believers","মু'মিনদের"]],"t":"وَأُخْرَىٰ تُحِبُّونَهَا ۖ نَصْ<d>رٌۭ مِّ</>نَ <h>ٱ</>للَّهِ وَفَتْ<k>حٌۭ قَ</>رِي<d>بٌۭ ۗ وَ</>بَشِّرِ <h>ٱ</>لْمُؤْمِ<p>نِي</>نَ"},{"n":14,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you","ওহে"],["ٱلَّذِينَ","alladhīna","who","যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছো"],["كُونُوٓا۟","kūnū","Be","তোমরা হও"],["أَنصَارَ","anṣāra","helpers","সাহায্যকারী"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["كَمَا","kamā","as","যেমন"],["قَالَ","qāla","said","বলেছিল"],["عِيسَى","‘īsā","Isa","ঈসা"],["ٱبْنُ","ub'nu","son","তনয়"],["مَرْيَمَ","maryama","(of) Maryam","মারয়ামের"],["لِلْحَوَارِيِّـۧنَ","lil'ḥawāriyyīna","to the disciples","হাওয়ারীদেরকে"],["مَنْ","man","Who","\"কে"],["أَنصَارِىٓ","anṣārī","(are) my helpers","আমার সাহায্যকারী"],["إِلَى","ilā","for","দিকে"],["ٱللَّهِ ۖ","l-lahi","Allah","আল্লাহর\""],["قَالَ","qāla","Said","বলেছিল"],["ٱلْحَوَارِيُّونَ","l-ḥawāriyūna","the disciples","হাওয়ারীরা"],["نَحْنُ","naḥnu","We","\"আমরা"],["أَنصَارُ","anṣāru","(are) the helpers","সাহায্যকারী"],["ٱللَّهِ ۖ","l-lahi","(of) Allah","আল্লাহর\""],["فَـَٔامَنَت","faāmanat","Then believed","অতঃপর ঈমান আনল"],["طَّآئِفَةٌۭ","ṭāifatun","a group","এক দল"],["مِّنۢ","min","of","মধ্যে"],["بَنِىٓ","banī","Children","বনী"],["إِسْرَٰٓءِيلَ","is'rāīla","(of) Israel","ইসরাইল"],["وَكَفَرَت","wakafarat","and disbelieved","এবং কুফরি করল"],["طَّآئِفَةٌۭ ۖ","ṭāifatun","a group","এক দল"],["فَأَيَّدْنَا","fa-ayyadnā","So We supported","অতঃপর আমরা সাহায্য করলাম"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["ءَامَنُوا۟","āmanū","believed","ঈমান এনেছিল"],["عَلَىٰ","‘alā","against","উপর"],["عَدُوِّهِمْ","‘aduwwihim","their enemy","তাদের দুশমনের"],["فَأَصْبَحُوا۟","fa-aṣbaḥū","and they became","অতঃপর তারা হলো"],["ظَـٰهِرِينَ","ẓāhirīna","dominant","বিজয়ী"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> كُو<o>نُوٓ</><s>ا۟</> أَ<k>نصَ</>ارَ <h>ٱ</>للَّهِ كَمَا قَالَ عِيسَى <h>ٱ</><q>بْ</>نُ مَرْيَمَ لِلْحَوَارِيِّۦنَ مَنْ أَ<k>نصَ</>ا<o>رِىٓ</> إِلَى <h>ٱ</>للَّهِ ۖ قَالَ <h>ٱ</>لْحَوَارِيُّونَ نَحْنُ أَ<k>نصَ</>ارُ <h>ٱ</>للَّهِ ۖ فَـَٔامَنَ<j>ت</> <o>طَّآ</>ئِفَ<d>ةٌۭ مِّ</><i>نۢ بَ</><o>نِىٓ</> إِسْ<o>رَٰٓ</>ءِيلَ وَكَفَرَ<j>ت</> <o>طَّآ</>ئِفَ<k>ةٌۭ ۖ فَ</>أَيَّ<q>دْ</>نَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> عَلَىٰ عَدُوِّهِمْ فَأَصْبَحُو<s>ا۟</> <m>ظَٰ</>هِ<p>رِي</>نَ"}]}