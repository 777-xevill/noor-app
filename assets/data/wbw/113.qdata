{"n":113,"a":[{"n":1,"w":[["قُلْ","qul","Say","বলো"],["أَعُوذُ","a‘ūdhu","I seek refuge","\"আমি আশ্রয় চাই"],["بِرَبِّ","birabbi","in (the) Lord","স্রষ্টার নিকট"],["ٱلْفَلَقِ","l-falaqi","(of) the dawn","প্রভাতের"]],"t":"قُلْ أَعُوذُ بِرَبِّ <h>ٱ</>لْفَلَ<q>قِ</>"},{"n":2,"w":[["مِن","min","From","হতে"],["شَرِّ","sharri","(the) evil","অনিষ্ট"],["مَا","mā","(of) what","যা"],["خَلَقَ","khalaqa","He created","তিনি সৃষ্টি করেছেন"]],"t":"مِ<k>ن شَ</>رِّ مَا خَلَ<q>قَ</>"},{"n":3,"w":[["وَمِن","wamin","And from","এবং হতে"],["شَرِّ","sharri","(the) evil","অনিষ্ট"],["غَاسِقٍ","ghāsiqin","(of) darkness","রাতের অন্ধকারের"],["إِذَا","idhā","when","যখন"],["وَقَبَ","waqaba","it spreads","তা গভীর হয়"]],"t":"وَمِ<k>ن شَ</>رِّ غَاسِقٍ إِذَا وَقَ<q>بَ</>"},{"n":4,"w":[["وَمِن","wamin","And from","এবং হতে"],["شَرِّ","sharri","(the) evil","অনিষ্ট"],["ٱلنَّفَّـٰثَـٰتِ","l-nafāthāti","(of) the blowers","ফুঁকদানকারীর (রাতের) অনিষ্ট"],["فِى","fī","in","মধ্যে"],["ٱلْعُقَدِ","l-‘uqadi","the knots","গিঁটগুলোর"]],"t":"وَمِ<k>ن شَ</>رِّ <h>ٱ</><l>ل</><g>نَّ</><m>فَّٰثَٰ</>تِ فِى <h>ٱ</>لْعُقَ<q>دِ</>"},{"n":5,"w":[["وَمِن","wamin","And from","এবং হতে"],["شَرِّ","sharri","(the) evil","অনিষ্ট"],["حَاسِدٍ","ḥāsidin","(of) an envier","হিংসুকের"],["إِذَا","idhā","when","যখন"],["حَسَدَ","ḥasada","he envies","সে হিংসা করে\""]],"t":"وَمِ<k>ن شَ</>رِّ حَاسِدٍ إِذَا حَسَ<q>دَ</>"}]}