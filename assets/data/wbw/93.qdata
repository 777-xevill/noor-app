{"n":93,"a":[{"n":1,"w":[["وَٱلضُّحَىٰ","wal-ḍuḥā","By the morning brightness","শপথ প্রথম প্রহরের"]],"t":"وَ<h>ٱ</><l>ل</>ضُّحَىٰ"},{"n":2,"w":[["وَٱلَّيْلِ","wa-al-layli","And the night","শপথ রাতের"],["إِذَا","idhā","when","যখন"],["سَجَىٰ","sajā","it covers with darkness","নিঝুম হয়"]],"t":"وَ<h>ٱ</>لَّيْلِ إِذَا سَجَىٰ"},{"n":3,"w":[["مَا","mā","Not","না"],["وَدَّعَكَ","wadda‘aka","has forsaken you","তোমাকে ত্যাগ করেছেন"],["رَبُّكَ","rabbuka","your Lord","তোমার রব"],["وَمَا","wamā","and not","আর না"],["قَلَىٰ","qalā","He is displeased","অসন্তুষ্ট হয়েছেন"]],"t":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ"},{"n":4,"w":[["وَلَلْـَٔاخِرَةُ","walalākhiratu","And surely the Hereafter","এবং পরবর্তী (পরকাল) নিশ্চয়ই"],["خَيْرٌۭ","khayrun","(is) better","উত্তম"],["لَّكَ","laka","for you","তোমার জন্য"],["مِنَ","mina","than","অপেক্ষা (সময়)"],["ٱلْأُولَىٰ","l-ūlā","the first","পূর্ববর্তী (ইহকাল)"]],"t":"وَلَلْءَاخِرَةُ خَيْ<w>رٌۭ لَّ</>كَ مِنَ <h>ٱ</>لْأُولَىٰ"},{"n":5,"w":[["وَلَسَوْفَ","walasawfa","And soon","এবং শীঘ্রই অবশ্য"],["يُعْطِيكَ","yu‘'ṭīka","will give you","তোমাকে দান করবেন"],["رَبُّكَ","rabbuka","your Lord","তোমার রব"],["فَتَرْضَىٰٓ","fatarḍā","then you will be satisfied","ফলে তুমি খুশী হবে"]],"t":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ"},{"n":6,"w":[["أَلَمْ","alam","Did not","পান নি কি"],["يَجِدْكَ","yajid'ka","He find you","তিনি তোমাকে"],["يَتِيمًۭا","yatīman","an orphan","ইয়াতীমরূপে"],["فَـَٔاوَىٰ","faāwā","and give shelter","অতঃপর আশ্রয় দিয়েছেন"]],"t":"أَلَمْ يَجِ<q>دْ</>كَ يَتِي<k>مًۭا فَـَٔ</>اوَىٰ"},{"n":7,"w":[["وَوَجَدَكَ","wawajadaka","And He found you","এবং  তিনি তোমাকে পেয়েছিলেন"],["ضَآلًّۭا","ḍāllan","lost","পথ অনবহিত (রূপে)"],["فَهَدَىٰ","fahadā","so He guided","অতঃপর তিনি পথের দিশা দেন"]],"t":"وَوَجَدَكَ ضَآ<k>لًّۭا فَ</>هَدَىٰ"},{"n":8,"w":[["وَوَجَدَكَ","wawajadaka","And He found you","এবং তোমাকে পেয়েছিলেন"],["عَآئِلًۭا","‘āilan","in need","অভাবী"],["فَأَغْنَىٰ","fa-aghnā","so He made self-sufficient","অতঃপর অভাবমুক্ত করলেন"]],"t":"وَوَجَدَكَ <o>عَآ</>ئِلًۭ<k>ا فَ</>أَغْنَىٰ"},{"n":9,"w":[["فَأَمَّا","fa-ammā","So as for","সুতরাং ক্ষেত্রে"],["ٱلْيَتِيمَ","l-yatīma","the orphan","ইয়াতীমের"],["فَلَا","falā","then (do) not","তাই না"],["تَقْهَرْ","taqhar","oppress","কঠোর হয়ো"]],"t":"فَأَ<g>مَّ</>ا <h>ٱ</>لْيَتِيمَ فَلَا تَ<q>قْ</>هَرْ"},{"n":10,"w":[["وَأَمَّا","wa-ammā","And as for","আর ক্ষেত্রে"],["ٱلسَّآئِلَ","l-sāila","one who asks","প্রার্থীর"],["فَلَا","falā","then (do) not","তাই না"],["تَنْهَرْ","tanhar","repel","তিরস্কার করো"]],"t":"وَأَ<g>مَّ</>ا <h>ٱ</><l>ل</><o>سَّآ</>ئِلَ فَلَا تَنْهَرْ"},{"n":11,"w":[["وَأَمَّا","wa-ammā","But as for","আর প্রসঙ্গ"],["بِنِعْمَةِ","bini‘'mati","(the) Favor","অনুগ্রহের"],["رَبِّكَ","rabbika","(of) your Lord","তোমার রবের"],["فَحَدِّثْ","faḥaddith","narrate","অতঃপর বর্ণনা করো"]],"t":"وَأَ<g>مَّ</>ا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ"}]}