{"n":78,"a":[{"n":1,"w":[["عَمَّ","‘amma","About what","কি সম্পর্কে"],["يَتَسَآءَلُونَ","yatasāalūna","are they asking one another","তারা পরস্পরকে জিজ্ঞাসা করছে"]],"t":"عَ<g>مَّ</> يَتَ<o>سَآ</>ءَ<p>لُو</>نَ"},{"n":2,"w":[["عَنِ","‘ani","About","সম্পর্কে"],["ٱلنَّبَإِ","l-naba-i","the News","সংবাদ"],["ٱلْعَظِيمِ","l-‘aẓīmi","the Great","মহা (অর্থাৎ কিয়ামত)"]],"t":"عَنِ <h>ٱ</><l>ل</><g>نَّ</>بَإِ <h>ٱ</>لْعَ<p>ظِي</>مِ"},{"n":3,"w":[["ٱلَّذِى","alladhī","(About) which","তা (এমন যে)"],["هُمْ","hum","they","তারা"],["فِيهِ","fīhi","(are) concerning it","সে বিষয়ে"],["مُخْتَلِفُونَ","mukh'talifūna","(in) disagreement","(নিজেরাই) মতানৈক্যকারী"]],"t":"ٱلَّذِى هُمْ فِيهِ مُخْتَلِ<p>فُو</>نَ"},{"n":4,"w":[["كَلَّا","kallā","Nay","কখনও না"],["سَيَعْلَمُونَ","saya‘lamūna","(soon) they will know","তারা শীঘ্র জানবে"]],"t":"كَلَّا سَيَعْلَ<p>مُو</>نَ"},{"n":5,"w":[["ثُمَّ","thumma","Then","আবার (বলি)"],["كَلَّا","kallā","Nay","কখনও না"],["سَيَعْلَمُونَ","saya‘lamūna","(soon) they will know","তারা শীঘ্র জানবে"]],"t":"ثُ<g>مَّ</> كَلَّا سَيَعْلَ<p>مُو</>نَ"},{"n":6,"w":[["أَلَمْ","alam","Have not","নি কি"],["نَجْعَلِ","naj‘ali","We made","আমরা বানাই"],["ٱلْأَرْضَ","l-arḍa","the earth","ভূমিকে"],["مِهَـٰدًۭا","mihādan","a resting place","বিছানা স্বরূপ"]],"t":"أَلَمْ نَ<q>جْ</>عَلِ <h>ٱ</>لْأَرْضَ مِ<m>هَٰ</>دًۭا"},{"n":7,"w":[["وَٱلْجِبَالَ","wal-jibāla","And the mountains","এবং পাহাড়-পর্বতকে"],["أَوْتَادًۭا","awtādan","(as) pegs","কীলক স্বরূপ"]],"t":"وَ<h>ٱ</>لْجِبَالَ أَوْتَادًۭا"},{"n":8,"w":[["وَخَلَقْنَـٰكُمْ","wakhalaqnākum","And We created you","এবং তোমাদেরকে  আমরা সৃষ্টি করেছি"],["أَزْوَٰجًۭا","azwājan","(in) pairs","জোড়ায় জোড়ায়"]],"t":"وَخَلَ<q>قْ</><m>نَٰ</>كُمْ أَزْ<m>وَٰ</>جًۭا"},{"n":9,"w":[["وَجَعَلْنَا","waja‘alnā","And We made","এবং আমরা বানিয়েছি"],["نَوْمَكُمْ","nawmakum","your sleep","তোমাদের ঘুমকে"],["سُبَاتًۭا","subātan","(for) rest","বিশ্রাম (শান্তির বাহন)"]],"t":"وَجَعَلْنَا نَوْمَكُمْ سُبَاتًۭا"},{"n":10,"w":[["وَجَعَلْنَا","waja‘alnā","And We made","এবং আমরা বানিয়েছি"],["ٱلَّيْلَ","al-layla","the night","রাতকে"],["لِبَاسًۭا","libāsan","(as) covering","আবরণ স্বরূপ"]],"t":"وَجَعَلْنَا <h>ٱ</>لَّيْلَ لِبَاسًۭا"},{"n":11,"w":[["وَجَعَلْنَا","waja‘alnā","And We made","এবং আমরা বানিয়েছি"],["ٱلنَّهَارَ","l-nahāra","the day","দিনকে"],["مَعَاشًۭا","ma‘āshan","(for) livelihood","জীবিকা অর্জনের সময়"]],"t":"وَجَعَلْنَا <h>ٱ</><l>ل</><g>نَّ</>هَارَ مَعَاشًۭا"},{"n":12,"w":[["وَبَنَيْنَا","wabanaynā","And We constructed","এবং আমরা নির্মাণ করেছি"],["فَوْقَكُمْ","fawqakum","over you","তোমাদের উপর"],["سَبْعًۭا","sab‘an","seven","সাত"],["شِدَادًۭا","shidādan","strong","সুদৃঢ় (আকাশ)"]],"t":"وَبَنَيْنَا فَوْقَكُمْ سَ<q>بْ</><k>عًۭا شِ</>دَادًۭا"},{"n":13,"w":[["وَجَعَلْنَا","waja‘alnā","And We placed","এবং আমরা বানিয়েছি"],["سِرَاجًۭا","sirājan","a lamp","প্রদীপ (সূর্য)"],["وَهَّاجًۭا","wahhājan","burning","উজ্জ্বল"]],"t":"وَجَعَلْنَا سِرَا<d>جًۭا وَ</>هَّاجًۭا"},{"n":14,"w":[["وَأَنزَلْنَا","wa-anzalnā","And We sent down","আমরা বর্ষণ করেছি"],["مِنَ","mina","from","হতে"],["ٱلْمُعْصِرَٰتِ","l-mu‘'ṣirāti","the rain clouds","মেঘমালা"],["مَآءًۭ","māan","water","পানি"],["ثَجَّاجًۭا","thajjājan","pouring abundantly","মুষলধারে"]],"t":"وَأَ<k>نزَ</>لْنَا مِنَ <h>ٱ</>لْمُعْصِ<m>رَٰ</>تِ <o>مَآ</><k>ءًۭ ثَ</>جَّاجًۭا"},{"n":15,"w":[["لِّنُخْرِجَ","linukh'rija","That We may bring forth","এজন্য যে আমরা বের করব"],["بِهِۦ","bihi","thereby","তা দিয়ে"],["حَبًّۭا","ḥabban","grain","শস্য"],["وَنَبَاتًۭا","wanabātan","and vegetation","ও উদ্ভিদ"]],"t":"لِّنُخْرِجَ بِ<m>هِۦ</> حَ<d>بًّۭا وَ</>نَبَاتًۭا"},{"n":16,"w":[["وَجَنَّـٰتٍ","wajannātin","And gardens","এবং বাগিচাসমূহ"],["أَلْفَافًا","alfāfan","(of) thick foliage","ঘনসন্নিবিষ্ট"]],"t":"وَجَ<g>نَّٰ</>تٍ أَلْفَافًا"},{"n":17,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["يَوْمَ","yawma","(the) Day","দিন"],["ٱلْفَصْلِ","l-faṣli","(of) the Judgment","বিচারের"],["كَانَ","kāna","is","আছে"],["مِيقَـٰتًۭا","mīqātan","an appointed time","নির্দিষ্ট"]],"t":"إِ<g>نَّ</> يَوْمَ <h>ٱ</>لْفَصْلِ كَانَ مِي<m>