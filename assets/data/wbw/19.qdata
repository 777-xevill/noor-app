িকট থেকে"],["ٱلرَّحْمَـٰنِ","l-raḥmāni","the Most Gracious","দয়াময়ের"],["عَهْدًۭا","‘ahdan","a promise","প্রতিশ্রুতি"]],"t":"أَطَّلَعَ <h>ٱ</>لْغَيْبَ أَمِ <h>ٱ</>تَّخَذَ عِ<k>ندَ</> <h>ٱ</><l>ل</>رَّحْ<m>مَٰ</>نِ عَهْدًۭا"},{"n":79,"w":[["كَلَّا ۚ","kallā","Nay","কখনও না"],["سَنَكْتُبُ","sanaktubu","We will record","অচিরেই লিখবো আমরা"],["مَا","mā","what","যা"],["يَقُولُ","yaqūlu","he says","সে বলছে"],["وَنَمُدُّ","wanamuddu","and We will extend","এবং বাড়িয়ে দিবো আমরা"],["لَهُۥ","lahu","for him","তার জন্য"],["مِنَ","mina","from","থেকে"],["ٱلْعَذَابِ","l-‘adhābi","the punishment","শাস্তি"],["مَدًّۭا","maddan","extensively","(অধিক মাত্রায়) বাড়ান"]],"t":"كَلَّا ۚ سَنَكْتُبُ مَا يَقُولُ وَنَمُدُّ لَهُ<m>ۥ</> مِنَ <h>ٱ</>لْعَذَابِ مَدًّۭا"},{"n":80,"w":[["وَنَرِثُهُۥ","wanarithuhu","And We will inherit (from) him","এবং আমরা তার অধিকারী হবো"],["مَا","mā","what","যা কিছু"],["يَقُولُ","yaqūlu","he says","সে বলছে"],["وَيَأْتِينَا","wayatīnā","and he will come to Us","এবং আমার কাছে সে আসবে"],["فَرْدًۭا","fardan","alone","একাকী"]],"t":"وَنَرِثُهُ<m>ۥ</> مَا يَقُولُ وَيَأْتِينَا فَرْدًۭا"},{"n":81,"w":[["وَٱتَّخَذُوا۟","wa-ittakhadhū","And they have taken","এবং তারা গ্রহণ করেছে"],["مِن","min","besides Allah","মধ্য হতে"],["دُونِ","dūni","besides Allah","ছাড়া"],["ٱللَّهِ","l-lahi","besides Allah","আল্লাহ্‌"],["ءَالِهَةًۭ","ālihatan","gods","ইলাহ (অন্য)"],["لِّيَكُونُوا۟","liyakūnū","that they may be","যেন তারা হয়"],["لَهُمْ","lahum","for them","তাদের জন্য"],["عِزًّۭا","‘izzan","an honor","সহায়ক (শক্তি)"]],"t":"وَ<h>ٱ</>تَّخَذُو<s>ا۟</> مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ ءَالِهَ<w>ةًۭ لِّ</>يَكُونُو<s>ا۟</> لَهُمْ عِزًّۭا"},{"n":82,"w":[["كَلَّا ۚ","kallā","Nay","কখনও না"],["سَيَكْفُرُونَ","sayakfurūna","they will deny","অচিরেই তারা অস্বীকার করবে"],["بِعِبَادَتِهِمْ","bi‘ibādatihim","their worship (of them)","তাদের উপাসনা সম্পর্কে"],["وَيَكُونُونَ","wayakūnūna","and they will be","এবং তারা হবে"],["عَلَيْهِمْ","‘alayhim","against them","তাদের ব্যাপারে"],["ضِدًّا","ḍiddan","opponents","(