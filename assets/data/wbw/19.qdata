{"n":19,"a":[{"n":1,"w":[["كٓهيعٓصٓ","kaf-ha-ya-ain-sad","Kaaf Ha Ya Ain Sad","কাফ-হা-ইয়া-'আইন-স-দ"]],"t":"<n>كٓ</>هي<n>عٓصٓ</>"},{"n":2,"w":[["ذِكْرُ","dhik'ru","(A) mention","উল্লেখ (করা হচ্ছে)"],["رَحْمَتِ","raḥmati","(of the) Mercy","অনুগ্রহের"],["رَبِّكَ","rabbika","(of) your Lord","তোমার রবের"],["عَبْدَهُۥ","‘abdahu","(to) His servant","তাঁর দাস"],["زَكَرِيَّآ","zakariyyā","Zakariya","যাকারিয়্যার (প্রতি)"]],"t":"ذِكْرُ رَحْمَتِ رَبِّكَ عَ<q>بْ</>دَهُ<m>ۥ</> زَكَرِيَّآ"},{"n":3,"w":[["إِذْ","idh","When","যখন"],["نَادَىٰ","nādā","he called","সে ডেকেছিলো"],["رَبَّهُۥ","rabbahu","(to) his Lord","তাঁর রবকে"],["نِدَآءً","nidāan","a call ","ডাক"],["خَفِيًّۭا","khafiyyan","secret","নিভৃতে"]],"t":"إِذْ نَادَىٰ رَبَّهُ<m>ۥ</> نِ<o>دَآ</>ءً خَفِيًّۭا"},{"n":4,"w":[["قَالَ","qāla","He said","সে বলেছিলো"],["رَبِّ","rabbi","My Lord","\"হে আমার রব"],["إِنِّى","innī","Indeed, [I]","আমি নিশ্চয়ই (এ অবস্থায় যে)"],["وَهَنَ","wahana","(have) weakened","নরম হয়েছে"],["ٱلْعَظْمُ","l-‘aẓmu","my bones","হাড় (মজ্জা)"],["مِنِّى","minnī","my bones","আমার হ'তে"],["وَٱشْتَعَلَ","wa-ish'ta‘ala","and flared","এবং উজ্জ্বল (শুভ্র হয়েছে)"],["ٱلرَّأْسُ","l-rasu","(my) head","মাথা (চুল)"],["شَيْبًۭا","shayban","(with) white","বার্ধক্যের (চিহ্নে)"],["وَلَمْ","walam","and not","এবং নি"],["أَكُنۢ","akun","I have been","আমি হই"],["بِدُعَآئِكَ","bidu‘āika","in (my) supplication (to) You","কারণে তোমাকে ডাকার"],["رَبِّ","rabbi","my Lord","হে আমার রব"],["شَقِيًّۭا","shaqiyyan","unblessed","ব্যর্থকাম"]],"t":"قَالَ رَبِّ إِ<g>نِّ</>ى وَهَنَ <h>ٱ</>لْعَظْمُ مِ<g>نِّ</>ى وَ<h>ٱ</>شْتَعَلَ <h>ٱ</><l>ل</>رَّأْسُ شَيْ<d>بًۭا وَ</>لَمْ أَ<i>كُنۢ بِ</>دُ<o>عَآ</>ئِكَ رَبِّ شَقِيًّۭا"},{"n":5,"w":[["وَإِنِّى","wa-innī","And indeed, I","এবং আমি নিশ্চয়ই"],["خِفْتُ","khif'tu","[I] fear","ভয় করছি"],["ٱلْمَوَٰلِىَ","l-mawāliya","the successors","আমার স্বগোত্রদের"],["مِن","min","after me","থেকে"],["وَرَآءِى","warāī","after me","আমার পর"],["وَكَانَتِ","wakānati","and is","এবং হয়েছে"],["ٱمْرَأَتِى","im'ra-atī","my wife","আমার স্ত্রী"],["عَاقِرًۭا","‘āqiran","barren","বন্ধ্যা"],["فَهَبْ","fahab","So give","তবুও দান করো"],["لِى","lī","[to] me","আমাকে"],["مِن","min","from","থেকে"],["لَّدُنكَ","ladunka","Yourself","তোমার নিকট"],["وَلِيًّۭا","waliyyan","an heir","এক উত্তরাধিকারী"]],"t":"وَإِ<g>نِّ</>ى خِفْتُ <h>ٱ</>لْمَ<m>وَٰ</>لِىَ <d>مِن وَ</><o>رَآ</>ءِى وَكَانَتِ <h>ٱ</>مْرَأَتِى عَاقِ<k>رًۭا فَ</>هَ<q>بْ</> لِى <w>مِن لَّ</>دُ<k>نكَ</> وَلِيًّۭا"},{"n":6,"w":[["يَرِثُنِى","yarithunī","Who will inherit me","আমার উত্তরাধিকারী হবে সে"],["وَيَرِثُ","wayarithu","and inherit","ও উত্তরাধিকারী হবে"],["مِنْ","min","from","ব্যাপারে"],["ءَالِ","āli","(the) family","বংশের"],["يَعْقُوبَ ۖ","ya‘qūba","(of) Yaqub","ইয়াকুবের"],["وَٱجْعَلْهُ","wa-ij'‘alhu","And make him","এবং তাকে করো"],["رَبِّ","rabbi","my Lord","হে আমার রব"],["رَضِيًّۭا","raḍiyyan","pleasing","সন্তোষজনক\""]],"t":"يَرِثُنِى وَيَرِثُ مِنْ ءَالِ يَعْقُوبَ ۖ وَ<h>ٱ</><q>جْ</>عَلْهُ رَبِّ رَضِيًّۭا"},{"n":7,"w":[["يَـٰزَكَرِيَّآ","yāzakariyyā","O Zakariya","\"(বলা হলো) হে যাকারিয়্যা"],["إِنَّا","innā","Indeed, We","নিশ্চয়ই আমরা"],["نُبَشِّرُكَ","nubashiruka","[We] give you glad tidings","তোমাকে সুসংবাদ দিচ্ছি"],["بِغُلَـٰمٍ","bighulāmin","of a boy","সম্পর্কে এক পুত্রের"],["ٱسْمُهُۥ","us'muhu","his name","তার নাম (হবে)"],["يَحْيَىٰ","yaḥyā","(will be) Yahya","ইয়াহইয়া"],["لَمْ","lam","not","নি"],["نَجْعَل","naj‘al","We (have) assigned","আমরা করি"],["لَّهُۥ","lahu","[for] it","তার জন্য"],["مِن","min","before","থেকে"],["قَبْلُ","qablu","before","ইতিপূর্বে (অন্য কাউকে)"],["سَمِيًّۭا","samiyyan","(this) name","(সম) নামকরণ\""]],"t":"<m>يَٰ</>زَكَرِ<o>يَّآ</> إِ<g>نَّ</>ا نُبَشِّرُكَ بِغُ<m>لَٰ</>مٍ <h>ٱ</>سْمُهُ<m>ۥ</> يَحْيَىٰ لَمْ نَ<q>جْ</>عَل لَّهُ<m>ۥ</> مِ<k>ن قَ</><q>بْ</>لُ سَمِيًّۭا"},{"n":8,"w":[["قَالَ","qāla","He said","সে বললো"],["رَبِّ","rabbi","My Lord","\"হে আমার রব"],["أَنَّىٰ","annā","How","কেমন করে"],["يَكُونُ","yakūnu","can","হবে"],["لِى","lī","I have","আমার"],["غُلَـٰمٌۭ","ghulāmun","a boy","পুত্র"],["وَكَانَتِ","wakānati","while is","যখন হলো"],["ٱمْرَأَتِى","im'ra-atī","my wife","আমার স্ত্রী"],["عَاقِرًۭا","‘āqiran","barren","বন্ধ্যা"],["وَقَدْ","waqad","and indeed","এবং নিশ্চয়ই"],["بَلَغْتُ","balaghtu","I have reached","আমি উপনীত হয়েছি"],["مِنَ","mina","of","কারণে"],["ٱلْكِبَرِ","l-kibari","the old age","বার্ধক্যের"],["عِتِيًّۭا","‘itiyyan","extreme","(চরম) শেষসীমায়\""]],"t":"قَالَ رَبِّ أَ<g>نَّ</>ىٰ يَكُونُ لِى غُ<m>لَٰ</><d>مٌۭ وَ</>كَانَتِ <h>ٱ</>مْرَأَتِى عَاقِ<d>رًۭا وَ</>قَ<q>دْ</> بَلَغْتُ مِنَ <h>ٱ</>لْكِبَرِ عِتِيًّۭا"},{"n":9,"w":[["قَالَ","qāla","He said","তিনি বললেন"],["كَذَٰلِكَ","kadhālika","Thus","\"এরূপই (হবে)"],["قَالَ","qāla","said","বললেন"],["رَبُّكَ","rabbuka","your Lord","তোমার রব"],["هُوَ","huwa","'It","তা"],["عَلَىَّ","‘alayya","(is) easy for Me","আমার উপর"],["هَيِّنٌۭ","hayyinun","(is) easy for Me","সহজসাধ্য"],["وَقَدْ","waqad","and certainly","এবং নিশ্চয়ই"],["خَلَقْتُكَ","khalaqtuka","I (have) created you","তোমাকে আমি সৃষ্টি করেছি"],["مِن","min","before","থেকে"],["قَبْلُ","qablu","before","ইতিপূর্বে"],["وَلَمْ","walam","while not","যখন না"],["تَكُ","taku","you were","তুমি ছিলে"],["شَيْـًۭٔا","shayan","anything.'","(কোন) কিছুই"]],"t":"قَالَ كَ<m>ذَٰ</>لِكَ قَالَ رَبُّكَ هُوَ عَلَىَّ هَيِّ<d>نٌۭ وَ</>قَ<q>دْ</> خَلَ<q>قْ</>تُكَ مِ<k>ن قَ</><q>بْ</>لُ وَلَمْ تَكُ شَيْـًۭٔا"},{"n":10,"w":[["قَالَ","qāla","He said","সে বললো"],["رَبِّ","rabbi","My Lord","\"হে আমার রব"],["ٱجْعَل","ij'‘al","Make","দাও"],["لِّىٓ","lī","for me","আমাকে"],["ءَايَةًۭ ۚ","āyatan","a sign","একটা নিদর্শন\""],["قَالَ","qāla","He said","তিনি বললেন"],["ءَايَتُكَ","āyatuka","Your sign","\"তোমার নিদর্শন"],["أَلَّا","allā","(is) that not","(এই) যে না"],["تُكَلِّمَ","tukallima","you will speak","কথা বলতে পারবে"],["ٱلنَّاسَ","l-nāsa","(to) the people","মানুষের (সাথে)"],["ثَلَـٰثَ","thalātha","(for) three","তিন"],["لَيَالٍۢ","layālin","nights","রাত"],["سَوِيًّۭا","sawiyyan","sound","(ক্রমাগত) সুস্থ অবস্থায়\""]],"t":"قَالَ رَبِّ <h>ٱ</><q>جْ</>عَل <o>لِّىٓ</> ءَايَ<k>ةًۭ ۚ قَ</>الَ ءَايَتُكَ أَلَّا تُكَلِّمَ <h>ٱ</><l>ل</><g>نَّ</>اسَ ثَ<m>لَٰ</>ثَ لَيَا<k>لٍۢ سَ</>وِيًّۭا"},{"n":11,"w":[["فَخَرَجَ","fakharaja","Then he came out","অতঃপর সে বের হলো"],["عَلَىٰ","‘alā","to","নিকট"],["قَوْمِهِۦ","qawmihi","his people","তার (জাতির) লোকদের"],["مِنَ","mina","from","থেকে"],["ٱلْمِحْرَابِ","l-miḥ'rābi","the prayer chamber","মেহরাব"],["فَأَوْحَىٰٓ","fa-awḥā","and he signaled","সে অতঃপর ইঙ্গিত করলো"],["إِلَيْهِمْ","ilayhim","to them","তাদের দিকে"],["أَن","an","to","যে"],["سَبِّحُوا۟","sabbiḥū","glorify (Allah)","তোমরা পবিত্রতা ঘোষণা করো"],["بُكْرَةًۭ","buk'ratan","(in) the morning","সকালে"],["وَعَشِيًّۭا","wa‘ashiyyan","and (in) the evening","ও সন্ধ্যায়"]],"t":"فَخَرَجَ عَلَىٰ قَوْمِ<m>هِۦ</> مِنَ <h>ٱ</>لْمِحْرَابِ فَأَوْحَ<o>ىٰٓ</> إِلَيْهِمْ أَ<k>ن سَ</>بِّحُو<s>ا۟</> بُكْرَ<d>ةًۭ وَ</>عَشِيًّۭا"},{"n":12,"w":[["يَـٰيَحْيَىٰ","yāyaḥyā","O Yahya","\"(বড় হ'লে তাকে বলা হলো) হে ইয়াহইয়া"],["خُذِ","khudhi","Hold","গ্রহণ করো"],["ٱلْكِتَـٰبَ","l-kitāba","the Scripture","কিতাবকে"],["بِقُوَّةٍۢ ۖ","biquwwatin","with strength","সহ দৃঢ়তা\""],["وَءَاتَيْنَـٰهُ","waātaynāhu","And We gave him","এবং তাকে আমরা দিয়েছিলাম"],["ٱلْحُكْمَ","l-ḥuk'ma","[the] wisdom","প্রজ্ঞা"],["صَبِيًّۭا","ṣabiyyan","(when he was) a child","বাল্য অবস্থায়"]],"t":"<m>يَٰ</>يَحْيَىٰ خُذِ <h>ٱ</>لْكِ<m>تَٰ</>بَ بِقُوَّ<d>ةٍۢ ۖ وَ</>ءَاتَيْ<m>نَٰ</>هُ <h>ٱ</>لْحُكْمَ صَبِيًّۭا"},{"n":13,"w":[["وَحَنَانًۭا","waḥanānan","And affection","এবং হৃদয়ের কোমলতা"],["مِّن","min","from","থেকে"],["لَّدُنَّا","ladunnā","Us","আমাদের নিকট"],["وَزَكَوٰةًۭ ۖ","wazakatan","and purity","এবং পবিত্রতা"],["وَكَانَ","wakāna","and he was","এবং সে ছিলো"],["تَقِيًّۭا","taqiyyan","righteous","মুত্তাকী"]],"t":"وَحَنَا<d>نًۭا مِّ</><w>ن لَّ</>دُ<g>نَّ</>ا وَزَكَ<s>وٰ</><d>ةًۭ ۖ وَ</>كَانَ تَقِيًّۭا"},{"n":14,"w":[["وَبَرًّۢا","wabarran","And dutiful","এবং অনুগত"],["بِوَٰلِدَيْهِ","biwālidayhi","to his parents","কাছে তার মা বাপের"],["وَلَمْ","walam","and not","এবং না"],["يَكُن","yakun","he was","ছিলো"],["جَبَّارًا","jabbāran","a tyrant","উদ্ধত"],["عَصِيًّۭا","‘aṣiyyan","disobedient","অবাধ্য"]],"t":"وَبَ<i>رًّۢا بِ</><m>وَٰ</>لِدَيْهِ وَلَمْ يَكُ<k>ن جَ</>بَّارًا عَصِيًّۭا"},{"n":15,"w":[["وَسَلَـٰمٌ","wasalāmun","And peace be","এবং সালাম"],["عَلَيْهِ","‘alayhi","upon him","তার উপর"],["يَوْمَ","yawma","(the) day","যেদিন"],["وُلِدَ","wulida","he was born","জন্মলাভ করে সে"],["وَيَوْمَ","wayawma","and (the) day","ও যেদিন"],["يَمُوتُ","yamūtu","he dies","সে মরবে"],["وَيَوْمَ","wayawma","and (the) day","এবং যেদিন"],["يُبْعَثُ","yub'‘athu","he will be raised","তাকে উঠানো হবে"],["حَيًّۭا","ḥayyan","alive","জীবিত অবস্থায়"]],"t":"وَسَ<m>لَٰ</>مٌ عَلَيْهِ يَوْمَ وُلِدَ وَيَوْمَ يَمُوتُ وَيَوْمَ يُ<q>بْ</>عَثُ حَيًّۭا"},{"n":16,"w":[["وَٱذْكُرْ","wa-udh'kur","And mention","এবং বর্ণনা করো (যা)"],["فِى","fī","in","(বলা হয়েছে) মধ্যে"],["ٱلْكِتَـٰبِ","l-kitābi","the Book","(এই) কিতাবের"],["مَرْيَمَ","maryama","Maryam","মারইয়াম (সম্পর্কে)"],["إِذِ","idhi","when","যখন"],["ٱنتَبَذَتْ","intabadhat","she withdrew","সে পৃথক হয়ে গেলো"],["مِنْ","min","from","থেকে"],["أَهْلِهَا","ahlihā","her family","তার পরিবার"],["مَكَانًۭا","makānan","(to) a place","স্থানে"],["شَرْقِيًّۭا","sharqiyyan","eastern","(বায়তুল মুকাদ্দাসের) পূর্বদিকের"]],"t":"وَ<h>ٱ</>ذْكُرْ فِى <h>ٱ</>لْكِ<m>تَٰ</>بِ مَرْيَمَ إِذِ <h>ٱ</><k>نتَ</>بَذَتْ مِنْ أَهْلِهَا مَكَا<k>نًۭا شَ</>رْقِيًّۭا"},{"n":17,"w":[["فَٱتَّخَذَتْ","fa-ittakhadhat","Then she took","সে অতঃপর গ্রহণ করেছিলো (স্থান)"],["مِن","min","from them","মধ্য হতে"],["دُونِهِمْ","dūnihim","from them","তাদের ছাড়া"],["حِجَابًۭا","ḥijāban","a screen","আড়ালে (অর্থাৎ ইতিকাফে বসলো)"],["فَأَرْسَلْنَآ","fa-arsalnā","Then We sent","আমরা অতঃপর প্রেরণ করলাম"],["إِلَيْهَا","ilayhā","to her","তার প্রতি"],["رُوحَنَا","rūḥanā","Our Spirit","আমাদের রূহ (অর্থাৎ ফেরেশতাকে)"],["فَتَمَثَّلَ","fatamathala","then he assumed for her the likeness","অতঃপর সে আকৃতি ধারণ করলো"],["لَهَا","lahā","then he assumed for her the likeness","তার কাছে"],["بَشَرًۭا","basharan","(of) a man","একজন মানুষের বেশে"],["سَوِيًّۭا","sawiyyan","well-proportioned","পূর্নাঙ্গ"]],"t":"فَ<h>ٱ</>تَّخَذَتْ مِ<k>ن دُ</>ونِهِمْ حِجَا<k>بًۭا فَ</>أَرْسَلْ<o>نَآ</> إِلَيْهَا رُوحَنَا فَتَمَثَّلَ لَهَا بَشَ<k>رًۭا سَ</>وِيًّۭا"},{"n":18,"w":[["قَالَتْ","qālat","She said","(মারইয়াম) বললো"],["إِنِّىٓ","innī","Indeed, I","\"আমি নিশ্চয়ই"],["أَعُوذُ","a‘ūdhu","[I] seek refuge","আশ্রয় চাই"],["بِٱلرَّحْمَـٰنِ","bil-raḥmāni","with the Most Gracious","কাছে দয়াময়ের"],["مِنكَ","minka","from you","তোমার থেকে"],["إِن","in","if","যদি"],["كُنتَ","kunta","you are","তুমি হও"],["تَقِيًّۭا","taqiyyan","God fearing","মুত্তাকী\""]],"t":"قَالَتْ إِ<g>نِّ</><o>ىٓ</> أَعُوذُ بِ<h>ٱ</><l>ل</>رَّحْ<m>مَٰ</>نِ مِ<k>نكَ</> إِ<k>ن كُنتَ</> تَقِيًّۭا"},{"n":19,"w":[["قَالَ","qāla","He said","সে বললো"],["إِنَّمَآ","innamā","Only","\"প্রকৃতপক্ষে"],["أَنَا۠","anā","I am","আমি"],["رَسُولُ","rasūlu","a Messenger","(প্রেরিত) দূত"],["رَبِّكِ","rabbiki","(from) your Lord","তোমার রবের"],["لِأَهَبَ","li-ahaba","that I (may) bestow","দান করি যেন"],["لَكِ","laki","on you","তোমাকে"],["غُلَـٰمًۭا","ghulāman","a son","এক পুত্র"],["زَكِيًّۭا","zakiyyan","pure","পবিত্র\""]],"t":"قَالَ إِ<g>نَّ</><o>مَآ</> أَنَا۠ رَسُولُ رَبِّكِ لِأَهَبَ لَكِ غُ<m>لَٰ</><k>مًۭا زَ</>كِيًّۭا"},{"n":20,"w":[["قَالَتْ","qālat","She said","সে বললো"],["أَنَّىٰ","annā","How","\"কেমন করে"],["يَكُونُ","yakūnu","can be","হবে"],["لِى","lī","for me","আমার"],["غُلَـٰمٌۭ","ghulāmun","a son","পুত্র"],["وَلَمْ","walam","when not","যখন নি"],["يَمْسَسْنِى","yamsasnī","has touched me","আমাকে স্পর্শ করে"],["بَشَرٌۭ","basharun","a man","কোন মানুষ"],["وَلَمْ","walam","and not","এবং নই"],["أَكُ","aku","I am","আমি (হই)"],["بَغِيًّۭا","baghiyyan","unchaste","ব্যভিচারিণী\""]],"t":"قَالَتْ أَ<g>نَّ</>ىٰ يَكُونُ لِى غُ<m>لَٰ</><d>مٌۭ وَ</>لَمْ يَمْسَسْنِى بَشَ<d>رٌۭ وَ</>لَمْ أَكُ بَغِيًّۭا"},{"n":21,"w":[["قَالَ","qāla","He said","(ফেরেশতা) বললো"],["كَذَٰلِكِ","kadhāliki","Thus","\"এরূপই (হবে)"],["قَالَ","qāla","said","বলেছেন"],["رَبُّكِ","rabbuki","your Lord","তোমার রব"],["هُوَ","huwa","'It","তা"],["عَلَىَّ","‘alayya","(is) for Me","আমার উপর"],["هَيِّنٌۭ ۖ","hayyinun","easy","সহজ"],["وَلِنَجْعَلَهُۥٓ","walinaj‘alahu","and so that We will make him","এবং যেন তা আমরা করি"],["ءَايَةًۭ","āyatan","a sign","একটি নিদর্শন"],["لِّلنَّاسِ","lilnnāsi","for the mankind","মানুষদের জন্য"],["وَرَحْمَةًۭ","waraḥmatan","and a Mercy","ও অনুগ্রহ"],["مِّنَّا ۚ","minnā","from Us","আমাদের থেকে"],["وَكَانَ","wakāna","And (it) is","এবং হয়েছে"],["أَمْرًۭا","amran","a matter","বিষয় (সিদ্ধান্ত)"],["مَّقْضِيًّۭا","maqḍiyyan","decreed.'","স্থিরীকৃত"]],"t":"قَالَ كَ<m>ذَٰ</>لِكِ قَالَ رَبُّكِ هُوَ عَلَىَّ هَيِّ<d>نٌۭ ۖ وَ</>لِنَ<q>جْ</>عَلَهُ<o>ۥٓ</> ءَايَ<w>ةًۭ لِّ</>ل<g>نَّ</>اسِ وَرَحْمَ<d>ةًۭ مِّ</><g>نَّ</>ا ۚ وَكَانَ أَمْ<d>رًۭا مَّ</><q>قْ</>ضِيًّۭا"},{"n":22,"w":[["۞ فَحَمَلَتْهُ","faḥamalathu","So she conceived him","তাকে সে অতঃপর গর্ভধারণ করলো"],["فَٱنتَبَذَتْ","fa-intabadhat","and she withdrew","অতঃপর সে পৃথক হয়ে গেলো"],["بِهِۦ","bihi","with him","তা নিয়ে"],["مَكَانًۭا","makānan","(to) a place","স্থানে"],["قَصِيًّۭا","qaṣiyyan","remote","দূরবর্তী"]],"t":"۞ فَحَمَلَتْهُ فَ<h>ٱ</><k>نتَ</>بَذَتْ بِ<m>هِۦ</> مَكَا<k>نًۭا قَ</>صِيًّۭا"},{"n":23,"w":[["فَأَجَآءَهَا","fa-ajāahā","Then drove her","অতঃপর তাকে নিয়ে এলো"],["ٱلْمَخَاضُ","l-makhāḍu","the pains of childbirth","প্রসববেদনা"],["إِلَىٰ","ilā","to","কাছে"],["جِذْعِ","jidh'‘i","(the) trunk","কান্ডের"],["ٱلنَّخْلَةِ","l-nakhlati","(of) the date-palm","খেজুর গাছের"],["قَالَتْ","qālat","She said","সে বললো"],["يَـٰلَيْتَنِى","yālaytanī","O! I wish","\"হায়! আমার আফসোস"],["مِتُّ","mittu","I (had) died","আমি (যদি) মরে যেতাম"],["قَبْلَ","qabla","before","পূর্বে"],["هَـٰذَا","hādhā","this","এর"],["وَكُنتُ","wakuntu","and I was","এবং আমি হতাম"],["نَسْيًۭا","nasyan","(in) oblivion","বিস্মৃত"],["مَّنسِيًّۭا","mansiyyan","forgotten","স্মৃতি বিলুপ্ত\""]],"t":"فَأَ<o>جَآ</>ءَهَا <h>ٱ</>لْمَخَاضُ إِلَىٰ جِذْعِ <h>ٱ</><l>ل</><g>نَّ</>خْلَةِ قَالَتْ <m>يَٰ</>لَيْتَنِى مِتُّ قَ<q>بْ</>لَ <m>هَٰ</>ذَا وَكُ<k>نتُ</> نَسْ<d>يًۭا مَّ</><k>نسِ</>يًّۭا"},{"n":24,"w":[["فَنَادَىٰهَا","fanādāhā","So cried to her","অতঃপর ডেকে বললো (ফেরেশতা) তাকে"],["مِن","min","from","হ'তে"],["تَحْتِهَآ","taḥtihā","beneath her","তার নিচ"],["أَلَّا","allā","That (do) not","\"যে না"],["تَحْزَنِى","taḥzanī","grieve","তুমি চিন্তা করো"],["قَدْ","qad","verily","নিশ্চয়ই"],["جَعَلَ","ja‘ala","(has) placed","সৃষ্টি করেছেন"],["رَبُّكِ","rabbuki","your Lord","তোমার রব"],["تَحْتَكِ","taḥtaki","beneath you","তোমার নিচে"],["سَرِيًّۭا","sariyyan","a stream","এক ঝর্ণা"]],"t":"فَنَادَ<m>ىٰ</>هَا مِ<k>ن تَ</>حْتِ<o>هَآ</> أَلَّا تَحْزَنِى قَ<q>دْ</> جَعَلَ رَبُّكِ تَحْتَكِ سَرِيًّۭا"},{"n":25,"w":[["وَهُزِّىٓ","wahuzzī","And shake","এবং তুমি নাড়া দাও"],["إِلَيْكِ","ilayki","towards you","তোমার দিকে"],["بِجِذْعِ","bijidh'‘i","(the) trunk","কান্ডসহ"],["ٱلنَّخْلَةِ","l-nakhlati","(of) the date-palm","খেজুর গাছের"],["تُسَـٰقِطْ","tusāqiṭ","it will drop","ঝরে পড়বে"],["عَلَيْكِ","‘alayki","upon you","তোমার উপর"],["رُطَبًۭا","ruṭaban","fresh dates","খেজুর"],["جَنِيًّۭا","janiyyan","ripe","তাজা"]],"t":"وَهُ<o>زِّىٓ</> إِلَيْكِ بِجِذْعِ <h>ٱ</><l>ل</><g>نَّ</>خْلَةِ تُ<m>سَٰ</>قِ<q>طْ</> عَلَيْكِ رُطَ<k>بًۭا جَ</>نِيًّۭا"},{"n":26,"w":[["فَكُلِى","fakulī","So eat","সুতরাং খাও"],["وَٱشْرَبِى","wa-ish'rabī","and drink","ও পান করো"],["وَقَرِّى","waqarrī","and cool","এবং জুড়াও"],["عَيْنًۭا ۖ","‘aynan","(your) eyes","চোখকে"],["فَإِمَّا","fa-immā","And if","অতঃপর যদি"],["تَرَيِنَّ","tarayinna","you see","তুমি দেখো"],["مِنَ","mina","from","মধ্য হ'তে"],["ٱلْبَشَرِ","l-bashari","human being","মানুষের"],["أَحَدًۭا","aḥadan","anyone","কাউকে"],["فَقُولِىٓ","faqūlī","then say","তখন তুমি বলো"],["إِنِّى","innī","Indeed, I","\"আমি নিশ্চয়ই"],["نَذَرْتُ","nadhartu","[I] have vowed","মানত করেছি"],["لِلرَّحْمَـٰنِ","lilrraḥmāni","to the Most Gracious","দয়াময়ের জন্য"],["صَوْمًۭا","ṣawman","a fast","রোজা"],["فَلَنْ","falan","so not","অতএব না"],["أُكَلِّمَ","ukallima","I will speak","কথা বলবো আমি"],["ٱلْيَوْمَ","l-yawma","today","আজ"],["إِنسِيًّۭا","insiyyan","(to any) human being","কোন মানুষের সাথে\""]],"t":"فَكُلِى وَ<h>ٱ</>شْرَبِى وَقَرِّى عَيْ<k>نًۭا ۖ فَ</>إِ<g>مَّ</>ا تَرَيِ<g>نَّ</> مِنَ <h>ٱ</>لْبَشَرِ أَحَ<k>دًۭا فَ</>قُو<o>لِىٓ</> إِ<g>نِّ</>ى نَذَرْتُ لِلرَّحْ<m>مَٰ</>نِ صَوْ<k>مًۭا فَ</>لَنْ أُكَلِّمَ <h>ٱ</>لْيَوْمَ إِ<k>نسِ</>يًّۭا"},{"n":27,"w":[["فَأَتَتْ","fa-atat","Then she came","অতঃপর সে আসলো"],["بِهِۦ","bihi","with him","তাকে নিয়ে"],["قَوْمَهَا","qawmahā","(to) her people","তার সম্প্রদায়ের কাছে"],["تَحْمِلُهُۥ ۖ","taḥmiluhu","carrying him","তাকে বহন করে"],["قَالُوا۟","qālū","They said","তারা বললো"],["يَـٰمَرْيَمُ","yāmaryamu","O Maryam","\"হে মারইয়াম"],["لَقَدْ","laqad","Certainly","নিশ্চয়ই"],["جِئْتِ","ji'ti","you (have) brought","এনেছো"],["شَيْـًۭٔا","shayan","an amazing thing","কিছু"],["فَرِيًّۭا","fariyyan","an amazing thing","জঘন্য"]],"t":"فَأَتَتْ بِ<m>هِۦ</> قَوْمَهَا تَحْمِلُهُ<m>ۥ</> ۖ قَالُو<s>ا۟</> <m>يَٰ</>مَرْيَمُ لَقَ<q>دْ</> جِئْتِ شَ<k>يْـًۭٔا فَ</>رِيًّۭا"},{"n":28,"w":[["يَـٰٓأُخْتَ","yāukh'ta","O sister","হে বোন"],["هَـٰرُونَ","hārūna","(of) Harun","হারূনের"],["مَا","mā","Not","না"],["كَانَ","kāna","was","ছিলেন"],["أَبُوكِ","abūki","your father","তোমার বাপ"],["ٱمْرَأَ","im'ra-a","an evil man","ব্যক্তি"],["سَوْءٍۢ","sawin","an evil man","অসৎ"],["وَمَا","wamā","and not","আর না"],["كَانَتْ","kānat","was","ছিলেন"],["أُمُّكِ","ummuki","your mother","তোমার মা"],["بَغِيًّۭا","baghiyyan","unchaste","ব্যভিচারিনী (চরিত্রহীনা)\""]],"t":"<o>يَٰٓ</>أُخْتَ <m>هَٰ</>رُونَ مَا كَانَ أَبُوكِ <h>ٱ</>مْرَأَ سَوْ<d>ءٍۢ وَ</>مَا كَانَتْ أُ<g>مُّ</>كِ بَغِيًّۭا"},{"n":29,"w":[["فَأَشَارَتْ","fa-ashārat","Then she pointed","তখন সে ইঙ্গিত করলো"],["إِلَيْهِ ۖ","ilayhi","to him","তার দিকে"],["قَالُوا۟","qālū","They said","তারা বললো"],["كَيْفَ","kayfa","How","\"কিভাবে"],["نُكَلِّمُ","nukallimu","(can) we speak","কথা বলবো আমরা"],["مَن","man","(to one) who","যে"],["كَانَ","kāna","is","আছে"],["فِى","fī","in","মধ্যে"],["ٱلْمَهْدِ","l-mahdi","the cradle","দোলনার"],["صَبِيًّۭا","ṣabiyyan","a child","ছোট্ট শিশু\""]],"t":"فَأَشَارَتْ إِلَيْهِ ۖ قَالُو<s>ا۟</> كَيْفَ نُكَلِّمُ مَ<k>ن كَ</>انَ فِى <h>ٱ</>لْمَهْدِ صَبِيًّۭا"},{"n":30,"w":[["قَالَ","qāla","He said","(শিশু ঈসা) বললো"],["إِنِّى","innī","Indeed, I am","\"নিশ্চয়ই আমি"],["عَبْدُ","‘abdu","a slave","দাস"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহ্‌র"],["ءَاتَىٰنِىَ","ātāniya","He gave me","আমাকে তিনি দিয়েছেন"],["ٱلْكِتَـٰبَ","l-kitāba","the Scripture","কিতাব"],["وَجَعَلَنِى","waja‘alanī","and made me","এবং আমাকে বানিয়েছেন"],["نَبِيًّۭا","nabiyyan","a Prophet","নাবী"]],"t":"قَالَ إِ<g>نِّ</>ى عَ<q>بْ</>دُ <h>ٱ</>للَّهِ ءَاتَ<m>ىٰ</>نِىَ <h>ٱ</>لْكِ<m>تَٰ</>بَ وَجَعَلَنِى نَبِيًّۭا"},{"n":31,"w":[["وَجَعَلَنِى","waja‘alanī","And He (has) made me","এবং আমাকে করেছেন"],["مُبَارَكًا","mubārakan","blessed","কল্যাণময়"],["أَيْنَ","ayna","wherever","যেখানে"],["مَا","mā","wherever","যা"],["كُنتُ","kuntu","I am","আমি থাকি"],["وَأَوْصَـٰنِى","wa-awṣānī","and has enjoined (on) me","এবং আমাকে নির্দেশ দিয়েছেন"],["بِٱلصَّلَوٰةِ","bil-ṣalati","[of] the prayer","ব্যাপারে সালাতের"],["وَٱلزَّكَوٰةِ","wal-zakati","and zakah","ও যাকাতের"],["مَا","mā","as long as I am","যা"],["دُمْتُ","dum'tu","as long as I am","আমি থাকি যতদিন পর্যন্ত"],["حَيًّۭا","ḥayyan","alive","জীবিত"]],"t":"وَجَعَلَنِى مُبَارَكًا أَيْنَ مَا كُ<k>نتُ</> وَأَوْ<m>صَٰ</>نِى بِ<h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةِ وَ<h>ٱ</><l>ل</>زَّكَ<s>وٰ</>ةِ مَا دُمْتُ حَيًّۭا"},{"n":32,"w":[["وَبَرًّۢا","wabarran","And dutiful","এবং অনুগত"],["بِوَٰلِدَتِى","biwālidatī","to my mother","আমার মায়ের"],["وَلَمْ","walam","and not","এবং নি"],["يَجْعَلْنِى","yaj‘alnī","He (has) made me","আমাকে করেন"],["جَبَّارًۭا","jabbāran","insolent","উদ্ধত"],["شَقِيًّۭا","shaqiyyan","unblessed","হতভাগ্য"]],"t":"وَبَ<i>رًّۢا بِ</><m>وَٰ</>لِدَتِى وَلَمْ يَ<q>جْ</>عَلْنِى جَبَّا<k>رًۭا شَ</>قِيًّۭا"},{"n":33,"w":[["وَٱلسَّلَـٰمُ","wal-salāmu","And peace (be)","এবং শান্তি"],["عَلَىَّ","‘alayya","on me","আমার উপর"],["يَوْمَ","yawma","(the) day","যেদিন"],["وُلِدتُّ","wulidttu","I was born","আমি জন্মলাভ করেছি"],["وَيَوْمَ","wayawma","and (the) day","ও যেদিন"],["أَمُوتُ","amūtu","I will die","আমি মরবো"],["وَيَوْمَ","wayawma","and (the) Day","ও যেদিন"],["أُبْعَثُ","ub'‘athu","I will be raised","উত্থিত হবো"],["حَيًّۭا","ḥayyan","alive","জীবিত\""]],"t":"وَ<h>ٱ</><l>ل</>سَّ<m>لَٰ</>مُ عَلَىَّ يَوْمَ وُلِ<j>د</>تُّ وَيَوْمَ أَمُوتُ وَيَوْمَ أُ<q>بْ</>عَثُ حَيًّۭا"},{"n":34,"w":[["ذَٰلِكَ","dhālika","That","এই (হলো)"],["عِيسَى","‘īsā","(was) Isa","ঈসা"],["ٱبْنُ","ub'nu","(the) son","পুত্র"],["مَرْيَمَ ۚ","maryama","(of) Maryam","মারইয়ামের"],["قَوْلَ","qawla","a statement","কথা"],["ٱلْحَقِّ","l-ḥaqi","(of) truth","চূড়ান্ত সত্য"],["ٱلَّذِى","alladhī","that which","যা (এমন যে)"],["فِيهِ","fīhi","about it","যে বিষয়ে"],["يَمْتَرُونَ","yamtarūna","they dispute","তারা সন্দেহ করছে"]],"t":"<m>ذَٰ</>لِكَ عِيسَى <h>ٱ</><q>بْ</>نُ مَرْيَمَ ۚ قَوْلَ <h>ٱ</>لْحَقِّ <h>ٱ</>لَّذِى فِيهِ يَمْتَ<p>رُو</>نَ"},{"n":35,"w":[["مَا","mā","Not","নয়"],["كَانَ","kāna","(it) is","কাজ"],["لِلَّهِ","lillahi","for Allah","আল্লাহ্‌র জন্য"],["أَن","an","that","যে"],["يَتَّخِذَ","yattakhidha","He should take","তিনি গ্রহণ করবেন"],["مِن","min","any son","কোন"],["وَلَدٍۢ ۖ","waladin","any son","সন্তান"],["سُبْحَـٰنَهُۥٓ ۚ","sub'ḥānahu","Glory be to Him","তিনি পবিত্র"],["إِذَا","idhā","When","যখন"],["قَضَىٰٓ","qaḍā","He decrees","স্হির করেন"],["أَمْرًۭا","amran","a matter","কোন বিষয়কে"],["فَإِنَّمَا","fa-innamā","then only","তখন শুধুমাত্র"],["يَقُولُ","yaqūlu","He says","বলেন"],["لَهُۥ","lahu","to it","তাকে"],["كُن","kun","Be","\"হও\""],["فَيَكُونُ","fayakūnu","and it is","তখনই হয়ে যায়"]],"t":"مَا كَانَ لِلَّهِ <d>أَن يَ</>تَّخِذَ <d>مِن وَ</>لَ<k>دٍۢ ۖ سُ</><q>بْ</><m>حَٰ</>نَهُ<o>ۥٓ ۚ</> إِذَا قَضَ<o>ىٰٓ</> أَمْ<k>رًۭا فَ</>إِ<g>نَّ</>مَا يَقُولُ لَهُ<m>ۥ</> كُ<k>ن فَ</>يَ<p>كُو</>نُ"},{"n":36,"w":[["وَإِنَّ","wa-inna","And indeed","\"এবং নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["رَبِّى","rabbī","(is) my Lord","আমার রব"],["وَرَبُّكُمْ","warabbukum","and your Lord","ও তোমাদের রব"],["فَٱعْبُدُوهُ ۚ","fa-u‘'budūhu","so worship Him","সুতরাং তাঁরই তোমরা ইবাদাত করো"],["هَـٰذَا","hādhā","This","এটা"],["صِرَٰطٌۭ","ṣirāṭun","(is) a path","পথ"],["مُّسْتَقِيمٌۭ","mus'taqīmun","straight","সরল সঠিক\""]],"t":"وَإِ<g>نَّ</> <h>ٱ</>للَّهَ رَبِّى وَرَبُّكُمْ فَ<h>ٱ</>عْبُدُوهُ ۚ <m>هَٰ</>ذَا صِ<m>رَٰ</><d>طٌۭ مُّ</>سْتَ<p>قِي</>مٌۭ"},{"n":37,"w":[["فَٱخْتَلَفَ","fa-ikh'talafa","But differed","অতঃপর মতভেদ করলো"],["ٱلْأَحْزَابُ","l-aḥzābu","the sects","বিভিন্ন দল"],["مِنۢ","min","from among them","থেকে"],["بَيْنِهِمْ ۖ","baynihim","from among them","তাদের মাঝে"],["فَوَيْلٌۭ","fawaylun","so woe","সুতরাং দুর্ভোগ"],["لِّلَّذِينَ","lilladhīna","to those who","(তাদের) জন্যে যারা"],["كَفَرُوا۟","kafarū","disbelieve","অস্বীকার করেছে"],["مِن","min","from","হ'তে"],["مَّشْهَدِ","mashhadi","(the) witnessing","সাক্ষাত"],["يَوْمٍ","yawmin","(of) a Day","দিনের"],["عَظِيمٍ","‘aẓīmin","great","কঠিন"]],"t":"فَ<h>ٱ</>خْتَلَفَ <h>ٱ</>لْأَحْزَابُ <i>مِنۢ بَ</>يْنِهِمْ ۖ فَوَيْ<w>لٌۭ لِّ</>لَّذِينَ كَفَرُو<s>ا۟</> <d>مِن مَّ</>شْهَدِ يَوْمٍ عَ<p>ظِي</>مٍ"},{"n":38,"w":[["أَسْمِعْ","asmi‘","How they will hear","স্পষ্ট শুনবে"],["بِهِمْ","bihim","How they will hear","তারা কত"],["وَأَبْصِرْ","wa-abṣir","and how (they will) see","ও (কত স্পষ্ট) দেখবে"],["يَوْمَ","yawma","(the) Day","যেদিন"],["يَأْتُونَنَا ۖ","yatūnanā","they will come to Us","আমাদের কাছে তারা আসবে"],["لَـٰكِنِ","lākini","but","কিন্তু"],["ٱلظَّـٰلِمُونَ","l-ẓālimūna","the wrongdoers","সীমালঙ্ঘনকারীরা"],["ٱلْيَوْمَ","l-yawma","today","আজ"],["فِى","fī","(are) in","মধ্যে (রয়েছে)"],["ضَلَـٰلٍۢ","ḍalālin","error","বিভ্রান্তির"],["مُّبِينٍۢ","mubīnin","clear","সুস্পষ্ট"]],"t":"أَسْمِعْ بِهِمْ وَأَ<q>بْ</>صِرْ يَوْمَ يَأْتُونَنَا ۖ <m>لَٰ</>كِنِ <h>ٱ</><l>ل</><m>ظَّٰ</>لِمُونَ <h>ٱ</>لْيَوْمَ فِى ضَ<m>لَٰ</><d>لٍۢ مُّ</><p>بِي</>نٍۢ"},{"n":39,"w":[["وَأَنذِرْهُمْ","wa-andhir'hum","And warn them","এবং সতর্ক করো তাদেরকে"],["يَوْمَ","yawma","(of the) Day","দিন (সম্পর্কে)"],["ٱلْحَسْرَةِ","l-ḥasrati","(of) the Regret","পরিতাপের"],["إِذْ","idh","when","যখন"],["قُضِىَ","quḍiya","has been decided","সিদ্ধান্ত হয়ে যাবে"],["ٱلْأَمْرُ","l-amru","the matter","বিষয়টির"],["وَهُمْ","wahum","And they","তারা এ অবস্থায় যখন"],["فِى","fī","(are) in","মধ্যে (আছে)"],["غَفْلَةٍۢ","ghaflatin","heedlessness","উদাসীনতা"],["وَهُمْ","wahum","and they","এবং তারা"],["لَا","lā","(do) not","না"],["يُؤْمِنُونَ","yu'minūna","believe","ঈমান আনছে"]],"t":"وَأَ<k>نذِ</>رْهُمْ يَوْمَ <h>ٱ</>لْحَسْرَةِ إِذْ قُضِىَ <h>ٱ</>لْأَمْرُ وَهُمْ فِى غَفْلَ<d>ةٍۢ وَ</>هُمْ لَا يُؤْمِ<p>نُو</>نَ"},{"n":40,"w":[["إِنَّا","innā","Indeed, We","নিশ্চয়ই আমরা"],["نَحْنُ","naḥnu","[We]","আমরা"],["نَرِثُ","narithu","[We] will inherit","উত্তরাধিকারী হবো"],["ٱلْأَرْضَ","l-arḍa","the earth","পৃথিবীর"],["وَمَنْ","waman","and whoever","এবং যা কিছু"],["عَلَيْهَا","‘alayhā","(is) on it","তার উপর (আছে)"],["وَإِلَيْنَا","wa-ilaynā","and to Us","এবং আমাদেরই দিকে"],["يُرْجَعُونَ","yur'ja‘ūna","they will be returned","তাদের ফিরিয়ে আনা হবে"]],"t":"إِ<g>نَّ</>ا نَحْنُ نَرِثُ <h>ٱ</>لْأَرْضَ وَمَنْ عَلَيْهَا وَإِلَيْنَا يُرْجَ<p>عُو</>نَ"},{"n":41,"w":[["وَٱذْكُرْ","wa-udh'kur","And mention","এবং বর্ণনা করো (যা)"],["فِى","fī","in","মধ্যে (বলা হচ্ছে)"],["ٱلْكِتَـٰبِ","l-kitābi","the Book","(এই) কিতাবের"],["إِبْرَٰهِيمَ ۚ","ib'rāhīma","Ibrahim","ইবরাহীম (সম্পর্কে)"],["إِنَّهُۥ","innahu","Indeed, he","সে নিশ্চয়ই"],["كَانَ","kāna","was","ছিলো"],["صِدِّيقًۭا","ṣiddīqan","a man of truth","সত্যনিষ্ঠ"],["نَّبِيًّا","nabiyyan","a Prophet","নাবী"]],"t":"وَ<h>ٱ</>ذْكُرْ فِى <h>ٱ</>لْكِ<m>تَٰ</>بِ إِ<q>بْ</><m>رَٰ</>هِيمَ ۚ إِ<g>نَّ</>هُ<m>ۥ</> كَانَ صِدِّي<d>قًۭا نَّ</>بِيًّا"},{"n":42,"w":[["إِذْ","idh","When","যখন"],["قَالَ","qāla","he said","সে বলেছিলো"],["لِأَبِيهِ","li-abīhi","to his father","তার বাপকে"],["يَـٰٓأَبَتِ","yāabati","O my father","\"হে আমার পিতা"],["لِمَ","lima","Why","কেন"],["تَعْبُدُ","ta‘budu","(do) you worship","উপাসনা করেন আপনি"],["مَا","mā","that which","যা"],["لَا","lā","not","না"],["يَسْمَعُ","yasma‘u","hears","শুনে"],["وَلَا","walā","and not","আর না"],["يُبْصِرُ","yub'ṣiru","sees","দেখে"],["وَلَا","walā","and not","এবং না"],["يُغْنِى","yugh'nī","benefits","কাজে আসে"],["عَنكَ","‘anka","[to] you","আপনার জন্য"],["شَيْـًۭٔا","shayan","(in) anything","কিছুই"]],"t":"إِذْ قَالَ لِأَبِيهِ <o>يَٰٓ</>أَبَتِ لِمَ تَعْبُدُ مَا لَا يَسْمَعُ وَلَا يُ<q>بْ</>صِرُ وَلَا يُغْنِى عَ<k>نكَ</> شَيْـًۭٔا"},{"n":43,"w":[["يَـٰٓأَبَتِ","yāabati","O my father","হে আমার পিতা"],["إِنِّى","innī","Indeed, [I]","নিশ্চয়ই আমার"],["قَدْ","qad","verily","নিশ্চয়ই"],["جَآءَنِى","jāanī","(has) come to me","এসেছে আমার কাছে"],["مِنَ","mina","of","(এমন) কিছু"],["ٱلْعِلْمِ","l-‘il'mi","the knowledge","জ্ঞান"],["مَا","mā","what","যা"],["لَمْ","lam","not","নি"],["يَأْتِكَ","yatika","came to you","আপনার কাছে আসে"],["فَٱتَّبِعْنِىٓ","fa-ittabi‘'nī","so follow me","সুতরাং অনুসরণ করুন"],["أَهْدِكَ","ahdika","I will guide you","আমি পথ দেখাবো"],["صِرَٰطًۭا","ṣirāṭan","(to) the path","পথ"],["سَوِيًّۭا","sawiyyan","even","সরল সঠিক"]],"t":"<o>يَٰٓ</>أَبَتِ إِ<g>نِّ</>ى قَ<q>دْ</> <o>جَآ</>ءَنِى مِنَ <h>ٱ</>لْعِلْمِ مَا لَمْ يَأْتِكَ فَ<h>ٱ</>تَّبِعْ<o>نِىٓ</> أَهْدِكَ صِ<m>رَٰ</><k>طًۭا سَ</>وِيًّۭا"},{"n":44,"w":[["يَـٰٓأَبَتِ","yāabati","O my father","হে আমার পিতা"],["لَا","lā","(Do) not","না"],["تَعْبُدِ","ta‘budi","worship","উপাসনা করবেন"],["ٱلشَّيْطَـٰنَ ۖ","l-shayṭāna","the Shaitaan","শয়তানের"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلشَّيْطَـٰنَ","l-shayṭāna","the Shaitaan","শয়তান"],["كَانَ","kāna","is","হলো"],["لِلرَّحْمَـٰنِ","lilrraḥmāni","to the Most Gracious","দয়াময়ের"],["عَصِيًّۭا","‘aṣiyyan","disobedient","অবাধ্য"]],"t":"<o>يَٰٓ</>أَبَتِ لَا تَعْبُدِ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نَ ۖ إِ<g>نَّ</> <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نَ كَانَ لِلرَّحْ<m>مَٰ</>نِ عَصِيًّۭا"},{"n":45,"w":[["يَـٰٓأَبَتِ","yāabati","O my father","হে আমার পিতা"],["إِنِّىٓ","innī","Indeed, I","নিশ্চয়ই আমি"],["أَخَافُ","akhāfu","[I] fear","ভয় করি আমি"],["أَن","an","that","যে"],["يَمَسَّكَ","yamassaka","will touch you","আপনাকে স্পর্শ করবে"],["عَذَابٌۭ","‘adhābun","a punishment","শাস্তি"],["مِّنَ","mina","from","থেকে"],["ٱلرَّحْمَـٰنِ","l-raḥmāni","the Most Gracious","দয়াময়ের"],["فَتَكُونَ","fatakūna","so you would be","অতঃপর আপনি হবেন"],["لِلشَّيْطَـٰنِ","lilshayṭāni","to the Shaitaan","শয়তানের জন্য"],["وَلِيًّۭا","waliyyan","a friend","বন্ধু\""]],"t":"<o>يَٰٓ</>أَبَتِ إِ<g>نِّ</><o>ىٓ</> أَخَافُ <d>أَن يَ</>مَسَّكَ عَذَا<d>بٌۭ مِّ</>نَ <h>ٱ</><l>ل</>رَّحْ<m>مَٰ</>نِ فَتَكُونَ لِلشَّيْ<m>طَٰ</>نِ وَلِيًّۭا"},{"n":46,"w":[["قَالَ","qāla","He said","সে বললো"],["أَرَاغِبٌ","arāghibun","Do you hate","\"কি বিমুখ"],["أَنتَ","anta","Do you hate","\"তুমি"],["عَنْ","‘an","(from)","হ'তে"],["ءَالِهَتِى","ālihatī","my gods","আমার দেব-দেবীগুলো"],["يَـٰٓإِبْرَٰهِيمُ ۖ","yāib'rāhīmu","O Ibrahim","হে ইবরাহীম"],["لَئِن","la-in","Surely, if","অবশ্যই যদি"],["لَّمْ","lam","not","না"],["تَنتَهِ","tantahi","you desist","বিরত হও তুমি"],["لَأَرْجُمَنَّكَ ۖ","la-arjumannaka","surely, I will stone you","অবশ্যই তোমাকে পাথর মেরে হত্যা করবোই"],["وَٱهْجُرْنِى","wa-uh'jur'nī","so leave me","এবং আমাকে ছেড়ে চলে যাও"],["مَلِيًّۭا","maliyyan","(for) a prolonged time","চিরতরে\""]],"t":"قَالَ أَرَاغِبٌ أَ<k>نتَ</> عَنْ ءَالِهَتِى <o>يَٰٓ</>إِ<q>بْ</><m>رَٰ</>هِيمُ ۖ لَ<w>ئِن لَّ</>مْ تَ<k>نتَ</>هِ لَأَرْجُمَ<g>نَّ</>كَ ۖ وَ<h>ٱ</>هْجُرْنِى مَلِيًّۭا"},{"n":47,"w":[["قَالَ","qāla","He said","সে বললো"],["سَلَـٰمٌ","salāmun","Peace (be)","\"শান্তি (সালাম)"],["عَلَيْكَ ۖ","‘alayka","on you","আপনার উপর"],["سَأَسْتَغْفِرُ","sa-astaghfiru","I will ask forgiveness","অচিরেই ক্ষমা চাইবো আমি"],["لَكَ","laka","for you","আপনার জন্য"],["رَبِّىٓ ۖ","rabbī","(from) my Lord","আমার রবের কাছে"],["إِنَّهُۥ","innahu","Indeed, He","নিশ্চয়ই তিনি"],["كَانَ","kāna","is","হলেন"],["بِى","bī","to me","আমার প্রতি"],["حَفِيًّۭا","ḥafiyyan","Ever Gracious","অনুগ্রহশীল"]],"t":"قَالَ سَ<m>لَٰ</>مٌ عَلَيْكَ ۖ سَأَسْتَغْفِرُ لَكَ رَ<o>بِّىٓ ۖ</> إِ<g>نَّ</>هُ<m>ۥ</> كَانَ بِى حَفِيًّۭا"},{"n":48,"w":[["وَأَعْتَزِلُكُمْ","wa-a‘tazilukum","And I will leave you","এবং আপনাদের থেকে আমি পৃথক হচ্ছি"],["وَمَا","wamā","and what","এবং যাদেরকে"],["تَدْعُونَ","tad‘ūna","you invoke","আপনারা ডাকেন"],["مِن","min","besides","থেকে"],["دُونِ","dūni","besides","ছাড়া"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌"],["وَأَدْعُوا۟","wa-ad‘ū","and I will invoke","এবং ডাকবো আমি"],["رَبِّى","rabbī","my Lord","আমার রবকে"],["عَسَىٰٓ","‘asā","May be","আশা করি"],["أَلَّآ","allā","that not","যে না"],["أَكُونَ","akūna","I will be","হবো আমি"],["بِدُعَآءِ","bidu‘āi","in invocation","ডাকার কারণে"],["رَبِّى","rabbī","(to) my Lord","আমার রবের"],["شَقِيًّۭا","shaqiyyan","unblessed","ব্যর্থকাম\""]],"t":"وَأَعْتَزِلُكُمْ وَمَا تَ<q>دْ</>عُونَ مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ وَأَ<q>دْ</>عُو<s>ا۟</> رَبِّى عَسَ<o>ىٰٓ</> أَ<o>لَّآ</> أَكُونَ بِدُ<o>عَآ</>ءِ رَبِّى شَقِيًّۭا"},{"n":49,"w":[["فَلَمَّا","falammā","So when","অতঃপর যখন"],["ٱعْتَزَلَهُمْ","i‘'tazalahum","he left them","তাদের থেকে পৃথক হলো সে"],["وَمَا","wamā","and what","এবং যাদের"],["يَعْبُدُونَ","ya‘budūna","they worshipped","তারা উপাসনা করতো"],["مِن","min","besides Allah","থেকে"],["دُونِ","dūni","besides Allah","ছাড়া"],["ٱللَّهِ","l-lahi","besides Allah","আল্লাহ্‌"],["وَهَبْنَا","wahabnā","[and] We bestowed","আমরা দান করলাম"],["لَهُۥٓ","lahu","[to] him","তাকে"],["إِسْحَـٰقَ","is'ḥāqa","Isaac","ইসহাককে"],["وَيَعْقُوبَ ۖ","waya‘qūba","and Yaqub","ও ইয়াকুবকে"],["وَكُلًّۭا","wakullan","and each (of them)","এবং প্রত্যেককে"],["جَعَلْنَا","ja‘alnā","We made","আমরা বানালাম"],["نَبِيًّۭا","nabiyyan","a Prophet","নাবী"]],"t":"فَلَ<g>مَّ</>ا <h>ٱ</>عْتَزَلَهُمْ وَمَا يَعْبُدُونَ مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ وَهَ<q>بْ</>نَا لَهُ<o>ۥٓ</> إِسْ<m>حَٰ</>قَ وَيَعْقُوبَ ۖ وَكُ<k>لًّۭا جَ</>عَلْنَا نَبِيًّۭا"},{"n":50,"w":[["وَوَهَبْنَا","wawahabnā","And We bestowed","এবং আমরা দান করলাম"],["لَهُم","lahum","to them","তাদের জন্য"],["مِّن","min","of","থেকে"],["رَّحْمَتِنَا","raḥmatinā","Our Mercy","আমাদের অনুগ্রহ"],["وَجَعَلْنَا","waja‘alnā","and We made","এবং আমরা দিলাম"],["لَهُمْ","lahum","for them","তাদের জন্য"],["لِسَانَ","lisāna","a truthful mention","ভাষা"],["صِدْقٍ","ṣid'qin","a truthful mention","সত্যের ও সুখ্যাতির"],["عَلِيًّۭا","‘aliyyan","high","সমুচ্চ"]],"t":"وَوَهَ<q>بْ</>نَا لَ<y>هُم مِّ</><w>ن رَّ</>حْمَتِنَا وَجَعَلْنَا لَهُمْ لِسَانَ صِ<q>دْ</>قٍ عَلِيًّۭا"},{"n":51,"w":[["وَٱذْكُرْ","wa-udh'kur","And mention","উল্লেখ করো (যা)"],["فِى","fī","in","মধ্যে (বলা হচ্ছে)"],["ٱلْكِتَـٰبِ","l-kitābi","the Book","(এই) কিতাবের"],["مُوسَىٰٓ ۚ","mūsā","Musa","মূসা (সম্পর্কে)"],["إِنَّهُۥ","innahu","Indeed, he","সে নিশ্চয়ই"],["كَانَ","kāna","was","ছিলো"],["مُخْلَصًۭا","mukh'laṣan","chosen","বিশুদ্ধচিত্ত"],["وَكَانَ","wakāna","and was","এবং ছিলো"],["رَسُولًۭا","rasūlan","a Messenger","রাসূল"],["نَّبِيًّۭا","nabiyyan","a Prophet","নাবী"]],"t":"وَ<h>ٱ</>ذْكُرْ فِى <h>ٱ</>لْكِ<m>تَٰ</>بِ مُوسَ<o>ىٰٓ ۚ</> إِ<g>نَّ</>هُ<m>ۥ</> كَانَ مُخْلَ<d>صًۭا وَ</>كَانَ رَسُولًۭ<d>ا نَّ</>بِيًّۭا"},{"n":52,"w":[["وَنَـٰدَيْنَـٰهُ","wanādaynāhu","And We called him","এবং তাকে আমরা ডেকেছি"],["مِن","min","from","হ'তে"],["جَانِبِ","jānibi","(the) side","দিক"],["ٱلطُّورِ","l-ṭūri","(of) the Mount","তুর (পাহাড়ের)"],["ٱلْأَيْمَنِ","l-aymani","the right","ডান (দিক)"],["وَقَرَّبْنَـٰهُ","waqarrabnāhu","and brought him near","এবং তাকে আমরা কাছে টেনেছিলাম"],["نَجِيًّۭا","najiyyan","(for) conversation","অন্তরঙ্গ আলাপের জন্যে"]],"t":"وَ<m>نَٰ</>دَيْ<m>نَٰ</>هُ مِ<k>ن جَ</>انِبِ <h>ٱ</><l>ل</>طُّورِ <h>ٱ</>لْأَيْمَنِ وَقَرَّ<q>بْ</><m>نَٰ</>هُ نَجِيًّۭا"},{"n":53,"w":[["وَوَهَبْنَا","wawahabnā","And We bestowed","এবং আমরা বানালাম"],["لَهُۥ","lahu","[to] him","তার জন্যে"],["مِن","min","from","হ'তে"],["رَّحْمَتِنَآ","raḥmatinā","Our Mercy","আমাদের অনুগ্রহ"],["أَخَاهُ","akhāhu","his brother","তার ভাই"],["هَـٰرُونَ","hārūna","Harun","হারুনকে"],["نَبِيًّۭا","nabiyyan","a Prophet","নাবীরূপে"]],"t":"وَوَهَ<q>بْ</>نَا لَهُ<m>ۥ</> <w>مِن رَّ</>حْمَتِ<o>نَآ</> أَخَاهُ <m>هَٰ</>رُونَ نَبِيًّۭا"},{"n":54,"w":[["وَٱذْكُرْ","wa-udh'kur","And mention","এবং স্মরণ করো"],["فِى","fī","in","মধ্যে"],["ٱلْكِتَـٰبِ","l-kitābi","the Book","কিতাবের"],["إِسْمَـٰعِيلَ ۚ","is'mā‘īla","Ishmael","ইসমাইলকে"],["إِنَّهُۥ","innahu","Indeed, he","সে নিশ্চয়ই"],["كَانَ","kāna","was","ছিলো"],["صَادِقَ","ṣādiqa","true","সত্যতা রক্ষাকারী"],["ٱلْوَعْدِ","l-wa‘di","(to his) promise","প্রতিশ্রুতির"],["وَكَانَ","wakāna","and was","এবং ছিলো"],["رَسُولًۭا","rasūlan","a Messenger ","রাসূল"],["نَّبِيًّۭا","nabiyyan","a Prophet","নাবী"]],"t":"وَ<h>ٱ</>ذْكُرْ فِى <h>ٱ</>لْكِ<m>تَٰ</>بِ إِسْ<m>مَٰ</>عِيلَ ۚ إِ<g>نَّ</>هُ<m>ۥ</> كَانَ صَادِقَ <h>ٱ</>لْوَعْدِ وَكَانَ رَسُولًۭ<d>ا نَّ</>بِيًّۭا"},{"n":55,"w":[["وَكَانَ","wakāna","And he used","এবং"],["يَأْمُرُ","yamuru","(to) enjoin","আদেশ দিতো"],["أَهْلَهُۥ","ahlahu","(on) his people","তার পরিজনবর্গকে"],["بِٱلصَّلَوٰةِ","bil-ṣalati","the prayer","সালাতের ব্যাপারে"],["وَٱلزَّكَوٰةِ","wal-zakati","and zakah","ও যাকাতের"],["وَكَانَ","wakāna","and was","এবং সে ছিলো"],["عِندَ","‘inda","near","কাছে"],["رَبِّهِۦ","rabbihi","his Lord","তার রবের"],["مَرْضِيًّۭا","marḍiyyan","pleasing","প্রিয়পাত্র"]],"t":"وَكَانَ يَأْمُرُ أَهْلَهُ<m>ۥ</> بِ<h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةِ وَ<h>ٱ</><l>ل</>زَّكَ<s>وٰ</>ةِ وَكَانَ عِ<k>ندَ</> رَبِّ<m>هِۦ</> مَرْضِيًّۭا"},{"n":56,"w":[["وَٱذْكُرْ","wa-udh'kur","And mention","এবং উল্লেখ করো (যা)"],["فِى","fī","in","মধ্যে (বলা হচ্ছে)"],["ٱلْكِتَـٰبِ","l-kitābi","the Book","(এই) কিতাবের"],["إِدْرِيسَ ۚ","id'rīsa","Idris","ইদরীস (সম্পর্কে)"],["إِنَّهُۥ","innahu","Indeed, he","সে নিশ্চয়ই"],["كَانَ","kāna","was","ছিলো"],["صِدِّيقًۭا","ṣiddīqan","truthful","সত্যনিষ্ঠ"],["نَّبِيًّۭا","nabiyyan","a Prophet","নাবী"]],"t":"وَ<h>ٱ</>ذْكُرْ فِى <h>ٱ</>لْكِ<m>تَٰ</>بِ إِ<q>دْ</>رِيسَ ۚ إِ<g>نَّ</>هُ<m>ۥ</> كَانَ صِدِّي<d>قًۭا نَّ</>بِيًّۭا"},{"n":57,"w":[["وَرَفَعْنَـٰهُ","warafa‘nāhu","And We raised him","এবং তাকে আমরা উন্নীত করেছিলাম"],["مَكَانًا","makānan","(to) a position","স্থানে"],["عَلِيًّا","‘aliyyan","high","উচ্চতর"]],"t":"وَرَفَعْ<m>نَٰ</>هُ مَكَانًا عَلِيًّا"},{"n":58,"w":[["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব লোক"],["ٱلَّذِينَ","alladhīna","(were) the ones whom","যাদের"],["أَنْعَمَ","an‘ama","Allah bestowed favor","অনুগ্রহ করেছেন"],["ٱللَّهُ","l-lahu","Allah bestowed favor","আল্লাহ্‌"],["عَلَيْهِم","‘alayhim","upon them","তাদের উপর"],["مِّنَ","mina","from (among)","মধ্যে"],["ٱلنَّبِيِّـۧنَ","l-nabiyīna","the Prophets","নাবীদের"],["مِن","min","of","মধ্য হ'তে"],["ذُرِّيَّةِ","dhurriyyati","(the) offspring","বংশধর"],["ءَادَمَ","ādama","(of) Adam","আদমের"],["وَمِمَّنْ","wamimman","and of those","এবং মধ্য হ'তে যাদের"],["حَمَلْنَا","ḥamalnā","We carried","আমরা আরোহণ করিয়েছিলাম"],["مَعَ","ma‘a","with","সাথে"],["نُوحٍۢ","nūḥin","Nuh","নূহের"],["وَمِن","wamin","and of","এবং মধ্য হ'তে"],["ذُرِّيَّةِ","dhurriyyati","(the) offspring","বংশধর"],["إِبْرَٰهِيمَ","ib'rāhīma","(of) Ibrahim","ইবরাহীমের"],["وَإِسْرَٰٓءِيلَ","wa-is'rāīla","and Israel","ও ইসরাঈলের"],["وَمِمَّنْ","wamimman","and of (those) whom","এবং মধ্য হ'তে (তাদের)"],["هَدَيْنَا","hadaynā","We guided","আমরা পথ দেখিয়েছিলাম"],["وَٱجْتَبَيْنَآ ۚ","wa-ij'tabaynā","and We chose","ও আমরা মনোনীত করেছিলাম"],["إِذَا","idhā","When","যখন"],["تُتْلَىٰ","tut'lā","were recited","পাঠ করা হতো"],["عَلَيْهِمْ","‘alayhim","to them","তাদের কাছে"],["ءَايَـٰتُ","āyātu","(the) Verses","আয়াতসমূহ"],["ٱلرَّحْمَـٰنِ","l-raḥmāni","(of) the Most Gracious","দয়াময়ের"],["خَرُّوا۟","kharrū","they fell","তারা নুয়ে পড়তো"],["سُجَّدًۭا","sujjadan","prostrating","সিজদায়"],["وَبُكِيًّۭا ۩","wabukiyyan","and weeping","এবং (তখন) কান্নারত হতো"]],"t":"أُ<s>و۟</><o>لَٰٓ</>ئِكَ <h>ٱ</>لَّذِينَ أَنْعَمَ <h>ٱ</>للَّهُ عَلَيْ<y>هِم مِّ</>نَ <h>ٱ</><l>ل</><g>نَّ</>بِيِّۦنَ مِ<k>ن ذُ</>رِّيَّةِ ءَادَمَ وَمِ<g>مَّ</>نْ حَمَلْنَا مَعَ نُو<d>حٍۢ وَ</>مِ<k>ن ذُ</>رِّيَّةِ إِ<q>بْ</><m>رَٰ</>هِيمَ وَإِسْ<o>رَٰٓ</>ءِيلَ وَمِ<g>مَّ</>نْ هَدَيْنَا وَ<h>ٱ</><q>جْ</>تَبَيْ<o>نَآ ۚ</> إِذَا تُتْلَىٰ عَلَيْهِمْ ءَا<m>يَٰ</>تُ <h>ٱ</><l>ل</>رَّحْ<m>مَٰ</>نِ خَرُّو<s>ا۟</> سُجَّ<d>دًۭا وَ</>بُكِيًّۭا ۩"},{"n":59,"w":[["۞ فَخَلَفَ","fakhalafa","Then succeeded","অতঃপর স্থলাভিষিক্ত হলো"],["مِنۢ","min","after them","থেকে"],["بَعْدِهِمْ","ba‘dihim","after them","পর তাদের"],["خَلْفٌ","khalfun","successors","পরবর্তীরা"],["أَضَاعُوا۟","aḍā‘ū","who neglected","তারা নষ্ট করলো"],["ٱلصَّلَوٰةَ","l-ṣalata","the prayer","সালাত"],["وَٱتَّبَعُوا۟","wa-ittaba‘ū","and they followed","ও অনুসরণ করলো"],["ٱلشَّهَوَٰتِ ۖ","l-shahawāti","the lusts","কুপ্রবৃত্তির"],["فَسَوْفَ","fasawfa","so soon","সুতরাং শীঘ্রই"],["يَلْقَوْنَ","yalqawna","they will meet","তারা দেখবে"],["غَيًّا","ghayyan","evil","কুকর্মের (শাস্তি)"]],"t":"۞ فَخَلَفَ <i>مِنۢ بَ</>عْدِهِمْ خَلْفٌ أَضَاعُو<s>ا۟</> <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةَ وَ<h>ٱ</>تَّبَعُو<s>ا۟</> <h>ٱ</><l>ل</>شَّهَ<m>وَٰ</>تِ ۖ فَسَوْفَ يَلْقَوْنَ غَيًّا"},{"n":60,"w":[["إِلَّا","illā","Except","কিন্তু"],["مَن","man","(one) who","যারা"],["تَابَ","tāba","repented","করেছে তওবা"],["وَءَامَنَ","waāmana","and believed","ও ঈমান এনেছে"],["وَعَمِلَ","wa‘amila","and did","ও কাজ করেছে"],["صَـٰلِحًۭا","ṣāliḥan","good (deeds)","সৎ"],["فَأُو۟لَـٰٓئِكَ","fa-ulāika","Then those","অতঃপর ঐসব লোক"],["يَدْخُلُونَ","yadkhulūna","will enter","তারা প্রবেশ করবে"],["ٱلْجَنَّةَ","l-janata","Paradise","জান্নাতে"],["وَلَا","walā","and not","এবং না"],["يُظْلَمُونَ","yuẓ'lamūna","they will be wronged","অন্যায় করা হবে"],["شَيْـًۭٔا","shayan","(in) anything","কিছুমাত্রও"]],"t":"إِلَّا مَ<k>ن تَ</>ابَ وَءَامَنَ وَعَمِلَ <m>صَٰ</>لِ<k>حًۭا فَ</>أُ<s>و۟</><o>لَٰٓ</>ئِكَ يَ<q>دْ</>خُلُونَ <h>ٱ</>لْجَ<g>نَّ</>ةَ وَلَا يُظْلَمُونَ شَيْـًۭٔا"},{"n":61,"w":[["جَنَّـٰتِ","jannāti","Gardens","জান্নাত"],["عَدْنٍ","‘adnin","(of) Eden","স্থায়ী"],["ٱلَّتِى","allatī","which","যার"],["وَعَدَ","wa‘ada","promised","প্রতিশ্রুতি দিয়েছেন"],["ٱلرَّحْمَـٰنُ","l-raḥmānu","the Most Gracious","দয়াময়"],["عِبَادَهُۥ","‘ibādahu","(to) His slaves","তাঁর দাসদেরকে"],["بِٱلْغَيْبِ ۚ","bil-ghaybi","in the unseen","গোপনভাবে"],["إِنَّهُۥ","innahu","Indeed, [it]","তিনি নিশ্চয়ই (এমন যে)"],["كَانَ","kāna","is","হলো"],["وَعْدُهُۥ","wa‘duhu","His promise","তাঁর প্রতিশ্রুতি"],["مَأْتِيًّۭا","matiyyan","sure to come","অবশ্যম্ভাবী"]],"t":"جَ<g>نَّٰ</>تِ عَ<q>دْ</>نٍ <h>ٱ</>لَّتِى وَعَدَ <h>ٱ</><l>ل</>رَّحْ<m>مَٰ</>نُ عِبَادَهُ<m>ۥ</> بِ<h>ٱ</>لْغَيْبِ ۚ إِ<g>نَّ</>هُ<m>ۥ</> كَانَ وَعْدُهُ<m>ۥ</> مَأْتِيًّۭا"},{"n":62,"w":[["لَّا","lā","Not","না"],["يَسْمَعُونَ","yasma‘ūna","they will hear","তারা শুনবে"],["فِيهَا","fīhā","therein","তার মধ্যে"],["لَغْوًا","laghwan","vain talk","নিরর্থক কথা"],["إِلَّا","illā","but","এ ছাড়া"],["سَلَـٰمًۭا ۖ","salāman","peace","শান্তি"],["وَلَهُمْ","walahum","And for them","এবং তাদের জন্য থাকবে"],["رِزْقُهُمْ","riz'quhum","(is) their provision","তাদের জীবিকা"],["فِيهَا","fīhā","therein","তার মধ্যে"],["بُكْرَةًۭ","buk'ratan","morning","সকালে"],["وَعَشِيًّۭا","wa‘ashiyyan","and evening","ও সন্ধ্যায়"]],"t":"لَّا يَسْمَعُونَ فِيهَا لَغْوًا إِلَّا سَ<m>لَٰ</><d>مًۭا ۖ وَ</>لَهُمْ رِزْقُهُمْ فِيهَا بُكْرَ<d>ةًۭ وَ</>عَشِيًّۭا"},{"n":63,"w":[["تِلْكَ","til'ka","This","এই"],["ٱلْجَنَّةُ","l-janatu","(is) Paradise","জান্নাত"],["ٱلَّتِى","allatī","which","যার"],["نُورِثُ","nūrithu","We give (as) inheritance","আমরা করবো উত্তরাধিকারী"],["مِنْ","min","[of] (to)","মধ্য হ'তে"],["عِبَادِنَا","‘ibādinā","Our slaves","আমাদের দাসদের"],["مَن","man","(the one) who","যে"],["كَانَ","kāna","is","হবে"],["تَقِيًّۭا","taqiyyan","righteous","মুত্তাকী"]],"t":"تِلْكَ <h>ٱ</>لْجَ<g>نَّ</>ةُ <h>ٱ</>لَّتِى نُورِثُ مِنْ عِبَادِنَا مَ<k>ن كَ</>انَ تَقِيًّۭا"},{"n":64,"w":[["وَمَا","wamā","And not","এবং (হে নাবী) না"],["نَتَنَزَّلُ","natanazzalu","we descend","আমরা অবতরণ করি"],["إِلَّا","illā","except","এ ছাড়া"],["بِأَمْرِ","bi-amri","by (the) Command","নির্দেশক্রমে"],["رَبِّكَ ۖ","rabbika","(of) your Lord","আপনার রবের"],["لَهُۥ","lahu","To Him (belongs)","তাঁরই জন্য (মালিকানায়)"],["مَا","mā","what","যা কিছু (আছে)"],["بَيْنَ","bayna","(is) before us","সামনে"],["أَيْدِينَا","aydīnā","(is) before us","আমাদের হাতের"],["وَمَا","wamā","and what","ও যা কিছু (আছে)"],["خَلْفَنَا","khalfanā","(is) behind us","আমাদের পিছনে"],["وَمَا","wamā","and what","এবং যা কিছু (আছে)"],["بَيْنَ","bayna","(is) between","মাঝে"],["ذَٰلِكَ ۚ","dhālika","that","এর"],["وَمَا","wamā","And not","এবং না"],["كَانَ","kāna","is","হলেন"],["رَبُّكَ","rabbuka","your Lord","আপনার রব (এমন যে)"],["نَسِيًّۭا","nasiyyan","forgetful","ভুলে যান"]],"t":"وَمَا نَتَنَزَّلُ إِلَّا بِأَمْرِ رَبِّكَ ۖ لَهُ<m>ۥ</> مَا بَيْنَ أَيْدِينَا وَمَا خَلْفَنَا وَمَا بَيْنَ <m>ذَٰ</>لِكَ ۚ وَمَا كَانَ رَبُّكَ نَسِيًّۭا"},{"n":65,"w":[["رَّبُّ","rabbu","Lord","রব"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশের"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীর"],["وَمَا","wamā","and whatever","এবং যা কিছু (আছে)"],["بَيْنَهُمَا","baynahumā","(is) between both of them","উভয়ের মাঝে"],["فَٱعْبُدْهُ","fa-u‘'bud'hu","so worship Him","তাঁরই সুতরাং ইবাদাত করুন"],["وَٱصْطَبِرْ","wa-iṣ'ṭabir","and be constant","এবং ধৈর্য্য ধরুন"],["لِعِبَـٰدَتِهِۦ ۚ","li‘ibādatihi","in His worship","তাঁর ইবাদাতের উপর"],["هَلْ","hal","Do","কি"],["تَعْلَمُ","ta‘lamu","you know","জানেন আপনি (কাউকে)"],["لَهُۥ","lahu","for Him","তাঁর জন্য"],["سَمِيًّۭا","samiyyan","any similarity","সমমান (গুণসম্পন্ন)"]],"t":"رَّبُّ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ وَمَا بَيْنَهُمَا فَ<h>ٱ</>عْبُ<q>دْ</>هُ وَ<h>ٱ</>صْطَبِرْ لِعِ<m>بَٰ</>دَتِ<m>هِۦ</> ۚ هَلْ تَعْلَمُ لَهُ<m>ۥ</> سَمِيًّۭا"},{"n":66,"w":[["وَيَقُولُ","wayaqūlu","And says","এবং বলে"],["ٱلْإِنسَـٰنُ","l-insānu","[the] man","মানুষ"],["أَءِذَا","a-idhā","What! When","\"যখন কি"],["مَا","mā","What! When","\""],["مِتُّ","mittu","I am dead","আমি মরে যাব"],["لَسَوْفَ","lasawfa","surely will","অচিরেই অবশ্যই"],["أُخْرَجُ","ukh'raju","I be brought forth","আমাকে বের করা হবে"],["حَيًّا","ḥayyan","alive","জীবিত অবস্থায়\""]],"t":"وَيَقُولُ <h>ٱ</>لْإِ<k>نسَٰ</>نُ أَءِذَا مَا مِتُّ لَسَوْفَ أُخْرَجُ حَيًّا"},{"n":67,"w":[["أَوَلَا","awalā","Does not","কি না"],["يَذْكُرُ","yadhkuru","remember","স্মরণ করে"],["ٱلْإِنسَـٰنُ","l-insānu","[the] man","মানুষ"],["أَنَّا","annā","that We","যে আমরা"],["خَلَقْنَـٰهُ","khalaqnāhu","We created him","তাকে আমরা সৃষ্টি করেছি"],["مِن","min","before","থেকে"],["قَبْلُ","qablu","before","ইতিপূর্ব"],["وَلَمْ","walam","while not","যখন না"],["يَكُ","yaku","he was","সে ছিলো"],["شَيْـًۭٔا","shayan","anything","কোন কিছুই"]],"t":"أَوَلَا يَذْكُرُ <h>ٱ</>لْإِ<k>نسَٰ</>نُ أَ<g>نَّ</>ا خَلَ<q>قْ</><m>نَٰ</>هُ مِ<k>ن قَ</><q>بْ</>لُ وَلَمْ يَكُ شَيْـًۭٔا"},{"n":68,"w":[["فَوَرَبِّكَ","fawarabbika","So by your Lord","সুতরাং শপথ তোমার রবের"],["لَنَحْشُرَنَّهُمْ","lanaḥshurannahum","surely, We will gather them","অবশ্যই তাদের জড়ো করবো আমরা"],["وَٱلشَّيَـٰطِينَ","wal-shayāṭīna","and the devils","এবং শয়তানদেরকেও"],["ثُمَّ","thumma","then","এরপর"],["لَنُحْضِرَنَّهُمْ","lanuḥ'ḍirannahum","surely, We will bring them","অবশ্যই তাদের উপস্থিত করবো আমরা"],["حَوْلَ","ḥawla","around","চারদিকে"],["جَهَنَّمَ","jahannama","Hell","জাহান্নামের"],["جِثِيًّۭا","jithiyyan","bent (on) knees","নতজানু অবস্থায়"]],"t":"فَوَرَبِّكَ لَنَحْشُرَ<g>نَّ</>هُمْ وَ<h>ٱ</><l>ل</>شَّ<m>يَٰ</>طِينَ ثُ<g>مَّ</> لَنُحْضِرَ<g>نَّ</>هُمْ حَوْلَ جَهَ<g>نَّ</>مَ جِثِيًّۭا"},{"n":69,"w":[["ثُمَّ","thumma","Then","এরপর"],["لَنَنزِعَنَّ","lananzi‘anna","surely, We will drag out","অবশ্যই আমরা টেনে বের করবো"],["مِن","min","from","মধ্য হতে"],["كُلِّ","kulli","every","প্রত্যেক বিষয়ে"],["شِيعَةٍ","shī‘atin","sect","দলের"],["أَيُّهُمْ","ayyuhum","those of them","তাদের কোন (ব্যক্তি)"],["أَشَدُّ","ashaddu","(who were) worst","সর্বাধিক"],["عَلَى","‘alā","against","প্রতি"],["ٱلرَّحْمَـٰنِ","l-raḥmāni","the Most Gracious","দয়াময়ের"],["عِتِيًّۭا","‘itiyyan","(in) rebellion","অবাধ্য"]],"t":"ثُ<g>مَّ</> لَنَ<k>نزِ</>عَ<g>نَّ</> مِ<k>ن كُ</>لِّ شِيعَةٍ أَيُّهُمْ أَشَدُّ عَلَى <h>ٱ</><l>ل</>رَّحْ<m>مَٰ</>نِ عِتِيًّۭا"},{"n":70,"w":[["ثُمَّ","thumma","Then","এরপর"],["لَنَحْنُ","lanaḥnu","surely, We","অবশ্যই আমরা"],["أَعْلَمُ","a‘lamu","know best","খুব জানি"],["بِٱلَّذِينَ","bi-alladhīna","[of] those who","তাদের"],["هُمْ","hum","[they]","যারা"],["أَوْلَىٰ","awlā","(are) most worthy","অধিকতর যোগ্য"],["بِهَا","bihā","therein","তাঁতে"],["صِلِيًّۭا","ṣiliyyan","(of) being burnt","প্রবেশের (জন্যে)"]],"t":"ثُ<g>مَّ</> لَنَحْنُ أَعْلَمُ بِ<h>ٱ</>لَّذِينَ هُمْ أَوْلَىٰ بِهَا صِلِيًّۭا"},{"n":71,"w":[["وَإِن","wa-in","And (there is) not","এবং নেই"],["مِّنكُمْ","minkum","(any) of you","তোমাদের মধ্যে কেউ"],["إِلَّا","illā","but","এ ছাড়া"],["وَارِدُهَا ۚ","wāriduhā","(will be) passing over it","অতিক্রমকারী তা"],["كَانَ","kāna","(This) is","(এটা) হলো"],["عَلَىٰ","‘alā","upon","কাছে"],["رَبِّكَ","rabbika","your Lord","তোমার রবের"],["حَتْمًۭا","ḥatman","an inevitability","চুড়ান্ত"],["مَّقْضِيًّۭا","maqḍiyyan","decreed","অনিবার্য"]],"t":"وَ<d>إِن مِّ</><k>نكُ</>مْ إِلَّا وَارِدُهَا ۚ كَانَ عَلَىٰ رَبِّكَ حَتْ<d>مًۭا مَّ</><q>قْ</>ضِيًّۭا"},{"n":72,"w":[["ثُمَّ","thumma","Then","এরপর"],["نُنَجِّى","nunajjī","We will deliver","উদ্ধার করবো আমরা"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["ٱتَّقَوا۟","ittaqaw","feared (Allah)","তাকওয়া অবলম্বন করেছে"],["وَّنَذَرُ","wanadharu","and We will leave","ও রেখে দিবো আমরা"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","সীমালঙ্ঘনকারীদেরকে"],["فِيهَا","fīhā","therein","তার মধ্যে"],["جِثِيًّۭا","jithiyyan","bent (on) knees","নতজানু অবস্থায়"]],"t":"ثُ<g>مَّ</> نُنَجِّى <h>ٱ</>لَّذِينَ <h>ٱ</>تَّقَو<s>ا۟</> وَّنَذَرُ <h>ٱ</><l>ل</><m>ظَّٰ</>لِمِينَ فِيهَا جِثِيًّۭا"},{"n":73,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["تُتْلَىٰ","tut'lā","are recited","আবৃত্তি করা হয়"],["عَلَيْهِمْ","‘alayhim","to them","তাদের কাছে"],["ءَايَـٰتُنَا","āyātunā","Our Verses","আমাদের আয়াতসমূহ"],["بَيِّنَـٰتٍۢ","bayyinātin","clear","সুস্পষ্ট"],["قَالَ","qāla","say","বলে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieved","অস্বীকার করেছে"],["لِلَّذِينَ","lilladhīna","to those who","(তাদের) কে যারা"],["ءَامَنُوٓا۟","āmanū","believed","ঈমান এনেছে"],["أَىُّ","ayyu","Which","\"কোনটি"],["ٱلْفَرِيقَيْنِ","l-farīqayni","(of) the two groups","দু'দলের"],["خَيْرٌۭ","khayrun","(is) better","উত্তম"],["مَّقَامًۭا","maqāman","(in) position","মর্যাদায়"],["وَأَحْسَنُ","wa-aḥsanu","and best","ও শ্রেষ্ঠতর (জাগজমকপূর্ণ)"],["نَدِيًّۭا","nadiyyan","(in) assembly","সমাজ হিসেবে\""]],"t":"وَإِذَا تُتْلَىٰ عَلَيْهِمْ ءَا<m>يَٰ</>تُنَا بَيِّ<m>نَٰ</><k>تٍۢ قَ</>الَ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> لِلَّذِينَ ءَامَ<o>نُوٓ</><s>ا۟</> أَىُّ <h>ٱ</>لْفَرِيقَيْنِ خَيْ<d>رٌۭ مَّ</>قَا<d>مًۭا وَ</>أَحْسَنُ نَدِيًّۭا"},{"n":74,"w":[["وَكَمْ","wakam","And how many","এবং কতই (না)"],["أَهْلَكْنَا","ahlaknā","We destroyed","আমরা ধ্বংস করেছি"],["قَبْلَهُم","qablahum","before them","তাদের পূর্বে"],["مِّن","min","of","কিছু"],["قَرْنٍ","qarnin","a generation ","মানবগোষ্ঠিকে"],["هُمْ","hum","they","তারা"],["أَحْسَنُ","aḥsanu","(were) better","(ছিলো) উত্তম"],["أَثَـٰثًۭا","athāthan","(in) possessions","সম্পদে (সাজ সরঞ্জামে)"],["وَرِءْيًۭا","wari'yan","and appearance","এবং (চাকচিক্যে) বাহ্যদৃষ্টিতে"]],"t":"وَكَمْ أَهْلَكْنَا قَ<q>بْ</>لَ<y>هُم مِّ</><k>ن قَ</>رْنٍ هُمْ أَحْسَنُ أَ<m>ثَٰ</><d>ثًۭا وَ</>رِءْيًۭا"},{"n":75,"w":[["قُلْ","qul","Say","বলো"],["مَن","man","Whoever","\"যে"],["كَانَ","kāna","is","হবে"],["فِى","fī","in","মধ্যে"],["ٱلضَّلَـٰلَةِ","l-ḍalālati","[the] error","বিভ্রান্তির"],["فَلْيَمْدُدْ","falyamdud","then surely will extend","সেক্ষেত্রে অবকাশ  দিবেন"],["لَهُ","lahu","for him","তার জন্য"],["ٱلرَّحْمَـٰنُ","l-raḥmānu","the Most Gracious","দয়াময়"],["مَدًّا ۚ","maddan","an extension","(অনেক) অবকাশ"],["حَتَّىٰٓ","ḥattā","until","শেষ পর্যন্ত"],["إِذَا","idhā","when","যখন"],["رَأَوْا۟","ra-aw","they see","তারা দেখবে"],["مَا","mā","what","যা"],["يُوعَدُونَ","yū‘adūna","they were promised","তাদের প্রতিশ্রুতি দেয়া হয়েছে"],["إِمَّا","immā","either","হয়"],["ٱلْعَذَابَ","l-‘adhāba","the punishment","শাস্তি"],["وَإِمَّا","wa-immā","or","আর না হয়"],["ٱلسَّاعَةَ","l-sā‘ata","the Hour","ক্বিয়ামাতের সময়"],["فَسَيَعْلَمُونَ","fasaya‘lamūna","then they will know","অচিরেই তখন তারা জানবে"],["مَنْ","man","who","কে"],["هُوَ","huwa","[he]","সে"],["شَرٌّۭ","sharrun","(is) worst","নিকৃষ্ট"],["مَّكَانًۭا","makānan","(in) position","মর্যাদায়"],["وَأَضْعَفُ","wa-aḍ‘afu","and weaker","ও দুর্বলতর"],["جُندًۭا","jundan","(in) forces","দলবলে (সৈন্য সামন্তে)\""]],"t":"قُلْ مَ<k>ن كَ</>انَ فِى <h>ٱ</><l>ل</>ضَّ<m>لَٰ</>لَةِ فَلْيَمْدُ<q>دْ</> لَهُ <h>ٱ</><l>