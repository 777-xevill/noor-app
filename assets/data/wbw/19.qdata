","is appropriate","শোভা পায়"],["لِلرَّحْمَـٰنِ","lilrraḥmāni","for the Most Gracious","দয়াময়ের জন্য"],["أَن","an","that","যে"],["يَتَّخِذَ","yattakhidha","He should take","তিনি গ্রহণ করবেন"],["وَلَدًا","waladan","a son","পুত্র"]],"t":"وَمَا يَ<i>نۢبَ</>غِى لِلرَّحْ<m>مَٰ</>نِ <d>أَن يَ</>تَّخِذَ وَلَدًا"},{"n":93,"w":[["إِن","in","Not","নেই"],["كُلُّ","kullu","all","(এমন) কেউ"],["مَن","man","who","যা কিছু"],["فِى","fī","(are) in","মধ্যে আছে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশমন্ডলীর"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীর"],["إِلَّآ","illā","but","এ ছাড়া যে"],["ءَاتِى","ātī","(will) come","উপস্থিত হবে"],["ٱلرَّحْمَـٰنِ","l-raḥmāni","(to) the Most Gracious","দয়াময়ের কাছে"],["عَبْدًۭا","‘abdan","(as) a slave","দাসরূপে"]],"t":"إِ<k>ن كُ</>لُّ مَ<k>ن فِ</>ى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ إِ<o>لَّآ</> ءَاتِى <h>ٱ</><l>ل</>رَّحْ<m>مَٰ</>نِ عَ<q>بْ</>دًۭا"},{"n":94,"w":[["لَّقَدْ","laqad","Verily","নিশ্চয়ই"],["أَحْصَىٰهُمْ","aḥṣāhum","He has enumerated them","তাদেরকে ঘিরে রেখেছেন তিনি"],["وَعَدَّهُمْ","wa‘addahum","and counted them","ও গুনে রেখেছেন তাদেরকে"],["عَدًّۭا","‘addan","a counting","গণনা করে"]],"t":"لَّقَ<q>دْ</> أَحْصَ<m>ىٰ</>هُمْ وَعَدَّهُمْ عَدًّۭا"},{"n":95,"w":[["وَكُلُّهُمْ","wakulluhum","And all of them","তাদের সকলে"],["ءَاتِيهِ","ātīhi","(will) come (to) Him","তাঁর কাছে আসবে"],["يَوْمَ","yawma","(on the) Day","দিনে"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) the Resurrection","ক্বিয়ামাতের"],["فَرْدًا","fardan","alone","একাকী"]],"t":"وَكُلُّهُمْ ءَاتِيهِ يَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ فَرْدًا"},{"n":96,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ءَامَنُوا۟","āmanū","believed","ঈমান এনেছে"],["وَعَمِلُوا۟","wa‘amilū","and did","ও কাজ করেছে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","good deeds","সৎ"],["سَيَجْعَلُ","sayaj‘alu","will bestow","অচিরেই সৃষ্টি করবেন (মানুষের মনে)"],["لَهُمُ","lahumu","for them","তাদের জন্য"],["ٱلرَّحْمَـٰنُ","l-raḥmānu","the Most Gracious","দয়াময়"],["وُدًّۭا","wuddan","affection","ভালবাসা"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ سَيَ<q>جْ</>عَلُ لَهُمُ <h>ٱ</><l>ل</>رَّحْ<m>مَٰ</>نُ وُدًّۭا"},{"n":97,"w":[["فَإِنَّمَا","fa-innamā","So, only","সুতরাং প্রকৃতপক্ষে (হে নাবী)"],["يَسَّرْنَـٰهُ","yassarnāhu","We (have) made it easy","তা আমরা সহজ করেছি"],["بِلِسَانِكَ","bilisānika","in your tongue","তোমার ভাষার মাধ্যমে"],["لِتُبَشِّرَ","litubashira","that you may give glad tidings","যেন তুমি সুসংবাদ দাও"],["بِهِ","bihi","with it","তা দিয়ে"],["ٱلْمُتَّقِينَ","l-mutaqīna","(to) the righteous","মুত্তাকীদেরকে"],["وَتُنذِرَ","watundhira","and warn","আর তুমি করো সতর্ক"],["بِهِۦ","bihi","with it","তা দিয়ে"],["قَوْمًۭا","qawman","a people","লোকদেরকে"],["لُّدًّۭا","luddan","hostile","(যারা) তর্কপ্রিয়"]],"t":"فَإِ<g>نَّ</>مَا يَسَّرْ<m>نَٰ</>هُ بِلِسَانِكَ لِتُبَشِّرَ بِهِ <h>ٱ</>لْمُتَّقِينَ وَتُ<k>نذِ</>رَ بِ<m>هِۦ</> قَوْ<w>مًۭا لُّ</>دًّۭا"},{"n":98,"w":[["وَكَمْ","wakam","And how many","এবং কতই (না)"],["أَهْلَكْنَا","ahlaknā","We (have) destroyed","আমরা ধ্বংস করেছি"],["قَبْلَهُم","qablahum","before them","তাদের পূর্বে"],["مِّن","min","of","হ'তে"],["قَرْنٍ","qarnin","a generation","মানবগোষ্ঠী"],["هَلْ","hal","Can","কি"],["تُحِسُّ","tuḥissu","you perceive","অনুভব করো (কোন চিহ্ন)"],["مِنْهُم","min'hum","of them","তাদের মধ্য হ'তে"],["مِّنْ","min","any","কোন"],["أَحَدٍ","aḥadin","one","একজনের"],["أَوْ","aw","or","অথবা"],["تَسْمَعُ","tasma‘u","hear","শুনতে পাও"],["لَهُمْ","lahum","from them","তাদের থেকে"],["رِكْزًۢا","rik'zan","a sound","কোন ক্ষীণ শব্দও"]],"t":"وَكَمْ أَهْلَكْنَا قَ<q>بْ</>لَ<y>هُم مِّ</><k>ن قَ</>رْنٍ هَلْ تُحِسُّ مِنْ<y>هُم مِّ</>نْ أَحَدٍ أَوْ تَسْمَعُ لَهُمْ رِكْزًۢا"}]}