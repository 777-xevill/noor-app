{"n":23,"a":[{"n":1,"w":[["قَدْ","qad","Indeed","নিশ্চয়ই"],["أَفْلَحَ","aflaḥa","successful","সফল হয়েছে"],["ٱلْمُؤْمِنُونَ","l-mu'minūna","(are) the believers","মু'মিনরা"]],"t":"قَ<q>دْ</> أَفْلَحَ <h>ٱ</>لْمُؤْمِ<p>نُو</>نَ"},{"n":2,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা(এমন লোক যে)"],["هُمْ","hum","[they]","তারা"],["فِى","fī","during","মধ্যে"],["صَلَاتِهِمْ","ṣalātihim","their prayers","সালাতসমূহের তাদের"],["خَـٰشِعُونَ","khāshi‘ūna","(are) humbly submissive","বিনয়ী-নম্র-ভীত"]],"t":"ٱلَّذِينَ هُمْ فِى صَلَاتِهِمْ <m>خَٰ</>شِ<p>عُو</>نَ"},{"n":3,"w":[["وَٱلَّذِينَ","wa-alladhīna","Those who","এবং যারা (বৈশিষ্ট্য হলো যে)"],["هُمْ","hum","[they]","তারা"],["عَنِ","‘ani","from","হ'তে"],["ٱللَّغْوِ","l-laghwi","the vain talk","অসার কথা কাজ"],["مُعْرِضُونَ","mu‘'riḍūna","turn away","বিরত থাকে"]],"t":"وَ<h>ٱ</>لَّذِينَ هُمْ عَنِ <h>ٱ</><l>ل</>لَّغْوِ مُعْرِ<p>ضُو</>نَ"},{"n":4,"w":[["وَٱلَّذِينَ","wa-alladhīna","Those who","এবং যারা (বৈশিষ্ট্য এও যে)"],["هُمْ","hum","[they]","তারা"],["لِلزَّكَوٰةِ","lilzzakati","of purification works","জাকাতের ব্যাপারে"],["فَـٰعِلُونَ","fā‘ilūna","(are) doers","সক্রিয়"]],"t":"وَ<h>ٱ</>لَّذِينَ هُمْ لِلزَّكَ<s>وٰ</>ةِ <m>فَٰ</>عِ<p>لُو</>نَ"},{"n":5,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা (এটাও গুণ যে)"],["هُمْ","hum","[they]","তারা"],["لِفُرُوجِهِمْ","lifurūjihim","of their modesty","জন্যে তাদের লজ্জাস্থানগুলোর"],["حَـٰفِظُونَ","ḥāfiẓūna","(are) guardians","সংরক্ষক"]],"t":"وَ<h>ٱ</>لَّذِينَ هُمْ لِفُرُوجِهِمْ <m>حَٰ</>فِ<p>ظُو</>نَ"},{"n":6,"w":[["إِلَّا","illā","Except","তবে (এটা প্রযোজ্য নয়)"],["عَلَىٰٓ","‘alā","from","উপর"],["أَزْوَٰجِهِمْ","azwājihim","their spouses","তাদের স্ত্রীদের"],["أَوْ","aw","or","বা"],["مَا","mā","what","যা"],["مَلَكَتْ","malakat","possess","মালিক হয়েছে"],["أَيْمَـٰنُهُمْ","aymānuhum","their right hands","তাদের ডান হাত (অর্থাৎ দাসী)"],["فَإِنَّهُمْ","fa-innahum","then indeed, they","নিশ্চয়ই সেক্ষেত্রে তারা"],["غَيْرُ","ghayru","(are) not","নয়"],["مَلُومِينَ","malūmīna","blameworthy","নিন্দনীয়"]],"t":"إِلَّا عَلَ<o>ىٰٓ</> أَزْ<m>وَٰ</>جِهِمْ أَوْ مَا مَلَكَتْ أَيْ<m>مَٰ</>نُهُمْ فَإِ<g>نَّ</>هُمْ غَيْرُ مَلُو<p>مِي</>نَ"},{"n":7,"w":[["فَمَنِ","famani","Then whoever","তবে যে"],["ٱبْتَغَىٰ","ib'taghā","seeks","কামনা করে"],["وَرَآءَ","warāa","beyond","বাইরে"],["ذَٰلِكَ","dhālika","that","এর"],["فَأُو۟لَـٰٓئِكَ","fa-ulāika","then those","সেক্ষেত্রে ঐসবলোক"],["هُمُ","humu","[they]","তারাই"],["ٱلْعَادُونَ","l-‘ādūna","(are) the transgressors","সীমালঙ্ঘনকারী"]],"t":"فَمَنِ <h>ٱ</><q>بْ</>تَغَىٰ وَ<o>رَآ</>ءَ <m>ذَٰ</>لِكَ فَأُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</>لْعَا<p>دُو</>نَ"},{"n":8,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা (বৈশিষ্ট হলো যে)"],["هُمْ","hum","[they]","তারা"],["لِأَمَـٰنَـٰتِهِمْ","li-amānātihim","of their trusts","জন্যে তাদের আমানতসমূহের"],["وَعَهْدِهِمْ","wa‘ahdihim","and their promise(s)","ও তাদের প্রতিশ্রুতির"],["رَٰعُونَ","rā‘ūna","(are) observers","সংরক্ষণকারী"]],"t":"وَ<h>ٱ</>لَّذِينَ هُمْ لِأَ<m>مَٰنَٰ</>تِهِمْ وَعَهْدِهِمْ <m>رَٰ</><p>عُو</>نَ"},{"n":9,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা (বৈশিষ্ট্য হলো যে)"],["هُمْ","hum","[they]","তারা"],["عَلَىٰ","‘alā","over","ক্ষেত্রে"],["صَلَوَٰتِهِمْ","ṣalawātihim","their prayers","তাদের সালাতসমুহের"],["يُحَافِظُونَ","yuḥāfiẓūna","they guard","তারা যত্ন করে"]],"t":"وَ<h>ٱ</>لَّذِينَ هُمْ عَلَىٰ صَلَ<m>وَٰ</>تِهِمْ يُحَافِ<p>ظُو</>نَ"},{"n":10,"w":[["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসবলোক"],["هُمُ","humu","[they]","তারাই"],["ٱلْوَٰرِثُونَ","l-wārithūna","(are) the inheritors","(সেই) উত্তরাধিকারী"]],"t":"أُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</>لْ<m>وَٰ</>رِ<p>ثُو</>نَ"},{"n":11,"w":[["ٱلَّذِينَ","alladhīna","Who","যা্রা"],["يَرِثُونَ","yarithūna","will inherit","উত্তরাধিকারী হয়েছে"],["ٱلْفِرْدَوْسَ","l-fir'dawsa","the Paradise","ফিরদাউসের"],["هُمْ","hum","They","তারা"],["فِيهَا","fīhā","therein","তার মধ্যে"],["خَـٰلِدُونَ","khālidūna","(will) abide forever","চিরস্থায়ী হবে"]],"t":"ٱلَّذِينَ يَرِثُونَ <h>ٱ</>لْفِرْدَوْسَ هُمْ فِيهَا <m>خَٰ</>لِ<p>دُو</>نَ"},{"n":12,"w":[["وَلَقَدْ","walaqad","And indeed","এবং নিশ্চয়ই"],["خَلَقْنَا","khalaqnā","We created","সৃষ্টি করেছি আমরা"],["ٱلْإِنسَـٰنَ","l-insāna","the humankind","মানুষকে"],["مِن","min","from","থেকে"],["سُلَـٰلَةٍۢ","sulālatin","an essence","নির্যাস"],["مِّن","min","of","থেকে"],["طِينٍۢ","ṭīnin","clay","মাটির"]],"t":"وَلَقَ<q>دْ</> خَلَ<q>قْ</>نَا <h>ٱ</>لْإِ<k>نسَٰ</>نَ مِ<k>ن سُ</><m>لَٰ</>لَ<d>ةٍۢ مِّ</><k>ن طِ</><p>ي</>نٍۢ"},{"n":13,"w":[["ثُمَّ","thumma","Then","এরপর"],["جَعَلْنَـٰهُ","ja‘alnāhu","We placed him","তাকে (মানুষকে) আমরা স্হাপন করি"],["نُطْفَةًۭ","nuṭ'fatan","(as) a semen-drop","শুক্ররূপে"],["فِى","fī","in","মধ্যে"],["قَرَارٍۢ","qarārin","a resting place","আঁধারের"],["مَّكِينٍۢ","makīnin","firm","সুরক্ষিত"]],"t":"ثُ<g>مَّ</> جَعَلْ<m>نَٰ</>هُ نُ<q>طْ</>فَ<k>ةًۭ فِ</>ى قَرَا<d>رٍۢ مَّ</><p>كِي</>نٍۢ"},{"n":14,"w":[["ثُمَّ","thumma","Then","এরপর (এই প্রক্রিয়ায়)"],["خَلَقْنَا","khalaqnā","We created","আমরা সৃষ্টি করি"],["ٱلنُّطْفَةَ","l-nuṭ'fata","the semen-drop","শুক্রবিন্দুকে"],["عَلَقَةًۭ","‘alaqatan","(into) a clinging substance","জমাট রক্তরূপে"],["فَخَلَقْنَا","fakhalaqnā","then We created","অতঃপর আমরা সৃষ্টি করি"],["ٱلْعَلَقَةَ","l-‘alaqata","the clinging substance","জমাট রক্তকে"],["مُضْغَةًۭ","muḍ'ghatan","(into) an embryonic lump","মাংসপিন্ডে"],["فَخَلَقْنَا","fakhalaqnā","then We created","অতঃপর আমরা সৃষ্টি করি"],["ٱلْمُضْغَةَ","l-muḍ'ghata","the embryonic lump","মাংসপিন্ডকে"],["عِظَـٰمًۭا","‘iẓāman","(into) bones","হাড়ে"],["فَكَسَوْنَا","fakasawnā","then We clothed","অতঃপর আমরা ঢেকে দিই"],["ٱلْعِظَـٰمَ","l-‘iẓāma","the bones","হাড়কে"],["لَحْمًۭا","laḥman","(with) flesh","গোশত (দ্বারা)"],["ثُمَّ","thumma","then","এরপর"],["أَنشَأْنَـٰهُ","anshanāhu","We produce it","তাকে আমরা গড়ে তুলি"],["خَلْقًا","khalqan","(as) a creation","সৃষ্টিরূপে"],["ءَاخَرَ ۚ","ākhara","another","অন্য এক"],["فَتَبَارَكَ","fatabāraka","So blessed is","অতএব কত মহান"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ্‌"],["أَحْسَنُ","aḥsanu","(the) Best","(যিনি) সর্বোত্তম"],["ٱلْخَـٰلِقِينَ","l-khāliqīna","(of) the Creators","(সব) স্রষ্টাদের"]],"t":"ثُ<g>مَّ</> خَلَ<q>قْ</>نَا <h>ٱ</><l>ل</><g>نُّ</><q>طْ</>فَةَ عَلَقَ<k>ةًۭ فَ</>خَلَ<q>قْ</>نَا <h>ٱ</>لْعَلَقَةَ مُضْغَ<k>ةًۭ فَ</>خَلَ<q>قْ</>نَا <h>ٱ</>لْمُضْغَةَ عِ<m>ظَٰ</><k>مًۭا فَ</>كَسَوْنَا <h>ٱ</>لْعِ<m>ظَٰ</>مَ لَحْ<k>مًۭا ثُ</><g>مَّ</> أَ<k>نشَ</>أْ<m>نَٰ</>هُ خَلْقًا ءَاخَرَ ۚ فَتَبَارَكَ <h>ٱ</>للَّهُ أَحْسَنُ <h>ٱ</>لْ<m>خَٰ</>لِ<p>قِي</>نَ"},{"n":15,"w":[["ثُمَّ","thumma","Then","এরপর"],["إِنَّكُم","innakum","indeed, you","নিশ্চয়ই তোমরা"],["بَعْدَ","ba‘da","after","পরে"],["ذَٰلِكَ","dhālika","that","এর"],["لَمَيِّتُونَ","lamayyitūna","surely (will) die","অবশ্যই মৃত্যুবরণ করবে"]],"t":"ثُ<g>مَّ</> إِ<g>نَّ</><f>كُم بَ</>عْدَ <m>ذَٰ</>لِكَ لَمَيِّ<p>تُو</>نَ"},{"n":16,"w":[["ثُمَّ","thumma","Then","এরপর"],["إِنَّكُمْ","innakum","indeed, you","নিশ্চয়ই তোমাদের"],["يَوْمَ","yawma","(on the) Day","দিনে"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) the Resurrection","ক্বিয়ামাতের"],["تُبْعَثُونَ","tub'‘athūna","will be resurrected","ওঠানো হবে"]],"t":"ثُ<g>مَّ</> إِ<g>نَّ</>كُمْ يَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ تُ<q>بْ</>عَ<p>ثُو</>نَ"},{"n":17,"w":[["وَلَقَدْ","walaqad","And indeed","আর নিশ্চয়ই"],["خَلَقْنَا","khalaqnā","We (have) created","আমরা সৃষ্টি করেছি"],["فَوْقَكُمْ","fawqakum","above you","তোমাদের ওপরে"],["سَبْعَ","sab‘a","seven","সাতটি"],["طَرَآئِقَ","ṭarāiqa","paths","পথ"],["وَمَا","wamā","and not","এবং না"],["كُنَّا","kunnā","We are","আমরা ছিলাম"],["عَنِ","‘ani","of","সম্পর্কে"],["ٱلْخَلْقِ","l-khalqi","the creation","সৃষ্টি"],["غَـٰفِلِينَ","ghāfilīna","unaware","অমনোযোগী"]],"t":"وَلَقَ<q>دْ</> خَلَ<q>قْ</>نَا فَوْقَكُمْ سَ<q>بْ</>عَ طَ<o>رَآ</>ئِقَ وَمَا كُ<g>نَّ</>ا عَنِ <h>ٱ</>لْخَلْقِ <m>غَٰ</>فِ<p>لِي</>نَ"},{"n":18,"w":[["وَأَنزَلْنَا","wa-anzalnā","And We send down","আর আমরা বর্ষণ করি"],["مِنَ","mina","from","হ'তে"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশ"],["مَآءًۢ","māan","water","পানি"],["بِقَدَرٍۢ","biqadarin","in (due) measure","পরিমাণ মতো"],["فَأَسْكَنَّـٰهُ","fa-askannāhu","then We cause it to settle","অতঃপর তা আমরা সংরক্ষণ করি"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ ۖ","l-arḍi","the earth","মাটির"],["وَإِنَّا","wa-innā","And indeed, We","আর নিশ্চয়ই আমরা"],["عَلَىٰ","‘alā","on","ব্যাপারে"],["ذَهَابٍۭ","dhahābin","taking it away","(অন্যত্র) যাওয়ার"],["بِهِۦ","bihi","taking it away","নিয়ে তা"],["لَقَـٰدِرُونَ","laqādirūna","surely (are) Able","অবশ্যই সক্ষম"]],"t":"وَأَ<k>نزَ</>لْنَا مِنَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ <o>مَآ</><i>ءًۢ بِ</>قَدَ<k>رٍۢ فَ</>أَسْكَ<g>نَّٰ</>هُ فِى <h>ٱ</>لْأَرْضِ ۖ وَإِ<g>نَّ</>ا عَلَىٰ ذَهَا<i>بٍۭ بِ</><m>هِۦ</> لَ<m>قَٰ</>دِ<p>رُو</>نَ"},{"n":19,"w":[["فَأَنشَأْنَا","fa-anshanā","Then We produced","অতঃপর আমরা সৃষ্টি করি"],["لَكُم","lakum","for you","জন্যে তোমাদের"],["بِهِۦ","bihi","by it","দিয়ে তা"],["جَنَّـٰتٍۢ","jannātin","gardens","বাগান"],["مِّن","min","of date-palms","(দিয়ে) তৈরি"],["نَّخِيلٍۢ","nakhīlin","of date-palms","খেজুরের (গাছ)"],["وَأَعْنَـٰبٍۢ","wa-a‘nābin","and grapevines","ও আঙ্গুরের"],["لَّكُمْ","lakum","for you","জন্যে তোমাদের"],["فِيهَا","fīhā","in it","তার মধ্যে (আছে)"],["فَوَٰكِهُ","fawākihu","(are) fruits","ফলমূল"],["كَثِيرَةٌۭ","kathīratun","abundant","প্রচুর"],["وَمِنْهَا","wamin'hā","and from them","আর তা হ'তে"],["تَأْكُلُونَ","takulūna","you eat","তোমরা খাও"]],"t":"فَأَ<k>نشَ</>أْنَا لَ<f>كُم بِ</><m>هِۦ</> جَ<g>نَّٰ</><d>تٍۢ مِّن نَّ</>خِي<d>لٍۢ وَ</>أَعْ<m>نَٰ</><w>بٍۢ لَّ</>كُمْ فِيهَا فَ<m>وَٰ</>كِهُ كَثِيرَ<d>ةٌۭ وَ</>مِنْهَا تَأْكُ<p>لُو</>نَ"},{"n":20,"w":[["وَشَجَرَةًۭ","washajaratan","And a tree","এবং গাছ (জয়তুনের)"],["تَخْرُجُ","takhruju","(that) springs forth","বের হয়"],["مِن","min","from","হ'তে"],["طُورِ","ṭūri","Mount Sinai","পাহাড়"],["سَيْنَآءَ","saynāa","Mount Sinai","সিনাইয়ের"],["تَنۢبُتُ","tanbutu","(which) produces","উৎপন্ন হয়"],["بِٱلدُّهْنِ","bil-duh'ni","oil","তেল নিয়ে"],["وَصِبْغٍۢ","waṣib'ghin","and a relish","এবং খাবার (তরকারিসহ)"],["لِّلْـَٔاكِلِينَ","lil'ākilīna","for those who eat","জন্যে খাদ্যগ্রহণকারীদের"]],"t":"وَشَجَرَ<k>ةًۭ تَ</>خْرُجُ مِ<k>ن طُ</>ورِ سَيْ<o>نَآ</>ءَ تَ<i>نۢبُ</>تُ بِ<h>ٱ</><l>ل</>دُّهْنِ وَصِ<q>بْ</><w>غٍۢ لِّ</>لْءَاكِ<p>لِي</>نَ"},{"n":21,"w":[["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["لَكُمْ","lakum","for you","জন্যে তোমাদের"],["فِى","fī","in","মধ্যে (আছে)"],["ٱلْأَنْعَـٰمِ","l-an‘āmi","the cattle","গৃহপালিত পশুদের"],["لَعِبْرَةًۭ ۖ","la‘ib'ratan","surely, (is) a lesson","অবশ্যই শিক্ষা"],["نُّسْقِيكُم","nus'qīkum","We give you drink","তোমাদেরকে পান করাই আমরা"],["مِّمَّا","mimmā","from what","তা হ'তে যা"],["فِى","fī","(is) in","রয়েছে"],["بُطُونِهَا","buṭūnihā","their bellies","তাদের পেটে (অর্থাৎ দুধ)"],["وَلَكُمْ","walakum","and for you","আর জন্যে তোমাদের (রয়েছে)"],["فِيهَا","fīhā","in them","তাদের মধ্যে"],["مَنَـٰفِعُ","manāfi‘u","(are) benefits","উপকারিতা"],["كَثِيرَةٌۭ","kathīratun","many","প্রচুর"],["وَمِنْهَا","wamin'hā","and of them","আর তাদের মধ্য হ'তে"],["تَأْكُلُونَ","takulūna","you eat","তোমরা খাও (গোশত)"]],"t":"وَإِ<g>نَّ</> لَكُمْ فِى <h>ٱ</>لْأَنْ<m>عَٰ</>مِ لَعِ<q>بْ</>رَ<d>ةًۭ ۖ نُّ</>سْقِي<y>كُم مِّ</><g>مَّ</>ا فِى بُطُونِهَا وَلَكُمْ فِيهَا مَ<m>نَٰ</>فِعُ كَثِيرَ<d>ةٌۭ وَ</>مِنْهَا تَأْكُ<p>لُو</>نَ"},{"n":22,"w":[["وَعَلَيْهَا","wa‘alayhā","And on them","এবং তাদের উপর"],["وَعَلَى","wa‘alā","and on","ও উপর"],["ٱلْفُلْكِ","l-ful'ki","[the] ships","নৌযানের"],["تُحْمَلُونَ","tuḥ'malūna","you are carried","তোমাদের বহন করা হয়"]],"t":"وَعَلَيْهَا وَعَلَى <h>ٱ</>لْفُلْكِ تُحْمَ<p>لُو</>نَ"},{"n":23,"w":[["وَلَقَدْ","walaqad","And verily","আর নিশ্চয়ই"],["أَرْسَلْنَا","arsalnā","We sent","আমরা পাঠিয়েছি"],["نُوحًا","nūḥan","Nuh","নূহকে"],["إِلَىٰ","ilā","to","প্রতি"],["قَوْمِهِۦ","qawmihi","his people","তার জাতির"],["فَقَالَ","faqāla","and he said","তখন সে বলেছিলো"],["يَـٰقَوْمِ","yāqawmi","O my people","\"হে আমার জাতি"],["ٱعْبُدُوا۟","u‘'budū","Worship","তোমরা ইবাদাত করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহর"],["مَا","mā","not","নেই"],["لَكُم","lakum","for you","জন্যে তোমাদের"],["مِّنْ","min","(is) any","কোন"],["إِلَـٰهٍ","ilāhin","god","ইলাহ"],["غَيْرُهُۥٓ ۖ","ghayruhu","other than Him","তিনি ছাড়া"],["أَفَلَا","afalā","Then will not","কি তবুও না"],["تَتَّقُونَ","tattaqūna","you fear","তোমরা সাবধান হবে\""]],"t":"وَلَقَ<q>دْ</> أَرْسَلْنَا نُوحًا إِلَىٰ قَوْمِ<m>هِۦ</> فَقَالَ <m>يَٰ</>قَوْمِ <h>ٱ</>عْبُدُو<s>ا۟</> <h>ٱ</>للَّهَ مَا لَ<y>كُم مِّ</>نْ إِ<m>لَٰ</>هٍ غَيْرُهُ<o>ۥٓ ۖ</> أَفَلَا تَتَّ<p>قُو</>نَ"},{"n":24,"w":[["فَقَالَ","faqāla","But said","তখন বলেছিলো"],["ٱلْمَلَؤُا۟","l-mala-u","the chiefs","প্রধান ব্যক্তিরা"],["ٱلَّذِينَ","alladhīna","(of) those who","(তাদের) যারা"],["كَفَرُوا۟","kafarū","disbelieved","অস্বীকার করেছিলো"],["مِن","min","among","মধ্য হ'তে"],["قَوْمِهِۦ","qawmihi","his people","তার জাতির"],["مَا","mā","This is not","\"নয়"],["هَـٰذَآ","hādhā","This is not","\"এই (ব্যক্তি)"],["إِلَّا","illā","but","এ ছাড়া যে"],["بَشَرٌۭ","basharun","a man","একজন মানুষ"],["مِّثْلُكُمْ","mith'lukum","like you","তোমাদেরই মতো"],["يُرِيدُ","yurīdu","he wishes","সে চায়"],["أَن","an","to","যে"],["يَتَفَضَّلَ","yatafaḍḍala","assert (his) superiority","শ্রেষ্ঠত্ব লাভ করবে"],["عَلَيْكُمْ","‘alaykum","over you","তোমাদের উপর"],["وَلَوْ","walaw","and if","আর যদি"],["شَآءَ","shāa","Allah had willed","চাইতেন"],["ٱللَّهُ","l-lahu","Allah had willed","আল্লাহ্‌"],["لَأَنزَلَ","la-anzala","surely He (would have) sent down","অবশ্যই পাঠাতেন"],["مَلَـٰٓئِكَةًۭ","malāikatan","Angels","ফেরেশতা"],["مَّا","mā","Not","না"],["سَمِعْنَا","sami‘'nā","we heard","আমরা শুনেছি"],["بِهَـٰذَا","bihādhā","of this","ধরণের এ (কথা)"],["فِىٓ","fī","from","মধ্যে"],["ءَابَآئِنَا","ābāinā","our forefathers","আমাদের পিতৃপুরুষদের"],["ٱلْأَوَّلِينَ","l-awalīna","our forefathers","পূর্বকালের"]],"t":"فَقَالَ <h>ٱ</>لْمَلَؤُ<s>ا۟</> <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> مِ<k>ن قَ</>وْمِ<m>هِۦ</> مَا <m>هَٰ</><o>ذَآ</> إِلَّا بَشَ<d>رٌۭ مِّ</>ثْلُكُمْ يُرِيدُ <d>أَن يَ</>تَفَضَّلَ عَلَيْكُمْ وَلَوْ <o>شَآ</>ءَ <h>ٱ</>للَّهُ لَأَ<k>نزَ</>لَ مَ<o>لَٰٓ</>ئِكَ<d>ةًۭ مَّ</>ا سَمِعْنَا بِ<m>هَٰ</>ذَا <o>فِىٓ</> ءَا<o>بَآ</>ئِنَا <h>ٱ</>لْأَوَّ<p>لِي</>نَ"},{"n":25,"w":[["إِنْ","in","Not","নয়"],["هُوَ","huwa","he","সে"],["إِلَّا","illā","(is) but","এ ছাড়া যে"],["رَجُلٌۢ","rajulun","a man","একজন মানুষ"],["بِهِۦ","bihi","in him","সাথে তার (আছে)"],["جِنَّةٌۭ","jinnatun","(is) madness","জ্বিন"],["فَتَرَبَّصُوا۟","fatarabbaṣū","so wait","অতএব তোমরা অপেক্ষা করো"],["بِهِۦ","bihi","concerning him","সম্পর্কে তার"],["حَتَّىٰ","ḥattā","until","পর্যন্ত"],["حِينٍۢ","ḥīnin","a time","কিছুকাল\""]],"t":"إِنْ هُوَ إِلَّا رَجُ<i>لٌۢ بِ</><m>هِۦ</> جِ<g>نَّ</><k>ةٌۭ فَ</>تَرَبَّصُو<s>ا۟</> بِ<m>هِۦ</> حَتَّىٰ <p>حِي</>نٍۢ"},{"n":26,"w":[["قَالَ","qāla","He said","(নূহ) বললো"],["رَبِّ","rabbi","My Lord","\"হে আমার রব"],["ٱنصُرْنِى","unṣur'nī","Help me","আমাকে সাহায্য করো"],["بِمَا","bimā","because","এ কারণে যে"],["كَذَّبُونِ","kadhabūni","they deny me","আমাকে তারা মিথ্যা সাব্যস্ত করেছে\""]],"t":"قَالَ رَبِّ <h>ٱ</><k>نصُ</>رْنِى بِمَا كَذَّ<p>بُو</>نِ"},{"n":27,"w":[["فَأَوْحَيْنَآ","fa-awḥaynā","So We inspired","অতঃপর আমরা ওহী করলাম"],["إِلَيْهِ","ilayhi","to him","তার প্রতি"],["أَنِ","ani","That","\"যে"],["ٱصْنَعِ","iṣ'na‘i","construct","নির্মাণ করো"],["ٱلْفُلْكَ","l-ful'ka","the ship","নৌকা"],["بِأَعْيُنِنَا","bi-a‘yuninā","under Our eyes","সামনে আমাদের চোখের"],["وَوَحْيِنَا","wawaḥyinā","and Our inspiration","ও আমাদের ওহীর ভিত্তিতে"],["فَإِذَا","fa-idhā","then when","অতঃপর যখন"],["جَآءَ","jāa","comes","আসবে"],["أَمْرُنَا","amrunā","Our Command","আমাদের নির্দেশ"],["وَفَارَ","wafāra","and gushes forth","ও উথলে উঠবে"],["ٱلتَّنُّورُ ۙ","l-tanūru","the oven","চুলাটি"],["فَٱسْلُكْ","fa-us'luk","then put","(নৌকাতে) তখন উঠিয়ে নিবে"],["فِيهَا","fīhā","into it","তার মধ্যে"],["مِن","min","of","ধরণের"],["كُلٍّۢ","kullin","every (kind)","প্রত্যেক (জীব জন্তুর)"],["زَوْجَيْنِ","zawjayni","(of) mates","জোড়া"],["ٱثْنَيْنِ","ith'nayni","two","দুইটার (অর্থাৎ নর ও নারী)"],["وَأَهْلَكَ","wa-ahlaka","and your family","ও তোমার পরিবারকে"],["إِلَّا","illā","except","ছাড়া"],["مَن","man","those","তাদের"],["سَبَقَ","sabaqa","(has) preceded","পূর্বে নির্ধারিত হয়েছে"],["عَلَيْهِ","‘alayhi","against whom","যাদের সম্পর্কে"],["ٱلْقَوْلُ","l-qawlu","the Word","বাণী (সিদ্ধান্ত)"],["مِنْهُمْ ۖ","min'hum","thereof","তাদের মধ্য হ'তে"],["وَلَا","walā","And (do) not","এবং না"],["تُخَـٰطِبْنِى","tukhāṭib'nī","address Me","আমাকে কিছু বলো"],["فِى","fī","concerning","সম্পর্কে"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["ظَلَمُوٓا۟ ۖ","ẓalamū","wronged","অত্যাচার করেছে"],["إِنَّهُم","innahum","indeed, they","তারা নিশ্চয়ই"],["مُّغْرَقُونَ","mugh'raqūna","(are) the ones to be drowned","নিমজ্জিত হবে"]],"t":"فَأَوْحَيْ<o>نَآ</> إِلَيْهِ أَنِ <h>ٱ</>صْنَعِ <h>ٱ</>لْفُلْكَ بِأَعْيُنِنَا وَوَحْيِنَا فَإِذَا <o>جَآ</>ءَ أَمْرُنَا وَفَارَ <h>ٱ</><l>ل</>تَّ<g>نُّ</>ورُ ۙ فَ<h>ٱ</>سْلُكْ فِيهَا مِ<k>ن كُلٍّۢ زَ</>وْجَيْنِ <h>ٱ</>ثْنَيْنِ وَأَهْلَكَ إِلَّا مَ<k>ن سَ</>بَقَ عَلَيْهِ <h>ٱ</>لْقَوْلُ مِنْهُمْ ۖ وَلَا تُ<m>خَٰ</>طِ<q>بْ</>نِى فِى <h>ٱ</>لَّذِينَ ظَلَ<o>مُوٓ</><s>ا۟</> ۖ إِ<g>نَّ</><y>هُم مُّ</>غْرَ<p>قُو</>نَ"},{"n":28,"w":[["فَإِذَا","fa-idhā","And when","অতঃপর যখন"],["ٱسْتَوَيْتَ","is'tawayta","you (have) boarded","তুমি স্হির হবে"],["أَنتَ","anta","you","তুমি"],["وَمَن","waman","and whoever","ও যারা"],["مَّعَكَ","ma‘aka","(is) with you","তোমার সাথে"],["عَلَى","‘alā","[on]","উপর"],["ٱلْفُلْكِ","l-ful'ki","the ship","নৌকার"],["فَقُلِ","faquli","then say","তখন বলো"],["ٱلْحَمْدُ","l-ḥamdu","Praise","\"সব প্রশংসা"],["لِلَّهِ","lillahi","(be) to Allah","জন্যে আল্লাহরই"],["ٱلَّذِى","alladhī","Who","যিনি"],["نَجَّىٰنَا","najjānā","(has) saved us","আমাদেরকে উদ্ধার করেছেন"],["مِنَ","mina","from","হ'তে"],["ٱلْقَوْمِ","l-qawmi","the people ","জাতি"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","সীমালঙ্ঘনকারী\""]],"t":"فَإِذَا <h>ٱ</>سْتَوَيْتَ أَ<k>نتَ</> وَ<d>مَن مَّ</>عَكَ عَلَى <h>ٱ</>لْفُلْكِ فَقُلِ <h>ٱ</>لْحَمْدُ لِلَّهِ <h>ٱ</>لَّذِى نَجَّ<m>ىٰ</>نَا مِنَ <h>ٱ</>لْقَوْمِ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":29,"w":[["وَقُل","waqul","And say","এবং বলো"],["رَّبِّ","rabbi","My Lord","\"হে আমার রব"],["أَنزِلْنِى","anzil'nī","cause me to land","আমাকে অবতরণ করাও"],["مُنزَلًۭا","munzalan","(at) a landing place","অবতরণস্থানে"],["مُّبَارَكًۭا","mubārakan","blessed","কল্যাণকর"],["وَأَنتَ","wa-anta","and You","আর তুমি"],["خَيْرُ","khayru","(are) the Best","উত্তম"],["ٱلْمُنزِلِينَ","l-munzilīna","(of) those who cause to land.'","অবতীর্ণকারীদের (মধ্যে)\""]],"t":"وَقُ<r>ل</> رَّبِّ أَ<k>نزِ</>لْنِى مُ<k>نزَ</>لًۭ<d>ا مُّ</>بَارَ<d>كًۭا وَ</>أَ<k>نتَ</> خَيْرُ <h>ٱ</>لْمُ<k>نزِ</><p>لِي</>نَ"},{"n":30,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে (রয়েছে)"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَـٰتٍۢ","laāyātin","surely (are) Signs","অবশ্যই নিদর্শন"],["وَإِن","wa-in","and indeed","আর নিশ্চয়ই"],["كُنَّا","kunnā","We are","আমরাই ছিলাম"],["لَمُبْتَلِينَ","lamub'talīna","surely testing","অবশ্যই পরীক্ষাকারী"]],"t":"إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَا<m>يَٰ</><d>تٍۢ وَ</>إِ<k>ن كُ</><g>نَّ</>ا لَمُ<q>بْ</>تَ<p>لِي</>نَ"},{"n":31,"w":[["ثُمَّ","thumma","Then","এরপর"],["أَنشَأْنَا","anshanā","We produced","আমরা সৃষ্টি করেছি"],["مِنۢ","min","after them","থেকে"],["بَعْدِهِمْ","ba‘dihim","after them","পর তাদের"],["قَرْنًا","qarnan","a generation","জাতি"],["ءَاخَرِينَ","ākharīna","another","অন্য এক"]],"t":"ثُ<g>مَّ</> أَ<k>نشَ</>أْنَا <i>مِنۢ بَ</>عْدِهِمْ قَرْنًا ءَاخَ<p>رِي</>نَ"},{"n":32,"w":[["فَأَرْسَلْنَا","fa-arsalnā","And We sent","অতঃপর আমরা পাঠিয়েছি"],["فِيهِمْ","fīhim","among them","তাদের মধ্যে"],["رَسُولًۭا","rasūlan","a Messenger","একজনকে রাসূলরূপে"],["مِّنْهُمْ","min'hum","from themselves","তাদেরই মধ্য হ'তে"],["أَنِ","ani","[that]","(তার দাওয়াত এ ছিলো) যে"],["ٱعْبُدُوا۟","u‘'budū","Worship","\"তোমরা ইবাদাত করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহর"],["مَا","mā","not","নেই"],["لَكُم","lakum","for you","জন্যে তোমাদের"],["مِّنْ","min","(is) any","কোন"],["إِلَـٰهٍ","ilāhin","god","ইলাহ"],["غَيْرُهُۥٓ ۖ","ghayruhu","other than Him","তিনি ছাড়া"],["أَفَلَا","afalā","Then will not","কি তবুও না"],["تَتَّقُونَ","tattaqūna","you fear","তোমরা সাবধান হবে\""]],"t":"فَأَرْسَلْنَا فِيهِمْ رَسُولًۭ<d>ا مِّ</>نْهُمْ أَنِ <h>ٱ</>عْبُدُو<s>ا۟</> <h>ٱ</>للَّهَ مَا لَ<y>كُم مِّ</>نْ إِ<m>لَٰ</>هٍ غَيْرُهُ<o>ۥٓ ۖ</> أَفَلَا تَتَّ<p>قُو</>نَ"},{"n":33,"w":[["وَقَالَ","waqāla","And said","এবং বলেছিলো"],["ٱلْمَلَأُ","l-mala-u","the chiefs","প্রধান ব্যক্তিরা"],["مِن","min","of","মধ্য হ'তে"],["قَوْمِهِ","qawmihi","his people","তার জাতির"],["ٱلَّذِينَ","alladhīna","who","যারা"],["كَفَرُوا۟","kafarū","disbelieved","অস্বীকার করেছিলো"],["وَكَذَّبُوا۟","wakadhabū","and denied","ও মিথ্যারোপ করেছিলো"],["بِلِقَآءِ","biliqāi","(the) meeting","প্রতি সাক্ষাতের"],["ٱلْـَٔاخِرَةِ","l-ākhirati","(of) the Hereafter","পরকালের"],["وَأَتْرَفْنَـٰهُمْ","wa-atrafnāhum","while We had given them luxury","এবং তাদেরকে আমরা স্বাচ্ছন্দ্য দিয়েছিলাম"],["فِى","fī","in","মধ্যে"],["ٱلْحَيَوٰةِ","l-ḥayati","the life","জীবনের"],["ٱلدُّنْيَا","l-dun'yā","(of) the world","দুনিয়ার"],["مَا","mā","Not","\"নয়"],["هَـٰذَآ","hādhā","(is) this","সে"],["إِلَّا","illā","but","এ ছাড়া"],["بَشَرٌۭ","basharun","a man","একজন মানুষ"],["مِّثْلُكُمْ","mith'lukum","like you","তোমাদেরই মতো"],["يَأْكُلُ","yakulu","He eats","সে খায়"],["مِمَّا","mimmā","of what","তা হ'তে"],["تَأْكُلُونَ","takulūna","you eat","তোমরা খাও"],["مِنْهُ","min'hu","[from it]","যা হ'তে"],["وَيَشْرَبُ","wayashrabu","and he drinks","এবং পান করে"],["مِمَّا","mimmā","of what","তা হ'তে যা"],["تَشْرَبُونَ","tashrabūna","you drink","তোমরা পান করো"]],"t":"وَقَالَ <h>ٱ</>لْمَلَأُ مِ<k>ن قَ</>وْمِهِ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> وَكَذَّبُو<s>ا۟</> بِلِ<o>قَآ</>ءِ <h>ٱ</>لْءَاخِرَةِ وَأَتْرَفْ<m>نَٰ</>هُمْ فِى <h>ٱ</>لْحَيَ<s>وٰ</>ةِ <h>ٱ</><l>ل</>دُّنْيَا مَا <m>هَٰ</><o>ذَآ</> إِلَّا بَشَ<d>رٌۭ مِّ</>ثْلُكُمْ يَأْكُلُ مِ<g>مَّ</>ا تَأْكُلُونَ مِنْهُ وَيَشْرَبُ مِ<g>مَّ</>ا تَشْرَ<p>بُو</>نَ"},{"n":34,"w":[["وَلَئِنْ","wala-in","And surely if","আর অবশ্যই যদি"],["أَطَعْتُم","aṭa‘tum","you obey","তোমরা আনুগত্য করো"],["بَشَرًۭا","basharan","a man","একজন মানুষের"],["مِّثْلَكُمْ","mith'lakum","like you","তোমাদের মতো"],["إِنَّكُمْ","innakum","indeed, you","নিশ্চয়ই তোমরা"],["إِذًۭا","idhan","then","তাহ'লে"],["لَّخَـٰسِرُونَ","lakhāsirūna","surely (will be) losers","ক্ষতিগ্রস্ত হবে"]],"t":"وَلَئِنْ أَطَعْ<f>تُم بَ</>شَ<d>رًۭا مِّ</>ثْلَكُمْ إِ<g>نَّ</>كُمْ إِ<w>ذًۭا لَّ</><m>خَٰ</>سِ<p>رُو</>نَ"},{"n":35,"w":[["أَيَعِدُكُمْ","aya‘idukum","Does he promise you ","কি তোমাদেরকে প্রতিশ্রুতি দেয়"],["أَنَّكُمْ","annakum","that you","যে তোমরা"],["إِذَا","idhā","when","যখন"],["مِتُّمْ","mittum","you are dead","মরে যাবে"],["وَكُنتُمْ","wakuntum","and you become","ও তোমরা হবে"],["تُرَابًۭا","turāban","dust","মাটি"],["وَعِظَـٰمًا","wa‘iẓāman","and bones","ও হাড়"],["أَنَّكُم","annakum","that you","নিশ্চয়ই তোমরা"],["مُّخْرَجُونَ","mukh'rajūna","(will be) brought forth","(কবর হ'তে) তোমাদেরকে বের করা হবে"]],"t":"أَيَعِدُكُمْ أَ<g>نَّ</>كُمْ إِذَا مِتُّمْ وَكُ<k>نتُ</>مْ تُرَا<d>بًۭا وَ</>عِ<m>ظَٰ</>مًا أَ<g>نَّ</><y>كُم مُّ</>خْرَ<p>جُو</>نَ"},{"n":36,"w":[["۞ هَيْهَاتَ","hayhāta","Far-(fetched)","(অসম্ভব) দূরে"],["هَيْهَاتَ","hayhāta","far-(fetched)","(অসম্ভব) বহুদূরে"],["لِمَا","limā","is what","বিষয়ে যার"],["تُوعَدُونَ","tū‘adūna","you are promised","তোমাদের প্রতিশ্রুতি দেয়া হচ্ছে"]],"t":"۞ هَيْهَاتَ هَيْهَاتَ لِمَا تُوعَ<p>دُو</>نَ"},{"n":37,"w":[["إِنْ","in","Not","না"],["هِىَ","hiya","it","তা"],["إِلَّا","illā","(is) but","এ ছাড়া যে"],["حَيَاتُنَا","ḥayātunā","our life","আমাদের জীবন"],["ٱلدُّنْيَا","l-dun'yā","(of) the world","দুুনিয়ারই"],["نَمُوتُ","namūtu","we die","(শুধু এখানেই) আমরা মরি"],["وَنَحْيَا","wanaḥyā","and we live","ও আমরা বাঁচি"],["وَمَا","wamā","and not","এবং না"],["نَحْنُ","naḥnu","we","আমরা"],["بِمَبْعُوثِينَ","bimab‘ūthīna","(will be) resurrected","উত্থিত হবো"]],"t":"إِنْ هِىَ إِلَّا حَيَاتُنَا <h>ٱ</><l>ل</>دُّنْيَا نَمُوتُ وَنَحْيَا وَمَا نَحْنُ بِمَ<q>بْ</>عُو<p>ثِي</>نَ"},{"n":38,"w":[["إِنْ","in","Not","নয়"],["هُوَ","huwa","(is) he","সে"],["إِلَّا","illā","but","এ ছাড়া"],["رَجُلٌ","rajulun","a man","এক ব্যক্তি"],["ٱفْتَرَىٰ","if'tarā","who (has) invented","রচনা করেছে"],["عَلَى","‘alā","about","সম্পর্কে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["كَذِبًۭا","kadhiban","a lie","মিথ্যা"],["وَمَا","wamā","and not","আর নই"],["نَحْنُ","naḥnu","we","আমরা"],["لَهُۥ","lahu","(in) him","উপর তার"],["بِمُؤْمِنِينَ","bimu'minīna","(are) believers","মু'মিন\""]],"t":"إِنْ هُوَ إِلَّا رَجُلٌ <h>ٱ</>فْتَرَىٰ عَلَى <h>ٱ</>للَّهِ كَذِ<d>بًۭا وَ</>مَا نَحْنُ لَهُ<m>ۥ</> بِمُؤْمِ<p>نِي</>نَ"},{"n":39,"w":[["قَالَ","qāla","He said","(রাসূল) বলল"],["رَبِّ","rabbi","My Lord","\"হে আমার রব"],["ٱنصُرْنِى","unṣur'nī","Help me","আমাকে সাহায্য করো"],["بِمَا","bimā","because","এ কারণে যে"],["كَذَّبُونِ","kadhabūni","they deny me","আমার উপর তারা মিথ্যারোপ করেছে\""]],"t":"قَالَ رَبِّ <h>ٱ</><k>نصُ</>رْنِى بِمَا كَذَّ<p>بُو</>نِ"},{"n":40,"w":[["قَالَ","qāla","He said","(আল্লাহ) বললেন"],["عَمَّا","‘ammā","After a little while","\"হ'তে ঐবিষয়"],["قَلِيلٍۢ","qalīlin","After a little while","\"অল্প পরে (অচিরেই)"],["لَّيُصْبِحُنَّ","layuṣ'biḥunna","surely they will become","অবশ্যই তারা হবে"],["نَـٰدِمِينَ","nādimīna","regretful","অনুতপ্ত\""]],"t":"قَالَ عَ<g>مَّ</>ا قَلِي<w>لٍۢ لَّ</>يُصْبِحُ<g>نَّ</> <m>نَٰ</>دِ<p>مِي</>نَ"},{"n":41,"w":[["فَأَخَذَتْهُمُ","fa-akhadhathumu","So seized them","অতঃপর তাদেরকে ধরলো"],["ٱلصَّيْحَةُ","l-ṣayḥatu","the awful cry","এক মহাগর্জন"],["بِٱلْحَقِّ","bil-ḥaqi","in truth","সাথে ন্যায়ের"],["فَجَعَلْنَـٰهُمْ","faja‘alnāhum","and We made them","অতঃপর তাদেরকে আমরা করেছিলাম"],["غُثَآءًۭ ۚ","ghuthāan","(as) rubbish of dead leaves","ঢেউ তাড়িত আবর্জনার (মতো)"],["فَبُعْدًۭا","fabu‘'dan","So away","সুতরাং দূর হোক (অর্থাৎ ধ্বংস আসুক)"],["لِّلْقَوْمِ","lil'qawmi","with the people ","জন্যে (এমন) জাতির"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","(যারা) সীমালঙ্ঘনকারী"]],"t":"فَأَخَذَتْهُمُ <h>ٱ</><l>ل</>صَّيْحَةُ بِ<h>ٱ</>لْحَقِّ فَجَعَلْ<m>نَٰ</>هُمْ غُ<o>ثَآ</><k>ءًۭ ۚ فَ</>بُعْ<w>دًۭا لِّ</>لْقَوْمِ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":42,"w":[["ثُمَّ","thumma","Then","এরপর"],["أَنشَأْنَا","anshanā","We produced","আমরা সৃষ্টি করলাম"],["مِنۢ","min","after them","থেকে"],["بَعْدِهِمْ","ba‘dihim","after them","পর তাদের"],["قُرُونًا","qurūnan","a generation","(বহু) জাতি"],["ءَاخَرِينَ","ākharīna","another","অন্যান্য"]],"t":"ثُ<g>مَّ</> أَ<k>نشَ</>أْنَا <i>مِنۢ بَ</>عْدِهِمْ قُرُونًا ءَاخَ<p>رِي</>نَ"},{"n":43,"w":[["مَا","mā","Not","না"],["تَسْبِقُ","tasbiqu","can precede","তাড়াতাড়ি এগিয়ে আনতে পারে"],["مِنْ","min","any","কোন"],["أُمَّةٍ","ummatin","nation","জাতি"],["أَجَلَهَا","ajalahā","its term","তার নির্ধারিত সময়"],["وَمَا","wamā","and not","আর না"],["يَسْتَـْٔخِرُونَ","yastakhirūna","they (can) delay (it)","দেরি করতে পারে"]],"t":"مَا تَسْبِقُ مِنْ أُ<g>مَّ</>ةٍ أَجَلَهَا وَمَا يَسْتَـْٔخِ<p>رُو</>نَ"},{"n":44,"w":[["ثُمَّ","thumma","Then","এরপর"],["أَرْسَلْنَا","arsalnā","We sent","আমরা পাঠিয়েছি"],["رُسُلَنَا","rusulanā","Our Messengers","আমাদের রাসূলগণকে"],["تَتْرَا ۖ","tatrā","(in) succession","একের পর এক"],["كُلَّ","kulla","Every time","যখনই"],["مَا","mā","Every time","যা"],["جَآءَ","jāa","came","এসেছে"],["أُمَّةًۭ","ummatan","(to) a nation","কোন জাতির (নিকট)"],["رَّسُولُهَا","rasūluhā","its Messenger","তার রাসূল"],["كَذَّبُوهُ ۚ","kadhabūhu","they denied him","তাকে তারা মিথ্যাবাদী বলেছে"],["فَأَتْبَعْنَا","fa-atba‘nā","so We made (them) follow ","অতঃপর আমরা পিছনে চললাম (অর্থাৎ ধ্বংস করলাম)"],["بَعْضَهُم","ba‘ḍahum","some of them","তাদের একের পর"],["بَعْضًۭا","ba‘ḍan","others","এক"],["وَجَعَلْنَـٰهُمْ","waja‘alnāhum","and We made them","ও আমরা বানিয়েছি তাদেরকে"],["أَحَادِيثَ ۚ","aḥādītha","narrations","কাহিনীর (মতো)"],["فَبُعْدًۭا","fabu‘'dan","So away","সুতরাং দূর হোক (অর্থাৎ ধ্বংস আসুক)"],["لِّقَوْمٍۢ","liqawmin","with a people ","জন্যে (এমন) জাতির"],["لَّا","lā","not","(যারা) না"],["يُؤْمِنُونَ","yu'minūna","they believe","ঈমান আনে"]],"t":"ثُ<g>مَّ</> أَرْسَلْنَا رُسُلَنَا تَتْرَا ۖ كُلَّ مَا <o>جَآ</>ءَ أُ<g>مَّ</><w>ةًۭ رَّ</>سُولُهَا كَذَّبُوهُ ۚ فَأَتْبَعْنَا بَعْضَ<f>هُم بَ</>عْ<d>ضًۭا وَ</>جَعَلْ<m>نَٰ</>هُمْ أَحَادِيثَ ۚ فَبُعْ<w>دًۭا لِّ</>قَوْ<w>مٍۢ لَّ</>ا يُؤْمِ<p>نُو</>نَ"},{"n":45,"w":[["ثُمَّ","thumma","Then","এরপর"],["أَرْسَلْنَا","arsalnā","We sent","আমরা পাঠালাম"],["مُوسَىٰ","mūsā","Musa","মূসাকে"],["وَأَخَاهُ","wa-akhāhu","and his brother","ও তার ভাই"],["هَـٰرُونَ","hārūna","Harun","হারূনকে"],["بِـَٔايَـٰتِنَا","biāyātinā","with Our Signs","সহ আমাদের নিদর্শনাবলী"],["وَسُلْطَـٰنٍۢ","wasul'ṭānin","and an authority","ও প্রমাণ (সহ)"],["مُّبِينٍ","mubīnin","clear","সুস্পষ্ট"]],"t":"ثُ<g>مَّ</> أَرْسَلْنَا مُوسَىٰ وَأَخَاهُ <m>هَٰ</>رُونَ بِـَٔا<m>يَٰ</>تِنَا وَسُلْ<m>طَٰ</><d>نٍۢ مُّ</><p>بِي</>نٍ"},{"n":46,"w":[["إِلَىٰ","ilā","To","প্রতি"],["فِرْعَوْنَ","fir'‘awna","Firaun","ফিরআউনের"],["وَمَلَإِي۟هِۦ","wamala-ihi","and his chiefs","ও তার সভাষদদের (প্রতি)"],["فَٱسْتَكْبَرُوا۟","fa-is'takbarū","but they behaved arrogantly","কিন্তু তারা অহংকার করলো"],["وَكَانُوا۟","wakānū","and they were","ও তারা ছিলো"],["قَوْمًا","qawman","a people","জাতি"],["عَالِينَ","‘ālīna","haughty","উদ্ধত"]],"t":"إِلَىٰ فِرْعَوْنَ وَمَلَإِ<s>ي۟</><m>هِۦ</> فَ<h>ٱ</>سْتَكْبَرُو<s>ا۟</> وَكَانُو<s>ا۟</> قَوْمًا عَا<p>لِي</>نَ"},{"n":47,"w":[["فَقَالُوٓا۟","faqālū","Then they said","অতঃপর তারা বললো"],["أَنُؤْمِنُ","anu'minu","Shall we believe","\"কি ঈমান আনবো আমরা"],["لِبَشَرَيْنِ","libasharayni","(in) two men","মানুষের উপর দুজন"],["مِثْلِنَا","mith'linā","like ourselves","আমাদের মতো"],["وَقَوْمُهُمَا","waqawmuhumā","while their people","অথচ তাদের উভয়ের জাতি"],["لَنَا","lanā","for us","জন্যে আমাদের"],["عَـٰبِدُونَ","‘ābidūna","(are) slaves","দাস-দাসী (হয়ে আছে)\""]],"t":"فَقَا<o>لُوٓ</><s>ا۟</> أَنُؤْمِنُ لِبَشَرَيْنِ مِثْلِنَا وَقَوْمُهُمَا لَنَا <m>عَٰ</>بِ<p>دُو</>نَ"},{"n":48,"w":[["فَكَذَّبُوهُمَا","fakadhabūhumā","So they denied them","অতএব উভয়কে তারা মিথ্যারোপ করলো"],["فَكَانُوا۟","fakānū","and they became","অতঃপর তারা হলো"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْمُهْلَكِينَ","l-muh'lakīna","those who were destroyed","ধ্বংসপ্রাপ্তদের"]],"t":"فَكَذَّبُوهُمَا فَكَانُو<s>ا۟</> مِنَ <h>ٱ</>لْمُهْلَ<p>كِي</>نَ"},{"n":49,"w":[["وَلَقَدْ","walaqad","And verily","আর নিশ্চয়ই"],["ءَاتَيْنَا","ātaynā","We gave","আমরা দিয়েছিলাম"],["مُوسَى","mūsā","Musa","মূসাকে"],["ٱلْكِتَـٰبَ","l-kitāba","the Scripture","কিতাব"],["لَعَلَّهُمْ","la‘allahum","so that they may","যাতে তারা"],["يَهْتَدُونَ","yahtadūna","be guided","সৎ পথ পায়"]],"t":"وَلَقَ<q>دْ</> ءَاتَيْنَا مُوسَى <h>ٱ</>لْكِ<m>تَٰ</>بَ لَعَلَّهُمْ يَهْتَ<p>دُو</>نَ"},{"n":50,"w":[["وَجَعَلْنَا","waja‘alnā","And We made","আর আমরা করেছি"],["ٱبْنَ","ib'na","(the) son","পুত্রকে"],["مَرْيَمَ","maryama","(of) Maryam","মারইয়ামের"],["وَأُمَّهُۥٓ","wa-ummahu","and his mother","ও তার মাকে"],["ءَايَةًۭ","āyatan","a Sign","এক নিদর্শন"],["وَءَاوَيْنَـٰهُمَآ","waāwaynāhumā","and We sheltered them","এবং উভয়কে আশ্রয় দিয়েছিলাম আমরা"],["إِلَىٰ","ilā","to","দিকে"],["رَبْوَةٍۢ","rabwatin","a high ground","উচ্চভূমির"],["ذَاتِ","dhāti","of tranquility","উপযোগী"],["قَرَارٍۢ","qarārin","of tranquility","অবস্থানের"],["وَمَعِينٍۢ","wama‘īnin","and water springs","ও ঝর্ণা (বিশিষ্ট)"]],"t":"وَجَعَلْنَا <h>ٱ</><q>بْ</>نَ مَرْيَمَ وَأُ<g>مَّ</>هُ<o>ۥٓ</> ءَايَ<d>ةًۭ وَ</>ءَاوَيْ<m>نَٰ</>هُ<o>مَآ</> إِلَىٰ رَ<q>بْ</>وَ<k>ةٍۢ ذَ</>اتِ قَرَا<d>رٍۢ وَ</>مَ<p>عِي</>نٍۢ"},{"n":51,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O Messengers","(আর বলেছিলাম) হে"],["ٱلرُّسُلُ","l-rusulu","O Messengers","রাসূলরা"],["كُلُوا۟","kulū","Eat","তোমরা খাও"],["مِنَ","mina","of","হ'তে"],["ٱلطَّيِّبَـٰتِ","l-ṭayibāti","the good things","পবিত্র (বস্তু)"],["وَٱعْمَلُوا۟","wa-i‘'malū","and do","ও তোমরা কাজ করো"],["صَـٰلِحًا ۖ","ṣāliḥan","righteous (deeds)","সৎ"],["إِنِّى","innī","Indeed, I Am","নিশ্চয়ই আমি"],["بِمَا","bimā","of what","সে সম্পর্কে যা"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা কাজ করো"],["عَلِيمٌۭ","‘alīmun","All-Knower","খুব অবহিত"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</><l>ل</>رُّسُلُ كُلُو<s>ا۟</> مِنَ <h>ٱ</><l>ل</>طَّيِّ<m>بَٰ</>تِ وَ<h>ٱ</>عْمَلُو<s>ا۟</> <m>صَٰ</>لِحًا ۖ إِ<g>نِّ</>ى بِمَا تَعْمَلُونَ عَ<p>لِي</>مٌۭ"},{"n":52,"w":[["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["هَـٰذِهِۦٓ","hādhihi","this","এই"],["أُمَّتُكُمْ","ummatukum","your religion","তোমাদের জাতি"],["أُمَّةًۭ","ummatan","(is) religion","জাতি"],["وَٰحِدَةًۭ","wāḥidatan","one","একই"],["وَأَنَا۠","wa-anā","And I Am","আর আমি"],["رَبُّكُمْ","rabbukum","your Lord","তোমাদে্র রব"],["فَٱتَّقُونِ","fa-ittaqūni","so fear Me","সুতরাং আমাকেই তোমরা ভয় করো"]],"t":"وَإِ<g>نَّ</> <m>هَٰ</>ذِ<o>هِۦٓ</> أُ<g>مَّ</>تُكُمْ أُ<g>مَّ</><d>ةًۭ وَٰ</>حِدَ<d>ةًۭ وَ</>أَنَا۠ رَبُّكُمْ فَ<h>ٱ</>تَّ<p>قُو</>نِ"},{"n":53,"w":[["فَتَقَطَّعُوٓا۟","fataqaṭṭa‘ū","But they cut off","কিন্তু (লোকেরা) বিভক্ত করলো"],["أَمْرَهُم","amrahum","their affair (of unity)","তাদের কাজকে"],["بَيْنَهُمْ","baynahum","between them","তাদের মাঝে"],["زُبُرًۭا ۖ","zuburan","(into) sects","টুকরো টুকরো করে"],["كُلُّ","kullu","each","প্রত্যেক"],["حِزْبٍۭ","ḥiz'bin","faction","দলই"],["بِمَا","bimā","in what","যা"],["لَدَيْهِمْ","ladayhim","they have","কাছে তাদের (আছে)"],["فَرِحُونَ","fariḥūna","rejoicing","(তা নিয়েই) আনন্দিত"]],"t":"فَتَقَطَّ<o>عُوٓ</><s>ا۟</> أَمْرَ<f>هُم بَ</>يْنَهُمْ زُبُ<k>رًۭا ۖ كُ</>لُّ حِزْ<i>بٍۭ بِ</>مَا لَدَيْهِمْ فَرِ<p>حُو</>نَ"},{"n":54,"w":[["فَذَرْهُمْ","fadharhum","So leave them","সুতরাং ছেড়ে দাও তাদেরকে"],["فِى","fī","in","মধ্যে"],["غَمْرَتِهِمْ","ghamratihim","their confusion","তাদের বিভ্রান্তির"],["حَتَّىٰ","ḥattā","until","পর্যন্ত"],["حِينٍ","ḥīnin","a time","এক নির্দিষ্ট সময়"]],"t":"فَذَرْهُمْ فِى غَمْرَتِهِمْ حَتَّىٰ <p>حِي</>نٍ"},{"n":55,"w":[["أَيَحْسَبُونَ","ayaḥsabūna","Do they think","কি তারা মনে করেছে"],["أَنَّمَا","annamā","that what","যেহেতু"],["نُمِدُّهُم","numidduhum","We extend to them","সাহায্য করে যাচ্ছি আমরা তাদের"],["بِهِۦ","bihi","[with it]","মাধ্যমে তার"],["مِن","min","of","দিয়ে"],["مَّالٍۢ","mālin","wealth","ধন-সম্পদ"],["وَبَنِينَ","wabanīna","and children","ও সন্তান-সন্তুতি"]],"t":"أَيَحْسَبُونَ أَ<g>نَّ</>مَا نُمِدُّ<f>هُم بِ</><m>هِۦ</> <d>مِن مَّالٍۢ وَ</>بَ<p>نِي</>نَ"},{"n":56,"w":[["نُسَارِعُ","nusāri‘u","We hasten","আমরা দ্রুত নিয়ে যাচ্ছি"],["لَهُمْ","lahum","to them","তাদেরকে"],["فِى","fī","in","দিকে"],["ٱلْخَيْرَٰتِ ۚ","l-khayrāti","the good","কল্যাণের"],["بَل","bal","Nay","বরং"],["لَّا","lā","not","না"],["يَشْعُرُونَ","yash‘urūna","they perceive","তারা বুঝে"]],"t":"نُسَارِعُ لَهُمْ فِى <h>ٱ</>لْخَيْ<m>رَٰ</>تِ ۚ بَل لَّا يَشْعُ<p>رُو</>نَ"},{"n":57,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যাদের (অবস্থা এই যে)"],["هُم","hum","[they]","তারা"],["مِّنْ","min","from","কারণে"],["خَشْيَةِ","khashyati","(the) fear","ভয়ের"],["رَبِّهِم","rabbihim","(of) their Lord","তাদের রবের"],["مُّشْفِقُونَ","mush'fiqūna","(are) cautious","ভীত-সন্ত্রস্ত"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ <y>هُم مِّ</>نْ خَشْيَةِ رَبِّ<y>هِم مُّ</>شْفِ<p>قُو</>نَ"},{"n":58,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those","এবং যাদের (অবস্থা এই যে)"],["هُم","hum","[they]","তারা"],["بِـَٔايَـٰتِ","biāyāti","in (the) Signs","উপর আয়াতসমূহের"],["رَبِّهِمْ","rabbihim","(of) their Lord","তাদের রবের"],["يُؤْمِنُونَ","yu'minūna","believe","ঈমান আনে"]],"t":"وَ<h>ٱ</>لَّذِينَ <f>هُم بِـَٔ</>ا<m>يَٰ</>تِ رَبِّهِمْ يُؤْمِ<p>نُو</>نَ"},{"n":59,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those","এবং যাদের (অবস্থা এই যে)"],["هُم","hum","[they]","তারা"],["بِرَبِّهِمْ","birabbihim","with their Lord","সাথে তাদের রবের"],["لَا","lā","(do) not","না"],["يُشْرِكُونَ","yush'rikūna","associate partners","শরীক করে (কাউকে)"]],"t":"وَ<h>ٱ</>لَّذِينَ <f>هُم بِ</>رَبِّهِمْ لَا يُشْرِ<p>كُو</>نَ"},{"n":60,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা (এমন যে)"],["يُؤْتُونَ","yu'tūna","give","(যখন) দান করে"],["مَآ","mā","what","যা কিছু"],["ءَاتَوا۟","ātaw","they give","দান করার"],["وَّقُلُوبُهُمْ","waqulūbuhum","while their hearts","এ অবস্থায় যে তাদের অন্তর"],["وَجِلَةٌ","wajilatun","(are) fearful","কম্পিত থাকে"],["أَنَّهُمْ","annahum","because they","(এ ভেবে) যে তারা"],["إِلَىٰ","ilā","to","দিকে"],["رَبِّهِمْ","rabbihim","their Lord","তাদের রবের"],["رَٰجِعُونَ","rāji‘ūna","(will) return","প্রত্যাবর্তনকারী"]],"t":"وَ<h>ٱ</>لَّذِينَ يُؤْتُونَ <o>مَآ</> ءَاتَو<s>ا۟</> وَّقُلُوبُهُمْ وَجِلَةٌ أَ<g>نَّ</>هُمْ إِلَىٰ رَبِّهِمْ <m>رَٰ</>جِ<p>عُو</>نَ"},{"n":61,"w":[["أُو۟لَـٰٓئِكَ","ulāika","(It is) those","ঐসবলোক"],["يُسَـٰرِعُونَ","yusāri‘ūna","who hasten","দ্রুত সম্পাদন করে"],["فِى","fī","in","দিকে"],["ٱلْخَيْرَٰتِ","l-khayrāti","the good (deeds)","কল্যাণের"],["وَهُمْ","wahum","and they","আর তারাই"],["لَهَا","lahā","in them","জন্যে তার"],["سَـٰبِقُونَ","sābiqūna","(are) foremost","অগ্রগামী হয়"]],"t":"أُ<s>و۟</><o>لَٰٓ</>ئِكَ يُ<m>سَٰ</>رِعُونَ فِى <h>ٱ</>لْخَيْ<m>رَٰ</>تِ وَهُمْ لَهَا <m>سَٰ</>بِ<p>قُو</>نَ"},{"n":62,"w":[["وَلَا","walā","And not","এবং না"],["نُكَلِّفُ","nukallifu","We burden","দায়িত্ব দিই আমরা"],["نَفْسًا","nafsan","any soul","কাউকে"],["إِلَّا","illā","except","এ ছাড়া"],["وُسْعَهَا ۖ","wus'‘ahā","(to) its capacity","তার সাধ্য"],["وَلَدَيْنَا","waladaynā","and with Us","আর আমাদের কাছে (আছে)"],["كِتَـٰبٌۭ","kitābun","(is) a Record","এক কিতাব (আমলনামা)"],["يَنطِقُ","yanṭiqu","(which) speaks","ব্যক্ত করে (যা)"],["بِٱلْحَقِّ ۚ","bil-ḥaqi","with the truth","ভাবে যথাযথ"],["وَهُمْ","wahum","and they","এবং তাদেরকে"],["لَا","lā","(will) not","না"],["يُظْلَمُونَ","yuẓ'lamūna","be wronged","অত্যাচার করা হবে"]],"t":"وَلَا نُكَلِّفُ نَفْسًا إِلَّا وُسْعَهَا ۖ وَلَدَيْنَا كِ<m>تَٰ</><d>بٌۭ يَ</><k>نطِ</>قُ بِ<h>ٱ</>لْحَقِّ ۚ وَهُمْ لَا يُظْلَ<p>مُو</>نَ"},{"n":63,"w":[["بَلْ","bal","Nay","বরং"],["قُلُوبُهُمْ","qulūbuhum","their hearts","তাদের অন্তর (রয়েছে)"],["فِى","fī","(are) in","মধ্যে"],["غَمْرَةٍۢ","ghamratin","confusion","অজ্ঞানতার"],["مِّنْ","min","over","হ'তে"],["هَـٰذَا","hādhā","this","এ (বিষয়ে)"],["وَلَهُمْ","walahum","and for them","আর রয়েছে তাদের"],["أَعْمَـٰلٌۭ","a‘mālun","(are) deeds","অনেক কাজ"],["مِّن","min","besides","থেকে"],["دُونِ","dūni","besides","ছাড়া"],["ذَٰلِكَ","dhālika","that","এই (পূর্ব বর্ণিত নিয়মের)"],["هُمْ","hum","they","তারা"],["لَهَا","lahā","for it","জন্যে যার"],["عَـٰمِلُونَ","‘āmilūna","(are) doers","করে যাচ্ছে"]],"t":"بَلْ قُلُوبُهُمْ فِى غَمْرَ<d>ةٍۢ مِّ</>نْ <m>هَٰ</>ذَا وَلَهُمْ أَعْ<m>مَٰ</><d>لٌۭ مِّ</><k>ن دُ</>ونِ <m>ذَٰ</>لِكَ هُمْ لَهَا <m>عَٰ</>مِ<p>لُو</>نَ"},{"n":64,"w":[["حَتَّىٰٓ","ḥattā","Until","শেষ পর্যন্ত"],["إِذَآ","idhā","when","যখন"],["أَخَذْنَا","akhadhnā","We seize","আমরা পাকড়াও করবো"],["مُتْرَفِيهِم","mut'rafīhim","their affluent ones","তাদের ঐশ্বর্যশালীদেরকে"],["بِٱلْعَذَابِ","bil-‘adhābi","with the punishment","দিয়ে শাস্তি"],["إِذَا","idhā","behold","তখন"],["هُمْ","hum","They","তারা"],["يَجْـَٔرُونَ","yajarūna","cry for help","চিৎকার করে উঠবে"]],"t":"حَتَّ<o>ىٰٓ</> إِ<o>ذَآ</> أَخَذْنَا مُتْرَفِي<f>هِم بِ</><h>ٱ</>لْعَذَابِ إِذَا هُمْ يَ<q>جْـَٔ</><p>رُو</>نَ"},{"n":65,"w":[["لَا","lā","(Do) not","\"না"],["تَجْـَٔرُوا۟","tajarū","cry for help","(বলা হবে) চিৎকার করো"],["ٱلْيَوْمَ ۖ","l-yawma","today","আজ"],["إِنَّكُم","innakum","Indeed, you","নিশ্চয়ই তোমাদেরকে"],["مِّنَّا","minnā","from Us","আমাদের হ'তে"],["لَا","lā","not","না"],["تُنصَرُونَ","tunṣarūna","will be helped","সাহায্য করা হবে"]],"t":"لَا تَ<q>جْـَٔ</>رُو<s>ا۟</> <h>ٱ</>لْيَوْمَ ۖ إِ<g>نَّ</><y>كُم مِّ</><g>نَّ</>ا لَا تُ<k>نصَ</><p>رُو</>نَ"},{"n":66,"w":[["قَدْ","qad","Verily","নিশ্চয়ই"],["كَانَتْ","kānat","were","হতো"],["ءَايَـٰتِى","āyātī","My Verses","আমার আয়াতগুলোকে"],["تُتْلَىٰ","tut'lā","recited","তিলাওয়াত করা হতো"],["عَلَيْكُمْ","‘alaykum","to you","তোমাদের কাছে"],["فَكُنتُمْ","fakuntum","but you used","তখন তোমরা ছিলে"],["عَلَىٰٓ","‘alā","(to) on","উপর"],["أَعْقَـٰبِكُمْ","a‘qābikum","your heels","তোমাদের গোড়ালির (পিছনে)"],["تَنكِصُونَ","tankiṣūna","turn back","পিছিয়ে আসতে"]],"t":"قَ<q>دْ</> كَانَتْ ءَا<m>يَٰ</>تِى تُتْلَىٰ عَلَيْكُمْ فَكُ<k>نتُ</>مْ عَلَ<o>ىٰٓ</> أَعْ<m>قَٰ</>بِكُمْ تَ<k>نكِ</><p>صُو</>نَ"},{"n":67,"w":[["مُسْتَكْبِرِينَ","mus'takbirīna","(Being) arrogant","অহংকারী হয়ে (গুরুত্ব দিতে না)"],["بِهِۦ","bihi","about it","সম্পর্কে এ"],["سَـٰمِرًۭا","sāmiran","conversing by night","গল্পগুজবে মেতে"],["تَهْجُرُونَ","tahjurūna","speaking evil","তোমরা অর্থহীন কথা বলতে\""]],"t":"مُسْتَكْبِرِينَ بِ<m>هِۦ سَٰ</>مِ<k>رًۭا تَ</>هْجُ<p>رُو</>نَ"},{"n":68,"w":[["أَفَلَمْ","afalam","Then, do not","কি তবে না"],["يَدَّبَّرُوا۟","yaddabbarū","they ponder","তারা চিন্তা ভাবনা করে"],["ٱلْقَوْلَ","l-qawla","the Word","(এই) বাণী (সম্পর্কে)"],["أَمْ","am","or","অথবা"],["جَآءَهُم","jāahum","has come to them","(সে) এসেছে তাদের (কাছে)"],["مَّا","mā","what","(এমন কিছু নিয়ে) যা"],["لَمْ","lam","not","নি"],["يَأْتِ","yati","(had) come","আসে"],["ءَابَآءَهُمُ","ābāahumu","(to) their forefathers","তাদের পিতৃপুরুষদের (কাছে)"],["ٱلْأَوَّلِينَ","l-awalīna","(to) their forefathers","পূর্বেকার"]],"t":"أَفَلَمْ يَدَّبَّرُو<s>ا۟</> <h>ٱ</>لْقَوْلَ أَمْ <o>جَآ</>ءَ<y>هُم مَّ</>ا لَمْ يَأْتِ ءَا<o>بَآ</>ءَهُمُ <h>ٱ</>لْأَوَّ<p>لِي</>نَ"},{"n":69,"w":[["أَمْ","am","Or","অথবা"],["لَمْ","lam","(do) not","না"],["يَعْرِفُوا۟","ya‘rifū","they recognize","তারা চিনে"],["رَسُولَهُمْ","rasūlahum","their Messenger","তাদের রাসূলকে"],["فَهُمْ","fahum","so they","তাই তারা"],["لَهُۥ","lahu","(are) rejecting him","প্রতি তার"],["مُنكِرُونَ","munkirūna","(are) rejecting him","অস্বীকারকারী হয়েছে"]],"t":"أَمْ لَمْ يَعْرِفُو<s>ا۟</> رَسُولَهُمْ فَهُمْ لَهُ<m>ۥ</> مُ<k>نكِ</><p>رُو</>نَ"},{"n":70,"w":[["أَمْ","am","Or","অথবা"],["يَقُولُونَ","yaqūlūna","they say","তারা বলে"],["بِهِۦ","bihi","In him","\"তার সাথে (আছে)"],["جِنَّةٌۢ ۚ","jinnatun","(is) madness","জ্বিন\""],["بَلْ","bal","Nay","বরং"],["جَآءَهُم","jāahum","he brought them","সে এসেছে তাদের (নিকট)"],["بِٱلْحَقِّ","bil-ḥaqi","the truth","নিয়ে সত্যকে"],["وَأَكْثَرُهُمْ","wa-aktharuhum","but most of them","অথচ অধিকাংশ তাদের"],["لِلْحَقِّ","lil'ḥaqqi","to the truth","প্রতি সত্যের"],["كَـٰرِهُونَ","kārihūna","(are) averse","অপছন্দকারী"]],"t":"أَمْ يَقُولُونَ بِ<m>هِۦ</> جِ<g>نَّ</><i>ةٌۢ ۚ بَ</>لْ <o>جَآ</>ءَ<f>هُم بِ</><h>ٱ</>لْحَقِّ وَأَكْثَرُهُمْ لِلْحَقِّ <m>كَٰ</>رِ<p>هُو</>نَ"},{"n":71,"w":[["وَلَوِ","walawi","But if","আর যদি"],["ٱتَّبَعَ","ittaba‘a","(had) followed","অনুসরণ করতো"],["ٱلْحَقُّ","l-ḥaqu","the truth","সত্য্"],["أَهْوَآءَهُمْ","ahwāahum","their desires","কামনা-বাসনার তাদের"],["لَفَسَدَتِ","lafasadati","surely (would) have been corrupted","অবশ্যই বিশৃঙ্খল হয়ে পড়তো"],["ٱلسَّمَـٰوَٰتُ","l-samāwātu","the heavens","আকাশমন্ডলি"],["وَٱلْأَرْضُ","wal-arḍu","and the earth","ও পৃথিবী"],["وَمَن","waman","and whoever","আর যাকিছু (আছে)"],["فِيهِنَّ ۚ","fīhinna","(is) therein","তাদের মাঝে"],["بَلْ","bal","Nay","বরং"],["أَتَيْنَـٰهُم","ataynāhum","We have brought them","তাদেরকে আমরা দিয়েছি"],["بِذِكْرِهِمْ","bidhik'rihim","their reminder","বিষয়কে তাদের উপদেশের (অর্থাৎ কুরআন)"],["فَهُمْ","fahum","but they","কিন্তু তারা"],["عَن","‘an","from","হ'তে"],["ذِكْرِهِم","dhik'rihim","their reminder","উপদেশ তাদের"],["مُّعْرِضُونَ","mu‘'riḍūna","(are) turning away","মুখ ফিরিয়ে নিচ্ছে"]],"t":"وَلَوِ <h>ٱ</>تَّبَعَ <h>ٱ</>لْحَقُّ أَهْ<o>وَآ</>ءَهُمْ لَفَسَدَتِ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تُ وَ<h>ٱ</>لْأَرْضُ وَمَ<k>ن فِ</>يهِ<g>نَّ</> ۚ بَلْ أَتَيْ<m>نَٰ</><f>هُم بِ</>ذِكْرِهِمْ فَهُمْ عَ<k>ن ذِ</>كْرِ<y>هِم مُّ</>عْرِ<p>ضُو</>نَ"},{"n":72,"w":[["أَمْ","am","Or","অথবা কি"],["تَسْـَٔلُهُمْ","tasaluhum","you ask them","তাদের (নিকট) তুমি চাচ্ছো"],["خَرْجًۭا","kharjan","(for) a payment","কোন প্রতিদান"],["فَخَرَاجُ","fakharāju","But the payment","অথচ প্রতিদান"],["رَبِّكَ","rabbika","(of) your Lord","তোমার রবেরই"],["خَيْرٌۭ ۖ","khayrun","(is) best","উত্তম"],["وَهُوَ","wahuwa","and He","আর তিনিই"],["خَيْرُ","khayru","(is) the Best","উত্তম"],["ٱلرَّٰزِقِينَ","l-rāziqīna","(of) the Providers","জীবিকাদাতাদের"]],"t":"أَمْ تَسْـَٔلُهُمْ خَرْ<k>جًۭا فَ</>خَرَاجُ رَبِّكَ خَيْ<d>رٌۭ ۖ وَ</>هُوَ خَيْرُ <h>ٱ</><l>ل</><m>رَّٰ</>زِ<p>قِي</>نَ"},{"n":73,"w":[["وَإِنَّكَ","wa-innaka","And indeed, you","আর তুমি নিশ্চয়ই"],["لَتَدْعُوهُمْ","latad‘ūhum","certainly call them","অবশ্যই ডাকছো তাদেরকে"],["إِلَىٰ","ilā","to","দিকে"],["صِرَٰطٍۢ","ṣirāṭin","(the) Path","পথের"],["مُّسْتَقِيمٍۢ","mus'taqīmin","Straight","সরল-সোজা"]],"t":"وَإِ<g>نَّ</>كَ لَتَ<q>دْ</>عُوهُمْ إِلَىٰ صِ<m>رَٰ</><d>طٍۢ مُّ</>سْتَ<p>قِي</>مٍۢ"},{"n":74,"w":[["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["لَا","lā","(do) not","না"],["يُؤْمِنُونَ","yu'minūna","believe","ঈমান আনে"],["بِٱلْـَٔاخِرَةِ","bil-ākhirati","in the Hereafter","প্রতি আখিরাতের"],["عَنِ","‘ani","from","(তারাই) হ'তে"],["ٱلصِّرَٰطِ","l-ṣirāṭi","the path","সরল সঠিক পথ"],["لَنَـٰكِبُونَ","lanākibūna","surely (are) deviating","অবশ্যই বিচ্যুত"]],"t":"وَإِ<g>نَّ</> <h>ٱ</>لَّذِينَ لَا يُؤْمِنُونَ بِ<h>ٱ</>لْءَاخِرَةِ عَنِ <h>ٱ</><l>ل</>صِّ<m>رَٰ</>طِ لَ<m>نَٰ</>كِ<p>بُو</>نَ"},{"n":75,"w":[["۞ وَلَوْ","walaw","And if","আর যদি"],["رَحِمْنَـٰهُمْ","raḥim'nāhum","We had mercy on them","তাদেরকে আমরা দয়া করি"],["وَكَشَفْنَا","wakashafnā","and We removed","ও আমরা দূর করে দিই"],["مَا","mā","what","যা (আছে)"],["بِهِم","bihim","(was) on them","উপর তাদের"],["مِّن","min","of","থেকে"],["ضُرٍّۢ","ḍurrin","(the) hardship","দুঃখ কষ্ট (তবুও)"],["لَّلَجُّوا۟","lalajjū","surely they would persist","লেগে থাকবেই তারা"],["فِى","fī","in","মধ্যে"],["طُغْيَـٰنِهِمْ","ṭugh'yānihim","their transgression","তাদের অবাধ্যতার"],["يَعْمَهُونَ","ya‘mahūna","wandering blindly","দিশেহারা হয়ে ঘুরবে"]],"t":"۞ وَلَوْ رَحِمْ<m>نَٰ</>هُمْ وَكَشَفْنَا مَا بِ<y>هِم مِّ</><k>ن ضُ</><w>رٍّۢ لَّ</>لَجُّو<s>ا۟</> فِى طُغْ<m>يَٰ</>نِهِمْ يَعْمَ<p>هُو</>نَ"},{"n":76,"w":[["وَلَقَدْ","walaqad","And verily","এবং নিশ্চয়ই"],["أَخَذْنَـٰهُم","akhadhnāhum","We seized them","তাদেরকে আমরা ধরেছি"],["بِٱلْعَذَابِ","bil-‘adhābi","with the punishment","দিয়ে শাস্তি"],["فَمَا","famā","but not","কিন্তু না"],["ٱسْتَكَانُوا۟","is'takānū","they submit","তারা বিনত হলো"],["لِرَبِّهِمْ","lirabbihim","to their Lord","প্রতি তাদের রবের"],["وَمَا","wamā","and not","আর না"],["يَتَضَرَّعُونَ","yataḍarra‘ūna","they supplicate humbly","তারা কাতর প্রার্থনা করলো"]],"t":"وَلَقَ<q>دْ</> أَخَذْ<m>نَٰ</><f>هُم بِ</><h>ٱ</>لْعَذَابِ فَمَا <h>ٱ</>سْتَكَانُو<s>ا۟</> لِرَبِّهِمْ وَمَا يَتَضَرَّ<p>عُو</>نَ"},{"n":77,"w":[["حَتَّىٰٓ","ḥattā","Until","শেষ পর্যন্ত"],["إِذَا","idhā","when","যখন"],["فَتَحْنَا","fataḥnā","We opened","আমরা খুলে দিই"],["عَلَيْهِم","‘alayhim","for them","তাদের উপর"],["بَابًۭا","bāban","a gate","দরজা"],["ذَا","dhā","of a punishment","সম্পন্ন"],["عَذَابٍۢ","‘adhābin","of a punishment","শাস্তি"],["شَدِيدٍ","shadīdin","severe","কঠিন"],["إِذَا","idhā","behold","তখন"],["هُمْ","hum","They","তারা"],["فِيهِ","fīhi","in it","তারা মধ্যে"],["مُبْلِسُونَ","mub'lisūna","(will be in) despair","হতাশ হয়ে পড়বে"]],"t":"حَتَّ<o>ىٰٓ</> إِذَا فَتَحْنَا عَلَيْ<f>هِم بَ</>ا<k>بًۭا ذَ</>ا عَذَا<k>بٍۢ شَ</>دِيدٍ إِذَا هُمْ فِيهِ مُ<q>بْ</>لِ<p>سُو</>نَ"},{"n":78,"w":[["وَهُوَ","wahuwa","And He","এবং তিনিই (আল্লাহ)"],["ٱلَّذِىٓ","alladhī","(is) the One Who","যিনি"],["أَنشَأَ","ansha-a","produced","সৃষ্টি করেছেন"],["لَكُمُ","lakumu","for you","জন্যে তোমাদের"],["ٱلسَّمْعَ","l-sam‘a","the hearing","(শ্রবণশক্তির) কান"],["وَٱلْأَبْصَـٰرَ","wal-abṣāra","and the sight","ও (দর্শনশক্তির) চোখ"],["وَٱلْأَفْـِٔدَةَ ۚ","wal-afidata","and the feeling","হৃদয়"],["قَلِيلًۭا","qalīlan","little","কমই"],["مَّا","mā","(is) what","যা"],["تَشْكُرُونَ","tashkurūna","you give thanks","তোমরা কৃতজ্ঞতা প্রকাশ করো"]],"t":"وَهُوَ <h>ٱ</>لَّ<o>ذِىٓ</> أَ<k>نشَ</>أَ لَكُمُ <h>ٱ</><l>ل</>سَّمْعَ وَ<h>ٱ</>لْأَ<q>بْ</><m>صَٰ</>رَ وَ<h>ٱ</>لْأَفْـِٔدَةَ ۚ قَلِيلًۭ<d>ا مَّ</>ا تَشْكُ<p>رُو</>نَ"},{"n":79,"w":[["وَهُوَ","wahuwa","And He","এবং তিনিই (আল্লাহ)"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["ذَرَأَكُمْ","dhara-akum","multiplied you","তোমাদেরকে ছড়িয়ে দিয়েছেন"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","জমিনের"],["وَإِلَيْهِ","wa-ilayhi","and to Him","আর তাঁরই দিকে"],["تُحْشَرُونَ","tuḥ'sharūna","you will be gathered","তোমাদেরকে একত্র করা হবে"]],"t":"وَهُوَ <h>ٱ</>لَّذِى ذَرَأَكُمْ فِى <h>ٱ</>لْأَرْضِ وَإِلَيْهِ تُحْشَ<p>رُو</>نَ"},{"n":80,"w":[["وَهُوَ","wahuwa","And He","এবং তিনিই (আল্লাহ)"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["يُحْىِۦ","yuḥ'yī","gives life","জীবনদান করেন"],["وَيُمِيتُ","wayumītu","and causes death","ও মৃত্যু দেন"],["وَلَهُ","walahu","and for Him","আর  রয়েছে তাঁরই (কর্তৃত্ব)"],["ٱخْتِلَـٰفُ","ikh'tilāfu","(is the) alternation","আবর্তন"],["ٱلَّيْلِ","al-layli","(of) the night","রাতের"],["وَٱلنَّهَارِ ۚ","wal-nahāri","and the day","ও দিনের"],["أَفَلَا","afalā","Then will not","কি তবুও না"],["تَعْقِلُونَ","ta‘qilūna","you reason","তোমরা বুঝবে"]],"t":"وَهُوَ <h>ٱ</>لَّذِى يُحْ<m>ىِۦ</> وَيُمِيتُ وَلَهُ <h>ٱ</>خْتِ<m>لَٰ</>فُ <h>ٱ</>لَّيْلِ وَ<h>ٱ</><l>ل</><g>نَّ</>هَارِ ۚ أَفَلَا تَعْقِ<p>لُو</>نَ"},{"n":81,"w":[["بَلْ","bal","Nay","বরং"],["قَالُوا۟","qālū","they say","তারা বলে"],["مِثْلَ","mith'la","(the) like","তেমনই"],["مَا","mā","(of) what","যা"],["قَالَ","qāla","said","বলেছিলো"],["ٱلْأَوَّلُونَ","l-awalūna","the former (people)","পূর্ববর্তীরা"]],"t":"بَلْ قَالُو<s>ا۟</> مِثْلَ مَا قَالَ <h>ٱ</>لْأَوَّ<p>لُو</>نَ"},{"n":82,"w":[["قَالُوٓا۟","qālū","They said","তারা বলে"],["أَءِذَا","a-idhā","What! When","\"কি যখন"],["مِتْنَا","mit'nā","we are dead","আমরা মরে যাবো"],["وَكُنَّا","wakunnā","and become","ও আমরা হয়ে যাবো"],["تُرَابًۭا","turāban","dust","মাটি"],["وَعِظَـٰمًا","wa‘iẓāman","and bones","ও হাড়"],["أَءِنَّا","a-innā","would we","কি নিশ্চয়ই আমরা"],["لَمَبْعُوثُونَ","lamab‘ūthūna","surely be resurrected","অবশ্যই উত্থিত হবো"]],"t":"قَا<o>لُوٓ</><s>ا۟</> أَءِذَا مِتْنَا وَكُ<g>نَّ</>ا تُرَا<d>بًۭا وَ</>عِ<m>ظَٰ</>مًا أَءِ<g>نَّ</>ا لَمَ<q>بْ</>عُو<p>ثُو</>نَ"},{"n":83,"w":[["لَقَدْ","laqad","Verily","নিশ্চয়ই"],["وُعِدْنَا","wu‘id'nā","we have been promised","প্রতিশ্রুতি দেয়া হয়েছে"],["نَحْنُ","naḥnu","[we]","আমরা (আমাদেরকে)"],["وَءَابَآؤُنَا","waābāunā","and our forefathers","ও আমাদের পূর্ব পুরুষদেরকে"],["هَـٰذَا","hādhā","this","এটা"],["مِن","min","before","থেকে"],["قَبْلُ","qablu","before","ইতিপূর্ব"],["إِنْ","in","not","নয়"],["هَـٰذَآ","hādhā","(is) this","এটা"],["إِلَّآ","illā","but","এ ছাড়া"],["أَسَـٰطِيرُ","asāṭīru","(the) tales","উপকথা"],["ٱلْأَوَّلِينَ","l-awalīna","(of) the former (people)","পূর্ববর্তীদের\""]],"t":"لَقَ<q>دْ</> وُعِ<q>دْ</>نَا نَحْنُ وَءَا<o>بَآ</>ؤُنَا <m>هَٰ</>ذَا مِ<k>ن قَ</><q>بْ</>لُ إِنْ <m>هَٰ</><o>ذَآ</> إِ<o>لَّآ</> أَ<m>سَٰ</>طِيرُ <h>ٱ</>لْأَوَّ<p>لِي</>نَ"},{"n":84,"w":[["قُل","qul","Say","বলো"],["لِّمَنِ","limani","To whom (belongs)","\"জন্যে কার (মালিকানায়)"],["ٱلْأَرْضُ","l-arḍu","the earth","(এই) পৃথিবী"],["وَمَن","waman","and whoever","ও যা কিছু (আছে)"],["فِيهَآ","fīhā","(is) in it","তার মধ্যে"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you","(তোমরা)"],["تَعْلَمُونَ","ta‘lamūna","know","তোমরা জেনে থাকো\""]],"t":"قُل لِّمَنِ <h>ٱ</>لْأَرْضُ وَمَ<k>ن فِ</>ي<o>هَآ</> إِ<k>ن كُنتُ</>مْ تَعْلَ<p>مُو</>نَ"},{"n":85,"w":[["سَيَقُولُونَ","sayaqūlūna","They will say","অচিরেই তারা বলবে"],["لِلَّهِ ۚ","lillahi","To Allah","\"জন্যে আল্লাহ্‌রই\""],["قُلْ","qul","Say","বলো"],["أَفَلَا","afalā","Then will not","\"কি তবুও না"],["تَذَكَّرُونَ","tadhakkarūna","you remember","তোমরা শিক্ষা নিবে\""]],"t":"سَيَقُولُونَ لِلَّهِ ۚ قُلْ أَفَلَا تَذَكَّ<p>رُو</>نَ"},{"n":86,"w":[["قُلْ","qul","Say","বলো"],["مَن","man","Who","\"কে"],["رَّبُّ","rabbu","(is the) Lord","রব"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the seven heavens","আকাশের"],["ٱلسَّبْعِ","l-sab‘i","(of) the seven heavens","সাত"],["وَرَبُّ","warabbu","and (the) Lord","ও রব"],["ٱلْعَرْشِ","l-‘arshi","(of) the Throne","আরশের"],["ٱلْعَظِيمِ","l-‘aẓīmi","the Great","মহান\""]],"t":"قُلْ <w>مَن رَّ</>بُّ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ <h>ٱ</><l>ل</>سَّ<q>بْ</>عِ وَرَبُّ <h>ٱ</>لْعَرْشِ <h>ٱ</>لْعَ<p>ظِي</>مِ"},{"n":87,"w":[["سَيَقُولُونَ","sayaqūlūna","They will say","তারা বলবে"],["لِلَّهِ ۚ","lillahi","Allah","\"জন্যে আল্লাহর (উলুহিয়াত)\""],["قُلْ","qul","Say","বলো"],["أَفَلَا","afalā","Then will not","\"কি তবুও না"],["تَتَّقُونَ","tattaqūna","you fear (Him)","তোমরা ভয় করবে\""]],"t":"سَيَقُولُونَ لِلَّهِ ۚ قُلْ أَفَلَا تَتَّ<p>قُو</>نَ"},{"n":88,"w":[["قُلْ","qul","Say","বলো"],["مَنۢ","man","Who is (it)","কে (এমন)"],["بِيَدِهِۦ","biyadihi","in Whose Hand(s)","যার হাতে (রয়েছে)"],["مَلَكُوتُ","malakūtu","(is the) dominion","কর্তৃত্ব"],["كُلِّ","kulli","(of) all","সব"],["شَىْءٍۢ","shayin","things","কিছুর"],["وَهُوَ","wahuwa","and He","এবং তিনিই"],["يُجِيرُ","yujīru","protects","আশ্রয় দেন"],["وَلَا","walā","and no (one)","অথচ না"],["يُجَارُ","yujāru","(can) be protected","আশ্রয় দিতে পারে কেউ"],["عَلَيْهِ","‘alayhi","against Him","তাঁর বিপক্ষে"],["إِن","in","If","যদি"],["كُنتُمْ","kuntum","you","তোমরা থাকো"],["تَعْلَمُونَ","ta‘lamūna","know","তোমরা জেনে\""]],"t":"قُلْ <i>مَنۢ بِ</>يَدِ<m>هِۦ</> مَلَكُوتُ كُلِّ <d>شَىْءٍۢ وَ</>هُوَ يُجِيرُ وَلَا يُجَارُ عَلَيْهِ إِ<k>ن كُنتُ</>مْ تَعْلَ<p>مُو</>نَ"},{"n":89,"w":[["سَيَقُولُونَ","sayaqūlūna","They will say","অচিরেই তারা বলবে"],["لِلَّهِ ۚ","lillahi","Allah","\"জন্যে আল্লাহ্‌রই\""],["قُلْ","qul","Say","বলো"],["فَأَنَّىٰ","fa-annā","Then how","\"তাহ'লে কোথা (হ'তে)"],["تُسْحَرُونَ","tus'ḥarūna","are you deluded","তোমাদেরকে জাদু করা হচ্ছে\""]],"t":"سَيَقُولُونَ لِلَّهِ ۚ قُلْ فَأَ<g>نَّ</>ىٰ تُسْحَ<p>رُو</>نَ"},{"n":90,"w":[["بَلْ","bal","Nay","বরং"],["أَتَيْنَـٰهُم","ataynāhum","We (have) brought them","আমরা এসেছি তাদের কাছে"],["بِٱلْحَقِّ","bil-ḥaqi","the truth","নিয়ে মহাসত্যকে"],["وَإِنَّهُمْ","wa-innahum","but indeed, they","আর নিশ্চয়ই তারা"],["لَكَـٰذِبُونَ","lakādhibūna","surely, (are) liars","অবশ্যই মিথ্যাবাদী"]],"t":"بَلْ أَتَيْ<m>نَٰ</><f>هُم بِ</><h>ٱ</>لْحَقِّ وَإِ<g>نَّ</>هُمْ لَ<m>كَٰ</>ذِ<p>بُو</>نَ"},{"n":91,"w":[["مَا","mā","Not","নি"],["ٱتَّخَذَ","ittakhadha","Allah has taken","গ্রহণ করেন"],["ٱللَّهُ","l-lahu","Allah has taken","আল্লাহ"],["مِن","min","any","(কাউকে) কোন"],["وَلَدٍۢ","waladin","son","সন্তান (হিসেবে)"],["وَمَا","wamā","and not","আর না"],["كَانَ","kāna","is","ছিলো (শরীক)"],["مَعَهُۥ","ma‘ahu","with Him","তাঁর সাথে"],["مِنْ","min","any","কোন"],["إِلَـٰهٍ ۚ","ilāhin","god","ইলাহর"],["إِذًۭا","idhan","Then","যদি হতো (তবে)"],["لَّذَهَبَ","ladhahaba","surely (would have) taken away","অবশ্যই নিয়ে যেতো"],["كُلُّ","kullu","each","প্রত্যেক"],["إِلَـٰهٍۭ","ilāhin","god","ইলাহ"],["بِمَا","bimā","what","ঐসব যা কিছু"],["خَلَقَ","khalaqa","he created","সে সৃষ্টি করেছে"],["وَلَعَلَا","wala‘alā","and surely would have overpowered","ও প্রাধান্য বিস্তার করতো"],["بَعْضُهُمْ","ba‘ḍuhum","some of them","তাদের একে"],["عَلَىٰ","‘alā","[on]","উপর"],["بَعْضٍۢ ۚ","ba‘ḍin","others","অপরের"],["سُبْحَـٰنَ","sub'ḥāna","Glory be","পবিত্র"],["ٱللَّهِ","l-lahi","(to) Allah","আল্লাহ্‌"],["عَمَّا","‘ammā","above what","(তা) হ'তে যা"],["يَصِفُونَ","yaṣifūna","they attribute","তারা রচনা করে"]],"t":"مَا <h>ٱ</>تَّخَذَ <h>ٱ</>للَّهُ <d>مِن وَلَدٍۢ وَ</>مَا كَانَ مَعَهُ<m>ۥ</> مِنْ إِ<m>لَٰ</>هٍ ۚ إِ<w>ذًۭا لَّ</>ذَهَبَ كُلُّ إِ<m>لَٰ</><i>هٍۭ بِ</>مَا خَلَقَ وَلَعَلَا بَعْضُهُمْ عَلَىٰ بَعْ<k>ضٍۢ ۚ سُ</><q>بْ</><m>حَٰ</>نَ <h>ٱ</>للَّهِ عَ<g>مَّ</>ا يَصِ<p>فُو</>نَ"},{"n":92,"w":[["عَـٰلِمِ","‘ālimi","Knower","অবহিত"],["ٱلْغَيْبِ","l-ghaybi","(of) the unseen","অদৃশ্যের"],["وَٱلشَّهَـٰدَةِ","wal-shahādati","and the witnessed","ও দৃশ্যের"],["فَتَعَـٰلَىٰ","fata‘ālā","exalted is He","অতএব তিনি উর্দ্ধে"],["عَمَّا","‘ammā","above what","তা হ'তে যা কিছু"],["يُشْرِكُونَ","yush'rikūna","they associate","তারা শরীক করছে"]],"t":"<m>عَٰ</>لِمِ <h>ٱ</>لْغَيْبِ وَ<h>ٱ</><l>ل</>شَّ<m>هَٰ</>دَةِ فَتَ<m>عَٰ</>لَىٰ عَ<g>مَّ</>ا يُشْرِ<p>كُو</>نَ"},{"n":93,"w":[["قُل","qul","Say","বলো (দোয়া করো)"],["رَّبِّ","rabbi","My Lord","\"হে আমার রব"],["إِمَّا","immā","If","যদি"],["تُرِيَنِّى","turiyannī","You should show me","আমাকে দেখাও"],["مَا","mā","what","যা"],["يُوعَدُونَ","yū‘adūna","they are promised","তাদের প্রতিশ্রুতি দেয়া হচ্ছে"]],"t":"قُ<r>ل</> رَّبِّ إِ<g>مَّ</>ا تُرِيَ<g>نِّ</>ى مَا يُوعَ<p>دُو</>نَ"},{"n":94,"w":[["رَبِّ","rabbi","My Lord","হে আমার রব"],["فَلَا","falā","then (do) not","তবে না"],["تَجْعَلْنِى","taj‘alnī","place me","আমাকে করো তুমি"],["فِى","fī","among","অন্তর্ভুক্ত"],["ٱلْقَوْمِ","l-qawmi","the people ","সম্প্রদায়ের"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","সীমালঙ্ঘনকারী\""]],"t":"رَبِّ فَلَا تَ<q>جْ</>عَلْنِى فِى <h>ٱ</>لْقَوْمِ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":95,"w":[["وَإِنَّا","wa-innā","And indeed We","এবং নিশ্চয়ই আমরা"],["عَلَىٰٓ","‘alā","on","এক্ষেত্রে"],["أَن","an","that","যে"],["نُّرِيَكَ","nuriyaka","We show you","তোমাকে দেখাবো আমরা"],["مَا","mā","what","যা"],["نَعِدُهُمْ","na‘iduhum","We have promised them","আমরা প্রতিশ্রুতি দিয়েছি তাদেরকে"],["لَقَـٰدِرُونَ","laqādirūna","surely able","অবশ্যই (তা দেখাতে) সক্ষম"]],"t":"وَإِ<g>نَّ</>ا عَلَ<o>ىٰٓ</> <d>أَن نُّ</>رِيَكَ مَا نَعِدُهُمْ لَ<m>قَٰ</>دِ<p>رُو</>نَ"},{"n":96,"w":[["ٱدْفَعْ","id'fa‘","Repel","প্রতিহত করো"],["بِٱلَّتِى","bi-allatī","by that","দিয়ে তা"],["هِىَ","hiya","which","যা"],["أَحْسَنُ","aḥsanu","(is) best ","উত্তম"],["ٱلسَّيِّئَةَ ۚ","l-sayi-ata","the evil","মন্দের (মোকাবিলায়)"],["نَحْنُ","naḥnu","We","আমরা"],["أَعْلَمُ","a‘lamu","know best","খুব জানি"],["بِمَا","bimā","of what","ঐ বিষয় যা"],["يَصِفُونَ","yaṣifūna","they attribute","তারা বর্ণনা করে"]],"t":"ٱ<q>دْ</>فَعْ بِ<h>ٱ</>لَّتِى هِىَ أَحْسَنُ <h>ٱ</><l>ل</>سَّيِّئَةَ ۚ نَحْنُ أَعْلَمُ بِمَا يَصِ<p>فُو</>نَ"},{"n":97,"w":[["وَقُل","waqul","And say","এবং বলো (দু'আ করো)"],["رَّبِّ","rabbi","My Lord","\"হে আমার রব"],["أَعُوذُ","a‘ūdhu","I seek refuge","আমি আশ্রয় চাই"],["بِكَ","bika","in You","তোমার নিকট"],["مِنْ","min","from","হ'তে"],["هَمَزَٰتِ","hamazāti","(the) suggestions","প্ররোচনা"],["ٱلشَّيَـٰطِينِ","l-shayāṭīni","(of) the evil ones","শয়তানদের"]],"t":"وَقُ<r>ل</> رَّبِّ أَعُوذُ بِكَ مِنْ هَمَ<m>زَٰ</>تِ <h>ٱ</><l>ل</>شَّ<m>يَٰ</><p>طِي</>نِ"},{"n":98,"w":[["وَأَعُوذُ","wa-a‘ūdhu","And I seek refuge","ও আশ্রয় চাই আমি"],["بِكَ","bika","in You","নিকট তোমার"],["رَبِّ","rabbi","My Lord","হে আমার রব"],["أَن","an","Lest","যে"],["يَحْضُرُونِ","yaḥḍurūni","they be present with me","আমার নিকট (শয়তান) উপস্থিত হবে\""]],"t":"وَأَعُوذُ بِكَ رَبِّ <d>أَن يَ</>حْضُ<p>رُو</>نِ"},{"n":99,"w":[["حَتَّىٰٓ","ḥattā","Until","শেষ পর্যন্ত"],["إِذَا","idhā","when","যখন"],["جَآءَ","jāa","comes","আসবে"],["أَحَدَهُمُ","aḥadahumu","(to) one of them","কারো তাদের"],["ٱلْمَوْتُ","l-mawtu","the death","মৃত্যু"],["قَالَ","qāla","he says","সে বলবে"],["رَبِّ","rabbi","My Lord","\"হে আমার রব"],["ٱرْجِعُونِ","ir'ji‘ūni","Send me back","আমাকে ফেরত পাঠাও"]],"t":"حَتَّ<o>ىٰٓ</> إِذَا <o>جَآ</>ءَ أَحَدَهُمُ <h>ٱ</>لْمَوْتُ قَالَ رَبِّ <h>ٱ</>رْجِ<p>عُو</>نِ"},{"n":100,"w":[["لَعَلِّىٓ","la‘allī","That I may","যাতে আমি"],["أَعْمَلُ","a‘malu","do","কাজ করি"],["صَـٰلِحًۭا","ṣāliḥan","righteous (deeds)","সৎ"],["فِيمَا","fīmā","in what","(তার) মধ্যে যা"],["تَرَكْتُ ۚ","taraktu","I left behind","আমি ছেড়ে এসেছি\""],["كَلَّآ ۚ","kallā","No","কখনও না"],["إِنَّهَا","innahā","Indeed, it","নিশ্চয়ই তা"],["كَلِمَةٌ","kalimatun","(is) a word","একটি কথা (মাত্র)"],["هُوَ","huwa","he","সে"],["قَآئِلُهَا ۖ","qāiluhā","speaks it","যার উক্তিকারী"],["وَمِن","wamin","and before them","এবং থেকে"],["وَرَآئِهِم","warāihim","and before them","তাদের পিছনে (আছে)"],["بَرْزَخٌ","barzakhun","(is) a barrier","অন্তরায়"],["إِلَىٰ","ilā","till","পর্যন্ত"],["يَوْمِ","yawmi","(the) Day","সেদিন (যেদিন)"],["يُبْعَثُونَ","yub'‘athūna","they are resurrected","তারা উত্থিত হবে"]],"t":"لَعَ<o>لِّىٓ</> أَعْمَلُ <m>صَٰ</>لِ<k>حًۭا فِ</>يمَا تَرَكْتُ ۚ كَ<o>لَّآ ۚ</> إِ<g>نَّ</>هَا كَلِمَةٌ هُوَ <o>قَآ</>ئِلُهَا ۖ وَ<d>مِن وَ</><o>رَآ</>ئِ<f>هِم بَ</>رْزَخٌ إِلَىٰ يَوْمِ يُ<q>بْ</>عَ<p>ثُو</>نَ"},{"n":101,"w":[["فَإِذَا","fa-idhā","So when","অতঃপর যখন"],["نُفِخَ","nufikha","is blown","ফুঁ দেয়া হবে"],["فِى","fī","in","মধ্যে"],["ٱلصُّورِ","l-ṣūri","the trumpet","শিঙ্গার"],["فَلَآ","falā","then not","তখন না"],["أَنسَابَ","ansāba","(there) will be relationship","আত্মীয়তার বন্ধন (থাকবে)"],["بَيْنَهُمْ","baynahum","among them","মাঝে তাদের"],["يَوْمَئِذٍۢ","yawma-idhin","that Day","সেদিন"],["وَلَا","walā","and not","আর না"],["يَتَسَآءَلُونَ","yatasāalūna","will they ask each other","তারা পরস্পরে খোঁজখবর করবে"]],"t":"فَإِذَا نُفِخَ فِى <h>ٱ</><l>ل</>صُّورِ فَ<o>لَآ</> أَ<k>نسَ</>ابَ بَيْنَهُمْ يَوْمَئِ<d>ذٍۢ وَ</>لَا يَتَ<o>سَآ</>ءَ<p>لُو</>نَ"},{"n":102,"w":[["فَمَن","faman","Then (the one) whose","অতঃপর যার"],["ثَقُلَتْ","thaqulat","(are) heavy","ভারী হবে"],["مَوَٰزِينُهُۥ","mawāzīnuhu","his scales","তার পাল্লা"],["فَأُو۟لَـٰٓئِكَ","fa-ulāika","then those ","তখন ঐসবলোক"],["هُمُ","humu","they","তারাই"],["ٱلْمُفْلِحُونَ","l-muf'liḥūna","(are) the successful","সফলকাম (হবে)"]],"t":"فَمَ<k>ن ثَ</>قُلَتْ مَ<m>وَٰ</>زِينُهُ<m>ۥ</> فَأُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</>لْمُفْلِ<p>حُو</>نَ"},{"n":103,"w":[["وَمَنْ","waman","But (the one) whose","আর যার"],["خَفَّتْ","khaffat","(are) light","হালকা হবে"],["مَوَٰزِينُهُۥ","mawāzīnuhu","his scales","তার পাল্লা"],["فَأُو۟لَـٰٓئِكَ","fa-ulāika","then those","অতঃপর ঐসবলোক (হবে)"],["ٱلَّذِينَ","alladhīna","they [who]","(তারাই) যারা"],["خَسِرُوٓا۟","khasirū","have lost","ক্ষতিগ্রস্ত করেছে"],["أَنفُسَهُمْ","anfusahum","their souls","তাদের নিজেদেরকে"],["فِى","fī","in","মধ্যে"],["جَهَنَّمَ","jahannama","Hell","জাহান্নামের"],["خَـٰلِدُونَ","khālidūna","they (will) abide forever","তারা চিরস্থায়ী হবে (সেখানে)"]],"t":"وَمَنْ خَفَّتْ مَ<m>وَٰ</>زِينُهُ<m>ۥ</> فَأُ<s>و۟</><o>لَٰٓ</>ئِكَ <h>ٱ</>لَّذِينَ خَسِ<o>رُوٓ</><s>ا۟</> أَ<k>نفُ</>سَهُمْ فِى جَهَ<g>نَّ</>مَ <m>خَٰ</>لِ<p>دُو</>نَ"},{"n":104,"w":[["تَلْفَحُ","talfaḥu","Will burn","জ্বালিয়ে দিবে"],["وُجُوهَهُمُ","wujūhahumu","their faces","তাদের মুখমন্ডলকে"],["ٱلنَّارُ","l-nāru","the Fire","আগুন"],["وَهُمْ","wahum","and they","আর তারা"],["فِيهَا","fīhā","in it","তার মধ্যে"],["كَـٰلِحُونَ","kāliḥūna","(will) grin with displaced lips","বীভৎস হবে (চেহারায়)"]],"t":"تَلْفَحُ وُجُوهَهُمُ <h>ٱ</><l>ل</><g>نَّ</>ارُ وَهُمْ فِيهَا <m>كَٰ</>لِ<p>حُو</>نَ"},{"n":105,"w":[["أَلَمْ","alam","Were not","\"(বলা হবে) কি না"],["تَكُنْ","takun","Were not","\"হচ্ছিল"],["ءَايَـٰتِى","āyātī","My Verses","আমার আয়াতগুলোকে"],["تُتْلَىٰ","tut'lā","recited","তিলাওয়াত করা হতো"],["عَلَيْكُمْ","‘alaykum","to you","তোমাদের নিকট"],["فَكُنتُم","fakuntum","and you used (to)","তখন তোমরা ছিলে"],["بِهَا","bihā","deny them","সম্পর্কে তা\""],["تُكَذِّبُونَ","tukadhibūna","deny them","মিথ্যারোপ করতে\""]],"t":"أَلَمْ تَكُنْ ءَا<m>يَٰ</>تِى تُتْلَىٰ عَلَيْكُمْ فَكُ<k>نتُ</><f>م بِ</>هَا تُكَذِّ<p>بُو</>نَ"},{"n":106,"w":[["قَالُوا۟","qālū","They (will) say","তারা বলবে"],["رَبَّنَا","rabbanā","Our Lord","\"হে আমার রব"],["غَلَبَتْ","ghalabat","Overcame","বিজয় লাভ করেছিলো"],["عَلَيْنَا","‘alaynā","[on] us","উপর আমাদের"],["شِقْوَتُنَا","shiq'watunā","our wretchedness","আমাদের দুর্ভাগ্য"],["وَكُنَّا","wakunnā","and we were","এবং আমরা ছিলাম"],["قَوْمًۭا","qawman","a people","জাতি"],["ضَآلِّينَ","ḍāllīna","astray","পথভ্রষ্ট"]],"t":"قَالُو<s>ا۟</> رَبَّنَا غَلَبَتْ عَلَيْنَا شِ<q>قْ</>وَتُنَا وَكُ<g>نَّ</>ا قَوْ<k>مًۭا ضَ</><n>آ</><p>لِّي</>نَ"},{"n":107,"w":[["رَبَّنَآ","rabbanā","Our Lord","হে আমার রব"],["أَخْرِجْنَا","akhrij'nā","Bring us out","আমাদেরকে বের করে দাও"],["مِنْهَا","min'hā","from it","তা হ'তে"],["فَإِنْ","fa-in","then if","অতঃপর যদি"],["عُدْنَا","‘ud'nā","we return","আমরা পুনরায় করি"],["فَإِنَّا","fa-innā","then indeed, we","তবে আমরা নিশ্চয়ই"],["ظَـٰلِمُونَ","ẓālimūna","(would be) wrongdoers","সীমালঙ্ঘনকারী (প্রমাণিত হবো)\""]],"t":"رَبَّ<o>نَآ</> أَخْرِ<q>جْ</>نَا مِنْهَا فَإِنْ عُ<q>دْ</>نَا فَإِ<g>نَّ</>ا <m>ظَٰ</>لِ<p>مُو</>نَ"},{"n":108,"w":[["قَالَ","qāla","He (will) say","তিনি বলবেন"],["ٱخْسَـُٔوا۟","ikh'saū","Remain despised","\"পড়ে থাকো অপদস্হ হয়ে"],["فِيهَا","fīhā","in it","তার মধ্যে"],["وَلَا","walā","and (do) not","এবং না"],["تُكَلِّمُونِ","tukallimūni","speak to Me","আমার সাথে তোমরা কথা বলবে"]],"t":"قَالَ <h>ٱ</>خْسَـُٔو<s>ا۟</> فِيهَا وَلَا تُكَلِّ<p>مُو</>نِ"},{"n":109,"w":[["إِنَّهُۥ","innahu","Indeed","নিশ্চয়ই"],["كَانَ","kāna","(there) was","ছিলো"],["فَرِيقٌۭ","farīqun","a party","একদল"],["مِّنْ","min","of","মধ্যে"],["عِبَادِى","‘ibādī","My slaves","আমার দাসদের"],["يَقُولُونَ","yaqūlūna","(who) said","(যারা) বলতো"],["رَبَّنَآ","rabbanā","Our Lord","\"হে আমাদের রব"],["ءَامَنَّا","āmannā","We believe","আমরা ঈমান এনেছি"],["فَٱغْفِرْ","fa-igh'fir","so forgive","তাই ক্ষমা করো"],["لَنَا","lanā","us","আমাদেরকে"],["وَٱرْحَمْنَا","wa-ir'ḥamnā","and have mercy on us","ও আমাদের উপর দয়া করো"],["وَأَنتَ","wa-anta","and You","আর তুমিই"],["خَيْرُ","khayru","(are) best","অতি উত্তম"],["ٱلرَّٰحِمِينَ","l-rāḥimīna","(of) those who show mercy","দয়াকারীদের"]],"t":"إِ<g>نَّ</>هُ<m>ۥ</> كَانَ فَرِي<d>قٌۭ مِّ</>نْ عِبَادِى يَقُولُونَ رَبَّ<o>نَآ</> ءَامَ<g>نَّ</>ا فَ<h>ٱ</>غْفِرْ لَنَا وَ<h>ٱ</>رْحَمْنَا وَأَ<k>نتَ</> خَيْرُ <h>ٱ</><l>ل</><m>رَّٰ</>حِ<p>مِي</>نَ"},{"n":110,"w":[["فَٱتَّخَذْتُمُوهُمْ","fa-ittakhadhtumūhum","But you took them","তখন তোমরা গ্রহণ করেছিলে তাদেরকে"],["سِخْرِيًّا","sikh'riyyan","(in) mockery","ঠাট্টার পাত্ররূপে"],["حَتَّىٰٓ","ḥattā","until","এমনকি (তা)"],["أَنسَوْكُمْ","ansawkum","they made you forget","তোমাদেরকে ভুলিয়ে দিয়েছিলো"],["ذِكْرِى","dhik'rī","My remembrance","আমার স্মরণ"],["وَكُنتُم","wakuntum","and you used (to)","আর তোমরা ছিলে"],["مِّنْهُمْ","min'hum","at them","সাথে তাদের"],["تَضْحَكُونَ","taḍḥakūna","laugh","ঠাট্টা-বিদ্রুপ করতে"]],"t":"فَ<h>ٱ</>تَّخَذْتُمُوهُمْ سِخْرِيًّا حَتَّ<o>ىٰٓ</> أَ<k>نسَ</>وْكُمْ ذِكْرِى وَكُ<k>نتُ</><y>م مِّ</>نْهُمْ تَضْحَ<p>كُو</>نَ"},{"n":111,"w":[["إِنِّى","innī","Indeed, I","নিশ্চয়ই আমি"],["جَزَيْتُهُمُ","jazaytuhumu","have rewarded them","আমি পুরস্কার দিলাম তাদেরকে"],["ٱلْيَوْمَ","l-yawma","this Day","আজ"],["بِمَا","bimā","because","এ কারণে যে"],["صَبَرُوٓا۟","ṣabarū","they were patient","তারা ধৈর্য ধরেছিলো"],["أَنَّهُمْ","annahum","indeed, they","(ফল এই) যে তারা"],["هُمُ","humu","[they]","তারাই"],["ٱلْفَآئِزُونَ","l-fāizūna","(are) the successful ones","সফলকাম (হলো)"]],"t":"إِ<g>نِّ</>ى جَزَيْتُهُمُ <h>ٱ</>لْيَوْمَ بِمَا صَبَ<o>رُوٓ</><s>ا۟</> أَ<g>نَّ</>هُمْ هُمُ <h>ٱ</>لْ<o>فَآ</>ئِ<p>زُو</>نَ"},{"n":112,"w":[["قَـٰلَ","qāla","He will say","(আল্লাহ) বলবেন"],["كَمْ","kam","How long","\"কত (কাল)"],["لَبِثْتُمْ","labith'tum","did you remain","তোমরা অবস্থান করেছিলে"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["عَدَدَ","‘adada","(in) number","হিসেবে"],["سِنِينَ","sinīna","(of) years","বছরের\""]],"t":"<m>قَٰ</>لَ كَمْ لَبِثْتُمْ فِى <h>ٱ</>لْأَرْضِ عَدَدَ سِ<p>نِي</>نَ"},{"n":113,"w":[["قَالُوا۟","qālū","They will say","তারা বলবে"],["لَبِثْنَا","labith'nā","We remained","\"আমরা অবস্থান করেছিলাম"],["يَوْمًا","yawman","a day","একদিন"],["أَوْ","aw","or","অথবা"],["بَعْضَ","ba‘ḍa","a part","কিছু অংশ"],["يَوْمٍۢ","yawmin","(of) a day","দিনের"],["فَسْـَٔلِ","fasali","but ask","তবে জিজ্ঞেস করুন"],["ٱلْعَآدِّينَ","l-‘ādīna","those who keep count","গণনাকারীদেরকে\""]],"t":"قَالُو<s>ا۟</> لَبِثْنَا يَوْمًا أَوْ بَعْضَ يَوْ<k>مٍۢ فَ</>سْـَٔلِ <h>ٱ</>لْ<n>عَآ</><p>دِّي</>نَ"},{"n":114,"w":[["قَـٰلَ","qāla","He will say","(আল্লাহ) বলবেন"],["إِن","in","Not","\"না"],["لَّبِثْتُمْ","labith'tum","you stayed","অবস্থান করেছিলে তোমরা"],["إِلَّا","illā","but","এ ছাড়া"],["قَلِيلًۭا ۖ","qalīlan","a little","অল্প (কালই)"],["لَّوْ","law","if","যদি"],["أَنَّكُمْ","annakum","only you","(এমন হতো) যে তোমরা"],["كُنتُمْ","kuntum","[you]","তোমরা ছিলে"],["تَعْلَمُونَ","ta‘lamūna","knew","তোমরা জানতে"]],"t":"<m>قَٰ</>لَ <w>إِن لَّ</>بِثْتُمْ إِلَّا قَلِيلًۭ<w>ا ۖ لَّ</>وْ أَ<g>نَّ</>كُمْ كُ<k>نتُ</>مْ تَعْلَ<p>مُو</>نَ"},{"n":115,"w":[["أَفَحَسِبْتُمْ","afaḥasib'tum","Then did you think","কি তবে তোমরা মনে করেছিলে"],["أَنَّمَا","annamā","that","যে প্রকৃতপক্ষে"],["خَلَقْنَـٰكُمْ","khalaqnākum","We created you","তোমাদেরকে আমরা সৃষ্টি করেছি"],["عَبَثًۭا","‘abathan","uselessly","অনর্থক"],["وَأَنَّكُمْ","wa-annakum","and that you","আর (এও বুঝেছিলে) যে তোমরা"],["إِلَيْنَا","ilaynā","to Us","আমাদের কাছে"],["لَا","lā","not","না"],["تُرْجَعُونَ","tur'ja‘ūna","will be returned","তোমরা প্রত্যাবর্তিত হবে\""]],"t":"أَفَحَسِ<q>بْ</>تُمْ أَ<g>نَّ</>مَا خَلَ<q>قْ</><m>نَٰ</>كُمْ عَبَ<d>ثًۭا وَ</>أَ<g>نَّ</>كُمْ إِلَيْنَا لَا تُرْجَ<p>عُو</>نَ"},{"n":116,"w":[["فَتَعَـٰلَى","fata‘ālā","So exalted is","অতএব মহান শ্রেষ্ঠ"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["ٱلْمَلِكُ","l-maliku","the King","(যিনি) অধিপতি"],["ٱلْحَقُّ ۖ","l-ḥaqu","the Truth","প্রকৃত"],["لَآ","lā","(There is) no","নেই"],["إِلَـٰهَ","ilāha","god","কোন ইলাহ"],["إِلَّا","illā","except","ছাড়া"],["هُوَ","huwa","Him","তিনি"],["رَبُّ","rabbu","(the) Lord","রব (মালিক)"],["ٱلْعَرْشِ","l-‘arshi","(of) the Throne","আরশের"],["ٱلْكَرِيمِ","l-karīmi","Honorable","মর্যাদাবান"]],"t":"فَتَ<m>عَٰ</>لَى <h>ٱ</>للَّهُ <h>ٱ</>لْمَلِكُ <h>ٱ</>لْحَقُّ ۖ <o>لَآ</> إِ<m>لَٰ</>هَ إِلَّا هُوَ رَبُّ <h>ٱ</>لْعَرْشِ <h>ٱ</>لْكَ<p>رِي</>مِ"},{"n":117,"w":[["وَمَن","waman","And whoever","আর যে কেউ"],["يَدْعُ","yad‘u","invokes","ডাকবে"],["مَعَ","ma‘a","with","সাথে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["إِلَـٰهًا","ilāhan","god","ইলাহ (হিসেবে)"],["ءَاخَرَ","ākhara","other","অন্য (কাউকে)"],["لَا","lā","no","নেই"],["بُرْهَـٰنَ","bur'hāna","proof","কোন প্রমাণ"],["لَهُۥ","lahu","for him","জন্যে তার"],["بِهِۦ","bihi","in it","উপর এর"],["فَإِنَّمَا","fa-innamā","Then only","তবে প্রকৃতপক্ষে"],["حِسَابُهُۥ","ḥisābuhu","his account","তার হিসেব (হবে)"],["عِندَ","‘inda","(is) with","কাছে"],["رَبِّهِۦٓ ۚ","rabbihi","his Lord","তার রবের"],["إِنَّهُۥ","innahu","Indeed, [he]","নিশ্চয়ই"],["لَا","lā","not","না"],["يُفْلِحُ","yuf'liḥu","will succeed","সফলকাম হবে"],["ٱلْكَـٰفِرُونَ","l-kāfirūna","the disbelievers","কাফিররা"]],"t":"وَ<d>مَن يَ</><q>دْ</>عُ مَعَ <h>ٱ</>للَّهِ إِ<m>لَٰ</>هًا ءَاخَرَ لَا بُرْ<m>هَٰ</>نَ لَهُ<m>ۥ</> بِ<m>هِۦ</> فَإِ<g>نَّ</>مَا حِسَابُهُ<m>ۥ</> عِ<k>ندَ</> رَبِّ<o>هِۦٓ ۚ</> إِ<g>نَّ</>هُ<m>ۥ</> لَا يُفْلِحُ <h>ٱ</>لْ<m>كَٰ</>فِ<p>رُو</>نَ"},{"n":118,"w":[["وَقُل","waqul","And say","আর (হে নাবী) বলো"],["رَّبِّ","rabbi","My Lord","\"হে আমার রব"],["ٱغْفِرْ","igh'fir","Forgive","ক্ষমা করো"],["وَٱرْحَمْ","wa-ir'ḥam","and have mercy","আর দয়া করো"],["وَأَنتَ","wa-anta","and You","আর তুমিই"],["خَيْرُ","khayru","(are the) Best","উত্তম"],["ٱلرَّٰحِمِينَ","l-rāḥimīna","(of) those who show mercy","দয়াকারীদের"]],"t":"وَقُ<r>ل</> رَّبِّ <h>ٱ</>غْفِرْ وَ<h>ٱ</>رْحَمْ وَأَ<k>نتَ</> خَيْرُ <h>ٱ</><l>ل</><m>رَّٰ</>حِ<p>مِي</>نَ"}]}