,["سَمُومٍۢ","samūmin","scorching fire","উষ্ণবাতাস"],["وَحَمِيمٍۢ","waḥamīmin","and scalding water","ও ফুটন্ত পানির"]],"t":"فِى سَمُو<d>مٍۢ وَ</>حَ<p>مِي</>مٍۢ"},{"n":43,"w":[["وَظِلٍّۢ","waẓillin","And a shade","এবং ছায়ায়"],["مِّن","min","of","থেকে (সৃষ্টি)"],["يَحْمُومٍۢ","yaḥmūmin","black smoke","কালো ধোঁয়ার"]],"t":"وَظِ<d>لٍّۢ مِّن يَ</>حْ<p>مُو</>مٍۢ"},{"n":44,"w":[["لَّا","lā","Not","না"],["بَارِدٍۢ","bāridin","cool","ঠাণ্ডা (হবে)"],["وَلَا","walā","and not","আর না"],["كَرِيمٍ","karīmin","pleasant","আনন্দদায়ক"]],"t":"لَّا بَارِ<d>دٍۢ وَ</>لَا كَ<p>رِي</>مٍ"},{"n":45,"w":[["إِنَّهُمْ","innahum","Indeed, they","তারা নিশ্চয়ই"],["كَانُوا۟","kānū","were","ছিল"],["قَبْلَ","qabla","before","পূর্বে"],["ذَٰلِكَ","dhālika","that","এর"],["مُتْرَفِينَ","mut'rafīna","indulging in affluence","বিলাসী জীবনের অধিকারী"]],"t":"إِ<g>نَّ</>هُمْ كَانُو<s>ا۟</> قَ<q>بْ</>لَ <m>ذَٰ</>لِكَ مُتْرَ<p>فِي</>نَ"},{"n":46,"w":[["وَكَانُوا۟","wakānū","And were","এবং তারা ছিল"],["يُصِرُّونَ","yuṣirrūna","persisting","তারা অবিরত লিপ্ত থাকে"],["عَلَى","‘alā","in","উপর"],["ٱلْحِنثِ","l-ḥinthi","the sin","পাপের"],["ٱلْعَظِيمِ","l-‘aẓīmi","the great","ঘোরতর"]],"t":"وَكَانُو<s>ا۟</> يُصِرُّونَ عَلَى <h>ٱ</>لْحِ<k>نثِ</> <h>ٱ</>لْعَ<p>ظِي</>مِ"},{"n":47,"w":[["وَكَانُوا۟","wakānū","And they used (to)","এবং তারা ছিল"],["يَقُولُونَ","yaqūlūna","say","তারা বলে"],["أَئِذَا","a-idhā","When","\"যখন কি"],["مِتْنَا","mit'nā","we die","আমরা মরে যাব"],["وَكُنَّا","wakunnā","and become","ও আমরা হব"],["تُرَابًۭا","turāban","dust","মাটি"],["وَعِظَـٰمًا","wa‘iẓāman","and bones","ও হাড়"],["أَءِنَّا","a-innā","will we","নিশ্চয়ই কি আমরা"],["لَمَبْعُوثُونَ","lamab‘ūthūna","surely be resurrected","উত্থিত হব অবশ্যই"]],"t":"وَكَانُو<s>ا۟</> يَقُولُونَ أَئِذَا مِتْنَا وَكُ<g>نَّ</>ا تُرَا<d>بًۭا وَ</>عِ<m>ظَٰ</>مًا أَءِ<g>نَّ</>ا لَمَ<q>بْ</>عُو<p>ثُو</>نَ"},{"n":48,"w":[["أَوَءَابَآؤُنَا","awaābāunā","And also our fathers","অথবা আমাদের বাপদাদারও"],["ٱلْأَوَّلُونَ","l-awalūna","former","পূর্বসূরী"]],"t":"أَوَءَا<o>بَآ</>ؤُنَا <h>ٱ</>لْأَوَّ<p>لُو</>نَ"},{"n":49,"w":[["قُلْ","qul","Say","বলো"],["إِنَّ","inna","Indeed","\"নিশ্চয়ই"],["ٱلْأَوَّلِينَ","l-awalīna","the former","পূর্বসূরীকে"],["وَٱلْـَٔاخِرِينَ","wal-ākhirīna","and the later people","এবং উত্তরসূরীকে"]],"t":"قُلْ إِ<g>نَّ</> <h>ٱ</>لْأَوَّلِينَ وَ<h>ٱ</>لْءَاخِ<p>رِي</>نَ"},{"n":50,"w":[["لَمَجْمُوعُونَ","lamajmū‘ūna","Surely, will be gathered","অবশ্যই একত্র করা হবে"],["إِلَىٰ","ilā","for","দিকে"],["مِيقَـٰتِ","mīqāti","(the) appointment","(নির্দিষ্ট) সময়ে"],["يَوْمٍۢ","yawmin","(of) a Day","দিনে"],["مَّعْلُومٍۢ","ma‘lūmin","well-known","নির্ধারিত\""]],"t":"لَمَ<q>جْ</>مُوعُونَ إِلَىٰ مِي<m>قَٰ</>تِ يَوْ<d>مٍۢ مَّ</>عْ<p>لُو</>مٍۢ"},{"n":51,"w":[["ثُمَّ","thumma","Then","\"এরপর"],["إِنَّكُمْ","innakum","indeed you","নিশ্চয়ই তোমরা"],["أَيُّهَا","ayyuhā","O those astray","হে"],["ٱلضَّآلُّونَ","l-ḍālūna","O those astray","পথভ্রষ্টরা"],["ٱلْمُكَذِّبُونَ","l-mukadhibūna","the deniers","মিথ্যারোপকারীরা"]],"t":"ثُ<g>مَّ</> إِ<g>نَّ</>كُمْ أَيُّهَا <h>ٱ</><l>ل</><n>ضَّآ</>لُّونَ <h>ٱ</>لْمُكَذِّ<p>بُو</>نَ"},{"n":52,"w":[["لَـَٔاكِلُونَ","laākilūna","Will surely eat","অবশ্যই আহার করবে"],["مِن","min","from","থেকে"],["شَجَرٍۢ","shajarin","(the) tree","গাছ"],["مِّن","min","of","থেকে"],["زَقُّومٍۢ","zaqqūmin","Zaqqum","যাক্কুমের"]],"t":"لَءَاكِلُونَ مِ<k>ن شَ</>جَ<d>رٍۢ مِّ</><k>ن زَ</><p>قُّو</>مٍۢ"},{"n":53,"w":[["فَمَالِـُٔونَ","famāliūna","Then will fill","অতঃপর পূর্ণ করবে"],["مِنْهَا","min'hā","with it","তা দিয়ে"],["ٱلْبُطُونَ","l-buṭūna","the bellies","পেট সমূহকে"]],"t":"فَمَالِـُٔونَ مِنْهَا <h>ٱ</>لْبُ<p>طُو</>نَ"},{"n":54,"w":[["فَشَـٰرِبُونَ","fashāribūna","And drink","অতঃপর পান করবে"],["عَلَيْهِ","‘alayhi","over it","তার উপর"],["مِنَ","mina","[from]","থেকে"],["ٱلْحَمِيمِ","l-ḥamīmi","the scalding water","ফুটন্ত পানি"]],"t":"فَ<m>شَٰ</>رِبُونَ عَلَيْهِ مِنَ <h>ٱ</>لْحَ<p>مِي</>مِ"},{"n":55,"w":[["فَشَـٰرِبُونَ","fashāribūna","And will drink","অতঃপর পান করবে"],["شُرْبَ","shur'ba","(as) drinking","পান করার (মত)"],["ٱلْهِيمِ","l-hīmi","(of) the thirsty camels","পিপাসার্ত উট সমূহের\""]],"t":"فَ<m>شَٰ</>رِبُونَ شُرْبَ <h>ٱ</>لْ<p>هِي</>مِ"},{"n":56,"w":[["هَـٰذَا","hādhā","This","এটা"],["نُزُلُهُمْ","nuzuluhum","(is) their hospitality","তাদের আপ্যায়ন (হবে)"],["يَوْمَ","yawma","(on the) Day","দিনে"],["ٱلدِّينِ","l-dīni","(of) Judgment","কিয়ামতের"]],"t":"<m>هَٰ</>ذَا نُزُلُهُمْ يَوْمَ <h>ٱ</><l>ل</><p>دِّي</>نِ"},{"n":57,"w":[["نَحْنُ","naḥnu","We","আমরা"],["خَلَقْنَـٰكُمْ","khalaqnākum","[We] created you","তোমাদেরকে সৃষ্টি করেছি"],["فَلَوْلَا","falawlā","so why (do) not","কেন তবুও না"],["تُصَدِّقُونَ","tuṣaddiqūna","you admit the truth","তোমার বিশ্বাস কর"]],"t":"نَحْنُ خَلَ<q>قْ</><m>نَٰ</>كُمْ فَلَوْلَا تُصَدِّ<p>قُو</>نَ"},{"n":58,"w":[["أَفَرَءَيْتُم","afara-aytum","Do you see","তোমরা (ভেবে) দেখেছ কি তাহলে"],["مَّا","mā","what","যা"],["تُمْنُونَ","tum'nūna","you emit","তোমরা বীর্যপাত কর"]],"t":"أَفَرَءَيْ<y>تُم مَّ</>ا تُمْ<p>نُو</>نَ"},{"n":59,"w":[["ءَأَنتُمْ","a-antum","Is it you","তোমরা কি"],["تَخْلُقُونَهُۥٓ","takhluqūnahu","who create it","তা সৃষ্টি কর"],["أَمْ","am","or","না"],["نَحْنُ","naḥnu","(are) We","আমরা"],["ٱلْخَـٰلِقُونَ","l-khāliqūna","the Creators","সৃষ্টিকারী"]],"t":"ءَأَ<k>نتُ</>مْ تَخْلُقُونَهُ<o>ۥٓ</> أَمْ نَحْنُ <h>ٱ</>لْ<m>خَٰ</>لِ<p>قُو</>نَ"},{"n":60,"w":[["نَحْنُ","naḥnu","We","আমরা"],["قَدَّرْنَا","qaddarnā","[We] have decreed","নির্ধারণ করেছি"],["بَيْنَكُمُ","baynakumu","among you","তোমাদের মাঝে"],["ٱلْمَوْتَ","l-mawta","the death","মৃত্যু"],["وَمَا","wamā","and not","এবং না"],["نَحْنُ","naḥnu","We","আমরা"],["بِمَسْبُوقِينَ","bimasbūqīna","(are) outrun","অক্ষম"]],"t":"نَحْنُ قَدَّرْنَا بَيْنَكُمُ <h>ٱ</>لْمَوْتَ وَمَا نَحْنُ بِمَسْبُو<p>قِي</>نَ"},{"n":61,"w":[["عَلَىٰٓ","‘alā","In","এক্ষেত্রে"],["أَن","an","that","যে"],["نُّبَدِّلَ","nubaddila","We (will) change","পরিবর্তন করব আমরা"],["أَمْثَـٰلَكُمْ","amthālakum","your likeness[es]","তোমাদের আকৃতি"],["وَنُنشِئَكُمْ","wanunshi-akum","and produce you","এবং তোমাদের সৃষ্টি করব আমরা"],["فِى","fī","in","(এমন আকৃতির) মধ্যে"],["مَا","mā","what","যা"],["لَا","lā","not","না"],["تَعْلَمُونَ","ta‘lamūna","you know","তোমরা জান"]],"t":"عَلَ<o>ىٰٓ</> <d>أَن نُّ</>بَدِّلَ أَمْ<m>ثَٰ</>لَكُمْ وَنُ<k>نشِ</>ئَكُمْ فِى مَا لَا تَعْلَ<p>مُو</>نَ"},{"n":62,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["عَلِمْتُمُ","‘alim'tumu","you know","তোমরা জেনেছ"],["ٱلنَّشْأَةَ","l-nashata","the creation","সৃষ্টিকে"],["ٱلْأُولَىٰ","l-ūlā","the first","প্রথমবার"],["فَلَوْلَا","falawlā","so why not","কেন তবে না"],["تَذَكَّرُونَ","tadhakkarūna","you take heed","তোমরা শিক্ষা গ্রহণ কর"]],"t":"وَلَقَ<q>دْ</> عَلِمْتُمُ <h>ٱ</><l>ل</><g>نَّ</>شْأَةَ <h>ٱ</>لْأُولَىٰ فَلَوْلَا تَذَكَّ<p>رُو</>نَ"},{"n":63,"w":[["أَفَرَءَيْتُم","afara-aytum","And do you see","তোমরা তবে কি (ভেবে) দেখেছ"],["مَّا","mā","what","যা"],["تَحْرُثُونَ","taḥruthūna","you sow","তোমরা বীজবপণ কর"]],"t":"أَفَرَءَيْ<y>تُم مَّ</>ا تَحْرُ<p>ثُو</>نَ"},{"n":64,"w":[["ءَأَنتُمْ","a-antum","Is it you (who)","তোমরা কি"],["تَزْرَعُونَهُۥٓ","tazra‘ūnahu","cause it to grow","সেই ফসল ফলাও"],["أَمْ","am","or","না"],["نَحْنُ","naḥnu","(are) We","আমরা"],["ٱلزَّٰرِعُونَ","l-zāri‘ūna","the Ones Who grow","উৎপাদনকারী"]],"t":"ءَأَ<k>نتُ</>مْ تَزْرَعُونَهُ<o>ۥٓ</> أَمْ نَحْنُ <h>ٱ</><l>ل</><m>زَّٰ</>رِ<p>عُو</>نَ"},{"n":65,"w":[["لَوْ","law","If","যদি"],["نَشَآءُ","nashāu","We willed","চাই আমরা"],["لَجَعَلْنَـٰهُ","laja‘alnāhu","We (would) surely, make it","তা আমরা পরিণত করতে পারি অবশ্যই"],["حُطَـٰمًۭا","ḥuṭāman","debris","খড়কুটায়"],["فَظَلْتُمْ","faẓaltum","then you would remain","তোমরা তখন থাকবে"],["تَفَكَّهُونَ","tafakkahūna","wondering","অবাক বোধ করতে"]],"t":"لَوْ نَ<o>شَآ</>ءُ لَجَعَلْ<m>نَٰ</>هُ حُ<m>طَٰ</><k>مًۭا فَ</>ظَلْتُمْ تَفَكَّ<p>هُو</>نَ"},{"n":66,"w":[["إِنَّا","innā","Indeed, we","\"(বলবে) আমরা নিশ্চয়ই"],["لَمُغْرَمُونَ","lamugh'ramūna","surely are laden with debt","অবশ্যই ঋণগ্রস্ত হয়েছি"]],"t":"إِ<g>نَّ</>ا لَمُغْرَ<p>مُو</>نَ"},{"n":67,"w":[["بَلْ","bal","Nay","বরং"],["نَحْنُ","naḥnu","we","আমরা"],["مَحْرُومُونَ","maḥrūmūna","(are) deprived","বঞ্চিত হয়েছি\""]],"t":"بَلْ نَحْنُ مَحْرُو<p>مُو</>نَ"},{"n":68,"w":[["أَفَرَءَيْتُمُ","afara-aytumu","Do you see","তোমরা তবে কি (ভেবে) দেখেছ"],["ٱلْمَآءَ","l-māa","the water","পানি (সম্পর্কে)"],["ٱلَّذِى","alladhī","which","যা"],["تَشْرَبُونَ","tashrabūna","you drink","তোমরা পান কর"]],"t":"أَفَرَءَيْتُمُ <h>ٱ</>لْ<o>مَآ</>ءَ <h>ٱ</>لَّذِى تَشْرَ<p>بُو</>نَ"},{"n":69,"w":[["ءَأَنتُمْ","a-antum","Is it you","তোমরা কি"],["أَنزَلْتُمُوهُ","anzaltumūhu","who send it down","তা নামিয়ে আন"],["مِنَ","mina","from","থেকে"],["ٱلْمُزْنِ","l-muz'ni","the rain clouds","মেঘ"],["أَمْ","am","or","না"],["نَحْنُ","naḥnu","We","আমরা"],["ٱلْمُنزِلُونَ","l-munzilūna","(are) the Ones to send","বর্ষণকারী"]],"t":"ءَأَ<k>نتُ</>مْ أَ<k>نزَ</>لْتُمُوهُ مِنَ <h>ٱ</>لْمُزْنِ أَمْ نَحْنُ <h>ٱ</>لْمُ<k>نزِ</><p>لُو</>نَ"},{"n":70,"w":[["لَوْ","law","If","যদি"],["نَشَآءُ","nashāu","We willed","চাই আমরা"],["جَعَلْنَـٰهُ","ja‘alnāhu","We (could) make it","তা আমরা করতে পারি"],["أُجَاجًۭا","ujājan","salty","লোনা"],["فَلَوْلَا","falawlā","then why are you not grateful","কেন তাহলে না"],["تَشْكُرُونَ","tashkurūna","then why are you not grateful","তোমরা কৃতজ্ঞতা প্রকাশ কর"]],"t":"لَوْ نَ<o>شَآ</>ءُ جَعَلْ<m>نَٰ</>هُ أُجَا<k>جًۭا فَ</>لَوْلَا تَشْكُ<p>رُو</>نَ"},{"n":71,"w":[["أَفَرَءَيْتُمُ","afara-aytumu","Do you see","তোমরা তবে কি (ভেবে) দেখেছ"],["ٱلنَّارَ","l-nāra","the Fire","আগুন (সম্পর্কে)"],["ٱلَّتِى","allatī","which","যা"],["تُورُونَ","tūrūna","you ignite","তোমরা জ্বালাও"]],"t":"أَفَرَءَيْتُمُ <h>ٱ</><l>ل</><g>نَّ</>ارَ <h>ٱ</>لَّتِى تُو<p>رُو</>نَ"},{"n":72,"w":[["ءَأَنتُمْ","a-antum","Is it you","তোমরা কি"],["أَنشَأْتُمْ","anshatum","who produced","তোমরাই সৃষ্টি করেছ"],["شَجَرَتَهَآ","shajaratahā","its tree","তার গাছকে"],["أَمْ","am","or","না"],["نَحْنُ","naḥnu","We","আমরা"],["ٱلْمُنشِـُٔونَ","l-munshiūna","(are) the Producers","স্রষ্টা"]],"t":"ءَأَ<k>نتُ</>مْ أَ<k>نشَ</>أْتُمْ شَجَرَتَ<o>هَآ</> أَمْ نَحْنُ <h>ٱ</>لْمُ<k>نشِـُٔ</><p>و</>نَ"},{"n":73,"w":[["نَحْنُ","naḥnu","We","আমরা"],["جَعَلْنَـٰهَا","ja‘alnāhā","have made it","তা আমরা বানিয়েছি"],["تَذْكِرَةًۭ","tadhkiratan","a reminder","স্মরণীয় নিদর্শন"],["وَمَتَـٰعًۭا","wamatā‘an","and a provision","ও জীবনোপকরণ (হিসেবে)"],["لِّلْمُقْوِينَ","lil'muq'wīna","for the wayfarers in the desert","(মরুচারী) মুসাফিরদের জন্যে"]],"t":"نَحْنُ جَعَلْ<m>نَٰ</>هَا تَذْكِرَ<d>ةًۭ وَ</>مَ<m>تَٰ</><w>عًۭا لِّ</>لْمُ<q>قْ</><p>وِي</>نَ"},{"n":74,"w":[["فَسَبِّحْ","fasabbiḥ","So glorify","অতএব তুমি পবিত্রতা ঘোষণা করো"],["بِٱسْمِ","bi-is'mi","(the) name","নামের"],["رَبِّكَ","rabbika","(of) your Lord","তোমার রবের"],["ٱلْعَظِيمِ","l-‘aẓīmi","the Most Great","মহান"]],"t":"فَسَبِّحْ بِ<h>ٱ</>سْمِ رَبِّكَ <h>ٱ</>لْعَ<p>ظِي</>مِ"},{"n":75,"w":[["۞ فَلَآ","falā","But nay","অতঃপর না"],["أُقْسِمُ","uq'simu","I swear","শপথ করছি আমি"],["بِمَوَٰقِعِ","bimawāqi‘i","by setting","অস্ত যাওয়ার স্থানের"],["ٱلنُّجُومِ","l-nujūmi","(of) the stars","তারকা গুলোর"]],"t":"۞ فَ<o>لَآ</> أُ<q>قْ</>سِمُ بِمَ<m>وَٰ</>قِعِ <h>ٱ</><l>ل</><g>نُّ</><p>جُو</>مِ"},{"n":76,"w":[["وَإِنَّهُۥ","wa-innahu","And indeed, it","এবং তা নিশ্চয়ই"],["لَقَسَمٌۭ","laqasamun","(is) surely an oath","শপথ অবশ্যই"],["لَّوْ","law","if","যদি"],["تَعْلَمُونَ","ta‘lamūna","you know ","তোমরা জান"],["عَظِيمٌ","‘aẓīmun","great","(শপথ) বিরাট"]],"t":"وَإِ<g>نَّ</>هُ<m>ۥ</> لَقَسَ<w>مٌۭ لَّ</>وْ تَعْلَمُونَ عَ<p>ظِي</>مٌ"},{"n":77,"w":[["إِنَّهُۥ","innahu","Indeed, it","তা নিশ্চয়ই"],["لَقُرْءَانٌۭ","laqur'ānun","(is) surely, a Quran","অবশ্যই কুরআন"],["كَرِيمٌۭ","karīmun","noble","মহা সম্মানিত"]],"t":"إِ<g>نَّ</>هُ<m>ۥ</> لَقُرْءَا<k>نٌۭ كَ</><p>رِي</>مٌۭ"},{"n":78,"w":[["فِى","fī","In","মধ্যে"],["كِتَـٰبٍۢ","kitābin","a Book","কিতাবের"],["مَّكْنُونٍۢ","maknūnin","well-guarded","সুরক্ষিত"]],"t":"فِى كِ<m>تَٰ</><d>بٍۢ مَّ</>كْ<p>نُو</>نٍۢ"},{"n":79,"w":[["لَّا","lā","None","না"],["يَمَسُّهُۥٓ","yamassuhu","touch it","তা স্পর্শ করতে পারে"],["إِلَّا","illā","except","এছাড়া"],["ٱلْمُطَهَّرُونَ","l-muṭaharūna","the purified","(যারা) পবিত্র"]],"t":"لَّا يَمَسُّهُ<o>ۥٓ</> إِلَّا <h>ٱ</>لْمُطَهَّ<p>رُو</>نَ"},{"n":80,"w":[["تَنزِيلٌۭ","tanzīlun","A Revelation","অবতীর্ণ"],["مِّن","min","from","পক্ষ হতে"],["رَّبِّ","rabbi","(the) Lord","রবের"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","(of) the worlds","বিশ্বজগতের"]],"t":"تَ<k>نزِ</>ي<d>لٌۭ مِّ</><w>ن رَّ</>بِّ <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":81,"w":[["أَفَبِهَـٰذَا","afabihādhā","Then is it to this","তবুও কি এই"],["ٱلْحَدِيثِ","l-ḥadīthi","statement","বাণী (সম্পর্কে)"],["أَنتُم","antum","that you","তোমরা"],["مُّدْهِنُونَ","mud'hinūna","(are) indifferent","তুচ্ছজ্ঞান করবে"]],"t":"أَفَبِ<m>هَٰ</>ذَا <h>ٱ</>لْحَدِيثِ أَ<k>نتُ</><y>م مُّ</><q>دْ</>هِ<p>نُو</>نَ"},{"n":82,"w":[["وَتَجْعَلُونَ","wataj‘alūna","And you make","এবং তোমরা বানিয়ে নেবে"],["رِزْقَكُمْ","riz'qakum","your provision","তোমাদের জীবিকা (এই নিয়ামত)"],["أَنَّكُمْ","annakum","that you","(এভাবে) যে তোমরা"],["تُكَذِّبُونَ","tukadhibūna","deny","মিথ্যা মনে করছ"]],"t":"وَتَ<q>جْ</>عَلُونَ رِزْقَكُمْ أَ<g>نَّ</>كُمْ تُكَذِّ<p>بُو</>نَ"},{"n":83,"w":[["فَلَوْلَآ","falawlā","Then why not","তবে কেন নয়"],["إِذَا","idhā","when","যখন"],["بَلَغَتِ","balaghati","it reaches","পৌঁছাবে (প্রাণ)"],["ٱلْحُلْقُومَ","l-ḥul'qūma","the throat","কণ্ঠনালীতে"]],"t":"فَلَوْ<o>لَآ</> إِذَا بَلَغَتِ <h>ٱ</>لْحُلْ<p>قُو</>مَ"},{"n":84,"w":[["وَأَنتُمْ","wa-antum","And you","এবং তোমরা"],["حِينَئِذٍۢ","ḥīna-idhin","(at) that time","সে সময়"],["تَنظُرُونَ","tanẓurūna","look on","তাকিয়ে থাকবে"]],"t":"وَأَ<k>نتُ</>مْ حِينَئِ<k>ذٍۢ تَنظُ</><p>رُو</>نَ"},{"n":85,"w":[["وَنَحْنُ","wanaḥnu","And We","এবং আমরা"],["أَقْرَبُ","aqrabu","(are) nearer","অধিকতর নিকটে"],["إِلَيْهِ","ilayhi","to him","তার কাছে"],["مِنكُمْ","minkum","than you","তোমাদের চেয়ে"],["وَلَـٰكِن","walākin","but","কিন্তু"],["لَّا","lā","you (do) not see","না"],["تُبْصِرُونَ","tub'ṣirūna","you (do) not see","তোমরা দেখতে পাও"]],"t":"وَنَحْنُ أَ<q>قْ</>رَبُ إِلَيْهِ مِ<k>نكُ</>مْ وَ<m>لَٰ</><w>كِن لَّ</>ا تُ<q>بْ</>صِ<p>رُو</>نَ"},{"n":86,"w":[["فَلَوْلَآ","falawlā","Then why not","অতঃপর কেন"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you are","তোমরা হয়ে থাক"],["غَيْرَ","ghayra","not","(এমন যে) নও"],["مَدِينِينَ","madīnīna","to be recompensed","অধিনস্ত (কারও)"]],"t":"فَلَوْ<o>لَآ</> إِ<k>ن كُنتُ</>مْ غَيْرَ مَدِي<p>نِي</>نَ"},{"n":87,"w":[["تَرْجِعُونَهَآ","tarji‘ūnahā","Bring it back","তা তোমরা ফিরিয়ে আন"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you are","তোমরা হও"],["صَـٰدِقِينَ","ṣādiqīna","truthful","সত্যবাদী"]],"t":"تَرْجِعُونَ<o>هَآ</> إِ<k>ن كُنتُ</>مْ <m>صَٰ</>دِ<p>قِي</>نَ"},{"n":88,"w":[["فَأَمَّآ","fa-ammā","Then","আর"],["إِن","in","if","যদি"],["كَانَ","kāna","he was","সে হয়"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْمُقَرَّبِينَ","l-muqarabīna","those brought near","নৈকট্য প্রাপ্তদের"]],"t":"فَأَ<g>مَّ</><o>آ</> إِ<k>ن كَ</>انَ مِنَ <h>ٱ</>لْمُقَرَّ<p>بِي</>نَ"},{"n":89,"w":[["فَرَوْحٌۭ","farawḥun","Then rest","(তার জন্যে) তবে আরাম"],["وَرَيْحَانٌۭ","warayḥānun","and bounty","ও উত্তম জীবনোপকরণ"],["وَجَنَّتُ","wajannatu","and a Garden","এবং জন্নাত"],["نَعِيمٍۢ","na‘īmin","(of) Pleasure","সুখকর"]],"t":"فَرَوْ<d>حٌۭ وَ</>رَيْحَا<d>نٌۭ وَ</>جَ<g>نَّ</>تُ نَ<p>عِي</>مٍۢ"},{"n":90,"w":[["وَأَمَّآ","wa-ammā","And","আর"],["إِن","in","if","যদি"],["كَانَ","kāna","he was","সে হয়"],["مِنْ","min","of","অন্তর্ভুক্ত"],["أَصْحَـٰبِ","aṣḥābi","(the) companions","লোকদের"],["ٱلْيَمِينِ","l-yamīni","(of) the right","ডান হাতের"]],"t":"وَأَ<g>مَّ</><o>آ</> إِ<k>ن كَ</>انَ مِنْ أَصْ<m>حَٰ</>بِ <h>ٱ</>لْيَ<p>مِي</>نِ"},{"n":91,"w":[["فَسَلَـٰمٌۭ","fasalāmun","Then, peace","তবে (বলা হবে) সালাম"],["لَّكَ","laka","for you","তোমার জন্য"],["مِنْ","min","[from]","অন্তর্ভুক্ত"],["أَصْحَـٰبِ","aṣḥābi","(the) companions","লোকদের"],["ٱلْيَمِينِ","l-yamīni","(of) the right","ডান হাতের"]],"t":"فَسَ<m>لَٰ</><w>مٌۭ لَّ</>كَ مِنْ أَصْ<m>حَٰ</>بِ <h>ٱ</>لْيَ<p>مِي</>نِ"},{"n":92,"w":[["وَأَمَّآ","wa-ammā","But","আর"],["إِن","in","if","যদি"],["كَانَ","kāna","he was","সে হয়"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْمُكَذِّبِينَ","l-mukadhibīna","the deniers","মিথ্যারোপকারীদের"],["ٱلضَّآلِّينَ","l-ḍālīna","the astray","পথভ্রষ্টদের"]],"t":"وَأَ<g>مَّ</><o>آ</> إِ<k>ن كَ</>انَ مِنَ <h>ٱ</>لْمُكَذِّبِينَ <h>ٱ</><l>ل</><n>ضَّآ</><p>لِّي</>نَ"},{"n":93,"w":[["فَنُزُلٌۭ","fanuzulun","Then, hospitality","আপ্যায়ন তবে (হবে)"],["مِّنْ","min","of","দিয়ে"],["حَمِيمٍۢ","ḥamīmin","(the) scalding water","ফুটন্ত পানির"]],"t":"فَنُزُ<d>لٌۭ مِّ</>نْ حَ<p>مِي</>مٍۢ"},{"n":94,"w":[["وَتَصْلِيَةُ","wataṣliyatu","And burning","ও দগ্ধকরণ"],["جَحِيمٍ","jaḥīmin","(in) Hellfire","জাহান্নামের"]],"t":"وَتَصْلِيَةُ جَ<p>حِي</>مٍ"},{"n":95,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["هَـٰذَا","hādhā","this","এটা"],["لَهُوَ","lahuwa","surely, it","তা অবশ্যই"],["حَقُّ","ḥaqqu","(is the) truth","সত্য"],["ٱلْيَقِينِ","l-yaqīni","certain","ধ্রুব"]],"t":"إِ<g>نَّ</> <m>هَٰ</>ذَا لَهُوَ حَقُّ <h>ٱ</>لْيَ<p>قِي</>نِ"},{"n":96,"w":[["فَسَبِّحْ","fasabbiḥ","So glorify","সুতরাং পবিত্রতা ঘোষণা করো"],["بِٱسْمِ","bi-is'mi","(the) name","নামের"],["رَبِّكَ","rabbika","(of) your Lord","তোমার রবের"],["ٱلْعَظِيمِ","l-‘aẓīmi","the Most Great","(যিনি) মহান"]],"t":"فَسَبِّحْ بِ<h>ٱ</>سْمِ رَبِّكَ <h>ٱ</>لْعَ<p>ظِي</>مِ"}]}