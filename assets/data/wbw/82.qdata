{"n":82,"a":[{"n":1,"w":[["إِذَا","idhā","When","যখন"],["ٱلسَّمَآءُ","l-samāu","the sky","আকাশ"],["ٱنفَطَرَتْ","infaṭarat","(is) cleft asunder","ফেটে যাবে"]],"t":"إِذَا <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءُ <h>ٱ</><k>نفَ</>طَرَتْ"},{"n":2,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["ٱلْكَوَاكِبُ","l-kawākibu","the stars","তারাগুলো"],["ٱنتَثَرَتْ","intatharat","scatter","বিক্ষিপ্ত হবে"]],"t":"وَإِذَا <h>ٱ</>لْكَوَاكِبُ <h>ٱ</><k>نتَ</>ثَرَتْ"},{"n":3,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["ٱلْبِحَارُ","l-biḥāru","the seas","সাগরগুলো"],["فُجِّرَتْ","fujjirat","are made to gush forth","উথলে উঠবে"]],"t":"وَإِذَا <h>ٱ</>لْبِحَارُ فُجِّرَتْ"},{"n":4,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["ٱلْقُبُورُ","l-qubūru","the graves","কবরগুলো"],["بُعْثِرَتْ","bu‘'thirat","are overturned","উন্মোচিত হবে"]],"t":"وَإِذَا <h>ٱ</>لْقُبُورُ بُعْثِرَتْ"},{"n":5,"w":[["عَلِمَتْ","‘alimat","Will know","জানবে"],["نَفْسٌۭ","nafsun","a soul","প্রত্যেক ব্যক্তি"],["مَّا","mā","what","যা"],["قَدَّمَتْ","qaddamat","it has sent forth","সে আগে পাঠিয়েছে"],["وَأَخَّرَتْ","wa-akharat","and left behind","এবং পিছনে ছেড়েছে"]],"t":"عَلِمَتْ نَفْ<d>سٌۭ مَّ</>ا قَدَّمَتْ وَأَخَّرَتْ"},{"n":6,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O","হে"],["ٱلْإِنسَـٰنُ","l-insānu","man","মানুষ"],["مَا","mā","What","কিসে"],["غَرَّكَ","gharraka","has deceived you","তোমাকে ধোঁকা দিয়েছে"],["بِرَبِّكَ","birabbika","concerning your Lord","তোমার রবের ব্যাপারে"],["ٱلْكَرِيمِ","l-karīmi","the Most Noble","মহান"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لْإِ<k>نسَٰ</>نُ مَا غَرَّكَ بِرَبِّكَ <h>ٱ</>لْكَ<p>رِي</>مِ"},{"n":7,"w":[["ٱلَّذِى","alladhī","Who","যিনি"],["خَلَقَكَ","khalaqaka","created you","তোমাকে সৃষ্টি করেছেন"],["فَسَوَّىٰكَ","fasawwāka","then fashioned you","অতঃপর তোমাকে সুঠাম করেছেন"],["فَعَدَلَكَ","fa‘adalaka","then balanced you","অতঃপর তোমাকে  সুসামঞ্জস্য করেছেন"]],"t":"ٱلَّذِى خَلَقَكَ فَسَوَّ<m>ىٰ</>كَ فَعَدَلَكَ"},{"n":8,"w":[["فِىٓ","fī","In","মধ্যে"],["أَىِّ","ayyi","whatever","যে"],["صُورَةٍۢ","ṣūratin","form","আকৃতিতে"],["مَّا","mā","what","(যা) যেমন"],["شَآءَ","shāa","He willed","তিনি চেয়েছেন"],["رَكَّبَكَ","rakkabaka","He assembled you","তোমাকে গঠন করেছেন"]],"t":"<o>فِىٓ</> أَىِّ صُورَ<d>ةٍۢ مَّ</>ا <o>شَآ</>ءَ رَكَّبَكَ"},{"n":9,"w":[["كَلَّا","kallā","Nay","কখনও নয়"],["بَلْ","bal","But","বরং"],["تُكَذِّبُونَ","tukadhibūna","you deny","তোমারা মিথ্যা মনে করছ"],["بِٱلدِّينِ","bil-dīni","the Judgment","শেষ বিচারকে"]],"t":"كَلَّا بَلْ تُكَذِّبُونَ بِ<h>ٱ</><l>ل</><p>دِّي</>نِ"},{"n":10,"w":[["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["عَلَيْكُمْ","‘alaykum","over you","তোমাদের উপর"],["لَحَـٰفِظِينَ","laḥāfiẓīna","(are) surely guardians","সংরক্ষক দল অবশ্যই (আছে)"]],"t":"وَإِ<g>نَّ</> عَلَيْكُمْ لَ<m>حَٰ</>فِ<p>ظِي</>نَ"},{"n":11,"w":[["كِرَامًۭا","kirāman","Noble","সম্মানিত"],["كَـٰتِبِينَ","kātibīna","recording","লেখকবৃন্দ"]],"t":"كِرَا<k>مًۭا كَٰ</>تِ<p>بِي</>نَ"},{"n":12,"w":[["يَعْلَمُونَ","ya‘lamūna","They know","তারা জানে"],["مَا","mā","whatever","যা"],["تَفْعَلُونَ","taf‘alūna","you do","তোমরা কর"]],"t":"يَعْلَمُونَ مَا تَفْعَ<p>لُو</>نَ"},{"n":13,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلْأَبْرَارَ","l-abrāra","the righteous","সৎ ব্যক্তিরা"],["لَفِى","lafī","(will be) surely in","অবশ্যই মধ্যে(থাকবে)"],["نَعِيمٍۢ","na‘īmin","bliss","স্বাচ্ছন্দ্যে (সুখে-শান্তিতে)"]],"t":"إِ<g>نَّ</> <h>ٱ</>لْأَ<q>بْ</>رَارَ لَفِى نَ<p>عِي</>مٍۢ"},{"n":14,"w":[["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["ٱلْفُجَّارَ","l-fujāra","the wicked","পাপাচারীরা"],["لَفِى","lafī","(will be) surely in","অবশ্যই মধ্যে (যাবে)"],["جَحِيمٍۢ","jaḥīmin","Hellfire","দোজখের"]],"t":"وَإِ<g>نَّ</> <h>ٱ</>لْفُجَّارَ لَفِى جَ<p>حِي</>مٍۢ"},{"n":15,"w":[["يَصْلَوْنَهَا","yaṣlawnahā","They will burn (in) it","সেখানে তারা প্রবেশ করবে"],["يَوْمَ","yawma","(on the) Day","দিনে"],["ٱلدِّينِ","l-dīni","(of) the Judgment","বিচার"]],"t":"يَصْلَوْنَهَا يَوْمَ <h>ٱ</><l>ل</><p>دِّي</>نِ"},{"n":16,"w":[["وَمَا","wamā","And not","এবং না"],["هُمْ","hum","they","তারা"],["عَنْهَا","‘anhā","from it","তা থেকে"],["بِغَآئِبِينَ","bighāibīna","(will be) absent","অনুপস্থিত (থাকতে সক্ষম হবে)"]],"t":"وَمَا هُمْ عَنْهَا بِ<o>غَآ</>ئِ<p>بِي</>نَ"},{"n":17,"w":[["وَمَآ","wamā","And what","এবং কিসে"],["أَدْرَىٰكَ","adrāka","can make you know","তোমাকে জানাবে"],["مَا","mā","what","কি (সেই)"],["يَوْمُ","yawmu","(is the) Day","দিন"],["ٱلدِّينِ","l-dīni","(of) the Judgment","বিচারের"]],"t":"وَ<o>مَآ</> أَ<q>دْ</>رَ<m>ىٰ</>كَ مَا يَوْمُ <h>ٱ</><l>ل</><p>دِّي</>نِ"},{"n":18,"w":[["ثُمَّ","thumma","Then","অতঃপর"],["مَآ","mā","what","কিসে"],["أَدْرَىٰكَ","adrāka","can make you know","তোমাকে জানাবে"],["مَا","mā","what","কি সেই"],["يَوْمُ","yawmu","(is the) Day","দিন"],["ٱلدِّينِ","l-dīni","(of) the Judgment","বিচারের"]],"t":"ثُ<g>مَّ</> <o>مَآ</> أَ<q>دْ</>رَ<m>ىٰ</>كَ مَا يَوْمُ <h>ٱ</><l>ل</><p>دِّي</>نِ"},{"n":19,"w":[["يَوْمَ","yawma","(The) Day","সেদিন"],["لَا","lā","not","না"],["تَمْلِكُ","tamliku","will have power","সক্ষম হবে"],["نَفْسٌۭ","nafsun","a soul","কেউ"],["لِّنَفْسٍۢ","linafsin","for a soul","কারও জন্যে"],["شَيْـًۭٔا ۖ","shayan","anything","কিছু (করতে)"],["وَٱلْأَمْرُ","wal-amru","and the Command","এবং কর্তৃত্ব"],["يَوْمَئِذٍۢ","yawma-idhin","that Day","সেদিন (হবে কেবল)"],["لِّلَّهِ","lillahi","(will be) with Allah","আল্লাহর জন্যে"]],"t":"يَوْمَ لَا تَمْلِكُ نَفْ<w>سٌۭ لِّ</>نَفْ<k>سٍۢ شَ</><d>يْـًۭٔا ۖ وَ</><h>ٱ</>لْأَمْرُ يَوْمَئِ<w>ذٍۢ لِّ</>لَّهِ"}]}