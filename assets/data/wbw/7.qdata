{"n":7,"a":[{"n":1,"w":[["الٓمٓصٓ","alif-lam-meem-sad","Alif Laam Meem Saad","আলীফ-লাম-মীম-সাদ"]],"t":"ا<n>لٓمٓصٓ</>"},{"n":2,"w":[["كِتَـٰبٌ","kitābun","(This is) a Book","(এই) কিতাব"],["أُنزِلَ","unzila","revealed","অবতীর্ণ হয়েছে"],["إِلَيْكَ","ilayka","to you","তোমার প্রতি"],["فَلَا","falā","so (let) not","অতএব না (যেন)"],["يَكُن","yakun","be","হয়"],["فِى","fī","in","মধ্যে"],["صَدْرِكَ","ṣadrika","your breast","তোমার মনের"],["حَرَجٌۭ","ḥarajun","any uneasiness","কোনো সংকোচ"],["مِّنْهُ","min'hu","from it","হতে তা"],["لِتُنذِرَ","litundhira","that you warn","যেন তুমি সতর্ক করো"],["بِهِۦ","bihi","with it","দিয়ে তা"],["وَذِكْرَىٰ","wadhik'rā","and a reminder","এবং (এই কিতাব) উপদেশ"],["لِلْمُؤْمِنِينَ","lil'mu'minīna","for the believers","জন্যে মু`মিনদের"]],"t":"كِ<m>تَٰ</>بٌ أُ<k>نزِ</>لَ إِلَيْكَ فَلَا يَكُ<k>ن فِ</>ى صَ<q>دْ</>رِكَ حَرَ<d>جٌۭ مِّ</>نْهُ لِتُ<k>نذِ</>رَ بِ<m>هِۦ</> وَذِكْرَىٰ لِلْمُؤْمِ<p>نِي</>نَ"},{"n":3,"w":[["ٱتَّبِعُوا۟","ittabi‘ū","Follow","তোমরা অনুসরন করো"],["مَآ","mā","what","যা"],["أُنزِلَ","unzila","has been revealed","অবতীর্ণ হয়েছে"],["إِلَيْكُم","ilaykum","to you","প্রতি তোমাদের প"],["مِّن","min","from","পক্ষ হতে"],["رَّبِّكُمْ","rabbikum","your Lord","রবের তোমাদের"],["وَلَا","walā","and (do) not","এবং না"],["تَتَّبِعُوا۟","tattabi‘ū","follow","তোমরা অনুসরণ করো"],["مِن","min","from","ছাড়া"],["دُونِهِۦٓ","dūnihi","beside Him","তাকে"],["أَوْلِيَآءَ ۗ","awliyāa","any allies","(অন্যান্যদেরকে) অভিভাবকরূপে"],["قَلِيلًۭا","qalīlan","Little","(কিন্তু) অল্পই"],["مَّا","mā","(is) what","যা"],["تَذَكَّرُونَ","tadhakkarūna","you remember","তোমরা উপদেশ গ্রহণ করো"]],"t":"ٱتَّبِعُو<s>ا۟</> <o>مَآ</> أُ<k>نزِ</>لَ إِلَيْ<y>كُم مِّ</><w>ن رَّ</>بِّكُمْ وَلَا تَتَّبِعُو<s>ا۟</> مِ<k>ن دُ</>ونِ<o>هِۦٓ</> أَوْلِ<o>يَآ</>ءَ ۗ قَلِيلًۭ<d>ا مَّ</>ا تَذَكَّ<p>رُو</>نَ"},{"n":4,"w":[["وَكَم","wakam","And how many","এবং কত (সব)"],["مِّن","min","of","থেকে"],["قَرْيَةٍ","qaryatin","a city","জনপদ"],["أَهْلَكْنَـٰهَا","ahlaknāhā","We destroyed it","ধ্বংস করেছি আমরা তা"],["فَجَآءَهَا","fajāahā","and came to it","তখন উপর এসেছিলো তার"],["بَأْسُنَا","basunā","Our punishment","শাস্তি আমাদের"],["بَيَـٰتًا","bayātan","(at) night","রাতের বেলায়"],["أَوْ","aw","or","অথবা"],["هُمْ","hum","(while) they","তারা (ছিলো)"],["قَآئِلُونَ","qāilūna","were sleeping at noon","দুপুরে বিশ্রাম গ্রহণকারী"]],"t":"وَ<y>كَم مِّ</><k>ن قَ</>رْيَةٍ أَهْلَكْ<m>نَٰ</>هَا فَ<o>جَآ</>ءَهَا بَأْسُنَا بَ<m>يَٰ</>تًا أَوْ هُمْ <o>قَآ</>ئِ<p>لُو</>نَ"},{"n":5,"w":[["فَمَا","famā","Then not","অতঃপর না"],["كَانَ","kāna","was","ছিলো"],["دَعْوَىٰهُمْ","da‘wāhum","their plea","দাবি তাদের(কথা)"],["إِذْ","idh","when","যখন"],["جَآءَهُم","jāahum","came to them","তাদের (কাছে) এসেছিলো"],["بَأْسُنَآ","basunā","Our punishment","শাস্তি আমাদের"],["إِلَّآ","illā","except","এ ছাড়া"],["أَن","an","that","যে"],["قَالُوٓا۟","qālū","they said","তারা বলেছিলো"],["إِنَّا","innā","Indeed, we","\"নিশ্চয়ই আমরা"],["كُنَّا","kunnā","were","আমরা ছিলাম"],["ظَـٰلِمِينَ","ẓālimīna","wrongdoers","সীমালঙ্ঘনকারী\""]],"t":"فَمَا كَانَ دَعْوَ<m>ىٰ</>هُمْ إِذْ <o>جَآ</>ءَ<f>هُم بَ</>أْسُ<o>نَآ</> إِ<o>لَّآ</> أَ<k>ن قَ</>ا<o>لُوٓ</><s>ا۟</> إِ<g>نَّ</>ا كُ<g>نَّ</>ا <m>ظَٰ</>لِ<p>مِي</>نَ"},{"n":6,"w":[["فَلَنَسْـَٔلَنَّ","falanasalanna","Then surely We will question","অতএব জিজ্ঞাসা করবোই আমরা"],["ٱلَّذِينَ","alladhīna","those (to) whom","তাদেরকে"],["أُرْسِلَ","ur'sila","were sent","পাঠান হয়েছিলো"],["إِلَيْهِمْ","ilayhim","to them (Messengers)","প্রতি যাদের"],["وَلَنَسْـَٔلَنَّ","walanasalanna","and surely We will question","ও অবশ্যই জিজ্ঞাসা করবো আমরা"],["ٱلْمُرْسَلِينَ","l-mur'salīna","the Messengers","রাসূলদেরকেও"]],"t":"فَلَنَسْـَٔلَ<g>نَّ</> <h>ٱ</>لَّذِينَ أُرْسِلَ إِلَيْهِمْ وَلَنَسْـَٔلَ<g>نَّ</> <h>ٱ</>لْمُرْسَ<p>لِي</>نَ"},{"n":7,"w":[["فَلَنَقُصَّنَّ","falanaquṣṣanna","Then surely We will narrate","অতঃপর ঘটনা বর্ণনা করবোই আমরা"],["عَلَيْهِم","‘alayhim","to them","কাছে তাদের"],["بِعِلْمٍۢ ۖ","bi‘il'min","with knowledge","ভিত্তিতে জ্ঞানের"],["وَمَا","wamā","and not","আর না"],["كُنَّا","kunnā","were We","আমরা ছিলাম"],["غَآئِبِينَ","ghāibīna","absent","অনুপস্থিত"]],"t":"فَلَنَقُصَّ<g>نَّ</> عَلَيْ<f>هِم بِ</>عِلْ<d>مٍۢ ۖ وَ</>مَا كُ<g>نَّ</>ا <o>غَآ</>ئِ<p>بِي</>نَ"},{"n":8,"w":[["وَٱلْوَزْنُ","wal-waznu","And the weighing","এবং ওজন"],["يَوْمَئِذٍ","yawma-idhin","that day","সেদিন (হবে)"],["ٱلْحَقُّ ۚ","l-ḥaqu","(will be) the truth","যথার্থই"],["فَمَن","faman","So whose ","অতঃপর যার"],["ثَقُلَتْ","thaqulat","(will be) heavy","ভারী হবে"],["مَوَٰزِينُهُۥ","mawāzīnuhu","his scales","পাল্লাসমূহ তার"],["فَأُو۟لَـٰٓئِكَ","fa-ulāika","then those","অতঃপর ঐসব লোক"],["هُمُ","humu","[they]","তারাই"],["ٱلْمُفْلِحُونَ","l-muf'liḥūna","(will be) the successful ones","সফলকাম (হবে)"]],"t":"وَ<h>ٱ</>لْوَزْنُ يَوْمَئِذٍ <h>ٱ</>لْحَقُّ ۚ فَمَ<k>ن ثَ</>قُلَتْ مَ<m>وَٰ</>زِينُهُ<m>ۥ</> فَأُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</>لْمُفْلِ<p>حُو</>نَ"},{"n":9,"w":[["وَمَنْ","waman","And (for) those","এবং যার"],["خَفَّتْ","khaffat","(will be) light","হালকা হবে"],["مَوَٰزِينُهُۥ","mawāzīnuhu","his scales","পাল্লাসমূহ তার"],["فَأُو۟لَـٰٓئِكَ","fa-ulāika","so those","অতঃপর ঐসবলোক"],["ٱلَّذِينَ","alladhīna","(will be) the ones who","(তারাই) যারা"],["خَسِرُوٓا۟","khasirū","lost","ক্ষতি করেছে"],["أَنفُسَهُم","anfusahum","themselves","নিজেদেরকে তাদের"],["بِمَا","bimā","because","একারণে যা"],["كَانُوا۟","kānū","they were","তারা ছিলো"],["بِـَٔايَـٰتِنَا","biāyātinā","to Our Verses","সাথে আমাদের নির্দশনাদির"],["يَظْلِمُونَ","yaẓlimūna","(doing) injustice","সীমালঙ্ঘন করতো"]],"t":"وَمَنْ خَفَّتْ مَ<m>وَٰ</>زِينُهُ<m>ۥ</> فَأُ<s>و۟</><o>لَٰٓ</>ئِكَ <h>ٱ</>لَّذِينَ خَسِ<o>رُوٓ</><s>ا۟</> أَ<k>نفُ</>سَ<f>هُم بِ</>مَا كَانُو<s>ا۟</> بِـَٔا<m>يَٰ</>تِنَا يَظْلِ<p>مُو</>نَ"},{"n":10,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["مَكَّنَّـٰكُمْ","makkannākum","We established you","আমরা প্রতিষ্ঠিত করেছি তোমাদেরকে"],["فِى","fī","in","উপর"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["وَجَعَلْنَا","waja‘alnā","and We made","এবং ব্যবস্হা করেছি আমরা"],["لَكُمْ","lakum","for you","জন্যে তোমাদের"],["فِيهَا","fīhā","in it","মধ্যে তার"],["مَعَـٰيِشَ ۗ","ma‘āyisha","livelihood","জীবিকার"],["قَلِيلًۭا","qalīlan","Little","(কিন্তু) অল্পই"],["مَّا","mā","(is) what","যা"],["تَشْكُرُونَ","tashkurūna","you (are) grateful","তোমরা কৃতজ্ঞতা জ্ঞাপন করো"]],"t":"وَلَقَ<q>دْ</> مَكَّ<g>نَّٰ</>كُمْ فِى <h>ٱ</>لْأَرْضِ وَجَعَلْنَا لَكُمْ فِيهَا مَ<m>عَٰ</>يِشَ ۗ قَلِيلًۭ<d>ا مَّ</>ا تَشْكُ<p>رُو</>نَ"},{"n":11,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["خَلَقْنَـٰكُمْ","khalaqnākum","We created you","সৃষ্টি করেছি আমরা তোমাদের"],["ثُمَّ","thumma","then","এরপর"],["صَوَّرْنَـٰكُمْ","ṣawwarnākum","We fashioned you","রূপদান করেছি আমরা তোমাদেরকে"],["ثُمَّ","thumma","Then","এরপর"],["قُلْنَا","qul'nā","We said","বলেছিলাম আমরা"],["لِلْمَلَـٰٓئِكَةِ","lil'malāikati","to the Angels","উদ্দেশ্যে ফেরেশতাদের"],["ٱسْجُدُوا۟","us'judū","Prostrate","\"তোমরা সিজদা করো"],["لِـَٔادَمَ","liādama","to Adam","উদ্দেশ্যে আদমের\""],["فَسَجَدُوٓا۟","fasajadū","So they prostrated","অতঃপর তারা সিজদা করলো"],["إِلَّآ","illā","except","ছাড়া"],["إِبْلِيسَ","ib'līsa","Iblis","ইবলীস"],["لَمْ","lam","Not","নি"],["يَكُن","yakun","he was","সে হয়"],["مِّنَ","mina","of","অন্তর্ভুক্ত"],["ٱلسَّـٰجِدِينَ","l-sājidīna","those who prostrated","সিজদাকারীদের"]],"t":"وَلَقَ<q>دْ</> خَلَ<q>قْ</><m>نَٰ</>كُمْ ثُ<g>مَّ</> صَوَّرْ<m>نَٰ</>كُمْ ثُ<g>مَّ</> قُلْنَا لِلْمَ<o>لَٰٓ</>ئِكَةِ <h>ٱ</>سْجُدُو<s>ا۟</> لِءَادَمَ فَسَجَ<o>دُوٓ</><s>ا۟</> إِ<o>لَّآ</> إِ<q>بْ</>لِيسَ لَمْ يَ<d>كُن مِّ</>نَ <h>ٱ</><l>ل</><m>سَّٰ</>جِ<p>دِي</>نَ"},{"n":12,"w":[["قَالَ","qāla","(Allah) said","(আল্লাহ) বললেন"],["مَا","mā","What","\"কিসে"],["مَنَعَكَ","mana‘aka","prevented you","তোমাকে বাধা দিলো"],["أَلَّا","allā","that not","যে না"],["تَسْجُدَ","tasjuda","you prostrate","তুমি সিজদা করলে (আদমকে)"],["إِذْ","idh","when","যখন"],["أَمَرْتُكَ ۖ","amartuka","I commanded you","তোমাকে আমি নির্দেশ দিয়েছি\""],["قَالَ","qāla","(Shaitaan) said","(ইবলীস) বললো"],["أَنَا۠","anā","I am","\"আমি"],["خَيْرٌۭ","khayrun","better","উত্তম"],["مِّنْهُ","min'hu","than him","চেয়েও তার"],["خَلَقْتَنِى","khalaqtanī","You created me","আপনি সৃষ্টি করেছেন আমাকে"],["مِن","min","from","হতে"],["نَّارٍۢ","nārin","fire","আগুন"],["وَخَلَقْتَهُۥ","wakhalaqtahu","and You created him","এবং আপনি সৃষ্টি করেছেন তাকে"],["مِن","min","from","দিয়ে"],["طِينٍۢ","ṭīnin","clay","কাদা মাটি\""]],"t":"قَالَ مَا مَنَعَكَ أَلَّا تَسْجُدَ إِذْ أَمَرْتُكَ ۖ قَالَ أَنَا۠ خَيْ<d>رٌۭ مِّ</>نْهُ خَلَ<q>قْ</>تَنِى <d>مِن نَّارٍۢ وَ</>خَلَ<q>قْ</>تَهُ<m>ۥ</> مِ<k>ن طِ</><p>ي</>نٍۢ"},{"n":13,"w":[["قَالَ","qāla","(Allah) said","(আল্লা্হ) বললেন"],["فَٱهْبِطْ","fa-ih'biṭ","Then go down","\"তাহ'লে তুমি নেমে যাও"],["مِنْهَا","min'hā","from it","থেকে এখান"],["فَمَا","famā","for not","কারণ না"],["يَكُونُ","yakūnu","it is","হতে পারে"],["لَكَ","laka","for you","জন্যে তোমার"],["أَن","an","that","যে"],["تَتَكَبَّرَ","tatakabbara","you be arrogant","অহংকার করবে তুমি"],["فِيهَا","fīhā","in it","মধ্যে এর"],["فَٱخْرُجْ","fa-ukh'ruj","So get out","অতএব তুমি বের হও"],["إِنَّكَ","innaka","indeed, you","নিশ্চয়ই তুমি"],["مِنَ","mina","(are) of","অন্তর্ভুক্ত"],["ٱلصَّـٰغِرِينَ","l-ṣāghirīna","the disgraced ones","অধমদের\""]],"t":"قَالَ فَ<h>ٱ</>هْبِ<q>طْ</> مِنْهَا فَمَا يَكُونُ لَكَ أَ<k>ن تَ</>تَكَبَّرَ فِيهَا فَ<h>ٱ</>خْرُ<q>جْ</> إِ<g>نَّ</>كَ مِنَ <h>ٱ</><l>ل</><m>صَّٰ</>غِ<p>رِي</>نَ"},{"n":14,"w":[["قَالَ","qāla","(Shaitaan) said","(ইবলীস) বললো"],["أَنظِرْنِىٓ","anẓir'nī","Give me respite","\"আমাকে অবকাশ দিন"],["إِلَىٰ","ilā","till","পর্যন্ত"],["يَوْمِ","yawmi","(the) Day","(ঐ) দিন"],["يُبْعَثُونَ","yub'‘athūna","they are raised up","(যখন) তারা উত্থিত হবে\""]],"t":"قَالَ أَ<k>نظِ</>رْ<o>نِىٓ</> إِلَىٰ يَوْمِ يُ<q>بْ</>عَ<p>ثُو</>نَ"},{"n":15,"w":[["قَالَ","qāla","(Allah) said","(আল্লাহ) বললেন"],["إِنَّكَ","innaka","Indeed, you","\"নিশ্চয়ই তুমি"],["مِنَ","mina","(are) of","অন্তর্ভুক্ত"],["ٱلْمُنظَرِينَ","l-munẓarīna","the ones given respite","অবকাশ প্রাপ্তদের\""]],"t":"قَالَ إِ<g>نَّ</>كَ مِنَ <h>ٱ</>لْمُ<k>نظَ</><p>رِي</>نَ"},{"n":16,"w":[["قَالَ","qāla","(Shaitaan) said","সে বললো"],["فَبِمَآ","fabimā","Because","\"অতঃপর যে কারণে"],["أَغْوَيْتَنِى","aghwaytanī","You have sent me astray","আপনি পথভ্রষ্ট করলেন আমাকে"],["لَأَقْعُدَنَّ","la-aq‘udanna","surely I will sit","অবশ্যই আমি ওৎ পেতে বসবোই"],["لَهُمْ","lahum","for them","জন্যে তাদের"],["صِرَٰطَكَ","ṣirāṭaka","(on) Your path","তোমার পথে"],["ٱلْمُسْتَقِيمَ","l-mus'taqīma","the straight","(যা) সরল সঠিক"]],"t":"قَالَ فَبِ<o>مَآ</> أَغْوَيْتَنِى لَأَ<q>قْ</>عُدَ<g>نَّ</> لَهُمْ صِ<m>رَٰ</>طَكَ <h>ٱ</>لْمُسْتَ<p>قِي</>مَ"},{"n":17,"w":[["ثُمَّ","thumma","Then","এরপর"],["لَـَٔاتِيَنَّهُم","laātiyannahum","surely, I will come to them","অবশ্যই আমি আসবোই কাছে তাদের"],["مِّنۢ","min","from","হতে"],["بَيْنِ","bayni","before","মাঝে"],["أَيْدِيهِمْ","aydīhim","them","হাতের তাদের"],["وَمِنْ","wamin","and from","ও হতে"],["خَلْفِهِمْ","khalfihim","behind them","পিছন তাদের"],["وَعَنْ","wa‘an","and from","ও হতে"],["أَيْمَـٰنِهِمْ","aymānihim","their right","ডানদিক তাদের"],["وَعَن","wa‘an","and from","ও হতে"],["شَمَآئِلِهِمْ ۖ","shamāilihim","their left","বামদিক তাদের"],["وَلَا","walā","and not","এবং না"],["تَجِدُ","tajidu","You (will) find","তুমি পাবে"],["أَكْثَرَهُمْ","aktharahum","most of them","অধিকাংশকে তাদের"],["شَـٰكِرِينَ","shākirīna","grateful","কৃতজ্ঞরূপে\""]],"t":"ثُ<g>مَّ</> لَءَاتِيَ<g>نَّ</><y>هُم مِّ</><i>نۢ بَ</>يْنِ أَيْدِيهِمْ وَمِنْ خَلْفِهِمْ وَعَنْ أَيْ<m>مَٰ</>نِهِمْ وَعَ<k>ن شَ</><o>مَآ</>ئِلِهِمْ ۖ وَلَا تَجِدُ أَكْثَرَهُمْ <m>شَٰ</>كِ<p>رِي</>نَ"},{"n":18,"w":[["قَالَ","qāla","(Allah) said","(আল্লাহ) বললেন"],["ٱخْرُجْ","ukh'ruj","Get out","\"তুমি বের হও"],["مِنْهَا","min'hā","of it","হতে এখান"],["مَذْءُومًۭا","madhūman","disgraced","ধিকৃতরূপে"],["مَّدْحُورًۭا ۖ","madḥūran","and expelled","বিতাড়িত হয়ে"],["لَّمَن","laman","Certainly, whoever","অবশ্যই যে"],["تَبِعَكَ","tabi‘aka","follows you","তোমাকে অনুসরণ করবে"],["مِنْهُمْ","min'hum","among them","মধ্য হতে তাদের"],["لَأَمْلَأَنَّ","la-amla-anna","surely, I will fill","অবশ্যই পূর্ণ করব আমি"],["جَهَنَّمَ","jahannama","Hell","জাহান্নামকে"],["مِنكُمْ","minkum","with you","দিয়ে তোমাদের"],["أَجْمَعِينَ","ajma‘īna","all","সবাইকে"]],"t":"قَالَ <h>ٱ</>خْرُ<q>جْ</> مِنْهَا مَذْءُو<d>مًۭا مَّ</><q>دْ</>حُو<w>رًۭا ۖ لَّ</>مَ<k>ن تَ</>بِعَكَ مِنْهُمْ لَأَمْلَأَ<g>نَّ</> جَهَ<g>نَّ</>مَ مِ<k>نكُ</>مْ أَ<q>جْ</>مَ<p>عِي</>نَ"},{"n":19,"w":[["وَيَـٰٓـَٔادَمُ","wayāādamu","And O Adam","এবং হে আদম"],["ٱسْكُنْ","us'kun","Dwell","বসবাস করো"],["أَنتَ","anta","you","তুমি"],["وَزَوْجُكَ","wazawjuka","and your wife","ও তোমার স্ত্রী"],["ٱلْجَنَّةَ","l-janata","(in) the Garden","জান্নাতে"],["فَكُلَا","fakulā","and you both eat","অতঃপর দু'জনে খাও"],["مِنْ","min","from","থেকে"],["حَيْثُ","ḥaythu","wherever","যেখান"],["شِئْتُمَا","shi'tumā","you both wish","তোমরা দু'জনে চাও"],["وَلَا","walā","but (do) not","তবে না"],["تَقْرَبَا","taqrabā","approach [both of you]","দু'জনে নিকটে হবে"],["هَـٰذِهِ","hādhihi","this","এই"],["ٱلشَّجَرَةَ","l-shajarata","[the] tree","গাছের"],["فَتَكُونَا","fatakūnā","lest you both be","তাহ'লে দু'জনে হবে"],["مِنَ","mina","among","অন্তর্ভুক্ত"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","সীমালঙ্ঘনকারীদের\""]],"t":"وَ<o>يَٰٓـَٔ</>ادَمُ <h>ٱ</>سْكُنْ أَ<k>نتَ</> وَزَوْجُكَ <h>ٱ</>لْجَ<g>نَّ</>ةَ فَكُلَا مِنْ حَيْثُ شِئْتُمَا وَلَا تَ<q>قْ</>رَبَا <m>هَٰ</>ذِهِ <h>ٱ</><l>ل</>شَّجَرَةَ فَتَكُونَا مِنَ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":20,"w":[["فَوَسْوَسَ","fawaswasa","Then whispered","অতঃপর কুমন্ত্রণা দিলো"],["لَهُمَا","lahumā","to both of them","প্রতি তাদের দুজনের"],["ٱلشَّيْطَـٰنُ","l-shayṭānu","the Shaitaan","শয়তান"],["لِيُبْدِىَ","liyub'diya","to make apparent","যেন প্রকাশ করে দেয়"],["لَهُمَا","lahumā","to both of them","কাছে তাদের দু'জনের"],["مَا","mā","what","যা"],["وُۥرِىَ","wūriya","was concealed","গোপন রাখা হয়েছিলো"],["عَنْهُمَا","‘anhumā","from both of them","নিকট তাদের দুজন"],["مِن","min","of","থেকে"],["سَوْءَٰتِهِمَا","sawātihimā","their shame","দুজনের লজ্জাস্থানগুলো তাদের"],["وَقَالَ","waqāla","And he said","এবং (শয়তান) বললো"],["مَا","mā","(Did) not","\"না"],["نَهَىٰكُمَا","nahākumā","forbid you both","তোমাদের দুজনকে নিষেধ করেছেন"],["رَبُّكُمَا","rabbukumā","your Lord","তোমাদের দুজনের রব"],["عَنْ","‘an","from","হতে"],["هَـٰذِهِ","hādhihi","this","এই"],["ٱلشَّجَرَةِ","l-shajarati","[the] tree","গাছ"],["إِلَّآ","illā","except","এছাড়া"],["أَن","an","that","যে"],["تَكُونَا","takūnā","you two become","তোমরা দুজনে হয়ে যাবে"],["مَلَكَيْنِ","malakayni","Angels","দুই ফেরেশতা"],["أَوْ","aw","or","অথবা"],["تَكُونَا","takūnā","you two become","তোমরা দুজনে হবে"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْخَـٰلِدِينَ","l-khālidīna","the immortals","চিরস্থায়ীদের\""]],"t":"فَوَسْوَسَ لَهُمَا <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نُ لِيُ<q>بْ</>دِىَ لَهُمَا مَا وُ<m>ۥ</>رِىَ عَنْهُمَا مِ<k>ن سَ</>وْ<m>ءَٰ</>تِهِمَا وَقَالَ مَا نَهَ<m>ىٰ</>كُمَا رَبُّكُمَا عَنْ <m>هَٰ</>ذِهِ <h>ٱ</><l>ل</>شَّجَرَةِ إِ<o>لَّآ</> أَ<k>ن تَ</>كُونَا مَلَكَيْنِ أَوْ تَكُونَا مِنَ <h>ٱ</>لْ<m>خَٰ</>لِ<p>دِي</>نَ"},{"n":21,"w":[["وَقَاسَمَهُمَآ","waqāsamahumā","And he swore (to) both of them","এবং তাদের দুজনের কাছে সে শপথ করলে"],["إِنِّى","innī","Indeed, I am","\"নিশ্চয়ই আমি"],["لَكُمَا","lakumā","to both of you","জন্যে তোমাদের দুজনের"],["لَمِنَ","lamina","among","অবশ্যই অন্তর্ভুক্ত"],["ٱلنَّـٰصِحِينَ","l-nāṣiḥīna","the sincere advisors","শুভাকাঙ্ক্ষী\""]],"t":"وَقَاسَمَهُ<o>مَآ</> إِ<g>نِّ</>ى لَكُمَا لَمِنَ <h>ٱ</><l>ل</><g>نَّٰ</>صِ<p>حِي</>نَ"},{"n":22,"w":[["فَدَلَّىٰهُمَا","fadallāhumā","So he made both of them fall","এভাবে সে অধঃপতিত করলো তাদের দুজনকে"],["بِغُرُورٍۢ ۚ","bighurūrin","by deception","দ্বারা ধোঁকা"],["فَلَمَّا","falammā","Then when","অতঃপর যখন"],["ذَاقَا","dhāqā","they both tasted","দু'জনে স্বাদ নিলো"],["ٱلشَّجَرَةَ","l-shajarata","the tree","গাছের (ফলের)"],["بَدَتْ","badat","became apparent","প্রকাশ পেলো"],["لَهُمَا","lahumā","to both of them","কাছে তাদের দু'জনের"],["سَوْءَٰتُهُمَا","sawātuhumā","their shame","লজ্জাস্থানগুলো তাদের দু'জনের"],["وَطَفِقَا","waṭafiqā","and they began","এবং দু'জনে শুরু করলো"],["يَخْصِفَانِ","yakhṣifāni","(to) fasten","দু'জনে ঢাকতে"],["عَلَيْهِمَا","‘alayhimā","over themselves","দু'জনের উপর তাদের"],["مِن","min","from","দিয়ে"],["وَرَقِ","waraqi","(the) leaves","পাতা"],["ٱلْجَنَّةِ ۖ","l-janati","(of) the Garden","জান্নাতের"],["وَنَادَىٰهُمَا","wanādāhumā","And called them both","এবং দু'জনকে ডাকলেন তাদের"],["رَبُّهُمَآ","rabbuhumā","their Lord","দু'জনের রব তাদের"],["أَلَمْ","alam","Did not","\"কি নি"],["أَنْهَكُمَا","anhakumā","I forbid you both","তোমাদের দু'জনকে আমি নিষেধ করি"],["عَن","‘an","from","থেকে"],["تِلْكُمَا","til'kumā","this","এই"],["ٱلشَّجَرَةِ","l-shajarati","[the] tree","গাছ"],["وَأَقُل","wa-aqul","and [I] say","এবং আমি বলি (নি)"],["لَّكُمَآ","lakumā","to both of you","উদ্দেশ্যে তোমাদের দু'জনের"],["إِنَّ","inna","that","নিশ্চয়ই"],["ٱلشَّيْطَـٰنَ","l-shayṭāna","[the] Shaitaan","শয়তান"],["لَكُمَا","lakumā","to both of you","জন্যে তোমাদের দু'জনের"],["عَدُوٌّۭ","‘aduwwun","(is) an enemy","শত্রু\""],["مُّبِينٌۭ","mubīnun","open","প্রকাশ্য\""]],"t":"فَدَلَّ<m>ىٰ</>هُمَا بِغُرُو<k>رٍۢ ۚ فَ</>لَ<g>مَّ</>ا ذَاقَا <h>ٱ</><l>ل</>شَّجَرَةَ بَدَتْ لَهُمَا سَوْ<m>ءَٰ</>تُهُمَا وَطَفِقَا يَخْصِفَانِ عَلَيْهِمَا <d>مِن وَ</>رَقِ <h>ٱ</>لْجَ<g>نَّ</>ةِ ۖ وَنَادَ<m>ىٰ</>هُمَا رَبُّهُ<o>مَآ</> أَلَمْ أَنْهَكُمَا عَ<k>ن تِ</>لْكُمَا <h>ٱ</><l>ل</>شَّجَرَةِ وَأَقُل لَّكُ<o>مَآ</> إِ<g>نَّ</> <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نَ لَكُمَا عَدُ<d>وٌّۭ مُّ</><p>بِي</>نٌۭ"},{"n":23,"w":[["قَالَا","qālā","Both of them said","(আদম ও হাওয়া) দু'জনে বললো"],["رَبَّنَا","rabbanā","Our Lord","\"হে আমাদের রব"],["ظَلَمْنَآ","ẓalamnā","we have wronged","অন্যায় করেছি আমরা"],["أَنفُسَنَا","anfusanā","ourselves","আমাদের নিজেদের (উপর)"],["وَإِن","wa-in","and if","এবং যদি"],["لَّمْ","lam","not","না"],["تَغْفِرْ","taghfir","You forgive","ক্ষমা করো তুমি"],["لَنَا","lanā","[for] us","আমাদেরকে"],["وَتَرْحَمْنَا","watarḥamnā","and have mercy (on) us","ও আমাদেরকে দয়া (না) করো"],["لَنَكُونَنَّ","lanakūnanna","surely, we will be","অবশ্যই  আমরা হবো"],["مِنَ","mina","among","অন্তর্ভুক্ত"],["ٱلْخَـٰسِرِينَ","l-khāsirīna","the losers","ক্ষতিগ্রস্তদের\""]],"t":"قَالَا رَبَّنَا ظَلَمْ<o>نَآ</> أَ<k>نفُ</>سَنَا وَ<w>إِن لَّ</>مْ تَغْفِرْ لَنَا وَتَرْحَمْنَا لَنَكُونَ<g>نَّ</> مِنَ <h>ٱ</>لْ<m>خَٰ</>سِ<p>رِي</>نَ"},{"n":24,"w":[["قَالَ","qāla","(Allah) said","(আল্লাহ) বললেন"],["ٱهْبِطُوا۟","ih'biṭū","Get down","\"তোমরা নেমে যাও"],["بَعْضُكُمْ","ba‘ḍukum","some of you","তোমাদের একে"],["لِبَعْضٍ","liba‘ḍin","to some others","জন্যে অপরের"],["عَدُوٌّۭ ۖ","‘aduwwun","(as) enemy","শত্রু"],["وَلَكُمْ","walakum","And for you","এবং জন্যে  তোমাদের (থাকবে)"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["مُسْتَقَرٌّۭ","mus'taqarrun","(is) a dwelling place","অবস্থান"],["وَمَتَـٰعٌ","wamatā‘un","and livelihood","ও জীবন সামগ্রী"],["إِلَىٰ","ilā","for","পর্যন্ত"],["حِينٍۢ","ḥīnin","a time","নির্দিষ্ট সময়\""]],"t":"قَالَ <h>ٱ</>هْبِطُو<s>ا۟</> بَعْضُكُمْ لِبَعْضٍ عَدُ<d>وٌّۭ ۖ وَ</>لَكُمْ فِى <h>ٱ</>لْأَرْضِ مُسْتَقَ<d>رٌّۭ وَ</>مَ<m>تَٰ</>عٌ إِلَىٰ <p>حِي</>نٍۢ"},{"n":25,"w":[["قَالَ","qāla","He said","তিনি বললেন"],["فِيهَا","fīhā","In it","\"মধ্যে তার"],["تَحْيَوْنَ","taḥyawna","you will live","জীবিত থাকবে তোমরা"],["وَفِيهَا","wafīhā","and in it","ও মধ্যে তার"],["تَمُوتُونَ","tamūtūna","you will die","মৃত্যুবরণ করবে তোমরা"],["وَمِنْهَا","wamin'hā","and from it","ও থেকে তা"],["تُخْرَجُونَ","tukh'rajūna","you will be brought forth","তোমাদের বের করা হবে\""]],"t":"قَالَ فِيهَا تَحْيَوْنَ وَفِيهَا تَمُوتُونَ وَمِنْهَا تُخْرَ<p>جُو</>نَ"},{"n":26,"w":[["يَـٰبَنِىٓ","yābanī","O Children","হে সন্তান"],["ءَادَمَ","ādama","(of) Adam","আদমের"],["قَدْ","qad","Verily","নিশ্চয়ই"],["أَنزَلْنَا","anzalnā","We have sent down","অবতীর্ণ করেছি আমরা"],["عَلَيْكُمْ","‘alaykum","to you","উপর তোমাদের"],["لِبَاسًۭا","libāsan","clothing","পোশাক"],["يُوَٰرِى","yuwārī","it covers","তা ঢেকে রাখে"],["سَوْءَٰتِكُمْ","sawātikum","your shame","লজ্জাস্থানগুলো তোমাদের"],["وَرِيشًۭا ۖ","warīshan","and (as) an adornment","ও শোভা বর্ধকরূপে"],["وَلِبَاسُ","walibāsu","But the clothing","ও পোশাক"],["ٱلتَّقْوَىٰ","l-taqwā","(of) [the] righteousness ","তাকওয়ার"],["ذَٰلِكَ","dhālika","that","এটাই"],["خَيْرٌۭ ۚ","khayrun","(is) best","উত্তম"],["ذَٰلِكَ","dhālika","That","এটা"],["مِنْ","min","(is) from","অন্তর্ভুক্ত"],["ءَايَـٰتِ","āyāti","(the) Signs","নিদর্শনাবলীর"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["لَعَلَّهُمْ","la‘allahum","so that they may","সম্ভবতঃ তারা"],["يَذَّكَّرُونَ","yadhakkarūna","remember","শিক্ষা গ্রহন করবে"]],"t":"<m>يَٰ</>بَ<o>نِىٓ</> ءَادَمَ قَ<q>دْ</> أَ<k>نزَ</>لْنَا عَلَيْكُمْ لِبَا<d>سًۭا يُ</><m>وَٰ</>رِى سَوْ<m>ءَٰ</>تِكُمْ وَرِي<d>شًۭا ۖ وَ</>لِبَاسُ <h>ٱ</><l>ل</>تَّ<q>قْ</>وَىٰ <m>ذَٰ</>لِكَ خَيْ<k>رٌۭ ۚ ذَٰ</>لِكَ مِنْ ءَا<m>يَٰ</>تِ <h>ٱ</>للَّهِ لَعَلَّهُمْ يَذَّكَّ<p>رُو</>نَ"},{"n":27,"w":[["يَـٰبَنِىٓ","yābanī","O Children","হে সন্তান"],["ءَادَمَ","ādama","(of) Adam","আদমের"],["لَا","lā","(Let) not","না (যেন)"],["يَفْتِنَنَّكُمُ","yaftinannakumu","tempt you","তোমাদের পরীক্ষায় ফেলে"],["ٱلشَّيْطَـٰنُ","l-shayṭānu","[the] Shaitaan","শয়তান"],["كَمَآ","kamā","as","যেমন"],["أَخْرَجَ","akhraja","he drove out","সে বের করেছিলো"],["أَبَوَيْكُم","abawaykum","your parents","পিতা-মাতাকে তোমাদের"],["مِّنَ","mina","from","থেকে"],["ٱلْجَنَّةِ","l-janati","Paradise","জান্নাত"],["يَنزِعُ","yanzi‘u","stripping","খুলে ফেলে"],["عَنْهُمَا","‘anhumā","from both of them","থেকে তাদের দু'জন"],["لِبَاسَهُمَا","libāsahumā","their clothing","পোষাক তাদের দু'জনের"],["لِيُرِيَهُمَا","liyuriyahumā","to show both of them","জন্যে তাদের দু'জনকে দেখানোর"],["سَوْءَٰتِهِمَآ ۗ","sawātihimā","their shame","লজ্জাস্থান তাদের দু'জনের"],["إِنَّهُۥ","innahu","Indeed, he","নিশ্চয়ই সে"],["يَرَىٰكُمْ","yarākum","sees you ","দেখে তোমাদের"],["هُوَ","huwa","he","সে"],["وَقَبِيلُهُۥ","waqabīluhu","and his tribe","ও দলবল তার"],["مِنْ","min","from","থেকে"],["حَيْثُ","ḥaythu","where","যেখান"],["لَا","lā","not","না"],["تَرَوْنَهُمْ ۗ","tarawnahum","you see them","তোমরা দেখো তাদেরকে"],["إِنَّا","innā","Indeed","নিশ্চয়ই আমরা"],["جَعَلْنَا","ja‘alnā","We have made","আমরা বানিয়েছি"],["ٱلشَّيَـٰطِينَ","l-shayāṭīna","the devils","শয়তানদেরকে"],["أَوْلِيَآءَ","awliyāa","friends","অভিভাবকরূপে"],["لِلَّذِينَ","lilladhīna","of those who","(তাদের) জন্যে যারা"],["لَا","lā","(do) not","না"],["يُؤْمِنُونَ","yu'minūna","believe","ঈমান আনে"]],"t":"<m>يَٰ</>بَ<o>نِىٓ</> ءَادَمَ لَا يَفْتِنَ<g>نَّ</>كُمُ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نُ كَ<o>مَآ</> أَخْرَجَ أَبَوَيْ<y>كُم مِّ</>نَ <h>ٱ</>لْجَ<g>نَّ</>ةِ يَ<k>نزِ</>عُ عَنْهُمَا لِبَاسَهُمَا لِيُرِيَهُمَا سَوْ<m>ءَٰ</>تِهِ<o>مَآ ۗ</> إِ<g>نَّ</>هُ<m>ۥ</> يَرَ<m>ىٰ</>كُمْ هُوَ وَقَبِيلُهُ<m>ۥ</> مِنْ حَيْثُ لَا تَرَوْنَهُمْ ۗ إِ<g>نَّ</>ا جَعَلْنَا <h>ٱ</><l>ل</>شَّ<m>يَٰ</>طِينَ أَوْلِ<o>يَآ</>ءَ لِلَّذِينَ لَا يُؤْمِ<p>نُو</>نَ"},{"n":28,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["فَعَلُوا۟","fa‘alū","they do","তারা করে"],["فَـٰحِشَةًۭ","fāḥishatan","immorality","অশ্লীল কাজ"],["قَالُوا۟","qālū","they say","তারা বলে"],["وَجَدْنَا","wajadnā","We found","\"পেয়েছি আমরা"],["عَلَيْهَآ","‘alayhā","on it","উপর এসবের"],["ءَابَآءَنَا","ābāanā","our forefathers","বাপ-দাদাদেরকে আমাদের"],["وَٱللَّهُ","wal-lahu","and Allah","এবং আল্লাহ"],["أَمَرَنَا","amaranā","(has) ordered us","নির্দেশ দিয়েছেন আমাদের"],["بِهَا ۗ","bihā","of it","সম্পর্কে এর\""],["قُلْ","qul","Say","তুমি বলো"],["إِنَّ","inna","Indeed","\"নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَا","lā","(does) not","না"],["يَأْمُرُ","yamuru","order","নির্দেশ দেন"],["بِٱلْفَحْشَآءِ ۖ","bil-faḥshāi","immorality","ব্যাপারে অশ্লীলতার"],["أَتَقُولُونَ","ataqūlūna","Do you say","কি তোমরা বলছো"],["عَلَى","‘alā","about","সম্পর্কে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["مَا","mā","what","যা"],["لَا","lā","not","না\""],["تَعْلَمُونَ","ta‘lamūna","you know","তোমরা জানো\""]],"t":"وَإِذَا فَعَلُو<s>ا۟</> <m>فَٰ</>حِشَ<k>ةًۭ قَ</>الُو<s>ا۟</> وَجَ<q>دْ</>نَا عَلَيْ<o>هَآ</> ءَا<o>بَآ</>ءَنَا وَ<h>ٱ</>للَّهُ أَمَرَنَا بِهَا ۗ قُلْ إِ<g>نَّ</> <h>ٱ</>للَّهَ لَا يَأْمُرُ بِ<h>ٱ</>لْفَحْ<o>شَآ</>ءِ ۖ أَتَقُولُونَ عَلَى <h>ٱ</>للَّهِ مَا لَا تَعْلَ<p>مُو</>نَ"},{"n":29,"w":[["قُلْ","qul","Say","(হে নাবী) বলো"],["أَمَرَ","amara","(Has been) ordered","\"নির্দেশ দিয়েছেন"],["رَبِّى","rabbī","(by) my Lord","\"আমার রব"],["بِٱلْقِسْطِ ۖ","bil-qis'ṭi","justice","ব্যাপারে ন্যায়ের"],["وَأَقِيمُوا۟","wa-aqīmū","and set","এবং তোমরা স্থির রাখো"],["وُجُوهَكُمْ","wujūhakum","your faces","লক্ষ্য তোমাদের"],["عِندَ","‘inda","at","সময়"],["كُلِّ","kulli","every","প্রত্যেক"],["مَسْجِدٍۢ","masjidin","masjid","মাসজীদের (সালাতের)"],["وَٱدْعُوهُ","wa-id'‘ūhu","and invoke Him","এবং তোমরা ডাকো তাঁকে"],["مُخْلِصِينَ","mukh'liṣīna","(being) sincere","তোমরা একনিষ্ঠভাবে"],["لَهُ","lahu","to Him","জন্যে তাঁরই"],["ٱلدِّينَ ۚ","l-dīna","(in) the religion","আনুগত্যকে (নিষ্ঠাপূর্ণ করে)"],["كَمَا","kamā","As","যেমন"],["بَدَأَكُمْ","bada-akum","He originated you","প্রথম সৃষ্টি করেছেন তোমাদের"],["تَعُودُونَ","ta‘ūdūna","(so) will you return","তোমরা (তেমনি) ফিরে আসবে\""]],"t":"قُلْ أَمَرَ رَبِّى بِ<h>ٱ</>لْقِسْطِ ۖ وَأَقِيمُو<s>ا۟</> وُجُوهَكُمْ عِ<k>ندَ</> كُلِّ مَسْجِ<d>دٍۢ وَ</><h>ٱ</><q>دْ</>عُوهُ مُخْلِصِينَ لَهُ <h>ٱ</><l>ل</>دِّينَ ۚ كَمَا بَدَأَكُمْ تَعُو<p>دُو</>نَ"},{"n":30,"w":[["فَرِيقًا","farīqan","A group","একদলকে"],["هَدَىٰ","hadā","He guided","তিনি সঠিক পথে চলিয়েছেন"],["وَفَرِيقًا","wafarīqan","and a group","এবং (অপর এক) দলের (জন্যে)"],["حَقَّ","ḥaqqa","deserved ","অবধারিত হয়েছে"],["عَلَيْهِمُ","‘alayhimu","[on] they","উপর তাদের"],["ٱلضَّلَـٰلَةُ ۗ","l-ḍalālatu","the astraying","পথ ভ্রষ্টতা"],["إِنَّهُمُ","innahumu","Indeed, they","নিশ্চয়ই তারা"],["ٱتَّخَذُوا۟","ittakhadhū","take","গ্রহন করেছে"],["ٱلشَّيَـٰطِينَ","l-shayāṭīna","the devils","শয়তানদেরকে"],["أَوْلِيَآءَ","awliyāa","(as) allies","অভিভাবকরূপে"],["مِن","min","from","দিয়ে"],["دُونِ","dūni","besides","বাদ"],["ٱللَّهِ","l-lahi","Allah","আল্লাহকে"],["وَيَحْسَبُونَ","wayaḥsabūna","while they think","এবং তারা মনে করে"],["أَنَّهُم","annahum","that they","যে তারা"],["مُّهْتَدُونَ","muh'tadūna","(are the) guided-ones","সঠিক-পথপ্রাপ্ত"]],"t":"فَرِيقًا هَدَىٰ وَفَرِيقًا حَقَّ عَلَيْهِمُ <h>ٱ</><l>ل</>ضَّ<m>لَٰ</>لَةُ ۗ إِ<g>نَّ</>هُمُ <h>ٱ</>تَّخَذُو<s>ا۟</> <h>ٱ</><l>ل</>شَّ<m>يَٰ</>طِينَ أَوْلِ<o>يَآ</>ءَ مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ وَيَحْسَبُونَ أَ<g>نَّ</><y>هُم مُّ</>هْتَ<p>دُو</>نَ"},{"n":31,"w":[["۞ يَـٰبَنِىٓ","yābanī","O Children","হে সন্তান"],["ءَادَمَ","ādama","(of) Adam","আদমের"],["خُذُوا۟","khudhū","Take","তোমরা গ্রহণ করো"],["زِينَتَكُمْ","zīnatakum","your adornment","সুন্দর পোশাক তোমাদের"],["عِندَ","‘inda","at","সময়"],["كُلِّ","kulli","every","প্রত্যেক"],["مَسْجِدٍۢ","masjidin","masjid","মাসজীদের (সালাতের)"],["وَكُلُوا۟","wakulū","and eat","এবং তোমরা খাও"],["وَٱشْرَبُوا۟","wa-ish'rabū","and drink","ও তোমরা পান কর"],["وَلَا","walā","but (do) not","কিন্তু না"],["تُسْرِفُوٓا۟ ۚ","tus'rifū","be extravagant","তোমরা সীমালঙ্ঘন করো"],["إِنَّهُۥ","innahu","Indeed, He","নিশ্চয়ই তিনি"],["لَا","lā","(does) not","না"],["يُحِبُّ","yuḥibbu","love","ভালোবাসেন"],["ٱلْمُسْرِفِينَ","l-mus'rifīna","the extravagant ones","সীমালঙ্ঘনকারীদেরকে"]],"t":"۞ <m>يَٰ</>بَ<o>نِىٓ</> ءَادَمَ خُذُو<s>ا۟</> زِينَتَكُمْ عِ<k>ندَ</> كُلِّ مَسْجِ<d>دٍۢ وَ</>كُلُو<s>ا۟</> وَ<h>ٱ</>شْرَبُو<s>ا۟</> وَلَا تُسْرِ<o>فُوٓ</><s>ا۟</> ۚ إِ<g>نَّ</>هُ<m>ۥ</> لَا يُحِبُّ <h>ٱ</>لْمُسْرِ<p>فِي</>نَ"},{"n":32,"w":[["قُلْ","qul","Say","(হে নাবী) বলো"],["مَنْ","man","Who","\"কে"],["حَرَّمَ","ḥarrama","has forbidden","নিষেধ করেছে"],["زِينَةَ","zīnata","(the) adornment","শোভার বস্তুকে"],["ٱللَّهِ","l-lahi","(from) Allah","আল্লাহর (দেওয়া)"],["ٱلَّتِىٓ","allatī","which","যা"],["أَخْرَجَ","akhraja","He has brought forth","তিনি সৃষ্টি করেছেন"],["لِعِبَادِهِۦ","li‘ibādihi","for His slaves","জন্যে তাঁর দাসদের"],["وَٱلطَّيِّبَـٰتِ","wal-ṭayibāti","and the pure things","ও পবিত্র বস্তুসমূহকে"],["مِنَ","mina","of","হতে"],["ٱلرِّزْقِ ۚ","l-riz'qi","sustenance","জীবিকা\""],["قُلْ","qul","Say","বলো"],["هِىَ","hiya","They","\"তা"],["لِلَّذِينَ","lilladhīna","(are) for those who","(তাদের) জন্যে যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান আনে"],["فِى","fī","during","মধ্যে (প্রতি)"],["ٱلْحَيَوٰةِ","l-ḥayati","the life","জীবনের"],["ٱلدُّنْيَا","l-dun'yā","(of) the world","পার্থিব"],["خَالِصَةًۭ","khāliṣatan","exclusively (for them)","বিশেষ করে"],["يَوْمَ","yawma","(on the) Day","দিনে"],["ٱلْقِيَـٰمَةِ ۗ","l-qiyāmati","(of) Resurrection","ক্বিয়ামাতের"],["كَذَٰلِكَ","kadhālika","Thus","এভাবে"],["نُفَصِّلُ","nufaṣṣilu","We explain","বিস্তারিত বর্ণনা করি আমরা"],["ٱلْـَٔايَـٰتِ","l-āyāti","the Signs","নিদর্শনাবলী"],["لِقَوْمٍۢ","liqawmin","for (the) people","জন্যে জাতির"],["يَعْلَمُونَ","ya‘lamūna","who know","(যারা) জ্ঞান রাখে\""]],"t":"قُلْ مَنْ حَرَّمَ زِينَةَ <h>ٱ</>للَّهِ <h>ٱ</>لَّ<o>تِىٓ</> أَخْرَجَ لِعِبَادِ<m>هِۦ</> وَ<h>ٱ</><l>ل</>طَّيِّ<m>بَٰ</>تِ مِنَ <h>ٱ</><l>ل</>رِّزْقِ ۚ قُلْ هِىَ لِلَّذِينَ ءَامَنُو<s>ا۟</> فِى <h>ٱ</>لْحَيَ<s>وٰ</>ةِ <h>ٱ</><l>ل</>دُّنْيَا خَالِصَ<d>ةًۭ يَ</>وْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ ۗ كَ<m>ذَٰ</>لِكَ نُفَصِّلُ <h>ٱ</>لْءَا<m>يَٰ</>تِ لِقَوْ<d>مٍۢ يَ</>عْلَ<p>مُو</>نَ"},{"n":33,"w":[["قُلْ","qul","Say","তুমি বলো"],["إِنَّمَا","innamā","Only","\"প্রকৃতপক্ষে"],["حَرَّمَ","ḥarrama","(had) forbidden","নিষিদ্ধ করেছেন"],["رَبِّىَ","rabbiya","my Lord","আমার রব"],["ٱلْفَوَٰحِشَ","l-fawāḥisha","the shameful deeds","অশ্লীল কাজগুলোকে"],["مَا","mā","what","যা"],["ظَهَرَ","ẓahara","(is) apparent","প্রকাশ্যে হয়"],["مِنْهَا","min'hā","of it","মধ্য হতে তার"],["وَمَا","wamā","and what","বা যা"],["بَطَنَ","baṭana","is concealed","গোপনেও হয়"],["وَٱلْإِثْمَ","wal-ith'ma","and the sin","এবং পাপ"],["وَٱلْبَغْىَ","wal-baghya","and the oppression","ও বিদ্রোহ"],["بِغَيْرِ","bighayri","without","নয়"],["ٱلْحَقِّ","l-ḥaqi","[the] right","সংগত"],["وَأَن","wa-an","and that","এবং (এও) যে"],["تُشْرِكُوا۟","tush'rikū","you associate (others)","তোমরা শিরক করো"],["بِٱللَّهِ","bil-lahi","with Allah","সাথে আল্লাহর"],["مَا","mā","what","যার"],["لَمْ","lam","not","নি"],["يُنَزِّلْ","yunazzil","He (has) sent down","তিনি অবতীর্ণ করেন"],["بِهِۦ","bihi","of it","সম্পর্কে সে"],["سُلْطَـٰنًۭا","sul'ṭānan","any authority","কোনো প্রমাণ"],["وَأَن","wa-an","and that","এবং (এও) যে"],["تَقُولُوا۟","taqūlū","you say","তোমরা বলো"],["عَلَى","‘alā","about","সম্বন্ধে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["مَا","mā","what","যা"],["لَا","lā","not","না\""],["تَعْلَمُونَ","ta‘lamūna","you know","তোমরা জানো\""]],"t":"قُلْ إِ<g>نَّ</>مَا حَرَّمَ رَبِّىَ <h>ٱ</>لْفَ<m>وَٰ</>حِشَ مَا ظَهَرَ مِنْهَا وَمَا بَطَنَ وَ<h>ٱ</>لْإِثْمَ وَ<h>ٱ</>لْبَغْىَ بِغَيْرِ <h>ٱ</>لْحَقِّ وَأَ<k>ن تُ</>شْرِكُو<s>ا۟</> بِ<h>ٱ</>للَّهِ مَا لَمْ يُنَزِّلْ بِ<m>هِۦ</> سُلْ<m>طَٰ</><d>نًۭا وَ</>أَ<k>ن تَ</>قُولُو<s>ا۟</> عَلَى <h>ٱ</>للَّهِ مَا لَا تَعْلَ<p>مُو</>نَ"},{"n":34,"w":[["وَلِكُلِّ","walikulli","And for every","এবং জন্যে প্রত্যেক"],["أُمَّةٍ","ummatin","nation","জাতির (আছে)"],["أَجَلٌۭ ۖ","ajalun","(is a fixed) term","এক নির্দিষ্ট সময়"],["فَإِذَا","fa-idhā","So when","অতঃপর যখন"],["جَآءَ","jāa","comes","আসবে"],["أَجَلُهُمْ","ajaluhum","their term","সময় তাদের (পূর্ণ হয়ে)"],["لَا","lā","(they can) not","না"],["يَسْتَأْخِرُونَ","yastakhirūna","seek to delay","তারা দেরি করতে পারবে"],["سَاعَةًۭ ۖ","sā‘atan","an hour","এক মুহুর্তও"],["وَلَا","walā","and not","আর না"],["يَسْتَقْدِمُونَ","yastaqdimūna","seek to advance (it)","আগে নিয়ে যেতে পারবে"]],"t":"وَلِكُلِّ أُ<g>مَّ</>ةٍ أَجَ<k>لٌۭ ۖ فَ</>إِذَا <o>جَآ</>ءَ أَجَلُهُمْ لَا يَسْتَأْخِرُونَ سَاعَ<d>ةًۭ ۖ وَ</>لَا يَسْتَ<q>قْ</>دِ<p>مُو</>نَ"},{"n":35,"w":[["يَـٰبَنِىٓ","yābanī","O Children","হে সন্তান"],["ءَادَمَ","ādama","(of) Adam","আদমের"],["إِمَّا","immā","If","যদি"],["يَأْتِيَنَّكُمْ","yatiyannakum","come to you","কাছে আসে তোমাদের"],["رُسُلٌۭ","rusulun","Messengers","রাসূলগণ"],["مِّنكُمْ","minkum","from you","মধ্য হতে তোমাদের"],["يَقُصُّونَ","yaquṣṣūna","relating","বর্ণনা করে"],["عَلَيْكُمْ","‘alaykum","to you","নিকট তোমাদের"],["ءَايَـٰتِى ۙ","āyātī","My Verses","আমার নিদর্শনাবলী"],["فَمَنِ","famani","then whoever","অতঃপর যে"],["ٱتَّقَىٰ","ittaqā","fears Allah","সংযত হবে"],["وَأَصْلَحَ","wa-aṣlaḥa","and reforms","ও সংশোধন করবে (নিজেকে)"],["فَلَا","falā","then no","তখন না"],["خَوْفٌ","khawfun","fear","ভয় (থাকবে)"],["عَلَيْهِمْ","‘alayhim","on them","উপর তাদের"],["وَلَا","walā","and not","আর না"],["هُمْ","hum","they","তারা"],["يَحْزَنُونَ","yaḥzanūna","will grieve","দুঃখিত হবে"]],"t":"<m>يَٰ</>بَ<o>نِىٓ</> ءَادَمَ إِ<g>مَّ</>ا يَأْتِيَ<g>نَّ</>كُمْ رُسُ<d>لٌۭ مِّ</><k>نكُ</>مْ يَقُصُّونَ عَلَيْكُمْ ءَا<m>يَٰ</>تِى ۙ فَمَنِ <h>ٱ</>تَّقَىٰ وَأَصْلَحَ فَلَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَ<p>نُو</>نَ"},{"n":36,"w":[["وَٱلَّذِينَ","wa-alladhīna","But those who","এবং যারা"],["كَذَّبُوا۟","kadhabū","deny","মিথ্যা সাব্যস্ত করবে"],["بِـَٔايَـٰتِنَا","biāyātinā","Our Verses","ব্যাপারে আয়াতগুলোর আমাদের"],["وَٱسْتَكْبَرُوا۟","wa-is'takbarū","and (are) arrogant","ও অহংকার করবে"],["عَنْهَآ","‘anhā","towards them","হতে তা"],["أُو۟لَـٰٓئِكَ","ulāika","those","ঐসব লোক"],["أَصْحَـٰبُ","aṣḥābu","(are the) companions","অধিবাসী (হবে)"],["ٱلنَّارِ ۖ","l-nāri","(of) the Fire","আগুনের"],["هُمْ","hum","they","তারা"],["فِيهَا","fīhā","in it","মধ্যে তার (থাকবে)"],["خَـٰلِدُونَ","khālidūna","will abide forever","চিরকাল"]],"t":"وَ<h>ٱ</>لَّذِينَ كَذَّبُو<s>ا۟</> بِـَٔا<m>يَٰ</>تِنَا وَ<h>ٱ</>سْتَكْبَرُو<s>ا۟</> عَنْ<o>هَآ</> أُ<s>و۟</><o>لَٰٓ</>ئِكَ أَصْ<m>حَٰ</>بُ <h>ٱ</><l>ل</><g>نَّ</>ارِ ۖ هُمْ فِيهَا <m>خَٰ</>لِ<p>دُو</>نَ"},{"n":37,"w":[["فَمَنْ","faman","Then who","অতঃপর কে"],["أَظْلَمُ","aẓlamu","(is) more unjust","অধিক সীমালঙ্ঘনকারী (হতে পারে)"],["مِمَّنِ","mimmani","than (one) who","(তার) চেয়ে যে"],["ٱفْتَرَىٰ","if'tarā","invented","রচনা করে"],["عَلَى","‘alā","against","সম্বন্ধে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["كَذِبًا","kadhiban","a lie","মিথ্যা"],["أَوْ","aw","or","বা"],["كَذَّبَ","kadhaba","denies","মিথ্যা সাব্যস্ত করে"],["بِـَٔايَـٰتِهِۦٓ ۚ","biāyātihi","His Verses","ব্যাপারে আয়াতগুলোর তাঁর"],["أُو۟لَـٰٓئِكَ","ulāika","Those ","ঐসব লোক"],["يَنَالُهُمْ","yanāluhum","will reach them","কাছে পৌঁছবে তাদের"],["نَصِيبُهُم","naṣībuhum","their portion","অংশ তাদের"],["مِّنَ","mina","from","হতে"],["ٱلْكِتَـٰبِ ۖ","l-kitābi","the Book","কিতাব (অর্থাৎ তকদির)"],["حَتَّىٰٓ","ḥattā","until","শেষ পর্যন্ত"],["إِذَا","idhā","when","যখন"],["جَآءَتْهُمْ","jāathum","comes to them","কাছে আসবে তাদের"],["رُسُلُنَا","rusulunā","Our messengers (Angels)","আমাদের ফেরেশতারা"],["يَتَوَفَّوْنَهُمْ","yatawaffawnahum","(to) take them in death","প্রাণ হরণ করতে তাদের"],["قَالُوٓا۟","qālū","they say","(ফেরেশতারা) বলবে"],["أَيْنَ","ayna","Where are","\"কোথায় (তারা)"],["مَا","mā","those (whom)","যাদের"],["كُنتُمْ","kuntum","you used to","তোমরা ছিলে"],["تَدْعُونَ","tad‘ūna","invoke","তোমরা ডাকতে"],["مِن","min","from","দিয়ে"],["دُونِ","dūni","besides","বাদ"],["ٱللَّهِ ۖ","l-lahi","Allah","আল্লাহকে\""],["قَالُوا۟","qālū","They say","(মুশরিকরা) বলবে"],["ضَلُّوا۟","ḍallū","They strayed","\"তারা লুকিয়ে গিয়েছে"],["عَنَّا","‘annā","from us","আমাদের থেকে"],["وَشَهِدُوا۟","washahidū","and they (will) testify","এবং তারা সাক্ষ্য দিবে"],["عَلَىٰٓ","‘alā","against","বিরুদ্ধে"],["أَنفُسِهِمْ","anfusihim","themselves","নিজেদের তাদের"],["أَنَّهُمْ","annahum","that they","যে তারা"],["كَانُوا۟","kānū","were","ছিলো"],["كَـٰفِرِينَ","kāfirīna","disbelievers","অবিশ্বাসী"]],"t":"فَمَنْ أَظْلَمُ مِ<g>مَّ</>نِ <h>ٱ</>فْتَرَىٰ عَلَى <h>ٱ</>للَّهِ كَذِبًا أَوْ كَذَّبَ بِـَٔا<m>يَٰ</>تِ<o>هِۦٓ ۚ</> أُ<s>و۟</><o>لَٰٓ</>ئِكَ يَنَالُهُمْ نَصِيبُ<y>هُم مِّ</>نَ <h>ٱ</>لْكِ<m>تَٰ</>بِ ۖ حَتَّ<o>ىٰٓ</> إِذَا <o>جَآ</>ءَتْهُمْ رُسُلُنَا يَتَوَفَّوْنَهُمْ قَا<o>لُوٓ</><s>ا۟</> أَيْنَ مَا كُ<k>نتُ</>مْ تَ<q>دْ</>عُونَ مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ ۖ قَالُو<s>ا۟</> ضَلُّو<s>ا۟</> عَ<g>نَّ</>ا وَشَهِدُو<s>ا۟</> عَلَ<o>ىٰٓ</> أَ<k>نفُ</>سِهِمْ أَ<g>نَّ</>هُمْ كَانُو<s>ا۟</> <m>كَٰ</>فِ<p>رِي</>نَ"},{"n":38,"w":[["قَالَ","qāla","He (will) say","(আল্লাহ) বলবেন"],["ٱدْخُلُوا۟","ud'khulū","Enter","\"তোমরা প্রবেশ করো"],["فِىٓ","fī","among","সাথে (অন্তর্ভুক্ত হয়ে)"],["أُمَمٍۢ","umamin","(the) nations","জাতিগুলোর"],["قَدْ","qad","(who)","নিশ্চয়ই"],["خَلَتْ","khalat","passed away","গত হয়েছে"],["مِن","min","from","থেকে"],["قَبْلِكُم","qablikum","before you","পূর্ব তোমাদের"],["مِّنَ","mina","of","মধ্য হতে"],["ٱلْجِنِّ","l-jini","the jinn","জিনদের"],["وَٱلْإِنسِ","wal-insi","and the men","ও মানুষের"],["فِى","fī","in","মধ্যে"],["ٱلنَّارِ ۖ","l-nāri","the Fire","আগুনের\""],["كُلَّمَا","kullamā","Every time","যখনই"],["دَخَلَتْ","dakhalat","entered","প্রবেশ করবে"],["أُمَّةٌۭ","ummatun","a nation","কোনো জাতি"],["لَّعَنَتْ","la‘anat","it cursed","অভিশাপ দিবে"],["أُخْتَهَا ۖ","ukh'tahā","its sister (nation)","বোনকে তার (অন্য দলকে)"],["حَتَّىٰٓ","ḥattā","until","এমনকি"],["إِذَا","idhā","when","যখন"],["ٱدَّارَكُوا۟","iddārakū","they had overtaken one another","তারা পেয়ে যাবে"],["فِيهَا","fīhā","in it","মধ্যে তার"],["جَمِيعًۭا","jamī‘an","all","সবাইকে"],["قَالَتْ","qālat","(will) say","বলবে"],["أُخْرَىٰهُمْ","ukh'rāhum","(the) last of them","পরবর্তীরা তাদের"],["لِأُولَىٰهُمْ","liūlāhum","about the first of them","সম্পর্কে পূর্ববর্তীদের তাদের"],["رَبَّنَا","rabbanā","Our Lord","\"হে আমাদের রব"],["هَـٰٓؤُلَآءِ","hāulāi","these","এরাই"],["أَضَلُّونَا","aḍallūnā","misled us","বিভ্রান্ত করেছিলো আমাদের"],["فَـَٔاتِهِمْ","faātihim","so give them","অতএব তাদের দিন"],["عَذَابًۭا","‘adhāban","punishment","শাস্তি"],["ضِعْفًۭا","ḍi‘'fan","double","দ্বিগুণ"],["مِّنَ","mina","of","দ্বারা"],["ٱلنَّارِ ۖ","l-nāri","the Fire","আগুনের\""],["قَالَ","qāla","He (will) say","(আল্লাহ) বলবেন"],["لِكُلٍّۢ","likullin","For each","\"জন্যে প্রত্যেকের(রয়েছে)"],["ضِعْفٌۭ","ḍi‘'fun","(is) a double","দ্বিগুণ (শাস্তি)"],["وَلَـٰكِن","walākin","[and] but","কিন্তু"],["لَّا","lā","not","না"],["تَعْلَمُونَ","ta‘lamūna","you know","তোমরা জানো\""]],"t":"قَالَ <h>ٱ</><q>دْ</>خُلُو<s>ا۟</> <o>فِىٓ</> أُمَ<k>مٍۢ قَ</><q>دْ</> خَلَتْ مِ<k>ن قَ</><q>بْ</>لِ<y>كُم مِّ</>نَ <h>ٱ</>لْجِ<g>نِّ</> وَ<h>ٱ</>لْإِ<k>نسِ</> فِى <h>ٱ</><l>ل</><g>نَّ</>ارِ ۖ كُلَّمَا دَخَلَتْ أُ<g>مَّ</><w>ةٌۭ لَّ</>عَنَتْ أُخْتَهَا ۖ حَتَّ<o>ىٰٓ</> إِذَا <h>ٱ</>دَّارَكُو<s>ا۟</> فِيهَا جَمِي<k>عًۭا قَ</>الَتْ أُخْرَ<m>ىٰ</>هُمْ لِأُولَ<m>ىٰ</>هُمْ رَبَّنَا <o>هَٰٓؤُلَآ</>ءِ أَضَلُّونَا فَـَٔاتِهِمْ عَذَا<k>بًۭا ضِ</>عْ<d>فًۭا مِّ</>نَ <h>ٱ</><l>ل</><g>نَّ</>ارِ ۖ قَالَ لِكُ<k>لٍّۢ ضِ</>عْ<d>فٌۭ وَ</><m>لَٰ</><w>كِن لَّ</>ا تَعْلَ<p>مُو</>نَ"},{"n":39,"w":[["وَقَالَتْ","waqālat","And (will) say","এবং বলবে"],["أُولَىٰهُمْ","ūlāhum","(the) first of them","পূর্ববর্তীরা তাদের"],["لِأُخْرَىٰهُمْ","li-ukh'rāhum","to (the) last of them","উদ্দেশ্যে পরবর্তীদের তাদের"],["فَمَا","famā","Then not","\"মূলতঃ না"],["كَانَ","kāna","is","ছিলো"],["لَكُمْ","lakum","for you","জন্যে তোমাদের"],["عَلَيْنَا","‘alaynā","upon us","উপর আমাদের"],["مِن","min","any","কোনো"],["فَضْلٍۢ","faḍlin","superiority","শ্রেষ্ঠত্ব"],["فَذُوقُوا۟","fadhūqū","so taste","অতএব তোমরা স্বাদ নাও"],["ٱلْعَذَابَ","l-‘adhāba","the punishment","শাস্তির"],["بِمَا","bimā","for what","এ কারণে যা"],["كُنتُمْ","kuntum","you used to","তোমরা ছিলে তোমরা অর্জন করতে"],["تَكْسِبُونَ","taksibūna","earn","\""]],"t":"وَقَالَتْ أُولَ<m>ىٰ</>هُمْ لِأُخْرَ<m>ىٰ</>هُمْ فَمَا كَانَ لَكُمْ عَلَيْنَا مِ<k>ن فَضْلٍۢ فَ</>ذُوقُو<s>ا۟</> <h>ٱ</>لْعَذَابَ بِمَا كُ<k>نتُ</>مْ تَكْسِ<p>بُو</>نَ"},{"n":40,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَذَّبُوا۟","kadhabū","denied","মিথ্যা মনে করে"],["بِـَٔايَـٰتِنَا","biāyātinā","Our Verses","সম্পর্কে আমাদের নিদর্শনাবলী"],["وَٱسْتَكْبَرُوا۟","wa-is'takbarū","and (were) arrogant","ও অহংকার করে"],["عَنْهَا","‘anhā","towards them","থেকে তা"],["لَا","lā","(will) not","না"],["تُفَتَّحُ","tufattaḥu","be opened","খোলা হবে"],["لَهُمْ","lahum","for them","জন্যে তাদের"],["أَبْوَٰبُ","abwābu","(the) doors","দরজাগুলো"],["ٱلسَّمَآءِ","l-samāi","(of) the heaven","আকাশের"],["وَلَا","walā","and not","আর না"],["يَدْخُلُونَ","yadkhulūna","they will enter","তারা প্রবেশ করবে"],["ٱلْجَنَّةَ","l-janata","Paradise","জান্নাতে"],["حَتَّىٰ","ḥattā","until","যে পর্যন্ত না"],["يَلِجَ","yalija","passes","প্রবেশ করবে"],["ٱلْجَمَلُ","l-jamalu","the camel","উট"],["فِى","fī","through","মধ্যে"],["سَمِّ","sammi","(the) eye","ছিদ্রের"],["ٱلْخِيَاطِ ۚ","l-khiyāṭi","(of) the needle","সূঁচের (অর্থাৎ তাদের জান্নাতে প্রবেশ অসম্ভব)"],["وَكَذَٰلِكَ","wakadhālika","And thus","এবং এভাবে"],["نَجْزِى","najzī","We recompense","প্রতিফল দিই আমরা"],["ٱلْمُجْرِمِينَ","l-muj'rimīna","the criminals","অপরাধীদেরকে"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ كَذَّبُو<s>ا۟</> بِـَٔا<m>يَٰ</>تِنَا وَ<h>ٱ</>سْتَكْبَرُو<s>ا۟</> عَنْهَا لَا تُفَتَّحُ لَهُمْ أَ<q>بْ</><m>وَٰ</>بُ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ وَلَا يَ<q>دْ</>خُلُونَ <h>ٱ</>لْجَ<g>نَّ</>ةَ حَتَّىٰ يَلِجَ <h>ٱ</>لْجَمَلُ فِى سَ<g>مِّ</> <h>ٱ</>لْخِيَاطِ ۚ وَكَ<m>ذَٰ</>لِكَ نَ<q>جْ</>زِى <h>ٱ</>لْمُ<q>جْ</>رِ<p>مِي</>نَ"},{"n":41,"w":[["لَهُم","lahum","For them","জন্যে তাদের (রয়েছে)"],["مِّن","min","of","তৈরি"],["جَهَنَّمَ","jahannama","(the) Hell","জাহান্নামের"],["مِهَادٌۭ","mihādun","(is) a bed","শয্যাসমূহ"],["وَمِن","wamin","and from","ও থেকে"],["فَوْقِهِمْ","fawqihim","over them","ও উপর তাদের(থাকবে)"],["غَوَاشٍۢ ۚ","ghawāshin","coverings","আচ্ছাদনসমূহ (আগুনের)"],["وَكَذَٰلِكَ","wakadhālika","And thus","এবং এভাবে"],["نَجْزِى","najzī","We recompense","প্রতিফল দিই আমরা"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","সীমালঙ্ঘনকারীদেরকে"]],"t":"لَ<y>هُم مِّ</><k>ن جَ</>هَ<g>نَّ</>مَ مِهَا<d>دٌۭ وَ</>مِ<k>ن فَ</>وْقِهِمْ غَوَا<d>شٍۢ ۚ وَ</>كَ<m>ذَٰ</>لِكَ نَ<q>جْ</>زِى <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":42,"w":[["وَٱلَّذِينَ","wa-alladhīna","But those who","এবং যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["وَعَمِلُوا۟","wa‘amilū","and do","ও কাজ করেছে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","[the] righteous deeds","সৎ"],["لَا","lā","not","না"],["نُكَلِّفُ","nukallifu","We burden","দায়িত্বভার দিই আমরা"],["نَفْسًا","nafsan","any soul","কোনো ব্যক্তিকে"],["إِلَّا","illā","except","এ ছাড়া"],["وُسْعَهَآ","wus'‘ahā","(to) its capacity","সাধ্যের তার"],["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব লোক"],["أَصْحَـٰبُ","aṣḥābu","(are the) companions","অধিবাসী"],["ٱلْجَنَّةِ ۖ","l-janati","(of) Paradise","জান্নাতের"],["هُمْ","hum","they","তারা"],["فِيهَا","fīhā","in it","মধ্যে তার"],["خَـٰلِدُونَ","khālidūna","(will) abide forever","চিরস্থায়ী হবে"]],"t":"وَ<h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ لَا نُكَلِّفُ نَفْسًا إِلَّا وُسْعَ<o>هَآ</> أُ<s>و۟</><o>لَٰٓ</>ئِكَ أَصْ<m>حَٰ</>بُ <h>ٱ</>لْجَ<g>نَّ</>ةِ ۖ هُمْ فِيهَا <m>خَٰ</>لِ<p>دُو</>نَ"},{"n":43,"w":[["وَنَزَعْنَا","wanaza‘nā","And We will remove","এবং দূর করে দিবো আমরা"],["مَا","mā","whatever","যা"],["فِى","fī","(is) in","মধ্যে (আছে)"],["صُدُورِهِم","ṣudūrihim","their breasts","অন্তরসমূহের তাদের"],["مِّنْ","min","of","সব ধরণের"],["غِلٍّۢ","ghillin","malice","ঈর্ষা"],["تَجْرِى","tajrī","Flows","প্রবাহিত হয়"],["مِن","min","from","থেকে"],["تَحْتِهِمُ","taḥtihimu","underneath them","নিচ তাদের"],["ٱلْأَنْهَـٰرُ ۖ","l-anhāru","the rivers","ঝর্ণাধারাগুলো"],["وَقَالُوا۟","waqālū","And they will say","ও তারা বলবে"],["ٱلْحَمْدُ","l-ḥamdu","All the praise","\"সব প্রশংসা"],["لِلَّهِ","lillahi","(is) for Allah","জন্যে আল্লাহরই"],["ٱلَّذِى","alladhī","the One Who","যিনি"],["هَدَىٰنَا","hadānā","guided us","আমাদের পথ দেখিয়েছিলেন"],["لِهَـٰذَا","lihādhā","to this","জন্যে এ"],["وَمَا","wamā","and not","এবং না"],["كُنَّا","kunnā","we were","আমরা ছিলাম"],["لِنَهْتَدِىَ","linahtadiya","to receive guidance","যে সৎপথ পেতাম আমরা"],["لَوْلَآ","lawlā","if not","যদি না"],["أَنْ","an","[that]","যে"],["هَدَىٰنَا","hadānā","(had) guided us","পথ দেখাতেন আমাদের"],["ٱللَّهُ ۖ","l-lahu","Allah","আল্লাহ"],["لَقَدْ","laqad","Certainly","নিশ্চয়ই"],["جَآءَتْ","jāat","came","এসেছিলো"],["رُسُلُ","rusulu","Messengers","রাসূলগণ"],["رَبِّنَا","rabbinā","(of) our Lord","আমাদের রবের"],["بِٱلْحَقِّ ۖ","bil-ḥaqi","with the truth","সহ প্রকৃত সত্য\""],["وَنُودُوٓا۟","wanūdū","And they will be addressed","এবং তাদের ডেকে বলা হবে"],["أَن","an","[that]","যে"],["تِلْكُمُ","til'kumu","This","\"এই সেই"],["ٱلْجَنَّةُ","l-janatu","(is) Paradise","জান্নাত"],["أُورِثْتُمُوهَا","ūrith'tumūhā","you have been made to inherit it","তোমাদেরকে উত্তরাধিকারী করা হয়েছে তা"],["بِمَا","bimā","for what","বিনিময়ে যা"],["كُنتُمْ","kuntum","you used to","তোমরা ছিলে"],["تَعْمَلُونَ","ta‘malūna","do","তোমরা কাজ করতে\""]],"t":"وَنَزَعْنَا مَا فِى صُدُورِ<y>هِم مِّ</>نْ غِ<k>لٍّۢ تَ</><q>جْ</>رِى مِ<k>ن تَ</>حْتِهِمُ <h>ٱ</>لْأَنْ<m>هَٰ</>رُ ۖ وَقَالُو<s>ا۟</> <h>ٱ</>لْحَمْدُ لِلَّهِ <h>ٱ</>لَّذِى هَدَ<m>ىٰ</>نَا لِ<m>هَٰ</>ذَا وَمَا كُ<g>نَّ</>ا لِنَهْتَدِىَ لَوْ<o>لَآ</> أَنْ هَدَ<m>ىٰ</>نَا <h>ٱ</>للَّهُ ۖ لَقَ<q>دْ</> <o>جَآ</>ءَتْ رُسُلُ رَبِّنَا بِ<h>ٱ</>لْحَقِّ ۖ وَنُو<o>دُوٓ</><s>ا۟</> أَ<k>ن تِ</>لْكُمُ <h>ٱ</>لْجَ<g>نَّ</>ةُ أُورِثْتُمُوهَا بِمَا كُ<k>نتُ</>مْ تَعْمَ<p>لُو</>نَ"},{"n":44,"w":[["وَنَادَىٰٓ","wanādā","And will call out","এবং ডেকে বলবে"],["أَصْحَـٰبُ","aṣḥābu","(the) companions","অধিবাসীরা"],["ٱلْجَنَّةِ","l-janati","(of) Paradise","জান্নাতের"],["أَصْحَـٰبَ","aṣḥāba","(to the) companions","অধিবাসীদেরকে"],["ٱلنَّارِ","l-nāri","(of) the Fire","আগুনের"],["أَن","an","that","যে"],["قَدْ","qad","Indeed","\"নিশ্চয়ই"],["وَجَدْنَا","wajadnā","we found","আমরা পেয়েছি"],["مَا","mā","what","যা"],["وَعَدَنَا","wa‘adanā","(had) promised us","প্রতিশ্রুতি দিয়েছিলেন আমাদের"],["رَبُّنَا","rabbunā","our Lord","রব আমাদের"],["حَقًّۭا","ḥaqqan","true","সত্য হিসেবে"],["فَهَلْ","fahal","So have","কিন্তু কি"],["وَجَدتُّم","wajadttum","you found","তোমরা পেয়েছো"],["مَّا","mā","what","যা"],["وَعَدَ","wa‘ada","(was) promised","প্রতিশ্রুতি দিয়েছিলেন"],["رَبُّكُمْ","rabbukum","(by) your Lord","রব তোমাদের"],["حَقًّۭا ۖ","ḥaqqan","(to be) true","সত্য হিসেবে\""],["قَالُوا۟","qālū","They will say","তারা বলবে"],["نَعَمْ ۚ","na‘am","Yes","\"হ্যাঁ\""],["فَأَذَّنَ","fa-adhana","Then will announce","অতঃপর ঘোষণা দেবে"],["مُؤَذِّنٌۢ","mu-adhinun","an announcer","এক ঘোষণাকারী"],["بَيْنَهُمْ","baynahum","among them","মাঝে তাদের"],["أَن","an","[that]","যে"],["لَّعْنَةُ","la‘natu","(The) curse","\"অভিশাপ"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["عَلَى","‘alā","(is) on","উপর"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","সীমালঙ্ঘনকারীদের"]],"t":"وَنَادَ<o>ىٰٓ</> أَصْ<m>حَٰ</>بُ <h>ٱ</>لْجَ<g>نَّ</>ةِ أَصْ<m>حَٰ</>بَ <h>ٱ</><l>ل</><g>نَّ</>ارِ أَ<k>ن قَ</><q>دْ</> وَجَ<q>دْ</>نَا مَا وَعَدَنَا رَبُّنَا حَ<k>قًّۭا فَ</>هَلْ وَجَ<j>د</><y>تُّم مَّ</>ا وَعَدَ رَبُّكُمْ حَ<k>قًّۭا ۖ قَ</>الُو<s>ا۟</> نَعَمْ ۚ فَأَذَّنَ مُؤَذِّ<i>نٌۢ بَ</>يْنَهُمْ <w>أَن لَّ</>عْنَةُ <h>ٱ</>للَّهِ عَلَى <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":45,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["يَصُدُّونَ","yaṣuddūna","hinder","(মানুষকে) বাধা দিতো"],["عَن","‘an","from","হতে"],["سَبِيلِ","sabīli","(the) way","পথ"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَيَبْغُونَهَا","wayabghūnahā","and seek in it","ও তারা অনুসন্ধান করতো তাতে"],["عِوَجًۭا","‘iwajan","crookedness","বক্রতা"],["وَهُم","wahum","while they (are)","আর তারা (ছিলো)"],["بِٱلْـَٔاخِرَةِ","bil-ākhirati","concerning the Hereafter","উপর আখিরাতের"],["كَـٰفِرُونَ","kāfirūna","disbelievers","অবিশ্বাসী\""]],"t":"ٱلَّذِينَ يَصُدُّونَ عَ<k>ن سَ</>بِيلِ <h>ٱ</>للَّهِ وَيَ<q>بْ</>غُونَهَا عِوَ<d>جًۭا وَ</><f>هُم بِ</><h>ٱ</>لْءَاخِرَةِ <m>كَٰ</>فِ<p>رُو</>نَ"},{"n":46,"w":[["وَبَيْنَهُمَا","wabaynahumā","And between them","এবং মাঝে উভয়ের"],["حِجَابٌۭ ۚ","ḥijābun","(will be) a partition","পর্দা"],["وَعَلَى","wa‘alā","and on","এবং উপর (থাকবে)"],["ٱلْأَعْرَافِ","l-a‘rāfi","the heights","আ'রাফের"],["رِجَالٌۭ","rijālun","(will be) men","কিছু লোক"],["يَعْرِفُونَ","ya‘rifūna","recognizing","তারা চিনবে"],["كُلًّۢا","kullan","all","প্রত্যেককে"],["بِسِيمَىٰهُمْ ۚ","bisīmāhum","by their marks","মাধ্যমে চিহ্নগুলো তাদের"],["وَنَادَوْا۟","wanādaw","And they will call out","এবং তারা ডেকে বলবে"],["أَصْحَـٰبَ","aṣḥāba","(to the) companions","অধিবাসীদেরকে"],["ٱلْجَنَّةِ","l-janati","(of) Paradise","জান্নাতের"],["أَن","an","that","যে"],["سَلَـٰمٌ","salāmun","Peace","\"শান্তি"],["عَلَيْكُمْ ۚ","‘alaykum","(be) upon you","উপর তোমাদের (বর্ষিত হোক)\""],["لَمْ","lam","Not","নি"],["يَدْخُلُوهَا","yadkhulūhā","they have entered it","তাতে প্রবেশ করেন (তারা এখনও)"],["وَهُمْ","wahum","but they","কিন্তু তারা"],["يَطْمَعُونَ","yaṭma‘ūna","hope","তারা আশা করে"]],"t":"وَبَيْنَهُمَا حِجَا<d>بٌۭ ۚ وَ</>عَلَى <h>ٱ</>لْأَعْرَافِ رِجَا<d>لٌۭ يَ</>عْرِفُونَ كُلًّۢا<i> بِ</>سِيمَ<m>ىٰ</>هُمْ ۚ وَنَادَوْ<s>ا۟</> أَصْ<m>حَٰ</>بَ <h>ٱ</>لْجَ<g>نَّ</>ةِ أَ<k>ن سَ</><m>لَٰ</>مٌ عَلَيْكُمْ ۚ لَمْ يَ<q>دْ</>خُلُوهَا وَهُمْ يَ<q>طْ</>مَ<p>عُو</>نَ"},{"n":47,"w":[["۞ وَإِذَا","wa-idhā","And when","এবং যখন"],["صُرِفَتْ","ṣurifat","are turned","ফিরানো হবে"],["أَبْصَـٰرُهُمْ","abṣāruhum","their eyes","দৃষ্টিগুলো তাদের"],["تِلْقَآءَ","til'qāa","towards","দিকে"],["أَصْحَـٰبِ","aṣḥābi","(the) companions","অধিবাসীদের"],["ٱلنَّارِ","l-nāri","(of) the Fire","(জাহান্নামের) আগুনের"],["قَالُوا۟","qālū","they (will) say","তারা বলবে"],["رَبَّنَا","rabbanā","Our Lord","\"হে আমাদের রব"],["لَا","lā","(Do) not","না"],["تَجْعَلْنَا","taj‘alnā","place us","আমাদের করো"],["مَعَ","ma‘a","with","সাথে"],["ٱلْقَوْمِ","l-qawmi","the people ","(ঐসব) সম্প্রদায়ের"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","(যারা) সীমালঙ্ঘনকারী\""]],"t":"۞ وَإِذَا صُرِفَتْ أَ<q>بْ</><m>صَٰ</>رُهُمْ تِلْ<o>قَآ</>ءَ أَصْ<m>حَٰ</>بِ <h>ٱ</><l>ل</><g>نَّ</>ارِ قَالُو<s>ا۟</> رَبَّنَا لَا تَ<q>جْ</>عَلْنَا مَعَ <h>ٱ</>لْقَوْمِ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":48,"w":[["وَنَادَىٰٓ","wanādā","And (will) call out","এবং ডাকবে"],["أَصْحَـٰبُ","aṣḥābu","(the) companions","অধিবাসীরা"],["ٱلْأَعْرَافِ","l-a‘rāfi","(of) the heights","আ'রাফের"],["رِجَالًۭا","rijālan","(to) men","(দোযখের কিছু) লোকদেরকে"],["يَعْرِفُونَهُم","ya‘rifūnahum","whom they recognize","তারা চিনবে তাদের"],["بِسِيمَىٰهُمْ","bisīmāhum","by their marks","মাধ্যমে চিহ্নগুলো তাদের"],["قَالُوا۟","qālū","saying","তারা বলবে"],["مَآ","mā","Not","\"না"],["أَغْنَىٰ","aghnā","(has) availed","কাজে আসল"],["عَنكُمْ","‘ankum","[to] you","জন্যে তোমাদের"],["جَمْعُكُمْ","jam‘ukum","your gathering","দলবল তোমাদের"],["وَمَا","wamā","and what","ও যা (নিয়ে)"],["كُنتُمْ","kuntum","you were","তোমরা ছিলে"],["تَسْتَكْبِرُونَ","tastakbirūna","arrogant (about)","তোমরা ঔদ্ধত্য প্রকাশ করতে\""]],"t":"وَنَادَ<o>ىٰٓ</> أَصْ<m>حَٰ</>بُ <h>ٱ</>لْأَعْرَافِ 