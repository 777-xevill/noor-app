وَجَعَلُو<s>ا۟</> لِلَّهِ أَ<k>ندَ</>ا<w>دًۭا لِّ</>يُضِلُّو<s>ا۟</> عَ<k>ن سَ</>بِيلِ<m>هِۦ</> ۗ قُلْ تَمَتَّعُو<s>ا۟</> فَإِ<g>نَّ</> مَصِيرَكُمْ إِلَى <h>ٱ</><l>ل</><g>نَّ</><p>ا</>رِ"},{"n":31,"w":[["قُل","qul","Say","বলো (হে নাবী)"],["لِّعِبَادِىَ","li‘ibādiya","to My slaves","আমার দাসদেরকে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["يُقِيمُوا۟","yuqīmū","(to) establish","তারা যেন প্রতিষ্ঠা করে"],["ٱلصَّلَوٰةَ","l-ṣalata","the prayers","সালাত"],["وَيُنفِقُوا۟","wayunfiqū","and (to) spend","ও তারা ব্যয় করে"],["مِمَّا","mimmā","from what","তা হ'তে যা"],["رَزَقْنَـٰهُمْ","razaqnāhum","We have provided them","আমরা জীবিকা দিয়েছি তাদের"],["سِرًّۭا","sirran","secretly","গোপনে"],["وَعَلَانِيَةًۭ","wa‘alāniyatan","and publicly","ও প্রকাশ্যে"],["مِّن","min","before","থেকেই"],["قَبْلِ","qabli","before","পূর্ব"],["أَن","an","[that]","যে"],["يَأْتِىَ","yatiya","comes","আসবে"],["يَوْمٌۭ","yawmun","a Day","সেদিন"],["لَّا","lā","not","না"],["بَيْعٌۭ","bay‘un","any trade","কেনা-বেচা হবে"],["فِيهِ","fīhi","in it","তার মধ্যে"],["وَلَا","walā","and not","আর না"],["خِلَـٰلٌ","khilālun","any friendship","বন্ধুত্ব (কাজে আসবে)"]],"t":"قُل لِّعِبَادِىَ <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> يُقِيمُو<s>ا۟</> <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةَ وَيُ<k>نفِ</>قُو<s>ا۟</> مِ<g>مَّ</>ا رَزَ<q>قْ</><m>نَٰ</>هُمْ سِ<d>رًّۭا وَ</>عَلَانِيَ<d>ةًۭ مِّ</><k>ن قَ</><q>بْ</>لِ <d>أَن يَ</>أْتِىَ يَوْ<w>مٌۭ لَّ</>ا بَيْ<k>عٌۭ فِ</>يهِ وَلَا خِ<p>لَٰ</>لٌ"},{"n":32,"w":[["ٱللَّهُ","al-lahu","Allah","(তিনিই) আল্লাহ"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["خَلَقَ","khalaqa","created","সৃষ্টি করেছেন"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশ"],["وَٱلْأَرْضَ","wal-arḍa","and the earth","ও পৃথিবী"],["وَأَنزَلَ","wa-anzala","and sent down","এবং বর্ষণ করেছেন"],["مِنَ","mina","from","থেকে"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশ"],["مَآءًۭ","māan","water","পানি"],["فَأَخْرَجَ","fa-akhraja","then brought forth","অতঃপর বের করেছেন"],["بِهِۦ","bihi","from it","দিয়ে তা"],["مِنَ","mina","of","(বিভিন্ন) ধরণের"],["ٱلثَّمَرَٰتِ","l-thamarāti","the fruits","ফল-মূলসমূহ"],["رِزْقًۭا","riz'qan","(as) a provision","জীবিকার জন্যে"],["لَّكُمْ ۖ","lakum","for you","তোমাদের"],["وَسَخَّرَ","wasakhara","and subjected","এবং অধীন করে দিয়েছেন"],["لَكُمُ","lakumu","for you","জন্যে তোমাদের"],["ٱلْفُلْكَ","l-ful'ka","the ships","নৌযান"],["لِتَجْرِىَ","litajriya","so that they may sail","যেন চলাচল করে"],["فِى","fī","in","মধ্যে"],["ٱلْبَحْرِ","l-baḥri","the sea","সাগরের"],["بِأَمْرِهِۦ ۖ","bi-amrihi","by His command","নির্দেশক্রমে তার"],["وَسَخَّرَ","wasakhara","and subjected","এবং অধীন করেছেন"],["لَكُمُ","lakumu","for you","জন্যে তোমাদের"],["ٱلْأَنْهَـٰرَ","l-anhāra","the rivers","নদীসমূহকে"]],"t":"ٱللَّهُ <h>ٱ</>لَّذِى خَلَقَ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضَ وَأَ<k>نزَ</>لَ مِنَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ <o>مَآ</><k>ءًۭ فَ</>أَخْرَجَ بِ<m>هِۦ</> مِنَ <h>ٱ</><l>ل</>ثَّمَ<m>رَٰ</>تِ رِزْ<w>قًۭا لَّ</>كُمْ ۖ وَسَخَّرَ لَكُمُ <h>ٱ</>لْفُلْكَ لِتَ<q>جْ</>رِىَ فِى <h>ٱ</>لْبَحْرِ بِأَمْرِ<m>هِۦ</> ۖ وَسَخَّرَ لَكُمُ <h>ٱ</>لْأَنْ<p>هَٰ</>رَ"},{"n":33,"w":[["وَسَخَّرَ","wasakhara","And He subjected","এবং অধীন করেছেন"],["لَكُمُ","lakumu","for you","জন্যে তোমাদের"],["ٱلشَّمْسَ","l-shamsa","the sun","সূর্যকে"],["وَٱلْقَمَرَ","wal-qamara","and the moon","ও চাঁদকে"],["دَآئِبَيْنِ ۖ","dāibayni","both constantly pursuing their courses","যারা প্রতিনিয়ত একই নিয়মের অনুবর্তী"],["وَسَخَّرَ","wasakhara","and subjected","এবং অধীন করেছেন"],["لَكُمُ","lakumu","for you","জন্যে তোমাদের"],["ٱلَّيْلَ","al-layla","the night","রাতকে"],["وَٱلنَّهَارَ","wal-nahāra","and the day","ও দিনকে"]],"t":"وَسَخَّرَ لَكُمُ <h>ٱ</><l>ل</>شَّمْسَ وَ<h>ٱ</>لْقَمَرَ <o>دَآ</>ئِبَيْنِ ۖ وَسَخَّرَ لَكُمُ <h>ٱ</>لَّيْلَ وَ<h>ٱ</><l>ل</><g>نَّ</><p>هَا</>رَ"},{"n":34,"w":[["وَءَاتَىٰكُم","waātākum","And He gave you","এবং তোমাদের দিয়েছেন"],["مِّن","min","of","থেকে"],["كُلِّ","kulli","all","সবকিছু"],["مَا","mā","what","যা"],["سَأَلْتُمُوهُ ۚ","sa-altumūhu","you asked of Him","তাঁর কাছে তোমরা চেয়েছো"],["وَإِن","wa-in","And if","এবং যদি"],["تَعُدُّوا۟","ta‘uddū","you count","তোমরা গণনা করো"],["نِعْمَتَ","ni‘'mata","(the) Favor of Allah","অনুগ্রহসমূহ"],["ٱللَّهِ","l-lahi","(the) Favor of Allah","আল্লাহর"],["لَا","lā","not","না"],["تُحْصُوهَآ ۗ","tuḥ'ṣūhā","you will (be able to) count them","তার তোমরা সংখ্যা নির্ণয় করতে পারবে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلْإِنسَـٰنَ","l-insāna","the mankind","মানুষ"],["لَظَلُومٌۭ","laẓalūmun","(is) surely unjust","অবশ্যই অতিমাত্রায় সীমালঙ্ঘনকারী"],["كَفَّارٌۭ","kaffārun","(and) ungrateful","বড় অকৃতজ্ঞ"]],"t":"وَءَاتَ<m>ىٰ</><y>كُم مِّ</><k>ن كُ</>لِّ مَا سَأَلْتُمُوهُ ۚ وَإِ<k>ن تَ</>عُدُّو<s>ا۟</> نِعْمَتَ <h>ٱ</>للَّهِ لَا تُحْصُو<o>هَآ ۗ</> إِ<g>نَّ</> <h>ٱ</>لْإِ<k>نسَٰ</>نَ لَظَلُو<k>مٌۭ كَ</><p>فَّا</>رٌۭ"},{"n":35,"w":[["وَإِذْ","wa-idh","And when","এবং (স্মরণ করো) যখন"],["قَالَ","qāla","said","বলেছিলো"],["إِبْرَٰهِيمُ","ib'rāhīmu","Ibrahim","ইবরাহীম"],["رَبِّ","rabbi","My Lord","\"হে আমার রব"],["ٱجْعَلْ","ij'‘al","Make","বানাও"],["هَـٰذَا","hādhā","this","এই"],["ٱلْبَلَدَ","l-balada","city","নগরীকে"],["ءَامِنًۭا","āminan","safe","নিরাপদ"],["وَٱجْنُبْنِى","wa-uj'nub'nī","and keep me away","এবং আমাকে দূরে রাখো"],["وَبَنِىَّ","wabaniyya","and my sons","ও আমার সন্তানদেরকে"],["أَن","an","that","(এ হ'তে) যে"],["نَّعْبُدَ","na‘buda","we worship","আমরা উপাসনা করি"],["ٱلْأَصْنَامَ","l-aṣnāma","the idols","মূর্তিদেরকে"]],"t":"وَإِذْ قَالَ إِ<q>بْ</><m>رَٰ</>هِيمُ رَبِّ <h>ٱ</><q>جْ</>عَلْ <m>هَٰ</>ذَا <h>ٱ</>لْبَلَدَ ءَامِ<d>نًۭا وَ</><h>ٱ</><q>جْنُبْ</>نِى وَبَنِىَّ <d>أَن نَّ</>عْبُدَ <h>ٱ</>لْأَصْ<p>نَا</>مَ"},{"n":36,"w":[["رَبِّ","rabbi","My Lord","হে আমার রব"],["إِنَّهُنَّ","innahunna","Indeed, they","নিশ্চয়ই তারা"],["أَضْلَلْنَ","aḍlalna","have led astray","বিভ্রান্ত করেছে"],["كَثِيرًۭا","kathīran","many","অনেককে"],["مِّنَ","mina","among","থেকে"],["ٱلنَّاسِ ۖ","l-nāsi","the mankind","মানুষের"],["فَمَن","faman","So whoever","সুতরাং যে"],["تَبِعَنِى","tabi‘anī","follows me","আমার অনুসরন করবে"],["فَإِنَّهُۥ","fa-innahu","then indeed, he","অতঃপর নিশ্চয়ই সে"],["مِنِّى ۖ","minnī","(is) of me","আমার অন্তর্ভুক্ত"],["وَمَنْ","waman","and whoever","এবং যে"],["عَصَانِى","‘aṣānī","disobeys me","আমার অবাধ্য হবে"],["فَإِنَّكَ","fa-innaka","then indeed, You","অতঃপর নিশ্চয়ই তুমি"],["غَفُورٌۭ","ghafūrun","(are) Oft-Forgiving","ক্ষমাশীল"],["رَّحِيمٌۭ","raḥīmun","Most Merciful","পরম দয়ালু"]],"t":"رَبِّ إِ<g>نَّهُنَّ</> أَضْلَلْنَ كَثِي<d>رًۭا مِّ</>نَ <h>ٱ</><l>ل</><g>نَّ</>اسِ ۖ فَمَ<k>ن تَ</>بِعَنِى فَإِ<g>نَّ</>هُ<m>ۥ</> مِ<g>نِّ</>ى ۖ وَمَنْ عَصَانِى فَإِ<g>نَّ</>كَ غَفُو<w>رٌۭ رَّ</><p>حِي</>مٌۭ"},{"n":37,"w":[["رَّبَّنَآ","rabbanā","Our Lord","হে আমাদের রব"],["إِنِّىٓ","innī","Indeed, I","নিশ্চয়ই আমি"],["أَسْكَنتُ","askantu","[I] have settled","বসবাস করিয়েছি"],["مِن","min","(some) of","থেকে (কতককে)"],["ذُرِّيَّتِى","dhurriyyatī","my offsprings","আমার বংশধরদের"],["بِوَادٍ","biwādin","in a valley","উপত্যকায়"],["غَيْرِ","ghayri","not","নয়"],["ذِى","dhī","with","যোগ্য"],["زَرْعٍ","zar‘in","cultivation","চাষাবাদ"],["عِندَ","‘inda","near","কাছে"],["بَيْتِكَ","baytika","Your Sacred House","তোমার ঘরের"],["ٱلْمُحَرَّمِ","l-muḥarami","Your Sacred House","(যা) মহান সম্মানিত"],["رَبَّنَا","rabbanā","our Lord","হে আমাদের রব"],["لِيُقِيمُوا۟","liyuqīmū","That they may establish","যেন তারা প্রতিষ্ঠা করে"],["ٱلصَّلَوٰةَ","l-ṣalata","the prayers","সালাত"],["فَٱجْعَلْ","fa-ij'‘al","So make","অতএব বানাও"],["أَفْـِٔدَةًۭ","afidatan","hearts","অন্তরসমূহ"],["مِّنَ","mina","of","কিছু"],["ٱلنَّاسِ","l-nāsi","the men","মানুষের"],["تَهْوِىٓ","tahwī","incline","অনুরক্ত হয় (যেন)"],["إِلَيْهِمْ","ilayhim","towards them","দিকে তাদের"],["وَٱرْزُقْهُم","wa-ur'zuq'hum","and provide them","এবং তাদেরকে জীবিকা দাও"],["مِّنَ","mina","with","থেকে"],["ٱلثَّمَرَٰتِ","l-thamarāti","the fruits","ফল-মূলসমূহ"],["لَعَلَّهُمْ","la‘allahum","so that they may","তারা যাতে"],["يَشْكُرُونَ","yashkurūna","be grateful","কৃতজ্ঞতা প্রকাশ করে"]],"t":"رَّبَّ<o>نَآ</> إِ<g>نِّ</><o>ىٓ</> أَسْكَ<k>نتُ</> مِ<k>ن ذُ</>رِّيَّتِى بِوَادٍ غَيْرِ ذِى زَرْعٍ عِ<k>ندَ</> بَيْتِكَ <h>ٱ</>لْمُحَرَّمِ رَبَّنَا لِيُقِيمُو<s>ا۟</> <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةَ فَ<h>ٱ</><q>جْ</>عَلْ أَفْـِٔدَ<d>ةًۭ مِّ</>نَ <h>ٱ</><l>ل</><g>نَّ</>اسِ تَهْ<o>وِىٓ</> إِلَيْهِمْ وَ<h>ٱ</>رْزُ<q>قْ</><y>هُم مِّ</>نَ <h>ٱ</><l>ل</>ثَّمَ<m>رَٰ</>تِ لَعَلَّهُمْ يَشْكُ<p>رُو</>نَ"},{"n":38,"w":[["رَبَّنَآ","rabbanā","Our Lord","হে আমাদের রব"],["إِنَّكَ","innaka","Indeed, You","নিশ্চয়ই তুমি"],["تَعْلَمُ","ta‘lamu","You know","জানো"],["مَا","mā","what","যা"],["نُخْفِى","nukh'fī","we conceal","আমরা গোপন করি"],["وَمَا","wamā","and what","ও যা"],["نُعْلِنُ ۗ","nu‘'linu","we proclaim","আমরা প্রকাশ করি"],["وَمَا","wamā","And not","এবং না"],["يَخْفَىٰ","yakhfā","(is) hidden","গোপন থাকে"],["عَلَى","‘alā","from","কাছে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["مِن","min","any","কোনো"],["شَىْءٍۢ","shayin","thing","কিছুই"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["وَلَا","walā","and not","আর না"],["فِى","fī","in","মধ্যে"],["ٱلسَّمَآءِ","l-samāi","the heaven","আকাশের"]],"t":"رَبَّ<o>نَآ</> إِ<g>نَّ</>كَ تَعْلَمُ مَا نُخْفِى وَمَا نُعْلِنُ ۗ وَمَا يَخْفَىٰ عَلَى <h>ٱ</>للَّهِ مِ<k>ن شَىْءٍۢ فِ</>ى <h>ٱ</>لْأَرْضِ وَلَا فِى <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ"},{"n":39,"w":[["ٱلْحَمْدُ","al-ḥamdu","All the Praise","প্রশংসা মাত্রই"],["لِلَّهِ","lillahi","(is) for Allah","জন্যে আল্লাহর"],["ٱلَّذِى","alladhī","the One Who","যিনি"],["وَهَبَ","wahaba","has granted","দান করেছেন"],["لِى","lī","me","আমাকে"],["عَلَى","‘alā","in","অবস্হায়"],["ٱلْكِبَرِ","l-kibari","the old age","বার্ধক্যের"],["إِسْمَـٰعِيلَ","is'mā‘īla","Ishmael","ইসমাঈলকে"],["وَإِسْحَـٰقَ ۚ","wa-is'ḥāqa","and Isaac","ও ইসহাককে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["رَبِّى","rabbī","my Lord","আমার রব"],["لَسَمِيعُ","lasamī‘u","(is) All-Hearer","অবশ্যই শ্রবণকারী"],["ٱلدُّعَآءِ","l-du‘āi","(of) the prayer","দোয়ার"]],"t":"ٱلْحَمْدُ لِلَّهِ <h>ٱ</>لَّذِى وَهَبَ لِى عَلَى <h>ٱ</>لْكِبَرِ إِسْ<m>مَٰ</>عِيلَ وَإِسْ<m>حَٰ</>قَ ۚ إِ<g>نَّ</> رَبِّى لَسَمِيعُ <h>ٱ</><l>ل</>دُّ<o>عَآ</>ءِ"},{"n":40,"w":[["رَبِّ","rabbi","My Lord","হে আমার রব"],["ٱجْعَلْنِى","ij'‘alnī","Make me","আমাকে বানাও"],["مُقِيمَ","muqīma","an establisher","প্রতিষ্ঠাকারী"],["ٱلصَّلَوٰةِ","l-ṣalati","(of) the prayer","সালাত"],["وَمِن","wamin","and from","এবং থেকে"],["ذُرِّيَّتِى ۚ","dhurriyyatī","my offsprings","আমার বংশধরদের"],["رَبَّنَا","rabbanā","Our Lord","হে আমাদের রব"],["وَتَقَبَّلْ","wataqabbal","and accept","এবং তুমি কবুল করো"],["دُعَآءِ","du‘āi","my prayer","আমার দোয়া"]],"t":"رَبِّ <h>ٱ</><q>جْ</>عَلْنِى مُقِيمَ <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةِ وَمِ<k>ن ذُ</>رِّيَّتِى ۚ رَبَّنَا وَتَقَبَّلْ دُ<o>عَآ</>ءِ"},{"n":41,"w":[["رَبَّنَا","rabbanā","Our Lord","হে আমাদের রব"],["ٱغْفِرْ","igh'fir","Forgive","মাফ করো"],["لِى","lī","me","আমাকে"],["وَلِوَٰلِدَىَّ","waliwālidayya","and my parents","ও আমার পিতামাতাকে"],["وَلِلْمُؤْمِنِينَ","walil'mu'minīna","and the believers","ও মু'মিনদেরকে"],["يَوْمَ","yawma","(on) the Day","যে দিনে"],["يَقُومُ","yaqūmu","will (be) established","প্রতিষ্ঠিত হবে"],["ٱلْحِسَابُ","l-ḥisābu","the account","হিসেব\""]],"t":"رَبَّنَا <h>ٱ</>غْفِرْ لِى وَلِ<m>وَٰ</>لِدَىَّ وَلِلْمُؤْمِنِينَ يَوْمَ يَقُومُ <h>ٱ</>لْحِ<p>سَا</><q>بُ</>"},{"n":42,"w":[["وَلَا","walā","And (do) not","এবং না"],["تَحْسَبَنَّ","taḥsabanna","think","কখনই তুমি মনে করো (যেন)"],["ٱللَّهَ","l-laha","(that) Allah","আল্লাহকে"],["غَـٰفِلًا","ghāfilan","(is) unaware","উদাসীন"],["عَمَّا","‘ammā","of what","তা হ'তে যা"],["يَعْمَلُ","ya‘malu","do","করছে"],["ٱلظَّـٰلِمُونَ ۚ","l-ẓālimūna","the wrongdoers","সীমালঙ্ঘনকারীরা"],["إِنَّمَا","innamā","Only","শুধুমাত্র"],["يُؤَخِّرُهُمْ","yu-akhiruhum","He gives them respite","তিনি অবকাশ দিচ্ছেন তাদেরকে"],["لِيَوْمٍۢ","liyawmin","to a Day","পর্যন্ত দিন"],["تَشْخَصُ","tashkhaṣu","will stare","স্থির হবে"],["فِيهِ","fīhi","in it","তার মধ্যে"],["ٱلْأَبْصَـٰرُ","l-abṣāru","the eyes","দৃষ্টিসমূহ"]],"t":"وَلَا تَحْسَبَ<g>نَّ</> <h>ٱ</>للَّهَ <m>غَٰ</>فِلًا عَ<g>مَّ</>ا يَعْمَلُ <h>ٱ</><l>ل</><m>ظَّٰ</>لِمُونَ ۚ إِ<g>نَّ</>مَا يُؤَخِّرُهُمْ لِيَوْ<k>مٍۢ تَ</>شْخَصُ فِيهِ <h>ٱ</>لْأَ<q>بْ</><p>صَٰ</>رُ"},{"n":43,"w":[["مُهْطِعِينَ","muh'ṭi‘īna","Racing ahead","ছুটোছুটি করবে"],["مُقْنِعِى","muq'ni‘ī","raised up","উত্তোলনকারী হয়ে"],["رُءُوسِهِمْ","ruūsihim","their heads","তাদের মাথাগুলো"],["لَا","lā","not","না"],["يَرْتَدُّ","yartaddu","returning","ফিরবে"],["إِلَيْهِمْ","ilayhim","towards them","তাদের দিকে"],["طَرْفُهُمْ ۖ","ṭarfuhum","their gaze","তাদের পলক"],["وَأَفْـِٔدَتُهُمْ","wa-afidatuhum","and their hearts","এবং তাদের অন্তরগুলো (হবে)"],["هَوَآءٌۭ","hawāon","(are) empty","(আশা) শূন্য"]],"t":"مُهْطِعِينَ مُ<q>قْ</>نِعِى رُءُوسِهِمْ لَا يَرْتَدُّ إِلَيْهِمْ طَرْفُهُمْ ۖ وَأَفْـِٔدَتُهُمْ هَ<o>وَآ</>ءٌۭ"},{"n":44,"w":[["وَأَنذِرِ","wa-andhiri","And warn","এবং সতর্ক করো"],["ٱلنَّاسَ","l-nāsa","the mankind","মানুষকে"],["يَوْمَ","yawma","(of) a Day","সেদিনের"],["يَأْتِيهِمُ","yatīhimu","(when) will come to them","তাদের আসবে"],["ٱلْعَذَابُ","l-‘adhābu","the punishment","শাস্তি"],["فَيَقُولُ","fayaqūlu","then will say","তখন বলবে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ظَلَمُوا۟","ẓalamū","did wrong","সীমালঙ্ঘন করেছিলো"],["رَبَّنَآ","rabbanā","Our Lord","\"হে আমাদের রব"],["أَخِّرْنَآ","akhir'nā","Respite us","আমাদের অবকাশ দিন"],["إِلَىٰٓ","ilā","for","পর্যন্ত"],["أَجَلٍۢ","ajalin","a term","(কিছু) কাল"],["قَرِيبٍۢ","qarībin","short","নিকটবর্তী"],["نُّجِبْ","nujib","we will answer","আমরা সাড়া দিবো"],["دَعْوَتَكَ","da‘wataka","Your call","তোমার ডাকে"],["وَنَتَّبِعِ","wanattabi‘i","and we will follow","ও আমরা অনুসরণ করবো"],["ٱلرُّسُلَ ۗ","l-rusula","the Messengers","রাসূলদের\""],["أَوَلَمْ","awalam","Had not","\"কি না"],["تَكُونُوٓا۟","takūnū","you","করতে তোমরা ছিলে"],["أَقْسَمْتُم","aqsamtum","sworn","তোমরা শপথ"],["مِّن","min","before","থেকে"],["قَبْلُ","qablu","before","আগে"],["مَا","mā","not","নেই"],["لَكُم","lakum","for you","তোমাদের জন্যে"],["مِّن","min","any","কোনো"],["زَوَالٍۢ","zawālin","end","পতন"]],"t":"وَأَ<k>نذِ</>رِ <h>ٱ</><l>ل</><g>نَّ</>اسَ يَوْمَ يَأْتِيهِمُ <h>ٱ</>لْعَذَابُ فَيَقُولُ <h>ٱ</>لَّذِينَ ظَلَمُو<s>ا۟</> رَبَّ<o>نَآ</> أَخِّرْ<o>نَآ</> إِلَ<o>ىٰٓ</> أَجَ<k>لٍۢ قَ</>رِي<d>بٍۢ نُّ</>جِ<q>بْ</> دَعْوَتَكَ وَنَتَّبِعِ <h>ٱ</><l>ل</>رُّسُلَ ۗ أَوَلَمْ تَكُو<o>نُوٓ</><s>ا۟</> أَ<q>قْ</>سَمْ<y>تُم مِّ</><k>ن قَ</><q>بْ</>لُ مَا لَ<y>كُم مِّ</><k>ن زَ</><p>وَا</>لٍۢ"},{"n":45,"w":[["وَسَكَنتُمْ","wasakantum","And you dwelt","এবং তোমরা বসবাস করছিলে"],["فِى","fī","in","মধ্যে"],["مَسَـٰكِنِ","masākini","the dwellings","বাসভূমিসমূহের"],["ٱلَّذِينَ","alladhīna","(of) those who","যারা"],["ظَلَمُوٓا۟","ẓalamū","wronged","সীমালঙ্ঘন করেছিলো"],["أَنفُسَهُمْ","anfusahum","themselves","তাদের নিজেদের উপর"],["وَتَبَيَّنَ","watabayyana","and it had become clear","অথচ  স্পষ্ট ছিলো"],["لَكُمْ","lakum","to you","কাছে তোমাদের"],["كَيْفَ","kayfa","how","কেমন (আচরণ)"],["فَعَلْنَا","fa‘alnā","We dealt","আমরা করেছিলাম"],["بِهِمْ","bihim","with them","সাথে তাদের"],["وَضَرَبْنَا","waḍarabnā","and We put forth","এবং আমরা বর্ণনা করেছি"],["لَكُمُ","lakumu","for you","জন্যে তোমাদের"],["ٱلْأَمْثَالَ","l-amthāla","the examples","দৃষ্টান্তসমূহ\""]],"t":"وَسَكَ<k>نتُ</>مْ فِى مَ<m>سَٰ</>كِنِ <h>ٱ</>لَّذِينَ ظَلَ<o>مُوٓ</><s>ا۟</> أَ<k>نفُ</>سَهُمْ وَتَبَيَّنَ لَكُمْ كَيْفَ فَعَلْنَا بِهِمْ وَضَرَ<q>بْ</>نَا لَكُمُ <h>ٱ</>لْأَمْ<p>ثَا</>لَ"},{"n":46,"w":[["وَقَدْ","waqad","And indeed","এবং নিশ্চয়ই"],["مَكَرُوا۟","makarū","they planned","তারা চক্রান্ত করেছিলো"],["مَكْرَهُمْ","makrahum","their plan","তাদের চক্রান্ত"],["وَعِندَ","wa‘inda","but with","কিন্তু কাছে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর (ছিলো)"],["مَكْرُهُمْ","makruhum","(was) their plan","তাদের চক্রান্ত"],["وَإِن","wa-in","even if","এবং যদিও"],["كَانَ","kāna","was","ছিলো"],["مَكْرُهُمْ","makruhum","their plan","তাদের চক্রান্ত (এমন ভয়ানক)"],["لِتَزُولَ","litazūla","that should be moved","যেন টলে যেতো"],["مِنْهُ","min'hu","by it","তা থেকে"],["ٱلْجِبَالُ","l-jibālu","the mountains","পর্বতসমূহ"]],"t":"وَقَ<q>دْ</> مَكَرُو<s>ا۟</> مَكْرَهُمْ وَعِ<k>ندَ</> <h>ٱ</>للَّهِ مَكْرُهُمْ وَإِ<k>ن كَ</>انَ مَكْرُهُمْ لِتَزُولَ مِنْهُ <h>ٱ</>لْجِ<p>بَا</>لُ"},{"n":47,"w":[["فَلَا","falā","So (do) not","অতএব না"],["تَحْسَبَنَّ","taḥsabanna","think","নিশ্চয়ই তুমি মনে করবে"],["ٱللَّهَ","l-laha","(that) Allah","আল্লাহকে"],["مُخْلِفَ","mukh'lifa","will fail","ভঙ্গকারী"],["وَعْدِهِۦ","wa‘dihi","(to) keep His Promise","তাঁর প্রতিশ্রুতি"],["رُسُلَهُۥٓ ۗ","rusulahu","(to) His Messengers","তাঁর রাসূলদের (কাছে)"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["عَزِيزٌۭ","‘azīzun","(is) All-Mighty","পরাক্রমশালী"],["ذُو","dhū","Owner (of) Retribution","সমর্থ"],["ٱنتِقَامٍۢ","intiqāmin","Owner (of) Retribution","প্রতিশোধ গ্রহণে"]],"t":"فَلَا تَحْسَبَ<g>نَّ</> <h>ٱ</>للَّهَ مُخْلِفَ وَعْدِ<m>هِۦ</> رُسُلَهُ<o>ۥٓ ۗ</> إِ<g>نَّ</> <h>ٱ</>للَّهَ عَزِي<k>زٌۭ ذُ</>و <h>ٱ</><k>نتِ</><p>قَا</>مٍۢ"},{"n":48,"w":[["يَوْمَ","yawma","(On the) Day","সেদিন"],["تُبَدَّلُ","tubaddalu","will be changed","পরিবর্তিত হবে"],["ٱلْأَرْضُ","l-arḍu","the earth","(এই) পৃথিবী"],["غَيْرَ","ghayra","(to) other (than)","অন্য"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃৃথিবীতে"],["وَٱلسَّمَـٰوَٰتُ ۖ","wal-samāwātu","and the heavens","এবং আকাশমন্ডলী"],["وَبَرَزُوا۟","wabarazū","and they will come forth","এবং উপস্থিত হবে (উন্মোচিত হবে)"],["لِلَّهِ","lillahi","before Allah","আল্লাহর কাছে"],["ٱلْوَٰحِدِ","l-wāḥidi","the One","(যিনি) এক"],["ٱلْقَهَّارِ","l-qahāri","the Irresistible","পরাক্রমশালী"]],"t":"يَوْمَ تُبَدَّلُ <h>ٱ</>لْأَرْضُ غَيْرَ <h>ٱ</>لْأَرْضِ وَ<h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تُ ۖ وَبَرَزُو<s>ا۟</> لِلَّهِ <h>ٱ</>لْ<m>وَٰ</>حِدِ <h>ٱ</>لْقَ<p>هَّا</>رِ"},{"n":49,"w":[["وَتَرَى","watarā","And you will see","এবং তুমি দেখবে"],["ٱلْمُجْرِمِينَ","l-muj'rimīna","the criminals","অপরাধীদেরকে"],["يَوْمَئِذٍۢ","yawma-idhin","(on) that Day","সেদিন"],["مُّقَرَّنِينَ","muqarranīna","bound together","কঠোরভাবে বাঁধা"],["فِى","fī","in","মধ্যে"],["ٱلْأَصْفَادِ","l-aṣfādi","the chains","শেকলসমূহের"]],"t":"وَتَرَى <h>ٱ</>لْمُ<q>جْ</>رِمِينَ يَوْمَئِ<d>ذٍۢ مُّ</>قَرَّنِينَ فِى <h>ٱ</>لْأَصْ<p>فَا</><q>دِ</>"},{"n":50,"w":[["سَرَابِيلُهُم","sarābīluhum","Their garments","তাদের জামাসমূহ (হবে)"],["مِّن","min","of","তৈরি"],["قَطِرَانٍۢ","qaṭirānin","tar","আলকাতরার"],["وَتَغْشَىٰ","wataghshā","and will cover","ও ছেয়ে ফেলবে"],["وُجُوهَهُمُ","wujūhahumu","their faces","তাদের মুখসমূহকে"],["ٱلنَّارُ","l-nāru","the Fire","আগুন"]],"t":"سَرَابِيلُ<y>هُم مِّ</><k>ن قَ</>طِرَا<d>نٍۢ وَ</>تَغْشَىٰ وُجُوهَهُمُ <h>ٱ</><l>ل</><g>نَّ</><p>ا</>رُ"},{"n":51,"w":[["لِيَجْزِىَ","liyajziya","So that Allah may recompense","যেন প্রতিফল দেন"],["ٱللَّهُ","l-lahu","So that Allah may recompense","আল্লাহ"],["كُلَّ","kulla","each","প্রত্যেক"],["نَفْسٍۢ","nafsin","soul","ব্যক্তিকে"],["مَّا","mā","(for) what","যা"],["كَسَبَتْ ۚ","kasabat","it earned","সে উপার্জন করেছে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["سَرِيعُ","sarī‘u","(is) Swift","দ্রুত"],["ٱلْحِسَابِ","l-ḥisābi","(in) the reckoning","হিসেব গ্রহণে"]],"t":"لِيَ<q>جْ</>زِىَ <h>ٱ</>للَّهُ كُلَّ نَفْ<d>سٍۢ مَّ</>ا كَسَبَتْ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ سَرِيعُ <h>ٱ</>لْحِ<p>سَا</><q>بِ</>"},{"n":52,"w":[["هَـٰذَا","hādhā","This","এটা"],["بَلَـٰغٌۭ","balāghun","(is) a Message","এক বার্তা"],["لِّلنَّاسِ","lilnnāsi","for the mankind","মানুষের জন্যে"],["وَلِيُنذَرُوا۟","waliyundharū","that they may be warned","এবং তাদের যেন সতর্ক করা হয়"],["بِهِۦ","bihi","with it","দিয়ে তা"],["وَلِيَعْلَمُوٓا۟","waliya‘lamū","and that they may know","এবং যেন তারা জানে"],["أَنَّمَا","annamā","that only","প্রকৃতপক্ষে"],["هُوَ","huwa","He","তিনিই"],["إِلَـٰهٌۭ","ilāhun","(is) One God","ইলাহ"],["وَٰحِدٌۭ","wāḥidun","(is) One God","একমাত্র"],["وَلِيَذَّكَّرَ","waliyadhakkara","and that may take heed","ও যেন শিক্ষা গ্রহণ করে"],["أُو۟لُوا۟","ulū","men","সম্পন্নরা"],["ٱلْأَلْبَـٰبِ","l-albābi","(of) understanding","বোধ (লোকেরা)"]],"t":"<m>هَٰ</>ذَا بَ<m>لَٰ</><w>غٌۭ لِّ</>ل<g>نَّ</>اسِ وَلِيُ<k>نذَ</>رُو<s>ا۟</> بِ<m>هِۦ</> وَلِيَعْلَ<o>مُوٓ</><s>ا۟</> أَ<g>نَّ</>مَا هُوَ إِ<m>لَٰ</><d>هٌۭ وَٰحِدٌۭ وَ</>لِيَذَّكَّرَ أُ<s>و۟</>لُو<s>ا۟</> <h>ٱ</>لْأَلْ<p>بَٰ</><q>بِ</>"}]}