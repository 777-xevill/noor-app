{"n":14,"a":[{"n":1,"w":[["الٓر ۚ","alif-lam-ra","Alif Laam Ra","আলিফ- লা-ম রা-"],["كِتَـٰبٌ","kitābun","A Book","(এই) কিতাব"],["أَنزَلْنَـٰهُ","anzalnāhu","which We have revealed","তা আমরা অবতীর্ণ করেছি"],["إِلَيْكَ","ilayka","to you","তোমার প্রতি"],["لِتُخْرِجَ","litukh'rija","so that you may bring out","যেন তুমি বের করো"],["ٱلنَّاسَ","l-nāsa","the mankind","মানুষকে"],["مِنَ","mina","from","থেকে"],["ٱلظُّلُمَـٰتِ","l-ẓulumāti","the darkness[es]","অন্ধকারসমূহ"],["إِلَى","ilā","to","দিকে"],["ٱلنُّورِ","l-nūri","the light","আলোর"],["بِإِذْنِ","bi-idh'ni","by the permission","অনুমতিক্রমে"],["رَبِّهِمْ","rabbihim","(of) their Lord","তাদের রবের"],["إِلَىٰ","ilā","to","দিকে"],["صِرَٰطِ","ṣirāṭi","the Path","পথের"],["ٱلْعَزِيزِ","l-‘azīzi","(of) the All-Mighty","পরাক্রমশালী"],["ٱلْحَمِيدِ","l-ḥamīdi","the Praiseworthy","প্রশংসিত"]],"t":"ا<n>لٓ</>ر ۚ كِ<m>تَٰ</>بٌ أَ<k>نزَ</>لْ<m>نَٰ</>هُ إِلَيْكَ لِتُخْرِجَ <h>ٱ</><l>ل</><g>نَّ</>اسَ مِنَ <h>ٱ</><l>ل</>ظُّلُ<m>مَٰ</>تِ إِلَى <h>ٱ</><l>ل</><g>نُّ</>ورِ بِإِذْنِ رَبِّهِمْ إِلَىٰ صِ<m>رَٰ</>طِ <h>ٱ</>لْعَزِيزِ <h>ٱ</>لْحَ<p>مِي</><q>دِ</>"},{"n":2,"w":[["ٱللَّهِ","al-lahi","Allah","আল্লাহ"],["ٱلَّذِى","alladhī","(is) the One","তিনিই"],["لَهُۥ","lahu","to Him (belongs)","জন্যে যার"],["مَا","mā","whatever","যা কিছূু"],["فِى","fī","(is) in","মধ্যে আছে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশের"],["وَمَا","wamā","and whatever","ও যা কিছু"],["فِى","fī","(is) in","মধ্যে আছে"],["ٱلْأَرْضِ ۗ","l-arḍi","the earth","পৃথিবীর"],["وَوَيْلٌۭ","wawaylun","And woe","এবং দুর্ভোগ"],["لِّلْكَـٰفِرِينَ","lil'kāfirīna","to the disbelievers","কাফেরদের জন্যে"],["مِنْ","min","from","হতে"],["عَذَابٍۢ","‘adhābin","the punishment","শাস্তি"],["شَدِيدٍ","shadīdin","severe","কঠোর"]],"t":"ٱللَّهِ <h>ٱ</>لَّذِى لَهُ<m>ۥ</> مَا فِى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَمَا فِى <h>ٱ</>لْأَرْضِ ۗ وَوَيْ<w>لٌۭ لِّ</>لْ<m>كَٰ</>فِرِينَ مِنْ عَذَا<k>بٍۢ شَ</><p>دِي</><q>دٍ</>"},{"n":3,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["يَسْتَحِبُّونَ","yastaḥibbūna","love more","প্রাধান্য দেয়"],["ٱلْحَيَوٰةَ","l-ḥayata","the life","জীবনকে"],["ٱلدُّنْيَا","l-dun'yā","(of) the world","পার্থিব"],["عَلَى","‘alā","than","উপর"],["ٱلْـَٔاخِرَةِ","l-ākhirati","the Hereafter","আখিরাতের"],["وَيَصُدُّونَ","wayaṣuddūna","and hinder","ও (মানুষকে) বাধা দেয়"],["عَن","‘an","from","থেকে"],["سَبِيلِ","sabīli","(the) Path","পথ"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَيَبْغُونَهَا","wayabghūnahā","and seek in it","ও তাকে করতে চায়"],["عِوَجًا ۚ","‘iwajan","crookedness","বাঁকা"],["أُو۟لَـٰٓئِكَ","ulāika","those","ঐসব লোক"],["فِى","fī","[in]","মধ্যে আছে"],["ضَلَـٰلٍۭ","ḍalālin","(are) far astray","বিপথে"],["بَعِيدٍۢ","ba‘īdin","(are) far astray","(বহু) দূরে"]],"t":"ٱلَّذِينَ يَسْتَحِبُّونَ <h>ٱ</>لْحَيَ<s>وٰ</>ةَ <h>ٱ</><l>ل</>دُّنْيَا عَلَى <h>ٱ</>لْءَاخِرَةِ وَيَصُدُّونَ عَ<k>ن سَ</>بِيلِ <h>ٱ</>للَّهِ وَيَ<q>بْ</>غُونَهَا عِوَجًا ۚ أُ<s>و۟</><o>لَٰٓ</>ئِكَ فِى ضَ<m>لَٰ</><i>لٍۭ بَ</><p>عِي</><q>دٍۢ</>"},{"n":4,"w":[["وَمَآ","wamā","And not","এবং নি"],["أَرْسَلْنَا","arsalnā","We sent","আমরা পাঠাই"],["مِن","min","any","কোনো"],["رَّسُولٍ","rasūlin","Messenger","রাসূলকে"],["إِلَّا","illā","except","ছাড়া"],["بِلِسَانِ","bilisāni","with the language","দিয়ে ভাষা"],["قَوْمِهِۦ","qawmihi","(of) his people","তার জাতির"],["لِيُبَيِّنَ","liyubayyina","so that he might make clear","যেন সুস্পষ্ট করে বর্ণনা করেন"],["لَهُمْ ۖ","lahum","for them","তাদেরকে"],["فَيُضِلُّ","fayuḍillu","Then Allah lets go astray","অতঃপর পথভ্রষ্ট করেন"],["ٱللَّهُ","l-lahu","Then Allah lets go astray","আল্লাহ"],["مَن","man","whom","যাকে"],["يَشَآءُ","yashāu","He wills","ইচ্ছে করেন"],["وَيَهْدِى","wayahdī","and guides","ও সৎ পথ দেখান"],["مَن","man","whom","যাকে"],["يَشَآءُ ۚ","yashāu","He wills","ইচ্ছে করেন"],["وَهُوَ","wahuwa","And He","এবং তিনি"],["ٱلْعَزِيزُ","l-‘azīzu","(is) the All-Mighty","পরাক্রমশালী"],["ٱلْحَكِيمُ","l-ḥakīmu","the All-Wise","প্রজ্ঞাময়"]],"t":"وَ<o>مَآ</> أَرْسَلْنَا <w>مِن رَّ</>سُولٍ إِلَّا بِلِسَانِ قَوْمِ<m>هِۦ</> لِيُبَيِّنَ لَهُمْ ۖ فَيُضِلُّ <h>ٱ</>للَّهُ <d>مَن يَ</><o>شَآ</>ءُ وَيَهْدِى <d>مَن يَ</><o>شَآ</>ءُ ۚ وَهُوَ <h>ٱ</>لْعَزِيزُ <h>ٱ</>لْحَ<p>كِي</>مُ"},{"n":5,"w":[["وَلَقَدْ","walaqad","And verily","এবং নিশ্চয়ই"],["أَرْسَلْنَا","arsalnā","We sent","আমরা প্রেরণ করেছিলাম"],["مُوسَىٰ","mūsā","Musa","মুসাকে"],["بِـَٔايَـٰتِنَآ","biāyātinā","with Our Signs","দিয়ে আমাদের নিদর্শনাদি"],["أَنْ","an","that","যে"],["أَخْرِجْ","akhrij","Bring out","\"বের করো"],["قَوْمَكَ","qawmaka","your people","তোমার জাতিকে"],["مِنَ","mina","from","থেকে"],["ٱلظُّلُمَـٰتِ","l-ẓulumāti","the darkness[es]","অন্ধকারসমূহ"],["إِلَى","ilā","to","দিকে"],["ٱلنُّورِ","l-nūri","the light","আলোর"],["وَذَكِّرْهُم","wadhakkir'hum","And remind them","এবং তাদেরকে উপদেশ দাও"],["بِأَيَّىٰمِ","bi-ayyāmi","of the days","দিয়ে দিনগুলো"],["ٱللَّهِ ۚ","l-lahi","(of) Allah","আল্লাহর\""],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে আছে"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَـٰتٍۢ","laāyātin","surely (are) the signs","অবশ্যই নিদর্শনাবলী"],["لِّكُلِّ","likulli","for everyone","জন্যে প্রত্যেক"],["صَبَّارٍۢ","ṣabbārin","patient","পরম ধৈর্যশীল"],["شَكُورٍۢ","shakūrin","and thankful","পরম কৃতজ্ঞ ব্যক্তির"]],"t":"وَلَقَ<q>دْ</> أَرْسَلْنَا مُوسَىٰ بِـَٔا<m>يَٰ</>تِ<o>نَآ</> أَنْ أَخْرِ<q>جْ</> قَوْمَكَ مِنَ <h>ٱ</><l>ل</>ظُّلُ<m>مَٰ</>تِ إِلَى <h>ٱ</><l>ل</><g>نُّ</>ورِ وَذَكِّرْ<f>هُم بِ</>أَيَّ<m>ىٰ</>مِ <h>ٱ</>للَّهِ ۚ إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَا<m>يَٰ</><w>تٍۢ لِّ</>كُلِّ صَبَّا<k>رٍۢ شَ</><p>كُو</>رٍۢ"},{"n":6,"w":[["وَإِذْ","wa-idh","And when","এবং স্মরণ করো যখন"],["قَالَ","qāla","said","বলেছিলো"],["مُوسَىٰ","mūsā","Musa","মুসা"],["لِقَوْمِهِ","liqawmihi","to his people","তার জাতিকে"],["ٱذْكُرُوا۟","udh'kurū","Remember","\"তোমরা স্মরণ করো"],["نِعْمَةَ","ni‘'mata","(the) Favor of Allah","অনুগ্রহ"],["ٱللَّهِ","l-lahi","(the) Favor of Allah","আল্লাহর"],["عَلَيْكُمْ","‘alaykum","upon you","তোমাদের উপর"],["إِذْ","idh","when","যখন"],["أَنجَىٰكُم","anjākum","He saved you","তোমাদের তিনি রক্ষা করেন"],["مِّنْ","min","from","থেকে"],["ءَالِ","āli","(the) people","সম্প্রদায়"],["فِرْعَوْنَ","fir'‘awna","(of) Firaun","ফিরাউনের"],["يَسُومُونَكُمْ","yasūmūnakum","they were afflicting you","তোমাদের উপর তারা প্রয়োগ করতো"],["سُوٓءَ","sūa","(with) evil","নিকৃষ্ট"],["ٱلْعَذَابِ","l-‘adhābi","torment","শাস্তি"],["وَيُذَبِّحُونَ","wayudhabbiḥūna","and were slaughtering","এবং তারা জবেহ করতো"],["أَبْنَآءَكُمْ","abnāakum","your sons","তোমাদের পুত্রসন্তানদেরকে"],["وَيَسْتَحْيُونَ","wayastaḥyūna","and letting live","ও তারা জীবিত রাখতো"],["نِسَآءَكُمْ ۚ","nisāakum","your women","তোমাদের মেয়েদেরকে"],["وَفِى","wafī","And in","এবং মধ্যে (ছিলো)"],["ذَٰلِكُم","dhālikum","that","এর তোমাদের জন্যে"],["بَلَآءٌۭ","balāon","(was) a trial","পরীক্ষা"],["مِّن","min","from","থেকে"],["رَّبِّكُمْ","rabbikum","your Lord","তোমাদের রবের"],["عَظِيمٌۭ","‘aẓīmun","great","বিরাট\""]],"t":"وَإِذْ قَالَ مُوسَىٰ لِقَوْمِهِ <h>ٱ</>ذْكُرُو<s>ا۟</> نِعْمَةَ <h>ٱ</>للَّهِ عَلَيْكُمْ إِذْ أَ<k>نجَ</><m>ىٰ</><y>كُم مِّ</>نْ ءَالِ فِرْعَوْنَ يَسُومُونَكُمْ <o>سُوٓ</>ءَ <h>ٱ</>لْعَذَابِ وَيُذَبِّحُونَ أَ<q>بْ</><o>نَآ</>ءَكُمْ وَيَسْتَحْيُونَ نِ<o>سَآ</>ءَكُمْ ۚ وَفِى <m>ذَٰ</>لِ<f>كُم بَ</><o>لَآ</><d>ءٌۭ مِّ</><w>ن رَّ</>بِّكُمْ عَ<p>ظِي</>مٌۭ"},{"n":7,"w":[["وَإِذْ","wa-idh","And when","এবং (স্মরণ করো) যখন"],["تَأَذَّنَ","ta-adhana","proclaimed","ঘোষণা করেন"],["رَبُّكُمْ","rabbukum","your Lord","তোমার রব"],["لَئِن","la-in","If","\"অবশ্যই যদি"],["شَكَرْتُمْ","shakartum","you are thankful","তোমরা কৃতজ্ঞ হও"],["لَأَزِيدَنَّكُمْ ۖ","la-azīdannakum","surely I will increase you","এবং তোমাদের অবশ্যই অধিক দিবো"],["وَلَئِن","wala-in","but if","আর অবশ্যই যদি"],["كَفَرْتُمْ","kafartum","you are ungrateful","তোমরা অকৃতজ্ঞ হও"],["إِنَّ","inna","indeed","নিশ্চয়ই (তবে)"],["عَذَابِى","‘adhābī","My punishment","আমার শাস্তি"],["لَشَدِيدٌۭ","lashadīdun","(is) surely severe","অবশ্যই কঠোর\""]],"t":"وَإِذْ تَأَذَّنَ رَبُّكُمْ لَئِ<k>ن شَ</>كَرْتُمْ لَأَزِيدَ<g>نَّ</>كُمْ ۖ وَلَئِ<k>ن كَ</>فَرْتُمْ إِ<g>نَّ</> عَذَابِى لَشَ<p>دِي</><q>دٌۭ</>"},{"n":8,"w":[["وَقَالَ","waqāla","And said","এবং বলেছিলো"],["مُوسَىٰٓ","mūsā","Musa","মুসা"],["إِن","in","If","\"যদি"],["تَكْفُرُوٓا۟","takfurū","you disbelieve","অস্বীকার করো"],["أَنتُمْ","antum","you","তোমরা"],["وَمَن","waman","and whoever","ও যা কিছু"],["فِى","fī","(is) in","মধ্যে আছে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["جَمِيعًۭا","jamī‘an","all","সকলেই"],["فَإِنَّ","fa-inna","then indeed","তবুও নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَغَنِىٌّ","laghaniyyun","certainly (is) Free of need","অবশ্যই অভাবমুক্ত"],["حَمِيدٌ","ḥamīdun","Praiseworthy","প্রশংসিত\""]],"t":"وَقَالَ مُوسَ<o>ىٰٓ</> إِ<k>ن تَ</>كْفُ<o>رُوٓ</><s>ا۟</> أَ<k>نتُ</>مْ وَمَ<k>ن فِ</>ى <h>ٱ</>لْأَرْضِ جَمِي<k>عًۭا فَ</>إِ<g>نَّ</> <h>ٱ</>للَّهَ لَغَنِىٌّ حَ<p>مِي</><q>دٌ</>"},{"n":9,"w":[["أَلَمْ","alam","Has not","কাছে কি"],["يَأْتِكُمْ","yatikum","come to you","আসে নি তোমাদের"],["نَبَؤُا۟","naba-u","(the) news","সংবাদ"],["ٱلَّذِينَ","alladhīna","(of) those who","(তাদের) যারা"],["مِن","min","(were) before you","থেকে"],["قَبْلِكُمْ","qablikum","(were) before you","পূর্ব তোমাদের (ছিলো)"],["قَوْمِ","qawmi","the people","জাতি"],["نُوحٍۢ","nūḥin","of Nuh","নূহের"],["وَعَادٍۢ","wa‘ādin","and Aad","ও আদ"],["وَثَمُودَ ۛ","wathamūda","and Thamud","ও সামুদ"],["وَٱلَّذِينَ","wa-alladhīna","and those who","এবং যারা"],["مِنۢ","min","(were) after them","থেকে"],["بَعْدِهِمْ ۛ","ba‘dihim","(were) after them","তাদের পর (এসেছে)"],["لَا","lā","None","না"],["يَعْلَمُهُمْ","ya‘lamuhum","knows them","তাদেরকে কেউ জানে"],["إِلَّا","illā","except","ব্যতীত"],["ٱللَّهُ ۚ","l-lahu","Allah","আল্লাহ"],["جَآءَتْهُمْ","jāathum","Came to them","তাদের কাছে এসেছিলো"],["رُسُلُهُم","rusuluhum","their Messengers","তাদের রাসূলরা"],["بِٱلْبَيِّنَـٰتِ","bil-bayināti","with clear proofs","নিয়ে সুস্পষ্ট নিদর্শনাদী"],["فَرَدُّوٓا۟","faraddū","but they returned","অতঃপর তারা ফিরিয়েছে"],["أَيْدِيَهُمْ","aydiyahum","their hands","তাদের হাতগুলো"],["فِىٓ","fī","in","মধ্যে"],["أَفْوَٰهِهِمْ","afwāhihim","their mouths","তাদের মুখগুলোর"],["وَقَالُوٓا۟","waqālū","and they said","এবং তা বলেছিলো"],["إِنَّا","innā","Indeed we","\"নিশ্চয়ই"],["كَفَرْنَا","kafarnā","[we] disbelieve","আমরা অস্বীকার করলাম"],["بِمَآ","bimā","in what","ঐ বিষয়ে যা"],["أُرْسِلْتُم","ur'sil'tum","you have been sent","তোমরা প্রেরিত হয়েছো"],["بِهِۦ","bihi","with [it]","ঐ সম্বন্ধে"],["وَإِنَّا","wa-innā","and indeed, we","এবং নিশ্চয়ই আমরা"],["لَفِى","lafī","(are) surely in","অবশ্যই মধ্যে"],["شَكٍّۢ","shakkin","doubt","সন্দেহের"],["مِّمَّا","mimmā","about what","তা হ'তে যা"],["تَدْعُونَنَآ","tad‘ūnanā","you invite us","আমাদের তোমরা ডাকছো"],["إِلَيْهِ","ilayhi","to it","তারই দিকে"],["مُرِيبٍۢ","murībin","suspicious","সন্দেহ উদ্রেককারী\""]],"t":"أَلَمْ يَأْتِكُمْ نَبَؤُ<s>ا۟</> <h>ٱ</>لَّذِينَ مِ<k>ن قَ</><q>بْ</>لِكُمْ قَوْمِ نُو<d>حٍۢ وَ</>عَا<d>دٍۢ وَ</>ثَمُودَ ۛ وَ<h>ٱ</>لَّذِينَ <i>مِنۢ بَ</>عْدِهِمْ ۛ لَا يَعْلَمُهُمْ إِلَّا <h>ٱ</>للَّهُ ۚ <o>جَآ</>ءَتْهُمْ رُسُلُ<f>هُم بِ</><h>ٱ</>لْبَيِّ<m>نَٰ</>تِ فَرَ<o>دُّوٓ</><s>ا۟</> أَيْدِيَهُمْ <o>فِىٓ</> أَفْ<m>وَٰ</>هِهِمْ وَقَا<o>لُوٓ</><s>ا۟</> إِ<g>نَّ</>ا كَفَرْنَا بِ<o>مَآ</> أُرْسِلْ<f>تُم بِ</><m>هِۦ</> وَإِ<g>نَّ</>ا لَفِى شَ<d>كٍّۢ مِّ</><g>مَّ</>ا تَ<q>دْ</>عُونَ<o>نَآ</> إِلَيْهِ مُ<p>رِي</><q>بٍۢ</>"},{"n":10,"w":[["۞ قَالَتْ","qālat","Said","বলেছিলো"],["رُسُلُهُمْ","rusuluhum","their Messengers","রাসূলরা তাদের"],["أَفِى","afī","Can (there) be about","\"কি আছে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর (সম্বন্ধে)"],["شَكٌّۭ","shakkun","any doubt","কোনো সন্দেহ"],["فَاطِرِ","fāṭiri","(the) Creator","যিনি সৃষ্টিকর্তা"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশের"],["وَٱلْأَرْضِ ۖ","wal-arḍi","and the earth","ও পৃথিবীর"],["يَدْعُوكُمْ","yad‘ūkum","He invites you","তিনি ডাকছেন তোমাদেরকে"],["لِيَغْفِرَ","liyaghfira","so that He may forgive","মাফ করে দেয়ার জন্যে"],["لَكُم","lakum","for you","তোমাদের"],["مِّن","min","[of]","থেকে"],["ذُنُوبِكُمْ","dhunūbikum","your sins","তোমাদের পাপসমূহ"],["وَيُؤَخِّرَكُمْ","wayu-akhirakum","and give you respite","এবং অবকাশ দিবেন তোমাদের"],["إِلَىٰٓ","ilā","for","পর্যন্ত"],["أَجَلٍۢ","ajalin","a term","কাল"],["مُّسَمًّۭى ۚ","musamman","appointed","নির্দিষ্ট\""],["قَالُوٓا۟","qālū","They said","তারা বলেছিলো"],["إِنْ","in","Not","\"নও"],["أَنتُمْ","antum","you","তোমরা"],["إِلَّا","illā","(are) but","ব্যতীত"],["بَشَرٌۭ","basharun","a human","মানুষ"],["مِّثْلُنَا","mith'lunā","like us","আমাদের মতো"],["تُرِيدُونَ","turīdūna","you wish","তোমরা চাচ্ছো"],["أَن","an","to","যে"],["تَصُدُّونَا","taṣuddūnā","hinder us","তোমরা আমাদের বিরত রাখবে"],["عَمَّا","‘ammā","from what","ঐ বিষয়ে যা"],["كَانَ","kāna","used to","ছিলো"],["يَعْبُدُ","ya‘budu","worship","ইবাদত করে আসছে"],["ءَابَآؤُنَا","ābāunā","our forefathers","আমাদের পূর্ব-পুরুষরা"],["فَأْتُونَا","fatūnā","So bring us","অতএব আমাদের কাছে আসো"],["بِسُلْطَـٰنٍۢ","bisul'ṭānin","an authority","নিয়ে কোনো প্রমাণ"],["مُّبِينٍۢ","mubīnin","clear","সুস্পষ্ট\""]],"t":"۞ قَالَتْ رُسُلُهُمْ أَفِى <h>ٱ</>للَّهِ شَ<k>كٌّۭ فَ</>اطِرِ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ ۖ يَ<q>دْ</>عُوكُمْ لِيَغْفِرَ لَ<y>كُم مِّ</><k>ن ذُ</>نُوبِكُمْ وَيُؤَخِّرَكُمْ إِلَ<o>ىٰٓ</> أَجَ<d>لٍۢ مُّ</>سَ<k>مًّۭى ۚ قَ</>ا<o>لُوٓ</><s>ا۟</> إِنْ أَ<k>نتُ</>مْ إِلَّا بَشَ<d>رٌۭ مِّ</>ثْلُنَا تُرِيدُونَ أَ<k>ن تَ</>صُدُّونَا عَ<g>مَّ</>ا كَانَ يَعْبُدُ ءَا<o>بَآ</>ؤُنَا فَأْتُونَا بِسُلْ<m>طَٰ</><d>نٍۢ مُّ</><p>بِي</>نٍۢ"},{"n":11,"w":[["قَالَتْ","qālat","Said","বলেছিলো"],["لَهُمْ","lahum","to them","তাদেরকে"],["رُسُلُهُمْ","rusuluhum","their Messengers","তাদের রাসূলরা"],["إِن","in","Not","\"নই"],["نَّحْنُ","naḥnu","we (are)","আমরা"],["إِلَّا","illā","but","ব্যতীত"],["بَشَرٌۭ","basharun","a human","মানুষ"],["مِّثْلُكُمْ","mith'lukum","like you","তোমাদের মতো"],["وَلَـٰكِنَّ","walākinna","but","কিন্তু"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يَمُنُّ","yamunnu","bestows His Grace","ধন্য করেন"],["عَلَىٰ","‘alā","on","উপর"],["مَن","man","whom","যাকে"],["يَشَآءُ","yashāu","He wills","ইচ্ছে করেন"],["مِنْ","min","of","মধ্য হ'তে"],["عِبَادِهِۦ ۖ","‘ibādihi","His slaves","তাঁর দাসদের"],["وَمَا","wamā","And not","এবং নয়"],["كَانَ","kāna","is","কাজ"],["لَنَآ","lanā","for us","আমাদের"],["أَن","an","that","যে"],["نَّأْتِيَكُم","natiyakum","we bring you","তোমাদের কাছে আসবো আমরা"],["بِسُلْطَـٰنٍ","bisul'ṭānin","an authority","নিয়ে কোন প্রমাণ"],["إِلَّا","illā","except","ব্যতীত"],["بِإِذْنِ","bi-idh'ni","by the permission of Allah","অনুমতিক্রমে"],["ٱللَّهِ ۚ","l-lahi","by the permission of Allah","আল্লাহর"],["وَعَلَى","wa‘alā","And upon","এবং উপর"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["فَلْيَتَوَكَّلِ","falyatawakkali","so let put (their) trust","ভরসা করা উচিত"],["ٱلْمُؤْمِنُونَ","l-mu'minūna","the believers","মু’মিনদের"]],"t":"قَالَتْ لَهُمْ رُسُلُهُمْ <d>إِن نَّ</>حْنُ إِلَّا بَشَ<d>رٌۭ مِّ</>ثْلُكُمْ وَ<m>لَٰ</>كِ<g>نَّ</> <h>ٱ</>للَّهَ يَمُ<g>نُّ</> عَلَىٰ <d>مَن يَ</><o>شَآ</>ءُ مِنْ عِبَادِ<m>هِۦ</> ۖ وَمَا كَانَ لَ<o>نَآ</> <d>أَن نَّ</>أْتِيَ<f>كُم بِ</>سُلْ<m>طَٰ</>نٍ إِلَّا بِإِذْنِ <h>ٱ</>للَّهِ ۚ وَعَلَى <h>ٱ</>للَّهِ فَلْيَتَوَكَّلِ <h>ٱ</>لْمُؤْمِ<p>نُو</>نَ"},{"n":12,"w":[["وَمَا","wamā","And what","এবং কি হয়েছে"],["لَنَآ","lanā","(is) for us","আমাদের"],["أَلَّا","allā","that not","যে না"],["نَتَوَكَّلَ","natawakkala","we put our trust","আমরা ভরসা করবো"],["عَلَى","‘alā","upon","উপর"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["وَقَدْ","waqad","while certainly","অথচ নিশ্চয়ই"],["هَدَىٰنَا","hadānā","He has guided us","আমাদের তিনি পথ দেখিয়েছেন"],["سُبُلَنَا ۚ","subulanā","to our ways","আমাদের পথসমূহে"],["وَلَنَصْبِرَنَّ","walanaṣbiranna","And surely we will bear with patience","এবং অবশ্যই আমরা ধৈর্য ধরবো"],["عَلَىٰ","‘alā","on","উপর"],["مَآ","mā","what","যা কিছু"],["ءَاذَيْتُمُونَا ۚ","ādhaytumūnā","harm you may cause us","আমাদের তোমরা কষ্ট দিচ্ছো"],["وَعَلَى","wa‘alā","And upon","এবং উপর"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["فَلْيَتَوَكَّلِ","falyatawakkali","so let put (their) trust","ভরসা করা উচিত"],["ٱلْمُتَوَكِّلُونَ","l-mutawakilūna","the ones who put (their) trust","ভরসাকারীদের\""]],"t":"وَمَا لَ<o>نَآ</> أَلَّا نَتَوَكَّلَ عَلَى <h>ٱ</>للَّهِ وَقَ<q>دْ</> هَدَ<m>ىٰ</>نَا سُبُلَنَا ۚ وَلَنَصْبِرَ<g>نَّ</> عَلَىٰ <o>مَآ</> ءَاذَيْتُمُونَا ۚ وَعَلَى <h>ٱ</>للَّهِ فَلْيَتَوَكَّلِ <h>ٱ</>لْمُتَوَكِّ<p>لُو</>نَ"},{"n":13,"w":[["وَقَالَ","waqāla","And said","এবং বলেছিলো"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieved","অস্বীকার করেছিলো"],["لِرُسُلِهِمْ","lirusulihim","to their Messengers","তাদের রাসূলদের"],["لَنُخْرِجَنَّكُم","lanukh'rijannakum","Surely we will drive you out","তোমাদের অবশ্যই বের করবোই"],["مِّنْ","min","of","থেকে"],["أَرْضِنَآ","arḍinā","our land","আমাদের দেশ"],["أَوْ","aw","or","অথবা"],["لَتَعُودُنَّ","lata‘ūdunna","surely you should return","তোমরা অবশ্যই ফিরে আসবে"],["فِى","fī","to","মধ্যে"],["مِلَّتِنَا ۖ","millatinā","our religion","আমাদের ধর্মমতে\""],["فَأَوْحَىٰٓ","fa-awḥā","So inspired","অতঃপর ওহী করলেন"],["إِلَيْهِمْ","ilayhim","to them","তাদের প্রতি"],["رَبُّهُمْ","rabbuhum","their Lord","তাদের রব"],["لَنُهْلِكَنَّ","lanuh'likanna","We will surely destroy","\"আমরা অবশ্যই ধ্বংস করবোই"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","সীমালঙ্ঘনকারীদের"]],"t":"وَقَالَ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> لِرُسُلِهِمْ لَنُخْرِجَ<g>نَّ</><y>كُم مِّ</>نْ أَرْضِ<o>نَآ</> أَوْ لَتَعُودُ<g>نَّ</> فِى مِلَّتِنَا ۖ فَأَوْحَ<o>ىٰٓ</> إِلَيْهِمْ رَبُّهُمْ لَنُهْلِكَ<g>نَّ</> <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":14,"w":[["وَلَنُسْكِنَنَّكُمُ","walanus'kinannakumu","And surely We will make you dwell","এবং তোমাদেরকে অবশ্যই আমরা প্রতিষ্ঠিত করবোই"],["ٱلْأَرْضَ","l-arḍa","(in) the land","দেশে"],["مِنۢ","min","after them","থেকে"],["بَعْدِهِمْ ۚ","ba‘dihim","after them","তাদের পর"],["ذَٰلِكَ","dhālika","That","এটা"],["لِمَنْ","liman","(is) for whoever","(তার) জন্যে যে"],["خَافَ","khāfa","fears","ভয় করে"],["مَقَامِى","maqāmī","standing before Me","আমার সামনে দাঁড়াতে"],["وَخَافَ","wakhāfa","and fears","ও ভয় করে"],["وَعِيدِ","wa‘īdi","My Threat","আমার শাস্তির\""]],"t":"وَلَنُسْكِنَ<g>نَّ</>كُمُ <h>ٱ</>لْأَرْضَ <i>مِنۢ بَ</>عْدِهِمْ ۚ <m>ذَٰ</>لِكَ لِمَنْ خَافَ مَقَامِى وَخَافَ وَ<p>عِي</><q>دِ</>"},{"n":15,"w":[["وَٱسْتَفْتَحُوا۟","wa-is'taftaḥū","And they sought victory","এবং তারা জয়ী হয়ে চাইলো"],["وَخَابَ","wakhāba","and disappointed","কিন্তু ব্যর্থ হলো"],["كُلُّ","kullu","every","প্রত্যেক"],["جَبَّارٍ","jabbārin","tyrant","উদ্ধত"],["عَنِيدٍۢ","‘anīdin","obstinate","স্বৈরাচারী (সত্যের দুশমন)"]],"t":"وَ<h>ٱ</>سْتَفْتَحُو<s>ا۟</> وَخَابَ كُلُّ جَبَّارٍ عَ<p>نِي</><q>دٍۢ</>"},{"n":16,"w":[["مِّن","min","of him","থেকে"],["وَرَآئِهِۦ","warāihi","Ahead","তার পিছন (রয়েছে)"],["جَهَنَّمُ","jahannamu","(is) Hell","জাহান্নাম"],["وَيُسْقَىٰ","wayus'qā","and he will be made to drink","এবং পান করানো হবে"],["مِن","min","of","থেকে"],["مَّآءٍۢ","māin","water","পানি"],["صَدِيدٍۢ","ṣadīdin","purulent","গলিত পুঁজের"]],"t":"<d>مِّن وَ</><o>رَآ</>ئِ<m>هِۦ</> جَهَ<g>نَّ</>مُ وَيُسْقَىٰ <d>مِن مَّ</><o>آ</><k>ءٍۢ صَ</><p>دِي</><q>دٍۢ</>"},{"n":17,"w":[["يَتَجَرَّعُهُۥ","yatajarra‘uhu","He will sip it","তা সে ঢোক গিলবে"],["وَلَا","walā","but not","অথচ না"],["يَكَادُ","yakādu","he will be near","প্রায় সম্ভব হবে"],["يُسِيغُهُۥ","yusīghuhu","(to) swallowing it","তা গেলা"],["وَيَأْتِيهِ","wayatīhi","And will come to him","এবং তার কাছে আসবে"],["ٱلْمَوْتُ","l-mawtu","the death","মৃত্যু(যন্ত্রণা)"],["مِن","min","from","থেকে"],["كُلِّ","kulli","every","প্রত্যেক"],["مَكَانٍۢ","makānin","side","জায়গা (দিক)"],["وَمَا","wamā","but not","কিন্তু না"],["هُوَ","huwa","he","সে (হবে)"],["بِمَيِّتٍۢ ۖ","bimayyitin","will die","মৃত"],["وَمِن","wamin","And ahead of him","এবং থেকে"],["وَرَآئِهِۦ","warāihi","And ahead of him","তার পিছন"],["عَذَابٌ","‘adhābun","(is) a punishment","শাস্তি"],["غَلِيظٌۭ","ghalīẓun","harsh","কঠোর"]],"t":"يَتَجَرَّعُهُ<m>ۥ</> وَلَا يَكَادُ يُسِيغُهُ<m>ۥ</> وَيَأْتِيهِ <h>ٱ</>لْمَوْتُ مِ<k>ن كُ</>لِّ مَكَا<d>نٍۢ وَ</>مَا هُوَ بِمَيِّ<d>تٍۢ ۖ وَمِن وَ</><o>رَآ</>ئِ<m>هِۦ</> عَذَابٌ غَ<p>لِي</>ظٌۭ"},{"n":18,"w":[["مَّثَلُ","mathalu","(The) example","দৃষ্টান্ত"],["ٱلَّذِينَ","alladhīna","(of) those who","যারা (তাদের)"],["كَفَرُوا۟","kafarū","disbelieve","অস্বীকার করেছে"],["بِرَبِّهِمْ ۖ","birabbihim","in their Lord","তাদের রবের সাথে"],["أَعْمَـٰلُهُمْ","a‘māluhum","their deeds","তাদের কাজসমূহ"],["كَرَمَادٍ","karamādin","(are) like ashes","মতো ছাইভস্মের"],["ٱشْتَدَّتْ","ish'taddat","blows furiously","প্রচন্ড চলে"],["بِهِ","bihi","on it","তার সাথে"],["ٱلرِّيحُ","l-rīḥu","the wind","বাতাস"],["فِى","fī","in","মধ্যে"],["يَوْمٍ","yawmin","a day","দিনের"],["عَاصِفٍۢ ۖ","‘āṣifin","stormy","ঝড়ের"],["لَّا","lā","No","না"],["يَقْدِرُونَ","yaqdirūna","control (they have)","তারা সমর্থ হবে"],["مِمَّا","mimmā","of what","তা হ'তে যা"],["كَسَبُوا۟","kasabū","they have earned","তারা উপার্জন করেছে"],["عَلَىٰ","‘alā","on","উপর"],["شَىْءٍۢ ۚ","shayin","anything","কিছুর"],["ذَٰلِكَ","dhālika","That","এটা"],["هُوَ","huwa","[it]","সেই"],["ٱلضَّلَـٰلُ","l-ḍalālu","(is) the straying","বিভ্রান্তি"],["ٱلْبَعِيدُ","l-ba‘īdu","far","দূরের"]],"t":"مَّثَلُ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> بِرَبِّهِمْ ۖ أَعْ<m>مَٰ</>لُهُمْ كَرَمَادٍ <h>ٱ</>شْتَدَّتْ بِهِ <h>ٱ</><l>ل</>رِّيحُ فِى يَوْمٍ عَاصِ<w>فٍۢ ۖ لَّ</>ا يَ<q>قْ</>دِرُونَ مِ<g>مَّ</>ا كَسَبُو<s>ا۟</> عَلَىٰ <k>شَىْءٍۢ ۚ ذَٰ</>لِكَ هُوَ <h>ٱ</><l>ل</>ضَّ<m>لَٰ</>لُ <h>ٱ</>لْبَ<p>عِي</><q>دُ</>"},{"n":19,"w":[["أَلَمْ","alam","Do not","নি কি"],["تَرَ","tara","you see","তুমি দেখো"],["أَنَّ","anna","that","যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["خَلَقَ","khalaqa","created","সৃষ্টি করেছেন"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশমন্ডলী"],["وَٱلْأَرْضَ","wal-arḍa","and the earth","ও পৃথিবী"],["بِٱلْحَقِّ ۚ","bil-ḥaqi","in truth","সাথে যথার্থতার"],["إِن","in","If","যদি"],["يَشَأْ","yasha","He wills","তিনি ইচ্ছে করেন"],["يُذْهِبْكُمْ","yudh'hib'kum","He can remove you","তোমাদের নিয়ে যাবেন"],["وَيَأْتِ","wayati","and bring","ও আসবেন"],["بِخَلْقٍۢ","bikhalqin","a creation","নিয়ে সৃষ্টি"],["جَدِيدٍۢ","jadīdin","new","নয়া"]],"t":"أَلَمْ تَرَ أَ<g>نَّ</> <h>ٱ</>للَّهَ خَلَقَ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضَ بِ<h>ٱ</>لْحَقِّ ۚ <d>إِن يَ</>شَأْ يُذْهِ<q>بْ</>كُمْ وَيَأْتِ بِخَلْ<k>قٍۢ جَ</><p>دِي</><q>دٍۢ</>"},{"n":20,"w":[["وَمَا","wamā","And not","এবং নয়"],["ذَٰلِكَ","dhālika","(is) that","এটা"],["عَلَى","‘alā","on","উপর"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["بِعَزِيزٍۢ","bi‘azīzin","great","কঠিন"]],"t":"وَمَا <m>ذَٰ</>لِكَ عَلَى <h>ٱ</>للَّهِ بِعَ<p>زِي</>زٍۢ"},{"n":21,"w":[["وَبَرَزُوا۟","wabarazū","And they will come forth","এবং তারা উপস্থিত হবে (উন্মোচিত হবে)"],["لِلَّهِ","lillahi","before Allah","আল্লাহর কাছে"],["جَمِيعًۭا","jamī‘an","all together","সকলে"],["فَقَالَ","faqāla","then will say","অতঃপর বলবে"],["ٱلضُّعَفَـٰٓؤُا۟","l-ḍu‘afāu","the weak","দুর্বলেরা"],["لِلَّذِينَ","lilladhīna","to those who","তাদেরকে যারা"],["ٱسْتَكْبَرُوٓا۟","is'takbarū","were arrogant","অহংকার করতো"],["إِنَّا","innā","Indeed we","\"আমরা নিশ্চয়ই"],["كُنَّا","kunnā","we were","ছিলাম"],["لَكُمْ","lakum","your","তোমাদের জন্যে"],["تَبَعًۭا","taba‘an","followers","অধীন"],["فَهَلْ","fahal","so can","তাহ'লে কি"],["أَنتُم","antum","you (be)","তোমরা"],["مُّغْنُونَ","mugh'nūna","the one who avails","রক্ষাকারী হবে (বাঁচাতে)"],["عَنَّا","‘annā","us","আমাদেরকে"],["مِنْ","min","from","থেকে"],["عَذَابِ","‘adhābi","(the) punishment","শাস্তি"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["مِن","min","anything","কোনো\""],["شَىْءٍۢ ۚ","shayin","anything","কিছু\""],["قَالُوا۟","qālū","They will say","তারা বলবে"],["لَوْ","law","If","\"যদি"],["هَدَىٰنَا","hadānā","Allah had guided us","আমাদের সৎ পথ দেখাতেন"],["ٱللَّهُ","l-lahu","Allah had guided us","আল্লাহ"],["لَهَدَيْنَـٰكُمْ ۖ","lahadaynākum","surely we would have guided you","অবশ্যই তোমাদের আমরা পথ দেখাতাম"],["سَوَآءٌ","sawāon","(It is) same","সমান"],["عَلَيْنَآ","‘alaynā","for us","আমাদের জন্যে"],["أَجَزِعْنَآ","ajazi‘'nā","whether we show intolerance","আমরা ধৈর্য্যচ্যুত হই"],["أَمْ","am","or","বা"],["صَبَرْنَا","ṣabarnā","we are patient","আমরা ধৈর্য্য ধরি"],["مَا","mā","not","নেই"],["لَنَا","lanā","(is) for us","আমাদের জন্যে"],["مِن","min","any","কোনো"],["مَّحِيصٍۢ","maḥīṣin","place of escape","পালানোর জায়গা\""]],"t":"وَبَرَزُو<s>ا۟</> لِلَّهِ جَمِي<k>عًۭا فَ</>قَالَ <h>ٱ</><l>ل</>ضُّعَ<o>فَٰٓ</>ؤُ<s>ا۟</> لِلَّذِينَ <h>ٱ</>سْتَكْبَ<o>رُوٓ</><s>ا۟</> إِ<g>نَّ</>ا كُ<g>نَّ</>ا لَكُمْ تَبَ<k>عًۭا فَ</>هَلْ أَ<k>نتُ</><y>م مُّ</>غْنُونَ عَ<g>نَّ</>ا مِنْ عَذَابِ <h>ٱ</>للَّهِ مِ<k>ن شَىْءٍۢ ۚ قَ</>الُو<s>ا۟</> لَوْ هَدَ<m>ىٰ</>نَا <h>ٱ</>للَّهُ لَهَدَيْ<m>نَٰ</>كُمْ ۖ سَ<o>وَآ</>ءٌ عَلَيْ<o>نَآ</> أَجَزِعْ<o>نَآ</> أَمْ صَبَرْنَا مَا لَنَا <d>مِن مَّ</><p>حِي</>صٍۢ"},{"n":22,"w":[["وَقَالَ","waqāla","And will say","এবং বলবে"],["ٱلشَّيْطَـٰنُ","l-shayṭānu","the Shaitaan","শয়তান"],["لَمَّا","lammā","when","যখন"],["قُضِىَ","quḍiya","has been decided","মীমাংসা হয়ে যাবে"],["ٱلْأَمْرُ","l-amru","the matter","বিষয়টির"],["إِنَّ","inna","Indeed","\"নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["وَعَدَكُمْ","wa‘adakum","promised you","প্রতিশ্রুতি দিয়েছিলেন তোমাদের"],["وَعْدَ","wa‘da","a promise","প্রতিশ্রুতি"],["ٱلْحَقِّ","l-ḥaqi","(of) truth","সত্য"],["وَوَعَدتُّكُمْ","wawa‘adttukum","And I promised you","এবং আমি প্রতিশ্রুতি দিয়েছিলাম তোমাদের"],["فَأَخْلَفْتُكُمْ ۖ","fa-akhlaftukum","but I betrayed you","কিন্তু আমি প্রতিশ্রুতি ভঙ্গ করেছি তোমাদের"],["وَمَا","wamā","But not","এবং না"],["كَانَ","kāna","I had","ছিলো"],["لِىَ","liya","I had","আমার জন্যে"],["عَلَيْكُم","‘alaykum","over you","তোমাদের উপর"],["مِّن","min","any","কোনো"],["سُلْطَـٰنٍ","sul'ṭānin","authority","কর্তৃত্ব"],["إِلَّآ","illā","except","এছাড়া"],["أَن","an","that","যে"],["دَعَوْتُكُمْ","da‘awtukum","I invited you","আমি ডেকেছিলাম তোমাদের"],["فَٱسْتَجَبْتُمْ","fa-is'tajabtum","and you responded","তখন সাড়া দিয়েছিলে তোমরা"],["لِى ۖ","lī","to me","আমার জন্যে"],["فَلَا","falā","So (do) not","সুতরাং না"],["تَلُومُونِى","talūmūnī","blame me","তোমরা তিরস্কার করো আমাকে"],["وَلُومُوٓا۟","walūmū","but blame","তবে তোমরা তিরস্কার করো"],["أَنفُسَكُم ۖ","anfusakum","yourselves","তোমাদের নিজেদেরকে"],["مَّآ","mā","Not","নই"],["أَنَا۠","anā","(can) I","আমি"],["بِمُصْرِخِكُمْ","bimuṣ'rikhikum","(be) your helper","উদ্ধারকারী তোমাদের"],["وَمَآ","wamā","and not","এবং নও"],["أَنتُم","antum","you (can)","তোমরা"],["بِمُصْرِخِىَّ ۖ","bimuṣ'rikhiyya","(be) my helper","উদ্ধারকারী আমার"],["إِنِّى","innī","Indeed, I","নিশ্চয়ই আমি"],["كَفَرْتُ","kafartu","deny","অস্বীকার করছি"],["بِمَآ","bimā","[of what]","ঐ বিষয়ে যা"],["أَشْرَكْتُمُونِ","ashraktumūni","your association of me (with Allah)","আমাকেে তোমরা শরীক করেছো"],["مِن","min","before","থেকে"],["قَبْلُ ۗ","qablu","before","পূর্ব"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","সীমালঙ্ঘনকারীদের"],["لَهُمْ","lahum","for them","তাদের জন্যে আছে"],["عَذَابٌ","‘adhābun","(is) a punishment","শাস্তি"],["أَلِيمٌۭ","alīmun","painful","নিদারুণ\""]],"t":"وَقَالَ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نُ لَ<g>مَّ</>ا قُضِىَ <h>ٱ</>لْأَمْرُ إِ<g>نَّ</> <h>ٱ</>للَّهَ وَعَدَكُمْ وَعْدَ <h>ٱ</>لْحَقِّ وَوَعَ<j>د</>تُّكُمْ فَأَخْلَفْتُكُمْ ۖ وَمَا كَانَ لِىَ عَلَيْ<y>كُم مِّ</><k>ن سُ</>لْ<m>طَٰ</>نٍ إِ<o>لَّآ</> أَ<k>ن دَ</>عَوْتُكُمْ فَ<h>ٱ</>سْتَجَ<q>بْ</>تُمْ لِى ۖ فَلَا تَلُومُونِى وَلُو<o>مُوٓ</><s>ا۟</> أَ<k>نفُ</>سَ<y>كُم ۖ مَّ</><o>آ</> أَنَا۠ بِمُصْرِخِكُمْ وَ<o>مَآ</> أَ<k>نتُ</><f>م بِ</>مُصْرِخِىَّ ۖ إِ<g>نِّ</>ى كَفَرْتُ بِ<o>مَآ</> أَشْرَكْتُمُونِ مِ<k>ن قَ</><q>بْ</>لُ ۗ إِ<g>نَّ</> <h>ٱ</><l>ل</><m>ظَّٰ</>لِمِينَ لَهُمْ عَذَابٌ أَ<p>لِي</>مٌۭ"},{"n":23,"w":[["وَأُدْخِلَ","wa-ud'khila","And will be admitted","এবং প্রবেশ করানো হবে"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["ءَامَنُوا۟","āmanū","believed","ঈমান এনেছে"],["وَعَمِلُوا۟","wa‘amilū","and did","ও কাজ করেছে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","righteous deeds","সৎ"],["جَنَّـٰتٍۢ","jannātin","(to) Gardens","জান্নাতে"],["تَجْرِى","tajrī","flows","প্রবাহিত হয়"],["مِن","min","from","থেকে"],["تَحْتِهَا","taḥtihā","underneath it","তার নিচ"],["ٱلْأَنْهَـٰرُ","l-anhāru","the rivers","ঝর্ণাসমূহ"],["خَـٰلِدِينَ","khālidīna","(will) abide forever","তারা স্থায়ী হবে"],["فِيهَا","fīhā","in it","মধ্যে তার"],["بِإِذْنِ","bi-idh'ni","by the permission","অনুমতিক্রমে"],["رَبِّهِمْ ۖ","rabbihim","(of) their Lord","তাদের রবের"],["تَحِيَّتُهُمْ","taḥiyyatuhum","their greetings","তাদের অভিবাদন হবে"],["فِيهَا","fīhā","therein","তার মধ্যে"],["سَلَـٰمٌ","salāmun","(will be) peace","সালাম"]],"t":"وَأُ<q>دْ</>خِلَ <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ جَ<g>نَّٰ</><k>تٍۢ تَ</><q>جْ</>رِى مِ<k>ن تَ</>حْتِهَا <h>ٱ</>لْأَنْ<m>هَٰ</>رُ <m>خَٰ</>لِدِينَ فِيهَا بِإِذْنِ رَبِّهِمْ ۖ تَحِيَّتُهُمْ فِيهَا سَ<p>لَٰ</>مٌ"},{"n":24,"w":[["أَلَمْ","alam","Do not","নি কি"],["تَرَ","tara","you see","তুমি লক্ষ্য করো"],["كَيْفَ","kayfa","how","কিভাবে"],["ضَرَبَ","ḍaraba","Allah sets forth","বর্ণনা করেছেন"],["ٱللَّهُ","l-lahu","Allah sets forth","আল্লাহ"],["مَثَلًۭا","mathalan","the example","উপমা"],["كَلِمَةًۭ","kalimatan","a word","বাক্য (কালেমা তাইয়েবা)"],["طَيِّبَةًۭ","ṭayyibatan","good","পবিত্র"],["كَشَجَرَةٍۢ","kashajaratin","(is) like a tree","(তা) একটি গাছের মতো"],["طَيِّبَةٍ","ṭayyibatin","good","(যা) পবিত্র"],["أَصْلُهَا","aṣluhā","its root","তার মূল (শেকড়)"],["ثَابِتٌۭ","thābitun","(is) firm","সুদৃঢ়"],["وَفَرْعُهَا","wafar‘uhā","and its branches","ও তার শাখাগুলো (ডালপালা)"],["فِى","fī","(are) in","থাকে"],["ٱلسَّمَآءِ","l-samāi","the sky","উপরে (বিস্তৃত)"]],"t":"أَلَمْ تَرَ كَيْفَ ضَرَبَ <h>ٱ</>للَّهُ مَثَلًۭ<k>ا كَ</>لِمَ<k>ةًۭ طَ</>يِّبَ<k>ةًۭ كَ</>شَجَرَ<k>ةٍۢ طَ</>يِّبَةٍ أَصْلُهَا ثَابِ<d>تٌۭ وَ</>فَرْعُهَا فِى <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ"},{"n":25,"w":[["تُؤْتِىٓ","tu'tī","Giving","দেয়"],["أُكُلَهَا","ukulahā","its fruit","তার ফল"],["كُلَّ","kulla","all","প্রত্যেক"],["حِينٍۭ","ḥīnin","time","মুহূর্তে (মৌসুমে)"],["بِإِذْنِ","bi-idh'ni","by the permission","অনুমতিক্রমে"],["رَبِّهَا ۗ","rabbihā","of its Lord","রবের তার"],["وَيَضْرِبُ","wayaḍribu","And Allah sets forth","এবং বর্ণনা করেন"],["ٱللَّهُ","l-lahu","And Allah sets forth","আল্লাহ"],["ٱلْأَمْثَالَ","l-amthāla","the examples","দৃষ্টান্তসমূহ"],["لِلنَّاسِ","lilnnāsi","for mankind","মানুষের জন্যে"],["لَعَلَّهُمْ","la‘allahum","so that they may","তারা যাতে"],["يَتَذَكَّرُونَ","yatadhakkarūna","remember","শিক্ষা গ্রহণ করে"]],"t":"تُؤْ<o>تِىٓ</> أُكُلَهَا كُلَّ حِي<i>نٍۭ بِ</>إِذْنِ رَبِّهَا ۗ وَيَضْرِبُ <h>ٱ</>للَّهُ <h>ٱ</>لْأَمْثَالَ لِل<g>نَّ</>اسِ لَعَلَّهُمْ يَتَذَكَّ<p>رُو</>نَ"},{"n":26,"w":[["وَمَثَلُ","wamathalu","And (the) example","এবং উপমা"],["كَلِمَةٍ","kalimatin","(of) a word","বাক্যের"],["خَبِيثَةٍۢ","khabīthatin","evil","নোংরা (অসার)"],["كَشَجَرَةٍ","kashajaratin","(is) like a tree","মতো (তা) একটি গাছের"],["خَبِيثَةٍ","khabīthatin","evil","নোংরা (অসার)"],["ٱجْتُثَّتْ","uj'tuthat","uprooted","উপড়ে নেয়া হয়েছে"],["مِن","min","from","থেকে"],["فَوْقِ","fawqi","the surface","উপর"],["ٱلْأَرْضِ","l-arḍi","(of) the earth","মাটির"],["مَا","mā","not","নেই"],["لَهَا","lahā","for it","তার জন্যে"],["مِن","min","(is) any","কোনো"],["قَرَارٍۢ","qarārin","stability","স্থিতি"]],"t":"وَمَثَلُ كَلِمَةٍ خَبِيثَ<k>ةٍۢ كَ</>شَجَرَةٍ خَبِيثَةٍ <h>ٱ</><q>جْ</>تُثَّتْ مِ<k>ن فَ</>وْقِ <h>ٱ</>لْأَرْضِ مَا لَهَا مِ<k>ن قَ</><p>رَا</>رٍۢ"},{"n":27,"w":[["يُثَبِّتُ","yuthabbitu","Allah keeps firm","প্রতিষ্ঠিত করেন"],["ٱللَّهُ","l-lahu","Allah keeps firm","আল্লাহ"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["بِٱلْقَوْلِ","bil-qawli","with the firm word","দিয়ে বাণী"],["ٱلثَّابِتِ","l-thābiti","with the firm word","সুদৃঢ়"],["فِى","fī","in","মধ্যে"],["ٱلْحَيَوٰةِ","l-ḥayati","the life","জীবনের"],["ٱلدُّنْيَا","l-dun'yā","(of) the world","পার্থিব"],["وَفِى","wafī","and in","এবং মধ্যে"],["ٱلْـَٔاخِرَةِ ۖ","l-ākhirati","the Hereafter","আখিরাতের"],["وَيُضِلُّ","wayuḍillu","And Allah lets go astray","এবং পথভ্রষ্ট করেন"],["ٱللَّهُ","l-lahu","And Allah lets go astray","আল্লাহ"],["ٱلظَّـٰلِمِينَ ۚ","l-ẓālimīna","the wrongdoers","সীমালঙ্ঘনকারীদের"],["وَيَفْعَلُ","wayaf‘alu","And Allah does","ও করেন"],["ٱللَّهُ","l-lahu","And Allah does","আল্লাহ"],["مَا","mā","what","যা"],["يَشَآءُ","yashāu","He wills","তিনি ইচ্ছে করেন"]],"t":