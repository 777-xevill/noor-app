{"n":70,"a":[{"n":1,"w":[["سَأَلَ","sa-ala","Asked","জিজ্ঞাসা করল"],["سَآئِلٌۢ","sāilun","a questioner","এক প্রশ্নকারী"],["بِعَذَابٍۢ","bi‘adhābin","about a punishment","এমন আযাব সম্পর্কে"],["وَاقِعٍۢ","wāqi‘in","bound to happen","যা আপতিত হবে"]],"t":"سَأَلَ <o>سَآ</>ئِ<i>لٌۢ بِ</>عَذَا<d>بٍۢ وَ</>اقِعٍۢ"},{"n":2,"w":[["لِّلْكَـٰفِرِينَ","lil'kāfirīna","To the disbelievers","কাফিরদের উপর,"],["لَيْسَ","laysa","not","নেই"],["لَهُۥ","lahu","of it","তার"],["دَافِعٌۭ","dāfi‘un","any preventer","কোন প্রতিরোধকারী"]],"t":"لِّلْ<m>كَٰ</>فِرِينَ لَيْسَ لَهُ<m>ۥ</> دَافِعٌۭ"},{"n":3,"w":[["مِّنَ","mina","From","থেকে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ,"],["ذِى","dhī","Owner","মালিক"],["ٱلْمَعَارِجِ","l-ma‘āriji","(of) the ways of ascent","ঊর্ধ্বারোহণের সোপানসমূহের অধিকারী"]],"t":"مِّنَ <h>ٱ</>للَّهِ ذِى <h>ٱ</>لْمَعَارِ<q>جِ</>"},{"n":4,"w":[["تَعْرُجُ","ta‘ruju","Ascend","চড়ে"],["ٱلْمَلَـٰٓئِكَةُ","l-malāikatu","the Angels","ফেরেশতাগণ"],["وَٱلرُّوحُ","wal-rūḥu","and the Spirit","ও রূহ(জিবরাঈল)"],["إِلَيْهِ","ilayhi","to Him","তাকে"],["فِى","fī","in","মধ্যে"],["يَوْمٍۢ","yawmin","a Day","একদিনের"],["كَانَ","kāna","[is]","[হয়]"],["مِقْدَارُهُۥ","miq'dāruhu","its measure","তার পরিমাপ"],["خَمْسِينَ","khamsīna","(is) fifty","পঞ্চাশ (হয়)"],["أَلْفَ","alfa","thousand","হাজার"],["سَنَةٍۢ","sanatin","year(s)","বছর"]],"t":"تَعْرُجُ <h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةُ وَ<h>ٱ</><l>ل</>رُّوحُ إِلَيْهِ فِى يَوْ<k>مٍۢ كَ</>انَ مِ<q>قْ</>دَارُهُ<m>ۥ</> خَمْسِينَ أَلْفَ سَنَةٍۢ"},{"n":5,"w":[["فَٱصْبِرْ","fa-iṣ'bir","So be patient","সুতরাং, ধৈর্য ধরুন"],["صَبْرًۭا","ṣabran","a patience","ধৈর্য"],["جَمِيلًا","jamīlan","good","উত্তম"]],"t":"فَ<h>ٱ</>صْبِرْ صَ<q>بْ</><k>رًۭا جَ</>مِيلًا"},{"n":6,"w":[["إِنَّهُمْ","innahum","Indeed, they","তারা নিশ্চয়"],["يَرَوْنَهُۥ","yarawnahu","see it","তা দেখে"],["بَعِيدًۭا","ba‘īdan","(as) far off","বহুদূরে"]],"t":"إِ<g>نَّ</>هُمْ يَرَوْنَهُ<m>ۥ</> بَعِيدًۭا"},{"n":7,"w":[["وَنَرَىٰهُ","wanarāhu","But We see it","কিন্তু আমরা তা দেখেছি"],["قَرِيبًۭا","qarīban","near","নিকটে"]],"t":"وَنَرَ<m>ىٰ</>هُ قَرِيبًۭا"},{"n":8,"w":[["يَوْمَ","yawma","(The) Day ","সেদিন"],["تَكُونُ","takūnu","will be","হবে"],["ٱلسَّمَآءُ","l-samāu","the sky","আকাশ"],["كَٱلْمُهْلِ","kal-muh'li","like molten copper","গলিত ধাতুর মত,"]],"t":"يَوْمَ تَكُونُ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءُ كَ<h>ٱ</>لْمُهْلِ"},{"n":9,"w":[["وَتَكُونُ","watakūnu","And will be","এবং হবে"],["ٱلْجِبَالُ","l-jibālu","the mountains","পর্বতসমূহ"],["كَٱلْعِهْنِ","kal-‘ih'ni","like wool","রঙিন পশমের মত,"]],"t":"وَتَكُونُ <h>ٱ</>لْجِبَالُ كَ<h>ٱ</>لْعِهْنِ"},{"n":10,"w":[["وَلَا","walā","And not","এবং না"],["يَسْـَٔلُ","yasalu","will ask","জিজ্ঞাসা করবে"],["حَمِيمٌ","ḥamīmun","a friend","কোন বন্ধু"],["حَمِيمًۭا","ḥamīman","(about) a friend","বন্ধুকে"]],"t":"وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيمًۭا"},{"n":11,"w":[["يُبَصَّرُونَهُمْ ۚ","yubaṣṣarūnahum","They will be made to see each other","তাদেরকে দেখানো হবে"],["يَوَدُّ","yawaddu","Would wish","ইচ্ছা করবে"],["ٱلْمُجْرِمُ","l-muj'rimu","the criminal","অপরাধী"],["لَوْ","law","if","যদি"],["يَفْتَدِى","yaftadī","he (could be) ransomed","মুক্তিপন দিতে পারত"],["مِنْ","min","from","থেকে"],["عَذَابِ","‘adhābi","(the) punishment","আযাব"],["يَوْمِئِذٍۭ","yawmi-idhin","(of) that Day","সেদিন"],["بِبَنِيهِ","bibanīhi","by his children","তার সন্তানদের দ্বারা"]],"t":"يُبَصَّرُونَهُمْ ۚ يَوَدُّ <h>ٱ</>لْمُ<q>جْ</>رِمُ لَوْ يَفْتَدِى مِنْ عَذَابِ يَوْمِئِ<i>ذٍۭ بِ</>بَ<p>نِي</>هِ"},{"n":12,"w":[["وَصَـٰحِبَتِهِۦ","waṣāḥibatihi","And his spouse","এবং তার স্ত্রী"],["وَأَخِيهِ","wa-akhīhi","and his brother","এবং তার ভাই,"]],"t":"وَ<m>صَٰ</>حِبَتِ<m>هِۦ</> وَأَ<p>خِي</>هِ"},{"n":13,"w":[["وَفَصِيلَتِهِ","wafaṣīlatihi","And his nearest kindred","আর তার জ্ঞাতি-গোষ্ঠীকে"],["ٱلَّتِى","allatī","who","যা"],["تُـْٔوِيهِ","tu'wīhi","sheltered him","তাকে আশ্রয় দেয়"]],"t":"وَفَصِيلَتِهِ <h>ٱ</>لَّتِى تُـْٔ<p>وِي</>هِ"},{"n":14,"w":[["وَمَن","waman","And whoever","এবং যা"],["فِى","fī","(is) on","মধ্যে্"],["ٱلْأَرْضِ","l-arḍi","the earth","যমীনের"],["جَمِيعًۭا","jamī‘an","all","সবকিছুই"],["ثُمَّ","thumma","then","তারপর"],["يُنجِيهِ","yunjīhi","it (could) save him","তাকে মুক্তি দিত"]],"t":"وَمَ<k>ن فِ</>ى <h>ٱ</>لْأَرْضِ جَمِي<k>عًۭا ثُ</><g>مَّ</> يُ<k>نجِ</><p>ي</>هِ"},{"n":15,"w":[["كَلَّآ ۖ","kallā","By no means","অবশ্যই নহে!"],["إِنَّهَا","innahā","Indeed, it (is)","নিশ্চয় তা"],["لَظَىٰ","laẓā","surely a Flame of Hell","লেলিহান আগুন"]],"t":"كَ<o>لَّآ ۖ</> إِ<g>نَّ</>هَا لَظَىٰ"},{"n":16,"w":[["نَزَّاعَةًۭ","nazzā‘atan","A remover","লেহনকারী"],["لِّلشَّوَىٰ","lilshawā","of the skin of the head","চামড়াকে"]],"t":"نَزَّاعَ<w>ةًۭ لِّ</>لشَّوَىٰ"},{"n":17,"w":[["تَدْعُوا۟","tad‘ū","Inviting","আহবান করে"],["مَنْ","man","(him) who","যে"],["أَدْبَرَ","adbara","turned his back","পিঠ প্রদর্শন করে"],["وَتَوَلَّىٰ","watawallā","and went away","ও মুখ ফিরিয়ে"]],"t":"تَ<q>دْ</>عُو<s>ا۟</> مَنْ أَ<q>دْ</>بَرَ وَتَوَلَّىٰ"},{"n":18,"w":[["وَجَمَعَ","wajama‘a","And collected","এবং জমা করেছে"],["فَأَوْعَىٰٓ","fa-aw‘ā","and hoarded","অতঃপর তা সংরক্ষিত রেখেছে"]],"t":"وَجَمَعَ فَأَوْعَىٰٓ"},{"n":19,"w":[["۞ إِنَّ","inna","Indeed","নিশ্চয়"],["ٱلْإِنسَـٰنَ","l-insāna","the man","মানুষকে"],["خُلِقَ","khuliqa","was created","সৃষ্টি করা হয়েছে"],["هَلُوعًا","halū‘an","anxious ","অস্থির"]],"t":"۞ إِ<g>نَّ</> <h>ٱ</>لْإِ<k>نسَٰ</>نَ خُلِقَ هَلُوعًا"},{"n":20,"w":[["إِذَا","idhā","When","কখন"],["مَسَّهُ","massahu","touches him","তাকে স্পর্শ করে"],["ٱلشَّرُّ","l-sharu","the evil","মন্দ,"],["جَزُوعًۭا","jazū‘an","distressed","দুর্দশাগ্রস্ত."]],"t":"إِذَا مَسَّهُ <h>ٱ</><l>ل</>شَّرُّ جَزُوعًۭا"},{"n":21,"w":[["وَإِذَا","wa-idhā","And when","এবং কখন"],["مَسَّهُ","massahu","touches him","তাকে স্পর্শ করে"],["ٱلْخَيْرُ","l-khayru","the good","কল্যাণ"],["مَنُوعًا","manū‘an","withholding","কৃপণ হয়"]],"t":"وَإِذَا مَسَّهُ <h>ٱ</>لْخَيْرُ مَنُوعًا"},{"n":22,"w":[["إِلَّا","illā","Except","ছাড়া"],["ٱلْمُصَلِّينَ","l-muṣalīna","those who pray ","নামাযিরা"]],"t":"إِلَّا <h>ٱ</>لْمُصَ<p>لِّي</>نَ"},{"n":23,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["هُمْ","hum","[t