َ<k>نتَ</>قِمُ <h>ٱ</>للَّهُ مِنْهُ ۗ وَ<h>ٱ</>للَّهُ عَزِي<k>زٌۭ ذُ</>و <h>ٱ</><k>نتِ</><p>قَا</>مٍ"},{"n":96,"w":[["أُحِلَّ","uḥilla","Is made lawful","বৈধ করা হয়েছে"],["لَكُمْ","lakum","for you","জন্যে তোমাদের"],["صَيْدُ","ṣaydu","game","শিকার"],["ٱلْبَحْرِ","l-baḥri","(of) the sea","সাগরের"],["وَطَعَامُهُۥ","waṭa‘āmuhu","and its food","ও খাওয়া তা"],["مَتَـٰعًۭا","matā‘an","(as) provision","ভোগ্যবস্তু হিসেবে (বৈধ)"],["لَّكُمْ","lakum","for you","জন্যে তোমাদের"],["وَلِلسَّيَّارَةِ ۖ","walilssayyārati","and for the travelers","এবং জন্যেও পর্যটকদের"],["وَحُرِّمَ","waḥurrima","and is made unlawful","কিন্তু নিষিদ্ধ করা হয়েছে"],["عَلَيْكُمْ","‘alaykum","on you","উপর তোমাদের"],["صَيْدُ","ṣaydu","game","শিকার"],["ٱلْبَرِّ","l-bari","(of) the land","ডাঙার"],["مَا","mā","as","যতক্ষণ"],["دُمْتُمْ","dum'tum","long as you","তোমরা থাকো"],["حُرُمًۭا ۗ","ḥuruman","(are in) Ihram","ইহরামে"],["وَٱتَّقُوا۟","wa-ittaqū","And be conscious","এবং তোমরা ভয় করো"],["ٱللَّهَ","l-laha","(of) Allah","আল্লাহকে"],["ٱلَّذِىٓ","alladhī","the One","যিনি (এমন সত্ত্বা যে)"],["إِلَيْهِ","ilayhi","to Him","দিকে তাঁরই"],["تُحْشَرُونَ","tuḥ'sharūna","you will be gathered","তোমাদের একত্র করা হবে"]],"t":"أُحِلَّ لَكُمْ صَيْدُ <h>ٱ</>لْبَحْرِ وَطَعَامُهُ<m>ۥ</> مَ<m>تَٰ</><w>عًۭا لَّ</>كُمْ وَلِلسَّيَّارَةِ ۖ وَحُرِّمَ عَلَيْكُمْ صَيْدُ <h>ٱ</>لْبَرِّ مَا دُمْتُمْ حُرُ<d>مًۭا ۗ وَ</><h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</>للَّهَ <h>ٱ</>لَّ<o>ذِىٓ</> إِلَيْهِ تُحْشَ<p>رُو</>نَ"},{"n":97,"w":[["۞ جَعَلَ","ja‘ala","Has (been) made","নির্ধারিত করেছেন"],["ٱللَّهُ","l-lahu","(by) Allah","আল্লাহ"],["ٱلْكَعْبَةَ","l-ka‘bata","the Kabah","ক্বাবা"],["ٱلْبَيْتَ","l-bayta","the House","ঘরকে"],["ٱلْحَرَامَ","l-ḥarāma","the Sacred","সম্মানিত"],["قِيَـٰمًۭا","qiyāman","an establishment","(কল্যাণ) প্রতিষ্ঠার উপকরণ"],["لِّلنَّاسِ","lilnnāsi","for mankind","জন্যে মানুষের"],["وَٱلشَّهْرَ","wal-shahra","and the month(s)","ও মাস"],["ٱلْحَرَامَ","l-ḥarāma","[the] sacred","সম্মানিত"],["وَٱلْهَدْىَ","wal-hadya","and the (animals) for of