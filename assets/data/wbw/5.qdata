َا وَنَكُونَ عَلَيْهَا مِنَ <h>ٱ</><l>ل</><m>شَّٰ</>هِ<p>دِي</>نَ"},{"n":114,"w":[["قَالَ","qāla","Said","(তখন) বলেছিলো"],["عِيسَى","‘īsā","Isa","ঈসা"],["ٱبْنُ","ub'nu","son","পুত্র্র"],["مَرْيَمَ","maryama","(of) Maryam","মারইয়ামের"],["ٱللَّهُمَّ","l-lahuma","O Allah","\"হে আল্লাহ"],["رَبَّنَآ","rabbanā","our Lord","হে আমাদের রব"],["أَنزِلْ","anzil","send down","পাঠান"],["عَلَيْنَا","‘alaynā","to us","জন্যে আমাদের"],["مَآئِدَةًۭ","māidatan","a table spread","খাদ্যপূর্ণ পাত্র"],["مِّنَ","mina","from","থেকে"],["ٱلسَّمَآءِ","l-samāi","the heaven","আকাশ"],["تَكُونُ","takūnu","to be","যা হবে"],["لَنَا","lanā","for us","জন্যে আমাদের"],["عِيدًۭا","‘īdan","a festival","খুশির উপলক্ষ"],["لِّأَوَّلِنَا","li-awwalinā","for first of us","জন্যে পূর্ববর্তীদের আমাদের"],["وَءَاخِرِنَا","waākhirinā","and last of us","ও পরবর্তীদের আমাদের"],["وَءَايَةًۭ","waāyatan","and a sign","ও নিদর্শন (হবে)"],["مِّنكَ ۖ","minka","from You","থেকে আপনার"],["وَٱرْزُقْنَا","wa-ur'zuq'nā","And provide us","এবং জীবিকা দিন আমাদেরকে"],["وَأَنتَ","wa-anta","and You","এবং আপনি"],["خَيْرُ","khayru","(are) best","উত্তম"],["ٱلرَّٰزِقِينَ","l-rāziqīna","(of) the providers","জীবিকাদাতা"]],"t":"قَالَ عِيسَى <h>ٱ</><q>بْ</>نُ مَرْيَمَ <h>ٱ</><l>ل</>لَّهُ<g>مَّ</> رَبَّ<o>نَآ</> أَ<k>نزِ</>لْ عَلَيْنَا <o>مَآ</>ئِدَ<d>ةًۭ مِّ</>نَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ تَكُونُ لَنَا عِي<w>دًۭا لِّ</>أَوَّلِنَا وَءَاخِرِنَا وَءَايَ<d>ةًۭ مِّ</><k>نكَ</> ۖ وَ<h>ٱ</>رْزُ<q>قْ</>نَا وَأَ<k>نتَ</> خَيْرُ <h>ٱ</><l>ل</><m>رَّٰ</>زِ<p>قِي</>نَ"},{"n":115,"w":[["قَالَ","qāla","Said","বললেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["إِنِّى","innī","Indeed I","\"নিশ্চয়ই আমি"],["مُنَزِّلُهَا","munazziluhā","(will) send it down","অবতীর্ণকারী তা"],["عَلَيْكُمْ ۖ","‘alaykum","to you","উপর তোমাদের"],["فَمَن","faman","then whoever","তবে যে"],["يَكْفُرْ","yakfur","disbelieves","অস্বীকার করবে"],["بَعْدُ","ba‘du","after (that)","এরপরেও"],["مِنكُمْ","minkum","among you","মধ্য হতে তোমাদের"],["فَإِنِّىٓ","fa-innī","then indeed I","তখন নিশ্চয়ই আমি"],["أُعَذِّبُهُۥ","u‘adhibuhu","[I] will punish him","শাস্তি দিবো আমি তাকে"],["عَذَابًۭا","‘adhāban","(with) a punishment","(এমন) শাস্তি"],["لَّآ","lā","not","(যা) না"],["أُعَذِّبُهُۥٓ","u‘adhibuhu","I have punished","আমি শাস্তি দিয়েছি তা"],["أَحَدًۭا","aḥadan","anyone","কাউকে"],["مِّنَ","mina","among","মধ্যে"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","the worlds","বিশ্বজগতের\""]],"t":"قَالَ <h>ٱ</>للَّهُ إِ<g>نِّ</>ى مُنَزِّلُهَا عَلَيْكُمْ ۖ فَ<d>مَن يَ</>كْفُرْ بَعْدُ مِ<k>نكُ</>مْ فَإِ<g>نِّ</><o>ىٓ</> أُعَذِّبُهُ<m>ۥ</> عَذَا<w>بًۭا لَّ</><o>آ</> أُعَذِّبُهُ<o>ۥٓ</> أَحَ<d>دًۭا مِّ</>نَ <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":116,"w":[["وَإِذْ","wa-idh","And when","এবং যখন"],["قَالَ","qāla","said","বলবেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["يَـٰعِيسَى","yā‘īsā","O Isa","\"হে ঈসা"],["ٱبْنَ","ib'na","son","পুত্র"],["مَرْيَمَ","maryama","(of) Maryam","মারইয়ামের"],["ءَأَنتَ","a-anta","Did you","কি তুমি"],["قُلْتَ","qul'ta","say","বলেছিলে"],["لِلنَّاسِ","lilnnāsi","to the people","উদ্দেশ্যে লোকদের"],["ٱتَّخِذُونِى","ittakhidhūnī","Take me","\"তোমরা গ্রহণ করো আমাকে"],["وَأُمِّىَ","wa-ummiya","and my mother","ও আমার মাকে"],["إِلَـٰهَيْنِ","ilāhayni","(as) two gods","দুই ইলাহরূপে"],["مِن","min","from","দিয়ে"],["دُونِ","dūni","besides","বাদ"],["ٱللَّهِ ۖ","l-lahi","Allah","আল্লাহকে\""],["قَالَ","qāla","He said","সে বলবে"],["سُبْحَـٰنَكَ","sub'ḥānaka","Glory be to You","\"মহিমাময় আপনি"],["مَا","mā","Not","না"],["يَكُونُ","yakūnu","was","সঙ্গত"],["لِىٓ","lī","for me","জন্যে আমার"],["أَنْ","an","that","যে"],["أَقُولَ","aqūla","I say","বলবো আমি"],["مَا","mā","what","যা"],["لَيْسَ","laysa","not","নয়"],["لِى","lī","I","আমার"],["بِحَقٍّ ۚ","biḥaqqin","(had) right","অধিকার"],["إِن","in","If","যদি"],["كُنتُ","kuntu","I had","আমি বলে থাকি"],["قُلْتُهُۥ","qul'tuhu","said it","আমি তা"],["فَقَدْ","faqad","then surely","তবে নিশ্চয়ই"],["عَلِمْتَهُۥ ۚ","‘alim'tahu","You would have known it","আপনি জানেন তা"],["تَعْلَمُ","ta‘lamu","You know","জানেন আপনি"],["مَا","mā","what","যা কিছু"],["فِى","fī","(is) in","মধ্যে (আছে)"],["نَفْسِى","nafsī","myself","আমার অন্তরের"],["وَلَآ","walā","and not","এবং না"],["أَعْلَمُ","a‘lamu","I know","জানি আমি"],["مَا","mā","what","যা কিছু"],["فِى","fī","(is) in","মধ্যে (আছে)"],["نَفْسِكَ ۚ","nafsika","Yourself","আপনার মনের"],["إِنَّكَ","innaka","Indeed, You","নিশ্চয়ই আপনি"],["أَنتَ","anta","You","আপনিই"],["عَلَّـٰمُ","‘allāmu","(are) All-Knower","সর্বাধিক পরিজ্ঞাত"],["ٱلْغُيُوبِ","l-ghuyūbi","(of) the unseen","অদৃশ্য সম্বন্ধে"]],"t":"وَإِذْ قَالَ <h>ٱ</>للَّهُ <m>يَٰ</>عِيسَى <h>ٱ</><q>بْ</>نَ مَرْيَمَ ءَأَ<k>نتَ</> قُلْتَ لِل<g>نَّ</>اسِ <h>ٱ</>تَّخِذُونِى وَأُ<g>مِّ</>ىَ إِ<m>لَٰ</>هَيْنِ مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ ۖ قَالَ سُ<q>بْ</><m>حَٰ</>نَكَ مَا يَكُونُ <o>لِىٓ</> أَنْ أَقُولَ مَا لَيْسَ لِى بِحَقٍّ ۚ إِ<k>ن كُنتُ</> قُلْتُهُ<m>ۥ</> فَقَ<q>دْ</> عَلِمْتَهُ<m>ۥ</> ۚ تَعْلَمُ مَا فِى نَفْسِى وَ<o>لَآ</> أَعْلَمُ مَا فِى نَفْسِكَ ۚ إِ<g>نَّ</>كَ أَ<k>نتَ</> عَ<m>لَّٰ</>مُ <h>ٱ</>لْغُ<p>يُو</><q>بِ</>"},{"n":117,"w":[["مَا","mā","Not","না"],["قُلْتُ","qul'tu","I said","আমি বলেছি"],["لَهُمْ","lahum","to them","উদ্দেশ্যে তাদের"],["إِلَّا","illā","except","এ ছাড়া"],["مَآ","mā","what","যা"],["أَمَرْتَنِى","amartanī","You commanded me","আপনি আমাকে নির্দেশ দিয়েছিলেন"],["بِهِۦٓ","bihi","[with it]","সম্পর্কে সে"],["أَنِ","ani","that","যে"],["ٱعْبُدُوا۟","u‘'budū","You worship","\"তোমরা ইবাদত করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহর (যিনি)"],["رَبِّى","rabbī","my Lord","আমার রব"],["وَرَبَّكُمْ ۚ","warabbakum","and your Lord","ও রব তোমাদের\""],["وَكُنتُ","wakuntu","And I was","এবং আমি ছিলাম"],["عَلَيْهِمْ","‘alayhim","over them","উপর তাদের"],["شَهِيدًۭا","shahīdan","a witness","সাক্ষী"],["مَّا","mā","that","যতক্ষণ"],["دُمْتُ","dum'tu","as long as I","আমি ছিলাম"],["فِيهِمْ ۖ","fīhim","(was) among them","মধ্যে তাদের (উপস্থিত)"],["فَلَمَّا","falammā","then when","অতঃপর যখন"],["تَوَفَّيْتَنِى","tawaffaytanī","You raised me","আমাকে উঠিয়ে নিলেন আপনি"],["كُنتَ","kunta","You were","আপনি ছিলেন"],["أَنتَ","anta","[You]","আপনি"],["ٱلرَّقِيبَ","l-raqība","the Watcher","তত্ত্বাবধায়ক"],["عَلَيْهِمْ ۚ","‘alayhim","over them","উপর তাদের"],["وَأَنتَ","wa-anta","and You","এবং আপনি"],["عَلَىٰ","‘alā","(are) on","উপর"],["كُلِّ","kulli","every","সব"],["شَىْءٍۢ","shayin","thing","কিছুরই"],["شَهِيدٌ","shahīdun","a Witness","সাক্ষী"]],"t":"مَا قُلْتُ لَهُمْ إِلَّا <o>مَآ</> أَمَرْتَنِى بِ<o>هِۦٓ</> أَنِ <h>ٱ</>عْبُدُو<s>ا۟</> <h>ٱ</>للَّهَ رَبِّى وَرَبَّكُمْ ۚ وَكُ<k>نتُ</> عَلَيْهِمْ شَهِي<d>دًۭا مَّ</>ا دُمْتُ فِيهِمْ ۖ فَلَ<g>مَّ</>ا تَوَفَّيْتَنِى كُ<k>نتَ</> أَ<k>نتَ</> <h>ٱ</><l>ل</>رَّقِيبَ عَلَيْهِمْ ۚ وَأَ<k>نتَ</> عَلَىٰ كُلِّ <k>شَىْءٍۢ شَ</><p>هِي</><q>دٌ</>"},{"n":118,"w":[["إِن","in","If","(এখন) যদি"],["تُعَذِّبْهُمْ","tu‘adhib'hum","You punish them","শাস্তি দেন আপনি তাদের"],["فَإِنَّهُمْ","fa-innahum","then indeed they","তবুও নিশ্চয়ই তারা"],["عِبَادُكَ ۖ","‘ibāduka","(are) Your slaves","দাস আপনার"],["وَإِن","wa-in","and if","আর যদি"],["تَغْفِرْ","taghfir","You forgive","ক্ষমা করেন আপনি"],["لَهُمْ","lahum","[for] them","প্রতি তাদের"],["فَإِنَّكَ","fa-innaka","then indeed You","তবুও নিশ্চয়ই আপনি"],["أَنتَ","anta","You","আপনিই"],["ٱلْعَزِيزُ","l-‘azīzu","(are) the All-Mighty","পরাক্রমশালী"],["ٱلْحَكِيمُ","l-ḥakīmu","the All-Wise","প্রজ্ঞাময়\""]],"t":"إِ<k>ن تُ</>عَذِّ<q>بْ</>هُمْ فَإِ<g>نَّ</>هُمْ عِبَادُكَ ۖ وَإِ<k>ن تَ</>غْفِرْ لَهُمْ فَإِ<g>نَّ</>كَ أَ<k>نتَ</> <h>ٱ</>لْعَزِيزُ <h>ٱ</>لْحَ<p>كِي</>مُ"},{"n":119,"w":[["قَالَ","qāla","Will say","(তখন) বলবেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["هَـٰذَا","hādhā","This","\"এই"],["يَوْمُ","yawmu","Day","দিনে"],["يَنفَعُ","yanfa‘u","will profit","উপকার দিবে"],["ٱلصَّـٰدِقِينَ","l-ṣādiqīna","the truthful","সত্যবাদীদেরকে"],["صِدْقُهُمْ ۚ","ṣid'quhum","their truthfulness","সত্যতা তাদের\""],["لَهُمْ","lahum","For them","জন্যে তাদের (রয়েছে)"],["جَنَّـٰتٌۭ","jannātun","(are) Gardens","জান্নাত"],["تَجْرِى","tajrī","flows","প্রবাহিত হয়"],["مِن","min","from","দিয়ে"],["تَحْتِهَا","taḥtihā","underneath it","নিচ তার"],["ٱلْأَنْهَـٰرُ","l-anhāru","the rivers","ঝর্ণাধারাসমূহ"],["خَـٰلِدِينَ","khālidīna","will abide","তারা স্হায়ীভাবে বসবাস করবে"],["فِيهَآ","fīhā","in it","মধ্যে তার"],["أَبَدًۭا ۚ","abadan","forever","সর্বদাই\""],["رَّضِىَ","raḍiya","is pleased","সন্তুষ্ট হয়েছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["عَنْهُمْ","‘anhum","with them","প্রতি তাদের"],["وَرَضُوا۟","waraḍū","and they are pleased","ও তারা সন্তুষ্ট হয়েছে"],["عَنْهُ ۚ","‘anhu","with Him","প্রতি তাঁর"],["ذَٰلِكَ","dhālika","That","এটা"],["ٱلْفَوْزُ","l-fawzu","(is) the success","সাফল্য"],["ٱلْعَظِيمُ","l-‘aẓīmu","(the) great","মহা"]],"t":"قَالَ <h>ٱ</>للَّهُ <m>هَٰ</>ذَا يَوْمُ يَ<k>نفَ</>عُ <h>ٱ</><l>ل</><m>صَّٰ</>دِقِينَ صِ<q>دْ</>قُهُمْ ۚ لَهُمْ جَ<g>نَّٰ</><k>تٌۭ تَ</><q>جْ</>رِى مِ<k>ن تَ</>حْتِهَا <h>ٱ</>لْأَنْ<m>هَٰ</>رُ <m>خَٰ</>لِدِينَ فِي<o>هَآ</> أَبَ<w>دًۭا ۚ رَّ</>ضِىَ <h>ٱ</>للَّهُ عَنْهُمْ وَرَضُو<s>ا۟</> عَنْهُ ۚ <m>ذَٰ</>لِكَ <h>ٱ</>لْفَوْزُ <h>ٱ</>لْعَ<p>ظِي</>مُ"},{"n":120,"w":[["لِلَّهِ","lillahi","To Allah (belongs)","জন্যে আল্লাহর(রয়েছে)"],["مُلْكُ","mul'ku","the dominion","সার্বভৌমত্ব"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশসমূহের"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীর"],["وَمَا","wamā","and what","এবং যা কিছু"],["فِيهِنَّ ۚ","fīhinna","(is) in them","মধ্যে তাদের (আছে)"],["وَهُوَ","wahuwa","And He","এবং তিনি"],["عَلَىٰ","‘alā","(is) on","উপর"],["كُلِّ","kulli","every","সব"],["شَىْءٍۢ","shayin","thing","কিছুরই"],["قَدِيرٌۢ","qadīrun","All-Powerful","সর্বশক্তিমান"]],"t":"لِلَّهِ مُلْكُ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ وَمَا فِيهِ<g>نَّ</> ۚ وَهُوَ عَلَىٰ كُلِّ <k>شَىْءٍۢ قَ</><p>دِي</>رٌۢ"}]}