থেকে"],["فَوْقِهِمْ","fawqihim","above them","উপর তাদের"],["وَمِن","wamin","and from","ও থেকে"],["تَحْتِ","taḥti","beneath","নিচ"],["أَرْجُلِهِم ۚ","arjulihim","their feet","পায়ের তাদের"],["مِّنْهُمْ","min'hum","Among them","মধ্য থেকে তাদের"],["أُمَّةٌۭ","ummatun","(is) a community","একদল (আছে)"],["مُّقْتَصِدَةٌۭ ۖ","muq'taṣidatun","moderate","সত্যপন্থী"],["وَكَثِيرٌۭ","wakathīrun","but many","কিন্তু অধিকাংশই"],["مِّنْهُمْ","min'hum","of them ","মধ্য থেকে তাদের"],["سَآءَ","sāa","evil","নিকৃষ্ট"],["مَا","mā","(is) what","যা"],["يَعْمَلُونَ","ya‘malūna","they do","তারা কাজ করছে"]],"t":"وَلَوْ أَ<g>نَّ</>هُمْ أَقَامُو<s>ا۟</> <h>ٱ</><l>ل</>تَّوْرَ<m>ىٰ</>ةَ وَ<h>ٱ</>لْإِ<k>نجِ</>يلَ وَ<o>مَآ</> أُ<k>نزِ</>لَ إِلَيْ<y>هِم مِّ</><w>ن رَّ</>بِّهِمْ لَأَكَلُو<s>ا۟</> مِ<k>ن فَ</>وْقِهِمْ وَمِ<k>ن تَ</>حْتِ أَرْجُلِ<y>هِم ۚ مِّ</>نْهُمْ أُ<g>مَّ</><d>ةٌۭ مُّ</><q>قْ</>تَصِدَ<d>ةٌۭ ۖ وَ</>كَثِي<d>رٌۭ مِّ</>نْهُمْ <o>سَآ</>ءَ مَا يَعْمَ<p>لُو</>نَ"},{"n":67,"w":[["۞ يَـٰٓأَيُّهَا","yāayyuhā","O","হে"],["ٱلرَّسُولُ","l-rasūlu","Messenger","রাসূল"],["بَلِّغْ","balligh","Convey","প্রচার করো"],["مَآ","mā","what","যা"],["أُنزِلَ","unzila","has been revealed","অবতীর্ণ করা হয়েছে"],["إِلَيْكَ","ilayka","to you","প্রতি তোমার"],["مِن","min","from","পক্ষ হতে"],["رَّبِّكَ ۖ","rabbika","your Lord","তোমার রবের"],["وَإِن","wa-in","and if","এবং যদি"],["لَّمْ","lam","not","না"],["تَفْعَلْ","taf‘al","you do","তুমি করো"],["فَمَا","famā","then not","তবে না"],["بَلَّغْتَ","ballaghta","you (have) conveyed","তুমি প্রচার করলে"],["رِسَالَتَهُۥ ۚ","risālatahu","His Message","বার্তা তাঁর"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["يَعْصِمُكَ","ya‘ṣimuka","will protect you","তোমাকে রক্ষা করবেন"],["مِنَ","mina","from","থেকে"],["ٱلنَّاسِ ۗ","l-nāsi","the people","মানুষের"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَا","lā","(does) not","না"],["يَهْدِى","yahdī","guide","পথ দেখান"],["ٱلْقَوْمَ","l-qawma","the people","সম্প্রদায়কে"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","the disbelieving","কাফিরদের"]],"t":"۞ <o>يَٰٓ</>أَيُّهَا <h>ٱ</><l>ل</>رَّسُولُ بَلِّغْ <o>مَآ</> أُ<k>نزِ</>لَ إِلَيْكَ <w>مِن رَّ</>بِّكَ ۖ وَ<w>إِن لَّ</>مْ تَفْعَلْ فَمَا بَلَّغْتَ رِسَالَتَهُ<m>ۥ</> ۚ وَ<h>ٱ</>للَّهُ يَعْصِمُكَ مِنَ <h>ٱ</><l>ل</><g>نَّ</>اسِ ۗ إِ<g>نَّ</> <h>ٱ</>للَّهَ لَا يَهْدِى <h>ٱ</>لْقَوْمَ <h>ٱ</>لْ<m>كَٰ</>فِ<p>رِي</>نَ"},{"n":68,"w":[["قُلْ","qul","Say","বল"],["يَـٰٓأَهْلَ","yāahla","O People","\"হে অধিকারীরা"],["ٱلْكِتَـٰبِ","l-kitābi","(of) the Book","কিতাবের"],["لَسْتُمْ","lastum","You are not","নও তোমরা"],["عَلَىٰ","‘alā","on","উপর"],["شَىْءٍ","shayin","anything","কোনো কিছুর (দন্ডায়মান)"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["تُقِيمُوا۟","tuqīmū","you stand firmly","তোমরা প্রতিষ্ঠিত করো"],["ٱلتَّوْرَىٰةَ","l-tawrāta","(by) the Taurat","তাওরাত"],["وَٱلْإِنجِيلَ","wal-injīla","and the Injeel","ও ইনজীল"],["وَمَآ","wamā","and what","এবং যা"],["أُنزِلَ","unzila","has been revealed","অবতীর্ণ করা হয়েছে"],["إِلَيْكُم","ilaykum","to you","প্রতি তোমাদের"],["مِّن","min","from","পক্ষ হতে"],["رَّبِّكُمْ ۗ","rabbikum","your Lord","তোমাদের রবের"],["وَلَيَزِيدَنَّ","walayazīdanna","And surely increase","এবং নিশ্চয়ই  বৃদ্ধি করবে"],["كَثِيرًۭا","kathīran","many","অনেক (লোককে)"],["مِّنْهُم","min'hum","of them","মধ্য হতে তাদের"],["مَّآ","mā","what","যা"],["أُنزِلَ","unzila","has been revealed","অবতীর্ণ করা হয়েছে"],["إِلَيْكَ","ilayka","to you","প্রতি তোমার"],["مِن","min","from","পক্ষ হতে"],["رَّبِّكَ","rabbika","your Lord","তোমার রবের"],["طُغْيَـٰنًۭا","ṭugh'yānan","(in) rebellion","সীমালঙ্ঘন"],["وَكُفْرًۭا ۖ","wakuf'ran","and disbelief","ও অবিশ্বাস"],["فَلَا","falā","So (do) not","অতএব না"],["تَأْسَ","tasa","grieve","দুঃখ করো"],["عَلَى","‘alā","over","উপর"],["ٱلْقَوْمِ","l-qawmi","the people","সম্প্রদায়ের"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","the disbelieving","কাফির"]],"t":"قُلْ <o>يَٰٓ</>أَهْلَ <h>ٱ</>لْكِ<m>تَٰ</>بِ لَسْتُمْ عَلَىٰ شَىْءٍ حَتَّىٰ تُقِيمُو<s>ا۟</> <h>ٱ</><l>ل</>تَّوْرَ<m>ىٰ</>ةَ وَ<h>ٱ</>لْإِ<k>نجِ</>يلَ وَ<o>مَآ</> أُ<k>نزِ</>لَ إِلَيْ<y>كُم مِّ</><w>ن رَّ</>بِّكُمْ ۗ وَلَيَزِيدَ<g>نَّ</> كَثِي<d>رًۭا مِّ</>نْ<y>هُم مَّ</><o>آ</> أُ<k>نزِ</>لَ إِلَيْكَ <w>مِن رَّ</>بِّكَ طُغْ<m>يَٰ</><d>نًۭا وَ</>كُفْ<k>رًۭا ۖ فَ</>لَا تَأْسَ عَلَى <h>ٱ</>لْقَوْمِ <h>ٱ</>لْ<m>كَٰ</>فِ<p>رِي</>نَ"},{"n":69,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ءَامَنُوا۟","āmanū","believed","ঈমান এনেছে"],["وَٱلَّذِينَ","wa-alladhīna","and those who","ও যারা"],["هَادُوا۟","hādū","became Jews","ইয়াহুদী হয়েছে"],["وَٱلصَّـٰبِـُٔونَ","wal-ṣābiūna","and the Sabians","ও সাবরী"],["وَٱلنَّصَـٰرَىٰ","wal-naṣārā","and the Christians","ও খ্রিষ্টান"],["مَنْ","man","whoever","যে কেউ"],["ءَامَنَ","āmana","believed","ঈমান আনবে"],["بِٱللَّهِ","bil-lahi","in Allah","উপর আল্লাহর"],["وَٱلْيَوْمِ","wal-yawmi","and the Day","ও দিনে"],["ٱلْـَٔاخِرِ","l-ākhiri","the Last","আখেরাতের"],["وَعَمِلَ","wa‘amila","and did","ও কাজ করবে"],["صَـٰلِحًۭا","ṣāliḥan","good deeds","সৎ"],["فَلَا","falā","then no","তাহ'লে নেই"],["خَوْفٌ","khawfun","fear","কোনো ভয়"],["عَلَيْهِمْ","‘alayhim","on them","উপর তাদের"],["وَلَا","walā","and not","আর না"],["هُمْ","hum","they","তারা"],["يَحْزَنُونَ","yaḥzanūna","will grieve","দুশ্চিন্তা করবে"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَ<h>ٱ</>لَّذِينَ هَادُو<s>ا۟</> وَ<h>ٱ</><l>ل</><m>صَّٰ</>بِـُٔونَ وَ<h>ٱ</><l>ل</><g>نَّ</><m>صَٰ</>رَىٰ مَنْ ءَامَنَ بِ<h>ٱ</>للَّهِ وَ<h>ٱ</>لْيَوْمِ <h>ٱ</>لْءَاخِرِ وَعَمِلَ <m>صَٰ</>لِ<k>حًۭا فَ</>لَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَ<p>نُو</>نَ"},{"n":70,"w":[["لَقَدْ","laqad","Certainly","নিশ্চয়ই"],["أَخَذْنَا","akhadhnā","We took","আমরা নিয়েছিলাম"],["مِيثَـٰقَ","mīthāqa","a Covenant","অঙ্গীকার"],["بَنِىٓ","banī","(from the) Children","সন্তানদের (থেকে)"],["إِسْرَٰٓءِيلَ","is'rāīla","(of) Israel","ইসরাঈলদের"],["وَأَرْسَلْنَآ","wa-arsalnā","and We sent","ও আমরা পাঠিয়েছিলাম"],["إِلَيْهِمْ","ilayhim","to them","প্রতি তাদের"],["رُسُلًۭا ۖ","rusulan","Messengers","বহু রাসূলকে"],["كُلَّمَا","kullamā","Whenever","যখনই"],["جَآءَهُمْ","jāahum","came to them","এসেছে তাদের (কাছে)"],["رَسُولٌۢ","rasūlun","any Messenger","কোনো রাসূল"],["بِمَا","bimā","with what","(এমন কিছু) নিয়ে যা"],["لَا","lā","not","না"],["تَهْوَىٰٓ","tahwā","desired","কামনা করে"],["أَنفُسُهُمْ","anfusuhum","their souls","মন তাদের"],["فَرِيقًۭا","farīqan","a group","একদলকে"],["كَذَّبُوا۟","kadhabū","they denied","মিথ্যা সাব্যস্ত করেছে তারা"],["وَفَرِيقًۭا","wafarīqan","and a group","ও এক দলকে"],["يَقْتُلُونَ","yaqtulūna","they kill","তারা হত্যা করেছে"]],"t":"لَقَ<q>دْ</> أَخَذْنَا مِي<m>ثَٰ</>قَ بَ<o>نِىٓ</> إِسْ<o>رَٰٓ</>ءِيلَ وَأَرْسَلْ<o>نَآ</> إِلَيْهِمْ رُسُلًۭ<k>ا ۖ كُ</>لَّمَا <o>جَآ</>ءَهُمْ رَسُو<i>لٌۢ بِ</>مَا لَا تَهْوَ<o>ىٰٓ</> أَ<k>نفُ</>سُهُمْ فَرِي<k>قًۭا كَ</>ذَّبُو<s>ا۟</> وَفَرِي<d>قًۭا يَ</><q>قْ</>تُ<p>لُو</>نَ"},{"n":71,"w":[["وَحَسِبُوٓا۟","waḥasibū","And they thought","এবং তারা ধারণা করেছিলো"],["أَلَّا","allā","that not","যে না"],["تَكُونَ","takūna","will be (for them)","হবে"],["فِتْنَةٌۭ","fit'natun","a trial","কোনো শাস্তি"],["فَعَمُوا۟","fa‘amū","so they became blind","ফলে তারা অন্ধ হলো"],["وَصَمُّوا۟","waṣammū","and they became deaf","ও তারা বধির হলো"],["ثُمَّ","thumma","Then","এরপর"],["تَابَ","tāba","turned","ক্ষমা করলেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["عَلَيْهِمْ","‘alayhim","to them","উপর তাদের"],["ثُمَّ","thumma","then (again)","এরপরও"],["عَمُوا۟","‘amū","they became blind","অন্ধ হয়ে রইলো"],["وَصَمُّوا۟","waṣammū","and they became deaf","ও বধির হয়ে রইলো"],["كَثِيرٌۭ","kathīrun","many","অনেক (লোক)"],["مِّنْهُمْ ۚ","min'hum","of them","মধ্য হতে তাদের"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["بَصِيرٌۢ","baṣīrun","(is) All-Seer","সর্বদ্রষ্টা"],["بِمَا","bimā","of what","ঐ বিষয়ে যা"],["يَعْمَلُونَ","ya‘malūna","they do","তারা কাজ করে"]],"t":"وَحَسِ<o>بُوٓ</><s>ا۟</> أَلَّا تَكُونَ فِتْنَ<k>ةٌۭ فَ</>عَمُو<s>ا۟</> وَصَ<g>مُّ</>و<s>ا۟</> ثُ<g>مَّ</> تَابَ <h>ٱ</>للَّهُ عَلَيْهِمْ ثُ<g>مَّ</> عَمُو<s>ا۟</> وَصَ<g>مُّ</>و<s>ا۟</> كَثِي<d>رٌۭ مِّ</>نْهُمْ ۚ وَ<h>ٱ</>للَّهُ بَصِي<i>رٌۢ بِ</>مَا يَعْمَ<p>لُو</>نَ"},{"n":72,"w":[["لَقَدْ","laqad","Certainly","নিশ্চয়ই"],["كَفَرَ","kafara","disbelieved","অবিশ্বাস করেছে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["قَالُوٓا۟","qālū","say","বলেছে"],["إِنَّ","inna","Indeed","\"নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah ","আল্লাহ"],["هُوَ","huwa","He","তিনি"],["ٱلْمَسِيحُ","l-masīḥu","(is) the Messiah","মসীহই"],["ٱبْنُ","ub'nu","son","পুত্র"],["مَرْيَمَ ۖ","maryama","(of) Maryam","মারইয়ামের\""],["وَقَالَ","waqāla","While said","অথচ বলেছিলো"],["ٱلْمَسِيحُ","l-masīḥu","the Messiah","মসীহ"],["يَـٰبَنِىٓ","yābanī","O Children","\"হে বনী"],["إِسْرَٰٓءِيلَ","is'rāīla","(of) Israel","ইসরাঈল"],["ٱعْبُدُوا۟","u‘'budū","Worship","তোমরা ইবাদত করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহর"],["رَبِّى","rabbī","my Lord","(যিনি) আমার রব"],["وَرَبَّكُمْ ۖ","warabbakum","and your Lord","ও তোমাদের রব\""],["إِنَّهُۥ","innahu","Indeed, he","নিশ্চয়ই (কথা) এটা"],["مَن","man","who","যে কেউ"],["يُشْرِكْ","yush'rik","associates partners","শিরক করে"],["بِٱللَّهِ","bil-lahi","with Allah","সাথে আল্লাহর"],["فَقَدْ","faqad","then surely","তবে নিশ্চয়ই"],["حَرَّمَ","ḥarrama","(has) forbidden","নিষিদ্ধ করেছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["عَلَيْهِ","‘alayhi","for him","জন্যে তার"],["ٱلْجَنَّةَ","l-janata","Paradise","জান্নাত"],["وَمَأْوَىٰهُ","wamawāhu","and his abode","এবং আবাসস্থল তার (হবে)"],["ٱلنَّارُ ۖ","l-nāru","(will be) the Fire","আগুন"],["وَمَا","wamā","And not","এবং নেই"],["لِلظَّـٰلِمِينَ","lilẓẓālimīna","for the wrongdoers","জন্যে সীমালঙ্ঘনকারীদের"],["مِنْ","min","any","কোনো"],["أَنصَارٍۢ","anṣārin","helpers","সাহায্যকারী"]],"t":"لَقَ<q>دْ</> كَفَرَ <h>ٱ</>لَّذِينَ قَا<o>لُوٓ</><s>ا۟</> إِ<g>نَّ</> <h>ٱ</>للَّهَ هُوَ <h>ٱ</>لْمَسِيحُ <h>ٱ</><q>بْ</>نُ مَرْيَمَ ۖ وَقَالَ <h>ٱ</>لْمَسِيحُ <m>يَٰ</>بَ<o>نِىٓ</> إِسْ<o>رَٰٓ</>ءِيلَ <h>ٱ</>عْبُدُو<s>ا۟</> <h>ٱ</>للَّهَ رَبِّى وَرَبَّكُمْ ۖ إِ<g>نَّ</>هُ<m>ۥ</> <d>مَن يُ</>شْرِكْ بِ<h>ٱ</>للَّهِ فَقَ<q>دْ</> حَرَّمَ <h>ٱ</>للَّهُ عَلَيْهِ <h>