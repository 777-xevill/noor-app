ُ وَإِلَى <h>ٱ</><l>ل</>رَّسُولِ قَالُو<s>ا۟</> حَسْبُنَا مَا وَجَ<q>دْ</>نَا عَلَيْهِ ءَا<o>بَآءَنَآ ۚ</> أَوَلَوْ كَانَ ءَا<o>بَآ</>ؤُهُمْ لَا يَعْلَمُونَ شَ<d>يْـًۭٔا وَ</>لَا يَهْتَ<p>دُو</>نَ"},{"n":105,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you","হে"],["ٱلَّذِينَ","alladhīna","who","যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছো"],["عَلَيْكُمْ","‘alaykum","Upon you","উপর তোমাদের(দায়িত্ব)"],["أَنفُسَكُمْ ۖ","anfusakum","(is to guard) yourselves","নিজেদের তোমাদের"],["لَا","lā","Not","না"],["يَضُرُّكُم","yaḍurrukum","will harm you","ক্ষতি করতে পারবে তোমাদের"],["مَّن","man","(those) who","যে"],["ضَلَّ","ḍalla","(have gone) astray","পথভ্রষ্ট হবে"],["إِذَا","idhā","when","যখন"],["ٱهْتَدَيْتُمْ ۚ","ih'tadaytum","you have been guided","সঠিক পথে থাকবে তোমরা"],["إِلَى","ilā","To","দিকে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহরই"],["مَرْجِعُكُمْ","marji‘ukum","(is) your return ","প্রত্যাবর্তন হবে তোমাদের"],["جَمِيعًۭا","jamī‘an","all","সবারই"],["فَيُنَبِّئُكُم","fayunabbi-ukum","then He will inform you","তখন জানিয়ে দিবেন তিনি তোমাদেরকে"],["بِمَا","bimā","of what","ঐ বিষয়ে যা"],["كُنتُمْ","kuntum","you used to","তোমরা ছিলে"],["تَعْمَلُونَ","ta‘malūna","do","তোমরা কাজ করতে"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> عَلَيْكُمْ أَ<k>نفُ</>سَكُمْ ۖ لَا يَضُرُّ<y>كُم مَّ</><k>ن ضَ</>لَّ إِذَا <h>ٱ</>هْتَدَيْتُمْ ۚ إِلَى <h>ٱ</>للَّهِ مَرْجِعُكُمْ جَمِي<k>عًۭا فَ</>يُنَبِّئُ<f>كُم بِ</>مَا كُ<k>نتُ</>مْ تَعْمَ<p>لُو</>نَ"},{"n":106,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you","হে"],["ٱلَّذِينَ","alladhīna","who","যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছো (ওসীয়ত করতে চাইলে)"],["شَهَـٰدَةُ","shahādatu","(Take) testimony","সাক্ষী (রাখো)"],["بَيْنِكُمْ","baynikum","among you","মাঝে তোমাদের"],["إِذَا","idhā","when","যখন"],["حَضَرَ","ḥaḍara","approaches","উপস্থিত হয়"],["أَحَدَكُمُ","aḥadakumu","one of you","তোমাদের কারও"],["ٱلْمَوْتُ","l-mawtu","[the] death","মৃত্যু"],["حِينَ","ḥīna","(at the) time (of making)","সময়"],["ٱلْوَصِيَّةِ","l-waṣiyati","[the] a