{"n":5,"a":[{"n":1,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O","হে"],["ٱلَّذِينَ","alladhīna","you (who)","যারা"],["ءَامَنُوٓا۟","āmanū","believe","ঈমান এনেছো"],["أَوْفُوا۟","awfū","Fulfil","তোমরা পূর্ণ করো"],["بِٱلْعُقُودِ ۚ","bil-‘uqūdi","the contracts","অঙ্গীকারসমূহকে"],["أُحِلَّتْ","uḥillat","Are made lawful","বৈধ করা হয়েছে"],["لَكُم","lakum","for you","জন্যে তোমাদের"],["بَهِيمَةُ","bahīmatu","the quadruped","চতুষ্পদ"],["ٱلْأَنْعَـٰمِ","l-an‘āmi","(of) the grazing livestock","গবাদিপশু"],["إِلَّا","illā","except","এ ছাড়া"],["مَا","mā","what","যা"],["يُتْلَىٰ","yut'lā","is recited","বর্ণিত হচ্ছে"],["عَلَيْكُمْ","‘alaykum","on you","নিকট তোমাদের"],["غَيْرَ","ghayra","not","নয়"],["مُحِلِّى","muḥillī","being permitted","হালালকারী"],["ٱلصَّيْدِ","l-ṣaydi","(to) hunt","শিকার"],["وَأَنتُمْ","wa-antum","while you","এমতাবস্হায় যে তোমরা (থাকো)"],["حُرُمٌ ۗ","ḥurumun","(are in) Ihram","ইহরাম অবস্থায়"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يَحْكُمُ","yaḥkumu","decrees","আদেশ করেন"],["مَا","mā","what","যা"],["يُرِيدُ","yurīdu","He wills","তিনি চান"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَ<o>نُوٓ</><s>ا۟</> أَوْفُو<s>ا۟</> بِ<h>ٱ</>لْعُقُودِ ۚ أُحِلَّتْ لَ<f>كُم بَ</>هِيمَةُ <h>ٱ</>لْأَنْ<m>عَٰ</>مِ إِلَّا مَا يُتْلَىٰ عَلَيْكُمْ غَيْرَ مُحِلِّى <h>ٱ</><l>ل</>صَّيْدِ وَأَ<k>نتُ</>مْ حُرُمٌ ۗ إِ<g>نَّ</> <h>ٱ</>للَّهَ يَحْكُمُ مَا يُ<p>رِي</><q>دُ</>"},{"n":2,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O","হে"],["ٱلَّذِينَ","alladhīna","you (who)","যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছো"],["لَا","lā","(Do) not","না"],["تُحِلُّوا۟","tuḥillū","violate","তোমরা বৈধ মনে করো"],["شَعَـٰٓئِرَ","sha‘āira","(the) rites","নিদর্শনসমূহকে"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَلَا","walā","and not","এবং না (বৈধ করো)"],["ٱلشَّهْرَ","l-shahra","the month","মাসকে"],["ٱلْحَرَامَ","l-ḥarāma","the sacred","পবিত্র"],["وَلَا","walā","and not","এবং না (হাত লাগাবে)"],["ٱلْهَدْىَ","l-hadya","the sacrificial animals","কুরবানির জন্যে কাবায় পাঠানো পশু