,"ghafūrun","(is) Oft-Forgiving","ক্ষমাশীল"],["رَّحِيمٌۭ","raḥīmun","Most Merciful","পরম দয়ালু"]],"t":"أَفَلَا يَتُوبُونَ إِلَى <h>ٱ</>للَّهِ وَيَسْتَغْفِرُونَهُ<m>ۥ</> ۚ وَ<h>ٱ</>للَّهُ غَفُو<w>رٌۭ رَّ</><p>حِي</>مٌۭ"},{"n":75,"w":[["مَّا","mā","Not","না (ছিলো)"],["ٱلْمَسِيحُ","l-masīḥu","(is) the Messiah","মসীহ"],["ٱبْنُ","ub'nu","son","পুত্র"],["مَرْيَمَ","maryama","(of) Maryam","মারইয়ামের"],["إِلَّا","illā","but","এ ছাড়া যে"],["رَسُولٌۭ","rasūlun","a Messenger","একজন রাসূল (আল্লাহর)"],["قَدْ","qad","certainly","নিশ্চয়ই"],["خَلَتْ","khalat","had passed","অতীত হয়েছে"],["مِن","min","from","থেকে"],["قَبْلِهِ","qablihi","before him","পূর্ব তার"],["ٱلرُّسُلُ","l-rusulu","the Messengers","(অনেক) রাসূল"],["وَأُمُّهُۥ","wa-ummuhu","And his mother","এবং মা তার"],["صِدِّيقَةٌۭ ۖ","ṣiddīqatun","(was) truthful","সত্য নিষ্ঠা"],["كَانَا","kānā","They both used to","দু'জনেই"],["يَأْكُلَانِ","yakulāni","eat","খেতো"],["ٱلطَّعَامَ ۗ","l-ṭa‘āma","[the] food","খাদ্য"],["ٱنظُرْ","unẓur","See","দেখো"],["كَيْفَ","kayfa","how","কিরূপে"],["نُبَيِّنُ","nubayyinu","We make clear","বর্ণনা করি আমরা"],["لَهُمُ","lahumu","to them","জন্যে তাদের"],["ٱلْـَٔايَـٰتِ","l-āyāti","the Signs","নিদর্শনগুলো"],["ثُمَّ","thumma","then","এরপরও"],["ٱنظُرْ","unẓur","see","দেখো"],["أَنَّىٰ","annā","how","কিভাবে"],["يُؤْفَكُونَ","yu'fakūna","they are deluded","তাদের ফিরিয়ে নেয়া হচ্ছে"]],"t":"مَّا <h>ٱ</>لْمَسِيحُ <h>ٱ</><q>بْ</>نُ مَرْيَمَ إِلَّا رَسُو<k>لٌۭ قَ</><q>دْ</> خَلَتْ مِ<k>ن قَ</><q>بْ</>لِهِ <h>ٱ</><l>ل</>رُّسُلُ وَأُ<g>مُّ</>هُ<m>ۥ</> صِدِّيقَ<k>ةٌۭ ۖ كَ</>انَا يَأْكُلَانِ <h>ٱ</><l>ل</>طَّعَامَ ۗ <h>ٱ</><k>نظُ</>رْ كَيْفَ نُبَيِّنُ لَهُمُ <h>ٱ</>لْءَا<m>يَٰ</>تِ ثُ<g>مَّ</> <h>ٱ</><k>نظُ</>رْ أَ<g>نَّ</>ىٰ يُؤْفَ<p>كُو</>نَ"},{"n":76,"w":[["قُلْ","qul","Say","বলো"],["أَتَعْبُدُونَ","ata‘budūna","Do you worship","\"কি তোমরা উপাসনা করো"],["مِن","min","from","দিয়ে"],["دُونِ","dūni","besides","বাদ"],["ٱللَّهِ","l-lahi","Allah","আল্লাহকে (অন্যকিছুর)"],["مَا","mā","what","যা"],["لَا","lā","not","না"],["يَمْلِكُ","yamliku","has power","ক্ষমতা রাখে"],["لَكُمْ","lakum","to (cause) you","জন্যে তোমাদের"],["ضَرًّۭا","ḍarran","any harm","কোনো ক্ষতির"],["وَلَا","walā","and not","এবং না"],["نَفْعًۭا ۚ","naf‘an","any benefit","কোনো উপকারের"],["وَٱللَّهُ","wal-lahu","while Allah","অথচ আল্লাহ"],["هُوَ","huwa","He","তিনিই"],["ٱلسَّمِيعُ","l-samī‘u","(is) the All-Hearing","সবকিছু শুনেন"],["ٱلْعَلِيمُ","l-‘alīmu","the All-Knowing","সবকিছুই জানেন"]],"t":"قُلْ أَتَعْبُدُونَ مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ مَا لَا يَمْلِكُ لَكُمْ ضَ<d>رًّۭا وَ</>لَا نَفْ<d>عًۭا ۚ وَ</><h>ٱ</>للَّهُ هُوَ <h>ٱ</><l>ل</>سَّمِيعُ <h>ٱ</>لْعَ<p>لِي</>مُ"},{"n":77,"w":[["قُلْ","qul","Say","বলো"],["يَـٰٓأَهْلَ","yāahla","O People","\"হে অধিকারীরা"],["ٱلْكِتَـٰبِ","l-kitābi","(of) the Book","কিতাবের"],["لَا","lā","(Do) not","না"],["تَغْلُوا۟","taghlū","exceed","তোমরা বাড়াবাড়ি করো"],["فِى","fī","in","ব্যাপারে"],["دِينِكُمْ","dīnikum","your religion","দীনের তোমাদের"],["غَيْرَ","ghayra","other than","নয়"],["ٱلْحَقِّ","l-ḥaqi","the truth","ন্যায়"],["وَلَا","walā","and (do) not","এবং না"],["تَتَّبِعُوٓا۟","tattabi‘ū","follow","তোমরা অনুসরণ করো"],["أَهْوَآءَ","ahwāa","(vain) desires","খেয়ালখুশির"],["قَوْمٍۢ","qawmin","(of) a people","সম্প্রদায়ের"],["قَدْ","qad","certainly","নিশ্চয়ই"],["ضَلُّوا۟","ḍallū","who went astray","তারা পথভ্রষ্ট হয়েছে"],["مِن","min","from","থেকেও"],["قَبْلُ","qablu","before","পূর্ব"],["وَأَضَلُّوا۟","wa-aḍallū","and they misled","ও তারা পথভ্রষ্ট করেছে"],["كَثِيرًۭا","kathīran","many","অনেককে"],["وَضَلُّوا۟","waḍallū","and they have strayed","এবং তারা ভ্রষ্ট হয়েছে"],["عَن","‘an","from","হতে"],["سَوَآءِ","sawāi","(the) right","সরল সোজা"],["ٱلسَّبِيلِ","l-sabīli","[the] way","পথ"]],"t":"قُلْ <o>يَٰٓ</>أَهْلَ <h>ٱ</>لْكِ<m>تَٰ</>بِ لَا تَغْلُو<s>ا۟</> فِى دِينِكُمْ غَيْرَ <h>ٱ</>لْحَقِّ وَلَا تَتَّبِ<o>عُوٓ</><s>ا۟</> أَهْ<o>وَآ</>ءَ قَوْ<k>مٍۢ قَ</><q>دْ</> ضَلُّو<s>ا۟</> مِ<k>ن قَ</><q>بْ</>لُ وَأَضَلُّو<s>ا۟</> كَثِي<d>رًۭا وَ</>ضَلُّو<s>ا۟</> عَ<k>ن سَ</><o>وَآ</>ءِ <h>ٱ</><l>ل</>سَّ<p>بِي</>لِ"},{"n":78,"w":[["لُعِنَ","lu‘ina","Were cursed","অভিশাপ করা হয়েছে"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["كَفَرُوا۟","kafarū","disbelieved","অবিশ্বাস করেছে"],["مِنۢ","min","from","মধ্য হতে"],["بَنِىٓ","banī","(the) Children","বনী"],["إِسْرَٰٓءِيلَ","is'rāīla","(of) Israel","ইসরাঈলদের"],["عَلَىٰ","‘alā","by","মাধ্যমে"],["لِسَانِ","lisāni","(the) tongue","ভাষার"],["دَاوُۥدَ","dāwūda","(of) Dawood","দাউদের"],["وَعِيسَى","wa‘īsā","and Isa","ও ঈসার"],["ٱبْنِ","ib'ni","son","পুত্র"],["مَرْيَمَ ۚ","maryama","(of) Maryam","মারইয়ামের"],["ذَٰلِكَ","dhālika","that (was)","এটা"],["بِمَا","bimā","because","এ কারণে যে"],["عَصَوا۟","‘aṣaw","they disobeyed","তারা অবাধ্য হয়েছিলো"],["وَّكَانُوا۟","wakānū","and they were","ও তারা ছিলো"],["يَعْتَدُونَ","ya‘tadūna","transgressing","তারা সীমালঙ্ঘন করতো"]],"t":"لُعِنَ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> <i>مِنۢ بَ</><o>نِىٓ</> إِسْ<o>رَٰٓ</>ءِيلَ عَلَىٰ لِسَانِ دَاوُ<m>ۥ</>دَ وَعِيسَى <h>ٱ</><q>بْ</>نِ مَرْيَمَ ۚ <m>ذَٰ</>لِكَ بِمَا عَصَو<s>ا۟</> وَّكَانُو<s>ا۟</> يَعْتَ<p>دُو</>نَ"},{"n":79,"w":[["كَانُوا۟","kānū","They had been","তারা ছিলো (এমন যে)"],["لَا","lā","not","না"],["يَتَنَاهَوْنَ","yatanāhawna","forbidding each other","তারা পরস্পরে নিষেধ করতো"],["عَن","‘an","from","হতে"],["مُّنكَرٍۢ","munkarin","wrongdoing","অন্যায় কাজ"],["فَعَلُوهُ ۚ","fa‘alūhu","they did [it]","তারা করতো যা"],["لَبِئْسَ","labi'sa","Surely, evil","অবশ্যই নিকৃষ্ট"],["مَا","mā","(was) what","যা"],["كَانُوا۟","kānū","they were","তারা ছিলো"],["يَفْعَلُونَ","yaf‘alūna","doing","তারা করতে"]],"t":"كَانُو<s>ا۟</> لَا يَتَنَاهَوْنَ <d>عَن مُّ</><k>نكَرٍۢ فَ</>عَلُوهُ ۚ لَبِئْسَ مَا كَانُو<s>ا۟</> يَفْعَ<p>لُو</>نَ"},{"n":80,"w":[["تَرَىٰ","tarā","You see","তুমি দেখছো (আজ)"],["كَثِيرًۭا","kathīran","many","অনেককে"],["مِّنْهُمْ","min'hum","of them","মধ্য হতে তাদের"],["يَتَوَلَّوْنَ","yatawallawna","taking as allies","তারা বন্ধুত্ব করে"],["ٱلَّذِينَ","alladhīna","those who","(তাদের সাথে) যারা"],["كَفَرُوا۟ ۚ","kafarū","disbelieved","অবিশ্বাস করেছে"],["لَبِئْسَ","labi'sa","Surely evil","অবশ্যই নিকৃষ্ট"],["مَا","mā","(is) what","যা"],["قَدَّمَتْ","qaddamat","sent forth","আগে পাঠিয়েছে"],["لَهُمْ","lahum","for them","জন্যে তাদের"],["أَنفُسُهُمْ","anfusuhum","their souls","প্রবৃত্তিসমূহ তাদের"],["أَن","an","that","এ জন্যে"],["سَخِطَ","sakhiṭa","became angry","অসন্তুষ্ট হয়েছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["عَلَيْهِمْ","‘alayhim","with them","উপর তাদের"],["وَفِى","wafī","and in","এবং মধ্যে"],["ٱلْعَذَابِ","l-‘adhābi","the punishment","শাস্তির"],["هُمْ","hum","they","তারা"],["خَـٰلِدُونَ","khālidūna","(will) abide forever","চিরস্থায়ী হবে"]],"t":"تَرَىٰ كَثِي<d>رًۭا مِّ</>نْهُمْ يَتَوَلَّوْنَ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟ ۚ</> لَبِئْسَ مَا قَدَّمَتْ لَهُمْ أَ<k>نفُ</>سُهُمْ أَ<k>ن سَ</>خِطَ <h>ٱ</>للَّهُ عَلَيْهِمْ وَفِى <h>ٱ</>لْعَذَابِ هُمْ <m>خَٰ</>لِ<p>دُو</>نَ"},{"n":81,"w":[["وَلَوْ","walaw","And if","এবং যদি"],["كَانُوا۟","kānū","they had","তারা ছিলো"],["يُؤْمِنُونَ","yu'minūna","believed","তারা ঈমান আনতো"],["بِٱللَّهِ","bil-lahi","in Allah","উপর আল্লাহর"],["وَٱلنَّبِىِّ","wal-nabiyi","and the Prophet","ও নাবীর (উপর)"],["وَمَآ","wamā","and what","ও যা"],["أُنزِلَ","unzila","has been revealed","অবতীর্ণ করা হয়েছে"],["إِلَيْهِ","ilayhi","to him","প্রতি তার"],["مَا","mā","not","(তবে) না"],["ٱتَّخَذُوهُمْ","ittakhadhūhum","they (would have) taken them","তারা গ্রহণ করতো তাদেরকে"],["أَوْلِيَآءَ","awliyāa","(as) allies","বন্ধুরূপে"],["وَلَـٰكِنَّ","walākinna","[and] but","কিন্তু"],["كَثِيرًۭا","kathīran","many","অনেকেই"],["مِّنْهُمْ","min'hum","of them","মধ্য হতে তাদের"],["فَـٰسِقُونَ","fāsiqūna","(are) defiantly disobedient","সত্যত্যাগী"]],"t":"وَلَوْ كَانُو<s>ا۟</> يُؤْمِنُونَ بِ<h>ٱ</>للَّهِ وَ<h>ٱ</><l>ل</><g>نَّ</>بِىِّ وَ<o>مَآ</> أُ<k>نزِ</>لَ إِلَيْهِ مَا <h>ٱ</>تَّخَذُوهُمْ أَوْلِ<o>يَآ</>ءَ وَ<m>لَٰ</>كِ<g>نَّ</> كَثِي<d>رًۭا مِّ</>نْهُمْ <m>فَٰ</>سِ<p>قُو</>نَ"},{"n":82,"w":[["۞ لَتَجِدَنَّ","latajidanna","Surely you will find","অবশ্যই তুমি পাবে"],["أَشَدَّ","ashadda","strongest","সর্বাধিক উগ্র"],["ٱلنَّاسِ","l-nāsi","(of) the people","মানুষের (মধ্যে)"],["عَدَٰوَةًۭ","‘adāwatan","(in) enmity","শত্রুতায়"],["لِّلَّذِينَ","lilladhīna","to those who","জন্যে তাদের(যারা)"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["ٱلْيَهُودَ","l-yahūda","the Jews","ইয়াহুদীদেরকে"],["وَٱلَّذِينَ","wa-alladhīna","and those who","ও যারা"],["أَشْرَكُوا۟ ۖ","ashrakū","(are) polytheists","শিরক করেছে (তাদেরকে)"],["وَلَتَجِدَنَّ","walatajidanna","and surely you will find","এবং অবশ্যই তুমি পাবে"],["أَقْرَبَهُم","aqrabahum","nearest of them","নিকটবর্তী তাদেরকে"],["مَّوَدَّةًۭ","mawaddatan","(in) affection","বন্ধুত্বে"],["لِّلَّذِينَ","lilladhīna","to those who","জন্যে তাদের(যারা)"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["قَالُوٓا۟","qālū","say","বলে"],["إِنَّا","innā","We","\"নিশ্চয়ই আমরা"],["نَصَـٰرَىٰ ۚ","naṣārā","(are) Christians","খ্রিষ্টান\""],["ذَٰلِكَ","dhālika","That (is)","এটা"],["بِأَنَّ","bi-anna","because","জন্যে যে এ"],["مِنْهُمْ","min'hum","among them","মধ্য থেকে তাদের"],["قِسِّيسِينَ","qissīsīna","(are) priests","(অনেক) পন্ডিত(রয়েছে)"],["وَرُهْبَانًۭا","waruh'bānan","and monks","ও (আছে) সংসারবিরাগী (অনেক) ফকির"],["وَأَنَّهُمْ","wa-annahum","and that they","এবং (এও) যে তারা"],["لَا","lā","(are) not","না"],["يَسْتَكْبِرُونَ","yastakbirūna","arrogant","অহঙ্কার করে"]],"t":"۞ لَتَجِدَ<g>نَّ</> أَشَدَّ <h>ٱ</><l>ل</><g>نَّ</>اسِ عَ<m>دَٰ</>وَ<w>ةًۭ لِّ</>لَّذِينَ ءَامَنُو<s>ا۟</> <h>ٱ</>لْيَهُودَ وَ<h>ٱ</>لَّذِينَ أَشْرَكُو<s>ا۟ ۖ</> وَلَتَجِدَ<g>نَّ</> أَ<q>قْ</>رَبَ<y>هُم مَّ</>وَدَّ<w>ةًۭ لِّ</>لَّذِينَ ءَامَنُو<s>ا۟</> <h>ٱ</>لَّذِينَ قَا<o>لُوٓ</><s>ا۟</> إِ<g>نَّ</>ا نَ<m>صَٰ</>رَىٰ ۚ <m>ذَٰ</>لِكَ بِأَ<g>نَّ</> مِنْهُمْ قِسِّيسِينَ وَرُهْبَا<d>نًۭا وَ</>أَ<g>نَّ</>هُمْ لَا يَسْتَكْبِ<p>رُو</>نَ"},{"n":83,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["سَمِعُوا۟","sami‘ū","they listen","তারা শুনে"],["مَآ","mā","(to) what","যা"],["أُنزِلَ","unzila","has been revealed","অবতীর্ণ করা হয়েছে"],["إِلَى","ilā","to","প্রতি"],["ٱلرَّسُولِ","l-rasūli","the Messenger","রাসূলের"],["تَرَىٰٓ","tarā","you see","তুমি দেখবে"],["أَعْيُنَهُمْ","a‘yunahum","their eyes","চোখগুলো তাদের"],["تَفِيضُ","tafīḍu","overflowing","বিগলিত হচ্ছে"],["مِنَ","mina","with","দ্বারা"],["ٱلدَّمْعِ","l-dam‘i","the tears","অশ্রু"],["مِمَّا","mimmā","for what","এ কারণে (যা)"],["عَرَفُوا۟","‘arafū","they recognized","তারা উপলব্ধি করেছে"],["مِنَ","mina","of","বিষয়ে"],["ٱلْحَقِّ ۖ","l-ḥaqi","the truth","মহাসত্যের"],["يَقُولُونَ","yaqūlūna","They say","তারা বলে"],["رَبَّنَآ","rabbanā","Our Lord","\"হে আমাদের রব"],["ءَامَنَّا","āmannā","we have believed","আমরা ঈমান এনেছি"],["فَٱكْتُبْنَا","fa-uk'tub'nā","so write us","অতএব আমাদেরকে তালিকাভুক্ত করো"],["مَعَ","ma‘a","with","সাথে"],["ٱلشَّـٰهِدِينَ","l-shāhidīna","the witnesses","সাক্ষীদাতাদের"]],"t":"وَإِذَا سَمِعُو<s>ا۟</> <o>مَآ</> أُ<k>نزِ</>لَ إِلَى <h>ٱ</><l>ل</>رَّسُولِ تَرَ<o>ىٰٓ</> أَعْيُنَهُمْ تَفِيضُ مِنَ <h>ٱ</><l>ل</>دَّمْعِ مِ<g>مَّ</>ا عَرَفُو<s>ا۟</> مِنَ <h>ٱ</>لْحَقِّ ۖ يَقُولُونَ رَبَّ<o>نَآ</> ءَامَ<g>نَّ</>ا فَ<h>ٱ</>كْتُ<q>بْ</>نَا مَعَ <h>ٱ</><l>ل</><m>شَّٰ</>هِ<p>دِي</>نَ"},{"n":84,"w":[["وَمَا","wamā","And what","এবং কি"],["لَنَا","lanā","for us (that)","হয়েছে আমাদের"],["لَا","lā","not","(যে) না"],["نُؤْمِنُ","nu'minu","we believe","ঈমান আনবো আমরা"],["بِٱللَّهِ","bil-lahi","in Allah","উপর আল্লাহর"],["وَمَا","wamā","and what","এবং যা"],["جَآءَنَا","jāanā","came (to) us","কাছে এসেছে আমাদের"],["مِنَ","mina","from","বিষয়ে"],["ٱلْحَقِّ","l-ḥaqi","the truth","মহাসত্যের"],["وَنَطْمَعُ","wanaṭma‘u","And we hope","ও প্রত্যাশা করি আমরা"],["أَن","an","that","যে"],["يُدْخِلَنَا","yud'khilanā","will admit us","অন্তর্ভুক্ত করবেন আমাদের"],["رَبُّنَا","rabbunā","our Lord","আমাদের রব"],["مَعَ","ma‘a","with","সাথে"],["ٱلْقَوْمِ","l-qawmi","the people","সম্প্রদায়ের\""],["ٱلصَّـٰلِحِينَ","l-ṣāliḥīna","the righteous","সৎকর্মশীল\""]],"t":"وَمَا لَنَا لَا نُؤْمِنُ بِ<h>ٱ</>للَّهِ وَمَا <o>جَآ</>ءَنَا مِنَ <h>ٱ</>لْحَقِّ وَنَ<q>طْ</>مَعُ <d>أَن يُ</><q>دْ</>خِلَنَا رَبُّنَا مَعَ <h>ٱ</>لْقَوْمِ <h>ٱ</><l>ل</><m>صَّٰ</>لِ<p>حِي</>نَ"},{"n":85,"w":[["فَأَثَـٰبَهُمُ","fa-athābahumu","So rewarded them","তাই প্রতিদান দিলেন তাদের"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["بِمَا","bimā","for what","এ কারণে যা"],["قَالُوا۟","qālū","they said","তারা বলেছিলো"],["جَنَّـٰتٍۢ","jannātin","(with) Gardens","জান্নাত"],["تَجْرِى","tajrī","flows","প্রবাহিত হয়"],["مِن","min","from","দিয়ে"],["تَحْتِهَا","taḥtihā","underneath them","নিচ তার"],["ٱلْأَنْهَـٰرُ","l-anhāru","the rivers","ঝর্ণাধারাসমূহ"],["خَـٰلِدِينَ","khālidīna","will abide forever","চিরস্থায়ী হবে তারা"],["فِيهَا ۚ","fīhā","in it","মধ্যে তার"],["وَذَٰلِكَ","wadhālika","And that","এবং এটা"],["جَزَآءُ","jazāu","(is the) reward","প্রতিদান"],["ٱلْمُحْسِنِينَ","l-muḥ'sinīna","(of) the good-doers","সৎকর্মপরায়ণদের"]],"t":"فَأَ<m>ثَٰ</>بَهُمُ <h>ٱ</>للَّهُ بِمَا قَالُو<s>ا۟</> جَ<g>نَّٰ</><k>تٍۢ تَ</><q>جْ</>رِى مِ<k>ن تَ</>حْتِهَا <h>ٱ</>لْأَنْ<m>هَٰ</>رُ <m>خَٰ</>لِدِينَ فِيهَا ۚ وَ<m>ذَٰ</>لِكَ جَ<o>زَآ</>ءُ <h>ٱ</>لْمُحْسِ<p>نِي</>نَ"},{"n":86,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","কিন্তু যারা"],["كَفَرُوا۟","kafarū","disbelieved","অবিশ্বাস করেছে"],["وَكَذَّبُوا۟","wakadhabū","and denied","ও মিথ্যারোপ করেছে"],["بِـَٔايَـٰتِنَآ","biāyātinā","Our Signs","প্রতি আয়াতগুলোর আমাদের"],["أُو۟لَـٰٓئِكَ","ulāika","those","ঐ সব লোক"],["أَصْحَـٰبُ","aṣḥābu","(are the) companions","অধিবাসী (হবে)"],["ٱلْجَحِيمِ","l-jaḥīmi","(of) the Hellfire","জাহান্নামের"]],"t":"وَ<h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> وَكَذَّبُو<s>ا۟</> بِـَٔا<m>يَٰ</>تِ<o>نَآ</> أُ<s>و۟</><o>لَٰٓ</>ئِكَ أَصْ<m>حَٰ</>بُ <h>ٱ</>لْجَ<p>حِي</>مِ"},{"n":87,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you","হে"],["ٱلَّذِينَ","alladhīna","who","যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছো"],["لَا","lā","(Do) not","না"],["تُحَرِّمُوا۟","tuḥarrimū","make unlawful","তোমরা নিষিদ্ধ করো"],["طَيِّبَـٰتِ","ṭayyibāti","(the) good things","পবিত্র জিনিসসমূহকে"],["مَآ","mā","(of) what","যা"],["أَحَلَّ","aḥalla","has (been) made lawful","বৈধ করেছেন"],["ٱللَّهُ","l-lahu","(by) Allah","আল্লাহ"],["لَكُمْ","lakum","for you","জন্যে তোমাদের"],["وَلَا","walā","and (do) not","এবং না"],["تَعْتَدُوٓا۟ ۚ","ta‘tadū","transgress","তোমরা সীমালঙ্ঘন করো"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَا","lā","(does) not","না"],["يُحِبُّ","yuḥibbu","love","ভালোবাসেন"],["ٱلْمُعْتَدِينَ","l-mu‘'tadīna","the transgressors","সীমালঙ্ঘনকারীদেরকে"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> لَا تُحَرِّمُو<s>ا۟</> طَيِّ<m>بَٰ</>تِ <o>مَآ</> أَحَلَّ <h>ٱ</>للَّهُ لَكُمْ وَلَا تَعْتَ<o>دُوٓ</><s>ا۟</> ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ لَا يُحِبُّ <h>ٱ</>لْمُعْتَ<p>دِي</>نَ"},{"n":88,"w":[["وَكُلُوا۟","wakulū","And eat","এবং তোমরা খাও"],["مِمَّا","mimmā","of what","তা হতে যা"],["رَزَقَكُمُ","razaqakumu","has provided you","জীবিকা দিয়েছেন তোমাদের"],["ٱللَّهُ","l-lahu","Allah ","আল্লাহ"],["حَلَـٰلًۭا","ḥalālan","lawful","বৈধ"],["طَيِّبًۭا ۚ","ṭayyiban","good","পবিত্র"],["وَٱتَّقُوا۟","wa-ittaqū","And fear","ও তোমরা ভয় করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["ٱلَّذِىٓ","alladhī","the One","যিনি (মহান সত্ত্বা)"],["أَنتُم","antum","you (are)","তোমরা"],["بِهِۦ","bihi","in Him","উপর তাঁর"],["مُؤْمِنُونَ","mu'minūna","believers","মু'মিন"]],"t":"وَكُلُو<s>ا۟</> مِ<g>مَّ</>ا رَزَقَكُمُ <h>ٱ</>للَّهُ حَ<m>لَٰ</>لًۭ<k>ا طَ</>يِّ<d>بًۭا ۚ وَ</><h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</>للَّهَ <h>ٱ</>لَّ<o>ذِىٓ</> أَ<k>نتُ</><f>م بِ</><m>هِۦ</> مُؤْمِ<p>نُو</>نَ"},{"n":89,"w":[["لَا","lā","Not","না"],["يُؤَاخِذُكُمُ","yuākhidhukumu","will call you to account","পাকড়াও করবেন তোমাদের"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["بِٱللَّغْوِ","bil-laghwi","for the thoughtless utterances","কারণে অর্থহীন শপথের"],["فِىٓ","fī","in","মধ্যকার"],["أَيْمَـٰنِكُمْ","aymānikum","your oaths","শপথগুলোর তোমাদের"],["وَلَـٰكِن","walākin","but","কিন্তু"],["يُؤَاخِذُكُم","yuākhidhukum","He will call you to account","পাকড়াও করবেন তোমাদের"],["بِمَا","bimā","for what","এ কারণে যা"],["عَقَّدتُّمُ","‘aqqadttumu","you contracted","দৃঢ়ভাবে করো তোমরা"],["ٱلْأَيْمَـٰنَ ۖ","l-aymāna","(of) the oath","শপথগুলো"],["فَكَفَّـٰرَتُهُۥٓ","fakaffāratuhu","So its expiation","অতএব প্রায়শ্চিত্ত তার"],["إِطْعَامُ","iṭ'‘āmu","(is) feeding","খাদ্য খাওয়ানো"],["عَشَرَةِ","‘asharati","(of) ten","দশজন"],["مَسَـٰكِينَ","masākīna","needy people","দরিদ্র ব্যক্তিকে"],["مِنْ","min","of","ধরণের"],["أَوْسَطِ","awsaṭi","average","মধ্যম"],["مَا","mā","(of) what","যা"],["تُطْعِمُونَ","tuṭ'‘imūna","you feed","তোমরা খাওয়াও"],["أَهْلِيكُمْ","ahlīkum","your families","পরিবারকে তোমাদের"],["أَوْ","aw","or","বা"],["كِسْوَتُهُمْ","kis'watuhum","clothing them","কাপড় দান করা তাদের"],["أَوْ","aw","or","বা"],["تَحْرِيرُ","taḥrīru","freeing","মুক্ত করা"],["رَقَبَةٍۢ ۖ","raqabatin","a slave","একজন দাসের (শপথের প্রায়শ্চিত্ত)"],["فَمَن","faman","But whoever","তবে যে"],["لَّمْ","lam","(does) not","না"],["يَجِدْ","yajid","find","পায় (অর্থাৎ অসমর্থ)"],["فَصِيَامُ","faṣiyāmu","(that), then fasting","তাহ'লে রোজা (রাখবে)"],["ثَلَـٰثَةِ","thalāthati","(for) three","তিন"],["أَيَّامٍۢ ۚ","ayyāmin","days","দিন"],["ذَٰلِكَ","dhālika","That","এটা"],["كَفَّـٰرَةُ","kaffāratu","(is the) expiation","প্রায়শ্চিত্ত"],["أَيْمَـٰنِكُمْ","aymānikum","(of) your oaths","শপথের তোমাদের"],["إِذَا","idhā","when","যখন"],["حَلَفْتُمْ ۚ","ḥalaftum","you have sworn","শপথ করবে তোমরা"],["وَٱحْفَظُوٓا۟","wa-iḥ'faẓū","And guard","এবং তোমরা রক্ষা করো"],["أَيْمَـٰنَكُمْ ۚ","aymānakum","your oaths","শপথগুলোর তোমাদের"],["كَذَٰلِكَ","kadhālika","Thus","এভাবে"],["يُبَيِّنُ","yubayyinu","makes clear","বর্ণনা করেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["لَكُمْ","lakum","to you","জন্যে তোমাদের"],["ءَايَـٰتِهِۦ","āyātihi","His Verses","নিদর্শনাবলী তাঁর"],["لَعَلَّكُمْ","la‘allakum","so that you may","যেন তোমরা"],["تَشْكُرُونَ","tashkurūna","(be) grateful","কৃতজ্ঞতা প্রকাশ করো"]],"t":"لَا يُؤَاخِذُكُمُ <h>ٱ</>للَّهُ بِ<h>ٱ</><l>ل</>لَّغْوِ <o>فِىٓ</> أَيْ<m>مَٰ</>نِكُمْ وَ<m>لَٰ</><d>كِن يُ</>ؤَاخِذُ<f>كُم بِ</>مَا عَقَّ<j>د</>تُّمُ <h>ٱ</>لْأَيْ<m>مَٰ</>نَ ۖ فَكَ<m>فَّٰ</>رَتُهُ<o>ۥٓ</> إِ<q>طْ</>عَامُ عَشَرَةِ مَ<m>سَٰ</>كِينَ مِنْ أَوْسَطِ مَا تُ<q>طْ</>عِمُونَ أَهْلِيكُمْ أَوْ كِسْوَتُهُمْ أَوْ تَحْرِيرُ رَقَبَ<k>ةٍۢ ۖ فَ</><w>مَن لَّ</>مْ يَجِ<q>دْ</> فَصِيَامُ ثَ<m>لَٰ</>ثَةِ أَيَّا<k>مٍۢ ۚ ذَٰ</>لِكَ كَ<m>فَّٰ</>رَةُ أَيْ<m>مَٰ</>نِكُمْ إِذَا حَلَفْتُمْ ۚ وَ<h>ٱ</>حْفَ<o>ظُوٓ</><s>ا۟</> أَيْ<m>مَٰ</>نَكُمْ ۚ كَ<m>ذَٰ</>لِكَ يُبَيِّنُ <h>ٱ</>للَّهُ لَكُمْ ءَا<m>يَٰتِهِۦ</> لَعَلَّكُمْ تَشْكُ<p>رُو</>نَ"},{"n":90,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you","হে"],["ٱلَّذِينَ","alladhīna","who","যারা"],["ءَامَنُوٓا۟","āmanū","believe","ঈমান এনেছো"],["إِنَّمَا","innamā","Verily","মূলতঃ"],["ٱلْخَمْرُ","l-khamru","the intoxicants","মদ"],["وَٱلْمَيْسِرُ","wal-maysiru","and [the] games of chance","ও জুয়া"],["وَٱلْأَنصَابُ","wal-anṣābu","and (sacrifices at) altars","ও পূজার বেদীগুলো"],["وَٱلْأَزْلَـٰمُ","wal-azlāmu","and divining arrows","ও ভাগ্য নির্ধারক তীরগুলো"],["رِجْسٌۭ","rij'sun","(are an) abomination","অপবিত্র"],["مِّنْ","min","from","এক ধরণের"],["عَمَلِ","‘amali","(the) work","কাজ"],["ٱلشَّيْطَـٰنِ","l-shayṭāni","(of) the Shaitaan","শয়তানের"],["فَٱجْتَنِبُوهُ","fa-ij'tanibūhu","so avoid it","তাই বেঁচে থাকো তা হতে"],["لَعَلَّكُمْ","la‘allakum","so that you may","যেন তোমরা"],["تُفْلِحُونَ","tuf'liḥūna","(be) successful","সফলকাম হতে পারো"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَ<o>نُوٓ</><s>ا۟</> إِ<g>نَّ</>مَا <h>ٱ</>لْخَمْرُ وَ<h>ٱ</>لْمَيْسِرُ وَ<h>ٱ</>لْأَ<k>نصَ</>ابُ وَ<h>ٱ</>لْأَزْ<m>لَٰ</>مُ رِ<q>جْ</><d>سٌۭ مِّ</>نْ عَمَلِ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نِ فَ<h>ٱ</><q>جْ</>تَنِبُوهُ لَعَلَّكُمْ تُفْلِ<p>حُو</>نَ"},{"n":91,"w":[["إِنَّمَا","innamā","Only","মূলতঃ"],["يُرِيدُ","yurīdu","intends","চায়"],["ٱلشَّيْطَـٰنُ","l-shayṭānu","the Shaitaan","শয়তান"],["أَن","an","to","যে"],["يُوقِعَ","yūqi‘a","cause","ঘটাবে"],["بَيْنَكُمُ","baynakumu","between you","মাঝে তোমাদের"],["ٱلْعَدَٰوَةَ","l-‘adāwata","[the] enmity","শত্রুতা"],["وَٱلْبَغْضَآءَ","wal-baghḍāa","and [the] hatred","ও বিদ্বেষ"],["فِى","fī","throug