َحَدَكُمُ <h>ٱ</>لْمَوْتُ حِينَ <h>ٱ</>لْوَصِيَّةِ <h>ٱ</>ثْنَانِ ذَوَا عَ<q>دْ</><d>لٍۢ مِّ</><k>نكُ</>مْ أَوْ ءَاخَرَانِ مِنْ غَيْرِكُمْ إِنْ أَ<k>نتُ</>مْ ضَرَ<q>بْ</>تُمْ فِى <h>ٱ</>لْأَرْضِ فَأَ<m>صَٰ</>بَتْ<y>كُم مُّ</>صِيبَةُ <h>ٱ</>لْمَوْتِ ۚ تَحْبِسُونَهُمَا <i>مِنۢ بَ</>عْدِ <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةِ فَيُ<q>قْ</>سِمَانِ بِ<h>ٱ</>للَّهِ إِنِ <h>ٱ</>رْتَ<q>بْ</>تُمْ لَا نَشْتَرِى بِ<m>هِۦ</> ثَمَ<d>نًۭا وَ</>لَوْ كَانَ ذَا قُرْبَىٰ ۙ وَلَا نَكْتُمُ شَ<m>هَٰ</>دَةَ <h>ٱ</>للَّهِ إِ<g>نَّ</><o>آ</> إِ<w>ذًۭا لَّ</>مِنَ <h>ٱ</>لْءَاثِ<p>مِي</>نَ"},{"n":107,"w":[["فَإِنْ","fa-in","Then if","অতঃপর যদি"],["عُثِرَ","‘uthira","it is discovered","প্রকাশ পায়"],["عَلَىٰٓ","‘alā","(on)","এ ক্ষেত্রে"],["أَنَّهُمَا","annahumā","that the two","যে তারা দু'জনে"],["ٱسْتَحَقَّآ","is'taḥaqqā","(were) guilty","লিপ্ত হয়েছে দু'জনে"],["إِثْمًۭا","ith'man","(of) sin","অপরাধে"],["فَـَٔاخَرَانِ","faākharāni","then (let) two others","তবে অন্য দু’জন"],["يَقُومَانِ","yaqūmāni","stand","দাঁড়াবে"],["مَقَامَهُمَا","maqāmahumā","(in) their place","দু’জনের জায়গায় তাদের"],["مِنَ","mina","from","মধ্য থেকে"],["ٱلَّذِينَ","alladhīna","those who","(ঐ লোকদের) যারা"],["ٱسْتَحَقَّ","is'taḥaqqa","have a lawful right","উপযুক্ত হয়েছে (স্বার্থহানি ঘটেছে)"],["عَلَيْهِمُ","‘alayhimu","over them ","উপর তাদের"],["ٱلْأَوْلَيَـٰنِ","l-awlayāni","the former two ","(দাঁড়াবে তাদের) নিকটতম দু’জন"],["فَيُقْسِمَانِ","fayuq'simāni","and let them both swear","অতঃপর দু'জনে শপথ করবে"],["بِٱللَّهِ","bil-lahi","by Allah","নামে আল্লাহর"],["لَشَهَـٰدَتُنَآ","lashahādatunā","Surely our testimony","\"অবশ্যই সাক্ষ্য অামাদের"],["أَحَقُّ","aḥaqqu","(is) truer","অধিক সত্য"],["مِن","min","than","চেয়ে"],["شَهَـٰدَتِهِمَا","shahādatihimā","testimony of the other two","দু’জনের সাক্ষ্যের তাদের"],["وَمَا","wamā","and not","এবং না"],["ٱعْتَدَيْنَآ","i‘'tadaynā","we have transgressed","সীমালংঘন করছি আমরা"],["إِنَّآ","innā","Indeed, we","(যদি করি)নিশ্চয়ই আমরা"],["إِذًۭا","idhan","then","তাহ'লে (হবো)"],["لَّمِنَ","lamina","(will be) of","অবশ্যই অন্তর্ভূক্ত"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","সীমালঙ্ঘনকারীদের\""]],"t":"فَإِنْ عُثِرَ عَلَ<o>ىٰٓ</> أَ<g>نَّ</>هُمَا <h>ٱ</>سْتَحَ<o>قَّآ</> إِثْ<k>مًۭا فَـَٔ</>اخَرَانِ يَقُومَانِ مَقَامَهُمَا مِنَ <h>ٱ</>لَّذِينَ <h>ٱ</>سْتَحَقَّ عَلَيْهِمُ <h>ٱ</>لْأَوْلَ<m>يَٰ</>نِ فَيُ<q>قْ</>سِمَانِ بِ<h>ٱ</>للَّهِ لَشَ<m>هَٰ</>دَتُ<o>نَآ</> أَحَقُّ مِ<k>ن شَ</><m>هَٰ</>دَتِهِمَا وَمَا <h>ٱ</>عْتَدَيْ<o>نَآ</> إِ<g>نَّ</><o>آ</> إِ<w>ذًۭا لَّ</>مِنَ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":108,"w":[["ذَٰلِكَ","dhālika","That","এটা"],["أَدْنَىٰٓ","adnā","(is) closer","নিকটতর (সম্ভাবনা)"],["أَن","an","that","যে"],["يَأْتُوا۟","yatū","they will give","তারা আসবে"],["بِٱلشَّهَـٰدَةِ","bil-shahādati","the testimony","নিয়ে সাক্ষ্য"],["عَلَىٰ","‘alā","in","উপর"],["وَجْهِهَآ","wajhihā","its (true) form","সঠিকতার তার"],["أَوْ","aw","or","বা"],["يَخَافُوٓا۟","yakhāfū","they would fear","তারা ভয় করবে"],["أَن","an","that","যে"],["تُرَدَّ","turadda","will be refuted","পুনরায় করানো হবে"],["أَيْمَـٰنٌۢ","aymānun","their oaths","শপথগুলো"],["بَعْدَ","ba‘da","after","পরে"],["أَيْمَـٰنِهِمْ ۗ","aymānihim","their (others) oaths","শপথগুলোর তাদের"],["وَٱتَّقُوا۟","wa-ittaqū","And fear","এবং তোমরা ভয় করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["وَٱسْمَعُوا۟ ۗ","wa-is'ma‘ū","and listen","ও তোমরা শুনো"],["وَٱللَّهُ","wal-lahu","and Allah","এবং আল্লাহ"],["لَا","lā","(does) not","না"],["يَهْدِى","yahdī","guide","পরিচালিত করেন"],["ٱلْقَوْمَ","l-qawma","the people","সম্প্রদায়কে"],["ٱلْفَـٰسِقِينَ","l-fāsiqīna","the defiantly disobedient","(যারা) সত্যত্যাগী"]],"t":"<m>ذَٰ</>لِكَ أَ<q>دْ</>نَ<o>ىٰٓ</> <d>أَن يَ</>أْتُو<s>ا۟</> بِ<h>ٱ</><l>ل</>شَّ<m>هَٰ</>دَةِ عَلَىٰ وَ<q>جْ</>هِ<o>هَآ</> أَوْ يَخَا<o>فُوٓ</><s>ا۟</> أَ<k>ن تُ</>رَدَّ أَيْ<m>مَٰ</><i>نٌۢ بَ</>عْدَ أَيْ<m>مَٰ</>نِهِمْ ۗ وَ<h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</>للَّهَ وَ<h>ٱ</>سْمَعُو<s>ا۟ ۗ</> وَ<h>ٱ</>للَّهُ لَا يَهْدِى <h>ٱ</>لْقَوْمَ <h>ٱ</>لْ<m>فَٰ</>سِ<p>قِي</>نَ"},{"n":109,"w":[["۞ يَوْمَ","yawma","(The) day","যে দিন"],["يَجْمَعُ","yajma‘u","will (be) gathered","একত্র করবেন"],["ٱللَّهُ","l-lahu","(by) Allah","আল্লাহ"],["ٱلرُّسُلَ","l-rusula","the Messengers","রাসূলেদেরকে"],["فَيَقُولُ","fayaqūlu","and He will say","অতঃপর তিনি বলবেন"],["مَاذَآ","mādhā","What","\"কি"],["أُجِبْتُمْ ۖ","ujib'tum","was (the) response you received","উত্তর দেয়া হয়েছিলো তোমাদেরকে\""],["قَالُوا۟","qālū","They said","তারা বলবে"],["لَا","lā","(There is) no","\"নেই"],["عِلْمَ","‘il'ma","knowledge","কোনো জ্ঞান"],["لَنَآ ۖ","lanā","for us","কাছে আমাদের"],["إِنَّكَ","innaka","Indeed You","নিশ্চয়ই আপনি"],["أَنتَ","anta","You","আপনিই"],["عَلَّـٰمُ","‘allāmu","(are the) Knower","মহাজ্ঞানী"],["ٱلْغُيُوبِ","l-ghuyūbi","(of) the unseen","অদৃশ্যসমূহের অবস্থা\""]],"t":"۞ يَوْمَ يَ<q>جْ</>مَعُ <h>ٱ</>للَّهُ <h>ٱ</><l>ل</>رُّسُلَ فَيَقُولُ مَا<o>ذَآ</> أُجِ<q>بْ</>تُمْ ۖ قَالُو<s>ا۟</> لَا عِلْمَ لَ<o>نَآ ۖ</> إِ<g>نَّ</>كَ أَ<k>نتَ</> عَ<m>لَّٰ</>مُ <h>ٱ</>لْغُ<p>يُو</><q>بِ</>"},{"n":110,"w":[["إِذْ","idh","When","(স্মরণ করো) যখন"],["قَالَ","qāla","said","বলেছিলেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["يَـٰعِيسَى","yā‘īsā","O Isa","\"হে ঈসা"],["ٱبْنَ","ib'na","son","পূত্র"],["مَرْيَمَ","maryama","(of) Maryam","মারইয়ামের"],["ٱذْكُرْ","udh'kur","Remember","তুমি স্মরণ করো"],["نِعْمَتِى","ni‘'matī","My Favor","আমার অনুগ্রহ"],["عَلَيْكَ","‘alayka","upon you","উপর তোমার"],["وَعَلَىٰ","wa‘alā","and upon","ও উপর"],["وَٰلِدَتِكَ","wālidatika","your mother","তোমার মাতার"],["إِذْ","idh","when","যখন"],["أَيَّدتُّكَ","ayyadttuka","I strengthened you","তোমাকে শক্তিশালী করেছিলাম"],["بِرُوحِ","birūḥi","with (the) Spirit","দিয়ে আত্মা"],["ٱلْقُدُسِ","l-qudusi","the Holy","পবিত্র"],["تُكَلِّمُ","tukallimu","you spoke","তুমি কথা বলতে"],["ٱلنَّاسَ","l-nāsa","(to) the people","মানুষের(সাথে)"],["فِى","fī","in","মধ্যে"],["ٱلْمَهْدِ","l-mahdi","the cradle","দোলনার"],["وَكَهْلًۭا ۖ","wakahlan","and (in) maturity","এবং পরিণত বয়সেও"],["وَإِذْ","wa-idh","And when","এবং যখন"],["عَلَّمْتُكَ","‘allamtuka","I tau