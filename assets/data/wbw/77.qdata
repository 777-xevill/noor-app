{"n":77,"a":[{"n":1,"w":[["وَٱلْمُرْسَلَـٰتِ","wal-mur'salāti","By the ones sent forth","শপথ প্রেরিত (বায়ুর)"],["عُرْفًۭا","‘ur'fan","one after another","কল্যাণ সুরূপ"]],"t":"وَ<h>ٱ</>لْمُرْسَ<m>لَٰ</>تِ عُرْفًۭا"},{"n":2,"w":[["فَٱلْعَـٰصِفَـٰتِ","fal-‘āṣifāti","And the winds that blow","অতঃপর ঝটিকার"],["عَصْفًۭا","‘aṣfan","violently","প্রলংকরী"]],"t":"فَ<h>ٱ</>لْ<m>عَٰصِفَٰ</>تِ عَصْفًۭا"},{"n":3,"w":[["وَٱلنَّـٰشِرَٰتِ","wal-nāshirāti","And the ones that scatter","এবং (মেঘপুঞ্জ) বিস্তারকারী (বায়ুর)"],["نَشْرًۭا","nashran","far and wide","বিস্তার করা"]],"t":"وَ<h>ٱ</><l>ل</><g>نَّٰ</>شِ<m>رَٰ</>تِ نَشْرًۭا"},{"n":4,"w":[["فَٱلْفَـٰرِقَـٰتِ","fal-fāriqāti","And those who separate","প্রৃথককারী (বায়ুর) অতংপর"],["فَرْقًۭا","farqan","(by the) Criterion","পৃথক করা (মেঘকে)"]],"t":"فَ<h>ٱ</>لْ<m>فَٰرِقَٰ</>تِ فَرْقًۭا"},{"n":5,"w":[["فَٱلْمُلْقِيَـٰتِ","fal-mul'qiyāti","And those who bring down","অতংপর জাগ্রতকারীদের (অন্তরে)"],["ذِكْرًا","dhik'ran","(the) Reminder","উপদেশ"]],"t":"فَ<h>ٱ</>لْمُلْقِ<m>يَٰ</>تِ ذِكْرًا"},{"n":6,"w":[["عُذْرًا","‘udh'ran","(As) justification","অনুশোচনা করা"],["أَوْ","aw","or","বা"],["نُذْرًا","nudh'ran","warning","সতর্কতা সুরূপ"]],"t":"عُذْرًا أَوْ نُذْرًا"},{"n":7,"w":[["إِنَّمَا","innamā","Indeed, what","(যা) মূলতঃ"],["تُوعَدُونَ","tū‘adūna","you are promised","তোমাদের ওয়াদা করা হয়েছে"],["لَوَٰقِعٌۭ","lawāqi‘un","will surely occur","সংঘটিত হবে অবশ্যই"]],"t":"إِ<g>نَّ</>مَا تُوعَدُونَ لَ<m>وَٰ</>قِعٌۭ"},{"n":8,"w":[["فَإِذَا","fa-idhā","So when","যখন অতঃপর"],["ٱلنُّجُومُ","l-nujūmu","the stars","তারকাসমূহ"],["طُمِسَتْ","ṭumisat","are obliterated","স্লান করা হবে"]],"t":"فَإِذَا <h>ٱ</><l>ل</><g>نُّ</>جُومُ طُمِسَتْ"},{"n":9,"w":[["وَإِذَا","wa-idhā","And when","যখন এবং"],["ٱلسَّمَآءُ","l-samāu","the heaven","আসমান"],["فُرِجَتْ","furijat","is cleft asunder","বিদীর্ণ করা হবে"]],"t":"وَإِذَا <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءُ فُرِجَتْ"},{"n":10,"w":[["وَإِذَا","wa-idhā","And when","যখন এবং"],["ٱلْجِبَالُ","l-jibālu","the mountains","পর্বত সমূহকে"],["نُسِفَتْ","nusifat","are blown away","ধুনে ফেলা হবে"]],"t":"وَإِذَا <h>ٱ</>لْجِبَالُ نُسِفَتْ"},{"n":11,"w":[["وَإِذَا","wa-idhā","And when","যখন এবং"],["ٱلرُّسُلُ","l-rusulu","the Messengers","রসুলগণকে"],["أُقِّتَتْ","uqqitat","are gathered to their appointed time","নির্দিষ্ট সময় উপস্থিত করা হবে"]],"t":"وَإِذَا <h>ٱ</><l>ل</>رُّسُلُ أُقِّتَتْ"},{"n":12,"w":[["لِأَىِّ","li-ayyi","For what","কোন জন্য"],["يَوْمٍ","yawmin","Day","দিনের"],["أُجِّلَتْ","ujjilat","are (these) postponed","স্থগিত করা হয়েছে"]],"t":"لِأَىِّ يَوْمٍ أُجِّلَتْ"},{"n":13,"w":[["لِيَوْمِ","liyawmi","For (the) Day","দিনের জন্য"],["ٱلْفَصْلِ","l-faṣli","(of) Judgment","পৃৃথককারী (ফয়সালার)"]],"t":"لِيَوْمِ <h>ٱ</>لْفَصْلِ"},{"n":14,"w":[["وَمَآ","wamā","And what","কি এবং"],["أَدْرَىٰكَ","adrāka","will make you know","তুমি জানো"],["مَا","mā","what","কি"],["يَوْمُ","yawmu","(is the) Day","দিন"],["ٱلْفَصْلِ","l-faṣli","(of) the Judgment","পৃৃথককারী (ফয়সালার)"]],"t":"وَ<o>مَآ</> أَ<q>دْ</>رَ<m>ىٰ</>كَ مَا يَوْمُ <h>ٱ</>لْفَصْلِ"},{"n":15,"w":[["وَيْلٌۭ","waylun","Woe","ধ্বংস"],["يَوْمَئِذٍۢ","yawma-idhin","that Day","সেইদিন"],["لِّلْمُكَذِّبِينَ","lil'mukadhibīna","to the deniers","মিথ্যারোপকারীদের জন্য"]],"t":"وَيْ<d>لٌۭ يَ</>وْمَئِ<w>ذٍۢ لِّ</>لْمُكَذِّ<p>بِي</>نَ"},{"n":16,"w":[["أَلَمْ","alam","Did not","নাই কি"],["نُهْلِكِ","nuh'liki","We destroy","ধ্বংস আমরা করি"],["ٱلْأَوَّلِينَ","l-awalīna","the former (people)","আগের লোকদের"]],"t":"أَلَمْ نُهْلِكِ <h>ٱ</>لْأَوَّ<p>لِي</>نَ"},{"n":17,"w":[["ثُمَّ","thumma","Then","এরপর"],["نُتْبِعُهُمُ","nut'bi‘uhumu","We follow them up","তাদের অনুগামি আমরা করব"],["ٱلْـَٔاخِرِينَ","l-ākhirīna","(with) the later ones","পর্ববর্তী লোকদের"]],"t":"ثُ<g>مَّ</> نُتْبِعُهُمُ <h>ٱ</>لْءَاخِ<p>رِي</>نَ"},{"n":18,"w":[["كَذَٰلِكَ","kadhālika","Thus","এরূপ"],["نَفْعَلُ","naf‘alu","We deal","করি আমরা"],["بِٱلْمُجْرِمِينَ","bil-muj'rimīna","with the criminals","অপরাধিদের সাথে"]],"t":"كَ<m>ذَٰ</>لِكَ نَفْعَلُ بِ<h>ٱ</>لْمُ<q>جْ</>رِ<p>مِي</>نَ"},{"n":19,"w":[["وَيْلٌۭ","waylun","Woe","ধ্বংস"],["يَوْمَئِذٍۢ","yawma-idhin","that Day","সেদিন"],["لِّلْمُكَذِّبِينَ","lil'mukadhibīna","to the deniers","মিথ্যারোপকারীদের জন্য"]],"t":"وَيْ<d>لٌۭ يَ</>وْمَئِ<w>ذٍۢ لِّ</>لْمُكَذِّ<p>بِي</>نَ"},{"n":20,"w":[["أَلَمْ","alam","Did not","নাই কি"],["نَخْلُقكُّم","nakhluqkkum","We create you","তোমাদেরকে সৃষ্টি আমরা করি"],["مِّن","min","from","থেকে"],["مَّآءٍۢ","māin","a water","পানি"],["مَّهِينٍۢ","mahīnin","despicable","তুচ্ছ"]],"t":"أَلَمْ نَخْلُ<r>ق</><y>كُّم مِّ</><d>ن مَّ</><o>آ</><d>ءٍۢ مَّ</><p>هِي</>نٍۢ"},{"n":21,"w":[["فَجَعَلْنَـٰهُ","faja‘alnāhu","Then We placed it","তা আমরা আটকিয়ে অতঃপর রেখেছি"],["فِى","fī","in","মধ্যে"],["قَرَارٍۢ","qarārin","an abode","স্থানের"],["مَّكِينٍ","makīnin","safe","সংরক্ষিত"]],"t":"فَجَعَلْ<m>نَٰ</>هُ فِى قَرَا<d>رٍۢ مَّ</><p>كِي</>نٍ"},{"n":22,"w":[["إِلَىٰ","ilā","For","পর্যন্ত"],["قَدَرٍۢ","qadarin","a period","সময়"],["مَّعْلُومٍۢ","ma‘lūmin","known","নির্দিষ্ট"]],"t":"إِلَىٰ قَدَ<d>رٍۢ مَّ</>عْ<p>لُو</>مٍۢ"},{"n":23,"w":[["فَقَدَرْنَا","faqadarnā","So We measured","আমরা ক্ষমতাবান অতএব ছিলাম"],["فَنِعْمَ","fani‘'ma","and Best","কত উত্তম অতএব"],["ٱلْقَـٰدِرُونَ","l-qādirūna","(are We to) measure","ক্ষমতার অধিকারী"]],"t":"فَقَدَرْنَا فَنِعْمَ <h>ٱ</>لْ<m>قَٰ</>دِ<p>رُو</>نَ"},{"n":24,"w":[["وَيْلٌۭ","waylun","Woe","ধ্বংস"],["يَوْمَئِذٍۢ","yawma-idhin","that Day","সেদিন"],["لِّلْمُكَذِّبِينَ","lil'mukadhibīna","to the deniers","মিথ্যারোপকারীদের জন্য"]],"t":"وَيْ<d>لٌۭ يَ</>وْمَئِ<w>ذٍۢ لِّ</>لْمُكَذِّ<p>بِي</>نَ"},{"n":25,"w":[["أَلَمْ","alam","Have not","নাই কি"],["نَجْعَلِ","naj‘ali","We made","সৃষ্টি করি আমরা"],["ٱلْأَرْضَ","l-arḍa","the earth","পৃথিবী কে"],["كِفَاتًا","kifātan","a receptacle","ধারণকারী রূপে"]],"t":"أَلَمْ نَ<q>جْ</>عَلِ <h>ٱ</>لْأَرْضَ كِفَاتًا"},{"n":26,"w":[["أَحْيَآءًۭ","aḥyāan","(For the) living","জীবিিতদের"],["وَأَمْوَٰتًۭا","wa-amwātan","and (the) dead","ও মৃতদের"]],"t":"أَحْ<o>يَآ</><d>ءًۭ وَ</>أَمْ<m>وَٰ</>تًۭا"},{"n":27,"w":[["وَجَعَلْنَا","waja‘alnā","And We made","এবং আমরা বাা