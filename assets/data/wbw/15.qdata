{"n":15,"a":[{"n":1,"w":[["الٓر ۚ","alif-lam-ra","Alif Laam Ra","আলিফ লা-ম রা-"],["تِلْكَ","til'ka","These","এগুলো"],["ءَايَـٰتُ","āyātu","(are) the Verses","আয়াত"],["ٱلْكِتَـٰبِ","l-kitābi","(of) the Book","কিতাবের"],["وَقُرْءَانٍۢ","waqur'ānin","and Quran","এবং কুরআনের"],["مُّبِينٍۢ","mubīnin","clear","(যা) সুষ্পষ্ট"]],"t":"ا<n>لٓ</>ر ۚ تِلْكَ ءَا<m>يَٰ</>تُ <h>ٱ</>لْكِ<m>تَٰ</>بِ وَقُرْءَا<d>نٍۢ مُّ</><p>بِي</>نٍۢ"},{"n":2,"w":[["رُّبَمَا","rubamā","Perhaps","কখনও কখনও"],["يَوَدُّ","yawaddu","will wish","আকাঙ্ক্ষা করবে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieved","অস্বীকার করেছে"],["لَوْ","law","if","যদি"],["كَانُوا۟","kānū","they had been","তারা হতো"],["مُسْلِمِينَ","mus'limīna","Muslims","(আত্মসমর্পণকারী) মুসলমান"]],"t":"رُّبَمَا يَوَدُّ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> لَوْ كَانُو<s>ا۟</> مُسْلِ<p>مِي</>نَ"},{"n":3,"w":[["ذَرْهُمْ","dharhum","Leave them","তাদেরকে ছেড়ে দাও"],["يَأْكُلُوا۟","yakulū","(to) eat","তারা খেতে থাকুক"],["وَيَتَمَتَّعُوا۟","wayatamatta‘ū","and enjoy","ও তারা ভোগ করুক"],["وَيُلْهِهِمُ","wayul'hihimu","and diverted them","এবং তাদেরকে মোহাচ্ছন্ন রাখুক"],["ٱلْأَمَلُ ۖ","l-amalu","the hope","আশা আকাঙ্ক্ষা"],["فَسَوْفَ","fasawfa","then soon","অতঃপর শীঘ্রই"],["يَعْلَمُونَ","ya‘lamūna","they will come to know","তারা জানবে"]],"t":"ذَرْهُمْ يَأْكُلُو<s>ا۟</> وَيَتَمَتَّعُو<s>ا۟</> وَيُلْهِهِمُ <h>ٱ</>لْأَمَلُ ۖ فَسَوْفَ يَعْلَ<p>مُو</>نَ"},{"n":4,"w":[["وَمَآ","wamā","And not","এবং না"],["أَهْلَكْنَا","ahlaknā","We destroyed","আমরা ধ্বংস করি"],["مِن","min","any","কোনো"],["قَرْيَةٍ","qaryatin","town","জনবসতিকে"],["إِلَّا","illā","but","এ ছাড়া যে"],["وَلَهَا","walahā","(there was) for it","এবং তার জন্যে ছিলো"],["كِتَابٌۭ","kitābun","a decree","লিখিত মেয়াদ"],["مَّعْلُومٌۭ","ma‘lūmun","known","নির্দিষ্ট"]],"t":"وَ<o>مَآ</> أَهْلَكْنَا مِ<k>ن قَ</>رْيَةٍ إِلَّا وَلَهَا كِتَا<d>بٌۭ مَّ</>عْ<p>لُو</>مٌۭ"},{"n":5,"w":[["مَّا","mā","Not","না"],["تَسْبِقُ","tasbiqu","(can) advance","এগিয়ে আনতে পারে"],["مِنْ","min","any","কোনো"],["أُمَّةٍ","ummatin","nation","জাতি"],["أَجَلَهَا","ajalahā","its term","তার কালকে"],["وَمَا","wamā","and not","আর না"],["يَسْتَـْٔخِرُونَ","yastakhirūna","(can) delay it","দেরি করতে পারে"]],"t":"مَّا تَسْبِقُ مِنْ أُ<g>مَّ</>ةٍ أَجَلَهَا وَمَا يَسْتَـْٔخِ<p>رُو</>نَ"},{"n":6,"w":[["وَقَالُوا۟","waqālū","And they say","এবং তারা বলে"],["يَـٰٓأَيُّهَا","yāayyuhā","O you","\"হে"],["ٱلَّذِى","alladhī","(to) whom","যে"],["نُزِّلَ","nuzzila","has been sent down","অবতীর্ণ হয়েছে"],["عَلَيْهِ","‘alayhi","[on him]","তার উপর"],["ٱلذِّكْرُ","l-dhik'ru","the Reminder","উপদেশ বাণী(কুরআন)"],["إِنَّكَ","innaka","indeed, you","নিশ্চয়ই তুমি"],["لَمَجْنُونٌۭ","lamajnūnun","(are) surely mad","অবশ্যই পাগল"]],"t":"وَقَالُو<s>ا۟</> <o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِى نُزِّلَ عَلَيْهِ <h>ٱ</><l>ل</>ذِّكْرُ إِ<g>نَّ</>كَ لَمَ<q>جْ</><p>نُو</>نٌۭ"},{"n":7,"w":[["لَّوْ","law","Why","কেন"],["مَا","mā","not","না"],["تَأْتِينَا","tatīnā","you bring to us","আমাদের কাছে আসো"],["بِٱلْمَلَـٰٓئِكَةِ","bil-malāikati","the Angels","নিয়ে ফেরেশতাদের"],["إِن","in","if","যদি"],["كُنتَ","kunta","you are","তুমি হয়ে থাকো"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلصَّـٰدِقِينَ","l-ṣādiqīna","the truthful","সত্যবাদীদের\""]],"t":"لَّوْ مَا تَأْتِينَا بِ<h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةِ إِ<k>ن كُنتَ</> مِنَ <h>ٱ</><l>ل</><m>صَّٰ</>دِ<p>قِي</>نَ"},{"n":8,"w":[["مَا","mā","Not","না"],["نُنَزِّلُ","nunazzilu","We send down","আমরা অবতীর্ণ করি"],["ٱلْمَلَـٰٓئِكَةَ","l-malāikata","the Angels","ফেরেশতাদেরকে"],["إِلَّا","illā","except","ছাড়া"],["بِٱلْحَقِّ","bil-ḥaqi","with the truth","দিয়ে সত্য"],["وَمَا","wamā","and not","এবং না"],["كَانُوٓا۟","kānū","they would be","তারা হবে"],["إِذًۭا","idhan","then","তখন"],["مُّنظَرِينَ","munẓarīna","given respite","অবকাশপ্রাপ্ত"]],"t":"مَا نُنَزِّلُ <h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةَ إِلَّا بِ<h>ٱ</>لْحَقِّ وَمَا كَا<o>نُوٓ</><s>ا۟</> إِ<d>ذًۭا مُّ</><k>نظَ</><p>رِي</>نَ"},{"n":9,"w":[["إِنَّا","innā","Indeed, We","নিশ্চয়ই"],["نَحْنُ","naḥnu","We","আমরা"],["نَزَّلْنَا","nazzalnā","have sent down","আমরা অবতীর্ণ করেছি"],["ٱلذِّكْرَ","l-dhik'ra","the Reminder","উপদেশ বাণী (কুরআন)"],["وَإِنَّا","wa-innā","and indeed, We","এবং নিশ্চয়ই আমরা"],["لَهُۥ","lahu","of it","জন্যে তার"],["لَحَـٰفِظُونَ","laḥāfiẓūna","(are) surely Guardians","অবশ্যই সংরক্ষক"]],"t":"إِ<g>نَّ</>ا نَحْنُ نَزَّلْنَا <h>ٱ</><l>ل</>ذِّكْرَ وَإِ<g>نَّ</>ا لَهُ<m>ۥ</> لَ<m>حَٰ</>فِ<p>ظُو</>نَ"},{"n":10,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["أَرْسَلْنَا","arsalnā","We (had) sent","আমরা পাঠিয়েছি"],["مِن","min","before you","থেকে"],["قَبْلِكَ","qablika","before you","তোমার পূর্ব"],["فِى","fī","in","কাছে (রাসূলদেরকে)"],["شِيَعِ","shiya‘i","the sects","জাতিগুলোর"],["ٱلْأَوَّلِينَ","l-awalīna","(of) the former (people)","পূর্ববর্তী"]],"t":"وَلَقَ<q>دْ</> أَرْسَلْنَا مِ<k>ن قَ</><q>بْ</>لِكَ فِى شِيَعِ <h>ٱ</>لْأَوَّ<p>لِي</>نَ"},{"n":11,"w":[["وَمَا","wamā","And not","এবং নি"],["يَأْتِيهِم","yatīhim","came to them","তাদের কাছে আসে"],["مِّن","min","any","কোনো"],["رَّسُولٍ","rasūlin","Messenger","রাসূল"],["إِلَّا","illā","but","এ ছাড়া যে"],["كَانُوا۟","kānū","they did","তারা ছিলো"],["بِهِۦ","bihi","at him","সাথে তার"],["يَسْتَهْزِءُونَ","yastahziūna","mock","তারা বিদ্রুপ করতো"]],"t":"وَمَا يَأْتِي<y>هِم مِّ</><w>ن رَّ</>سُولٍ إِلَّا كَانُو<s>ا۟</> بِ<m>هِۦ</> يَسْتَهْزِ<p>ءُو</>نَ"},{"n":12,"w":[["كَذَٰلِكَ","kadhālika","Thus","এভাবে"],["نَسْلُكُهُۥ","naslukuhu","We let it enter","তা প্রবেশ করাই আমরা"],["فِى","fī","in","মধ্যে"],["قُلُوبِ","qulūbi","(the) hearts","অন্তরসমূহের"],["ٱلْمُجْرِمِينَ","l-muj'rimīna","(of) the criminals","অপরাধীদের"]],"t":"كَ<m>ذَٰ</>لِكَ نَسْلُكُهُ<m>ۥ</> فِى قُلُوبِ <h>ٱ</>لْمُ<q>جْ</>رِ<p>مِي</>نَ"},{"n":13,"w":[["لَا","lā","Not","না"],["يُؤْمِنُونَ","yu'minūna","they believe","তারা ঈমান আনে"],["بِهِۦ ۖ","bihi","in it","উপর তার"],["وَقَدْ","waqad","and verily","এবং নিশ্চয়ই"],["خَلَتْ","khalat","have passed","চলে গেছে"],["سُنَّةُ","sunnatu","the way(s)","রীতি"],["ٱلْأَوَّلِينَ","l-awalīna","(of) the former (people)","পূর্ববর্তীদের"]],"t":"لَا يُؤْمِنُونَ بِ<m>هِۦ</> ۖ وَقَ<q>دْ</> خَلَتْ سُ<g>نَّ</>ةُ <h>ٱ</>لْأَوَّ<p>لِي</>نَ"},{"n":14,"w":[["وَلَوْ","walaw","And (even) if","এবং যদি"],["فَتَحْنَا","fataḥnā","We opened","আমরা খুলে দিই"],["عَلَيْهِم","‘alayhim","to them","তাদের উপর"],["بَابًۭا","bāban","a gate","কোনো দরজা"],["مِّنَ","mina","from","থেকে"],["ٱلسَّمَآءِ","l-samāi","the heaven","আকাশ"],["فَظَلُّوا۟","faẓallū","and they were to continue","অতঃপর তারা থাকতো"],["فِيهِ","fīhi","therein","তার মধ্যে"],["يَعْرُجُونَ","ya‘rujūna","(to) ascend","চড়তে"]],"t":"وَلَوْ فَتَحْنَا عَلَيْ<f>هِم بَ</>ا<d>بًۭا مِّ</>نَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ فَظَلُّو<s>ا۟</> فِيهِ يَعْرُ<p>جُو</>نَ"},{"n":15,"w":[["لَقَالُوٓا۟","laqālū","They would surely say","অবশ্যই তারা বলতো"],["إِنَّمَا","innamā","Only","\"প্রকৃতপক্ষে"],["سُكِّرَتْ","sukkirat","have been dazzled","সম্মোহিত করা হয়েছে"],["أَبْصَـٰرُنَا","abṣārunā","our eyes","আমাদের দৃষ্টিগুলো"],["بَلْ","bal","Nay","বরং"],["نَحْنُ","naḥnu","we","আমরা"],["قَوْمٌۭ","qawmun","(are) a people","সম্প্রদায়"],["مَّسْحُورُونَ","masḥūrūna","bewitched","জাদুগ্রস্ত\""]],"t":"لَقَا<o>لُوٓ</><s>ا۟</> إِ<g>نَّ</>مَا سُكِّرَتْ أَ<q>بْ</><m>صَٰ</>رُنَا بَلْ نَحْنُ قَوْ<d>مٌۭ مَّ</>سْحُو<p>رُو</>نَ"},{"n":16,"w":[["وَلَقَدْ","walaqad","And verily","এবং নিশ্চয়ই"],["جَعَلْنَا","ja‘alnā","We have placed","আমরা বানিয়েছি"],["فِى","fī","in","মধ্যে"],["ٱلسَّمَآءِ","l-samāi","the heavens","আকাশের"],["بُرُوجًۭا","burūjan","constellations","গ্রহনক্ষত্র"],["وَزَيَّنَّـٰهَا","wazayyannāhā","and We have beautified it","ও তা আমরা সুশোভিত করেছি"],["لِلنَّـٰظِرِينَ","lilnnāẓirīna","for the observers","দর্শকদের জন্যে"]],"t":"وَلَقَ<q>دْ</> جَعَلْنَا فِى <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ بُرُو<d>جًۭا وَ</>زَيَّ<g>نَّٰ</>هَا لِل<g>نَّٰ</>ظِ<p>رِي</>نَ"},{"n":17,"w":[["وَحَفِظْنَـٰهَا","waḥafiẓ'nāhā","And We have protected it","এবং আমরা রক্ষা করেছি তা"],["مِن","min","from","থেকে"],["كُلِّ","kulli","every","প্রত্যেক"],["شَيْطَـٰنٍۢ","shayṭānin","devil","শয়তান"],["رَّجِيمٍ","rajīmin","accursed","অভিশপ্ত"]],"t":"وَحَفِظْ<m>نَٰ</>هَا مِ<k>ن كُ</>لِّ شَيْ<m>طَٰ</><w>نٍۢ رَّ</><p>جِي</>مٍ"},{"n":18,"w":[["إِلَّا","illā","Except","কিন্তু"],["مَنِ","mani","(one) who","যে"],["ٱسْتَرَقَ","is'taraqa","steals","চুরি করে"],["ٱلسَّمْعَ","l-sam‘a","the hearing","শুনতে চায়"],["فَأَتْبَعَهُۥ","fa-atba‘ahu","then follows him","তখন তার পিছু ধাওয়া করে"],["شِهَابٌۭ","shihābun","a burning flame","অগ্নি শিখা"],["مُّبِينٌۭ","mubīnun","clear","উজ্জ্বল"]],"t":"إِلَّا مَنِ <h>ٱ</>سْتَرَقَ <h>ٱ</><l>ل</>سَّمْعَ فَأَتْبَعَهُ<m>ۥ</> شِهَا<d>بٌۭ مُّ</><p>بِي</>نٌۭ"},{"n":19,"w":[["وَٱلْأَرْضَ","wal-arḍa","And the earth","এবং জমিনকে"],["مَدَدْنَـٰهَا","madadnāhā","We have spread it","আমরা বিস্তৃত করেছি তা"],["وَأَلْقَيْنَا","wa-alqaynā","and [We] cast","ও আমরা স্থাপন করেছি"],["فِيهَا","fīhā","therein","তার মধ্যে"],["رَوَٰسِىَ","rawāsiya","firm mountains","পর্বতমালা"],["وَأَنۢبَتْنَا","wa-anbatnā","and [We] caused to grow","এবং আমরা উদগত করেছি"],["فِيهَا","fīhā","therein","তার মধ্যে"],["مِن","min","of","থেকে"],["كُلِّ","kulli","every","প্রত্যেক"],["شَىْءٍۢ","shayin","thing","বস্তু"],["مَّوْزُونٍۢ","mawzūnin","well-balanced","সুপরিমিত"]],"t":"وَ<h>ٱ</>لْأَرْضَ مَدَ<q>دْ</><m>نَٰ</>هَا وَأَلْقَيْنَا فِيهَا رَ<m>وَٰ</>سِىَ وَأَ<i>نۢبَ</>تْنَا فِيهَا مِ<k>ن كُ</>لِّ <d>شَىْءٍۢ مَّ</>وْ<p>زُو</>نٍۢ"},{"n":20,"w":[["وَجَعَلْنَا","waja‘alnā","And We have made","এবং আমরা ব্যবস্হা করেছি"],["لَكُمْ","lakum","for you","তোমাদের জন্যে"],["فِيهَا","fīhā","therein","তার মধ্যে"],["مَعَـٰيِشَ","ma‘āyisha","means of living","জীবিকার উপকরণসমূহ"],["وَمَن","waman","and whom","এবং যাকে"],["لَّسْتُمْ","lastum","you are not","তোমরা নও"],["لَهُۥ","lahu","for him","জন্যে তার"],["بِرَٰزِقِينَ","birāziqīna","providers","জীবিকাদাতা"]],"t":"وَجَعَلْنَا لَكُمْ فِيهَا مَ<m>عَٰ</>يِشَ وَ<w>مَن لَّ</>سْتُمْ لَهُ<m>ۥ</> بِ<m>رَٰ</>زِ<p>قِي</>نَ"},{"n":21,"w":[["وَإِن","wa-in","And not","এবং নেই"],["مِّن","min","(is) any","কোনো"],["شَىْءٍ","shayin","thing","জিনিস"],["إِلَّا","illā","but","এ ছাড়া যে"],["عِندَنَا","‘indanā","with Us","আমাদের কাছে আছে"],["خَزَآئِنُهُۥ","khazāinuhu","(are) its treasures","তার ভান্ডারসমূহ"],["وَمَا","wamā","and not","("],["نُنَزِّلُهُۥٓ","nunazziluhu","We send it down","আমরা অবতরণ করি তা"],["إِلَّا","illā","except","এ ছাড়া যে"],["بِقَدَرٍۢ","biqadarin","in a measure","সহ পরিমাণ"],["مَّعْلُومٍۢ","ma‘lūmin","known","নির্দিষ্ট"]],"t":"وَ<d>إِن مِّ</><k>ن شَ</>ىْءٍ إِلَّا عِ<k>ندَ</>نَا خَ<o>زَآ</>ئِنُهُ<m>ۥ</> وَمَا نُنَزِّلُهُ<o>ۥٓ</> إِلَّا بِقَدَ<d>رٍۢ مَّ</>عْ<p>لُو</>مٍۢ"},{"n":22,"w":[["وَأَرْسَلْنَا","wa-arsalnā","And We have sent","এবং আমরা পাঠাই"],["ٱلرِّيَـٰحَ","l-riyāḥa","the winds","বাতাস"],["لَوَٰقِحَ","lawāqiḥa","fertilizing","বৃষ্টিবাহী"],["فَأَنزَلْنَا","fa-anzalnā","and We sent down","অতপর আমরা বর্ষণ করি"],["مِنَ","mina","from","থেকে"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশ"],["مَآءًۭ","māan","water","পানি"],["فَأَسْقَيْنَـٰكُمُوهُ","fa-asqaynākumūhu","and We gave it to you to drink","অতঃপর পান করাই তা আমরা তোমাদের"],["وَمَآ","wamā","And not","এবং নও"],["أَنتُمْ","antum","you","তোমরা"],["لَهُۥ","lahu","of it","তার জন্যে"],["بِخَـٰزِنِينَ","bikhāzinīna","(are) retainers","ভান্ডার রক্ষাকারী"]],"t":"وَأَرْسَلْنَا <h>ٱ</><l>ل</>رِّ<m>يَٰ</>حَ لَ<m>وَٰ</>قِحَ فَأَ<k>نزَ</>لْنَا مِنَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ <o>مَآ</><k>ءًۭ فَ</>أَسْقَيْ<m>نَٰ</>كُمُوهُ وَ<o>مَآ</> أَ<k>نتُ</>مْ لَهُ<m>ۥ</> بِ<m>خَٰ</>زِ<p>نِي</>نَ"},{"n":23,"w":[["وَإِنَّا","wa-innā","And indeed, We","এবং নিশ্চয়ই আমরা"],["لَنَحْنُ","lanaḥnu","surely [We]","অবশ্যই আমরা"],["نُحْىِۦ","nuḥ'yī","We give life","আমরা জীবন দিই"],["وَنُمِيتُ","wanumītu","and We cause death","ও আমরা মৃত্যু দিই"],["وَنَحْنُ","wanaḥnu","and We","এবং আমরাই"],["ٱلْوَٰرِثُونَ","l-wārithūna","(are) the Inheritors","উত্তরাধিকারী (সকলেরই)"]],"t":"وَإِ<g>نَّ</>ا لَنَحْنُ نُحْ<m>ىِۦ</> وَنُمِيتُ وَنَحْنُ <h>ٱ</>لْ<m>وَٰ</>رِ<p>ثُو</>نَ"},{"n":24,"w":[["وَلَقَدْ","walaqad","And verily","এবং নিশ্চয়ই"],["عَلِمْنَا","‘alim'nā","We know","আমরা জানি"],["ٱلْمُسْتَقْدِمِينَ","l-mus'taqdimīna","the preceding ones","অগ্রগামীদেরকে"],["مِنكُمْ","minkum","among you","তোমাদের মধ্য থেকে"],["وَلَقَدْ","walaqad","and verily","ও নিশ্চয়ই"],["عَلِمْنَا","‘alim'nā","We know","আমরা জানি"],["ٱلْمُسْتَـْٔخِرِينَ","l-mus'takhirīna","the later ones","পরে আগমনকারীদেরকে"]],"t":"وَلَقَ<q>دْ</> عَلِمْنَا <h>ٱ</>لْمُسْتَ<q>قْ</>دِمِينَ مِ<k>نكُ</>مْ وَلَقَ<q>دْ</> عَلِمْنَا <h>ٱ</>لْمُسْتَـْٔخِ<p>رِي</>نَ"},{"n":25,"w":[["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["رَبَّكَ","rabbaka","your Lord","তোমার রব"],["هُوَ","huwa","He","তিনিই"],["يَحْشُرُهُمْ ۚ","yaḥshuruhum","will gather them","তাদের একত্র করবেন"],["إِنَّهُۥ","innahu","Indeed, He","নিশ্চয়ই তিনি"],["حَكِيمٌ","ḥakīmun","(is) All-Wise","প্রজ্ঞাময়"],["عَلِيمٌۭ","‘alīmun","All-Knowing","জ্ঞানময়"]],"t":"وَإِ<g>نَّ</> رَبَّكَ هُوَ يَحْشُرُهُمْ ۚ إِ<g>نَّ</>هُ<m>ۥ</> حَكِيمٌ عَ<p>لِي</>مٌۭ"},{"n":26,"w":[["وَلَقَدْ","walaqad","And verily","এবং নিশ্চয়ই"],["خَلَقْنَا","khalaqnā","We created","আমরা সৃষ্টি করেছি"],["ٱلْإِنسَـٰنَ","l-insāna","humankind","মানুষকে"],["مِن","min","(out) of","থেকে"],["صَلْصَـٰلٍۢ","ṣalṣālin","sounding clay","শুকনো ঠনঠনে মাটি"],["مِّنْ","min","from","(তৈরী) থেকে"],["حَمَإٍۢ","ḥama-in","black mud","কাদা"],["مَّسْنُونٍۢ","masnūnin","altered","দুর্গন্ধযুক্ত"]],"t":"وَلَقَ<q>دْ</> خَلَ<q>قْ</>نَا <h>ٱ</>لْإِ<k>نسَٰ</>نَ مِ<k>ن صَ</>لْ<m>صَٰ</><d>لٍۢ مِّ</>نْ حَمَ<d>إٍۢ مَّ</>سْ<p>نُو</>نٍۢ"},{"n":27,"w":[["وَٱلْجَآنَّ","wal-jāna","And the jinn","এবং জিন"],["خَلَقْنَـٰهُ","khalaqnāhu","We created it","আমরা সৃষ্টি করেছি তাকে"],["مِن","min","before","থেকে"],["قَبْلُ","qablu","before","পূর্ব"],["مِن","min","from","থেকে"],["نَّارِ","nāri","fire","আগুন"],["ٱلسَّمُومِ","l-samūmi","scorching","অতি উত্তপ্ত"]],"t":"وَ<h>ٱ</>لْ<n>جَآ</><g>نَّ</> خَلَ<q>قْ</><m>نَٰ</>هُ مِ<k>ن قَ</><q>بْ</>لُ <d>مِن نَّ</>ارِ <h>ٱ</><l>ل</>سَّ<p>مُو</>مِ"},{"n":28,"w":[["وَإِذْ","wa-idh","And when","এবং (স্মরণ করো) যখন"],["قَالَ","qāla","your Lord said","বলেছিলেন"],["رَبُّكَ","rabbuka","your Lord said","তোমার রব"],["لِلْمَلَـٰٓئِكَةِ","lil'malāikati","to the Angels","ফেরেশতাদেরকে"],["إِنِّى","innī","Indeed, I","\"নিশ্চয়ই আমি"],["خَـٰلِقٌۢ","khāliqun","(will) create","(শীঘ্র) সৃষ্টিকারী"],["بَشَرًۭا","basharan","a human being","মানুষ"],["مِّن","min","(out) of","থেকে"],["صَلْصَـٰلٍۢ","ṣalṣālin","clay","শুকনো ঠনঠনে মাটি"],["مِّنْ","min","from","থেকে (তৈরী)"],["حَمَإٍۢ","ḥama-in","black mud","কাদা"],["مَّسْنُونٍۢ","masnūnin","altered","দুর্গন্ধযুক্ত"]],"t":"وَإِذْ قَالَ رَبُّكَ لِلْمَ<o>لَٰٓ</>ئِكَةِ إِ<g>نِّ</>ى <m>خَٰ</>لِ<i>قٌۢ بَ</>شَ<d>رًۭا مِّ</><k>ن صَ</>لْ<m>صَٰ</><d>لٍۢ مِّ</>نْ حَمَ<d>إٍۢ مَّ</>سْ<p>نُو</>نٍۢ"},{"n":29,"w":[["فَإِذَا","fa-idhā","So, when","অতঃপর যখন"],["سَوَّيْتُهُۥ","sawwaytuhu","I have fashioned him","আমি সুঠাম করবো তাকে"],["وَنَفَخْتُ","wanafakhtu","and [I] breathed","ও আমি ফুঁকে দিবো"],["فِيهِ","fīhi","into him","তার মধ্যে"],["مِن","min","of","থেকে কিছু"],["رُّوحِى","rūḥī","My spirit","আমার রুহ"],["فَقَعُوا۟","faqa‘ū","then fall down","তোমার তখন হয়ে পড়ো"],["لَهُۥ","lahu","to him","তার জন্যে"],["سَـٰجِدِينَ","sājidīna","prostrating","সিজদাকারী\""]],"t":"فَإِذَا سَوَّيْتُهُ<m>ۥ</> وَنَفَخْتُ فِيهِ <w>مِن رُّ</>وحِى فَقَعُو<s>ا۟</> لَهُ<m>ۥ سَٰ</>جِ<p>دِي</>نَ"},{"n":30,"w":[["فَسَجَدَ","fasajada","So prostrated","অতঃপর সিজদা করলো"],["ٱلْمَلَـٰٓئِكَةُ","l-malāikatu","the Angels","ফেরেশতারা"],["كُلُّهُمْ","kulluhum","all of them","তাদের সবাই"],["أَجْمَعُونَ","ajma‘ūna","together","একত্রে"]],"t":"فَسَجَدَ <h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةُ كُلُّهُمْ أَ<q>جْ</>مَ<p>عُو</>نَ"},{"n":31,"w":[["إِلَّآ","illā","Except","ছাড়া"],["إِبْلِيسَ","ib'līsa","Iblis","ইবলীস"],["أَبَىٰٓ","abā","He refused","সে অস্বীকার করলো"],["أَن","an","to","যে"],["يَكُونَ","yakūna","be","হবে"],["مَعَ","ma‘a","with","অন্তর্ভুক্ত"],["ٱلسَّـٰجِدِينَ","l-sājidīna","those who prostrated","সিজদাকারীদের"]],"t":"إِ<o>لَّآ</> إِ<q>بْ</>لِيسَ أَبَ<o>ىٰٓ</> <d>أَن يَ</>كُونَ مَعَ <h>ٱ</><l>ل</><m>سَّٰ</>جِ<p>دِي</>نَ"},{"n":32,"w":[["قَالَ","qāla","He said","তিনি বললেন"],["يَـٰٓإِبْلِيسُ","yāib'līsu","O Iblis","\"হে ইবলীস"],["مَا","mā","What","কি"],["لَكَ","laka","(is) for you","তোমার হয়েছে"],["أَلَّا","allā","that not","যে না"],["تَكُونَ","takūna","you are","তুমি হ'লে"],["مَعَ","ma‘a","with","সাথে"],["ٱلسَّـٰجِدِينَ","l-sājidīna","those who prostrated","সিজদাকারীদের\""]],"t":"قَالَ <o>يَٰٓ</>إِ<q>بْ</>لِيسُ مَا لَكَ أَلَّا تَكُونَ مَعَ <h>ٱ</><l>ل</><m>سَّٰ</>جِ<p>دِي</>نَ"},{"n":33,"w":[["قَالَ","qāla","He said","সে বললো"],["لَمْ","lam","I am not","\"নি"],["أَكُن","akun","I am not","\"আমি হই"],["لِّأَسْجُدَ","li-asjuda","(one) to prostrate","জন্যে আমি সিজদা করার"],["لِبَشَرٍ","libasharin","to a human","মানুষকে"],["خَلَقْتَهُۥ","khalaqtahu","whom You created","আপনি সৃষ্টি করেছেন তাকে"],["مِن","min","(out) of","হ'তে"],["صَلْصَـٰلٍۢ","ṣalṣālin","clay","শুকনো ঠনঠনে মাটি"],["مِّنْ","min","from","তৈরী (থেকে)"],["حَمَإٍۢ","ḥama-in","black mud","কাদা"],["مَّسْنُونٍۢ","masnūnin","altered","দুর্গন্ধযুক্ত\""]],"t":"قَالَ لَمْ أَ<w>كُن لِّ</>أَسْجُدَ لِبَشَرٍ خَلَ<q>قْ</>تَهُ<m>ۥ</> مِ<k>ن صَ</>لْ<m>صَٰ</><d>لٍۢ مِّ</>نْ حَمَ<d>إٍۢ مَّ</>سْ<p>نُو</>نٍۢ"},{"n":34,"w":[["قَالَ","qāla","He said","তিনি বললেন"],["فَٱخْرُجْ","fa-ukh'ruj","Then get out","\"তাহ'লে বের হও"],["مِنْهَا","min'hā","of it","তা থেকে"],["فَإِنَّكَ","fa-innaka","for indeed, you","কারণ নিশ্চয়ই তুমি"],["رَجِيمٌۭ","rajīmun","(are) expelled","বিতাড়িত"]],"t":"قَالَ فَ<h>ٱ</>خْرُ<q>جْ</> مِنْهَا فَإِ<g>نَّ</>كَ رَ<p>جِي</>مٌۭ"},{"n":35,"w":[["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["عَلَيْكَ","‘alayka","upon you","তোমার উপর"],["ٱللَّعْنَةَ","l-la‘nata","(will be) the curse","অভিশাপ"],["إِلَىٰ","ilā","till","পর্যন্ত"],["يَوْمِ","yawmi","(the) Day","দিন"],["ٱلدِّينِ","l-dīni","(of) [the] Judgment","বিচারের\""]],"t":"وَإِ<g>نَّ</> عَلَيْكَ <h>ٱ</><l>ل</>لَّعْنَةَ إِلَىٰ يَوْمِ <h>ٱ</><l>ل</><p>دِّي</>نِ"},{"n":36,"w":[["قَالَ","qāla","He said","সে বললো"],["رَبِّ","rabbi","O my Lord","\"হে আমার রব"],["فَأَنظِرْنِىٓ","fa-anẓir'nī","Then give me respite","তবে আমাকে অবকাশ দিন"],["إِلَىٰ","ilā","till","পর্যন্ত"],["يَوْمِ","yawmi","(the) Day","দিবস"],["يُبْعَثُونَ","yub'‘athūna","they are raised","উত্থান\""]],"t":"قَالَ رَبِّ فَأَ<k>نظِ</>رْ<o>نِىٓ</> إِلَىٰ يَوْمِ يُ<q>بْ</>عَ<p>ثُو</>نَ"},{"n":37,"w":[["قَالَ","qāla","He said","তিনি বললেন"],["فَإِنَّكَ","fa-innaka","Then indeed you","\"তাহ'লে নিশ্চয়ই তুমি"],["مِنَ","mina","(are) of","অন্তর্ভুক্ত"],["ٱلْمُنظَرِينَ","l-munẓarīna","the ones given respite","অবকাশপ্রাপ্তদের"]],"t":"قَالَ فَإِ<g>نَّ</>كَ مِنَ <h>ٱ</>لْمُ<k>نظَ</><p>رِي</>نَ"},{"n":38,"w":[["إِلَىٰ","ilā","Till","পর্যন্ত"],["يَوْمِ","yawmi","the Day","(ক্বিয়ামাতের) দিন"],["ٱلْوَقْتِ","l-waqti","(of) the time","(যার) সময়"],["ٱلْمَعْلُومِ","l-ma‘lūmi","well-known","অবধারিত\""]],"t":"إِلَىٰ يَوْمِ <h>ٱ</>لْوَ<q>قْ</>تِ <h>ٱ</>لْمَعْ<p>لُو</>مِ"},{"n":39,"w":[["قَالَ","qāla","He said","সে বললো"],["رَبِّ","rabbi","My Lord","\"হে আমার রব"],["بِمَآ","bimā","Because","যে কারণে"],["أَغْوَيْتَنِى","aghwaytanī","You misled me","আমাকে আপনি বিপথগামী করলেন"],["لَأُزَيِّنَنَّ","la-uzayyinanna","surely, I will make (evil) fair-seeming","অবশ্যই আমি সুশোভন করবো"],["لَهُمْ","lahum","to them","জন্যে তাদের"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["وَلَأُغْوِيَنَّهُمْ","wala-ugh'wiyannahum","and I will mislead them","এবং অবশ্যই আমি বিপথগামী করবো তাদেরকে"],["أَجْمَعِينَ","ajma‘īna","all","সকলকে"]],"t":"قَالَ رَبِّ بِ<o>مَآ</> أَغْوَيْتَنِى لَأُزَيِّنَ<g>نَّ</> لَهُمْ فِى <h>ٱ</>لْأَرْضِ وَلَأُغْوِيَ<g>نَّ</>هُمْ أَ<q>جْ</>مَ<p>عِي</>نَ"},{"n":40,"w":[["إِلَّا","illā","Except","ছাড়া"],["عِبَادَكَ","‘ibādaka","Your slaves","আপনার দাসদের"],["مِنْهُمُ","min'humu","among them","তাদের মধ্য হ'তে"],["ٱلْمُخْلَصِينَ","l-mukh'laṣīna","the ones who are sincere","একনিষ্ঠ\""]],"t":"إِلَّا عِبَادَكَ مِنْهُمُ <h>ٱ</>لْمُخْلَ<p>صِي</>نَ"},{"n":41,"w":[["قَالَ","qāla","He said","তিনি বললেন"],["هَـٰذَا","hādhā","This","\"এটা"],["صِرَٰطٌ","ṣirāṭun","(is) the way","পথ"],["عَلَىَّ","‘alayya","to Me","আমার দিকে"],["مُسْتَقِيمٌ","mus'taqīmun","straight","সরল"]],"t":"قَالَ <m>هَٰ</>ذَا صِ<m>رَٰ</>طٌ عَلَىَّ مُسْتَ<p>قِي</>مٌ"},{"n":42,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই (যারা)"],["عِبَادِى","‘ibādī","My slaves","আমার দাসরা"],["لَيْسَ","laysa","not","নেই"],["لَكَ","laka","you have","তোমার জন্যে"],["عَلَيْهِمْ","‘alayhim","over them","তাদের উপর"],["سُلْطَـٰنٌ","sul'ṭānun","any authority","কোন প্রভাব"],["إِلَّا","illā","except","এ ছাড়া"],["مَنِ","mani","those who","যে"],["ٱتَّبَعَكَ","ittaba‘aka","follow you","তোমার অনুসরণ করবে"],["مِنَ","mina","of","থেকে"],["ٱلْغَاوِينَ","l-ghāwīna","the ones who go astray","পথভ্রষ্ট\""]],"t":"إِ<g>نَّ</> عِبَادِى لَيْسَ لَكَ عَلَيْهِمْ سُلْ<m>طَٰ</>نٌ إِلَّا مَنِ <h>ٱ</>تَّبَعَكَ مِنَ <h>ٱ</>لْغَا<p>وِي</>نَ"},{"n":43,"w":[["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["جَهَنَّمَ","jahannama","Hell","জাহান্নাম"],["لَمَوْعِدُهُمْ","lamaw‘iduhum","(is) surely the promised place for them","অবশ্যই প্রতিশ্রুত স্হান তাদের"],["أَجْمَعِينَ","ajma‘īna","all","সকলের"]],"t":"وَإِ<g>نَّ</> جَهَ<g>نَّ</>مَ لَمَوْعِدُهُمْ أَ<q>جْ</>مَ<p>عِي</>نَ"},{"n":44,"w":[["لَهَا","lahā","For it","তার আছে"],["سَبْعَةُ","sab‘atu","(are) seven","সাতটি"],["أَبْوَٰبٍۢ","abwābin","gates","দরজা"],["لِّكُلِّ","likulli","for each","জন্যে প্রত্যেকটির"],["بَابٍۢ","bābin","gate","দরজার"],["مِّنْهُمْ","min'hum","among them","তাদের থেকে"],["جُزْءٌۭ","juz'on","(is) a portion","অংশ (দল)"],["مَّقْسُومٌ","maqsūmun","assigned","পৃথক পৃথক"]],"t":"لَهَا سَ<q>بْ</>عَةُ أَ<q>بْ</><m>وَٰ</><w>بٍۢ لِّ</>كُلِّ بَا<d>بٍۢ مِّ</>نْهُمْ جُزْ<d>ءٌۭ مَّ</><q>قْ</><p>سُو</>مٌ"},{"n":45,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلْمُتَّقِينَ","l-mutaqīna","the righteous","মুত্তাকীরা"],["فِى","fī","(will be) in","মধ্যে (থাকবে)"],["جَنَّـٰتٍۢ","jannātin","Gardens","জান্নাতের"],["وَعُيُونٍ","wa‘uyūnin","and water springs","ও ঝর্ণাধারাসমূহের"]],"t":"إِ<g>نَّ</> <h>ٱ</>لْمُتَّقِينَ فِى جَ<g>نَّٰ</><d>تٍۢ وَ</>عُ<p>يُو</>نٍ"},{"n":46,"w":[["ٱدْخُلُوهَا","ud'khulūhā","Enter it","\"তাতে তোমরা প্রবেশ করো"],["بِسَلَـٰمٍ","bisalāmin","in peace","সাথে শান্তির"],["ءَامِنِينَ","āminīna","secure","নিরাপদে\""]],"t":"ٱ<q>دْ</>خُلُوهَا بِسَ<m>لَٰ</>مٍ ءَامِ<p>نِي</>نَ"},{"n":47,"w":[["وَنَزَعْنَا","wanaza‘nā","And We (will) remove","এবং আমরা দূর করে দিবো"],["مَا","mā","what","যা"],["فِى","fī","(is) in","মধ্যে আছে"],["صُدُورِهِم","ṣudūrihim","their breasts","তাদের অন্তরসমূহের"],["مِّنْ","min","of","থেকে"],["غِلٍّ","ghillin","rancor","ঈর্ষা"],["إِخْوَٰنًا","ikh'wānan","(they will be) brothers","ভাই ভাই হয়ে (তারা বসবে)"],["عَلَىٰ","‘alā","on","উপর"],["سُرُرٍۢ","sururin","thrones","আসনসমূহের"],["مُّتَقَـٰبِلِينَ","mutaqābilīna","facing each other","মুখোমুখি হয়ে"]],"t":"وَنَزَعْنَا مَا فِى صُدُورِ<y>هِم مِّ</>نْ غِلٍّ إِخْ<m>وَٰ</>نًا عَلَىٰ سُرُ<d>رٍۢ مُّ</>تَ<m>قَٰ</>بِ<p>لِي</>نَ"},{"n":48,"w":[["لَا","lā","Not","না"],["يَمَسُّهُمْ","yamassuhum","will touch them","তাদের স্পর্শ করবে"],["فِيهَا","fīhā","therein","তার মধ্যে"],["نَصَبٌۭ","naṣabun","fatigue","কোনো অবসাদ"],["وَمَا","wamā","and not","আছে  না"],["هُم","hum","they","তারা"],["مِّنْهَا","min'hā","from it","তা থেকে"],["بِمُخْرَجِينَ","bimukh'rajīna","will be removed","বহিষ্কৃত হবে"]],"t":"لَا يَمَسُّهُمْ فِيهَا نَصَ<d>بٌۭ وَ</>مَا <y>هُم مِّ</>نْهَا بِمُخْرَ<p>جِي</>نَ"},{"n":49,"w":[["۞ نَبِّئْ","nabbi","Inform","জানিয়ে দাও"],["عِبَادِىٓ","‘ibādī","My slaves","আমার দাসদের"],["أَنِّىٓ","annī","that I","যে আমি"],["أَنَا","anā","I am","আমিই"],["ٱلْغَفُورُ","l-ghafūru","the Oft-Forgiving","ক্ষমাশীল"],["ٱلرَّحِيمُ","l-raḥīmu","the Most Merciful","পরম দয়ালু"]],"t":"۞ نَبِّئْ عِبَا<o>دِىٓ</> أَ<g>نِّ</><o>ىٓ</> أَنَا <h>ٱ</>لْغَفُورُ <h>ٱ</><l>ل</>رَّ<p>حِي</>مُ"},{"n":50,"w":[["وَأَنَّ","wa-anna","And that","এবং (এও) যে"],["عَذَابِى","‘adhābī","My punishment","আমার শাস্তিও"],["هُوَ","huwa","it","তা"],["ٱلْعَذَابُ","l-‘adhābu","(is) the punishment","শাস্তি"],["ٱلْأَلِيمُ","l-alīmu","the most painful","নিদারুণ"]],"t":"وَأَ<g>نَّ</> عَذَابِى هُوَ <h>ٱ</>لْعَذَابُ <h>ٱ</>لْأَ<p>لِي</>مُ"},{"n":51,"w":[["وَنَبِّئْهُمْ","wanabbi'hum","And inform them","এবং তাদের জানিয়ে দাও"],["عَن","‘an","about","সম্পর্কে"],["ضَيْفِ","ḍayfi","(the) guests","মেহমান"],["إِبْرَٰهِيمَ","ib'rāhīma","(of) Ibrahim","ইবরাহীমের"]],"t":"وَنَبِّئْهُمْ عَ<k>ن ضَ</>يْفِ إِ<q>بْ</><m>رَٰ</><p>هِي</>مَ"},{"n":52,"w":[["إِذْ","idh","When","যখন"],["دَخَلُوا۟","dakhalū","they entered","তারা প্রবেশ  করেছিলো"],["عَلَيْهِ","‘alayhi","upon him","তার কাছে"],["فَقَالُوا۟","faqālū","and said","অতঃপর তারা বলেছিলো"],["سَلَـٰمًۭا","salāman","Peace","\"(তোমাকে) সালাম\""],["قَالَ","qāla","He said","সে বললো"],["إِنَّا","innā","Indeed, we","\"নিশ্চয়ই আমরা"],["مِنكُمْ","minkum","(are) of you","তোমাদের থেকে"],["وَجِلُونَ","wajilūna","afraid","আতঙ্কিত\""]],"t":"إِذْ دَخَلُو<s>ا۟</> عَلَيْهِ فَقَالُو<s>ا۟</> سَ<m>لَٰ</><k>مًۭا قَ</>الَ إِ<g>نَّ</>ا مِ<k>نكُ</>مْ وَجِ<p>لُو</>نَ"},{"n":53,"w":[["قَالُوا۟","qālū","They said","তারা বললো"],["لَا","lā","(Do) not","\"না"],["تَوْجَلْ","tawjal","be afraid","আতঙ্কিত হয়ো"],["إِنَّا","innā","indeed, we","নিশ্চয়ই আমরা"],["نُبَشِّرُكَ","nubashiruka","[we] bring glad tidings to you","তোমাকে সুসংবাদ দিচ্ছি"],["بِغُلَـٰمٍ","bighulāmin","of a boy","একটি ছেলের"],["عَلِيمٍۢ","‘alīmin","learned","বড় জ্ঞানী\""]],"t":"قَالُو<s>ا۟</> لَا تَوْجَلْ إِ<g>نَّ</>ا نُبَشِّرُكَ بِغُ<m>لَٰ</>مٍ عَ<p>لِي</>مٍۢ"},{"n":54,"w":[["قَالَ","qāla","He said","সে বললো"],["أَبَشَّرْتُمُونِى","abashartumūnī","Do you give me glad tidings","\"কি আমাকে তোমরা সুসংবাদ দিচ্ছো"],["عَلَىٰٓ","‘alā","Do you give me glad tidings","\"এ অবস্থায়"],["أَن","an","although","যে"],["مَّسَّنِىَ","massaniya","has overtaken me","আমাকে পেয়েছে"],["ٱلْكِبَرُ","l-kibaru","old age","বার্ধক্য"],["فَبِمَ","fabima","Then about what","অতএব কি ধরণের"],["تُبَشِّرُونَ","tubashirūna","you give glad tidings","তোমরা সুসংবাদ দিচ্ছো\""]],"t":"قَالَ أَبَشَّرْتُمُونِى عَلَ<o>ىٰٓ</> <d>أَن مَّ</>سَّنِىَ <h>ٱ</>لْكِبَرُ فَبِمَ تُبَشِّ<p>رُو</>نَ"},{"n":55,"w":[["قَالُوا۟","qālū","They said","তারা বলেছিলো"],["بَشَّرْنَـٰكَ","basharnāka","We give you glad tidings","\"তোমাকে সুসংবাদ দিচ্ছি আমরা"],["بِٱلْحَقِّ","bil-ḥaqi","in truth","সহকারে সত্য"],["فَلَا","falā","so (do) not","অতএব না"],["تَكُن","takun","be","তুমি হয়ো"],["مِّنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْقَـٰنِطِينَ","l-qāniṭīna","the despairing","হতাশদের\""]],"t":"قَالُو<s>ا۟</> بَشَّرْ<m>نَٰ</>كَ بِ<h>ٱ</>لْحَقِّ فَلَا تَ<d>كُن مِّ</>نَ <h>ٱ</>لْ<m>قَٰ</>نِ<p>طِي</>نَ"},{"n":56,"w":[["قَالَ","qāla","He said","সে বললো"],["وَمَن","waman","And who","\"এবং কে"],["يَقْنَطُ","yaqnaṭu","despairs","নিরাশ হয়"],["مِن","min","of","থেকে"],["رَّحْمَةِ","raḥmati","(the) Mercy","অনুগ্রহ"],["رَبِّهِۦٓ","rabbihi","(of) his Lord","তার রবের"],["إِلَّا","illā","except","এছাড়া"],["ٱلضَّآلُّونَ","l-ḍālūna","those who are astray","পথভ্রষ্টরা"]],"t":"قَالَ وَ<d>مَن يَ</><q>قْ</>نَطُ <w>مِن رَّ</>حْمَةِ رَبِّ<o>هِۦٓ</> إِلَّا <h>ٱ</><l>ل</><n>ضَّآ</><p>لُّو</>نَ"},{"n":57,"w":[["قَالَ","qāla","He said","সে বললো"],["فَمَا","famā","Then what","\"অতএব কি"],["خَطْبُكُمْ","khaṭbukum","(is) your business","আপনাদের উদ্দেশ্য"],["أَيُّهَا","ayyuhā","O messengers","হে\""],["ٱلْمُرْسَلُونَ","l-mur'salūna","O messengers","প্রেরিত (ফেরেশতারা)\""]],"t":"قَالَ فَمَا خَ<q>طْ</>بُكُمْ أَيُّهَا <h>ٱ</>لْمُرْسَ<p>لُو</>نَ"},{"n":58,"w":[["قَالُوٓا۟","qālū","They said","তারা বললো"],["إِنَّآ","innā","Indeed, we","\"নিশ্চয়ই আমরা"],["أُرْسِلْنَآ","ur'sil'nā","[we] have been sent","আমরা প্রেরিত হয়েছি"],["إِلَىٰ","ilā","to","প্রতি"],["قَوْمٍۢ","qawmin","a people ","সম্প্রদায়ের"],["مُّجْرِمِينَ","muj'rimīna","criminals","অপরাধী"]],"t":"قَا<o>لُوٓ</><s>ا۟</> إِ<g>نَّ</><o>آ</> أُرْسِلْ<o>نَآ</> إِلَىٰ قَوْ<d>مٍۢ مُّ</><q>جْ</>رِ<p>مِي</>نَ"},{"n":59,"w":[["إِلَّآ","illā","Except","ছাড়া"],["ءَالَ","āla","the family","পরিবার"],["لُوطٍ","lūṭin","of Lut","লূতের"],["إِنَّا","innā","indeed, we","নিশ্চয়ই আমরা"],["لَمُنَجُّوهُمْ","lamunajjūhum","surely will save them","অবশ্যই রক্ষাকারী তাদের"],["أَجْمَعِينَ","ajma‘īna","all","সকলকে"]],"t":"إِ<o>لَّآ</> ءَالَ لُوطٍ إِ<g>نَّ</>ا لَمُنَجُّوهُمْ أَ<q>جْ</>مَ<p>عِي</>نَ"},{"n":60,"w":[["إِلَّا","illā","Except","ছাড়া"],["ٱمْرَأَتَهُۥ","im'ra-atahu","his wife","তার স্ত্রী\""],["قَدَّرْنَآ ۙ","qaddarnā","We have decreed","আমরা স্থির করেছি"],["إِنَّهَا","innahā","that she","নিশ্চয়ই সে"],["لَمِنَ","lamina","(is) surely of","অব্যশই অন্তর্ভুক্ত"],["ٱلْغَـٰبِرِينَ","l-ghābirīna","those who remain behind","পিছনে থেকে যাওয়া লোকদের"]],"t":"إِلَّا <h>ٱ</>مْرَأَتَهُ<m>ۥ</> قَدَّرْ<o>نَآ ۙ</> إِ<g>نَّ</>هَا لَمِنَ <h>ٱ</>لْ<m>غَٰ</>بِ<p>رِي</>نَ"},{"n":61,"w":[["فَلَمَّا","falammā","And when","অতঃপর যখন"],["جَآءَ","jāa","came","আসলো"],["ءَالَ","āla","(to the) family","পরিবারের কাছে"],["لُوطٍ","lūṭin","(of) Lut","লূতের"],["ٱلْمُرْسَلُونَ","l-mur'salūna","the messengers","প্রেরিত (ফেরেশতারা)"]],"t":"فَلَ<g>مَّ</>ا <o>جَآ</>ءَ ءَالَ لُوطٍ <h>ٱ</>لْمُرْسَ<p>لُو</>نَ"},{"n":62,"w":[["قَالَ","qāla","He said","সে বললো"],["إِنَّكُمْ","innakum","Indeed, you","\"নিশ্চয়ই তোমরা"],["قَوْمٌۭ","qawmun","(are) a people","লোক"],["مُّنكَرُونَ","munkarūna","unknown","অপরিচিত\""]],"t":"قَالَ إِ<g>نَّ</>كُمْ قَوْ<d>مٌۭ مُّ</><k>نكَ</><p>رُو</>نَ"},{"n":63,"w":[["قَالُوا۟","qālū","They said","তারা বললো"],["بَلْ","bal","Nay","\"বরং"],["جِئْنَـٰكَ","ji'nāka","we have come to you","তোমার কাছে আমরা এসেছি"],["بِمَا","bimā","with what","ঐ বিষয় নিয়ে যা"],["كَانُوا۟","kānū","they were","তারা ছিলো"],["فِيهِ","fīhi","in it","সে ব্যাপারে"],["يَمْتَرُونَ","yamtarūna","disputing","সন্দেহ করতো"]],"t":"قَالُو<s>ا۟</> بَلْ جِئْ<m>نَٰ</>كَ بِمَا كَانُو<s>ا۟</> فِيهِ يَمْتَ<p>رُو</>نَ"},{"n":64,"w":[["وَأَتَيْنَـٰكَ","wa-ataynāka","And we have come to you","এবং তোমার কাছে আমরা এসেছি"],["بِٱلْحَقِّ","bil-ḥaqi","with the truth","নিয়ে সত্য"],["وَإِنَّا","wa-innā","and indeed, we","এবং নিশ্চয়ই আমরা"],["لَصَـٰدِقُونَ","laṣādiqūna","surely (are) truthful","অবশ্যই সত্যবাদী"]],"t":"وَأَتَيْ<m>نَٰ</>كَ بِ<h>ٱ</>لْحَقِّ وَإِ<g>نَّ</>ا لَ<m>صَٰ</>دِ<p>قُو</>نَ"},{"n":65,"w":[["فَأَسْرِ","fa-asri","So travel","সুতরাং চলে যাও"],["بِأَهْلِكَ","bi-ahlika","with your family","নিয়ে তোমার পরিবার"],["بِقِطْعٍۢ","biqiṭ'‘in","in a portion","অংশে"],["مِّنَ","mina","of","কিছু"],["ٱلَّيْلِ","al-layli","the night","রাতের"],["وَٱتَّبِعْ","wa-ittabi‘","and follow","এবং তুমি চলবে"],["أَدْبَـٰرَهُمْ","adbārahum","their backs","তাদের পিছনে পিছনে"],["وَلَا","walā","and not","এবং না"],["يَلْتَفِتْ","yaltafit","let look back","তাকাবে (পিছনে)"],["مِنكُمْ","minkum","among you","তোমাদের মধ্য থেকে"],["أَحَدٌۭ","aḥadun","anyone","কেউ"],["وَٱمْضُوا۟","wa-im'ḍū","and go on","এবং তোমরা চলে যাও"],["حَيْثُ","ḥaythu","where","যেখানে"],["تُؤْمَرُونَ","tu'marūna","you are ordered","তোমাদের নির্দেশ দেয়া হয়েছে\""]],"t":"فَأَسْرِ بِأَهْلِكَ بِقِ<q>طْ</><d>عٍۢ مِّ</>نَ <h>ٱ</>لَّيْلِ وَ<h>ٱ</>تَّبِعْ أَ<q>دْ</><m>بَٰ</>رَهُمْ وَلَا يَلْتَفِتْ مِ<k>نكُ</>مْ أَحَ<d>دٌۭ وَ</><h>ٱ</>مْضُو<s>ا۟</> حَيْثُ تُؤْمَ<p>رُو</>نَ"},{"n":66,"w":[["وَقَضَيْنَآ","waqaḍaynā","And We conveyed","এবং আমরা জানিয়ে দিয়েছিলাম"],["إِلَيْهِ","ilayhi","to him","তার প্রতি"],["ذَٰلِكَ","dhālika","[that]","এই"],["ٱلْأَمْرَ","l-amra","the matter","বিষয়ের"],["أَنَّ","anna","that","যে"],["دَابِرَ","dābira","(the) root","মূল"],["هَـٰٓؤُلَآءِ","hāulāi","(of) these","ঐসব লোকদের"],["مَقْطُوعٌۭ","maqṭū‘un","would be cut off","কেটে ফেলা হবে"],["مُّصْبِحِينَ","muṣ'biḥīna","(by) early morning","সকাল না হতেই"]],"t":"وَقَضَيْ<o>نَآ</> إِلَيْهِ <m>ذَٰ</>لِكَ <h>ٱ</>لْأَمْرَ أَ<g>نَّ</> دَابِرَ <o>هَٰٓؤُلَآ</>ءِ مَ<q>قْ</>طُو<d>عٌۭ مُّ</>صْبِ<p>حِي</>نَ"},{"n":67,"w":[["وَجَآءَ","wajāa","And came","এবং আসলো"],["أَهْلُ","ahlu","(the) people","অধিবাসীরা"],["ٱلْمَدِينَةِ","l-madīnati","(of) the city","শহরের"],["يَسْتَبْشِرُونَ","yastabshirūna","rejoicing","উল্লসিত"]],"t":"وَ<o>جَآ</>ءَ أَهْلُ <h>ٱ</>لْمَدِينَةِ يَسْتَ<q>بْ</>شِ<p>رُو</>نَ"},{"n":68,"w":[["قَالَ","qāla","He said","(লূত) বললো"],["إِنَّ","inna","Indeed","\"নিশ্চয়ই"],["هَـٰٓؤُلَآءِ","hāulāi","these","ঐসব লোক"],["ضَيْفِى","ḍayfī","(are) my guests","আমার অতিথি"],["فَلَا","falā","so (do) not","অতএব না"],["تَفْضَحُونِ","tafḍaḥūni","shame me","আমাকে তোমরা অপমান করো"]],"t":"قَالَ إِ<g>نَّ</> <o>هَٰٓؤُلَآ</>ءِ ضَيْفِى فَلَا تَفْضَ<p>حُو</>نِ"},{"n":69,"w":[["وَٱتَّقُوا۟","wa-ittaqū","And fear","এবং তোমরা ভয় করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["وَلَا","walā","and (do) not","এবং না"],["تُخْزُونِ","tukh'zūni","disgrace me","আমাকে তোমরা লাঞ্ছিত করো\""]],"t":"وَ<h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</>للَّهَ وَلَا تُخْ<p>زُو</>نِ"},{"n":70,"w":[["قَالُوٓا۟","qālū","They said","তারা বললো"],["أَوَلَمْ","awalam","Did not","\"কি নি"],["نَنْهَكَ","nanhaka","we forbid you","তোমাকে আমরা নিষেধ করি"],["عَنِ","‘ani","from","সম্পর্কে"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","the world","সারা দুনিয়ার (দায়িত্ব নেয়া)\""]],"t":"قَا<o>لُوٓ</><s>ا۟</> أَوَلَمْ نَنْهَكَ عَنِ <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":71,"w":[["قَالَ","qāla","He said","সে বললো"],["هَـٰٓؤُلَآءِ","hāulāi","These","\"এইসব"],["بَنَاتِىٓ","banātī","(are) my daughters","আমার মেয়েরা"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you would be","তোমরা হও"],["فَـٰعِلِينَ","fā‘ilīna","doers","সম্পাদনকারী\""]],"t":"قَالَ <o>هَٰٓؤُلَآ</>ءِ بَنَا<o>تِىٓ</> إِ<k>ن كُنتُ</>مْ <m>فَٰ</>عِ<p>لِي</>نَ"},{"n":72,"w":[["لَعَمْرُكَ","la‘amruka","By your life","শপথ তোমার জীবনের"],["إِنَّهُمْ","innahum","indeed, they","নিশ্চয়ই তারা"],["لَفِى","lafī","were in","অবশ্যই মধ্যে (ছিলো)"],["سَكْرَتِهِمْ","sakratihim","their intoxication","তাদের নেশার"],["يَعْمَهُونَ","ya‘mahūna","wandering blindly","উদভ্রান্ত হয়ে ফিরছিলো"]],"t":"لَعَمْرُكَ إِ<g>نَّ</>هُمْ لَفِى سَكْرَتِهِمْ يَعْمَ<p>هُو</>نَ"},{"n":73,"w":[["فَأَخَذَتْهُمُ","fa-akhadhathumu","So, seized them","অতঃপর তাদের ধরলো"],["ٱلصَّيْحَةُ","l-ṣayḥatu","the awful cry","বিরাট আওয়াজ"],["مُشْرِقِينَ","mush'riqīna","at sunrise","সূর্যোদয় হ'তেই"]],"t":"فَأَخَذَتْهُمُ <h>ٱ</><l>ل</>صَّيْحَةُ مُشْرِ<p>قِي</>نَ"},{"n":74,"w":[["فَجَعَلْنَا","faja‘alnā","And We made","অতঃপর আমরা রাখলাম"],["عَـٰلِيَهَا","‘āliyahā","its highest (part)","তার উপরভাগকে"],["سَافِلَهَا","sāfilahā","its lowest","তার নীচেরভাগে"],["وَأَمْطَرْنَا","wa-amṭarnā","and We rained","এবং আমরা বর্ষণ করলাম"],["عَلَيْهِمْ","‘alayhim","upon them","তাদের উপর"],["حِجَارَةًۭ","ḥijāratan","stones","পাথরসমূহ"],["مِّن","min","of","তৈরী"],["سِجِّيلٍ","sijjīlin","baked clay","পোড়া মাটির"]],"t":"فَجَعَلْنَا <m>عَٰ</>لِيَهَا سَافِلَهَا وَأَمْطَرْنَا عَلَيْهِمْ حِجَارَ<d>ةًۭ مِّ</><k>ن سِ</><p>جِّي</>لٍ"},{"n":75,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে আছে"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَـٰتٍۢ","laāyātin","(are) the Signs","অবশ্যই নিদর্শনসমূহ"],["لِّلْمُتَوَسِّمِينَ","lil'mutawassimīna","for those who discern","অন্তর্দৃষ্টি-সম্পন্নদের জন্য"]],"t":"إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَا<m>يَٰ</><w>تٍۢ لِّ</>لْمُتَوَسِّ<p>مِي</>نَ"},{"n":76,"w":[["وَإِنَّهَا","wa-innahā","And indeed, it","এবং নিশ্চয়ই তা"],["لَبِسَبِيلٍۢ","labisabīlin","(is) on a road","অবশ্যই পথের সাথে"],["مُّقِيمٍ","muqīmin","established","অবস্থিত"]],"t":"وَإِ<g>نَّ</>هَا لَبِسَبِي<d>لٍۢ مُّ</><p>قِي</>مٍ"},{"n":77,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","(রয়েছে) মধ্যে"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَةًۭ","laāyatan","surely (is) a Sign","অবশ্যই নিদর্শন"],["لِّلْمُؤْمِنِينَ","lil'mu'minīna","for the believers","ঈমানদারদের জন্যে"]],"t":"إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَايَ<w>ةًۭ لِّ</>لْمُؤْمِ<p>نِي</>نَ"},{"n":78,"w":[["وَإِن","wa-in","And were","এবং নিশ্চয়ই"],["كَانَ","kāna","And were","ছিলো"],["أَصْحَـٰبُ","aṣḥābu","(the) companions","অধিবাসীরা"],["ٱلْأَيْكَةِ","l-aykati","(of) the wood","আইকার"],["لَظَـٰلِمِينَ","laẓālimīna","surely wrongdoers","অবশ্যই সীমালঙ্ঘনকারী"]],"t":"وَإِ<k>ن كَ</>انَ أَصْ<m>حَٰ</>بُ <h>ٱ</>لْأَيْكَةِ لَ<m>ظَٰ</>لِ<p>مِي</>نَ"},{"n":79,"w":[["فَٱنتَقَمْنَا","fa-intaqamnā","So We took retribution","অতঃপর আমরা প্রতিশোধ নিই"],["مِنْهُمْ","min'hum","from them","থেকে তাদের"],["وَإِنَّهُمَا","wa-innahumā","and indeed, they both","এবং নিশ্চয়ই উভয়েই"],["لَبِإِمَامٍۢ","labi-imāmin","(were) on a highway","অবশ্যই পথের সাথে"],["مُّبِينٍۢ","mubīnin","clear","প্রকাশ্য"]],"t":"فَ<h>ٱ</><k>نتَ</>قَمْنَا مِنْهُمْ وَإِ<g>نَّ</>هُمَا لَبِإِمَا<d>مٍۢ مُّ</><p>بِي</>نٍۢ"},{"n":80,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["كَذَّبَ","kadhaba","denied","মিথ্যারোপ করেছিলো"],["أَصْحَـٰبُ","aṣḥābu","(the) companions","অধিবাসীরা"],["ٱلْحِجْرِ","l-ḥij'ri","(of) the Rocky Tract","হিজরের"],["ٱلْمُرْسَلِينَ","l-mur'salīna","the Messengers","রাসূলদেরকে"]],"t":"وَلَقَ<q>دْ</> كَذَّبَ أَصْ<m>حَٰ</>بُ <h>ٱ</>لْحِ<q>جْ</>رِ <h>ٱ</>لْمُرْسَ<p>لِي</>نَ"},{"n":81,"w":[["وَءَاتَيْنَـٰهُمْ","waātaynāhum","And We gave them","এবং তাদের আমরা দিয়েছিলাম"],["ءَايَـٰتِنَا","āyātinā","Our Signs","আমাদের নিদর্শনাবলী"],["فَكَانُوا۟","fakānū","but they were","তবুও তারা ছিলো"],["عَنْهَا","‘anhā","from them","তা সম্পর্কে"],["مُعْرِضِينَ","mu‘'riḍīna","turning away","উপেক্ষাকারী"]],"t":"وَءَاتَيْ<m>نَٰ</>هُمْ ءَا<m>يَٰ</>تِنَا فَكَانُو<s>ا۟</> عَنْهَا مُعْرِ<p>ضِي</>نَ"},{"n":82,"w":[["وَكَانُوا۟","wakānū","And they used (to)","এবং তারা ছিলো"],["يَنْحِتُونَ","yanḥitūna","carve","তারা খোদাই করতো"],["مِنَ","mina","from","থেকে"],["ٱلْجِبَالِ","l-jibāli","the mountains","পাহাড়সমূহ"],["بُيُوتًا","buyūtan","houses","ঘরসমূহ (বানাতে)"],["ءَامِنِينَ","āminīna","secure","নিরাপদে"]],"t":"وَكَانُو<s>ا۟</> يَنْحِتُونَ مِنَ <h>ٱ</>لْجِبَالِ بُيُوتًا ءَامِ<p>نِي</>نَ"},{"n":83,"w":[["فَأَخَذَتْهُمُ","fa-akhadhathumu","But seized them","অতঃপর তাদের আঘাত করলো"],["ٱلصَّيْحَةُ","l-ṣayḥatu","the awful cry","বিকট শব্দে"],["مُصْبِحِينَ","muṣ'biḥīna","(at) early morning","সকাল হ'তে না হ'তেই"]],"t":"فَأَخَذَتْهُمُ <h>ٱ</><l>ل</>صَّيْحَةُ مُصْبِ<p>حِي</>نَ"},{"n":84,"w":[["فَمَآ","famā","And not","অতঃপর না"],["أَغْنَىٰ","aghnā","availed","কাজে আসলো"],["عَنْهُم","‘anhum","them","জন্যে তাদের"],["مَّا","mā","what","যা"],["كَانُوا۟","kānū","they used (to)","তারা ছিলো"],["يَكْسِبُونَ","yaksibūna","earn","তারা উপার্জন করে"]],"t":"فَ<o>مَآ</> أَغْنَىٰ عَنْ<y>هُم مَّ</>ا كَانُو<s>ا۟</> يَكْسِ<p>بُو</>نَ"},{"n":85,"w":[["وَمَا","wamā","And not","এবং নি"],["خَلَقْنَا","khalaqnā","We created","আমরা সৃষ্টি করেছি"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশ মন্ডলী"],["وَٱلْأَرْضَ","wal-arḍa","and the earth","এবং পৃথিবী"],["وَمَا","wamā","and whatever","এবং যা (আছে)"],["بَيْنَهُمَآ","baynahumā","(is) between them","উভয়ের মাঝে"],["إِلَّا","illā","except","এ ছাড়া"],["بِٱلْحَقِّ ۗ","bil-ḥaqi","in truth","মহাসত্যসহকারে"],["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["ٱلسَّاعَةَ","l-sā‘ata","the Hour","ক্বিয়ামাত"],["لَـَٔاتِيَةٌۭ ۖ","laātiyatun","(is) surely coming","অবশ্যই আসবে"],["فَٱصْفَحِ","fa-iṣ'faḥi","So overlook","সুতরাং ক্ষমা করো"],["ٱلصَّفْحَ","l-ṣafḥa","(with) forgiveness","সৌজন্যে"],["ٱلْجَمِيلَ","l-jamīla","gracious","পরম"]],"t":"وَمَا خَلَ<q>قْ</>نَا <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضَ وَمَا بَيْنَهُ<o>مَآ</> إِلَّا بِ<h>ٱ</>لْحَقِّ ۗ وَإِ<g>نَّ</> <h>ٱ</><l>ل</>سَّاعَةَ لَءَاتِيَ<k>ةٌۭ ۖ فَ</><h>ٱ</>صْفَحِ <h>ٱ</><l>ل</>صَّفْحَ <h>ٱ</>لْجَ<p>مِي</>لَ"},{"n":86,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["رَبَّكَ","rabbaka","your Lord","তোমার রব"],["هُوَ","huwa","He","তিনিই"],["ٱلْخَلَّـٰقُ","l-khalāqu","(is) the Creator","মহাস্রষ্টা"],["ٱلْعَلِيمُ","l-‘alīmu","the All-Knower","মহাজ্ঞানী"]],"t":"إِ<g>نَّ</> رَبَّكَ هُوَ <h>ٱ</>لْخَ<m>لَّٰ</>قُ <h>ٱ</>لْعَ<p>لِي</>مُ"},{"n":87,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["ءَاتَيْنَـٰكَ","ātaynāka","We have given you","তোমাকে দিয়েছি"],["سَبْعًۭا","sab‘an","seven","সাত (আয়াত)"],["مِّنَ","mina","of","থেকে"],["ٱلْمَثَانِى","l-mathānī","the oft-repeated","বারবার আবৃত্তিযোগ্য"],["وَٱلْقُرْءَانَ","wal-qur'āna","and the Quran","ও কুরআন"],["ٱلْعَظِيمَ","l-‘aẓīma","Great","মহান"]],"t":"وَلَقَ<q>دْ</> ءَاتَيْ<m>نَٰ</>كَ سَ<q>بْ</><d>عًۭا مِّ</>نَ <h>ٱ</>لْمَثَانِى وَ<h>ٱ</>لْقُرْءَانَ <h>ٱ</>لْعَ<p>ظِي</>مَ"},{"n":88,"w":[["لَا","lā","(Do) not","না"],["تَمُدَّنَّ","tamuddanna","extend","কখনও প্রসারিত করো তুমি"],["عَيْنَيْكَ","‘aynayka","your eyes","তোমার দু'চোখ"],["إِلَىٰ","ilā","towards","প্রতি"],["مَا","mā","what","যা"],["مَتَّعْنَا","matta‘nā","We have bestowed","আমরা ভোগ বিলাস দিয়েছি"],["بِهِۦٓ","bihi","with it","দিয়ে তা"],["أَزْوَٰجًۭا","azwājan","(to) categories","বিভিন্ন শ্রেণীতে"],["مِّنْهُمْ","min'hum","of them","তাদের মধ্যকার"],["وَلَا","walā","and (do) not","ও না"],["تَحْزَنْ","taḥzan","grieve","চিন্তা করো"],["عَلَيْهِمْ","‘alayhim","over them","তাদের সম্বন্ধে"],["وَٱخْفِضْ","wa-ikh'fiḍ","And lower","অবনমিত করো"],["جَنَاحَكَ","janāḥaka","your wing","তোমার বাহু"],["لِلْمُؤْمِنِينَ","lil'mu'minīna","to the believers","মু'মিনদের জন্যে"]],"t":"لَا تَمُدَّ<g>نَّ</> عَيْنَيْكَ إِلَىٰ مَا مَتَّعْنَا بِ<o>هِۦٓ</> أَزْ<m>وَٰ</><d>جًۭا مِّ</>نْهُمْ وَلَا تَحْزَنْ عَلَيْهِمْ وَ<h>ٱ</>خْفِضْ جَنَاحَكَ لِلْمُؤْمِ<p>نِي</>نَ"},{"n":89,"w":[["وَقُلْ","waqul","And say","এবং বলো"],["إِنِّىٓ","innī","Indeed, I","\"নিশ্চয়ই আমি"],["أَنَا","anā","[I] am","আমিই"],["ٱلنَّذِيرُ","l-nadhīru","a warner","সতর্ককারী"],["ٱلْمُبِينُ","l-mubīnu","clear","সুস্পষ্ট\""]],"t":"وَقُلْ إِ<g>نِّ</><o>ىٓ</> أَنَا <h>ٱ</><l>ل</><g>نَّ</>ذِيرُ <h>ٱ</>لْمُ<p>بِي</>نُ"},{"n":90,"w":[["كَمَآ","kamā","As","যেমন"],["أَنزَلْنَا","anzalnā","We sent down","আমরা অবতীর্ণ করেছিলাম"],["عَلَى","‘alā","on","উপর"],["ٱلْمُقْتَسِمِينَ","l-muq'tasimīna","those who divided","বিভক্তকারীদের"]],"t":"كَ<o>مَآ</> أَ<k>نزَ</>لْنَا عَلَى <h>ٱ</>لْمُ<q>قْ</>تَسِ<p>مِي</>نَ"},{"n":91,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["جَعَلُوا۟","ja‘alū","have made","করেছে"],["ٱلْقُرْءَانَ","l-qur'āna","the Quran","কুরআনকে"],["عِضِينَ","‘iḍīna","(in) parts","টুকরো টুকরো"]],"t":"ٱلَّذِينَ جَعَلُو<s>ا۟</> <h>ٱ</>لْقُرْءَانَ عِ<p>ضِي</>نَ"},{"n":92,"w":[["فَوَرَبِّكَ","fawarabbika","So by your Lord","সুতরাং তোমার রবের শপথ"],["لَنَسْـَٔلَنَّهُمْ","lanasalannahum","surely We will question them","অবশ্যই আমরা জিজ্ঞাসা করবো তাদের"],["أَجْمَعِينَ","ajma‘īna","all","সকলকে"]],"t":"فَوَرَبِّكَ لَنَسْـَٔلَ<g>نَّ</>هُمْ أَ<q>جْ</>مَ<p>عِي</>نَ"},{"n":93,"w":[["عَمَّا","‘ammā","About what","যা থেকে"],["كَانُوا۟","kānū","they used (to)","তারা ছিলো"],["يَعْمَلُونَ","ya‘malūna","do","তারা  কাজ করতো"]],"t":"عَ<g>مَّ</>ا كَانُو<s>ا۟</> يَعْمَ<p>لُو</>نَ"},{"n":94,"w":[["فَٱصْدَعْ","fa-iṣ'da‘","So proclaim","সুতরাং প্রকাশ্যে প্রচার করো"],["بِمَا","bimā","of what","ঐ বিষয়ে যা"],["تُؤْمَرُ","tu'maru","you are ordered","তোমাকে আদেশ করা হয়েছে"],["وَأَعْرِضْ","wa-a‘riḍ","and turn away","ও উপেক্ষা করো"],["عَنِ","‘ani","from","থেকে"],["ٱلْمُشْرِكِينَ","l-mush'rikīna","the polytheists","মুশরিকদের"]],"t":"فَ<h>ٱ</>صْدَعْ بِمَا تُؤْمَرُ وَأَعْرِضْ عَنِ <h>ٱ</>لْمُشْرِ<p>كِي</>نَ"},{"n":95,"w":[["إِنَّا","innā","Indeed, We","নিশ্চয়ই আমরা"],["كَفَيْنَـٰكَ","kafaynāka","[We] are sufficient for you","তোমার জন্যে আমরাই যথেষ্ট"],["ٱلْمُسْتَهْزِءِينَ","l-mus'tahziīna","(against) the mockers","বিদ্রুপকারীদের (বিরুদ্ধে)"]],"t":"إِ<g>نَّ</>ا كَفَيْ<m>نَٰ</>كَ <h>ٱ</>لْمُسْتَهْزِ<p>ءِي</>نَ"},{"n":96,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["يَجْعَلُونَ","yaj‘alūna","set up","বানিয়েছে"],["مَعَ","ma‘a","with","সাথে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["إِلَـٰهًا","ilāhan","god","ইলাহ"],["ءَاخَرَ ۚ","ākhara","another","অন্যকে"],["فَسَوْفَ","fasawfa","But soon","অতঃপর শীঘ্রই"],["يَعْلَمُونَ","ya‘lamūna","they will come to know","তারা জানবে"]],"t":"ٱلَّذِينَ يَ<q>جْ</>عَلُونَ مَعَ <h>ٱ</>للَّهِ إِ<m>لَٰ</>هًا ءَاخَرَ ۚ فَسَوْفَ يَعْلَ<p>مُو</>نَ"},{"n":97,"w":[["وَلَقَدْ","walaqad","And verily","এবং নিশ্চয়ই"],["نَعْلَمُ","na‘lamu","We know","আমরা জানি"],["أَنَّكَ","annaka","that [you]","তুমি যে"],["يَضِيقُ","yaḍīqu","(is) straitened","সংকুচিত হয়"],["صَدْرُكَ","ṣadruka","your breast","তোমার অন্তর"],["بِمَا","bimā","by what","এ কারণে যা"],["يَقُولُونَ","yaqūlūna","they say","তারা বলে"]],"t":"وَلَقَ<q>دْ</> نَعْلَمُ أَ<g>نَّ</>كَ يَضِيقُ صَ<q>دْ</>رُكَ بِمَا يَقُو<p>لُو</>نَ"},{"n":98,"w":[["فَسَبِّحْ","fasabbiḥ","So glorify","সুতরাং পবিত্রতা ঘোষণা করো"],["بِحَمْدِ","biḥamdi","with the praise","সহ প্রশংসা"],["رَبِّكَ","rabbika","(of) your Lord","তোমার রবের"],["وَكُن","wakun","and be","এবং হও"],["مِّنَ","mina","of","অন্তর্ভুক্ত"],["ٱلسَّـٰجِدِينَ","l-sājidīna","those who prostrate","সিজদাকারীদের"]],"t":"فَسَبِّحْ بِحَمْدِ رَبِّكَ وَ<d>كُن مِّ</>نَ <h>ٱ</><l>ل</><m>سَّٰ</>جِ<p>دِي</>نَ"},{"n":99,"w":[["وَٱعْبُدْ","wa-u‘'bud","And worship","ও ইবাদত করো"],["رَبَّكَ","rabbaka","your Lord","তোমার রবের"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["يَأْتِيَكَ","yatiyaka","comes to you","তোমার কাছে আসে"],["ٱلْيَقِينُ","l-yaqīnu","the certainty","মৃত্যু"]],"t":"وَ<h>ٱ</>عْبُ<q>دْ</> رَبَّكَ حَتَّىٰ يَأْتِيَكَ <h>ٱ</>لْيَ<p>قِي</>نُ"}]}