{"n":111,"a":[{"n":1,"w":[["تَبَّتْ","tabbat","Perish","ধ্বংস হোক"],["يَدَآ","yadā","(the) hands","দু'হাত"],["أَبِى","abī","(of) Abu","আবু"],["لَهَبٍۢ","lahabin","Lahab","লাহাবের"],["وَتَبَّ","watabba","and perish he","এবং সেও ধ্বংস হোক"]],"t":"تَبَّتْ يَ<o>دَآ</> أَبِى لَهَ<d>بٍۢ وَ</>تَ<q>بَّ</>"},{"n":2,"w":[["مَآ","mā","Not","না"],["أَغْنَىٰ","aghnā","(will) avail","কাজে আসলো"],["عَنْهُ","‘anhu","him","তার পক্ষে"],["مَالُهُۥ","māluhu","his wealth","তার সম্পদ"],["وَمَا","wamā","and what","আর যা"],["كَسَبَ","kasaba","he earned","সে  উপার্জন করেছিল"]],"t":"<o>مَآ</> أَغْنَىٰ عَنْهُ مَالُهُ<m>ۥ</> وَمَا كَسَ<q>بَ</>"},{"n":3,"w":[["سَيَصْلَىٰ","sayaṣlā","He will be burnt","শীঘ্রই জ্বলবে"],["نَارًۭا","nāran","(in) a Fire","আগুনে"],["ذَاتَ","dhāta","of","সমন্বিত"],["لَهَبٍۢ","lahabin","Blazing Flames","শিখা"]],"t":"سَيَصْلَىٰ نَا<k>رًۭا ذَ</>اتَ لَهَ<q>بٍۢ</>"},{"n":4,"w":[["وَٱمْرَأَتُهُۥ","wa-im'ra-atuhu","And his wife","এবং তার স্ত্রীও"],["حَمَّالَةَ","ḥammālata","(the) carrier","বহনকারিণী"],["ٱلْحَطَبِ","l-ḥaṭabi","(of) firewood","কাঠের"]],"t":"وَ<h>ٱ</>مْرَأَتُهُ<m>ۥ</> حَ<g>مَّ</>الَةَ <h>ٱ</>لْحَطَ<q>بِ</>"},{"n":5,"w":[["فِى","fī","In","মধ্যে"],["جِيدِهَا","jīdihā","her neck","তার গলার"],["حَبْلٌۭ","ḥablun","(will be) a rope","দড়ি"],["مِّن","min","of","থেকে"],["مَّسَدٍۭ","masadin","palm-fiber","পাকানো"]],"t":"فِى جِيدِهَا حَ<q>بْ</><d>لٌۭ مِّن مَّ</>سَ<q>دٍۭ</>"}]}