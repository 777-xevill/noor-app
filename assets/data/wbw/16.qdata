t","না"],["يَهْدِى","yahdī","guide","পথ দেখান"],["ٱلْقَوْمَ","l-qawma","the people","সম্প্রদায়কে"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","the disbelievers","কাফের"]],"t":"<m>ذَٰ</>لِكَ بِأَ<g>نَّ</>هُمُ <h>ٱ</>سْتَحَبُّو<s>ا۟</> <h>ٱ</>لْحَيَ<s>وٰ</>ةَ <h>ٱ</><l>ل</>دُّنْيَا عَلَى <h>ٱ</>لْءَاخِرَةِ وَأَ<g>نَّ</> <h>ٱ</>للَّهَ لَا يَهْدِى <h>ٱ</>لْقَوْمَ <h>ٱ</>لْ<m>كَٰ</>فِ<p>رِي</>نَ"},{"n":108,"w":[["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব লোক"],["ٱلَّذِينَ","alladhīna","(are) the ones ","(তারাই) যাদের"],["طَبَعَ","ṭaba‘a","Allah has set a seal","মোহর মেরে দিয়েছেন"],["ٱللَّهُ","l-lahu","Allah has set a seal","আল্লাহ্‌"],["عَلَىٰ","‘alā","over","উপর"],["قُلُوبِهِمْ","qulūbihim","their hearts","অন্তরসমূহের তাদের"],["وَسَمْعِهِمْ","wasam‘ihim","and their hearing","ও শ্রবণশক্তিসমূহের তাদের"],["وَأَبْصَـٰرِهِمْ ۖ","wa-abṣārihim","and their sight","ও দৃষ্টিশক্তিসমূহের তাদের"],["وَأُو۟لَـٰٓئِكَ","wa-ulāika","And those ","এবং ঐসব লোক"],["هُمُ","humu","they are","তারাই"],["ٱلْغَـٰفِلُونَ","l-ghāfilūna","the heedless","উদাসীন"]],"t":"أُ<s>و۟</><o>لَٰٓ</>ئِكَ <h>ٱ</>لَّذِينَ طَبَعَ <h>ٱ</>للَّهُ عَلَىٰ قُلُوبِهِمْ وَسَمْعِهِمْ وَأَ<q>بْ</><m>صَٰ</>رِهِمْ ۖ وَأُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</>لْ<m>غَٰ</>فِ<p>لُو</>نَ"},{"n":109,"w":[["لَا","lā","No","নেই"],["جَرَمَ","jarama","doubt","সন্দেহ"],["أَنَّهُمْ","annahum","that they","যে তারা"],["فِى","fī","in","মধ্যে"],["ٱلْـَٔاخِرَةِ","l-ākhirati","the Hereafter","আখেরাতের"],["هُمُ","humu","[they]","তারাই"],["ٱلْخَـٰسِرُونَ","l-khāsirūna","(are) the losers","ক্ষতিগ্রস্ত (হবে)"]],"t":"لَا جَرَمَ أَ<g>نَّ</>هُمْ فِى <h>ٱ</>لْءَاخِرَةِ هُمُ <h>ٱ</>لْ<m>خَٰ</>سِ<p>رُو</>نَ"},{"n":110,"w":[["ثُمَّ","thumma","Then","এরপর"],["إِنَّ","inna","indeed","নিশ্চয়ই"],["رَبَّكَ","rabbaka","your Lord","তোমার রব"],["لِلَّذِينَ","lilladhīna","to those who","তাদের জন্যে যারা"],["هَاجَرُوا۟","hājarū","emigrated","হিজরত করেছে"],["مِنۢ","min","after","থেকে"],["بَعْدِ","ba‘di","after","পর"],["مَا","mā","what","হওয়ার"],["فُتِنُوا۟","futinū","they had been put to trials","নির্যাতিত"],["ثُمَّ","thumma","then","অতঃপর"],["جَـٰهَدُوا۟","jāhadū","strove hard","জিহাদ করেছে"],["وَصَبَرُوٓا۟","waṣabarū","and were patient","ও ধৈর্য ধরেছে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["رَبَّكَ","rabbaka","your Lord","তোমার রব"],["مِنۢ","min","after it","থেকে"],["بَعْدِهَا","ba‘dihā","after it","এরপর (তাদের জন্যে)"],["لَغَفُورٌۭ","laghafūrun","surely is Oft-Forgiving","অবশ্যই ক্ষমাশীল"],["رَّحِيمٌۭ","raḥīmun","Most Merciful","পরম দয়ালু"]],"t":"ثُ<g>مَّ</> إِ<g>نَّ</> رَبَّكَ لِلَّذِينَ هَاجَرُو<s>ا۟</> <i>مِنۢ بَ</>عْدِ مَا فُتِنُو<s>ا۟</> ثُ<g>مَّ</> <m>جَٰ</>هَدُو<s>ا۟</> وَصَبَ<o>رُوٓ</><s>ا۟</> إِ<g>نَّ</> رَبَّكَ <i>مِنۢ بَ</>عْدِهَا لَغَفُو<w>رٌۭ رَّ</><p>حِي</>مٌۭ"},{"n":111,"w":[["۞ يَوْمَ","yawma","(On) the Day","(স্মরণ করো) যেদিন"],["تَأْتِى","tatī","(when) will come","আসবে"],["كُلُّ","kullu","every","প্রত্যেক"],["نَفْسٍۢ","nafsin","soul","ব্যক্তি"],["تُجَـٰدِلُ","tujādilu","pleading","যুক্তি দিবে"],["عَن","‘an","for","সম্পর্কে"],["نَّفْسِهَا","nafsihā","itself","তার নিজের"],["وَتُوَفَّىٰ","watuwaffā","and will be paid in full","এবং পূর্ণ দেওয়া হবে"],["كُلُّ","kullu","every","প্রত্যেক"],["نَفْسٍۢ","nafsin","soul","ব্যক্তিকে"],["مَّا","mā","what","যা"],["عَمِلَتْ","‘amilat","it did","সে কাজ করেছে"],["وَهُمْ","wahum","and they","এবং তাদের (প্রতি)"],["لَا","lā","(will) not","না"],["يُظْلَمُونَ","yuẓ'lamūna","be wronged","অত্যাচার করা হবে"]],"t":"۞ يَوْمَ تَأْتِى كُلُّ نَفْ<k>سٍۢ تُ</><m>جَٰ</>دِلُ <d>عَن نَّ</>فْسِهَا وَتُوَفَّىٰ كُلُّ نَفْ<d>سٍۢ مَّ</>ا عَمِلَتْ وَهُمْ لَا يُظْلَ<p>مُو</>نَ"},{"n":112,"w":[["وَضَرَبَ","waḍaraba","And Allah sets forth","এবং পেশ করেন"],["ٱللَّهُ","l-lahu","And Allah sets forth","আল্লাহ্‌"],["مَثَلًۭا","mathalan","a similitude","দৃষ্টান্ত"],["قَرْيَةًۭ","qaryatan","(of) a town","এক জনপদের"],["كَانَتْ","kānat","(that) was","তা ছিলো"],["ءَامِنَةًۭ","āminatan","secure","নিরাপদ"],["مُّطْمَئِنَّةًۭ","muṭ'ma-innatan","and content","নিশ্চিন্ত"],["يَأْتِيهَا","yatīhā","coming to it","যেখানে আসতো"],["رِزْقُهَا","riz'quhā","its provision","তার জীবিকা"],["رَغَدًۭا","raghadan","(in) abundance","প্রচুর"],["مِّن","min","from","থেকে"],["كُلِّ","kulli","every","প্রত্যেক"],["مَكَانٍۢ","makānin","place","জায়গা"],["فَكَفَرَتْ","fakafarat","but it denied","অতঃপর অস্বীকার করলো"],["بِأَنْعُمِ","bi-an‘umi","(the) Favors of Allah","ব্যাপারে অনুগ্রহসমূহের"],["ٱللَّهِ","l-lahi","(the) Favors of Allah","আল্লাহর"],["فَأَذَٰقَهَا","fa-adhāqahā","so Allah made it taste","তখন তাকে আস্বাদন করালেন"],["ٱللَّهُ","l-lahu","so Allah made it taste","আল্লাহ্‌"],["لِبَاسَ","libāsa","(the) garb","আচ্ছাদন"],["ٱلْجُوعِ","l-jū‘i","(of) the hunger","ক্ষুধার"],["وَٱلْخَوْفِ","wal-khawfi","and the fear","ও ভীতির"],["بِمَا","bimā","for what","এ কারণে যে"],["كَانُوا۟","kānū","they used (to)","তারা ছিলো"],["يَصْنَعُونَ","yaṣna‘ūna","do","তারা করতে"]],"t":"وَضَرَبَ <h>ٱ</>للَّهُ مَثَلًۭ<k>ا قَ</>رْيَ<k>ةًۭ كَ</>انَتْ ءَامِنَ<d>ةًۭ مُّ</><q>طْ</>مَئِ<g>نَّ</><d>ةًۭ يَ</>أْتِيهَا رِزْقُهَا رَغَ<d>دًۭا مِّ</><k>ن كُ</>لِّ مَكَا<k>نٍۢ فَ</>كَفَرَتْ بِأَنْعُمِ <h>ٱ</>للَّهِ فَأَ<m>ذَٰ</>قَهَا <h>ٱ</>للَّهُ لِبَاسَ <h>ٱ</>لْجُوعِ وَ<h>ٱ</>لْخَوْفِ بِمَا كَانُو<s>ا۟</> يَصْنَ<p>عُو</>نَ"},{"n":113,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["جَآءَهُمْ","jāahum","came to them","কাছে এসেছিলো তাদের"],["رَسُولٌۭ","rasūlun","a Messenger","একজন রাসূল"],["مِّنْهُمْ","min'hum","from among them","মধ্য থেকে তাদের"],["فَكَذَّبُوهُ","fakadhabūhu","but they denied him","অতঃপর তাকে তারা মিথ্যারোপ করলো"],["فَأَخَذَهُمُ","fa-akhadhahumu","so seized them","তখন তাদেরকে ধরলো"],["ٱلْعَذَابُ","l-‘adhābu","the punishment","শাস্তি"],["وَهُمْ","wahum","while they","এমতাবস্হায় (যখন) তারা ছিলো"],["ظَـٰلِمُونَ","ẓālimūna","(were) wrongdoers","সীমালঙ্ঘনকারী"]],"t":"وَلَقَ<q>دْ</> <o>جَآ</>ءَهُمْ رَسُو<d>لٌۭ مِّ</>نْهُمْ فَكَذَّبُوهُ فَأَخَذَهُمُ <h>ٱ</>لْعَذَابُ وَهُمْ <m>ظَٰ</>لِ<p>مُو</>نَ"},{"n":114,"w":[["فَكُلُوا۟","fakulū","So eat","সুতরাং তোমরা খাও"],["مِمَّا","mimmā","of what","তা হ'তে যা"],["رَزَقَكُمُ","razaqakumu","Allah has provided you ","তোমাদের জীবিকা দিয়েছেন"],["ٱللَّهُ","l-lahu","Allah has provided you ","আল্লাহ্‌"],["حَلَـٰلًۭا","ḥalālan","lawful","হালাল"],["طَيِّبًۭا","ṭayyiban","and good","পবিত্র"],["وَٱشْكُرُوا۟","wa-ush'kurū","And be grateful","এবং তোমরা কৃতজ্ঞতা প্রকাশ করো"],["نِعْمَتَ","ni‘'mata","(for the) Favor","অনুগ্রহসমূহের"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","[you]","তোমরা হও"],["إِيَّاهُ","iyyāhu","Him Alone","তাঁরই শুধু"],["تَعْبُدُونَ","ta‘budūna","you worship","তোমরা ইবাদাত করে থাকো"]],"t":"فَكُلُو<s>ا۟</> مِ<g>مَّ</>ا رَزَقَكُمُ <h>ٱ</>للَّهُ حَ<m>لَٰ</>لًۭ<k>ا طَ</>يِّ<d>بًۭا وَ</><h>ٱ</>شْكُرُو<s>ا۟</> نِعْمَتَ <h>ٱ</>للَّهِ إِ<k>ن كُنتُ</>مْ إِيَّاهُ تَعْبُ<p>دُو</>نَ"},{"n":115,"w":[["إِنَّمَا","innamā","Only","(আল্লাহ্‌) মূলতঃ"],["حَرَّمَ","ḥarrama","He has forbidden","হারাম করেছেন"],["عَلَيْكُمُ","‘alaykumu","to you","তোমাদের উপর"],["ٱلْمَيْتَةَ","l-maytata","the dead animal","মৃত (জন্তু)"],["وَٱلدَّمَ","wal-dama","and the blood","ও রক্ত"],["وَلَحْمَ","walaḥma","and the flesh","ও গোশতকে"],["ٱلْخِنزِيرِ","l-khinzīri","(of) the swine","শুকরের"],["وَمَآ","wamā","and what","এবং যা"],["أُهِلَّ","uhilla","has been dedicated","নাম নেয়া হয়েছে"],["لِغَيْرِ","lighayri","to other (than)","জন্যে অন্যের"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌ ছাড়া"],["بِهِۦ ۖ","bihi","[with it]","তার উপর"],["فَمَنِ","famani","But (if) one","তবে কেউ"],["ٱضْطُرَّ","uḍ'ṭurra","(is) forced ","নিরুপায় হ'লে (খেতে)"],["غَيْرَ","ghayra","without (being)","ছাড়া"],["بَاغٍۢ","bāghin","disobedient","বিদ্রোহী হওয়া"],["وَلَا","walā","and not","কিংবা না"],["عَادٍۢ","‘ādin","a transgressor ","সীমালঙ্ঘনকারী হয়ে"],["فَإِنَّ","fa-inna","then indeed","তবে নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["غَفُورٌۭ","ghafūrun","(is) Oft-Forgiving","ক্ষমাশীল"],["رَّحِيمٌۭ","raḥīmun","Most Merciful","পরম দয়ালু"]],"t":"إِ<g>نَّ</>مَا حَرَّمَ عَلَيْكُمُ <h>ٱ</>لْمَيْتَةَ وَ<h>ٱ</><l>ل</>دَّمَ وَلَحْمَ <h>ٱ</>لْخِ<k>نزِ</>يرِ وَ<o>مَآ</> أُهِلَّ لِغَيْرِ <h>ٱ</>للَّهِ بِ<m>هِۦ</> ۖ فَمَنِ <h>ٱ</>ضْطُرَّ غَيْرَ بَا<d>غٍۢ وَ</>لَا عَا<k>دٍۢ فَ</>إِ<g>نَّ</> <h>ٱ</>للَّهَ غَفُو<w>رٌۭ رَّ</><p>حِي</>مٌۭ"},{"n":116,"w":[["وَلَا","walā","And (do) not","এবং না"],["تَقُولُوا۟","taqūlū","say","তোমরা বলো"],["لِمَا","limā","for that which","ঐ বিষয়ে যা"],["تَصِفُ","taṣifu","assert","বর্ণনা করে"],["أَلْسِنَتُكُمُ","alsinatukumu","your tongues","তোমাদের জিহবাসমূহ"],["ٱلْكَذِبَ","l-kadhiba","the lie","মিথ্যা"],["هَـٰذَا","hādhā","This","\"এটা"],["حَلَـٰلٌۭ","ḥalālun","(is) lawful","হালাল"],["وَهَـٰذَا","wahādhā","and this","এবং এটা"],["حَرَامٌۭ","ḥarāmun","(is) forbidden","হারাম\""],["لِّتَفْتَرُوا۟","litaftarū","so that you invent","যাতে তোমরা রটাবে"],["عَلَى","‘alā","about","উপর"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["ٱلْكَذِبَ ۚ","l-kadhiba","the lie","মিথ্যা"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["يَفْتَرُونَ","yaftarūna","invent","আরোপ করেছে"],["عَلَى","‘alā","about","উপর"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["ٱلْكَذِبَ","l-kadhiba","the lie","মিথ্যা"],["لَا","lā","they will not succeed","না"],["يُفْلِحُونَ","yuf'liḥūna","they will not succeed","তারা সফলকাম হয়"]],"t":"وَلَا تَقُولُو<s>ا۟</> لِمَا تَصِفُ أَلْسِنَتُكُمُ <h>ٱ</>لْكَذِبَ <m>هَٰ</>ذَا حَ<m>لَٰ</><d>لٌۭ وَ</><m>هَٰ</>ذَا حَرَا<w>مٌۭ لِّ</>تَفْتَرُو<s>ا۟</> عَلَى <h>ٱ</>للَّهِ <h>ٱ</>لْكَذِبَ ۚ إِ<g>نَّ</> <h>ٱ</>لَّذِينَ يَفْتَرُونَ عَلَى <h>ٱ</>للَّهِ <h>ٱ</>لْكَذِبَ لَا يُفْلِ<p>حُو</>نَ"},{"n":117,"w":[["مَتَـٰعٌۭ","matā‘un","An enjoyment","(দুনিয়ার) সুখ সম্ভোগ"],["قَلِيلٌۭ","qalīlun","little","সামান্য"],["وَلَهُمْ","walahum","and for them","এবং জন্যে তাদের"],["عَذَابٌ","‘adhābun","(is) a punishment","শাস্তি (রয়েছে)"],["أَلِيمٌۭ","alīmun","painful","নিদারুণ"]],"t":"مَ<m>تَٰ</><k>عٌۭ قَ</>لِي<d>لٌۭ وَ</>لَهُمْ عَذَابٌ أَ<p>لِي</>مٌۭ"},{"n":118,"w":[["وَعَلَى","wa‘alā","And to","এবং উপর"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["هَادُوا۟","hādū","are Jews","ইহুদী হয়েছে"],["حَرَّمْنَا","ḥarramnā","We have forbidden","আমরা হারাম করেছিলাম"],["مَا","mā","what","যা"],["قَصَصْنَا","qaṣaṣnā","We related","আমরা উল্লেখ করেছি"],["عَلَيْكَ","‘alayka","to you","তোমার নিকট"],["مِن","min","before","থেকে"],["قَبْلُ ۖ","qablu","before","পূর্ব"],["وَمَا","wamā","And not","এবং না"],["ظَلَمْنَـٰهُمْ","ẓalamnāhum","We wronged them","তাদের উপর আমরা নির্যাতন করেছি"],["وَلَـٰكِن","walākin","but","কিন্তু"],["كَانُوٓا۟","kānū","they used (to)","তারা ছিলো"],["أَنفُسَهُمْ","anfusahum","themselves","নিজেদের উপর তাদের"],["يَظْلِمُونَ","yaẓlimūna","wrong","অত্যাচার করতো"]],"t":"وَعَلَى <h>ٱ</>لَّذِينَ هَادُو<s>ا۟</> حَرَّمْنَا مَا قَصَصْنَا عَلَيْكَ مِ<k>ن قَ</><q>بْ</>لُ ۖ وَمَا ظَلَمْ<m>نَٰ</>هُمْ وَ<m>لَٰ</>كِ<k>ن كَ</>ا<o>نُوٓ</><s>ا۟</> أَ<k>نفُ</>سَهُمْ يَظْلِ<p>مُو</>نَ"},{"n":119,"w":[["ثُمَّ","thumma","Then","এরপর"],["إِنَّ","inna","indeed","নিশ্চয়ই"],["رَبَّكَ","rabbaka","your Lord","তোমার রব"],["لِلَّذِينَ","lilladhīna","to those who","(তাদের) জন্য যারা"],["عَمِلُوا۟","‘amilū","did","কাজ করেছে"],["ٱلسُّوٓءَ","l-sūa","evil","মন্দ"],["بِجَهَـٰلَةٍۢ","bijahālatin","in ignorance","বশতঃ অজ্ঞতা"],["ثُمَّ","thumma","then","এরপর"],["تَابُوا۟","tābū","repented","তারা তওবা করেছে"],["مِنۢ","min","after","থেকে"],["بَعْدِ","ba‘di","after","পর"],["ذَٰلِكَ","dhālika","that","এর"],["وَأَصْلَحُوٓا۟","wa-aṣlaḥū","and corrected themselves ","ও সংশোধন করেছে"],["إِنَّ","inna","indeed","নিশ্চয়ই"],["رَبَّكَ","rabbaka","your Lord","তোমার রব"],["مِنۢ","min","after that","থেকে"],["بَعْدِهَا","ba‘dihā","after that","এর পর"],["لَغَفُورٌۭ","laghafūrun","(is) surely Oft-Forgiving","অবশ্যই ক্ষমাশীল"],["رَّحِيمٌ","raḥīmun","Most Merciful","পরম দয়ালু"]],"t":"ثُ<g>مَّ</> إِ<g>نَّ</> رَبَّكَ لِلَّذِينَ عَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><o>سُّوٓ</>ءَ بِجَ<m>هَٰ</>لَ<k>ةٍۢ ثُ</><g>مَّ</> تَابُو<s>ا۟</> <i>مِنۢ بَ</>عْدِ <m>ذَٰ</>لِكَ وَأَصْلَ<o>حُوٓ</><s>ا۟</> إِ<g>نَّ</> رَبَّكَ <i>مِنۢ بَ</>عْدِهَا لَغَفُو<w>رٌۭ رَّ</><p>حِي</>مٌ"},{"n":120,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["إِبْرَٰهِيمَ","ib'rāhīma","Ibrahim","ইবরাহীম"],["كَانَ","kāna","was","ছিলো"],["أُمَّةًۭ","ummatan","a nation","এক সম্প্রদায় (প্রতীক)"],["قَانِتًۭا","qānitan","obedient","অনুগত"],["لِّلَّهِ","lillahi","to Allah","জন্যে আল্লাহর"],["حَنِيفًۭا","ḥanīfan","upright","একনিষ্ঠ"],["وَلَمْ","walam","and not","এবং না"],["يَكُ","yaku","he was","ছিলো"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْمُشْرِكِينَ","l-mush'rikīna","the polytheists","মুশরিকদের"]],"t":"إِ<g>نَّ</> إِ<q>بْ</><m>رَٰ</>هِيمَ كَانَ أُ<g>مَّ</><k>ةًۭ قَ</>انِ<w>تًۭا لِّ</>لَّهِ حَنِي<d>فًۭا وَ</>لَمْ يَكُ مِنَ <h>ٱ</>لْمُشْرِ<p>كِي</>نَ"},{"n":121,"w":[["شَاكِرًۭا","shākiran","Thankful","কৃতজ্ঞ"],["لِّأَنْعُمِهِ ۚ","li-an‘umihi","for His favors","জন্যে তাঁর অনুগ্রহসমূহের"],["ٱجْتَبَىٰهُ","ij'tabāhu","He chose him","(আল্লাহ্‌) তাকে মনোনীত করেছিলেন"],["وَهَدَىٰهُ","wahadāhu","and guided him","ও তাকে পরিচালিত করেছিলেন"],["إِلَىٰ","ilā","to","দিকে"],["صِرَٰطٍۢ","ṣirāṭin","the way","পথের"],["مُّسْتَقِيمٍۢ","mus'taqīmin","straight","সরল সঠিক"]],"t":"شَاكِ<w>رًۭا لِّ</>أَنْعُمِهِ ۚ <h>ٱ</><q>جْ</>تَبَ<m>ىٰ</>هُ وَهَدَ<m>ىٰ</>هُ إِلَىٰ صِ<m>رَٰ</><d>طٍۢ مُّ</>سْتَ<p>قِي</>مٍۢ"},{"n":122,"w":[["وَءَاتَيْنَـٰهُ","waātaynāhu","And We gave him","এবং তাকে আমরা দিয়েছিলাম"],["فِى","fī","in","মধ্যে"],["ٱلدُّنْيَا","l-dun'yā","the world","দুনিয়ার"],["حَسَنَةًۭ ۖ","ḥasanatan","good","কল্যাণ"],["وَإِنَّهُۥ","wa-innahu","and indeed, he","এবং নিশ্চয়ই সে"],["فِى","fī","in","মধ্যে"],["ٱلْـَٔاخِرَةِ","l-ākhirati","the Hereafter","আখেরাতে (হবে)"],["لَمِنَ","lamina","(he) will surely (be) among","অবশ্যই অন্তর্ভুক্ত"],["ٱلصَّـٰلِحِينَ","l-ṣāliḥīna","the righteous","সৎকর্মশীলদের"]],"t":"وَءَاتَيْ<m>نَٰ</>هُ فِى <h>ٱ</><l>ل</>دُّنْيَا حَسَنَ<d>ةًۭ ۖ وَ</>إِ<g>نَّ</>هُ<m>ۥ</> فِى <h>ٱ</>لْءَاخِرَةِ لَمِنَ <h>ٱ</><l>ل</><m>صَّٰ</>لِ<p>حِي</>نَ"},{"n":123,"w":[["ثُمَّ","thumma","Then","এরপর"],["أَوْحَيْنَآ","awḥaynā","We revealed","আমরা ওহী করেছি"],["إِلَيْكَ","ilayka","to you","তোমার প্রতি"],["أَنِ","ani","that","যে"],["ٱتَّبِعْ","ittabi‘","You follow","\"অনুসরণ করো"],["مِلَّةَ","millata","(the) religion","মিল্লাতের (আদর্শের)"],["إِبْرَٰهِيمَ","ib'rāhīma","(of) Ibrahim","ইবরাহীমের"],["حَنِيفًۭا ۖ","ḥanīfan","upright","একনিষ্ঠভাবে"],["وَمَا","wamā","and not","এবং না"],["كَانَ","kāna","he was","সে ছিলো"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْمُشْرِكِينَ","l-mush'rikīna","the polytheists","মুশরিকদের\""]],"t":"ثُ<g>مَّ</> أَوْحَيْ<o>نَآ</> إِلَيْكَ أَنِ <h>ٱ</>تَّبِعْ مِلَّةَ إِ<q>بْ</><m>رَٰ</>هِيمَ حَنِي<d>فًۭا ۖ وَ</>مَا كَانَ مِنَ <h>ٱ</>لْمُشْرِ<p>كِي</>نَ"},{"n":124,"w":[["إِنَّمَا","innamā","Only","প্রকৃতপক্ষে"],["جُعِلَ","ju‘ila","was appointed","বাধ্যতামূলক করা হয়েছিলো"],["ٱلسَّبْتُ","l-sabtu","the Sabbath","শনিবার"],["عَلَى","‘alā","for","উপর"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["ٱخْتَلَفُوا۟","ikh'talafū","differed","মতভেদ করেছিলো"],["فِيهِ ۚ","fīhi","in it","তার মধ্যে"],["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["رَبَّكَ","rabbaka","your Lord","তোমার রব"],["لَيَحْكُمُ","layaḥkumu","will surely judge","অবশ্যই মীমাংসা করে দিবেন"],["بَيْنَهُمْ","baynahum","between them","তাদের মাঝে"],["يَوْمَ","yawma","(on) the Day","দিনে"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) the Resurrection","ক্বিয়ামাতের"],["فِيمَا","fīmā","in what","ঐ বিষয়ে যা"],["كَانُوا۟","kānū","they used (to)","তারা ছিলো"],["فِيهِ","fīhi","[in it]","তার মধ্যে"],["يَخْتَلِفُونَ","yakhtalifūna","differ","মতভেদ করতো"]],"t":"إِ<g>نَّ</>مَا جُعِلَ <h>ٱ</><l>ل</>سَّ<q>بْ</>تُ عَلَى <h>ٱ</>لَّذِينَ <h>ٱ</>خْتَلَفُو<s>ا۟</> فِيهِ ۚ وَإِ<g>نَّ</> رَبَّكَ لَيَحْكُمُ بَيْنَهُمْ يَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ فِيمَا كَانُو<s>ا۟</> فِيهِ يَخْتَلِ<p>فُو</>نَ"},{"n":125,"w":[["ٱدْعُ","ud'‘u","Call","তুমি আহবান করো"],["إِلَىٰ","ilā","to","দিকে"],["سَبِيلِ","sabīli","(the) way","পথের"],["رَبِّكَ","rabbika","(of) your Lord","তোমার রবের"],["بِٱلْحِكْمَةِ","bil-ḥik'mati","with the wisdom","সাথে প্রজ্ঞার"],["وَٱلْمَوْعِظَةِ","wal-maw‘iẓati","and the instruction","ও উপদেশ"],["ٱلْحَسَنَةِ ۖ","l-ḥasanati","the good","উত্তম (দ্বারা)"],["وَجَـٰدِلْهُم","wajādil'hum","and discuss with them","এবং তাদের যুক্তি দাও"],["بِٱلَّتِى","bi-allatī","in that","উপায়ে এমন"],["هِىَ","hiya","which","যা"],["أَحْسَنُ ۚ","aḥsanu","(is) best","অতি উত্তম"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["رَبَّكَ","rabbaka","your Lord","তোমার রব"],["هُوَ","huwa","He","তিনি"],["أَعْلَمُ","a‘lamu","(is) most knowing","খুব জানেন"],["بِمَن","biman","of who","সম্বন্ধে (তার) যে"],["ضَلَّ","ḍalla","has strayed","ভ্রষ্ট হয়েছে"],["عَن","‘an","from","থেকে"],["سَبِيلِهِۦ ۖ","sabīlihi","His way","তাঁর পথ"],["وَهُوَ","wahuwa","And He","এবং তিনি"],["أَعْلَمُ","a‘lamu","(is) most knowing","খুব জানেন"],["بِٱلْمُهْتَدِينَ","bil-muh'tadīna","of the guided ones","সম্পর্কে সৎপথপ্রাপ্তদের"]],"t":"ٱ<q>دْ</>عُ إِلَىٰ سَبِيلِ رَبِّكَ بِ<h>ٱ</>لْحِكْمَةِ وَ<h>ٱ</>لْمَوْعِظَةِ <h>ٱ</>لْحَسَنَةِ ۖ وَ<m>جَٰ</>دِلْ<f>هُم بِ</><h>ٱ</>لَّتِى هِىَ أَحْسَنُ ۚ إِ<g>نَّ</> رَبَّكَ هُوَ أَعْلَمُ بِمَ<k>ن ضَ</>لَّ عَ<k>ن سَ</>بِيلِ<m>هِۦ</> ۖ وَهُوَ أَعْلَمُ بِ<h>ٱ</>لْمُهْتَ<p>دِي</>نَ"},{"n":126,"w":[["وَإِنْ","wa-in","And if","এবং যদি"],["عَاقَبْتُمْ","‘āqabtum","you retaliate","তোমরা প্রতিশোধ নাও"],["فَعَاقِبُوا۟","fa‘āqibū","then retaliate","তবে তোমরা প্রতিশোধ নিবে"],["بِمِثْلِ","bimith'li","with the like","সমান"],["مَا","mā","of what","(তার) যা"],["عُوقِبْتُم","‘ūqib'tum","you were afflicted","কষ্ট দেয়া হয়েছে তোমাদের"],["بِهِۦ ۖ","bihi","with [it]","তার সাথে"],["وَلَئِن","wala-in","But if","কিন্তু অবশ্যই যদি"],["صَبَرْتُمْ","ṣabartum","you are patient","তোমরা ধৈর্য ধরো"],["لَهُوَ","lahuwa","surely (it) is","অবশ্যই তা"],["خَيْرٌۭ","khayrun","better","উত্তম"],["لِّلصَّـٰبِرِينَ","lilṣṣābirīna","for those who are patient","জন্যে ধৈর্যশীলদের"]],"t":"وَإِنْ عَاقَ<q>بْ</>تُمْ فَعَاقِبُو<s>ا۟</> بِمِثْلِ مَا عُوقِ<q>بْ</><f>تُم بِ</><m>هِۦ</> ۖ وَلَئِ<k>ن صَ</>بَرْتُمْ لَهُوَ خَيْ<w>رٌۭ لِّ</>ل<m>صَّٰ</>بِ<p>رِي</>نَ"},{"n":127,"w":[["وَٱصْبِرْ","wa-iṣ'bir","And be patient","আর তুমি ধৈর্য ধরো"],["وَمَا","wamā","and not","এবং না"],["صَبْرُكَ","ṣabruka","(is) your patience","তোমার ধৈর্য (সম্ভব)"],["إِلَّا","illā","but","ছাড়া"],["بِٱللَّهِ ۚ","bil-lahi","from Allah","সাহায্য আল্লাহর"],["وَلَا","walā","And (do) not","এবং না"],["تَحْزَنْ","taḥzan","grieve","দুঃখ করো"],["عَلَيْهِمْ","‘alayhim","over them","কারণে তাদের"],["وَلَا","walā","and (do) not","এবং না"],["تَكُ","taku","be","তুমি হয়ো"],["فِى","fī","in","মধ্যে"],["ضَيْقٍۢ","ḍayqin","distress","সংকীর্ণতার"],["مِّمَّا","mimmā","for what","তা থেকে যা"],["يَمْكُرُونَ","yamkurūna","they plot","তারা ষড়যন্ত্র করছে"]],"t":"وَ<h>ٱ</>صْبِرْ وَمَا صَ<q>بْ</>رُكَ إِلَّا بِ<h>ٱ</>للَّهِ ۚ وَلَا تَحْزَنْ عَلَيْهِمْ وَلَا تَكُ فِى ضَيْ<d>قٍۢ مِّ</><g>مَّ</>ا يَمْكُ<p>رُو</>نَ"},{"n":128,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["مَعَ","ma‘a","(is) with","সাথে (আছেন)"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ٱتَّقَوا۟","ittaqaw","fear (Him)","তাকওয়া অবলম্বন করে"],["وَّٱلَّذِينَ","wa-alladhīna","and those who","এবং যারা"],["هُم","hum","[they]","তারা"],["مُّحْسِنُونَ","muḥ'sinūna","(are) good-doers","সৎকর্মপরায়ণ"]],"t":"إِ<g>نَّ</> <h>ٱ</>للَّهَ مَعَ <h>ٱ</>لَّذِينَ <h>ٱ</>تَّقَو<s>ا۟</> وَّ<h>ٱ</>لَّذِينَ <y>هُم مُّ</>حْسِ<p>نُو</>نَ"}]}