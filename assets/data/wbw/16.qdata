{"n":16,"a":[{"n":1,"w":[["أَتَىٰٓ","atā","Will come","এসেছে"],["أَمْرُ","amru","(the) command of Allah","আদেশ"],["ٱللَّهِ","l-lahi","(the) command of Allah","আল্লাহ্‌র"],["فَلَا","falā","so (do) not","সুতরাং না"],["تَسْتَعْجِلُوهُ ۚ","tasta‘jilūhu","(be) impatient for it","তা তোমরা তাড়াহুড়া করতে চেয়ো"],["سُبْحَـٰنَهُۥ","sub'ḥānahu","Glorified is He","তিনি পবিত্র"],["وَتَعَـٰلَىٰ","wata‘ālā","and Exalted (is) He","ও বহু ঊর্দ্ধে"],["عَمَّا","‘ammā","above what","তা থেকে যা"],["يُشْرِكُونَ","yush'rikūna","they associate","তারা শরীক করে"]],"t":"أَتَ<o>ىٰٓ</> أَمْرُ <h>ٱ</>للَّهِ فَلَا تَسْتَعْجِلُوهُ ۚ سُ<q>بْ</><m>حَٰ</>نَهُ<m>ۥ</> وَتَ<m>عَٰ</>لَىٰ عَ<g>مَّ</>ا يُشْرِ<p>كُو</>نَ"},{"n":2,"w":[["يُنَزِّلُ","yunazzilu","He sends down","অবতীর্ণ করেন"],["ٱلْمَلَـٰٓئِكَةَ","l-malāikata","the Angels","ফেরেশতাদেরকে"],["بِٱلرُّوحِ","bil-rūḥi","with the inspiration","দিয়ে ওহী"],["مِنْ","min","of","থেকে"],["أَمْرِهِۦ","amrihi","His Command","তাঁর নির্দেশের"],["عَلَىٰ","‘alā","upon","উপর"],["مَن","man","whom","(তার) যাকে"],["يَشَآءُ","yashāu","He wills","ইচ্ছে করেন"],["مِنْ","min","of","মধ্য হ'তে"],["عِبَادِهِۦٓ","‘ibādihi","His slaves","তাঁর দাসদের"],["أَنْ","an","that","যে"],["أَنذِرُوٓا۟","andhirū","Warn","\"তোমরা সতর্ক করো"],["أَنَّهُۥ","annahu","that [He]","এই মর্মে যে"],["لَآ","lā","(there is) no","নেই"],["إِلَـٰهَ","ilāha","god","কোন ইলাহ"],["إِلَّآ","illā","except","ছাড়া"],["أَنَا۠","anā","Me","আমি"],["فَٱتَّقُونِ","fa-ittaqūni","so fear Me","সুতরাং তোমরা আমাকে ভয় করো\""]],"t":"يُنَزِّلُ <h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةَ بِ<h>ٱ</><l>ل</>رُّوحِ مِنْ أَمْرِ<m>هِۦ</> عَلَىٰ <d>مَن يَ</><o>شَآ</>ءُ مِنْ عِبَادِ<o>هِۦٓ</> أَنْ أَ<k>نذِ</><o>رُوٓ</><s>ا۟</> أَ<g>نَّ</>هُ<m>ۥ</> <o>لَآ</> إِ<m>لَٰ</>هَ إِ<o>لَّآ</> أَنَا۠ فَ<h>ٱ</>تَّ<p>قُو</>نِ"},{"n":3,"w":[["خَلَقَ","khalaqa","He created","তিনি সৃষ্টি করেছেন"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশমন্ডলী"],["وَٱلْأَرْضَ","wal-arḍa","and the earth","ও পৃথিবী"],["بِٱلْحَقِّ ۚ","bil-ḥaqi","in truth","দিয়ে মহাসত্য"],["تَعَـٰلَىٰ","ta‘ālā","Exalted is He","বহু ঊর্দ্ধে"],["عَمَّا","‘ammā","above what","তা থেকে যা"],["يُشْرِكُونَ","yush'rikūna","they associate","তারা শরীক করে"]],"t":"خَلَقَ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضَ بِ<h>ٱ</>لْحَقِّ ۚ تَ<m>عَٰ</>لَىٰ عَ<g>مَّ</>ا يُشْرِ<p>كُو</>نَ"},{"n":4,"w":[["خَلَقَ","khalaqa","He created","তিনি সৃষ্টি করেছেন"],["ٱلْإِنسَـٰنَ","l-insāna","the human kind","মানুষকে"],["مِن","min","from","থেকে"],["نُّطْفَةٍۢ","nuṭ'fatin","a minute quantity of semen","শুক্র"],["فَإِذَا","fa-idhā","then behold","অতঃপর যখন (সৃষ্টি হলো)"],["هُوَ","huwa","he","সে (হলো)"],["خَصِيمٌۭ","khaṣīmun","(is) an opponent","ঝগড়াটে"],["مُّبِينٌۭ","mubīnun","clear","সুস্পষ্ট"]],"t":"خَلَقَ <h>ٱ</>لْإِ<k>نسَٰ</>نَ <d>مِن نُّ</><q>طْ</>فَ<k>ةٍۢ فَ</>إِذَا هُوَ خَصِي<d>مٌۭ مُّ</><p>بِي</>نٌۭ"},{"n":5,"w":[["وَٱلْأَنْعَـٰمَ","wal-an‘āma","And the cattle","এবং গবাদিপশু"],["خَلَقَهَا ۗ","khalaqahā","He created them","তিনি সৃষ্টি করেছেন তা"],["لَكُمْ","lakum","for you","তোমাদের জন্যে"],["فِيهَا","fīhā","in them","তার মধ্যে (আছে)"],["دِفْءٌۭ","dif'on","(is) warmth","শীত নিবারক উপকরণ"],["وَمَنَـٰفِعُ","wamanāfi‘u","and benefits","ও উপকারিতাসমূহ"],["وَمِنْهَا","wamin'hā","and from them","এবং তা থেকে"],["تَأْكُلُونَ","takulūna","you eat","তোমরা খাও"]],"t":"وَ<h>ٱ</>لْأَنْ<m>عَٰ</>مَ خَلَقَهَا ۗ لَكُمْ فِيهَا دِفْ<d>ءٌۭ وَ</>مَ<m>نَٰ</>فِعُ وَمِنْهَا تَأْكُ<p>لُو</>نَ"},{"n":6,"w":[["وَلَكُمْ","walakum","And for you","এবং তোমাদের জন্যে"],["فِيهَا","fīhā","in them","তার মধ্যে (আছে)"],["جَمَالٌ","jamālun","(is) beauty","সৌন্দর্য"],["حِينَ","ḥīna","when","যখন"],["تُرِيحُونَ","turīḥūna","you bring them in","তোমরা সন্ধ্যায় চারণভূমি থেকে আনো"],["وَحِينَ","waḥīna","and when","ও যখন"],["تَسْرَحُونَ","tasraḥūna","you take them out","তোমরা সকালে চারণভূমিতে নিয়ে যাও"]],"t":"وَلَكُمْ فِيهَا جَمَالٌ حِينَ تُرِيحُونَ وَحِينَ تَسْرَ<p>حُو</>نَ"},{"n":7,"w":[["وَتَحْمِلُ","wataḥmilu","And they carry","এবং তা বহন করে"],["أَثْقَالَكُمْ","athqālakum","your loads","তোমাদের ভার"],["إِلَىٰ","ilā","to","দিকে"],["بَلَدٍۢ","baladin","a land","এমন শহরের"],["لَّمْ","lam","not","না"],["تَكُونُوا۟","takūnū","you could","তোমরা ছিলে"],["بَـٰلِغِيهِ","bālighīhi","reach it","সেখানে পৌঁছাতে সক্ষম"],["إِلَّا","illā","except","এ ছাড়া"],["بِشِقِّ","bishiqqi","with great trouble","সহ কষ্ট"],["ٱلْأَنفُسِ ۚ","l-anfusi","(to) yourselves","প্রানান্ত"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["رَبَّكُمْ","rabbakum","your Lord","তোমার রব"],["لَرَءُوفٌۭ","laraūfun","surely is Most Kind","অবশ্যই অনুগ্রহশীল"],["رَّحِيمٌۭ","raḥīmun","Most Merciful","পরম দয়ালু"]],"t":"وَتَحْمِلُ أَثْقَالَكُمْ إِلَىٰ بَلَ<w>دٍۢ لَّ</>مْ تَكُونُو<s>ا۟</> <m>بَٰ</>لِغِيهِ إِلَّا بِشِقِّ <h>ٱ</>لْأَ<k>نفُ</>سِ ۚ إِ<g>نَّ</> رَبَّكُمْ لَرَءُو<w>فٌۭ رَّ</><p>حِي</>مٌۭ"},{"n":8,"w":[["وَٱلْخَيْلَ","wal-khayla","And horses","এবং ঘোড়া (সৃষ্টি করেছেন)"],["وَٱلْبِغَالَ","wal-bighāla","and mules","ও খচ্চর"],["وَٱلْحَمِيرَ","wal-ḥamīra","and donkeys","ও গাধা"],["لِتَرْكَبُوهَا","litarkabūhā","for you to ride them","জন্যে তোমাদের চড়ার"],["وَزِينَةًۭ ۚ","wazīnatan","and (as) adornment","ও শোভা (স্বরূপ)"],["وَيَخْلُقُ","wayakhluqu","And He creates","এবং তিনি সৃষ্টি করেছেন"],["مَا","mā","what","(কিছু) যা"],["لَا","lā","not","না"],["تَعْلَمُونَ","ta‘lamūna","you know","তোমরা জানো"]],"t":"وَ<h>ٱ</>لْخَيْلَ وَ<h>ٱ</>لْبِغَالَ وَ<h>ٱ</>لْحَمِيرَ لِتَرْكَبُوهَا وَزِينَ<d>ةًۭ ۚ وَ</>يَخْلُقُ مَا لَا تَعْلَ<p>مُو</>نَ"},{"n":9,"w":[["وَعَلَى","wa‘alā","And upon","এবং উপর"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর (দায়িত্ব)"],["قَصْدُ","qaṣdu","(is) the direction","প্রদর্শন"],["ٱلسَّبِيلِ","l-sabīli","(of) the way","পথ"],["وَمِنْهَا","wamin'hā","and among them","কিন্তু তা থেকে আছে"],["جَآئِرٌۭ ۚ","jāirun","(are) crooked","বাঁকা (পথও)"],["وَلَوْ","walaw","And if","এবং যদি"],["شَآءَ","shāa","He willed","ইচ্ছে করেন"],["لَهَدَىٰكُمْ","lahadākum","surely He would have guided you","অবশ্যই সৎপথে পরিচালনা করতেন তোমাদের"],["أَجْمَعِينَ","ajma‘īna","all","সকলকেই"]],"t":"وَعَلَى <h>ٱ</>للَّهِ قَصْدُ <h>ٱ</><l>ل</>سَّبِيلِ وَمِنْهَا <o>جَآ</>ئِ<d>رٌۭ ۚ وَ</>لَوْ <o>شَآ</>ءَ لَهَدَ<m>ىٰ</>كُمْ أَ<q>جْ</>مَ<p>عِي</>نَ"},{"n":10,"w":[["هُوَ","huwa","He","তিনিই (রব)"],["ٱلَّذِىٓ","alladhī","(is) the One Who","যিনি"],["أَنزَلَ","anzala","sends down","বর্ষণ করেছেন"],["مِنَ","mina","from","থেকে"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশ"],["مَآءًۭ ۖ","māan","water","পানি"],["لَّكُم","lakum","for you","জন্যে তোমাদের"],["مِّنْهُ","min'hu","of it","কিছু তার"],["شَرَابٌۭ","sharābun","(is) drink","পানীয় (পেয়ে থাকো)"],["وَمِنْهُ","wamin'hu","and from it","এবং তা থেকে"],["شَجَرٌۭ","shajarun","(grows) vegetation","গাছপালা (জন্মে)"],["فِيهِ","fīhi","in which","তার মধ্যে"],["تُسِيمُونَ","tusīmūna","you pasture your cattle","তোমরা পশু চরিয়ে থাকো"]],"t":"هُوَ <h>ٱ</>لَّ<o>ذِىٓ</> أَ<k>نزَ</>لَ مِنَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ <o>مَآ</><w>ءًۭ ۖ لَّ</><y>كُم مِّ</>نْهُ شَرَا<d>بٌۭ وَ</>مِنْهُ شَجَ<k>رٌۭ فِ</>يهِ تُسِي<p>مُو</>نَ"},{"n":11,"w":[["يُنۢبِتُ","yunbitu","He causes to grow","তিনি উদগত করেন"],["لَكُم","lakum","for you","জন্যে তোমাদের"],["بِهِ","bihi","with it","দিয়ে তা"],["ٱلزَّرْعَ","l-zar‘a","the crops","শস্য"],["وَٱلزَّيْتُونَ","wal-zaytūna","and the olives","ও যায়তুনসমূহ"],["وَٱلنَّخِيلَ","wal-nakhīla","and the date-palms","ও খেজুরসমূহ"],["وَٱلْأَعْنَـٰبَ","wal-a‘nāba","and the grapes","ও আঙ্গুরসমূহ"],["وَمِن","wamin","and of","এবং ধরণের"],["كُلِّ","kulli","every kind","সব"],["ٱلثَّمَرَٰتِ ۗ","l-thamarāti","(of) fruits","ফলসমূহ"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে (রয়েছে)"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَةًۭ","laāyatan","surely (is) a sign","অবশ্যই নিদর্শন"],["لِّقَوْمٍۢ","liqawmin","for a people","লোকদের জন্যে"],["يَتَفَكَّرُونَ","yatafakkarūna","who reflect","(যারা) চিন্তা ভাবনা করে"]],"t":"يُ<i>نۢبِ</>تُ لَ<f>كُم بِ</>هِ <h>ٱ</><l>ل</>زَّرْعَ وَ<h>ٱ</><l>ل</>زَّيْتُونَ وَ<h>ٱ</><l>ل</><g>نَّ</>خِيلَ وَ<h>ٱ</>لْأَعْ<m>نَٰ</>بَ وَمِ<k>ن كُ</>لِّ <h>ٱ</><l>ل</>ثَّمَ<m>رَٰ</>تِ ۗ إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَايَ<w>ةًۭ لِّ</>قَوْ<d>مٍۢ يَ</>تَفَكَّ<p>رُو</>نَ"},{"n":12,"w":[["وَسَخَّرَ","wasakhara","And He has subjected","এবং অধীন করেছেন"],["لَكُمُ","lakumu","for you","তোমাদের জন্যে"],["ٱلَّيْلَ","al-layla","the night","রাতকে"],["وَٱلنَّهَارَ","wal-nahāra","and the day","ও দিনকে"],["وَٱلشَّمْسَ","wal-shamsa","and the sun","এবং সূর্যকে"],["وَٱلْقَمَرَ ۖ","wal-qamara","and the moon","ও চাঁদকে"],["وَٱلنُّجُومُ","wal-nujūmu","and the stars","এবং তারাগুলোও"],["مُسَخَّرَٰتٌۢ","musakharātun","(are) subjected","অধীন হয়েছে"],["بِأَمْرِهِۦٓ ۗ","bi-amrihi","by His command","দিয়ে তাঁর বিধান"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে (রয়েছে)"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَـٰتٍۢ","laāyātin","surely (are) signs","অবশ্যই নিদর্শনসমূহ"],["لِّقَوْمٍۢ","liqawmin","for a people","জন্যে লোকদের"],["يَعْقِلُونَ","ya‘qilūna","who use reason","(যারা)জ্ঞান রাখে"]],"t":"وَسَخَّرَ لَكُمُ <h>ٱ</>لَّيْلَ وَ<h>ٱ</><l>ل</><g>نَّ</>هَارَ وَ<h>ٱ</><l>ل</>شَّمْسَ وَ<h>ٱ</>لْقَمَرَ ۖ وَ<h>ٱ</><l>ل</><g>نُّ</>جُومُ مُسَخَّ<m>رَٰ</><i>تٌۢ بِ</>أَمْرِ<o>هِۦٓ ۗ</> إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَا<m>يَٰ</><w>تٍۢ لِّ</>قَوْ<d>مٍۢ يَ</>عْقِ<p>لُو</>نَ"},{"n":13,"w":[["وَمَا","wamā","And whatever","আরো (কিছু) যা"],["ذَرَأَ","dhara-a","He multiplied","সৃষ্টি করেছেন"],["لَكُمْ","lakum","for you","তোমাদের জন্যে"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["مُخْتَلِفًا","mukh'talifan","(of) varying","বিভিন্ন"],["أَلْوَٰنُهُۥٓ ۗ","alwānuhu","colors","তার রংসমূহ"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে (রয়েছে)"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَةًۭ","laāyatan","surely (is) a sign","অবশ্যই নিদর্শন"],["لِّقَوْمٍۢ","liqawmin","for a people","লোকদের জন্যে"],["يَذَّكَّرُونَ","yadhakkarūna","who remember","(যারা) শিক্ষা গ্রহণ করে"]],"t":"وَمَا ذَرَأَ لَكُمْ فِى <h>ٱ</>لْأَرْضِ مُخْتَلِفًا أَلْ<m>وَٰ</>نُهُ<o>ۥٓ ۗ</> إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَايَ<w>ةًۭ لِّ</>قَوْ<d>مٍۢ يَ</>ذَّكَّ<p>رُو</>نَ"},{"n":14,"w":[["وَهُوَ","wahuwa","And He","এবং তিনি"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["سَخَّرَ","sakhara","subjected","অধীন করেছেন"],["ٱلْبَحْرَ","l-baḥra","the sea","সমুদ্রকে"],["لِتَأْكُلُوا۟","litakulū","for you to eat","যেন তোমরা  খেতে পারো"],["مِنْهُ","min'hu","from it","তা থেকে"],["لَحْمًۭا","laḥman","meat","(মাছ) গোশত"],["طَرِيًّۭا","ṭariyyan","fresh","তাজা"],["وَتَسْتَخْرِجُوا۟","watastakhrijū","and that you bring forth","তোমরা বের করতে পারো"],["مِنْهُ","min'hu","from it","তা থেকে"],["حِلْيَةًۭ","ḥil'yatan","ornaments","সৌন্দর্য শোভা (মনি-মুক্তা)"],["تَلْبَسُونَهَا","talbasūnahā","(that) you wear them","তোমরা তা পরিধান করো"],["وَتَرَى","watarā","And you see","এবং দেখছো"],["ٱلْفُلْكَ","l-ful'ka","the ships","নৌযানসমূহকে"],["مَوَاخِرَ","mawākhira","ploughing","পানি বিদীর্ণকারী"],["فِيهِ","fīhi","through it","তার মধ্যে"],["وَلِتَبْتَغُوا۟","walitabtaghū","and that you may seek","এবং যেন তোমরা সন্ধান করতে পারো"],["مِن","min","of","থেকে"],["فَضْلِهِۦ","faḍlihi","His Bounty","তাঁর অনুগ্রহ"],["وَلَعَلَّكُمْ","wala‘allakum","and that you may","এবং তোমরা যাতে"],["تَشْكُرُونَ","tashkurūna","(be) grateful","কৃতজ্ঞতা প্রকাশ করো"]],"t":"وَهُوَ <h>ٱ</>لَّذِى سَخَّرَ <h>ٱ</>لْبَحْرَ لِتَأْكُلُو<s>ا۟</> مِنْهُ لَحْ<k>مًۭا طَ</>رِ<d>يًّۭا وَ</>تَسْتَخْرِجُو<s>ا۟</> مِنْهُ حِلْيَ<k>ةًۭ تَ</>لْبَسُونَهَا وَتَرَى <h>ٱ</>لْفُلْكَ مَوَاخِرَ فِيهِ وَلِتَ<q>بْ</>تَغُو<s>ا۟</> مِ<k>ن فَ</>ضْلِ<m>هِۦ</> وَلَعَلَّكُمْ تَشْكُ<p>رُو</>نَ"},{"n":15,"w":[["وَأَلْقَىٰ","wa-alqā","And He has cast","এবং তিনি স্থাপন করেছেন"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["رَوَٰسِىَ","rawāsiya","firm mountains","পর্বতসমূহকে"],["أَن","an","lest","(এমন না হয়) যে"],["تَمِيدَ","tamīda","it should shake","হেলে যায়"],["بِكُمْ","bikum","with you","তোমাদের নিয়ে"],["وَأَنْهَـٰرًۭا","wa-anhāran","and rivers","ও নদীসমূহ"],["وَسُبُلًۭا","wasubulan","and roads","এবং রাস্তাসমূহ"],["لَّعَلَّكُمْ","la‘allakum","so that you may","যাতে তোমরা"],["تَهْتَدُونَ","tahtadūna","be guided","পথের সন্ধান পাও"]],"t":"وَأَلْقَىٰ فِى <h>ٱ</>لْأَرْضِ رَ<m>وَٰ</>سِىَ أَ<k>ن تَ</>مِيدَ بِكُمْ وَأَنْ<m>هَٰ</><d>رًۭا وَ</>سُبُلًۭ<w>ا لَّ</>عَلَّكُمْ تَهْتَ<p>دُو</>نَ"},{"n":16,"w":[["وَعَلَـٰمَـٰتٍۢ ۚ","wa‘alāmātin","And landmarks","ও (যমীনে) পথনির্ণায়ক চিহ্নসমূহ"],["وَبِٱلنَّجْمِ","wabil-najmi","And by the stars","এবং সাহায্যে নক্ষত্রের"],["هُمْ","hum","they","তারা"],["يَهْتَدُونَ","yahtadūna","guide themselves","পথ নির্দেশ পায়"]],"t":"وَعَ<m>لَٰمَٰ</><d>تٍۢ ۚ وَ</>بِ<h>ٱ</><l>ل</><g>نَّ</><q>جْ</>مِ هُمْ يَهْتَ<p>دُو</>نَ"},{"n":17,"w":[["أَفَمَن","afaman","Then is He Who","তবে কি যিনি"],["يَخْلُقُ","yakhluqu","creates","সৃষ্টি করেছেন"],["كَمَن","kaman","like one who","(তার) মতো যে"],["لَّا","lā","(does) not","না"],["يَخْلُقُ ۗ","yakhluqu","create","সৃষ্টি করে (কোন কিছুই)"],["أَفَلَا","afalā","Then will you not","তবুও কি না"],["تَذَكَّرُونَ","tadhakkarūna","remember","তোমরা শিক্ষা গ্রহণ করবে"]],"t":"أَفَ<d>مَن يَ</>خْلُقُ كَ<w>مَن لَّ</>ا يَخْلُقُ ۗ أَفَلَا تَذَكَّ<p>رُو</>نَ"},{"n":18,"w":[["وَإِن","wa-in","And if","এবং যদি"],["تَعُدُّوا۟","ta‘uddū","you should count","তোমরা গণনা করো"],["نِعْمَةَ","ni‘'mata","the Favors of Allah","অনুগ্রহকে"],["ٱللَّهِ","l-lahi","the Favors of Allah","আল্লাহর"],["لَا","lā","not","না"],["تُحْصُوهَآ ۗ","tuḥ'ṣūhā","you could enumerate them","তার সংখ্যা নির্ণয় করতে পারবে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["لَغَفُورٌۭ","laghafūrun","(is) Oft-Forgiving","অবশ্যই ক্ষমাশীল"],["رَّحِيمٌۭ","raḥīmun","Most Merciful","পরম দয়ালু"]],"t":"وَإِ<k>ن تَ</>عُدُّو<s>ا۟</> نِعْمَةَ <h>ٱ</>للَّهِ لَا تُحْصُو<o>هَآ ۗ</> إِ<g>نَّ</> <h>ٱ</>للَّهَ لَغَفُو<w>رٌۭ رَّ</><p>حِي</>مٌۭ"},{"n":19,"w":[["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ্‌"],["يَعْلَمُ","ya‘lamu","knows","জানেন"],["مَا","mā","what","যা"],["تُسِرُّونَ","tusirrūna","you conceal","তোমরা গোপন রাখো"],["وَمَا","wamā","and what","এবং যা"],["تُعْلِنُونَ","tu‘'linūna","you reveal","তোমরা প্রকাশ করো"]],"t":"وَ<h>ٱ</>للَّهُ يَعْلَمُ مَا تُسِرُّونَ وَمَا تُعْلِ<p>نُو</>نَ"},{"n":20,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those whom","এবং যারা"],["يَدْعُونَ","yad‘ūna","they invoke","ডাকে"],["مِن","min","besides","থেকে"],["دُونِ","dūni","besides","ছাড়া"],["ٱللَّهِ","l-lahi","Allah","আল্লাহকে"],["لَا","lā","not","না"],["يَخْلُقُونَ","yakhluqūna","they create","তারা সৃষ্টি করে"],["شَيْـًۭٔا","shayan","anything","কোনো কিছু"],["وَهُمْ","wahum","but (are) themselves","বরং তাদেরকে"],["يُخْلَقُونَ","yukh'laqūna","created","সৃষ্টি করা হয়েছে"]],"t":"وَ<h>ٱ</>لَّذِينَ يَ<q>دْ</>عُونَ مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ لَا يَخْلُقُونَ شَ<d>يْـًۭٔا وَ</>هُمْ يُخْلَ<p>قُو</>نَ"},{"n":21,"w":[["أَمْوَٰتٌ","amwātun","(They are) dead","(তারা) মৃত"],["غَيْرُ","ghayru","not alive","নয়"],["أَحْيَآءٍۢ ۖ","aḥyāin","not alive","জীবিত"],["وَمَا","wamā","And not","এবং না"],["يَشْعُرُونَ","yash‘urūna","they perceive","চেতনা রাখে"],["أَيَّانَ","ayyāna","when","কবে"],["يُبْعَثُونَ","yub'‘athūna","they will be resurrected","উঠানো হবে তাদের"]],"t":"أَمْ<m>وَٰ</>تٌ غَيْرُ أَحْ<o>يَآ</><d>ءٍۢ ۖ وَ</>مَا يَشْعُرُونَ أَيَّانَ يُ<q>بْ</>عَ<p>ثُو</>نَ"},{"n":22,"w":[["إِلَـٰهُكُمْ","ilāhukum","Your god","তোমাদের ইলাহ"],["إِلَـٰهٌۭ","ilāhun","(is) God","ইলাহ"],["وَٰحِدٌۭ ۚ","wāḥidun","One","একই"],["فَٱلَّذِينَ","fa-alladhīna","But those who","সুতরাং যারা"],["لَا","lā","(do) not","না"],["يُؤْمِنُونَ","yu'minūna","believe","বিশ্বাস করে"],["بِٱلْـَٔاخِرَةِ","bil-ākhirati","in the Hereafter","প্রতি আখেরাতের"],["قُلُوبُهُم","qulūbuhum","their hearts","তাদের অন্তরসমূহ"],["مُّنكِرَةٌۭ","munkiratun","refuse","সত্যবিমুখ"],["وَهُم","wahum","and they","এবং তারা"],["مُّسْتَكْبِرُونَ","mus'takbirūna","(are) arrogant","অহংকারী"]],"t":"إِ<m>لَٰ</>هُكُمْ إِ<m>لَٰ</><d>هٌۭ وَٰ</>حِ<k>دٌۭ ۚ فَ</><h>ٱ</>لَّذِينَ لَا يُؤْمِنُونَ بِ<h>ٱ</>لْءَاخِرَةِ قُلُوبُ<y>هُم مُّ</><k>نكِ</>رَ<d>ةٌۭ وَ</><y>هُم مُّ</>سْتَكْبِ<p>رُو</>نَ"},{"n":23,"w":[["لَا","lā","No doubt","নেই"],["جَرَمَ","jarama","No doubt","সন্দেহ"],["أَنَّ","anna","that","যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["يَعْلَمُ","ya‘lamu","knows","জানেন"],["مَا","mā","what","যা"],["يُسِرُّونَ","yusirrūna","they conceal","তারা গোপন রাখে"],["وَمَا","wamā","and what","এবং যা"],["يُعْلِنُونَ ۚ","yu‘'linūna","they reveal","তারা প্রকাশ করে"],["إِنَّهُۥ","innahu","Indeed, He","নিশ্চয়ই তিনি"],["لَا","lā","(does) not","না"],["يُحِبُّ","yuḥibbu","love","ভালোবাসেন"],["ٱلْمُسْتَكْبِرِينَ","l-mus'takbirīna","the arrogant ones","অহংকারীদেরকে"]],"t":"لَا جَرَمَ أَ<g>نَّ</> <h>ٱ</>للَّهَ يَعْلَمُ مَا يُسِرُّونَ وَمَا يُعْلِنُونَ ۚ إِ<g>نَّ</>هُ<m>ۥ</> لَا يُحِبُّ <h>ٱ</>لْمُسْتَكْبِ<p>رِي</>نَ"},{"n":24,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["قِيلَ","qīla","it is said","বলা হয়"],["لَهُم","lahum","to them","তাদেরকে"],["مَّاذَآ","mādhā","What","\"কি"],["أَنزَلَ","anzala","has your Lord sent down","অবতীর্ণ করেছেন"],["رَبُّكُمْ ۙ","rabbukum","has your Lord sent down","তোমাদের রব"],["قَالُوٓا۟","qālū","They say","তারা বলে"],["أَسَـٰطِيرُ","asāṭīru","Tales","\"উপকথাসমূহ"],["ٱلْأَوَّلِينَ","l-awalīna","(of) the ancient","পূর্ববর্তীদের\""]],"t":"وَإِذَا قِيلَ لَ<y>هُم مَّ</>ا<o>ذَآ</> أَ<k>نزَ</>لَ رَبُّكُمْ ۙ قَا<o>لُوٓ</><s>ا۟</> أَ<m>سَٰ</>طِيرُ <h>ٱ</>لْأَوَّ<p>لِي</>نَ"},{"n":25,"w":[["لِيَحْمِلُوٓا۟","liyaḥmilū","That they may bear","যেন তারা বহন করে"],["أَوْزَارَهُمْ","awzārahum","their own burdens","তাদের বোঝাসমূহ (পাপের)"],["كَامِلَةًۭ","kāmilatan","(in) full","সম্পূর্ণ"],["يَوْمَ","yawma","on (the) Day","দিনে"],["ٱلْقِيَـٰمَةِ ۙ","l-qiyāmati","(of) the Resurrection","ক্বিয়ামাতের"],["وَمِنْ","wamin","and of","এবং থেকে"],["أَوْزَارِ","awzāri","the burdens","বোঝাসমূহ"],["ٱلَّذِينَ","alladhīna","(of) those whom","(তাদের) যাদের"],["يُضِلُّونَهُم","yuḍillūnahum","they misled [them]","তারা বিভ্রান্ত করেছে তাদেরকে"],["بِغَيْرِ","bighayri","without","ছাড়া"],["عِلْمٍ ۗ","‘il'min","knowledge","কোনো জ্ঞান"],["أَلَا","alā","Unquestionably","জেনে রাখো"],["سَآءَ","sāa","evil","অতি নিকৃষ্ট"],["مَا","mā","(is) what","যা"],["يَزِرُونَ","yazirūna","they will bear","তারা বহন করবে"]],"t":"لِيَحْمِ<o>لُوٓ</><s>ا۟</> أَوْزَارَهُمْ كَامِلَ<d>ةًۭ يَ</>وْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ ۙ وَمِنْ أَوْزَارِ <h>ٱ</>لَّذِينَ يُضِلُّونَ<f>هُم بِ</>غَيْرِ عِلْمٍ ۗ أَلَا <o>سَآ</>ءَ مَا يَزِ<p>رُو</>نَ"},{"n":26,"w":[["قَدْ","qad","Verily","নিশ্চয়ই"],["مَكَرَ","makara","plotted","চক্রান্ত করেছিলো"],["ٱلَّذِينَ","alladhīna","those who","যারা (ছিলো)"],["مِن","min","(were) before them","থেকেই"],["قَبْلِهِمْ","qablihim","(were) before them","তাদের পূর্ব"],["فَأَتَى","fa-atā","but Allah came","অতঃপর আসলেন (আঘাত করলেন)"],["ٱللَّهُ","l-lahu","but Allah came","আল্লাহ্‌"],["بُنْيَـٰنَهُم","bun'yānahum","(at) their building","তাদের কাঠামোতে"],["مِّنَ","mina","from","থেকে"],["ٱلْقَوَاعِدِ","l-qawā‘idi","the foundations","ভিত্তিমূলের"],["فَخَرَّ","fakharra","so fell","অতঃপর ধসে পড়লো"],["عَلَيْهِمُ","‘alayhimu","upon them","উপর তাদের"],["ٱلسَّقْفُ","l-saqfu","the roof","ছাদ"],["مِن","min","from","হ'তে"],["فَوْقِهِمْ","fawqihim","above them","উপর তাদের"],["وَأَتَىٰهُمُ","wa-atāhumu","and came to them","এবং তাদের উপর আসলো"],["ٱلْعَذَابُ","l-‘adhābu","the punishment","শাস্তি"],["مِنْ","min","from","থেকে"],["حَيْثُ","ḥaythu","where","যেখান"],["لَا","lā","they (did) not perceive","না"],["يَشْعُرُونَ","yash‘urūna","they (did) not perceive","তারা ধারণ করে"]],"t":"قَ<q>دْ</> مَكَرَ <h>ٱ</>لَّذِينَ مِ<k>ن قَ</><q>بْ</>لِهِمْ فَأَتَى <h>ٱ</>للَّهُ بُنْ<m>يَٰ</>نَ<y>هُم مِّ</>نَ <h>ٱ</>لْقَوَاعِدِ فَخَرَّ عَلَيْهِمُ <h>ٱ</><l>ل</>سَّ<q>قْ</>فُ مِ<k>ن فَ</>وْقِهِمْ وَأَتَ<m>ىٰ</>هُمُ <h>ٱ</>لْعَذَابُ مِنْ حَيْثُ لَا يَشْعُ<p>رُو</>نَ"},{"n":27,"w":[["ثُمَّ","thumma","Then","অতঃপর"],["يَوْمَ","yawma","(on) the Day","দিনে"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) the Resurrection","ক্বিয়ামাতের"],["يُخْزِيهِمْ","yukh'zīhim","He will disgrace them","তিনি লাঞ্ছিত করবেন তাদের"],["وَيَقُولُ","wayaqūlu","and say","এবং বলবেন"],["أَيْنَ","ayna","Where","\"কোথায়"],["شُرَكَآءِىَ","shurakāiya","(are) My partners","আমার শরীকরা"],["ٱلَّذِينَ","alladhīna","those (for) whom","যাদের (ব্যাপারে)"],["كُنتُمْ","kuntum","you used (to)","তোমরা ছিলে"],["تُشَـٰٓقُّونَ","tushāqqūna","oppose","তর্কাতর্কি করতে"],["فِيهِمْ ۚ","fīhim","[in them]","তাদের ব্যাপারে\""],["قَالَ","qāla","Will say","বলবে"],["ٱلَّذِينَ","alladhīna","those who","যাদেরকে"],["أُوتُوا۟","ūtū","were given","দেওয়া হয়েছিলো"],["ٱلْعِلْمَ","l-‘il'ma","the knowledge","জ্ঞান"],["إِنَّ","inna","Indeed","\"নিশ্চয়ই"],["ٱلْخِزْىَ","l-khiz'ya","the disgrace","লাঞ্ছনা রয়েছে"],["ٱلْيَوْمَ","l-yawma","this Day","আজকের দিনে"],["وَٱلسُّوٓءَ","wal-sūa","and evil","ও অমঙ্গল (রয়েছে)"],["عَلَى","‘alā","(are) upon","উপর"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","the disbelievers","কাফেরদের\""]],"t":"ثُ<g>مَّ</> يَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ يُخْزِيهِمْ وَيَقُولُ أَيْنَ شُرَ<o>كَآ</>ءِىَ <h>ٱ</>لَّذِينَ كُ<k>نتُ</>مْ تُ<n>شَٰٓ</>قُّونَ فِيهِمْ ۚ قَالَ <h>ٱ</>لَّذِينَ أُوتُو<s>ا۟</> <h>ٱ</>لْعِلْمَ إِ<g>نَّ</> <h>ٱ</>لْخِزْىَ <h>ٱ</>لْيَوْمَ وَ<h>ٱ</><l>ل</><o>سُّوٓ</>ءَ عَلَى <h>ٱ</>لْ<m>كَٰ</>فِ<p>رِي</>نَ"},{"n":28,"w":[["ٱلَّذِينَ","alladhīna","Those whom ","যাদের (অবস্থান হলো এই)"],["تَتَوَفَّىٰهُمُ","tatawaffāhumu","take them in death","তাদের মৃত্যু ঘটায়"],["ٱلْمَلَـٰٓئِكَةُ","l-malāikatu","the Angels","ফেরেশতারা"],["ظَالِمِىٓ","ẓālimī","(while) wronging","অত্যাচারী অবস্থায়"],["أَنفُسِهِمْ ۖ","anfusihim","themselves","নিজেদের উপর তাদের"],["فَأَلْقَوُا۟","fa-alqawū","then they would offer","তারা যখন আত্নসমর্পন করবে (এবং বলবে)"],["ٱلسَّلَمَ","l-salama","the submission","শান্তি"],["مَا","mā","Not","\"না"],["كُنَّا","kunnā","we were","আমরা ছিলাম"],["نَعْمَلُ","na‘malu","doing","আমরা কাজ করতে"],["مِن","min","any","কোনো"],["سُوٓءٍۭ ۚ","sūin","evil","মন্দ\""],["بَلَىٰٓ","balā","Nay","হ্যাঁ"],["إِنَّ","inna","indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["عَلِيمٌۢ","‘alīmun","(is) All-Knower","খুব জানেন"],["بِمَا","bimā","of what","ঐ সম্পর্কে যা"],["كُنتُمْ","kuntum","you used (to)","তোমরা ছিলে"],["تَعْمَلُونَ","ta‘malūna","do","তোমরা কাজ করতে"]],"t":"ٱلَّذِينَ تَتَوَفَّ<m>ىٰ</>هُمُ <h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةُ ظَالِ<o>مِىٓ</> أَ<k>نفُ</>سِهِمْ ۖ فَأَلْقَوُ<s>ا۟</> <h>ٱ</><l>ل</>سَّلَمَ مَا كُ<g>نَّ</>ا نَعْمَلُ مِ<k>ن سُ</><o>وٓ</><i>ءٍۭ ۚ بَ</>لَ<o>ىٰٓ</> إِ<g>نَّ</> <h>ٱ</>للَّهَ عَلِي<i>مٌۢ بِ</>مَا كُ<k>نتُ</>مْ تَعْمَ<p>لُو</>نَ"},{"n":29,"w":[["فَٱدْخُلُوٓا۟","fa-ud'khulū","So enter","সুতরাং তোমরা প্রবেশ করো"],["أَبْوَٰبَ","abwāba","(the) gates","দরজাসমূহে"],["جَهَنَّمَ","jahannama","(of) Hell","জাহান্নামের"],["خَـٰلِدِينَ","khālidīna","(to) abide forever","স্থায়ী বসবাসকারী হবে"],["فِيهَا ۖ","fīhā","in it","তার মধ্যে"],["فَلَبِئْسَ","falabi'sa","Surely, wretched","অতএব অবশ্যই নিকৃষ্ট"],["مَثْوَى","mathwā","(is the) abode","আবাসস্থল"],["ٱلْمُتَكَبِّرِينَ","l-mutakabirīna","(of) the arrogant","অহংকারীদের"]],"t":"فَ<h>ٱ</><q>دْ</>خُ<o>لُوٓ</><s>ا۟</> أَ<q>بْ</><m>وَٰ</>بَ جَهَ<g>نَّ</>مَ <m>خَٰ</>لِدِينَ فِيهَا ۖ فَلَبِئْسَ مَثْوَى <h>ٱ</>لْمُتَكَبِّ<p>رِي</>نَ"},{"n":30,"w":[["۞ وَقِيلَ","waqīla","And it will be said","এবং বলা হবে"],["لِلَّذِينَ","lilladhīna","to those who","যারা (তাদেরকে)"],["ٱتَّقَوْا۟","ittaqaw","fear Allah","তাকওয়া অবলম্বন করতো"],["مَاذَآ","mādhā","What","\"কি"],["أَنزَلَ","anzala","has your Lord sent down","অবতীর্ণ করেছিলেন\""],["رَبُّكُمْ ۚ","rabbukum","has your Lord sent down","তোমাদের রব\""],["قَالُوا۟","qālū","They will say","তারা বলবে"],["خَيْرًۭا ۗ","khayran","Good","\"মহাকল্যাণ\""],["لِّلَّذِينَ","lilladhīna","For those who","তাদের (জন্যে) যারা"],["أَحْسَنُوا۟","aḥsanū","do good","সৎকাজ করে"],["فِى","fī","in","মধ্যে আছে"],["هَـٰذِهِ","hādhihi","this","এই"],["ٱلدُّنْيَا","l-dun'yā","world","দুনিয়ায়"],["حَسَنَةٌۭ ۚ","ḥasanatun","(is) a good","কল্যাণ"],["وَلَدَارُ","waladāru","and the home","এবং অবশ্যই ঘর"],["ٱلْـَٔاخِرَةِ","l-ākhirati","of the Hereafter","আখেরাতের"],["خَيْرٌۭ ۚ","khayrun","(is) better","উত্তম"],["وَلَنِعْمَ","walani‘'ma","And surely excellent","এবং অবশ্যই চমৎকার"],["دَارُ","dāru","(is) the home","ঘর"],["ٱلْمُتَّقِينَ","l-mutaqīna","(of) the righteous","মুত্তাকীদের"]],"t":"۞ وَقِيلَ لِلَّذِينَ <h>ٱ</>تَّقَوْ<s>ا۟</> مَا<o>ذَآ</> أَ<k>نزَ</>لَ رَبُّكُمْ ۚ قَالُو<s>ا۟</> خَيْ<w>رًۭا ۗ لِّ</>لَّذِينَ أَحْسَنُو<s>ا۟</> فِى <m>هَٰ</>ذِهِ <h>ٱ</><l>ل</>دُّنْيَا حَسَنَ<d>ةٌۭ ۚ وَ</>لَدَارُ <h>ٱ</>لْءَاخِرَةِ خَيْ<d>رٌۭ ۚ وَ</>لَنِعْمَ دَارُ <h>ٱ</>لْمُتَّ<p>قِي</>نَ"},{"n":31,"w":[["جَنَّـٰتُ","jannātu","Gardens","জান্নাত"],["عَدْنٍۢ","‘adnin","(of) Eden ","স্থায়ী"],["يَدْخُلُونَهَا","yadkhulūnahā","which they will enter","তাতে তারা প্রবেশ করবে"],["تَجْرِى","tajrī","flows","প্রবাহিত হয়"],["مِن","min","from","থেকে"],["تَحْتِهَا","taḥtihā","underneath them","তার নিচ"],["ٱلْأَنْهَـٰرُ ۖ","l-anhāru","the rivers","ঝর্ণাধারাসমূহ"],["لَهُمْ","lahum","For them","তাদের জন্যে"],["فِيهَا","fīhā","therein","তার মধ্যে"],["مَا","mā","(will be) whatever","যা"],["يَشَآءُونَ ۚ","yashāūna","they wish","তারা চাইবে"],["كَذَٰلِكَ","kadhālika","Thus","এভাবে"],["يَجْزِى","yajzī","Allah rewards","পুরস্কৃত করেন"],["ٱللَّهُ","l-lahu","Allah rewards","আল্লাহ্‌"],["ٱلْمُتَّقِينَ","l-mutaqīna","the righteous","মুত্তাকীদেরকে"]],"t":"جَ<g>نَّٰ</>تُ عَ<q>دْ</><d>نٍۢ يَ</><q>دْ</>خُلُونَهَا تَ<q>جْ</>رِى مِ<k>ن تَ</>حْتِهَا <h>ٱ</>لْأَنْ<m>هَٰ</>رُ ۖ لَهُمْ فِيهَا مَا يَ<o>شَآ</>ءُونَ ۚ كَ<m>ذَٰ</>لِكَ يَ<q>جْ</>زِى <h>ٱ</>للَّهُ <h>ٱ</>لْمُتَّ<p>قِي</>نَ"},{"n":32,"w":[["ٱلَّذِينَ","alladhīna","Those whom","যাদের"],["تَتَوَفَّىٰهُمُ","tatawaffāhumu","take them in death","তাদের মৃত্যু ঘটায়"],["ٱلْمَلَـٰٓئِكَةُ","l-malāikatu","the Angels","ফেরেশতারা"],["طَيِّبِينَ ۙ","ṭayyibīna","(when they are) pure","পবিত্র থাকা অবস্থায়"],["يَقُولُونَ","yaqūlūna","saying","তারা বলবে"],["سَلَـٰمٌ","salāmun","Peace","\"শান্তি"],["عَلَيْكُمُ","‘alaykumu","(be) upon you","তোমাদের উপর"],["ٱدْخُلُوا۟","ud'khulū","Enter","তোমরা প্রবেশ করো"],["ٱلْجَنَّةَ","l-janata","Paradise","জান্নাতে"],["بِمَا","bimā","for what","বিনিময়ে যা"],["كُنتُمْ","kuntum","you used (to)","তোমরা ছিলে"],["تَعْمَلُونَ","ta‘malūna","do","তোমরা কাজ করতে\""]],"t":"ٱلَّذِينَ تَتَوَفَّ<m>ىٰ</>هُمُ <h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةُ طَيِّبِينَ ۙ يَقُولُونَ سَ<m>لَٰ</>مٌ عَلَيْكُمُ <h>ٱ</><q>دْ</>خُلُو<s>ا۟</> <h>ٱ</>لْجَ<g>نَّ</>ةَ بِمَا كُ<k>نتُ</>مْ تَعْمَ<p>لُو</>نَ"},{"n":33,"w":[["هَلْ","hal","Do","তবে কি"],["يَنظُرُونَ","yanẓurūna","they wait","তারা অপেক্ষা করছে"],["إِلَّآ","illā","except","এ ছাড়া"],["أَن","an","that","যে"],["تَأْتِيَهُمُ","tatiyahumu","(should) come to them","তাদের কাছে আসবে"],["ٱلْمَلَـٰٓئِكَةُ","l-malāikatu","the Angels","ফেরেশতারা"],["أَوْ","aw","or","অথবা"],["يَأْتِىَ","yatiya","(should) come","আসবে"],["أَمْرُ","amru","(the) Command","নির্দেশ"],["رَبِّكَ ۚ","rabbika","(of) your Lord","তোমার রবের"],["كَذَٰلِكَ","kadhālika","Thus","এরূপ"],["فَعَلَ","fa‘ala","did","করেছিলো"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["مِن","min","(were) before them","থেকে"],["قَبْلِهِمْ ۚ","qablihim","(were) before them","তাদের পূর্ব (ছিলো)"],["وَمَا","wamā","And not","এবং না"],["ظَلَمَهُمُ","ẓalamahumu","wronged them","তাদের উপর অত্যাচার করেছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ্‌"],["وَلَـٰكِن","walākin","but","কিন্তু"],["كَانُوٓا۟","kānū","they were","তারা ছিলো"],["أَنفُسَهُمْ","anfusahum","themselves","তাদের নিজেদের উপর"],["يَظْلِمُونَ","yaẓlimūna","wronging","অত্যাচার করতে"]],"t":"هَلْ يَ<k>نظُ</>رُونَ إِ<o>لَّآ</> أَ<k>ن تَ</>أْتِيَهُمُ <h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةُ أَوْ يَأْتِىَ أَمْرُ رَبِّكَ ۚ كَ<m>ذَٰ</>لِكَ فَعَلَ <h>ٱ</>لَّذِينَ مِ<k>ن قَ</><q>بْ</>لِهِمْ ۚ وَمَا ظَلَمَهُمُ <h>ٱ</>للَّهُ وَ<m>لَٰ</>كِ<k>ن كَ</>ا<o>نُوٓ</><s>ا۟</> أَ<k>نفُ</>سَهُمْ يَظْلِ<p>مُو</>نَ"},{"n":34,"w":[["فَأَصَابَهُمْ","fa-aṣābahum","Then struck them","অতঃপর তাদের উপর পড়েছিলো"],["سَيِّـَٔاتُ","sayyiātu","(the) evil (results)","মন্দসমূহ (অর্থাৎ শাস্তি)"],["مَا","mā","(of) what","যা"],["عَمِلُوا۟","‘amilū","they did","তারা কাজ করেছিলো"],["وَحَاقَ","waḥāqa","and surrounded","এবং ঘিরে ফেলেছিলো"],["بِهِم","bihim","them","তাদেরকে"],["مَّا","mā","what","তা-ই"],["كَانُوا۟","kānū","they used (to)","তারা ছিলো"],["بِهِۦ","bihi","[of it]","নিয়ে যা"],["يَسْتَهْزِءُونَ","yastahziūna","mock","তারা ঠাট্টাবিদ্রূপ করতো"]],"t":"فَأَصَابَهُمْ سَيِّـَٔاتُ مَا عَمِلُو<s>ا۟</> وَحَاقَ بِ<y>هِم مَّ</>ا كَانُو<s>ا۟</> بِ<m>هِۦ</> يَسْتَهْزِ<p>ءُو</>نَ"},{"n":35,"w":[["وَقَالَ","waqāla","And said","এবং বলে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["أَشْرَكُوا۟","ashrakū","associate partners (with Allah)","শিরক করেছে"],["لَوْ","law","If","\"যদি"],["شَآءَ","shāa","Allah (had) willed","ইচ্ছে করতেন"],["ٱللَّهُ","l-lahu","Allah (had) willed","আল্লাহ্‌"],["مَا","mā","not","না"],["عَبَدْنَا","‘abadnā","we (would) have worshipped","আমরা ইবাদাত করতাম"],["مِن","min","other than Him","ছাড়া"],["دُونِهِۦ","dūnihi","other than Him","তাঁকে"],["مِن","min","any","(অন্য) কোনো"],["شَىْءٍۢ","shayin","thing","কিছুকে"],["نَّحْنُ","naḥnu","we","আমরা"],["وَلَآ","walā","and not","এবং না"],["ءَابَآؤُنَا","ābāunā","our forefathers","আমাদের বাপ-দাদারা"],["وَلَا","walā","and not","এবং না"],["حَرَّمْنَا","ḥarramnā","we (would) have forbidden","আমরা নিষিদ্ধ করতাম"],["مِن","min","other than Him","ছাড়া"],["دُونِهِۦ","dūnihi","other than Him","তাঁর (হুকুম)"],["مِن","min","anything","কোনো\""],["شَىْءٍۢ ۚ","shayin","anything","কিছু\""],["كَذَٰلِكَ","kadhālika","Thus","এরূপ"],["فَعَلَ","fa‘ala","did","করেছিলো"],["ٱلَّذِينَ","alladhīna","those who","যারা (ছিলো)"],["مِن","min","(were) before them","থেকে"],["قَبْلِهِمْ ۚ","qablihim","(were) before them","তাদের পূর্ব"],["فَهَلْ","fahal","Then is (there)","সুতরাং কি"],["عَلَى","‘alā","on","উপর"],["ٱلرُّسُلِ","l-rusuli","the messengers","(দায়িত্ব আছে) রাসূলদের"],["إِلَّا","illā","except","এ ছাড়া যে"],["ٱلْبَلَـٰغُ","l-balāghu","the conveyance","পৌঁছানো (দীনের দাওয়াত)"],["ٱلْمُبِينُ","l-mubīnu","clear","সুস্পষ্ট ভাবে"]],"t":"وَقَالَ <h>ٱ</>لَّذِينَ أَشْرَكُو<s>ا۟</> لَوْ <o>شَآ</>ءَ <h>ٱ</>للَّهُ مَا عَبَ<q>دْ</>نَا مِ<k>ن دُ</>ونِ<m>هِۦ</> مِ<k>ن شَ</><d>ىْءٍۢ نَّ</>حْنُ وَ<o>لَآ</> ءَا<o>بَآ</>ؤُنَا وَلَا حَرَّمْنَا مِ<k>ن دُ</>ونِ<m>هِۦ</> مِ<k>ن شَىْءٍۢ ۚ كَ</><m>ذَٰ</>لِكَ فَعَلَ <h>ٱ</>لَّذِينَ مِ<k>ن قَ</><q>بْ</>لِهِمْ ۚ فَهَلْ عَلَى <h>ٱ</><l>ل</>رُّسُلِ إِلَّا <h>ٱ</>لْبَ<m>لَٰ</>غُ <h>ٱ</>لْمُ<p>بِي</>نُ"},{"n":36,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["بَعَثْنَا","ba‘athnā","We sent","আমরা পাঠিয়েছি"],["فِى","fī","into","মধ্যে"],["كُلِّ","kulli","every","প্রত্যেক"],["أُمَّةٍۢ","ummatin","nation","জাতির"],["رَّسُولًا","rasūlan","a Messenger","রাসূল"],["أَنِ","ani","that","যে"],["ٱعْبُدُوا۟","u‘'budū","Worship","\"তোমরা ইবাদাত করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহর"],["وَٱجْتَنِبُوا۟","wa-ij'tanibū","and avoid","ও দূরে থাকো"],["ٱلطَّـٰغُوتَ ۖ","l-ṭāghūta","the false deities","তাগুত (হ'তে)\""],["فَمِنْهُم","famin'hum","Then among them","অতঃপর তাদের মধ্য থেকে"],["مَّنْ","man","(were some) whom","কাউকে"],["هَدَى","hadā","Allah guided","সৎপথে পরিচালনা করেন"],["ٱللَّهُ","l-lahu","Allah guided","আল্লাহ্‌"],["وَمِنْهُم","wamin'hum","and among them","আর তাদের মধ্য থেকে"],["مَّنْ","man","(were) some","কারো"],["حَقَّتْ","ḥaqqat","was justified","অবধারিত হয়েছে"],["عَلَيْهِ","‘alayhi","on them","তার উপর"],["ٱلضَّلَـٰلَةُ ۚ","l-ḍalālatu","the straying","পথভ্রষ্টতা"],["فَسِيرُوا۟","fasīrū","So travel","অতঃপর তোমরা ভ্রমন করো"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["فَٱنظُرُوا۟","fa-unẓurū","and see","অতঃপর তোমরা দেখো"],["كَيْفَ","kayfa","how","কেমন"],["كَانَ","kāna","was","হয়েছে"],["عَـٰقِبَةُ","‘āqibatu","the end","পরিণাম"],["ٱلْمُكَذِّبِينَ","l-mukadhibīna","(of) the deniers","মিথ্যাবাদীদের"]],"t":"وَلَقَ<q>دْ</> بَعَثْنَا فِى كُلِّ أُ<g>مَّ</><w>ةٍۢ رَّ</>سُولًا أَنِ <h>ٱ</>عْبُدُو<s>ا۟</> <h>ٱ</>للَّهَ وَ<h>ٱ</><q>جْ</>تَنِبُو<s>ا۟</> <h>ٱ</><l>ل</><m>طَّٰ</>غُوتَ ۖ فَمِنْ<y>هُم مَّ</>نْ هَدَى <h>ٱ</>للَّهُ وَمِنْ<y>هُم مَّ</>نْ حَقَّتْ عَلَيْهِ <h>ٱ</><l>ل</>ضَّ<m>لَٰ</>لَةُ ۚ فَسِيرُو<s>ا۟</> فِى <h>ٱ</>لْأَرْضِ فَ<h>ٱ</><k>نظُ</>رُو<s>ا۟</> كَيْفَ كَانَ <m>عَٰ</>قِبَةُ <h>ٱ</>لْمُكَذِّ<p>بِي</>نَ"},{"n":37,"w":[["إِن","in","If","যদি"],["تَحْرِصْ","taḥriṣ","you desire","আগ্রহী হও"],["عَلَىٰ","‘alā","[for]","ব্যাপারে"],["هُدَىٰهُمْ","hudāhum","their guidance","তাদের পথ প্রদর্শনের তুমি"],["فَإِنَّ","fa-inna","then indeed","তবুও নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["لَا","lā","(will) not","না"],["يَهْدِى","yahdī","guide","সৎপথে পরিচালনা করেন"],["مَن","man","whom","যাকে"],["يُضِلُّ ۖ","yuḍillu","He lets go astray","পথভ্রষ্ট করেন"],["وَمَا","wamā","and not (are)","এবং নেই"],["لَهُم","lahum","for them","তাদের জন্যে"],["مِّن","min","any","কোনো"],["نَّـٰصِرِينَ","nāṣirīna","helpers","সাহায্যকারী"]],"t":"إِ<k>ن تَ</>حْرِصْ عَلَىٰ هُدَ<m>ىٰ</>هُمْ فَإِ<g>نَّ</> <h>ٱ</>للَّهَ لَا يَهْدِى <d>مَن يُ</>ضِلُّ ۖ وَمَا لَ<y>هُم مِّ</><d>ن نَّٰ</>صِ<p>رِي</>نَ"},{"n":38,"w":[["وَأَقْسَمُوا۟","wa-aqsamū","And they swear","এবং তারা শপথ করে"],["بِٱللَّهِ","bil-lahi","by Allah","নামে আল্লাহর"],["جَهْدَ","jahda","strongest","সাধ্য অনুসারে"],["أَيْمَـٰنِهِمْ ۙ","aymānihim","(of) their oaths","তাদের শপথের"],["لَا","lā","Allah will not resurrect","না"],["يَبْعَثُ","yab‘athu","Allah will not resurrect","উঠাবেন"],["ٱللَّهُ","l-lahu","Allah will not resurrect","আল্লাহ্‌"],["مَن","man","(one) who","(তাকে) যে"],["يَمُوتُ ۚ","yamūtu","dies","মারা যায়"],["بَلَىٰ","balā","Nay","হ্যাঁ (নিশ্চয়ই)"],["وَعْدًا","wa‘dan","(it is) a promise","প্রতিশ্রুতি"],["عَلَيْهِ","‘alayhi","upon Him","তার উপর"],["حَقًّۭا","ḥaqqan","(in) truth","অবধারিত"],["وَلَـٰكِنَّ","walākinna","but","কিন্তু"],["أَكْثَرَ","akthara","most","অধিকাংশ"],["ٱلنَّاسِ","l-nāsi","(of) the mankind","মানুষ"],["لَا","lā","(do) not","না"],["يَعْلَمُونَ","ya‘lamūna","know","তারা জানে"]],"t":"وَأَ<q>قْ</>سَمُو<s>ا۟</> بِ<h>ٱ</>للَّهِ جَهْدَ أَيْ<m>مَٰ</>نِهِمْ ۙ لَا يَ<q>بْ</>عَثُ <h>ٱ</>للَّهُ <d>مَن يَ</>مُوتُ ۚ بَلَىٰ وَعْدًا عَلَيْهِ حَ<d>قًّۭا وَ</><m>لَٰ</>كِ<g>نَّ</> أَكْثَرَ <h>ٱ</><l>ل</><g>نَّ</>اسِ لَا يَعْلَ<p>مُو</>نَ"},{"n":39,"w":[["لِيُبَيِّنَ","liyubayyina","That He will make clear","জন্যে প্রকাশ করার"],["لَهُمُ","lahumu","to them","তাদের কাছে"],["ٱلَّذِى","alladhī","that","যে বিষয়ে"],["يَخْتَلِفُونَ","yakhtalifūna","they differ","তারা মতানৈক্য করে"],["فِيهِ","fīhi","wherein","তার মধ্যে"],["وَلِيَعْلَمَ","waliya‘lama","and that may know","এবং জানে যেন"],["ٱلَّذِينَ","alladhīna","those who","(তারা) যারা"],["كَفَرُوٓا۟","kafarū","disbelieved","অস্বীকার করেছে"],["أَنَّهُمْ","annahum","that they","যে তারা"],["كَانُوا۟","kānū","were","(তারা) ছিলো"],["كَـٰذِبِينَ","kādhibīna","liars","মিথ্যাবাদী"]],"t":"لِيُبَيِّنَ لَهُمُ <h>ٱ</>لَّذِى يَخْتَلِفُونَ فِيهِ وَلِيَعْلَمَ <h>ٱ</>لَّذِينَ كَفَ<o>رُوٓ</><s>ا۟</> أَ<g>نَّ</>هُمْ كَانُو<s>ا۟</> <m>كَٰ</>ذِ<p>بِي</>نَ"},{"n":40,"w":[["إِنَّمَا","innamā","Only","শুধু এতটুকুই"],["قَوْلُنَا","qawlunā","Our Word","আমাদের কথা"],["لِشَىْءٍ","lishayin","to a thing","জন্যে কোন কিছুর"],["إِذَآ","idhā","when","যখন"],["أَرَدْنَـٰهُ","aradnāhu","We intend it","আমরা তা করতে চাই"],["أَن","an","(is) that","যে"],["نَّقُولَ","naqūla","We say","আমরা বলি"],["لَهُۥ","lahu","to it","তাকে"],["كُن","kun","Be","\"হও\""],["فَيَكُونُ","fayakūnu","and it is","ফলে তা হয়ে যায়"]],"t":"إِ<g>نَّ</>مَا قَوْلُنَا لِشَىْءٍ إِ<o>ذَآ</> أَرَ<q>دْ</><m>نَٰ</>هُ <d>أَن نَّ</>قُولَ لَهُ<m>ۥ</> كُ<k>ن فَ</>يَ<p>كُو</>نُ"},{"n":41,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["هَاجَرُوا۟","hājarū","emigrated","হিজরত করেছে"],["فِى","fī","in (the way)","জন্যে"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["مِنۢ","min","after","থেকে"],["بَعْدِ","ba‘di","after","পর"],["مَا","mā","[what]","যা"],["ظُلِمُوا۟","ẓulimū","they were wronged","তারা নির্যাতিত হয়েছে"],["لَنُبَوِّئَنَّهُمْ","lanubawwi-annahum","surely We will give them position","অবশ্যই আমরা আবাস দিবো তাদের"],["فِى","fī","in","মধ্যে"],["ٱلدُّنْيَا","l-dun'yā","the world","দুনিয়ার"],["حَسَنَةًۭ ۖ","ḥasanatan","good","উত্তম"],["وَلَأَجْرُ","wala-ajru","but surely the reward","এবং অবশ্যই পুরস্কার"],["ٱلْـَٔاخِرَةِ","l-ākhirati","(of) the Hereafter","আখেরাতের"],["أَكْبَرُ ۚ","akbaru","(is) greater","সর্বাধিক"],["لَوْ","law","if","যদি"],["كَانُوا۟","kānū","they","তারা ছিলো"],["يَعْلَمُونَ","ya‘lamūna","know","তারা জানতো"]],"t":"وَ<h>ٱ</>لَّذِينَ هَاجَرُو<s>ا۟</> فِى <h>ٱ</>للَّهِ <i>مِنۢ بَ</>عْدِ مَا ظُلِمُو<s>ا۟</> لَنُبَوِّئَ<g>نَّ</>هُمْ فِى <h>ٱ</><l>ل</>دُّنْيَا حَسَنَ<d>ةًۭ ۖ وَ</>لَأَ<q>جْ</>رُ <h>ٱ</>لْءَاخِرَةِ أَكْبَرُ ۚ لَوْ كَانُو<s>ا۟</> يَعْلَ<p>مُو</>نَ"},{"n":42,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["صَبَرُوا۟","ṣabarū","(are) patient","ধৈর্য ধরেছে"],["وَعَلَىٰ","wa‘alā","and on","ও উপর"],["رَبِّهِمْ","rabbihim","their Lord","তাদের রবের"],["يَتَوَكَّلُونَ","yatawakkalūna","they put their trust","তারা নির্ভর করে"]],"t":"ٱلَّذِينَ صَبَرُو<s>ا۟</> وَعَلَىٰ رَبِّهِمْ يَتَوَكَّ<p>لُو</>نَ"},{"n":43,"w":[["وَمَآ","wamā","And not","এবং না"],["أَرْسَلْنَا","arsalnā","We sent","আমরা পাঠিয়েছি"],["مِن","min","before you","থেকে"],["قَبْلِكَ","qablika","before you","তোমার পূর্ব"],["إِلَّا","illā","except","এ ছাড়া"],["رِجَالًۭا","rijālan","men","মানুষদেরকে"],["نُّوحِىٓ","nūḥī","We revealed","আমরা ওহী করি"],["إِلَيْهِمْ ۚ","ilayhim","to them","প্রতি তাদের"],["فَسْـَٔلُوٓا۟","fasalū","so ask","অতএব তোমরা জিজ্ঞেস করো"],["أَهْلَ","ahla","(the) people","সম্পন্নদের"],["ٱلذِّكْرِ","l-dhik'ri","(of) the Reminder","(ঐশী)জ্ঞান"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you","তোমরা ছিলে"],["لَا","lā","(do) not","না"],["تَعْلَمُونَ","ta‘lamūna","know","তোমরা জানো"]],"t":"وَ<o>مَآ</> أَرْسَلْنَا مِ<k>ن قَ</><q>بْ</>لِكَ إِلَّا رِجَالًۭ<d>ا نُّ</>و<o>حِىٓ</> إِلَيْهِمْ ۚ فَسْـَٔ<o>لُوٓ</><s>ا۟</> أَهْلَ <h>ٱ</><l>ل</>ذِّكْرِ إِ<k>ن كُنتُ</>مْ لَا تَعْلَ<p>مُو</>نَ"},{"n":44,"w":[["بِٱلْبَيِّنَـٰتِ","bil-bayināti","With the clear proofs","সহ উজ্জ্বল নিদর্শনাবলী"],["وَٱلزُّبُرِ ۗ","wal-zuburi","and the Books","ও কিতাবসমূহ"],["وَأَنزَلْنَآ","wa-anzalnā","And We sent down","ও আমরা অবতীর্ণ করেছি"],["إِلَيْكَ","ilayka","to you","তোমার প্রতি"],["ٱلذِّكْرَ","l-dhik'ra","the Remembrance","উপদেশবাণী (কুরআন)"],["لِتُبَيِّنَ","litubayyina","that you may make clear","যেন সুস্পস্টভাবে বর্ণনা করো তুমি"],["لِلنَّاسِ","lilnnāsi","to the mankind","জন্যে মানুষের"],["مَا","mā","what","যা"],["نُزِّلَ","nuzzila","has been sent down","অবতীর্ণ করা হয়েছে"],["إِلَيْهِمْ","ilayhim","to them","তাদের প্রতি"],["وَلَعَلَّهُمْ","wala‘allahum","and that they may","এবং সম্ভবত তারা"],["يَتَفَكَّرُونَ","yatafakkarūna","reflect","চিন্তা-ভাবনা করে"]],"t":"بِ<h>ٱ</>لْبَيِّ<m>نَٰ</>تِ وَ<h>ٱ</><l>ل</>زُّبُرِ ۗ وَأَ<k>نزَ</>لْ<o>نَآ</> إِلَيْكَ <h>ٱ</><l>ل</>ذِّكْرَ لِتُبَيِّنَ لِل<g>نَّ</>اسِ مَا نُزِّلَ إِلَيْهِمْ وَلَعَلَّهُمْ يَتَفَكَّ<p>رُو</>نَ"},{"n":45,"w":[["أَفَأَمِنَ","afa-amina","Do then feel secure","তবে কি নির্ভয় হয়েছে"],["ٱلَّذِينَ","alladhīna","those who","(তারা) যারা"],["مَكَرُوا۟","makarū","plotted","চক্রান্ত করে"],["ٱلسَّيِّـَٔاتِ","l-sayiāti","the evil deeds","কুকর্মের"],["أَن","an","that","যে"],["يَخْسِفَ","yakhsifa","Allah will cave","ধসিয়ে দিবেন"],["ٱللَّهُ","l-lahu","Allah will cave","আল্লাহ্‌"],["بِهِمُ","bihimu","with them","সহ তাদের"],["ٱلْأَرْضَ","l-arḍa","the earth","মাটিকে"],["أَوْ","aw","or","বা"],["يَأْتِيَهُمُ","yatiyahumu","will come to them","তাদের উপর আসবে"],["ٱلْعَذَابُ","l-‘adhābu","the punishment","আযাব"],["مِنْ","min","from","থেকে"],["حَيْثُ","ḥaythu","where","যেখান"],["لَا","lā","not","না"],["يَشْعُرُونَ","yash‘urūna","they perceive","তারা ধারণাও করে"]],"t":"أَفَأَمِنَ <h>ٱ</>لَّذِينَ مَكَرُو<s>ا۟</> <h>ٱ</><l>ل</>سَّيِّـَٔاتِ <d>أَن يَ</>خْسِفَ <h>ٱ</>للَّهُ بِهِمُ <h>ٱ</>لْأَرْضَ أَوْ يَأْتِيَهُمُ <h>ٱ</>لْعَذَابُ مِنْ حَيْثُ لَا يَشْعُ<p>رُو</>نَ"},{"n":46,"w":[["أَوْ","aw","Or","অথবা"],["يَأْخُذَهُمْ","yakhudhahum","that He may seize them","তাদের ধরবেন"],["فِى","fī","in","মধ্যে"],["تَقَلُّبِهِمْ","taqallubihim","their going to and fro","তাদের চলাফেরার"],["فَمَا","famā","then not","অতঃপর না"],["هُم","hum","they","তারা (হ'তে পারবে)"],["بِمُعْجِزِينَ","bimu‘'jizīna","will be able to escape","(তাঁকে) অক্ষমকারী"]],"t":"أَوْ يَأْخُذَهُمْ فِى تَقَلُّبِهِمْ فَمَا <f>هُم بِ</>مُعْجِ<p>زِي</>نَ"},{"n":47,"w":[["أَوْ","aw","Or","অথবা"],["يَأْخُذَهُمْ","yakhudhahum","that He may seize them","তাদের ধরবেন"],["عَلَىٰ","‘alā","with","অবস্হায়"],["تَخَوُّفٍۢ","takhawwufin","a gradual wasting","ভীত সন্ত্রস্ত"],["فَإِنَّ","fa-inna","But indeed","তবে নিশ্চয়ই"],["رَبَّكُمْ","rabbakum","your Lord","তোমাদের রব"],["لَرَءُوفٌۭ","laraūfun","(is) surely Full of Kindness","অবশ্যই দয়াপরবশ"],["رَّحِيمٌ","raḥīmun","Most Merciful","পরম দয়ালু"]],"t":"أَوْ يَأْخُذَهُمْ عَلَىٰ تَخَوُّ<k>فٍۢ فَ</>إِ<g>نَّ</> رَبَّكُمْ لَرَءُو<w>فٌۭ رَّ</><p>حِي</>مٌ"},{"n":48,"w":[["أَوَلَمْ","awalam","Have not","কি নি"],["يَرَوْا۟","yaraw","they seen","তারা দেখে"],["إِلَىٰ","ilā","[towards]","প্রতি"],["مَا","mā","what","যা"],["خَلَقَ","khalaqa","Allah has created","সৃষ্টি করেছেন"],["ٱللَّهُ","l-lahu","Allah has created","আল্লাহ্‌"],["مِن","min","from","কিছু"],["شَىْءٍۢ","shayin","a thing","বস্তুর"],["يَتَفَيَّؤُا۟","yatafayya-u","Incline","ঝুঁকে পড়ে"],["ظِلَـٰلُهُۥ","ẓilāluhu","their shadows","তার ছায়াগুলো"],["عَنِ","‘ani","to","থেকে"],["ٱلْيَمِينِ","l-yamīni","the right","ডান"],["وَٱلشَّمَآئِلِ","wal-shamāili","and to the left","ও বাম (থেকে)"],["سُجَّدًۭا","sujjadan","prostrating","সিজদাবনত হয়ে"],["لِّلَّهِ","lillahi","to Allah","আল্লাহর জন্যে"],["وَهُمْ","wahum","while they","এমতাবস্হায় যে তারা"],["دَٰخِرُونَ","dākhirūna","(are) humble","বিনয়ী"]],"t":"أَوَلَمْ يَرَوْ<s>ا۟</> إِلَىٰ مَا خَلَقَ <h>ٱ</>للَّهُ مِ<k>ن شَ</><d>ىْءٍۢ يَ</>تَفَيَّؤُ<s>ا۟</> ظِ<m>لَٰ</>لُهُ<m>ۥ</> عَنِ <h>ٱ</>لْيَمِينِ وَ<h>ٱ</><l>ل</>شَّ<o>مَآ</>ئِلِ سُجَّ<w>دًۭا لِّ</>لَّهِ وَهُمْ <m>دَٰ</>خِ<p>رُو</>نَ"},{"n":49,"w":[["وَلِلَّهِ","walillahi","And to Allah","এবং আল্লাহর জন্যে"],["يَسْجُدُ","yasjudu","prostrate","সিজদা করে"],["مَا","mā","whatever","যা কিছু"],["فِى","fī","(is) in","মধ্যে আছে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশসমূহের"],["وَمَا","wamā","and whatever","এবং যা"],["فِى","fī","(is) in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["مِن","min","of","মধ্য থেকে"],["دَآبَّةٍۢ","dābbatin","moving creatures","জীবজন্তু"],["وَٱلْمَلَـٰٓئِكَةُ","wal-malāikatu","and the Angels","এবং ফেরেশতারা"],["وَهُمْ","wahum","and they","এবং তারা"],["لَا","lā","(are) not","না"],["يَسْتَكْبِرُونَ","yastakbirūna","arrogant","অহংকার করে"]],"t":"وَلِلَّهِ يَسْجُدُ مَا فِى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَمَا فِى <h>ٱ</>لْأَرْضِ مِ<k>ن دَ</><n>آ</>بَّ<d>ةٍۢ وَ</><h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةُ وَهُمْ لَا يَسْتَكْبِ<p>رُو</>نَ"},{"n":50,"w":[["يَخَافُونَ","yakhāfūna","They fear","তারা ভয় করে"],["رَبَّهُم","rabbahum","their Lord","তাদের রবকে"],["مِّن","min","above them","অবস্থানরত"],["فَوْقِهِمْ","fawqihim","above them","উপরে তাদের"],["وَيَفْعَلُونَ","wayaf‘alūna","and they do","এবং তারা করে"],["مَا","mā","what","যা"],["يُؤْمَرُونَ ۩","yu'marūna","they are commanded","তাদের নির্দেশ দেয়া হয়"]],"t":"يَخَافُونَ رَبَّ<y>هُم مِّ</><k>ن فَ</>وْقِهِمْ وَيَفْعَلُونَ مَا يُؤْمَرُ<p>و</>نَ ۩"},{"n":51,"w":[["۞ وَقَالَ","waqāla","And Allah has said","এবং বলেন"],["ٱللَّهُ","l-lahu","And Allah has said","আল্লাহ্‌"],["لَا","lā","(Do) not","\"না"],["تَتَّخِذُوٓا۟","tattakhidhū","take","তোমরা গ্রহণ করো"],["إِلَـٰهَيْنِ","ilāhayni","[two] gods","ইলাহ"],["ٱثْنَيْنِ ۖ","ith'nayni","two","দুই"],["إِنَّمَا","innamā","only","প্রকৃতপক্ষে"],["هُوَ","huwa","He","তিনি"],["إِلَـٰهٌۭ","ilāhun","(is) God","ইলাহ"],["وَٰحِدٌۭ ۖ","wāḥidun","One","এক"],["فَإِيَّـٰىَ","fa-iyyāya","so Me Alone","সুতরাং শুধু আমাকেই"],["فَٱرْهَبُونِ","fa-ir'habūni","you fear [Me]","তাই আমাকেই তোমরা ভয় করো\""]],"t":"۞ وَقَالَ <h>ٱ</>للَّهُ لَا تَتَّخِ<o>ذُوٓ</><s>ا۟</> إِ<m>لَٰ</>هَيْنِ <h>ٱ</>ثْنَيْنِ ۖ إِ<g>نَّ</>مَا هُوَ إِ<m>لَٰ</><d>هٌۭ وَٰ</>حِ<k>دٌۭ ۖ فَ</>إِ<m>يَّٰ</>ىَ فَ<h>ٱ</>رْهَ<p>بُو</>نِ"},{"n":52,"w":[["وَلَهُۥ","walahu","And to Him (belongs)","এবং তাঁরই জন্যে"],["مَا","mā","whatever","যা কিছু"],["فِى","fī","(is) in","মধ্যে আছে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশসমূহের"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীর"],["وَلَهُ","walahu","and to Him","এবং তাঁরই জন্যে"],["ٱلدِّينُ","l-dīnu","(is due) the worship","অানুগত্য"],["وَاصِبًا ۚ","wāṣiban","constantly","সার্বক্ষণিক"],["أَفَغَيْرَ","afaghayra","Then is it other (than)","তবে কি ছাড়া"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌"],["تَتَّقُونَ","tattaqūna","you fear","(অপরকে) তোমরা ভয় করবে"]],"t":"وَلَهُ<m>ۥ</> مَا فِى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ وَلَهُ <h>ٱ</><l>ل</>دِّينُ وَاصِبًا ۚ أَفَغَيْرَ <h>ٱ</>للَّهِ تَتَّ<p>قُو</>نَ"},{"n":53,"w":[["وَمَا","wamā","And whatever","অথচ যা কিছু"],["بِكُم","bikum","you have","সাথে তোমাদের"],["مِّن","min","of","মধ্য থেকে"],["نِّعْمَةٍۢ","ni‘'matin","favor","অনুগ্রহ (আছে)"],["فَمِنَ","famina","(is) from","তা (এসেছে) হ'তে"],["ٱللَّهِ ۖ","l-lahi","Allah","আল্লাহ্‌"],["ثُمَّ","thumma","Then","এরপর"],["إِذَا","idhā","when","যখন"],["مَسَّكُمُ","massakumu","touches you","তোমাদের স্পর্শ করে"],["ٱلضُّرُّ","l-ḍuru","the adversity","দুঃখ-দৈন্য"],["فَإِلَيْهِ","fa-ilayhi","then to Him","তখন তার কাছে"],["تَجْـَٔرُونَ","tajarūna","you cry for help","তোমরা নম্র হয়ে ডাকো"]],"t":"وَمَا بِ<y>كُم مِّ</><d>ن نِّ</>عْمَ<k>ةٍۢ فَ</>مِنَ <h>ٱ</>للَّهِ ۖ ثُ<g>مَّ</> إِذَا مَسَّكُمُ <h>ٱ</><l>ل</>ضُّرُّ فَإِلَيْهِ تَ<q>جْـَٔ</><p>رُو</>نَ"},{"n":54,"w":[["ثُمَّ","thumma","Then","এরপর"],["إِذَا","idhā","when","যখন"],["كَشَفَ","kashafa","He removes","দূর করে দেন"],["ٱلضُّرَّ","l-ḍura","the adversity","দুঃখ-দৈন্য"],["عَنكُمْ","‘ankum","from you","থেকে তোমাদের"],["إِذَا","idhā","behold","তখন"],["فَرِيقٌۭ","farīqun","A group","একদল"],["مِّنكُم","minkum","of you","তোমাদের মধ্য হ'তে"],["بِرَبِّهِمْ","birabbihim","with their Lord","সাথে তাদের রবের"],["يُشْرِكُونَ","yush'rikūna","associate others","(অন্যদেরকে) শরীক করে"]],"t":"ثُ<g>مَّ</> إِذَا كَشَفَ <h>ٱ</><l>ل</>ضُّرَّ عَ<k>نكُ</>مْ إِذَا فَرِي<d>قٌۭ مِّ</><k>نكُ</><f>م بِ</>رَبِّهِمْ يُشْرِ<p>كُو</>نَ"},{"n":55,"w":[["لِيَكْفُرُوا۟","liyakfurū","So as to deny","জন্যে অস্বীকার করার"],["بِمَآ","bimā","that which","ঐ বিষয়ে যা"],["ءَاتَيْنَـٰهُمْ ۚ","ātaynāhum","We have given them","আমরা তাদের দিয়েছি"],["فَتَمَتَّعُوا۟ ۖ","fatamatta‘ū","Then enjoy yourselves","তাই তোমরা ভোগ করো"],["فَسَوْفَ","fasawfa","soon","অতঃপর শীঘ্রই"],["تَعْلَمُونَ","ta‘lamūna","you will know","তোমরা জানবে"]],"t":"لِيَكْفُرُو<s>ا۟</> بِ<o>مَآ</> ءَاتَيْ<m>نَٰ</>هُمْ ۚ فَتَمَتَّعُو<s>ا۟ ۖ</> فَسَوْفَ تَعْلَ<p>مُو</>نَ"},{"n":56,"w":[["وَيَجْعَلُونَ","wayaj‘alūna","And they assign","এবং তারা নির্ধারণ করে"],["لِمَا","limā","to what","সে বিষয়ে যা"],["لَا","lā","not","না"],["يَعْلَمُونَ","ya‘lamūna","they know ","তারা জানে"],["نَصِيبًۭا","naṣīban","a portion","এক অংশ"],["مِّمَّا","mimmā","of what","তা হ'তে যা"],["رَزَقْنَـٰهُمْ ۗ","razaqnāhum","We have provided them","আমরা জীবিকা দিয়েছি তাদের"],["تَٱللَّهِ","tal-lahi","By Allah","শপথ আল্লাহর"],["لَتُسْـَٔلُنَّ","latus'alunna","surely you will be asked","অবশ্যই তোমাদের জিজ্ঞেস করা হবে"],["عَمَّا","‘ammā","about what","ঐ বিষয়ে যা"],["كُنتُمْ","kuntum","you used (to)","তোমরা ছিলে"],["تَفْتَرُونَ","taftarūna","invent","তোমরা রচনা করতে"]],"t":"وَيَ<q>جْ</>عَلُونَ لِمَا لَا يَعْلَمُونَ نَصِي<d>بًۭا مِّ</><g>مَّ</>ا رَزَ<q>قْ</><m>نَٰ</>هُمْ ۗ تَ<h>ٱ</>للَّهِ لَتُسْـَٔلُ<g>نَّ</> عَ<g>مَّ</>ا كُ<k>نتُ</>مْ تَفْتَ<p>رُو</>نَ"},{"n":57,"w":[["وَيَجْعَلُونَ","wayaj‘alūna","And they assign","এবং তারা নির্ধারণ করে"],["لِلَّهِ","lillahi","to Allah","জন্যে আল্লাহর"],["ٱلْبَنَـٰتِ","l-banāti","daughters","কন্যা-সন্তানসমূহ"],["سُبْحَـٰنَهُۥ ۙ","sub'ḥānahu","Glory be to Him","তিনি পবিত্র ও মহান"],["وَلَهُم","walahum","And for them","এবং জন্যে তাদের"],["مَّا","mā","(is) what","(তাই) যা"],["يَشْتَهُونَ","yashtahūna","they desire","তারা কামনা করে"]],"t":"وَيَ<q>جْ</>عَلُونَ لِلَّهِ <h>ٱ</>لْبَ<m>نَٰ</>تِ سُ<q>بْ</><m>حَٰ</>نَهُ<m>ۥ</> ۙ وَلَ<y>هُم مَّ</>ا يَشْتَ<p>هُو</>نَ"},{"n":58,"w":[["وَإِذَا","wa-idhā","And when","অথচ যখন"],["بُشِّرَ","bushira","is given good news","সুখবর দেয়া হয়"],["أَحَدُهُم","aḥaduhum","(to) one of them","তাদের কাউকে"],["بِٱلْأُنثَىٰ","bil-unthā","of a female","ব্যাপারে কন্যা-সন্তানের"],["ظَلَّ","ẓalla","turns","হয়ে যায়"],["وَجْهُهُۥ","wajhuhu","his face","তার মুখ"],["مُسْوَدًّۭا","mus'waddan","dark","কালো"],["وَهُوَ","wahuwa","and he","এবং সে (হয়)"],["كَظِيمٌۭ","kaẓīmun","suppresses grief","উত্তেজনা প্রশমনকারী"]],"t":"وَإِذَا بُشِّرَ أَحَدُ<f>هُم بِ</><h>ٱ</>لْأُ<k>نثَ</>ىٰ ظَلَّ وَ<q>جْ</>هُهُ<m>ۥ</> مُسْوَ<d>دًّۭا وَ</>هُوَ كَ<p>ظِي</>مٌۭ"},{"n":59,"w":[["يَتَوَٰرَىٰ","yatawārā","He hides himself","আত্ন গোপন করে"],["مِنَ","mina","from","থেকে"],["ٱلْقَوْمِ","l-qawmi","the people","লোকদের"],["مِن","min","(because) of","কারণে"],["سُوٓءِ","sūi","the evil","লজ্জার"],["مَا","mā","of what","যা"],["بُشِّرَ","bushira","he has been given good news","সুসংবাদ দেয়া হয়"],["بِهِۦٓ ۚ","bihi","about","সম্পর্কে সে"],["أَيُمْسِكُهُۥ","ayum'sikuhu","Should he keep it","কি তাকে রেখে দিবে"],["عَلَىٰ","‘alā","in","সত্ত্বেও উপর"],["هُونٍ","hūnin","humiliation","হীনতা (লাঞ্ছনা সহ্য করে)"],["أَمْ","am","or","না"],["يَدُسُّهُۥ","yadussuhu","bury it","তাকে পুঁতে ফেলবে"],["فِى","fī","in","মধ্যে"],["ٱلتُّرَابِ ۗ","l-turābi","the dust","মাটির"],["أَلَا","alā","Unquestionably","সাবধান (লক্ষ্য করো)"],["سَآءَ","sāa","evil","কত নিকৃষ্ট"],["مَا","mā","(is) what","যা"],["يَحْكُمُونَ","yaḥkumūna","they decide","তারা সিদ্ধান্ত নেয়"]],"t":"يَتَ<m>وَٰ</>رَىٰ مِنَ <h>ٱ</>لْقَوْمِ مِ<k>ن سُ</><o>وٓ</>ءِ مَا بُشِّرَ بِ<o>هِۦٓ ۚ</> أَيُمْسِكُهُ<m>ۥ</> عَلَىٰ هُونٍ أَمْ يَدُسُّهُ<m>ۥ</> فِى <h>ٱ</><l>ل</>تُّرَابِ ۗ أَلَا <o>سَآ</>ءَ مَا يَحْكُ<p>مُو</>نَ"},{"n":60,"w":[["لِلَّذِينَ","lilladhīna","For those who","জন্যে যারা তাদের"],["لَا","lā","(do) not","না"],["يُؤْمِنُونَ","yu'minūna","believe","বিশ্বাস করে"],["بِٱلْـَٔاخِرَةِ","bil-ākhirati","in the Hereafter","আখেরাতের উপর"],["مَثَلُ","mathalu","(is) a similitude","দৃষ্টান্ত"],["ٱلسَّوْءِ ۖ","l-sawi","(of) the evil","বড় নিকৃষ্ট"],["وَلِلَّهِ","walillahi","and for Allah","এবং আল্লাহর জন্যে"],["ٱلْمَثَلُ","l-mathalu","(is) the similitude","দৃষ্টান্ত (গুণাবলী)"],["ٱلْأَعْلَىٰ ۚ","l-a‘lā","the Highest","সর্বোচ্চ"],["وَهُوَ","wahuwa","And He","এবং তিনিই"],["ٱلْعَزِيزُ","l-‘azīzu","(is) the All-Mighty","পরাক্রমশালী"],["ٱلْحَكِيمُ","l-ḥakīmu","All-Wise","প্রজ্ঞাময়"]],"t":"لِلَّذِينَ لَا يُؤْمِنُونَ بِ<h>ٱ</>لْءَاخِرَةِ مَثَلُ <h>ٱ</><l>ل</>سَّوْءِ ۖ وَلِلَّهِ <h>ٱ</>لْمَثَلُ <h>ٱ</>لْأَعْلَىٰ ۚ وَهُوَ <h>ٱ</>لْعَزِيزُ <h>ٱ</>لْحَ<p>كِي</>مُ"},{"n":61,"w":[["وَلَوْ","walaw","And if","এবং যদি"],["يُؤَاخِذُ","yuākhidhu","Allah were to seize","ধরতেন"],["ٱللَّهُ","l-lahu","Allah were to seize","আল্লাহ্‌"],["ٱلنَّاسَ","l-nāsa","the mankind","মানুষদেরকে"],["بِظُلْمِهِم","biẓul'mihim","for their wrongdoing","জন্যে তাদের বাড়াবাড়ির"],["مَّا","mā","not","না"],["تَرَكَ","taraka","He (would) have left","ছাড়তেন"],["عَلَيْهَا","‘alayhā","upon it","তার উপর"],["مِن","min","any","কোনো"],["دَآبَّةٍۢ","dābbatin","moving creature","প্রানীকেও"],["وَلَـٰكِن","walākin","but","কিন্তু"],["يُؤَخِّرُهُمْ","yu-akhiruhum","He defers them","তাদের অবকাশ দেন"],["إِلَىٰٓ","ilā","for","পর্যন্ত"],["أَجَلٍۢ","ajalin","a term","কাল"],["مُّسَمًّۭى ۖ","musamman","appointed","নির্দিষ্ট"],["فَإِذَا","fa-idhā","Then when","অতঃপর যখন"],["جَآءَ","jāa","comes","আসবে"],["أَجَلُهُمْ","ajaluhum","their terms","তাদের সময়"],["لَا","lā","not","না"],["يَسْتَـْٔخِرُونَ","yastakhirūna","they (will) remain behind","তারা দেরি করতে পারবে"],["سَاعَةًۭ ۖ","sā‘atan","an hour","এক মুহূর্ত"],["وَلَا","walā","and not","আর না"],["يَسْتَقْدِمُونَ","yastaqdimūna","they can advance (it)","তারা তাড়াহুড়ো করতে পারবে"]],"t":"وَلَوْ يُؤَاخِذُ <h>ٱ</>للَّهُ <h>ٱ</><l>ل</><g>نَّ</>اسَ بِظُلْمِ<y>هِم مَّ</>ا تَرَكَ عَلَيْهَا مِ<k>ن دَ</><n>آ</>بَّ<d>ةٍۢ وَ</><m>لَٰ</><d>كِن يُ</>ؤَخِّرُهُمْ إِلَ<o>ىٰٓ</> أَجَ<d>لٍۢ مُّ</>سَ<k>مًّۭى ۖ فَ</>إِذَا <o>جَآ</>ءَ أَجَلُهُمْ لَا يَسْتَـْٔخِرُونَ سَاعَ<d>ةًۭ ۖ وَ</>لَا يَسْتَ<q>قْ</>دِ<p>مُو</>نَ"},{"n":62,"w":[["وَيَجْعَلُونَ","wayaj‘alūna","And they assign","এবং তারা সাব্যস্ত করে"],["لِلَّهِ","lillahi","to Allah","জন্যে আল্লাহর"],["مَا","mā","what","যা"],["يَكْرَهُونَ","yakrahūna","they dislike","তারা অপছন্দ করে"],["وَتَصِفُ","wataṣifu","and assert","এবং বর্ণনা করে"],["أَلْسِنَتُهُمُ","alsinatuhumu","their tongues","তাদের জিহবাগুলো"],["ٱلْكَذِبَ","l-kadhiba","the lie","মিথ্যা"],["أَنَّ","anna","that","যে"],["لَهُمُ","lahumu","for them","জন্যে তাদেরই"],["ٱلْحُسْنَىٰ ۖ","l-ḥus'nā","(is) the best","কল্যাণ"],["لَا","lā","No","নেই"],["جَرَمَ","jarama","doubt","সন্দেহ"],["أَنَّ","anna","that","যে"],["لَهُمُ","lahumu","for them","জন্যে তাদের (রয়েছে)"],["ٱلنَّارَ","l-nāra","(is) the Fire","আগুন"],["وَأَنَّهُم","wa-annahum","and that they","এবং (এও) যে তাদের"],["مُّفْرَطُونَ","muf'raṭūna","(will) be abandoned","সবার আগে তারা নিক্ষিপ্ত হবে"]],"t":"وَيَ<q>جْ</>عَلُونَ لِلَّهِ مَا يَكْرَهُونَ وَتَصِفُ أَلْسِنَتُهُمُ <h>ٱ</>لْكَذِبَ أَ<g>نَّ</> لَهُمُ <h>ٱ</>لْحُسْنَىٰ ۖ لَا جَرَمَ أَ<g>نَّ</> لَهُمُ <h>ٱ</><l>ل</><g>نَّ</>ارَ وَأَ<g>نَّ</><y>هُم مُّ</>فْرَ<p>طُو</>نَ"},{"n":63,"w":[["تَٱللَّهِ","tal-lahi","By Allah","শপথ আল্লাহর"],["لَقَدْ","laqad","certainly","নিশ্চয়ই"],["أَرْسَلْنَآ","arsalnā","We have sent","আমরা পাঠিয়েছি"],["إِلَىٰٓ","ilā","to","প্রতি"],["أُمَمٍۢ","umamin","nations","জাতিসমূহের"],["مِّن","min","before you","থেকে"],["قَبْلِكَ","qablika","before you","তোমার পূর্ব"],["فَزَيَّنَ","fazayyana","but made fair-seeming","অতঃপর শোভন করেছিলো"],["لَهُمُ","lahumu","to them","জন্যে তাদের"],["ٱلشَّيْطَـٰنُ","l-shayṭānu","the Shaitaan","শয়তান"],["أَعْمَـٰلَهُمْ","a‘mālahum","their deeds","তাদের কাজগুলোকে"],["فَهُوَ","fahuwa","So he","অতঃপর সেই"],["وَلِيُّهُمُ","waliyyuhumu","(is) their ally","তাদের অভিভাবক"],["ٱلْيَوْمَ","l-yawma","today","আজ"],["وَلَهُمْ","walahum","and for them","এবং জন্যে তাদের (রয়েছে)"],["عَذَابٌ","‘adhābun","(is) a punishment","শাস্তি"],["أَلِيمٌۭ","alīmun","painful","নিদারুণ"]],"t":"تَ<h>ٱ</>للَّهِ لَقَ<q>دْ</> أَرْسَلْ<o>نَآ</> إِلَ<o>ىٰٓ</> أُمَ<d>مٍۢ مِّ</><k>ن قَ</><q>بْ</>لِكَ فَزَيَّنَ لَهُمُ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نُ أَعْ<m>مَٰ</>لَهُمْ فَهُوَ وَلِيُّهُمُ <h>ٱ</>لْيَوْمَ وَلَهُمْ عَذَابٌ أَ<p>لِي</>مٌۭ"},{"n":64,"w":[["وَمَآ","wamā","And not","এবং না"],["أَنزَلْنَا","anzalnā","We revealed","আমরা অবতীর্ণ করেছি"],["عَلَيْكَ","‘alayka","to you","তোমার উপর"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","কিতাব"],["إِلَّا","illā","except","ছাড়া"],["لِتُبَيِّنَ","litubayyina","that you make clear","যেন তুমি প্রকাশ করো"],["لَهُمُ","lahumu","to them","তাদের কাছে"],["ٱلَّذِى","alladhī","that which","সে বিষয়ে"],["ٱخْتَلَفُوا۟","ikh'talafū","they differed","তারা মত-বিরোধ করেছে"],["فِيهِ ۙ","fīhi","in it","মধ্যে যার"],["وَهُدًۭى","wahudan","and (as) a guidance","এবং পথনির্দেশ"],["وَرَحْمَةًۭ","waraḥmatan","and mercy","ও দয়াস্বরূপ"],["لِّقَوْمٍۢ","liqawmin","for a people","জন্যে লোকদের"],["يُؤْمِنُونَ","yu'minūna","who believe","(যারা) বিশ্বাস করে"]],"t":"وَ<o>مَآ</> أَ<k>نزَ</>لْنَا عَلَيْكَ <h>ٱ</>لْكِ<m>تَٰ</>بَ إِلَّا لِتُبَيِّنَ لَهُمُ <h>ٱ</>لَّذِى <h>ٱ</>خْتَلَفُو<s>ا۟</> فِيهِ ۙ وَهُ<d>دًۭى وَ</>رَحْمَ<w>ةًۭ لِّ</>قَوْ<d>مٍۢ يُ</>ؤْمِ<p>نُو</>نَ"},{"n":65,"w":[["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ্‌"],["أَنزَلَ","anzala","has sent down","বর্ষণ করেন"],["مِنَ","mina","from","থেকে"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশ"],["مَآءًۭ","māan","water","পানি"],["فَأَحْيَا","fa-aḥyā","then gives life","অতঃপর প্রাণ দেন"],["بِهِ","bihi","by it","দিয়ে তা"],["ٱلْأَرْضَ","l-arḍa","(to) the earth","জমিকে"],["بَعْدَ","ba‘da","after","পর"],["مَوْتِهَآ ۚ","mawtihā","its death","তার মৃত্যুর"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَةًۭ","laāyatan","(is) surely a Sign","অবশ্যই নিদর্শন"],["لِّقَوْمٍۢ","liqawmin","for a people","জন্যে লোকদের"],["يَسْمَعُونَ","yasma‘ūna","who listen","(যারা) শুনে"]],"t":"وَ<h>ٱ</>للَّهُ أَ<k>نزَ</>لَ مِنَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ <o>مَآ</><k>ءًۭ فَ</>أَحْيَا بِهِ <h>ٱ</>لْأَرْضَ بَعْدَ مَوْتِ<o>هَآ ۚ</> إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَايَ<w>ةًۭ لِّ</>قَوْ<d>مٍۢ يَ</>سْمَ<p>عُو</>نَ"},{"n":66,"w":[["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["لَكُمْ","lakum","for you","জন্যে তোমাদের"],["فِى","fī","in","মধ্যে রয়েছে"],["ٱلْأَنْعَـٰمِ","l-an‘āmi","the cattle","গবাদিপশুর"],["لَعِبْرَةًۭ ۖ","la‘ib'ratan","(is) a lesson","অবশ্যই শিক্ষা"],["نُّسْقِيكُم","nus'qīkum","We give you to drink","আমরা পান করাই তোমাদের"],["مِّمَّا","mimmā","from what","তা হ'তে যা"],["فِى","fī","(is) in","মধ্যে আছে"],["بُطُونِهِۦ","buṭūnihi","their bellies","তার পেটগুলোর"],["مِنۢ","min","from","থেকে"],["بَيْنِ","bayni","between","মধ্য"],["فَرْثٍۢ","farthin","bowels","গোবর"],["وَدَمٍۢ","wadamin","and blood","ও রক্তের"],["لَّبَنًا","labanan","milk","(তা হলো) দুধ"],["خَالِصًۭا","khāliṣan","pure","বিশুদ্ধ"],["سَآئِغًۭا","sāighan","palatable","উপাদেয়"],["لِّلشَّـٰرِبِينَ","lilshāribīna","to the drinkers","জন্যে পানকারীদের"]],"t":"وَإِ<g>نَّ</> لَكُمْ فِى <h>ٱ</>لْأَنْ<m>عَٰ</>مِ لَعِ<q>بْ</>رَ<d>ةًۭ ۖ نُّ</>سْقِي<y>كُم مِّ</><g>مَّ</>ا فِى بُطُونِ<m>هِۦ</> <i>مِنۢ بَ</>يْنِ فَرْ<d>ثٍۢ وَ</>دَ<w>مٍۢ لَّ</>بَنًا خَالِ<k>صًۭا سَ</><o>آ</>ئِ<w>غًۭا لِّ</>ل<m>شَّٰ</>رِ<p>بِي</>نَ"},{"n":67,"w":[["وَمِن","wamin","And from","এবং থেকে"],["ثَمَرَٰتِ","thamarāti","fruits","ফলগুলো"],["ٱلنَّخِيلِ","l-nakhīli","the date-palm","খেজুর গাছের"],["وَٱلْأَعْنَـٰبِ","wal-a‘nābi","and the grapes","ও আঙ্গুরগুলো"],["تَتَّخِذُونَ","tattakhidhūna","you take","তোমরা গ্রহণ করো"],["مِنْهُ","min'hu","from it","তা থেকে"],["سَكَرًۭا","sakaran","intoxicant","মাদকদ্রব্য"],["وَرِزْقًا","wariz'qan","and a provision","ও জীবিকা"],["حَسَنًا ۗ","ḥasanan","good","উত্তম"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে আছে"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَةًۭ","laāyatan","(is) surely a Sign","অবশ্যই নিদর্শন"],["لِّقَوْمٍۢ","liqawmin","for a people","জন্যে লোকদের"],["يَعْقِلُونَ","ya‘qilūna","who use reason","(যারা) জ্ঞান রাখে"]],"t":"وَمِ<k>ن ثَ</>مَ<m>رَٰ</>تِ <h>ٱ</><l>ل</><g>نَّ</>خِيلِ وَ<h>ٱ</>لْأَعْ<m>نَٰ</>بِ تَتَّخِذُونَ مِنْهُ سَكَ<d>رًۭا وَ</>رِزْقًا حَسَنًا ۗ إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَايَ<w>ةًۭ لِّ</>قَوْ<d>مٍۢ يَ</>عْقِ<p>لُو</>نَ"},{"n":68,"w":[["وَأَوْحَىٰ","wa-awḥā","And inspired","এবং ওহী করেন"],["رَبُّكَ","rabbuka","your Lord","তার রব"],["إِلَى","ilā","to","প্রতি"],["ٱلنَّحْلِ","l-naḥli","the bee","মৌমাছির"],["أَنِ","ani","[that]","যে"],["ٱتَّخِذِى","ittakhidhī","Take","\"গ্রহণ করো (বানাও)"],["مِنَ","mina","among","মধ্যে"],["ٱلْجِبَالِ","l-jibāli","the mountains","পাহাড়গুলোর"],["بُيُوتًۭا","buyūtan","houses","ঘরসমূহ (অর্থাৎ চাক)"],["وَمِنَ","wamina","and among","ও মধ্যে"],["ٱلشَّجَرِ","l-shajari","the trees","গাছের"],["وَمِمَّا","wamimmā","and in what","এবং ঐ বস্তুর মধ্যে যা"],["يَعْرِشُونَ","ya‘rishūna","they construct","তারা উঁচু করে (দালান বা মাচা)"]],"t":"وَأَوْحَىٰ رَبُّكَ إِلَى <h>ٱ</><l>ل</><g>نَّ</>حْلِ أَنِ <h>ٱ</>تَّخِذِى مِنَ <h>ٱ</>لْجِبَالِ بُيُو<d>تًۭا وَ</>مِنَ <h>ٱ</><l>ل</>شَّجَرِ وَمِ<g>مَّ</>ا يَعْرِ<p>شُو</>نَ"},{"n":69,"w":[["ثُمَّ","thumma","Then","এরপর"],["كُلِى","kulī","eat","খাও"],["مِن","min","from","থেকে"],["كُلِّ","kulli","all","প্রত্যেক"],["ٱلثَّمَرَٰتِ","l-thamarāti","the fruits","ফলসমূহ"],["فَٱسْلُكِى","fa-us'lukī","and follow","অতঃপর চলো"],["سُبُلَ","subula","(the) ways","পথসমূহে"],["رَبِّكِ","rabbiki","(of) your Lord","তোমার রবের"],["ذُلُلًۭا ۚ","dhululan","made smooth","সহজ\""],["يَخْرُجُ","yakhruju","Comes forth","বের হয়"],["مِنۢ","min","from","থেকে"],["بُطُونِهَا","buṭūnihā","their bellies","তাদের পেটসমূহ"],["شَرَابٌۭ","sharābun","a drink","পানীয়"],["مُّخْتَلِفٌ","mukh'talifun","(of) varying","নানা রকম"],["أَلْوَٰنُهُۥ","alwānuhu","colors","তার রংসমূহ"],["فِيهِ","fīhi","in it","মধ্যে তার"],["شِفَآءٌۭ","shifāon","(is) a healing","আরোগ্য (আছে)"],["لِّلنَّاسِ ۗ","lilnnāsi","for the mankind","মানুষের জন্যে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে"],["ذَٰلِكَ","dhālika","that","এর (রয়েছে)"],["لَـَٔايَةًۭ","laāyatan","(is) surely a Sign","অবশ্যই নিদর্শন"],["لِّقَوْمٍۢ","liqawmin","for a people","জন্যে লোকদের"],["يَتَفَكَّرُونَ","yatafakkarūna","who reflect","(যারা) চিন্তা ভাবনা করে"]],"t":"ثُ<g>مَّ</> كُلِى مِ<k>ن كُ</>لِّ <h>ٱ</><l>ل</>ثَّمَ<m>رَٰ</>تِ فَ<h>ٱ</>سْلُكِى سُبُلَ رَبِّكِ ذُلُلًۭ<d>ا ۚ يَ</>خْرُجُ <i>مِنۢ بُ</>طُونِهَا شَرَا<d>بٌۭ مُّ</>خْتَلِفٌ أَلْ<m>وَٰ</>نُهُ<m>ۥ</> فِيهِ شِ<o>فَآ</><w>ءٌۭ لِّ</>ل<g>نَّ</>اسِ ۗ إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَايَ<w>ةًۭ لِّ</>قَوْ<d>مٍۢ يَ</>تَفَكَّ<p>رُو</>نَ"},{"n":70,"w":[["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ্‌"],["خَلَقَكُمْ","khalaqakum","created you","সৃষ্টি করেছেন তোমাদের"],["ثُمَّ","thumma","then","এরপর"],["يَتَوَفَّىٰكُمْ ۚ","yatawaffākum","will cause you to die","তোমাদেরকে মৃত্যু দিবেন"],["وَمِنكُم","waminkum","And among you","এবং তোমাদের মধ্যে থেকে"],["مَّن","man","(is one) who","কাউকে"],["يُرَدُّ","yuraddu","is sent back","ফিরিয়ে নেয়া হয়"],["إِلَىٰٓ","ilā","to","দিকে"],["أَرْذَلِ","ardhali","the worst","নিকৃষ্টতার"],["ٱلْعُمُرِ","l-‘umuri","(of) the age","বয়সের"],["لِكَىْ","likay","so that","যেন"],["لَا","lā","not","না"],["يَعْلَمَ","ya‘lama","he will know","জানে"],["بَعْدَ","ba‘da","after","পরেও"],["عِلْمٍۢ","‘il'min","knowledge","সবকিছু জানার"],["شَيْـًٔا ۚ","shayan","a thing","কিছুই"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["عَلِيمٌۭ","‘alīmun","(is) All-Knowing","মহাজ্ঞানী"],["قَدِيرٌۭ","qadīrun","All-Powerful","সর্বশক্তিমান"]],"t":"وَ<h>ٱ</>للَّهُ خَلَقَكُمْ ثُ<g>مَّ</> يَتَوَفَّ<m>ىٰ</>كُمْ ۚ وَمِ<k>نكُ</><y>م مَّ</><d>ن يُ</>رَدُّ إِلَ<o>ىٰٓ</> أَرْذَلِ <h>ٱ</>لْعُمُرِ لِكَىْ لَا يَعْلَمَ بَعْدَ عِلْ<k>مٍۢ شَ</>يْـًٔا ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ عَلِي<k>مٌۭ قَ</><p>دِي</>رٌۭ"},{"n":71,"w":[["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ্‌"],["فَضَّلَ","faḍḍala","has favored","শ্রেষ্ঠত্ব দিয়েছেন"],["بَعْضَكُمْ","ba‘ḍakum","some of you","তোমাদের কাউকে"],["عَلَىٰ","‘alā","over","উপরে"],["بَعْضٍۢ","ba‘ḍin","others","কারও"],["فِى","fī","in","বেলায়"],["ٱلرِّزْقِ ۚ","l-riz'qi","[the] provision","জীবনের উপকরণের"],["فَمَا","famā","But not","অতঃপর না"],["ٱلَّذِينَ","alladhīna","those who","যাদেরকে"],["فُضِّلُوا۟","fuḍḍilū","were favored","শ্রেষ্ঠত্ব দেয়া হয়েছে"],["بِرَآدِّى","birāddī","would hand over","প্রত্যাবর্তনকারী"],["رِزْقِهِمْ","riz'qihim","their provision","জীবিকা তাদের"],["عَلَىٰ","‘alā","to","কাছে"],["مَا","mā","whom","(গোলামদের) যা"],["مَلَكَتْ","malakat","possess","মালিক (হয়েছে)"],["أَيْمَـٰنُهُمْ","aymānuhum","their right hands","তাদের ডানহাতসমূহ"],["فَهُمْ","fahum","so (that) they","যেন তারা"],["فِيهِ","fīhi","(are) in it","সে বিষয়ে"],["سَوَآءٌ ۚ","sawāon","equal","(হ'তে পারে) সমান"],["أَفَبِنِعْمَةِ","afabini‘'mati","Then is it the Favor","তবে কি অনুগ্রহকে"],["ٱللَّهِ","l-lahi","of Allah","আল্লাহর"],["يَجْحَدُونَ","yajḥadūna","they reject","তারা অস্বীকার করে"]],"t":"وَ<h>ٱ</>للَّهُ فَضَّلَ بَعْضَكُمْ عَلَىٰ بَعْ<k>ضٍۢ فِ</>ى <h>ٱ</><l>ل</>رِّزْقِ ۚ فَمَا <h>ٱ</>لَّذِينَ فُضِّلُو<s>ا۟</> بِ<n>رَآ</>دِّى رِزْقِهِمْ عَلَىٰ مَا مَلَكَتْ أَيْ<m>مَٰ</>نُهُمْ فَهُمْ فِيهِ سَ<o>وَآ</>ءٌ ۚ أَفَبِنِعْمَةِ <h>ٱ</>للَّهِ يَ<q>جْ</>حَ<p>دُو</>نَ"},{"n":72,"w":[["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ্‌"],["جَعَلَ","ja‘ala","(has) made","সৃষ্টি করেছেন"],["لَكُم","lakum","for you","জন্যে তোমাদের"],["مِّنْ","min","from","মধ্য হ'তে"],["أَنفُسِكُمْ","anfusikum","yourselves","তোমাদের স্বজাতীয়দের"],["أَزْوَٰجًۭا","azwājan","spouses","জোড়াসমূহ"],["وَجَعَلَ","waja‘ala","and has made","এবং সৃষ্টি করেছেন"],["لَكُم","lakum","for you","জন্যে তোমাদের"],["مِّنْ","min","from","থেকে"],["أَزْوَٰجِكُم","azwājikum","your spouses","তোমাদের যুগলগুলো"],["بَنِينَ","banīna","sons","পুত্রসমূহ"],["وَحَفَدَةًۭ","waḥafadatan","and grandsons","ও পৌত্রসমূহ"],["وَرَزَقَكُم","warazaqakum","and has provided for you","এবং তোমাদের জীবিকা দিয়েছেন"],["مِّنَ","mina","from","থেকে"],["ٱلطَّيِّبَـٰتِ ۚ","l-ṭayibāti","the good things","উত্তম বস্তু"],["أَفَبِٱلْبَـٰطِلِ","afabil-bāṭili","Then in falsehood do","কি তবে উপর বাতিলের"],["يُؤْمِنُونَ","yu'minūna","they believe","তারা ঈমান আনবে"],["وَبِنِعْمَتِ","wabini‘'mati","and the Favor","এবং অনুগ্রহসমূহকে"],["ٱللَّهِ","l-lahi","of Allah","আল্লাহর"],["هُمْ","hum","they","তারা"],["يَكْفُرُونَ","yakfurūna","disbelieve","অস্বীকার করবে"]],"t":"وَ<h>ٱ</>للَّهُ جَعَلَ لَ<y>كُم مِّ</>نْ أَ<k>نفُ</>سِكُمْ أَزْ<m>وَٰ</><d>جًۭا وَ</>جَعَلَ لَ<y>كُم مِّ</>نْ أَزْ<m>وَٰ</>جِ<f>كُم بَ</>نِينَ وَحَفَدَ<d>ةًۭ وَ</>رَزَقَ<y>كُم مِّ</>نَ <h>ٱ</><l>ل</>طَّيِّ<m>بَٰ</>تِ ۚ أَفَبِ<h>ٱ</>لْ<m>بَٰ</>طِلِ يُؤْمِنُونَ وَبِنِعْمَتِ <h>ٱ</>للَّهِ هُمْ يَكْفُ<p>رُو</>نَ"},{"n":73,"w":[["وَيَعْبُدُونَ","waya‘budūna","And they worship","এবং তারা উপাসনা করবে (কি)"],["مِن","min","other than","থেকে"],["دُونِ","dūni","other than","ছাড়া"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর (অন্য কিছুকে)"],["مَا","mā","which","যা"],["لَا","lā","not","না"],["يَمْلِكُ","yamliku","possesses","ক্ষমতা রাখে"],["لَهُمْ","lahum","for them","জন্যে তাদেন"],["رِزْقًۭا","riz'qan","any provision","জীবিকার"],["مِّنَ","mina","from","থেকে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশমন্ডলী"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","অথবা পৃথিবী (থেকে)"],["شَيْـًۭٔا","shayan","[anything]","কিছুমাত্র"],["وَلَا","walā","and not","এবং না"],["يَسْتَطِيعُونَ","yastaṭī‘ūna","they are able","তারা (কিছুই) করতে সক্ষম"]],"t":"وَيَعْبُدُونَ مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ مَا لَا يَمْلِكُ لَهُمْ رِزْ<d>قًۭا مِّ</>نَ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ شَ<d>يْـًۭٔا وَ</>لَا يَسْتَطِي<p>عُو</>نَ"},{"n":74,"w":[["فَلَا","falā","So (do) not","সুতরাং না"],["تَضْرِبُوا۟","taḍribū","put forth","তোমরা বর্ণনা করো"],["لِلَّهِ","lillahi","for Allah","জন্যে আল্লাহর"],["ٱلْأَمْثَالَ ۚ","l-amthāla","the similitude","(কাউকে) সদৃশ"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["يَعْلَمُ","ya‘lamu","knows","জানেন"],["وَأَنتُمْ","wa-antum","and you","এবং তোমরা"],["لَا","lā","(do) not","না"],["تَعْلَمُونَ","ta‘lamūna","know","জানো"]],"t":"فَلَا تَضْرِبُو<s>ا۟</> لِلَّهِ <h>ٱ</>لْأَمْثَالَ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ يَعْلَمُ وَأَ<k>نتُ</>مْ لَا تَعْلَ<p>مُو</>نَ"},{"n":75,"w":[["۞ ضَرَبَ","ḍaraba","Allah sets forth","বর্ণনা করছেন"],["ٱللَّهُ","l-lahu","Allah sets forth","আল্লাহ্‌"],["مَثَلًا","mathalan","the example","উপমা"],["عَبْدًۭا","‘abdan","(of) a slave","একজন দাসের"],["مَّمْلُوكًۭا","mamlūkan","(who is) owned","অপরের অধিকারভুক্ত"],["لَّا","lā","not","না"],["يَقْدِرُ","yaqdiru","he has power","সে ক্ষমতা রাখে"],["عَلَىٰ","‘alā","on","উপর"],["شَىْءٍۢ","shayin","anything","কোনো কিছু (খরচ করতে)"],["وَمَن","waman","and (one) whom","এবং (এমন এক ব্যক্তির) যাকে"],["رَّزَقْنَـٰهُ","razaqnāhu","We provided him","তাকে আমরা জীবিকা দিয়েছি"],["مِنَّا","minnā","from Us","আমাদের থেকে"],["رِزْقًا","riz'qan","a provision","জীবিকা"],["حَسَنًۭا","ḥasanan","good","উত্তম"],["فَهُوَ","fahuwa","so he","অতঃপর সে"],["يُنفِقُ","yunfiqu","spends","ব্যয় করে"],["مِنْهُ","min'hu","from it","থেকে তা"],["سِرًّۭا","sirran","secretly","গোপনে"],["وَجَهْرًا ۖ","wajahran","and publicly","ও প্রকাশ্যে"],["هَلْ","hal","Can","কি"],["يَسْتَوُۥنَ ۚ","yastawūna","they be equal","তারা সমান হয়"],["ٱلْحَمْدُ","l-ḥamdu","All praise","প্রশংসা মাত্রই"],["لِلَّهِ ۚ","lillahi","(is) for Allah","জন্যে আল্লাহর"],["بَلْ","bal","Nay","বরং"],["أَكْثَرُهُمْ","aktharuhum","but most of them","তাদের অধিকাংশই"],["لَا","lā","(do) not","না"],["يَعْلَمُونَ","ya‘lamūna","know","জানে"]],"t":"۞ ضَرَبَ <h>ٱ</>للَّهُ مَثَلًا عَ<q>بْ</><d>دًۭا مَّ</>مْلُو<w>كًۭا لَّ</>ا يَ<q>قْ</>دِرُ عَلَىٰ <d>شَىْءٍۢ وَ</><w>مَن رَّ</>زَ<q>قْ</><m>نَٰ</>هُ مِ<g>نَّ</>ا رِزْقًا حَسَ<k>نًۭا فَ</>هُوَ يُ<k>نفِ</>قُ مِنْهُ سِ<d>رًّۭا وَ</>جَهْرًا ۖ هَلْ يَسْتَوُ<m>ۥ</>نَ ۚ <h>ٱ</>لْحَمْدُ لِلَّهِ ۚ بَلْ أَكْثَرُهُمْ لَا يَعْلَ<p>مُو</>نَ"},{"n":76,"w":[["وَضَرَبَ","waḍaraba","And Allah sets forth","এবং বর্ণনা করেন"],["ٱللَّهُ","l-lahu","And Allah sets forth","আল্লাহ্‌"],["مَثَلًۭا","mathalan","an example","উপমা"],["رَّجُلَيْنِ","rajulayni","(of) two men","দু'ব্যক্তির"],["أَحَدُهُمَآ","aḥaduhumā","one of them","তাদের দু'জনের একজন"],["أَبْكَمُ","abkamu","(is) dumb","বোবা"],["لَا","lā","not","না"],["يَقْدِرُ","yaqdiru","he has power","ক্ষমতা রাখে"],["عَلَىٰ","‘alā","on","উপর"],["شَىْءٍۢ","shayin","anything","কোনো কিছুর"],["وَهُوَ","wahuwa","while he","এবং সে"],["كَلٌّ","kallun","(is) a burden","বোঝা"],["عَلَىٰ","‘alā","on","উপর"],["مَوْلَىٰهُ","mawlāhu","his master","তার প্রভুর"],["أَيْنَمَا","aynamā","Wherever","যেদিকেই"],["يُوَجِّههُّ","yuwajjihhu","he directs him","তাকে পাঠায়"],["لَا","lā","not","না"],["يَأْتِ","yati","he comes","আসে"],["بِخَيْرٍ ۖ","bikhayrin","with any good","নিয়ে ভালো (কিছুই)"],["هَلْ","hal","Is","কি"],["يَسْتَوِى","yastawī","equal","সমান হয়"],["هُوَ","huwa","he","সে"],["وَمَن","waman","and (the one) who","ও যে"],["يَأْمُرُ","yamuru","commands","নির্দেশ দেয়"],["بِٱلْعَدْلِ ۙ","bil-‘adli","[of] justice","ন্যায়ের"],["وَهُوَ","wahuwa","and he","এবং সে (আছে)"],["عَلَىٰ","‘alā","(is) on","উপর"],["صِرَٰطٍۢ","ṣirāṭin","a path","পথের"],["مُّسْتَقِيمٍۢ","mus'taqīmin","straight","সরল-সঠিক"]],"t":"وَضَرَبَ <h>ٱ</>للَّهُ مَثَلًۭ<w>ا رَّ</>جُلَيْنِ أَحَدُهُ<o>مَآ</> أَ<q>بْ</>كَمُ لَا يَ<q>قْ</>دِرُ عَلَىٰ <d>شَىْءٍۢ وَ</>هُوَ كَلٌّ عَلَىٰ مَوْلَ<m>ىٰ</>هُ أَيْنَمَا يُوَجِّههُّ لَا يَأْتِ بِخَيْرٍ ۖ هَلْ يَسْتَوِى هُوَ وَ<d>مَن يَ</>أْمُرُ بِ<h>ٱ</>لْعَ<q>دْ</>لِ ۙ وَهُوَ عَلَىٰ صِ<m>رَٰ</><d>طٍۢ مُّ</>سْتَ<p>قِي</>مٍۢ"},{"n":77,"w":[["وَلِلَّهِ","walillahi","And to Allah (belongs)","এবং আল্লাহরই আছে"],["غَيْبُ","ghaybu","(the) unseen","অদৃশ্যের (জ্ঞান)"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশমন্ডলীর"],["وَٱلْأَرْضِ ۚ","wal-arḍi","and the earth","ও পৃথিবীর"],["وَمَآ","wamā","And not","এবং নয়"],["أَمْرُ","amru","(is the) matter","ব্যাপার"],["ٱلسَّاعَةِ","l-sā‘ati","(of) the Hour","ক্বিয়ামাতের"],["إِلَّا","illā","but","এ ছাড়া (যে)"],["كَلَمْحِ","kalamḥi","as a twinkling","মতো পলকের"],["ٱلْبَصَرِ","l-baṣari","(of) the eye","চোখের"],["أَوْ","aw","or","বরং"],["هُوَ","huwa","it","তা"],["أَقْرَبُ ۚ","aqrabu","(is) nearer","তারও চেয়ে নিকটতর"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["عَلَىٰ","‘alā","on","উপর"],["كُلِّ","kulli","every","সব"],["شَىْءٍۢ","shayin","thing","কিছুর"],["قَدِيرٌۭ","qadīrun","(is) All-Powerful","সর্বশক্তিমান"]],"t":"وَلِلَّهِ غَيْبُ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ ۚ وَ<o>مَآ</> أَمْرُ <h>ٱ</><l>ل</>سَّاعَةِ إِلَّا كَلَمْحِ <h>ٱ</>لْبَصَرِ أَوْ هُوَ أَ<q>قْ</>رَبُ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ عَلَىٰ كُلِّ <k>شَىْءٍۢ قَ</><p>دِي</>رٌۭ"},{"n":78,"w":[["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ্‌"],["أَخْرَجَكُم","akhrajakum","brought you forth","বের করেন তোমাদের"],["مِّنۢ","min","from","থেকে"],["بُطُونِ","buṭūni","the wombs","পেটসমূহ"],["أُمَّهَـٰتِكُمْ","ummahātikum","(of) your mothers","তোমাদের মায়ের (এ অবস্থায় যে)"],["لَا","lā","not","না"],["تَعْلَمُونَ","ta‘lamūna","knowing","তোমরা জানো"],["شَيْـًۭٔا","shayan","anything","কিছুই"],["وَجَعَلَ","waja‘ala","and made","এবং দিয়েছেন"],["لَكُمُ","lakumu","for you","জন্যে তোমাদের"],["ٱلسَّمْعَ","l-sam‘a","the hearing","শ্রবণশক্তিসমূহ"],["وَٱلْأَبْصَـٰرَ","wal-abṣāra","and the sight","এবং দৃষ্টিশক্তিসমূহ"],["وَٱلْأَفْـِٔدَةَ ۙ","wal-afidata","and the hearts","এবং হৃদয়সমূহ"],["لَعَلَّكُمْ","la‘allakum","so that you may","সম্ভবত তোমরা"],["تَشْكُرُونَ","tashkurūna","give thanks","তোমরা কৃতজ্ঞতা প্রকাশ করো"]],"t":"وَ<h>ٱ</>للَّهُ أَخْرَجَ<y>كُم مِّ</><i>نۢ بُ</>طُونِ أُ<g>مَّ</><m>هَٰ</>تِكُمْ لَا تَعْلَمُونَ شَ<d>يْـًۭٔا وَ</>جَعَلَ لَكُمُ <h>ٱ</><l>ل</>سَّمْعَ وَ<h>ٱ</>لْأَ<q>بْ</><m>صَٰ</>رَ وَ<h>ٱ</>لْأَفْـِٔدَةَ ۙ لَعَلَّكُمْ تَشْكُ<p>رُو</>نَ"},{"n":79,"w":[["أَلَمْ","alam","Do not","নি কি"],["يَرَوْا۟","yaraw","they see","তারা লক্ষ্য করে"],["إِلَى","ilā","towards","প্রতি"],["ٱلطَّيْرِ","l-ṭayri","the birds","(উড়ন্ত) পাখীগুলোর"],["مُسَخَّرَٰتٍۢ","musakharātin","controlled","নিয়মের অধীন"],["فِى","fī","in","মধ্যে"],["جَوِّ","jawwi","the midst","শূণ্যের"],["ٱلسَّمَآءِ","l-samāi","(of) the sky","আকাশের"],["مَا","mā","None","না"],["يُمْسِكُهُنَّ","yum'sikuhunna","holds them up","তাদের কেউ ধরে রাখে"],["إِلَّا","illā","except","ছাড়া"],["ٱللَّهُ ۗ","l-lahu","Allah","আল্লাহ্‌"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে রয়েছে"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَـٰتٍۢ","laāyātin","(are) Signs","অবশ্যই নিদর্শনসমূহ"],["لِّقَوْمٍۢ","liqawmin","for a people","জন্যে লোকদের"],["يُؤْمِنُونَ","yu'minūna","who believe","(যারা) ঈমান আনে"]],"t":"أَلَمْ يَرَوْ<s>ا۟</> إِلَى <h>ٱ</><l>ل</>طَّيْرِ مُسَخَّ<m>رَٰ</><k>تٍۢ فِ</>ى جَوِّ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ مَا يُمْسِكُهُ<g>نَّ</> إِلَّا <h>ٱ</>للَّهُ ۗ إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَا<m>يَٰ</><w>تٍۢ لِّ</>قَوْ<d>مٍۢ يُ</>ؤْمِ<p>نُو</>نَ"},{"n":80,"w":[["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ্‌"],["جَعَلَ","ja‘ala","(has) made","বানিয়েছেন"],["لَكُم","lakum","for you","জন্যে তোমাদের"],["مِّنۢ","min","[from]","থেকে"],["بُيُوتِكُمْ","buyūtikum","your homes","তোমাদের ঘরগুলো"],["سَكَنًۭا","sakanan","a resting place","আবাসস্থল"],["وَجَعَلَ","waja‘ala","and made","ও বানিয়েছেন"],["لَكُم","lakum","for you","জন্যে তোমাদের"],["مِّن","min","from","দিয়ে"],["جُلُودِ","julūdi","the hides","চামড়াগুলোকে"],["ٱلْأَنْعَـٰمِ","l-an‘āmi","(of) the cattle","গবাদিপশুর"],["بُيُوتًۭا","buyūtan","tents","এমন ঘর"],["تَسْتَخِفُّونَهَا","tastakhiffūnahā","which you find light","তা তোমরা হালকা মনে করো"],["يَوْمَ","yawma","(on) the day","দিনে"],["ظَعْنِكُمْ","ẓa‘nikum","(of) your travel","তোমাদের ভ্রমনের"],["وَيَوْمَ","wayawma","and the day","ও দিনে"],["إِقَامَتِكُمْ ۙ","iqāmatikum","(of) your encampment","তোমাদের অবস্থানের"],["وَمِنْ","wamin","and from","এবং থেকে"],["أَصْوَافِهَا","aṣwāfihā","their wool","তার পশমগুলো"],["وَأَوْبَارِهَا","wa-awbārihā","and their fur","ও তার লোমগুলো"],["وَأَشْعَارِهَآ","wa-ash‘ārihā","and their hair","ও তার চুলগুলো"],["أَثَـٰثًۭا","athāthan","(is) furnishing","গৃহসামগ্রী"],["وَمَتَـٰعًا","wamatā‘an","and a provision","ও ব্যবহার উপকরণ"],["إِلَىٰ","ilā","for","পর্যন্ত"],["حِينٍۢ","ḥīnin","a time","নির্দিষ্ট সময়"]],"t":"وَ<h>ٱ</>للَّهُ جَعَلَ لَ<y>كُم مِّ</><i>نۢ بُ</>يُوتِكُمْ سَكَ<d>نًۭا وَ</>جَعَلَ لَ<y>كُم مِّ</><k>ن جُ</>لُودِ <h>ٱ</>لْأَنْ<m>عَٰ</>مِ بُيُو<k>تًۭا تَ</>سْتَخِفُّونَهَا يَوْمَ ظَعْنِكُمْ وَيَوْمَ إِقَامَتِكُمْ ۙ وَمِنْ أَصْوَافِهَا وَأَوْبَارِهَا وَأَشْعَارِ<o>هَآ</> أَ<m>ثَٰ</><d>ثًۭا وَ</>مَ<m>تَٰ</>عًا إِلَىٰ <p>حِي</>نٍۢ"},{"n":81,"w":[["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ্‌"],["جَعَلَ","ja‘ala","(has) made","ব্যবস্থা করেছেন"],["لَكُم","lakum","for you","জন্যে তোমাদের"],["مِّمَّا","mimmā","from what","তা হ'তে যা"],["خَلَقَ","khalaqa","He created","তিনি সৃষ্টি করেছেন"],["ظِلَـٰلًۭا","ẓilālan","shades","ছায়াসমূহের"],["وَجَعَلَ","waja‘ala","and (has) made","এবং বানিয়েছেন"],["لَكُم","lakum","for you","জন্যে তোমাদের"],["مِّنَ","mina","from","মধ্যে"],["ٱلْجِبَالِ","l-jibāli","the mountains","পাহাড়সমূহের"],["أَكْنَـٰنًۭا","aknānan","shelters","আশ্রয়স্থলসমূহ"],["وَجَعَلَ","waja‘ala","and (has) made","এবং ব্যবস্থা করেছেন"],["لَكُمْ","lakum","for you","জন্যে তোমাদের"],["سَرَٰبِيلَ","sarābīla","garments","পোশাকসমূহের"],["تَقِيكُمُ","taqīkumu","to protect you","রক্ষা করে তোমাদের"],["ٱلْحَرَّ","l-ḥara","(from) the heat","গরমে"],["وَسَرَٰبِيلَ","wasarābīla","and garments","ও পোশাকসমূহ (বর্ম)"],["تَقِيكُم","taqīkum","to protect you","রক্ষা করে তোমাদের"],["بَأْسَكُمْ ۚ","basakum","from your (mutual) violence","তোমাদের যুদ্ধে"],["كَذَٰلِكَ","kadhālika","Thus","এভাবে"],["يُتِمُّ","yutimmu","He completes","তিনি পূর্ণ করেন"],["نِعْمَتَهُۥ","ni‘'matahu","His Favor","অনুগ্রহ তাঁর"],["عَلَيْكُمْ","‘alaykum","upon you","ওপর তোমাদের"],["لَعَلَّكُمْ","la‘allakum","so that you may","সম্ভবত তোমরা"],["تُسْلِمُونَ","tus'limūna","submit","আত্নসমর্পণ করবে"]],"t":"وَ<h>ٱ</>للَّهُ جَعَلَ لَ<y>كُم مِّ</><g>مَّ</>ا خَلَقَ ظِ<m>لَٰ</>لًۭ<d>ا وَ</>جَعَلَ لَ<y>كُم مِّ</>نَ <h>ٱ</>لْجِبَالِ أَكْ<m>نَٰ</><d>نًۭا وَ</>جَعَلَ لَكُمْ سَ<m>رَٰ</>بِيلَ تَقِيكُمُ <h>ٱ</>لْحَرَّ وَسَ<m>رَٰ</>بِيلَ تَقِي<f>كُم بَ</>أْسَكُمْ ۚ كَ<m>ذَٰ</>لِكَ يُتِ<g>مُّ</> نِعْمَتَهُ<m>ۥ</> عَلَيْكُمْ لَعَلَّكُمْ تُسْلِ<p>مُو</>نَ"},{"n":82,"w":[["فَإِن","fa-in","Then, if","অতঃপর যদি"],["تَوَلَّوْا۟","tawallaw","they turn away","তারা মুখ ফিরায়"],["فَإِنَّمَا","fa-innamā","then only","তবে কেবল"],["عَلَيْكَ","‘alayka","upon you","তোমার উপর দায়িত্ব"],["ٱلْبَلَـٰغُ","l-balāghu","(is) the conveyance","(দীনের দাওয়াত) পৌঁছানো"],["ٱلْمُبِينُ","l-mubīnu","the clear","সুস্পষ্টভাবে"]],"t":"فَإِ<k>ن تَ</>وَلَّوْ<s>ا۟</> فَإِ<g>نَّ</>مَا عَلَيْكَ <h>ٱ</>لْبَ<m>لَٰ</>غُ <h>ٱ</>لْمُ<p>بِي</>نُ"},{"n":83,"w":[["يَعْرِفُونَ","ya‘rifūna","They recognize","তারা জানে"],["نِعْمَتَ","ni‘'mata","(the) Favor","অনুগ্রহসমূহকে"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["ثُمَّ","thumma","then","এরপর"],["يُنكِرُونَهَا","yunkirūnahā","they deny it","তা তারা অস্বীকার করে"],["وَأَكْثَرُهُمُ","wa-aktharuhumu","And most of them","এবং তাদের অধিকাংশ"],["ٱلْكَـٰفِرُونَ","l-kāfirūna","(are) the disbelievers","কাফের"]],"t":"يَعْرِفُونَ نِعْمَتَ <h>ٱ</>للَّهِ ثُ<g>مَّ</> يُ<k>نكِ</>رُونَهَا وَأَكْثَرُهُمُ <h>ٱ</>لْ<m>كَٰ</>فِ<p>رُو</>نَ"},{"n":84,"w":[["وَيَوْمَ","wayawma","And the Day","এবং যেদিন"],["نَبْعَثُ","nab‘athu","We will resurrect","উত্থিত করবো আমরা"],["مِن","min","from","থেকে"],["كُلِّ","kulli","every","প্রত্যেক"],["أُمَّةٍۢ","ummatin","nation","সম্প্রদায়"],["شَهِيدًۭا","shahīdan","a witness","সাক্ষী"],["ثُمَّ","thumma","then","এরপর"],["لَا","lā","not","না"],["يُؤْذَنُ","yu'dhanu","will be permitted","অনুমতি দেয়া হবে"],["لِلَّذِينَ","lilladhīna","to those who","(তাদের) যারা"],["كَفَرُوا۟","kafarū","disbelieved","অস্বীকার করেছে"],["وَلَا","walā","and not","এবং না"],["هُمْ","hum","they","তাদের"],["يُسْتَعْتَبُونَ","yus'ta‘tabūna","will be asked to make amends","সন্তুষ্টি লাভের সুযোগ দেয়া হবে"]],"t":"وَيَوْمَ نَ<q>بْ</>عَثُ مِ<k>ن كُ</>لِّ أُ<g>مَّ</><k>ةٍۢ شَ</>هِي<k>دًۭا ثُ</><g>مَّ</> لَا يُؤْذَنُ لِلَّذِينَ كَفَرُو<s>ا۟</> وَلَا هُمْ يُسْتَعْتَ<p>بُو</>نَ"},{"n":85,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["رَءَا","raā","(will) see","দেখবে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ظَلَمُوا۟","ẓalamū","wronged","সীমালঙ্ঘন করেছে"],["ٱلْعَذَابَ","l-‘adhāba","the punishment","শাস্তি"],["فَلَا","falā","then not","তখন না"],["يُخَفَّفُ","yukhaffafu","it will be lightened","লাঘব করা হবে"],["عَنْهُمْ","‘anhum","for them","তাদের থেকে"],["وَلَا","walā","and not","এবং না"],["هُمْ","hum","they","তাদের"],["يُنظَرُونَ","yunẓarūna","will be given respite","অবকাশ দেয়া হবে"]],"t":"وَإِذَا رَءَا <h>ٱ</>لَّذِينَ ظَلَمُو<s>ا۟</> <h>ٱ</>لْعَذَابَ فَلَا يُخَفَّفُ عَنْهُمْ وَلَا هُمْ يُ<k>نظَ</><p>رُو</>نَ"},{"n":86,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["رَءَا","raā","(will) see","দেখবে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["أَشْرَكُوا۟","ashrakū","associated partners with Allah","শিরক করেছে"],["شُرَكَآءَهُمْ","shurakāahum","their partners","তাদের শরীকদেরকে"],["قَالُوا۟","qālū","They will say","তারা বলবে"],["رَبَّنَا","rabbanā","Our Lord","\"হে আমাদের রব"],["هَـٰٓؤُلَآءِ","hāulāi","these","এসব"],["شُرَكَآؤُنَا","shurakāunā","(are) our partners","আমাদের শরীকরা"],["ٱلَّذِينَ","alladhīna","those whom","যাদের"],["كُنَّا","kunnā","we used to","আমরা ছিলাম"],["نَدْعُوا۟","nad‘ū","invoke","আমরা ডাকতাম"],["مِن","min","besides You","ছাড়া\""],["دُونِكَ ۖ","dūnika","besides You","আপনাকে\""],["فَأَلْقَوْا۟","fa-alqaw","But they (will) throw back","তখন ফিরিয়ে দিবে"],["إِلَيْهِمُ","ilayhimu","at them","দিকে তাদের"],["ٱلْقَوْلَ","l-qawla","(their) word","কথা"],["إِنَّكُمْ","innakum","Indeed, you","\"নিশ্চয়ই তোমরা"],["لَكَـٰذِبُونَ","lakādhibūna","(are) surely liars","অবশ্যই মিথ্যাবাদী\""]],"t":"وَإِذَا رَءَا <h>ٱ</>لَّذِينَ أَشْرَكُو<s>ا۟</> شُرَ<o>كَآ</>ءَهُمْ قَالُو<s>ا۟</> رَبَّنَا <o>هَٰٓؤُلَآ</>ءِ شُرَ<o>كَآ</>ؤُنَا <h>ٱ</>لَّذِينَ كُ<g>نَّ</>ا نَ<q>دْ</>عُو<s>ا۟</> مِ<k>ن دُ</>ونِكَ ۖ فَأَلْقَوْ<s>ا۟</> إِلَيْهِمُ <h>ٱ</>لْقَوْلَ إِ<g>نَّ</>كُمْ لَ<m>كَٰ</>ذِ<p>بُو</>نَ"},{"n":87,"w":[["وَأَلْقَوْا۟","wa-alqaw","And they (will) offer","এবং নিজেদেরকে সমর্পণ করবে"],["إِلَى","ilā","to","কাছে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["يَوْمَئِذٍ","yawma-idhin","(on) that Day","সেদিন"],["ٱلسَّلَمَ ۖ","l-salama","the submission","বশ্যতা স্বীকার করে"],["وَضَلَّ","waḍalla","and (is) lost","এবং হারিয়ে যাবে"],["عَنْهُم","‘anhum","from them","থেকে তাদের"],["مَّا","mā","what","যা"],["كَانُوا۟","kānū","they used (to)","তারা ছিলো"],["يَفْتَرُونَ","yaftarūna","invent","উদ্ভাবন করে"]],"t":"وَأَلْقَوْ<s>ا۟</> إِلَى <h>ٱ</>للَّهِ يَوْمَئِذٍ <h>ٱ</><l>ل</>سَّلَمَ ۖ وَضَلَّ عَنْ<y>هُم مَّ</>ا كَانُو<s>ا۟</> يَفْتَ<p>رُو</>نَ"},{"n":88,"w":[["ٱلَّذِينَ","alladhīna","And those who","যারা"],["كَفَرُوا۟","kafarū","disbelieved","অস্বীকার করেছে"],["وَصَدُّوا۟","waṣaddū","and hindered","ও বাঁধা দিয়েছে"],["عَن","‘an","from","থেকে"],["سَبِيلِ","sabīli","(the) way","পথ"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["زِدْنَـٰهُمْ","zid'nāhum","We will increase them","আমরা বাড়াবো তাদের"],["عَذَابًۭا","‘adhāban","(in) punishment","শাস্তি"],["فَوْقَ","fawqa","over","উপরে"],["ٱلْعَذَابِ","l-‘adhābi","punishment","শাস্তির"],["بِمَا","bimā","because","এ কারণে যা"],["كَانُوا۟","kānū","they used (to)","তারা ছিলো"],["يُفْسِدُونَ","yuf'sidūna","spread corruption","তারা অশান্তি সৃষ্টি করে"]],"t":"ٱلَّذِينَ كَفَرُو<s>ا۟</> وَصَدُّو<s>ا۟</> عَ<k>ن سَ</>بِيلِ <h>ٱ</>للَّهِ زِ<q>دْ</><m>نَٰ</>هُمْ عَذَا<k>بًۭا فَ</>وْقَ <h>ٱ</>لْعَذَابِ بِمَا كَانُو<s>ا۟</> يُفْسِ<p>دُو</>نَ"},{"n":89,"w":[["وَيَوْمَ","wayawma","And the Day","এবং সেদিন"],["نَبْعَثُ","nab‘athu","We will resurrect","আমরা উঠাবো"],["فِى","fī","among","মধ্যে"],["كُلِّ","kulli","every","প্রত্যেক"],["أُمَّةٍۢ","ummatin","nation","সম্প্রদায়ের"],["شَهِيدًا","shahīdan","a witness","একজন সাক্ষী"],["عَلَيْهِم","‘alayhim","over them","বিরুদ্ধে তাদের"],["مِّنْ","min","from","মধ্য থেকে"],["أَنفُسِهِمْ ۖ","anfusihim","themselves","নিজেদের তাদের"],["وَجِئْنَا","waji'nā","And We (will) bring","এবং আমরা আসবো"],["بِكَ","bika","you","নিয়ে তোমাকে"],["شَهِيدًا","shahīdan","(as) a witness","সাক্ষী (স্বরূপ)"],["عَلَىٰ","‘alā","over","বিরুদ্ধে"],["هَـٰٓؤُلَآءِ ۚ","hāulāi","these","এদের"],["وَنَزَّلْنَا","wanazzalnā","And We sent down","এবং আমরা অবতীর্ণ করেছি"],["عَلَيْكَ","‘alayka","to you","তোমার উপর"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","(এই) কিতাব"],["تِبْيَـٰنًۭا","tib'yānan","(as) a clarification","সুস্পষ্ট বর্ণনা করা"],["لِّكُلِّ","likulli","of every","জন্যে প্রত্যেক"],["شَىْءٍۢ","shayin","thing","বস্তুর"],["وَهُدًۭى","wahudan","and a guidance","ও পথ নির্দেশ"],["وَرَحْمَةًۭ","waraḥmatan","and mercy","ও অনুগ্রহ"],["وَبُشْرَىٰ","wabush'rā","and glad tidings","এবং সুসংবাদ"],["لِلْمُسْلِمِينَ","lil'mus'limīna","for the Muslims","জন্যে আত্নসমর্পণকারীদের"]],"t":"وَيَوْمَ نَ<q>بْ</>عَثُ فِى كُلِّ أُ<g>مَّ</><k>ةٍۢ شَ</>هِيدًا عَلَيْ<y>هِم مِّ</>نْ أَ<k>نفُ</>سِهِمْ ۖ وَجِئْنَا بِكَ شَهِيدًا عَلَىٰ <o>هَٰٓؤُلَآ</>ءِ ۚ وَنَزَّلْنَا عَلَيْكَ <h>ٱ</>لْكِ<m>تَٰ</>بَ تِ<q>بْ</><m>يَٰ</><w>نًۭا لِّ</>كُلِّ <d>شَىْءٍۢ وَهُدًۭى وَ</>رَحْمَ<d>ةًۭ وَ</>بُشْرَىٰ لِلْمُسْلِ<p>مِي</>نَ"},{"n":90,"w":[["۞ إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["يَأْمُرُ","yamuru","commands","নির্দেশ দেন"],["بِٱلْعَدْلِ","bil-‘adli","justice","ব্যাপারে ন্যায়ের"],["وَٱلْإِحْسَـٰنِ","wal-iḥ'sāni","and the good","সদাচরণ"],["وَإِيتَآئِ","waītāi","and giving","ও দান করার"],["ذِى","dhī","(to) relatives","সম্পন্ন"],["ٱلْقُرْبَىٰ","l-qur'bā","(to) relatives","নৈকট্য (আত্নীয়-স্বজনকে)"],["وَيَنْهَىٰ","wayanhā","and forbids","এবং নিষেধ করেন"],["عَنِ","‘ani","[from]","থেকে"],["ٱلْفَحْشَآءِ","l-faḥshāi","the immorality","অশ্লীলতা"],["وَٱلْمُنكَرِ","wal-munkari","and the bad","ও অসৎ কাজ"],["وَٱلْبَغْىِ ۚ","wal-baghyi","and the oppression","ও সীমালঙ্ঘন"],["يَعِظُكُمْ","ya‘iẓukum","He admonishes you","তিনি উপদেশ দিচ্ছেন তোমাদের"],["لَعَلَّكُمْ","la‘allakum","so that you may","যাতে তোমরা"],["تَذَكَّرُونَ","tadhakkarūna","take heed","শিক্ষা গ্রহণ করো"]],"t":"۞ إِ<g>نَّ</> <h>ٱ</>للَّهَ يَأْمُرُ بِ<h>ٱ</>لْعَ<q>دْ</>لِ وَ<h>ٱ</>لْإِحْ<m>سَٰ</>نِ وَإِيتَآئِ ذِى <h>ٱ</>لْقُرْبَىٰ وَيَنْهَىٰ عَنِ <h>ٱ</>لْفَحْ<o>شَآ</>ءِ وَ<h>ٱ</>لْمُ<k>نكَ</>رِ وَ<h>ٱ</>لْبَغْىِ ۚ يَعِظُكُمْ لَعَلَّكُمْ تَذَكَّ<p>رُو</>نَ"},{"n":91,"w":[["وَأَوْفُوا۟","wa-awfū","And fulfil","তোমরা পূর্ণ করো"],["بِعَهْدِ","bi‘ahdi","the covenant","অঙ্গীকার"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["إِذَا","idhā","when","যখন"],["عَـٰهَدتُّمْ","‘āhadttum","you have taken a covenant","তোমরা অঙ্গীকার করেছো"],["وَلَا","walā","and (do) not","এবং না"],["تَنقُضُوا۟","tanquḍū","break","তোমরা ভঙ্গ করো"],["ٱلْأَيْمَـٰنَ","l-aymāna","oaths","শপথসমূহকে"],["بَعْدَ","ba‘da","after","পরে"],["تَوْكِيدِهَا","tawkīdihā","their confirmation","দৃঢ় করার তা"],["وَقَدْ","waqad","while verily","এবং নিশ্চয়ই"],["جَعَلْتُمُ","ja‘altumu","you have made","তোমরা করেছো"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["عَلَيْكُمْ","‘alaykum","over you","উপর তোমাদের"],["كَفِيلًا ۚ","kafīlan","a surety","অভিভাবক"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","