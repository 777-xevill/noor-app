"],["فَٱسْتَعِذْ","fa-is'ta‘idh","seek refuge","তখন আশ্রয় চাইবে"],["بِٱللَّهِ","bil-lahi","in Allah","কাছে আল্লাহর"],["مِنَ","mina","from","থেকে"],["ٱلشَّيْطَـٰنِ","l-shayṭāni","the Shaitaan","শয়তান"],["ٱلرَّجِيمِ","l-rajīmi","the accursed","বিতাড়িত"]],"t":"فَإِذَا قَرَأْتَ <h>ٱ</>لْقُرْءَانَ فَ<h>ٱ</>سْتَعِذْ بِ<h>ٱ</>للَّهِ مِنَ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نِ <h>ٱ</><l>ل</>رَّ<p>جِي</>مِ"},{"n":99,"w":[["إِنَّهُۥ","innahu","Indeed he","সে নিশ্চয়ই (এমন যে)"],["لَيْسَ","laysa","not","নেই"],["لَهُۥ","lahu","for him","জন্যে তার"],["سُلْطَـٰنٌ","sul'ṭānun","(is) any authority","আধিপত্য"],["عَلَى","‘alā","on","(তাদের) উপর"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["وَعَلَىٰ","wa‘alā","and upon","এবং উপর"],["رَبِّهِمْ","rabbihim","their Lord","তাদের রবের"],["يَتَوَكَّلُونَ","yatawakkalūna","they put their trust","তারা নির্ভর করে"]],"t":"إِ<g>نَّ</>هُ<m>ۥ</> لَيْسَ لَهُ<m>ۥ</> سُلْ<m>طَٰ</>نٌ عَلَى <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَلَىٰ رَبِّهِمْ يَتَوَكَّ<p>لُو</>نَ"},{"n":100,"w":[["إِنَّمَا","innamā","Only","মূলতঃ"],["سُلْطَـٰنُهُۥ","sul'ṭānuhu","his authority","তার আধিপত্য"],["عَلَى","‘alā","(is) over","(তাদের) উপর"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["يَتَوَلَّوْنَهُۥ","yatawallawnahu","take him as an ally","তাকে অভিভাবক বানিয়েছে"],["وَٱلَّذِينَ","wa-alladhīna","and those who","ও যারা (এমন যে)"],["هُم","hum","[they]","তারা"],["بِهِۦ","bihi","with Him","সাথে তাঁর"],["مُشْرِكُونَ","mush'rikūna","associate partners","শরীককারী"]],"t":"إِ<g>نَّ</>مَا سُلْ<m>طَٰ</>نُهُ<m>ۥ</> عَلَى <h>ٱ</>لَّذِينَ يَتَوَلَّوْنَهُ<m>ۥ</> وَ<h>ٱ</>لَّذِينَ <f>هُم بِ</><m>هِۦ</> مُشْرِ<p>كُو</>نَ"},{"n":101,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["بَدَّلْنَآ","baddalnā","We substitute","আমরা বদলে দিই"],["ءَايَةًۭ","āyatan","a Verse","এক আয়াতকে"],["مَّكَانَ","makāna","(in) place","জায়গায়"],["ءَايَةٍۢ ۙ","āyatin","(of) a Verse","(অপর) আয়াতের"],["وَٱللَّهُ","wal-lahu","and Allah ","এবং আল্লাহ্‌"],["أَعْلَمُ","a‘lamu","(is) most knowing","খুব জানেন"],["بِمَا","bimā","of what","ঐ বিষয়ে যা"],["يُنَزِّلُ","yunazzilu","He sends down","তিনি অবতীর্ণ করেন"],["قَالُوٓا۟","qālū","they say","তারা বলে"],["إِنَّمَآ","innamā","Only","\"মূলতঃ"],["أَنتَ","anta","you","তুমি"],["مُفْتَرٍۭ ۚ","muf'tarin","(are) an inventor","(কুরআন) রচনাকারী\""],["بَلْ","bal","Nay","বরং"],["أَكْثَرُهُمْ","aktharuhum","most of them","অধিকাংশই তাদের"],["لَا","lā","(do) not","না"],["يَعْلَمُونَ","ya‘lamūna","know","তারা জানে"]],"t":"وَإِذَا بَدَّلْ<o>نَآ</> ءَايَ<d>ةًۭ مَّ</>كَانَ ءَايَ<d>ةٍۢ ۙ وَ</><h>ٱ</>للَّهُ أَعْلَمُ بِمَا يُنَزِّلُ قَا<o>لُوٓ</><s>ا۟</> إِ<g>نَّ</><o>مَآ</> أَ<k>نتَ</> مُفْتَ<i>رٍۭ ۚ بَ</>لْ أَكْثَرُهُمْ لَا يَعْلَ<p>مُو</>نَ"},{"n":102,"w":[["قُلْ","qul","Say","বলো"],["نَزَّلَهُۥ","nazzalahu","Has brought it down","\"তা অবতীর্ণ করেন"],["رُوحُ","rūḥu","the Holy Spirit","আত্না"],["ٱلْقُدُسِ","l-qudusi","the Holy Spirit","পবিত্র (জিব্রাইল আঃ)"],["مِن","min","from","থেকে"],["رَّبِّكَ","rabbika","your Lord","তোমার রবের"],["بِٱلْحَقِّ","bil-ḥaqi","in truth","ভাবে যথাযথ"],["لِيُثَبِّتَ","liyuthabbita","to make firm","জন্যে দৃঢ় প্রতিষ্ঠিত করার"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["وَهُدًۭى","wahudan","and (as) a guidance","এবং পথ নির্দেশ"],["وَبُشْرَىٰ","wabush'rā","and glad tidings","ও সুসংবাদ"],["لِلْمُسْلِمِينَ","lil'mus'limīna","to the Muslims","আত্নসমর্পণকারীদের\""]],"t":"قُلْ نَزَّلَهُ<m>ۥ</> رُوحُ <h>ٱ</>لْقُدُسِ <w>مِن رَّ</>بِّكَ بِ<h>ٱ</>لْحَقِّ لِيُثَبِّتَ <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَهُ<d>دًۭى وَ</>بُشْرَىٰ لِلْمُسْلِ<p>مِي</>نَ"},{"n":103,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["نَعْلَمُ","na‘lamu","We know","জানি আমরা"],["أَنَّهُمْ","annahum","that they","যে তারা"],["يَقُولُونَ","yaqūlūna","say","বলে"],["إِنَّمَا","innamā","Only","\"প্রকৃতপক্ষে"],["يُعَلِّمُهُۥ","yu‘allimuhu","teaches him","তাকে শিখিয়েছে"],["بَشَرٌۭ ۗ","basharun","a human being","এক মানুষ\""],["لِّسَانُ","lisānu","(The) tongue","ভা