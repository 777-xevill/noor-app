{"n":100,"a":[{"n":1,"w":[["وَٱلْعَـٰدِيَـٰتِ","wal-‘ādiyāti","By the racers","শপথ ধাবমান (ঘোড়াগুলোর)"],["ضَبْحًۭا","ḍabḥan","panting","(যারা দৌঁড়ায়) উর্ধ্বশ্বাসে"]],"t":"وَ<h>ٱ</>لْ<m>عَٰدِيَٰ</>تِ ضَ<q>بْ</>حًۭا"},{"n":2,"w":[["فَٱلْمُورِيَـٰتِ","fal-mūriyāti","And the producers of sparks","অতঃপর যারা বিচ্ছুরিত করে"],["قَدْحًۭا","qadḥan","striking","(ক্ষুরাঘাতে) আগুনের ফুলকি"]],"t":"فَ<h>ٱ</>لْمُورِ<m>يَٰ</>تِ قَ<q>دْ</>حًۭا"},{"n":3,"w":[["فَٱلْمُغِيرَٰتِ","fal-mughīrāti","And the chargers","অতঃপর যারা অভিযান চালায়"],["صُبْحًۭا","ṣub'ḥan","(at) dawn","প্রভাতে"]],"t":"فَ<h>ٱ</>لْمُغِي<m>رَٰ</>تِ صُ<q>بْ</>حًۭا"},{"n":4,"w":[["فَأَثَرْنَ","fa-atharna","Then raise","অতঃপর উড়ায়"],["بِهِۦ","bihi","thereby","এভাবে"],["نَقْعًۭا","naq‘an","dust","ধুলোবালি"]],"t":"فَأَثَرْنَ بِ<m>هِۦ</> نَ<q>قْ</>عًۭا"},{"n":5,"w":[["فَوَسَطْنَ","fawasaṭna","Then penetrate (in the) center","অতঃপর (ঢুকে পড়ে) অভ্যন্তরে"],["بِهِۦ","bihi","thereby","এভাবে"],["جَمْعًا","jam‘an","collectively","(শত্রু)দলে"]],"t":"فَوَسَ<q>طْ</>نَ بِ<m>هِۦ</> جَمْعًا"},{"n":6,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلْإِنسَـٰنَ","l-insāna","mankind","মানুষ"],["لِرَبِّهِۦ","lirabbihi","to his Lord","তার রবের প্রতি"],["لَكَنُودٌۭ","lakanūdun","(is) surely ungrateful","অবশ্যই অকৃতজ্ঞ"]],"t":"إِ<g>نَّ</> <h>ٱ</>لْإِ<k>نسَٰ</>نَ لِرَبِّ<m>هِۦ</> لَكَ<p>نُو</><q>دٌۭ</>"},{"n":7,"w":[["وَإِنَّهُۥ","wa-innahu","And indeed, he","এবং সে নিশ্চয়ই"],["عَلَىٰ","‘alā","on","বিষয়ে"],["ذَٰلِكَ","dhālika","that","এর"],["لَشَهِيدٌۭ","lashahīdun","surely (is) a witness","অবশ্যই সাক্ষী"]],"t":"وَإِ<g>نَّ</>هُ<m>ۥ</> عَلَىٰ <m>ذَٰ</>لِكَ لَشَ<p>هِي</><q>دٌۭ</>"},{"n":8,"w":[["وَإِنَّهُۥ","wa-innahu","And indeed he","এবং নিশ্চয়ই সে"],["لِحُبِّ","liḥubbi","in (the) love","মহব্বতের ক্ষেত্রে"],["ٱلْخَيْرِ","l-khayri","(of) wealth","ধন-সম্পদের"],["لَشَدِيدٌ","lashadīdun","(is) surely intense","বড়ই প্রবল"]],"t":"وَإِ<g>نَّ</>هُ<m>ۥ</> لِحُبِّ <h>ٱ</>لْخَيْرِ لَشَ<p>دِي</><q>دٌ</>"},{"n":9,"w":[["۞ أَفَلَا","afalā","But does not","তবে কি না"],["يَعْلَمُ","ya‘lamu","he know","সে জানে"],["إِذَا","idhā","when","যখন"],["بُعْثِرَ","bu‘'thira","will be scattered","উঠানো হবে"],["مَا","mā","what","যা কিছু"],["فِى","fī","(is) in","মধ্যে আছে"],["ٱلْقُبُورِ","l-qubūri","the graves","কবরগুলোর"]],"t":"۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى <h>ٱ</>لْقُ<p>بُو</>رِ"},{"n":10,"w":[["وَحُصِّلَ","waḥuṣṣila","And is made apparent","এবং প্রকাশ করা হবে"],["مَا","mā","what","যা কিছু"],["فِى","fī","(is) in","মধ্যে আছে"],["ٱلصُّدُورِ","l-ṣudūri","the breasts","অন্তরসমূহের"]],"t":"وَحُصِّلَ مَا فِى <h>ٱ</><l>ل</>صُّ<p>دُو</>رِ"},{"n":11,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["رَبَّهُم","rabbahum","their Lord","তাদের রব"],["بِهِمْ","bihim","about them","তাদের সাথে"],["يَوْمَئِذٍۢ","yawma-idhin","that Day","সেদিন"],["لَّخَبِيرٌۢ","lakhabīrun","(is) surely All-Aware","অবশ্যই তা ভালো করেই জানেন"]],"t":"إِ<g>نَّ</> رَبَّ<f>هُم بِ</>هِمْ يَوْمَئِ<w>ذٍۢ لَّ</>خَ<p>بِي</>رٌۢ"}]}