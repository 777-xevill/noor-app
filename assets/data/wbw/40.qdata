ِ<p>لُو</>نَ"},{"n":68,"w":[["هُوَ","huwa","He","তিনিই (আল্লাহ)"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["يُحْىِۦ","yuḥ'yī","gives life","জীবন দেন"],["وَيُمِيتُ ۖ","wayumītu","and causes death","ও মৃত্যু ঘটান"],["فَإِذَا","fa-idhā","And when","অতঃপর যখন"],["قَضَىٰٓ","qaḍā","He decrees","সিদ্ধান্ত নেন"],["أَمْرًۭا","amran","a matter","কোনো ব্যাপারে"],["فَإِنَّمَا","fa-innamā","then only","শুধু তখন"],["يَقُولُ","yaqūlu","He says","বলেন"],["لَهُۥ","lahu","to it","তাকে"],["كُن","kun","Be","\"হও\""],["فَيَكُونُ","fayakūnu","and it is","তখনই তা হয়ে যায়"]],"t":"هُوَ <h>ٱ</>لَّذِى يُحْ<m>ىِۦ</> وَيُمِيتُ ۖ فَإِذَا قَضَ<o>ىٰٓ</> أَمْ<k>رًۭا فَ</>إِ<g>نَّ</>مَا يَقُولُ لَهُ<m>ۥ</> كُ<k>ن فَ</>يَ<p>كُو</>نُ"},{"n":69,"w":[["أَلَمْ","alam","Do not","নি কি"],["تَرَ","tara","you see","তুমি দেখো"],["إِلَى","ilā","[to]","প্রতি"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["يُجَـٰدِلُونَ","yujādilūna","dispute","বিতর্ক করে"],["فِىٓ","fī","concerning","মধ্যে"],["ءَايَـٰتِ","āyāti","(the) Signs","নিদর্শনাবলীর"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["أَنَّىٰ","annā","How","কোথায়"],["يُصْرَفُونَ","yuṣ'rafūna","they are turned away","তাদেরকে ফিরানো হচ্ছে (অর্থাৎ বিভ্রান্ত করা হচ্ছে)"]],"t":"أَلَمْ تَرَ إِلَى <h>ٱ</>لَّذِينَ يُ<m>جَٰ</>دِلُونَ <o>فِىٓ</> ءَا<m>يَٰ</>تِ <h>ٱ</>للَّهِ أَ<g>نَّ</>ىٰ يُصْرَ<p>فُو</>نَ"},{"n":70,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["كَذَّبُوا۟","kadhabū","deny","মিথ্যারোপ করে"],["بِٱلْكِتَـٰبِ","bil-kitābi","the Book","(এই) কিতাবের প্রতি"],["وَبِمَآ","wabimā","and with what","এবং ঐ বিষয়ে যা"],["أَرْسَلْنَا","arsalnā","We sent","আমরা পাঠিয়েছি"],["بِهِۦ","bihi","with it","যাসহ (অন্যান্য কিতাব)"],["رُسُلَنَا ۖ","rusulanā","Our Messengers","আমাদের রাসূলগণকে"],["فَسَوْفَ","fasawfa","but soon","শীঘ্রই"],["يَعْلَمُونَ","ya‘lamūna","they will know","তারা জানতে পারবে"]],"t":"ٱلَّذِينَ كَذَّبُو<s>ا۟</> بِ<h>ٱ</>لْكِ<m>تَٰ</>بِ وَبِ<o>مَآ</> أَرْسَلْنَا بِ<m>هِۦ</> رُسُلَنَا ۖ فَسَوْفَ يَعْلَ<p>مُو</>نَ"},{"n":71,"w":[["إِذِ","idhi","When","যখন"],["ٱلْأَغْلَـٰلُ","l-aghlālu","the iron collars","বেড়িসমূহ (পরানো হবে)"],["فِىٓ","fī","(will be) around","মধ্যে"],["أَعْنَـٰقِهِمْ","a‘nāqihim","their necks","তাদের গলায়"],["وَٱلسَّلَـٰسِلُ","wal-salāsilu","and the chains","এবং শিকল (গলায় দেওয়া হবে)"],["يُسْحَبُونَ","yus'ḥabūna","they will be dragged","তাদের টেনে নিয়ে যাওয়া হবে"]],"t":"إِذِ <h>ٱ</>لْأَغْ<m>لَٰ</>لُ <o>فِىٓ</> أَعْ<m>نَٰ</>قِهِمْ وَ<h>ٱ</><l>ل</>سَّ<m>لَٰ</>سِلُ يُسْحَ<p>بُو</>نَ"},{"n":72,"w":[["فِى","fī","In","মধ্যে"],["ٱلْحَمِيمِ","l-ḥamīmi","the boiling water","ফুটন্ত পানির"],["ثُمَّ","thumma","then","এরপর"],["فِى","fī","in","মধ্যে"],["ٱلنَّارِ","l-nāri","the Fire","আগুনের"],["يُسْجَرُونَ","yus'jarūna","they will be burned","তাদেরকে পোড়ানো হবে"]],"t":"فِى <h>ٱ</>لْحَمِيمِ ثُ<g>مَّ</> فِى <h>ٱ</><l>ل</><g>نَّ</>ارِ يُسْجَ<p>رُو</>نَ"},{"n":73,"w":[["ثُمَّ","thumma","Then","পরে"],["قِيلَ","qīla","it will be said","বলা হবে"],["لَهُمْ","lahum","to them","তাদেরকে"],["أَيْنَ","ayna","Where","\"কোথায় (এখন)"],["مَا","mā","(is) that which","(তারা) যাদের"],["كُنتُمْ","kuntum","you used to","তোমরা"],["تُشْرِكُونَ","tush'rikūna","associate","শরিক করছিলে"]],"t":"ثُ<g>مَّ</> قِيلَ لَهُمْ أَيْنَ مَا كُ<k>نتُ</>مْ تُشْرِ<p>كُو</>نَ"},{"n":74,"w":[["مِن","min","Other than","মধ্য হতে"],["دُونِ","dūni","Other than","ছাড়া"],["ٱللَّهِ ۖ","l-lahi","Allah","আল্লাহ\""],["قَالُوا۟","qālū","They will say","তারা বলবে"],["ضَلُّوا۟","ḍallū","They have departed","\"তারা উধাও হয়েছে"],["عَنَّا","‘annā","from us","আমাদের থেকে"],["بَل","bal","Nay","বরং"],["لَّمْ","lam","Not","না"],["نَكُن","nakun","we used to","আমরা ছিলাম"],["نَّدْعُوا۟","nad‘ū","[we] call","আমরা ডাকতাম"],["مِن","min","before","মধ্য হতে"],["قَبْلُ","qablu","before","পূর্বে"],["شَيْـًۭٔا ۚ","shayan","anything","কোনো কিছুকেই\""],["كَذَٰلِكَ","kadhālika","Thus","এভাবে"],["يُضِلُّ","yuḍillu","Allah lets go astray","বিভ্রান্ত করবেন"],["ٱللَّهُ","l-lahu","Allah lets go astray","আল্লাহ"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","the disbelievers","কাফেরদেরকে"]],"t":"مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ ۖ قَالُو<s>ا۟</> ضَلُّو<s>ا۟</> عَ<g>نَّ</>ا بَل لَّمْ نَ<d>كُن نَّ</><q>دْ</>عُو<s>ا۟</> مِ<k>ن قَ</><q>بْ</>لُ شَ<k>يْـًۭٔا ۚ كَ</><m>ذَٰ</>لِكَ يُضِلُّ <h>ٱ</>للَّهُ <h>ٱ</>لْ<m>كَٰ</>فِ<p>رِي</>نَ"},{"n":75,"w":[["ذَٰلِكُم","dhālikum","That was","\"তোমাদের এ অবস্থা"],["بِمَا","bimā","because","এ কারণে যে"],["كُنتُمْ","kuntum","you used to","তোমরা"],["تَفْرَحُونَ","tafraḥūna","rejoice","উল্লাস করছিলে"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["بِغَيْرِ","bighayri","without","ছাড়া"],["ٱلْحَقِّ","l-ḥaqi","right","(অন্যায় ভাবে)"],["وَبِمَا","wabimā","and because","এবং এ কারণে যে"],["كُنتُمْ","kuntum","you used to","তোমরা"],["تَمْرَحُونَ","tamraḥūna","be insolent","দেমাক করছিলে"]],"t":"<m>ذَٰ</>لِ<f>كُم بِ</>مَا كُ<k>نتُ</>مْ تَفْرَحُونَ فِى <h>ٱ</>لْأَرْضِ بِغَيْرِ <h>ٱ</>لْحَقِّ وَبِمَا كُ<k>نتُ</>مْ تَمْرَ<p>حُو</>نَ"},{"n":76,"w":[["ٱدْخُلُوٓا۟","ud'khulū","Enter","(এখন যাও) তোমরা প্রবেশ করো"],["أَبْوَٰبَ","abwāba","(the) gates","দরজা দিয়ে"],["جَهَنَّمَ","jahannama","(of) Hell","জাহান্নামের"],["خَـٰلِدِينَ","khālidīna","(to) abide forever","তোমরা স্থায়ী হবে"],["فِيهَا ۖ","fīhā","in it","তার মধ্যে"],["فَبِئْسَ","fabi'sa","and wretched is","অতএব কত নিকৃষ্ট"],["مَثْوَى","mathwā","(the) abode","বাসস্থান"],["ٱلْمُتَكَبِّرِينَ","l-mutakabirīna","(of) the arrogant","অহংকারীদের (জন্যে)\""]],"t":"ٱ<q>دْ</>خُ<o>لُوٓ</><s>ا۟</> أَ<q>بْ</><m>وَٰ</>بَ جَهَ<g>نَّ</>مَ <m>خَٰ</>لِدِينَ فِيهَا ۖ فَبِئْسَ مَثْوَى <h>ٱ</>لْمُتَكَبِّ<p>رِي</>نَ"},{"n":77,"w":[["فَٱصْبِرْ","fa-iṣ'bir","So be patient","(হে নাবী) তাই ধৈর্য্য ধরো"],["إِنَّ","inna","indeed","নিশ্চয়ই"],["وَعْدَ","wa‘da","(the) Promise","প্রতিশ্রুতি"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["حَقٌّۭ ۚ","ḥaqqun","(is) true","সত্য"],["فَإِمَّا","fa-immā","And whether","সুতরাং হয়"],["نُرِيَنَّكَ","nuriyannaka","We show you","তোমাকে দেখাবো আমরা"],["بَعْضَ","ba‘ḍa","some","কিছুটা"],["ٱلَّذِى","alladhī","(of) what","যা"],["نَعِدُهُمْ","na‘iduhum","We have promised them","প্রতিশ্রুতি দিই আমরা তাদেরকে"],["أَوْ","aw","or","অথবা"],["نَتَوَفَّيَنَّكَ","natawaffayannaka","We cause you to die","তোমাকে মৃত্যু ঘটাই আমরা"],["فَإِلَيْنَا","fa-ilaynā","then to Us","তবে আমাদের দিকে"],["يُرْجَعُونَ","yur'ja‘ūna","they will be returned","তাদের ফিরিয়ে আনা হবে"]],"t":"فَ<h>ٱ</>صْبِرْ إِ<g>نَّ</> وَعْدَ <h>ٱ</>للَّهِ حَ<k>قٌّۭ ۚ فَ</>إِ<g>مَّ</>ا نُرِيَ<g>نَّ</>كَ بَعْضَ <h>ٱ</>لَّذِى نَعِدُهُمْ أَوْ نَتَوَفَّيَ<g>نَّ</>كَ فَإِلَيْنَا يُرْجَ<p>عُو</>نَ"},{"n":78,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["أَرْسَلْنَا","arsalnā","We have sent","আমরা পাঠিয়েছি"],["رُسُلًۭا","rusulan","Messengers","(অনেক) রাসূলকে"],["مِّن","min","before you","থেকে"],["قَبْلِكَ","qablika","before you","তোমার পূর্বে"],["مِنْهُم","min'hum","Among them","তাদের মধ্যে"],["مَّن","man","(are) who ","কারও (অবস্থা)"],["قَصَصْنَا","qaṣaṣnā","We have related","আমরা বর্ণনা করেছি"],["عَلَيْكَ","‘alayka","to you","তোমার কাছে"],["وَمِنْهُم","wamin'hum","and among them","আবার তাদের মধ্যে"],["مَّن","man","(are) who ","কারও (অবস্থা)"],["لَّمْ","lam","not","নি"],["نَقْصُصْ","naqṣuṣ","We have related","আমরা বর্ণনা করি"],["عَلَيْكَ ۗ","‘alayka","to you","তোমার কাছে"],["وَمَا","wamā","And not","এবং না"],["كَانَ","kāna","is","(সম্ভব) ছিলো"],["لِرَسُولٍ","lirasūlin","for any Messenger","কোনো রাসূলের জন্যে"],["أَن","an","that","যে"],["يَأْتِىَ","yatiya","he brings","আসবে"],["بِـَٔايَةٍ","biāyatin","a Sign","নিয়ে কোন নিদর্শন"],["إِلَّا","illā","except","ব্যতীত"],["بِإِذْنِ","bi-idh'ni","by (the) permission","অনুমতি"],["ٱللَّهِ ۚ","l-lahi","(of) Allah","আল্লাহর"],["فَإِذَا","fa-idhā","So when","অতঃপর যখন"],["جَآءَ","jāa","comes","আসলো"],["أَمْرُ","amru","(the) Command","আদেশ"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["قُضِىَ","quḍiya","it will be decided","মীমাংসা করে দেওয়া হলো"],["بِٱلْحَقِّ","bil-ḥaqi","in truth","ন্যায়ভাবে"],["وَخَسِرَ","wakhasira","and will lose","এবং ক্ষতিগ্রস্ত হলো"],["هُنَالِكَ","hunālika","there","সেখানে"],["ٱلْمُبْطِلُونَ","l-mub'ṭilūna","the falsifiers","মিথ্যাশ্রয়ীরা (দুষ্কৃতিকারীরা)"]],"t":"وَلَقَ<q>دْ</> أَرْسَلْنَا رُسُلًۭ<d>ا مِّ</><k>ن قَ</><q>بْ</>لِكَ مِنْ<y>هُم مَّ</><k>ن قَ</>صَصْنَا عَلَيْكَ وَمِنْ<y>هُم مَّ</><w>ن لَّ</>مْ نَ<q>قْ</>صُصْ عَلَيْكَ ۗ وَمَا كَانَ لِرَسُولٍ <d>أَن يَ</>أْتِىَ بِـَٔايَةٍ إِلَّا بِإِذْنِ <h>ٱ</>للَّهِ ۚ فَإِذَا <o>جَآ</>ءَ أَمْرُ <h>ٱ</>للَّهِ قُضِىَ بِ<h>ٱ</>لْحَقِّ وَخَسِرَ هُنَالِكَ <h>ٱ</>لْمُ<q>بْ</>طِ<p>لُو</>نَ"},{"n":79,"w":[["ٱللَّهُ","al-lahu","Allah","(তিনিই) আল্লাহ"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["جَعَلَ","ja‘ala","made","সৃষ্টি করেছেন"],["لَكُمُ","lakumu","for you","তোমাদের জন্যে"],["ٱلْأَنْعَـٰمَ","l-an‘āma","the cattle","গবাদি পশুগুলো"],["لِتَرْكَبُوا۟","litarkabū","that you may ride","তোমরা আরোহণ করতে পারো যেন"],["مِنْهَا","min'hā","some of them","তার মধ্যে হ'তে (কোনটির উপর)"],["وَمِنْهَا","wamin'hā","and some of them","এবং তার মধ্যে হ'তে"],["تَأْكُلُونَ","takulūna","you eat","তোমরা খাও (কোনটির গোশত)"]],"t":"ٱللَّهُ <h>ٱ</>لَّذِى جَعَلَ لَكُمُ <h>ٱ</>لْأَنْ<m>عَٰ</>مَ لِتَرْكَبُو<s>ا۟</> مِنْهَا وَمِنْهَا تَأْكُ<p>لُو</>نَ"},{"n":80,"w":[["وَلَكُمْ","walakum","And for you","এবং তোমাদের জন্যে"],["فِيهَا","fīhā","in them","তার মধ্যে (রয়েছে)"],["مَنَـٰفِعُ","manāfi‘u","(are) benefits","(অনেক) উপকার"],["وَلِتَبْلُغُوا۟","walitablughū","and that you may reach","এবং তোমরা মেটাতে পারো যেন"],["عَلَيْهَا","‘alayhā","through them","তার সাহায্যে"],["حَاجَةًۭ","ḥājatan","a need","প্রয়োজন (বোধ করলে)"],["فِى","fī","(that is) in","মধ্যে"],["صُدُورِكُمْ","ṣudūrikum","your breasts","তোমাদের মনের"],["وَعَلَيْهَا","wa‘alayhā","and upon them","এবং তার উপর"],["وَعَلَى","wa‘alā","and upon","এবং উপর"],["ٱلْفُلْكِ","l-ful'ki","the ships","নৌযানের"],["تُحْمَلُونَ","tuḥ'malūna","you are carried","তোমাদের বহন করা হয়"]],"t":"وَلَكُمْ فِيهَا مَ<m>نَٰ</>فِعُ وَلِتَ<q>بْ</>لُغُو<s>ا۟</> عَلَيْهَا حَاجَ<k>ةًۭ فِ</>ى صُدُورِكُمْ وَعَلَيْهَا وَعَلَى <h>ٱ</>لْفُلْكِ تُحْمَ<p>لُو</>نَ"},{"n":81,"w":[["وَيُرِيكُمْ","wayurīkum","And He shows you","এবং তোমাদের দেখান তিনি"],["ءَايَـٰتِهِۦ","āyātihi","His Signs","তাঁর নিদর্শনাবলী"],["فَأَىَّ","fa-ayya","Then which","সুতরাং কোন"],["ءَايَـٰتِ","āyāti","(of the) Signs","নিদর্শনাবলী"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["تُنكِرُونَ","tunkirūna","will you deny","তোমরা অস্বীকার করবে"]],"t":"وَيُرِيكُمْ ءَا<m>يَٰتِهِۦ</> فَأَىَّ ءَا<m>يَٰ</>تِ <h>ٱ</>للَّهِ تُ<k>نكِ</><p>رُو</>نَ"},{"n":82,"w":[["أَفَلَمْ","afalam","Do they not","নি তবে কি"],["يَسِيرُوا۟","yasīrū","travel","তারা ভ্রমণ করে"],["فِى","fī","through","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the land","পৃথিবীর"],["فَيَنظُرُوا۟","fayanẓurū","and see","তারা অতঃপর দেখে (নি কি)"],["كَيْفَ","kayfa","how","কেমন"],["كَانَ","kāna","was","ছিলো"],["عَـٰقِبَةُ","‘āqibatu","(the) end","পরিণতি"],["ٱلَّذِينَ","alladhīna","(of) those who","(তাদের) যারা"],["مِن","min","(were) before them","মধ্য হতে"],["قَبْلِهِمْ ۚ","qablihim","(were) before them","তাদের পূর্বে (ছিলো)"],["كَانُوٓا۟","kānū","They were","তারা ছিলো"],["أَكْثَرَ","akthara","more numerous","(সংখ্যায়) বেশী"],["مِنْهُمْ","min'hum","than them","এদের চেয়েও"],["وَأَشَدَّ","wa-ashadda","and mightier","ও প্রবল"],["قُوَّةًۭ","quwwatan","(in) strength","শক্তিতে"],["وَءَاثَارًۭا","waāthāran","and impressions","ও কীর্তিতে"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the land","পৃথিবীর"],["فَمَآ","famā","but not","অতঃপর না"],["أَغْنَىٰ","aghnā","availed","কাজে আসলো"],["عَنْهُم","‘anhum","them","তাদের জন্যে"],["مَّا","mā","what","যা"],["كَانُوا۟","kānū","they used to","তারা"],["يَكْسِبُونَ","yaksibūna","earn","অর্জন করেছিলো"]],"t":"أَفَلَمْ يَسِيرُو<s>ا۟</> فِى <h>ٱ</>لْأَرْضِ فَيَ<k>نظُ</>رُو<s>ا۟</> كَيْفَ كَانَ <m>عَٰ</>قِبَةُ <h>ٱ</>لَّذِينَ مِ<k>ن قَ</><q>بْ</>لِهِمْ ۚ كَا<o>نُوٓ</><s>ا۟</> أَكْثَرَ مِنْهُمْ وَأَشَدَّ قُوَّ<d>ةًۭ وَ</>ءَاثَا<k>رًۭا فِ</>ى <h>ٱ</>لْأَرْضِ فَ<o>مَآ</> أَغْنَىٰ عَنْ<y>هُم مَّ</>ا كَانُو<s>ا۟</> يَكْسِ<p>بُو</>نَ"},{"n":83,"w":[["فَلَمَّا","falammā","Then when","অতঃপর যখন"],["جَآءَتْهُمْ","jāathum","came to them","তাদের কাছে আসলো"],["رُسُلُهُم","rusuluhum","their Messengers","তাদের রাসূলগণ"],["بِٱلْبَيِّنَـٰتِ","bil-bayināti","with clear proofs","সুস্পষ্ট প্রমাণসহ"],["فَرِحُوا۟","fariḥū","they rejoiced","তারা খুশীতে মগ্ন রইলো"],["بِمَا","bimā","in what","ঐ বিষয়ে যা (ছিলো)"],["عِندَهُم","‘indahum","they had","তাদের কাছে"],["مِّنَ","mina","of","অংশ বিশেষ"],["ٱلْعِلْمِ","l-‘il'mi","the knowledge","(নিজস্ব) জ্ঞানের"],["وَحَاقَ","waḥāqa","and enveloped","এবং ঘিরে ফেললো"],["بِهِم","bihim","them","তাদেরকে"],["مَّا","mā","what","তাই"],["كَانُوا۟","kānū","they used to","তারা ছিলো"],["بِهِۦ","bihi","[at it]","যে সম্পর্কে"],["يَسْتَهْزِءُونَ","yastahziūna","mock","ঠাট্টা-বিদ্রুপ করতো"]],"t":"فَلَ<g>مَّ</>ا <o>جَآ</>ءَتْهُمْ رُسُلُ<f>هُم بِ</><h>ٱ</>لْبَيِّ<m>نَٰ</>تِ فَرِحُو<s>ا۟</> بِمَا عِ<k>ندَ</><y>هُم مِّ</>نَ <h>ٱ</>لْعِلْمِ وَحَاقَ بِ<y>هِم مَّ</>ا كَانُو<s>ا۟</> بِ<m>هِۦ</> يَسْتَهْزِ<p>ءُو</>نَ"},{"n":84,"w":[["فَلَمَّا","falammā","So when","অতঃপর যখন"],["رَأَوْا۟","ra-aw","they saw","তারা দেখলো"],["بَأْسَنَا","basanā","Our punishment","আমাদের শাস্তি"],["قَالُوٓا۟","qālū","they said","তারা বললো"],["ءَامَنَّا","āmannā","We believe","\"আমরা ঈমান এনেছি"],["بِٱللَّهِ","bil-lahi","in Allah","আল্লাহর উপর"],["وَحْدَهُۥ","waḥdahu","Alone","তাঁর একারই"],["وَكَفَرْنَا","wakafarnā","and we disbelieve","এবং আমরা অস্বীকার করছি"],["بِمَا","bimā","in what","তা সবকে"],["كُنَّا","kunnā","we used to","আমরা ছিলাম"],["بِهِۦ","bihi","with Him","যার সাথে"],["مُشْرِكِينَ","mush'rikīna","associate","শরিককারী\""]],"t":"فَلَ<g>مَّ</>ا رَأَوْ<s>ا۟</> بَأْسَنَا قَا<o>لُوٓ</><s>ا۟</> ءَامَ<g>نَّ</>ا بِ<h>ٱ</>للَّهِ وَحْدَهُ<m>ۥ</> وَكَفَرْنَا بِمَا كُ<g>نَّ</>ا بِ<m>هِۦ</> مُشْرِ<p>كِي</>نَ"},{"n":85,"w":[["فَلَمْ","falam","But did not","অতঃপর"],["يَكُ","yaku","But did not","পারে নি"],["يَنفَعُهُمْ","yanfa‘uhum","benefit them","তাদের উপকার করতে"],["إِيمَـٰنُهُمْ","īmānuhum","their faith","তাদের ঈমান"],["لَمَّا","lammā","when","যখন"],["رَأَوْا۟","ra-aw","they saw","তারা দেখলো"],["بَأْسَنَا ۖ","basanā","Our punishment","আমাদের শাস্তি"],["سُنَّتَ","sunnata","(Such is the) Way","বিধান"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর (নির্ধারিত)"],["ٱلَّتِى","allatī","which","যা"],["قَدْ","qad","(has) indeed","নিশ্চয়ই"],["خَلَتْ","khalat","preceded","(চলে এসেছে)অতীত হয়েছে"],["فِى","fī","among","ব্যাপারে"],["عِبَادِهِۦ ۖ","‘ibādihi","His slaves","তাঁর দাসদের"],["وَخَسِرَ","wakhasira","And are lost","এবং ক্ষতিগ্রস্ত হয়েছে"],["هُنَالِكَ","hunālika","there","এমন অবস্হায়"],["ٱلْكَـٰفِرُونَ","l-kāfirūna","the disbelievers","কাফেররা"]],"t":"فَلَمْ يَكُ يَ<k>نفَ</>عُهُمْ إِي<m>مَٰ</>نُهُمْ لَ<g>مَّ</>ا رَأَوْ<s>ا۟</> بَأْسَنَا ۖ سُ<g>نَّ</>تَ <h>ٱ</>للَّهِ <h>ٱ</>لَّتِى قَ<q>دْ</> خَلَتْ فِى عِبَادِهِۦ<m> ۖ</> وَخَسِرَ هُنَالِكَ <h>ٱ</>لْ<m>كَٰ</>فِ<p>رُو</>نَ"}]}