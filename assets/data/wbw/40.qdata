","akhāfu","[I] fear","আমি ভয় করছি"],["عَلَيْكُمْ","‘alaykum","for you","তোমাদের উপর"],["يَوْمَ","yawma","(the) Day","দিনের"],["ٱلتَّنَادِ","l-tanādi","(of) Calling","আর্তনাদের"]],"t":"وَ<m>يَٰ</>قَوْمِ إِ<g>نِّ</><o>ىٓ</> أَخَافُ عَلَيْكُمْ يَوْمَ <h>ٱ</><l>ل</>تَّ<p>نَا</><q>دِ</>"},{"n":33,"w":[["يَوْمَ","yawma","A Day","যেদিন"],["تُوَلُّونَ","tuwallūna","you will turn back","তোমরা পালাবে"],["مُدْبِرِينَ","mud'birīna","fleeing","পিছনে"],["مَا","mā","not","না (থাকবে)"],["لَكُم","lakum","for you","তোমাদের জন্যে"],["مِّنَ","mina","from","হ'তে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["مِنْ","min","any","কোনো"],["عَاصِمٍۢ ۗ","‘āṣimin","protector","রক্ষাকারী"],["وَمَن","waman","And whoever","এবং যাকে"],["يُضْلِلِ","yuḍ'lili","Allah lets go astray","পথভ্রষ্ট করেন"],["ٱللَّهُ","l-lahu","Allah lets go astray","আল্লাহ"],["فَمَا","famā","then not","তখন নাই"],["لَهُۥ","lahu","for him","তার জন্যে"],["مِنْ","min","any","কোনো"],["هَادٍۢ","hādin","guide","পথ প্রদর্শক"]],"t":"يَوْمَ تُوَلُّونَ مُ<q>دْ</>بِرِينَ مَا لَ<y>كُم مِّ</>نَ <h>ٱ</>للَّهِ مِنْ عَاصِ<d>مٍۢ ۗ وَمَن يُ</>ضْلِلِ <h>ٱ</>للَّهُ فَمَا لَهُ<m>ۥ</> مِنْ <p>هَا</><q>دٍۢ</>"},{"n":34,"w":[["وَلَقَدْ","walaqad","And indeed","এবং নিশ্চয়ই"],["جَآءَكُمْ","jāakum","came to you","কাছে এসেছিলো তোমাদের"],["يُوسُفُ","yūsufu","Yusuf","ইউসুফ"],["مِن","min","before","পূর্বে"],["قَبْلُ","qablu","before","ইতি"],["بِٱلْبَيِّنَـٰتِ","bil-bayināti","with clear proofs","সুস্পষ্ট প্রমাণসহ"],["فَمَا","famā","but not","কিন্তু"],["زِلْتُمْ","zil'tum","you ceased","তোমরা ছিলে সর্বদা"],["فِى","fī","in","মধ্যে"],["شَكٍّۢ","shakkin","doubt","সন্দেহের"],["مِّمَّا","mimmā","about what","ঐ বিষয়ে যা"],["جَآءَكُم","jāakum","he brought to you","তোমাদের কাছে এনেছিলো"],["بِهِۦ ۖ","bihi","[with it]","সে সম্পর্কে"],["حَتَّىٰٓ","ḥattā","until","অবশেষে"],["إِذَا","idhā","when","যখন"],["هَلَكَ","halaka","he died","সে মারা গেলো"],["قُلْتُمْ","qul'tum","you said","তোমরা বলেছিলে"],["لَن","lan","Never","\"কখনও না"],["يَبْعَثَ","yab‘atha","will Allah raise","পাঠাবেন"],["ٱللَّهُ","l-lahu","will Allah raise","আল্লাহ"],["مِنۢ","min","after him","পরে"],["بَعْدِهِۦ","ba‘dihi","after him","তার"],["رَسُولًۭا ۚ","rasūlan","a Messenger","কোনো রাসূল\""],["كَذَٰلِكَ","kadhālika","Thus","এভাবে"],["يُضِلُّ","yuḍillu","Allah lets go astray","বিভ্রান্ত করেন"],["ٱللَّهُ","l-lahu","Allah lets go astray","আল্লাহ"],["مَنْ","man","who","তাকে"],["هُوَ","huwa","[he]","যে"],["مُسْرِفٌۭ","mus'rifun","(is) a transgressor","সীমালংঘন"],["مُّرْتَابٌ","mur'tābun","a doubter","সংশয়বাদী\""]],"t":"وَلَقَ<q>دْ</> <o>جَآ</>ءَكُمْ يُوسُفُ مِ<k>ن قَ</><q>بْ</>لُ بِ<h>ٱ</>لْبَيِّ<m>نَٰ</>تِ فَمَا زِلْتُمْ فِى شَ<d>كٍّۢ مِّ</><g>مَّ</>ا <o>جَآ</>ءَ<f>كُم بِ</><m>هِۦ</> ۖ حَتَّ<o>ىٰٓ</> إِذَا هَلَكَ قُلْتُمْ <d>لَن يَ</><q>بْ</>عَثَ <h>ٱ</>للَّهُ <i>مِنۢ بَ</>عْدِ<m>هِۦ</> رَسُولًۭا ۚ<k> كَ</><m>ذَٰ</>لِكَ يُضِلُّ <h>ٱ</>للَّهُ مَنْ هُوَ مُسْرِ<d>فٌۭ مُّ</>رْ<p>تَا</><q>بٌ</>"},{"n":35,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["يُجَـٰدِلُونَ","yujādilūna","dispute","তর্কে লিপ্ত হয়"],["فِىٓ","fī","concerning","ক্ষেত্রে"],["ءَايَـٰتِ","āyāti","(the) Signs","নিদর্শনাবলীর"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["بِغَيْرِ","bighayri","without","ব্যতীত"],["سُلْطَـٰنٍ","sul'ṭānin","any authority","কোনো প্রমাণ (যা)"],["أَتَىٰهُمْ ۖ","atāhum","(having) come to them","তাদের কাছে এসেছে"],["كَبُرَ","kabura","(it) is greatly","অতিশয় হয়েছে"],["مَقْتًا","maqtan","hateful","ঘৃণা"],["عِندَ","‘inda","near Allah","কাছে"],["ٱللَّهِ","l-lahi","near Allah","আল্লাহর"],["وَعِندَ","wa‘inda","and near","ও কাছে"],["ٱلَّذِينَ","alladhīna","those","(তাদের) যারা"],["ءَامَنُوا۟ ۚ","āmanū","who believe","ঈমান এনেছে"],["كَذَٰلِكَ","kadhālika","Thus","এভাবে"],["يَطْبَعُ","yaṭba‘u","Allah sets a seal","সীল মেরে দেন"],["ٱللَّهُ","l-lahu","Allah sets a seal","আল্লাহ"],["عَلَىٰ","‘alā","over","উপর"],["كُلِّ","kulli","every","প্রত্যেক"],["قَلْبِ","qalbi","heart","অন্তরের (উপর)"],["مُتَكَبِّرٍۢ","mutakabbirin","(of) an arrogant","(যা) অহংকারী"],["جَبَّارٍۢ","jabbārin","tyrant","স্বৈরাচারী\""]],"t":"ٱلَّذِينَ يُ<m>جَٰ</>دِلُونَ <o>فِىٓ</> ءَا<m>يَٰ</>تِ <h>ٱ</>للَّهِ بِغَيْرِ سُلْ<m>طَٰ</>نٍ أَتَ<m>ىٰ</>هُمْ ۖ كَبُرَ مَ<q>قْ</>تًا عِ<k>ندَ</> <h>ٱ</>للَّهِ وَعِ<k>ندَ</> <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟ ۚ</> كَ<m>ذَٰ</>لِكَ يَ<q>طْ</>بَعُ <h>ٱ</>للَّهُ عَلَىٰ كُلِّ قَلْبِ مُتَكَبِّ<k>رٍۢ جَ</><p>بَّا</>رٍۢ"},{"n":36,"w":[["وَقَالَ","waqāla","And said","এবং বললো"],["فِرْعَوْنُ","fir'‘awnu","Firaun","ফিরআউন"],["يَـٰهَـٰمَـٰنُ","yāhāmānu","O Haman","\"হে হামান"],["ٱبْنِ","ib'ni","Construct","নির্মাণ করো"],["لِى","lī","for me","আমার জন্যে"],["صَرْحًۭا","ṣarḥan","a tower","সুউচ্চ প্রাসাদ"],["لَّعَلِّىٓ","la‘allī","that I may","যাতে"],["أَبْلُغُ","ablughu","reach","আমি পৌঁছি"],["ٱلْأَسْبَـٰبَ","l-asbāba","the ways","পথসমূহে"]],"t":"وَقَالَ فِرْعَوْنُ <m>يَٰهَٰمَٰ</>نُ <h>ٱ</><q>بْ</>نِ لِى صَرْ<w>حًۭا لَّ</>عَ<o>لِّىٓ</> أَ<q>بْ</>لُغُ <h>ٱ</>لْأَسْ<p>بَٰ</><q>بَ</>"},{"n":37,"w":[["أَسْبَـٰبَ","asbāba","(The) ways","পথসমূহ"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(to) the heavens","আকাশের"],["فَأَطَّلِعَ","fa-aṭṭali‘a","so I may look","আমি অতঃপর উঁকি মেরে দেখি"],["إِلَىٰٓ","ilā","at","কাছে"],["إِلَـٰهِ","ilāhi","(the) God","ইলাহর"],["مُوسَىٰ","mūsā","(of) Musa","মূসার"],["وَإِنِّى","wa-innī","and indeed, I","এবং নিশ্চয়ই আমি"],["لَأَظُنُّهُۥ","la-aẓunnuhu","[I] surely think him","আমি অবশ্যই তাকে মনে করি"],["كَـٰذِبًۭا ۚ","kādhiban","(to be) a liar","মিথ্যাবাদী\""],["وَكَذَٰلِكَ","wakadhālika","And thus","এবং এভাবে"],["زُيِّنَ","zuyyina","was made fair-seeming","শোভন করা হয়েছিলো"],["لِفِرْعَوْنَ","lifir'‘awna","to Firaun","ফিরআউনের জন্যে"],["سُوٓءُ","sūu","(the) evil","খারাপ"],["عَمَلِهِۦ","‘amalihi","(of) his deed","তার কাজ কর্ম"],["وَصُدَّ","waṣudda","and he was averted","ও বিরত রাখা হয়েছিলো তাকে"],["عَنِ","‘ani","from","হ'তে"],["ٱلسَّبِيلِ ۚ","l-sabīli","the way","(সঠিক) পথ"],["وَمَا","wamā","And not","এবং না"],["كَيْدُ","kaydu","(was the) plot","ষড়যন্ত্র  (কাজে লাগলো)"],["فِرْعَوْنَ","fir'‘awna","(of) Firaun","ফিরআউনের"],["إِلَّا","illā","except","এ ব্যতীত"],["فِى","fī","in","মধ্যে"],["تَبَابٍۢ","tabābin","ruin","ধংসের (পতিত হলো)"]],"t":"أَسْ<m>بَٰ</>بَ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ فَأَطَّلِعَ إِلَ<o>ىٰٓ</> إِ<m>لَٰ</>هِ مُوسَىٰ وَإِ<g>نِّ</>ى لَأَظُ<g>نُّ</>هُ<m>ۥ كَٰ</>ذِ<d>بًۭا ۚ وَ</>كَ<m>ذَٰ</>لِكَ زُيِّنَ لِفِرْعَوْنَ <o>سُوٓ</>ءُ عَمَلِ<m>هِۦ</> وَصُدَّ عَنِ <h>ٱ</><l>ل</>سَّبِيلِ ۚ وَمَا كَيْدُ فِرْعَوْنَ إِلَّا فِى تَ<p>بَا</><q>بٍۢ</>"},{"n":38,"w":[["وَقَالَ","waqāla","And said","এবং বললো"],["ٱلَّذِىٓ","alladhī","the one who","যে"],["ءَامَنَ","āmana","believed","ঈমান এনেছিলো"],["يَـٰقَوْمِ","yāqawmi","O my people","\"হে আমার জাতি"],["ٱتَّبِعُونِ","ittabi‘ūni","Follow me","আমাকে তোমরা অনুসরণ করো"],["أَهْدِكُمْ","ahdikum","I will guide you","তোমাদেরকে আমি পরিচালিত করবো"],["سَبِيلَ","sabīla","(to the) way","পথে"],["ٱلرَّشَادِ","l-rashādi","the right","সঠিক"]],"t":"وَقَالَ <h>ٱ</>لَّ<o>ذِىٓ</> ءَامَنَ <m>يَٰ</>قَوْمِ <h>ٱ</>تَّبِعُونِ أَهْدِكُمْ سَبِيلَ <h>ٱ</><l>ل</>رَّ<p>شَا</><q>دِ</>"},{"n":39,"w":[["يَـٰقَوْمِ","yāqawmi","O my people","হে আমার জাতি"],["إِنَّمَا","innamā","Only","মূলতঃ"],["هَـٰذِهِ","hādhihi","this","এই"],["ٱلْحَيَوٰةُ","l-ḥayatu","the life","জীবন"],["ٱلدُّنْيَا","l-dun'yā","(of) the world","পার্থিব"],["مَتَـٰعٌۭ","matā‘un","(is) enjoyment","উপভোগের বস্তু (অস্থায়ী)"],["وَإِنَّ","wa-inna","and indeed","আর নিশ্চয়ই"],["ٱلْـَٔاخِرَةَ","l-ākhirata","the Hereafter ","পরকাল"],["هِىَ","hiya","it","তা"],["دَارُ","dāru","(is the) home","ঘর (স্থায়ী)"],["ٱلْقَرَارِ","l-qarāri","(of) settlement","অবস্থানের"]],"t":"<m>يَٰ</>قَوْمِ إِ<g>نَّ</>مَا <m>هَٰ</>ذِهِ <h>ٱ</>لْحَيَ<s>وٰ</>ةُ <h>ٱ</><l>ل</>دُّنْيَا مَ<m>تَٰ</><d>عٌۭ وَ</>إِ<g>نَّ</> <h>ٱ</>لْءَاخِرَةَ هِىَ دَارُ <h>ٱ</>لْقَ<p>رَا</>رِ"},{"n":40,"w":[["مَنْ","man","Whoever","যে"],["عَمِلَ","‘amila","does","কাজ করবে"],["سَيِّئَةًۭ","sayyi-atan","an evil","মন্দ"],["فَلَا","falā","then not","অতঃপর না"],["يُجْزَىٰٓ","yuj'zā","he will be recompensed","প্রতিফল দেওয়া হবে"],["إِلَّا","illā","but","এ ব্যতীত"],["مِثْلَهَا ۖ","mith'lahā","(the) like thereof","তার সমান"],["وَمَنْ","waman","and whoever","আর যে"],["عَمِلَ","‘amila","does","কাজ করবে"],["صَـٰلِحًۭا","ṣāliḥan","righteous (deeds)","সৎ"],["مِّن","min","of","মধ্যে"],["ذَكَرٍ","dhakarin","male","পুরুষের"],["أَوْ","aw","or","বা"],["أُنثَىٰ","unthā","female","নারীর"],["وَهُوَ","wahuwa","while he","এমতাবস্হায় সে"],["مُؤْمِنٌۭ","mu'minun","(is) a believer","মু'মিনও"],["فَأُو۟لَـٰٓئِكَ","fa-ulāika","then those","অতঃপর ঐ সব লোক"],["يَدْخُلُونَ","yadkhulūna","will enter","প্রবেশ করবে"],["ٱلْجَنَّةَ","l-janata","Paradise","জান্নাতে"],["يُرْزَقُونَ","yur'zaqūna","they will be given provision","তাদের জীবনোপকরণ দেয়া হবে"],["فِيهَا","fīhā","in it","তার মধ্যে"],["بِغَيْرِ","bighayri","without","ছাড়াই"],["حِسَابٍۢ","ḥisābin","account","কোন হিসাব"]],"t":"مَنْ عَمِلَ سَيِّئَ<k>ةًۭ فَ</>لَا يُ<q>جْ</>زَ<o>ىٰٓ</> إِلَّا مِثْلَهَا ۖ وَمَنْ عَمِلَ <m>صَٰ</>لِ<d>حًۭا مِّ</><k>ن ذَ</>كَرٍ أَوْ أُ<k>نثَ</>ىٰ وَهُوَ مُؤْمِ<k>نٌۭ فَ</>أُ<s>و۟</><o>لَٰٓ</>ئِكَ يَ<q>دْ</>خُلُونَ <h>ٱ</>لْجَ<g>نَّ</>ةَ يُرْزَقُونَ فِيهَا بِغَيْرِ حِ<p>سَا</><q>بٍۢ</>"},{"n":41,"w":[["۞ وَيَـٰقَوْمِ","wayāqawmi","And O my people","এবং (সে বললো) হে আমার জাতি"],["مَا","mā","What (is)","(এটা)"],["لِىٓ","lī","for me","আমার সাথে কেমন আচরণ"],["أَدْعُوكُمْ","ad‘ūkum","(that) I call you","আমি তোমাদের ডাকছি"],["إِلَى","ilā","to","দিকে"],["ٱلنَّجَوٰةِ","l-najati","the salvation","পরিত্রাণের"],["وَتَدْعُونَنِىٓ","watad‘ūnanī","while you call me","অথচ আমাকে তোমরা ডাকছো"],["إِلَى","ilā","to","দিকে"],["ٱلنَّارِ","l-nāri","the Fire","জাহান্নামের"]],"t":"۞ وَ<m>يَٰ</>قَوْمِ مَا <o>لِىٓ</> أَ<q>دْ</>عُوكُمْ إِلَى <h>ٱ</><l>ل</><g>نَّ</>جَ<s>وٰ</>ةِ وَتَ<q>دْ</>عُونَ<o>نِىٓ</> إِلَى <h>ٱ</><l>ل</><g>نَّ</><p>ا</>رِ"},{"n":42,"w":[["تَدْعُونَنِى","tad‘ūnanī","You call me","আমাকে তোমরা ডাকছো"],["لِأَكْفُرَ","li-akfura","that I disbelieve","যেন আমি অস্বীকার করি"],["بِٱللَّهِ","bil-lahi","in Allah","প্রতি আল্লাহর"],["وَأُشْرِكَ","wa-ush'rika","and (to) associate","ও  শরিক করি (যেন) আমি"],["بِهِۦ","bihi","with Him","তাঁর সাথে"],["مَا","mā","what","যা"],["لَيْسَ","laysa","not","নেই"],["لِى","lī","for me","আমার কাছে"],["بِهِۦ","bihi","of it","সে সম্পর্কে"],["عِلْمٌۭ","‘il'mun","any knowledge","কোনো জ্ঞান"],["وَأَنَا۠","wa-anā","and I","এবং আমি"],["أَدْعُوكُمْ","ad‘ūkum","call you","ডাকছি তোমাদেরকে"],["إِلَى","ilā","to","দিকে"],["ٱلْعَزِيزِ","l-‘azīzi","the All-Mighty","পরাক্রমশালীর"],["ٱلْغَفَّـٰرِ","l-ghafāri","the Oft-Forgiving","(যিনি) পরম ক্ষমাশীলও"]],"t":"تَ<q>دْ</>عُونَنِى لِأَكْفُرَ بِ<h>ٱ</>للَّهِ وَأُشْرِكَ بِ<m>هِۦ</> مَا لَيْسَ لِى بِ<m>هِۦ</> عِلْ<d>مٌۭ وَ</>أَنَا۠ أَ<q>دْ</>عُوكُمْ إِلَى <h>ٱ</>لْعَزِيزِ <h>ٱ</>لْغَ<p>فَّٰ</>رِ"},{"n":43,"w":[["لَا","lā","No","নেই"],["جَرَمَ","jarama","doubt","কোনো সন্দেহ"],["أَنَّمَا","annamā","that what","মূলতঃ"],["تَدْعُونَنِىٓ","tad‘ūnanī","you call me","আমাকে তোমরা ডাকছো"],["إِلَيْهِ","ilayhi","to it","যার দিকে"],["لَيْسَ","laysa","not","নেই"],["لَهُۥ","lahu","for it","তার জন্যে"],["دَعْوَةٌۭ","da‘watun","a claim","কোনো আহবান"],["فِى","fī","in","মধ্যে"],["ٱلدُّنْيَا","l-dun'yā","the world","দুনিয়ার"],["وَلَا","walā","and not","আর না"],["فِى","fī","in","মধ্যে"],["ٱلْـَٔاخِرَةِ","l-ākhirati","the Hereafter","পরকালের"],["وَأَنَّ","wa-anna","and that","এবং (এও) যে"],["مَرَدَّنَآ","maraddanā","our return","আমাদের প্রত্যাবর্তন হবে"],["إِلَى","ilā","(is) to","দিকে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["وَأَنَّ","wa-anna","and that","এবং (এও সত্য) যে"],["ٱلْمُسْرِفِينَ","l-mus'rifīna","the transgressors ","সীমালংঘনকারী"],["هُمْ","hum","they","তারাই"],["أَصْحَـٰبُ","aṣḥābu","(will be the) companions","অধিবাসী"],["ٱلنَّارِ","l-nāri","(of) the Fire","জাহান্নামের"]],"t":"لَا جَرَمَ أَ<g>نَّ</>مَا تَ<q>دْ</>عُونَ<o>نِىٓ</> إِلَيْهِ لَيْسَ لَهُ<m>ۥ</> دَعْوَ<k>ةٌۭ فِ</>ى <h>ٱ</><l>ل</>دُّنْيَا وَلَا فِى <h>ٱ</>لْءَاخِرَةِ وَأَ<g>نَّ</> مَرَدَّ<o>نَآ</> إِلَى <h>ٱ</>للَّهِ وَأَ<g>نَّ</> <h>ٱ</>لْمُسْرِفِينَ هُمْ أَصْ<m>حَٰ</>بُ <h>ٱ</><l>ل</><g>نَّ</><p>ا</>رِ"},{"n":44,"w":[["فَسَتَذْكُرُونَ","fasatadhkurūna","And you will remember","তোমরা অতঃপর শীঘ্রই স্মরণ করবে"],["مَآ","mā","what","যা"],["أَقُولُ","aqūlu","I say","আমি বলছি"],["لَكُمْ ۚ","lakum","to you","তোমাদেরকে"],["وَأُفَوِّضُ","wa-ufawwiḍu","and I entrust","এবং সমর্পণ করছি আমি"],["أَمْرِىٓ","amrī","my affair","আমার ব্যাপারে"],["إِلَى","ilā","to","কাছে"],["ٱللَّهِ ۚ","l-lahi","Allah","আল্লাহর"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["بَصِيرٌۢ","baṣīrun","(is) All-Seer","সবিশেষ দৃষ্টি রাখেন"],["بِٱلْعِبَادِ","bil-‘ibādi","of (His) slaves","প্রতি দাসদের\""]],"t":"فَسَتَذْكُرُونَ <o>مَآ</> أَقُولُ لَكُمْ ۚ وَأُفَوِّضُ أَمْ<o>رِىٓ</> إِلَى <h>ٱ</>للَّهِ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ بَصِي<i>رٌۢ بِ</><h>ٱ</>لْعِ<p>بَا</><q>دِ</>"},{"n":45,"w":[["فَوَقَىٰهُ","fawaqāhu","So Allah protected him","অতঃপর তাকে বাঁচালেন"],["ٱللَّهُ","l-lahu","So Allah protected him","আল্লাহ"],["سَيِّـَٔاتِ","sayyiāti","(from the) evils","অনিষ্টসমূহ হ'তে"],["مَا","mā","that","যা"],["مَكَرُوا۟ ۖ","makarū","they plotted","তারা চক্রান্ত করেছিলো"],["وَحَاقَ","waḥāqa","and enveloped","এবং ঘিরে ফেললো"],["بِـَٔالِ","biāli","(the) people","সম্প্রদায়কে"],["فِرْعَوْنَ","fir'‘awna","(of) Firaun","ফিরআউনের"],["سُوٓءُ","sūu","(the) worst","কঠিন"],["ٱلْعَذَابِ","l-‘adhābi","punishment","শাস্তিতে"]],"t":"فَوَقَ<m>ىٰ</>هُ <h>ٱ</>للَّهُ سَيِّـَٔاتِ مَا مَكَرُو<s>ا۟ ۖ</> وَحَاقَ بِـَٔالِ فِرْعَوْنَ <o>سُوٓ</>ءُ <h>ٱ</>لْعَ<p>ذَا</><q>بِ</>"},{"n":46,"w":[["ٱلنَّارُ","al-nāru","The Fire","(দোজখের) আগুন"],["يُعْرَضُونَ","yu‘'raḍūna","they are exposed","তাদের পেশ করা হয়"],["عَلَيْهَا","‘alayhā","to it","তার উপর"],["غُدُوًّۭا","ghuduwwan","morning","সকালে"],["وَعَشِيًّۭا ۖ","wa‘ashiyyan","and evening","ও সন্ধ্যায়"],["وَيَوْمَ","wayawma","And (the) Day","এবং যে দিন"],["تَقُومُ","taqūmu","(will be) established","ঘটবে"],["ٱلسَّاعَةُ","l-sā‘atu","the Hour","ক্বিয়ামাত"],["أَدْخِلُوٓا۟","adkhilū","Cause to enter","\"(তখন বলা হবে) প্রবেশ করাও"],["ءَالَ","āla","(the) people","সম্প্রদায়কে"],["فِرْعَوْنَ","fir'‘awna","(of) Firaun","ফিরআউনের"],["أَشَدَّ","ashadda","(in the) severest","কঠিন"],["ٱلْعَذَابِ","l-‘adhābi","punishment","শাস্তিতে\""]],"t":"ٱ<l>ل</><g>نَّ</>ارُ يُعْرَضُونَ عَلَيْهَا غُدُ<d>وًّۭا وَ</>عَشِ<d>يًّۭا ۖ وَ</>يَوْمَ تَقُومُ <h>ٱ</><l>ل</>سَّاعَةُ أَ<q>دْ</>خِ<o>لُوٓ</><s>ا۟</> ءَالَ فِرْعَوْنَ أَشَدَّ <h>ٱ</>لْعَ<p>ذَا</><q>بِ</>"},{"n":47,"w":[["وَإِذْ","wa-idh","And when","এবং (ভেবে দেখো) যখন"],["يَتَحَآجُّونَ","yataḥājjūna","they will dispute","তারা তর্কাতর্কি করবে"],["فِى","fī","in","মধ্যে"],["ٱلنَّارِ","l-nāri","the Fire","আগুনের"],["فَيَقُولُ","fayaqūlu","then will say","তখন বলবে"],["ٱلضُّعَفَـٰٓؤُا۟","l-ḍu‘afāu","the weak","দুর্বলেরা"],["لِلَّذِينَ","lilladhīna","to those who","(তাদের)-কে যারা"],["ٱسْتَكْبَرُوٓا۟","is'takbarū","were arrogant","অহংকার করে (বড় বনে) ছিলো"],["إِنَّا","innā","Indeed, we","\"নিশ্চয়ই আমরা"],["كُنَّا","kunnā","[we] were","ছিলাম"],["لَكُمْ","lakum","for you","তোমাদের"],["تَبَعًۭا","taba‘an","followers","অনুসারী"],["فَهَلْ","fahal","so can","কি এখন"],["أَنتُم","antum","you","তোমরা"],["مُّغْنُونَ","mugh'nūna","avert","কাজে আসবে"],["عَنَّا","‘annā","from us","আমাদের জন্যে"],["نَصِيبًۭا","naṣīban","a portion","কিছু অংশ (কমাতে)"],["مِّنَ","mina","of","হ'তে"],["ٱلنَّارِ","l-nāri","the Fire","(দোযখের) আগুনের\""]],"t":"وَإِذْ يَتَ<n>حَآ</>جُّونَ فِى <h>ٱ</><l>ل</><g>نَّ</>ارِ فَيَقُولُ <h>ٱ</><l>ل</>ضُّعَ<o>فَٰٓ</>ؤُ<s>ا۟</> لِلَّذِينَ <h>ٱ</>سْتَكْبَ<o>رُوٓ</><s>ا۟</> إِ<g>نَّ</>ا كُ<g>نَّ</>ا لَكُمْ تَبَ<k>عًۭا فَ</>هَلْ أَ<k>نتُ</><y>م مُّ</>غْنُونَ عَ<g>نَّ</>ا نَصِي<d>بًۭا مِّ</>نَ <h>ٱ</><l>ل</><g>نَّ</><p>ا</>رِ"},{"n":48,"w":[["قَالَ","qāla","Will say","বলবে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ٱسْتَكْبَرُوٓا۟","is'takbarū","(were) arrogant","অহংকার করে (বড় বনে) ছিলো"],["إِنَّا","innā","Indeed, we","\"নিশ্চয়ই আমরা"],["كُلٌّۭ","kullun","all","সবাই"],["فِيهَآ","fīhā","(are) in it","তার মধ্যে (একই অবস্থায়)"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["قَدْ","qad","certainly","নিশ্চয়"],["حَكَمَ","ḥakama","has judged","মীমাংসা করে দিয়েছেন"],["بَيْنَ","bayna","between","মাঝে"],["ٱلْعِبَادِ","l-‘ibādi","(His) slaves","দাসদের\""]],"t":"قَالَ <h>ٱ</>لَّذِينَ <h>ٱ</>سْتَكْبَ<o>رُوٓ</><s>ا۟</> إِ<g>نَّ</>ا كُ<k>لٌّۭ فِ</>ي<o>هَآ</> إِ<g>نَّ</> <h>ٱ</>للَّهَ قَ<q>دْ</> حَكَمَ بَيْنَ <h>ٱ</>لْعِ<p>بَا</><q>دِ</>"},{"n":49,"w":[["وَقَالَ","waqāla","And will say","এবং বলবে"],["ٱلَّذِينَ","alladhīna","those","যারা"],["فِى","fī","in","মধ্যে (থাকবে)"],["ٱلنَّارِ","l-nāri","the Fire","আগুনের"],["لِخَزَنَةِ","likhazanati","to (the) keepers","প্রহরীদেরকে"],["جَهَنَّمَ","jahannama","(of) Hell","জাহান্নামের"],["ٱدْعُوا۟","id'‘ū","Call","\"তোমরা প্রার্থনা করো"],["رَبَّكُمْ","rabbakum","your Lord","তোমাদের রবের কাছে"],["يُخَفِّفْ","yukhaffif","(to) lighten","কমিয়ে দেন (যেন)"],["عَنَّا","‘annā","for us","আমাদের থেকে"],["يَوْمًۭا","yawman","a day","একদিন"],["مِّنَ","mina","of","থেকে"],["ٱلْعَذَابِ","l-‘adhābi","the punishment","শাস্তির\""]],"t":"وَقَالَ <h>ٱ</>لَّذِينَ فِى <h>ٱ</><l>ل</><g>نَّ</>ارِ لِخَزَنَةِ جَهَ<g>نَّ</>مَ <h>ٱ</><q>دْ</>عُو<s>ا۟</> رَبَّكُمْ يُخَفِّفْ عَ<g>نَّ</>ا يَوْ<d>مًۭا مِّ</>نَ <h>ٱ</>لْعَ<p>ذَا</><q>بِ</>"},{"n":50,"w":[["قَالُوٓا۟","qālū","They (will) say","তারা বলবে"],["أَوَلَمْ","awalam","Did there not","\"নি কি"],["تَكُ","taku","Did there not","\""],["تَأْتِيكُمْ","tatīkum","come to you","তোমাদের কাছে আসে"],["رُسُلُكُم","rusulukum","your Messengers","তোমাদের রাসূলগণ"],["بِٱلْبَيِّنَـٰتِ ۖ","bil-bayināti","with clear proofs","সুস্পষ্ট প্রমাণসহ\""],["قَالُوا۟","qālū","They (will) say","(দোযখীরা) বলবে"],["بَلَىٰ ۚ","balā","Yes","\"হ্যাঁ\""],["قَالُوا۟","qālū","They (will) say","(প্রহরীরা) বলবে"],["فَٱدْعُوا۟ ۗ","fa-id'‘ū","Then call","\"তোমরাই প্রার্থনা করো তাহ'লে"],["وَمَا","wamā","but not","এবং নয়"],["دُعَـٰٓؤُا۟","du‘āu","(is the) call","প্রার্থনা"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","(of) the disbelievers","কাফেরদের"],["إِلَّا","illā","except","এ ব্যতীত"],["فِى","fī","in","মধ্যে"],["ضَلَـٰلٍ","ḍalālin","error","ব্যর্থতার\""]],"t":"قَا<o>لُوٓ</><s>ا۟</> أَوَلَمْ تَكُ تَأْتِيكُمْ رُسُلُ<f>كُم بِ</><h>ٱ</>لْبَيِّ<m>نَٰ</>تِ ۖ قَالُو<s>ا۟</> بَلَىٰ ۚ قَالُو<s>ا۟</> فَ<h>ٱ</><q>دْ</>عُو<s>ا۟ ۗ</> وَمَا دُ<o>عَٰٓ</>ؤُ<s>ا۟</> <h>ٱ</>لْ<m>كَٰ</>فِرِينَ إِلَّا فِى ضَ<p>لَٰ</>لٍ"},{"n":51,"w":[["إِنَّا","innā","Indeed We","নিশ্চয়ই আমরা"],["لَنَنصُرُ","lananṣuru","We will surely help","অবশ্যই সাহায্য করবো"],["رُسُلَنَا","rusulanā","Our Messengers","আমাদের রাসূলগণকে"],["وَٱلَّذِينَ","wa-alladhīna","and those who","এবং যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে (তাদেরকে)"],["فِى","fī","in","মধ্যে"],["ٱلْحَيَوٰةِ","l-ḥayati","the life","জীবনের"],["ٱلدُّنْيَا","l-dun'yā","(of) the world","পার্থিব"],["وَيَوْمَ","wayawma","and (on the) Day","এবং যেদিনে"],["يَقُومُ","yaqūmu","(when) will stand","দাঁড়াবে"],["ٱلْأَشْهَـٰدُ","l-ashhādu","the witnesses","সাক্ষীরা"]],"t":"إِ<g>نَّ</>ا لَنَ<k>نصُ</>رُ رُسُلَنَا وَ<h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> فِى <h>ٱ</>لْحَيَ<s>وٰ</>ةِ <h>ٱ</><l>ل</>دُّنْيَا وَيَوْمَ يَقُومُ <h>ٱ</>لْأَشْ<p>هَٰ</><q>دُ</>"},{"n":52,"w":[["يَوْمَ","yawma","(The) Day","সেদিন"],["لَا","lā","not","না"],["يَنفَعُ","yanfa‘u","will benefit","উপকার দিবে"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","সীমালঙ্ঘনকারীদের (জন্য)"],["مَعْذِرَتُهُمْ ۖ","ma‘dhiratuhum","their excuse","অযুহাত তাদের"],["وَلَهُمُ","walahumu","and for them","আর তাদের জন্যে রয়েছে"],["ٱللَّعْنَةُ","l-la‘natu","(is) the curse","অভিশাপ"],["وَلَهُمْ","walahum","and for them","এবং তাদের জন্যে"],["سُوٓءُ","sūu","(is the) worst","নিকৃষ্ট"],["ٱلدَّارِ","l-dāri","home","আবাস (হবে জাহান্নাম)"]],"t":"يَوْمَ لَا يَ<k>نفَ</>عُ <h>ٱ</><l>ل</><m>ظَّٰ</>لِمِينَ مَعْذِرَتُهُمْ ۖ وَلَهُمُ <h>ٱ</><l>ل</>لَّعْنَةُ وَلَهُمْ <o>سُوٓ</>ءُ <h>ٱ</><l>ل</><p>دَّا</>رِ"},{"n":53,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["ءَاتَيْنَا","ātaynā","We gave","আমরা দিয়েছি"],["مُوسَى","mūsā","Musa","মূসাকে"],["ٱلْهُدَىٰ","l-hudā","the guidance","পথের দিশা"],["وَأَوْرَثْنَا","wa-awrathnā","and We caused to inherit","ও আমরা উত্তরাধিকারী করেছিলাম"],["بَنِىٓ","banī","(the) Children of Israel","সন্তানদেরকে"],["إِسْرَٰٓءِيلَ","is'rāīla","(the) Children of Israel","ইসরাঈলের"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","কিতাবের"]],"t":"وَلَقَ<q>دْ</> ءَاتَيْنَا مُوسَى <h>ٱ</>لْهُدَىٰ وَأَوْرَثْنَا بَ<o>نِىٓ</> إِسْ<o>رَٰٓ</>ءِيلَ <h>ٱ</>لْكِ<p>تَٰ</><q>بَ</>"},{"n":54,"w":[["هُدًۭى","hudan","A guide","পথ নির্দেশ"],["وَذِكْرَىٰ","wadhik'rā","and a reminder","ও উপদেশ স্বরূপ"],["لِأُو۟لِى","li-ulī","for those","সম্পন্নদের জন্যে"],["ٱلْأَلْبَـٰبِ","l-albābi","(of) understanding","বুদ্ধি-বিবেক"]],"t":"هُ<d>دًۭى وَ</>ذِكْرَىٰ لِأُ<s>و۟</>لِى <h>ٱ</>لْأَلْ<p>بَٰ</><q>بِ</>"},{"n":55,"w":[["فَٱصْبِرْ","fa-iṣ'bir","So be patient","সুতরাং ধৈর্য্য ধরো"],["إِنَّ","inna","indeed","নিশ্চয়ই"],["وَعْدَ","wa‘da","(the) Promise of Allah","প্রতিশ্রুতি"],["ٱللَّهِ","l-lahi","(the) Promise of Allah","আল্লাহর"],["حَقٌّۭ","ḥaqqun","(is) true","সত্য"],["وَٱسْتَغْفِرْ","wa-is'taghfir","And ask forgiveness","এবং ক্ষমা চাও"],["لِذَنۢبِكَ","lidhanbika","for your sin","তোমার পাপের জন্যে"],["وَسَبِّحْ","wasabbiḥ","and glorify","ও পবিত্রতা ঘোষণা করো"],["بِحَمْدِ","biḥamdi","(the) praise","প্রশংসাসহ"],["رَبِّكَ","rabbika","(of) your Lord","তোমার রবের"],["بِٱلْعَشِىِّ","bil-‘ashiyi","in the evening","সন্ধ্যাসমূহে"],["وَٱلْإِبْكَـٰرِ","wal-ib'kāri","and the morning","ও সকালসমূহে"]],"t":"فَ<h>ٱ</>صْبِرْ إِ<g>نَّ</> وَعْدَ <h>ٱ</>للَّهِ حَ<d>قٌّۭ وَ</><h>ٱ</>سْتَغْفِرْ لِذَ<i>نۢبِ</>كَ وَسَبِّحْ بِحَمْدِ رَبِّكَ بِ<h>ٱ</>لْعَشِىِّ وَ<h>ٱ</>لْإِ<q>بْ</><p>كَٰ</>رِ"},{"n":56,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["يُجَـٰدِلُونَ","yujādilūna","dispute","তর্ক করে"],["فِىٓ","fī","concerning","আছে"],["ءَايَـٰتِ","āyāti","(the) Signs","আয়াতসমূহে"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["بِغَيْرِ","bighayri","without","ব্যতীত"],["سُلْطَـٰنٍ","sul'ṭānin","any authority","কোনো প্রমাণ"],["أَتَىٰهُمْ ۙ","atāhum","(which) came to them","তাদের কাছে (যা) এসেছে"],["إِن","in","not","নেই"],["فِى","fī","(is) in","মধ্যে"],["صُدُورِهِمْ","ṣudūrihim","their breasts","তাদের অন্তরসমূহের"],["إِلَّا","illā","but","এ ব্যতীত"],["كِبْرٌۭ","kib'run","greatness","(বড়ত্বের) অহংকার"],["مَّا","mā","not","(যাতে) না"],["هُم","hum","they","তারা"],["بِبَـٰلِغِيهِ ۚ","bibālighīhi","(can) reach it","পৌঁছিবে"],["فَٱسْتَعِذْ","fa-is'ta‘idh","So seek refuge","সুতরাং আশ্রয় চাও"],["بِٱللَّهِ ۖ","bil-lahi","in Allah","আল্লাহর (কাছে)"],["إِنَّهُۥ","innahu","Indeed He","নিশ্চয়ই তিনি"],["هُوَ","huwa","He","তিনিই"],["ٱلسَّمِيعُ","l-samī‘u","(is) the All-Hearer","সবকিছু শুনেন"],["ٱلْبَصِيرُ","l-baṣīru","the All-Seer","সবকিছু দেখেন"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ يُ<m>جَٰ</>دِلُونَ <o>فِىٓ</> ءَا<m>يَٰ</>تِ <h>ٱ</>للَّهِ بِغَيْرِ سُلْ<m>طَٰ</>نٍ أَتَ<m>ىٰ</>هُمْ ۙ إِ<k>ن فِ</>ى صُدُورِهِمْ إِلَّا كِ<q>بْ</><d>رٌۭ مَّ</>ا <f>هُم بِ</><m>بَٰ</>لِغِيهِ ۚ فَ<h>ٱ</>سْتَعِذْ بِ<h>ٱ</>للَّهِ ۖ إِ<g>نَّ</>هُ<m>ۥ</> هُوَ <h>ٱ</><l>ل</>سَّمِيعُ <h>ٱ</>لْبَ<p>صِي</>رُ"},{"n":57,"w":[["لَخَلْقُ","lakhalqu","Surely, (the) creation","অবশ্যই সৃষ্টি"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশের"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীর"],["أَكْبَرُ","akbaru","(is) greater","অনেক কঠিন"],["مِنْ","min","than","চেয়েও"],["خَلْقِ","khalqi","(the) creation","সৃষ্টি"],["ٱلنَّاسِ","l-nāsi","(of) the mankind","মানুষের"],["وَلَـٰكِنَّ","walākinna","but","কিন্তু"],["أَكْثَرَ","akthara","most","অধিকাংশ"],["ٱلنَّاسِ","l-nāsi","(of) the people","মানুষই"],["لَا","lā","(do) not","না"],["يَعْلَمُونَ","ya‘lamūna","know","তারা জানে"]],"t":"لَخَلْقُ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ أَكْبَرُ مِنْ خَلْقِ <h>ٱ</><l>ل</><g>نَّ</>اسِ وَ<m>لَٰ</>كِ<g>نَّ</> أَكْثَرَ <h>ٱ</><l>ل</><g>نَّ</>اسِ لَا يَعْلَ<p>مُو</>نَ"},{"n":58,"w":[["وَمَا","wamā","And not","এবং না"],["يَسْتَوِى","yastawī","(are) equal","সমান হয়"],["ٱلْأَعْمَىٰ","l-a‘mā","the blind","অন্ধ"],["وَٱلْبَصِيرُ","wal-baṣīru","and the seeing","আর চক্ষুষ্মান"],["وَٱلَّذِينَ","wa-alladhīna","and those who","এবং যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["وَعَمِلُوا۟","wa‘amilū","and do","ও কাজ করেছে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","righteous deeds","সৎ (তারা)"],["وَلَا","walā","and not","আর না"],["ٱلْمُسِىٓءُ ۚ","l-musīu","the evildoer","দুষ্কৃতিকারীরা (সমান হয়)"],["قَلِيلًۭا","qalīlan","Little","(খুব) কমই"],["مَّا","mā","(is) what","যা"],["تَتَذَكَّرُونَ","tatadhakkarūna","you take heed","তোমরা উপদেশ গ্রহণ করো"]],"t":"وَمَا يَسْتَوِى <h>ٱ</>لْأَعْمَىٰ وَ<h>ٱ</>لْبَصِيرُ وَ<h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ وَلَا <h>ٱ</>لْمُ<o>سِىٓ</>ءُ ۚ قَلِيلًۭ<d>ا مَّ</>ا تَتَذَكَّ<p>رُو</>نَ"},{"n":59,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلسَّاعَةَ","l-sā‘ata","the Hour","ক্বিয়ামাত"],["لَـَٔاتِيَةٌۭ","laātiyatun","(is) surely coming","আসবে অবশ্যই"],["لَّا","lā","no","নেই"],["رَيْبَ","rayba","doubt","কোনো সন্দেহ"],["فِيهَا","fīhā","in it","তার মধ্যে"],["وَلَـٰكِنَّ","walākinna","but","কিন্তু"],["أَكْثَرَ","akthara","most","অধিকাংশ"],["ٱلنَّاسِ","l-nāsi","(of) the people","মানুষই"],["لَا","lā","(do) not","না"],["يُؤْمِنُونَ","yu'minūna","believe","ঈমান আনে"]],"t":"إِ<g>نَّ</> <h>ٱ</><l>ل</>سَّاعَةَ لَءَاتِيَ<w>ةٌۭ لَّ</>ا رَيْبَ فِيهَا وَ<m>لَٰ</>كِ<g>نَّ</> أَكْثَرَ <h>ٱ</><l>ل</><g>نَّ</>اسِ لَا يُؤْمِ<p>نُو</>نَ"},{"n":60,"w":[["وَقَالَ","waqāla","And said","এবং বলেন"],["رَبُّكُمُ","rabbukumu","your Lord","তোমাদের রব"],["ٱدْعُونِىٓ","id'‘ūnī","Call upon Me","\"তোমরা ডাকো আমাকে"],["أَسْتَجِبْ","astajib","I will respond","সাড়া দিবো আমি"],["لَكُمْ ۚ","lakum","to you","তোমাদেরকে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["يَسْتَكْبِرُونَ","yastakbirūna","(are) proud","অহংকার করে (বিমুখ থাকে)"],["عَنْ","‘an","to","হ'তে"],["عِبَادَتِى","‘ibādatī","worship Me","আমার ইবাদাত"],["سَيَدْخُلُونَ","sayadkhulūna","will enter","অবশ্যই তারা প্রবেশ করবে"],["جَهَنَّمَ","jahannama","Hell","জাহান্নামে"],["دَاخِرِينَ","dākhirīna","(in) humiliation","অপমানিত হয়ে\""]],"t":"وَقَالَ رَبُّكُمُ <h>ٱ</><q>دْ</>عُو<o>نِىٓ</> أَسْتَجِ<q>بْ</> لَكُمْ ۚ إِ<g>نَّ</> <h>ٱ</>لَّذِينَ يَسْتَكْبِرُونَ عَنْ عِبَادَتِى سَيَ<q>دْ</>خُلُونَ جَهَ<g>نَّ</>مَ دَاخِ<p>رِي</>نَ"},{"n":61,"w":[["ٱللَّهُ","al-lahu","Allah","(তিনিই) আল্লাহ"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["جَعَلَ","ja‘ala","made","সৃষ্টি করেছেন"],["لَكُمُ","lakumu","for you","তোমাদের জন্যে"],["ٱلَّيْلَ","al-layla","the night","রাতকে"],["لِتَسْكُنُوا۟","litaskunū","that you may rest","তোমরা যেন শান্তি পাও"],["فِيهِ","fīhi","in it","তার মধ্যে"],["وَٱلنَّهَارَ","wal-nahāra","and the day","এবং দিনকে"],["مُبْصِرًا ۚ","mub'ṣiran","giving visibility","উজ্জ্বল (বানিয়েছেন)"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَذُو","ladhū","(is) Full (of) Bounty","অবশ্যই"],["فَضْلٍ","faḍlin","(is) Full (of) Bounty","অনুগ্রহশীল"],["عَلَى","‘alā","to","উপর"],["ٱلنَّاسِ","l-nāsi","the people","মানুষের"],["وَلَـٰكِنَّ","walākinna","but","কিন্তু"],["أَكْثَرَ","akthara","most","অধিকাংশ"],["ٱلنَّاسِ","l-nāsi","(of) the people","মানুষই"],["لَا","lā","(do) not","না"],["يَشْكُرُونَ","yashkurūna","give thanks","তারা কৃতজ্ঞতা প্রকাশ করে"]],"t":"ٱللَّهُ <h>ٱ</>لَّذِى جَعَلَ لَكُمُ <h>ٱ</>لَّيْلَ لِتَسْكُنُو<s>ا۟</> فِيهِ وَ<h>ٱ</><l>ل</><g>نَّ</>هَارَ مُ<q>بْ</>صِرًا ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ لَذُو فَضْلٍ عَلَى <h>ٱ</><l>ل</><g>نَّ</>اسِ وَ<m>لَٰ</>كِ<g>نَّ</> أَكْثَرَ <h>ٱ</><l>ل</><g>نَّ</>اسِ لَا يَشْكُ<p>رُو</>نَ"},{"n":62,"w":[["ذَٰلِكُمُ","dhālikumu","That","তিনিই তোমাদের"],["ٱللَّهُ","l-lahu","(is) Allah","আল্লাহই"],["رَبُّكُمْ","rabbukum","your Lord","তোমাদের রব"],["خَـٰلِقُ","khāliqu","(the) Creator","স্রষ্টা"],["كُلِّ","kulli","(of) all","সব"],["شَىْءٍۢ","shayin","things","কিছুর"],["لَّآ","lā","(there is) no","নেই"],["إِلَـٰهَ","ilāha","god","কোনো ইলাহ"],["إِلَّا","illā","except","ছাড়া"],["هُوَ ۖ","huwa","Him","তিনি"],["فَأَنَّىٰ","fa-annā","So how","তাহ'লে কোথায়"],["تُؤْفَكُونَ","tu'fakūna","are you deluded","তোমাদের ফিরানো হচ্ছে"]],"t":"<m>ذَٰ</>لِكُمُ <h>ٱ</>للَّهُ رَبُّكُمْ <m>خَٰ</>لِقُ كُلِّ <w>شَىْءٍۢ لَّ</><o>آ</> إِ<m>لَٰ</>هَ إِل