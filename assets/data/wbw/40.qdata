,{"n":65,"w":[["هُوَ","huwa","He","তিনি"],["ٱلْحَىُّ","l-ḥayu","(is) the Ever-Living","চিরঞ্জীব"],["لَآ","lā","(there is) no","নেই"],["إِلَـٰهَ","ilāha","god","কোনো ইলাহ"],["إِلَّا","illā","but","ছাড়া"],["هُوَ","huwa","He","তিনি"],["فَٱدْعُوهُ","fa-id'‘ūhu","so call Him","সুতরাং তাঁকেই ডাকো"],["مُخْلِصِينَ","mukh'liṣīna","(being) sincere","একনিষ্ঠ হয়ে"],["لَهُ","lahu","to Him","তাঁরই জন্যে"],["ٱلدِّينَ ۗ","l-dīna","(in) the religion","আনুগত্যকে (নির্দিষ্ট করে)"],["ٱلْحَمْدُ","l-ḥamdu","All praise (be)","সব প্রশংসা"],["لِلَّهِ","lillahi","to Allah","আল্লাহর জন্যে"],["رَبِّ","rabbi","(the) Lord","রব"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","(of) the worlds","বিশ্বজগতের"]],"t":"هُوَ <h>ٱ</>لْحَىُّ <o>لَآ</> إِ<m>لَٰ</>هَ إِلَّا هُوَ فَ<h>ٱ</><q>دْ</>عُوهُ مُخْلِصِينَ لَهُ <h>ٱ</><l>ل</>دِّينَ ۗ <h>ٱ</>لْحَمْدُ لِلَّهِ رَبِّ <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":66,"w":[["۞ قُلْ","qul","Say","(হে নাবী) বলো"],["إِنِّى","innī","Indeed, I","\"নিশ্চয়ই আমাকে"],["نُهِيتُ","nuhītu","[I] have been forbidden","নিষেধ করা হয়েছে"],["أَنْ","an","to","যেন (না)"],["أَعْبُدَ","a‘buda","worship","ইবাদত করি আমি"],["ٱلَّذِينَ","alladhīna","those whom","(তাদেরকে) যাদের"],["تَدْعُونَ","tad‘ūna","you call","তোমরা ডাকো"],["مِن","min","besides","মধ্য হতে"],["دُونِ","dūni","besides","ছাড়া"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["لَمَّا","lammā","when","যখন"],["جَآءَنِىَ","jāaniya","have come to me","আমার কাছে এসেছে"],["ٱلْبَيِّنَـٰتُ","l-bayinātu","the clear proofs","সুস্পষ্ট নিদর্শন"],["مِن","min","from","থেকে"],["رَّبِّى","rabbī","my Lord","আমার রবের"],["وَأُمِرْتُ","wa-umir'tu","and I am commanded","এবং আমাকে আদেশ করা হয়েছে"],["أَنْ","an","to","যে"],["أُسْلِمَ","us'lima","submit","আত্মসমর্পণ করি আমি"],["لِرَبِّ","lirabbi","to (the) Lord","রবের কাছে"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","(of) the worlds","বিশ্বজগতের"]],"t":"۞ قُلْ إِ<g>نِّ</>ى نُهِيتُ أَنْ أَعْبُدَ <h>ٱ</>لَّذِينَ تَ<q>دْ</>عُونَ مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ لَ<g>مَّ</>ا <o>جَآ</>ءَنِىَ <h>ٱ</>لْبَيِّ<m>نَٰ</>تُ <w>مِن رَّ</>