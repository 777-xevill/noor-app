{"n":40,"a":[{"n":1,"w":[["حمٓ","hha-meem","Ha Meem","হা-মীম"]],"t":"ح<n>مٓ</>"},{"n":2,"w":[["تَنزِيلُ","tanzīlu","(The) revelation","অবতীর্ণ করা"],["ٱلْكِتَـٰبِ","l-kitābi","(of) the Book","(এই) কিতাব"],["مِنَ","mina","(is) from","পক্ষ হ'তে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["ٱلْعَزِيزِ","l-‘azīzi","the All-Mighty","(যিনি) পরাক্রমশালী"],["ٱلْعَلِيمِ","l-‘alīmi","the All-Knower","সর্বজ্ঞ"]],"t":"تَ<k>نزِ</>يلُ <h>ٱ</>لْكِ<m>تَٰ</>بِ مِنَ <h>ٱ</>للَّهِ <h>ٱ</>لْعَزِيزِ <h>ٱ</>لْعَ<p>لِي</>مِ"},{"n":3,"w":[["غَافِرِ","ghāfiri","(The) Forgiver","(যিনি) ক্ষমাকারী"],["ٱلذَّنۢبِ","l-dhanbi","(of) the sin","পাপ"],["وَقَابِلِ","waqābili","and (the) Acceptor","এবং কবুলকারী"],["ٱلتَّوْبِ","l-tawbi","(of) [the] repentance","তওবা"],["شَدِيدِ","shadīdi","severe","কঠোর"],["ٱلْعِقَابِ","l-‘iqābi","(in) the punishment","শাস্তিদানে"],["ذِى","dhī","Owner (of) the abundance","মালিক"],["ٱلطَّوْلِ ۖ","l-ṭawli","Owner (of) the abundance","অনুগ্রহের"],["لَآ","lā","(There is) no","নেই"],["إِلَـٰهَ","ilāha","god","কোনো ইলাহ"],["إِلَّا","illā","except","ছাড়া"],["هُوَ ۖ","huwa","Him","তিনি"],["إِلَيْهِ","ilayhi","to Him","তাঁরই দিকে"],["ٱلْمَصِيرُ","l-maṣīru","(is) the final return","প্রত্যাবর্তন (হবে সকলের)"]],"t":"غَافِرِ <h>ٱ</><l>ل</>ذَّ<i>نۢبِ</> وَقَابِلِ <h>ٱ</><l>ل</>تَّوْبِ شَدِيدِ <h>ٱ</>لْعِقَابِ ذِى <h>ٱ</><l>ل</>طَّوْلِ ۖ <o>لَآ</> إِ<m>لَٰ</>هَ إِلَّا هُوَ ۖ إِلَيْهِ <h>ٱ</>لْمَ<p>صِي</>رُ"},{"n":4,"w":[["مَا","mā","Not","না"],["يُجَـٰدِلُ","yujādilu","dispute","তর্ক করে"],["فِىٓ","fī","concerning","ক্ষেত্রে"],["ءَايَـٰتِ","āyāti","(the) Verses","নিদর্শনাবলীর"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["إِلَّا","illā","except","এ ব্যতীত"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieve","অস্বীকার করেছে"],["فَلَا","falā","so (let) not","সুতরাং না (যেন)"],["يَغْرُرْكَ","yaghrur'ka","deceive you","তোমাকে বিভ্রান্ত করে"],["تَقَلُّبُهُمْ","taqallubuhum","their movement","তাদের বিচরণ"],["فِى","fī","in","মধ্যে"],["ٱلْبِلَـٰدِ","l-bilādi","the cities","দেশে-বিদেশে"]],"t":"مَا يُ<m>جَٰ</>دِلُ <o>فِىٓ</> ءَا<m>يَٰ</>تِ <h>ٱ</>للَّهِ إِلَّا <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> فَلَا يَغْرُرْكَ تَقَلُّبُهُمْ فِى <h>ٱ</>لْبِ<p>لَٰ</><q>دِ</>"},{"n":5,"w":[["كَذَّبَتْ","kadhabat","Denied","মিথ্যারোপ করেছিলো"],["قَبْلَهُمْ","qablahum","before them","তাদের পূর্বে"],["قَوْمُ","qawmu","(the) people","জাতি"],["نُوحٍۢ","nūḥin","(of) Nuh","নূহের"],["وَٱلْأَحْزَابُ","wal-aḥzābu","and the factions","এবং (অন্যান্য) দলসমূহও"],["مِنۢ","min","after them","মধ্য হতে"],["بَعْدِهِمْ ۖ","ba‘dihim","after them","পরে তাদের"],["وَهَمَّتْ","wahammat","and plotted","এবং অভিসন্ধি করেছিলো"],["كُلُّ","kullu","every","প্রত্যেক"],["أُمَّةٍۭ","ummatin","nation","জাতি"],["بِرَسُولِهِمْ","birasūlihim","against their Messenger","তাদের রাসূলের সম্পর্কে"],["لِيَأْخُذُوهُ ۖ","liyakhudhūhu","to seize him","তাকে পাকড়াও করার জন্যে"],["وَجَـٰدَلُوا۟","wajādalū","and they disputed","এবং তারা যুক্তিতর্কে মত্তে ছিলো"],["بِٱلْبَـٰطِلِ","bil-bāṭili","by falsehood","অসার (অস্ত্র) দিয়ে"],["لِيُدْحِضُوا۟","liyud'ḥiḍū","to refute","ব্যর্থ করে দেয়ার জন্যে"],["بِهِ","bihi","thereby","তা দিয়ে"],["ٱلْحَقَّ","l-ḥaqa","the truth","সত্যকে"],["فَأَخَذْتُهُمْ ۖ","fa-akhadhtuhum","So I seized them","ফলে আমি পাকড়াও করেছি তাদেরকে"],["فَكَيْفَ","fakayfa","Then how","সুতরাং (দেখো) কেমন"],["كَانَ","kāna","was","ছিলো"],["عِقَابِ","‘iqābi","My penalty","আমার শাস্তি"]],"t":"كَذَّبَتْ قَ<q>بْ</>لَهُمْ قَوْمُ نُو<d>حٍۢ وَ</><h>ٱ</>لْأَحْزَابُ <i>مِنۢ بَ</>عْدِهِمْ ۖ وَهَ<g>مَّ</>تْ كُلُّ أُ<g>مَّ</><i>ةٍۭ بِ</>رَسُولِهِمْ لِيَأْخُذُوهُ ۖ وَ<m>جَٰ</>دَلُو<s>ا۟</> بِ<h>ٱ</>لْ<m>بَٰ</>طِلِ لِيُ<q>دْ</>حِضُو<s>ا۟</> بِهِ <h>ٱ</>لْحَقَّ فَأَخَذْتُهُمْ ۖ فَكَيْفَ كَانَ عِ<p>قَا</><q>بِ</>"},{"n":6,"w":[["وَكَذَٰلِكَ","wakadhālika","And thus","এবং এরূপে"],["حَقَّتْ","ḥaqqat","has been justified","সত্য হলো"],["كَلِمَتُ","kalimatu","(the) Word","বাণী"],["رَبِّكَ","rabbika","(of) your Lord","তোমার রবের"],["عَلَى","‘alā","against","উপর"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["كَفَرُوٓا۟","kafarū","disbelieved","অস্বীকার করেছিলো"],["أَنَّهُمْ","annahum","that they","তারা যে"],["أَصْحَـٰبُ","aṣḥābu","(are) companions","অধিবাসী"],["ٱلنَّارِ","l-nāri","(of) the Fire","জাহান্নামের"]],"t":"وَكَ<m>ذَٰ</>لِكَ حَقَّتْ كَلِمَتُ رَبِّكَ عَلَى <h>ٱ</>لَّذِينَ كَفَ<o>رُوٓ</><s>ا۟</> أَ<g>نَّ</>هُمْ أَصْ<m>حَٰ</>بُ <h>ٱ</><l>ل</><g>نَّ</><p>ا</>رِ"},{"n":7,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["يَحْمِلُونَ","yaḥmilūna","bear","ধারণ করছে"],["ٱلْعَرْشَ","l-‘arsha","the Throne","(আল্লাহর) আরশ"],["وَمَنْ","waman","and who","এবং যারা (আছে)"],["حَوْلَهُۥ","ḥawlahu","(are) around it","তার চার পাশে"],["يُسَبِّحُونَ","yusabbiḥūna","glorify","তারা মহিমা ঘোষণা করছে"],["بِحَمْدِ","biḥamdi","(the) praises","প্রশংসাসহ"],["رَبِّهِمْ","rabbihim","(of) their Lord","তাদের রবের"],["وَيُؤْمِنُونَ","wayu'minūna","and believe","এবং তারা ঈমান রাখে"],["بِهِۦ","bihi","in Him","তাঁর উপর"],["وَيَسْتَغْفِرُونَ","wayastaghfirūna","and ask forgiveness","এবং তারা ক্ষমা প্রার্থনা করছে"],["لِلَّذِينَ","lilladhīna","for those who","(তাদের) জন্যে যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান আনে"],["رَبَّنَا","rabbanā","Our Lord","\"(তারা বলে) হে আমাদের রব"],["وَسِعْتَ","wasi‘'ta","You encompass","তুমি ঘিরে রেখেছো"],["كُلَّ","kulla","all","প্রত্যেক"],["شَىْءٍۢ","shayin","things","জিনিস"],["رَّحْمَةًۭ","raḥmatan","(by Your) Mercy","অনুগ্রহে"],["وَعِلْمًۭا","wa‘il'man","and knowledge","ও জ্ঞানে"],["فَٱغْفِرْ","fa-igh'fir","so forgive","তাই মাফ করো"],["لِلَّذِينَ","lilladhīna","those who","(তাদের)-কে যারা"],["تَابُوا۟","tābū","repent","তওবা করে"],["وَٱتَّبَعُوا۟","wa-ittaba‘ū","and follow","ও অনুসরণ করে"],["سَبِيلَكَ","sabīlaka","Your Way","তোমার পথ"],["وَقِهِمْ","waqihim","and save them (from)","এবং তাদেরকে বাঁচাও"],["عَذَابَ","‘adhāba","(the) punishment","শাস্তি (হ'তে)"],["ٱلْجَحِيمِ","l-jaḥīmi","(of) the Hellfire","জাহান্নামের"]],"t":"ٱلَّذِينَ يَحْمِلُونَ <h>ٱ</>لْعَرْشَ وَمَنْ حَوْلَهُ<m>ۥ</> يُسَبِّحُونَ بِحَمْدِ رَبِّهِمْ وَيُؤْمِنُونَ بِ<m>هِۦ</> وَيَسْتَغْفِرُونَ لِلَّذِينَ ءَامَنُو<s>ا۟</> رَبَّنَا وَسِعْتَ كُلَّ <w>شَىْءٍۢ رَّ</>حْمَ<d>ةًۭ وَ</>عِلْ<k>مًۭا فَ</><h>ٱ</>غْفِرْ لِلَّذِينَ تَابُو<s>ا۟</> وَ<h>ٱ</>تَّبَعُو<s>ا۟</> سَبِيلَكَ وَقِهِمْ عَذَابَ <h>ٱ</>لْجَ<p>حِي</>مِ"},{"n":8,"w":[["رَبَّنَا","rabbanā","Our Lord","হে আমাদের রব"],["وَأَدْخِلْهُمْ","wa-adkhil'hum","And admit them","এবং তাদের প্রবেশ করাও"],["جَنَّـٰتِ","jannāti","(to) Gardens","জান্নাত সমূহে"],["عَدْنٍ","‘adnin","(of) Eden","চিরস্থায়ী"],["ٱلَّتِى","allatī","which","যা"],["وَعَدتَّهُمْ","wa‘adttahum","You have promised them","তাদের তুমি প্রতিশ্রুতি দিয়েছো"],["وَمَن","waman","and whoever","এবং যারা"],["صَلَحَ","ṣalaḥa","(was) righteous","সৎকর্ম করেছে"],["مِنْ","min","among","মধ্যে হ'তে"],["ءَابَآئِهِمْ","ābāihim","their fathers","তাদের বাপ-দাদাদের"],["وَأَزْوَٰجِهِمْ","wa-azwājihim","and their spouses","ও তাদের পতি-পত্নীদের"],["وَذُرِّيَّـٰتِهِمْ ۚ","wadhurriyyātihim","and their offspring","ও তাদের বংশধরদের"],["إِنَّكَ","innaka","Indeed You","তুমি নিশ্চয়ই"],["أَنتَ","anta","You","তুমিই"],["ٱلْعَزِيزُ","l-‘azīzu","(are) the All-Mighty","পরাক্রমশালী"],["ٱلْحَكِيمُ","l-ḥakīmu","the All-Wise","প্রজ্ঞাময়"]],"t":"رَبَّنَا وَأَ<q>دْ</>خِلْهُمْ جَ<g>نَّٰ</>تِ عَ<q>دْ</>نٍ <h>ٱ</>لَّتِى وَعَ<j>د</>تَّهُمْ وَمَ<k>ن صَ</>لَحَ مِنْ ءَا<o>بَآ</>ئِهِمْ وَأَزْ<m>وَٰ</>جِهِمْ وَذُرِّ<m>يَّٰ</>تِهِمْ ۚ إِ<g>نَّ</>كَ أَ<k>نتَ</> <h>ٱ</>لْعَزِيزُ <h>ٱ</>لْحَ<p>كِي</>مُ"},{"n":9,"w":[["وَقِهِمُ","waqihimu","And protect them","এবং বাঁচাও তাদেরকে"],["ٱلسَّيِّـَٔاتِ ۚ","l-sayiāti","(from) the evils","(সব) মন্দ (হ'তে)"],["وَمَن","waman","And whoever","এবং যাকে"],["تَقِ","taqi","you protect","বাঁচাবে"],["ٱلسَّيِّـَٔاتِ","l-sayiāti","(from) the evils","(সব) মন্দ (হ'তে)"],["يَوْمَئِذٍۢ","yawma-idhin","that Day","সেদিন"],["فَقَدْ","faqad","then verily","তাহ'লে নিশ্চয়ই"],["رَحِمْتَهُۥ ۚ","raḥim'tahu","You have bestowed mercy on him","তাকে অনুগ্রহ করবে"],["وَذَٰلِكَ","wadhālika","And that","এবং এটা"],["هُوَ","huwa","[it]","সেই"],["ٱلْفَوْزُ","l-fawzu","(is) the success","সাফল্য"],["ٱلْعَظِيمُ","l-‘aẓīmu","the great","মহা\""]],"t":"وَقِهِمُ <h>ٱ</><l>ل</>سَّيِّـَٔاتِ ۚ وَمَ<k>ن تَ</>قِ <h>ٱ</><l>ل</>سَّيِّـَٔاتِ يَوْمَئِ<k>ذٍۢ فَ</>قَ<q>دْ</> رَحِمْتَهُ<m>ۥ</> ۚ وَ<m>ذَٰ</>لِكَ هُوَ <h>ٱ</>لْفَوْزُ <h>ٱ</>لْعَ<p>ظِي</>مُ"},{"n":10,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieved","অস্বীকার করেছে"],["يُنَادَوْنَ","yunādawna","will be cried out to them","তাদের ডেকে বলা হবে"],["لَمَقْتُ","lamaqtu","Certainly Allah's hatred","ক্ষোভ অবশ্যই (ছিলো)"],["ٱللَّهِ","l-lahi","Certainly Allah's hatred","আল্লাহর"],["أَكْبَرُ","akbaru","(was) greater","অধিক (সেদিন)"],["مِن","min","than","চেয়ে"],["مَّقْتِكُمْ","maqtikum","your hatred","তোমাদের (আজকের) ক্ষোভের"],["أَنفُسَكُمْ","anfusakum","(of) yourselves","তোমাদের নিজেদের (উপর)"],["إِذْ","idh","when","যখন"],["تُدْعَوْنَ","tud'‘awna","you were called","তোমাদের ডাকা হতো"],["إِلَى","ilā","to","দিকে"],["ٱلْإِيمَـٰنِ","l-īmāni","the faith","ঈমানের"],["فَتَكْفُرُونَ","fatakfurūna","and you disbelieved","তখন তোমরা অস্বীকার করতে"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> يُنَادَوْنَ لَمَ<q>قْ</>تُ <h>ٱ</>للَّهِ أَكْبَرُ <d>مِن مَّ</><q>قْ</>تِكُمْ أَ<k>نفُ</>سَكُمْ إِذْ تُ<q>دْ</>عَوْنَ إِلَى <h>ٱ</>لْإِي<m>مَٰ</>نِ فَتَكْفُ<p>رُو</>نَ"},{"n":11,"w":[["قَالُوا۟","qālū","They (will) say","তারা বলবে"],["رَبَّنَآ","rabbanā","Our Lord","\"হে আমাদের রব"],["أَمَتَّنَا","amattanā","You gave us death","আমাদেরকে তুমি  মৃত্যু দিয়েছো"],["ٱثْنَتَيْنِ","ith'natayni","twice","দু'বার"],["وَأَحْيَيْتَنَا","wa-aḥyaytanā","and You gave us life","ও আমাদেরকে তুমি জীবন দিয়েছো"],["ٱثْنَتَيْنِ","ith'natayni","twice","দু'বার"],["فَٱعْتَرَفْنَا","fa-i‘'tarafnā","and we confess","আমরা স্বীকার করছি এখন"],["بِذُنُوبِنَا","bidhunūbinā","our sins","আমাদের পাপসমূহকে"],["فَهَلْ","fahal","So is (there)","এখন কি  (আছে)"],["إِلَىٰ","ilā","to","দিকে"],["خُرُوجٍۢ","khurūjin","get out","বের হওয়ার (পরিত্রাণের)"],["مِّن","min","any","কোনো"],["سَبِيلٍۢ","sabīlin","way","পথ\""]],"t":"قَالُو<s>ا۟</> رَبَّ<o>نَآ</> أَمَتَّنَا <h>ٱ</>ثْنَتَيْنِ وَأَحْيَيْتَنَا <h>ٱ</>ثْنَتَيْنِ فَ<h>ٱ</>عْتَرَفْنَا بِذُنُوبِنَا فَهَلْ إِلَىٰ خُرُو<d>جٍۢ مِّ</><k>ن سَ</><p>بِي</>لٍۢ"},{"n":12,"w":[["ذَٰلِكُم","dhālikum","That","\"(বলা হবে) তোমাদের এ (অবস্থা)"],["بِأَنَّهُۥٓ","bi-annahu","(is) because","এ কারণে যে"],["إِذَا","idhā","when","যখন"],["دُعِىَ","du‘iya","Allah was invoked","ডাকা হতো"],["ٱللَّهُ","l-lahu","Allah was invoked","আল্লাহর (দিকে)"],["وَحْدَهُۥ","waḥdahu","Alone","তাঁর একত্বের (প্রতি)"],["كَفَرْتُمْ ۖ","kafartum","you disbelieved","তোমরা অস্বীকার করতে"],["وَإِن","wa-in","but if","এবং যদি"],["يُشْرَكْ","yush'rak","(others) were associated","শরিক করা হতো"],["بِهِۦ","bihi","with Him","তাঁর সাথে (অন্য কাউকে)"],["تُؤْمِنُوا۟ ۚ","tu'minū","you believed","তোমরা ঈমান আনতে"],["فَٱلْحُكْمُ","fal-ḥuk'mu","So the judgment","বস্তুতঃ কর্তৃত্ব"],["لِلَّهِ","lillahi","(is) with Allah","আল্লাহরই"],["ٱلْعَلِىِّ","l-‘aliyi","the Most High","(যিনি) সমুচ্চ"],["ٱلْكَبِيرِ","l-kabīri","the Most Great","মহান\""]],"t":"<m>ذَٰ</>لِ<f>كُم بِ</>أَ<g>نَّ</>هُ<o>ۥٓ</> إِذَا دُعِىَ <h>ٱ</>للَّهُ وَحْدَهُ<m>ۥ</> كَفَرْتُمْ ۖ وَ<d>إِن يُ</>شْرَكْ بِ<m>هِۦ</> تُؤْمِنُو<s>ا۟ ۚ</> فَ<h>ٱ</>لْحُكْمُ لِلَّهِ <h>ٱ</>لْعَلِىِّ <h>ٱ</>لْكَ<p>بِي</>رِ"},{"n":13,"w":[["هُوَ","huwa","He","তিনিই (আল্লাহ)"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["يُرِيكُمْ","yurīkum","shows you","তোমাদেরকে দেখান"],["ءَايَـٰتِهِۦ","āyātihi","His Signs","নিদর্শনাবলী তাঁর"],["وَيُنَزِّلُ","wayunazzilu","and sends down","ও নামান"],["لَكُم","lakum","for you","তোমাদের জন্যে"],["مِّنَ","mina","from","হ'তে"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশ"],["رِزْقًۭا ۚ","riz'qan","provision","জীবনের উপকরণ"],["وَمَا","wamā","But (does) not","এবং না"],["يَتَذَكَّرُ","yatadhakkaru","take heed","শিক্ষাগ্রহণ করে"],["إِلَّا","illā","except","এ ব্যতীত"],["مَن","man","(one) who","যে"],["يُنِيبُ","yunību","turns","মুখ করে (আল্লাহর দিকে)"]],"t":"هُوَ <h>ٱ</>لَّذِى يُرِيكُمْ ءَا<m>يَٰتِهِۦ</> وَيُنَزِّلُ لَ<y>كُم مِّ</>نَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ رِزْ<d>قًۭا ۚ وَ</>مَا يَتَذَكَّرُ إِلَّا <d>مَن يُ</><p>نِي</><q>بُ</>"},{"n":14,"w":[["فَٱدْعُوا۟","fa-id'‘ū","So invoke","সুতরাং তোমরা ডাকো"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["مُخْلِصِينَ","mukh'liṣīna","(being) sincere","একনিষ্ঠ হয়ে"],["لَهُ","lahu","to Him","তাঁরই জন্যে"],["ٱلدِّينَ","l-dīna","(in) the religion","আনুগত্যকে (নির্দিষ্ট করে)"],["وَلَوْ","walaw","even though","এবং যদিও"],["كَرِهَ","kariha","dislike (it)","অপছন্দ করে"],["ٱلْكَـٰفِرُونَ","l-kāfirūna","the disbelievers","কাফেররা"]],"t":"فَ<h>ٱ</><q>دْ</>عُو<s>ا۟</> <h>ٱ</>للَّهَ مُخْلِصِينَ لَهُ <h>ٱ</><l>ل</>دِّينَ وَلَوْ كَرِهَ <h>ٱ</>لْ<m>كَٰ</>فِ<p>رُو</>نَ"},{"n":15,"w":[["رَفِيعُ","rafī‘u","Possessor of the Highest Ranks","সমুচ্চ"],["ٱلدَّرَجَـٰتِ","l-darajāti","Possessor of the Highest Ranks","মর্যাদাসমুহের (অধিকারী)"],["ذُو","dhū","Owner (of) the Throne","অধিপতি"],["ٱلْعَرْشِ","l-‘arshi","Owner (of) the Throne","আরশের"],["يُلْقِى","yul'qī","He places","প্রেরণ করেন"],["ٱلرُّوحَ","l-rūḥa","the inspiration","রূহকে (অর্থাৎ ওহী)"],["مِنْ","min","of","মধ্য হতে"],["أَمْرِهِۦ","amrihi","His Command","তাঁর নির্দেশে"],["عَلَىٰ","‘alā","upon","উপর"],["مَن","man","whom","যাকে"],["يَشَآءُ","yashāu","He wills","ইচ্ছে করেন"],["مِنْ","min","of","মধ্য হ'তে"],["عِبَادِهِۦ","‘ibādihi","His slaves","তাঁর দাসদের"],["لِيُنذِرَ","liyundhira","to warn","যেন সতর্ক করে"],["يَوْمَ","yawma","(of the) Day","দিন (সম্পর্ক)"],["ٱلتَّلَاقِ","l-talāqi","(of) the Meeting","সাক্ষাতের"]],"t":"رَفِيعُ <h>ٱ</><l>ل</>دَّرَ<m>جَٰ</>تِ ذُو <h>ٱ</>لْعَرْشِ يُلْقِى <h>ٱ</><l>ل</>رُّوحَ مِنْ أَمْرِ<m>هِۦ</> عَلَىٰ <d>مَن يَ</><o>شَآ</>ءُ مِنْ عِبَادِ<m>هِۦ</> لِيُ<k>نذِ</>رَ يَوْمَ <h>ٱ</><l>ل</>تَّ<p>لَا</><q>قِ</>"},{"n":16,"w":[["يَوْمَ","yawma","(The) Day","সেদিন"],["هُم","hum","they","তারা"],["بَـٰرِزُونَ ۖ","bārizūna","come forth","বের হয়ে পড়বে"],["لَا","lā","not","না"],["يَخْفَىٰ","yakhfā","is hidden","গোপন থাকবে"],["عَلَى","‘alā","from","কাছে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["مِنْهُمْ","min'hum","about them","তাদের মধ্যে হ'তে"],["شَىْءٌۭ ۚ","shayon","anything","কোনো কিছুই"],["لِّمَنِ","limani","For whom","(জিজ্ঞেস করা হবে) কার"],["ٱلْمُلْكُ","l-mul'ku","(is) the Dominion","কর্তৃত্ব"],["ٱلْيَوْمَ ۖ","l-yawma","this Day","আজ"],["لِلَّهِ","lillahi","For Allah","(সবাই বলবে) আল্লাহরই"],["ٱلْوَٰحِدِ","l-wāḥidi","the One","(যিনি) এক ও একক"],["ٱلْقَهَّارِ","l-qahāri","the Irresistible","পরাক্রমশালী"]],"t":"يَوْمَ <f>هُم بَٰ</>رِزُونَ ۖ لَا يَخْفَىٰ عَلَى <h>ٱ</>للَّهِ مِنْهُمْ <w>شَىْءٌۭ ۚ لِّ</>مَنِ <h>ٱ</>لْمُلْكُ <h>ٱ</>لْيَوْمَ ۖ لِلَّهِ <h>ٱ</>لْ<m>وَٰ</>حِدِ <h>ٱ</>لْقَ<p>هَّا</>رِ"},{"n":17,"w":[["ٱلْيَوْمَ","al-yawma","This Day","(বলা হবে) আজ"],["تُجْزَىٰ","tuj'zā","will be recompensed","প্রতিফল দেওয়া হবে"],["كُلُّ","kullu","every","প্রত্যেক"],["نَفْسٍۭ","nafsin","soul","ব্যক্তিকে"],["بِمَا","bimā","for what","ঐ বিষয়ের যা"],["كَسَبَتْ ۚ","kasabat","it earned","সে কামাই করেছে"],["لَا","lā","No","নেই"],["ظُلْمَ","ẓul'ma","injustice","অত্যাচার"],["ٱلْيَوْمَ ۚ","l-yawma","today","আজ"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["سَرِيعُ","sarī‘u","(is) Swift","তৎপর"],["ٱلْحِسَابِ","l-ḥisābi","(in) Account","হিসাব গ্রহণে"]],"t":"ٱلْيَوْمَ تُ<q>جْ</>زَىٰ كُلُّ نَفْ<i>سٍۭ بِ</>مَا كَسَبَتْ ۚ لَا ظُلْمَ <h>ٱ</>لْيَوْمَ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ سَرِيعُ <h>ٱ</>لْحِ<p>سَا</><q>بِ</>"},{"n":18,"w":[["وَأَنذِرْهُمْ","wa-andhir'hum","And warn them","এবং (হে নাবী) তাদেরকে সতর্ক করো"],["يَوْمَ","yawma","(of the) Day","সেই দিন (সম্পর্কে)"],["ٱلْـَٔازِفَةِ","l-āzifati","the Approaching","(যা) আসন্ন"],["إِذِ","idhi","when","যখন"],["ٱلْقُلُوبُ","l-qulūbu","the hearts","অন্তরসমূহ (কলিজাসমূহ)"],["لَدَى","ladā","(are) at","নিকট (আসবে)"],["ٱلْحَنَاجِرِ","l-ḥanājiri","the throats","কন্ঠসমূহের"],["كَـٰظِمِينَ ۚ","kāẓimīna","choked","দুঃখ-কষ্টে"],["مَا","mā","Not","না"],["لِلظَّـٰلِمِينَ","lilẓẓālimīna","for the wrongdoers","সীমালঙ্ঘনকারীদের জন্যে (থাকবে)"],["مِنْ","min","any","কোনো"],["حَمِيمٍۢ","ḥamīmin","intimate friend","অন্তরঙ্গ"],["وَلَا","walā","and no","আর না"],["شَفِيعٍۢ","shafī‘in","intercessor","কোনো সুপারিশকারী"],["يُطَاعُ","yuṭā‘u","(who) is obeyed","মেনে নেওয়া হবে (যার কথা)"]],"t":"وَأَ<k>نذِ</>رْهُمْ يَوْمَ <h>ٱ</>لْءَازِفَةِ إِذِ <h>ٱ</>لْقُلُوبُ لَدَى <h>ٱ</>لْحَنَاجِرِ <m>كَٰ</>ظِمِينَ ۚ مَا لِل<m>ظَّٰ</>لِمِينَ مِنْ حَمِي<d>مٍۢ وَ</>لَا شَفِي<d>عٍۢ يُ</><p>طَا</>عُ"},{"n":19,"w":[["يَعْلَمُ","ya‘lamu","He knows","(আল্লাহ) জানেন"],["خَآئِنَةَ","khāinata","(the) stealthy glance","প্রতারণা"],["ٱلْأَعْيُنِ","l-a‘yuni","(the) stealthy glance","চোখের (অর্থাৎ চোখের চুরিও)"],["وَمَا","wamā","and what","এবং যা"],["تُخْفِى","tukh'fī","conceal","গোপন করে রাখে"],["ٱلصُّدُورُ","l-ṣudūru","the breasts","অন্তরসমূহ"]],"t":"يَعْلَمُ <o>خَآ</>ئِنَةَ <h>ٱ</>لْأَعْيُنِ وَمَا تُخْفِى <h>ٱ</><l>ل</>صُّ<p>دُو</>رُ"},{"n":20,"w":[["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["يَقْضِى","yaqḍī","judges","মীমাংসা করবেন"],["بِٱلْحَقِّ ۖ","bil-ḥaqi","in truth","সঠিকভাবে"],["وَٱلَّذِينَ","wa-alladhīna","while those (whom)","এবং যাদেরকে"],["يَدْعُونَ","yad‘ūna","they invoke","তারা ডাকে"],["مِن","min","besides Him","ছাড়া"],["دُونِهِۦ","dūnihi","besides Him","তাঁকে"],["لَا","lā","not","না"],["يَقْضُونَ","yaqḍūna","they judge","মীমাংসা করবে তারা"],["بِشَىْءٍ ۗ","bishayin","with anything","কোনো কিছুরই"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah ","আল্লাহ"],["هُوَ","huwa","He","তিনিই"],["ٱلسَّمِيعُ","l-samī‘u","(is) the All-Hearer","সবকিছু শুনেন"],["ٱلْبَصِيرُ","l-baṣīru","the All-Seer","সবকিছু দেখেন"]],"t":"وَ<h>ٱ</>للَّهُ يَ<q>قْ</>ضِى بِ<h>ٱ</>لْحَقِّ ۖ وَ<h>ٱ</>لَّذِينَ يَ<q>دْ</>عُونَ مِ<k>ن دُ</>ونِ<m>هِۦ</> لَا يَ<q>قْ</>ضُونَ بِشَىْءٍ ۗ إِ<g>نَّ</> <h>ٱ</>للَّهَ هُوَ <h>ٱ</><l>ل</>سَّمِيعُ <h>ٱ</>لْبَ<p>صِي</>رُ"},{"n":21,"w":[["۞ أَوَلَمْ","awalam","Do not","কি নি"],["يَسِيرُوا۟","yasīrū","they travel","তারা ভ্রমণ করে"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["فَيَنظُرُوا۟","fayanẓurū","and see","তাহ'লে তারা দেখতে পেতো"],["كَيْفَ","kayfa","how","কেমন"],["كَانَ","kāna","was","ছিলো"],["عَـٰقِبَةُ","‘āqibatu","(the) end","পরিণাম"],["ٱلَّذِينَ","alladhīna","(of) those who","(তাদের) যারা"],["كَانُوا۟","kānū","were","ছিলো"],["مِن","min","before them","মধ্য হতে"],["قَبْلِهِمْ ۚ","qablihim","before them","তাদের পূর্বে"],["كَانُوا۟","kānū","They were","ছিলো"],["هُمْ","hum","[they]","তারা"],["أَشَدَّ","ashadda","superior","প্রবল"],["مِنْهُمْ","min'hum","to them","এদের চেয়েও"],["قُوَّةًۭ","quwwatan","(in) strength","শক্তিতে"],["وَءَاثَارًۭا","waāthāran","and (in) impressions","ও কীর্তিসমূহে"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the land","পৃথিবীর"],["فَأَخَذَهُمُ","fa-akhadhahumu","but Allah seized them","তাদেরকে অতঃপর পাকড়াও করলেন"],["ٱللَّهُ","l-lahu","but Allah seized them","আল্লাহ"],["بِذُنُوبِهِمْ","bidhunūbihim","for their sins","তাদের পাপসমূহের কারণে"],["وَمَا","wamā","and not","এবং না"],["كَانَ","kāna","was","ছিলো"],["لَهُم","lahum","for them","তাদের জন্যে"],["مِّنَ","mina","against","হ'তে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["مِن","min","any","কোনো"],["وَاقٍۢ","wāqin","protector","রক্ষাকারী"]],"t":"۞ أَوَلَمْ يَسِيرُو<s>ا۟</> فِى <h>ٱ</>لْأَرْضِ فَيَ<k>نظُ</>رُو<s>ا۟</> كَيْفَ كَانَ <m>عَٰ</>قِبَةُ <h>ٱ</>لَّذِينَ كَانُو<s>ا۟</> مِ<k>ن قَ</><q>بْ</>لِهِمْ ۚ كَانُو<s>ا۟</> هُمْ أَشَدَّ مِنْهُمْ قُوَّ<d>ةًۭ وَ</>ءَاثَا<k>رًۭا فِ</>ى <h>ٱ</>لْأَرْضِ فَأَخَذَهُمُ <h>ٱ</>للَّهُ بِذُنُوبِهِمْ وَمَا كَانَ لَ<y>هُم مِّ</>نَ <h>ٱ</>للَّهِ <d>مِن وَ</><p>ا</><q>قٍۢ</>"},{"n":22,"w":[["ذَٰلِكَ","dhālika","That","এটা"],["بِأَنَّهُمْ","bi-annahum","(was) because [they]","এ কারণে যে তারা"],["كَانَت","kānat","used to come to them","কাছে আসতো"],["تَّأْتِيهِمْ","tatīhim","used to come to them","তাদের"],["رُسُلُهُم","rusuluhum","their Messengers","তাদের রাসূলগণ"],["بِٱلْبَيِّنَـٰتِ","bil-bayināti","with clear proofs","নিদর্শনাবলীসহ"],["فَكَفَرُوا۟","fakafarū","but they disbelieved","কিন্তু তারা অস্বীকার করতো"],["فَأَخَذَهُمُ","fa-akhadhahumu","So Allah seized them","তখন তাদেরকে শাস্তি দিলেন"],["ٱللَّهُ ۚ","l-lahu","So Allah seized them","আল্লাহ"],["إِنَّهُۥ","innahu","Indeed, He","তিনি নিশ্চয়ই"],["قَوِىٌّۭ","qawiyyun","(is) All-Strong","শক্তিশালী"],["شَدِيدُ","shadīdu","severe","কঠোর"],["ٱلْعِقَابِ","l-‘iqābi","(in) punishment","শাস্তিদানে"]],"t":"<m>ذَٰ</>لِكَ بِأَ<g>نَّ</>هُمْ كَانَت تَّأْتِيهِمْ رُسُلُ<f>هُم بِ</><h>ٱ</>لْبَيِّ<m>نَٰ</>تِ فَكَفَرُو<s>ا۟</> فَأَخَذَهُمُ <h>ٱ</>للَّهُ ۚ إِ<g>نَّ</>هُ<m>ۥ</> قَوِ<k>ىٌّۭ شَ</>دِيدُ <h>ٱ</>لْعِ<p>قَا</><q>بِ</>"},{"n":23,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["أَرْسَلْنَا","arsalnā","We sent","আমরা পাঠিয়েছি"],["مُوسَىٰ","mūsā","Musa","মূসাকে"],["بِـَٔايَـٰتِنَا","biāyātinā","with Our Signs","আমাদের নিদর্শনাবলীসহ"],["وَسُلْطَـٰنٍۢ","wasul'ṭānin","and an authority","ও প্রমাণ (সহ)"],["مُّبِينٍ","mubīnin","clear","সুস্পষ্ট"]],"t":"وَلَقَ<q>دْ</> أَرْسَلْنَا مُوسَىٰ بِـَٔا<m>يَٰ</>تِنَا وَسُلْ<m>طَٰ</><d>نٍۢ مُّ</><p>بِي</>نٍ"},{"n":24,"w":[["إِلَىٰ","ilā","To","নিকটে"],["فِرْعَوْنَ","fir'‘awna","Firaun","ফিরআউনের"],["وَهَـٰمَـٰنَ","wahāmāna","Haman","ও হামানের"],["وَقَـٰرُونَ","waqārūna","and Qarun","ও কারূনের"],["فَقَالُوا۟","faqālū","but they said","তারা কিন্তু বলেছিলো"],["سَـٰحِرٌۭ","sāḥirun","A magician","\"(সে একজন) যাদুকর"],["كَذَّابٌۭ","kadhābun","a liar","মিথ্যাবাদী\""]],"t":"إِلَىٰ فِرْعَوْنَ وَ<m>هَٰمَٰ</>نَ وَ<m>قَٰ</>رُونَ فَقَالُو<s>ا۟</> <m>سَٰ</>حِ<k>رٌۭ كَ</><p>ذَّا</><q>بٌۭ</>"},{"n":25,"w":[["فَلَمَّا","falammā","Then when","পরে যখন"],["جَآءَهُم","jāahum","he brought to them","তাদের কাছে নিয়ে এলো"],["بِٱلْحَقِّ","bil-ḥaqi","the truth","প্রকৃত সত্যসহ"],["مِنْ","min","from","হ'তে"],["عِندِنَا","‘indinā","Us","আমাদের নিকট"],["قَالُوا۟","qālū","they said","তারা বললো"],["ٱقْتُلُوٓا۟","uq'tulū","Kill","\"তোমরা হত্যা করো"],["أَبْنَآءَ","abnāa","(the) sons","পুত্র সন্তানদেরকে"],["ٱلَّذِينَ","alladhīna","(of) those who","(তাদের) যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["مَعَهُۥ","ma‘ahu","with him","তার সাথে"],["وَٱسْتَحْيُوا۟","wa-is'taḥyū","and let live","এবং তোমরা জীবিত রাখো"],["نِسَآءَهُمْ ۚ","nisāahum","their women","তাদের নারীদেরকে\""],["وَمَا","wamā","And not","এবং নয়"],["كَيْدُ","kaydu","(is the) plot","ষড়যন্ত্র"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","(of) the disbelievers","কাফেরদের"],["إِلَّا","illā","but","এ ব্যতীত"],["فِى","fī","in","মধ্যে"],["ضَلَـٰلٍۢ","ḍalālin","error","ভ্রান্তির"]],"t":"فَلَ<g>مَّ</>ا <o>جَآ</>ءَ<f>هُم بِ</><h>ٱ</>لْحَقِّ مِنْ عِ<k>ندِ</>نَا قَالُو<s>ا۟</> <h>ٱ</><q>قْ</>تُ<o>لُوٓ</><s>ا۟</> أَ<q>بْ</><o>نَآ</>ءَ <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> مَعَهُ<m>ۥ</> وَ<h>ٱ</>سْتَحْيُو<s>ا۟</> نِ<o>سَآ</>ءَهُمْ ۚ وَمَا كَيْدُ <h>ٱ</>لْ<m>كَٰ</>فِرِينَ إِلَّا فِى ضَ<p>لَٰ</>لٍۢ"},{"n":26,"w":[["وَقَالَ","waqāla","And said","এবং বললো"],["فِرْعَوْنُ","fir'‘awnu","Firaun","ফিরআউন"],["ذَرُونِىٓ","dharūnī","Leave me","\"আমাকে ছাড়ো"],["أَقْتُلْ","aqtul","(so that) I kill","আমি হত্যা করে ফেলি"],["مُوسَىٰ","mūsā","Musa","মূসাকে"],["وَلْيَدْعُ","walyad‘u","and let him call","এবং সে ডাকে যেন"],["رَبَّهُۥٓ ۖ","rabbahu","his Lord","তাঁর রবকে"],["إِنِّىٓ","innī","Indeed, I","নিশ্চয়ই আমি"],["أَخَافُ","akhāfu","[I] fear","আমি আশংকা করি"],["أَن","an","that","যে"],["يُبَدِّلَ","yubaddila","he will change","সে পাল্টে দিবে"],["دِينَكُمْ","dīnakum","your religion","তোমাদের ধর্মকে"],["أَوْ","aw","or","অথবা"],["أَن","an","that","যে"],["يُظْهِرَ","yuẓ'hira","he may cause to appear","সৃষ্টি করবে"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the land","দেশের"],["ٱلْفَسَادَ","l-fasāda","the corruption","বিপর্যয়\""]],"t":"وَقَالَ فِرْعَوْنُ ذَرُو<o>نِىٓ</> أَ<q>قْ</>تُلْ مُوسَىٰ وَلْيَ<q>دْ</>عُ رَبَّهُ<o>ۥٓ ۖ</> إِ<g>نِّ</><o>ىٓ</> أَخَافُ <d>أَن يُ</>بَدِّلَ دِينَكُمْ أَوْ <d>أَن يُ</>ظْهِرَ فِى <h>ٱ</>لْأَرْضِ <h>ٱ</>لْفَ<p>سَا</><q>دَ</>"},{"n":27,"w":[["وَقَالَ","waqāla","And said","এবং বললো"],["مُوسَىٰٓ","mūsā","Musa","মূসা"],["إِنِّى","innī","Indeed, I","\"নিশ্চয়ই আমি"],["عُذْتُ","‘udh'tu","[I] seek refuge","আমি আশ্রয় চাই"],["بِرَبِّى","birabbī","in my Lord","আমার রবের কাছে"],["وَرَبِّكُم","warabbikum","and your Lord","ও তোমাদের রবের (কাছে)"],["مِّن","min","from","হ'তে"],["كُلِّ","kulli","every","প্রত্যেক"],["مُتَكَبِّرٍۢ","mutakabbirin","arrogant one","অহংকারী ব্যক্তি"],["لَّا","lā","not","(যে) না"],["يُؤْمِنُ","yu'minu","who believes","বিশ্বাস করে"],["بِيَوْمِ","biyawmi","(in the) Day","দিনের প্রতি"],["ٱلْحِسَابِ","l-ḥisābi","(of) the Account","বিচারের\""]],"t":"وَقَالَ مُوسَ<o>ىٰٓ</> إِ<g>نِّ</>ى عُذْتُ بِرَبِّى وَرَبِّ<y>كُم مِّ</><k>ن كُ</>لِّ مُتَكَبِّ<w>رٍۢ لَّ</>ا يُؤْمِنُ بِيَوْمِ <h>ٱ</>لْحِ<p>سَا</><q>بِ</>"},{"n":28,"w":[["وَقَالَ","waqāla","And said","এবং বললো"],["رَجُلٌۭ","rajulun","a man","এক ব্যক্তি"],["مُّؤْمِنٌۭ","mu'minun","believing","মু'মিন"],["مِّنْ","min","from","মধ্যে হ'তে"],["ءَالِ","āli","(the) family","সম্প্রদায়ের"],["فِرْعَوْنَ","fir'‘awna","(of) Firaun","ফিরআউনের"],["يَكْتُمُ","yaktumu","who conceal(ed)","যে গোপন রেখেছিলো"],["إِيمَـٰنَهُۥٓ","īmānahu","his faith","তার ঈমান"],["أَتَقْتُلُونَ","ataqtulūna","Will you kill","\"তোমরা হত্যা করবে কি"],["رَجُلًا","rajulan","a man","এক ব্যক্তিকে"],["أَن","an","because","(এ কারণে) যে"],["يَقُولَ","yaqūla","he says","সে বলে"],["رَبِّىَ","rabbiya","My Lord","\"আমার রব"],["ٱللَّهُ","l-lahu","(is) Allah","আল্লাহ\""],["وَقَدْ","waqad","and indeed","অথচ নিশ্চয়ই"],["جَآءَكُم","jāakum","he has brought you","তোমাদের কাছে এসেছে"],["بِٱلْبَيِّنَـٰتِ","bil-bayināti","clear proofs","সুস্পষ্ট প্রমাণ নিয়ে"],["مِن","min","from","পক্ষ হ'তে"],["رَّبِّكُمْ ۖ","rabbikum","your Lord","তোমাদের রবের"],["وَإِن","wa-in","And if","এবং যদি"],["يَكُ","yaku","he is","সে হয়"],["كَـٰذِبًۭا","kādhiban","a liar","মিথ্যাবাদী"],["فَعَلَيْهِ","fa‘alayhi","then upon him","তবে তার উপর (বর্তিবে)"],["كَذِبُهُۥ ۖ","kadhibuhu","(is) his lie","তার মিথ্যার দায়"],["وَإِن","wa-in","and if","কিন্তু যদি"],["يَكُ","yaku","he is","সে হয়"],["صَادِقًۭا","ṣādiqan","truthful","সত্যবাদী"],["يُصِبْكُم","yuṣib'kum","(there) will strike you","তোমাদের উপর আপতিত হবে"],["بَعْضُ","ba‘ḍu","some (of)","(তার) কিছু"],["ٱلَّذِى","alladhī","(that) which","যা"],["يَعِدُكُمْ ۖ","ya‘idukum","he threatens you","তোমাদেরকে সে ভয় দেখাচ্ছে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَا","lā","(does) not","না"],["يَهْدِى","yahdī","guide","পথ দেখান"],["مَنْ","man","(one) who","(এমন) কাউকে"],["هُوَ","huwa","[he]","যে"],["مُسْرِفٌۭ","mus'rifun","(is) a transgressor","সীমালংঘনকারী"],["كَذَّابٌۭ","kadhābun","a liar","ডাহা মিথ্যাবাদী"]],"t":"وَقَالَ رَجُ<d>لٌۭ مُّ</>ؤْمِ<d>نٌۭ مِّ</>نْ ءَالِ فِرْعَوْنَ يَكْتُمُ إِي<m>مَٰ</>نَهُ<o>ۥٓ</> أَتَ<q>قْ</>تُلُونَ رَجُلًا <d>أَن يَ</>قُولَ رَبِّىَ <h>ٱ</>للَّهُ وَقَ<q>دْ</> <o>جَآ</>ءَ<f>كُم بِ</><h>ٱ</>لْبَيِّ<m>نَٰ</>تِ <w>مِن رَّ</>بِّكُمْ ۖ وَ<d>إِن يَ</>كُ <m>كَٰ</>ذِ<k>بًۭا فَ</>عَلَيْهِ كَذِبُهُ<m>ۥ</> ۖ وَ<d>إِن يَ</>كُ صَادِ<d>قًۭا يُ</>صِ<q>بْ</><f>كُم بَ</>عْضُ <h>ٱ</>لَّذِى يَعِدُكُمْ ۖ إِ<g>نَّ</> <h>ٱ</>للَّهَ لَا يَهْدِى مَنْ هُوَ مُسْرِ<k>فٌۭ كَ</><p>ذَّا</><q>بٌۭ</>"},{"n":29,"w":[["يَـٰقَوْمِ","yāqawmi","O my people","হে আমার জাতি"],["لَكُمُ","lakumu","For you","তোমাদেরই"],["ٱلْمُلْكُ","l-mul'ku","(is) the kingdom","রাজত্ব"],["ٱلْيَوْمَ","l-yawma","today","আজ"],["ظَـٰهِرِينَ","ẓāhirīna","dominant","তোমরা বিজয়ী"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the land","দেশের"],["فَمَن","faman","but who","কিন্তু কে"],["يَنصُرُنَا","yanṣurunā","will help us","আমাদেরকে সাহায্য করবে"],["مِنۢ","min","from","হ'তে"],["بَأْسِ","basi","(the) punishment","শাস্তি"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["إِن","in","if","যদি"],["جَآءَنَا ۚ","jāanā","it came to us","আমাদের উপর (তা) আসে\""],["قَالَ","qāla","Said","বললো"],["فِرْعَوْنُ","fir'‘awnu","Firaun","ফিরআউন"],["مَآ","mā","Not","\"না"],["أُرِيكُمْ","urīkum","I show you","তোমাদেরকে মতামত দিচ্ছি"],["إِلَّا","illā","except","এ ব্যতীত"],["مَآ","mā","what","যা"],["أَرَىٰ","arā","I see","আমি ভালো মনে করি"],["وَمَآ","wamā","and not","আর না"],["أَهْدِيكُمْ","ahdīkum","I guide you","তোমাদেরকে আমি পরিচালনা করছি"],["إِلَّا","illā","except","এ ব্যতীত"],["سَبِيلَ","sabīla","(to the) path","পথে"]