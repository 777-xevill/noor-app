{"n":68,"a":[{"n":1,"w":[["نٓ ۚ","noon","Nun","নুন"],["وَٱلْقَلَمِ","wal-qalami","By the pen","কলমের শপথ"],["وَمَا","wamā","and what","এবং যা"],["يَسْطُرُونَ","yasṭurūna","they write","তারা লিখছে"]],"t":"<n>نٓ</> ۚ وَ<h>ٱ</>لْقَلَمِ وَمَا يَسْطُ<p>رُو</>نَ"},{"n":2,"w":[["مَآ","mā","Not","না"],["أَنتَ","anta","you (are)","তুমি"],["بِنِعْمَةِ","bini‘'mati","by (the) Grace","অনুগ্রহে"],["رَبِّكَ","rabbika","(of) your Lord","তোমার রবের"],["بِمَجْنُونٍۢ","bimajnūnin","a madman","পাগল"]],"t":"<o>مَآ</> أَ<k>نتَ</> بِنِعْمَةِ رَبِّكَ بِمَ<q>جْ</><p>نُو</>نٍۢ"},{"n":3,"w":[["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়"],["لَكَ","laka","for you","তোমার জন্য"],["لَأَجْرًا","la-ajran","surely (is) a reward","অবশ্যই(আছে) পুরস্কার"],["غَيْرَ","ghayra","without","ছাড়া"],["مَمْنُونٍۢ","mamnūnin","end","শেষ"]],"t":"وَإِ<g>نَّ</> لَكَ لَأَ<q>جْ</>رًا غَيْرَ مَمْ<p>نُو</>نٍۢ"},{"n":4,"w":[["وَإِنَّكَ","wa-innaka","And indeed, you","এবং তুমি নিশ্চয়"],["لَعَلَىٰ","la‘alā","surely (are)","উপর অবশ্যই(অথিষ্ঠিত)"],["خُلُقٍ","khuluqin","(of) a moral character","চরিত্রের"],["عَظِيمٍۢ","‘aẓīmin","great","মহান"]],"t":"وَإِ<g>نَّ</>كَ لَعَلَىٰ خُلُقٍ عَ<p>ظِي</>مٍۢ"},{"n":5,"w":[["فَسَتُبْصِرُ","fasatub'ṣiru","So you will see","অতএব তুমি শীঘ্রই দেখবে"],["وَيُبْصِرُونَ","wayub'ṣirūna","and they will see","এবং তারা দেখবে,"]],"t":"فَسَتُ<q>بْ</>صِرُ وَيُ<q>بْ</>صِ<p>رُو</>نَ"},{"n":6,"w":[["بِأَييِّكُمُ","bi-ayyikumu","Which of you","তোমাদের মধ্যে কে"],["ٱلْمَفْتُونُ","l-maftūnu","(is) the afflicted one","বিকারগ্রস্ত"]],"t":"بِأَييِّكُمُ <h>ٱ</>لْمَفْ<p>تُو</>نُ"},{"n":7,"w":[["إِنَّ","inna","Indeed","নিশ্চয়"],["رَبَّكَ","rabbaka","your Lord","তোমার রব,"],["هُوَ","huwa","He","তিনিই"],["أَعْلَمُ","a‘lamu","(is) most knowing","সব জানেন"],["بِمَن","biman","of (he) who","কে"],["ضَلَّ","ḍalla","has strayed","ভ্রষ্ট হয়েছে"],["عَن","‘an","from","থেকে"],["سَبِيلِهِۦ","sabīlihi","His way","তার পথ,"],["وَهُوَ","wahuwa","and He","এবং তিনিই"],["أَعْلَمُ","a‘lamu","(is) most knowing","সব জানেন"],["بِٱلْمُهْتَدِينَ","bil-muh'tadīna","of the guided ones","পথ প্রাপ্তদেরকে"]],"t":"إِ<g>نَّ</> رَبَّكَ هُوَ أَعْلَمُ بِمَ<k>ن ضَ</>لَّ عَ<k>ن سَ</>بِيلِ<m>هِۦ</> وَهُوَ أَعْلَمُ بِ<h>ٱ</>لْمُهْتَ<p>دِي</>نَ"},{"n":8,"w":[["فَلَا","falā","So (do) not","না অতএব"],["تُطِعِ","tuṭi‘i","obey","মেনো"],["ٱلْمُكَذِّبِينَ","l-mukadhibīna","the deniers","মিথ্যারোপকারীদের।"]],"t":"فَلَا تُطِعِ <h>ٱ</>لْمُكَذِّ<p>بِي</>نَ"},{"n":9,"w":[["وَدُّوا۟","waddū","They wish","তারা চাই"],["لَوْ","law","that","যদি"],["تُدْهِنُ","tud'hinu","you should compromise","তুমি নমনীয় হও"],["فَيُدْهِنُونَ","fayud'hinūna","so they would compromise","তবে তারা নমনীয় হবে"]],"t":"وَدُّو<s>ا۟</> لَوْ تُ<q>دْ</>هِنُ فَيُ<q>دْ</>هِ<p>نُو</>نَ"},{"n":10,"w":[["وَلَا","walā","And (do) not","এবং না"],["تُطِعْ","tuṭi‘","obey","অনুসরণ করে!"],["كُلَّ","kulla","every","প্রত্যেক"],["حَلَّافٍۢ","ḥallāfin","habitual swearer","অত্যাধিক শপথকারী"],["مَّهِينٍ","mahīnin","worthless","গুরুত্বহীন(ব্যক্তির)"]],"t":"وَلَا تُطِعْ كُلَّ حَلَّا<d>فٍۢ مَّ</><p>هِي</>نٍ"},{"n":11,"w":[["هَمَّازٍۢ","hammāzin","Defamer","নিন্দাকারী"],["مَّشَّآءٍۭ","mashāin","going about","ঘুরে বেড়াই"],["بِنَمِيمٍۢ","binamīmin","with malicious gossip","চোগলখুরীসহ"]],"t":"هَ<g>مَّ</>ا<d>زٍۢ مَّ</><o>شَّآ</><i>ءٍۭ بِ</>نَ<p>مِي</>مٍۢ"},{"n":12,"w":[["مَّنَّاعٍۢ","mannā‘in","A preventer","প্রতিবন্ধক,"],["لِّلْخَيْرِ","lil'khayri","of (the) good","কল্যানের জন্য"],["مُعْتَدٍ","mu‘'tadin","transgressor","সীমালংঘণকারী,"],["أَثِيمٍ","athīmin","sinful","পাপিষ্ঠ"]],"t":"مَّ<g>نَّ</>ا<w>عٍۢ لِّ</>لْخَيْرِ مُعْتَدٍ أَ<p>ثِي</>مٍ"},{"n":13,"w":[["عُتُلٍّۭ","‘utullin","Cruel","নিষ্ঠুর,"],["بَعْدَ","ba‘da","after","পরে"],["ذَٰلِكَ","dhālika","(all) that","এর"],["زَنِيمٍ","zanīmin","utterly useless","(এ কারণে) বদজাতও"]],"t":"عُتُ<i>لٍّۭ بَ</>عْدَ <m>ذَٰ</>لِكَ زَ<p>نِي</>مٍ"},{"n":14,"w":[["أَن","an","Because","যে"],["كَانَ","kāna","(he) is","সেছিলো"],["ذَا","dhā","a possessor","অধিকারী"],["مَالٍۢ","mālin","(of) wealth","মালের(ধন-সম্পদের)"],["وَبَنِينَ","wabanīna","and children","এবং সন্তানসন্ততির"]],"t":"أَ<k>ن كَ</>انَ ذَا مَا<d>لٍۢ وَ</>بَ<p>نِي</>نَ"},{"n":15,"w":[["إِذَا","idhā","When","যখন"],["تُتْلَىٰ","tut'lā","are recited","আবৃত্তি করা হয়"],["عَلَيْهِ","‘alayhi","to him","তার নিকট"],["ءَايَـٰتُنَا","āyātunā","Our Verses","আমাদের আয়াতগুলো,"],["قَالَ","qāla","he says","সে বলে,"],["أَسَـٰطِيرُ","asāṭīru","Stories","\"গল্পকাহিনী সমুহ"],["ٱلْأَوَّلِينَ","l-awalīna","(of) the former (people)","আগেরকালের(লোকদের)\""]],"t":"إِذَا تُتْلَىٰ عَلَيْهِ ءَا<m>يَٰ</>تُنَا قَالَ أَ<m>سَٰ</>طِيرُ <h>ٱ</>لْأَوَّ<p>لِي</>نَ"},{"n":16,"w":[["سَنَسِمُهُۥ","sanasimuhu","We will brand him","তাকে দাগাব শিঘ্র"],["عَلَى","‘alā","on","উপর"],["ٱلْخُرْطُومِ","l-khur'ṭūmi","the snout","শুড়ের"]],"t":"سَنَسِمُهُ<m>ۥ</> عَلَى <h>ٱ</>لْخُرْ<p>طُو</>مِ"},{"n":17,"w":[["إِنَّا","innā","Indeed, We","নিশ্চয়,আমরা"],["بَلَوْنَـٰهُمْ","balawnāhum","have tried them","তাদের পরীক্ষায় ফেলেছি"],["كَمَا","kamā","as","যেমন"],["بَلَوْنَآ","balawnā","We tried","আমরা পরীক্ষা করেছিলাম"],["أَصْحَـٰبَ","aṣḥāba","(the) companions","মালিকদের"],["ٱلْجَنَّةِ","l-janati","(of) the garden","বাগানটির"],["إِذْ","idh","when","যখন"],["أَقْسَمُوا۟","aqsamū","they swore","তারা শপথ করেছিল"],["لَيَصْرِمُنَّهَا","layaṣrimunnahā","to pluck its fruit","তারা অবশ্যই তা কাটবে(পাড়িবে)"],["مُصْبِحِينَ","muṣ'biḥīna","(in the) morning","সকাল(হতে)"]],"t":"إِ<g>نَّ</>ا بَلَوْ<m>نَٰ</>هُمْ كَمَا بَلَوْ<o>نَآ</> أَصْ<m>حَٰ</>بَ <h>ٱ</>لْجَ<g>نَّ</>ةِ إِذْ أَ<q>قْ</>سَمُو<s>ا۟</> لَيَصْرِمُ<g>نَّ</>هَا مُصْبِ<p>حِي</>نَ"},{"n":18,"w":[["وَلَا","walā","And not","এবং না"],["يَسْتَثْنُونَ","yastathnūna","making exception","তারা ব্যাতিক্রম রাখলো"]],"t":"وَلَا يَسْتَثْ<p>نُو</>نَ"},{"n":19,"w":[["فَطَافَ","faṭāfa","So there came","অতএব বিপদ আসলো"],["عَلَيْهَا","‘alayhā","upon it","তার উপর"],["طَآئِفٌۭ","ṭāifun","a visitation","বিপদ"],["مِّن","min","from","থেকে"],["رَّبِّكَ","rabbika","your Lord","তোমার রবের,"],["وَهُمْ","wahum","while they","এবং তারা(ছিল)"],["نَآئِمُونَ","nāimūna","were asleep","ঘুমন্ত অবস্থায়"]],"t":"فَطَافَ عَلَيْهَا <o>طَآ</>ئِ<d>فٌۭ مِّ</><w>ن رَّ</>بِّكَ وَهُمْ <o>نَآ</>ئِ<p>مُو</>نَ"},{"n":20,"w":[["فَأَصْبَحَتْ","fa-aṣbaḥat","So it became","ফলে হয়ে গেল"],["كَٱلصَّرِيمِ","kal-ṣarīmi","as if reaped","কর্তিত ফসলের মত"]],"t":"فَأَصْبَحَتْ كَ<h>ٱ</><l>ل</>صَّ<p>رِي</>مِ"},{"n":21,"w":[["فَتَنَادَوْا۟","fatanādaw","And they called one another","অতঃপর পরস্পরে ডাকলো"],["مُصْبِحِينَ","muṣ'biḥīna","(at) morning","সকাল(হতে)"]],"t":"فَتَنَادَوْ<s>ا۟</> مُصْبِ<p>حِي</>نَ"},{"n":22,"w":[["أَنِ","ani","That","যে"],["ٱغْدُوا۟","igh'dū","Go early","\"সকালে চলো"],["عَلَىٰ","‘alā","to","দিকে"],["حَرْثِكُمْ","ḥarthikum","your crop","তোমাদের ক্ষেতের"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you would","তোমরা হও"],["صَـٰرِمِينَ","ṣārimīna","pluck (the) fruit","ফসল কর্তনকারী\""]],"t":"أَنِ <h>ٱ</>غْدُو<s>ا۟</> عَلَىٰ حَرْثِكُمْ إِ<k>ن كُنتُ</>مْ <m>صَٰ</>رِ<p>مِي</>نَ"},{"n":23,"w":[["فَٱنطَلَقُوا۟","fa-inṭalaqū","So they went","অতঃপর তারা চললো"],["وَهُمْ","wahum","while they","এবং তারা"],["يَتَخَـٰفَتُونَ","yatakhāfatūna","lowered (their) voices","নিচু স্বরে বলছিল"]],"t":"فَ<h>ٱ</><k>نطَ</>لَقُو<s>ا۟</> وَهُمْ يَتَ<m>خَٰ</>فَ<p>تُو</>نَ"},{"n":24,"w":[["أَن","an","That","যে"],["لَّا","lā","Not","\"না"],["يَدْخُلَنَّهَا","yadkhulannahā","will enter it","এতে নিশ্চয়ই প্রবেশ করবে"],["ٱلْيَوْمَ","l-yawma","today","আজ"],["عَلَيْكُم","‘alaykum","upon you","তোমাদের কাছে"],["مِّسْكِينٌۭ","mis'kīnun","any poor person","ভিখারী\""]],"t":"<w>أَن لَّ</>ا يَ<q>دْ</>خُلَ<g>نَّ</>هَا <h>ٱ</>لْيَوْمَ عَلَيْ<y>كُم مِّ</>سْ<p>كِي</>نٌۭ"},{"n":25,"w":[["وَغَدَوْا۟","waghadaw","And they went early","এবং তারা চললো"],["عَلَىٰ","‘alā","with","ব্যাপারে(যেন)"],["حَرْدٍۢ","ḥardin","determination","নিবৃত্ত করার"],["قَـٰدِرِينَ","qādirīna","able","সক্ষম"]],"t":"وَغَدَوْ<s>ا۟</> عَلَىٰ حَرْ<k>دٍۢ قَٰ</>دِ<p>رِي</>نَ"},{"n":26,"w":[["فَلَمَّا","falammā","But when","কিন্তু যখন"],["رَأَوْهَا","ra-awhā","they saw it","তারা তা দেখলো"],["قَالُوٓا۟","qālū","they said","তারা বলল,"],["إِنَّا","innā","Indeed, we","\"নিশ্চয় আমরা"],["لَضَآلُّونَ","laḍāllūna","(are) surely lost","অবশ্যই পথভ্রষ্ট"]],"t":"فَلَ<g>مَّ</>ا رَأَوْهَا قَا<o>لُوٓ</><s>ا۟</> إِ<g>نَّ</>ا لَ<n>ضَآ</><p>لُّو</>نَ"},{"n":27,"w":[["بَلْ","bal","Nay","বরং"],["نَحْنُ","naḥnu","We","আমরা"],["مَحْرُومُونَ","maḥrūmūna","(are) deprived","বঞ্চিত\""]],"t":"بَلْ نَحْنُ مَحْرُو<p>مُو</>نَ"},{"n":28,"w":[["قَالَ","qāla","Said","বললো"],["أَوْسَطُهُمْ","awsaṭuhum","(the) most moderate of them","তাদের শ্রেষ্ঠ ব্যাক্তি"],["أَلَمْ","alam","Did not","\"নাই কি"],["أَقُل","aqul","I tell","আমি বলি"],["لَّكُمْ","lakum","you","তোমাদেরকে"],["لَوْلَا","lawlā","'Why not","না কেন"],["تُسَبِّحُونَ","tusabbiḥūna","you glorify (Allah)?'","তোমরা তসবিহ করো"]],"t":"قَالَ أَوْسَطُهُمْ أَلَمْ أَقُل لَّكُمْ لَوْلَا تُسَبِّ<p>حُو</>نَ"},{"n":29,"w":[["قَالُوا۟","qālū","They said","তারা বললো"],["سُبْحَـٰنَ","sub'ḥāna","Glory be","\"পবিত্র"],["رَبِّنَآ","rabbinā","(to) our Lord","আমাদের রব"],["إِنَّا","innā","Indeed, we","নিশ্চিত"],["كُنَّا","kunnā","[we] were","(আমরা)ছিলাম"],["ظَـٰلِمِينَ","ẓālimīna","wrongdoers","যালেম\""]],"t":"قَالُو<s>ا۟</> سُ<q>بْ</><m>حَٰ</>نَ رَبِّ<o>نَآ</> إِ<g>نَّ</>ا كُ<g>نَّ</>ا <m>ظَٰ</>لِ<p>مِي</>نَ"},{"n":30,"w":[["فَأَقْبَلَ","fa-aqbala","Then approached","অতএব তারা মুখোমুখি হলো"],["بَعْضُهُمْ","ba‘ḍuhum","some of them","তাদের একে"],["عَلَىٰ","‘alā","to","প্রতি"],["بَعْضٍۢ","ba‘ḍin","others","অপরের"],["يَتَلَـٰوَمُونَ","yatalāwamūna","blaming each other","তিরস্কার করতে লাগলো"]],"t":"فَأَ<q>قْ</>بَلَ بَعْضُهُمْ عَلَىٰ بَعْ<d>ضٍۢ يَ</>تَ<m>لَٰ</>وَ<p>مُو</>نَ"},{"n":31,"w":[["قَالُوا۟","qālū","They said","তারা বললো"],["يَـٰوَيْلَنَآ","yāwaylanā","O woe to us","\"আমাদের আফসোস"],["إِنَّا","innā","Indeed, we","আমরা নিশ্চয়"],["كُنَّا","kunnā","[we] were","ছিলাম"],["طَـٰغِينَ","ṭāghīna","transgressors","সিমালংঘনকারী"]],"t":"قَالُو<s>ا۟</> <m>يَٰ</>وَيْلَ<o>نَآ</> إِ<g>نَّ</>ا كُ<g>نَّ</>ا <m>طَٰ</><p>غِي</>نَ"},{"n":32,"w":[["عَسَىٰ","‘asā","Perhaps","সম্ভবত"],["رَبُّنَآ","rabbunā","our Lord","আমাদের রব"],["أَن","an","[that]","দেবেন"],["يُبْدِلَنَا","yub'dilanā","will substitute for us","আমাদের বদলে"],["خَيْرًۭا","khayran","a better","উত্তম"],["مِّنْهَآ","min'hā","than it","তা হতেও"],["إِنَّآ","innā","Indeed, we","আমরা নিশ্চত"],["إِلَىٰ","ilā","to","দিকে"],["رَبِّنَا","rabbinā","our Lord","আমাদের রবের"],["رَٰغِبُونَ","rāghibūna","turn devoutly","অভিমুখী হলাম\""]],"t":"عَسَىٰ رَبُّ<o>نَآ</> <d>أَن يُ</><q>بْ</>دِلَنَا خَيْ<d>رًۭا مِّ</>نْ<o>هَآ</> إِ<g>نَّ</><o>آ</> إِلَىٰ رَبِّنَا <m>رَٰ</>غِ<p>بُو</>نَ"},{"n":33,"w":[["كَذَٰلِكَ","kadhālika","Such","এমনই"],["ٱلْعَذَابُ ۖ","l-‘adhābu","(is) the punishment","আযাব"],["وَلَعَذَابُ","wala‘adhābu","And surely the punishment","এবং আযাব অবশ্যই"],["ٱلْـَٔاخِرَةِ","l-ākhirati","(of) the Hereafter","আখিরাতের"],["أَكْبَرُ ۚ","akbaru","(is) greater","অনেক বড়"],["لَوْ","law","if","যদি"],["كَانُوا۟","kānū","they","তারা"],["يَعْلَمُونَ","ya‘lamūna","know","জানত"]],"t":"كَ<m>ذَٰ</>لِكَ <h>ٱ</>لْعَذَابُ ۖ وَلَعَذَابُ <h>ٱ</>لْءَاخِرَةِ أَكْبَرُ ۚ لَوْ كَانُو<s>ا۟</> يَعْلَ<p>مُو</>نَ"},{"n":34,"w":[["إِنَّ","inna","Indeed","নিশ্চয়"],["لِلْمُتَّقِينَ","lil'muttaqīna","for the righteous","পরহেজগারদের জন্য"],["عِندَ","‘inda","with","কাছে রয়েছে"],["رَبِّهِمْ","rabbihim","their Lord","তাদের রবের"],["جَنَّـٰتِ","jannāti","(are) Gardens","জান্নাতসমূহ"],["ٱلنَّعِيمِ","l-na‘īmi","(of) Delight","নিয়ামতে ভরা"]],"t":"إِ<g>نَّ</> لِلْمُتَّقِينَ عِ<k>ندَ</> رَبِّهِمْ جَ<g>نَّٰ</>تِ <h>ٱ</><l>ل</><g>نَّ</><p>عِي</>مِ"},{"n":35,"w":[["أَفَنَجْعَلُ","afanaj‘alu","Then will We treat","অতএব আমরা কি বানাব"],["ٱلْمُسْلِمِينَ","l-mus'limīna","the Muslims","আত্মসমর্পণ কারীদের"],["كَٱلْمُجْرِمِينَ","kal-muj'rimīna","like the criminals","যেমন অপরাধকারীদের"]],"t":"أَفَنَ<q>جْ</>عَلُ <h>ٱ</>لْمُسْلِمِينَ كَ<h>ٱ</>لْمُ<q>جْ</>رِ<p>مِي</>نَ"},{"n":36,"w":[["مَا","mā","What","কি"],["لَكُمْ","lakum","(is) for you","তোমাদের হয়েছে"],["كَيْفَ","kayfa","How","কেমন"],["تَحْكُمُونَ","taḥkumūna","(do) you judge","তোমরা বিচার কর"]],"t":"مَا لَكُمْ كَيْفَ تَحْكُ<p>مُو</>نَ"},{"n":37,"w":[["أَمْ","am","Or","অথবা"],["لَكُمْ","lakum","(is) for you","তোমাদের জন্যে"],["كِتَـٰبٌۭ","kitābun","a book","কিতাব(আছে)"],["فِيهِ","fīhi","wherein","তার মধ্যে"],["تَدْرُسُونَ","tadrusūna","you learn","তোমরা পড়"]],"t":"أَمْ لَكُمْ كِ<m>تَٰ</><k>بٌۭ فِ</>يهِ تَ<q>دْ</>رُ<p>سُو</>نَ"},{"n":38,"w":[["إِنَّ","inna","Indeed","নিশ্চয়"],["لَكُمْ","lakum","for you","তোমাদের জন্য"],["فِيهِ","fīhi","in it","তার মধ্যে"],["لَمَا","lamā","what","যা"],["تَخَيَّرُونَ","takhayyarūna","you choose","তোমরা পছন্দ কর"]],"t":"إِ<g>نَّ</> لَكُمْ فِيهِ لَمَا تَخَيَّ<p>رُو</>نَ"},{"n":39,"w":[["أَمْ","am","Or","অথবা"],["لَكُمْ","lakum","for you","তোমাদের জন্যে রয়েছে"],["أَيْمَـٰنٌ","aymānun","oaths","প্রতিশ্রুতি"],["عَلَيْنَا","‘alaynā","from us","আমাদের উপর"],["بَـٰلِغَةٌ","bālighatun","reaching","বলবৎ"],["إِلَىٰ","ilā","to","পর্যন্ত"],["يَوْمِ","yawmi","(the) Day","দিন"],["ٱلْقِيَـٰمَةِ ۙ","l-qiyāmati","(of) the Resurrection","কিয়ামতের"],["إِنَّ","inna","indeed","নিশ্চয়"],["لَكُمْ","lakum","for you","তোমাদের জন্যে আছে"],["لَمَا","lamā","(is) what","যা"],["تَحْكُمُونَ","taḥkumūna","you judge","তোমরা সিদ্ধান্ত নিচ্ছ"]],"t":"أَمْ لَكُمْ أَيْ<m>مَٰ</>نٌ عَلَيْنَا <m>بَٰ</>لِغَةٌ إِلَىٰ يَوْمِ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ ۙ إِ<g>نَّ</> لَكُمْ لَمَا تَحْكُ<p>مُو</>نَ"},{"n":40,"w":[["سَلْهُمْ","salhum","Ask them","তাদের জিজ্ঞেস কর"],["أَيُّهُم","ayyuhum","which of them","তাদের মধ্যে কে"],["بِذَٰلِكَ","bidhālika","for that","এই ক্ষেত্রে"],["زَعِيمٌ","za‘īmun","(is) responsible","যিম্নাদার"]],"t":"سَلْهُمْ أَيُّ<f>هُم بِ</><m>ذَٰ</>لِكَ زَ<p>عِي</>مٌ"},{"n":41,"w":[["أَمْ","am","Or","অথবা"],["لَهُمْ","lahum","(are) for them","তাদের জন্যে আছে"],["شُرَكَآءُ","shurakāu","partners","অংশীদার"],["فَلْيَأْتُوا۟","falyatū","Then let them bring","অতএব তারা উপস্থিত করুক"],["بِشُرَكَآئِهِمْ","bishurakāihim","their partners","তাদের শরীকদের"],["إِن","in","if","যদি"],["كَانُوا۟","kānū","they are","হয় তারা"],["صَـٰدِقِينَ","ṣādiqīna","truthful","সত্যবাদী"]],"t":"أَمْ لَهُمْ شُرَ<o>كَآ</>ءُ فَلْيَأْتُو<s>ا۟</> بِشُرَ<o>كَآ</>ئِهِمْ إِ<k>ن كَ</>انُو<s>ا۟</> <m>صَٰ</>دِ<p>قِي</>نَ"},{"n":42,"w":[["يَوْمَ","yawma","(The) Day","সসেদিন"],["يُكْشَفُ","yuk'shafu","will be uncovered","উন্মোচিত হবে"],["عَن","‘an","from","থেকে"],["سَاقٍۢ","sāqin","the shin","পিণ্ডলী"],["وَيُدْعَوْنَ","wayud'‘awna","and they will be called","এবং তাদের ডাকা হবে"],["إِلَى","ilā","to","দিকে"],["ٱلسُّجُودِ","l-sujūdi","prostrate","সিজদাসমূহের"],["فَلَا","falā","but not","না তখন"],["يَسْتَطِيعُونَ","yastaṭī‘ūna","they will be able","তারা পারবে"]],"t":"يَوْمَ يُكْشَفُ عَ<k>ن سَ</>ا<d>قٍۢ وَ</>يُ<q>دْ</>عَوْنَ إِلَى <h>ٱ</><l>ل</>سُّجُودِ فَلَا يَسْتَطِي<p>عُو</>نَ"},{"n":43,"w":[["خَـٰشِعَةً","khāshi‘atan","Humbled","অবনত হবে"],["أَبْصَـٰرُهُمْ","abṣāruhum","their eyes","তাদের দৃষ্টিগুলো"],["تَرْهَقُهُمْ","tarhaquhum","will cover them","তাদের আচ্ছাদিত করবে"],["ذِلَّةٌۭ ۖ","dhillatun","humiliation","অপমান"],["وَقَدْ","waqad","And indeed","এবং নিশ্চয়"],["كَانُوا۟","kānū","they were","তারা ছিল"],["يُدْعَوْنَ","yud'‘awna","called","তাদের ডাকা হতো"],["إِلَى","ilā","to","দিকে"],["ٱلسُّجُودِ","l-sujūdi","prostrate","সিজদাসমূহের"],["وَهُمْ","wahum","while they","অথচ তারা"],["سَـٰلِمُونَ","sālimūna","(were) sound","নিরাপদ ছিল"]],"t":"<m>خَٰ</>شِعَةً أَ<q>بْ</><m>صَٰ</>رُهُمْ تَرْهَقُهُمْ ذِلَّ<d>ةٌۭ ۖ وَ</>قَ<q>دْ</> كَانُو<s>ا۟</> يُ<q>دْ</>عَوْنَ إِلَى <h>ٱ</><l>ل</>سُّجُودِ وَهُمْ <m>سَٰ</>لِ<p>مُو</>نَ"},{"n":44,"w":[["فَذَرْنِى","fadharnī","So leave Me","অতএব আমাকে ছেড়ে দাও"],["وَمَن","waman","and whoever","এবং যে"],["يُكَذِّبُ","yukadhibu","denies","মিথ্যারোপ করে"],["بِهَـٰذَا","bihādhā","this","এর উপর"],["ٱلْحَدِيثِ ۖ","l-ḥadīthi","Statement","কথার"],["سَنَسْتَدْرِجُهُم","sanastadrijuhum","We will progressively lead them","শীঘ্রয় আমরা তাদের ক্রমে ক্রমে নিয়ে যাব"],["مِّنْ","min","from","থেকে"],["حَيْثُ","ḥaythu","where","যেখান"],["لَا","lā","not","না"],["يَعْلَمُونَ","ya‘lamūna","they know","তারা জানতেও পারবে"]],"t":"فَذَرْنِى وَ<d>مَن يُ</>كَذِّبُ بِ<m>هَٰ</>ذَا <h>ٱ</>لْحَدِيثِ ۖ سَنَسْتَ<q>دْ</>رِجُ<y>هُم مِّ</>نْ حَيْثُ لَا يَعْلَ<p>مُو</>نَ"},{"n":45,"w":[["وَأُمْلِى","wa-um'lī","And I will give respite","এবং আমি অবকাশ দিচ্ছি"],["لَهُمْ ۚ","lahum","to them","তাদের জন্যে"],["إِنَّ","inna","Indeed","নিশ্চয়"],["كَيْدِى","kaydī","My plan","আমার কাইদা(কোশল)"],["مَتِينٌ","matīnun","(is) firm","বলিষ্ঠ"]],"t":"وَأُمْلِى لَهُمْ ۚ إِ<g>نَّ</> كَيْدِى مَ<p>تِي</>نٌ"},{"n":46,"w":[["أَمْ","am","Or","কি"],["تَسْـَٔلُهُمْ","tasaluhum","you ask them","তাদের কাছে তুমি চাচ্ছ"],["أَجْرًۭا","ajran","a payment","কোন পারিশ্রমিক"],["فَهُم","fahum","so they","অতএব তারা"],["مِّن","min","from","থেকে"],["مَّغْرَمٍۢ","maghramin","(the) debt","জরিমানা"],["مُّثْقَلُونَ","muth'qalūna","(are) burdened","বোঝাগ্রস্থ"]],"t":"أَمْ تَسْـَٔلُهُمْ أَ<q>جْ</><k>رًۭا فَ</><y>هُم مِّ</><d>ن مَّ</>غْرَ<d>مٍۢ مُّ</>ثْقَ<p>لُو</>نَ"},{"n":47,"w":[["أَمْ","am","Or","কি"],["عِندَهُمُ","‘indahumu","(is) with them","তাদের কাছে আছে"],["ٱلْغَيْبُ","l-ghaybu","the unseen","গায়েবের(জ্ঞান)"],["فَهُمْ","fahum","so they","বা তারা"],["يَكْتُبُونَ","yaktubūna","write it","লিখে রাখে"]],"t":"أَمْ عِ<k>ندَ</>هُمُ <h>ٱ</>لْغَيْبُ فَهُمْ يَكْتُ<p>بُو</>نَ"},{"n":48,"w":[["فَٱصْبِرْ","fa-iṣ'bir","So be patient","অতএব সবর কর"],["لِحُكْمِ","liḥuk'mi","for (the) decision","ফয়সালার জন্যে"],["رَبِّكَ","rabbika","(of) your Lord","তোমার রবের"],["وَلَا","walā","and (do) not","এবং না"],["تَكُن","takun","be","হয়ো"],["كَصَاحِبِ","kaṣāḥibi","like (the) companion","ওঁয়ালার মতো"],["ٱلْحُوتِ","l-ḥūti","(of) the fish","মাছ"],["إِذْ","idh","when","যখন"],["نَادَىٰ","nādā","he called out","শসে ডেকেছিল"],["وَهُوَ","wahuwa","while he","এবং সে"],["مَكْظُومٌۭ","makẓūmun","(was) distressed","বিষণ্ণ ছিল"]],"t":"فَ<h>ٱ</>صْبِرْ لِحُكْمِ رَبِّكَ وَلَا تَكُ<k>ن كَ</>صَاحِبِ <h>ٱ</>لْحُوتِ إِذْ نَادَىٰ وَهُوَ مَكْ<p>ظُو</>مٌۭ"},{"n":49,"w":[["لَّوْلَآ","lawlā","If not","যদি না"],["أَن","an","that","তাকে"],["تَدَٰرَكَهُۥ","tadārakahu","overtook him","পেতো"],["نِعْمَةٌۭ","ni‘'matun","a Favor","অনুগ্রহ"],["مِّن","min","from","থেকে"],["رَّبِّهِۦ","rabbihi","his Lord","তার রবের"],["لَنُبِذَ","lanubidha","surely he would have been thrown","অবশ্যই নিক্ষিপ্ত হতো"],["بِٱلْعَرَآءِ","bil-‘arāi","onto (the) naked shore","উন্মুক্ত প্রাস্তরে"],["وَهُوَ","wahuwa","while he","এবং সে"],["مَذْمُومٌۭ","madhmūmun","(was) blamed","নিন্দিত হতো"]],"t":"لَّوْ<o>لَآ</> أَ<k>ن تَ</><m>دَٰ</>رَكَهُ<m>ۥ</> نِعْمَ<d>ةٌۭ مِّ</><w>ن رَّ</>بِّ<m>هِۦ</> لَنُبِذَ بِ<h>ٱ</>لْعَ<o>رَآ</>ءِ وَهُوَ مَذْ<p>مُو</>مٌۭ"},{"n":50,"w":[["فَٱجْتَبَـٰهُ","fa-ij'tabāhu","But chose him","অতঃপর তাকে মনোনীত করলেন"],["رَبُّهُۥ","rabbuhu","his Lord","তার রব"],["فَجَعَلَهُۥ","faja‘alahu","and made him","তাই তাকে করলেন"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلصَّـٰلِحِينَ","l-ṣāliḥīna","the righteous","নেক বান্দাদের"]],"t":"فَ<h>ٱ</><q>جْ</>تَ<m>بَٰ</>هُ رَبُّهُ<m>ۥ</> فَجَعَلَهُ<m>ۥ</> مِنَ <h>ٱ</><l>ل</><m>صَّٰ</>لِ<p>حِي</>نَ"},{"n":51,"w":[["وَإِن","wa-in","And indeed","এবং যেন"],["يَكَادُ","yakādu","would almost","মনে হয়"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieve","অস্বীকার করেছে"],["لَيُزْلِقُونَكَ","layuz'liqūnaka","surely make you slip","অবশ্যই তোমাকে পদংখলন করাবে"],["بِأَبْصَـٰرِهِمْ","bi-abṣārihim","with their look","তাদের দৃষ্টিগুলো দিয়ে"],["لَمَّا","lammā","when","যখন"],["سَمِعُوا۟","sami‘ū","they hear","তারা শুনে"],["ٱلذِّكْرَ","l-dhik'ra","the Message","উপদেশ(কুরআন)"],["وَيَقُولُونَ","wayaqūlūna","and they say","এবং তারা বলে"],["إِنَّهُۥ","innahu","Indeed, he","\"সেনিশ্চয়"],["لَمَجْنُونٌۭ","lamajnūnun","(is) surely mad","অবশ্যই পাগল\""]],"t":"وَ<d>إِن يَ</>كَادُ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> لَيُزْلِقُونَكَ بِأَ<q>بْ</><m>صَٰ</>رِهِمْ لَ<g>مَّ</>ا سَمِعُو<s>ا۟</> <h>ٱ</><l>ل</>ذِّكْرَ وَيَقُولُونَ إِ<g>نَّ</>هُ<m>ۥ</> لَمَ<q>جْ</><p>نُو</>نٌۭ"},{"n":52,"w":[["وَمَا","wamā","And not","এবং নয়"],["هُوَ","huwa","it (is)","তা"],["إِلَّا","illā","but","ছাড়া"],["ذِكْرٌۭ","dhik'run","a Reminder","উপদেশ"],["لِّلْعَـٰلَمِينَ","lil'‘ālamīna","to the worlds","সারা বিশের জন্যে"]],"t":"وَمَا هُوَ إِلَّا ذِكْ<w>رٌۭ لِّ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"}]}