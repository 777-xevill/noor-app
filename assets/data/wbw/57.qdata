{"n":57,"a":[{"n":1,"w":[["سَبَّحَ","sabbaḥa","Glorifies","মহিমা ঘোষণা করছে"],["لِلَّهِ","lillahi","[to] Allah","আল্লাহ্‌রই জন্য"],["مَا","mā","whatever","যা কিছু"],["فِى","fī","(is) in","মধ্যে আছে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশের"],["وَٱلْأَرْضِ ۖ","wal-arḍi","and the earth","ও পৃথিবীতে"],["وَهُوَ","wahuwa","and He","এবং তিনি"],["ٱلْعَزِيزُ","l-‘azīzu","(is) the All-Mighty","পরাক্রমশালী"],["ٱلْحَكِيمُ","l-ḥakīmu","the All-Wise","প্রজ্ঞাময়"]],"t":"سَبَّحَ لِلَّهِ مَا فِى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ ۖ وَهُوَ <h>ٱ</>لْعَزِيزُ <h>ٱ</>لْحَ<p>كِي</>مُ"},{"n":2,"w":[["لَهُۥ","lahu","For Him","তাঁরই জন্যে"],["مُلْكُ","mul'ku","(is the) dominion","সার্বভৌমত্ব"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশের"],["وَٱلْأَرْضِ ۖ","wal-arḍi","and the earth","ও পৃথিবীর"],["يُحْىِۦ","yuḥ'yī","He gives life","তিনি জীবন দান করেন"],["وَيُمِيتُ ۖ","wayumītu","and causes death","ও মৃত্যু ঘটান"],["وَهُوَ","wahuwa","and He","এবং তিনিই"],["عَلَىٰ","‘alā","(is) over","উপর"],["كُلِّ","kulli","all","সব"],["شَىْءٍۢ","shayin","things","কিছুরই"],["قَدِيرٌ","qadīrun","All-Powerful","সর্বশক্তিমান"]],"t":"لَهُ<m>ۥ</> مُلْكُ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ ۖ يُحْ<m>ىِۦ</> وَيُمِيتُ ۖ وَهُوَ عَلَىٰ كُلِّ <k>شَىْءٍۢ قَ</><p>دِي</>رٌ"},{"n":3,"w":[["هُوَ","huwa","He","তিনিই"],["ٱلْأَوَّلُ","l-awalu","(is) the First","প্রথম"],["وَٱلْـَٔاخِرُ","wal-ākhiru","and the Last","ও (তিনিই) শেষ"],["وَٱلظَّـٰهِرُ","wal-ẓāhiru","and the Apparent","এবং (তিনিই) ব্যক্ত"],["وَٱلْبَاطِنُ ۖ","wal-bāṭinu","and the Unapparent","ও তিনিই অব্যক্ত"],["وَهُوَ","wahuwa","and He","এবং তিনিই"],["بِكُلِّ","bikulli","(is) of every","সব সম্বন্ধে"],["شَىْءٍ","shayin","thing","কিছু"],["عَلِيمٌ","‘alīmun","All-Knower","খুব অবহিত"]],"t":"هُوَ <h>ٱ</>لْأَوَّلُ وَ<h>ٱ</>لْءَاخِرُ وَ<h>ٱ</><l>ل</><m>ظَّٰ</>هِرُ وَ<h>ٱ</>لْبَاطِنُ ۖ وَهُوَ بِكُلِّ شَىْءٍ عَ<p>لِي</>مٌ"},{"n":4,"w":[["هُوَ","huwa","He","তিনিই"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["خَلَقَ","khalaqa","created","সৃষ্টি করেছেন"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশ সমুহকে"],["وَٱلْأَرْضَ","wal-arḍa","and the earth","ও পৃথিবীকে"],["فِى","fī","in","মধ্যে"],["سِتَّةِ","sittati","six","ছয়"],["أَيَّامٍۢ","ayyāmin","periods","দিনের"],["ثُمَّ","thumma","then","অতঃপর"],["ٱسْتَوَىٰ","is'tawā","He rose","সমাসীন হন"],["عَلَى","‘alā","over","উপর"],["ٱلْعَرْشِ ۚ","l-‘arshi","the Throne","আরশের"],["يَعْلَمُ","ya‘lamu","He knows","তিনি জানেন"],["مَا","mā","what","যা কিছু"],["يَلِجُ","yaliju","penetrates","ঢোকে"],["فِى","fī","in(to)","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","মাটির"],["وَمَا","wamā","and what","এবং যা"],["يَخْرُجُ","yakhruju","comes forth","বের হয়"],["مِنْهَا","min'hā","from it","তা থেকে"],["وَمَا","wamā","and what","এবং যা কিছু"],["يَنزِلُ","yanzilu","descends","নামে"],["مِنَ","mina","from","হতে"],["ٱلسَّمَآءِ","l-samāi","the heaven","আকাশ"],["وَمَا","wamā","and what","ও যা কিছু"],["يَعْرُجُ","ya‘ruju","ascends","উঠে"],["فِيهَا ۖ","fīhā","therein","তার মধ্য হতে"],["وَهُوَ","wahuwa","and He","এবং তিনি (আছেন)"],["مَعَكُمْ","ma‘akum","(is) with you","তোমাদের সাথে"],["أَيْنَ","ayna","wherever","যেখানেই"],["مَا","mā","wherever","যা"],["كُنتُمْ ۚ","kuntum","you are","তোমরা থাক"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ্‌"],["بِمَا","bimā","of what","ঐ সম্বন্ধে যা"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা কাজ করছ"],["بَصِيرٌۭ","baṣīrun","(is) All-seer","খুব দেখেন"]],"t":"هُوَ <h>ٱ</>لَّذِى خَلَقَ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضَ فِى سِتَّةِ أَيَّا<k>مٍۢ ثُ</><g>مَّ</> <h>ٱ</>سْتَوَىٰ عَلَى <h>ٱ</>لْعَرْشِ ۚ يَعْلَمُ مَا يَلِجُ فِى <h>ٱ</>لْأَرْضِ وَمَا يَخْرُجُ مِنْهَا وَمَا يَ<k>نزِ</>لُ مِنَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ وَمَا يَعْرُجُ فِيهَا ۖ وَهُوَ مَعَكُمْ أَيْنَ مَا كُ<k>نتُ</>مْ ۚ وَ<h>ٱ</>للَّهُ بِمَا تَعْمَلُونَ بَ<p>صِي</>رٌۭ"},{"n":5,"w":[["لَّهُۥ","lahu","For Him","তাঁরই জন্যে"],["مُلْكُ","mul'ku","(is the) dominion","সার্বভৌমত্ব"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশের"],["وَٱلْأَرْضِ ۚ","wal-arḍi","and the earth","ও পৃথিবীর"],["وَإِلَى","wa-ilā","and to","এবং দিকে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌রই"],["تُرْجَعُ","tur'ja‘u","will be returned","প্রত্যাবর্তিত হয়"],["ٱلْأُمُورُ","l-umūru","the matters","(সমস্ত) সব বিষয়"]],"t":"لَّهُ<m>ۥ</> مُلْكُ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ ۚ وَإِلَى <h>ٱ</>للَّهِ تُرْجَعُ <h>ٱ</>لْأُ<p>مُو</>رُ"},{"n":6,"w":[["يُولِجُ","yūliju","He merges","তিনি প্রবেশ করান"],["ٱلَّيْلَ","al-layla","the night","রাতকে"],["فِى","fī","into","মধ্যে"],["ٱلنَّهَارِ","l-nahāri","the day","দিনের"],["وَيُولِجُ","wayūliju","and He merges","ও প্রবেশ করান"],["ٱلنَّهَارَ","l-nahāra","the day","দিনকে"],["فِى","fī","into","মধ্যে"],["ٱلَّيْلِ ۚ","al-layli","the night","রাতের"],["وَهُوَ","wahuwa","and He","এবং তিনিই"],["عَلِيمٌۢ","‘alīmun","(is) All-Knower","খুব অবহিত"],["بِذَاتِ","bidhāti","of what is in the breasts","অবস্থা সম্বন্ধে"],["ٱلصُّدُورِ","l-ṣudūri","of what is in the breasts","অন্তর সমূহের"]],"t":"يُولِجُ <h>ٱ</>لَّيْلَ فِى <h>ٱ</><l>ل</><g>نَّ</>هَارِ وَيُولِجُ <h>ٱ</><l>ل</><g>نَّ</>هَارَ فِى <h>ٱ</>لَّيْلِ ۚ وَهُوَ عَلِي<i>مٌۢ بِ</>ذَاتِ <h>ٱ</><l>ل</>صُّ<p>دُو</>رِ"},{"n":7,"w":[["ءَامِنُوا۟","āminū","Believe","তোমরা ঈমান আন"],["بِٱللَّهِ","bil-lahi","in Allah","আল্লাহ্‌র উপর"],["وَرَسُولِهِۦ","warasūlihi","and His Messenger","ও তাঁর রাসূলের উপর"],["وَأَنفِقُوا۟","wa-anfiqū","and spend","এবং তোমরা খরচ করো"],["مِمَّا","mimmā","of what","তা হতে"],["جَعَلَكُم","ja‘alakum","He has made you","তোমাদের করেছেন"],["مُّسْتَخْلَفِينَ","mus'takhlafīna","trustees","উত্তরাধিকারী"],["فِيهِ ۖ","fīhi","therein","যাতে"],["فَٱلَّذِينَ","fa-alladhīna","And those","অতঃএব যারা"],["ءَامَنُوا۟","āmanū","who believe","ঈমান আনে"],["مِنكُمْ","minkum","among you","তোমাদের মধ্যে হতে"],["وَأَنفَقُوا۟","wa-anfaqū","and spend","ও খরচ করে"],["لَهُمْ","lahum","for them","তাদের জন্য (রয়েছে)"],["أَجْرٌۭ","ajrun","(is) a reward","পুরস্কার"],["كَبِيرٌۭ","kabīrun","great","বড়"]],"t":"ءَامِنُو<s>ا۟</> بِ<h>ٱ</>للَّهِ وَرَسُولِ<m>هِۦ</> وَأَ<k>نفِ</>قُو<s>ا۟</> مِ<g>مَّ</>ا جَعَلَ<y>كُم مُّ</>سْتَخْلَفِينَ فِيهِ ۖ فَ<h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> مِ<k>نكُ</>مْ وَأَ<k>نفَ</>قُو<s>ا۟</> لَهُمْ أَ<q>جْ</><k>رٌۭ كَ</><p>بِي</>رٌۭ"},{"n":8,"w":[["وَمَا","wamā","And what","এবং কি হয়েছে"],["لَكُمْ","lakum","(is) for you","তোমাদের"],["لَا","lā","(that) not","(যে) না"],["تُؤْمِنُونَ","tu'minūna","you believe","তোমরা ঈমান আন"],["بِٱللَّهِ ۙ","bil-lahi","in Allah","আল্লাহ্‌র উপর"],["وَٱلرَّسُولُ","wal-rasūlu","while the Messenger","অথচ রাসূল"],["يَدْعُوكُمْ","yad‘ūkum","calls you","তোমাদেরকে ডাকছেন"],["لِتُؤْمِنُوا۟","litu'minū","that you believe","তোমরা ঈমান যেন আন"],["بِرَبِّكُمْ","birabbikum","in your Lord","তোমার রবের উপর"],["وَقَدْ","waqad","and indeed","এবং নিশ্চয়ই"],["أَخَذَ","akhadha","He has taken","তিনি নিয়েছেন"],["مِيثَـٰقَكُمْ","mīthāqakum","your covenant","তোমাদের প্রতিশ্রুতি"],["إِن","in","if","যদি"],["كُنتُم","kuntum","you are","তোমরা হও"],["مُّؤْمِنِينَ","mu'minīna","believers","মুমিন"]],"t":"وَمَا لَكُمْ لَا تُؤْمِنُونَ بِ<h>ٱ</>للَّهِ ۙ وَ<h>ٱ</><l>ل</>رَّسُولُ يَ<q>دْ</>عُوكُمْ لِتُؤْمِنُو<s>ا۟</> بِرَبِّكُمْ وَقَ<q>دْ</> أَخَذَ مِي<m>ثَٰ</>قَكُمْ إِ<k>ن كُنتُ</><y>م مُّ</>ؤْمِ<p>نِي</>نَ"},{"n":9,"w":[["هُوَ","huwa","He","তিনিই (সেই আল্লাহ্‌)"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["يُنَزِّلُ","yunazzilu","sends down","অবতীর্ণ করেছেন"],["عَلَىٰ","‘alā","upon","উপর"],["عَبْدِهِۦٓ","‘abdihi","His slave","তাঁর বান্দার/ দাসের"],["ءَايَـٰتٍۭ","āyātin","Verses","আয়াত সমূহ"],["بَيِّنَـٰتٍۢ","bayyinātin","clear","সুস্পষ্ট"],["لِّيُخْرِجَكُم","liyukh'rijakum","that He may bring you out","তোমাদের বের করার জন্যে"],["مِّنَ","mina","from","হতে"],["ٱلظُّلُمَـٰتِ","l-ẓulumāti","the darkness[es]","অন্ধকারসমূহ"],["إِلَى","ilā","into","দিকে"],["ٱلنُّورِ ۚ","l-nūri","the light","আলোর"],["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["بِكُمْ","bikum","to you","তোমাদের উপর"],["لَرَءُوفٌۭ","laraūfun","(is the) Most Kind","অবশ্যই করুণাময়"],["رَّحِيمٌۭ","raḥīmun","(the) Most Merciful","পরম দয়ালু"]],"t":"هُوَ <h>ٱ</>لَّذِى يُنَزِّلُ عَلَىٰ عَ<q>بْ</>دِ<o>هِۦٓ</> ءَا<m>يَٰ</><i>تٍۭ بَ</>يِّ<m>نَٰ</><w>تٍۢ لِّ</>يُخْرِجَ<y>كُم مِّ</>نَ <h>ٱ</><l>ل</>ظُّلُ<m>مَٰ</>تِ إِلَى <h>ٱ</><l>ل</><g>نُّ</>ورِ ۚ وَإِ<g>نَّ</> <h>ٱ</>للَّهَ بِكُمْ لَرَءُو<w>فٌۭ رَّ</><p>حِي</>مٌۭ"},{"n":10,"w":[["وَمَا","wamā","And what","এবং কি"],["لَكُمْ","lakum","(is) for you","তোমাদের হয়েছে"],["أَلَّا","allā","that not","যে না"],["تُنفِقُوا۟","tunfiqū","you spend","তোমরা ব্যয় করছ"],["فِى","fī","in","মধ্যে"],["سَبِيلِ","sabīli","(the) way","পথের"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহ্‌র"],["وَلِلَّهِ","walillahi","while for Allah","অথচ আল্লাহ্‌রই জন্য"],["مِيرَٰثُ","mīrāthu","(is the) heritage","উত্তারাধিকার (অর্থাৎ মালিকানা)"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশের"],["وَٱلْأَرْضِ ۚ","wal-arḍi","and the earth","ও পৃথিবীর"],["لَا","lā","Not","নয়"],["يَسْتَوِى","yastawī","are equal","সমান"],["مِنكُم","minkum","among you","তোমাদের মধ্য হতে"],["مَّنْ","man","(those) who","যে"],["أَنفَقَ","anfaqa","spent","ব্যয় করেছে"],["مِن","min","before","মধ্য হতে"],["قَبْلِ","qabli","before","পূর্বে"],["ٱلْفَتْحِ","l-fatḥi","the victory","বিজয়ের"],["وَقَـٰتَلَ ۚ","waqātala","and fought","এবং জিহাদ করেছে"],["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব লোক"],["أَعْظَمُ","a‘ẓamu","(are) greater","শ্রেস্ততর"],["دَرَجَةًۭ","darajatan","(in) degree","মর্যাদায়"],["مِّنَ","mina","than","(তাদের) চেয়ে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["أَنفَقُوا۟","anfaqū","spent","ব্যয় করেছে"],["مِنۢ","min","afterwards","মধ্য হতে"],["بَعْدُ","ba‘du","afterwards","(বিজয়ের) পরে"],["وَقَـٰتَلُوا۟ ۚ","waqātalū","and fought","ও যুদ্ধ করেছে"],["وَكُلًّۭا","wakullan","But to all","তবে প্রত্যেককে"],["وَعَدَ","wa‘ada","Allah has promised","প্রতিশ্রুতি দিয়েছেন"],["ٱللَّهُ","l-lahu","Allah has promised","আল্লাহ্‌"],["ٱلْحُسْنَىٰ ۚ","l-ḥus'nā","the best","কল্যাণকর"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ্‌"],["بِمَا","bimā","of what","ঐ বিষয়ে যা"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা কাজ করছ"],["خَبِيرٌۭ","khabīrun","(is) All-Aware","খুব অবগত"]],"t":"وَمَا لَكُمْ أَلَّا تُ<k>نفِ</>قُو<s>ا۟</> فِى سَبِيلِ <h>ٱ</>للَّهِ وَلِلَّهِ مِي<m>رَٰ</>ثُ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ ۚ لَا يَسْتَوِى مِ<k>نكُ</><y>م مَّ</>نْ أَ<k>نفَ</>قَ مِ<k>ن قَ</><q>بْ</>لِ <h>ٱ</>لْفَتْحِ وَ<m>قَٰ</>تَلَ ۚ أُ<s>و۟</><o>لَٰٓ</>ئِكَ أَعْظَمُ دَرَجَ<d>ةًۭ مِّ</>نَ <h>ٱ</>لَّذِينَ أَ<k>نفَ</>قُو<s>ا۟</> <i>مِنۢ بَ</>عْدُ وَ<m>قَٰ</>تَلُو<s>ا۟ ۚ</> وَكُ<d>لًّۭا وَ</>عَدَ <h>ٱ</>للَّهُ <h>ٱ</>لْحُسْنَىٰ ۚ وَ<h>ٱ</>للَّهُ بِمَا تَعْمَلُونَ خَ<p>بِي</>رٌۭ"},{"n":11,"w":[["مَّن","man","Who (is)","কে (আছে)"],["ذَا","dhā","the one who","সেই (ব্যক্তি)"],["ٱلَّذِى","alladhī","the one who","যে"],["يُقْرِضُ","yuq'riḍu","will loan","ঋণ দেবে"],["ٱللَّهَ","l-laha","(to) Allah","আল্লাহকে"],["قَرْضًا","qarḍan","a loan","ঋণ"],["حَسَنًۭا","ḥasanan","goodly","উত্তম"],["فَيُضَـٰعِفَهُۥ","fayuḍā‘ifahu","so He will multiply it","অতঃপর তা বহুগুণ বৃদ্ধি করবেন"],["لَهُۥ","lahu","for him","তার জন্যে"],["وَلَهُۥٓ","walahu","and for him","এবং তার জন্যে"],["أَجْرٌۭ","ajrun","(is) a reward","পুরস্কার (আছে)"],["كَرِيمٌۭ","karīmun","noble","সম্মানজনক"]],"t":"مَّ<k>ن ذَ</>ا <h>ٱ</>لَّذِى يُ<q>قْ</>رِضُ <h>ٱ</>للَّهَ قَرْضًا حَسَ<k>نًۭا فَ</>يُ<m>ضَٰ</>عِفَهُ<m>ۥ</> لَهُ<m>ۥ</> وَلَهُ<o>ۥٓ</> أَ<q>جْ</><k>رٌۭ كَ</><p>رِي</>مٌۭ"},{"n":12,"w":[["يَوْمَ","yawma","(On the) Day","সেদিন"],["تَرَى","tarā","you will see","তুমি দেখবে"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believing men","মুমিন পুরুষকে"],["وَٱلْمُؤْمِنَـٰتِ","wal-mu'mināti","and the believing women","ও মুমিন নারীকে"],["يَسْعَىٰ","yas‘ā","running","ছুটে চলছে"],["نُورُهُم","nūruhum","their light","তাদের আলো"],["بَيْنَ","bayna","before them","তাদের সামনে"],["أَيْدِيهِمْ","aydīhim","before them","তাদের সামনে"],["وَبِأَيْمَـٰنِهِم","wabi-aymānihim","and on their right","ও তাদের ডানে"],["بُشْرَىٰكُمُ","bush'rākumu","Glad tidings for you","\"(বলা হবে) তোমাদের জন্যে সুসংবাদ"],["ٱلْيَوْمَ","l-yawma","this Day ","আজ"],["جَنَّـٰتٌۭ","jannātun","gardens","এক জান্নাতের"],["تَجْرِى","tajrī","flowing","প্রবাহিত হয়"],["مِن","min","from","থেকে"],["تَحْتِهَا","taḥtihā","underneath it","তার নিচ"],["ٱلْأَنْهَـٰرُ","l-anhāru","the rivers","ঝর্ণাসমূহ"],["خَـٰلِدِينَ","khālidīna","abiding forever","তারা স্থায়ী হবে"],["فِيهَا ۚ","fīhā","therein","তার মধ্যে"],["ذَٰلِكَ","dhālika","That","এটাই"],["هُوَ","huwa","[it] (is)","সেই"],["ٱلْفَوْزُ","l-fawzu","the success","সাফল্য"],["ٱلْعَظِيمُ","l-‘aẓīmu","the great","মহা\""]],"t":"يَوْمَ تَرَى <h>ٱ</>لْمُؤْمِنِينَ وَ<h>ٱ</>لْمُؤْمِ<m>نَٰ</>تِ يَسْعَىٰ نُورُ<f>هُم بَ</>يْنَ أَيْدِيهِمْ وَبِأَيْ<m>مَٰ</>نِ<f>هِم بُ</>شْرَ<m>ىٰ</>كُمُ <h>ٱ</>لْيَوْمَ جَ<g>نَّٰ</><k>تٌۭ تَ</><q>جْ</>رِى مِ<k>ن تَ</>حْتِهَا <h>ٱ</>لْأَنْ<m>هَٰ</>رُ <m>خَٰ</>لِدِينَ فِيهَا ۚ <m>ذَٰ</>لِكَ هُوَ <h>ٱ</>لْفَوْزُ <h>ٱ</>لْعَ<p>ظِي</>مُ"},{"n":13,"w":[["يَوْمَ","yawma","(On the) Day","সেদিন"],["يَقُولُ","yaqūlu","will say","বলবে"],["ٱلْمُنَـٰفِقُونَ","l-munāfiqūna","the hypocrite men","মোনাফেক পুরুষরা"],["وَٱلْمُنَـٰفِقَـٰتُ","wal-munāfiqātu","and the hypocrite women","ও মোনাফেক নারীরা"],["لِلَّذِينَ","lilladhīna","to those who","(তাদের) কে যারা"],["ءَامَنُوا۟","āmanū","believed","ঈমান এনেছিল"],["ٱنظُرُونَا","unẓurūnā","Wait for us","\"আমাদের দিকে একটু দেখ"],["نَقْتَبِسْ","naqtabis","we may acquire","(আলো নিয়ে) আমরা উপকৃত হব"],["مِن","min","of","হতে"],["نُّورِكُمْ","nūrikum","your light","তোমাদের আলো\""],["قِيلَ","qīla","It will be said","বলা হবে"],["ٱرْجِعُوا۟","ir'ji‘ū","Go back","\"তোমরা ফিরে যাও"],["وَرَآءَكُمْ","warāakum","behind you","তোমাদের পিছনে"],["فَٱلْتَمِسُوا۟","fal-tamisū","and seek","তোমরা অতঃপর খোঁজ করো"],["نُورًۭا","nūran","light","আলো\""],["فَضُرِبَ","faḍuriba","Then will be put up","অতঃপর খাড়া করে দেওয়া হবে"],["بَيْنَهُم","baynahum","between them","তাদের মাঝে"],["بِسُورٍۢ","bisūrin","a wall","প্রাচীর"],["لَّهُۥ","lahu","for it","তার থাকবে"],["بَابٌۢ","bābun","a gate","একটি দরজা"],["بَاطِنُهُۥ","bāṭinuhu","its interior","তার ভিতর দিকে"],["فِيهِ","fīhi","in it","সেখানে আছে"],["ٱلرَّحْمَةُ","l-raḥmatu","(is) mercy","অনুগ্রহ"],["وَظَـٰهِرُهُۥ","waẓāhiruhu","but its exterior","এবং তার বাইরে"],["مِن","min","facing towards [it]","হতে"],["قِبَلِهِ","qibalihi","facing towards [it]","তার সামনের দিক"],["ٱلْعَذَابُ","l-‘adhābu","the punishment","শাস্তি"]],"t":"يَوْمَ يَقُولُ <h>ٱ</>لْمُ<m>نَٰ</>فِقُونَ وَ<h>ٱ</>لْمُ<m>نَٰفِقَٰ</>تُ لِلَّذِينَ ءَامَنُو<s>ا۟</> <h>ٱ</><k>نظُ</>رُونَا نَ<q>قْ</>تَبِسْ <d>مِن نُّ</>ورِكُمْ قِيلَ <h>ٱ</>رْجِعُو<s>ا۟</> وَ<o>رَآ</>ءَكُمْ فَ<h>ٱ</>لْتَمِسُو<s>ا۟</> نُو<k>رًۭا فَ</>ضُرِبَ بَيْنَ<f>هُم بِ</>سُو<w>رٍۢ لَّ</>هُ<m>ۥ</> بَا<i>بٌۢ بَ</>اطِنُهُ<m>ۥ</> فِيهِ <h>ٱ</><l>ل</>رَّحْمَةُ وَ<m>ظَٰ</>هِرُهُ<m>ۥ</> مِ<k>ن قِ</>بَلِهِ <h>ٱ</>لْعَ<p>ذَا</><q>بُ</>"},{"n":14,"w":[["يُنَادُونَهُمْ","yunādūnahum","They will call them","তাদেরকে ডেকে বলবে তারা"],["أَلَمْ","alam","Were not","\"নয় কি"],["نَكُن","nakun","we","আমরা ছিলাম"],["مَّعَكُمْ ۖ","ma‘akum","with you","তোমাদের সাথে\""],["قَالُوا۟","qālū","They will say","তারা বলবে"],["بَلَىٰ","balā","Yes","\"হ্যাঁ (তোমরা ছিলে)"],["وَلَـٰكِنَّكُمْ","walākinnakum","but you","কিন্তু তোমরা"],["فَتَنتُمْ","fatantum","led to temptation","তোমরা বিপদে ফেলেছিলে"],["أَنفُسَكُمْ","anfusakum","yourselves","তোমাদের নিজেদেরকে"],["وَتَرَبَّصْتُمْ","watarabbaṣtum","and you awaited","এবং তোমরা অপেক্ষা করেছিলে"],["وَٱرْتَبْتُمْ","wa-ir'tabtum","and you doubted","ও তোমরা সন্দেহ করেছিলে"],["وَغَرَّتْكُمُ","wagharratkumu","and deceived you","এবং তোমাদেরকে ধোঁকা দিয়েছিল"],["ٱلْأَمَانِىُّ","l-amāniyu","the wishful thinking","মিথ্যা আকাঙ্ক্ষা"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["جَآءَ","jāa","came","আসল"],["أَمْرُ","amru","(the) Command","নির্দেশ"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَغَرَّكُم","wagharrakum","And deceived you","এবং তোমাদেরকে ধোঁকা দিয়েছিল"],["بِٱللَّهِ","bil-lahi","about Allah","আল্লাহ্‌ সম্পর্কে"],["ٱلْغَرُورُ","l-gharūru","the deceiver","প্রতারক (শয়তান)"]],"t":"يُنَادُونَهُمْ أَلَمْ نَ<d>كُن مَّ</>عَكُمْ ۖ قَالُو<s>ا۟</> بَلَىٰ وَ<m>لَٰ</>كِ<g>نَّ</>كُمْ فَتَ<k>نتُ</>مْ أَ<k>نفُ</>سَكُمْ وَتَرَبَّصْتُمْ وَ<h>ٱ</>رْتَ<q>بْ</>تُمْ وَغَرَّتْكُمُ <h>ٱ</>لْأَمَانِىُّ حَتَّىٰ <o>جَآ</>ءَ أَمْرُ <h>ٱ</>للَّهِ وَغَرَّ<f>كُم بِ</><h>ٱ</>للَّهِ <h>ٱ</>لْغَ<p>رُو</>رُ"},{"n":15,"w":[["فَٱلْيَوْمَ","fal-yawma","So today","অতঃএব আজ"],["لَا","lā","not","না"],["يُؤْخَذُ","yu'khadhu","will be accepted","নেওয়া হবে"],["مِنكُمْ","minkum","from you","তোমাদের হতে"],["فِدْيَةٌۭ","fid'yatun","any ransom","কোনো মুক্তিপণ"],["وَلَا","walā","and not","আর না"],["مِنَ","mina","from","হতে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟ ۚ","kafarū","disbelieved","অস্বীকার করেছিল"],["مَأْوَىٰكُمُ","mawākumu","Your abode","তোমাদের আবাসস্থল"],["ٱلنَّارُ ۖ","l-nāru","(is) the Fire","জাহান্নাম"],["هِىَ","hiya","it (is)","তা"],["مَوْلَىٰكُمْ ۖ","mawlākum","your protector","তোমাদের সঙ্গী"],["وَبِئْسَ","wabi'sa","and wretched is","এবং অতি নিকৃষ্ট"],["ٱلْمَصِيرُ","l-maṣīru","the destination","প্রত্যাবর্তনস্থল"]],"t":"فَ<h>ٱ</>لْيَوْمَ لَا يُؤْخَذُ مِ<k>نكُ</>مْ فِ<q>دْ</>يَ<d>ةٌۭ وَ</>لَا مِنَ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟ ۚ</> مَأْوَ<m>ىٰ</>كُمُ <h>ٱ</><l>ل</><g>نَّ</>ارُ ۖ هِىَ مَوْلَ<m>ىٰ</>كُمْ ۖ وَبِئْسَ <h>ٱ</>لْمَ<p>صِي</>رُ"},{"n":16,"w":[["۞ أَلَمْ","alam","Has not","নি কি (সে সময়)"],["يَأْنِ","yani","come (the) time","সময় আসে"],["لِلَّذِينَ","lilladhīna","for those who","(তাদের) জন্যে যারা"],["ءَامَنُوٓا۟","āmanū","believed","ঈমান এনেছে"],["أَن","an","that","যে"],["تَخْشَعَ","takhsha‘a","become humble","বিগলিত হওয়ার"],["قُلُوبُهُمْ","qulūbuhum","their hearts","তাদের অন্তর গুলো"],["لِذِكْرِ","lidhik'ri","at (the) remembrance (of) Allah","স্মরণে"],["ٱللَّهِ","l-lahi","at (the) remembrance (of) Allah","আল্লাহ্‌র"],["وَمَا","wamā","and what","এবং যা"],["نَزَلَ","nazala","has come down","অবতীর্ণ হয়েছে"],["مِنَ","mina","of","থেকে"],["ٱلْحَقِّ","l-ḥaqi","the truth","সত্য"],["وَلَا","walā","And not","এবং না"],["يَكُونُوا۟","yakūnū","they become","তারা হবে"],["كَٱلَّذِينَ","ka-alladhīna","like those who","(তাদের) মত যাদের"],["أُوتُوا۟","ūtū","were given","দেওয়া হয়েছিল"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","কিতাব"],["مِن","min","before","মধ্য হতে"],["قَبْلُ","qablu","before","ইতি পূর্বে"],["فَطَالَ","faṭāla","(and) was prolonged","অতঃপর অতিবাহিত হল"],["عَلَيْهِمُ","‘alayhimu","for them","তাদের উপর"],["ٱلْأَمَدُ","l-amadu","the term","বহুকাল"],["فَقَسَتْ","faqasat","so hardened","এখন শক্ত হয়ে গিয়েছে"],["قُلُوبُهُمْ ۖ","qulūbuhum","their hearts","তাদের অন্তরগুলো"],["وَكَثِيرٌۭ","wakathīrun","and many","এবং অধিকাংশই"],["مِّنْهُمْ","min'hum","of them","তাদের মধ্য হতে"],["فَـٰسِقُونَ","fāsiqūna","(are) defiantly disobedient","সত্যত্যাগী"]],"t":"۞ أَلَمْ يَأْنِ لِلَّذِينَ ءَامَ<o>نُوٓ</><s>ا۟</> أَ<k>ن تَ</>خْشَعَ قُلُوبُهُمْ لِذِكْرِ <h>ٱ</>للَّهِ وَمَا نَزَلَ مِنَ <h>ٱ</>لْحَقِّ وَلَا يَكُونُو<s>ا۟</> كَ<h>ٱ</>لَّذِينَ أُوتُو<s>ا۟</> <h>ٱ</>لْكِ<m>تَٰ</>بَ مِ<k>ن قَ</><q>بْ</>لُ فَطَالَ عَلَيْهِمُ <h>ٱ</>لْأَمَدُ فَقَسَتْ قُلُوبُهُمْ ۖ وَكَثِي<d>رٌۭ مِّ</>نْهُمْ <m>فَٰ</>سِ<p>قُو</>نَ"},{"n":17,"w":[["ٱعْلَمُوٓا۟","i‘'lamū","Know","তোমরা জেনে রাখ"],["أَنَّ","anna","that","যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يُحْىِ","yuḥ'yī","gives life","জীবিত করেন"],["ٱلْأَرْضَ","l-arḍa","(to) the earth","মাটিকে"],["بَعْدَ","ba‘da","after","পরে"],["مَوْتِهَا ۚ","mawtihā","its death","তার মৃত্যুর"],["قَدْ","qad","Indeed","নিশ্চয়ই"],["بَيَّنَّا","bayyannā","We have made clear","আমরা বর্ণনা করেছি"],["لَكُمُ","lakumu","to you","তোমাদের জন্য"],["ٱلْـَٔايَـٰتِ","l-āyāti","the Signs","নিদর্শনগুলোকে"],["لَعَلَّكُمْ","la‘allakum","so that you may","তোমরা সম্ভবত"],["تَعْقِلُونَ","ta‘qilūna","understand","বুঝতে পারবে"]],"t":"ٱعْلَ<o>مُوٓ</><s>ا۟</> أَ<g>نَّ</> <h>ٱ</>للَّهَ يُحْىِ <h>ٱ</>لْأَرْضَ بَعْدَ مَوْتِهَا ۚ قَ<q>دْ</> بَيَّ<g>نَّ</>ا لَكُمُ <h>ٱ</>لْءَا<m>يَٰ</>تِ لَعَلَّكُمْ تَعْقِ<p>لُو</>نَ"},{"n":18,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلْمُصَّدِّقِينَ","l-muṣadiqīna","the men who give charity","দানশীল পুরুষরা"],["وَٱلْمُصَّدِّقَـٰتِ","wal-muṣadiqāti","and the women who give charity","ও দানশীল নারীরা"],["وَأَقْرَضُوا۟","wa-aqraḍū","and who lend","এবং যারা ঋণ দিয়েছে"],["ٱللَّهَ","l-laha","(to) Allah","আল্লাহ্কে"],["قَرْضًا","qarḍan","a loan","ঋণ"],["حَسَنًۭا","ḥasanan","goodly","উত্তম"],["يُضَـٰعَفُ","yuḍā‘afu","it will be multiplied","বহুগুণ বাড়িয়ে দেওয়া হবে"],["لَهُمْ","lahum","for them","তাদের জন্যে"],["وَلَهُمْ","walahum","and for them","এবং তাদের জন্যে রয়েছে"],["أَجْرٌۭ","ajrun","(is) a reward","পুরস্কার"],["كَرِيمٌۭ","karīmun","noble","সম্মানজনক"]],"t":"إِ<g>نَّ</> <h>ٱ</>لْمُصَّدِّقِينَ وَ<h>ٱ</>لْمُصَّدِّ<m>قَٰ</>تِ وَأَ<q>قْ</>رَضُو<s>ا۟</> <h>ٱ</>للَّهَ قَرْضًا حَسَ<d>نًۭا يُ</><m>ضَٰ</>عَفُ لَهُمْ وَلَهُمْ أَ<q>جْ</><k>رٌۭ كَ</><p>رِي</>مٌۭ"},{"n":19,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["بِٱللَّهِ","bil-lahi","in Allah","আল্লাহ্‌র উপর"],["وَرُسُلِهِۦٓ","warusulihi","and His Messengers","এবং তঁর রাসূলদের (উপর)"],["أُو۟لَـٰٓئِكَ","ulāika","[those]","ঐসব লোক"],["هُمُ","humu","they","তারাই"],["ٱلصِّدِّيقُونَ ۖ","l-ṣidīqūna","(are) the truthful","সিদ্দিক (সত্যনিষ্ঠ)"],["وَٱلشُّهَدَآءُ","wal-shuhadāu","and the martyrs","এবং (তারাই) শহীদ"],["عِندَ","‘inda","(are) with","কাছে"],["رَبِّهِمْ","rabbihim","their Lord","তাদের রবের"],["لَهُمْ","lahum","For them","তাদের জন্যে রয়েছে"],["أَجْرُهُمْ","ajruhum","(is) their reward","তাদের পুরস্কার"],["وَنُورُهُمْ ۖ","wanūruhum","and their light","ও তাদের জ্যোতি"],["وَٱلَّذِينَ","wa-alladhīna","But those who","এবং যারা"],["كَفَرُوا۟","kafarū","disbelieve","অস্বীকার করেছে"],["وَكَذَّبُوا۟","wakadhabū","and deny","ও মিথ্যা মনে করেছে"],["بِـَٔايَـٰتِنَآ","biāyātinā","Our Verses","আমাদের আয়াত গুলোকে"],["أُو۟لَـٰٓئِكَ","ulāika","those","ঐসব লোক"],["أَصْحَـٰبُ","aṣḥābu","(are the) companions","অধিবাসী (হবে)"],["ٱلْجَحِيمِ","l-jaḥīmi","(of) the Hellfire","জাহান্নামের"]],"t":"وَ<h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> بِ<h>ٱ</>للَّهِ وَرُسُلِ<o>هِۦٓ</> أُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</><l>ل</>صِّدِّيقُونَ ۖ وَ<h>ٱ</><l>ل</>شُّهَ<o>دَآ</>ءُ عِ<k>ندَ</> رَبِّهِمْ لَهُمْ أَ<q>جْ</>رُهُمْ وَنُورُهُمْ ۖ وَ<h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> وَكَذَّبُو<s>ا۟</> بِـَٔا<m>يَٰ</>تِ<o>نَآ</> أُ<s>و۟</><o>لَٰٓ</>ئِكَ أَصْ<m>حَٰ</>بُ <h>ٱ</>لْجَ<p>حِي</>مِ"},{"n":20,"w":[["ٱعْلَمُوٓا۟","i‘'lamū","Know","তোমরা জেনে রাখ"],["أَنَّمَا","annamā","that","প্রকৃতপক্ষে"],["ٱلْحَيَوٰةُ","l-ḥayatu","the life","জীবন"],["ٱلدُّنْيَا","l-dun'yā","(of) the world","(এই) দুনিয়ার"],["لَعِبٌۭ","la‘ibun","(is) play","ক্রীড়া"],["وَلَهْوٌۭ","walahwun","and amusement","ও কৌতুক (মাত্র)"],["وَزِينَةٌۭ","wazīnatun","and adornment","এবং জাঁকজমক"],["وَتَفَاخُرٌۢ","watafākhurun","and boasting","ও পারস্পরিক গৌরব অহংকার"],["بَيْنَكُمْ","baynakum","among you","তোমাদের মাঝে"],["وَتَكَاثُرٌۭ","watakāthurun","and competition in increase","ও পারস্পরিক প্রাচুর্য লাভের প্রতিযোগিতা"],["فِى","fī","of","ক্ষেত্রে"],["ٱلْأَمْوَٰلِ","l-amwāli","the wealth","সম্পদ সমুহের"],["وَٱلْأَوْلَـٰدِ ۖ","wal-awlādi","and the children","ও সন্তানসন্ততিতে"],["كَمَثَلِ","kamathali","like (the) example","(এর) উপমা যেমন"],["غَيْثٍ","ghaythin","(of) a rain","বৃষ্টি (হলে)"],["أَعْجَبَ","a‘jaba","pleases","চমৎকৃত করে"],["ٱلْكُفَّارَ","l-kufāra","the tillers","কৃষককে"],["نَبَاتُهُۥ","nabātuhu","its growth","তার উদ্ভিদ সম্ভার"],["ثُمَّ","thumma","then","এরপর"],["يَهِيجُ","yahīju","it dries","শুকিয়ে  যায়"],["فَتَرَىٰهُ","fatarāhu","and you see it","অতঃপর তুমি তা দেখ"],["مُصْفَرًّۭا","muṣ'farran","turning yellow","হলুদবর্ণ (হতে)"],["ثُمَّ","thumma","then","এরপর"],["يَكُونُ","yakūnu","becomes","সেটা হয়ে যায়"],["حُطَـٰمًۭا ۖ","ḥuṭāman","debris","খড়কুটা"],["وَفِى","wafī","And in","আর মধ্যে আছে"],["ٱلْـَٔاخِرَةِ","l-ākhirati","the Hereafter","আখেরাতের"],["عَذَابٌۭ","‘adhābun","(is) a punishment","শাস্তি"],["شَدِيدٌۭ","shadīdun","severe","কঠোর"],["وَمَغْفِرَةٌۭ","wamaghfiratun","and forgiveness","আর (আছে) ক্ষমা"],["مِّنَ","mina","from","পক্ষ হতে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌র"],["وَرِضْوَٰنٌۭ ۚ","wariḍ'wānun","and Pleasure","এবং সন্তুষ্টিও"],["وَمَا","wamā","But not","এবং নয়"],["ٱلْحَيَوٰةُ","l-ḥayatu","(is) the life","জীবন"],["ٱلدُّنْيَآ","l-dun'yā","(of) the world","দুনিয়ার"],["إِلَّا","illā","except","এছাড়া"],["مَتَـٰعُ","matā‘u","(the) enjoyment","সামগ্রী"],["ٱلْغُرُورِ","l-ghurūri","(of) delusion","ছলনার"]],"t":"ٱعْلَ<o>مُوٓ</><s>ا۟</> أَ<g>نَّ</>مَا <h>ٱ</>لْحَيَ<s>وٰ</>ةُ <h>ٱ</><l>ل</>دُّنْيَا لَعِ<d>بٌۭ وَ</>لَهْ<d>وٌۭ وَ</>زِينَ<d>ةٌۭ وَ</>تَفَاخُ<i>رٌۢ بَ</>يْنَكُمْ وَتَكَاثُ<k>رٌۭ فِ</>ى <h>ٱ</>لْأَمْ<m>وَٰ</>لِ وَ<h>ٱ</>لْأَوْ<m>لَٰ</>دِ ۖ كَمَثَلِ غَيْثٍ أَعْجَبَ <h>ٱ</>لْكُفَّارَ نَبَاتُهُ<m>ۥ</> ثُ<g>مَّ</> يَهِيجُ فَتَرَ<m>ىٰ</>هُ مُصْفَ<k>رًّۭا ثُ</><g>مَّ</> يَكُونُ حُ<m>طَٰ</><d>مًۭا ۖ وَ</>فِى <h>ٱ</>لْءَاخِرَةِ عَذَا<k>بٌۭ شَ</>دِي<d>دٌۭ وَ</>مَغْفِرَ<d>ةٌۭ مِّ</>نَ <h>ٱ</>للَّهِ وَرِضْ<m>وَٰ</><d>نٌۭ ۚ وَ</>مَا <h>ٱ</>لْحَيَ<s>وٰ</>ةُ <h>ٱ</><l>ل</>دُّنْ<o>يَآ</> إِلَّا مَ<m>تَٰ</>عُ <h>ٱ</>لْغُ<p>رُو</>رِ"},{"n":21,"w":[["سَابِقُوٓا۟","sābiqū","Race","তোমরা এগিয়ে যাও"],["إِلَىٰ","ilā","to","দিকে"],["مَغْفِرَةٍۢ","maghfiratin","(the) forgiveness","ক্ষমার"],["مِّن","min","from","পক্ষ হতে"],["رَّبِّكُمْ","rabbikum","your Lord","তোমাদের রবের"],["وَجَنَّةٍ","wajannatin","and a Garden","ও (এমন) জান্নাতের"],["عَرْضُهَا","‘arḍuhā","its width","যার প্রশস্ততা"],["كَعَرْضِ","ka‘arḍi","(is) like (the) width","প্রশস্ততার মতো"],["ٱلسَّمَآءِ","l-samāi","(of) the heaven","আকাশের"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীর"],["أُعِدَّتْ","u‘iddat","prepared","প্রস্তুত করা হয়েছে"],["لِلَّذِينَ","lilladhīna","for those who","(তাদের) জন্যে যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["بِٱللَّهِ","bil-lahi","in Allah","আল্লাহ্‌র উপর"],["وَرُسُلِهِۦ ۚ","warusulihi","and His Messengers","ও তাঁর রাসূলদের (উপর)"],["ذَٰلِكَ","dhālika","That","এটা"],["فَضْلُ","faḍlu","(is the) Bounty","অনুগ্রহ"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["يُؤْتِيهِ","yu'tīhi","He gives","তা দান করবেন"],["مَن","man","(to) whom","যাকে"],["يَشَآءُ ۚ","yashāu","He wills","তিনি চান"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["ذُو","dhū","(is) the Possessor of Bounty","অধিকারী"],["ٱلْفَضْلِ","l-faḍli","(is) the Possessor of Bounty","অনুগ্রহের"],["ٱلْعَظِيمِ","l-‘aẓīmi","the Great","মহা"]],"t":"سَابِ<o>قُوٓ</><s>ا۟</> إِلَىٰ مَغْفِرَ<d>ةٍۢ مِّ</><w>ن رَّ</>بِّكُمْ وَجَ<g>نَّ</>ةٍ عَرْضُهَا كَعَرْضِ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ وَ<h>ٱ</>لْأَرْضِ أُعِدَّتْ لِلَّذِينَ ءَامَنُو<s>ا۟</> بِ<h>ٱ</>للَّهِ وَرُسُلِ<m>هِۦ</> ۚ <m>ذَٰ</>لِكَ فَضْلُ <h>ٱ</>للَّهِ يُؤْتِيهِ <d>مَن يَ</><o>شَآ</>ءُ ۚ وَ<h>ٱ</>للَّهُ ذُو <h>ٱ</>لْفَضْلِ <h>ٱ</>لْعَ<p>ظِي</>مِ"},{"n":22,"w":[["مَآ","mā","Not","না"],["أَصَابَ","aṣāba","strikes","আপতিত"],["مِن","min","any","কোনো"],["مُّصِيبَةٍۢ","muṣībatin","disaster","বিপদ"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["وَلَا","walā","and not","আর না"],["فِىٓ","fī","in","উপর"],["أَنفُسِكُمْ","anfusikum","yourselves","তোমাদের নিজেদের"],["إِلَّا","illā","but","এছাড়া যা"],["فِى","fī","in","আছে"],["كِتَـٰبٍۢ","kitābin","a Register","একটি কিতাবে (লিখিত)"],["مِّن","min","before","থেকে"],["قَبْلِ","qabli","before","পূর্বেই"],["أَن","an","that","যে"],["نَّبْرَأَهَآ ۚ","nabra-ahā","We bring it into existence","তা আমরা ঘটাব"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ذَٰلِكَ","dhālika","that","এটা"],["عَلَى","‘alā","for","জন্যে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌র"],["يَسِيرٌۭ","yasīrun","(is) easy","সহজ"]],"t":"<o>مَآ</> أَصَابَ <d>مِن مُّ</>صِيبَ<k>ةٍۢ فِ</>ى <h>ٱ</>لْأَرْضِ وَلَا <o>فِىٓ</> أَ<k>نفُ</>سِكُمْ إِلَّا فِى كِ<m>تَٰ</><d>بٍۢ مِّ</><k>ن قَ</><q>بْ</>لِ <d>أَن نَّ</><q>بْ</>رَأَ<o>هَآ ۚ</> إِ<g>نَّ</> <m>ذَٰ</>لِكَ عَلَى <h>ٱ</>للَّهِ يَ<p>سِي</>رٌۭ"},{"n":23,"w":[["لِّكَيْلَا","likaylā","So that you may not","না এটা এজন্য যে"],["تَأْسَوْا۟","tasaw","grieve","তোমরা বিমর্ষ হও"],["عَلَىٰ","‘alā","over","উপর"],["مَا","mā","what","যা"],["فَاتَكُمْ","fātakum","has escaped you","তোমরা হারাও"],["وَلَا","walā","and (do) not","এবং না"],["تَفْرَحُوا۟","tafraḥū","exult","উল্লাসিত হও তোমরা"],["بِمَآ","bimā","at what","ঐ বিষয়ে যা"],["ءَاتَىٰكُمْ ۗ","ātākum","He has given you","তোমাদের দান করেন তিনি"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ্‌‌"],["لَا","lā","(does) not","না"],["يُحِبُّ","yuḥibbu","love","ভালবাসেন"],["كُلَّ","kulla","every","প্রত্যেক"],["مُخْتَالٍۢ","mukh'tālin","self-deluded","উদ্ধত"],["فَخُورٍ","fakhūrin","boaster","অহংকারীকে"]],"t":"لِّكَيْلَا تَأْسَوْ<s>ا۟</> عَلَىٰ مَا فَاتَكُمْ وَلَا تَفْرَحُو<s>ا۟</> بِ<o>مَآ</> ءَاتَ<m>ىٰ</>كُمْ ۗ وَ<h>ٱ</>للَّهُ لَا يُحِبُّ كُلَّ مُخْتَا<k>لٍۢ فَ</><p>خُو</>رٍ"},{"n":24,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["يَبْخَلُونَ","yabkhalūna","are stingy","কৃপণতা করে"],["وَيَأْمُرُونَ","wayamurūna","and enjoin","ও নির্দেশ দেয়"],["ٱلنَّاسَ","l-nāsa","(on) the people","লোকদেরকে"],["بِٱلْبُخْلِ ۗ","bil-bukh'li","stinginess","কৃপণতার ব্যাপারে"],["وَمَن","waman","And whoever","এবং যে"],["يَتَوَلَّ","yatawalla","turns away","মুখ ফিরিয়ে নেয় (সে জেনে রাখুক)"],["فَإِنَّ","fa-inna","then indeed","তবে নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["هُوَ","huwa","He","তিনিই"],["ٱلْغَنِىُّ","l-ghaniyu","(is) Free of need","অভাবমুক্ত"],["ٱلْحَمِيدُ","l-ḥamīdu","the Praiseworthy","প্রশংসিত"]],"t":"ٱلَّذِينَ يَ<q>بْ</>خَلُونَ وَيَأْمُرُونَ <h>ٱ</><l>ل</><g>نَّ</>اسَ بِ<h>ٱ</>لْبُخْلِ ۗ وَ<d>مَن يَ</>تَوَلَّ فَإِ<g>نَّ</> <h>ٱ</>للَّهَ هُوَ <h>ٱ</>لْغَنِىُّ <h>ٱ</>لْحَ<p>مِي</><q>دُ</>"},{"n":25,"w":[["لَقَدْ","laqad","Certainly","নিশ্চয়ই"],["أَرْسَلْنَا","arsalnā","We sent","আমরা পাঠিয়েছি"],["رُسُلَنَا","rusulanā","Our Messengers","আমাদের রাসূলদেরকে"],["بِٱلْبَيِّنَـٰتِ","bil-bayināti","with clear proofs","সুস্পষ্ট প্রমাণাদি সহ"],["وَأَنزَلْنَا","wa-anzalnā","and We sent down","এবং আমরা অবতীর্ণ করেছি"],["مَعَهُمُ","ma‘ahumu","with them","তাদের সাথে"],["ٱلْكِتَـٰبَ","l-kitāba","the Scripture","কিতাব"],["وَٱلْمِيزَانَ","wal-mīzāna","and the Balance","ও ন্যায়দণ্ড"],["لِيَقُومَ","liyaqūma","that may establish","প্রতিষ্ঠিত হয় যেন"],["ٱلنَّاسُ","l-nāsu","the people","মানুষ"],["بِٱلْقِسْطِ ۖ","bil-qis'ṭi","justice","ন্যায়বিচারের সাথে"],["وَأَنزَلْنَا","wa-anzalnā","And We sent down","ও আমরা অবতীর্ণ করেছি"],["ٱلْحَدِيدَ","l-ḥadīda","[the] iron","লোহা"],["فِيهِ","fīhi","wherein","যার মধ্যে রয়েছে"],["بَأْسٌۭ","basun","(is) power","শক্তি"],["شَدِيدٌۭ","shadīdun","mighty","প্রচণ্ড"],["وَمَنَـٰفِعُ","wamanāfi‘u","and benefits","এবং নানা উপকার"],["لِلنَّاسِ","lilnnāsi","for the people","মানুষের জন্য"],["وَلِيَعْلَمَ","waliya‘lama","and so that Allah may make evident","এবং (এ উদ্দেশ্যে ) জানেন যেন"],["ٱللَّهُ","l-lahu","and so that Allah may make evident","আল্লাহ্‌"],["مَن","man","(he) who","কে"],["يَنصُرُهُۥ","yanṣuruhu","helps Him","তাঁকে সাহায্য করে"],["وَرُسُلَهُۥ","warusulahu","and His Messengers","ও তাঁর রাসূলদের"],["بِٱلْغَيْبِ ۚ","bil-ghaybi","unseen","(তাঁকে) না দেখা অবস্থায়"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["قَوِىٌّ","qawiyyun","(is) All-Strong","শক্তিধর"],["عَزِيزٌۭ","‘azīzun","All-Mighty","পরাক্রমাশালী"]],"t":"لَقَ<q>دْ</> أَرْسَلْنَا رُسُلَنَا بِ<h>ٱ</>لْبَيِّ<m>نَٰ</>تِ وَأَ<k>نزَ</>لْنَا مَعَهُمُ <h>ٱ</>لْكِ<m>تَٰ</>بَ وَ<h>ٱ</>لْمِيزَانَ لِيَقُومَ <h>ٱ</><l>ل</><g>نَّ</>اسُ بِ<h>ٱ</>لْقِسْطِ ۖ وَأَ<k>نزَ</>لْنَا <h>ٱ</>لْحَدِيدَ فِيهِ بَأْ<k>سٌۭ شَ</>دِي<d>دٌۭ وَ</>مَ<m>نَٰ</>فِعُ لِل<g>نَّ</>اسِ وَلِيَعْلَمَ <h>ٱ</>للَّهُ <d>مَن يَ</><k>نصُ</>رُهُ<m>ۥ</> وَرُسُلَهُ<m>ۥ</> بِ<h>ٱ</>لْغَيْبِ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ قَوِىٌّ عَ<p>زِي</>زٌۭ"},{"n":26,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["أَرْسَلْنَا","arsalnā","We sent","আমরা পাঠিয়েছি"],["نُوحًۭا","nūḥan","Nuh","নূহকে"],["وَإِبْرَٰهِيمَ","wa-ib'rāhīma","and Ibrahim","ও ইবরাহীমকে"],["وَجَعَلْنَا","waja‘alnā","and We placed","এবং আমরা বজায় রেখেছি"],["فِى","fī","in","মধ্যে"],["ذُرِّيَّتِهِمَا","dhurriyyatihimā","their offspring","উভয়ের বংশধরদের"],["ٱلنُّبُوَّةَ","l-nubuwata","Prophethood","নবুয়্যত"],["وَٱلْكِتَـٰبَ ۖ","wal-kitāba","and the Scripture","ও কিতাব"],["فَمِنْهُم","famin'hum","and among them","অতঃপর তাদের মধ্য হতে"],["مُّهْتَدٍۢ ۖ","muh'tadin","(is) a guided one","(কিছু হয়েছে) সৎ পথ প্রাপ্ত"],["وَكَثِيرٌۭ","wakathīrun","but most","আর অনেকেই"],["مِّنْهُمْ","min'hum","of them","তাদের মধ্যে হতে"],["فَـٰسِقُونَ","fāsiqūna","(are) defiantly disobediently","সত্যত্যাগী"]],"t":"وَلَقَ<q>دْ</> أَرْسَلْنَا نُو<d>حًۭا وَ</>إِ<q>بْ</><m>رَٰ</>هِيمَ وَجَعَلْنَا فِى ذُرِّيَّتِهِمَا <h>ٱ</><l>ل</><g>نُّ</>بُوَّةَ وَ<h>ٱ</>لْكِ<m>تَٰ</>بَ ۖ فَمِنْ<y>هُم مُّ</>هْتَ<d>دٍۢ ۖ وَ</>كَثِي<d>رٌۭ مِّ</>نْهُمْ <m>فَٰ</>سِ<p>قُو</>نَ"},{"n":27,"w":[["ثُمَّ","thumma","Then","এরপর"],["قَفَّيْنَا","qaffaynā","We sent","আমরা অনুগামী করেছি"],["عَلَىٰٓ","‘alā","on","উপর"],["ءَاثَـٰرِهِم","āthārihim","their footsteps","তাদের পদচিহ্নের"],["بِرُسُلِنَا","birusulinā","Our Messengers","আমাদের  রাসূলদেরকে"],["وَقَفَّيْنَا","waqaffaynā","and We followed","এবং আমরা এরপর অনুগামী করেছি"],["بِعِيسَى","bi‘īsā","with Isa","ঈসাকে"],["ٱبْنِ","ib'ni","son","পুত্র"],["مَرْيَمَ","maryama","(of) Maryam","মারইয়ামের"],["وَءَاتَيْنَـٰهُ","waātaynāhu","and We gave him","এবং আমরা তাকে দিয়েছি"],["ٱلْإِنجِيلَ","l-injīla","the Injeel","ইনজিল"],["وَجَعَلْنَا","waja‘alnā","And We placed","এবং আমরা দিয়েছিলাম"],["فِى","fī","in","মধ্যে"],["قُلُوبِ","qulūbi","(the) hearts","অন্তরসমূহের"],["ٱلَّذِينَ","alladhīna","(of) those who","(তাদের) যারা"],["ٱتَّبَعُوهُ","ittaba‘ūhu","followed him","তা্র অনুসরণ করেছে"],["رَأْفَةًۭ","rafatan","compassion","করুণা"],["وَرَحْمَةًۭ","waraḥmatan","and mercy","ও দয়া"],["وَرَهْبَانِيَّةً","warahbāniyyatan","But monasticism","আর বৈরাগ্যবাদ/ সন্ন্যাসবাদ"],["ٱبْتَدَعُوهَا","ib'tada‘ūhā","they innovated ","তা তারা উদ্ভাবন করেছিল"],["مَا","mā","not","না"],["كَتَبْنَـٰهَا","katabnāhā","We prescribed it","তার আমরা বিধান দিয়েছি"],["عَلَيْهِمْ","‘alayhim","for them ","তাদের উপর"],["إِلَّا","illā","only","কিন্তু"],["ٱبْتِغَآءَ","ib'tighāa","seeking","(তারা করেছিল) সন্ধানে"],["رِضْوَٰنِ","riḍ'wāni","(the) pleasure","সন্তুষ্টির"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহ্‌র"],["فَمَا","famā","but not","কিন্তু না"],["رَعَوْهَا","ra‘awhā","they observed it","তা পালন করেছিল"],["حَقَّ","ḥaqqa","(with) right","যথাযথ ভাবে"],["رِعَايَتِهَا ۖ","ri‘āyatihā","observance","তা পালন করা (উচিৎ যেমন)"],["فَـَٔاتَيْنَا","faātaynā","So We gave","অতঃপর আমরা দিয়েছিলাম"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["ءَامَنُوا۟","āmanū","believed","ঈমান এনেছিল"],["مِنْهُمْ","min'hum","among them","তাদের মধ্য হতে"],["أَجْرَهُمْ ۖ","ajrahum","their reward","তাদের পুরস্কার"],["وَكَثِيرٌۭ","wakathīrun","but most","এবং অধিকাংশ"],["مِّنْهُمْ","min'hum","of them","তাদের মধ্যকার"],["فَـٰسِقُونَ","fāsiqūna","(are) defiantly disobediently","সত্যত্যাগী (ফাসেক)"]],"t":"ثُ<g>مَّ</> قَفَّيْنَا عَلَ<o>ىٰٓ</> ءَا<m>ثَٰ</>رِ<f>هِم بِ</>رُسُلِنَا وَقَفَّيْنَا بِعِيسَى <h>ٱ</><q>بْ</>نِ مَرْيَمَ وَءَاتَيْ<m>نَٰ</>هُ <h>ٱ</>لْإِ<k>نجِ</>يلَ وَجَعَلْنَا فِى قُلُوبِ <h>ٱ</>لَّذِينَ <h>ٱ</>تَّبَعُوهُ رَأْفَ<d>ةًۭ وَ</>رَحْمَ<d>ةًۭ وَ</>رَهْبَانِيَّةً <h>ٱ</><q>بْ</>تَدَعُوهَا مَا كَتَ<q>بْ</><m>نَٰ</>هَا عَلَيْهِمْ إِلَّا <h>ٱ</><q>بْ</>تِ<o>غَآ</>ءَ رِضْ<m>وَٰ</>نِ <h>ٱ</>للَّهِ فَمَا رَعَوْهَا حَقَّ رِعَايَتِهَا ۖ فَـَٔاتَيْنَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> مِنْهُمْ أَ<q>جْ</>رَهُمْ ۖ وَكَثِي<d>رٌۭ مِّ</>نْهُمْ <m>فَٰ</>سِ<p>قُو</>نَ"},{"n":28,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you who believe","হে"],["ٱلَّذِينَ","alladhīna","O you who believe","যারা"],["ءَامَنُوا۟","āmanū","O you who believe","ঈমান এনেছ"],["ٱتَّقُوا۟","ittaqū","Fear","তোমরা ভয় করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["وَءَامِنُوا۟","waāminū","and believe","ও তোমরা ঈমান আন"],["بِرَسُولِهِۦ","birasūlihi","in His Messenger","তাঁর রাসূলের প্রতি"],["يُؤْتِكُمْ","yu'tikum","He will give you","তিনি তোমাদের দিবেন"],["كِفْلَيْنِ","kif'layni","double portion","দ্বিগুণ অংশ"],["مِن","min","of","থেকে"],["رَّحْمَتِهِۦ","raḥmatihi","His Mercy","তাঁর অনুগ্রহ"],["وَيَجْعَل","wayaj‘al","and He will make","এবং দেবেন"],["لَّكُمْ","lakum","for you","তোমাদের জন্যে"],["نُورًۭا","nūran","a light","জ্যোতি"],["تَمْشُونَ","tamshūna","you will walk","তোমরা চলবে"],["بِهِۦ","bihi","with it","তা দিয়ে"],["وَيَغْفِرْ","wayaghfir","and He will forgive","ও ক্ষমা করবেন"],["لَكُمْ ۚ","lakum","you","তোমাদেরকে"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ্‌"],["غَفُورٌۭ","ghafūrun","(is) Oft-Forgiving","ক্ষমাশীল"],["رَّحِيمٌۭ","raḥīmun","Most Merciful","পরম দয়ালু"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> <h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</>للَّهَ وَءَامِنُو<s>ا۟</> بِرَسُولِ<m>هِۦ</> يُؤْتِكُمْ كِفْلَيْنِ <w>مِن رَّ</>حْمَتِ<m>هِۦ</> وَيَ<q>جْ</>عَل لَّكُمْ نُو<k>رًۭا تَ</>مْشُونَ بِ<m>هِۦ</> وَيَغْفِرْ لَكُمْ ۚ وَ<h>ٱ</>للَّهُ غَفُو<w>رٌۭ رَّ</><p>حِي</>مٌۭ"},{"n":29,"w":[["لِّئَلَّا","li-allā","So that","যেন"],["يَعْلَمَ","ya‘lama","may know","জানে"],["أَهْلُ","ahlu","(the) People","অধিকারীরা"],["ٱلْكِتَـٰبِ","l-kitābi","(of) the Book","কিতাবের"],["أَلَّا","allā","that not","যে না"],["يَقْدِرُونَ","yaqdirūna","they have power","তারা অধিকার রাখে"],["عَلَىٰ","‘alā","over","উপর"],["شَىْءٍۢ","shayin","anything","কোনো কিছুই"],["مِّن","min","from","মধ্যে হতে"],["فَضْلِ","faḍli","(the) Bounty","অনুগ্রহের"],["ٱللَّهِ ۙ","l-lahi","(of) Allah","আল্লাহর"],["وَأَنَّ","wa-anna","and that","এবং নিশ্চয়ই"],["ٱلْفَضْلَ","l-faḍla","the Bounty","(সমস্ত) অনুগ্রহ"],["بِيَدِ","biyadi","(is) in Allah's Hand","হাতে"],["ٱللَّهِ","l-lahi","(is) in Allah's Hand","আল্লাহ্‌রই"],["يُؤْتِيهِ","yu'tīhi","He gives it","তা দান করেন তিনি"],["مَن","man","whom","যাকে"],["يَشَآءُ ۚ","yashāu","He wills","তিনি চান"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["ذُو","dhū","(is) the Possessor of Bounty","অধিকারী"],["ٱلْفَضْلِ","l-faḍli","(is) the Possessor of Bounty","অনুগ্রহের"],["ٱلْعَظِيمِ","l-‘aẓīmi","the Great","মহা"]],"t":"لِّئَلَّا يَعْلَمَ أَهْلُ <h>ٱ</>لْكِ<m>تَٰ</>بِ أَلَّا يَ<q>قْ</>دِرُونَ عَلَىٰ <d>شَىْءٍۢ مِّ</><k>ن فَ</>ضْلِ <h>ٱ</>للَّهِ ۙ وَأَ<g>نَّ</> <h>ٱ</>لْفَضْلَ بِيَدِ <h>ٱ</>للَّهِ يُؤْتِيهِ <d>مَن يَ</><o>شَآ</>ءُ ۚ وَ<h>ٱ</>للَّهُ ذُو <h>ٱ</>لْفَضْلِ <h>ٱ</>لْعَ<p>ظِي</>مِ"}]}