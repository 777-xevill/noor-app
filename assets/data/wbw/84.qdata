{"n":84,"a":[{"n":1,"w":[["إِذَا","idhā","When","যখন"],["ٱلسَّمَآءُ","l-samāu","the sky","আকাশ"],["ٱنشَقَّتْ","inshaqqat","is split asunder","ফেটে পড়বে"]],"t":"إِذَا <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءُ <h>ٱ</><k>نشَ</>قَّتْ"},{"n":2,"w":[["وَأَذِنَتْ","wa-adhinat","And has listened","এবং সে নির্দেশ পালন করবে"],["لِرَبِّهَا","lirabbihā","to its Lord","তার রবের"],["وَحُقَّتْ","waḥuqqat","and was obligated","ও এটাই তার করণীয়"]],"t":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ"},{"n":3,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["ٱلْأَرْضُ","l-arḍu","the earth","পৃথিবী"],["مُدَّتْ","muddat","is spread","সম্প্রসারিত করা হবে"]],"t":"وَإِذَا <h>ٱ</>لْأَرْضُ مُدَّتْ"},{"n":4,"w":[["وَأَلْقَتْ","wa-alqat","And has cast out","এবং নিক্ষেপ করবে"],["مَا","mā","what","যা"],["فِيهَا","fīhā","(is) in it","তার মধ্যে আছে"],["وَتَخَلَّتْ","watakhallat","and becomes empty","এবং তা শূন্য হয়ে যাবে"]],"t":"وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ"},{"n":5,"w":[["وَأَذِنَتْ","wa-adhinat","And has listened","এবং সে নির্দেশ পালন করবে"],["لِرَبِّهَا","lirabbihā","to its Lord","তার রবের"],["وَحُقَّتْ","waḥuqqat","and was obligated","এবং এটাই তার জন্য করণীয়"]],"t":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ"},{"n":6,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O","হে"],["ٱلْإِنسَـٰنُ","l-insānu","mankind","মানুষ"],["إِنَّكَ","innaka","Indeed, you","নিশ্চয়ই তুমি"],["كَادِحٌ","kādiḥun","(are) laboring","পরিশ্রমকারী"],["إِلَىٰ","ilā","to","দিকে"],["رَبِّكَ","rabbika","your Lord","তোমার রবের"],["كَدْحًۭا","kadḥan","(with) exertion","কঠোর পরিশ্রম"],["فَمُلَـٰقِيهِ","famulāqīhi","and you (will) meet Him","অতঃপর তাঁর (সাথে) সাক্ষাত করবে"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لْإِ<k>نسَٰ</>نُ إِ<g>نَّ</>كَ كَادِحٌ إِلَىٰ رَبِّكَ كَ<q>دْ</><k>حًۭا فَ</>مُ<m>لَٰ</><p>قِي</>هِ"},{"n":7,"w":[["فَأَمَّا","fa-ammā","Then as for","অতঃপর (তার) ব্যাপার"],["مَنْ","man","(him) who","যাকে"],["أُوتِىَ","ūtiya","is given","দেয়া হবে"],["كِتَـٰبَهُۥ","kitābahu","his record","তার আমলনামা"],["بِيَمِينِهِۦ","biyamīnihi","in his right (hand)","তার ডান হাতে"]],"t":"فَأَ<g>مَّ</>ا مَنْ أُوتِىَ كِ<m>تَٰ</>بَهُ<m>ۥ</> بِيَمِينِهِۦ"},{"n":8,"w":[["فَسَوْفَ","fasawfa","Then soon","অতঃপর শীঘ্র"],["يُحَاسَبُ","yuḥāsabu","his account will be taken","হিসাব নেয়া হবে (তার)"],["حِسَابًۭا","ḥisāban","an account","হিসাব"],["يَسِيرًۭا","yasīran","easy","সহজ"]],"t":"فَسَوْفَ يُحَاسَبُ حِسَا<d>بًۭا يَ</>سِيرًۭا"},{"n":9,"w":[["وَيَنقَلِبُ","wayanqalibu","And he will return","এবং ফিরবে"],["إِلَىٰٓ","ilā","to","কাছে"],["أَهْلِهِۦ","ahlihi","his people","তার আপনজনের"],["مَسْرُورًۭا","masrūran","happily","আনন্দচিত্তে"]],"t":"وَيَ<k>نقَ</>لِبُ إِلَ<o>ىٰٓ</> أَهْلِ<m>هِۦ</> مَسْرُورًۭا"},{"n":10,"w":[["وَأَمَّا","wa-ammā","But as for","আর (তার) ব্যাপার"],["مَنْ","man","(him) who","যাকে"],["أُوتِىَ","ūtiya","is given","দেয়া হবে"],["كِتَـٰبَهُۥ","kitābahu","his record","তার আমলনামা"],["وَرَآءَ","warāa","behind","পিছনে"],["ظَهْرِهِۦ","ẓahrihi","his back","তার পিঠের"]],"t":"وَأَ<g>مَّ</>ا مَنْ أُوتِىَ كِ<m>تَٰ</>بَهُ<m>ۥ</> وَ<o>رَآ</>ءَ ظَهْرِهِۦ"},{"n":11,"w":[["فَسَوْفَ","fasawfa","Then soon","শীঘ্র অতঃপর"],["يَدْعُوا۟","yad‘ū","he will call","সে ডাকবে"],["ثُبُورًۭا","thubūran","(for) destruction","ধ্বংস (মৃত্যু)"]],"t":"فَسَوْفَ يَ<q>دْ</>عُو<s>ا۟</> ثُبُورًۭا"},{"n":12,"w":[["وَيَصْلَىٰ","wayaṣlā","And he will burn","এবং প্রবেশ করবে"],["سَعِيرًا","sa‘īran","(in) a Blaze","জ্বলন্ত আগুনে"]],"t":"وَيَصْلَىٰ سَعِيرًا"},{"n":13,"w":[["إِنَّهُۥ","innahu","Indeed, he","নিশ্চয়ই সে"],["كَانَ","kāna","had been","ছিল"],["فِىٓ","fī","among","মধ্যে"],["أَهْلِهِۦ","ahlihi","his people","তার স্বজনদের"],["مَسْرُورًا","masrūran","happy","আনন্দে"]],"t":"إِ<g>نَّ</>هُ<m>ۥ</> كَانَ <o>فِىٓ</> أَهْلِ<m>هِۦ</> مَسْرُورًا"},{"n":14,"w":[["إِنَّهُۥ","innahu","Indeed, he","নিশ্চয়ই সে"],["ظَنَّ","ẓanna","(had) thought","মনে করেছিল"],["أَن","an","that","যে"],["لَّن","lan","never","কখনও না"],["يَحُورَ","yaḥūra","he would return","ফিরবে"]],"t":"إِ<g>نَّ</>هُ<m>ۥ</> ظَ<g>نَّ</> <w>أَن لَّ</><d>ن يَ</><p>حُو</>رَ"},{"n":15,"w":[["بَلَىٰٓ","balā","Yes","হ্যাঁ"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["رَبَّهُۥ","rabbahu","his Lord","তার রব"],["كَانَ","kāna","was","ছিলেন"],["بِهِۦ","bihi","of him","তার উপর"],["بَصِيرًۭا","baṣīran","All-Seer","দৃষ্টিবান"]],"t":"بَلَ<o>ىٰٓ</> إِ<g>نَّ</> رَبَّهُ<m>ۥ</> كَانَ بِ<m>هِۦ</> بَصِيرًۭا"},{"n":16,"w":[["فَلَآ","falā","But nay","অতএব না"],["أُقْسِمُ","uq'simu","I swear","আমি শপথ করছি"],["بِٱلشَّفَقِ","bil-shafaqi","by the twilight glow","পশ্চিম দিগন্তের সান্ধ্য লালিমার"]],"t":"فَ<o>لَآ</> أُ<q>قْ</>سِمُ بِ<h>ٱ</><l>ل</>شَّفَ<q>قِ</>"},{"n":17,"w":[["وَٱلَّيْلِ","wa-al-layli","And the night","এবং শপথ রাতের"],["وَمَا","wamā","and what","ও যা"],["وَسَقَ","wasaqa","it envelops","সমাবেশ ঘটায়"]],"t":"وَ<h>ٱ</>لَّيْلِ وَمَا وَسَ<q>قَ</>"},{"n":18,"w":[["وَٱلْقَمَرِ","wal-qamari","And the moon","এবং শপথ চাঁদের"],["إِذَا","idhā","when","যখন"],["ٱتَّسَقَ","ittasaqa","it becomes full","পূর্ণ হয়"]],"t":"وَ<h>ٱ</>لْقَمَرِ إِذَا <h>ٱ</>تَّسَ<q>قَ</>"},{"n":19,"w":[["لَتَرْكَبُنَّ","latarkabunna","You will surely embark","তোমরা অবশ্যই আরোহণ করবে"],["طَبَقًا","ṭabaqan","(to) stage","স্তর"],["عَن","‘an","from","থেকে"],["طَبَقٍۢ","ṭabaqin","stage","স্তরে"]],"t":"لَتَرْكَبُ<g>نَّ</> طَبَقًا عَ<k>ن طَ</>بَ<q>قٍۢ</>"},{"n":20,"w":[["فَمَا","famā","So what","অতএব হলো কি"],["لَهُمْ","lahum","(is) for them","তাদের"],["لَا","lā","not","না"],["يُؤْمِنُونَ","yu'minūna","they believe","তারা ঈমান আনে"]],"t":"فَمَا لَهُمْ لَا يُؤْمِ<p>نُو</>نَ"},{"n":21,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["قُرِئَ","quri-a","is recited","পাঠ করা হয়"],["عَلَيْهِمُ","‘alayhimu","to them","তাদের কাছে"],["ٱلْقُرْءَانُ","l-qur'ānu","the Quran","কুর'আন"],["لَا","lā","not","না"],["يَسْجُدُونَ ۩","yasjudūna","they prostrate","তারা সিজদা করে"]],"t":"وَإِذَا قُرِئَ عَلَيْهِمُ <h>ٱ</>لْقُرْءَانُ لَا يَسْجُدُ<p>و</>نَ ۩"},{"n":22,"w":[["بَلِ","bali","Nay","বরং"],["ٱلَّذِينَ","alladhīna","Those who","যারা"],["كَفَرُوا۟","kafarū","disbelieved","কুফরি করেছে"],["يُكَذِّبُونَ","yukadhibūna","deny","মিথ্যারোপ করছে"]],"t":"بَلِ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> يُكَذِّ<p>بُو</>نَ"},{"n":23,"w":[["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["أَعْلَمُ","a‘lamu","(is) most knowing","ভালো জানেন"],["بِمَا","bimā","of what","ঐ বিষয়ে যা"],["يُوعُونَ","yū‘ūna","they keep within themselves","তারা পোষণ করছে"]],"t":"وَ<h>ٱ</>للَّهُ أَعْلَمُ بِمَا يُو<p>عُو</>نَ"},{"n":24,"w":[["فَبَشِّرْهُم","fabashir'hum","so give them tidings","কাজেই তাদের সুসংবাদ দাও"],["بِعَذَابٍ","bi‘adhābin","of a punishment","শাস্তির"],["أَلِيمٍ","alīmin","painful","যন্ত্রণাদায়ক"]],"t":"فَبَشِّرْ<f>هُم بِ</>عَذَابٍ أَ<p>لِي</>مٍ"},{"n":25,"w":[["إِلَّا","illā","Except","তার ব্যতিক্রম"],["ٱلَّذِينَ","alladhīna","those who","(ঐসব লোক) যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["وَعَمِلُوا۟","wa‘amilū","and do","ও করেছে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","righteous deeds","সৎকর্ম"],["لَهُمْ","lahum","For them","তাদের জন্য রয়েছে"],["أَجْرٌ","ajrun","(is) a reward","পুরস্কার"],["غَيْرُ","ghayru","never","অশেষ"],["مَمْنُونٍۭ","mamnūnin","ending","অশেষ"]],"t":"إِلَّا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ لَهُمْ أَ<q>جْ</>رٌ غَيْرُ مَمْ<p>نُو</>نٍۭ"}]}