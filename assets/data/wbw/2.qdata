not","নি কি"],["تَرَ","tara","you see","তুমি দেখ"],["إِلَى","ilā","[towards]","প্রতি"],["ٱلْمَلَإِ","l-mala-i","the chiefs","প্রধানদের"],["مِنۢ","min","of","মধ্য থেকে"],["بَنِىٓ","banī","(the) Children","বনী"],["إِسْرَٰٓءِيلَ","is'rāīla","(of) Israel","ইসরাঈলদের"],["مِنۢ","min","from","থেকে"],["بَعْدِ","ba‘di","after","পর"],["مُوسَىٰٓ","mūsā","Musa","মূসার"],["إِذْ","idh","when","যখন"],["قَالُوا۟","qālū","they said","তারা বলেছিল"],["لِنَبِىٍّۢ","linabiyyin","to a Prophet","নবীর"],["لَّهُمُ","lahumu","of theirs","তাদের জন্য"],["ٱبْعَثْ","ib'‘ath","Appoint","পাঠান"],["لَنَا","lanā","for us","আমাদের জন্য"],["مَلِكًۭا","malikan","a king","একজন রাজা"],["نُّقَـٰتِلْ","nuqātil","we may fight","যুদ্ধ করব আমরা (তার নের্তৃত্বে)"],["فِى","fī","in","মধ্যে"],["سَبِيلِ","sabīli","(the) way","পথের"],["ٱللَّهِ ۖ","l-lahi","(of) Allah","আল্লাহর"],["قَالَ","qāla","He said","সে বলল"],["هَلْ","hal","Would","যদি"],["عَسَيْتُمْ","‘asaytum","you perhaps ","তোমরা আশা কর"],["إِن","in","if","যদি"],["كُتِبَ","kutiba","prescribed","ফরজ করা হয়"],["عَلَيْكُمُ","‘alaykumu","upon you","তোমাদের উপর"],["ٱلْقِتَالُ","l-qitālu","[the] fighting","যুদ্ধ"],["أَلَّا","allā","that not","যে না"],["تُقَـٰتِلُوا۟ ۖ","tuqātilū","you fight","তোমরা যুদ্ধ করবে"],["قَالُوا۟","qālū","They said","তারা বলেছিল"],["وَمَا","wamā","And what","এবং কি"],["لَنَآ","lanā","for us","আমাদের হয়েছে"],["أَلَّا","allā","that not","যে না"],["نُقَـٰتِلَ","nuqātila","we fight","আমরা যুদ্ধ করব"],["فِى","fī","in","মধ্যে"],["سَبِيلِ","sabīli","(the) way","পথের"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَقَدْ","waqad","while surely","অথচ নিশ্চয়ই"],["أُخْرِجْنَا","ukh'rij'nā","we have been driven","আমাদেরকে বের করে দেওয়া হয়েছে"],["مِن","min","from","হতে"],["دِيَـٰرِنَا","diyārinā","our homes","আমাদের ঘরবাড়ি"],["وَأَبْنَآئِنَا ۖ","wa-abnāinā","and our children","ও আমাদের সন্তানদের (হতে)"],["فَلَمَّا","falammā","Yet, when","অতঃপর যখন"],["كُتِبَ","kutiba","was prescribed","ফরজ করা হল"],["عَلَيْهِمُ","‘alayhimu","upon them","তাদের উপর"],["ٱلْقِتَالُ","l-qitālu","the fighting","যুদ্ধের"],["تَوَلَّوْا۟","tawallaw","they turned away","তারা পিঠ ফিরাল"],["إِلَّا","illā","except","এছাড়া"],["قَلِيلًۭا","qalīlan","a few","স্বল্প সংখ্যক"],["مِّنْهُمْ ۗ","min'hum","among them","তাদের মধ্য হতে"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["عَلِيمٌۢ","‘alīmun","(is) All-Knowing","খুব অবহিত"],["بِٱلظَّـٰلِمِينَ","bil-ẓālimīna","of the wrongdoers","সীমালঙ্ঘনকারী সম্পর্কে"]],"t":"أَلَمْ تَرَ إِلَى <h>ٱ</>لْمَلَإِ <i>مِنۢ بَ</><o>نِىٓ</> إِسْ<o>رَٰٓ</>ءِيلَ <i>مِنۢ بَ</>عْدِ مُوسَ<o>ىٰٓ</> إِذْ قَالُو<s>ا۟</> لِنَبِ<w>ىٍّۢ لَّ</>هُمُ <h>ٱ</><q>بْ</>عَثْ لَنَا مَلِ<d>كًۭا نُّ</><m>قَٰ</>تِلْ فِى سَبِيلِ <h>ٱ</>للَّهِ ۖ قَالَ هَلْ عَسَيْتُمْ إِ<k>ن كُ</>تِبَ عَلَيْكُمُ <h>ٱ</>لْقِتَالُ أَلَّا تُ<m>قَٰ</>تِلُو<s>ا۟ ۖ</> قَالُو<s>ا۟</> وَمَا لَ<o>نَآ</> أَلَّا نُ<m>قَٰ</>تِلَ فِى سَبِيلِ <h>ٱ</>للَّهِ وَقَ<q>دْ</> أُخْرِ<q>جْ</>نَا مِ<k>ن دِ</><m>يَٰ</>رِنَا وَأَ<q>بْ</><o>نَآ</>ئِنَا ۖ فَلَ<g>مَّ</>ا كُتِبَ عَلَيْهِمُ <h>ٱ</>لْقِتَالُ تَوَلَّوْ<s>ا۟</> إِلَّا قَلِيلًۭ<d>ا مِّ</>نْهُمْ ۗ وَ<h>ٱ</>للَّهُ عَلِي<i>مٌۢ بِ</><h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":247,"w":[["وَقَالَ","waqāla","And said","এবং বলেছিল"],["لَهُمْ","lahum","to them","তাদের উদ্দেশে"],["نَبِيُّهُمْ","nabiyyuhum","their Prophet","তাদের নবী"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["قَدْ","qad","(has) surely","অবশ্যই"],["بَعَثَ","ba‘atha","raised","পাঠিয়েছেন"],["لَكُمْ","lakum","for you","তোমাদের জন্য"],["طَالُوتَ","ṭālūta","Talut","তালুতকে"],["مَلِكًۭا ۚ","malikan","(as) a king","রাজা হিসেবে"],["قَالُوٓا۟","qālū","They said","তারা বলেছিল"],["أَنَّىٰ","annā","How","কিরূপে"],["يَكُونُ","yakūnu","can be","হবে"],["لَهُ","lahu","for him","তার জন্য"],["ٱلْمُلْكُ","l-mul'ku","the kingship","রাজত্ব"],["عَلَيْنَا","‘alaynā","over us","আমাদের উপর"],["وَنَحْنُ","wanaḥnu","while we","অথচ আমরা"],["أَحَقُّ","aḥaqqu","(are) more entitled","অধিক যোগ্য"],["بِٱلْمُلْكِ","bil-mul'ki","to kingship","রাজত্বের"],["مِنْ