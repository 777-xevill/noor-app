d>نٍۢ ۗ وَ</>لَا يَحِلُّ لَكُمْ أَ<k>ن تَ</>أْخُذُو<s>ا۟</> مِ<g>مَّ</><o>آ</> ءَاتَيْتُمُوهُ<g>نَّ</> شَيْـًٔا إِ<o>لَّآ</> <d>أَن يَ</>خَا<o>فَآ</> أَلَّا يُقِيمَا حُدُودَ <h>ٱ</>للَّهِ ۖ فَإِنْ خِفْتُمْ أَلَّا يُقِيمَا حُدُودَ <h>ٱ</>للَّهِ فَلَا جُنَاحَ عَلَيْهِمَا فِيمَا <h>ٱ</>فْتَدَتْ بِ<m>هِۦ</> ۗ تِلْكَ حُدُودُ <h>ٱ</>للَّهِ فَلَا تَعْتَدُوهَا ۚ وَ<d>مَن يَ</>تَعَدَّ حُدُودَ <h>ٱ</>للَّهِ فَأُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مُو</>نَ"},{"n":230,"w":[["فَإِن","fa-in","Then if","অতঃপর যদি"],["طَلَّقَهَا","ṭallaqahā","he divorces her","তাকে সে তালাক দেয়"],["فَلَا","falā","then (she is) not","না তবে"],["تَحِلُّ","taḥillu","lawful","(বৈধ) হবে"],["لَهُۥ","lahu","for him","তার জন্য"],["مِنۢ","min","from","থেকে"],["بَعْدُ","ba‘du","after (that)","পরে (তালাকের)"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["تَنكِحَ","tankiḥa","she marries","সে বিয়ে করবে"],["زَوْجًا","zawjan","a spouse","(অন্য) স্বামীকে"],["غَيْرَهُۥ ۗ","ghayrahu","other than him","সে ছাড়া"],["فَإِن","fa-in","Then if","অতঃপর যদি"],["طَلَّقَهَا","ṭallaqahā","he divorces her","সে তাকে তালাক দেয়"],["فَلَا","falā","then no","নেই তবে"],["جُنَاحَ","junāḥa","sin","পাপ"],["عَلَيْهِمَآ","‘alayhimā","on them","তাদের দুজনের উপর"],["أَن","an","if","যে"],["يَتَرَاجَعَآ","yatarāja‘ā","they return to each other","পরস্পরে ফিরে আসবে"],["إِن","in","if","যদি"],["ظَنَّآ","ẓannā","they believe","দুজনেই মনে করে"],["أَن","an","that","যে"],["يُقِيمَا","yuqīmā","they (will be able to) keep","তারা দুজনে রক্ষা করতে পারবে"],["حُدُودَ","ḥudūda","(the) limits","সীমারেখা"],["ٱللَّهِ ۗ","l-lahi","(of) Allah","আল্লাহর"],["وَتِلْكَ","watil'ka","And these","এবং এটা"],["حُدُودُ","ḥudūdu","(are the) limits","সীমারেখা"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["يُبَيِّنُهَا","yubayyinuhā","He makes them clear","তা স্পষ্ট বর্ণনা করেন তিনি"],["لِقَوْمٍۢ","liqawmin","to a people","সম্প্রদায়ের জন্যে"],["يَعْلَمُونَ","ya‘lamūna","who know","(যারা) জানে"]],"t":"فَإِ<k>ن طَ</>لَّقَهَا فَلَا تَحِلُّ لَهُ<m>ۥ</> <i>