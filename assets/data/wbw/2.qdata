","(are) secluded","এতিকাফরত"],["فِى","fī","in","মধ্যে"],["ٱلْمَسَـٰجِدِ ۗ","l-masājidi","the masajid","মসজিদের"],["تِلْكَ","til'ka","These","এই"],["حُدُودُ","ḥudūdu","(are the) limits","সীমাসমূহ"],["ٱللَّهِ","l-lahi","(set by) Allah","আল্লাহর"],["فَلَا","falā","so (do) not","না তাই"],["تَقْرَبُوهَا ۗ","taqrabūhā","approach them","তার নিকটে যাবে তোমরা"],["كَذَٰلِكَ","kadhālika","Thus","এভাবে"],["يُبَيِّنُ","yubayyinu","makes clear","স্পষ্ট বর্ণনা করেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["ءَايَـٰتِهِۦ","āyātihi","His verses","তার নিদর্শনগুলো"],["لِلنَّاسِ","lilnnāsi","for [the] people","মানুষের জন্যে"],["لَعَلَّهُمْ","la‘allahum","so that they may","আশা করা যায় তারা"],["يَتَّقُونَ","yattaqūna","(become) righteous","তাকওয়া অবলম্বন করবে"]],"t":"أُحِلَّ لَكُمْ لَيْلَةَ <h>ٱ</><l>ل</>صِّيَامِ <h>ٱ</><l>ل</>رَّفَثُ إِلَىٰ نِ<o>سَآ</>ئِكُمْ ۚ هُ<g>نَّ</> لِبَا<w>سٌۭ لَّ</>كُمْ وَأَ<k>نتُ</>مْ لِبَا<w>سٌۭ لَّ</>هُ<g>نَّ</> ۗ عَلِمَ <h>ٱ</>للَّهُ أَ<g>نَّ</>كُمْ كُ<k>نتُ</>مْ تَخْتَانُونَ أَ<k>نفُ</>سَكُمْ فَتَابَ عَلَيْكُمْ وَعَفَا عَ<k>نكُ</>مْ ۖ فَ<h>ٱ</><m>لْـَٰٔ</>نَ <m>بَٰ</>شِرُوهُ<g>نَّ</> وَ<h>ٱ</><q>بْ</>تَغُو<s>ا۟</> مَا كَتَبَ <h>ٱ</>للَّهُ لَكُمْ ۚ وَكُلُو<s>ا۟</> وَ<h>ٱ</>شْرَبُو<s>ا۟</> حَتَّىٰ يَتَبَيَّنَ لَكُمُ <h>ٱ</>لْخَيْطُ <h>ٱ</>لْأَ<q>بْ</>يَضُ مِنَ <h>ٱ</>لْخَيْطِ <h>ٱ</>لْأَسْوَدِ مِنَ <h>ٱ</>لْفَ<q>جْ</>رِ ۖ ثُ<g>مَّ</> أَتِ<g>مُّ</>و<s>ا۟</> <h>ٱ</><l>ل</>صِّيَامَ إِلَى <h>ٱ</>لَّيْلِ ۚ وَلَا تُ<m>بَٰ</>شِرُوهُ<g>نَّ</> وَأَ<k>نتُ</>مْ <m>عَٰ</>كِفُونَ فِى <h>ٱ</>لْمَ<m>سَٰ</>جِدِ ۗ تِلْكَ حُدُودُ <h>ٱ</>للَّهِ فَلَا تَ<q>قْ</>رَبُوهَا ۗ كَ<m>ذَٰ</>لِكَ يُبَيِّنُ <h>ٱ</>للَّهُ ءَا<m>يَٰتِهِۦ</> لِل<g>نَّ</>اسِ لَعَلَّهُمْ يَتَّ<p>قُو</>نَ"},{"n":188,"w":[["وَلَا","walā","And (do) not","এবং না"],["تَأْكُلُوٓا۟","takulū","eat","তোমরা খেয়ো"],["أَمْوَٰلَكُم","amwālakum","your properties","ধন-সম্পদসমূহকে"],["بَيْنَكُم","baynakum","among yourselves","তোমাদের পরস্পরের"],["بِٱلْبَـٰطِلِ","bil-bāṭili","wrongfully","অন্যায়ভাবে"],["وَتُدْلُوا۟","watud'lū","and present","তোমরা (না) পেশ কর"],["بِهَآ","bihā","[with] it","তা নিয়ে"],["إِلَى","ilā","to","কাছে"],["ٱلْحُكَّامِ","l-ḥukāmi","the authorities","বিচারকদের"],["لِتَأْكُلُوا۟","litakulū","so that you may eat","তোমরা খেতে পার যেন"],["فَرِيقًۭا","farīqan","a portion","কিয়দংশ"],["مِّنْ","min","from","হতে"],["أَمْوَٰلِ","amwāli","(the) wealth","ধন-সম্পদের"],["ٱلنَّاسِ","l-nāsi","(of) the people","মানুষের"],["بِٱلْإِثْمِ","bil-ith'mi","sinfully","অন্যায়ভাবে"],["وَأَنتُمْ","wa-antum","while you","এমতাবস্থায় তোমরা"],["تَعْلَمُونَ","ta‘lamūna","know","জান"]],"t":"وَلَا تَأْكُ<o>لُوٓ</><s>ا۟</> أَمْ<m>وَٰ</>لَ<f>كُم بَ</>يْنَ<f>كُم بِ</><h>ٱ</>لْ<m>بَٰ</>طِلِ وَتُ<q>دْ</>لُو<s>ا۟</> بِ<o>هَآ</> إِلَى <h>ٱ</>لْحُكَّامِ لِتَأْكُلُو<s>ا۟</> فَرِي<d>قًۭا مِّ</>نْ أَمْ<m>وَٰ</>لِ <h>ٱ</><l>ل</><g>نَّ</>اسِ بِ<h>ٱ</>لْإِثْمِ وَأَ<k>نتُ</>مْ تَعْلَ<p>مُو</>نَ"},{"n":189,"w":[["۞ يَسْـَٔلُونَكَ","yasalūnaka","They ask you","তোমাকে তারা জিজ্ঞেস করে"],["عَنِ","‘ani","about","সম্বন্ধে"],["ٱلْأَهِلَّةِ ۖ","l-ahilati","the new moons","নতুন চাঁদ"],["قُلْ","qul","Say","তুমি বলো"],["هِىَ","hiya","They","''তা"],["مَوَٰقِيتُ","mawāqītu","(are) indicators of periods","সময় (তারিখ) নির্দেশক"],["لِلنَّاسِ","lilnnāsi","for the people","মানুষের জন্য"],["وَٱلْحَجِّ ۗ","wal-ḥaji","and (for) the Hajj","ও হজ্জের"],["وَلَيْسَ","walaysa","And it is not","এবং নেই"],["ٱلْبِرُّ","l-biru","[the] righteousness","পূণ্য"],["بِأَن","bi-an","that","যে এতে"],["تَأْتُوا۟","tatū","you come","তোমরা আস"],["ٱلْبُيُوتَ","l-buyūta","(to) the houses","ঘরগুলোতে"],["مِن","min","from","হতে"],["ظُهُورِهَا","ẓuhūrihā","their backs","তার পিছন দিক"],["وَلَـٰكِنَّ","walākinna","[and] but","কিন্তু"],["ٱلْبِرَّ","l-bira","[the] righteous","পূণ্য"],["مَنِ","mani","(is one) who","যে কেউ"],["ٱتَّقَىٰ ۗ","ittaqā","fears (Allah)","তাকওয়া অবলম্বন করবে"],["وَأْتُوا۟","watū","And come","এবং তোমরা আসো"],["ٱلْبُيُوتَ","l-buyūta","(to) the houses","ঘরগুলোতে"],["مِنْ","min","from","দিয়ে"],["أَبْوَٰبِهَا ۚ","abwābihā","their doors","তার সম্মুখ দরজাগুলো"],["وَٱتَّقُوا۟","wa-ittaqū","And fear","এবং তোমরা ভয় করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["لَعَلَّكُمْ","la‘allakum","so that you may","আশা করা যায়"],["تُفْلِحُونَ","tuf'liḥūna","(be) successful","তোমরা সফল হবে"]],"t":"۞ يَسْـَٔلُونَكَ عَنِ <h>ٱ</>لْأَهِلَّةِ ۖ قُلْ هِىَ مَ<m>وَٰ</>قِيتُ لِل<g>نَّ</>اسِ وَ<h>ٱ</>لْحَجِّ ۗ وَلَيْسَ <h>ٱ</>لْبِرُّ بِأَ<k>ن تَ</>أْتُو<s>ا۟</> <h>ٱ</>لْبُيُوتَ مِ<k>ن ظُ</>هُورِهَا وَ<m>لَٰ</>كِ<g>نَّ</> <h>ٱ</>لْبِرَّ مَنِ <h>ٱ</>تَّقَىٰ ۗ وَأْتُو<s>ا۟</> <h>ٱ</>لْبُيُوتَ مِنْ أَ<q>بْ</><m>وَٰ</>بِهَا ۚ وَ<h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</>للَّهَ لَعَلَّكُمْ تُفْلِ<p>حُو</>نَ"},{"n":190,"w":[["وَقَـٰتِلُوا۟","waqātilū","And fight","এবং তোমরা যুদ্ধ করো"],["فِى","fī","in","মধ্যে"],["سَبِيلِ","sabīli","(the) way","পথের"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["ٱلَّذِينَ","alladhīna","those who","(তাদের সাথে) যারা"],["يُقَـٰتِلُونَكُمْ","yuqātilūnakum","fight you","তোমাদের সাথে যুদ্ধ করে"],["وَلَا","walā","and (do) not","কিন্তু না"],["تَعْتَدُوٓا۟ ۚ","ta‘tadū","transgress","তোমরা সীমালংঘন করো"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَا","lā","(does) not","না"],["يُحِبُّ","yuḥibbu","like","ভালবাসেন"],["ٱلْمُعْتَدِينَ","l-mu‘'tadīna","the transgressors","সীমালংঘনকারীদেরকে"]],"t":"وَ<m>قَٰ</>تِلُو<s>ا۟</> فِى سَبِيلِ <h>ٱ</>للَّهِ <h>ٱ</>لَّذِينَ يُ<m>قَٰ</>تِلُونَكُمْ وَلَا تَعْتَ<o>دُوٓ</><s>ا۟</> ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ لَا يُحِبُّ <h>ٱ</>لْمُعْتَ<p>دِي</>نَ"},{"n":191,"w":[["وَٱقْتُلُوهُمْ","wa-uq'tulūhum","And kill them","এবং তাদেরকে হত্যা করো"],["حَيْثُ","ḥaythu","wherever","যেখানেই"],["ثَقِفْتُمُوهُمْ","thaqif'tumūhum","you find them","তাদেরকে তোমরা পাও"],["وَأَخْرِجُوهُم","wa-akhrijūhum","and drive them out","ও তাদেরকে বের করে দাও"],["مِّنْ","min","from","থেকে"],["حَيْثُ","ḥaythu","wherever","যেখান"],["أَخْرَجُوكُمْ ۚ","akhrajūkum","they drove you out","তোমাদের বের করেছে তারা"],["وَٱلْفِتْنَةُ","wal-fit'natu","and [the] oppression","এবং বিপর্যয়"],["أَشَدُّ","ashaddu","(is) worse","গুরুতর"],["مِنَ","mina","than","চেয়ে"],["ٱلْقَتْلِ ۚ","l-qatli","[the] killing","হত্যার"],["وَلَا","walā","And (do) not","এবং না"],["تُقَـٰتِلُوهُمْ","tuqātilūhum","fight them","তাদের সাথে যুদ্ধ কর"],["عِندَ","‘inda","near","কাছে"],["ٱلْمَسْجِدِ","l-masjidi","Al-Masjid","মসজিদে"],["ٱلْحَرَامِ","l-ḥarāmi","Al-Haraam","হারামের"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["يُقَـٰتِلُوكُمْ","yuqātilūkum","they fight you","তোমাদের সাথে যুদ্ধ করে তারা"],["فِيهِ ۖ","fīhi","in it","তার মধ্যে"],["فَإِن","fa-in","Then if","তবে যদি"],["قَـٰتَلُوكُمْ","qātalūkum","they fight you","তোমাদের সাথে যুদ্ধ করে তারা"],["فَٱقْتُلُوهُمْ ۗ","fa-uq'tulūhum","then kill them","তাহলে তোমরা হত্যা করো"],["كَذَٰلِكَ","kadhālika","Such","এরূপই"],["جَزَآءُ","jazāu","(is the) reward","শাস্তি"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","(of) the disbelievers","কাফেরদের"]],"t":"وَ<h>ٱ</><q>قْ</>تُلُوهُمْ حَيْثُ ثَقِفْتُمُوهُمْ وَأَخْرِجُو<y>هُم مِّ</>نْ حَيْثُ أَخْرَجُوكُمْ ۚ وَ<h>ٱ</>لْفِتْنَةُ أَشَدُّ مِنَ <h>ٱ</>لْقَتْلِ ۚ وَلَا تُ<m>قَٰ</>تِلُوهُمْ عِ<k>ندَ</> <h>ٱ</>لْمَسْجِدِ <h>ٱ</>لْحَرَامِ حَتَّىٰ يُ<m>قَٰ</>تِلُوكُمْ فِيهِ ۖ فَإِ<k>ن قَٰ</>تَلُوكُمْ فَ<h>ٱ</><q>قْ</>تُلُوهُمْ ۗ كَ<m>ذَٰ</>لِكَ جَ<o>زَآ</>ءُ <h>ٱ</>لْ<m>كَٰ</>فِ<p>رِي</>نَ"},{"n":192,"w":[["فَإِنِ","fa-ini","Then if","অতঃপর যদি"],["ٱنتَهَوْا۟","intahaw","they cease","তারা বিরত হয়"],["فَإِنَّ","fa-inna","then indeed","তবে নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["غَفُورٌۭ","ghafūrun","(is) Oft-Forgiving","ক্ষমাশীল"],["رَّحِيمٌۭ","raḥīmun","Most Merciful","পরম দয়ালু"]],"t":"فَإِنِ <h>ٱ</><k>نتَ</>هَوْ<s>ا۟</> فَإِ<g>نَّ</> <h>ٱ</>للَّهَ غَفُو<w>رٌۭ رَّ</><p>حِي</>مٌۭ"},{"n":193,"w":[["وَقَـٰتِلُوهُمْ","waqātilūhum","And fight (against) them","এবং তোমরা যুদ্ধ করতে থাকো তাদেরকে"],["حَتَّىٰ","ḥattā","until","যতক্ষণ"],["لَا","lā","not","না"],["تَكُونَ","takūna","(there) is","থাকে"],["فِتْنَةٌۭ","fit'natun","oppression","বিপর্যয়"],["وَيَكُونَ","wayakūna","and becomes","ও হয়"],["ٱلدِّينُ","l-dīnu","the religion","দ্বীন"],["لِلَّهِ ۖ","lillahi","for Allah","আল্লাহর জন্যে (নির্দিষ্ট)"],["فَإِنِ","fa-ini","Then if","যদি অতঃপর"],["ٱنتَهَوْا۟","intahaw","they cease","তারা বিরত হয়"],["فَلَا","falā","then (let there be) no","নেই তবে"],["عُدْوَٰنَ","‘ud'wāna","hostility","আক্রমণের (সুযোগ)"],["إِلَّا","illā","except","ছাড়া"],["عَلَى","‘alā","against","উপর"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the oppressors","সীমালঙ্ঘনকারীদের"]],"t":"وَ<m>قَٰ</>تِلُوهُمْ حَتَّىٰ لَا تَكُونَ فِتْنَ<d>ةٌۭ وَ</>يَكُونَ <h>ٱ</><l>ل</>دِّينُ لِلَّهِ ۖ فَإِنِ <h>ٱ</><k>نتَ</>هَوْ<s>ا۟</> فَلَا عُ<q>دْ</><m>وَٰ</>نَ إِلَّا عَلَى <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":194,"w":[["ٱلشَّهْرُ","al-shahru","The month","মাস"],["ٱلْحَرَامُ","l-ḥarāmu","[the] sacred","পবিত্র"],["بِٱلشَّهْرِ","bil-shahri","(is) for the month","মাস বিনিময়ে"],["ٱلْحَرَامِ","l-ḥarāmi","[the] sacred","পবিত্র"],["وَٱلْحُرُمَـٰتُ","wal-ḥurumātu","and for all the violations","এবং সমস্ত পবিত্র বিষয় (লংঘনের)"],["قِصَاصٌۭ ۚ","qiṣāṣun","(is) legal retribution","বদলা (রয়েছে)"],["فَمَنِ","famani","Then whoever","যে তাই"],["ٱعْتَدَىٰ","i‘'tadā","transgressed","বাড়াবাড়ি করবে"],["عَلَيْكُمْ","‘alaykum","upon you","তোমাদের উপর"],["فَٱعْتَدُوا۟","fa-i‘'tadū","then you transgress","তোমরাও তখন বাড়াবাড়ির বদলা নাও"],["عَلَيْهِ","‘alayhi","on him","তার উপর"],["بِمِثْلِ","bimith'li","in (the) same manner","অনুরূপ"],["مَا","mā","(as)","যেমন"],["ٱعْتَدَىٰ","i‘'tadā","he transgressed","বাড়াবাড়ি করেছে"],["عَلَيْكُمْ ۚ","‘alaykum","upon you","তোমাদের উপর"],["وَٱتَّقُوا۟","wa-ittaqū","And fear","এবং তোমরা ভয় করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["وَٱعْلَمُوٓا۟","wa-i‘'lamū","and know","এবং তোমরা জেনে রাখো"],["أَنَّ","anna","that","যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["مَعَ","ma‘a","(is) with","সাথে (আছেন)"],["ٱلْمُتَّقِينَ","l-mutaqīna","those who fear (Him)","মুত্তাকীদের"]],"t":"ٱ<l>ل</>شَّهْرُ <h>ٱ</>لْحَرَامُ بِ<h>ٱ</><l>ل</>شَّهْرِ <h>ٱ</>لْحَرَامِ وَ<h>ٱ</>لْحُرُ<m>مَٰ</>تُ قِصَا<k>صٌۭ ۚ فَ</>مَنِ <h>ٱ</>عْتَدَىٰ عَلَيْكُمْ فَ<h>ٱ</>عْتَدُو<s>ا۟</> عَلَيْهِ بِمِثْلِ مَا <h>ٱ</>عْتَدَىٰ عَلَيْكُمْ ۚ وَ<h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</>للَّهَ وَ<h>ٱ</>عْلَ<o>مُوٓ</><s>ا۟</> أَ<g>نَّ</> <h>ٱ</>للَّهَ مَعَ <h>ٱ</>لْمُتَّ<p>قِي</>نَ"},{"n":195,"w":[["وَأَنفِقُوا۟","wa-anfiqū","And spend","এবং তোমরা ব্যয় করো"],["فِى","fī","in","মধ্যে"],["سَبِيلِ","sabīli","(the) way","পথের"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَلَا","walā","and (do) not","এবং না"],["تُلْقُوا۟","tul'qū","throw (yourselves)","তোমরা নিক্ষেপ করো"],["بِأَيْدِيكُمْ","bi-aydīkum","[with your hands]","তোমাদের হাতে (নিজেদেরকে)"],["إِلَى","ilā","into","দিকে"],["ٱلتَّهْلُكَةِ ۛ","l-tahlukati","[the] destruction","ধ্বংসের"],["وَأَحْسِنُوٓا۟ ۛ","wa-aḥsinū","And do good","এবং তোমরা অনুগ্রহ করো"],["إِنَّ","inna","indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يُحِبُّ","yuḥibbu","loves","ভালবাসেন"],["ٱلْمُحْسِنِينَ","l-muḥ'sinīna","the good-doers","অনুগ্রহকারীদেরকে"]],"t":"وَأَ<k>نفِ</>قُو<s>ا۟</> فِى سَبِيلِ <h>ٱ</>للَّهِ وَلَا تُلْقُو<s>ا۟</> بِأَيْدِيكُمْ إِلَى <h>ٱ</><l>ل</>تَّهْلُكَةِ ۛ وَأَحْسِ<o>نُوٓ</><s>ا۟</> ۛ إِ<g>نَّ</> <h>ٱ</>للَّهَ يُحِبُّ <h>ٱ</>لْمُحْسِ<p>نِي</>نَ"},{"n":196,"w":[["وَأَتِمُّوا۟","wa-atimmū","And complete","এবং তোমরা পূর্ণ করো"],["ٱلْحَجَّ","l-ḥaja","the Hajj","হজ্জ"],["وَٱلْعُمْرَةَ","wal-‘um'rata","and the Umrah","ও ওমরাহ"],["لِلَّهِ ۚ","lillahi","for Allah","আল্লাহরই জন্যে"],["فَإِنْ","fa-in","And if","অতঃপর যদি"],["أُحْصِرْتُمْ","uḥ'ṣir'tum","you are held back","তোমরা বাধাপ্রাপ্ত হও"],["فَمَا","famā","then (offer) whatever","যা তবে"],["ٱسْتَيْسَرَ","is'taysara","(can be) obtained with ease","সহজলভ্য হয়"],["مِنَ","mina","of","থেকে"],["ٱلْهَدْىِ ۖ","l-hadyi","the sacrificial animal","কুরবানি (তাই পেশ কর)"],["وَلَا","walā","And (do) not","এবং না"],["تَحْلِقُوا۟","taḥliqū","shave","তোমরা মুণ্ডন করো"],["رُءُوسَكُمْ","ruūsakum","your heads","তোমাদের মাথা"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["يَبْلُغَ","yablugha","reaches","পৌঁছে"],["ٱلْهَدْىُ","l-hadyu","the sacrificial animal","কুরবানি (তাই পেশ কর)"],["مَحِلَّهُ