َ مِ<k>نكُ</>مُ <h>ٱ</><l>ل</>شَّهْرَ فَلْيَصُمْهُ ۖ وَمَ<k>ن كَ</>انَ مَرِيضًا أَوْ عَلَىٰ سَفَ<k>رٍۢ فَ</>عِدَّ<d>ةٌۭ مِّ</>نْ أَيَّامٍ أُخَرَ ۗ يُرِيدُ <h>ٱ</>للَّهُ بِكُمُ <h>ٱ</>لْيُسْرَ وَلَا يُرِيدُ بِكُمُ <h>ٱ</>لْعُسْرَ وَلِتُكْمِلُو<s>ا۟</> <h>ٱ</>لْعِدَّةَ وَلِتُكَبِّرُو<s>ا۟</> <h>ٱ</>للَّهَ عَلَىٰ مَا هَدَ<m>ىٰ</>كُمْ وَلَعَلَّكُمْ تَشْكُ<p>رُو</>نَ"},{"n":186,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["سَأَلَكَ","sa-alaka","ask you","তোমাকে প্রশ্ন করে"],["عِبَادِى","‘ibādī","My servants","আমার বান্দারা"],["عَنِّى","‘annī","about Me","আমার সম্পর্কে"],["فَإِنِّى","fa-innī","then indeed I am","তখন (বল) আমি নিশ্চয়ই"],["قَرِيبٌ ۖ","qarībun","near","নিকটেই"],["أُجِيبُ","ujību","I respond","আমি সাড়া দিই"],["دَعْوَةَ","da‘wata","(to the) invocation","ডাকে"],["ٱلدَّاعِ","l-dā‘i","(of) the supplicant","প্রার্থনাকারীর"],["إِذَا","idhā","when","যখন"],["دَعَانِ ۖ","da‘āni","he calls Me","আমাকে ডাকে"],["فَلْيَسْتَجِيبُوا۟","falyastajībū","So let them respond","অতএব তারাও সাড়া দিক"],["لِى","lī","to Me","আমার"],["وَلْيُؤْمِنُوا۟","walyu'minū","and let them believe","এবং তারা ঈমান আনুক"],["بِى","bī","in Me","আমার উপর"],["لَعَلَّهُمْ","la‘allahum","so that they may","হয়ত তারা"],["يَرْشُدُونَ","yarshudūna","(be) led aright","সত্যের সন্ধান পাবে"]],"t":"وَإِذَا سَأَلَكَ عِبَادِى عَ<g>نِّ</>ى فَإِ<g>نِّ</>ى قَرِيبٌ ۖ أُجِيبُ دَعْوَةَ <h>ٱ</><l>ل</>دَّاعِ إِذَا دَعَانِ ۖ فَلْيَسْتَجِيبُو<s>ا۟</> لِى وَلْيُؤْمِنُو<s>ا۟</> بِى لَعَلَّهُمْ يَرْشُ<p>دُو</>نَ"},{"n":187,"w":[["أُحِلَّ","uḥilla","Permitted","(হালাল) করা হয়েছে"],["لَكُمْ","lakum","for you","তোমাদের জন্যে"],["لَيْلَةَ","laylata","(in the) nights","রাতে"],["ٱلصِّيَامِ","l-ṣiyāmi","(of) fasting","সাওমের"],["ٱلرَّفَثُ","l-rafathu","(is) the approach","স্ত্রী সহবাস"],["إِلَىٰ","ilā","to","সাথে"],["نِسَآئِكُمْ ۚ","nisāikum","your wives","তোমাদের স্ত্রীদের"],["هُنَّ","hunna","They","তারা"],["لِبَاسٌۭ","libāsun","(are) garments","পোশাক"],["لَّكُمْ","lakum","for you","তোমাদের জন্যে"],["وَأَنتُمْ","wa-antum","and you"