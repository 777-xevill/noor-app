<s>ا۟</> أَ<g>نَّ</> <h>ٱ</>للَّهَ غَنِىٌّ حَ<p>مِي</><q>دٌ</>"},{"n":268,"w":[["ٱلشَّيْطَـٰنُ","al-shayṭānu","The Shaitaan","শয়তান"],["يَعِدُكُمُ","ya‘idukumu","promises you","তোমাদের ভয় দেখায়"],["ٱلْفَقْرَ","l-faqra","[the] poverty","দারিদ্র্যের"],["وَيَأْمُرُكُم","wayamurukum","and orders you","এবং নির্দেশ দেয়"],["بِٱلْفَحْشَآءِ ۖ","bil-faḥshāi","to immorality","অশ্লীলতার"],["وَٱللَّهُ","wal-lahu","while Allah","এবং আল্লাহ"],["يَعِدُكُم","ya‘idukum","promises you","তোমাদের প্রতিশ্রুতি দেন"],["مَّغْفِرَةًۭ","maghfiratan","forgiveness","ক্ষমার"],["مِّنْهُ","min'hu","from Him","তাঁর থেকে"],["وَفَضْلًۭا ۗ","wafaḍlan","and bounty","ও তাঁর অনুগ্রহের"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["وَٰسِعٌ","wāsi‘un","(is) All-Encompassing","প্রাচুর্যময়"],["عَلِيمٌۭ","‘alīmun","All-Knowing","সর্বজ্ঞ"]],"t":"ٱ<l>ل</>شَّيْ<m>طَٰ</>نُ يَعِدُكُمُ <h>ٱ</>لْفَ<q>قْ</>رَ وَيَأْمُرُ<f>كُم بِ</><h>ٱ</>لْفَحْ<o>شَآ</>ءِ ۖ وَ<h>ٱ</>للَّهُ يَعِدُ<y>كُم مَّ</>غْفِرَ<d>ةًۭ مِّ</>نْهُ وَفَضْلًۭ<d>ا ۗ وَ</><h>ٱ</>للَّهُ <m>وَٰ</>سِعٌ عَ<p>لِي</>مٌۭ"},{"n":269,"w":[["يُؤْتِى","yu'tī","He grants","দেন তিনি"],["ٱلْحِكْمَةَ","l-ḥik'mata","[the] wisdom","প্রজ্ঞা"],["مَن","man","(to) whom","যাকে"],["يَشَآءُ ۚ","yashāu","He wills","তিনি ইচ্ছা করেন"],["وَمَن","waman","and whoever","এবং যাকে"],["يُؤْتَ","yu'ta","is granted","দেয়া হয়েছে"],["ٱلْحِكْمَةَ","l-ḥik'mata","[the] wisdom","প্রজ্ঞা"],["فَقَدْ","faqad","then certainly","তবে নিশ্চয়ই"],["أُوتِىَ","ūtiya","he is granted","তাকে দেয়া হয়েছে"],["خَيْرًۭا","khayran","good","কল্যাণ"],["كَثِيرًۭا ۗ","kathīran","abundant","অনেক"],["وَمَا","wamā","And none","এবং না"],["يَذَّكَّرُ","yadhakkaru","remembers","শিক্ষা নেয় (এ থেকে)"],["إِلَّآ","illā","except","এছাড়া"],["أُو۟لُوا۟","ulū","those","সম্পন্নরা"],["ٱلْأَلْبَـٰبِ","l-albābi","(of) understanding","বোধশক্তি"]],"t":"يُؤْتِى <h>ٱ</>لْحِكْمَةَ <d>مَن يَ</><o>شَآ</>ءُ ۚ وَ<d>مَن يُ</>ؤْتَ <h>ٱ</>لْحِكْمَةَ فَقَ<q>دْ</> أُوتِىَ خَيْ<k>رًۭا كَ</>ثِي<d>رًۭا ۗ وَ</>مَا يَذَّكَّرُ إِ<o>لَّآ</> أُ<s>و۟</>لُو<s>ا۟</> <h>ٱ</>لْأَلْ<p>بَٰ</><q>بِ</>"},{"n":270,"w":[["وَمَآ","wamā","And whatever","এবং যা"],["أَنفَقْتُم","anfaqtum","you spend","তোমরা ব্যয় করেছ"],["مِّن","min","(out) of","কোনো"],["نَّفَقَةٍ","nafaqatin","(your) expenditures","খরচা খরচ"],["أَوْ","aw","or","অথবা"],["نَذَرْتُم","nadhartum","you vow","তোমরা মানত কর"],["مِّن","min","of","কোনো"],["نَّذْرٍۢ","nadhrin","vow(s)","মানত"],["فَإِنَّ","fa-inna","then indeed","নিশ্চয়ই অতঃপর"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يَعْلَمُهُۥ ۗ","ya‘lamuhu","knows it","তা জানেন"],["وَمَا","wamā","and not","এবং নেই"],["لِلظَّـٰلِمِينَ","lilẓẓālimīna","for the wrongdoers","সীমালঙ্ঘনকারীদের জন্য"],["مِنْ","min","any","কোনো"],["أَنصَارٍ","anṣārin","helpers","সাহায্যকারী"]],"t":"وَ<o>مَآ</> أَ<k>نفَ</><q>قْ</><y>تُم مِّ</><d>ن نَّ</>فَقَةٍ أَوْ نَذَرْ<y>تُم مِّ</><d>ن نَّ</>ذْ<k>رٍۢ فَ</>إِ<g>نَّ</> <h>ٱ</>للَّهَ يَعْلَمُهُ<m>ۥ</> ۗ وَمَا لِل<m>ظَّٰ</>لِمِينَ مِنْ أَ<k>نصَ</><p>ا</>رٍ"},{"n":271,"w":[["إِن","in","If","যদি"],["تُبْدُوا۟","tub'dū","you disclose","তোমরা প্রকাশ্যে দাও"],["ٱلصَّدَقَـٰتِ","l-ṣadaqāti","the charities","সদকা সমূহ"],["فَنِعِمَّا","fani‘immā","then good","উত্তম তবে"],["هِىَ ۖ","hiya","it (is)","তা"],["وَإِن","wa-in","But if","আর যদি"],["تُخْفُوهَا","tukh'fūhā","you keep it secret","তা তোমরা গোপনে কর"],["وَتُؤْتُوهَا","watu'tūhā","and give it","ও তোমরা তা দাও"],["ٱلْفُقَرَآءَ","l-fuqarāa","(to) the poor","অভাবগ্রস্তদেরকে"],["فَهُوَ","fahuwa","then it","তা তবে"],["خَيْرٌۭ","khayrun","(is) better","(আরও) ভালো"],["لَّكُمْ ۚ","lakum","for you","তোমাদের জন্য"],["وَيُكَفِّرُ","wayukaffiru","And He will remove","এবং দূর করবেন"],["عَنكُم","‘ankum","from you","তোমাদের থেকে"],["مِّن","min","[of]","কিছু কিছু"],["سَيِّـَٔاتِكُمْ ۗ","sayyiātikum","your evil deeds","তোমাদের পাপগুলো"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["بِمَا","bimā","with what","ঐ বিষয় যা"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা কাজ কর"],["خَبِيرٌۭ","khabīrun","(is) All-Aware","ভালোভাবে অবহিত"]],"t":"إِ<k>ن تُ</><q>بْ</>دُو<s>ا۟</> <h>ٱ</><l>ل</>صَّدَ<m>قَٰ</>تِ فَنِعِ<g>مَّ</>ا هِىَ ۖ وَإِ<k>ن تُ</>خْفُوهَا وَتُؤْتُوهَا <h>ٱ</>لْفُقَ<o>رَآ</>ءَ فَهُوَ خَيْ<w>رٌۭ لَّ</>كُمْ ۚ وَيُكَفِّرُ عَ<k>نكُ</><y>م مِّ</><k>ن سَ</>يِّـَٔاتِكُمْ ۗ وَ<h>ٱ</>للَّهُ بِمَا تَعْمَلُونَ خَ<p>بِي</>رٌۭ"},{"n":272,"w":[["۞ لَّيْسَ","laysa","Not","নয়"],["عَلَيْكَ","‘alayka","on you","তোমার উপর (দায়িত্ব)"],["هُدَىٰهُمْ","hudāhum","(is) their guidance","তাদের সৎপথ গ্রহণের"],["وَلَـٰكِنَّ","walākinna","[and] but","কিন্তু"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يَهْدِى","yahdī","guides","পথ দেখান"],["مَن","man","whom","যাকে"],["يَشَآءُ ۗ","yashāu","He wills","তিনি চান"],["وَمَا","wamā","And whatever","এবং যা"],["تُنفِقُوا۟","tunfiqū","you spend","তোমরা ব্যয় কর"],["مِنْ","min","of","কোনো"],["خَيْرٍۢ","khayrin","good","সম্পদ"],["فَلِأَنفُسِكُمْ ۚ","fali-anfusikum","then it is for yourself","তোমাদের তবে তা নিজেদের জন্য"],["وَمَا","wamā","and not","এবং না"],["تُنفِقُونَ","tunfiqūna","you spend","তোমরা ব্যয় কর"],["إِلَّا","illā","except","এছাড়া যে"],["ٱبْتِغَآءَ","ib'tighāa","seeking","সন্ধানে"],["وَجْهِ","wajhi","(the) face","চেহারা"],["ٱللَّهِ ۚ","l-lahi","(of) Allah","আল্লাহর"],["وَمَا","wamā","And whatever","এবং যা"],["تُنفِقُوا۟","tunfiqū","you spend","তোমরা খরচ কর"],["مِنْ","min","of","কোনো"],["خَيْرٍۢ","khayrin","good","সম্পদ"],["يُوَفَّ","yuwaffa","will be repaid in full","পূর্ণ দেয়া হবে"],["إِلَيْكُمْ","ilaykum","to you","তোমাদের প্রতি"],["وَأَنتُمْ","wa-antum","and you","ও তোমাদের (প্রতি)"],["لَا","lā","(will) not","না"],["تُظْلَمُونَ","tuẓ'lamūna","be wronged","অন্যায় করা হবে"]],"t":"۞ لَّيْسَ عَلَيْكَ هُدَ<m>ىٰ</>هُمْ وَ<m>لَٰ</>كِ<g>نَّ</> <h>ٱ</>للَّهَ يَهْدِى <d>مَن يَ</><o>شَآ</>ءُ ۗ وَمَا تُ<k>نفِ</>قُو<s>ا۟</> مِنْ خَيْ<k>رٍۢ فَ</>لِأَ<k>نفُ</>سِكُمْ ۚ وَمَا تُ<k>نفِ</>قُونَ إِلَّا <h>ٱ</><q>بْ</>تِ<o>غَآ</>ءَ وَ<q>جْ</>هِ <h>ٱ</>للَّهِ ۚ وَمَا تُ<k>نفِ</>قُو<s>ا۟</> مِنْ خَيْ<d>رٍۢ يُ</>وَفَّ إِلَيْكُمْ وَأَ<k>نتُ</>مْ لَا تُظْلَ<p>مُو</>نَ"},{"n":273,"w":[["لِلْفُقَرَآءِ","lil'fuqarāi","For the poor","অভাবগ্রস্তদের জন্য"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["أُحْصِرُوا۟","uḥ'ṣirū","are wrapped up","আটকে পড়েছে (ব্যস্ততার কারণে)"],["فِى","fī","in","মধ্যে"],["سَبِيلِ","sabīli","(the) way","পথের"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["لَا","lā","not","না"],["يَسْتَطِيعُونَ","yastaṭī‘ūna","they are able","তারা পারে"],["ضَرْبًۭا","ḍarban","(to) move about","ঘোরাফিরা করতে"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর (অর্থাৎ উপার্জন করতে)"],["يَحْسَبُهُمُ","yaḥsabuhumu","Think (about) them","তাদেরকে মনে করে"],["ٱلْجَاهِلُ","l-jāhilu","the ignorant one","অজ্ঞ লোকেরা"],["أَغْنِيَآءَ","aghniyāa","(that they are) self-sufficient","অভাবমুক্ত"],["مِنَ","mina","(because) of","কারণে"],["ٱلتَّعَفُّفِ","l-ta‘afufi","(their) restraint","না চাওয়ার"],["تَعْرِفُهُم","ta‘rifuhum","you recognize them","তাদেরকে তুমি চিনবে"],["بِسِيمَـٰهُمْ","bisīmāhum","by their mark","তাদের লক্ষণ দিয়ে"],["لَا","lā","Not","না"],["يَسْـَٔلُونَ","yasalūna","(do) they ask","তারা চায়"],["ٱلنَّاسَ","l-nāsa","the people","মানুষ (থেকে)"],["إِلْحَافًۭا ۗ","il'ḥāfan","with importunity","নাছোড় হয়ে"],["وَمَا","wamā","And whatever","এবং যা"],["تُنفِقُوا۟","tunfiqū","you spend","তোমরা ব্যয় কর"],["مِنْ","min","of","হতে"],["خَيْرٍۢ","khayrin","good","সম্পদ"],["فَإِنَّ","fa-inna","then indeed","অতঃপর নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["بِهِۦ","bihi","of it","তা সম্পর্কে"],["عَلِيمٌ","‘alīmun","(is) All-Knower","খুব অবহিত"]],"t":"لِلْفُقَ<o>رَآ</>ءِ <h>ٱ</>لَّذِينَ أُحْصِرُو<s>ا۟</> فِى سَبِيلِ <h>ٱ</>للَّهِ لَا يَسْتَطِيعُونَ ضَرْ<k>بًۭا فِ</>ى <h>ٱ</>لْأَرْضِ يَحْسَبُهُمُ <h>ٱ</>لْجَاهِلُ أَغْنِ<o>يَآ</>ءَ مِنَ <h>ٱ</><l>ل</>تَّعَفُّفِ تَعْرِفُ<f>هُم بِ</>سِي<m>مَٰ</>هُمْ لَا يَسْـَٔلُونَ <h>ٱ</><l>ل</><g>نَّ</>اسَ إِلْحَا<d>فًۭا ۗ وَ</>مَا تُ<k>نفِ</>قُو<s>ا۟</> مِنْ خَيْ<k>رٍۢ فَ</>إِ<g>نَّ</> <h>ٱ</>للَّهَ بِ<m>هِۦ</> عَ<p>لِي</>مٌ"},{"n":274,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["يُنفِقُونَ","yunfiqūna","spend","ব্যয় করে"],["أَمْوَٰلَهُم","amwālahum","their wealth","তাদের সম্পদ সমূহকে"],["بِٱلَّيْلِ","bi-al-layli","by night","রাতে"],["وَٱلنَّهَارِ","wal-nahāri","and day","ও দিনে"],["سِرًّۭا","sirran","secretly","গোপনে"],["وَعَلَانِيَةًۭ","wa‘alāniyatan","and openly","ও প্রকাশ্যে"],["فَلَهُمْ","falahum","then for them","ফলে (রয়েছে) তাদের জন্য"],["أَجْرُهُمْ","ajruhum","(is) their reward","তাদের পুরস্কার"],["عِندَ","‘inda","with","কাছে"],["رَبِّهِمْ","rabbihim","their Lord","তাদের রবের"],["وَلَا","walā","and no","এবং নেই"],["خَوْفٌ","khawfun","fear","কোনো ভয়"],["عَلَيْهِمْ","‘alayhim","on them","তাদের জন্য"],["وَلَا","walā","and not","এবং না"],["هُمْ","hum","they","তারা"],["يَحْزَنُونَ","yaḥzanūna","will grieve","দুঃখিত হবে"]],"t":"ٱلَّذِينَ يُ<k>نفِ</>قُونَ أَمْ<m>وَٰ</>لَ<f>هُم بِ</><h>ٱ</>لَّيْلِ وَ<h>ٱ</><l>ل</><g>نَّ</>هَارِ سِ<d>رًّۭا وَ</>عَلَانِيَ<k>ةًۭ فَ</>لَهُمْ أَ<q>جْ</>رُهُمْ عِ<k>ندَ</> رَبِّهِمْ وَلَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَ<p>نُو</>نَ"},{"n":275,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["يَأْكُلُونَ","yakulūna","consume","খায়"],["ٱلرِّبَوٰا۟","l-riba","[the] usury","সুদ"],["لَا","lā","not","না"],["يَقُومُونَ","yaqūmūna","they can stand","তারা দাঁড়াবে"],["إِلَّا","illā","except","এছাড়া"],["كَمَا","kamā","like","যেমন"],["يَقُومُ","yaqūmu","stands","দাঁড়ায়"],["ٱلَّذِى","alladhī","the one who","সেই (ব্যক্তি)"],["يَتَخَبَّطُهُ","yatakhabbaṭuhu","confounds him","যাকে পাগল করেছে"],["ٱلشَّيْطَـٰنُ","l-shayṭānu","the Shaitaan","শয়তান"],["مِنَ","mina","with","দ্বারা"],["ٱلْمَسِّ ۚ","l-masi","(his) touch","(তার) স্পর্শ"],["ذَٰلِكَ","dhālika","That","এটা"],["بِأَنَّهُمْ","bi-annahum","(is) because they","এ জন্য যে তারা"],["قَالُوٓا۟","qālū","say","বলে"],["إِنَّمَا","innamā","Only","মূলতঃ"],["ٱلْبَيْعُ","l-bay‘u","the trade","ব্যবসাও"],["مِثْلُ","mith'lu","(is) like","মতো"],["ٱلرِّبَوٰا۟ ۗ","l-riba","[the] usury","সুদেরই"],["وَأَحَلَّ","wa-aḥalla","While has permitted","অথচ বৈধ করেছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["ٱلْبَيْعَ","l-bay‘a","[the] trade","ব্যবসাকে"],["وَحَرَّمَ","waḥarrama","but (has) forbidden","ও নিষিদ্ধ করেছেন"],["ٱلرِّبَوٰا۟ ۚ","l-riba","[the] usury","সুদকে"],["فَمَن","faman","Then whoever ","অতঃপর যে"],["جَآءَهُۥ","jāahu","comes to him","তার কাছে এসেছে"],["مَوْعِظَةٌۭ","maw‘iẓatun","(the) admonition","উপদেশ"],["مِّن","min","from","পক্ষ হতে"],["رَّبِّهِۦ","rabbihi","His Lord","তার রবের"],["فَٱنتَهَىٰ","fa-intahā","and he refrained","সে অতঃপর বিরত হয়েছে (সুদখোরী হতে)"],["فَلَهُۥ","falahu","then for him","তবে তার জন্য"],["مَا","mā","what","যা"],["سَلَفَ","salafa","(has) passed","অতীত হয়ছে (হয়ে গেছে)"],["وَأَمْرُهُۥٓ","wa-amruhu","and his case","এবং তার ব্যাপার (সোপর্দ)"],["إِلَى","ilā","(is) with","কাছে"],["ٱللَّهِ ۖ","l-lahi","Allah","আল্লাহ"],["وَمَنْ","waman","and whoever","আর যে"],["عَادَ","‘āda","repeated","পুনরাবৃত্তি করবে"],["فَأُو۟لَـٰٓئِكَ","fa-ulāika","then those","তাহলে ঐসব লোক"],["أَصْحَـٰبُ","aṣḥābu","(are the) companions","অধিবাসী (হবে)"],["ٱلنَّارِ ۖ","l-nāri","(of) the Fire","আগুনের"],["هُمْ","hum","they","তারা"],["فِيهَا","fīhā","in it","তার মধ্যে"],["خَـٰلِدُونَ","khālidūna","will abide forever","চিরস্থায়ী হবে"]],"t":"ٱلَّذِينَ يَأْكُلُونَ <h>ٱ</><l>ل</>رِّبَ<s>وٰ</>ا۟ لَا يَقُومُونَ إِلَّا كَمَا يَقُومُ <h>ٱ</>لَّذِى يَتَخَبَّطُهُ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نُ مِنَ <h>ٱ</>لْمَسِّ ۚ <m>ذَٰ</>لِكَ بِأَ<g>نَّ</>هُمْ قَا<o>لُوٓ</><s>ا۟</> إِ<g>نَّ</>مَا <h>ٱ</>لْبَيْعُ مِثْلُ <h>ٱ</><l>ل</>رِّبَ<s>وٰ</>ا۟ ۗ وَأَحَلَّ <h>ٱ</>للَّهُ <h>ٱ</>لْبَيْعَ وَحَرَّمَ <h>ٱ</><l>ل</>رِّبَ<s>وٰ</>ا۟ ۚ فَمَ<k>ن جَ</><o>آ</>ءَهُ<m>ۥ</> مَوْعِظَ<d>ةٌۭ مِّ</><w>ن رَّ</>بِّ<m>هِۦ</> فَ<h>ٱ</><k>نتَ</>هَىٰ فَلَهُ<m>ۥ</> مَا سَلَفَ وَأَمْرُهُ<o>ۥٓ</> إِلَى <h>ٱ</>للَّهِ ۖ وَمَنْ عَادَ فَأُ<s>و۟</><o>لَٰٓ</>ئِكَ أَصْ<m>حَٰ</>بُ <h>ٱ</><l>ل</><g>نَّ</>ارِ ۖ هُمْ فِيهَا <m>خَٰ</>لِ<p>دُو</>نَ"},{"n":276,"w":[["يَمْحَقُ","yamḥaqu","Destroys","নিশ্চিহ্ন করেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["ٱلرِّبَوٰا۟","l-riba","the usury","সুদকে"],["وَيُرْبِى","wayur'bī","and (gives) increase","ও বর্ধিত করেন"