وَابِ<k>لٌۭ فَ</>تَرَكَهُ<m>ۥ</> صَلْ<w>دًۭا ۖ لَّ</>ا يَ<q>قْ</>دِرُونَ عَلَىٰ <d>شَىْءٍۢ مِّ</><g>مَّ</>ا كَسَبُو<s>ا۟ ۗ</> وَ<h>ٱ</>للَّهُ لَا يَهْدِى <h>ٱ</>لْقَوْمَ <h>ٱ</>لْ<m>كَٰ</>فِ<p>رِي</>نَ"},{"n":265,"w":[["وَمَثَلُ","wamathalu","And (the) example","এবং উপমা"],["ٱلَّذِينَ","alladhīna","(of) those who","(তাদের) যারা"],["يُنفِقُونَ","yunfiqūna","spend","ব্যয় করে"],["أَمْوَٰلَهُمُ","amwālahumu","their wealth","তাদের সম্পদগুলো"],["ٱبْتِغَآءَ","ib'tighāa","seeking","সন্ধানে"],["مَرْضَاتِ","marḍāti","(the) pleasure","সন্তুষ্টির"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَتَثْبِيتًۭا","watathbītan","and certainty","এবং সুদৃঢ় করতে"],["مِّنْ","min","from","বিষয়টিকে"],["أَنفُسِهِمْ","anfusihim","their (inner) souls","তাদের আত্মার"],["كَمَثَلِ","kamathali","(is) like","(তাদের) উপমা যেমন"],["جَنَّةٍۭ","jannatin","a garden","একটি বাগানের"],["بِرَبْوَةٍ","birabwatin","on a height","উঁচু ভূমিতে অবস্থিত"],["أَصَابَهَا","aṣābahā","fell on it","তাতে বর্ষিত হয়"],["وَابِلٌۭ","wābilun","heavy rain","প্রবল বৃষ্টি"],["فَـَٔاتَتْ","faātat","so it yielded","আসে অতঃপর"],["أُكُلَهَا","ukulahā","its harvest","তার ফলমূল"],["ضِعْفَيْنِ","ḍi‘'fayni","double","দ্বিগুণ"],["فَإِن","fa-in","Then if","যদি তবে"],["لَّمْ","lam","(does) not","না"],["يُصِبْهَا","yuṣib'hā","fall (on) it","তাতে বর্ষিত হয়"],["وَابِلٌۭ","wābilun","heavy rain","প্রবল বৃষ্টি"],["فَطَلٌّۭ ۗ","faṭallun","then a drizzle","সামান্য তবে বৃষ্টিই (যথেষ্ট)"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["بِمَا","bimā","of what","ঐ বিষয়ে যা"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা কাজ করছ"],["بَصِيرٌ","baṣīrun","(is) All-Seer","সম্যক দ্রষ্টা"]],"t":"وَمَثَلُ <h>ٱ</>لَّذِينَ يُ<k>نفِ</>قُونَ أَمْ<m>وَٰ</>لَهُمُ <h>ٱ</><q>بْ</>تِ<o>غَآ</>ءَ مَرْضَاتِ <h>ٱ</>للَّهِ وَتَثْبِي<d>تًۭا مِّ</>نْ أَ<k>نفُ</>سِهِمْ كَمَثَلِ جَ<g>نَّ</><i>ةٍۭ بِ</>رَ<q>بْ</>وَةٍ أَصَابَهَا وَابِ<k>لٌۭ فَـَٔ</>اتَتْ أُكُلَهَا ضِعْفَيْنِ فَ<w>إِن لَّ</>مْ يُصِ<q>بْ</>هَا وَابِ<k>لٌۭ فَ</>طَ<d>لٌّۭ ۗ وَ</><h>ٱ</>للَّهُ بِمَا تَعْمَلُونَ بَ<p>صِي</>رٌ"},{"n":266,"w":[["أَيَوَدُّ","ayawaddu","Would like","কামনা করে কি"],["أَحَدُكُمْ","aḥadukum","any of you","তোমাদের কেউ"],["أَن","an","that","যে"],["تَكُونَ","takūna","it be","হবে"],["لَهُۥ","lahu","for him","তার জন্য"],["جَنَّةٌۭ","jannatun","a garden","একটি বাগান"],["مِّن","min","of","এর"],["نَّخِيلٍۢ","nakhīlin","date-palms","খেজুর"],["وَأَعْنَابٍۢ","wa-a‘nābin","and grapevines","ও আঙ্গুরের"],["تَجْرِى","tajrī","flowing","প্রবাহিত হয়"],["مِن","min","[from]","দিয়ে"],["تَحْتِهَا","taḥtihā","underneath it","তার নিচ"],["ٱلْأَنْهَـٰرُ","l-anhāru","the rivers","ঝর্ণাসমূহ"],["لَهُۥ","lahu","for him","তার (আছে)"],["فِيهَا","fīhā","in it","তার মধ্যে"],["مِن","min","of","থেকে"],["كُلِّ","kulli","all (kinds)","সব ধরণের"],["ٱلثَّمَرَٰتِ","l-thamarāti","(of) [the] fruits","ফলমূল"],["وَأَصَابَهُ","wa-aṣābahu","and strikes him","এবং তার আপতিত হল"],["ٱلْكِبَرُ","l-kibaru","[the] old age","বার্ধক্য"],["وَلَهُۥ","walahu","and [for] his","যখন তার আছে"],["ذُرِّيَّةٌۭ","dhurriyyatun","children","সন্তান সন্ততি"],["ضُعَفَآءُ","ḍu‘afāu","(are) weak","দুর্বল"],["فَأَصَابَهَآ","fa-aṣābahā","then falls on it","তাকে অতঃপর আঘাত করল"],["إِعْصَارٌۭ","i‘'ṣārun","whirlwind","ঘূর্ণিঝড়"],["فِيهِ","fīhi","in it","তার মধ্য (আছে)"],["نَارٌۭ","nārun","(is) fire","আগুন"],["فَٱحْتَرَقَتْ ۗ","fa-iḥ'taraqat","then it is burnt","পুড়ে গেল অতঃপর (সেই বাগান)"],["كَذَٰلِكَ","kadhālika","Thus","এভাবে"],["يُبَيِّنُ","yubayyinu","makes clear","বর্ণনা করেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["لَكُمُ","lakumu","for you","তোমাদের জন্য"],["ٱلْـَٔايَـٰتِ","l-āyāti","(His) Signs","নিদর্শনাবলী"],["لَعَلَّكُمْ","la‘allakum","so that you may","আশা করা যায় তোমরা"],["تَتَفَكَّرُونَ","tatafakkarūna","ponder","চিন্তা করবে"]],"t":"أَيَوَدُّ أَحَدُكُمْ أَ<k>ن تَ</>كُونَ لَهُ<m>ۥ</> جَ<g>نَّ</><d>ةٌۭ مِّن نَّ</>خِي<d>لٍۢ وَ</>أَعْنَا<k>بٍۢ تَ</><q>جْ</>رِى مِ<k>ن تَ</>حْتِهَا <h>ٱ</>لْأَنْ<m>هَٰ</>رُ لَهُ<m>ۥ</> فِيهَا مِ<k>ن كُ</>لِّ <h>ٱ</><l>ل</>ثَّمَ<m>رَٰ</>تِ وَأَصَابَهُ <h>ٱ</>لْكِبَرُ وَلَهُ<m>ۥ</> ذُ