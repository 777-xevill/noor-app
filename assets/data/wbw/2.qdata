أْتِيَكُمُ","yatiyakumu","will come to you","তোমাদের কাছে আসবে"],["ٱلتَّابُوتُ","l-tābūtu","the ark","সেই সিন্ধুক"],["فِيهِ","fīhi","in it","যার মধ্যে (আছে)"],["سَكِينَةٌۭ","sakīnatun","(is) tranquility","প্রশান্তি"],["مِّن","min","from","পক্ষ হতে"],["رَّبِّكُمْ","rabbikum","your Lord","তোমাদের রবের"],["وَبَقِيَّةٌۭ","wabaqiyyatun","and a remnant","ও অবশিষ্ট"],["مِّمَّا","mimmā","of what","তা হতে যা"],["تَرَكَ","taraka","(was) left","ছেড়ে গেছে"],["ءَالُ","ālu","(by the) family","বংশধর"],["مُوسَىٰ","mūsā","(of) Musa","মূসার"],["وَءَالُ","waālu","and family","ও বংশধর"],["هَـٰرُونَ","hārūna","(of) Harun","হারুনের"],["تَحْمِلُهُ","taḥmiluhu","will carry it","তা বহন করে চলছে"],["ٱلْمَلَـٰٓئِكَةُ ۚ","l-malāikatu","the Angels","ফেরেশতারা"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে (রয়েছে)"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَةًۭ","laāyatan","(is) surely a sign","অবশ্যই নিদর্শন"],["لَّكُمْ","lakum","for you","তোমাদের জন্য"],["إِن","in","if","যদি"],["كُنتُم","kuntum","you are","তোমরা হও"],["مُّؤْمِنِينَ","mu'minīna","believers","মু'মিন"]],"t":"وَقَالَ لَهُمْ نَبِيُّهُمْ إِ<g>نَّ</> ءَايَةَ مُلْكِ<o>هِۦٓ</> <d>أَن يَ</>أْتِيَكُمُ <h>ٱ</><l>ل</>تَّابُوتُ فِيهِ سَكِينَ<d>ةٌۭ مِّ</><w>ن رَّ</>بِّكُمْ وَبَقِيَّ<d>ةٌۭ مِّ</><g>مَّ</>ا تَرَكَ ءَالُ مُوسَىٰ وَءَالُ <m>هَٰ</>رُونَ تَحْمِلُهُ <h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةُ ۚ إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَايَ<w>ةًۭ لَّ</>كُمْ إِ<k>ن كُنتُ</><y>م مُّ</>ؤْمِ<p>نِي</>نَ"},{"n":249,"w":[["فَلَمَّا","falammā","Then when","যখন অতঃপর"],["فَصَلَ","faṣala","set out","রওনা হল"],["طَالُوتُ","ṭālūtu","Talut","তালুত"],["بِٱلْجُنُودِ","bil-junūdi","with the forces","সৈন্যদের নিয়ে"],["قَالَ","qāla","he said","বলল"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["مُبْتَلِيكُم","mub'talīkum","will test you","তোমাদের পরীক্ষা করবেন"],["بِنَهَرٍۢ","binaharin","with a river","একটা নদী দিয়ে"],["فَمَن","faman","So whoever","যে অতঃপর"],["شَرِبَ","shariba","drinks","পান করবে"],["مِنْهُ","min'hu","from it","তা থেকে"],["فَلَيْسَ","falaysa","then he is not","সে নয় তখন"],["مِنِّى","minnī","from me","আমার দলে"],["وَمَن","waman","and whoever","এবং যে"],["لَّمْ","lam","(does) not","না"],["يَطْعَمْهُ","yaṭ‘amhu","taste it","তার স্বাদ নেবে"],["فَإِنَّهُۥ","fa-innahu","then indeed, he","নিশ্চয়ই তবে সে"],["مِنِّىٓ","minnī","(is) from me","আমার দলভুক্ত (থাকবে)"],["إِلَّا","illā","except","কিন্তু"],["مَنِ","mani","whoever","যে"],["ٱغْتَرَفَ","igh'tarafa","takes","আঁজলা ভরে নেবে (পানি)"],["غُرْفَةًۢ","ghur'fatan","(in the) hollow","এক আঁজলা"],["بِيَدِهِۦ ۚ","biyadihi","(of) his hand","তার হাত দিয়ে (সেটা ভিন্ন)"],["فَشَرِبُوا۟","fasharibū","Then they drank","তারা অতঃপর পান করল"],["مِنْهُ","min'hu","from it","তা থেকে"],["إِلَّا","illā","except","ছাড়া"],["قَلِيلًۭا","qalīlan","a few","স্বল্প সংখ্যক"],["مِّنْهُمْ ۚ","min'hum","of them","তাদের মধ্য হতে"],["فَلَمَّا","falammā","Then when","অতঃপর যখন"],["جَاوَزَهُۥ","jāwazahu","he crossed it","তা অতিক্রম করল"],["هُوَ","huwa","he","সে"],["وَٱلَّذِينَ","wa-alladhīna","and those who","ও যারা"],["ءَامَنُوا۟","āmanū","believed","ঈমান এনেছিল"],["مَعَهُۥ","ma‘ahu","with him","তার সাথে"],["قَالُوا۟","qālū","they said","তারা বলেছিল"],["لَا","lā","No","নেই"],["طَاقَةَ","ṭāqata","strength","শক্তি"],["لَنَا","lanā","for us","আমাদের কাছে"],["ٱلْيَوْمَ","l-yawma","today","আজ"],["بِجَالُوتَ","bijālūta","against Jalut","জালুতের সাথে"],["وَجُنُودِهِۦ ۚ","wajunūdihi","and his troops","ও তার সৈন্যদের (সাথে যুদ্ধের)"],["قَالَ","qāla","Said","বলল"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["يَظُنُّونَ","yaẓunnūna","were certain","মনে করত"],["أَنَّهُم","annahum","that they","তারা যে"],["مُّلَـٰقُوا۟","mulāqū","(would) meet","সাক্ষাৎকারী"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর সাথে"],["كَم","kam","How many","কত"],["مِّن","min","of","থেকে"],["فِئَةٍۢ","fi-atin","a company","দল (রয়েছে)"],["قَلِيلَةٍ","qalīlatin","small","ছোট ছোট"],["غَلَبَتْ","ghalabat","overcame","বিজয়ী হয়েছে (যারা)"],["فِئَةًۭ","fi-atan","a company","দলের (উপর)"],["كَثِيرَةًۢ","kathīratan","large","বড় বড়"],["بِإِذْنِ","bi-idh'ni","by (the) permission","অনুমতিক্রমে"],["ٱللَّهِ ۗ","l-lahi","(of) Allah","আল্লাহর"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["مَعَ","ma‘a","(is) with","(সাথে আছেন)"],["ٱلصَّـٰبِرِينَ","l-ṣābirīna","the patient ones","ধৈর্যশীল"]],"t":"فَلَ<g>مَّ</>ا فَصَلَ طَالُوتُ بِ<h>ٱ</>لْجُنُودِ قَالَ إِ<g>نَّ</> <h>ٱ</>للَّهَ مُ<q>بْ</>تَلِي<f>كُم بِ</>نَهَ<k>رٍۢ فَمَن شَ</>رِبَ مِنْهُ فَلَيْسَ مِ<g>نِّ</>ى وَ<w>مَن لَّ</>مْ يَ<q>طْ</>عَمْهُ فَإِ<g>نَّ</>هُ<m>ۥ</> مِ<g>نِّ</><o>ىٓ</> إِلَّا مَنِ <h>ٱ</>غْتَرَفَ غُرْفَ<i>ةًۢ بِ</>يَدِ<m>هِۦ</> ۚ فَشَرِبُو<s>ا۟</> مِنْهُ إِلَّا قَلِيلًۭ<d>ا مِّ</>نْهُمْ ۚ فَلَ<g>مَّ</>ا جَاوَزَهُ<m>ۥ</> هُوَ وَ<h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> مَعَهُ<m>ۥ</> قَالُو<s>ا۟</> لَا طَاقَةَ لَنَا <h>ٱ</>لْيَوْمَ بِجَالُوتَ وَجُنُودِ<m>هِۦ</> ۚ قَالَ <h>ٱ</>لَّذِينَ يَظُ<g>نُّ</>ونَ أَ<g>نَّ</><y>هُم مُّ</><m>لَٰ</>قُو<s>ا۟</> <h>ٱ</>للَّهِ <y>كَم مِّ</><k>ن فِئَةٍۢ قَ</>لِيلَةٍ غَلَبَتْ فِئَ<k>ةًۭ كَ</>ثِيرَ<i>ةًۢ بِ</>إِذْنِ <h>ٱ</>للَّهِ ۗ وَ<h>ٱ</>للَّهُ مَعَ <h>ٱ</><l>ل</><m>صَّٰ</>بِ<p>رِي</>نَ"},{"n":250,"w":[["وَلَمَّا","walammā","And when","এবং যখন"],["بَرَزُوا۟","barazū","they went forth","তারা সম্মুখীন হল"],["لِجَالُوتَ","lijālūta","to (face) Jalut","জালুতের বিরুদ্ধে"],["وَجُنُودِهِۦ","wajunūdihi","and his troops","ও তার সৈন্যদের (বিরুদ্ধে)"],["قَالُوا۟","qālū","they said","বলেছিল তারা"],["رَبَّنَآ","rabbanā","Our Lord","হে আমাদের রব"],["أَفْرِغْ","afrigh","Pour","ঢেলে দাও(দান করো)"],["عَلَيْنَا","‘alaynā","on us","আমাদের ওপর"],["صَبْرًۭا","ṣabran","patience","ধৈর্য"],["وَثَبِّتْ","wathabbit","and make firm","ও দৃঢ় করো"],["أَقْدَامَنَا","aqdāmanā","our feet","আমাদের পাগুলোকে"],["وَٱنصُرْنَا","wa-unṣur'nā","and help us","এবং আমাদেরকে সাহায্য করো"],["عَلَى","‘alā","against","বিরুদ্ধে"],["ٱلْقَوْمِ","l-qawmi","the people","জাতির"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","(who are) disbelieving","কাফির"]],"t":"وَلَ<g>مَّ</>ا بَرَزُو<s>ا۟</> لِجَالُوتَ وَجُنُودِ<m>هِۦ</> قَالُو<s>ا۟</> رَبَّ<o>نَآ</> أَفْرِغْ عَلَيْنَا صَ<q>بْ</><d>رًۭا وَ</>ثَبِّتْ أَ<q>قْ</>دَامَنَا وَ<h>ٱ</><k>نصُ</>رْنَا عَلَى <h>ٱ</>لْقَوْمِ <h>ٱ</>لْ<m>كَٰ</>فِ<p>رِي</>نَ"},{"n":251,"w":[["فَهَزَمُوهُم","fahazamūhum","So they defeated them","তারা অতঃপর পরাজিত করল তাদেরকে"],["بِإِذْنِ","bi-idh'ni","by (the) permission","অনুমতিক্রমে"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَقَتَلَ","waqatala","and killed","এবং হত্যা করল"],["دَاوُۥدُ","dāwūdu","Dawood","দাঊদ"],["جَالُوتَ","jālūta","Jalut","জালুতকে"],["وَءَاتَىٰهُ","waātāhu","and gave him","এবং তাকে দিয়ে দিয়েছিলেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["ٱلْمُلْكَ","l-mul'ka","the kingdom","রাজত্ব"],["وَٱلْحِكْمَةَ","wal-ḥik'mata","and the wisdom","ও প্রজ্ঞা"],["وَعَلَّمَهُۥ","wa‘allamahu","and taught him","ও তাকে শিক্ষা দিয়েছিলেন"],["مِمَّا","mimmā","that which","তা থেকে (বিভিন্ন জিনিসের) যা"],["يَشَآءُ ۗ","yashāu","He willed","তিনি চেয়েছেন"],["وَلَوْلَا","walawlā","And if not","এবং যদি না"],["دَفْعُ","daf‘u","(for the) repelling","প্রতিহত (করা হত)"],["ٱللَّهِ","l-lahi","(by) Allah","আল্লাহর (পক্ষ হতে)"],["ٱلنَّاسَ","l-nāsa","[the] people ","মানুষের"],["بَعْضَهُم","ba‘ḍahum","some of them","তাদের কাউকে"],["بِبَعْضٍۢ","biba‘ḍin","with others","(অন্য) কাউকে দিয়ে"],["لَّفَسَدَتِ","lafasadati","certainly (would have) corrupted","(তাহলে) অবশ্যই বিপর্যস্ত হয়ে যেত"],["ٱلْأَرْضُ","l-arḍu","the Earth","পৃথিবী"],["وَلَـٰكِنَّ","walākinna","[and] but","কিন্তু"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["ذُو","dhū","(is) Possessor","(অধিকারী)"],["فَضْلٍ","faḍlin","(of) bounty","(অনুগ্রহের)"],["عَلَى","‘alā","to","উপর"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","the worlds","বিশ্বজগতের"]],"t":"فَهَزَمُو<f>هُم بِ</>إِذْنِ <h>ٱ</>للَّهِ وَقَتَلَ دَاوُ<m>ۥ</>دُ جَالُوتَ وَءَاتَ<m>ىٰ</>هُ <h>ٱ</>للَّهُ <h>ٱ</>لْمُلْكَ وَ<h>ٱ</>لْحِكْمَةَ وَعَلَّمَهُ<m>ۥ</> مِ<g>مَّ</>ا يَ<o>شَآ</>ءُ ۗ وَلَوْلَا دَفْعُ <h>ٱ</>للَّهِ <h>ٱ</><l>ل</><g>نَّ</>اسَ بَعْضَ<f>هُم بِ</>بَعْ<w>ضٍۢ لَّ</>فَسَدَتِ <h>ٱ</>لْأَرْضُ وَ<m>لَٰ</>كِ<g>نَّ</> <h>ٱ</>للَّهَ ذُو فَضْلٍ عَلَى <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":252,"w":[["تِلْكَ","til'ka","These","এই"],["ءَايَـٰتُ","āyātu","(are the) Verses","নিদর্শনাদি"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["نَتْلُوهَا","natlūhā","We recite them","তা তিলাওয়াত করছি আমরা"],["عَلَيْكَ","‘alayka","to you","তোমার কাছে"],["بِٱلْحَقِّ ۚ","bil-ḥaqi","in [the] truth","যথাযথভাবে"],["وَإِنَّكَ","wa-innaka","And indeed, you","এবং তুমি নিশ্চয়ই"],["لَمِنَ","lamina","(are) surely of","অবশ্যই অর্ন্তভুক্ত"],["ٱلْمُرْسَلِينَ","l-mur'salīna","the Messengers","রাসূলদের"]],"t":"تِلْكَ ءَا<m>يَٰ</>تُ <h>ٱ</>للَّهِ نَتْلُوهَا عَلَيْكَ بِ<h>ٱ</>لْحَقِّ ۚ وَإِ<g>نَّ</>كَ لَمِنَ <h>ٱ</>لْمُرْسَ<p>لِي</>نَ"},{"n":253,"w":[["۞ تِلْكَ","til'ka","These","এই"],["ٱلرُّسُلُ","l-rusulu","(are) the Messengers","রাসূলগণ"],["فَضَّلْنَا","faḍḍalnā","We (have) preferred","আমরা মর্যাদা দিয়েছি"],["بَعْضَهُمْ","ba‘ḍahum","some of them","তাদের কাউকে"],["عَلَىٰ","‘alā","over","উপর"],["بَعْضٍۢ ۘ","ba‘ḍin","others","কারও"],["مِّنْهُم","min'hum","Among them","তাদের মধ্যে হতে"],["مَّن","man","(were those with) whom","কারও (সাথে)"],["كَلَّمَ","kallama","spoke","বলেছেন কথা"],["ٱللَّهُ ۖ","l-lahu","Allah","আল্লাহ"],["وَرَفَعَ","warafa‘a","and He raised","এবং উন্নীত করেছেন"],["بَعْضَهُمْ","ba‘ḍahum","some of them","তাদের কাউকে"],["دَرَجَـٰتٍۢ ۚ","darajātin","(in) degrees","(উচ্চ) মর্যাদায়"],["وَءَاتَيْنَا","waātaynā","And We gave","এবং আমরা দিয়েছি"],["عِيسَى","‘īsā","Isa","ঈসাকে"],["ٱبْنَ","ib'na","son","পুত্র"],["مَرْيَمَ","maryama","(of) Maryam","মারইয়ামের"],["ٱلْبَيِّنَـٰتِ","l-bayināti","the clear proofs","সুষ্পষ্ট প্রমাণ সমূহ"],["وَأَيَّدْنَـٰهُ","wa-ayyadnāhu","and We supported him","এবং তাকে সাহায্য করেছি আমরা"],["بِرُوحِ","birūḥi","with Spirit","আত্মা দিয়ে"],["ٱلْقُدُسِ ۗ","l-qudusi","[the] Holy","পবিত্র (অর্থাৎ জিবরাইল)"],["وَلَوْ","walaw","And if","এবং যদি"],["شَآءَ","shāa","(had) willed","চাইতেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["مَا","mā","not","না"],["ٱقْتَتَلَ","iq'tatala","(would have) fought each other","তারা পরস্পর যুদ্ধ করত"],["ٱلَّذِينَ","alladhīna","those who","যারা (ছিল)"],["مِنۢ","min","(came) from","থেকে"],["بَعْدِهِم","ba‘dihim","after them","তাদের পরে"],["مِّنۢ","min","from","থেকেও"],["بَعْدِ","ba‘di","after","এরপর"],["مَا","mā","[what]","যা"],["جَآءَتْهُمُ","jāathumu","came to them","তাদের কাছে এসেছিল"],["ٱلْبَيِّنَـٰتُ","l-bayinātu","the clear proofs","সুষ্পষ্ট নিদর্শনাদি"],["وَلَـٰكِنِ","walākini","[And] but","কিন্তু"],["ٱخْتَلَفُوا۟","ikh'talafū","they differed","মতবিরোধ করল তারা"],["فَمِنْهُم","famin'hum","[so] of them","তাদের পরে মধ্যথেকে"],["مَّنْ","man","(are some) who","কেউ"],["ءَامَنَ","āmana","believed","ঈমান আনল"],["وَمِنْهُم","wamin'hum","and of them","আবার তাদের মধ্যেথেকে"],["مَّن","man","(are some) who","কেউ"],["كَفَرَ ۚ","kafara","denied","অস্বীকার করল"],["وَلَوْ","walaw","And if","এবং যদি"],["شَآءَ","shāa","(had) willed","ইচ্ছা করতেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["مَا","mā","not","না"],["ٱقْتَتَلُوا۟","iq'tatalū","they (would have) fought each other","তারা একে অপরে লড়ত"],["وَلَـٰكِنَّ","walākinna","[and] but","কিন্তু"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يَفْعَلُ","yaf‘alu","does","করেন"],["مَا","mā","what","যা"],["يُرِيدُ","yurīdu","He intends","তিনি চান"]],"t":"۞ تِلْكَ <h>ٱ</><l>ل</>رُّسُلُ فَضَّلْنَا بَعْضَهُمْ عَلَىٰ بَعْ<d>ضٍۢ ۘ مِّ</>نْ<y>هُم مَّ</><k>ن كَ</>لَّمَ <h>ٱ</>للَّهُ ۖ وَرَفَعَ بَعْضَهُمْ دَرَ<m>جَٰ</><d>تٍۢ ۚ وَ</>ءَاتَيْنَا عِيسَى <h>ٱ</><q>بْ</>نَ مَرْيَمَ <h>ٱ</>لْبَيِّ<m>نَٰ</>تِ وَأَيَّ<q>دْ</><m>نَٰ</>هُ بِرُوحِ <h>ٱ</>لْقُدُسِ ۗ وَلَوْ <o>شَآ</>ءَ <h>ٱ</>للَّهُ مَا <h>ٱ</><q>قْ</>تَتَلَ <h>ٱ</>لَّذِينَ <i>مِنۢ بَ</>عْدِ<y>هِم مِّ</><i>نۢ بَ</>عْدِ مَا <o>جَآ</>ءَتْهُمُ <h>ٱ</>لْبَيِّ<m>نَٰ</>تُ وَ<m>لَٰ</>كِنِ <h>ٱ</>خْتَلَفُو<s>ا۟</> فَمِنْ<y>هُم مَّ</>نْ ءَامَنَ وَمِنْ<y>هُم مَّ</><k>ن كَ</>فَرَ ۚ وَلَوْ <o>شَآ</>ءَ <h>ٱ</>للَّهُ مَا <h>ٱ</><q>قْ</>تَتَلُو<s>ا۟</> وَ<m>لَٰ</>كِ<g>نَّ</> <h>ٱ</>للَّهَ يَفْعَلُ مَا يُ<p>رِي</><q>دُ</>"},{"n":254,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you","হে"],["ٱلَّذِينَ","alladhīna","who","যারা"],["ءَامَنُوٓا۟","āmanū","believe[d]","ঈমান এনেছ"],["أَنفِقُوا۟","anfiqū","Spend","তোমরা ব্যয় করো"],["مِمَّا","mimmā","of what","তা থেকে যা"],["رَزَقْنَـٰكُم","razaqnākum","We (have) provided you","তোমাদের আমরা জীবিকা দিয়েছি"],["مِّن","min","from","থেকে"],["قَبْلِ","qabli","before","এর পূর্ব"],["أَن","an","that","যে"],["يَأْتِىَ","yatiya","comes","আসবে"],["يَوْمٌۭ","yawmun","a Day","দিন"],["لَّا","lā","no","না"],["بَيْعٌۭ","bay‘un","bargaining","কেনাবেচা হবে"],["فِيهِ","fīhi","in it","তার মধ্যে"],["وَلَا","walā","and no","আর না"],["خُلَّةٌۭ","khullatun","friendship","বন্ধুত্ব"],["وَلَا","walā","and no","আর না"],["شَفَـٰعَةٌۭ ۗ","shafā‘atun","intercession","সুপারিশ (কাজে আসবে)"],["وَٱلْكَـٰفِرُونَ","wal-kāfirūna","And the deniers ","এবং কাফিররা"],["هُمُ","humu","they","তারাই"],["ٱلظَّـٰلِمُونَ","l-ẓālimūna","(are) the wrongdoers","সীমালঙ্ঘনকারী"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَ<o>نُوٓ</><s>ا۟</> أَ<k>نفِ</>قُو<s>ا۟</> مِ<g>مَّ</>ا رَزَ<q>قْ</><m>نَٰ</><y>كُم مِّ</><k>ن قَ</><q>بْ</>لِ <d>أَن يَ</>أْتِىَ يَوْ<w>مٌۭ لَّ</>ا بَيْ<k>عٌۭ فِ</>يهِ وَلَا خُلَّ<d>ةٌۭ وَ</>لَا شَ<m>فَٰ</>عَ<d>ةٌۭ ۗ وَ</><h>ٱ</>لْ<m>كَٰ</>فِرُونَ هُمُ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مُو</>نَ"},{"n":255,"w":[["ٱللَّهُ","al-lahu","Allah ","আল্লাহ"],["لَآ","lā","(there is) no","নেই"],["إِلَـٰهَ","ilāha","God","কোনো ইলাহ"],["إِلَّا","illā","except","ছাড়া"],["هُوَ","huwa","Him","তিনি"],["ٱلْحَىُّ","l-ḥayu","the Ever-Living","চিরঞ্জীব"],["ٱلْقَيُّومُ ۚ","l-qayūmu","the Sustainer of all that exists","সর্বসত্তার ধারক"],["لَا","lā","Not","না"],["تَأْخُذُهُۥ","takhudhuhu","overtakes Him","তাকে স্পর্শ করতে পারে"],["سِنَةٌۭ","sinatun","slumber","তন্দ্রা"],["وَلَا","walā","[and] not","আর না"],["نَوْمٌۭ ۚ","nawmun","sleep","ঘুম"],["لَّهُۥ","lahu","To Him (belongs)","তাঁরই জন্য"],["مَا","mā","what(ever)","যা কিছু"],["فِى","fī","(is) in","মধ্যে (আছে)"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশ সমূহের"],["وَمَا","wamā","and what(ever)","এবং যা কিছু"],["فِى","fī","(is) in","মধ্যে (আছে)"],["ٱلْأَرْضِ ۗ","l-arḍi","the earth","পৃথিবীর"],["مَن","man","Who","কে"],["ذَا","dhā","(is) the one","সে (এমন সম্পন্ন)"],["ٱلَّذِى","alladhī","who","যে"],["يَشْفَعُ","yashfa‘u","can intercede","সুপারিশ করবে"],["عِندَهُۥٓ","‘indahu","with Him","তাঁর কাছে"],["إِلَّا","illā","except","ছাড়া"],["بِإِذْنِهِۦ ۚ","bi-idh'nihi","by His permission","তাঁর অনুমতি"],["يَعْلَمُ","ya‘lamu","He knows","তিনি জানেন"],["مَا","mā","what","যা (আছে)"],["بَيْنَ","bayna","(is)","(মাঝে)"],["أَيْدِيهِمْ","aydīhim","before them","তাদের সামনে(হাতের)"],["وَمَا","wamā","and what","এবং যা কিছু"],["خَلْفَهُمْ ۖ","khalfahum","(is) behind them","তাদের পিছনে"],["وَلَا","walā","And not","এবং না"],["يُحِيطُونَ","yuḥīṭūna","they encompass","তারা আয়ত্ত করতে পারে"],["بِشَىْءٍۢ","bishayin","anything","সামান্য কিছুও"],["مِّنْ","min","of","হতে"],["عِلْمِهِۦٓ","‘il'mihi","His Knowledge","তাঁর জ্ঞান"],["إِلَّا","illā","except","এছাড়া"],["بِمَا","bimā","[of] what","যা সে বিষয়ে"],["شَآءَ ۚ","shāa","He willed","তিনি চান"],["وَسِعَ","wasi‘a","Extends","পরিব্যাপ্ত করে আছে"],["كُرْسِيُّهُ","kur'siyyuhu","His Seat","তাঁর (কর্তৃত্ব) আসন"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(to) the heavens","আকাশ সমূহে"],["وَٱلْأَرْضَ ۖ","wal-arḍa","and the earth","ও পৃথিবীতে"],["وَلَا","walā","And not","এবং না"],["يَـُٔودُهُۥ","yaūduhu","tires Him","তাঁকে ক্লান্ত করে"],["حِفْظُهُمَا ۚ","ḥif'ẓuhumā","(the) guarding of both of them","এ দুটোর রক্ষণাবেক্ষণ"],["وَهُوَ","wahuwa","And He","এবং তিনি"],["ٱلْعَلِىُّ","l-‘aliyu","(is) the Most High","সুউচ্চ (সত্তা)"],["ٱلْعَظِيمُ","l-‘aẓīmu","the Most Great","সুমহান"]],"t":"ٱللَّهُ <o>لَآ</> إِ<m>لَٰ</>هَ إِلَّا هُوَ <h>ٱ</>لْحَىُّ <h>ٱ</>لْقَيُّومُ ۚ لَا تَأْخُذُهُ<m>ۥ</> سِنَ<d>ةٌۭ وَ</>لَا نَوْ<w>مٌۭ ۚ لَّ</>هُ<m>ۥ</> مَا فِى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَمَا فِى <h>ٱ</>لْأَرْضِ ۗ مَ<k>ن ذَ</>ا <h>ٱ</>لَّذِى يَشْفَعُ عِ<k>ندَ</>هُ<o>ۥٓ</> إِلَّا بِإِذْنِ<m>هِۦ</> ۚ يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ ۖ وَلَا يُحِيطُونَ بِ<d>شَىْءٍۢ مِّ</>نْ عِلْمِ<o>هِۦٓ</> إِلَّا بِمَا <o>شَآ</>ءَ ۚ وَسِعَ كُرْسِيُّهُ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضَ ۖ وَلَا يَـُٔودُهُ<m>ۥ</> حِفْظُهُمَا ۚ وَهُوَ <h>ٱ</>لْعَلِىُّ <h>ٱ</>لْعَ<p>ظِي</>مُ"},{"n":256,"w":[["لَآ","lā","(There is) no","নেই"],["إِكْرَاهَ","ik'rāha","compulsion","জবরদস্তি"],["فِى","fī","in","মধ্যে"],["ٱلدِّينِ ۖ","l-dīni","the religion","দীনের"],["قَد","qad","Surely","নিশ্চয়ই"],["تَّبَيَّنَ","tabayyana","has become distinct","স্পষ্ট হয়েছে"],["ٱلرُّشْدُ","l-rush'du","the right (path)","সত্য পথ"],["مِنَ","mina","from","হতে"],["ٱلْغَىِّ ۚ","l-ghayi","the wrong","ভ্রান্ত পথ"],["فَمَن","faman","Then whoever","যে অতঃপর"],["يَكْفُرْ","yakfur","disbelieves","অস্বীকার করবে"],["بِٱلطَّـٰغُوتِ","bil-ṭāghūti","in false deities","তাগুতের (অসত্য দেবতার) প্রতি"],["وَيُؤْمِنۢ","wayu'min","and believes","ও ঈমান আনবে"],["بِٱللَّهِ","bil-lahi","in Allah","আল্লাহর উপর"],["فَقَدِ","faqadi","then surely","তাহলে নিশ্চয়ই"],["ٱسْتَمْسَكَ","is'tamsaka","he grasped","সে ধারণ করল"],["بِٱلْعُرْوَةِ","bil-‘ur'wati","the handhold ","রাশি (বা হাতলকে)"],["ٱلْوُثْقَىٰ","l-wuth'qā","[the] firm","সুদৃঢ় করে"],["لَا","lā","(which) not","না"],["ٱنفِصَامَ","infiṣāma","(will) break","ছিন্ন হওয়ার"],["لَهَا ۗ","lahā","[for it]","যা"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["سَمِيعٌ","samī‘un","(is) All-Hearing","সব শুনেন"],["عَلِيمٌ","‘alīmun","All-Knowing","সব জানেন"]],"t":"<o>لَآ</> إِكْرَاهَ فِى <h>ٱ</><l>ل</>دِّينِ ۖ قَ<j>د</> تَّبَيَّنَ <h>ٱ</><l>ل</>رُّشْدُ مِنَ <h>ٱ</>لْغَىِّ ۚ فَ<d>مَن يَ</>كْفُرْ بِ<h>ٱ</><l>ل</><m>طَّٰ</>غُوتِ وَيُؤْ<i>مِنۢ بِ</><h>ٱ</>للَّهِ فَقَدِ <h>ٱ</>سْتَمْسَكَ بِ<h>ٱ</>لْعُرْوَةِ <h>ٱ</>لْوُثْقَىٰ لَا <h>ٱ</><k>نفِ</>صَامَ لَهَا ۗ وَ<h>ٱ</>للَّهُ سَمِيعٌ عَ<p>لِي</>مٌ"},{"n":257,"w":[["ٱللَّهُ","al-lahu","Allah","আল্লাহ"],["وَلِىُّ","waliyyu","(is the) Protecting Guardian","অভিভাবক"],["ٱلَّذِينَ","alladhīna","(of) those who","(তাদের) যারা"],["ءَامَنُوا۟","āmanū","believe[d]","ঈমান এনেছে"],["يُخْرِجُهُم","yukh'rijuhum","He brings them out","তিনি তাদের বের করে আনেন"],[