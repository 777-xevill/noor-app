وَلَا","walā","and no","এবং না"],["فُسُوقَ","fusūqa","wickedness","অন্যায় আচরণ করবে"],["وَلَا","walā","and no","এবং না"],["جِدَالَ","jidāla","quarrelling","কলহ-বিবাদ করবে"],["فِى","fī","during","মধ্যে"],["ٱلْحَجِّ ۗ","l-ḥaji","the Hajj","হজ্জের"],["وَمَا","wamā","And whatever","এবং যা"],["تَفْعَلُوا۟","taf‘alū","you do","তোমরা কর"],["مِنْ","min","of","কোনো"],["خَيْرٍۢ","khayrin","good","কল্যাণ"],["يَعْلَمْهُ","ya‘lamhu","knows it","তা জানেন"],["ٱللَّهُ ۗ","l-lahu","Allah","আল্লাহ"],["وَتَزَوَّدُوا۟","watazawwadū","And take provision","এবং তোমরা পাথেয় সাথে নাও"],["فَإِنَّ","fa-inna","(but) indeed","নিশ্চয়ই তবে"],["خَيْرَ","khayra","(the) best","উত্তম"],["ٱلزَّادِ","l-zādi","provision","পাথেয় (হল)"],["ٱلتَّقْوَىٰ ۚ","l-taqwā","(is) righteousness","তাকওয়া"],["وَٱتَّقُونِ","wa-ittaqūni","And fear Me","এবং আমাকে তোমরা ভয় করো"],["يَـٰٓأُو۟لِى","yāulī","O men","হে"],["ٱلْأَلْبَـٰبِ","l-albābi","(of) understanding","বুদ্ধিমান লোকেরা"]],"t":"ٱلْحَجُّ أَشْهُ<d>رٌۭ مَّ</>عْلُو<m>مَٰ</><k>تٌۭ ۚ فَمَن فَ</>رَضَ فِيهِ<g>نَّ</> <h>ٱ</>لْحَجَّ فَلَا رَفَثَ وَلَا فُسُوقَ وَلَا جِدَالَ فِى <h>ٱ</>لْحَجِّ ۗ وَمَا تَفْعَلُو<s>ا۟</> مِنْ خَيْ<d>رٍۢ يَ</>عْلَمْهُ <h>ٱ</>للَّهُ ۗ وَتَزَوَّدُو<s>ا۟</> فَإِ<g>نَّ</> خَيْرَ <h>ٱ</><l>ل</>زَّادِ <h>ٱ</><l>ل</>تَّ<q>قْ</>وَىٰ ۚ وَ<h>ٱ</>تَّقُونِ <o>يَٰٓ</>أُ<s>و۟</>لِى <h>ٱ</>لْأَلْ<p>بَٰ</><q>بِ</>"},{"n":198,"w":[["لَيْسَ","laysa","Not is","নেই"],["عَلَيْكُمْ","‘alaykum","on you","তোমাদের উপর"],["جُنَاحٌ","junāḥun","any sin","কোন পাপ"],["أَن","an","that","যে"],["تَبْتَغُوا۟","tabtaghū","you seek","তোমরা সন্ধান করবে"],["فَضْلًۭا","faḍlan","bounty","অনুগ্রহ"],["مِّن","min","from","কাছ থেকে"],["رَّبِّكُمْ ۚ","rabbikum","your Lord","তোমাদের রবের"],["فَإِذَآ","fa-idhā","And when","অতঃপর যখন"],["أَفَضْتُم","afaḍtum","you depart","তোমরা প্রত্যাবর্তন কর"],["مِّنْ","min","from","থেকে"],["عَرَفَـٰتٍۢ","‘arafātin","(Mount) Arafat","আরাফাত"],["فَٱذْكُرُوا۟","fa-udh'kurū","then remember","তোমরা স্মরণ করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["عِندَ","‘inda","near","কাছে"],["ٱلْمَشْعَرِ","l-mash‘ari","the Monument","মাশআরিল"],["ٱلْحَرَامِ ۖ","l-ḥarāmi","[the] Sacred","হারামের (মুজাদালেফায়)"],["وَٱذْكُرُوهُ","wa-udh'kurūhu","And remember Him","এবং তাকে স্মরণ করো"],["كَمَا","kamā","as","যেমন"],["هَدَىٰكُمْ","hadākum","He (has) guided you","তোমাদের নির্দেশ দিয়েছেন তিনি"],["وَإِن","wa-in","[and] though","এবং যদিও"],["كُنتُم","kuntum","you were","তোমরা ছিলে"],["مِّن","min","[from]","থেকে"],["قَبْلِهِۦ","qablihi","before [it]","এর পূর্বেই"],["لَمِنَ","lamina","surely among","অবশ্যই অন্তর্ভুক্ত"],["ٱلضَّآلِّينَ","l-ḍālīna","those who went astray","পথভ্রষ্টদের"]],"t":"لَيْسَ عَلَيْكُمْ جُنَاحٌ أَ<k>ن تَ</><q>بْ</>تَغُو<s>ا۟</> فَضْلًۭ<d>ا مِّ</><w>ن رَّ</>بِّكُمْ ۚ فَإِ<o>ذَآ</> أَفَضْ<y>تُم مِّ</>نْ عَرَ<m>فَٰ</><k>تٍۢ فَ</><h>ٱ</>ذْكُرُو<s>ا۟</> <h>ٱ</>للَّهَ عِ<k>ندَ</> <h>ٱ</>لْمَشْعَرِ <h>ٱ</>لْحَرَامِ ۖ وَ<h>ٱ</>ذْكُرُوهُ كَمَا هَدَ<m>ىٰ</>كُمْ وَإِ<k>ن كُنتُ</><y>م مِّ</><k>ن قَ</><q>بْ</>لِ<m>هِۦ</> لَمِنَ <h>ٱ</><l>ل</><n>ضَّآ</><p>لِّي</>نَ"},{"n":199,"w":[["ثُمَّ","thumma","Then","এরপর"],["أَفِيضُوا۟","afīḍū","depart","তোমরা প্রত্যাবর্তন করো"],["مِنْ","min","from","থেকে"],["حَيْثُ","ḥaythu","wherever","যেখান"],["أَفَاضَ","afāḍa","depart","প্রত্যাবর্তন করে"],["ٱلنَّاسُ","l-nāsu","the people","মানুষ"],["وَٱسْتَغْفِرُوا۟","wa-is'taghfirū","and ask forgiveness","এবং তোমরা ক্ষমা চাও"],["ٱللَّهَ ۚ","l-laha","(of) Allah","আল্লাহর (কাছে)"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["غَفُورٌۭ","ghafūrun","(is) Oft-Forgiving","ক্ষমাশীল"],["رَّحِيمٌۭ","raḥīmun","Most Merciful","পরম দয়ালু"]],"t":"ثُ<g>مَّ</> أَفِيضُو<s>ا۟</> مِنْ حَيْثُ أَفَاضَ <h>ٱ</><l>ل</><g>نَّ</>اسُ وَ<h>ٱ</>سْتَغْفِرُو<s>ا۟</> <h>ٱ</>للَّهَ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ غَفُو<w>رٌۭ رَّ</><p>حِي</>مٌۭ"},{"n":200,"w":[["فَإِذَا","fa-idhā","Then when","অতঃপর যখন"],["قَضَيْتُم","qaḍaytum","you complete[d]","তোমরা সম্পন্ন করবে"],["مَّنَـٰسِكَكُمْ","manāsikakum","your acts of worship","তোমাদের হজ্জের অনুষ্ঠানাদি"],["فَٱذْكُرُوا۟","fa-udh'kurū","then remember","তখন তোমরা স্মরণ করবে"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["كَذِكْرِكُمْ","kadhik'rikum","as you remember","তোমরা স্মরণ করতে যেমন"],["ءَابَآءَكُمْ","ābāakum","your forefathers","তোমাদের বাপ-দাদাদেরকে"],["أَوْ","aw","or","বরং (এখন)"],["أَشَدَّ","ashadda","(with) greater","অধিকতর"],["ذِكْرًۭا ۗ","dhik'ran","remembrance","স্মরণ কর (আল্লাহকে)"],["فَمِنَ","famina","And from","অতঃপর কিছু"],["ٱلنَّاسِ","l-nāsi","the people","মানুষ (এমন আছে)"],["مَن","man","who","যারা"],["يَقُولُ","yaqūlu","say","বলে"],["رَبَّنَآ","rabbanā","Our Lord","হে আমাদের রব"],["ءَاتِنَا","ātinā","Grant us","আমাদের দাও"],["فِى","fī","in","মধ্যে"],["ٱلدُّنْيَا","l-dun'yā","the world","(এই) পৃথিবীর"],["وَمَا","wamā","And not","আর নেই"],["لَهُۥ","lahu","for him","তার জন্যে"],["فِى","fī","in","মধ্যে"],["ٱلْـَٔاخِرَةِ","l-ākhirati","the Hereafter","আখেরাতের"],["مِنْ","min","[of]","কোনো"],["خَلَـٰقٍۢ","khalāqin","any share","অংশ"]],"t":"فَإِذَا قَضَيْ<y>تُم مَّ</><m>نَٰ</>سِكَكُمْ فَ<h>ٱ</>ذْكُرُو<s>ا۟</> <h>ٱ</>للَّهَ كَذِكْرِكُمْ ءَا<o>بَآ</>ءَكُمْ أَوْ أَشَدَّ ذِكْ<k>رًۭا ۗ فَ</>مِنَ <h>ٱ</><l>ل</><g>نَّ</>اسِ <d>مَن يَ</>قُولُ رَبَّ<o>نَآ</> ءَاتِنَا فِى <h>ٱ</><l>ل</>دُّنْيَا وَمَا لَهُ<m>ۥ</> فِى <h>ٱ</>لْءَاخِرَةِ مِنْ خَ<p>لَٰ</><q>قٍۢ</>"},{"n":201,"w":[["وَمِنْهُم","wamin'hum","And from those","এবং তাদের মধ্যে (এমনও আছে)"],["مَّن","man","who","যারা"],["يَقُولُ","yaqūlu","say","বলে"],["رَبَّنَآ","rabbanā","Our Lord","হে আমাদের রব"],["ءَاتِنَا","ātinā","Grant us","আমাদের দাও"],["فِى","fī","in","মধ্যে"],["ٱلدُّنْيَا","l-dun'yā","the world","(এই) পৃথিবীর"],["حَسَنَةًۭ","ḥasanatan","good","কল্যাণ"],["وَفِى","wafī","and in","ও"],["ٱلْـَٔاخِرَةِ","l-ākhirati","the Hereafter","আখেরাতের মধ্যে"],["حَسَنَةًۭ","ḥasanatan","good","কল্যাণ"],["وَقِنَا","waqinā","and save us","এবং আমাদের বাঁচাও"],["عَذَابَ","‘adhāba","(from the) punishment","শাস্তি (হতে)"],["ٱلنَّارِ","l-nāri","(of) the Fire","দোজখের আগুনের"]],"t":"وَمِنْ<y>هُم مَّ</><d>ن يَ</>قُولُ رَبَّ<o>نَآ</> ءَاتِنَا فِى <h>ٱ</><l>ل</>دُّنْيَا حَسَنَ<d>ةًۭ وَ</>فِى <h>ٱ</>لْءَاخِرَةِ حَسَنَ<d>ةًۭ وَ</>قِنَا عَذَابَ <h>ٱ</><l>ل</><g>نَّ</><p>ا</>رِ"},{"n":202,"w":[["أُو۟لَـٰٓئِكَ","ulāika","Those ","ঐসব লোক"],["لَهُمْ","lahum","for them","তাদের জন্য (রয়েছে)"],["نَصِيبٌۭ","naṣībun","(is) a share","অংশ (উভয় স্থানে)"],["مِّمَّا","mimmā","of what","তা থেকে যা"],["كَسَبُوا۟ ۚ","kasabū","they earned","তারা অর্জন করেছে"],["وَٱللَّهُ","wal-lahu","and Allah","আর আল্লাহ"],["سَرِيعُ","sarī‘u","(is) swift","দ্রুত"],["ٱلْحِسَابِ","l-ḥisābi","(in taking) account","হিসাব নিতে"]],"t":"أُ<s>و۟</><o>لَٰٓ</>ئِكَ لَهُمْ نَصِي<d>بٌۭ مِّ</><g>مَّ</>ا كَسَبُو<s>ا۟ ۚ</> وَ<h>ٱ</>للَّهُ سَرِيعُ <h>ٱ</>لْحِ<p>سَا</><q>بِ</>"},{"n":203,"w":[["۞ وَٱذْكُرُوا۟","wa-udh'kurū","And remember","এবং তোমরা স্মরণ করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["فِىٓ","fī","during","মধ্যে"],["أَيَّامٍۢ","ayyāmin","days","দিনগুলোর"],["مَّعْدُودَٰتٍۢ ۚ","ma‘dūdātin","numbered","নির্দিষ্ট সংখ্যক"],["فَمَن","faman","Then (he) who","যে অতঃপর"],["تَعَجَّلَ","ta‘ajjala","hurries","তাড়াতাড়ি করে"],["فِى","fī","in","মধ্যে"],["يَوْمَيْنِ","yawmayni","two days","দুইদিনের (চলে আসে)"],["فَلَآ","falā","then no","নেই তবে"],["إِثْمَ","ith'ma","sin","কোন পাপ"],["عَلَيْهِ","‘alayhi","upon him","তার উপর"],["وَمَن","waman","and whoever","আর যে"],["تَأَخَّرَ","ta-akhara","delays","বিলম্ব করে (ফিরে)"],["فَلَآ","falā","then no","তাতেও নাই"],["إِثْمَ","ith'ma","sin","কোন পাপ"],["عَلَيْهِ ۚ","‘alayhi","upon him","তার উপর"],["لِمَنِ","limani","for (the one) who","তার জন্য যে"],["ٱتَّقَىٰ ۗ","ittaqā","fears","তাকওয়া অবলম্বন করে"],["وَٱتَّقُوا۟","wa-ittaqū","And fear","এবং তোমরা ভয় করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["وَٱعْلَمُوٓا۟","wa-i‘'lamū","and know","এবং তোমরা জেনে রাখো"],["أَنَّكُمْ","annakum","that you","যে তোমাদেরকে"],["إِلَيْهِ","ilayhi","unto Him","তারই দিকে"],["تُحْشَرُونَ","tuḥ'sharūna","will be gathered","একত্র করা হবে"]],"t":"۞ وَ<h>ٱ</>ذْكُرُو<s>ا۟</> <h>ٱ</>للَّهَ <o>فِىٓ</> أَيَّا<d>مٍۢ مَّ</>عْدُو<m>دَٰ</><k>تٍۢ ۚ فَمَن تَ</>عَجَّلَ فِى يَوْمَيْنِ فَ<o>لَآ</> إِثْمَ عَلَيْهِ وَمَ<k>ن تَ</>أَخَّرَ فَ<o>لَآ</> إِثْمَ عَلَيْهِ ۚ لِمَنِ <h>ٱ</>تَّقَىٰ ۗ وَ<h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</>للَّهَ وَ<h>ٱ</>عْلَ<o>مُوٓ</><s>ا۟</> أَ<g>نَّ</>كُمْ إِلَيْهِ تُحْشَ<p>رُو</>نَ"},{"n":204,"w":[["وَمِنَ","wamina","And of","এবং মধ্যে(কেউ কেউ)"],["ٱلنَّاسِ","l-nāsi","the people","লোকদের (এমনও আছে)"],["مَن","man","(is the one) who","যে"],["يُعْجِبُكَ","yu‘'jibuka","pleases you","তোমাকে মুগ্ধ করে"],["قَوْلُهُۥ","qawluhu","(with) his speech","তার কথাবার্তা"],["فِى","fī","in","মধ্যে"],["ٱلْحَيَوٰةِ","l-ḥayati","the life","জীবনের"],["ٱلدُّنْيَا","l-dun'yā","(of) the world","পার্থিব"],["وَيُشْهِدُ","wayush'hidu","and he calls to witness","ও সে সাক্ষী রাখে"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["عَلَىٰ","‘alā","on","(এর) উপর"],["مَا","mā","what","যা"],["فِى","fī","(is) in","মধ্যে(আছে)"],["قَلْبِهِۦ","qalbihi","his heart","তার অন্তরের"],["وَهُوَ","wahuwa","and he","এবং সে"],["أَلَدُّ","aladdu","(is) the most quarrelsome","সাংঘাতিক"],["ٱلْخِصَامِ","l-khiṣāmi","(of) opponents","ঝগড়াটে"]],"t":"وَمِنَ <h>ٱ</><l>ل</><g>نَّ</>اسِ <d>مَن يُ</>عْجِبُكَ قَوْلُهُ<m>ۥ</> فِى <h>ٱ</>لْحَيَ<s>وٰ</>ةِ <h>ٱ</><l>ل</>دُّنْيَا وَيُشْهِدُ <h>ٱ</>للَّهَ عَلَىٰ مَا فِى قَلْبِ<m>هِۦ</> وَهُوَ أَلَدُّ <h>ٱ</>لْخِ<p>صَا</>مِ"},{"n":205,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["تَوَلَّىٰ","tawallā","he turns away","সে কর্তৃত্ব পায়"],["سَعَىٰ","sa‘ā","he strives","সে চেষ্টা করে"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["لِيُفْسِدَ","liyuf'sida","to spread corruption","বিপর্যয় সৃষ্টির জন্যে"],["فِيهَا","fīhā","[in it]","তার মধ্যে"],["وَيُهْلِكَ","wayuh'lika","and destroys","ও ধ্বংস করতে"],["ٱلْحَرْثَ","l-ḥartha","the crops","শস্যক্ষেত"],["وَٱلنَّسْلَ ۗ","wal-nasla","and progeny","ও জীব-জন্তুর বংশ"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["لَا","lā","(does) not","না"],["يُحِبُّ","yuḥibbu","love","পছন্দ করনে"],["ٱلْفَسَادَ","l-fasāda","[the] corruption","বিপর্যয়"]],"t":"وَإِذَا تَوَلَّىٰ سَعَىٰ فِى <h>ٱ</>لْأَرْضِ لِيُفْسِدَ فِيهَا وَيُهْلِكَ <h>ٱ</>لْحَرْثَ وَ<h>ٱ</><l>ل</><g>نَّ</>سْلَ ۗ وَ<h>ٱ</>للَّهُ لَا يُحِبُّ <h>ٱ</>لْفَ<p>سَا</><q>دَ</>"},{"n":206,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["قِيلَ","qīla","it is said","বলা হয়"],["لَهُ","lahu","to him","তার উদ্দেশে"],["ٱتَّقِ","ittaqi","Fear","ভয় করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["أَخَذَتْهُ","akhadhathu","takes him","তাকে ধরে"],["ٱلْعِزَّةُ","l-‘izatu","(his) pride","(তার) মর্যাদা সম্মান"],["بِٱلْإِثْمِ ۚ","bil-ith'mi","to [the] sins","পাপের (পথে)"],["فَحَسْبُهُۥ","faḥasbuhu","Then enough for him","তার জন্যে তাই যথেষ্ট"],["جَهَنَّمُ ۚ","jahannamu","(is) Hell ","জাহান্নাম"],["وَلَبِئْسَ","walabi'sa","[and] surely an evil","এবং (তা) অবশ্যই অতি নিকৃষ্ট"],["ٱلْمِهَادُ","l-mihādu","[the] resting-place","আবাস"]],"t":"وَإِذَا قِيلَ لَهُ <h>ٱ</>تَّقِ <h>ٱ</>للَّهَ أَخَذَتْهُ <h>ٱ</>لْعِزَّةُ بِ<h>ٱ</>لْإِثْمِ ۚ فَحَسْبُهُ<m>ۥ</> جَهَ<g>نَّ</>مُ ۚ وَلَبِئْسَ <h>ٱ</>لْمِ<p>هَا</><q>دُ</>"},{"n":207,"w":[["وَمِنَ","wamina","And of","এবং মধ্য হতে"],["ٱلنَّاسِ","l-nāsi","the people","লোকদের (এমনও আছে)"],["مَن","man","(is the one) who","যে"],["يَشْرِى","yashrī","sells","বিক্রি করে"],["نَفْسَهُ","nafsahu","his own self","তার প্রাণ"],["ٱبْتِغَآءَ","ib'tighāa","seeking","উদ্দেশ্যে"],["مَرْضَاتِ","marḍāti","pleasure","সন্তুষ্টির"],["ٱللَّهِ ۗ","l-lahi","(of) Allah","আল্লাহর"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["رَءُوفٌۢ","raūfun","(is) full of Kindness","খুব দয়ালু"],["بِٱلْعِبَادِ","bil-‘ibādi","to His servants","এ ধরনের দাসদের সাথে"]],"t":"وَمِنَ <h>ٱ</><l>ل</><g>نَّ</>اسِ <d>مَن يَ</>شْرِى نَفْسَهُ <h>ٱ</><q>بْ</>تِ<o>غَآ</>ءَ مَرْضَاتِ <h>ٱ</>للَّهِ ۗ وَ<h>ٱ</>للَّهُ رَءُو<i>فٌۢ بِ</><h>ٱ</>لْعِ<p>بَا</><q>دِ</>"},{"n":208,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you","ওহে"],["ٱلَّذِينَ","alladhīna","who","যারা"],["ءَامَنُوا۟","āmanū","believe[d]","ঈমান এনেছো"],["ٱدْخُلُوا۟","ud'khulū","Enter","তোমরা প্রবেশ করো"],["فِى","fī","in","মধ্যে"],["ٱلسِّلْمِ","l-sil'mi","Islam","ইসলামের"],["كَآفَّةًۭ","kāffatan","completely","সম্পূর্ণভাবে"],["وَلَا","walā","and (do) not","এবং না"],["تَتَّبِعُوا۟","tattabi‘ū","follow","তোমরা অনুসরণ করো"],["خُطُوَٰتِ","khuṭuwāti","footsteps","পদাঙ্কগুলোর"],["ٱلشَّيْطَـٰنِ ۚ","l-shayṭāni","(of) the Shaitaan","শয়তানের"],["إِنَّهُۥ","innahu","Indeed, he","সে নিশ্চয়ই"],["لَكُمْ","lakum","(is) for you","তোমাদের জন্যে"],["عَدُوٌّۭ","‘aduwwun","an enemy","শত্রু"],["مُّبِينٌۭ","mubīnun","open","প্রকাশ্য"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> <h>ٱ</><q>دْ</>خُلُو<s>ا۟</> فِى <h>ٱ</><l>ل</>سِّلْمِ <n>كَآ</>فَّ<d>ةًۭ وَ</>لَا تَتَّبِعُو<s>ا۟</> خُطُ<m>وَٰ</>تِ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نِ ۚ إِ<g>نَّ</>هُ<m>ۥ</> لَكُمْ عَدُ<d>وٌّۭ مُّ</><p>بِي</>نٌۭ"},{"n":209,"w":[["فَإِن","fa-in","Then if","অতঃপর যদি"],["زَلَلْتُم","zalaltum","you slip","তোমরা পদস্খলন কর"],["مِّنۢ","min","from","(এর)"],["بَعْدِ","ba‘di","after","পর থেকে"],["مَا","mā","[what]","যা"],["جَآءَتْكُمُ","jāatkumu","came to you","তোমাদের কাছে এসেছে"],["ٱلْبَيِّنَـٰتُ","l-bayinātu","(from) the clear proofs","সুস্পষ্ট নিদর্শন"],["فَٱعْلَمُوٓا۟","fa-i‘'lamū","then know","তোমরা তবে জেনে রাখো"],["أَنَّ","anna","that","যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["عَزِيزٌ","‘azīzun","(is) All-Mighty","মহাপরাক্রমশালী"],["حَكِيمٌ","ḥakīmun","All-Wise","মহাবিজ্ঞ"]],"t":"فَإِ<k>ن زَ</>لَلْ<y>تُم مِّ</><i>نۢ بَ</>عْدِ مَا <o>جَآ</>ءَتْكُمُ <h>ٱ</>لْبَيِّ<m>نَٰ</>تُ فَ<h>ٱ</>عْلَ<o>مُوٓ</><s>ا۟</> أَ<g>نَّ</> <h>ٱ</>للَّهَ عَزِيزٌ حَ<p>كِي</>مٌ"},{"n":210,"w":[["هَلْ","hal","Are","কি"],["يَنظُرُونَ","yanẓurūna","they waiting","তারা অপেক্ষা করছে"],["إِلَّآ","illā","[except]","এছাড়া"],["أَن","an","that","যে"],["يَأْتِيَهُمُ","yatiyahumu","comes to them","তাদের কাছে আসবেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["فِى","fī","in","মধ্যে"],["ظُلَلٍۢ","ẓulalin","(the) shadows","ছায়ার"],["مِّنَ","mina","of","হতে"],["ٱلْغَمَامِ","l-ghamāmi","[the] clouds","মেঘমালা"],["وَٱلْمَلَـٰٓئِكَةُ","wal-malāikatu","and the Angels","এবং ফেরে