েছেন"],["عَلَيْكُم","‘alaykum","to you","তোমাদের উপর"],["مِّنَ","mina","of","থেকে"],["ٱلْكِتَـٰبِ","l-kitābi","the Book","কিতাব"],["وَٱلْحِكْمَةِ","wal-ḥik'mati","and [the] wisdom","ও প্রজ্ঞা"],["يَعِظُكُم","ya‘iẓukum","He instructs you","তোমাদেরকে তিনি উপদেশ দিচ্ছেন"],["بِهِۦ ۚ","bihi","with it","তা দিয়ে"],["وَٱتَّقُوا۟","wa-ittaqū","And fear","এবং তোমরা ভয় করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["وَٱعْلَمُوٓا۟","wa-i‘'lamū","and know","এবং তোমরা জেনে রাখো"],["أَنَّ","anna","that","যে"],["ٱللَّهَ","l-laha","Allah (is)","আল্লাহ"],["بِكُلِّ","bikulli","of every","সব সম্পর্কে"],["شَىْءٍ","shayin","thing","কিছুর"],["عَلِيمٌۭ","‘alīmun","All-Knower","খুব অবহিত"]],"t":"وَإِذَا طَلَّ<q>قْ</>تُمُ <h>ٱ</><l>ل</><g>نِّ</><o>سَآ</>ءَ فَبَلَغْنَ أَجَلَهُ<g>نَّ</> فَأَمْسِكُوهُ<g>نَّ</> بِمَعْرُوفٍ أَوْ سَرِّحُوهُ<g>نَّ</> بِمَعْرُو<d>فٍۢ ۚ وَ</>لَا تُمْسِكُوهُ<g>نَّ</> ضِرَا<w>رًۭا لِّ</>تَعْتَدُو<s>ا۟ ۚ</> وَ<d>مَن يَ</>فْعَلْ <m>ذَٰ</>لِكَ فَقَ<q>دْ</> ظَلَمَ نَفْسَهُ<m>ۥ</> ۚ وَلَا تَتَّخِ<o>ذُوٓ</><s>ا۟</> ءَا<m>يَٰ</>تِ <h>ٱ</>للَّهِ هُزُ<d>وًۭا ۚ وَ</><h>ٱ</>ذْكُرُو<s>ا۟</> نِعْمَتَ <h>ٱ</>للَّهِ عَلَيْكُمْ وَ<o>مَآ</> أَ<k>نزَ</>لَ عَلَيْ<y>كُم مِّ</>نَ <h>ٱ</>لْكِ<m>تَٰ</>بِ وَ<h>ٱ</>لْحِكْمَةِ يَعِظُ<f>كُم بِ</><m>هِۦ</> ۚ وَ<h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</>للَّهَ وَ<h>ٱ</>عْلَ<o>مُوٓ</><s>ا۟</> أَ<g>نَّ</> <h>ٱ</>للَّهَ بِكُلِّ شَىْءٍ عَ<p>لِي</>مٌۭ"},{"n":232,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["طَلَّقْتُمُ","ṭallaqtumu","you divorce","তালাক দাও তোমরা"],["ٱلنِّسَآءَ","l-nisāa","[the] women","স্ত্রীদেরকে"],["فَبَلَغْنَ","fabalaghna","and they reached","অতঃপর তারা পৌঁছে যায়"],["أَجَلَهُنَّ","ajalahunna","their (waiting) term","তাদের মেয়াদে"],["فَلَا","falā","then (do) not","না তখন"],["تَعْضُلُوهُنَّ","ta‘ḍulūhunna","hinder them","তাদেরকে বাধা দিয়ো"],["أَن","an","[that]","যে"],["يَنكِحْنَ","yankiḥ'na","(from) marrying","তারা বিয়ে করতে চায়"],["أَزْوَٰجَهُنَّ","azwājahunna","their husbands","তাদের (পূর্বের) স্বামীকে"],["إِذَا","idhā","when","যখন"],["تَرَٰضَوْا۟","tarāḍaw","they agree","তারা পরস্পর সম্মত হয়"],["بَيْنَهُم","baynahum","between themselves","তাদের মাঝে"],["بِٱلْمَعْرُوفِ ۗ","bil-ma‘rūfi","in a fair manner","ন্যায় সংগত উপায়ে"],["ذَٰلِكَ","dhālika","That","এটা"],["يُوعَظُ","yū‘aẓu","is admonished","উপদেশ দেয়া হচ্ছে"],["بِهِۦ","bihi","with it","তার প্রতি"],["مَن","man","whoever","(তার জন্যে) যে কেউ"],["كَانَ","kāna","[is]","হয়"],["مِنكُمْ","minkum","among you","তোমাদের মধ্যথেকে"],["يُؤْمِنُ","yu'minu","believes","ঈমান এনে থাকে"],["بِٱللَّهِ","bil-lahi","in Allah","আল্লাহর উপর"],["وَٱلْيَوْمِ","wal-yawmi","and the Day","ও দিনের"],["ٱلْـَٔاخِرِ ۗ","l-ākhiri","[the] Last","আখেরাতের"],["ذَٰلِكُمْ","dhālikum","that","এটা"],["أَزْكَىٰ","azkā","(is) more virtuous","শুদ্ধতম পন্থা"],["لَكُمْ","lakum","for you","তোমাদের জন্যে"],["وَأَطْهَرُ ۗ","wa-aṭharu","and more purer","ও পবিত্রতম"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["يَعْلَمُ","ya‘lamu","knows","জানেন"],["وَأَنتُمْ","wa-antum","and you","আর তোমরা"],["لَا","lā","(do) not","না"],["تَعْلَمُونَ","ta‘lamūna","know","জান"]],"t":"وَإِذَا طَلَّ<q>قْ</>تُمُ <h>ٱ</><l>ل</><g>نِّ</><o>سَآ</>ءَ فَبَلَغْنَ أَجَلَهُ<g>نَّ</> فَلَا تَعْضُلُوهُ<g>نَّ</> <d>أَن يَ</><k>نكِ</>حْنَ أَزْ<m>وَٰ</>جَهُ<g>نَّ</> إِذَا تَ<m>رَٰ</>ضَوْ<s>ا۟</> بَيْنَ<f>هُم بِ</><h>ٱ</>لْمَعْرُوفِ ۗ <m>ذَٰ</>لِكَ يُوعَظُ بِ<m>هِۦ</> مَ<k>ن كَ</>انَ مِ<k>نكُ</>مْ يُؤْمِنُ بِ<h>ٱ</>للَّهِ وَ<h>ٱ</>لْيَوْمِ <h>ٱ</>لْءَاخِرِ ۗ <m>ذَٰ</>لِكُمْ أَزْكَىٰ لَكُمْ وَأَ<q>طْ</>هَرُ ۗ وَ<h>ٱ</>للَّهُ يَعْلَمُ وَأَ<k>نتُ</>مْ لَا تَعْلَ<p>مُو</>نَ"},{"n":233,"w":[["۞ وَٱلْوَٰلِدَٰتُ","wal-wālidātu","And the mothers","এবং মায়েরা"],["يُرْضِعْنَ","yur'ḍi‘'na","shall suckle","স্তন্য পান করাবে"],["أَوْلَـٰدَهُنَّ","awlādahunna","their children","তাদের সন্তানদের"],["حَوْلَيْنِ","ḥawlayni","(for) two years","দু’বছর"],["كَامِلَيْنِ ۖ","kāmilayni","complete","পূর্ণ"],["لِمَنْ","liman","for whoever","তার জন্য যে (বাপ)"],["أَرَادَ","arāda","wishes","চায়"],["أَن","an","to","যে"],["يُتِمَّ","yutimma","complete","পূর্ণ করবে"],["ٱلرَّضَاعَةَ ۚ","l-raḍā‘ata","the suckling","স্তন্যপান করানোর সময়"],["وَعَلَى","wa‘alā","And upon","এবং (দায়িত্ব তার) উপর"],["ٱلْمَوْلُودِ","l-mawlūdi","the father","যার নবজাতক"],["لَهُۥ","lahu","(on) him","জন্য"],["رِزْقُهُنَّ","riz'quhunna","(is) their provision","তাদের (অর্থাৎ মাদের) জীবিকা"],["وَكِسْوَتُهُنَّ","wakis'watuhunna","and their clothing","ও তাদের পোশাকের"],["بِٱلْمَعْرُوفِ ۚ","bil-ma‘rūfi","in a fair manner","ন্যায় সংগত উপায়ে"],["لَا","lā","Not","না"],["تُكَلَّفُ","tukallafu","is burdened","দায়িত্বভার দেওয়া হবে"],["نَفْسٌ","nafsun","any soul","কাউকে"],["إِلَّا","illā","except","এছাড়া"],["وُسْعَهَا ۚ","wus'‘ahā","its capacity","তার সামর্থ্য"],["لَا","lā","Not","না"],["تُضَآرَّ","tuḍārra","made to suffer","ক্ষতিগ্রস্ত করা হবে"],["وَٰلِدَةٌۢ","wālidatun","(the) mother","মাকে"],["بِوَلَدِهَا","biwaladihā","because of her child","তার সন্তানের কারণে"],["وَلَا","walā","and not","আর না"],["مَوْلُودٌۭ","mawlūdun","(the) father","যার নবজাতক (অর্থাৎ বাপকে)"],["لَّهُۥ","lahu","(be)","জন্য"],["بِوَلَدِهِۦ ۚ","biwaladihi","because of his child","তার সন্তানের কারণে"],["وَعَلَى","wa‘alā","And on","এবং উপর"],["ٱلْوَارِثِ","l-wārithi","the (father's) heir","উত্তরাধিকারীর"],["مِثْلُ","mith'lu","(is a duty) like","অনুরূপ"],["ذَٰلِكَ ۗ","dhālika","that (of the father)","এটা (অধিকার)"],["فَإِنْ","fa-in","Then if","অতঃপর যদি"],["أَرَادَا","arādā","they both desire","উভয়ে চায়"],["فِصَالًا","fiṣālan","weaning","দুধ ছাড়াতে"],["عَن","‘an","through","মাধ্যমে"],["تَرَاضٍۢ","tarāḍin","mutual consent","পরস্পর সম্মতির"],["مِّنْهُمَا","min'humā","of both of them","উভয় পক্ষের"],["وَتَشَاوُرٍۢ","watashāwurin","and consultation","ও পরামর্শের ভিত্তিতে"],["فَلَا","falā","then no","নেই তবে"],["جُنَاحَ","junāḥa","blame","কোনো পাপ"],["عَلَيْهِمَا ۗ","‘alayhimā","on both of them","তাদের উভয়ের উপর"],["وَإِنْ","wa-in","And if","এবং যদি"],["أَرَدتُّمْ","aradttum","you want","তোমরা চাও"],["أَن","an","to","যে"],["تَسْتَرْضِعُوٓا۟","tastarḍi‘ū","ask another women to suckle","তোমরা দুধপান করাবে (কোনো ধাত্রী দিয়ে)"],["أَوْلَـٰدَكُمْ","awlādakum","your child","তোমাদের সন্তানদের"],["فَلَا","falā","then (there is) no","নেই তবে"],["جُنَاحَ","junāḥa","blame","কোনো পাপ"],["عَلَيْكُمْ","‘alaykum","on you","তোমাদের উপর"],["إِذَا","idhā","when","যখন"],["سَلَّمْتُم","sallamtum","you pay","তোমরা অর্পন কর"],["مَّآ","mā","what","যা"],["ءَاتَيْتُم","ātaytum","you give","তোমরা দিতে চেয়েছিলে"],["بِٱلْمَعْرُوفِ ۗ","bil-ma‘rūfi","in a fair manner","সংগত ভাবে"],["وَٱتَّقُوا۟","wa-ittaqū","And fear","এবং তোমরা ভয় করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["وَٱعْلَمُوٓا۟","wa-i‘'lamū","and know","এবং তোমরা জেনে রাখো"],["أَنَّ","anna","that","যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["بِمَا","bimā","of what","ঐ বিষয় যা"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা কাজ করছ"],["بَصِيرٌۭ","baṣīrun","(is) All-Seer","সবকিছু দেখেন"]],"t":"۞ وَ<h>ٱ</>لْ<m>وَٰلِدَٰ</>تُ يُرْضِعْنَ أَوْ<m>لَٰ</>دَهُ<g>نَّ</> حَوْلَيْنِ كَامِلَيْنِ ۖ لِمَنْ أَرَادَ <d>أَن يُ</>تِ<g>مَّ</> <h>ٱ</><l>ل</>رَّضَاعَةَ ۚ وَعَلَى <h>ٱ</>لْمَوْلُودِ لَهُ<m>ۥ</> رِزْقُهُ<g>نَّ</> وَكِسْوَتُهُ<g>نَّ</> بِ<h>ٱ</>لْمَعْرُوفِ ۚ لَا تُكَلَّفُ نَفْسٌ إِلَّا وُسْعَهَا ۚ لَا تُ<n>ضَآ</>رَّ <m>وَٰ</>لِدَ<i>ةٌۢ بِ</>وَلَدِهَا وَلَا مَوْلُو<w>دٌۭ لَّ</>هُ<m>ۥ</> بِوَلَدِ<m>هِۦ</> ۚ وَعَلَى <h>ٱ</>لْوَارِثِ مِثْلُ <m>ذَٰ</>لِكَ ۗ فَإِنْ أَرَادَا فِصَالًا عَ<k>ن تَ</>رَا<d>ضٍۢ مِّ</>نْهُمَا وَتَشَاوُ<k>رٍۢ فَ</>لَا جُنَاحَ عَلَيْهِمَا ۗ وَإِنْ أَرَ<j>د</>تُّمْ أَ<k>ن تَ</>سْتَرْضِ<o>عُوٓ</><s>ا۟</> أَوْ<m>لَٰ</>دَكُمْ فَلَا جُنَاحَ عَلَيْكُمْ إِذَا سَلَّمْ<y>تُم مَّ</><o>آ</> ءَاتَيْ<f>تُم بِ</><h>ٱ</>لْمَعْرُوفِ ۗ وَ<h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</>للَّهَ وَ<h>ٱ</>عْلَ<o>مُوٓ</><s>ا۟</> أَ<g>نَّ</> <h>ٱ</>للَّهَ بِمَا تَعْمَلُونَ بَ<p>صِي</>رٌۭ"},{"n":234,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["يُتَوَفَّوْنَ","yutawaffawna","pass away","মারা যায়"],["مِنكُمْ","minkum","among you","তোমাদের মধ্যেথেকে"],["وَيَذَرُونَ","wayadharūna","and leave behind","এবং তারা রেখে যায়"],["أَزْوَٰجًۭا","azwājan","wives","স্ত্রীদেরকে"],["يَتَرَبَّصْنَ","yatarabbaṣna","(the widows) should wait","তারা অপেক্ষায় রাখবে (অর্থাৎ স্ত্রীরা)"],["بِأَنفُسِهِنَّ","bi-anfusihinna","for themselves","তাদের নিজেদেরকে"],["أَرْبَعَةَ","arba‘ata","(for) four","চার"],["أَشْهُرٍۢ","ashhurin","months","মাস"],["وَعَشْرًۭا ۖ","wa‘ashran","and ten (days)","ও দশ (দিন পর্যন্ত)"],["فَإِذَا","fa-idhā","Then when","অতঃপর যখন"],["بَلَغْنَ","balaghna","they reach","তারা পৌঁছে"],["أَجَلَهُنَّ","ajalahunna","their (specified) term","তাদের মেয়াদে"],["فَلَا","falā","then (there is) no","নেই তখন"],["جُنَاحَ","junāḥa","blame","কোনো পাপ"],["عَلَيْكُمْ","‘alaykum","upon you","তোমাদের উপর"],["فِيمَا","fīmā","for what","সেক্ষেত্রে যা"],["فَعَلْنَ","fa‘alna","they do","তারা করে"],["فِىٓ","fī","concerning","সম্পর্কে"],["أَنفُسِهِنَّ","anfusihinna","themselves","তাদের নিজেদের"],["بِٱلْمَعْرُوفِ ۗ","bil-ma‘rūfi","in a fair manner","ন্যায়সংগত ভাবে"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["بِمَا","bimā","of what","ঐ বিষয়ে যা"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা কাজ কর"],["خَبِيرٌۭ","khabīrun","(is) All-Aware","সবিশেষ অবহিত"]],"t":"وَ<h>ٱ</>لَّذِينَ يُتَوَفَّوْنَ مِ<k>نكُ</>مْ وَيَذَرُونَ أَزْ<m>وَٰ</><d>جًۭا يَ</>تَرَبَّصْنَ بِأَ<k>نفُ</>سِهِ<g>نَّ</> أَرْبَعَةَ أَشْهُ<d>رٍۢ وَ</>عَشْ<k>رًۭا ۖ فَ</>إِذَا بَلَغْنَ أَجَلَهُ<g>نَّ</> فَلَا جُنَاحَ عَلَيْكُمْ فِيمَا فَعَلْنَ <o>فِىٓ</> أَ<k>نفُ</>سِهِ<g>نَّ</> بِ<h>ٱ</>لْمَعْرُوفِ ۗ وَ<h>ٱ</>للَّهُ بِمَا تَعْمَلُونَ خَ<p>بِي</>رٌۭ"},{"n":235,"w":[["وَلَا","walā","And (there is) no","এবং নেই"],["جُنَاحَ","junāḥa","blame","কোনো পাপ"],["عَلَيْكُمْ","‘alaykum","upon you","তোমাদের উপর"],["فِيمَا","fīmā","in what","সেক্ষেত্রে যা"],["عَرَّضْتُم","‘arraḍtum","you hint","তোমরা আভাস-ইঙ্গিতে প্রকাশ কর"],["بِهِۦ","bihi","[with it]","তা"],["مِنْ","min","of","বিষয়টি"],["خِطْبَةِ","khiṭ'bati","marriage proposal","বিয়ের প্রস্তাবের"],["ٱلنِّسَآءِ","l-nisāi","[to] the women","(বিধবা) নারীদের"],["أَوْ","aw","or","বা"],["أَكْنَنتُمْ","aknantum","you conceal it","তোম