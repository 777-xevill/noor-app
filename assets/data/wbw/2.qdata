{"n":2,"a":[{"n":1,"w":[["الٓمٓ","alif-lam-meem","Alif Laam Meem","আলিফ লা-ম মী-ম"]],"t":"ا<n>لٓمٓ</>"},{"n":2,"w":[["ذَٰلِكَ","dhālika","That","(এটা) সেই"],["ٱلْكِتَـٰبُ","l-kitābu","(is) the book","মহাগ্রন্থ (আল্লাহর)"],["لَا","lā","no","নেই"],["رَيْبَ ۛ","rayba","doubt","কোনো সন্দেহ"],["فِيهِ ۛ","fīhi","in it","তাঁরমধ্যে"],["هُدًۭى","hudan","a Guidance","সৎপথ নির্দেশ (হেদায়াত)"],["لِّلْمُتَّقِينَ","lil'muttaqīna","for the God-conscious","মুত্তাকীদের জন্য"]],"t":"<m>ذَٰ</>لِكَ <h>ٱ</>لْكِ<m>تَٰ</>بُ لَا رَيْبَ ۛ فِيهِ ۛ هُ<w>دًۭى لِّ</>لْمُتَّ<p>قِي</>نَ"},{"n":3,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["يُؤْمِنُونَ","yu'minūna","believe","বিশ্বাস করে"],["بِٱلْغَيْبِ","bil-ghaybi","in the unseen","অদৃশ্যের ওপর"],["وَيُقِيمُونَ","wayuqīmūna","and establish","এবং প্রতিষ্ঠিত করে"],["ٱلصَّلَوٰةَ","l-ṣalata","the prayer","সালাত"],["وَمِمَّا","wamimmā","and out of what","ও তা হতে যা"],["رَزَقْنَـٰهُمْ","razaqnāhum","We have provided them","তাদের আমরা জীবিকা দিয়েছি"],["يُنفِقُونَ","yunfiqūna","they spend","তারা ব্যয় করে"]],"t":"ٱلَّذِينَ يُؤْمِنُونَ بِ<h>ٱ</>لْغَيْبِ وَيُقِيمُونَ <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةَ وَمِ<g>مَّ</>ا رَزَ<q>قْ</><m>نَٰ</>هُمْ يُ<k>نفِ</><p>قُو</>نَ"},{"n":4,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["يُؤْمِنُونَ","yu'minūna","believe","বিশ্বাস করে"],["بِمَآ","bimā","in what","ঐ বিষয়ে যা"],["أُنزِلَ","unzila","(is) sent down","অবতীর্ণ করা হয়েছে"],["إِلَيْكَ","ilayka","to you","তোমার প্রতি"],["وَمَآ","wamā","and what","এবং যা"],["أُنزِلَ","unzila","was sent down","অবতীর্ণ করা হয়েছে"],["مِن","min","from","থেকে"],["قَبْلِكَ","qablika","before you","তোমার পূর্বে"],["وَبِٱلْـَٔاخِرَةِ","wabil-ākhirati","and in the Hereafter","এবং আখিরাতের উপর"],["هُمْ","hum","they","তারা"],["يُوقِنُونَ","yūqinūna","firmly believe","দৃঢ়বিশ্বাস রাখে"]],"t":"وَ<h>ٱ</>لَّذِينَ يُؤْمِنُونَ بِ<o>مَآ</> أُ<k>نزِ</>لَ إِلَيْكَ وَ<o>مَآ</> أُ<k>نزِ</>لَ مِ<k>ن قَ</><q>بْ</>لِكَ وَبِ<h>ٱ</>لْءَاخِرَةِ هُمْ يُوقِ<p>نُو</>نَ"},{"n":5,"w":[["أُو۟لَـٰٓئِكَ","ulāika","Those","তারাই (প্রতিষ্ঠিত)"],["عَلَىٰ","‘alā","(are) on","উপর"],["هُدًۭى","hudan","Guidance","সত্যপথের"],["مِّن","min","from","পক্ষ হতে"],["رَّبِّهِمْ ۖ","rabbihim","their Lord","তাদের রবের"],["وَأُو۟لَـٰٓئِكَ","wa-ulāika","and those ","এবং তারাই (ঐসব লোক)"],["هُمُ","humu","they","যারা"],["ٱلْمُفْلِحُونَ","l-muf'liḥūna","(are) the successful ones","সফলকাম"]],"t":"أُ<s>و۟</><o>لَٰٓ</>ئِكَ عَلَىٰ هُ<d>دًۭى مِّ</><w>ن رَّ</>بِّهِمْ ۖ وَأُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</>لْمُفْلِ<p>حُو</>نَ"},{"n":6,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieve[d]","অবিশ্বাস করেছে"],["سَوَآءٌ","sawāon","(it) is same","সমান"],["عَلَيْهِمْ","‘alayhim","to them","তাদের জন্যে"],["ءَأَنذَرْتَهُمْ","a-andhartahum","whether you warn them","তাদের তুমি সতর্ক কর কি"],["أَمْ","am","or","অথবা"],["لَمْ","lam","not","না"],["تُنذِرْهُمْ","tundhir'hum","you warn them","সতর্ক কর তুমি তাদেরকে"],["لَا","lā","not","না"],["يُؤْمِنُونَ","yu'minūna","they believe","তারা ঈমান আনবে"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> سَ<o>وَآ</>ءٌ عَلَيْهِمْ ءَأَ<k>نذَ</>رْتَهُمْ أَمْ لَمْ تُ<k>نذِ</>رْهُمْ لَا يُؤْمِ<p>نُو</>نَ"},{"n":7,"w":[["خَتَمَ","khatama","Has set a seal","সিল মেরে দিয়েছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["عَلَىٰ","‘alā","on","উপর"],["قُلُوبِهِمْ","qulūbihim","their hearts","তাদের অন্তরের"],["وَعَلَىٰ","wa‘alā","and on","এবং উপর"],["سَمْعِهِمْ ۖ","sam‘ihim","their hearing","তাদের শ্রবণশক্তির"],["وَعَلَىٰٓ","wa‘alā","and on","এবং উপর"],["أَبْصَـٰرِهِمْ","abṣārihim","their vision","তাদের দৃষ্টিশক্তির"],["غِشَـٰوَةٌۭ ۖ","ghishāwatun","(is) a veil","আবরণ (দিয়েছেন)"],["وَلَهُمْ","walahum","And for them","এবং তাদেরজন্যে (রয়েছে)"],["عَذَابٌ","‘adhābun","(is) a punishment","শাস্তি"],["عَظِيمٌۭ","‘aẓīmun","great","কঠিন"]],"t":"خَتَمَ <h>ٱ</>للَّهُ عَلَىٰ قُلُوبِهِمْ وَعَلَىٰ سَمْعِهِمْ ۖ وَعَلَ<o>ىٰٓ</> أَ<q>بْ</><m>صَٰ</>رِهِمْ غِ<m>شَٰ</>وَ<d>ةٌۭ ۖ وَ</>لَهُمْ عَذَابٌ عَ<p>ظِي</>مٌۭ"},{"n":8,"w":[["وَمِنَ","wamina","And of","এবং মধ্যহতে"],["ٱلنَّاسِ","l-nāsi","the people","মানুষের (এমনও আছে)"],["مَن","man","(are some) who","যারা"],["يَقُولُ","yaqūlu","say","বলে"],["ءَامَنَّا","āmannā","We believed","''আমরা ঈমান এনেছি"],["بِٱللَّهِ","bil-lahi","in Allah","আল্লাহর উপর"],["وَبِٱلْيَوْمِ","wabil-yawmi","and in the Day","ও দিনের উপর"],["ٱلْـَٔاخِرِ","l-ākhiri","[the] Last","আখিরাতের''"],["وَمَا","wamā","but not","অথচ না"],["هُم","hum","they","তারা"],["بِمُؤْمِنِينَ","bimu'minīna","(are) believers (at all)","মুমিন"]],"t":"وَمِنَ <h>ٱ</><l>ل</><g>نَّ</>اسِ <d>مَن يَ</>قُولُ ءَامَ<g>نَّ</>ا بِ<h>ٱ</>للَّهِ وَبِ<h>ٱ</>لْيَوْمِ <h>ٱ</>لْءَاخِرِ وَمَا <f>هُم بِ</>مُؤْمِ<p>نِي</>نَ"},{"n":9,"w":[["يُخَـٰدِعُونَ","yukhādi‘ūna","They seek to deceive","তারা প্রতারিত করতে চায়"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["وَٱلَّذِينَ","wa-alladhīna","and those who","ও (তাদেরকে) যারা"],["ءَامَنُوا۟","āmanū","believe[d]","ঈমান এনেছে"],["وَمَا","wamā","and not","কিন্তু না"],["يَخْدَعُونَ","yakhda‘ūna","they deceive","তারা প্রতারিত করে"],["إِلَّآ","illā","except","ছাড়া"],["أَنفُسَهُمْ","anfusahum","themselves","তাদের নিজেদেরকে"],["وَمَا","wamā","and not","এবং না"],["يَشْعُرُونَ","yash‘urūna","they realize (it)","তারা অনুভব করে"]],"t":"يُ<m>خَٰ</>دِعُونَ <h>ٱ</>للَّهَ وَ<h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَمَا يَخْدَعُونَ إِ<o>لَّآ</> أَ<k>نفُ</>سَهُمْ وَمَا يَشْعُ<p>رُو</>نَ"},{"n":10,"w":[["فِى","fī","In","মধ্যে আছে"],["قُلُوبِهِم","qulūbihim","their hearts","তাদের অন্তর সমূহের"],["مَّرَضٌۭ","maraḍun","(is) a disease","রোগ (আছে)"],["فَزَادَهُمُ","fazādahumu","so has increased them","বৃদ্ধি করলেন তাই (আরও) তাদেরকে"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ্‌"],["مَرَضًۭا ۖ","maraḍan","(in) disease","(তাদের) রোগ"],["وَلَهُمْ","walahum","and for them","এবং তাদের জন্য (রয়েছে)"],["عَذَابٌ","‘adhābun","(is) a punishment","শাস্তি"],["أَلِيمٌۢ","alīmun","painful","কষ্টদায়ক"],["بِمَا","bimā","because","এজন্যে যে"],["كَانُوا۟","kānū","they used to","তারা ছিল"],["يَكْذِبُونَ","yakdhibūna","[they] lie","তারা মিথ্যা বলতো"]],"t":"فِى قُلُوبِ<y>هِم مَّ</>رَ<k>ضٌۭ فَ</>زَادَهُمُ <h>ٱ</>للَّهُ مَرَ<d>ضًۭا ۖ وَ</>لَهُمْ عَذَابٌ أَلِي<i>مٌۢ بِ</>مَا كَانُو<s>ا۟</> يَكْذِ<p>بُو</>نَ"},{"n":11,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["قِيلَ","qīla","it is said","বলা হয়"],["لَهُمْ","lahum","to them","তাদের উদ্দেশ্যে"],["لَا","lā","(Do) not","''না"],["تُفْسِدُوا۟","tuf'sidū","spread corruption","বিপর্যয় সৃষ্টি করো"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর''"],["قَالُوٓا۟","qālū","they say","তারা বলে"],["إِنَّمَا","innamā","Only","''মূলতঃ"],["نَحْنُ","naḥnu","we","আমরা"],["مُصْلِحُونَ","muṣ'liḥūna","(are) reformers","সংশোধনকারী''"]],"t":"وَإِذَا قِيلَ لَهُمْ لَا تُفْسِدُو<s>ا۟</> فِى <h>ٱ</>لْأَرْضِ قَا<o>لُوٓ</><s>ا۟</> إِ<g>نَّ</>مَا نَحْنُ مُصْلِ<p>حُو</>نَ"},{"n":12,"w":[["أَلَآ","alā","Beware","সাবধান"],["إِنَّهُمْ","innahum","indeed they","তারা নিশ্চয়ই"],["هُمُ","humu","themselves","তারাই"],["ٱلْمُفْسِدُونَ","l-muf'sidūna","(are) the ones who spread corruption","বিপর্যয় সৃষ্টিকারী"],["وَلَـٰكِن","walākin","[and] but","কিন্তু"],["لَّا","lā","not","না"],["يَشْعُرُونَ","yash‘urūna","they realize (it)","তারা অনুভব করে"]],"t":"أَ<o>لَآ</> إِ<g>نَّ</>هُمْ هُمُ <h>ٱ</>لْمُفْسِدُونَ وَ<m>لَٰ</><w>كِن لَّ</>ا يَشْعُ<p>رُو</>نَ"},{"n":13,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["قِيلَ","qīla","it is said","বলা হয়"],["لَهُمْ","lahum","to them","তাদের উদ্দেশ্যে"],["ءَامِنُوا۟","āminū","Believe","''তোমরা ঈমান আনো"],["كَمَآ","kamā","as","যেমন"],["ءَامَنَ","āmana","believed","ঈমান এনেছে"],["ٱلنَّاسُ","l-nāsu","the people","মানুষ''"],["قَالُوٓا۟","qālū","they say","তারা বলে"],["أَنُؤْمِنُ","anu'minu","Should we believe","''আমরা কি ঈমান আনবো"],["كَمَآ","kamā","as","যেমন"],["ءَامَنَ","āmana","believed","ঈমান এনেছে"],["ٱلسُّفَهَآءُ ۗ","l-sufahāu","the fools","বোকারা''"],["أَلَآ","alā","Beware","সাবধান"],["إِنَّهُمْ","innahum","certainly they","নিশ্চয়ই তারা"],["هُمُ","humu","themselves","তারাই"],["ٱلسُّفَهَآءُ","l-sufahāu","(are) the fools","বোকা"],["وَلَـٰكِن","walākin","[and] but","কিন্তু"],["لَّا","lā","not","না"],["يَعْلَمُونَ","ya‘lamūna","they know","তারা জানে"]],"t":"وَإِذَا قِيلَ لَهُمْ ءَامِنُو<s>ا۟</> كَ<o>مَآ</> ءَامَنَ <h>ٱ</><l>ل</><g>نَّ</>اسُ قَا<o>لُوٓ</><s>ا۟</> أَنُؤْمِنُ كَ<o>مَآ</> ءَامَنَ <h>ٱ</><l>ل</>سُّفَ<o>هَآ</>ءُ ۗ أَ<o>لَآ</> إِ<g>نَّ</>هُمْ هُمُ <h>ٱ</><l>ل</>سُّفَ<o>هَآ</>ءُ وَ<m>لَٰ</><w>كِن لَّ</>ا يَعْلَ<p>مُو</>نَ"},{"n":14,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["لَقُوا۟","laqū","they meet","তারা মিলিত হয়"],["ٱلَّذِينَ","alladhīna","those who","(তাদের সাথে) যারা"],["ءَامَنُوا۟","āmanū","believe[d]","ঈমান এনেছে"],["قَالُوٓا۟","qālū","they say","তারা বলে"],["ءَامَنَّا","āmannā","We believe[d]","''আমরা ঈমান এনেছি''"],["وَإِذَا","wa-idhā","But when","এবং যখন"],["خَلَوْا۟","khalaw","they are alone","গোপনে মিলে"],["إِلَىٰ","ilā","with","সাথে"],["شَيَـٰطِينِهِمْ","shayāṭīnihim","their evil ones","তাদের শয়তান (বন্ধুদের)"],["قَالُوٓا۟","qālū","they say","তারা বলে"],["إِنَّا","innā","Indeed, we","''নিশ্চয়ই আমরা"],["مَعَكُمْ","ma‘akum","(are) with you","তোমাদের সাথে"],["إِنَّمَا","innamā","only","মূলতঃ"],["نَحْنُ","naḥnu","we","আমরা"],["مُسْتَهْزِءُونَ","mus'tahziūna","(are) mockers","উপহাসকারী (মু'মিনদের সাথে)''"]],"t":"وَإِذَا لَقُو<s>ا۟</> <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> قَا<o>لُوٓ</><s>ا۟</> ءَامَ<g>نَّ</>ا وَإِذَا خَلَوْ<s>ا۟</> إِلَىٰ شَ<m>يَٰ</>طِينِهِمْ قَا<o>لُوٓ</><s>ا۟</> إِ<g>نَّ</>ا مَعَكُمْ إِ<g>نَّ</>مَا نَحْنُ مُسْتَهْزِ<p>ءُو</>نَ"},{"n":15,"w":[["ٱللَّهُ","al-lahu","Allah","আল্লাহ্‌"],["يَسْتَهْزِئُ","yastahzi-u","mocks","উপহাস করেন"],["بِهِمْ","bihim","at them","তাদের সাথে"],["وَيَمُدُّهُمْ","wayamudduhum","and prolongs them","এবং তাদের ঢিলদেন"],["فِى","fī","in","মধ্যে"],["طُغْيَـٰنِهِمْ","ṭugh'yānihim","their transgression","তাদের অবাধ্যতার"],["يَعْمَهُونَ","ya‘mahūna","they wander blindly","তারা উদভ্রান্ত হয়ে ফিরে"]],"t":"ٱللَّهُ يَسْتَهْزِئُ بِهِمْ وَيَمُدُّهُمْ فِى طُغْ<m>يَٰ</>نِهِمْ يَعْمَ<p>هُو</>نَ"},{"n":16,"w":[["أُو۟لَـٰٓئِكَ","ulāika","Those","তারাই (ঐসব লোক)"],["ٱلَّذِينَ","alladhīna","(are) the ones who","যারা"],["ٱشْتَرَوُا۟","ish'tarawū","bought","কিনেছে"],["ٱلضَّلَـٰلَةَ","l-ḍalālata","[the] astraying","পথভ্রশ্ততা"],["بِٱلْهُدَىٰ","bil-hudā","for [the] guidance","সৎপথের বিনিময়"],["فَمَا","famā","So not","সুতরাং না"],["رَبِحَت","rabiḥat","profited","লাভজনক হয়"],["تِّجَـٰرَتُهُمْ","tijāratuhum","their commerce","তাদের ব্যবসা"],["وَمَا","wamā","and not","এবং না"],["كَانُوا۟","kānū","were they","তারা ছিল"],["مُهْتَدِينَ","muh'tadīna","guided-ones","সৎপথে পরিচালিত"]],"t":"أُ<s>و۟</><o>لَٰٓ</>ئِكَ <h>ٱ</>لَّذِينَ <h>ٱ</>شْتَرَوُ<s>ا۟</> <h>ٱ</><l>ل</>ضَّ<m>لَٰ</>لَةَ بِ<h>ٱ</>لْهُدَىٰ فَمَا رَبِحَت تِّ<m>جَٰ</>رَتُهُمْ وَمَا كَانُو<s>ا۟</> مُهْتَ<p>دِي</>نَ"},{"n":17,"w":[["مَثَلُهُمْ","mathaluhum","Their example","তাদের উপমা"],["كَمَثَلِ","kamathali","(is) like (the) example","উপমা যেমন (এক ব্যক্তির)"],["ٱلَّذِى","alladhī","(of) the one who","যে"],["ٱسْتَوْقَدَ","is'tawqada","kindled","জ্বালালো"],["نَارًۭا","nāran","a fire","আগুন"],["فَلَمَّآ","falammā","then, when","অতঃপর যখন"],["أَضَآءَتْ","aḍāat","it illuminated","আলোকিত করলো"],["مَا","mā","what","যা"],["حَوْلَهُۥ","ḥawlahu","(was) around him","তার চারপাশে"],["ذَهَبَ","dhahaba","took away","নিলেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ্‌"],["بِنُورِهِمْ","binūrihim","their light","তাদের আলো নিয়ে"],["وَتَرَكَهُمْ","watarakahum","and left them","এবং তাদের ছেড়ে দিলেন"],["فِى","fī","in","মধ্যে"],["ظُلُمَـٰتٍۢ","ẓulumātin","darkness[es]","অন্ধকার সমূহের"],["لَّا","lā","(so) not","না"],["يُبْصِرُونَ","yub'ṣirūna","(do) they see","তারা দেখতে পায়"]],"t":"مَثَلُهُمْ كَمَثَلِ <h>ٱ</>لَّذِى <h>ٱ</>سْتَوْقَدَ نَا<k>رًۭا فَ</>لَ<g>مَّ</><o>آ</> أَ<o>ضَآ</>ءَتْ مَا حَوْلَهُ<m>ۥ</> ذَهَبَ <h>ٱ</>للَّهُ بِنُورِهِمْ وَتَرَكَهُمْ فِى ظُلُ<m>مَٰ</><w>تٍۢ لَّ</>ا يُ<q>بْ</>صِ<p>رُو</>نَ"},{"n":18,"w":[["صُمٌّۢ","ṣummun","Deaf","বধির"],["بُكْمٌ","buk'mun","dumb","বোবা"],["عُمْىٌۭ","‘um'yun","blind","অন্ধ"],["فَهُمْ","fahum","so they","সুতরাং তারা"],["لَا","lā","not","না"],["يَرْجِعُونَ","yarji‘ūna","[they] will not return","প্রত্যাবর্তন করবে"]],"t":"صُ<i>مٌّۢ بُ</>كْمٌ عُمْ<k>ىٌۭ فَ</>هُمْ لَا يَرْجِ<p>عُو</>نَ"},{"n":19,"w":[["أَوْ","aw","Or","অথবা"],["كَصَيِّبٍۢ","kaṣayyibin","like a rainstorm","মতো বৃষ্টিপাতের"],["مِّنَ","mina","from","থেকে"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশ"],["فِيهِ","fīhi","in it (are)","তার মধ্যে (আছে)"],["ظُلُمَـٰتٌۭ","ẓulumātun","darkness[es]","অন্ধকার"],["وَرَعْدٌۭ","wara‘dun","and thunder","এবং গর্জন"],["وَبَرْقٌۭ","wabarqun","and lightning","ও বিদ্যুৎচমক"],["يَجْعَلُونَ","yaj‘alūna","They put","তারা রাখে"],["أَصَـٰبِعَهُمْ","aṣābi‘ahum","their fingers","তাদের আঙ্গুলগুলোকে"],["فِىٓ","fī","in","মধ্যে"],["ءَاذَانِهِم","ādhānihim","their ears","তাদের কানগুলোর"],["مِّنَ","mina","from","কারনে"],["ٱلصَّوَٰعِقِ","l-ṣawā‘iqi","the thunderclaps","বজ্রধ্বনির"],["حَذَرَ","ḥadhara","(in) fear (of)","ভয়ে"],["ٱلْمَوْتِ ۚ","l-mawti","[the] death","মৃত্যুর"],["وَٱللَّهُ","wal-lahu","And Allah","অথচ আল্লাহ্‌"],["مُحِيطٌۢ","muḥīṭun","(is) [the One Who] encompasses","পরিবেষ্টনকারী"],["بِٱلْكَـٰفِرِينَ","bil-kāfirīna","the disbelievers","কাফিরদের"]],"t":"أَوْ كَصَيِّ<d>بٍۢ مِّ</>نَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ فِيهِ ظُلُ<m>مَٰ</><d>تٌۭ وَ</>رَعْ<d>دٌۭ وَ</>بَرْ<d>قٌۭ يَ</><q>جْ</>عَلُونَ أَ<m>صَٰ</>بِعَهُمْ <o>فِىٓ</> ءَاذَانِ<y>هِم مِّ</>نَ <h>ٱ</><l>ل</>صَّ<m>وَٰ</>عِقِ حَذَرَ <h>ٱ</>لْمَوْتِ ۚ وَ<h>ٱ</>للَّهُ مُحِي<i>طٌۢ بِ</><h>ٱ</>لْ<m>كَٰ</>فِ<p>رِي</>نَ"},{"n":20,"w":[["يَكَادُ","yakādu","Almost","প্রায়"],["ٱلْبَرْقُ","l-barqu","the lightning","বিদ্যুৎচমক"],["يَخْطَفُ","yakhṭafu","snatches away","কেড়ে নেয়"],["أَبْصَـٰرَهُمْ ۖ","abṣārahum","their sight","তাদের দৃষ্টিসমূহের"],["كُلَّمَآ","kullamā","Whenever","যখনই"],["أَضَآءَ","aḍāa","it flashes","আলোকিত হয়"],["لَهُم","lahum","for them","তাদের জন্য"],["مَّشَوْا۟","mashaw","they walk","তারা চলে"],["فِيهِ","fīhi","in it","তারমধ্যে"],["وَإِذَآ","wa-idhā","and when","এবং যখন"],["أَظْلَمَ","aẓlama","it darkens","অন্ধকার হয়"],["عَلَيْهِمْ","‘alayhim","on them","তাদের উপর"],["قَامُوا۟ ۚ","qāmū","they stand (still)","তারা দাড়িয়ে যায়"],["وَلَوْ","walaw","And if","আর যদি"],["شَآءَ","shāa","had willed","চান"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ্‌"],["لَذَهَبَ","ladhahaba","He would certainly have taken away","অবশ্যই নিয়ে নিবেন"],["بِسَمْعِهِمْ","bisam‘ihim","their hearing","তাদের শ্রবণশক্তি"],["وَأَبْصَـٰرِهِمْ ۚ","wa-abṣārihim","and their sight","এবং তাদের দর্শনশক্তি"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["عَلَىٰ","‘alā","(is) on","উপর"],["كُلِّ","kulli","every","সব"],["شَىْءٍۢ","shayin","thing","কিছুর"],["قَدِيرٌۭ","qadīrun","All-Powerful","সর্বশক্তিমান"]],"t":"يَكَادُ <h>ٱ</>لْبَرْقُ يَخْطَفُ أَ<q>بْ</><m>صَٰ</>رَهُمْ ۖ كُلَّ<o>مَآ</> أَ<o>ضَآ</>ءَ لَ<y>هُم مَّ</>شَوْ<s>ا۟</> فِيهِ وَإِ<o>ذَآ</> أَظْلَمَ عَلَيْهِمْ قَامُو<s>ا۟ ۚ</> وَلَوْ <o>شَآ</>ءَ <h>ٱ</>للَّهُ لَذَهَبَ بِسَمْعِهِمْ وَأَ<q>بْ</><m>صَٰ</>رِهِمْ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ عَلَىٰ كُلِّ <k>شَىْءٍۢ قَ</><p>دِي</>رٌۭ"},{"n":21,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O","হে"],["ٱلنَّاسُ","l-nāsu","mankind","মানুষ"],["ٱعْبُدُوا۟","u‘'budū","worship","তোমরা ইবাদত করো"],["رَبَّكُمُ","rabbakumu","your Lord","তোমাদের রবের,"],["ٱلَّذِى","alladhī","the One Who","যিনি"],["خَلَقَكُمْ","khalaqakum","created you","তোমাদের সৃষ্টি করেছেন"],["وَٱلَّذِينَ","wa-alladhīna","and those","এবং যারা (ছিল)"],["مِن","min","from","থেকে"],["قَبْلِكُمْ","qablikum","before you","তোমাদের পূর্ব (তাদেরও স্রষ্টা)"],["لَعَلَّكُمْ","la‘allakum","so that you may","তোমরা যেন"],["تَتَّقُونَ","tattaqūna","become righteous","বেঁচে চলতে পারো (পাপ হতে)"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</><l>ل</><g>نَّ</>اسُ <h>ٱ</>عْبُدُو<s>ا۟</> رَبَّكُمُ <h>ٱ</>لَّذِى خَلَقَكُمْ وَ<h>ٱ</>لَّذِينَ مِ<k>ن قَ</><q>بْ</>لِكُمْ لَعَلَّكُمْ تَتَّ<p>قُو</>نَ"},{"n":22,"w":[["ٱلَّذِى","alladhī","The One Who","যিনি"],["جَعَلَ","ja‘ala","made","করেছেন"],["لَكُمُ","lakumu","for you","তোমাদের জন্য"],["ٱلْأَرْضَ","l-arḍa","the earth","পৃথিবীকে"],["فِرَٰشًۭا","firāshan","a resting place","শয্যা"],["وَٱلسَّمَآءَ","wal-samāa","and the sky","ও আকাশকে"],["بِنَآءًۭ","bināan","a canopy","ছাদ স্বরূপ,"],["وَأَنزَلَ","wa-anzala","and sent down","এবং বর্ষণ করেছেন"],["مِنَ","mina","from","থেকে"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশ"],["مَآءًۭ","māan","water","পানি,"],["فَأَخْرَجَ","fa-akhraja","then brought forth","এরপর বের করেছেন"],["بِهِۦ","bihi","therewith","তা দ্বারা"],["مِنَ","mina","[of]","কোনো"],["ٱلثَّمَرَٰتِ","l-thamarāti","the fruits","(নানা ধরণের) ফলমূল"],["رِزْقًۭا","riz'qan","(as) provision","রিযক হিসাবে"],["لَّكُمْ ۖ","lakum","for you","তোমাদের জন্য"],["فَلَا","falā","So (do) not","অতএব না"],["تَجْعَلُوا۟","taj‘alū","set up","দাড় করিও"],["لِلَّهِ","lillahi","to Allah","আল্লাহর সাথে"],["أَندَادًۭا","andādan","rivals","সমতুল্য (অন্য কাউকে)"],["وَأَنتُمْ","wa-antum","while you","অথচ তোমরা"],["تَعْلَمُونَ","ta‘lamūna","[you] know","জানো"]],"t":"ٱلَّذِى جَعَلَ لَكُمُ <h>ٱ</>لْأَرْضَ فِ<m>رَٰ</><d>شًۭا وَ</><h>ٱ</><l>ل</>سَّ<o>مَآ</>ءَ بِ<o>نَآ</><d>ءًۭ وَ</>أَ<k>نزَ</>لَ مِنَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ <o>مَآ</><k>ءًۭ فَ</>أَخْرَجَ بِ<m>هِۦ</> مِنَ <h>ٱ</><l>ل</>ثَّمَ<m>رَٰ</>تِ رِزْ<w>قًۭا لَّ</>كُمْ ۖ فَلَا تَ<q>جْ</>عَلُو<s>ا۟</> لِلَّهِ أَ<k>ندَ</>ا<d>دًۭا وَ</>أَ<k>نتُ</>مْ تَعْلَ<p>مُو</>نَ"},{"n":23,"w":[["وَإِن","wa-in","And if","এবং যদি"],["كُنتُمْ","kuntum","you are","তোমরা থাক"],["فِى","fī","in","মধ্যে"],["رَيْبٍۢ","raybin","doubt","সন্দেহের"],["مِّمَّا","mimmā","about what","তা হতে যা"],["نَزَّلْنَا","nazzalnā","We have revealed","আমরা অবতীর্ণ করেছি"],["عَلَىٰ","‘alā","to","উপর"],["عَبْدِنَا","‘abdinā","Our slave","আমাদের দাসের,"],["فَأْتُوا۟","fatū","then produce","তবে তোমরা আনো"],["بِسُورَةٍۢ","bisūratin","a chapter","একটি সূরা"],["مِّن","min","[of]","মধ্য হতে"],["مِّثْلِهِۦ","mith'lihi","like it","তার সদৃশ"],["وَٱدْعُوا۟","wa-id'‘ū","and call","এবং তোমরা ডাকো"],["شُهَدَآءَكُم","shuhadāakum","your witnesses","তোমাদের সাক্ষীদেরকে"],["مِّن","min","from","দিয়ে"],["دُونِ","dūni","other than","বাদ"],["ٱللَّهِ","l-lahi","Allah","আল্লাহকে"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you are","তোমরা হও"],["صَـٰدِقِينَ","ṣādiqīna","truthful","সত্যবাদী"]],"t":"وَإِ<k>ن كُنتُ</>مْ فِى رَيْ<d>بٍۢ مِّ</><g>مَّ</>ا نَزَّلْنَا عَلَىٰ عَ<q>بْ</>دِنَا فَأْتُو<s>ا۟</> بِسُورَ<d>ةٍۢ مِّن مِّ</>ثْلِ<m>هِۦ</> وَ<h>ٱ</><q>دْ</>عُو<s>ا۟</> شُهَ<o>دَآ</>ءَ<y>كُم مِّ</><k>ن دُ</>ونِ <h>ٱ</>للَّهِ إِ<k>ن كُنتُ</>مْ <m>صَٰ</>دِ<p>قِي</>نَ"},{"n":24,"w":[["فَإِن","fa-in","But if","কিন্তু যদি"],["لَّمْ","lam","not","না"],["تَفْعَلُوا۟","taf‘alū","you do","তোমরা করো"],["وَلَن","walan","and never","এবং কখনও না"],["تَفْعَلُوا۟","taf‘alū","will you do","তোমরা করতে পারবে"],["فَٱتَّقُوا۟","fa-ittaqū","then fear","তোমরা ভয় করো"],["ٱلنَّارَ","l-nāra","the Fire","আগুনের"],["ٱلَّتِى","allatī","whose","যা (এমন যে)"],["وَقُودُهَا","waqūduhā","[its] fuel","তার ইন্ধন (হবে)"],["ٱلنَّاسُ","l-nāsu","(is) [the] men","মানুষ"],["وَٱلْحِجَارَةُ ۖ","wal-ḥijāratu","and [the] stones","ও পাথরসমূহ"],["أُعِدَّتْ","u‘iddat","prepared","যা প্রস্তুুত করা হয়েছে"],["لِلْكَـٰفِرِينَ","lil'kāfirīna","for the disbelievers","কাফিরদের জন্য"]],"t":"فَ<w>إِن لَّ</>مْ تَفْعَلُو<s>ا۟</> وَلَ<k>ن تَ</>فْعَلُو<s>ا۟</> فَ<h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</><l>ل</><g>نَّ</>ارَ <h>ٱ</>لَّتِى وَقُودُهَا <h>ٱ</><l>ل</><g>نَّ</>اسُ وَ<h>ٱ</>لْحِجَارَةُ ۖ أُعِدَّتْ لِلْ<m>كَٰ</>فِ<p>رِي</>نَ"},{"n":25,"w":[["وَبَشِّرِ","wabashiri","And give good news","এবং সুসংবাদ দাও"],["ٱلَّذِينَ","alladhīna","(to) those who","(তাদেরকে) যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["وَعَمِلُوا۟","wa‘amilū","and do","ও কাজ করেছে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","[the] righteous deeds","সৎ"],["أَنَّ","anna","that","যে"],["لَهُمْ","lahum","for them","তাদের জন্যে (রয়েছে)"],["جَنَّـٰتٍۢ","jannātin","(will be) Gardens","জান্নাত"],["تَجْرِى","tajrī","flow","প্রবাহিত হয়"],["مِن","min","[from]","দিয়ে"],["تَحْتِهَا","taḥtihā","under them","তার নিচ"],["ٱلْأَنْهَـٰرُ ۖ","l-anhāru","the rivers","ঝর্ণাধারা"],["كُلَّمَا","kullamā","Every time","যখনই"],["رُزِقُوا۟","ruziqū","they are provided","তাদের রিযক দেয়া হবে"],["مِنْهَا","min'hā","therefrom","তা থেকে"],["مِن","min","of","কোনো"],["ثَمَرَةٍۢ","thamaratin","fruit","ফলমূল"],["رِّزْقًۭا ۙ","riz'qan","(as) provision","রিযক হিসেবে"],["قَالُوا۟","qālū","they (will) say","তারা বলবে"],["هَـٰذَا","hādhā","This (is)","''এটা"],["ٱلَّذِى","alladhī","the one which","(তাই) যা"],["رُزِقْنَا","ruziq'nā","we were provided","আমাদের রিযক দেওয়া হয়েছিল"],["مِن","min","from","থেকে"],["قَبْلُ ۖ","qablu","before","পূর্ব''"],["وَأُتُوا۟","wa-utū","And they will be given","এবং তাদেরকে যা দেওয়া হয়েছিল"],["بِهِۦ","bihi","therefrom","(তা থেকে)"],["مُتَشَـٰبِهًۭا ۖ","mutashābihan","(things) in resemblance","সদৃশ হবে (পরস্পরে)"],["وَلَهُمْ","walahum","And for them","এবং তাদের জন্যে"],["فِيهَآ","fīhā","therein","তারমধ্যে (থাকবে)"],["أَزْوَٰجٌۭ","azwājun","spouses","স্ত্রীরা"],["مُّطَهَّرَةٌۭ ۖ","muṭahharatun","purified","পবিত্র"],["وَهُمْ","wahum","and they","এবং তারা"],["فِيهَا","fīhā","therein","তার মধ্যে"],["خَـٰلِدُونَ","khālidūna","(will) abide forever","চিরস্থায়ী হবে"]],"t":"وَبَشِّرِ <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ أَ<g>نَّ</> لَهُمْ جَ<g>نَّٰ</><k>تٍۢ تَ</><q>جْ</>رِى مِ<k>ن تَ</>حْتِهَا <h>ٱ</>لْأَنْ<m>هَٰ</>رُ ۖ كُلَّمَا رُزِقُو<s>ا۟</> مِنْهَا مِ<k>ن ثَ</>مَرَ<w>ةٍۢ رِّ</>زْ<k>قًۭا ۙ قَ</>الُو<s>ا۟</> <m>هَٰ</>ذَا <h>ٱ</>لَّذِى رُزِ<q>قْ</>نَا مِ<k>ن قَ</><q>بْ</>لُ ۖ وَأُتُو<s>ا۟</> بِ<m>هِۦ</> مُتَ<m>شَٰ</>بِ<d>هًۭا ۖ وَ</>لَهُمْ فِي<o>هَآ</> أَزْ<m>وَٰ</><d>جٌۭ مُّ</>طَهَّرَ<d>ةٌۭ ۖ وَ</>هُمْ فِيهَا <m>خَٰ</>لِ<p>دُو</>نَ"},{"n":26,"w":[["۞ إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَا","lā","(is) not","না"],["يَسْتَحْىِۦٓ","yastaḥyī","ashamed","লজ্জাবোধ করেন"],["أَن","an","to","যে"],["يَضْرِبَ","yaḍriba","set forth","তিনি পেশ করবেন"],["مَثَلًۭا","mathalan","an example","দৃষ্টান্ত"],["مَّا","mā","(like) even","যা"],["بَعُوضَةًۭ","ba‘ūḍatan","(of) a mosquito","মশা"],["فَمَا","famā","and (even) something","কিংবা যা"],["فَوْقَهَا ۚ","fawqahā","above it","তারচেয়ে ক্ষুদ্রতর"],["فَأَمَّا","fa-ammā","Then as for","তাই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ءَامَنُوا۟","āmanū","believed","ঈমান এনেছে"],["فَيَعْلَمُونَ","faya‘lamūna","[thus] they will know","জানতে পারে তখন"],["أَنَّهُ","annahu","that it","তা নিশ্চয়ই"],["ٱلْحَقُّ","l-ḥaqu","(is) the truth","সত্য"],["مِن","min","from","পক্ষ থেকে"],["رَّبِّهِمْ ۖ","rabbihim","their Lord","তাদের রবের"],["وَأَمَّا","wa-ammā","And as for","পক্ষান্তরে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieved","অবিশ্বাস করেছে"],["فَيَقُولُونَ","fayaqūlūna","[thus] they will say","তারা বলে তখন"],["مَاذَآ","mādhā","what","কি"],["أَرَادَ","arāda","(did) intend","চেয়েছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["بِهَـٰذَا","bihādhā","by this","এই দিয়ে"],["مَثَلًۭا ۘ","mathalan","example","উপমা"],["يُضِلُّ","yuḍillu","He lets go astray","তিনি বিভ্রান্ত করেন"],["بِهِۦ","bihi","by it","তা দিয়ে"],["كَثِيرًۭا","kathīran","many","অনেককে"],["وَيَهْدِى","wayahdī","and He guides","এবং পথ প্রদর্শন করেন"],["بِهِۦ","bihi","by it","তা দিয়ে"],["كَثِيرًۭا ۚ","kathīran","many","অনেককে,"],["وَمَا","wamā","And not","এবং না"],["يُضِلُّ","yuḍillu","He lets go astray","বিভ্রান্ত করেন"],["بِهِۦٓ","bihi","by it","এ দিয়ে"],["إِلَّا","illā","except","ছাড়া"],["ٱلْفَـٰسِقِينَ","l-fāsiqīna","the defiantly disobedient","স্বত্বত্যাগীদেরকে"]],"t":"۞ إِ<g>نَّ</> <h>ٱ</>للَّهَ لَا يَسْتَحْ<o>ىِۦٓ</> <d>أَن يَ</>ضْرِبَ مَثَلًۭ<d>ا مَّ</>ا بَعُوضَ<k>ةًۭ فَ</>مَا فَوْقَهَا ۚ فَأَ<g>مَّ</>ا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> فَيَعْلَمُونَ أَ<g>نَّ</>هُ <h>ٱ</>لْحَقُّ <w>مِن رَّ</>بِّهِمْ ۖ وَأَ<g>مَّ</>ا <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> فَيَقُولُونَ مَا<o>ذَآ</> أَرَادَ <h>ٱ</>للَّهُ بِ<m>هَٰ</>ذَا مَثَلًۭ<d>ا ۘ يُ</>ضِلُّ بِ<m>هِۦ</> كَثِي<d>رًۭا وَ</>يَهْدِى بِ<m>هِۦ</> كَثِي<d>رًۭا ۚ وَ</>مَا يُضِلُّ بِ<o>هِۦٓ</> إِلَّا <h>ٱ</>لْ<m>فَٰ</>سِ<p>قِي</>نَ"},{"n":27,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["يَنقُضُونَ","yanquḍūna","break","ভঙ্গকরে"],["عَهْدَ","‘ahda","(the) Covenant","প্রতিশ্রুতি"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["مِنۢ","min","from","থেকে"],["بَعْدِ","ba‘di","after","পরে"],["مِيثَـٰقِهِۦ","mīthāqihi","its ratification","তা আবদ্ধ হওয়ার,"],["وَيَقْطَعُونَ","wayaqṭa‘ūna","and [they] cut","এবং তারা ছিন্নকরে"],["مَآ","mā","what","যা"],["أَمَرَ","amara","has ordered","নির্দেশ দিয়েছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["بِهِۦٓ","bihi","it","তাঁর সম্পর্কে"],["أَن","an","to","যে"],["يُوصَلَ","yūṣala","be joined","যুক্ত করতে"],["وَيُفْسِدُونَ","wayuf'sidūna","and [they] spread corruption","এবং তারা বিপর্যয় সৃষ্টি করে"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ ۚ","l-arḍi","the earth","পৃথিবীর"],["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব (লোক),"],["هُمُ","humu","they","(তারাই)"],["ٱلْخَـٰسِرُونَ","l-khāsirūna","(are) the losers","ক্ষতিগ্রস্ত"]],"t":"ٱلَّذِينَ يَ<k>نقُ</>ضُونَ عَهْدَ <h>ٱ</>للَّهِ <i>مِنۢ بَ</>عْدِ مِي<m>ثَٰقِهِۦ</> وَيَ<q>قْ</>طَعُونَ <o>مَآ</> أَمَرَ <h>ٱ</>للَّهُ بِ<o>هِۦٓ</> <d>أَن يُ</>وصَلَ وَيُفْسِدُونَ فِى <h>ٱ</>لْأَرْضِ ۚ أُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</>لْ<m>خَٰ</>سِ<p>رُو</>نَ"},{"n":28,"w":[["كَيْفَ","kayfa","How","কিরূপে"],["تَكْفُرُونَ","takfurūna","(can) you disbelieve","তোমরা অবিশ্বাস করবে"],["بِٱللَّهِ","bil-lahi","in Allah","আল্লাহর উপর"],["وَكُنتُمْ","wakuntum","While you were","অথচ তোমরা ছিলে"],["أَمْوَٰتًۭا","amwātan","dead","মৃত অবস্থায়"],["فَأَحْيَـٰكُمْ ۖ","fa-aḥyākum","then He gave you life","পরে তিনি তোমাদের জীবিত করেছেন"],["ثُمَّ","thumma","then","এরপর"],["يُمِيتُكُمْ","yumītukum","He will cause you to die","তোমাদের মৃত্যু দেবেন"],["ثُمَّ","thumma","then","এরপর"],["يُحْيِيكُمْ","yuḥ'yīkum","He will give you life","তোমাদের জীবিত করবেন"],["ثُمَّ","thumma","then","এরপরে"],["إِلَيْهِ","ilayhi","to Him","তাঁর দিকেই"],["تُرْجَعُونَ","tur'ja‘ūna","you will be returned","ফিরে যেতে হবে তোমাদেরকে"]],"t":"كَيْفَ تَكْفُرُونَ بِ<h>ٱ</>للَّهِ وَكُ<k>نتُ</>مْ أَمْ<m>وَٰ</><k>تًۭا فَ</>أَحْ<m>يَٰ</>كُمْ ۖ ثُ<g>مَّ</> يُمِيتُكُمْ ثُ<g>مَّ</> يُحْيِيكُمْ ثُ<g>مَّ</> إِلَيْهِ تُرْجَ<p>عُو</>نَ"},{"n":29,"w":[["هُوَ","huwa","He","তিনিই (আল্লাহ)"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["خَلَقَ","khalaqa","created","সৃষ্টি করেছেন"],["لَكُم","lakum","for you","তোমাদের জন্যে"],["مَّا","mā","what","যা কিছু"],["فِى","fī","(is) in","মধ্যে (আছে)"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর,"],["جَمِيعًۭا","jamī‘an","all","সবকিছুকেই"],["ثُمَّ","thumma","Moreover","এরপর"],["ٱسْتَوَىٰٓ","is'tawā","He turned","লক্ষ্য দিলেন"],["إِلَى","ilā","to","দিকে"],["ٱلسَّمَآءِ","l-samāi","the heaven","আকাশের"],["فَسَوَّىٰهُنَّ","fasawwāhunna","and fashioned them","অতঃপর তাদেরকে সম্পূর্ণ করলেন"],["سَبْعَ","sab‘a","seven","সাত"],["سَمَـٰوَٰتٍۢ ۚ","samāwātin","heavens","আকাশ"],["وَهُوَ","wahuwa","And He","এবং তিনি"],["بِكُلِّ","bikulli","of every","সব"],["شَىْءٍ","shayin","thing","জিনিস সম্পর্কে"],["عَلِيمٌۭ","‘alīmun","(is) All-Knowing","মহাজ্ঞানী"]],"t":"هُوَ <h>ٱ</>لَّذِى خَلَقَ لَ<y>كُم مَّ</>ا فِى <h>ٱ</>لْأَرْضِ جَمِي<k>عًۭا ثُ</><g>مَّ</> <h>ٱ</>سْتَوَ<o>ىٰٓ</> إِلَى <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ فَسَوَّ<m>ىٰ</>هُ<g>نَّ</> سَ<q>بْ</>عَ سَ<m>مَٰوَٰ</><d>تٍۢ ۚ وَ</>هُوَ بِكُلِّ شَىْءٍ عَ<p>لِي</>مٌۭ"},{"n":30,"w":[["وَإِذْ","wa-idh","And when","এবং (স্মরণ করো) যখন"],["قَالَ","qāla","said","বলেছিলেন"],["رَبُّكَ","rabbuka","your Lord","তোমার রব"],["لِلْمَلَـٰٓئِكَةِ","lil'malāikati","to the angels","ফেরেশতাদের উদ্দেশে"],["إِنِّى","innī","Indeed, I (am)","''নিশ্চয়ই আমি"],["جَاعِلٌۭ","jā‘ilun","going to place","সৃষ্টিকারী"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীতর"],["خَلِيفَةًۭ ۖ","khalīfatan","a vicegerent","প্রতিনিধি"],["قَالُوٓا۟","qālū","they said","তারা বলেছিলো"],["أَتَجْعَلُ","ataj‘alu","Will You place","''আপনি কি সৃষ্টি করবেন"],["فِيهَا","fīhā","in it","তার মধ্যে (পৃথিবীতে)"],["مَن","man","(one) who","যে"],["يُفْسِدُ","yuf'sidu","will spread corruption","বিপর্যয় সৃষ্টি করবে"],["فِيهَا","fīhā","in it","তার মধ্যে"],["وَيَسْفِكُ","wayasfiku","and will shed","ও ঝরাবে"],["ٱلدِّمَآءَ","l-dimāa","[the] blood[s]","রক্ত"],["وَنَحْنُ","wanaḥnu","while we","এবং আমরাইতো"],["نُسَبِّحُ","nusabbiḥu","[we] glorify (You)","পবিত্র মহিমা ঘোষণা করি"],["بِحَمْدِكَ","biḥamdika","with Your praises","আপনার প্রশংসা"],["وَنُقَدِّسُ","wanuqaddisu","and we sanctify","ও মহিমা ঘোষণা করি"],["لَكَ ۖ","laka","[to] You","আপনার"],["قَالَ","qāla","He said","তিনি বলেছিলেন"],["إِنِّىٓ","innī","Indeed, I","''নিশ্চয়ই আমি"],["أَعْلَمُ","a‘lamu","[I] know","জানি"],["مَا","mā","what","যা"],["لَا","lā","not","না"],["تَعْلَمُونَ","ta‘lamūna","you know","তোমরা জান''"]],"t":"وَإِذْ قَالَ رَبُّكَ لِلْمَ<o>لَٰٓ</>ئِكَةِ إِ<g>نِّ</>ى جَاعِ<k>لٌۭ فِ</>ى <h>ٱ</>لْأَرْضِ خَلِيفَ<k>ةًۭ ۖ قَ</>ا<o>لُوٓ</><s>ا۟</> أَتَ<q>جْ</>عَلُ فِيهَا <d>مَن يُ</>فْسِدُ فِيهَا وَيَسْفِكُ <h>ٱ</><l>ل</>دِّ<o>مَآ</>ءَ وَنَحْنُ نُسَبِّحُ بِحَمْدِكَ وَنُقَدِّسُ لَكَ ۖ قَالَ إِ<g>نِّ</><o>ىٓ</> أَعْلَمُ مَا لَا تَعْلَ<p>مُو</>نَ"},{"n":31,"w":[["وَعَلَّمَ","wa‘allama","And He taught","এবং শিখালেন"],["ءَادَمَ","ādama","Adam","আদমকে"],["ٱلْأَسْمَآءَ","l-asmāa","the names ","নামসমূহ"],["كُلَّهَا","kullahā","all of them","সবকিছুর"],["ثُمَّ","thumma","Then","এরপর"],["عَرَضَهُمْ","‘araḍahum","He displayed them","সেগুলো উপস্থাপন করলেন"],["عَلَى","‘alā","to","সামনে"],["ٱلْمَلَـٰٓئِكَةِ","l-malāikati","the angels","ফেরেশতাদের"],["فَقَالَ","faqāla","then He said","এরপর বললেন"],["أَنۢبِـُٔونِى","anbiūnī","Inform Me","''আমাকে অবহিত করো"],["بِأَسْمَآءِ","bi-asmāi","of (the) names","নাম সম্পর্কে"],["هَـٰٓؤُلَآءِ","hāulāi","(of) these","এসবের"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you are","তোমরা হও"],["صَـٰدِقِينَ","ṣādiqīna","truthful","সত্যবাদী''"]],"t":"وَعَلَّمَ ءَادَمَ <h>ٱ</>لْأَسْ<o>مَآ</>ءَ كُلَّهَا ثُ<g>مَّ</> عَرَضَهُمْ عَلَى <h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةِ فَقَالَ أَ<i>نۢبِـُٔ</>ونِى بِأَسْ<o>مَآ</>ءِ <o>هَٰٓؤُلَآ</>ءِ إِ<k>ن كُنتُ</>مْ <m>صَٰ</>دِ<p>قِي</>نَ"},{"n":32,"w":[["قَالُوا۟","qālū","They said","তারা বলেছিল"],["سُبْحَـٰنَكَ","sub'ḥānaka","Glory be to You","''আপনি পবিত্র"],["لَا","lā","No","না (আছে)"],["عِلْمَ","‘il'ma","knowledge","জ্ঞান"],["لَنَآ","lanā","(is) for us","আমাদের"],["إِلَّا","illā","except","এছাড়া"],["مَا","mā","what","যা"],["عَلَّمْتَنَآ ۖ","‘allamtanā","You have taught us","আমাদের আপনি শিখিয়েছেন"],["إِنَّكَ","innaka","Indeed You","নিশ্চয়ই আপনি"],["أَنتَ","anta","You","আপনিই"],["ٱلْعَلِيمُ","l-‘alīmu","(are) the All-Knowing","মহাজ্ঞানী"],["ٱلْحَكِيمُ","l-ḥakīmu","the All-Wise","মহাবিজ্ঞ"]],"t":"قَالُو<s>ا۟</> سُ<q>بْ</><m>حَٰ</>نَكَ لَا عِلْمَ لَ<o>نَآ</> إِلَّا مَا عَلَّمْتَ<o>نَآ ۖ</> إِ<g>نَّ</>كَ أَ<k>نتَ</> <h>ٱ</>لْعَلِيمُ <h>ٱ</>لْحَ<p>كِي</>مُ"},{"n":33,"w":[["قَالَ","qāla","He said","তিনি বললেন"],["يَـٰٓـَٔادَمُ","yāādamu","O Adam","''হে আদম"],["أَنۢبِئْهُم","anbi'hum","Inform them","তাদেরকে অবহিত করো"],["بِأَسْمَآئِهِمْ ۖ","bi-asmāihim","of their names","তাদের নামগুলো সম্পর্কে''"],["فَلَمَّآ","falammā","And when","অতঃপর যখন"],["أَنۢبَأَهُم","anba-ahum","he had informed them","সে তাদেরকে অবহিত করল"],["بِأَسْمَآئِهِمْ","bi-asmāihim","of their names","তাদের নামগুলো"],["قَالَ","qāla","He said","তিনি বললেন"],["أَلَمْ","alam","Did not","''আমি কি"],["أَقُل","aqul","I say","বলি নি"],["لَّكُمْ","lakum","to you","তোমাদেরকে"],["إِنِّىٓ","innī","Indeed, I","নিশ্চয়ই"],["أَعْلَمُ","a‘lamu","[I] know","আমি জানি"],["غَيْبَ","ghayba","(the) unseen","অদৃশ্যকে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশ সমূহের"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পাৃথিবীর"],["وَأَعْلَمُ","wa-a‘lamu","and I know","এবং আমি জানি"],["مَا","mā","what","যা"],["تُبْدُونَ","tub'dūna","you reveal","তোমরা প্রকাশ কর"],["وَمَا","wamā","and what","ও যা"],["كُنتُمْ","kuntum","you [were]","তোমরা"],["تَكْتُمُونَ","taktumūna","conceal","গোপন করো''"]],"t":"قَالَ <o>يَٰٓـَٔ</>ادَمُ أَ<i>نۢبِ</>ئْ<f>هُم بِ</>أَسْ<o>مَآ</>ئِهِمْ ۖ فَلَ<g>مَّ</><o>آ</> أَ<i>نۢبَ</>أَ<f>هُم بِ</>أَسْ<o>مَآ</>ئِهِمْ قَالَ أَلَمْ أَقُل لَّكُمْ إِ<g>نِّ</><o>ىٓ</> أَعْلَمُ غَيْبَ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ وَأَعْلَمُ مَا تُ<q>بْ</>دُونَ وَمَا كُ<k>نتُ</>مْ تَكْتُ<p>مُو</>نَ"},{"n":34,"w":[["وَإِذْ","wa-idh","And when","এবং যখন"],["قُلْنَا","qul'nā","We said","আমরা বলেছিলাম"],["لِلْمَلَـٰٓئِكَةِ","lil'malāikati","to the angels","ফেরেশতাদেরকে"],["ٱسْجُدُوا۟","us'judū","Prostrate","''তোমরা সিজদা করো"],["لِـَٔادَمَ","liādama","to Adam","আদমকে''"],["فَسَجَدُوٓا۟","fasajadū","[so] they prostrated","তখন তারা সিজদা করল"],["إِلَّآ","illā","except","ব্যতীত"],["إِبْلِيسَ","ib'līsa","Iblis","ইবলিস"],["أَبَىٰ","abā","He refused","সে অমান্য করল"],["وَٱسْتَكْبَرَ","wa-is'takbara","and was arrogant","ও অহংকার করল,"],["وَكَانَ","wakāna","and became","এবং সে হল"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","the disbelievers","কাফিরদের"]],"t":"وَإِذْ قُلْنَا لِلْمَ<o>لَٰٓ</>ئِكَةِ <h>ٱ</>سْجُدُو<s>ا۟</> لِءَادَمَ فَسَجَ<o>دُوٓ</><s>ا۟</> إِ<o>لَّآ</> إِ<q>بْ</>لِيسَ أَبَىٰ وَ<h>ٱ</>سْتَكْبَرَ وَكَانَ مِنَ <h>ٱ</>لْ<m>كَٰ</>فِ<p>رِي</>نَ"},{"n":35,"w":[["وَقُلْنَا","waqul'nā","And We said","এবং আমরা বললাম,"],["يَـٰٓـَٔادَمُ","yāādamu","O Adam","''হে আদম"],["ٱسْكُنْ","us'kun","Dwell","বসবাস করো"],["أَنتَ","anta","you","তুমি"],["وَزَوْجُكَ","wazawjuka","and your spouse","ও তোমার স্ত্রী"],["ٱلْجَنَّةَ","l-janata","(in) Paradise","জান্নাতে"],["وَكُلَا","wakulā","and [you both] eat","এবং দুজনে খাও"],["مِنْهَا","min'hā","from it","তা হতে"],["رَغَدًا","raghadan","freely","স্বাচ্ছন্দে"],["حَيْثُ","ḥaythu","(from) wherever","যেখান থেকে"],["شِئْتُمَا","shi'tumā","you [both] wish","তোমরা দুজনে চাও;"],["وَلَا","walā","But do not","এবং না"],["تَقْرَبَا","taqrabā","[you two] approach","দুজনে নিকটে যেয়ো"],["هَـٰذِهِ","hādhihi","this","এই"],["ٱلشَّجَرَةَ","l-shajarata","[the] tree","গাছের"],["فَتَكُونَا","fatakūnā","lest you [both] be","অতঃপর তোমরা দুজনে হবে"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","সীমালঙ্ঘনকারীদের''"]],"t":"وَقُلْنَا <o>يَٰٓـَٔ</>ادَمُ <h>ٱ</>سْكُنْ أَ<k>نتَ</> وَزَوْجُكَ <h>ٱ</>لْجَ<g>نَّ</>ةَ وَكُلَا مِنْهَا رَغَدًا حَيْثُ شِئْتُمَا وَلَا تَ<q>قْ</>رَبَا <m>هَٰ</>ذِهِ <h>ٱ</><l>ل</>شَّجَرَةَ فَتَكُونَا مِنَ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":36,"w":[["فَأَزَلَّهُمَا","fa-azallahumā","Then made [both of] them slip","তাদেরকে এরপর পদস্থলন ঘটাল"],["ٱلشَّيْطَـٰنُ","l-shayṭānu","the Shaitaan","শয়তান"],["عَنْهَا","‘anhā","from it","তা হতে,"],["فَأَخْرَجَهُمَا","fa-akhrajahumā","and he got [both of] them out","তাদের দুজনকে অতঃপর বের করল"],["مِمَّا","mimmā","from what","সেখান থেকে"],["كَانَا","kānā","they [both] were","দুজনে ছিল"],["فِيهِ ۖ","fīhi","in [it]","যার মধ্যে"],["وَقُلْنَا","waqul'nā","And We said","এবং আমরা বললাম,"],["ٱهْبِطُوا۟","ih'biṭū","Go down (all of you)","''তোমরা নেমে যাও (এখান থেকে)"],["بَعْضُكُمْ","ba‘ḍukum","some of you","তোমাদের একে"],["لِبَعْضٍ","liba‘ḍin","to others","অপরের জন্যে"],["عَدُوٌّۭ ۖ","‘aduwwun","(as) enemy","শত্রু"],["وَلَكُمْ","walakum","and for you","এবং তোমাদের জন্যে"],["فِى","fī","in","মধ্যে (থাকবে)"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["مُسْتَقَرٌّۭ","mus'taqarrun","(is) a dwelling place","অবস্থান (কিছু কালের)"],["وَمَتَـٰعٌ","wamatā‘un","and a provision","ও জীবন সামগ্রী"],["إِلَىٰ","ilā","for","পর্যন্ত"],["حِينٍۢ","ḥīnin","a period","একটা নির্দিষ্ট সময়''"]],"t":"فَأَزَلَّهُمَا <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نُ عَنْهَا فَأَخْرَجَهُمَا مِ<g>مَّ</>ا كَانَا فِيهِ ۖ وَقُلْنَا <h>ٱ</>هْبِطُو<s>ا۟</> بَعْضُكُمْ لِبَعْضٍ عَدُ<d>وٌّۭ ۖ وَ</>لَكُمْ فِى <h>ٱ</>لْأَرْضِ مُسْتَقَ<d>رٌّۭ وَ</>مَ<m>تَٰ</>عٌ إِلَىٰ <p>حِي</>نٍۢ"},{"n":37,"w":[["فَتَلَقَّىٰٓ","fatalaqqā","Then received","তখন শিখে নিল"],["ءَادَمُ","ādamu","Adam","আদম"],["مِن","min","from","নিকট হতে"],["رَّبِّهِۦ","rabbihi","his Lord","তার রবের"],["كَلِمَـٰتٍۢ","kalimātin","words","কিছু বাণী (ও ক্ষমা চাইল)"],["فَتَابَ","fatāba","So (his Lord) turned","ফলে তিনি ক্ষমা করলেন"],["عَلَيْهِ ۚ","‘alayhi","towards him","তাকে"],["إِنَّهُۥ","innahu","Indeed He","নিশ্চয়ই তিনি"],["هُوَ","huwa","He","তিনিই"],["ٱلتَّوَّابُ","l-tawābu","(is) the Oft-returning (to mercy)","বড় ক্ষমাশীল"],["ٱلرَّحِيمُ","l-raḥīmu","the Most Merciful","পরম দয়ালু"]],"t":"فَتَلَقَّ<o>ىٰٓ</> ءَادَمُ <w>مِن رَّ</>بِّ<m>هِۦ</> كَلِ<m>مَٰ</><k>تٍۢ فَ</>تَابَ عَلَيْهِ ۚ إِ<g>نَّ</>هُ<m>ۥ</> هُوَ <h>ٱ</><l>ل</>تَّوَّابُ <h>ٱ</><l>ل</>رَّ<p>حِي</>مُ"},{"n":38,"w":[["قُلْنَا","qul'nā","We said","আমরা বললাম,"],["ٱهْبِطُوا۟","ih'biṭū","Go down","''তোমরা নামো"],["مِنْهَا","min'hā","from it","এখান থেকে"],["جَمِيعًۭا ۖ","jamī‘an","all (of you)","সবাই"],["فَإِمَّا","fa-immā","and when","অতঃপর যখন"],["يَأْتِيَنَّكُم","yatiyannakum","comes to you","তোমাদের কাছে আসবে অবশ্যই"],["مِّنِّى","minnī","from Me","আমার পক্ষ হতে"],["هُدًۭى","hudan","Guidance","পথনির্দেশনা"],["فَمَن","faman","then whoever","তখন যে"],["تَبِعَ","tabi‘a","follows","অনুসরণ করবে"],["هُدَاىَ","hudāya","My Guidance","আমার পথনির্দেশনা"],["فَلَا","falā","[then] no","অতঃপর নেই"],["خَوْفٌ","khawfun","fear","কোনো ভয়"],["عَلَيْهِمْ","‘alayhim","(will be) on them","তাদের জন্যে"],["وَلَا","walā","and not","এবং না"],["هُمْ","hum","they","তারা"],["يَحْزَنُونَ","yaḥzanūna","will grieve","দুঃখিত হবে"]],"t":"قُلْنَا <h>ٱ</>هْبِطُو<s>ا۟</> مِنْهَا جَمِي<k>عًۭا ۖ فَ</>إِ<g>مَّ</>ا يَأْتِيَ<g>نَّ</><y>كُم مِّ</><g>نِّ</>ى هُ<k>دًۭى فَمَن تَ</>بِعَ هُدَاىَ فَلَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَ<p>نُو</>نَ"},{"n":39,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those","এবং যারা"],["كَفَرُوا۟","kafarū","who disbelieve[d]","অবিশ্বাস করবে"],["وَكَذَّبُوا۟","wakadhabū","and deny","ও মিথ্যা মনে করবে"],["بِـَٔايَـٰتِنَآ","biāyātinā","Our Signs","আমার নিদর্শনসমূহকে"],["أُو۟لَـٰٓئِكَ","ulāika","those","তারা"],["أَصْحَـٰبُ","aṣḥābu","(are the) companions","অধিবাসী (হবে)"],["ٱلنَّارِ ۖ","l-nāri","(of) the Fire","(জাহান্নামের) আগুনের"],["هُمْ","hum","they","তারা"],["فِيهَا","fīhā","in it","তার মধ্যে"],["خَـٰلِدُونَ","khālidūna","(will) abide forever","চিরস্থায়ী হবে''"]],"t":"وَ<h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> وَكَذَّبُو<s>ا۟</> بِـَٔا<m>يَٰ</>تِ<o>نَآ</> أُ<s>و۟</><o>لَٰٓ</>ئِكَ أَصْ<m>حَٰ</>بُ <h>ٱ</><l>ل</><g>نَّ</>ارِ ۖ هُمْ فِيهَا <m>خَٰ</>لِ<p>دُو</>نَ"},{"n":40,"w":[["يَـٰبَنِىٓ","yābanī","O Children","হে সন্তান"],["إِسْرَٰٓءِيلَ","is'rāīla","(of) Israel","ইসরাঈলের"],["ٱذْكُرُوا۟","udh'kurū","Remember","তোমরা স্মরণ করো"],["نِعْمَتِىَ","ni‘'matiya","My Favor","আমার নেয়ামতের"],["ٱلَّتِىٓ","allatī","which","যা"],["أَنْعَمْتُ","an‘amtu","I bestowed","আমি নেয়ামত দিয়েছি"],["عَلَيْكُمْ","‘alaykum","upon you","তোমাদের উপর"],["وَأَوْفُوا۟","wa-awfū","and fulfill","এবং তোমরা পূর্ণ করো"],["بِعَهْدِىٓ","bi‘ahdī","My Covenant","আমার (কাছে কৃত) প্রতিশ্রুতি"],["أُوفِ","ūfi","I will fulfill","আমি পূর্ণ কর"],["بِعَهْدِكُمْ","bi‘ahdikum","your covenant","তোমাদের (কাছে কৃত) প্রতিশ্রুতি;"],["وَإِيَّـٰىَ","wa-iyyāya","and Me Alone","এবং শুধু আমাকেই"],["فَٱرْهَبُونِ","fa-ir'habūni","fear [Me]","তোমরা ভয় করো"]],"t":"<m>يَٰ</>بَ<o>نِىٓ</> إِسْ<o>رَٰٓ</>ءِيلَ <h>ٱ</>ذْكُرُو<s>ا۟</> نِعْمَتِىَ <h>ٱ</>لَّ<o>تِىٓ</> أَنْعَمْتُ عَلَيْكُمْ وَأَوْفُو<s>ا۟</> بِعَهْ<o>دِىٓ</> أُوفِ بِعَهْدِكُمْ وَإِ<m>يَّٰ</>ىَ فَ<h>ٱ</>رْهَ<p>بُو</>نِ"},{"n":41,"w":[["وَءَامِنُوا۟","waāminū","And believe","এবং তোমরা ঈমান আনো"],["بِمَآ","bimā","in what","ঐ বিষয়ে যা"],["أَنزَلْتُ","anzaltu","I have sent down","আমি অবতীর্ণ করেছি"],["مُصَدِّقًۭا","muṣaddiqan","confirming","সমর্থনকারী"],["لِّمَا","limā","that which","তার যা"],["مَعَكُمْ","ma‘akum","(is) with you","তোমাদের সাথে আছে"],["وَلَا","walā","and (do) not","এবং না"],["تَكُونُوٓا۟","takūnū","be","তোমরা হয়ো"],["أَوَّلَ","awwala","(the) first","প্রথম"],["كَافِرٍۭ","kāfirin","disbeliever","অস্বীকারকারী"],["بِهِۦ ۖ","bihi","of it","তার প্রতি"],["وَلَا","walā","And (do) not","এবং না"],["تَشْتَرُوا۟","tashtarū","exchange","তোমরা বিক্রয় করো"],["بِـَٔايَـٰتِى","biāyātī","My Signs (for)","আমার আয়াতের বিনিময়ে"],["ثَمَنًۭا","thamanan","a price","মূল্যে"],["قَلِيلًۭا","qalīlan","small","সামান্য"],["وَإِيَّـٰىَ","wa-iyyāya","and Me Alone","এবং শুধু আমাকেই"],["فَٱتَّقُونِ","fa-ittaqūni","fear [Me]","অতএব তোমরা ভয় করো"]],"t":"وَءَامِنُو<s>ا۟</> بِ<o>مَآ</> أَ<k>نزَ</>لْتُ مُصَدِّ<w>قًۭا لِّ</>مَا مَعَكُمْ وَلَا تَكُو<o>نُوٓ</><s>ا۟</> أَوَّلَ كَافِ<i>رٍۭ بِ</><m>هِۦ</> ۖ وَلَا تَشْتَرُو<s>ا۟</> بِـَٔا<m>يَٰ</>تِى ثَمَ<k>نًۭا قَ</>لِيلًۭ<d>ا وَ</>إِ<m>يَّٰ</>ىَ فَ<h>ٱ</>تَّ<p>قُو</>نِ"},{"n":42,"w":[["وَلَا","walā","And (do) not","এবং না"],["تَلْبِسُوا۟","talbisū","mix","তোমরা মিশ্রণ করো"],["ٱلْحَقَّ","l-ḥaqa","the Truth","সত্যকে"],["بِٱلْبَـٰطِلِ","bil-bāṭili","with [the] falsehood","অসত্যের সাথে"],["وَتَكْتُمُوا۟","wataktumū","and conceal","এবং তোমরা লুকাবে (না)"],["ٱلْحَقَّ","l-ḥaqa","the Truth","সত্যকে"],["وَأَنتُمْ","wa-antum","while you","এমতাবস্থায় যে তোমরা"],["تَعْلَمُونَ","ta‘lamūna","[you] know","জান"]],"t":"وَلَا تَلْبِسُو<s>ا۟</> <h>ٱ</>لْحَقَّ بِ<h>ٱ</>لْ<m>بَٰ</>طِلِ وَتَكْتُمُو<s>ا۟</> <h>ٱ</>لْحَقَّ وَأَ<k>نتُ</>مْ تَعْلَ<p>مُو</>نَ"},{"n":43,"w":[["وَأَقِيمُوا۟","wa-aqīmū","And establish","এবং তোমরা প্রতিষ্ঠা করো"],["ٱلصَّلَوٰةَ","l-ṣalata","the prayer","সালাত"],["وَءَاتُوا۟","waātū","and give","ও তোমরা দাও"],["ٱلزَّكَوٰةَ","l-zakata","zakah","যাকাত"],["وَٱرْكَعُوا۟","wa-ir'ka‘ū","and bow down","এবং তোমরা রুকু করো"],["مَعَ","ma‘a","with","সাথে"],["ٱلرَّٰكِعِينَ","l-rāki‘īna","those who bow down","রুকুকারীদের"]],"t":"وَأَقِيمُو<s>ا۟</> <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةَ وَءَاتُو<s>ا۟</> <h>ٱ</><l>ل</>زَّكَ<s>وٰ</>ةَ وَ<h>ٱ</>رْكَعُو<s>ا۟</> مَعَ <h>ٱ</><l>ل</><m>رَّٰ</>كِ<p>عِي</>نَ"},{"n":44,"w":[["۞ أَتَأْمُرُونَ","atamurūna","Do you order","তোমরা নির্দেশ দিচ্ছ কি"],["ٱلنَّاسَ","l-nāsa","[the] people","মানুষদের"],["بِٱلْبِرِّ","bil-biri","[the] righteousness","সৎকাজের"],["وَتَنسَوْنَ","watansawna","and you forget","আর তোমরা ভুলে যাচ্ছ"],["أَنفُسَكُمْ","anfusakum","yourselves","তোমাদের নিজেদেরকে"],["وَأَنتُمْ","wa-antum","while you","অথচ তোমরা"],["تَتْلُونَ","tatlūna","[you] recite","তিলাওয়াত কর"],["ٱلْكِتَـٰبَ ۚ","l-kitāba","the Book","কিতাব"],["أَفَلَا","afalā","Then, will not","না তবে কি"],["تَعْقِلُونَ","ta‘qilūna","you use reason","তোমরা বুঝ"]],"t":"۞ أَتَأْمُرُونَ <h>ٱ</><l>ل</><g>نَّ</>اسَ بِ<h>ٱ</>لْبِرِّ وَتَ<k>نسَ</>وْنَ أَ<k>نفُ</>سَكُمْ وَأَ<k>نتُ</>مْ تَتْلُونَ <h>ٱ</>لْكِ<m>تَٰ</>بَ ۚ أَفَلَا تَعْقِ<p>لُو</>نَ"},{"n":45,"w":[["وَٱسْتَعِينُوا۟","wa-is'ta‘īnū","And seek help","এবং তোমরা সাহায্য চাও"],["بِٱلصَّبْرِ","bil-ṣabri","through patience","ধৈর্যের মাধ্যমে"],["وَٱلصَّلَوٰةِ ۚ","wal-ṣalati","and the prayer","ও সালাতের (মাধ্যমে)"],["وَإِنَّهَا","wa-innahā","and indeed, it","এবং তা নিশ্চয়ই"],["لَكَبِيرَةٌ","lakabīratun","(is) surely difficult","বড় (কঠিন) অবশ্যই"],["إِلَّا","illā","except","তবে"],["عَلَى","‘alā","on","উপর"],["ٱلْخَـٰشِعِينَ","l-khāshi‘īna","the humble ones","বিনীতদের (কঠিন নয়)"]],"t":"وَ<h>ٱ</>سْتَعِينُو<s>ا۟</> بِ<h>ٱ</><l>ل</>صَّ<q>بْ</>رِ وَ<h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةِ ۚ وَإِ<g>نَّ</>هَا لَكَبِيرَةٌ إِلَّا عَلَى <h>ٱ</>لْ<m>خَٰ</>شِ<p>عِي</>نَ"},{"n":46,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["يَظُنُّونَ","yaẓunnūna","believe","বিশ্বাস করে"],["أَنَّهُم","annahum","that they","তারা নিশ্চয়ই"],["مُّلَـٰقُوا۟","mulāqū","will meet","সাক্ষাতকারী"],["رَبِّهِمْ","rabbihim","their Lord","তাদের রবের সাথে"],["وَأَنَّهُمْ","wa-annahum","and that they","এবং তারা নিশ্চয়ই"],["إِلَيْهِ","ilayhi","to Him","তাঁরই দিকে"],["رَٰجِعُونَ","rāji‘ūna","will return","প্রত্যাবর্তনকারী"]],"t":"ٱلَّذِينَ يَظُ<g>نُّ</>ونَ أَ<g>نَّ</><y>هُم مُّ</><m>لَٰ</>قُو<s>ا۟</> رَبِّهِمْ وَأَ<g>نَّ</>هُمْ إِلَيْهِ <m>رَٰ</>جِ<p>عُو</>نَ"},{"n":47,"w":[["يَـٰبَنِىٓ","yābanī","O Children","হে সন্তান"],["إِسْرَٰٓءِيلَ","is'rāīla","(of) Israel","ইসরাইলের"],["ٱذْكُرُوا۟","udh'kurū","Remember","তোমরা স্মরণ করো"],["نِعْمَتِىَ","ni‘'matiya","My Favor","আমার নেয়ামতকে"],["ٱلَّتِىٓ","allatī","which","যা"],["أَنْعَمْتُ","an‘amtu","I bestowed","আমি নেয়ামত দিয়েছি"],["عَلَيْكُمْ","‘alaykum","upon you","তোমাদের উপর"],["وَأَنِّى","wa-annī","and that I","এবং আমি"],["فَضَّلْتُكُمْ","faḍḍaltukum","[I] preferred you","তোমাদেরকে শ্রেষ্ঠত্ব দিয়েছি"],["عَلَى","‘alā","over","উপর"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","the worlds","বিশ্ববাসীর"]],"t":"<m>يَٰ</>بَ<o>نِىٓ</> إِسْ<o>رَٰٓ</>ءِيلَ <h>ٱ</>ذْكُرُو<s>ا۟</> نِعْمَتِىَ <h>ٱ</>لَّ<o>تِىٓ</> أَنْعَمْتُ عَلَيْكُمْ وَأَ<g>نِّ</>ى فَضَّلْتُكُمْ عَلَى <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":48,"w":[["وَٱتَّقُوا۟","wa-ittaqū","And fear","এবং তোমরা ভয় করো"],["يَوْمًۭا","yawman","a day","সে দিনকে"],["لَّا","lā","(will) not","(যখন) না"],["تَجْزِى","tajzī","avail","কাজে আসবে"],["نَفْسٌ","nafsun","any soul","কোনো ব্যক্তি"],["عَن","‘an","for","জন্যে"],["نَّفْسٍۢ","nafsin","(another) soul","(অন্যকোন)ব্যাক্তির"],["شَيْـًۭٔا","shayan","anything","কিছুই (মাত্রও)"],["وَلَا","walā","and not","এবং না"],["يُقْبَلُ","yuq'balu","will be accepted","গ্রহণ করা হবে"],["مِنْهَا","min'hā","from it","তার থেকে"],["شَفَـٰعَةٌۭ","shafā‘atun","any intercession","কোনো সুপারিশ"],["وَلَا","walā","and not","আর না"],["يُؤْخَذُ","yu'khadhu","will be taken","নেওয়া হবে"],["مِنْهَا","min'hā","from it","তার থেকে"],["عَدْلٌۭ","‘adlun","a compensation","কোনো বিনিময়"],["وَلَا","walā","and not","এবং না"],["هُمْ","hum","they","তাদের"],["يُنصَرُونَ","yunṣarūna","will be helped","সাহায্য করা হবে"]],"t":"وَ<h>ٱ</>تَّقُو<s>ا۟</> يَوْ<w>مًۭا لَّ</>ا تَ<q>جْ</>زِى نَفْسٌ <d>عَن نَّ</>فْ<k>سٍۢ شَ</><d>يْـًۭٔا وَ</>لَا يُ<q>قْ</>بَلُ مِنْهَا شَ<m>فَٰ</>عَ<d>ةٌۭ وَ</>لَا يُؤْخَذُ مِنْهَا عَ<q>دْ</><d>لٌۭ وَ</>لَا هُمْ يُ<k>نصَ</><p>رُو</>نَ"},{"n":49,"w":[["وَإِذْ","wa-idh","And when","এবং (স্মরণ করো) যখন"],["نَجَّيْنَـٰكُم","najjaynākum","We saved you","তোমাদেরকে মুক্তি দিয়েছিলাম"],["مِّنْ","min","from","হতে"],["ءَالِ","āli","(the) people","সম্প্রদায়ের"],["فِرْعَوْنَ","fir'‘awna","(of) Firaun","ফিরাউনের"],["يَسُومُونَكُمْ","yasūmūnakum","(who were) afflicting you (with)","তোমাদেরকে তারা যন্ত্রণা দিত"],["سُوٓءَ","sūa","horrible","নিকৃষ্ট"],["ٱلْعَذَابِ","l-‘adhābi","torment","যন্ত্রণা"],["يُذَبِّحُونَ","yudhabbiḥūna","slaughtering","তারা জবাই করত"],["أَبْنَآءَكُمْ","abnāakum","your sons","তোমাদের ছেলে সন্তানদের"],["وَيَسْتَحْيُونَ","wayastaḥyūna","and letting live","এবং জীবিত রাখত"],["نِسَآءَكُمْ ۚ","nisāakum","your women","তোমাদের কন্যা সন্তানদের"],["وَفِى","wafī","And in","এবং মধ্যে (ছিল)"],["ذَٰلِكُم","dhālikum","that","এর"],["بَلَآءٌۭ","balāon","(was) a trial","পরীক্ষা"],["مِّن","min","from","পক্ষ হতে"],["رَّبِّكُمْ","rabbikum","your Lord","তোমাদের রবের"],["عَظِيمٌۭ","‘aẓīmun","great","কঠিন"]],"t":"وَإِذْ نَجَّيْ<m>نَٰ</><y>كُم مِّ</>نْ ءَالِ فِرْعَوْنَ يَسُومُونَكُمْ <o>سُوٓ</>ءَ <h>ٱ</>لْعَذَابِ يُذَبِّحُونَ أَ<q>بْ</><o>نَآ</>ءَكُمْ وَيَسْتَحْيُونَ نِ<o>سَآ</>ءَكُمْ ۚ وَفِى <m>ذَٰ</>لِ<f>كُم بَ</><o>لَآ</><d>ءٌۭ مِّ</><w>ن رَّ</>بِّكُمْ عَ<p>ظِي</>مٌۭ"},{"n":50,"w":[["وَإِذْ","wa-idh","And when","এবং (স্মরণ করো) যখন"],["فَرَقْنَا","faraqnā","We parted","আমরা বিভক্ত করেছিলাম"],["بِكُمُ","bikumu","for you","তোমাদের (জন্যে)"],["ٱلْبَحْرَ","l-baḥra","the sea","সাগরকে"],["فَأَنجَيْنَـٰكُمْ","fa-anjaynākum","then We saved you","এরপর আমরা উদ্ধার করেছিলাম"],["وَأَغْرَقْنَآ","wa-aghraqnā","and We drowned","এবং আমরা ডুবিয়ে দিয়েছিলাম"],["ءَالَ","āla","(the) people","সম্প্রদায়কে"],["فِرْعَوْنَ","fir'‘awna","(of) Firaun","ফেরাঊনের"],["وَأَنتُمْ","wa-antum","while you","এমতাবস্থায় তোমরা"],["تَنظُرُونَ","tanẓurūna","(were) looking","দেখছিলে"]],"t":"وَإِذْ فَرَ<q>قْ</>نَا بِكُمُ <h>ٱ</>لْبَحْرَ فَأَ<k>نجَ</>يْ<m>نَٰ</>كُمْ وَأَغْرَ<q>قْ</><o>نَآ</> ءَالَ فِرْعَوْنَ وَأَ<k>نتُ</>مْ تَ<k>نظُ</><p>رُو</>نَ"},{"n":51,"w":[["وَإِذْ","wa-idh","And when","এবং যখন"],["وَٰعَدْنَا","wā‘adnā","We appointed","নির্ধারিত করেছিলাম"],["مُوسَىٰٓ","mūsā","(for) Musa","মূসার জন্যে"],["أَرْبَعِينَ","arba‘īna","forty","চল্লিশ"],["لَيْلَةًۭ","laylatan","nights","রাত"],["ثُمَّ","thumma","Then","এরপর"],["ٱتَّخَذْتُمُ","ittakhadhtumu","you took","তোমরা গ্রহণ করেছিলে"],["ٱلْعِجْلَ","l-‘ij'la","the calf","গরুর বাছুরকে (উপাস্যরূপে)"],["مِنۢ","min","from","তার"],["بَعْدِهِۦ","ba‘dihi","after him","পরে"],["وَأَنتُمْ","wa-antum","and you","যখন তোমরা"],["ظَـٰلِمُونَ","ẓālimūna","(were) wrongdoers","সীমালঙ্ঘঙ্কারী (ছিলে)"]],"t":"وَإِذْ <m>وَٰ</>عَ<q>دْ</>نَا مُوسَ<o>ىٰٓ</> أَرْبَعِينَ لَيْلَ<k>ةًۭ ثُ</><g>مَّ</> <h>ٱ</>تَّخَذْتُمُ <h>ٱ</>لْعِ<q>جْ</>لَ <i>مِنۢ بَ</>عْدِ<m>هِۦ</> وَأَ<k>نتُ</>مْ <m>ظَٰ</>لِ<p>مُو</>نَ"},{"n":52,"w":[["ثُمَّ","thumma","Then","অতঃপর"],["عَفَوْنَا","‘afawnā","We forgave","আমরা ক্ষমা করেছিলাম"],["عَنكُم","‘ankum","you","তোমাদের প্রতি"],["مِّنۢ","min","from","(থেকে)"],["بَعْدِ","ba‘di","after","পরেও"],["ذَٰلِكَ","dhālika","that","এর"],["لَعَلَّكُمْ","la‘allakum","so that you may","যেন তোমরা"],["تَشْكُرُونَ","tashkurūna","(be) grateful","কৃতজ্ঞতা প্রকাশ কর"]],"t":"ثُ<g>مَّ</> عَفَوْنَا عَ<k>نكُ</><y>م مِّ</><i>نۢ بَ</>عْدِ <m>ذَٰ</>لِكَ لَعَلَّكُمْ تَشْكُ<p>رُو</>نَ"},{"n":53,"w":[["وَإِذْ","wa-idh","And when","এবং (স্মরণ করো) যখন"],["ءَاتَيْنَا","ātaynā","We gave","আমরা দিয়েছিলাম"],["مُوسَى","mūsā","Musa","মুসাকে"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","কিতাব"],["وَٱلْفُرْقَانَ","wal-fur'qāna","and the Criterion","এবং ফুরকান"],["لَعَلَّكُمْ","la‘allakum","perhaps you","তোমরা যেন"],["تَهْتَدُونَ","tahtadūna","(would be) guided","সঠিক পথ প্রাপ্ত হও"]],"t":"وَإِذْ ءَاتَيْنَا مُوسَى <h>ٱ</>لْكِ<m>تَٰ</>بَ وَ<h>ٱ</>لْفُرْقَانَ لَعَلَّكُمْ تَهْتَ<p>دُو</>نَ"},{"n":54,"w":[["وَإِذْ","wa-idh","And when","এবং (স্মরণ করো) যখন"],["قَالَ","qāla","said","বলেছিল"],["مُوسَىٰ","mūsā","Musa","মুসা"],["لِقَوْمِهِۦ","liqawmihi","to his people","তার জাতির উদ্দ্যেশে"],["يَـٰقَوْمِ","yāqawmi","O my people","''হে আমার জাতি"],["إِنَّكُمْ","innakum","Indeed, you","তোমরা নিশ্চয়ই"],["ظَلَمْتُمْ","ẓalamtum","[you] have wronged","তোমরা অত্যাচার করেছ"],["أَنفُسَكُم","anfusakum","yourselves","তোমাদের নিজেদের (উপর)"],["بِٱتِّخَاذِكُمُ","bi-ittikhādhikumu","by your taking","তোমাদের গ্রহণ করার মাধ্যমে"],["ٱلْعِجْلَ","l-‘ij'la","the calf","গো বাছুরকে (উপাস্যরূপে)"],["فَتُوبُوٓا۟","fatūbū","So turn in repentance","সুতরাং তোমরা ফিরে এস"],["إِلَىٰ","ilā","to","দিকে"],["بَارِئِكُمْ","bāri-ikum","your Creator","তোমাদের সৃষ্টিকর্তার"],["فَٱقْتُلُوٓا۟","fa-uq'tulū","and kill","এরপর তোমরা প্রাণ সংহার করো"],["أَنفُسَكُمْ","anfusakum","yourselves","তোমাদের (অপরাধী) লোকদেরকে"],["ذَٰلِكُمْ","dhālikum","That","এটাই"],["خَيْرٌۭ","khayrun","(is) better","উত্তম"],["لَّكُمْ","lakum","for you","তোমাদের জন্যে"],["عِندَ","‘inda","with","কাছে"],["بَارِئِكُمْ","bāri-ikum","your Creator","তোমাদের স্রষ্টার''"],["فَتَابَ","fatāba","Then He turned","তিনি তখন ক্ষমা করলেন"],["عَلَيْكُمْ ۚ","‘alaykum","towards you","তোমাদেরকে"],["إِنَّهُۥ","innahu","Indeed He","তিনি নিশ্চয়ই"],["هُوَ","huwa","He","তিনিই"],["ٱلتَّوَّابُ","l-tawābu","(is) the-returning","অতীব ক্ষমাশীল"],["ٱلرَّحِيمُ","l-raḥīmu","the Most Merciful","পরম দয়ালু"]],"t":"وَإِذْ قَالَ مُوسَىٰ لِقَوْمِ<m>هِۦ يَٰ</>قَوْمِ إِ<g>نَّ</>كُمْ ظَلَمْتُمْ أَ<k>نفُ</>سَ<f>كُم بِ</><h>ٱ</>تِّخَاذِكُمُ <h>ٱ</>لْعِ<q>جْ</>لَ فَتُو<o>بُوٓ</><s>ا۟</> إِلَىٰ بَارِئِكُمْ فَ<h>ٱ</><q>قْ</>تُ<o>لُوٓ</><s>ا۟</> أَ<k>نفُ</>سَكُمْ <m>ذَٰ</>لِكُمْ خَيْ<w>رٌۭ لَّ</>كُمْ عِ<k>ندَ</> بَارِئِكُمْ فَتَابَ عَلَيْكُمْ ۚ إِ<g>نَّ</>هُ<m>ۥ</> هُوَ <h>ٱ</><l>ل</>تَّوَّابُ <h>ٱ</><l>ل</>رَّ<p>حِي</>مُ"},{"n":55,"w":[["وَإِذْ","wa-idh","And when","এবং স্মরণ কর যখন"],["قُلْتُمْ","qul'tum","you said","তোমরা বলেছিলে"],["يَـٰمُوسَىٰ","yāmūsā","O Musa","''হে মুসা"],["لَن","lan","Never","কখনও"],["نُّؤْمِنَ","nu'mina","(will) we believe","আমরা ঈমান আনব"],["لَكَ","laka","in you","তোমার উপর"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["نَرَى","narā","we see","আমরা দেখব"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["جَهْرَةًۭ","jahratan","manifestly","প্রকাশ্যভাবে''"],["فَأَخَذَتْكُمُ","fa-akhadhatkumu","So seized you","ফলে তোমাদেরকে ধরেছিল"],["ٱلصَّـٰعِقَةُ","l-ṣā‘iqatu","the thunderbolt","বজ্রপাত"],["وَأَنتُمْ","wa-antum","while you","এ অবস্থায় যে তোমরা"],["تَنظُرُونَ","tanẓurūna","(were) looking","দেখছিলে"]],"t":"وَإِذْ قُلْتُمْ <m>يَٰ</>مُوسَىٰ <d>لَن نُّ</>ؤْمِنَ لَكَ حَتَّىٰ نَرَى <h>ٱ</>للَّهَ جَهْرَ<k>ةًۭ فَ</>أَخَذَتْكُمُ <h>ٱ</><l>ل</><m>صَّٰ</>عِقَةُ وَأَ<k>نتُ</>مْ تَ<k>نظُ</><p>رُو</>نَ"},{"n":56,"w":[["ثُمَّ","thumma","Then","এরপর"],["بَعَثْنَـٰكُم","ba‘athnākum","We revived you","তোমাদের আমরা আবার জীবিত করলাম"],["مِّنۢ","min","from","(থেকে)"],["بَعْدِ","ba‘di","after","পরে"],["مَوْتِكُمْ","mawtikum","your death","তোমাদের মৃত্যুর"],["لَعَلَّكُمْ","la‘allakum","so that you may","যেন তোমরা"],["تَشْكُرُونَ","tashkurūna","(be) grateful","কৃতজ্ঞতা প্রকাশ কর"]],"t":"ثُ<g>مَّ</> بَعَثْ<m>نَٰ</><y>كُم مِّ</><i>نۢ بَ</>عْدِ مَوْتِكُمْ لَعَلَّكُمْ تَشْكُ<p>رُو</>نَ"},{"n":57,"w":[["وَظَلَّلْنَا","waẓallalnā","And We shaded","এবং আমরা ছায়া দিয়েছিলাম"],["عَلَيْكُمُ","‘alaykumu","[over] you","তোমাদের উপর"],["ٱلْغَمَامَ","l-ghamāma","(with) [the] clouds","মেঘের"],["وَأَنزَلْنَا","wa-anzalnā","and We sent down","এবং আমরা পাঠিয়েছিলাম"],["عَلَيْكُمُ","‘alaykumu","to you","তোমাদের কাছে"],["ٱلْمَنَّ","l-mana","[the] manna","মান্না"],["وَٱلسَّلْوَىٰ ۖ","wal-salwā","and [the] quails","ও সালওয়া"],["كُلُوا۟","kulū","Eat","''(বলেছিলাম) তোমরা খাও"],["مِن","min","from","হতে"],["طَيِّبَـٰتِ","ṭayyibāti","(the) good things","পবিত্র (খাদ্য)"],["مَا","mā","that","যা"],["رَزَقْنَـٰكُمْ ۖ","razaqnākum","We have provided you","তোমাদেরকে আমরা জীবিকা দিয়েছি''"],["وَمَا","wamā","And not","এবং না"],["ظَلَمُونَا","ẓalamūnā","they wronged Us","আমাদের (উপর) তারা অবিচার করেছে"],["وَلَـٰكِن","walākin","but","কিন্তু"],["كَانُوٓا۟","kānū","they were","তারা ছিল"],["أَنفُسَهُمْ","anfusahum","(to) themselves","তাদের নিজেদের (উপর)"],["يَظْلِمُونَ","yaẓlimūna","doing wrong","অবিচার করত"]],"t":"وَظَلَّلْنَا عَلَيْكُمُ <h>ٱ</>لْغَمَامَ وَأَ<k>نزَ</>لْنَا عَلَيْكُمُ <h>ٱ</>لْمَ<g>نَّ</> وَ<h>ٱ</><l>ل</>سَّلْوَىٰ ۖ كُلُو<s>ا۟</> مِ<k>ن طَ</>يِّ<m>بَٰ</>تِ مَا رَزَ<q>قْ</><m>نَٰ</>كُمْ ۖ وَمَا ظَلَمُونَا وَ<m>لَٰ</>كِ<k>ن كَ</>ا<o>نُوٓ</><s>ا۟</> أَ<k>نفُ</>سَهُمْ يَظْلِ<p>مُو</>نَ"},{"n":58,"w":[["وَإِذْ","wa-idh","And when","এবং স্মরণ করো যখন"],["قُلْنَا","qul'nā","We said","আমরা বলেছিলাম"],["ٱدْخُلُوا۟","ud'khulū","Enter","''তোমরা প্রবেশ কর"],["هَـٰذِهِ","hādhihi","this","এই"],["ٱلْقَرْيَةَ","l-qaryata","town","নগরীতে"],["فَكُلُوا۟","fakulū","then eat","তোমরা খাও"],["مِنْهَا","min'hā","from","তা হতে"],["حَيْثُ","ḥaythu","wherever","যেভাবে"],["شِئْتُمْ","shi'tum","you wish[ed]","তোমরা যাও"],["رَغَدًۭا","raghadan","abundantly","স্বানন্দে"],["وَٱدْخُلُوا۟","wa-ud'khulū","and enter","এবং তোমরা প্রবেশ করো"],["ٱلْبَابَ","l-bāba","the gate","(নগর) দরজায়"],["سُجَّدًۭا","sujjadan","prostrating","সিজদা অবনত হয়ে"],["وَقُولُوا۟","waqūlū","And say","এবং তোমরা বলো"],["حِطَّةٌۭ","ḥiṭṭatun","Repentance","''ক্ষমার কথা"],["نَّغْفِرْ","naghfir","We will forgive","ক্ষমা করবো আমরা"],["لَكُمْ","lakum","for you","তোমাদের প্রতি"],["خَطَـٰيَـٰكُمْ ۚ","khaṭāyākum","your sins","তোমাদের ত্রুটিগুলোকে"],["وَسَنَزِيدُ","wasanazīdu","And We will increase","এবং অচিরেই (অনুগ্রহ) বাড়িয়ে দিব"],["ٱلْمُحْسِنِينَ","l-muḥ'sinīna","the good-doers (in reward)","সৎকর্মশীলদেরকে''"]],"t":"وَإِذْ قُلْنَا <h>ٱ</><q>دْ</>خُلُو<s>ا۟</> <m>هَٰ</>ذِهِ <h>ٱ</>لْقَرْيَةَ فَكُلُو<s>ا۟</> مِنْهَا حَيْثُ شِئْتُمْ رَغَ<d>دًۭا وَ</><h>ٱ</><q>دْ</>خُلُو<s>ا۟</> <h>ٱ</>لْبَابَ سُجَّ<d>دًۭا وَ</>قُولُو<s>ا۟</> حِطَّ<d>ةٌۭ نَّ</>غْفِرْ لَكُمْ خَ<m>طَٰيَٰ</>كُمْ ۚ وَسَنَزِيدُ <h>ٱ</>لْمُحْسِ<p>نِي</>نَ"},{"n":59,"w":[["فَبَدَّلَ","fabaddala","But changed","কিন্তু পরিবর্তন করল"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ظَلَمُوا۟","ẓalamū","wronged","সীমালঙ্ঘন করেছিল"],["قَوْلًا","qawlan","(the) word","কথা"],["غَيْرَ","ghayra","other (than)","অন্য কিছু"],["ٱلَّذِى","alladhī","(that) which","(তা হতে) যা"],["قِيلَ","qīla","was said","বলা হয়েছিল"],["لَهُمْ","lahum","to them","তাদের উদ্দেশ্যে"],["فَأَنزَلْنَا","fa-anzalnā","so We sent down","আমরা তাই অবতীর্ণ করলাম"],["عَلَى","‘alā","upon","(তাদের) উপর"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ظَلَمُوا۟","ẓalamū","wronged","সীমালঙ্ঘন করেছিল"],["رِجْزًۭا","rij'zan","a punishment","শাস্তি"],["مِّنَ","mina","from","থেকে"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশ"],["بِمَا","bimā","because","এ কারণে যা"],["كَانُوا۟","kānū","they were","তারা ছিল"],["يَفْسُقُونَ","yafsuqūna","defiantly disobeying","তারা সত্যত্যাগ করে"]],"t":"فَبَدَّلَ <h>ٱ</>لَّذِينَ ظَلَمُو<s>ا۟</> قَوْلًا غَيْرَ <h>ٱ</>لَّذِى قِيلَ لَهُمْ فَأَ<k>نزَ</>لْنَا عَلَى <h>ٱ</>لَّذِينَ ظَلَمُو<s>ا۟</> رِ<q>جْ</><d>زًۭا مِّ</>نَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ بِمَا كَانُو<s>ا۟</> يَفْسُ<p>قُو</>نَ"},{"n":60,"w":[["۞ وَإِذِ","wa-idhi","And when","এবং স্মরণ করো যখন"],["ٱسْتَسْقَىٰ","is'tasqā","asked (for) water","পানি চাইল"],["مُوسَىٰ","mūsā","Musa","মুসা"],["لِقَوْمِهِۦ","liqawmihi","for his people","তার জাতির জন্য"],["فَقُلْنَا","faqul'nā","[so] We said","তখন আমরা বলেছিলাম"],["ٱضْرِب","iḍ'rib","Strike","''আঘাত কর"],["بِّعَصَاكَ","bi‘aṣāka","with your staff","তোমার লাঠি দিয়ে"],["ٱلْحَجَرَ ۖ","l-ḥajara","the stone","পাথরে''"],["فَٱنفَجَرَتْ","fa-infajarat","Then gushed forth","ফলে ফেটে বের হল"],["مِنْهُ","min'hu","from it","তা থেকে"],["ٱثْنَتَا","ith'natā","(of)","বারটি"],["عَشْرَةَ","‘ashrata","twelve","(দশ)"],["عَيْنًۭا ۖ","‘aynan","springs","ঝর্ণা"],["قَدْ","qad","Indeed","নিশ্চয়ই"],["عَلِمَ","‘alima","knew","চিনে নিল"],["كُلُّ","kullu","all","প্রত্যেক"],["أُنَاسٍۢ","unāsin","(the) people","(গোত্রের) মানুষ"],["مَّشْرَبَهُمْ ۖ","mashrabahum","their drinking place","তাদের পানি পানের স্থান"],["كُلُوا۟","kulū","Eat","''(বলা হল) তোমরা খাও"],["وَٱشْرَبُوا۟","wa-ish'rabū","and drink","ও তোমরা পান করো"],["مِن","min","from","থেকে"],["رِّزْقِ","riz'qi","(the) provision (of)","জীবিকা"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌র (দেয়া)"],["وَلَا","walā","and (do) not","এবং না"],["تَعْثَوْا۟","ta‘thaw","act wickedly","তোমরা বিপর্যয় সৃষ্টি করো"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["مُفْسِدِينَ","muf'sidīna","spreading corruption","বিপর্যয় সৃষ্টিকারী হয়ে''"]],"t":"۞ وَإِذِ <h>ٱ</>سْتَسْقَىٰ مُوسَىٰ لِقَوْمِ<m>هِۦ</> فَقُلْنَا <h>ٱ</>ضْرِب بِّعَصَاكَ <h>ٱ</>لْحَجَرَ ۖ فَ<h>ٱ</><k>نفَ</>جَرَتْ مِنْهُ <h>ٱ</>ثْنَتَا عَشْرَةَ عَيْ<k>نًۭا ۖ قَ</><q>دْ</> عَلِمَ كُلُّ أُنَا<d>سٍۢ مَّ</>شْرَبَهُمْ ۖ كُلُو<s>ا۟</> وَ<h>ٱ</>شْرَبُو<s>ا۟</> <w>مِن رِّ</>زْقِ <h>ٱ</>للَّهِ وَلَا تَعْثَوْ<s>ا۟</> فِى <h>ٱ</>لْأَرْضِ مُفْسِ<p>دِي</>نَ"},{"n":61,"w":[["وَإِذْ","wa-idh","And when","এবং (স্মরণ করো)"],["قُلْتُمْ","qul'tum","you said","বলেছিলে তোমরা"],["يَـٰمُوسَىٰ","yāmūsā","O Musa","''হে মুসা"],["لَن","lan","Never (will)","কখনও না"],["نَّصْبِرَ","naṣbira","we endure","আমরা ধৈর্য ধরতে পারব"],["