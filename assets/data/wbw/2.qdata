وَلُّو<s>ا۟</> وُجُوهَكُمْ قِبَلَ <h>ٱ</>لْمَشْرِقِ وَ<h>ٱ</>لْمَغْرِبِ وَ<m>لَٰ</>كِ<g>نَّ</> <h>ٱ</>لْبِرَّ مَنْ ءَامَنَ بِ<h>ٱ</>للَّهِ وَ<h>ٱ</>لْيَوْمِ <h>ٱ</>لْءَاخِرِ وَ<h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةِ وَ<h>ٱ</>لْكِ<m>تَٰ</>بِ وَ<h>ٱ</><l>ل</><g>نَّ</>بِيِّۦنَ وَءَاتَى <h>ٱ</>لْمَالَ عَلَىٰ حُبِّ<m>هِۦ</> ذَوِى <h>ٱ</>لْقُرْبَىٰ وَ<h>ٱ</>لْيَ<m>تَٰ</>مَىٰ وَ<h>ٱ</>لْمَ<m>سَٰ</>كِينَ وَ<h>ٱ</><q>بْ</>نَ <h>ٱ</><l>ل</>سَّبِيلِ وَ<h>ٱ</><l>ل</><o>سَّآ</>ئِلِينَ وَفِى <h>ٱ</><l>ل</>رِّقَابِ وَأَقَامَ <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةَ وَءَاتَى <h>ٱ</><l>ل</>زَّكَ<s>وٰ</>ةَ وَ<h>ٱ</>لْمُوفُونَ بِعَهْدِهِمْ إِذَا <m>عَٰ</>هَدُو<s>ا۟ ۖ</> وَ<h>ٱ</><l>ل</><m>صَّٰ</>بِرِينَ فِى <h>ٱ</>لْبَأْ<o>سَآ</>ءِ وَ<h>ٱ</><l>ل</>ضَّ<o>رَّآ</>ءِ وَحِينَ <h>ٱ</>لْبَأْسِ ۗ أُ<s>و۟</><o>لَٰٓ</>ئِكَ <h>ٱ</>لَّذِينَ صَدَقُو<s>ا۟ ۖ</> وَأُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</>لْمُتَّ<p>قُو</>نَ"},{"n":178,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you","হে"],["ٱلَّذِينَ","alladhīna","who","যারা"],["ءَامَنُوا۟","āmanū","believe[d]","ঈমান এনেছ"],["كُتِبَ","kutiba","Prescribed","ফরজ করা হয়েছে"],["عَلَيْكُمُ","‘alaykumu","for you","তোমাদের উপর"],["ٱلْقِصَاصُ","l-qiṣāṣu","(is) the legal retribution","কিসাস(বদলা)"],["فِى","fī","in","ব্যাপারে"],["ٱلْقَتْلَى ۖ","l-qatlā","(the matter of) the murdered","(অন্যায়) হত্যার"],["ٱلْحُرُّ","l-ḥuru","the freeman","স্বাধীন ব্যাক্তি"],["بِٱلْحُرِّ","bil-ḥuri","for the freeman","স্বাধীন ব্যাক্তির পরিবর্তে"],["وَٱلْعَبْدُ","wal-‘abdu","and the slave","ও ক্রীতদাস"],["بِٱلْعَبْدِ","bil-‘abdi","for the slave","ক্রীতদাসের পরিবর্তে"],["وَٱلْأُنثَىٰ","wal-unthā","and the female","এবং মহিলা"],["بِٱلْأُنثَىٰ ۚ","bil-unthā","for the female","মহিলার পরিবর্তে"],["فَمَنْ","faman","But whoever","অতঃপর তার (ক্ষেত্রে)"],["عُفِىَ","‘ufiya","is pardoned","ক্ষমা করে দেয়া হয়"],["لَهُۥ","lahu","[for it]","তার জন্য"],["مِنْ","min","from","পক্ষ হতে"],["أَخِيهِ","akhīhi","his brother","তার ভাইয়ের"],["شَىْءٌۭ","shayon","anything","কোনো কিছু"],["فَٱتِّبَاعٌۢ","fa-ittibā‘un","then follows up","তবে অনুসরণ করা"],["بِٱلْمَعْرُوفِ","bil-ma‘rūfi","with suitable","সদয়ভাবে"],["وَأَدَآءٌ","wa-adāon","[and] payment","এবং (রক্তপণ) আদায় করা"],["إِلَيْهِ","ilayhi","to him","তার কাছে"],["بِإِحْسَـٰنٍۢ ۗ","bi-iḥ'sānin","with kindness","নিষ্ঠার সাথে (অপরিহার্য হবে)"],["ذَٰلِكَ","dhālika","That (is)","এটা"],["تَخْفِيفٌۭ","takhfīfun","a concession","লাঘব"],["مِّن","min","from","পক্ষ থেকে"],["رَّبِّكُمْ","rabbikum","your Lord","তোমাদের রবের"],["وَرَحْمَةٌۭ ۗ","waraḥmatun","and mercy","এবং রহমত(দয়া)"],["فَمَنِ","famani","Then whoever","যে অতঃপর"],["ٱعْتَدَىٰ","i‘'tadā","transgresses","সীমালংঘন করবে"],["بَعْدَ","ba‘da","after","পর"],["ذَٰلِكَ","dhālika","that","এর"],["فَلَهُۥ","falahu","then for him","তার জন্যে(আছে)"],["عَذَابٌ","‘adhābun","(is) a punishment","শাস্তি"],["أَلِيمٌۭ","alīmun","painful","অতি কষ্টদায়ক"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> كُتِبَ عَلَيْكُمُ <h>ٱ</>لْقِصَاصُ فِى <h>ٱ</>لْقَتْلَى ۖ <h>ٱ</>لْحُرُّ بِ<h>ٱ</>لْحُرِّ وَ<h>ٱ</>لْعَ<q>بْ</>دُ بِ<h>ٱ</>لْعَ<q>بْ</>دِ وَ<h>ٱ</>لْأُ<k>نثَ</>ىٰ بِ<h>ٱ</>لْأُ<k>نثَ</>ىٰ ۚ فَمَنْ عُفِىَ لَهُ<m>ۥ</> مِنْ أَخِيهِ <k>شَىْءٌۭ فَ</><h>ٱ</>تِّبَا<i>عٌۢ بِ</><h>ٱ</>لْمَعْرُوفِ وَأَ<o>دَآ</>ءٌ إِلَيْهِ بِإِحْ<m>سَٰ</><k>نٍۢ ۗ ذَٰ</>لِكَ تَخْفِي<d>فٌۭ مِّ</><w>ن رَّ</>بِّكُمْ وَرَحْمَ<k>ةٌۭ ۗ فَ</>مَنِ <h>ٱ</>عْتَدَىٰ بَعْدَ <m>ذَٰ</>لِكَ فَلَهُ<m>ۥ</> عَذَابٌ أَ<p>لِي</>مٌۭ"},{"n":179,"w":[["وَلَكُمْ","walakum","And for you","এবং তোমাদের জন্যে(রয়েছে)"],["فِى","fī","in","মধ্যে"],["ٱلْقِصَاصِ","l-qiṣāṣi","the legal retribution","কিসাসের(বদলার)"],["حَيَوٰةٌۭ","ḥayatun","(is) life","জীবন"],["يَـٰٓأُو۟لِى","yāulī","O men","হে লোকেরা"],["ٱلْأَلْبَـٰبِ","l-albābi","(of) understanding","বোধ(সম্পন্ন)"],["لَعَلَّكُمْ","la‘allakum","So that you may","আশা করা যায়"],["تَتَّقُونَ","tattaqūna","(become) righteous","তোমরা সাবধান হয়ে চলবে"]],"t":"وَلَكُمْ فِى <h>ٱ</>لْقِصَاصِ حَيَ<s>وٰ</><d>ةٌۭ يَٰٓ</>أُ<s>و۟</>لِى <h>ٱ</>لْأَلْ<m>بَٰ</>بِ لَعَلَّكُمْ تَتَّ<p>قُو</>نَ"},{"n":180,"w":[["كُتِبَ","kutiba","Prescribed","ফরজ করা হয়েছে"],["عَلَيْكُمْ","‘alaykum","for you","তোমাদের উপর"],["إِذَا","idhā","when","যখন"],["حَضَرَ","ḥaḍara","approaches","উপস্থিত হয়"],["أَحَدَكُمُ","aḥadakumu","any of you","তোমাদের কারও"],["ٱلْمَوْتُ","l-mawtu","[the] death","মৃত্যু"],["إِن","in","if","যদি"],["تَرَكَ","taraka","he leaves","সে ছেড়ে যায়"],["خَيْرًا","khayran","good","ধনসম্পত্তি"],["ٱلْوَصِيَّةُ","l-waṣiyatu","(making) the will","ওসীয়ত করা(জোর নির্দেশ)"],["لِلْوَٰلِدَيْنِ","lil'wālidayni","for the parents","পিতা-মাতার জন্য"],["وَٱلْأَقْرَبِينَ","wal-aqrabīna","and the near relatives","ও আত্নীয়-স্বজনদের (জন্যে)"],["بِٱلْمَعْرُوفِ ۖ","bil-ma‘rūfi","with due fairness","ন্যায় অনুযায়ী"],["حَقًّا","ḥaqqan","a duty","একটি অধিকার"],["عَلَى","‘alā","on","উপর"],["ٱلْمُتَّقِينَ","l-mutaqīna","the righteous ones","মুত্তাকীদের"]],"t":"كُتِبَ عَلَيْكُمْ إِذَا حَضَرَ أَحَدَكُمُ <h>ٱ</>لْمَوْتُ إِ<k>ن تَ</>رَكَ خَيْرًا <h>ٱ</>لْوَصِيَّةُ لِلْ<m>وَٰ</>لِدَيْنِ وَ<h>ٱ</>لْأَ<q>قْ</>رَبِينَ بِ<h>ٱ</>لْمَعْرُوفِ ۖ حَقًّا عَلَى <h>ٱ</>لْمُتَّ<p>قِي</>نَ"},{"n":181,"w":[["فَمَنۢ","faman","Then whoever","যে অতঃপর"],["بَدَّلَهُۥ","baddalahu","changes it","তা পরিবর্তন করে"],["بَعْدَ مَا","ba‘damā","after what","এরপরেও যা"],["سَمِعَهُۥ","sami‘ahu","he (has) heard [it]","তা শুনেছে"],["فَإِنَّمَآ","fa-innamā","so only","মূলতঃ তবে"],["إِثْمُهُۥ","ith'muhu","its sin","তার গুনাহ"],["عَلَى","‘alā","(would be) on","উপর"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["يُبَدِّلُونَهُۥٓ ۚ","yubaddilūnahu","alter it","তা পরিবর্তন করেছে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","al-laha","Allah","আল্লাহ"],["سَمِيعٌ","sami'un","(is) All-Hearing","সবকিছু শুনেন"],["عَلِيمٌۭ","alimun","All-Knowing","সবকিছু জানেন"]],"t":"فَ<i>مَنۢ بَ</>دَّلَهُ<m>ۥ</> بَعْدَمَا سَمِعَهُ<m>ۥ</> فَإِ<g>نَّ</><o>مَآ</> إِثْمُهُ<m>ۥ</> عَلَى <h>ٱ</>لَّذِينَ يُبَدِّلُونَهُ<o>ۥٓ ۚ</> إِ<g>نَّ</> <h>ٱ</>للَّهَ سَمِيعٌ عَ<p>لِي</>مٌۭ"},{"n":182,"w":[["فَمَنْ","faman","But whoever","যে তবে"],["خَافَ","khāfa","fears","ভয় করে"],["مِن","min","from","হতে"],["مُّوصٍۢ","mūṣin","(the) testator","ওসীয়তকারী"],["جَنَفًا","janafan","(any) error","পক্ষপাতিত্বের"],["أَوْ","aw","or","বা"],["إِثْمًۭا","ith'man","sin","অন্যায়ের"],["فَأَصْلَحَ","fa-aṣlaḥa","then reconciles","তারপর সে মীমাংসা করে দেবে"],["بَيْنَهُمْ","baynahum","between them","তাদের মাঝে"],["فَلَآ","falā","then (there is) no","তবে নেই"],["إِثْمَ","ith'ma","sin","কোনো গোনাহ"],["عَلَيْهِ ۚ","‘alayhi","on him","তার উপর"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["غَفُورٌۭ","ghafūrun","(is) Oft-Forgiving","ক্ষমাশীল"],["رَّحِيمٌۭ","raḥīmun","All-Merciful","পরমদয়ালু"]],"t":"فَمَنْ خَافَ <d>مِن مُّ</>و<k>صٍۢ جَ</>نَفًا أَوْ إِثْ<k>مًۭا فَ</>أَصْلَحَ بَيْنَهُمْ فَ<o>لَآ</> إِثْمَ عَلَيْهِ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ غَفُو<w>رٌۭ رَّ</><p>حِي</>مٌۭ"},{"n":183,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you","হে"],["ٱلَّذِينَ","alladhīna","who","যারা"],["ءَامَنُوا۟","āmanū","believe[d]","ঈমান এনেছে"],["كُتِبَ","kutiba","Is prescribed","ফরজ করা হয়েছে"],["عَلَيْكُمُ","‘alaykumu","for you","তোমাদের উপর"],["ٱلصِّيَامُ","l-ṣiyāmu","[the] fasting","রোযা(সাওম)"],["كَمَا","kamā","as","যেমন"],["كُتِبَ","kutiba","was prescribed","ফরজ করা হয়েছিল"],["عَلَى","‘alā","to","উপর"],["ٱلَّذِينَ","alladhīna","those","(তাদের) যারা"],["مِن","min","from","থেকে"],["قَبْلِكُمْ","qablikum","before you","তোমাদের পূর্বে (ছিলো)"],["لَعَلَّكُمْ","la‘allakum","so that you may","আশা করা যায়"],["تَتَّقُونَ","tattaqūna","(become) righteous","তোমরা তাকওয়া অবলম্বন করবে"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> كُتِبَ عَلَيْكُمُ <h>ٱ</><l>ل</>صِّيَامُ كَمَا كُتِبَ عَلَى <h>ٱ</>لَّذِينَ مِ<k>ن قَ</><q>بْ</>لِكُمْ لَعَلَّكُمْ تَتَّ<p>قُو</>نَ"},{"n":184,"w":[["أَيَّامًۭا","ayyāman","(Fasting for) days","দিনগুলোতে"],["مَّعْدُودَٰتٍۢ ۚ","ma‘dūdātin","numbered","নির্দিষ্ট সংখ্যক"],["فَمَن","faman","So whoever","যে অতঃপর"],["كَانَ","kāna","is","হবে"],["مِنكُم","minkum","among you","তোমাদের মধ্যে"],["مَّرِيضًا","marīḍan","sick","অসুস্থ"],["أَوْ","aw","or","অথবা"],["