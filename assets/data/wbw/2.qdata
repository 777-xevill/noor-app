en only","তবে প্রকৃতপক্ষে"],["هُمْ","hum","they","তারা"],["فِى","fī","(are) in","মধ্যে (লিপ্ত)"],["شِقَاقٍۢ ۖ","shiqāqin","dissension","বিরোধের"],["فَسَيَكْفِيكَهُمُ","fasayakfīkahumu","So will suffice you against them","সুতরাং তাদের বিরুদ্ধে তোমার জন্য যথেষ্ট"],["ٱللَّهُ ۚ","l-lahu","Allah","আল্লাহই"],["وَهُوَ","wahuwa","and He","এবং তিনি"],["ٱلسَّمِيعُ","l-samī‘u","(is) the All-Hearing","সবকিছু শোনেন"],["ٱلْعَلِيمُ","l-‘alīmu","the All-Knowing","সবকিছু জানেন"]],"t":"فَإِنْ ءَامَنُو<s>ا۟</> بِمِثْلِ <o>مَآ</> ءَامَ<k>نتُ</><f>م بِ</><m>هِۦ</> فَقَدِ <h>ٱ</>هْتَدَو<s>ا۟ ۖ</> وَّإِ<k>ن تَ</>وَلَّوْ<s>ا۟</> فَإِ<g>نَّ</>مَا هُمْ فِى شِقَا<k>قٍۢ ۖ فَ</>سَيَكْفِيكَهُمُ <h>ٱ</>للَّهُ ۚ وَهُوَ <h>ٱ</><l>ل</>سَّمِيعُ <h>ٱ</>لْعَ<p>لِي</>مُ"},{"n":138,"w":[["صِبْغَةَ","ṣib'ghata","(The) color (religion)","(গ্রহণ কর) রং (অর্থাৎ দীন)"],["ٱللَّهِ ۖ","l-lahi","(of) Allah","আল্লাহ্‌র"],["وَمَنْ","waman","And who","এবং কে (আছে)"],["أَحْسَنُ","aḥsanu","(is) better","বেশী"],["مِنَ","mina","than","চেয়ে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌র"],["صِبْغَةًۭ ۖ","ṣib'ghatan","at coloring","রঙে"],["وَنَحْنُ","wanaḥnu","And we","এবং আমরা"],["لَهُۥ","lahu","to Him","তাঁরই"],["عَـٰبِدُونَ","‘ābidūna","(are) worshippers","ইবাদাতকারী"]],"t":"صِ<q>بْ</>غَةَ <h>ٱ</>للَّهِ ۖ وَمَنْ أَحْسَنُ مِنَ <h>ٱ</>للَّهِ صِ<q>بْ</>غَ<d>ةًۭ ۖ وَ</>نَحْنُ لَهُ<m>ۥ عَٰ</>بِ<p>دُو</>نَ"},{"n":139,"w":[["قُلْ","qul","Say","বলো"],["أَتُحَآجُّونَنَا","atuḥājjūnanā","Do you argue with us","''আমাদের সাথে কি তর্ক করছ"],["فِى","fī","about","ব্যাপারে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌র"],["وَهُوَ","wahuwa","while He","অথচ তিনি"],["رَبُّنَا","rabbunā","(is) our Lord","আমাদের রব"],["وَرَبُّكُمْ","warabbukum","and your Lord","ও তোমাদের রব"],["وَلَنَآ","walanā","And for us","এবং আমাদের জন্য"],["أَعْمَـٰلُنَا","a‘mālunā","(are) our deeds","আমাদের কাজ"],["وَلَكُمْ","walakum","and for you","ও তোমাদের জন্য"],["أَعْمَـٰلُكُمْ","a‘mālukum","(are) your deeds","তোমাদের কাজ"],["وَنَحْنُ","wanaḥnu","and we","এবং আমরা"],["لَهُۥ","lahu","to Him","তাঁরই"],["مُخْلِصُونَ","mukh'liṣūna","(are) sincere","একনিষ্ঠভাবে (দাসত্বকারী)"]],"t":"قُلْ أَتُ<n>حَآ</>جُّونَنَا فِى <h>ٱ</>للَّهِ وَهُوَ رَبُّنَا وَرَبُّكُمْ وَلَ<o>نَآ</> أَعْ<m>مَٰ</>لُنَا وَلَكُمْ أَعْ<m>مَٰ</>لُكُمْ وَنَحْنُ لَهُ<m>ۥ</> مُخْلِ<p>صُو</>نَ"},{"n":140,"w":[["أَمْ","am","Or","অথবা (কি)"],["تَقُولُونَ","taqūlūna","(do) you say","তোমরা বল"],["إِنَّ","inna","that","নিশ্চয়ই"],["إِبْرَٰهِـۧمَ","ib'rāhīma","Ibrahim","ইবরাহীম"],["وَإِسْمَـٰعِيلَ","wa-is'mā‘īla","and Ishmael","ও ইসমাঈল"],["وَإِسْحَـٰقَ","wa-is'ḥāqa","and Isaac","ও ইসহাক"],["وَيَعْقُوبَ","waya‘qūba","and Yaqub","ও ইয়াকুব"],["وَٱلْأَسْبَاطَ","wal-asbāṭa","and the descendants","এবং (তাদের) বংশধর"],["كَانُوا۟","kānū","were","তারা ছিল"],["هُودًا","hūdan","Jews","ইহুদী"],["أَوْ","aw","or","অথবা"],["نَصَـٰرَىٰ ۗ","naṣārā","Christians","খ্রিষ্টান''"],["قُلْ","qul","Say","বলো"],["ءَأَنتُمْ","a-antum","Are you","''তোমরা কি"],["أَعْلَمُ","a‘lamu","better knowing","বেশি জান"],["أَمِ","ami","or","অথবা"],["ٱللَّهُ ۗ","l-lahu","(is) Allah","আল্লাহ্‌ (বেশি জানেন)''"],["وَمَنْ","waman","And who","এবং কে"],["أَظْلَمُ","aẓlamu","(is) more unjust","বড় সীমালঙ্ঘনকারী"],["مِمَّن","mimman","than (the one) who","তার চেয়ে যে"],["كَتَمَ","katama","concealed","গোপন করে"],["شَهَـٰدَةً","shahādatan","a testimony","একটি সাক্ষ্য (বা প্রমাণ)"],["عِندَهُۥ","‘indahu","(that) he has","(যা আছে) তার কাছে"],["مِنَ","mina","from","পক্ষ হতে"],["ٱللَّهِ ۗ","l-lahi","Allah","আল্লাহ্‌র"],["وَمَا","wamā","And not","এবং না"],["ٱللَّهُ","l-lahu","(is) Allah","আল্লাহ্‌"],["بِغَـٰفِلٍ","bighāfilin","unaware","উদাসীন"],["عَمَّا","‘ammā","of what","সে সম্পর্কে যা"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা কাজ করছ"]],"t":"أَمْ تَقُولُونَ إِ<g>نَّ</> إِ<q>بْ</><m>رَٰ</>هِۦمَ وَإِسْ<m>مَٰ</>عِيلَ وَإِسْ<m>حَٰ</>قَ وَيَعْقُوبَ وَ<h>ٱ</>لْأَسْبَاطَ كَانُو<s>ا۟</> هُودًا أَوْ نَ<m>صَٰ</>رَىٰ ۗ قُلْ ءَأَ<k>نتُ</>مْ أَعْلَمُ أَمِ <h>ٱ</>للَّهُ ۗ وَمَنْ أَظْلَمُ مِ<g>مَّ</><k>ن كَ</>تَمَ شَ<m>هَٰ</>دَةً عِ<k>ندَ</>هُ<m>ۥ</> مِنَ <h>ٱ</>للَّهِ ۗ وَمَا <h>ٱ</>للَّهُ بِ<m>غَٰ</>فِلٍ عَ<g>مَّ</>ا تَعْمَ<p>لُو</>نَ"},{"n":141,"w":[["تِلْكَ","til'ka","This","সেই"],["أُمَّةٌۭ","ummatun","(was) a community","জাতি"],["قَدْ","qad","(which)","নিশ্চয়ই"],["خَلَتْ ۖ","khalat","has passed away","অতীত হয়েছে তা"],["لَهَا","lahā","for it","তার জন্য(আছে)"],["مَا","mā","what","যা"],["كَسَبَتْ","kasabat","it earned","সে উপার্জন করেছে"],["وَلَكُم","walakum","and for you","এবং তোমাদের জন্য"],["مَّا","mā","what","যা"],["كَسَبْتُمْ ۖ","kasabtum","you have earned","তোমরা উপার্জন করেছ"],["وَلَا","walā","And not","এবং না"],["تُسْـَٔلُونَ","tus'alūna","you will be asked","তোমাদের প্রশ্ন করা হবে"],["عَمَّا","‘ammā","about what","সে সম্পর্কে যা"],["كَانُوا۟","kānū","they used to","তারা ছিল"],["يَعْمَلُونَ","ya‘malūna","do","তারা কাজ করতে"]],"t":"تِلْكَ أُ<g>مَّ</><k>ةٌۭ قَ</><q>دْ</> خَلَتْ ۖ لَهَا مَا كَسَبَتْ وَلَ<y>كُم مَّ</>ا كَسَ<q>بْ</>تُمْ ۖ وَلَا تُسْـَٔلُونَ عَ<g>مَّ</>ا كَانُو<s>ا۟</> يَعْمَ<p>لُو</>نَ"},{"n":142,"w":[["۞ سَيَقُولُ","sayaqūlu","Will say","বলবে অচিরেই"],["ٱلسُّفَهَآءُ","l-sufahāu","the foolish ones","নির্বোধরা"],["مِنَ","mina","from","মধ্য হতে"],["ٱلنَّاسِ","l-nāsi","the people","মানুষদের"],["مَا","mā","What","''কিসে"],["وَلَّىٰهُمْ","wallāhum","(has) turned them","তাদের মুখ ফিরাল"],["عَن","‘an","from","হতে"],["قِبْلَتِهِمُ","qib'latihimu","their direction of prayer","তাদের কিবলা"],["ٱلَّتِى","allatī","which","সেই (কিবলা হতে)"],["كَانُوا۟","kānū","they were used to","তারা ছিল"],["عَلَيْهَا ۚ","‘alayhā","[on it]","যার দিকে (মুখ করত)''"],["قُل","qul","Say","বলো"],["لِّلَّهِ","lillahi","For Allah","''আল্লাহরই"],["ٱلْمَشْرِقُ","l-mashriqu","(is) the east","পূর্ব"],["وَٱلْمَغْرِبُ ۚ","wal-maghribu","and the west","ও পশ্চিম"],["يَهْدِى","yahdī","He guides","তিনি পথ দেখান"],["مَن","man","whom","যাকে"],["يَشَآءُ","yashāu","He wills","তিনি চান"],["إِلَىٰ","ilā","to","দিকে"],["صِرَٰطٍۢ","ṣirāṭin","a path","পথের"],["مُّسْتَقِيمٍۢ","mus'taqīmin","straight","সরলসোজা''"]],"t":"۞ سَيَقُولُ <h>ٱ</><l>ل</>سُّفَ<o>هَآ</>ءُ مِنَ <h>ٱ</><l>ل</><g>نَّ</>اسِ مَا وَلَّ<m>ىٰ</>هُمْ عَ<k>ن قِ</><q>بْ</>لَتِهِمُ <h>ٱ</>لَّتِى كَانُو<s>ا۟</> عَلَيْهَا ۚ قُل لِّلَّهِ <h>ٱ</>لْمَشْرِقُ وَ<h>ٱ</>لْمَغْرِبُ ۚ يَهْدِى <d>مَن يَ</><o>شَآ</>ءُ إِلَىٰ صِ<m>رَٰ</><d>طٍۢ مُّ</>سْتَ<p>قِي</>مٍۢ"},{"n":143,"w":[["وَكَذَٰلِكَ","wakadhālika","And thus","এবং এভাবে"],["جَعَلْنَـٰكُمْ","ja‘alnākum","We made you","তোমাদের আমরা বানিয়েছি"],["أُمَّةًۭ","ummatan","a community","একটি জাতি"],["وَسَطًۭا","wasaṭan","(of the) middle way","মধ্যমপন্থী"],["لِّتَكُونُوا۟","litakūnū","so that you will be","তোমরা হও যেন"],["شُهَدَآءَ","shuhadāa","witnesses","সাক্ষী"],["عَلَى","‘alā","over","উপর(জন্য)"],["ٱلنَّاسِ","l-nāsi","the mankind","(পৃথিবীর) মানুষের"],["وَيَكُونَ","wayakūna","and will be","ও হয়"],["ٱلرَّسُولُ","l-rasūlu","the Messenger","রাসূল"],["عَلَيْكُمْ","‘alaykum","on you","তোমাদের উপর(জন্য)"],["شَهِيدًۭا ۗ","shahīdan","a witness","সাক্ষী"],["وَمَا","wamā","And not","এবং না"],["جَعَلْنَا","ja‘alnā","We made","আমরা বানিয়েছিলাম"],["ٱلْقِبْلَةَ","l-qib'lata","the direction of prayer","কিবলা"],["ٱلَّتِى","allatī","which","সেটাকে"],["كُنتَ","kunta","you were used to","তুমি ছিলে"],["عَلَيْهَآ","‘alayhā","[on it]","যার উপর"],["إِلَّا","illā","except","এ ছাড়া"],["لِنَعْلَمَ","lina‘lama","that We make evident","আমরা যেন জানতে পারি"],["مَن","man","(he) who","কে"],["يَتَّبِعُ","yattabi‘u","follows","অনুসরণ করে"],["ٱلرَّسُولَ","l-rasūla","the Messenger","রাসূলকে (আর)"],["مِمَّن","mimman","from (he) who","কে তাদের মধ্য হতে"],["يَنقَلِبُ","yanqalibu","turns back","ফিরে যায়"],["عَلَىٰ","‘alā","on","উপর"],["عَقِبَيْهِ ۚ","‘aqibayhi","his heels","তার দুই গোড়ালির (অর্থাৎ উল্টোদিকে)"],["وَإِن","wa-in","And indeed","এবং যদিও"],["كَانَتْ","kānat","it was","তা ছিল (মেনে চলা)"],["لَكَبِيرَةً","lakabīratan","certainly a great (test)","অবশ্যই কঠিন"],["إِلَّا","illā","except","তবে (নয় কঠিন)"],["عَلَى","‘alā","for","(তাদের) উপর"],["ٱلَّذِينَ","alladhīna","those whom","যাদেরকে"],["هَدَى","hadā","guided","পথ দেখিয়েছেন"],["ٱللَّهُ ۗ","l-lahu","(by) Allah","আল্লাহ্‌"],["وَمَا","wamā","And not","এবং নন"],["كَانَ","kāna","will","(ছিল)"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ্‌ (এরূপ যে)"],["لِيُضِيعَ","liyuḍī‘a","let go waste","নষ্ট করবেন"],["إِيمَـٰنَكُمْ ۚ","īmānakum","your faith","তোমাদের ঈমান"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["بِٱلنَّاسِ","bil-nāsi","(is) to [the] mankind","মানুষের উপর"],["لَرَءُوفٌۭ","laraūfun","Full of Kindness","বড়ই দয়ালু"],["رَّحِيمٌۭ","raḥīmun","Most Merciful","পরম দয়ালু"]],"t":"وَكَ<m>ذَٰ</>لِكَ جَعَلْ<m>نَٰ</>كُمْ أُ<g>مَّ</><d>ةًۭ وَ</>سَ<w>طًۭا لِّ</>تَكُونُو<s>ا۟</> شُهَ<o>دَآ</>ءَ عَلَى <h>ٱ</><l>ل</><g>نَّ</>اسِ وَيَكُونَ <h>ٱ</><l>ل</>رَّسُولُ عَلَيْكُمْ شَهِي<d>دًۭا ۗ وَ</>مَا جَعَلْنَا <h>ٱ</>لْقِ<q>بْ</>لَةَ <h>ٱ</>لَّتِى كُ<k>نتَ</> عَلَيْ<o>هَآ</> إِلَّا لِنَعْلَمَ <d>مَن يَ</>تَّبِعُ <h>ٱ</><l>ل</>رَّسُولَ مِ<g>مَّ</><d>ن يَ</><k>نقَ</>لِبُ عَلَىٰ عَقِبَيْهِ ۚ وَإِ<k>ن كَ</>انَتْ لَكَبِيرَةً إِلَّا عَلَى <h>ٱ</>لَّذِينَ هَدَى <h>ٱ</>للَّهُ ۗ وَمَا كَانَ <h>ٱ</>للَّهُ لِيُضِيعَ إِي<m>مَٰ</>نَكُمْ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ بِ<h>ٱ</><l>ل</><g>نَّ</>اسِ لَرَءُو<w>فٌۭ رَّ</><p>حِي</>مٌۭ"},{"n":144,"w":[["قَدْ","qad","Indeed","অবশ্যই"],["نَرَىٰ","narā","We see","দেখেছি আমরা"],["تَقَلُّبَ","taqalluba","(the) turning","বার বার ফিরাতে"],["وَجْهِكَ","wajhika","(of) your face","তোমার মুখ"],["فِى","fī","towards","দিকে"],["ٱلسَّمَآءِ ۖ","l-samāi","the heaven","আকাশের"],["فَلَنُوَلِّيَنَّكَ","falanuwalliyannaka","So We will surely turn you","তাই তোমাকে আমরা ঘুরিয়ে দিচ্ছি"],["قِبْلَةًۭ","qib'latan","(to the) direction of prayer","কিবলার (দিকে)"],["تَرْضَىٰهَا ۚ","tarḍāhā","you will be pleased with","যা পছন্দ কর তুমি"],["فَوَلِّ","fawalli","So turn","ফিরাও তাই"],["وَجْهَكَ","wajhaka","your face","তোমার মুখ"],["شَطْرَ","shaṭra","towards the direction","দিকে"],["ٱلْمَسْجِدِ","l-masjidi","(of) Al-Masjid","মাসজিদে"],["ٱلْحَرَامِ ۚ","l-ḥarāmi","Al-Haraam","হারামের"],["وَحَيْثُ","waḥaythu","and wherever","এবং যেখানেই"],["مَا","mā","that","(কি)"],["كُنتُمْ","kuntum","you are","তোমরা থাক"],["فَوَلُّوا۟","fawallū","[so] turn","ফিরাও তখন তোমরা"],["وُجُوهَكُمْ","wujūhakum","your faces","তোমাদের মুখ"],["شَطْرَهُۥ ۗ","shaṭrahu","(in) its direction","তার দিকে"],["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যাদের"],["أُوتُوا۟","ūtū","were given","দেয়া হয়েছ"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","কিতাব"],["لَيَعْلَمُونَ","laya‘lamūna","surely know","তারা জানে অবশ্যই"],["أَنَّهُ","annahu","that it","তা যে"],["ٱلْحَقُّ","l-ḥaqu","(is) the truth","সত্য"],["مِن","min","from","পক্ষ হতে"],["رَّبِّهِمْ ۗ","rabbihim","their Lord","তার রবের"],["وَمَا","wamā","And not","এবং নন"],["ٱللَّهُ","l-lahu","(is) Allah","আল্লাহ্‌"],["بِغَـٰفِلٍ","bighāfilin","unaware","উদাসীন"],["عَمَّا","‘ammā","of what","সে সমন্ধে যা"],["يَعْمَلُونَ","ya‘malūna","they do","তারা করছে"]],"t":"قَ<q>دْ</> نَرَىٰ تَقَلُّبَ وَ<q>جْ</>هِكَ فِى <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ ۖ فَلَنُوَلِّيَ<g>نَّ</>كَ قِ<q>بْ</>لَ<k>ةًۭ تَ</>رْضَ<m>ىٰ</>هَا ۚ فَوَلِّ وَ<q>جْ</>هَكَ شَ<q>طْ</>رَ <h>ٱ</>لْمَسْجِدِ <h>ٱ</>لْحَرَامِ ۚ وَحَيْثُ مَا كُ<k>نتُ</>مْ فَوَلُّو<s>ا۟</> وُجُوهَكُمْ شَ<q>طْ</>رَهُ<m>ۥ</> ۗ وَإِ<g>نَّ</> <h>ٱ</>لَّذِينَ أُوتُو<s>ا۟</> <h>ٱ</>لْكِ<m>تَٰ</>بَ لَيَعْلَمُونَ أَ<g>نَّ</>هُ <h>ٱ</>لْحَقُّ <w>مِن رَّ</>بِّهِمْ ۗ وَمَا <h>ٱ</>للَّهُ بِ<m>غَٰ</>فِلٍ عَ<g>مَّ</>ا يَعْمَ<p>لُو</>نَ"},{"n":145,"w":[["وَلَئِنْ","wala-in","And even if","এবং অবশ্যই যদি"],["أَتَيْتَ","atayta","you come","তুমি আস"],["ٱلَّذِينَ","alladhīna","(to) those who","(তাদেরকে) যাদের"],["أُوتُوا۟","ūtū","were given","দেয়া হয়েছে"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","কিতাব"],["بِكُلِّ","bikulli","with all","সব নিয়ে"],["ءَايَةٍۢ","āyatin","(the) signs","নিদর্শন"],["مَّا","mā","not","(তবুও) না"],["تَبِعُوا۟","tabi‘ū","they would follow","অনুসরণ করবে তারা"],["قِبْلَتَكَ ۚ","qib'lataka","your direction of prayer","তোমার কিবলার"],["وَمَآ","wamā","and not","এবং নও"],["أَنتَ","anta","(will) you (be)","তুমি"],["بِتَابِعٍۢ","bitābi‘in","a follower","অনুসারী"],["قِبْلَتَهُمْ ۚ","qib'latahum","(of) their direction of prayer","তাদের কিবলার"],["وَمَا","wamā","And not","এবং নয়"],["بَعْضُهُم","ba‘ḍuhum","some of them","তাদের কেউ"],["بِتَابِعٍۢ","bitābi‘in","(are) followers","অনুসারী"],["قِبْلَةَ","qib'lata","(of the) direction of prayer","কিবলার"],["بَعْضٍۢ ۚ","ba‘ḍin","(of each) other","কারোর"],["وَلَئِنِ","wala-ini","And if","এবং অবশ্যই যদি"],["ٱتَّبَعْتَ","ittaba‘ta","you followed","তুমি অনুসরণ কর"],["أَهْوَآءَهُم","ahwāahum","their desires","তাদের খেয়াল খুশির"],["مِّنۢ","min","from","থেকে"],["بَعْدِ","ba‘di","after","এর পরও"],["مَا","mā","[what]","যা"],["جَآءَكَ","jāaka","came to you","তোমার কাছে এসেছে"],["مِنَ","mina","of","থেকে"],["ٱلْعِلْمِ ۙ","l-‘il'mi","the knowledge","(সঠিক) জ্ঞান"],["إِنَّكَ","innaka","indeed, you","নিশ্চয়ই তুমি"],["إِذًۭا","idhan","(would) then","তাহলে"],["لَّمِنَ","lamina","(be) surely among","অবশ্যই অন্তর্ভুক্ত"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","সীমালঙ্ঘনকারীদের"]],"t":"وَلَئِنْ أَتَيْتَ <h>ٱ</>لَّذِينَ أُوتُو<s>ا۟</> <h>ٱ</>لْكِ<m>تَٰ</>بَ بِكُلِّ ءَايَ<d>ةٍۢ مَّ</>ا تَبِعُو<s>ا۟</> قِ<q>بْ</>لَتَكَ ۚ وَ<o>مَآ</> أَ<k>نتَ</> بِتَابِ<k>عٍۢ قِ</><q>بْ</>لَتَهُمْ ۚ وَمَا بَعْضُ<f>هُم بِ</>تَابِ<k>عٍۢ قِ</><q>بْ</>لَةَ بَعْ<d>ضٍۢ ۚ وَ</>لَئِنِ <h>ٱ</>تَّبَعْتَ أَهْ<o>وَآ</>ءَ<y>هُم مِّ</><i>نۢ بَ</>عْدِ مَا <o>جَآ</>ءَكَ مِنَ <h>ٱ</>لْعِلْمِ ۙ إِ<g>نَّ</>كَ إِ<w>ذًۭا لَّ</>مِنَ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":146,"w":[["ٱلَّذِينَ","alladhīna","(To) those whom","যারা"],["ءَاتَيْنَـٰهُمُ","ātaynāhumu","We gave [them]","তাদেরকে আমরা দিয়েছি"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","কিতাব"],["يَعْرِفُونَهُۥ","ya‘rifūnahu","they recognize it","তা তারা চিনে"],["كَمَا","kamā","like","যেমন"],["يَعْرِفُونَ","ya‘rifūna","they recognize","তারা চিনে"],["أَبْنَآءَهُمْ ۖ","abnāahum","their sons","তাদের সন্তানদেরকে"],["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["فَرِيقًۭا","farīqan","a group","একদল"],["مِّنْهُمْ","min'hum","of them","তাদের মধ্য হতে"],["لَيَكْتُمُونَ","layaktumūna","surely they conceal","অবশ্যই গোপন করে"],["ٱلْحَقَّ","l-ḥaqa","the Truth","সত্যকে"],["وَهُمْ","wahum","while they","এমতাবস্থায় যে তারা"],["يَعْلَمُونَ","ya‘lamūna","know","জানেও"]],"t":"ٱلَّذِينَ ءَاتَيْ<m>نَٰ</>هُمُ <h>ٱ</>لْكِ<m>تَٰ</>بَ يَعْرِفُونَهُ<m>ۥ</> كَمَا يَعْرِفُونَ أَ<q>بْ</><o>نَآ</>ءَهُمْ ۖ وَإِ<g>نَّ</> فَرِي<d>قًۭا مِّ</>نْهُمْ لَيَكْتُمُونَ <h>ٱ</>لْحَقَّ وَهُمْ يَعْلَ<p>مُو</>نَ"},{"n":147,"w":[["ٱلْحَقُّ","al-ḥaqu","The Truth","প্রকৃত সত্য"],["مِن","min","(is) from","পক্ষ হতে"],["رَّبِّكَ ۖ","rabbika","your Lord","তোমার রবের"],["فَلَا","falā","so (do) not","না তাই"],["تَكُونَنَّ","takūnanna","be","তোমরা হবে"],["مِنَ","mina","among","অন্তর্ভুক্ত"],["ٱلْمُمْتَرِينَ","l-mum'tarīna","the doubters","সন্দেহ পোষণকারীর"]],"t":"ٱلْحَقُّ <w>مِن رَّ</>بِّكَ ۖ فَلَا تَكُونَ<g>نَّ</> مِنَ <h>ٱ</>لْمُمْتَ<p>رِي</>نَ"},{"n":148,"w":[["وَلِكُلٍّۢ","walikullin","And for everyone","এবং প্রত্যেকের জন্য"],["وِجْهَةٌ","wij'hatun","(is) a direction ","একটি দিক (আছে)"],["هُوَ","huwa","he","সে"],["مُوَلِّيهَا ۖ","muwallīhā","turns towards it","মুখ ফিরায় তার দিকে"],["فَٱسْتَبِقُوا۟","fa-is'tabiqū","so race","তোমরা তাই প্রতিযোগিতা করো"],["ٱلْخَيْرَٰتِ ۚ","l-khayrāti","(to) the good","কল্যাণের"],["أَيْنَ","ayna","Wherever","যেখানেই"],["مَا","mā","that","(কি)"],["تَكُونُوا۟","takūnū","you will be","তোমরা থাক"],["يَأْتِ","yati","will bring","আসবেন"],["بِكُمُ","bikumu","you","তোমাদেরকে"],["ٱللَّهُ","l-lahu","(by) Allah","আল্লাহ্‌"],["جَمِيعًا ۚ","jamī‘an","together","সকলকেই (একসাথে)"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["عَلَىٰ","‘alā","(is) on","উপর"],["كُلِّ","kulli","every","সব"],["شَىْءٍۢ","shayin","thing","কিছুর"],["قَدِيرٌۭ","qadīrun","All-Powerful","সর্বশক্তিমান"]],"t":"وَلِكُ<d>لٍّۢ وِ</><q>جْ</>هَةٌ هُوَ مُوَلِّيهَا ۖ فَ<h>ٱ</>سْتَبِقُو<s>ا۟</> <h>ٱ</>لْخَيْ<m>رَٰ</>تِ ۚ أَيْنَ مَا تَكُونُو<s>ا۟</> يَأْتِ بِكُمُ <h>ٱ</>للَّهُ جَمِيعًا ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ عَلَىٰ كُلِّ <k>شَىْءٍۢ قَ</><p>دِي</>رٌۭ"},{"n":149,"w":[["وَمِنْ","wamin","And from","এবং থেকেই"],["حَيْثُ","ḥaythu","wherever","যেখান"],["خَرَجْتَ","kharajta","you start forth","তুমি বের হও"],["فَوَلِّ","fawalli","[so] turn","তখন ফিরাও"],["وَجْهَكَ","wajhaka","your face","তোমার মুখ"],["شَطْرَ","shaṭra","(in the) direction","দিকে"],["ٱلْمَسْجِدِ","l-masjidi","(of) Al-Masjid","মাসজিদে"],["ٱلْحَرَامِ ۖ","l-ḥarāmi","Al-Haraam","হারামের"],["وَإِنَّهُۥ","wa-innahu","And indeed, it","এবং তা নিশ্চয়ই"],["لَلْحَقُّ","lalḥaqqu","(is) surely the truth","অবশ্যই সত্য"],["مِن","min","from","পক্ষ হতে"],["رَّبِّكَ ۗ","rabbika","your Lord","তোমার রবের"],["وَمَا","wamā","And not","এবং নন"],["ٱللَّهُ","l-lahu","(is) Allah","আল্লাহ্‌"],["بِغَـٰفِلٍ","bighāfilin","unaware","উদাসীন"],["عَمَّا","‘ammā","of what","তা হতে যা"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা করেছ"]],"t":"وَمِنْ حَيْثُ خَرَ<q>جْ</>تَ فَوَلِّ وَ<q>جْ</>هَكَ شَ<q>طْ</>رَ <h>ٱ</>لْمَسْجِدِ <h>ٱ</>لْحَرَامِ ۖ وَإِ<g>نَّ</>هُ<m>ۥ</> لَلْحَقُّ <w>مِن رَّ</>بِّكَ ۗ وَمَا <h>ٱ</>للَّهُ بِ<m>غَٰ</>فِلٍ عَ<g>مَّ</>ا تَعْمَ<p>لُو</>نَ"},{"n":150,"w":[["وَمِنْ","wamin","And from","এবং হতেই"],["حَيْثُ","ḥaythu","wherever","যেখান"],["خَرَجْتَ","kharajta","you start forth","তুমি বের হও"],["فَوَلِّ","fawalli","[so] turn","তুমি তখন ফিরাও"],["وَجْهَكَ","wajhaka","your face","তোমার মুখ"],["شَطْرَ","shaṭra","(in the) direction","দিকে"],["ٱلْمَسْجِدِ","l-masjidi","(of) Al-Masjid","মসজিদে"],["ٱلْحَرَامِ ۚ","l-ḥarāmi","Al-Haraam","হারামের"],["وَحَيْثُ","waḥaythu","And wherever","এবং যেখানেই"],["مَا","mā","that","(কি)"],["كُنتُمْ","kuntum","you (all) are","তোমরা থাক"],["فَوَلُّوا۟","fawallū","[so] turn","তোমরা তখন ফিরাবে"],["وُجُوهَكُمْ","wujūhakum","your faces","তোমাদের মুখ"],["شَطْرَهُۥ","shaṭrahu","(in) its direction","তার দিকে"],["لِئَلَّا","li-allā","so that not","না যেন"],["يَكُونَ","yakūna","will be","হয়"],["لِلنَّاسِ","lilnnāsi","for the people","মানুষের জন্য"],["عَلَيْكُمْ","‘alaykum","against you","তোমাদের বিরুদ্ধে"],["حُجَّةٌ","ḥujjatun","any argument","কোন প্রমাণ"],["إِلَّا","illā","except","তবে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ظَلَمُوا۟","ẓalamū","wronged","সীমালঙ্ঘন করেছে"],["مِنْهُمْ","min'hum","among them","তাদের মধ্যে থেকে (তাদের কথা ভিন্ন)"],["فَلَا","falā","so (do) not","না তাই"],["تَخْشَوْهُمْ","takhshawhum","fear them","ভয় কর তাদেরকে"],["وَٱخْشَوْنِى","wa-ikh'shawnī","but fear Me","বরং তোমরা আমাকেই ভয় করো"],["وَلِأُتِمَّ","wali-utimma","And that I complete","এবং আমি পূর্ণ করি যেন"],["نِعْمَتِى","ni‘'matī","My favor","আমার অনুগ্রহ"],["عَلَيْكُمْ","‘alaykum","upon you","তোমাদের উপর"],["وَلَعَلَّكُمْ","wala‘allakum","[and] so that you may","ও আশা করা যায় তোমরা"],["تَهْتَدُونَ","tahtadūna","(be) guided","সঠিক পথে চলবে"]],"t":"وَمِنْ حَيْثُ خَرَ<q>جْ</>تَ فَوَلِّ وَ<q>جْ</>هَكَ شَ<q>طْ</>رَ <h>ٱ</>لْمَسْجِدِ <h>ٱ</>لْحَرَامِ ۚ وَحَيْثُ مَا كُ<k>نتُ</>مْ فَوَلُّو<s>ا۟</> وُجُوهَكُمْ شَ<q>طْ</>رَهُ<m>ۥ</> لِئَلَّا يَكُونَ لِل<g>نَّ</>اسِ عَلَيْكُمْ حُجَّةٌ إِلَّا <h>ٱ</>لَّذِينَ ظَلَمُو<s>ا۟</> مِنْهُمْ فَلَا تَخْشَوْهُمْ وَ<h>ٱ</>خْشَوْنِى وَلِأُتِ<g>مَّ</> نِعْمَتِى عَلَيْكُمْ وَلَعَلَّكُمْ تَهْتَ<p>دُو</>نَ"},{"n":151,"w":[["كَمَآ","kamā","As","যেমন"],["أَرْسَلْنَا","arsalnā","We sent","আমরা প্রেরণ করেছি"],["فِيكُمْ","fīkum","among you","তোমাদের মধ্যে"],["رَسُولًۭا","rasūlan","a Messenger","একজন রাসূল"],["مِّنكُمْ","minkum","from you","তোমাদের মধ্য হতে"],["يَتْلُوا۟","yatlū","(who) recites","সে তিলাওয়াত করে"],["عَلَيْكُمْ","‘alaykum","to you","তোমাদের কাছে"],["ءَايَـٰتِنَا","āyātinā","Our verses","আমাদের আয়াত সমূহ"],["وَيُزَكِّيكُمْ","wayuzakkīkum","and purifies you","ও তোমাদেরকে পরিশুদ্ধ করে"],["وَيُعَلِّمُكُمُ","wayu‘allimukumu","and teaches you","এবং তোমাদেরকে শিক্ষা দেয়"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","কিতাব"],["وَٱلْحِكْمَةَ","wal-ḥik'mata","and the wisdom","ও প্রজ্ঞা"],["وَيُعَلِّمُكُم","wayu‘allimukum","and teaches you","আর তোমাদেরকে শিক্ষা দেয়"],["مَّا","mā","what","যা"],["لَمْ","lam","not","না"],["تَكُونُوا۟","takūnū","you were","তোমরা থাক"],["تَعْلَمُونَ","ta‘lamūna","knowing","জানতে"]],"t":"كَ<o>مَآ</> أَرْسَلْنَا فِيكُمْ رَسُولًۭ<d>ا مِّ</><k>نكُ</>مْ يَتْلُو<s>ا۟</> عَلَيْكُمْ ءَا<m>يَٰ</>تِنَا وَيُزَكِّيكُمْ وَيُعَلِّمُكُمُ <h>ٱ</>لْكِ<m>تَٰ</>بَ وَ<h>ٱ</>لْحِكْمَةَ وَيُعَلِّمُ<y>كُم مَّ</>ا لَمْ تَكُونُو<s>ا۟</> تَعْلَ<p>مُو</>نَ"},{"n":152,"w":[["فَٱذْكُرُونِىٓ","fa-udh'kurūnī","So remember Me","সুতরাং স্মরণ করো তোমরা আমাকে"],["أَذْكُرْكُمْ","adhkur'kum","I will remember you","আমি স্মরণ করব তোমাদেরকে"],["وَٱشْكُرُوا۟","wa-ush'kurū","and be grateful","এবং কৃতজ্ঞতা প্রকাশ করো"],["لِى","lī","to Me","আমার প্রতি"],["وَلَا","walā","and (do) not","এবং না"],["تَكْفُرُونِ","takfurūni","(be) ungrateful to Me","তোমরা অকৃতজ্ঞ হয়ো"]],"t":"فَ<h>ٱ</>ذْكُرُو<o>نِىٓ</> أَذْكُرْكُمْ وَ<h>ٱ</>شْكُرُو<s>ا۟</> لِى وَلَا تَكْفُ<p>رُو</>نِ"},{"n":153,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you","হে"],["ٱلَّذِينَ","alladhīna","who","যারা"],["ءَامَنُوا۟","āmanū","believe[d]","ঈমান এনেছ"],["ٱسْتَعِينُوا۟","is'ta‘īnū","Seek help","তোমরা সাহায্য চাও"],["بِٱلصَّبْرِ","bil-ṣabri","through patience","ধৈর্য্য দ্বারা"],["وَٱلصَّلَوٰةِ ۚ","wal-ṣalati","and the prayer","ও সলাতের (মাধ্যমে)"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ (আছেন)"],["مَعَ","ma‘a","(is) with","সাথে"],["ٱلصَّـٰبِرِينَ","l-ṣābirīna","the patient ones","ধৈর্যশীলদের"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> <h>ٱ</>سْتَعِينُو<s>ا۟</> بِ<h>ٱ</><l>ل</>صَّ<q>بْ</>رِ وَ<h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةِ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ مَعَ <h>ٱ</><l>ل</><m>صَّٰ</>بِ<p>رِي</>نَ"},{"n":154,"w":[["وَلَا","walā","And (do) not","এবং না"],["تَقُولُوا۟","taqūlū","say","তোমরা বলো"],["لِمَن","liman","for (the ones) who","(তাদের) যারা"],["يُقْتَلُ","yuq'talu","are slain","নিহত হয়"],["فِى","fī","in","মধ্যে"],["سَبِيلِ","sabīli","(the) way","পথে"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["أَمْوَٰتٌۢ ۚ","amwātun","(They are) dead","''মৃত"],["بَلْ","bal","Nay","বরং"],["أَحْيَآءٌۭ","aḥyāon","(they are) alive","তারা জীবিত"],["وَلَـٰكِن","walākin","[and] but","কিন্তু"],["لَّا","lā","you (do) not","না"],["تَشْعُرُونَ","tash‘urūna","perceive","তোমরা অনুভব কর"]],"t":"وَلَا تَقُولُو<s>ا۟</> لِ<d>مَن يُ</><q>قْ</>تَلُ فِى سَبِيلِ <h>ٱ</>للَّهِ أَمْ<m>وَٰ</><i>تٌۢ ۚ بَ</>لْ أَحْ<o>يَآ</><d>ءٌۭ وَ</><m>لَٰ</><w>كِن لَّ</>ا تَشْعُ<p>رُو</>نَ"},{"n":155,"w":[["وَلَنَبْلُوَنَّكُم","walanabluwannakum","And surely We will test you","এবং তোমাদের অবশ্যই পরীক্ষা করব আমরা"],["بِشَىْءٍۢ","bishayin","with something","কিছু জিনিস দিয়ে"],["مِّنَ","mina","of","যেমন"],["ٱلْخَوْفِ","l-khawfi","[the] fear","ভয়"],["وَٱلْجُوعِ","wal-jū‘i","and [the] hunger","ও ক্ষুধা"],["وَنَقْصٍۢ","wanaqṣin","and loss","ও ক্ষয়ক্ষতি"],["مِّنَ","mina","of","কিছু"],["ٱلْأَمْوَٰلِ","l-amwāli","[the] wealth","ধনসম্পদের"],["وَٱلْأَنفُسِ","wal-anfusi","and [the] lives","ও জীবনের"],["وَٱلثَّمَرَٰتِ ۗ","wal-thamarāti","and [the] fruits","ও ফল ফসলাদির"],["وَبَشِّرِ","wabashiri","but give good news","এবং সুসংবাদ দাও"],["ٱلصَّـٰبِرِينَ","l-ṣābirīna","(to) the patient ones","(ঐসব) ধৈর্যশীলদের"]],"t":"وَلَنَ<q>بْ</>لُوَ<g>نَّ</><f>كُم بِ</><d>شَىْءٍۢ مِّ</>نَ <h>ٱ</>لْخَوْفِ وَ<h>ٱ</>لْجُوعِ وَنَ<q>قْ</><d>صٍۢ مِّ</>نَ <h>ٱ</>لْأَمْ<m>وَٰ</>لِ وَ<h>ٱ</>لْأَ<k>نفُ</>سِ وَ<h>ٱ</><l>ل</>ثَّمَ<m>رَٰ</>تِ ۗ وَبَشِّرِ <h>ٱ</><l>ل</><m>صَّٰ</>بِ<p>رِي</>نَ"},{"n":156,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["إِذَآ","idhā","when","যখন"],["أَصَـٰبَتْهُم","aṣābathum","strikes them","তাদের উপর এসে পড়ে"],["مُّصِيبَةٌۭ","muṣībatun","a misfortune","কোনো বিপদ"],["قَالُوٓا۟","qālū","they say","(তখন) তারা বলে"],["إِنَّا","innā","Indeed, we","''নিশ্চয়ই আমরা"],["لِلَّهِ","lillahi","belong to Allah","আল্লাহরই জন্যে"],["وَإِنَّآ","wa-innā","and indeed we","ও নিশ্চয়ই আমরা"],["إِلَيْهِ","ilayhi","towards Him","তাঁরই দিকে"],["رَٰجِعُونَ","rāji‘ūna","will return","প্রত্যাবর্তনকারী''"]],"t":"ٱلَّذِينَ إِ<o>ذَآ</> أَ<m>صَٰ</>بَتْ<y>هُم مُّ</>صِيبَ<k>ةٌۭ قَ</>ا<o>لُوٓ</><s>ا۟</> إِ<g>نَّ</>ا لِلَّهِ وَإِ<g>نَّ</><o>آ</> إِلَيْهِ <m>رَٰ</>جِ<p>عُو</>نَ"},{"n":157,"w":[["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব লোক"],["عَلَيْهِمْ","‘alayhim","on them","তাদের উপর (রয়েছে)"],["صَلَوَٰتٌۭ","ṣalawātun","(are) blessings","বিপুল অনুগ্রহ"],["مِّن","min","from","পক্ষ হতে"],["رَّبِّهِمْ","rabbihim","their Lord","তাদের রবের"],["وَرَحْمَةٌۭ ۖ","waraḥmatun","and Mercy","এবং দয়া"],["وَأُو۟لَـٰٓئِكَ","wa-ulāika","And those","ঐসব লোক"],["هُمُ","humu","[they]","তারাই"],["ٱلْمُهْتَدُونَ","l-muh'tadūna","(are) the guided ones","সঠিক পথপ্রাপ্ত"]],"t":"أُ<s>و۟</><o>لَٰٓ</>ئِكَ عَلَيْهِمْ صَلَ<m>وَٰ</><d>تٌۭ مِّ</><w>ن رَّ</>بِّهِمْ وَرَحْمَ<d>ةٌۭ ۖ وَ</>أُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</>لْمُهْتَ<p>دُو</>نَ"},{"n":158,"w":[["۞ إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلصَّفَا","l-ṣafā","the Safa","সাফা"],["وَٱلْمَرْوَةَ","wal-marwata","and the Marwah","ও মারওয়া"],["مِن","min","(are) from","অন্তর্ভুক্ত"],["شَعَآئِرِ","sha‘āiri","(the) symbols","নিদর্শনসমূহের"],["ٱللَّهِ ۖ","l-lahi","(of) Allah","আল্লাহর"],["فَمَنْ","faman","So whoever","সুতরাং যে"],["حَجَّ","ḥajja","performs Hajj","হজ্জ করবে"],["ٱلْبَيْتَ","l-bayta","(of) the House","(কাবা) ঘরের"],["أَوِ","awi","or","বা"],["ٱعْتَمَرَ","i‘'tamara","performs Umrah","ওমরা করবে"],["فَلَا","falā","so no","সেক্ষেত্রে নেই"],["جُنَاحَ","junāḥa","blame","কোনো পাপ"],["عَلَيْهِ","‘alayhi","on him","তার জন্য"],["أَن","an","that","যে"],["يَطَّوَّفَ","yaṭṭawwafa","he walks","সে প্রদক্ষিণ করবে"],["بِهِمَا ۚ","bihimā","between [both of] them","তার দুইয়ের (মাঝে)"],["وَمَن","waman","And whoever","আর যে কেউ"],["تَطَوَّعَ","taṭawwa‘a","voluntarily does","স্বেচ্ছায় করে"],["خَيْرًۭا","khayran","good","কোনো কল্যাণ"],["فَإِنَّ","fa-inna","then indeed","নিশ্চয়ই তবে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["شَاكِرٌ","shākirun","(is) All-Appreciative","(তার) মূল্যদানকারী"],["عَلِيمٌ","‘alīmun","All-Knowing","খুব অবহিত"]],"t":"۞ إِ<g>نَّ</> <h>ٱ</><l>ل</>صَّفَا وَ<h>ٱ</>لْمَرْوَةَ مِ<k>ن شَ</><o>عَآ</>ئِرِ <h>ٱ</>للَّهِ ۖ فَمَنْ حَجَّ <h>ٱ</>لْبَيْتَ أَوِ <h>ٱ</>عْتَمَرَ فَلَا جُنَاحَ عَلَيْهِ <d>أَن يَ</>طَّوَّفَ بِهِمَا ۚ وَمَ<k>ن تَ</>طَوَّعَ خَيْ<k>رًۭا فَ</>إِ<g>نَّ</> <h>ٱ</>للَّهَ شَاكِرٌ عَ<p>لِي</>مٌ"},{"n":159,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["يَكْتُمُونَ","yaktumūna","conceal","গোপন করে"],["مَآ","mā","what","যা"],["أَنزَلْنَا","anzalnā","We revealed","আমরা অবতীর্ণ করেছি"],["مِنَ","mina","of","থেকে"],["ٱلْبَيِّنَـٰتِ","l-bayināti","the clear proofs","স্পষ্ট নিদর্শনাদি"],["وَٱلْهُدَىٰ","wal-hudā","and the Guidance","ও পথনির্দেশ"],["مِنۢ","min","from","থেকে"],["بَعْدِ","ba‘di","after","এর পরও"],["مَا","mā","[what]","যা"],["بَيَّنَّـٰهُ","bayyannāhu","We made clear","তা স্পষ্ট বর্ণনা করেছি আমরা"],["لِلنَّاسِ","lilnnāsi","to the people","মানুষের জন্যে"],["فِى","fī","in","মধ্যে"],["ٱلْكِتَـٰبِ ۙ","l-kitābi","the Book ","কিতাবের"],["أُو۟لَـٰٓئِكَ","ulāika","those","ঐসব লোক"],["يَلْعَنُهُمُ","yal‘anuhumu","curses them","তাদেরকে অভিশাপ দেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["وَيَلْعَنُهُمُ","wayal‘anuhumu","and curse them","ও তাদেরকে অভিশাপ দেয়"],["ٱللَّـٰعِنُونَ","l-lā‘inūna","the ones who curse","অভিশাপকারীরা"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ يَكْتُمُونَ <o>مَآ</> أَ<k>نزَ</>لْنَا مِنَ <h>ٱ</>لْبَيِّ<m>نَٰ</>تِ وَ<h>ٱ</>لْهُدَىٰ <i>مِنۢ بَ</>عْدِ مَا بَيَّ<g>نَّٰ</>هُ لِل<g>نَّ</>اسِ فِى <h>ٱ</>لْكِ<m>تَٰ</>بِ ۙ أُ<s>و۟</><o>لَٰٓ</>ئِكَ يَلْعَنُهُمُ <h>ٱ</>للَّهُ وَيَلْعَنُهُمُ <h>ٱ</><l>ل</><m>لَّٰ</>عِ<p>نُو</>نَ"},{"n":160,"w":[["إِلَّا","illā","Except","ছাড়া"],["ٱلَّذِينَ","alladhīna","those","(তাদের) যারা"],["تَابُوا۟","tābū","who repent[ed]","তওবা করেছে"],["وَأَصْلَحُوا۟","wa-aṣlaḥū","and reform[ed]","ও সংশোধিত হয়েছে"],["وَبَيَّنُوا۟","wabayyanū","and openly declar[ed]","এবং (স্পষ্টভাবে সত্য) বর্ণনা করেছে"],["فَأُو۟لَـٰٓئِكَ","fa-ulāika","Then those","অতঃপর ঐসবলোক"],["أَتُوبُ","atūbu","I will accept repentance","আমি ক্ষমা করব"],["عَلَيْهِمْ ۚ","‘alayhim","from them","তাদের উপর"],["وَأَنَا","wa-anā","and I (am)","এবং আমি"],["ٱلتَّوَّابُ","l-tawābu","the Acceptor of Repentance","বড় ক্ষমাশীল"],["ٱلرَّحِيمُ","l-raḥīmu","the Most Merciful","পরমদয়ালু"]],"t":"إِلَّا <h>ٱ</>لَّذِينَ تَابُو<s>ا۟</> وَأَصْلَحُو<s>ا۟</> وَبَيَّنُو<s>ا۟</> فَأُ<s>و۟</><o>لَٰٓ</>ئِكَ أَتُوبُ عَلَيْهِمْ ۚ وَأَنَا <h>ٱ</><l>ل</>تَّوَّابُ <h>ٱ</><l>ل</>رَّ<p>حِي</>مُ"},{"n":161,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieve[d]","অবিশ্বাস করেছে"],["وَمَاتُوا۟","wamātū","and die[d]","ও মরে গেছে"],["وَهُمْ","wahum","while they","এ অবস্থায় যে তারা"],["كُفَّارٌ","kuffārun","(were) disbelievers","কাফির (ছিল)"],["أُو۟لَـٰٓئِكَ","ulāika","those","ঐসব লোক"],["عَلَيْهِمْ","‘alayhim","on them","তাদের উপর"],["لَعْنَةُ","la‘natu","(is the) curse","অভিশাপ"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَٱلْمَلَـٰٓئِكَةِ","wal-malāikati","and the Angels","ও ফেরেশতাদের"],["وَٱلنَّاسِ","wal-nāsi","and the mankind","ও মানুষের"],["أَجْمَعِينَ","ajma‘īna","all together","সকলেরই"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> وَمَاتُو<s>ا۟</> وَهُمْ كُفَّارٌ أُ<s>و۟</><o>لَٰٓ</>ئِكَ عَلَيْهِمْ لَعْنَةُ <h>ٱ</>للَّهِ وَ<h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةِ وَ<h>ٱ</><l>ل</><g>نَّ</>اسِ أَ<q>جْ</>مَ<p>عِي</>نَ"},{"n":162,"w":[["خَـٰلِدِينَ","khālidīna","(Will) abide forever","তারা চিরস্থায়ী হবে"],["فِيهَا ۖ","fīhā","in it","তার মধ্যে"],["لَا","lā","Not","না"],["يُخَفَّفُ","yukhaffafu","will be lightened","কমানো হবে"],["عَنْهُمُ","‘anhumu","for them","তাদের থেকে"],["ٱلْعَذَابُ","l-‘adhābu","the punishment","শাস্তি"],["وَلَا","walā","and not","আর না"],["هُمْ","hum","they","তাদের"],["يُنظَرُونَ","yunẓarūna","will be reprieved","অবকাশ দেয়া হবে"]],"t":"<m>خَٰ</>لِدِينَ فِيهَا ۖ لَا يُخَفَّفُ عَنْهُمُ <h>ٱ</>لْعَذَابُ وَلَا هُمْ يُ<k>نظَ</><p>رُو</>نَ"},{"n":163,"w":[["وَإِلَـٰهُكُمْ","wa-ilāhukum","And your God","এবং তোমাদের ইলাহ"],["إِلَـٰهٌۭ","ilāhun","(is) God","ইলাহ"],["وَٰحِدٌۭ ۖ","wāḥidun","one (only)","একই"],["لَّآ","lā","(there is) no","নেই"],["إِلَـٰهَ","ilāha","god","কোনো ইলাহ"],["إِلَّا","illā","except","ছাড়া"],["هُوَ","huwa","Him","তিনি"],["ٱلرَّحْمَـٰنُ","l-raḥmānu","the Most Gracious","করুণাময়"],["ٱلرَّحِيمُ","l-raḥīmu","the Most Merciful","পরমদয়ালু"]],"t":"وَإِ<m>لَٰ</>هُكُمْ إِ<m>لَٰ</><d>هٌۭ وَٰ</>حِ<w>دٌۭ ۖ لَّ</><o>آ</> إِ<m>لَٰ</>هَ إِلَّا هُوَ <h>ٱ</><l>ل</>رَّحْ<m>مَٰ</>نُ <h>ٱ</><l>ل</>رَّ<p>حِي</>مُ"},{"n":164,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে (আছে)"],["خَلْقِ","khalqi","(the) creation","সৃষ্টির"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশ মন্ডলীর"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীর"],["وَٱخْتِلَـٰفِ","wa-ikh'tilāfi","and alternation","ও পরিবর্তনের"],["ٱلَّيْلِ","al-layli","of the night","রাতের"],["وَٱلنَّهَارِ","wal-nahāri","and the day","ও দিনের"],["وَٱلْفُلْكِ","wal-ful'ki","and the ships","ও নৌযানসমূহে"],["ٱلَّتِى","allatī","which","যা"],["تَجْرِى","tajrī","sail","চলে"],["فِى","fī","in","মধ্যে"],["ٱلْبَحْرِ","l-baḥri","the sea","সাগরের"],["بِمَا","bimā","with what","তা নিয়ে"],["يَنفَعُ","yanfa‘u","benefits","উপকার দেয়"],["ٱلنَّاسَ","l-nāsa","[the] people","মানুষের"],["وَمَآ","wamā","and what","এবং যা কিছু"],["أَنزَلَ","anzala","(has) sent down","বর্ষণ করে"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["مِنَ","mina","from","থেকে"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশ"],["مِن","min","[of]","থেকে"],["مَّآءٍۢ","māin","water","পানি"],["فَأَحْيَا","fa-aḥyā","giving life","অতপর জীবিত করেন"],["بِهِ","bihi","thereby","তা দিয়ে"],["ٱلْأَرْضَ","l-arḍa","(to) the earth","জমিনকে"],["بَعْدَ","ba‘da","after","পর"],["مَوْتِهَا","mawtihā","its death","তার মৃত্যুর"],["وَبَثَّ","wabatha","and dispersing","ও বিস্তার ঘটান"],["فِيهَا","fīhā","therein","তার মধ্যে"],["مِن","min","[of]","থেকে"],["كُلِّ","kulli","every","সব (রকমের)"],["دَآبَّةٍۢ","dābbatin","moving creature","প্রাণী"],["وَتَصْرِيفِ","wataṣrīfi","and directing","ও প্রবাহে"],["ٱلرِّيَـٰحِ","l-riyāḥi","(of) the winds","বাতাসের"],["وَٱلسَّحَابِ","wal-saḥābi","and the clouds","ও মেঘমালার"],["ٱلْمُسَخَّرِ","l-musakhari","[the] controlled","(যা) নিয়ন্ত্রিত"],["بَيْنَ","bayna","between","মাঝে"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশের"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীর"],["لَـَٔايَـٰتٍۢ","laāyātin","surely (are) Signs","অবশ্যই নিদর্শনাদি"],["لِّقَوْمٍۢ","liqawmin","for a people","সম্প্রদায়ের জন্যে(রয়েছে)"],["يَعْقِلُونَ","ya‘qilūna","who use their intellect","(যারা) জ্ঞান রাখে"]],"t":"إِ<g>نَّ</> فِى خَلْقِ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ وَ<h>ٱ</>خْتِ<m>لَٰ</>فِ <h>ٱ</>لَّيْلِ وَ<h>ٱ</><l>ل</><g>نَّ</>هَارِ وَ<h>ٱ</>لْفُلْكِ <h>ٱ</>لَّتِى تَ<q>جْ</>رِى فِى <h>ٱ</>لْبَحْرِ بِمَا يَ<k>نفَ</>عُ <h>ٱ</><l>ل</><g>نَّ</>اسَ وَ<o>مَآ</> أَ<k>نزَ</>لَ <h>ٱ</>للَّهُ مِنَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ <d>مِن مَّ</><o>آ</><k>ءٍۢ فَ</>أَحْيَا بِهِ <h>ٱ</>لْأَرْضَ بَعْدَ مَوْتِهَا وَبَثَّ فِيهَا مِ<k>ن كُ</>لِّ <n>دَآ</>بَّ<d>ةٍۢ وَ</>تَصْرِيفِ <h>ٱ</><l>ل</>رِّ<m>يَٰ</>حِ وَ<h>ٱ</><l>ل</>سَّحَابِ <h>ٱ</>لْمُسَخَّرِ بَيْنَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ وَ<h>ٱ</>لْأَرْضِ لَءَا<m>يَٰ</><w>تٍۢ لِّ</>قَوْ<d>مٍۢ يَ</>عْقِ<p>لُو</>نَ"},{"n":165,"w":[["وَمِنَ","wamina","And among","কিন্তু মধ্যে"],["ٱلنَّاسِ","l-nāsi","the mankind","মানুষের (এমনও আছে)"],["مَن","man","who","যারা"],["يَتَّخِذُ","yattakhidhu","takes","গ্রহণ করে"],["مِن","min","from","থেকে(দিয়ে)"],["دُونِ","dūni","besides","বাদ"],["ٱللَّهِ","l-lahi","Allah","আল্লাহকে"],["أَندَادًۭا","andādan","equals","(অন্যকে) সমতুল্যরূপে"],["يُحِبُّونَهُمْ","yuḥibbūnahum","They love them","তাদেরকে তারা ভালবাসে"],["كَحُبِّ","kaḥubbi","as (they should) love","মতো ভালবাসার"],["ٱللَّهِ ۖ","l-lahi","Allah","আল্লাহর (প্রতি হওয়া উচিৎ)"],["وَٱلَّذِينَ","wa-alladhīna","And those who","অথচ যারা"],["ءَامَنُوٓا۟","āmanū","believe[d]","ঈমান আনে (তাদের রয়েছে)"],["أَشَدُّ","ashaddu","(are) stronger","সবচেয়ে দৃঢ়"],["حُبًّۭا","ḥubban","(in) love","ভালবাসা"],["لِّلَّهِ ۗ","lillahi","for Allah","আল্লাহর জন্যে"],["وَلَوْ","walaw","And if","এবং যদি (আজ)"],["يَرَى","yarā","would see","(ভেবে) দেখত"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ظَلَمُوٓا۟","ẓalamū","wronged","অবিচার করেছে"],["إِذْ","idh","when","যখন"],["يَرَوْنَ","yarawna","they will see","তারা দেখবে"],["ٱلْعَذَابَ","l-‘adhāba","the punishment","শাস্তি (এবং অনুভব করবে)"],["أَنَّ","anna","that","যে"],["ٱلْقُوَّةَ","l-quwata","the power","শক্তি"],["لِلَّهِ","lillahi","(belongs) to Allah","আল্লাহরই জন্য"],["جَمِيعًۭا","jamī‘an","all","সবটুকুই"],["وَأَنَّ","wa-anna","and [that]","এবং এও যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["شَدِيدُ","shadīdu","(is) severe","কঠোর"],["ٱلْعَذَابِ","l-‘adhābi","(in) [the] punishment","শাস্তিদানে"]],"t":"وَمِنَ <h>ٱ</><l>ل</><g>نَّ</>اسِ <d>مَن يَ</>تَّخِذُ مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ أَ<k>ندَ</>ا<d>دًۭا يُ</>حِبُّونَهُمْ كَحُبِّ <h>ٱ</>للَّهِ ۖ وَ<h>ٱ</>لَّذِينَ ءَامَ<o>نُوٓ</><s>ا۟</> أَشَدُّ حُ<w>بًّۭا لِّ</>لَّهِ ۗ وَلَوْ يَرَى <h>ٱ</>لَّذِينَ ظَلَ<o>مُوٓ</><s>ا۟</> إِذْ يَرَوْنَ <h>ٱ</>لْعَذَابَ أَ<g>نَّ</> <h>ٱ</>لْقُوَّةَ لِلَّهِ جَمِي<d>عًۭا وَ</>أَ<g>نَّ</> <h>ٱ</>للَّهَ شَدِيدُ <h>ٱ</>لْعَ<p>ذَا</><q>بِ</>"},{"n":166,"w":[["إِذْ","idh","When","যখন"],["تَبَرَّأَ","tabarra-a","will disown","সম্পর্ক ছিন্ন করবে"],["ٱلَّذِينَ","alladhīna","those who","(তারা) যাদের"],["ٱتُّبِعُوا۟","ittubi‘ū","were followed","অনুসরণ করা হয়েছিল (অর্থাৎ নেতারা)"],["مِنَ","mina","[from]","হতে"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["ٱتَّبَعُوا۟","ittaba‘ū","followed","অনুসরণ করত (অর্থাৎ অনুসারীদের)"],["وَرَأَوُا۟","wara-awū","and they will see","ও দেখবে"],["ٱلْعَذَابَ","l-‘adhāba","the punishment","শাস্তি"],["وَتَقَطَّعَتْ","wataqaṭṭa‘at","[and] will be cut off","বিচ্ছিন্ন হবে"],["بِهِمُ","bihimu","for them","তাদের সাথে"],["ٱلْأَسْبَابُ","l-asbābu","the relations","সকল উপায় উপকরণ(সম্পর্ক)"]],"t":"إِذْ تَبَرَّأَ <h>ٱ</>لَّذِينَ <h>ٱ</>تُّبِعُو<s>ا۟</> مِنَ <h>ٱ</>لَّذِينَ <h>ٱ</>تَّبَعُو<s>ا۟</> وَرَأَوُ<s>ا۟</> <h>ٱ</>لْعَذَابَ وَتَقَطَّعَتْ بِهِمُ <h>ٱ</>لْأَسْ<p>بَا</><q>بُ</>"},{"n":167,"w":[["وَقَالَ","waqāla","And said","এবং বলবে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ٱتَّبَعُوا۟","ittaba‘ū","followed","অনুসরণ করেছিল"],["لَوْ","law","(Only) if","''যদি"],["أَنَّ","anna","[that]","নিশ্চিত (এমন হত)"],["لَنَا","lanā","for us","আমাদের জন্যে"],["كَرَّةًۭ","karratan","a return","একবার (ফিরার সুযোগ)"],["فَنَتَبَرَّأَ","fanatabarra-a","then we will disown","আমরাও তবে সম্পর্ক ছিন্ন করতাম"],["مِنْهُمْ","min'hum","[from] them","তাদের থেকে"],["كَمَا","kamā","as","যেমন (আজ)"],["تَبَرَّءُوا۟","tabarraū","they disown","সম্পর্ক ছিন্ন করেছে তারা"],["مِنَّا ۗ","minnā","[from] us","আমাদের থেকে''"],["كَذَٰلِكَ","kadhālika","Thus","এভাবে"],["يُرِيهِمُ","yurīhimu","will show them","তাদের দেখাবেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["أَعْمَـٰلَهُمْ","a‘mālahum","their deeds","তাদের কাজকর্মগুলোকে"],["حَسَرَٰتٍ","ḥasarātin","(as) regrets","পরিতাপরূপে"],["عَلَيْهِمْ ۖ","‘alayhim","for them","তাদের কাছে"],["وَمَا","wamā","And not","এবং না"],["هُم","hum","they","তারা"],["بِخَـٰرِجِينَ","bikhārijīna","will come out","বহির্গমনকারী"],["مِنَ","mina","from","হতে"],["ٱلنَّارِ","l-nāri","the Fire","(দোযখের) আগুন"]],"t":"وَقَالَ <h>ٱ</>لَّذِينَ <h>ٱ</>تَّبَعُو<s>ا۟</> لَوْ أَ<g>نَّ</> لَنَا كَرَّ<k>ةًۭ فَ</>نَتَبَرَّأَ مِنْهُمْ كَمَا تَبَرَّءُو<s>ا۟</> مِ<g>نَّ</>ا ۗ كَ<m>ذَٰ</>لِكَ يُرِيهِمُ <h>ٱ</>للَّهُ أَعْ<m>مَٰ</>لَهُمْ حَسَ<m>رَٰ</>تٍ عَلَيْهِمْ ۖ وَمَا <f>هُم بِ</><m>خَٰ</>رِجِينَ مِنَ <h>ٱ</><l>ل</><g>نَّ</><p>ا</>رِ"},{"n":168,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O","হে"],["ٱلنَّاسُ","l-nāsu","mankind","মানবজাতি"],["كُلُوا۟","kulū","Eat","তোমরা খাও"],["مِمَّا","mimmā","of what","তা হতে যা"],["فِى","fī","(is) in","মধ্যে (আছে)"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["حَلَـٰلًۭا","ḥalālan","lawful","হালাল"],["طَيِّبًۭا","ṭayyiban","(and) good","পবিত্র"],["وَلَا","walā","And (do) not","এবং না"],["تَتَّبِعُوا۟","tattabi‘ū","follow","তোমরা অনুসরণ করো"],["خُطُوَٰتِ","khuṭuwāti","(the) footsteps (of)","পদাঙ্কগুলোর"],["ٱلشَّيْطَـٰنِ ۚ","l-shayṭāni","the Shaitaan","শয়তানের"],["إِنَّهُۥ","innahu","Indeed, he","সে নিশ্চয়ই"],["لَكُمْ","lakum","(is) to you","তোমাদের জন্যে"],["عَدُوٌّۭ","‘aduwwun","an enemy","শত্রু"],["مُّبِينٌ","mubīnun","clear","প্রকাশ্য"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</><l>ل</><g>نَّ</>اسُ كُلُو<s>ا۟</> مِ<g>مَّ</>ا فِى <h>ٱ</>لْأَرْضِ حَ<m>لَٰ</>لًۭ<k>ا طَ</>يِّ<d>بًۭا وَ</>لَا تَتَّبِعُو<s>ا۟</> خُطُ<m>وَٰ</>تِ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نِ ۚ إِ<g>نَّ</>هُ<m>ۥ</> لَكُمْ عَدُ<d>وٌّۭ مُّ</><p>بِي</>نٌ"},{"n":169,"w":[["إِنَّمَا","innamā","Only","মূলতঃ"],["يَأْمُرُكُم","yamurukum","he commands you","তোমাদেরকে নির্দেশ দেয় সে"],["بِٱلسُّوٓءِ","bil-sūi","to (do) the evil","পাপকাজের প্রতি"],["وَٱلْفَحْشَآءِ","wal-faḥshāi","and the shameful","ও অশ্লীল"],["وَأَن","wa-an","and that","এবং যেন"],["تَقُولُوا۟","taqūlū","you say","তোমরা বল (এমন কথা)"],["عَلَى","‘alā","about","সম্বন্ধে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["مَا","mā","what","যা"],["لَا","lā","not","না"],["تَعْلَمُونَ","ta‘lamūna","you know","তোমরা জান"]],"t":"إِ<g>نَّ</>مَا يَأْمُرُ<f>كُم بِ</><h>ٱ</><l>ل</><o>سُّوٓ</>ءِ وَ<h>ٱ</>لْفَحْ<o>شَآ</>ءِ وَأَ<k>ن تَ</>قُولُو<s>ا۟</> عَلَى <h>ٱ</>للَّهِ مَا لَا تَعْلَ<p>مُو</>نَ"},{"n":170,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["قِيلَ","qīla","it is said","বলা হয়"],["لَهُمُ","lahumu","to them","তাদের"],["ٱتَّبِعُوا۟","ittabi‘ū","Follow","''তোমরা অনুসরণ করো"],["مَآ","mā","what","যা"],["أَنزَلَ","anzala","has revealed","অবতীর্ণ করেছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ''"],["قَالُوا۟","qālū","they said","তারা বলে"],["بَلْ","bal","Nay","''বরং"],["نَتَّبِعُ","nattabi‘u","we follow","আমরা অনুসরণ করব"],["مَآ","mā","what","তা"],["أَلْفَيْنَا","alfaynā","we found","আমরা পেয়েছি"],["عَلَيْهِ","‘alayhi","[on it]","যার উপর"],["ءَابَآءَنَآ ۗ","ābāanā","our forefathers (following)","আমাদের বাপ-দাদাদেরকে"],["أَوَلَوْ","awalaw","Even though","যদিও কি"],["كَانَ","kāna","[were]","ছিল"],["ءَابَآؤُهُمْ","ābāuhum","their forefathers","বাপ দাদারা তাদের (এমন যে)"],["لَا","lā","(did) not","না"],["يَعْقِلُونَ","ya‘qilūna","understand","তারা বুঝতো"],["شَيْـًۭٔا","shayan","anything","কিছুই"],["وَلَا","walā","and not","এবং না"],["يَهْتَدُونَ","yahtadūna","were they guided","তারা সৎ পথে চলত"]],"t":"وَإِذَا قِيلَ لَهُمُ <h>ٱ</>تَّبِعُو<s>ا۟</> <o>مَآ</> أَ<k>نزَ</>لَ <h>ٱ</>للَّهُ قَالُو<s>ا۟</> بَلْ نَتَّبِعُ <o>مَآ</> أَلْفَيْنَا عَلَيْهِ ءَا<o>بَآءَنَآ ۗ</> أَوَلَوْ كَانَ ءَا<o>بَآ</>ؤُهُمْ لَا يَعْقِلُونَ شَ<d>يْـًۭٔا وَ</>لَا يَهْتَ<p>دُو</>نَ"},{"n":171,"w":[["وَمَثَلُ","wamathalu","And (the) example","এবং উপমা"],["ٱلَّذِينَ","alladhīna","(of) those who","(তাদের) যারা"],["كَفَرُوا۟","kafarū","disbelieve[d]","অস্বীকার করেছে"],["كَمَثَلِ","kamathali","(is) like (the) example","এরূপ"],["ٱلَّذِى","alladhī","(of) the one who","(এক রাখাল) যে"],["يَنْعِقُ","yan‘iqu","shouts","(চিৎকার করে)ডাকে"],["بِمَا","bimā","at what","ঐ বিষয় যা"],["لَا","lā","not","না"],["يَسْمَعُ","yasma‘u","(does) hear","শুনে (তার পশু)"],["إِلَّا","illā","except","এ ছাড়া"],["دُعَآءًۭ","du‘āan","calls","হাঁকডাক"],["وَنِدَآءًۭ ۚ","wanidāan","and cries ","ও আওয়াজ"],["صُمٌّۢ","ṣummun","deaf","বধির"],["بُكْمٌ","buk'mun","dumb","বোবা"],["عُمْىٌۭ","‘um'yun","(and) blind","অন্ধ"],["فَهُمْ","fahum","[so] they","তারা তাই (কোনো কথাই)"],["لَا","lā","(do) not","না"],["يَعْقِلُونَ","ya‘qilūna","understand","বুঝতে পারে"]],"t":"وَمَثَلُ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> كَمَثَلِ <h>ٱ</>لَّذِى يَنْعِقُ بِمَا لَا يَسْمَعُ إِلَّا دُ<o>عَآ</><d>ءًۭ وَ</>نِ<o>دَآ</><k>ءًۭ ۚ صُ</><i>مٌّۢ بُ</>كْمٌ عُمْ<k>ىٌۭ فَ</>هُمْ لَا يَعْقِ<p>لُو</>نَ"},{"n":172,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you","হে"],["ٱلَّذِينَ","alladhīna","who","যারা"],["ءَامَنُوا۟","āmanū","believe[d]","ঈমান এনেছ"],["كُلُوا۟","kulū","Eat","তোমরা খাও"],["مِن","min","from","হতে"],["طَيِّبَـٰتِ","ṭayyibāti","(the) good","পবিত্র জিনিসগুলো"],["مَا","mā","(of) what","যা"],["رَزَقْنَـٰكُمْ","razaqnākum","We have provided you","তোমাদের জীবিকা দিয়েছি আমরা"],["وَٱشْكُرُوا۟","wa-ush'kurū","and be grateful","ও তোমরা কৃতজ্ঞতা প্রকাশ করো"],["لِلَّهِ","lillahi","to Allah","আল্লাহর কাছে"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you","তোমরা হও (এমন যে)"],["إِيَّاهُ","iyyāhu","alone","শুধু তাকেই"],["تَعْبُدُونَ","ta‘budūna","worship Him","তোমরা ইবাদাত কর"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> كُلُو<s>ا۟</> مِ<k>ن طَ</>يِّ<m>بَٰ</>تِ مَا رَزَ<q>قْ</><m>نَٰ</>كُمْ وَ<h>ٱ</>شْكُرُو<s>ا۟</> لِلَّهِ إِ<k>ن كُنتُ</>مْ إِيَّاهُ تَعْبُ<p>دُو</>نَ"},{"n":173,"w":[["إِنَّمَا","innamā","Only","মূলতঃ"],["حَرَّمَ","ḥarrama","He has forbidden","(হারাম) করেছেন"],["عَلَيْكُمُ","‘alaykumu","to you","তোমাদের উপর"],["ٱلْمَيْتَةَ","l-maytata","the dead animals","মৃত (জন্তু)"],["وَٱلدَّمَ","wal-dama","and [the] blood","ও (প্রবাহিত) রক্ত"],["وَلَحْمَ","walaḥma","and flesh","মাংস"],["ٱلْخِنزِيرِ","l-khinzīri","(of) swine","শুকরের"],["وَمَآ","wamā","and what","এবং তা"],["أُهِلَّ","uhilla","has been dedicated","নাম নেয়া হয়েছে"],["بِهِۦ","bihi","[with it]","যার উপর"],["لِغَيْرِ","lighayri","to other than","ছাড়া"],["ٱللَّهِ ۖ","l-lahi","Allah","আল্লাহ (অন্য কারো)"],["فَمَنِ","famani","So whoever","যে তবে"],["ٱضْطُرَّ","uḍ'ṭurra","(is) forced by necessity","নিরুপায় হয়ে যায়"],["غَيْرَ","ghayra","without","না"],["بَاغٍۢ","bāghin","(being) disobedient","বিদ্রোহী (হয়ে)"],["وَلَا","walā","and not","আর না"],["عَادٍۢ","‘ādin","transgressor","সীমালংঘনকারী"],["فَلَآ","falā","then no","নেই তবে"],["إِثْمَ","ith'ma","sin","কোনো পাপ"],["عَلَيْهِ ۚ","‘alayhi","on him","তার উপর"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["غَفُورٌۭ","ghafūrun","(is) Oft-Forgiving","বড় ক্ষমাশীল"],["رَّحِيمٌ","raḥīmun","Most Merciful","পরম দয়ালু"]],"t":"إِ<g>نَّ</>مَا حَرَّمَ عَلَيْكُمُ <h>ٱ</>لْمَيْتَةَ وَ<h>ٱ</><l>ل</>دَّمَ وَلَحْمَ <h>ٱ</>لْخِ<k>نزِ</>يرِ وَ<o>مَآ</> أُهِلَّ بِ<m>هِۦ</> لِغَيْرِ <h>ٱ</>للَّهِ ۖ فَمَنِ <h>ٱ</>ضْطُرَّ غَيْرَ بَا<d>غٍۢ وَ</>لَا عَا<k>دٍۢ فَ</><o>لَآ</> إِثْمَ عَلَيْهِ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ غَفُو<w>رٌۭ رَّ</><p>حِي</>مٌ"},{"n":174,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["يَكْتُمُونَ","yaktumūna","conceal","গোপন করে"],["مَآ","mā","what","যা"],["أَنزَلَ","anzala","(has) revealed","অবতীর্ণ করেছেন"],["ٱللَّهُ","l-lahu","Allah (has)","আল্লাহ"],["مِنَ","mina","of","হতে"],["ٱلْكِتَـٰبِ","l-kitābi","the Book","কিতাব"],["وَيَشْتَرُونَ","wayashtarūna","and they purchase","ও তারা কিনে(ক্রয়করে)"],["بِهِۦ","bihi","there with","বিনিময়ে"],["ثَمَنًۭا","thamanan","a gain","মূল্য (অর্থাৎ স্বার্থ)"],["قَلِيلًا ۙ","qalīlan","little","অতি নগণ্য"],["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব লোক"],["مَا","mā","not","না"],["يَأْكُلُونَ","yakulūna","they eat","তারা খায়"],["فِى","fī","in","মধ্যে"],["بُطُونِهِمْ","buṭūnihim","their bellies","তাদের পেটের"],["إِلَّا","illā","except","এছাড়া"],["ٱلنَّارَ","l-nāra","the Fire","আগুন"],["وَلَا","walā","And not","এবং না"],["يُكَلِّمُهُمُ","yukallimuhumu","will speak to them","তাদের সাথে কথা বলবেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["يَوْمَ","yawma","(on the) Day","দিনে"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) [the] Judgment","কিয়ামাতের"],["وَلَا","walā","and not","এবং না"],["يُزَكِّيهِمْ","yuzakkīhim","will He purify them","তাদেরকে পরিশুদ্ধ করবেন"],["وَلَهُمْ","walahum","and for them","ও তাদের জন্যে(রয়েছে)"],["عَذَابٌ","‘adhābun","(is) a punishment","শাস্তি"],["أَلِيمٌ","alīmun","painful","নিদারুণ"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ يَكْتُمُونَ <o>مَآ</> أَ<k>نزَ</>لَ <h>ٱ</>للَّهُ مِنَ <h>ٱ</>لْكِ<m>تَٰ</>بِ وَيَشْتَرُونَ بِ<m>هِۦ</> ثَمَ<k>نًۭا قَ</>لِيلًا ۙ أُ<s>و۟</><o>لَٰٓ</>ئِكَ مَا يَأْكُلُونَ فِى بُطُونِهِمْ إِلَّا <h>ٱ</><l>ل</><g>نَّ</>ارَ وَلَا يُكَلِّمُهُمُ <h>ٱ</>للَّهُ يَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ وَلَا يُزَكِّيهِمْ وَلَهُمْ عَذَابٌ أَ<p>لِي</>مٌ"},{"n":175,"w":[["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব লোক"],["ٱلَّذِينَ","alladhīna","(are) they who","(তারাই) যারা"],["ٱشْتَرَوُا۟","ish'tarawū","purchase[d]","কিনেছে"],["ٱلضَّلَـٰلَةَ","l-ḍalālata","[the] astraying","ভ্রান্তপথ"],["بِٱلْهُدَىٰ","bil-hudā","for [the] Guidance","সঠিকপথের পরিবর্তে"],["وَٱلْعَذَابَ","wal-‘adhāba","and [the] punishment","এবং শাস্তি"],["بِٱلْمَغْفِرَةِ ۚ","bil-maghfirati","for [the] forgiveness","ক্ষমার পরিবর্তে"],["فَمَآ","famā","So what (is)","অতঃপর কতই না"],["أَصْبَرَهُمْ","aṣbarahum","their endurance","ধৈর্যশীল"],["عَلَى","‘alā","on","উপর"],["ٱلنَّارِ","l-nāri","the Fire","আগুনের"]],"t":"أُ<s>و۟</><o>لَٰٓ</>ئِكَ <h>ٱ</>لَّذِينَ <h>ٱ</>شْتَرَوُ<s>ا۟</> <h>ٱ</><l>ل</>ضَّ<m>لَٰ</>لَةَ بِ<h>ٱ</>لْهُدَىٰ وَ<h>ٱ</>لْعَذَابَ بِ<h>ٱ</>لْمَغْفِرَةِ ۚ فَ<o>مَآ</> أَصْبَرَهُمْ عَلَى <h>ٱ</><l>ل</><g>نَّ</><p>ا</>رِ"},{"n":176,"w":[["ذَٰلِكَ","dhālika","That","এটা"],["بِأَنَّ","bi-anna","(is) because","এজন্য যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["نَزَّلَ","nazzala","revealed","অবতীর্ণ করেছেন"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","কিতাব"],["بِٱلْحَقِّ ۗ","bil-ḥaqi","with [the] Truth","সত্য সহকারে"],["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those","যারা"],["ٱخْتَلَفُوا۟","ikh'talafū","who differed","মতভেদ করেছে"],["فِى","fī","in","মধ্যে"],["ٱلْكِتَـٰبِ","l-kitābi","the Book","কিতাবের"],["لَفِى","lafī","(are) surely in","অবশ্যই মধ্যে(আছে)"],["شِقَاقٍۭ","shiqāqin","schism","বিশুদ্ধতার"],["بَعِيدٍۢ","ba‘īdin","far","(প্রকৃত সত্য হতে) বহুদূরে"]],"t":"<m>ذَٰ</>لِكَ بِأَ<g>نَّ</> <h>ٱ</>للَّهَ نَزَّلَ <h>ٱ</>لْكِ<m>تَٰ</>بَ بِ<h>ٱ</>لْحَقِّ ۗ وَإِ<g>نَّ</> <h>ٱ</>لَّذِينَ <h>ٱ</>خْتَلَفُو<s>ا۟</> فِى <h>ٱ</>لْكِ<m>تَٰ</>بِ لَفِى شِقَا<i>قٍۭ بَ</><p>عِي</><q>دٍۢ</>"},{"n":177,"w":[["۞ لَّيْسَ","laysa","It is not","নেই"],["ٱلْبِرَّ","l-bira","[the] righteousness","পূণ্য"],["أَن","an","that","যে"],["تُوَلُّوا۟","tuwallū","you turn","তোমরাও ফেরাবে"],["وُجُوهَكُمْ","wujūhakum","your faces","তোমাদের মুখ"],["قِبَلَ","qibala","towards","দিকে"],["ٱلْمَشْرِقِ","l-mashriqi","the east","পূর্ব"],["وَٱلْمَغْرِبِ","wal-maghribi","and the west","অথবা পশ্চিমে"],["وَلَـٰكِنَّ","walākinna","[and] but","কিন্তু"],["ٱلْبِرَّ","l-bira","the righteous[ness]","পূণ্য (হল)"],["مَنْ","man","(is he) who","যে কেউ"],["ءَامَنَ","āmana","believes","ঈমান আনল"],["بِٱللَّهِ","bil-lahi","in Allah","আল্লাহর প্রতি"],["وَٱلْيَوْمِ","wal-yawmi","and the Day","ও দিনের"],["ٱلْـَٔاخِرِ","l-ākhiri","[the] Last","আখিরাতের"],["وَٱلْمَلَـٰٓئِكَةِ","wal-malāikati","and the Angels","ও ফেরেশতাদের"],["وَٱلْكِتَـٰبِ","wal-