مْلِلْ وَلِيُّهُ<m>ۥ</> بِ<h>ٱ</>لْعَ<q>دْ</>لِ ۚ وَ<h>ٱ</>سْتَشْهِدُو<s>ا۟</> شَهِيدَيْنِ <w>مِن رِّ</>جَالِكُمْ ۖ فَ<w>إِن لَّ</>مْ يَكُونَا رَجُلَيْنِ فَرَجُ<d>لٌۭ وَ</><h>ٱ</>مْرَأَتَانِ مِ<g>مَّ</><k>ن تَ</>رْضَوْنَ مِنَ <h>ٱ</><l>ل</>شُّهَ<o>دَآ</>ءِ أَ<k>ن تَ</>ضِلَّ إِحْدَ<m>ىٰ</>هُمَا فَتُذَكِّرَ إِحْدَ<m>ىٰ</>هُمَا <h>ٱ</>لْأُخْرَىٰ ۚ وَلَا يَأْبَ <h>ٱ</><l>ل</>شُّهَ<o>دَآ</>ءُ إِذَا مَا دُعُو<s>ا۟ ۚ</> وَلَا تَسْـَٔ<o>مُوٓ</><s>ا۟</> أَ<k>ن تَ</>كْتُبُوهُ صَغِيرًا أَوْ كَبِيرًا إِلَ<o>ىٰٓ</> أَجَلِ<m>هِۦ</> ۚ <m>ذَٰ</>لِكُمْ أَ<q>قْ</>سَطُ عِ<k>ندَ</> <h>ٱ</>للَّهِ وَأَ<q>قْ</>وَمُ لِلشَّ<m>هَٰ</>دَةِ وَأَ<q>دْ</>نَ<o>ىٰٓ</> أَلَّا تَرْتَا<o>بُوٓ</><s>ا۟</> ۖ إِ<o>لَّآ</> أَ<k>ن تَ</>كُونَ تِ<m>جَٰ</>رَةً حَاضِرَ<k>ةًۭ تُ</>دِيرُونَهَا بَيْنَكُمْ فَلَيْسَ عَلَيْكُمْ جُنَاحٌ أَلَّا تَكْتُبُوهَا ۗ وَأَشْهِ<o>دُوٓ</><s>ا۟</> إِذَا تَبَايَعْتُمْ ۚ وَلَا يُ<n>ضَآ</>رَّ كَاتِ<d>بٌۭ وَ</>لَا شَهِي<d>دٌۭ ۚ وَ</>إِ<k>ن تَ</>فْعَلُو<s>ا۟</> فَإِ<g>نَّ</>هُ<m>ۥ</> فُسُو<i>قٌۢ بِ</>كُمْ ۗ وَ<h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</>للَّهَ ۖ وَيُعَلِّمُكُمُ <h>ٱ</>للَّهُ ۗ وَ<h>ٱ</>للَّهُ بِكُلِّ شَىْءٍ عَ<p>لِي</>مٌۭ"},{"n":283,"w":[["۞ وَإِن","wa-in","And if","এবং যদি"],["كُنتُمْ","kuntum","you are","তোমরা থাক"],["عَلَىٰ","‘alā","on","মধ্যে"],["سَفَرٍۢ","safarin","a journey","সফরের"],["وَلَمْ","walam","and not","এবং না"],["تَجِدُوا۟","tajidū","you find","তোমরা পাও"],["كَاتِبًۭا","kātiban","a scribe","কোনো লেখক"],["فَرِهَـٰنٌۭ","farihānun","then pledge","তবে বন্ধকি বস্তু"],["مَّقْبُوضَةٌۭ ۖ","maqbūḍatun","in hand","হস্তগত (রাখতে পার)"],["فَإِنْ","fa-in","Then if","অতঃপর যদি"],["أَمِنَ","amina","entrusts","বিশ্বাস করে"],["بَعْضُكُم","ba‘ḍukum","one of you","তোমাদের কেউ"],["بَعْضًۭا","ba‘ḍan","(to) another","অন্যকে"],["فَلْيُؤَدِّ","falyu-addi","then let discharge","তবে সে যেন ফিরেয়ে দেয়"],["ٱلَّذِى","alladhī","the one who","যার (উপর)"],["ٱؤْتُمِنَ","u'tumina","is entrusted","বিশ্বাস করা হয়েছিল"],["أَمَـٰنَتَهُۥ","amānatahu","his trust","তার আমানতের"],["وَلْيَتَّقِ","walyattaqi","And let him fear","এবং সে যেন ভয় করে"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["رَبَّهُۥ ۗ","rabbahu","his Lord","(যিনি) তার রব"],["وَلَا","walā","And (do) not","এবং না"],["تَكْتُمُوا۟","taktumū","conceal","তোমরা গোপন করবে"],["ٱلشَّهَـٰدَةَ ۚ","l-shahādata","the evidence","সাক্ষ্য"],["وَمَن","waman","And whoever","এবং যে"],["يَكْتُمْهَا","yaktum'hā","conceals it","তা গোপন করবে"],["فَإِنَّهُۥٓ","fa-innahu","then indeed he","তাহলে সে নিশ্চয়ই"],["ءَاثِمٌۭ","āthimun","(is) sinful ","পাপী"],["قَلْبُهُۥ ۗ","qalbuhu","his heart","তার অন্তর"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["بِمَا","bimā","of what","সে বিষয়ে"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা কাজ কর"],["عَلِيمٌۭ","‘alīmun","(is) All-Knower","খুব অবহিত"]],"t":"۞ وَإِ<k>ن كُنتُ</>مْ عَلَىٰ سَفَ<d>رٍۢ وَ</>لَمْ تَجِدُو<s>ا۟</> كَاتِ<k>بًۭا فَ</>رِ<m>هَٰ</><d>نٌۭ مَّ</><q>قْ</>بُوضَ<k>ةٌۭ ۖ فَ</>إِنْ أَمِنَ بَعْضُ<f>كُم بَ</>عْ<k>ضًۭا فَ</>لْيُؤَدِّ <h>ٱ</>لَّذِى <h>ٱ</>ؤْتُمِنَ أَ<m>مَٰ</>نَتَهُ<m>ۥ</> وَلْيَتَّقِ <h>ٱ</>للَّهَ رَبَّهُ<m>ۥ</> ۗ وَلَا تَكْتُمُو<s>ا۟</> <h>ٱ</><l>ل</>شَّ<m>هَٰ</>دَةَ ۚ وَ<d>مَن يَ</>كْتُمْهَا فَإِ<g>نَّ</>هُ<o>ۥٓ</> ءَاثِ<k>مٌۭ قَ</>لْبُهُ<m>ۥ</> ۗ وَ<h>ٱ</>للَّهُ بِمَا تَعْمَلُونَ عَ<p>لِي</>مٌۭ"},{"n":284,"w":[["لِّلَّهِ","lillahi","To Allah (belongs)","আল্লাহর জন্য"],["مَا","mā","whatever","যা কিছু"],["فِى","fī","(is) in","মধ্যে (আছে)"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশ সমূহের"],["وَمَا","wamā","and whatever","ও যা কিছু"],["فِى","fī","(is) in","মধ্যে (আছে)"],["ٱلْأَرْضِ ۗ","l-arḍi","the earth","পৃথিবীর"],["وَإِن","wa-in","And if","এবং যদি"],["تُبْدُوا۟","tub'dū","you disclose","তোমরা প্রকাশ কর"],["مَا","mā","what","যা কিছু"],["فِىٓ","fī","(is) in","মধ্যে (আছে)"],["أَنفُسِكُمْ","anfusikum","yourselves","তোমাদের মনের"],["أَوْ","aw","or","অথবা"],["تُخْفُوهُ","tukh'fūhu","you conceal it","গোপন কর তোমরা তা"],["يُحَاسِبْكُم","yuḥāsib'kum","will call you to account","তোমাদেরকে হিসাব নিবেন"],["بِهِ","bihi","for it","তা সম্পর্কে"],["ٱللَّهُ ۖ","l-lahu","Allah","আল্লাহ"],["فَيَغْفِرُ","fayaghfiru","Then, He will forgive","অতঃপর ক্ষমা করবেন"],["لِمَن","liman","[to] whom","যাকে"],["يَشَآءُ","yashāu","He wills","তিনি ইচ্ছা করবেন"],["وَيُعَذِّبُ","wayu‘adhibu","and He will punish","এবং তিনি শাস্তি দিবেন"],["مَن","man","whom","যাকে"],["يَشَآءُ ۗ","yashāu","He wills","তিনি ইচ্ছা করবেন"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["عَلَىٰ","‘alā","on","উপর"],["كُلِّ","kulli","every","সব"],["شَىْءٍۢ","shayin","thing","কিছুর"],["قَدِيرٌ","qadīrun","(is) All-Powerful","সর্বশক্তিমান"]],"t":"لِّلَّهِ مَا فِى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَمَا فِى <h>ٱ</>لْأَرْضِ ۗ وَإِ<k>ن تُ</><q>بْ</>دُو<s>ا۟</> مَا <o>فِىٓ</> أَ<k>نفُ</>سِكُمْ أَوْ تُخْفُوهُ يُحَاسِ<q>بْ</><f>كُم بِ</>هِ <h>ٱ</>للَّهُ ۖ فَيَغْفِرُ لِ<d>مَن يَ</><o>شَآ</>ءُ وَيُعَذِّبُ <d>مَن يَ</><o>شَآ</>ءُ ۗ وَ<h>ٱ</>للَّهُ عَلَىٰ كُلِّ <k>شَىْءٍۢ قَ</><p>دِي</>رٌ"},{"n":285,"w":[["ءَامَنَ","āmana","Believed","ঈমান এনেছে"],["ٱلرَّسُولُ","l-rasūlu","the Messenger","রাসূল"],["بِمَآ","bimā","in what","ঐ বিষয় যা"],["أُنزِلَ","unzila","was revealed","অবতীর্ণ করা হয়েছে"],["إِلَيْهِ","ilayhi","to him","তাঁর প্রতি"],["مِن","min","from","পক্ষ হতে"],["رَّبِّهِۦ","rabbihi","his Lord","তাঁর রবের"],["وَٱلْمُؤْمِنُونَ ۚ","wal-mu'minūna","and the believers","এবং মু'মিনরাও"],["كُلٌّ","kullun","All","সবাই"],["ءَامَنَ","āmana","believed","ঈমান এনেছে"],["بِٱللَّهِ","bil-lahi","in Allah","আল্লাহর উপর"],["وَمَلَـٰٓئِكَتِهِۦ","wamalāikatihi","and His Angels","এবং তাঁর ফেরেশতাদের"],["وَكُتُبِهِۦ","wakutubihi","and His Books","ও তাঁর কিতাবগুলোর"],["وَرُسُلِهِۦ","warusulihi","and His Messengers","এবং তাঁর রাসূলদের (উপর)"],["لَا","lā","Not","(তারা বলে) না"],["نُفَرِّقُ","nufarriqu","we make distinction","আমরা পার্থক্য করি"],["بَيْنَ","bayna","between","মাঝে"],["أَحَدٍۢ","aḥadin","any","কারো"],["مِّن","min","of","মধ্য হতে"],["رُّسُلِهِۦ ۚ","rusulihi","His messengers","তাঁর রাসূলদের"],["وَقَالُوا۟","waqālū","And they said","এবং তারা বলে"],["سَمِعْنَا","sami‘'nā","We heard","আমরা শুনলাম"],["وَأَطَعْنَا ۖ","wa-aṭa‘nā","and we obeyed","এবং আমরা মানলাম"],["غُفْرَانَكَ","ghuf'rānaka","(Grant) us Your forgiveness","আমরা তোমার ক্ষমা (চাই)"],["رَبَّنَا","rabbanā","our Lord","হে আমাদের রব"],["وَإِلَيْكَ","wa-ilayka","and to You","এবং তোমারই কাছে"],["ٱلْمَصِيرُ","l-maṣīru","(is) the return","প্রত্যাবর্তন (হবে)"]],"t":"ءَامَنَ <h>ٱ</><l>ل</>رَّسُولُ بِ<o>مَآ</> أُ<k>نزِ</>لَ إِلَيْهِ <w>مِن رَّ</>بِّ<m>هِۦ</> وَ<h>ٱ</>لْمُؤْمِنُونَ ۚ كُلٌّ ءَامَنَ بِ<h>ٱ</>للَّهِ وَمَ<o>لَٰٓ</>ئِكَتِ<m>هِۦ</> وَكُتُبِ<m>هِۦ</> وَرُسُلِ<m>هِۦ</> لَا نُفَرِّقُ بَيْنَ أَحَ<d>دٍۢ مِّ</><w>ن رُّ</>سُلِ<m>هِۦ</> ۚ وَقَالُو<s>ا۟</> سَمِعْنَا وَأَطَعْنَا ۖ غُفْرَانَكَ رَبَّنَا وَإِلَيْكَ <h>ٱ</>لْمَ<p>صِي</>رُ"},{"n":286,"w":[["لَا","lā","(Does) not","না"],["يُكَلِّفُ","yukallifu","burden","দায়িত্বভার দেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["نَفْسًا","nafsan","any soul","কোনো ব্যক্তিকে"],["إِلَّا","illā","except","এছাড়া যা"],["وُسْعَهَا ۚ","wus'‘ahā","its capacity","তার সামর্থ্য (আছে)"],["لَهَا","lahā","for it","তার জন্য (আছে)"],["مَا","mā","what","যা (পূণ্য)"],["كَسَبَتْ","kasabat","it earned","সে অর্জন করেছে"],["وَعَلَيْهَا","wa‘alayhā","and against it","এবং তার বিরুদ্ধে"],["مَا","mā","what","যা (পাপ)"],["ٱكْتَسَبَتْ ۗ","ik'tasabat","it earned","সে অর্জন করেছে"],["رَبَّنَا","rabbanā","Our Lord","হে আমাদের রব"],["لَا","lā","(Do) not","না"],["تُؤَاخِذْنَآ","tuākhidh'nā","take us to task","আমাদেরকে পাকড়াও করো"],["إِن","in","if","যদি"],["نَّسِينَآ","nasīnā","we forget","আমরা ভুলে যাই"],["أَوْ","aw","or","বা"],["أَخْطَأْنَا ۚ","akhṭanā","we err","আমরা ভুল করি"],["رَبَّنَا","rabbanā","Our Lord","হে আমাদের রব"],["وَلَا","walā","And (do) not","এবং না"],["تَحْمِلْ","taḥmil","lay","চাপিয়ে দিও"],["عَلَيْنَآ","‘alaynā","upon us","আমাদের উপর"],["إِصْرًۭا","iṣ'ran","a burden","বোঝা"],["كَمَا","kamā","like that","যেমন"],["حَمَلْتَهُۥ","ḥamaltahu","(which) You laid [it]","তা তুমি চাপিয়ে দিয়েছিলে"],["عَلَى","‘alā","on","উপর"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["مِن","min","(were) from","থেকে"],["قَبْلِنَا ۚ","qablinā","before us","আমাদের পূর্ব ছিল"],["رَبَّنَا","rabbanā","Our Lord","হে আমাদের রব"],["وَلَا","walā","[And] (do) not","এবং না"],["تُحَمِّلْنَا","tuḥammil'nā","lay on us","আমাদের উপর চাপিয়ে দিও"],["مَا","mā","what","তা"],["لَا","lā","not","নেই"],["طَاقَةَ","ṭāqata","(the) strength","শক্তি"],["لَنَا","lanā","we have","আমাদের কাছে"],["بِهِۦ ۖ","bihi","[of it] (to bear)","যার"],["وَٱعْفُ","wa-u‘'fu","And pardon","এবং মোচন করে দাও (ত্রুটি)"],["عَنَّا","‘annā","[from] us","আমাদের থেকে"],["وَٱغْفِرْ","wa-igh'fir","and forgive","এবং ক্ষমা করো"],["لَنَا","lanā","[for] us","আমাদেরকে"],["وَٱرْحَمْنَآ ۚ","wa-ir'ḥamnā","and have mercy on us","এবং আমাদের উপর দয়া করো"],["أَنتَ","anta","You (are)","তুমিই"],["مَوْلَىٰنَا","mawlānā","our Protector","আমাদের অভিভাবক"],["فَٱنصُرْنَا","fa-unṣur'nā","so help us","আমাদের সাহায্য কর তাই"],["عَلَى","‘alā","against","বিরুদ্ধে"],["ٱلْقَوْمِ","l-qawmi","the people ","সম্প্রদায়ের"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","[the] disbelievers","(যারা) কাফির"]],"t":"لَا يُكَلِّفُ <h>ٱ</>للَّهُ نَفْسًا إِلَّا وُسْعَهَا ۚ لَهَا مَا كَسَبَتْ وَعَلَيْهَا مَا <h>ٱ</>كْتَسَبَتْ ۗ رَبَّنَا لَا تُؤَاخِذْ<o>نَآ</> <d>إِن نَّ</>سِي<o>نَآ</> أَوْ أَخْطَأْنَا ۚ رَبَّنَا وَلَا تَحْمِلْ عَلَيْ<o>نَآ</> إِصْ<k>رًۭا كَ</>مَا حَمَلْتَهُ<m>ۥ</> عَلَى <h>ٱ</>لَّذِينَ مِ<k>ن قَ</><q>بْ</>لِنَا ۚ رَبَّنَا وَلَا تُحَ<g>مِّ</>لْنَا مَا لَا طَاقَةَ لَنَا بِ<m>هِۦ</> ۖ وَ<h>ٱ</>عْفُ عَ<g>نَّ</>ا وَ<h>ٱ</>غْفِرْ لَنَا وَ<h>ٱ</>رْحَمْ<o>نَآ ۚ</> أَ<k>نتَ</> مَوْلَ<m>ىٰ</>نَا فَ<h>ٱ</><k>نصُ</>رْنَا عَلَى <h>ٱ</>لْقَوْمِ <h>ٱ</>لْ<m>كَٰ</>فِ<p>رِي</>نَ"}]}