اعِدُوهُ<g>نَّ</> سِرًّا إِ<o>لَّآ</> أَ<k>ن تَ</>قُولُو<s>ا۟</> قَوْلًۭ<d>ا مَّ</>عْرُو<d>فًۭا ۚ وَ</>لَا تَعْزِمُو<s>ا۟</> عُ<q>قْ</>دَةَ <h>ٱ</><l>ل</><g>نِّ</>كَاحِ حَتَّىٰ يَ<q>بْ</>لُغَ <h>ٱ</>لْكِ<m>تَٰ</>بُ أَجَلَهُ<m>ۥ</> ۚ وَ<h>ٱ</>عْلَ<o>مُوٓ</><s>ا۟</> أَ<g>نَّ</> <h>ٱ</>للَّهَ يَعْلَمُ مَا <o>فِىٓ</> أَ<k>نفُ</>سِكُمْ فَ<h>ٱ</>حْذَرُوهُ ۚ وَ<h>ٱ</>عْلَ<o>مُوٓ</><s>ا۟</> أَ<g>نَّ</> <h>ٱ</>للَّهَ غَفُورٌ حَ<p>لِي</>مٌۭ"},{"n":236,"w":[["لَّا","lā","(There is) no","নেই"],["جُنَاحَ","junāḥa","blame","কোনো পাপ"],["عَلَيْكُمْ","‘alaykum","upon you","তোমাদের উপর"],["إِن","in","if","যদি"],["طَلَّقْتُمُ","ṭallaqtumu","you divorce","তোমরা তালাক দাও"],["ٱلنِّسَآءَ","l-nisāa","[the] women","স্ত্রীদেরকে"],["مَا","mā","whom","যে পর্যন্ত"],["لَمْ","lam","not","না"],["تَمَسُّوهُنَّ","tamassūhunna","you have touched","তাদেরকে স্পর্শ কর"],["أَوْ","aw","nor","অথবা"],["تَفْرِضُوا۟","tafriḍū","you specified","তোমরা ধার্য কর (নাই)"],["لَهُنَّ","lahunna","for them","তাদের জন্য"],["فَرِيضَةًۭ ۚ","farīḍatan","an obligation (dower)","কোনো মোহর"],["وَمَتِّعُوهُنَّ","wamatti‘ūhunna","And make provision for them ","এবং তাদেরকে কিছু খরচপত্র দাও"],["عَلَى","‘alā","upon","উপর"],["ٱلْمُوسِعِ","l-mūsi‘i","the wealthy","সংগতিসম্পন্ন ব্যক্তি"],["قَدَرُهُۥ","qadaruhu","according to his means","তার সাধ্যমত"],["وَعَلَى","wa‘alā","and upon","ও উপর"],["ٱلْمُقْتِرِ","l-muq'tiri","the poor","বিত্তহীনের"],["قَدَرُهُۥ","qadaruhu","according to his means ","তার সাধ্যমত"],["مَتَـٰعًۢا","matā‘an","a provision","খরচপত্র দেবে"],["بِٱلْمَعْرُوفِ ۖ","bil-ma‘rūfi","in a fair manner","ন্যায়সংগত ভাবে"],["حَقًّا","ḥaqqan","a duty","কর্তব্য"],["عَلَى","‘alā","upon","উপর"],["ٱلْمُحْسِنِينَ","l-muḥ'sinīna","the good-doers","সৎকর্মশীল লোকদের"]],"t":"لَّا جُنَاحَ عَلَيْكُمْ إِ<k>ن طَ</>لَّ<q>قْ</>تُمُ <h>ٱ</><l>ل</><g>نِّ</><o>سَآ</>ءَ مَا لَمْ تَمَسُّوهُ<g>نَّ</> أَوْ تَفْرِضُو<s>ا۟</> لَهُ<g>نَّ</> فَرِيضَ<d>ةًۭ ۚ وَ</>مَتِّعُوهُ<g>نَّ</> عَلَى <h>ٱ</>لْمُوسِعِ قَدَرُهُ<m>ۥ</> وَعَلَى <h>ٱ</>لْمُ<q>قْ</>تِرِ قَدَرُهُ<m>ۥ</> مَ<m>تَٰ</><i>عًۢا بِ</><h>ٱ</>لْمَعْرُوفِ ۖ حَقًّا عَلَى <h>ٱ</>لْمُحْسِ<p>نِي</>نَ"},{"n":237,"w":[["وَإِن","wa-in","And if","এবং যদি"],["طَلَّقْتُمُوهُنَّ","ṭallaqtumūhunna","you divorce them","তাদেরকে তোমরা তালাক দিয়ে দাও"],["مِن","min","from","থেকে"],["قَبْلِ","qabli","before","এর পূর্বেই"],["أَن","an","[that]","যে"],["تَمَسُّوهُنَّ","tamassūhunna","you (have) touched them","তাদেরকে স্পর্শ করবে"],["وَقَدْ","waqad","while already","অথচ নিশ্চয়ই"],["فَرَضْتُمْ","faraḍtum","you have specified","তোমরা ধার্য করেছ"],["لَهُنَّ","lahunna","for them","তাদের জন্য"],["فَرِيضَةًۭ","farīḍatan","an obligation (dower)","মোহর"],["فَنِصْفُ","faniṣ'fu","then (give) half","অর্ধেক তবে"],["مَا","mā","(of) what","যা"],["فَرَضْتُمْ","faraḍtum","you have specified","তোমরা ধার্য করেছ (মোহর)"],["إِلَّآ","illā","unless","কিন্তু"],["أَن","an","[that]","যে ছাড়া (স্ত্রীরা)"],["يَعْفُونَ","ya‘fūna","they (women) forgo (it)","তারা ক্ষমা প্রকাশ করে (না নেয়)"],["أَوْ","aw","or","অথবা"],["يَعْفُوَا۟","ya‘fuwā","forgoes","সে ক্ষমা করে (পূর্ণ দেয়)"],["ٱلَّذِى","alladhī","the one","যে (পুরুষ)"],["بِيَدِهِۦ","biyadihi","in whose hands","যার হাতের মধ্যে (রয়েছে)"],["عُقْدَةُ","‘uq'datu","(is the) knot","বন্ধন"],["ٱلنِّكَاحِ ۚ","l-nikāḥi","(of) the marriage","বিয়ের (তা স্বতন্ত্র কথা)"],["وَأَن","wa-an","And that","এবং (এও) যে"],["تَعْفُوٓا۟","ta‘fū","you forgo","তোমরা ক্ষমা করবে"],["أَقْرَبُ","aqrabu","(is) nearer","(তা) নিকটতর"],["لِلتَّقْوَىٰ ۚ","lilttaqwā","to [the] righteousness","তাকওয়ার ক্ষেত্রে"],["وَلَا","walā","And (do) not","এবং না"],["تَنسَوُا۟","tansawū","forget","তোমরা ভুলে যেয়ো"],["ٱلْفَضْلَ","l-faḍla","the graciousness","সহৃদয়তা"],["بَيْنَكُمْ ۚ","baynakum","among you","তোমাদের মাঝে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["بِمَا","bimā","of what","ঐ বিষয় যা"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা কাজ কর"],["بَصِيرٌ","baṣīrun","(is) All-Seer","খুব দেখেন"]],"t":"وَإِ<k>ن طَ</>لَّ<q>قْ</>تُمُوهُ<g>نَّ</> مِ<k>ن قَ</><q>بْ</>لِ أَ<k>ن تَ</>مَسُّوهُ<g>نَّ</> وَقَ<q>دْ</> فَرَضْتُمْ لَهُ<g>نَّ</> فَرِيضَ<k>ةًۭ فَ</>نِصْفُ مَا فَرَضْتُمْ إِ<o>لَّآ</> <d>أَن يَ</>عْفُونَ أَوْ يَعْفُوَ<s>ا۟</> <h>ٱ</>لَّذِى بِيَدِ<m>هِۦ</> عُ<q>قْ</>دَةُ <h>ٱ</><l>ل</><g>نِّ</>كَاحِ ۚ وَأَ<k>ن تَ</>عْ<o>فُوٓ</><s>ا۟</> أَ<q>قْ</>رَبُ لِلتَّ<q>قْ</>وَىٰ ۚ وَلَا تَ<k>نسَ</>وُ<s>ا۟</> <h>ٱ</>لْفَضْلَ بَيْنَكُمْ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ بِمَا تَعْمَلُونَ بَ<p>صِي</>رٌ"},{"n":238,"w":[["حَـٰفِظُوا۟","ḥāfiẓū","Guard strictly","তোমরা সংরক্ষণ করো"],["عَلَى","‘alā","[on]","প্রতি"],["ٱلصَّلَوَٰتِ","l-ṣalawāti","the prayers","সব সালাত গুলোর"],["وَٱلصَّلَوٰةِ","wal-ṣalati","and the prayer ","এবং (বিশেষ করে) সালাত"],["ٱلْوُسْطَىٰ","l-wus'ṭā","[the] middle","মধ্যবর্তী (অর্থাৎ আছরের)"],["وَقُومُوا۟","waqūmū","and stand up","এবং তোমরা দাঁড়িয়ে যাও"],["لِلَّهِ","lillahi","for Allah","আল্লাহর জন্য"],["قَـٰنِتِينَ","qānitīna","devoutly obedient","একান্ত বিনীত ভাবে"]],"t":"<m>حَٰ</>فِظُو<s>ا۟</> عَلَى <h>ٱ</><l>ل</>صَّلَ<m>وَٰ</>تِ وَ<h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةِ <h>ٱ</>لْوُسْطَىٰ وَقُومُو<s>ا۟</> لِلَّهِ <m>قَٰ</>نِ<p>تِي</>نَ"},{"n":239,"w":[["فَإِنْ","fa-in","And if","অতঃপর যদি"],["خِفْتُمْ","khif'tum","you fear","তোমরা ভয় করো"],["فَرِجَالًا","farijālan","then (pray) on foot","তবে হেঁটে চলা অবস্থায়"],["أَوْ","aw","or","বা"],["رُكْبَانًۭا ۖ","ruk'bānan","riding","আরোহী অবস্থায় (সালাত পড়বে)"],["فَإِذَآ","fa-idhā","Then when","অতঃপর যখন"],["أَمِنتُمْ","amintum","you are secure","তোমরা নিরাপদ হও"],["فَٱذْكُرُوا۟","fa-udh'kurū","then remember","স্মরণ করো তখন"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["كَمَا","kamā","as","যেমন"],["عَلَّمَكُم","‘allamakum","He (has) taught you","তোমাদের তিনি শিখিয়েছেন"],["مَّا","mā","what","যা"],["لَمْ","lam","not","না"],["تَكُونُوا۟","takūnū","you were","তোমরা হও"],["تَعْلَمُونَ","ta‘lamūna","knowing","তোমরা জানতে"]],"t":"فَإِنْ خِفْتُمْ فَرِجَالًا أَوْ رُكْبَا<k>نًۭا ۖ فَ</>إِ<o>ذَآ</> أَمِ<k>نتُ</>مْ فَ<h>ٱ</>ذْكُرُو<s>ا۟</> <h>ٱ</>للَّهَ كَمَا عَلَّمَ<y>كُم مَّ</>ا لَمْ تَكُونُو<s>ا۟</> تَعْلَ<p>مُو</>نَ"},{"n":240,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["يُتَوَفَّوْنَ","yutawaffawna","die","মারা যায়"],["مِنكُمْ","minkum","among you","তোমাদের মধ্য হতে"],["وَيَذَرُونَ","wayadharūna","and leave behind","এবং তারা রেখে যায়"],["أَزْوَٰجًۭا","azwājan","(their) wives","স্ত্রীদেরকে"],["وَصِيَّةًۭ","waṣiyyatan","(should make) a will","(তাদের উচিৎ) জোর নির্দেশ করা"],["لِّأَزْوَٰجِهِم","li-azwājihim","for their wives","তাদের স্ত্রীদের জন্যে"],["مَّتَـٰعًا","matā‘an","provision","ভরণ পোষণের"],["إِلَى","ilā","for","পর্যন্ত"],["ٱلْحَوْلِ","l-ḥawli","the year","এক বছর"],["غَيْرَ","ghayra","without","ছাড়া"],["إِخْرَاجٍۢ ۚ","ikh'rājin","driving (them) out","বহিষ্কার (ঘর থেকে)"],["فَإِنْ","fa-in","But if","যদি তবে"],["خَرَجْنَ","kharajna","they leave","তারা বের হয় (নিজেরাই)"],["فَلَا","falā","then no","নেই তবে"],["جُنَاحَ","junāḥa","blame","কোনো পাপ"],["عَلَيْكُمْ","‘alaykum","upon you","তোমাদের উপর"],["فِى","fī","in","সেক্ষেত্রে"],["مَا","mā","what","যা"],["فَعَلْنَ","fa‘alna","they do","তারা করেছে"],["فِىٓ","fī","concerning","ব্যাপারে"],["أَنفُسِهِنَّ","anfusihinna","themselves","তাদের নিজেদের"],["مِن","min","[of]","থেকে"],["مَّعْرُوفٍۢ ۗ","ma‘rūfin","honorably","ন্যায় সংগত ভাবে"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["عَزِيزٌ","‘azīzun","(is) All-Mighty","পরাক্রমশালী"],["حَكِيمٌۭ","ḥakīmun","All-Wise","মহাবিজ্ঞ"]],"t":"وَ<h>ٱ</>لَّذِينَ يُتَوَفَّوْنَ مِ<k>نكُ</>مْ وَيَذَرُونَ أَزْ<m>وَٰ</><d>جًۭا وَ</>صِيَّ<w>ةًۭ لِّ</>أَزْ<m>وَٰ</>جِ<y>هِم مَّ</><m>تَٰ</>عًا إِلَى <h>ٱ</>لْحَوْلِ غَيْرَ إِخْرَا<k>جٍۢ ۚ فَ</>إِنْ خَرَ<q>جْ</>نَ فَلَا جُنَاحَ عَلَيْكُمْ فِى مَا فَعَلْنَ <o>فِىٓ</> أَ<k>نفُ</>سِهِ<g>نَّ</> <d>مِن مَّ</>عْرُو<d>فٍۢ ۗ وَ</><h>ٱ</>للَّهُ عَزِيزٌ حَ<p>كِي</>مٌۭ"},{"n":241,"w":[["وَلِلْمُطَلَّقَـٰتِ","walil'muṭallaqāti","And for the divorced women","এবং তালাক প্রাপ্তাদের জন্যে"],["مَتَـٰعٌۢ","matā‘un","(is) a provision","কিছু ভরণপোষণ দেওয়া"],["بِٱلْمَعْرُوفِ ۖ","bil-ma‘rūfi","in a fair manner ","উপযুক্তভাবে"],["حَقًّا","ḥaqqan","a duty","কর্তব্য"],["عَلَى","‘alā","upon","উপর"],["ٱلْمُتَّقِينَ","l-mutaqīna","the righteous","মুত্তাকীদের"]],"t":"وَلِلْمُطَلَّ<m>قَٰ</>تِ مَ<m>تَٰ</><i>عٌۢ بِ</><h>ٱ</>لْمَعْرُوفِ ۖ حَقًّا عَلَى <h>ٱ</>لْمُتَّ<p>قِي</>نَ"},{"n":242,"w":[["كَذَٰلِكَ","kadhālika","Thus","এভাবে"],["يُبَيِّنُ","yubayyinu","makes clear","বর্ণনা করেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["لَكُمْ","lakum","for you","তোমাদের জন্য"],["ءَايَـٰتِهِۦ","āyātihi","His Verses","তাঁর বিধানাবলীকে"],["لَعَلَّكُمْ","la‘allakum","so that you may","তোমরা যেন"],["تَعْقِلُونَ","ta‘qilūna","use your intellect","বুঝতে পার"]],"t":"كَ<m>ذَٰ</>لِكَ يُبَيِّنُ <h>ٱ</>للَّهُ لَكُمْ ءَا<m>يَٰتِهِۦ</> لَعَلَّكُمْ تَعْقِ<p>لُو</>نَ"},{"n":243,"w":[["۞ أَلَمْ","alam","Did not","নি কি"],["تَرَ","tara","you see","তুমি দেখ"],["إِلَى","ilā","[to]","প্রতি"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["خَرَجُوا۟","kharajū","went out","বের হয়েছিল"],["مِن","min","from","থেকে"],["دِيَـٰرِهِمْ","diyārihim","their homes","ঘরগুলো তাদের"],["وَهُمْ","wahum","and they","অথচ তারা (ছিল)"],["أُلُوفٌ","ulūfun","(were in) thousands","হাজার হাজার"],["حَذَرَ","ḥadhara","(in) fear","ভয়ে"],["ٱلْمَوْتِ","l-mawti","(of) [the] death","মৃত্যুর"],["فَقَالَ","faqāla","Then said","অতঃপর বললেন"],["لَهُمُ","lahumu","to them","তাদের উদ্দেশে"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["مُوتُوا۟","mūtū","Die","তোমরা মরে যাও"],["ثُمَّ","thumma","then","এরপর"],["أَحْيَـٰهُمْ ۚ","aḥyāhum","He restored them to life","তিনি জীবিত করলেন (আবার) তাদেরকে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَذُو","ladhū","(is) surely Possessor","(অধিকারী)"],["فَضْلٍ","faḍlin","(of) bounty","অনুগ্রহের"],["عَلَى","‘alā","for","উপর"],["ٱلنَّاسِ","l-nāsi","[the] mankind","মানুষের"],["وَلَـٰكِنَّ","walākinna","[and] but","কিন্তু"],["أَكْثَرَ","akthara","most","অধিকাংশ"],["ٱلنَّاسِ","l-nāsi","(of) the people","মানুষ"],["لَا","lā","(are) not","না"],["يَشْكُرُونَ","yashkurūna","grateful","তারা কৃতজ্ঞতা প্রকাশ করে"]],"t":"۞ أَلَم