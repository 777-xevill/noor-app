ey","যে তারা"],["كَانُوا۟","kānū","were","তারা ছিলো"],["كَـٰفِرِينَ","kāfirīna","disbelievers","কাফির"]],"t":"<m>يَٰ</>مَعْشَرَ <h>ٱ</>لْجِ<g>نِّ</> وَ<h>ٱ</>لْإِ<k>نسِ</> أَلَمْ يَأْتِكُمْ رُسُ<d>لٌۭ مِّ</><k>نكُ</>مْ يَقُصُّونَ عَلَيْكُمْ ءَا<m>يَٰ</>تِى وَيُ<k>نذِ</>رُونَكُمْ لِ<o>قَآ</>ءَ يَوْمِكُمْ <m>هَٰ</>ذَا ۚ قَالُو<s>ا۟</> شَهِ<q>دْ</>نَا عَلَ<o>ىٰٓ</> أَ<k>نفُ</>سِنَا ۖ وَغَرَّتْهُمُ <h>ٱ</>لْحَيَ<s>وٰ</>ةُ <h>ٱ</><l>ل</>دُّنْيَا وَشَهِدُو<s>ا۟</> عَلَ<o>ىٰٓ</> أَ<k>نفُ</>سِهِمْ أَ<g>نَّ</>هُمْ كَانُو<s>ا۟</> <m>كَٰ</>فِ<p>رِي</>نَ"},{"n":131,"w":[["ذَٰلِكَ","dhālika","That (is because)","এটা (এ জন্যে)"],["أَن","an","[that]","যে"],["لَّمْ","lam","not","না"],["يَكُن","yakun","is","ছিলেন"],["رَّبُّكَ","rabbuka","your Lord","তোমার রব"],["مُهْلِكَ","muh'lika","one who destroys","ধ্বংসকারী"],["ٱلْقُرَىٰ","l-qurā","the cities","কোনো জনপদকে"],["بِظُلْمٍۢ","biẓul'min","for (their) wrongdoing","অন্যায় দ্বারা"],["وَأَهْلُهَا","wa-ahluhā","while their people","এমতাবস্হায় তার অধিবাসী (ছিলো)"],["غَـٰفِلُونَ","ghāfilūna","(are) unaware","(পরিণতি সম্পর্কে) অনবহিত"]],"t":"<m>ذَٰ</>لِكَ <w>أَن لَّ</>مْ يَ<w>كُن رَّ</>بُّكَ مُهْلِكَ <h>ٱ</>لْقُرَىٰ بِظُلْ<d>مٍۢ وَ</>أَهْلُهَا <m>غَٰ</>فِ<p>لُو</>نَ"},{"n":132,"w":[["وَلِكُلٍّۢ","walikullin","And for all","এবং সবার জন্য (রয়েছে)"],["دَرَجَـٰتٌۭ","darajātun","(will be) degrees","মর্যাদাসমূহ"],["مِّمَّا","mimmā","for what","সে অনুসারে যা"],["عَمِلُوا۟ ۚ","‘amilū","they did","তারা কাজ করেছে"],["وَمَا","wamā","And not","এবং নন"],["رَبُّكَ","rabbuka","(is) your Lord","তোমার রব"],["بِغَـٰفِلٍ","bighāfilin","unaware","অনবহিত"],["عَمَّا","‘ammā","about what","তা হতে যা"],["يَعْمَلُونَ","ya‘malūna","they do","তারা কাজ করে"]],"t":"وَلِكُ<k>لٍّۢ دَ</>رَ<m>جَٰ</><d>تٌۭ مِّ</><g>مَّ</>ا عَمِلُو<s>ا۟ ۚ</> وَمَا رَبُّكَ بِ<m>غَٰ</>فِلٍ عَ<g>مَّ</>ا يَعْمَ<p>لُو</>نَ"},{"n":133,"w":[["وَرَبُّكَ","warabbuka","And your Lord","এবং তোমার রব"],["ٱلْغَنِىُّ","l-ghaniyu","(is) the Self-Sufficient","অভাবমুক্ত"],["ذُو","dhū","(the) Possessor","অধিকারী"],["ٱلرَّحْمَةِ ۚ","l-raḥmati","(of) mercy","দয়ার"],["إِن","in","If","যদি"],["يَشَأْ","yasha","He wills","ইচ্ছে করেন তিনি"],["يُذْهِبْكُمْ","yudh'hib'kum","He can take you away","অপসারিত করতে পারেন তোমাদের"],["وَيَسْتَخْلِفْ","wayastakhlif","and grant succession","ও স্থলাভিষিক্ত করতে পারেন"],["مِنۢ","min","from","থেকে"],["بَعْدِكُم","ba‘dikum","after you","পর তোমাদের"],["مَّا","mā","(to) whom","যাকে"],["يَشَآءُ","yashāu","He wills","ইচ্ছে করবেন তিনি"],["كَمَآ","kamā","as","যেমন"],["أَنشَأَكُم","ansha-akum","He raised you","সৃষ্টি করেছেন তোমাদের"],["مِّن","min","from","থেকে"],["ذُرِّيَّةِ","dhurriyyati","the descendants","বংশধরদের"],["قَوْمٍ","qawmin","(of) people","সম্প্রদায়ের"],["ءَاخَرِينَ","ākharīna","other","অন্যান্য"]],"t":"وَرَبُّكَ <h>ٱ</>لْغَنِىُّ ذُو <h>ٱ</><l>ل</>رَّحْمَةِ ۚ <d>إِن يَ</>شَأْ يُذْهِ<q>بْ</>كُمْ وَيَسْتَخْلِفْ <i>مِنۢ بَ</>عْدِ<y>كُم مَّ</>ا يَ<o>شَآ</>ءُ كَ<o>مَآ</> أَ<k>نشَ</>أَ<y>كُم مِّ</><k>ن ذُ</>رِّيَّةِ قَوْمٍ ءَاخَ<p>رِي</>نَ"},{"n":134,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["مَا","mā","what","যা"],["تُوعَدُونَ","tū‘adūna","you are promised","তোমাদের প্রতিশ্রুতি দেয়া হচ্ছে"],["لَـَٔاتٍۢ ۖ","laātin","(is) sure to come","অবশ্যই আসবে"],["وَمَآ","wamā","And not","এবং না"],["أَنتُم","antum","(can) you","তোমরা (সমর্থ হবে)"],["بِمُعْجِزِينَ","bimu‘'jizīna","escape (it)","অক্ষম করতে (আল্লাহ্‌কে)"]],"t":"إِ<g>نَّ</> مَا تُوعَدُونَ لَءَا<d>تٍۢ ۖ وَ</><o>مَآ</> أَ<k>نتُ</><f>م بِ</>مُعْجِ<p>زِي</>نَ"},{"n":135,"w":[["قُلْ","qul","Say","(হে নাবী) বলো"],["يَـٰقَوْمِ","yāqawmi","O my people","\"হে আমার জাতি"],["ٱعْمَلُوا۟","i‘'malū","Work","তোমরা কাজ করো"],["عَلَىٰ","‘alā","on","উপর"],["مَكَانَتِكُمْ","makānatikum","your position","তোমাদের জায়গায়"],["إِنِّى","innī","Indeed, I am","নিশ্চয়ই আমি"],["عَامِلٌۭ ۖ","‘āmilun","a worker","কর্মসম্পাদনকারী (নিজের স্হানে)"],["فَسَوْفَ","fasawfa","And soon","অতঃপর শীঘ্রই"],["تَعْلَمُونَ","ta‘lamūna","you will know","তোমরা জানবে"],["مَن","man","who","কে"],["تَكُونُ","takūnu","will have","হবে (এমন যে)"],["لَهُۥ","lahu","for himself","জন্যে তার (থাকবে)"],["عَـٰقِبَةُ","‘āqibatu","(in) the end","পরিণামে"],["ٱلدَّارِ ۗ","l-dāri","(a good) home","(কল্যাণকর) আবাসস্থল"],["إِنَّهُۥ","innahu","Indeed [he]","নিশ্চয়ই তা (এমন সত্য যে)"],["لَا","lā","(will) not","না"],["يُفْلِحُ","yuf'liḥu","succeed","সফল হয়"],["ٱلظَّـٰلِمُونَ","l-ẓālimūna","the wrongdoers","সীমালঙ্ঘনকারীরা\""]],"t":"قُلْ <m>يَٰ</>قَوْمِ <h>ٱ</>عْمَلُو<s>ا۟</> عَلَىٰ مَكَانَتِكُمْ إِ<g>نِّ</>ى عَامِ<k>لٌۭ ۖ فَ</>سَوْفَ تَعْلَمُونَ مَ<k>ن تَ</>كُونُ لَهُ<m>ۥ عَٰ</>قِبَةُ <h>ٱ</><l>ل</>دَّارِ ۗ إِ<g>نَّ</>هُ<m>ۥ</> لَا يُفْلِحُ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مُو</>نَ"},{"n":136,"w":[["وَجَعَلُوا۟","waja‘alū","And they assign","এবং তারা নির্দিষ্ট করেছে"],["لِلَّهِ","lillahi","to Allah","জন্যে আল্লাহ্‌র"],["مِمَّا","mimmā","out of what","তা হতে যা"],["ذَرَأَ","dhara-a","He produced","তিনি সৃষ্টি করেছেন"],["مِنَ","mina","of","মধ্য হতে"],["ٱلْحَرْثِ","l-ḥarthi","the crops","ক্ষেত ফসলের"],["وَٱلْأَنْعَـٰمِ","wal-an‘āmi","and the cattle","ও গবাদি পশুর"],["نَصِيبًۭا","naṣīban","a share","এক অংশ"],["فَقَالُوا۟","faqālū","and they say","অতঃপর তারা বলে"],["هَـٰذَا","hādhā","This","\"এটা"],["لِلَّهِ","lillahi","(is) for Allah","জন্যে আল্লাহ্‌র\""],["بِزَعْمِهِمْ","biza‘mihim","by their claim","অনুযায়ী ধারণা তাদের"],["وَهَـٰذَا","wahādhā","And this","\"এবং (বল) এই (অন্য অংশটা)"],["لِشُرَكَآئِنَا ۖ","lishurakāinā","(is) for our partners","জন্যে আমাদের শরিকদের\""],["فَمَا","famā","But what","অতঃপর যা"],["كَانَ","kāna","is","হয়"],["لِشُرَكَآئِهِمْ","lishurakāihim","for their partners","জন্যে তাদের শরিকদের"],["فَلَا","falā","(does) not","তবে না"],["يَصِلُ","yaṣilu","reach","পৌঁছায়"],["إِلَى","ilā","[to]","কাছে"],["ٱللَّهِ ۖ","l-lahi","Allah","আল্লাহ্‌র"],["وَمَا","wamā","while what","অথচ যা কিছু"],["كَانَ","kāna","is","হয়"],["لِلَّهِ","lillahi","for Allah","জন্যে আল্লাহ্‌র"],["فَهُوَ","fahuwa","then it","পরে তা"],["يَصِلُ","yaṣilu","reaches","পৌঁছায়"],["إِلَىٰ","ilā","[to]","কাছে"],["شُرَكَآئِهِمْ ۗ","shurakāihim","their partners","শরিকদের তাদের"],["سَآءَ","sāa","Evil","নিকৃষ্ট"],["مَا","mā","(is) what","যা কিছু"],["يَحْكُمُونَ","yaḥkumūna","they judge","তারা মীমাংসা করে"]],"t":"وَجَعَلُو<s>ا۟</> لِلَّهِ مِ<g>مَّ</>ا ذَرَأَ مِنَ <h>ٱ</>لْحَرْثِ وَ<h>ٱ</>لْأَنْ<m>عَٰ</>مِ نَصِي<k>بًۭا فَ</>قَالُو<s>ا۟</> <m>هَٰ</>ذَا لِلَّهِ بِزَعْمِهِمْ وَ<m>هَٰ</>ذَا لِشُرَ<o>كَآ</>ئِنَا ۖ فَمَا كَانَ لِشُرَ<o>كَآ</>ئِهِمْ فَلَا يَصِلُ إِلَى <h>ٱ</>للَّهِ ۖ وَمَا كَانَ لِلَّهِ فَهُوَ يَصِلُ إِلَىٰ شُرَ<o>كَآ</>ئِهِمْ ۗ <o>سَآ</>ءَ مَا يَحْكُ<p>مُو</>نَ"},{"n":137,"w":[["وَكَذَٰلِكَ","wakadhālika","And likewise","এবং এভাবে"],["زَيَّنَ","zayyana","made pleasing","শোভন করা করেছে"],["لِكَثِيرٍۢ","likathīrin","to many","জন্যে অনেকের"],["مِّنَ","mina","of","মধ্য হতে"],["ٱلْمُشْرِكِينَ","l-mush'rikīna","the polytheists ","মুশরিকদের"],["قَتْلَ","qatla","(the) killing","হত্যা করাকে"],["أَوْلَـٰدِهِمْ","awlādihim","(of) their children ","সন্তানদের তাদের"],["شُرَكَآؤُهُمْ","shurakāuhum","their partners ","শরিকরা তাদের"],["لِيُرْدُوهُمْ","liyur'dūhum","so that they may ruin them","যেন তারা ধ্বংস করে তাদেরকে"],["وَلِيَلْبِسُوا۟","waliyalbisū","and that they make confusing","এবং যেন তারা দুর্বোধ্য করে"],["عَلَيْهِمْ","‘alayhim","to them","উপর তাদের"],["دِينَهُمْ ۖ","dīnahum","their religion","দীনকে তাদের"],["وَلَوْ","walaw","And if","এবং যদি"],["شَآءَ","shāa","(had) willed","ইচ্ছে করতেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ্‌"],["مَا","mā","not","না"],["فَعَلُوهُ ۖ","fa‘alūhu","(would) they have done so","তারা করত তা"],["فَذَرْهُمْ","fadharhum","So leave them","অতএব ছেড়ে দাও তাদেরকে"],["وَمَا","wamā","and what","এবং যা কিছু"],["يَفْتَرُونَ","yaftarūna","they invent","তারা রচনা করেছে"]],"t":"وَكَ<m>ذَٰ</>لِكَ زَيَّنَ لِكَثِي<d>رٍۢ مِّ</>نَ <h>ٱ</>لْمُشْرِكِينَ قَتْلَ أَوْ<m>لَٰ</>دِهِمْ شُرَ<o>كَآ</>ؤُهُمْ لِيُرْدُوهُمْ وَلِيَلْبِسُو<s>ا۟</> عَلَيْهِمْ دِينَهُمْ ۖ وَلَوْ <o>شَآ</>ءَ <h>ٱ</>للَّهُ مَا فَعَلُوهُ ۖ فَذَرْهُمْ وَمَا يَفْتَ<p>رُو</>نَ"},{"n":138,"w":[["وَقَالُوا۟","waqālū","And they say","এবং তারা বলে"],["هَـٰذِهِۦٓ","hādhihi","These","\"এই"],["أَنْعَـٰمٌۭ","an‘āmun","(are) cattle","গবাদিপশুগুলো"],["وَحَرْثٌ","waḥarthun","and crops","ও ক্ষেত ফসল"],["حِجْرٌۭ","ḥij'run","forbidden","সুরক্ষিত"],["لَّا","lā","no (one)","না"],["يَطْعَمُهَآ","yaṭ‘amuhā","can eat them","খাবে তা"],["إِلَّا","illā","except","এ ছাড়া"],["مَن","man","whom","যাকে"],["نَّشَآءُ","nashāu","we will","ইচ্ছা করিবো আমরা\""],["بِزَعْمِهِمْ","biza‘mihim","by their claim","অনুযায়ী ধারণা তাদের"],["وَأَنْعَـٰمٌ","wa-an‘āmun","And cattle","এবং (কিছু) গবাদিপশু"],["حُرِّمَتْ","ḥurrimat","forbidden","নিষিদ্ধ করা হয়েছে"],["ظُهُورُهَا","ẓuhūruhā","(are) their backs","পিঠগুলোতে তাদের(কিছু উঠাতে)"],["وَأَنْعَـٰمٌۭ","wa-an‘āmun","and cattle","ও (কিছু) গবাদিপশু"],["لَّا","lā","not","না"],["يَذْكُرُونَ","yadhkurūna","they mention","তারা উচ্চারণ করে (জবাই করার সময়)"],["ٱسْمَ","is'ma","(the) name","নাম"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহ্‌র"],["عَلَيْهَا","‘alayhā","on it","উপর তার"],["ٱفْتِرَآءً","if'tirāan","(as) an invention","তারা মিথ্যা রচনা করে"],["عَلَيْهِ ۚ","‘alayhi","against Him","উপর তার"],["سَيَجْزِيهِم","sayajzīhim","He will recompense them","শীঘ্রই প্রতিফল দিবেন তাদের"],["بِمَا","bimā","for what","এ কারণে যা"],["كَانُوا۟","kānū","they used to","তারা ছিলো"],["يَفْتَرُونَ","yaftarūna","invent","তারা মিথ্যা রচনা করতে"]],"t":"وَقَالُو<s>ا۟</> <m>هَٰ</>ذِ<o>هِۦٓ</> أَنْ<m>عَٰ</><d>مٌۭ وَ</>حَرْثٌ حِ<q>جْ</><w>رٌۭ لَّ</>ا يَ<q>طْ</>عَمُ<o>هَآ</> إِلَّا <d>مَن نَّ</><o>شَآ</>ءُ بِزَعْمِهِمْ وَأَنْ<m>عَٰ</>مٌ حُرِّمَتْ ظُهُورُهَا وَأَنْ<m>عَٰ</><w>مٌۭ لَّ</>ا يَذْكُرُونَ <h>ٱ</>سْمَ <h>ٱ</>للَّهِ عَلَيْهَا <h>ٱ</>فْتِ<o>رَآ</>ءً عَلَيْهِ ۚ سَيَ<q>جْ</>زِي<f>هِم بِ</>مَا كَانُو<s>ا۟</> يَفْتَ<p>رُو</>نَ"},{"n":139,"w":[["وَقَالُوا۟","waqālū","And they say","এবং তারা বলে"],["مَا","mā","What","\"যা কিছু"],["فِى","fī","(is) in","মধ্যে (আছে)"],["بُطُونِ","buṭūni","(the) wombs","পেটের"],["هَـٰذِهِ","hādhihi","(of) these","এই"],["ٱلْأَنْعَـٰمِ","l-an‘āmi","cattle","গবাদিপশুগুল