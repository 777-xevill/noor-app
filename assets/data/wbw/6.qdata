 না"],["تَقْتُلُوٓا۟","taqtulū","kill","তোমরা হত্যা করো"],["أَوْلَـٰدَكُم","awlādakum","your children","সন্তানদের তোমাদের"],["مِّنْ","min","(out) of","ভয়ে"],["إِمْلَـٰقٍۢ ۖ","im'lāqin","poverty","দারিদ্রের"],["نَّحْنُ","naḥnu","We","আমরা"],["نَرْزُقُكُمْ","narzuqukum","provide for you","আমরা জীবিকা দিই তোমাদের"],["وَإِيَّاهُمْ ۖ","wa-iyyāhum","and for them","এবং তাদেরকেও"],["وَلَا","walā","And (do) not","এবং না"],["تَقْرَبُوا۟","taqrabū","go near","তোমরা নিকটে যেও"],["ٱلْفَوَٰحِشَ","l-fawāḥisha","[the] immoralities","অশ্লীলতার"],["مَا","mā","what","যা"],["ظَهَرَ","ẓahara","(is) apparent","প্রকাশ্য (হোক)"],["مِنْهَا","min'hā","of them","তা হতে"],["وَمَا","wamā","and what","কিংবা যা"],["بَطَنَ ۖ","baṭana","(is) concealed","অপ্রকাশ্য (তাও)"],["وَلَا","walā","And (do) not","এবং না"],["تَقْتُلُوا۟","taqtulū","kill","তোমরা হত্যা করো"],["ٱلنَّفْسَ","l-nafsa","the soul","কোনো প্রাণকে"],["ٱلَّتِى","allatī","which","যাকে"],["حَرَّمَ","ḥarrama","has (been) forbidden","নিষিদ্ধ করেছেন"],["ٱللَّهُ","l-lahu","(by) Allah","আল্লাহ্‌"],["إِلَّا","illā","except","ছাড়া"],["بِٱلْحَقِّ ۚ","bil-ḥaqi","by (legal) right","কারণ যথার্থ (যেমন জিহাদে)"],["ذَٰلِكُمْ","dhālikum","That","এটা"],["وَصَّىٰكُم","waṣṣākum","(He) has enjoined on you","নির্দেশ দিচ্ছেন তোমাদের"],["بِهِۦ","bihi","with it","সম্পর্কে তা"],["لَعَلَّكُمْ","la‘allakum","so that you may","যাতে তোমরা"],["تَعْقِلُونَ","ta‘qilūna","use reason","অনুধাবন করো\""]],"t":"۞ قُلْ تَعَالَوْ<s>ا۟</> أَتْلُ مَا حَرَّمَ رَبُّكُمْ عَلَيْكُمْ ۖ أَلَّا تُشْرِكُو<s>ا۟</> بِ<m>هِۦ</> شَ<d>يْـًۭٔا ۖ وَ</>بِ<h>ٱ</>لْ<m>وَٰ</>لِدَيْنِ إِحْ<m>سَٰ</><d>نًۭا ۖ وَ</>لَا تَ<q>قْ</>تُ<o>لُوٓ</><s>ا۟</> أَوْ<m>لَٰ</>دَ<y>كُم مِّ</>نْ إِمْ<m>لَٰ</><d>قٍۢ ۖ نَّ</>حْنُ نَرْزُقُكُمْ وَإِيَّاهُمْ ۖ وَلَا تَ<q>قْ</>رَبُو<s>ا۟</> <h>ٱ</>لْفَ<m>وَٰ</>حِشَ مَا ظَهَرَ مِنْهَا وَمَا بَطَنَ ۖ وَلَا تَ<q>قْ</>تُلُو<s>ا۟</> <h>ٱ</><l>ل</><g>نَّ</>فْسَ <h>ٱ</>لَّتِى حَرَّمَ <h>ٱ</>للَّهُ إِلَّا بِ<h>ٱ</>لْحَقِّ ۚ <m>ذَٰ</>لِكُمْ وَصَّ<m>ىٰ</><f>كُم بِ</><m>هِۦ</> لَعَلَّكُمْ تَعْقِ<p>لُو</>نَ"},{"n":152,"w":[["وَلَا","walā","And (do) not","এবং না"],["تَقْرَبُوا۟","taqrabū","go near","তোমরা নিকটেও যেও"],["مَالَ","māla","wealth","সম্পদের"],["ٱلْيَتِيمِ","l-yatīmi","(of) the orphans","ইয়াতীমের"],["إِلَّا","illā","except","তবে"],["بِٱلَّتِى","bi-allatī","with that","এমনভাবে"],["هِىَ","hiya","which","যা"],["أَحْسَنُ","aḥsanu","(is) best","অতি উত্তম (যেমন তাদের ভরণ পোষণ)"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["يَبْلُغَ","yablugha","he reaches","সে পৌঁছে"],["أَشُدَّهُۥ ۖ","ashuddahu","his maturity","বয়ঃপ্রাপ্ততায় তার"],["وَأَوْفُوا۟","wa-awfū","And give full","এবং তোমরা পূর্ণ দিবে"],["ٱلْكَيْلَ","l-kayla","[the] measure","পরিমাপ"],["وَٱلْمِيزَانَ","wal-mīzāna","and the weight","ও ওজন"],["بِٱلْقِسْطِ ۖ","bil-qis'ṭi","with justice","ভাবে ন্যায্য"],["لَا","lā","Not","না"],["نُكَلِّفُ","nukallifu","We burden","ভার অর্পণ করি আমরা"],["نَفْسًا","nafsan","any soul","কোনো ব্যক্তিকে"],["إِلَّا","illā","except","এ ছাড়া (যা)"],["وُسْعَهَا ۖ","wus'‘ahā","(to) its capacity","তার সামর্থ্য (আছে)"],["وَإِذَا","wa-idhā","And when","এবং যখন"],["قُلْتُمْ","qul'tum","you speak","কথা বলো তোমরা"],["فَٱعْدِلُوا۟","fa-i‘'dilū","then be just","তখন তোমরা সুবিচার করো"],["وَلَوْ","walaw","even if","এবং যদি"],["كَانَ","kāna","he is","সে হয়"],["ذَا","dhā","(one of)","সম্পন্ন"],["قُرْبَىٰ ۖ","qur'bā","a near relative","নৈকট্য"],["وَبِعَهْدِ","wabi‘ahdi","And (the) Covenant","এবং অঙ্গীকারকে"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহ্‌র"],["أَوْفُوا۟ ۚ","awfū","fulfil","তোমরা পূর্ণ করো"],["ذَٰلِكُمْ","dhālikum","That","এটা"],["وَصَّىٰكُم","waṣṣākum","(He) has enjoined on you","নির্দেশ দিচ্ছেন তোমাদের"],["بِهِۦ","bihi","with it","সম্পর্কে সে"],["لَعَلَّكُمْ","la‘allakum","so that you may","সম্ভবতঃ তোমরা"],["تَذَكَّرُونَ","tadhakkarūna","remember","উপদেশ গ্রহণ করবে"]],"t":"وَلَا تَ<q>قْ</>رَبُو<s>ا۟</> مَالَ <h>ٱ</>لْيَتِيمِ إِلَّا بِ<h>ٱ</>لَّتِى هِىَ أَحْسَنُ حَتَّىٰ يَ<q>بْ</>لُغَ أَشُدَّهُ<m>ۥ</> ۖ وَأَوْفُو<s>ا۟</> <h>ٱ</>لْكَيْلَ وَ<h>ٱ</>لْمِيزَانَ بِ<h>ٱ</>لْقِسْطِ ۖ لَا نُكَلِّفُ نَفْسًا إِلَّا وُسْعَهَا ۖ وَإِذَا قُلْتُمْ فَ<h>ٱ</>عْدِلُو<s>ا۟</> وَلَوْ كَانَ ذَا قُرْبَىٰ ۖ وَبِعَهْدِ <h>ٱ</>للَّهِ أَوْفُو<s>ا۟ ۚ</> <m>ذَٰ</>لِكُمْ وَصَّ<m>ىٰ</><f>كُم بِ</><m>هِۦ</> لَعَلَّكُمْ تَذَكَّ<p>رُو</>نَ"},{"n":153,"w":[["وَأَنَّ","wa-anna","And that","এবং নিশ্চয়ই"],["هَـٰذَا","hādhā","this","এটাই"],["صِرَٰطِى","ṣirāṭī","(is) My path","আমার পথ"],["مُسْتَقِيمًۭا","mus'taqīman","straight","সরল-সঠিক"],["فَٱتَّبِعُوهُ ۖ","fa-ittabi‘ūhu","so follow it","অতএব তোমরা অনুসরণ করো তা"],["وَلَا","walā","And (do) not","এবং না"],["تَتَّبِعُوا۟","tattabi‘ū","follow","তোমরা অনুসরণ করো"],["ٱلسُّبُلَ","l-subula","the (other) paths","(শয়তানের) পথগুলোর"],["فَتَفَرَّقَ","fatafarraqa","then they will separate","তাহলে বিচ্ছিন্ন করবে"],["بِكُمْ","bikum","you","তোমাদেরকে"],["عَن","‘an","from","হতে"],["سَبِيلِهِۦ ۚ","sabīlihi","His path","পথ তাঁর"],["ذَٰلِكُمْ","dhālikum","That","এটা"],["وَصَّىٰكُم","waṣṣākum","(He) has enjoined on you","(আল্লাহ্‌) জোর নির্দেশ দেন তোমাদেরকে"],["بِهِۦ","bihi","[with it]","সম্পর্কে সে"],["لَعَلَّكُمْ","la‘allakum","so that you may","সম্ভবতঃ তোমরা"],["تَتَّقُونَ","tattaqūna","become righteous","সংযত হবে"]],"t":"وَأَ<g>نَّ</> <m>هَٰ</>ذَا صِ<m>رَٰ</>طِى مُسْتَقِي<k>مًۭا فَ</><h>ٱ</>تَّبِعُوهُ ۖ وَلَا تَتَّبِعُو<s>ا۟</> <h>ٱ</><l>ل</>سُّبُلَ فَتَفَرَّقَ بِكُمْ عَ<k>ن سَ</>بِيلِ<m>هِۦ</> ۚ <m>ذَٰ</>لِكُمْ وَصَّ<m>ىٰ</><f>كُم بِ</><m>هِۦ</> لَعَلَّكُمْ تَتَّ<p>قُو</>نَ"},{"n":154,"w":[["ثُمَّ","thumma","Moreover","এরপর"],["ءَاتَيْنَا","ātaynā","We gave","আমরা দিয়েছি"],["مُوسَى","mūsā","Musa","মূসাকে"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","কিতাব"],["تَمَامًا","tamāman","completing (Our Favor)","সম্পূর্ণ (নিয়ামাত)"],["عَلَى","‘alā","on","(তার) জন্যে"],["ٱلَّذِىٓ","alladhī","the one who","যে"],["أَحْسَنَ","aḥsana","did good","সৎ কাজ করে"],["وَتَفْصِيلًۭا","watafṣīlan","and an explanation","ও (তা ছিলো) বিস্তারিত বিবরণ"],["لِّكُلِّ","likulli","of every","জন্যে সব"],["شَىْءٍۢ","shayin","thing","(জরুরী) জিনিসের"],["وَهُدًۭى","w