طُرَّ غَيْرَ بَا<d>غٍۢ وَ</>لَا عَا<k>دٍۢ فَ</>إِ<g>نَّ</> رَبَّكَ غَفُو<w>رٌۭ رَّ</><p>حِي</>مٌۭ"},{"n":146,"w":[["وَعَلَى","wa‘alā","And to","এবং (তাদের) উপর"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["هَادُوا۟","hādū","are Jews","ইয়াহুদী হয়েছে"],["حَرَّمْنَا","ḥarramnā","We forbade","নিষিদ্ধ করেছিলাম আমরা"],["كُلَّ","kulla","every","সব"],["ذِى","dhī","(animal) with","বিশিষ্ট"],["ظُفُرٍۢ ۖ","ẓufurin","claws","নখর (জন্তু)"],["وَمِنَ","wamina","and of","এবং মধ্য হতে"],["ٱلْبَقَرِ","l-baqari","the cows","গরু"],["وَٱلْغَنَمِ","wal-ghanami","and the sheep","ও ছাগলের"],["حَرَّمْنَا","ḥarramnā","We forbade","হারাম করেছিলাম আমরা"],["عَلَيْهِمْ","‘alayhim","to them","উপর তাদের"],["شُحُومَهُمَآ","shuḥūmahumā","their fat","চর্বিগুলো উভয়ের"],["إِلَّا","illā","except","তবে"],["مَا","mā","what","যা"],["حَمَلَتْ","ḥamalat","carried","বহন করে"],["ظُهُورُهُمَآ","ẓuhūruhumā","their backs","পিঠগুলো উভয়ের"],["أَوِ","awi","or","বা"],["ٱلْحَوَايَآ","l-ḥawāyā","the entrails","অন্ত্রগুলো"],["أَوْ","aw","or","অথবা"],["مَا","mā","what","যা"],["ٱخْتَلَطَ","ikh'talaṭa","(is) joined","মিলিত হয়ে থাকে"],["بِعَظْمٍۢ ۚ","bi‘aẓmin","with the bone","সাথে হাড়ের (সেটা ভিন্ন কথা)"],["ذَٰلِكَ","dhālika","That","এটা"],["جَزَيْنَـٰهُم","jazaynāhum","(is) their recompense","আমরা প্রতিফল দিয়েছি তাদেরকে"],["بِبَغْيِهِمْ ۖ","bibaghyihim","for their rebellion","কারণে অবাধ্যতার তাদের"],["وَإِنَّا","wa-innā","And indeed, We","এবং নিশ্চয়ই আমরা"],["لَصَـٰدِقُونَ","laṣādiqūna","[surely] are truthful","অবশ্যই সত্যবাদী"]],"t":"وَعَلَى <h>ٱ</>لَّذِينَ هَادُو<s>ا۟</> حَرَّمْنَا كُلَّ ذِى ظُفُ<d>رٍۢ ۖ وَ</>مِنَ <h>ٱ</>لْبَقَرِ وَ<h>ٱ</>لْغَنَمِ حَرَّمْنَا عَلَيْهِمْ شُحُومَهُ<o>مَآ</> إِلَّا مَا حَمَلَتْ ظُهُورُهُ<o>مَآ</> أَوِ <h>ٱ</>لْحَوَا<o>يَآ</> أَوْ مَا <h>ٱ</>خْتَلَطَ بِعَظْ<k>مٍۢ ۚ ذَٰ</>لِكَ جَزَيْ<m>نَٰ</><f>هُم بِ</>بَغْيِهِمْ ۖ وَإِ<g>نَّ</>ا لَ<m>صَٰ</>دِ<p>قُو</>نَ"},{"n":147,"w":[["فَإِن","fa-in","But if","অতঃপর যদি"],["كَذَّبُوكَ","kadhabūka","they deny you","তোমাকে তারা মিথ্যা প্রতিপন্ন করে"],["فَقُل","faqul","then say","তবে বলো"],["رَّبُّكُمْ","rabbukum","Your Lord","\"রব তোমাদের"],["ذُو","dhū","(is the) Possessor","অধিকারী"],["رَحْمَةٍۢ","raḥmatin","(of) Mercy","দয়ার"],["وَٰسِعَةٍۢ","wāsi‘atin","Vast","সুপ্রশস্ত ও ব্যাপক"],["وَلَا","walā","but not","কিন্তু না"],["يُرَدُّ","yuraddu","will be turned back","ফিরানো যায়"],["بَأْسُهُۥ","basuhu","His wrath","শাস্তি তাঁর"],["عَنِ","‘ani","from","থেকে"],["ٱلْقَوْمِ","l-qawmi","the people","সম্প্রদায়ের"],["ٱلْمُجْرِمِينَ","l-muj'rimīna","(who are) criminals","(যারা) অপরাধী\""]],"t":"فَإِ<k>ن كَ</>ذَّبُوكَ فَقُ<r>ل</> رَّبُّكُمْ ذُو رَحْمَ<d>ةٍۢ وَٰ</>سِعَ<d>ةٍۢ وَ</>لَا يُرَدُّ بَأْسُهُ<m>ۥ</> عَنِ <h>ٱ</>لْقَوْمِ <h>ٱ</>لْمُ<q>جْ</>رِ<p>مِي</>نَ"},{"n":148,"w":[["سَيَقُولُ","sayaqūlu","Will say","শীঘ্রই বলবে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["أَشْرَكُوا۟","ashrakū","associate partners (with Allah)","শিরক করেছে"],["لَوْ","law","If","\"যদি"],["شَآءَ","shāa","Had willed","ইচ্ছে করতেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ্‌"],["مَآ","mā","not","না"],["أَشْرَكْنَا","ashraknā","we (would) have associated partners (with Allah)","শিরক করতাম আমরা"],["وَلَآ","walā","and not","এবং না"],["ءَابَآؤُنَا","ābāunā","our forefathers","পূর্ব পুরুষরা আমাদের"],["وَلَا","walā","and not","এবং না"],["حَرَّمْنَا","ḥarramnā","we (would) have forbidden","নিষিদ্ধ করতাম আমরা"],["مِن","min","[of]","কোনো"],["شَىْءٍۢ ۚ","shayin","anything","কিছুই\""],["كَذَٰلِكَ","kadhālika","Likewise","এভাবে"],["كَذَّبَ","kadhaba","denied","মিথ্যা বলেছে"],["ٱلَّذِينَ","alladhīna","those who","(তারাও) যারা"],["مِن","min","(were from)","থেকে"],["قَبْلِهِمْ","qablihim","before them","পূর্ব তাদের  (ছিলো)"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["ذَاقُوا۟","dhāqū","they tasted","তারা স্বাদ নিয়েছে"],["بَأْسَنَا ۗ","basanā","Our wrath","শাস্তির আমাদের"],["قُلْ","qul","Say","বলো"],["هَلْ","hal","Is","\"কি (আছে)"],["عِندَكُم","‘indakum","with you","কাছে তোমাদের"],["مِّنْ","min","[of]","কোনো"],["عِلْمٍۢ","‘il'min","any knowledge","জ্ঞান"],["فَتُخْرِجُوهُ","fatukh'rijūhu","then produce it","তবে তোমরা পেশ করো তা"],["لَنَآ ۖ","lanā","for us","কাছে আমাদের"],["إِن","in","Not","(প্রকৃতপক্ষে) না"],["تَتَّبِعُونَ","tattabi‘ūna","you follow","তোমরা অনুসরণ করো"],["إِلَّا","illā","except","এ ছাড়া"],["ٱلظَّنَّ","l-ẓana","the assumption","অনুমানের"],["وَإِنْ","wa-in","and not","এবং না"],["أَنتُمْ","antum","you (do)","তোমরা"],["إِلَّا","illā","but","এ ছাড়া"],["تَخْرُصُونَ","takhruṣūna","guess","মিথ্যা রচনা করো\""]],"t":"سَيَقُولُ <h>ٱ</>لَّذِينَ أَشْرَكُو<s>ا۟</> لَوْ <o>شَآ</>ءَ <h>ٱ</>للَّهُ <o>مَآ</> أَشْرَكْنَا وَ<o>لَآ</> ءَا<o>بَآ</>ؤُنَا وَلَا حَرَّمْنَا مِ<k>ن شَىْءٍۢ ۚ كَ</><m>ذَٰ</>لِكَ كَذَّبَ <h>ٱ</>لَّذِينَ مِ<k>ن قَ</><q>بْ</>لِهِمْ حَتَّىٰ ذَاقُو<s>ا۟</> بَأْسَنَا ۗ قُلْ هَلْ عِ<k>ندَ</><y>كُم مِّ</>نْ عِلْ<k>مٍۢ فَ</>تُخْرِجُوهُ لَ<o>نَآ ۖ</> إِ<k>ن تَ</>تَّبِعُونَ إِلَّا <h>ٱ</><l>ل</>ظَّ<g>نَّ</> وَإِنْ أَ<k>نتُ</>مْ إِلَّا تَخْرُ<p>صُو</>نَ"},{"n":149,"w":[["قُلْ","qul","Say","বলো"],["فَلِلَّهِ","falillahi","With Allah","\"কেবল জন্যে আল্লাহ্‌রই"],["ٱلْحُجَّةُ","l-ḥujatu","(is) the argument ","যুক্তিপ্রমাণ"],["ٱلْبَـٰلِغَةُ ۖ","l-bālighatu","the conclusive","পরিপূর্ণ ও চূড়ান্ত"],["فَلَوْ","falaw","And if","অতঃপর যদি"],["شَآءَ","shāa","He (had) willed","ইচ্ছে করতেন"],["لَهَدَىٰكُمْ","lahadākum","surely He (would) have guided you","অবশ্যই সৎপথে পরিচালিত করতেন তোমাদের"],["أَجْمَعِينَ","ajma‘īna","all","সকলকে\""]],"t":"قُلْ فَلِلَّهِ <h>ٱ</>لْحُجَّةُ <h>ٱ</>لْ<m>بَٰ</>لِغَةُ ۖ فَلَوْ <o>شَآ</>ءَ لَهَدَ<m>ىٰ</>كُمْ أَ<q>جْ</>مَ<p>عِي</>نَ"},{"n":150,"w":[["قُلْ","qul","Say","বলো"],["هَلُمَّ","halumma","Bring forward","\"উপস্হিত করো"],["شُهَدَآءَكُمُ","shuhadāakumu","your witnesses","সাক্ষীদেরকে তোমাদের"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["يَشْهَدُونَ","yashhadūna","testify","সাক্ষ্য দেয়"],["أَنَّ","anna","that","যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["حَرَّمَ","ḥarrama","prohibited","নিষিদ্ধ করেছেন"],["هَـٰذَا ۖ","hādhā","this","এটা\""],["فَإِن","fa-in","Then if","অত