{"n":6,"a":[{"n":1,"w":[["ٱلْحَمْدُ","al-ḥamdu","(All) the praises and thanks","সকল প্রশংসা"],["لِلَّهِ","lillahi","(be) to Allah","জন্যে আল্লাহরই"],["ٱلَّذِى","alladhī","the One Who","যিনি"],["خَلَقَ","khalaqa","created","সৃষ্টি করেছেন"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশসমূহ"],["وَٱلْأَرْضَ","wal-arḍa","and the earth","ও পৃথিবী"],["وَجَعَلَ","waja‘ala","and made","ও বানিয়েছেন"],["ٱلظُّلُمَـٰتِ","l-ẓulumāti","the darkness[es]","অন্ধকারসমূহ"],["وَٱلنُّورَ ۖ","wal-nūra","and the light","ও আলো"],["ثُمَّ","thumma","Then","এরপরও"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieved","অবিশ্বাস করেছে"],["بِرَبِّهِمْ","birabbihim","in their Lord","প্রতি রবের তাদের"],["يَعْدِلُونَ","ya‘dilūna","equate others with Him","তাঁর সমকক্ষ দাঁড় করায় (অন্যান্যদেরকে)"]],"t":"ٱلْحَمْدُ لِلَّهِ <h>ٱ</>لَّذِى خَلَقَ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضَ وَجَعَلَ <h>ٱ</><l>ل</>ظُّلُ<m>مَٰ</>تِ وَ<h>ٱ</><l>ل</><g>نُّ</>ورَ ۖ ثُ<g>مَّ</> <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> بِرَبِّهِمْ يَعْدِ<p>لُو</>نَ"},{"n":2,"w":[["هُوَ","huwa","He","তিনিই (আল্লাহ)"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["خَلَقَكُم","khalaqakum","created you","সৃষ্টি করেছেন তোমাদের"],["مِّن","min","from","হতে"],["طِينٍۢ","ṭīnin","clay","মাটি"],["ثُمَّ","thumma","then","এরপর"],["قَضَىٰٓ","qaḍā","He decreed","নির্দিষ্ট করেছেন"],["أَجَلًۭا ۖ","ajalan","a term ","একটি মেয়াদ (জীবনকাল)"],["وَأَجَلٌۭ","wa-ajalun","and a term","এবং (এছাড়াও) একটি মেয়াদ (অর্থাৎ ক্বিয়ামাত)"],["مُّسَمًّى","musamman","specified","নির্ধারিত (আছে)"],["عِندَهُۥ ۖ","‘indahu","with Him","কাছে তাঁর"],["ثُمَّ","thumma","yet","এরপরও"],["أَنتُمْ","antum","you","তোমরা"],["تَمْتَرُونَ","tamtarūna","doubt","সন্দেহ করছো"]],"t":"هُوَ <h>ٱ</>لَّذِى خَلَقَ<y>كُم مِّ</><k>ن طِينٍۢ ثُ</><g>مَّ</> قَضَ<o>ىٰٓ</> أَجَلًۭ<d>ا ۖ وَ</>أَجَ<d>لٌۭ مُّ</>سَ<g>مًّ</>ى عِ<k>ندَ</>هُ<m>ۥ</> ۖ ثُ<g>مَّ</> أَ<k>نتُ</>مْ تَمْتَ<p>رُو</>نَ"},{"n":3,"w":[["وَهُوَ","wahuwa","And He","এবং তিনিই"],["ٱللَّهُ","l-lahu","(is) Allah","আল্লাহ (যিনি)"],["فِى","fī","in","আছেন"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশসমূহে"],["وَفِى","wafī","and in","এবং আছেন"],["ٱلْأَرْضِ ۖ","l-arḍi","the earth","পৃথিবীতে"],["يَعْلَمُ","ya‘lamu","He knows","তিনি জানেন"],["سِرَّكُمْ","sirrakum","your secret","গোপন বিষয় তোমাদের"],["وَجَهْرَكُمْ","wajahrakum","and what you make public","ও প্রকাশ্য বিষয় তোমাদের"],["وَيَعْلَمُ","waya‘lamu","and He knows","এবং তিনি জানেন"],["مَا","mā","what","যা"],["تَكْسِبُونَ","taksibūna","you earn","তোমরা অর্জন করো"]],"t":"وَهُوَ <h>ٱ</>للَّهُ فِى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَفِى <h>ٱ</>لْأَرْضِ ۖ يَعْلَمُ سِرَّكُمْ وَجَهْرَكُمْ وَيَعْلَمُ مَا تَكْسِ<p>بُو</>نَ"},{"n":4,"w":[["وَمَا","wamā","And not","এবং না"],["تَأْتِيهِم","tatīhim","comes to them","কাছে এসেছে তাদের"],["مِّنْ","min","[of]","কোনো"],["ءَايَةٍۢ","āyatin","any sign","(এমন) নিদর্শন"],["مِّنْ","min","from","মধ্য হতে"],["ءَايَـٰتِ","āyāti","(the) Signs","নিদর্শনগুলোর"],["رَبِّهِمْ","rabbihim","(of) their Lord","রবের তাদের"],["إِلَّا","illā","but","এ ছাড়া যে"],["كَانُوا۟","kānū","they are","তারা হয়েছিলো"],["عَنْهَا","‘anhā","from it","হতে তা"],["مُعْرِضِينَ","mu‘'riḍīna","turning away","বিমুখ"]],"t":"وَمَا تَأْتِي<y>هِم مِّ</>نْ ءَايَ<d>ةٍۢ مِّ</>نْ ءَا<m>يَٰ</>تِ رَبِّهِمْ إِلَّا كَانُو<s>ا۟</> عَنْهَا مُعْرِ<p>ضِي</>نَ"},{"n":5,"w":[["فَقَدْ","faqad","Then indeed","সুতরাং নিশ্চয়ই"],["كَذَّبُوا۟","kadhabū","they denied","তারা মিথ্যা প্রতিপন্ন করেছে"],["بِٱلْحَقِّ","bil-ḥaqi","the truth","প্রতি সত্যের"],["لَمَّا","lammā","when","যখনই"],["جَآءَهُمْ ۖ","jāahum","it came to them","কাছে তা এসেছে তাদের"],["فَسَوْفَ","fasawfa","but soon","সুতরাং শীঘ্রই"],["يَأْتِيهِمْ","yatīhim","will come to them","কাছে আসবে তাদের"],["أَنۢبَـٰٓؤُا۟","anbāu","news","সংবাদ"],["مَا","mā","(of) what","ঐ বিষয়ের"],["كَانُوا۟","kānū","they used to","তারা ছিলো"],["بِهِۦ","bihi","[at it]","নিয়ে যা"],["يَسْتَهْزِءُونَ","yastahziūna","mock","ঠাট্টা বিদ্রুপ করতো"]],"t":"فَقَ<q>دْ</> كَذَّبُو<s>ا۟</> بِ<h>ٱ</>لْحَقِّ لَ<g>مَّ</>ا <o>جَآ</>ءَهُمْ ۖ فَسَوْفَ يَأْتِيهِمْ أَ<i>نۢبَٰٓ</>ؤُ<s>ا۟</> مَا كَانُو<s>ا۟</> بِ<m>هِۦ</> يَسْتَهْزِ<p>ءُو</>نَ"},{"n":6,"w":[["أَلَمْ","alam","Did not","কি নি"],["يَرَوْا۟","yaraw","they see","তারা দেখে"],["كَمْ","kam","how many","কত (জাতিকে)"],["أَهْلَكْنَا","ahlaknā","We destroyed","ধ্বংস করেছি আমরা"],["مِن","min","from","থেকে"],["قَبْلِهِم","qablihim","before them","পূর্ব তাদের"],["مِّن","min","of","হতে"],["قَرْنٍۢ","qarnin","generations","মানবগোষ্ঠী"],["مَّكَّنَّـٰهُمْ","makkannāhum","We had established them","আমরা প্রতিষ্ঠিত করেছিলাম তাদের"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর (এমনভাবে)"],["مَا","mā","what","যেমনটি"],["لَمْ","lam","not","না"],["نُمَكِّن","numakkin","We (have) established","আমরা প্রতিষ্ঠিত করেছি"],["لَّكُمْ","lakum","for you","তোমাদেরকে"],["وَأَرْسَلْنَا","wa-arsalnā","And We sent","এবং আমরা পাঠিয়েছিলাম"],["ٱلسَّمَآءَ","l-samāa","(rain from) the sky","আকাশ (থেকে)"],["عَلَيْهِم","‘alayhim","upon them","উপর তাদের"],["مِّدْرَارًۭا","mid'rāran","showering abundantly","মুষলধারে বৃষ্টি"],["وَجَعَلْنَا","waja‘alnā","and We made","ও করেছিলাম আমরা"],["ٱلْأَنْهَـٰرَ","l-anhāra","the rivers","নদীসমূহকে"],["تَجْرِى","tajrī","flow","প্রবাহিত"],["مِن","min","from","থেকে"],["تَحْتِهِمْ","taḥtihim","underneath them","নিচ তাদের(ভূমি)"],["فَأَهْلَكْنَـٰهُم","fa-ahlaknāhum","Then We destroyed them","অতঃপর আমরা ধ্বংস করেছি তাদের"],["بِذُنُوبِهِمْ","bidhunūbihim","for their sins","কারণে পাপের তাদের"],["وَأَنشَأْنَا","wa-anshanā","and We raised","ও সৃষ্টি করেছি আমরা"],["مِنۢ","min","from","থেকে"],["بَعْدِهِمْ","ba‘dihim","after them","পর তাদের"],["قَرْنًا","qarnan","generations","জাতিকে"],["ءَاخَرِينَ","ākharīna","other","অন্যান্য"]],"t":"أَلَمْ يَرَوْ<s>ا۟</> كَمْ أَهْلَكْنَا مِ<k>ن قَ</><q>بْ</>لِ<y>هِم مِّ</><k>ن قَ</>رْ<d>نٍۢ مَّ</>كَّ<g>نَّٰ</>هُمْ فِى <h>ٱ</>لْأَرْضِ مَا لَمْ نُمَ<w>كِّن لَّ</>كُمْ وَأَرْسَلْنَا <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءَ عَلَيْ<y>هِم مِّ</><q>دْ</>رَا<d>رًۭا وَ</>جَعَلْنَا <h>ٱ</>لْأَنْ<m>هَٰ</>رَ تَ<q>جْ</>رِى مِ<k>ن تَ</>حْتِهِمْ فَأَهْلَكْ<m>نَٰ</><f>هُم بِ</>ذُنُوبِهِمْ وَأَ<k>نشَ</>أْنَا <i>مِنۢ بَ</>عْدِهِمْ قَرْنًا ءَاخَ<p>رِي</>نَ"},{"n":7,"w":[["وَلَوْ","walaw","And (even) if","এবং যদি"],["نَزَّلْنَا","nazzalnā","We (had) sent down","অবতীর্ণ করতাম আমরা"],["عَلَيْكَ","‘alayka","to you","উপর তোমার"],["كِتَـٰبًۭا","kitāban","a written Scripture","(লিখিত) কিতাব"],["فِى","fī","in","মধ্যে"],["قِرْطَاسٍۢ","qir'ṭāsin","a parchment","কাগজের"],["فَلَمَسُوهُ","falamasūhu","and they touched it","অতঃপর তারা স্পর্শ করতো তা"],["بِأَيْدِيهِمْ","bi-aydīhim","with their hands","দিয়ে হাত তাদের"],["لَقَالَ","laqāla","surely (would) have said","(তবুও) অবশ্যই বলতো"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوٓا۟","kafarū","disbelieved","অবিশ্বাস করেছে"],["إِنْ","in","Not","\"নয়"],["هَـٰذَآ","hādhā","(is) this","\"এটা"],["إِلَّا","illā","but","এ ছাড়া যে"],["سِحْرٌۭ","siḥ'run","magic","জাদু\""],["مُّبِينٌۭ","mubīnun","clear","সুস্পষ্ট\""]],"t":"وَلَوْ نَزَّلْنَا عَلَيْكَ كِ<m>تَٰ</><k>بًۭا فِ</>ى قِرْطَا<k>سٍۢ فَ</>لَمَسُوهُ بِأَيْدِيهِمْ لَقَالَ <h>ٱ</>لَّذِينَ كَفَ<o>رُوٓ</><s>ا۟</> إِنْ <m>هَٰ</><o>ذَآ</> إِلَّا سِحْ<d>رٌۭ مُّ</><p>بِي</>نٌۭ"},{"n":8,"w":[["وَقَالُوا۟","waqālū","And they said","এবং তারা বলে"],["لَوْلَآ","lawlā","Why has not been","\"কেন না"],["أُنزِلَ","unzila","sent down","অবতীর্ণ করা হলো"],["عَلَيْهِ","‘alayhi","to him","কাছে তার"],["مَلَكٌۭ ۖ","malakun","an Angel","ফেরেশতা (সাক্ষী রূপে)\""],["وَلَوْ","walaw","And if","এবং যদি"],["أَنزَلْنَا","anzalnā","We (had) sent down","অবতীর্ণ করতাম আমরা"],["مَلَكًۭا","malakan","an Angel","ফেরেশতা (সাক্ষীরূপে)"],["لَّقُضِىَ","laquḍiya","surely (would) have been decided","অবশ্যই মীমাংসা হয়ে যেতো"],["ٱلْأَمْرُ","l-amru","the matter","(সব) বিষয়ের"],["ثُمَّ","thumma","then","এরপর"],["لَا","lā","no","না"],["يُنظَرُونَ","yunẓarūna","respite would have been granted to them","তাদের অবকাশ দেয়া হতো"]],"t":"وَقَالُو<s>ا۟</> لَوْ<o>لَآ</> أُ<k>نزِ</>لَ عَلَيْهِ مَلَ<d>كٌۭ ۖ وَ</>لَوْ أَ<k>نزَ</>لْنَا مَلَ<w>كًۭا لَّ</>قُضِىَ <h>ٱ</>لْأَمْرُ ثُ<g>مَّ</> لَا يُ<k>نظَ</><p>رُو</>نَ"},{"n":9,"w":[["وَلَوْ","walaw","And if","এবং যদি"],["جَعَلْنَـٰهُ","ja‘alnāhu","We had made him","আমরা করতাম তাকে"],["مَلَكًۭا","malakan","an Angel","ফেরেশতা"],["لَّجَعَلْنَـٰهُ","laja‘alnāhu","certainly We (would) have made him","অবশ্যই আমরা বানাতাম তাকে"],["رَجُلًۭا","rajulan","a man","মানুষরূপে"],["وَلَلَبَسْنَا","walalabasnā","and certainly We (would) have obscured","এবং অবশ্যই বিভ্রমে ফেলতাম আমরা"],["عَلَيْهِم","‘alayhim","to them","উপর তাদের"],["مَّا","mā","what","যেমন"],["يَلْبِسُونَ","yalbisūna","they are obscuring","তারা বিভ্রমে পড়েছে (এমন)"]],"t":"وَلَوْ جَعَلْ<m>نَٰ</>هُ مَلَ<w>كًۭا لَّ</>جَعَلْ<m>نَٰ</>هُ رَجُلًۭ<d>ا وَ</>لَلَبَسْنَا عَلَيْ<y>هِم مَّ</>ا يَلْبِ<p>سُو</>نَ"},{"n":10,"w":[["وَلَقَدِ","walaqadi","And indeed","এবং নিশ্চয়ই"],["ٱسْتُهْزِئَ","us'tuh'zi-a","were mocked","বিদ্রুপ করা হয়েছে"],["بِرُسُلٍۢ","birusulin","Messengers","সাথে রাসূলদের"],["مِّن","min","from","থেকে"],["قَبْلِكَ","qablika","before you","পূর্ব তোমার"],["فَحَاقَ","faḥāqa","but surrounded","তখন ঘিরে ফেলেছে"],["بِٱلَّذِينَ","bi-alladhīna","those who","(তাদের)  উপর যারা"],["سَخِرُوا۟","sakhirū","scoffed","ঠাট্টা করেছিলো"],["مِنْهُم","min'hum","of them","মধ্যে হতে তাদের"],["مَّا","mā","what","ঐ বিষয়"],["كَانُوا۟","kānū","they used to","তারা ছিলো"],["بِهِۦ","bihi","[at it]","নিয়ে যা"],["يَسْتَهْزِءُونَ","yastahziūna","mock","ঠাট্টা বিদ্রুপ করতো"]],"t":"وَلَقَدِ <h>ٱ</>سْتُهْزِئَ بِرُسُ<d>لٍۢ مِّ</><k>ن قَ</><q>بْ</>لِكَ فَحَاقَ بِ<h>ٱ</>لَّذِينَ سَخِرُو<s>ا۟</> مِنْ<y>هُم مَّ</>ا كَانُو<s>ا۟</> بِ<m>هِۦ</> يَسْتَهْزِ<p>ءُو</>نَ"},{"n":11,"w":[["قُلْ","qul","Say","বলো"],["سِيرُوا۟","sīrū","Travel","\"তোমরা ভ্রমণ করো"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["ثُمَّ","thumma","and","এরপর"],["ٱنظُرُوا۟","unẓurū","see","তোমরা দেখো"],["كَيْفَ","kayfa","how","কেমন"],["كَانَ","kāna","was","ছিলো"],["عَـٰقِبَةُ","‘āqibatu","(the) end","পরিণাম"],["ٱلْمُكَذِّبِينَ","l-mukadhibīna","(of) the rejecters","সত্য অমান্যকারীদের\""]],"t":"قُلْ سِيرُو<s>ا۟</> فِى <h>ٱ</>لْأَرْضِ ثُ<g>مَّ</> <h>ٱ</><k>نظُ</>رُو<s>ا۟</> كَيْفَ كَانَ <m>عَٰ</>قِبَةُ <h>ٱ</>لْمُكَذِّ<p>بِي</>نَ"},{"n":12,"w":[["قُل","qul","Say","বলো"],["لِّمَن","liman","To whom (belongs)","\"কার (মালিকানায়)"],["مَّا","mā","what","যাকিছু"],["فِى","fī","(is) in","মধ্যে (আছে)"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশসমূহের"],["وَٱلْأَرْضِ ۖ","wal-arḍi","and the earth","ও পৃথিবীর\""],["قُل","qul","Say","বলো"],["لِّلَّهِ ۚ","lillahi","To Allah","\"জন্যে আল্লাহরই (মালিকানায়)\""],["كَتَبَ","kataba","He has decreed","তিনি নির্ধারিত করে দিয়েছেন"],["عَلَىٰ","‘alā","upon","উপর"],["نَفْسِهِ","nafsihi","Himself","নিজের তাঁর"],["ٱلرَّحْمَةَ ۚ","l-raḥmata","the Mercy","দয়া করা"],["لَيَجْمَعَنَّكُمْ","layajma‘annakum","Surely He will assemble you","নিশ্চয়ই একত্র করবেন তোমাদের"],["إِلَىٰ","ilā","on","দিকে"],["يَوْمِ","yawmi","(the) Day","দিনে"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) the Resurrection","ক্বিয়ামাতের"],["لَا","lā","(there is) no","নেই"],["رَيْبَ","rayba","doubt","সন্দেহ"],["فِيهِ ۚ","fīhi","about it","মধ্যে তার (বিন্দুমাত্র)"],["ٱلَّذِينَ","alladhīna","Those who","যারা"],["خَسِرُوٓا۟","khasirū","have lost","ক্ষতিগ্রস্ত করেছে"],["أَنفُسَهُمْ","anfusahum","themselves","নিজেদেরকে তাদের"],["فَهُمْ","fahum","then they","অতঃপর তারা"],["لَا","lā","(do) not","না"],["يُؤْمِنُونَ","yu'minūna","believe","ঈমান আনবে"]],"t":"قُل لِّ<d>مَن مَّ</>ا فِى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ ۖ قُل لِّلَّهِ ۚ كَتَبَ عَلَىٰ نَفْسِهِ <h>ٱ</><l>ل</>رَّحْمَةَ ۚ لَيَ<q>جْ</>مَعَ<g>نَّ</>كُمْ إِلَىٰ يَوْمِ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ لَا رَيْبَ فِيهِ ۚ <h>ٱ</>لَّذِينَ خَسِ<o>رُوٓ</><s>ا۟</> أَ<k>نفُ</>سَهُمْ فَهُمْ لَا يُؤْمِ<p>نُو</>نَ"},{"n":13,"w":[["۞ وَلَهُۥ","walahu","And for Him","এবং জন্যে তাঁরই"],["مَا","mā","(is) whatever","যাকিছু"],["سَكَنَ","sakana","dwells","স্থিতি লাভ করে"],["فِى","fī","in","মধ্যে"],["ٱلَّيْلِ","al-layli","the night","রাতের"],["وَٱلنَّهَارِ ۚ","wal-nahāri","and the day","ও দিনের"],["وَهُوَ","wahuwa","and He","এবং তিনিই"],["ٱلسَّمِيعُ","l-samī‘u","(is) All-Hearing","সবকিছু শুনেন"],["ٱلْعَلِيمُ","l-‘alīmu","All-Knowing","সবকিছু জানেন"]],"t":"۞ وَلَهُ<m>ۥ</> مَا سَكَنَ فِى <h>ٱ</>لَّيْلِ وَ<h>ٱ</><l>ل</><g>نَّ</>هَارِ ۚ وَهُوَ <h>ٱ</><l>ل</>سَّمِيعُ <h>ٱ</>لْعَ<p>لِي</>مُ"},{"n":14,"w":[["قُلْ","qul","Say","বলো"],["أَغَيْرَ","aghayra","Is it other than","\"কি ছাড়া"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌"],["أَتَّخِذُ","attakhidhu","I (should) take","গ্রহণ করবো আমি"],["وَلِيًّۭا","waliyyan","(as) a protector","অভিভাবক (অন্য)"],["فَاطِرِ","fāṭiri","Creator","(অথচ আল্লাহ) স্রষ্টা"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশসমূহের"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীর"],["وَهُوَ","wahuwa","while (it is) He","এবং তিনিই"],["يُطْعِمُ","yuṭ'‘imu","Who feeds","খাওয়ান"],["وَلَا","walā","and not","কিন্তু না"],["يُطْعَمُ ۗ","yuṭ'‘amu","He is fed","খাবার দেয়া হয় তাঁকে\""],["قُلْ","qul","Say","বলো"],["إِنِّىٓ","innī","Indeed I","\"নিশ্চয়ই আমি"],["أُمِرْتُ","umir'tu","[I] am commanded","আমাকে আদেশ দেয়া হয়েছে"],["أَنْ","an","that","যে"],["أَكُونَ","akūna","I be","হই আমি"],["أَوَّلَ","awwala","(the) first","প্রথম"],["مَنْ","man","who","যে"],["أَسْلَمَ ۖ","aslama","submits (to Allah)","আত্মসমর্পণ করে"],["وَلَا","walā","and not","এবং না"],["تَكُونَنَّ","takūnanna","be","তুমি কিছুতেই হয়ো"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْمُشْرِكِينَ","l-mush'rikīna","the polytheists","মুশরিকদের\""]],"t":"قُلْ أَغَيْرَ <h>ٱ</>للَّهِ أَتَّخِذُ وَلِ<k>يًّۭا فَ</>اطِرِ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ وَهُوَ يُ<q>طْ</>عِمُ وَلَا يُ<q>طْ</>عَمُ ۗ قُلْ إِ<g>نِّ</><o>ىٓ</> أُمِرْتُ أَنْ أَكُونَ أَوَّلَ مَنْ أَسْلَمَ ۖ وَلَا تَكُونَ<g>نَّ</> مِنَ <h>ٱ</>لْمُشْرِ<p>كِي</>نَ"},{"n":15,"w":[["قُلْ","qul","Say","বলো"],["إِنِّىٓ","innī","Indeed, I","\"নিশ্চয়ই আমি"],["أَخَافُ","akhāfu","[I] fear","ভয় করি আমি"],["إِنْ","in","if","যদি"],["عَصَيْتُ","‘aṣaytu","I disobeyed","আমি অবাধ্য হই"],["رَبِّى","rabbī","my Lord","আমার রবের"],["عَذَابَ","‘adhāba","punishment","শাস্তির"],["يَوْمٍ","yawmin","(of) a Day","দিনের\""],["عَظِيمٍۢ","‘aẓīmin","Mighty","ভয়াবহ\""]],"t":"قُلْ إِ<g>نِّ</><o>ىٓ</> أَخَافُ إِنْ عَصَيْتُ رَبِّى عَذَابَ يَوْمٍ عَ<p>ظِي</>مٍۢ"},{"n":16,"w":[["مَّن","man","Whoever","যে"],["يُصْرَفْ","yuṣ'raf","is averted","রেহাই পেলো"],["عَنْهُ","‘anhu","from it","থেকে তা"],["يَوْمَئِذٍۢ","yawma-idhin","that Day","সেদিন"],["فَقَدْ","faqad","then surely","তবে নিশ্চয়ই"],["رَحِمَهُۥ ۚ","raḥimahu","He had Mercy on him","তিনি দয়া করলেন তাকে"],["وَذَٰلِكَ","wadhālika","And that","এবং এটা"],["ٱلْفَوْزُ","l-fawzu","(is) the success","সাফল্য"],["ٱلْمُبِينُ","l-mubīnu","(the) clear","সুস্পষ্ট"]],"t":"<d>مَّن يُ</>صْرَفْ عَنْهُ يَوْمَئِ<k>ذٍۢ فَ</>قَ<q>دْ</> رَحِمَهُ<m>ۥ</> ۚ وَ<m>ذَٰ</>لِكَ <h>ٱ</>لْفَوْزُ <h>ٱ</>لْمُ<p>بِي</>نُ"},{"n":17,"w":[["وَإِن","wa-in","And if","এবং যদি"],["يَمْسَسْكَ","yamsaska","touches you","তোমাকে স্পর্শ করেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["بِضُرٍّۢ","biḍurrin","with affliction","দিয়ে অনিষ্ট"],["فَلَا","falā","then no","তবে নেই"],["كَاشِفَ","kāshifa","remover","কোনো অপসারণকারী"],["لَهُۥٓ","lahu","of it","জন্যে তার"],["إِلَّا","illā","except","ছাড়া"],["هُوَ ۖ","huwa","Him","তিনি"],["وَإِن","wa-in","And if","এবং যদি"],["يَمْسَسْكَ","yamsaska","He touches you","তোমাকে স্পর্শ করেন"],["بِخَيْرٍۢ","bikhayrin","with good","দিয়ে কল্যাণ"],["فَهُوَ","fahuwa","then He","তবুও তিনি"],["عَلَىٰ","‘alā","(is) on","উপর"],["كُلِّ","kulli","every","সব"],["شَىْءٍۢ","shayin","thing","কিছুর"],["قَدِيرٌۭ","qadīrun","All-Powerful","সর্বশক্তিমান"]],"t":"وَ<d>إِن يَ</>مْسَسْكَ <h>ٱ</>للَّهُ بِضُ<k>رٍّۢ فَ</>لَا كَاشِفَ لَهُ<o>ۥٓ</> إِلَّا هُوَ ۖ وَ<d>إِن يَ</>مْسَسْكَ بِخَيْ<k>رٍۢ فَ</>هُوَ عَلَىٰ كُلِّ <k>شَىْءٍۢ قَ</><p>دِي</>رٌۭ"},{"n":18,"w":[["وَهُوَ","wahuwa","And He","এবং তিনি"],["ٱلْقَاهِرُ","l-qāhiru","(is) the Subjugator","পরাক্রমশালী"],["فَوْقَ","fawqa","over","উপর"],["عِبَادِهِۦ ۚ","‘ibādihi","His slaves","দাসদের তাঁর"],["وَهُوَ","wahuwa","And He","এবং তিনি"],["ٱلْحَكِيمُ","l-ḥakīmu","(is) the All-Wise","প্রজ্ঞাময়"],["ٱلْخَبِيرُ","l-khabīru","the All-Aware","খুবই অবহিত"]],"t":"وَهُوَ <h>ٱ</>لْقَاهِرُ فَوْقَ عِبَادِ<m>هِۦ</> ۚ وَهُوَ <h>ٱ</>لْحَكِيمُ <h>ٱ</>لْخَ<p>بِي</>رُ"},{"n":19,"w":[["قُلْ","qul","Say","বলো"],["أَىُّ","ayyu","What","\"কোনো"],["شَىْءٍ","shayin","thing","জিনিস"],["أَكْبَرُ","akbaru","(is) greatest","সবচেয়ে বড়"],["شَهَـٰدَةًۭ ۖ","shahādatan","(as) a testimony","সাক্ষ্য হিসেবে\""],["قُلِ","quli","Say","বলো"],["ٱللَّهُ ۖ","l-lahu","Allah","\"আল্লাহ"],["شَهِيدٌۢ","shahīdun","(is) Witness","সাক্ষী"],["بَيْنِى","baynī","between me","মাঝে আমার"],["وَبَيْنَكُمْ ۚ","wabaynakum","and between you","ও মাঝে তোমাদের"],["وَأُوحِىَ","waūḥiya","and has been revealed","এবং ওহী করা হয়েছে"],["إِلَىَّ","ilayya","to me","আমার প্রতি"],["هَـٰذَا","hādhā","this","এই"],["ٱلْقُرْءَانُ","l-qur'ānu","[the] Quran","কুরআন"],["لِأُنذِرَكُم","li-undhirakum","that I may warn you","যেন আমি সতর্ক করি তোমাদের"],["بِهِۦ","bihi","with it","দিয়ে তা"],["وَمَنۢ","waman","and whoever","এবং যাকে"],["بَلَغَ ۚ","balagha","it reaches","পৌঁছে (তা)"],["أَئِنَّكُمْ","a-innakum","Do you truly","কি নিশ্চয়ই তোমরা"],["لَتَشْهَدُونَ","latashhadūna","testify","অবশ্যই সাক্ষী দিচ্ছো"],["أَنَّ","anna","that","যে"],["مَعَ","ma‘a","with","সাথে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["ءَالِهَةً","ālihatan","(there are) gods","ইলাহ (আছে)"],["أُخْرَىٰ ۚ","ukh'rā","other","অন্য কোনো\""],["قُل","qul","Say","বলো"],["لَّآ","lā","Not","\"না\""],["أَشْهَدُ ۚ","ashhadu","(do) I testify","\"সাক্ষী দিই আমি\""],["قُلْ","qul","Say","বলো"],["إِنَّمَا","innamā","Only","\"প্রকৃতপক্ষে"],["هُوَ","huwa","He","তিনিই"],["إِلَـٰهٌۭ","ilāhun","(is) God","ইলাহ"],["وَٰحِدٌۭ","wāḥidun","One","একই"],["وَإِنَّنِى","wa-innanī","and indeed, I am","এবং নিশ্চয়ই আমি"],["بَرِىٓءٌۭ","barīon","free","দায়িত্বমুক্ত"],["مِّمَّا","mimmā","of what","(তা) হতে যা"],["تُشْرِكُونَ","tush'rikūna","you associate (with Him)","তোমরা শিরক করছো"]],"t":"قُلْ أَىُّ شَىْءٍ أَكْبَرُ شَ<m>هَٰ</>دَ<k>ةًۭ ۖ قُ</>لِ <h>ٱ</>للَّهُ ۖ شَهِي<i>دٌۢ بَ</>يْنِى وَبَيْنَكُمْ ۚ وَأُوحِىَ إِلَىَّ <m>هَٰ</>ذَا <h>ٱ</>لْقُرْءَانُ لِأُ<k>نذِ</>رَ<f>كُم بِ</><m>هِۦ</> وَ<i>مَنۢ بَ</>لَغَ ۚ أَئِ<g>نَّ</>كُمْ لَتَشْهَدُونَ أَ<g>نَّ</> مَعَ <h>ٱ</>للَّهِ ءَالِهَةً أُخْرَىٰ ۚ قُل <o>لَّآ</> أَشْهَدُ ۚ قُلْ إِ<g>نَّ</>مَا هُوَ إِ<m>لَٰ</><d>هٌۭ وَٰحِدٌۭ وَ</>إِ<g>نَّ</>نِى بَ<o>رِىٓ</><d>ءٌۭ مِّ</><g>مَّ</>ا تُشْرِ<p>كُو</>نَ"},{"n":20,"w":[["ٱلَّذِينَ","alladhīna","Those (to) whom","যাদেরকে"],["ءَاتَيْنَـٰهُمُ","ātaynāhumu","We have given them","আমরা দিয়েছি তাদের"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","কিতাব"],["يَعْرِفُونَهُۥ","ya‘rifūnahu","they recognize him","তারা চিনে তাকে"],["كَمَا","kamā","as","যেমন"],["يَعْرِفُونَ","ya‘rifūna","they recognize","তারা চিনে"],["أَبْنَآءَهُمُ ۘ","abnāahumu","their sons","সন্তানদের তাদের"],["ٱلَّذِينَ","alladhīna","Those who","যারা"],["خَسِرُوٓا۟","khasirū","lost","ক্ষতিগ্রস্ত  করেছে"],["أَنفُسَهُمْ","anfusahum","themselves","নিজেদেরকে তাদের"],["فَهُمْ","fahum","then they","অতঃপর তারা"],["لَا","lā","(do) not","না"],["يُؤْمِنُونَ","yu'minūna","believe","বিশ্বাস করবে"]],"t":"ٱلَّذِينَ ءَاتَيْ<m>نَٰ</>هُمُ <h>ٱ</>لْكِ<m>تَٰ</>بَ يَعْرِفُونَهُ<m>ۥ</> كَمَا يَعْرِفُونَ أَ<q>بْ</><o>نَآ</>ءَهُمُ ۘ <h>ٱ</>لَّذِينَ خَسِ<o>رُوٓ</><s>ا۟</> أَ<k>نفُ</>سَهُمْ فَهُمْ لَا يُؤْمِ<p>نُو</>نَ"},{"n":21,"w":[["وَمَنْ","waman","And who","এবং কে"],["أَظْلَمُ","aẓlamu","(is) more unjust","অধিক সীমালঙ্ঘনকারী (হতে পারে)"],["مِمَّنِ","mimmani","than (he) who","তার চেয়ে যে"],["ٱفْتَرَىٰ","if'tarā","invents","রচনা করে"],["عَلَى","‘alā","against","উপর"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["كَذِبًا","kadhiban","a lie","মিথ্যা"],["أَوْ","aw","or","বা"],["كَذَّبَ","kadhaba","rejects","মিথ্যারোপ করে"],["بِـَٔايَـٰتِهِۦٓ ۗ","biāyātihi","His Signs","প্রতি নিদর্শনাদির তাঁর"],["إِنَّهُۥ","innahu","Indeed","নিশ্চয়ই"],["لَا","lā","not","না"],["يُفْلِحُ","yuf'liḥu","will be successful","সফল হয়"],["ٱلظَّـٰلِمُونَ","l-ẓālimūna","the wrongdoers","সীমালঙ্ঘনকারীরা"]],"t":"وَمَنْ أَظْلَمُ مِ<g>مَّ</>نِ <h>ٱ</>فْتَرَىٰ عَلَى <h>ٱ</>للَّهِ كَذِبًا أَوْ كَذَّبَ بِـَٔا<m>يَٰ</>تِ<o>هِۦٓ ۗ</> إِ<g>نَّ</>هُ<m>ۥ</> لَا يُفْلِحُ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مُو</>نَ"},{"n":22,"w":[["وَيَوْمَ","wayawma","And (the) Day","এবং সেদিন"],["نَحْشُرُهُمْ","naḥshuruhum","We will gather them","একত্র করবো আমরা তাদের"],["جَمِيعًۭا","jamī‘an","all","সকলকে"],["ثُمَّ","thumma","then","এরপর"],["نَقُولُ","naqūlu","We will say","আমরা বলবো"],["لِلَّذِينَ","lilladhīna","to those who","উদ্দেশ্যে তাদের(যারা)"],["أَشْرَكُوٓا۟","ashrakū","associated others with Allah","শিরক করেছিলো"],["أَيْنَ","ayna","Where (are)","\"কোথায়"],["شُرَكَآؤُكُمُ","shurakāukumu","your partners","অংশীদাররা তোমাদের"],["ٱلَّذِينَ","alladhīna","those whom","যাদেরকে"],["كُنتُمْ","kuntum","you used to","তোমরা ছিলে"],["تَزْعُمُونَ","taz‘umūna","claim","মনে করতে (শরিক হিসেবে)"]],"t":"وَيَوْمَ نَحْشُرُهُمْ جَمِي<k>عًۭا ثُ</><g>مَّ</> نَقُولُ لِلَّذِينَ أَشْرَ<o>كُوٓ</><s>ا۟</> أَيْنَ شُرَ<o>كَآ</>ؤُكُمُ <h>ٱ</>لَّذِينَ كُ<k>نتُ</>مْ تَزْعُ<p>مُو</>نَ"},{"n":23,"w":[["ثُمَّ","thumma","Then","এরপর"],["لَمْ","lam","not","না"],["تَكُن","takun","will be","থাকবে"],["فِتْنَتُهُمْ","fit'natuhum","(for) them a plea","অজুহাত তাদের"],["إِلَّآ","illā","except","এ ছাড়া"],["أَن","an","that","যে"],["قَالُوا۟","qālū","they say","তারা বলবে"],["وَٱللَّهِ","wal-lahi","By Allah","\"শপথ আল্লাহর"],["رَبِّنَا","rabbinā","our Lord","হে আমাদের রব"],["مَا","mā","not","না"],["كُنَّا","kunnā","we were","আমরা ছিলাম"],["مُشْرِكِينَ","mush'rikīna","those who associated others (with Allah)","মুশরিক\""]],"t":"ثُ<g>مَّ</> لَمْ تَكُ<k>ن فِ</>تْنَتُهُمْ إِ<o>لَّآ</> أَ<k>ن قَ</>الُو<s>ا۟</> وَ<h>ٱ</>للَّهِ رَبِّنَا مَا كُ<g>نَّ</>ا مُشْرِ<p>كِي</>نَ"},{"n":24,"w":[["ٱنظُرْ","unẓur","Look","দেখো"],["كَيْفَ","kayfa","how","কিভাবে"],["كَذَبُوا۟","kadhabū","they lied","তারা মিথ্যা প্রতিপন্ন করে"],["عَلَىٰٓ","‘alā","against","উপর"],["أَنفُسِهِمْ ۚ","anfusihim","themselves","নিজেদের তাদের"],["وَضَلَّ","waḍalla","And lost","ও হারিয়ে যাবে"],["عَنْهُم","‘anhum","from them","থেকে তাদের"],["مَّا","mā","what","যা"],["كَانُوا۟","kānū","they used to","তারা ছিলো"],["يَفْتَرُونَ","yaftarūna","invent","তারা মিথ্যা রচনা করতো"]],"t":"ٱ<k>نظُ</>رْ كَيْفَ كَذَبُو<s>ا۟</> عَلَ<o>ىٰٓ</> أَ<k>نفُ</>سِهِمْ ۚ وَضَلَّ عَنْ<y>هُم مَّ</>ا كَانُو<s>ا۟</> يَفْتَ<p>رُو</>نَ"},{"n":25,"w":[["وَمِنْهُم","wamin'hum","And among them","এবং তাদের মধ্যে হতে"],["مَّن","man","(are those) who","কেউ কেউ"],["يَسْتَمِعُ","yastami‘u","listen","কান পেতে রাখে"],["إِلَيْكَ ۖ","ilayka","to you","তোমার দিকে"],["وَجَعَلْنَا","waja‘alnā","but We have placed","এবং আমরা দিয়েছি"],["عَلَىٰ","‘alā","over","উপর"],["قُلُوبِهِمْ","qulūbihim","their hearts","অন্তরসমূহের তাদের"],["أَكِنَّةً","akinnatan","coverings","আবরণ"],["أَن","an","lest","যেন (না)"],["يَفْقَهُوهُ","yafqahūhu","they understand it","বুঝে তারা তা"],["وَفِىٓ","wafī","and in","এবং মধ্যে"],["ءَاذَانِهِمْ","ādhānihim","their ears","কানগুলোর তাদের"],["وَقْرًۭا ۚ","waqran","deafness","বধিরতা (দিয়েছি)"],["وَإِن","wa-in","And if","এবং যদি"],["يَرَوْا۟","yaraw","they see","তারা দেখে"],["كُلَّ","kulla","every","সমস্ত"],["ءَايَةٍۢ","āyatin","sign","নিদর্শন (তবুও)"],["لَّا","lā","not","না"],["يُؤْمِنُوا۟","yu'minū","will they believe","তারা ঈমান আনবে"],["بِهَا ۚ","bihā","in it","প্রতি তার"],["حَتَّىٰٓ","ḥattā","Until","এমনকি"],["إِذَا","idhā","when","যখন"],["جَآءُوكَ","jāūka","they come to you","তোমার কাছে তারা আসে"],["يُجَـٰدِلُونَكَ","yujādilūnaka","and argue with you","তোমার সাথে বিতর্ক করে"],["يَقُولُ","yaqūlu","say","বলে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوٓا۟","kafarū","disbelieved","অস্বীকার করেছে"],["إِنْ","in","Not","\"নয়"],["هَـٰذَآ","hādhā","(is) this","\"এটা"],["إِلَّآ","illā","but","ছাড়া"],["أَسَـٰطِيرُ","asāṭīru","(the) tales","উপকথাসমূহ"],["ٱلْأَوَّلِينَ","l-awalīna","(of) the former (people)","পূর্ববর্তীদের\""]],"t":"وَمِنْ<y>هُم مَّ</><d>ن يَ</>سْتَمِعُ إِلَيْكَ ۖ وَجَعَلْنَا عَلَىٰ قُلُوبِهِمْ أَكِ<g>نَّ</>ةً <d>أَن يَ</>فْقَهُوهُ وَ<o>فِىٓ</> ءَاذَانِهِمْ وَ<q>قْ</><d>رًۭا ۚ وَإِن يَ</>رَوْ<s>ا۟</> كُلَّ ءَايَ<w>ةٍۢ لَّ</>ا يُؤْمِنُو<s>ا۟</> بِهَا ۚ حَتَّ<o>ىٰٓ</> إِذَا <o>جَآ</>ءُوكَ يُ<m>جَٰ</>دِلُونَكَ يَقُولُ <h>ٱ</>لَّذِينَ كَفَ<o>رُوٓ</><s>ا۟</> إِنْ <m>هَٰ</><o>ذَآ</> إِ<o>لَّآ</> أَ<m>سَٰ</>طِيرُ <h>ٱ</>لْأَوَّ<p>لِي</>نَ"},{"n":26,"w":[["وَهُمْ","wahum","And they","এবং তারা"],["يَنْهَوْنَ","yanhawna","forbid (others)","নিষেধ করে (লোকদেরকে)"],["عَنْهُ","‘anhu","from it","থেকে তা"],["وَيَنْـَٔوْنَ","wayanawna","and they keep away","ও তারা দূরে থাকে"],["عَنْهُ ۖ","‘anhu","from it","হতে তা"],["وَإِن","wa-in","And not","এবং না"],["يُهْلِكُونَ","yuh'likūna","they destroy","তারা ধ্বংস করে"],["إِلَّآ","illā","except","এ ছাড়া"],["أَنفُسَهُمْ","anfusahum","themselves","নিজেদেরকে তাদের"],["وَمَا","wamā","and not","অথচ না"],["يَشْعُرُونَ","yash‘urūna","they perceive","তারা উপলব্ধি করে"]],"t":"وَهُمْ يَنْهَوْنَ عَنْهُ وَيَنْـَٔوْنَ عَنْهُ ۖ وَ<d>إِن يُ</>هْلِكُونَ إِ<o>لَّآ</> أَ<k>نفُ</>سَهُمْ وَمَا يَشْعُ<p>رُو</>نَ"},{"n":27,"w":[["وَلَوْ","walaw","And if","এবং যদি"],["تَرَىٰٓ","tarā","you (could) see","দেখতে তুমি"],["إِذْ","idh","when","যখন"],["وُقِفُوا۟","wuqifū","they are made to stand","তাদের দাঁড় করান হবে"],["عَلَى","‘alā","by","কাছে"],["ٱلنَّارِ","l-nāri","the Fire","(দোজখের) আগুনের"],["فَقَالُوا۟","faqālū","then they (will) say","তখন তারা বলবে"],["يَـٰلَيْتَنَا","yālaytanā","Oh! Would that we","\"হায়! আমাদের দুর্ভোগ"],["نُرَدُّ","nuraddu","were sent back","ফেরান হতো (সেখানে যদি) আমাদেরকে"],["وَلَا","walā","and not","এবং না"],["نُكَذِّبَ","nukadhiba","we would deny","মিথ্যারোপ করতাম আমরা"],["بِـَٔايَـٰتِ","biāyāti","(the) Signs","প্রতি নিদর্শনগুলোর"],["رَبِّنَا","rabbinā","(of) our Lord","রবের আমাদের"],["وَنَكُونَ","wanakūna","and we would be","এবং  হতাম আমরা"],["مِنَ","mina","among","অন্তর্ভুক্ত"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believers","মু'মিনদের\""]],"t":"وَلَوْ تَرَ<o>ىٰٓ</> إِذْ وُقِفُو<s>ا۟</> عَلَى <h>ٱ</><l>ل</><g>نَّ</>ارِ فَقَالُو<s>ا۟</> <m>يَٰ</>لَيْتَنَا نُرَدُّ وَلَا نُكَذِّبَ بِـَٔا<m>يَٰ</>تِ رَبِّنَا وَنَكُونَ مِنَ <h>ٱ</>لْمُؤْمِ<p>نِي</>نَ"},{"n":28,"w":[["بَلْ","bal","Nay","বরং"],["بَدَا","badā","became manifest","প্রকাশ পাবে"],["لَهُم","lahum","for them","কাছে তাদের"],["مَّا","mā","what","যা"],["كَانُوا۟","kānū","they used to","তারা ছিলো"],["يُخْفُونَ","yukh'fūna","conceal","তারা গোপন করতে"],["مِن","min","from","থেকে"],["قَبْلُ ۖ","qablu","before","পূর্ব"],["وَلَوْ","walaw","And if","এবং যদি"],["رُدُّوا۟","ruddū","they were sent back","তারা প্রত্যাবর্তিত হয়ও"],["لَعَادُوا۟","la‘ādū","certainly they (would) return","অবশ্যই পুনরাবৃত্তি করবে"],["لِمَا","limā","to what","যা কিছু"],["نُهُوا۟","nuhū","they were forbidden","তাদের নিষেধ করা হয়েছিলো"],["عَنْهُ","‘anhu","from it","হতে তা"],["وَإِنَّهُمْ","wa-innahum","and indeed they","এবং নিশ্চয়ই তারা"],["لَكَـٰذِبُونَ","lakādhibūna","certainly are liars","অবশ্যই মিথ্যাবাদী"]],"t":"بَلْ بَدَا لَ<y>هُم مَّ</>ا كَانُو<s>ا۟</> يُخْفُونَ مِ<k>ن قَ</><q>بْ</>لُ ۖ وَلَوْ رُدُّو<s>ا۟</> لَعَادُو<s>ا۟</> لِمَا نُهُو<s>ا۟</> عَنْهُ وَإِ<g>نَّ</>هُمْ لَ<m>كَٰ</>ذِ<p>بُو</>نَ"},{"n":29,"w":[["وَقَالُوٓا۟","waqālū","And they said","এবং তারা বলে"],["إِنْ","in","Not","\"নেই"],["هِىَ","hiya","it (is)","\"এটা (অর্থাৎ আখিরাতের জীবন)"],["إِلَّا","illā","except","ছাড়া"],["حَيَاتُنَا","ḥayātunā","our life","জীবন আমাদের"],["ٱلدُّنْيَا","l-dun'yā","(of) the world","পার্থিব"],["وَمَا","wamā","and not","এবং না"],["نَحْنُ","naḥnu","we","আমরা"],["بِمَبْعُوثِينَ","bimab‘ūthīna","(will be) resurrected","উত্থিত হবো\""]],"t":"وَقَا<o>لُوٓ</><s>ا۟</> إِنْ هِىَ إِلَّا حَيَاتُنَا <h>ٱ</><l>ل</>دُّنْيَا وَمَا نَحْنُ بِمَ<q>بْ</>عُو<p>ثِي</>نَ"},{"n":30,"w":[["وَلَوْ","walaw","And if","এবং যদি"],["تَرَىٰٓ","tarā","you (could) see","দেখতে তুমি (সে অবস্থা)"],["إِذْ","idh","when","যখন"],["وُقِفُوا۟","wuqifū","they will be made to stand","তাদের দাঁড় করানো হবে"],["عَلَىٰ","‘alā","before","সামনে"],["رَبِّهِمْ ۚ","rabbihim","their Lord","রবের তাদের"],["قَالَ","qāla","He (will) say","(আল্লাহ) বলবেন"],["أَلَيْسَ","alaysa","Is not","\"কি নয়"],["هَـٰذَا","hādhā","this","এই (উত্থান)"],["بِٱلْحَقِّ ۚ","bil-ḥaqi","the truth","ভাবে সঠিক\""],["قَالُوا۟","qālū","They will say","তারা বলবে"],["بَلَىٰ","balā","Yes","\"হ্যাঁ"],["وَرَبِّنَا ۚ","warabbinā","by our Lord","শপথ রবের আমাদের\""],["قَالَ","qāla","He (will) say","বলবেন তিনি"],["فَذُوقُوا۟","fadhūqū","So taste","\"তাহ'লে তোমরা স্বাদ নাও"],["ٱلْعَذَابَ","l-‘adhāba","the punishment","শাস্তির"],["بِمَا","bimā","because","এ কারণে যা"],["كُنتُمْ","kuntum","you used to","তোমরা ছিলে"],["تَكْفُرُونَ","takfurūna","disbelieve","তোমরা অস্বীকার করতে\""]],"t":"وَلَوْ تَرَ<o>ىٰٓ</> إِذْ وُقِفُو<s>ا۟</> عَلَىٰ رَبِّهِمْ ۚ قَالَ أَلَيْسَ <m>هَٰ</>ذَا بِ<h>ٱ</>لْحَقِّ ۚ قَالُو<s>ا۟</> بَلَىٰ وَرَبِّنَا ۚ قَالَ فَذُوقُو<s>ا۟</> <h>ٱ</>لْعَذَابَ بِمَا كُ<k>نتُ</>مْ تَكْفُ<p>رُو</>نَ"},{"n":31,"w":[["قَدْ","qad","Indeed","নিশ্চয়ই"],["خَسِرَ","khasira","incurred loss","ক্ষতিগ্রস্ত হয়েছে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَذَّبُوا۟","kadhabū","denied","মিথ্যা আরোপ করেছে"],["بِلِقَآءِ","biliqāi","in (the) meeting","প্রতি সাক্ষাতের"],["ٱللَّهِ ۖ","l-lahi","(with) Allah","আল্লাহর"],["حَتَّىٰٓ","ḥattā","until","এমনকি"],["إِذَا","idhā","when","যখন"],["جَآءَتْهُمُ","jāathumu","came to them","কাছে আসবে তাদের"],["ٱلسَّاعَةُ","l-sā‘atu","the Hour","ক্বিয়ামাত"],["بَغْتَةًۭ","baghtatan","suddenly","হঠাৎ"],["قَالُوا۟","qālū","they said","তারা বলবে"],["يَـٰحَسْرَتَنَا","yāḥasratanā","Oh! Our regret","\"হায় আক্ষেপ আমাদের"],["عَلَىٰ","‘alā","over","এর উপর"],["مَا","mā","what","যা"],["فَرَّطْنَا","farraṭnā","we neglected","অবজ্ঞা করেছি আমরা"],["فِيهَا","fīhā","concerning it","মধ্যে তার\""],["وَهُمْ","wahum","while they","এবং তারা"],["يَحْمِلُونَ","yaḥmilūna","will bear","বহন করবে"],["أَوْزَارَهُمْ","awzārahum","their burdens","বোঝাসমূহ তাদের"],["عَلَىٰ","‘alā","on","উপর"],["ظُهُورِهِمْ ۚ","ẓuhūrihim","their backs","পিঠগুলোর তাদের"],["أَلَا","alā","Unquestionably","সাবধান"],["سَآءَ","sāa","Evil","নিকৃষ্ট"],["مَا","mā","(is) what","যা"],["يَزِرُونَ","yazirūna","they bear","তারা বহন করবে"]],"t":"قَ<q>دْ</> خَسِرَ <h>ٱ</>لَّذِينَ كَذَّبُو<s>ا۟</> بِلِ<o>قَآ</>ءِ <h>ٱ</>للَّهِ ۖ حَتَّ<o>ىٰٓ</> إِذَا <o>جَآ</>ءَتْهُمُ <h>ٱ</><l>ل</>سَّاعَةُ بَغْتَ<k>ةًۭ قَ</>الُو<s>ا۟</> <m>يَٰ</>حَسْرَتَنَا عَلَىٰ مَا فَرَّ<q>طْ</>نَا فِيهَا وَهُمْ يَحْمِلُونَ أَوْزَارَهُمْ عَلَىٰ ظُهُورِهِمْ ۚ أَلَا <o>سَآ</>ءَ مَا يَزِ<p>رُو</>نَ"},{"n":32,"w":[["وَمَا","wamā","And not","এবং নয়"],["ٱلْحَيَوٰةُ","l-ḥayatu","(is) the life","জীবন"],["ٱلدُّنْيَآ","l-dun'yā","(of) the world","পার্থিব"],["إِلَّا","illā","except","এ ছাড়া"],["لَعِبٌۭ","la‘ibun","a play","ক্রীড়া"],["وَلَهْوٌۭ ۖ","walahwun","and amusement","ও কৌতুক"],["وَلَلدَّارُ","walalddāru","but the home","এবং অবশ্যই আবাস"],["ٱلْـَٔاخِرَةُ","l-ākhiratu","(of) the Hereafter","আখিরাতের"],["خَيْرٌۭ","khayrun","(is) best","উত্তম"],["لِّلَّذِينَ","lilladhīna","for those who","জন্যে তাদের (যারা)"],["يَتَّقُونَ ۗ","yattaqūna","(are) God conscious","আত্মরক্ষা করে চলে"],["أَفَلَا","afalā","Then not","কি তবুও না"],["تَعْقِلُونَ","ta‘qilūna","(will) you reason","তোমরা বুঝবে"]],"t":"وَمَا <h>ٱ</>لْحَيَ<s>وٰ</>ةُ <h>ٱ</><l>ل</>دُّنْ<o>يَآ</> إِلَّا لَعِ<d>بٌۭ وَ</>لَهْ<d>وٌۭ ۖ وَ</>لَلدَّارُ <h>ٱ</>لْءَاخِرَةُ خَيْ<w>رٌۭ لِّ</>لَّذِينَ يَتَّقُونَ ۗ أَفَلَا تَعْقِ<p>لُو</>نَ"},{"n":33,"w":[["قَدْ","qad","Indeed","নিশ্চয়ই"],["نَعْلَمُ","na‘lamu","We know","জানি আমরা"],["إِنَّهُۥ","innahu","that it","নিশ্চয়ই তা"],["لَيَحْزُنُكَ","layaḥzunuka","grieves you","অবশ্যই দুঃখ দেয় তোমাকে"],["ٱلَّذِى","alladhī","what","যা"],["يَقُولُونَ ۖ","yaqūlūna","they say","তারা বলে"],["فَإِنَّهُمْ","fa-innahum","And indeed, they","তবে নিশ্চয়ই তারা"],["لَا","lā","(do) not","না"],["يُكَذِّبُونَكَ","yukadhibūnaka","deny you","তোমাকে মিথ্যারোপ করে"],["وَلَـٰكِنَّ","walākinna","but","কিন্তু"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers ","সীমালঙ্ঘনকারীরা"],["بِـَٔايَـٰتِ","biāyāti","the Verses","প্রতি নিদর্শনাবলীর"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["يَجْحَدُونَ","yajḥadūna","they reject","অস্বীকার করেছে"]],"t":"قَ<q>دْ</> نَعْلَمُ إِ<g>نَّ</>هُ<m>ۥ</> لَيَحْزُنُكَ <h>ٱ</>لَّذِى يَقُولُونَ ۖ فَإِ<g>نَّ</>هُمْ لَا يُكَذِّبُونَكَ وَ<m>لَٰ</>كِ<g>نَّ</> <h>ٱ</><l>ل</><m>ظَّٰ</>لِمِينَ بِـَٔا<m>يَٰ</>تِ <h>ٱ</>للَّهِ يَ<q>جْ</>حَ<p>دُو</>نَ"},{"n":34,"w":[["وَلَقَدْ","walaqad","And surely","এবং নিশ্চয়ই"],["كُذِّبَتْ","kudhibat","were rejected","মিথ্যারোপ করা হয়েছে"],["رُسُلٌۭ","rusulun","Messengers","রাসূলদেরকে"],["مِّن","min","from","থেকে"],["قَبْلِكَ","qablika","before you","পূর্ব তোমার"],["فَصَبَرُوا۟","faṣabarū","but they were patient","তবে তারা ধৈর্য্য ধরেছে"],["عَلَىٰ","‘alā","over","এর উপর"],["مَا","mā","what","যাকিছু"],["كُذِّبُوا۟","kudhibū","they were rejected","তাদের মিথ্যারোপ করা হয়েছে"],["وَأُوذُوا۟","waūdhū","and they were harmed","ও তাদের কষ্ট দেয়া হয়েছে"],["حَتَّىٰٓ","ḥattā","until","যতক্ষণ না"],["أَتَىٰهُمْ","atāhum","came to them","কাছে এসেছে তাদের"],["نَصْرُنَا ۚ","naṣrunā","Our help","সাহায্য আমাদের"],["وَلَا","walā","And no","ও নেই"],["مُبَدِّلَ","mubaddila","one (can) alter","কোনো পরিবর্তনকারী"],["لِكَلِمَـٰتِ","likalimāti","(the) words","জন্যে বাণীসমূহের"],["ٱللَّهِ ۚ","l-lahi","(of) Allah","আল্লাহর"],["وَلَقَدْ","walaqad","and surely","এবং নিশ্চয়ই"],["جَآءَكَ","jāaka","has come to you","তোমার কাছে এসেছে"],["مِن","min","of","কিছু"],["نَّبَإِى۟","naba-i","(the) news","খবর"],["ٱلْمُرْسَلِينَ","l-mur'salīna","(of) the Messengers","রাসূলদের (সম্পর্কে)"]],"t":"وَلَقَ<q>دْ</> كُذِّبَتْ رُسُ<d>لٌۭ مِّ</><k>ن قَ</><q>بْ</>لِكَ فَصَبَرُو<s>ا۟</> عَلَىٰ مَا كُذِّبُو<s>ا۟</> وَأُوذُو<s>ا۟</> حَتَّ<o>ىٰٓ</> أَتَ<m>ىٰ</>هُمْ نَصْرُنَا ۚ وَلَا مُبَدِّلَ لِكَلِ<m>مَٰ</>تِ <h>ٱ</>للَّهِ ۚ وَلَقَ<q>دْ</> <o>جَآ</>ءَكَ <d>مِن نَّ</>بَإِ<s>ى۟</> <h>ٱ</>لْمُرْسَ<p>لِي</>نَ"},{"n":35,"w":[["وَإِن","wa-in","And if","এবং যদি"],["كَانَ","kāna","is","হয়"],["كَبُرَ","kabura","difficult","কষ্টকর"],["عَلَيْكَ","‘alayka","for you","তোমার উপর"],["إِعْرَاضُهُمْ","i‘'rāḍuhum","their aversion","উপেক্ষা করা তাদের"],["فَإِنِ","fa-ini","then if","তবে যদি"],["ٱسْتَطَعْتَ","is'taṭa‘ta","you are able","তুমি সমর্থ হও"],["أَن","an","to","যে"],["تَبْتَغِىَ","tabtaghiya","seek","সন্ধান করো তুমি"],["نَفَقًۭا","nafaqan","a tunnel","কোনো সুড়ঙ্গ"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","মাটির"],["أَوْ","aw","or","বা"],["سُلَّمًۭا","sullaman","a ladder","সিঁড়ি (চড়ার জন্যে)"],["فِى","fī","into","মধ্যে"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশের"],["فَتَأْتِيَهُم","fatatiyahum","so that you bring to them","অতঃপর কাছে আসো তাদের"],["بِـَٔايَةٍۢ ۚ","biāyatin","a Sign","নিয়ে কোনো নিদর্শন"],["وَلَوْ","walaw","But if","এবং যদি"],["شَآءَ","shāa","(had) willed","ইচ্ছে করতেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ(তবে)"],["لَجَمَعَهُمْ","lajama‘ahum","surely He (would) have gathered them","অবশ্যই একত্র করতেন তাদের"],["عَلَى","‘alā","on","উপর"],["ٱلْهُدَىٰ ۚ","l-hudā","the guidance","সৎপথের"],["فَلَا","falā","So (do) not","অতএব না"],["تَكُونَنَّ","takūnanna","be","তুমি হয়ো"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْجَـٰهِلِينَ","l-jāhilīna","the ignorant","মূর্খদের"]],"t":"وَإِ<k>ن كَ</>انَ كَبُرَ عَلَيْكَ إِعْرَاضُهُمْ فَإِنِ <h>ٱ</>سْتَطَعْتَ أَ<k>ن تَ</><q>بْ</>تَغِىَ نَفَ<k>قًۭا فِ</>ى <h>ٱ</>لْأَرْضِ أَوْ سُلَّ<k>مًۭا فِ</>ى <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ فَتَأْتِيَ<f>هُم بِـَٔ</>ايَ<d>ةٍۢ ۚ وَ</>لَوْ <o>شَآ</>ءَ <h>ٱ</>للَّهُ لَجَمَعَهُمْ عَلَى <h>ٱ</>لْهُدَىٰ ۚ فَلَا تَكُونَ<g>نَّ</> مِنَ <h>ٱ</>لْ<m>جَٰ</>هِ<p>لِي</>نَ"},{"n":36,"w":[["۞ إِنَّمَا","innamā","Only","প্রকৃতপক্ষে"],["يَسْتَجِيبُ","yastajību","respond","ডাকে সাড়া দেয়"],["ٱلَّذِينَ","alladhīna","those who","(তারাই) যারা"],["يَسْمَعُونَ ۘ","yasma‘ūna","listen","যারা শোনে"],["وَٱلْمَوْتَىٰ","wal-mawtā","But the dead ","এবং মৃতদেরকে"],["يَبْعَثُهُمُ","yab‘athuhumu","will resurrect them","উজ্জীবিত করবেন তাদের"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["ثُمَّ","thumma","then","এরপর"],["إِلَيْهِ","ilayhi","to Him","দিকে তাঁরই"],["يُرْجَعُونَ","yur'ja‘ūna","they will be returned","তাদের ফিরিয়ে আনা হবে"]],"t":"۞ إِ<g>نَّ</>مَا يَسْتَجِيبُ <h>ٱ</>لَّذِينَ يَسْمَعُونَ ۘ وَ<h>ٱ</>لْمَوْتَىٰ يَ<q>بْ</>عَثُهُمُ <h>ٱ</>للَّهُ ثُ<g>مَّ</> إِلَيْهِ يُرْجَ<p>عُو</>نَ"},{"n":37,"w":[["وَقَالُوا۟","waqālū","And they said","এবং তারা বলে"],["لَوْلَا","lawlā","Why (is) not","\"কেন না"],["نُزِّلَ","nuzzila","sent down","অবতীর্ণ করা হয়"],["عَلَيْهِ","‘alayhi","to him","উপর তার"],["ءَايَةٌۭ","āyatun","a Sign","কোনো নিদর্শন"],["مِّن","min","from","পক্ষ হতে"],["رَّبِّهِۦ ۚ","rabbihi","his Lord","রবের তার\""],["قُلْ","qul","Say","বলো"],["إِنَّ","inna","Indeed","\"নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["قَادِرٌ","qādirun","(is) Able","সক্ষম"],["عَلَىٰٓ","‘alā","[on]","এর উপর"],["أَن","an","to","যে"],["يُنَزِّلَ","yunazzila","send down","অবতীর্ণ করবেন"],["ءَايَةًۭ","āyatan","a Sign","কোনো নিদর্শন"],["وَلَـٰكِنَّ","walākinna","but","কিন্তু"],["أَكْثَرَهُمْ","aktharahum","most of them","অধিকাংশই তাদের"],["لَا","lā","(do) not","না"],["يَعْلَمُونَ","ya‘lamūna","know","তারা জানে\""]],"t":"وَقَالُو<s>ا۟</> لَوْلَا نُزِّلَ عَلَيْهِ ءَايَ<d>ةٌۭ مِّ</><w>ن رَّ</>بِّ<m>هِۦ</> ۚ قُلْ إِ<g>نَّ</> <h>ٱ</>للَّهَ قَادِرٌ عَلَ<o>ىٰٓ</> <d>أَن يُ</>نَزِّلَ ءَايَ<d>ةًۭ وَ</><m>لَٰ</>كِ<g>نَّ</> أَكْثَرَهُمْ لَا يَعْلَ<p>مُو</>نَ"},{"n":38,"w":[["وَمَا","wamā","And not","এবং নেই"],["مِن","min","[of]","কোনো"],["دَآبَّةٍۢ","dābbatin","any animal","বিচরণশীল জন্তু"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["وَلَا","walā","and not","আর না"],["طَـٰٓئِرٍۢ","ṭāirin","a bird","পাখি (যা)"],["يَطِيرُ","yaṭīru","(that) flies","উড়ে"],["بِجَنَاحَيْهِ","bijanāḥayhi","with its wings ","দিয়ে দু'ডানা তার"],["إِلَّآ","illā","but","এছাড়া যে (তারাও)"],["أُمَمٌ","umamun","(are) communities","জাতি (প্রজাতি)"],["أَمْثَالُكُم ۚ","amthālukum","like you","মতো তোমাদের"],["مَّا","mā","Not","না"],["فَرَّطْنَا","farraṭnā","We have neglected","ক্রুটি রেখেছি আমরা (নিয়তি নির্ধারণে)"],["فِى","fī","in","মধ্যে"],["ٱلْكِتَـٰبِ","l-kitābi","the Book","কিতাবের"],["مِن","min","[of]","কোনো"],["شَىْءٍۢ ۚ","shayin","anything","কিছুই"],["ثُمَّ","thumma","then","এরপর"],["إِلَىٰ","ilā","to","দিকে"],["رَبِّهِمْ","rabbihim","their Lord","রবের তাদের"],["يُحْشَرُونَ","yuḥ'sharūna","they will be gathered","তাদের একত্র করা হবে"]],"t":"وَمَا مِ<k>ن دَ</><n>آ</>بَّ<k>ةٍۢ فِ</>ى <h>ٱ</>لْأَرْضِ وَلَا <o>طَٰٓ</>ئِ<d>رٍۢ يَ</>طِيرُ بِجَنَاحَيْهِ إِ<o>لَّآ</> أُمَمٌ أَمْثَالُ<y>كُم ۚ مَّ</>ا فَرَّ<q>طْ</>نَا فِى <h>ٱ</>لْكِ<m>تَٰ</>بِ مِ<k>ن شَىْءٍۢ ۚ ثُ</><g>مَّ</> إِلَىٰ رَبِّهِمْ يُحْشَ<p>رُو</>نَ"},{"n":39,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["كَذَّبُوا۟","kadhabū","rejected","মিথ্যারোপ করেছে"],["بِـَٔايَـٰتِنَا","biāyātinā","Our Verses","নিয়ে নিদর্শনগুলোর আমাদের"],["صُمٌّۭ","ṣummun","(are) deaf","(তারা) বধির"],["وَبُكْمٌۭ","wabuk'mun","and dumb","ও বোবা"],["فِى","fī","in","(তারা আছে) মধ্যে"],["ٱلظُّلُمَـٰتِ ۗ","l-ẓulumāti","the darkness[es]","অন্ধকারের"],["مَن","man","Whoever","যাকে"],["يَشَإِ","yasha-i","wills","ইচ্ছে করেন"],["ٱللَّهُ","l-lahu","Allah ","আল্লাহ"],["يُضْلِلْهُ","yuḍ'lil'hu","He lets him go astray","পথভ্রষ্ট করেন তাকে"],["وَمَن","waman","and whoever","এবং যাকে"],["يَشَأْ","yasha","He wills ","ইচ্ছে করেন"],["يَجْعَلْهُ","yaj‘alhu","He places him","রাখেন তাকে"],["عَلَىٰ","‘alā","on","উপর"],["صِرَٰطٍۢ","ṣirāṭin","(the) way","পথের"],["مُّسْتَقِيمٍۢ","mus'taqīmin","(the) straight","সরল-সোজা"]],"t":"وَ<h>ٱ</>لَّذِينَ كَذَّبُو<s>ا۟</> بِـَٔا<m>يَٰ</>تِنَا صُ<g>مٌّۭ</> وَبُكْ<k>مٌۭ فِ</>ى <h>ٱ</><l>ل</>ظُّلُ<m>مَٰ</>تِ ۗ <d>مَن يَ</>شَإِ <h>ٱ</>للَّهُ يُضْلِلْهُ وَ<d>مَن يَ</>شَأْ يَ<q>جْ</>عَلْهُ عَلَىٰ صِ<m>رَٰ</><d>طٍۢ مُّ</>سْتَ<p>قِي</>مٍۢ"},{"n":40,"w":[["قُلْ","qul","Say","বলো"],["أَرَءَيْتَكُمْ","ara-aytakum","Have you seen","\"কি তোমরা (ভেবে) দেখেছো"],["إِنْ","in","if","যদি"],["أَتَىٰكُمْ","atākum","(there) came to you","কাছে আসে তোমাদের"],["عَذَابُ","‘adhābu","punishment","শাস্তি"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["أَوْ","aw","or","বা"],["أَتَتْكُمُ","atatkumu","(there) came to you","কাছে আসে তোমাদের"],["ٱلسَّاعَةُ","l-sā‘atu","the Hour ","ক্বিয়ামাত"],["أَغَيْرَ","aghayra","is it other","(তবে) কি ছাড়া"],["ٱللَّهِ","l-lahi","(than) Allah","আল্লাহ"],["تَدْعُونَ","tad‘ūna","you call","ডাকবে তোমরা (অন্য কাউকে)"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you are","হও তোমরা"],["صَـٰدِقِينَ","ṣādiqīna","truthful","সত্যবাদী (তবে উত্তর দাও)\""]],"t":"قُلْ أَرَءَيْتَكُمْ إِنْ أَتَ<m>ىٰ</>كُمْ عَذَابُ <h>ٱ</>للَّهِ أَوْ أَتَتْكُمُ <h>ٱ</><l>ل</>سَّاعَةُ أَغَيْرَ <h>ٱ</>للَّهِ تَ<q>دْ</>عُونَ إِ<k>ن كُنتُ</>مْ <m>صَٰ</>دِ<p>قِي</>نَ"},{"n":41,"w":[["بَلْ","bal","Nay","\"(না) বরং"],["إِيَّاهُ","iyyāhu","Him Alone","শুধু তাঁকেই"],["تَدْعُونَ","tad‘ūna","you call","ডাকো তোমরা"],["فَيَكْشِفُ","fayakshifu","and He would remove","অতঃপর তিনি দূর করেন"],["مَا","mā","what","যে জন্য"],["تَدْعُونَ","tad‘ūna","you call","তোমরা ডাকো (দু'আ করো)"],["إِلَيْهِ","ilayhi","upon Him","কাছে তাঁর"],["إِن","in","if","যদি"],["شَآءَ","shāa","He wills","তিনি ইচ্ছে করেন"],["وَتَنسَوْنَ","watansawna","and you will forget","এবং (তখন) তোমরা ভুলে যাও"],["مَا","mā","what","যাকে"],["تُشْرِكُونَ","tush'rikūna","you associate (with Him)","তোমরা শিরক করে থাকো\""]],"t":"بَلْ إِيَّاهُ تَ<q>دْ</>عُونَ فَيَكْشِفُ مَا تَ<q>دْ</>عُونَ إِلَيْهِ إِ<k>ن شَ</><o>آ</>ءَ وَتَ<k>نسَ</>وْنَ مَا تُشْرِ<p>كُو</>نَ"},{"n":42,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["أَرْسَلْنَآ","arsalnā","We sent (Messengers)","পাঠিয়েছি আমরা (রাসূলগণকে)"],["إِلَىٰٓ","ilā","to","প্রতি"],["أُمَمٍۢ","umamin","nations","জাতিগুলোর)"],["مِّن","min","from","থেকে"],["قَبْلِكَ","qablika","before you","পূর্ব তোমার"],["فَأَخَذْنَـٰهُم","fa-akhadhnāhum","then We seized them","অতঃপর আমরা ধরেছি তাদেরকে"],["بِٱلْبَأْسَآءِ","bil-basāi","with adversity","দিয়ে অর্থসংকট"],["وَٱلضَّرَّآءِ","wal-ḍarāi","and hardship","ও দুঃখদৈন্য(দিয়ে)"],["لَعَلَّهُمْ","la‘allahum","so that they may","যাতে তারা"],["يَتَضَرَّعُونَ","yataḍarra‘ūna","humble themselves","বিনীত হয়"]],"t":"وَلَقَ<q>دْ</> أَرْسَلْ<o>نَآ</> إِلَ<o>ىٰٓ</> أُمَ<d>مٍۢ مِّ</><k>ن قَ</><q>بْ</>لِكَ فَأَخَذْ<m>نَٰ</><f>هُم بِ</><h>ٱ</>لْبَأْ<o>سَآ</>ءِ وَ<h>ٱ</><l>ل</>ضَّ<o>رَّآ</>ءِ لَعَلَّهُمْ يَتَضَرَّ<p>عُو</>نَ"},{"n":43,"w":[["فَلَوْلَآ","falawlā","Then why not","অতঃপর কেন না"],["إِذْ","idh","when","যখন"],["جَآءَهُم","jāahum","came to them","এসেছিলো তাদের (কাছে)"],["بَأْسُنَا","basunā","Our punishment","শাস্তি আমাদের"],["تَضَرَّعُوا۟","taḍarra‘ū","they humbled themselves","তারা বিনীত হলো"],["وَلَـٰكِن","walākin","But","বরং"],["قَسَتْ","qasat","became hardened","শক্ত হয়ে গেলো"],["قُلُوبُهُمْ","qulūbuhum","their hearts","অন্তরগুলো তাদের"],["وَزَيَّنَ","wazayyana","and made fair-seeming","এবং সুশোভিত করেছিলো"],["لَهُمُ","lahumu","to them","জন্যে তাদের"],["ٱلشَّيْطَـٰنُ","l-shayṭānu","the Shaitaan","শয়তান"],["مَا","mā","what","যা"],["كَانُوا۟","kānū","they used to","তারা ছিলো"],["يَعْمَلُونَ","ya‘malūna","do","কাজ করতে"]],"t":"فَلَوْ<o>لَآ</> إِذْ <o>جَآ</>ءَ<f>هُم بَ</>أْسُنَا تَضَرَّعُو<s>ا۟</> وَ<m>لَٰ</>كِ<k>ن قَ</>سَتْ قُلُوبُهُمْ وَزَيَّنَ لَهُمُ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نُ مَا كَانُو<s>ا۟</> يَعْمَ<p>لُو</>نَ"},{"n":44,"w":[["فَلَمَّا","falammā","So when","অতঃপর যখন"],["نَسُوا۟","nasū","they forgot","তারা ভুলে গেল"],["مَا","mā","what","যা"],["ذُكِّرُوا۟","dhukkirū","they were reminded","তাদের উপদেশ দেয়া হয়েছিলো"],["بِهِۦ","bihi","of [it]","সম্পর্কে সে"],["فَتَحْنَا","fataḥnā","We opened","তখন খুলে দিলাম আমরা"],["عَلَيْهِمْ","‘alayhim","on them","উপর তাদের"],["أَبْوَٰبَ","abwāba","gates","(স্বচ্ছলতার) দরজাসমূহ"],["كُلِّ","kulli","(of) every","সব"],["شَىْءٍ","shayin","thing","কিছুর"],["حَتَّىٰٓ","ḥattā","until","এমনকি"],["إِذَا","idhā","when","যখন"],["فَرِحُوا۟","fariḥū","they rejoiced","তারা উল্লসিত হলো"],["بِمَآ","bimā","in what","নিয়ে তা যা"],["أُوتُوٓا۟","ūtū","they were given","তাদের দেয়া হয়েছিলো"],["أَخَذْنَـٰهُم","akhadhnāhum","We seized them","আমরা ধরলাম তাদের"],["بَغْتَةًۭ","baghtatan","suddenly","হঠাৎ"],["فَإِذَا","fa-idhā","and then","ফলে তখন"],["هُم","hum","they","তারা"],["مُّبْلِسُونَ","mub'lisūna","(were) dumbfounded","নিরাশ হয়ে পড়লো"]],"t":"فَلَ<g>مَّ</>ا نَسُو<s>ا۟</> مَا ذُكِّرُو<s>ا۟</> بِ<m>هِۦ</> فَتَحْنَا عَلَيْهِمْ أَ<q>بْ</><m>وَٰ</>بَ كُلِّ شَىْءٍ حَتَّ<o>ىٰٓ</> إِذَا فَرِحُو<s>ا۟</> بِ<o>مَآ</> أُو<o>تُوٓ</><s>ا۟</> أَخَذْ<m>نَٰ</><f>هُم بَ</>غْتَ<k>ةًۭ فَ</>إِذَا <y>هُم مُّ</><q>بْ</>لِ<p>سُو</>نَ"},{"n":45,"w":[["فَقُطِعَ","faquṭi‘a","So was cut off","অতঃপর উচ্ছেদ করা হলো"],["دَابِرُ","dābiru","(the) remnant","মূল"],["ٱلْقَوْمِ","l-qawmi","(of) the people","(ঐ)সম্প্রদায়ের"],["ٱلَّذِينَ","alladhīna","[those] who","যারা"],["ظَلَمُوا۟ ۚ","ẓalamū","did wrong","সীমালঙ্ঘন করেছিলো"],["وَٱلْحَمْدُ","wal-ḥamdu","And all praises and thanks","আর সব প্রশংসা"],["لِلَّهِ","lillahi","(be) to Allah","জন্যে আল্লাহরই"],["رَبِّ","rabbi","Lord","(যিনি) রব"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","(of) the worlds","বিশ্বজগতের"]],"t":"فَقُطِعَ دَابِرُ <h>ٱ</>لْقَوْمِ <h>ٱ</>لَّذِينَ ظَلَمُو<s>ا۟ ۚ</> وَ<h>ٱ</>لْحَمْدُ لِلَّهِ رَبِّ <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":46,"w":[["قُلْ","qul","Say","বলো"],["أَرَءَيْتُمْ","ara-aytum","Have you seen","\"কি (ভেবে) দেখছো তোমরা"],["إِنْ","in","if","যদি"],["أَخَذَ","akhadha","took away","কেড়ে নেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["سَمْعَكُمْ","sam‘akum","your hearing","শ্রবণশক্তি তোমাদের"],["وَأَبْصَـٰرَكُمْ","wa-abṣārakum","and your sight","ও দৃষ্টিশক্তি তোমাদের"],["وَخَتَمَ","wakhatama","and sealed","এবং সিল লাগান"],["عَلَىٰ","‘alā","[on]","উপর"],["قُلُوبِكُم","qulūbikum","your hearts","অন্তরগুলোর তোমাদের"],["مَّنْ","man","who","কোনো"],["إِلَـٰهٌ","ilāhun","(is the) god","ইলাহ (আছে)"],["غَيْرُ","ghayru","other than","ছাড়া"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ (যে)"],["يَأْتِيكُم","yatīkum","to bring [back] to you","কাছে আসবে তোমাদের"],["بِهِ ۗ","bihi","with it","নিয়ে তা"],["ٱنظُرْ","unẓur","See","দেখো"],["كَيْفَ","kayfa","how","কেমনভাবে"],["نُصَرِّفُ","nuṣarrifu","We explain","বারবার বর্ণনা করি আমরা"],["ٱلْـَٔايَـٰتِ","l-āyāti","the Signs","নিদর্শনগুলো"],["ثُمَّ","thumma","yet","এরপরও"],["هُمْ","hum","they","তারা"],["يَصْدِفُونَ","yaṣdifūna","turn away","তারা মুখ ফিরিয়ে নেয়\""]],"t":"قُلْ أَرَءَيْتُمْ إِنْ أَخَذَ <h>ٱ</>للَّهُ سَمْعَكُمْ وَأَ<q>بْ</><m>صَٰ</>رَكُمْ وَخَتَمَ عَلَىٰ قُلُوبِ<y>كُم مَّ</>نْ إِ<m>لَٰ</>هٌ غَيْرُ <h>ٱ</>للَّهِ يَأْتِي<f>كُم بِ</>هِ ۗ <h>ٱ</><k>نظُ</>رْ كَيْفَ نُصَرِّفُ <h>ٱ</>لْءَا<m>يَٰ</>تِ ثُ<g>مَّ</> هُمْ يَصْدِ<p>فُو</>نَ"},{"n":47,"w":[["قُلْ","qul","Say","বলো"],["أَرَءَيْتَكُمْ","ara-aytakum","Have you seen","\"(ভেবে) দেখছো কি তোমরা"],["إِنْ","in","if","যদি"],["أَتَىٰكُمْ","atākum","comes to you","কাছে এসে পড়ে তোমাদের"],["عَذَابُ","‘adhābu","punishment","শাস্তি"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["بَغْتَةً","baghtatan","suddenly","হঠাৎ"],["أَوْ","aw","or","বা"],["جَهْرَةً","jahratan","openly","প্রকাশ্যে"],["هَلْ","hal","will","কি"],["يُهْلَكُ","yuh'laku","(any) be destroyed","ধ্বংস করা হবে"],["إِلَّا","illā","except","এ ছাড়া"],["ٱلْقَوْمُ","l-qawmu","the people ","(যারা)সম্প্রদায়"],["ٱلظَّـٰلِمُونَ","l-ẓālimūna","the wrongdoers","সীমালঙ্ঘনকারী"]],"t":"قُلْ أَرَءَيْتَكُمْ إِنْ أَتَ<m>ىٰ</>كُمْ عَذَابُ <h>ٱ</>للَّهِ بَغْتَةً أَوْ جَهْرَةً هَلْ يُهْلَكُ إِلَّا <h>ٱ</>لْقَوْمُ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مُو</>نَ"},{"n":48,"w":[["وَمَا","wamā","And not","এবং না"],["نُرْسِلُ","nur'silu","We send","আমরা পাঠিয়েছি"],["ٱلْمُرْسَلِينَ","l-mur'salīna","the Messengers","রাসূলগণকে"],["إِلَّا","illā","except","এ ছাড়া যে"],["مُبَشِّرِينَ","mubashirīna","(as) bearer of glad tidings","সুসংবাদদাতা"],["وَمُنذِرِينَ ۖ","wamundhirīna","and (as) warners","ও সতর্ককারী (হিসেবে)"],["فَمَنْ","faman","So whoever","অতএব যে"],["ءَامَنَ","āmana","believed","ঈমান আনবে"],["وَأَصْلَحَ","wa-aṣlaḥa","and reformed","ও সংশোধন করবে"],["فَلَا","falā","then no","সেক্ষেত্রে নেই"],["خَوْفٌ","khawfun","fear","কোনো ভয়"],["عَلَيْهِمْ","‘alayhim","upon them","উপর তাদের"],["وَلَا","walā","and not","আর না"],["هُمْ","hum","they","তারা"],["يَحْزَنُونَ","yaḥzanūna","will grieve","দুঃখিত হবে"]],"t":"وَمَا نُرْسِلُ <h>ٱ</>لْمُرْسَلِينَ إِلَّا مُبَشِّرِينَ وَمُ<k>نذِ</>رِينَ ۖ فَمَنْ ءَامَنَ وَأَصْلَحَ فَلَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَ<p>نُو</>نَ"},{"n":49,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["كَذَّبُوا۟","kadhabū","denied","মিথ্যারোপ করেছে"],["بِـَٔايَـٰتِنَا","biāyātinā","[in] Our Verses","প্রতি নিদর্শনগুলোর আমার"],["يَمَسُّهُمُ","yamassuhumu","will touch them","স্পর্শ করবে তাদের"],["ٱلْعَذَابُ","l-‘adhābu","the punishment","শাস্তি"],["بِمَا","bimā","for what","এ কারণে যে"],["كَانُوا۟","kānū","they used to","তারা ছিলো"],["يَفْسُقُونَ","yafsuqūna","defiantly disobey","তারা সত্যত্যাগ করে"]],"t":"وَ<h>ٱ</>لَّذِينَ كَذَّبُو<s>ا۟</> بِـَٔا<m>يَٰ</>تِنَا يَمَسُّهُمُ <h>ٱ</>لْعَذَابُ بِمَا كَانُو<s>ا۟</> يَفْسُ<p>قُو</>نَ"},{"n":50,"w":[["قُل","qul","Say","(হে নাবী) বলো"],["لَّآ","lā","Not","\"না"],["أَقُولُ","aqūlu","(do) I say","\"আমি বলি"],["لَكُمْ","lakum","to you","উদ্দেশ্যে তোমাদের (যে)"],["عِندِى","‘indī","(that) with me","কাছে আমার (আছে)"],["خَزَآئِنُ","khazāinu","(are the) treasures","ধনভান্ডারসমূহ"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَلَآ","walā","and not","এবং না"],["أَعْلَمُ","a‘lamu","(that) I know","জানি আমি"],["ٱلْغَيْبَ","l-ghayba","the unseen","অদৃশ্যকে"],["وَلَآ","walā","and not","এবং না"],["أَقُولُ","aqūlu","I say","বলি আমি"],["لَكُمْ","lakum","to you","উদ্দেশ্যে তোমাদের (যে)"],["إِنِّى","innī","that I (am)","নিশ্চয়ই আমি"],["مَلَكٌ ۖ","malakun","an Angel","ফেরেশতা"],["إِنْ","in","Not","(প্রকৃতপক্ষে) না"],["أَتَّبِعُ","attabi‘u","(do) I follow","অনুসরণ করি আমি"],["إِلَّا","illā","except","এ ছাড়া"],["مَا","mā","what","যা"],["يُوحَىٰٓ","yūḥā","is revealed","ওহী করা হয়"],["إِلَىَّ ۚ","ilayya","to me","আমার প্রতি\""],["قُلْ","qul","Say","বলো"],["هَلْ","hal","Can","\"কি"],["يَسْتَوِى","yastawī","be equal","সমান হয়"],["ٱلْأَعْمَىٰ","l-a‘mā","the blind","অন্ধ"],["وَٱلْبَصِيرُ ۚ","wal-baṣīru","and the seeing one","আর চক্ষুষ্মান\""],["أَفَلَا","afalā","Then will not","কি তবে না"],["تَتَفَكَّرُونَ","tatafakkarūna","you give thought","তোমরা চিন্তা করো"]],"t":"قُل <o>لَّآ</> أَقُولُ لَكُمْ عِ<k>ندِ</>ى خَ<o>زَآ</>ئِنُ <h>ٱ</>للَّهِ وَ<o>لَآ</> أَعْلَمُ <h>ٱ</>لْغَيْبَ وَ<o>لَآ</> أَقُولُ لَكُمْ إِ<g>نِّ</>ى مَلَكٌ ۖ إِنْ أَتَّبِعُ إِلَّا مَا يُوحَ<o>ىٰٓ</> إِلَىَّ ۚ قُلْ هَلْ يَسْتَوِى <h>ٱ</>لْأَعْمَىٰ وَ<h>ٱ</>لْبَصِيرُ ۚ أَفَلَا تَتَفَكَّ<p>رُو</>نَ"},{"n":51,"w":[["وَأَنذِرْ","wa-andhir","And warn","আর (হে নাবী) তুমি সতর্ক করো"],["بِهِ","bihi","with it","সম্পর্কে এ"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["يَخَافُونَ","yakhāfūna","fear","ভয় করে"],["أَن","an","that","যে"],["يُحْشَرُوٓا۟","yuḥ'sharū","they will be gathered","একত্র করা হবে"],["إِلَىٰ","ilā","to","দিকে"],["رَبِّهِمْ ۙ","rabbihim","their Lord","রবের তাদের"],["لَيْسَ","laysa","not","নেই"],["لَهُم","lahum","for them","জন্যে তাদের"],["مِّن","min","of","দিয়ে"],["دُونِهِۦ","dūnihi","other than Him","বাদ তাঁকে"],["وَلِىٌّۭ","waliyyun","any protector","কোনো অভিভাবক"],["وَلَا","walā","and not","এবং না"],["شَفِيعٌۭ","shafī‘un","any intercessor","কোনো সুপারিশকারী"],["لَّعَلَّهُمْ","la‘allahum","so that they may","যাতে তারা"],["يَتَّقُونَ","yattaqūna","(become) righteous","তাকওয়া অবলম্বন করে"]],"t":"وَأَ<k>نذِ</>رْ بِهِ <h>ٱ</>لَّذِينَ يَخَافُونَ <d>أَن يُ</>حْشَ<o>رُوٓ</><s>ا۟</> إِلَىٰ رَبِّهِمْ ۙ لَيْسَ لَ<y>هُم مِّ</><k>ن دُ</>ونِ<m>هِۦ</> وَلِ<d>ىٌّۭ وَ</>لَا شَفِي<w>عٌۭ لَّ</>عَلَّهُمْ يَتَّ<p>قُو</>نَ"},{"n":52,"w":[["وَلَا","walā","And (do) not","এবং না"],["تَطْرُدِ","taṭrudi","send away","তাড়িয়ে দিও"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["يَدْعُونَ","yad‘ūna","call","ডাকে"],["رَبَّهُم","rabbahum","their Lord","তাদের রবকে"],["بِٱلْغَدَوٰةِ","bil-ghadati","in the morning","বেলায় সকাল"],["وَٱلْعَشِىِّ","wal-‘ashiyi","and the evening","ও সন্ধ্যায়"],["يُرِيدُونَ","yurīdūna","desiring","তারা চায়"],["وَجْهَهُۥ ۖ","wajhahu","His Countenance","সন্তুষ্টি তাঁর"],["مَا","mā","Not","নেই"],["عَلَيْكَ","‘alayka","(is) on you","উপর তোমার"],["مِنْ","min","of","থেকে"],["حِسَابِهِم","ḥisābihim","their account","হিসাব তাদের (দেয়ার দায়িত্ব)"],["مِّن","min","[of]","কোনো"],["شَىْءٍۢ","shayin","anything","কিছুই"],["وَمَا","wamā","and not","এবং না (আছে)"],["مِنْ","min","from","থেকে"],["حِسَابِكَ","ḥisābika","your account","তোমার হিসাব"],["عَلَيْهِم","‘alayhim","on them","উপর তাদের"],["مِّن","min","[of]","কোনো"],["شَىْءٍۢ","shayin","anything","কিছুই"],["فَتَطْرُدَهُمْ","fataṭrudahum","So were you to send them away","অতএব তুমি তাড়িয়ে দিলে তাদেরকে"],["فَتَكُونَ","fatakūna","then you would be","তবে হবে তুমি"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","সীমালঙ্ঘনকারীদের"]],"t":"وَلَا تَ<q>طْ</>رُدِ <h>ٱ</>لَّذِينَ يَ<q>دْ</>عُونَ رَبَّ<f>هُم بِ</><h>ٱ</>لْغَدَ<s>وٰ</>ةِ وَ<h>ٱ</>لْعَشِىِّ يُرِيدُونَ وَ<q>جْ</>هَهُ<m>ۥ</> ۖ مَا عَلَيْكَ مِنْ حِسَابِ<y>هِم مِّ</><k>ن شَ</><d>ىْءٍۢ وَ</>مَا مِنْ حِسَابِكَ عَلَيْ<y>هِم مِّ</><k>ن شَىْءٍۢ فَ</>تَ<q>طْ</>رُدَهُمْ فَتَكُونَ مِنَ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":53,"w":[["وَكَذَٰلِكَ","wakadhālika","And thus","এবং এভাবে"],["فَتَنَّا","fatannā","We try","পরীক্ষা করেছি আমরা"],["بَعْضَهُم","ba‘ḍahum","some of them","কাউকে তাদের"],["بِبَعْضٍۢ","biba‘ḍin","with others","দিয়ে (অন্য) কাউকে"],["لِّيَقُولُوٓا۟","liyaqūlū","that they say","যেন তারা বলে"],["أَهَـٰٓؤُلَآءِ","ahāulāi","Are these","\"কি এসব লোকদের"],["مَنَّ","manna","(whom has been) favored","অনুগ্রহ করেছেন"],["ٱللَّهُ","l-lahu","(by) Allah","আল্লাহ"],["عَلَيْهِم","‘alayhim","[upon them]","উপর তাদের"],["مِّنۢ","min","from","হতে"],["بَيْنِنَآ ۗ","bayninā","among us","মধ্যে আমাদের\""],["أَلَيْسَ","alaysa","is not","নন কি"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["بِأَعْلَمَ","bi-a‘lama","most knowing","অধিক অবহিত"],["بِٱلشَّـٰكِرِينَ","bil-shākirīna","of those who are grateful","সম্পর্কে কৃতজ্ঞদের"]],"t":"وَكَ<m>ذَٰ</>لِكَ فَتَ<g>نَّ</>ا بَعْضَ<f>هُم بِ</>بَعْ<w>ضٍۢ لِّ</>يَقُو<o>لُوٓ</><s>ا۟</> أَ<o>هَٰٓؤُلَآ</>ءِ مَ<g>نَّ</> <h>ٱ</>للَّهُ عَلَيْ<y>هِم مِّ</><i>نۢ بَ</>يْنِ<o>نَآ ۗ</> أَلَيْسَ <h>ٱ</>للَّهُ بِأَعْلَمَ بِ<h>ٱ</><l>ل</><m>شَّٰ</>كِ<p>رِي</>نَ"},{"n":54,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["جَآءَكَ","jāaka","come to you","তোমার কাছে আসে"],["ٱلَّذِينَ","alladhīna","those who","(তারা) যারা"],["يُؤْمِنُونَ","yu'minūna","believe","ঈমান এনেছে"],["بِـَٔايَـٰتِنَا","biāyātinā","in Our Verses","উপর  নিদর্শনগুলোর আমাদের"],["فَقُلْ","faqul","then say","তখন বলো"],["سَلَـٰمٌ","salāmun","Peace","\"শান্তি (বর্ষিত হোক)"],["عَلَيْكُمْ ۖ","‘alaykum","(be) upon you","উপর তোমাদের"],["كَتَبَ","kataba","(Has) Prescribed","নির্ধারিত করে নিয়েছেন"],["رَبُّكُمْ","rabbukum","your Lord","রব তোমাদের"],["عَلَىٰ","‘alā","upon","উপর"],["نَفْسِهِ","nafsihi","Himself","নিজের তাঁর"],["ٱلرَّحْمَةَ ۖ","l-raḥmata","the Mercy","দয়া করা"],["أَنَّهُۥ","annahu","that he","এমন যে তা"],["مَنْ","man","who","কেউ"],["عَمِلَ","‘amila","does","কাজ করে বসে"],["مِنكُمْ","minkum","among you","মধ্য থেকে তোমাদের"],["سُوٓءًۢا","sūan","evil","মন্দ"],["بِجَهَـٰلَةٍۢ","bijahālatin","in ignorance","কারণে অজ্ঞতার"],["ثُمَّ","thumma","then","এরপর"],["تَابَ","tāba","repents","তওবা করে"],["مِنۢ","min","from","থেকে"],["بَعْدِهِۦ","ba‘dihi","after it","তারপর"],["وَأَصْلَحَ","wa-aṣlaḥa","and reforms","ও সংশোধিত হয়"],["فَأَنَّهُۥ","fa-annahu","then, indeed He","তবে বাস্তবিকই তিনি"],["غَفُورٌۭ","ghafūrun","(is) Oft-Forgiving","ক্ষমাশীল"],["رَّحِيمٌۭ","raḥīmun","Most Merciful","পরম দয়ালু\""]],"t":"وَإِذَا <o>جَآ</>ءَكَ <h>ٱ</>لَّذِينَ يُؤْمِنُونَ بِـَٔا<m>يَٰ</>تِنَا فَقُلْ سَ<m>لَٰ</>مٌ عَلَيْكُمْ ۖ كَتَبَ رَبُّكُمْ عَلَىٰ نَفْسِهِ <h>ٱ</><l>ل</>رَّحْمَةَ ۖ أَ<g>نَّ</>هُ<m>ۥ</> مَنْ عَمِلَ مِ<k>نكُ</>مْ <o>سُوٓ</><i>ءًۢا بِ</>جَ<m>هَٰ</>لَ<k>ةٍۢ ثُ</><g>مَّ</> تَابَ <i>مِنۢ بَ</>عْدِ<m>هِۦ</> وَأَصْلَحَ فَأَ<g>نَّ</>هُ<m>ۥ</> غَفُو<w>رٌۭ رَّ</><p>حِي</>مٌۭ"},{"n":55,"w":[["وَكَذَٰلِكَ","wakadhālika","And thus","এবং এভাবে"],["نُفَصِّلُ","nufaṣṣilu","We explain","বিস্তারিত বর্ণনা করি আমরা"],["ٱلْـَٔايَـٰتِ","l-āyāti","the Verses","নিদর্শনগুলোকে"],["وَلِتَسْتَبِينَ","walitastabīna","so that becomes manifest","এবং যেন সুস্পষ্ট প্রকাশ হয়"],["سَبِيلُ","sabīlu","(the) way","পথ"],["ٱلْمُجْرِمِينَ","l-muj'rimīna","(of) the criminals","অপরাধীদের"]],"t":"وَكَ<m>ذَٰ</>لِكَ نُفَصِّلُ <h>ٱ</>لْءَا<m>يَٰ</>تِ وَلِتَسْتَبِينَ سَبِيلُ <h>ٱ</>لْمُ<q>جْ</>رِ<p>مِي</>نَ"},{"n":56,"w":[["قُلْ","qul","Say","বলো"],["إِنِّى","innī","Indeed I","\"নিশ্চয়ই আমাকে"],["نُهِيتُ","nuhītu","[I] am forbidden","আমাকে নিষেধ করা হয়েছে"],["أَنْ","an","that","যে"],["أَعْبُدَ","a‘buda","I worship","(যেন না) আমি ইবাদাত করি"],["ٱلَّذِينَ","alladhīna","those whom","(তাদেরকে) যাদের"],["تَدْعُونَ","tad‘ūna","you call","তোমরা ডাকো"],["مِن","min","from","দিয়ে\""],["دُونِ","dūni","besides","বাদ\""],["ٱللَّهِ ۚ","l-lahi","Allah","আল্লাহ\""],["قُل","qul","Say","বলো"],["لَّآ","lā","Not","\"না"],["أَتَّبِعُ","attabi‘u","I follow","অনুসরণ করি আমি"],["أَهْوَآءَكُمْ ۙ","ahwāakum","your (vain) desires","খেয়ালখুশির তোমাদের"],["قَدْ","qad","certainly","নিশ্চয়ই"],["ضَلَلْتُ","ḍalaltu","I would go astray","আমি পথভ্রষ্ট হবো"],["إِذًۭا","idhan","then","তাহলে"],["وَمَآ","wamā","and not","এবং না (হবো)"],["أَنَا۠","anā","I (would be)","আমি"],["مِنَ","mina","from","অন্তর্ভুক্ত"],["ٱلْمُهْتَدِينَ","l-muh'tadīna","the guided-ones","সঠিক পথপ্রাপ্তদের\""]],"t":"قُلْ إِ<g>نِّ</>ى نُهِيتُ أَنْ أَعْبُدَ <h>ٱ</>لَّذِينَ تَ<q>دْ</>عُونَ مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ ۚ قُل <o>لَّآ</> أَتَّبِعُ أَهْ<o>وَآ</>ءَكُمْ ۙ قَ<q>دْ</> ضَلَلْتُ إِ<d>ذًۭا وَ</><o>مَآ</> أَنَا۠ مِنَ <h>ٱ</>لْمُهْتَ<p>دِي</>نَ"},{"n":57,"w":[["قُلْ","qul","Say","বলো"],["إِنِّى","innī","Indeed, I (am)","\"নিশ্চয়ই আমি"],["عَلَىٰ","‘alā","on","উপর"],["بَيِّنَةٍۢ","bayyinatin","clear proof","স্পষ্ট প্রমাণের (প্রতিষ্ঠিত)"],["مِّن","min","from","পক্ষ হতে"],["رَّبِّى","rabbī","my Lord","আমার রবের"],["وَكَذَّبْتُم","wakadhabtum","while you deny","অথচ মিথ্যারোপ করছো তোমরা"],["بِهِۦ ۚ","bihi","[with] it","প্রতি তাঁর"],["مَا","mā","Not","নেই"],["عِندِى","‘indī","I have","কাছে আমার"],["مَا","mā","what","যা"],["تَسْتَعْجِلُونَ","tasta‘jilūna","you seek to hasten","তোমরা শীঘ্র চাচ্ছো"],["بِهِۦٓ ۚ","bihi","of it","বিষয় সে"],["إِنِ","ini","Not","নেই"],["ٱلْحُكْمُ","l-ḥuk'mu","(is) the decision","নির্দেশ দেয়ার ক্ষমতা"],["إِلَّا","illā","except","ছাড়্"],["لِلَّهِ ۖ","lillahi","for Allah","আল্লাহ"],["يَقُصُّ","yaquṣṣu","He relates","তিনি বর্ণনা করেন"],["ٱلْحَقَّ ۖ","l-ḥaqa","the truth","সত্যকে"],["وَهُوَ","wahuwa","and He","এবং তিনিই"],["خَيْرُ","khayru","(is the) best","উত্তম"],["ٱلْفَـٰصِلِينَ","l-fāṣilīna","(of) the Deciders","মীমাংসাকারী\""]],"t":"قُلْ إِ<g>نِّ</>ى عَلَىٰ بَيِّنَ<d>ةٍۢ مِّ</><w>ن رَّ</>بِّى وَكَذَّ<q>بْ</><f>تُم بِ</><m>هِۦ</> ۚ مَا عِ<k>ندِ</>ى مَا تَسْتَعْجِلُونَ بِ<o>هِۦٓ ۚ</> إِنِ <h>ٱ</>لْحُكْمُ إِلَّا لِلَّهِ ۖ يَقُصُّ <h>ٱ</>لْحَقَّ ۖ وَهُوَ خَيْرُ <h>ٱ</>لْ<m>فَٰ</>صِ<p>لِي</>نَ"},{"n":58,"w":[["قُل","qul","Say","বলো"],["لَّوْ","law","If","\"যদি"],["أَنَّ","anna","that","নিশ্চিত (থাকতো)"],["عِندِى","‘indī","(were) with me","কাছে আমার"],["مَا","mā","what","যা"],["تَسْتَعْجِلُونَ","tasta‘jilūna","you seek to hasten","তোমরা শীঘ্র চাচ্ছ"],["بِهِۦ","bihi","of it","বিষয় সে"],["لَقُضِىَ","laquḍiya","surely would have been decided","অবশ্যই মীমাংসা (তাহলে) হয়ে যেতো"],["ٱلْأَمْرُ","l-amru","the matter","ব্যাপারটির"],["بَيْنِى","baynī","between me","মাঝে আমার"],["وَبَيْنَكُمْ ۗ","wabaynakum","and between you","ও মাঝে তোমাদের"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহই"],["أَعْلَمُ","a‘lamu","(is) most knowing","খুব অবগত"],["بِٱلظَّـٰلِمِينَ","bil-ẓālimīna","of the wrongdoers","সম্বন্ধে সীমালঙ্ঘনকারীদের"]],"t":"قُل لَّوْ أَ<g>نَّ</> عِ<k>ندِ</>ى مَا تَسْتَعْجِلُونَ بِ<m>هِۦ</> لَقُضِىَ <h>ٱ</>لْأَمْرُ بَيْنِى وَبَيْنَكُمْ ۗ وَ<h>ٱ</>للَّهُ أَعْلَمُ بِ<h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":59,"w":[["۞ وَعِندَهُۥ","wa‘indahu","And with Him","এবং কাছে তাঁর(আছে)"],["مَفَاتِحُ","mafātiḥu","(are the) keys","চাবিসমূহ"],["ٱلْغَيْبِ","l-ghaybi","(of) the unseen","অদৃশ্যের"],["لَا","lā","no (one)","না"],["يَعْلَمُهَآ","ya‘lamuhā","knows them","জানে কেউ ত্"],["إِلَّا","illā","except","ছাড়া"],["هُوَ ۚ","huwa","Him","তিনি"],["وَيَعْلَمُ","waya‘lamu","And He knows","এবং তিনি জানেন"],["مَا","mā","what","যা কিছু"],["فِى","fī","(is) in","মধ্যে (আছে)"],["ٱلْبَرِّ","l-bari","the land","স্থলভাগের"],["وَٱلْبَحْرِ ۚ","wal-baḥri","and in the sea","ও জলভাগে"],["وَمَا","wamā","And not","এবং না"],["تَسْقُطُ","tasquṭu","falls","পড়ে"],["مِن","min","of","কোন"],["وَرَقَةٍ","waraqatin","any leaf","পাতা"],["إِلَّا","illā","but","এ ছাড়া যে"],["يَعْلَمُهَا","ya‘lamuhā","He knows it","জানেন তিনি তা"],["وَلَا","walā","And not","এবং না"],["حَبَّةٍۢ","ḥabbatin","a grain","কোনো শস্যকণা"],["فِى","fī","in","মধ্যে (আছে)"],["ظُلُمَـٰتِ","ẓulumāti","the darkness[es]","অন্ধকারের"],["ٱلْأَرْضِ","l-arḍi","(of) the earth","মাটির"],["وَلَا","walā","and not","এবং না"],["رَطْبٍۢ","raṭbin","moist","আর্দ্র"],["وَلَا","walā","and not","আর না"],["يَابِسٍ","yābisin","dry","শুষ্ক"],["إِلَّا","illā","but","এ ছাড়া যে"],["فِى","fī","(is) in","মধ্যে (আছে)"],["كِتَـٰبٍۢ","kitābin","a Record","এক কিতাবের"],["مُّبِينٍۢ","mubīnin","Clear","সুস্পষ্টভাবে (লিখিত)"]],"t":"۞ وَعِ<k>ندَ</>هُ<m>ۥ</> مَفَاتِحُ <h>ٱ</>لْغَيْبِ لَا يَعْلَمُ<o>هَآ</> إِلَّا هُوَ ۚ وَيَعْلَمُ مَا فِى <h>ٱ</>لْبَرِّ وَ<h>ٱ</>لْبَحْرِ ۚ وَمَا تَسْقُطُ <d>مِن وَ</>رَقَةٍ إِلَّا يَعْلَمُهَا وَلَا حَبَّ<k>ةٍۢ فِ</>ى ظُلُ<m>مَٰ</>تِ <h>ٱ</>لْأَرْضِ وَلَا رَ<q>طْ</><d>بٍۢ وَ</>لَا يَابِسٍ إِلَّا فِى كِ<m>تَٰ</><d>بٍۢ مُّ</><p>بِي</>نٍۢ"},{"n":60,"w":[["وَهُوَ","wahuwa","And He","এবং তিনিই  (আল্লাহ)"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["يَتَوَفَّىٰكُم","yatawaffākum","takes your (soul)","মৃত্যু(অর্থাৎ নিদ্রা)দেন তোমাদের"],["بِٱلَّيْلِ","bi-al-layli","by the night","বেলায় রাতের"],["وَيَعْلَمُ","waya‘lamu","and He knows","ও তিনি জানেন"],["مَا","mā","what","যা কিছু"],["جَرَحْتُم","jaraḥtum","you committed","অর্জন করো তোমরা"],["بِٱلنَّهَارِ","bil-nahāri","by the day","বেলায় দিনের"],["ثُمَّ","thumma","Then","এরপর"],["يَبْعَثُكُمْ","yab‘athukum","He raises you up","জাগান তোমাদের"],["فِيهِ","fīhi","therein","মধ্যে তার"],["لِيُقْضَىٰٓ","liyuq'ḍā","so that is fulfilled","যেন পূর্ণ হয়"],["أَجَلٌۭ","ajalun","(the) term","একটি মেয়াদ"],["مُّسَمًّۭى ۖ","musamman","specified","নির্দিষ্ট (অর্থাৎ জীবনকাল)"],["ثُمَّ","thumma","Then","এরপর"],["إِلَيْهِ","ilayhi","to Him","দিকে তাঁরই"],["مَرْجِعُكُمْ","marji‘ukum","will be your return","প্রত্যাবর্তন হবে তোমাদের"],["ثُمَّ","thumma","then","এরপর"],["يُنَبِّئُكُم","yunabbi-ukum","He will inform you","তিনি জানিয়ে দিবেন তোমাদের"],["بِمَا","bimā","about what","ঐ বিষয়ে যা"],["كُنتُمْ","kuntum","you used to","তোমরা ছিলে"],["تَعْمَلُونَ","ta‘malūna","do","তোমরা কাজ করতে"]],"t":"وَهُوَ <h>ٱ</>لَّذِى يَتَوَفَّ<m>ىٰ</><f>كُم بِ</><h>ٱ</>لَّيْلِ وَيَعْلَمُ مَا جَرَحْ<f>تُم بِ</><h>ٱ</><l>ل</><g>نَّ</>هَارِ ثُ<g>مَّ</> يَ<q>بْ</>عَثُكُمْ فِيهِ لِيُ<q>قْ</>ضَ<o>ىٰٓ</> أَجَ<d>لٌۭ مُّ</>سَ<k>مًّۭى ۖ ثُ</><g>مَّ</> إِلَيْهِ مَرْجِعُكُمْ ثُ<g>مَّ</> يُنَبِّئُ<f>كُم بِ</>مَا كُ<k>نتُ</>مْ تَعْمَ<p>لُو</>نَ"},{"n":61,"w":[["وَهُوَ","wahuwa","And He","এবং তিনিই"],["ٱلْقَاهِرُ","l-qāhiru","(is) the Subjugator","পরাক্রমশালী"],["فَوْقَ","fawqa","over","উপর"],["عِبَادِهِۦ ۖ","‘ibādihi","His slaves","দাসদের তাঁর"],["وَيُرْسِلُ","wayur'silu","and He sends","এবং পাঠান"],["عَلَيْكُمْ","‘alaykum","over you","প্রতি তোমাদের"],["حَفَظَةً","ḥafaẓatan","guardians","তত্ত্বাবধায়ক"],["حَتَّىٰٓ","ḥattā","until","এমনকি"],["إِذَا","idhā","when","যখন"],["جَآءَ","jāa","comes","আসে"],["أَحَدَكُمُ","aḥadakumu","(to) anyone of you","কারও তোমাদের"],["ٱلْمَوْتُ","l-mawtu","the death","মৃত্যু"],["تَوَفَّتْهُ","tawaffathu","take him","মৃত্যু ঘটায় তার"],["رُسُلُنَا","rusulunā","Our messengers","আমাদের প্রেরিত (ফেরেশতাগণ)"],["وَهُمْ","wahum","and they","এমতাবস্হায় যে তারা"],["لَا","lā","(do) not","না"],["يُفَرِّطُونَ","yufarriṭūna","fail","ভুল করে"]],"t":"وَهُوَ <h>ٱ</>لْقَاهِرُ فَوْقَ عِبَادِ<m>هِۦ</> ۖ وَيُرْسِلُ عَلَيْكُمْ حَفَظَةً حَتَّ<o>ىٰٓ</> إِذَا <o>جَآ</>ءَ أَحَدَكُمُ <h>ٱ</>لْمَوْتُ تَوَفَّتْهُ رُسُلُنَا وَهُمْ لَا يُفَرِّ<p>طُو</>نَ"},{"n":62,"w":[["ثُمَّ","thumma","Then","এরপর"],["رُدُّوٓا۟","ruddū","they are returned","তাদেরকে আনা হবে"],["إِلَى","ilā","to","দিকে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["مَوْلَىٰهُمُ","mawlāhumu","their Protector ","(যিনি) তাদের মালিক"],["ٱلْحَقِّ ۚ","l-ḥaqi","[the] True","প্রকৃত"],["أَلَا","alā","Unquestionably","সাবধান"],["لَهُ","lahu","for Him","জন্যে তাঁরই"],["ٱلْحُكْمُ","l-ḥuk'mu","(is) the judgment","নির্দেশ দেয়ার ক্ষমতা"],["وَهُوَ","wahuwa","And He","এবং তিনিই"],["أَسْرَعُ","asra‘u","(is) swiftest","দ্রুততর"],["ٱلْحَـٰسِبِينَ","l-ḥāsibīna","(of) the Reckoners","হিসাব গ্রহণকারীদের (মধ্যে)"]],"t":"ثُ<g>مَّ</> رُ<o>دُّوٓ</><s>ا۟</> إِلَى <h>ٱ</>للَّهِ مَوْلَ<m>ىٰ</>هُمُ <h>ٱ</>لْحَقِّ ۚ أَلَا لَهُ <h>ٱ</>لْحُكْمُ وَهُوَ أَسْرَعُ <h>ٱ</>لْ<m>حَٰ</>سِ<p>بِي</>نَ"},{"n":63,"w":[["قُلْ","qul","Say","(হে নাবী) বলো"],["مَن","man","Who","\"কে"],["يُنَجِّيكُم","yunajjīkum","saves you","উদ্ধার করেন তোমাদের"],["مِّن","min","from","হতে"],["ظُلُمَـٰتِ","ẓulumāti","darkness[es]","অন্ধকারসমূহ"],["ٱلْبَرِّ","l-bari","(of) the land","স্হলভাগের"],["وَٱلْبَحْرِ","wal-baḥri","and the sea","ও জলভাগের"],["تَدْعُونَهُۥ","tad‘ūnahu","you call Him","(যখন) তোমরা ডাকো তাঁকে"],["تَضَرُّعًۭا","taḍarru‘an","humbly","কাতরভাবে"],["وَخُفْيَةًۭ","wakhuf'yatan","and secretly","ও গোপনে"],["لَّئِنْ","la-in","If","\"(এবং বলে থাকো) অবশ্যই যদি"],["أَنجَىٰنَا","anjānā","He saves us","উদ্ধার করেন আমাদের"],["مِنْ","min","from","হতে"],["هَـٰذِهِۦ","hādhihi","this","এই (বিপদ)"],["لَنَكُونَنَّ","lanakūnanna","surely we will be","অবশ্যই হবো অামরা (তবে)"],["مِنَ","mina","from","অন্তর্ভুক্ত"],["ٱلشَّـٰكِرِينَ","l-shākirīna","the grateful ones","কৃতজ্ঞদের\""]],"t":"قُلْ <d>مَن يُ</>نَجِّي<y>كُم مِّ</><k>ن ظُ</>لُ<m>مَٰ</>تِ <h>ٱ</>لْبَرِّ وَ<h>ٱ</>لْبَحْرِ تَ<q>دْ</>عُونَهُ<m>ۥ</> تَضَرُّ<d>عًۭا وَ</>خُفْيَ<w>ةًۭ لَّ</>ئِنْ أَ<k>نجَ</><m>ىٰ</>نَا مِنْ <m>هَٰذِهِۦ</> لَنَكُونَ<g>نَّ</> مِنَ <h>ٱ</><l>ل</><m>شَّٰ</>كِ<p>رِي</>نَ"},{"n":64,"w":[["قُلِ","quli","Say","বলো"],["ٱللَّهُ","l-lahu","Allah","\"আল্লাহ্‌"],["يُنَجِّيكُم","yunajjīkum","saves you","উদ্ধার করেন তোমাদের"],["مِّنْهَا","min'hā","from it","হতে তা"],["وَمِن","wamin","and from","এবং হতে"],["كُلِّ","kulli","every","সব"],["كَرْبٍۢ","karbin","distress","দুঃখ বিপদ"],["ثُمَّ","thumma","yet",