 যে"],["جَآءَ","jāa","came","আসবে"],["بِٱلسَّيِّئَةِ","bil-sayi-ati","with an evil deed","নিয়ে অসৎকর্ম"],["فَلَا","falā","then not","তবে না"],["يُجْزَىٰٓ","yuj'zā","he will be recompensed","প্রতিফল দেয়া হবে"],["إِلَّا","illā","except","এ ছাড়া"],["مِثْلَهَا","mith'lahā","the like of it","সমপরিমাণ তার"],["وَهُمْ","wahum","and they","এবং তাদেরকে"],["لَا","lā","will not","না"],["يُظْلَمُونَ","yuẓ'lamūna","(be) wronged","অবিচার করা হবে"]],"t":"مَ<k>ن جَ</><o>آ</>ءَ بِ<h>ٱ</>لْحَسَنَةِ فَلَهُ<m>ۥ</> عَشْرُ أَمْثَالِهَا ۖ وَمَ<k>ن جَ</><o>آ</>ءَ بِ<h>ٱ</><l>ل</>سَّيِّئَةِ فَلَا يُ<q>جْ</>زَ<o>ىٰٓ</> إِلَّا مِثْلَهَا وَهُمْ لَا يُظْلَ<p>مُو</>نَ"},{"n":161,"w":[["قُلْ","qul","Say","বলো"],["إِنَّنِى","innanī","Indeed (as for) me","\"নিশ্চয়ই আমাকে"],["هَدَىٰنِى","hadānī","has guided me","পথ দেখিয়েছেন আমাকে"],["رَبِّىٓ","rabbī","my Lord","আমার রব"],["إِلَىٰ","ilā","to","দিকে"],["صِرَٰطٍۢ","ṣirāṭin","a path","পথের"],["مُّسْتَقِيمٍۢ","mus'taqīmin","straight ","সরল-সঠিক"],["دِينًۭا","dīnan","a religion","(তাই) দীন"],["قِيَمًۭا","qiyaman","right","সুপ্রতিষ্ঠিত"],["مِّلَّةَ","millata","religion","পথপন্থা"],["إِبْرَٰهِيمَ","ib'rāhīma","(of) Ibrahim ","ইবরাহীমের"],["حَنِيفًۭا ۚ","ḥanīfan","a true monotheist","যে ছিলো (একনিষ্ঠ)"],["وَمَا","wamā","And not","এবং না"],["كَانَ","kāna","he was","সে ছিলো"],["مِنَ","mina","from","অন্তর্ভুক্ত"],["ٱلْمُشْرِكِينَ","l-mush'rikīna","the polytheists","মুশরিকদের"]],"t":"قُلْ إِ<g>نَّ</>نِى هَدَ<m>ىٰ</>نِى رَ<o>بِّىٓ</> إِلَىٰ صِ<m>رَٰ</><d>طٍۢ مُّ</>سْتَقِي<k>مٍۢ دِينًۭا قِ</>يَ<d>مًۭا مِّ</>لَّةَ إِ<q>بْ</><m>رَٰ</>هِيمَ حَنِي<d>فًۭا ۚ وَ</>مَا كَانَ مِنَ <h>ٱ</>لْمُشْرِ<p>كِي</>نَ"},{"n":162,"w":[["قُلْ","qul","Say","বলো"],["إِنَّ","inna","Indeed","\"নিশ্চয়ই"],["صَلَاتِى","ṣalātī","my prayer","আমার সালাত"],["وَنُسُكِى","wanusukī","and my rites of sacrifice","এবং আমার কুরবানি (বা উপাসনার পদ্ধতি)"],["وَمَحْيَاىَ","wamaḥyāya","and my living","ও আমার জীবন"],["وَمَمَاتِى","wamamātī","and my dying","ও আমার মরণ"],["لِلَّهِ","lillahi","(are) for A