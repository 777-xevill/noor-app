"আল্লাহ্‌কে (অন্যদেরকে)"],["مَا","mā","what","যা"],["لَا","lā","not","না"],["يَنفَعُنَا","yanfa‘unā","benefits us","উপকার করতে পারে আমাদের"],["وَلَا","walā","and not","আর না"],["يَضُرُّنَا","yaḍurrunā","harms us","ক্ষতি করতে পারে আমাদের"],["وَنُرَدُّ","wanuraddu","and we turn back","এবং (কি) ফিরে যাবো আমরা"],["عَلَىٰٓ","‘alā","on","উপর"],["أَعْقَابِنَا","a‘qābinā","our heels","গোঁড়ালির আমাদের (অর্থাৎ পিছন দিকে)"],["بَعْدَ","ba‘da","after","এরপরেও"],["إِذْ","idh","[when]","যখন"],["هَدَىٰنَا","hadānā","(has) guided us","পথ দেখিয়েছেন আমাদের"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ্‌"],["كَٱلَّذِى","ka-alladhī","Like the one","(তার) মতো যাকে"],["ٱسْتَهْوَتْهُ","is'tahwathu","whom (has been) enticed","বিভ্রান্ত করেছে তাকে"],["ٱلشَّيَـٰطِينُ","l-shayāṭīnu","(by) the Shaitaan","শয়তান"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["حَيْرَانَ","ḥayrāna","confused","হয়রান হয়ে (সে ফিরেছে)"],["لَهُۥٓ","lahu","he has","আছে তার"],["أَصْحَـٰبٌۭ","aṣḥābun","companions","সহচরগণ"],["يَدْعُونَهُۥٓ","yad‘ūnahu","who call him","তারা ডাকছে তাকে"],["إِلَى","ilā","towards","দিকে"],["ٱلْهُدَى","l-hudā","the guidance","সঠিক পথের (এই বলে)"],["ٱئْتِنَا ۗ","i'tinā","'Come to us.'","কাছে আসো আমাদের"],["قُلْ","qul","Say","বলো"],["إِنَّ","inna","Indeed","\"নিশ্চয়ই"],["هُدَى","hudā","(the) Guidance","সঠিক পথই"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহ্‌র"],["هُوَ","huwa","it","সেটাই"],["ٱلْهُدَىٰ ۖ","l-hudā","(is) the Guidance","সঠিক পথ"],["وَأُمِرْنَا","wa-umir'nā","and we have been commanded","এবং আমাদেরকে আদেশ করা হয়েছে"],["لِنُسْلِمَ","linus'lima","that we submit","যেন আত্মসমর্পণ করি আমরা"],["لِرَبِّ","lirabbi","to (the) Lord","রকাছে রবের"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","(of) the worlds","বিশ্ব জগতের"]],"t":"قُلْ أَنَ<q>دْ</>عُو<s>ا۟</> مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ مَا لَا يَ<k>نفَ</>عُنَا وَلَا يَضُرُّنَا وَنُرَدُّ عَلَ<o>ىٰٓ</> أَعْقَابِنَا بَعْدَ إِذْ هَدَ<m>ىٰ</>نَا <h>ٱ</>للَّهُ كَ<h>ٱ</>لَّذِى <h>ٱ</>سْتَهْوَتْهُ <h>ٱ</><l>ل</>شَّ<m>يَٰ</>طِينُ فِى <h>ٱ</>لْأَرْضِ حَيْرَانَ لَهُ<o>ۥٓ</> أَصْ<m>حَٰ</><d>بٌۭ يَ</><q>دْ</>عُونَهُ<o>ۥٓ</> إِلَى <h>ٱ</>لْهُدَى <h>ٱ</>ئْتِنَا ۗ قُلْ إِ<g>نَّ</> هُدَى <h>ٱ</>للَّهِ هُوَ <h>ٱ</>لْهُدَىٰ ۖ وَأُمِرْنَا لِنُسْلِمَ لِرَبِّ <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":72,"w":[["وَأَنْ","wa-an","And to","এবং (এ নির্দেশও) যে"],["أَقِيمُوا۟","aqīmū","establish","তোমরা প্রতিষ্ঠা করো"],["ٱلصَّلَوٰةَ","l-ṣalata","the prayer","সালাত"],["وَٱتَّقُوهُ ۚ","wa-ittaqūhu","and fear Him","ও তোমরা ভয় করো তাঁকে"],["وَهُوَ","wahuwa","And He","এবং তিনিই"],["ٱلَّذِىٓ","alladhī","(is) the One","যিনি"],["إِلَيْهِ","ilayhi","to Him","দিকে তাঁর"],["تُحْشَرُونَ","tuḥ'sharūna","you will be gathered","তোমাদের একত্র করা হবে\""]],"t":"وَأَنْ أَقِيمُو<s>ا۟</> <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةَ وَ<h>ٱ</>تَّقُوهُ ۚ وَهُوَ <h>ٱ</>لَّ<o>ذِىٓ</> إِلَيْهِ تُحْشَ<p>رُو</>نَ"},{"n":73,"w":[["وَهُوَ","wahuwa","And (it is) He","এবং তিনিই"],["ٱلَّذِى","alladhī","Who","যিনি"],["خَلَقَ","khalaqa","created","সৃষ্টি করেছেন"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশসমূহ"],["وَٱلْأَرْضَ","wal-arḍa","and the earth","ও পৃথিবী"],["بِٱلْحَقِّ ۖ","bil-ḥaqi","in truth","ভাবে যথাযথ"],["وَيَوْمَ","wayawma","And (the) Day","এবং যেদিন"],["يَقُولُ","yaqūlu","He says","বলবেন তিনি"],["كُن","kun","Be","\"হও (ক্বিয়ামাত)\""],["فَيَكُونُ ۚ","fayakūnu","and it is","তখনই তা হয়ে যাবে"],["قَوْلُهُ","qawluhu","His word","কথাই তাঁর"],["ٱلْحَقُّ ۚ","l-ḥaqu","(is) the truth","সত্য"],["وَلَهُ","walahu","And for Him","এবং তাঁরই (হবে)"],["ٱلْمُلْكُ","l-mul'ku","(is) the Dominion","আধিপত্য (নিরঙ্কুশভাবে)"],["يَوْمَ","yawma","(on the) Day","যেদিন"],["يُنفَخُ","yunfakhu","will be blown","ফুঁ দেয়া হবে"],["فِى","fī","in","মধ্যে"],["ٱلصُّورِ ۚ","l-ṣūri","the trumpet","শিঙার"],["عَـٰلِمُ","‘ālimu","(He is) All-Knower","তিনি অবহিত"],["ٱلْغَيْبِ","l-ghaybi","(of) the unseen","অদৃশ্যের"],["وَٱلشَّهَـٰدَةِ ۚ","wal-shahādati","and the seen","এবং প্রকাশ্যের"],["وَهُوَ","wahuwa","And He","এবং তিনিই"],["ٱلْحَكِيمُ","l-ḥakīmu","(is) the All-Wise","প্রজ্ঞাময়"],["ٱلْخَبِيرُ","l-khabīru","the All-Aware","সবিশেষ অবহিত"]],"t":"وَهُوَ <h>ٱ</>لَّذِى خَلَقَ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضَ بِ<h>ٱ</>لْحَقِّ ۖ وَيَوْمَ يَقُولُ كُ<k>ن فَ</>يَكُونُ ۚ قَوْلُهُ <h>ٱ</>لْحَقُّ ۚ وَلَهُ <h>ٱ</>لْمُلْكُ يَوْمَ يُ<k>نفَ</>خُ فِى <h>ٱ</><l>ل</>صُّورِ ۚ <m>عَٰ</>لِمُ <h>ٱ</>لْغَيْبِ وَ<h>ٱ</><l>ل</>شَّ<m>هَٰ</>دَةِ ۚ وَهُوَ <h>ٱ</>لْحَكِيمُ <h>ٱ</>لْخَ<p>بِي</>رُ"},{"n":74,"w":[["۞ وَإِذْ","wa-idh","And when","এবং (স্মরণ করো) যখন"],["قَالَ","qāla","said","বলেছিলো"],["إِبْرَٰهِيمُ","ib'rāhīmu","Ibrahim","ইবরাহীম"],["لِأَبِيهِ","li-abīhi","to his father","উদ্দেশ্যে তার পিতার"],["ءَازَرَ","āzara","Azar","(অর্থাৎ) আজরকে"],["أَتَتَّخِذُ","atattakhidhu","Do you take","\"কি আপনি গ্রহণ করেন"],["أَصْنَامًا","aṣnāman","idols","মূর্তিগুলোকে"],["ءَالِهَةً ۖ","ālihatan","(as) gods","উপাস্যরূপে"],["إِنِّىٓ","innī","Indeed, I","নিশ্চয়ই আমি"],["أَرَىٰكَ","arāka","[I] see you","আপনাকে দেখছি"],["وَقَوْمَكَ","waqawmaka","and your people","ও আপনার সম্প্রদায়কে"],["فِى","fī","in","মধ্যে"],["ضَلَـٰلٍۢ","ḍalālin","error","পথভ্রষ্টতার"],["مُّبِينٍۢ","mubīnin","manifest","সুস্পষ্ট\""]],"t":"۞ وَإِذْ قَالَ إِ<q>بْ</><m>رَٰ</>هِيمُ لِأَبِيهِ ءَازَرَ أَتَتَّخِذُ أَصْنَامًا ءَالِهَةً ۖ إِ<g>نِّ</><o>ىٓ</> أَرَ<m>ىٰ</>كَ وَقَوْمَكَ فِى ضَ<m>لَٰ</><d>لٍۢ مُّ</><p>بِي</>نٍۢ"},{"n":75,"w":[["وَكَذَٰلِكَ","wakadhālika","And thus","এবং এভাবে"],["نُرِىٓ","nurī","We show(ed)","দেখাই আমরা"],["إِبْرَٰهِيمَ","ib'rāhīma","Ibrahim","ইবরাহীমকে"],["مَلَكُوتَ","malakūta","the kingdom","পরিচালনা ব্যবস্হা"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশসমূহের"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীর"],["وَلِيَكُونَ","waliyakūna","so that he would be","এবং যেন সে হয়"],["مِنَ","mina","among","অন্তর্ভুক্ত"],["ٱلْمُوقِنِينَ","l-mūqinīna","the ones who are certain","দৃঢ় বিশ্বাসীদের"]],"t":"وَكَ<m>ذَٰ</>لِكَ نُ<o>رِىٓ</> إِ<q>بْ</><m>رَٰ</>هِيمَ مَلَكُوتَ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ وَلِيَكُونَ مِنَ <h>ٱ</>لْمُوقِ<p>نِي</>نَ"},{"n":76,"w":[["فَلَمَّا","falammā","So when","অতঃপর যখন"],["جَنَّ","janna","covered","আচ্ছন্ন হলো"],["عَلَيْهِ","‘alayhi","over him","উপর তার"],["ٱلَّيْلُ","al-laylu","the night","রাত"],["رَءَا","raā","he saw","(ইবরাহীম) দেখলো"],["كَوْكَبًۭا ۖ","kawkaban","a star","একটি তারা (উজ্জ্বল)"],["قَالَ","qāla","He said","সে বললো"],["هَـٰذَا","hādhā","This","\"এই"],["رَبِّى ۖ","rabbī","(is) my Lord","আমার রব\""],["فَلَمَّآ","falammā","But when","অতঃপর যখন"],["أَفَلَ","afala","it set","তা অস্তমিত হলো"],["قَالَ","qāla","he said","সে বললো"],["لَآ","lā","Not","\"না"],["أُحِبُّ","uḥibbu","(do) I like","\"আমি ভালোবাসি"],["ٱلْـَٔافِلِينَ","l-āfilīna","the ones that set","অস্তগামীদেরকে\""]],"t":"فَلَ<g>مَّ</>ا جَ<g>نَّ</> عَلَيْهِ <h>ٱ</>لَّيْلُ رَءَا كَوْكَ<k>بًۭا ۖ قَ</>الَ <m>هَٰ</>ذَا رَبِّى ۖ فَلَ<g>مَّ</><o>آ</> أَفَلَ قَالَ <o>لَآ</> أُحِبُّ <h>ٱ</>لْءَافِ<p>لِي</>نَ"},{"n":77,"w":[["فَلَمَّا","falammā","When","অতঃপর যখন"],["رَءَا","raā","he saw","সে দেখলো"],["ٱلْقَمَرَ","l-qamara","the moon","চাঁদকে"],["بَازِغًۭا","bāzighan","rising","উদীয়মান (উজ্জ্বল)"],["قَالَ","qāla","he said","সে বললো"],["هَـٰذَا","hādhā","This","\"এই"],["رَبِّى ۖ","rabbī","(is) my Lord","আমার রব\""],["فَلَمَّآ","falammā","But when","অতঃপর যখন"],["أَفَلَ","afala","it set","তা অস্তমিত হলো"],["قَالَ","qāla","he said","সে বললো"],["لَئِن","la-in","If","\"অবশ্যই যদি"],["لَّمْ","lam","(does) not","না"],["يَهْدِنِى","yahdinī","guide me","আমাকে সৎপথ দেখান"],["رَبِّى","rabbī","my Lord","আমার রব"],["لَأَكُونَنَّ","la-akūnanna","I will surely be","অবশ্যই হবো আমি"],["مِنَ","mina","among","অন্তর্ভুক্ত"],["ٱلْقَوْمِ","l-qawmi","the people","সম্প্রদায়ের"],["ٱلضَّآلِّينَ","l-ḍālīna","who went astray","পথভ্রষ্ট\""]],"t":"فَلَ<g>مَّ</>ا رَءَا <h>ٱ</>لْقَمَرَ بَازِ<k>غًۭا قَ</>الَ <m>هَٰ</>ذَا رَبِّى ۖ فَلَ<g>مَّ</><o>آ</> أَفَلَ قَالَ لَ<w>ئِن لَّ</>مْ يَهْدِنِى رَبِّى لَأَكُونَ<g>نَّ</> مِنَ <h>ٱ</>لْقَوْمِ <h>ٱ</><l>ل</><n>ضَّآ</><p>لِّي</>نَ"},{"n":78,"w":[["فَلَمَّا","falammā","When","অতঃপর যখন"],["رَءَا","raā","he saw","দেখলো"],["ٱلشَّمْسَ","l-shamsa","the sun","সূর্যকে"],["بَازِغَةًۭ","bāzighatan","rising","উদীয়মান (উজ্জ্বল)"],["قَالَ","qāla","he said","সে বললো"],["هَـٰذَا","hādhā","This (is)","\"এই"],["رَبِّى","rabbī","my Lord","আমার রব"],["هَـٰذَآ","hādhā","this (is)","এই"],["أَكْبَرُ ۖ","akbaru","greater","সবচেয়ে বড়\""],["فَلَمَّآ","falammā","But when","অতঃপর যখন"],["أَفَلَتْ","afalat","it set","তা অস্তমিত হলো"],["قَالَ","qāla","he said","বললো সে"],["يَـٰقَوْمِ","yāqawmi","O my people","\"হে আমার জাতি"],["إِنِّى","innī","Indeed, I am","নিশ্চয়ই আমি"],["بَرِىٓءٌۭ","barīon","free","সম্পর্কহীন"],["مِّمَّا","mimmā","of what","(তা) হতে না"],["تُشْرِكُونَ","tush'rikūna","you associate (with Allah)","তোমরা শিরক করছো\""]],"t":"فَلَ<g>مَّ</>ا رَءَا <h>ٱ</><l>ل</>شَّمْسَ بَازِغَ<k>ةًۭ قَ</>الَ <m>هَٰ</>ذَا رَبِّى <m>هَٰ</><o>ذَآ</> أَكْبَرُ ۖ فَلَ<g>مَّ</><o>آ</> أَفَلَتْ قَالَ <m>يَٰ</>قَوْمِ إِ<g>نِّ</>ى بَ<o>رِىٓ</><d>ءٌۭ مِّ</><g>مَّ</>ا تُشْرِ<p>كُو</>نَ"},{"n":79,"w":[["إِنِّى","innī","Indeed, I","নিশ্চয়ই আমি"],["وَجَّهْتُ","wajjahtu","[I] have turned","আমি মুখ ফেরাচ্ছি"],["وَجْهِىَ","wajhiya","my face","আমার মুখ (অর্থাৎ কেন্দ্রীভূত করেছি)"],["لِلَّذِى","lilladhī","to the One Who","(তাঁর) দিকে যিনি"],["فَطَرَ","faṭara","created","সৃষ্টি করেছেন"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশসমূহ"],["وَٱلْأَرْضَ","wal-arḍa","and the earth","ও পৃথিবী"],["حَنِيفًۭا ۖ","ḥanīfan","(as) a true monotheist","একনিষ্ঠভাবে"],["وَمَآ","wamā","and not","এবং নই"],["أَنَا۠","anā","I (am)","আমি"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْمُشْرِكِينَ","l-mush'rikīna","the polytheists","মুশরিকদের"]],"t":"إِ<g>نِّ</>ى وَجَّهْتُ وَ<q>جْ</>هِىَ لِلَّذِى فَطَرَ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضَ حَنِي<d>فًۭا ۖ وَ</><o>مَآ</> أَنَا۠ مِنَ <h>ٱ</>لْمُشْرِ<p>كِي</>نَ"},{"n":80,"w":[["وَحَآجَّهُۥ","waḥājjahu","And argued with him","কিন্তু তার সাথে বিতর্ক করলো"],["قَوْمُهُۥ ۚ","qawmuhu","his people","জাতি তার"],["قَالَ","qāla","He said","সে বললো"],["أَتُحَـٰٓجُّوٓنِّى","atuḥājjūnnī","Do you argue with me","\"কি আমার সাথে বিতর্ক করছো"],["فِى","fī","concerning","সম্বন্ধে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌"],["وَقَدْ","waqad","while certainly","অথচ"],["هَدَىٰنِ ۚ","hadāni","He has guided me","তিনি সঠিক পথ দেখিয়েছেন আমাকে"],["وَلَآ","walā","And not","এবং না"],["أَخَافُ","akhāfu","(do) I fear","আমি ভয় করি"],["مَا","mā","what","তার (যা কিছুর)"],["تُشْرِكُونَ","tush'rikūna","you associate","তোমরা শিরক করো"],["بِهِۦٓ","bihi","with Him","সাথে তাঁর"],["إِلَّآ","illā","unless","এ ছাড়া"],["أَن","an","[that]","যে (যদি)"],["يَشَآءَ","yashāa","wills","ইচ্ছে করেন"],["رَبِّى","rabbī","my Lord","আমার রব"],["شَيْـًۭٔا ۗ","shayan","anything","(অন্য) কিছু"],["وَسِعَ","wasi‘a","Encompasses","পরিব্যাপ্ত করেছেন"],["رَبِّى","rabbī","my Lord","আমার রব"],["كُلَّ","kulla","every","সব"],["شَىْءٍ","shayin","thing","কিছুকে"],["عِلْمًا ۗ","‘il'man","(in) knowledge","জ্ঞানে"],["أَفَلَا","afalā","Then will not","কি তবুও না"],["تَتَذَكَّرُونَ","tatadhakkarūna","you take heed","তোমরা শিক্ষা গ্রহণ করবে"]],"t":"وَ<n>حَآ</>جَّهُ<m>ۥ</> قَوْمُهُ<m>ۥ</> ۚ قَالَ أَتُ<n>حَٰٓجُّوٓ</><g>نِّ</>ى فِى <h>ٱ</>للَّهِ وَقَ<q>دْ</> هَدَ<m>ىٰ</>نِ ۚ وَ<o>لَآ</> أَخَافُ مَا تُشْرِكُونَ بِ<o>هِۦٓ</> إِ<o>لَّآ</> <d>أَن يَ</><o>شَآ</>ءَ رَبِّى شَ<d>يْـًۭٔا ۗ وَ</>سِعَ رَبِّى كُلَّ شَىْءٍ عِلْمًا ۗ أَفَلَا تَتَذَكَّ<p>رُو</>نَ"},{"n":81,"w":[["وَكَيْفَ","wakayfa","And how","এবং কিরূপে"],["أَخَافُ","akhāfu","could I fear","আমি ভয় করবো"],["مَآ","mā","what","তার (যা কিছুকে)"],["أَشْرَكْتُمْ","ashraktum","you associate (with Allah)","শিরক করেছো তোমরা"],["وَلَا","walā","while not","অথচ না"],["تَخَافُونَ","takhāfūna","you fear","তোমরা ভয় করছো"],["أَنَّكُمْ","annakum","that you","যে তোমরা"],["أَشْرَكْتُم","ashraktum","have associated","শিরক করেছো"],["بِٱللَّهِ","bil-lahi","with Allah","সাথে আল্লাহ্‌র"],["مَا","mā","what","যা"],["لَمْ","lam","not","না"],["يُنَزِّلْ","yunazzil","did He send down","তিনি অবতীর্ণ করেছেন"],["بِهِۦ","bihi","for it","সম্বন্ধে সে"],["عَلَيْكُمْ","‘alaykum","to you","উপর তোমাদের"],["سُلْطَـٰنًۭا ۚ","sul'ṭānan","any authority","কোনো প্রমাণ"],["فَأَىُّ","fa-ayyu","So which","সুতরাং কোনো (পক্ষ)"],["ٱلْفَرِيقَيْنِ","l-farīqayni","(of) the two parties","দুই পক্ষের"],["أَحَقُّ","aḥaqqu","has more right","অধিকযোগ্য"],["بِٱلْأَمْنِ ۖ","bil-amni","to security","নিরাপত্তা লাভের"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you","তোমরা থাকো"],["تَعْلَمُونَ","ta‘lamūna","know","তোমরা জানো(তবে বলো)\""]],"t":"وَكَيْفَ أَخَافُ <o>مَآ</> أَشْرَكْتُمْ وَلَا تَخَافُونَ أَ<g>نَّ</>كُمْ أَشْرَكْ<f>تُم بِ</><h>ٱ</>للَّهِ مَا لَمْ يُنَزِّلْ بِ<m>هِۦ</> عَلَيْكُمْ سُلْ<m>طَٰ</><k>نًۭا ۚ فَ</>أَىُّ <h>ٱ</>لْفَرِيقَيْنِ أَحَقُّ بِ<h>ٱ</>لْأَمْنِ ۖ إِ<k>ن كُنتُ</>مْ تَعْلَ<p>مُو</>نَ"},{"n":82,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["ءَامَنُوا۟","āmanū","believed","ঈমান এনেছে"],["وَلَمْ","walam","and (did) not","এবং নি"],["يَلْبِسُوٓا۟","yalbisū","mix","মিশ্রিত করেছে"],["إِيمَـٰنَهُم","īmānahum","their belief","ঈমান তাদের"],["بِظُلْمٍ","biẓul'min","with wrong","সাথে সীমালঙ্ঘনের"],["أُو۟لَـٰٓئِكَ","ulāika","those","ঐ সব লোক"],["لَهُمُ","lahumu","for them","জন্যে তাদের (রয়েছে)"],["ٱلْأَمْنُ","l-amnu","(is) the security","নিরাপত্তা"],["وَهُم","wahum","and they","এবং তারা"],["مُّهْتَدُونَ","muh'tadūna","(are) rightly guided","সৎপথ প্রাপ্ত"]],"t":"ٱلَّذِينَ ءَامَنُو<s>ا۟</> وَلَمْ يَلْبِ<o>سُوٓ</><s>ا۟</> إِي<m>مَٰ</>نَ<f>هُم بِ</>ظُلْمٍ أُ<s>و۟</><o>لَٰٓ</>ئِكَ لَهُمُ <h>ٱ</>لْأَمْنُ وَ<y>هُم مُّ</>هْتَ<p>دُو</>نَ"},{"n":83,"w":[["وَتِلْكَ","watil'ka","And this","এবং এই"],["حُجَّتُنَآ","ḥujjatunā","(is) Our argument","আমাদের যুক্তি"],["ءَاتَيْنَـٰهَآ","ātaynāhā","We gave it","আমরা দিয়েছিলাম তা"],["إِبْرَٰهِيمَ","ib'rāhīma","(to) Ibrahim","ইবরাহীমের"],["عَلَىٰ","‘alā","against","মুকাবিলায়"],["قَوْمِهِۦ ۚ","qawmihi","his people","জাতির তার"],["نَرْفَعُ","narfa‘u","We raise","উন্নীত আমরা করি"],["دَرَجَـٰتٍۢ","darajātin","(by) degrees","মর্যাদাসমূহে"],["مَّن","man","whom","যাকে"],["نَّشَآءُ ۗ","nashāu","We will","ইচ্ছে করি আমরা"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["رَبَّكَ","rabbaka","your Lord","তোমার রব"],["حَكِيمٌ","ḥakīmun","(is) All-Wise","প্রজ্ঞাময়"],["عَلِيمٌۭ","‘alīmun","All-Knowing","মহাজ্ঞানী"]],"t":"وَتِلْكَ حُجَّتُ<o>نَآ</> ءَاتَيْ<m>نَٰ</><o>هَآ</> إِ<q>بْ</><m>رَٰ</>هِيمَ عَلَىٰ قَوْمِ<m>هِۦ</> ۚ نَرْفَعُ دَرَ<m>جَٰ</><d>تٍۢ مَّن نَّ</><o>شَآ</>ءُ ۗ إِ<g>نَّ</> رَبَّكَ حَكِيمٌ عَ<p>لِي</>مٌۭ"},{"n":84,"w":[["وَوَهَبْنَا","wawahabnā","And We bestowed","এবং  দান করেছি আমরা"],["لَهُۥٓ","lahu","to him","তাকে"],["إِسْحَـٰقَ","is'ḥāqa","Isaac","ইসহাক"],["وَيَعْقُوبَ ۚ","waya‘qūba","and Yaqub","ও ইয়াকুবকে"],["كُلًّا","kullan","all","প্রত্যেককে"],["هَدَيْنَا ۚ","hadaynā","We guided","সৎপথ দেখিয়েছি আমরা"],["وَنُوحًا","wanūḥan","And Nuh","এবং নূহকেও"],["هَدَيْنَا","hadaynā","We guided","সৎপথ দেখিয়েছি আমরা"],["مِن","min","from","থেকে"],["قَبْلُ ۖ","qablu","before","পূর্ব"],["وَمِن","wamin","and of","এবং মধ্যে থেকে"],["ذُرِّيَّتِهِۦ","dhurriyyatihi","his descendents","বংশধরদের তার"],["دَاوُۥدَ","dāwūda","Dawood","(যেমন) দাউদ"],["وَسُلَيْمَـٰنَ","wasulaymāna","and Sulaiman","ও সুলায়মান"],["وَأَيُّوبَ","wa-ayyūba","and Ayyub","ও আয়্যুব"],["وَيُوسُفَ","wayūsufa","and Yusuf","ও ইউসুফ"],["وَمُوسَىٰ","wamūsā","and Musa","ও মূসা"],["وَهَـٰرُونَ ۚ","wahārūna","and Harun","এবং হারুনকে (সৎপথ দেখিয়েছি)"],["وَكَذَٰلِكَ","wakadhālika","And thus","এবং এভাবে"],["نَجْزِى","najzī","We reward","পুরস্কার দিই আমরা"],["ٱلْمُحْسِنِينَ","l-muḥ'sinīna","the good-doers","সৎকর্মপরায়ণদেরকে"]],"t":"وَوَهَ<q>بْ</>نَا لَهُ<o>ۥٓ</> إِسْ<m>حَٰ</>قَ وَيَعْقُوبَ ۚ كُلًّا هَدَيْنَا ۚ وَنُوحًا هَدَيْنَا مِ<k>ن قَ</><q>بْ</>لُ ۖ وَمِ<k>ن ذُ</>رِّيَّتِ<m>هِۦ</> دَاوُ<m>ۥ</>دَ وَسُلَيْ<m>مَٰ</>نَ وَأَيُّوبَ وَيُوسُفَ وَمُوسَىٰ وَ<m>هَٰ</>رُونَ ۚ وَكَ<m>ذَٰ</>لِكَ نَ<q>جْ</>زِى <h>ٱ</>لْمُحْسِ<p>نِي</>نَ"},{"n":85,"w":[["وَزَكَرِيَّا","wazakariyyā","And Zakariya","এবং যাকারিয়া"],["وَيَحْيَىٰ","wayaḥyā","and Yahya","ও ইয়াহইয়া"],["وَعِيسَىٰ","wa‘īsā","and Isa","ও ঈসা"],["وَإِلْيَاسَ ۖ","wa-il'yāsa","and Elijah ","ও ইলয়াস"],["كُلٌّۭ","kullun","all (were)","প্রত্যেকেই ছিলো"],["مِّنَ","mina","of","অন্তর্ভুক্ত"],["ٱلصَّـٰلِحِينَ","l-ṣāliḥīna","the righteous","সৎলোকদের"]],"t":"وَزَكَرِيَّا وَيَحْيَىٰ وَعِيسَىٰ وَإِلْيَاسَ ۖ كُ<d>لٌّۭ مِّ</>نَ <h>ٱ</><l>ل</><m>صَّٰ</>لِ<p>حِي</>نَ"},{"n":86,"w":[["وَإِسْمَـٰعِيلَ","wa-is'mā‘īla","And Ishmael","এবং ইসমাঈল"],["وَٱلْيَسَعَ","wal-yasa‘a","and Elisha","ও আল-ইয়াসায়া"],["وَيُونُسَ","wayūnusa","and Yunus","ও ইউনুস"],["وَلُوطًۭا ۚ","walūṭan","and Lut","ও লুত"],["وَكُلًّۭا","wakullan","and all","এবং প্রত্যেককে"],["فَضَّلْنَا","faḍḍalnā","We preferred","শ্রেষ্ঠত্ব দিয়েছি আমরা"],["عَلَى","‘alā","over","উপর"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","the worlds","বিশ্বজগতের (লোকদের)"]],"t":"وَإِسْ<m>مَٰ</>عِيلَ وَ<h>ٱ</>لْيَسَعَ وَيُونُسَ وَلُو<d>طًۭا ۚ وَ</>كُ<k>لًّۭا فَ</>ضَّلْنَا عَلَى <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":87,"w":[["وَمِنْ","wamin","And from","এবং মধ্য হতে"],["ءَابَآئِهِمْ","ābāihim","their fathers","পিতৃপুরুষদের তাদের"],["وَذُرِّيَّـٰتِهِمْ","wadhurriyyātihim","and their descendents","ও বংশধরদের তাদের"],["وَإِخْوَٰنِهِمْ ۖ","wa-ikh'wānihim","and their brothers ","এবং ভ্রাতাদেরও তাদের"],["وَٱجْتَبَيْنَـٰهُمْ","wa-ij'tabaynāhum","and We chose them","এবং আমরা মনোনীত করেছি তাদের"],["وَهَدَيْنَـٰهُمْ","wahadaynāhum","and We guided them","ও আমরা পথ দেখিয়েছি তাদের"],["إِلَىٰ","ilā","to","দিকে"],["صِرَٰطٍۢ","ṣirāṭin","a path","পথের"],["مُّسْتَقِيمٍۢ","mus'taqīmin","straight","সরলসোজা"]],"t":"وَمِنْ ءَا<o>بَآ</>ئِهِمْ وَذُرِّ<m>يَّٰ</>تِهِمْ وَإِخْ<m>وَٰ</>نِهِمْ ۖ وَ<h>ٱ</><q>جْ</>تَبَيْ<m>نَٰ</>هُمْ وَهَدَيْ<m>نَٰ</>هُمْ إِلَىٰ صِ<m>رَٰ</><d>طٍۢ مُّ</>سْتَ<p>قِي</>مٍۢ"},{"n":88,"w":[["ذَٰلِكَ","dhālika","That","এটা"],["هُدَى","hudā","(is the) Guidance","সৎপথ"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহ্‌র"],["يَهْدِى","yahdī","He guides","তিনি পরিচালনা করেন"],["بِهِۦ","bihi","with it","উপর তার"],["مَن","man","whom","যাকে"],["يَشَآءُ","yashāu","He wills","তিনি ইচ্ছে করেন"],["مِنْ","min","of","মধ্য হতে"],["عِبَادِهِۦ ۚ","‘ibādihi","His slaves","দাসদের তাঁর"],["وَلَوْ","walaw","But if","এবং যদি"],["أَشْرَكُوا۟","ashrakū","they (had) associated partners (with Allah)","তারা শিরক করতো"],["لَحَبِطَ","laḥabiṭa","surely (would be) worthless","অবশ্যই নষ্ট হতো"],["عَنْهُم","‘anhum","for them","থেকে তাদের"],["مَّا","mā","what","যা"],["كَانُوا۟","kānū","they used to","তারা ছিলো"],["يَعْمَلُونَ","ya‘malūna","do","কাজ করতে"]],"t":"<m>ذَٰ</>لِكَ هُدَى <h>ٱ</>للَّهِ يَهْدِى بِ<m>هِۦ</> <d>مَن يَ</><o>شَآ</>ءُ مِنْ عِبَادِ<m>هِۦ</> ۚ وَلَوْ أَشْرَكُو<s>ا۟</> لَحَبِطَ عَنْ<y>هُم مَّ</>ا كَانُو<s>ا۟</> يَعْمَ<p>لُو</>نَ"},{"n":89,"w":[["أُو۟لَـٰٓئِكَ","ulāika","Those ","ঐ সব লোক"],["ٱلَّذِينَ","alladhīna","(are) ones whom","তারাই"],["ءَاتَيْنَـٰهُمُ","ātaynāhumu","We gave them","আমরা দিয়েছি যাদেরকে"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","কিতাব"],["وَٱلْحُكْمَ","wal-ḥuk'ma","and the judgment","ও হেকমত, প্রজ্ঞা, যোগ্যতা,কর্তৃত্ব"],["وَٱلنُّبُوَّةَ ۚ","wal-nubuwata","and the Prophethood","ও নবুয়্যত"],["فَإِن","fa-in","But if","তারপর যদি"],["يَكْفُرْ","yakfur","disbelieve","অস্বীকার করে"],["بِهَا","bihā","in it","প্রতি তার"],["هَـٰٓؤُلَآءِ","hāulāi","these","এ সব (লোক)"],["فَقَدْ","faqad","then indeed","তবে নিশ্চয়ই"],["وَكَّلْنَا","wakkalnā","We have entrusted","ভার অর্পণ করেছি আমরা"],["بِهَا","bihā","it","তার"],["قَوْمًۭا","qawman","(to) a people","(এমন) সম্প্রদায়ের উপর"],["لَّيْسُوا۟","laysū","who are not","তারা নয়"],["بِهَا","bihā","therein","তার প্রতি"],["بِكَـٰفِرِينَ","bikāfirīna","disbelievers","অস্বীকারকারী"]],"t":"أُ<s>و۟</><o>لَٰٓ</>ئِكَ <h>ٱ</>لَّذِينَ ءَاتَيْ<m>نَٰ</>هُمُ <h>ٱ</>لْكِ<m>تَٰ</>بَ وَ<h>ٱ</>لْحُكْمَ وَ<h>ٱ</><l>ل</><g>نُّ</>بُوَّةَ ۚ فَ<d>إِن يَ</>كْفُرْ بِهَا <o>هَٰٓؤُلَآ</>ءِ فَقَ<q>دْ</> وَكَّلْنَا بِهَا قَوْ<w>مًۭا لَّ</>يْسُو<s>ا۟</> بِهَا بِ<m>كَٰ</>فِ<p>رِي</>نَ"},{"n":90,"w":[["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐ সব (নাবী রাসূল)"],["ٱلَّذِينَ","alladhīna","(are) ones whom","তাদেরকে"],["هَدَى","hadā","(have been) guided","সৎপথে পরিচালনা করেছিলেন"],["ٱللَّهُ ۖ","l-lahu","(by) Allah","আল্লাহ্‌"],["فَبِهُدَىٰهُمُ","fabihudāhumu","so of their guidance","সুতরাং প্রতি সঠিক পথের তাদের"],["ٱقْتَدِهْ ۗ","iq'tadih","you follow","তুমি অনুসরণ করো"],["قُل","qul","Say","(হে নাবী) বলো"],["لَّآ","lā","Not","\"না"],["أَسْـَٔلُكُمْ","asalukum","I ask you","তোমাদের কাছে চাই আমি"],["عَلَيْهِ","‘alayhi","for it","এর জন্য"],["أَجْرًا ۖ","ajran","any reward","কোনো পারিশ্রমিক"],["إِنْ","in","Not","নয়"],["هُوَ","huwa","(is) it","তা"],["إِلَّا","illā","but","এ ছাড়া"],["ذِكْرَىٰ","dhik'rā","a reminder","উপদেশ"],["لِلْعَـٰلَمِينَ","lil'‘ālamīna","for the worlds","জন্যে বিশ্বজগতের\""]],"t":"أُ<s>و۟</><o>لَٰٓ</>ئِكَ <h>ٱ</>لَّذِينَ هَدَى <h>ٱ</>للَّهُ ۖ فَبِهُدَ<m>ىٰ</>هُمُ <h>ٱ</><q>قْ</>تَدِهْ ۗ قُل <o>لَّآ</> أَسْـَٔلُكُمْ عَلَيْهِ أَ<q>جْ</>رًا ۖ إِنْ هُوَ إِلَّا ذِكْرَىٰ لِلْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":91,"w":[["وَمَا","wamā","And not","এবং না"],["قَدَرُوا۟","qadarū","they appraised","তারা মর্যাদা দিলো"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌কে"],["حَقَّ","ḥaqqa","(with) true","যথাযথ"],["قَدْرِهِۦٓ","qadrihi","[of his] appraisal","মর্যাদা তাঁর"],["إِذْ","idh","when","যখন"],["قَالُوا۟","qālū","they said","তারা বলেছিলো"],["مَآ","mā","Not","\"না"],["أَنزَلَ","anzala","revealed","\"অবতীর্ণ করেছেন"],["ٱللَّهُ","l-lahu","(by) Allah","\"আল্লাহ্‌"],["عَلَىٰ","‘alā","on","উপর"],["بَشَرٍۢ","basharin","a human being","কোনো মানুষের"],["مِّن","min","[of]","কোনো"],["شَىْءٍۢ ۗ","shayin","anything","কিছুই (অর্থাৎ কিতাব)\""],["قُلْ","qul","Say","বলো"],["مَنْ","man","Who","\"কে"],["أَنزَلَ","anzala","revealed","অবতীর্ণ করেছেন"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","কিতাব"],["ٱلَّذِى","alladhī","which","যা"],["جَآءَ","jāa","brought","এসেছিলো"],["بِهِۦ","bihi","[it]","নিয়ে তা"],["مُوسَىٰ","mūsā","Musa","মূসা"],["نُورًۭا","nūran","(as) a light","আলো"],["وَهُدًۭى","wahudan","and guidance","ও পথ নির্দেশস্বরূপ"],["لِّلنَّاسِ ۖ","lilnnāsi","for the people","জন্যে মানুষের"],["تَجْعَلُونَهُۥ","taj‘alūnahu","You make it","তোমরা রাখো তা"],["قَرَاطِيسَ","qarāṭīsa","(into) parchments","কাগজসমূহে"],["تُبْدُونَهَا","tub'dūnahā","you disclose (some of) it","প্রকাশ করো (কিছু)তার"],["وَتُخْفُونَ","watukh'fūna","and you conceal","ও গোপন করো"],["كَثِيرًۭا ۖ","kathīran","much (of it)","অনেক (কিছু)"],["وَعُلِّمْتُم","wa‘ullim'tum","And you were taught","এবং শিক্ষা দেয়া হয়েছিলো তোমাদের"],["مَّا","mā","what","যা"],["لَمْ","lam","not","না"],["تَعْلَمُوٓا۟","ta‘lamū","knew","তোমরা জানতে"],["أَنتُمْ","antum","you","(না) তোমরা"],["وَلَآ","walā","and not","আর না"],["ءَابَآؤُكُمْ ۖ","ābāukum","your forefathers","বাপ দাদারা তোমাদের\""],["قُلِ","quli","Say","বলো"],["ٱللَّهُ ۖ","l-lahu","Allah (revealed it)","\"আল্লাহ্‌ই (অবতীর্ণ করেছেন)\""],["ثُمَّ","thumma","Then","এরপর"],["ذَرْهُمْ","dharhum","leave them","ছেড়ে দাও তাদের"],["فِى","fī","in","মধ্যে"],["خَوْضِهِمْ","khawḍihim","their discourse ","অর্থহীন আলোচনার তাদের"],["يَلْعَبُونَ","yal‘abūna","playing","তারা খেলতে থাকুক"]],"t":"وَمَا قَدَرُو<s>ا۟</> <h>ٱ</>للَّهَ حَقَّ قَ<q>دْ</>رِ<o>هِۦٓ</> إِذْ قَالُو<s>ا۟</> <o>مَآ</> أَ<k>نزَ</>لَ <h>ٱ</>للَّهُ عَلَىٰ بَشَ<d>رٍۢ مِّ</><k>ن شَىْءٍۢ ۗ قُ</>لْ مَنْ أَ<k>نزَ</>لَ <h>ٱ</>لْكِ<m>تَٰ</>بَ <h>ٱ</>لَّذِى <o>جَآ</>ءَ بِ<m>هِۦ</> مُوسَىٰ نُو<d>رًۭا وَ</>هُ<w>دًۭى لِّ</>ل<g>نَّ</>اسِ ۖ تَ<q>جْ</>عَلُونَهُ<m>ۥ</> قَرَاطِيسَ تُ<q>بْ</>دُونَهَا وَتُخْفُونَ كَثِي<d>رًۭا ۖ وَ</>عُلِّمْ<y>تُم مَّ</>ا لَمْ تَعْلَ<o>مُوٓ</><s>ا۟</> أَ<k>نتُ</>مْ وَ<o>لَآ</> ءَا<o>بَآ</>ؤُكُمْ ۖ قُلِ <h>ٱ</>للَّهُ ۖ ثُ<g>مَّ</> ذَرْهُمْ فِى خَوْضِهِمْ يَلْعَ<p>بُو</>نَ"},{"n":92,"w":[["وَهَـٰذَا","wahādhā","And this","এবং এই"],["كِتَـٰبٌ","kitābun","(is) a Book","কিতাব"],["أَنزَلْنَـٰهُ","anzalnāhu","We have revealed it","আমরা অবতীর্ণ করেছি তা"],["مُبَارَكٌۭ","mubārakun","blessed","কল্যাণময়"],["مُّصَدِّقُ","muṣaddiqu","confirming","সত্যায়নকারী (হিসেবে)"],["ٱلَّذِى","alladhī","which","যা"],["بَيْنَ","bayna","(came) before","মাঝে"],["يَدَيْهِ","yadayhi","its hands","হাতের তার"],["وَلِتُنذِرَ","walitundhira","so that you may warn","এবং যেন তুমি সতর্ক করো"],["أُمَّ","umma","(the) mother","মা"],["ٱلْقُرَىٰ","l-qurā","(of) the cities","জনপদসমূহের (অর্থাৎ মক্কার লোকদেরকে)"],["وَمَنْ","waman","and who","ও যারা (আছে)"],["حَوْلَهَا ۚ","ḥawlahā","(are) around it","চারপাশে তার"],["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["يُؤْمِنُونَ","yu'minūna","believe","ঈমান আনে"],["بِٱلْـَٔاخِرَةِ","bil-ākhirati","in the Hereafter","উপর আখিরাতের"],["يُؤْمِنُونَ","yu'minūna","they believe","তারা ঈমান আনে"],["بِهِۦ ۖ","bihi","in it","উপর তার"],["وَهُمْ","wahum","and they","এবং তারা"],["عَلَىٰ","‘alā","over","উপর"],["صَلَاتِهِمْ","ṣalātihim","their prayers","তাদের সালাতের"],["يُحَافِظُونَ","yuḥāfiẓūna","(are) guarding","রক্ষা করে"]],"t":"وَ<m>هَٰ</>ذَا كِ<m>تَٰ</>بٌ أَ<k>نزَ</>لْ<m>نَٰ</>هُ مُبَارَ<d>كٌۭ مُّ</>صَدِّقُ <h>ٱ</>لَّذِى بَيْنَ يَدَيْهِ وَلِتُ<k>نذِ</>رَ أُ<g>مَّ</> <h>ٱ</>لْقُرَىٰ وَمَنْ حَوْلَهَا ۚ وَ<h>ٱ</>لَّذِينَ يُؤْمِنُونَ بِ<h>ٱ</>لْءَاخِرَةِ يُؤْمِنُونَ بِ<m>هِۦ</> ۖ وَهُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِ<p>ظُو</>نَ"},{"n":93,"w":[["وَمَنْ","waman","And who","এবং কে (হবে)"],["أَظْلَمُ","aẓlamu","(is) more unjust","বড় সীমালঙ্ঘনকারী"],["مِمَّنِ","mimmani","than (one) who","(তার) চেয়ে যে"],["ٱفْتَرَىٰ","if'tarā","invents","রচনা করে"],["عَلَى","‘alā","about","উপর"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌র"],["كَذِبًا","kadhiban","a lie","মিথ্যা"],["أَوْ","aw","or","বা"],["قَالَ","qāla","said","বলে"],["أُوحِىَ","ūḥiya","It has been inspired","\"ওহী করা হয়েছে"],["إِلَىَّ","ilayya","to me","আমার প্রতি\""],["وَلَمْ","walam","while not","অথচ নি"],["يُوحَ","yūḥa","it was inspired","ওহী করা হয়"],["إِلَيْهِ","ilayhi","to him","প্রতি তার"],["شَىْءٌۭ","shayon","anything","কিছুই"],["وَمَن","waman","and (one) who","এবং যে"],["قَالَ","qāla","said","বলে"],["سَأُنزِلُ","sa-unzilu","I will reveal","\"অবতীর্ণ করবো আমিও"],["مِثْلَ","mith'la","like","অনুরূপ"],["مَآ","mā","what","যা"],["أَنزَلَ","anzala","(has been) revealed","অবতীর্ণ করেছেন\""],["ٱللَّهُ ۗ","l-lahu","(by) Allah","আল্লাহ্‌\""],["وَلَوْ","walaw","And if","এবং (হায়) যদি"],["تَرَىٰٓ","tarā","you (could) see","তুমি দেখতে"],["إِذِ","idhi","when","যখন (থাকবে)"],["ٱلظَّـٰلِمُونَ","l-ẓālimūna","the wrongdoers","সীমালঙ্ঘনকারীরা"],["فِى","fī","(are) in","মধ্যে"],["غَمَرَٰتِ","ghamarāti","agonies","যন্ত্রণার"],["ٱلْمَوْتِ","l-mawti","(of) [the] death","মৃত্যুর"],["وَٱلْمَلَـٰٓئِكَةُ","wal-malāikatu","while the Angels","এবং ফেরেশতাগণ"],["بَاسِطُوٓا۟","bāsiṭū","(are) stretching out","প্রসারিত করে"],["أَيْدِيهِمْ","aydīhim","their hands (saying)","তাদের হাতগুলো (এবং বলবে)"],["أَخْرِجُوٓا۟","akhrijū","Discharge","\"তোমরা বের করো"],["أَنفُسَكُمُ ۖ","anfusakumu","your souls","তোমাদের প্রাণগুলো"],["ٱلْيَوْمَ","l-yawma","Today","আজ"],["تُجْزَوْنَ","tuj'zawna","you will be recompensed","তোমাদের পুরস্কার দেওয়া হবে"],["عَذَابَ","‘adhāba","(with) punishment","শাস্তি"],["ٱلْهُونِ","l-hūni","humiliating","অপমানকর"],["بِمَا","bimā","because","এ কারণে যা"],["كُنتُمْ","kuntum","you used to","তোমরা ছিলে"],["تَقُولُونَ","taqūlūna","say","তোমরা বলে এসেছো"],["عَلَى","‘alā","against","উপর"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌র"],["غَيْرَ","ghayra","other than","নয়"],["ٱلْحَقِّ","l-ḥaqi","the truth","ন্যায়"],["وَكُنتُمْ","wakuntum","and you were","এবং তোমরা ছিলে"],["عَنْ","‘an","towards","হতে"],["ءَايَـٰتِهِۦ","āyātihi","His Verses","নিদর্শনাদি তাঁর"],["تَسْتَكْبِرُونَ","tastakbirūna","being arrogant","অহংকার করতে\""]],"t":"وَمَنْ أَظْلَمُ مِ<g>مَّ</>نِ <h>ٱ</>فْتَرَىٰ عَلَى <h>ٱ</>للَّهِ كَذِبًا أَوْ قَالَ أُوحِىَ إِلَىَّ وَلَمْ يُوحَ إِلَيْهِ <d>شَىْءٌۭ وَ</>مَ<k>ن قَ</>الَ سَأُ<k>نزِ</>لُ مِثْلَ <o>مَآ</> أَ<k>نزَ</>لَ <h>ٱ</>للَّهُ ۗ وَلَوْ تَرَ<o>ىٰٓ</> إِذِ <h>ٱ</><l>ل</><m>ظَّٰ</>لِمُونَ فِى غَمَ<m>رَٰ</>تِ <h>ٱ</>لْمَوْتِ وَ<h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةُ بَاسِ<o>طُوٓ</><s>ا۟</> أَيْدِيهِمْ أَخْرِ<o>جُوٓ</><s>ا۟</> أَ<k>نفُ</>سَكُمُ ۖ <h>ٱ</>لْيَوْمَ تُ<q>جْ</>زَوْنَ عَذَابَ <h>ٱ</>لْهُونِ بِمَا كُ<k>نتُ</>مْ تَقُولُونَ عَلَى <h>ٱ</>للَّهِ غَيْرَ <h>ٱ</>لْحَقِّ وَكُ<k>نتُ</>مْ عَنْ ءَا<m>يَٰتِهِۦ</> تَسْتَكْبِ<p>رُو</>نَ"},{"n":94,"w":[["وَلَقَدْ","walaqad","And certainly","এবং (তিনি বলবেন) নিশ্চয়ই"],["جِئْتُمُونَا","ji'tumūnā","you have come to Us","আমাদের কাছে তোমরা এসেছো"],["فُرَٰدَىٰ","furādā","alone","একাকী"],["كَمَا","kamā","as","যেমন"],["خَلَقْنَـٰكُمْ","khalaqnākum","We created you","আমরা সৃষ্টি করেছি তোমাদের"],["أَوَّلَ","awwala","(the) first","প্রথম"],["مَرَّةٍۢ","marratin","time","বার"],["وَتَرَكْتُم","wataraktum","and you have left","ও ছেড়ে এসেছো তোমরা"],["مَّا","mā","whatever","যা"],["خَوَّلْنَـٰكُمْ","khawwalnākum","We bestowed (on) you","আমরা দিয়েছিলাম তোমাদের"],["وَرَآءَ","warāa","behind","পিছনে"],["ظُهُورِكُمْ ۖ","ẓuhūrikum","your backs","পিঠের তোমাদের"],["وَمَا","wamā","And not","এবং না"],["نَرَىٰ","narā","We see","দেখছি আমরা"],["مَعَكُمْ","ma‘akum","with you","সাথে তোমাদের"],["شُفَعَآءَكُمُ","shufa‘āakumu","your intercessors","সুপারিশকারীদেরকে তোমাদের"],["ٱلَّذِينَ","alladhīna","those whom","যাদেরকে"],["زَعَمْتُمْ","za‘amtum","you claimed","ধারণা করতে তোমরা"],["أَنَّهُمْ","annahum","that they (were)","যে তারা"],["فِيكُمْ","fīkum","in your (matters)","তোমাদের ব্যাপার"],["شُرَكَـٰٓؤُا۟ ۚ","shurakāu","partners (with Allah)","অংশীদাররা (হবে কার্যোদ্ধারের জন্যে)"],["لَقَد","laqad","Indeed","নিশ্চয়ই"],["تَّقَطَّعَ","taqaṭṭa‘a","have been severed (bonds)","ছিন্ন হয়েছে (সম্পর্ক)"],["بَيْنَكُمْ","baynakum","between you","মাঝে তোমাদের"],["وَضَلَّ","waḍalla","and is lost","ও হারিয়ে গিয়েছে"],["عَنكُم","‘ankum","from you","থেকে তোমাদের"],["مَّا","mā","what","যা"],["كُنتُمْ","kuntum","you used to","তোমরা ছিলে"],["تَزْعُمُونَ","taz‘umūna","claim","তোমরা ধারণা করতে\""]],"t":"وَلَقَ<q>دْ</> جِئْتُمُونَا فُ<m>رَٰ</>دَىٰ كَمَا خَلَ<q>قْ</><m>نَٰ</>كُمْ أَوَّلَ مَرَّ<d>ةٍۢ وَ</>تَرَكْ<y>تُم مَّ</>ا خَوَّلْ<m>نَٰ</>كُمْ وَ<o>رَآ</>ءَ ظُهُورِكُمْ ۖ وَمَا نَرَىٰ مَعَكُمْ شُفَ<o>عَآ</>ءَكُمُ <h>ٱ</>لَّذِينَ زَعَمْتُمْ أَ<g>نَّ</>هُمْ فِيكُمْ شُرَ<o>كَٰٓ</>ؤُ<s>ا۟</> ۚ لَقَ<j>د</> تَّقَطَّعَ بَيْنَكُمْ وَضَلَّ عَ<k>نكُ</><y>م مَّ</>ا كُ<k>نتُ</>مْ تَزْعُ<p>مُو</>نَ"},{"n":95,"w":[["۞ إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["فَالِقُ","fāliqu","(is the) Cleaver","বিদীর্ণকারী"],["ٱلْحَبِّ","l-ḥabi","(of) the grain","শস্য-বীজ"],["وَٱلنَّوَىٰ ۖ","wal-nawā","and the date-seed","ও আঁটি"],["يُخْرِجُ","yukh'riju","He brings forth","বের করেন তিনি"],["ٱلْحَىَّ","l-ḥaya","the living","জীবন্তকে"],["مِنَ","mina","from","থেকে"],["ٱلْمَيِّتِ","l-mayiti","the dead","মৃতকে"],["وَمُخْرِجُ","wamukh'riju","and brings forth","ও নির্গতকারী"],["ٱلْمَيِّتِ","l-mayiti","the dead","প্রাণহীনকে"],["مِنَ","mina","from","থেকে"],["ٱلْحَىِّ ۚ","l-ḥayi","the living","জীবন্ত"],["ذَٰلِكُمُ","dhālikumu","That","এই (হচ্ছেন)"],["ٱللَّهُ ۖ","l-lahu","(is) Allah","আল্লাহ্‌"],["فَأَنَّىٰ","fa-annā","so how","অতএব কোথায়"],["تُؤْفَكُونَ","tu'fakūna","are you deluded","তোমাদের ফিরিয়ে নেয়া হচ্ছে"]],"t":"۞ إِ<g>نَّ</> <h>ٱ</>للَّهَ فَالِقُ <h>ٱ</>لْحَبِّ وَ<h>ٱ</><l>ل</><g>نَّ</>وَىٰ ۖ يُخْرِجُ <h>ٱ</>لْحَىَّ مِنَ <h>ٱ</>لْمَيِّتِ وَمُخْرِجُ <h>ٱ</>لْمَيِّتِ مِنَ <h>ٱ</>لْحَىِّ ۚ <m>ذَٰ</>لِكُمُ <h>ٱ</>للَّهُ ۖ فَأَ<g>نَّ</>ىٰ تُؤْفَ<p>كُو</>نَ"},{"n":96,"w":[["فَالِقُ","fāliqu","(He is the) Cleaver","তিনিই বিদীর্ণকারী (অন্ধকারের আবরণ)"],["ٱلْإِصْبَاحِ","l-iṣ'bāḥi","(of) the daybreak","প্রভাতের (জন্যে)"],["وَجَعَلَ","waja‘ala","and He has made","ও সৃষ্টি করেছেন"],["ٱلَّيْلَ","al-layla","the night","রাতকে"],["سَكَنًۭا","sakanan","(for) rest","বিশ্রামের (জন্যে)"],["وَٱلشَّمْسَ","wal-shamsa","and the sun","ও (নির্ধারিত করেছেন) সূর্য"],["وَٱلْقَمَرَ","wal-qamara","and the moon","ও চাঁদের"],["حُسْبَانًۭا ۚ","ḥus'bānan","(for) reckoning","(উদয় অস্তের)গণনার জন্যে"],["ذَٰلِكَ","dhālika","That","এটা"],["تَقْدِيرُ","taqdīru","(is the) ordaining","নির্ধারিত"],["ٱلْعَزِيزِ","l-‘azīzi","(of) the All-Mighty","পরাক্রমশালী"],["ٱلْعَلِيمِ","l-‘alīmi","the All-Knowing","মহাজ্ঞানীর (পক্ষ থেকে)"]],"t":"فَالِقُ <h>ٱ</>لْإِصْبَاحِ وَجَعَلَ <h>ٱ</>لَّيْلَ سَكَ<d>نًۭا وَ</><h>ٱ</><l>ل</>شَّمْسَ وَ<h>ٱ</>لْقَمَرَ حُسْبَا<k>نًۭا ۚ ذَٰ</>لِكَ تَ<q>قْ</>دِيرُ <h>ٱ</>لْعَزِيزِ <h>ٱ</>لْعَ<p>لِي</>مِ"},{"n":97,"w":[["وَهُوَ","wahuwa","And He","এবং তিনিই"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["جَعَلَ","ja‘ala","made","সৃষ্টি করেছেন"],["لَكُمُ","lakumu","for you","জন্যে তোমাদের"],["ٱلنُّجُومَ","l-nujūma","the stars","নক্ষত্রগুলো"],["لِتَهْتَدُوا۟","litahtadū","that you may guide yourselves","যেন তোমরা পথ পাও"],["بِهَا","bihā","with them","সাহায্যে তার"],["فِى","fī","in","মধ্যে"],["ظُلُمَـٰتِ","ẓulumāti","the darkness[es]","অন্ধকারে সমূহের"],["ٱلْبَرِّ","l-bari","(of) the land","স্থলে"],["وَٱلْبَحْرِ ۗ","wal-baḥri","and the sea","ও সাগরে"],["قَدْ","qad","Certainly","নিশ্চয়ই"],["فَصَّلْنَا","faṣṣalnā","We have made clear","বিশদ বর্ণনা করেছি আমরা"],["ٱلْـَٔايَـٰتِ","l-āyāti","the Signs","নিদর্শনগুলোকে"],["لِقَوْمٍۢ","liqawmin","for a people","জন্যে সম্প্রদায়ের"],["يَعْلَمُونَ","ya‘lamūna","(who) know","(যারা) জ্ঞান রাখে"]],"t":"وَهُوَ <h>ٱ</>لَّذِى جَعَلَ لَكُمُ <h>ٱ</><l>ل</><g>نُّ</>جُومَ لِتَهْتَدُو<s>ا۟</> بِهَا فِى ظُلُ<m>مَٰ</>تِ <h>ٱ</>لْبَرِّ وَ<h>ٱ</>لْبَحْرِ ۗ قَ<q>دْ</> فَصَّلْنَا <h>ٱ</>لْءَا<m>يَٰ</>تِ لِقَوْ<d>مٍۢ يَ</>عْلَ<p>مُو</>نَ"},{"n":98,"w":[["وَهُوَ","wahuwa","And He","এবং তিনিই"],["ٱلَّذِىٓ","alladhī","(is) the One Who","যিনি"],["أَنشَأَكُم","ansha-akum","(has) produced you","সৃষ্টি করেছেন তোমাদের"],["مِّن","min","from","থেকে"],["نَّفْسٍۢ","nafsin","a soul","ব্যক্তি"],["وَٰحِدَةٍۢ","wāḥidatin","single","এক"],["فَمُسْتَقَرٌّۭ","famus'taqarrun","so (there is) a place of dwelling","অতঃপর বাসস্হান"],["وَمُسْتَوْدَعٌۭ ۗ","wamus'tawda‘un","and a resting place","ও গচ্ছিত রাখার স্থান (নির্ধারিত করেছেন)"],["قَدْ","qad","Certainly","নিশ্চয়ই"],["فَصَّلْنَا","faṣṣalnā","We have made clear","বিশদ বর্ণনা করেছি আমরা"],["ٱلْـَٔايَـٰتِ","l-āyāti","the Signs","নিদর্শনগুলোকে"],["لِقَوْمٍۢ","liqawmin","for a people","জন্যে সম্প্রদায়ের"],["يَفْقَهُونَ","yafqahūna","(who) understand","(যারা)অনুধাবন করে"]],"t":"وَهُوَ <h>ٱ</>لَّ<o>ذِىٓ</> أَ<k>نشَ</>أَ<y>كُم مِّ</><d>ن نَّفْسٍۢ وَٰ</>حِدَ<k>ةٍۢ فَ</>مُسْتَقَ<d>رٌّۭ وَ</>مُسْتَوْدَ<k>عٌۭ ۗ قَ</><q>دْ</> فَصَّلْنَا <h>ٱ</>لْءَا<m>يَٰ</>تِ لِقَوْ<d>مٍۢ يَ</>فْقَ<p>هُو</>نَ"},{"n":99,"w":[["وَهُوَ","wahuwa","And He","এবং তিনিই"],["ٱلَّذِىٓ","alladhī","(is) the One Who","যিনি"],["أَنزَلَ","anzala","sends down","বর্ষণ করেন"],["مِنَ","mina","from","থেকে"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশ"],["مَآءًۭ","māan","water","পানি"],["فَأَخْرَجْنَا","fa-akhrajnā","then We bring forth","অতঃপর বের করেছি আমরা"],["بِهِۦ","bihi","with it","দিয়ে তা"],["نَبَاتَ","nabāta","vegetation","উদ্ভিদ"],["كُلِّ","kulli","(of) every","সব"],["شَىْءٍۢ","shayin","thing","জিনিসের"],["فَأَخْرَجْنَا","fa-akhrajnā","Then We bring forth","অতঃপর বের করেছি আমরা"],["مِنْهُ","min'hu","from it","থেকে তা"],["خَضِرًۭا","khaḍiran","green plant","সবুজ (ক্ষেত  ও বৃক্ষ)"],["نُّخْرِجُ","nukh'riju","We bring forth","বের করি আমরা"],["مِنْهُ","min'hu","from it","থেকে তা"],["حَبًّۭا","ḥabban","grain ","শস্যদানা"],["مُّتَرَاكِبًۭا","mutarākiban","thick clustered","ঘন সন্নিবিষ্ট"],["وَمِنَ","wamina","And from","এবং এর"],["ٱلنَّخْلِ","l-nakhli","the date-palm","খেজুর গাছ"],["مِن","min","from","থেকে"],["طَلْعِهَا","ṭal‘ihā","its spathe","মাথি তার"],["قِنْوَانٌۭ","qin'wānun","clusters of dates","খেজুর থোকা (বের করি)"],["دَانِيَةٌۭ","dāniyatun","hanging low","(যা)ঝুলন্ত"],["وَجَنَّـٰتٍۢ","wajannātin","And gardens","এবং বাগানগুলো"],["مِّنْ","min","of","এর"],["أَعْنَابٍۢ","a‘nābin","grapes","আঙ্গুর"],["وَٱلزَّيْتُونَ","wal-zaytūna","and the olives","ও জলপাই"],["وَٱلرُّمَّانَ","wal-rumāna","and the pomegranates","ও আনারের"],["مُشْتَبِهًۭا","mush'tabihan","resembling","সদৃশ"],["وَغَيْرَ","waghayra","and not","ও নয়"],["مُتَشَـٰبِهٍ ۗ","mutashābihin","resembling","সদৃশ"],["ٱنظُرُوٓا۟","unẓurū","Look","তোমরা লক্ষ্য করো"],["إِلَىٰ","ilā","at","প্রতি"],["ثَمَرِهِۦٓ","thamarihi","its fruit","তার ফলের"],["إِذَآ","idhā","when","যখন"],["أَثْمَرَ","athmara","it bears fruit","ফলবান হয়"],["وَيَنْعِهِۦٓ ۚ","wayan‘ihi","and its ripening","ও পাকে তা"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে (আছে)"],["ذَٰلِكُمْ","dhālikum","that","এর"],["لَـَٔايَـٰتٍۢ","laāyātin","(are) signs","অবশ্যই নিদর্শনাবলী"],["لِّقَوْمٍۢ","liqawmin","for a people","জন্যে সম্প্রদায়ের"],["يُؤْمِنُونَ","yu'minūna","(who) believe","(যারা) ঈমান আনে"]],"t":"وَهُوَ <h>ٱ</>لَّ<o>ذِىٓ</> أَ<k>نزَ</>لَ مِنَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ <o>مَآ</><k>ءًۭ فَ</>أَخْرَ<q>جْ</>نَا بِ<m>هِۦ</> نَبَاتَ كُلِّ <k>شَىْءٍۢ فَ</>أَخْرَ<q>جْ</>نَا مِنْهُ خَضِ<d>رًۭا نُّ</>خْرِجُ مِنْهُ حَ<d>بًّۭا مُّ</>تَرَاكِ<d>بًۭا وَ</>مِنَ <h>ٱ</><l>ل</><g>نَّ</>خْلِ مِ<k>ن طَ</>لْعِهَا قِنْوَا<k>نٌۭ دَ</>انِيَ<d>ةٌۭ وَ</>جَ<g>نَّٰ</><d>تٍۢ مِّ</>نْ أَعْنَا<d>بٍۢ وَ</><h>ٱ</><l>ل</>زَّيْتُونَ وَ<h>ٱ</><l>ل</>رُّ<g>مَّ</>انَ مُشْتَبِ<d>هًۭا وَ</>غَيْرَ مُتَ<m>شَٰ</>بِهٍ ۗ <h>ٱ</><k>نظُ</><o>رُوٓ</><s>ا۟</> إِلَىٰ ثَمَرِ<o>هِۦٓ</> إِ<o>ذَآ</> أَثْمَرَ وَيَنْعِ<o>هِۦٓ ۚ</> إِ<g>نَّ</> فِى <m>ذَٰ</>لِكُمْ لَءَا<m>يَٰ</><w>تٍۢ لِّ</>قَوْ<d>مٍۢ يُ</>ؤْمِ<p>نُو</>نَ"},{"n":100,"w":[["وَجَعَلُوا۟","waja‘alū","And they make","এবং তারা বানিয়েছে"],["لِلَّهِ","lillahi","with Allah","জন্যে আল্লাহ্‌র"],["شُرَكَآءَ","shurakāa","partners ","অংশীদার"],["ٱلْجِنَّ","l-jina","jinn","জিনদেরকে"],["وَخَلَقَهُمْ ۖ","wakhalaqahum","though He has created them","অথচ সৃষ্টি করেছেন তিনি তাদের"],["وَخَرَقُوا۟","wakharaqū","and they falsely attribute","এবং তারা রচনা করেছে"],["لَهُۥ","lahu","to Him","জন্যে তাঁর"],["بَنِينَ","banīna","sons","পুত্র"],["وَبَنَـٰتٍۭ","wabanātin","and daughters","ও কন্যা"],["بِغَيْرِ","bighayri","without","ছাড়া"],["عِلْمٍۢ ۚ","‘il'min","knowledge","কোনো জ্ঞান (মূর্খতাবশত)"],["سُبْحَـٰنَهُۥ","sub'ḥānahu","Glorified is He","মহিমান্বিত তিনি"],["وَتَعَـٰلَىٰ","wata‘ālā","and Exalted","এবং সমুন্নত"],["عَمَّا","‘ammā","above what","(তা) হতে যা"],["يَصِفُونَ","yaṣifūna","they attribute","তারা রচনা করে"]],"t":"وَجَعَلُو<s>ا۟</> لِلَّهِ شُرَ<o>كَآ</>ءَ <h>ٱ</>لْجِ<g>نَّ</> وَخَلَقَهُمْ ۖ وَخَرَقُو<s>ا۟</> لَهُ<m>ۥ</> بَنِينَ وَبَ<m>نَٰ</><i>تٍۭ بِ</>غَيْرِ عِلْ<k>مٍۢ ۚ سُ</><q>بْ</><m>حَٰ</>نَهُ<m>ۥ</> وَتَ<m>عَٰ</>لَىٰ عَ<g>مَّ</>ا يَصِ<p>فُو</>نَ"},{"n":101,"w":[["بَدِيعُ","badī‘u","Originator","তিনি স্রষ্টা"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশসমূহের"],["وَٱلْأَرْضِ ۖ","wal-arḍi","and the earth","ও পৃথিবীর"],["أَنَّىٰ","annā","How","কিরূপে"],["يَكُونُ","yakūnu","can be","হবে"],["لَهُۥ","lahu","for Him","জন্যে তাঁর"],["وَلَدٌۭ","waladun","a son","কোনো সন্তান"],["وَلَمْ","walam","while not","অথচ নি"],["تَكُن","takun","(there) is","হয়"],["لَّهُۥ","lahu","for Him","জন্যে তাঁর"],["صَـٰحِبَةٌۭ ۖ","ṣāḥibatun","a companion","কোনো সঙ্গিনী"],["وَخَلَقَ","wakhalaqa","and He created","এবং তিনি সৃষ্টি করেছেন"],["كُلَّ","kulla","every","সব"],["شَىْءٍۢ ۖ","shayin","thing","কিছুই"],["وَهُوَ","wahuwa","And He","এবং তিনি"],["بِكُلِّ","bikulli","(is) of every","সম্পর্কে সব"],["شَىْءٍ","shayin","thing","কিছু"],["عَلِيمٌۭ","‘alīmun","All-Knower","সবিশেষ অবহিত"]],"t":"بَدِيعُ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ ۖ أَ<g>نَّ</>ىٰ يَكُونُ لَهُ<m>ۥ</> وَلَ<d>دٌۭ وَ</>لَمْ تَ<w>كُن لَّ</>هُ<m>ۥ صَٰ</>حِبَ<d>ةٌۭ ۖ وَ</>خَلَقَ كُلَّ <d>شَىْءٍۢ ۖ وَ</>هُوَ بِكُلِّ شَىْءٍ عَ<p>لِي</>مٌۭ"},{"n":102,"w":[["ذَٰلِكُمُ","dhālikumu","That","এই (হচ্ছেন)"],["ٱللَّهُ","l-lahu","(is) Allah","আল্লাহ্‌"],["رَبُّكُمْ ۖ","rabbukum","your Lord","তোমাদের রব"],["لَآ","lā","(there is) no","নেই"],["إِلَـٰهَ","ilāha","god","কোনো ইলাহ"],["إِلَّا","illā","except","ছাড়া"],["هُوَ ۖ","huwa","Him","তিনি"],["خَـٰلِقُ","khāliqu","(the) Creator","তিনি স্রষ্টা"],["كُلِّ","kulli","(of) every","সব"],["شَىْءٍۢ","shayin","thing","কিছুরই"],["فَٱعْبُدُوهُ ۚ","fa-u‘'budūhu","so worship Him","সুতরাং তোমরা ইবাদাত করো তাঁরই"],["وَهُوَ","wahuwa","And He","এবং তিনিই"],["عَلَىٰ","‘alā","(is) on","উপর"],["كُلِّ","kulli","every","সব"],["شَىْءٍۢ","shayin","thing","কিছুর"],["وَكِيلٌۭ","wakīlun","a Guardian","তত্ত্বাবধায়ক"]],"t":"<m>ذَٰ</>لِكُمُ <h>ٱ</>للَّهُ رَبُّكُمْ ۖ <o>لَآ</> إِ<m>لَٰ</>هَ إِلَّا هُوَ ۖ <m>خَٰ</>لِقُ كُلِّ <k>شَىْءٍۢ فَ</><h>ٱ</>عْبُدُوهُ ۚ وَهُوَ عَلَىٰ كُلِّ <d>شَىْءٍۢ وَ</><p>كِي</>لٌۭ"},{"n":103,"w":[["لَّا","lā","Not (can)","না"],["تُدْرِكُهُ","tud'rikuhu","grasp Him","পেতে পারে তাঁকে"],["ٱلْأَبْصَـٰرُ","l-abṣāru","the visions","দৃষ্টিশক্তিসমূহ"],["وَهُوَ","wahuwa","but He","বরং তিনি"],["يُدْرِكُ","yud'riku","(can) grasp","অধিকার করে আছেন"],["ٱلْأَبْصَـٰرَ ۖ","l-abṣāra","(all) the vision","দৃষ্টিশক্তিসমূহকে"],["وَهُوَ","wahuwa","and He (is)","এবং তিনি"],["ٱللَّطِيفُ","l-laṭīfu","the All-Subtle","সূক্ষ্মদর্শী"],["ٱلْخَبِيرُ","l-khabīru","the All-Aware","সম্যক অবহিত"]],"t":"لَّا تُ<q>دْ</>رِكُهُ <h>ٱ</>لْأَ<q>بْ</><m>صَٰ</>رُ وَهُوَ يُ<q>دْ</>رِكُ <h>ٱ</>لْأَ<q>بْ</><m>صَٰ</>رَ ۖ وَهُوَ <h>ٱ</><l>ل</>لَّطِيفُ <h>ٱ</>لْخَ<p>بِي</>رُ"},{"n":104,"w":[["قَدْ","qad","Verily","নিশ্চয়ই"],["جَآءَكُم","jāakum","has come to you","কাছে এসেছে তোমাদের"],["بَصَآئِرُ","baṣāiru","enlightenment","প্রত্যক্ষ প্রমাণ (অন্তর্দৃষ্টির আলো)"],["مِن","min","from","পক্ষ হতে"],["رَّبِّكُمْ ۖ","rabbikum","your Lord","তোমাদের রবের"],["فَمَنْ","faman","Then whoever","অতএব যে"],["أَبْصَرَ","abṣara","sees","দেখবে"],["فَلِنَفْسِهِۦ ۖ","falinafsihi","then (it is) for his soul","(তা) তবে জন্যে নিজের তার"],["وَمَنْ","waman","and whoever","এবং যে"],["عَمِىَ","‘amiya","(is) blind","অন্ধ হবে"],["فَعَلَيْهَا ۚ","fa‘alayhā","then (it is) against himself","(তার ক্ষতি) তবে তার বিরুদ্ধে যাবে"],["وَمَآ","wamā","And not","এবং নই"],["أَنَا۠","anā","(am) I","আমি"],["عَلَيْكُم","‘alaykum","over you","উপর তোমাদের"],["بِحَفِيظٍۢ","biḥafīẓin","a guardian","কোন রক্ষক"]],"t":"قَ<q>دْ</> <o>جَآ</>ءَ<f>كُم بَ</><o>صَآ</>ئِرُ <w>مِن رَّ</>بِّكُمْ ۖ فَمَنْ أَ<q>بْ</>صَرَ فَلِنَفْسِ<m>هِۦ</> ۖ وَمَنْ عَمِىَ فَعَلَيْهَا ۚ وَ<o>مَآ</> أَنَا۠ عَلَيْ<f>كُم بِ</>حَ<p>فِي</>ظٍۢ"},{"n":105,"w":[["وَكَذَٰلِكَ","wakadhālika","And thus","এবং এভাবে"],["نُصَرِّفُ","nuṣarrifu","We explain","বারবার বর্ণনা করি আমরা"],["ٱلْـَٔايَـٰتِ","l-āyāti","the Signs","নিদর্শনাবলী"],["وَلِيَقُولُوا۟","waliyaqūlū","that they (may) say","এবং তারা যেন (না) বলে"],["دَرَسْتَ","darasta","You have studied","\"তুমি পড়েছো (কারো কাছে)\""],["وَلِنُبَيِّنَهُۥ","walinubayyinahu","and that We (may) make it clear","এবং যেন আমরা স্পষ্ট বর্ণনা করি তা"],["لِقَوْمٍۢ","liqawmin","for a people","(সেসব) জন্যে সম্প্রদায়ের"],["يَعْلَمُونَ","ya‘lamūna","who know","(যারা) জ্ঞান রাখে"]],"t":"وَكَ<m>ذَٰ</>لِكَ نُصَرِّفُ <h>ٱ</>لْءَا<m>يَٰ</>تِ وَلِيَقُولُو<s>ا۟</> دَرَسْتَ وَلِنُبَيِّنَهُ<m>ۥ</> لِقَوْ<d>مٍۢ يَ</>عْلَ<p>مُو</>نَ"},{"n":106,"w":[["ٱتَّبِعْ","ittabi‘","Follow","তুমি অনুসরণ করো"],["مَآ","mā","what","যা"],["أُوحِىَ","ūḥiya","has been inspired","ওহী করা হয়েছে"],["إِلَيْكَ","ilayka","to you","প্রতি তোমার"],["مِن","min","from","পক্ষ হতে"],["رَّبِّكَ ۖ","rabbika","your Lord","তোমার রবের"],["لَآ","lā","(there is) no","নেই"],["إِلَـٰهَ","ilāha","god","কোনো ইলাহ"],["إِلَّا","illā","except","ছাড়া"],["هُوَ ۖ","huwa","Him","তিনি"],["وَأَعْرِضْ","wa-a‘riḍ","and turn away","এবং উপেক্ষা করো (মুখ ফিরাও)"],["عَنِ","‘ani","from","হতে"],["ٱلْمُشْرِكِينَ","l-mush'rikīna","the polytheists","মুশরিকদের"]],"t":"ٱتَّبِعْ <o>مَآ</> أُوحِىَ إِلَيْكَ <w>مِن رَّ</>بِّكَ ۖ <o>لَآ</> إِ<m>لَٰ</>هَ إِلَّا هُوَ ۖ وَأَعْرِضْ عَنِ <h>ٱ</>لْمُشْرِ<p>كِي</>نَ"},{"n":107,"w":[["وَلَوْ","walaw","And if","এবং যদি"],["شَآءَ","shāa","(had) willed","ইচ্ছে করতেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ্‌"],["مَآ","mā","not (they would have)","না"],["أَشْرَكُوا۟ ۗ","ashrakū","associated partners (with Him)","তাঁর শিরক করতো"],["وَمَا","wamā","And not","এবং না"],["جَعَلْنَـٰكَ","ja‘alnāka","We have made you","আমরা নিযুক্ত করেছি তোমাকে"],["عَلَيْهِمْ","‘alayhim","over them","উপর তাদের"],["حَفِيظًۭا ۖ","ḥafīẓan","a guardian","কোনো সংরক্ষক"],["وَمَآ","wamā","and not","আর নও"],["أَنتَ","anta","you","তুমি"],["عَلَيْهِم","‘alayhim","(are) over them","উপর তাদের"],["بِوَكِيلٍۢ","biwakīlin","a manager","কোনো অভিভাবক"]],"t":"وَلَوْ <o>شَآ</>ءَ <h>ٱ</>للَّهُ <o>مَآ</> أَشْرَكُو<s>ا۟ ۗ</> وَمَا جَعَلْ<m>نَٰ</>كَ عَلَيْهِمْ حَفِي<d>ظًۭا ۖ وَ</><o>مَآ</> أَ<k>نتَ</> عَلَيْ<f>هِم بِ</>وَ<p>كِي</>لٍۢ"},{"n":108,"w":[["وَلَا","walā","And (do) not","এবং না"],["تَسُبُّوا۟","tasubbū","insult","তোমরা গালি দিও"],["ٱلَّذِينَ","alladhīna","those whom","যাদেরকে"],["يَدْعُونَ","yad‘ūna","they invoke","তারা ডাকে"],["مِن","min","from","দিয়ে"],["دُونِ","dūni","other than","বাদ"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌কে"],["فَيَسُبُّوا۟","fayasubbū","lest they insult","তবে তারা গালি দিবে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌কে"],["عَدْوًۢا","‘adwan","(in) enmity","সীমালঙ্ঘন করে"],["بِغَيْرِ","bighayri","without","ছাড়া"],["عِلْمٍۢ ۗ","‘il'min","knowledge","কোনো জ্ঞান (মূর্খতাবশতঃ)"],["كَذَٰلِكَ","kadhālika","Thus","এভাবে"],["زَيَّنَّا","zayyannā","We have made fair-seeming","সুশোভিত করেছি আমরা"],["لِكُلِّ","likulli","to every","জন্যে প্রত্যেক"],["أُمَّةٍ","ummatin","community","সম্প্রদায়ের"],["عَمَلَهُمْ","‘amalahum","their deed","কাজকে তাদের"],["ثُمَّ","thumma","Then","এরপর"],["إِلَىٰ","ilā","to","দিকে"],["رَبِّهِم","rabbihim","their Lord","রবের তাদের"],["مَّرْجِعُهُمْ","marji‘uhum","(is) their return","প্রত্যাবর্তন তাদের (হবে)"],["فَيُنَبِّئُهُم","fayunabbi-uhum","then He will inform them","অতঃপর তাদের জানিয়ে দিবেন"],["بِمَا","bimā","about what","সে সম্বন্ধে যা"],["كَانُوا۟","kānū","they used to","তারা ছিলো"],["يَعْمَلُونَ","ya‘malūna","do","তারা কাজ করতে"]],"t":"وَلَا تَسُبُّو<s>ا۟</> <h>ٱ</>لَّذِينَ يَ<q>دْ</>عُونَ مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ فَيَسُبُّو<s>ا۟</> <h>ٱ</>للَّهَ عَ<q>دْ</><i>وًۢا بِ</>غَيْرِ عِلْ<k>مٍۢ ۗ كَ</><m>ذَٰ</>لِكَ زَيَّ<g>نَّ</>ا لِكُلِّ أُ<g>مَّ</>ةٍ عَمَلَهُمْ ثُ<g>مَّ</> إِلَىٰ رَبِّ<y>هِم مَّ</>رْجِعُهُمْ فَيُنَبِّئُ<f>هُم بِ</>مَا كَانُو<s>ا۟</> يَعْمَ<p>لُو</>نَ"},{"n":109,"w":[["وَأَقْسَمُوا۟","wa-aqsamū","And they swear","এবং তারা শপথ করে বলে"],["بِٱللَّهِ","bil-lahi","by Allah","নামে আল্লাহ্‌র"],["جَهْدَ","jahda","strongest","কঠিন"],["أَيْمَـٰنِهِمْ","aymānihim","(of) their oaths","শপথগুলো তাদের"],["لَئِن","la-in","that if","অবশ্যই যদি"],["جَآءَتْهُمْ","jāathum","came to them","কাছে আসে তাদের"],["ءَايَةٌۭ","āyatun","a sign","কোনো নিদর্শন"],["لَّيُؤْمِنُنَّ","layu'minunna","they would surely believe","অবশ্যই তারা ঈমান আনবে"],["بِهَا ۚ","bihā","in it","উপর তার"],["قُلْ","qul","Say","বলো"],["إِنَّمَا","innamā","Only","\"মূলতঃ"],["ٱلْـَٔايَـٰتُ","l-āyātu","the signs","নিদর্শনাবলী"],["عِندَ","‘inda","(are) with","কাছে"],["ٱللَّهِ ۖ","l-lahi","Allah","আল্লাহ্‌রই\""],["وَمَا","wamā","And what","এবং কিসে"],["يُشْعِرُكُمْ","yush'‘irukum","will make you perceive","বোধগম্য করাবে তোমাদের"],["أَنَّهَآ","annahā","that [it]","যে তা"],["إِذَا","idhā","when","যখন"],["جَآءَتْ","jāat","it comes","আসবে"],["لَا","lā","not","না"],["يُؤْمِنُونَ","yu'minūna","they will believe","তারা ঈমান আনবে"]],"t":"وَأَ<q>قْ</>سَمُو<s>ا۟</> بِ<h>ٱ</>للَّهِ جَهْدَ أَيْ<m>مَٰ</>نِهِمْ لَئِ<k>ن جَ</><o>آ</>ءَتْهُمْ ءَايَ<w>ةٌۭ لَّ</>يُؤْمِنُ<g>نَّ</> بِهَا ۚ قُلْ إِ<g>نَّ</>مَا <h>ٱ</>لْءَا<m>يَٰ</>تُ عِ<k>ندَ</> <h>ٱ</>للَّهِ ۖ وَمَا يُشْعِرُكُمْ أَ<g>نَّ</><o>هَآ</> إِذَا <o>جَآ</>ءَتْ لَا يُؤْمِ<p>نُو</>نَ"},{"n":110,"w":[["وَنُقَلِّبُ","wanuqallibu","And We will turn","এবং ফিরিয়ে দিবো আমরা"],["أَفْـِٔدَتَهُمْ","afidatahum","their hearts","অন্তরগুলোকে তাদের"],["وَأَبْصَـٰرَهُمْ","wa-abṣārahum","and their sights","ও দৃষ্টিগুলোকে তাদের"],["كَمَا","kamā","(just) as","যেমন"],["لَمْ","lam","not","নি"],["يُؤْمِنُوا۟","yu'minū","they believe","তারা ঈমান আনে"],["بِهِۦٓ","bihi","in it","উপর তার"],["أَوَّلَ","awwala","(the) first","প্রথম"],["مَرَّةٍۢ","marratin","time","বার"],["وَنَذَرُهُمْ","wanadharuhum","And We will leave them","ও ছেড়ে দিবো আমরা তাদের"],["فِى","fī","in","মধ্যে"],["طُغْيَـٰنِهِمْ","ṭugh'yānihim","their transgression","অবাধ্যতার তাদের"],["يَعْمَهُونَ","ya‘mahūna","wandering blindly","তারা উদ্ভ্রান্ত হয়ে ঘুরে বেড়াবে"]],"t":"وَنُقَلِّبُ أَفْـِٔدَتَهُمْ وَأَ<q>بْ</><m>صَٰ</>رَهُمْ كَمَا لَمْ يُؤْمِنُو<s>ا۟</> بِ<o>هِۦٓ</> أَوَّلَ مَرَّ<d>ةٍۢ وَ</>نَذَرُهُمْ فِى طُغْ<m>يَٰ</>نِهِمْ يَعْمَ<p>هُو</>نَ"},{"n":111,"w":[["۞ وَلَوْ","walaw","And (even) if","এবং যদি (হতো)"],["أَنَّنَا","annanā","[that] We (had)","যে আমরা"],["نَزَّلْنَآ","nazzalnā","[We] sent down","আমরা অবতীর্ণ করতাম"],["إِلَيْهِمُ","ilayhimu","to them","প্রতি তাদের"],["ٱلْمَلَـٰٓئِكَةَ","l-malāikata","the Angels","ফেরেশতাদেরকে"],["وَكَلَّمَهُمُ","wakallamahumu","and spoken to them","এবং তাদের সাথে কথাও বলত"],["ٱلْمَوْتَىٰ","l-mawtā","the dead","মৃতরা"],["وَحَشَرْنَا","waḥasharnā","and We gathered","এবং আমরা একত্র করতাম"],["عَلَيْهِمْ","‘alayhim","before them","সামনে তাদের"],["كُلَّ","kulla","every","সব"],["شَىْءٍۢ","shayin","thing","কিছুই"],["قُبُلًۭا","qubulan","face to face","সামনাসামনি"],["مَّا","mā","not","(তবুও) না"],["كَانُوا۟","kānū","they were","তারা ছিলো"],["لِيُؤْمِنُوٓا۟","liyu'minū","to believe","যেন তারা ঈমান আনবে"],["إِلَّآ","illā","unless","এ ছাড়া"],["أَن","an","[that]","যে"],["يَشَآءَ","yashāa","wills","ইচ্ছে করতেন (তবে ভিন্ন কথা)"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ্‌"],["وَلَـٰكِنَّ","walākinna","But","কিন্তু"],["أَكْثَرَهُمْ","aktharahum","most of them","অধিকাংশই তাদের"],["يَجْهَلُونَ","yajhalūna","(are) ignorant","মূর্খতা করে"]],"t":"۞ وَلَوْ أَ<g>نَّ</>نَا نَزَّلْ<o>نَآ</> إِلَيْهِمُ <h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةَ وَكَلَّمَهُمُ <h>ٱ</>لْمَوْتَىٰ وَحَشَرْنَا عَلَيْهِمْ كُلَّ <k>شَىْءٍۢ قُ</>بُلًۭ<d>ا مَّ</>ا كَانُو<s>ا۟</> لِيُؤْمِ<o>نُوٓ</><s>ا۟</> إِ<o>لَّآ</> <d>أَن يَ</><o>شَآ</>ءَ <h>ٱ</>للَّهُ وَ<m>لَٰ</>كِ<g>نَّ</> أَكْثَرَهُمْ يَ<q>جْ</>هَ<p>لُو</>نَ"},{"n":112,"w":[["وَكَذَٰلِكَ","wakadhālika","And thus","এবং এভাবে"],["جَعَلْنَا","ja‘alnā","We made","আমরা বানিয়েছি"],["لِكُلِّ","likulli","for every","জন্যে প্রত্যেক"],["نَبِىٍّ","nabiyyin","Prophet","নাবীর"],["عَدُوًّۭا","‘aduwwan","an enemy ","শত্রু"],["شَيَـٰطِينَ","shayāṭīna","devils","শয়তানদেরকে"],["ٱلْإِنسِ","l-insi","(from) the mankind","(মধ্য হতে) মানুষের"],["وَٱلْجِنِّ","wal-jini","and the jinn","ও জিনদের"],["يُوحِى","yūḥī","inspiring","উস্কানি দিতে থাকে"],["بَعْضُهُمْ","ba‘ḍuhum","some of them","কিছু অংশ তাদের"],["إِلَىٰ","ilā","to","প্রতি"],["بَعْضٍۢ","ba‘ḍin","others","(অন্য) কিছু অংশের"],["زُخْرُفَ","zukh'rufa","(with) decorative","চাকচিক্য (দ্বারা)"],["ٱلْقَوْلِ","l-qawli","[the] speech","কথার"],["غُرُورًۭا ۚ","ghurūran","(in) deception","ধোঁকার (উদ্দেশ্যে)"],["وَلَوْ","walaw","But if","এবং যদি"],["شَآءَ","shāa","(had) willed","ইচ্ছে করতেন"],["رَبُّكَ","rabbuka","your Lord","তোমার রব"],["مَا","mā","not","না"],["فَعَلُوهُ ۖ","fa‘alūhu","they (would) have done it","তারা করতো তা"],["فَذَرْهُمْ","fadharhum","so leave them","অতএব ছেড়ে দাও তাদেরকে (তাদের অবস্থায়)"],["وَمَا","wamā","and what","এবং যা"],["يَفْتَرُونَ","yaftarūna","they invent","তারা রচনা করছে"]],"t":"وَكَ<m>ذَٰ</>لِكَ جَعَلْنَا لِكُلِّ نَبِىٍّ عَدُ<k>وًّۭا شَ</><m>يَٰ</>طِينَ <h>ٱ</>لْإِ<k>نسِ</> وَ<h>ٱ</>لْجِ<g>نِّ</> يُوحِى بَعْضُهُمْ إِلَىٰ بَعْ<k>ضٍۢ زُ</>خْرُفَ <h>ٱ</>لْقَوْلِ غُرُو<d>رًۭا ۚ وَ</>لَوْ <o>شَآ</>ءَ رَبُّكَ مَا فَعَلُوهُ ۖ فَذَرْهُمْ وَمَا يَفْتَ<p>رُو</>نَ"},{"n":113,"w":[["وَلِتَصْغَىٰٓ","walitaṣghā","And so that incline","এবং (তারা এজন্যে করে) যেন ঝুঁকে"],["إِلَيْهِ","ilayhi","to it","প্রতি তার (অর্থাৎ চাকচিক্যের)"],["أَفْـِٔدَةُ","afidatu","hearts","(তাদের) অন্তর"],["ٱلَّذِينَ","alladhīna","(of) those who","যারা"],["لَا","lā","(do) not","না"],["يُؤْمِنُونَ","yu'minūna","believe","ঈমান আনে"],["بِٱلْـَٔاخِرَةِ","bil-ākhirati","in the Hereafter","উপর আখিরাতের"],["وَلِيَرْضَوْهُ","waliyarḍawhu","and so that they may be pleased with it","এবং যেন তাতে তারা পরিতুষ্ট হয়"],["وَلِيَقْتَرِفُوا۟","waliyaqtarifū","and so that they may commit","এবং যেন তারা অপকর্ম করে"],["مَا","mā","what","যা"],["هُم","hum","they","তারা"],["مُّقْتَرِفُونَ","muq'tarifūna","(are) committing","অপকর্ম করছে"]],"t":"وَلِتَصْغَ<o>ىٰٓ</> إِلَيْهِ أَفْـِٔدَةُ <h>ٱ</>لَّذِينَ لَا يُؤْمِنُونَ بِ<h>ٱ</>لْءَاخِرَةِ وَلِيَرْضَوْهُ وَلِيَ<q>قْ</>تَرِفُو<s>ا۟</> مَا <y>هُم مُّ</><q>قْ</>تَرِ<p>فُو</>نَ"},{"n":114,"w":[["أَفَغَيْرَ","afaghayra","Then is (it) other than","\"কি তবে ছাড়া"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌"],["أَبْتَغِى","abtaghī","I seek","খোঁজ করবো আমি"],["حَكَمًۭا","ḥakaman","(as) judge","বিচারক (অন্য কাউকে)"],["وَهُوَ","wahuwa","while He","অথচ তিনিই"],["ٱلَّذِىٓ","alladhī","(is) the One Who","যিনি"],["أَنزَلَ","anzala","has revealed","অবতীর্ণ করেছেন"],["إِلَيْكُمُ","ilaykumu","to you","প্রতি তোমাদের"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","কিতাব"],["مُفَصَّلًۭا ۚ","mufaṣṣalan","explained in detail","বিস্তারিত\""],["وَٱلَّذِينَ","wa-alladhīna","And those (to) whom","এবং যাদেরকে (তোমার পূর্বে)"],["ءَاتَيْنَـٰهُمُ","ātaynāhumu","We gave them","আমরা দিয়েছি তাদের"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","কিতাব"],["يَعْلَمُونَ","ya‘lamūna","they know","তারা জানে"],["أَنَّهُۥ","annahu","that it","যে তা"],["مُنَزَّلٌۭ","munazzalun","(is) sent down","অবতীর্ণ হয়েছে"],["مِّن","min","from","পক্ষ হতে"],["رَّبِّكَ","rabbika","your Lord","তোমার রবের"],["بِٱلْحَقِّ ۖ","bil-ḥaqi","in truth","সহকারে সত্য"],["فَلَا","falā","so (do) not","অতএব না"],["تَكُونَنَّ","takūnanna","be","তুমি হয়ো"],["مِنَ","mina","among","অন্তর্ভুক্ত"],["ٱلْمُمْتَرِينَ","l-mum'tarīna","the ones who doubt","সন্দেহকারীদের"]],"t":"أَفَغَيْرَ <h>ٱ</>للَّهِ أَ<q>بْ</>تَغِى حَكَ<d>مًۭا وَ</>هُوَ <h>ٱ</>لَّ<o>ذِىٓ</> أَ<k>نزَ</>لَ إِلَيْكُمُ <h>ٱ</>لْكِ<m>تَٰ</>بَ مُفَصَّلًۭ<d>ا ۚ وَ</><h>ٱ</>لَّذِينَ ءَاتَيْ<m>نَٰ</>هُمُ <h>ٱ</>لْكِ<m>تَٰ</>بَ يَعْلَمُونَ أَ<g>نَّ</>هُ<m>ۥ</> مُنَزَّ<d>لٌۭ مِّ</><w>ن رَّ</>بِّكَ بِ<h>ٱ</>لْحَقِّ ۖ فَلَا تَكُونَ<g>نَّ</> مِنَ <h>ٱ</>لْمُمْتَ<p>رِي</>نَ"},{"n":115,"w":[["وَتَمَّتْ","watammat","And (has been) fulfilled","এবং পরিপূর্ণ হয়েছে"],["كَلِمَتُ","kalimatu","(the) word","কথাগুলো"],["رَبِّكَ","rabbika","(of) your Lord","তোমার রবের"],["صِدْقًۭا","ṣid'qan","(in) truth","সত্যতায়"],["وَعَدْلًۭا ۚ","wa‘adlan","and justice","ও ন্যায়পরায়ণতায়"],["لَّا","lā","No","নেই"],["مُبَدِّلَ","mubaddila","one can change","কোনো পরিবর্তনকারী"],["لِكَلِمَـٰتِهِۦ ۚ","likalimātihi","His words","কথাগুলোকে তাঁর"],["وَهُوَ","wahuwa","and He","এবং তিনি"],["ٱلسَّمِيعُ","l-samī‘u","(is) the All-Hearer","সবকিছুই শুনেন"],["ٱلْعَلِيمُ","l-‘alīmu","the All-Knower","সবকিছুই জানেন"]],"t":"وَتَ<g>مَّ</>تْ كَلِمَتُ رَبِّكَ صِ<q>دْ</><d>قًۭا وَ</>عَ<q>دْ</>لًۭ<w>ا ۚ لَّ</>ا مُبَدِّلَ لِكَلِ<m>مَٰتِهِۦ</> ۚ وَهُوَ <h>ٱ</><l>ل</>سَّمِيعُ <h>ٱ</>لْعَ<p>لِي</>مُ"},{"n":116,"w":[["وَإِن","wa-in","And if","এবং যদি"],["تُطِعْ","tuṭi‘","you obey","অনুসরণ করো"],["أَكْثَرَ","akthara","most","অধিকাংশের"],["مَن","man","of","যারা"],["فِى","fī","(those) in","মধ্যে (আছে)"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["يُضِلُّوكَ","yuḍillūka","they will mislead you","তারা তোমাকে পথভ্রষ্ট করবে"],["عَن","‘an","from","হতে"],["سَبِيلِ","sabīli","(the) way","পথ"],["ٱللَّهِ ۚ","l-lahi","(of) Allah","আল্লাহ্‌র"],["إِن","in","Not","না"],["يَتَّبِعُونَ","yattabi‘ūna","they follow","তারা অনুসরণ করে"],["إِلَّا","illā","except","এ ছাড়া"],["ٱلظَّنَّ","l-ẓana","[the] assumption","অনুমানের"],["وَإِنْ","wa-in","and not","এবং না"],["هُمْ","hum","they (do)","তারা"],["إِلَّا","illā","except","এ ছাড়া"],["يَخْرُصُونَ","yakhruṣūna","guess","অনুমান করে"]],"t":"وَإِ<k>ن تُ</>طِعْ أَكْثَرَ مَ<k>ن فِ</>ى <h>ٱ</>لْأَرْضِ يُضِلُّوكَ عَ<k>ن سَ</>بِيلِ <h>ٱ</>للَّهِ ۚ <d>إِن يَ</>تَّبِعُونَ إِلَّا <h>ٱ</><l>ل</>ظَّ<g>نَّ</> وَإِنْ هُمْ إِلَّا يَخْرُ<p>صُو</>نَ"},{"n":117,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["رَبَّكَ","rabbaka","your Lord","তোমার রব"],["هُوَ","huwa","He","তিনি"],["أَعْلَمُ","a‘lamu","knows best","খুব জ্ঞাত"],["مَن","man","who","কে"],["يَضِلُّ","yaḍillu","strays","ভ্রষ্ট হয়েছে"],["عَن","‘an","from","হতে"],["سَبِيلِهِۦ ۖ","sabīlihi","His way","পথ তাঁর"],["وَهُوَ","wahuwa","and He","এবং তিনি"],["أَعْلَمُ","a‘lamu","(is) most knowing","খুব জ্ঞাত"],["بِٱلْمُهْتَدِينَ","bil-muh'tadīna","of the guided-ones","সম্পর্কে সঠিক পথ প্রাপ্তদের"]],"t":"إِ<g>نَّ</> رَبَّكَ هُوَ أَعْلَمُ <d>مَن يَ</>ضِلُّ عَ<k>ن سَ</>بِيلِ<m>هِۦ</> ۖ وَهُوَ أَعْلَمُ بِ<h>ٱ</>لْمُهْتَ<p>دِي</>نَ"},{"n":118,"w":[["فَكُلُوا۟","fakulū","So eat","অতএব তোমরা খাও"],["مِمَّا","mimmā","of what","তা হতে (যার উপর)"],["ذُكِرَ","dhukira","(is) mentioned","নেয়া হয়েছে"],["ٱسْمُ","us'mu","(the) name","নাম"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহ্‌র"],["عَلَيْهِ","‘alayhi","on it","উপর তার"],["إِن","in","if","যদি"],["كُنتُم","kuntum","you are","হও তোমরা"],["بِـَٔايَـٰتِهِۦ","biāyātihi","in His Verses ","প্রতি আয়াতসমূহের তাঁর"],["مُؤْمِنِينَ","mu'minīna","believers","বিশ্বাসী"]],"t":"فَكُلُو<s>ا۟</> مِ<g>مَّ</>ا ذُكِرَ <h>ٱ</>سْمُ <h>ٱ</>للَّهِ عَلَيْهِ إِ<k>ن كُنتُ</><f>م بِـَٔ</>ا<m>يَٰتِهِۦ</> مُؤْمِ<p>نِي</>نَ"},{"n":119,"w":[["وَمَا","wamā","And what","এবং কি হয়েছে"],["لَكُمْ","lakum","for you","তোমাদের"],["أَلَّا","allā","that not","যে না"],["تَأْكُلُوا۟","takulū","you eat","তোমরা খাও"],["مِمَّا","mimmā","of what","তা হতে (যার উপর)"],["ذُكِرَ","dhukira","has been mentioned","হয়েছে নেয়া"],["ٱسْمُ","us'mu","(the) name","নাম"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহ্‌র"],["عَلَيْهِ","‘alayhi","on it","উপর তার"],["وَقَدْ","waqad","when indeed","অথচ নিশ্চয়ই"],["فَصَّلَ","faṣṣala","He (has) explained in detail","তিনি বিস্তারিত বিবৃত করেছেন"],["لَكُم","lakum","to you","জন্যে তোমাদের"],["مَّا","mā","what","যা"],["حَرَّمَ","ḥarrama","He (has) forbidden","নিষিদ্ধ করেছেন (আল্লাহ্‌)"],["عَلَيْكُمْ","‘alaykum","to you","উপর তোমাদের"],["إِلَّا","illā","except","তবে"],["مَا","mā","what","যা"],["ٱضْطُرِرْتُمْ","uḍ'ṭurir'tum","you are compelled","নিরুপায় হয়ে যাও তোমরা"],["إِلَيْهِ ۗ","ilayhi","to it","দিকে তার (সেটা ভিন্ন কথা)"],["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["كَثِيرًۭا","kathīran","many","অনেকে"],["لَّيُضِلُّونَ","layuḍillūna","surely lead astray","অবশ্যই পথভ্রষ্ট করে(অন্যকে)"],["بِأَهْوَآئِهِم","bi-ahwāihim","by their (vain) desires","তাদের খেয়াল খুশী দ্বারা"],["بِغَيْرِ","bighayri","without","ছাড়া"],["عِلْمٍ ۗ","‘il'min","knowledge","কোনো জ্ঞান (অর্থাৎ অজ্ঞতাবশত)"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["رَبَّكَ","rabbaka","your Lord","তোমার রব"],["هُوَ","huwa","He","তিনি"],["أَعْلَمُ","a‘lamu","(is) most knowing","খুব জানেন"],["بِٱلْمُعْتَدِينَ","bil-mu‘'tadīna","of the transgressors","সম্পর্কে সীমালঙ্ঘনকারীদের"]],"t":"وَمَا لَكُمْ أَلَّا تَأْكُلُو<s>ا۟</> مِ<g>مَّ</>ا ذُكِرَ <h>ٱ</>سْمُ <h>ٱ</>للَّهِ عَلَيْهِ وَقَ<q>دْ</> فَصَّلَ لَ<y>كُم مَّ</>ا حَرَّمَ عَلَيْكُمْ إِلَّا مَا <h>ٱ</>ضْطُرِرْتُمْ إِلَيْهِ ۗ وَإِ<g>نَّ</> كَثِي<w>رًۭا لَّ</>يُضِلُّونَ بِأَهْ<o>وَآ</>ئِ<f>هِم بِ</>غَيْرِ عِلْمٍ ۗ إِ<g>نَّ</> رَبَّكَ هُوَ أَعْلَمُ بِ<h>ٱ</>لْمُعْتَ<p>دِي</>نَ"},{"n":120,"w":[["وَذَرُوا۟","wadharū","Forsake","এবং তোমরা বর্জন করো"],["ظَـٰهِرَ","ẓāhira","open","প্রকাশ্য"],["ٱلْإِثْمِ","l-ith'mi","[the] sins","পাপের কাজ"],["وَبَاطِنَهُۥٓ ۚ","wabāṭinahu","and the secret","এবং গোপন তার(কাজও)"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["يَكْسِبُونَ","yaksibūna","earn","উপার্জন করে"],["ٱلْإِثْمَ","l-ith'ma","[the] sin","পাপ"],["سَيُجْزَوْنَ","sayuj'zawna","they will be recompensed","অচিরেই তাদের প্রতিদান দেয়া হবে"],["بِمَا","bimā","for what","বিনিময়ে যা"],["كَانُوا۟","kānū","they used to","তারা ছিলো"],["يَقْتَرِفُونَ","yaqtarifūna","commit","তারা কুকর্ম করতে"]],"t":"وَذَرُو<s>ا۟</> <m>ظَٰ</>هِرَ <h>ٱ</>لْإِثْمِ وَبَاطِنَهُ<o>ۥٓ ۚ</> إِ<g>نَّ</> <h>ٱ</>لَّذِينَ يَكْسِبُونَ <h>ٱ</>لْإِثْمَ سَيُ<q>جْ</>زَوْنَ بِمَا كَانُو<s>ا۟</> يَ<q>قْ</>تَرِ<p>فُو</>نَ"},{"n":121,"w":[["وَلَا","walā","And (do) not","এবং না"],["تَأْكُلُوا۟","takulū","eat","তোমরা খেয়ো"],["مِمَّا","mimmā","of that","তা হতে (যার উপর)"],["لَمْ","lam","not","নি"],["يُذْكَرِ","yudh'kari","has been mentioned","নেয়া হয়"],["ٱسْمُ","us'mu","(the) name","নাম"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহ্‌র"],["عَلَيْهِ","‘alayhi","on it","উপর তার"],["وَإِنَّهُۥ","wa-innahu","and indeed, it (is)","এবং নিশ্চয়ই তা"],["لَفِسْقٌۭ ۗ","lafis'qun","grave disobedience","অবশ্যই পাপ"],["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["ٱلشَّيَـٰطِينَ","l-shayāṭīna","the devils","শয়তানরা"],["لَيُوحُونَ","layūḥūna","inspire","অবশ্যই উস্কানি দেয়"],["إِلَىٰٓ","ilā","to","প্রতি"],["أَوْلِيَآئِهِمْ","awliyāihim","their friends","তাদের বন্ধুদের"],["لِيُجَـٰدِلُوكُمْ ۖ","liyujādilūkum","so that they dispute with you","যেন তারা ঝগড়া করে তোমাদের (সাথে)"],["وَإِنْ","wa-in","and if","এবং যদি"],["أَطَعْتُمُوهُمْ","aṭa‘tumūhum","you obey them","তোমরা আনুগত্য করো তাদের"],["إِنَّكُمْ","innakum","indeed, you","(তবে)তোমরাও নিশ্চয়ই"],["لَمُشْرِكُونَ","lamush'rikūna","(would) be the polytheists","অবশ্যই মুশরিক"]],"t":"وَلَا تَأْكُلُو<s>ا۟</> مِ<g>مَّ</>ا لَمْ يُذْكَرِ <h>ٱ</>سْمُ <h>ٱ</>للَّهِ عَلَيْهِ وَإِ<g>نَّ</>هُ<m>ۥ</> لَفِسْ<d>قٌۭ ۗ وَ</>إِ<g>نَّ</> <h>ٱ</><l>ل</>شَّ<m>يَٰ</>طِينَ لَيُوحُونَ إِلَ<o>ىٰٓ</> أَوْلِ<o>يَآ</>ئِهِمْ لِيُ<m>جَٰ</>دِلُوكُمْ ۖ وَإِنْ أَطَعْتُمُوهُمْ إِ<g>نَّ</>كُمْ لَمُشْرِ<p>كُو</>نَ"},{"n":122,"w":[["أَوَمَن","awaman","Is (one) who","কি যে"],["كَانَ","kāna","was","ছিলো"],["مَيْتًۭا","maytan","dead","মৃত"],["فَأَحْيَيْنَـٰهُ","fa-aḥyaynāhu","and We gave him life","অতঃপর আমরা জীবিত করেছি তাকে"],["وَجَعَلْنَا","waja‘alnā","and We made","এবং আমরা দিয়েছি"],["لَهُۥ","lahu","for him","জন্যে তার"],["نُورًۭا","nūran","light","আলো"],["يَمْشِى","yamshī","he walks","সে চলে"],["بِهِۦ","bihi","whereby","দিয়ে তা"],["فِى","fī","among","মধ্যে"],["ٱلنَّاسِ","l-nāsi","the people","মানুষের"],["كَمَن","kaman","like (one) who","মতো সেই ব্যক্তির"],["مَّثَلُهُۥ","mathaluhu","[similar to him]","উদাহরণ যার"],["فِى","fī","(is) in","মধ্যে (আছে)"],["ٱلظُّلُمَـٰتِ","l-ẓulumāti","the darknesses","অন্ধকারসমূহের"],["لَيْسَ","laysa","not","নয়"],["بِخَارِجٍۢ","bikhārijin","he comes out","সে বের হবার"],["مِّنْهَا ۚ","min'hā","of it","থেকে তা"],["كَذَٰلِكَ","kadhālika","Thus","এভাবে"],["زُيِّنَ","zuyyina","is made fair-seeming","শোভন করা হয়েছে"],["لِلْكَـٰفِرِينَ","lil'kāfirīna","to the disbelievers","কাছে কাফিরদের"],["مَا","mā","what","যা"],["كَانُوا۟","kānū","they were","তারা ছিলো"],["يَعْمَلُونَ","ya‘malūna","doing","তারা কাজ করতে"]],"t":"أَوَمَ<k>ن كَ</>انَ مَيْ<k>تًۭا فَ</>أَحْيَيْ<m>نَٰ</>هُ وَجَعَلْنَا لَهُ<m>ۥ</> نُو<d>رًۭا يَ</>مْشِى بِ<m>هِۦ</> فِى <h>ٱ</><l>ل</><g>نَّ</>اسِ كَ<d>مَن مَّ</>ثَلُهُ<m>ۥ</> فِى <h>ٱ</><l>ل</>ظُّلُ<m>مَٰ</>تِ لَيْسَ بِخَارِ<d>جٍۢ مِّ</>نْهَا ۚ كَ<m>ذَٰ</>لِكَ زُيِّنَ لِلْ<m>كَٰ</>فِرِينَ مَا كَانُو<s>ا۟</> يَعْمَ<p>لُو</>نَ"},{"n":123,"w":[["وَكَذَٰلِكَ","wakadhālika","And thus","এবং এভাবে"],["جَعَلْنَا","ja‘alnā","We placed","আমরা নিযুক্ত করেছি"],["فِى","fī","in","মধ্যে"],["كُلِّ","kulli","every","প্রত্যেক"],["قَرْيَةٍ","qaryatin","city","জনপদের"],["أَكَـٰبِرَ","akābira","greatest","বড় বড়"],["مُجْرِمِيهَا","muj'rimīhā","(of) its criminals","অপরাধীদেরকে তার"],["لِيَمْكُرُوا۟","liyamkurū","so that they plot","যেন তারা চক্রান্ত করে"],["فِيهَا ۖ","fīhā","therein","মধ্যে তার"],["وَمَا","wamā","And not","কিন্তু না"],["يَمْكُرُونَ","yamkurūna","they plot","তারা চক্রান্ত করে"],["إِلَّا","illā","except","এ ছাড়া"],["بِأَنفُسِهِمْ","bi-anfusihim","against themselves","সাথে  নিজেদের তাদের"],["وَمَا","wamā","and not","অথচ না"],["يَشْعُرُونَ","yash‘urūna","they perceive","তারা অনুভব করে"]],"t":"وَكَ<m>ذَٰ</>لِكَ جَعَلْنَا فِى كُلِّ قَرْيَةٍ أَ<m>كَٰ</>بِرَ مُ<q>جْ</>رِمِيهَا لِيَمْكُرُو<s>ا۟</> فِيهَا ۖ وَمَا يَمْكُرُونَ إِلَّا بِأَ<k>نفُ</>سِهِمْ وَمَا يَشْعُ<p>رُو</>نَ"},{"n":124,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["جَآءَتْهُمْ","jāathum","comes to them","কাছে আসে তাদের"],["ءَايَةٌۭ","āyatun","a Sign","কোনো নিদর্শন"],["قَالُوا۟","qālū","they say","তারা বলে"],["لَن","lan","Never","\"কখনও না"],["نُّؤْمِنَ","nu'mina","we will believe","ঈমান আনবো আমরা"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["نُؤْتَىٰ","nu'tā","we are given","দেয়া হবে আমাদেরকেও"],["مِثْلَ","mith'la","like","তেমনই"],["مَآ","mā","what","যা কিছু"],["أُوتِىَ","ūtiya","was given","দেয়া হয়েছে"],["رُسُلُ","rusulu","(to the) Messengers","রাসূলদেরকে"],["ٱللَّهِ ۘ","l-lahi","(of) Allah","আল্লাহ্‌র\""],["ٱللَّهُ","l-lahu","Allah","আল্লাহ্‌ই"],["أَعْلَمُ","a‘lamu","knows best","খুব জানেন"],["حَيْثُ","ḥaythu","where","যেখানে"],["يَجْعَلُ","yaj‘alu","He places","অর্পণ করবেন"],["رِسَالَتَهُۥ ۗ","risālatahu","His Message","রিসালাতের তাঁর (দায়িত্বভার)"],["سَيُصِيبُ","sayuṣību","Will afflict","শীঘ্রই পৌঁছবে"],["ٱلَّذِينَ","alladhīna","those who","(তাদের উপর) যারা"],["أَجْرَمُوا۟","ajramū","committed crimes","অপরাধ করেছে"],["صَغَارٌ","ṣaghārun","a humiliation","অপমান"],["عِندَ","‘inda","from","নিকট (হতে)"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌র"],["وَعَذَابٌۭ","wa‘adhābun","and a punishment","ও শাস্তি"],["شَدِيدٌۢ","shadīdun","severe","কঠিন"],["بِمَا","bimā","for what","এ কারণে যা"],["كَانُوا۟","kānū","they used to","তারা ছিলো"],["يَمْكُرُونَ","yamkurūna","plot","তারা চক্রান্ত করতে"]],"t":"وَإِذَا <o>جَآ</>ءَتْهُمْ ءَايَ<k>ةٌۭ قَ</>الُو<s>ا۟</> <d>لَن نُّ</>ؤْمِنَ حَتَّىٰ نُؤْتَىٰ مِثْلَ <o>مَآ</> أُوتِىَ رُسُلُ <h>ٱ</>للَّهِ ۘ <h>ٱ</>للَّهُ أَعْلَمُ حَيْثُ يَ<q>جْ</>عَلُ رِسَالَتَهُ<m>ۥ</> ۗ سَيُصِيبُ <h>ٱ</>لَّذِينَ أَ<q>جْ</>رَمُو<s>ا۟</> صَغَارٌ عِ<k>ندَ</> <h>ٱ</>للَّهِ وَعَذَا<k>بٌۭ شَ</>دِي<i>دٌۢ بِ</>مَا كَانُو<s>ا۟</> يَمْكُ<p>رُو</>نَ"},{"n":125,"w":[["فَمَن","faman","So whoever","অতএব যাকে"],["يُرِدِ","yuridi","wants","চান"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ্‌"],["أَن","an","that","যে"],["يَهْدِيَهُۥ","yahdiyahu","He guides him ","সৎপথে পরিচালিত করবেন তাকে"],["يَشْرَحْ","yashraḥ","He expands","প্রশস্ত করে দেন"],["صَدْرَهُۥ","ṣadrahu","his breast","হৃদয়কে তার"],["لِلْإِسْلَـٰمِ ۖ","lil'is'lāmi","to Islam","জন্যে ইসলামের"],["وَمَن","waman","and whoever","এবং যাকে"],["يُرِدْ","yurid","He wants","চান"],["أَن","an","that","যে"],["يُضِلَّهُۥ","yuḍillahu","He lets him go astray","বিপথগামী করবেন তাকে"],["يَجْعَلْ","yaj‘al","He makes","করেছেন"],["صَدْرَهُۥ","ṣadrahu","his breast","হৃদয়কে তার"],["ضَيِّقًا","ḍayyiqan","tight","ইসলামের অনুসরণে"],["حَرَجًۭا","ḥarajan","and constricted","অতিশয় সংকীর্ণ"],["كَأَنَّمَا","ka-annamā","as though","যেন (তার মনে হবে)"],["يَصَّعَّدُ","yaṣṣa‘‘adu","he (were) climbing","সে আরোহণ করছে"],["فِى","fī","into","মধ্যে"],["ٱلسَّمَآءِ ۚ","l-samāi","the sky","আকাশের"],["كَذَٰلِكَ","kadhālika","Thus","এভাবে"],["يَجْعَلُ","yaj‘alu","places","রাখেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ্‌"],["ٱلرِّجْسَ","l-rij'sa","the filth","অপবিত্রতা"],["عَلَى","‘alā","on","উপর"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["لَا","lā","(do) not","না"],["يُؤْمِنُونَ","yu'minūna","believe","ঈমান আনে"]],"t":"فَ<d>مَن يُ</>رِدِ <h>ٱ</>للَّهُ <d>أَن يَ</>هْدِيَهُ<m>ۥ</> يَشْرَحْ صَ<q>دْ</>رَهُ<m>ۥ</> لِلْإِسْ<m>لَٰ</>مِ ۖ وَ<d>مَن يُ</>رِ<q>دْ</> <d>أَن يُ</>ضِلَّهُ<m>ۥ</> يَ<q>جْ</>عَلْ صَ<q>دْ</>رَهُ<m>ۥ</> ضَيِّقًا حَرَ<k>جًۭا كَ</>أَ<g>نَّ</>مَا يَصَّعَّدُ فِى <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ ۚ كَ<m>ذَٰ</>لِكَ يَ<q>جْ</>عَلُ <h>ٱ</>للَّهُ <h>ٱ</><l>ل</>رِّ<q>جْ</>سَ عَلَى <h>ٱ</>لَّذِينَ لَا يُؤْمِ<p>نُو</>نَ"},{"n":126,"w":[["وَهَـٰذَا","wahādhā","And this","এবং এই"],["صِرَٰطُ","ṣirāṭu","(is the) way","পথ"],["رَبِّكَ","rabbika","(of) your Lord ","তোমার রবের"],["مُسْتَقِيمًۭا ۗ","mus'taqīman","straight","সরল-সঠিক (পথ)"],["قَدْ","qad","Certainly","নিশ্চয়ই"],["فَصَّلْنَا","faṣṣalnā","We have detailed","বিশদ বর্ণনা করেছি আমরা"],["ٱلْـَٔايَـٰتِ","l-āyāti","the Verses","নিদর্শনগুলোকে"],["لِقَوْمٍۢ","liqawmin","for a people","জন্যে সম্প্রদায়ের"],["يَذَّكَّرُونَ","yadhakkarūna","who take heed","(যারা) উপদেশ গ্রহণ করে"]],"t":"وَ<m>هَٰ</>ذَا صِ<m>رَٰ</>طُ رَبِّكَ مُسْتَقِي<k>مًۭا ۗ قَ</><q>دْ</> فَصَّلْنَا <h>ٱ</>لْءَا<m>يَٰ</>تِ لِقَوْ<d>مٍۢ يَ</>ذَّكَّ<p>رُو</>نَ"},{"n":127,"w":[["۞ لَهُمْ","lahum","For them","জন্যে তাদের (রয়েছে)"],["دَارُ","dāru","(will be) home","ঘর"],["ٱلسَّلَـٰمِ","l-salāmi","(of) [the] peace","শান্তির"],["عِندَ","‘inda","with","নিকট"],["رَبِّهِمْ ۖ","rabbihim","their Lord","রবের তাদের"],["وَهُوَ","wahuwa","And He","এবং তিনি"],["وَلِيُّهُم","waliyyuhum","(will be) their protecting friend","অভিভাবক তাদের"],["بِمَا","bimā","because","এ কারণে যা"],["كَانُوا۟","kānū","(of what) they used to","তারা ছিলো"],["يَعْمَلُونَ","ya‘malūna","do","তারা কাজ করতে"]],"t":"۞ لَهُمْ دَارُ <h>ٱ</><l>ل</>سَّ<m>لَٰ</>مِ عِ<k>ندَ</> رَبِّهِمْ ۖ وَهُوَ وَلِيُّ<f>هُم بِ</>مَا كَانُو<s>ا۟</> يَعْمَ<p>لُو</>نَ"},{"n":128,"w":[["وَيَوْمَ","wayawma","And (the) Day","এবং যেদিন"],["يَحْشُرُهُمْ","yaḥshuruhum","He will gather them","একত্র করবেন তাদের (আল্লাহ্‌)"],["جَمِيعًۭا","jamī‘an","all","সকলকে (এবং বলবেন)"],["يَـٰمَعْشَرَ","yāma‘shara","(and will say), \"O assembly","হে সম্প্রদায়"],["ٱلْجِنِّ","l-jini","(of) [the] jinn","জিনদের"],["قَدِ","qadi","Certainly","নিশ্চয়ই"],["ٱسْ