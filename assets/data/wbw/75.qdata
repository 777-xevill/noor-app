{"n":75,"a":[{"n":1,"w":[["لَآ","lā","Nay","না"],["أُقْسِمُ","uq'simu","I swear","কসম খাচ্ছি"],["بِيَوْمِ","biyawmi","by (the) Day","দিনের"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) the Resurrection","কিয়ামাতের"]],"t":"<o>لَآ</> أُ<q>قْ</>سِمُ بِيَوْمِ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ"},{"n":2,"w":[["وَلَآ","walā","And nay","এবং না"],["أُقْسِمُ","uq'simu","I swear","শপথ করছি আমি"],["بِٱلنَّفْسِ","bil-nafsi","by the soul","মনের"],["ٱللَّوَّامَةِ","l-lawāmati","self-accusing","তিরস্কারকারী"]],"t":"وَ<o>لَآ</> أُ<q>قْ</>سِمُ بِ<h>ٱ</><l>ل</><g>نَّ</>فْسِ <h>ٱ</><l>ل</>لَّوَّامَةِ"},{"n":3,"w":[["أَيَحْسَبُ","ayaḥsabu","Does think","মনে করেছে কি"],["ٱلْإِنسَـٰنُ","l-insānu","[the] man","মানুষ"],["أَلَّن","allan","that not","কখন না"],["نَّجْمَعَ","najma‘a","We will assemble","একত্রিত আমরা করব"],["عِظَامَهُۥ","‘iẓāmahu","his bones","তার অস্তিগুলকে"]],"t":"أَيَحْسَبُ <h>ٱ</>لْإِ<k>نسَٰ</>نُ أَ<d>لَّن نَّ</><q>جْ</>مَعَ عِظَامَهُۥ"},{"n":4,"w":[["بَلَىٰ","balā","Nay","কােনো না"],["قَـٰدِرِينَ","qādirīna","(We are) Able","সক্ষম"],["عَلَىٰٓ","‘alā","on","এতে"],["أَن","an","that","যে"],["نُّسَوِّىَ","nusawwiya","We can restore","পূর্ণবিন্যস্ত আমরা করবো"],["بَنَانَهُۥ","banānahu","his fingertips","তার আঙ্গুলির অগ্রভাগ"]],"t":"بَلَىٰ <m>قَٰ</>دِرِينَ عَلَ<o>ىٰٓ</> <d>أَن نُّ</>سَوِّىَ بَنَانَهُۥ"},{"n":5,"w":[["بَلْ","bal","Nay","বরং"],["يُرِيدُ","yurīdu","Desires","চায়ে"],["ٱلْإِنسَـٰنُ","l-insānu","[the] man","মানুষ"],["لِيَفْجُرَ","liyafjura","to give (the) lie","কুকর্ম করার জন্য"],["أَمَامَهُۥ","amāmahu","(to) what is before him","তার ভবিষ্যতেও"]],"t":"بَلْ يُرِيدُ <h>ٱ</>لْإِ<k>نسَٰ</>نُ لِيَفْجُرَ أَمَامَهُۥ"},{"n":6,"w":[["يَسْـَٔلُ","yasalu","He asks","সে জিজ্ঞাস করে"],["أَيَّانَ","ayyāna","When","\"কবে"],["يَوْمُ","yawmu","(is the) Day","দিন"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) the Resurrection","কিয়ামাতের\""]],"t":"يَسْـَٔلُ أَيَّانَ يَوْمُ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ"},{"n":7,"w":[["فَإِذَا","fa-idhā","So when","যখন অতঃপর"],["بَرِقَ","bariqa","is dazzled","স্থির হয়ে যাবে"],["ٱلْ