{"n":65,"a":[{"n":1,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O","হে"],["ٱلنَّبِىُّ","l-nabiyu","Prophet","নবী"],["إِذَا","idhā","When","যখন"],["طَلَّقْتُمُ","ṭallaqtumu","you divorce","তোমরা তালাক দাও"],["ٱلنِّسَآءَ","l-nisāa","[the] women","স্ত্রীদের"],["فَطَلِّقُوهُنَّ","faṭalliqūhunna","then divorce them","অতঃপর তাদের তোমরা তালাক দাও"],["لِعِدَّتِهِنَّ","li‘iddatihinna","for their waiting period","তাদের ইদ্দতের জন্য"],["وَأَحْصُوا۟","wa-aḥṣū","and keep count","ও তোমরা গণনা কর"],["ٱلْعِدَّةَ ۖ","l-‘idata","(of) the waiting period","ইদ্দত"],["وَٱتَّقُوا۟","wa-ittaqū","and fear","এবং তোমরা ভয় কর"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["رَبَّكُمْ ۖ","rabbakum","your Lord","তোমাদের রব"],["لَا","lā","(Do) not","না"],["تُخْرِجُوهُنَّ","tukh'rijūhunna","expel them","তাদের তোমরা বের করো"],["مِنۢ","min","from","থেকে"],["بُيُوتِهِنَّ","buyūtihinna","their houses","তাদের ঘরগুলো"],["وَلَا","walā","and not","এবং না"],["يَخْرُجْنَ","yakhruj'na","they should leave","তারা বের হবে"],["إِلَّآ","illā","except","তবে"],["أَن","an","that","যদি"],["يَأْتِينَ","yatīna","they commit","তারা লিপ্ত হয়"],["بِفَـٰحِشَةٍۢ","bifāḥishatin","an immorality","অশ্লীলতায়"],["مُّبَيِّنَةٍۢ ۚ","mubayyinatin","clear","সুস্পষ্ট (অন্য কথা)"],["وَتِلْكَ","watil'ka","And these","ও এসব"],["حُدُودُ","ḥudūdu","(are the) limits","সীমাসমূহ"],["ٱللَّهِ ۚ","l-lahi","(of) Allah","আল্লাহর"],["وَمَن","waman","And whoever","এবং যে"],["يَتَعَدَّ","yata‘adda","transgresses","লংঘন করে"],["حُدُودَ","ḥudūda","(the) limits","সীমানাসমূহ"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["فَقَدْ","faqad","then certainly","নিশ্চয় অতঃপর"],["ظَلَمَ","ẓalama","he has wronged","যুলম করে"],["نَفْسَهُۥ ۚ","nafsahu","himself","তার নিজের (উপর)"],["لَا","lā","Not","না"],["تَدْرِى","tadrī","you know","তুমি জান"],["لَعَلَّ","la‘alla","Perhaps","সম্ভবতঃ"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يُحْدِثُ","yuḥ'dithu","will bring about","সৃষ্টি করবেন"],["بَعْدَ","ba‘da","after","পর"],["ذَٰلِكَ","dhālika","that","এর"],["أَمْرًۭا","amran","a matter","(কোন) অবস্থা"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</><l>ل</><g>نَّ</>بِىُّ إِذَا طَلَّ<q>قْ</>تُمُ <h>ٱ</><l>ل</><g>نِّ</><o>سَآ</>ءَ فَطَلِّقُوهُ<g>نَّ</> لِعِدَّتِهِ<g>نَّ</> وَأَحْصُو<s>ا۟</> <h>ٱ</>لْعِدَّةَ ۖ وَ<h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</>للَّهَ رَبَّكُمْ ۖ لَا تُخْرِجُوهُ<g>نَّ</> <i>مِنۢ بُ</>يُوتِهِ<g>نَّ</> وَلَا يَخْرُ<q>جْ</>نَ إِ<o>لَّآ</> <d>أَن يَ</>أْتِينَ بِ<m>فَٰ</>حِشَ<d>ةٍۢ مُّ</>بَيِّنَ<d>ةٍۢ ۚ وَ</>تِلْكَ حُدُودُ <h>ٱ</>للَّهِ ۚ وَ<d>مَن يَ</>تَعَدَّ حُدُودَ <h>ٱ</>للَّهِ فَقَ<q>دْ</> ظَلَمَ نَفْسَهُ<m>ۥ</> ۚ لَا تَ<q>دْ</>رِى لَعَلَّ <h>ٱ</>للَّهَ يُحْدِثُ بَعْدَ <m>ذَٰ</>لِكَ أَمْرًۭا"},{"n":2,"w":[["فَإِذَا","fa-idhā","Then when","যখন অতঃপর"],["بَلَغْنَ","balaghna","they have reached","তারা পৌঁছে"],["أَجَلَهُنَّ","ajalahunna","their term","তাদের সময়কালে"],["فَأَمْسِكُوهُنَّ","fa-amsikūhunna","then retain them","তাদের রাখতে তখন তোমরা"],["بِمَعْرُوفٍ","bima‘rūfin","with kindness","যথাবিধি"],["أَوْ","aw","or","বা"],["فَارِقُوهُنَّ","fāriqūhunna","part with them","তাদের তোমরা পৃথক করবে"],["بِمَعْرُوفٍۢ","bima‘rūfin","with kindness","যথাবিধি"],["وَأَشْهِدُوا۟","wa-ashhidū","And take witness","ও তোমরা সাক্ষী রাখ"],["ذَوَىْ","dhaway","two men","আছে"],["عَدْلٍۢ","‘adlin","just","ন্যায়পরায়ণ দু'জন"],["مِّنكُمْ","minkum","among you","তোমাদের মধ্য থেকে"],["وَأَقِيمُوا۟","wa-aqīmū","and establish","ও তোমরা সঠিক দিও"],["ٱلشَّهَـٰدَةَ","l-shahādata","the testimony","সাক্ষী"],["لِلَّهِ ۚ","lillahi","for Allah","আল্লাহর জন্যে"],["ذَٰلِكُمْ","dhālikum","That","এসব"],["يُوعَظُ","yū‘aẓu","is instructed","নসিহত করা হচ্ছে"],["بِهِۦ","bihi","with it","এ দিয়ে"],["مَن","man","whoever","যে"],["كَانَ","kāna","[is]","ছিল"],["يُؤْمِنُ","yu'minu","believes","বিশ্বাস করে"],["بِٱللَّهِ","bil-lahi","in Allah","আল্লাহর উপর"],["وَٱلْيَوْمِ","wal-yawmi","and the Day","ও দিনের"],["ٱلْـَٔاخِرِ ۚ","l-ākhiri","the Last","শেষ"],["وَمَن","waman","And whoever","এবং যে"],["يَتَّقِ","yattaqi","fears","ভয় করে"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["يَجْعَل","yaj‘al","He will make","তিনি করে দেন"],["لَّهُۥ","lahu","for him","তার জন্যে"],["مَخْرَجًۭا","makhrajan","a way out","নিস্কৃতির পথ"]],"t":"فَإِذَا بَلَغْنَ أَجَلَهُ<g>نَّ</> فَأَمْسِكُوهُ<g>نَّ</> بِمَعْرُوفٍ أَوْ فَارِقُوهُ<g>نَّ</> بِمَعْرُو<d>فٍۢ وَ</>أَشْهِدُو<s>ا۟</> ذَوَىْ عَ<q>دْ</><d>لٍۢ مِّ</><k>نكُ</>مْ وَأَقِيمُو<s>ا۟</> <h>ٱ</><l>ل</>شَّ<m>هَٰ</>دَةَ لِلَّهِ ۚ <m>ذَٰ</>لِكُمْ يُوعَظُ بِ<m>هِۦ</> مَ<k>ن كَ</>انَ يُؤْمِنُ بِ<h>ٱ</>للَّهِ وَ<h>ٱ</>لْيَوْمِ <h>ٱ</>لْءَاخِرِ ۚ وَ<d>مَن يَ</>تَّقِ <h>ٱ</>للَّهَ يَ<q>جْ</>عَل لَّهُ<m>ۥ</> مَخْرَجًۭا"},{"n":3,"w":[["وَيَرْزُقْهُ","wayarzuq'hu","And He will provide for him","ও তাকে রিজিক দেন"],["مِنْ","min","from","থেকে"],["حَيْثُ","ḥaythu","where","যেখান"],["لَا","lā","not","না"],["يَحْتَسِبُ ۚ","yaḥtasibu","he thinks","সে ধারণাও করে"],["وَمَن","waman","And whoever","এবং যে"],["يَتَوَكَّلْ","yatawakkal","puts his trust","ভরসা করে"],["عَلَى","‘alā","upon","উপর"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["فَهُوَ","fahuwa","then He","সে অতঃপর"],["حَسْبُهُۥٓ ۚ","ḥasbuhu","(is) sufficient for him","তার জন্যে যথেষ্ট"],["إِنَّ","inna","Indeed","নিশ্চয়"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["بَـٰلِغُ","bālighu","(will) accomplish","অর্জনকারী"],["أَمْرِهِۦ ۚ","amrihi","His purpose","তার কাজ"],["قَدْ","qad","Indeed","নিশ্চয়"],["جَعَلَ","ja‘ala","has set","বানিয়েছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["لِكُلِّ","likulli","for every","সব জন্যে"],["شَىْءٍۢ","shayin","thing","কিছুর"],["قَدْرًۭا","qadran","a measure","নির্দিষ্ট মাত্রা"]],"t":"وَيَرْزُ<q>قْ</>هُ مِنْ حَيْثُ لَا يَحْتَسِبُ ۚ وَ<d>مَن يَ</>تَوَكَّلْ عَلَى <h>ٱ</>للَّهِ فَهُوَ حَسْبُهُ<o>ۥٓ ۚ</> إِ<g>نَّ</> <h>ٱ</>للَّهَ <m>بَٰ</>لِغُ أَمْرِ<m>هِۦ</> ۚ قَ<q>دْ</> جَعَلَ <h>ٱ</>للَّهُ لِكُلِّ <k>شَىْءٍۢ قَ</><q>دْ</>رًۭا"},{"n":4,"w":[["وَٱلَّـٰٓـِٔى","wa-allāī","And those who","এবং যারা"],["يَئِسْنَ","ya-is'na","have despaired","নিরাশ হয়েছে"],["مِنَ","mina","of","হতে"],["ٱلْمَحِيضِ","l-maḥīḍi","the menstruation","হায়েয"],["مِن","min","among","মধ্য হতে"],["نِّسَآئِكُمْ","nisāikum","your women","তোমাদের স্ত্রীদের"],["إِنِ","ini","if","যদি"],["ٱرْتَبْتُمْ","ir'tabtum","you doubt","তোমরা সন্দেহ কর"],["فَعِدَّتُهُنَّ","fa‘iddatuhunna","then their waiting period","তাদের ইদ্দত তবে"],["ثَلَـٰثَةُ","thalāthatu","(is) three","তিন"],["أَشْهُرٍۢ","ashhurin","months","মাস"],["وَٱلَّـٰٓـِٔى","wa-allāī","and the ones who","এবং (তাদের জন্যও) যাদের"],["لَمْ","lam","not","নাই"],["يَحِضْنَ ۚ","yaḥiḍ'na","[they] menstruated","হায়েজ হয়"],["وَأُو۟لَـٰتُ","wa-ulātu","And those who (are)","এবং যারা"],["ٱلْأَحْمَالِ","l-aḥmāli","pregnant","এবং গর্ভবতীদের"],["أَجَلُهُنَّ","ajaluhunna","their term","তাদের সময়কাল"],["أَن","an","until","পর্যন্ত"],["يَضَعْنَ","yaḍa‘na","they deliver","প্রসব করা"],["حَمْلَهُنَّ ۚ","ḥamlahunna","their burdens","তাদের গর্ভ"],["وَمَن","waman","And whoever","এবং যে"],["يَتَّقِ","yattaqi","fears","ভয় করে"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["يَجْعَل","yaj‘al","He will make","করেছেন"],["لَّهُۥ","lahu","for him","তার জন্যে"],["مِنْ","min","of","মধ্য হতে"],["أَمْرِهِۦ","amrihi","his affair","তার কাজ"],["يُسْرًۭا","yus'ran","ease","সহজ"]],"t":"وَ<h>ٱ</><o>لَّٰٓـِٔ</>ى يَئِسْنَ مِنَ <h>ٱ</>لْمَحِيضِ <d>مِن نِّ</><o>سَآ</>ئِكُمْ إِنِ <h>ٱ</>رْتَ<q>بْ</>تُمْ فَعِدَّتُهُ<g>نَّ</> ثَ<m>لَٰ</>ثَةُ أَشْهُ<d>رٍۢ وَ</><h>ٱ</><o>لَّٰٓـِٔ</>ى لَمْ يَحِضْنَ ۚ وَأُ<s>و۟</><m>لَٰ</>تُ <h>ٱ</>لْأَحْمَالِ أَجَلُهُ<g>نَّ</> <d>أَن يَ</>ضَعْنَ حَمْلَهُ<g>نَّ</> ۚ وَ<d>مَن يَ</>تَّقِ <h>ٱ</>للَّهَ يَ<q>جْ</>عَل لَّهُ<m>ۥ</> مِنْ أَمْرِ<m>هِۦ</> يُسْرًۭا"},{"n":5,"w":[["ذَٰلِكَ","dhālika","That","এটা"],["أَمْرُ","amru","(is the) Command","বিধান"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["أَنزَلَهُۥٓ","anzalahu","which He has sent down","তা নাযিল করেছেন"],["إِلَيْكُمْ ۚ","ilaykum","to you","তোমাদের প্রতি"],["وَمَن","waman","and whoever","এবং যে"],["يَتَّقِ","yattaqi","fears","ভয় করে"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["يُكَفِّرْ","yukaffir","He will remove","মোচন করবেন"],["عَنْهُ","‘anhu","from him","তার থেকে"],["سَيِّـَٔاتِهِۦ","sayyiātihi","his evil deeds","তার পাপসমূহ"],["وَيُعْظِمْ","wayu‘'ẓim","and make great","ও মহান করবেন"],["لَهُۥٓ","lahu","for him","তার জন্যে"],["أَجْرًا","ajran","(his) reward","পুরস্কার"]],"t":"<m>ذَٰ</>لِكَ أَمْرُ <h>ٱ</>للَّهِ أَ<k>نزَ</>لَهُ<o>ۥٓ</> إِلَيْكُمْ ۚ وَ<d>مَن يَ</>تَّقِ <h>ٱ</>للَّهَ يُكَفِّرْ عَنْهُ سَيِّـَٔاتِ<m>هِۦ</> وَيُعْظِمْ لَهُ<o>ۥٓ</> أَ<q>جْ</>رًا"},{"n":6,"w":[["أَسْكِنُوهُنَّ","askinūhunna","Lodge them","তাদের বাস করতে দাও"],["مِنْ","min","from","মধ্য হতে"],["حَيْثُ","ḥaythu","where","যেখানে"],["سَكَنتُم","sakantum","you dwell","তোমরা বাস কর"],["مِّن","min","(out) of","থেকে"],["وُجْدِكُمْ","wuj'dikum","your means","তোমাদের সামর্থ"],["وَلَا","walā","and (do) not","এবং না"],["تُضَآرُّوهُنَّ","tuḍārrūhunna","harm them","তাদের তোমরা কষ্ট দিও"],["لِتُضَيِّقُوا۟","lituḍayyiqū","to distress","সঙ্কটে ফেলবার জন্যে"],["عَلَيْهِنَّ ۚ","‘alayhinna","[on] them","তাদেরকে"],["وَإِن","wa-in","And if","এবং যদি"],["كُنَّ","kunna","they are","তারা হয়"],["أُو۟لَـٰتِ","ulāti","those (who are)","যারা"],["حَمْلٍۢ","ḥamlin","pregnant","গর্ভবতী"],["فَأَنفِقُوا۟","fa-anfiqū","then spend","তোমরা খরচ তবে কর"],["عَلَيْهِنَّ","‘alayhinna","on them","তাদের উপর"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["يَضَعْنَ","yaḍa‘na","they deliver","প্রসব করে"],["حَمْلَهُنَّ ۚ","ḥamlahunna","their burden","তাদের গর্ভ"],["فَإِنْ","fa-in","Then if","যদি অতঃপর"],["أَرْضَعْنَ","arḍa‘na","they suckle","তারা দুধপান করায়"],["لَكُمْ","lakum","for you","তোমাদের (বাচ্চাদের)কে"],["فَـَٔاتُوهُنَّ","faātūhunna","then give them","তাদের দাও তবে তোমরা"],["أُجُورَهُنَّ ۖ","ujūrahunna","their payment","তাদের পারিশ্রমিকাদি"],["وَأْتَمِرُوا۟","watamirū","and consult","ও তোমরা পরামর্শ কর"],["بَيْنَكُم","baynakum","among yourselves","তোমাদের মাঝে"],["بِمَعْرُوفٍۢ ۖ","bima‘rūfin","with kindness","সংগতভাবে"],["وَإِن","wa-in","but if","এবং যদি"],["تَعَاسَرْتُمْ","ta‘āsartum","you disagree","তোমরা পরস্পরে কঠোরতা কর"],["فَسَتُرْضِعُ","fasatur'ḍi‘u","then may suckle","স্তন্য দিবে তবে"],["لَهُۥٓ","lahu","for him","তার জন্যে্যে"],["أُخْرَىٰ","ukh'rā","another (women)","অন্য (নারী)"]],"t":"أَسْكِنُوهُ<g>نَّ</> مِنْ حَيْثُ سَكَ<k>نتُ</><y>م مِّ</><d>ن وُ</><q>جْ</>دِكُمْ وَلَا تُ<n>ضَآ</>رُّوهُ<g>نَّ</> لِتُضَيِّقُو<s>ا۟</> عَلَيْهِ<g>نَّ</> ۚ وَإِ<k>ن كُ</><g>نَّ</> أُ<s>و۟</><m>لَٰ</>تِ حَمْ<k>لٍۢ فَأَنفِ</>قُو<s>ا۟</> عَلَيْهِ<g>نَّ</> حَتَّىٰ يَضَعْنَ حَمْلَهُ<g>نَّ</> ۚ فَإِنْ أَرْضَعْنَ لَكُمْ فَـَٔاتُوهُ<g>نَّ</> أُجُورَهُ<g>نَّ</> ۖ وَأْتَمِرُو<s>ا۟</> بَيْنَ<f>كُم بِ</>مَعْرُو<d>فٍۢ ۖ وَ</>إِ<k>ن تَ</>عَاسَرْتُمْ فَسَتُرْضِعُ لَهُ<o>ۥٓ</> أُخْرَىٰ"},{"n":7,"w":[["لِيُنفِقْ","liyunfiq","Let spend","খরচ যেন করে"],["ذُو","dhū","owner","আছে"],["سَعَةٍۢ","sa‘atin","(of) ample means","সচ্ছল ব্যক্তি"],["مِّن","min","from","অনুযায়ী"],["سَعَتِهِۦ ۖ","sa‘atihi","his ample means","তার সচ্ছলতা"],["وَمَن","waman","and (he) who","এবং যার"],["قُدِرَ","qudira","is restricted","সীমিত করা হয়েছে"],["عَلَيْهِ","‘alayhi","on him","তার উপর"],["رِزْقُهُۥ","riz'quhu","his provision","তার রিযক"],["فَلْيُنفِقْ","falyunfiq","let him spend","সে খরচ অতঃপর করবে"],["مِمَّآ","mimmā","from what","যা (তা) থেকে"],["ءَاتَىٰهُ","ātāhu","he has been given","তাকে দিয়েছেন"],["ٱللَّهُ ۚ","l-lahu","(by) Allah","আল্লাহ"],["لَا","lā","Does not","না"],["يُكَلِّفُ","yukallifu","burden","কষ্ট দেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["نَفْسًا","nafsan","any soul","কোন ব্যক্তিকে"],["إِلَّا","illā","except","এছাড়া"],["مَآ","mā","(with) what","যা"],["ءَاتَىٰهَا ۚ","ātāhā","He has given it","তাকে দিয়েছেন"],["سَيَجْعَلُ","sayaj‘alu","Will bring about","দিবেন শীঘ্রই"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["بَعْدَ","ba‘da","after","পর"],["عُسْرٍۢ","‘us'rin","hardship","কষ্টের"],["يُسْرًۭا","yus'ran","ease","স্বস্তি"]],"t":"لِيُ<k>نفِ</><q>قْ</> ذُو سَعَ<d>ةٍۢ مِّ</><k>ن سَ</>عَتِ<m>هِۦ</> ۖ وَمَ<k>ن قُ</>دِرَ عَلَيْهِ رِزْقُهُ<m>ۥ</> فَلْيُ<k>نفِ</><q>قْ</> مِ<g>مَّ</><o>آ</> ءَاتَ<m>ىٰ</>هُ <h>ٱ</>للَّهُ ۚ لَا يُكَلِّفُ <h>ٱ</>للَّهُ نَفْسًا إِلَّا <o>مَآ</> ءَاتَ<m>ىٰ</>هَا ۚ سَيَ<q>جْ</>عَلُ <h>ٱ</>للَّهُ بَعْدَ عُسْ<d>رٍۢ يُ</>سْرًۭا"},{"n":8,"w":[["وَكَأَيِّن","waka-ayyin","And how many","এবং কত"],["مِّن","min","of","থেকে"],["قَرْيَةٍ","qaryatin","a town","জনপদ"],["عَتَتْ","‘atat","rebelled","অমান্য করেছিল"],["عَنْ","‘an","against","বিপক্ষে"],["أَمْرِ","amri","(the) Command","নির্দেশ"],["رَبِّهَا","rabbihā","(of) its Lord","তার রবের"],["وَرُسُلِهِۦ","warusulihi","and His Messengers","ও তাঁর রসূলদের"],["فَحَاسَبْنَـٰهَا","faḥāsabnāhā","so We took it to account","তার আমরা হিসাব অতঃপর নিয়েছি"],["حِسَابًۭا","ḥisāban","an account","হিসাব"],["شَدِيدًۭا","shadīdan","severe","কঠোর"],["وَعَذَّبْنَـٰهَا","wa‘adhabnāhā","and We punished it","ও তার আমরা শাস্তি দিয়েছি"],["عَذَابًۭا","‘adhāban","a punishment","শাস্তি"],["نُّكْرًۭا","nuk'ran","terrible","ভীষণ"]],"t":"وَكَأَ<d>يِّن مِّ</><k>ن قَ</>رْيَةٍ عَتَتْ عَنْ أَمْرِ رَبِّهَا وَرُسُلِ<m>هِۦ</> فَحَاسَ<q>بْ</><m>نَٰ</>هَا حِسَا<k>بًۭا شَ</>دِي<d>دًۭا وَ</>عَذَّ<q>بْ</><m>نَٰ</>هَا عَذَا<d>بًۭا نُّ</>كْرًۭا"},{"n":9,"w":[["فَذَاقَتْ","fadhāqat","So it tasted","স্বাদ নিয়েছে অতঃপর"],["وَبَالَ","wabāla","(the bad) consequence","কুফলের"],["أَمْرِهَا","amrihā","(of) its affair","তার কাজের"],["وَكَانَ","wakāna","and was","এবং হল"],["عَـٰقِبَةُ","‘āqibatu","(the) end","পরিণাম"],["أَمْرِهَا","amrihā","(of) its affair","তার কাজের"],["خُسْرًا","khus'ran","loss","ক্ষতি"]],"t":"فَذَاقَتْ وَبَالَ أَمْرِهَا وَكَانَ <m>عَٰ</>قِبَةُ أَمْرِهَا خُسْرًا"},{"n":10,"w":[["أَعَدَّ","a‘adda","Has prepared","প্রস্তুত রেখেছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["لَهُمْ","lahum","for them","তাদের জন্যে"],["عَذَابًۭا","‘adhāban","a punishment","আযাব"],["شَدِيدًۭا ۖ","shadīdan","severe","কঠিন"],["فَٱتَّقُوا۟","fa-ittaqū","So fear","অতএব তোমরা ভয় কর"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["يَـٰٓأُو۟لِى","yāulī","O men","হে"],["ٱلْأَلْبَـٰبِ","l-albābi","(of) understanding","বোধসম্পন্নরা"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ءَامَنُوا۟ ۚ","āmanū","have believed","ঈমান এনেছে"],["قَدْ","qad","Indeed","নিশ্চয়"],["أَنزَلَ","anzala","Has sent down","অবতীর্ণ করে