ার জন্যে"],["رِزْقًا","riz'qan","provision","রিযক"]],"t":"رَّسُولًۭ<d>ا يَ</>تْلُو<s>ا۟</> عَلَيْكُمْ ءَا<m>يَٰ</>تِ <h>ٱ</>للَّهِ مُبَيِّ<m>نَٰ</><w>تٍۢ لِّ</>يُخْرِجَ <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ مِنَ <h>ٱ</><l>ل</>ظُّلُ<m>مَٰ</>تِ إِلَى <h>ٱ</><l>ل</><g>نُّ</>ورِ ۚ وَ<d>مَن يُ</>ؤْ<i>مِنۢ بِ</><h>ٱ</>للَّهِ وَيَعْمَلْ <m>صَٰ</>لِ<d>حًۭا يُ</><q>دْ</>خِلْهُ جَ<g>نَّٰ</><k>تٍۢ تَ</><q>جْ</>رِى مِ<k>ن تَ</>حْتِهَا <h>ٱ</>لْأَنْ<m>هَٰ</>رُ <m>خَٰ</>لِدِينَ فِي<o>هَآ</> أَبَ<k>دًۭا ۖ قَ</><q>دْ</> أَحْسَنَ <h>ٱ</>للَّهُ لَهُ<m>ۥ</> رِزْقًا"},{"n":12,"w":[["ٱللَّهُ","al-lahu","Allah","আল্লাহ"],["ٱلَّذِى","alladhī","(is) He Who","(তিনিই) যিনি"],["خَلَقَ","khalaqa","created","সৃষ্টি করেছেন"],["سَبْعَ","sab‘a","seven","সাত"],["سَمَـٰوَٰتٍۢ","samāwātin","heavens","আসমান"],["وَمِنَ","wamina","and of","ও পর্যায় হতে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["مِثْلَهُنَّ","mith'lahunna","(the) like of them","তাদের অনুরূপ"],["يَتَنَزَّلُ","yatanazzalu","Descends","নাযিল হয়"],["ٱلْأَمْرُ","l-amru","the command","নির্দেশ"],["بَيْنَهُنَّ","baynahunna","between them","তাদের মাঝে"],["لِتَعْلَمُوٓا۟","lita‘lamū","that you may know","তোমরা জান যেন"],["أَنَّ","anna","that","যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["عَلَىٰ","‘alā","(is) on","উপর"],["كُلِّ","kulli","every","সব"],["شَىْءٍۢ","shayin","thing","কিছুর"],["قَدِيرٌۭ","qadīrun","All-Powerful","ক্ষমতাবান"],["وَأَنَّ","wa-anna","And that","ও বাস্তবিকই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["قَدْ","qad","indeed","নিশ্চয়"],["أَحَاطَ","aḥāṭa","encompasses","পরিবেষ্টন করে রেখেছেন"],["بِكُلِّ","bikulli","all","সব"],["شَىْءٍ","shayin","things","কিছুকে"],["عِلْمًۢا","‘il'man","(in) knowledge","জ্ঞানে"]],"t":"ٱللَّهُ <h>ٱ</>لَّذِى خَلَقَ سَ<q>بْ</>عَ سَ<m>مَٰوَٰ</><d>تٍۢ وَ</>مِنَ <h>ٱ</>لْأَرْضِ مِثْلَهُ<g>نَّ</> يَتَنَزَّلُ <h>ٱ</>لْأَمْرُ بَيْنَهُ<g>نَّ</> لِتَعْلَ<o>مُوٓ</><s>ا۟</> أَ<g>نَّ</> <h>ٱ</>للَّهَ عَلَىٰ كُلِّ <k>شَىْءٍۢ قَ</>دِي<d>رٌۭ وَ</>أَ<g>نَّ</> <h>ٱ</>للَّهَ قَ<q>دْ</> أَحَاطَ بِكُلِّ شَىْءٍ عِلْمًۢا"}]}