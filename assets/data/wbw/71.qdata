{"n":71,"a":[{"n":1,"w":[["إِنَّآ","innā","Indeed, We","আমরা নিশ্চয়"],["أَرْسَلْنَا","arsalnā","[We] sent","আমরা পাঠিয়েছি"],["نُوحًا","nūḥan","Nuh","নূহকে"],["إِلَىٰ","ilā","to","প্রতি"],["قَوْمِهِۦٓ","qawmihi","his people","তার জাতির"],["أَنْ","an","that","যে"],["أَنذِرْ","andhir","Warn","\"তুমি সতর্ক কর"],["قَوْمَكَ","qawmaka","your people","তোমার জাতিকে"],["مِن","min","from","মধ্য হতে"],["قَبْلِ","qabli","before","পূর্বে"],["أَن","an","[that]","যে"],["يَأْتِيَهُمْ","yatiyahum","comes to them","তাদের উপর আসবে"],["عَذَابٌ","‘adhābun","a punishment","আযাব"],["أَلِيمٌۭ","alīmun","painful","কষ্টদায়ক\""]],"t":"إِ<g>نَّ</><o>آ</> أَرْسَلْنَا نُوحًا إِلَىٰ قَوْمِ<o>هِۦٓ</> أَنْ أَ<k>نذِ</>رْ قَوْمَكَ مِ<k>ن قَ</><q>بْ</>لِ <d>أَن يَ</>أْتِيَهُمْ عَذَابٌ أَ<p>لِي</>مٌۭ"},{"n":2,"w":[["قَالَ","qāla","He said","বলেছিল"],["يَـٰقَوْمِ","yāqawmi","O my people","\"আমার জাতি হে"],["إِنِّى","innī","Indeed, I am","আমি নিশ্চয়"],["لَكُمْ","lakum","to you","জন্যে তোমাদের"],["نَذِيرٌۭ","nadhīrun","a warner","সতর্ককারী"],["مُّبِينٌ","mubīnun","clear","সুস্পষ্ট"]],"t":"قَالَ <m>يَٰ</>قَوْمِ إِ<g>نِّ</>ى لَكُمْ نَذِي<d>رٌۭ مُّ</><p>بِي</>نٌ"},{"n":3,"w":[["أَنِ","ani","That","যেন"],["ٱعْبُدُوا۟","u‘'budū","Worship","তোমরা এবাদত কর"],["ٱللَّهَ","l-laha","Allah","আল্লাহর"],["وَٱتَّقُوهُ","wa-ittaqūhu","and fear Him","এবং তাঁকে ভয় কর"],["وَأَطِيعُونِ","wa-aṭī‘ūni","and obey me","ও আমার আনুগত্য কর"]],"t":"أَنِ <h>ٱ</>عْبُدُو<s>ا۟</> <h>ٱ</>للَّهَ وَ<h>ٱ</>تَّقُوهُ وَأَطِي<p>عُو</>نِ"},{"n":4,"w":[["يَغْفِرْ","yaghfir","He will forgive","মাফ তিনি করবেন"],["لَكُم","lakum","for you","তোমাদের জন্য"],["مِّن","min","[of]","থেকে"],["ذُنُوبِكُمْ","dhunūbikum","your sins","তোমাদের গুনাহ সমূহকে"],["وَيُؤَخِّرْكُمْ","wayu-akhir'kum","and give you respite","এবং তোমাদের অবকাশ দেবেন"],["إِلَىٰٓ","ilā","for","পর্যন্ত"],["أَجَلٍۢ","ajalin","a term","সময়"],["مُّسَمًّى ۚ","musamman","specified","নির্দিষ্ট"],["إِنَّ","inna","Indeed","নিশ্চয়"],["أَجَلَ","ajala","(the) term","নির্দধারিত কাল"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["إِذَا","idhā","when","যখন"],["جَآءَ","jāa","it comes","আসে"],["لَا","lā","not","না"],["يُؤَخَّرُ ۖ","yu-akharu","is delayed","বিলম্বিত করা হয়"],["لَوْ","law","if","যদি"],["كُنتُمْ","kuntum","you","তোমরা হতে"],["تَعْلَمُونَ","ta‘lamūna","know","অবগত\""]],"t":"يَغْفِرْ لَ<y>كُم مِّ</><k>ن ذُ</>نُوبِكُمْ وَيُؤَخِّرْكُمْ إِلَ<o>ىٰٓ</> أَجَ<d>لٍۢ مُّ</>سَ<g>مًّ</>ى ۚ إِ<g>نَّ</> أَجَلَ <h>ٱ</>للَّهِ إِذَا <o>جَآ</>ءَ لَا يُؤَخَّرُ ۖ لَوْ كُ<k>نتُ</>مْ تَعْلَ<p>مُو</>نَ"},{"n":5,"w":[["قَالَ","qāla","He said","সে বলল"],["رَبِّ","rabbi","My Lord","\"আমার রব হে"],["إِنِّى","innī","Indeed, I","আমি নিশ্চয়"],["دَعَوْتُ","da‘awtu","invited","আমি ডেকেছি"],["قَوْمِى","qawmī","my people","আমার জাতিকে"],["لَيْلًۭا","laylan","night","রাতে"],["وَنَهَارًۭا","wanahāran","and day","ও দিনে"]],"t":"قَالَ رَبِّ إِ<g>نِّ</>ى دَعَوْتُ قَوْمِى لَيْلًۭ<d>ا وَ</>نَهَارًۭا"},{"n":6,"w":[["فَلَمْ","falam","But not","তাই অতঃপর"],["يَزِدْهُمْ","yazid'hum","increased them","তাদের বৃদ্ধি পায়"],["دُعَآءِىٓ","du‘āī","my invitation","আমার দাকে"],["إِلَّا","illā","except","ছাড়া"],["فِرَارًۭا","firāran","(in) flight","পলায়ন"]],"t":"فَلَمْ يَزِ<q>دْ</>هُمْ دُ<o>عَآءِىٓ</> إِلَّا فِرَارًۭا"},{"n":7,"w":[["وَإِنِّى","wa-innī","And indeed, I","এবং আমি নিশ্চয়"],["كُلَّمَا","kullamā","every time","যখনই"],["دَعَوْتُهُمْ","da‘awtuhum","I invited them","তাদের আমি দেকেছি"],["لِتَغْفِرَ","litaghfira","that You may forgive","তুমি মাফ যাতে কর"],["لَهُمْ","lahum","them","তাদেরকে"],["جَعَلُوٓا۟","ja‘alū","they put","তারা রেখেছিল"],["أَصَـٰبِعَهُمْ","aṣābi‘ahum","their fingers","তাদের আংগুলগুলোকে"],["فِىٓ","fī","in","মধ্যে"],["ءَاذَانِهِمْ","ādhānihim","their ears","তাদের কানগুলোর"],["وَٱسْتَغْشَوْا۟","wa-is'taghshaw","and covered themselves","ও তারা ঢেকেছে"],["ثِيَابَهُمْ","thiyābahum","(with) their garments","তাদের কাপড় (দ্বারা)"],["وَأَصَرُّوا۟","wa-aṣarrū","and persisted","ও অনমনীয় হয়েছে"],["وَٱسْتَكْبَرُوا۟","wa-is'takbarū","and were arrogant","এবং অহংকার করেছে"],["ٱسْتِكْبَارًۭا","is'tik'bāran","(with) pride","বড়ই অহংকার"]],"t":"وَإِ<g>نِّ</>ى كُلَّمَا دَعَوْتُهُمْ لِتَغْفِرَ لَهُمْ جَعَ<o>لُوٓ</><s>ا۟</> أَ<m>صَٰ</>بِعَهُمْ <o>فِىٓ</> ءَاذَانِهِمْ وَ<h>ٱ</>سْتَغْشَوْ<s>ا۟</> ثِيَابَهُمْ وَأَصَرُّو<s>ا۟</> وَ<h>ٱ</>سْتَكْبَرُو<s>ا۟</> <h>ٱ</>سْتِكْبَارًۭا"},{"n":8,"w":[["ثُمَّ","thumma","Then","অতঃপর"],["إِنِّى","innī","indeed, I","আমি নিশ্চয়"],["دَعَوْتُهُمْ","da‘awtuhum","invited them","তাদের ডেকেছি"],["جِهَارًۭا","jihāran","publicly","প্রকাশ্যে"]],"t":"ثُ<g>مَّ</> إِ<g>نِّ</>ى دَعَوْتُهُمْ جِهَارًۭا"},{"n":9,"w":[["ثُمَّ","thumma","Then","এরপর"],["إِنِّىٓ","innī","indeed, I","আমি নিশ্চয়"],["أَعْلَنتُ","a‘lantu","announced","আমি ঘোষণা দিয়াছি"],["لَهُمْ","lahum","to them","তাদের জন্যে"],["وَأَسْرَرْتُ","wa-asrartu","and I confided","এবং আমি গোপনে বলেছি"],["لَهُمْ","lahum","to them","তাদেরকে"],["إِسْرَارًۭا","is'rāran","secretly","গোপনে বলা"]],"t":"ثُ<g>مَّ</> إِ<g>نِّ</><o>ىٓ</> أَعْلَ<k>نتُ</> لَهُمْ وَأَسْرَرْتُ لَهُمْ إِسْرَارًۭا"},{"n":10,"w":[["فَقُلْتُ","faqul'tu","Then I said","আমি বলেছি অতঃপর"],["ٱسْتَغْفِرُوا۟","is'taghfirū","Ask forgiveness","\"তোমরা মাফ চাও"],["رَبَّكُمْ","rabbakum","(from) your Lord","তোমাদের রবের (কাছে)"],["إِنَّهُۥ","innahu","Indeed, He","তিনি নিশ্চয়"],["كَانَ","kāna","is","হলেন"],["غَفَّارًۭا","ghaffāran","Oft-Forgiving","বড় ক্ষমাশীল"]],"t":"فَقُلْتُ <h>ٱ</>سْتَغْفِرُو<s>ا۟</> رَبَّكُمْ إِ<g>نَّ</>هُ<m>ۥ</> كَانَ غَفَّارًۭا"},{"n":11,"w":[["يُرْسِلِ","yur'sili","He will send down","পাঠাবেন তিনি"],["ٱلسَّمَآءَ","l-samāa","(rain from) the sky","আকাশ (থেকে)"],["عَلَيْكُم","‘alaykum","upon you","তোমাদের উপর"],["مِّدْرَارًۭا","mid'rāran","(in) abundance","বৃষ্টি"]],"t":"يُرْسِلِ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءَ عَلَيْ<y>كُم مِّ</><q>دْ</>رَارًۭا"},{"n":12,"w":[["وَيُمْدِدْكُم","wayum'did'kum","And provide you","এবং তোমাদের সাহায্য করবেন"],["بِأَمْوَٰلٍۢ","bi-amwālin","with wealth","মালসমূহ দিয়ে"],["وَبَنِينَ","wabanīna","and children","ও সন্তান সন্ততি দিয়ে"],["وَيَجْعَل","wayaj‘al","and make","এবং সৃষ্টি করবেন"],["لَّكُمْ","lakum","for you","তোমাদের জন্যে"],["جَنَّـٰتٍۢ","jannātin","gardens","বাগবাগিচাসমূহ"],["وَيَجْعَل","wayaj‘al","and make","ও বানাবেন"],["لَّكُمْ","lakum","for you","তোমাদের জন্যে"],["أَنْهَـٰرًۭا","anhāran","rivers","ঝর্ণাসমূহ"]],"t":"وَيُمْدِ<q>دْ</><f>كُم بِ</>أَمْ<m>وَٰ</><d>لٍۢ وَ</>بَنِينَ وَيَ<q>جْ</>عَل لَّكُمْ جَ<g>نَّٰ</><d>تٍۢ وَ</>يَ<q>جْ</>عَل لَّكُمْ أَنْ<m>هَٰ</>رًۭا"},{"n":13,"w":[["مَّا","mā","What","কী হয়েছে"],["لَكُمْ","lakum","(is) for you","তোমাদের"],["لَا","lā","not","না"],["تَرْجُونَ","tarjūna","you attribute","তোমরা আশা কর"],["لِلَّهِ","lillahi","to Allah","আল্লাহর জন্যে"],["وَقَارًۭا","waqāran","grandeur","মর্যাদা"]],"t":"مَّا لَكُمْ لَا تَرْجُونَ لِلَّهِ وَقَارًۭا"},{"n":14,"w":[["وَقَدْ","waqad","And indeed","এবং নিশ্চয়"],["خَلَقَكُمْ","khalaqakum","He created you","তোমাদের তিনি সৃষ্টি করেছেন"],["أَطْوَارًا","aṭwāran","(in) stages","পর্যায়ক্রমে"]],"t":"وَقَ<q>دْ</> خَلَقَكُمْ أَ<q>طْ</>وَارًا"},{"n":15,"w":[["أَلَمْ","alam","Do not","নাই কি"],["تَرَوْا۟","taraw","you see","তোমরা দেখ"],["كَيْفَ","kayfa","how","কেমনে"],["خَلَقَ","khalaqa","did create","সৃষ্টি করেছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["سَبْعَ","sab‘a","(the) seven","সাত"],["سَمَـٰوَٰتٍۢ","samāwātin","heavens","আসমান"],["طِبَاقًۭا","ṭibāqan","(in) layers","স্তরে স্তরে"]],"t":"أَلَمْ تَرَوْ<s>ا۟</> كَيْفَ خَلَقَ <h>ٱ</>للَّهُ سَ<q>بْ</>عَ سَ<m>مَٰوَٰ</><k>تٍۢ طِ</>بَاقًۭا"},{"n":16,"w":[["وَجَعَلَ","waja‘ala","And made","এবং বানিয়েছেন"],["ٱلْقَمَرَ","l-qamara","the moon","চাঁদকে"],["فِيهِنَّ","fīhinna","therein","তার মধ্যে"],["نُورًۭا","nūran","a light","আলো"],["وَجَعَلَ","waja‘ala","and made","এবং বানিয়েছেন"],["ٱلشَّمْسَ","l-shamsa","the sun","সূর্যকে"],["سِرَاجًۭا","sirājan","a lamp","প্রদীপ রূপে"]],"t":"وَجَعَلَ <h>ٱ</>لْقَمَرَ فِيهِ<g>نَّ</> نُو<d>رًۭا وَ</>جَعَلَ <h>ٱ</><l>ل</>شَّمْسَ سِرَاجًۭا"},{"n":17,"w":[["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["أَنۢبَتَكُم","anbatakum","has caused you to grow","তোমাদের উদ্ভুত করেছেন"],["مِّنَ","mina","from","থেকে"],["ٱلْأَرْضِ","l-arḍi","the earth","মৃত্তিকা"],["نَبَاتًۭا","nabātan","(as) a growth","(বিস্ময়করভাবে উদ্ভুত)"]],"t":"وَ<h>ٱ</>للَّهُ أَ<i>نۢبَ</>تَ<y>كُم مِّ</>نَ <h>ٱ</>لْأَرْضِ نَبَاتًۭا"},{"n":18,"w":[["ثُمَّ","thumma","Then","এরপর"],["يُعِيدُكُمْ","yu‘īdukum","He will return you","তোমাদের ফিরিয়ে নেবেন"],["فِيهَا","fīhā","into it","তার মধ্যে"],["وَيُخْرِجُكُمْ","wayukh'rijukum","and bring you forth","এবং তোমাদেরকে বের করবেন"],["إِخْرَاجًۭا","ikh'rājan","(a new) bringing forth","(সম্পূর্ণরূপে) বহিষ্কার"]],"t":"ثُ<g>مَّ</> يُعِيدُكُمْ فِيهَا وَيُخْرِجُكُمْ إِخْرَاجًۭا"},{"n":19,"w":[["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["جَعَلَ","ja‘ala","made","বানিয়েছেন"],["لَكُمُ","lakumu","for you","তোমাদের জন্যে"],["ٱلْأَرْضَ","l-arḍa","the earth","যমীনকে"],["بِسَاطًۭا","bisāṭan","an expanse","বিছানারুপে"]],"t":"وَ<h>ٱ</>للَّهُ جَعَلَ لَكُمُ <h>ٱ</>لْأَرْضَ بِسَاطًۭا"},{"n":20,"w":[["لِّتَسْلُكُوا۟","litaslukū","That you may go along","তোমরা চলো যেন"],["مِنْهَا","min'hā","therein","তা থেকে"],["سُبُلًۭا","subulan","(in) paths","রাস্তাসমূহে"],["فِجَاجًۭا","fijājan","wide","প্রশস্ত\""]],"t":"لِّتَسْلُكُو<s>ا۟</> مِنْهَا سُبُلًۭ<k>ا فِ</>جَاجًۭا"},{"n":21,"w":[["قَالَ","qāla","Said","বলল"],["نُوحٌۭ","nūḥun","Nuh","নূহ"],["رَّبِّ","rabbi","My Lord","\"হে আমার রব"],["إِنَّهُمْ","innahum","Indeed, they","তারা নিশ্চয়"],["عَصَوْنِى","‘aṣawnī","disobeyed me","আমাকে অমান্য করেছে"],["وَٱتَّبَعُوا۟","wa-ittaba‘ū","and followed","এবং তারা অনুসরণ করেছে"],["مَن","man","(the one) who","(তার) যার"],["لَّمْ","lam","(did) not","নাই"],["يَزِدْهُ","yazid'hu","increase him","তাকে বাড়ায়"],["مَالُهُۥ","māluhu","his wealth","তার মাল"],["وَوَلَدُهُۥٓ","wawaladuhu","and his children","ও তার সন্তান"],["إِلَّا","illā","except","ব্যতীত"],["خَسَارًۭا","khasāran","(in) loss","লোকসান (আর কিছুই)"]],"t":"قَالَ نُو<w>حٌۭ رَّ</>بِّ إِ<g>نَّ</>هُمْ عَصَوْنِى وَ<h>ٱ</>تَّبَعُو<s>ا۟</> <w>مَن لَّ</>مْ يَزِ<q>دْ</>هُ مَالُهُ<m>ۥ</> وَوَلَدُهُ<o>ۥٓ</> إِلَّا خَسَارًۭا"},{"n":22,"w":[["وَمَكَرُوا۟","wamakarū","And they have planned","এবং তারা ষড়যন্ত্র করেছে"],["مَكْرًۭا","makran","a plan","ষড়যন্ত্র"],["كُبَّارًۭا","kubbāran","great","অতি বড়"]],"t":"وَمَكَرُو<s>ا۟</> مَكْ<k>رًۭا كُ</>بَّارًۭا"},{"n":23,"w":[["وَقَالُوا۟","waqālū","And they said","এবং তারা বলেছে"],["لَا","lā","(Do) not","\"না"],["تَذَرُنَّ","tadharunna","leave","কখনোতোমরা ছেড়ো"],["ءَالِهَتَكُمْ","ālihatakum","your gods","তোমাদের ইলাহদেরকে"],["وَلَا","walā","and (do) not","এবং না"],["تَذَرُنَّ","tadharunna","leave","কখনো তোমরা ছেড়ো"],["وَدًّۭا","waddan","Wadd","ওয়াদ্দাকে"],["وَلَا","walā","and not","ও না"],["سُوَاعًۭا","suwā‘an","Suwa","সূয়া'আকে"],["وَلَا","walā","and not","এবং না"],["يَغُوثَ","yaghūtha","Yaguth","য়াগূছকে"],["وَيَعُوقَ","waya‘ūqa","and Yauq","আর ইয়াউক"],["وَنَسْرًۭا","wanasran","and Nasr","ও নছরকে\""]],"t":"وَقَالُو<s>ا۟</> لَا تَذَرُ<g>نَّ</> ءَالِهَتَكُمْ وَلَا تَذَرُ<g>نَّ</> وَ<d>دًّۭا وَ</>لَا سُوَا<d>عًۭا وَ</>لَا يَغُوثَ وَيَعُوقَ وَنَسْرًۭا"},{"n":24,"w":[["وَقَدْ","waqad","And indeed","এবং নিশ্চয়"],["أَضَلُّوا۟","aḍallū","they have led astray","তারা পথভ্রষ্ট করেছে"],["كَثِيرًۭا ۖ","kathīran","many","অনেককে"],["وَلَا","walā","And not","এবং না"],["تَزِدِ","tazidi","increase","বারাবেন"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","জালেমদেরকে"],["إِلَّا","illā","except","ছাড়া"],["ضَلَـٰلًۭا","ḍalālan","(in) error","পথভ্রষ্টতা\""]],"t":"وَقَ<q>دْ</> أَضَلُّو<s>ا۟</> كَثِي<d>رًۭا ۖ وَ</>لَا تَزِدِ <h>ٱ</><l>ل</><m>ظَّٰ</>لِمِينَ إِلَّا ضَ<m>لَٰ</>لًۭا"},{"n":25,"w":[["مِّمَّا","mimmā","Because of","একারণে"],["خَطِيٓـَٔـٰتِهِمْ","khaṭīātihim","their sins","তাদের অপরাধসমূহের"],["أُغْرِقُوا۟","ugh'riqū","they were drowned","তাদের ডুবান হয়েছে"],["فَأُدْخِلُوا۟","fa-ud'khilū","then made to enter","দাখিল করা হয়েছে অতঃপর কর"],["نَارًۭا","nāran","(the) Fire","আগুনে"],["فَلَمْ","falam","and not","নাই অতঃপর"],["يَجِدُوا۟","yajidū","they found","তারা পায়"],["لَهُم","lahum","for themselves","তাদের জন্যে"],["مِّن","min","from","থেকে"],["دُونِ","dūni","besides","ছাড়া"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["أَنصَارًۭا","anṣāran","any helpers","সাহায্যকারী হিসেবে"]],"t":"مِّ<g>مَّ</>ا خَ<o>طِيٓـَٰٔ</>تِهِمْ أُغْرِقُو<s>ا۟</> فَأُ<q>دْ</>خِلُو<s>ا۟</> نَا<k>رًۭا فَ</>لَمْ يَجِدُو<s>ا۟</> لَ<y>هُم مِّ</><k>ن دُ</>ونِ <h>ٱ</>للَّهِ أَ<k>نصَ</>ارًۭا"},{"n":26,"w":[["وَقَالَ","waqāla","And said","এবং বলল"],["نُوحٌۭ","nūḥun","Nuh","ণুহ"],["رَّبِّ","rabbi","My Lord","\"হে আমার রব"],["لَا","lā","(Do) not","না"],["تَذَرْ","tadhar","leave","ছাড়বেন"],["عَلَى","‘alā","on","উপর"],["ٱلْأَرْضِ","l-arḍi","the earth","যমীনের"],["مِنَ","mina","any","থেকে"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","(of) the disbelievers","কাফিরদের"],["دَيَّارًا","dayyāran","(as) an inhabitant","কোন গৃহবাসী"]],"t":"وَقَالَ نُو<w>حٌۭ رَّ</>بِّ لَا تَذَرْ عَلَى <h>ٱ</>لْأَرْضِ مِنَ <h>ٱ</>لْ<m>كَٰ</>فِرِينَ دَيَّارًا"},{"n":27,"w":[["إِنَّكَ","innaka","Indeed, You","আপনি নিশ্চয়"],["إِن","in","if","যদি"],["تَذَرْهُمْ","tadharhum","You leave them","তাদের ছাড়েন"],["يُضِلُّوا۟","yuḍillū","they will mislead","তারা গোমরাহ করবে"],["عِبَادَكَ","‘ibādaka","Your slaves","আপনার বান্দাদেরকে"],["وَلَا","walā","and not","এবং না"],["يَلِدُوٓا۟","yalidū","they will beget","তারা জন্ম দেবে"],["إِلَّا","illā","except","ছাড়া"],["فَاجِرًۭا","fājiran","a wicked","পাপাচারী"],["كَفَّارًۭا","kaffāran","a disbeliever","কট্টর কাফির"]],"t":"إِ<g>نَّ</>كَ إِ<k>ن تَ</>ذَرْهُمْ يُضِلُّو<s>ا۟</> عِبَادَكَ وَلَا يَلِ<o>دُوٓ</><s>ا۟</> إِلَّا فَاجِ<k>رًۭا كَ</>فَّارًۭا"},{"n":28,"w":[["رَّبِّ","rabbi","My Lord","হে আমার রব"],["ٱغْفِرْ","igh'fir","Forgive","মাফ করুন"],["لِى","lī","me","আমাকে"],["وَلِوَٰلِدَىَّ","waliwālidayya","and my parents","ও আমার পিতা-মাতাকে"],["وَلِمَن","waliman","and whoever","ও যে (তার) জন্য"],["دَخَلَ","dakhala","enters","প্রবেশ করেছে"],["بَيْتِىَ","baytiya","my house ","আমার ঘরে"],["مُؤْمِنًۭا","mu'minan","a believer","মু'মিন রূপে"],["وَلِلْمُؤْمِنِينَ","walil'mu'minīna","and the believing men","এবং মু'মিনপুরুষদের জন্যে"],["وَٱلْمُؤْمِنَـٰتِ","wal-mu'mināti","and the believing women","মুমিন স্ত্রীলোকদের"],["وَلَا","walā","And (do) not","এবং না"],["تَزِدِ","tazidi","increase","বাড়াবেন"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","জালেমদের অন্যকিছু"],["إِلَّا","illā","except","ছাড়া"],["تَبَارًۢا","tabāran","(in) destruction","ধ্বংস\""]],"t":"رَّبِّ <h>ٱ</>غْفِرْ لِى وَلِ<m>وَٰ</>لِدَىَّ وَلِمَ<k>ن دَ</>خَلَ بَيْتِىَ مُؤْمِ<d>نًۭا وَ</>لِلْمُؤْمِنِينَ وَ<h>ٱ</>لْمُؤْمِ<m>نَٰ</>تِ وَلَا تَزِدِ <h>ٱ</><l>ل</><m>ظَّٰ</>لِمِينَ إِلَّا تَبَارًۢا"}]}