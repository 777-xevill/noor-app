{"n":91,"a":[{"n":1,"w":[["وَٱلشَّمْسِ","wal-shamsi","By the sun","শপথ সূর্যের"],["وَضُحَىٰهَا","waḍuḥāhā","and its brightness","এবং তার কিরণের"]],"t":"وَ<h>ٱ</><l>ل</>شَّمْسِ وَضُحَ<m>ىٰ</>هَا"},{"n":2,"w":[["وَٱلْقَمَرِ","wal-qamari","And the moon","শপথ চাঁদের"],["إِذَا","idhā","when","যখন"],["تَلَىٰهَا","talāhā","it follows it","তার পিছে আসে"]],"t":"وَ<h>ٱ</>لْقَمَرِ إِذَا تَلَ<m>ىٰ</>هَا"},{"n":3,"w":[["وَٱلنَّهَارِ","wal-nahāri","And the day","শপথ দিনের"],["إِذَا","idhā","when","যখন"],["جَلَّىٰهَا","jallāhā","it displays it","তাকে প্রকাশ করে"]],"t":"وَ<h>ٱ</><l>ل</><g>نَّ</>هَارِ إِذَا جَلَّ<m>ىٰ</>هَا"},{"n":4,"w":[["وَٱلَّيْلِ","wa-al-layli","And the night","শপথ রাতের"],["إِذَا","idhā","when","যখন"],["يَغْشَىٰهَا","yaghshāhā","it covers it","তাকে ঢেকে ফেলে"]],"t":"وَ<h>ٱ</>لَّيْلِ إِذَا يَغْشَ<m>ىٰ</>هَا"},{"n":5,"w":[["وَٱلسَّمَآءِ","wal-samāi","And the heaven","শপথ আকাশের"],["وَمَا","wamā","and (He) Who","এবং যিনি"],["بَنَىٰهَا","banāhā","constructed it","তা তৈরি করেছেন"]],"t":"وَ<h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ وَمَا بَنَ<m>ىٰ</>هَا"},{"n":6,"w":[["وَٱلْأَرْضِ","wal-arḍi","And the earth","শপথ পৃথিবীর"],["وَمَا","wamā","and by (He) Who","এবং যিনি"],["طَحَىٰهَا","ṭaḥāhā","spread it","তা বিস্তৃত করেছেন"]],"t":"وَ<h>ٱ</>لْأَرْضِ وَمَا طَحَ<m>ىٰ</>هَا"},{"n":7,"w":[["وَنَفْسٍۢ","wanafsin","And (the) soul","শপথ মানুষের"],["وَمَا","wamā","and (He) Who","এবং যিনি"],["سَوَّىٰهَا","sawwāhā","proportioned it","তাকে সুঠাম করেছেন"]],"t":"وَنَفْ<d>سٍۢ وَ</>مَا سَوَّ<m>ىٰ</>هَا"},{"n":8,"w":[["فَأَلْهَمَهَا","fa-alhamahā","And He inspired it","অতঃপর তাকে জ্ঞান দিয়েছেন"],["فُجُورَهَا","fujūrahā","(to distinguish) its wickedness","তার মন্দকাজ"],["وَتَقْوَىٰهَا","wataqwāhā","and its righteousness","ও তার তাকওয়া (সম্পর্কে )"]],"t":"فَأَلْهَمَهَا فُجُورَهَا وَتَ<q>قْ</>وَ<m>ىٰ</>هَا"},{"n":9,"w":[["قَدْ","qad","Indeed","নিশ্চয়ই"],["أَفْلَحَ","aflaḥa","he succeeds","সফল হলো"],["مَن","man","who","যে"],["زَكَّىٰهَا","zakkāhā","purifies it","তাকে পবিত্র করলো"]],"t":"قَ<q>دْ</> أَفْلَحَ مَ<k>ن زَ</>كَّ<m>ىٰ</>هَا"},{"n":10,"w":[["وَقَدْ","waqad","And indeed","এবং নিশ্চয়ই"],["خَابَ","khāba","he fails","ব্যর্থ হলো"],["مَن","man","who","যে"],["دَسَّىٰهَا","dassāhā","buries it","তাকে কলুষিত করলো"]],"t":"وَقَ<q>دْ</> خَابَ مَ<k>ن دَ</>سَّ<m>ىٰ</>هَا"},{"n":11,"w":[["كَذَّبَتْ","kadhabat","Denied","মিথ্যারোপ করেছিল"],["ثَمُودُ","thamūdu","Thamud","সামূদ জাতি"],["بِطَغْوَىٰهَآ","biṭaghwāhā","by their transgression","তার অবাধ্যতাবশতঃ"]],"t":"كَذَّبَتْ ثَمُودُ بِطَغْوَ<m>ىٰ</>هَآ"},{"n":12,"w":[["إِذِ","idhi","When","যখন"],["ٱنۢبَعَثَ","inba‘atha","(was) sent forth","(তৎপর হয়ে)উঠলো"],["أَشْقَىٰهَا","ashqāhā","(the) most wicked of them","তার সবচেয়ে হতভাগা ব্যক্তি"]],"t":"إِذِ <h>ٱ</><i>نۢبَ</>عَثَ أَشْقَ<m>ىٰ</>هَا"},{"n":13,"w":[["فَقَالَ","faqāla","But said","অতঃপর বললো"],["لَهُمْ","lahum","to them","তাদেরকে"],["رَسُولُ","rasūlu","(the) Messenger","রাসূল"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["نَاقَةَ","nāqata","(It is the) she-camel","\"(সাবধান)উষ্ট্রীকে"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর (স্পর্শ করো না)"],["وَسُقْيَـٰهَا","wasuq'yāhā","and her drink","ও তার পানি পান করায় (বাধা দিও না)\""]],"t":"فَقَالَ لَهُمْ رَسُولُ <h>ٱ</>للَّهِ نَاقَةَ <h>ٱ</>للَّهِ وَسُ<q>قْ</><m>يَٰ</>هَا"},{"n":14,"w":[["فَكَذَّبُوهُ","fakadhabūhu","But they denied him","কিন্তু তারা তাকে  মিথ্যা ভাবলো"],["فَعَقَرُوهَا","fa‘aqarūhā","and they hamstrung her","অতঃপর তারা তাকে  হত্যা করলো"],["فَدَمْدَمَ","fadamdama","So destroyed","ফলে ধ্বংস করে দিলেন"],["عَلَيْهِمْ","‘alayhim","them","তাদেরকে"],["رَبُّهُم","rabbuhum","their Lord","তাদের রব"],["بِذَنۢبِهِمْ","bidhanbihim","for their sin","তাদের পাপের জন্য"],["فَسَوَّىٰهَا","fasawwāhā","and leveled them","অতঃপর তাদেরকে (মাটি) সমান করে দিলেন"]],"t":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّ<f>هُم بِ</>ذَ<i>نۢبِ</>هِمْ فَسَوَّ<m>ىٰ</>هَا"},{"n":15,"w":[["وَلَا","walā","And not","এবং না"],["يَخَافُ","yakhāfu","He fears","ভয় করেন তিনি"],["عُقْبَـٰهَا","‘uq'bāhā","its consequences","তাঁর (কাজের) পরিণতির"]],"t":"وَلَا يَخَافُ عُ<q>قْ</><m>بَٰ</>هَا"}]}