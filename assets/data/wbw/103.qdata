{"n":103,"a":[{"n":1,"w":[["وَٱلْعَصْرِ","wal-‘aṣri","By the time","শপথ মহাকালের"]],"t":"وَ<h>ٱ</>لْعَصْرِ"},{"n":2,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلْإِنسَـٰنَ","l-insāna","mankind","মানুষ"],["لَفِى","lafī","(is) surely, in","অবশ্যই মধ্যে"],["خُسْرٍ","khus'rin","loss","ক্ষতির"]],"t":"إِ<g>نَّ</> <h>ٱ</>لْإِ<k>نسَٰ</>نَ لَفِى خُسْرٍ"},{"n":3,"w":[["إِلَّا","illā","Except","(তাদের) ছাড়া"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["وَعَمِلُوا۟","wa‘amilū","and do","এবং করেছে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","righteous deeds","সৎকর্মের"],["وَتَوَاصَوْا۟","watawāṣaw","and enjoin (each other)","এবং পরস্পরকে উপদেশ দিয়েছে"],["بِٱلْحَقِّ","bil-ḥaqi","to the truth","সত্যের"],["وَتَوَاصَوْا۟","watawāṣaw","and enjoin (each other)","ও পরস্পরকে উপদেশ দিয়েছে"],["بِٱلصَّبْرِ","bil-ṣabri","to [the] patience","ধৈর্যের"]],"t":"إِلَّا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ وَتَوَاصَوْ<s>ا۟</> بِ<h>ٱ</>لْحَقِّ وَتَوَاصَوْ<s>ا۟</> بِ<h>ٱ</><l>ل</>صَّ<q>بْ</>رِ"}]}