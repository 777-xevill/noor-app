{"n":28,"a":[{"n":1,"w":[["طسٓمٓ","tta-seen-meem","Ta Seem Meem","ত্বা-সীন-মীম"]],"t":"ط<n>سٓمٓ</>"},{"n":2,"w":[["تِلْكَ","til'ka","These","এই"],["ءَايَـٰتُ","āyātu","(are the) Verses","আয়াতগুলো"],["ٱلْكِتَـٰبِ","l-kitābi","(of) the Book","কিতাবের"],["ٱلْمُبِينِ","l-mubīni","the clear","(যা) সুস্পষ্ট"]],"t":"تِلْكَ ءَا<m>يَٰ</>تُ <h>ٱ</>لْكِ<m>تَٰ</>بِ <h>ٱ</>لْمُ<p>بِي</>نِ"},{"n":3,"w":[["نَتْلُوا۟","natlū","We recite","আমরা তিলাওয়াত করছি"],["عَلَيْكَ","‘alayka","to you","নিকট তোমার"],["مِن","min","from","কিছু"],["نَّبَإِ","naba-i","(the) news","বৃত্তান্ত"],["مُوسَىٰ","mūsā","(of) Musa","মূসার"],["وَفِرْعَوْنَ","wafir'‘awna","and Firaun","ও ফিরআউনের"],["بِٱلْحَقِّ","bil-ḥaqi","in truth","ভাবে যথাযথ"],["لِقَوْمٍۢ","liqawmin","for a people","জন্যে (এমন) সম্প্রদায়ের (যারা)"],["يُؤْمِنُونَ","yu'minūna","who believe","ঈমান আনে"]],"t":"نَتْلُو<s>ا۟</> عَلَيْكَ <d>مِن نَّ</>بَإِ مُوسَىٰ وَفِرْعَوْنَ بِ<h>ٱ</>لْحَقِّ لِقَوْ<d>مٍۢ يُ</>ؤْمِ<p>نُو</>نَ"},{"n":4,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِرْعَوْنَ","fir'‘awna","Firaun","ফিরআউন"],["عَلَا","‘alā","exalted himself","উদ্ধৃত হয়েছিলো"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the land","দেশের (অর্থাৎ মিশরে)"],["وَجَعَلَ","waja‘ala","and made","এবং (বিভক্ত) করেছিলো"],["أَهْلَهَا","ahlahā","its people","অধিবাসীদেরকে তার"],["شِيَعًۭا","shiya‘an","(into) sects","(বিভিন্ন) দলে"],["يَسْتَضْعِفُ","yastaḍ‘ifu","oppressing","দূর্বল করে রেখে"],["طَآئِفَةًۭ","ṭāifatan","a group","একটি দলকে"],["مِّنْهُمْ","min'hum","among them","মধ্যে হ'তে তাদের"],["يُذَبِّحُ","yudhabbiḥu","slaughtering","সে জবেহ করতো"],["أَبْنَآءَهُمْ","abnāahum","their sons","পুত্রসন্তানদেরকে তাদের"],["وَيَسْتَحْىِۦ","wayastaḥyī","and letting live","ও জীবিত রাখতো"],["نِسَآءَهُمْ ۚ","nisāahum","their women","নারীদেরকে তাদের"],["إِنَّهُۥ","innahu","Indeed, he","নিশ্চয়ই সে"],["كَانَ","kāna","was","ছিলো"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْمُفْسِدِينَ","l-muf'sidīna","the corrupters","বিপর্যয় সৃষ্টিকারীদের"]],"t":"إِ<g>نَّ</> فِرْعَوْنَ عَلَا فِى <h>ٱ</>لْأَرْضِ وَجَعَلَ أَهْلَهَا شِيَ<d>عًۭا يَ</>سْتَضْعِفُ <o>طَآ</>ئِفَ<d>ةًۭ مِّ</>نْهُمْ يُذَبِّحُ أَ<q>بْ</><o>نَآ</>ءَهُمْ وَيَسْتَحْ<m>ىِۦ</> نِ<o>سَآ</>ءَهُمْ ۚ إِ<g>نَّ</>هُ<m>ۥ</> كَانَ مِنَ <h>ٱ</>لْمُفْسِ<p>دِي</>نَ"},{"n":5,"w":[["وَنُرِيدُ","wanurīdu","And We wanted","এবং আমরা চাই"],["أَن","an","to","যে"],["نَّمُنَّ","namunna","bestow a favor","আমরা অনুগ্রহ করবো"],["عَلَى","‘alā","upon","(তাদের) উপর"],["ٱلَّذِينَ","alladhīna","those who","যাদেরকে"],["ٱسْتُضْعِفُوا۟","us'tuḍ'‘ifū","were oppressed","দূর্বল করে রাখা হয়েছিলো"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the land","দেশের"],["وَنَجْعَلَهُمْ","wanaj‘alahum","and make them","এবং আমরা করবো তাদেরকে"],["أَئِمَّةًۭ","a-immatan","leaders","নেতা"],["وَنَجْعَلَهُمُ","wanaj‘alahumu","and make them","ও আমরা বানাবো তাদেরকে"],["ٱلْوَٰرِثِينَ","l-wārithīna","the inheritors","উত্তরাধিকারী"]],"t":"وَنُرِيدُ <d>أَن نَّ</>مُ<g>نَّ</> عَلَى <h>ٱ</>لَّذِينَ <h>ٱ</>سْتُضْعِفُو<s>ا۟</> فِى <h>ٱ</>لْأَرْضِ وَنَ<q>جْ</>عَلَهُمْ أَئِ<g>مَّ</><d>ةًۭ وَ</>نَ<q>جْ</>عَلَهُمُ <h>ٱ</>لْ<m>وَٰ</>رِ<p>ثِي</>نَ"},{"n":6,"w":[["وَنُمَكِّنَ","wanumakkina","And [We] establish","এবং আমরা ক্ষমতাসীন করবো"],["لَهُمْ","lahum","them","তাদেরকে"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the land","পৃথিবীর"],["وَنُرِىَ","wanuriya","and show","এবং আমরা দেখাবো"],["فِرْعَوْنَ","fir'‘awna","Firaun","ফিরআউনকে"],["وَهَـٰمَـٰنَ","wahāmāna","and Haman","ও হামানকে"],["وَجُنُودَهُمَا","wajunūdahumā","and their hosts","ও উভয়ের সৈন্য বাহিনীকে তাদের"],["مِنْهُم","min'hum","through them","হ'তে তাদের (অর্থাৎ বনি ঈসরাঈল)"],["مَّا","mā","what","(সেইসব) যা"],["كَانُوا۟","kānū","they were","তারা ছিলো"],["يَحْذَرُونَ","yaḥdharūna","fearing","আশংকা করে তারা"]],"t":"وَنُمَكِّنَ لَهُمْ فِى <h>ٱ</>لْأَرْضِ وَنُرِىَ فِرْعَوْنَ وَ<m>هَٰمَٰ</>نَ وَجُنُودَهُمَا مِنْ<y>هُم مَّ</>ا كَانُو<s>ا۟</> يَحْذَ<p>رُو</>نَ"},{"n":7,"w":[["وَأَوْحَيْنَآ","wa-awḥaynā","And We inspired","এবং ইঙ্গিতে বলেছিলাম আমরা"],["إِلَىٰٓ","ilā","[to]","প্রতি"],["أُمِّ","ummi","(the) mother","মায়ের"],["مُوسَىٰٓ","mūsā","(of) Musa","মূসার"],["أَنْ","an","that","যে"],["أَرْضِعِيهِ ۖ","arḍi‘īhi","Suckle him","\"দুধপান করাও তাকে"],["فَإِذَا","fa-idhā","but when","অতঃপর যখন"],["خِفْتِ","khif'ti","you fear","তুমি আশংকা করবে"],["عَلَيْهِ","‘alayhi","for him","সম্পর্কে তার"],["فَأَلْقِيهِ","fa-alqīhi","then cast him","তখন (ফেলে) দাও তাকে"],["فِى","fī","in(to)","মধ্যে"],["ٱلْيَمِّ","l-yami","the river","সাগরের"],["وَلَا","walā","and (do) not","এবং না"],["تَخَافِى","takhāfī","fear","ভয় করো"],["وَلَا","walā","and (do) not","আর না"],["تَحْزَنِىٓ ۖ","taḥzanī","grieve","দুঃশ্চিন্তা করো"],["إِنَّا","innā","Indeed, We","নিশ্চয়ই আমরা"],["رَآدُّوهُ","rāddūhu","(will) restore him","ফিরিয়ে দিবো তাকে"],["إِلَيْكِ","ilayki","to you","কাছে তোমার"],["وَجَاعِلُوهُ","wajā‘ilūhu","and (will) make him","ও করবো তাকে"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْمُرْسَلِينَ","l-mur'salīna","the Messengers","রাসূলদের\""]],"t":"وَأَوْحَيْ<o>نَآ</> إِلَ<o>ىٰٓ</> أُ<g>مِّ</> مُوسَ<o>ىٰٓ</> أَنْ أَرْضِعِيهِ ۖ فَإِذَا خِفْتِ عَلَيْهِ فَأَلْقِيهِ فِى <h>ٱ</>لْيَ<g>مِّ</> وَلَا تَخَافِى وَلَا تَحْزَ<o>نِىٓ ۖ</> إِ<g>نَّ</>ا <n>رَآ</>دُّوهُ إِلَيْكِ وَجَاعِلُوهُ مِنَ <h>ٱ</>لْمُرْسَ<p>لِي</>نَ"},{"n":8,"w":[["فَٱلْتَقَطَهُۥٓ","fal-taqaṭahu","Then picked him up","অতঃপর তুলে নিলো তাকে"],["ءَالُ","ālu","(the) family","পরিবার"],["فِرْعَوْنَ","fir'‘awna","(of) Firaun","ফিরআউনের"],["لِيَكُونَ","liyakūna","so that he might become","যেন হয় সে"],["لَهُمْ","lahum","to them","জন্যে তাদের"],["عَدُوًّۭا","‘aduwwan","an enemy","শত্রু"],["وَحَزَنًا ۗ","waḥazanan","and a grief","ও দুঃশ্চিন্তার কারণ"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِرْعَوْنَ","fir'‘awna","Firaun","ফিরআউন"],["وَهَـٰمَـٰنَ","wahāmāna","and Haman","ও হামান"],["وَجُنُودَهُمَا","wajunūdahumā","and their hosts","ও উভয়ের সেনাবাহিনী তাদের"],["كَانُوا۟","kānū","were","তারা ছিলো"],["خَـٰطِـِٔينَ","khāṭiīna","sinners","অপরাধী"]],"t":"فَ<h>ٱ</>لْتَقَطَهُ<o>ۥٓ</> ءَالُ فِرْعَوْنَ لِيَكُونَ لَهُمْ عَدُ<d>وًّۭا وَ</>حَزَنًا ۗ إِ<g>نَّ</> فِرْعَوْنَ وَ<m>هَٰمَٰ</>نَ وَجُنُودَهُمَا كَانُو<s>ا۟</> <m>خَٰ</><p>طِـِٔي</>نَ"},{"n":9,"w":[["وَقَالَتِ","waqālati","And said","এবং বললো"],["ٱمْرَأَتُ","im'ra-atu","(the) wife","স্ত্রী"],["فِرْعَوْنَ","fir'‘awna","(of) Firaun","ফিরআউনের"],["قُرَّتُ","qurratu","A comfort","\"(এই বালক) প্রশান্তি"],["عَيْنٍۢ","‘aynin","(of the) eye","নয়নের"],["لِّى","lī","for me","জন্যে আমার"],["وَلَكَ ۖ","walaka","and for you","ও জন্যে তোমার"],["لَا","lā","(Do) not","না"],["تَقْتُلُوهُ","taqtulūhu","kill him","তোমরা হত্যা করো তাকে"],["عَسَىٰٓ","‘asā","perhaps","হয়তো"],["أَن","an","(that)","সে"],["يَنفَعَنَآ","yanfa‘anā","he may benefit us","উপকারে আসবে আমাদের"],["أَوْ","aw","or","অথবা"],["نَتَّخِذَهُۥ","nattakhidhahu","we may take him","আমরা গ্রহন করবো তাকে"],["وَلَدًۭا","waladan","(as) a son","পুত্রসন্তান হিসেবে\""],["وَهُمْ","wahum","And they","অথচ তারা"],["لَا","lā","(did) not","না"],["يَشْعُرُونَ","yash‘urūna","perceive","টেরও পায় (এর পরিমাণ)"]],"t":"وَقَالَتِ <h>ٱ</>مْرَأَتُ فِرْعَوْنَ قُرَّتُ عَيْ<w>نٍۢ لِّ</>ى وَلَكَ ۖ لَا تَ<q>قْ</>تُلُوهُ عَسَ<o>ىٰٓ</> <d>أَن يَ</><k>نفَ</>عَ<o>نَآ</> أَوْ نَتَّخِذَهُ<m>ۥ</> وَلَ<d>دًۭا وَ</>هُمْ لَا يَشْعُ<p>رُو</>نَ"},{"n":10,"w":[["وَأَصْبَحَ","wa-aṣbaḥa","And became","এবং হয়ে পড়লো"],["فُؤَادُ","fuādu","(the) heart","অন্তর"],["أُمِّ","ummi","(of the) mother","মায়ের"],["مُوسَىٰ","mūsā","(of) Musa","মূসার"],["فَـٰرِغًا ۖ","fārighan","empty","বিচলিত"],["إِن","in","That","নিশ্চয়ই"],["كَادَتْ","kādat","she was near","উপক্রম হয়েছিলো যে"],["لَتُبْدِى","latub'dī","(to) disclosing","অবশ্যই সে প্রকাশ করবে"],["بِهِۦ","bihi","about him","সম্পর্কে সে"],["لَوْلَآ","lawlā","if not","যদি না"],["أَن","an","that","যে"],["رَّبَطْنَا","rabaṭnā","We strengthened","দৃঢ় করতাম আমরা"],["عَلَىٰ","‘alā","[over]","ওপর"],["قَلْبِهَا","qalbihā","her heart","অন্তরের তার"],["لِتَكُونَ","litakūna","so that she would be","যেন সে হয় (আমাদের প্রতিশ্রুতির প্রতি)"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believers","মু'মিনদের"]],"t":"وَأَصْبَحَ فُؤَادُ أُ<g>مِّ</> مُوسَىٰ <m>فَٰ</>رِغًا ۖ إِ<k>ن كَ</>ادَتْ لَتُ<q>بْ</>دِى بِ<m>هِۦ</> لَوْ<o>لَآ</> <w>أَن رَّ</>بَ<q>طْ</>نَا عَلَىٰ قَلْبِهَا لِتَكُونَ مِنَ <h>ٱ</>لْمُؤْمِ<p>نِي</>نَ"},{"n":11,"w":[["وَقَالَتْ","waqālat","And she said","এবং (তার মা) বললো"],["لِأُخْتِهِۦ","li-ukh'tihi","to his sister","উদ্দেশ্যে তার বোনের"],["قُصِّيهِ ۖ","quṣṣīhi","Follow him","\"পিছনে পিছনে যাও তার\""],["فَبَصُرَتْ","fabaṣurat","So she watched","তাই সে দেখে যেতে থাকলো"],["بِهِۦ","bihi","him","প্রতি তার"],["عَن","‘an","from","হ'তে"],["جُنُبٍۢ","junubin","a distance","দূর"],["وَهُمْ","wahum","while they","অথচ তারা"],["لَا","lā","(did) not","না"],["يَشْعُرُونَ","yash‘urūna","perceive","টেরও পেলো"]],"t":"وَقَالَتْ لِأُخْتِ<m>هِۦ</> قُصِّيهِ ۖ فَبَصُرَتْ بِ<m>هِۦ</> عَ<k>ن جُ</>نُ<d>بٍۢ وَ</>هُمْ لَا يَشْعُ<p>رُو</>نَ"},{"n":12,"w":[["۞ وَحَرَّمْنَا","waḥarramnā","And We had forbidden","এবং হারাম করে দিয়েছিলাম আমরা"],["عَلَيْهِ","‘alayhi","for him","উপর তার"],["ٱلْمَرَاضِعَ","l-marāḍi‘a","the wet nurses","স্তন্যদানকারিনীদেরকে"],["مِن","min","before","থেকেই"],["قَبْلُ","qablu","before","পূর্ব"],["فَقَالَتْ","faqālat","so she said","অতঃপর বললো (তার বোন)"],["هَلْ","hal","Shall I","\"কি"],["أَدُلُّكُمْ","adullukum","direct you","আমি সন্ধান দেবো তোমাদেরকে"],["عَلَىٰٓ","‘alā","to","সম্বন্ধে"],["أَهْلِ","ahli","(the) people","বাসিন্দাদের"],["بَيْتٍۢ","baytin","(of) a house","এক ঘরের"],["يَكْفُلُونَهُۥ","yakfulūnahu","who will rear him","তারা লালন পালন করবে তাকে"],["لَكُمْ","lakum","for you","জন্যে তোমাদের"],["وَهُمْ","wahum","while they","এবং তারা (হবে)"],["لَهُۥ","lahu","to him","জন্যে তার"],["نَـٰصِحُونَ","nāṣiḥūna","(will be) sincere","কল্যাণকামী\""]],"t":"۞ وَحَرَّمْنَا عَلَيْهِ <h>ٱ</>لْمَرَاضِعَ مِ<k>ن قَ</><q>بْ</>لُ فَقَالَتْ هَلْ أَدُلُّكُمْ عَلَ<o>ىٰٓ</> أَهْلِ بَيْ<d>تٍۢ يَ</>كْفُلُونَهُ<m>ۥ</> لَكُمْ وَهُمْ لَهُ<m>ۥ نَٰ</>صِ<p>حُو</>نَ"},{"n":13,"w":[["فَرَدَدْنَـٰهُ","faradadnāhu","So We restored him","অতঃপর আমরা ফিরিয়ে দিই তাকে"],["إِلَىٰٓ","ilā","to","নিকট"],["أُمِّهِۦ","ummihi","his mother","মায়ের তার"],["كَىْ","kay","that","যেন"],["تَقَرَّ","taqarra","might be comforted","জুড়ায়"],["عَيْنُهَا","‘aynuhā","her eye","চক্ষু তার"],["وَلَا","walā","and not","এবং না"],["تَحْزَنَ","taḥzana","she may grieve","দুশ্চিন্তা করে"],["وَلِتَعْلَمَ","walita‘lama","and that she would know","এবং যেন জানতে পারে"],["أَنَّ","anna","that","যে"],["وَعْدَ","wa‘da","the Promise of Allah","প্রতিশ্রুতি"],["ٱللَّهِ","l-lahi","the Promise of Allah","আল্লাহর"],["حَقٌّۭ","ḥaqqun","(is) true","সত্য"],["وَلَـٰكِنَّ","walākinna","But","কিন্তু"],["أَكْثَرَهُمْ","aktharahum","most of them","অধিকাংশই তাদের"],["لَا","lā","(do) not","না"],["يَعْلَمُونَ","ya‘lamūna","know","জানে"]],"t":"فَرَدَ<q>دْ</><m>نَٰ</>هُ إِلَ<o>ىٰٓ</> أُ<g>مِّ</><m>هِۦ</> كَىْ تَقَرَّ عَيْنُهَا وَلَا تَحْزَنَ وَلِتَعْلَمَ أَ<g>نَّ</> وَعْدَ <h>ٱ</>للَّهِ حَ<d>قٌّۭ وَ</><m>لَٰ</>كِ<g>نَّ</> أَكْثَرَهُمْ لَا يَعْلَ<p>مُو</>نَ"},{"n":14,"w":[["وَلَمَّا","walammā","And when","এবং যখন"],["بَلَغَ","balagha","he reached","সে পৌঁছে"],["أَشُدَّهُۥ","ashuddahu","his full strength","পূর্ণ যৌবনে তার"],["وَٱسْتَوَىٰٓ","wa-is'tawā","and became mature","ও পরিণত বয়স্ক হলো"],["ءَاتَيْنَـٰهُ","ātaynāhu","We bestowed upon him","আমরা দান করলাম তাকে"],["حُكْمًۭا","ḥuk'man","wisdom","প্রজ্ঞা"],["وَعِلْمًۭا ۚ","wa‘il'man","and knowledge","ও জ্ঞান"],["وَكَذَٰلِكَ","wakadhālika","And thus","এবং এভাবে"],["نَجْزِى","najzī","We reward","আমরা পুরস্কার দিই"],["ٱلْمُحْسِنِينَ","l-muḥ'sinīna","the good-doers","সৎকর্মশীলদেরকে"]],"t":"وَلَ<g>مَّ</>ا بَلَغَ أَشُدَّهُ<m>ۥ</> وَ<h>ٱ</>سْتَوَ<o>ىٰٓ</> ءَاتَيْ<m>نَٰ</>هُ حُكْ<d>مًۭا وَ</>عِلْ<d>مًۭا ۚ وَ</>كَ<m>ذَٰ</>لِكَ نَ<q>جْ</>زِى <h>ٱ</>لْمُحْسِ<p>نِي</>نَ"},{"n":15,"w":[["وَدَخَلَ","wadakhala","And he entered","এবং সে প্রবেশ করলো"],["ٱلْمَدِينَةَ","l-madīnata","the city","শহরে"],["عَلَىٰ","‘alā","at","এমন"],["حِينِ","ḥīni","a time","এক সময়ে (যখন)"],["غَفْلَةٍۢ","ghaflatin","(of) inattention","অসতর্ক (ছিলো)"],["مِّنْ","min","of","থেকে"],["أَهْلِهَا","ahlihā","its people","অধিবাসীদের তার"],["فَوَجَدَ","fawajada","and found","অতঃপর সে পেলো"],["فِيهَا","fīhā","therein","মধ্যে তার"],["رَجُلَيْنِ","rajulayni","two men","দু'ব্যক্তিকে"],["يَقْتَتِلَانِ","yaqtatilāni","fighting each other","তারা দু'জনে মারামারি করছে"],["هَـٰذَا","hādhā","this","এই (এক ব্যক্তি)"],["مِن","min","of","অন্তর্ভুক্ত"],["شِيعَتِهِۦ","shī‘atihi","his party","দলের তার"],["وَهَـٰذَا","wahādhā","and this","এবং এই (অন্য ব্যক্তি)"],["مِنْ","min","of","অন্তর্ভুক্ত"],["عَدُوِّهِۦ ۖ","‘aduwwihi","his enemy","শত্রু তার (দলের)"],["فَٱسْتَغَـٰثَهُ","fa-is'taghāthahu","And called him for help","অতঃপর সাহায্য চাইলো (নিকট) তার"],["ٱلَّذِى","alladhī","the one who","(সে) যে (ছিলো)"],["مِن","min","(was) from","অন্তর্ভুক্ত"],["شِيعَتِهِۦ","shī‘atihi","his party","দলের তার"],["عَلَى","‘alā","against","বিরুদ্ধে"],["ٱلَّذِى","alladhī","the one who","(তার) যে ছিলো"],["مِنْ","min","(was) from","অন্তর্ভুক্ত"],["عَدُوِّهِۦ","‘aduwwihi","his enemy","শত্রুর তার"],["فَوَكَزَهُۥ","fawakazahu","so Musa struck him with his fist","তখন ঘুষি মারলো তাকে"],["مُوسَىٰ","mūsā","so Musa struck him with his fist","মূসা"],["فَقَضَىٰ","faqaḍā","and killed him","অতঃপর শেষ করলেন"],["عَلَيْهِ ۖ","‘alayhi","and killed him","ব্যাপার তার (অর্থাৎ সে মারা গেলো)"],["قَالَ","qāla","He said","(সাথে সাথেই) সে বললো"],["هَـٰذَا","hādhā","This (is)","\"এটা"],["مِنْ","min","of","অন্তর্ভুক্ত"],["عَمَلِ","‘amali","(the) deed","কাজের"],["ٱلشَّيْطَـٰنِ ۖ","l-shayṭāni","(of) Shaitaan","শয়তানের"],["إِنَّهُۥ","innahu","Indeed, he","নিশ্চয়ই সে"],["عَدُوٌّۭ","‘aduwwun","(is) an enemy ","শ্ত্রু"],["مُّضِلٌّۭ","muḍillun","one who misleads","বিভ্রান্তকারী"],["مُّبِينٌۭ","mubīnun","clearly","সুস্পষ্ট\""]],"t":"وَدَخَلَ <h>ٱ</>لْمَدِينَةَ عَلَىٰ حِينِ غَفْلَ<d>ةٍۢ مِّ</>نْ أَهْلِهَا فَوَجَدَ فِيهَا رَجُلَيْنِ يَ<q>قْ</>تَتِلَانِ <m>هَٰ</>ذَا مِ<k>ن شِ</>يعَتِ<m>هِۦ</> وَ<m>هَٰ</>ذَا مِنْ عَدُوِّ<m>هِۦ</> ۖ فَ<h>ٱ</>سْتَ<m>غَٰ</>ثَهُ <h>ٱ</>لَّذِى مِ<k>ن شِ</>يعَتِ<m>هِۦ</> عَلَى <h>ٱ</>لَّذِى مِنْ عَدُوِّ<m>هِۦ</> فَوَكَزَهُ<m>ۥ</> مُوسَىٰ فَقَضَىٰ عَلَيْهِ ۖ قَالَ <m>هَٰ</>ذَا مِنْ عَمَلِ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نِ ۖ إِ<g>نَّ</>هُ<m>ۥ</> عَدُ<d>وٌّۭ مُّضِلٌّۭ مُّ</><p>بِي</>نٌۭ"},{"n":16,"w":[["قَالَ","qāla","He said","সে বললো"],["رَبِّ","rabbi","My Lord","\"হে আমার রব"],["إِنِّى","innī","Indeed, I","নিশ্চয়ই আমি"],["ظَلَمْتُ","ẓalamtu","[I] have wronged","অন্যায় করেছি"],["نَفْسِى","nafsī","my soul","আমার নিজের (উপর)"],["فَٱغْفِرْ","fa-igh'fir","so forgive","অতএব ক্ষমা করো"],["لِى","lī","[for] me","আমাকে\""],["فَغَفَرَ","faghafara","Then He forgave","অতঃপর ক্ষমা করলেন তিনি"],["لَهُۥٓ ۚ","lahu","[for] him","তাকে"],["إِنَّهُۥ","innahu","Indeed He","নিশ্চয়ই তিনি"],["هُوَ","huwa","He (is)","তিনিই"],["ٱلْغَفُورُ","l-ghafūru","the Oft-Forgiving","ক্ষমাশীল"],["ٱلرَّحِيمُ","l-raḥīmu","the Most Merciful","পরম দয়ালু"]],"t":"قَالَ رَبِّ إِ<g>نِّ</>ى ظَلَمْتُ نَفْسِى فَ<h>ٱ</>غْفِرْ لِى فَغَفَرَ لَهُ<o>ۥٓ ۚ</> إِ<g>نَّ</>هُ<m>ۥ</> هُوَ <h>ٱ</>لْغَفُورُ <h>ٱ</><l>ل</>رَّ<p>حِي</>مُ"},{"n":17,"w":[["قَالَ","qāla","He said","সে বললো"],["رَبِّ","rabbi","My Lord","\"হে আমার রব"],["بِمَآ","bimā","Because","শপথ ঐ বিষয়ের যা"],["أَنْعَمْتَ","an‘amta","You have favored","তুমি অনুগ্রহ করেছো"],["عَلَىَّ","‘alayya","[on] me","উপর আমার"],["فَلَنْ","falan","so not","অতঃপর কখনও না"],["أَكُونَ","akūna","I will be","হবো আমি"],["ظَهِيرًۭا","ẓahīran","a supporter","সাহায্যকারী"],["لِّلْمُجْرِمِينَ","lil'muj'rimīna","(of) the criminals","জন্যে অপরাধীদের\""]],"t":"قَالَ رَبِّ بِ<o>مَآ</> أَنْعَمْتَ عَلَىَّ فَلَنْ أَكُونَ ظَهِي<w>رًۭا لِّ</>لْمُ<q>جْ</>رِ<p>مِي</>نَ"},{"n":18,"w":[["فَأَصْبَحَ","fa-aṣbaḥa","In the morning he was","অতঃপর সকালে উঠলো"],["فِى","fī","in","মধ্যে"],["ٱلْمَدِينَةِ","l-madīnati","the city","শহরের"],["خَآئِفًۭا","khāifan","fearful","ভীতসন্ত্রস্ত অবস্থায়"],["يَتَرَقَّبُ","yataraqqabu","(and) was vigilant","সতর্ক হয়ে"],["فَإِذَا","fa-idhā","when behold","অতঃপর তখন (দেখলো)"],["ٱلَّذِى","alladhī","The one who","যে"],["ٱسْتَنصَرَهُۥ","is'tanṣarahu","sought his help","তার (কাছে) সাহায্য চেয়েছিলো"],["بِٱلْأَمْسِ","bil-amsi","the previous day","গতকাল"],["يَسْتَصْرِخُهُۥ ۚ","yastaṣrikhuhu","cried out to him for help","(আজও) তাকে চিৎকার করে ডাকছে"],["قَالَ","qāla","Said","বললো"],["لَهُۥ","lahu","to him","উদ্দেশ্যে তার"],["مُوسَىٰٓ","mūsā","Musa","মূসা"],["إِنَّكَ","innaka","Indeed, you","\"নিশ্চয়ই তুমি"],["لَغَوِىٌّۭ","laghawiyyun","(are) surely a deviator","অবশ্যই বিভ্রান্ত"],["مُّبِينٌۭ","mubīnun","clear","সুস্পষ্ট\""]],"t":"فَأَصْبَحَ فِى <h>ٱ</>لْمَدِينَةِ <o>خَآ</>ئِ<d>فًۭا يَ</>تَرَقَّبُ فَإِذَا <h>ٱ</>لَّذِى <h>ٱ</>سْتَ<k>نصَ</>رَهُ<m>ۥ</> بِ<h>ٱ</>لْأَمْسِ يَسْتَصْرِخُهُ<m>ۥ</> ۚ قَالَ لَهُ<m>ۥ</> مُوسَ<o>ىٰٓ</> إِ<g>نَّ</>كَ لَغَوِ<d>ىٌّۭ مُّ</><p>بِي</>نٌۭ"},{"n":19,"w":[["فَلَمَّآ","falammā","Then when","অতঃপর যখন"],["أَنْ","an","[that]","যে"],["أَرَادَ","arāda","he wanted","সে ইচ্ছে করলো"],["أَن","an","to","যে"],["يَبْطِشَ","yabṭisha","strike","সে ধরবে"],["بِٱلَّذِى","bi-alladhī","the one who","তাকে"],["هُوَ","huwa","[he] (was)","যে (ছিলো)"],["عَدُوٌّۭ","‘aduwwun","an enemy","শত্রু"],["لَّهُمَا","lahumā","to both of them","জন্যে তাদের উভয়ের"],["قَالَ","qāla","he said","(ইসরাঈলী) বললো"],["يَـٰمُوسَىٰٓ","yāmūsā","O Musa","\"হে মূসা"],["أَتُرِيدُ","aturīdu","Do you intend","কি ততুমি চাচ্ছো"],["أَن","an","to","যে"],["تَقْتُلَنِى","taqtulanī","kill me","তুমি হত্যা করবে আমাকে"],["كَمَا","kamā","as","যেমন"],["قَتَلْتَ","qatalta","you killed","হত্যা করেছো তুমি"],["نَفْسًۢا","nafsan","a person","এক ব্যক্তিকে"],["بِٱلْأَمْسِ ۖ","bil-amsi","yesterday","গতকাল"],["إِن","in","Not","না"],["تُرِيدُ","turīdu","you want","তুমি চাচ্ছো"],["إِلَّآ","illā","but","এ ছাড়া"],["أَن","an","that","যে"],["تَكُونَ","takūna","you become","তুমি হবে"],["جَبَّارًۭا","jabbāran","a tyrant","স্বেচ্ছাচারী"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","এদেশের"],["وَمَا","wamā","and not","আর না"],["تُرِيدُ","turīdu","you want","তুমি চাও"],["أَن","an","that","যে"],["تَكُونَ","takūna","you be","তুমি হবে"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْمُصْلِحِينَ","l-muṣ'liḥīna","the reformers","সংশোধনকারীদের\""]],"t":"فَلَ<g>مَّ</><o>آ</> أَنْ أَرَادَ <d>أَن يَ</><q>بْ</>طِشَ بِ<h>ٱ</>لَّذِى هُوَ عَدُ<w>وٌّۭ لَّ</>هُمَا قَالَ <m>يَٰ</>مُوسَ<o>ىٰٓ</> أَتُرِيدُ أَ<k>ن تَ</><q>قْ</>تُلَنِى كَمَا قَتَلْتَ نَفْ<i>سًۢا بِ</><h>ٱ</>لْأَمْسِ ۖ إِ<k>ن تُ</>رِيدُ إِ<o>لَّآ</> أَ<k>ن تَ</>كُونَ جَبَّا<k>رًۭا فِ</>ى <h>ٱ</>لْأَرْضِ وَمَا تُرِيدُ أَ<k>ن تَ</>كُونَ مِنَ <h>ٱ</>لْمُصْلِ<p>حِي</>نَ"},{"n":20,"w":[["وَجَآءَ","wajāa","And came","এবং (এরপর) আসলো"],["رَجُلٌۭ","rajulun","a man","এক ব্যক্তি"],["مِّنْ","min","from","হ'তে"],["أَقْصَا","aqṣā","(the) farthest end","দূর প্রান্ত"],["ٱلْمَدِينَةِ","l-madīnati","(of) the city","শহরের"],["يَسْعَىٰ","yas‘ā","running","দৌঁড়িয়ে"],["قَالَ","qāla","He said","সে বললো"],["يَـٰمُوسَىٰٓ","yāmūsā","O Musa","\"হে মূসা"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلْمَلَأَ","l-mala-a","the chiefs","সভাষদবর্গ"],["يَأْتَمِرُونَ","yatamirūna","are taking counsel","পরামর্শ করেছে"],["بِكَ","bika","about you","নিয়ে তোমার"],["لِيَقْتُلُوكَ","liyaqtulūka","to kill you","যাতে তারা তোমাকে হত্যা করে"],["فَٱخْرُجْ","fa-ukh'ruj","so leave","সুতরাং বের হয়ে যাও"],["إِنِّى","innī","indeed, I am","নিশ্চয়ই আমি"],["لَكَ","laka","to you","ব্যাপারে তোমার"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلنَّـٰصِحِينَ","l-nāṣiḥīna","the sincere advisors","মঙ্গলকামীদের\""]],"t":"وَ<o>جَآ</>ءَ رَجُ<d>لٌۭ مِّ</>نْ أَ<q>قْ</>صَا <h>ٱ</>لْمَدِينَةِ يَسْعَىٰ قَالَ <m>يَٰ</>مُوسَ<o>ىٰٓ</> إِ<g>نَّ</> <h>ٱ</>لْمَلَأَ يَأْتَمِرُونَ بِكَ لِيَ<q>قْ</>تُلُوكَ فَ<h>ٱ</>خْرُ<q>جْ</> إِ<g>نِّ</>ى لَكَ مِنَ <h>ٱ</><l>ل</><g>نَّٰ</>صِ<p>حِي</>نَ"},{"n":21,"w":[["فَخَرَجَ","fakharaja","So he left","তখন সে বের হলো"],["مِنْهَا","min'hā","from it","সেখান হ'তে"],["خَآئِفًۭا","khāifan","fearing","ভীত অবস্থায়"],["يَتَرَقَّبُ ۖ","yataraqqabu","(and) vigilant","সতর্ক হয়ে"],["قَالَ","qāla","He said","(মূসা) বললো"],["رَبِّ","rabbi","My Lord","\"হে আমার রব"],["نَجِّنِى","najjinī","Save me","আমাকে উদ্ধার করো"],["مِنَ","mina","from","হ'তে"],["ٱلْقَوْمِ","l-qawmi","the people ","সম্প্রদায়"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","সীমালঙ্ঘনকারী\""]],"t":"فَخَرَجَ مِنْهَا <o>خَآ</>ئِ<d>فًۭا يَ</>تَرَقَّبُ ۖ قَالَ رَبِّ نَجِّنِى مِنَ <h>ٱ</>لْقَوْمِ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":22,"w":[["وَلَمَّا","walammā","And when","এবং যখন"],["تَوَجَّهَ","tawajjaha","he turned his face","মুখ ফেরালো (রওনা হলো)"],["تِلْقَآءَ","til'qāa","towards","দিকে"],["مَدْيَنَ","madyana","Madyan","মাদইয়ানের"],["قَالَ","qāla","he said","সে বললো"],["عَسَىٰ","‘asā","Perhaps","\"আশা করা যায়"],["رَبِّىٓ","rabbī","my Lord","আমার রব"],["أَن","an","[that]","যে"],["يَهْدِيَنِى","yahdiyanī","will guide me","প্রদর্শন করবেন আমাকে"],["سَوَآءَ","sawāa","(to the) sound","সরল"],["ٱلسَّبِيلِ","l-sabīli","way","পথ\""]],"t":"وَلَ<g>مَّ</>ا تَوَجَّهَ تِلْ<o>قَآ</>ءَ مَ<q>دْ</>يَنَ قَالَ عَسَىٰ رَ<o>بِّىٓ</> <d>أَن يَ</>هْدِيَنِى سَ<o>وَآ</>ءَ <h>ٱ</><l>ل</>سَّ<p>بِي</>لِ"},{"n":23,"w":[["وَلَمَّا","walammā","And when","আর যখন"],["وَرَدَ","warada","he came","পৌঁছলো"],["مَآءَ","māa","(to the) water","পানির (কূপের নিকট)"],["مَدْيَنَ","madyana","(of) Madyan","মাদইয়ানের"],["وَجَدَ","wajada","he found","সে পেলো"],["عَلَيْهِ","‘alayhi","on it","কাছে তার"],["أُمَّةًۭ","ummatan","a group","একদল"],["مِّنَ","mina","of","মধ্য হ'তে"],["ٱلنَّاسِ","l-nāsi","men","লোকদের"],["يَسْقُونَ","yasqūna","watering","পানি পান করাচ্ছে (নিজেদের জন্তুগুলোকে)"],["وَوَجَدَ","wawajada","and he found","এবং সে পেলো"],["مِن","min","besides them","ছাড়াও"],["دُونِهِمُ","dūnihimu","besides them","তাদের"],["ٱمْرَأَتَيْنِ","im'ra-atayni","two women","দু'জন স্ত্রীলোককে"],["تَذُودَانِ ۖ","tadhūdāni","keeping back","দু'জনে আগলে রেখেছে (তাদের জন্তুগুলোকে)"],["قَالَ","qāla","He said","(মূসা) বললো"],["مَا","mā","What","\"কি"],["خَطْبُكُمَا ۖ","khaṭbukumā","(is the) matter with both of you","ব্যাপার তোমাদের দু'জনের\""],["قَالَتَا","qālatā","They said","দু'জনে বললো"],["لَا","lā","We cannot water","\"না"],["نَسْقِى","nasqī","We cannot water","\"আমরা পানি পান করাই"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["يُصْدِرَ","yuṣ'dira","take away","সরিয়ে নিয়ে যায়"],["ٱلرِّعَآءُ ۖ","l-ri‘āu","the shepherds","রাখালরা (তাদের জন্তুগুলো)"],["وَأَبُونَا","wa-abūnā","and our father","এবং আমাদের আব্বা"],["شَيْخٌۭ","shaykhun","(is) a very old man","বৃদ্ধ\""],["كَبِيرٌۭ","kabīrun","(is) a very old man","অতিশয় (তাই আমরা এসেছি)\""]],"t":"وَلَ<g>مَّ</>ا وَرَدَ <o>مَآ</>ءَ مَ<q>دْ</>يَنَ وَجَدَ عَلَيْهِ أُ<g>مَّ</><d>ةًۭ مِّ</>نَ <h>ٱ</><l>ل</><g>نَّ</>اسِ يَسْقُونَ وَوَجَدَ مِ<k>ن دُ</>ونِهِمُ <h>ٱ</>مْرَأَتَيْنِ تَذُودَانِ ۖ قَالَ مَا خَ<q>طْ</>بُكُمَا ۖ قَالَتَا لَا نَسْقِى حَتَّىٰ يُصْدِرَ <h>ٱ</><l>ل</>رِّ<o>عَآ</>ءُ ۖ وَأَبُونَا شَيْ<k>خٌۭ كَ</><p>بِي</>رٌۭ"},{"n":24,"w":[["فَسَقَىٰ","fasaqā","So he watered","তখন সে পানি পান করালো"],["لَهُمَا","lahumā","for them","পক্ষে তাদের দু'জনের (জন্তুগুলোকে)"],["ثُمَّ","thumma","Then","এরপর"],["تَوَلَّىٰٓ","tawallā","he turned back","ফিরে গেলো"],["إِلَى","ilā","to","দিকে"],["ٱلظِّلِّ","l-ẓili","the shade","ছায়ার"],["فَقَالَ","faqāla","and said","অতঃপর বললো"],["رَبِّ","rabbi","My Lord","\"হে আমার রব"],["إِنِّى","innī","Indeed, I am","নিশ্চয়ই আমি"],["لِمَآ","limā","of whatever","তার প্রতি যা"],["أَنزَلْتَ","anzalta","You send","অবতীর্ণ করবে তুমি"],["إِلَىَّ","ilayya","to me","প্রতি আমার"],["مِنْ","min","of","কোনো"],["خَيْرٍۢ","khayrin","good","কল্যাণ"],["فَقِيرٌۭ","faqīrun","(in) need","(আমি তারই)মুখাপেক্ষী\""]],"t":"فَسَقَىٰ لَهُمَا ثُ<g>مَّ</> تَوَلَّ<o>ىٰٓ</> إِلَى <h>ٱ</><l>ل</>ظِّلِّ فَقَالَ رَبِّ إِ<g>نِّ</>ى لِ<o>مَآ</> أَ<k>نزَ</>لْتَ إِلَىَّ مِنْ خَيْ<k>رٍۢ فَ</><p>قِي</>رٌۭ"},{"n":25,"w":[["فَجَآءَتْهُ","fajāathu","Then came to him","অতঃপর কাছে আসলো তার"],["إِحْدَىٰهُمَا","iḥ'dāhumā","one of the two women","দু'জনের একজন তাদের"],["تَمْشِى","tamshī","walking","হেঁটে"],["عَلَى","‘alā","with","সাথে"],["ٱسْتِحْيَآءٍۢ","is'tiḥ'yāin","shyness","লজ্জা ও শালিনতার"],["قَالَتْ","qālat","She said","(মেয়েটি) বললো"],["إِنَّ","inna","Indeed","\"নিশ্চয়ই"],["أَبِى","abī","my father","আমার পিতা (শোয়াইব আঃ)"],["يَدْعُوكَ","yad‘ūka","calls you","আপনাকে ডাকছেন"],["لِيَجْزِيَكَ","liyajziyaka","that he may reward you","যাতে তিনি আপনাকে প্রতিদান দিতে পারেন"],["أَجْرَ","ajra","(the) reward","পারিশ্রমিক"],["مَا","mā","(for) what","(তার) যা"],["سَقَيْتَ","saqayta","you watered","আপনি (জন্তুগুলোকে) পানি পান করিয়েছেন"],["لَنَا ۚ","lanā","for us","পক্ষ হয়ে আমাদের\""],["فَلَمَّا","falammā","So when","অতঃপর যখন"],["جَآءَهُۥ","jāahu","he came to him","সে আসলো কাছে তার"],["وَقَصَّ","waqaṣṣa","and narrated","ও বর্ণনা করলো"],["عَلَيْهِ","‘alayhi","to him","কাছে তার"],["ٱلْقَصَصَ","l-qaṣaṣa","the story","সব বৃত্তান্ত"],["قَالَ","qāla","he said","সে বললো"],["لَا","lā","(Do) not","\"না"],["تَخَفْ ۖ","takhaf","fear","ভয় করো"],["نَجَوْتَ","najawta","You have escaped","তুমি বেঁচে গিয়েছো"],["مِنَ","mina","from","হ'তে"],["ٱلْقَوْمِ","l-qawmi","the people ","সম্প্রদায়"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","সীমালঙ্ঘনকারী\""]],"t":"فَ<o>جَآ</>ءَتْهُ إِحْدَ<m>ىٰ</>هُمَا تَمْشِى عَلَى <h>ٱ</>سْتِحْ<o>يَآ</><k>ءٍۢ قَ</>الَتْ إِ<g>نَّ</> أَبِى يَ<q>دْ</>عُوكَ لِيَ<q>جْ</>زِيَكَ أَ<q>جْ</>رَ مَا سَقَيْتَ لَنَا ۚ فَلَ<g>مَّ</>ا <o>جَآ</>ءَهُ<m>ۥ</> وَقَصَّ عَلَيْهِ <h>ٱ</>لْقَصَصَ قَالَ لَا تَخَفْ ۖ نَجَوْتَ مِنَ <h>ٱ</>لْقَوْمِ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":26,"w":[["قَالَتْ","qālat","Said","বললো"],["إِحْدَىٰهُمَا","iḥ'dāhumā","one of them","একজন তাদের"],["يَـٰٓأَبَتِ","yāabati","O my father","\"হে আমার পিতা"],["ٱسْتَـْٔجِرْهُ ۖ","is'tajir'hu","Hire him","তাকে মজুর নিযুক্ত করুন"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["خَيْرَ","khayra","(the) best","(সেই) উত্তম"],["مَنِ","mani","whom","যাকে"],["ٱسْتَـْٔجَرْتَ","is'tajarta","you (can) hire","আপনি মজুর নিযুক্ত করবেন"],["ٱلْقَوِىُّ","l-qawiyu","(is) the strong","(যে) শক্তিশালী"],["ٱلْأَمِينُ","l-amīnu","the trustworthy","বিশ্বস্ত\""]],"t":"قَالَتْ إِحْدَ<m>ىٰ</>هُمَا <o>يَٰٓ</>أَبَتِ <h>ٱ</>سْتَـْٔجِرْهُ ۖ إِ<g>نَّ</> خَيْرَ مَنِ <h>ٱ</>سْتَـْٔجَرْتَ <h>ٱ</>لْقَوِىُّ <h>ٱ</>لْأَ<p>مِي</>نُ"},{"n":27,"w":[["قَالَ","qāla","He said","সে বললো"],["إِنِّىٓ","innī","Indeed, I","\"নিশ্চয়ই আমি"],["أُرِيدُ","urīdu","[I] wish","চাই"],["أَنْ","an","to","যে"],["أُنكِحَكَ","unkiḥaka","marry you to","তোমার সঙ্গে আমি বিয়ে দিবো"],["إِحْدَى","iḥ'dā","one","একজনকে"],["ٱبْنَتَىَّ","ib'natayya","(of) my daughters","আমার কন্যা দু'জনের"],["هَـٰتَيْنِ","hātayni","(of) these two","এই দু'য়ের"],["عَلَىٰٓ","‘alā","on","এ শর্তে"],["أَن","an","that","যে"],["تَأْجُرَنِى","tajuranī","you serve me","আমার কাজ করবে তুমি"],["ثَمَـٰنِىَ","thamāniya","(for) eight","আট"],["حِجَجٍۢ ۖ","ḥijajin","years","বছর"],["فَإِنْ","fa-in","but if","অতঃপর যদি"],["أَتْمَمْتَ","atmamta","you complete","তুমি পূর্ণ করো"],["عَشْرًۭا","‘ashran","ten","দশ (বছর)"],["فَمِنْ","famin","then from","তবে (তা হবে) হ'তে"],["عِندِكَ ۖ","‘indika","you","তোমার নিকট"],["وَمَآ","wamā","And not","আর না"],["أُرِيدُ","urīdu","I wish","আমি চাই"],["أَنْ","an","to","যে"],["أَشُقَّ","ashuqqa","make it difficult","কষ্ট দিবো"],["عَلَيْكَ ۚ","‘alayka","for you","উপর তোমার"],["سَتَجِدُنِىٓ","satajidunī","You will find me","অচিরেই তুমি পাবে আমাকে"],["إِن","in","if","যদি"],["شَآءَ","shāa","Allah wills","চান"],["ٱللَّهُ","l-lahu","Allah wills","আল্লাহ"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلصَّـٰلِحِينَ","l-ṣāliḥīna","the righteous","সৎকর্মশীলদের\""]],"t":"قَالَ إِ<g>نِّ</><o>ىٓ</> أُرِيدُ أَنْ أُ<k>نكِ</>حَكَ إِحْدَى <h>ٱ</><q>بْ</>نَتَىَّ <m>هَٰ</>تَيْنِ عَلَ<o>ىٰٓ</> أَ<k>ن تَ</>أْجُرَنِى ثَ<m>مَٰ</>نِىَ حِجَ<k>جٍۢ ۖ فَ</>إِنْ أَتْمَمْتَ عَشْ<k>رًۭا فَ</>مِنْ عِ<k>ندِ</>كَ ۖ وَ<o>مَآ</> أُرِيدُ أَنْ أَشُقَّ عَلَيْكَ ۚ سَتَجِدُ<o>نِىٓ</> إِ<k>ن شَ</><o>آ</>ءَ <h>ٱ</>للَّهُ مِنَ <h>ٱ</><l>ل</><m>صَّٰ</>لِ<p>حِي</>نَ"},{"n":28,"w":[["قَالَ","qāla","He said","(মূসা) বললো"],["ذَٰلِكَ","dhālika","That","\"এটা (চুক্তি)"],["بَيْنِى","baynī","(is) between me","মাঝে আমার"],["وَبَيْنَكَ ۖ","wabaynaka","and between you","ও মাঝে তোমার"],["أَيَّمَا","ayyamā","Whichever","যে কোনোটি"],["ٱلْأَجَلَيْنِ","l-ajalayni","(of) the two terms","দুই মেয়াদের"],["قَضَيْتُ","qaḍaytu","I complete","আমি পূর্ণ করবো"],["فَلَا","falā","then no","এরপর না (থাকবে)"],["عُدْوَٰنَ","‘ud'wāna","injustice","কোনো বাড়াবাড়ি"],["عَلَىَّ ۖ","‘alayya","to me","বিরুদ্ধে আমার"],["وَٱللَّهُ","wal-lahu","and Allah","এবং আল্লাহ"],["عَلَىٰ","‘alā","over","উপর"],["مَا","mā","what","যা"],["نَقُولُ","naqūlu","we say","আমরা বলছি"],["وَكِيلٌۭ","wakīlun","(is) a Witness","কর্মবিধায়ক\""]],"t":"قَالَ <m>ذَٰ</>لِكَ بَيْنِى وَبَيْنَكَ ۖ أَيَّمَا <h>ٱ</>لْأَجَلَيْنِ قَضَيْتُ فَلَا عُ<q>دْ</><m>وَٰ</>نَ عَلَىَّ ۖ وَ<h>ٱ</>للَّهُ عَلَىٰ مَا نَقُولُ وَ<p>كِي</>لٌۭ"},{"n":29,"w":[["۞ فَلَمَّا","falammā","Then when","অতঃপর যখন"],["قَضَىٰ","qaḍā","Musa fulfilled","পূর্ণ করলো"],["مُوسَى","mūsā","Musa fulfilled","মূসা"],["ٱلْأَجَلَ","l-ajala","the term","নির্দিষ্ট মেয়াদ"],["وَسَارَ","wasāra","and was traveling","ও যাত্রা করলো"],["بِأَهْلِهِۦٓ","bi-ahlihi","with his family","নিয়ে তার পরিবার"],["ءَانَسَ","ānasa","he saw","সে দেখলো"],["مِن","min","in","হ'তে"],["جَانِبِ","jānibi","(the) direction","দিক"],["ٱلطُّورِ","l-ṭūri","(of) Mount Tur","তুর পাহাড়ের"],["نَارًۭا","nāran","a fire","আগুন"],["قَالَ","qāla","He said","(তখন) সে বললো"],["لِأَهْلِهِ","li-ahlihi","to his family","উদ্দেশ্যে তার পরিবারের"],["ٱمْكُثُوٓا۟","um'kuthū","Stay here","\"তোমরা অপেক্ষা করো"],["إِنِّىٓ","innī","indeed, I","নিশ্চয়ই আমি"],["ءَانَسْتُ","ānastu","[I] perceive","আমি দেখেছি"],["نَارًۭا","nāran","a fire","আগুন"],["لَّعَلِّىٓ","la‘allī","Perhaps","সম্ভবতঃ আমি"],["ءَاتِيكُم","ātīkum","I will bring you","তোমাদের কাছে আমি আসবো"],["مِّنْهَا","min'hā","from there","হ'তে সেখান"],["بِخَبَرٍ","bikhabarin","some information","নিয়ে কোন তথ্য"],["أَوْ","aw","or","অথবা"],["جَذْوَةٍۢ","jadhwatin","a burning wood","জ্বলন্ত অঙ্গার"],["مِّنَ","mina","from","হ'তে"],["ٱلنَّارِ","l-nāri","the fire","আগুন"],["لَعَلَّكُمْ","la‘allakum","so that you may","যাতে তোমরা"],["تَصْطَلُونَ","taṣṭalūna","warm yourselves","আগুন পোহাতে পারো\""]],"t":"۞ فَلَ<g>مَّ</>ا قَضَىٰ مُوسَى <h>ٱ</>لْأَجَلَ وَسَارَ بِأَهْلِ<o>هِۦٓ</> ءَانَسَ مِ<k>ن جَ</>انِبِ <h>ٱ</><l>ل</>طُّورِ نَا<k>رًۭا قَ</>الَ لِأَهْلِهِ <h>ٱ</>مْكُ<o>ثُوٓ</><s>ا۟</> إِ<g>نِّ</><o>ىٓ</> ءَانَسْتُ نَا<w>رًۭا لَّ</>عَ<o>لِّىٓ</> ءَاتِي<y>كُم مِّ</>نْهَا بِخَبَرٍ أَوْ جَذْوَ<d>ةٍۢ مِّ</>نَ <h>ٱ</><l>ل</><g>نَّ</>ارِ لَعَلَّكُمْ تَصْطَ<p>لُو</>نَ"},{"n":30,"w":[["فَلَمَّآ","falammā","But when","অতঃপর যখন"],["أَتَىٰهَا","atāhā","he came (to) it","সেখানে আসলো"],["نُودِىَ","nūdiya","he was called","তাকে ডাকা হলো"],["مِن","min","from","হ'তে"],["شَـٰطِئِ","shāṭi-i","(the) side","প্রান্ত"],["ٱلْوَادِ","l-wādi","(of) the valley ","উপত্যকার"],["ٱلْأَيْمَنِ","l-aymani","the right","ডানদিকের"],["فِى","fī","in","উপর"],["ٱلْبُقْعَةِ","l-buq'‘ati","the place even","ভূখন্ডের"],["ٱلْمُبَـٰرَكَةِ","l-mubārakati","blessed","পবিত্র"],["مِنَ","mina","from","হ'তে"],["ٱلشَّجَرَةِ","l-shajarati","the tree","একটি গাছ"],["أَن","an","that","(এ বলে) যে"],["يَـٰمُوسَىٰٓ","yāmūsā","O Musa","\"হে মূসা"],["إِنِّىٓ","innī","Indeed","নিশ্চয়ই"],["أَنَا","anā","I Am","আমি"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["رَبُّ","rabbu","(the) Lord","রব"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","(of) the worlds","বিশ্বজগতের"]],"t":"فَلَ<g>مَّ</><o>آ</> أَتَ<m>ىٰ</>هَا نُودِىَ مِ<k>ن شَٰ</>طِئِ <h>ٱ</>لْوَادِ <h>ٱ</>لْأَيْمَنِ فِى <h>ٱ</>لْبُ<q>قْ</>عَةِ <h>ٱ</>لْمُ<m>بَٰ</>رَكَةِ مِنَ <h>ٱ</><l>ل</>شَّجَرَةِ <d>أَن يَٰ</>مُوسَ<o>ىٰٓ</> إِ<g>نِّ</><o>ىٓ</> أَنَا <h>ٱ</>للَّهُ رَبُّ <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":31,"w":[["وَأَنْ","wa-an","And [that]","এবং (বলা হলো) যে"],["أَلْقِ","alqi","throw","ছোঁড়ো"],["عَصَاكَ ۖ","‘aṣāka","your staff","তোমার লাঠিকে\""],["فَلَمَّا","falammā","But when","অতঃপর যখন"],["رَءَاهَا","raāhā","he saw it","সে দেখলো তা"],["تَهْتَزُّ","tahtazzu","moving","হামাগুড়ি দিয়ে চলছে"],["كَأَنَّهَا","ka-annahā","as if it","যেন তা"],["جَآنٌّۭ","jānnun","(were) a snake","সাপ"],["وَلَّىٰ","wallā","he turned","(তখন) সে ফিরে পালালো"],["مُدْبِرًۭا","mud'biran","(in) flight","পিছন দিকে"],["وَلَمْ","walam","and (did) not","এবং না"],["يُعَقِّبْ ۚ","yu‘aqqib","return","মুখ ফিরে দেখলো"],["يَـٰمُوسَىٰٓ","yāmūsā","O Musa","\"(বলা হলো) হে মূসা"],["أَقْبِلْ","aqbil","Draw near","সামনে এসো"],["وَلَا","walā","and (do) not","এবং না"],["تَخَفْ ۖ","takhaf","fear","ভয় করো"],["إِنَّكَ","innaka","Indeed, you","নিশ্চয়ই তুমি"],["مِنَ","mina","(are) of","অন্তর্ভুক্ত"],["ٱلْـَٔامِنِينَ","l-āminīna","the secure","নিরাপদদের"]],"t":"وَأَنْ أَلْقِ عَصَاكَ ۖ فَلَ<g>مَّ</>ا رَءَاهَا تَهْتَزُّ كَأَ<g>نَّ</>هَا <n>جَآ</><g>نٌّۭ</> وَلَّىٰ مُ<q>دْ</>بِ<d>رًۭا وَ</>لَمْ يُعَقِّ<q>بْ</> ۚ <m>يَٰ</>مُوسَ<o>ىٰٓ</> أَ<q>قْ</>بِلْ وَلَا تَخَفْ ۖ إِ<g>نَّ</>كَ مِنَ <h>ٱ</>لْءَامِ<p>نِي</>نَ"},{"n":32,"w":[["ٱسْلُكْ","us'luk","Insert","প্রবেশ করাও"],["يَدَكَ","yadaka","your hand","তোমার হাত"],["فِى","fī","in","মধ্যে"],["جَيْبِكَ","jaybika","your bosom","তোমার বগলের"],["تَخْرُجْ","takhruj","it will come forth","তা বের হবে"],["بَيْضَآءَ","bayḍāa","white","উজ্জ্বল হয়ে"],["مِنْ","min","without","কোনো"],["غَيْرِ","ghayri","without","ছাড়াই"],["سُوٓءٍۢ","sūin","any harm","দোষ"],["وَٱضْمُمْ","wa-uḍ'mum","And draw","এবং চেপে ধরো (মিলাও)"],["إِلَيْكَ","ilayka","to yourselves","উপর (দিকে) তোমার (বুকের)"],["جَنَاحَكَ","janāḥaka","your hand","তোমার হাত (বাঁচার জন্যে)"],["مِنَ","mina","against","কারণে"],["ٱلرَّهْبِ ۖ","l-rahbi","fear","ভয়ের"],["فَذَٰنِكَ","fadhānika","So these","অতএব এই দু'টো (হলো)"],["بُرْهَـٰنَانِ","bur'hānāni","(are) two evidences","দু'টো প্রমাণ"],["مِن","min","from","পক্ষ হ'তে"],["رَّبِّكَ","rabbika","your Lord","তোমার রবের"],["إِلَىٰ","ilā","to","প্রতি"],["فِرْعَوْنَ","fir'‘awna","Firaun","ফিরআউনের"],["وَمَلَإِي۟هِۦٓ ۚ","wamala-ihi","and his chiefs","ও তার সভাষদবর্গের (প্রতি)"],["إِنَّهُمْ","innahum","Indeed, they","নিশ্চয়ই তারা"],["كَانُوا۟","kānū","are","তারা ছিলো"],["قَوْمًۭا","qawman","a people","সম্প্রদায়"],["فَـٰسِقِينَ","fāsiqīna","defiantly disobedient","সত্যত্যাগী\""]],"t":"ٱسْلُكْ يَدَكَ فِى جَيْبِكَ تَخْرُ<q>جْ</> بَيْ<o>ضَآ</>ءَ مِنْ غَيْرِ <o>سُوٓ</><d>ءٍۢ وَ</><h>ٱ</>ضْمُمْ إِلَيْكَ جَنَاحَكَ مِنَ <h>ٱ</><l>ل</>رَّهْبِ ۖ فَ<m>ذَٰ</>نِكَ بُرْ<m>هَٰ</>نَانِ <w>مِن رَّ</>بِّكَ إِلَىٰ فِرْعَوْنَ وَمَلَإِ<s>ي۟</><o>هِۦٓ ۚ</> إِ<g>نَّ</>هُمْ كَانُو<s>ا۟</> قَوْ<k>مًۭا فَٰ</>سِ<p>قِي</>نَ"},{"n":33,"w":[["قَالَ","qāla","He said","সে বললো"],["رَبِّ","rabbi","My Lord","\"হে আমার রব"],["إِنِّى","innī","Indeed","নিশ্চয়ই আমি"],["قَتَلْتُ","qataltu","I killed","আমি হত্যা করেছি"],["مِنْهُمْ","min'hum","of them","মধ্য হ'তে তাদের"],["نَفْسًۭا","nafsan","a man","এক ব্যক্তিকে"],["فَأَخَافُ","fa-akhāfu","and I fear","অতএব আমি ভয় করি"],["أَن","an","that","যে"],["يَقْتُلُونِ","yaqtulūni","they will kill me","আমাকে তারা হত্যা করবে"]],"t":"قَالَ رَبِّ إِ<g>نِّ</>ى قَتَلْتُ مِنْهُمْ نَفْ<k>سًۭا فَ</>أَخَافُ <d>أَن يَ</><q>قْ</>تُ<p>لُو</>نِ"},{"n":34,"w":[["وَأَخِى","wa-akhī","And my brother","এবং আমার ভাই"],["هَـٰرُونُ","hārūnu","Harun","হারুন"],["هُوَ","huwa","he","সে"],["أَفْصَحُ","afṣaḥu","(is) more eloquent","অধিক বাকপটু"],["مِنِّى","minnī","than me","আমার চেয়ে"],["لِسَانًۭا","lisānan","(in) speech","ভাষায়"],["فَأَرْسِلْهُ","fa-arsil'hu","so send him","সুতরাং তাকে পাঠাও"],["مَعِىَ","ma‘iya","with me","আমার সাথে"],["رِدْءًۭا","rid'an","(as) a helper","সহায়ক হিসেবে"],["يُصَدِّقُنِىٓ ۖ","yuṣaddiqunī","who will confirm me","আমাকে সে সমর্থন করবে"],["إِنِّىٓ","innī","Indeed","নিশ্চয়ই আমি"],["أَخَافُ","akhāfu","I fear","আশংকা করি"],["أَن","an","that","যে"],["يُكَذِّبُونِ","yukadhibūni","they will deny me","আমাকে তারা মিথ্যাবাদী বলবে\""]],"t":"وَأَخِى <m>هَٰ</>رُونُ هُوَ أَفْصَحُ مِ<g>نِّ</>ى لِسَا<k>نًۭا فَ</>أَرْسِلْهُ مَعِىَ رِ<q>دْ</><d>ءًۭا يُ</>صَدِّقُ<o>نِىٓ ۖ</> إِ<g>نِّ</><o>ىٓ</> أَخَافُ <d>أَن يُ</>كَذِّ<p>بُو</>نِ"},{"n":35,"w":[["قَالَ","qāla","He said","আল্লাহ (বলেন)"],["سَنَشُدُّ","sanashuddu","We will strengthen","\"অচিরেই আমরা শক্ত করবো"],["عَضُدَكَ","‘aḍudaka","your arm","তোমার বাহুকে"],["بِأَخِيكَ","bi-akhīka","through your brother","দ্বারা তোমার ভাই"],["وَنَجْعَلُ","wanaj‘alu","and We will make","এবং আমরা দিবো"],["لَكُمَا","lakumā","for both of you","জন্যে তোমাদের দু'জনের"],["سُلْطَـٰنًۭا","sul'ṭānan","an authority","প্রাধান্য"],["فَلَا","falā","so not","সুতরাং না"],["يَصِلُونَ","yaṣilūna","they will reach","তারা পৌঁছুতে পারবে (কষ্ট দিতে)"],["إِلَيْكُمَا ۚ","ilaykumā","to both of you","নিকটে তোমাদের দু'জনের"],["بِـَٔايَـٰتِنَآ","biāyātinā","Through Our Signs","মাধ্যমে আমাদের নিদর্শনগুলোর"],["أَنتُمَا","antumā","you two","তোমরা দু'জন"],["وَمَنِ","wamani","and (those) who","এবং যারা"],["ٱتَّبَعَكُمَا","ittaba‘akumā","follow you","অনুসরণ করবে তোমাদের দু'জনকে"],["ٱلْغَـٰلِبُونَ","l-ghālibūna","(will) be the dominant","বিজয়ী হবে\""]],"t":"قَالَ سَنَشُدُّ عَضُدَكَ بِأَخِيكَ وَنَ<q>جْ</>عَلُ لَكُمَا سُلْ<m>طَٰ</><k>نًۭا فَ</>لَا يَصِلُونَ إِلَيْكُمَا ۚ بِـَٔا<m>يَٰ</>تِ<o>نَآ</> أَ<k>نتُ</>مَا وَمَنِ <h>ٱ</>تَّبَعَكُمَا <h>ٱ</>لْ<m>غَٰ</>لِ<p>بُو</>نَ"},{"n":36,"w":[["فَلَمَّا","falammā","But when","অতঃপর যখন"],["جَآءَهُم","jāahum","came to them","আসলো তাদের কাছে"],["مُّوسَىٰ","mūsā","Musa","মূসা"],["بِـَٔايَـٰتِنَا","biāyātinā","with Our Signs","নিয়ে আমাদের নিদর্শনাবলী"],["بَيِّنَـٰتٍۢ","bayyinātin","clear","সুস্পষ্ট"],["قَالُوا۟","qālū","they said","তারা বললো"],["مَا","mā","Not","\"নয়"],["هَـٰذَآ","hādhā","(is) this","এটা"],["إِلَّا","illā","except","এ ছাড়া যে"],["سِحْرٌۭ","siḥ'run","a magic","জাদু"],["مُّفْتَرًۭى","muf'taran","invented","অলীক"],["وَمَا","wamā","and not","এবং না"],["سَمِعْنَا","sami‘'nā","we heard","শুনেছি আমরা"],["بِهَـٰذَا","bihādhā","of this","সম্পর্কে এটা"],["فِىٓ","fī","among","মধ্যে (নিকট)"],["ءَابَآئِنَا","ābāinā","our forefathers","আমাদের পিতৃপুরুষদের\""],["ٱلْأَوَّلِينَ","l-awalīna","our forefathers","পূর্বেকার\""]],"t":"فَلَ<g>مَّ</>ا <o>جَآ</>ءَ<y>هُم مُّ</>وسَىٰ بِـَٔا<m>يَٰ</>تِنَا بَيِّ<m>نَٰ</><k>تٍۢ قَ</>الُو<s>ا۟</> مَا <m>هَٰ</><o>ذَآ</> إِلَّا سِحْ<d>رٌۭ مُّ</>فْتَ<d>رًۭى وَ</>مَا سَمِعْنَا بِ<m>هَٰ</>ذَا <o>فِىٓ</> ءَا<o>بَآ</>ئِنَا <h>ٱ</>لْأَوَّ<p>لِي</>نَ"},{"n":37,"w":[["وَقَالَ","waqāla","And Musa said","এবং বললো"],["مُوسَىٰ","mūsā","And Musa said","মূসা"],["رَبِّىٓ","rabbī","My Lord","\"আমার রব"],["أَعْلَمُ","a‘lamu","knows best","খুব ভাল জানেন"],["بِمَن","biman","of who","(তার) সম্পর্কে যে"],["جَآءَ","jāa","has come","এসেছে"],["بِٱلْهُدَىٰ","bil-hudā","with [the] guidance","নিয়ে পথ নির্দেশ"],["مِنْ","min","from Him","হ'তে"],["عِندِهِۦ","‘indihi","from Him","নিকট তাঁর"],["وَمَن","waman","and who ","এবং কে"],["تَكُونُ","takūnu","will be","(শুভ) হবে"],["لَهُۥ","lahu","for him","জন্যে তাঁর"],["عَـٰقِبَةُ","‘āqibatu","the good end in the Hereafter","পরিণাম"],["ٱلدَّارِ ۖ","l-dāri","the good end in the Hereafter","আখিরাতের"],["إِنَّهُۥ","innahu","Indeed","নিশ্চয়ই তা(এমন যে)"],["لَا","lā","not","না"],["يُفْلِحُ","yuf'liḥu","will be successful","সফলকাম হয়"],["ٱلظَّـٰلِمُونَ","l-ẓālimūna","the wrongdoers","সীমালঙ্ঘনকারীরা\""]],"t":"وَقَالَ مُوسَىٰ رَ<o>بِّىٓ</> أَعْلَمُ بِمَ<k>ن جَ</><o>آ</>ءَ بِ<h>ٱ</>لْهُدَىٰ مِنْ عِ<k>ندِ</><m>هِۦ</> وَمَ<k>ن تَ</>كُونُ لَهُ<m>ۥ عَٰ</>قِبَةُ <h>ٱ</><l>ل</>دَّارِ ۖ إِ<g>نَّ</>هُ<m>ۥ</> لَا يُفْلِحُ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مُو</>نَ"},{"n":38,"w":[["وَقَالَ","waqāla","And Firaun said","এবং বললো"],["فِرْعَوْنُ","fir'‘awnu","And Firaun said","ফেরআউন"],["يَـٰٓأَيُّهَا","yāayyuhā","O chiefs","\"হে"],["ٱلْمَلَأُ","l-mala-u","O chiefs","\"সভাষদবৃন্দ"],["مَا","mā","Not","না"],["عَلِمْتُ","‘alim'tu","I know","আমি জানি"],["لَكُم","lakum","for you","জন্যে তোমাদের"],["مِّنْ","min","any","কোনো"],["إِلَـٰهٍ","ilāhin","god","ইলাহ"],["غَيْرِى","ghayrī","other than me","আমি ছাড়া"],["فَأَوْقِدْ","fa-awqid","So kindle","সুতরাং জ্বালাও আগুন"],["لِى","lī","for me","জন্যে আমার"],["يَـٰهَـٰمَـٰنُ","yāhāmānu","O Haman","হে হামান"],["عَلَى","‘alā","Upon","উপর"],["ٱلطِّينِ","l-ṭīni","the clay","মাটির (অর্থাৎ ইট তৈরী করো)"],["فَٱجْعَل","fa-ij'‘al","and make","অতঃপর বানাও"],["لِّى","lī","for me","জন্যে আমার"],["صَرْحًۭا","ṣarḥan","a lofty tower","সুউচ্চ প্রাসাদ"],["لَّعَلِّىٓ","la‘allī","so that [I]","যাতে আমি"],["أَطَّلِعُ","aṭṭali‘u","I may look","আমি চড়ে দেখতে পারি"],["إِلَىٰٓ","ilā","at","প্রতি"],["إِلَـٰهِ","ilāhi","(the) God","ইলাহর"],["مُوسَىٰ","mūsā","(of) Musa","মূসার"],["وَإِنِّى","wa-innī","And indeed, I","এবং নিশ্চয়ই আমি"],["لَأَظُنُّهُۥ","la-aẓunnuhu","[I] think that he","অবশ্যই আমি মনে করি তাকে"],["مِنَ","mina","(is) of","অন্তর্ভুক্ত"],["ٱلْكَـٰذِبِينَ","l-kādhibīna","the liars","মিথ্যাবাদীদের\""]],"t":"وَقَالَ فِرْعَوْنُ <o>يَٰٓ</>أَيُّهَا <h>ٱ</>لْمَلَأُ مَا عَلِمْتُ لَ<y>كُم مِّ</>نْ إِ<m>لَٰ</>هٍ غَيْرِى فَأَوْقِ<q>دْ</> لِى <m>يَٰهَٰمَٰ</>نُ عَلَى <h>ٱ</><l>ل</>طِّينِ فَ<h>ٱ</><q>جْ</>عَل لِّى صَرْ<w>حًۭا لَّ</>عَ<o>لِّىٓ</> أَطَّلِعُ إِلَ<o>ىٰٓ</> إِ<m>لَٰ</>هِ مُوسَىٰ وَإِ<g>نِّ</>ى لَأَظُ<g>نُّ</>هُ<m>ۥ</> مِنَ <h>ٱ</>لْ<m>كَٰ</>ذِ<p>بِي</>نَ"},{"n":39,"w":[["وَٱسْتَكْبَرَ","wa-is'takbara","And he was arrogant","এবং সে অহংকার করলো"],["هُوَ","huwa","And he was arrogant","সে"],["وَجُنُودُهُۥ","wajunūduhu","and his hosts","ও তার সৈন্য বাহিনী"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the land","পৃথিবীর"],["بِغَيْرِ","bighayri","without","ছাড়া"],["ٱلْحَقِّ","l-ḥaqi","right","কোনো অধিকার"],["وَظَنُّوٓا۟","waẓannū","and they thought","এবং তারা মনে করেছিলো"],["أَنَّهُمْ","annahum","that they","যে তারা"],["إِلَيْنَا","ilaynā","to Us","দিকে আমাদের"],["لَا","lā","not","না"],["يُرْجَعُونَ","yur'ja‘ūna","will be returned","তারা প্রত্যাবর্তিত হবে"]],"t":"وَ<h>ٱ</>سْتَكْبَرَ هُوَ وَجُنُودُهُ<m>ۥ</> فِى <h>ٱ</>لْأَرْضِ بِغَيْرِ <h>ٱ</>لْحَقِّ وَظَ<g>نُّ</><o>وٓ</><s>ا۟</> أَ<g>نَّ</>هُمْ إِلَيْنَا لَا يُرْجَ<p>عُو</>نَ"},{"n":40,"w":[["فَأَخَذْنَـٰهُ","fa-akhadhnāhu","So We seized him","অতঃপর আমরা ধরলাম তাকে"],["وَجُنُودَهُۥ","wajunūdahu","and his hosts","ও তার সৈন্যবাহিনীকেও"],["فَنَبَذْنَـٰهُمْ","fanabadhnāhum","and We threw them","অতঃপর আমরা নিক্ষেপ করলাম তাদেরকে"],["فِى","fī","in","মধ্যে"],["ٱلْيَمِّ ۖ","l-yami","the sea","সমুদ্রের"],["فَٱنظُرْ","fa-unẓur","So see","এখন দেখো"],["كَيْفَ","kayfa","how","কেমন"],["كَانَ","kāna","was","হয়েছিলো"],["عَـٰقِبَةُ","‘āqibatu","(the) end","পরিণাম"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","(of) the wrongdoers","সীমালঙ্ঘনকারীদের"]],"t":"فَأَخَذْ<m>نَٰ</>هُ وَجُنُودَهُ<m>ۥ</> فَنَبَذْ<m>نَٰ</>هُمْ فِى <h>ٱ</>لْيَ<g>مِّ</> ۖ فَ<h>ٱ</><k>نظُ</>رْ كَيْفَ كَانَ <m>عَٰ</>قِبَةُ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":41,"w":[["وَجَعَلْنَـٰهُمْ","waja‘alnāhum","And We made them","আমরা বানিয়েছিলাম তাদেরকে"],["أَئِمَّةًۭ","a-immatan","leaders","নেতৃবৃন্দ (অথচ)"],["يَدْعُونَ","yad‘ūna","inviting","তারা ডাকে (লোকদেরকে)"],["إِلَى","ilā","to","দিকে"],["ٱلنَّارِ ۖ","l-nāri","the Fire","জাহান্নামের"],["وَيَوْمَ","wayawma","and (on the) Day","এবং দিনে"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) the Resurrection","ক্বিয়ামাতের"],["لَا","lā","not","না"],["يُنصَرُونَ","yunṣarūna","they will be helped","তাদের সাহায্য করা হবে"]],"t":"وَجَعَلْ<m>نَٰ</>هُمْ أَئِ<g>مَّ</><d>ةًۭ يَ</><q>دْ</>عُونَ إِلَى <h>ٱ</><l>ل</><g>نَّ</>ارِ ۖ وَيَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ لَا يُ<k>نصَ</><p>رُو</>نَ"},{"n":42,"w":[["وَأَتْبَعْنَـٰهُمْ","wa-atba‘nāhum","And We caused to follow them","এবং আমরা লাগিয়ে দিয়েছি পিছনে তাদের"],["فِى","fī","in","মধ্যে"],["هَـٰذِهِ","hādhihi","this","এই"],["ٱلدُّنْيَا","l-dun'yā","world","দুনিয়ার"],["لَعْنَةًۭ ۖ","la‘natan","a curse","অভিশাপ"],["وَيَوْمَ","wayawma","and (on the) Day","এবং দিনে"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) the Resurrection","ক্বিয়ামাতের"],["هُم","hum","they","তারা (হবে)"],["مِّنَ","mina","(will be) of","অন্তর্ভুক্ত"],["ٱلْمَقْبُوحِينَ","l-maqbūḥīna","the despised","ঘৃণিতদের"]],"t":"وَأَتْبَعْ<m>نَٰ</>هُمْ فِى <m>هَٰ</>ذِهِ <h>ٱ</><l>ل</>دُّنْيَا لَعْنَ<d>ةًۭ ۖ وَ</>يَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ <y>هُم مِّ</>نَ <h>ٱ</>لْمَ<q>قْ</>بُو<p>حِي</>نَ"},{"n":43,"w":[["وَلَقَدْ","walaqad","And verily","এবং নিশ্চয়ই"],["ءَاتَيْنَا","ātaynā","We gave","আমরা দিয়েছি"],["مُوسَى","mūsā","Musa","মূসাকে"],["ٱلْكِتَـٰبَ","l-kitāba","the Scripture","কিতাব"],["مِنۢ","min","after [what]","থেকে"],["بَعْدِ","ba‘di","after [what]","পর"],["مَآ","mā","after [what]","যখন"],["أَهْلَكْنَا","ahlaknā","We had destroyed","ধ্বংস করে দিয়েছি আমরা"],["ٱلْقُرُونَ","l-qurūna","the generations","বহুমানবগোষ্ঠীকে"],["ٱلْأُولَىٰ","l-ūlā","former","পুর্ববর্তী"],["بَصَآئِرَ","baṣāira","(as) an enlightenment","জ্ঞান-বর্তিকাস্বরুপ"],["لِلنَّاسِ","lilnnāsi","for the mankind","জন্যে মানুষের"],["وَهُدًۭى","wahudan","and a guidance","এবং পথ নির্দেশ"],["وَرَحْمَةًۭ","waraḥmatan","and mercy","ও দয়া হিসেবে"],["لَّعَلَّهُمْ","la‘allahum","that they may","যাতে তারা"],["يَتَذَكَّرُونَ","yatadhakkarūna","remember","শিক্ষাগ্রহণ করে"]],"t":"وَلَقَ<q>دْ</> ءَاتَيْنَا مُوسَى <h>ٱ</>لْكِ<m>تَٰ</>بَ <i>مِنۢ بَ</>عْدِ <o>مَآ</> أَهْلَكْنَا <h>ٱ</>لْقُرُونَ <h>ٱ</>لْأُولَىٰ بَ<o>صَآ</>ئِرَ لِل<g>نَّ</>اسِ وَهُ<d>دًۭى وَ</>رَحْمَ<w>ةًۭ لَّ</>عَلَّهُمْ يَتَذَكَّ<p>رُو</>نَ"},{"n":44,"w":[["وَمَا","wamā","And not","আর (হে নাবী) না"],["كُنتَ","kunta","you were","তুমি ছিলে"],["بِجَانِبِ","bijānibi","on (the) side","পাশে"],["ٱلْغَرْبِىِّ","l-gharbiyi","western","(তুর পাহাড়ের)পশ্চিম"],["إِذْ","idh","when","যখন"],["قَضَيْنَآ","qaḍaynā","We decreed","দান করেছিলাম আমরা"],["إِلَىٰ","ilā","to","প্রতি"],["مُوسَى","mūsā","Musa","মূসার"],["ٱلْأَمْرَ","l-amra","the Commandment","বিধান"],["وَمَا","wamā","and not","আর না"],["كُنتَ","kunta","you were","তুমি ছিলে"],["مِنَ","mina","among","অন্তর্ভুক্ত"],["ٱلشَّـٰهِدِينَ","l-shāhidīna","the witnesses","প্রত্যক্ষদর্শীদের"]],"t":"وَمَا كُ<k>نتَ</> بِجَانِبِ <h>ٱ</>لْغَرْبِىِّ إِذْ قَضَيْ<o>نَآ</> إِلَىٰ مُوسَى <h>ٱ</>لْأَمْرَ وَمَا كُ<k>نتَ</> مِنَ <h>ٱ</><l>ل</><m>شَّٰ</>هِ<p>دِي</>نَ"},{"n":45,"w":[["وَلَـٰكِنَّآ","walākinnā","But We","কিন্তু আমরা"],["أَنشَأْنَا","anshanā","[We] produced","সৃষ্টি করেছি আমরা"],["قُرُونًۭا","qurūnan","generations","বহু মানবগোষ্ঠী"],["فَتَطَاوَلَ","fataṭāwala","and prolonged","অতঃপর দীর্ঘায়িত হয়েছে"],["عَلَيْهِمُ","‘alayhimu","for them","উপর তাদের"],["ٱلْعُمُرُ ۚ","l-‘umuru","the life","(বহু) যুগ"],["وَمَا","wamā","And not","আর না"],["كُنتَ","kunta","you were","তুমি ছিলে"],["ثَاوِيًۭا","thāwiyan","a dweller","বিদ্যমান"],["فِىٓ","fī","among","মধ্যে"],["أَهْلِ","ahli","(the) people","বাসীদের"],["مَدْيَنَ","madyana","(of) Madyan","মাদয়ান"],["تَتْلُوا۟","tatlū","reciting","তুমি তিলাওয়াত করো (যেন)"],["عَلَيْهِمْ","‘alayhim","to them","কাছে তাদের"],["ءَايَـٰتِنَا","āyātinā","Our Verses","আয়াতসমূহ আমাদের"],["وَلَـٰكِنَّا","walākinnā","but We","কিন্তু আমরা"],["كُنَّا","kunnā","[We] were","আমরা ছিলাম"],["مُرْسِلِينَ","mur'silīna","the Senders","(রাসূল) প্রেরণকারী"]],"t":"وَ<m>لَٰ</>كِ<g>نَّ</><o>آ</> أَ<k>نشَ</>أْنَا قُرُو<k>نًۭا فَ</>تَطَاوَلَ عَلَيْهِمُ <h>ٱ</>لْعُمُرُ ۚ وَمَا كُ<k>نتَ</> ثَاوِ<k>يًۭا فِ</><o>ىٓ</> أَهْلِ مَ<q>دْ</>يَنَ تَتْلُو<s>ا۟</> عَلَيْهِمْ ءَا<m>يَٰ</>تِنَا وَ<m>لَٰ</>كِ<g>نَّ</>ا كُ<g>نَّ</>ا مُرْسِ<p>لِي</>نَ"},{"n":46,"w":[["وَمَا","wamā","And not","আর না"],["كُنتَ","kunta","you were","তুমি ছিলে"],["بِجَانِبِ","bijānibi","at (the) side","পাশে"],["ٱلطُّورِ","l-ṭūri","(of) the Tur","তুর পাহাড়ের"],["إِذْ","idh","when","যখন"],["نَادَيْنَا","nādaynā","We called","ডেকে ছিলাম আমরা"],["وَلَـٰكِن","walākin","But","কিন্তু"],["رَّحْمَةًۭ","raḥmatan","(as) a mercy","এটা (অনুগ্রহ)"],["مِّن","min","from","পক্ষ হতে"],["رَّبِّكَ","rabbika","your Lord","তোমার রবের"],["لِتُنذِرَ","litundhira","so that you warn","যেন তুমি সতর্ক করো"],["قَوْمًۭا","qawman","a people","সম্প্রদায়কে"],["مَّآ","mā","not","না"],["أَتَىٰهُم","atāhum","(had) come to them","যাদের (নিকট) এসেছে"],["مِّن","min","any","কোনো"],["نَّذِيرٍۢ","nadhīrin","warner","সতর্ককারী"],["مِّن","min","before you","থেকে"],["قَبْلِكَ","qablika","before you","তোমার পূর্ব"],["لَعَلَّهُمْ","la‘allahum","so that they may","যাতে তারা"],["يَتَذَكَّرُونَ","yatadhakkarūna","remember","উপদেশ গ্রহণ করে"]],"t":"وَمَا كُ<k>نتَ</> بِجَانِبِ <h>ٱ</><l>ل</>طُّورِ إِذْ نَادَيْنَا وَ<m>لَٰ</><w>كِن رَّ</>حْمَ<d>ةًۭ مِّ</><w>ن رَّ</>بِّكَ لِتُ<k>نذِ</>رَ قَوْ<d>مًۭا مَّ</><o>آ</> أَتَ<m>ىٰ</><y>هُم مِّ</><d>ن نَّ</>ذِي<d>رٍۢ مِّ</><k>ن قَ</><q>بْ</>لِكَ لَعَلَّهُمْ يَتَذَكَّ<p>رُو</>نَ"},{"n":47,"w":[["وَلَوْلَآ","walawlā","And if not","আর যদি না"],["أَن","an","[that]","(হতো) যে"],["تُصِيبَهُم","tuṣībahum","struck them","তাদের (উপর) পড়তো"],["مُّصِيبَةٌۢ","muṣībatun","a disaster","কোনো বিপদ"],["بِمَا","bimā","for what","এ কারণে যা"],["قَدَّمَتْ","qaddamat","had sent forth","আগে পাঠিয়েছে"],["أَيْدِيهِمْ","aydīhim","their hands","হাতগুলো তাদের"],["فَيَقُولُوا۟","fayaqūlū","and they would say","তখন তারা বলতো"],["رَبَّنَا","rabbanā","Our Lord","\"হে আমাদের রব"],["لَوْلَآ","lawlā","Why not","কেন না"],["أَرْسَلْتَ","arsalta","You sent","তুমি পাঠালে"],["إِلَيْنَا","ilaynā","to us","প্রতি আমাদের"],["رَسُولًۭا","rasūlan","a Messenger","কোনো রাসূলকে"],["فَنَتَّبِعَ","fanattabi‘a","so we (could have) followed","তাহ'লে আমরা অনুসরণ করতাম"],["ءَايَـٰتِكَ","āyātika","Your Verses","তোমার আয়াতসমূহের"],["وَنَكُونَ","wanakūna","and we (would) have been","এবং হতাম আমরা"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believers","মু'মিনদের\""]],"t":"وَلَوْ<o>لَآ</> أَ<k>ن تُ</>صِيبَ<y>هُم مُّ</>صِيبَ<i>ةٌۢ بِ</>مَا قَدَّمَتْ أَيْدِيهِمْ فَيَقُولُو<s>ا۟</> رَبَّنَا لَوْ<o>لَآ</> أَرْسَلْتَ إِلَيْنَا رَسُولًۭ<k>ا فَ</>نَتَّبِعَ ءَا<m>يَٰ</>تِكَ وَنَكُونَ مِنَ <h>ٱ</>لْمُؤْمِ<p>نِي</>نَ"},{"n":48,"w":[["فَلَمَّا","falammā","But when","অতঃপর যখন"],["جَآءَهُمُ","jāahumu","came to them","আসলো তাদের (কাছে)"],["ٱلْحَقُّ","l-ḥaqu","the truth","সত্য"],["مِنْ","min","from Us","হ'তে"],["عِندِنَا","‘indinā","from Us","নিকট আমাদের"],["قَالُوا۟","qālū","they said","তারা বলে"],["لَوْلَآ","lawlā","Why not","\"কেন না"],["أُوتِىَ","ūtiya","he was given","তাকে দেয়া হয়েছে"],["مِثْلَ","mith'la","(the) like","(তার) মতো"],["مَآ","mā","(of) what","যেমন"],["أُوتِىَ","ūtiya","was given","দেয়া হয়েছে"],["مُوسَىٰٓ ۚ","mūsā","(to) Musa","মূসাকে\""],["أَوَلَمْ","awalam","Did not","কি নি"],["يَكْفُرُوا۟","yakfurū","they disbelieve","তারা অস্বীকার করে"],["بِمَآ","bimā","in what","ঐ বিষয়ে যা"],["أُوتِىَ","ūtiya","was given","দেয়া হয়েছিলো"],["مُوسَىٰ","mūsā","(to) Musa","মূসাকে"],["مِن","min","before","থেকে"],["قَبْلُ ۖ","qablu","before","পূর্ব"],["قَالُوا۟","qālū","They said","তারা বললো"],["سِحْرَانِ","siḥ'rāni","Two magic (works)","\"(ক্বুর'আন ও তাওরাত) এ দু'টিই জ্দু"],["تَظَـٰهَرَا","taẓāharā","supporting each other","পরস্পরে সমর্থন করে\""],["وَقَالُوٓا۟","waqālū","And they said","আরও তারা বললো"],["إِنَّا","innā","Indeed, we","\"নিশ্চয়ই আমরা"],["بِكُلٍّۢ","bikullin","in all","প্রতি প্রত্যেকটির"],["كَـٰفِرُونَ","kāfirūna","(are) disbelievers","অস্বীকারকারী\""]],"t":"فَلَ<g>مَّ</>ا <o>جَآ</>ءَهُمُ <h>ٱ</>لْحَقُّ مِنْ عِ<k>ندِ</>نَا قَالُو<s>ا۟</> لَوْ<o>لَآ</> أُوتِىَ مِثْلَ <o>مَآ</> أُوتِىَ مُوسَ<o>ىٰٓ ۚ</> أَوَلَمْ يَكْفُرُو<s>ا۟</> بِ<o>مَآ</> أُوتِىَ مُوسَىٰ مِ<k>ن قَ</><q>بْ</>لُ ۖ قَالُو<s>ا۟</> سِحْرَانِ تَ<m>ظَٰ</>هَرَا وَقَا<o>لُوٓ</><s>ا۟</> إِ<g>نَّ</>ا بِكُ<k>لٍّۢ كَٰ</>فِ<p>رُو</>نَ"},{"n":49,"w":[["قُلْ","qul","Say","বলো"],["فَأْتُوا۟","fatū","Then bring","\"তাহ'লে তোমরা আসো"],["بِكِتَـٰبٍۢ","bikitābin","a Book","নিয়ে কোন কিতাব"],["مِّنْ","min","from Allah","হ'তে"],["عِندِ","‘indi","from Allah","নিকট"],["ٱللَّهِ","l-lahi","from Allah","আল্লাহর"],["هُوَ","huwa","which","(যেন) তা (হয়)"],["أَهْدَىٰ","ahdā","(is) a better guide","পথপ্রদর্শনে উৎকৃষ্টতর"],["مِنْهُمَآ","min'humā","than both of them","সে দু'টির চেয়ে"],["أَتَّبِعْهُ","attabi‘'hu","that I may follow it","আমিই অনুসরণ করবো তা"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you are","তোমরা হও"],["صَـٰدِقِينَ","ṣādiqīna","truthful","সত্যবাদী\""]],"t":"قُلْ فَأْتُو<s>ا۟</> بِكِ<m>تَٰ</><d>بٍۢ مِّ</>نْ عِ<k>ندِ</> <h>ٱ</>للَّهِ هُوَ أَهْدَىٰ مِنْهُ<o>مَآ</> أَتَّبِعْهُ إِ<k>ن كُنتُ</>مْ <m>صَٰ</>دِ<p>قِي</>نَ"},{"n":50,"w":[["فَإِن","fa-in","But if","অতঃপর যদি"],["لَّمْ","lam","not","না"],["يَسْتَجِيبُوا۟","yastajībū","they respond","তারা সাড়া দেয়"],["لَكَ","laka","to you","প্রতি তোমার (ডাকে)"],["فَٱعْلَمْ","fa-i‘'lam","then know","তবে জেনে রাখো"],["أَنَّمَا","annamā","that only","কেবল"],["يَتَّبِعُونَ","yattabi‘ūna","they follow","তারা অনুসরণ করছে"],["أَهْوَآءَهُمْ ۚ","ahwāahum","their desires","খেয়ালখুশিগুলোর তাদের"],["وَمَنْ","waman","And who","আর কে (আছে)"],["أَضَلُّ","aḍallu","(is) more astray","অধিক বিভ্রান্ত"],["مِمَّنِ","mimmani","than (one) who","(তার) চেয়ে যে"],["ٱتَّبَعَ","ittaba‘a","follows","অনুসরণ করে"],["هَوَىٰهُ","hawāhu","his own desire","খেয়ালখুশির তার"],["بِغَيْرِ","bighayri","without","ঝাড়া"],["هُدًۭى","hudan","guidance","কোনো পথনির্দেশ"],["مِّنَ","mina","from","হ'তে"],["ٱللَّهِ ۚ","l-lahi","Allah","আল্লাহ"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَا","lā","(does) not","না"],["يَهْدِى","yahdī","guide","সৎপথ দেখান"],["ٱلْقَوْمَ","l-qawma","the people ","সম্প্রদায়কে"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","(যারা)সীমালঙ্ঘনকারী"]],"t":"فَ<w>إِن لَّ</>مْ يَسْتَجِيبُو<s>ا۟</> لَكَ فَ<h>ٱ</>عْلَمْ أَ<g>نَّ</>مَا يَتَّبِعُونَ أَهْ<o>وَآ</>ءَهُمْ ۚ وَمَنْ أَضَلُّ مِ<g>مَّ</>نِ <h>ٱ</>تَّبَعَ هَوَ<m>ىٰ</>هُ بِغَيْرِ هُ<d>دًۭى مِّ</>نَ <h>ٱ</>للَّهِ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ لَا يَهْدِى <h>ٱ</>لْقَوْمَ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":51,"w":[["۞ وَلَقَدْ","walaqad","And indeed","এবং নিশ্চয়ই"],["وَصَّلْنَا","waṣṣalnā","We have conveyed","আমরা বারবার পাঠিয়েছি"],["لَهُمُ","lahumu","to them","জন্যে তাদের"],["ٱلْقَوْلَ","l-qawla","the Word","(হেদায়াতের) বাণী"],["لَعَلَّهُمْ","la‘allahum","so that they may","যাতে তারা"],["يَتَذَكَّرُونَ","yatadhakkarūna","remember","উপদেশ গ্রহন করে"]],"t":"۞ وَلَقَ<q>دْ</> وَصَّلْنَا لَهُمُ <h>ٱ</>لْقَوْلَ لَعَلَّهُمْ يَتَذَكَّ<p>رُو</>نَ"},{"n":52,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা (অর্থাৎ আহলে কিতাবদেরকে)"],["ءَاتَيْنَـٰهُمُ","ātaynāhumu","We gave them","আমরা দান করেছি তাদেরকে"],["ٱلْكِتَـٰبَ","l-kitāba","the Scripture","কিতাব"],["مِن","min","before it","থেকে"],["قَبْلِهِۦ","qablihi","before it","এর (অর্থাৎ কোরআনের) পূর্ব"],["هُم","hum","they","তারা"],["بِهِۦ","bihi","in it","উপর এর"],["يُؤْمِنُونَ","yu'minūna","believe","ঈমান আনে"]],"t":"ٱلَّذِينَ ءَاتَيْ<m>نَٰ</>هُمُ <h>ٱ</>لْكِ<m>تَٰ</>بَ مِ<k>ن قَ</><q>بْ</>لِ<m>هِۦ</> <f>هُم بِ</><m>هِۦ</> يُؤْمِ<p>نُو</>نَ"},{"n":53,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["يُتْلَىٰ","yut'lā","it is recited","তিলাওয়াত করা হয়"],["عَلَيْهِمْ","‘alayhim","to them","নিকট তাদের"],["قَالُوٓا۟","qālū","they say","তারা বলে"],["ءَامَنَّا","āmannā","We believe","\"আমরা ঈমান এনেছি"],["بِهِۦٓ","bihi","in it","উপর এর"],["إِنَّهُ","innahu","Indeed, it","নিশ্চয়ই তা"],["ٱلْحَقُّ","l-ḥaqu","(is) the truth","সত্য"],["مِن","min","from","পক্ষ হ'তে"],["رَّبِّنَآ","rabbinā","our Lord","আমাদের রবের"],["إِنَّا","innā","Indeed, we","নিশ্চয়ই আমরা"],["كُنَّا","kunnā","[we] were","ছিলাম"],["مِن","min","before it","থেকে"],["قَبْلِهِۦ","qablihi","before it","পূর্ব এর"],["مُسْلِمِينَ","mus'limīna","Muslims","মুসলমান\""]],"t":"وَإِذَا يُتْلَىٰ عَلَيْهِمْ قَا<o>لُوٓ</><s>ا۟</> ءَامَ<g>نَّ</>ا بِ<o>هِۦٓ</> إِ<g>نَّ</>هُ <h>ٱ</>لْحَقُّ <w>مِن رَّ</>بِّ<o>نَآ</> إِ<g>نَّ</>ا كُ<g>نَّ</>ا مِ<k>ن قَ</><q>بْ</>لِ<m>هِۦ</> مُسْلِ<p>مِي</>نَ"},{"n":54,"w":[["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব (লোকদেরকে)"],["يُؤْتَوْنَ","yu'tawna","will be given","দেয়া হবে"],["أَجْرَهُم","ajrahum","their reward","প্রতিফল তাদের"],["مَّرَّتَيْنِ","marratayni","twice","দু'বার"],["بِمَا","bimā","because","এ কারণে যা"],["صَبَرُوا۟","ṣabarū","they are patient","তারা ধৈর্য ধরেছে"],["وَيَدْرَءُونَ","wayadraūna","and they repel","ও তারা প্রতিরোধ করে"],["بِٱلْحَسَنَةِ","bil-ḥasanati","with good ","দিয়ে ভালো"],["ٱلسَّيِّئَةَ","l-sayi-ata","the evil","মন্দকে"],["وَمِمَّا","wamimmā","and from what","এবং (তা) হ'তে যা"],["رَزَقْنَـٰهُمْ","razaqnāhum","We have provided them","আমরা জীবিকা দিয়েছি তাদেরকে"],["يُنفِقُونَ","yunfiqūna","they spend","তারা ব্যয় করে"]],"t":"أُ<s>و۟</><o>لَٰٓ</>ئِكَ يُؤْتَوْنَ أَ<q>جْ</>رَ<y>هُم مَّ</>رَّتَيْنِ بِمَا صَبَرُو<s>ا۟</> وَيَ<q>دْ</>رَءُونَ بِ<h>ٱ</>لْحَسَنَةِ <h>ٱ</><l>ل</>سَّيِّئَةَ وَمِ<g>مَّ</>ا رَزَ<q>قْ</><m>نَٰ</>هُمْ يُ<k>نفِ</><p>قُو</>نَ"},{"n":55,"w":[["وَإِذَا","wa-idhā","And when","যখন"],["سَمِعُوا۟","sami‘ū","they hear","তারা শুনে"],["ٱللَّغْوَ","l-laghwa","vain talk","অসার (উক্তি)"],["أَعْرَضُوا۟","a‘raḍū","they turn away","তারা মুখ ফিরিয়ে নেয়"],["عَنْهُ","‘anhu","from it","হ'তে তা"],["وَقَالُوا۟","waqālū","and say","এবং তারা বলে"],["لَنَآ","lanā","For us","\"জন্যে (রয়েছে) আমাদের"],["أَعْمَـٰلُنَا","a‘mālunā","our deeds","কর্মসমূহ আমাদের"],["وَلَكُمْ","walakum","and for you","আর জন্যে (রয়েছে) তোমাদের"],["أَعْمَـٰلُكُمْ","a‘mālukum","your deeds","কর্মসমূহ তোমাদের"],["سَلَـٰمٌ","salāmun","Peace (be)","সালাম'"],["عَلَيْكُمْ","‘alaykum","on you","উপর তোমাদের"],["لَا","lā","not","না"],["نَبْتَغِى","nabtaghī","we seek","চাই আমরা"],["ٱلْجَـٰهِلِينَ","l-jāhilīna","the ignorant","অজ্ঞদের (মতো পথ)\""]],"t":"وَإِذَا سَمِعُو<s>ا۟</> <h>ٱ</><l>ل</>لَّغْوَ أَعْرَضُو<s>ا۟</> عَنْهُ وَقَالُو<s>ا۟</> لَ<o>نَآ</> أَعْ<m>مَٰ</>لُنَا وَلَكُمْ أَعْ<m>مَٰ</>لُكُمْ سَ<m>لَٰ</>مٌ عَلَيْكُمْ لَا نَ<q>بْ</>تَغِى <h>ٱ</>لْ<m>جَٰ</>هِ<p>لِي</>نَ"},{"n":56,"w":[["إِنَّكَ","innaka","Indeed, you","(হে নাবী) তুমি নিশ্চয়ই"],["لَا","lā","(can) not","না"],["تَهْدِى","tahdī","guide","পথ দেখাতে পারো"],["مَنْ","man","whom","যাকে"],["أَحْبَبْتَ","aḥbabta","you love","তুমি ভালবাসো"],["وَلَـٰكِنَّ","walākinna","but","কিন্তু"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يَهْدِى","yahdī","guides","সৎপথ দেখান"],["مَن","man","whom","যাকে"],["يَشَآءُ ۚ","yashāu","He wills","ইচ্ছে করেন"],["وَهُوَ","wahuwa","And He","এবং তিনিই"],["أَعْلَمُ","a‘lamu","(is) most knowing","খুব জানেন"],["بِٱلْمُهْتَدِينَ","bil-muh'tadīna","(of) the guided ones","সম্পর্কে সৎপথপ্রাপ্তদের"]],"t":"إِ<g>نَّ</>كَ لَا تَهْدِى مَنْ أَحْبَ<q>بْ</>تَ وَ<m>لَٰ</>كِ<g>نَّ</> <h>ٱ</>للَّهَ يَهْدِى <d>مَن يَ</><o>شَآ</>ءُ ۚ وَهُوَ أَعْلَمُ بِ<h>ٱ</>لْمُهْتَ<p>دِي</>نَ"},{"n":57,"w":[["وَقَالُوٓا۟","waqālū","And they say","এবং তারা বলে"],["إِن","in","If","\"যদি"],["نَّتَّبِعِ","nattabi‘i","we follow","আমরা অনুসরণ করি"],["ٱلْهُدَىٰ","l-hudā","the guidance","সৎপথের"],["مَعَكَ","ma‘aka","with you","তোমার সাথে"],["نُتَخَطَّفْ","nutakhaṭṭaf","we would be swept","আমাদেরকে উৎখাত করা হবে"],["مِنْ","min","from","হ'তে"],["أَرْضِنَآ ۚ","arḍinā","our land","আমাদের দেশ\""],["أَوَلَمْ","awalam","Have not","করি  নি কি"],["نُمَكِّن","numakkin","We established","আমরা প্রতিষ্ঠা"],["لَّهُمْ","lahum","for them","জন্যে তাদের"],["حَرَمًا","ḥaraman","a sanctuary","হারাম"],["ءَامِنًۭا","āminan","secure","শান্তিপূর্ণ"],["يُجْبَىٰٓ","yuj'bā","are brought","আনা হয়"],["إِلَيْهِ","ilayhi","to it","দিকে তার"],["ثَمَرَٰتُ","thamarātu","fruits","ফল-মূলসমূহ"],["كُلِّ","kulli","(of) all","প্রত্যেক"],["شَىْءٍۢ","shayin","things","রকমের"],["رِّزْقًۭا","riz'qan","a provision","জীবনের উপকরণ হিসেবে"],["مِّن","min","from","হ'তে"],["لَّدُنَّا","ladunnā","Us","আমাদের পক্ষ"],["وَلَـٰكِنَّ","walākinna","But","কিন্তু"],["أَكْثَرَهُمْ","aktharahum","most of them","অধিকাংশই তাদের"],["لَا","lā","(do) not","না"],["يَعْلَمُونَ","ya‘lamūna","know","জানে"]],"t":"وَقَا<o>لُوٓ</><s>ا۟</> <d>إِن نَّ</>تَّبِعِ <h>ٱ</>لْهُدَىٰ مَعَكَ نُتَخَطَّفْ مِنْ أَرْضِ<o>نَآ ۚ</> أَوَلَمْ نُمَ<w>كِّن لَّ</>هُمْ حَرَمًا ءَامِ<d>نًۭا يُ</><q>جْ</>بَ<o>ىٰٓ</> إِلَيْهِ ثَمَ<m>رَٰ</>تُ كُلِّ <w>شَىْءٍۢ رِّ</>زْ<d>قًۭا مِّ</><w>ن لَّ</>دُ<g>نَّ</>ا وَ<m>لَٰ</>كِ<g>نَّ</> أَكْثَرَهُمْ لَا يَعْلَ<p>مُو</>نَ"},{"n":58,"w":[["وَكَمْ","wakam","And how many","আর কতই না"],["أَهْلَكْنَا","ahlaknā","We have destroyed","ধ্বংস করেছি আমরা"],["مِن","min","of","থেকে"],["قَرْيَةٍۭ","qaryatin","a town","জনপদ"],["بَطِرَتْ","baṭirat","which exulted","অহংকার করতো (তার অধিবাসীরা)"],["مَعِيشَتَهَا ۖ","ma‘īshatahā","(in) its means of livelihood","তাদের জীবিকার"],["فَتِلْكَ","fatil'ka","And these","অতঃপর ঐ"],["مَسَـٰكِنُهُمْ","masākinuhum","(are) their dwellings","ঘরবাড়িসমূহ তাদের"],["لَمْ","lam","not","নি"],["تُسْكَن","tus'kan","have been inhabited","বসবাস করে"],["مِّنۢ","min","after them","থেকে"],["بَعْدِهِمْ","ba‘dihim","after them","পর তাদের"],["إِلَّا","illā","except","ছাড়া"],["قَلِيلًۭا ۖ","qalīlan","a little","অতি অল্প"],["وَكُنَّا","wakunnā","And indeed, [We]","এবং আমরা হলাম"],["نَحْنُ","naḥnu","We","আমরাই"],["ٱلْوَٰرِثِينَ","l-wārithīna","(are) the inheritors","(এসবের) উত্তরাধিকারী"]],"t":"وَكَمْ أَهْلَكْنَا مِ<k>ن قَ</>رْيَ<i>ةٍۭ بَ</>طِرَتْ مَعِيشَتَهَا ۖ فَتِلْكَ مَ<m>سَٰ</>كِنُهُمْ لَمْ تُسْ<d>كَن مِّ</><i>نۢ بَ</>عْدِهِمْ إِلَّا قَلِيلًۭ<d>ا ۖ وَ</>كُ<g>نَّ</>ا نَحْنُ <h>ٱ</>لْ<m>وَٰ</>رِ<p>ثِي</>نَ"},{"n":59,"w":[["وَمَا","wamā","And not","আর না"],["كَانَ","kāna","was","ছিলেন"],["رَبُّكَ","rabbuka","your Lord","তোমার রব"],["مُهْلِكَ","muh'lika","(the) one to destroy","ধ্বংসকারী"],["ٱلْقُرَىٰ","l-qurā","the towns","জনবসতিগুলোকে"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["يَبْعَثَ","yab‘atha","He (had) sent","তিনি পাঠান"],["فِىٓ","fī","in","মধ্যে"],["أُمِّهَا","ummihā","their mother (town)","তার কেন্দ্রস্থলের"],["رَسُولًۭا","rasūlan","a Messenger","কোনো রাসূলকে"],["يَتْلُوا۟","yatlū","reciting","(যে)তিলাওয়াত করেন"],["عَلَيْهِمْ","‘alayhim","to them","নিকট তাদের"],["ءَايَـٰتِنَا ۚ","āyātinā","Our Verses","আয়াতসমূহকে আমাদের"],["وَمَا","wamā","And not","ও না"],["كُنَّا","kunnā","We would be","আমরা ছিলাম"],["مُهْلِكِى","muh'likī","(the) one to destroy","ধ্বংসকারী"],["ٱلْقُرَىٰٓ","l-qurā","the towns","জনপদসমূহকে"],["إِلَّا","illā","except","এ ছাড়া যে"],["وَأَهْلُهَا","wa-ahluhā","while their people","যখন তার অধিবাসীরা (ছিলো)"],["ظَـٰلِمُونَ","ẓālimūna","(were) wrongdoers","সীমালঙ্ঘনকারী"]],"t":"وَمَا كَانَ رَبُّكَ مُهْلِكَ <h>ٱ</>لْقُرَىٰ حَتَّىٰ يَ<q>بْ</>عَثَ <o>فِىٓ</> أُ<g>مِّ</>هَا رَسُولًۭ<d>ا يَ</>تْلُو<s>ا۟</> عَلَيْهِمْ ءَا<m>يَٰ</>تِنَا ۚ وَمَا كُ<g>نَّ</>ا مُهْلِكِى <h>ٱ</>لْقُرَ<o>ىٰٓ</> إِلَّا وَأَهْلُهَا <m>ظَٰ</>لِ<p>مُو</>نَ"},{"n":60,"w":[["وَمَآ","wamā","And whatever","আর যা কিছু"],["أُوتِيتُم","ūtītum","you have been given","দেয়া হয়েছে তোমাদের"],["مِّن","min","from","থেকে"],["شَىْءٍۢ","shayin","things","বস্তু"],["فَمَتَـٰعُ","famatā‘u","(is) an enjoyment","তা হলো ভোগসামগ্রী"],["ٱلْحَيَوٰةِ","l-ḥayati","(of the) life","জীবনের"],["ٱلدُّنْيَا","l-dun'yā","(of) the world","পার্থিব"],["وَزِينَتُهَا ۚ","wazīnatuhā","and its adornment","ও তার চাকচিক্য (মাত্র)"],["وَمَا","wamā","And what","আর যা (আছে)"],["عِندَ","‘inda","(is) with","নিকট"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["خَيْرٌۭ","khayrun","(is) better","(তাই) উত্তম"],["وَأَبْقَىٰٓ ۚ","wa-abqā","and more lasting","ও অধিক স্থায়ী"],["أَفَلَا","afalā","So (will) not","কি তবে না"],["تَعْقِلُونَ","ta‘qilūna","you use intellect","তোমরা বুঝবে"]],"t":"وَ<o>مَآ</> أُوتِي<y>تُم مِّ</><k>ن شَىْءٍۢ فَ</>مَ<m>تَٰ</>عُ <h>ٱ</>لْحَيَ<s>وٰ</>ةِ <h>ٱ</><l>ل</>دُّنْيَا وَزِينَتُهَا ۚ وَمَا عِ<k>ندَ</> <h>ٱ</>للَّهِ خَيْ<d>رٌۭ وَ</>أَ<q>بْ</>قَ<o>ىٰٓ ۚ</> أَفَلَا تَعْقِ<p>لُو</>نَ"},{"n":61,"w":[["أَفَمَن","afaman","Then is (he) whom","কি তবে সে"],["وَعَدْنَـٰهُ","wa‘adnāhu","We have promised him","আমরা প্রতিশ্রুতি দিয়েছি যাকে"],["وَعْدًا","wa‘dan","a promise","প্রতিশ্রুতি"],["حَسَنًۭا","ḥasanan","good","উত্তম"],["فَهُوَ","fahuwa","and he","অতঃপর সে"],["لَـٰقِيهِ","lāqīhi","(will) meet it","লাভ করবে তা"],["كَمَن","kaman","like (the one) whom","(সে কি) তার মতো"],["مَّتَّعْنَـٰهُ","matta‘nāhu","We provided him","আমরা ভোগ করতে দিয়েছি যাকে"],["مَتَـٰعَ","matā‘a","enjoyment","ভোগসামগ্রী"],["ٱلْحَيَوٰةِ","l-ḥayati","(of the) life","জীবনের"],["ٱلدُّنْيَا","l-dun'yā","(of) the world","পার্থিব"],["ثُمَّ","thumma","then","এরপর"],["هُوَ","huwa","he","সে (হবে)"],["يَوْمَ","yawma","(on the) Day","দিনে"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) the Resurrection","ক্বিয়ামাতের"],["مِنَ","mina","(will be) among","অন্তর্ভূক্ত"],["ٱلْمُحْضَرِينَ","l-muḥ'ḍarīna","those presented","উপস্থিতদের (অপরাধীদের)"]],"t":"أَفَ<d>مَن وَ</>عَ<q>دْ</><m>نَٰ</>هُ وَعْدًا حَسَ<k>نًۭا فَ</>هُوَ <m>لَٰ</>قِيهِ كَ<d>مَن مَّ</>تَّعْ<m>نَٰ</>هُ مَ<m>تَٰ</>عَ <h>ٱ</>لْحَيَ<s>وٰ</>ةِ <h>ٱ</><l>ل</>دُّنْيَا ثُ<g>مَّ</> هُوَ يَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ مِنَ <h>ٱ</>لْمُحْضَ<p>رِي</>نَ"},{"n":62,"w":[["وَيَوْمَ","wayawma","And (the) Day","এবং সেদিন"],["يُنَادِيهِمْ","yunādīhim","He will call them","তিনি ডাকবেন তাদেরকে"],["فَيَقُولُ","fayaqūlu","and say","অতঃপর বলবেন"],["أَيْنَ","ayna","Where","\"কোথায়"],["شُرَكَآءِىَ","shurakāiya","(are) My partners","আমার শরিকেরা"],["ٱلَّذِينَ","alladhīna","whom","যাদেরকে"],["كُنتُمْ","kuntum","you used (to)","তোমরা ছিলে"],["تَزْعُمُونَ","taz‘umūna","claim","ধারণা করতে (শরিক হিসেবে)\""]],"t":"وَيَوْمَ يُنَادِيهِمْ فَيَقُولُ أَيْنَ شُرَ<o>كَآ</>ءِىَ <h>ٱ</>لَّذِينَ كُ<k>نتُ</>مْ تَزْعُ<p>مُو</>نَ"},{"n":63,"w":[["قَالَ","qāla","(Will) say","বলবে"],["ٱلَّذِينَ","alladhīna","those ","তারা"],["حَقَّ","ḥaqqa","(has) come true","অবধারিত হয়েছে"],["عَلَيْهِمُ","‘alayhimu","against whom","উপর যাদের"],["ٱلْقَوْلُ","l-qawlu","the Word","(এই) কথাটি"],["رَبَّنَا","rabbanā","Our Lord","\"হে আমার রব"],["هَـٰٓؤُلَآءِ","hāulāi","These","এরাই"],["ٱلَّذِينَ","alladhīna","(are) those whom","(তারা) যাদেরকে"],["أَغْوَيْنَآ","aghwaynā","we led astray","পথভ্রষ্ট করেছিলাম আমরা"],["أَغْوَيْنَـٰهُمْ","aghwaynāhum","We led them astray","পথভ্রষ্ট করেছিলাম আমরা তাদেরকে"],["كَمَا","kamā","as","যেমন"],["غَوَيْنَا ۖ","ghawaynā","we were astray","পথভ্রষ্ট হয়েছিলাম আমরা"],["تَبَرَّأْنَآ","tabarranā","We declare our innocence","দায়মুক্ত বলে ঘোষণা করছি আমরা"],["إِلَيْكَ ۖ","ilayka","before You","আপনার কাছে"],["مَا","mā","Not","না"],["كَانُوٓا۟","kānū","they used (to)","তারা ছিলো"],["إِيَّانَا","iyyānā","worship us","আমাদের\""],["يَعْبُدُونَ","ya‘budūna","worship us","ইবাদাত করতো\""]],"t":"قَالَ <h>ٱ</>لَّذِينَ حَقَّ عَلَيْهِمُ <h>ٱ</>لْقَوْلُ رَبَّنَا <o>هَٰٓؤُلَآ</>ءِ <h>ٱ</>لَّذِينَ أَغْوَيْ<o>نَآ</> أَغْوَيْ<m>نَٰ</>هُمْ كَمَا غَوَيْنَا ۖ تَبَرَّأْ<o>نَآ</> إِلَيْكَ ۖ مَا كَا<o>نُوٓ</><s>ا۟</> إِيَّانَا يَعْبُ<p>دُو</>نَ"},{"n":64,"w":[["وَقِيلَ","waqīla","And it will be said","এবং বলা হবে"],["ٱدْعُوا۟","id'‘ū","Call","\"তোমরা ডাকো"],["شُرَكَآءَكُمْ","shurakāakum","your partners","শরিকদেরকে তোমাদের (বানানো)\""],["فَدَعَوْهُمْ","fada‘awhum","And they will call them","তখন তারা ডাকবে তাদেরকে"],["فَلَمْ","falam","but not","কিন্তু না"],["يَسْتَجِيبُوا۟","yastajībū","they will respond","তারা ডাকে সাড়া দিবে"],["لَهُمْ","lahum","to them","উদ্দেশ্যে তাদের"],["وَرَأَوُا۟","wara-awū","and they will see","এবং তারা দেখবে"],["ٱلْعَذَابَ ۚ","l-‘adhāba","the punishment","শাস্তি"],["لَوْ","law","If only","(হায়!) যদি"],["أَنَّهُمْ","annahum","[that] they","(এমন হতো) যে তারা"],["كَانُوا۟","kānū","had been","তারা ছিলো"],["يَهْتَدُونَ","yahtadūna","guided","সঠিকপথ পেতো"]],"t":"وَقِيلَ <h>ٱ</><q>دْ</>عُو<s>ا۟</> شُرَ<o>كَآ</>ءَكُمْ فَدَعَوْهُمْ فَلَمْ يَسْتَجِيبُو<s>ا۟</> لَهُمْ وَرَأَوُ<s>ا۟</> <h>ٱ</>لْعَذَابَ ۚ لَوْ أَ<g>نَّ</>هُمْ كَانُو<s>ا۟</> يَهْتَ<p>دُو</>نَ"},{"n":65,"w":[["وَيَوْمَ","wayawma","And (the) Day","এবং সেদিন"],["يُنَادِيهِمْ","yunādīhim","He will call them","তিনি ডাকবেন তাদেরকে"],["فَيَقُولُ","fayaqūlu","and say","অতঃপর বলবেন"],["مَاذَآ","mādhā","What","\"কি"],["أَجَبْتُمُ","ajabtumu","did you answer","জবাব দিয়েছিলে তোমরা"],["ٱلْمُرْسَلِينَ","l-mur'salīna","the Messengers","রাসূলদেরকে\""]],"t":"وَيَوْمَ يُنَادِيهِمْ فَيَقُولُ مَا<o>ذَآ</> أَجَ<q>بْ</>تُمُ <h>ٱ</>لْمُرْسَ<p>لِي</>نَ"},{"n":66,"w":[["فَعَمِيَتْ","fa‘amiyat","But (will) be obscure","তখন বিলুপ্ত হবে"],["عَلَيْهِمُ","‘alayhimu","to them","থেকে তাদের"],["ٱلْأَنۢبَآءُ","l-anbāu","the information","তথ্যাদি"],["يَوْمَئِذٍۢ","yawma-idhin","that day","সেদিন"],["فَهُمْ","fahum","so they","তখন তারা"],["لَا","lā","will not ask one another","না"],["يَتَسَآءَلُونَ","yatasāalūna","will not ask one another","পরস্পরকে জিজ্ঞেসও করতে পারবে"]],"t":"فَعَمِيَتْ عَلَيْهِمُ <h>ٱ</>لْأَ<i>نۢبَ</><o>آ</>ءُ يَوْمَئِ<k>ذٍۢ فَ</>هُمْ لَا يَتَ<o>سَآ</>ءَ<p>لُو</>نَ"},{"n":67,"w":[["فَأَمَّا","fa-ammā","But as for","তবে অবশ্য"],["مَن","man","(him) who","যে"],["تَابَ","tāba","repented","তওবা করলো"],["وَءَامَنَ","waāmana","and believed","ও ঈমান আনলো"],["وَعَمِلَ","wa‘amila","and did","ও কাজ করলো"],["صَـٰلِحًۭا","ṣāliḥan","righteousness","সৎ"],["فَعَسَىٰٓ","fa‘asā","then perhaps","সেক্ষেত্রে আশা করা যায়"],["أَن","an","[that]","যে"],["يَكُونَ","yakūna","he will be","সে হবে"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْمُفْلِحِينَ","l-muf'liḥīna","the successful ones","সফলকামদের"]],"t":"فَأَ<g>مَّ</>ا مَ<k>ن تَ</>ابَ وَءَامَنَ وَعَمِلَ <m>صَٰ</>لِ<k>حًۭا فَ</>عَسَ<o>ىٰٓ</> <d>أَن يَ</>كُونَ مِنَ <h>ٱ</>لْمُفْلِ<p>حِي</>نَ"},{"n":68,"w":[["وَرَبُّكَ","warabbuka","And your Lord","এবং তোমার রব"],["يَخْلُقُ","yakhluqu","creates","সৃষ্টি করেন"],["مَا","mā","what","যা কিছু"],["يَشَآءُ","yashāu","He wills","তিনি চান"],["وَيَخْتَارُ ۗ","wayakhtāru","and chooses","এবং মনোনীত করেন (নিজের কাজে যাকে চান)"],["مَا","mā","Not","না"],["كَانَ","kāna","they have","আছে"],["لَهُمُ","lahumu","for them","জন্যে তাদের(এ ব্যাপারে)"],["ٱلْخِيَرَةُ ۚ","l-khiyaratu","the choice","বেছে নেয়ার স্বাধীনতা"],["سُبْحَـٰنَ","sub'ḥāna","Glory be","পবিত্র মহান"],["ٱللَّهِ","l-lahi","(to) Allah","আল্লাহ"],["وَتَعَـٰلَىٰ","wata‘ālā","and High is He","এবং বহু উর্দ্ধে"],["عَمَّا","‘ammā","above what","(তা) হ'তে যা"],["يُشْرِكُونَ","yush'rikūna","they associate (with Him)","তারা শরিক করছে"]],"t":"وَرَبُّكَ يَخْلُقُ مَا يَ<o>شَآ</>ءُ وَيَخْتَارُ ۗ مَا كَانَ لَهُمُ <h>ٱ</>لْخِيَرَةُ ۚ سُ<q>بْ</><m>حَٰ</>نَ <h>ٱ</>للَّهِ وَتَ<m>عَٰ</>لَىٰ عَ<g>مَّ</>ا يُشْرِ<p>كُو</>نَ"},{"n":69,"w":[["وَرَبُّكَ","warabbuka","And your Lord","এবং তোমার রব"],["يَعْلَمُ","ya‘lamu","knows","জানেন"],["مَا","mā","what","যা কিছু"],["تُكِنُّ","tukinnu","conceals","লুকিয়ে রাখে"],["صُدُورُهُمْ","ṣudūruhum","their breasts","অন্তরসমূহ তাদের"],["وَمَا","wamā","and what","এবং যা কিছু"],["يُعْلِنُونَ","yu‘'linūna","they declare","তারা প্রকাশ করে"]],"t":"وَرَبُّكَ يَعْلَمُ مَا تُكِ<g>نُّ</> صُدُورُهُمْ وَمَا يُعْلِ<p>نُو</>نَ"},{"n":70,"w":[["وَهُوَ","wahuwa","And He","এবং তিনিই"],["ٱللَّهُ","l-lahu","(is) Allah","আল্লাহ"],["لَآ","lā","(there is) no","নেই"],["إِلَـٰهَ","ilāha","god","কোন ইলাহ"],["إِلَّا","illā","but","ছাড়া"],["هُوَ ۖ","huwa","He","তিনি"],["لَهُ","lahu","To Him","জন্যে তাঁরই"],["ٱلْحَمْدُ","l-ḥamdu","(are due) all praises","সব প্রশংসা"],["فِى","fī","in","মধ্যে"],["ٱلْأُولَىٰ","l-ūlā","the first","দুনিয়ার"],["وَٱلْـَٔاخِرَةِ ۖ","wal-ākhirati","and the last","ও আখেরাতে"],["وَلَهُ","walahu","And for Him","এবং জন্যে তাঁরই"],["ٱلْحُكْمُ","l-ḥuk'mu","(is) the Decision","বিধান"],["وَإِلَيْهِ","wa-ilayhi","and to Him","এবং দিকে তাঁরই"],["تُرْجَعُونَ","tur'ja‘ūna","you will be returned","প্রত্যাবর্তিত হবে তোমরা"]],"t":"وَهُوَ <h>ٱ</>للَّهُ <o>لَآ</> إِ<m>لَٰ</>هَ إِلَّا هُوَ ۖ لَهُ <h>ٱ</>لْحَمْدُ فِى <h>ٱ</>لْأُولَىٰ وَ<h>ٱ</>لْءَاخِرَةِ ۖ وَلَهُ <h>ٱ</>لْحُكْمُ وَإِلَيْهِ تُرْجَ<p>عُو</>نَ"},{"n":71,"w":[["قُلْ","qul","Say","বলো"],["أَرَءَيْتُمْ","ara-aytum","Have you seen","\"কি ভেবে দেখেছো তোমরা"],["إِن","in","if","যদি"],["جَعَلَ","ja‘ala","Allah made","করে দেন"],["ٱللَّهُ","l-lahu","Allah made","আল্লাহ"],["عَلَيْكُمُ","‘alaykumu","for you","উপর তোমাদের"],["ٱلَّيْلَ","al-layla","the night","রাতকে"],["سَرْمَدًا","sarmadan","continuous","সুদীর্ঘ"],["إِلَىٰ","ilā","till","পর্যন্ত"],["يَوْمِ","yawmi","(the) Day","দিন"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) the Resurrection","ক্বিয়ামাতের"],["مَنْ","man","who","কে (এমন আছে)"],["إِلَـٰهٌ","ilāhun","(is the) god","ইলাহ"],["غَيْرُ","ghayru","besides","ছাড়া"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ (যে)"],["يَأْتِيكُم","yatīkum","who could bring you","কাছে আসবে তোমাদের"],["بِضِيَآءٍ ۖ","biḍiyāin","light","নিয়ে আলো"],["أَفَلَا","afalā","Then will not","কি তবুও না"],["تَسْمَعُونَ","tasma‘ūna","you hear","তোমরা শুনবে\""]],"t":"قُلْ أَرَءَيْتُمْ إِ<k>ن جَ</>عَلَ <h>ٱ</>للَّهُ عَلَيْكُمُ <h>ٱ</>لَّيْلَ سَرْمَدًا إِلَىٰ يَوْمِ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ مَنْ إِ<m>لَٰ</>هٌ غَيْرُ <h>ٱ</>للَّهِ يَأْتِي<f>كُم بِ</>ضِ<o>يَآ</>ءٍ ۖ أَفَلَا تَسْمَ<p>عُو</>نَ"},{"n":72,"w":[["قُلْ","qul","Say","বলো"],["أَرَءَيْتُمْ","ara-aytum","Have you seen","\"কি ভেবে দেখেছো তোমরা"],["إِن","in","if","যদি"],["جَعَلَ","ja‘ala","Allah made","করে দেন"],["ٱللَّهُ","l-lahu","Allah made","আল্লাহ"],["عَلَيْكُمُ","‘alaykumu","for you","উপর তোমাদের"],["ٱلنَّهَارَ","l-nahāra","the day","দিনকে"],["سَرْمَدًا","sarmadan","continuous","সুদীর্ঘ"],["إِلَىٰ","ilā","till","পর্যন্ত"],["يَوْمِ","yawmi","(the) Day","দিন"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) the Resurrection","ক্বিয়ামাতের"],["مَنْ","man","who","কে (এমন আছে)"],["إِلَـٰهٌ","ilāhun","(is the) god","ইলাহ"],["غَيْرُ","ghayru","besides","ছাড়া"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["يَأْتِيكُم","yatīkum","who could bring you","কাছে আসবে তোমাদের"],["بِلَيْلٍۢ","bilaylin","night","নিয়ে রাত"],["تَسْكُنُونَ","taskunūna","(for) you (to) rest","তোমরা (যেন) শান্তি পেতে পারো"],["فِيهِ ۖ","fīhi","in it","মধ্যে তার"],["أَفَلَا","afalā","Then will not","কি তবুও না"],["تُبْصِرُونَ","tub'ṣirūna","you see","তোমরা ভেবে দেখবে\""]],"t":"قُلْ أَرَءَيْتُمْ إِ<k>ن جَ</>عَلَ <h>ٱ</>للَّهُ عَلَيْكُمُ <h>ٱ</><l>ل</><g>نَّ</>هَارَ سَرْمَدًا إِلَىٰ يَوْمِ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ مَنْ إِ<m>لَٰ</>هٌ غَيْرُ <h>ٱ</>للَّهِ يَأْتِي<f>كُم بِ</>لَيْ<k>لٍۢ تَ</>سْكُنُونَ فِيهِ ۖ أَفَلَا تُ<q>بْ</>صِ<p>رُو</>نَ"},{"n":73,"w":[["وَمِن","wamin","And from","আর হ'তে"],["رَّحْمَتِهِۦ","raḥmatihi","His Mercy","তাঁর দয়া"],["جَعَلَ","ja‘ala","He made","তিনি সৃষ্টি করেছেন"],["لَكُمُ","lakumu","for you","জন্যে তোমাদের"],["ٱلَّيْلَ","al-layla","the night","রাতকে"],["وَٱلنَّهَارَ","wal-nahāra","and the day","ও দিনকে"],["لِتَسْكُنُوا۟","litaskunū","that you may rest","যেন তোমরা শান্তি পাও"],["فِيهِ","fīhi","therein","মধ্যে তার"],["وَلِتَبْتَغُوا۟","walitabtaghū","and that you may seek","এবং যেন তোমরা সন্ধান করো"],["مِن","min","from","হ'তে"],["فَضْلِهِۦ","faḍlihi","His Bounty","তাঁর অনুগ্রহ"],["وَلَعَلَّكُمْ","wala‘allakum","and so that you may","আর( এভাবেই) হয়তো তোমরা"],["تَشْكُرُونَ","tashkurūna","be grateful","তোমরা কৃতজ্ঞতা প্রকাশ করবে"]],"t":"وَ<w>مِن رَّ</>حْمَتِ<m>هِۦ</> جَعَلَ لَكُمُ <h>ٱ</>لَّيْلَ وَ<h>ٱ</><l>ل</><g>نَّ</>هَارَ لِتَسْكُنُو<s>ا۟</> فِيهِ وَلِتَ<q>بْ</>تَغُو<s>ا۟</> مِ<k>ن فَ</>ضْلِ<m>هِۦ</> وَلَعَلَّكُمْ تَشْكُ<p>رُو</>نَ"},{"n":74,"w":[["وَيَوْمَ","wayawma","And (the) Day","আর সেদিন (কেমন হবে যখন)"],["يُنَادِيهِمْ","yunādīhim","He will call them","তিনি ডাকবেন তাদেরকে"],["فَيَقُولُ","fayaqūlu","and say","অতঃপর বলবেন"],["أَيْنَ","ayna","Where","\"কোথায়"],["شُرَكَآءِىَ","shurakāiya","(are) My partners","(তোমাদের বানানো) আমার শরিকরা"],["ٱلَّذِينَ","alladhīna","whom","যাদেরকে"],["كُنتُمْ","kuntum","you used (to)","তোমরা ছিলে তোমরা ধারণা করতে শরিক হিসেবে"],["تَزْعُمُونَ","taz‘umūna","claim","\""]],"t":"وَيَوْمَ يُنَادِيهِمْ فَيَقُولُ أَيْنَ شُرَ<o>كَآ</>ءِىَ <h>ٱ</>لَّذِينَ كُ<k>نتُ</>مْ تَزْعُ<p>مُو</>نَ"},{"n":75,"w":[["وَنَزَعْنَا","wanaza‘nā","And We will draw forth","বের করে আনবো আমরা"],["مِن","min","from","হ'তে"],["كُلِّ","kulli","every","প্রত্যেক"],["أُمَّةٍۢ","ummatin","nation","জাতি"],["شَهِيدًۭا","shahīdan","a witness","একজন সাক্ষী"],["فَقُلْنَا","faqul'nā","and We will say","অতঃপর আমরা বলবো"],["هَاتُوا۟","hātū","Bring","\"তোমরা উপস্হিত করো"],["بُرْهَـٰنَكُمْ","bur'hānakum","your proof","প্রমাণ তোমাদের\""],["فَعَلِمُوٓا۟","fa‘alimū","Then they will know","তখন তারা জানবে"],["أَنَّ","anna","that","যে"],["ٱلْحَقَّ","l-ḥaqa","the truth","প্রকৃত সত্য (এটাই যে)"],["لِلَّهِ","lillahi","(is) for Allah","(ইলাহ হওয়ার অধিকার) জন্যে আল্লাহরই"],["وَضَلَّ","waḍalla","and (will be) lost","এবং উধাও হয়ে যাবে"],["عَنْهُم","‘anhum","from them","হ'তে তাদের"],["مَّا","mā","what","যা"],["كَانُوا۟","kānū","they used (to)","তারা ছিলো তারা মিথ্যা"],["يَفْتَرُونَ","yaftarūna","invent","রটনা করতো"]],"t":"وَنَزَعْنَا مِ<k>ن كُ</>لِّ أُ<g>مَّ</><k>ةٍۢ شَ</>هِي<k>دًۭا فَ</>قُلْنَا هَاتُو<s>ا۟</> بُرْ<m>هَٰ</>نَكُمْ فَعَلِ<o>مُوٓ</><s>ا۟</> أَ<g>نَّ</> <h>ٱ</>لْحَقَّ لِلَّهِ وَضَلَّ عَنْ<y>هُم مَّ</>ا كَانُو<s>ا۟</> يَفْتَ<p>رُو</>نَ"},{"n":76,"w":[["۞ إِنَّ","inna","Indeed","নিশ্চয়ই"],["قَـٰرُونَ","qārūna","Qarun","ক্বারুণ"],["كَانَ","kāna","was","ছিলো"],["مِن","min","from","অন্তর্ভুক্ত"],["قَوْمِ","qawmi","(the) people","জাতির"],["مُوسَىٰ","mūsā","(of) Musa","মূসার"],["فَبَغَىٰ","fabaghā","but he oppressed","কিন্তু সে উদ্ধত্য প্রকাশ করলো"],["عَلَيْهِمْ ۖ","‘alayhim","[on] them","বিরুদ্ধে তাদেরই (জাতির)"],["وَءَاتَيْنَـٰهُ","waātaynāhu","And We gave him","আর আমরা দিয়েছিলাম তাকে"],["مِنَ","mina","of","থেকে"],["ٱلْكُنُوزِ","l-kunūzi","the treasures","ধনভান্ডারসমূহ"],["مَآ","mā","which","যা (এমন ছিলো যে)"],["إِنَّ","inna","indeed","নিশ্চয়ই"],["مَفَاتِحَهُۥ","mafātiḥahu","(the) keys of it","চাবিগুলো তার"],["لَتَنُوٓأُ","latanūu","would burden","অবশ্যই বহন করা কষ্টসাধ্য ছিলো"],["بِٱلْعُصْبَةِ","bil-‘uṣ'bati","a company (of men)","পক্ষে একদল লোকের"],["أُو۟لِى","ulī","possessors of great strength","অধিকারী"],["ٱلْقُوَّةِ","l-quwati","possessors of great strength","শক্তির"],["إِذْ","idh","When","যখন"],["قَالَ","qāla","said","বলেছিলো"],["لَهُۥ","lahu","to him","উদ্দেশ্যে তার"],["قَوْمُهُۥ","qawmuhu","his people","জাতির লোকেরা তার"],["لَا","lā","(Do) not","\"না"],["تَفْرَحْ ۖ","tafraḥ","exult","আনন্দে আত্মহারা হয়ো"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَا","lā","(does) not","না"],["يُحِبُّ","yuḥibbu","love","ভালবাসেন"],["ٱلْفَرِحِينَ","l-fariḥīna","the exultant","আনন্দের আত্মহারাদেরকে"]],"t":"۞ إِ<g>نَّ</> <m>قَٰ</>رُونَ كَانَ مِ<k>ن قَ</>وْمِ مُوسَىٰ فَبَغَىٰ عَلَيْهِمْ ۖ وَءَاتَيْ<m>نَٰ</>هُ مِنَ <h>ٱ</>لْكُنُوزِ <o>مَآ</> إِ<g>نَّ</> مَفَاتِحَهُ<m>ۥ</> لَتَ<o>نُوٓ</>أُ بِ<h>ٱ</>لْعُصْبَةِ أُ<s>و۟</>لِى <h>ٱ</>لْقُوَّةِ إِذْ قَالَ لَهُ<m>ۥ</> قَوْمُهُ<m>ۥ</> لَا تَفْرَحْ ۖ إِ<g>نَّ</> <h>ٱ</>للَّهَ لَا يُحِبُّ <h>ٱ</>لْفَرِ<p>حِي</>نَ"},{"n":77,"w":[["وَٱبْتَغِ","wa-ib'taghi","But seek","এবং অনুসন্ধান করো"],["فِيمَآ","fīmā","through what","মধ্যে তার যা"],["ءَاتَىٰكَ","ātāka","Allah has given you","(অর্থাৎ ধনসম্পদ) যা তোমাকে দিয়েছেন"],["ٱللَّهُ","l-lahu","Allah has given you","আল্লাহ"],["ٱلدَّارَ","l-dāra","the home","ঘর"],["ٱلْـَٔاخِرَةَ ۖ","l-ākhirata","(of) the Hereafter","আখেরাতের"],["وَلَا","walā","and (do) not","তবে না"],["تَنسَ","tansa","forget","ভুলো"],["نَصِيبَكَ","naṣībaka","your share","তোমার অংশ"],["مِنَ","mina","of","মধ্যেকার"],["ٱلدُّنْيَا ۖ","l-dun'yā","the world","দুনিয়ার"],["وَأَحْسِن","wa-aḥsin","And do good","এবং অনুগ্রহ করো (অপরের প্রতি)"],["كَمَآ","kamā","as","যেমন"],["أَحْسَنَ","aḥsana","Allah has been good","অনুগ্রহ করেছেন"],["ٱللَّهُ","l-lahu","Allah has been good","আল্লাহ"],["إِلَيْكَ ۖ","ilayka","to you","প্রতি তোমার"],["وَلَا","walā","And (do) not","এবং না"],["تَبْغِ","tabghi","seek","চেয়ো"],["ٱلْفَسَادَ","l-fasāda","corruption","বিপর্যয় সৃষ্টি করতে"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ ۖ","l-arḍi","the earth","পৃথিবীর"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَا","lā","(does) not","না"],["يُحِبُّ","yuḥibbu","love","পছন্দ করেন"],["ٱلْمُفْسِدِينَ","l-muf'sidīna","the corrupters","বিপর্যয় সৃষ্টিকারীদেরকে\""]],"t":"وَ<h>ٱ</><q>بْ</>تَغِ فِي<o>مَآ</> ءَاتَ<m>ىٰ</>كَ <h>ٱ</>للَّهُ <h>ٱ</><l>ل</>دَّارَ <h>ٱ</>لْءَاخِرَةَ ۖ وَلَا تَ<k>نسَ</> نَصِيبَكَ مِنَ <h>ٱ</><l>ل</>دُّنْيَا ۖ وَأَحْسِ<k>ن كَ</><o>مَآ</> أَحْسَنَ <h>ٱ</>للَّهُ إِلَيْكَ ۖ وَلَا تَ<q>بْ</>غِ <h>ٱ</>لْفَسَادَ فِى <h>ٱ</>لْأَرْضِ ۖ إِ<g>نَّ</> <h>ٱ</>للَّهَ لَا يُحِبُّ <h>ٱ</>لْمُفْسِ<p>دِي</>نَ"},{"n":78,"w":[["قَالَ","qāla","He said","(ক্বারুণ) বললো"],["إِنَّمَآ","innamā","Only","\"শুধুমাত্র"],["أُوتِيتُهُۥ","ūtītuhu","I have been given it","আমাকে দেয়া হয়েছে তা"],["عَلَىٰ","‘alā","on (account)","এ কারণে যে"],["عِلْمٍ","‘il'min","(of) knowledge","জ্ঞান (রয়েছে)"],["عِندِىٓ ۚ","‘indī","I have","আমার নিকট\""],["أَوَلَمْ","awalam","Did not","কি আর না"],["يَعْلَمْ","ya‘lam","he know","সে জানে"],["أَنَّ","anna","that","যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["قَدْ","qad","indeed","নিশ্চয়ই"],["أَهْلَكَ","ahlaka","destroyed","ধ্বংস করেছেন"],["مِن","min","before him","থেকে"],["قَبْلِهِۦ","qablihi","before him","তার পূর্ব"],["مِنَ","mina","of","মধ্য হ'তে"],["ٱلْقُرُونِ","l-qurūni","the generations","মানবগোষ্ঠীর"],["مَنْ","man","who","অনেককে"],["هُوَ","huwa","[they]","যারা (ছিলো)"],["أَشَدُّ","ashaddu","(were) stronger","অধিকতর"],["مِنْهُ","min'hu","than him","চেয়েও তার"],["قُوَّةًۭ","quwwatan","(in) strength","শক্তিতে"],["وَأَكْثَرُ","wa-aktharu","and greater","ও অনেক বেশি"],["جَمْعًۭا ۚ","jam‘an","(in) accumulation","জনবলে"],["وَلَا","walā","And not","আর না"],["يُسْـَٔلُ","yus'alu","will be questioned","জিজ্ঞেস করা হবে"],["عَن","‘an","about","সম্পর্কে"],["ذُنُوبِهِمُ","dhunūbihimu","their sins","অপরাধসমূহ তাদের"],["ٱلْمُجْرِمُونَ","l-muj'rimūna","the criminals","অপরাধীদেরকে"]],"t":"قَالَ إِ<g>نَّ</><o>مَآ</> أُوتِيتُهُ<m>ۥ</> عَلَىٰ عِلْمٍ عِ<k>ندِ</><o>ىٓ ۚ</> أَوَلَمْ يَعْلَمْ أَ<g>نَّ</> <h>ٱ</>للَّهَ قَ<q>دْ</> أَهْلَكَ مِ<k>ن قَ</><q>بْ</>لِ<m>هِۦ</> مِنَ <h>ٱ</>لْقُرُونِ مَنْ هُوَ أَشَدُّ مِنْهُ قُوَّ<d>ةًۭ وَ</>أَكْثَرُ جَمْ<d>عًۭا ۚ وَ</>لَا يُسْـَٔلُ عَ<k>ن ذُ</>نُوبِهِمُ <h>ٱ</>لْمُ<q>جْ</>رِ<p>مُو</>نَ"},{"n":79,"w":[["فَخَرَجَ","fakharaja","So he went forth","অতঃপর সে  বের হয়েছিলো"],["عَلَىٰ","‘alā","to","সামনে"],["قَوْمِهِۦ","qawmihi","his people","জাতির তার"],["فِى","fī","in","সাথে"],["زِينَتِهِۦ ۖ","zīnatihi","his adornment","জাঁকজমকের তার"],["قَالَ","qāla","Said","বললো"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["يُرِيدُونَ","yurīdūna","desire","চায়"],["ٱلْحَيَوٰةَ","l-ḥayata","the life","জীবন"],["ٱلدُّنْيَا","l-dun'yā","(of) the world","পার্থিব"],["يَـٰلَيْتَ","yālayta","O! Would that","\"হায়! যদি হতো"],["لَنَا","lanā","for us","জন্যে আমাদের"],["مِثْلَ","mith'la","(the) like","এরূপ"],["مَآ","mā","(of) what","যা"],["أُوتِىَ","ūtiya","has been given","দেয়া হয়েছে"],["قَـٰرُونُ","qārūnu","(to) Qarun","ক্বারুনকে"],["إِنَّهُۥ","innahu","Indeed, he","নিশ্চয়ই সে"],["لَذُو","ladhū","(is the) owner","অবশ্যই অধিকারী"],["حَظٍّ","ḥaẓẓin","(of) fortune","সৌভাগ্যের"],["عَظِيمٍۢ","‘aẓīmin","great","বড়\""]],"t":"فَخَرَجَ عَلَىٰ قَوْمِ<m>هِۦ</> فِى زِينَتِ<m>هِۦ</> ۖ قَالَ <h>ٱ</>لَّذِينَ يُرِيدُونَ <h>ٱ</>لْحَيَ<s>وٰ</>ةَ <h>ٱ</><l>ل</>دُّنْيَا <m>يَٰ</>لَيْتَ لَنَا مِثْلَ <o>مَآ</> أُوتِىَ <m>قَٰ</>رُونُ إِ<g>نَّ</>هُ<m>ۥ</> لَذُو حَظٍّ عَ<p>ظِي</>مٍۢ"},{"n":80,"w":[["وَقَالَ","waqāla","But said","কিন্তু বললো"],["ٱلَّذِينَ","alladhīna","those who","(তারা) যাদেরকে"],["أُوتُوا۟","ūtū","were given","দেয়া হয়েছিলো"],["ٱلْعِلْمَ","l-‘il'ma","the knowledge","জ্ঞান"],["وَيْلَكُمْ","waylakum","Woe to you","\"ধ্বংস জন্যে তোমাদের"],["ثَوَابُ","thawābu","(The) reward","পুরস্কার"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহরই"],["خَيْرٌۭ","khayrun","(is) better","উত্তম"],["لِّمَنْ","liman","for (he) who","(তার) জন্যে যে"],["ءَامَنَ","āmana","believes","ঈমান এনেছে"],["وَعَمِلَ","wa‘amila","and does","কাজ করেছে"],["صَـٰلِحًۭا","ṣāliḥan","righteous (deeds)","সৎ"],["وَلَا","walā","And not","আর না"],["يُلَقَّىٰهَآ","yulaqqāhā","it is granted","তা পায় (অন্য কেউ)"],["إِلَّا","illā","except","ছাড়া"],["ٱلصَّـٰبِرُونَ","l-ṣābirūna","(to) the patient ones","ধৈর্য্যশীলরা\""]],"t":"وَقَالَ <h>ٱ</>لَّذِينَ أُوتُو<s>ا۟</> <h>ٱ</>لْعِلْمَ وَيْلَكُمْ ثَوَابُ <h>ٱ</>للَّهِ خَيْ<w>رٌۭ لِّ</>مَنْ ءَامَنَ وَعَمِلَ <m>صَٰ</>لِ<d>حًۭا وَ</>لَا يُلَقَّ<m>ىٰ</><o>هَآ</> إِلَّا <h>ٱ</><l>ل</><m>صَّٰ</>بِ<p>رُو</>نَ"},{"n":81,"w":[["فَخَسَفْنَا","fakhasafnā","Then We caused to swallow up","অতঃপর ধ্বসিয়ে দিলাম আমরা"],["بِهِۦ","bihi","him","সহ তাকে"],["وَبِدَارِهِ","wabidārihi","and his home","ও সহ তার ঘর (অর্থাৎ তার প্রাসাদ)"],["ٱلْأَرْضَ","l-arḍa","the earth","জমীনে"],["فَمَا","famā","Then not","তখন না"],["كَانَ","kāna","was","ছিলো"],["لَهُۥ","lahu","for him","জন্যে তার"],["مِن","min","any","কোনো"],["فِئَةٍۢ","fi-atin","group","দল"],["يَنصُرُونَهُۥ","yanṣurūnahu","(to) help him","তারা সাহায্য করবে তাকে"],["مِن","min","besides","থেকে"],["دُونِ","dūni","besides","ছাড়া"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["وَمَا","wamā","and not","আর না"],["كَانَ","kāna","was","সে ছিলো"],["مِنَ","mina","(he) of","অন্তর্ভুক্ত"],["ٱلْمُنتَصِرِينَ","l-muntaṣirīna","those who (could) defend themselves","আত্মরক্ষায় সক্ষমদের"]],"t":"فَخَسَفْنَا بِ<m>هِۦ</> وَبِدَارِهِ <h>ٱ</>لْأَرْضَ فَمَا كَانَ لَهُ<m>ۥ</> مِ<k>ن فِ</>ئَ<d>ةٍۢ يَ</><k>نصُ</>رُونَهُ<m>ۥ</> مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ وَمَا كَانَ مِنَ <h>ٱ</>لْمُ<k>نتَ</>صِ<p>رِي</>نَ"},{"n":82,"w":[["وَأَصْبَحَ","wa-aṣbaḥa","And began","এবং সকাল হলো"],["ٱلَّذِينَ","alladhīna","those who","যারা (তাদের)"],["تَمَنَّوْا۟","tamannaw","(had) wished","কামনা করেছিলো"],["مَكَانَهُۥ","makānahu","his position","তার মতো হওয়ার"],["بِٱلْأَمْسِ","bil-amsi","the day before","গতকালকে"],["يَقُولُونَ","yaqūlūna","(to) say","তারা বলতে লাগলো (আজ)"],["وَيْكَأَنَّ","wayka-anna","Ah! That","\"বড়ই পরিতাপ নিশ্চয়ই (আমরা ভুলে গিয়েছিলাম)"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يَبْسُطُ","yabsuṭu","extends","সম্প্রসারিত করেন"],["ٱلرِّزْقَ","l-riz'qa","the provision","জীবিকা"],["لِمَن","liman","for whom","(তার) জন্যে যাকে"],["يَشَآءُ","yashāu","He wills","তিনি ইচ্ছে করেন"],["مِنْ","min","of","মধ্য হ'তে"],["عِبَادِهِۦ","‘ibādihi","His slaves","দাসদের তাঁর"],["وَيَقْدِرُ ۖ","wayaqdiru","and restricts it","আর পরিমিত দেন (যাকে চান)"],["لَوْلَآ","lawlā","If not","যদি না"],["أَن","an","that","যে"],["مَّنَّ","manna","Allah had favored","অনুগ্রহ করতেন"],["ٱللَّهُ","l-lahu","Allah had favored","আল্লাহ"],["عَلَيْنَا","‘alaynā","[to] us","উপর আমাদের"],["لَخَسَفَ","lakhasafa","He would have caused it to swallow us","অবশ্যই ধসিয়ে দিতেন"],["بِنَا ۖ","binā","He would have caused it to swallow us","সহ আমাদের (মাটিতে)"],["وَيْكَأَنَّهُۥ","wayka-annahu","Ah! That","বড়ই পরিতাপ নিশ্চয়ই সে বিষয়ে (আমরা ভুলে গিয়েছিলাম)"],["لَا","lā","not","না"],["يُفْلِحُ","yuf'liḥu","will succeed","সফল হয়"],["ٱلْكَـٰفِرُونَ","l-kāfirūna","the disbelievers","কাফিররা\""]],"t":"وَأَصْبَحَ <h>ٱ</>لَّذِينَ تَمَ<g>نَّ</>وْ<s>ا۟</> مَكَانَهُ<m>ۥ</> بِ<h>ٱ</>لْأَمْسِ يَقُولُونَ وَيْكَأَ<g>نَّ</> <h>ٱ</>للَّهَ يَ<q>بْ</>سُطُ <h>ٱ</><l>ل</>رِّزْقَ لِ<d>مَن يَ</><o>شَآ</>ءُ مِنْ عِبَادِ<m>هِۦ</> وَيَ<q>قْ</>دِرُ ۖ لَوْ<o>لَآ</> <d>أَن مَّ</><g>نَّ</> <h>ٱ</>للَّهُ عَلَيْنَا لَخَسَفَ بِنَا ۖ وَيْكَأَ<g>نَّ</>هُ<m>ۥ</> لَا يُفْلِحُ <h>ٱ</>لْ<m>كَٰ</>فِ<p>رُو</>نَ"},{"n":83,"w":[["تِلْكَ","til'ka","That","এই"],["ٱلدَّارُ","l-dāru","the Home","ঘর"],["ٱلْـَٔاخِرَةُ","l-ākhiratu","(of) the Hereafter","আখেরাতের"],["نَجْعَلُهَا","naj‘aluhā","We assign it","আমরা রেখেছি তা"],["لِلَّذِينَ","lilladhīna","to those who","(তাদের) জন্যে যারা"],["لَا","lā","(do) not","না"],["يُرِيدُونَ","yurīdūna","desire","চায়"],["عُلُوًّۭا","‘uluwwan","exaltedness","ঔদ্ধত্য"],["فِى","fī","in","উপর"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["وَلَا","walā","and not","আর না"],["فَسَادًۭا ۚ","fasādan","corruption","বিপর্যয় (সৃষ্টি করে)"],["وَٱلْعَـٰقِبَةُ","wal-‘āqibatu","And the good end","(শুভ) পরিণাম"],["لِلْمُتَّقِينَ","lil'muttaqīna","(is) for the righteous","জন্যে মুত্তাক্বীদের"]],"t":"تِلْكَ <h>ٱ</><l>ل</>دَّارُ <h>ٱ</>لْءَاخِرَةُ نَ<q>جْ</>عَلُهَا لِلَّذِينَ لَا يُرِيدُونَ عُلُ<k>وًّۭا فِ</>ى <h>ٱ</>لْأَرْضِ وَلَا فَسَا<d>دًۭا ۚ وَ</><h>ٱ</>لْ<m>عَٰ</>قِبَةُ لِلْمُتَّ<p>قِي</>نَ"},{"n":84,"w":[["مَن","man","Whoever","যে"],["جَآءَ","jāa","comes","আসবে"],["بِٱلْحَسَنَةِ","bil-ḥasanati","with a good (deed)","নিয়ে সৎকর্ম"],["فَلَهُۥ","falahu","then for him","অতঃপর জন্যে তার (রয়েছে)"],["خَيْرٌۭ","khayrun","(will be) better","উত্তম (প্রতিদান)"],["مِّنْهَا ۖ","min'hā","than it","তা অপেক্ষা (বেশী)"],["وَمَن","waman","and whoever","আর যে"],["جَآءَ","jāa","comes","আসবে"],["بِٱلسَّيِّئَةِ","bil-sayi-ati","with an evil (deed)","নিয়ে মন্দকর্ম"],["فَلَا","falā","then not","অতঃপর না"],["يُجْزَى","yuj'zā","will be recompensed","প্রতিফল দেয়া হবে"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["عَمِلُوا۟","‘amilū","do","করেছে"],["ٱلسَّيِّـَٔاتِ","l-sayiāti","the evil (deeds)","মন্দকর্মসমূহ"],["إِلَّا","illā","except","এ ছাড়া"],["مَا","mā","what","যা"],["كَانُوا۟","kānū","they used (to)","তারা ছিলো"],["يَعْمَلُونَ","ya‘malūna","do","তারা কাজ করতো"]],"t":"مَ<k>ن جَ</><o>آ</>ءَ بِ<h>ٱ</>لْحَسَنَةِ فَلَهُ<m>ۥ</> خَيْ<d>رٌۭ مِّ</>نْهَا ۖ وَمَ<k>ن جَ</><o>آ</>ءَ بِ<h>ٱ</><l>ل</>سَّيِّئَةِ فَلَا يُ<q>جْ</>زَى <h>ٱ</>لَّذِينَ عَمِلُو<s>ا۟</> <h>ٱ</><l>ل</>سَّيِّـَٔاتِ إِلَّا مَا كَانُو<s>ا۟</> يَعْمَ<p>لُو</>نَ"},{"n":85,"w":[["إِنَّ","inna","Indeed","(হে নাবী) নিশ্চয়ই"],["ٱلَّذِى","alladhī","He Who","যিনি"],["فَرَضَ","faraḍa","ordained","ফরজ করেছেন"],["عَلَيْكَ","‘alayka","upon you","উপর তোমার"],["ٱلْقُرْءَانَ","l-qur'āna","the Quran","(এই) কুরআন"],["لَرَآدُّكَ","larādduka","(will) surely take you back","অবশ্যই তোমাকে ফিরিয়ে আনবেন"],["إِلَىٰ","ilā","to","দিকে"],["مَعَادٍۢ ۚ","ma‘ādin","a place of return","প্রত্যাবর্তনস্হলের"],["قُل","qul","Say","বলো"],["رَّبِّىٓ","rabbī","My Lord","\"আমার রব"],["أَعْلَمُ","a‘lamu","(is) most knowing","খুব জানেন"],["مَن","man","(of him) who","কে"],["جَآءَ","jāa","comes","এসেছে"],["بِٱلْهُدَىٰ","bil-hudā","with the guidance","নিয়ে সৎপথের নির্দেশ"],["وَمَنْ","waman","and who ","আর কে"],["هُوَ","huwa","he","সে"],["فِى","fī","(is) in","মধ্যে (আছে)"],["ضَلَـٰلٍۢ","ḍalālin","an error","বিভ্রান্তির"],["مُّبِينٍۢ","mubīnin","manifest","সুস্পষ্ট\""]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِى فَرَضَ عَلَيْكَ <h>ٱ</>لْقُرْءَانَ لَ<n>رَآ</>دُّكَ إِلَىٰ مَعَا<k>دٍۢ ۚ قُ</><r>ل</> رَّ<o>بِّىٓ</> أَعْلَمُ مَ<k>ن جَ</><o>آ</>ءَ بِ<h>ٱ</>لْهُدَىٰ وَمَنْ هُوَ فِى ضَ<m>لَٰ</><d>لٍۢ مُّ</><p>بِي</>نٍۢ"},{"n":86,"w":[["وَمَا","wamā","And not","আর না"],["كُنتَ","kunta","you were","তুমি ছিলে"],["تَرْجُوٓا۟","tarjū","expecting","তুমি আশা করতে"],["أَن","an","that","যে"],["يُلْقَىٰٓ","yul'qā","would be sent down","অবতীর্ণ করা হবে"],["إِلَيْكَ","ilayka","to you","প্রতি তোমার"],["ٱلْكِتَـٰبُ","l-kitābu","the Book","কিতাব"],["إِلَّا","illā","except","কিন্তু (এটা মাত্র)"],["رَحْمَةًۭ","raḥmatan","(as) a mercy","অনুগ্রহ"],["مِّن","min","from","পক্ষ হ'তে"],["رَّبِّكَ ۖ","rabbika","your Lord","তোমার রবের"],["فَلَا","falā","So (do) not","সুতরাং না"],["تَكُونَنَّ","takūnanna","be","তুমি কখনও হয়ো"],["ظَهِيرًۭا","ẓahīran","an assistant","সাহায্যকারী"],["لِّلْكَـٰفِرِينَ","lil'kāfirīna","to the disbelievers","জন্যে কাফেরদের"]],"t":"وَمَا كُ<k>نتَ</> تَرْ<o>جُوٓ</><s>ا۟</> <d>أَن يُ</>لْقَ<o>ىٰٓ</> إِلَيْكَ <h>ٱ</>لْكِ<m>تَٰ</>بُ إِلَّا رَحْمَ<d>ةًۭ مِّ</><w>ن رَّ</>بِّكَ ۖ فَلَا تَكُونَ<g>نَّ</> ظَهِي<w>رًۭا لِّ</>لْ<m>كَٰ</>فِ<p>رِي</>نَ"},{"n":87,"w":[["وَلَا","walā","And (let) not","এবং না"],["يَصُدُّنَّكَ","yaṣuddunnaka","avert you","তোমাকে কিছুতেই (যেন) ফিরিয়ে রাখতে পারে"],["عَنْ","‘an","from","হ'তে"],["ءَايَـٰتِ","āyāti","(the) Verses","আয়াত"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["بَعْدَ","ba‘da","after","এরপর"],["إِذْ","idh","[when]","যখন"],["أُنزِلَتْ","unzilat","they have been revealed","অবতীর্ণ করা হয়েছে"],["إِلَيْكَ ۖ","ilayka","to you","প্রতি তোমার"],["وَٱدْعُ","wa-ud'‘u","And invite (people)","আর আহবান করো"],["إِلَىٰ","ilā","to","দিকে"],["رَبِّكَ ۖ","rabbika","your Lord","তোমার রবের"],["وَلَا","walā","And (do) not","এবং না"],["تَكُونَنَّ","takūnanna","be","তুমি কিছুতেই হয়ো"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْمُشْرِكِينَ","l-mush'rikīna","the polytheists","মুশরিকদের"]],"t":"وَلَا يَصُدُّ<g>نَّ</>كَ عَنْ ءَا<m>يَٰ</>تِ <h>ٱ</>للَّهِ بَعْدَ إِذْ أُ<k>نزِ</>لَتْ إِلَيْكَ ۖ وَ<h>ٱ</><q>دْ</>عُ إِلَىٰ رَبِّكَ ۖ وَلَا تَكُونَ<g>نَّ</> مِنَ <h>ٱ</>لْمُشْرِ<p>كِي</>نَ"},{"n":88,"w":[["وَلَا","walā","And (do) not","আর না"],["تَدْعُ","tad‘u","invoke","ডেকো"],["مَعَ","ma‘a","with","সাথে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["إِلَـٰهًا","ilāhan","god","উপাস্যকে"],["ءَاخَرَ ۘ","ākhara","other","অন্য কোনো"],["لَآ","lā","(There is) no","নেই"],["إِلَـٰهَ","ilāha","god","কোনো ইলাহ"],["إِلَّا","illā","except","ছাড়া"],["هُوَ ۚ","huwa","Him","তিনি"],["كُلُّ","kullu","Every","প্রত্যেকটি"],["شَىْءٍ","shayin","thing","বস্তু"],["هَالِكٌ","hālikun","(will be) destroyed","ধ্বংসশীল"],["إِلَّا","illā","except","ব্যতীত"],["وَجْهَهُۥ ۚ","wajhahu","His Face","তাঁর সত্ত্বা (চেহারা)"],["لَهُ","lahu","To Him","জন্যে তাঁরই"],["ٱلْحُكْمُ","l-ḥuk'mu","(is) the Decision","বিধান"],["وَإِلَيْهِ","wa-ilayhi","and to Him","আর দিকে তাঁরই"],["تُرْجَعُونَ","tur'ja‘ūna","you will be returned","প্রত্যাবর্তিত হবে তোমরা"]],"t":"وَلَا تَ<q>دْ</>عُ مَعَ <h>ٱ</>للَّهِ إِ<m>لَٰ</>هًا ءَاخَرَ ۘ <o>لَآ</> إِ<m>لَٰ</>هَ إِلَّا هُوَ ۚ كُلُّ شَىْءٍ هَالِكٌ إِلَّا وَ<q>جْ</>هَهُ<m>ۥ</> ۚ لَهُ <h>ٱ</>لْحُكْمُ وَإِلَيْهِ تُرْجَ<p>عُو</>نَ"}]}