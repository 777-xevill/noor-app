{"n":64,"a":[{"n":1,"w":[["يُسَبِّحُ","yusabbiḥu","Glorifies","মহিমা ঘোষণা করে"],["لِلَّهِ","lillahi","[to] Allah","আল্লাহ্‌র জন্যে"],["مَا","mā","whatever","যা"],["فِى","fī","(is) in","মধ্যে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আসমানসমূহের"],["وَمَا","wamā","and whatever","ও যা"],["فِى","fī","(is) in","মধ্যে (আছে)"],["ٱلْأَرْضِ ۖ","l-arḍi","the earth","পৃথিবীর"],["لَهُ","lahu","For Him","তাঁরই জন্যে"],["ٱلْمُلْكُ","l-mul'ku","(is the) dominion","সার্বভৌমত্ব"],["وَلَهُ","walahu","and for Him","ও তাঁর জন্যেই"],["ٱلْحَمْدُ ۖ","l-ḥamdu","(is) the praise","সব প্রশংসা"],["وَهُوَ","wahuwa","And He","ও তিনিই"],["عَلَىٰ","‘alā","(is) on","উপর"],["كُلِّ","kulli","every","সব"],["شَىْءٍۢ","shayin","thing","কিছুর"],["قَدِيرٌ","qadīrun","All-Powerful","ক্ষমতাবান"]],"t":"يُسَبِّحُ لِلَّهِ مَا فِى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَمَا فِى <h>ٱ</>لْأَرْضِ ۖ لَهُ <h>ٱ</>لْمُلْكُ وَلَهُ <h>ٱ</>لْحَمْدُ ۖ وَهُوَ عَلَىٰ كُلِّ <k>شَىْءٍۢ قَ</><p>دِي</>رٌ"},{"n":2,"w":[["هُوَ","huwa","He","তিনিই"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["خَلَقَكُمْ","khalaqakum","created you","তোমাদের সৃষ্টি করেছেন"],["فَمِنكُمْ","faminkum","and among you","অতঃপর তোমাদের  মধ্যে"],["كَافِرٌۭ","kāfirun","(is) a disbeliever","(কেউ) কাফির"],["وَمِنكُم","waminkum","and among you","আবার তোমাদের মধ্যে"],["مُّؤْمِنٌۭ ۚ","mu'minun","(is) a believer","(কেউ) মু'মিন"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ্‌"],["بِمَا","bimā","of what","যা কিছু"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা কাজ কর"],["بَصِيرٌ","baṣīrun","(is) All-Seer","সব দেখেন"]],"t":"هُوَ <h>ٱ</>لَّذِى خَلَقَكُمْ فَمِ<k>نكُ</>مْ كَافِ<d>رٌۭ وَ</>مِ<k>نكُ</><y>م مُّ</>ؤْمِ<d>نٌۭ ۚ وَ</><h>ٱ</>للَّهُ بِمَا تَعْمَلُونَ بَ<p>صِي</>رٌ"},{"n":3,"w":[["خَلَقَ","khalaqa","He created","তিনি সৃষ্টি করেছেন"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশসমূহ"],["وَٱلْأَرْضَ","wal-arḍa","and the earth","ও পৃথিবীকে"],["بِٱلْحَقِّ","bil-ḥaqi","with truth","যথাযথভাবে"],["وَصَوَّرَكُمْ","waṣawwarakum","and He formed you","ও তোমাদের আকৃতি দিয়েছেন"],["فَأَحْسَنَ","fa-aḥsana","and made good","অতঃপর অতি উত্তম  করেছেন"],["صُوَرَكُمْ ۖ","ṣuwarakum","your forms","তোমাদের আকৃতি গুলো"],["وَإِلَيْهِ","wa-ilayhi","and to Him","এবং তাঁরই নিকট"],["ٱلْمَصِيرُ","l-maṣīru","(is) the final return","প্রত্যাবর্তন স্থল"]],"t":"خَلَقَ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضَ بِ<h>ٱ</>لْحَقِّ وَصَوَّرَكُمْ فَأَحْسَنَ صُوَرَكُمْ ۖ وَإِلَيْهِ <h>ٱ</>لْمَ<p>صِي</>رُ"},{"n":4,"w":[["يَعْلَمُ","ya‘lamu","He knows","তিনি জানেন"],["مَا","mā","what","যা"],["فِى","fī","(is) in","মধ্যে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশ জগতের"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃৃথিবীর"],["وَيَعْلَمُ","waya‘lamu","and He knows","ও তিনি জানেন"],["مَا","mā","what","যা"],["تُسِرُّونَ","tusirrūna","you conceal","তোমরা গোপন"],["وَمَا","wamā","and what","ও যা"],["تُعْلِنُونَ ۚ","tu‘'linūna","you declare","তোমরা প্রকাশ কর"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ্‌"],["عَلِيمٌۢ","‘alīmun","(is) All-Knowing","খুব জানেন"],["بِذَاتِ","bidhāti","of what","অবস্থা সম্পর্কে"],["ٱلصُّدُورِ","l-ṣudūri","(is in) the breasts","অন্তরসমূহের"]],"t":"يَعْلَمُ مَا فِى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ وَيَعْلَمُ مَا تُسِرُّونَ وَمَا تُعْلِنُونَ ۚ وَ<h>ٱ</>للَّهُ عَلِي<i>مٌۢ بِ</>ذَاتِ <h>ٱ</><l>ل</>صُّ<p>دُو</>رِ"},{"n":5,"w":[["أَلَمْ","alam","Has not","নাই কি"],["يَأْتِكُمْ","yatikum","come to you","তোমাদের কাছে আসে"],["نَبَؤُا۟","naba-u","(the) news","খবর"],["ٱلَّذِينَ","alladhīna","(of) those who","যারা"],["كَفَرُوا۟","kafarū","disbelieved","কুফরি করেছিল"],["مِن","min","from","মধ্য হতে"],["قَبْلُ","qablu","before","ইতিপূর্বে"],["فَذَاقُوا۟","fadhāqū","So they tasted","অতঃপর তারা স্বাদ নিয়েছে"],["وَبَالَ","wabāla","(the bad) consequence","কুফল"],["أَمْرِهِمْ","amrihim","(of) their affair","তাদের কাজের"],["وَلَهُمْ","walahum","and for them","এবং তাদের জন্যে"],["عَذَابٌ","‘adhābun","(is) a punishment","আযাব"],["أَلِيمٌۭ","alīmun","painful","যন্ত্রনাদায়ক"]],"t":"أَلَمْ يَأْتِكُمْ نَبَؤُ<s>ا۟</> <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> مِ<k>ن قَ</><q>بْ</>لُ فَذَاقُو<s>ا۟</> وَبَالَ أَمْرِهِمْ وَلَهُمْ عَذَابٌ أَ<p>لِي</>مٌۭ"},{"n":6,"w":[["ذَٰلِكَ","dhālika","That","এটা"],["بِأَنَّهُۥ","bi-annahu","(is) because","এ জন্যে যে"],["كَانَت","kānat","had","(ছিল)"],["تَّأْتِيهِمْ","tatīhim","come to them","তাদের কাছে আসতো"],["رُسُلُهُم","rusuluhum","their Messengers","তাদের রাসূলগণ"],["بِٱلْبَيِّنَـٰتِ","bil-bayināti","with clear proofs","স্পষ্ট নিদর্শনাদিসহ"],["فَقَالُوٓا۟","faqālū","but they said","অতঃপর তারা বলেছিল"],["أَبَشَرٌۭ","abasharun","Shall human beings","\"মানুষই কি"],["يَهْدُونَنَا","yahdūnanā","guide us","আমাদেরকে পথ দেখাবে\""],["فَكَفَرُوا۟","fakafarū","So they disbelieved","এভাবে তারা কুফরি  করল"],["وَتَوَلَّوا۟ ۚ","watawallaw","and turned away","ও তারা মুখ ফিরালো"],["وَّٱسْتَغْنَى","wa-is'taghnā","And can do without them","ও বেপরোয়া হলেন"],["ٱللَّهُ ۚ","l-lahu","Allah","আল্লাহ্‌"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ্‌"],["غَنِىٌّ","ghaniyyun","(is) Self-sufficient","পরোয়াহীন"],["حَمِيدٌۭ","ḥamīdun","Praiseworthy","সুপ্রশংসিত"]],"t":"<m>ذَٰ</>لِكَ بِأَ<g>نَّ</>هُ<m>ۥ</> كَانَت تَّأْتِيهِمْ رُسُلُ<f>هُم بِ</><h>ٱ</>لْبَيِّ<m>نَٰ</>تِ فَقَا<o>لُوٓ</><s>ا۟</> أَبَشَ<d>رٌۭ يَ</>هْدُونَنَا فَكَفَرُو<s>ا۟</> وَتَوَلَّو<s>ا۟ ۚ</> وَّ<h>ٱ</>سْتَغْنَى <h>ٱ</>للَّهُ ۚ وَ<h>ٱ</>للَّهُ غَنِىٌّ حَ<p>مِي</><q>دٌۭ</>"},{"n":7,"w":[["زَعَمَ","za‘ama","Claim","দাবী করে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوٓا۟","kafarū","disbelieve","কুফরি করেছে"],["أَن","an","that","যে"],["لَّن","lan","never","কক্ষনো না"],["يُبْعَثُوا۟ ۚ","yub'‘athū","will they be raised","তাদের পুনরায় উঠানো হবে"],["قُلْ","qul","Say","বলো"],["بَلَىٰ","balā","Yes","\"অবশ্যই হবে"],["وَرَبِّى","warabbī","by my Lord","কসম আমার রবের"],["لَتُبْعَثُنَّ","latub'‘athunna","surely you will be raised","অবশ্যই তোমাদের  উঠানো হবে"],["ثُمَّ","thumma","then","এরপর"],["لَتُنَبَّؤُنَّ","latunabba-unna","surely you will be informed","অবশ্যই তোমাদের খবর দেয়া হবে"],["بِمَا","bimā","of what","যা কিছুু"],["عَمِلْتُمْ ۚ","‘amil'tum","you did","তোমরা কাজ করেছো"],["وَذَٰلِكَ","wadhālika","And that","এবং এটা"],["عَلَى","‘alā","for","পক্ষে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌র"],["يَسِيرٌۭ","yasīrun","(is) easy","সহজ\""]],"t":"زَعَمَ <h>ٱ</>لَّذِينَ كَفَ<o>رُوٓ</><s>ا۟</> <w>أَن لَّ</><d>ن يُ</><q>بْ</>عَثُو<s>ا۟ ۚ</> قُلْ بَلَىٰ وَرَبِّى لَتُ<q>بْ</>عَثُ<g>نَّ</> ثُ<g>مَّ</> لَتُنَبَّؤُ<g>نَّ</> بِمَا عَمِلْتُمْ ۚ وَ<m>ذَٰ</>لِكَ عَلَى <h>ٱ</>للَّهِ يَ<p>سِي</>رٌۭ"},{"n":8,"w":[["فَـَٔامِنُوا۟","faāminū","So believe","অতএব তোমরা ঈমান আনো"],["بِٱللَّهِ","bil-lahi","in Allah","আল্লাহ্‌র উপর"],["وَرَسُولِهِۦ","warasūlihi","and His Messenger","ও তাঁর রাসূলের"],["وَٱلنُّورِ","wal-nūri","and the Light","ও নূরের (কোরানের)"],["ٱلَّذِىٓ","alladhī","which","যা"],["أَنزَلْنَا ۚ","anzalnā","We have sent down","আমরা নাযিল করেছি"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ্‌"],["بِمَا","bimā","of what","যা কিছু"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা কাজ করছ"],["خَبِيرٌۭ","khabīrun","(is) All-Aware","খুব অবহিত"]],"t":"فَـَٔامِنُو<s>ا۟</> بِ<h>ٱ</>للَّهِ وَرَسُولِ<m>هِۦ</> وَ<h>ٱ</><l>ل</><g>نُّ</>ورِ <h>ٱ</>لَّ<o>ذِىٓ</> أَ<k>نزَ</>لْنَا ۚ وَ<h>ٱ</>للَّهُ بِمَا تَعْمَلُونَ خَ<p>بِي</>رٌۭ"},{"n":9,"w":[["يَوْمَ","yawma","(The) Day","যেদিন"],["يَجْمَعُكُمْ","yajma‘ukum","He will assemble you","তোমাদের একত্রিত করবেন"],["لِيَوْمِ","liyawmi","for (the) Day","দিনের জন্যে"],["ٱلْجَمْعِ ۖ","l-jam‘i","(of) the Assembly","সমাবেশের"],["ذَٰلِكَ","dhālika","that","সেই"],["يَوْمُ","yawmu","(will be the) Day","দিন"],["ٱلتَّغَابُنِ ۗ","l-taghābuni","(of) mutual loss and gain","হার-জিতের"],["وَمَن","waman","And whoever","এবং যে"],["يُؤْمِنۢ","yu'min","believes","ঈমান আনে"],["بِٱللَّهِ","bil-lahi","in Allah","আল্লাহ্‌র উপর"],["وَيَعْمَلْ","waya‘mal","and does","ও কাজ করে"],["صَـٰلِحًۭا","ṣāliḥan","righteous deeds","নেক"],["يُكَفِّرْ","yukaffir","He will remove","মোচন করবেন"],["عَنْهُ","‘anhu","from him","তার থেকে"],["سَيِّـَٔاتِهِۦ","sayyiātihi","his evil deeds","তার গুনাহগুলো"],["وَيُدْخِلْهُ","wayud'khil'hu","and He will admit him","এবং তাকে প্রবেশ করাবেন"],["جَنَّـٰتٍۢ","jannātin","(to) Gardens","জান্নাতে"],["تَجْرِى","tajrī","flow","প্রবাহিত হয়"],["مِن","min","from","হতে"],["تَحْتِهَا","taḥtihā","underneath it","তার পাদদেশ"],["ٱلْأَنْهَـٰرُ","l-anhāru","the rivers","ঝর্ণাধারাগুলো"],["خَـٰلِدِينَ","khālidīna","abiding","বসবাসকারী স্থায়ী"],["فِيهَآ","fīhā","therein","তার মধ্যে"],["أَبَدًۭا ۚ","abadan","forever","চিরকাল"],["ذَٰلِكَ","dhālika","That","এটা"],["ٱلْفَوْزُ","l-fawzu","(is) the success","সাফল্য"],["ٱلْعَظِيمُ","l-‘aẓīmu","the great","বড়"]],"t":"يَوْمَ يَ<q>جْ</>مَعُكُمْ لِيَوْمِ <h>ٱ</>لْجَمْعِ ۖ <m>ذَٰ</>لِكَ يَوْمُ <h>ٱ</><l>ل</>تَّغَابُنِ ۗ وَ<d>مَن يُ</>ؤْ<i>مِنۢ بِ</><h>ٱ</>للَّهِ وَيَعْمَلْ <m>صَٰ</>لِ<d>حًۭا يُ</>كَفِّرْ عَنْهُ سَيِّـَٔاتِ<m>هِۦ</> وَيُ<q>دْ</>خِلْهُ جَ<g>نَّٰ</><k>تٍۢ تَ</><q>جْ</>رِى مِ<k>ن تَ</>حْتِهَا <h>ٱ</>لْأَنْ<m>هَٰ</>رُ <m>خَٰ</>لِدِينَ فِي<o>هَآ</> أَبَ<k>دًۭا ۚ ذَٰ</>لِكَ <h>ٱ</>لْفَوْزُ <h>ٱ</>لْعَ<p>ظِي</>مُ"},{"n":10,"w":[["وَٱلَّذِينَ","wa-alladhīna","But those who","এবং যারা"],["كَفَرُوا۟","kafarū","disbelieved","কুফরি করেছে"],["وَكَذَّبُوا۟","wakadhabū","and denied","ও মিথ্যারোপ করেছে"],["بِـَٔايَـٰتِنَآ","biāyātinā","[in] Our Verses","আমাদের আয়াত গুলোকে"],["أُو۟لَـٰٓئِكَ","ulāika","those","ঐসব লোক"],["أَصْحَـٰبُ","aṣḥābu","(are the) companions","অধিবাসী"],["ٱلنَّارِ","l-nāri","(of) the Fire","দোজখের"],["خَـٰلِدِينَ","khālidīna","abiding forever","বসবাসকারী স্থায়ী"],["فِيهَا ۖ","fīhā","therein","তার মধ্যে"],["وَبِئْسَ","wabi'sa","And wretched is","এবং কত নিকৃষ্ট"],["ٱلْمَصِيرُ","l-maṣīru","the destination","প্রত্যাবর্তন স্থল"]],"t":"وَ<h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> وَكَذَّبُو<s>ا۟</> بِـَٔا<m>يَٰ</>تِ<o>نَآ</> أُ<s>و۟</><o>لَٰٓ</>ئِكَ أَصْ<m>حَٰ</>بُ <h>ٱ</><l>ل</><g>نَّ</>ارِ <m>خَٰ</>لِدِينَ فِيهَا ۖ وَبِئْسَ <h>ٱ</>لْمَ<p>صِي</>رُ"},{"n":11,"w":[["مَآ","mā","Not","না"],["أَصَابَ","aṣāba","strikes","আপতিত হয়"],["مِن","min","any","কোন"],["مُّصِيبَةٍ","muṣībatin","disaster","মুসিবত"],["إِلَّا","illā","except","ব্যতিরেকে"],["بِإِذْنِ","bi-idh'ni","by (the) permission","অনুমতি"],["ٱللَّهِ ۗ","l-lahi","(of) Allah","আল্লাহ্‌র"],["وَمَن","waman","And whoever","এবং যে"],["يُؤْمِنۢ","yu'min","believes","ঈমান আনে"],["بِٱللَّهِ","bil-lahi","in Allah","আল্লাহ্‌র উপরে"],["يَهْدِ","yahdi","He guides","হেদায়াত দেন তিনি"],["قَلْبَهُۥ ۚ","qalbahu","his heart","তার অন্তরকে"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ্‌"],["بِكُلِّ","bikulli","of every","সব"],["شَىْءٍ","shayin","thing","কিছু (সম্পর্কে)"],["عَلِيمٌۭ","‘alīmun","(is) All-Knowing","খুব অবগত"]],"t":"<o>مَآ</> أَصَابَ <d>مِن مُّ</>صِيبَةٍ إِلَّا بِإِذْنِ <h>ٱ</>للَّهِ ۗ وَ<d>مَن يُ</>ؤْ<i>مِنۢ بِ</><h>ٱ</>للَّهِ يَهْدِ قَلْبَهُ<m>ۥ</> ۚ وَ<h>ٱ</>للَّهُ بِكُلِّ شَىْءٍ عَ<p>لِي</>مٌۭ"},{"n":12,"w":[["وَأَطِيعُوا۟","wa-aṭī‘ū","So obey","এবং তোমরা আনুগত্য কর"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌র"],["وَأَطِيعُوا۟","wa-aṭī‘ū","and obey","ও আনুগত্য কর"],["ٱلرَّسُولَ ۚ","l-rasūla","the Messenger","রাসূলের"],["فَإِن","fa-in","but if","অতঃপর যদি"],["تَوَلَّيْتُمْ","tawallaytum","you turn away","তোমরা ফিরে যাও"],["فَإِنَّمَا","fa-innamā","then only","তবে মূলতঃ"],["عَلَىٰ","‘alā","upon","উপর"],["رَسُولِنَا","rasūlinā","Our Messenger","আমাদের রাসূলের"],["ٱلْبَلَـٰغُ","l-balāghu","(is) the conveyance","পৌঁছান (দায়িত্ব)"],["ٱلْمُبِينُ","l-mubīnu","clear","সুস্পষ্টভাবে"]],"t":"وَأَطِيعُو<s>ا۟</> <h>ٱ</>للَّهَ وَأَطِيعُو<s>ا۟</> <h>ٱ</><l>ل</>رَّسُولَ ۚ فَإِ<k>ن تَ</>وَلَّيْتُمْ فَإِ<g>نَّ</>مَا عَلَىٰ رَسُولِنَا <h>ٱ</>لْبَ<m>لَٰ</>غُ <h>ٱ</>لْمُ<p>بِي</>نُ"},{"n":13,"w":[["ٱللَّهُ","al-lahu","Allah","আল্লাহ্‌"],["لَآ","lā","(there is) no","নেই"],["إِلَـٰهَ","ilāha","god","ইলাহ"],["إِلَّا","illā","except","ছাড়া"],["هُوَ ۚ","huwa","Him","তিনি"],["وَعَلَى","wa‘alā","And upon","এবং উপর"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌র"],["فَلْيَتَوَكَّلِ","falyatawakkali","let put (their) trust","সুতরাং ভরসা করুক"],["ٱلْمُؤْمِنُونَ","l-mu'minūna","the believers","মু'মিনগণ"]],"t":"ٱللَّهُ <o>لَآ</> إِ<m>لَٰ</>هَ إِلَّا هُوَ ۚ وَعَلَى <h>ٱ</>للَّهِ فَلْيَتَوَكَّلِ <h>ٱ</>لْمُؤْمِ<p>نُو</>نَ"},{"n":14,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O","ওহে"],["ٱلَّذِينَ","alladhīna","(you) who","যারা"],["ءَامَنُوٓا۟","āmanū","believe","ঈমান এনেছো"],["إِنَّ","inna","Indeed","নিশ্চয়"],["مِنْ","min","from","মধ্যে"],["أَزْوَٰجِكُمْ","azwājikum","your spouses","তোমাদের স্ত্রীদের"],["وَأَوْلَـٰدِكُمْ","wa-awlādikum","and your children","ও তোমাদের সন্তান সন্ততিদের (কেউ কেউ)"],["عَدُوًّۭا","‘aduwwan","(are) enemies","শত্রু"],["لَّكُمْ","lakum","to you","তোমাদের জন্যে"],["فَٱحْذَرُوهُمْ ۚ","fa-iḥ'dharūhum","so beware of them","অতএব তাদের থেকে সতর্ক হও"],["وَإِن","wa-in","But if","এবং যদি"],["تَعْفُوا۟","ta‘fū","you pardon","তোমরা মার্জনা কর"],["وَتَصْفَحُوا۟","wataṣfaḥū","and overlook","ও তোমরা উপেক্ষা কর"],["وَتَغْفِرُوا۟","wataghfirū","and forgive","এবং তোমরা মাফ কর"],["فَإِنَّ","fa-inna","then indeed","তবে নিশ্চয়"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["غَفُورٌۭ","ghafūrun","(is) Oft-Forgiving","ক্ষমাশীল"],["رَّحِيمٌ","raḥīmun","Most Merciful","মেহেরবান"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَ<o>نُوٓ</><s>ا۟</> إِ<g>نَّ</> مِنْ أَزْ<m>وَٰ</>جِكُمْ وَأَوْ<m>لَٰ</>دِكُمْ عَدُ<w>وًّۭا لَّ</>كُمْ فَ<h>ٱ</>حْذَرُوهُمْ ۚ وَإِ<k>ن تَ</>عْفُو<s>ا۟</> وَتَصْفَحُو<s>ا۟</> وَتَغْفِرُو<s>ا۟</> فَإِ<g>نَّ</> <h>ٱ</>للَّهَ غَفُو<w>رٌۭ رَّ</><p>حِي</>مٌ"},{"n":15,"w":[["إِنَّمَآ","innamā","Only","মূলতঃ"],["أَمْوَٰلُكُمْ","amwālukum","your wealth","তোমাদের মালগুলো"],["وَأَوْلَـٰدُكُمْ","wa-awlādukum","and your children","ও তোমাদের সন্তান সন্ততিরা"],["فِتْنَةٌۭ ۚ","fit'natun","(are) a trial","পরীক্ষা"],["وَٱللَّهُ","wal-lahu","and Allah ","এবং আল্লাহ্‌"],["عِندَهُۥٓ","‘indahu","with Him","তাঁর কাছে (আছে)"],["أَجْرٌ","ajrun","(is) a reward","প্রতিফল"],["عَظِيمٌۭ","‘aẓīmun","great","বড়"]],"t":"إِ<g>نَّ</><o>مَآ</> أَمْ<m>وَٰ</>لُكُمْ وَأَوْ<m>لَٰ</>دُكُمْ فِتْنَ<d>ةٌۭ ۚ وَ</><h>ٱ</>للَّهُ عِ<k>ندَ</>هُ<o>ۥٓ</> أَ<q>جْ</>رٌ عَ<p>ظِي</>مٌۭ"},{"n":16,"w":[["فَٱتَّقُوا۟","fa-ittaqū","So fear","অতএব তোমরা ভয় করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["مَا","mā","what","যতটা"],["ٱسْتَطَعْتُمْ","is'taṭa‘tum","you are able","তোমরা পারো"],["وَٱسْمَعُوا۟","wa-is'ma‘ū","and listen","ও তোমরা শুনো"],["وَأَطِيعُوا۟","wa-aṭī‘ū","and obey","ও তোমরা আনুগত্য করো"],["وَأَنفِقُوا۟","wa-anfiqū","and spend","তোমরা খরচ করো"],["خَيْرًۭا","khayran","(it is) better","উত্তম"],["لِّأَنفُسِكُمْ ۗ","li-anfusikum","for yourselves","তোমাদের নিজেদের জন্যে"],["وَمَن","waman","And whoever","এবং যে"],["يُوقَ","yūqa","is saved","রক্ষা পেল"],["شُحَّ","shuḥḥa","(from the) greediness","সংকীর্ণতা (থেকে)"],["نَفْسِهِۦ","nafsihi","(of) his soul","তার মনের"],["فَأُو۟لَـٰٓئِكَ","fa-ulāika","then those","তবে ঐসব লোক"],["هُمُ","humu","[they]","তারাই"],["ٱلْمُفْلِحُونَ","l-muf'liḥūna","(are) the successful ones","সফলকাম"]],"t":"فَ<h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</>للَّهَ مَا <h>ٱ</>سْتَطَعْتُمْ وَ<h>ٱ</>سْمَعُو<s>ا۟</> وَأَطِيعُو<s>ا۟</> وَأَ<k>نفِ</>قُو<s>ا۟</> خَيْ<w>رًۭا لِّ</>أَ<k>نفُ</>سِكُمْ ۗ وَ<d>مَن يُ</>وقَ شُحَّ نَفْسِ<m>هِۦ</> فَأُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</>لْمُفْلِ<p>حُو</>نَ"},{"n":17,"w":[["إِن","in","If","যদি"],["تُقْرِضُوا۟","tuq'riḍū","you loan","তোমরা কর্জ দাও"],["ٱللَّهَ","l-laha","(to) Allah","আল্লাহকে"],["قَرْضًا","qarḍan","a loan","কর্জ"],["حَسَنًۭا","ḥasanan","goodly","উত্তম"],["يُضَـٰعِفْهُ","yuḍā‘if'hu","He will multiply it","তা বহু গুণ করবেন"],["لَكُمْ","lakum","for you","তোমাদের জন্যে"],["وَيَغْفِرْ","wayaghfir","and will forgive","ও মাফ করবেন"],["لَكُمْ ۚ","lakum","you","তোমাদেরকে"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ্‌"],["شَكُورٌ","shakūrun","(is) Most Appreciative","গুণগ্রাহী"],["حَلِيمٌ","ḥalīmun","Most Forbearing","ধৈর্যশীল"]],"t":"إِ<k>ن تُ</><q>قْ</>رِضُو<s>ا۟</> <h>ٱ</>للَّهَ قَرْضًا حَسَ<d>نًۭا يُ</><m>ضَٰ</>عِفْهُ لَكُمْ وَيَغْفِرْ لَكُمْ ۚ وَ<h>ٱ</>للَّهُ شَكُورٌ حَ<p>لِي</>مٌ"},{"n":18,"w":[["عَـٰلِمُ","‘ālimu","(The) Knower","পরিজ্ঞাতা"],["ٱلْغَيْبِ","l-ghaybi","(of) the unseen","অদৃশ্যের"],["وَٱلشَّهَـٰدَةِ","wal-shahādati","and the witnessed","ও দৃশ্যের"],["ٱلْعَزِيزُ","l-‘azīzu","the All-Mighty","মহাপরাক্রমশালী"],["ٱلْحَكِيمُ","l-ḥakīmu","the All-Wise","প্রজ্ঞাময়"]],"t":"<m>عَٰ</>لِمُ <h>ٱ</>لْغَيْبِ وَ<h>ٱ</><l>ل</>شَّ<m>هَٰ</>دَةِ <h>ٱ</>لْعَزِيزُ <h>ٱ</>لْحَ<p>كِي</>مُ"}]}