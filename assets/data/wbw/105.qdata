{"n":105,"a":[{"n":1,"w":[["أَلَمْ","alam","Have not","নাই কি"],["تَرَ","tara","you seen","তুমি দেখো"],["كَيْفَ","kayfa","how","কেমন"],["فَعَلَ","fa‘ala","dealt","করেছেন"],["رَبُّكَ","rabbuka","your Lord","তোমার রব"],["بِأَصْحَـٰبِ","bi-aṣḥābi","with (the) Companions","বাহিনীর সাথে"],["ٱلْفِيلِ","l-fīli","(of the) Elephant","হাতি"]],"t":"أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْ<m>حَٰ</>بِ <h>ٱ</>لْ<p>فِي</>لِ"},{"n":2,"w":[["أَلَمْ","alam","Did not","নাই কি"],["يَجْعَلْ","yaj‘al","He make","তিনি পরণত করে"],["كَيْدَهُمْ","kaydahum","their plan","তাদের ষড়যন্ত্রকে"],["فِى","fī","go","মধ্যে"],["تَضْلِيلٍۢ","taḍlīlin","astray","নিষ্ফলতার"]],"t":"أَلَمْ يَ<q>جْ</>عَلْ كَيْدَهُمْ فِى تَضْ<p>لِي</>لٍۢ"},{"n":3,"w":[["وَأَرْسَلَ","wa-arsala","And He sent","এবং পাঠিয়েছেন"],["عَلَيْهِمْ","‘alayhim","against them","তাদের বিরুদ্ধে"],["طَيْرًا","ṭayran","birds","পাখি"],["أَبَابِيلَ","abābīla","(in) flocks","ঝাঁকে ঝাঁকে"]],"t":"وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَا<p>بِي</>لَ"},{"n":4,"w":[["تَرْمِيهِم","tarmīhim","Striking them","তাদের উপর নিক্ষেপ করে"],["بِحِجَارَةٍۢ","biḥijāratin","with stones","পাথরসমূহকে"],["مِّن","min","of","হতে"],["سِجِّيلٍۢ","sijjīlin","baked clay","কংকরের"]],"t":"تَرْمِي<f>هِم بِ</>حِجَارَ<d>ةٍۢ مِّ</><k>ن سِ</><p>جِّي</>لٍۢ"},{"n":5,"w":[["فَجَعَلَهُمْ","faja‘alahum","Then He made them","অতঃপর তিনি তাদের করে দেন"],["كَعَصْفٍۢ","ka‘aṣfin","like straw","ভুসির মতো"],["مَّأْكُولٍۭ","makūlin","eaten up","খাওয়া/ভক্ষিত"]],"t":"فَجَعَلَهُمْ كَعَصْ<d>فٍۢ مَّ</>أْ<p>كُو</>لٍۭ"}]}