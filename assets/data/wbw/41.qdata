worthy","সুপ্রশংসিত"]],"t":"لَّا يَأْتِيهِ <h>ٱ</>لْ<m>بَٰ</>طِلُ <i>مِنۢ بَ</>يْنِ يَدَيْهِ وَلَا مِنْ خَلْفِ<m>هِۦ</> ۖ تَ<k>نزِ</>ي<d>لٌۭ مِّ</>نْ حَكِيمٍ حَ<p>مِي</><q>دٍۢ</>"},{"n":43,"w":[["مَّا","mā","Not","(হে নাবী) না"],["يُقَالُ","yuqālu","is said","বলা হচ্ছে"],["لَكَ","laka","to you","তোমাকে"],["إِلَّا","illā","except","এ ব্যতীত"],["مَا","mā","what","যা"],["قَدْ","qad","was said","নিশ্চয়ই"],["قِيلَ","qīla","was said","বলা হয়েছে"],["لِلرُّسُلِ","lilrrusuli","to the Messengers","রাসূলগণকে"],["مِن","min","before you","পূর্বে"],["قَبْلِكَ ۚ","qablika","before you","তোমার"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["رَبَّكَ","rabbaka","your Lord","তোমার রব"],["لَذُو","ladhū","(is) Possessor","অধিকারী"],["مَغْفِرَةٍۢ","maghfiratin","(of) forgiveness","ক্ষমার অবশ্যই"],["وَذُو","wadhū","and Possessor","আবার অধিকারী"],["عِقَابٍ","‘iqābin","(of) penalty","শাস্তিদানের"],["أَلِيمٍۢ","alīmin","painful","কষ্টদায়ক"]],"t":"مَّا يُقَالُ لَكَ إِلَّا مَا قَ<q>دْ</> قِيلَ لِلرُّسُلِ مِ<k>ن قَ</><q>بْ</>لِكَ ۚ إِ<g>نَّ</> رَبَّكَ لَذُو مَغْفِرَ<d>ةٍۢ وَ</>ذُو عِقَابٍ أَ<p>لِي</>مٍۢ"},{"n":44,"w":[["وَلَوْ","walaw","And if","এবং যদি"],["جَعَلْنَـٰهُ","ja‘alnāhu","We (had) made it","তা আমরা অবতীর্ণ করতাম"],["قُرْءَانًا","qur'ānan","a Quran","(অর্থাৎ) কুরআন"],["أَعْجَمِيًّۭا","a‘jamiyyan","(in) a foreign (language)","অনারবী (ভাষায়)"],["لَّقَالُوا۟","laqālū","they (would have) said","অবশ্যই তারা বলতো"],["لَوْلَا","lawlā","Why not","\"কেন না"],["فُصِّلَتْ","fuṣṣilat","are explained in detail","বিশদভাবে বিবৃত হলো"],["ءَايَـٰتُهُۥٓ ۖ","āyātuhu","its verses","তার আয়াতগুলো"],["ءَا۬عْجَمِىٌّۭ","ā‘'jamiyyun","(Is it) a foreign (language)","(আশ্চর্য নয়) কি অনারবী (কুরআন)"],["وَعَرَبِىٌّۭ ۗ","wa‘arabiyyun","and an Arab","আর আরবী (রাসূল ও তাঁর জাতি)\""],["قُلْ","qul","Say","বলো"],["هُوَ","huwa","It (is)","\"তা (অর্থাৎ কুরআন)"],["لِلَّذِينَ","lilladhīna","for those who","(তাদের) জন্যে যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["هُدًۭى","hudan","a guidance","পথনির্দেশনা"],["وَشِفَآءٌۭ ۖ","washifāon","and a healing","ও ব্যাধির প্রতিকার\""],["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["لَا","lā","(do) not","না"],["يُؤْمِنُونَ","yu'minūna","believe","ঈমান আনে"],["فِىٓ","fī","in","মধ্যে (আছে)"],["ءَاذَانِهِمْ","ādhānihim","their ears","তাদের কানগুলোর"],["وَقْرٌۭ","waqrun","(is) deafness","এবং বধিরতা"],["وَهُوَ","wahuwa","and it","এবং তা"],["عَلَيْهِمْ","‘alayhim","(is) for them","তাদের উপর (আছে)"],["عَمًى ۚ","‘aman","blindness","অন্ধত্ব"],["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐ সব লোককে"],["يُنَادَوْنَ","yunādawna","are being called","ডাকা হচ্ছে তাদেরকে যেন"],["مِن","min","from","হ'তে"],["مَّكَانٍۭ","makānin","a place","স্থান"],["بَعِيدٍۢ","ba‘īdin","far","দূরবর্তী\""]],"t":"وَلَوْ جَعَلْ<m>نَٰ</>هُ قُرْءَانًا أَعْجَمِ<w>يًّۭا لَّ</>قَالُو<s>ا۟</> لَوْلَا فُصِّلَتْ ءَا<m>يَٰ</>تُهُ<o>ۥٓ ۖ</> ءَا۬عْجَمِ<d>ىٌّۭ وَ</>عَرَبِ<k>ىٌّۭ ۗ قُ</>لْ هُوَ لِلَّذِينَ ءَامَنُو<s>ا۟</> هُ<d>دًۭى وَ</>شِ<o>فَآ</><d>ءٌۭ ۖ وَ</><h>ٱ</>لَّذِينَ لَا يُؤْمِنُونَ <o>فِىٓ</> ءَاذَانِهِمْ وَ<q>قْ</><d>رٌۭ وَ</>هُوَ عَلَيْهِمْ عَمًى ۚ أُ<s>و۟</><o>لَٰٓ</>ئِكَ يُنَادَوْنَ <d>مِن مَّ</>كَا<i>نٍۭ بَ</><p>عِي</><q>دٍۢ</>"},{"n":45,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["ءَاتَيْنَا","ātaynā","We gave","আমরা দিয়েছিলাম"],["مُوسَى","mūsā","Musa","মূসাকে"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","কিতাব"],["فَٱخْتُلِفَ","fa-ukh'tulifa","but disputes arose","অতঃপর মতভেদ ঘটেছিলো"],["فِيهِ ۗ","fīhi","therein","তার মধ্যে"],["وَلَوْلَا","walawlā","And had it not been","এবং না যদি (হতো)"],["كَلِمَةٌۭ","kalimatun","(for) a word","একটি কথা"],["سَبَقَتْ","sabaqat","(that) preceded","পূর্ব নির্ধারিত"],["مِن","min","from","পক্ষ হ'তে"],["رَّبِّكَ","rabbika","your Lord","তোমার রবের"],["لَقُضِىَ","laquḍiya","surely, would have been settled","মীমাংসা করেই দেওয়া হতো"],["بَيْنَهُمْ ۚ","baynahum","between them","তাদের মাঝে"],["وَإِنَّهُمْ","wa-innahum","But indeed, they","এবং তারা নিশ্চয়ই"],["لَفِى","lafī","surely (are) in","অবশ্যই মধ্যে আছে"],["شَكٍّۢ","shakkin","doubt","সন্দেহের"],["مِّنْهُ","min'hu","about it","তা সম্বন্ধে"],["مُرِيبٍۢ","murībin","disquieting","বিভ্রান্তিকর"]],"t":"وَلَقَ<q>دْ</> ءَاتَيْنَا مُوسَى <h>ٱ</>لْكِ<m>تَٰ</>بَ فَ<h>ٱ</>خْتُلِفَ فِيهِ ۗ وَلَوْلَا كَلِمَ<k>ةٌۭ سَ</>بَقَتْ <w>مِن رَّ</>بِّكَ لَقُضِىَ بَيْنَهُمْ ۚ وَإِ<g>نَّ</>هُمْ لَفِى شَ<d>كٍّۢ مِّ</>نْهُ مُ<p>رِي</><q>بٍۢ</>"},{"n":46,"w":[["مَّنْ","man","Whoever","যে"],["عَمِلَ","‘amila","does","কাজ করবে"],["صَـٰلِحًۭا","ṣāliḥan","righteous deeds","সৎ"],["فَلِنَفْسِهِۦ ۖ","falinafsihi","then it is for his soul","(সে করবে) তা নিজের জন্যে"],["وَمَنْ","waman","and whoever","এবং যে"],["أَسَآءَ","asāa","does evil","মন্দকর্ম করবে"],["فَعَلَيْهَا ۗ","fa‘alayhā","then it is against it","(পড়বে) তা তার উপর"],["وَمَا","wamā","And not","আর নন"],["رَبُّكَ","rabbuka","(is) your Lord","তোমার রব"],["بِظَلَّـٰمٍۢ","biẓallāmin","unjust","অত্যাচারী"],["لِّلْعَبِيدِ","lil'‘abīdi","to His slaves","দাসদের উপর"]],"t":"مَّنْ عَمِلَ <m>صَٰ</>لِ<k>حًۭا فَ</>لِنَفْسِ<m>هِۦ</> ۖ وَمَنْ أَ<o>سَآ</>ءَ فَعَلَيْهَا ۗ وَمَا رَبُّكَ بِظَ<m>لَّٰ</><w>مٍۢ لِّ</>لْعَ<p>بِي</><q>دِ</>"},{"n":47,"w":[["۞ إِلَيْهِ","ilayhi","To Him","তাঁরই কাছে"],["يُرَدُّ","yuraddu","is referred","ন্যস্ত রয়েছে"],["عِلْمُ","‘il'mu","(the) knowledge","জ্ঞান"],["ٱلسَّاعَةِ ۚ","l-sā‘ati","(of) the Hour","ক্বিয়ামাতের (অর্থাৎ তিনিই জানেন কখন তা হবে)"],["وَمَا","wamā","And not","এবং না"],["تَخْرُجُ","takhruju","comes out","বের হয়"],["مِن","min","any","কোনো"],["ثَمَرَٰتٍۢ","thamarātin","fruits","ফলসমূহ"],["مِّنْ","min","from","হ'তে"],["أَكْمَامِهَا","akmāmihā","their coverings","তার আবরণ"],["وَمَا","wamā","and not","আর না"],["تَحْمِلُ","taḥmilu","bears","গর্ভধারণ করে"],["مِنْ","min","any","কোন"],["أُنثَىٰ","unthā","female","নারী"],["وَلَا","walā","and not","আর না"],["تَضَعُ","taḍa‘u","gives birth","প্রসব করে সে"],["إِلَّا","illā","except","এ ব্যতীত"],["بِعِلْمِهِۦ ۚ","bi‘il'mihi","with His knowledge","তাঁর জানা (আছে)"],["وَيَوْمَ","wayawma","And (the) Day","এবং যে দিন"],["يُنَادِيهِمْ","yunādīhim","He will call them","তাদের তিনি ডেকে বলবেন"],["أَيْنَ","ayna","Where (are)","\"কোথায়"],["شُرَكَآءِى","shurakāī","My partners","আমার শরিকরা"],["قَالُوٓا۟","qālū","They will say","তারা বলবে"],["ءَاذَنَّـٰكَ","ādhannāka","We announce (to) You","\"আপনাকে নিবেদন করছি"],["مَا","mā","not","(আজ) নেই"],["مِنَّا","minnā","among us","আমাদের মধ্যে"],["مِن","min","any","কোনো"],["شَهِيدٍۢ","shahīdin","witness","সাক্ষী (শরিকের পক্ষে)\""]],"t":"۞ إِلَيْهِ يُرَدُّ عِلْمُ <h>ٱ</><l>ل</>سَّاعَةِ ۚ وَمَا تَخْرُجُ مِ<k>ن ثَ</>مَ<m>رَٰ</><d>تٍۢ مِّ</>نْ أَكْمَامِهَا وَمَا تَحْمِلُ مِنْ أُ<k>نثَ</>ىٰ وَلَا تَضَعُ إِلَّا بِعِلْمِ<m>هِۦ</> ۚ وَيَوْمَ يُنَادِيهِمْ أَيْنَ شُرَ<o>كَآ</>ءِى قَا<o>لُوٓ</><s>ا۟</> ءَاذَ<g>نَّٰ</>كَ مَا مِ<g>نَّ</>ا مِ<k>ن شَ</><p>هِي</><q>دٍۢ</>"},{"n":48,"w":[["وَضَلَّ","waḍalla","And lost","এবং হারিয়ে যাবে"],["عَنْهُم","‘anhum","from them","তাদের থেকে"],["مَّا","mā","what","(ঐসব ইলাহ) যাদেরকে"],["كَانُوا۟","kānū","they were","তারা"],["يَدْعُونَ","yad‘ūna","invoking","ডাকতে থাকতো"],["مِن","min","before","পূর্বে"],["قَبْلُ ۖ","qablu","before","ইতি"],["وَظَنُّوا۟","waẓannū","and they (will) be certain","এবং তারা ভাববে"],["مَا","mā","(that) not","নেই"],["لَهُم","lahum","for them","তাদের জন্যে (আছে)"],["مِّن","min","any","কোনো"],["مَّحِيصٍۢ","maḥīṣin","place of escape","নিষ্কৃতি"]],"t":"وَضَلَّ عَنْ<y>هُم مَّ</>ا كَانُو<s>ا۟</> يَ<q>دْ</>عُونَ مِ<k>ن قَ</><q>بْ</>لُ ۖ وَظَ<g>نُّ</>و<s>ا۟</> مَا لَ<y>هُم مِّ</><d>ن مَّ</><p>حِي</>صٍۢ"},{"n":49,"w":[["لَّا","lā","(Does) not","না"],["يَسْـَٔمُ","yasamu","get tired","ক্লান্ত হয়"],["ٱلْإِنسَـٰنُ","l-insānu","man","মানুষ"],["مِن","min","of","থেকে"],["دُعَآءِ","du‘āi","praying","দুআ"],["ٱلْخَيْرِ","l-khayri","(for) the good","ধন-সম্পদের (অথবা কল্যাণের)"],["وَإِن","wa-in","but if","আর যদি"],["مَّسَّهُ","massahu","touches him","তাকে স্পর্শ করে"],["ٱلشَّرُّ","l-sharu","the evil","দুঃখদৈন্য"],["فَيَـُٔوسٌۭ","fayaūsun","then he gives up hope","তখন হতাশ হয়"],["قَنُوطٌۭ","qanūṭun","(and) despairs","নিরাশ (হয়)"]],"t":"لَّا يَسْـَٔمُ <h>ٱ</>لْإِ<k>نسَٰ</>نُ مِ<k>ن دُ</><o>عَآ</>ءِ <h>ٱ</>لْخَيْرِ وَ<d>إِن مَّ</>سَّهُ <h>ٱ</><l>ل</>شَّرُّ فَيَـُٔو<k>سٌۭ قَ</><p>نُو</><q>طٌۭ</>"},{"n":50,"w":[["وَلَئِنْ","wala-in","And verily, if","কিন্তু অবশ্য যদি"],["أَذَقْنَـٰهُ","adhaqnāhu","We let him taste","আমরা তাকে আস্বাদন করাই"],["رَحْمَةًۭ","raḥmatan","mercy","অনুগ্রহের"],["مِّنَّا","minnā","from Us","আমাদের পক্ষ হতে"],["مِنۢ","min","after","মধ্য হতে"],["بَعْدِ","ba‘di","after","পরে"],["ضَرَّآءَ","ḍarrāa","an adversity","বিপদাপদের"],["مَسَّتْهُ","massathu","(has) touched him","(যা) তাকে স্পর্শ করেছিলো"],["لَيَقُولَنَّ","layaqūlanna","he will surely say","সে বলে অবশ্যই"],["هَـٰذَا","hādhā","This (is)","\"এটা"],["لِى","lī","(due) to me","আমারই (প্রাপ্য)"],["وَمَآ","wamā","and not","এবং (বলে) না"],["أَظُنُّ","aẓunnu","I think","মনে করি আমি"],["ٱلسَّاعَةَ","l-sā‘ata","the Hour","ক্বিয়ামাত"],["قَآئِمَةًۭ","qāimatan","(will be) established","ঘটবে"],["وَلَئِن","wala-in","and if","এবং অবশ্যই যদি"],["رُّجِعْتُ","ruji‘'tu","I am returned","প্রত্যাবর্তিত হই আমি"],["إِلَىٰ","ilā","to","দিকে"],["رَبِّىٓ","rabbī","my Lord","আমার রবের"],["إِنَّ","inna","indeed","নিশ্চয়ই"],["لِى","lī","for me","আমার জন্যে"],["عِندَهُۥ","‘indahu","with Him","তাঁর কাছে (থাকবে)"],["لَلْحُسْنَىٰ ۚ","lalḥus'nā","(will be) the best","অবশ্যই খুব কল্যাণ\""],["فَلَنُنَبِّئَنَّ","falanunabbi-anna","But We will surely inform","আমরা অথচ জানিয়ে দিবোই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieved","অস্বীকার করেছে"],["بِمَا","bimā","about what","ঐ বিষয়ে যা"],["عَمِلُوا۟","‘amilū","they did","তারা কাজ করেছিলো"],["وَلَنُذِيقَنَّهُم","walanudhīqannahum","and We will surely make them taste","এবং তাদেরকে আমরা অবশ্যই আস্বাদন করাবোই"],["مِّنْ","min","of","থেকে"],["عَذَابٍ","‘adhābin","a punishment","শাস্তি"],["غَلِيظٍۢ","ghalīẓin","severe","কঠিন"]],"t":"وَلَئِنْ أَذَ<q>قْ</><m>نَٰ</>هُ رَحْمَ<d>ةًۭ مِّ</><g>نَّ</>ا <i>مِنۢ بَ</>عْدِ ضَ<o>رَّآ</>ءَ مَسَّتْهُ لَيَقُولَ<g>نَّ</> <m>هَٰ</>ذَا لِى وَ<o>مَآ</> أَظُ<g>نُّ</> <h>ٱ</><l>ل</>سَّاعَةَ <o>قَآ</>ئِمَ<d>ةًۭ وَ</>لَ<w>ئِن رُّ</>جِعْتُ إِلَىٰ رَ<o>بِّىٓ</> إِ<g>نَّ</> لِى عِ<k>ندَ</>هُ<m>ۥ</> لَلْحُسْنَىٰ ۚ فَلَنُنَبِّئَ<g>نَّ</> <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> بِمَا عَمِلُو<s>ا۟</> وَلَنُذِيقَ<g>نَّ</><y>هُم مِّ</>نْ عَذَابٍ غَ<p>لِي</>ظٍۢ"},{"n":51,"w":[["وَإِذَآ","wa-idhā","And when","এবং যখন"],["أَنْعَمْنَا","an‘amnā","We bestow favor","আমরা অনুগ্রহ করি"],["عَلَى","‘alā","upon","উপর"],["ٱلْإِنسَـٰنِ","l-insāni","man","মানুষের"],["أَعْرَضَ","a‘raḍa","he turns away ","সে মুখ ফিরিয়ে নেয়"],["وَنَـَٔا","wanaā","and distances himself","এবং এড়িয়ে চলে"],["بِجَانِبِهِۦ","bijānibihi","and distances himself","তার পাশ দিয়ে (অহংকার বশতঃ)"],["وَإِذَا","wa-idhā","but when","এবং যখন"],["مَسَّهُ","massahu","touches him","তাকে স্পর্শ করে"],["ٱلشَّرُّ","l-sharu","the evil","দুঃখদৈন্য"],["فَذُو","fadhū","then (he is) full","তখন"],["دُعَآءٍ","du‘āin","(of) supplication","প্রার্থনার"],["عَرِيضٍۢ","‘arīḍin","lengthy","দীর্ঘ (করে)"]],"t":"وَإِ<o>ذَآ</> أَنْعَمْنَا عَلَى <h>ٱ</>لْإِ<k>نسَٰ</>نِ أَعْرَضَ وَنَـَٔا بِجَانِبِ<m>هِۦ</> وَإِذَا مَسَّهُ <h>ٱ</><l>ل</>شَّرُّ فَذُو دُ<o>عَآ</>ءٍ عَ<p>رِي</>ضٍۢ"},{"n":52,"w":[["قُلْ","qul","Say","(হে নাবী) বলো"],["أَرَءَيْتُمْ","ara-aytum","You see ","\"তোমরা (ভেবে) দেখেছো কি"],["إِن","in","if","যদি"],["كَانَ","kāna","it is","হয় (এই কুরআন)"],["مِنْ","min","from","হতে"],["عِندِ","‘indi","from","নিকট"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["ثُمَّ","thumma","then","এরপর"],["كَفَرْتُم","kafartum","you disbelieve","তোমরা অস্বীকার করছো"],["بِهِۦ","bihi","in it","তা"],["مَنْ","man","who","কে"],["أَضَلُّ","aḍallu","(is) more astray","অধিক ভ্রান্ত (হতে পারে)"],["مِمَّنْ","mimman","than (one) who ","তার চেয়ে"],["هُوَ","huwa","he","যে"],["فِى","fī","(is) in","মধ্যে"],["شِقَاقٍۭ","shiqāqin","opposition","বিরোধীতার"],["بَعِيدٍۢ","ba‘īdin","far","ঘোর (চলে গিয়েছে)\""]],"t":"قُلْ أَرَءَيْتُمْ إِ<k>ن كَ</>انَ مِنْ عِ<k>ندِ</> <h>ٱ</>للَّهِ ثُ<g>مَّ</> كَفَرْ<f>تُم بِ</><m>هِۦ</> مَنْ أَضَلُّ مِ<g>مَّ</>نْ هُوَ فِى شِقَا<i>قٍۭ بَ</><p>عِي</><q>دٍۢ</>"},{"n":53,"w":[["سَنُرِيهِمْ","sanurīhim","Soon We will show them","তাদের আমরা শীঘ্রই দেখাবো"],["ءَايَـٰتِنَا","āyātinā","Our Signs","আমাদের নিদর্শন"],["فِى","fī","in","মধ্যে"],["ٱلْـَٔافَاقِ","l-āfāqi","the horizons","দিগন্তসমূহের"],["وَفِىٓ","wafī","and in","এবং মধ্যে"],["أَنفُسِهِمْ","anfusihim","themselves","তাদের নিজেদের"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["يَتَبَيَّنَ","yatabayyana","becomes clear","সুস্পষ্ট হয়ে যায়"],["لَهُمْ","lahum","to them","তাদের কাছে"],["أَنَّهُ","annahu","that it","(এ কথা) যে তা"],["ٱلْحَقُّ ۗ","l-ḥaqu","(is) the truth","বাস্তবিকই সত্য"],["أَوَلَمْ","awalam","Is (it) not","নয় কি"],["يَكْفِ","yakfi","sufficient","যথেষ্ট"],["بِرَبِّكَ","birabbika","concerning your Lord","তোমার রব"],["أَنَّهُۥ","annahu","that He","যে তিনি"],["عَلَىٰ","‘alā","(is) over","উপর"],["كُلِّ","kulli","all","সব"],["شَىْءٍۢ","shayin","things","কিছুর"],["شَهِيدٌ","shahīdun","a Witness","সাক্ষী"]],"t":"سَنُرِيهِمْ ءَا<m>يَٰ</>تِنَا فِى <h>ٱ</>لْءَافَاقِ وَ<o>فِىٓ</> أَ<k>نفُ</>سِهِمْ حَتَّىٰ يَتَبَيَّنَ لَهُمْ أَ<g>نَّ</>هُ <h>ٱ</>لْحَقُّ ۗ أَوَلَمْ يَكْفِ بِرَبِّكَ أَ<g>نَّ</>هُ<m>ۥ</> عَلَىٰ كُلِّ <k>شَىْءٍۢ شَ</><p>هِي</><q>دٌ</>"},{"n":54,"w":[["أَلَآ","alā","Unquestionably","জেনে রাখো"],["إِنَّهُمْ","innahum","they","তারা নিশ্চয়ই"],["فِى","fī","(are) in","মধ্যে (আছে)"],["مِرْيَةٍۢ","mir'yatin","doubt","সন্দেহের"],["مِّن","min","about","বিষয়ে"],["لِّقَآءِ","liqāi","(the) meeting","সাক্ষাতের"],["رَبِّهِمْ ۗ","rabbihim","(with) their Lord","তাদের রবের"],["أَلَآ","alā","Unquestionably","জেনে রাখো"],["إِنَّهُۥ","innahu","indeed, He","নিশ্চয়ই তিনি"],["بِكُلِّ","bikulli","(is) of all","সব"],["شَىْءٍۢ","shayin","things","কিছুকে"],["مُّحِيطٌۢ","muḥīṭun","encompassing","পরিবেষ্টনকারী (অর্থাৎ ঘিরে রেখেছেন)"]],"t":"أَ<o>لَآ</> إِ<g>نَّ</>هُمْ فِى مِرْيَ<d>ةٍۢ مِّ</><w>ن لِّ</><o>قَآ</>ءِ رَبِّهِمْ ۗ أَ<o>لَآ</> إِ<g>نَّ</>هُ<m>ۥ</> بِكُلِّ <d>شَىْءٍۢ مُّ</><p>حِي</><q>طٌۢ</>"}]}