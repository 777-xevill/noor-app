{"n":41,"a":[{"n":1,"w":[["حمٓ","hha-meem","Ha Meem","হা-মীম"]],"t":"ح<n>مٓ</>"},{"n":2,"w":[["تَنزِيلٌۭ","tanzīlun","A revelation","অবতরণ করা (হয়েছে এটা)"],["مِّنَ","mina","from","(আল্লাহর) পক্ষ হ'তে"],["ٱلرَّحْمَـٰنِ","l-raḥmāni","the Most Gracious","(যিনি) অশেষ দয়াময়"],["ٱلرَّحِيمِ","l-raḥīmi","the Most Merciful","পরম দয়ালু"]],"t":"تَ<k>نزِ</>ي<d>لٌۭ مِّ</>نَ <h>ٱ</><l>ل</>رَّحْ<m>مَٰ</>نِ <h>ٱ</><l>ل</>رَّ<p>حِي</>مِ"},{"n":3,"w":[["كِتَـٰبٌۭ","kitābun","A Book","এই কিতাব (এমন যে)"],["فُصِّلَتْ","fuṣṣilat","are detailed","বিশদভাবে বিবৃত"],["ءَايَـٰتُهُۥ","āyātuhu","its Verses","তার আয়াতসমূহ"],["قُرْءَانًا","qur'ānan","a Quran","কুরআন"],["عَرَبِيًّۭا","‘arabiyyan","(in) Arabic","আরবী (ভাষার)"],["لِّقَوْمٍۢ","liqawmin","for a people","(এমন) সম্প্রদায়ের জন্যে"],["يَعْلَمُونَ","ya‘lamūna","(who) know","(যারা) জ্ঞান রাখে"]],"t":"كِ<m>تَٰ</><k>بٌۭ فُ</>صِّلَتْ ءَا<m>يَٰ</>تُهُ<m>ۥ</> قُرْءَانًا عَرَبِ<w>يًّۭا لِّ</>قَوْ<d>مٍۢ يَ</>عْلَ<p>مُو</>نَ"},{"n":4,"w":[["بَشِيرًۭا","bashīran","A giver of glad tidings","(এই কিতাব) সুসংবাদদাতা"],["وَنَذِيرًۭا","wanadhīran","and a warner","ও সতর্ককারী"],["فَأَعْرَضَ","fa-a‘raḍa","but turn away","কিন্তু বিমুখ হয়েছে"],["أَكْثَرُهُمْ","aktharuhum","most of them","তাদের অনেকেই"],["فَهُمْ","fahum","so they","সুতরাং তারা"],["لَا","lā","(do) not","না"],["يَسْمَعُونَ","yasma‘ūna","hear","শুনে"]],"t":"بَشِي<d>رًۭا وَ</>نَذِي<k>رًۭا فَ</>أَعْرَضَ أَكْثَرُهُمْ فَهُمْ لَا يَسْمَ<p>عُو</>نَ"},{"n":5,"w":[["وَقَالُوا۟","waqālū","And they say","এবং তারা বলে"],["قُلُوبُنَا","qulūbunā","Our hearts","\"আমাদের অন্তরগুলো"],["فِىٓ","fī","(are) in","মধ্যে (আছে)"],["أَكِنَّةٍۢ","akinnatin","coverings","পর্দাসমূহের"],["مِّمَّا","mimmā","from what","তা থেকে যা"],["تَدْعُونَآ","tad‘ūnā","you call us","আমাদেরকে তোমরা ডাকছো"],["إِلَيْهِ","ilayhi","to it","তার দিকে"],["وَفِىٓ","wafī","and in","এবং মধ্যে"],["ءَاذَانِنَا","ādhāninā","our ears","আমাদের কানসমূহের"],["وَقْرٌۭ","waqrun","(is) deafness","বধিরতা (রয়েছে)"],["وَمِنۢ","wamin","and between us","মধ্য হতে"],["بَيْنِنَا","bayninā","and between us","এবং আমাদের মাঝে"],["وَبَيْنِكَ","wabaynika","and between you","ও তোমার মাঝে"],["حِجَابٌۭ","ḥijābun","(is) a screen","পর্দা (রয়েছে)"],["فَٱعْمَلْ","fa-i‘'mal","So work","তুমি তাই কাজ করো"],["إِنَّنَا","innanā","indeed, we","নিশ্চয়ই আমরা"],["عَـٰمِلُونَ","‘āmilūna","(are) working","কাজ করে যাচ্ছি\""]],"t":"وَقَالُو<s>ا۟</> قُلُوبُنَا <o>فِىٓ</> أَكِ<g>نَّ</><d>ةٍۢ مِّ</><g>مَّ</>ا تَ<q>دْ</>عُو<o>نَآ</> إِلَيْهِ وَ<o>فِىٓ</> ءَاذَانِنَا وَ<q>قْ</><d>رٌۭ وَ</><i>مِنۢ بَ</>يْنِنَا وَبَيْنِكَ حِجَا<k>بٌۭ فَ</><h>ٱ</>عْمَلْ إِ<g>نَّ</>نَا <m>عَٰ</>مِ<p>لُو</>نَ"},{"n":6,"w":[["قُلْ","qul","Say","(হে নাবী) বলো"],["إِنَّمَآ","innamā","Only","\"মূলতঃ"],["أَنَا۠","anā","I am","আমি"],["بَشَرٌۭ","basharun","a man","একজন মানুষ"],["مِّثْلُكُمْ","mith'lukum","like you","তোমাদেরই মতো"],["يُوحَىٰٓ","yūḥā","it is revealed","ওহী করা হয়"],["إِلَىَّ","ilayya","to me","আমার প্রতি"],["أَنَّمَآ","annamā","that","এই যে"],["إِلَـٰهُكُمْ","ilāhukum","your god","তোমাদের ইলাহ"],["إِلَـٰهٌۭ","ilāhun","(is) God","ইলাহ"],["وَٰحِدٌۭ","wāḥidun","One","একই"],["فَٱسْتَقِيمُوٓا۟","fa-is'taqīmū","so take a Straight Path","সুতরাং তোমরা দৃঢ় হয়ে থাকো"],["إِلَيْهِ","ilayhi","to Him","তাঁর দিকে"],["وَٱسْتَغْفِرُوهُ ۗ","wa-is'taghfirūhu","and ask His forgiveness","ও তোমরা তাঁর কাছে ক্ষমা চাও\""],["وَوَيْلٌۭ","wawaylun","And woe","এবং দুর্ভোগ (রয়েছে)"],["لِّلْمُشْرِكِينَ","lil'mush'rikīna","to the polytheists","মুশরিকদের জন্যে"]],"t":"قُلْ إِ<g>نَّ</><o>مَآ</> أَنَا۠ بَشَ<d>رٌۭ مِّ</>ثْلُكُمْ يُوحَ<o>ىٰٓ</> إِلَىَّ أَ<g>نَّ</><o>مَآ</> إِ<m>لَٰ</>هُكُمْ إِ<m>لَٰ</><d>هٌۭ وَٰ</>حِ<k>دٌۭ فَ</><h>ٱ</>سْتَقِي<o>مُوٓ</><s>ا۟</> إِلَيْهِ وَ<h>ٱ</>سْتَغْفِرُوهُ ۗ وَوَيْ<w>لٌۭ لِّ</>لْمُشْرِ<p>كِي</>نَ"},{"n":7,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["لَا","lā","(do) not","না"],["يُؤْتُونَ","yu'tūna","give","দেয়"],["ٱلزَّكَوٰةَ","l-zakata","the zakah","যাকাত"],["وَهُم","wahum","and they","এবং তারা"],["بِٱلْـَٔاخِرَةِ","bil-ākhirati","in the Hereafter","পরকালকে"],["هُمْ","hum","they","তারা"],["كَـٰفِرُونَ","kāfirūna","(are) disbelievers","অস্বীকারকারী"]],"t":"ٱلَّذِينَ لَا يُؤْتُونَ <h>ٱ</><l>ل</>زَّكَ<s>وٰ</>ةَ وَ<f>هُم بِ</><h>ٱ</>لْءَاخِرَةِ هُمْ <m>كَٰ</>فِ<p>رُو</>نَ"},{"n":8,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["وَعَمِلُوا۟","wa‘amilū","and do","ও কাজ করেছে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","righteous deeds","নেক"],["لَهُمْ","lahum","for them","তাদের জন্যে"],["أَجْرٌ","ajrun","(is) a reward","পুরস্কার রয়েছে"],["غَيْرُ","ghayru","never ending","ব্যতীত"],["مَمْنُونٍۢ","mamnūnin","never ending","শেষ হওয়া (অফুরন্ত)"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ لَهُمْ أَ<q>جْ</>رٌ غَيْرُ مَمْ<p>نُو</>نٍۢ"},{"n":9,"w":[["۞ قُلْ","qul","Say","বলো"],["أَئِنَّكُمْ","a-innakum","Do you indeed","\"তোমরা নিশ্চিত কি"],["لَتَكْفُرُونَ","latakfurūna","[surely] disbelieve","অস্বীকার করছো অবশ্যই"],["بِٱلَّذِى","bi-alladhī","in the One Who","(তাকে) যিনি"],["خَلَقَ","khalaqa","created","সৃষ্টি করেছেন"],["ٱلْأَرْضَ","l-arḍa","the earth","পৃথিবীকে"],["فِى","fī","in","মধ্যে"],["يَوْمَيْنِ","yawmayni","two periods","দু'দিনের"],["وَتَجْعَلُونَ","wataj‘alūna","and you set up","অথচ তোমরা দাঁড় করাচ্ছো"],["لَهُۥٓ","lahu","with Him","তাঁর জন্যে"],["أَندَادًۭا ۚ","andādan","rivals","সমকক্ষ (অন্যদেরকে)"],["ذَٰلِكَ","dhālika","That","তিনিই"],["رَبُّ","rabbu","(is the) Lord","রব"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","(of) the worlds","বিশ্বজগতের\""]],"t":"۞ قُلْ أَئِ<g>نَّ</>كُمْ لَتَكْفُرُونَ بِ<h>ٱ</>لَّذِى خَلَقَ <h>ٱ</>لْأَرْضَ فِى يَوْمَيْنِ وَتَ<q>جْ</>عَلُونَ لَهُ<o>ۥٓ</> أَ<k>ندَادًۭا ۚ ذَٰ</>لِكَ رَبُّ <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":10,"w":[["وَجَعَلَ","waja‘ala","And He placed","এবং তিনি স্হাপন করেছেন"],["فِيهَا","fīhā","therein","তার মধ্যে (অর্থাৎ পৃথিবীতে)"],["رَوَٰسِىَ","rawāsiya","firmly-set mountains","পর্বতমালা"],["مِن","min","above it","থেকে"],["فَوْقِهَا","fawqihā","above it","তার উপর"],["وَبَـٰرَكَ","wabāraka","and He blessed","এবং কল্যাণ দিয়েছেন"],["فِيهَا","fīhā","therein","তার মধ্যে"],["وَقَدَّرَ","waqaddara","and determined","এবং নির্ধারণ করেছেন"],["فِيهَآ","fīhā","therein","তার মধ্যে"],["أَقْوَٰتَهَا","aqwātahā","its sustenance","তার খাদ্য (অর্থাৎ খাদ্যসম্ভার)"],["فِىٓ","fī","in","মধ্যে"],["أَرْبَعَةِ","arba‘ati","four","চার"],["أَيَّامٍۢ","ayyāmin","periods","দিনের"],["سَوَآءًۭ","sawāan","equal","সমানভাবে"],["لِّلسَّآئِلِينَ","lilssāilīna","for those who ask","প্রার্থীদের জন্যে"]],"t":"وَجَعَلَ فِيهَا رَ<m>وَٰ</>سِىَ مِ<k>ن فَ</>وْقِهَا وَ<m>بَٰ</>رَكَ فِيهَا وَقَدَّرَ فِي<o>هَآ</> أَ<q>قْ</><m>وَٰ</>تَهَا <o>فِىٓ</> أَرْبَعَةِ أَيَّا<k>مٍۢ سَ</><o>وَآ</><w>ءًۭ لِّ</>ل<o>سَّآ</>ئِ<p>لِي</>نَ"},{"n":11,"w":[["ثُمَّ","thumma","Then","এরপর"],["ٱسْتَوَىٰٓ","is'tawā","He directed (Himself)","মনোযোগ দিলেন"],["إِلَى","ilā","towards","দিকে"],["ٱلسَّمَآءِ","l-samāi","the heaven","আকাশের"],["وَهِىَ","wahiya","while it (was)","তখন তা (ছিলো)"],["دُخَانٌۭ","dukhānun","smoke","ধোঁয়া"],["فَقَالَ","faqāla","and He said","অতঃপর (আল্লাহ) বললেন"],["لَهَا","lahā","to it","তাকে"],["وَلِلْأَرْضِ","walil'arḍi","and to the earth","ও পৃথিবীকে"],["ٱئْتِيَا","i'tiyā","Come both of you","\"উভয়ে আসো"],["طَوْعًا","ṭaw‘an","willingly","ইচ্ছায়"],["أَوْ","aw","or","বা"],["كَرْهًۭا","karhan","unwillingly","অনিচ্ছায়\""],["قَالَتَآ","qālatā","They both said","উভয়ে বললো"],["أَتَيْنَا","ataynā","We come","\"আমরা আসলাম"],["طَآئِعِينَ","ṭāi‘īna","willingly","স্বেচ্ছায়\""]],"t":"ثُ<g>مَّ</> <h>ٱ</>سْتَوَ<o>ىٰٓ</> إِلَى <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ وَهِىَ دُخَا<k>نٌۭ فَ</>قَالَ لَهَا وَلِلْأَرْضِ <h>ٱ</>ئْتِيَا طَوْعًا أَوْ كَرْ<k>هًۭا قَ</>الَ<o>تَآ</> أَتَيْنَا <o>طَآ</>ئِ<p>عِي</>نَ"},{"n":12,"w":[["فَقَضَىٰهُنَّ","faqaḍāhunna","Then He completed them","অতঃপর তাদেরকে পরিণত করলেন"],["سَبْعَ","sab‘a","(as) seven","সাত"],["سَمَـٰوَاتٍۢ","samāwātin","heavens","আকাশে"],["فِى","fī","in","মধ্যে"],["يَوْمَيْنِ","yawmayni","two periods","দু'দিনের"],["وَأَوْحَىٰ","wa-awḥā","and He revealed","এবং ওহী করলেন"],["فِى","fī","in","মধ্যে"],["كُلِّ","kulli","each","প্রত্যেক"],["سَمَآءٍ","samāin","heaven","আকাশের"],["أَمْرَهَا ۚ","amrahā","its affair","তাঁর বিধিবিধান"],["وَزَيَّنَّا","wazayyannā","And We adorned","এবং আমরা সাজালাম"],["ٱلسَّمَآءَ","l-samāa","the heaven","আকাশকে"],["ٱلدُّنْيَا","l-dun'yā","[the world]","নীচের"],["بِمَصَـٰبِيحَ","bimaṣābīḥa","with lamps","প্রদীপমালা দ্বারা"],["وَحِفْظًۭا ۚ","waḥif'ẓan","and (to) guard","এবং সংরক্ষণ (করলাম)"],["ذَٰلِكَ","dhālika","That","এটা"],["تَقْدِيرُ","taqdīru","(is the) Decree","ব্যবস্থাপনা"],["ٱلْعَزِيزِ","l-‘azīzi","(of) the All-Mighty","পরাক্রমশালীর"],["ٱلْعَلِيمِ","l-‘alīmi","the All-Knower","(যিনি) সবকিছু জানেন"]],"t":"فَقَضَ<m>ىٰ</>هُ<g>نَّ</> سَ<q>بْ</>عَ سَ<m>مَٰ</>وَا<k>تٍۢ فِ</>ى يَوْمَيْنِ وَأَوْحَىٰ فِى كُلِّ سَ<o>مَآ</>ءٍ أَمْرَهَا ۚ وَزَيَّ<g>نَّ</>ا <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءَ <h>ٱ</><l>ل</>دُّنْيَا بِمَ<m>صَٰ</>بِيحَ وَحِفْ<k>ظًۭا ۚ ذَٰ</>لِكَ تَ<q>قْ</>دِيرُ <h>ٱ</>لْعَزِيزِ <h>ٱ</>لْعَ<p>لِي</>مِ"},{"n":13,"w":[["فَإِنْ","fa-in","But if","এখন যদি"],["أَعْرَضُوا۟","a‘raḍū","they turn away","তারা মুখ ফিরায়"],["فَقُلْ","faqul","then say","তবে বলো"],["أَنذَرْتُكُمْ","andhartukum","I have warned you","\"তোমাদেরকে আমি সতর্ক করছি"],["صَـٰعِقَةًۭ","ṣā‘iqatan","(of) a thunderbolt","বেহুশকারী শাস্তির"],["مِّثْلَ","mith'la","like","মতো"],["صَـٰعِقَةِ","ṣā‘iqati","(the) thunderbolt","বেহুশকারী শাস্তি (এসেছিলো)"],["عَادٍۢ","‘ādin","(of) Aad","আ'দের"],["وَثَمُودَ","wathamūda","and Thamud","ও সামূদের (উপর)\""]],"t":"فَإِنْ أَعْرَضُو<s>ا۟</> فَقُلْ أَ<k>نذَ</>رْتُكُمْ <m>صَٰ</>عِقَ<d>ةًۭ مِّ</>ثْلَ <m>صَٰ</>عِقَةِ عَا<d>دٍۢ وَ</>ثَ<p>مُو</><q>دَ</>"},{"n":14,"w":[["إِذْ","idh","When","যখন"],["جَآءَتْهُمُ","jāathumu","came to them","তাদের কাছে এসেছিলো"],["ٱلرُّسُلُ","l-rusulu","the Messengers","রাসূলগণ"],["مِنۢ","min","from before them","মধ্য হতে"],["بَيْنِ","bayni","from before them","থেকে"],["أَيْدِيهِمْ","aydīhim","from before them","সামনে তাদের"],["وَمِنْ","wamin","and from","ও থেকে"],["خَلْفِهِمْ","khalfihim","behind them","তাদের পিছন"],["أَلَّا","allā","(saying) \"Do not","(এই বলে) যে না"],["تَعْبُدُوٓا۟","ta‘budū","worship","তোমরা ইবাদত করো"],["إِلَّا","illā","except","ছাড়া"],["ٱللَّهَ ۖ","l-laha","Allah","আল্লাহকে\""],["قَالُوا۟","qālū","They said","তারা বলেছিলো"],["لَوْ","law","If","\"যদি"],["شَآءَ","shāa","(had) willed","ইচ্ছে করতেন"],["رَبُّنَا","rabbunā","our Lord","আমাদের রব"],["لَأَنزَلَ","la-anzala","surely, He (would have) sent down","অবশ্যই পাঠাতেন"],["مَلَـٰٓئِكَةًۭ","malāikatan","Angels","ফেরেশতাদেরকে"],["فَإِنَّا","fa-innā","So indeed, we","সুতরাং নিশ্চয়ই আমরা"],["بِمَآ","bimā","in what","দিয়ে ঐ বিষয় যা"],["أُرْسِلْتُم","ur'sil'tum","you have been sent","তোমাদেরকে পাঠানো হয়েছে"],["بِهِۦ","bihi","with","প্রতি তার"],["كَـٰفِرُونَ","kāfirūna","(are) disbelievers","তোমরা অস্বীকারকারী\""]],"t":"إِذْ <o>جَآ</>ءَتْهُمُ <h>ٱ</><l>ل</>رُّسُلُ <i>مِنۢ بَ</>يْنِ أَيْدِيهِمْ وَمِنْ خَلْفِهِمْ أَلَّا تَعْبُ<o>دُوٓ</><s>ا۟</> إِلَّا <h>ٱ</>للَّهَ ۖ قَالُو<s>ا۟</> لَوْ <o>شَآ</>ءَ رَبُّنَا لَأَ<k>نزَ</>لَ مَ<o>لَٰٓ</>ئِكَ<k>ةًۭ فَ</>إِ<g>نَّ</>ا بِ<o>مَآ</> أُرْسِلْ<f>تُم بِ</><m>هِۦ كَٰ</>فِ<p>رُو</>نَ"},{"n":15,"w":[["فَأَمَّا","fa-ammā","Then as for","আর অবস্থা (ছিলো)"],["عَادٌۭ","‘ādun","Aad","আ'দের (এমন যে)"],["فَٱسْتَكْبَرُوا۟","fa-is'takbarū","they were arrogant","পরে তারা অহংকার করলো"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the land","পৃথিবীর"],["بِغَيْرِ","bighayri","without","ব্যতীত"],["ٱلْحَقِّ","l-ḥaqi","[the] right","কোন অধিকার"],["وَقَالُوا۟","waqālū","and they said","এবং তারা বললো"],["مَنْ","man","Who","\"(আর) কে"],["أَشَدُّ","ashaddu","(is) mightier","অধিক শক্তিশালী"],["مِنَّا","minnā","than us","আমাদের চেয়ে"],["قُوَّةً ۖ","quwwatan","(in) strength","শক্তিতে\""],["أَوَلَمْ","awalam","Do not","দেখে নি কি"],["يَرَوْا۟","yaraw","they see","তারা (ভেবে)"],["أَنَّ","anna","that","যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["ٱلَّذِى","alladhī","the One Who","যিনি"],["خَلَقَهُمْ","khalaqahum","created them","তাদের সৃষ্টি করেছেন"],["هُوَ","huwa","He","তিনিই"],["أَشَدُّ","ashaddu","(is) Mightier","অধিক শক্তিশালী"],["مِنْهُمْ","min'hum","than them","তাদের চেয়ে"],["قُوَّةًۭ ۖ","quwwatan","(in) strength","শক্তিতে"],["وَكَانُوا۟","wakānū","But they used to","এবং তারা ছিলো"],["بِـَٔايَـٰتِنَا","biāyātinā","in Our Signs","আমাদের নিদর্শনগুলোকে"],["يَجْحَدُونَ","yajḥadūna","deny","অস্বীকার করতো"]],"t":"فَأَ<g>مَّ</>ا عَا<k>دٌۭ فَ</><h>ٱ</>سْتَكْبَرُو<s>ا۟</> فِى <h>ٱ</>لْأَرْضِ بِغَيْرِ <h>ٱ</>لْحَقِّ وَقَالُو<s>ا۟</> مَنْ أَشَدُّ مِ<g>نَّ</>ا قُوَّةً ۖ أَوَلَمْ يَرَوْ<s>ا۟</> أَ<g>نَّ</> <h>ٱ</>للَّهَ <h>ٱ</>لَّذِى خَلَقَهُمْ هُوَ أَشَدُّ مِنْهُمْ قُوَّ<d>ةًۭ ۖ وَ</>كَانُو<s>ا۟</> بِـَٔا<m>يَٰ</>تِنَا يَ<q>جْ</>حَ<p>دُو</>نَ"},{"n":16,"w":[["فَأَرْسَلْنَا","fa-arsalnā","So We sent","আমরা তাই পাঠালাম"],["عَلَيْهِمْ","‘alayhim","upon them","তাদের বিরুদ্ধে"],["رِيحًۭا","rīḥan","a wind","বাতাস"],["صَرْصَرًۭا","ṣarṣaran","furious","ঝড়ো"],["فِىٓ","fī","in","মধ্যে"],["أَيَّامٍۢ","ayyāmin","(the) days","(কয়েক) দিনের"],["نَّحِسَاتٍۢ","naḥisātin","(of) misfortune","দুর্ভোগের"],["لِّنُذِيقَهُمْ","linudhīqahum","that We may make them taste","তাদেরকে আমরা ভোগ করাই যেন"],["عَذَابَ","‘adhāba","(the) punishment","শাস্তি"],["ٱلْخِزْىِ","l-khiz'yi","(of) disgrace","লাঞ্ছনার"],["فِى","fī","in","মধ্যে"],["ٱلْحَيَوٰةِ","l-ḥayati","the life","জীবনে"],["ٱلدُّنْيَا ۖ","l-dun'yā","(of) the world","পার্থিব"],["وَلَعَذَابُ","wala‘adhābu","And surely, (the) punishment","এবং অবশ্যই শাস্তি"],["ٱلْـَٔاخِرَةِ","l-ākhirati","(of) the Hereafter","পরকালের"],["أَخْزَىٰ ۖ","akhzā","(is) more disgracing","অধিক অপমানকর"],["وَهُمْ","wahum","and they","এবং তাদের"],["لَا","lā","will not be helped","না"],["يُنصَرُونَ","yunṣarūna","will not be helped","সাহায্য করা হবে"]],"t":"فَأَرْسَلْنَا عَلَيْهِمْ رِي<k>حًۭا صَ</>رْصَ<k>رًۭا فِ</><o>ىٓ</> أَيَّا<d>مٍۢ نَّ</>حِسَا<w>تٍۢ لِّ</>نُذِيقَهُمْ عَذَابَ <h>ٱ</>لْخِزْىِ فِى <h>ٱ</>لْحَيَ<s>وٰ</>ةِ <h>ٱ</><l>ل</>دُّنْيَا ۖ وَلَعَذَابُ <h>ٱ</>لْءَاخِرَةِ أَخْزَىٰ ۖ وَهُمْ لَا يُ<k>نصَ</><p>رُو</>نَ"},{"n":17,"w":[["وَأَمَّا","wa-ammā","And as for","আর অবস্থা (ছিলো)"],["ثَمُودُ","thamūdu","Thamud","সামূদের (এমন যে)"],["فَهَدَيْنَـٰهُمْ","fahadaynāhum","We guided them","তাদেরকে আমরা অতঃপর পথ নির্দেশ করেছিলাম"],["فَٱسْتَحَبُّوا۟","fa-is'taḥabbū","but they preferred","তারা কিন্তু পছন্দ করেছিলো"],["ٱلْعَمَىٰ","l-‘amā","[the] blindness","অন্ধতা"],["عَلَى","‘alā","over","পরিবর্তে"],["ٱلْهُدَىٰ","l-hudā","the guidance","সৎপথের"],["فَأَخَذَتْهُمْ","fa-akhadhathum","so seized them","তখন তাদেরকে পাকড়াও  করলো"],["صَـٰعِقَةُ","ṣā‘iqatu","a thunderbolt","বেহুশকারী"],["ٱلْعَذَابِ","l-‘adhābi","(of) the punishment","শাস্তি"],["ٱلْهُونِ","l-hūni","humiliating","অপমানকর"],["بِمَا","bimā","for what","এ কারণে যা"],["كَانُوا۟","kānū","they used to","তারা"],["يَكْسِبُونَ","yaksibūna","earn","কামাই করেছিলো"]],"t":"وَأَ<g>مَّ</>ا ثَمُودُ فَهَدَيْ<m>نَٰ</>هُمْ فَ<h>ٱ</>سْتَحَبُّو<s>ا۟</> <h>ٱ</>لْعَمَىٰ عَلَى <h>ٱ</>لْهُدَىٰ فَأَخَذَتْهُمْ <m>صَٰ</>عِقَةُ <h>ٱ</>لْعَذَابِ <h>ٱ</>لْهُونِ بِمَا كَانُو<s>ا۟</> يَكْسِ<p>بُو</>نَ"},{"n":18,"w":[["وَنَجَّيْنَا","wanajjaynā","And We saved","এবং আমরা উদ্ধার করেছিলাম"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["ءَامَنُوا۟","āmanū","believed","ঈমান এনেছিলো"],["وَكَانُوا۟","wakānū","and used to","ও"],["يَتَّقُونَ","yattaqūna","fear (Allah)","(গুমরাহী হ'তে) ভয় করেছিলো"]],"t":"وَنَجَّيْنَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَكَانُو<s>ا۟</> يَتَّ<p>قُو</>نَ"},{"n":19,"w":[["وَيَوْمَ","wayawma","And (the) Day","এবং (স্মরণ করো) যেদিন"],["يُحْشَرُ","yuḥ'sharu","will be gathered","সমবেত করা হবে"],["أَعْدَآءُ","a‘dāu","(the) enemies","শত্রুদের"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["إِلَى","ilā","to","দিকে"],["ٱلنَّارِ","l-nāri","the Fire","জাহান্নামের"],["فَهُمْ","fahum","then they","অতঃপর তাদেরকে"],["يُوزَعُونَ","yūza‘ūna","will be assembled in rows","নানা দলে ভাগ করা হবে"]],"t":"وَيَوْمَ يُحْشَرُ أَعْ<o>دَآ</>ءُ <h>ٱ</>للَّهِ إِلَى <h>ٱ</><l>ل</><g>نَّ</>ارِ فَهُمْ يُوزَ<p>عُو</>نَ"},{"n":20,"w":[["حَتَّىٰٓ","ḥattā","Until","অবশেষে"],["إِذَا","idhā","when","যখন"],["مَا","mā","when","যা"],["جَآءُوهَا","jāūhā","they come to it","সেখানে তারা আসবে (সবাই)"],["شَهِدَ","shahida","(will) testify","সাক্ষ্য দিবে"],["عَلَيْهِمْ","‘alayhim","against them","তাদের বিরুদ্ধে"],["سَمْعُهُمْ","sam‘uhum","their hearing","তাদের কান"],["وَأَبْصَـٰرُهُمْ","wa-abṣāruhum","and their sight","ও তাদের চক্ষু"],["وَجُلُودُهُم","wajulūduhum","and their skins","ও তাদের ত্বক"],["بِمَا","bimā","(as) to what","ঐ বিষয়ে যা"],["كَانُوا۟","kānū","they used to","তারা"],["يَعْمَلُونَ","ya‘malūna","do","কাজ করেছিলো"]],"t":"حَتَّ<o>ىٰٓ</> إِذَا مَا <o>جَآ</>ءُوهَا شَهِدَ عَلَيْهِمْ سَمْعُهُمْ وَأَ<q>بْ</><m>صَٰ</>رُهُمْ وَجُلُودُ<f>هُم بِ</>مَا كَانُو<s>ا۟</> يَعْمَ<p>لُو</>نَ"},{"n":21,"w":[["وَقَالُوا۟","waqālū","And they will say","এবং তারা বলবে"],["لِجُلُودِهِمْ","lijulūdihim","to their skins","তাদের ত্বকগুলোকে"],["لِمَ","lima","Why do","\"কেন"],["شَهِدتُّمْ","shahidttum","you testify","তোমরা সাক্ষ্য দিয়েছো"],["عَلَيْنَا ۖ","‘alaynā","against us","আমাদের বিরুদ্ধে\""],["قَالُوٓا۟","qālū","They will say","তারা বলবে"],["أَنطَقَنَا","anṭaqanā","Allah made us speak","\"আমাদের বাকশক্তি দিয়েছেন"],["ٱللَّهُ","l-lahu","Allah made us speak","\"(সেই) আল্লাহ-ই"],["ٱلَّذِىٓ","alladhī","the One Who","যিনি"],["أَنطَقَ","anṭaqa","makes speak","বাকশক্তি দিয়েছেন"],["كُلَّ","kulla","every","সব"],["شَىْءٍۢ","shayin","thing","কিছুকে"],["وَهُوَ","wahuwa","and He","এবং তিনি"],["خَلَقَكُمْ","khalaqakum","created you","তোমাদেরকে সৃষ্টি করেছেন"],["أَوَّلَ","awwala","(the) first","প্রথম"],["مَرَّةٍۢ","marratin","time","বার"],["وَإِلَيْهِ","wa-ilayhi","and to Him","এবং তাঁরই দিকে"],["تُرْجَعُونَ","tur'ja‘ūna","you will be returned","তোমাদের ফিরিয়ে নেয়া হবে\""]],"t":"وَقَالُو<s>ا۟</> لِجُلُودِهِمْ لِمَ شَهِ<j>د</>تُّمْ عَلَيْنَا ۖ قَا<o>لُوٓ</><s>ا۟</> أَ<k>نطَ</>قَنَا <h>ٱ</>للَّهُ <h>ٱ</>لَّ<o>ذِىٓ</> أَ<k>نطَ</>قَ كُلَّ <d>شَىْءٍۢ وَ</>هُوَ خَلَقَكُمْ أَوَّلَ مَرَّ<d>ةٍۢ وَ</>إِلَيْهِ تُرْجَ<p>عُو</>نَ"},{"n":22,"w":[["وَمَا","wamā","And not","আর না"],["كُنتُمْ","kuntum","you were","তোমরা"],["تَسْتَتِرُونَ","tastatirūna","covering yourselves","লুকাতে (তখন জানতেন)"],["أَن","an","lest","যে"],["يَشْهَدَ","yashhada","testify","সাক্ষ্য দিবে"],["عَلَيْكُمْ","‘alaykum","against you","তোমাদের বিরুদ্ধে"],["سَمْعُكُمْ","sam‘ukum","your hearing","তোমাদের কান"],["وَلَآ","walā","and not","এবং না (জানতে)"],["أَبْصَـٰرُكُمْ","abṣārukum","your sight","তোমাদের চোখগুলো (সাক্ষ্য দিবে)"],["وَلَا","walā","and not","আর না (জানতে)"],["جُلُودُكُمْ","julūdukum","your skins","তোমাদের ত্বকগুলো (সাক্ষ্য দিবে)"],["وَلَـٰكِن","walākin","but","কিন্তু"],["ظَنَنتُمْ","ẓanantum","you assumed","তোমরা মনে করতে"],["أَنَّ","anna","that","যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَا","lā","(does) not","না"],["يَعْلَمُ","ya‘lamu","know","জানেন কিছুই"],["كَثِيرًۭا","kathīran","much","অনেক"],["مِّمَّا","mimmā","of what","ঐ বিষয়কে যা"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা কাজ করতে"]],"t":"وَمَا كُ<k>نتُ</>مْ تَسْتَتِرُونَ <d>أَن يَ</>شْهَدَ عَلَيْكُمْ سَمْعُكُمْ وَ<o>لَآ</> أَ<q>بْ</><m>صَٰ</>رُكُمْ وَلَا جُلُودُكُمْ وَ<m>لَٰ</>كِ<k>ن ظَنَنتُ</>مْ أَ<g>نَّ</> <h>ٱ</>للَّهَ لَا يَعْلَمُ كَثِي<d>رًۭا مِّ</><g>مَّ</>ا تَعْمَ<p>لُو</>نَ"},{"n":23,"w":[["وَذَٰلِكُمْ","wadhālikum","And that","এবং সেটা (ছিলো)"],["ظَنُّكُمُ","ẓannukumu","(was) your assumption","তোমাদের ধারণা"],["ٱلَّذِى","alladhī","which","যা"],["ظَنَنتُم","ẓanantum","you assumed","তোমরা ধারণা করেছিলে"],["بِرَبِّكُمْ","birabbikum","about your Lord","সম্পর্কে রব তোমাদের"],["أَرْدَىٰكُمْ","ardākum","It has ruined you","(এটাই) তোমাদেরকে ধ্বংস করেছে"],["فَأَصْبَحْتُم","fa-aṣbaḥtum","and you have become","এখন তোমরা হয়েছো"],["مِّنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْخَـٰسِرِينَ","l-khāsirīna","the losers","ক্ষতিগ্রস্তদের"]],"t":"وَ<m>ذَٰ</>لِكُمْ ظَ<g>نُّ</>كُمُ <h>ٱ</>لَّذِى ظَنَ<k>نتُ</><f>م بِ</>رَبِّكُمْ أَرْدَ<m>ىٰ</>كُمْ فَأَصْبَحْ<y>تُم مِّ</>نَ <h>ٱ</>لْ<m>خَٰ</>سِ<p>رِي</>نَ"},{"n":24,"w":[["فَإِن","fa-in","Then if","সুতরাং যদি"],["يَصْبِرُوا۟","yaṣbirū","they endure","তারা ধৈর্য্য ধরে (আর নাই ধরে)"],["فَٱلنَّارُ","fal-nāru","the Fire","জাহান্নাম তবুও"],["مَثْوًۭى","mathwan","(is) an abode","আবাস"],["لَّهُمْ ۖ","lahum","for them","তাদের জন্যে"],["وَإِن","wa-in","and if","এবং যদি"],["يَسْتَعْتِبُوا۟","yasta‘tibū","they ask for favor","তারা অনুগ্রহ করতে চায়ও"],["فَمَا","famā","then not","তবুও না"],["هُم","hum","they","তারা (হবে)"],["مِّنَ","mina","(will be) of","অন্তর্ভুক্ত"],["ٱلْمُعْتَبِينَ","l-mu‘'tabīna","those who receive favor","অনুগ্রহ প্রাপ্তদের"]],"t":"فَ<d>إِن يَ</>صْبِرُو<s>ا۟</> فَ<h>ٱ</><l>ل</><g>نَّ</>ارُ مَثْ<w>وًۭى لَّ</>هُمْ ۖ وَ<d>إِن يَ</>سْتَعْتِبُو<s>ا۟</> فَمَا <y>هُم مِّ</>نَ <h>ٱ</>لْمُعْتَ<p>بِي</>نَ"},{"n":25,"w":[["۞ وَقَيَّضْنَا","waqayyaḍnā","And We have destined","এবং আমরা নির্ধারণ করেছি"],["لَهُمْ","lahum","for them","তাদের জন্যে"],["قُرَنَآءَ","quranāa","companions","(পথভ্রষ্ট) সঙ্গীদেরকে"],["فَزَيَّنُوا۟","fazayyanū","(who) made fair-seeming","আর তারা শোভন করে দেখায়"],["لَهُم","lahum","to them","তাদেরকে"],["مَّا","mā","what","যা কিছু (আছে)"],["بَيْنَ","bayna","(was) before them","সামনে"],["أَيْدِيهِمْ","aydīhim","(was) before them","তাদের"],["وَمَا","wamā","and what","এবং যা কিছু আছে"],["خَلْفَهُمْ","khalfahum","(was) behind them","তাদের পিছনে"],["وَحَقَّ","waḥaqqa","and (is) justified","এবং বাস্তব হলো"],["عَلَيْهِمُ","‘alayhimu","against them","তাদের উপর"],["ٱلْقَوْلُ","l-qawlu","the Word","সেই বাণী (যা কার্যকর হয়েছে)"],["فِىٓ","fī","among","উপর"],["أُمَمٍۢ","umamin","nations","জাতিসমূহের (যারা)"],["قَدْ","qad","(that have) passed away","নিশ্চয়ই"],["خَلَتْ","khalat","(that have) passed away","অতীত হয়েছে"],["مِن","min","before them","পূর্বের"],["قَبْلِهِم","qablihim","before them","তাদের"],["مِّنَ","mina","of","মধ্য হ'তে"],["ٱلْجِنِّ","l-jini","the jinn","জিনের"],["وَٱلْإِنسِ ۖ","wal-insi","and the men","ও মানুষের"],["إِنَّهُمْ","innahum","Indeed, they","তারা নিশ্চয়ই"],["كَانُوا۟","kānū","were","ছিলো"],["خَـٰسِرِينَ","khāsirīna","losers","ক্ষতিগ্রস্ত"]],"t":"۞ وَقَيَّضْنَا لَهُمْ قُرَ<o>نَآ</>ءَ فَزَيَّنُو<s>ا۟</> لَ<y>هُم مَّ</>ا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ وَحَقَّ عَلَيْهِمُ <h>ٱ</>لْقَوْلُ <o>فِىٓ</> أُمَ<k>مٍۢ قَ</><q>دْ</> خَلَتْ مِ<k>ن قَ</><q>بْ</>لِ<y>هِم مِّ</>نَ <h>ٱ</>لْجِ<g>نِّ</> وَ<h>ٱ</>لْإِ<k>نسِ</> ۖ إِ<g>نَّ</>هُمْ كَانُو<s>ا۟</> <m>خَٰ</>سِ<p>رِي</>نَ"},{"n":26,"w":[["وَقَالَ","waqāla","And said","এবং বলে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieve","অবিশ্বাস করেছে"],["لَا","lā","(Do) not","\"না"],["تَسْمَعُوا۟","tasma‘ū","listen","তোমরা শুনো"],["لِهَـٰذَا","lihādhā","to this","এই"],["ٱلْقُرْءَانِ","l-qur'āni","Quran","কুরআন"],["وَٱلْغَوْا۟","wal-ghaw","and make noise","এবং গোলমাল সৃষ্টি করো তোমরা"],["فِيهِ","fīhi","therein","তার মধ্যে"],["لَعَلَّكُمْ","la‘allakum","so that you may","তোমরা সম্ভবতঃ"],["تَغْلِبُونَ","taghlibūna","overcome","জয়ী হবে\""]],"t":"وَقَالَ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> لَا تَسْمَعُو<s>ا۟</> لِ<m>هَٰ</>ذَا <h>ٱ</>لْقُرْءَانِ وَ<h>ٱ</>لْغَوْ<s>ا۟</> فِيهِ لَعَلَّكُمْ تَغْلِ<p>بُو</>نَ"},{"n":27,"w":[["فَلَنُذِيقَنَّ","falanudhīqanna","But surely We will cause to taste","সুতরাং আমরা আস্বাদন করাবোই"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["كَفَرُوا۟","kafarū","disbelieve","অবিশ্বাস করেছে"],["عَذَابًۭا","‘adhāban","a punishment","শাস্তি"],["شَدِيدًۭا","shadīdan","severe","কঠোর"],["وَلَنَجْزِيَنَّهُمْ","walanajziyannahum","and surely We will recompense them","এবং আমরা তাদেরকে প্রতিফল দিবোই"],["أَسْوَأَ","aswa-a","(the) worst","নিকৃষ্ট কাজের"],["ٱلَّذِى","alladhī","(of) what","যা"],["كَانُوا۟","kānū","they used to","তারা"],["يَعْمَلُونَ","ya‘malūna","do","কাজ করেছিলো"]],"t":"فَلَنُذِيقَ<g>نَّ</> <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> عَذَا<k>بًۭا شَ</>دِي<d>دًۭا وَ</>لَنَ<q>جْ</>زِيَ<g>نَّ</>هُمْ أَسْوَأَ <h>ٱ</>لَّذِى كَانُو<s>ا۟</> يَعْمَ<p>لُو</>نَ"},{"n":28,"w":[["ذَٰلِكَ","dhālika","That","সেটা"],["جَزَآءُ","jazāu","(is the) recompense","প্রতিফল"],["أَعْدَآءِ","a‘dāi","(of the) enemies","শত্রুদের"],["ٱللَّهِ","l-lahi","(of) Allah ","আল্লাহর"],["ٱلنَّارُ ۖ","l-nāru","the Fire","জাহান্নাম"],["لَهُمْ","lahum","for them","এদের জন্যে (রয়েছে)"],["فِيهَا","fīhā","therein","তার মধ্যে"],["دَارُ","dāru","(is the) home","আবাস"],["ٱلْخُلْدِ ۖ","l-khul'di","(of) the eternity","স্থায়ী"],["جَزَآءًۢ","jazāan","(as) recompense","প্রতিফলস্বরূপ"],["بِمَا","bimā","for what","এ কারণে যা"],["كَانُوا۟","kānū","they used to","তারা ছিলো"],["بِـَٔايَـٰتِنَا","biāyātinā","of Our Verses","আমাদের নিদর্শনগুলোকে"],["يَجْحَدُونَ","yajḥadūna","reject","অস্বীকার করতো"]],"t":"<m>ذَٰ</>لِكَ جَ<o>زَآ</>ءُ أَعْ<o>دَآ</>ءِ <h>ٱ</>للَّهِ <h>ٱ</><l>ل</><g>نَّ</>ارُ ۖ لَهُمْ فِيهَا دَارُ <h>ٱ</>لْخُلْدِ ۖ جَ<o>زَآ</><i>ءًۢ بِ</>مَا كَانُو<s>ا۟</> بِـَٔا<m>يَٰ</>تِنَا يَ<q>جْ</>حَ<p>دُو</>نَ"},{"n":29,"w":[["وَقَالَ","waqāla","And (will) say","এবং বলবে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieve","অস্বীকার করেছিলো"],["رَبَّنَآ","rabbanā","Our Lord","\"হে আমাদের রব"],["أَرِنَا","arinā","Show us","আমাদেরকে দেখিয়ে দিন"],["ٱلَّذَيْنِ","alladhayni","those who","(সেই দুই প্রজাতির লোকদেরকে) যারা"],["أَضَلَّانَا","aḍallānā","misled us","আমাদেরকে পথভ্রষ্ট করেছে"],["مِنَ","mina","of","মধ্যে থেকে"],["ٱلْجِنِّ","l-jini","the jinn","জিনদের"],["وَٱلْإِنسِ","wal-insi","and the men","এবং মানুষদের"],["نَجْعَلْهُمَا","naj‘alhumā","(so) we may put them","উভয়কে আমরা পিষে ফেলবো"],["تَحْتَ","taḥta","under","তলায়"],["أَقْدَامِنَا","aqdāminā","our feet","আমাদের পায়ের"],["لِيَكُونَا","liyakūnā","that they be","উভয়ে হয় যেন"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْأَسْفَلِينَ","l-asfalīna","the lowest","অপমানিতদের (সর্বনিম্নের)\""]],"t":"وَقَالَ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> رَبَّ<o>نَآ</> أَرِنَا <h>ٱ</>لَّذَيْنِ أَضَلَّانَا مِنَ <h>ٱ</>لْجِ<g>نِّ</> وَ<h>ٱ</>لْإِ<k>نسِ</> نَ<q>جْ</>عَلْهُمَا تَحْتَ أَ<q>قْ</>دَامِنَا لِيَكُونَا مِنَ <h>ٱ</>لْأَسْفَ<p>لِي</>نَ"},{"n":30,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["قَالُوا۟","qālū","say","বলে"],["رَبُّنَا","rabbunā","Our Lord","\"আমাদের রব"],["ٱللَّهُ","l-lahu","(is) Allah","আল্লাহ-ই\""],["ثُمَّ","thumma","then","অতঃপর"],["ٱسْتَقَـٰمُوا۟","is'taqāmū","stand firm ","তারা অবিচল থাকে"],["تَتَنَزَّلُ","tatanazzalu","will descend","অবতীর্ণ হয়"],["عَلَيْهِمُ","‘alayhimu","on them","তাদের উপর"],["ٱلْمَلَـٰٓئِكَةُ","l-malāikatu","the Angels","ফেরেশতারা (আর বলে)"],["أَلَّا","allā","(Do) not","\"যে না"],["تَخَافُوا۟","takhāfū","fear","তোমরা ভয় করো"],["وَلَا","walā","and (do) not","আর না"],["تَحْزَنُوا۟","taḥzanū","grieve","তোমরা চিন্তা করো"],["وَأَبْشِرُوا۟","wa-abshirū","but receive the glad tidings","এবং তোমরা সুসংবাদ শুনে খুশি হও"],["بِٱلْجَنَّةِ","bil-janati","of Paradise","(সেই) জান্নাতের"],["ٱلَّتِى","allatī","which","যা"],["كُنتُمْ","kuntum","you were","তোমাদের"],["تُوعَدُونَ","tū‘adūna","promised","প্রতিশ্রুতি দেয়া হয়েছিলো"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ قَالُو<s>ا۟</> رَبُّنَا <h>ٱ</>للَّهُ ثُ<g>مَّ</> <h>ٱ</>سْتَ<m>قَٰ</>مُو<s>ا۟</> تَتَنَزَّلُ عَلَيْهِمُ <h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةُ أَلَّا تَخَافُو<s>ا۟</> وَلَا تَحْزَنُو<s>ا۟</> وَأَ<q>بْ</>شِرُو<s>ا۟</> بِ<h>ٱ</>لْجَ<g>نَّ</>ةِ <h>ٱ</>لَّتِى كُ<k>نتُ</>مْ تُوعَ<p>دُو</>نَ"},{"n":31,"w":[["نَحْنُ","naḥnu","We","আমরা"],["أَوْلِيَآؤُكُمْ","awliyāukum","(are) your protectors","তোমাদের বন্ধু"],["فِى","fī","in","মধ্যে"],["ٱلْحَيَوٰةِ","l-ḥayati","the life","জীবনের"],["ٱلدُّنْيَا","l-dun'yā","(of) the world","দুনিয়ার"],["وَفِى","wafī","and in","এবং মধ্যে"],["ٱلْـَٔاخِرَةِ ۖ","l-ākhirati","the Hereafter","পরকালের"],["وَلَكُمْ","walakum","And for you","এবং তোমাদের জন্যে (রয়েছে)"],["فِيهَا","fīhā","therein","তার মধ্যে"],["مَا","mā","whatever","যা"],["تَشْتَهِىٓ","tashtahī","desire","চায়"],["أَنفُسُكُمْ","anfusukum","your souls","তোমাদের মন"],["وَلَكُمْ","walakum","and for you","এবং তোমাদের জন্যে"],["فِيهَا","fīhā","therein","তার মধ্যে (রয়েছে)"],["مَا","mā","what","যা"],["تَدَّعُونَ","tadda‘ūna","you ask","তোমরা দাবি করবে"]],"t":"نَحْنُ أَوْلِ<o>يَآ</>ؤُكُمْ فِى <h>ٱ</>لْحَيَ<s>وٰ</>ةِ <h>ٱ</><l>ل</>دُّنْيَا وَفِى <h>ٱ</>لْءَاخِرَةِ ۖ وَلَكُمْ فِيهَا مَا تَشْتَ<o>هِىٓ</> أَ<k>نفُ</>سُكُمْ وَلَكُمْ فِيهَا مَا تَدَّ<p>عُو</>نَ"},{"n":32,"w":[["نُزُلًۭا","nuzulan","A hospitable gift","আপ্যায়ন"],["مِّنْ","min","from","(আল্লাহর) পক্ষ থেকে"],["غَفُورٍۢ","ghafūrin","(the) Oft-Forgiving","(যিনি) ক্ষমাশীল"],["رَّحِيمٍۢ","raḥīmin","(the) Most Merciful","পরম দয়ালু\""]],"t":"نُزُلًۭ<d>ا مِّ</>نْ غَفُو<w>رٍۢ رَّ</><p>حِي</>مٍۢ"},{"n":33,"w":[["وَمَنْ","waman","And who","এবং কার"],["أَحْسَنُ","aḥsanu","(is) better","উত্তম"],["قَوْلًۭا","qawlan","(in) speech","কথা (হতে পারে)"],["مِّمَّن","mimman","than (one) who","তার চেয়ে যে"],["دَعَآ","da‘ā","invites","ডাকে"],["إِلَى","ilā","to","দিকে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["وَعَمِلَ","wa‘amila","and does","ও কাজ করে"],["صَـٰلِحًۭا","ṣāliḥan","righteous (deeds)","সৎ"],["وَقَالَ","waqāla","and says","এবং বলে"],["إِنَّنِى","innanī","Indeed, I am","\"নিশ্চয়ই আমি"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْمُسْلِمِينَ","l-mus'limīna","those who submit","আত্মসমর্পণকারীদের (অর্থাৎ মুসলমানদের)\""]],"t":"وَمَنْ أَحْسَنُ قَوْلًۭ<d>ا مِّ</><g>مَّ</><k>ن دَ</><o>عَآ</> إِلَى <h>ٱ</>للَّهِ وَعَمِلَ <m>صَٰ</>لِ<d>حًۭا وَ</>قَالَ إِ<g>نَّ</>نِى مِنَ <h>ٱ</>لْمُسْلِ<p>مِي</>نَ"},{"n":34,"w":[["وَلَا","walā","And not","এবং না"],["تَسْتَوِى","tastawī","(are) equal","সমান হয়"],["ٱلْحَسَنَةُ","l-ḥasanatu","the good (deed)","ভালো"],["وَلَا","walā","and","আর না"],["ٱلسَّيِّئَةُ ۚ","l-sayi-atu","the evil (deed)","মন্দ"],["ٱدْفَعْ","id'fa‘","Repel","প্রতিহত করো"],["بِٱلَّتِى","bi-allatī","by (that) which","সেই (জ্ঞান) দ্বারা"],["هِىَ","hiya","[it]","যা"],["أَحْسَنُ","aḥsanu","(is) better","উত্তম"],["فَإِذَا","fa-idhā","then behold","ফলে (দেখবে) তখন"],["ٱلَّذِى","alladhī","One who","যে"],["بَيْنَكَ","baynaka","between you","তোমার মাঝে"],["وَبَيْنَهُۥ","wabaynahu","and between him","ও তার মাঝে"],["عَدَٰوَةٌۭ","‘adāwatun","(was) enmity","শত্রুতা (আছে)"],["كَأَنَّهُۥ","ka-annahu","(will become) as if he","সে যেন (হয়ে যাবে)"],["وَلِىٌّ","waliyyun","(was) a friend","বন্ধু"],["حَمِيمٌۭ","ḥamīmun","intimate","অন্তরঙ্গ"]],"t":"وَلَا تَسْتَوِى <h>ٱ</>لْحَسَنَةُ وَلَا <h>ٱ</><l>ل</>سَّيِّئَةُ ۚ <h>ٱ</><q>دْ</>فَعْ بِ<h>ٱ</>لَّتِى هِىَ أَحْسَنُ فَإِذَا <h>ٱ</>لَّذِى بَيْنَكَ وَبَيْنَهُ<m>ۥ</> عَ<m>دَٰ</>وَ<k>ةٌۭ كَ</>أَ<g>نَّ</>هُ<m>ۥ</> وَلِىٌّ حَ<p>مِي</>مٌۭ"},{"n":35,"w":[["وَمَا","wamā","And not","এবং না"],["يُلَقَّىٰهَآ","yulaqqāhā","it is granted","তা (জুটে) লাভ করে"],["إِلَّا","illā","except","এ ব্যতীত"],["ٱلَّذِينَ","alladhīna","(to) those who","যারা"],["صَبَرُوا۟","ṣabarū","(are) patient","ধৈর্য্য ধরে"],["وَمَا","wamā","and not","এবং না"],["يُلَقَّىٰهَآ","yulaqqāhā","it is granted","তা (জুটে) লাভ করে"],["إِلَّا","illā","except","এ ব্যতীত"],["ذُو","dhū","(to the) owner","অধিকারী"],["حَظٍّ","ḥaẓẓin","(of) fortune","ভাগ্যের"],["عَظِيمٍۢ","‘aẓīmin","great","মহা"]],"t":"وَمَا يُلَقَّ<m>ىٰ</><o>هَآ</> إِلَّا <h>ٱ</>لَّذِينَ صَبَرُو<s>ا۟</> وَمَا يُلَقَّ<m>ىٰ</><o>هَآ</> إِلَّا ذُو حَظٍّ عَ<p>ظِي</>مٍۢ"},{"n":36,"w":[["وَإِمَّا","wa-immā","And if","আর যদি"],["يَنزَغَنَّكَ","yanzaghannaka","whisper comes to you","তোমাকে উস্কানি দেয়"],["مِنَ","mina","from","পক্ষ হতে"],["ٱلشَّيْطَـٰنِ","l-shayṭāni","the Shaitaan","শয়তানের"],["نَزْغٌۭ","nazghun","an evil suggestion","(যে কোন) কুমন্ত্রণা"],["فَٱسْتَعِذْ","fa-is'ta‘idh","then seek refuge","তবে  আশ্রয় চাও"],["بِٱللَّهِ ۖ","bil-lahi","in Allah","আল্লাহর"],["إِنَّهُۥ","innahu","Indeed, He","তিনি নিশ্চয়ই"],["هُوَ","huwa","[He]","তিনিই"],["ٱلسَّمِيعُ","l-samī‘u","(is) the All-Hearer","সবকিছু শুনেন"],["ٱلْعَلِيمُ","l-‘alīmu","the All-Knower","সবকিছুু জানেন"]],"t":"وَإِ<g>مَّ</>ا يَ<k>نزَ</>غَ<g>نَّ</>كَ مِنَ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نِ نَزْ<k>غٌۭ فَ</><h>ٱ</>سْتَعِذْ بِ<h>ٱ</>للَّهِ ۖ إِ<g>نَّ</>هُ<m>ۥ</> هُوَ <h>ٱ</><l>ل</>سَّمِيعُ <h>ٱ</>لْعَ<p>لِي</>مُ"},{"n":37,"w":[["وَمِنْ","wamin","And of","এবং মধ্যে হ'তে"],["ءَايَـٰتِهِ","āyātihi","His Signs","তাঁর নিদর্শনাবলীর"],["ٱلَّيْلُ","al-laylu","(are) the night","(রয়েছে) রাত"],["وَٱلنَّهَارُ","wal-nahāru","and the day","ও দিন"],["وَٱلشَّمْسُ","wal-shamsu","and the sun","এবং সূর্য"],["وَٱلْقَمَرُ ۚ","wal-qamaru","and the moon","ও চাঁদ"],["لَا","lā","(Do) not","না"],["تَسْجُدُوا۟","tasjudū","prostrate","তোমরা সিজদা করো"],["لِلشَّمْسِ","lilshamsi","to the sun","সূর্যকে"],["وَلَا","walā","and not","আর না"],["لِلْقَمَرِ","lil'qamari","to the moon","চাঁদকে"],["وَٱسْجُدُوا۟","wa-us'judū","but prostrate","এবং তোমরা সিজদা করো"],["لِلَّهِ","lillahi","to Allah","আল্লাহর-ই"],["ٱلَّذِى","alladhī","the One Who","যিনি"],["خَلَقَهُنَّ","khalaqahunna","created them","তাদেরকে সৃষ্টি করেছেন"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you","তোমরা হও (বাস্তবিকই)"],["إِيَّاهُ","iyyāhu","Him alone","তাঁরই শুধু"],["تَعْبُدُونَ","ta‘budūna","worship","তোমরা ইবাদত করো"]],"t":"وَمِنْ ءَا<m>يَٰ</>تِهِ <h>ٱ</>لَّيْلُ وَ<h>ٱ</><l>ل</><g>نَّ</>هَارُ وَ<h>ٱ</><l>ل</>شَّمْسُ وَ<h>ٱ</>لْقَمَرُ ۚ لَا تَسْجُدُو<s>ا۟</> لِلشَّمْسِ وَلَا لِلْقَمَرِ وَ<h>ٱ</>سْجُدُو<s>ا۟</> لِلَّهِ <h>ٱ</>لَّذِى خَلَقَهُ<g>نَّ</> إِ<k>ن كُنتُ</>مْ إِيَّاهُ تَعْبُ<p>دُو</>نَ"},{"n":38,"w":[["فَإِنِ","fa-ini","But if","অতঃপর যদি"],["ٱسْتَكْبَرُوا۟","is'takbarū","they are arrogant","তোমরা অহংকার করো (তবে কোন পরোয়া নেই)"],["فَٱلَّذِينَ","fa-alladhīna","then those who","কারণ যারা (আছে)"],["عِندَ","‘inda","(are) near","কাছে"],["رَبِّكَ","rabbika","your Lord","তোমার রবের"],["يُسَبِّحُونَ","yusabbiḥūna","glorify","তারা মহিমা ঘোষণা করছে"],["لَهُۥ","lahu","Him","তাঁরই"],["بِٱلَّيْلِ","bi-al-layli","by night","রাতে"],["وَٱلنَّهَارِ","wal-nahāri","and day","ও দিনে"],["وَهُمْ","wahum","And they","এবং তারা"],["لَا","lā","(do) not","না"],["يَسْـَٔمُونَ ۩","yasamūna","tire","ক্লান্ত হয়"]],"t":"فَإِنِ <h>ٱ</>سْتَكْبَرُو<s>ا۟</> فَ<h>ٱ</>لَّذِينَ عِ<k>ندَ</> رَبِّكَ يُسَبِّحُونَ لَهُ<m>ۥ</> بِ<h>ٱ</>لَّيْلِ وَ<h>ٱ</><l>ل</><g>نَّ</>هَارِ وَهُمْ لَا يَسْـَٔمُ<p>و</>نَ ۩"},{"n":39,"w":[["وَمِنْ","wamin","And among","এবং মধ্য হ'তে"],["ءَايَـٰتِهِۦٓ","āyātihi","His Signs","তাঁর নিদর্শনাবলীর"],["أَنَّكَ","annaka","(is) that you","(এগুলোও) যে"],["تَ