{"n":51,"a":[{"n":1,"w":[["وَٱلذَّٰرِيَـٰتِ","wal-dhāriyāti","By those scattering","শপথ বিক্ষিপ্তকারীদের (অর্থাৎ বাতাসের)"],["ذَرْوًۭا","dharwan","dispersing","বিক্ষিপ্ত করার মতো (যা ধুলাবালি)"]],"t":"وَ<h>ٱ</><l>ل</><m>ذَّٰرِيَٰ</>تِ ذَرْوًۭا"},{"n":2,"w":[["فَٱلْحَـٰمِلَـٰتِ","fal-ḥāmilāti","And those carrying","অতঃপর বহনকারীর"],["وِقْرًۭا","wiq'ran","a load","ভার (অর্থাৎ মেঘ)"]],"t":"فَ<h>ٱ</>لْ<m>حَٰمِلَٰ</>تِ وِ<q>قْ</>رًۭا"},{"n":3,"w":[["فَٱلْجَـٰرِيَـٰتِ","fal-jāriyāti","And those sailing","অতঃপর বয়ে যাওয়া বাতাসের"],["يُسْرًۭا","yus'ran","(with) ease","সহজে/ স্বচ্ছন্দে"]],"t":"فَ<h>ٱ</>لْ<m>جَٰرِيَٰ</>تِ يُسْرًۭا"},{"n":4,"w":[["فَٱلْمُقَسِّمَـٰتِ","fal-muqasimāti","And those distributing","অতঃপর বণ্টনকারীর"],["أَمْرًا","amran","Command","একটি বিষয়ের (অর্থাৎ বৃষ্টির)"]],"t":"فَ<h>ٱ</>لْمُقَسِّ<m>مَٰ</>تِ أَمْرًا"},{"n":5,"w":[["إِنَّمَا","innamā","Indeed, what","প্রকৃতপক্ষে (যা)"],["تُوعَدُونَ","tū‘adūna","you are promised","তোমাদের প্রতিশ্রুতি দেওয়া হচ্ছে"],["لَصَادِقٌۭ","laṣādiqun","(is) surely true","সত্য অবশ্যই"]],"t":"إِ<g>نَّ</>مَا تُوعَدُونَ لَصَادِ<q>قٌۭ</>"},{"n":6,"w":[["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["ٱلدِّينَ","l-dīna","the Judgment","কর্মফল দিবস"],["لَوَٰقِعٌۭ","lawāqi‘un","(is) surely to occur","অবশ্যই ঘটবে"]],"t":"وَإِ<g>نَّ</> <h>ٱ</><l>ل</>دِّينَ لَ<m>وَٰ</>قِعٌۭ"},{"n":7,"w":[["وَٱلسَّمَآءِ","wal-samāi","By the heaven","শপথ আকাশের"],["ذَاتِ","dhāti","full of","সম্পন্ন"],["ٱلْحُبُكِ","l-ḥubuki","pathways","বিভিন্নরূপ"]],"t":"وَ<h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ ذَاتِ <h>ٱ</>لْحُبُكِ"},{"n":8,"w":[["إِنَّكُمْ","innakum","Indeed, you","নিশ্চয়ই তোমরা"],["لَفِى","lafī","(are) surely in","মধ্যে অবশ্যই (লিপ্ত)"],["قَوْلٍۢ","qawlin","a speech","কথার"],["مُّخْتَلِفٍۢ","mukh'talifin","differing","বিভিন্ন"]],"t":"إِ<g>نَّ</>كُمْ لَفِى قَوْ<d>لٍۢ مُّ</>خْتَلِفٍۢ"},{"n":9,"w":[["يُؤْفَكُ","yu'faku","Deluded away","মুখ ফিরিয়ে নেয়"],["عَنْهُ","‘anhu","from it","তা হতে"],["مَنْ","man","(is he) who","যে"],["أُفِكَ","ufika","is deluded","বিমুখ হয়েছে"]],"t":"يُؤْفَكُ عَنْهُ مَنْ أُفِكَ"},{"n":10,"w":[["قُتِلَ","qutila","Cursed be","ধ্বংস হয়েছে"],["ٱلْخَرَّٰصُونَ","l-kharāṣūna","the liars","অনুমানকারীরা"]],"t":"قُتِلَ <h>ٱ</>لْخَ<m>رَّٰ</><p>صُو</>نَ"},{"n":11,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা (এমন যে)"],["هُمْ","hum","[they]","তারা"],["فِى","fī","(are) in","মধ্যে আছে"],["غَمْرَةٍۢ","ghamratin","flood","মূর্খতার"],["سَاهُونَ","sāhūna","(of) heedlessness","উদাসীন হয়ে"]],"t":"ٱلَّذِينَ هُمْ فِى غَمْرَ<k>ةٍۢ سَ</>ا<p>هُو</>نَ"},{"n":12,"w":[["يَسْـَٔلُونَ","yasalūna","They ask","তারা প্রশ্ন করে"],["أَيَّانَ","ayyāna","When","\"কখন (হবে)"],["يَوْمُ","yawmu","(is the) Day","দিবস"],["ٱلدِّينِ","l-dīni","(of) Judgment","কর্মফলের\""]],"t":"يَسْـَٔلُونَ أَيَّانَ يَوْمُ <h>ٱ</><l>ل</><p>دِّي</>نِ"},{"n":13,"w":[["يَوْمَ","yawma","A Day","(সেদিন হবে) যেদিন"],["هُمْ","hum","they","তাদেরকে"],["عَلَى","‘alā","over","উপর"],["ٱلنَّارِ","l-nāri","the Fire","আগুনের"],["يُفْتَنُونَ","yuf'tanūna","will be tried","শাস্তি দেওয়া হবে"]],"t":"يَوْمَ هُمْ عَلَى <h>ٱ</><l>ل</><g>نَّ</>ارِ يُفْتَ<p>نُو</>نَ"},{"n":14,"w":[["ذُوقُوا۟","dhūqū","Taste","\"(বলা হবে) তোমরা স্বাদ নাও"],["فِتْنَتَكُمْ","fit'natakum","your trial","তোমাদের বিপর্যয়ের"],["هَـٰذَا","hādhā","This","এটা"],["ٱلَّذِى","alladhī","(is) what","(সেই জিনিস) যা"],["كُنتُم","kuntum","you were","তোমরা ছিলে"],["بِهِۦ","bihi","for it","সেটাকে"],["تَسْتَعْجِلُونَ","tasta‘jilūna","seeking to hasten","তাড়াতাড়ি চাইতে\""]],"t":"ذُوقُو<s>ا۟</> فِتْنَتَكُمْ <m>هَٰ</>ذَا <h>ٱ</>لَّذِى كُ<k>نتُ</><f>م بِ</><m>هِۦ</> تَسْتَعْجِ<p>لُو</>نَ"},{"n":15,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلْمُتَّقِينَ","l-mutaqīna","the righteous","মুত্তাকীরা"],["فِى","fī","(will be) in","(থাকবে) মধ্যে"],["جَنَّـٰتٍۢ","jannātin","Gardens","জান্নাতের"],["وَعُيُونٍ","wa‘uyūnin","and springs","ও ঝর্ণাধারাসমূহের"]],"t":"إِ<g>نَّ</> <h>ٱ</>لْمُتَّقِينَ فِى جَ<g>نَّٰ</><d>تٍۢ وَ</>عُ<p>يُو</>نٍ"},{"n":16,"w":[["ءَاخِذِينَ","ākhidhīna","Taking","গ্রহণকারী হয়ে"],["مَآ","mā","what","যা"],["ءَاتَىٰهُمْ","ātāhum","their Lord has given them","তাদেরকে দিবেন"],["رَبُّهُمْ ۚ","rabbuhum","their Lord has given them","তাদের রব"],["إِنَّهُمْ","innahum","Indeed, they","তারা নিশ্চয়ই"],["كَانُوا۟","kānū","were","ছিল"],["قَبْلَ","qabla","before","পূর্বে"],["ذَٰلِكَ","dhālika","that","এর"],["مُحْسِنِينَ","muḥ'sinīna","good-doers","সত্কর্মশীল লোক"]],"t":"ءَاخِذِينَ <o>مَآ</> ءَاتَ<m>ىٰ</>هُمْ رَبُّهُمْ ۚ إِ<g>نَّ</>هُمْ كَانُو<s>ا۟</> قَ<q>بْ</>لَ <m>ذَٰ</>لِكَ مُحْسِ<p>نِي</>نَ"},{"n":17,"w":[["كَانُوا۟","kānū","They used to","তারা ছিল (এমন যে)"],["قَلِيلًۭا","qalīlan","little","সামান্য (অংশ)"],["مِّنَ","mina","of","কিছু অংশ"],["ٱلَّيْلِ","al-layli","the night","রাতের"],["مَا","mā","[what]","যাতে"],["يَهْجَعُونَ","yahja‘ūna","sleep","তারা নিদ্রা যেত"]],"t":"كَانُو<s>ا۟</> قَلِيلًۭ<d>ا مِّ</>نَ <h>ٱ</>لَّيْلِ مَا يَهْجَ<p>عُو</>نَ"},{"n":18,"w":[["وَبِٱلْأَسْحَارِ","wabil-asḥāri","And in the hours before dawn","এবং রাতের শেষ প্রহরে"],["هُمْ","hum","they","তারা"],["يَسْتَغْفِرُونَ","yastaghfirūna","would ask forgiveness","ক্ষমা প্রার্থনা করত"]],"t":"وَبِ<h>ٱ</>لْأَسْحَارِ هُمْ يَسْتَغْفِ<p>رُو</>نَ"},{"n":19,"w":[["وَفِىٓ","wafī","And in","এবং মধ্যে (আছে)"],["أَمْوَٰلِهِمْ","amwālihim","their wealth","তাদের সম্পদ সমূহের"],["حَقٌّۭ","ḥaqqun","(was the) right","অধিকার"],["لِّلسَّآئِلِ","lilssāili","(of) those who asked","প্রার্থনাকারীর জন্যে"],["وَٱلْمَحْرُومِ","wal-maḥrūmi","and the deprived","ও বঞ্চিতের"]],"t":"وَ<o>فِىٓ</> أَمْ<m>وَٰ</>لِهِمْ حَ<w>قٌّۭ لِّ</>ل<o>سَّآ</>ئِلِ وَ<h>ٱ</>لْمَحْ<p>رُو</>مِ"},{"n":20,"w":[["وَفِى","wafī","And in","এবং মধ্যে (আছে)"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["ءَايَـٰتٌۭ","āyātun","(are) signs","নিদর্শন সমূহ"],["لِّلْمُوقِنِينَ","lil'mūqinīna","for those who are certain","দৃঢ় বিশ্বাসীদের জন্যে"]],"t":"وَفِى <h>ٱ</>لْأَرْضِ ءَا<m>يَٰ</><w>تٌۭ لِّ</>لْمُوقِ<p>نِي</>نَ"},{"n":21,"w":[["وَفِىٓ","wafī","And in","এবং মধ্যে আছে"],["أَنفُسِكُمْ ۚ","anfusikum","yourselves","তোমাদের নিজেদের"],["أَفَلَا","afalā","Then will not","না তবে কি"],["تُبْصِرُونَ","tub'ṣirūna","you see","তোমরা (ভেবে) দেখ"]],"t":"وَ<o>فِىٓ</> أَ<k>نفُ</>سِكُمْ ۚ أَفَلَا تُ<q>بْ</>صِ<p>رُو</>نَ"},{"n":22,"w":[["وَفِى","wafī","And in","এবং মধ্যে আছে"],["ٱلسَّمَآءِ","l-samāi","the heaven","আকাশের"],["رِزْقُكُمْ","riz'qukum","(is) your provision","তোমাদের জীবিকা"],["وَمَا","wamā","and what","এবং যা"],["تُوعَدُونَ","tū‘adūna","you are promised","তোমাদের প্রতিশ্রুতি দেওয়া হয়েছে"]],"t":"وَفِى <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ رِزْقُكُمْ وَمَا تُوعَ<p>دُو</>نَ"},{"n":23,"w":[["فَوَرَبِّ","fawarabbi","Then by (the) Lord","অতএব রবের শপথ"],["ٱلسَّمَآءِ","l-samāi","(of) the heaven","আকাশের"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীর"],["إِنَّهُۥ","innahu","indeed, it","তা নিশ্চয়"],["لَحَقٌّۭ","laḥaqqun","(is) surely (the) truth","সত্য অবশ্যই"],["مِّثْلَ","mith'la","(just) as","(তার) মত"],["مَآ","mā","[what]","যেমন"],["أَنَّكُمْ","annakum","you","তোমরা"],["تَنطِقُونَ","tanṭiqūna","speak","কথাবার্তা বল"]],"t":"فَوَرَبِّ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ وَ<h>ٱ</>لْأَرْضِ إِ<g>نَّ</>هُ<m>ۥ</> لَحَ<d>قٌّۭ مِّ</>ثْلَ <o>مَآ</> أَ<g>نَّ</>كُمْ تَ<k>نطِ</><p>قُو</>نَ"},{"n":24,"w":[["هَلْ","hal","Has","(হে নবী) কি"],["أَتَىٰكَ","atāka","reached you","তোমার কাছে এসেছে"],["حَدِيثُ","ḥadīthu","(the) narration","বৃত্তান্ত"],["ضَيْفِ","ḍayfi","(of the) guests","মেহমানদের"],["إِبْرَٰهِيمَ","ib'rāhīma","(of) Ibrahim","ইবরাহীমের"],["ٱلْمُكْرَمِينَ","l-muk'ramīna","the honored","(যারা ছিল বড়) সন্মানিত"]],"t":"هَلْ أَتَ<m>ىٰ</>كَ حَدِيثُ ضَيْفِ إِ<q>بْ</><m>رَٰ</>هِيمَ <h>ٱ</>لْمُكْرَ<p>مِي</>نَ"},{"n":25,"w":[["إِذْ","idh","When","যখন"],["دَخَلُوا۟","dakhalū","they entered","তারা প্রবেশ করল"],["عَلَيْهِ","‘alayhi","upon him","তার কাছে"],["فَقَالُوا۟","faqālū","and said","তারা তখন বলল"],["سَلَـٰمًۭا ۖ","salāman","Peace","\"সালাম (বর্ষিত হউক)\""],["قَالَ","qāla","He said","(ইবরাহীম) বলল"],["سَلَـٰمٌۭ","salāmun","Peace","\"সালাম (বর্ষিত হউক)"],["قَوْمٌۭ","qawmun","a people","(এসব) লোকজন"],["مُّنكَرُونَ","munkarūna","unknown","অপরিচিত (মনে হচ্ছে)\""]],"t":"إِذْ دَخَلُو<s>ا۟</> عَلَيْهِ فَقَالُو<s>ا۟</> سَ<m>لَٰ</><k>مًۭا ۖ قَ</>الَ سَ<m>لَٰ</><k>مٌۭ قَ</>وْ<d>مٌۭ مُّ</><k>نكَ</><p>رُو</>نَ"},{"n":26,"w":[["فَرَاغَ","farāgha","Then he went","অতঃপর সে চলে গেল"],["إِلَىٰٓ","ilā","to","নিকট"],["أَهْلِهِۦ","ahlihi","his household","তার স্ত্রীর"],["فَجَآءَ","fajāa","and came","অতঃপর আনল"],["بِعِجْلٍۢ","bi‘ij'lin","with a calf","একটি বাছুর নিয়ে (তাজা)"],["سَمِينٍۢ","samīnin","fat","মোটা তাজা"]],"t":"فَرَاغَ إِلَ<o>ىٰٓ</> أَهْلِ<m>هِۦ</> فَ<o>جَآ</>ءَ بِعِ<q>جْ</><k>لٍۢ سَ</><p>مِي</>نٍۢ"},{"n":27,"w":[["فَقَرَّبَهُۥٓ","faqarrabahu","And he placed it near","তা অতঃপর কাছে আনল"],["إِلَيْهِمْ","ilayhim","[to] them","তাদের"],["قَالَ","qāla","he said","সে বলল"],["أَلَا","alā","Will not","\"না কেন"],["تَأْكُلُونَ","takulūna","you eat","তোমরা খাচ্ছ\""]],"t":"فَقَرَّبَهُ<o>ۥٓ</> إِلَيْهِمْ قَالَ أَلَا تَأْكُ<p>لُو</>نَ"},{"n":28,"w":[["فَأَوْجَسَ","fa-awjasa","Then he felt","ফলে তিনি অনুভব করলেন"],["مِنْهُمْ","min'hum","from them","তাদের থেকে"],["خِيفَةًۭ ۖ","khīfatan","a fear","ভয়"],["قَالُوا۟","qālū","They said","তারা বলল"],["لَا","lā","(Do) not","\"না"],["تَخَفْ ۖ","takhaf","fear","ভয় করো\""],["وَبَشَّرُوهُ","wabasharūhu","and they gave him glad tidings","এবং তাকে তারা সুসংবাদ দিল"],["بِغُلَـٰمٍ","bighulāmin","of a son","একটি ছেলের (জন্মের)"],["عَلِيمٍۢ","‘alīmin","learned","(যে হবে) জ্ঞানী"]],"t":"فَأَوْجَسَ مِنْهُمْ خِيفَ<k>ةًۭ ۖ قَ</>الُو<s>ا۟</> لَا تَخَفْ ۖ وَبَشَّرُوهُ بِغُ<m>لَٰ</>مٍ عَ<p>لِي</>مٍۢ"},{"n":29,"w":[["فَأَقْبَلَتِ","fa-aqbalati","Then came forward","তখন সামনে এল"],["ٱمْرَأَتُهُۥ","im'ra-atuhu","his wife","তার স্ত্রী"],["فِى","fī","with","অবস্থায়"],["صَرَّةٍۢ","ṣarratin","a loud voice","চিৎকার"],["فَصَكَّتْ","faṣakkat","and struck","এরপর চাপড়াল"],["وَجْهَهَا","wajhahā","her face","তার (নিজের) গালে"],["وَقَالَتْ","waqālat","and she said","এবং বলল"],["عَجُوزٌ","‘ajūzun","An old woman","\"(এই) বৃদ্ধা"],["عَقِيمٌۭ","‘aqīmun","barren","বন্ধ্যার (সন্তান হবে!)\""]],"t":"فَأَ<q>قْ</>بَلَتِ <h>ٱ</>مْرَأَتُهُ<m>ۥ</> فِى صَرَّ<k>ةٍۢ فَ</>صَكَّتْ وَ<q>جْ</>هَهَا وَقَالَتْ عَجُوزٌ عَ<p>قِي</>مٌۭ"},{"n":30,"w":[["قَالُوا۟","qālū","They said","তারা বলল"],["كَذَٰلِكِ","kadhāliki","Thus","\"এরূপই"],["قَالَ","qāla","said","বলেছেন"],["رَبُّكِ ۖ","rabbuki","your Lord","তোমার রব"],["إِنَّهُۥ","innahu","Indeed, He","নিশ্চয়ই তিনি"],["هُوَ","huwa","[He]","তিনিই"],["ٱلْحَكِيمُ","l-ḥakīmu","(is) the All-Wise","প্রজ্ঞাময়"],["ٱلْعَلِيمُ","l-‘alīmu","the All-Knower","সবকিছু জানেন\""]],"t":"قَالُو<s>ا۟</> كَ<m>ذَٰ</>لِكِ قَالَ رَبُّكِ ۖ إِ<g>نَّ</>هُ<m>ۥ</> هُوَ <h>ٱ</>لْحَكِيمُ <h>ٱ</>لْعَ<p>لِي</>مُ"},{"n":31,"w":[["۞ قَالَ","qāla","He said","সে বলল"],["فَمَا","famā","Then what","\"কি তাহলে"],["خَطْبُكُمْ","khaṭbukum","(is) your mission","তোমাদের উদ্দেশ্য"],["أَيُّهَا","ayyuhā","O messengers","হে\""],["ٱلْمُرْسَلُونَ","l-mur'salūna","O messengers","প্রেরিত (ফেরেশতা) গণ\""]],"t":"۞ قَالَ فَمَا خَ<q>طْ</>بُكُمْ أَيُّهَا <h>ٱ</>لْمُرْسَ<p>لُو</>نَ"},{"n":32,"w":[["قَالُوٓا۟","qālū","They said","তারা বলল"],["إِنَّآ","innā","Indeed, we","\"নিশ্চয়ই আমরা"],["أُرْسِلْنَآ","ur'sil'nā","[we] have been sent","আমরা প্রেরিত হয়েছি"],["إِلَىٰ","ilā","to","প্রতি"],["قَوْمٍۢ","qawmin","a people","জাতির"],["مُّجْرِمِينَ","muj'rimīna","criminal","অপরাধী"]],"t":"قَا<o>لُوٓ</><s>ا۟</> إِ<g>نَّ</><o>آ</> أُرْسِلْ<o>نَآ</> إِلَىٰ قَوْ<d>مٍۢ مُّ</><q>جْ</>رِ<p>مِي</>نَ"},{"n":33,"w":[["لِنُرْسِلَ","linur'sila","That we may send down","যেন আমরা নিক্ষেপ করি"],["عَلَيْهِمْ","‘alayhim","upon them","তাদের উপর"],["حِجَارَةًۭ","ḥijāratan","stones","পাথর"],["مِّن","min","of","তৈরি"],["طِينٍۢ","ṭīnin","clay","(পাকা) মাটির"]],"t":"لِنُرْسِلَ عَلَيْهِمْ حِجَارَ<d>ةًۭ مِّ</><k>ن طِ</><p>ي</>نٍۢ"},{"n":34,"w":[["مُّسَوَّمَةً","musawwamatan","Marked","চিহ্নিত (হয়ে আছে)"],["عِندَ","‘inda","by your Lord","কাছে"],["رَبِّكَ","rabbika","by your Lord","তোমার রবের"],["لِلْمُسْرِفِينَ","lil'mus'rifīna","for the transgressors","সীমা লঙ্ঘনকারীদের জন্যে\""]],"t":"مُّسَوَّمَةً عِ<k>ندَ</> رَبِّكَ لِلْمُسْرِ<p>فِي</>نَ"},{"n":35,"w":[["فَأَخْرَجْنَا","fa-akhrajnā","Then We brought out","এরপর আমরা বের করলাম"],["مَن","man","(those) who","(তাদেরকে) যারা"],["كَانَ","kāna","were","ছিল"],["فِيهَا","fīhā","therein","তার মধ্যে"],["مِنَ","mina","of","মধ্য হতে"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believers","মু'মিনদের"]],"t":"فَأَخْرَ<q>جْ</>نَا مَ<k>ن كَ</>انَ فِيهَا مِنَ <h>ٱ</>لْمُؤْمِ<p>نِي</>نَ"},{"n":36,"w":[["فَمَا","famā","But not","না অতঃপর"],["وَجَدْنَا","wajadnā","We found","আমরা পেয়েছি"],["فِيهَا","fīhā","therein","তার মধ্যে"],["غَيْرَ","ghayra","other than","এ ব্যতীত"],["بَيْتٍۢ","baytin","a house","একটি ঘর"],["مِّنَ","mina","of","থেকে"],["ٱلْمُسْلِمِينَ","l-mus'limīna","the Muslims","মুসলমানদের"]],"t":"فَمَا وَجَ<q>دْ</>نَا فِيهَا غَيْرَ بَيْ<d>تٍۢ مِّ</>نَ <h>ٱ</>لْمُسْلِ<p>مِي</>نَ"},{"n":37,"w":[["وَتَرَكْنَا","wataraknā","And We left","এবং আমরা রেখেছি"],["فِيهَآ","fīhā","therein","সেখানে"],["ءَايَةًۭ","āyatan","a Sign","একটি নিদর্শন"],["لِّلَّذِينَ","lilladhīna","for those who","(তাদের) জন্যে যারা"],["يَخَافُونَ","yakhāfūna","fear","ভয় করে"],["ٱلْعَذَابَ","l-‘adhāba","the punishment","শাস্তির"],["ٱلْأَلِيمَ","l-alīma","the painful","যন্ত্রণাদায়ক"]],"t":"وَتَرَكْنَا فِي<o>هَآ</> ءَايَ<w>ةًۭ لِّ</>لَّذِينَ يَخَافُونَ <h>ٱ</>لْعَذَابَ <h>ٱ</>لْأَ<p>لِي</>مَ"},{"n":38,"w":[["وَفِى","wafī","And in","এবং মধ্যে ( নিদর্শন আছে)"],["مُوسَىٰٓ","mūsā","Musa","মুসার (কাহিনীর)"],["إِذْ","idh","when","যখন"],["أَرْسَلْنَـٰهُ","arsalnāhu","We sent him","তাকে আমরা প্রেরণ করেছিলাম"],["إِلَىٰ","ilā","to","প্রতি"],["فِرْعَوْنَ","fir'‘awna","Firaun","ফিরআউনের"],["بِسُلْطَـٰنٍۢ","bisul'ṭānin","with an authority","প্রমাণসহ"],["مُّبِينٍۢ","mubīnin","clear","সুস্পষ্ট"]],"t":"وَفِى مُوسَ<o>ىٰٓ</> إِذْ أَرْسَلْ<m>نَٰ</>هُ إِلَىٰ فِرْعَوْنَ بِسُلْ<m>طَٰ</><d>نٍۢ مُّ</><p>بِي</>نٍۢ"},{"n":39,"w":[["فَتَوَلَّىٰ","fatawallā","But he turned away","অতঃপর সে মুখ ফিরায়"],["بِرُكْنِهِۦ","biruk'nihi","with his supporters","তার সভাসদগণসহ"],["وَقَالَ","waqāla","and said","এবং বলেছিল"],["سَـٰحِرٌ","sāḥirun","A magician","\"(সে একজন) জাদুকর"],["أَوْ","aw","or","অথবা"],["مَجْنُونٌۭ","majnūnun","a madman","পাগল (জ্বিন আশ্রিত)\""]],"t":"فَتَوَلَّىٰ بِرُكْنِ<m>هِۦ</> وَقَالَ <m>سَٰ</>حِرٌ أَوْ مَ<q>جْ</><p>نُو</>نٌۭ"},{"n":40,"w":[["فَأَخَذْنَـٰهُ","fa-akhadhnāhu","So We took him","অবশেষে তাকে আমরা পাকড়াও করলাম"],["وَجُنُودَهُۥ","wajunūdahu","and his hosts","ও তার সৈন্যদেরকে"],["فَنَبَذْنَـٰهُمْ","fanabadhnāhum","and threw them","এরপর তাদের আমরা নিক্ষেপ করেছিলাম"],["فِى","fī","into","মধ্যে"],["ٱلْيَمِّ","l-yami","the sea","সমুদ্রের"],["وَهُوَ","wahuwa","while he","এবং সে (হয়েছিল)"],["مُلِيمٌۭ","mulīmun","(was) blameworthy","নিন্দিত"]],"t":"فَأَخَذْ<m>نَٰ</>هُ وَجُنُودَهُ<m>ۥ</> فَنَبَذْ<m>نَٰ</>هُمْ فِى <h>ٱ</>لْيَ<g>مِّ</> وَهُوَ مُ<p>لِي</>مٌۭ"},{"n":41,"w":[["وَفِى","wafī","And in","এবং (আছে) মধ্যে (নিদর্শন)"],["عَادٍ","‘ādin","Aad","আ'দ জাতির (ঘটনায়)"],["إِذْ","idh","when","যখন"],["أَرْسَلْنَا","arsalnā","We sent","আমরা পাঠিয়ে ছিলাম"],["عَلَيْهِمُ","‘alayhimu","against them","তাদের বিরুদ্ধে"],["ٱلرِّيحَ","l-rīḥa","the wind","বায়ুপ্রবাহ"],["ٱلْعَقِيمَ","l-‘aqīma","the barren","অকল্যাণকর/ বিধ্বংসী"]],"t":"وَفِى عَادٍ إِذْ أَرْسَلْنَا عَلَيْهِمُ <h>ٱ</><l>ل</>رِّيحَ <h>ٱ</>لْعَ<p>قِي</>مَ"},{"n":42,"w":[["مَا","mā","Not","না"],["تَذَرُ","tadharu","it left","ছেড়েছিল"],["مِن","min","any","কোনো"],["شَىْءٍ","shayin","thing","কিছুই"],["أَتَتْ","atat","it came","বয়ে গিয়েছিল"],["عَلَيْهِ","‘alayhi","upon it","যার উপর (দিয়ে)"],["إِلَّا","illā","but","এছাড়া"],["جَعَلَتْهُ","ja‘alathu","it made it","তাকে করেছিল"],["كَٱلرَّمِيمِ","kal-ramīmi","like disintegrated ruins","যেন চূর্ণবিচূর্ণ"]],"t":"مَا تَذَرُ مِ<k>ن شَ</>ىْءٍ أَتَتْ عَلَيْهِ إِلَّا جَعَلَتْهُ كَ<h>ٱ</><l>ل</>رَّ<p>مِي</>مِ"},{"n":43,"w":[["وَفِى","wafī","And in","এবং (আছে) মধ্যে (নিদর্শন)"],["ثَمُودَ","thamūda","Thamud","সামূদ জাতির (ঘটনায়)"],["إِذْ","idh","when","যখন"],["قِيلَ","qīla","was said","বলা হয়েছিল"],["لَهُمْ","lahum","to them","তাদেরকে"],["تَمَتَّعُوا۟","tamatta‘ū","Enjoy (yourselves)","\"তোমরা উপভোগ করো"],["حَتَّىٰ","ḥattā","for","পর্যন্ত"],["حِينٍۢ","ḥīnin","a time","একটি নির্দিষ্ট সময়\""]],"t":"وَفِى ثَمُودَ إِذْ قِيلَ لَهُمْ تَمَتَّعُو<s>ا۟</> حَتَّىٰ <p>حِي</>نٍۢ"},{"n":44,"w":[["فَعَتَوْا۟","fa‘ataw","But they rebelled","এরপরও তারা সীমালংঘন করল"],["عَنْ","‘an","against","ব্যাপারে"],["أَمْرِ","amri","(the) Command","নির্দেশের"],["رَبِّهِمْ","rabbihim","(of) their Lord","তাদের রবের"],["فَأَخَذَتْهُمُ","fa-akhadhathumu","so seized them","অবশেষে তাদেরকে পাকড়াও করল"],["ٱلصَّـٰعِقَةُ","l-ṣā‘iqatu","the thunderbolt","(আমার) বজ্রাঘাতে"],["وَهُمْ","wahum","while they","এ অবস্থায় যে তারা"],["يَنظُرُونَ","yanẓurūna","were looking","দেখছিল"]],"t":"فَعَتَوْ<s>ا۟</> عَنْ أَمْرِ رَبِّهِمْ فَأَخَذَتْهُمُ <h>ٱ</><l>ل</><m>صَّٰ</>عِقَةُ وَهُمْ يَ<k>نظُ</><p>رُو</>نَ"},{"n":45,"w":[["فَمَا","famā","Then not","অতঃপর না"],["ٱسْتَطَـٰعُوا۟","is'taṭā‘ū","they were able to","তারা পেরেছিল"],["مِن","min","[of]","থেকে"],["قِيَامٍۢ","qiyāmin","stand","উঠে দাঁড়াতে"],["وَمَا","wamā","and not","আর না"],["كَانُوا۟","kānū","they could","তারা ছিল"],["مُنتَصِرِينَ","muntaṣirīna","help themselves","আত্মরক্ষা করতে সক্ষম"]],"t":"فَمَا <h>ٱ</>سْتَ<m>طَٰ</>عُو<s>ا۟</> مِ<k>ن قِ</>يَا<d>مٍۢ وَ</>مَا كَانُو<s>ا۟</> مُ<k>نتَ</>صِ<p>رِي</>نَ"},{"n":46,"w":[["وَقَوْمَ","waqawma","And (the) people","এবং জাতিকে"],["نُوحٍۢ","nūḥin","(of) Nuh","নূহের"],["مِّن","min","before","থেকে"],["قَبْلُ ۖ","qablu","before","ইতিপূর্বে (ধ্বংস করেছি)"],["إِنَّهُمْ","innahum","indeed, they","তারা নিশ্চয়ই"],["كَانُوا۟","kānū","were","তারা ছিল"],["قَوْمًۭا","qawman","a people","জাতি"],["فَـٰسِقِينَ","fāsiqīna","defiantly disobedient","সত্যত্যাগী"]],"t":"وَقَوْمَ نُو<d>حٍۢ مِّ</><k>ن قَ</><q>بْ</>لُ ۖ إِ<g>نَّ</>هُمْ كَانُو<s>ا۟</> قَوْ<k>مًۭا فَٰ</>سِ<p>قِي</>نَ"},{"n":47,"w":[["وَٱلسَّمَآءَ","wal-samāa","And the heaven","এবং আকাশ"],["بَنَيْنَـٰهَا","banaynāhā","We constructed it","তা আমরা সৃষ্টি করেছি"],["بِأَيْي۟دٍۢ","bi-aydin","with strength","(নিজের) হাত দিয়ে"],["وَإِنَّا","wa-innā","and indeed, We","এবং আমরা নিশ্চয়ই"],["لَمُوسِعُونَ","lamūsi‘ūna","(are) surely (its) Expanders","অবশ্যই সপ্রসারণকারী"]],"t":"وَ<h>ٱ</><l>ل</>سَّ<o>مَآ</>ءَ بَنَيْ<m>نَٰ</>هَا بِأَيْ<s>ي۟</><d>دٍۢ وَ</>إِ<g>نَّ</>ا لَمُوسِ<p>عُو</>نَ"},{"n":48,"w":[["وَٱلْأَرْضَ","wal-arḍa","And the earth","এবং ভূমিকে"],["فَرَشْنَـٰهَا","farashnāhā","We have spread it","তা আমরা সমতল করে দিয়েছি"],["فَنِعْمَ","fani‘'ma","how excellent","আর কতই না উত্তম"],["ٱلْمَـٰهِدُونَ","l-māhidūna","(are) the Spreaders","সমতলকারী (আমরা)"]],"t":"وَ<h>ٱ</>لْأَرْضَ فَرَشْ<m>نَٰ</>هَا فَنِعْمَ <h>ٱ</>لْ<m>مَٰ</>هِ<p>دُو</>نَ"},{"n":49,"w":[["وَمِن","wamin","And of","এবং থেকে"],["كُلِّ","kulli","every","প্রত্যেক"],["شَىْءٍ","shayin","thing","বস্তুকে"],["خَلَقْنَا","khalaqnā","We have created","আমরা সৃষ্টি করেছি"],["زَوْجَيْنِ","zawjayni","pairs","জোড়ায় জোড়ায়"],["لَعَلَّكُمْ","la‘allakum","so that you may","তোমরা যাতে"],["تَذَكَّرُونَ","tadhakkarūna","remember","শিক্ষা গ্রহণ কর"]],"t":"وَمِ<k>ن كُ</>لِّ شَىْءٍ خَلَ<q>قْ</>نَا زَوْجَيْنِ لَعَلَّكُمْ تَذَكَّ<p>رُو</>نَ"},{"n":50,"w":[["فَفِرُّوٓا۟","fafirrū","So flee","অতএব তোমরা দৌড়াও"],["إِلَى","ilā","to","দিকে"],["ٱللَّهِ ۖ","l-lahi","Allah","আল্লাহর"],["إِنِّى","innī","indeed, I am","নিশ্চয়ই আমি"],["لَكُم","lakum","to you","তোমাদের জন্যে"],["مِّنْهُ","min'hu","from Him","তার পক্ষ হতে"],["نَذِيرٌۭ","nadhīrun","a warner","একজন সতর্ককারী"],["مُّبِينٌۭ","mubīnun","clear","সুস্পষ্ট"]],"t":"فَفِ<o>رُّوٓ</><s>ا۟</> إِلَى <h>ٱ</>للَّهِ ۖ إِ<g>نِّ</>ى لَ<y>كُم مِّ</>نْهُ نَذِي<d>رٌۭ مُّ</><p>بِي</>نٌۭ"},{"n":51,"w":[["وَلَا","walā","And (do) not","এবং না"],["تَجْعَلُوا۟","taj‘alū","make","তোমরা বানাবে"],["مَعَ","ma‘a","with","সাথে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["إِلَـٰهًا","ilāhan","god","উপাস্য"],["ءَاخَرَ ۖ","ākhara","another","অন্য কোনো"],["إِنِّى","innī","Indeed, I am","নিশ্চয়ই আমি"],["لَكُم","lakum","to you","তোমাদের জন্যে"],["مِّنْهُ","min'hu","from Him","তাঁর পক্ষ হতে"],["نَذِيرٌۭ","nadhīrun","a warner","একজন সতর্ককারী"],["مُّبِينٌۭ","mubīnun","clear","সুস্পষ্ট"]],"t":"وَلَا تَ<q>جْ</>عَلُو<s>ا۟</> مَعَ <h>ٱ</>للَّهِ إِ<m>لَٰ</>هًا ءَاخَرَ ۖ إِ<g>نِّ</>ى لَ<y>كُم مِّ</>نْهُ نَذِي<d>رٌۭ مُّ</><p>بِي</>نٌۭ"},{"n":52,"w":[["كَذَٰلِكَ","kadhālika","Likewise","এভাবেই"],["مَآ","mā","not","না"],["أَتَى","atā","came","এসেছে"],["ٱلَّذِينَ","alladhīna","(to) those","(তাদের কাছে) যারা"],["مِن","min","before them","থেকে"],["قَبْلِهِم","qablihim","before them","তাদের পূর্বে (ছিল)"],["مِّن","min","any","কোনো"],["رَّسُولٍ","rasūlin","Messenger","রাসূল"],["إِلَّا","illā","but","এছাড়া যে"],["قَالُوا۟","qālū","they said","তারা বলে ছিল"],["سَاحِرٌ","sāḥirun","A magician","\"(সে একজন) জাদুকর"],["أَوْ","aw","or","বা"],["مَجْنُونٌ","majnūnun","a madman","পাগল\""]],"t":"كَ<m>ذَٰ</>لِكَ <o>مَآ</> أَتَى <h>ٱ</>لَّذِينَ مِ<k>ن قَ</><q>بْ</>لِ<y>هِم مِّ</><w>ن رَّ</>سُولٍ إِلَّا قَالُو<s>ا۟</> سَاحِرٌ أَوْ مَ<q>جْ</><p>نُو</>نٌ"},{"n":53,"w":[["أَتَوَاصَوْا۟","atawāṣaw","Have they transmitted it to them","তারা পরস্পরে কি পরামর্শ করে নিয়েছে"],["بِهِۦ ۚ","bihi","Have they transmitted it to them","সে বিষয়ে"],["بَلْ","bal","Nay","(না) বরং"],["هُمْ","hum","they","তারা(ছিল)"],["قَوْمٌۭ","qawmun","(are) a people","জাতি"],["طَاغُونَ","ṭāghūna","transgressing","দুর্বিনীত"]],"t":"أَتَوَاصَوْ<s>ا۟</> بِ<m>هِۦ</> ۚ بَلْ هُمْ قَوْ<k>مٌۭ طَ</>ا<p>غُو</>نَ"},{"n":54,"w":[["فَتَوَلَّ","fatawalla","So turn away","তাই তুমি উপেক্ষা করো"],["عَنْهُمْ","‘anhum","from them","তাদের হতে"],["فَمَآ","famā","for not","আর নও"],["أَنتَ","anta","you","তুমি"],["بِمَلُومٍۢ","bimalūmin","(are) to be blamed","তিরস্কৃত"]],"t":"فَتَوَلَّ عَنْهُمْ فَ<o>مَآ</> أَ<k>نتَ</> بِمَ<p>لُو</>مٍۢ"},{"n":55,"w":[["وَذَكِّرْ","wadhakkir","And remind","এবং উপদেশ দাও"],["فَإِنَّ","fa-inna","for indeed","কেননা নিশ্চয়ই"],["ٱلذِّكْرَىٰ","l-dhik'rā","the reminder","উপদেশ"],["تَنفَعُ","tanfa‘u","benefits","উপকার দিবে"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believers","মু'মিনদেরকে"]],"t":"وَذَكِّرْ فَإِ<g>نَّ</> <h>ٱ</><l>ل</>ذِّكْرَىٰ تَ<k>نفَ</>عُ <h>ٱ</>لْمُؤْمِ<p>نِي</>نَ"},{"n":56,"w":[["وَمَا","wamā","And not","এবং না"],["خَلَقْتُ","khalaqtu","I have created","আমি সৃষ্টি করেছি"],["ٱلْجِنَّ","l-jina","the jinn","জিনকে"],["وَٱلْإِنسَ","wal-insa","and the mankind","ও মানুষকে"],["إِلَّا","illā","except","এছাড়া যে"],["لِيَعْبُدُونِ","liya‘budūni","that they worship Me","যেন আমাকে তারা ইবাদত করে"]],"t":"وَمَا خَلَ<q>قْ</>تُ <h>ٱ</>لْجِ<g>نَّ</> وَ<h>ٱ</>لْإِ<k>نسَ</> إِلَّا لِيَعْبُ<p>دُو</>نِ"},{"n":57,"w":[["مَآ","mā","Not","না"],["أُرِيدُ","urīdu","I want","চাই আমি"],["مِنْهُم","min'hum","from them","তাদের নিকট হতে"],["مِّن","min","any","কোনো"],["رِّزْقٍۢ","riz'qin","provision","জীবিকা"],["وَمَآ","wamā","and not","আর না"],["أُرِيدُ","urīdu","I want","চাই আমি"],["أَن","an","that","যে"],["يُطْعِمُونِ","yuṭ'‘imūni","they (should) feed Me","আমাকে তারা খাওয়াবে"]],"t":"<o>مَآ</> أُرِيدُ مِنْ<y>هُم مِّ</><w>ن رِّ</>زْ<d>قٍۢ وَ</><o>مَآ</> أُرِيدُ <d>أَن يُ</><q>طْ</>عِ<p>مُو</>نِ"},{"n":58,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["هُوَ","huwa","He","তিনিই"],["ٱلرَّزَّاقُ","l-razāqu","(is) the All-Provider","রিযকদাতা"],["ذُو","dhū","Possessor","আছে"],["ٱلْقُوَّةِ","l-quwati","(of) Power","শক্তিসম্পন্ন"],["ٱلْمَتِينُ","l-matīnu","the Strong","প্রবল পরাক্রান্ত"]],"t":"إِ<g>نَّ</> <h>ٱ</>للَّهَ هُوَ <h>ٱ</><l>ل</>رَّزَّاقُ ذُو <h>ٱ</>لْقُوَّةِ <h>ٱ</>لْمَ<p>تِي</>نُ"},{"n":59,"w":[["فَإِنَّ","fa-inna","So indeed","অতএব নিশ্চয়ই"],["لِلَّذِينَ","lilladhīna","for those who","তাদের জন্যে"],["ظَلَمُوا۟","ẓalamū","do wrong","(যারা) সীমালঙ্ঘন করেছে"],["ذَنُوبًۭا","dhanūban","(is) a portion","(তাদের আছে) শাস্তির অংশ"],["مِّثْلَ","mith'la","like","যেমনি"],["ذَنُوبِ","dhanūbi","(the) portion","(প্রাপ্য ছিল) শাস্তির অংশ"],["أَصْحَـٰبِهِمْ","aṣḥābihim","(of) their companions","তাদের সাথীদের"],["فَلَا","falā","so let them not ask Me to hasten","না তাই (যেন)"],["يَسْتَعْجِلُونِ","yasta‘jilūni","so let them not ask Me to hasten","আমার কাছে তারা তাড়াহুড়া করে"]],"t":"فَإِ<g>نَّ</> لِلَّذِينَ ظَلَمُو<s>ا۟</> ذَنُو<d>بًۭا مِّ</>ثْلَ ذَنُوبِ أَصْ<m>حَٰ</>بِهِمْ فَلَا يَسْتَعْجِ<p>لُو</>نِ"},{"n":60,"w":[["فَوَيْلٌۭ","fawaylun","Then woe","অতঃপর দুর্ভোগ"],["لِّلَّذِينَ","lilladhīna","to those who","(তাদের) জন্যে যারা"],["كَفَرُوا۟","kafarū","disbelieve","অস্বীকার করেছে"],["مِن","min","from","ব্যাপারে"],["يَوْمِهِمُ","yawmihimu","their Day","তাদের (সেই) দিনের"],["ٱلَّذِى","alladhī","which","যার"],["يُوعَدُونَ","yū‘adūna","they are promised","ভয় তাদের দেখান হয়েছে"]],"t":"فَوَيْ<w>لٌۭ لِّ</>لَّذِينَ كَفَرُو<s>ا۟</> <d>مِن يَ</>وْمِهِمُ <h>ٱ</>لَّذِى يُوعَ<p>دُو</>نَ"}]}