{"n":90,"a":[{"n":1,"w":[["لَآ","lā","Nay","না"],["أُقْسِمُ","uq'simu","I swear","আমি শপথ করছি"],["بِهَـٰذَا","bihādhā","by this","এই"],["ٱلْبَلَدِ","l-baladi","city","নগরের (অর্থাৎ মক্কার)"]],"t":"<o>لَآ</> أُ<q>قْ</>سِمُ بِ<m>هَٰ</>ذَا <h>ٱ</>لْبَلَ<q>دِ</>"},{"n":2,"w":[["وَأَنتَ","wa-anta","And you","আর তুমি"],["حِلٌّۢ","ḥillun","(are) free (to dwell)","হালাল/অধিবাসী (হয়েছে)"],["بِهَـٰذَا","bihādhā","in this","এই"],["ٱلْبَلَدِ","l-baladi","city","নগরের"]],"t":"وَأَ<k>نتَ</> حِ<i>لٌّۢ بِ</><m>هَٰ</>ذَا <h>ٱ</>لْبَلَ<q>دِ</>"},{"n":3,"w":[["وَوَالِدٍۢ","wawālidin","And the begetter","(আরও) শপথ পিতার (আদম আঃ)"],["وَمَا","wamā","and what","এবং যা"],["وَلَدَ","walada","he begot","জন্ম দিয়েছেন (সেই সন্তানের)"]],"t":"وَوَالِ<d>دٍۢ وَ</>مَا وَلَ<q>دَ</>"},{"n":4,"w":[["لَقَدْ","laqad","Certainly","নিশ্চয়ই"],["خَلَقْنَا","khalaqnā","We have created","আমরা সৃষ্টি করেছি"],["ٱلْإِنسَـٰنَ","l-insāna","man","মানুষকে"],["فِى","fī","(to be) in","মধ্যে"],["كَبَدٍ","kabadin","hardship","কষ্টের"]],"t":"لَقَ<q>دْ</> خَلَ<q>قْ</>نَا <h>ٱ</>لْإِ<k>نسَٰ</>نَ فِى كَبَ<q>دٍ</>"},{"n":5,"w":[["أَيَحْسَبُ","ayaḥsabu","Does he think","মনে করে কি সে"],["أَن","an","that","যে"],["لَّن","lan","not","কখনও না"],["يَقْدِرَ","yaqdira","has power","ক্ষমতাবান হবে"],["عَلَيْهِ","‘alayhi","over him","তার উপর"],["أَحَدٌۭ","aḥadun","anyone","কেউ"]],"t":"أَيَحْسَبُ <w>أَن لَّ</><d>ن يَ</><q>قْ</>دِرَ عَلَيْهِ أَحَ<q>دٌۭ</>"},{"n":6,"w":[["يَقُولُ","yaqūlu","He will say","সে বলে"],["أَهْلَكْتُ","ahlaktu","I have squandered","\"আমি নিঃশেষ করেছি"],["مَالًۭا","mālan","wealth","ধনসম্পদ"],["لُّبَدًا","lubadan","abundant","বিপুল (পরিমাণ)\""]],"t":"يَقُولُ أَهْلَكْتُ مَالًۭ<w>ا لُّ</>بَدًا"},{"n":7,"w":[["أَيَحْسَبُ","ayaḥsabu","Does he think","সে মনে করে কি"],["أَن","an","that","যে"],["لَّمْ","lam","not","নি"],["يَرَهُۥٓ","yarahu","sees him","তাকে দেখে"],["أَحَدٌ","aḥadun","anyone","কেউ"]],"t":"أَيَحْسَبُ <w>أَن لَّ</>مْ يَرَهُ<o>ۥٓ</> أَحَ<q>دٌ</>"},{"n":8,"w":[["أَلَمْ","alam","Have not","নি কি"],["نَجْعَل","naj‘al","We made","আমরা দিই"],["لَّهُۥ","lahu","for him","তার জন্য"],["عَيْنَيْنِ","‘aynayni","two eyes","দু'চোখ"]],"t":"أَلَمْ نَ<q>جْ</>عَل لَّهُ<m>ۥ</> عَيْنَ<p>يْ</>نِ"},{"n":9,"w":[["وَلِسَانًۭا","walisānan","And a tongue","এবং জিহ্বা"],["وَشَفَتَيْنِ","washafatayni","and two lips","ও দু'ঠোট"]],"t":"وَلِسَا<d>نًۭا وَ</>شَفَتَ<p>يْ</>نِ"},{"n":10,"w":[["وَهَدَيْنَـٰهُ","wahadaynāhu","And shown him","এবং আমরা তাকে  দেখিয়েছি"],["ٱلنَّجْدَيْنِ","l-najdayni","the two ways","(ভাল মন্দ) দুই পথের"]],"t":"وَهَدَيْ<m>نَٰ</>هُ <h>ٱ</><l>ل</><g>نَّ</><q>جْ</>دَ<p>يْ</>نِ"},{"n":11,"w":[["فَلَا","falā","But not","কিন্তু না"],["ٱقْتَحَمَ","iq'taḥama","he has attempted","সে অবলম্বন করেছে"],["ٱلْعَقَبَةَ","l-‘aqabata","the steep path","কষ্টসাধ্য গিরিপথ"]],"t":"فَلَا <h>ٱ</><q>قْ</>تَحَمَ <h>ٱ</>لْعَقَبَةَ"},{"n":12,"w":[["وَمَآ","wamā","And what","এবং কিসে"],["أَدْرَىٰكَ","adrāka","can make you know","তোমাকে জানাবে"],["مَا","mā","what","কি"],["ٱلْعَقَبَةُ","l-‘aqabatu","the steep path (is)","সেই কষ্টসাধ্য গিরিপথ"]],"t":"وَ<o>مَآ</> أَ<q>دْ</>رَ<m>ىٰ</>كَ مَا <h>ٱ</>لْعَقَبَةُ"},{"n":13,"w":[["فَكُّ","fakku","(It is) freeing","মুক্তি"],["رَقَبَةٍ","raqabatin","a neck","দাস"]],"t":"فَكُّ رَقَبَةٍ"},{"n":14,"w":[["أَوْ","aw","Or","অথবা"],["إِطْعَـٰمٌۭ","iṭ'‘āmun","feeding","খানা খাওয়ানো"],["فِى","fī","in","মধ্যে"],["يَوْمٍۢ","yawmin","a day","দিনে"],["ذِى","dhī","of","এর"],["مَسْغَبَةٍۢ","masghabatin","severe hunger","দুর্ভিক্ষ"]],"t":"أَوْ إِ<q>طْ</><m>عَٰ</><k>مٌۭ فِ</>ى يَوْ<k>مٍۢ ذِ</>ى مَسْغَبَةٍۢ"},{"n":15,"w":[["يَتِيمًۭا","yatīman","An orphan","ইয়াতীমকে"],["ذَا","dhā","of","এর"],["مَقْرَبَةٍ","maqrabatin","near relationship","নিকট আত্মীয় সম্পর্ক"]],"t":"يَتِي<k>مًۭا ذَ</>ا مَ<q>قْ</>رَبَةٍ"},{"n":16,"w":[["أَوْ","aw","Or","অথবা"],["مِسْكِينًۭا","mis'kīnan","a needy person","নিঃস্বকে"],["ذَا","dhā","in","মাখা/ যুক্ত"],["مَتْرَبَةٍۢ","matrabatin","misery","ধুলি/ দারিদ্র-নিষ্পেষিত"]],"t":"أَوْ مِسْكِي<k>نًۭا ذَ</>ا مَتْرَبَةٍۢ"},{"n":17,"w":[["ثُمَّ","thumma","Then","তদুপরি (এর সাথে)"],["كَانَ","kāna","he is","সে হলো"],["مِنَ","mina","of","শামিলও"],["ٱلَّذِينَ","alladhīna","those who","(তাদের মধ্য) যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["وَتَوَاصَوْا۟","watawāṣaw","and enjoin (each other)","ও তারা পরস্পরকে উপদেশ দিয়েছে"],["بِٱلصَّبْرِ","bil-ṣabri","to patience","ধৈর্যধারণের"],["وَتَوَاصَوْا۟","watawāṣaw","and enjoin (each other)","ও তারা পরস্পরকে উপদেশ দিয়েছে"],["بِٱلْمَرْحَمَةِ","bil-marḥamati","to compassion","দয়া প্রদর্শনের"]],"t":"ثُ<g>مَّ</> كَانَ مِنَ <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَتَوَاصَوْ<s>ا۟</> بِ<h>ٱ</><l>ل</>صَّ<q>بْ</>رِ وَتَوَاصَوْ<s>ا۟</> بِ<h>ٱ</>لْمَرْحَمَةِ"},{"n":18,"w":[["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব"],["أَصْحَـٰبُ","aṣḥābu","(are the) companions","লোক"],["ٱلْمَيْمَنَةِ","l-maymanati","(of) the right (hand)","ডান দিকের (অর্থাৎ সৌভাগ্যশীল)"]],"t":"أُ<s>و۟</><o>لَٰٓ</>ئِكَ أَصْ<m>حَٰ</>بُ <h>ٱ</>لْمَيْمَنَةِ"},{"n":19,"w":[["وَٱلَّذِينَ","wa-alladhīna","But those who","এবং যারা"],["كَفَرُوا۟","kafarū","disbelieve","অস্বীকার করেছে"],["بِـَٔايَـٰتِنَا","biāyātinā","in Our Verses","আমাদের আয়াতগুলোকে"],["هُمْ","hum","they","তারাই"],["أَصْحَـٰبُ","aṣḥābu","(are the) companions","লোক"],["ٱلْمَشْـَٔمَةِ","l-mashamati","(of) the left (hand)","বাম দিকের (অর্থাৎ হতভাগ্য)"]],"t":"وَ<h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> بِـَٔا<m>يَٰ</>تِنَا هُمْ أَصْ<m>حَٰ</>بُ <h>ٱ</>لْمَشْـَٔمَةِ"},{"n":20,"w":[["عَلَيْهِمْ","‘alayhim","Over them","তাদের উপর"],["نَارٌۭ","nārun","(will be the) Fire","আগুন"],["مُّؤْصَدَةٌۢ","mu'ṣadatun","closed in","পরিবেষ্টনকারী (হয়ে থাকবে)"]],"t":"عَلَيْهِمْ نَا<d>رٌۭ مُّ</>ؤْصَدَةٌۢ"}]}