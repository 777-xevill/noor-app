{"n":87,"a":[{"n":1,"w":[["سَبِّحِ","sabbiḥi","Glorify","মহিমা ঘোষণা করো"],["ٱسْمَ","is'ma","(the) name","নামের"],["رَبِّكَ","rabbika","(of) your Lord","তোমার রবের"],["ٱلْأَعْلَى","l-a‘lā","the Most High","সুমহান"]],"t":"سَبِّحِ <h>ٱ</>سْمَ رَبِّكَ <h>ٱ</>لْأَعْلَى"},{"n":2,"w":[["ٱلَّذِى","alladhī","The One Who","যিনি"],["خَلَقَ","khalaqa","created","সৃষ্টি করেছেন"],["فَسَوَّىٰ","fasawwā","then proportioned","অতঃপর সুবিন্যস্ত করেছেন"]],"t":"ٱلَّذِى خَلَقَ فَسَوَّىٰ"},{"n":3,"w":[["وَٱلَّذِى","wa-alladhī","And the One Who","এবং যিনি"],["قَدَّرَ","qaddara","measured","নিয়তি নির্ধারণ করেছেন"],["فَهَدَىٰ","fahadā","then guided","অতঃপর পথ দেখিয়েছেন"]],"t":"وَ<h>ٱ</>لَّذِى قَدَّرَ فَهَدَىٰ"},{"n":4,"w":[["وَٱلَّذِىٓ","wa-alladhī","And the One Who","এবং যিনি"],["أَخْرَجَ","akhraja","brings forth","উৎপন্ন করেছেন"],["ٱلْمَرْعَىٰ","l-mar‘ā","the pasture","তৃণ"]],"t":"وَ<h>ٱ</>لَّ<o>ذِىٓ</> أَخْرَجَ <h>ٱ</>لْمَرْعَىٰ"},{"n":5,"w":[["فَجَعَلَهُۥ","faja‘alahu","And then makes it","অতঃপর তা পরিণত করেছেন"],["غُثَآءً","ghuthāan","stubble","আবর্জনায়"],["أَحْوَىٰ","aḥwā","dark","কালো"]],"t":"فَجَعَلَهُ<m>ۥ</> غُ<o>ثَآ</>ءً أَحْوَىٰ"},{"n":6,"w":[["سَنُقْرِئُكَ","sanuq'ri-uka","We will make you recite","তোমাকে শীঘ্রই আমরা পড়িয়ে দেব"],["فَلَا","falā","so not","অতঃপর না"],["تَنسَىٰٓ","tansā","you will forget","তুমি ভুলবে"]],"t":"سَنُ<q>قْ</>رِئُكَ فَلَا تَ<k>نسَ</>ىٰٓ"},{"n":7,"w":[["إِلَّا","illā","Except","এ ব্যতীত"],["مَا","mā","what","যা"],["شَآءَ","shāa","wills","ইচ্ছা করেন"],["ٱللَّهُ ۚ","l-lahu","Allah","আল্লাহ্‌"],["إِنَّهُۥ","innahu","Indeed, He","নিশ্চয়ই তিনি"],["يَعْلَمُ","ya‘lamu","knows","জানেন"],["ٱلْجَهْرَ","l-jahra","the manifest","প্রকাশ্য (বিষয়)"],["وَمَا","wamā","and what","ও যা কিছু"],["يَخْفَىٰ","yakhfā","is hidden","কেউ গোপন করে"]],"t":"إِلَّا مَا <o>شَآ</>ءَ <h>ٱ</>للَّهُ ۚ إِ<g>نَّ</>هُ<m>ۥ</> يَعْلَمُ <h>ٱ</>لْجَهْرَ وَمَا يَخْفَىٰ"},{"n":8,"w":[["وَنُيَسِّرُكَ","wanuyassiruka","And We will ease you","এবং আমরা তোমাকে সহজ করে দিবো"],["لِلْيُسْرَىٰ","lil'yus'rā","to the ease","সহজ (পন্থাকে)"]],"t":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ"},{"n":9,"w":[["فَذَكِّرْ","fadhakkir","So remind","অতঃপর উপদেশ দাও"],["إِن","in","if","যদি"],["نَّفَعَتِ","nafa‘ati","benefits","কল্যাণকর হয়"],["ٱلذِّكْرَىٰ","l-dhik'rā","the reminder","উপদেশ"]],"t":"فَذَكِّرْ <d>إِن نَّ</>فَعَتِ <h>ٱ</><l>ل</>ذِّكْرَىٰ"},{"n":10,"w":[["سَيَذَّكَّرُ","sayadhakkaru","He will pay heed ","সে শীঘ্রই শিক্ষা নেবে"],["مَن","man","(one) who","যে"],["يَخْشَىٰ","yakhshā","fears (Allah)","ভয় করে"]],"t":"سَيَذَّكَّرُ <d>مَن يَ</>خْشَىٰ"},{"n":11,"w":[["وَيَتَجَنَّبُهَا","wayatajannabuhā","And will avoid it","আর তা পাশ কাটাবে/ উপেক্ষা করবে"],["ٱلْأَشْقَى","l-ashqā","the wretched one","নিতান্তই হতভাগা"]],"t":"وَيَتَجَ<g>نَّ</>بُهَا <h>ٱ</>لْأَشْقَى"},{"n":12,"w":[["ٱلَّذِى","alladhī","The one who","যে"],["يَصْلَى","yaṣlā","will burn","প্রবেশ করবে"],["ٱلنَّارَ","l-nāra","(in) the Fire","আগুনে"],["ٱلْكُبْرَىٰ","l-kub'rā","[the] great","ভয়াবহ"]],"t":"ٱلَّذِى يَصْلَى <h>ٱ</><l>ل</><g>نَّ</>ارَ <h>ٱ</>لْكُ<q>بْ</>رَىٰ"},{"n":13,"w":[["ثُمَّ","thumma","Then","অতঃপর"],["لَا","lā","not","না"],["يَمُوتُ","yamūtu","he will die","সে মরবে"],["فِيهَا","fīhā","therein","তার মধ্যে"],["وَلَا","walā","and not","আর না"],["يَحْيَىٰ","yaḥyā","will live","বাঁচবে"]],"t":"ثُ<g>مَّ</> لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ"},{"n":14,"w":[["قَدْ","qad","Certainly","নিশ্চয়ই"],["أَفْلَحَ","aflaḥa","has succeeded","সে সাফল্য পেলো"],["مَن","man","(one) who","যে"],["تَزَكَّىٰ","tazakkā","purifies (himself)","পবিত্র হলো"]],"t":"قَ<q>دْ</> أَفْلَحَ مَ<k>ن تَ</>زَكَّىٰ"},{"n":15,"w":[["وَذَكَرَ","wadhakara","And remembers","স্মরণ করল"],["ٱسْمَ","is'ma","(the) name","নাম"],["رَبِّهِۦ","rabbihi","(of) his Lord","তার রবের"],["فَصَلَّىٰ","faṣallā","and prays","অতঃপর সে  সালাত পড়ল"]],"t":"وَذَكَرَ <h>ٱ</>سْمَ رَبِّ<m>هِۦ</> فَصَلَّىٰ"},{"n":16,"w":[["بَلْ","bal","Nay","বরং"],["تُؤْثِرُونَ","tu'thirūna","You prefer","তোমরা প্রাধান্য দাও"],["ٱلْحَيَوٰةَ","l-ḥayata","the life","জীবনকে"],["ٱلدُّنْيَا","l-dun'yā","