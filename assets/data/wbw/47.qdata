دِكَ","‘indika","you","তোমার নিকট"],["قَالُوا۟","qālū","they say","তারা বলে"],["لِلَّذِينَ","lilladhīna","to those who","যাদের (আহলে-কিতাবদেরকে)"],["أُوتُوا۟","ūtū","were given","দেওয়া হয়েছে"],["ٱلْعِلْمَ","l-‘il'ma","the knowledge","জ্ঞান"],["مَاذَا","mādhā","What","\"কি"],["قَالَ","qāla","(has) he said","বলল"],["ءَانِفًا ۚ","ānifan","just now","এইমাত্র\""],["أُو۟لَـٰٓئِكَ","ulāika","Those ","ঐসব লোক"],["ٱلَّذِينَ","alladhīna","(are) the ones","(তারাই) যাদের"],["طَبَعَ","ṭaba‘a","Allah has set a seal","মোহর মেরে দিয়েছেন"],["ٱللَّهُ","l-lahu","Allah has set a seal","আল্লাহ্‌"],["عَلَىٰ","‘alā","upon","উপর"],["قُلُوبِهِمْ","qulūbihim","their hearts","তাদের অন্তর গুলোর"],["وَٱتَّبَعُوٓا۟","wa-ittaba‘ū","and they follow","এবং তারা অনুসরণ করে"],["أَهْوَآءَهُمْ","ahwāahum","their desires","তাদের খেয়াল খুশির"]],"t":"وَمِنْ<y>هُم مَّ</><d>ن يَ</>سْتَمِعُ إِلَيْكَ حَتَّ<o>ىٰٓ</> إِذَا خَرَجُو<s>ا۟</> مِنْ عِ<k>ندِ</>كَ قَالُو<s>ا۟</> لِلَّذِينَ أُوتُو<s>ا۟</> <h>ٱ</>لْعِلْمَ مَاذَا قَالَ ءَانِفًا ۚ أُ<s>و۟</><o>لَٰٓ</>ئِكَ <h>ٱ</>لَّذِينَ طَبَعَ <h>ٱ</>للَّهُ عَلَىٰ قُلُوبِهِمْ وَ<h>ٱ</>تَّبَ<o>عُوٓ</><s>ا۟</> أَهْ<o>وَآ</>ءَهُمْ"},{"n":17,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["ٱهْتَدَوْا۟","ih'tadaw","accept guidance","সৎপথ অবলম্বন করেছে"],["زَادَهُمْ","zādahum","He increases them","তাদেরকে (আল্লাহ্‌) বাড়িয়ে দেন"],["هُدًۭى","hudan","(in) guidance","সৎপথে চলার শক্তি"],["وَءَاتَىٰهُمْ","waātāhum","and gives them","এবং তাদের দান করেন"],["تَقْوَىٰهُمْ","taqwāhum","their righteousness","তাদের তাকওয়া"]],"t":"وَ<h>ٱ</>لَّذِينَ <h>ٱ</>هْتَدَوْ<s>ا۟</> زَادَهُمْ هُ<d>دًۭى وَ</>ءَاتَ<m>ىٰ</>هُمْ تَ<q>قْ</>وَ<m>ىٰ</>هُمْ"},{"n":18,"w":[["فَهَلْ","fahal","Then do","তবে (কি)"],["يَنظُرُونَ","yanẓurūna","they wait","তারা অপেক্ষা করছে"],["إِلَّا","illā","but","এছাড়া"],["ٱلسَّاعَةَ","l-sā‘ata","(for) the Hour","কিয়ামতের"],["أَن","an","that","যে"],["تَأْتِيَهُم","tatiyahum","it should come to them","তাদের কাছে আসবে"],["بَغْتَةًۭ ۖ","baghtatan","suddenly","হঠাৎ করে"],["فَقَدْ","faqad","But indeed","নিশ্চয়ই"],["جَآءَ","jāa","have come","এসেছে"],["أَشْرَاطُهَا ۚ","ashrāṭuhā","its indications","তার লক্ষণসমূহ"],["فَأَنَّىٰ","fa-annā","Then how","অতএব কেমন করে"],["لَهُمْ","lahum","to them","তাদের জন্যে"],["إِذَا","idhā","when","যখন"],["جَآءَتْهُمْ","jāathum","has come to them","তা তাদের কাছে আসবে (কিয়ামত)"],["ذِكْرَىٰهُمْ","dhik'rāhum","their reminder","তাদের উপদেশ (গ্রহণ সম্ভব হবে?)"]],"t":"فَهَلْ يَ<k>نظُ</>رُونَ إِلَّا <h>ٱ</><l>ل</>سَّاعَةَ أَ<k>ن تَ</>أْتِيَ<f>هُم بَ</>غْتَ<k>ةًۭ ۖ فَ</>قَ<q>دْ</> <o>جَآ</>ءَ أَشْرَاطُهَا ۚ فَأَ<g>نَّ</>ىٰ لَهُمْ إِذَا <o>جَآ</>ءَتْهُمْ ذِكْرَ<m>ىٰ</>هُمْ"},{"n":19,"w":[["فَٱعْلَمْ","fa-i‘'lam","So know","অতএব জেনে রাখো"],["أَنَّهُۥ","annahu","that [He] ","যে"],["لَآ","lā","(there is) no","নেই"],["إِلَـٰهَ","ilāha","god","কোনো ইলাহ (যে ইবাদাত পেতে পারে)"],["إِلَّا","illā","but","ছাড়া"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ্‌"],["وَٱسْتَغْفِرْ","wa-is'taghfir","and ask forgiveness","এবং ক্ষমা প্রার্থনা করো"],["لِذَنۢبِكَ","lidhanbika","for your sin","তোমার পাপের জন্যে"],["وَلِلْمُؤْمِنِينَ","walil'mu'minīna","and for the believing men","এবং মু'মিন পুরুষদের জন্যে"],["وَٱلْمُؤْمِنَـٰتِ ۗ","wal-mu'mināti","and the believing women","এবং মু'মিন নারীদের জন্যে"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ্‌"],["يَعْلَمُ","ya‘lamu","knows","জানেন"],["مُتَقَلَّبَكُمْ","mutaqallabakum","your movement","তোমাদের গতিবিধি"],["وَمَثْوَىٰكُمْ","wamathwākum","and your resting places","এবং তোমাদের অবস্থান"]],"t":"فَ<h>ٱ</>عْلَمْ أَ<g>نَّ</>هُ<m>ۥ</> <o>لَآ</> إِ<m>لَٰ</>هَ إِلَّا <h>ٱ</>للَّهُ وَ<h>ٱ</>سْتَغْفِرْ لِذَ<i>نۢبِ</>كَ وَلِلْمُؤْمِنِينَ وَ<h>ٱ</>لْمُؤْمِ<m>نَٰ</>تِ ۗ وَ<h>ٱ</>للَّهُ يَعْلَمُ مُتَقَلَّبَكُمْ وَمَثْوَ<m>ىٰ</>كُمْ"},{"n":20,"w":[["وَيَقُولُ","wayaqūlu","And say","এবং বলে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["لَوْلَا","lawlā","Why not","\"কেন না"],["نُزِّلَتْ","nuzzilat","has been revealed","নাযিল করা হয়"],["سُورَةٌۭ ۖ","sūratun","a Surah","একটি সূরাহ (যুদ্ধাদেশ দিয়ে)\""],["فَإِذَآ","fa-idhā","But when","অতঃপর যখন"],["أُنزِلَتْ","unzilat","is revealed","নাযিল করা হলো"],["سُورَةٌۭ","sūratun","a Surah","একটি সূরাহ"],["مُّحْكَمَةٌۭ","muḥ'kamatun","precise","দ্ব্যর্থহীন"],["وَذُكِرَ","wadhukira","and is mentioned","এবং উল্লেখ করা ছিল"],["فِيهَا","fīhā","in it","তার মধ্যে"],["ٱلْقِتَالُ ۙ","l-qitālu","the fighting","যুদ্ধের (নির্দেশ)"],["رَأَيْتَ","ra-ayta","you see","তুমি দেখলে"],["ٱلَّذِينَ","alladhīna","those who","তাদেরকে (যাদের)"],["فِى","fī","in","আছে"],["قُلُوبِهِم","qulūbihim","their hearts","তাদের অন্তরসমূহে"],["مَّرَضٌۭ","maraḍun","(is) a disease","রোগ"],["يَنظُرُونَ","yanẓurūna","looking","তারা তাকাচ্ছে"],["إِلَيْكَ","ilayka","at you ","তোমার দিকে"],["نَظَرَ","naẓara","a look","(এমন) দৃষ্টিতে"],["ٱلْمَغْشِىِّ","l-maghshiyi","(of) one fainting","ছেয়ে গেছে"],["عَلَيْهِ","‘alayhi","(of) one fainting","যার উপর"],["مِنَ","mina","from","থেকে"],["ٱلْمَوْتِ ۖ","l-mawti","the death","মৃত্যু"],["فَأَوْلَىٰ","fa-awlā","But more appropriate","সুতরাং দুর্ভোগ"],["لَهُمْ","lahum","for them","তাদের জন্যে"]],"t":"وَيَقُولُ <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> لَوْلَا نُزِّلَتْ سُورَ<k>ةٌۭ ۖ فَ</>إِ<o>ذَآ</> أُ<k>نزِ</>لَتْ سُورَ<d>ةٌۭ مُّ</>حْكَمَ<d>ةٌۭ وَ</>ذُكِرَ فِيهَا <h>ٱ</>لْقِتَالُ ۙ رَأَيْتَ <h>ٱ</>لَّذِينَ فِى قُلُوبِ<y>هِم مَّ</>رَ<d>ضٌۭ يَ</><k>نظُ</>رُونَ إِلَيْكَ نَظَرَ <h>ٱ</>لْمَغْشِىِّ عَلَيْهِ مِنَ <h>ٱ</>لْمَوْتِ ۖ فَأَوْلَىٰ لَهُمْ"},{"n":21,"w":[["طَاعَةٌۭ","ṭā‘atun","(Is) obedience","(তাদের মুখে তো) আনুগত্য"],["وَقَوْلٌۭ","waqawlun","and a word","ও কথা"],["مَّعْرُوفٌۭ ۚ","ma‘rūfun","kind","ন্যায়সংগত / ভালো ভালো"],["فَإِذَا","fa-idhā","And when","কিন্তু যখন"],["عَزَمَ","‘azama","(is) determined","চূড়ান্ত হলো"],["ٱلْأَمْرُ","l-amru","the matter","(জিহাদের) বিষয়টি"],["فَلَوْ","falaw","then if","তখন যদি"],["صَدَقُوا۟","ṣadaqū","they had been true","তারা সত্য প্রমাণ করত"],["ٱللَّهَ","l-laha","(to) Allah","আল্লাহকে( দেওয়া ওয়াদা)"],["لَكَانَ","lakāna","surely, it would have been","অবশই হতো"],["خَيْرًۭا","khayran","better","উত্তম"],["لَّهُمْ","lahum","for them","তাদের জন্যে"]],"t":"طَاعَ<d>ةٌۭ وَ</>قَوْ<d>لٌۭ مَّ</>عْرُو<k>فٌۭ ۚ فَ</>إِذَا عَزَمَ <h>ٱ</>لْأَمْرُ فَلَوْ صَدَقُو<s>ا۟</> <h>ٱ</>للَّهَ لَكَانَ خَيْ<w>رًۭا لَّ</>هُمْ"},{"n":22,"w":[["فَهَلْ","fahal","Then would","তবে কি"],["عَسَيْتُمْ","‘asaytum","you perhaps","তোমাদের হতে  এ সম্ভাবনা আছে?"],["إِن","in","if","যদি"],["تَوَلَّيْتُمْ","tawallaytum","you are given authority","তোমরা ক্ষমতায় অধিষ্ঠিত হও"],["أَن","an","that","যে"],["تُفْسِدُوا۟","tuf'sidū","you cause corruption","তোমরা বিপর্যয় সৃষ্টি করবে"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["وَتُقَطِّعُوٓا۟","watuqaṭṭi‘ū","and cut off","এবং তোমরা ছিন্ন করবে"],["أَرْحَامَكُمْ","arḥāmakum","your ties of kinship","তোমাদের আত্মীয়তার বন্ধনসমূহকে"]],"t":"فَهَلْ عَسَيْتُمْ إِ<k>ن تَ</>وَلَّيْتُمْ أَ<k>ن تُ</>فْسِدُو<s>ا۟</> فِى <h>ٱ</>لْأَرْضِ وَتُقَطِّ<o>عُوٓ</><s>ا۟</> أَرْحَامَكُمْ"},{"n":23,"w":[["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব লোক"],["ٱلَّذِينَ","alladhīna","(are) the ones","তারাই"],["لَعَنَهُمُ","la‘anahumu","Allah has cursed them","যাদেরকে অভিশাপ দিয়েছেন"],["ٱللَّهُ","l-lahu","Allah has cursed them","আল্লাহ্‌"],["فَأَصَمَّهُمْ","fa-aṣammahum","so He made them deaf","এরপর তাদেরকে বধির করে দিয়েছেন"],["وَأَعْمَىٰٓ","wa-a‘mā","and blinded","ও অন্ধ করে দিয়েছেন"],["أَبْصَـٰرَهُمْ","abṣārahum","their vision","তাদের দৃষ্টি শক্তিকে"]],"t":"أُ<s>و۟</><o>لَٰٓ</>ئِكَ <h>ٱ</>لَّذِينَ لَعَنَهُمُ <h>ٱ</>للَّهُ فَأَصَ<g>مَّ</>هُمْ وَأَعْمَ<o>ىٰٓ</> أَ<q>بْ</><m>صَٰ</>رَهُمْ"},{"n":24,"w":[["أَفَلَا","afalā","Then do not","না তবে কি"],["يَتَدَبَّرُونَ","yatadabbarūna","they ponder","তারা চিন্তা গবেষণা করে"],["ٱلْقُرْءَانَ","l-qur'āna","(over) the Quran","কুরআন (সম্বন্ধে)"],["أَمْ","am","or","অথবা"],["عَلَىٰ","‘alā","upon","উপর"],["قُلُوبٍ","qulūbin","(their) hearts","অন্তরসমূহের"],["أَقْفَالُهَآ","aqfāluhā","(are) locks","তাদের তালা (পড়েছে)"]],"t":"أَفَلَا يَتَدَبَّرُونَ <h>ٱ</>لْقُرْءَانَ أَمْ عَلَىٰ قُلُوبٍ أَ<q>قْ</>فَالُهَآ"},{"n":25,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ٱرْتَدُّوا۟","ir'taddū","return","ফিরে যায়"],["عَلَىٰٓ","‘alā","on","দিকে"],["أَدْبَـٰرِهِم","adbārihim","their backs","তাদের পিছনের"],["مِّنۢ","min","after","থেকে"],["بَعْدِ","ba‘di","after","এরপরেও"],["مَا","mā","what","যা"],["تَبَيَّنَ","tabayyana","(has) become clear","সুস্পষ্ট হয়েছে"],["لَهُمُ","lahumu","to them","তাদের কাছে"],["ٱلْهُدَى ۙ","l-hudā","(of) the guidance","(অর্থাৎ) সৎপথ"],["ٱلشَّيْطَـٰنُ","l-shayṭānu","Shaitaan","শয়তান"],["سَوَّلَ","sawwala","enticed","শোভন করে দেখায়"],["لَهُمْ","lahum","[for] them","তাদের জন্যে (একাজ)"],["وَأَمْلَىٰ","wa-amlā","and prolonged hope","মিথ্যা আশা দেয়"],["لَهُمْ","lahum","for them","তাদের জন্যে"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ <h>ٱ</>رْتَدُّو<s>ا۟</> عَلَ<o>ىٰٓ</> أَ<q>دْ</><m>بَٰ</>رِ<y>هِم مِّ</><i>نۢ بَ</>عْدِ مَا تَبَيَّنَ لَهُمُ <h>ٱ</>لْهُدَى ۙ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نُ سَوَّلَ لَهُمْ وَأَمْلَىٰ لَهُمْ"},{"n":26,"w":[["ذَٰلِكَ","dhālika","That","এটা"],["بِأَنَّهُمْ","bi-annahum","(is) because they","এ কারণে যে তারা"],["قَالُوا۟","qālū","[they] said","বলে"],["لِلَّذِينَ","lilladhīna","to those who","(তাদের)-কে যারা"],["كَرِهُوا۟","karihū","hate","অপছন্দ করেছে"],["مَا","mā","what","যা"],["نَزَّلَ","nazzala","Allah has revealed","অবতরণ করেছেন"],["ٱللَّهُ","l-lahu","Allah has revealed","আল্লাহ্‌"],["سَنُطِيعُكُمْ","sanuṭī‘ukum","We will obey you","\"অচিরেই আমরা তোমাদের আনুগত্য করব"],["فِى","fī","in","ক্ষেত্রে"],["بَعْضِ","ba‘ḍi","part","কিছু"],["ٱلْأَمْرِ ۖ","l-amri","(of) the matter","বিষয়ের\""],["وَٱللَّهُ","wal-lahu","But Allah","এবং আল্লাহ্‌"],["يَعْلَمُ","ya‘lamu","knows","জানেন"],["إِسْرَارَهُمْ","is'rārahum","their secrets","তাদের গোপন অভিসন্ধি (সম্পর্কে)"]],"t":"<m>ذَٰ</>لِكَ بِأَ<g>نَّ</>هُمْ قَالُو<s>ا۟</> لِلَّذِينَ كَرِهُو<s>ا۟</> مَا نَزَّلَ <h>ٱ</>للَّهُ سَنُطِيعُكُمْ فِى بَعْضِ <h>ٱ</>لْأَمْرِ ۖ وَ<h>ٱ</>للَّهُ يَعْلَمُ إِسْرَارَهُمْ"},{"n":27,"w":[["فَكَيْفَ","fakayfa","Then how","অতঃপর কেমন হবে"],["إِذَا","idhā","when","(তখন) যখন"],["تَوَفَّتْهُمُ","tawaffathumu","take them in death","তাদের প্রান হরণ করবে"],["ٱلْمَلَـٰٓئِكَةُ","l-malāikatu","the Angels","ফেরেশতারা"],["يَضْرِبُونَ","yaḍribūna","striking","তারা মারবে"],["وُجُوهَهُمْ","wujūhahum","their faces","তাদের মুখমন্ডলগুলোতে"],["وَأَدْبَـٰرَهُمْ","wa-adbārahum","and their backs","ও তাদের পিঠে"]],"t":"فَكَيْفَ إِذَا تَوَفَّتْهُمُ <h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةُ يَضْرِبُونَ وُجُوهَهُمْ وَأَ<q>دْ</><m>بَٰ</>رَهُمْ"},{"n":28,"w":[["ذَٰلِكَ","dhālika","That","এটা"],["بِأَنَّهُمُ","bi-annahumu","(is) because they","এ কারণে যে তারা"],["ٱتَّبَعُوا۟","ittaba‘ū","followed","অনুসরণ করেছিল (সেই পথের)"],["مَآ","mā","what","যা"],["أَسْخَطَ","askhaṭa","angered","অসন্তুষ্ট করেছে"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["وَكَرِهُوا۟","wakarihū","and hated","ও তারা অপছন্দ করেছে"],["رِضْوَٰنَهُۥ","riḍ'wānahu","His pleasure","তাঁর সন্তুষ্টির (পথ)"],["فَأَحْبَطَ","fa-aḥbaṭa","so He made worthless","ফলে তিনি নষ্ট করে দিয়েছেন"],["أَعْمَـٰلَهُمْ","a‘mālahum","their deeds","তাদের কর্মসমূহকে"]],"t":"<m>ذَٰ</>لِكَ بِأَ<g>نَّ</>هُمُ <h>ٱ</>تَّبَعُو<s>ا۟</> <o>مَآ</> أَسْخَطَ <h>ٱ</>للَّهَ وَكَرِهُو<s>ا۟</> رِضْ<m>وَٰ</>نَهُ<m>ۥ</> فَأَحْبَطَ أَعْ<m>مَٰ</>لَهُمْ"},{"n":29,"w":[["أَمْ","am","Or do","কি"],["حَسِبَ","ḥasiba","think","মনে করেছে"],["ٱلَّذِينَ","alladhīna","those who","তারা"],["فِى","fī","in","আছে"],["قُلُوبِهِم","qulūbihim","their hearts","যাদের অন্তরসমূহে"],["مَّرَضٌ","maraḍun","(is) a disease","রোগ (আছে)"],["أَن","an","that","যে"],["لَّن","lan","never","কখনও না"],["يُخْرِجَ","yukh'rija","will Allah bring forth","প্রকাশ করবেন"],["ٱللَّهُ","l-lahu","will Allah bring forth","আল্লাহ্‌"],["أَضْغَـٰنَهُمْ","aḍghānahum","their hatred","তাদের বিদ্বেষগুলোকে"]],"t":"أَمْ حَسِبَ <h>ٱ</>لَّذِينَ فِى قُلُوبِ<y>هِم مَّ</>رَضٌ <w>أَن لَّ</><d>ن يُ</>خْرِجَ <h>ٱ</>للَّهُ أَضْ<m>غَٰ</>نَهُمْ"},{"n":30,"w":[["وَلَوْ","walaw","And if","এবং যদি"],["نَشَآءُ","nashāu","We willed","আমরা ইচ্ছে করি"],["لَأَرَيْنَـٰكَهُمْ","la-araynākahum","surely, We could show them to you","আমরা অবশ্যই তাদের দেখাতে পারি"],["فَلَعَرَفْتَهُم","fala‘araftahum","and you would know them","তুমি তখন তাদের চিনবেই"],["بِسِيمَـٰهُمْ ۚ","bisīmāhum","by their marks","দ্বারা তাদের লক্ষণগুলো"],["وَلَتَعْرِفَنَّهُمْ","walata‘rifannahum","but surely, you will know them","এবং তাদেরকে তুমি অবশ্যই চিনবে"],["فِى","fī","by","আছে"],["لَحْنِ","laḥni","(the) tone","ভংগিতে"],["ٱلْقَوْلِ ۚ","l-qawli","(of their) speech","কথা (বলার)"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ্‌ই"],["يَعْلَمُ","ya‘lamu","knows","জানেন"],["أَعْمَـٰلَكُمْ","a‘mālakum","your deeds","তোমাদের কর্মসমূহকে"]],"t":"وَلَوْ نَ<o>شَآ</>ءُ لَأَرَيْ<m>نَٰ</>كَهُمْ فَلَعَرَفْتَ<f>هُم بِ</>سِي<m>مَٰ</>هُمْ ۚ وَلَتَعْرِفَ<g>نَّ</>هُمْ فِى لَحْنِ <h>ٱ</>لْقَوْلِ ۚ وَ<h>ٱ</>للَّهُ يَعْلَمُ أَعْ<m>مَٰ</>لَكُمْ"},{"n":31,"w":[["وَلَنَبْلُوَنَّكُمْ","walanabluwannakum","And surely We will test you","এবং তোমাদের পরীক্ষা করব  আমরা অবশ্যই"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["نَعْلَمَ","na‘lama","We make evident","আমরা জানবো"],["ٱلْمُجَـٰهِدِينَ","l-mujāhidīna","those who strive","মুজাহিদদেরকে"],["مِنكُمْ","minkum","among you","তোমাদের মধ্যকার"],["وَٱلصَّـٰبِرِينَ","wal-ṣābirīna","and the patient ones","ও ধৈর্যশীলদেরকে"],["وَنَبْلُوَا۟","wanabluwā","and We will test","এবং আমরা পরীক্ষা করবো"],["أَخْبَارَكُمْ","akhbārakum","your affairs","তোমাদের খবরাদি"]],"t":"وَلَنَ<q>بْ</>لُوَ<g>نَّ</>كُمْ حَتَّىٰ نَعْلَمَ <h>ٱ</>لْمُ<m>جَٰ</>هِدِينَ مِ<k>نكُ</>مْ وَ<h>ٱ</><l>ل</><m>صَّٰ</>بِرِينَ وَنَ<q>بْ</>لُ<o>وَ</><s>ا۟</> أَخْبَارَكُمْ"},{"n":32,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieve","অস্বীকার করেছে"],["وَصَدُّوا۟","waṣaddū","and turn away","ও বাধা দিয়েছে (লোকদেরকে)"],["عَن","‘an","from","হতে"],["سَبِيلِ","sabīli","(the) way of Allah","পথ"],["ٱللَّهِ","l-lahi","(the) way of Allah","আল্লাহ্‌র"],["وَشَآقُّوا۟","washāqqū","and oppose","এবং বিরোধিতা করেছে"],["ٱلرَّسُولَ","l-rasūla","the Messenger","রাসুলের"],["مِنۢ","min","after","মধ্য হতে"],["بَعْدِ","ba‘di","after","এরপরেও"],["مَا","mā","[what]","যা"],["تَبَيَّنَ","tabayyana","(has been) made clear","সুস্পষ্ট হয়েছে"],["لَهُمُ","lahumu","to them","তাদের কাছে"],["ٱلْهُدَىٰ","l-hudā","the guidance","(অর্থাৎ) সৎপথ"],["لَن","lan","never","কখনও না"],["يَضُرُّوا۟","yaḍurrū","will they harm","তারা ক্ষতি করতে পারবে"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["شَيْـًۭٔا","shayan","(in) anything","কিছুমাত্রও"],["وَسَيُحْبِطُ","wasayuḥ'biṭu","and He will make worthless","এবং অচিরেই তিনি বিনষ্ট করে দিবেন"],["أَعْمَـٰلَهُمْ","a‘mālahum","their deeds","তাদের কর্মসমূহকে"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> وَصَدُّو<s>ا۟</> عَ<k>ن سَ</>بِيلِ <h>ٱ</>للَّهِ وَ<n>شَآ</>قُّو<s>ا۟</> <h>ٱ</><l>ل</>رَّسُولَ <i>مِنۢ بَ</>عْدِ مَا تَبَيَّنَ لَهُمُ <h>ٱ</>لْهُدَىٰ <d>لَن يَ</>ضُرُّو<s>ا۟</> <h>ٱ</>للَّهَ شَ<d>يْـًۭٔا وَ</>سَيُحْبِطُ أَعْ<m>مَٰ</>لَهُمْ"},{"n":33,"w":[["۞ يَـٰٓأَيُّهَا","yāayyuhā","O you who believe","হে"],["ٱلَّذِينَ","alladhīna","O you who believe","যারা"],["ءَامَنُوٓا۟","āmanū","O you who believe","ঈমান এনেছ"],["أَطِيعُوا۟","aṭī‘ū","Obey","তোমরা আনুগত্য করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌র"],["وَأَطِيعُوا۟","wa-aṭī‘ū","and obey","ও আনুগত্য করো"],["ٱلرَّسُولَ","l-rasūla","the Messenger","রাসুলের"],["وَلَا","walā","and (do) not","এবং না"],["تُبْطِلُوٓا۟","tub'ṭilū","make vain","তোমরা বিনষ্ট করো"],["أَعْمَـٰلَكُمْ","a‘mālakum","your deeds","তোমাদের কর্মসমূহকে"]],"t":"۞ <o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَ<o>نُوٓ</><s>ا۟</> أَطِيعُو<s>ا۟</> <h>ٱ</>للَّهَ وَأَطِيعُو<s>ا۟</> <h>ٱ</><l>ل</>رَّسُولَ وَلَا تُ<q>بْ</>طِ<o>لُوٓ</><s>ا۟</> أَعْ<m>مَٰ</>لَكُمْ"},{"n":34,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieve","অস্বীকার করেছে"],["وَصَدُّوا۟","waṣaddū","and turn away","ও বাধা দিয়েছে (লোকদেরকে)"],["عَن","‘an","from","হতে"],["سَبِيلِ","sabīli","(the) way","পথ"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহ্‌র"],["ثُمَّ","thumma","then","তারপর"],["مَاتُوا۟","mātū","died","তারা মারা গেছে"],["وَهُمْ","wahum","while they","এমতাবস্থায় যে"],["كُفَّارٌۭ","kuffārun","(were) disbelievers","কাফের (ছিল)"],["فَلَن","falan","never","ফলে কখনও না"],["يَغْفِرَ","yaghfira","will Allah forgive","ক্ষমা করবেন"],["ٱللَّهُ","l-lahu","will Allah forgive","আল্লাহ্‌"],["لَهُمْ","lahum","them","তাদেরকে"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> وَصَدُّو<s>ا۟</> عَ<k>ن سَ</>بِيلِ <h>ٱ</>للَّهِ ثُ<g>مَّ</> مَاتُو<s>ا۟</> وَهُمْ كُفَّا<k>رٌۭ فَ</><d>لَن يَ</>غْفِرَ <h>ٱ</>للَّهُ لَهُمْ"},{"n":35,"w":[["فَلَا","falā","So (do) not","অতএব না"],["تَهِنُوا۟","tahinū","weaken","তোমরা সাহস হারিয়ো না"],["وَتَدْعُوٓا۟","watad‘ū","and call","এবং তোমরা আহবান করো (না)"],["إِلَى","ilā","for","দিকে"],["ٱلسَّلْمِ","l-salmi","peace","সন্ধির"],["وَأَنتُمُ","wa-antumu","while you","এবং তোমরাই (হবে)"],["ٱلْأَعْلَوْنَ","l-a‘lawna","(are) superior","বিজয়ী"],["وَٱللَّهُ","wal-lahu","and Allah","এবং আল্লাহ্‌"],["مَعَكُمْ","ma‘akum","(is) with you","তোমাদের সাথে (আছেন)"],["وَلَن","walan","and never","এবং কখনও না"],["يَتِرَكُمْ","yatirakum","will deprive you","তোমাদের কমাবেন"],["أَعْمَـٰلَكُمْ","a‘mālakum","(of) your deeds","তোমাদের কর্মসমূহকে"]],"t":"فَلَا تَهِنُو<s>ا۟</> وَتَ<q>دْ</><o>عُوٓ</><s>ا۟</> إِلَى <h>ٱ</><l>ل</>سَّلْمِ وَأَ<k>نتُ</>مُ <h>ٱ</>لْأَعْلَوْنَ وَ<h>ٱ</>للَّهُ مَعَكُمْ وَ<d>لَن يَ</>تِرَكُمْ أَعْ<m>مَٰ</>لَكُمْ"},{"n":36,"w":[["إِنَّمَا","innamā","Only","প্রকৃতপক্ষে"],["ٱلْحَيَوٰةُ","l-ḥayatu","the life","জীবন"],["ٱلدُّنْيَا","l-dun'yā","(of) the world","পার্থিব"],["لَعِبٌۭ","la‘ibun","(is) play","খেলা"],["وَلَهْوٌۭ ۚ","walahwun","and amusement","ও তামাশা (মাত্র)"],["وَإِن","wa-in","And if","এবং যদি"],["تُؤْمِنُوا۟","tu'minū","you believe","তোমরা ঈমান আন"],["وَتَتَّقُوا۟","watattaqū","and fear (Allah)","ও তোমরা ভয় করে চল"],["يُؤْتِكُمْ","yu'tikum","He will give you","তিনি তোমাদের দান করবেন"],["أُجُورَكُمْ","ujūrakum","your rewards","তোমাদের কর্মফলসমূহকে"],["وَلَا","walā","and not","এবং না"],["يَسْـَٔلْكُمْ","yasalkum","will ask you","তোমাদের থেকে তিনি চান"],["أَمْوَٰلَكُمْ","amwālakum","(for) your wealth","তোমাদের সম্পদগুলোকে"]],"t":"إِ<g>نَّ</>مَا <h>ٱ</>لْحَيَ<s>وٰ</>ةُ <h>ٱ</><l>ل</>دُّنْيَا لَعِ<d>بٌۭ وَ</>لَهْ<d>وٌۭ ۚ وَ</>إِ<k>ن تُ</>ؤْمِنُو<s>ا۟</> وَتَتَّقُو<s>ا۟</> يُؤْتِكُمْ أُجُورَكُمْ وَلَا يَسْـَٔلْكُمْ أَمْ<m>وَٰ</>لَكُمْ"},{"n":37,"w":[["إِن","in","If","যদি"],["يَسْـَٔلْكُمُوهَا","yasalkumūhā","He were to ask you for it","তা তোমাদের থেকে চান তিনি"],["فَيُحْفِكُمْ","fayuḥ'fikum","and press you","অতঃপর তোমাদেরকে  চাপ দেন"],["تَبْخَلُوا۟","tabkhalū","you will withhold","তোমরা কৃপণতা করবে"],["وَيُخْرِجْ","wayukh'rij","and He will bring forth","এবং তিনি প্রকাশ করবেন"],["أَضْغَـٰنَكُمْ","aḍghānakum","your hatred","তোমাদের গোপন ত্রুটিকে"]],"t":"<d>إِن يَ</>سْـَٔلْكُمُوهَا فَيُحْفِكُمْ تَ<q>بْ</>خَلُو<s>ا۟</> وَيُخْرِ<q>جْ</> أَضْ<m>غَٰ</>نَكُمْ"},{"n":38,"w":[["هَـٰٓأَنتُمْ","hāantum","Here you are ","তোমরা দেখ"],["هَـٰٓؤُلَآءِ","hāulāi","these","ঐসব লোক (যাদের)"],["تُدْعَوْنَ","tud'‘awna","called","আহবান করা হচ্ছে"],["لِتُنفِقُوا۟","litunfiqū","to spend","তোমরা খরচ কর যেন"],["فِى","fī","in","মধ্যে"],["سَبِيلِ","sabīli","(the) way","পথের"],["ٱللَّهِ","l-lahi","(of) Allah ","আল্লাহ্‌র"],["فَمِنكُم","faminkum","but among you","তখন তোমাদের মধ্য হতে"],["مَّن","man","(are some) who","কেউ কেউ"],["يَبْخَلُ ۖ","yabkhalu","withhold","কৃপণতা করে"],["وَمَن","waman","and whoever","অথচ যে"],["يَبْخَلْ","yabkhal","withholds","কৃপণতা করে"],["فَإِنَّمَا","fa-innamā","then only","প্রকৃতপক্ষে"],["يَبْخَلُ","yabkhalu","he withholds","সে কৃপণতা করে"],["عَن","‘an","from","প্রতি"],["نَّفْسِهِۦ ۚ","nafsihi","himself","তার নিজের"],["وَٱللَّهُ","wal-lahu","But Allah","এবং আলাহ"],["ٱلْغَنِىُّ","l-ghaniyu","(is) Free of need","অভাবমুক্ত"],["وَأَنتُمُ","wa-antumu","while you","কিন্তু তোমরা"],["ٱلْفُقَرَآءُ ۚ","l-fuqarāu","(are) the needy","অভাবগ্রস্ত"],["وَإِن","wa-in","And if","আর যদি"],["تَتَوَلَّوْا۟","tatawallaw","you turn away","তোমরা মুখ ফিরাও (তবে)"],["يَسْتَبْدِلْ","yastabdil","He will replace you","তিনি পরিবর্তন করে আনবেন"],["قَوْمًا","qawman","(with) a people","(অন্য এক) জাতিকে"],["غَيْرَكُمْ","ghayrakum","other than you","তোমাদের ব্যতীত"],["ثُمَّ","thumma","then","এরপর"],["لَا","lā","not","না"],["يَكُونُوٓا۟","yakūnū","they will be","তারা হবে"],["أَمْثَـٰلَكُم","amthālakum","(the) likes of you","তোমাদের মতো"]],"t":"<o>هَٰٓ</>أَ<k>نتُ</>مْ <o>هَٰٓؤُلَآ</>ءِ تُ<q>دْ</>عَوْنَ لِتُ<k>نفِ</>قُو<s>ا۟</> فِى سَبِيلِ <h>ٱ</>للَّهِ فَمِ<k>نكُ</><y>م مَّ</><d>ن يَ</><q>بْ</>خَلُ ۖ وَ<d>مَن يَ</><q>بْ</>خَلْ فَإِ<g>نَّ</>مَا يَ<q>بْ</>خَلُ <d>عَن نَّ</>فْسِ<m>هِۦ</> ۚ وَ<h>ٱ</>للَّهُ <h>ٱ</>لْغَنِىُّ وَأَ<k>نتُ</>مُ <h>ٱ</>لْفُقَ<o>رَآ</>ءُ ۚ وَإِ<k>ن تَ</>تَوَلَّوْ<s>ا۟</> يَسْتَ<q>بْ</>دِلْ قَوْمًا غَيْرَكُمْ ثُ<g>مَّ</> لَا يَكُو<o>نُوٓ</><s>ا۟</> أَمْ<m>ثَٰ</>لَكُم"}]}