{"n":47,"a":[{"n":1,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["كَفَرُوا۟","kafarū","disbelieve","অস্বীকার করেছে"],["وَصَدُّوا۟","waṣaddū","and turn away","ও বাধা দিয়েছে (লোকদেরকে)"],["عَن","‘an","from","হতে"],["سَبِيلِ","sabīli","(the) way of Allah","পথ"],["ٱللَّهِ","l-lahi","(the) way of Allah","আল্লাহর"],["أَضَلَّ","aḍalla","He will cause to be lost","ব্যর্থ করে দিয়েছেন তিনি"],["أَعْمَـٰلَهُمْ","a‘mālahum","their deeds","তাদের কর্ম সমূহকে"]],"t":"ٱلَّذِينَ كَفَرُو<s>ا۟</> وَصَدُّو<s>ا۟</> عَ<k>ن سَ</>بِيلِ <h>ٱ</>للَّهِ أَضَلَّ أَعْ<m>مَٰ</>لَهُمْ"},{"n":2,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","আর যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["وَعَمِلُوا۟","wa‘amilū","and do","ও কাজ করেছে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","righteous deeds","সৎকর্মের"],["وَءَامَنُوا۟","waāmanū","and believe","এবং ঈমান এনেছে"],["بِمَا","bimā","in what","(তার উপর) যা"],["نُزِّلَ","nuzzila","is revealed","অবতীর্ণ করা হয়েছে"],["عَلَىٰ","‘alā","to","উপর"],["مُحَمَّدٍۢ","muḥammadin","Muhammad","মুহাম্মাদের"],["وَهُوَ","wahuwa","and it","এবং তা"],["ٱلْحَقُّ","l-ḥaqu","(is) the truth","সত্য"],["مِن","min","from","পক্ষ হতে"],["رَّبِّهِمْ ۙ","rabbihim","their Lord","তাদের রবের"],["كَفَّرَ","kaffara","He will remove","(আল্লাহ্‌) মিটিয়ে দিয়েছেন"],["عَنْهُمْ","‘anhum","from them","তাদের হতে"],["سَيِّـَٔاتِهِمْ","sayyiātihim","their misdeeds","তাদের ত্রুটি সমুহ"],["وَأَصْلَحَ","wa-aṣlaḥa","and improve","ও শুধরে দিবেন"],["بَالَهُمْ","bālahum","their condition","তাদের অবস্থা"]],"t":"وَ<h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ وَءَامَنُو<s>ا۟</> بِمَا نُزِّلَ عَلَىٰ مُحَ<g>مَّ</><d>دٍۢ وَ</>هُوَ <h>ٱ</>لْحَقُّ <w>مِن رَّ</>بِّهِمْ ۙ كَفَّرَ عَنْهُمْ سَيِّـَٔاتِهِمْ وَأَصْلَحَ بَالَهُمْ"},{"n":3,"w":[["ذَٰلِكَ","dhālika","That","এটা"],["بِأَنَّ","bi-anna","(is) because","এ কারণে যে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieve","অস্বীকার করেছে"],["ٱتَّبَعُوا۟","ittaba‘ū","follow","তারা অনুসরণ করেছে"],["ٱلْبَـٰطِلَ","l-bāṭila","falsehood","মিথ্যাকে"],["وَأَنَّ","wa-anna","and that","আর নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["ٱتَّبَعُوا۟","ittaba‘ū","follow","তারা অনুসরণ করেছে"],["ٱلْحَقَّ","l-ḥaqa","(the) truth","সত্যকে"],["مِن","min","from","(আগত) পক্ষ হতে"],["رَّبِّهِمْ ۚ","rabbihim","their Lord","তাদের রবের"],["كَذَٰلِكَ","kadhālika","Thus","এভাবে"],["يَضْرِبُ","yaḍribu","Allah presents","বর্ণনা করেন"],["ٱللَّهُ","l-lahu","Allah presents","আল্লাহ্‌"],["لِلنَّاسِ","lilnnāsi","to the people","লোকদের জন্যে"],["أَمْثَـٰلَهُمْ","amthālahum","their similitudes","তাদের দৃষ্টান্ত সমুহ"]],"t":"<m>ذَٰ</>لِكَ بِأَ<g>نَّ</> <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> <h>ٱ</>تَّبَعُو<s>ا۟</> <h>ٱ</>لْ<m>بَٰ</>طِلَ وَأَ<g>نَّ</> <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> <h>ٱ</>تَّبَعُو<s>ا۟</> <h>ٱ</>لْحَقَّ <w>مِن رَّ</>بِّهِمْ ۚ كَ<m>ذَٰ</>لِكَ يَضْرِبُ <h>ٱ</>للَّهُ لِل<g>نَّ</>اسِ أَمْ<m>ثَٰ</>لَهُمْ"},{"n":4,"w":[["فَإِذَا","fa-idhā","So when","অতঃপর যখন"],["لَقِيتُمُ","laqītumu","you meet","তোমরা যুদ্ধে অবতীর্ণ হবে"],["ٱلَّذِينَ","alladhīna","those who","তাদের সাথে (যারা)"],["كَفَرُوا۟","kafarū","disbelieve","অস্বীকার করেছে"],["فَضَرْبَ","faḍarba","then strike","তখন আঘাত করা(প্রথম কাজ)"],["ٱلرِّقَابِ","l-riqābi","the necks","(তাদের) ঘাড়ে-গর্দানে"],["حَتَّىٰٓ","ḥattā","until","এমনকি"],["إِذَآ","idhā","when","যখন"],["أَثْخَنتُمُوهُمْ","athkhantumūhum","you have subdued them","তাদেরকে সম্পূর্ণভাবে পরাজিত করবে"],["فَشُدُّوا۟","fashuddū","then bind firmly","তোমরা তখন শক্ত করে বাঁধবে"],["ٱلْوَثَاقَ","l-wathāqa","the bond","(বন্দীদের) বাঁধন"],["فَإِمَّا","fa-immā","then either","অতঃপর হয়তো"],["مَنًّۢا","mannan","a favor","অনুকম্পা করবে"],["بَعْدُ","ba‘du","afterwards","পরে"],["وَإِمَّا","wa-immā","or","নাহয়"],["فِدَآءً","fidāan","ransom","মুক্তিপণ নেবে"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["تَضَعَ","taḍa‘a","lays down","সংবরণ করবে"],["ٱلْحَرْبُ","l-ḥarbu","the war","যুদ্ধ"],["أَوْزَارَهَا ۚ","awzārahā","its burdens","তার অস্ত্রসমূহকে"],["ذَٰلِكَ","dhālika","That","এটা (বিধান)"],["وَلَوْ","walaw","And if","এবং যদি"],["يَشَآءُ","yashāu","Allah had willed","ইচ্ছে করতেন"],["ٱللَّهُ","l-lahu","Allah had willed","আল্লাহ্‌ (তবে)"],["لَٱنتَصَرَ","la-intaṣara","surely, He could have taken retribution","অবশ্যই প্রতিশোধ গ্রহণ করতেন"],["مِنْهُمْ","min'hum","from them","তাদের হতে"],["وَلَـٰكِن","walākin","but","কিন্তু"],["لِّيَبْلُوَا۟","liyabluwā","to test","(এ পন্থা নিয়েছেন) যাতে তিনি পরীক্ষা করতে পারেন"],["بَعْضَكُم","ba‘ḍakum","some of you","তোমাদের এককে"],["بِبَعْضٍۢ ۗ","biba‘ḍin","with others","অপরকে দিয়ে"],["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["قُتِلُوا۟","qutilū","are killed","নিহত হয়"],["فِى","fī","in","মধ্যে"],["سَبِيلِ","sabīli","(the) way of Allah","পথের"],["ٱللَّهِ","l-lahi","(the) way of Allah","আল্লাহ্‌র"],["فَلَن","falan","then never","সেক্ষেত্রে কখনও না"],["يُضِلَّ","yuḍilla","He will cause to be lost","তিনি নিষ্ফল করবেন"],["أَعْمَـٰلَهُمْ","a‘mālahum","their deeds","তাদের কর্ম সমুহকে"]],"t":"فَإِذَا لَقِيتُمُ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> فَضَرْبَ <h>ٱ</><l>ل</>رِّقَابِ حَتَّ<o>ىٰٓ</> إِ<o>ذَآ</> أَثْخَ<k>نتُ</>مُوهُمْ فَشُدُّو<s>ا۟</> <h>ٱ</>لْوَثَاقَ فَإِ<g>مَّ</>ا مَ<g>نًّۢ</><i>ا بَ</>عْدُ وَإِ<g>مَّ</>ا فِ<o>دَآ</>ءً حَتَّىٰ تَضَعَ <h>ٱ</>لْحَرْبُ أَوْزَارَهَا ۚ <m>ذَٰ</>لِكَ وَلَوْ يَ<o>شَآ</>ءُ <h>ٱ</>للَّهُ لَ<h>ٱ</><k>نتَ</>صَرَ مِنْهُمْ وَ<m>لَٰ</><w>كِن لِّ</>يَ<q>بْ</>لُوَ<s>ا۟</> بَعْضَ<f>كُم بِ</>بَعْ<d>ضٍۢ ۗ وَ</><h>ٱ</>لَّذِينَ قُتِلُو<s>ا۟</> فِى سَبِيلِ <h>ٱ</>للَّهِ فَ<d>لَن يُ</>ضِلَّ أَعْ<m>مَٰ</>لَهُمْ"},{"n":5,"w":[["سَيَهْدِيهِمْ","sayahdīhim","He will guide them","তিনি অচিরেই তাদেরকে পরিচালিত করবেন সৎ পথে"],["وَيُصْلِحُ","wayuṣ'liḥu","and improve","ও ভালো করবেন"],["بَالَهُمْ","bālahum","their condition","তাদের অবস্থা"]],"t":"سَيَهْدِيهِمْ وَيُصْلِحُ بَالَهُمْ"},{"n":6,"w":[["وَيُدْخِلُهُمُ","wayud'khiluhumu","And admit them","এবং তাদের প্রবেশ করাবেন"],["ٱلْجَنَّةَ","l-janata","(to) Paradise","জান্নাতে"],["عَرَّفَهَا","‘arrafahā","He has made it known","তার পরিচয় তিনি জানিয়েছেন"],["لَهُمْ","lahum","to them","তাদেরকে"]],"t":"وَيُ<q>دْ</>خِلُهُمُ <h>ٱ</>لْجَ<g>نَّ</>ةَ عَرَّفَهَا لَهُمْ"},{"n":7,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you who believe","হে"],["ٱلَّذِينَ","alladhīna","O you who believe","যারা"],["ءَامَنُوٓا۟","āmanū","O you who believe","ঈমান এনেছ"],["إِن","in","If","যদি"],["تَنصُرُوا۟","tanṣurū","you help","তোমরা সাহায্য কর"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["يَنصُرْكُمْ","yanṣur'kum","He will help you","তিনি তোমাদেরকে সাহায্য করবেন"],["وَيُثَبِّتْ","wayuthabbit","and make firm","ও সুদৃঢ় করবেন"],["أَقْدَامَكُمْ","aqdāmakum","your feet","তোমাদের পা গুলোকে"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَ<o>نُوٓ</><s>ا۟</> إِ<k>ن تَنصُ</>رُو<s>ا۟</> <h>ٱ</>للَّهَ يَ<k>نصُ</>رْكُمْ وَيُثَبِّتْ أَ<q>قْ</>دَامَكُمْ"},{"n":8,"w":[["وَٱلَّذِينَ","wa-alladhīna","But those who","এবং যারা"],["كَفَرُوا۟","kafarū","disbelieve","অস্বীকার করেছে"],["فَتَعْسًۭا","fata‘san","destruction (is)","দুর্গতি সেক্ষেত্রে"],["لَّهُمْ","lahum","for them","তাদের জন্যে"],["وَأَضَلَّ","wa-aḍalla","and He will cause to be lost","এবং তিনি পণ্ড করে দিয়েছেন"],["أَعْمَـٰلَهُمْ","a‘mālahum","their deeds","তাদের কর্মসমূহকে"]],"t":"وَ<h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> فَتَعْ<w>سًۭا لَّ</>هُمْ وَأَضَلَّ أَعْ<m>مَٰ</>لَهُمْ"},{"n":9,"w":[["ذَٰلِكَ","dhālika","That","এটা"],["بِأَنَّهُمْ","bi-annahum","(is) because they","এ কারণে যে তারা"],["كَرِهُوا۟","karihū","hate","অপছন্দ করেছে"],["مَآ","mā","what","যা"],["أَنزَلَ","anzala","Allah has revealed","নাযিল করেছেন"],["ٱللَّهُ","l-lahu","Allah has revealed","আল্লাহ্‌"],["فَأَحْبَطَ","fa-aḥbaṭa","so He has made worthless","অতএব তিনি নষ্ট করে দিয়েছেন"],["أَعْمَـٰلَهُمْ","a‘mālahum","their deeds","তাদের কর্মসমূহকে"]],"t":"<m>ذَٰ</>لِكَ بِأَ<g>نَّ</>هُمْ كَرِهُو<s>ا۟</> <o>مَآ</> أَ<k>نزَ</>لَ <h>ٱ</>للَّهُ فَأَحْبَطَ أَعْ<m>مَٰ</>لَهُمْ"},{"n":10,"w":[["۞ أَفَلَمْ","afalam","Do not","নি তবে কি"],["يَسِيرُوا۟","yasīrū","they travel","তারা ভ্রমণ করে"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["فَيَنظُرُوا۟","fayanẓurū","and see","তারা দেখে তখন (নাই)"],["كَيْفَ","kayfa","how","কেমন"],["كَانَ","kāna","was","ছিল"],["عَـٰقِبَةُ","‘āqibatu","(the) end","পরিণাম"],["ٱلَّذِينَ","alladhīna","(of) those","(তাদের) যারা"],["مِن","min","before them","মধ্য হতে"],["قَبْلِهِمْ ۚ","qablihim","before them","তাদের পূর্বে (ছিল)"],["دَمَّرَ","dammara","Allah destroyed","ধ্বংস করে দিয়েছেন"],["ٱللَّهُ","l-lahu","Allah destroyed","আল্লাহ্‌"],["عَلَيْهِمْ ۖ","‘alayhim","[over] them","তাদেরকে"],["وَلِلْكَـٰفِرِينَ","walil'kāfirīna","and for the disbelievers","এবং কাফেরদের জন্য (নির্দিষ্ট হয়ে আছে)"],["أَمْثَـٰلُهَا","amthāluhā","its likeness","তার অনুরূপ পরিণতি"]],"t":"۞ أَفَلَمْ يَسِيرُو<s>ا۟</> فِى <h>ٱ</>لْأَرْضِ فَيَ<k>نظُ</>رُو<s>ا۟</> كَيْفَ كَانَ <m>عَٰ</>قِبَةُ <h>ٱ</>لَّذِينَ مِ<k>ن قَ</><q>بْ</>لِهِمْ ۚ دَ<g>مَّ</>رَ <h>ٱ</>للَّهُ عَلَيْهِمْ ۖ وَلِلْ<m>كَٰ</>فِرِينَ أَمْ<m>ثَٰ</>لُهَا"},{"n":11,"w":[["ذَٰلِكَ","dhālika","That","এটা"],["بِأَنَّ","bi-anna","(is) because","এ জন্যে যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["مَوْلَى","mawlā","(is the) Protector","অভিভাবক"],["ٱلَّذِينَ","alladhīna","(of) those who","(তাদের) যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["وَأَنَّ","wa-anna","and that","এবং (এও) যে"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","the disbelievers ","কাফেরদের"],["لَا","lā","(there is) no","নেই"],["مَوْلَىٰ","mawlā","protector","কোনো অভিভাবক"],["لَهُمْ","lahum","for them","তাদের জন্যে"]],"t":"<m>ذَٰ</>لِكَ بِأَ<g>نَّ</> <h>ٱ</>للَّهَ مَوْلَى <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَأَ<g>نَّ</> <h>ٱ</>لْ<m>كَٰ</>فِرِينَ لَا مَوْلَىٰ لَهُمْ"},{"n":12,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["يُدْخِلُ","yud'khilu","will admit","প্রবেশ করাবেন"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["وَعَمِلُوا۟","wa‘amilū","and do","ও কাজ করেছে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","righteous deeds","সৎকর্ম"],["جَنَّـٰتٍۢ","jannātin","(to) Gardens","জান্নাতে"],["تَجْرِى","tajrī","flow","প্র্রবাহিত হয়"],["مِن","min","from","থেকে"],["تَحْتِهَا","taḥtihā","underneath it","তার নিচ"],["ٱلْأَنْهَـٰرُ ۖ","l-anhāru","the rivers","ঝর্না ধারাসমুহ"],["وَٱلَّذِينَ","wa-alladhīna","but those who","এবং যারা"],["كَفَرُوا۟","kafarū","disbelieve","অস্বীকার করেছে"],["يَتَمَتَّعُونَ","yatamatta‘ūna","they enjoy","তারা ভোগবিলাস করছে"],["وَيَأْكُلُونَ","wayakulūna","and eat","ও তারা খাচ্ছে"],["كَمَا","kamā","as","যেমন"],["تَأْكُلُ","takulu","eat","খায়"],["ٱلْأَنْعَـٰمُ","l-an‘āmu","the cattle","চতুষ্পদ জন্তু"],["وَٱلنَّارُ","wal-nāru","and the Fire","এবং জাহান্নামই"],["مَثْوًۭى","mathwan","(will be) an abode","নিবাস"],["لَّهُمْ","lahum","for them","তাদের জন্যে"]],"t":"إِ<g>نَّ</> <h>ٱ</>للَّهَ يُ<q>دْ</>خِلُ <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ جَ<g>نَّٰ</><k>تٍۢ تَ</><q>جْ</>رِى مِ<k>ن تَ</>حْتِهَا <h>ٱ</>لْأَنْ<m>هَٰ</>رُ ۖ وَ<h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> يَتَمَتَّعُونَ وَيَأْكُلُونَ كَمَا تَأْكُلُ <h>ٱ</>لْأَنْ<m>عَٰ</>مُ وَ<h>ٱ</><l>ل</><g>نَّ</>ارُ مَثْ<w>وًۭى لَّ</>هُمْ"},{"n":13,"w":[["وَكَأَيِّن","waka-ayyin","And how many","এবং কতই না"],["مِّن","min","of","থেকে"],["قَرْيَةٍ","qaryatin","a town","জনপদ (বিলীন হয়েছে)"],["هِىَ","hiya","which","যা (ছিল)"],["أَشَدُّ","ashaddu","(was) stronger","অধিকতর দৃঢ়"],["قُوَّةًۭ","quwwatan","(in) strength","শক্তিতে"],["مِّن","min","than","চেয়েও"],["قَرْيَتِكَ","qaryatika","your town","তোমার জনপদের"],["ٱلَّتِىٓ","allatī","which","যা (হতে)"],["أَخْرَجَتْكَ","akhrajatka","has driven you out","তোমাকে বের করেছে"],["أَهْلَكْنَـٰهُمْ","ahlaknāhum","We destroyed them","আমরা তাদেরকে ধ্বংস করে দিয়েছি"],["فَلَا","falā","so no","অতঃপর না  (ছিল)"],["نَاصِرَ","nāṣira","helper","কোনো সাহায্যকারী"],["لَهُمْ","lahum","for them","তাদের জন্যে"]],"t":"وَكَأَ<d>يِّن مِّ</><k>ن قَ</>رْيَةٍ هِىَ أَشَدُّ قُوَّ<d>ةًۭ مِّ</><k>ن قَ</>رْيَتِكَ <h>ٱ</>لَّ<o>تِىٓ</> أَخْرَجَتْكَ أَهْلَكْ<m>نَٰ</>هُمْ فَلَا نَاصِرَ لَهُمْ"},{"n":1