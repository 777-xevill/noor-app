{"n":92,"a":[{"n":1,"w":[["وَٱلَّيْلِ","wa-al-layli","By the night","শপথ রাতের"],["إِذَا","idhā","when","যখন"],["يَغْشَىٰ","yaghshā","it covers","আচ্ছন্ন করে"]],"t":"وَ<h>ٱ</>لَّيْلِ إِذَا يَغْشَىٰ"},{"n":2,"w":[["وَٱلنَّهَارِ","wal-nahāri","And the day","শপথ দিনের"],["إِذَا","idhā","when","যখন"],["تَجَلَّىٰ","tajallā","it shines in brightness","আলোকিত হয়"]],"t":"وَ<h>ٱ</><l>ل</><g>نَّ</>هَارِ إِذَا تَجَلَّىٰ"},{"n":3,"w":[["وَمَا","wamā","And He Who","শপথ তাঁর (যিনি)"],["خَلَقَ","khalaqa","created","সৃষ্টি করেছেন"],["ٱلذَّكَرَ","l-dhakara","the male","পুরুষ"],["وَٱلْأُنثَىٰٓ","wal-unthā","and the female","ও নারী"]],"t":"وَمَا خَلَقَ <h>ٱ</><l>ل</>ذَّكَرَ وَ<h>ٱ</>لْأُ<k>نثَ</>ىٰٓ"},{"n":4,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["سَعْيَكُمْ","sa‘yakum","your efforts","তোমাদের কর্মপ্রচেষ্টা"],["لَشَتَّىٰ","lashattā","(are) surely diverse","অবশ্যই বিভিন্ন প্রকৃতির"]],"t":"إِ<g>نَّ</> سَعْيَكُمْ لَشَتَّىٰ"},{"n":5,"w":[["فَأَمَّا","fa-ammā","Then as for","অতঃপর (তার) ক্ষেত্রে"],["مَنْ","man","(him) who","যে"],["أَعْطَىٰ","a‘ṭā","gives","দান করলো"],["وَٱتَّقَىٰ","wa-ittaqā","and fears","ও খোদাভীরু হলো"]],"t":"فَأَ<g>مَّ</>ا مَنْ أَعْطَىٰ وَ<h>ٱ</>تَّقَىٰ"},{"n":6,"w":[["وَصَدَّقَ","waṣaddaqa","And believes","এবং সত্য মানলো"],["بِٱلْحُسْنَىٰ","bil-ḥus'nā","in the best","উত্তমকে (ইসলামকে)"]],"t":"وَصَدَّقَ بِ<h>ٱ</>لْحُسْنَىٰ"},{"n":7,"w":[["فَسَنُيَسِّرُهُۥ","fasanuyassiruhu","Then We will ease him","আমরা তাকে সহজতা দিব"],["لِلْيُسْرَىٰ","lil'yus'rā","towards [the] ease","সহজ (পথের) জন্য"]],"t":"فَسَنُيَسِّرُهُ<m>ۥ</> لِلْيُسْرَىٰ"},{"n":8,"w":[["وَأَمَّا","wa-ammā","But as for","আর (তার)ক্ষেত্রে"],["مَنۢ","man","(him) who","যে"],["بَخِلَ","bakhila","withholds","কৃপণতা করলো"],["وَٱسْتَغْنَىٰ","wa-is'taghnā","and considers himself free from need","ও নিজেকে স্বয়ংসম্পূর্ণ মনে করলো"]],"t":"وَأَ<g>مَّ</>ا <i>مَنۢ بَ</>خِلَ وَ<h>ٱ</>سْتَغْنَىٰ"},{"n":9,"w":[["وَكَذَّبَ","wakadhaba","And denies","এবং অমান্য করলো"],["بِٱلْحُسْنَىٰ","bil-ḥus'nā","the best","উত্তমকে (ইসলামকে)"]],"t":"وَكَذَّبَ بِ<h>ٱ</>لْحُسْنَىٰ"},{"n":10,"w":[["فَسَنُيَسِّرُهُۥ","fasanuyassiruhu","Then We will ease him","ফলে আমরা তাকে সহজতা দিব"],["لِلْعُسْرَىٰ","lil'‘us'rā","towards [the] difficulty","কঠোর পথের জন্য"]],"t":"فَسَنُيَسِّرُهُ<m>ۥ</> لِلْعُسْرَىٰ"},{"n":11,"w":[["وَمَا","wamā","And not","এবং না"],["يُغْنِى","yugh'nī","will avail","কাজে আসবে"],["عَنْهُ","‘anhu","him","তার জন্যে"],["مَالُهُۥٓ","māluhu","his wealth","তার ধনসম্পদ"],["إِذَا","idhā","when","যখন"],["تَرَدَّىٰٓ","taraddā","he falls","সে ধ্বংস হবে"]],"t":"وَمَا يُغْنِى عَنْهُ مَالُهُ<o>ۥٓ</> إِذَا تَرَدَّىٰٓ"},{"n":12,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["عَلَيْنَا","‘alaynā","upon Us","আমাদের দায়িত্বে"],["لَلْهُدَىٰ","lalhudā","(is) the guidance","পথ প্রদর্শন"]],"t":"إِ<g>نَّ</> عَلَيْنَا لَلْهُدَىٰ"},{"n":13,"w":[["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["لَنَا","lanā","for Us","আমরা মালিক"],["لَلْـَٔاخِرَةَ","lalākhirata","(is) the Hereafter","পরকালের"],["وَٱلْأُولَىٰ","wal-ūlā","and the first (life)","ও ইহকালের"]],"t":"وَإِ<g>نَّ</> لَنَا لَلْءَاخِرَةَ وَ<h>ٱ</>لْأُولَىٰ"},{"n":14,"w":[["فَأَنذَرْتُكُمْ","fa-andhartukum","So I warn you","অতএব তোমাদেরকে আমি সতর্ক করছি"],["نَارًۭا","nāran","(of) a Fire","অগ্নির"],["تَلَظَّىٰ","talaẓẓā","blazing","জ্বলন্ত"]],"t":"فَأَ<k>نذَ</>رْتُكُمْ نَا<k>رًۭا تَ</>لَظَّىٰ"},{"n":15,"w":[["لَا","lā","Not","না"],["يَصْلَىٰهَآ","yaṣlāhā","will burn (in) it","এতে প্রবেশ করবে"],["إِلَّا","illā","except","এ ছাড়া"],["ٱلْأَشْقَى","l-ashqā","the most wretched","নিতান্ত হতভাগ্য"]],"t":"لَا يَصْلَ<m>ىٰ</><o>هَآ</> إِلَّا <h>ٱ</>لْأَشْقَى"},{"n":16,"w":[["ٱلَّذِى","alladhī","The one who","যে"],["كَذَّبَ","kadhaba","denied","মিথ্যারোপ করলো"],["وَتَوَلَّىٰ","watawallā","and turned away","এবং মুখ ফিরালো"]],"t":"ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ"},{"n":17,"w":[["وَسَيُجَنَّبُهَا","wasayujannabuhā","But will be removed from it","এবং এ থেকে দূরে রাখা হবে"],["ٱلْأَتْقَى","l-atqā","the righteous","পরম মুত্তাকীকে"]],"t":"وَسَيُجَ<g>نَّ</>بُهَا <h>ٱ</>لْأَتْقَى"},{"n":18,"w":[["ٱلَّذِى","alladhī","The one who","যে"],["يُؤْتِى","yu'tī","gives","দান করে"],["مَالَهُۥ","mālahu","his wealth","তার ধনসম্পদ"],["يَتَزَكَّىٰ","yatazakkā","(to) purify himself","আত্মশুদ্ধির জন্য"]],"t":"ٱلَّذِى يُؤْتِى مَالَهُ<m>ۥ</> يَتَزَكَّىٰ"},{"n":19,"w":[["وَمَا","wamā","And not","এবং নাই"],["لِأَحَدٍ","li-aḥadin","for anyone","কারও"],["عِندَهُۥ","‘indahu","with him","তার উপর"],["مِن","min","any","কোন"],["نِّعْمَةٍۢ","ni‘'matin","favor","অনুগ্রহ (যার)"],["تُجْزَىٰٓ","tuj'zā","to be recompensed","প্রতিদান দিতে হবে"]],"t":"وَمَا لِأَحَدٍ عِ<k>ندَ</>هُ<m>ۥ</> <d>مِن نِّ</>عْمَ<k>ةٍۢ تُ</><q>جْ</>زَىٰٓ"},{"n":20,"w":[["إِلَّا","illā","Except","কেবল"],["ٱبْتِغَآءَ","ib'tighāa","seeking","সে অন্বেষণ করে"],["وَجْهِ","wajhi","(the) Countenance","সন্তুষ্টি"],["رَبِّهِ","rabbihi","(of) his Lord","তার রবের"],["ٱلْأَعْلَىٰ","l-a‘lā","the Most High","সর্বশ্রেষ্ঠ"]],"t":"إِلَّا <h>ٱ</><q>بْ</>تِ<o>غَآ</>ءَ وَ<q>جْ</>هِ رَبِّهِ <h>ٱ</>لْأَعْلَىٰ"},{"n":21,"w":[["وَلَسَوْفَ","walasawfa","And soon, surely","এবং অচিরেই অবশ্যই"],["يَرْضَىٰ","yarḍā","he will be pleased","তিনি সন্তুষ্ট হবেন (তার প্রতি)"]],"t":"وَلَسَوْفَ يَرْضَىٰ"}]}