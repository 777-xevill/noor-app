{"n":34,"a":[{"n":1,"w":[["ٱلْحَمْدُ","al-ḥamdu","All praises","সমস্ত প্রশংসা"],["لِلَّهِ","lillahi","(be) to Allah","জন্যে আল্লাহর"],["ٱلَّذِى","alladhī","the One to Whom belongs","যিনি (এমন সত্ত্বা)"],["لَهُۥ","lahu","the One to Whom belongs","জন্যে তাঁরই (মালিকানায়)"],["مَا","mā","whatever","যা কিছু"],["فِى","fī","(is) in","মধ্যে (আছে)"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশমন্ডলীর"],["وَمَا","wamā","and whatever","আর যা কিছু"],["فِى","fī","(is) in","মধ্যে (আছে)"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["وَلَهُ","walahu","and for Him","এবং জন্যে তাঁরই"],["ٱلْحَمْدُ","l-ḥamdu","(are) all praises","সকল প্রশংসা"],["فِى","fī","in","মধ্যে"],["ٱلْـَٔاخِرَةِ ۚ","l-ākhirati","the Hereafter","পরকালের"],["وَهُوَ","wahuwa","And He","এবং তিনিই"],["ٱلْحَكِيمُ","l-ḥakīmu","(is) the All-Wise","প্রজ্ঞাময়"],["ٱلْخَبِيرُ","l-khabīru","the All-Aware","খুব অবহিত"]],"t":"ٱلْحَمْدُ لِلَّهِ <h>ٱ</>لَّذِى لَهُ<m>ۥ</> مَا فِى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَمَا فِى <h>ٱ</>لْأَرْضِ وَلَهُ <h>ٱ</>لْحَمْدُ فِى <h>ٱ</>لْءَاخِرَةِ ۚ وَهُوَ <h>ٱ</>لْحَكِيمُ <h>ٱ</>لْخَ<p>بِي</>رُ"},{"n":2,"w":[["يَعْلَمُ","ya‘lamu","He knows","তিনি জানেন"],["مَا","mā","what","যা কিছু"],["يَلِجُ","yaliju","penetrates","প্রবেশ করে"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["وَمَا","wamā","and what","আর যা কিছু"],["يَخْرُجُ","yakhruju","comes out","বের হয়"],["مِنْهَا","min'hā","from it","থেকে তা"],["وَمَا","wamā","and what","এবং যা কিছু"],["يَنزِلُ","yanzilu","descends","নামে (অবতীর্ণ হয়)"],["مِنَ","mina","from","থেকে"],["ٱلسَّمَآءِ","l-samāi","the heaven","আকাশ"],["وَمَا","wamā","and what","আর যা কিছু"],["يَعْرُجُ","ya‘ruju","ascends","উত্থিত হয়"],["فِيهَا ۚ","fīhā","therein","মধ্যে তার"],["وَهُوَ","wahuwa","And He","এবং তিনিই"],["ٱلرَّحِيمُ","l-raḥīmu","(is) the Most Merciful","পরম দয়ালু"],["ٱلْغَفُورُ","l-ghafūru","the Oft-Forgiving","ক্ষমাশীল"]],"t":"يَعْلَمُ مَا يَلِجُ فِى <h>ٱ</>لْأَرْضِ وَمَا يَخْرُجُ مِنْهَا وَمَا يَ<k>نزِ</>لُ مِنَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ وَمَا يَعْرُجُ فِيهَا ۚ وَهُوَ <h>ٱ</><l>ل</>رَّحِيمُ <h>ٱ</>لْغَ<p>فُو</>رُ"},{"n":3,"w":[["وَقَالَ","waqāla","But say","এবং বলে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieve","অস্বীকার করেছে"],["لَا","lā","Not","\"(কেন) না"],["تَأْتِينَا","tatīnā","will come to us","উপর আসছে আমাদের"],["ٱلسَّاعَةُ ۖ","l-sā‘atu","the Hour","ক্বিয়ামাত\""],["قُلْ","qul","Say","বলো"],["بَلَىٰ","balā","Nay","\"কেন না নিশ্চয়ই"],["وَرَبِّى","warabbī","by my Lord","শপথ আমার রবের"],["لَتَأْتِيَنَّكُمْ","latatiyannakum","surely it will come to you","অবশ্যই উপর আসবেই তোমাদের"],["عَـٰلِمِ","‘ālimi","(He is the) Knower","(আমার রব)জ্ঞানী"],["ٱلْغَيْبِ ۖ","l-ghaybi","(of) the unseen","অদৃশ্যের (ব্যাপারে)\""],["لَا","lā","Not","না"],["يَعْزُبُ","ya‘zubu","escapes","লুকায়িত আছে"],["عَنْهُ","‘anhu","from Him","থেকে তাঁর"],["مِثْقَالُ","mith'qālu","(the) weight","(কিছু) পরিমাণও"],["ذَرَّةٍۢ","dharratin","(of) an atom","কোনো অণুর"],["فِى","fī","in","মধ্যে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশসমূহের"],["وَلَا","walā","and not","আর না"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["وَلَآ","walā","and not","এবং না"],["أَصْغَرُ","aṣgharu","smaller","ক্ষুদ্রতর"],["مِن","min","than","চেয়েও"],["ذَٰلِكَ","dhālika","that","সেটার"],["وَلَآ","walā","and not","আর না"],["أَكْبَرُ","akbaru","greater","বৃহত্তর"],["إِلَّا","illā","but","কিন্তু"],["فِى","fī","(is) in","মধ্যে (আছে)"],["كِتَـٰبٍۢ","kitābin","a Record","(লিখিত) একটি কিতাবের"],["مُّبِينٍۢ","mubīnin","Clear","সুস্পষ্ট"]],"t":"وَقَالَ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> لَا تَأْتِينَا <h>ٱ</><l>ل</>سَّاعَةُ ۖ قُلْ بَلَىٰ وَرَبِّى لَتَأْتِيَ<g>نَّ</>كُمْ <m>عَٰ</>لِمِ <h>ٱ</>لْغَيْبِ ۖ لَا يَعْزُبُ عَنْهُ مِثْقَالُ ذَرَّ<k>ةٍۢ فِ</>ى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَلَا فِى <h>ٱ</>لْأَرْضِ وَ<o>لَآ</> أَصْغَرُ مِ<k>ن ذَٰ</>لِكَ وَ<o>لَآ</> أَكْبَرُ إِلَّا فِى كِ<m>تَٰ</><d>بٍۢ مُّ</><p>بِي</>نٍۢ"},{"n":4,"w":[["لِّيَجْزِىَ","liyajziya","That He may reward","(ক্বিয়ামাত এজন্যে) যেন তিনি পুরস্কার দেন"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["وَعَمِلُوا۟","wa‘amilū","and do","ও কাজ করেছে"],["ٱلصَّـٰلِحَـٰتِ ۚ","l-ṣāliḥāti","righteous deeds","সৎ"],["أُو۟لَـٰٓئِكَ","ulāika","Those ","ঐসব (লোক)"],["لَهُم","lahum","for them","জন্যে তাদের (রয়েছে)"],["مَّغْفِرَةٌۭ","maghfiratun","(will be) forgiveness","ক্ষমা"],["وَرِزْقٌۭ","wariz'qun","and a provision","ও জীবিকা"],["كَرِيمٌۭ","karīmun","noble","সম্মানজনক"]],"t":"لِّيَ<q>جْ</>زِىَ <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ ۚ أُ<s>و۟</><o>لَٰٓ</>ئِكَ لَ<y>هُم مَّ</>غْفِرَ<d>ةٌۭ وَ</>رِزْ<k>قٌۭ كَ</><p>رِي</>مٌۭ"},{"n":5,"w":[["وَٱلَّذِينَ","wa-alladhīna","But those who","এবং যারা"],["سَعَوْ","sa‘aw","strive","চেষ্টা করে"],["فِىٓ","fī","against","ক্ষেত্রে"],["ءَايَـٰتِنَا","āyātinā","Our Verses","আয়াতগুলোর আমাদের"],["مُعَـٰجِزِينَ","mu‘ājizīna","(to) cause failure ","ব্যর্থ প্রমাণ করতে"],["أُو۟لَـٰٓئِكَ","ulāika","those ","ঐসব (লোক)"],["لَهُمْ","lahum","for them","জন্যে তাদের(রয়েছে)"],["عَذَابٌۭ","‘adhābun","(is) a punishment","শাস্তি"],["مِّن","min","of","ধরণের"],["رِّجْزٍ","rij'zin","foul nature","ভয়ংকর"],["أَلِيمٌۭ","alīmun","painful","নির্মম"]],"t":"وَ<h>ٱ</>لَّذِينَ سَعَوْ <o>فِىٓ</> ءَا<m>يَٰ</>تِنَا مُ<m>عَٰ</>جِزِينَ أُ<s>و۟</><o>لَٰٓ</>ئِكَ لَهُمْ عَذَا<d>بٌۭ مِّ</><w>ن رِّ</><q>جْ</>زٍ أَ<p>لِي</>مٌۭ"},{"n":6,"w":[["وَيَرَى","wayarā","And see","এবং জানে"],["ٱلَّذِينَ","alladhīna","those who","(তারা) যাদের"],["أُوتُوا۟","ūtū","have been given","দেয়া হয়েছে"],["ٱلْعِلْمَ","l-‘il'ma","the knowledge","জ্ঞান"],["ٱلَّذِىٓ","alladhī","(that) what","যা"],["أُنزِلَ","unzila","is revealed","অবতীর্ণ করা হয়েছে"],["إِلَيْكَ","ilayka","to you","প্রতি তোমার"],["مِن","min","from","পক্ষ হ'তে"],["رَّبِّكَ","rabbika","your Lord","তোমার রবের"],["هُوَ","huwa","[it]","তা"],["ٱلْحَقَّ","l-ḥaqa","(is) the Truth","সত্য"],["وَيَهْدِىٓ","wayahdī","and it guides","এবং তা পথ দেখায়"],["إِلَىٰ","ilā","to","দিকে"],["صِرَٰطِ","ṣirāṭi","(the) Path","পথের"],["ٱلْعَزِيزِ","l-‘azīzi","(of) the All-Mighty","পরাক্রমশালী (রবের)"],["ٱلْحَمِيدِ","l-ḥamīdi","the Praiseworthy","(যিনি) প্রশংসিত"]],"t":"وَيَرَى <h>ٱ</>لَّذِينَ أُوتُو<s>ا۟</> <h>ٱ</>لْعِلْمَ <h>ٱ</>لَّ<o>ذِىٓ</> أُ<k>نزِ</>لَ إِلَيْكَ <w>مِن رَّ</>بِّكَ هُوَ <h>ٱ</>لْحَقَّ وَيَهْ<o>دِىٓ</> إِلَىٰ صِ<m>رَٰ</>طِ <h>ٱ</>لْعَزِيزِ <h>ٱ</>لْحَ<p>مِي</><q>دِ</>"},{"n":7,"w":[["وَقَالَ","waqāla","But say","এবং বলে"],["ٱلَّذِينَ","alladhīna","those who","(তারা) যারা"],["كَفَرُوا۟","kafarū","disbelieve","অস্বীকার করেছে"],["هَلْ","hal","Shall","\"কি"],["نَدُلُّكُمْ","nadullukum","we direct you","আমরা সন্ধান দিবো তোমাদেরকে"],["عَلَىٰ","‘alā","to","সম্পর্কে"],["رَجُلٍۢ","rajulin","a man","এক ব্যক্তির"],["يُنَبِّئُكُمْ","yunabbi-ukum","who informs you","যে জানিয়ে দিবে তোমাদেরকে"],["إِذَا","idhā","when","যখন"],["مُزِّقْتُمْ","muzziq'tum","you have disintegrated","ছিন্ন-বিচ্ছিন্ন করা হবে তোমাদেরকে"],["كُلَّ","kulla","(in) total","সম্পূর্ণ"],["مُمَزَّقٍ","mumazzaqin","disintegration","খুব ছিন্ন-বিচ্ছিন্ন"],["إِنَّكُمْ","innakum","indeed you","নিশ্চয়ই তোমরা(হবে)"],["لَفِى","lafī","surely (will be) in","অবশ্যই মধ্যে"],["خَلْقٍۢ","khalqin","a creation","সৃষ্টির"],["جَدِيدٍ","jadīdin","new","নতুন (অর্থাৎ উত্থিত হবে?)"]],"t":"وَقَالَ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> هَلْ نَدُلُّكُمْ عَلَىٰ رَجُ<d>لٍۢ يُ</>نَبِّئُكُمْ إِذَا مُزِّ<q>قْ</>تُمْ كُلَّ مُمَزَّقٍ إِ<g>نَّ</>كُمْ لَفِى خَلْ<k>قٍۢ جَ</><p>دِي</><q>دٍ</>"},{"n":8,"w":[["أَفْتَرَىٰ","aftarā","Has he invented","কি রচনা করেছে"],["عَلَى","‘alā","about","উপর"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["كَذِبًا","kadhiban","a lie","মিথ্যা"],["أَم","am","or","অথবা"],["بِهِۦ","bihi","in him","সাথে তার (আছে)"],["جِنَّةٌۢ ۗ","jinnatun","(is) madness","জিন\""],["بَلِ","bali","Nay","বরং"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["لَا","lā","(do) not","না"],["يُؤْمِنُونَ","yu'minūna","believe","বিশ্বাস করে"],["بِٱلْـَٔاخِرَةِ","bil-ākhirati","in the Hereafter","প্রতি আখেরাতের"],["فِى","fī","(will be) in","মধ্যে (রয়েছে)"],["ٱلْعَذَابِ","l-‘adhābi","the punishment","শাস্তির"],["وَٱلضَّلَـٰلِ","wal-ḍalāli","and error","এবং বিভ্রান্তির"],["ٱلْبَعِيدِ","l-ba‘īdi","far","সুদূর"]],"t":"أَفْتَرَىٰ عَلَى <h>ٱ</>للَّهِ كَذِبًا <f>أَم بِ</><m>هِۦ</> جِ<g>نَّ</>ةٌۢ ۗ<i> بَ</>لِ <h>ٱ</>لَّذِينَ لَا يُؤْمِنُونَ بِ<h>ٱ</>لْءَاخِرَةِ فِى <h>ٱ</>لْعَذَابِ وَ<h>ٱ</><l>ل</>ضَّ<m>لَٰ</>لِ <h>ٱ</>لْبَ<p>عِي</><q>دِ</>"},{"n":9,"w":[["أَفَلَمْ","afalam","Then, do not","কি তবে না"],["يَرَوْا۟","yaraw","they see","তারা দেখে"],["إِلَىٰ","ilā","towards","দিকে"],["مَا","mā","what","(তার) যা"],["بَيْنَ","bayna","(is) before them","মাঝে"],["أَيْدِيهِمْ","aydīhim","(is) before them","হাতের (সামনে রয়েছে) তাদের"],["وَمَا","wamā","and what","এবং যা"],["خَلْفَهُم","khalfahum","(is) behind them","পিছনে তাদের"],["مِّنَ","mina","of","হ'তে"],["ٱلسَّمَآءِ","l-samāi","the heaven","আকাশ"],["وَٱلْأَرْضِ ۚ","wal-arḍi","and the earth","এবং পৃথিবী"],["إِن","in","If","যদি"],["نَّشَأْ","nasha","We will","আমরা চাই"],["نَخْسِفْ","nakhsif","We (could) cause to swallow them","আমরা ধ্বসিয়ে দিবো"],["بِهِمُ","bihimu","We (could) cause to swallow them","সহ তাদের"],["ٱلْأَرْضَ","l-arḍa","the earth","পৃথিবীকে"],["أَوْ","aw","or","অথবা"],["نُسْقِطْ","nus'qiṭ","cause to fall","আমরা পতিত করবো"],["عَلَيْهِمْ","‘alayhim","upon them","উপর তাদের"],["كِسَفًۭا","kisafan","fragments","(কিছু) খণ্ড"],["مِّنَ","mina","from","থেকে"],["ٱلسَّمَآءِ ۚ","l-samāi","the sky","আকাশ"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে (রয়েছে)"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَةًۭ","laāyatan","surely, is a Sign","অবশ্যই নিদর্শন"],["لِّكُلِّ","likulli","for every","জন্যে প্রত্যেক"],["عَبْدٍۢ","‘abdin","slave","দাসের"],["مُّنِيبٍۢ","munībin","who turns (to Allah)","যে (আল্লাহ) অভিমুখী"]],"t":"أَفَلَمْ يَرَوْ<s>ا۟</> إِلَىٰ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَ<y>هُم مِّ</>نَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ وَ<h>ٱ</>لْأَرْضِ ۚ <d>إِن نَّ</>شَأْ نَخْسِفْ بِهِمُ <h>ٱ</>لْأَرْضَ أَوْ نُسْقِ<q>طْ</> عَلَيْهِمْ كِسَ<d>فًۭا مِّ</>نَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ ۚ إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَايَ<w>ةًۭ لِّ</>كُلِّ عَ<q>بْ</><d>دٍۢ مُّ</><p>نِي</><q>بٍۢ</>"},{"n":10,"w":[["۞ وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["ءَاتَيْنَا","ātaynā","We gave","আমরা দিয়েছি"],["دَاوُۥدَ","dāwūda","Dawood","দাউদকে"],["مِنَّا","minnā","from Us","আমাদের পক্ষ থেকে"],["فَضْلًۭا ۖ","faḍlan","Bounty","অনুগ্রহ"],["يَـٰجِبَالُ","yājibālu","O mountains","\"(এবং বলেছিলাম) হে পর্বতমালা"],["أَوِّبِى","awwibī","Repeat praises","পবিত্রতা ঘোষণা করো"],["مَعَهُۥ","ma‘ahu","with him","তার সাথে"],["وَٱلطَّيْرَ ۖ","wal-ṭayra","and the birds","এবং পাখীদেরকেও (হুকুম দিয়েছিলাম)\""],["وَأَلَنَّا","wa-alannā","And We made pliable","এবং আমরা নরম করে দেই"],["لَهُ","lahu","for him","জন্যে তার"],["ٱلْحَدِيدَ","l-ḥadīda","[the] iron","লোহাকে"]],"t":"۞ وَلَقَ<q>دْ</> ءَاتَيْنَا دَاوُ<m>ۥ</>دَ مِ<g>نَّ</>ا فَضْلًۭ<d>ا ۖ يَٰ</>جِبَالُ أَوِّبِى مَعَهُ<m>ۥ</> وَ<h>ٱ</><l>ل</>طَّيْرَ ۖ وَأَلَ<g>نَّ</>ا لَهُ <h>ٱ</>لْحَ<p>دِي</><q>دَ</>"},{"n":11,"w":[["أَنِ","ani","That","(এবং নির্দেশ দিয়েছিলাম) যে"],["ٱعْمَلْ","i‘'mal","make","তুমি তৈরি করো"],["سَـٰبِغَـٰتٍۢ","sābighātin","full coats of mail","(নিখুঁত) বর্মসমূহ"],["وَقَدِّرْ","waqaddir","and measure precisely","ও পরিমাণ রক্ষা করো"],["فِى","fī","[of]","মধ্যে"],["ٱلسَّرْدِ ۖ","l-sardi","the links (of armor)","কড়াগুলোর"],["وَٱعْمَلُوا۟","wa-i‘'malū","and work","এবং তোমরা কাজ করো"],["صَـٰلِحًا ۖ","ṣāliḥan","righteousness","সৎ"],["إِنِّى","innī","Indeed, I Am","নিশ্চয়ই আমি"],["بِمَا","bimā","of what","ঐ বিষয়ে যা"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা করছো"],["بَصِيرٌۭ","baṣīrun","All-Seer","দৃষ্টিমান"]],"t":"أَنِ <h>ٱ</>عْمَلْ <m>سَٰبِغَٰ</><d>تٍۢ وَ</>قَدِّرْ فِى <h>ٱ</><l>ل</>سَّرْدِ ۖ وَ<h>ٱ</>عْمَلُو<s>ا۟</> <m>صَٰ</>لِحًا ۖ إِ<g>نِّ</>ى بِمَا تَعْمَلُونَ بَ<p>صِي</>رٌۭ"},{"n":12,"w":[["وَلِسُلَيْمَـٰنَ","walisulaymāna","And to Sulaiman","এবং জন্যে সোলায়মানের (অধীন করে দেই)"],["ٱلرِّيحَ","l-rīḥa","the wind ","বাতাসকে"],["غُدُوُّهَا","ghuduwwuhā","its morning course","সকালের বেড়ানো তার"],["شَهْرٌۭ","shahrun","(was) a month","এক মাসের"],["وَرَوَاحُهَا","warawāḥuhā","and its afternoon course","এবং সন্ধ্যার বেড়ানো তার"],["شَهْرٌۭ ۖ","shahrun","(was) a month","এক মাসের (অর্থাৎ সে এক মাসের পথ এক সকাল বা এক সন্ধায় অতিক্রম করতো"],["وَأَسَلْنَا","wa-asalnā","and We caused to flow","এবং আমরা প্রবাহিত করেছি"],["لَهُۥ","lahu","for him","জন্যে তার"],["عَيْنَ","‘ayna","a spring","ঝর্ণা"],["ٱلْقِطْرِ ۖ","l-qiṭ'ri","(of) molten copper","গলানো তামার"],["وَمِنَ","wamina","And [of]","এবং কিছু"],["ٱلْجِنِّ","l-jini","the jinn","জিনদের"],["مَن","man","who","যারা"],["يَعْمَلُ","ya‘malu","worked","কাজ করতো"],["بَيْنَ","bayna","before him","মাঝে"],["يَدَيْهِ","yadayhi","before him","হাতের (সামনে) তার"],["بِإِذْنِ","bi-idh'ni","by the permission","ক্রমে অনুমতি"],["رَبِّهِۦ ۖ","rabbihi","(of) his Lord","তাঁর রবের"],["وَمَن","waman","And whoever","আর যে"],["يَزِغْ","yazigh","deviated","অমান্য করতো"],["مِنْهُمْ","min'hum","among them","মধ্য থেকে তাদের"],["عَنْ","‘an","from","হ'তে"],["أَمْرِنَا","amrinā","Our Command","নির্দেশের আমাদের"],["نُذِقْهُ","nudhiq'hu","We will make him taste","আমরা আস্বাদন করাতাম তাকে"],["مِنْ","min","of","থেকে"],["عَذَابِ","‘adhābi","(the) punishment","শাস্তি"],["ٱلسَّعِيرِ","l-sa‘īri","(of) the Blaze","জ্বলন্ত আগুনের"]],"t":"وَلِسُلَيْ<m>مَٰ</>نَ <h>ٱ</><l>ل</>رِّيحَ غُدُوُّهَا شَهْ<d>رٌۭ وَ</>رَوَاحُهَا شَهْ<d>رٌۭ ۖ وَ</>أَسَلْنَا لَهُ<m>ۥ</> عَيْنَ <h>ٱ</>لْقِ<q>طْ</>رِ ۖ وَمِنَ <h>ٱ</>لْجِ<g>نِّ</> <d>مَن يَ</>عْمَلُ بَيْنَ يَدَيْهِ بِإِذْنِ رَبِّهِۦ<m> ۖ</> وَ<d>مَن يَ</>زِغْ مِنْهُمْ عَنْ أَمْرِنَا نُذِ<q>قْ</>هُ مِنْ عَذَابِ <h>ٱ</><l>ل</>سَّ<p>عِي</>رِ"},{"n":13,"w":[["يَعْمَلُونَ","ya‘malūna","They worked","তারা তৈরি করতো"],["لَهُۥ","lahu","for him","জন্যে তার"],["مَا","mā","what","যা"],["يَشَآءُ","yashāu","he willed","সে ইচ্ছে করতো"],["مِن","min","of","যেমন"],["مَّحَـٰرِيبَ","maḥārība","elevated chambers","প্রাসাদসমূহ"],["وَتَمَـٰثِيلَ","watamāthīla","and statues","ও (প্রাণহীন বস্তুর)ভাস্কর্য"],["وَجِفَانٍۢ","wajifānin","and bowls","ও বড় পাত্রসমূহ"],["كَٱلْجَوَابِ","kal-jawābi","like reservoirs","হাউজসদৃশ"],["وَقُدُورٍۢ","waqudūrin","and cooking-pots","এবং বড় ডেগসমূহ"],["رَّاسِيَـٰتٍ ۚ","rāsiyātin","fixed","দৃঢ়ভাবে প্রতিষ্ঠিত"],["ٱعْمَلُوٓا۟","i‘'malū","Work","\"(আরও বলেছিলাম) তোমরা কাজ করো"],["ءَالَ","āla","O family","(হে)বংশধররা"],["دَاوُۥدَ","dāwūda","(of) Dawood","দাউদের"],["شُكْرًۭا ۚ","shuk'ran","(in) gratitude","কৃতজ্ঞতা সহকারে\""],["وَقَلِيلٌۭ","waqalīlun","But few","এবং কমই"],["مِّنْ","min","of","মধ্যে হ'তে"],["عِبَادِىَ","‘ibādiya","My slaves","আমার দাসদের"],["ٱلشَّكُورُ","l-shakūru","(are) grateful","কৃতজ্ঞ"]],"t":"يَعْمَلُونَ لَهُ<m>ۥ</> مَا يَ<o>شَآ</>ءُ <d>مِن مَّ</><m>حَٰ</>رِيبَ وَتَ<m>مَٰ</>ثِيلَ وَجِفَا<k>نٍۢ كَ</><h>ٱ</>لْجَوَابِ وَقُدُو<w>رٍۢ رَّ</>اسِ<m>يَٰ</>تٍ ۚ <h>ٱ</>عْمَ<o>لُوٓ</><s>ا۟</> ءَالَ دَاوُ<m>ۥ</>دَ شُكْ<d>رًۭا ۚ وَ</>قَلِي<d>لٌۭ مِّ</>نْ عِبَادِىَ <h>ٱ</><l>ل</>شَّ<p>كُو</>رُ"},{"n":14,"w":[["فَلَمَّا","falammā","Then when","অতঃপর যখন"],["قَضَيْنَا","qaḍaynā","We decreed","সিদ্ধান্ত করলাম আমরা"],["عَلَيْهِ","‘alayhi","for him","উপর তার"],["ٱلْمَوْتَ","l-mawta","the death","মৃত্যুর"],["مَا","mā","not","না"],["دَلَّهُمْ","dallahum","indicated to them","জানালো তাদের"],["عَلَىٰ","‘alā","[on]","সম্পর্কে"],["مَوْتِهِۦٓ","mawtihi","his death","মৃত্যু তার"],["إِلَّا","illā","except","কিন্তু"],["دَآبَّةُ","dābbatu","a creature","ঘুণপোকা"],["ٱلْأَرْضِ","l-arḍi","(of) the earth","মাটির"],["تَأْكُلُ","takulu","eating","(যা) খাচ্ছিলো"],["مِنسَأَتَهُۥ ۖ","minsa-atahu","his staff","লাঠিকে তার"],["فَلَمَّا","falammā","But when","অতঃপর যখন"],["خَرَّ","kharra","he fell down","সে পড়ে গেলো"],["تَبَيَّنَتِ","tabayyanati","became clear","পরিষ্কারভাবে জানতে পারলো"],["ٱلْجِنُّ","l-jinu","(to) the jinn","জিনরা"],["أَن","an","that","যে"],["لَّوْ","law","if","যদি"],["كَانُوا۟","kānū","they had","তারা ছিলো"],["يَعْلَمُونَ","ya‘lamūna","known","তারা জানতো"],["ٱلْغَيْبَ","l-ghayba","the unseen","অদৃশ্য বিষয়ে"],["مَا","mā","not","না"],["لَبِثُوا۟","labithū","they (would have) remained","তারা অবস্থান করতো (বাঁধা থাকতো)"],["فِى","fī","in","মধ্যে"],["ٱلْعَذَابِ","l-‘adhābi","the punishment","শাস্তির"],["ٱلْمُهِينِ","l-muhīni","humiliating","অপমানকর"]],"t":"فَلَ<g>مَّ</>ا قَضَيْنَا عَلَيْهِ <h>ٱ</>لْمَوْتَ مَا دَلَّهُمْ عَلَىٰ مَوْتِ<o>هِۦٓ</> إِلَّا <n>دَآ</>بَّةُ <h>ٱ</>لْأَرْضِ تَأْكُلُ مِ<k>نسَ</>أَتَهُۥ ۖ فَلَ<g>مَّ</>ا خَرَّ تَبَيَّنَتِ <h>ٱ</>لْجِ<g>نُّ</> <w>أَن لَّ</>وْ كَانُو<s>ا۟</> يَعْلَمُونَ <h>ٱ</>لْغَيْبَ مَا لَبِثُو<s>ا۟</> فِى <h>ٱ</>لْعَذَابِ <h>ٱ</>لْمُ<p>هِي</>نِ"},{"n":15,"w":[["لَقَدْ","laqad","Certainly","নিশ্চয়ই"],["كَانَ","kāna","(there) was","ছিলো"],["لِسَبَإٍۢ","lisaba-in","for Saba","জন্যে সাবা (জাতির)"],["فِى","fī","in","মধ্যে"],["مَسْكَنِهِمْ","maskanihim","their dwelling place","বাসভূমির তাদের"],["ءَايَةٌۭ ۖ","āyatun","a sign:","একটি নিদর্শন"],["جَنَّتَانِ","jannatāni","Two gardens","দু'টি বাগান"],["عَن","‘an","on","থেকে"],["يَمِينٍۢ","yamīnin","(the) right","ডানদিক"],["وَشِمَالٍۢ ۖ","washimālin","and (on the) left","ও বামদিকে"],["كُلُوا۟","kulū","Eat","\"(বলেছিলাম) তোমরা খাও"],["مِن","min","from","থেকে"],["رِّزْقِ","riz'qi","(the) provision","জীবিকা"],["رَبِّكُمْ","rabbikum","(of) your Lord","রবের তোমাদের"],["وَٱشْكُرُوا۟","wa-ush'kurū","and be grateful","ও তোমরা কৃতজ্ঞতা প্রকাশ করো"],["لَهُۥ ۚ","lahu","to Him","জন্যে তাঁর"],["بَلْدَةٌۭ","baldatun","A land","(এই) দেশ"],["طَيِّبَةٌۭ","ṭayyibatun","good","উত্তম"],["وَرَبٌّ","warabbun","and a Lord","এবং রব"],["غَفُورٌۭ","ghafūrun","Oft-Forgiving","ক্ষমাশীল\""]],"t":"لَقَ<q>دْ</> كَانَ لِسَبَ<k>إٍۢ فِ</>ى مَسْكَنِهِمْ ءَايَ<k>ةٌۭ ۖ جَ</><g>نَّ</>تَانِ <d>عَن يَ</>مِي<d>نٍۢ وَ</>شِمَا<k>لٍۢ ۖ كُ</>لُو<s>ا۟</> <w>مِن رِّ</>زْقِ رَبِّكُمْ وَ<h>ٱ</>شْكُرُو<s>ا۟</> لَهُۥ ۚ بَلْدَ<k>ةٌۭ طَ</>يِّبَ<d>ةٌۭ وَ</>رَبٌّ غَ<p>فُو</>رٌۭ"},{"n":16,"w":[["فَأَعْرَضُوا۟","fa-a‘raḍū","But they turned away","কিন্তু তারা মুখ ফেরালো"],["فَأَرْسَلْنَا","fa-arsalnā","so We sent","তাই পাঠালাম আমরা"],["عَلَيْهِمْ","‘alayhim","upon them","উপর তাদে