مَ مِ<k>نكَ</> وَمِ<g>مَّ</><k>ن تَ</>بِعَكَ مِنْهُمْ أَ<q>جْ</>مَ<p>عِي</>نَ"},{"n":86,"w":[["قُلْ","qul","Say","(হে নাবী) বলো"],["مَآ","mā","Not","\"না"],["أَسْـَٔلُكُمْ","asalukum","I ask of you","তোমাদের কাছে চাই আমি"],["عَلَيْهِ","‘alayhi","for it","এর উপর"],["مِنْ","min","any","কোনো"],["أَجْرٍۢ","ajrin","payment","পারিশ্রমিক"],["وَمَآ","wamā","and not","আর না"],["أَنَا۠","anā","I am","আমি"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْمُتَكَلِّفِينَ","l-mutakalifīna","the ones who pretend","ভানকারীদের"]],"t":"قُلْ <o>مَآ</> أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَ<q>جْ</><d>رٍۢ وَ</><o>مَآ</> أَنَا۠ مِنَ <h>ٱ</>لْمُتَكَلِّ<p>فِي</>نَ"},{"n":87,"w":[["إِنْ","in","Not","নয়"],["هُوَ","huwa","it (is)","তা"],["إِلَّا","illā","except","এ ব্যতীত"],["ذِكْرٌۭ","dhik'run","a Reminder","উপদেশ"],["لِّلْعَـٰلَمِينَ","lil'‘ālamīna","to the worlds","বিশ্ববাসীদের জন্যে"]],"t":"إِنْ هُوَ إِلَّا ذِكْ<w>رٌۭ لِّ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":88,"w":[["وَلَتَعْلَمُنَّ","walata‘lamunna","And surely you will know","এবং তোমরা অবশ্যই জানবে"],["نَبَأَهُۥ","naba-ahu","its information","তার খবর"],["بَعْدَ","ba‘da","after","পরেই"],["حِينٍۭ","ḥīnin","a time","কিছুকাল\""]],"t":"وَلَتَعْلَمُ<g>نَّ</> نَبَأَهُ<m>ۥ</> بَعْدَ <p>حِي</>نٍۭ"}]}