{"n":38,"a":[{"n":1,"w":[["صٓ ۚ","sad","Saad","সাদ"],["وَٱلْقُرْءَانِ","wal-qur'āni","By the Quran","কোরআনের শপথ"],["ذِى","dhī","full (of) reminder","পূর্ণ"],["ٱلذِّكْرِ","l-dhik'ri","full (of) reminder","উপদেশ"]],"t":"<n>صٓ</> ۚ وَ<h>ٱ</>لْقُرْءَانِ ذِى <h>ٱ</><l>ل</>ذِّكْرِ"},{"n":2,"w":[["بَلِ","bali","Nay","কিন্তু"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieve","অস্বীকার করেছে"],["فِى","fī","(are) in","মধ্যে (লিপ্ত)"],["عِزَّةٍۢ","‘izzatin","self-glory","ঔদ্ধত্যের"],["وَشِقَاقٍۢ","washiqāqin","and opposition","ও বিরোধীতার"]],"t":"بَلِ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> فِى عِزَّ<d>ةٍۢ وَ</>شِ<p>قَا</><q>قٍۢ</>"},{"n":3,"w":[["كَمْ","kam","How many","কত (জাতিকেই)"],["أَهْلَكْنَا","ahlaknā","We destroyed","আমরা ধ্বংস করেছি"],["مِن","min","before them","পূর্বে"],["قَبْلِهِم","qablihim","before them","তাদের"],["مِّن","min","of","মধ্যে হতে"],["قَرْنٍۢ","qarnin","a generation","জাতিসমূহের"],["فَنَادَوا۟","fanādaw","then they called out","তারা তখন চিৎকার করেছে"],["وَّلَاتَ","walāta","when there (was) no longer","কিন্তু আর ছিলো না"],["حِينَ","ḥīna","time","সময়"],["مَنَاصٍۢ","manāṣin","(for) escape","মুক্তি লাভের"]],"t":"كَمْ أَهْلَكْنَا مِ<k>ن قَ</><q>بْ</>لِ<y>هِم مِّ</><k>ن قَرْنٍۢ فَ</>نَادَو<s>ا۟</> وَّلَاتَ حِينَ مَ<p>نَا</>صٍۢ"},{"n":4,"w":[["وَعَجِبُوٓا۟","wa‘ajibū","And they wonder","এবং অবাক হয়েছে তারা"],["أَن","an","that","যে"],["جَآءَهُم","jāahum","has come to them","তাদের কাছে এসেছে"],["مُّنذِرٌۭ","mundhirun","a warner","একজন সতর্ককারী"],["مِّنْهُمْ ۖ","min'hum","from themselves","তাদেরই মধ্য হ'তে"],["وَقَالَ","waqāla","And said","এবং বললো"],["ٱلْكَـٰفِرُونَ","l-kāfirūna","the disbelievers","কাফিররা"],["هَـٰذَا","hādhā","This","\"এই (ব্যক্তি)"],["سَـٰحِرٌۭ","sāḥirun","(is) a magician","যাদুকর"],["كَذَّابٌ","kadhābun","a liar","বড় মিথ্যাবাদী"]],"t":"وَعَجِ<o>بُوٓ</><s>ا۟</> أَ<k>ن جَ</><o>آ</>ءَ<y>هُم مُّ</><k>نذِ</><d>رٌۭ مِّ</>نْهُمْ ۖ وَقَالَ <h>ٱ</>لْ<m>كَٰ</>فِرُونَ <m>هَٰ</>ذَا <m>سَٰ</>حِ<k>رٌۭ كَ</><p>ذَّا</><q>بٌ</>"},{"n":5,"w":[["أَجَعَلَ","aja‘ala","Has he made","সাব্যস্ত করেছে কি সে"],["ٱلْـَٔالِهَةَ","l-ālihata","the gods","সব উপাস্যকে"],["إِلَـٰهًۭا","ilāhan","(into) one god","ইলাহ"],["وَٰحِدًا ۖ","wāḥidan","(into) one god","একই"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["هَـٰذَا","hādhā","this","এটা"],["لَشَىْءٌ","lashayon","(is) certainly a thing","অবশ্যই ব্যাপার"],["عُجَابٌۭ","‘ujābun","curious","আজব\""]],"t":"أَجَعَلَ <h>ٱ</>لْءَالِهَةَ إِ<m>لَٰ</><d>هًۭا وَٰ</>حِدًا ۖ إِ<g>نَّ</> <m>هَٰ</>ذَا لَشَىْءٌ عُ<p>جَا</><q>بٌۭ</>"},{"n":6,"w":[["وَٱنطَلَقَ","wa-inṭalaqa","And went forth","এবং সরে পড়লো"],["ٱلْمَلَأُ","l-mala-u","the chiefs","প্রধানেরা"],["مِنْهُمْ","min'hum","among them","তাদের মধ্যকার"],["أَنِ","ani","that","(এই বলে) যে,"],["ٱمْشُوا۟","im'shū","Continue","\"তোমরা চলে যাও"],["وَٱصْبِرُوا۟","wa-iṣ'birū","and be patient","ও তোমরা অবিচল থাকো"],["عَلَىٰٓ","‘alā","over","উপর"],["ءَالِهَتِكُمْ ۖ","ālihatikum","your gods","তোমাদের উপাস্যদের (উপাসনায়)"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["هَـٰذَا","hādhā","this","এই"],["لَشَىْءٌۭ","lashayon","(is) certainly a thing","ব্যাপার অবশ্যই"],["يُرَادُ","yurādu","intended","উদ্দেশ্যমূলক"]],"t":"وَ<h>ٱ</><k>نطَ</>لَقَ <h>ٱ</>لْمَلَأُ مِنْهُمْ أَنِ <h>ٱ</>مْشُو<s>ا۟</> وَ<h>ٱ</>صْبِرُو<s>ا۟</> عَلَ<o>ىٰٓ</> ءَالِهَتِكُمْ ۖ إِ<g>نَّ</> <m>هَٰ</>ذَا لَ<d>شَىْءٌۭ يُ</><p>رَا</><q>دُ</>"},{"n":7,"w":[["مَا","mā","Not","না"],["سَمِعْنَا","sami‘'nā","we heard","আমরা শুনেছি"],["بِهَـٰذَا","bihādhā","of this","এ সম্পর্কে"],["فِى","fī","in","মধ্যে"],["ٱلْمِلَّةِ","l-milati","the religion","জাতি-ধর্মগুলোতে"],["ٱلْـَٔاخِرَةِ","l-ākhirati","the last","(অতীতের) অন্যান্য"],["إِنْ","in","Not","নয়"],["هَـٰذَآ","hādhā","(is) this","এটা"],["إِلَّا","illā","but","ব্যতীত"],["ٱخْتِلَـٰقٌ","ikh'tilāqun","a fabrication","মনগড়া কথা"]],"t":"مَا سَمِعْنَا بِ<m>هَٰ</>ذَا فِى <h>ٱ</>لْمِلَّةِ <h>ٱ</>لْءَاخِرَةِ إِنْ <m>هَٰ</><o>ذَآ</> إِلَّا <h>ٱ</>خْتِ<p>لَٰ</><q>قٌ</>"},{"n":8,"w":[["أَءُنزِلَ","a-unzila","Has been revealed","কি অবতরণ করা হয়েছে"],["عَلَيْهِ","‘alayhi","to him","তার উপর"],["ٱلذِّكْرُ","l-dhik'ru","the Message","কোরআন (কিতাব)"],["مِنۢ","min","from","হ'তে"],["بَيْنِنَا ۚ","bayninā","among us","আমাদের মধ্যে\""],["بَلْ","bal","Nay","বরং"],["هُمْ","hum","They","তারা"],["فِى","fī","(are) in","মধ্যে (আছে)"],["شَكٍّۢ","shakkin","doubt","সন্দেহের"],["مِّن","min","about","সম্পর্কে"],["ذِكْرِى ۖ","dhik'rī","My Message","আমার কোরআন (অর্থাৎ কিতাব)"],["بَل","bal","Nay","বরং"],["لَّمَّا","lammā","not yet","করে নি"],["يَذُوقُوا۟","yadhūqū","they have tasted","তারা স্বাদ গ্রহণ"],["عَذَابِ","‘adhābi","My punishment","আমার শাস্তির"]],"t":"أَءُ<k>نزِ</>لَ عَلَيْهِ <h>ٱ</><l>ل</>ذِّكْرُ <i>مِنۢ بَ</>يْنِنَا ۚ بَلْ هُمْ فِى شَ<d>كٍّۢ مِّ</><k>ن ذِ</>كْرِى ۖ بَل لَّ<g>مَّ</>ا يَذُوقُو<s>ا۟</> عَ<p>ذَا</><q>بِ</>"},{"n":9,"w":[["أَمْ","am","Or","তবে কি"],["عِندَهُمْ","‘indahum","have they","কাছে আছে তাদের"],["خَزَآئِنُ","khazāinu","(the) treasures","ভান্ডারসমূহ"],["رَحْمَةِ","raḥmati","(of the) Mercy","অনুগ্রহের"],["رَبِّكَ","rabbika","(of) your Lord","তোমার রবের"],["ٱلْعَزِيزِ","l-‘azīzi","the All-Mighty","(যিনি) পরাক্রমশালী"],["ٱلْوَهَّابِ","l-wahābi","the Bestower","মহান দাতা"]],"t":"أَمْ عِ<k>ندَ</>هُمْ خَ<o>زَآ</>ئِنُ رَحْمَةِ رَبِّكَ <h>ٱ</>لْعَزِيزِ <h>ٱ</>لْوَ<p>هَّا</><q>بِ</>"},{"n":10,"w":[["أَمْ","am","Or","না কি"],["لَهُم","lahum","for them","তাদের আছে"],["مُّلْكُ","mul'ku","(is the) dominion","সার্বভৌমত্ব"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশের"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীর"],["وَمَا","wamā","and whatever","এবং যা (আছে)"],["بَيْنَهُمَا ۖ","baynahumā","(is) between them","তাদের উভয়ের মাঝে"],["فَلْيَرْتَقُوا۟","falyartaqū","Then let them ascend","তারা আরোহণ করুক তাহ'লে"],["فِى","fī","by","সাহায্যে"],["ٱلْأَسْبَـٰبِ","l-asbābi","the means","(উচ্চজগতের) সিঁড়ির"]],"t":"أَمْ لَ<y>هُم مُّ</>لْكُ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ وَمَا بَيْنَهُمَا ۖ فَلْيَرْتَقُو<s>ا۟</> فِى <h>ٱ</>لْأَسْ<p>بَٰ</><q>بِ</>"},{"n":11,"w":[["جُندٌۭ","jundun","Soldiers ","(এটা তো) একটি বাহিনী"],["مَّا","mā","there","যা"],["هُنَالِكَ","hunālika","there","এখানেই (মাক্কায়)"],["مَهْزُومٌۭ","mahzūmun","(they will be) defeated","পরাজিত হবে"],["مِّنَ","mina","among","মধ্য হ'তে"],["ٱلْأَحْزَابِ","l-aḥzābi","the companies","(অনেকগুলো) বহু বাহিনীর"]],"t":"جُن<d>دٌۭ مَّ</>ا هُنَالِكَ مَهْزُو<d>مٌۭ مِّ</>نَ <h>ٱ</>لْأَحْ<p>زَا</><q>بِ</>"},{"n":12,"w":[["كَذَّبَتْ","kadhabat","Denied","মিথ্যারোপ করেছিলো"],["قَبْلَهُمْ","qablahum","before them","তাদের পূর্বে"],["قَوْمُ","qawmu","(the) people","জাতি"],["نُوحٍۢ","nūḥin","(of) Nuh","নূহের"],["وَعَادٌۭ","wa‘ādun","and Aad","ও আ'দ"],["وَفِرْعَوْنُ","wafir'‘awnu","and Firaun","ও ফিরআউনের"],["ذُو","dhū","(the) owner","অধিপতি"],["ٱلْأَوْتَادِ","l-awtādi","(of) the stakes","কিলক ও স্তম্ভসমূহের"]],"t":"كَذَّبَتْ قَ<q>بْ</>لَهُمْ قَوْمُ نُو<d>حٍۢ وَ</>عَا<d>دٌۭ وَ</>فِرْعَوْنُ ذُو <h>ٱ</>لْأَوْ<p>تَا</><q>دِ</>"},{"n":13,"w":[["وَثَمُودُ","wathamūdu","And Thamud","ও সামূদ"],["وَقَوْمُ","waqawmu","and (the) people","ও জাতি"],["لُوطٍۢ","lūṭin","(of) Lut","লূতের"],["وَأَصْحَـٰبُ","wa-aṣḥābu","and (the) companions","ও অধিবাসী"],["لْـَٔيْكَةِ ۚ","al'aykati","(of) the wood","আইকা’র"],["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐ সবই (ছিলো)"],["ٱلْأَحْزَابُ","l-aḥzābu","(were) the companies","(বিশাল) সম্মিলিত বাহিনী"]],"t":"وَثَمُودُ وَقَوْمُ لُو<d>طٍۢ وَ</>أَصْ<m>حَٰ</>بُ لْـَٔيْكَةِ ۚ أُ<s>و۟</><o>لَٰٓ</>ئِكَ <h>ٱ</>لْأَحْ<p>زَا</><q>بُ</>"},{"n":14,"w":[["إِن","in","Not","না"],["كُلٌّ","kullun","all (of them)","কেউই (ছিলো)"],["إِلَّا","illā","but","এ ব্যতীত যে"],["كَذَّبَ","kadhaba","denied","মিথ্যারোপ করতো"],["ٱلرُّسُلَ","l-rusula","the Messengers","রাসূলগণকে"],["فَحَقَّ","faḥaqqa","so (was) just","অতঃপর কার্যকর হয়েছিলো"],["عِقَابِ","‘iqābi","My penalty","আমার শাস্তি"]],"t":"إِ<k>ن كُ</>لٌّ إِلَّا كَذَّبَ <h>ٱ</><l>ل</>رُّسُلَ فَحَقَّ عِ<p>قَا</><q>بِ</>"},{"n":15,"w":[["وَمَا","wamā","And not","এবং না"],["يَنظُرُ","yanẓuru","await","অপেক্ষা করছে"],["هَـٰٓؤُلَآءِ","hāulāi","these","এই সব (লোক)"],["إِلَّا","illā","but","এ ব্যতীত"],["صَيْحَةًۭ","ṣayḥatan","a shout","মহা গর্জনের"],["وَٰحِدَةًۭ","wāḥidatan","one","একটি (মাত্র)"],["مَّا","mā","not","না"],["لَهَا","lahā","for it","তার জন্যে (থাকবে)"],["مِن","min","any","কোনো"],["فَوَاقٍۢ","fawāqin","delay","দম ফেলার অবকাশ"]],"t":"وَمَا يَ<k>نظُ</>رُ <o>هَٰٓؤُلَآ</>ءِ إِلَّا صَيْحَ<d>ةًۭ وَٰ</>حِدَ<d>ةًۭ مَّ</>ا لَهَا مِ<k>ن فَ</><p>وَا</><q>قٍۢ</>"},{"n":16,"w":[["وَقَالُوا۟","waqālū","And they say","ও তারা বলে"],["رَبَّنَا","rabbanā","Our Lord","\"হে আমাদের রব"],["عَجِّل","‘ajjil","Hasten","শীঘ্র দাও"],["لَّنَا","lanā","for us","আমাদের জন্যে"],["قِطَّنَا","qiṭṭanā","our share","আমাদের পাওনা"],["قَبْلَ","qabla","before","পূর্বেই"],["يَوْمِ","yawmi","(the) Day","দিনের"],["ٱلْحِسَابِ","l-ḥisābi","(of) the Account","বিচারের\""]],"t":"وَقَالُو<s>ا۟</> رَبَّنَا عَجِّل لَّنَا قِطَّنَا قَ<q>بْ</>لَ يَوْمِ <h>ٱ</>لْحِ<p>سَا</><q>بِ</>"},{"n":17,"w":[["ٱصْبِرْ","iṣ'bir","Be patient","(হে নাবী) ধৈর্য্য ধরো"],["عَلَىٰ","‘alā","over","উপর"],["مَا","mā","what","যা"],["يَقُولُونَ","yaqūlūna","they say","তারা বলছে"],["وَٱذْكُرْ","wa-udh'kur","and remember","এবং স্মরণ করো"],["عَبْدَنَا","‘abdanā","Our slave","আমাদের দাস"],["دَاوُۥدَ","dāwūda","Dawood","দাউদের (ঘটনা)"],["ذَا","dhā","the possessor of strength","অধিকারী"],["ٱلْأَيْدِ ۖ","l-aydi","the possessor of strength","(যে ছিলো) শক্তির"],["إِنَّهُۥٓ","innahu","Indeed, he (was)","নিশ্চয়ই সে (ছিলো)"],["أَوَّابٌ","awwābun","repeatedly turning","(আল্লাহ) অভিমুখী"]],"t":"ٱصْبِرْ عَلَىٰ مَا يَقُولُونَ وَ<h>ٱ</>ذْكُرْ عَ<q>بْ</>دَنَا دَاوُ<m>ۥ</>دَ ذَا <h>ٱ</>لْأَيْدِ ۖ إِ<g>نَّ</>هُ<o>ۥٓ</> أَ<p>وَّا</><q>بٌ</>"},{"n":18,"w":[["إِنَّا","innā","Indeed, We","নিশ্চযই় আমরা"],["سَخَّرْنَا","sakharnā","subjected","আমরা বশ করে দিয়েছিলাম"],["ٱلْجِبَالَ","l-jibāla","the mountains","পাহাড়সমূহকে"],["مَعَهُۥ","ma‘ahu","with him","তার সাথে"],["يُسَبِّحْنَ","yusabbiḥ'na","glorifying","তারা পবিত্র মহিমা ঘোষণা করতো"],["بِٱلْعَشِىِّ","bil-‘ashiyi","in the evening","সন্ধ্যায়"],["وَٱلْإِشْرَاقِ","wal-ish'rāqi","and [the] sunrise","ও সকালে"]],"t":"إِ<g>نَّ</>ا سَخَّرْنَا <h>ٱ</>لْجِبَالَ مَعَهُ<m>ۥ</> يُسَبِّحْنَ بِ<h>ٱ</>لْعَشِىِّ وَ<h>ٱ</>لْإِشْ<p>رَا</><q>قِ</>"},{"n":19,"w":[["وَٱلطَّيْرَ","wal-ṭayra","And the birds","এবং পাখিগুলো"],["مَحْشُورَةًۭ ۖ","maḥshūratan","assembled","সমবেত হতো"],["كُلٌّۭ","kullun","all","প্রত্যেকে (ছিলো)"],["لَّهُۥٓ","lahu","with him","তাঁরই"],["أَوَّابٌۭ","awwābun","repeatedly turning","অভিমুখী (ও অনুগত)"]],"t":"وَ<h>ٱ</><l>ل</>طَّيْرَ مَحْشُورَ<k>ةًۭ ۖ كُ</><w>لٌّۭ لَّ</>هُ<o>ۥٓ</> أَ<p>وَّا</><q>بٌۭ</>"},{"n":20,"w":[["وَشَدَدْنَا","washadadnā","And We strengthened","এবং আমরা সুদৃঢ় করেছিলাম"],["مُلْكَهُۥ","mul'kahu","his kingdom","তার রাজত্বকে"],["وَءَاتَيْنَـٰهُ","waātaynāhu","and We gave him","এবং তাকে আমরা দিয়েছিলাম"],["ٱلْحِكْمَةَ","l-ḥik'mata","[the] wisdom","প্রজ্ঞা"],["وَفَصْلَ","wafaṣla","and decisive","ও চূড়ান্তকারী"],["ٱلْخِطَابِ","l-khiṭābi","speech","বাগ্মিতা"]],"t":"وَشَدَ<q>دْ</>نَا مُلْكَهُ<m>ۥ</> وَءَاتَيْ<m>نَٰ</>هُ <h>ٱ</>لْحِكْمَةَ وَفَصْلَ <h>ٱ</>لْخِ<p>طَا</><q>بِ</>"},{"n":21,"w":[["۞ وَهَلْ","wahal","And has (there)","এবং কি"],["أَتَىٰكَ","atāka","come to you","তোমার কাছে পৌঁছেছে"],["نَبَؤُا۟","naba-u","(the) news","খবর"],["ٱلْخَصْمِ","l-khaṣmi","(of) the litigants","বিবদমান লোকদের"],["إِذْ","idh","when","যখন"],["تَسَوَّرُوا۟","tasawwarū","they climbed over the wall","তারা দেয়াল টপকে ঢুকে পড়লো"],["ٱلْمِحْرَابَ","l-miḥ'rāba","(of) the chamber","খাসকামরায়"]],"t":"۞ وَهَلْ أَتَ<m>ىٰ</>كَ نَبَؤُ<s>ا۟</> <h>ٱ</>لْخَصْمِ إِذْ تَسَوَّرُو<s>ا۟</> <h>ٱ</>لْمِحْ<p>رَا</><q>بَ</>"},{"n":22,"w":[["إِذْ","idh","When","যখন"],["دَخَلُوا۟","dakhalū","they entered","তারা প্রবেশ করেছিলো"],["عَلَىٰ","‘alā","upon","কাছে"],["دَاوُۥدَ","dāwūda","Dawood","দাউদের"],["فَفَزِعَ","fafazi‘a","and he was afraid","সে তখন ভয় পেলো"],["مِنْهُمْ ۖ","min'hum","of them","তাদের থেকে"],["قَالُوا۟","qālū","they said","তারা বললো"],["لَا","lā","(Do) not","\"না"],["تَخَفْ ۖ","takhaf","fear","ভয় পাবেন"],["خَصْمَانِ","khaṣmāni","(We are) two litigants","(আমরা) বিবদমান  দু'পক্ষ"],["بَغَىٰ","baghā","has wronged","বাড়াবাড়ি করেছে"],["بَعْضُنَا","ba‘ḍunā","one of us","আমাদের একজন"],["عَلَىٰ","‘alā","to","উপর"],["بَعْضٍۢ","ba‘ḍin","another","অপরজনের"],["فَٱحْكُم","fa-uḥ'kum","so judge","সুতরাং বিচার করে দিন"],["بَيْنَنَا","baynanā","between us","আমাদের মাঝে"],["بِٱلْحَقِّ","bil-ḥaqi","in truth","ন্যায়ভাবে"],["وَلَا","walā","and (do) not","এবং না"],["تُشْطِطْ","tush'ṭiṭ","be unjust","অবিচার করবেন"],["وَٱهْدِنَآ","wa-ih'dinā","and guide us","এবং আমাদের পরিচালনা করবেন"],["إِلَىٰ","ilā","to","দিকে"],["سَوَآءِ","sawāi","an even","সরল সঠিক"],["ٱلصِّرَٰطِ","l-ṣirāṭi","[the] path","পথের"]],"t":"إِذْ دَخَلُو<s>ا۟</> عَلَىٰ دَاوُ<m>ۥ</>دَ فَفَزِعَ مِنْهُمْ ۖ قَالُو<s>ا۟</> لَا تَخَفْ ۖ خَصْمَانِ بَغَىٰ بَعْضُنَا عَلَىٰ بَعْ<k>ضٍۢ فَ</><h>ٱ</>حْ<f>كُم بَ</>يْنَنَا بِ<h>ٱ</>لْحَقِّ وَلَا تُشْطِ<q>طْ</> وَ<h>ٱ</>هْدِ<o>نَآ</> إِلَىٰ سَ<o>وَآ</>ءِ <h>ٱ</><l>ل</>صِّ<p>رَٰ</><q>طِ</>"},{"n":23,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["هَـٰذَآ","hādhā","this","এই"],["أَخِى","akhī","(is) my brother","আমার ভাই"],["لَهُۥ","lahu","he has","তার আছে"],["تِسْعٌۭ","tis'‘un","ninety-nine","নয়"],["وَتِسْعُونَ","watis'‘ūna","ninety-nine","এবং নব্বই (অর্থাৎ নিরানব্বইটি)"],["نَعْجَةًۭ","na‘jatan","ewe(s)","দুম্বী"],["وَلِىَ","waliya","while I have","ও আমার আছে"],["نَعْجَةٌۭ","na‘jatun","ewe","দুম্বী"],["وَٰحِدَةٌۭ","wāḥidatun","one","একটি"],["فَقَالَ","faqāla","so he said","তবুও সে বললো"],["أَكْفِلْنِيهَا","akfil'nīhā","Entrust her to me","\"তা আমার দায়িত্বে দাও\""],["وَعَزَّنِى","wa‘azzanī","and he overpowered me","এবং সে আমাকে পরাস্ত করে ফেললো"],["فِى","fī","in","মধ্যে"],["ٱلْخِطَابِ","l-khiṭābi","[the] speech","কথাবার্তার\""]],"t":"إِ<g>نَّ</> <m>هَٰ</><o>ذَآ</> أَخِى لَهُ<m>ۥ</> تِسْ<d>عٌۭ وَ</>تِسْعُونَ نَعْجَ<d>ةًۭ وَ</>لِىَ نَعْجَ<d>ةٌۭ وَٰ</>حِدَ<k>ةٌۭ فَ</>قَالَ أَكْفِلْنِيهَا وَعَزَّنِى فِى <h>ٱ</>لْخِ<p>طَا</><q>بِ</>"},{"n":24,"w":[["قَالَ","qāla","He said","সে বললো"],["لَقَدْ","laqad","Certainly","\"নিশ্চয়ই"],["ظَلَمَكَ","ẓalamaka","he has wronged you","অবিচার করেছে তোমার উপর"],["بِسُؤَالِ","bisuāli","by demanding","(যোগ করার) দাবীর কারণে"],["نَعْجَتِكَ","na‘jatika","your ewe","তোমার দুম্বী"],["إِلَىٰ","ilā","to","সাথে"],["نِعَاجِهِۦ ۖ","ni‘ājihi","his ewes","তার দুম্বীগুলোর"],["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["كَثِيرًۭا","kathīran","many","অনেকেই"],["مِّنَ","mina","of","মধ্য হ'তে"],["ٱلْخُلَطَآءِ","l-khulaṭāi","the partners","শরিকদের"],["لَيَبْغِى","layabghī","certainly oppress","বাড়াবাড়ি করে অবশ্যই"],["بَعْضُهُمْ","ba‘ḍuhum","some of them","তাদের একে"],["عَلَىٰ","‘alā","[on]","উপর"],["بَعْضٍ","ba‘ḍin","another","অন্যের"],["إِلَّا","illā","except","(তবে) ব্যতিক্রম"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান আনে"],["وَعَمِلُوا۟","wa‘amilū","and do","ও কাজ করে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","righteous deeds","সৎকর্মসমূহ"],["وَقَلِيلٌۭ","waqalīlun","and few","এবং খুব কম (সংখ্যায়)"],["مَّا","mā","(are) they","যা\""],["هُمْ ۗ","hum","(are) they","তারা\""],["وَظَنَّ","waẓanna","And became certain","এবং তখনই বুঝতে পারলো"],["دَاوُۥدُ","dāwūdu","Dawood","দাউদ"],["أَنَّمَا","annamā","that","যে আসলে"],["فَتَنَّـٰهُ","fatannāhu","We (had) tried him","তাকে আমরা পরীক্ষা করেছি"],["فَٱسْتَغْفَرَ","fa-is'taghfara","and he asked forgiveness","সে ক্ষমা চাইলো তখন"],["رَبَّهُۥ","rabbahu","(of) his Lord","তার রবের কাছে"],["وَخَرَّ","wakharra","and fell down","এবং লুটিয়ে পড়লো"],["رَاكِعًۭا","rāki‘an","bowing","এবং রুকূতে (সিজদায়)"],["وَأَنَابَ ۩","wa-anāba","and turned in repentance","এবং সে (আল্লাহ) অভিমুখী হলো"]],"t":"قَالَ لَقَ<q>دْ</> ظَلَمَكَ بِسُؤَالِ نَعْجَتِكَ إِلَىٰ نِعَاجِ<m>هِۦ</> ۖ وَإِ<g>نَّ</> كَثِي<d>رًۭا مِّ</>نَ <h>ٱ</>لْخُلَ<o>طَآ</>ءِ لَيَ<q>بْ</>غِى بَعْضُهُمْ عَلَىٰ بَعْضٍ إِلَّا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ وَقَلِي<d>لٌۭ مَّ</>ا هُمْ ۗ وَظَ<g>نَّ</> دَاوُ<m>ۥ</>دُ أَ<g>نَّ</>مَا فَتَ<g>نَّٰ</>هُ فَ<h>ٱ</>سْتَغْفَرَ رَبَّهُ<m>ۥ</> وَخَرَّ رَاكِ<d>عًۭا وَ</>أَنَ<p>ا</><q>بَ</> ۩"},{"n":25,"w":[["فَغَفَرْنَا","faghafarnā","So We forgave","আমরা তখন মাফ করলাম"],["لَهُۥ","lahu","for him","তাকে"],["ذَٰلِكَ ۖ","dhālika","that","সেই (অপরাধ)"],["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["لَهُۥ","lahu","for him","তার জন্যে"],["عِندَنَا","‘indanā","with Us","আমাদের কাছে আছে"],["لَزُلْفَىٰ","lazul'fā","surely is a near access","অবশ্যই নৈকট্যের মর্যাদা"],["وَحُسْنَ","waḥus'na","and a good","ও সুন্দর"],["مَـَٔابٍۢ","maābin","place of return","পরিণাম"]],"t":"فَغَفَرْنَا لَهُ<m>ۥ ذَٰ</>لِكَ ۖ وَإِ<g>نَّ</> لَهُ<m>ۥ</> عِ<k>ندَ</>نَا لَزُلْفَىٰ وَحُسْنَ <p>مَـَٔا</><q>بٍۢ</>"},{"n":26,"w":[["يَـٰدَاوُۥدُ","yādāwūdu","O Dawood","\"(আল্লাহ বললেন) হে দাউদ"],["إِنَّا","innā","Indeed, We","নিশ্চযই় আমরা"],["جَعَلْنَـٰكَ","ja‘alnāka","[We] have made you","তোমাকে আমরা বানিয়েছি"],["خَلِيفَةًۭ","khalīfatan","a vicegerent","প্রতিনিধি"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["فَٱحْكُم","fa-uḥ'kum","so judge","সুতরাং শাসন করো"],["بَيْنَ","bayna","between","মাঝে"],["ٱلنَّاسِ","l-nāsi","[the] men","মানুষের"],["بِٱلْحَقِّ","bil-ḥaqi","in truth","ন্যায়ভাবে"],["وَلَا","walā","and (do) not","এবং না"],["تَتَّبِعِ","tattabi‘i","follow","অনুসরণ করো"],["ٱلْهَوَىٰ","l-hawā","the desire","খেয়ালখুশীর"],["فَيُضِلَّكَ","fayuḍillaka","for it will lead you astray","তোমাকে তা হ'লে সরিয়ে দিবে"],["عَن","‘an","from","হ'তে"],["سَبِيلِ","sabīli","(the) way","পথ"],["ٱللَّهِ ۚ","l-lahi","(of) Allah","আল্লাহর"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["يَضِلُّونَ","yaḍillūna","go astray","বিভ্রান্ত হয়"],["عَن","‘an","from","হ'তে"],["سَبِيلِ","sabīli","(the) way","পথ"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["لَهُمْ","lahum","for them","তাদের জন্যে (রয়েছে)"],["عَذَابٌۭ","‘adhābun","(is) a punishment","শাস্তি"],["شَدِيدٌۢ","shadīdun","severe","কঠোর"],["بِمَا","bimā","because","একারণে যে"],["نَسُوا۟","nasū","they forgot","তারা ভুলে গিয়েছে"],["يَوْمَ","yawma","(the) Day","দিন"],["ٱلْحِسَابِ","l-ḥisābi","(of) Account","বিচারের\""]],"t":"<m>يَٰ</>دَاوُ<m>ۥ</>دُ إِ<g>نَّ</>ا جَعَلْ<m>نَٰ</>كَ خَلِيفَ<k>ةًۭ فِ</>ى <h>ٱ</>لْأَرْضِ فَ<h>ٱ</>حْ<f>كُم بَ</>يْنَ <h>ٱ</><l>ل</><g>نَّ</>اسِ بِ<h>ٱ</>لْحَقِّ وَلَا تَتَّبِعِ <h>ٱ</>لْهَوَىٰ فَيُضِلَّكَ عَ<k>ن سَ</>بِيلِ <h>ٱ</>للَّهِ ۚ إِ<g>نَّ</> <h>ٱ</>لَّذِينَ يَضِلُّونَ عَ<k>ن سَ</>بِيلِ <h>ٱ</>للَّهِ لَهُمْ عَذَا<k>بٌۭ شَ</>دِي<i>دٌۢ بِ</>مَا نَسُو<s>ا۟</> يَوْمَ <h>ٱ</>لْحِ<p>سَا</><q>بِ</>"},{"n":27,"w":[["وَمَا","wamā","And not","এবং না"],["خَلَقْنَا","khalaqnā","We created","আমরা সৃষ্টি করেছি"],["ٱلسَّمَآءَ","l-samāa","the heaven","আকাশকে"],["وَٱلْأَرْضَ","wal-arḍa","and the earth","ও পৃৃথিবীকে"],["وَمَا","wamā","and whatever","এবং যা (আছে)"],["بَيْنَهُمَا","baynahumā","(is) between them","উভয়ের মাঝে"],["بَـٰطِلًۭا ۚ","bāṭilan","without purpose","অনর্থক"],["ذَٰلِكَ","dhālika","That","সেটা"],["ظَنُّ","ẓannu","(is the) assumption","ধারণা"],["ٱلَّذِينَ","alladhīna","(of) those who","(তাদের) যারা"],["كَفَرُوا۟ ۚ","kafarū","disbelieve","অস্বীকার করেছে"],["فَوَيْلٌۭ","fawaylun","So woe","দুর্ভোগ সুতরাং"],["لِّلَّذِينَ","lilladhīna","to those","(তাদের) জন্যে যারা"],["كَفَرُوا۟","kafarū","who disbelieve","অস্বীকার করেছে"],["مِنَ","mina","from","হ'তে"],["ٱلنَّارِ","l-nāri","the Fire","(জাহান্নামের) আগুনের"]],"t":"وَمَا خَلَ<q>قْ</>نَا <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءَ وَ<h>ٱ</>لْأَرْضَ وَمَا بَيْنَهُمَا <m>بَٰ</>طِلًۭ<k>ا ۚ ذَٰ</>لِكَ ظَ<g>نُّ</> <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟ ۚ</> فَوَيْ<w>لٌۭ لِّ</>لَّذِينَ كَفَرُو<s>ا۟</> مِنَ <h>ٱ</><l>ل</><g>نَّ</><p>ا</>رِ"},{"n":28,"w":[["أَمْ","am","Or","কি"],["نَجْعَلُ","naj‘alu","should We treat","গণ্য করবো আমরা"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["وَعَمِلُوا۟","wa‘amilū","and do","ও কাজ করেছে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","righteous deeds","সৎকর্মসমূহ"],["كَٱلْمُفْسِدِينَ","kal-muf'sidīna","like those who spread corruption","মতো বিপর্যয় সৃষ্টিকারীদের"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["أَمْ","am","Or","কি"],["نَجْعَلُ","naj‘alu","should We treat","গণ্য করবো আমরা"],["ٱلْمُتَّقِينَ","l-mutaqīna","the pious","মুত্তাকীদেরকে"],["كَٱلْفُجَّارِ","kal-fujāri","like the wicked","পাপাচারীদের মতো"]],"t":"أَمْ نَ<q>جْ</>عَلُ <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ كَ<h>ٱ</>لْمُفْسِدِينَ فِى <h>ٱ</>لْأَرْضِ أَمْ نَ<q>جْ</>عَلُ <h>ٱ</>لْمُتَّقِينَ كَ<h>ٱ</>لْفُ<p>جَّا</>رِ"},{"n":29,"w":[["كِتَـٰبٌ","kitābun","(This is) a Book","(হে নাবী) এই কিতাব"],["أَنزَلْنَـٰهُ","anzalnāhu","We have revealed it","তা আমরা অবতীর্ণ করেছি"],["إِلَيْكَ","ilayka","to you","তোমার প্রতি"],["مُبَـٰرَكٌۭ","mubārakun","blessed","কল্যাণকর (কিতাব)"],["لِّيَدَّبَّرُوٓا۟","liyaddabbarū","that they may ponder","তারা চিন্তাভাবনা করে যেন"],["ءَايَـٰتِهِۦ","āyātihi","(over) its Verses","তাঁর আয়াতসমূহকে"],["وَلِيَتَذَكَّرَ","waliyatadhakkara","and may be reminded","এবং উপদেশ নেয় যেন"],["أُو۟لُوا۟","ulū","those of understanding","সম্পন্নরা"],["ٱلْأَلْبَـٰبِ","l-albābi","those of understanding","বুদ্ধি-জ্ঞান"]],"t":"كِ<m>تَٰ</>بٌ أَ<k>نزَ</>لْ<m>نَٰ</>هُ إِلَيْكَ مُ<m>بَٰ</>رَ<w>كٌۭ لِّ</>يَدَّبَّ<o>رُوٓ</><s>ا۟</> ءَا<m>يَٰتِهِۦ</> وَلِيَتَذَكَّرَ أُ<s>و۟</>لُو<s>ا۟</> <h>ٱ</>لْأَلْ<p>بَٰ</><q>بِ</>"},{"n":30,"w":[["وَوَهَبْنَا","wawahabnā","And We gave","এবং আমরা দান করেছিলাম"],["لِدَاوُۥدَ","lidāwūda","to Dawood","দাউদের জন্য"],["سُلَيْمَـٰنَ ۚ","sulaymāna","Sulaiman","(তার পুত্র) সুলায়মানকে"],["نِعْمَ","ni‘'ma","an excellent","অতি উত্তম"],["ٱلْعَبْدُ ۖ","l-‘abdu","slave","দাস"],["إِنَّهُۥٓ","innahu","Indeed, he","সে নিশ্চযই় (ছিলো)"],["أَوَّابٌ","awwābun","(was) one who repeatedly turned","অতিশয় (আল্লাহ) অভিমুখী"]],"t":"وَوَهَ<q>بْ</>نَا لِدَاوُ<m>ۥ</>دَ سُلَيْ<m>مَٰ</>نَ ۚ نِعْمَ <h>ٱ</>لْعَ<q>بْ</>دُ ۖ إِ<g>نَّ</>هُ<o>ۥٓ</> أَ<p>وَّا</><q>بٌ</>"},{"n":31,"w":[["إِذْ","idh","When","(স্মরণ করো) যখন"],["عُرِضَ","‘uriḍa","were displayed","উপস্হিত করা হলো"],["عَلَيْهِ","‘alayhi","to him","তার সামনে"],["بِٱلْعَشِىِّ","bil-‘ashiyi","in the afternoon","সন্ধ্যায়"],["ٱلصَّـٰفِنَـٰتُ","l-ṣāfinātu","excellent bred steeds","দ্রুতগামী ঘোড়াসমূহ"],["ٱلْجِيَادُ","l-jiyādu","excellent bred steeds","উৎকৃষ্টমানের (ঘোড়া)"]],"t":"إِذْ عُرِضَ عَلَيْهِ بِ<h>ٱ</>لْعَشِىِّ <h>ٱ</><l>ل</><m>صَّٰفِنَٰ</>تُ <h>ٱ</>لْجِ<p>يَا</><q>دُ</>"},{"n":32,"w":[["فَقَالَ","faqāla","And he said","তখন সে বললো"],["إِنِّىٓ","innī","Indeed, I","\"নিশ্চয়ই আমি"],["أَحْبَبْتُ","aḥbabtu","[I] preferred","আমি ভালোবেসেছি"],["حُبَّ","ḥubba","(the) love","ভালোবাসা"],["ٱلْخَيْرِ","l-khayri","(of) the good","(এই) সম্পদের"],["عَن","‘an","over","কারণে"],["ذِكْرِ","dhik'ri","(the) remembrance","স্মরণের"],["رَبِّى","rabbī","(of) my Lord","আমার রবের\""],["حَتَّىٰ","ḥattā","Until","এমনকি (যখন)"],["تَوَارَتْ","tawārat","they were hidden","অদৃশ্য হয়ে গেলো"],["بِٱلْحِجَابِ","bil-ḥijābi","in the veil","(চোখের) আড়ালে"]],"t":"فَقَالَ إِ<g>نِّ</><o>ىٓ</> أَحْبَ<q>بْ</>تُ حُبَّ <h>ٱ</>لْخَيْرِ عَ<k>ن ذِ</>كْرِ رَبِّى حَتَّىٰ تَوَارَتْ بِ<h>ٱ</>لْحِ<p>جَا</><q>بِ</>"},{"n":33,"w":[["رُدُّوهَا","ruddūhā","Return them","\"(সে বললো) সেগুলো ফিরিয়ে আনো"],["عَلَىَّ ۖ","‘alayya","to me","আমার কাছে\""],["فَطَفِقَ","faṭafiqa","Then he began","সে অতঃপর শুরু করলো"],["مَسْحًۢا","masḥan","(to) pass (his hand)","(হাত) বুলাতে"],["بِٱلسُّوقِ","bil-sūqi","over the legs","(ঘোড়ার) পাগুলোর উপর"],["وَٱلْأَعْنَاقِ","wal-a‘nāqi","and the necks","ও ঘাড়ে"]],"t":"رُدُّوهَا عَلَىَّ ۖ فَطَفِقَ مَسْ<i>حًۢا بِ</><h>ٱ</><l>ل</>سُّوقِ وَ<h>ٱ</>لْأَعْ<p>نَا</><q>قِ</>"},{"n":34,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["فَتَنَّا","fatannā","We tried","আমরা পরীক্ষা করেছিলাম"],["سُلَيْمَـٰنَ","sulaymāna","Sulaiman","সুলায়মানকে"],["وَأَلْقَيْنَا","wa-alqaynā","and We placed","ও আমরা রেখে দিলাম"],["عَلَىٰ","‘alā","on","উপর"],["كُرْسِيِّهِۦ","kur'siyyihi","his throne","তার আসনের"],["جَسَدًۭا","jasadan","a body","একটি দেহ"],["ثُمَّ","thumma","then","অতঃপর"],["أَنَابَ","anāba","he turned","সে মুখ ফেরালো"]],"t":"وَلَقَ<q>دْ</> فَتَ<g>نَّ</>ا سُلَيْ<m>مَٰ</>نَ وَأَلْقَيْنَا عَلَىٰ كُرْسِيِّ<m>هِۦ</> جَسَ<k>دًۭا ثُ</><g>مَّ</> أَ<p>نَا</><q>بَ</>"},{"n":35,"w":[["قَالَ","qāla","He said","সে বললো"],["رَبِّ","rabbi","O my Lord","\"হে আমার রব"],["ٱغْفِرْ","igh'fir","Forgive","মাফ করো"],["لِى","lī","me","আমাকে"],["وَهَبْ","wahab","and grant","ও দাও"],["لِى","lī","me","আমাকে"],["مُلْكًۭا","mul'kan","a kingdom","(এমন) রাজত্ব"],["لَّا","lā","not","না"],["يَنۢبَغِى","yanbaghī","(will) belong","শোভনীয় হবে (যা)"],["لِأَحَدٍۢ","li-aḥadin","to anyone","কারও জন্যে"],["مِّنۢ","min","after me","থেকে"],["بَعْدِىٓ ۖ","ba‘dī","after me","আমার পরে"],["إِنَّكَ","innaka","Indeed, You","তুমি নিশ্চয়ই"],["أَنتَ","anta","[You]","তুমিই"],["ٱلْوَهَّابُ","l-wahābu","(are) the Bestower","মহাদাতা\""]],"t":"قَالَ رَبِّ <h>ٱ</>غْفِرْ لِى وَهَ<q>بْ</> لِى مُلْ<w>كًۭا لَّ</>ا يَ<i>نۢبَ</>غِى لِأَحَ<d>دٍۢ مِّ</><i>نۢ بَ</>عْ<o>دِىٓ ۖ</> إِ<g>نَّ</>كَ أَ<k>نتَ</> <h>ٱ</>لْوَ<p>هَّا</><q>بُ</>"},{"n":36,"w":[["فَسَخَّرْنَا","fasakharnā","Then We subjected","আমরা তখন অধীন করে দিলাম"],["لَهُ","lahu","to him","তার জন্যে"],["ٱلرِّيحَ","l-rīḥa","the wind","বাতাসকে"],["تَجْرِى","tajrī","to flow","বয়ে যেতো"],["بِأَمْرِهِۦ","bi-amrihi","by his command","তার আদেশে"],["رُخَآءً","rukhāan","gently","গতিতে"],["حَيْثُ","ḥaythu","wherever","যেখানে"],["أَصَابَ","aṣāba","he directed","তিনি চাইতেন"]],"t":"فَسَخَّرْنَا لَهُ <h>ٱ</><l>ل</>رِّيحَ تَ<q>جْ</>رِى بِأَمْرِ<m>هِۦ</> رُ<o>خَآ</>ءً حَيْثُ أَ<p>صَا</><q>بَ</>"},{"n":37,"w":[["وَٱلشَّيَـٰطِينَ","wal-shayāṭīna","And the devils","এবং শয়তানগুলোকেও (অধীন করেছিলাম)"],["كُلَّ","kulla","every","প্রত্যেকে (যারা ছিলো)"],["بَنَّآءٍۢ","bannāin","builder","স্হপতি"],["وَغَوَّاصٍۢ","waghawwāṣin","and diver","ও ডুবুরী"]],"t":"وَ<h>ٱ</><l>ل</>شَّ<m>يَٰ</>طِينَ كُلَّ بَ<g>نَّ</><o>آ</><d>ءٍۢ وَ</>غَ<p>وَّا</>صٍۢ"},{"n":38,"w":[["وَءَاخَرِينَ","waākharīna","And others","এবং অন্যান্যদেরকে"],["مُقَرَّنِينَ","muqarranīna","bound","আবদ্ধ (করলাম)"],["فِى","fī","in","মধ্যে"],["ٱلْأَصْفَادِ","l-aṣfādi","chains","শেকলসমূহের"]],"t":"وَءَاخَرِينَ مُقَرَّنِينَ فِى <h>ٱ</>لْأَصْ<p>فَا</><q>دِ</>"},{"n":39,"w":[["هَـٰذَا","hādhā","This","\"(আমি বললাম) এটা"],["عَطَآؤُنَا","‘aṭāunā","(is) Our gift","আমাদের দান"],["فَٱمْنُنْ","fa-um'nun","so grant","সুতরাং দান করো (যাকে চাও)"],["أَوْ","aw","or","অথবা"],["أَمْسِكْ","amsik","withhold","রেখে দাও (নিজের জন্যে)"],["بِغَيْرِ","bighayri","without","ছাড়াই"],["حِسَابٍۢ","ḥisābin","account","কোনো হিসেব\""]],"t":"<m>هَٰ</>ذَا عَ<o>طَآ</>ؤُنَا فَ<h>ٱ</>مْنُنْ أَوْ أَمْسِكْ بِغَيْرِ حِ<p>سَا</><q>بٍۢ</>"},{"n":40,"w":[["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["لَهُۥ","lahu","for him","তার জন্যে"],["عِندَنَا","‘indanā","with Us","আমাদের কাছে আছে"],["لَزُلْفَىٰ","lazul'fā","surely is a near access","অবশ্যই নৈকট্যের মর্যাদা"],["وَحُسْنَ","waḥus'na","and a good","ও সুন্দর"],["مَـَٔابٍۢ","maābin","place of return","প্রত্যাবর্তন স্থান (পরিণাম)"]],"t":"وَإِ<g>نَّ</> لَهُ<m>ۥ</> عِ<k>ندَ</>نَا لَزُلْفَىٰ وَحُسْنَ <p>مَـَٔا</><q>بٍۢ</>"},{"n":41,"w":[["وَٱذْكُرْ","wa-udh'kur","And remember","এবং স্মরণ করো"],["عَبْدَنَآ","‘abdanā","Our slave","আমাদের দাস"],["أَيُّوبَ","ayyūba","Ayyub","আইয়ূবকে"],["إِذْ","idh","when","যখন"],["نَادَىٰ","nādā","he called","সে ডেকে ছিলো"],["رَبَّهُۥٓ","rabbahu","his Lord","তার রবকে"],["أَنِّى","annī","That [I]","\"নিশ্চযই় আমি"],["مَسَّنِىَ","massaniya","(has) touched me","আমাকে স্পর্শ করেছে"],["ٱلشَّيْطَـٰنُ","l-shayṭānu","Shaitaan","শয়তান"],["بِنُصْبٍۢ","binuṣ'bin","with distress","কষ্ট দিয়ে"],["وَعَذَابٍ","wa‘adhābin","and suffering","ও যন্ত্রণায়\""]],"t":"وَ<h>ٱ</>ذْكُرْ عَ<q>بْ</>دَ<o>نَآ</> أَيُّوبَ إِذْ نَادَىٰ رَبَّهُ<o>ۥٓ</> أَ<g>نِّ</>ى مَسَّنِىَ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نُ بِنُصْ<d>بٍۢ وَ</>عَ<p>ذَا</><q>بٍ</>"},{"n":42,"w":[["ٱرْكُضْ","ur'kuḍ","Strike","\"(তাকে বললাম) আঘাত করো"],["بِرِجْلِكَ ۖ","birij'lika","with your foot","তোমার পা দিয়ে (যমীনে)"],["هَـٰذَا","hādhā","This","এটা"],["مُغْتَسَلٌۢ","mugh'tasalun","(is a spring of) water to bathe","গোসলের পানি"],["بَارِدٌۭ","bāridun","cool","ঠান্ডা"],["وَشَرَابٌۭ","washarābun","and a drink","ও সুপেয় পানীয়\""]],"t":"ٱرْكُضْ بِرِ<q>جْ</>لِكَ ۖ <m>هَٰ</>ذَا مُغْتَسَ<i>لٌۢ بَ</>ارِ<d>دٌۭ وَ</>شَ<p>رَا</><q>بٌۭ</>"},{"n":43,"w":[["وَوَهَبْنَا","wawahabnā","And We granted","এবং আমরা (ফিরিয়ে) দিলাম"],["لَهُۥٓ","lahu","[to] him","তার কাছে"],["أَهْلَهُۥ","ahlahu","his family","তার পরিবারকে"],["وَمِثْلَهُم","wamith'lahum","and a like of them","আরও তাদের মতো"],["مَّعَهُمْ","ma‘ahum","with them","তাদের সাথে"],["رَحْمَةًۭ","raḥmatan","a Mercy","অনুগ্রহ স্বরূপ"],["مِّنَّا","minnā","from Us","আমাদের থেকে"],["وَذِكْرَىٰ","wadhik'rā","and a Reminder","এবং শিক্ষা"],["لِأُو۟لِى","li-ulī","for those of understanding","সম্পন্নদের জন্যে"],["ٱلْأَلْبَـٰبِ","l-albābi","for those of understanding","বিবেক-বুদ্ধি"]],"t":"وَوَهَ<q>بْ</>نَا لَهُ<o>ۥٓ</> أَهْلَهُ<m>ۥ</> وَمِثْلَ<y>هُم مَّ</>عَهُمْ رَحْمَ<d>ةًۭ مِّ</><g>نَّ</>ا وَذِكْرَىٰ لِأُ<s>و۟</>لِى <h>ٱ</>لْأَلْ<p>بَٰ</><q>بِ</>"},{"n":44,"w":[["وَخُذْ","wakhudh","And take","\"এবং (তাকে বললাম) ধরো"],["بِيَدِكَ","biyadika","in your hand","তোমার হাত দিয়ে"],["ضِغْثًۭا","ḍigh'than","a bunch","একমুঠো ঘাস"],["فَٱضْرِب","fa-iḍ'rib","and strike","অতঃপর আঘাত করো"],["بِّهِۦ","bihi","with it","তা দিয়ে (তোমার স্ত্রীকে)"],["وَلَا","walā","and (do) not","এবং না"],["تَحْنَثْ ۗ","taḥnath","break (your) oath","তুমি শপথ ভঙ্গ করো\""],["إِنَّا","innā","Indeed, We","নিশ্চযই় আমরা"],["وَجَدْنَـٰهُ","wajadnāhu","[We] found him","তাকে আমরা পেয়েছি"],["صَابِرًۭا ۚ","ṣābiran","patient","ধৈর্য্যশীল"],["نِّعْمَ","ni‘'ma","an excellent","অতি উত্তম"],["ٱلْعَبْدُ ۖ","l-‘abdu","slave","দাস"],["إِنَّهُۥٓ","innahu","Indeed, he","সে নিশ্চয়ই  ছিলো"],["أَوَّابٌۭ","awwābun","repeatedly turned","বড় (আল্লাহ) অভিমুখী"]],"t":"وَخُذْ بِيَدِكَ ضِغْ<k>ثًۭا فَ</><h>ٱ</>ضْرِب بِّ<m>هِۦ</> وَلَا تَحْنَثْ ۗ إِ<g>نَّ</>ا وَجَ<q>دْ</><m>نَٰ</>هُ صَابِ<d>رًۭا ۚ نِّ</>عْمَ <h>ٱ</>لْعَ<q>بْ</>دُ ۖ إِ<g>نَّ</>هُ<o>ۥٓ</> أَ<p>وَّا</><q>بٌۭ</>"},{"n":45,"w":[["وَٱذْكُرْ","wa-udh'kur","And remember","এবং স্মরণ করো"],["عِبَـٰدَنَآ","‘ibādanā","Our slaves","আমাদের দ