يْنَهُمَا","baynahumā","(is) between them","উভয়ের মাঝে (আছে)"],["ٱلْعَزِيزُ","l-‘azīzu","the All-Mighty","(তিনি) মহাপরাক্রমশালী"],["ٱلْغَفَّـٰرُ","l-ghafāru","the Oft-Forgiving","পরম ক্ষমাশীল\""]],"t":"رَبُّ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ وَمَا بَيْنَهُمَا <h>ٱ</>لْعَزِيزُ <h>ٱ</>لْغَ<p>فَّٰ</>رُ"},{"n":67,"w":[["قُلْ","qul","Say","বলো"],["هُوَ","huwa","It (is)","\"তা"],["نَبَؤٌا۟","naba-on","a news","সংবাদ"],["عَظِيمٌ","‘aẓīmun","great","মহা"]],"t":"قُلْ هُوَ نَبَؤٌا۟ عَ<p>ظِي</>مٌ"},{"n":68,"w":[["أَنتُمْ","antum","You","তোমরা"],["عَنْهُ","‘anhu","from it","তা থেকে"],["مُعْرِضُونَ","mu‘'riḍūna","turn away","মুখ ফিরিয়ে নিচ্ছো"]],"t":"أَ<k>نتُ</>مْ عَنْهُ مُعْرِ<p>ضُو</>نَ"},{"n":69,"w":[["مَا","mā","Not","না"],["كَانَ","kāna","is","ছিলো"],["لِىَ","liya","for me","আমার"],["مِنْ","min","any","কোনো কিছি"],["عِلْمٍۭ","‘il'min","knowledge","জ্ঞান"],["بِٱلْمَلَإِ","bil-mala-i","(of) the chiefs","জগতের সম্পর্কে"],["ٱلْأَعْلَىٰٓ","l-a‘lā","the exalted","উর্ধ্ব"],["إِذْ","idh","when","যখন"],["يَخْتَصِمُونَ","yakhtaṣimūna","they were disputing","তারা বাদানুবাদ করছিলো"]],"t":"مَا كَانَ لِىَ مِنْ عِلْ<i>مٍۭ بِ</><h>ٱ</>لْمَلَإِ <h>ٱ</>لْأَعْلَ<o>ىٰٓ</> إِذْ يَخْتَصِ<p>مُو</>نَ"},{"n":70,"w":[["إِن","in","Not","না"],["يُوحَىٰٓ","yūḥā","has been revealed","ওহী করা হয়"],["إِلَىَّ","ilayya","to me","আমার প্রতি"],["إِلَّآ","illā","except","এ ছাড়া"],["أَنَّمَآ","annamā","that only","যে মূলতঃ"],["أَنَا۠","anā","I am","আমি"],["نَذِيرٌۭ","nadhīrun","a warner","একজন সতর্ককারী (মাত্র)"],["مُّبِينٌ","mubīnun","clear","সুস্পষ্ট\""]],"t":"<d>إِن يُ</>وحَ<o>ىٰٓ</> إِلَىَّ إِ<o>لَّآ</> أَ<g>نَّ</><o>مَآ</> أَنَا۠ نَذِي<d>رٌۭ مُّ</><p>بِي</>نٌ"},{"n":71,"w":[["إِذْ","idh","When","যখন"],["قَالَ","qāla","said","বলেছিলেন"],["رَبُّكَ","rabbuka","your Lord","তোমার রব"],["لِلْمَلَـٰٓئِكَةِ","lil'malāikati","to the Angels","ফেরেশতাদেরকে"],["إِنِّى","innī","Indeed, I Am","\"নিশ্চয়ই আমি"],["خَـٰلِقٌۢ","khāliqun","going to create","সৃষ্টি করছি"],["بَشَرًۭا","basharan","a human being","একজন মানুষ"],["مِّن","min","from","থেকে"],["طِينٍۢ","ṭīnin","clay","মাটি"]],"t":"إِذْ قَالَ رَبُّكَ لِلْمَ<o>لَٰٓ</>ئِكَةِ إِ<g>نِّ</>ى <m>خَٰ</>لِ<i>قٌۢ بَ</>شَ<d>رًۭا مِّ</><k>ن طِ</><p>ي</>نٍۢ"},{"n":72,"w":[["فَإِذَا","fa-idhā","So when","অতঃপর যখন"],["سَوَّيْتُهُۥ","sawwaytuhu","I have proportioned him","তা আমি সুঠাম করবো"],["وَنَفَخْتُ","wanafakhtu","and breathed","ও আমি সঞ্চার করবো"],["فِيهِ","fīhi","into him","তার মধ্যে"],["مِن","min","of","থেকে"],["رُّوحِى","rūḥī","My spirit","আমার রূহ"],["فَقَعُوا۟","faqa‘ū","then fall down","তোমরা তখন পড়বে"],["لَهُۥ","lahu","to him","তার (সামনে)"],["سَـٰجِدِينَ","sājidīna","prostrating","সিজদাকারী হয়ে\""]],"t":"فَإِذَا سَوَّيْتُهُ<m>ۥ</> وَنَفَخْتُ فِيهِ <w>مِن رُّ</>وحِى فَقَعُو<s>ا۟</> لَهُ<m>ۥ سَٰ</>جِ<p>دِي</>نَ"},{"n":73,"w":[["فَسَجَدَ","fasajada","So prostrated","অতঃপর সিজদা করলো"],["ٱلْمَلَـٰٓئِكَةُ","l-malāikatu","the Angels","ফেরেশতারা"],["كُلُّهُمْ","kulluhum","all of them","তাদের সকলেই"],["أَجْمَعُونَ","ajma‘ūna","together","একত্রে"]],"t":"فَسَجَدَ <h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةُ كُلُّهُمْ أَ<q>جْ</>مَ<p>عُو</>نَ"},{"n":74,"w":[["إِلَّآ","illā","Except","ব্যতীত"],["إِبْلِيسَ","ib'līsa","Iblis","ইবলিস"],["ٱسْتَكْبَرَ","is'takbara","he was arrogant","সে অহংকার করলো"],["وَكَانَ","wakāna","and became","ও হলো"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","the disbelievers","কাফিরদের"]],"t":"إِ<o>لَّآ</> إِ<q>بْ</>لِيسَ <h>ٱ</>سْتَكْبَرَ وَكَانَ مِنَ <h>ٱ</>لْ<m>كَٰ</>فِ<p>رِي</>نَ"},{"n":75,"w":[["قَالَ","qāla","He said","(আল্লাহ) বললেন"],["يَـٰٓإِبْلِيسُ","yāib'līsu","O Iblis","\"হে ইবলিস"],["مَا","mā","What","কিসে"],["مَنَعَكَ","mana‘aka","prevented you","তোমাকে বাধা দিলো"],["أَن","an","that","যে (না)"],["تَسْجُدَ","tasjuda","you (should) prostrate","সিজদা করলে তুমি"],["لِمَا","limā","to (one) whom","(তাকে) যাকে"],["خَلَقْتُ","khalaqtu","I created","আমি সৃষ্টি করেছি"],["بِيَدَىَّ ۖ","biyadayya","with My Hands","আমার দু’হাত দ্বারা"],["أَسْتَكْبَرْتَ","astakbarta","Are you arrogant","তুমি কি অহংকার করলে"],["أَمْ","am","or","অথবা"],["كُنتَ","kunta","are you","তুমি ছিলে"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْعَالِينَ","l-‘ālīna","the exalted ones","উচ্চ মর্যাদাসম্পন্নদের\""]],"t":"قَالَ <o>يَٰٓ</>إِ<q>بْ</>لِيسُ مَا مَنَعَكَ أَ<k>ن تَ</>سْجُدَ لِمَا خَلَ<q>قْ</>تُ بِيَدَىَّ ۖ أَسْتَكْبَرْتَ أَمْ كُ<k>نتَ</> مِنَ <h>ٱ</>لْعَا<p>لِي</>نَ"},{"n":76,"w":[["قَالَ","qāla","He said","সে বললো"],["أَنَا۠","anā","I am","\"আমি"],["خَيْرٌۭ","khayrun","better","বড়"],["مِّنْهُ ۖ","min'hu","than him","তার চেয়ে"],["خَلَقْتَنِى","khalaqtanī","You created me","আমাকে আপনি সৃষ্টি করেছেন"],["مِن","min","from","দিয়ে"],["نَّارٍۢ","nārin","fire","আগুন"],["وَخَلَقْتَهُۥ","wakhalaqtahu","and You created him","আর তাকে সৃষ্টি করেছেন"],["مِن","min","from","দিয়ে"],["طِينٍۢ","ṭīnin","clay","মাটি\""]],"t":"قَالَ أَنَا۠ خَيْ<d>رٌۭ مِّ</>نْهُ ۖ خَلَ<q>قْ</>تَنِى <d>مِن نَّارٍۢ وَ</>خَلَ<q>قْ</>تَهُ<m>ۥ</> مِ<k>ن طِ</><p>ي</>نٍۢ"},{"n":77,"w":[["قَالَ","qāla","He said","(আল্লাহ) বললেন"],["فَٱخْرُجْ","fa-ukh'ruj","Then get out","\"তাহ'লে বের হও"],["مِنْهَا","min'hā","of it","এখান থেকে"],["فَإِنَّكَ","fa-innaka","for indeed, you","তাহ'লে তুমি নিশ্চয়ই"],["رَجِيمٌۭ","rajīmun","(are) accursed","বিতাড়িত"]],"t":"قَالَ فَ<h>ٱ</>خْرُ<q>جْ</> مِنْهَا فَإِ<g>نَّ</>كَ رَ<p>جِي</>مٌۭ"},{"n":78,"w":[["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["عَلَيْكَ","‘alayka","upon you","তোমার উপর"],["لَعْنَتِىٓ","la‘natī","(is) My curse","আমার অভিশাপ"],["إِلَىٰ","ilā","until","পর্যন্ত"],["يَوْمِ","yawmi","(the) Day","দিন"],["ٱلدِّينِ","l-dīni","(of) Judgment","বিচার\""]],"t":"وَإِ<g>نَّ</> عَلَيْكَ لَعْنَ<o>تِىٓ</> إِلَىٰ يَوْمِ <h>ٱ</><l>ل</><p>دِّي</>نِ"},{"n":79,"w":[["قَالَ","qāla","He said","সে বললো"],["رَبِّ","rabbi","My Lord","\"হে আমার রব"],["فَأَنظِرْنِىٓ","fa-anẓir'nī","Then give me respite","আমাকে তাহ'লে অবকাশ দিন"],["إِلَىٰ","ilā","until","পর্যন্ত"],["يَوْمِ","yawmi","(the) Day","দিন"],["يُبْعَثُونَ","yub'‘athūna","they are resurrected","উত্থানের\""]],"t":"قَالَ رَبِّ فَأَ<k>نظِ</>