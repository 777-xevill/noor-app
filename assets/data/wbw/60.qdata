{"n":60,"a":[{"n":1,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you","ওহে"],["ٱلَّذِينَ","alladhīna","who","যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছ"],["لَا","lā","(Do) not","না"],["تَتَّخِذُوا۟","tattakhidhū","take","তোমরা গ্রহণ করো"],["عَدُوِّى","‘aduwwī","My enemies","আমার শত্রুকে"],["وَعَدُوَّكُمْ","wa‘aduwwakum","and your enemies","ও তোমাদের শত্রুকে"],["أَوْلِيَآءَ","awliyāa","(as) allies","বন্ধুরূপে"],["تُلْقُونَ","tul'qūna","offering","তোমরা স্থাপন কর"],["إِلَيْهِم","ilayhim","them","তাদের সাথেে"],["بِٱلْمَوَدَّةِ","bil-mawadati","love","বন্ধুত্ব"],["وَقَدْ","waqad","while","অথচ নিশ্চয়"],["كَفَرُوا۟","kafarū","they have disbelieved","ত্রা অস্বীকার করেছে"],["بِمَا","bimā","in what","যা"],["جَآءَكُم","jāakum","came to you","তোমাদের কাছে এসেছে"],["مِّنَ","mina","of","থেকে"],["ٱلْحَقِّ","l-ḥaqi","the truth","সত্য"],["يُخْرِجُونَ","yukh'rijūna","driving out","তারা বহিষ্কার করেছে"],["ٱلرَّسُولَ","l-rasūla","the Messenger","রসূলকে"],["وَإِيَّاكُمْ ۙ","wa-iyyākum","and yourselves","এবং তোমাদেরকেও"],["أَن","an","because","একারণে যে"],["تُؤْمِنُوا۟","tu'minū","you believe","তোমরা ঈমান এনেছো"],["بِٱللَّهِ","bil-lahi","in Allah","আল্লাহর উপর"],["رَبِّكُمْ","rabbikum","your Lord","তোমাদের রব"],["إِن","in","If","যদি"],["كُنتُمْ","kuntum","you","তোমরা"],["خَرَجْتُمْ","kharajtum","come forth","বের হয়ে থাকো"],["جِهَـٰدًۭا","jihādan","(to) strive","জিহাদে"],["فِى","fī","in","(মধ্যে)"],["سَبِيلِى","sabīlī","My way","আমার পথে"],["وَٱبْتِغَآءَ","wa-ib'tighāa","and (to) seek","ও সন্ধানে"],["مَرْضَاتِى ۚ","marḍātī","My Pleasure","আমার সন্তুষ্টির"],["تُسِرُّونَ","tusirrūna","You confide","তোমরা গোপনে কর"],["إِلَيْهِم","ilayhim","to them","তাদের সাথে"],["بِٱلْمَوَدَّةِ","bil-mawadati","love","বন্ধুত্ব"],["وَأَنَا۠","wa-anā","but I Am","আমি অথচ"],["أَعْلَمُ","a‘lamu","most knowing","সম্যক অবগত"],["بِمَآ","bimā","of what","যা কিছু"],["أَخْفَيْتُمْ","akhfaytum","you conceal","তোমরা গোপন কর"],["وَمَآ","wamā","and what","ও যা"],["أَعْلَنتُمْ ۚ","a‘lantum","you declare","তোমরা প্রকাশ কর"],["وَمَن","waman","And whoever","এবং যে"],["يَفْعَلْهُ","yaf‘alhu","does it","তা করবে"],["مِنكُمْ","minkum","among you","তোমাদের মধ্যে"],["فَقَدْ","faqad","then certainly","অতঃপর নিশ্চয়"],["ضَلَّ","ḍalla","he has strayed","ভ্রষ্ট হয়েছে"],["سَوَآءَ","sawāa","(from the) straight","সোজা"],["ٱلسَّبِيلِ","l-sabīli","path","পথ থেকে"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> لَا تَتَّخِذُو<s>ا۟</> عَدُوِّى وَعَدُوَّكُمْ أَوْلِ<o>يَآ</>ءَ تُلْقُونَ إِلَيْ<f>هِم بِ</><h>ٱ</>لْمَوَدَّةِ وَقَ<q>دْ</> كَفَرُو<s>ا۟</> بِمَا <o>جَآ</>ءَ<y>كُم مِّ</>نَ <h>ٱ</>لْحَقِّ يُخْرِجُونَ <h>ٱ</><l>ل</>رَّسُولَ وَإِيَّاكُمْ ۙ أَ<k>ن تُ</>ؤْمِنُو<s>ا۟</> بِ<h>ٱ</>للَّهِ رَبِّكُمْ إِ<k>ن كُنتُ</>مْ خَرَ<q>جْ</>تُمْ جِ<m>هَٰ</><k>دًۭا فِ</>ى سَبِيلِى وَ<h>ٱ</><q>بْ</>تِ<o>غَآ</>ءَ مَرْضَاتِى ۚ تُسِرُّونَ إِلَيْ<f>هِم بِ</><h>ٱ</>لْمَوَدَّةِ وَأَنَا۠ أَعْلَمُ بِ<o>مَآ</> أَخْفَيْتُمْ وَ<o>مَآ</> أَعْلَ<k>نتُ</>مْ ۚ وَ<d>مَن يَ</>فْعَلْهُ مِ<k>نكُ</>مْ فَقَ<q>دْ</> ضَلَّ سَ<o>وَآ</>ءَ <h>ٱ</><l>ل</>سَّ<p>بِي</>لِ"},{"n":2,"w":[["إِن","in","If","যদি"],["يَثْقَفُوكُمْ","yathqafūkum","they gain dominance over you","তোমাদের কাবু করতে পারে"],["يَكُونُوا۟","yakūnū","they would be","তারা হয়"],["لَكُمْ","lakum","to you","তোমাদের জন্য"],["أَعْدَآءًۭ","a‘dāan","enemies","শত্রু"],["وَيَبْسُطُوٓا۟","wayabsuṭū","and extend","ও তারা সম্প্রসারিত করে"],["إِلَيْكُمْ","ilaykum","against you","তোমাদের দিবে"],["أَيْدِيَهُمْ","aydiyahum","their hands","তাদের হাতগুলো"],["وَأَلْسِنَتَهُم","wa-alsinatahum","and their tongues","ও তাদের রসনাগুলো"],["بِٱلسُّوٓءِ","bil-sūi","with evil","মন্দের সাথে"],["وَوَدُّوا۟","wawaddū","and they desire","ও তারা কামনা করে"],["لَوْ","law","that","যদি"],["تَكْفُرُونَ","takfurūna","you would disbelieve","তোমরা কাফির হও"]],"t":"<d>إِن يَ</>ثْقَفُوكُمْ يَكُونُو<s>ا۟</> لَكُمْ أَعْ<o>دَآ</><d>ءًۭ وَ</>يَ<q>بْ</>سُ<o>طُوٓ</><s>ا۟</> إِلَيْكُمْ أَيْدِيَهُمْ وَأَلْسِنَتَ<f>هُم بِ</><h>ٱ</><l>ل</><o>سُّوٓ</>ءِ وَوَدُّو<s>ا۟</> لَوْ تَكْفُ<p>رُو</>نَ"},{"n":3,"w":[["لَن","lan","Never","কখনো না"],["تَنفَعَكُمْ","tanfa‘akum","will benefit you","তোমাদের উপকার দেবে"],["أَرْحَامُكُمْ","arḥāmukum","your relatives","তোমাদের আত্মীয়দের"],["وَلَآ","walā","and not","এবং না"],["أَوْلَـٰدُكُمْ ۚ","awlādukum","your children","তোমাদের সন্তানদের"],["يَوْمَ","yawma","(on the) Day","দিনে"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) the Resurrection","কিয়ামতের"],["يَفْصِلُ","yafṣilu","He will judge","বিচ্ছেদ করবেন তিনি"],["بَيْنَكُمْ ۚ","baynakum","between you","তোমাদের মাঝে"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["بِمَا","bimā","of what","যা"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা কাজ কর"],["بَصِيرٌۭ","baṣīrun","(is) All-Seer","সব দেখেন"]],"t":"لَ<k>ن تَنفَ</>عَكُمْ أَرْحَامُكُمْ وَ<o>لَآ</> أَوْ<m>لَٰ</>دُكُمْ ۚ يَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ يَفْصِلُ بَيْنَكُمْ ۚ وَ<h>ٱ</>للَّهُ بِمَا تَعْمَلُونَ بَ<p>صِي</>رٌۭ"},{"n":4,"w":[["قَدْ","qad","Indeed","নিশ্চই"],["كَانَتْ","kānat","(there) is","রয়েছে"],["لَكُمْ","lakum","for you","তোমাদের জন্য"],["أُسْوَةٌ","us'watun","an example","আদর্শ"],["حَسَنَةٌۭ","ḥasanatun","good","উত্তম"],["فِىٓ","fī","in","মধ্যে"],["إِبْرَٰهِيمَ","ib'rāhīma","Ibrahim","ইব্রাহীমের"],["وَٱلَّذِينَ","wa-alladhīna","and those","ও যারা"],["مَعَهُۥٓ","ma‘ahu","with him","তার সাথে"],["إِذْ","idh","when","যখন"],["قَالُوا۟","qālū","they said","তারা বলেছিলো"],["لِقَوْمِهِمْ","liqawmihim","to their people","তাদের জাতিকে"],["إِنَّا","innā","Indeed, we","\"আমরা নিশ্চই"],["بُرَءَٰٓؤُا۟","buraāu","(are) disassociated","নিঃ সম্পর্ক"],["مِنكُمْ","minkum","from you","তোমাদের থেকে"],["وَمِمَّا","wamimmā","and from what","ও যা থেকে"],["تَعْبُدُونَ","ta‘budūna","you worship","তোমরা ইবাদত কর"],["مِن","min","from","মধ্য হতে"],["دُونِ","dūni","besides","ছাড়া"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["كَفَرْنَا","kafarnā","We have denied","আমরা অস্বীকার করছি"],["بِكُمْ","bikum","you","তোমাদেরকে"],["وَبَدَا","wabadā","and has appeared","ও সৃষ্টি হল"],["بَيْنَنَا","baynanā","between us","আমাদের মাঝে"],["وَبَيْنَكُمُ","wabaynakumu","and between you","ও তোমাদের মাঝে"],["ٱلْعَدَٰوَةُ","l-‘adāwatu","enmity","শত্রুতা"],["وَٱلْبَغْضَآءُ","wal-baghḍāu","and hatred","ও বিদ্বেষ"],["أَبَدًا","abadan","forever","চিরকালের"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["تُؤْمِنُوا۟","tu'minū","you believe","তোমরা ঈমান আনো"],["بِٱللَّهِ","bil-lahi","in Allah","আল্লাহর উপর"],["وَحْدَهُۥٓ","waḥdahu","Alone","তার একার\""],["إِلَّا","illā","Except","তবে ব্যাতিক্রম"],["قَوْلَ","qawla","(the) saying","উক্তি"],["إِبْرَٰهِيمَ","ib'rāhīma","(of) Ibrahim","ইব্রাহীমের"],["لِأَبِيهِ","li-abīhi","to his father","তার বাপের জন্য"],["لَأَسْتَغْفِرَنَّ","la-astaghfiranna","Surely I ask forgiveness","\"আমি ক্ষমা চাইব অবশ্যই"],["لَكَ","laka","for you","তোমার জন্য"],["وَمَآ","wamā","but not","ও না"],["أَمْلِكُ","amliku","I have power","আমি সাধ্য রাখি"],["لَكَ","laka","for you","তোমার জন্য"],["مِنَ","mina","from","হতে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["مِن","min","of","কোন"],["شَىْءٍۢ ۖ","shayin","anything","কিছুই"],["رَّبَّنَا","rabbanā","Our Lord","হে আমাদের রব"],["عَلَيْكَ","‘alayka","upon You","তোমার উপর"],["تَوَكَّلْنَا","tawakkalnā","we put our trust","আমরা ভরসা করেছি"],["وَإِلَيْكَ","wa-ilayka","and to You","ও তোমাার দিকে"],["أَنَبْنَا","anabnā","we turn","আমরা অভিমুখী"],["وَإِلَيْكَ","wa-ilayka","and to You","ও তোমার কাছেই"],["ٱلْمَصِيرُ","l-maṣīru","(is) the final return","প্রত্যাবর্তন স্থল"]],"t":"قَ<q>دْ</> كَانَتْ لَكُمْ أُسْوَةٌ حَسَنَ<k>ةٌۭ فِ</><o>ىٓ</> إِ<q>بْ</><m>رَٰ</>هِيمَ وَ<h>ٱ</>لَّذِينَ مَعَهُ<o>ۥٓ</> إِذْ قَالُو<s>ا۟</> لِقَوْمِهِمْ إِ<g>نَّ</>ا بُرَ<o>ءَٰٓ</>ؤُ<s>ا۟</> مِ<k>نكُ</>مْ وَمِ<g>مَّ</>ا تَعْبُدُونَ مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ كَفَرْنَا بِكُمْ وَبَدَا بَيْنَنَا وَبَيْنَكُمُ <h>ٱ</>لْعَ<m>دَٰ</>وَةُ وَ<h>ٱ</>لْبَغْ<o>ضَآ</>ءُ أَبَدًا حَتَّىٰ تُؤْمِنُو<s>ا۟</> بِ<h>ٱ</>للَّهِ وَحْدَهُ<o>ۥٓ</> إِلَّا قَوْلَ إِ<q>بْ</><m>رَٰ</>هِيمَ لِأَبِيهِ لَأَسْتَغْفِرَ<g>نَّ</> لَكَ وَ<o>مَآ</> أَمْلِكُ لَكَ مِنَ <h>ٱ</>للَّهِ مِ<k>ن شَ</><w>ىْءٍۢ ۖ رَّ</>بَّنَا عَلَيْكَ تَوَكَّلْنَا وَإِلَيْكَ أَنَ<q>بْ</>نَا وَإِلَيْكَ <h>ٱ</>لْمَ<p>صِي</>رُ"},{"n":5,"w":[["رَبَّنَا","rabbanā","Our Lord","হে আমাদের রব"],["لَا","lā","(do) not","না"],["تَجْعَلْنَا","taj‘alnā","make us","আমাদের বানিও"],["فِتْنَةًۭ","fit'natan","a trial","ফিতনা"],["لِّلَّذِينَ","lilladhīna","for those who","তাদের জান্য যারা"],["كَفَرُوا۟","kafarū","disbelieve","কুফরি করেছে"],["وَٱغْفِرْ","wa-igh'fir","and forgive","ও মাফ কর"],["لَنَا","lanā","us","আমাদের ,"],["رَبَّنَآ ۖ","rabbanā","our Lord","হে আমাদের রব"],["إِنَّكَ","innaka","Indeed You","তুমি নিশ্চই"],["أَنتَ","anta","[You]","তুমিই"],["ٱلْعَزِيزُ","l-‘azīzu","(are) the All-Mighty","পরাক্রমশালী"],["ٱلْحَكِيمُ","l-ḥakīmu","the All-Wise","প্রজ্ঞাময়।\""]],"t":"رَبَّنَا لَا تَ<q>جْ</>عَلْنَا فِتْنَ<w>ةًۭ لِّ</>لَّذِينَ كَفَرُو<s>ا۟</> وَ<h>ٱ</>غْفِرْ لَنَا رَبَّ<o>نَآ ۖ</> إِ<g>نَّ</>كَ أَ<k>نتَ</> <h>ٱ</>لْعَزِيزُ <h>ٱ</>لْحَ<p>كِي</>مُ"},{"n":6,"w":[["لَقَدْ","laqad","Certainly","নিশ্চই"],["كَانَ","kāna","(there) is","আছে"],["لَكُمْ","lakum","for you","তোমাদের জন্য"],["فِيهِمْ","fīhim","in them","তাদের মধ্যে"],["أُسْوَةٌ","us'watun","an example","আদর্শ"],["حَسَنَةٌۭ","ḥasanatun","good","উত্তম"],["لِّمَن","liman","for (he) who","যে তার জন্য"],["كَانَ","kāna","is","ছিল"],["يَرْجُوا۟","yarjū","hopeful","আকাঙ্খা রাখে"],["ٱللَّهَ","l-laha","(in) Allah","আল্লাহর"],["وَٱلْيَوْمَ","wal-yawma","and the Day","ও দিনের"],["ٱلْـَٔاخِرَ ۚ","l-ākhira","the Last","শেষ"],["وَمَن","waman","And whoever","এবং যে"],["يَتَوَلَّ","yatawalla","turns away","মুখ ফিরাবে"],["فَإِنَّ","fa-inna","then indeed","নিশ্চ্চই তবে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["هُوَ","huwa","He","তিনিই"],["ٱلْغَنِىُّ","l-ghaniyu","(is) Free of need","অভাভহীন"],["ٱلْحَمِيدُ","l-ḥamīdu","the Praiseworthy","প্রসংসিত।"]],"t":"لَقَ<q>دْ</> كَانَ لَكُمْ فِيهِمْ أُسْوَةٌ حَسَنَ<w>ةٌۭ لِّ</>مَ<k>ن كَ</>انَ يَرْجُو<s>ا۟</> <h>ٱ</>للَّهَ وَ<h>ٱ</>لْيَوْمَ <h>ٱ</>لْءَاخِرَ ۚ وَ<d>مَن يَ</>تَوَلَّ فَإِ<g>نَّ</> <h>ٱ</>للَّهَ هُوَ <h>ٱ</>لْغَنِىُّ <h>ٱ</>لْحَ<p>مِي</><q>دُ</>"},{"n":7,"w":[["۞ عَسَى","‘asā","Perhaps","সম্ভবত"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["أَن","an","[that]","যে"],["يَجْعَلَ","yaj‘ala","will put","সৃষ্টি করে দিবেন"],["بَيْنَكُمْ","baynakum","between you","তোমাদের মাঝে"],["وَبَيْنَ","wabayna","and between","ও মাঝে"],["ٱلَّذِينَ","alladhīna","those (to) whom","যাদের সাথে"],["عَادَيْتُم","‘ādaytum","you have been enemies","তোমরা শত্রুতা করেছো"],["مِّنْهُم","min'hum","among them","তাদের মধ্যে"],["مَّوَدَّةًۭ ۚ","mawaddatan","love","বন্ধুত্ব"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["قَدِيرٌۭ ۚ","qadīrun","(is) All-Powerful","সর্বশক্তিমান"],["وَٱللَّهُ","wal-lahu","And Allah","ও আল্লাহ"],["غَفُورٌۭ","ghafūrun","(is) Oft-Forgiving","ক্ষমাশীল"],["رَّحِيمٌۭ","raḥīmun","Most Merciful","মেহেরবান"]],"t":"۞ عَسَى <h>ٱ</>للَّهُ <d>أَن يَ</><q>جْ</>عَلَ بَيْنَكُمْ وَبَيْنَ <h>ٱ</>لَّذِينَ عَادَيْ<y>تُم مِّنْهُم مَّ</>وَدَّ<d>ةًۭ ۚ وَ</><h>ٱ</>للَّهُ قَدِي<d>رٌۭ ۚ وَ</><h>ٱ</>للَّهُ غَفُو<w>رٌۭ رَّ</><p>حِي</>مٌۭ"},{"n":8,"w":[["لَّا","lā","Not","না"],["يَنْهَىٰكُمُ","yanhākumu","(does) forbid you","তোমাদের নিষেধ করেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["عَنِ","‘ani","from","থেকে"],["ٱلَّذِينَ","alladhīna","those who","তাদের যারা"],["لَمْ","lam","(do) not","নাই"],["يُقَـٰتِلُوكُمْ","yuqātilūkum","fight you","যুদ্ধ করে তোমাদের সাথে"],["فِى","fī","in","ব্যাপারে"],["ٱلدِّينِ","l-dīni","the religion","দ্বীনের"],["وَلَمْ","walam","and (do) not","এবং নাই"],["يُخْرِجُوكُم","yukh'rijūkum","drive you out","তোমাদের বহিষ্কৃত করে"],["مِّن","min","of","থেকে"],["دِيَـٰرِكُمْ","diyārikum","your homes","তোমাদের ঘরগুলোকে"],["أَن","an","that","যে"],["تَبَرُّوهُمْ","tabarrūhum","you deal kindly","তোমরা তাদের সাথে নেকী কর"],["وَتُقْسِطُوٓا۟","watuq'siṭū","and deal justly","ও তোমরা ন্যায় বিচার কর"],["إِلَيْهِمْ ۚ","ilayhim","with them","তাদের সহিত"],["إِنَّ","inna","Indeed","নিশ্চয়"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يُحِبُّ","yuḥibbu","loves","ভালোবাসেন"],["ٱلْمُقْسِطِينَ","l-muq'siṭīna","those who act justly","ন্যায়বিচারকারিদের"]],"t":"لَّا يَنْهَ<m>ىٰ</>كُمُ <h>ٱ</>للَّهُ عَنِ <h>ٱ</>لَّذِينَ لَمْ يُ<m>قَٰ</>تِلُوكُمْ فِى <h>ٱ</><l>ل</>دِّينِ وَلَمْ يُخْرِجُو<y>كُم مِّ</><k>ن دِ</><m>يَٰ</>رِكُمْ أَ<k>ن تَ</>بَرُّوهُمْ وَتُ<q>قْ</>سِ<o>طُوٓ</><s>ا۟</> إِلَيْهِمْ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ يُحِبُّ <h>ٱ</>لْمُ<q>قْ</>سِ<p>طِي</>نَ"},{"n":9,"w":[["إِنَّمَا","innamā","Only","মূলতঃ"],["يَنْهَىٰكُمُ","yanhākumu","forbids you","নিষেধ করেছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["عَنِ","‘ani","from","থেকে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["قَـٰتَلُوكُمْ","qātalūkum","fight you","যুদ্ধ করেছে তোমাদের বিরুদ্ধে"],["فِى","fī","in","ব্যাপারে"],["ٱلدِّينِ","l-dīni","the religion","দ্বীনের"],["وَأَخْرَجُوكُم","wa-akhrajūkum","and drive you out","ও যাদের বহিষ্কার করেছে"],["مِّن","min","of","থেকে"],["دِيَـٰرِكُمْ","diyārikum","your homes","তোমাদের ঘরগুুলো"],["وَظَـٰهَرُوا۟","waẓāharū","and support","এবং  তারা সাহায্য করেছে"],["عَلَىٰٓ","‘alā","in","ব্যাপারে"],["إِخْرَاجِكُمْ","ikh'rājikum","your expulsion","তোমাদের বহিিষ্কার"],["أَن","an","that","যে"],["تَوَلَّوْهُمْ ۚ","tawallawhum","you make them allies","তাদের সাথেে তোমরা বন্ধুত্ব কর"],["وَمَن","waman","And whoever","এবং যে"],["يَتَوَلَّهُمْ","yatawallahum","makes them allies","তাদের(সাথে) বন্ধুত্ব করে"],["فَأُو۟لَـٰٓئِكَ","fa-ulāika","then those","অতঃপর ঐসব লোক"],["هُمُ","humu","[they]","তারা"],["ٱلظَّـٰلِمُونَ","l-ẓālimūna","(are) the wrongdoers","যালিম"]],"t":"إِ<g>نَّ</>مَا يَنْهَ<m>ىٰ</>كُمُ <h>ٱ</>للَّهُ عَنِ <h>ٱ</>لَّذِينَ <m>قَٰ</>تَلُوكُمْ فِى <h>ٱ</><l>ل</>دِّينِ وَأَخْرَجُو<y>كُم مِّ</><k>ن دِ</><m>يَٰ</>رِكُمْ وَ<m>ظَٰ</>هَرُو<s>ا۟</> عَلَ<o>ىٰٓ</> إِخْرَاجِكُمْ أَ<k>ن تَ</>وَلَّوْهُمْ ۚ وَ<d>مَن يَ</>تَوَلَّهُمْ فَأُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مُو</>نَ"},{"n":10,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you","ওহেে"],["ٱلَّذِينَ","alladhīna","who","যারা"],["ءَامَنُوٓا۟","āmanū","believe","ঈমান এনেছ"],["إِذَا","idhā","When","যখন"],["جَآءَكُمُ","jāakumu","come to you","তোমাদের কাাছে আসবে"],["ٱلْمُؤْمِنَـٰتُ","l-mu'minātu","the believing women","মুমিন মহিলারা"],["مُهَـٰجِرَٰتٍۢ","muhājirātin","(as) emigrants","মুহাজির হয়ে"],["فَٱمْتَحِنُوهُنَّ ۖ","fa-im'taḥinūhunna","then examine them","তাদের তোমরা পরীক্ষা তখন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["أَعْلَمُ","a‘lamu","(is) most knowing","খুব জানেন"],["بِإِيمَـٰنِهِنَّ ۖ","biīmānihinna","of their faith","তাদের ঈমান সম্পর্কে"],["فَإِنْ","fa-in","And if","যদিি অতএব"],["عَلِمْتُمُوهُنَّ","‘alim'tumūhunna","you know them","তাদের তোমরা জানতে পারো"],["مُؤْمِنَـٰتٍۢ","mu'minātin","(to be) believers","মুমিন রূপে"],["فَلَا","falā","then (do) not","না তখন"],["تَرْجِعُوهُنَّ","tarji‘ūhunna","return them","তাদেরকে ফেরত দিও"],["إِلَى","ilā","to","দিকে"],["ٱلْكُفَّارِ ۖ","l-kufāri","the disbelievers","কাফিরদের"],["لَا","lā","Not","না"],["هُنَّ","hunna","they","তারা (মুমিন নারী)"],["حِلٌّۭ","ḥillun","(are) lawful","হালাল"],["لَّهُمْ","lahum","for them","তাদের জন্য (কাফিরদের)"],["وَلَا","walā","and not","ও না"],["هُمْ","hum","they","তারা"],["يَحِلُّونَ","yaḥillūna","are lawful","হালাল"],["لَهُنَّ ۖ","lahunna","for them","তাদের জন্য(মুমিন নারী্দের)"],["وَءَاتُوهُم","waātūhum","But give them","তাদের দাও তোমরা"],["مَّآ","mā","what","যা"],["أَنفَقُوا۟ ۚ","anfaqū","they have spent","তারা খরচ করেছে"],["وَلَا","walā","And not","এবং নাই"],["جُنَاحَ","junāḥa","any blame","গুনাহ"],["عَلَيْكُمْ","‘alaykum","upon you","তোমাদের উপর"],["أَن","an","if","যে"],["تَنكِحُوهُنَّ","tankiḥūhunna","you marry them","তাদের তোমরা বিবাহ কর"],["إِذَآ","idhā","when","যখন"],["ءَاتَيْتُمُوهُنَّ","ātaytumūhunna","you have given them","তাদের তোমরা দাও"],["أُجُورَهُنَّ ۚ","ujūrahunna","their (bridal) dues","তাদের মোহর"],["وَلَا","walā","And (do) not","এবং না"],["تُمْسِكُوا۟","tum'sikū","hold","তোমরা ধরে রেখ"],["بِعِصَمِ","bi‘iṣami","to marriage bonds","বিবাহ বন্ধন"],["ٱلْكَوَافِرِ","l-kawāfiri","(with) disbelieving women","কাফির স্ত্রীদের"],["وَسْـَٔلُوا۟","wasalū","but ask (for)","ও তোমরা চাও"],["مَآ","mā","what","যা"],["أَنفَقْتُمْ","anfaqtum","you have spent","তোমরা খরচ করেছ"],["وَلْيَسْـَٔلُوا۟","walyasalū","and let them ask","ও তারা চেয়ে নিবে"],["مَآ","mā","what","যা"],["أَنفَقُوا۟ ۚ","anfaqū","they have spent","তারা খরচ করেছে"],["ذَٰلِكُمْ","dhālikum","That","এটা"],["حُكْمُ","ḥuk'mu","(is the) Judgment","নির্দেশ"],["ٱللَّهِ ۖ","l-lahi","(of) Allah","আল্লাহর"],["يَحْكُمُ","yaḥkumu","He judges","তিনি ফয়সালা দেন"],["بَيْنَكُمْ ۚ","baynakum","between you","তোমাদের মাঝে"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["عَلِيمٌ","‘alīmun","(is) All-Knowing","সরবজ্ঞ"],["حَكِيمٌۭ","ḥakīmun","All-Wise","প্রজ্ঞাময়"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَ<o>نُوٓ</><s>ا۟</> إِذَا <o>جَآ</>ءَكُمُ <h>ٱ</>لْمُؤْمِ<m>نَٰ</>تُ مُ<m>هَٰجِرَٰ</><k>تٍۢ فَ</><h>ٱ</>مْتَحِنُوهُ<g>نَّ</> ۖ <h>ٱ</>للَّهُ أَعْلَمُ بِإِي<m>مَٰ</>نِهِ<g>نَّ</> ۖ فَإِنْ عَلِمْتُمُوهُ<g>نَّ</> مُؤْمِ<m>نَٰ</><k>تٍۢ فَ</>لَا تَرْجِعُوهُ<g>نَّ</> إِلَى <h>ٱ</>لْكُفَّارِ ۖ لَا هُ<g>نَّ</> حِ<w>لٌّۭ لَّ</>هُمْ وَلَا هُمْ يَحِلُّونَ لَهُ<g>نَّ</> ۖ وَءَاتُو<y>هُم مَّ</><o>آ</> أَ<k>نفَ</>قُو<s>ا۟ ۚ</> وَلَا جُنَاحَ عَلَيْكُمْ أَ<k>ن تَنكِ</>حُوهُ<g>نَّ</> إِ<o>ذَآ</> ءَاتَيْتُمُوهُ<g>نَّ</> أُجُورَهُ<g>نَّ</> ۚ وَلَا تُمْسِكُو<s>ا۟</> بِعِصَمِ <h>ٱ</>لْكَوَافِرِ وَسْـَٔلُو<s>ا۟</> <o>مَآ</> أَ<k>نفَ</><q>قْ</>تُمْ وَلْيَسْـَٔلُو<s>ا۟</> <o>مَآ</> أَ<k>نفَ</>قُو<s>ا۟ ۚ</> <m>ذَٰ</>لِكُمْ حُكْمُ <h>ٱ</>للَّهِ ۖ يَحْكُمُ بَيْنَكُمْ ۚ وَ<h>ٱ</>للَّهُ عَلِيمٌ حَ<p>كِي</>مٌۭ"},{"n":11,"w":[["وَإِن","wa-in","And if","এবং যদি"],["فَاتَكُمْ","fātakum","have gone from you","তোমাদের হাত ছাড়া হয়"],["شَىْءٌۭ","shayon","any","কিছুু"],["مِّنْ","min","of","থেকে"],["أَزْوَٰجِكُمْ","azwājikum","your wives","তোমাদের স্ত্রীদের"],["إِلَى","ilā","to","নিকট"],["ٱلْكُفَّارِ","l-kufāri","the disbelievers","কাফিরদের"],["فَعَاقَبْتُمْ","fa‘āqabtum","then your turn comes","তোমরা অতঃপর সুযোগ পাও"],["فَـَٔاتُوا۟","faātū","then give","তবে তোমরা দাও"],["ٱلَّذِينَ","alladhīna","(to) those who","তাদের"],["ذَهَبَتْ","dhahabat","have gone","চলে গেছে"],["أَزْوَٰجُهُم","azwājuhum","their wives","যাদেের স্ত্রী"],["مِّثْلَ","mith'la","(the) like","সমান"],["مَآ","mā","(of) what","যা"],["أَنفَقُوا۟ ۚ","anfaqū","they had spent","তারা খরচ করেছে"],["وَٱتَّقُوا۟","wa-ittaqū","And fear","এবং তোমরা ভয় কর"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["ٱلَّذِىٓ","alladhī","(in) Whom","যার"],["أَنتُم","antum","you","তোমরা"],["بِهِۦ","bihi","[in Him]","তার উপর"],["مُؤْمِنُونَ","mu'minūna","(are) believers","ঈমানদার"]],"t":"وَإِ<k>ن فَ</>اتَكُمْ <d>شَىْءٌۭ مِّ</>نْ أَزْ<m>وَٰ</>جِكُمْ إِلَى <h>ٱ</>لْكُفَّارِ فَعَاقَ<q>بْ</>تُمْ فَـَٔاتُو<s>ا۟</> <h>ٱ</>لَّذِينَ ذَهَبَتْ أَزْ<m>وَٰ</>جُ<y>هُم مِّ</>ثْلَ <o>مَآ</> أَ<k>نفَ</>قُو<s>ا۟ ۚ</> وَ<h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</>للَّهَ <h>ٱ</>لَّ<o>ذِىٓ</> أَ<k>نتُ</><f>م بِ</><m>هِۦ</> مُؤْمِ<p>نُو</>نَ"},{"n":12,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O","হে"],["ٱلنَّبِىُّ","l-nabiyu","Prophet","নবী"],["إِذَا","idhā","When","যখন"],["جَآءَكَ","jāaka","come to you","তোমার কাছে আসবে"],["ٱلْمُؤْمِنَـٰتُ","l-mu'minātu","the believing women","মুমিন নারীরা"],["يُبَايِعْنَكَ","yubāyi‘'naka","pledging to you","তোমার কাছে বয়াত করবে"],["عَلَىٰٓ","‘alā","[on]","(এ কথার) উপর"],["أَن","an","that","যে"],["لَّا","lā","not","না"],["يُشْرِكْنَ","yush'rik'na","they will associate","তারা শিরক করবে"],["بِٱللَّهِ","bil-lahi","with Allah","আল্লাহর সাথে"],["شَيْـًۭٔا","shayan","anything","কোনকিছু"],["وَلَا","walā","and not","এবং না"],["يَسْرِقْنَ","yasriq'na","they will steal","তারা চুরি করবে"],["وَلَا","walā","and not","আর না"],["يَزْنِينَ","yaznīna","they will commit adultery","তারা জিনা করবে না"],["وَلَا","walā","and not","এবং না"],["يَقْتُلْنَ","yaqtul'na","they will kill","তারা হত্যা করবে"],["أَوْلَـٰدَهُنَّ","awlādahunna","their children","তাআদের সন্তানদের"],["وَلَا","walā","and not","ও না"],["يَأْتِينَ","yatīna","they bring","তারা আনবে"],["بِبُهْتَـٰنٍۢ","bibuh'tānin","slander","অপমান"],["يَفْتَرِينَهُۥ","yaftarīnahu","they invent it","তা তারা রচনা করে"],["بَيْنَ","bayna","between","মাঝে"],["أَيْدِيهِنَّ","aydīhinna","their hands","তাদের হাতগুলো"],["وَأَرْجُلِهِنَّ","wa-arjulihinna","and their feet","ও তাদের পাগুলো"],["وَلَا","walā","and not","এবং না"],["يَعْصِينَكَ","ya‘ṣīnaka","they will disobey you","তোমরা তারা অবাধ্য হবে"],["فِى","fī","in","ক্ষেত্রে"],["مَعْرُوفٍۢ ۙ","ma‘rūfin","(the) right","সৎকাজের"],["فَبَايِعْهُنَّ","fabāyi‘'hunna","then accept their pledge","তাদের বয়াত নাও তবে"],["وَٱسْتَغْفِرْ","wa-is'taghfir","and ask forgiveness","ও ক্ষমা চাও"],["لَهُنَّ","lahunna","for them","তাদের জন্য (কাফিরদের)"],["ٱللَّهَ ۖ","l-laha","(from) Allah","আল্লাহর (কাছে)"],["إِنَّ","inna","Indeed","নিশ্চই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["غَفُورٌۭ","ghafūrun","(is) Oft-Forgiving","ক্ষমাশীল"],["رَّحِيمٌۭ","raḥīmun","Most Merciful","মেহেরবান"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</><l>ل</><g>نَّ</>بِىُّ إِذَا <o>جَآ</>ءَكَ <h>ٱ</>لْمُؤْمِ<m>نَٰ</>تُ يُبَايِعْنَكَ عَلَ<o>ىٰٓ</> <w>أَن لَّ</>ا يُشْرِكْنَ بِ<h>ٱ</>للَّهِ شَ<d>يْـًۭٔا وَ</>لَا يَسْرِ<q>قْ</>نَ وَلَا يَزْنِينَ وَلَا يَ<q>قْ</>تُلْنَ أَوْ<m>لَٰ</>دَهُ<g>نَّ</> وَلَا يَأْتِينَ بِبُهْ<m>تَٰ</><d>نٍۢ يَ</>فْتَرِينَهُ<m>ۥ</> بَيْنَ أَيْدِيهِ<g>نَّ</> وَأَرْجُلِهِ<g>نَّ</> وَلَا يَعْصِينَكَ فِى مَعْرُو<k>فٍۢ ۙ فَ</>بَايِعْهُ<g>نَّ</> وَ<h>ٱ</>سْتَغْفِرْ لَهُ<g>نَّ</> <h>ٱ</>للَّهَ ۖ إِ<g>نَّ</> <h>ٱ</>للَّهَ غَفُو<w>رٌۭ رَّ</><p>حِي</>مٌۭ"},{"n":13,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you","ওহে"],["ٱلَّذِينَ","alladhīna","who","যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছ"],["لَا","lā","(Do) not","না"],["تَتَوَلَّوْا۟","tatawallaw","make allies","তোমতা বন্ধুত্ব করো"],["قَوْمًا","qawman","(of) a people","লোকদের (সংগে)"],["غَضِبَ","ghaḍiba","(The) wrath","গযব দিয়েছেন"],["ٱللَّهُ","l-lahu","(of) Allah","আল্লাহ"],["عَلَيْهِمْ","‘alayhim","(is) upon them","যাদের উপর"],["قَدْ","qad","Indeed","নিশ্চই"],["يَئِسُوا۟","ya-isū","they despair","তারা নিরাশ হয়েছে"],["مِنَ","mina","of","থেকে"],["ٱلْـَٔاخِرَةِ","l-ākhirati","the Hereafter","পরকাল"],["كَمَا","kamā","as","যেমন"],["يَئِسَ","ya-isa","despair","নিরাশ হয়েছে"],["ٱلْكُفَّارُ","l-kufāru","the disbelievers","কাফিররা"],["مِنْ","min","of","থেকে"],["أَصْحَـٰبِ","aṣḥābi","(the) companions","অধিবাসীদের"],["ٱلْقُبُورِ","l-qubūri","(of) the graves","কবরগু্লো"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> لَا تَتَوَلَّوْ<s>ا۟</> قَوْمًا غَضِبَ <h>ٱ</>للَّهُ عَلَيْهِمْ قَ<q>دْ</> يَئِسُو<s>ا۟</> مِنَ <h>ٱ</>لْءَاخِرَةِ كَمَا يَئِسَ <h>ٱ</>لْكُفَّارُ مِنْ أَصْ<m>حَٰ</>بِ <h>ٱ</>لْقُ<p>بُو</>رِ"}]}