["كُبِتُوا۟","kubitū","(will) be disgraced","তাদের লাঞ্ছিত করা হবে"],["كَمَا","kamā","as","যেমন"],["كُبِتَ","kubita","were disgraced","লাঞ্ছিত করা হয়েছিল"],["ٱلَّذِينَ","alladhīna","those","(তাদেরকে) যারা"],["مِن","min","before them","থেকে"],["قَبْلِهِمْ ۚ","qablihim","before them","তাদের পূর্বে (ছিল)"],["وَقَدْ","waqad","And certainly","এবং নিশ্চয়ই"],["أَنزَلْنَآ","anzalnā","We have sent down","আমরা অবতীর্ণ করেছি"],["ءَايَـٰتٍۭ","āyātin","Verses","আয়াতসমূহ"],["بَيِّنَـٰتٍۢ ۚ","bayyinātin","clear","সুস্পষ্ট"],["وَلِلْكَـٰفِرِينَ","walil'kāfirīna","And for the disbelievers","এবং কাফিরদের জন্যে রয়েছে"],["عَذَابٌۭ","‘adhābun","(is) a punishment","শাস্তি"],["مُّهِينٌۭ","muhīnun","humiliating","অপমানকর"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ يُ<n>حَآ</>دُّونَ <h>ٱ</>للَّهَ وَرَسُولَهُ<m>ۥ</> كُبِتُو<s>ا۟</> كَمَا كُبِتَ <h>ٱ</>لَّذِينَ مِ<k>ن قَ</><q>بْ</>لِهِمْ ۚ وَقَ<q>دْ</> أَ<k>نزَ</>لْ<o>نَآ</> ءَا<m>يَٰ</><i>تٍۭ بَ</>يِّ<m>نَٰ</><d>تٍۢ ۚ وَ</>لِلْ<m>كَٰ</>فِرِينَ عَذَا<d>بٌۭ مُّ</><p>هِي</>نٌۭ"},{"n":6,"w":[["يَوْمَ","yawma","(On the) Day","যেদিন"],["يَبْعَثُهُمُ","yab‘athuhumu","(when) Allah will raise them","তাদের উত্থিত করবেন"],["ٱللَّهُ","l-lahu","(when) Allah will raise them","আল্লাহ্‌"],["جَمِيعًۭا","jamī‘an","all","সকলকেই"],["فَيُنَبِّئُهُم","fayunabbi-uhum","and inform them","অতঃপর তাদের জানিয়ে দিবেন"],["بِمَا","bimā","of what","যা"],["عَمِلُوٓا۟ ۚ","‘amilū","they did","তারা কাজ করেছে"],["أَحْصَىٰهُ","aḥṣāhu","Allah has recorded it","তা গুণে রেখেছেন"],["ٱللَّهُ","l-lahu","Allah has recorded it","আল্লাহ্‌"],["وَنَسُوهُ ۚ","wanasūhu","while they forgot it","অথচ তা তারা ভুলে গেছে"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ্‌"],["عَلَىٰ","‘alā","(is) over","উপর"],["كُلِّ","kulli","all","সব"],["شَىْءٍۢ","shayin","things","কিছুরই"],["شَهِيدٌ","shahīdun","a Witness","সাক্ষী"]],"t":"يَوْمَ يَ<q>بْ</>عَثُهُمُ <h>ٱ</>للَّهُ جَمِي<k>عًۭا فَ</>يُنَبِّئُ<f>هُم بِ</>مَا عَمِ<o>لُوٓ</><s>ا۟</> ۚ أَحْصَ<m>ىٰ</>هُ <h>ٱ</>للَّهُ وَنَسُوهُ ۚ وَ<h>ٱ</>للَّهُ عَلَىٰ كُلِّ <k>شَىْءٍۢ شَ</><p>هِي</><q>دٌ</>"},{"n":7,"w":[["أَلَمْ","alam","Do not","না কি"],["تَرَ","tara","you see","তুমি জানো"],["أَنَّ","anna","that","যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["يَعْلَمُ","ya‘lamu","knows","জানেন"],["مَا","mā","whatever","যা কিছু"],["فِى","fī","(is) in","মধ্যে আছে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশসমূহের"],["وَمَا","wamā","and whatever","এবং যা কিছু"],["فِى","fī","(is) in","মধ্যে আছে"],["ٱلْأَرْضِ ۖ","l-arḍi","the earth","পৃথিবীর"],["مَا","mā","Not","না"],["يَكُونُ","yakūnu","there is","হতে পারে"],["مِن","min","any","কোনো"],["نَّجْوَىٰ","najwā","secret counsel","গোপন পরামর্শ"],["ثَلَـٰثَةٍ","thalāthatin","(of) three","তিনজনের"],["إِلَّا","illā","but","এছাড়া"],["هُوَ","huwa","He (is)","তিনি (থাকেন)"],["رَابِعُهُمْ","rābi‘uhum","(the) fourth of them","তাদের চতুর্থজন"],["وَلَا","walā","and not","এবং না"],["خَمْسَةٍ","khamsatin","five","পাঁচজনের"],["إِلَّا","illā","but","এছাড়া"],["هُوَ","huwa","He (is)","তিনি (হবেন)"],["سَادِسُهُمْ","sādisuhum","(the) sixth of them","তাদের ষষ্ঠজন"],["وَلَآ","walā","and not","এবং না"],["أَدْنَىٰ","adnā","less","কম হোক"],["مِن","min","than","চেয়ে"],["ذَٰلِكَ","dhālika","that","এর"],["وَلَآ","walā","and not","এবং না"],["أَكْثَرَ","akthara","more","বেশি (হোক)"],["إِلَّا","illā","but","এছাড়া"],["هُوَ","huwa","He","তিনি"],["مَعَهُمْ","ma‘ahum","(is) with them","তাদের সাথে (আছেন)"],["أَيْنَ","ayna","wherever","যেখানেই"],["مَا","mā","wherever","না"],["كَانُوا۟ ۖ","kānū","they are","তারা থাকুক"],["ثُمَّ","thumma","Then","এরপর"],["يُنَبِّئُهُم","yunabbi-uhum","He will inform them","তাদের জানাবেন"],["بِمَا","bimā","of what","ঐ বিষয়ে যা"],["عَمِلُوا۟","‘amilū","they did","তারা কাজ করেছে"],["يَوْمَ","yawma","(on the) Day","দিনে"],["ٱلْقِيَـٰمَةِ ۚ","l-qiyāmati","(of) the Resurrection","কিয়ামতের"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["بِكُلِّ","bikulli","of every","সব সম্পর্কে"],["شَىْءٍ","shayin","thing","কিছুর"],["عَلِيمٌ","‘alīmun","(is) All-Knower","খুব অবহিত"]],"t":"أَلَمْ تَرَ أَ<g>نَّ</> <h>ٱ</>للَّهَ يَعْلَمُ مَا فِى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَمَا فِى <h>ٱ</>لْأَرْضِ ۖ مَا يَكُونُ <d>مِن نَّ</><q>جْ</>وَىٰ ثَ<m>لَٰ</>ثَةٍ إِلَّا هُوَ رَابِعُهُمْ وَلَا خَمْسَةٍ إِلَّا هُوَ سَادِسُهُمْ وَ<o>لَآ</> أَ<q>دْ</>نَىٰ مِ<k>ن ذَٰ</>لِكَ وَ<o>لَآ</> أَكْثَرَ إِلَّا هُوَ مَعَهُمْ أَيْنَ مَا كَانُو<s>ا۟ ۖ</> ثُ<g>مَّ</> يُنَبِّئُ<f>هُم بِ</>مَا عَمِلُو<s>ا۟</> يَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ بِكُلِّ شَىْءٍ عَ<p>لِي</>مٌ"},{"n":8,"w":[["أَلَمْ","alam","Do not","নি কি"],["تَرَ","tara","you see","তুমি দেখ"],["إِلَى","ilā","[to]","দিকে"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যাদের"],["نُهُوا۟","nuhū","were forbidden","নিষেধ করা হয়েছিল"],["عَنِ","‘ani","from","হতে"],["ٱلنَّجْوَىٰ","l-najwā","secret counsels","গোপন পরামর্শ"],["ثُمَّ","thumma","then","এরপর"],["يَعُودُونَ","ya‘ūdūna","they return","তারা পুনরাবৃত্তি করে"],["لِمَا","limā","to what","ঐ বিষয়ে যা"],["نُهُوا۟","nuhū","they were forbidden","নিষেধ করা হয়েছিল"],["عَنْهُ","‘anhu","from [it]","তা হতে"],["وَيَتَنَـٰجَوْنَ","wayatanājawna","and they hold secret counsels","ও পরস্পর গোপন পরামর্শ করে"],["بِٱلْإِثْمِ","bil-ith'mi","for sin","পাপের"],["وَٱلْعُدْوَٰنِ","wal-‘ud'wāni","and aggression","ও বাড়াবাড়ির"],["وَمَعْصِيَتِ","wama‘ṣiyati","and disobedience","এবং অবাধ্যতার (জন্যে)"],["ٱلرَّسُولِ","l-rasūli","(to) the Messenger","রাসূলের"],["وَإِذَا","wa-idhā","And when","এবং যখন"],["جَآءُوكَ","jāūka","they come to you","তারা তোমার কাছে আসে"],["حَيَّوْكَ","ḥayyawka","they greet you","তোমাকে অভিবাদন করে"],["بِمَا","bimā","with what","এমন ভাবে"],["لَمْ","lam","not","নি"],["يُحَيِّكَ","yuḥayyika","greets you","তোমাকে অভিবাদন করে"],["بِهِ","bihi","therewith","যেভাবে"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ্‌"],["وَيَقُولُونَ","wayaqūlūna","and they say","এবং তারা বলে"],["فِىٓ","fī","among","মধ্যে"],["أَنفُسِهِمْ","anfusihim","themselves","তাদের নিজেদের (মনের)"],["لَوْلَا","lawlā","Why (does) not","\"না কেন"],["يُعَذِّبُنَا","yu‘adhibunā","Allah punish us","আমাদেরকে শাস্তি দেন"],["ٱللَّهُ","l-lahu","Allah punish us","আল্লাহ্‌"],["بِمَا","bimā","for what","একারনে যা"],["نَقُولُ ۚ","naqūlu","we say","বলি আমরা\""],["حَسْبُهُمْ","ḥasbuhum","Sufficient (for) them","তাদের জন্যে যথেষ্ট"],["جَهَنَّمُ","jahannamu","(is) Hell","জাহান্নাম"],["يَصْلَوْنَهَا ۖ","yaṣlawnahā","they will burn in it","তাতে তারা প্রবেশ করবে"],["فَبِئْسَ","fabi'sa","and worst is","অতি নিকৃষ্ট তা"],["ٱلْمَصِيرُ","l-maṣīru","the destination","আবাসস্থল (হিসেবে)"]],"t":"أَلَمْ تَرَ إِلَى <h>ٱ</>لَّذِينَ نُهُو<s>ا۟</> عَنِ <h>ٱ</><l>ل</><g>نَّ</><q>جْ</>وَىٰ ثُ<g>مَّ</> يَعُودُونَ لِمَا نُهُو<s>ا۟</> عَنْهُ وَيَتَ<m>نَٰ</>جَوْنَ بِ<h>ٱ</>لْإِثْمِ وَ<h>ٱ</>لْعُ<q>دْ</><m>وَٰ</>نِ وَمَعْصِيَتِ <h>ٱ</><l>ل</>رَّسُولِ وَإِذَا <o>جَآ</>ءُوكَ حَيَّوْكَ بِمَا لَمْ يُحَيِّكَ بِهِ <h>ٱ</>للَّهُ وَيَقُولُونَ <o>فِىٓ</> أَ<k>نفُ</>سِهِمْ لَوْلَا يُعَذِّبُنَا <h>ٱ</>للَّهُ بِمَا نَقُولُ ۚ حَسْبُهُمْ جَهَ<g>نَّ</>مُ يَصْلَوْنَهَا ۖ فَبِئْسَ <h>ٱ</>لْمَ<p>صِي</>رُ"},{"n":9,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you who believe","হে"],["ٱلَّذِينَ","alladhīna","O you who believe","যারা"],["ءَامَنُوٓا۟","āmanū","O you who believe","ঈমান এনেছ"],["إِذَا","idhā","When","যখন"],["تَنَـٰجَيْتُمْ","tanājaytum","you hold secret counsel","তোমরা গোপনে পরামর্শ করো"],["فَلَا","falā","then (do) not","না তবে"],["تَتَنَـٰجَوْا۟","tatanājaw","hold secret counsel","পরস্পরে গোপন পরামর্শ করো"],["بِٱلْإِثْمِ","bil-ith'mi","for sin","পাপের বিষয়ে"],["وَٱلْعُدْوَٰنِ","wal-‘ud'wāni","and aggression","ও বাড়াবাড়ির"],["وَمَعْصِيَتِ","wama‘ṣiyati","and disobedience","এবং অবাধ্যতার (ক্ষেত্রে)"],["ٱلرَّسُولِ","l-rasūli","(to) the Messenger","রাসূলের"],["وَتَنَـٰجَوْا۟","watanājaw","but hold secret counsel","এবং তোমরা গোপনে পরামর্শ করো"],["بِٱلْبِرِّ","bil-biri","for righteousness","কল্যাণকর কাজ সম্পর্কে"],["وَٱلتَّقْوَىٰ ۖ","wal-taqwā","and piety","এবং তাকওয়ার (ক্ষেত্রে)"],["وَٱتَّقُوا۟","wa-ittaqū","And fear","এবং তোমরা ভয় করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["ٱلَّذِىٓ","alladhī","the One Who","যিনি (এমন সত্তা যে)"],["إِلَيْهِ","ilayhi","to Him","তাঁর দিকে"],["تُحْشَرُونَ","tuḥ'sharūna","you will be gathered","তোমাদের সমবেত করা হবে"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَ<o>نُوٓ</><s>ا۟</> إِذَا تَ<m>نَٰ</>جَيْتُمْ فَلَا تَتَ<m>نَٰ</>جَوْ<s>ا۟</> بِ<h>ٱ</>لْإِثْمِ وَ<h>ٱ</>لْعُ<q>دْ</><m>وَٰ</>نِ وَمَعْصِيَتِ <h>ٱ</><l>ل</>رَّسُولِ وَتَ<m>نَٰ</>جَوْ<s>ا۟</> بِ<h>ٱ</>لْبِرِّ وَ<h>ٱ</><l>ل</>تَّ<q>قْ</>وَىٰ ۖ وَ<h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</>للَّهَ <h>ٱ</>لَّ<o>ذِىٓ</> إِلَيْهِ تُحْشَ<p>رُو</>نَ"},{"n":10,"w":[["إِنَّمَا","innamā","Only","মূলত"],["ٱلنَّجْوَىٰ","l-najwā","the secret counsels","গোপন পরামর্শ (করা হয়)"],["مِنَ","mina","(are) from","পক্ষ হতে"],["ٱلشَّيْطَـٰنِ","l-shayṭāni","the Shaitaan","শয়তানের"],["لِيَحْزُنَ","liyaḥzuna","that he may grieve","দুঃখ দেয়ার জন্যে"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["وَلَيْسَ","walaysa","but not","আর না (কেউ)"],["بِضَآرِّهِمْ","biḍārrihim","he (can) harm them","তাদেরকে ক্ষতি করতে পারবে"],["شَيْـًٔا","shayan","(in) anything","কিছুই"],["إِلَّا","illā","except","ব্যতীত"],["بِإِذْنِ","bi-idh'ni","by Allah's permission","অনুমতি"],["ٱللَّهِ ۚ","l-lahi","by Allah's permission","আল্লাহ্‌র"],["وَعَلَى","wa‘alā","And upon","এবং উপর"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌রই"],["فَلْيَتَوَكَّلِ","falyatawakkali","let put (their) trust","ভরসা করা কর্তব্য"],["ٱلْمُؤْمِنُونَ","l-mu'minūna","the believers","মু'মিনদের"]],"t":"إِ<g>نَّ</>مَا <h>ٱ</><l>ل</><g>نَّ</><q>جْ</>وَىٰ مِنَ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نِ لِيَحْزُنَ <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَلَيْسَ بِ<n>ضَآ</>رِّهِمْ شَيْـًٔا إِلَّا بِإِذْنِ <h>ٱ</>للَّهِ ۚ وَعَلَى <h>ٱ</>للَّهِ فَلْيَتَوَكَّلِ <h>ٱ</>لْمُؤْمِ<p>نُو</>نَ"},{"n":11,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you who believe","হে"],["ٱلَّذِينَ","alladhīna","O you who believe","যারা"],["ءَامَنُوٓا۟","āmanū","O you who believe","ঈমান এনেছ"],["إِذَا","idhā","When","যখন"],["قِيلَ","qīla","it is said","বলা হয়"],["لَكُمْ","lakum","to you","তোমাদেরকে"],["تَفَسَّحُوا۟","tafassaḥū","Make room","\"তোমরা প্রশস্ত করে দাও\""],["فِى","fī","in","মধ্যে"],["ٱلْمَجَـٰلِسِ","l-majālisi","the assemblies","বৈঠকের"],["فَٱفْسَحُوا۟","fa-if'saḥū","then make room","তোমরা তখন প্রশস্ত করে দাও"],["يَفْسَحِ","yafsaḥi","Allah will make room","প্রশস্থতা দেবেন"],["ٱللَّهُ","l-lahu","Allah will make room","আল্লাহ্‌"],["لَكُمْ ۖ","lakum","for you","তোমাদেরকে"],["وَإِذَا","wa-idhā","And when","এবং যখন"],["قِيلَ","qīla","it is said","বলা হয়"],["ٱنشُزُوا۟","unshuzū","Rise up","\"তোমরা উঠে যাও\""],["فَٱنشُزُوا۟","fa-unshuzū","then rise up","তোমরা তখন উঠে যেয়ো"],["يَرْفَعِ","yarfa‘i","Allah will raise","উন্নত করবেন/ বাড়িয়ে দেবেন"],["ٱللَّهُ","l-lahu","Allah will raise","আল্লাহ্‌"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["مِنكُمْ","minkum","among you","তোমাদের মধ্য হতে"],["وَٱلَّذِينَ","wa-alladhīna","and those who","এবং যাদের"],["أُوتُوا۟","ūtū","were given","দেয়া হয়েছে"],["ٱلْعِلْمَ","l-‘il'ma","the knowledge","জ্ঞান"],["دَرَجَـٰتٍۢ ۚ","darajātin","(in) degrees","মর্যাদায় (উন্নত করবেন)"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ্‌"],["بِمَا","bimā","of what","সেবিষয়ে যা"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা কাজ করছ"],["خَبِيرٌۭ","khabīrun","(is) All-Aware","খুব অবহিত"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَ<o>نُوٓ</><s>ا۟</> إِذَا قِيلَ لَكُمْ تَفَسَّحُو<s>ا۟</> فِى <h>ٱ</>لْمَ<m>جَٰ</>لِسِ فَ<h>ٱ</>فْسَحُو<s>ا۟</> يَفْسَحِ <h>ٱ</>للَّهُ لَكُمْ ۖ وَإِذَا قِيلَ <h>ٱ</><k>نشُ</>زُو<s>ا۟</> فَ<h>ٱ</><k>نشُ</>زُو<s>ا۟</> يَرْفَعِ <h>ٱ</>للَّهُ <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> مِ<k>نكُ</>مْ وَ<h>ٱ</>لَّذِينَ أُوتُو<s>ا۟</> <h>ٱ</>لْعِلْمَ دَرَ<m>جَٰ</><d>تٍۢ ۚ وَ</><h>ٱ</>للَّهُ بِمَا تَعْمَلُونَ خَ<p>بِي</>رٌۭ"},{"n":12,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you who believe","হে"],["ٱلَّذِينَ","alladhīna","O you who believe","যারা"],["ءَامَنُوٓا۟","āmanū","O you who believe","ঈমান এনেছ"],["إِذَا","idhā","When","যখন"],["نَـٰجَيْتُمُ","nājaytumu","you privately consult","তোমরা একান্তে কথা বলবে"],["ٱلرَّسُولَ","l-rasūla","the Messenger","রাসূলের সাথে"],["فَقَدِّمُوا۟","faqaddimū","then offer","তোমরা পেশ করবে"],["بَيْنَ","bayna","before","(মাঝে)"],["يَدَىْ","yaday","before","পূর্বে"],["نَجْوَىٰكُمْ","najwākum","your private consultation","তোমার একান্তে কথা বলার"],["صَدَقَةًۭ ۚ","ṣadaqatan","charity","সদকা"],["ذَٰلِكَ","dhālika","That","এটা"],["خَيْرٌۭ","khayrun","(is) better","উত্তম"],["لَّكُمْ","lakum","for you","তোমাদের জন্য"],["وَأَطْهَرُ ۚ","wa-aṭharu","and purer","এবং পবিত্র"],["فَإِن","fa-in","But if","আর যদি"],["لَّمْ","lam","not","না"],["تَجِدُوا۟","tajidū","you find","তোমরা পাও (কিছুই)"],["فَإِنَّ","fa-inna","then indeed","নিশ্চয়ই তবে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["غَفُورٌۭ","ghafūrun","(is) Oft-Forgiving","ক্ষমাশীল"],["رَّحِيمٌ","raḥīmun","Most Merciful","পরম দয়ালু"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَ<o>نُوٓ</><s>ا۟</> إِذَا <m>نَٰ</>جَيْتُمُ <h>ٱ</><l>ل</>رَّسُولَ فَقَدِّمُو<s>ا۟</> بَيْنَ يَدَىْ نَ<q>جْ</>وَ<m>ىٰ</>كُمْ صَدَقَ<k>ةًۭ ۚ ذَٰ</>لِكَ خَيْ<w>رٌۭ لَّ</>كُمْ وَأَ<q>طْ</>هَرُ ۚ فَ<w>إِن لَّ</>مْ تَجِدُو<s>ا۟</> فَإِ<g>نَّ</> <h>ٱ</>للَّهَ غَفُو<w>رٌۭ رَّ</><p>حِي</>مٌ"},{"n":13,"w":[["ءَأَشْفَقْتُمْ","a-ashfaqtum","Are you afraid","তোমরা কি ভয় পেয়ে গেছ"],["أَن","an","to","যে"],["تُقَدِّمُوا۟","tuqaddimū","offer","তোমরা দিবে"],["بَيْنَ","bayna","before","(মাঝে)"],["يَدَىْ","yaday","before","পূর্বে"],["نَجْوَىٰكُمْ","najwākum","your private consultation","তোমাদের একান্তে কথা বলার"],["صَدَقَـٰتٍۢ ۚ","ṣadaqātin","charities","সদকা"],["فَإِذْ","fa-idh","Then when","যদি অতঃপর"],["لَمْ","lam","you do not","না"],["تَفْعَلُوا۟","taf‘alū","you do not","তোমরা করতে পার"],["وَتَابَ","watāba","and Allah has forgiven","আর মাফ করে দিলেন"],["ٱللَّهُ","l-lahu","and Allah has forgiven","আল্লাহ্‌"],["عَلَيْكُمْ","‘alaykum","you","তোমাদেরকে"],["فَأَقِيمُوا۟","fa-aqīmū","then establish","তবে তোমরা প্রতিষ্ঠা কর"],["ٱلصَّلَوٰةَ","l-ṣalata","the prayer","সালাত"],["وَءَاتُوا۟","waātū","and give","এবং তোমরা দাও"],["ٱلزَّكَوٰةَ","l-zakata","the zakah","জাকাত"],["وَأَطِيعُوا۟","wa-aṭī‘ū","and obey","এবং তোমরা আনুগত্য করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌র"],["وَرَسُولَهُۥ ۚ","warasūlahu","and His Messenger","ও তাঁর রাসূলের"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ্‌"],["خَبِيرٌۢ","khabīrun","(is) All-Aware","খুব অবহিত"],["بِمَا","bimā","of what","ঐ বিষয়ে যা"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা কাজ কর"]],"t":"ءَأَشْفَ<q>قْ</>تُمْ أَ<k>ن تُ</>قَدِّمُو<s>ا۟</> بَيْنَ يَدَىْ نَ<q>جْ</>وَ<m>ىٰ</>كُمْ صَدَ<m>قَٰ</><k>تٍۢ ۚ فَ</>إِذْ لَمْ تَفْعَلُو<s>ا۟</> وَتَابَ <h>ٱ</>للَّهُ عَلَيْكُمْ فَأَقِيمُو<s>ا۟</> <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةَ وَءَاتُو<s>ا۟</> <h>ٱ</><l>ل</>زَّكَ<s>وٰ</>ةَ وَأَطِيعُو<s>ا۟</> <h>ٱ</>للَّهَ وَرَسُولَهُ<m>ۥ</> ۚ وَ<h>ٱ</>للَّهُ خَبِي<i>رٌۢ بِ</>مَا تَعْمَ<p>لُو</>نَ"},{"n":14,"w":[["۞ أَلَمْ","alam","Do not","নি কি"],["تَرَ","tara","you see","তুমি দেখ"],["إِلَى","ilā","[to]","প্রতি"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["تَوَلَّوْا۟","tawallaw","take as allies","বন্ধু বানিয়ে নিয়েছে"],["قَوْمًا","qawman","a people","(এমন) সম্প্রদায়"],["غَضِبَ","ghaḍiba","wrath","অভিশাপ দিয়েছেন"],["ٱللَّهُ","l-lahu","(of) Allah","আল্লাহ্‌"],["عَلَيْهِم","‘alayhim","(is) upon them","যাদের উপর"],["مَّا","mā","They (are) not","না"],["هُم","hum","They (are) not","তারা"],["مِّنكُمْ","minkum","of you","তোমাদের অন্তর্ভুক্ত"],["وَلَا","walā","and not","এবং না"],["مِنْهُمْ","min'hum","of them","তাদের অন্তর্ভুক্ত"],["وَيَحْلِفُونَ","wayaḥlifūna","and they swear","এবং তারা শপথ করে"],["عَلَى","‘alā","to","উপর"],["ٱلْكَذِبِ","l-kadhibi","the lie","মিথ্যার"],["وَهُمْ","wahum","while they","অথচ তারা"],["يَعْلَمُونَ","ya‘lamūna","know","জানেও"]],"t":"۞ أَلَمْ تَرَ إِلَى <h>ٱ</>لَّذِينَ تَوَلَّوْ<s>ا۟</> قَوْمًا غَضِبَ <h>ٱ</>للَّهُ عَلَيْ<y>هِم مَّ</>ا <y>هُم مِّ</><k>نكُ</>مْ وَلَا مِنْهُمْ وَيَحْلِفُونَ عَلَى <h>ٱ</>لْكَذِبِ وَهُمْ يَعْلَ<p>مُو</>نَ"},{"n":15,"w":[["أَعَدَّ","a‘adda","Allah has prepared","প্রস্তুত রেখেছেন"],["ٱللَّهُ","l-lahu","Allah has prepared","আল্লাহ্‌"],["لَهُمْ","lahum","for them","তাদের জন্যে"],["عَذَابًۭا","‘adhāban","a punishment","শাস্তি"],["شَدِيدًا ۖ","shadīdan","severe","কঠোর"],["إِنَّهُمْ","innahum","Indeed, [they]","নিশ্চয়ই তারা"],["سَآءَ","sāa","evil is","অতি মন্দ"],["مَا","mā","what","যা কিছু"],["كَانُوا۟","kānū","they used to","তারা ছিল"],["يَعْمَلُونَ","ya‘malūna","do","তারা কাজ করে আসছে"]],"t":"أَعَدَّ <h>ٱ</>للَّهُ لَهُمْ عَذَا<k>بًۭا شَ</>دِيدًا ۖ إِ<g>نَّ</>هُمْ <o>سَآ</>ءَ مَا كَانُو<s>ا۟</> يَعْمَ<p>لُو</>نَ"},{"n":16,"w":[["ٱتَّخَذُوٓا۟","ittakhadhū","They have taken","তারা গ্রহণ করেছে"],["أَيْمَـٰنَهُمْ","aymānahum","their oaths","তাদের শপথগুলোকে"],["جُنَّةًۭ","junnatan","(as) a cover","ঢালস্বরূপ"],["فَصَدُّوا۟","faṣaddū","so they hinder","অতঃপর তারা বাধা দেয়"],["عَن","‘an","from","হতে"],["سَبِيلِ","sabīli","(the) way of Allah","পথ"],["ٱللَّهِ","l-lahi","(the) way of Allah","আল্লাহ্‌র"],["فَلَهُمْ","falahum","so for them","অতএব তাদের জন্য (রয়েছে)"],["عَذَابٌۭ","‘adhābun","(is) a punishment","শাস্তি"],["مُّهِينٌۭ","muhīnun","humiliating","অপমানকর"]],"t":"ٱتَّخَ<o>ذُوٓ</><s>ا۟</> أَيْ<m>مَٰ</>نَهُمْ جُ<g>نَّ</><k>ةًۭ فَ</>صَدُّو<s>ا۟</> عَ<k>ن سَ</>بِيلِ <h>ٱ</>للَّهِ فَلَهُمْ عَذَا<d>بٌۭ مُّ</><p>هِي</>نٌۭ"},{"n":17,"w":[["لَّن","lan","Never","কখনই না"],["تُغْنِىَ","tugh'niya","will avail","কাজে লাগবে"],["عَنْهُمْ","‘anhum","them","তাদের জন্যে"],["أَمْوَٰلُهُمْ","amwāluhum","their wealth","তাদের ধনসম্পদ"],["وَلَآ","walā","and not","এবং না"],["أَوْلَـٰدُهُم","awlāduhum","their children","তাদের সন্তানাদি (বাঁচার জন্য)"],["مِّنَ","mina","against","হতে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌"],["شَيْـًٔا ۚ","shayan","(in) anything","কিছুমাত্র"],["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব লোক"],["أَصْحَـٰبُ","aṣḥābu","(will be) companions","অধিবাসী"],["ٱلنَّارِ ۖ","l-nāri","(of) the Fire","জাহান্নামের"],["هُمْ","hum","they","তারা"],["فِيهَا","fīhā","in it","তার মধ্যে"],["خَـٰلِدُونَ","khālidūna","will abide forever","চিরকাল থাকবে"]],"t":"لَّ<k>ن تُ</>غْنِىَ عَنْهُمْ أَمْ<m>وَٰ</>لُهُمْ وَ<o>لَآ</> أَوْ<m>لَٰ</>دُ<y>هُم مِّ</>نَ <h>ٱ</>للَّهِ شَيْـًٔا ۚ أُ<s>و۟</><o>لَٰٓ</>ئِكَ أَصْ<m>حَٰ</>بُ <h>ٱ</><l>ل</><g>نَّ</>ارِ ۖ هُمْ فِيهَا <m>خَٰ</>لِ<p>دُو</>نَ"},{"n":18,"w":[["يَوْمَ","yawma","(On the) Day","যেদিন"],["يَبْعَثُهُمُ","yab‘athuhumu","Allah will raise them","তাদের উঠাবেন"],["ٱللَّهُ","l-lahu","Allah will raise them","আল্লাহ্‌"],["جَمِيعًۭا","jamī‘an","all","সকলকেই"],["فَيَحْلِفُونَ","fayaḥlifūna","then they will swear","তারা তখনও শপথ করবে"],["لَهُۥ","lahu","to Him","তাঁর কাছে"],["كَمَا","kamā","as","যেমন"],["يَحْلِفُونَ","yaḥlifūna","they swear","তারা শপথ করে"],["لَكُمْ ۖ","lakum","to you","তোমাদের কাছে"],["وَيَحْسَبُونَ","wayaḥsabūna","And they think","ও তারা মনে করে"],["أَنَّهُمْ","annahum","that they","যে তারা"],["عَلَىٰ","‘alā","(are) on","(প্রতিষ্ঠিত) উপর"],["شَىْءٍ ۚ","shayin","something","কোনো কিছুর"],["أَلَآ","alā","No doubt","সাবধান"],["إِنَّهُمْ","innahum","Indeed, they","নিশ্চয়ই তারা"],["هُمُ","humu","[they]","তারাই"],["ٱلْكَـٰذِبُونَ","l-kādhibūna","(are) the liars","মিথ্যাবাদী"]],"t":"يَوْمَ يَ<q>بْ</>عَثُهُمُ <h>ٱ</>للَّهُ جَمِي<k>عًۭا فَ</>يَحْلِفُونَ لَهُ<m>ۥ</> كَمَا يَحْلِفُونَ لَكُمْ ۖ وَيَحْسَبُونَ أَ<g>نَّ</>هُمْ عَلَىٰ شَىْءٍ ۚ أَ<o>لَآ</> إِ<g>نَّ</>هُمْ هُمُ <h>ٱ</>لْ<m>كَٰ</>ذِ<p>بُو</>نَ"},{"n":19,"w":[["ٱسْتَحْوَذَ","is'taḥwadha","Has overcome","প্রভুত্ব বিস্তার করেছে"],["عَلَيْهِمُ","‘alayhimu","them","তাদের উপর"],["ٱلشَّيْطَـٰنُ","l-shayṭānu","the Shaitaan","শয়তান"],["فَأَنسَىٰهُمْ","fa-ansāhum","so he made them forget","অতঃপর তাদের ভুলিয়ে দিয়েছে"],["ذِكْرَ","dhik'ra","(the) remembrance","স্মরণ"],["ٱللَّهِ ۚ","l-lahi","(of) Allah","আল্লাহ্‌র"],["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব লোক (অন্তর্ভুক্ত)"],["حِزْبُ","ḥiz'bu","(are the) party","দলের"],["ٱلشَّيْطَـٰنِ ۚ","l-shayṭāni","(of) the Shaitaan","শয়তানের"],["أَلَآ","alā","No doubt","সাবধান"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["حِزْبَ","ḥiz'ba","(the) party","দল"],["ٱلشَّيْطَـٰنِ","l-shayṭāni","(of) the Shaitaan","শয়তানের"],["هُمُ","humu","they","তারাই"],["ٱلْخَـٰسِرُونَ","l-khāsirūna","(will be) the losers","ক্ষতিগ্রস্ত হবে"]],"t":"ٱسْتَحْوَذَ عَلَيْهِمُ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نُ فَأَ<k>نسَ</><m>ىٰ</>هُمْ ذِكْرَ <h>ٱ</>للَّهِ ۚ أُ<s>و۟</><o>لَٰٓ</>ئِكَ حِزْبُ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نِ ۚ أَ<o>لَآ</> إِ<g>نَّ</> حِزْبَ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نِ هُمُ <h>ٱ</>لْ<m>خَٰ</>سِ<p>رُو</>نَ"},{"n":20,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["يُحَآدُّونَ","yuḥāddūna","oppose","বিরোধিতা করে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌র"],["وَرَسُولَهُۥٓ","warasūlahu","and His Messenger","ও তাঁর রাসূলের"],["أُو۟لَـٰٓئِكَ","ulāika","those","ঐসব লোক"],["فِى","fī","(will be) among","অন্তর্ভুক্ত"],["ٱلْأَذَلِّينَ","l-adhalīna","the most humiliated","চরম অপমানিতদের"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ يُ<n>حَآ</>دُّونَ <h>ٱ</>للَّهَ وَرَسُولَهُ<o>ۥٓ</> أُ<s>و۟</><o>لَٰٓ</>ئِكَ فِى <h>ٱ</>لْأَذَ<p>لِّي</>نَ"},{"n":21,"w":[["كَتَبَ","kataba","Allah has decreed","লিখে দিয়েছেন"],["ٱللَّهُ","l-lahu","Allah has decreed","আল্লাহ্‌"],["لَأَغْلِبَنَّ","la-aghlibanna","Surely, I will overcome","\"অবশ্যই বিজয়ী হব"],["أَنَا۠","anā","I","আমি"],["وَرُسُلِىٓ ۚ","warusulī","and My Messengers","ও আমার রাসূলরা\""],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["قَوِىٌّ","qawiyyun","(is) All-Strong","শক্তিধর"],["عَزِيزٌۭ","‘azīzun","All-Mighty","পরাক্রমশালী"]],"t":"كَتَبَ <h>ٱ</>للَّهُ لَأَغْلِبَ<g>نَّ</> أَنَا۠ وَرُسُ<o>لِىٓ ۚ</> إِ<g>نَّ</> <h>ٱ</>للَّهَ قَوِىٌّ عَ<p>زِي</>زٌۭ"},{"n":22,"w":[["لَّا","lā","You will not find","না"],["تَجِدُ","tajidu","You will not find","পাবে তুমি"],["قَوْمًۭا","qawman","a people","সম্প্রদায়কে (এমন যে)"],["يُؤْمِنُونَ","yu'minūna","who believe","বিশ্বাস করে"],["بِٱللَّهِ","bil-lahi","in Allah","আল্লাহ্‌র উপর"],["وَٱلْيَوْمِ","wal-yawmi","and the Day","ও উপর দিনের"],["ٱلْـَٔاخِرِ","l-ākhiri","the Last","শেষ"],["يُوَآدُّونَ","yuwāddūna","loving","(আবার তারা) বন্ধুত্বও করে"],["مَنْ","man","(those) who","(তাদের সাথে) যারা"],["حَآدَّ","ḥādda","oppose","বিরোধিতা করে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌র"],["وَرَسُولَهُۥ","warasūlahu","and His Messenger","ও তাঁর রাসূলের"],["وَلَوْ","walaw","even if","এবং যদিও"],["كَانُوٓا۟","kānū","they were","তারা হয়"],["ءَابَآءَهُمْ","ābāahum","their fathers","তাদের পিতা"],["أَوْ","aw","or","বা"],["أَبْنَآءَهُمْ","abnāahum","their sons","তাদের পুত্র"],["أَوْ","aw","or","বা"],["إِخْوَٰنَهُمْ","ikh'wānahum","their brothers","তাদের ভাইয়েরা"],["أَوْ","aw","or","বা"],["عَشِيرَتَهُمْ ۚ","‘ashīratahum","their kindred","তাদের জাতি-গোত্র"],["أُو۟لَـٰٓئِكَ","ulāika","Those ","ঐসব লোক (আল্লাহ)"],["كَتَبَ","kataba","He has decreed","সুদৃঢ় করে দিয়েছেন"],["فِى","fī","within","মধ্যে"],["قُلُوبِهِمُ","qulūbihimu","their hearts","তাদের অন্তর সমূহের"],["ٱلْإِيمَـٰنَ","l-īmāna","faith","ঈমান"],["وَأَيَّدَهُم","wa-ayyadahum","and supported them","ও তাদের শক্তিশালী করেছেন"],["بِرُوحٍۢ","birūḥin","with a spirit","রূহ দিয়ে"],["مِّنْهُ ۖ","min'hu","from Him","তাঁর পক্ষ হতে"],["وَيُدْخِلُهُمْ","wayud'khiluhum","And He will admit them","এবং তাদেরকে প্রবেশ করাবেন"],["جَنَّـٰتٍۢ","jannātin","(to) Gardens","জান্নাতে"],["تَجْرِى","tajrī","flow","প্রবাহিত হয়"],["مِن","min","from","থেকে"],["تَحْتِهَا","taḥtihā","underneath it","তার নিচ"],["ٱلْأَنْهَـٰرُ","l-anhāru","the rivers","ঝর্ণাধারা সমূহ"],["خَـٰلِدِينَ","khālidīna","will abide forever","তারা চিরকাল থাকবে"],["فِيهَا ۚ","fīhā","in it","তার মধ্যে"],["رَضِىَ","raḍiya","Allah is pleased","সন্তুষ্ট/ প্রসন্ন হয়েছেন"],["ٱللَّهُ","l-lahu","Allah is pleased","আল্লাহ"],["عَنْهُمْ","‘anhum","with them","তাদের প্রতি"],["وَرَضُوا۟","waraḍū","and they are pleased","ও তারা সন্তুষ্ট হয়েছে"],["عَنْهُ ۚ","‘anhu","with Him","তাঁর প্রতি"],["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব লোক(অন্তর্ভুক্ত)"],["حِزْبُ","ḥiz'bu","(are the) party","দলের"],["ٱللَّهِ ۚ","l-lahi","(of) Allah","আল্লাহর"],["أَلَآ","alā","No doubt","জেনে রাখ"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["حِزْبَ","ḥiz'ba","(the) party","দল"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["هُمُ","humu","they","তারাই"],["ٱلْمُفْلِحُونَ","l-muf'liḥūna","(are) the successful ones","সফলকাম"]],"t":"لَّا تَجِدُ قَوْ<d>مًۭا يُ</>ؤْمِنُونَ بِ<h>ٱ</>للَّهِ وَ<h>ٱ</>لْيَوْمِ <h>ٱ</>لْءَاخِرِ يُ<n>وَآ</>دُّونَ مَنْ <n>حَآ</>دَّ <h>ٱ</>للَّهَ وَرَسُولَهُ<m>ۥ</> وَلَوْ كَا<o>نُوٓ</><s>ا۟</> ءَا<o>بَآ</>ءَهُمْ أَوْ أَ<q>بْ</><o>نَآ</>ءَهُمْ أَوْ إِخْ<m>وَٰ</>نَهُمْ أَوْ عَشِيرَتَهُمْ ۚ أُ<s>و۟</><o>لَٰٓ</>ئِكَ كَتَبَ فِى قُلُوبِهِمُ <h>ٱ</>لْإِي<m>مَٰ</>نَ وَأَيَّدَ<f>هُم بِ</>رُو<d>حٍۢ مِّ</>نْهُ ۖ وَيُ<q>دْ</>خِلُهُمْ جَ<g>نَّٰ</><k>تٍۢ تَ</><q>جْ</>رِى مِ<k>ن تَ</>حْتِهَا <h>ٱ</>لْأَنْ<m>هَٰ</>رُ <m>خَٰ</>لِدِينَ فِيهَا ۚ رَضِىَ <h>ٱ</>للَّهُ عَنْهُمْ وَرَضُو<s>ا۟</> عَنْهُ ۚ أُ<s>و۟</><o>لَٰٓ</>ئِكَ حِزْبُ <h>ٱ</>للَّهِ ۚ أَ<o>لَآ</> إِ<g>نَّ</> حِزْبَ <h>ٱ</>للَّهِ هُمُ <h>ٱ</>لْمُفْلِ<p>حُو</>نَ"}]}