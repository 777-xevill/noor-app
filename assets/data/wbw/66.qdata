,"আমাদেরকে"],["إِنَّكَ","innaka","Indeed, You","তুমি নিশ্চয়"],["عَلَىٰ","‘alā","(are) over","উপর"],["كُلِّ","kulli","every","সব"],["شَىْءٍۢ","shayin","thing","কিছুর"],["قَدِيرٌۭ","qadīrun","All-Powerful","ক্ষমতাবান\""]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> تُو<o>بُوٓ</><s>ا۟</> إِلَى <h>ٱ</>للَّهِ تَوْبَ<d>ةًۭ نَّ</>صُوحًا عَسَىٰ رَبُّكُمْ <d>أَن يُ</>كَفِّرَ عَ<k>نكُ</>مْ سَيِّـَٔاتِكُمْ وَيُ<q>دْ</>خِلَكُمْ جَ<g>نَّٰ</><k>تٍۢ تَ</><q>جْ</>رِى مِ<k>ن تَ</>حْتِهَا <h>ٱ</>لْأَنْ<m>هَٰ</>رُ يَوْمَ لَا يُخْزِى <h>ٱ</>للَّهُ <h>ٱ</><l>ل</><g>نَّ</>بِىَّ وَ<h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> مَعَهُ<m>ۥ</> ۖ نُورُهُمْ يَسْعَىٰ بَيْنَ أَيْدِيهِمْ وَبِأَيْ<m>مَٰ</>نِهِمْ يَقُولُونَ رَبَّ<o>نَآ</> أَتْمِمْ لَنَا نُورَنَا وَ<h>ٱ</>غْفِرْ لَ<o>نَآ ۖ</> إِ<g>نَّ</>كَ عَلَىٰ كُلِّ <k>شَىْءٍۢ قَ</><p>دِي</>رٌۭ"},{"n":9,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O","হে"],["ٱلنَّبِىُّ","l-nabiyu","Prophet","নবী"],["جَـٰهِدِ","jāhidi","Strive","জিহাদ কর"],["ٱلْكُفَّارَ","l-kufāra","(against) the disbelievers","কাফেরদের (বিরুদ্ধে)"],["وَٱلْمُنَـٰفِقِينَ","wal-munāfiqīna","and the hypocrites","ও মুনাফিকদের"],["وَٱغْلُظْ","wa-ugh'luẓ","and be stern","এবং কঠোর হও"],["عَلَيْهِمْ ۚ","‘alayhim","with them","তাদের উপর"],["وَمَأْوَىٰهُمْ","wamawāhum","And their abode","এবং তাদের আশ্রয়স্থল"],["جَهَنَّمُ ۖ","jahannamu","(is) Hell","জাহান্নাম"],["وَبِئْسَ","wabi'sa","and wretched is","ও কত নিকৃষ্ট"],["ٱلْمَصِيرُ","l-maṣīru","the destination","প্রত্যাবর্তনস্থল"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</><l>ل</><g>نَّ</>بِىُّ <m>جَٰ</>هِدِ <h>ٱ</>لْكُفَّارَ وَ<h>ٱ</>لْمُ<m>نَٰ</>فِقِينَ وَ<h>ٱ</>غْلُظْ عَلَيْهِمْ ۚ وَمَأْوَ<m>ىٰ</>هُمْ جَهَ<g>نَّ</>مُ ۖ وَبِئْسَ <h>ٱ</>لْمَ<p>صِي</>رُ"},{"n":10,"w":[["ضَرَبَ","ḍaraba","Presents","পেশ করেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["مَثَلًۭا","mathalan","an example","দৃষ্টান্ত"],["لِّلَّذِينَ","lilladhīna","for those who","যারা জন্যে (তাদের)"],["كَفَرُوا۟","kafarū","disbelieved ","কুফরি করেছে"],["ٱمْرَأَتَ","im'ra-ata","(the) wife","স্ত্রীর"],["نُوحٍۢ","nūḥin","(of) Nuh","নূহের"],["وَٱمْرَأَتَ","wa-im'ra-ata","(and the) wife","ও স্ত্রীর"],["لُوطٍۢ ۖ","lūṭin","(of) Lut","লূতের"],["كَانَتَا","kānatā","They were","তারা দু'জনে ছিল"],["تَحْتَ","taḥta","under","অধীন"],["عَبْدَيْنِ","‘abdayni","two [slaves]","দুই বান্দার"],["مِنْ","min","of","মধ্যে"],["عِبَادِنَا","‘ibādinā","Our slaves","আমাদের বান্দাদের"],["صَـٰلِحَيْنِ","ṣāliḥayni","righteous","দুই নেককার"],["فَخَانَتَاهُمَا","fakhānatāhumā","but they both betrayed them","অতঃপর খিয়ানত করেছিল উভয়ে তাদের দু'জনের"],["فَلَمْ","falam","so not","নাই অতঃপর"],["يُغْنِيَا","yugh'niyā","they availed","কাজে আসে তারা দু'জন"],["عَنْهُمَا","‘anhumā","both of them","তাদের (স্ত্রীদের) দু'জনের"],["مِنَ","mina","from","মুকাবেলায়"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["شَيْـًۭٔا","shayan","(in) anything","কিছুই"],["وَقِيلَ","waqīla","and it was said","ও বলা হল"],["ٱدْخُلَا","ud'khulā","Enter","\"দু'জনে প্রবেশ কর"],["ٱلنَّارَ","l-nāra","the Fire","আগুনে"],["مَعَ","ma‘a","with","সাথে"],["ٱلدَّٰخِلِينَ","l-dākhilīna","those who enter","প্রবেশকারীদের\""]],"t":"ضَرَبَ <h>ٱ</>للَّهُ مَثَلًۭ<w>ا لِّ</>لَّذِينَ كَفَرُو<s>ا۟</> <h>ٱ</>مْرَأَتَ نُو<d>حٍۢ وَ</><h>ٱ</>مْرَأَتَ لُو<k>طٍۢ ۖ كَ</>انَتَا تَحْتَ عَ<q>بْ</>دَيْنِ مِنْ عِبَادِنَا <m>صَٰ</>لِحَيْنِ فَخَانَتَاهُمَا فَلَمْ يُغْنِيَا عَنْهُمَا مِنَ <h>ٱ</>للَّهِ شَ<d>يْـًۭٔا وَ</>قِيلَ <h>ٱ</><q>دْ</>خُلَا <h>ٱ</><l>ل</><g>نَّ</>ارَ مَعَ <h>ٱ</><l>ل</><m>دَّٰ</>خِ<p>لِي</>نَ"},{"n":11,"w":[["وَضَرَبَ","waḍaraba","And presents","এবং পেশ করেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["مَثَلًۭا","mathalan","an example","দৃষ্টান্ত"],["لِّلَّذِينَ","lilladhīna","for those who","যারা (তাদের) জন্যে"],["ءَامَنُوا۟","āmanū","believed ","ঈমান এনেছে"],["ٱمْرَأَتَ","im'ra-ata","(the) wife","স্ত্রীর"],["فِرْعَوْنَ","fir'‘awna","(of) Firaun","ফিরআউনের"],["إِذْ","idh","when","যখন"],["قَالَتْ","qālat","she said","বলেছিল"],["رَبِّ","rabbi","My Lord","\"হে আমার রব"],["ٱبْنِ","ib'ni","Build","বানাও"],["لِى","lī","for me","আমার জন্যে"],["عِندَكَ","‘indaka","near You","তোমার কাছে"],["بَيْتًۭا","baytan","a house","ঘর"],["فِى","fī","in","মধ্যে"],["ٱلْجَنَّةِ","l-janati","Paradise","জান্নাতের"],["وَنَجِّنِى","wanajjinī","and save me","এবং আমাকে উদ্ধার কর"],["مِن","min","from","হতে"],["فِرْعَوْنَ","fir'‘awna","Firaun","ফিরআউন"],["وَعَمَلِهِۦ","wa‘amalihi","and his deeds","ও তার কাজ"],["وَنَجِّنِى","wanajjinī","and save me","এবং আমাকে উদ্ধার কর"],["مِنَ","mina","from","হতে"],["ٱلْقَوْمِ","l-qawmi","the people","লোকদের"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","যালিম\""]],"t":"وَضَرَبَ <h>ٱ</>للَّهُ مَثَلًۭ<w>ا لِّ</>لَّذِينَ ءَامَنُو<s>ا۟</> <h>ٱ</>مْرَأَتَ فِرْعَوْنَ إِذْ قَالَتْ رَبِّ <h>ٱ</><q>بْ</>نِ لِى عِ<k>ندَ</>كَ بَيْ<k>تًۭا فِ</>ى <h>ٱ</>لْجَ<g>نَّ</>ةِ وَنَجِّنِى مِ<k>ن فِ</>رْعَوْنَ وَعَمَلِ<m>هِۦ</> وَنَجِّنِى مِنَ <h>ٱ</>لْقَوْمِ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":12,"w":[["وَمَرْيَمَ","wamaryama","And Maryam","এবং মারয়াম"],["ٱبْنَتَ","ib'nata","(the) daughter","কন্যা"],["عِمْرَٰنَ","‘im'rāna","(of) Imran","ইমরানের"],["ٱلَّتِىٓ","allatī","who","যে"],["أَحْصَنَتْ","aḥṣanat","guarded","সংরক্ষণ করেছিল"],["فَرْجَهَا","farjahā","her chastity","তার লজ্জাস্থান"],["فَنَفَخْنَا","fanafakhnā","so We breathed","অতঃপর আমরা ফুঁকে দেই"],["فِيهِ","fīhi","into it","তার মধ্যে"],["مِن","min","of","থেকে"],["رُّوحِنَا","rūḥinā","Our Spirit","আমাদের রুহ"],["وَصَدَّقَتْ","waṣaddaqat","And she believed","এবং সে সত্যতা স্বীকার করেছিল"],["بِكَلِمَـٰتِ","bikalimāti","(in the) Words","বাক্যগুলোর"],["رَبِّهَا","rabbihā","(of) her Lord","তার রবের"],["وَكُتُبِهِۦ","wakutubihi","and His Books","ও তাঁর কিতাবগুলোর"],["وَكَانَتْ","wakānat","and she was","এবং সে ছিল"],["مِنَ","mina","of","মধ্যে (একজন)"],["ٱلْقَـٰنِتِينَ","l-qānitīna","the devoutly obedient","অনুগতদের"]],"t":"وَمَرْيَمَ <h>ٱ</><q>بْ</>نَتَ عِمْ<m>رَٰ</>نَ <h>ٱ</>لَّ<o>تِىٓ</> أَحْصَنَتْ فَرْجَهَا فَنَفَخْنَا فِيهِ <w>مِن رُّ</>وحِنَا وَصَدَّقَتْ بِكَلِ<m>مَٰ</>تِ رَبِّهَا وَكُتُبِ<m>هِۦ</> وَكَانَتْ مِنَ <h>ٱ</>لْ<m>قَٰ</>نِ<p>تِي</>نَ"}]}