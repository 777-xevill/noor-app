{"n":66,"a":[{"n":1,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O","হে"],["ٱلنَّبِىُّ","l-nabiyu","Prophet","নবী"],["لِمَ","lima","Why (do)","কেন"],["تُحَرِّمُ","tuḥarrimu","you prohibit","হারাম কর তুমি"],["مَآ","mā","what","যা"],["أَحَلَّ","aḥalla","has made lawful","হালাল করেছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["لَكَ ۖ","laka","for you","তোমার জন্যে"],["تَبْتَغِى","tabtaghī","seeking","তুমি চাও (কি)"],["مَرْضَاتَ","marḍāta","(to) please","সন্তুষ্টি"],["أَزْوَٰجِكَ ۚ","azwājika","your wives","তোমার স্ত্রীদের"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["غَفُورٌۭ","ghafūrun","(is) Oft-Forgiving","ক্ষমাশীল"],["رَّحِيمٌۭ","raḥīmun","Most Merciful","মেহেরবান"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</><l>ل</><g>نَّ</>بِىُّ لِمَ تُحَرِّمُ <o>مَآ</> أَحَلَّ <h>ٱ</>للَّهُ لَكَ ۖ تَ<q>بْ</>تَغِى مَرْضَاتَ أَزْ<m>وَٰ</>جِكَ ۚ وَ<h>ٱ</>للَّهُ غَفُو<w>رٌۭ رَّ</><p>حِي</>مٌۭ"},{"n":2,"w":[["قَدْ","qad","Indeed","নিশ্চয়"],["فَرَضَ","faraḍa","has ordained","নির্দিষ্ট করেছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["لَكُمْ","lakum","for you","তোমাদের জন্যে"],["تَحِلَّةَ","taḥillata","(the) dissolution","মুক্তির ব্যবস্থা"],["أَيْمَـٰنِكُمْ ۚ","aymānikum","(of) your oaths","তোমাদের শপথগুলোর"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["مَوْلَىٰكُمْ ۖ","mawlākum","(is) your Protector","তোমাদের মনিব"],["وَهُوَ","wahuwa","and He","এবং তিনিই"],["ٱلْعَلِيمُ","l-‘alīmu","(is) the All-Knower","সর্বজ্ঞ"],["ٱلْحَكِيمُ","l-ḥakīmu","the All-Wise","প্রজ্ঞাময়"]],"t":"قَ<q>دْ</> فَرَضَ <h>ٱ</>للَّهُ لَكُمْ تَحِلَّةَ أَيْ<m>مَٰ</>نِكُمْ ۚ وَ<h>ٱ</>للَّهُ مَوْلَ<m>ىٰ</>كُمْ ۖ وَهُوَ <h>ٱ</>لْعَلِيمُ <h>ٱ</>لْحَ<p>كِي</>مُ"},{"n":3,"w":[["وَإِذْ","wa-idh","And when","এবং যখন"],["أَسَرَّ","asarra","confided","গোপনে বলেছিল"],["ٱلنَّبِىُّ","l-nabiyu","the Prophet","নবী"],["إِلَىٰ","ilā","to","নিকট"],["بَعْضِ","ba‘ḍi","one","কারও"],["أَزْوَٰجِهِۦ","azwājihi","(of) his wives","তার স্ত্রীদের"],["حَدِيثًۭا","ḥadīthan","a statement","একটি কথা"],["فَلَمَّا","falammā","and when","যখন অতঃপর"],["نَبَّأَتْ","nabba-at","she informed","সে বলে দেয় (অন্য স্ত্রীকে)"],["بِهِۦ","bihi","about it","তা সম্পর্কে"],["وَأَظْهَرَهُ","wa-aẓharahu","and made it apparent","ও তা প্রকাশ করলেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["عَلَيْهِ","‘alayhi","to him","তার নিকট"],["عَرَّفَ","‘arrafa","he made known","(নবী) ব্যক্ত করল"],["بَعْضَهُۥ","ba‘ḍahu","a part of it","তার কিছুটা"],["وَأَعْرَضَ","wa-a‘raḍa","and avoided","ও এড়িয়ে গেল"],["عَنۢ","‘an","[of]","(যে)"],["بَعْضٍۢ ۖ","ba‘ḍin","a part","কিছু"],["فَلَمَّا","falammā","Then when","যখন অতঃপর"],["نَبَّأَهَا","nabba-ahā","he informed her","তাকে জানাল"],["بِهِۦ","bihi","about it","সে সম্পর্কে"],["قَالَتْ","qālat","she said","সে বলল (স্ত্রী)"],["مَنْ","man","Who","\"কে"],["أَنۢبَأَكَ","anba-aka","informed you","আপনাকে খবর দিল"],["هَـٰذَا ۖ","hādhā","this","এটা\""],["قَالَ","qāla","He said","বলল (নবী)"],["نَبَّأَنِىَ","nabba-aniya","Has informed me","\"আমাকে খবর দিয়েছেন"],["ٱلْعَلِيمُ","l-‘alīmu","the All-Knower","সর্বজ্ঞ"],["ٱلْخَبِيرُ","l-khabīru","the All-Aware","ওয়াকিবহাল\""]],"t":"وَإِذْ أَسَرَّ <h>ٱ</><l>ل</><g>نَّ</>بِىُّ إِلَىٰ بَعْضِ أَزْ<m>وَٰجِهِۦ</> حَدِي<k>ثًۭا فَ</>لَ<g>مَّ</>ا نَبَّأَتْ بِ<m>هِۦ</> وَأَظْهَرَهُ <h>ٱ</>للَّهُ عَلَيْهِ عَرَّفَ بَعْضَهُ<m>ۥ</> وَأَعْرَضَ <i>عَنۢ بَ</>عْ<k>ضٍۢ ۖ فَ</>لَ<g>مَّ</>ا نَبَّأَهَا بِ<m>هِۦ</> قَالَتْ مَنْ أَ<i>نۢبَ</>أَكَ <m>هَٰ</>ذَا ۖ قَالَ نَبَّأَنِىَ <h>ٱ</>لْعَلِيمُ <h>ٱ</>لْخَ<p>بِي</>رُ"},{"n":4,"w":[["إِن","in","If","যদি"],["تَتُوبَآ","tatūbā","you both turn","তোমরা দুজনে তওবা কর"],["إِلَى","ilā","to","নিকট"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["فَقَدْ","faqad","so indeed","নিশ্চয় কেননা"],["صَغَتْ","ṣaghat","(are) inclined","ঝুঁকেছিল"],["قُلُوبُكُمَا ۖ","qulūbukumā","your hearts","তোমাদের দু'জনের অন্তর"],["وَإِن","wa-in","but if","এবং যদি"],["تَظَـٰهَرَا","taẓāharā","you backup each other","তোমরা দু'জনে পরস্পরকে সাহায্য কর"],["عَلَيْهِ","‘alayhi","against him","তার বিরুদ্ধে"],["فَإِنَّ","fa-inna","then indeed","নিশ্চয় তবে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["هُوَ","huwa","He","তিনিই"],["مَوْلَىٰهُ","mawlāhu","(is) his Protector","তার মনিব"],["وَجِبْرِيلُ","wajib'rīlu","and Jibreel","ও জিবরাঈল"],["وَصَـٰلِحُ","waṣāliḥu","and (the) righteous","ও নেককার"],["ٱلْمُؤْمِنِينَ ۖ","l-mu'minīna","believers","মু'মিনরা"],["وَٱلْمَلَـٰٓئِكَةُ","wal-malāikatu","and the Angels","ও ফেরেশতারা"],["بَعْدَ","ba‘da","after","পরে"],["ذَٰلِكَ","dhālika","that","উপরন্তু"],["ظَهِيرٌ","ẓahīrun","(are his) assistants","সাহায্যকারী"]],"t":"إِ<k>ن تَ</>تُو<o>بَآ</> إِلَى <h>ٱ</>للَّهِ فَقَ<q>دْ</> صَغَتْ قُلُوبُكُمَا ۖ وَإِ<k>ن تَ</><m>ظَٰ</>هَرَا عَلَيْهِ فَإِ<g>نَّ</> <h>ٱ</>للَّهَ هُوَ مَوْلَ<m>ىٰ</>هُ وَجِ<q>بْ</>رِيلُ وَ<m>صَٰ</>لِحُ <h>ٱ</>لْمُؤْمِنِينَ ۖ وَ<h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةُ بَعْدَ <m>ذَٰ</>لِكَ ظَ<p>هِي</>رٌ"},{"n":5,"w":[["عَسَىٰ","‘asā","Perhaps","সম্ভবতঃ"],["رَبُّهُۥٓ","rabbuhu","his Lord","তার রব"],["إِن","in","if","যদি"],["طَلَّقَكُنَّ","ṭallaqakunna","he divorced you","তোমাদের তালাক দেয় (নবী)"],["أَن","an","[that]","যে"],["يُبْدِلَهُۥٓ","yub'dilahu","He will substitute for him","তাকে বদলে দেবেন"],["أَزْوَٰجًا","azwājan","wives","(এমন সব) স্ত্রী"],["خَيْرًۭا","khayran","better","উত্তম"],["مِّنكُنَّ","minkunna","than you","(যারা) তোমাদের চেয়ে"],["مُسْلِمَـٰتٍۢ","mus'limātin","submissive","আত্নসমর্পণকারিণী"],["مُّؤْمِنَـٰتٍۢ","mu'minātin","faithful","মুমিনা"],["قَـٰنِتَـٰتٍۢ","qānitātin","obedient","আনুগত্যশীলা"],["تَـٰٓئِبَـٰتٍ","tāibātin","repentant","তওবাকারিনী"],["عَـٰبِدَٰتٍۢ","‘ābidātin","who worship","ইবাদতকারিণী"],["سَـٰٓئِحَـٰتٍۢ","sāiḥātin","who fast","রোজাদার"],["ثَيِّبَـٰتٍۢ","thayyibātin","previously married","অকুমারী"],["وَأَبْكَارًۭا","wa-abkāran","and virgins","ও কুমারী"]],"t":"عَسَىٰ رَبُّهُ<o>ۥٓ</> إِ<k>ن طَ</>لَّقَكُ<g>نَّ</> <d>أَن يُ</><q>بْ</>دِلَهُ<o>ۥٓ</> أَزْ<m>وَٰ</>جًا خَيْ<d>رًۭا مِّ</><k>نكُ</><g>نَّ</> مُسْلِ<m>مَٰ</><d>تٍۢ مُّ</>ؤْمِ<m>نَٰ</><k>تٍۢ قَٰ</>نِ<m>تَٰ</><k>تٍۢ تَٰٓ</>ئِ<m>بَٰ</>تٍ <m>عَٰبِدَٰ</><k>تٍۢ سَٰٓ</>ئِ<m>حَٰ</><k>تٍۢ ثَ</>يِّ<m>بَٰ</><d>تٍۢ وَ</>أَ<q>بْ</>كَارًۭا"},{"n":6,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O","ওহে"],["ٱلَّذِينَ","alladhīna","(you) who","যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছ"],["قُوٓا۟","qū","Protect","তোমরা রক্ষা কর"],["أَنفُسَكُمْ","anfusakum","yourselves","তোমাদের নিজেদের"],["وَأَهْلِيكُمْ","wa-ahlīkum","and your families","ও তোমাদের পরিবারবর্গকে"],["نَارًۭا","nāran","(from) a Fire","আগুন (থেকে)"],["وَقُودُهَا","waqūduhā","whose fuel","যার ইন্ধন"],["ٱلنَّاسُ","l-nāsu","(is) people","মানুষ"],["وَٱلْحِجَارَةُ","wal-ḥijāratu","and stones","ও পাথর"],["عَلَيْهَا","‘alayhā","over it","তার উপর"],["مَلَـٰٓئِكَةٌ","malāikatun","(are) Angels","ফেরেশতারা"],["غِلَاظٌۭ","ghilāẓun","stern","নির্দয়"],["شِدَادٌۭ","shidādun","severe","কঠোর"],["لَّا","lā","not","না"],["يَعْصُونَ","ya‘ṣūna","they disobey","তারা অমান্য করে"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["مَآ","mā","(in) what","যা"],["أَمَرَهُمْ","amarahum","He Commands them","তাদের নির্দেশ দেন তিনি"],["وَيَفْعَلُونَ","wayaf‘alūna","but they do","এবং তারা করে"],["مَا","mā","what","যা"],["يُؤْمَرُونَ","yu'marūna","they are commanded","তাদের নির্দেশ দেয়া হয়"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> <o>قُوٓ</><s>ا۟</> أَ<k>نفُ</>سَكُمْ وَأَهْلِيكُمْ نَا<d>رًۭا وَ</>قُودُهَا <h>ٱ</><l>ل</><g>نَّ</>اسُ وَ<h>ٱ</>لْحِجَارَةُ عَلَيْهَا مَ<o>لَٰٓ</>ئِكَةٌ غِلَا<k>ظٌۭ شِ</>دَا<w>دٌۭ لَّ</>ا يَعْصُونَ <h>ٱ</>للَّهَ <o>مَآ</> أَمَرَهُمْ وَيَفْعَلُونَ مَا يُؤْمَ<p>رُو</>نَ"},{"n":7,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O","\"ওহে"],["ٱلَّذِينَ","alladhīna","(you) who","\"যারা"],["كَفَرُوا۟","kafarū","disbelieve","\"কুফরী করেছ"],["لَا","lā","(Do) not","না"],["تَعْتَذِرُوا۟","ta‘tadhirū","make excuses","তোমরা ওজর পেশ করো"],["ٱلْيَوْمَ ۖ","l-yawma","today","আজ"],["إِنَّمَا","innamā","Only","প্রকৃতপক্ষে"],["تُجْزَوْنَ","tuj'zawna","you will be recompensed","তোমাদের প্রতিফল দেয়া হবে"],["مَا","mā","(for) what","যা"],["كُنتُمْ","kuntum","you used to","তোমরা"],["تَعْمَلُونَ","ta‘malūna","do","তোমরা কাজ করতেছিলে\""]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> لَا تَ