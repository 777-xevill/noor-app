{"n":62,"a":[{"n":1,"w":[["يُسَبِّحُ","yusabbiḥu","Glorifies","মহিমা ঘোষণা করে"],["لِلَّهِ","lillahi","Allah","আল্লাহরই"],["مَا","mā","whatever","যা"],["فِى","fī","(is) in","মধ্যে (আছে)"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশ জগতের"],["وَمَا","wamā","and whatever","ও যা"],["فِى","fī","(is) in","মধ্যে (আছে)"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["ٱلْمَلِكِ","l-maliki","the Sovereign","অধিপতি"],["ٱلْقُدُّوسِ","l-qudūsi","the Holy","মহান পবিত্র"],["ٱلْعَزِيزِ","l-‘azīzi","the All-Mighty","মহাপরাক্রমশালী"],["ٱلْحَكِيمِ","l-ḥakīmi","the All-Wise","প্রজ্ঞাময়"]],"t":"يُسَبِّحُ لِلَّهِ مَا فِى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَمَا فِى <h>ٱ</>لْأَرْضِ <h>ٱ</>لْمَلِكِ <h>ٱ</>لْقُدُّوسِ <h>ٱ</>لْعَزِيزِ <h>ٱ</>لْحَ<p>كِي</>مِ"},{"n":2,"w":[["هُوَ","huwa","He","তিনিই"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["بَعَثَ","ba‘atha","sent","পাঠিয়েছেন"],["فِى","fī","among","মধ্যে"],["ٱلْأُمِّيِّـۧنَ","l-umiyīna","the unlettered","নিরক্ষরদের"],["رَسُولًۭا","rasūlan","a Messenger","একজন রাসূল"],["مِّنْهُمْ","min'hum","from themselves","তাদের মধ্য থেকে"],["يَتْلُوا۟","yatlū","reciting","যে আবৃত্তি করে"],["عَلَيْهِمْ","‘alayhim","to them","তাদের নিকট"],["ءَايَـٰتِهِۦ","āyātihi","His Verses","তাঁর আয়াতগুলো"],["وَيُزَكِّيهِمْ","wayuzakkīhim","and purifying them","ও তাদের পরিশুদ্ধ করে"],["وَيُعَلِّمُهُمُ","wayu‘allimuhumu","and teaching them","ও তাদের শিক্ষা দেয়"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","কিতাব"],["وَٱلْحِكْمَةَ","wal-ḥik'mata","and the wisdom","হিকমত"],["وَإِن","wa-in","although","এবং যদিও"],["كَانُوا۟","kānū","they were","তারা ছিল"],["مِن","min","from","মধ্য হতে"],["قَبْلُ","qablu","before","ইতিপূর্বে"],["لَفِى","lafī","surely in","মধ্যে অবশ্যই"],["ضَلَـٰلٍۢ","ḍalālin","an error","বিভ্রান্তির"],["مُّبِينٍۢ","mubīnin","clear","সুস্পষ্ট"]],"t":"هُوَ <h>ٱ</>لَّذِى بَعَثَ فِى <h>ٱ</>لْأُ<g>مِّ</>يِّۦنَ رَسُولًۭ<d>ا مِّ</>نْهُمْ يَتْلُو<s>ا۟</> عَلَيْهِمْ ءَا<m>يَٰتِهِۦ</> وَيُزَكِّيهِمْ وَيُعَلِّمُهُمُ <h>ٱ</>لْكِ<m>تَٰ</>بَ وَ<h>ٱ</>لْحِكْمَةَ وَإِ<k>ن كَ</>انُو<s>ا۟</> مِ<k>ن قَ</><q>بْ</>لُ لَفِى ضَ<m>لَٰ</><d>لٍۢ مُّ</><p>بِي</>نٍۢ"},{"n":3,"w":[["وَءَاخَرِينَ","waākharīna","And others","এবং অন্যান্যদের (জন্যেও)"],["مِنْهُمْ","min'hum","among them","তাদের থেকে (যারা)"],["لَمَّا","lammā","who have not yet","নাই এখনও"],["يَلْحَقُوا۟","yalḥaqū","joined","মিলে"],["بِهِمْ ۚ","bihim","them","তাদের সাথে"],["وَهُوَ","wahuwa","and He","এবং তিনি"],["ٱلْعَزِيزُ","l-‘azīzu","(is) the All-Mighty","পরাক্রমশীল"],["ٱلْحَكِيمُ","l-ḥakīmu","the All-Wise","প্রজ্ঞাময়"]],"t":"وَءَاخَرِينَ مِنْهُمْ لَ<g>مَّ</>ا يَلْحَقُو<s>ا۟</> بِهِمْ ۚ وَهُوَ <h>ٱ</>لْعَزِيزُ <h>ٱ</>لْحَ<p>كِي</>مُ"},{"n":4,"w":[["ذَٰلِكَ","dhālika","That","এটা"],["فَضْلُ","faḍlu","(is the) Bounty","অনুগ্রহ"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["يُؤْتِيهِ","yu'tīhi","He gives it","তাকে দেন"],["مَن","man","(to) whom","যাকে"],["يَشَآءُ ۚ","yashāu","He wills","তিনি চান"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["ذُو","dhū","(is the) Possessor","(আছে)"],["ٱلْفَضْلِ","l-faḍli","(of) Bounty","অনুগ্রহকারী"],["ٱلْعَظِيمِ","l-‘aẓīmi","the Great","মহান"]],"t":"<m>ذَٰ</>لِكَ فَضْلُ <h>ٱ</>للَّهِ يُؤْتِيهِ <d>مَن يَ</><o>شَآ</>ءُ ۚ وَ<h>ٱ</>للَّهُ ذُو <h>ٱ</>لْفَضْلِ <h>ٱ</>لْعَ<p>ظِي</>مِ"},{"n":5,"w":[["مَثَلُ","mathalu","(The) likeness","দৃষ্টান্ত"],["ٱلَّذِينَ","alladhīna","(of) those who","যাদের"],["حُمِّلُوا۟","ḥummilū","were entrusted","ভার দেয়া হয়েছিল"],["ٱلتَّوْرَىٰةَ","l-tawrāta","(with) the Taurat","তাওরাতের (দায়িত্ব)"],["ثُمَّ","thumma","then","এরপর"],["لَمْ","lam","not","নাই"],["يَحْمِلُوهَا","yaḥmilūhā","they bore it","তা বহন করে"],["كَمَثَلِ","kamathali","(is) like","দৃষ্টান্ত যেমন"],["ٱلْحِمَارِ","l-ḥimāri","the donkey","গাধার"],["يَحْمِلُ","yaḥmilu","who carries","বহন করে"],["أَسْفَارًۢا ۚ","asfāran","books","কিতাবসমূহ"],["بِئْسَ","bi'sa","Wretched is","কত নিকৃষ্ট"],["مَثَلُ","mathalu","(the) example","দৃষ্টান্ত"],["ٱلْقَوْمِ","l-qawmi","(of) the people","(সেই) লোকদের"],["ٱلَّذِينَ","alladhīna","who","যারা"],["كَذَّبُوا۟","kadhabū","deny","মিথ্যারোপ করেছে"],["بِـَٔايَـٰتِ","biāyāti","(the) Signs","আয়াতগুলোকে"],["ٱللَّهِ ۚ","l-lahi","(of) Allah","আল্লাহর"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["لَا","lā","(does) not","না"],["يَهْدِى","yahdī","guide","হেদায়াত দেন"],["ٱلْقَوْمَ","l-qawma","the people","লোকদের"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","যালেম"]],"t":"مَثَلُ <h>ٱ</>لَّذِينَ حُ<g>مِّ</>لُو<s>ا۟</> <h>ٱ</><l>ل</>تَّوْرَ<m>ىٰ</>ةَ ثُ<g>مَّ</> لَمْ يَحْمِلُوهَا كَمَثَلِ <h>ٱ</>لْحِمَارِ يَحْمِلُ أَسْفَا<i>رًۢا ۚ بِ</>ئْسَ مَثَلُ <h>ٱ</>لْقَوْمِ <h>ٱ</>لَّذِينَ كَذَّبُو<s>ا۟</> بِـَٔا<m>يَٰ</>تِ <h>ٱ</>للَّهِ ۚ وَ<h>ٱ</>للَّهُ لَا يَهْدِى <h>ٱ</>لْقَوْمَ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":6,"w":[["قُلْ","qul","Say","বল"],["يَـٰٓأَيُّهَا","yāayyuhā","O","\"ওহে"],["ٱلَّذِينَ","alladhīna","you (who)","\"যারা"],["هَادُوٓا۟","hādū","(are) Jews","\"ইহুদী হয়েছো"],["إِن","in","If","যদি"],["زَعَمْتُمْ","za‘amtum","you claim","তোমরা দাবি করো"],["أَنَّكُمْ","annakum","that you","তোমরাই যে"],["أَوْلِيَآءُ","awliyāu","(are) allies","বন্ধু"],["لِلَّهِ","lillahi","of Allah","আল্লাহরই"],["مِن","min","from","মধ্য হতে"],["دُونِ","dūni","excluding","ছাড়া"],["ٱلنَّاسِ","l-nāsi","the people","(অন্য) মানবগোষ্ঠী"],["فَتَمَنَّوُا۟","fatamannawū","then wish","তবে তোমরা কামনা করো"],["ٱلْمَوْتَ","l-mawta","(for) the death","মৃত্যু"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you are","তোমরা হও"],["صَـٰدِقِينَ","ṣādiqīna","truthful","সত্যবাদী\""]],"t":"قُلْ <o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ هَا<o>دُوٓ</><s>ا۟</> إِ<k>ن زَ</>عَمْتُمْ أَ<g>نَّ</>كُمْ أَوْلِ<o>يَآ</>ءُ لِلَّهِ مِ<k>ن دُ</>ونِ <h>ٱ</><l>ل</><g>نَّ</>اسِ فَتَمَ<g>نَّ</>وُ<s>ا۟</> <h>ٱ</>لْمَوْتَ إِ<k>ن كُنتُ</>مْ <m>صَٰ</>دِ<p>قِي</>نَ"},{"n":7,"w":[["وَلَا","walā","But not","এবং না"],["يَتَمَنَّوْنَهُۥٓ","yatamannawnahu","they will wish for it","তারা তা কামনা করবে"],["أَبَدًۢا","abadan","ever","কখনও"],["بِمَا","bimā","for what","এ কারণে যা"],["قَدَّمَتْ","qaddamat","(have) sent forth","আগে পাঠিয়েছে"],["أَيْدِيهِمْ ۚ","aydīhim","their hands","তাদের হাতগুলো"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["عَلِيمٌۢ","‘alīmun","(is) All-Knowing","খুব অবহিত"],["بِٱلظَّـٰلِمِينَ","bil-ẓālimīna","of the wrongdoers","যালিমদের সম্পর্কে"]],"t":"وَلَا يَتَمَ<g>نَّ</>وْنَهُ<o>ۥٓ</> أَبَ<i>دًۢا بِ</>مَا قَدَّمَتْ أَيْدِيهِمْ ۚ وَ<h>ٱ</>للَّهُ عَلِي<i>مٌۢ بِ</><h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":8,"w":[["قُلْ","qul","Say","বলো"],["إِنَّ","inna","Indeed","\"নিশ্চয়"],["ٱلْمَوْتَ","l-mawta","the death","মৃত্যু"],["ٱلَّذِى","alladhī","which","যা (থেকে)"],["تَفِرُّونَ","tafirrūna","you flee","তোমরা পলায়ন কর"],["مِنْهُ","min'hu","from it","তা থেকে"],["فَإِنَّهُۥ","fa-innahu","then surely it","অতঃপর নিশ্চয় তা"],["مُلَـٰقِيكُمْ ۖ","mulāqīkum","(will) meet you","তোমাদের মিলবে"],["ثُمَّ","thumma","Then","এরপর"],["تُرَدُّونَ","turaddūna","you will be sent back","তোমরা প্রত্যানীত হবে"],["إِلَىٰ","ilā","to","দিকে"],["عَـٰلِمِ","‘ālimi","(the) All-Knower","পরিজ্ঞাতার"],["ٱلْغَيْبِ","l-ghaybi","(of) the unseen","অদৃশ্যের"],["وَٱلشَّهَـٰدَةِ","wal-shahādati","and the witnessed","ও দৃশ্যের"],["فَيُنَبِّئُكُم","fayunabbi-ukum","and He will inform you","অতঃপর তোমাদের জানিয়ে দিবেন"],["بِمَا","bimā","[of] what","যা কিছু"],["كُنتُمْ","kuntum","you used to","তোমরা"],["تَعْمَلُونَ","ta‘malūna","do","কাজ করতেছিলে\""]],"t":"قُلْ إِ<g>نَّ</> <h>ٱ</>لْمَوْتَ <h>ٱ</>لَّذِى تَفِرُّونَ مِنْهُ فَإِ<g>نَّ</>هُ<m>ۥ</> مُ<m>لَٰ</>قِيكُمْ ۖ ثُ<g>مَّ</> تُرَدُّونَ إِلَىٰ <m>عَٰ</>لِمِ <h>ٱ</>لْغَيْبِ وَ<h>ٱ</><l>ل</>شَّ<m>هَٰ</>دَةِ فَيُنَبِّئُ<f>كُم بِ</>مَا كُ<k>نتُ</>مْ تَعْمَ<p>لُو</>نَ"},{"n":9,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O","ওহে"],["ٱلَّذِينَ","alladhīna","(you) who","যারা"],["ءَامَنُوٓا۟","āmanū","believe","ঈমান এনেছো"],["إِذَا","idhā","When","যখন"],["نُودِىَ","nūdiya","(the) call is made","ডাকা হয়"],["لِلصَّلَوٰةِ","lilṣṣalati","for (the) prayer","নামাজের জন্যে"],["مِن","min","on","মধ্য হতে"],["يَوْمِ","yawmi","(the) day","দিনে"],["ٱلْجُمُعَةِ","l-jumu‘ati","(of) Friday","জুমুয়া'র"],["فَٱسْعَوْا۟","fa-is'‘aw","then hasten","তখন তোমরা ধাবিত  হও"],["إِلَىٰ","ilā","to","দিকে"],["ذِكْرِ","dhik'ri","(the) remembrance","স্মরণের"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَذَرُوا۟","wadharū","and leave","ও ত্যাগ করো"],["ٱلْبَيْعَ ۚ","l-bay‘a","the business","কেনাবেচা"],["ذَٰلِكُمْ","dhālikum","That","এটা"],["خَيْرٌۭ","khayrun","(is) better","উত্তম"],["لَّكُمْ","lakum","for you","তোমাদের জন্যে"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you","তোমরা"],["تَعْلَمُونَ","ta‘lamūna","know","জানো"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَ<o>نُوٓ</><s>ا۟</> إِذَا نُودِىَ لِلصَّلَ<s>وٰ</>ةِ <d>مِن يَ</>وْمِ <h>ٱ</>لْجُمُعَةِ فَ<h>ٱ</>سْعَوْ<s>ا۟</> إِلَىٰ ذِكْرِ <h>ٱ</>للَّهِ وَذَرُو<s>ا۟</> <h>ٱ</>لْبَيْعَ ۚ <m>ذَٰ</>لِكُمْ خَيْ<w>رٌۭ لَّ</>كُمْ إِ<k>ن كُنتُ</>مْ تَعْلَ<p>مُو</>نَ"},{"n":10,"w":[["فَإِذَا","fa-idhā","Then when","অতঃপর যখন"],["قُضِيَتِ","quḍiyati","is concluded","সমাপ্ত হয়"],["ٱلصَّلَوٰةُ","l-ṣalatu","the prayer","নামাজ"],["فَٱنتَشِرُوا۟","fa-intashirū","then disperse","তখন তোমরা ছড়িয়ে পড়ো"],["فِى","fī","in","উপর"],["ٱلْأَرْضِ","l-arḍi","the land","পৃথিবীর"],["وَٱبْتَغُوا۟","wa-ib'taghū","and seek","ও তোমরা সন্ধান করো"],["مِن","min","from","মধ্য হতে"],["فَضْلِ","faḍli","(the) Bounty","অনুগ্রহ"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَٱذْكُرُوا۟","wa-udh'kurū","and remember","এবং তোমরা স্মরণ করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["كَثِيرًۭا","kathīran","much","অধিক"],["لَّعَلَّكُمْ","la‘allakum","so that you may","সম্ভবতঃ"],["تُفْلِحُونَ","tuf'liḥūna","succeed","তোমরা সফল হবে"]],"t":"فَإِذَا قُضِيَتِ <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةُ فَ<h>ٱ</><k>نتَ</>شِرُو<s>ا۟</> فِى <h>ٱ</>لْأَرْضِ وَ<h>ٱ</><q>بْ</>تَغُو<s>ا۟</> مِ<k>ن فَ</>ضْلِ <h>ٱ</>للَّهِ وَ<h>ٱ</>ذْكُرُو<s>ا۟</> <h>ٱ</>للَّهَ كَثِي<w>رًۭا لَّ</>عَلَّكُمْ تُفْلِ<p>حُو</>نَ"},{"n":11,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["رَأَوْا۟","ra-aw","they saw","তারা দেখল"],["تِجَـٰرَةً","tijāratan","a transaction","ব্যবসা"],["أَوْ","aw","or","বা"],["لَهْوًا","lahwan","a sport","খেলা-তামাশা"],["ٱنفَضُّوٓا۟","infaḍḍū","they rushed","তারা ছুটে গেল"],["إِلَيْهَا","ilayhā","to it","তার দিকে"],["وَتَرَكُوكَ","watarakūka","and left you","ও তোমাকে ছেড়ে গেল"],["قَآئِمًۭا ۚ","qāiman","standing","দাঁড়ানো অবস্থায়"],["قُلْ","qul","Say","বলো"],["مَا","mā","What","\"যা কিছুু"],["عِندَ","‘inda","(is) with","কাছে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["خَيْرٌۭ","khayrun","(is) better","উত্তম"],["مِّنَ","mina","than","অপেক্ষা"],["ٱللَّهْوِ","l-lahwi","the sport","খেলা-তামাশা"],["وَمِنَ","wamina","and from","ও থেকে"],["ٱلتِّجَـٰرَةِ ۚ","l-tijārati","(any) transaction","ব্যবসা"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহই"],["خَيْرُ","khayru","(is the) Best","উত্তম"],["ٱلرَّٰزِقِينَ","l-rāziqīna","(of) the Providers","রিযিকদাতাদের\""]],"t":"وَإِذَا رَأَوْ<s>ا۟</> تِ<m>جَٰ</>رَةً أَوْ لَهْوًا <h>ٱ</><k>نفَ</><o>ضُّوٓ</><s>ا۟</> إِلَيْهَا وَتَرَكُوكَ <o>قَآ</>ئِ<k>مًۭا ۚ قُ</>لْ مَا عِ<k>ندَ</> <h>ٱ</>للَّهِ خَيْ<d>رٌۭ مِّ</>نَ <h>ٱ</><l>ل</>لَّهْوِ وَمِنَ <h>ٱ</><l>ل</>تِّ<m>جَٰ</>رَةِ ۚ وَ<h>ٱ</>للَّهُ خَيْرُ <h>ٱ</><l>ل</><m>رَّٰ</>زِ<p>قِي</>نَ"}]}