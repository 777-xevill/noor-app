{"n":32,"a":[{"n":1,"w":[["الٓمٓ","alif-lam-meem","Alif Lam Meem","আলিফ লাম- মীম-"]],"t":"ا<n>لٓمٓ</>"},{"n":2,"w":[["تَنزِيلُ","tanzīlu","(The) revelation","অবতরণ (হয়েছে)"],["ٱلْكِتَـٰبِ","l-kitābi","(of) the Book","(এই) কিতাবের"],["لَا","lā","(there is) no","নেই"],["رَيْبَ","rayba","doubt","সন্দেহ"],["فِيهِ","fīhi","about it","মধ্যে তার"],["مِن","min","from","পক্ষ হ'তে"],["رَّبِّ","rabbi","(the) Lord","রবের"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","(of) the worlds","বিশ্বজগতের"]],"t":"تَ<k>نزِ</>يلُ <h>ٱ</>لْكِ<m>تَٰ</>بِ لَا رَيْبَ فِيهِ <w>مِن رَّ</>بِّ <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":3,"w":[["أَمْ","am","Or","কি"],["يَقُولُونَ","yaqūlūna","(do) they say","তারা বলেছে"],["ٱفْتَرَىٰهُ ۚ","if'tarāhu","He invented it","\"সে মিথ্যা রচনা করেছে তা\""],["بَلْ","bal","Nay","বরং"],["هُوَ","huwa","it","তা"],["ٱلْحَقُّ","l-ḥaqu","(is) the truth","সত্য"],["مِن","min","from","পক্ষ হ'তে"],["رَّبِّكَ","rabbika","your Lord","রবের তোমার"],["لِتُنذِرَ","litundhira","that you may warn","যেন তুমি সতর্ক করো"],["قَوْمًۭا","qawman","a people","(এমন)এক জাতিকে"],["مَّآ","mā","not","না"],["أَتَىٰهُم","atāhum","has come to them","কাছে এসেছে তাদের"],["مِّن","min","any","কোনো"],["نَّذِيرٍۢ","nadhīrin","warner","সতর্ককারী"],["مِّن","min","before you","থেকে"],["قَبْلِكَ","qablika","before you","তোমার পূর্ব"],["لَعَلَّهُمْ","la‘allahum","so that they may","সম্ভবত তারা"],["يَهْتَدُونَ","yahtadūna","be guided","সঠিক পথে চলবে"]],"t":"أَمْ يَقُولُونَ <h>ٱ</>فْتَرَىٰهُ ۚ بَلْ هُوَ <h>ٱ</>لْحَقُّ <w>مِن رَّ</>بِّكَ لِتُ<k>نذِ</>رَ قَوْ<d>مًۭا مَّ</><o>آ</> أَتَ<m>ىٰ</><y>هُم مِّ</><d>ن نَّ</>ذِي<d>رٍۢ مِّ</><k>ن قَ</><q>بْ</>لِكَ لَعَلَّهُمْ يَهْتَ<p>دُو</>نَ"},{"n":4,"w":[["ٱللَّهُ","al-lahu","Allah","(তিনিই)আল্লাহ"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["خَلَقَ","khalaqa","created","সৃষ্টি করেছেন"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশসমূহকে"],["وَٱلْأَرْضَ","wal-arḍa","and the earth","ও পৃথিবীকে"],["وَمَا","wamā","and whatever","এবং যা কিছু"],["بَيْنَهُمَا","baynahumā","(i