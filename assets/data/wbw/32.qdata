َ سَنَ<d>ةٍۢ مِّ</><g>مَّ</>ا تَعُ<p>دُّو</>نَ"},{"n":6,"w":[["ذَٰلِكَ","dhālika","That","তিনিই"],["عَـٰلِمُ","‘ālimu","(is the) Knower","জ্ঞানী"],["ٱلْغَيْبِ","l-ghaybi","(of) the hidden","অদৃশ্যের"],["وَٱلشَّهَـٰدَةِ","wal-shahādati","and the witnessed","ও দৃশ্যের"],["ٱلْعَزِيزُ","l-‘azīzu","the All-Mighty","মহাপরাক্রমশালী"],["ٱلرَّحِيمُ","l-raḥīmu","the Most Merciful","পরম দয়ালু"]],"t":"<m>ذَٰ</>لِكَ <m>عَٰ</>لِمُ <h>ٱ</>لْغَيْبِ وَ<h>ٱ</><l>ل</>شَّ<m>هَٰ</>دَةِ <h>ٱ</>لْعَزِيزُ <h>ٱ</><l>ل</>رَّ<p>حِي</>مُ"},{"n":7,"w":[["ٱلَّذِىٓ","alladhī","The One Who","যিনি"],["أَحْسَنَ","aḥsana","made good","অতি উত্তম করেছেন"],["كُلَّ","kulla","every","প্রত্যেক"],["شَىْءٍ","shayin","thing","বস্তকে"],["خَلَقَهُۥ ۖ","khalaqahu","He created","তিনি সৃষ্টি করেছেন তা"],["وَبَدَأَ","wabada-a","and He began","এবং সূচনা করেছেন"],["خَلْقَ","khalqa","(the) creation","সৃষ্টি"],["ٱلْإِنسَـٰنِ","l-insāni","(of) man","মানুষের"],["مِن","min","from","থেকে"],["طِينٍۢ","ṭīnin","clay","কাদামাটি"]],"t":"ٱلَّ<o>ذِىٓ</> أَحْسَنَ كُلَّ شَىْءٍ خَلَقَهُ<m>ۥ</> ۖ وَبَدَأَ خَلْقَ <h>ٱ</>لْإِ<k>نسَٰ</>نِ مِ<k>ن طِ</><p>ي</>نٍۢ"},{"n":8,"w":[["ثُمَّ","thumma","Then","এরপর"],["جَعَلَ","ja‘ala","He made","সৃষ্টি করেছেন"],["نَسْلَهُۥ","naslahu","his progeny","বংশধরকে তার"],["مِن","min","from","থেকে"],["سُلَـٰلَةٍۢ","sulālatin","an extract","নির্যাস"],["مِّن","min","of","থেকে"],["مَّآءٍۢ","māin","water","পানির"],["مَّهِينٍۢ","mahīnin","despised","তুচ্ছ"]],"t":"ثُ<g>مَّ</> جَعَلَ نَسْلَهُ<m>ۥ</> مِ<k>ن سُ</><m>لَٰ</>لَ<d>ةٍۢ مِّن مَّ</><o>آ</><d>ءٍۢ مَّ</><p>هِي</>نٍۢ"},{"n":9,"w":[["ثُمَّ","thumma","Then","এরপর"],["سَوَّىٰهُ","sawwāhu","He fashioned him","সুঠাম করেছেন তাকে"],["وَنَفَخَ","wanafakha","and breathed","ও ফুঁকে দিয়েছেন"],["فِيهِ","fīhi","into him","মধ্যে তার"],["مِن","min","from","থেকে"],["رُّوحِهِۦ ۖ","rūḥihi","His spirit","রূহ তার"],["وَجَعَلَ","waja‘ala","and made","এবং দিয়েছেন"],["لَكُمُ","lakumu","for you","জন্যে তোমাদের"],["ٱلسَّمْعَ","l-sam‘a","the hearing","শ্রবণশক্তিসমূহ"],["وَٱلْأَبْصَـٰرَ","wal-abṣāra","and the sight","ও দর্শনশক্তিসমূহ"],["وَٱلْأَفْـِٔدَةَ ۚ","wal-afidata","and feelings","ও অন্তরসমূহ"],["قَلِيلًۭا","qalīlan","little","কমই"],["مَّا","mā","[what]","যা"],["تَشْكُرُونَ","tashkurūna","thanks you give","তোমরা কৃতজ্ঞতা স্বীকার করো"]],"t":"ثُ<g>مَّ</> سَوَّ<m>ىٰ</>هُ وَنَفَخَ فِيهِ <w>مِن رُّ</>وحِ<m>هِۦ</> ۖ وَجَعَلَ لَكُمُ <h>ٱ</><l>ل</>سَّمْعَ وَ<h>ٱ</>لْأَ<q>بْ</><m>صَٰ</>رَ وَ<h>ٱ</>لْأَفْـِٔدَةَ ۚ قَلِيلًۭ<d>ا مَّ</>ا تَشْكُ<p>رُو</>نَ"},{"n":10,"w":[["وَقَالُوٓا۟","waqālū","And they say","এবং তারা বলে"],["أَءِذَا","a-idhā","Is (it) when","\"কি যখন"],["ضَلَلْنَا","ḍalalnā","we are lost","আমরা মিশে যাবো"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","মাটির"],["أَءِنَّا","a-innā","will we","কি নিশ্চয়ই আমরা (হবো)"],["لَفِى","lafī","certainly be in","অবশ্যই মধ্যে"],["خَلْقٍۢ","khalqin","a creation","সৃষ্টি"],["جَدِيدٍۭ ۚ","jadīdin","new","নতুন\""],["بَلْ","bal","Nay","বরং"],["هُم","hum","they","তারা"],["بِلِقَآءِ","biliqāi","in (the) meeting","সম্পর্কে সাক্ষাত"],["رَبِّهِمْ","rabbihim","(of) their Lord","রবের তাদের"],["كَـٰفِرُونَ","kāfirūna","(are) disbelievers","অস্বীকারকারী"]],"t":"وَقَا<o>لُوٓ</><s>ا۟</> أَءِذَا ضَلَلْنَا فِى <h>ٱ</>لْأَرْضِ أَءِ<g>نَّ</>ا لَفِى خَلْ<k>قٍۢ جَ</>دِي<i>دٍۭ ۚ بَ</>لْ <f>هُم بِ</>لِ<o>قَآ</>ءِ رَبِّهِمْ <m>كَٰ</>فِ<p>رُو</>نَ"},{"n":11,"w":[["۞ قُلْ","qul","Say","বলো"],["يَتَوَفَّىٰكُم","yatawaffākum","Will take your soul","\"প্রাণ নিবে তোমাদের"],["مَّلَكُ","malaku","(the) Angel","ফেরেশতারা"],["ٱلْمَوْتِ","l-mawti","(of) the death","মৃত্যুর"],["ٱلَّذِى","alladhī","the one who","যাকে"],["وُكِّلَ","wukkila","has been put in charge","নিয়োগ করা হয়েছে"],["بِكُمْ","bikum","of you","উপর তোমাদের"],["ثُمَّ","thumma","Then","এরপর"],["إِلَىٰ","ilā","to","দিকে"],["رَبِّكُمْ","rabbikum","your Lord","রবের তোমাদের"],["تُرْجَعُونَ","tur'ja‘ūna","you will be returned","তোমরা প্রত্যাবর্তিত হবে\""]],"t":"۞ قُلْ يَتَوَفَّ<m>ىٰ</><y>كُم مَّ</>لَكُ <h>ٱ</>لْمَوْتِ <h>ٱ</>لَّذِى وُكِّلَ بِكُمْ ثُ<g>مَّ</> إِلَىٰ رَبِّكُمْ تُرْجَ<p>عُو</>نَ"},{"n":12,"w":[["وَلَوْ","walaw","And if","এবং যদি"],["تَرَىٰٓ","tarā","you (could) see","তুমি দেখতে"],["إِذِ","idhi","when","যখন"],["ٱلْمُجْرِمُونَ","l-muj'rimūna","the criminals","অপরাধীরা"],["نَاكِسُوا۟","nākisū","(will) hang","অবনতকারী (হবে)"],["رُءُوسِهِمْ","ruūsihim","their heads","মাথাসমূহ তাদের"],["عِندَ","‘inda","before","কাছে"],["رَبِّهِمْ","rabbihim","their Lord","রবের তাদের"],["رَبَّنَآ","rabbanā","Our Lord","\"(বলবে) হে আমাদের রব"],["أَبْصَرْنَا","abṣarnā","we have seen","দেখেছি আমরা"],["وَسَمِعْنَا","wasami‘'nā","and we have heard","ও শুনেছি আমরা"],["فَٱرْجِعْنَا","fa-ir'ji‘'nā","so return us","এখন ফেরত পাঠান আমাদের"],["نَعْمَلْ","na‘mal","we will do","কাজ করবো আমরা"],["صَـٰلِحًا","ṣāliḥan","righteous (deeds)","সৎ"],["إِنَّا","innā","Indeed, we","নিশ্চয়ই আমরা"],["مُوقِنُونَ","mūqinūna","(are now) certain","দৃঢ়বিশ্বাসী\""]],"t":"وَلَوْ تَرَ<o>ىٰٓ</> إِذِ <h>ٱ</>لْمُ<q>جْ</>رِمُونَ نَاكِسُو<s>ا۟</> رُءُوسِهِمْ عِ<k>ندَ</> رَبِّهِمْ رَبَّ<o>نَآ</> أَ<q>بْ</>صَرْنَا وَسَمِعْنَا فَ<h>ٱ</>رْجِعْنَا نَعْمَلْ <m>صَٰ</>لِحًا إِ<g>نَّ</>ا مُوقِ<p>نُو</>نَ"},{"n":13,"w":[["وَلَوْ","walaw","And if","এবং যদি"],["شِئْنَا","shi'nā","We (had) willed","চাইতাম আমরা"],["لَـَٔاتَيْنَا","laātaynā","surely We (would) have given","অবশ্যই দিতাম আমরা"],["كُلَّ","kulla","every","প্রত্যেক"],["نَفْسٍ","nafsin","soul","ব্যক্তিকে"],["هُدَىٰهَا","hudāhā","its guidance","পথনির্দেশ তার"],["وَلَـٰكِنْ","walākin","but","কিন্তু"],["حَقَّ","ḥaqqa","(is) true","অবধারিত হয়েছে"],["ٱلْقَوْلُ","l-qawlu","the Word","(শাস্তির)বাণী"],["مِنِّى","minnī","from Me","পক্ষ হ'তে আমার"],["لَأَمْلَأَنَّ","la-amla-anna","that I will surely fill","অবশ্যই (যে) পূর্ণ করবো আমি\""],["جَهَنَّمَ","jahannama","Hell","জাহান্নামকে"],["مِنَ","mina","with","দিয়ে"],["ٱلْجِنَّةِ","l-jinati","the jinn","জিনদের"],["وَٱلنَّاسِ","wal-nāsi","and the men","ও মানুষদের"],["أَجْمَعِينَ","ajma‘īna","together","একসাথে"]],"t":"وَلَوْ شِئْنَا لَءَاتَيْنَا كُلَّ نَفْسٍ هُدَ<m>ىٰ</>هَا وَ<m>لَٰ</>كِنْ حَقَّ <h>ٱ</>لْقَوْلُ مِ<g>نِّ</>ى لَأَمْلَأَ<g>نَّ</> جَهَ<g>نَّ</>مَ مِنَ <h>ٱ</>لْجِ<g>نَّ</>ةِ وَ<h>ٱ</><l>ل</><g>نَّ</>اسِ أَ<q>جْ</>مَ<p>عِي</>نَ"},{"n":14,"w":[["فَذُوقُوا۟","fadhūqū","So taste","সুতরাং স্বাদ নাও"],["بِمَا","bimā","because","একারণে যা"],["نَسِيتُمْ","nasītum","you forgot","ভুলে গিয়েছিলে তোমরা"],["لِقَآءَ","liqāa","(the) meeting","সাক্ষাৎ"],["يَوْمِكُمْ","yawmikum","(of) this Day of yours","দিনের তোমাদের"],["هَـٰذَآ","hādhā","(of) this Day of yours","এই"],["إِنَّا","innā","Indeed, We","নিশ্চয়ই আমরাও"],["نَسِينَـٰكُمْ ۖ","nasīnākum","have forgotten you","আমরা ভুলে গিয়েছি তোমাদের"],["وَذُوقُوا۟","wadhūqū","And taste","এবং তোমরা স্বাদ গ্রহণ করো"],["عَذَابَ","‘adhāba","(the) punishment","শাস্তির"],["ٱلْخُلْدِ","l-khul'di","(of) eternity","চিরকালীন"],["بِمَا","bimā","for what","বিনিময়ে যা"],["كُنتُمْ","kuntum","you used (to)","তোমরা ছিলে"],["تَعْمَلُونَ","ta‘malūna","do","তোমরা  কাজ করতে\""]],"t":"فَذُوقُو<s>ا۟</> بِمَا نَسِيتُمْ لِ<o>قَآ</>ءَ يَوْمِكُمْ <m>هَٰ</><o>ذَآ</> إِ<g>نَّ</>ا نَسِي<m>نَٰ</>كُمْ ۖ وَذُوقُو<s>ا۟</> عَذَابَ <h>ٱ</>لْخُلْدِ بِمَا كُ<k>نتُ</>مْ تَعْمَ<p>لُو</>نَ"},{"n":15,"w":[["إِنَّمَا","innamā","Only","কেবল"],["يُؤْمِنُ","yu'minu","believe","ঈমান আনে"],["بِـَٔايَـٰتِنَا","biāyātinā","in Our Verses","প্রতি আমাদের নিদর্শনাবলীর"],["ٱلَّذِينَ","alladhīna","those who","(তারাই)যারা"],["إِذَا","idhā","when","যখন"],["ذُكِّرُوا۟","dhukkirū","they are reminded","তাদেরকে স্মরণ করিয়ে দেওয়া হয়"],["بِهَا","bihā","of them","দ্বারা এ"],["خَرُّوا۟","kharrū","fall down","লুটিয়ে পড়ে"],["سُجَّدًۭا","sujjadan","prostrating","সিজদায়"],["وَسَبَّحُوا۟","wasabbaḥū","and glorify","ও পবিত্রতা ঘোষণা করে"],["بِحَمْدِ","biḥamdi","(the) praises","সহ প্রশংসা"],["رَبِّهِمْ","rabbihim","(of) their Lord","রবের তাদের"],["وَهُمْ","wahum","and they","এবং তারা"],["لَا","lā","are not arrogant","না"],["يَسْتَكْبِرُونَ ۩","yastakbirūna","are not arrogant","অহংকার করে"]],"t":"إِ<g>نَّ</>مَا يُؤْمِنُ بِـَٔا<m>يَٰ</>تِنَا <h>ٱ</>لَّذِينَ إِذَا ذُكِّرُو<s>ا۟</> بِهَا خَرُّو<s>ا۟</> سُجَّ<d>دًۭا وَ</>سَبَّحُو<s>ا۟</> بِحَمْدِ رَبِّهِمْ وَهُمْ لَا يَسْتَكْبِرُ<p>و</>نَ ۩"},{"n":16,"w":[["تَتَجَافَىٰ","tatajāfā","Forsake","আলাদা থাকে"],["جُنُوبُهُمْ","junūbuhum","their sides","পাশগুলো তাদের"],["عَنِ","‘ani","from","থেকে"],["ٱلْمَضَاجِعِ","l-maḍāji‘i","(their) beds","শয্যাগুলো"],["يَدْعُونَ","yad‘ūna","they call","তারা ডাকে"],["رَبَّهُمْ","rabbahum","their Lord","রবকে তাদের"],["خَوْفًۭا","khawfan","(in) fear","ভয়ে"],["وَطَمَعًۭا","waṭama‘an","and hope","ও আশায়"],["وَمِمَّا","wamimmā","and out of what","এবং তা হ'তে যা"],["رَزَقْنَـٰهُمْ","razaqnāhum","We have provided them","আমরা জীবিকা দিয়েছি তাদেরকে"],["يُنفِقُونَ","yunfiqūna","they spend","তারা ব্যয় করে"]],"t":"تَتَجَافَىٰ جُنُوبُهُمْ عَنِ <h>ٱ</>لْمَضَاجِعِ يَ<q>دْ</>عُونَ رَبَّهُمْ خَوْ<d>فًۭا وَ</>طَمَ<d>عًۭا وَ</>مِ<g>مَّ</>ا رَزَ<q>قْ</><m>نَٰ</>هُمْ يُ<k>نفِ</><p>قُو</>نَ"},{"n":17,"w":[["فَلَا","falā","And not","অতঃপর না"],["تَعْلَمُ","ta‘lamu","knows","জানে"],["نَفْسٌۭ","nafsun","a soul","কোনো ব্যক্তিই"],["مَّآ","mā","what","যা"],["أُخْفِىَ","ukh'fiya","is hidden","লুকিয়ে রাখা হয়েছে"],["لَهُم","lahum","for them","জন্যে তাদের"],["مِّن","min","of","থেকে"],["قُرَّةِ","qurrati","(the) comfort","শীতলকারী (জিনিসসমূহ)"],["أَعْيُنٍۢ","a‘yunin","(for) the eyes","চোখসমূহের"],["جَزَآءًۢ","jazāan","(as) a reward","প্রতিদান হিসেবে"],["بِمَا","bimā","for what","বিনিময়ে যা"],["كَانُوا۟","kānū","they used (to)","তারা ছিলো"],["يَعْمَلُونَ","ya‘malūna","do","তারা কাজ করতে"]],"t":"فَلَا تَعْلَمُ نَفْ<d>سٌۭ مَّ</><o>آ</> أُخْفِىَ لَ<y>هُم مِّ</><k>ن قُ</>رَّةِ أَعْيُ<k>نٍۢ جَ</><o>زَآ</><i>ءًۢ بِ</>مَا كَانُو<s>ا۟</> يَعْمَ<p>لُو</>نَ"},{"n":18,"w":[["أَفَمَن","afaman","Then is one who","কি তবে যে"],["كَانَ","kāna","is","হবে"],["مُؤْمِنًۭا","mu'minan","a believer","মু'মিন"],["كَمَن","kaman","like (him) who","(সে কি তার) মতো যে"],["كَانَ","kāna","is","হয়"],["فَاسِقًۭا ۚ","fāsiqan","defiantly disobedient","সত্যত্যাগী (দুষ্কৃতিকারী)"],["لَّا","lā","Not","না"],["يَسْتَوُۥنَ","yastawūna","they are equal","তারা সমান হতে পারে"]],"t":"أَفَمَ<k>ن كَ</>انَ مُؤْمِ<k>نًۭا كَمَن كَ</>انَ فَاسِ<w>قًۭا ۚ لَّ</>ا يَسْتَوُ<p>ۥ</>نَ"},{"n":19,"w":[["أَمَّا","ammā","As for","(আর তাদের)ব্যাপার"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["وَعَمِلُوا۟","wa‘amilū","and do","ও কাজ করেছে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","righteous deeds","সৎ"],["فَلَهُمْ","falahum","then for them","অতঃপর জন্যে তাদের"],["جَنَّـٰتُ","jannātu","(are) Gardens","জান্নাতসমূহ"],["ٱلْمَأْوَىٰ","l-mawā","(of) Refuge","বসবাসের"],["نُزُلًۢا","nuzulan","(as) hospitality","আপ্যায়ন হিসেবে"],["بِمَا","bimā","for what","বিনিময়ে যা"],["كَانُوا۟","kānū","they used (to)","তারা ছিলো"],["يَعْمَلُونَ","ya‘malūna","do","তারা কাজ করতে"]],"t":"أَ<g>مَّ</>ا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ فَلَهُمْ جَ<g>نَّٰ</>تُ <h>ٱ</>لْمَأْوَىٰ نُزُلًۢ<i>ا بِ</>مَا كَانُو<s>ا۟</> يَعْمَ<p>لُو</>نَ"},{"n":20,"w":[["وَأَمَّا","wa-ammā","But as for","আর(তাদের)ক্ষেত্রে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["فَسَقُوا۟","fasaqū","are defiantly disobedient","সত্যত্যাগ করেছে"],["فَمَأْوَىٰهُمُ","famawāhumu","then their refuge","অতঃপর বাসস্থান হবে তাদের"],["ٱلنَّارُ ۖ","l-nāru","(is) the Fire","আগুন"],["كُلَّمَآ","kullamā","Every time","যখনই"],["أَرَادُوٓا۟","arādū","they wish","তারা ইচ্ছে করবে"],["أَن","an","to","যে"],["يَخْرُجُوا۟","yakhrujū","come out","তারা বের হবে"],["مِنْهَآ","min'hā","from it","থেকে তা"],["أُعِيدُوا۟","u‘īdū","they (will) be returned","ফিরিয়ে দেওয়া হবে"],["فِيهَا","fīhā","in it","মধ্যে তার"],["وَقِيلَ","waqīla","and it (will) be said","এবং বলা হবে"],["لَهُمْ","lahum","to them","উদ্দেশ্যে তাদের"],["ذُوقُوا۟","dhūqū","Taste","\"তোমরা স্বাদ নাও"],["عَذَابَ","‘adhāba","(the) punishment","শাস্তির"],["ٱلنَّارِ","l-nāri","(of) the Fire","আগুনের"],["ٱلَّذِى","alladhī","which","যা"],["كُنتُم","kuntum","you used (to)","তোমরা ছিলে"],["بِهِۦ","bihi","[in it]","সম্বন্ধে সে"],["تُكَذِّبُونَ","tukadhibūna","deny","মিথ্যারোপ করতে\""]],"t":"وَأَ<g>مَّ</>ا <h>ٱ</>لَّذِينَ فَسَقُو<s>ا۟</> فَمَأْوَ<m>ىٰ</>هُمُ <h>ٱ</><l>ل</><g>نَّ</>ارُ ۖ كُلَّ<o>مَآ</> أَرَا<o>دُوٓ</><s>ا۟</> <d>أَن يَ</>خْرُجُو<s>ا۟</> مِنْ<o>هَآ</> أُعِيدُو<s>ا۟</> فِيهَا وَقِيلَ لَهُمْ ذُوقُو<s>ا۟</> عَذَابَ <h>ٱ</><l>ل</><g>نَّ</>ارِ <h>ٱ</>لَّذِى كُ<k>نتُ</><f>م بِ</><m>هِۦ</> تُكَذِّ<p>بُو</>نَ"},{"n":21,"w":[["وَلَنُذِيقَنَّهُم","walanudhīqannahum","And surely, We will let them taste","এবং অবশ্যই আস্বাদন করাবোই আমরা তাদের"],["مِّنَ","mina","of","কিছু"],["ٱلْعَذَابِ","l-‘adhābi","the punishment","শাস্তি (দ্বারা)"],["ٱلْأَدْنَىٰ","l-adnā","the nearer","হালকা (দুনিয়ার)"],["دُونَ","dūna","before","ছাড়াও"],["ٱلْعَذَابِ","l-‘adhābi","the punishment","শাস্তি (আখেরাতের)"],["ٱلْأَكْبَرِ","l-akbari","the greater","বড়"],["لَعَلَّهُمْ","la‘allahum","so that they may","সম্ভবত তারা"],["يَرْجِعُونَ","yarji‘ūna","return","ফিরে আসবে"]],"t":"وَلَنُذِيقَ<g>نَّ</><y>هُم مِّ</>نَ <h>ٱ</>لْعَذَابِ <h>ٱ</>لْأَ<q>دْ</>نَىٰ دُونَ <h>ٱ</>لْعَذَابِ <h>ٱ</>لْأَكْبَرِ لَعَلَّهُمْ يَرْجِ<p>عُو</>نَ"},{"n":22,"w":[["وَمَنْ","waman","And who","এবং কে"],["أَظْلَمُ","aẓlamu","(is) more unjust","বড় সীমালঙ্ঘনকারী"],["مِمَّن","mimman","than (he) who","(তার) চেয়ে যাকে"],["ذُكِّرَ","dhukkira","is reminded","উপদেশ দেওয়া হয়"],["بِـَٔايَـٰتِ","biāyāti","of (the) Verses","দিয়ে নিদর্শন সমূহ"],["رَبِّهِۦ","rabbihi","(of) his Lord","রবের তার"],["ثُمَّ","thumma","then","এরপরও"],["أَعْرَضَ","a‘raḍa","he turns away","সে মুখ ফিরিয়ে নেয়"],["عَنْهَآ ۚ","‘anhā","from them","থেকে তা"],["إِنَّا","innā","Indeed, We","নিশ্চয়ই আমরা"],["مِنَ","mina","from","থেকে"],["ٱلْمُجْرِمِينَ","l-muj'rimīna","the criminals","অপরাধীদের"],["مُنتَقِمُونَ","muntaqimūna","(will) take retribution","প্রতিশোধ গ্রহণকারী"]],"t":"وَمَنْ أَظْلَمُ مِ<g>مَّ</><k>ن ذُ</>كِّرَ بِـَٔا<m>يَٰ</>تِ رَبِّ<m>هِۦ</> ثُ<g>مَّ</> أَعْرَضَ عَنْ<o>هَآ ۚ</> إِ<g>نَّ</>ا مِنَ <h>ٱ</>لْمُ<q>جْ</>رِمِينَ مُ<k>نتَ</>قِ<p>مُو</>نَ"},{"n":23,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["ءَاتَيْنَا","ātaynā","We gave","দিয়েছি আমরা"],["مُوسَى","mūsā","Musa","মূসাকে"],["ٱلْكِتَـٰبَ","l-kitāba","the Scripture","কিতাব"],["فَلَا","falā","so (do) not","সুতরাং না (যেন)"],["تَكُن","takun","be","তুমি হয়ো (থাকো)"],["فِى","fī","in","মধ্যে"],["مِرْيَةٍۢ","mir'yatin","doubt","সন্দেহের"],["مِّن","min","about","ব্যাপারে"],["لِّقَآئِهِۦ ۖ","liqāihi","receiving it","পাওয়ার তা"],["وَجَعَلْنَـٰهُ","waja‘alnāhu","And We made it","এবং আমরা বানিয়েছিলাম তাকে"],["هُدًۭى","hudan","a guide","পথনির্দেশনা"],["لِّبَنِىٓ","libanī","for the Children of Israel","জন্যে সন্তানদের"],["إِسْرَٰٓءِيلَ","is'rāīla","for the Children of Israel","ইসরাঈলের"]],"t":"وَلَقَ<q>دْ</> ءَاتَيْنَا مُوسَى <h>ٱ</>لْكِ<m>تَٰ</>بَ فَلَا تَكُ<k>ن فِ</>ى مِرْيَ<d>ةٍۢ مِّ</><w>ن لِّ</><o>قَآ</>ئِ<m>هِۦ ۖ</> وَجَعَلْ<m>نَٰ</>هُ هُ<w>دًۭى لِّ</>بَ<o>نِىٓ</> إِسْ<o>رَٰٓ</><p>ءِي</>لَ"},{"n":24,"w":[["وَجَعَلْنَا","waja‘alnā","And We made","এবং মনোনীত করেছিলাম আমরা"],["مِنْهُمْ","min'hum","from them","মধ্যে থেকে তাদের"],["أَئِمَّةًۭ","a-immatan","leaders","(অনেক) নেতা"],["يَهْدُونَ","yahdūna","guiding","(যারা) পথ দেখাতো"],["بِأَمْرِنَا","bi-amrinā","by Our Command","অনুসারে আমাদের নির্দেশ"],["لَمَّا","lammā","when","যখন"],["صَبَرُوا۟ ۖ","ṣabarū","they were patient","তারা ধৈর্য ধরেছিলো"],["وَكَانُوا۟","wakānū","and they were","এবং তারা ছিলো"],["بِـَٔايَـٰتِنَا","biāyātinā","of Our Verses","প্রতি আমাদের নিদর্শনগুলোর"],["يُوقِنُونَ","yūqinūna","certain","দৃঢ়বিশ্বাস করতো"]],"t":"وَجَعَلْنَا مِنْهُمْ أَئِ<g>مَّ</><d>ةًۭ يَ</>هْدُونَ بِأَمْرِنَا لَ<g>مَّ</>ا صَبَرُو<s>ا۟ ۖ</> وَكَانُو<s>ا۟</> بِـَٔا<m>يَٰ</>تِنَا يُوقِ<p>نُو</>نَ"},{"n":25,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["رَبَّكَ","rabbaka","your Lord","তোমার রব"],["هُوَ","huwa","[He]","তিনিই"],["يَفْصِلُ","yafṣilu","will judge","মীমাংসা করে দিবেন"],["بَيْنَهُمْ","baynahum","between them","মাঝে তাদের"],["يَوْمَ","yawma","(on the) Day","দিনে"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) Resurrection","ক্বিয়ামাতের"],["فِيمَا","fīmā","in what","ঐ বিষয়ে যা"],["كَانُوا۟","kānū","they used (to)","তারা ছিলো"],["فِيهِ","fīhi","[in it]","বিষয়ে সে"],["يَخْتَلِفُونَ","yakhtalifūna","differ","তারা মত-বিরোধ করতো"]],"t":"إِ<g>نَّ</> رَبَّكَ هُوَ يَفْصِلُ بَيْنَهُمْ يَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ فِيمَا كَانُو<s>ا۟</> فِيهِ يَخْتَلِ<p>فُو</>نَ"},{"n":26,"w":[["أَوَلَمْ","awalam","Does it not","(এটাও) কি না"],["يَهْدِ","yahdi","guide","পথপ্রদর্শন করে"],["لَهُمْ","lahum","[for] them","জন্যে তাদের"],["كَمْ","kam","(that) how many","কতই (না)"],["أَهْلَكْنَا","ahlaknā","We have destroyed","ধ্বংস করেছি আমরা"],["مِن","min","before them","থেকে"],["قَبْلِهِم","qablihim","before them","পূর্ব তাদের"],["مِّنَ","mina","of","মধ্য হ'তে"],["ٱلْقُرُونِ","l-qurūni","the generations","মানবগোষ্ঠীর"],["يَمْشُونَ","yamshūna","they walk about","তারা বিচরণ করে"],["فِى","fī","in","মধ্য দিয়ে"],["مَسَـٰكِنِهِمْ ۚ","masākinihim","their dwellings","বাসভূমির তাদের"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে (রয়েছে)"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَـٰتٍ ۖ","laāyātin","surely, are Signs","অবশ্যই নিদর্শনাবলী"],["أَفَلَا","afalā","Then do not","কি তবুও না"],["يَسْمَعُونَ","yasma‘ūna","they hear","তারা শুনবে"]],"t":"أَوَلَمْ يَهْدِ لَهُمْ كَمْ أَهْلَكْنَا مِ<k>ن قَ</><q>بْ</>لِ<y>هِم مِّ</>نَ <h>ٱ</>لْقُرُونِ يَمْشُونَ فِى مَ<m>سَٰ</>كِنِهِمْ ۚ إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَا<m>يَٰ</>تٍ ۖ أَفَلَا يَسْمَ<p>عُو</>نَ"},{"n":27,"w":[["أَوَلَمْ","awalam","Do not","কি না"],["يَرَوْا۟","yaraw","they see","তারা দেখে"],["أَنَّا","annā","that We","যে আমরা"],["نَسُوقُ","nasūqu","drive","প্রবাহিত করি"],["ٱلْمَآءَ","l-māa","water","পানি"],["إِلَى","ilā","to","দিকে"],["ٱلْأَرْضِ","l-arḍi","the land","ভূমির"],["ٱلْجُرُزِ","l-juruzi","[the] barren","(তৃণ পানিবিহীন) ঊষর"],["فَنُخْرِجُ","fanukh'riju","then We bring forth","এরপর বের করি আমরা"],["بِهِۦ","bihi","thereby","দিয়ে তা"],["زَرْعًۭا","zar‘an","crops","শস্য"],["تَأْكُلُ","takulu","eat","খায়"],["مِنْهُ","min'hu","from it","থেকে তা"],["أَنْعَـٰمُهُمْ","an‘āmuhum","their cattle","গবাদি পশু তাদের"],["وَأَنفُسُهُمْ ۖ","wa-anfusuhum","and they themselves","এবং নিজেরাও তারা"],["أَفَلَا","afalā","Then do not","কি তবুুও  না"],["يُبْصِرُونَ","yub'ṣirūna","they see","তারা লক্ষ্য করবে (বা বুঝবে)"]],"t":"أَوَلَمْ يَرَوْ<s>ا۟</> أَ<g>نَّ</>ا نَسُوقُ <h>ٱ</>لْ<o>مَآ</>ءَ إِلَى <h>ٱ</>لْأَرْضِ <h>ٱ</>لْجُرُزِ فَنُخْرِجُ بِ<m>هِۦ</> زَرْ<k>عًۭا تَ</>أْكُلُ مِنْهُ أَنْ<m>عَٰ</>مُهُمْ وَأَ<k>نفُ</>سُهُمْ ۖ أَفَلَا يُ<q>بْ</>صِ<p>رُو</>نَ"},{"n":28,"w":[["وَيَقُولُونَ","wayaqūlūna","And they say","এবং তারা বলে"],["مَتَىٰ","matā","When (will be)","\"কখন (আসবে)"],["هَـٰذَا","hādhā","this","এই"],["ٱلْفَتْحُ","l-fatḥu","decision","মীমাংসা"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you are","তোমরা হও"],["صَـٰدِقِينَ","ṣādiqīna","truthful","সত্যবাদী\""]],"t":"وَيَقُولُونَ مَتَىٰ <m>هَٰ</>ذَا <h>ٱ</>لْفَتْحُ إِ<k>ن كُنتُ</>مْ <m>صَٰ</>دِ<p>قِي</>نَ"},{"n":29,"w":[["قُلْ","qul","Say","বলো"],["يَوْمَ","yawma","(On the) Day","\"দিন"],["ٱلْفَتْحِ","l-fatḥi","(of) the Decision","মীমাংসার"],["لَا","lā","not","না"],["يَنفَعُ","yanfa‘u","will benefit","উপকার দিবে"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["كَفَرُوٓا۟","kafarū","disbelieve","অবিশ্বাস করেছে"],["إِيمَـٰنُهُمْ","īmānuhum","their belief","ঈমান তাদের"],["وَلَا","walā","and not","আর না"],["هُمْ","hum","they","তাদের"],["يُنظَرُونَ","yunẓarūna","will be granted respite","অবকাশ দেওয়া হবে\""]],"t":"قُلْ يَوْمَ <h>ٱ</>لْفَتْحِ لَا يَ<k>نفَ</>عُ <h>ٱ</>لَّذِينَ كَفَ<o>رُوٓ</><s>ا۟</> إِي<m>مَٰ</>نُهُمْ وَلَا هُمْ يُ<k>نظَ</><p>رُو</>نَ"},{"n":30,"w":[["فَأَعْرِضْ","fa-a‘riḍ","So turn away","সুতরাং (এ অবস্থায়) ছেড়ে দাও"],["عَنْهُمْ","‘anhum","from them","ব্যাপারে তাদের"],["وَٱنتَظِرْ","wa-intaẓir","and wait","ও অপেক্ষা করো"],["إِنَّهُم","innahum","Indeed, they","নিশ্চয়ই তারাও"],["مُّنتَظِرُونَ","muntaẓirūna","(are) waiting","অপেক্ষাকারী"]],"t":"فَأَعْرِضْ عَنْهُمْ وَ<h>ٱ</><k>نتَ</>ظِرْ إِ<g>نَّ</><y>هُم مُّ</><k>نتَ</>ظِ<p>رُو</>نَ"}]}