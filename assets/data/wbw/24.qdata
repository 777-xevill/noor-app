حُو</>نَ"},{"n":32,"w":[["وَأَنكِحُوا۟","wa-ankiḥū","And marry","এবং তোমরা বিয়ে দাও"],["ٱلْأَيَـٰمَىٰ","l-ayāmā","the single","বিবাহহীনদেরকে"],["مِنكُمْ","minkum","among you","তোমাদের মধ্য থেকে"],["وَٱلصَّـٰلِحِينَ","wal-ṣāliḥīna","and the righteous","ও (যারা) সচ্চরিত্রবান"],["مِنْ","min","among","মধ্য হ'তে"],["عِبَادِكُمْ","‘ibādikum","your male slaves","তোমাদের দাসদের"],["وَإِمَآئِكُمْ ۚ","wa-imāikum","and your female slaves","ও তোমাদের দাসীদের"],["إِن","in","If","যদি"],["يَكُونُوا۟","yakūnū","they are","তারা হয়"],["فُقَرَآءَ","fuqarāa","poor","অভাবগ্রস্ত"],["يُغْنِهِمُ","yugh'nihimu","Allah will enrich them","তাদের অভাবমুক্ত করে দিবেন"],["ٱللَّهُ","l-lahu","Allah will enrich them","আল্লাহ্‌"],["مِن","min","from","মাধ্যমে"],["فَضْلِهِۦ ۗ","faḍlihi","His Bounty","তাঁর অনুগ্রহের"],["وَٱللَّهُ","wal-lahu","And Allah","আর আল্লাহ্‌"],["وَٰسِعٌ","wāsi‘un","(is) All-Encompassing","প্রাচুর্যময়"],["عَلِيمٌۭ","‘alīmun","All-Knowing","মহাবিজ্ঞ"]],"t":"وَأَ<k>نكِ</>حُو<s>ا۟</> <h>ٱ</>لْأَ<m>يَٰ</>مَىٰ مِ<k>نكُ</>مْ وَ<h>ٱ</><l>ل</><m>صَّٰ</>لِحِينَ مِنْ عِبَادِكُمْ وَإِ<o>مَآ</>ئِكُمْ ۚ <d>إِن يَ</>كُونُو<s>ا۟</> فُقَ<o>رَآ</>ءَ يُغْنِهِمُ <h>ٱ</>للَّهُ مِ<k>ن فَ</>ضْلِ<m>هِۦ</> ۗ وَ<h>ٱ</>للَّهُ <m>وَٰ</>سِعٌ عَ<p>لِي</>مٌۭ"},{"n":33,"w":[["وَلْيَسْتَعْفِفِ","walyasta‘fifi","And let be chaste","এবং যেন সংযত হয়"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["لَا","lā","(do) not","না"],["يَجِدُونَ","yajidūna","find","তারা পায় (সামর্থ্য রাখে)"],["نِكَاحًا","nikāḥan","(means for) marriage","বিয়ে করতে"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["يُغْنِيَهُمُ","yugh'niyahumu","Allah enriches them","তাদেরকে অভাবমুক্ত করে দেন"],["ٱللَّهُ","l-lahu","Allah enriches them","আল্লাহ্‌"],["مِن","min","from","মাধ্যমে"],["فَضْلِهِۦ ۗ","faḍlihi","His Bounty","তাঁর অনুগ্রহের"],["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["يَبْتَغُونَ","yabtaghūna","seek","তারা চায়"],["ٱلْكِتَـٰبَ","l-kitāba","the writing","(মুক্তির) লিখিত চুক্তিপত্র করতে"],["مِمَّا","mimmā","from (those) whom","তাদের মধ্য হ'তে যাদের"],["مَلَكَتْ","malakat","possess","মালিক করেছে"],["أَيْمَـٰنُكُمْ","aymānukum","your right hands","তোমাদের ডান হাত (অর্থাৎ দাসদাসী)"],["فَكَاتِبُوهُمْ","fakātibūhum","then give them (the) writing","তাহ'লে তোমরা লিখে নাও (মুক্তির চুক্তি করো) তাদের সাথে"],["إِنْ","in","if","যদি"],["عَلِمْتُمْ","‘alim'tum","you know","তোমরা জানতে পারো"],["فِيهِمْ","fīhim","in them","তাদের মধ্যে রয়েছে"],["خَيْرًۭا ۖ","khayran","any good","কল্যাণ"],["وَءَاتُوهُم","waātūhum","and give them","এবং তাদেরকে দাও"],["مِّن","min","from","হ'তে"],["مَّالِ","māli","the wealth of Allah","সম্পদ"],["ٱللَّهِ","l-lahi","the wealth of Allah","আল্লাহ্‌র"],["ٱلَّذِىٓ","alladhī","which","যা"],["ءَاتَىٰكُمْ ۚ","ātākum","He has given you","তিনি দিয়েছেন তোমাদেরকে"],["وَلَا","walā","And (do) not","এবং না"],["تُكْرِهُوا۟","tuk'rihū","compel","তোমরা বাধ্য করো"],["فَتَيَـٰتِكُمْ","fatayātikum","your slave girls","তোমাদের দাসদাসীদেরকে"],["عَلَى","‘alā","to","জন্য"],["ٱلْبِغَآءِ","l-bighāi","[the] prostitution","বেশ্যা বৃত্তির"],["إِنْ","in","if","যখন"],["أَرَدْنَ","aradna","they desire","তারা চায়"],["تَحَصُّنًۭا","taḥaṣṣunan","chastity","সতীত্ব রক্ষা করতে"],["لِّتَبْتَغُوا۟","litabtaghū","that you may seek","যেন তোমরা আশা করো"],["عَرَضَ","‘araḍa","temporary gain","স্বার্থ"],["ٱلْحَيَوٰةِ","l-ḥayati","(of) the life","জীবনের"],["ٱلدُّنْيَا ۚ","l-dun'yā","(of) the world","পার্থিব"],["وَمَن","waman","And whoever","আর যে"],["يُكْرِههُّنَّ","yuk'rihhunna","compels them","তাদেরকে বাধ্য করবে"],["فَإِنَّ","fa-inna","then indeed","তাহ'লে নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["مِنۢ","min","after","থেকে"],["بَعْدِ","ba‘di","after","পর"],["إِكْرَٰهِهِنَّ","ik'rāhihinna","their compulsion","তাদেরকে জবরদস্তির"],["غَفُورٌۭ","ghafūrun","(is) Oft-Forgiving","(তাদের উপর) ক্ষমাশীল"],["رَّحِيمٌۭ","raḥīmun","Most Merciful","পরম দয়ালু"]],"t":"وَلْيَسْتَعْفِفِ <h>ٱ</>لَّذِينَ لَا يَجِدُونَ نِكَاحًا حَتَّىٰ يُغْنِيَهُمُ <h>ٱ</>للَّهُ مِ<k>ن فَ</>ضْلِ<m>هِۦ</> ۗ وَ<h>ٱ</>لَّذِينَ يَ<q>بْ</>تَغُ