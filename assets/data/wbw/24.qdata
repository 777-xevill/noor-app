জন্যে যার"],["شِئْتَ","shi'ta","you will","তুমি চাও"],["مِنْهُمْ","min'hum","among them","তাদের মধ্য হ'তে"],["وَٱسْتَغْفِرْ","wa-is'taghfir","and ask forgiveness","আর ক্ষমা চাও"],["لَهُمُ","lahumu","for them","জন্যে তাদের"],["ٱللَّهَ ۚ","l-laha","(of) Allah","আল্লাহ্‌র (নিকট)"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["غَفُورٌۭ","ghafūrun","(is) Oft-Forgiving","ক্ষমাশীল"],["رَّحِيمٌۭ","raḥīmun","Most Merciful","পরম দয়ালু"]],"t":"إِ<g>نَّ</>مَا <h>ٱ</>لْمُؤْمِنُونَ <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> بِ<h>ٱ</>للَّهِ وَرَسُولِ<m>هِۦ</> وَإِذَا كَانُو<s>ا۟</> مَعَهُ<m>ۥ</> عَلَ<o>ىٰٓ</> أَمْ<k>رٍۢ جَ</>امِ<w>عٍۢ لَّ</>مْ يَذْهَبُو<s>ا۟</> حَتَّىٰ يَسْتَـْٔذِنُوهُ ۚ إِ<g>نَّ</> <h>ٱ</>لَّذِينَ يَسْتَـْٔذِنُونَكَ أُ<s>و۟</><o>لَٰٓ</>ئِكَ <h>ٱ</>لَّذِينَ يُؤْمِنُونَ بِ<h>ٱ</>للَّهِ وَرَسُولِ<m>هِۦ</> ۚ فَإِذَا <h>ٱ</>سْتَـْٔذَنُوكَ لِبَعْضِ شَأْنِهِمْ فَأْ<w>ذَن لِّ</>مَ<k>ن شِ</>ئْتَ مِنْهُمْ وَ<h>ٱ</>سْتَغْفِرْ لَهُمُ <h>ٱ</>للَّهَ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ غَفُو<w>رٌۭ رَّ</><p>حِي</>مٌۭ"},{"n":63,"w":[["لَّا","lā","(Do) not","না"],["تَجْعَلُوا۟","taj‘alū","make","তোমরা গণ্য করো"],["دُعَآءَ","du‘āa","(the) calling","আহ্বানকে"],["ٱلرَّسُولِ","l-rasūli","(of) the Messenger","রাসূলের"],["بَيْنَكُمْ","baynakum","among you","তোমাদের মাঝে"],["كَدُعَآءِ","kadu‘āi","as (the) call","আহ্বানের মতো"],["بَعْضِكُم","ba‘ḍikum","(of) some of you","তোমাদের একে"],["بَعْضًۭا ۚ","ba‘ḍan","(to) others","অপরের"],["قَدْ","qad","Verily","নিশ্চয়ই"],["يَعْلَمُ","ya‘lamu","Allah knows","জানেন"],["ٱللَّهُ","l-lahu","Allah knows","আল্লাহ্‌"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["يَتَسَلَّلُونَ","yatasallalūna","slip away","তারা সরে পড়ে"],["مِنكُمْ","minkum","among you","মধ্যে হ'তে তোমাদের"],["لِوَاذًۭا ۚ","liwādhan","under shelter","(আড়ালে) চুপিচুপি"],["فَلْيَحْذَرِ","falyaḥdhari","So let beware","সুতরাং ভয় করা উচিৎ"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["يُخَالِفُونَ","yukhālifūna","oppose","বিরুদ্ধাচারণ করে"],["عَنْ","‘an","[from]","বিষয়ে"],["أَمْرِهِۦٓ","amrihi","his orders","তাঁর হুকুমের"],["أَن","an","lest","যে"],["تُصِيبَهُمْ","tuṣībahum","befalls them","(উপরে) পড়বে তাদের"],["فِتْنَةٌ","fit'natun","a trial","বিপর্যয়"],["أَوْ","aw","or","অথবা"],["يُصِيبَهُمْ","yuṣībahum","befalls them","(উপরে) পড়বে তাদের"],["عَذَابٌ","‘adhābun","a punishment","শাস্তি"],["أَلِيمٌ","alīmun","painful","নিদারুণ"]],"t":"لَّا تَ<q>جْ</>عَلُو<s>ا۟</> دُ<o>عَآ</>ءَ <h>ٱ</><l>ل</>رَّسُولِ بَيْنَكُمْ كَدُ<o>عَآ</>ءِ بَعْضِ<f>كُم بَ</>عْ<k>ضًۭا ۚ قَ</><q>دْ</> يَعْلَمُ <h>ٱ</>للَّهُ <h>ٱ</>لَّذِينَ يَتَسَلَّلُونَ مِ<k>نكُ</>مْ لِوَا<k>ذًۭا ۚ فَ</>لْيَحْذَرِ <h>ٱ</>لَّذِينَ يُخَالِفُونَ عَنْ أَمْرِ<o>هِۦٓ</> أَ<k>ن تُ</>صِيبَهُمْ فِتْنَةٌ أَوْ يُصِيبَهُمْ عَذَابٌ أَ<p>لِي</>مٌ"},{"n":64,"w":[["أَلَآ","alā","No doubt","সাবধান হও"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["لِلَّهِ","lillahi","to Allah (belongs)","জন্যে আল্লাহরই"],["مَا","mā","whatever","যা কিছু"],["فِى","fī","(is) in","আছে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশমন্ডলিতে"],["وَٱلْأَرْضِ ۖ","wal-arḍi","and the earth","ও পৃথিবীতে"],["قَدْ","qad","Verily","নিশ্চয়ই"],["يَعْلَمُ","ya‘lamu","He knows","তিনি জানেন"],["مَآ","mā","what","তা"],["أَنتُمْ","antum","you","তোমরা (আছো)"],["عَلَيْهِ","‘alayhi","(are) on [it]","যে (অবস্থার) উপরে"],["وَيَوْمَ","wayawma","And (the) Day","এবং যেদিন"],["يُرْجَعُونَ","yur'ja‘ūna","they will be returned","তোমরা প্রত্যাবর্তিত হবে"],["إِلَيْهِ","ilayhi","to Him","তাঁর দিকে"],["فَيُنَبِّئُهُم","fayunabbi-uhum","then He will inform them","তখন তিনি জানিয়ে দিবেন তাদেরকে"],["بِمَا","bimā","of what","ঐবিষয়ে যা"],["عَمِلُوا۟ ۗ","‘amilū","they did","তারা কাজ করেছে"],["وَٱللَّهُ","wal-lahu","And Allah","আর আল্লাহ"],["بِكُلِّ","bikulli","of every","সম্পর্কে সব"],["شَىْءٍ","shayin","thing","কিছু"],["عَلِيمٌۢ","‘alīmun","(is) All-Knower","খুব জ্ঞাত"]],"t":"أَ<o>لَآ</> إِ<g>نَّ</> لِلَّهِ مَا فِى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ ۖ قَ<q>دْ</> يَعْلَمُ <o>مَآ</> أَ<k>نتُ</>مْ عَلَيْهِ وَيَوْمَ يُرْجَعُونَ إِلَيْهِ فَيُنَبِّئُ<f>هُم بِ</>مَا عَمِلُو<s>ا۟ ۗ</> وَ<h>ٱ</>للَّهُ بِكُلِّ شَىْءٍ عَ<p>لِي</>مٌۢ"}]}