ةِ ۙ","l-zakati","zakah","যাকাত"],["يَخَافُونَ","yakhāfūna","They fear","তারা ভয় করে"],["يَوْمًۭا","yawman","a Day","সেদিনের (যখন)"],["تَتَقَلَّبُ","tataqallabu","will turn about","উল্টে যাবে"],["فِيهِ","fīhi","therein","তার মধ্যে"],["ٱلْقُلُوبُ","l-qulūbu","the hearts","অন্তরসমূহ"],["وَٱلْأَبْصَـٰرُ","wal-abṣāru","and the eyes","ও দৃষ্টিসমূহ"]],"t":"رِجَا<w>لٌۭ لَّ</>ا تُلْهِيهِمْ تِ<m>جَٰ</>رَ<d>ةٌۭ وَ</>لَا بَيْعٌ عَ<k>ن ذِ</>كْرِ <h>ٱ</>للَّهِ وَإِقَامِ <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةِ وَإِي<o>تَآ</>ءِ <h>ٱ</><l>ل</>زَّكَ<s>وٰ</>ةِ ۙ يَخَافُونَ يَوْ<k>مًۭا تَ</>تَقَلَّبُ فِيهِ <h>ٱ</>لْقُلُوبُ وَ<h>ٱ</>لْأَ<q>بْ</><p>صَٰ</>رُ"},{"n":38,"w":[["لِيَجْزِيَهُمُ","liyajziyahumu","That Allah may reward them","(তারা এসব করে এজন্যে) যেন তাদেরকে প্রতিফল দেন"],["ٱللَّهُ","l-lahu","That Allah may reward them","আল্লাহ্‌"],["أَحْسَنَ","aḥsana","(with the) best","উত্তম"],["مَا","mā","(of) what","যা"],["عَمِلُوا۟","‘amilū","they did","তারা কাজ করেছে"],["وَيَزِيدَهُم","wayazīdahum","and increase them","এবং তাদেরকে বাড়িয়ে দেন (যেন অতিরিক্ত কিছু)"],["مِّن","min","from","সাহায্যে"],["فَضْلِهِۦ ۗ","faḍlihi","His Bounty","তাঁর অনুগ্রহের"],["وَٱللَّهُ","wal-lahu","And Allah","আর আল্লাহ্‌"],["يَرْزُقُ","yarzuqu","provides","জীবিকা দেন"],["مَن","man","whom","যাকে"],["يَشَآءُ","yashāu","He wills","ইচ্ছে করেন তিনি"],["بِغَيْرِ","bighayri","without","ছাড়াই"],["حِسَابٍۢ","ḥisābin","measure","কোন হিসাব"]],"t":"لِيَ<q>جْ</>زِيَهُمُ <h>ٱ</>للَّهُ أَحْسَنَ مَا عَمِلُو<s>ا۟</> وَيَزِيدَ<y>هُم مِّ</><k>ن فَ</>ضْلِ<m>هِۦ</> ۗ وَ<h>ٱ</>للَّهُ يَرْزُقُ <d>مَن يَ</><o>شَآ</>ءُ بِغَيْرِ حِ<p>سَا</><q>بٍۢ</>"},{"n":39,"w":[["وَٱلَّذِينَ","wa-alladhīna","But those who","আর যারা"],["كَفَرُوٓا۟","kafarū","disbelieve","অস্বীকার করেছে"],["أَعْمَـٰلُهُمْ","a‘māluhum","their deeds","তাদের কর্মসমূহ"],["كَسَرَابٍۭ","kasarābin","(are) like a mirage","মতো মরীচিকার"],["بِقِيعَةٍۢ","biqī‘atin","in a lowland","মধ্যে মরুভূমির"],["يَحْسَبُهُ","yaḥsabuhu","thinks it","তাকে মনে করে"],["ٱلظَّمْـَٔانُ","l-ẓamānu","the thirsty one","পিপাসার্ত লোক"],["مَآءً","māan","(to be) water","পানি (হিসেবে)"],["حَتَّىٰٓ","ḥattā","until","এমনকি"],["إِذَا","idhā","when","যখন"],["جَآءَهُۥ","jāahu","he comes to it","সেখানে পৌঁছলো"],["لَمْ","lam","not","না"],["يَجِدْهُ","yajid'hu","he finds it","সেখানে পেলো"],["شَيْـًۭٔا","shayan","(to be) anything","কিছুই"],["وَوَجَدَ","wawajada","but he finds","বরং পেলো"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌কে"],["عِندَهُۥ","‘indahu","before him","তার কাছে"],["فَوَفَّىٰهُ","fawaffāhu","He will pay him in full","তখন তাকে পূর্ণ করে দিলেন"],["حِسَابَهُۥ ۗ","ḥisābahu","his due","তার হিসাব"],["وَٱللَّهُ","wal-lahu","And Allah","আর আল্লাহ্‌"],["سَرِيعُ","sarī‘u","(is) swift","দ্রুত"],["ٱلْحِسَابِ","l-ḥisābi","(in) the account","হিসাবগ্রহণে"]],"t":"وَ<h>ٱ</>لَّذِينَ كَفَ<o>رُوٓ</><s>ا۟</> أَعْ<m>مَٰ</>لُهُمْ كَسَرَا<i>بٍۭ بِ</>قِيعَ<d>ةٍۢ يَ</>حْسَبُهُ <h>ٱ</><l>ل</>ظَّمْـَٔانُ <o>مَآ</>ءً حَتَّ<o>ىٰٓ</> إِذَا <o>جَآ</>ءَهُ<m>ۥ</> لَمْ يَجِ<q>دْ</>هُ شَ<d>يْـًۭٔا وَ</>وَجَدَ <h>ٱ</>للَّهَ عِ<k>ندَ</>هُ<m>ۥ</> فَوَفَّ<m>ىٰ</>هُ حِسَابَهُ<m>ۥ</> ۗ وَ<h>ٱ</>للَّهُ سَرِيعُ <h>ٱ</>لْحِ<p>سَا</><q>بِ</>"},{"n":40,"w":[["أَوْ","aw","Or","অথবা"],["كَظُلُمَـٰتٍۢ","kaẓulumātin","(is) like (the) darkness[es]","মতো অন্ধকারপুঞ্জের"],["فِى","fī","in","মধ্যে"],["بَحْرٍۢ","baḥrin","a sea","সমুদ্রের"],["لُّجِّىٍّۢ","lujjiyyin","deep","গভীর"],["يَغْشَىٰهُ","yaghshāhu","covers it","তাকে আচ্ছন্ন করে রেখেছে"],["مَوْجٌۭ","mawjun","a wave","ঢেউ"],["مِّن","min","on it","হ'তে"],["فَوْقِهِۦ","fawqihi","on it","তার উপর"],["مَوْجٌۭ","mawjun","a wave","ঢেউ"],["مِّن","min","on it","থেকে"],["فَوْقِهِۦ","fawqihi","on it","তার উপর"],["سَحَابٌۭ ۚ","saḥābun","a cloud","মেঘমালা"],["ظُلُمَـٰتٌۢ","ẓulumātun","darkness[es]","অন্ধকারপুঞ্জ"],["بَعْضُهَا","ba‘ḍuhā","some of it","তার কিছু (স্তরের)"],["فَوْقَ","fawqa","on","উপর"],["بَعْضٍ","ba‘ḍin","others","কিছু (স্তর)"],["إِذَآ","idhā","When","যখন"],["أَخْرَجَ","akhraja","he puts out","সে বের করে"],["يَدَهُۥ","yadahu","his hand","তার হাত"],["لَمْ","lam","hardly","না"],["يَكَدْ","yakad","hardly","মোটেই"],["يَرَىٰهَا ۗ","yarāhā","he (can) see it","তা দেখতে পায়"],["وَمَن","waman","And (for) whom","আর যাকে"],["لَّمْ","lam","not","নি"],["يَجْعَلِ","yaj‘ali","Allah (has) made","দেন"],["ٱللَّهُ","l-lahu","Allah (has) made","আল্লাহ্‌"],["لَهُۥ","lahu","for him","জন্যে তার"],["نُورًۭا","nūran","a light","আলো"],["فَمَا","famā","then not","তখন নেই"],["لَهُۥ","lahu","for him","তার জন্য"],["مِن","min","(is) any","কোন"],["نُّورٍ","nūrin","light","আলো"]],"t":"أَوْ كَظُلُ<m>مَٰ</><k>تٍۢ فِ</>ى بَحْ<w>رٍۢ لُّ</>جِّ<d>ىٍّۢ يَ</>غْشَ<m>ىٰ</>هُ مَوْ<d>جٌۭ مِّ</><k>ن فَ</>وْقِ<m>هِۦ</> مَوْ<d>جٌۭ مِّ</><k>ن فَ</>وْقِ<m>هِۦ</> سَحَا<k>بٌۭ ۚ ظُ</>لُ<m>مَٰ</><i>تٌۢ بَ</>عْضُهَا فَوْقَ بَعْضٍ إِ<o>ذَآ</> أَخْرَجَ يَدَهُ<m>ۥ</> لَمْ يَكَ<q>دْ</> يَرَ<m>ىٰ</>هَا ۗ وَ<w>مَن لَّ</>مْ يَ<q>جْ</>عَلِ <h>ٱ</>للَّهُ لَهُ<m>ۥ</> نُو<k>رًۭا فَ</>مَا لَهُ<m>ۥ</> <d>مِن نُّ</><p>و</>رٍ"},{"n":41,"w":[["أَلَمْ","alam","Do not","কি নি দেখো"],["تَرَ","tara","you see","তুমি"],["أَنَّ","anna","that","যে"],["ٱللَّهَ","l-laha","Allah ","আল্লাহ্‌র"],["يُسَبِّحُ","yusabbiḥu","glorify","পবিত্র মহিমা ঘোষনা করছে"],["لَهُۥ","lahu","Him","জন্যে তাঁরই"],["مَن","man","whoever","যা কিছু"],["فِى","fī","(is) in","মধ্যে (অাছে)"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশমণ্ডলির"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীতে"],["وَٱلطَّيْرُ","wal-ṭayru","and the birds","আর পাখিরাও (যারা)"],["صَـٰٓفَّـٰتٍۢ ۖ","ṣāffātin","(with) wings outspread","ডানা মেলে চলছে (উড়ন্ত)"],["كُلٌّۭ","kullun","Each one","প্রত্যেকে"],["قَدْ","qad","verily","নিশ্চয়ই"],["عَلِمَ","‘alima","knows","জেনে নিয়েছে"],["صَلَاتَهُۥ","ṣalātahu","its prayer","তাঁর প্রার্থনার"],["وَتَسْبِيحَهُۥ ۗ","watasbīḥahu","and its glorification","ও তাঁর পবিত্র মহিমা ঘোষনা করার (নিয়ম)"],["وَٱللَّهُ","wal-lahu","And Allah","আর আল্লাহ্‌"],["عَلِيمٌۢ","‘alīmun","(is) All-Knower","খুব অবহিত"],["بِمَا","bimā","of what","ঐ বিষয়ে যা"],["يَفْعَلُونَ","yaf‘alūna","they do","তারা করছে"]],"t":"أَلَمْ تَرَ أَ<g>نَّ</> <h>ٱ</>للَّهَ يُسَبِّحُ لَهُ<m>ۥ</> مَ<k>ن فِ</>ى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ وَ<h>ٱ</><l>ل</>طَّيْرُ <n>صَٰٓ</><m>فَّٰ</><k>تٍۢ ۖ كُلٌّۭ قَ</><q>دْ</> عَلِمَ صَلَاتَهُ<m>ۥ</> وَتَسْبِيحَهُ<m>ۥ</> ۗ وَ<h>ٱ</>للَّهُ عَلِي<i>مٌۢ بِ</>مَا يَفْعَ<p>لُو</>نَ"},{"n":42,"w":[["وَلِلَّهِ","walillahi","And to Allah (belongs)","আর জন্যে আল্লাহ্‌রই"],["مُلْكُ","mul'ku","(the) dominion","সার্বভৌমত্ব"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশমণ্ডলির"],["وَٱلْأَرْضِ ۖ","wal-arḍi","and the earth","ও পৃথিবীর"],["وَإِلَى","wa-ilā","And to","এবং দিকে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌রই"],["ٱلْمَصِيرُ","l-maṣīru","(is) the destination","প্রত্যাবর্তন (সকলেরই)"]],"t":"وَلِلَّهِ مُلْكُ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ ۖ وَإِلَى <h>ٱ</>للَّهِ <h>ٱ</>لْمَ<p>صِي</>رُ"},{"n":43,"w":[["أَلَمْ","alam","Do not","কি নি"],["تَرَ","tara","you see","তুমি লক্ষ্য করো"],["أَنَّ","anna","that","যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["يُزْجِى","yuz'jī","drives","সঞ্চালিত করেন"],["سَحَابًۭا","saḥāban","clouds","মেঘমালাকে"],["ثُمَّ","thumma","then","এরপর"],["يُؤَلِّفُ","yu-allifu","joins","পুঞ্জীভূত করেন"],["بَيْنَهُۥ","baynahu","between them","তার মাঝে"],["ثُمَّ","thumma","then","এরপর"],["يَجْعَلُهُۥ","yaj‘aluhu","makes them","তাকে করেন"],["رُكَامًۭا","rukāman","(into) a mass","ঘনীভূত"],["فَتَرَى","fatarā","then you see","অতঃপর তুমি দেখো"],["ٱلْوَدْقَ","l-wadqa","the rain","বৃষ্টি"],["يَخْرُجُ","yakhruju","come forth","বের হয়"],["مِنْ","min","from","হ'তে"],["خِلَـٰلِهِۦ","khilālihi","their midst","তার ভিতর"],["وَيُنَزِّلُ","wayunazzilu","And He sends down","এবং বর্ষণ করেন (শিলাবৃষ্টি)"],["مِنَ","mina","from","হ'তে"],["ٱلسَّمَآءِ","l-samāi","(the) sky","আকাশ"],["مِن","min","[from]","সাহায্যে"],["جِبَالٍۢ","jibālin","mountains","পাহাড়গুলোর"],["فِيهَا","fīhā","within it","তার মধ্যে (থাকে)"],["مِنۢ","min","[of]","তৈরি"],["بَرَدٍۢ","baradin","(is) hail","বরফ (শিলা)"],["فَيُصِيبُ","fayuṣību","and He strikes","অতঃপর তিনি পৌঁছান (ক্ষতি)"],["ب