<q>دْ</> أَ<k>نزَ</>لْ<o>نَآ</> ءَا<m>يَٰ</><d>تٍۢ مُّ</>بَيِّ<m>نَٰ</><d>تٍۢ ۚ وَ</><h>ٱ</>للَّهُ يَهْدِى <d>مَن يَ</><o>شَآ</>ءُ إِلَىٰ صِ<m>رَٰ</><d>طٍۢ مُّ</>سْتَ<p>قِي</>مٍۢ"},{"n":47,"w":[["وَيَقُولُونَ","wayaqūlūna","And they say","এবং তারা বলে"],["ءَامَنَّا","āmannā","We believe","\"আমরা ঈমান এনেছি"],["بِٱللَّهِ","bil-lahi","in Allah","উপর আল্লাহর"],["وَبِٱلرَّسُولِ","wabil-rasūli","and in the Messenger","ও উপর রাসূলের"],["وَأَطَعْنَا","wa-aṭa‘nā","and we obey","এবং আমরা আনুগত্য করেছি\""],["ثُمَّ","thumma","Then","এরপর (কিন্তু)"],["يَتَوَلَّىٰ","yatawallā","turns away","মুখ ফিরিয়ে নেয়"],["فَرِيقٌۭ","farīqun","a party","একদল"],["مِّنْهُم","min'hum","of them","তাদের মধ্য হ'তে"],["مِّنۢ","min","after","থেকে"],["بَعْدِ","ba‘di","after","পর"],["ذَٰلِكَ ۚ","dhālika","that","এর"],["وَمَآ","wamā","And not","আর না"],["أُو۟لَـٰٓئِكَ","ulāika","those","ঐ সব লোক"],["بِٱلْمُؤْمِنِينَ","bil-mu'minīna","(are) believers","মু'মিন"]],"t":"وَيَقُولُونَ ءَامَ<g>نَّ</>ا بِ<h>ٱ</>للَّهِ وَبِ<h>ٱ</><l>ل</>رَّسُولِ وَأَطَعْنَا ثُ<g>مَّ</> يَتَوَلَّىٰ فَرِي<d>قٌۭ مِّ</>نْ<y>هُم مِّ</><i>نۢ بَ</>عْدِ <m>ذَٰ</>لِكَ ۚ وَ<o>مَآ</> أُ<s>و۟</><o>لَٰٓ</>ئِكَ بِ<h>ٱ</>لْمُؤْمِ<p>نِي</>نَ"},{"n":48,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["دُعُوٓا۟","du‘ū","they are called","ডাকা হয় তাদেরকে"],["إِلَى","ilā","to","দিকে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ তা'লার"],["وَرَسُولِهِۦ","warasūlihi","and His Messenger","ও তাঁর রাসূলের"],["لِيَحْكُمَ","liyaḥkuma","to judge","জন্যে মীমাংসার"],["بَيْنَهُمْ","baynahum","between them","তাদের মাঝে"],["إِذَا","idhā","behold","তখন"],["فَرِيقٌۭ","farīqun","a party","একদল"],["مِّنْهُم","min'hum","of them","তাদের মধ্য হ'তে"],["مُّعْرِضُونَ","mu‘'riḍūna","(is) averse","মুখ ফিরিয়ে নেয়"]],"t":"وَإِذَا دُ<o>عُوٓ</><s>ا۟</> إِلَى <h>ٱ</>للَّهِ وَرَسُولِ<m>هِۦ</> لِيَحْكُمَ بَيْنَهُمْ إِذَا فَرِي<d>قٌۭ مِّ</>نْ<y>هُم مُّ</>عْرِ<p>ضُو</>نَ"},{"n":49,"w":[["وَإِن","wa-in","But if","আর যদি"],["يَكُن","yakun","is","হয়"],["لَّهُمُ","lahumu","with them","জন্যে তাদের"],["ٱلْحَقُّ","l-ḥaqu","the truth","সত্য"],["يَأْتُوٓا۟","yatū","they come","তারা আসে"],["إِلَيْهِ","ilayhi","to him","তার দিকে"],["مُذْعِنِينَ","mudh'‘inīna","(as) promptly obedient","বিনীত হয়ে"]],"t":"وَ<d>إِن يَ</><w>كُن لَّ</>هُمُ <h>ٱ</>لْحَقُّ يَأْ<o>تُوٓ</><s>ا۟</> إِلَيْهِ مُذْعِ<p>نِي</>نَ"},{"n":50,"w":[["أَفِى","afī","Is (there) in","কি আছে"],["قُلُوبِهِم","qulūbihim","their hearts","তাদের অন্তরসমূহে"],["مَّرَضٌ","maraḍun","a disease","রোগ"],["أَمِ","ami","or","অথবা"],["ٱرْتَابُوٓا۟","ir'tābū","do they doubt","তারা সন্দেহ করে"],["أَمْ","am","or","অথবা"],["يَخَافُونَ","yakhāfūna","they fear","তারা ভয় করে"],["أَن","an","that","যে"],["يَحِيفَ","yaḥīfa","Allah will be unjust","অন্যায় করবেন"],["ٱللَّهُ","l-lahu","Allah will be unjust","আল্লাহ্‌"],["عَلَيْهِمْ","‘alayhim","to them","তাদের উপর"],["وَرَسُولُهُۥ ۚ","warasūluhu","and His Messenger","ও তাঁর রাসূল"],["بَلْ","bal","Nay","বরং"],["أُو۟لَـٰٓئِكَ","ulāika","those","ঐ সব লোক"],["هُمُ","humu","[they]","তারাই"],["ٱلظَّـٰلِمُونَ","l-ẓālimūna","(are) the wrongdoers","সীমালঙ্ঘনকারী"]],"t":"أَفِى قُلُوبِ<y>هِم مَّ</>رَضٌ أَمِ <h>ٱ</>رْتَا<o>بُوٓ</><s>ا۟</> أَمْ يَخَافُونَ <d>أَن يَ</>حِيفَ <h>ٱ</>للَّهُ عَلَيْهِمْ وَرَسُولُهُ<m>ۥ</> ۚ بَلْ أُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مُو</>نَ"},{"n":51,"w":[["إِنَّمَا","innamā","Only","মূলতঃ"],["كَانَ","kāna","is","ছিলো (শোভা পেত)"],["قَوْلَ","qawla","(the) statement","উক্তি"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","(of) the believers","মু'মিনদের"],["إِذَا","idhā","when","যখন"],["دُعُوٓا۟","du‘ū","they are called","ডাকা হয় তাদেরকে"],["إِلَى","ilā","to","দিকে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌র"],["وَرَسُولِهِۦ","warasūlihi","and His Messenger","ও তাঁর রাসূলের"],["لِيَحْكُمَ","liyaḥkuma","to judge","জন্যে মীমাংসার"],["بَيْنَهُمْ","baynahum","between them","তাদের মাঝে"],["أَن","an","(is) that","যে"],["يَقُولُوا۟","yaqūlū","they say","তারা বলবে"],["سَمِعْنَا","sami‘'nā","We hear","\"আমরা শুনলাম"],["وَأَطَعْنَا ۚ","wa-aṭa‘nā","and we obey","ও আমরা মেনে নিলাম\""],["وَأُو۟لَـٰٓئِكَ","wa-ulāika","And those","আর ঐসব লোক"],["هُمُ","humu","[they]","তারাই"],["ٱلْمُفْلِحُونَ","l-muf'liḥūna","(are) the successful","সফলকাম"]],"t":"إِ<g>نَّ</>مَا كَانَ قَوْلَ <h>ٱ</>لْمُؤْمِنِينَ إِذَا دُ<o>عُوٓ</><s>ا۟</> إِلَى <h>ٱ</>للَّهِ وَرَسُولِ<m>هِۦ</> لِيَحْكُمَ بَيْنَهُمْ <d>أَن يَ</>قُولُو<s>ا۟</> سَمِعْنَا وَأَطَعْنَا ۚ وَأُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</>لْمُفْلِ<p>حُو</>نَ"},{"n":52,"w":[["وَمَن","waman","And whoever","আর যে"],["يُطِعِ","yuṭi‘i","obeys","আনুগত্য করে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌র"],["وَرَسُولَهُۥ","warasūlahu","and His Messenger","ও তাঁর রাসূলের"],["وَيَخْشَ","wayakhsha","and fears","এবং ভয় করে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌কে"],["وَيَتَّقْهِ","wayattaqhi","and (is) conscious of Him","ও (তাঁর শাস্তি হ'তে) সাবধান থাকে"],["فَأُو۟لَـٰٓئِكَ","fa-ulāika","then those","অতঃপর ঐসব লোক"],["هُمُ","humu","[they]","তারাই"],["ٱلْفَآئِزُونَ","l-fāizūna","(are) the successful ones","সফলকাম"]],"t":"وَ<d>مَن يُ</>طِعِ <h>ٱ</>للَّهَ وَرَسُولَهُ<m>ۥ</> وَيَخْشَ <h>ٱ</>للَّهَ وَيَتَّ<q>قْ</>هِ فَأُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</>لْ<o>فَآ</>ئِ<p>زُو</>نَ"},{"n":53,"w":[["۞ وَأَقْسَمُوا۟","wa-aqsamū","And they swear","এবং (মুনাফিকরা) শপথ করে"],["بِٱللَّهِ","bil-lahi","by Allah","নামে আল্লাহ্‌র"],["جَهْدَ","jahda","strong","দৃঢ় ভাবে (করে)"],["أَيْمَـٰنِهِمْ","aymānihim","their oaths","তাদের শপথগুলোকে"],["لَئِنْ","la-in","that if","অবশ্যই যদি"],["أَمَرْتَهُمْ","amartahum","you ordered them","তাদেরকে তুমি নির্দেশ দাও"],["لَيَخْرُجُنَّ ۖ","layakhrujunna","surely they (would) go forth","অবশ্যই তারা (জিহাদের জন্যে) বের হবে"],["قُل","qul","Say","বলো"],["لَّا","lā","(Do) not","\"না"],["تُقْسِمُوا۟ ۖ","tuq'simū","swear","তোমরা শপথ করো"],["طَاعَةٌۭ","ṭā‘atun","Obedience","আনুগত্য"],["مَّعْرُوفَةٌ ۚ","ma‘rūfatun","(is) known","যথার্থই (কাম্য)"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["خَبِيرٌۢ","khabīrun","(is) All-Aware","খুব অবহিত"],["بِمَا","bimā","of what","ঐ সম্পর্কে যা"],["تَعْمَلُونَ","ta‘malūna","you do","কাজ করছো তোমরা\""]],"t":"۞ وَأَ<q>قْ</>سَمُو<s>ا۟</> بِ<h>ٱ</>للَّهِ جَهْدَ أَيْ<m>مَٰ</>نِهِمْ لَئِنْ أَمَرْتَهُمْ لَيَخْرُجُ<g>نَّ</> ۖ قُل لَّا تُ<q>قْ</>سِمُو<s>ا۟ ۖ</> طَاعَ<d>ةٌۭ مَّ</>عْرُوفَةٌ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ خَبِي<i>رٌۢ بِ</>مَا تَعْمَ<p>لُو</>نَ"},{"n":54,"w":[["قُلْ","qul","Say","বলো"],["أَطِيعُوا۟","aṭī‘ū","Obey","\"তোমরা আনুগত্য করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহর"],["وَأَطِيعُوا۟","wa-aṭī‘ū","and obey","ও তোমরা আনুগত্য করো"],["ٱلرَّسُولَ ۖ","l-rasūla","the Messenger","রাসূলের"],["فَإِن","fa-in","but if","কিন্তু যদি"],["تَوَلَّوْا۟","tawallaw","you turn away","তোমরা মুখ ফিরাও"],["فَإِنَّمَا","fa-innamā","then only","তবে (জেনে রাখো) প্রকৃতপক্ষে"],["عَلَيْهِ","‘alayhi","upon him","তার উপর"],["مَا","mā","(is) what","যা"],["حُمِّلَ","ḥummila","(is) placed on him","তাকে (দায়িত্ব) ভার দেয়া হয়েছে"],["وَعَلَيْكُم","wa‘alaykum","and on you","আর তোমাদের উপর (দায়িত্ব)"],["مَّا","mā","(is) what","যা"],["حُمِّلْتُمْ ۖ","ḥummil'tum","(is) placed on you","তোমাদের (দায়িত্ব) ভার দেয়া হয়েছে"],["وَإِن","wa-in","And if","আর যদি"],["تُطِيعُوهُ","tuṭī‘ūhu","you obey him","তার আনুগত্য করো"],["تَهْتَدُوا۟ ۚ","tahtadū","you will be guided","তোমরা সঠিক পথ পাবে"],["وَمَا","wamā","And not","আর না"],["عَلَى","‘alā","(is) on","(দায়িত্ব) উপর"],["ٱلرَّسُولِ","l-rasūli","the Messenger","রাসূলের"],["إِلَّا","illā","except","এ ছাড়া যে"],["ٱلْبَلَـٰغُ","l-balāghu","the conveyance","পৌঁছান (বিধান)"],["ٱلْمُبِينُ","l-mubīnu","[the] clear","সুস্পষ্টভাবে\""]],"t":"قُلْ أَطِيعُو<s>ا۟</> <h>ٱ</>للَّهَ وَأَطِيعُو<s>ا۟</> <h>ٱ</><l>ل</>رَّسُولَ ۖ فَإِ<k>ن تَ</>وَلَّوْ<s>ا۟</> فَإِ<g>نَّ</>مَا عَلَيْهِ مَا حُ<g>مِّ</>لَ وَعَلَيْ<y>كُم مَّ</>ا حُ<g>مِّ</>لْتُمْ ۖ وَإِ<k>ن تُ</>طِيعُوهُ تَهْتَدُو<s>ا۟ ۚ</> وَمَا عَلَى <h>ٱ</><l>ل</>رَّسُولِ إِلَّا <h>ٱ</>لْبَ<m>لَٰ</>غُ <h>ٱ</>لْمُ<p>بِي</>نُ"},{"n":55,"w":[["وَعَدَ","wa‘ada","Allah (has) promised","প্রতিশ্রুতি দিয়েছেন"],["ٱللَّهُ","l-lahu","Allah (has) promised","আল্লাহ"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["مِنكُمْ","minkum","among you","তোমাদের মধ্য হ'তে"],["وَعَمِلُوا۟","wa‘amilū","and do","ও কাজ করেছে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","righteous deeds","সৎ"],["لَيَسْتَخْلِفَنَّهُمْ","layastakhlifannahum","surely He will grant them succession","অবশ্যই তিনি প্রতিনিধি  বানাবেন তাদেরকে"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["كَمَا","kamā","as","যেমন"],["ٱسْتَخْلَفَ","is'takhlafa","He gave succession","প্রতিনিধি বানিয়েছিলেন"],["ٱلَّذِينَ","alladhīna","to those who","(তাদেরকে) যারা"],["مِن","min","(were) before them","থেকে"],["قَبْلِهِمْ","qablihim","(were) before them","তাদের পূর্ব (ছিলো)"],["وَلَيُمَكِّنَنَّ","walayumakkinanna","and that He will surely establish","এবং অবশ্যই সুদৃঢ় করবেন"],["لَهُمْ","lahum","for them","জন্যে তাদের"],["دِينَهُمُ","dīnahumu","their religion","তাদের দ্বীনকে"],["ٱلَّذِى","alladhī","which","যা"],["ٱرْتَضَىٰ","ir'taḍā","He has approved","তিনি পছন্দ করেছেন"],["لَهُمْ","lahum","for them","জন্যে তাদের"],["وَلَيُبَدِّلَنَّهُم","walayubaddilannahum","and surely He will change for them","ও অবশ্যই পরিবর্তিত করে দিবেন তাদের জন্যে"],["مِّنۢ","min","after","থেকে"],["بَعْدِ","ba‘di","after","পর"],["خَوْفِهِمْ","khawfihim","their fear","তাদের ভয়-ভীতির"],["أَمْنًۭا ۚ","amnan","security","নিরাপত্তায়"],["يَعْبُدُونَنِى","ya‘budūnanī","(for) they worship Me","আমারই তারা ইবাদাত করবে"],["لَا","lā","not","(আর) না"],["يُشْرِكُونَ","yush'rikūna","they associate","তারা শরীক করবে"],["بِى","bī","with Me","সাথে আমার"],["شَيْـًۭٔا ۚ","shayan","anything","কোন কিছুরই"],["وَمَن","waman","But whoever","আর যে"],["كَفَرَ","kafara","disbelieved","অস্বীকার করবে"],["بَعْدَ","ba‘da","after","পরে"],["ذَٰلِكَ","dhālika","that","এর"],["فَأُو۟لَـٰٓئِكَ","fa-ulāika","then those","অতঃপর ঐসবলোক"],["هُمُ","humu","[they]","তারাই"],["ٱلْفَـٰسِقُونَ","l-fāsiqūna","(are) the defiantly disobedient","সত্যত্যাগী"]],"t":"وَعَدَ <h>ٱ</>للَّهُ <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> مِ<k>نكُ</>مْ وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ لَيَسْتَخْلِفَ<g>نَّ</>هُمْ فِى <h>ٱ</>لْأَرْضِ كَمَا <h>ٱ</>سْتَخْلَفَ <h>ٱ</>لَّذِينَ مِ<k>ن قَ</><q>بْ</>لِهِمْ وَلَيُمَكِّنَ<g>نَّ</> لَهُمْ دِينَهُمُ <h>ٱ</>لَّذِى <h>ٱ</>رْتَضَىٰ لَهُمْ وَلَيُبَدِّلَ<g>نَّ</><y>هُم مِّ</><i>نۢ بَ</>عْدِ خَوْفِهِمْ أَمْ<d>نًۭا ۚ يَ</>عْبُدُونَنِى لَا يُشْرِكُونَ بِى شَ<d>يْـًۭٔا ۚ وَ</>مَ<k>ن كَ</>فَرَ بَعْدَ <m>ذَٰ</>لِكَ فَأُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</>لْ<m>فَٰ</>سِ<p>قُو</>نَ"},{"n":56,"w":[["وَأَقِيمُوا۟","wa-aqīmū","And establish","এবং তোমরা প্রতিষ্ঠা করো"],["ٱلصَّلَوٰةَ","l-ṣalata","the prayer","সালাত"],["وَءَاتُوا۟","waātū","and give","আর দাও"],["ٱلزَّكَوٰةَ","l-zakata","zakah","যাকাত"],["وَأَطِيعُوا۟","wa-aṭī‘ū","and obey","ও আনুগত্য করো"],["ٱلرَّسُولَ","l-rasūla","the Messenger","রাসূলের"],["لَعَلَّكُمْ","la‘allakum","so that you may","যাতে তোমরা"],["تُرْحَمُونَ","tur'ḥamūna","receive mercy","তোমরা অনুগ্রহভাজন হবে"]],"t":"وَأَقِيمُو<s>ا۟</> <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةَ وَءَاتُو<s>ا۟</> <h>ٱ</><l>ل</>زَّكَ<s>وٰ</>ةَ وَأَطِيعُو<s>ا۟</> <h>ٱ</><l>ل</>رَّسُولَ لَعَلَّكُمْ تُرْحَ<p>مُو</>نَ"},{"n":57,"w":[["لَا","lā","(Do) not","না"],["تَحْسَبَنَّ","taḥsabanna","think","কখনও মনে করো"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieve","অস্বীকার করেছে"],["مُعْجِزِينَ","mu‘'jizīna","(can) escape","তারা অক্ষমকারী (আল্লাহ্‌কে)"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ ۚ","l-arḍi","the earth","পৃথিবীর"],["وَمَأْوَىٰهُمُ","wamawāhumu","And their abode","এবং তাদের আশ্রয়স্থল"],["ٱلنَّارُ ۖ","l-nāru","(will be) the Fire","জাহান্নাম"],["وَلَبِئْسَ","walabi'sa","and wretched is","আর অবশ্যই (তা) অতি নিকৃষ্ট"],["ٱلْمَصِيرُ","l-maṣīru","the destination","প্রত্যাবর্তনস্থল"]],"t":"لَا تَحْسَبَ<g>نَّ</> <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> مُعْجِزِينَ فِى <h>ٱ</>لْأَرْضِ ۚ وَمَأْوَ<m>ىٰ</>هُمُ <h>ٱ</><l>ل</><g>نَّ</>ارُ ۖ وَلَبِئْسَ <h>ٱ</>لْمَ<p>صِي</>رُ"},{"n":58,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you who believe","হে"],["ٱلَّذِينَ","alladhīna","O you who believe","যারা"],["ءَامَنُوا۟","āmanū","O you who believe","ঈমান এনেছো"],["لِيَسْتَـْٔذِنكُمُ","liyastadhinkumu","Let ask your permission","যেন তোমাদের (হ'তে) অনুমতি নেয়"],["ٱلَّذِينَ","alladhīna","those whom","(তারা) যাদেরকে"],["مَلَكَتْ","malakat","possess","মালিক করেছে"],["أَيْمَـٰنُكُمْ","aymānukum","your right hands","তোমাদের ডান হাত (অর্থাৎ দাস দাসী)"],["وَٱلَّذِينَ","wa-alladhīna","and those who","ও যারা"],["لَمْ","lam","(have) not","নি"],["يَبْلُغُوا۟","yablughū","reached","তারা পৌঁছে"],["ٱلْحُلُمَ","l-ḥuluma","puberty","প্রাপ্ত বয়সে (অর্থাৎ অবুঝ বালক বালিকা)"],["مِنكُمْ","minkum","among you","তোমাদের মধ্য থেকে"],["ثَلَـٰثَ","thalātha","(at) three","তিন"],["مَرَّٰتٍۢ ۚ","marrātin","times","সময়ে (বার)"],["مِّن","min","before","থেকে"],["قَبْلِ","qabli","before","পূর্ব"],["صَلَوٰةِ","ṣalati","(the) prayer","সালাতের"],["ٱلْفَجْرِ","l-fajri","(of) dawn","ফজরের"],["وَحِينَ","waḥīna","and when","ও যখন"],["تَضَعُونَ","taḍa‘ūna","you put aside","তোমরা (খুলে) রাখো"],["ثِيَابَكُم","thiyābakum","your garments","তোমাদের কাপড়"],["مِّنَ","mina","at","থেকে"],["ٱلظَّهِيرَةِ","l-ẓahīrati","noon","দ্বিপ্রহর"],["وَمِنۢ","wamin","and after","ও থেকে"],["بَعْدِ","ba‘di","and after","পর"],["صَلَوٰةِ","ṣalati","(the) prayer","সালাতের"],["ٱلْعِشَآءِ ۚ","l-‘ishāi","(of) night","এশার"],["ثَلَـٰثُ","thalāthu","(These) three","তিন (সময়)"],["عَوْرَٰتٍۢ","‘awrātin","(are) times of privacy","গোপনীয়তার"],["لَّكُمْ ۚ","lakum","for you","জন্যে তোমাদের"],["لَيْسَ","laysa","Not","নেই"],["عَلَيْكُمْ","‘alaykum","on you","তোমাদের জন্যে"],["وَلَا","walā","and not","আর না"],["عَلَيْهِمْ","‘alayhim","on them","তাদের জন্যে"],["جُنَاحٌۢ","junāḥun","any blame","কোন পাপ"],["بَعْدَهُنَّ ۚ","ba‘dahunna","after that","ছাড়া এসব (সময়)"],["طَوَّٰفُونَ","ṭawwāfūna","(as) moving about","বার বার যাতায়াত করতে"],["عَلَيْكُم","‘alaykum","among you","তোমাদের নিকট"],["بَعْضُكُمْ","ba‘ḍukum","some of you","তোমাদের একে"],["عَلَىٰ","‘alā","among","নিকট"],["بَعْضٍۢ ۚ","ba‘ḍin","others","অপরের (যাতায়াত তো করতেই হয়)"],["كَذَٰلِكَ","kadhālika","Thus","এভাবে"],["يُبَيِّنُ","yubayyinu","Allah makes clear","সুস্পষ্ট বর্ণনা করেন"],["ٱللَّهُ","l-lahu","Allah makes clear","আল্লাহ্‌"],["لَكُمُ","lakumu","for you","জন্যে তোমাদের"],["ٱلْـَٔايَـٰتِ ۗ","l-āyāti","the Verses","আয়াতসমূহ"],["وَٱللَّهُ","wal-lahu","and Allah","আর আল্লাহ"],["عَلِيمٌ","‘alīmun","(is) All-Knower","সর্বজ্ঞ"],["حَكِيمٌۭ","ḥakīmun","All-Wise","প্রজ্ঞাময়"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> لِيَسْتَـْٔذِ<k>نكُ</>مُ <h>ٱ</>لَّذِينَ مَلَكَتْ أَيْ<m>مَٰ</>نُكُمْ وَ<h>ٱ</>لَّذِينَ لَمْ يَ<q>بْ</>لُغُو<s>ا۟</> <h>ٱ</>لْحُلُمَ مِ<k>نكُ</>مْ ثَ<m>لَٰ</>ثَ مَ<m>رَّٰ</><d>تٍۢ ۚ مِّ</><k>ن قَ</><q>بْ</>لِ صَلَ<s>وٰ</>ةِ <h>ٱ</>لْفَ<q>جْ</>رِ وَحِينَ تَضَعُونَ ثِيَابَ<y>كُم مِّ</>نَ <h>ٱ</><l>ل</>ظَّهِيرَةِ وَ<i>مِنۢ بَ</>عْدِ صَلَ<s>وٰ</>ةِ <h>ٱ</>لْعِ<o>شَآ</>ءِ ۚ ثَ<m>لَٰ</>ثُ عَوْ<m>رَٰ</><w>تٍۢ لَّ</>كُمْ ۚ لَيْسَ عَلَيْكُمْ وَلَا عَلَيْهِمْ جُنَا<i>حٌۢ بَ</>عْدَهُ<g>نَّ</> ۚ طَ<m>وَّٰ</>فُونَ عَلَيْ<f>كُم بَ</>عْضُكُمْ عَلَىٰ بَعْ<k>ضٍۢ ۚ كَ</><m>ذَٰ</>لِكَ يُبَيِّنُ <h>ٱ</>للَّهُ لَكُمُ <h>ٱ</>لْءَا<m>يَٰ</>تِ ۗ وَ<h>ٱ</>للَّهُ عَلِيمٌ حَ<p>كِي</>مٌۭ"},{"n":59,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["بَلَغَ","balagha","reach","পৌঁছে"],["ٱلْأَطْفَـٰلُ","l-aṭfālu","the children","ছেলেমেয়েরা"],["مِنكُمُ","minkumu","among you","তোমাদের মধ্য থেকে"],["ٱلْحُلُمَ","l-ḥuluma","the puberty","প্রাপ্ত বয়সে"],["فَلْيَسْتَـْٔذِنُوا۟","falyastadhinū","then let them ask permission","তখন যেন তারা অনুমতি নেয়"],["كَمَا","kamā","as","যেমন"],["ٱسْتَـْٔذَنَ","is'tadhana","asked permission","অনুমতি নেয়"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["مِن","min","(were) before them","থেকে"],["قَبْلِهِمْ ۚ","qablihim","(were) before them","পূর্ব তাদের (বয়োপ্রাপ্ত হয়েছে)"],["كَذَٰلِكَ","kadhālika","Thus","এভাবে"],["يُبَيِّنُ","yubayyinu","Allah makes clear","বর্ণনা করেন"],["ٱللَّهُ","l-lahu","Allah makes clear","আল্লাহ"],["لَكُمْ","lakum","for you","জন্যে তোমাদের"],["ءَايَـٰتِهِۦ ۗ","āyātihi","His Verses","তা