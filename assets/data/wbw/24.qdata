{"n":24,"a":[{"n":1,"w":[["سُورَةٌ","sūratun","A Surah ","(এটা) একটি সূরা"],["أَنزَلْنَـٰهَا","anzalnāhā","We (have) sent it down","তা আমরা অবতীর্ণ করেছি"],["وَفَرَضْنَـٰهَا","wafaraḍnāhā","and We (have) made it obligatory","ও এর (বিধানকে) আমরা ফরজ করেছি"],["وَأَنزَلْنَا","wa-anzalnā","and We (have) revealed","এবং আমরা অবতীর্ণ করেছি"],["فِيهَآ","fīhā","therein","তার মধ্যে"],["ءَايَـٰتٍۭ","āyātin","Verses","আয়াতসমূহ"],["بَيِّنَـٰتٍۢ","bayyinātin","clear","সুস্পষ্ট"],["لَّعَلَّكُمْ","la‘allakum","so that you may","সম্ভবতঃ তোমরা"],["تَذَكَّرُونَ","tadhakkarūna","take heed","উপদেশ গ্রহণ করবে"]],"t":"سُورَةٌ أَ<k>نزَ</>لْ<m>نَٰ</>هَا وَفَرَضْ<m>نَٰ</>هَا وَأَ<k>نزَ</>لْنَا فِي<o>هَآ</> ءَا<m>يَٰ</><i>تٍۭ بَ</>يِّ<m>نَٰ</><w>تٍۢ لَّ</>عَلَّكُمْ تَذَكَّ<p>رُو</>نَ"},{"n":2,"w":[["ٱلزَّانِيَةُ","al-zāniyatu","The fornicatress","ব্যভিচারিণী"],["وَٱلزَّانِى","wal-zānī","and the fornicator","ও ব্যভিচারী"],["فَٱجْلِدُوا۟","fa-ij'lidū","[then] flog","অতঃপর তোমরা দোররা মারবে"],["كُلَّ","kulla","each","প্রত্যেক"],["وَٰحِدٍۢ","wāḥidin","one","একজনকে"],["مِّنْهُمَا","min'humā","of them","তাদের দুজনার মধ্য হ'তে"],["مِا۟ئَةَ","mi-ata","(with) hundred","একশত"],["جَلْدَةٍۢ ۖ","jaldatin","lash(es)","দোররা"],["وَلَا","walā","And (let) not","আর না (যেন)"],["تَأْخُذْكُم","takhudh'kum","withhold you","তোমাদেরকে প্রভাবিত করে"],["بِهِمَا","bihimā","pity for them","প্রতি তাদের দু'জনের"],["رَأْفَةٌۭ","rafatun","pity for them","দয়া অনুকম্পা"],["فِى","fī","concerning","ব্যাপারে"],["دِينِ","dīni","(the) religion of Allah","দ্বীনের"],["ٱللَّهِ","l-lahi","(the) religion of Allah","আল্লাহর"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you","তোমরা থাকো"],["تُؤْمِنُونَ","tu'minūna","believe","তোমরা ঈমান আনো"],["بِٱللَّهِ","bil-lahi","in Allah","প্রতি আল্লাহর"],["وَٱلْيَوْمِ","wal-yawmi","and the Day","ও দিনের"],["ٱلْـَٔاخِرِ ۖ","l-ākhiri","the Last","শেষ (প্রতি)"],["وَلْيَشْهَدْ","walyashhad","And let witness","আর যেন প্রত্যক্ষ করে"],["عَذَابَهُمَا","‘adhābahumā","their punishment","দু'জনের শাস্তি তাদের"],["طَآئِفَةٌۭ","ṭāifatun","a group","একদল"],["مِّنَ","mina","of","মধ্য হ'তে"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believers","মু'মিনদের"]],"t":"ٱ<l>ل</>زَّانِيَةُ وَ<h>ٱ</><l>ل</>زَّانِى فَ<h>ٱ</><q>جْ</>لِدُو<s>ا۟</> كُلَّ <m>وَٰ</>حِ<d>دٍۢ مِّ</>نْهُمَا مِ<s>ا۟</>ئَةَ جَلْدَ<d>ةٍۢ ۖ وَ</>لَا تَأْخُذْ<f>كُم بِ</>هِمَا رَأْفَ<k>ةٌۭ فِ</>ى دِينِ <h>ٱ</>للَّهِ إِ<k>ن كُنتُ</>مْ تُؤْمِنُونَ بِ<h>ٱ</>للَّهِ وَ<h>ٱ</>لْيَوْمِ <h>ٱ</>لْءَاخِرِ ۖ وَلْيَشْهَ<q>دْ</> عَذَابَهُمَا <o>طَآ</>ئِفَ<d>ةٌۭ مِّ</>نَ <h>ٱ</>لْمُؤْمِ<p>نِي</>نَ"},{"n":3,"w":[["ٱلزَّانِى","al-zānī","The fornicator","ব্যভিচারী"],["لَا","lā","(will) not","না"],["يَنكِحُ","yankiḥu","marry","বিয়ে করবে (অন্য কাউকে)"],["إِلَّا","illā","except","ছাড়া"],["زَانِيَةً","zāniyatan","a fornicatress","ব্যভিচারিণীকে"],["أَوْ","aw","or","অথবা"],["مُشْرِكَةًۭ","mush'rikatan","a polytheist woman","মুশরিক নারীকে"],["وَٱلزَّانِيَةُ","wal-zāniyatu","and the fornicatress ","আর ব্যভিচারিণী"],["لَا","lā","(will) not","না"],["يَنكِحُهَآ","yankiḥuhā","marry her","তাকে বিয়ে করবে (অন্য কেউ)"],["إِلَّا","illā","except","ছাড়া"],["زَانٍ","zānin","a fornicator","ব্যভিচারী"],["أَوْ","aw","or","অথবা"],["مُشْرِكٌۭ ۚ","mush'rikun","a polytheist man","মুশরিক"],["وَحُرِّمَ","waḥurrima","And is forbidden","এবং নিষিদ্ধ করা হলো"],["ذَٰلِكَ","dhālika","that","এটা"],["عَلَى","‘alā","to","জন্যে"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believers","মু'মিনদের"]],"t":"ٱ<l>ل</>زَّانِى لَا يَ<k>نكِ</>حُ إِلَّا زَانِيَةً أَوْ مُشْرِكَ<d>ةًۭ وَ</><h>ٱ</><l>ل</>زَّانِيَةُ لَا يَ<k>نكِ</>حُ<o>هَآ</> إِلَّا زَانٍ أَوْ مُشْرِ<d>كٌۭ ۚ وَ</>حُرِّمَ <m>ذَٰ</>لِكَ عَلَى <h>ٱ</>لْمُؤْمِ<p>نِي</>نَ"},{"n":4,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["يَرْمُونَ","yarmūna","accuse","অপবাদ দেয়"],["ٱلْمُحْصَنَـٰتِ","l-muḥ'ṣanāti","the chaste women","পবিত্র রমণীদেরকে"],["ثُمَّ","thumma","then","এরপর"],["لَمْ","lam","not","না"],["يَأْتُوا۟","yatū","they bring","তারা আসে"],["بِأَرْبَعَةِ","bi-arba‘ati","four","নিয়ে চারজন"],["شُهَدَآءَ","shuhadāa","witnesses","সাক্ষী"],["فَٱجْلِدُوهُمْ","fa-ij'lidūhum","then flog them","তখন দোররা লাগাও তাদেরকে"],["ثَمَـٰنِينَ","thamānīna","(with) eighty","আশি"],["جَلْدَةًۭ","jaldatan","lashe(s)","দোররা"],["وَلَا","walā","and (do) not","আর না"],["تَقْبَلُوا۟","taqbalū","accept","তোমরা গ্রহণ করবে"],["لَهُمْ","lahum","their","জন্যে তাদের (হ'তে)"],["شَهَـٰدَةً","shahādatan","testimony","সাক্ষ্য"],["أَبَدًۭا ۚ","abadan","ever","কখনও"],["وَأُو۟لَـٰٓئِكَ","wa-ulāika","And those","এবং ঐসবলোক"],["هُمُ","humu","they","তারাই"],["ٱلْفَـٰسِقُونَ","l-fāsiqūna","(are) the defiantly disobedient","সত্যত্যাগী (ফাসেক)"]],"t":"وَ<h>ٱ</>لَّذِينَ يَرْمُونَ <h>ٱ</>لْمُحْصَ<m>نَٰ</>تِ ثُ<g>مَّ</> لَمْ يَأْتُو<s>ا۟</> بِأَرْبَعَةِ شُهَ<o>دَآ</>ءَ فَ<h>ٱ</><q>جْ</>لِدُوهُمْ ثَ<m>مَٰ</>نِينَ جَلْدَ<d>ةًۭ وَ</>لَا تَ<q>قْ</>بَلُو<s>ا۟</> لَهُمْ شَ<m>هَٰ</>دَةً أَبَ<d>دًۭا ۚ وَ</>أُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</>لْ<m>فَٰ</>سِ<p>قُو</>نَ"},{"n":5,"w":[["إِلَّا","illā","Except","ছাড়া"],["ٱلَّذِينَ","alladhīna","those who","(তারা) যারা"],["تَابُوا۟","tābū","repent","তওবা করেছে"],["مِنۢ","min","after","থেকে"],["بَعْدِ","ba‘di","after","পর"],["ذَٰلِكَ","dhālika","that","এর"],["وَأَصْلَحُوا۟","wa-aṣlaḥū","and reform","ও সংশোধন করেছে"],["فَإِنَّ","fa-inna","Then indeed","তাহ'লে নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["غَفُورٌۭ","ghafūrun","(is) Oft-Forgiving","ক্ষমাশীল"],["رَّحِيمٌۭ","raḥīmun","Most Merciful","পরম দয়ালু"]],"t":"إِلَّا <h>ٱ</>لَّذِينَ تَابُو<s>ا۟</> <i>مِنۢ بَ</>عْدِ <m>ذَٰ</>لِكَ وَأَصْلَحُو<s>ا۟</> فَإِ<g>نَّ</> <h>ٱ</>للَّهَ غَفُو<w>رٌۭ رَّ</><p>حِي</>مٌۭ"},{"n":6,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","আর যারা"],["يَرْمُونَ","yarmūna","accuse","অপবাদ দেয়"],["أَزْوَٰجَهُمْ","azwājahum","their spouses","তাদের স্ত্রীদেরকে"],["وَلَمْ","walam","and not","আর না"],["يَكُن","yakun","have","থাকে"],["لَّهُمْ","lahum","for them","তাদের কাছে"],["شُهَدَآءُ","shuhadāu","witnesses","কোন সাক্ষী"],["إِلَّآ","illā","except","ছাড়া"],["أَنفُسُهُمْ","anfusuhum","themselves","তাদের নিজেদের"],["فَشَهَـٰدَةُ","fashahādatu","then (the) testimony","তখন সাক্ষ্য"],["أَحَدِهِمْ","aḥadihim","(of) one of them","তাদের একজনের"],["أَرْبَعُ","arba‘u","(is) four","চারবার"],["شَهَـٰدَٰتٍۭ","shahādātin","testimonies","(কসম খেয়ে) সাক্ষ্য দিবে"],["بِٱللَّهِ ۙ","bil-lahi","by Allah","যে আল্লাহর (নামে)"],["إِنَّهُۥ","innahu","that he","নিশ্চয়ই সে"],["لَمِنَ","lamina","(is) surely of","অবশ্যই অন্তর্ভুক্ত"],["ٱلصَّـٰدِقِينَ","l-ṣādiqīna","the truthful","সত্যবাদীদের"]],"t":"وَ<h>ٱ</>لَّذِينَ يَرْمُونَ أَزْ<m>وَٰ</>جَهُمْ وَلَمْ يَ<w>كُن لَّ</>هُمْ شُهَ<o>دَآ</>ءُ إِ<o>لَّآ</> أَ<k>نفُ</>سُهُمْ فَشَ<m>هَٰ</>دَةُ أَحَدِهِمْ أَرْبَعُ شَ<m>هَٰدَٰ</><i>تٍۭ بِ</><h>ٱ</>للَّهِ ۙ إِ<g>نَّ</>هُ<m>ۥ</> لَمِنَ <h>ٱ</><l>ل</><m>صَّٰ</>دِ<p>قِي</>نَ"},{"n":7,"w":[["وَٱلْخَـٰمِسَةُ","wal-khāmisatu","And the fifth","আর পঞ্চমবার (বলবে)"],["أَنَّ","anna","that","যে"],["لَعْنَتَ","la‘nata","(the) curse of Allah","অভিশাপ"],["ٱللَّهِ","l-lahi","(the) curse of Allah","আল্লাহর"],["عَلَيْهِ","‘alayhi","(be) upon him","তার উপর (পড়ুক)"],["إِن","in","if","যদি"],["كَانَ","kāna","he is","সে হয়"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْكَـٰذِبِينَ","l-kādhibīna","the liars","মিথ্যাবাদীদের"]],"t":"وَ<h>ٱ</>لْ<m>خَٰ</>مِسَةُ أَ<g>نَّ</> لَعْنَتَ <h>ٱ</>للَّهِ عَلَيْهِ إِ<k>ن كَ</>انَ مِنَ <h>ٱ</>لْ<m>كَٰ</>ذِ<p>بِي</>نَ"},{"n":8,"w":[["وَيَدْرَؤُا۟","wayadra-u","But it would prevent","আর রহিত হবে"],["عَنْهَا","‘anhā","from her","তার (অর্থাৎ স্ত্রীলোকটি) হ'তে"],["ٱلْعَذَابَ","l-‘adhāba","the punishment","শাস্তি"],["أَن","an","that","(এভাবে) যে"],["تَشْهَدَ","tashhada","she bears witness","সে শপথ করে সাক্ষ্য দিবে"],["أَرْبَعَ","arba‘a","four","চারবার"],["شَهَـٰدَٰتٍۭ","shahādātin","testimonies","সাক্ষ্য"],["بِٱللَّهِ ۙ","bil-lahi","by Allah","নামে আল্লাহর"],["إِنَّهُۥ","innahu","that he","সে (অর্থাৎ পুরুষটি) নিশ্চয়ই"],["لَمِنَ","lamina","(is) surely of","অবশ্যই অন্তর্ভুক্ত"],["ٱلْكَـٰذِبِينَ","l-kādhibīna","the liars","মিথ্যাবাদীদের"]],"t":"وَيَ<q>دْ</>رَؤُ<s>ا۟</> عَنْهَا <h>ٱ</>لْعَذَابَ أَ<k>ن تَ</>شْهَدَ أَرْبَعَ شَ<m>هَٰدَٰ</><i>تٍۭ بِ</><h>ٱ</>للَّهِ ۙ إِ<g>نَّ</>هُ<m>ۥ</> لَمِنَ <h>ٱ</>لْ<m>كَٰ</>ذِ<p>بِي</>نَ"},{"n":9,"w":[["وَٱلْخَـٰمِسَةَ","wal-khāmisata","And the fifth","এবং পঞ্চমবার (বলবে)"],["أَنَّ","anna","that","যে"],["غَضَبَ","ghaḍaba","the wrath of Allah","রাগ (পড়ুক)"],["ٱللَّهِ","l-lahi","the wrath of Allah","আল্লাহর"],["عَلَيْهَآ","‘alayhā","(be) upon her","তার (অর্থাৎ স্ত্রীলোকটির) উপর"],["إِن","in","if","যদি"],["كَانَ","kāna","he is","(পুরুষটি) হয়"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلصَّـٰدِقِينَ","l-ṣādiqīna","the truthful","সত্যবাদীদের"]],"t":"وَ<h>ٱ</>لْ<m>خَٰ</>مِسَةَ أَ<g>نَّ</> غَضَبَ <h>ٱ</>للَّهِ عَلَيْ<o>هَآ</> إِ<k>ن كَ</>انَ مِنَ <h>ٱ</><l>ل</><m>صَّٰ</>دِ<p>قِي</>نَ"},{"n":10,"w":[["وَلَوْلَا","walawlā","And if not","আর যদি না (হতো)"],["فَضْلُ","faḍlu","(for) the Grace of Allah","অনুগ্রহ"],["ٱللَّهِ","l-lahi","(for) the Grace of Allah","আল্লাহর"],["عَلَيْكُمْ","‘alaykum","upon you","তোমাদের উপর"],["وَرَحْمَتُهُۥ","waraḥmatuhu","and His Mercy ","ও তাঁর দয়া (তবে তোমরা জটিলতায় পড়তে)"],["وَأَنَّ","wa-anna","and that","আর নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["تَوَّابٌ","tawwābun","(is) Oft-Returning (to Mercy)","তওবা গ্রহণকারী"],["حَكِيمٌ","ḥakīmun","All-Wise","প্রজ্ঞাময়"]],"t":"وَلَوْلَا فَضْلُ <h>ٱ</>للَّهِ عَلَيْكُمْ وَرَحْمَتُهُ<m>ۥ</> وَأَ<g>نَّ</> <h>ٱ</>للَّهَ تَوَّابٌ حَ<p>كِي</>مٌ"},{"n":11,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["جَآءُو","jāū","brought","তারা এসেছে"],["بِٱلْإِفْكِ","bil-if'ki","the lie","নিয়ে অপবাদ রচনা"],["عُصْبَةٌۭ","‘uṣ'batun","(are) a group","(তারা) একটি দল"],["مِّنكُمْ ۚ","minkum","among you","তোমাদের মধ্যকার"],["لَا","lā","(Do) not","না"],["تَحْسَبُوهُ","taḥsabūhu","think it","তা তোমরা মনে করো"],["شَرًّۭا","sharran","bad","খারাপ"],["لَّكُم ۖ","lakum","for you","জন্যে তোমাদের"],["بَلْ","bal","nay","বরং"],["هُوَ","huwa","it","তা"],["خَيْرٌۭ","khayrun","(is) good","ভালো"],["لَّكُمْ ۚ","lakum","for you","জন্যে তোমাদের"],["لِكُلِّ","likulli","For every","জন্যে প্রত্যেক"],["ٱمْرِئٍۢ","im'ri-in","person","ব্যক্তির (রয়েছে)"],["مِّنْهُم","min'hum","among them","তাদের মধ্য হ'তে"],["مَّا","mā","(is) what","যতটা"],["ٱكْتَسَبَ","ik'tasaba","he earned","সে অর্জন করেছে"],["مِنَ","mina","of","হ'তে"],["ٱلْإِثْمِ ۚ","l-ith'mi","the sin","পাপ"],["وَٱلَّذِى","wa-alladhī","and the one who","আর যে"],["تَوَلَّىٰ","tawallā","took upon himself a greater share of it","দায়িত্ব নিয়েছে (নিজের উপর)"],["كِبْرَهُۥ","kib'rahu","took upon himself a greater share of it","তার বড় (অংশ)"],["مِنْهُمْ","min'hum","among them ","মধ্য হ'তে তাদের"],["لَهُۥ","lahu","for him","জন্যে তার (রয়েছে)"],["عَذَابٌ","‘adhābun","(is) a punishment","শাস্তি"],["عَظِيمٌۭ","‘aẓīmun","great","কঠিন"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ <o>جَآ</>ءُو بِ<h>ٱ</>لْإِفْكِ عُصْبَ<d>ةٌۭ مِّ</><k>نكُ</>مْ ۚ لَا تَحْسَبُوهُ شَ<w>رًّۭا لَّ</><f>كُم ۖ بَ</>لْ هُوَ خَيْ<w>رٌۭ لَّ</>كُمْ ۚ لِكُلِّ <h>ٱ</>مْرِ<d>ئٍۢ مِّ</>نْ<y>هُم مَّ</>ا <h>ٱ</>كْتَسَبَ مِنَ <h>ٱ</>لْإِثْمِ ۚ وَ<h>ٱ</>لَّذِى تَوَلَّىٰ كِ<q>بْ</>رَهُ<m>ۥ</> مِنْهُمْ لَهُ<m>ۥ</> عَذَابٌ عَ<p>ظِي</>مٌۭ"},{"n":12,"w":[["لَّوْلَآ","lawlā","Why not","কেন না"],["إِذْ","idh","when","যখন"],["سَمِعْتُمُوهُ","sami‘'tumūhu","you heard it","তা তোমরা শুনলে"],["ظَنَّ","ẓanna","think","অনুমান করলো"],["ٱلْمُؤْمِنُونَ","l-mu'minūna","the believing men","মু'মিনরা"],["وَٱلْمُؤْمِنَـٰتُ","wal-mu'minātu","and the believing women","ও মু'মিন নারীরা"],["بِأَنفُسِهِمْ","bi-anfusihim","good of themselves","সম্পর্কে তাদের নিজেদের"],["خَيْرًۭا","khayran","good of themselves","ভালো (ধারণা)"],["وَقَالُوا۟","waqālū","and say","ও (কেন না) বললো"],["هَـٰذَآ","hādhā","This","\"এটা"],["إِفْكٌۭ","if'kun","(is) a lie","মিথ্যা অপবাদ"],["مُّبِينٌۭ","mubīnun","clear","সুস্পষ্ট\""]],"t":"لَّوْ<o>لَآ</> إِذْ سَمِعْتُمُوهُ ظَ<g>نَّ</> <h>ٱ</>لْمُؤْمِنُونَ وَ<h>ٱ</>لْمُؤْمِ<m>نَٰ</>تُ بِأَ<k>نفُ</>سِهِمْ خَيْ<d>رًۭا وَ</>قَالُو<s>ا۟</> <m>هَٰ</><o>ذَآ</> إِفْ<d>كٌۭ مُّ</><p>بِي</>نٌۭ"},{"n":13,"w":[["لَّوْلَا","lawlā","Why (did) not","কেন না"],["جَآءُو","jāū","they bring","তারা আসলো"],["عَلَيْهِ","‘alayhi","for it","এ ব্যাপারে"],["بِأَرْبَعَةِ","bi-arba‘ati","four","নিয়ে চারজন"],["شُهَدَآءَ ۚ","shuhadāa","witnesses","সাক্ষী"],["فَإِذْ","fa-idh","Then when","কাজেই যখন"],["لَمْ","lam","not","নি"],["يَأْتُوا۟","yatū","they brought","তারা আসে"],["بِٱلشُّهَدَآءِ","bil-shuhadāi","the witnesses","নিয়ে সাক্ষীদেরকে"],["فَأُو۟لَـٰٓئِكَ","fa-ulāika","then those","তাহ'লে ঐসবলোক"],["عِندَ","‘inda","near Allah","নিকটে"],["ٱللَّهِ","l-lahi","near Allah","আল্লাহর"],["هُمُ","humu","they","তারাই"],["ٱلْكَـٰذِبُونَ","l-kādhibūna","(are) the liars","মিথ্যাবাদী"]],"t":"لَّوْلَا <o>جَآ</>ءُو عَلَيْهِ بِأَرْبَعَةِ شُهَ<o>دَآ</>ءَ ۚ فَإِذْ لَمْ يَأْتُو<s>ا۟</> بِ<h>ٱ</><l>ل</>شُّهَ<o>دَآ</>ءِ فَأُ<s>و۟</><o>لَٰٓ</>ئِكَ عِ<k>ندَ</> <h>ٱ</>للَّهِ هُمُ <h>ٱ</>لْ<m>كَٰ</>ذِ<p>بُو</>نَ"},{"n":14,"w":[["وَلَوْلَا","walawlā","And if not","আর যদি না (হতো)"],["فَضْلُ","faḍlu","(for the) Grace","অনুগ্রহ"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["عَلَيْكُمْ","‘alaykum","upon you","তোমাদের উপর"],["وَرَحْمَتُهُۥ","waraḥmatuhu","and His Mercy","ও তাঁর দয়া"],["فِى","fī","in","মধ্যে"],["ٱلدُّنْيَا","l-dun'yā","the world","দুনিয়ার"],["وَٱلْـَٔاخِرَةِ","wal-ākhirati","and the Hereafter","ও আখিরাতে"],["لَمَسَّكُمْ","lamassakum","surely would have touched you","অবশ্যই তোমাদেরকে স্পর্শ করতো"],["فِى","fī","in","মধ্যে"],["مَآ","mā","what","যার"],["أَفَضْتُمْ","afaḍtum","you had rushed glibly","তোমরা জড়িয়ে পড়েছিলে"],["فِيهِ","fīhi","concerning it","সেক্ষেত্রে"],["عَذَابٌ","‘adhābun","a punishment","শাস্তি"],["عَظِيمٌ","‘aẓīmun","great","কঠিন"]],"t":"وَلَوْلَا فَضْلُ <h>ٱ</>للَّهِ عَلَيْكُمْ وَرَحْمَتُهُ<m>ۥ</> فِى <h>ٱ</><l>ل</>دُّنْيَا وَ<h>ٱ</>لْءَاخِرَةِ لَمَسَّكُمْ فِى <o>مَآ</> أَفَضْتُمْ فِيهِ عَذَابٌ عَ<p>ظِي</>مٌ"},{"n":15,"w":[["إِذْ","idh","When","যখন"],["تَلَقَّوْنَهُۥ","talaqqawnahu","you received it","তা তোমরা ছড়াচ্ছিলে"],["بِأَلْسِنَتِكُمْ","bi-alsinatikum","with your tongues","দিয়ে তোমাদের জিহ্বা"],["وَتَقُولُونَ","wataqūlūna","and you said","ও বলছিলে"],["بِأَفْوَاهِكُم","bi-afwāhikum","with your mouths","দিয়ে তোমাদের মুখ"],["مَّا","mā","what","যার"],["لَيْسَ","laysa","not","নেই"],["لَكُم","lakum","for you","তোমাদের"],["بِهِۦ","bihi","of it","সম্পর্কে সে"],["عِلْمٌۭ","‘il'mun","any knowledge","কোন জ্ঞান"],["وَتَحْسَبُونَهُۥ","wataḥsabūnahu","and you thought it","আর তা তোমরা মনে করছিলে"],["هَيِّنًۭا","hayyinan","(was) insignificant","তুচ্ছ"],["وَهُوَ","wahuwa","while it","অথচ তা"],["عِندَ","‘inda","(was) near Allah","নিকট"],["ٱللَّهِ","l-lahi","(was) near Allah","আল্লাহর"],["عَظِيمٌۭ","‘aẓīmun","great","গুরুতর"]],"t":"إِذْ تَلَقَّوْنَهُ<m>ۥ</> بِأَلْسِنَتِكُمْ وَتَقُولُونَ بِأَفْوَاهِ<y>كُم مَّ</>ا لَيْسَ لَ<f>كُم بِ</><m>هِۦ</> عِلْ<d>مٌۭ وَ</>تَحْسَبُونَهُ<m>ۥ</> هَيِّ<d>نًۭا وَ</>هُوَ عِ<k>ندَ</> <h>ٱ</>للَّهِ عَ<p>ظِي</>مٌۭ"},{"n":16,"w":[["وَلَوْلَآ","walawlā","And why not","এবং কেন না"],["إِذْ","idh","when","যখন"],["سَمِعْتُمُوهُ","sami‘'tumūhu","you heard it","তা তোমরা শুনেছিলে"],["قُلْتُم","qul'tum","you said","বললে তোমরা"],["مَّا","mā","Not","\"নয়"],["يَكُونُ","yakūnu","it is","হবার (শোভা পায়)"],["لَنَآ","lanā","for us","জন্যে আমাদের"],["أَن","an","that","যে"],["نَّتَكَلَّمَ","natakallama","we speak","কথা বলবো আমরা"],["بِهَـٰذَا","bihādhā","of this","এ বিষয়ে"],["سُبْحَـٰنَكَ","sub'ḥānaka","Glory be to You","(হে আল্লাহ) তুমি মহান পবিত্র"],["هَـٰذَا","hādhā","This","এটাতো"],["بُهْتَـٰنٌ","buh'tānun","(is) a slander","অপবাদ"],["عَظِيمٌۭ","‘aẓīmun","great","গুরুতর\""]],"t":"وَلَوْ<o>لَآ</> إِذْ سَمِعْتُمُوهُ قُلْ<y>تُم مَّ</>ا يَكُونُ لَ<o>نَآ</> <d>أَن نَّ</>تَكَلَّمَ بِ<m>هَٰ</>ذَا سُ<q>بْ</><m>حَٰ</>نَكَ <m>هَٰ</>ذَا بُهْ<m>تَٰ</>نٌ عَ<p>ظِي</>مٌۭ"},{"n":17,"w":[["يَعِظُكُمُ","ya‘iẓukumu","Allah warns you","তোমাদের উপদেশ করেন"],["ٱللَّهُ","l-lahu","Allah warns you","আল্লাহ"],["أَن","an","that","যে (না)"],["تَعُودُوا۟","ta‘ūdū","you return","পুনরাবৃত্তি করো"],["لِمِثْلِهِۦٓ","limith'lihi","(to the) like of it","অনুরূপ তার"],["أَبَدًا","abadan","ever","কখনও"],["إِن","in","if","যদি"],["كُنتُم","kuntum","you are","তোমরা হয়ে থাকো"],["مُّؤْمِنِينَ","mu'minīna","believers","মু'মিন"]],"t":"يَعِظُكُمُ <h>ٱ</>للَّهُ أَ<k>ن تَ</>عُودُو<s>ا۟</> لِمِثْلِ<o>هِۦٓ</> أَبَدًا إِ<k>ن كُنتُ</><y>م مُّ</>ؤْمِ<p>نِي</>نَ"},{"n":18,"w":[["وَيُبَيِّنُ","wayubayyinu","And Allah makes clear","এবং সুস্পষ্ট বর্ণনা করেছেন"],["ٱللَّهُ","l-lahu","And Allah makes clear","আল্লাহ"],["لَكُمُ","lakumu","to you","জন্যে তোমাদের"],["ٱلْـَٔايَـٰتِ ۚ","l-āyāti","the Verses","আয়াতসমূহ"],["وَٱللَّهُ","wal-lahu","And Allah","আর আল্লাহ"],["عَلِيمٌ","‘alīmun","(is) All-Knower","সর্বজ্ঞ"],["حَكِيمٌ","ḥakīmun","All-Wise","প্রজ্ঞাময়"]],"t":"وَيُبَيِّنُ <h>ٱ</>للَّهُ لَكُمُ <h>ٱ</>لْءَا<m>يَٰ</>تِ ۚ وَ<h>ٱ</>للَّهُ عَلِيمٌ حَ<p>كِي</>مٌ"},{"n":19,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["يُحِبُّونَ","yuḥibbūna","like","পছন্দ করে"],["أَن","an","that","যে"],["تَشِيعَ","tashī‘a","(should) spread","প্রসার লাভ করুক"],["ٱلْفَـٰحِشَةُ","l-fāḥishatu","the immorality","নির্লজ্জতা"],["فِى","fī","among","মধ্যে"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["لَهُمْ","lahum","for them","জন্যে তাদের"],["عَذَابٌ","‘adhābun","(is) a punishment","শাস্তি"],["أَلِيمٌۭ","alīmun","painful","নিদারুণ"],["فِى","fī","in","মধ্যে"],["ٱلدُّنْيَا","l-dun'yā","the world","দুনিয়ার"],["وَٱلْـَٔاخِرَةِ ۚ","wal-ākhirati","and the Hereafter","ও আখিরাতে"],["وَٱللَّهُ","wal-lahu","And Allah","আর আল্লাহ"],["يَعْلَمُ","ya‘lamu","knows","জানেন"],["وَأَنتُمْ","wa-antum","while you","কিন্তু তোমরা"],["لَا","lā","(do) not","না"],["تَعْلَمُونَ","ta‘lamūna","know","তোমরা জানো"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ يُحِبُّونَ أَ<k>ن تَ</>شِيعَ <h>ٱ</>لْ<m>فَٰ</>حِشَةُ فِى <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> لَهُمْ عَذَابٌ أَلِي<k>مٌۭ فِ</>ى <h>ٱ</><l>ل</>دُّنْيَا وَ<h>ٱ</>لْءَاخِرَةِ ۚ وَ<h>ٱ</>للَّهُ يَعْلَمُ وَأَ<k>نتُ</>مْ لَا تَعْلَ<p>مُو</>نَ"},{"n":20,"w":[["وَلَوْلَا","walawlā","And if not","এবং যদি না (হতো)"],["فَضْلُ","faḍlu","(for the) Grace of Allah","অনুগ্রহ"],["ٱللَّهِ","l-lahi","(for the) Grace of Allah","আল্লাহর"],["عَلَيْكُمْ","‘alaykum","upon you","তোমাদের উপর"],["وَرَحْمَتُهُۥ","waraḥmatuhu","and His Mercy","ও তাঁর দয়া (তবে নিকৃষ্ট পরিণাম হতো)"],["وَأَنَّ","wa-anna","And that","কিন্তু নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["رَءُوفٌۭ","raūfun","(is) Full of Kindness","বড়ই দয়াবান"],["رَّحِيمٌۭ","raḥīmun","Most Merciful","পরম দয়ালু"]],"t":"وَلَوْلَا فَضْلُ <h>ٱ</>للَّهِ عَلَيْكُمْ وَرَحْمَتُهُ<m>ۥ</> وَأَ<g>نَّ</> <h>ٱ</>للَّهَ رَءُو<w>فٌۭ رَّ</><p>حِي</>مٌۭ"},{"n":21,"w":[["۞ يَـٰٓأَيُّهَا","yāayyuhā","O you who believe","হে"],["ٱلَّذِينَ","alladhīna","O you who believe","যারা"],["ءَامَنُوا۟","āmanū","O you who believe","ঈমান এনেছো"],["لَا","lā","(Do) not","না"],["تَتَّبِعُوا۟","tattabi‘ū","follow","তোমরা অনুসরণ করো"],["خُطُوَٰتِ","khuṭuwāti","(the) footsteps","পদাঙ্ক"],["ٱلشَّيْطَـٰنِ ۚ","l-shayṭāni","(of) the Shaitaan","শয়তানের"],["وَمَن","waman","and whoever","আর যে"],["يَتَّبِعْ","yattabi‘","follows","অনুসরণ করবে"],["خُطُوَٰتِ","khuṭuwāti","(the) footsteps","পদাঙ্ক"],["ٱلشَّيْطَـٰنِ","l-shayṭāni","(of) the Shaitaan","শয়তানের"],["فَإِنَّهُۥ","fa-innahu","then indeed, he","তাহ'লে সে নিশ্চয়ই"],["يَأْمُرُ","yamuru","commands","নির্দেশ দেবে"],["بِٱلْفَحْشَآءِ","bil-faḥshāi","the immorality","প্রতি নির্লজ্জতার"],["وَٱلْمُنكَرِ ۚ","wal-munkari","and the evil","ও মন্দ কাজের"],["وَلَوْلَا","walawlā","And if not","না যদি আর (হতো)"],["فَضْلُ","faḍlu","(for the) Grace of Allah","অনুগ্রহ"],["ٱللَّهِ","l-lahi","(for the) Grace of Allah","আল্লাহ্‌র"],["عَلَيْكُمْ","‘alaykum","upon you","তোমাদের উপর"],["وَرَحْمَتُهُۥ","waraḥmatuhu","and His Mercy","ও তাঁর দয়া"],["مَا","mā","not","না"],["زَكَىٰ","zakā","(would) have been pure","পবিত্র হ'তে পারতো"],["مِنكُم","minkum","among you","তোমাদের মধ্যে"],["مِّنْ","min","anyone","কোন"],["أَحَدٍ","aḥadin","anyone","একজন"],["أَبَدًۭا","abadan","ever","কখনও"],["وَلَـٰكِنَّ","walākinna","but","কিন্তু"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["يُزَكِّى","yuzakkī","purifies","পবিত্র করে দেন"],["مَن","man","whom","যাকে"],["يَشَآءُ ۗ","yashāu","He wills","তিনি চান"],["وَٱللَّهُ","wal-lahu","And Allah","আর আল্লাহ্‌"],["سَمِيعٌ","samī‘un","(is) All-Hearer","সব শুনেন"],["عَلِيمٌۭ","‘alīmun","All-Knower","সব জানেন"]],"t":"۞ <o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> لَا تَتَّبِعُو<s>ا۟</> خُطُ<m>وَٰ</>تِ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نِ ۚ وَ<d>مَن يَ</>تَّبِعْ خُطُ<m>وَٰ</>تِ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نِ فَإِ<g>نَّ</>هُ<m>ۥ</> يَأْمُرُ بِ<h>ٱ</>لْفَحْ<o>شَآ</>ءِ وَ<h>ٱ</>لْمُ<k>نكَ</>رِ ۚ وَلَوْلَا فَضْلُ <h>ٱ</>للَّهِ عَلَيْكُمْ وَرَحْمَتُهُ<m>ۥ</> مَا زَكَىٰ مِ<k>نكُ</><y>م مِّ</>نْ أَحَدٍ أَبَ<d>دًۭا وَ</><m>لَٰ</>كِ<g>نَّ</> <h>ٱ</>للَّهَ يُزَكِّى <d>مَن يَ</><o>شَآ</>ءُ ۗ وَ<h>ٱ</>للَّهُ سَمِيعٌ عَ<p>لِي</>مٌۭ"},{"n":22,"w":[["وَلَا","walā","And not","আর না (যেন)"],["يَأْتَلِ","yatali","let swear","শপথ গ্রহণ করে"],["أُو۟لُوا۟","ulū","those of virtue","অধিকারীরা"],["ٱلْفَضْلِ","l-faḍli","those of virtue","অনুগ্রহের"],["مِنكُمْ","minkum","among you","তোমাদের মধ্য থেকে"],["وَٱلسَّعَةِ","wal-sa‘ati","and the amplitude of means","ও প্রাচুর্যের (অধিকারীরা)"],["أَن","an","that","যে"],["يُؤْتُوٓا۟","yu'tū","they give","তারা দিবে (না)"],["أُو۟لِى","ulī","(to) the near of kin","অধিকারীদের"],["ٱلْقُرْبَىٰ","l-qur'bā","(to) the near of kin","নৈকট্যের (আত্মীয় স্বজনকে)"],["وَٱلْمَسَـٰكِينَ","wal-masākīna","and the needy","ও অভাবগ্রস্তদেরকে"],["وَٱلْمُهَـٰجِرِينَ","wal-muhājirīna","and the emigrants","ও মুহাজিরদেরকে"],["فِى","fī","in","মধ্যে"],["سَبِيلِ","sabīli","(the) way","পথের"],["ٱللَّهِ ۖ","l-lahi","(of) Allah","আল্লাহ্‌র"],["وَلْيَعْفُوا۟","walya‘fū","And let them pardon","এবং যেন তারা ক্ষমা করে দেয়"],["وَلْيَصْفَحُوٓا۟ ۗ","walyaṣfaḥū","and let them overlook","এবং যেন দোষ-ত্রুটি উপেক্ষা করে"],["أَلَا","alā","(Do) not","না কি"],["تُحِبُّونَ","tuḥibbūna","you like","তোমরা পছন্দ করো"],["أَن","an","that","যে"],["يَغْفِرَ","yaghfira","Allah should forgive","ক্ষমা করবেন"],["ٱللَّهُ","l-lahu","Allah should forgive","আল্লাহ্‌"],["لَكُمْ ۗ","lakum","you","তোমাদেরকে"],["وَٱللَّهُ","wal-lahu","And Allah","আর আল্লাহ্‌"],["غَفُورٌۭ","ghafūrun","(is) Oft-Forgiving","বড় ক্ষমাশীল"],["رَّحِيمٌ","raḥīmun","Most Merciful","পরম দয়ালু"]],"t":"وَلَا يَأْتَلِ أُ<s>و۟</>لُو<s>ا۟</> <h>ٱ</>لْفَضْلِ مِ<k>نكُ</>مْ وَ<h>ٱ</><l>ل</>سَّعَةِ <d>أَن يُ</>ؤْ<o>تُوٓ</><s>ا۟</> أُ<s>و۟</>لِى <h>ٱ</>لْقُرْبَىٰ وَ<h>ٱ</>لْمَ<m>سَٰ</>كِينَ وَ<h>ٱ</>لْمُ<m>هَٰ</>جِرِينَ فِى سَبِيلِ <h>ٱ</>للَّهِ ۖ وَلْيَعْفُو<s>ا۟</> وَلْيَصْفَ<o>حُوٓ</><s>ا۟</> ۗ أَلَا تُحِبُّونَ <d>أَن يَ</>غْفِرَ <h>ٱ</>للَّهُ لَكُمْ ۗ وَ<h>ٱ</>للَّهُ غَفُو<w>رٌۭ رَّ</><p>حِي</>مٌ"},{"n":23,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["يَرْمُونَ","yarmūna","accuse","অপবাদ দেয়"],["ٱلْمُحْصَنَـٰتِ","l-muḥ'ṣanāti","the chaste women","পবিত্র রমনীরা"],["ٱلْغَـٰفِلَـٰتِ","l-ghāfilāti","the unaware women","সাদাসিধা"],["ٱلْمُؤْمِنَـٰتِ","l-mu'mināti","(and) the believing women","মু'মিন নারীদেরকে"],["لُعِنُوا۟","lu‘inū","are cursed","তারা অভিশপ্ত"],["فِى","fī","in","মধ্যে"],["ٱلدُّنْيَا","l-dun'yā","the world","দুনিয়ার"],["وَٱلْـَٔاخِرَةِ","wal-ākhirati","and the Hereafter","ও আখিরাতে"],["وَلَهُمْ","walahum","And for them","এবং জন্যে তাদের"],["عَذَابٌ","‘adhābun","(is) a punishment","শাস্তি (রয়েছে)"],["عَظِيمٌۭ","‘aẓīmun","great","কঠিন"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ يَرْمُونَ <h>ٱ</>لْمُحْصَ<m>نَٰ</>تِ <h>ٱ</>لْ<m>غَٰفِلَٰ</>تِ <h>ٱ</>لْمُؤْمِ<m>نَٰ</>تِ لُعِنُو<s>ا۟</> فِى <h>ٱ</><l>ل</>دُّنْيَا وَ<h>ٱ</>لْءَاخِرَةِ وَلَهُمْ عَذَابٌ عَ<p>ظِي</>مٌۭ"},{"n":24,"w":[["يَوْمَ","yawma","(On a) Day","সেদিন"],["تَشْهَدُ","tashhadu","will bear witness","সাক্ষ্য দিবে"],["عَلَيْهِمْ","‘alayhim","against them","তাদের বিরুদ্ধে"],["أَلْسِنَتُهُمْ","alsinatuhum","their tongues","তাদের জিহ্বাগুলো"],["وَأَيْدِيهِمْ","wa-aydīhim","and their hands","ও তাদের হাতগুলো"],["وَأَرْجُلُهُم","wa-arjuluhum","and their feet","ও তাদের পাগুলো"],["بِمَا","bimā","for what","ঐ বিষয়ে যা"],["كَانُوا۟","kānū","they used","তারা ছিলো"],["يَعْمَلُونَ","ya‘malūna","(to) do","তারা কাজ করে"]],"t":"يَوْمَ تَشْهَدُ عَلَيْهِمْ أَلْسِنَتُهُمْ وَأَيْدِيهِمْ وَأَرْجُلُ<f>هُم بِ</>مَا كَانُو<s>ا۟</> يَعْمَ<p>لُو</>نَ"},{"n":25,"w":[["يَوْمَئِذٍۢ","yawma-idhin","That Day","সেদিন"],["يُوَفِّيهِمُ","yuwaffīhimu","Allah will pay them in full","তাদেরকে পুরোপুরি দিবেন"],["ٱللَّهُ","l-lahu","Allah will pay them in full","আল্লাহ্‌"],["دِينَهُمُ","dīnahumu","their recompense","তাদের প্রতিদান"],["ٱلْحَقَّ","l-ḥaqa","the due","যথাযোগ্য"],["وَيَعْلَمُونَ","waya‘lamūna","and they will know","আর তারা জানবে"],["أَنَّ","anna","that","যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["هُوَ","huwa","He","তিনিই"],["ٱلْحَقُّ","l-ḥaqu","(is) the Truth","সত্য"],["ٱلْمُبِينُ","l-mubīnu","the Manifest","(সত্যের) সুস্পষ্ট প্রকাশক"]],"t":"يَوْمَئِ<d>ذٍۢ يُ</>وَفِّيهِمُ <h>ٱ</>للَّهُ دِينَهُمُ <h>ٱ</>لْحَقَّ وَيَعْلَمُونَ أَ<g>نَّ</> <h>ٱ</>للَّهَ هُوَ <h>ٱ</>لْحَقُّ <h>ٱ</>لْمُ<p>بِي</>نُ"},{"n":26,"w":[["ٱلْخَبِيثَـٰتُ","al-khabīthātu","Evil women","দুশ্চরিত্রা নারীরা"],["لِلْخَبِيثِينَ","lil'khabīthīna","(are) for evil men","জন্যে দুশ্চরিত্র পুরুষদের (যোগ্য)"],["وَٱلْخَبِيثُونَ","wal-khabīthūna","and evil men","ও দুশ্চরিত্র পুরুষরা"],["لِلْخَبِيثَـٰتِ ۖ","lil'khabīthāti","(are) for evil women","জন্যে দুশ্চরিত্রা নারীদের (যোগ্য)"],["وَٱلطَّيِّبَـٰتُ","wal-ṭayibātu","And good women","এবং সচ্চরিত্রা নারীরা"],["لِلطَّيِّبِينَ","lilṭṭayyibīna","(are) for good men","জন্যে সচ্চরিত্র পুরুষের (যোগ্য)"],["وَٱلطَّيِّبُونَ","wal-ṭayibūna","and good men","ও সচ্চরিত্র পুরুষরা"],["لِلطَّيِّبَـٰتِ ۚ","lilṭṭayyibāti","(are) for good women","জন্যে সচ্চরিত্রা নারীদের (যোগ্য)"],["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসবলোক"],["مُبَرَّءُونَ","mubarraūna","(are) innocent","মুক্ত"],["مِمَّا","mimmā","of what","তাহ'তে যা"],["يَقُولُونَ ۖ","yaqūlūna","they say","তারা বলে"],["لَهُم","lahum","For them","জন্যে তাদের (রয়েছে)"],["مَّغْفِرَةٌۭ","maghfiratun","(is) forgiveness","ক্ষমা"],["وَرِزْقٌۭ","wariz'qun","and a provision","ও জীবিকা"],["كَرِيمٌۭ","karīmun","noble","সম্মানিত"]],"t":"ٱلْخَبِي<m>ثَٰ</>تُ لِلْخَبِيثِينَ وَ<h>ٱ</>لْخَبِيثُونَ لِلْخَبِي<m>ثَٰ</>تِ ۖ وَ<h>ٱ</><l>ل</>طَّيِّ<m>بَٰ</>تُ لِلطَّيِّبِينَ وَ<h>ٱ</><l>ل</>طَّيِّبُونَ لِلطَّيِّ<m>بَٰ</>تِ ۚ أُ<s>و۟</><o>لَٰٓ</>ئِكَ مُبَرَّءُونَ مِ<g>مَّ</>ا يَقُولُونَ ۖ لَ<y>هُم مَّ</>غْفِرَ<d>ةٌۭ وَ</>رِزْ<k>قٌۭ كَ</><p>رِي</>مٌۭ"},{"n":27,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you","হে"],["ٱلَّذِينَ","alladhīna","who","যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছো"],["لَا","lā","(Do) not","না"],["تَدْخُلُوا۟","tadkhulū","enter","তোমরা প্রবেশ করো"],["بُيُوتًا","buyūtan","houses","ঘরগুলোতে (অন্যদের)"],["غَيْرَ","ghayra","other (than)","ছাড়া"],["بُيُوتِكُمْ","buyūtikum","your houses","তোমাদের ঘরগুলো"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["تَسْتَأْنِسُوا۟","tastanisū","you have asked permission","তোমরা অনুমতি চাও (ও পাও)"],["وَتُسَلِّمُوا۟","watusallimū","and you have greeted","ও তোমরা সালাম দাও"],["عَلَىٰٓ","‘alā","[on]","উপর"],["أَهْلِهَا ۚ","ahlihā","its inhabitants","তারা অধিবাসীদের"],["ذَٰلِكُمْ","dhālikum","That","এটা"],["خَيْرٌۭ","khayrun","(is) best","উত্তম"],["لَّكُمْ","lakum","for you","জন্যে তোমাদের"],["لَعَلَّكُمْ","la‘allakum","so that you may","আশা করা যায় তোমরা"],["تَذَكَّرُونَ","tadhakkarūna","pay heed","তোমরা উপদেশ গ্রহণ করবে"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> لَا تَ<q>دْ</>خُلُو<s>ا۟</> بُيُوتًا غَيْرَ بُيُوتِكُمْ حَتَّىٰ تَسْتَأْنِسُو<s>ا۟</> وَتُسَلِّمُو<s>ا۟</> عَلَ<o>ىٰٓ</> أَهْلِهَا ۚ <m>ذَٰ</>لِكُمْ خَيْ<w>رٌۭ لَّ</>كُمْ لَعَلَّكُمْ تَذَكَّ<p>رُو</>نَ"},{"n":28,"w":[["فَإِن","fa-in","But if","তবে যদি"],["لَّمْ","lam","not","না"],["تَجِدُوا۟","tajidū","you find","তোমরা পাও"],["فِيهَآ","fīhā","in it","তার মধ্যে"],["أَحَدًۭا","aḥadan","anyone","কাউকে"],["فَلَا","falā","then (do) not","তাহ'লে না"],["تَدْخُلُوهَا","tadkhulūhā","enter it","তাতে তোমরা প্রবেশ করো"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["يُؤْذَنَ","yu'dhana","permission has been given","অনুমতি দেয়া হয়"],["لَكُمْ ۖ","lakum","to you","তোমাদের জন্যে"],["وَإِن","wa-in","And if","আর যদি"],["قِيلَ","qīla","it is said","বলা হয়"],["لَكُمُ","lakumu","to you","তোমাদেরকে"],["ٱرْجِعُوا۟","ir'ji‘ū","Go back","\"তোমরা ফিরে যাও\""],["فَٱرْجِعُوا۟ ۖ","fa-ir'ji‘ū","then go back","তাহ'লে তোমরা ফিরে যাও"],["هُوَ","huwa","it","তা"],["أَزْكَىٰ","azkā","(is) purer","পবিত্রতম"],["لَكُمْ ۚ","lakum","for you","জন্যে তোমাদের"],["وَٱللَّهُ","wal-lahu","And Allah","আর আল্লাহ্‌"],["بِمَا","bimā","of what","ঐ বিষয়ে যা"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা করো (সে সম্পর্কে)"],["عَلِيمٌۭ","‘alīmun","(is) All-Knower","খুব অবহিত"]],"t":"فَ<w>إِن لَّ</>مْ تَجِدُو<s>ا۟</> فِي<o>هَآ</> أَحَ<k>دًۭا فَ</>لَا تَ<q>دْ</>خُلُوهَا حَتَّىٰ يُؤْذَنَ لَكُمْ ۖ وَإِ<k>ن قِ</>يلَ لَكُمُ <h>ٱ</>رْجِعُو<s>ا۟</> فَ<h>ٱ</>رْجِعُو<s>ا۟ ۖ</> هُوَ أَزْكَىٰ لَكُمْ ۚ وَ<h>ٱ</>للَّهُ بِمَا تَعْمَلُونَ عَ<p>لِي</>مٌۭ"},{"n":29,"w":[["لَّيْسَ","laysa","Not","নেই"],["عَلَيْكُمْ","‘alaykum","upon you","তোমাদের উপর"],["جُنَاحٌ","junāḥun","(is) any blame","কোন পাপ"],["أَن","an","that","যে"],["تَدْخُلُوا۟","tadkhulū","you enter","তোমরা প্রবেশ করবে"],["بُيُوتًا","buyūtan","houses","(এমন) ঘরগুলোতে"],["غَيْرَ","ghayra","not","(যা) নয়"],["مَسْكُونَةٍۢ","maskūnatin","inhabited","বসবাসের স্থান (কারো)"],["فِيهَا","fīhā","in it","তার মধ্যে (আছে)"],["مَتَـٰعٌۭ","matā‘un","(is) a provision","সামগ্রী দ্রব্য"],["لَّكُمْ ۚ","lakum","for you","তোমাদের (সবার জন্যে)"],["وَٱللَّهُ","wal-lahu","And Allah","আর আল্লাহ্‌"],["يَعْلَمُ","ya‘lamu","knows","জানেন"],["مَا","mā","what","যা"],["تُبْدُونَ","tub'dūna","you reveal","তোমরা প্রকাশ করো"],["وَمَا","wamā","and what","আর যা"],["تَكْتُمُونَ","taktumūna","you conceal","তোমরা গোপন করো"]],"t":"لَّيْسَ عَلَيْكُمْ جُنَاحٌ أَ<k>ن تَ</><q>دْ</>خُلُو<s>ا۟</> بُيُوتًا غَيْرَ مَسْكُونَ<k>ةٍۢ فِ</>يهَا مَ<m>تَٰ</><w>عٌۭ لَّ</>كُمْ ۚ وَ<h>ٱ</>للَّهُ يَعْلَمُ مَا تُ<q>بْ</>دُونَ وَمَا تَكْتُ<p>مُو</>نَ"},{"n":30,"w":[["قُل","qul","Say","(হে নাবী) বলো"],["لِّلْمُؤْمِنِينَ","lil'mu'minīna","to the believing men","মু'মিনদেরকে"],["يَغُضُّوا۟","yaghuḍḍū","they should lower","সংযত করে (যেন তারা)"],["مِنْ","min","their gaze","ব্যাপার"],["أَبْصَـٰرِهِمْ","abṣārihim","their gaze","দৃষ্টিগুলোর তাদের"],["وَيَحْفَظُوا۟","wayaḥfaẓū","and they should guard","এবং সংরক্ষণ করে (যেন)"],["فُرُوجَهُمْ ۚ","furūjahum","their chastity","লজ্জাস্থানসমূহকে তাদের"],["ذَٰلِكَ","dhālika","That","এটা"],["أَزْكَىٰ","azkā","(is) purer","পবিত্রতম"],["لَهُمْ ۗ","lahum","for them","জন্যে তাদের"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["خَبِيرٌۢ","khabīrun","(is) All-Aware","খুব অবগত"],["بِمَا","bimā","of what","(ঐ বিষয়ে) যা কিছু"],["يَصْنَعُونَ","yaṣna‘ūna","they do","তারা করে"]],"t":"قُل لِّلْمُؤْمِنِينَ يَغُضُّو<s>ا۟</> مِنْ أَ<q>بْ</><m>صَٰ</>رِهِمْ وَيَحْفَظُو<s>ا۟</> فُرُوجَهُمْ ۚ <m>ذَٰ</>لِكَ أَزْكَىٰ لَهُمْ ۗ إِ<g>نَّ</> <h>ٱ</>للَّهَ خَبِي<i>رٌۢ بِ</>مَا يَصْنَ<p>عُو</>نَ"},{"n":31,"w":[["وَقُل","waqul","And say","এবং বলো"],["لِّلْمُؤْمِنَـٰتِ","lil'mu'mināti","to the believing women","মু'মিন নারীদেরকে"],["يَغْضُضْنَ","yaghḍuḍ'na","(that) they should lower","তারা সংযত রাখে (যেন)"],["مِنْ","min","[of]","ব্যাপার"],["أَبْصَـٰرِهِنَّ","abṣārihinna","their gaze","তাদের দৃষ্টিসমূহের"],["وَيَحْفَظْنَ","wayaḥfaẓna","and they should guard","ও সংরক্ষণ করে (যেন)"],["فُرُوجَهُنَّ","furūjahunna","their chastity","তাদের লজ্জাস্থানসমূহকে"],["وَلَا","walā","and not","এবং না (যেন)"],["يُبْدِينَ","yub'dīna","(to) display","প্রদর্শন করে"],["زِينَتَهُنَّ","zīnatahunna","their adornment","তাদের সৌন্দর্য"],["إِلَّا","illā","except","ছাড়া"],["مَا","mā","what","যা"],["ظَهَرَ","ẓahara","is apparent","(সাধারণভাবে) প্রকাশ পায়"],["مِنْهَا ۖ","min'hā","of it","তা হ'তে"],["وَلْيَضْرِبْنَ","walyaḍrib'na","And let them draw","এবং জড়িয়ে রাখে যেন"],["بِخُمُرِهِنَّ","bikhumurihinna","their head covers","দিয়ে তাদের ওড়না"],["عَلَىٰ","‘alā","over","উপর"],["جُيُوبِهِنَّ ۖ","juyūbihinna","their bosoms","তাদের ঘাড় ও বুকের"],["وَلَا","walā","and not","আর না (যেন)"],["يُبْدِينَ","yub'dīna","(to) display","প্রকাশ ক