>مُو</>نَ"},{"n":82,"w":[["۞ وَإِذَا","wa-idhā","And when","এবং যখন"],["وَقَعَ","waqa‘a","(is) fulfilled","এসে পড়বে"],["ٱلْقَوْلُ","l-qawlu","the word","(ঘোষিত শাস্তির) কথা"],["عَلَيْهِمْ","‘alayhim","against them","উপর তাদের"],["أَخْرَجْنَا","akhrajnā","We will bring forth","আমরা বের করবো"],["لَهُمْ","lahum","for them","জন্যে তাদের"],["دَآبَّةًۭ","dābbatan","a creature","একটি জন্তু"],["مِّنَ","mina","from","হ'তে"],["ٱلْأَرْضِ","l-arḍi","the earth","মাটি"],["تُكَلِّمُهُمْ","tukallimuhum","speaking to them","সে কথা বলবে তাদের (সাথে)"],["أَنَّ","anna","that","যেহেতু"],["ٱلنَّاسَ","l-nāsa","the people","মানিষ"],["كَانُوا۟","kānū","were","তারা ছিলো"],["بِـَٔايَـٰتِنَا","biāyātinā","of Our Signs","প্রতি আয়াতগুলোর আমাদের"],["لَا","lā","not","না"],["يُوقِنُونَ","yūqinūna","certain","দৃঢ় বিশ্বাস করতো"]],"t":"۞ وَإِذَا وَقَعَ <h>ٱ</>لْقَوْلُ عَلَيْهِمْ أَخْرَ<q>جْ</>نَا لَهُمْ <n>دَآ</>بَّ<d>ةًۭ مِّ</>نَ <h>ٱ</>لْأَرْضِ تُكَلِّمُهُمْ أَ<g>نَّ</> <h>ٱ</><l>ل</><g>نَّ</>اسَ كَانُو<s>ا۟</> بِـَٔا<m>يَٰ</>تِنَا لَا يُوقِ<p>نُو</>نَ"},{"n":83,"w":[["وَيَوْمَ","wayawma","And (the) Day","এবং(স্মরণ করো) সেদিন"],["نَحْشُرُ","naḥshuru","We will gather","আমরা সমবেত করবো"],["مِن","min","from","হ'তে"],["كُلِّ","kulli","every","প্রত্যেক"],["أُمَّةٍۢ","ummatin","nation","সম্প্রদায়"],["فَوْجًۭا","fawjan","a troop","একেক দলকে"],["مِّمَّن","mimman","of (those) who","তাদের হ'তে যারা"],["يُكَذِّبُ","yukadhibu","deny","মিথ্যারোপ করতো"],["بِـَٔايَـٰتِنَا","biāyātinā","Our Signs","প্রতি আয়াতগুলোর আমাদের"],["فَهُمْ","fahum","and they","অতঃপর তাদেরকে"],["يُوزَعُونَ","yūza‘ūna","will be set in rows","ভাগ করা হবে (বিভিন্ন দলে)"]],"t":"وَيَوْمَ نَحْشُرُ مِ<k>ن كُ</>لِّ أُ<g>مَّ</><k>ةٍۢ فَ</>وْ<d>جًۭا مِّ</><g>مَّ</><d>ن يُ</>كَذِّبُ بِـَٔا<m>يَٰ</>تِنَا فَهُمْ يُوزَ<p>عُو</>نَ"},{"n":84,"w":[["حَتَّىٰٓ","ḥattā","Until","শেষ পর্যন্ত"],["إِذَا","idhā","when","যখন"],["جَآءُو","jāū","they come","তারা এসে যাবে (সব দল)"],["قَالَ","qāla","He will say","(আল্লাহ) বলবেন"],["أَكَذَّبْتُم","akadhabtum","Did you deny","\"কি প্রত্যাখ্যান করেছিলে তোমরা"],["بِـَٔايَـٰتِى","biāyātī","My Signs","প্রতি নিদর্শনগুলোর আমাদের"],["وَلَمْ","walam","while not","অথচ নি"],["تُحِيطُوا۟","tuḥīṭū","you encompassed","আয়ত্বে নিতে পারো"],["بِهَا","bihā","them","সম্পর্কে সেগুলো"],["عِلْمًا","‘il'man","(in) knowledge","কোনো জ্ঞান"],["أَمَّاذَا","ammādhā","or what","কি (তবে) আর"],["كُنتُمْ","kuntum","you used (to)","তোমরা ছিলে"],["تَعْمَلُونَ","ta‘malūna","do","তোমরা করো\""]],"t":"حَتَّ<o>ىٰٓ</> إِذَا <o>جَآ</>ءُو قَالَ أَكَذَّ<q>بْ</><f>تُم بِـَٔ</>ا<m>يَٰ</>تِى وَلَمْ تُحِيطُو<s>ا۟</> بِهَا عِلْمًا أَ<g>مَّ</>اذَا كُ<k>نتُ</>مْ تَعْمَ<p>لُو</>نَ"},{"n":85,"w":[["وَوَقَعَ","wawaqa‘a","And (will be) fulfilled","আর এসে পড়বে"],["ٱلْقَوْلُ","l-qawlu","the word","(ঘোষিত শাস্তির) কথা"],["عَلَيْهِم","‘alayhim","against them","উপর তাদের"],["بِمَا","bimā","because","এ কারণে যা"],["ظَلَمُوا۟","ẓalamū","they wronged","তারা সীমালঙ্ঘন করেছিলো"],["فَهُمْ","fahum","and they","তখন তারা"],["لَا","lā","(will) not","না"],["يَنطِقُونَ","yanṭiqūna","speak","কথা বলতে পারবে"]],"t":"وَوَقَعَ <h>ٱ</>لْقَوْلُ عَلَيْ<f>هِم بِ</>مَا ظَلَمُو<s>ا۟</> فَهُمْ لَا يَ<k>نطِ</><p>قُو</>نَ"},{"n":86,"w":[["أَلَمْ","alam","Do not","কি নি"],["يَرَوْا۟","yaraw","they see","তারা দেখে"],["أَنَّا","annā","that We","যে আমরা"],["جَعَلْنَا","ja‘alnā","[We] have made","(আমরা) বানিয়েছি"],["ٱلَّيْلَ","al-layla","the night","রাতকে"],["لِيَسْكُنُوا۟","liyaskunū","that they may rest","যেন তারা প্রশান্তি লাভ করে"],["فِيهِ","fīhi","in it","মধ্যে তার"],["وَٱلنَّهَارَ","wal-nahāra","and the day","আর দিনকে (করেছি)"],["مُبْصِرًا ۚ","mub'ṣiran","giving visibility","দৃশ্যমান"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে (রয়েছে)"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَـٰتٍۢ","laāyātin","surely (are) Signs","অবশ্যই নিদর্শনাবলী"],["لِّقَوْمٍۢ","liqawmin","for a people","জন্যে সম্প্রদায় (যারা)"],["يُؤْمِنُونَ","yu'minūna","who believe","ঈমান আনে"]],"t":"أَلَمْ يَرَوْ<s>ا۟</> أَ<g>نَّ</>ا جَعَلْنَا <h>ٱ</>لَّيْلَ لِيَسْكُنُو<s>ا۟</> فِيهِ وَ<h>ٱ</><l>ل</><g>نَّ</>هَارَ مُ<q>بْ</>صِرًا ۚ إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَا<m>يَٰ</><w>تٍۢ لِّ</>قَوْ<d>مٍۢ يُ</>ؤْمِ<p>نُو</>نَ"},{"n":87,"w":[["وَيَوْمَ","wayawma","And (the) Day","এবং সেদিন"],["يُنفَخُ","yunfakhu","will be blown","ফুঁ দেওয়া হবে"],["فِى","fī","[in]","মধ্যে"],["ٱلصُّورِ","l-ṣūri","the trumpet","শিঙ্গার"],["فَفَزِعَ","fafazi‘a","and will be terrified","অতঃপর হবে ভীত-কম্পিত"],["مَن","man","whoever","যারা"],["فِى","fī","(is) in","আছে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশমন্ডলীতে"],["وَمَن","waman","and whoever","আর যারা (আছে)"],["فِى","fī","(is) in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["إِلَّا","illā","except","ছাড়া"],["مَن","man","whom","(তারা) যাদেরকে"],["شَآءَ","shāa","Allah wills","চাইবেন"],["ٱللَّهُ ۚ","l-lahu","Allah wills","আল্লাহ"],["وَكُلٌّ","wakullun","And all","এবং সবাই"],["أَتَوْهُ","atawhu","(will) come to Him","তাঁর (কাছে) আসবে"],["دَٰخِرِينَ","dākhirīna","humbled","হীন অবস্থায়"]],"t":"وَيَوْمَ يُ<k>نفَ</>خُ فِى <h>ٱ</><l>ل</>صُّورِ فَفَزِعَ مَ<k>ن فِ</>ى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَمَ<k>ن فِ</>ى <h>ٱ</>لْأَرْضِ إِلَّا مَ<k>ن شَ</><o>آ</>ءَ <h>ٱ</>للَّهُ ۚ وَكُلٌّ أَتَوْهُ <m>دَٰ</>خِ<p>رِي</>نَ"},{"n":88,"w":[["وَتَرَى","watarā","And you see","এবং তুমি দেখছো"],["ٱلْجِبَالَ","l-jibāla","the mountains","পর্বতমালাকে"],["تَحْسَبُهَا","taḥsabuhā","thinking them","মনে করছো তাদেরকে"],["جَامِدَةًۭ","jāmidatan","firmly fixed","অচল"],["وَهِىَ","wahiya","while they","অথচ তা (সেদিন)"],["تَمُرُّ","tamurru","will pass","চলবে"],["مَرَّ","marra","(as the) passing","চলন (মতো)"],["ٱلسَّحَابِ ۚ","l-saḥābi","(of) the clouds","মেঘমালার"],["صُنْعَ","ṣun'‘a","(The) Work","সৃষ্টি-নৈপুণ্য"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["ٱلَّذِىٓ","alladhī","Who","যিনি"],["أَتْقَنَ","atqana","perfected","সুষম করেছেন"],["كُلَّ","kulla","all","প্রত্যেক"],["شَىْءٍ ۚ","shayin","things","জিনিসকে"],["إِنَّهُۥ","innahu","Indeed, He","নিশ্চয়ই তিনি"],["خَبِيرٌۢ","khabīrun","(is) All-Aware","খুব অবহিত"],["بِمَا","bimā","of what","ঐ বিষয় সম্পর্কে যা"],["تَفْعَلُونَ","taf‘alūna","you do","তোমরা করছো"]],"t":"وَتَرَى <h>ٱ</>لْجِبَالَ تَحْسَبُهَا جَامِدَ<d>ةًۭ وَ</>هِىَ تَمُرُّ مَرَّ <h>ٱ</><l>ل</>سَّحَابِ ۚ صُنْعَ <h>ٱ</>للَّهِ <h>ٱ</>لَّ<o>ذِىٓ</> أَتْقَنَ كُلَّ شَىْءٍ ۚ إِ<g>نَّ</>هُ<m>ۥ</> خَبِي<i>رٌۢ بِ</>مَا تَفْعَ<p>لُو</>نَ"},{"n":89,"w":[["مَن","man","Whoever","যে"],["جَآءَ","jāa","comes","আসবে (সেদিন)"],["بِٱلْحَسَنَةِ","bil-ḥasanati","with the good","নিয়ে সৎ-কর্ম"],["فَلَهُۥ","falahu","then for him","তখন তার জন্যে (থাকবে)"],["خَيْرٌۭ","khayrun","(will be) better","উত্তম"],["مِّنْهَا","min'hā","than it","তার চেয়েও"],["وَهُم","wahum","and they","আর তারা"],["مِّن","min","from","হ'তে"],["فَزَعٍۢ","faza‘in","(the) terror","শঙ্কা"],["يَوْمَئِذٍ","yawma-idhin","(of) that Day","সেদিন"],["ءَامِنُونَ","āminūna","(will be) safe","নিরাপদ থাকবে"]],"t":"مَ<k>ن جَ</><o>آ</>ءَ بِ<h>ٱ</>لْحَسَنَةِ فَلَهُ<m>ۥ</> خَيْ<d>رٌۭ مِّ</>نْهَا وَ<y>هُم مِّ</><k>ن فَ</>زَ<d>عٍۢ يَ</>وْمَئِذٍ ءَامِ<p>نُو</>نَ"},{"n":90,"w":[["وَمَن","waman","And whoever","এবং যে"],["جَآءَ","jāa","comes","আসবে"],["بِٱلسَّيِّئَةِ","bil-sayi-ati","with the evil","নিয়ে অসৎকর্ম"],["فَكُبَّتْ","fakubbat","will be cast down","তখন নিক্ষেপ করা হবে"],["وُجُوهُهُمْ","wujūhuhum","their faces","মুখ তাদের (উল্টোভাবে)"],["فِى","fī","in","মধ্যে"],["ٱلنَّارِ","l-nāri","the Fire","আগুনের"],["هَلْ","hal","Are","\"(তাদের বলা হবে) কি"],["تُجْزَوْنَ","tuj'zawna","you recompensed","প্রতিফল দেয়া হয়েছে তোমাদেরকে"],["إِلَّا","illā","except","এ ছাড়া"],["مَا","mā","(for) what","যা"],["كُنتُمْ","kuntum","you used (to)","তোমরা ছিলে"],["تَعْمَلُونَ","ta‘malūna","do","তোমরা কাজ করতে\""]],"t":"وَمَ<k>ن جَ</><o>آ</>ءَ بِ<h>ٱ</><l>ل</>سَّيِّئَةِ فَكُبَّتْ وُجُوهُهُمْ فِى <h>ٱ</><l>ل</><g>نَّ</>ارِ هَلْ تُ<q>جْ</>زَوْنَ إِلَّا مَا كُ<k>نتُ</>مْ تَعْمَ<p>لُو</>نَ"},{"n":91,"w":[["إِنَّمَآ","innamā","Only","\"মূলত"],["أُمِرْتُ","umir'tu","I am commanded","আমি আদিষ্ট হয়েছি"],["أَنْ","an","that","যেন"],["أَعْبُدَ","a‘buda","I worship","ইবাদত করি আমি"],["رَبَّ","rabba","(the) Lord","রবের"],["هَـٰذِهِ","hādhihi","(of) this","এই"],["ٱلْبَلْدَةِ","l-baldati","city","শহরের (অর্থাৎ মাক্কার)"],["ٱلَّذِى","alladhī","the One Who","যিনি"],["حَرَّمَهَا","ḥarramahā","made it sacred","সম্মানিত করেছেন তা"],["وَلَهُۥ","walahu","and to Him (belongs)","এবং জন্যে  তাঁরই (মালিকানায়)"],["كُلُّ","kullu","all","প্রত্যেক"],["شَىْءٍۢ ۖ","shayin","things","বস্তু"],["وَأُمِرْتُ","wa-umir'tu","And I am commanded","এবং আমি আদিষ্ট হয়েছি"],["أَنْ","an","that","যেন"],["أَكُونَ","akūna","I be","আমি হই"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْمُسْلِمِينَ","l-mus'limīna","the Muslims","আত্মসমর্পণকারীদের"]],"t":"إِ<g>نَّ</><o>مَآ</> أُمِرْتُ أَنْ أَعْبُدَ رَبَّ <m>هَٰ</>ذِهِ <h>ٱ</>لْبَلْدَةِ <h>ٱ</>لَّذِى حَرَّمَهَا وَلَهُ<m>ۥ</> كُلُّ <d>شَىْءٍۢ ۖ وَ</>أُمِرْتُ أَنْ أَكُونَ مِنَ <h>ٱ</>لْمُسْلِ<p>مِي</>نَ"},{"n":92,"w":[["وَأَنْ","wa-an","And that","(এও)এবং যে"],["أَتْلُوَا۟","atluwā","I recite","আমি তিলাওয়াত করবো"],["ٱلْقُرْءَانَ ۖ","l-qur'āna","the Quran","কুরআন\""],["فَمَنِ","famani","And whoever","অতএব যে"],["ٱهْتَدَىٰ","ih'tadā","accepts guidance","সৎপথ অবলম্বন করবে"],["فَإِنَّمَا","fa-innamā","then only","শুধুমাত্র"],["يَهْتَدِى","yahtadī","he accepts guidance","সে সৎপথ অবলম্বন করবে"],["لِنَفْسِهِۦ ۖ","linafsihi","for himself","জন্যে নিজের তার"],["وَمَن","waman","and whoever","আর যে"],["ضَلَّ","ḍalla","goes astray","ভ্রান্তপথ অবলম্বন করবে"],["فَقُلْ","faqul","then say","অতঃপর বলো"],["إِنَّمَآ","innamā","Only","\"শুধুমাত্র"],["أَنَا۠","anā","I am","আমি"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْمُنذِرِينَ","l-mundhirīna","the warners","সতর্ককারীদের\""]],"t":"وَأَنْ أَتْلُوَ<s>ا۟</> <h>ٱ</>لْقُرْءَانَ ۖ فَمَنِ <h>ٱ</>هْتَدَىٰ فَإِ<g>نَّ</>مَا يَهْتَدِى لِنَفْسِ<m>هِۦ</> ۖ وَمَ<k>ن ضَ</>لَّ فَقُلْ إِ<g>نَّ</><o>مَآ</> أَنَا۠ مِنَ <h>ٱ</>لْمُ<k>نذِ</><p>رِي</>نَ"},{"n":93,"w":[["وَقُلِ","waquli","And say","এবং বলো"],["ٱلْحَمْدُ","l-ḥamdu","All praise (be)","\"সব প্রশংসা"],["لِلَّهِ","lillahi","to Allah","জন্যে আল্লাহরই"],["سَيُرِيكُمْ","sayurīkum","He will show you","শীঘ্রই তিনি দেখাবেন তোমাদেরকে"],["ءَايَـٰتِهِۦ","āyātihi","His Signs","নিদের্শনাবলী তাঁর"],["فَتَعْرِفُونَهَا ۚ","fata‘rifūnahā","and you will recognize them","তখন তোমরা চিনে নিবে সব তা"],["وَمَا","wamā","And your Lord is not","আর নন"],["رَبُّكَ","rabbuka","And your Lord is not","তোমার রব"],["بِغَـٰفِلٍ","bighāfilin","unaware","অমনোযোগী"],["عَمَّا","‘ammā","of what","সে সম্পর্কে যা"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা কাজ করছো\""]],"t":"وَقُلِ <h>ٱ</>لْحَمْدُ لِلَّهِ سَيُرِيكُمْ ءَا<m>يَٰتِهِۦ</> فَتَعْرِفُونَهَا ۚ وَمَا رَبُّكَ بِ<m>غَٰ</>فِلٍ عَ<g>مَّ</>ا تَعْمَ<p>لُو</>نَ"}]}