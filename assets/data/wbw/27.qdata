{"n":27,"a":[{"n":1,"w":[["طسٓ ۚ","tta-seen","Ta Seen","ত্বা-সীন"],["تِلْكَ","til'ka","These","এই"],["ءَايَـٰتُ","āyātu","(are the) Verses","আয়াতসমূহ"],["ٱلْقُرْءَانِ","l-qur'āni","(of) the Quran","কুরআনের"],["وَكِتَابٍۢ","wakitābin","and a Book","ও কিতাবের"],["مُّبِينٍ","mubīnin","clear","(যা) সুস্পষ্ট"]],"t":"ط<n>سٓ</> ۚ تِلْكَ ءَا<m>يَٰ</>تُ <h>ٱ</>لْقُرْءَانِ وَكِتَا<d>بٍۢ مُّ</><p>بِي</>نٍ"},{"n":2,"w":[["هُدًۭى","hudan","A guidance","(এটা) পথ নির্দেশ"],["وَبُشْرَىٰ","wabush'rā","and glad tidings","ও সুসংবাদ"],["لِلْمُؤْمِنِينَ","lil'mu'minīna","for the believers","জন্যে মু'মিনদের"]],"t":"هُ<d>دًۭى وَ</>بُشْرَىٰ لِلْمُؤْمِ<p>نِي</>نَ"},{"n":3,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["يُقِيمُونَ","yuqīmūna","establish","প্রতিষ্ঠা করে"],["ٱلصَّلَوٰةَ","l-ṣalata","the prayer","সালাত"],["وَيُؤْتُونَ","wayu'tūna","and give","ও আদায় করে"],["ٱلزَّكَوٰةَ","l-zakata","zakah","যাকাত"],["وَهُم","wahum","and they","এবং তারা"],["بِٱلْـَٔاخِرَةِ","bil-ākhirati","in the Hereafter","উপর আখেরাতের"],["هُمْ","hum","[they]","তারা"],["يُوقِنُونَ","yūqinūna","believe with certainty","দৃঢ় বিশ্বাস রাখে"]],"t":"ٱلَّذِينَ يُقِيمُونَ <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةَ وَيُؤْتُونَ <h>ٱ</><l>ل</>زَّكَ<s>وٰ</>ةَ وَ<f>هُم بِ</><h>ٱ</>لْءَاخِرَةِ هُمْ يُوقِ<p>نُو</>نَ"},{"n":4,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["لَا","lā","(do) not","না"],["يُؤْمِنُونَ","yu'minūna","believe","বিশ্বাস করে"],["بِٱلْـَٔاخِرَةِ","bil-ākhirati","in the Hereafter","উপর আখেরাতের"],["زَيَّنَّا","zayyannā","We have made fair-seeming","আমরা সুশোভন করেছি"],["لَهُمْ","lahum","to them","জন্যে তাদের"],["أَعْمَـٰلَهُمْ","a‘mālahum","their deeds","কাজকর্মসমূহকে তাদের"],["فَهُمْ","fahum","so they","ফলে তারা"],["يَعْمَهُونَ","ya‘mahūna","wander blindly","বিভ্রান্তিতে ঘুরে বেড়াচ্ছে"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ لَا يُؤْمِنُونَ بِ<h>ٱ</>لْءَاخِرَةِ زَيَّ<g>نَّ</>ا لَهُمْ أَعْ<m>مَٰ</>لَهُمْ فَهُمْ يَعْمَ<p>هُو</>نَ"},{"n":5,"w":[["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব (লোক)"],["ٱلَّذِينَ","alladhīna","(are) the ones","তারাই"],["لَهُمْ","lahum","for them","জন্যে যাদের (রয়েছে)"],["سُوٓءُ","sūu","(is) an evil","(অত্যন্ত) খারাপ"],["ٱلْعَذَابِ","l-‘adhābi","[the] punishment","শাস্তি"],["وَهُمْ","wahum","and they","এবং তারা হবে"],["فِى","fī","in","মধ্যে"],["ٱلْـَٔاخِرَةِ","l-ākhirati","the Hereafter","আখেরাতে"],["هُمُ","humu","[they]","তারাই"],["ٱلْأَخْسَرُونَ","l-akhsarūna","(will be) the greatest losers","সর্বাধিক ক্ষতিগ্রস্ত"]],"t":"أُ<s>و۟</><o>لَٰٓ</>ئِكَ <h>ٱ</>لَّذِينَ لَهُمْ <o>سُوٓ</>ءُ <h>ٱ</>لْعَذَابِ وَهُمْ فِى <h>ٱ</>لْءَاخِرَةِ هُمُ <h>ٱ</>لْأَخْسَ<p>رُو</>نَ"},{"n":6,"w":[["وَإِنَّكَ","wa-innaka","And indeed, you","আর (হে নাবী) নিশ্চয়ই তুমি"],["لَتُلَقَّى","latulaqqā","surely, receive","অবশ্যই লাভ করেছো"],["ٱلْقُرْءَانَ","l-qur'āna","the Quran","(এই) কুরআন"],["مِن","min","from [near]","হ'তে"],["لَّدُنْ","ladun","from [near]","পক্ষ"],["حَكِيمٍ","ḥakīmin","the All-Wise","মহাবিজ্ঞ"],["عَلِيمٍ","‘alīmin","the All-Knower","সর্বাধিক জ্ঞানী (আল্লাহর)"]],"t":"وَإِ<g>نَّ</>كَ لَتُلَقَّى <h>ٱ</>لْقُرْءَانَ <w>مِن لَّ</>دُنْ حَكِيمٍ عَ<p>لِي</>مٍ"},{"n":7,"w":[["إِذْ","idh","When","(স্মরণ করো) যখন"],["قَالَ","qāla","said","বলেছিলো"],["مُوسَىٰ","mūsā","Musa","মূসা"],["لِأَهْلِهِۦٓ","li-ahlihi","to his family","উদ্দেশ্যে তার পরিবারের"],["إِنِّىٓ","innī","Indeed, I","\"নিশ্চয়ই আমি"],["ءَانَسْتُ","ānastu","perceive","দেখেছি"],["نَارًۭا","nāran","a fire","আগুন"],["سَـَٔاتِيكُم","saātīkum","I will bring you","অচিরেই তোমাদের (কাছে) আসবো আমি"],["مِّنْهَا","min'hā","from it","তা হ'তে"],["بِخَبَرٍ","bikhabarin","some information","নিয়ে কোনো সংবাদ"],["أَوْ","aw","or","অথবা"],["ءَاتِيكُم","ātīkum","I will bring you","তোমাদের (কাছে) আসবো আমি"],["بِشِهَابٍۢ","bishihābin","a torch","নিয়ে জ্বলন্ত"],["قَبَسٍۢ","qabasin","burning","অঙ্গার"],["لَّعَلَّكُمْ","la‘allakum","so that you may","যাতে তোমরা"],["تَصْطَلُونَ","taṣṭalūna","warm yourselves","আগুন পোহাতে পারো\""]],"t":"إِذْ قَالَ مُوسَىٰ لِأَهْلِ<o>هِۦٓ</> إِ<g>نِّ</><o>ىٓ</> ءَانَسْتُ نَا<k>رًۭا سَـَٔ</>اتِي<y>كُم مِّ</>نْهَا بِخَبَرٍ أَوْ ءَاتِي<f>كُم بِ</>شِهَا<k>بٍۢ قَ</>بَ<w>سٍۢ لَّ</>عَلَّكُمْ تَصْطَ<p>لُو</>نَ"},{"n":8,"w":[["فَلَمَّا","falammā","But when","অতঃপর যখন"],["جَآءَهَا","jāahā","he came to it","সেখানে সে আসলো"],["نُودِىَ","nūdiya","he was called","ডাক দেয়া হলো"],["أَنۢ","an","[that]","যে"],["بُورِكَ","būrika","Blessed is","\"সে হয়েছে ধন্য"],["مَن","man","who","যে (আছে)"],["فِى","fī","(is) at","মধ্যে"],["ٱلنَّارِ","l-nāri","the fire","আগুনের (আলোর)"],["وَمَنْ","waman","and whoever","এবং যে (আছে)"],["حَوْلَهَا","ḥawlahā","(is) around it","তার চারপাশে"],["وَسُبْحَـٰنَ","wasub'ḥāna","And glory be","এবং পবিত্র মহান"],["ٱللَّهِ","l-lahi","(to) Allah","আল্লাহ"],["رَبِّ","rabbi","(the) Lord","রব"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","(of) the worlds","বিশ্বজগতের"]],"t":"فَلَ<g>مَّ</>ا <o>جَآ</>ءَهَا نُودِىَ <i>أَنۢ بُ</>ورِكَ مَ<k>ن فِ</>ى <h>ٱ</><l>ل</><g>نَّ</>ارِ وَمَنْ حَوْلَهَا وَسُ<q>بْ</><m>حَٰ</>نَ <h>ٱ</>للَّهِ رَبِّ <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":9,"w":[["يَـٰمُوسَىٰٓ","yāmūsā","O Musa","হে মূসা (প্রকৃত ব্যাপার হলো)"],["إِنَّهُۥٓ","innahu","Indeed","নিশ্চয়ই তিনি"],["أَنَا","anā","I Am","আমি"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["ٱلْعَزِيزُ","l-‘azīzu","the All-Mighty","মহাপরাক্রমশালী"],["ٱلْحَكِيمُ","l-ḥakīmu","the All-Wise","প্রজ্ঞামময়\""]],"t":"<m>يَٰ</>مُوسَ<o>ىٰٓ</> إِ<g>نَّ</>هُ<o>ۥٓ</> أَنَا <h>ٱ</>للَّهُ <h>ٱ</>لْعَزِيزُ <h>ٱ</>لْحَ<p>كِي</>مُ"},{"n":10,"w":[["وَأَلْقِ","wa-alqi","And, \"Throw","আর (হে মূসা) তুমি ছোঁড়ো"],["عَصَاكَ ۚ","‘aṣāka","your staff","তোমার লাঠি\""],["فَلَمَّا","falammā","But when","অতঃপর যখন"],["رَءَاهَا","raāhā","he saw it","সে দেখলো তা"],["تَهْتَزُّ","tahtazzu","moving","গড়িয়ে চলছে"],["كَأَنَّهَا","ka-annahā","as if it","যেন তা"],["جَآنٌّۭ","jānnun","(were) a snake","সাপ"],["وَلَّىٰ","wallā","he turned back","সে ফিরে পালালো"],["مُدْبِرًۭا","mud'biran","(in) flight","পিছন দিকে"],["وَلَمْ","walam","and (did) not","আর না"],["يُعَقِّبْ ۚ","yu‘aqqib","look back","পিছন দিকে দেখলো"],["يَـٰمُوسَىٰ","yāmūsā","O Musa","\"(বলা হলো) হে মূসা"],["لَا","lā","(Do) not","না"],["تَخَفْ","takhaf","fear","ভয় করো"],["إِنِّى","innī","Indeed, [I]","আমি নিশ্চয়ই (এমন যে)"],["لَا","lā","(do) not","না"],["يَخَافُ","yakhāfu","fear","ভয় করে"],["لَدَىَّ","ladayya","(in) My presence","নিকট আমার"],["ٱلْمُرْسَلُونَ","l-mur'salūna","the Messengers","রাসূলরা"]],"t":"وَأَلْقِ عَصَاكَ ۚ فَلَ<g>مَّ</>ا رَءَاهَا تَهْتَزُّ كَأَ<g>نَّ</>هَا <n>جَآ</><g>نٌّۭ</> وَلَّىٰ مُ<q>دْ</>بِ<d>رًۭا وَ</>لَمْ يُعَقِّ<q>بْ</> ۚ <m>يَٰ</>مُوسَىٰ لَا تَخَفْ إِ<g>نِّ</>ى لَا يَخَافُ لَدَىَّ <h>ٱ</>لْمُرْسَ<p>لُو</>نَ"},{"n":11,"w":[["إِلَّا","illā","Except","কিন্তু"],["مَن","man","who","যে"],["ظَلَمَ","ẓalama","wrongs","সীমালঙ্ঘন করে"],["ثُمَّ","thumma","then","এরপর"],["بَدَّلَ","baddala","substitutes","বদলে নেয় (নিজের কর্মকে)"],["حُسْنًۢا","ḥus'nan","good","সৎকর্ম (দিয়ে)"],["بَعْدَ","ba‘da","after","পরে"],["سُوٓءٍۢ","sūin","evil","মন্দ কর্মের"],["فَإِنِّى","fa-innī","then indeed, I Am","সেক্ষেত্রে আমি নিশ্চয়ই"],["غَفُورٌۭ","ghafūrun","Oft-Forgiving","ক্ষমাশীল"],["رَّحِيمٌۭ","raḥīmun","Most Merciful","পরম দয়ালু"]],"t":"إِلَّا مَ<k>ن ظَ</>لَمَ ثُ<g>مَّ</> بَدَّلَ حُسْ<i>نًۢا بَ</>عْدَ <o>سُوٓ</><k>ءٍۢ فَ</>إِ<g>نِّ</>ى غَفُو<w>رٌۭ رَّ</><p>حِي</>مٌۭ"},{"n":12,"w":[["وَأَدْخِلْ","wa-adkhil","And enter","এবং (হে মূসা) প্রবেশ করাও"],["يَدَكَ","yadaka","your hand","তোমার হাত"],["فِى","fī","into","মধ্যে"],["جَيْبِكَ","jaybika","your bosom","তোমার বক্ষপাশে (অর্থাৎ বগলে)"],["تَخْرُجْ","takhruj","it will come forth","তা বের হয়ে আসবে"],["بَيْضَآءَ","bayḍāa","white","শুভ্র উজ্জ্বল হয়ে"],["مِنْ","min","without","কোনো"],["غَيْرِ","ghayri","without","ছাড়াই"],["سُوٓءٍۢ ۖ","sūin","harm","অনিষ্ট"],["فِى","fī","(These are) among","(এটা) অন্তর্গত"],["تِسْعِ","tis'‘i","nine","নয়টি"],["ءَايَـٰتٍ","āyātin","signs","নিদর্শনের"],["إِلَىٰ","ilā","to","(এ নিয়ে যাও) প্রতি"],["فِرْعَوْنَ","fir'‘awna","Firaun","ফিরআউনের"],["وَقَوْمِهِۦٓ ۚ","waqawmihi","and his people","ও তার জাতির (কাছে)"],["إِنَّهُمْ","innahum","Indeed, they","তারা নিশ্চয়ই"],["كَانُوا۟","kānū","are","হলো"],["قَوْمًۭا","qawman","a people","লোক"],["فَـٰسِقِينَ","fāsiqīna","defiantly disobedient","(দুষ্কর্মপরায়ন) সত্য-ত্যাগী\""]],"t":"وَأَ<q>دْ</>خِلْ يَدَكَ فِى جَيْبِكَ تَخْرُ<q>جْ</> بَيْ<o>ضَآ</>ءَ مِنْ غَيْرِ <o>سُوٓ</><k>ءٍۢ ۖ فِ</>ى تِسْعِ ءَا<m>يَٰ</>تٍ إِلَىٰ فِرْعَوْنَ وَقَوْمِ<o>هِۦٓ ۚ</> إِ<g>نَّ</>هُمْ كَانُو<s>ا۟</> قَوْ<k>مًۭا فَٰ</>سِ<p>قِي</>نَ"},{"n":13,"w":[["فَلَمَّا","falammā","But when","অতঃপর যখন"],["جَآءَتْهُمْ","jāathum","came to them","তাদের (নিকট) আসলো"],["ءَايَـٰتُنَا","āyātunā","Our Signs","নিদর্শনাবলী আমাদের"],["مُبْصِرَةًۭ","mub'ṣiratan","visible","উজ্জ্বল হয়ে"],["قَالُوا۟","qālū","they said","তারা বললো"],["هَـٰذَا","hādhā","This","\"এটা"],["سِحْرٌۭ","siḥ'run","(is) a magic","জাদু"],["مُّبِينٌۭ","mubīnun","manifest","সুস্পষ্ট\""]],"t":"فَلَ<g>مَّ</>ا <o>جَآ</>ءَتْهُمْ ءَا<m>يَٰ</>تُنَا مُ<q>بْ</>صِرَ<k>ةًۭ قَ</>الُو<s>ا۟</> <m>هَٰ</>ذَا سِحْ<d>رٌۭ مُّ</><p>بِي</>نٌۭ"},{"n":14,"w":[["وَجَحَدُوا۟","wajaḥadū","And they rejected","এবং তারা প্রত্যাখ্যান করলো"],["بِهَا","bihā","them","প্রতি সেগুলোর"],["وَٱسْتَيْقَنَتْهَآ","wa-is'tayqanathā","though were convinced with them (signs)","অথচ সেগুলো মেনে নিয়েছিলো"],["أَنفُسُهُمْ","anfusuhum","themselves","তাদের অন্তরগুলো (কিন্তু অমান্য করলো)"],["ظُلْمًۭا","ẓul'man","(out of) injustice","অন্যায়ভাবে"],["وَعُلُوًّۭا ۚ","wa‘uluwwan","and haughtiness","ও অহংকারবশত"],["فَٱنظُرْ","fa-unẓur","So see","তাই দেখো"],["كَيْفَ","kayfa","how","কেমন"],["كَانَ","kāna","was","ছিলো"],["عَـٰقِبَةُ","‘āqibatu","(the) end","পরিণাম"],["ٱلْمُفْسِدِينَ","l-muf'sidīna","(of) the corrupters","বিপর্যয় সৃষ্টিকারীদের"]],"t":"وَجَحَدُو<s>ا۟</> بِهَا وَ<h>ٱ</>سْتَيْقَنَتْ<o>هَآ</> أَ<k>نفُ</>سُهُمْ ظُلْ<d>مًۭا وَ</>عُلُ<k>وًّۭا ۚ فَ</><h>ٱ</><k>نظُ</>رْ كَيْفَ كَانَ <m>عَٰ</>قِبَةُ <h>ٱ</>لْمُفْسِ<p>دِي</>نَ"},{"n":15,"w":[["وَلَقَدْ","walaqad","And verily","এবং নিশ্চয়ই"],["ءَاتَيْنَا","ātaynā","We gave","দান করেছিলাম আমরা"],["دَاوُۥدَ","dāwūda","Dawood","দাউদকে"],["وَسُلَيْمَـٰنَ","wasulaymāna","and Sulaiman","ও সুলায়মানকে"],["عِلْمًۭا ۖ","‘il'man","knowledge","জ্ঞান"],["وَقَالَا","waqālā","and they said","এবং তারা দু'জনে বলেছিলো"],["ٱلْحَمْدُ","l-ḥamdu","Praise be","\"সব প্রশংসা"],["لِلَّهِ","lillahi","to Allah","জন্যে আল্লাহর"],["ٱلَّذِى","alladhī","the One Who","যিনি"],["فَضَّلَنَا","faḍḍalanā","has favored us","শ্রেষ্টত্ব দিয়েছেন আমাদেরকে"],["عَلَىٰ","‘alā","over","উপর"],["كَثِيرٍۢ","kathīrin","many","অনেকের"],["مِّنْ","min","of","মধ্য হ'তে"],["عِبَادِهِ","‘ibādihi","His servants","দাসদের"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believers","মু'মিন\""]],"t":"وَلَقَ<q>دْ</> ءَاتَيْنَا دَاوُ<m>ۥ</>دَ وَسُلَيْ<m>مَٰ</>نَ عِلْ<d>مًۭا ۖ وَ</>قَالَا <h>ٱ</>لْحَمْدُ لِلَّهِ <h>ٱ</>لَّذِى فَضَّلَنَا عَلَىٰ كَثِي<d>رٍۢ مِّ</>نْ عِبَادِهِ <h>ٱ</>لْمُؤْمِ<p>نِي</>نَ"},{"n":16,"w":[["وَوَرِثَ","wawaritha","And inherited","এবং উত্তরাধিকারী হয়েছে"],["سُلَيْمَـٰنُ","sulaymānu","Sulaiman","সুলায়মান"],["دَاوُۥدَ ۖ","dāwūda","Dawood","দাউদের"],["وَقَالَ","waqāla","And he said","এবং (সুলাইমান) বলেছিলো"],["يَـٰٓأَيُّهَا","yāayyuhā","O","\"হে"],["ٱلنَّاسُ","l-nāsu","people","মানুষ"],["عُلِّمْنَا","‘ullim'nā","We have been taught","শিখানো হয়েছে আমাদেরকে"],["مَنطِقَ","manṭiqa","(the) language","ভাষা"],["ٱلطَّيْرِ","l-ṭayri","(of) the birds","পাখীদের"],["وَأُوتِينَا","waūtīnā","and we have been given","এবং দেয়া হয়েছে আমাদেরকে"],["مِن","min","from","থেকে"],["كُلِّ","kulli","every","সব"],["شَىْءٍ ۖ","shayin","thing","কিছুই"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["هَـٰذَا","hādhā","this","এটা"],["لَهُوَ","lahuwa","surely, it","অবশ্যই তা"],["ٱلْفَضْلُ","l-faḍlu","(is) the favor","অনুগ্রহ"],["ٱلْمُبِينُ","l-mubīnu","evident","সুস্পষ্ট\""]],"t":"وَوَرِثَ سُلَيْ<m>مَٰ</>نُ دَاوُ<m>ۥ</>دَ ۖ وَقَالَ <o>يَٰٓ</>أَيُّهَا <h>ٱ</><l>ل</><g>نَّ</>اسُ عُلِّمْنَا مَ<k>نطِ</>قَ <h>ٱ</><l>ل</>طَّيْرِ وَأُوتِينَا مِ<k>ن كُ</>لِّ شَىْءٍ ۖ إِ<g>نَّ</> <m>هَٰ</>ذَا لَهُوَ <h>ٱ</>لْفَضْلُ <h>ٱ</>لْمُ<p>بِي</>نُ"},{"n":17,"w":[["وَحُشِرَ","waḥushira","And were gathered","আর একত্র করা হয়েছিলো"],["لِسُلَيْمَـٰنَ","lisulaymāna","for Sulaiman","জন্যে সুলায়মানের"],["جُنُودُهُۥ","junūduhu","his hosts","সৈন্যবাহিনী তার"],["مِنَ","mina","of","মধ্য হ'তে"],["ٱلْجِنِّ","l-jini","jinn","জিনদের"],["وَٱلْإِنسِ","wal-insi","and the men","ও মানুষদের"],["وَٱلطَّيْرِ","wal-ṭayri","and the birds","এবং পাখীদের (মধ্য হ'তেও)"],["فَهُمْ","fahum","and they","অতঃপর তাদেরকে"],["يُوزَعُونَ","yūza‘ūna","(were) set in rows","বিন্যস্ত করা হতো (বিভিন্ন বুহ্যে)"]],"t":"وَحُشِرَ لِسُلَيْ<m>مَٰ</>نَ جُنُودُهُ<m>ۥ</> مِنَ <h>ٱ</>لْجِ<g>نِّ</> وَ<h>ٱ</>لْإِ<k>نسِ</> وَ<h>ٱ</><l>ل</>طَّيْرِ فَهُمْ يُوزَ<p>عُو</>نَ"},{"n":18,"w":[["حَتَّىٰٓ","ḥattā","Until","শেষ পর্যন্ত (এক যাত্রায়)"],["إِذَآ","idhā","when","যখন"],["أَتَوْا۟","ataw","they came","পৌঁছুল"],["عَلَىٰ","‘alā","to","নিকট"],["وَادِ","wādi","(the) valley","উপত্যকার"],["ٱلنَّمْلِ","l-namli","(of) the ants","পিঁপড়েদের"],["قَالَتْ","qālat","said","(তখন) বললো"],["نَمْلَةٌۭ","namlatun","an ant","এক পিঁপড়ে"],["يَـٰٓأَيُّهَا","yāayyuhā","O","\"হে"],["ٱلنَّمْلُ","l-namlu","ants","পিঁপড়েরা (দল)"],["ٱدْخُلُوا۟","ud'khulū","Enter","তোমরা ঢোকো"],["مَسَـٰكِنَكُمْ","masākinakum","your dwellings","ঘরে তোমাদের"],["لَا","lā","lest not crush you","না (যেন)"],["يَحْطِمَنَّكُمْ","yaḥṭimannakum","lest not crush you","পিষে ফেলে তোমাদেরকে"],["سُلَيْمَـٰنُ","sulaymānu","Sulaiman","সুলায়মান"],["وَجُنُودُهُۥ","wajunūduhu","and his hosts","ও সৈন্যবাহিনী তার"],["وَهُمْ","wahum","while they","এমতাবস্হায় যে তারা"],["لَا","lā","(do) not perceive","না\""],["يَشْعُرُونَ","yash‘urūna","(do) not perceive","টেরও পাবে\""]],"t":"حَتَّ<o>ىٰٓ</> إِ<o>ذَآ</> أَتَوْ<s>ا۟</> عَلَىٰ وَادِ <h>ٱ</><l>ل</><g>نَّ</>مْلِ قَالَتْ نَمْلَ<d>ةٌۭ يَٰٓ</>أَيُّهَا <h>ٱ</><l>ل</><g>نَّ</>مْلُ <h>ٱ</><q>دْ</>خُلُو<s>ا۟</> مَ<m>سَٰ</>كِنَكُمْ لَا يَحْطِمَ<g>نَّ</>كُمْ سُلَيْ<m>مَٰ</>نُ وَجُنُودُهُ<m>ۥ</> وَهُمْ لَا يَشْعُ<p>رُو</>نَ"},{"n":19,"w":[["فَتَبَسَّمَ","fatabassama","So he smiled ","তখন (সুলায়মান) মুচকি হাসলো"],["ضَاحِكًۭا","ḍāḥikan","laughing","হাসি"],["مِّن","min","at","কারণে"],["قَوْلِهَا","qawlihā","her speech","কথার তার"],["وَقَالَ","waqāla","and said","এবং বললো"],["رَبِّ","rabbi","My Lord","\"হে আমার রব"],["أَوْزِعْنِىٓ","awzi‘'nī","Grant me (the) power","সামর্থ্য দাও"],["أَنْ","an","that","যেন"],["أَشْكُرَ","ashkura","I may thank You","কৃতজ্ঞতা প্রকাশ করতে পারি আমি"],["نِعْمَتَكَ","ni‘'mataka","(for) Your Favor","অনুগ্রহের তোমার"],["ٱلَّتِىٓ","allatī","which","যা"],["أَنْعَمْتَ","an‘amta","You have bestowed","অনুগ্রহ করেছো তুমি"],["عَلَىَّ","‘alayya","on me","আমার উপর"],["وَعَلَىٰ","wa‘alā","and on","ও উপর"],["وَٰلِدَىَّ","wālidayya","my parents","আমার পিতা মাতার"],["وَأَنْ","wa-an","and that","এবং যেন"],["أَعْمَلَ","a‘mala","I may do","আমি করি"],["صَـٰلِحًۭا","ṣāliḥan","righteous (deeds)","(এমন) সৎ কাজ"],["تَرْضَىٰهُ","tarḍāhu","that will please You","যা পছন্দ করো তুমি"],["وَأَدْخِلْنِى","wa-adkhil'nī","And admit me","এবং অন্তর্ভুক্ত করো আমাকে"],["بِرَحْمَتِكَ","biraḥmatika","by Your Mercy","দ্বারা অনুগ্রহ তোমার"],["فِى","fī","among","মধ্যে"],["عِبَادِكَ","‘ibādika","Your slaves","তোমাদের দাসদের"],["ٱلصَّـٰلِحِينَ","l-ṣāliḥīna","righteous","(যারা) সৎকর্মপরায়ণ\""]],"t":"فَتَبَسَّمَ ضَاحِ<d>كًۭا مِّ</><k>ن قَ</>وْلِهَا وَقَالَ رَبِّ أَوْزِعْ<o>نِىٓ</> أَنْ أَشْكُرَ نِعْمَتَكَ <h>ٱ</>لَّ<o>تِىٓ</> أَنْعَمْتَ عَلَىَّ وَعَلَىٰ <m>وَٰ</>لِدَىَّ وَأَنْ أَعْمَلَ <m>صَٰ</>لِ<k>حًۭا تَ</>رْضَ<m>ىٰ</>هُ وَأَ<q>دْ</>خِلْنِى بِرَحْمَتِكَ فِى عِبَادِكَ <h>ٱ</><l>ل</><m>صَّٰ</>لِ<p>حِي</>نَ"},{"n":20,"w":[["وَتَفَقَّدَ","watafaqqada","And he inspected","এবং (একবার) সে সন্ধান নিলো"],["ٱلطَّيْرَ","l-ṭayra","the birds","পাখীকে (দলের)"],["فَقَالَ","faqāla","and said","অতঃপর বললো"],["مَا","mā","Why","\"কি (হলো)"],["لِىَ","liya","Why","\"আমার"],["لَآ","lā","not","না"],["أَرَى","arā","I see","দেখছি আমি"],["ٱلْهُدْهُدَ","l-hud'huda","the hoopoe","হুদহুদ পাখীকে"],["أَمْ","am","or","কি"],["كَانَ","kāna","is he","সে হয়েছে"],["مِنَ","mina","from","অন্তর্ভুক্ত"],["ٱلْغَآئِبِينَ","l-ghāibīna","the absent","অনুপস্থিতদের"]],"t":"وَتَفَقَّدَ <h>ٱ</><l>ل</>طَّيْرَ فَقَالَ مَا لِىَ <o>لَآ</> أَرَى <h>ٱ</>لْهُ<q>دْ</>هُدَ أَمْ كَانَ مِنَ <h>ٱ</>لْ<o>غَآ</>ئِ<p>بِي</>نَ"},{"n":21,"w":[["لَأُعَذِّبَنَّهُۥ","la-u‘adhibannahu","I will surely punish him","অবশ্যই শাস্তি দিবো আমি তাকে"],["عَذَابًۭا","‘adhāban","(with) a punishment","শাস্তি"],["شَدِيدًا","shadīdan","severe","কঠিন"],["أَوْ","aw","or","অথবা"],["لَأَا۟ذْبَحَنَّهُۥٓ","laādh'baḥannahu","I will surely slaughter him","অবশ্যই জবেহ করবোই আমি তাকে"],["أَوْ","aw","unless","অথবা"],["لَيَأْتِيَنِّى","layatiyannī","he brings me","অবশ্যই আমার কাছে আসবে"],["بِسُلْطَـٰنٍۢ","bisul'ṭānin","a reason","নিয়ে প্রমাণ"],["مُّبِينٍۢ","mubīnin","clear","সুস্পষ্ট\""]],"t":"لَأُعَذِّبَ<g>نَّ</>هُ<m>ۥ</> عَذَا<k>بًۭا شَ</>دِيدًا أَوْ لَأَ<s>ا۟</>ذْبَحَ<g>نَّ</>هُ<o>ۥٓ</> أَوْ لَيَأْتِيَ<g>نِّ</>ى بِسُلْ<m>طَٰ</><d>نٍۢ مُّ</><p>بِي</>نٍۢ"},{"n":22,"w":[["فَمَكَثَ","famakatha","So he stayed","অতঃপর (পাখীটি) অতিবাহিত করলো"],["غَيْرَ","ghayra","not","নয়"],["بَعِيدٍۢ","ba‘īdin","long","দৃঢ়ে (অতি অল্প সময়)"],["فَقَالَ","faqāla","and he said","অতঃপর বললো"],["أَحَطتُ","aḥaṭtu","I have encompassed","\"আমি অবগত হয়েছি"],["بِمَا","bimā","that which","ঐ বিষয়ে যা"],["لَمْ","lam","not","নি"],["تُحِطْ","tuḥiṭ","you have encompassed","আপনি অবগত হন"],["بِهِۦ","bihi","it","সম্পর্কে সে"],["وَجِئْتُكَ","waji'tuka","and I have come to you","এবং আপনার কাছে এসেছি"],["مِن","min","from","সম্পর্কে"],["سَبَإٍۭ","saba-in","Saba","সাবা'"],["بِنَبَإٍۢ","binaba-in","with news","নিয়ে (কিছু) তথ্য"],["يَقِينٍ","yaqīnin","certain","নিশ্চিত"]],"t":"فَمَكَثَ غَيْرَ بَعِي<k>دٍۢ فَ</>قَالَ أَحَطتُ بِمَا لَمْ تُحِ<q>طْ</> بِ<m>هِۦ</> وَجِئْتُكَ مِ<k>ن سَ</>بَ<i>إٍۭ بِ</>نَبَ<d>إٍۢ يَ</><p>قِي</>نٍ"},{"n":23,"w":[["إِنِّى","innī","Indeed, I","নিশ্চয়ই আমি"],["وَجَدتُّ","wajadttu","found","আমি (দেখতে) পেয়েছি"],["ٱمْرَأَةًۭ","im'ra-atan","a woman","একজন মহিলা"],["تَمْلِكُهُمْ","tamlikuhum","ruling them","শাসন করে সে তাদেরকে"],["وَأُوتِيَتْ","waūtiyat","and she has been given","এবং তাকে দেওয়া হয়েছে"],["مِن","min","of","থেকে"],["كُلِّ","kulli","every","সব"],["شَىْءٍۢ","shayin","thing","কিছুই"],["وَلَهَا","walahā","and for her","আর আছে তার"],["عَرْشٌ","‘arshun","(is) a throne","একটি সিংহাসন"],["عَظِيمٌۭ","‘aẓīmun","great","বিরাট"]],"t":"إِ<g>نِّ</>ى وَجَ<j>د</>تُّ <h>ٱ</>مْرَأَ<k>ةًۭ تَ</>مْلِكُهُمْ وَأُوتِيَتْ مِ<k>ن كُ</>لِّ <d>شَىْءٍۢ وَ</>لَهَا عَرْشٌ عَ<p>ظِي</>مٌۭ"},{"n":24,"w":[["وَجَدتُّهَا","wajadttuhā","And I found her","আমি (দেখতে) পেয়েছি তাকে"],["وَقَوْمَهَا","waqawmahā","and her people","ও জাতিকে তার"],["يَسْجُدُونَ","yasjudūna","prostrating","সিজদা করে তারা"],["لِلشَّمْسِ","lilshamsi","to the sun","উদ্দেশ্যে সূর্যের"],["مِن","min","instead of Allah","মধ্য হতে"],["دُونِ","dūni","instead of Allah","পরিবর্তে"],["ٱللَّهِ","l-lahi","instead of Allah","আল্লাহর"],["وَزَيَّنَ","wazayyana","and has made fair-seeming","এবং সুশোভন করেছে"],["لَهُمُ","lahumu","to them","কাছে তাদের"],["ٱلشَّيْطَـٰنُ","l-shayṭānu","the Shaitaan","শয়তান"],["أَعْمَـٰلَهُمْ","a‘mālahum","their deeds","কাজগুলোকে তাদের"],["فَصَدَّهُمْ","faṣaddahum","and averted them","অতঃপর বিরত করেছে তাদেরকে"],["عَنِ","‘ani","from","হ'তে"],["ٱلسَّبِيلِ","l-sabīli","the Way","(সৎ) পথ"],["فَهُمْ","fahum","so they","তাই তারা"],["لَا","lā","(are) not","না"],["يَهْتَدُونَ","yahtadūna","guided","(সৎ) পথ পায়"]],"t":"وَجَ<j>د</>تُّهَا وَقَوْمَهَا يَسْجُدُونَ لِلشَّمْسِ مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ وَزَيَّنَ لَهُمُ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نُ أَعْ<m>مَٰ</>لَهُمْ فَصَدَّهُمْ عَنِ <h>ٱ</><l>ل</>سَّبِيلِ فَهُمْ لَا يَهْتَ<p>دُو</>نَ"},{"n":25,"w":[["أَلَّا","allā","That not","(বিরত করেছে) যেন না"],["يَسْجُدُوا۟","yasjudū","they prostrate","তারা সিজদা করে"],["لِلَّهِ","lillahi","to Allah","উদ্দেশ্যে আল্লাহর"],["ٱلَّذِى","alladhī","the One Who","যিনি"],["يُخْرِجُ","yukh'riju","brings forth","বের করেন"],["ٱلْخَبْءَ","l-khaba-a","the hidden","লুকায়িত বস্তুকে"],["فِى","fī","in","মধ্যে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশমন্ডলীর"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীর"],["وَيَعْلَمُ","waya‘lamu","and knows","আর তিনি জানেন"],["مَا","mā","what","যা কিছু"],["تُخْفُونَ","tukh'fūna","you conceal","তোমরা গোপন করো"],["وَمَا","wamā","and what","এবং যা কিছু"],["تُعْلِنُونَ","tu‘'linūna","you declare","তোমরা প্রকাশ করো"]],"t":"أَلَّا يَسْجُدُو<s>ا۟</> لِلَّهِ <h>ٱ</>لَّذِى يُخْرِجُ <h>ٱ</>لْخَ<q>بْ</>ءَ فِى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ وَيَعْلَمُ مَا تُخْفُونَ وَمَا تُعْلِ<p>نُو</>نَ"},{"n":26,"w":[["ٱللَّهُ","al-lahu","Allah","আল্লাহ (এমন যে)"],["لَآ","lā","(there is) no","নেই"],["إِلَـٰهَ","ilāha","god","কোনো ইলাহ"],["إِلَّا","illā","but","ছাড়া"],["هُوَ","huwa","He","তিনি"],["رَبُّ","rabbu","(the) Lord","অধিপতি"],["ٱلْعَرْشِ","l-‘arshi","(of) the Throne","আরশের"],["ٱلْعَظِيمِ ۩‏","l-‘aẓīmi","the Great","মহান\""]],"t":"ٱللَّهُ <o>لَآ</> إِ<m>لَٰ</>هَ إِلَّا هُوَ رَبُّ <h>ٱ</>لْعَرْشِ <h>ٱ</>لْعَظِ<p>ي</>مِ ۩"},{"n":27,"w":[["۞ قَالَ","qāla","He said","(সুলায়মান) বললো"],["سَنَنظُرُ","sananẓuru","We will see","\"শীঘ্রই আমরা দেখবো"],["أَصَدَقْتَ","aṣadaqta","whether you speak (the) truth","কি তুমি সত্য বলেছো"],["أَمْ","am","or","না"],["كُنتَ","kunta","you are","তুমি"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْكَـٰذِبِينَ","l-kādhibīna","the liars","মিথ্যাবাদীদের"]],"t":"۞ قَالَ سَنَ<k>نظُ</>رُ أَصَدَ<q>قْ</>تَ أَمْ كُ<k>نتَ</> مِنَ <h>ٱ</>لْ<m>كَٰ</>ذِ<p>بِي</>نَ"},{"n":28,"w":[["ٱذْهَب","idh'hab","Go","তুমি যাও"],["بِّكِتَـٰبِى","bikitābī","with my letter","নিয়ে আমার চিঠি"],["هَـٰذَا","hādhā","this","এই"],["فَأَلْقِهْ","fa-alqih","and deliver it","অতঃপর অর্পণ করো তা"],["إِلَيْهِمْ","ilayhim","to them","নিকট তাদের"],["ثُمَّ","thumma","Then","এরপর"],["تَوَلَّ","tawalla","turn away","সরে দাঁড়াও"],["عَنْهُمْ","‘anhum","from them","হ'তে তাদের"],["فَٱنظُرْ","fa-unẓur","and see","অতঃপর লক্ষ্য করো"],["مَاذَا","mādhā","what","কি"],["يَرْجِعُونَ","yarji‘ūna","they return","প্রতিক্রিয়া দেখায়\""]],"t":"ٱذْهَب بِّكِ<m>تَٰ</>بِى <m>هَٰ</>ذَا فَأَلْقِهْ إِلَيْهِمْ ثُ<g>مَّ</> تَوَلَّ عَنْهُمْ فَ<h>ٱ</><k>نظُ</>رْ مَاذَا يَرْجِ<p>عُو</>نَ"},{"n":29,"w":[["قَالَتْ","qālat","She said","(রানী) বললো"],["يَـٰٓأَيُّهَا","yāayyuhā","O","\"হে"],["ٱلْمَلَؤُا۟","l-mala-u","chiefs","সভাসদবৃন্দ"],["إِنِّىٓ","innī","Indeed [I]","নিশ্চয়ই আমাকে"],["أُلْقِىَ","ul'qiya","is delivered","অর্পণ করা হয়েছে"],["إِلَىَّ","ilayya","to me","আমার প্রতি"],["كِتَـٰبٌۭ","kitābun","a letter","একটি চিঠি"],["كَرِيمٌ","karīmun","noble","সম্মানিত"]],"t":"قَالَتْ <o>يَٰٓ</>أَيُّهَا <h>ٱ</>لْمَلَؤُ<s>ا۟</> إِ<g>نِّ</><o>ىٓ</> أُلْقِىَ إِلَىَّ كِ<m>تَٰ</><k>بٌۭ كَ</><p>رِي</>مٌ"},{"n":30,"w":[["إِنَّهُۥ","innahu","Indeed, it","নিশ্চয় তা (এসেছে)"],["مِن","min","(is) from","হ'তে"],["سُلَيْمَـٰنَ","sulaymāna","Sulaiman","সুলায়মান"],["وَإِنَّهُۥ","wa-innahu","and indeed it (is)","এবং নিশ্চয় তা (শুরু হয়েছে)"],["بِسْمِ","bis'mi","In the name","\"দিয়ে নাম"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["ٱلرَّحْمَـٰنِ","l-raḥmāni","the Most Gracious","দয়াময়"],["ٱلرَّحِيمِ","l-raḥīmi","the Most Merciful","পরম দয়ালু"]],"t":"إِ<g>نَّ</>هُ<m>ۥ</> مِ<k>ن سُ</>لَيْ<m>مَٰ</>نَ وَإِ<g>نَّ</>هُ<m>ۥ</> بِسْمِ <h>ٱ</>للَّهِ <h>ٱ</><l>ل</>رَّحْ<m>مَٰ</>نِ <h>ٱ</><l>ل</>رَّ<p>حِي</>مِ"},{"n":31,"w":[["أَلَّا","allā","That not","(তা এই) যে না"],["تَعْلُوا۟","ta‘lū","exalt yourselves","তোমরা বিদ্রোহ করো"],["عَلَىَّ","‘alayya","against me","আমার বিরুদ্ধে"],["وَأْتُونِى","watūnī","but come to me","এবং আমার (নিকট) চলে এসো"],["مُسْلِمِينَ","mus'limīna","(in) submission","আত্মসমর্পণকারী হয়ে\""]],"t":"أَلَّا تَعْلُو<s>ا۟</> عَلَىَّ وَأْتُونِى مُسْلِ<p>مِي</>نَ"},{"n":32,"w":[["قَالَتْ","qālat","She said","(রাণী) বললো"],["يَـٰٓأَيُّهَا","yāayyuhā","O","\"হে"],["ٱلْمَلَؤُا۟","l-mala-u","chiefs","সভাসদবৃন্দ"],["أَفْتُونِى","aftūnī","Advise me","তোমরা আমাকে অভিমত দাও"],["فِىٓ","fī","in","ব্যাপারে"],["أَمْرِى","amrī","my affair","আমার কাজের"],["مَا","mā","Not","না"],["كُنتُ","kuntu","I would be","আমি ছিলাম"],["قَاطِعَةً","qāṭi‘atan","the one to decide","চূড়ান্ত মীমাংসাকারী"],["أَمْرًا","amran","any matter","কোনো কাজে"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["تَشْهَدُونِ","tashhadūni","you are present with me","তোমরা আমার সামনে উপস্থিত থাকো (পরামর্শে)\""]],"t":"قَالَتْ <o>يَٰٓ</>أَيُّهَا <h>ٱ</>لْمَلَؤُ<s>ا۟</> أَفْتُونِى <o>فِىٓ</> أَمْرِى مَا كُ<k>نتُ</> قَاطِعَةً أَمْرًا حَتَّىٰ تَشْهَ<p>دُو</>نِ"},{"n":33,"w":[["قَالُوا۟","qālū","They said","(সভাসদবৃন্দ) বললো"],["نَحْنُ","naḥnu","We","\"আমরা"],["أُو۟لُوا۟","ulū","(are) possessors","অধিকারী"],["قُوَّةٍۢ","quwwatin","(of) strength","শক্তির (অর্থাৎ বড় শক্তিশালী)"],["وَأُو۟لُوا۟","wa-ulū","and possessors","ও (দক্ষতার) অধিকারী"],["بَأْسٍۢ","basin","(of) might","যুদ্ধ বিগ্রহে"],["شَدِيدٍۢ","shadīdin","great","কঠোর"],["وَٱلْأَمْرُ","wal-amru","and the command","তবে (সিদ্ধান্তের) কাজ"],["إِلَيْكِ","ilayki","(is) up to you","কাছে আপনারই"],["فَٱنظُرِى","fa-unẓurī","so look","তাই ভেবে দেখুন"],["مَاذَا","mādhā","what","কি"],["تَأْمُرِينَ","tamurīna","you will command","নির্দেশ দিবেন\""]],"t":"قَالُو<s>ا۟</> نَحْنُ أُ<s>و۟</>لُو<s>ا۟</> قُوَّ<d>ةٍۢ وَ</>أُ<s>و۟</>لُو<s>ا۟</> بَأْ<k>سٍۢ شَ</>دِي<d>دٍۢ وَ</><h>ٱ</>لْأَمْرُ إِلَيْكِ فَ<h>ٱ</><k>نظُ</>رِى مَاذَا تَأْمُ<p>رِي</>نَ"},{"n":34,"w":[["قَالَتْ","qālat","She said","(রানী) বললো"],["إِنَّ","inna","Indeed","\"নিশ্চয়ই"],["ٱلْمُلُوكَ","l-mulūka","the kings","রাজারা"],["إِذَا","idhā","when","যখন"],["دَخَلُوا۟","dakhalū","they enter","তারা প্রবেশ করে"],["قَرْيَةً","qaryatan","a town","কোনো জনপদে"],["أَفْسَدُوهَا","afsadūhā","they ruin it","তা বিপর্যস্ত করে তারা"],["وَجَعَلُوٓا۟","waja‘alū","and make","ও তারা বানিয়ে দেয়"],["أَعِزَّةَ","a‘izzata","(the) most honorable","মর্যাদাবানদেরকে"],["أَهْلِهَآ","ahlihā","(of) its people","অধিবাসীদের তার"],["أَذِلَّةًۭ ۖ","adhillatan","(the) lowest","অপদস্হ"],["وَكَذَٰلِكَ","wakadhālika","And thus","আর এরূপই"],["يَفْعَلُونَ","yaf‘alūna","they do","তারা করবে"]],"t":"قَالَتْ إِ<g>نَّ</> <h>ٱ</>لْمُلُوكَ إِذَا دَخَلُو<s>ا۟</> قَرْيَةً أَفْسَدُوهَا وَجَعَ<o>لُوٓ</><s>ا۟</> أَعِزَّةَ أَهْلِ<o>هَآ</> أَذِلَّ<d>ةًۭ ۖ وَ</>كَ<m>ذَٰ</>لِكَ يَفْعَ<p>لُو</>نَ"},{"n":35,"w":[["وَإِنِّى","wa-innī","But indeed, I am","এবং নিশ্চয়ই আমি"],["مُرْسِلَةٌ","mur'silatun","going to send","প্রেরণকারী"],["إِلَيْهِم","ilayhim","to them","প্রতি তাদের"],["بِهَدِيَّةٍۢ","bihadiyyatin","a gift","সহ উপঢৌকন"],["فَنَاظِرَةٌۢ","fanāẓiratun","and see","অতঃপর লক্ষ্য করবো"],["بِمَ","bima","with what","নিয়ে কি"],["يَرْجِعُ","yarji‘u","return","ফিরে আসে"],["ٱلْمُرْسَلُونَ","l-mur'salūna","the messengers","দূতেরা\""]],"t":"وَإِ<g>نِّ</>ى مُرْسِلَةٌ إِلَيْ<f>هِم بِ</>هَدِيَّ<k>ةٍۢ فَ</>نَاظِرَ<i>ةٌۢ بِ</>مَ يَرْجِعُ <h>ٱ</>لْمُرْسَ<p>لُو</>نَ"},{"n":36,"w":[["فَلَمَّا","falammā","So when","অতঃপর যখন"],["جَآءَ","jāa","came","আসলো (দূত)"],["سُلَيْمَـٰنَ","sulaymāna","(to) Sulaiman","সুলায়মানের (নিকট)"],["قَالَ","qāla","he said","সে বললো"],["أَتُمِدُّونَنِ","atumiddūnani","Will you provide me","\"কি তোমরা কি সাহায্য করছো আমাকে"],["بِمَالٍۢ","bimālin","with wealth","দিয়ে ধনসম্পদ"],["فَمَآ","famā","But what","অথচ যা"],["ءَاتَىٰنِۦَ","ātāniya","Allah has given me","দিয়েছেন আমাকে"],["ٱللَّهُ","l-lahu","Allah has given me","আল্লাহ"],["خَيْرٌۭ","khayrun","(is) better","উত্তম"],["مِّمَّآ","mimmā","than what","তার চেয়ে যা"],["ءَاتَىٰكُم","ātākum","He has given you","দিয়েছেন তোমাদেরকে"],["بَلْ","bal","Nay","বরং"],["أَنتُم","antum","you","তোমরা"],["بِهَدِيَّتِكُمْ","bihadiyyatikum","in your gift","নিয়ে উপঢৌকন তোমাদের"],["تَفْرَحُونَ","tafraḥūna","rejoice","আনন্দ করো"]],"t":"فَلَ<g>مَّ</>ا <o>جَآ</>ءَ سُلَيْ<m>مَٰ</>نَ قَالَ أَتُمِدُّونَنِ بِمَا<k>لٍۢ فَ</><o>مَآ</> ءَاتَ<m>ىٰنِۦَ</> <h>ٱ</>للَّهُ خَيْ<d>رٌۭ مِّ</><g>مَّ</><o>آ</> ءَاتَ<m>ىٰ</><f>كُم بَ</>لْ أَ<k>نتُ</><f>م بِ</>هَدِيَّتِكُمْ تَفْرَ<p>حُو</>نَ"},{"n":37,"w":[["ٱرْجِعْ","ir'ji‘","Return","ফিরে যাও"],["إِلَيْهِمْ","ilayhim","to them","নিকট তাদের"],["فَلَنَأْتِيَنَّهُم","falanatiyannahum","surely, we will come to them","অতঃপর অবশ্যই আমরা কাছে আসবোই তাদের"],["بِجُنُودٍۢ","bijunūdin","with hosts","সহ এক সৈন্যবাহিনী"],["لَّا","lā","not","নেই"],["قِبَلَ","qibala","(is) resistance","রুখবার শক্তি"],["لَهُم","lahum","for them","কাছে তাদের"],["بِهَا","bihā","of it","বিষয়ে তার"],["وَلَنُخْرِجَنَّهُم","walanukh'rijannahum","and surely, we will drive them out","এবং অবশ্যই আমরা বের করবোই তাদেরকে"],["مِّنْهَآ","min'hā","from there","হ'তে সেখান"],["أَذِلَّةًۭ","adhillatan","(in) humiliation","অপমানিত করে"],["وَهُمْ","wahum","and they","যখন তারা"],["صَـٰغِرُونَ","ṣāghirūna","(will be) abased","অপদস্হ (হবে)\""]],"t":"ٱرْجِعْ إِلَيْهِمْ فَلَنَأْتِيَ<g>نَّ</><f>هُم بِ</>جُنُو<w>دٍۢ لَّ</>ا قِبَلَ لَ<f>هُم بِ</>هَا وَلَنُخْرِجَ<g>نَّ</><y>هُم مِّ</>نْ<o>هَآ</> أَذِلَّ<d>ةًۭ وَ</>هُمْ <m>صَٰ</>غِ<p>رُو</>نَ"},{"n":38,"w":[["قَالَ","qāla","He said","(সুলায়মান) বললো"],["يَـٰٓأَيُّهَا","yāayyuhā","O","\"হে"],["ٱلْمَلَؤُا۟","l-mala-u","chiefs","সভাসদবৃন্দ"],["أَيُّكُمْ","ayyukum","Which of you","কে তোমাদের মধ্যে"],["يَأْتِينِى","yatīnī","will bring me","আমার কাছে আসবে"],["بِعَرْشِهَا","bi‘arshihā","her throne","নিয়ে তার সিংহাসন"],["قَبْلَ","qabla","before","এর পূর্বেই"],["أَن","an","that","যে"],["يَأْتُونِى","yatūnī","they come to me","আমার কাছে তারা আসবে"],["مُسْلِمِينَ","mus'limīna","(in) submission","আত্মসমর্পণকারী হয়ে\""]],"t":"قَالَ <o>يَٰٓ</>أَيُّهَا <h>ٱ</>لْمَلَؤُ<s>ا۟</> أَيُّكُمْ يَأْتِينِى بِعَرْشِهَا قَ<q>بْ</>لَ <d>أَن يَ</>أْتُونِى مُسْلِ<p>مِي</>نَ"},{"n":39,"w":[["قَالَ","qāla","Said","বললো"],["عِفْرِيتٌۭ","‘if'rītun","a strong one","এক শক্তিশালী জিন"],["مِّنَ","mina","of","মধ্য হ'তে"],["ٱلْجِنِّ","l-jini","the jinn","জিনদের"],["أَنَا۠","anā","I","\"আমি"],["ءَاتِيكَ","ātīka","will bring it to you","আপনার কাছে আসবো"],["بِهِۦ","bihi","will bring it to you","নিয়ে তা"],["قَبْلَ","qabla","before","এর পূর্বেই"],["أَن","an","[that]","যে"],["تَقُومَ","taqūma","you rise","আপনি উঠে দাঁড়াবেন"],["مِن","min","from","হ'তে"],["مَّقَامِكَ ۖ","maqāmika","your place","আপনার স্থান"],["وَإِنِّى","wa-innī","And indeed, I am","এবং নিশ্চয়ই আমি"],["عَلَيْهِ","‘alayhi","for it","উপর এর"],["لَقَوِىٌّ","laqawiyyun","surely, strong","অবশ্যই শক্তিশালী"],["أَمِينٌۭ","amīnun","trustworthy","বিশ্বস্ত\""]],"t":"قَالَ عِفْرِي<d>تٌۭ مِّ</>نَ <h>ٱ</>لْجِ<g>نِّ</> أَنَا۠ ءَاتِيكَ بِ<m>هِۦ</> قَ<q>بْ</>لَ أَ<k>ن تَ</>قُومَ <d>مِن مَّ</>قَامِكَ ۖ وَإِ<g>نِّ</>ى عَلَيْهِ لَقَوِىٌّ أَ<p>مِي</>نٌۭ"},{"n":40,"w":[["قَالَ","qāla","Said","(এরপর)বললো একজন"],["ٱلَّذِى","alladhī","one who","সে (এমন যে)"],["عِندَهُۥ","‘indahu","with him","নিকট তার (ছিলো)"],["عِلْمٌۭ","‘il'mun","(was) knowledge","জ্ঞান"],["مِّنَ","mina","of","থেকে"],["ٱلْكِتَـٰبِ","l-kitābi","the Scripture","কিতাবের"],["أَنَا۠","anā","I","\"আমি"],["ءَاتِيكَ","ātīka","will bring it to you","আপনার কাছে আসবো"],["بِهِۦ","bihi","will bring it to you","নিয়ে তা"],["قَبْلَ","qabla","before","(এর) পূর্বেই"],["أَن","an","[that]","যে"],["يَرْتَدَّ","yartadda","returns","ফিরবে"],["إِلَيْكَ","ilayka","to you","আপনার দিকে"],["طَرْفُكَ ۚ","ṭarfuka","your glance","আপনার চোখের পলক\""],["فَلَمَّا","falammā","Then when","অতঃপর যখন"],["رَءَاهُ","raāhu","he saw it","তা সে দেখলো"],["مُسْتَقِرًّا","mus'taqirran","placed","স্হির অবস্হায়"],["عِندَهُۥ","‘indahu","before him","নিকট তার"],["قَالَ","qāla","he said","সে বললো"],["هَـٰذَا","hādhā","This","\"এটা"],["مِن","min","(is) from","কারণে"],["فَضْلِ","faḍli","(the) Favor","অনুগ্রহের"],["رَبِّى","rabbī","(of) my Lord","আমার রবের"],["لِيَبْلُوَنِىٓ","liyabluwanī","to test me","যাতে তিনি আমাকে পরীক্ষা করেন"],["ءَأَشْكُرُ","a-ashkuru","whether I am grateful","কি আমি কৃতজ্ঞ হই"],["أَمْ","am","or","না"],["أَكْفُرُ ۖ","akfuru","I am ungrateful","আমি অকৃতজ্ঞ হই"],["وَمَن","waman","And whoever","আর যে"],["شَكَرَ","shakara","(is) grateful","কৃতজ্ঞ হয়"],["فَإِنَّمَا","fa-innamā","then only","তবে শুধুমাত্র"],["يَشْكُرُ","yashkuru","he is grateful","সে কৃতজ্ঞ হয়"],["لِنَفْسِهِۦ ۖ","linafsihi","for his own soul","জন্যে তার নিজের"],["وَمَن","waman","And whoever","আর যে"],["كَفَرَ","kafara","(is) ungrateful","অকৃতজ্ঞ হয়"],["فَإِنَّ","fa-inna","then indeed","তবে নিশ্চয়ই"],["رَبِّى","rabbī","my Lord","আমার রব"],["غَنِىٌّۭ","ghaniyyun","(is) Self-sufficient","অভাবমুক্ত"],["كَرِيمٌۭ","karīmun","Noble","সম্মানিত\""]],"t":"قَالَ <h>ٱ</>لَّذِى عِ<k>ندَ</>هُ<m>ۥ</> عِلْ<d>مٌۭ مِّ</>نَ <h>ٱ</>لْكِ<m>تَٰ</>بِ أَنَا۠ ءَاتِيكَ بِ<m>هِۦ</> قَ<q>بْ</>لَ <d>أَن يَ</>رْتَدَّ إِلَيْكَ طَرْفُكَ ۚ فَلَ<g>مَّ</>ا رَءَاهُ مُسْتَقِرًّا عِ<k>ندَ</>هُ<m>ۥ</> قَالَ <m>هَٰ</>ذَا مِ<k>ن فَ</>ضْلِ رَبِّى لِيَ<q>بْ</>لُوَ<o>نِىٓ</> ءَأَشْكُرُ أَمْ أَكْفُرُ ۖ وَمَ<k>ن شَ</>كَرَ فَإِ<g>نَّ</>مَا يَشْكُرُ لِنَفْسِ<m>هِۦ</> ۖ وَمَ<k>ن كَ</>فَرَ فَإِ<g>نَّ</> رَبِّى غَنِ<k>ىٌّۭ كَ</><p>رِي</>مٌۭ"},{"n":41,"w":[["قَالَ","qāla","He said","(সুলায়মান) বললো"],["نَكِّرُوا۟","nakkirū","Disguise","\"তোমরা অজ্ঞাতসারে রাখো"],["لَهَا","lahā","for her","সামনে তার"],["عَرْشَهَا","‘arshahā","her throne","সিংহাসন তার"],["نَنظُرْ","nanẓur","we will see","দেখবো আমরা"],["أَتَهْتَدِىٓ","atahtadī","whether she will be guided","সে (সঠিক) ব্যাপার বুঝতে পারছে কি"],["أَمْ","am","or","অথবা"],["تَكُونُ","takūnu","will be","সে হয়"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["لَا","lā","are not guided","না\""],["يَهْتَدُونَ","yahtadūna","are not guided","পথ পায়\""]],"t":"قَالَ نَكِّرُو<s>ا۟</> لَهَا عَرْشَهَا نَ<k>نظُ</>رْ أَتَهْتَ<o>دِىٓ</> أَمْ تَكُونُ مِنَ <h>ٱ</>لَّذِينَ لَا يَهْتَ<p>دُو</>نَ"},{"n":42,"w":[["فَلَمَّا","falammā","So when","অতঃপর যখন"],["جَآءَتْ","jāat","she came","(রানী) আসলো"],["قِيلَ","qīla","it was said","বলা হলো"],["أَهَـٰكَذَا","ahākadhā","Is like this","\"এরূপই কি"],["عَرْشُكِ ۖ","‘arshuki","your throne","তোমার সিংহাসন\""],["قَالَتْ","qālat","She said","সে বললো"],["كَأَنَّهُۥ","ka-annahu","It is like","\"এ যেন"],["هُوَ ۚ","huwa","it","সেটাই\""],["وَأُوتِينَا","waūtīnā","And we were given","\"এবং আমাদের দেয়া হয়েছে"],["ٱلْعِلْمَ","l-‘il'ma","the knowledge","জ্ঞান"],["مِن","min","before her","থেকেই"],["قَبْلِهَا","qablihā","before her","এর পূর্ব"],["وَكُنَّا","wakunnā","and we have been","এবং আমরা ছিলাম"],["مُسْلِمِينَ","mus'limīna","Muslims","আত্মসমর্পণকারী\""]],"t":"فَلَ<g>مَّ</>ا <o>جَآ</>ءَتْ قِيلَ أَ<m>هَٰ</>كَذَا عَرْشُكِ ۖ قَالَتْ كَأَ<g>نَّ</>هُ<m>ۥ</> هُوَ ۚ وَأُوتِينَا <h>ٱ</>لْعِلْمَ مِ<k>ن قَ</><q>بْ</>لِهَا وَكُ<g>نَّ</>ا مُسْلِ<p>مِي</>نَ"},{"n":43,"w":[["وَصَدَّهَا","waṣaddahā","And has averted her","আর তাকে বিরত রেখেছিলো (ঈমান আনা হ'তে)"],["مَا","mā","what","(তাই) যা কিছু"],["كَانَت","kānat","she used (to)","সে ছিলো"],["تَّعْبُدُ","ta‘budu","worship","সে পূজা করে"],["مِن","min","besides","থেকে"],["دُونِ","dūni","besides","ছাড়া"],["ٱللَّهِ ۖ","l-lahi","Allah","আল্লাহ"],["إِنَّهَا","innahā","Indeed, she","নিশ্চয়ই সে"],["كَانَتْ","kānat","was","ছিলো"],["مِن","min","from","অন্তর্ভুক্ত"],["قَوْمٍۢ","qawmin","a people","জাতির"],["كَـٰفِرِينَ","kāfirīna","who disbelieve","কাফের"]],"t":"وَصَدَّهَا مَا كَانَت تَّعْبُدُ مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ ۖ إِ<g>نَّ</>هَا كَانَتْ مِ<k>ن قَوْمٍۢ كَٰ</>فِ<p>رِي</>نَ"},{"n":44,"w":[["قِيلَ","qīla","It was said","বলা হলো"],["لَهَا","lahā","to her","উদ্দেশ্যে তার"],["ٱدْخُلِى","ud'khulī","Enter","\"প্রবেশ করো"],["ٱلصَّرْحَ ۖ","l-ṣarḥa","the palace","(এই) প্রাসাদে\""],["فَلَمَّا","falammā","Then when","অতঃপর যখন"],["رَأَتْهُ","ra-athu","she saw it","তা সে দেখলো"],["حَسِبَتْهُ","ḥasibathu","she thought it","তা মনে করলো"],["لُجَّةًۭ","lujjatan","(was) a pool","পানির হাউজ (জলাশয়)"],["وَكَشَفَتْ","wakashafat","and she uncovered","ও উঠালো (কাপড়)"],["عَن","‘an","[on]","হতে"],["سَاقَيْهَا ۚ","sāqayhā","her shins","দুই গোড়ালী তার"],["قَالَ","qāla","He said","(সুলায়মান) বললো"],["إِنَّهُۥ","innahu","Indeed, it","\"নিশ্চয় তা"],["صَرْحٌۭ","ṣarḥun","(is) a palace","(প্রাসাদের) মেঝে"],["مُّمَرَّدٌۭ","mumarradun","made smooth","নির্মিত"],["مِّن","min","of","দিয়ে"],["قَوَارِيرَ ۗ","qawārīra","glass","স্বচ্ছ কাঁচ\""],["قَالَتْ","qālat","She said","(রানী) বললো"],["رَبِّ","rabbi","My Lord","\"হে আমার রব (আজ পর্যন্ত)"],["إِنِّى","innī","indeed, I","নিশ্চয়ই আমি"],["ظَلَمْتُ","ẓalamtu","[I] have wronged","অন্যায় করেছি"],["نَفْسِى","nafsī","myself","আমার নিজের (উপর)"],["وَأَسْلَمْتُ","wa-aslamtu","and I submit","(আর এখন) আমি আত্মসমর্পণ করছি"],["مَعَ","ma‘a","with","সাথে"],["سُلَيْمَـٰنَ","sulaymāna","Sulaiman","সুলায়মানের"],["لِلَّهِ","lillahi","to Allah","নিকট আল্লাহর"],["رَبِّ","rabbi","(the) Lord","(যিনি) রব"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","(of) the worlds","বিশ্বজগতের\""]],"t":"قِيلَ لَهَا <h>ٱ</><q>دْ</>خُلِى <h>ٱ</><l>ل</>صَّرْحَ ۖ فَلَ<g>مَّ</>ا رَأَتْهُ حَسِبَتْهُ لُجَّ<d>ةًۭ وَ</>كَشَفَتْ عَ<k>ن سَ</>اقَيْهَا ۚ قَالَ إِ<g>نَّ</>هُ<m>ۥ</> صَرْ<d>حٌۭ مُّ</>مَرَّ<d>دٌۭ مِّ</><k>ن قَ</>وَارِيرَ ۗ قَالَتْ رَبِّ إِ<g>نِّ</>ى ظَلَمْتُ نَفْسِى وَأَسْلَمْتُ مَعَ سُلَيْ<m>مَٰ</>نَ لِلَّهِ رَبِّ <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":45,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["أَرْسَلْنَآ","arsalnā","We sent","প্রেরণ করেছিলাম আমরা"],["إِلَىٰ","ilā","to","প্রতি"],["ثَمُودَ","thamūda","Thamud","সামূদের"],["أَخَاهُمْ","akhāhum","their brother","ভাই তাদেরই"],["صَـٰلِحًا","ṣāliḥan","Salih","সালেহকে"],["أَنِ","ani","that","(এ বার্তাসহ) যে"],["ٱعْبُدُوا۟","u‘'budū","Worship","\"তোমরা ইবাদত করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহর\""],["فَإِذَا","fa-idhā","Then behold","অতঃপর তখন"],["هُمْ","hum","They","তারা"],["فَرِيقَانِ","farīqāni","(became) two parties","দু'দলে"],["يَخْتَصِمُونَ","yakhtaṣimūna","quarreling","তর্কে মেতে উঠলো"]],"t":"وَلَقَ<q>دْ</> أَرْسَلْ<o>نَآ</> إِلَىٰ ثَمُودَ أَخَاهُمْ <m>صَٰ</>لِحًا أَنِ <h>ٱ</>عْبُدُو<s>ا۟</> <h>ٱ</>للَّهَ فَإِذَا هُمْ فَرِيقَانِ يَخْتَصِ<p>مُو</>نَ"},{"n":46,"w":[["قَالَ","qāla","He said","(সালেহ) বললো"],["يَـٰقَوْمِ","yāqawmi","O my people","\"হে আমার জাতি"],["لِمَ","lima","Why","কেন"],["تَسْتَعْجِلُونَ","tasta‘jilūna","(do) you seek to hasten","তোমরা তাড়াতাড়ি করতে চাচ্ছো"],["بِٱلسَّيِّئَةِ","bil-sayi-ati","the evil","অকল্যাণকে"],["قَبْلَ","qabla","before","পূর্বে"],["ٱلْحَسَنَةِ ۖ","l-ḥasanati","the good","কল্যাণের"],["لَوْلَا","lawlā","Why not","কেন না"],["تَسْتَغْفِرُونَ","tastaghfirūna","you ask forgiveness","তোমরা ক্ষমা চাচ্ছো"],["ٱللَّهَ","l-laha","(of) Allah","আল্লাহর (নিকট)"],["لَعَلَّكُمْ","la‘allakum","so that you may","হয়তো তোমাদের (প্রতি)"],["تُرْحَمُونَ","tur'ḥamūna","receive mercy","করুণা করা হবে\""]],"t":"قَالَ <m>يَٰ</>قَوْمِ لِمَ تَسْتَعْجِلُونَ بِ<h>ٱ</><l>ل</>سَّيِّئَةِ قَ<q>بْ</>لَ <h>ٱ</>لْحَسَنَةِ ۖ لَوْلَا تَسْتَغْفِرُونَ <h>ٱ</>للَّهَ لَعَلَّكُمْ تُرْحَ<p>مُو</>نَ"},{"n":47,"w":[["قَالُوا۟","qālū","They said","তারা বললো"],["ٱطَّيَّرْنَا","iṭṭayyarnā","We consider you a bad omen","\"আমরা অমঙ্গল ভাবছি"],["بِكَ","bika","We consider you a bad omen","\"বিষয়টি তোমার"],["وَبِمَن","wabiman","and those","ও বিষয়টি তাদের (যারা)"],["مَّعَكَ ۚ","ma‘aka","with you","তোমার সাথে (আছে)\""],["قَالَ","qāla","He said","(সালেহ) বললো"],["طَـٰٓئِرُكُمْ","ṭāirukum","Your bad omen","\"তোমাদের শুভাশুভ"],["عِندَ","‘inda","(is) with","নিকট"],["ٱللَّهِ ۖ","l-lahi","Allah","আল্লাহর"],["بَلْ","bal","Nay","বরং"],["أَنتُمْ","antum","you","তোমরা"],["قَوْمٌۭ","qawmun","(are) a people","(এমন) লোক"],["تُفْتَنُونَ","tuf'tanūna","being tested","পরীক্ষা করা হচ্ছে (যাদেরকে)\""]],"t":"قَالُو<s>ا۟</> <h>ٱ</>طَّيَّرْنَا بِكَ وَبِ<d>مَن مَّ</>عَكَ ۚ قَالَ <o>طَٰٓ</>ئِرُكُمْ عِ<k>ندَ</> <h>ٱ</>للَّهِ ۖ بَلْ أَ<k>نتُ</>مْ قَوْ<k>مٌۭ تُ</>فْتَ<p>نُو</>نَ"},{"n":48,"w":[["وَكَانَ","wakāna","And were","এবং ছিলো"],["فِى","fī","in","মধ্যে"],["ٱلْمَدِينَةِ","l-madīnati","the city","শহরের"],["تِسْعَةُ","tis'‘atu","nine","নয় (জনের)"],["رَهْطٍۢ","rahṭin","family heads","একটি দল"],["يُفْسِدُونَ","yuf'sidūna","they were spreading corruption","তারা বিপর্যয় সৃষ্টি করতো"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the land","দেশের"],["وَلَا","walā","and not","এবং না"],["يُصْلِحُونَ","yuṣ'liḥūna","reforming","তারা সংশোধনমূলক কাজ করতো"]],"t":"وَكَانَ فِى <h>ٱ</>لْمَدِينَةِ تِسْعَةُ رَهْ<d>طٍۢ يُ</>فْسِدُونَ فِى <h>ٱ</>لْأَرْضِ وَلَا يُصْلِ<p>حُو</>نَ"},{"n":49,"w":[["قَالُوا۟","qālū","They said","তারা বললো"],["تَقَاسَمُوا۟","taqāsamū","Swear to each other","\"তোমরা শপথ করো পরস্পরে"],["بِٱللَّهِ","bil-lahi","by Allah","নামে আল্লাহর"],["لَنُبَيِّتَنَّهُۥ","lanubayyitannahu","surely, we will attack him by night","অবশ্যই আমরা তাকে রাতে আক্রমণ করবোই"],["وَأَهْلَهُۥ","wa-ahlahu","and his family","ও তার পরিবারকে"],["ثُمَّ","thumma","Then","এরপর"],["لَنَقُولَنَّ","lanaqūlanna","we will surely say","অবশ্যই বলবো আমরা"],["لِوَلِيِّهِۦ","liwaliyyihi","to his heir","প্রতি তার অভিভাবকের"],["مَا","mā","Not","\"না"],["شَهِدْنَا","shahid'nā","we witnessed","উপস্থিত ছিলাম আমরা"],["مَهْلِكَ","mahlika","(the) destruction","ধ্বংসের সময়"],["أَهْلِهِۦ","ahlihi","(of) his family","তার পরিবারের"],["وَإِنَّا","wa-innā","and indeed, we","আর নিশ্চয়ই আমরা"],["لَصَـٰدِقُونَ","laṣādiqūna","(are) surely truthful","অবশ্যই সত্যবাদী\""]],"t":"قَالُو<s>ا۟</> تَقَاسَمُو<s>ا۟</> بِ<h>ٱ</>للَّهِ لَنُبَيِّتَ<g>نَّ</>هُ<m>ۥ</> وَأَهْلَهُ<m>ۥ</> ثُ<g>مَّ</> لَنَقُولَ<g>نَّ</> لِوَلِيِّ<m>هِۦ</> مَا شَهِ<q>دْ</>نَا مَهْلِكَ أَهْلِ<m>هِۦ</> وَإِ<g>نَّ</>ا لَ<m>صَٰ</>دِ<p>قُو</>نَ"},{"n":50,"w":[["وَمَكَرُوا۟","wamakarū","So they plotted","এবং তারা ষড়যন্ত্র করলো"],["مَكْرًۭا","makran","a plot","এক ষড়যন্ত্র"],["وَمَكَرْنَا","wamakarnā","and We planned","আর আমরা কৌশল করলাম"],["مَكْرًۭا","makran","a plan","এক কৌশল"],["وَهُمْ","wahum","while they","অথচ তারা"],["لَا","lā","(did) not","না"],["يَشْعُرُونَ","yash‘urūna","perceive","অনুভব করলো"]],"t":"وَمَكَرُو<s>ا۟</> مَكْ<d>رًۭا وَ</>مَكَرْنَا مَكْ<d>رًۭا وَ</>هُمْ لَا يَشْعُ<p>رُو</>نَ"},{"n":51,"w":[["فَٱنظُرْ","fa-unẓur","Then see","অতঃপর লক্ষ্য করো"],["كَيْفَ","kayfa","how","কেমন"],["كَانَ","kāna","was","হয়েছিলো"],["عَـٰقِبَةُ","‘āqibatu","(the) end","পরিণাম"],["مَكْرِهِمْ","makrihim","(of) their plot","ষড়যন্ত্রের তাদের"],["أَنَّا","annā","that We","নিশ্চয়ই আমরা"],["دَمَّرْنَـٰهُمْ","dammarnāhum","destroyed them","আমরা ধ্বংস করেছি তাদেরকে"],["وَقَوْمَهُمْ","waqawmahum","and their people","ও জাতির তাদের"],["أَجْمَعِينَ","ajma‘īna","all","সবাইকে"]],"t":"فَ<h>ٱ</><k>نظُ</>رْ كَيْفَ كَانَ <m>عَٰ</>قِبَةُ مَكْرِهِمْ أَ<g>نَّ</>ا دَ<g>مَّ</>رْ<m>نَٰ</>هُمْ وَقَوْمَهُمْ أَ<q>جْ</>مَ<p>عِي</>نَ"},{"n":52,"w":[["فَتِلْكَ","fatil'ka","So, these","তাই ঐসব"],["بُيُوتُهُمْ","buyūtuhum","(are) their houses","ঘরবাড়ি তাদের"],["خَاوِيَةًۢ","khāwiyatan","ruined","শূন্য হয়ে আছে"],["بِمَا","bimā","because","এ কারণে যা"],["ظَلَمُوٓا۟ ۗ","ẓalamū","they wronged","তারা সীমালঙ্ঘন করেছিলো"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে (রয়েছে)"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَةًۭ","laāyatan","surely, is a sign","অবশ্যই নিদর্শন"],["لِّقَوْمٍۢ","liqawmin","for a people","জন্যে সম্প্রদায়ের"],["يَعْلَمُونَ","ya‘lamūna","who know","(যারা) জ্ঞান রাখে"]],"t":"فَتِلْكَ بُيُوتُهُمْ خَاوِيَ<i>ةًۢ بِ</>مَا ظَلَ<o>مُوٓ</><s>ا۟</> ۗ إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَايَ<w>ةًۭ لِّ</>قَوْ<d>مٍۢ يَ</>عْلَ<p>مُو</>نَ"},{"n":53,"w":[["وَأَنجَيْنَا","wa-anjaynā","And We saved","এবং আমরা রক্ষা করলাম"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["ءَامَنُوا۟","āmanū","believed","ঈমান এনেছিলো"],["وَكَانُوا۟","wakānū","and used (to)","ও তারা ছিলো"],["يَتَّقُونَ","yattaqūna","fear (Allah)","ও (নাফরমানী হতে) তারা বিরত থাকতো"]],"t":"وَأَ<k>نجَ</>يْنَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَكَانُو<s>ا۟</> يَتَّ<p>قُو</>نَ"},{"n":54,"w":[["وَلُوطًا","walūṭan","And Lut","এবং লূতকে (পাঠিয়েছিলাম)"],["إِذْ","idh","when","(স্মরণ করো) যখন"],["قَالَ","qāla","he said","সে বলেছিলো"],["لِقَوْمِهِۦٓ","liqawmihi","to his people","উদ্দেশ্যে তার জাতির"],["أَتَأْتُونَ","atatūna","Do you commit","\"কি তোমরা করছো"],["ٱلْفَـٰحِشَةَ","l-fāḥishata","[the] immorality","অশ্লীল কাজে"],["وَأَنتُمْ","wa-antum","while you","যখন তোমরা"],["تُبْصِرُونَ","tub'ṣirūna","see","প্রত্যক্ষও করছো"]],"t":"وَلُوطًا إِذْ قَالَ لِقَوْمِ<o>هِۦٓ</> أَتَأْتُونَ <h>ٱ</>لْ<m>فَٰ</>حِشَةَ وَأَ<k>نتُ</>مْ تُ<q>بْ</>صِ<p>رُو</>نَ"},{"n":55,"w":[["أَئِنَّكُمْ","a-innakum","Why do you","কি নিশ্চয়ই তোমরা"],["لَتَأْتُونَ","latatūna","approach","অবশ্যই তোমরা গমন করছো"],["ٱلرِّجَالَ","l-rijāla","the men","পুরুষদের কাছে"],["شَهْوَةًۭ","shahwatan","(with) lust","যৌন লালসার (জন্যে)"],["مِّن","min","instead of","বাদ"],["دُونِ","dūni","instead of","দিয়ে"],["ٱلنِّسَآءِ ۚ","l-nisāi","the women","স্ত্রীদেরকে"],["بَلْ","bal","Nay","আসলে"],["أَنتُمْ","antum","you","তোমরা"],["قَوْمٌۭ","qawmun","(are) a people","(এমন) সম্প্রদায়"],["تَجْهَلُونَ","tajhalūna","ignorant","(যারা) মূর্খতা করছো\""]],"t":"أَئِ<g>نَّ</>كُمْ لَتَأْتُونَ <h>ٱ</><l>ل</>رِّجَالَ شَهْوَ<d>ةًۭ مِّ</><k>ن دُ</>ونِ <h>ٱ</><l>ل</><g>نِّ</><o>سَآ</>ءِ ۚ بَلْ أَ<k>نتُ</>مْ قَوْ<k>مٌۭ تَ</><q>جْ</>هَ<p>لُو</>نَ"},{"n":56,"w":[["۞ فَمَا","famā","But not","অতঃপর না"],["كَانَ","kāna","was","ছিলো"],["جَوَابَ","jawāba","(the) answer","উত্তর/জবাব"],["قَوْمِهِۦٓ","qawmihi","(of) his people","জাতির তার"],["إِلَّآ","illā","except","এ ছাড়া"],["أَن","an","that","যে"],["قَالُوٓا۟","qālū","they said","তারা বলেছিলো"],["أَخْرِجُوٓا۟","akhrijū","Drive out","\"তোমরা বের করে দাও"],["ءَالَ","āla","(the) family","পরিবারকে"],["لُوطٍۢ","lūṭin","(of) Lut","লুতের"],["مِّن","min","from","হ'তে"],["قَرْيَتِكُمْ ۖ","qaryatikum","your town","জনপদ তোমাদের"],["إِنَّهُمْ","innahum","Indeed, they","নিশ্চয়ই তারা"],["أُنَاسٌۭ","unāsun","(are) people","এমন লোক"],["يَتَطَهَّرُونَ","yataṭahharūna","who keep clean and pure","(যারা) তারা পবিত্র থাকতে চায়"]],"t":"۞ فَمَا كَانَ جَوَابَ قَوْمِ<o>هِۦٓ</> إِ<o>لَّآ</> أَ<k>ن قَ</>ا<o>لُوٓ</><s>ا۟</> أَخْرِ<o>جُوٓ</><s>ا۟</> ءَالَ لُو<d>طٍۢ مِّ</><k>ن قَ</>رْيَتِكُمْ ۖ إِ<g>نَّ</>هُمْ أُنَا<d>سٌۭ يَ</>تَطَهَّ<p>رُو</>نَ"},{"n":57,"w":[["فَأَنجَيْنَـٰهُ","fa-anjaynāhu","So We saved him","অতঃপর আমরা রক্ষা করলাম তাকে"],["وَأَهْلَهُۥٓ","wa-ahlahu","and his family","ও পরিবারকে তার"],["إِلَّا","illā","except","ছাড়া"],["ٱمْرَأَتَهُۥ","im'ra-atahu","his wife","স্ত্রীকে তার"],["قَدَّرْنَـٰهَا","qaddarnāhā","We destined her","আমরা সাব্যস্ত করেছিলাম তাকে"],["مِنَ","mina","(to be) of","অন্তর্ভুক্ত"],["ٱلْغَـٰبِرِينَ","l-ghābirīna","those who remained behind","পিছে পড়ে থাকাদের"]],"t":"فَأَ<k>نجَ</>يْ<m>نَٰ</>هُ وَأَهْلَهُ<o>ۥٓ</> إِلَّا <h>ٱ</>مْرَأَتَهُ<m>ۥ</> قَدَّرْ<m>نَٰ</>هَا مِنَ <h>ٱ</>لْ<m>غَٰ</>بِ<p>رِي</>نَ"},{"n":58,"w":[["وَأَمْطَرْنَا","wa-amṭarnā","And We rained","এবং বর্ষণ করেছিলাম আমরা"],["عَلَيْهِم","‘alayhim","upon them","উপর তাদের"],["مَّطَرًۭا ۖ","maṭaran","a rain","(খুব) বৃষ্টি"],["فَسَآءَ","fasāa","and was evil","অতঃপর বড় খারাপ"],["مَطَرُ","maṭaru","(the) rain","বৃষ্টিবর্ষণ (ছিলো)"],["ٱلْمُنذَرِينَ","l-mundharīna","(on) those who were warned","(তাদের জন্যে) যাদেরকে সতর্ক করা হয়েছিলো"]],"t":"وَأَمْطَرْنَا عَلَيْ<y>هِم مَّ</>طَ<k>رًۭا ۖ فَ</><o>سَآ</>ءَ مَطَرُ <h>ٱ</>لْمُ<k>نذَ</><p>رِي</>نَ"},{"n":59,"w":[["قُلِ","quli","Say","(হে নাবী) বলো"],["ٱلْحَمْدُ","l-ḥamdu","All praise (be)","\"সব প্রশংসা"],["لِلَّهِ","lillahi","to Allah","জন্যে আল্লাহরই"],["وَسَلَـٰمٌ","wasalāmun","and peace (be)","আর সালাম"],["عَلَىٰ","‘alā","upon","উপর"],["عِبَادِهِ","‘ibādihi","His slaves","দাসদের তাঁর"],["ٱلَّذِينَ","alladhīna","those whom","যাদেরকে"],["ٱصْطَفَىٰٓ ۗ","iṣ'ṭafā","He has chosen","তিনি মনোনীত করেছেন"],["ءَآللَّهُ","āllahu","Is Allah","(তাদের জিজ্ঞেস করো)কি আল্লাহ"],["خَيْرٌ","khayrun","better","উত্তম"],["أَمَّا","ammā","or what","না সেই (মাবুদ)"],["يُشْرِكُونَ","yush'rikūna","they associate (with Him)","(যাদেরকে) তারা শরিক করছে\""]],"t":"قُلِ <h>ٱ</>لْحَمْدُ لِلَّهِ وَسَ<m>لَٰ</>مٌ عَلَىٰ عِبَادِهِ <h>ٱ</>لَّذِينَ <h>ٱ</>صْطَفَ<o>ىٰٓ ۗ</> ءَآللَّهُ خَيْرٌ أَ<g>مَّ</>ا يُشْرِ<p>كُو</>نَ"},{"n":60,"w":[["أَمَّنْ","amman","Or Who","অথবা কে (এমন আছেন)"],["خَلَقَ","khalaqa","has created","যিনি সৃষ্টি করেছেন"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশমন্ডলী"],["وَٱلْأَرْضَ","wal-arḍa","and the earth","ও পৃথিবীকে"],["وَأَنزَلَ","wa-anzala","and sent down","ও বর্ষণ করেছেন"],["لَكُم","lakum","for you","জন্যে তোমাদের"],["مِّنَ","mina","from","হ'তে"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশ"],["مَآءًۭ","māan","water","পানি"],["فَأَنۢبَتْنَا","fa-anbatnā","And We caused to grow","অতঃপর আমরাই  উৎপন্ন করেছি"],["بِهِۦ","bihi","thereby","দ্বারা তা"],["حَدَآئِقَ","ḥadāiqa","gardens","বাগানসমূহ"],["ذَاتَ","dhāta","of beauty (and delight)","মন্ডিত"],["بَهْجَةٍۢ","bahjatin","of beauty (and delight)","শোভা"],["مَّا","mā","not","না"],["كَانَ","kāna","it is","(সম্ভব) ছিলো"],["لَكُمْ","lakum","for you","জন্যে তোমাদের"],["أَن","an","that","যে"],["تُنۢبِتُوا۟","tunbitū","you cause to grow","তোমরা উৎপন্ন করবে"],["شَجَرَهَآ ۗ","shajarahā","their trees","গাছ-পালা তার"],["أَءِلَـٰهٌۭ","a-ilāhun","Is there any god","কি তবে (আছে) কোনো ইলাহ"],["مَّعَ","ma‘a","with","সাথে"],["ٱللَّهِ ۚ","l-lahi","Allah","আল্লাহর (এ কাজে)"],["بَلْ","bal","Nay","বরং"],["هُمْ","hum","they","তারা"],["قَوْمٌۭ","qawmun","(are) a people","(এমন) সম্প্রদায়"],["يَعْدِلُونَ","ya‘dilūna","who ascribe equals","যারা সত্যবিচ্যুত হচ্ছে"]],"t":"أَ<g>مَّ</>نْ خَلَقَ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضَ وَأَ<k>نزَ</>لَ لَ<y>كُم مِّ</>نَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ <o>مَآ</><k>ءًۭ فَ</>أَ<i>نۢبَ</>تْنَا بِ<m>هِۦ</> حَ<o>دَآ</>ئِقَ ذَاتَ بَهْجَ<d>ةٍۢ مَّ</>ا كَانَ لَكُمْ أَ<k>ن تُ</><i>نۢبِ</>تُو<s>ا۟</> شَجَرَ<o>هَآ ۗ</> أَءِ<m>لَٰ</><d>هٌۭ مَّ</>عَ <h>ٱ</>للَّهِ ۚ بَلْ هُمْ قَوْ<d>مٌۭ يَ</>عْدِ<p>لُو</>نَ"},{"n":61,"w":[["أَمَّن","amman","Or Who","অথবা কে (এমন আছে)"],["جَعَلَ","ja‘ala","made","যিনি করেছেন"],["ٱلْأَرْضَ","l-arḍa","the earth","পৃথিবীকে"],["قَرَارًۭا","qarāran","a firm abode","বাসোপযোগী"],["وَجَعَلَ","waja‘ala","and made","ও প্রবাহিত করেছেন"],["خِلَـٰلَهَآ","khilālahā","(in) its midst","মাঝে তার"],["أَنْهَـٰرًۭا","anhāran","rivers","নদ-নদীসমূহ"],["وَجَعَلَ","waja‘ala","and made","এবং স্থাপন করেছেন"],["لَهَا","lahā","for it","তাতে"],["رَوَٰسِىَ","rawāsiya","firm mountains","সুদৃঢ় পর্বতসমূহ"],["وَجَعَلَ","waja‘ala","and made","এবং সৃষ্টি করেছেন"],["بَيْنَ","bayna","between","মাঝে"],["ٱلْبَحْرَيْنِ","l-baḥrayni","the two seas","দুই সাগরের"],["حَاجِزًا ۗ","ḥājizan","a barrier","আড়াল"],["أَءِلَـٰهٌۭ","a-ilāhun","Is there any god","কি তবে (আছে) কোনো ইলাহ"],["مَّعَ","ma‘a","with","সাথে"],["ٱللَّهِ ۚ","l-lahi","Allah","আল্লাহর (এ কাজে)"],["بَلْ","bal","Nay","বরং"],["أَكْثَرُهُمْ","aktharuhum","most of them","অধিকাংশ তাদের"],["لَا","lā","(do) not","না"],["يَعْلَمُونَ","ya‘lamūna","know","জানে"]],"t":"أَ<g>مَّ</><k>ن جَ</>عَلَ <h>ٱ</>لْأَرْضَ قَرَا<d>رًۭا وَ</>جَعَلَ خِ<m>لَٰ</>لَ<o>هَآ</> أَنْ<m>هَٰ</><d>رًۭا وَ</>جَعَلَ لَهَا رَ<m>وَٰ</>سِىَ وَجَعَلَ بَيْنَ <h>ٱ</>لْبَحْرَيْنِ حَاجِزًا ۗ أَءِ<m>لَٰ</><d>هٌۭ مَّ</>عَ <h>ٱ</>للَّهِ ۚ بَلْ أَكْثَرُهُمْ لَا يَعْلَ<p>مُو</>نَ"},{"n":62,"w":[["أَمَّن","amman","Or Who","কে অথবা (এমন আছেন)"],["يُجِيبُ","yujību","responds","যিনি সাড়া দেন"],["ٱلْمُضْطَرَّ","l-muḍ'ṭara","(to) the distressed one","আর্তকে"],["إِذَا","idhā","when","যখন"],["دَعَاهُ","da‘āhu","he calls Him","তাকে ডাকে সে"],["وَيَكْشِفُ","wayakshifu","and He removes","ও দূর করেন"],["ٱلسُّوٓءَ","l-sūa","the evil","কষ্ট"],["وَيَجْعَلُكُمْ","wayaj‘alukum","and makes you","ও করেন তোমাদেরকে"],["خُلَفَآءَ","khulafāa","inheritors","প্রতিনিধি"],["ٱلْأَرْضِ ۗ","l-arḍi","(of) the earth","পৃথিবীর"],["أَءِلَـٰهٌۭ","a-ilāhun","Is there any god","কি (আছে) কোনো ইলাহ"],["مَّعَ","ma‘a","with","সাথে"],["ٱللَّهِ ۚ","l-lahi","Allah","আল্লাহর (এ কাজে)"],["قَلِيلًۭا","qalīlan","Little","খুব কমই"],["مَّا","mā","(is) what","যা"],["تَذَكَّرُونَ","tadhakkarūna","you remember","তোমরা উপদেশ গ্রহণ করো"]],"t":"أَ<g>مَّ</><d>ن يُ</>جِيبُ <h>ٱ</>لْمُضْطَرَّ إِذَا دَعَاهُ وَيَكْشِفُ <h>ٱ</><l>ل</><o>سُّوٓ</>ءَ وَيَ<q>جْ</>عَلُكُمْ خُلَ<o>فَآ</>ءَ <h>ٱ</>لْأَرْضِ ۗ أَءِ<m>لَٰ</><d>هٌۭ مَّ</>عَ <h>ٱ</>للَّهِ ۚ قَلِيلًۭ<d>ا مَّ</>ا تَذَكَّ<p>رُو</>نَ"},{"n":63,"w":[["أَمَّن","amman","Or Who","কে অথবা (এমন আছেন)"],["يَهْدِيكُمْ","yahdīkum","guides you","যিনি পথ দেখান তোমাদেরকে"],["فِى","fī","in","মধ্যে"],["ظُلُمَـٰتِ","ẓulumāti","(the) darkness[es]","অন্ধকারসমূহের"],["ٱلْبَرِّ","l-bari","(of) the land","স্থলের"],["وَٱلْبَحْرِ","wal-baḥri","and the sea","ও সমুদ্রের"],["وَمَن","waman","and Who","আর কে"],["يُرْسِلُ","yur'silu","sends","পাঠান"],["ٱلرِّيَـٰحَ","l-riyāḥa","the winds","বাতাসকে"],["بُشْرًۢا","bush'ran","(as) glad tidings","সু-সংবাদ স্বরুপ"],["بَيْنَ","bayna","before","মাঝে"],["يَدَىْ","yaday","before","হাতের (পূর্বে)"],["رَحْمَتِهِۦٓ ۗ","raḥmatihi","His Mercy","অনুগ্রহের তাঁর"],["أَءِلَـٰهٌۭ","a-ilāhun","Is there any god","কি (আছে) কোনো ইলাহ"],["مَّعَ","ma‘a","with","সাথে"],["ٱللَّهِ ۚ","l-lahi","Allah","আল্লাহর(এ কাজে)"],["تَعَـٰلَى","ta‘ālā","High is","অতি উর্দ্ধে"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["عَمَّا","‘ammā","above what","তা হ'তে যা"],["يُشْرِكُونَ","yush'rikūna","they associate (with Him)","তারা শিরক করে"]],"t":"أَ<g>مَّ</><d>ن يَ</>هْدِيكُمْ فِى ظُلُ<m>مَٰ</>تِ <h>ٱ</>لْبَرِّ وَ<h>ٱ</>لْبَحْرِ وَ<d>مَن يُ</>رْسِلُ <h>ٱ</><l>ل</>رِّ<m>يَٰ</>حَ بُشْ<i>رًۢا بَ</>يْنَ يَدَىْ رَحْمَتِ<o>هِۦٓ ۗ</> أَءِ<m>لَٰ</><d>هٌۭ مَّ</>عَ <h>ٱ</>للَّهِ ۚ تَ<m>عَٰ</>لَى <h>ٱ</>للَّهُ عَ<g>مَّ</>ا يُشْرِ<p>كُو</>نَ"},{"n":64,"w":[["أَمَّن","amman","Or Who","কে অথবা (এমন আছেন)"],["يَبْدَؤُا۟","yabda-u","originates","যিনি সূচনা করেন"],["ٱلْخَلْقَ","l-khalqa","the creation","সৃষ্টির"],["ثُمَّ","thumma","then","এরপর"],["يُعِيدُهُۥ","yu‘īduhu","repeats it","পুনরাবৃত্তি করবেন তার"],["وَمَن","waman","and Who","আর কে"],["يَرْزُقُكُم","yarzuqukum","provides you","তোমাদেরকে জীবিকা দেন"],["مِّنَ","mina","from","হ'তে"],["ٱلسَّمَآءِ","l-samāi","the heavens","আকাশ"],["وَٱلْأَرْضِ ۗ","wal-arḍi","and the earth","ও পৃথিবী(হ'তে)"],["أَءِلَـٰهٌۭ","a-ilāhun","Is there any god","কি (আছে) কোনো ইলাহ"],["مَّعَ","ma‘a","with","সাথে"],["ٱللَّهِ ۚ","l-lahi","Allah","আল্লাহর(এ কাজে)"],["قُلْ","qul","Say","বলো"],["هَاتُوا۟","hātū","Bring forth","\"তোমরা উপস্হিত করো"],["بُرْهَـٰنَكُمْ","bur'hānakum","your proof","প্রমাণ তোমাদের"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you are","তোমরা"],["صَـٰدِقِينَ","ṣādiqīna","truthful","সত্যবাদী হয়ে থাকো\""]],"t":"أَ<g>مَّ</><d>ن يَ</><q>بْ</>دَؤُ<s>ا۟</> <h>ٱ</>لْخَلْقَ ثُ<g>مَّ</> يُعِيدُهُ<m>ۥ</> وَ<d>مَن يَ</>رْزُقُ<y>كُم مِّ</>نَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ وَ<h>ٱ</>لْأَرْضِ ۗ أَءِ<m>لَٰ</><d>هٌۭ مَّ</>عَ <h>ٱ</>للَّهِ ۚ قُلْ هَاتُو<s>ا۟</> بُرْ<m>هَٰ</>نَكُمْ إِ<k>ن كُنتُ</>مْ <m>صَٰ</>دِ<p>قِي</>نَ"},{"n":65,"w":[["قُل","qul","Say","বলো"],["لَّا","lā","No (one)","\"না"],["يَعْلَمُ","ya‘lamu","knows","জানে"],["مَن","man","whoever","যারা"],["فِى","fī","(is) in","আছে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশমন্ডলীতে"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীতে"],["ٱلْغَيْبَ","l-ghayba","(of) the unseen","অদৃশ্যের(খবর)"],["إِلَّا","illā","except","ছাড়া"],["ٱللَّهُ ۚ","l-lahu","Allah","আল্লাহ"],["وَمَا","wamā","and not","এবং না"],["يَشْعُرُونَ","yash‘urūna","they perceive","অনুভব করতেও পারে"],["أَيَّانَ","ayyāna","when","কখন"],["يُبْعَثُونَ","yub'‘athūna","they will be resurrected","তারা উত্থিত হবে\""]],"t":"قُل لَّا يَعْلَمُ مَ<k>ن فِ</>ى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ <h>ٱ</>لْغَيْبَ إِلَّا <h>ٱ</>للَّهُ ۚ وَمَا يَشْعُرُونَ أَيَّانَ يُ<q>بْ</>عَ<p>ثُو</>نَ"},{"n":66,"w":[["بَلِ","bali","Nay","বরং"],["ٱدَّٰرَكَ","iddāraka","is arrested","বিলুপ্ত হয়ে গেছে"],["عِلْمُهُمْ","‘il'muhum","their knowledge","জ্ঞান তাদের"],["فِى","fī","of","ব্যাপারে"],["ٱلْـَٔاخِرَةِ ۚ","l-ākhirati","the Hereafter","পরকালের"],["بَلْ","bal","Nay","বরং"],["هُمْ","hum","they","তারা"],["فِى","fī","(are) in","মধ্যে (আছে)"],["شَكٍّۢ","shakkin","doubt","সন্দেহের"],["مِّنْهَا ۖ","min'hā","about it","বিষয়ে সে"],["بَلْ","bal","Nay","বরং"],["هُم","hum","they","তারা"],["مِّنْهَا","min'hā","about it","বিষয়ে সে"],["عَمُونَ","‘amūna","(are) blind","অন্ধ"]],"t":"بَلِ <h>ٱ</><m>دَّٰ</>رَكَ عِلْمُهُمْ فِى <h>ٱ</>لْءَاخِرَةِ ۚ بَلْ هُمْ فِى شَ<d>كٍّۢ مِّ</>نْهَا ۖ بَلْ <y>هُم مِّ</>نْهَا عَ<p>مُو</>نَ"},{"n":67,"w":[["وَقَالَ","waqāla","And say","এবং বলে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوٓا۟","kafarū","disbelieve","অস্বীকার করেছে"],["أَءِذَا","a-idhā","What, when","\"কি যখন"],["كُنَّا","kunnā","we have become","আমরা হবো"],["تُرَٰبًۭا","turāban","dust","মাটি"],["وَءَابَآؤُنَآ","waābāunā","and our forefathers","ও পিতৃ-পুরুষরা আমাদের"],["أَئِنَّا","a-innā","will we","কি নিশ্চয়ই আমরা"],["لَمُخْرَجُونَ","lamukh'rajūna","surely be brought out","অবশ্যই উত্থিত হবো"]],"t":"وَقَالَ <h>ٱ</>لَّذِينَ كَفَ<o>رُوٓ</><s>ا۟</> أَءِذَا كُ<g>نَّ</>ا تُ<m>رَٰ</><d>بًۭا وَ</>ءَا<o>بَآؤُنَآ</> أَئِ<g>نَّ</>ا لَمُخْرَ<p>جُو</>نَ"},{"n":68,"w":[["لَقَدْ","laqad","Certainly","নিশ্চয়ই"],["وُعِدْنَا","wu‘id'