{"n":29,"a":[{"n":1,"w":[["الٓمٓ","alif-lam-meem","Alif Laam Meem","আলিফ-লাম-মীম"]],"t":"ا<n>لٓمٓ</>"},{"n":2,"w":[["أَحَسِبَ","aḥasiba","Do think","কি মনে করেছে"],["ٱلنَّاسُ","l-nāsu","the people","মানুষ"],["أَن","an","that","যে"],["يُتْرَكُوٓا۟","yut'rakū","they will be left","তাদেরকে ছেড়ে দেয়া হবে"],["أَن","an","because","(এ কথায়) যে"],["يَقُولُوٓا۟","yaqūlū","they say","তারা বলবে"],["ءَامَنَّا","āmannā","We believe","\"ঈমান এনেছি আমরা\""],["وَهُمْ","wahum","and they","আর তাদেরকে"],["لَا","lā","will not be tested","না"],["يُفْتَنُونَ","yuf'tanūna","will not be tested","পরীক্ষা করা হবে"]],"t":"أَحَسِبَ <h>ٱ</><l>ل</><g>نَّ</>اسُ <d>أَن يُ</>تْرَ<o>كُوٓ</><s>ا۟</> <d>أَن يَ</>قُو<o>لُوٓ</><s>ا۟</> ءَامَ<g>نَّ</>ا وَهُمْ لَا يُفْتَ<p>نُو</>نَ"},{"n":3,"w":[["وَلَقَدْ","walaqad","And indeed","অথচ নিশ্চয়ই"],["فَتَنَّا","fatannā","We tested","পরীক্ষা করেছি আমরা"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["مِن","min","(were) before them","থেকে"],["قَبْلِهِمْ ۖ","qablihim","(were) before them","পূর্ব ছিলো তাদের"],["فَلَيَعْلَمَنَّ","falaya‘lamanna","And Allah will surely make evident","অতএব অবশ্যই জেনে নিবেন"],["ٱللَّهُ","l-lahu","And Allah will surely make evident","আল্লাহ্"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["صَدَقُوا۟","ṣadaqū","(are) truthful","সত্য বলেছে"],["وَلَيَعْلَمَنَّ","walaya‘lamanna","and He will surely make evident","আর অবশ্যই জেনে নিবেন"],["ٱلْكَـٰذِبِينَ","l-kādhibīna","the liars","মিথ্যাবাদীদেরকে"]],"t":"وَلَقَ<q>دْ</> فَتَ<g>نَّ</>ا <h>ٱ</>لَّذِينَ مِ<k>ن قَ</><q>بْ</>لِهِمْ ۖ فَلَيَعْلَمَ<g>نَّ</> <h>ٱ</>للَّهُ <h>ٱ</>لَّذِينَ صَدَقُو<s>ا۟</> وَلَيَعْلَمَ<g>نَّ</> <h>ٱ</>لْ<m>كَٰ</>ذِ<p>بِي</>نَ"},{"n":4,"w":[["أَمْ","am","Or","কি"],["حَسِبَ","ḥasiba","think","মনে করেছে"],["ٱلَّذِينَ","alladhīna","those who","(তারা) যারা"],["يَعْمَلُونَ","ya‘malūna","do","কাজ করে"],["ٱلسَّيِّـَٔاتِ","l-sayiāti","evil deeds","মন্দ"],["أَن","an","that","যে"],["يَسْبِقُونَا ۚ","yasbiqūnā","they can outrun Us","তারা ছাড়িয়ে যাবে অামাদেরকে"],["سَآءَ","sāa","Evil is","কত খারাপ"],["مَا","mā","what","যা"],["يَحْكُمُونَ","yaḥkumūna","they judge","তারা সিদ্ধান্ত নিয়েছে"]],"t":"أَمْ حَسِبَ <h>ٱ</>لَّذِينَ يَعْمَلُونَ <h>ٱ</><l>ل</>سَّيِّـَٔاتِ <d>أَن يَ</>سْبِقُونَا ۚ <o>سَآ</>ءَ مَا يَحْكُ<p>مُو</>نَ"},{"n":5,"w":[["مَن","man","Whoever","যে"],["كَانَ","kāna","[is]","সে হলো"],["يَرْجُوا۟","yarjū","hopes","সে কামনা করে"],["لِقَآءَ","liqāa","(for the) meeting","সাক্ষাত"],["ٱللَّهِ","l-lahi","(with) Allah","আল্লাহ্‌র"],["فَإِنَّ","fa-inna","then indeed","(সে জানুক) তবে নিশ্চয়ই"],["أَجَلَ","ajala","(the) Term","নির্ধারিত সময়"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহ্‌র"],["لَـَٔاتٍۢ ۚ","laātin","(is) surely coming","অবশ্যই আসবে"],["وَهُوَ","wahuwa","And He","এবং তিনিই"],["ٱلسَّمِيعُ","l-samī‘u","(is) the All-Hearer","সবকিছু শুনেন"],["ٱلْعَلِيمُ","l-‘alīmu","the All-Knower","সবকিছু জানেন"]],"t":"مَ<k>ن كَ</>انَ يَرْجُو<s>ا۟</> لِ<o>قَآ</>ءَ <h>ٱ</>للَّهِ فَإِ<g>نَّ</> أَجَلَ <h>ٱ</>للَّهِ لَءَا<d>تٍۢ ۚ وَ</>هُوَ <h>ٱ</><l>ل</>سَّمِيعُ <h>ٱ</>لْعَ<p>لِي</>مُ"},{"n":6,"w":[["وَمَن","waman","And whoever","এবং যে"],["جَـٰهَدَ","jāhada","strives","জিহাদ (সংগ্রাম সাধনা) করে"],["فَإِنَّمَا","fa-innamā","then only","তবে শুধুমাত্র"],["يُجَـٰهِدُ","yujāhidu","he strives","সে জিহাদ (সংগ্রাম সাধনা)করে"],["لِنَفْسِهِۦٓ ۚ","linafsihi","for himself","জন্যে নিজের তার"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["لَغَنِىٌّ","laghaniyyun","(is) Free from need","অবশ্যই অমুখাপেক্ষী"],["عَنِ","‘ani","of","হ'তে"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","the worlds","বিশ্ববাসী"]],"t":"وَمَ<k>ن جَٰ</>هَدَ فَإِ<g>نَّ</>مَا يُ<m>جَٰ</>هِدُ لِنَفْسِ<o>هِۦٓ ۚ</> إِ<g>نَّ</> <h>ٱ</>للَّهَ لَغَنِىٌّ عَنِ <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":7,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান আনে"],["وَعَمِلُوا۟","wa‘amilū","and do","ও কাজ করে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","righteous (deeds)","সৎ"],["لَنُكَفِّرَنَّ","lanukaffiranna","surely, We will remove","অবশ্যই মিটিয়ে দিবো আমরা"],["عَنْهُمْ","‘anhum","from them","তাদের হ'তে তাদের"],["سَيِّـَٔاتِهِمْ","sayyiātihim","their evil deeds","দোষগুলো তাদের"],["وَلَنَجْزِيَنَّهُمْ","walanajziyannahum","and We will surely reward them","এবং অবশ্যই আমরা প্রতিফল দিবো তাদেরকে"],["أَحْسَنَ","aḥsana","(the) best","অতি উত্তম"],["ٱلَّذِى","alladhī","(of) what","(বদলে) যা"],["كَانُوا۟","kānū","they used","তারা ছিলো"],["يَعْمَلُونَ","ya‘malūna","(to) do","তারা কাজ করে"]],"t":"وَ<h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ لَنُكَفِّرَ<g>نَّ</> عَنْهُمْ سَيِّـَٔاتِهِمْ وَلَنَ<q>جْ</>زِيَ<g>نَّ</>هُمْ أَحْسَنَ <h>ٱ</>لَّذِى كَانُو<s>ا۟</> يَعْمَ<p>لُو</>نَ"},{"n":8,"w":[["وَوَصَّيْنَا","wawaṣṣaynā","And We have enjoined","এবং জোর নির্দেশ দিয়েছি আমরা"],["ٱلْإِنسَـٰنَ","l-insāna","(on) man","মানুষকে"],["بِوَٰلِدَيْهِ","biwālidayhi","goodness to his parents","কাছে তার পিতা-মাতার প্রতি"],["حُسْنًۭا ۖ","ḥus'nan","goodness to his parents","উত্তম (ব্যবহারের)"],["وَإِن","wa-in","but if","কিন্তু যদি"],["جَـٰهَدَاكَ","jāhadāka","they both strive against you","তোমাকে দু'জনে চাপ দেয়"],["لِتُشْرِكَ","litush'rika","to make you associate","যেন তুমি শিরক করো"],["بِى","bī","with Me","সাথে আমার"],["مَا","mā","what","যার"],["لَيْسَ","laysa","not","নেই"],["لَكَ","laka","you have","তোমার"],["بِهِۦ","bihi","of it","সম্পর্কে সে"],["عِلْمٌۭ","‘il'mun","any knowledge","কোনো জ্ঞান"],["فَلَا","falā","then (do) not","তাহ'লে না"],["تُطِعْهُمَآ ۚ","tuṭi‘'humā","obey both of them","অনুগত্য করো তাদের দু'য়ের"],["إِلَىَّ","ilayya","To Me","দিকে আমারই"],["مَرْجِعُكُمْ","marji‘ukum","(is) your return","প্রত্যাবর্তন তোমাদের (হবে)"],["فَأُنَبِّئُكُم","fa-unabbi-ukum","and I will inform you","তখন আমি জানিয়ে দিবো তোমাদেরকে"],["بِمَا","bimā","about what","ঐ বিষয়ে যা"],["كُنتُمْ","kuntum","you used","তোমরা ছিলে"],["تَعْمَلُونَ","ta‘malūna","(to) do","তোমরা কাজ করে"]],"t":"وَوَصَّيْنَا <h>ٱ</>لْإِ<k>نسَٰ</>نَ بِ<m>وَٰ</>لِدَيْهِ حُسْ<d>نًۭا ۖ وَ</>إِ<k>ن جَٰ</>هَدَاكَ لِتُشْرِكَ بِى مَا لَيْسَ لَكَ بِ<m>هِۦ</> عِلْ<k>مٌۭ فَ</>لَا تُطِعْهُ<o>مَآ ۚ</> إِلَىَّ مَرْجِعُكُمْ فَأُنَبِّئُ<f>كُم بِ</>مَا كُ<k>نتُ</>مْ تَعْمَ<p>لُو</>نَ"},{"n":9,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["وَعَمِلُوا۟","wa‘amilū","and do","ও কাজ করেছে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","righteous deeds","সৎ"],["لَنُدْخِلَنَّهُمْ","lanud'khilannahum","We will surely admit them","অবশ্যই আমরা প্রবেশ করবো তাদেরকে"],["فِى","fī","among","মধ্যে"],["ٱلصَّـٰلِحِينَ","l-ṣāliḥīna","the righteous","সৎকর্মশীলদের"]],"t":"وَ<h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ لَنُ<q>دْ</>خِلَ<g>نَّ</>هُمْ فِى <h>ٱ</><l>ل</><m>صَّٰ</>لِ<p>حِي</>نَ"},{"n":10,"w":[["وَمِنَ","wamina","And of","এবং মধ্যে"],["ٱلنَّاسِ","l-nāsi","the people","মানুষের"],["مَن","man","(is he) who","কেউ কেউ"],["يَقُولُ","yaqūlu","says","বলে"],["ءَامَنَّا","āmannā","We believe","\"ঈমান এনেছি আমরা"],["بِٱللَّهِ","bil-lahi","in Allah","প্রতি আল্লাহ্‌র\""],["فَإِذَآ","fa-idhā","But when","অতঃপর যখন"],["أُوذِىَ","ūdhiya","he is harmed","তারা নির্যাতিত হয়"],["فِى","fī","in","পথে"],["ٱللَّهِ","l-lahi","(the Way of) Allah","আল্লাহ্‌র"],["جَعَلَ","ja‘ala","he considers","গণ্য করে"],["فِتْنَةَ","fit'nata","(the) trial","পীড়নকে"],["ٱلنَّاسِ","l-nāsi","(of) the people","মানুষের"],["كَعَذَابِ","ka‘adhābi","as (the) punishment","শাস্তির মতো"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহ্‌র"],["وَلَئِن","wala-in","But if","এবং অবশ্যই যদি"],["جَآءَ","jāa","comes","আসে"],["نَصْرٌۭ","naṣrun","victory","কোনো সাহায্য"],["مِّن","min","from","পক্ষ হ'তে"],["رَّبِّكَ","rabbika","your Lord","তোমার রবের"],["لَيَقُولُنَّ","layaqūlunna","surely they say","অবশ্যই তারা বলবেই"],["إِنَّا","innā","Indeed, we","\"নিশ্চয়ই আমরা"],["كُنَّا","kunnā","were","আমরা ছিলাম"],["مَعَكُمْ ۚ","ma‘akum","with you","সাথে তোমাদের\""],["أَوَلَيْسَ","awalaysa","Is not","কি নন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ্‌"],["بِأَعْلَمَ","bi-a‘lama","most knowing","খুব অবহিত"],["بِمَا","bimā","of what","ঐ বিষয়ে যা"],["فِى","fī","(is) in","মধ্যে (আছে)"],["صُدُورِ","ṣudūri","(the) breasts","অন্তরসমূহের"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","(of) the worlds","বিশ্ববাসীর"]],"t":"وَمِنَ <h>ٱ</><l>ل</><g>نَّ</>اسِ <d>مَن يَ</>قُولُ ءَامَ<g>نَّ</>ا بِ<h>ٱ</>للَّهِ فَإِ<o>ذَآ</> أُوذِىَ فِى <h>ٱ</>للَّهِ جَعَلَ فِتْنَةَ <h>ٱ</><l>ل</><g>نَّ</>اسِ كَعَذَابِ <h>ٱ</>للَّهِ وَلَئِ<k>ن جَ</><o>آ</>ءَ نَصْ<d>رٌۭ مِّ</><w>ن رَّ</>بِّكَ لَيَقُولُ<g>نَّ</> إِ<g>نَّ</>ا كُ<g>نَّ</>ا مَعَكُمْ ۚ أَوَلَيْسَ <h>ٱ</>للَّهُ بِأَعْلَمَ بِمَا فِى صُدُورِ <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":11,"w":[["وَلَيَعْلَمَنَّ","walaya‘lamanna","And Allah will surely make evident","এবং অবশ্যই জেনে নিবেন"],["ٱللَّهُ","l-lahu","And Allah will surely make evident","আল্লাহ্‌ (বাস্তব ময়দানে)"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["وَلَيَعْلَمَنَّ","walaya‘lamanna","And He will surely make evident","এবং অবশ্যই (বাস্তবে) জেনে নিবেন"],["ٱلْمُنَـٰفِقِينَ","l-munāfiqīna","the hypocrites","মুনাফিকদেরকে"]],"t":"وَلَيَعْلَمَ<g>نَّ</> <h>ٱ</>للَّهُ <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَلَيَعْلَمَ<g>نَّ</> <h>ٱ</>لْمُ<m>نَٰ</>فِ<p>قِي</>نَ"},{"n":12,"w":[["وَقَالَ","waqāla","And said","এবং বলে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieve","অস্বীকার করেছে"],["لِلَّذِينَ","lilladhīna","to those who","(তাদের)-কে যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["ٱتَّبِعُوا۟","ittabi‘ū","Follow","\"তোমরা অনুসরণ করো"],["سَبِيلَنَا","sabīlanā","our way","পথকে আমাদের"],["وَلْنَحْمِلْ","walnaḥmil","and we will carry","আর অবশ্যই আমরা বহন করবো"],["خَطَـٰيَـٰكُمْ","khaṭāyākum","your sins","ত্রুটিগুলোর (পাপরাশিকে)তোমাদের\""],["وَمَا","wamā","But not","কিন্তু না"],["هُم","hum","they","তারা"],["بِحَـٰمِلِينَ","biḥāmilīna","(are) going to carry","বহনকারী হবে"],["مِنْ","min","of","হ'তে"],["خَطَـٰيَـٰهُم","khaṭāyāhum","their sins","ত্রুটিগুলোর (পাপরাশিকে)তোমাদের"],["مِّن","min","any","কোনো"],["شَىْءٍ ۖ","shayin","thing","কিছুই"],["إِنَّهُمْ","innahum","Indeed, they","নিশ্চয়ই তারা"],["لَكَـٰذِبُونَ","lakādhibūna","(are) surely liars","অবশ্যই মিথ্যাবাদী"]],"t":"وَقَالَ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> لِلَّذِينَ ءَامَنُو<s>ا۟</> <h>ٱ</>تَّبِعُو<s>ا۟</> سَبِيلَنَا وَلْنَحْمِلْ خَ<m>طَٰيَٰ</>كُمْ وَمَا <f>هُم بِ</><m>حَٰ</>مِلِينَ مِنْ خَ<m>طَٰيَٰ</><y>هُم مِّ</><k>ن شَ</>ىْءٍ ۖ إِ<g>نَّ</>هُمْ لَ<m>كَٰ</>ذِ<p>بُو</>نَ"},{"n":13,"w":[["وَلَيَحْمِلُنَّ","walayaḥmilunna","But surely they will carry","এবং অবশ্যই তারা বহন করবেই"],["أَثْقَالَهُمْ","athqālahum","their burdens","বোঝাসমূহকে তাদের"],["وَأَثْقَالًۭا","wa-athqālan","and burdens","এবং বোঝাসমূহকে (অন্য অনেক)"],["مَّعَ","ma‘a","with","সাথে"],["أَثْقَالِهِمْ ۖ","athqālihim","their burdens","বোঝাসমূহের তাদের"],["وَلَيُسْـَٔلُنَّ","walayus'alunna","and surely they will be questioned","এবং অবশ্যই তাদেরকে  জিজ্ঞাসা করা হবে"],["يَوْمَ","yawma","(on the) Day","দিনে"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) the Resurrection","ক্বিয়ামাতের"],["عَمَّا","‘ammā","about what","ঐ সম্পর্কে যা"],["كَانُوا۟","kānū","they used","তারা ছিলো"],["يَفْتَرُونَ","yaftarūna","(to) invent","তারা মিথ্যা রচনা করে আসছে"]],"t":"وَلَيَحْمِلُ<g>نَّ</> أَثْقَالَهُمْ وَأَثْقَالًۭ<d>ا مَّ</>عَ أَثْقَالِهِمْ ۖ وَلَيُسْـَٔلُ<g>نَّ</> يَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ عَ<g>مَّ</>ا كَانُو<s>ا۟</> يَفْتَ<p>رُو</>نَ"},{"n":14,"w":[["وَلَقَدْ","walaqad","And verily","এবং নিশ্চয়ই"],["أَرْسَلْنَا","arsalnā","We sent","আমরা পাঠিয়েছিলাম"],["نُوحًا","nūḥan","Nuh","নূহকে"],["إِلَىٰ","ilā","to","প্রতি"],["قَوْمِهِۦ","qawmihi","his people","তার জাতির"],["فَلَبِثَ","falabitha","and he remained","অতঃপর সে অবস্থান করেছিলো"],["فِيهِمْ","fīhim","among them","মধ্যে তাদের"],["أَلْفَ","alfa","a thousand","এক হাজার"],["سَنَةٍ","sanatin","year(s)","ব্ছর"],["إِلَّا","illā","save","কম"],["خَمْسِينَ","khamsīna","fifty","পঞ্চাশ"],["عَامًۭا","‘āman","year(s)","ব্ছর (অর্থাৎ সাড়ে নয়শত বছর)"],["فَأَخَذَهُمُ","fa-akhadhahumu","then seized them","অতঃপর গ্রাস করেছিলো তাদেরকে"],["ٱلطُّوفَانُ","l-ṭūfānu","the flood","প্লাবন"],["وَهُمْ","wahum","while they","এ অবস্থায় যে তারা ছিলো"],["ظَـٰلِمُونَ","ẓālimūna","(were) wrongdoers","সীমালঙ্ঘনকারী"]],"t":"وَلَقَ<q>دْ</> أَرْسَلْنَا نُوحًا إِلَىٰ قَوْمِ<m>هِۦ</> فَلَبِثَ فِيهِمْ أَلْفَ سَنَةٍ إِلَّا خَمْسِينَ عَا<k>مًۭا فَ</>أَخَذَهُمُ <h>ٱ</><l>ل</>طُّوفَانُ وَهُمْ <m>ظَٰ</>لِ<p>مُو</>نَ"},{"n":15,"w":[["فَأَنجَيْنَـٰهُ","fa-anjaynāhu","But We saved him","অতঃপর আমরা রক্ষা করলাম তাকে"],["وَأَصْحَـٰبَ","wa-aṣḥāba","and (the) people","এবং সাথীদেরকে (অর্থাৎ আরোহীদেরকেও)"],["ٱلسَّفِينَةِ","l-safīnati","(of) the ship","নৌকার"],["وَجَعَلْنَـٰهَآ","waja‘alnāhā","and We made it","এবং আমরা করেছি তা"],["ءَايَةًۭ","āyatan","a Sign","একটি নিদর্শন"],["لِّلْعَـٰلَمِينَ","lil'‘ālamīna","for the worlds","জন্যে বিশ্ববাসীদের"]],"t":"فَأَ<k>نجَ</>يْ<m>نَٰ</>هُ وَأَصْ<m>حَٰ</>بَ <h>ٱ</><l>ل</>سَّفِينَةِ وَجَعَلْ<m>نَٰ</><o>هَآ</> ءَايَ<w>ةًۭ لِّ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":16,"w":[["وَإِبْرَٰهِيمَ","wa-ib'rāhīma","And Ibrahim ","এবং (স্মরণ করো) ইবরাহীমের (কথা)"],["إِذْ","idh","when","যখন"],["قَالَ","qāla","he said","সে বলেছিলো"],["لِقَوْمِهِ","liqawmihi","to his people","উদ্দেশ্যে তার জাতির"],["ٱعْبُدُوا۟","u‘'budū","Worship","\"তোমরা ইবাদাত করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌র"],["وَٱتَّقُوهُ ۖ","wa-ittaqūhu","and fear Him","এবং তাঁকেই ভয় করো"],["ذَٰلِكُمْ","dhālikum","That","এটাই"],["خَيْرٌۭ","khayrun","(is) better","উত্তম"],["لَّكُمْ","lakum","for you","জন্যে তোমাদের"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you","তোমরা ছিলে"],["تَعْلَمُونَ","ta‘lamūna","know","তোমরা জানতে"]],"t":"وَإِ<q>بْ</><m>رَٰ</>هِيمَ إِذْ قَالَ لِقَوْمِهِ <h>ٱ</>عْبُدُو<s>ا۟</> <h>ٱ</>للَّهَ وَ<h>ٱ</>تَّقُوهُ ۖ <m>ذَٰ</>لِكُمْ خَيْ<w>رٌۭ لَّ</>كُمْ إِ<k>ن كُنتُ</>مْ تَعْلَ<p>مُو</>نَ"},{"n":17,"w":[["إِنَّمَا","innamā","Only","কেবল"],["تَعْبُدُونَ","ta‘budūna","you worship","তোমরা উপাসনা করছো"],["مِن","min","besides","মধ্য হতে"],["دُونِ","dūni","besides","ছাড়া"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌"],["أَوْثَـٰنًۭا","awthānan","idols","মূর্তিগুলোকে"],["وَتَخْلُقُونَ","watakhluqūna","and you create","এবং তোমরা বানাচ্ছো"],["إِفْكًا ۚ","if'kan","falsehood","মিথ্যা"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those whom","যাদেরকে"],["تَعْبُدُونَ","ta‘budūna","you worship","তোমরা উপাসনা করছো"],["مِن","min","besides","মধ্য হতে"],["دُونِ","dūni","besides","ছাড়া"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌"],["لَا","lā","(do) not","না"],["يَمْلِكُونَ","yamlikūna","possess","তারা ক্ষমতা রাখে"],["لَكُمْ","lakum","for you","জন্যে তোমাদের"],["رِزْقًۭا","riz'qan","any provision","জীবিকা(দেয়ার)"],["فَٱبْتَغُوا۟","fa-ib'taghū","So seek","সুতরাং তোমরা চাও"],["عِندَ","‘inda","from","নিকট"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌র"],["ٱلرِّزْقَ","l-riz'qa","the provision","জীবিকা"],["وَٱعْبُدُوهُ","wa-u‘'budūhu","and worship Him","এবং তোমরা ইবাদাত করো তাঁরই"],["وَٱشْكُرُوا۟","wa-ush'kurū","and be grateful","এবং তোমরা কৃতজ্ঞতা প্রকাশ করো"],["لَهُۥٓ ۖ","lahu","to Him","তাঁরই"],["إِلَيْهِ","ilayhi","To Him","দিকে তাঁরই"],["تُرْجَعُونَ","tur'ja‘ūna","you will be returned","তোমরা প্রত্যাবর্তিত হবে"]],"t":"إِ<g>نَّ</>مَا تَعْبُدُونَ مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ أَوْ<m>ثَٰ</><d>نًۭا وَ</>تَخْلُقُونَ إِفْكًا ۚ إِ<g>نَّ</> <h>ٱ</>لَّذِينَ تَعْبُدُونَ مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ لَا يَمْلِكُونَ لَكُمْ رِزْ<k>قًۭا فَ</><h>ٱ</><q>بْ</>تَغُو<s>ا۟</> عِ<k>ندَ</> <h>ٱ</>للَّهِ <h>ٱ</><l>ل</>رِّزْقَ وَ<h>ٱ</>عْبُدُوهُ وَ<h>ٱ</>شْكُرُو<s>ا۟</> لَهُ<o>ۥٓ ۖ</> إِلَيْهِ تُرْجَ<p>عُو</>نَ"},{"n":18,"w":[["وَإِن","wa-in","And if","আর যদি"],["تُكَذِّبُوا۟","tukadhibū","you deny","তোমরা মিথ্যা আরোপ করো"],["فَقَدْ","faqad","then verily","নিশ্চয়ই তবে"],["كَذَّبَ","kadhaba","denied","মিথ্যারোপ করেছিলো"],["أُمَمٌۭ","umamun","(the) nations","(অনেক) জাতি"],["مِّن","min","before you","থেকেও"],["قَبْلِكُمْ ۖ","qablikum","before you","তোমাদের পূর্ব"],["وَمَا","wamā","And not","আর না"],["عَلَى","‘alā","(is) on","উপর"],["ٱلرَّسُولِ","l-rasūli","the Messenger","(দায়িত্ব) রাসূলের"],["إِلَّا","illā","except","এ ছাড়া যে"],["ٱلْبَلَـٰغُ","l-balāghu","the conveyance","পৌঁছানো"],["ٱلْمُبِينُ","l-mubīnu","clear","সুস্পষ্টভাবে\""]],"t":"وَإِ<k>ن تُ</>كَذِّبُو<s>ا۟</> فَقَ<q>دْ</> كَذَّبَ أُمَ<d>مٌۭ مِّ</><k>ن قَ</><q>بْ</>لِكُمْ ۖ وَمَا عَلَى <h>ٱ</><l>ل</>رَّسُولِ إِلَّا <h>ٱ</>لْبَ<m>لَٰ</>غُ <h>ٱ</>لْمُ<p>بِي</>نُ"},{"n":19,"w":[["أَوَلَمْ","awalam","Do not","কি না"],["يَرَوْا۟","yaraw","they see","তারা লক্ষ্য করে"],["كَيْفَ","kayfa","how","কিভাবে"],["يُبْدِئُ","yub'di-u","Allah originates","অস্তিত্ব দেন"],["ٱللَّهُ","l-lahu","Allah originates","আল্লাহ্‌"],["ٱلْخَلْقَ","l-khalqa","the creation","সৃষ্টিকে"],["ثُمَّ","thumma","then","এরপর"],["يُعِيدُهُۥٓ ۚ","yu‘īduhu","repeats it","পুনঃসৃষ্টি করবেন তা"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ذَٰلِكَ","dhālika","that","এটা"],["عَلَى","‘alā","for","জন্যে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌র"],["يَسِيرٌۭ","yasīrun","(is) easy","সহজ"]],"t":"أَوَلَمْ يَرَوْ<s>ا۟</> كَيْفَ يُ<q>بْ</>دِئُ <h>ٱ</>للَّهُ <h>ٱ</>لْخَلْقَ ثُ<g>مَّ</> يُعِيدُهُ<o>ۥٓ ۚ</> إِ<g>نَّ</> <m>ذَٰ</>لِكَ عَلَى <h>ٱ</>للَّهِ يَ<p>سِي</>رٌۭ"},{"n":20,"w":[["قُلْ","qul","Say","বলো"],["سِيرُوا۟","sīrū","Travel","\"তোমরা ভ্রমণ করো"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["فَٱنظُرُوا۟","fa-unẓurū","and see","অতঃপর লক্ষ্য করো"],["كَيْفَ","kayfa","how","কিভাবে"],["بَدَأَ","bada-a","He originated","তিনি সূচনা করেছেন"],["ٱلْخَلْقَ ۚ","l-khalqa","the creation","সৃষ্টির"],["ثُمَّ","thumma","Then","এরপর"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ্‌"],["يُنشِئُ","yunshi-u","will produce","সৃষ্টি করবেন"],["ٱلنَّشْأَةَ","l-nashata","the creation","সৃষ্টি"],["ٱلْـَٔاخِرَةَ ۚ","l-ākhirata","the last","পরবর্তী"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["عَلَىٰ","‘alā","on","উপর"],["كُلِّ","kulli","every","সব"],["شَىْءٍۢ","shayin","thing","কিছুর"],["قَدِيرٌۭ","qadīrun","(is) All-Powerful","সর্বশক্তিমান\""]],"t":"قُلْ سِيرُو<s>ا۟</> فِى <h>ٱ</>لْأَرْضِ فَ<h>ٱ</><k>نظُ</>رُو<s>ا۟</> كَيْفَ بَدَأَ <h>ٱ</>لْخَلْقَ ۚ ثُ<g>مَّ</> <h>ٱ</>للَّهُ يُ<k>نشِ</>ئُ <h>ٱ</><l>ل</><g>نَّ</>شْأَةَ <h>ٱ</>لْءَاخِرَةَ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ عَلَىٰ كُلِّ <k>شَىْءٍۢ قَ</><p>دِي</>رٌۭ"},{"n":21,"w":[["يُعَذِّبُ","yu‘adhibu","He punishes","তিনি শাস্তি দিবেন"],["مَن","man","whom","যাকে"],["يَشَآءُ","yashāu","He wills","তিনি চান"],["وَيَرْحَمُ","wayarḥamu","and has mercy","ও অনুগ্রহ করবেন"],["مَن","man","(on) whom","যাকে"],["يَشَآءُ ۖ","yashāu","He wills","ইচ্ছে করবেন"],["وَإِلَيْهِ","wa-ilayhi","and to Him","এবং দিকে তাঁরই"],["تُقْلَبُونَ","tuq'labūna","you will be returned","তোমরা প্রত্যাবর্তিত হবে"]],"t":"يُعَذِّبُ <d>مَن يَ</><o>شَآ</>ءُ وَيَرْحَمُ <d>مَن يَ</><o>شَآ</>ءُ ۖ وَإِلَيْهِ تُ<q>قْ</>لَ<p>بُو</>نَ"},{"n":22,"w":[["وَمَآ","wamā","And not","এবং না"],["أَنتُم","antum","you","তোমরা"],["بِمُعْجِزِينَ","bimu‘'jizīna","can escape","(আল্লাহকে)অক্ষমকারী"],["فِى","fī","in","(না) মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["وَلَا","walā","and not","আর না"],["فِى","fī","in","মধ্যে"],["ٱلسَّمَآءِ ۖ","l-samāi","the heaven","আকাশের"],["وَمَا","wamā","And not","এবং না (আছে)"],["لَكُم","lakum","for you","জন্যে তোমাদের"],["مِّن","min","besides","থেকে"],["دُونِ","dūni","besides","ছাড়া"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌"],["مِن","min","any","কোনো"],["وَلِىٍّۢ","waliyyin","protector","অভিভাবক"],["وَلَا","walā","and not","আর না আছে"],["نَصِيرٍۢ","naṣīrin","a helper","কোনো সাহায্যকারী"]],"t":"وَ<o>مَآ</> أَ<k>نتُ</><f>م بِ</>مُعْجِزِينَ فِى <h>ٱ</>لْأَرْضِ وَلَا فِى <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ ۖ وَمَا لَ<y>كُم مِّ</><k>ن دُ</>ونِ <h>ٱ</>للَّهِ <d>مِن وَلِىٍّۢ وَ</>لَا نَ<p>صِي</>رٍۢ"},{"n":23,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["كَفَرُوا۟","kafarū","disbelieve","অস্বীকার করেছে"],["بِـَٔايَـٰتِ","biāyāti","in (the) Signs","প্রতি নিদর্শনসমূহের"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহ্‌র"],["وَلِقَآئِهِۦٓ","waliqāihi","and (the) meeting (with) Him","ও সাক্ষাতের তাঁর"],["أُو۟لَـٰٓئِكَ","ulāika","those","ঐ সব লোক"],["يَئِسُوا۟","ya-isū","(have) despaired","নিরাশ হয়েছে"],["مِن","min","of","হ'তে"],["رَّحْمَتِى","raḥmatī","My Mercy","আমার অনুগ্রহ"],["وَأُو۟لَـٰٓئِكَ","wa-ulāika","And those","আর ঐসব লোক"],["لَهُمْ","lahum","for them","জন্যে তাদের (রয়েছে)"],["عَذَابٌ","‘adhābun","(is) a punishment","শাস্তি"],["أَلِيمٌۭ","alīmun","painful","নিদারুণ"]],"t":"وَ<h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> بِـَٔا<m>يَٰ</>تِ <h>ٱ</>للَّهِ وَلِ<o>قَآئِهِۦٓ</> أُ<s>و۟</><o>لَٰٓ</>ئِكَ يَئِسُو<s>ا۟</> <w>مِن رَّ</>حْمَتِى وَأُ<s>و۟</><o>لَٰٓ</>ئِكَ لَهُمْ عَذَابٌ أَ<p>لِي</>مٌۭ"},{"n":24,"w":[["فَمَا","famā","And not","অতঃপর না"],["كَانَ","kāna","was","ছিলো"],["جَوَابَ","jawāba","(the) answer","জবাব"],["قَوْمِهِۦٓ","qawmihi","(of) his people","জাতির তার"],["إِلَّآ","illā","except","এ ছাড়া"],["أَن","an","that","যে"],["قَالُوا۟","qālū","they said","তারা বললো"],["ٱقْتُلُوهُ","uq'tulūhu","Kill him","\"তোমরা তাকে হত্যা করো"],["أَوْ","aw","or","অথবা"],["حَرِّقُوهُ","ḥarriqūhu","burn him","তাকে অাগুনে পোড়াও\""],["فَأَنجَىٰهُ","fa-anjāhu","But Allah saved him","অতঃপর রক্ষা করলেন তাকে"],["ٱللَّهُ","l-lahu","But Allah saved him","আল্লাহ্‌"],["مِنَ","mina","from","হ'তে"],["ٱلنَّارِ ۚ","l-nāri","the fire","আগুন"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে (আছে)"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَـٰتٍۢ","laāyātin","surely (are) Signs","অবশ্যই নিদর্শনাবলী"],["لِّقَوْمٍۢ","liqawmin","for a people","জন্যে সম্প্রদায়ের"],["يُؤْمِنُونَ","yu'minūna","who believe","(যারা) ঈমান আনে"]],"t":"فَمَا كَانَ جَوَابَ قَوْمِ<o>هِۦٓ</> إِ<o>لَّآ</> أَ<k>ن قَ</>الُو<s>ا۟</> <h>ٱ</><q>قْ</>تُلُوهُ أَوْ حَرِّقُوهُ فَأَ<k>نجَ</><m>ىٰ</>هُ <h>ٱ</>للَّهُ مِنَ <h>ٱ</><l>ل</><g>نَّ</>ارِ ۚ إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَا<m>يَٰ</><w>تٍۢ لِّ</>قَوْ<d>مٍۢ يُ</>ؤْمِ<p>نُو</>نَ"},{"n":25,"w":[["وَقَالَ","waqāla","And he said","এবং সে বলেছিলো"],["إِنَّمَا","innamā","Only","\"মূলতঃ"],["ٱتَّخَذْتُم","ittakhadhtum","you have taken","তোমরা গ্রহণ করেছো"],["مِّن","min","besides","থেকে"],["دُونِ","dūni","besides","ছাড়া"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌"],["أَوْثَـٰنًۭا","awthānan","idols","মূর্তিগুলোকে"],["مَّوَدَّةَ","mawaddata","(out of) love","বন্ধুত্ব রক্ষার (উপায় হিসাবে)"],["بَيْنِكُمْ","baynikum","among you","মাঝে তোমাদের"],["فِى","fī","in","মধ্যে"],["ٱلْحَيَوٰةِ","l-ḥayati","the life","জীবনের"],["ٱلدُّنْيَا ۖ","l-dun'yā","(of) the world","পার্থিব"],["ثُمَّ","thumma","Then","এরপর"],["يَوْمَ","yawma","(on the) Day","দিনে"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) the Resurrection","ক্বিয়ামাতের"],["يَكْفُرُ","yakfuru","you will deny","অস্বীকার করবে"],["بَعْضُكُم","ba‘ḍukum","one another","একে তোমাদের"],["بِبَعْضٍۢ","biba‘ḍin","one another","প্রতি অপরের"],["وَيَلْعَنُ","wayal‘anu","and curse","ও অভিশাপ দিবে"],["بَعْضُكُم","ba‘ḍukum","one another","একে তোমাদের"],["بَعْضًۭا","ba‘ḍan","one another","অপরকে"],["وَمَأْوَىٰكُمُ","wamawākumu","and your abode","এবং তোমাদের আবাস (হবে)"],["ٱلنَّارُ","l-nāru","(will be) the Fire","আগুন"],["وَمَا","wamā","and not","ও না"],["لَكُم","lakum","for you","জন্যে (থাকবে)তোমাদের"],["مِّن","min","any","কোনো"],["نَّـٰصِرِينَ","nāṣirīna","helpers","সাহায্যকারী\""]],"t":"وَقَالَ إِ<g>نَّ</>مَا <h>ٱ</>تَّخَذْ<y>تُم مِّ</><k>ن دُ</>ونِ <h>ٱ</>للَّهِ أَوْ<m>ثَٰ</><d>نًۭا مَّ</>وَدَّةَ بَيْنِكُمْ فِى <h>ٱ</>لْحَيَ<s>وٰ</>ةِ <h>ٱ</><l>ل</>دُّنْيَا ۖ ثُ<g>مَّ</> يَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ يَكْفُرُ بَعْضُ<f>كُم بِ</>بَعْ<d>ضٍۢ وَ</>يَلْعَنُ بَعْضُ<f>كُم بَ</>عْ<d>ضًۭا وَ</>مَأْوَ<m>ىٰ</>كُمُ <h>ٱ</><l>ل</><g>نَّ</>ارُ وَمَا لَ<y>كُم مِّ</><d>ن نَّٰ</>صِ<p>رِي</>نَ"},{"n":26,"w":[["۞ فَـَٔامَنَ","faāmana","And believed","তখন ঈমান আনলো"],["لَهُۥ","lahu","[in] him","প্রতি তাঁর"],["لُوطٌۭ ۘ","lūṭun","Lut","লূত"],["وَقَالَ","waqāla","and he said","এবং (ইবরাহীম) বললো"],["إِنِّى","innī","Indeed I (am)","\"নিশ্চয়ই আমি"],["مُهَاجِرٌ","muhājirun","emigrating","হিজরতকারী"],["إِلَىٰ","ilā","to","দিকে"],["رَبِّىٓ ۖ","rabbī","my Lord","আমার রবের"],["إِنَّهُۥ","innahu","Indeed, He","নিশ্চয়ই তিনি"],["هُوَ","huwa","[He] (is)","তিনিই"],["ٱلْعَزِيزُ","l-‘azīzu","the All-Mighty","মহাপরাক্রমশালী"],["ٱلْحَكِيمُ","l-ḥakīmu","the All-Wise","প্রজ্ঞাময়\""]],"t":"۞ فَـَٔامَنَ لَهُ<m>ۥ</> لُو<d>طٌۭ ۘ وَ</>قَالَ إِ<g>نِّ</>ى مُهَاجِرٌ إِلَىٰ رَ<o>بِّىٓ ۖ</> إِ<g>نَّ</>هُ<m>ۥ</> هُوَ <h>ٱ</>لْعَزِيزُ <h>ٱ</>لْحَ<p>كِي</>مُ"},{"n":27,"w":[["وَوَهَبْنَا","wawahabnā","And We granted","এবং আমরা দান করলাম"],["لَهُۥٓ","lahu","to him","জন্যে তার"],["إِسْحَـٰقَ","is'ḥāqa","Isaac","ইসহাককে"],["وَيَعْقُوبَ","waya‘qūba","and Yaqub","ও ইয়াকুবকে"],["وَجَعَلْنَا","waja‘alnā","and We placed","এবং আমরা স্হির করলাম"],["فِى","fī","in","মধ্যে"],["ذُرِّيَّتِهِ","dhurriyyatihi","his offsprings","বংশধরদের তার"],["ٱلنُّبُوَّةَ","l-nubuwata","the Prophethood","নবুয়্যত"],["وَٱلْكِتَـٰبَ","wal-kitāba","and the Book","ও  কিতাব"],["وَءَاتَيْنَـٰهُ","waātaynāhu","And We gave him","এবং তাকে দিয়েছি"],["أَجْرَهُۥ","ajrahu","his reward","প্রতিফল তার"],["فِى","fī","in","মধ্যে"],["ٱلدُّنْيَا ۖ","l-dun'yā","the world","দুনিয়ার"],["وَإِنَّهُۥ","wa-innahu","And indeed, he","এবং নিশ্চয়ই সে (হবে)"],["فِى","fī","in","মধ্যে"],["ٱلْـَٔاخِرَةِ","l-ākhirati","the Hereafter","আখেরাতের"],["لَمِنَ","lamina","(is) surely, among","অবশ্যই অন্তর্ভুক্ত"],["ٱلصَّـٰلِحِينَ","l-ṣāliḥīna","the righteous","সৎকর্মশীলদের"]],"t":"وَوَهَ<q>بْ</>نَا لَهُ<o>ۥٓ</> إِسْ<m>حَٰ</>قَ وَيَعْقُوبَ وَجَعَلْنَا فِى ذُرِّيَّتِهِ <h>ٱ</><l>ل</><g>نُّ</>بُوَّةَ وَ<h>ٱ</>لْكِ<m>تَٰ</>بَ وَءَاتَيْ<m>نَٰ</>هُ أَ<q>جْ</>رَهُ<m>ۥ</> فِى <h>ٱ</><l>ل</>دُّنْيَا ۖ وَإِ<g>نَّ</>هُ<m>ۥ</> فِى <h>ٱ</>لْءَاخِرَةِ لَمِنَ <h>ٱ</><l>ل</><m>صَّٰ</>لِ<p>حِي</>نَ"},{"n":28,"w":[["وَلُوطًا","walūṭan","And Lut","এবং (স্মরণ করো) লূতের (ঘটনা হলো)"],["إِذْ","idh","when","যখন"],["قَالَ","qāla","he said","বলেছিলো"],["لِقَوْمِهِۦٓ","liqawmihi","to his people","উদ্দেশ্যে তার জাতির"],["إِنَّكُمْ","innakum","Indeed, you","\"নিশ্চয়ই তোমরা"],["لَتَأْتُونَ","latatūna","commit","অবশ্যই তোমরা আছো (করছো)"],["ٱلْفَـٰحِشَةَ","l-fāḥishata","the immorality","(এমন)অশ্লীলকর্মে"],["مَا","mā","not","না"],["سَبَقَكُم","sabaqakum","has preceded you","পূর্বে করেছে তোমাদের"],["بِهَا","bihā","with i