{"n":49,"a":[{"n":1,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you who believe","হে"],["ٱلَّذِينَ","alladhīna","O you who believe","যারা"],["ءَامَنُوا۟","āmanū","O you who believe","ঈমান এনেছ"],["لَا","lā","(Do) not","না"],["تُقَدِّمُوا۟","tuqaddimū","put (yourselves) forward ","তোমরা অগ্রসর হয়ো (কোন বিষয়ে)"],["بَيْنَ","bayna","before Allah","আগে"],["يَدَىِ","yadayi","before Allah","আগে"],["ٱللَّهِ","l-lahi","before Allah","আল্লাহর"],["وَرَسُولِهِۦ ۖ","warasūlihi","and His Messenger","ও তাঁর রাসুলের"],["وَٱتَّقُوا۟","wa-ittaqū","and fear Allah","এবং ভয় করো"],["ٱللَّهَ ۚ","l-laha","and fear Allah","আল্লাহকে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["سَمِيعٌ","samī‘un","(is) All-Hearer","সবকিছু শুনেন"],["عَلِيمٌۭ","‘alīmun","All-Knower","সবকিছু জানেন"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> لَا تُقَدِّمُو<s>ا۟</> بَيْنَ يَدَىِ <h>ٱ</>للَّهِ وَرَسُولِ<m>هِۦ</> ۖ وَ<h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</>للَّهَ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ سَمِيعٌ عَ<p>لِي</>مٌۭ"},{"n":2,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you who believe","হে"],["ٱلَّذِينَ","alladhīna","O you who believe","যারা"],["ءَامَنُوا۟","āmanū","O you who believe","ঈমান এনেছ"],["لَا","lā","(Do) not","না"],["تَرْفَعُوٓا۟","tarfa‘ū","raise","তোমরা উঁচু করো"],["أَصْوَٰتَكُمْ","aṣwātakum","your voices","তোমাদের কন্ঠস্বরকে"],["فَوْقَ","fawqa","above","উপর"],["صَوْتِ","ṣawti","(the) voice","কন্ঠস্বরের"],["ٱلنَّبِىِّ","l-nabiyi","(of) the Prophet","নবীর"],["وَلَا","walā","and (do) not","এবং না"],["تَجْهَرُوا۟","tajharū","be loud","তোমরা উচ্চ করো (আওয়াজ)"],["لَهُۥ","lahu","to him","তাঁর সাথে"],["بِٱلْقَوْلِ","bil-qawli","in speech","কথা বলার ক্ষেত্রে"],["كَجَهْرِ","kajahri","like (the) loudness","যেমন উচ্চ হয় (আওয়াজ)"],["بَعْضِكُمْ","ba‘ḍikum","(of) some of you","তোমাদের একে"],["لِبَعْضٍ","liba‘ḍin","to others","অপরের (সাথে)"],["أَن","an","lest","(এমন না হয়) যে"],["تَحْبَطَ","taḥbaṭa","become worthless","নষ্ট হয়ে যায়"],["أَعْمَـٰلُكُمْ","a‘mālukum","your deeds","তোমাদের আমলগুলো"],["وَأَنتُمْ","wa-antum","while you","এবং তোমরা"],["لَا","lā","(do) not","না"],["تَشْعُرُونَ","tash‘urūna","perceive","টেরও পাবে"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> لَا تَرْفَ<o>عُوٓ</><s>ا۟</> أَصْ<m>وَٰ</>تَكُمْ فَوْقَ صَوْتِ <h>ٱ</><l>ل</><g>نَّ</>بِىِّ وَلَا تَ<q>جْ</>هَرُو<s>ا۟</> لَهُ<m>ۥ</> بِ<h>ٱ</>لْقَوْلِ كَجَهْرِ بَعْضِكُمْ لِبَعْضٍ أَ<k>ن تَ</>حْبَطَ أَعْ<m>مَٰ</>لُكُمْ وَأَ<k>نتُ</>مْ لَا تَشْعُ<p>رُو</>نَ"},{"n":3,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["يَغُضُّونَ","yaghuḍḍūna","lower","নিচু রাখে"],["أَصْوَٰتَهُمْ","aṣwātahum","their voices","তাদের আওয়াজ"],["عِندَ","‘inda","(in) presence","নিকট"],["رَسُولِ","rasūli","(of the) Messenger of Allah ","রাসুলের"],["ٱللَّهِ","l-lahi","(of the) Messenger of Allah ","আল্লাহর"],["أُو۟لَـٰٓئِكَ","ulāika","those","ঐসব লোক"],["ٱلَّذِينَ","alladhīna","(are) the ones","(তারাই) যাদের"],["ٱمْتَحَنَ","im'taḥana","Allah has tested","যাচাই করে নিয়েছেন"],["ٱللَّهُ","l-lahu","Allah has tested","আল্লাহ্"],["قُلُوبَهُمْ","qulūbahum","their hearts","তাদের অন্তরসমূহকে"],["لِلتَّقْوَىٰ ۚ","lilttaqwā","for righteousness","তাকওয়ার জন্য"],["لَهُم","lahum","For them","তাদের জন্যে রয়েছে"],["مَّغْفِرَةٌۭ","maghfiratun","(is) forgiveness","ক্ষমা"],["وَأَجْرٌ","wa-ajrun","and a reward","ও পুরস্কার"],["عَظِيمٌ","‘aẓīmun","great","মহা"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ يَغُضُّونَ أَصْ<m>وَٰ</>تَهُمْ عِ<k>ندَ</> رَسُولِ <h>ٱ</>للَّهِ أُ<s>و۟</><o>لَٰٓ</>ئِكَ <h>ٱ</>لَّذِينَ <h>ٱ</>مْتَحَنَ <h>ٱ</>للَّهُ قُلُوبَهُمْ لِلتَّ<q>قْ</>وَىٰ ۚ لَ<y>هُم مَّ</>غْفِرَ<d>ةٌۭ وَ</>أَ<q>جْ</>رٌ عَ<p>ظِي</>مٌ"},{"n":4,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["يُنَادُونَكَ","yunādūnaka","call you","তোমাকে ডাকাডাকি করে"],["مِن","min","from","হতে"],["وَرَآءِ","warāi","behind","পেছন"],["ٱلْحُجُرَٰتِ","l-ḥujurāti","the private chambers","কক্ষের"],["أَكْثَرُهُمْ","aktharuhum","most of them","তাদের অধিকাংশই"],["لَا","lā","(do) not","না"],["يَعْقِلُو