وْ<i>مًۢا بِ</>جَ<m>هَٰ</>لَ<k>ةٍۢ فَ</>تُصْبِحُو<s>ا۟</> عَلَىٰ مَا فَعَلْتُمْ <m>نَٰ</>دِ<p>مِي</>نَ"},{"n":7,"w":[["وَٱعْلَمُوٓا۟","wa-i‘'lamū","And know","এবং তোমরা জেনে রাখ"],["أَنَّ","anna","that","যে"],["فِيكُمْ","fīkum","among you","তোমাদের মধ্যে (আছে)"],["رَسُولَ","rasūla","(is the) Messenger of Allah","রাসুল"],["ٱللَّهِ ۚ","l-lahi","(is the) Messenger of Allah","আল্লাহর"],["لَوْ","law","If","যদি"],["يُطِيعُكُمْ","yuṭī‘ukum","he were to obey you","তোমাদের মেনে নেয় সে"],["فِى","fī","in","ভাগ"],["كَثِيرٍۢ","kathīrin","much","বেশির"],["مِّنَ","mina","of","থেকে"],["ٱلْأَمْرِ","l-amri","the matter","ব্যাপারে"],["لَعَنِتُّمْ","la‘anittum","surely you would be in difficulty","তোমরা অবশ্যই কষ্ট পাবে"],["وَلَـٰكِنَّ","walākinna","but","কিন্তু"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["حَبَّبَ","ḥabbaba","has endeared","প্রিয় করেছেন"],["إِلَيْكُمُ","ilaykumu","to you","তোমাদের কাছে"],["ٱلْإِيمَـٰنَ","l-īmāna","the Faith","ঈমানকে"],["وَزَيَّنَهُۥ","wazayyanahu","and has made it pleasing","এবং তা শোভন করে দিয়েছেন"],["فِى","fī","in","মধ্যে"],["قُلُوبِكُمْ","qulūbikum","your hearts","তোমাদের অন্তরের"],["وَكَرَّهَ","wakarraha","and has made hateful","এবং অপ্রিয় করে দিয়েছেন"],["إِلَيْكُمُ","ilaykumu","to you","তোমাদের কাছে"],["ٱلْكُفْرَ","l-kuf'ra","disbelief","কুফরী/ অবিশ্বাস"],["وَٱلْفُسُوقَ","wal-fusūqa","and defiance","ও সত্যত্যাগ"],["وَٱلْعِصْيَانَ ۚ","wal-‘iṣ'yāna","and disobedience","এবং অবাধ্যতা (প্রতি)"],["أُو۟لَـٰٓئِكَ","ulāika","Those","এসব লোক"],["هُمُ","humu","(are) they ","তারাই"],["ٱلرَّٰشِدُونَ","l-rāshidūna","the guided ones","সঠিক পথগামী"]],"t":"وَ<h>ٱ</>عْلَ<o>مُوٓ</><s>ا۟</> أَ<g>نَّ</> فِيكُمْ رَسُولَ <h>ٱ</>للَّهِ ۚ لَوْ يُطِيعُكُمْ فِى كَثِي<d>رٍۢ مِّ</>نَ <h>ٱ</>لْأَمْرِ لَعَنِتُّمْ وَ<m>لَٰ</>كِ<g>نَّ</> <h>ٱ</>للَّهَ حَبَّبَ إِلَيْكُمُ <h>ٱ</>لْإِي<m>مَٰ</>نَ وَزَيَّنَهُ<m>ۥ</> فِى قُلُوبِكُمْ وَكَرَّهَ إِلَيْكُمُ <h>ٱ</>لْكُفْرَ وَ<h>ٱ</>لْفُسُوقَ وَ<h>ٱ</>لْعِصْيَانَ ۚ أُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</><l>ل</><m>رَّٰ</>شِ<p>دُو</>نَ"},{"n":8,"w":[["فَضْلًۭا","faḍlan","A Bounty","অনুগ্রহে"],["مِّنَ","mina","from Allah","পক্ষ হতে"],["ٱللَّهِ","l-lahi","from Allah","আল্লাহর"],["وَنِعْمَةًۭ ۚ","wani‘'matan","and favor","ও (তাঁর) অনুগ্রহ"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["عَلِيمٌ","‘alīmun","(is) All-Knower","সবকিছু জানেন"],["حَكِيمٌۭ","ḥakīmun","All-Wise","প্রজ্ঞাময়"]],"t":"فَضْلًۭ<d>ا مِّ</>نَ <h>ٱ</>للَّهِ وَنِعْمَ<d>ةًۭ ۚ وَ</><h>ٱ</>للَّهُ عَلِيمٌ حَ<p>كِي</>مٌۭ"},{"n":9,"w":[["وَإِن","wa-in","And if","এবং যদি"],["طَآئِفَتَانِ","ṭāifatāni","two parties","দুটি দল"],["مِنَ","mina","among","মধ্য হতে"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believers","মু'মিনদের"],["ٱقْتَتَلُوا۟","iq'tatalū","fight","পরস্পরে যুদ্ধে লিপ্ত হয়"],["فَأَصْلِحُوا۟","fa-aṣliḥū","then make peace","তবে তোমরা  মীমাংসা করে দাও"],["بَيْنَهُمَا ۖ","baynahumā","between both of them","তাদের উভয়ের মাঝে"],["فَإِنۢ","fa-in","But if","যদি অতঃপর"],["بَغَتْ","baghat","oppresses","সীমালংঘন করে"],["إِحْدَىٰهُمَا","iḥ'dāhumā","one of them","তাদের একদল"],["عَلَى","‘alā","on","বিরুদ্ধে"],["ٱلْأُخْرَىٰ","l-ukh'rā","the other","অন্যের"],["فَقَـٰتِلُوا۟","faqātilū","then fight","তবে তোমরা  যুদ্ধ করো"],["ٱلَّتِى","allatī","one which","(তার বিরুদ্ধে) যে"],["تَبْغِى","tabghī","oppresses","সীমালংঘন করে"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["تَفِىٓءَ","tafīa","it returns","ফিরে আসে"],["إِلَىٰٓ","ilā","to","দিকে"],["أَمْرِ","amri","(the) command","নির্দেশের"],["ٱللَّهِ ۚ","l-lahi","(of) Allah","আল্লাহর"],["فَإِن","fa-in","Then if","যদি অতঃপর"],["فَآءَتْ","fāat","it returns","ফিরে আসে"],["فَأَصْلِحُوا۟","fa-aṣliḥū","then make peace","তবে তোমরা মীমাংসা করে দাও"],["بَيْنَهُمَا","baynahumā","between them","তাদের উভয়ের মাঝে"],["بِٱلْعَدْلِ","bil-‘adli","with justice","ন্যায়ানুগভাবে"],["وَأَقْسِطُوٓا۟ ۖ","wa-aqsiṭū","and act justly","এবং তোমরা সুবিচার করো"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يُحِبُّ","yuḥibbu","loves","পছন্দ করেন"],["ٱلْمُقْسِطِينَ","l-muq'siṭīna","those who act justly","সুবিচারকারীদেরকে"]],"t":"وَإِ<k>ن طَ</><o>آ</>ئِفَتَانِ مِنَ <h>ٱ</>لْمُؤْمِنِينَ <h>ٱ</><q>قْ</>تَتَلُو<s>ا۟</> فَأَصْلِحُو<s>ا۟</> بَيْنَهُمَا ۖ فَ<i>إِنۢ بَ</>غَتْ إِحْدَ<m>ىٰ</>هُمَا عَلَى <h>ٱ</>لْأُخْرَىٰ فَ<m>قَٰ</>تِلُو<s>ا۟</> <h>ٱ</>لَّتِى تَ<q>بْ</>غِى حَتَّىٰ تَ<o>فِىٓ</>ءَ إِلَ<o>ىٰٓ</> أَمْرِ <h>ٱ</>للَّهِ ۚ فَإِ<k>ن فَ</><o>آ</>ءَتْ فَأَصْلِحُو<s>ا۟</> بَيْنَهُمَا بِ<h>ٱ</>لْعَ<q>دْ</>لِ وَأَ<q>قْ</>سِ<o>طُوٓ</><s>ا۟</> ۖ إِ<g>نَّ</> <h>ٱ</>للَّهَ يُحِبُّ <h>ٱ</>لْمُ<q>قْ</>سِ<p>طِي</>نَ"},{"n":10,"w":[["إِنَّمَا","innamā","Only","প্রকৃতপক্ষে"],["ٱلْمُؤْمِنُونَ","l-mu'minūna","the believers","মু'মিনরা"],["إِخْوَةٌۭ","ikh'watun","(are) brothers","(পরস্পরে) ভাই ভাই"],["فَأَصْلِحُوا۟","fa-aṣliḥū","so make peace","অতএব তোমরা  মীমাংসা করে দাও"],["بَيْنَ","bayna","between","মাঝে"],["أَخَوَيْكُمْ ۚ","akhawaykum","your brothers","তোমাদের দুই ভাইয়ের"],["وَٱتَّقُوا۟","wa-ittaqū","and fear Allah","এবং তোমরা ভয় করো"],["ٱللَّهَ","l-laha","and fear Allah","আল্লাহকে"],["لَعَلَّكُمْ","la‘allakum","so that you may","তোমাদের উপর সম্ভবতঃ"],["تُرْحَمُونَ","tur'ḥamūna","receive mercy","অনুগ্রহ করা হবে"]],"t":"إِ<g>نَّ</>مَا <h>ٱ</>لْمُؤْمِنُونَ إِخْوَ<k>ةٌۭ فَ</>أَصْلِحُو<s>ا۟</> بَيْنَ أَخَوَيْكُمْ ۚ وَ<h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</>للَّهَ لَعَلَّكُمْ تُرْحَ<p>مُو</>نَ"},{"n":11,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you who believe","হে"],["ٱلَّذِينَ","alladhīna","O you who believe","যারা"],["ءَامَنُوا۟","āmanū","O you who believe","ঈমান এনেছ"],["لَا","lā","(Let) not","না"],["يَسْخَرْ","yaskhar","ridicule","উপহাস করে (যেন)"],["قَوْمٌۭ","qawmun","a people","কোনো পুরুষ"],["مِّن","min","[of]","মধ্য থেকে"],["قَوْمٍ","qawmin","(another) people","(অন্য) কোনো পুরুষের"],["عَسَىٰٓ","‘asā","perhaps","হয়তো (যাদের বিদ্রুপ করা হচ্ছে)"],["أَن","an","that","যে"],["يَكُونُوا۟","yakūnū","they may be","তারা হবে"],["خَيْرًۭا","khayran","better","উত্তম"],["مِّنْهُمْ","min'hum","than them","তাদের চেয়ে"],["وَلَا","walā","and (let) not","আর না"],["نِسَآءٌۭ","nisāon","women","মহিলারা"],["مِّن","min","[of]","