ُمُ <h>ٱ</><l>ل</><m>صَّٰ</>دِ<p>قُو</>نَ"},{"n":16,"w":[["قُلْ","qul","Say","(হে নবী) বলো"],["أَتُعَلِّمُونَ","atu‘allimūna","Will you acquaint","\"তোমরা কি জানাচ্ছ"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["بِدِينِكُمْ","bidīnikum","with your religion","তোমাদের দীন (পালন) সম্পর্কে"],["وَٱللَّهُ","wal-lahu","while Allah","অথচ আল্লাহ"],["يَعْلَمُ","ya‘lamu","knows","জানেন"],["مَا","mā","what","যা কিছু"],["فِى","fī","(is) in","মধ্যে (আছে)"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশসমূহের"],["وَمَا","wamā","and what","ও যা কিছু"],["فِى","fī","(is) in","মধ্যে (আছে)"],["ٱلْأَرْضِ ۚ","l-arḍi","the earth","পৃথিবীর"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["بِكُلِّ","bikulli","of every","সম্পর্কে"],["شَىْءٍ","shayin","thing","সব জিনিসের"],["عَلِيمٌۭ","‘alīmun","(is) All-Knower","খুব জানেন\""]],"t":"قُلْ أَتُعَلِّمُونَ <h>ٱ</>للَّهَ بِدِينِكُمْ وَ<h>ٱ</>للَّهُ يَعْلَمُ مَا فِى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَمَا فِى <h>ٱ</>لْأَرْضِ ۚ وَ<h>ٱ</>للَّهُ بِكُلِّ شَىْءٍ عَ<p>لِي</>مٌۭ"},{"n":17,"w":[["يَمُنُّونَ","yamunnūna","They consider (it) a favor","তারা অনুগ্রহ প্রকাশ করে"],["عَلَيْكَ","‘alayka","to you","তোমার প্রতি"],["أَنْ","an","that","যে"],["أَسْلَمُوا۟ ۖ","aslamū","they have accepted Islam","তারা ইসলাম গ্রহণ করেছে"],["قُل","qul","Say","বলো"],["لَّا","lā","(Do) not","\"না"],["تَمُنُّوا۟","tamunnū","consider a favor","তোমরা অনুগ্রহ বলে মনে করো"],["عَلَىَّ","‘alayya","on me ","আমার প্রতি"],["إِسْلَـٰمَكُم ۖ","is'lāmakum","your Islam","তোমাদের ইসলাম গ্রহণের"],["بَلِ","bali","Nay","বরং"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["يَمُنُّ","yamunnu","has conferred a favor","অনুগ্রহ করেছেন"],["عَلَيْكُمْ","‘alaykum","upon you","তোমাদের উপর"],["أَنْ","an","that","যে"],["هَدَىٰكُمْ","hadākum","He has guided you","তিনি তোমাদেরকে পথ দেখিয়েছেন"],["لِلْإِيمَـٰنِ","lil'īmāni","to the faith","ঈমানের দিকে"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you are","তোমরা হও"],["صَـٰدِقِينَ","ṣādiqīna","truthful","সত্যবাদী (ঈমানের দাবিতে)"]],"t":"يَمُ<g>نُّ</>ونَ عَلَي