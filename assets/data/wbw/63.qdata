{"n":63,"a":[{"n":1,"w":[["إِذَا","idhā","When","যখন"],["جَآءَكَ","jāaka","come to you","তোমার  কাছে আসে"],["ٱلْمُنَـٰفِقُونَ","l-munāfiqūna","the hypocrites","মুনাফিকরা"],["قَالُوا۟","qālū","they say","তারা বলে"],["نَشْهَدُ","nashhadu","We testify","\"আমরা সাক্ষ্য দিচ্ছি"],["إِنَّكَ","innaka","that you","আপনি নিশ্চয়"],["لَرَسُولُ","larasūlu","(are) surely (the) Messenger","অবশ্যই রাসূল"],["ٱللَّهِ ۗ","l-lahi","(of) Allah","আল্লাহর\""],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["يَعْلَمُ","ya‘lamu","knows","জানেন"],["إِنَّكَ","innaka","that you","তুমি নিশ্চয়"],["لَرَسُولُهُۥ","larasūluhu","(are) surely His Messenger","অবশ্যই তাঁর রাসূল"],["وَٱللَّهُ","wal-lahu","and Allah","এবং আল্লাহ"],["يَشْهَدُ","yashhadu","testifies","সাক্ষ্য দিচ্ছেন"],["إِنَّ","inna","that","নিশ্চয়"],["ٱلْمُنَـٰفِقِينَ","l-munāfiqīna","the hypocrites","মুনাফিকরা"],["لَكَـٰذِبُونَ","lakādhibūna","(are) surely liars","অবশ্যই মিথ্যাবাদী"]],"t":"إِذَا <o>جَآ</>ءَكَ <h>ٱ</>لْمُ<m>نَٰ</>فِقُونَ قَالُو<s>ا۟</> نَشْهَدُ إِ<g>نَّ</>كَ لَرَسُولُ <h>ٱ</>للَّهِ ۗ وَ<h>ٱ</>للَّهُ يَعْلَمُ إِ<g>نَّ</>كَ لَرَسُولُهُ<m>ۥ</> وَ<h>ٱ</>للَّهُ يَشْهَدُ إِ<g>نَّ</> <h>ٱ</>لْمُ<m>نَٰ</>فِقِينَ لَ<m>كَٰ</>ذِ<p>بُو</>نَ"},{"n":2,"w":[["ٱتَّخَذُوٓا۟","ittakhadhū","They take","তারা গ্রহণ করেছে"],["أَيْمَـٰنَهُمْ","aymānahum","their oaths","তাদের শপথগুলোকে"],["جُنَّةًۭ","junnatan","(as) a cover","ঢাল (স্বরূপ)"],["فَصَدُّوا۟","faṣaddū","so they turn away","অতঃপর তারা বাধা সৃষ্টি করে"],["عَن","‘an","from","থেকে"],["سَبِيلِ","sabīli","(the) Way","পথ"],["ٱللَّهِ ۚ","l-lahi","(of) Allah","আল্লাহর"],["إِنَّهُمْ","innahum","Indeed, [they]","তারা নিশ্চয়"],["سَآءَ","sāa","evil is","কত মন্দ"],["مَا","mā","what","যা"],["كَانُوا۟","kānū","they used to","(ছিল)"],["يَعْمَلُونَ","ya‘malūna","do","তারা করছে"]],"t":"ٱتَّخَ<o>ذُوٓ</><s>ا۟</> أَيْ<m>مَٰ</>نَهُمْ جُ<g>نَّ</><k>ةًۭ فَ</>صَدُّو<s>ا۟</> عَ<k>ن سَ</>بِيلِ <h>ٱ</>للَّهِ ۚ إِ<g>نَّ</>هُمْ <o>سَآ</>ءَ مَا كَانُو<s>ا۟</> يَعْمَ<p>لُو</>نَ"},{"n":3,"w":[["ذَٰلِكَ","dhālika","That","এটা"],["بِأَنَّهُمْ","bi-annahum","(is) because","এ কারণে যে তারা"],["ءَامَنُوا۟","āmanū","they believed","ঈমান এনেছে"],["ثُمَّ","thumma","then","আবার তোমাদের মধ্যে"],["كَفَرُوا۟","kafarū","they disbelieved","কুফুরি করেছে"],["فَطُبِعَ","faṭubi‘a","so were sealed","অতঃপর মোহর করা হয়েছে"],["عَلَىٰ","‘alā","[upon]","উপর"],["قُلُوبِهِمْ","qulūbihim","their hearts","তাদের অন্তরসমূহের"],["فَهُمْ","fahum","so they","অতঃপর তারা"],["لَا","lā","(do) not","না"],["يَفْقَهُونَ","yafqahūna","understand","তারা বুঝে"]],"t":"<m>ذَٰ</>لِكَ بِأَ<g>نَّ</>هُمْ ءَامَنُو<s>ا۟</> ثُ<g>مَّ</> كَفَرُو<s>ا۟</> فَطُبِعَ عَلَىٰ قُلُوبِهِمْ فَهُمْ لَا يَفْقَ<p>هُو</>نَ"},{"n":4,"w":[["۞ وَإِذَا","wa-idhā","And when","এবং যখন"],["رَأَيْتَهُمْ","ra-aytahum","you see them","তাদের তুমি দেখ"],["تُعْجِبُكَ","tu‘'jibuka","pleases you","তোমার প্রীতিকর মনে হয়"],["أَجْسَامُهُمْ ۖ","ajsāmuhum","their bodies","তাদের দেহগুলো"],["وَإِن","wa-in","and if","এবং যদি"],["يَقُولُوا۟","yaqūlū","they speak","তারা কথা বলে"],["تَسْمَعْ","tasma‘","you listen","তুমি শুনবে"],["لِقَوْلِهِمْ ۖ","liqawlihim","to their speech","তাদের কথাকে"],["كَأَنَّهُمْ","ka-annahum","as if they (were)","তারা যেন (আসলে)"],["خُشُبٌۭ","khushubun","pieces of wood","কাষ্ঠখণ্ডসমূহ"],["مُّسَنَّدَةٌۭ ۖ","musannadatun","propped up","ঠেকান দেয়া"],["يَحْسَبُونَ","yaḥsabūna","They think","তারা মনে করে"],["كُلَّ","kulla","every","প্রত্যেক"],["صَيْحَةٍ","ṣayḥatin","shout","উঁচু আওয়াজ"],["عَلَيْهِمْ ۚ","‘alayhim","(is) against them","তাদের বিরুদ্ধে"],["هُمُ","humu","They","তারাই"],["ٱلْعَدُوُّ","l-‘aduwu","(are) the enemy","শত্রু"],["فَٱحْذَرْهُمْ ۚ","fa-iḥ'dharhum","so beware of them","অতএব সতর্ক হও তাদের (থেকে)"],["قَـٰتَلَهُمُ","qātalahumu","May destroy them","তাদের উপর মার"],["ٱللَّهُ ۖ","l-lahu","Allah","আল্লাহর"],["أَنَّىٰ","annā","How","কোথায়"],["يُؤْفَكُونَ","yu'fakūna","are they deluded","তাদের ফিরিয়ে নেয়া হচ্ছে"]],"t":"۞ وَإِذَا رَأَيْتَهُمْ تُعْجِبُكَ أَ<q>جْ</>سَامُهُمْ ۖ وَ<d>إِن يَ</>قُولُو<s>ا۟</> تَسْمَعْ لِقَوْلِهِمْ ۖ كَأَ<g>نَّ</>هُمْ خُشُ<d>بٌۭ مُّ</>سَ<g>نَّ</>دَ<d>ةٌۭ ۖ يَ</>حْسَبُونَ كُلَّ صَيْحَةٍ عَلَيْهِمْ ۚ هُمُ <h>ٱ</>لْعَدُوُّ فَ<h>ٱ</>حْذَرْهُمْ ۚ <m>قَٰ</>تَلَهُمُ <h>ٱ</>للَّهُ ۖ أَ<g>نَّ</>ىٰ يُؤْفَ<p>كُو</>نَ"},{"n":5,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["قِيلَ","qīla","it is said","বলা হয়"],["لَهُمْ","lahum","to them","তাদেরকে"],["تَعَالَوْا۟","ta‘ālaw","Come","\"তোমরা আসো"],["يَسْتَغْفِرْ","yastaghfir","will ask forgiveness","ক্ষমা প্রার্থনা করবেন"],["لَكُمْ","lakum","for you","তোমাদের জন্যে"],["رَسُولُ","rasūlu","(the) Messenger","রাসূূল\""],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর\""],["لَوَّوْا۟","lawwaw","They turn aside","তারা ফিরিয়ে নেয়"],["رُءُوسَهُمْ","ruūsahum","their heads","তাদের মাথাগুলো"],["وَرَأَيْتَهُمْ","wara-aytahum","and you see them","এবং তুমি তাদের দেখো"],["يَصُدُّونَ","yaṣuddūna","turning away","বিরত থাকে (আসা থেকে)"],["وَهُم","wahum","while they","এবং তারা"],["مُّسْتَكْبِرُونَ","mus'takbirūna","(are) arrogant","অহংকারী"]],"t":"وَإِذَا قِيلَ لَهُمْ تَعَالَوْ<s>ا۟</> يَسْتَغْفِرْ لَكُمْ رَسُولُ <h>ٱ</>للَّهِ لَوَّوْ<s>ا۟</> رُءُوسَهُمْ وَرَأَيْتَهُمْ يَصُدُّونَ وَ<y>هُم مُّ</>سْتَكْبِ<p>رُو</>نَ"},{"n":6,"w":[["سَوَآءٌ","sawāon","(It) is same","সমান"],["عَلَيْهِمْ","‘alayhim","for them","তাদের জন্যে"],["أَسْتَغْفَرْتَ","astaghfarta","whether you ask forgiveness","তুমি ক্ষমা প্রার্থনা কর"],["لَهُمْ","lahum","for them","তাদের জন্য"],["أَمْ","am","or","অথবা"],["لَمْ","lam","(do) not","প্রার্থনা নাই করো"],["تَسْتَغْفِرْ","tastaghfir","ask forgiveness","তুমি ক্ষমা"],["لَهُمْ","lahum","for them","তাদের জন্যে"],["لَن","lan","Never","কক্ষনো না"],["يَغْفِرَ","yaghfira","will forgive","ক্ষমা করবেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["لَهُمْ ۚ","lahum","[to] them","তাদেরকে"],["إِنَّ","inna","Indeed","নিশ্চয়"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَا","lā","(does) not","না"],["يَهْدِى","yahdī","guide","পথ দেখান"],["ٱلْقَوْمَ","l-qawma","the people","লোকদের"],["ٱلْفَـٰسِقِينَ","l-fāsiqīna","the defiantly disobedient","ফাসেক"]],"t":"سَ<o>وَآ</>ءٌ عَلَيْهِمْ أَسْتَغْفَرْتَ لَهُمْ أَمْ لَمْ تَسْتَغْفِرْ لَهُمْ <d>لَن يَ</>غْفِرَ <h>ٱ</>للَّهُ لَهُمْ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ لَا يَهْدِى <h>ٱ</>لْقَوْمَ <h>ٱ</>لْ<m>فَٰ</>سِ<p>قِي</>نَ"},{"n":7,"w":[["هُمُ","humu","They","তারা (ঐ লোক)"],["ٱلَّذِينَ","alladhīna","(are) those who","যারা"],["يَقُولُونَ","yaqūlūna","say","বলে"],["لَا","lā","(Do) not","\"না"],["تُنفِقُوا۟","tunfiqū","spend","তোমরা খরচ করো"],["عَلَىٰ","‘alā","on","(তাদের) জন্য"],["مَنْ","man","(those) who","যারা (আছে)"],["عِندَ","‘inda","(are) with","কাছে"],["رَسُولِ","rasūli","(the) Messenger","রাসূলের"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["يَنفَضُّوا۟ ۗ","yanfaḍḍū","they disband","তারা ছিন্নভিন্ন হয়ে যায়\""],["وَلِلَّهِ","walillahi","And for Allah","অথচ আল্লাহরই"],["خَزَآئِنُ","khazāinu","(are the) treasures","ধনভাণ্ডারসমূহ"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আসমানসমূহের"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও যমীনের"],["وَلَـٰكِنَّ","walākinna","but","কিন্তু"],["ٱلْمُنَـٰفِقِينَ","l-munāfiqīna","the hypocrites","মুনাফিকরা"],["لَا","lā","(do) not","না"],["يَفْقَهُونَ","yafqahūna","understand","তারা বুঝে"]],"t":"هُمُ <h>ٱ</>لَّذِينَ يَقُولُونَ لَا تُ<k>نفِ</>قُو<s>ا۟</> عَلَىٰ مَنْ عِ<k>ندَ</> رَسُولِ <h>ٱ</>للَّهِ حَتَّىٰ يَ<k>نفَ</>ضُّو<s>ا۟ ۗ</> وَلِلَّهِ خَ<o>زَآ</>ئِنُ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ وَ<m>لَٰ</>كِ<g>نَّ</> <h>ٱ</>لْمُ<m>نَٰ</>فِقِينَ لَا يَفْقَ<p>هُو</>نَ"},{"n":8,"w":[["يَقُولُونَ","yaqūlūna","They say","তারা বলে"],["لَئِن","la-in","If","\"অবশ্যই যদি"],["رَّجَعْنَآ","raja‘nā","we return","আমরা ফিরে যেতে পারি"],["إِلَى","ilā","to","দিকে"],["ٱلْمَدِينَةِ","l-madīnati","Al-Madinah","মদীনার"],["لَيُخْرِجَنَّ","layukh'rijanna","surely, will expel","বহিস্কার করবেই"],["ٱلْأَعَزُّ","l-a‘azu","the more honorable","অধিক সম্মানিত"],["مِنْهَا","min'hā","from it","তা থেকে"],["ٱلْأَذَلَّ ۚ","l-adhala","the more humble","হীনতরকে\""],["وَلِلَّهِ","walillahi","But for Allah","অথচ আল্লাহরই জন্যে"],["ٱلْعِزَّةُ","l-‘izatu","(is) the honor","সম্মান"],["وَلِرَسُولِهِۦ","walirasūlihi","and for His Messenger","ও তাঁর রাসূলের"],["وَلِلْمُؤْمِنِينَ","walil'mu'minīna","and for the believers","ও মু'মিনদের"],["وَلَـٰكِنَّ","walākinna","but","কিন্তু"],["ٱلْمُنَـٰفِقِينَ","l-munāfiqīna","the hypocrites","মুনাফিকরা"],["لَا","lā","(do) not","না"],["يَعْلَمُونَ","ya‘lamūna","know","তারা জানে"]],"t":"يَقُولُونَ لَ<w>ئِن رَّ</>جَعْ<o>نَآ</> إِلَى <h>ٱ</>لْمَدِينَةِ لَيُخْرِجَ<g>نَّ</> <h>ٱ</>لْأَعَزُّ مِنْهَا <h>ٱ</>لْأَذَلَّ ۚ وَلِلَّهِ <h>ٱ</>لْعِزَّةُ وَلِرَسُولِ<m>هِۦ</> وَلِلْمُؤْمِنِينَ وَ<m>لَٰ</>كِ<g>نَّ</> <h>ٱ</>لْمُ<m>نَٰ</>فِقِينَ لَا يَعْلَ<p>مُو</>نَ"},{"n":9,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O","ওহে"],["ٱلَّذِينَ","alladhīna","you (who)","যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছো"],["لَا","lā","(Let) not","না"],["تُلْهِكُمْ","tul'hikum","divert you","তোমাদের (যেন) গাফিল করে"],["أَمْوَٰلُكُمْ","amwālukum","your wealth","তোমাদের সম্পদগুলো"],["وَلَآ","walā","and not","ও না"],["أَوْلَـٰدُكُمْ","awlādukum","your children","তোমাদের সন্তানরা"],["عَن","‘an","from","থেকে"],["ذِكْرِ","dhik'ri","(the) remembrance","স্মরণ"],["ٱللَّهِ ۚ","l-lahi","(of) Allah","আল্লাহর"],["وَمَن","waman","And whoever","এবং যে"],["يَفْعَلْ","yaf‘al","does","করবে"],["ذَٰلِكَ","dhālika","that","এটা"],["فَأُو۟لَـٰٓئِكَ","fa-ulāika","then those","অতঃপর ঐসব লোক"],["هُمُ","humu","[they]","তারাই"],["ٱلْخَـٰسِرُونَ","l-khāsirūna","(are) the losers","ক্ষতিগ্রস্ত"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> لَا تُلْهِكُمْ أَمْ<m>وَٰ</>لُكُمْ وَ<o>لَآ</> أَوْ<m>لَٰ</>دُكُمْ عَ<k>ن ذِ</>كْرِ <h>ٱ</>للَّهِ ۚ وَ<d>مَن يَ</>فْعَلْ <m>ذَٰ</>لِكَ فَأُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</>لْ<m>خَٰ</>سِ<p>رُو</>نَ"},{"n":10,"w":[["وَأَنفِقُوا۟","wa-anfiqū","And spend","এবং তোমরা খরচ করো"],["مِن","min","from","থেকে"],["مَّا","mā","what","তা (যা)"],["رَزَقْنَـٰكُم","razaqnākum","We have provided you","তোমাদের আমরা রিজিক দিয়েছি"],["مِّن","min","from","থেকে"],["قَبْلِ","qabli","before","পূর্বে"],["أَن","an","[that]","যে"],["يَأْتِىَ","yatiya","comes","আসে"],["أَحَدَكُمُ","aḥadakumu","(to) one of you","তোমাদের কারও"],["ٱلْمَوْتُ","l-mawtu","the death","মৃত্যু"],["فَيَقُولَ","fayaqūla","and he says","অতঃপর সে বলবে"],["رَبِّ","rabbi","My Lord","\"হে আমার রব"],["لَوْلَآ","lawlā","Why not","কেন না"],["أَخَّرْتَنِىٓ","akhartanī","You delay me","তুমি আমাকে অবকাশ দিলে"],["إِلَىٰٓ","ilā","for","পর্যন্ত"],["أَجَلٍۢ","ajalin","a term","কাল"],["قَرِيبٍۢ","qarībin","near","কিছু"],["فَأَصَّدَّقَ","fa-aṣṣaddaqa","so I would give charity","আমি তা হলে সদকা করতাম"],["وَأَكُن","wa-akun","and be","এবং হতাম আমি"],["مِّنَ","mina","among","অন্তর্ভুক্ত"],["ٱلصَّـٰلِحِينَ","l-ṣāliḥīna","the righteous","সৎকর্মশীলদের\""]],"t":"وَأَ<k>نفِ</>قُو<s>ا۟</> <d>مِن مَّ</>ا رَزَ<q>قْ</><m>نَٰ</><y>كُم مِّ</><k>ن قَ</><q>بْ</>لِ <d>أَن يَ</>أْتِىَ أَحَدَكُمُ <h>ٱ</>لْمَوْتُ فَيَقُولَ رَبِّ لَوْ<o>لَآ</> أَخَّرْتَ<o>نِىٓ</> إِلَ<o>ىٰٓ</> أَجَ<k>لٍۢ قَ</>رِي<k>بٍۢ فَ</>أَصَّدَّقَ وَأَ<d>كُن مِّ</>نَ <h>ٱ</><l>ل</><m>صَّٰ</>لِ<p>حِي</>نَ"},{"n":11,"w":[["وَلَن","walan","But never","অথচ কক্ষনো না"],["يُؤَخِّرَ","yu-akhira","will (be) delayed","অবকাশ দেন"],["ٱللَّهُ","l-lahu","(by) Allah","আল্লাহ"],["نَفْسًا","nafsan","a soul","কোন ব্যক্তিকে"],["إِذَا","idhā","when","যখন"],["جَآءَ","jāa","has come","আসে"],["أَجَلُهَا ۚ","ajaluhā","its term","তার নির্ধারিত মেয়াদ"],["وَٱللَّهُ","wal-lahu","And Allah","আর আল্লাহ"],["خَبِيرٌۢ","khabīrun","(is) All-Aware","সবিশেষ অবহিত"],["بِمَا","bimā","of what","যা কিছু"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা কাজ করো"]],"t":"وَ<d>لَن يُ</>ؤَخِّرَ <h>ٱ</>للَّهُ نَفْسًا إِذَا <o>جَآ</>ءَ أَجَلُهَا ۚ وَ<h>ٱ</>للَّهُ خَبِي<i>رٌۢ بِ</>مَا تَعْمَ<p>لُو</>نَ"}]}