{"n":20,"a":[{"n":1,"w":[["طه","tta-ha","Ta Ha","ত্বা-হা"]],"t":"طه"},{"n":2,"w":[["مَآ","mā","Not","না"],["أَنزَلْنَا","anzalnā","We (have) sent down","আমরা অবতীর্ণ করেছি"],["عَلَيْكَ","‘alayka","to you","তোমার উপর"],["ٱلْقُرْءَانَ","l-qur'āna","the Quran","(এই) কুরআন"],["لِتَشْقَىٰٓ","litashqā","that you be distressed","তোমাকে কষ্ট দেওয়ার জন্যে"]],"t":"<o>مَآ</> أَ<k>نزَ</>لْنَا عَلَيْكَ <h>ٱ</>لْقُرْءَانَ لِتَشْقَىٰٓ"},{"n":3,"w":[["إِلَّا","illā","(But)","কিন্তু"],["تَذْكِرَةًۭ","tadhkiratan","(as) a reminder","উপদেশ"],["لِّمَن","liman","for (those) who","( তার ) জন্যে যে"],["يَخْشَىٰ","yakhshā","fear","ভয় করে"]],"t":"إِلَّا تَذْكِرَ<w>ةًۭ لِّ</><d>مَن يَ</>خْشَىٰ"},{"n":4,"w":[["تَنزِيلًۭا","tanzīlan","A revelation","অবতীর্ণ করা ( হয়েছে )"],["مِّمَّنْ","mimman","from (He) Who","তাঁর পক্ষ হ'তে"],["خَلَقَ","khalaqa","created","( যিনি ) সৃষ্টি করেছেন"],["ٱلْأَرْضَ","l-arḍa","the earth","পৃথিবীকে"],["وَٱلسَّمَـٰوَٰتِ","wal-samāwāti","and the heavens","ও আকাশমণ্ডলীকে"],["ٱلْعُلَى","l-‘ulā","[the] high","( যা ) সমুচ্চ"]],"t":"تَ<k>نزِ</>يلًۭ<d>ا مِّ</><g>مَّ</>نْ خَلَقَ <h>ٱ</>لْأَرْضَ وَ<h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ <h>ٱ</>لْعُلَى"},{"n":5,"w":[["ٱلرَّحْمَـٰنُ","al-raḥmānu","The Most Gracious","( তিনিই ) দয়াময়"],["عَلَى","‘alā","over","যিনি উপর"],["ٱلْعَرْشِ","l-‘arshi","the Throne","আরশের"],["ٱسْتَوَىٰ","is'tawā","is established","সমাসীন হয়েছেন"]],"t":"ٱ<l>ل</>رَّحْ<m>مَٰ</>نُ عَلَى <h>ٱ</>لْعَرْشِ <h>ٱ</>سْتَوَىٰ"},{"n":6,"w":[["لَهُۥ","lahu","To Him (belongs)","তাঁরই ( মালিকানায় )"],["مَا","mā","whatever","যা কিছু"],["فِى","fī","(is) in","মধ্যে আছে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশমণ্ডলীর"],["وَمَا","wamā","and whatever","ও যা কিছু"],["فِى","fī","(is) in","মধ্যে আছে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["وَمَا","wamā","and whatever","এবং যা কিছু ( আছে )"],["بَيْنَهُمَا","baynahumā","(is) between them","উভয়ের মাঝে"],["وَمَا","wamā","and whatever","এবং যা কিছু ( আছে )"],["تَحْتَ","taḥta","(is) under","নিচে"],["ٱلثَّرَىٰ","l-tharā","the soil","সিক্ত মাটির"]],"t":"لَهُ<m>ۥ</> مَا فِى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَمَا فِى <h>ٱ</>لْأَرْضِ وَمَا بَيْنَهُمَا وَمَا تَحْتَ <h>ٱ</><l>ل</>ثَّرَىٰ"},{"n":7,"w":[["وَإِن","wa-in","And if","এবং যদি"],["تَجْهَرْ","tajhar","you speak aloud","উঁচু গলায় বলো"],["بِٱلْقَوْلِ","bil-qawli","the word","কথাকে ( তাও তিনি শুনেন )"],["فَإِنَّهُۥ","fa-innahu","then indeed, He","তবে নিশ্চয়ই তিনি"],["يَعْلَمُ","ya‘lamu","knows","জানেন"],["ٱلسِّرَّ","l-sira","the secret","গুপ্ত"],["وَأَخْفَى","wa-akhfā","and the more hidden","এবং অব্যক্ত ( কথাও )"]],"t":"وَإِ<k>ن تَ</><q>جْ</>هَرْ بِ<h>ٱ</>لْقَوْلِ فَإِ<g>نَّ</>هُ<m>ۥ</> يَعْلَمُ <h>ٱ</><l>ل</>سِّرَّ وَأَخْفَى"},{"n":8,"w":[["ٱللَّهُ","al-lahu","Allah ","আল্লাহ ( এমন সত্ত্বা যে )"],["لَآ","lā","(there is) no","নেই"],["إِلَـٰهَ","ilāha","god","কোন ইলাহ"],["إِلَّا","illā","except","ছাড়া"],["هُوَ ۖ","huwa","Him","তিনি"],["لَهُ","lahu","To Him (belong)","তাঁরই আছে"],["ٱلْأَسْمَآءُ","l-asmāu","the Names","নামসমূহ"],["ٱلْحُسْنَىٰ","l-ḥus'nā","the Most Beautiful","সুন্দর"]],"t":"ٱللَّهُ <o>لَآ</> إِ<m>لَٰ</>هَ إِلَّا هُوَ ۖ لَهُ <h>ٱ</>لْأَسْ<o>مَآ</>ءُ <h>ٱ</>لْحُسْنَىٰ"},{"n":9,"w":[["وَهَلْ","wahal","And has","আর কি"],["أَتَىٰكَ","atāka","come to you","তোমার কাছে এসেছে"],["حَدِيثُ","ḥadīthu","the narration","বৃত্তান্ত"],["مُوسَىٰٓ","mūsā","(of) Musa","মূসার"]],"t":"وَهَلْ أَتَ<m>ىٰ</>كَ حَدِيثُ مُوسَىٰٓ"},{"n":10,"w":[["إِذْ","idh","When","যখন"],["رَءَا","raā","he saw","সে দেখেছিলো"],["نَارًۭا","nāran","a fire","আগুন"],["فَقَالَ","faqāla","then he said","তখন বলেছিলো"],["لِأَهْلِهِ","li-ahlihi","to his family","তার পরিবারবর্গকে"],["ٱمْكُثُوٓا۟","um'kuthū","Stay here","\"তোমরা থাকো ( অপেক্ষা করো )"],["إِنِّىٓ","innī","indeed, I","নিশ্চয়ই আমি"],["ءَانَسْتُ","ānastu","[I] perceived","দেখেছি"],["نَارًۭا","nāran","a fire","আগুন"],["لَّعَلِّىٓ","la‘allī","perhaps I (can)","সম্ভবতঃ আমি"],["ءَاتِيكُم","ātīkum","bring you","তোমাদের কাছে আমি আসবো"],["مِّنْهَا","min'hā","therefrom","তা থেকে"],["بِقَبَسٍ","biqabasin","a burning brand","( কিছু ) অঙ্গার নিয়ে"],["أَوْ","aw","or","অথবা"],["أَجِدُ","ajidu","I find","আমি পাবো"],["عَلَى","‘alā","at","কাছে"],["ٱلنَّارِ","l-nāri","the fire","আগুনের"],["هُدًۭى","hudan","guidance","পথের\""]],"t":"إِذْ رَءَا نَا<k>رًۭا فَ</>قَالَ لِأَهْلِهِ <h>ٱ</>مْكُ<o>ثُوٓ</><s>ا۟</> إِ<g>نِّ</><o>ىٓ</> ءَانَسْتُ نَا<w>رًۭا لَّ</>عَ<o>لِّىٓ</> ءَاتِي<y>كُم مِّ</>نْهَا بِقَبَسٍ أَوْ أَجِدُ عَلَى <h>ٱ</><l>ل</><g>نَّ</>ارِ هُدًۭى"},{"n":11,"w":[["فَلَمَّآ","falammā","Then when","অতঃপর যখন"],["أَتَىٰهَا","atāhā","he came to it","তার কাছে আসলো"],["نُودِىَ","nūdiya","he was called","তাকে ডাকা হলো"],["يَـٰمُوسَىٰٓ","yāmūsā","O Musa","\"( বলা হলো ) হে মূসা"]],"t":"فَلَ<g>مَّ</><o>آ</> أَتَ<m>ىٰ</>هَا نُودِىَ <m>يَٰ</>مُوسَىٰٓ"},{"n":12,"w":[["إِنِّىٓ","innī","Indeed, [I]","নিশ্চয়ই আমি"],["أَنَا۠","anā","I Am","আমিই"],["رَبُّكَ","rabbuka","your Lord","তোমার রব"],["فَٱخْلَعْ","fa-ikh'la‘","so remove","অতএব খুলে ফেলো তুমি"],["نَعْلَيْكَ ۖ","na‘layka","your shoes","তোমার জুতা জোড়া"],["إِنَّكَ","innaka","Indeed, you","তুমি নিশ্চয়ই"],["بِٱلْوَادِ","bil-wādi","(are) in the valley","উপত্যকার মধ্যে"],["ٱلْمُقَدَّسِ","l-muqadasi","the sacred","পবিত্র"],["طُوًۭى","ṭuwan","(of) Tuwa","( যার নাম ) তুওয়া"]],"t":"إِ<g>نِّ</><o>ىٓ</> أَنَا۠ رَبُّكَ فَ<h>ٱ</>خْلَعْ نَعْلَيْكَ ۖ إِ<g>نَّ</>كَ بِ<h>ٱ</>لْوَادِ <h>ٱ</>لْمُقَدَّسِ طُوًۭى"},{"n":13,"w":[["وَأَنَا","wa-anā","And I","এবং আমি"],["ٱخْتَرْتُكَ","ikh'tartuka","(have) chosen you","তোমাকে বেছে নিয়েছি"],["فَٱسْتَمِعْ","fa-is'tami‘","so listen","সুতরাং তুমি মনোযোগসহ শুনো"],["لِمَا","limā","to what","তাই যা কিছু"],["يُوحَىٰٓ","yūḥā","is revealed","ওহী করা হয়"]],"t":"وَأَنَا <h>ٱ</>خْتَرْتُكَ فَ<h>ٱ</>سْتَمِعْ لِمَا يُوحَىٰٓ"},{"n":14,"w":[["إِنَّنِىٓ","innanī","Indeed, [I]","আমি নিশ্চয়ই"],["أَنَا","anā","I Am","আমিই"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["لَآ","lā","(There is) no","নেই"],["إِلَـٰهَ","ilāha","god","কোন ইলাহ"],["إِلَّآ","illā","but","ছাড়া"],["أَنَا۠","anā","I","আমি"],["فَٱعْبُدْنِى","fa-u‘'bud'nī","so worship Me","সুতরাং আমারই  ইবাদত করো"],["وَأَقِمِ","wa-aqimi","and establish","এবং প্রতিষ্ঠিত করো"],["ٱلصَّلَوٰةَ","l-ṣalata","the prayer","সালাত"],["لِذِكْرِىٓ","lidhik'rī","for My remembrance","আমার স্মরণের জন্যে"]],"t":"إِ<g>نَّ</><o>نِىٓ</> أَنَا <h>ٱ</>للَّهُ <o>لَآ</> إِ<m>لَٰ</>هَ إِ<o>لَّآ</> أَنَا۠ فَ<h>ٱ</>عْبُ<q>دْ</>نِى وَأَقِمِ <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةَ لِذِكْرِىٓ"},{"n":15,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلسَّاعَةَ","l-sā‘ata","the Hour","ক্বিয়ামাত"],["ءَاتِيَةٌ","ātiyatun","(will be) coming","আসবেই"],["أَكَادُ","akādu","I almost","রাখতে চাই আমি"],["أُخْفِيهَا","ukh'fīhā","[I] hide it","তা গোপন"],["لِتُجْزَىٰ","lituj'zā","that may be recompensed","যেন প্রতিফল পায়"],["كُلُّ","kullu","every","প্রত্যেক"],["نَفْسٍۭ","nafsin","soul","ব্যক্তি"],["بِمَا","bimā","for what","ঐ বিষয়ের যা"],["تَسْعَىٰ","tas‘ā","it strives","সে চেষ্টা সাধনা করে"]],"t":"إِ<g>نَّ</> <h>ٱ</><l>ل</>سَّاعَةَ ءَاتِيَةٌ أَكَادُ أُخْفِيهَا لِتُ<q>جْ</>زَىٰ كُلُّ نَفْ<i>سٍۭ بِ</>مَا تَسْعَىٰ"},{"n":16,"w":[["فَلَا","falā","So (do) not","সুতরাং না"],["يَصُدَّنَّكَ","yaṣuddannaka","(let) avert you","তোমাকে নিবৃত্ত করে ( যেন )"],["عَنْهَا","‘anhā","from it","তা থেকে"],["مَن","man","(one) who","সেই ব্যক্তি (যে )"],["لَّا","lā","(does) not","না"],["يُؤْمِنُ","yu'minu","believe","ঈমান আনে"],["بِهَا","bihā","in it","তার উপর"],["وَٱتَّبَعَ","wa-ittaba‘a","and follows","এবং অনুসরণ করেছে"],["هَوَىٰهُ","hawāhu","his desires","তার প্রবৃত্তির"],["فَتَرْدَىٰ","fatardā","lest you perish","তাহ'লে তুমি ধ্বংস হবে"]],"t":"فَلَا يَصُدَّ<g>نَّ</>كَ عَنْهَا <w>مَن لَّ</>ا يُؤْمِنُ بِهَا وَ<h>ٱ</>تَّبَعَ هَوَ<m>ىٰ</>هُ فَتَرْدَىٰ"},{"n":17,"w":[["وَمَا","wamā","And what","এবং ( আল্লাহ বললেন ) কি"],["تِلْكَ","til'ka","(is) that","ওটা"],["بِيَمِينِكَ","biyamīnika","in your right hand","তোমার ডান হাতের মধ্যে"],["يَـٰمُوسَىٰ","yāmūsā","O Musa","হে মূসা\""]],"t":"وَمَا تِلْكَ بِيَمِينِكَ <m>يَٰ</>مُوسَىٰ"},{"n":18,"w":[["قَالَ","qāla","He said","সে বললো"],["هِىَ","hiya","It","\"তা"],["عَصَاىَ","‘aṣāya","(is) my staff","আমার লাঠি"],["أَتَوَكَّؤُا۟","atawakka-u","I lean","ভর দিই আমি"],["عَلَيْهَا","‘alayhā","upon it","তার উপর"],["وَأَهُشُّ","wa-ahushu","and I bring down leaves","এবং পাতা পাড়ি আমি"],["بِهَا","bihā","with it","তা দিয়ে"],["عَلَىٰ","‘alā","for","উপর"],["غَنَمِى","ghanamī","my sheep","আমার ছাগল ( পালের )"],["وَلِىَ","waliya","and for me","এবং আমার আছে"],["فِيهَا","fīhā","in it","তা দ্বারা"],["مَـَٔارِبُ","maāribu","(are) uses","প্রয়োজনসমূহ"],["أُخْرَىٰ","ukh'rā","other","আরও ( কিছু )\""]],"t":"قَالَ هِىَ عَصَاىَ أَتَوَكَّؤُ<s>ا۟</> عَلَيْهَا وَأَهُشُّ بِهَا عَلَىٰ غَنَمِى وَلِىَ فِيهَا مَـَٔارِبُ أُخْرَىٰ"},{"n":19,"w":[["قَالَ","qāla","He said","( আল্লাহ ) বললেন"],["أَلْقِهَا","alqihā","Throw it down","\"তা নিক্ষেপ করো"],["يَـٰمُوسَىٰ","yāmūsā","O Musa","হে মূসা\""]],"t":"قَالَ أَلْقِهَا <m>يَٰ</>مُوسَىٰ"},{"n":20,"w":[["فَأَلْقَىٰهَا","fa-alqāhā","So he threw it down","অতঃপর তা সে নিক্ষেপ করলো"],["فَإِذَا","fa-idhā","and behold","সঙ্গে সঙ্গে"],["هِىَ","hiya","It","তা ( হলো )"],["حَيَّةٌۭ","ḥayyatun","(was) a snake","সাপ"],["تَسْعَىٰ","tas‘ā","moving swiftly","( যা ) ছুটোছুটি করতে লাগলো"]],"t":"فَأَلْقَ<m>ىٰ</>هَا فَإِذَا هِىَ حَيَّ<k>ةٌۭ تَ</>سْعَىٰ"},{"n":21,"w":[["قَالَ","qāla","He said","তিনি বললেন"],["خُذْهَا","khudh'hā","Seize it","\"তা ধরো"],["وَلَا","walā","and (do) not","এবং না"],["تَخَفْ ۖ","takhaf","fear","ভয় করো তুমি"],["سَنُعِيدُهَا","sanu‘īduhā","We will return it","অচিরেই তা ফিরিয়ে দিবো আমরা"],["سِيرَتَهَا","sīratahā","(to) its state","তার অবস্থায়"],["ٱلْأُولَىٰ","l-ūlā","the former","পূর্বের"]],"t":"قَالَ خُذْهَا وَلَا تَخَفْ ۖ سَنُعِيدُهَا سِيرَتَهَا <h>ٱ</>لْأُولَىٰ"},{"n":22,"w":[["وَٱضْمُمْ","wa-uḍ'mum","And draw near","এবং চেপে ধরো"],["يَدَكَ","yadaka","your hand","তোমার হাত"],["إِلَىٰ","ilā","to","মধ্যে"],["جَنَاحِكَ","janāḥika","your side","তোমার বগলের"],["تَخْرُجْ","takhruj","it will come out","বের হবে তা"],["بَيْضَآءَ","bayḍāa","white","উজ্জ্বল"],["مِنْ","min","without any","কোন"],["غَيْرِ","ghayri","without any","ছাড়াই"],["سُوٓءٍ","sūin","disease","দোষ"],["ءَايَةً","āyatan","(as) a sign","নিদর্শন"],["أُخْرَىٰ","ukh'rā","another","অপর ( একটি )"]],"t":"وَ<h>ٱ</>ضْمُمْ يَدَكَ إِلَىٰ جَنَاحِكَ تَخْرُ<q>جْ</> بَيْ<o>ضَآ</>ءَ مِنْ غَيْرِ <o>سُوٓ</>ءٍ ءَايَةً أُخْرَىٰ"},{"n":23,"w":[["لِنُرِيَكَ","linuriyaka","That We may show you","তোমাকে যেন আমরা দেখাই"],["مِنْ","min","of","মধ্য হ'তে"],["ءَايَـٰتِنَا","āyātinā","Our Signs","আমাদের নিদর্শনাবলীর"],["ٱلْكُبْرَى","l-kub'rā","the Greatest","বড় বড় ( কয়েকটি )"]],"t":"لِنُرِيَكَ مِنْ ءَا<m>يَٰ</>تِنَا <h>ٱ</>لْكُ<q>بْ</>رَى"},{"n":24,"w":[["ٱذْهَبْ","idh'hab","Go","তুমি যাও"],["إِلَىٰ","ilā","to","কাছে"],["فِرْعَوْنَ","fir'‘awna","Firaun","ফিরআউনের"],["إِنَّهُۥ","innahu","Indeed, he","সে নিশ্চয়ই"],["طَغَىٰ","ṭaghā","(has) transgressed","সীমালঙ্ঘন করেছে\""]],"t":"ٱذْهَ<q>بْ</> إِلَىٰ فِرْعَوْنَ إِ<g>نَّ</>هُ<m>ۥ</> طَغَىٰ"},{"n":25,"w":[["قَالَ","qāla","He said","( মূসা ) বললো"],["رَبِّ","rabbi","My Lord","\"হে আমার রব"],["ٱشْرَحْ","ish'raḥ","Expand","প্রশস্ত করো"],["لِى","lī","for me","আমার জন্যে"],["صَدْرِى","ṣadrī","my breast","আমার বক্ষ"]],"t":"قَالَ رَبِّ <h>ٱ</>شْرَحْ لِى صَ<q>دْ</>رِى"},{"n":26,"w":[["وَيَسِّرْ","wayassir","And ease","এবং সহজ করো"],["لِىٓ","lī","for me","আমার জন্যে"],["أَمْرِى","amrī","my task","আমার কাজ"]],"t":"وَيَسِّرْ <o>لِىٓ</> أَمْرِى"},{"n":27,"w":[["وَٱحْلُلْ","wa-uḥ'lul","And untie","এবং খুলে দাও"],["عُقْدَةًۭ","‘uq'datan","(the) knot","গিরা (জড়তা)"],["مِّن","min","from","থেকে"],["لِّسَانِى","lisānī","my tongue","আমার জিহবার"]],"t":"وَ<h>ٱ</>حْلُلْ عُ<q>قْ</>دَ<d>ةًۭ مِّ</><w>ن لِّ</>سَانِى"},{"n":28,"w":[["يَفْقَهُوا۟","yafqahū","That they may understand","তারা বুঝে ( যেন )"],["قَوْلِى","qawlī","my speech","আমার কথা"]],"t":"يَفْقَهُو<s>ا۟</> قَوْلِى"},{"n":29,"w":[["وَٱجْعَل","wa-ij'‘al","And appoint","এবং বানিয়ে দাও"],["لِّى","lī","for me","আমার জন্যে"],["وَزِيرًۭا","wazīran","a minister","একজন সাহায্যকারী"],["مِّنْ","min","from","মধ্য হ'তে"],["أَهْلِى","ahlī","my family","আমার পরিবারের"]],"t":"وَ<h>ٱ</><q>جْ</>عَل لِّى وَزِي<d>رًۭا مِّ</>نْ أَهْلِى"},{"n":30,"w":[["هَـٰرُونَ","hārūna","Harun","হারুনকে"],["أَخِى","akhī","my brother","( যে ) আমার ভাই"]],"t":"<m>هَٰ</>رُونَ أَخِى"},{"n":31,"w":[["ٱشْدُدْ","ush'dud","Reinforce","সুদৃঢ় করো"],["بِهِۦٓ","bihi","through him","তাকে দিয়ে"],["أَزْرِى","azrī","my strength","আমার শক্তি"]],"t":"ٱشْدُ<q>دْ</> بِ<o>هِۦٓ</> أَزْرِى"},{"n":32,"w":[["وَأَشْرِكْهُ","wa-ashrik'hu","And make him share","এবং তাকে শরীক করো"],["فِىٓ","fī","[in]","ক্ষেত্রে"],["أَمْرِى","amrī","my task","আমার কাজের"]],"t":"وَأَشْرِكْهُ <o>فِىٓ</> أَمْرِى"},{"n":33,"w":[["كَىْ","kay","That","যেন"],["نُسَبِّحَكَ","nusabbiḥaka","we may glorify You","তোমার মহিমা ঘোষণা করতে পারি আমরা"],["كَثِيرًۭا","kathīran","much","অধিক (পরিমাণে)"]],"t":"كَىْ نُسَبِّحَكَ كَثِيرًۭا"},{"n":34,"w":[["وَنَذْكُرَكَ","wanadhkuraka","And [we] remember You","এবং তোমাকে (যেন) স্মরণ করতে পারি আমরা"],["كَثِيرًا","kathīran","much","অধিক"]],"t":"وَنَذْكُرَكَ كَثِيرًا"},{"n":35,"w":[["إِنَّكَ","innaka","Indeed, [You]","নিশ্চয়ই তুমি"],["كُنتَ","kunta","You are","আছো"],["بِنَا","binā","of us","আমাদের উপর"],["بَصِيرًۭا","baṣīran","All-Seer","দৃষ্টিবান\""]],"t":"إِ<g>نَّ</>كَ كُ<k>نتَ</> بِنَا بَصِيرًۭا"},{"n":36,"w":[["قَالَ","qāla","He said","তিনি বললেন"],["قَدْ","qad","Verily","\"নিশ্চয়ই"],["أُوتِيتَ","ūtīta","you are granted","তোমাকে দেয়া হলো"],["سُؤْلَكَ","su'laka","your request","তোমার চাওয়া"],["يَـٰمُوسَىٰ","yāmūsā","O Musa","হে মূসা"]],"t":"قَالَ قَ<q>دْ</> أُوتِيتَ سُؤْلَكَ <m>يَٰ</>مُوسَىٰ"},{"n":37,"w":[["وَلَقَدْ","walaqad","And indeed","এবং নিশ্চয়ই"],["مَنَنَّا","manannā","We conferred a favor","আমরা অনুগ্রহ করেছিলাম"],["عَلَيْكَ","‘alayka","on you","তোমার উপর"],["مَرَّةً","marratan","another time","একবার"],["أُخْرَىٰٓ","ukh'rā","another time","আরও"]],"t":"وَلَقَ<q>دْ</> مَنَ<g>نَّ</>ا عَلَيْكَ مَرَّةً أُخْرَىٰٓ"},{"n":38,"w":[["إِذْ","idh","When","(স্মরণ করো) যখন"],["أَوْحَيْنَآ","awḥaynā","We inspired","আমরা ইঙ্গিত করেছিলাম"],["إِلَىٰٓ","ilā","to","প্রতি"],["أُمِّكَ","ummika","your mother","তোমার মার"],["مَا","mā","what","(এভাবে) যা"],["يُوحَىٰٓ","yūḥā","is inspired","ওহী করা হয়।"]],"t":"إِذْ أَوْحَيْ<o>نَآ</> إِلَ<o>ىٰٓ</> أُ<g>مِّ</>كَ مَا يُوحَىٰٓ"},{"n":39,"w":[["أَنِ","ani","That","\"যে"],["ٱقْذِفِيهِ","iq'dhifīhi","cast him","তাকে নিক্ষেপ করো (অর্থাৎ রেখে দাও)"],["فِى","fī","in","মধ্যে"],["ٱلتَّابُوتِ","l-tābūti","the chest","সিন্দুকের"],["فَٱقْذِفِيهِ","fa-iq'dhifīhi","then cast it","অতঃপর তা নিক্ষেপ করো (অর্থাৎ ভাসিয়ে দাও)"],["فِى","fī","in","মধ্যে"],["ٱلْيَمِّ","l-yami","the river","নদীর"],["فَلْيُلْقِهِ","falyul'qihi","then let cast it","অতঃপর তা ঠেলে দিবে"],["ٱلْيَمُّ","l-yamu","the river","নদী"],["بِٱلسَّاحِلِ","bil-sāḥili","on the bank","তীরের দিকে"],["يَأْخُذْهُ","yakhudh'hu","will take him","তা তুলে নিবে"],["عَدُوٌّۭ","‘aduwwun","an enemy","শত্রু"],["لِّى","lī","to Me","আমার"],["وَعَدُوٌّۭ","wa‘aduwwun","and an enemy","ও শত্রু"],["لَّهُۥ ۚ","lahu","to him","তার\""],["وَأَلْقَيْتُ","wa-alqaytu","And I cast","এবং আমি ঢেলে দিয়েছিলাম"],["عَلَيْكَ","‘alayka","over you","তোমার উপর"],["مَحَبَّةًۭ","maḥabbatan","love","ভালবাসা"],["مِّنِّى","minnī","from Me","আমার পক্ষ হ'তে"],["وَلِتُصْنَعَ","walituṣ'na‘a","and that you may be brought up","এবং তুমি লালিতপালিত হও যেন"],["عَلَىٰ","‘alā","under","সামনে"],["عَيْنِىٓ","‘aynī","My eye","আমার চোখের"]],"t":"أَنِ <h>ٱ</><q>قْ</>ذِفِيهِ فِى <h>ٱ</><l>ل</>تَّابُوتِ فَ<h>ٱ</><q>قْ</>ذِفِيهِ فِى <h>ٱ</>لْيَ<g>مِّ</> فَلْيُلْقِهِ <h>ٱ</>لْيَ<g>مُّ</> بِ<h>ٱ</><l>ل</>سَّاحِلِ يَأْخُذْهُ عَدُ<w>وٌّۭ لِّ</>ى وَعَدُ<w>وٌّۭ لَّ</>هُ<m>ۥ</> ۚ وَأَلْقَيْتُ عَلَيْكَ مَحَبَّ<d>ةًۭ مِّ</><g>نِّ</>ى وَلِتُصْنَعَ عَلَىٰ عَيْنِىٓ"},{"n":40,"w":[["إِذْ","idh","When","(স্মরণ করো) যখন"],["تَمْشِىٓ","tamshī","was going","চলেছিলো"],["أُخْتُكَ","ukh'tuka","your sister","তোমার বোন"],["فَتَقُولُ","fataqūlu","and she said","অতঃপর বলেছিলো"],["هَلْ","hal","Shall","\"কি"],["أَدُلُّكُمْ","adullukum","I show you","তোমাদের খোঁজ দিবো"],["عَلَىٰ","‘alā","[to]","এ বিষয়ে (যে)"],["مَن","man","(one) who","কে"],["يَكْفُلُهُۥ ۖ","yakfuluhu","will nurse and rear him","তাকে লালন-পালন করতে পারে\""],["فَرَجَعْنَـٰكَ","faraja‘nāka","So We returned you","তখন তোমাকে আমরা ফিরিয়ে দিলাম"],["إِلَىٰٓ","ilā","to","কাছে"],["أُمِّكَ","ummika","your mother","তোমার মায়ের"],["كَىْ","kay","that","যেন"],["تَقَرَّ","taqarra","may be cooled","জুড়ায়"],["عَيْنُهَا","‘aynuhā","her eyes","তার চোখ"],["وَلَا","walā","and not","এবং না"],["تَحْزَنَ ۚ","taḥzana","she grieves","দুঃখ পায়"],["وَقَتَلْتَ","waqatalta","And you killed","এবং (স্মরণ করো) তুমি হত্যা করেছিলে"],["نَفْسًۭا","nafsan","a man","এক ব্যক্তিকে"],["فَنَجَّيْنَـٰكَ","fanajjaynāka","but We saved you","অতঃপর তোমাকে আমরা মুক্তি দিয়েছিলাম"],["مِنَ","mina","from","হ'তে"],["ٱلْغَمِّ","l-ghami","the distress","মানসিক কষ্ট"],["وَفَتَنَّـٰكَ","wafatannāka","and We tried you","এবং তোমাকে আমরা পরীক্ষা করেছি"],["فُتُونًۭا ۚ","futūnan","(with) a trial","(কঠিন) পরীক্ষা"],["فَلَبِثْتَ","falabith'ta","Then you remained","অতঃপর তুমি অবস্থান করেছিলে"],["سِنِينَ","sinīna","(some) years","(কয়েক) বছর"],["فِىٓ","fī","with","মধ্যে"],["أَهْلِ","ahli","(the) people","অধিবাসীদের"],["مَدْيَنَ","madyana","(of) Madyan","মা'দয়ানের"],["ثُمَّ","thumma","Then","এরপর"],["جِئْتَ","ji'ta","you came","তুমি এসেছো"],["عَلَىٰ","‘alā","at","উপর"],["قَدَرٍۢ","qadarin","the decreed (time)","নির্ধারিত সময়ের"],["يَـٰمُوسَىٰ","yāmūsā","O Musa","হে মূসা"]],"t":"إِذْ تَمْ<o>شِىٓ</> أُخْتُكَ فَتَقُولُ هَلْ أَدُلُّكُمْ عَلَىٰ <d>مَن يَ</>كْفُلُهُ<m>ۥ</> ۖ فَرَجَعْ<m>نَٰ</>كَ إِلَ<o>ىٰٓ</> أُ<g>مِّ</>كَ كَىْ تَقَرَّ عَيْنُهَا وَلَا تَحْزَنَ ۚ وَقَتَلْتَ نَفْ<k>سًۭا فَ</>نَجَّيْ<m>نَٰ</>كَ مِنَ <h>ٱ</>لْغَ<g>مِّ</> وَفَتَ<g>نَّٰ</>كَ فُتُو<k>نًۭا ۚ فَ</>لَبِثْتَ سِنِينَ <o>فِىٓ</> أَهْلِ مَ<q>دْ</>يَنَ ثُ<g>مَّ</> جِئْتَ عَلَىٰ قَدَ<d>رٍۢ يَٰ</>مُوسَىٰ"},{"n":41,"w":[["وَٱصْطَنَعْتُكَ","wa-iṣ'ṭana‘tuka","And I (have) chosen you","এবং তোমাকে আমি প্রস্তুত করেছি"],["لِنَفْسِى","linafsī","for Myself","আমার নিজের (কাজের) জন্যে"]],"t":"وَ<h>ٱ</>صْطَنَعْتُكَ لِنَفْسِى"},{"n":42,"w":[["ٱذْهَبْ","idh'hab","Go","যাও"],["أَنتَ","anta","you","তুমি"],["وَأَخُوكَ","wa-akhūka","and your brother","ও তোমার ভাই"],["بِـَٔايَـٰتِى","biāyātī","with My Signs","নিয়ে আমার নির্দেশনাবলী"],["وَلَا","walā","and (do) not","এবং না"],["تَنِيَا","taniyā","slacken","তোমরা দু'জনে আসল্য করো"],["فِى","fī","in","ক্ষেত্রে"],["ذِكْرِى","dhik'rī","My remembrance","আমার স্মরণের"]],"t":"ٱذْهَ<q>بْ</> أَ<k>نتَ</> وَأَخُوكَ بِـَٔا<m>يَٰ</>تِى وَلَا تَنِيَا فِى ذِكْرِى"},{"n":43,"w":[["ٱذْهَبَآ","idh'habā","Go, both of you","দু'জনে যাও"],["إِلَىٰ","ilā","to","নিকট"],["فِرْعَوْنَ","fir'‘awna","Firaun","ফিরআউনের"],["إِنَّهُۥ","innahu","Indeed, he","সে নিশ্চয়ই"],["طَغَىٰ","ṭaghā","(has) transgressed","সীমালঙ্ঘন করেছে"]],"t":"ٱذْهَ<o>بَآ</> إِلَىٰ فِرْعَوْنَ إِ<g>نَّ</>هُ<m>ۥ</> طَغَىٰ"},{"n":44,"w":[["فَقُولَا","faqūlā","And speak","অতঃপর দু'জনে বলবে"],["لَهُۥ","lahu","to him","তার সাথে"],["قَوْلًۭا","qawlan","a word","কথা"],["لَّيِّنًۭا","layyinan","gentle","নম্রভাবে"],["لَّعَلَّهُۥ","la‘allahu","perhaps he","সে সম্ভবতঃ"],["يَتَذَكَّرُ","yatadhakkaru","may take heed","উপদেশ গ্রহণ করবে"],["أَوْ","aw","or","অথবা"],["يَخْشَىٰ","yakhshā","fear","ভয় করবে\""]],"t":"فَقُولَا لَهُ<m>ۥ</> قَوْلًۭ<w>ا لَّيِّنًۭا لَّ</>عَلَّهُ<m>ۥ</> يَتَذَكَّرُ أَوْ يَخْشَىٰ"},{"n":45,"w":[["قَالَا","qālā","They said","তারা (দু'জনে) বললো"],["رَبَّنَآ","rabbanā","Our Lord","\"হে আমাদের রব"],["إِنَّنَا","innanā","Indeed, we","নিশ্চয়ই আমরা"],["نَخَافُ","nakhāfu","fear","আশংকা করি আমরা"],["أَن","an","that","যে"],["يَفْرُطَ","yafruṭa","he will hasten","ফিরআউন দুর্ব্যবহার করবে"],["عَلَيْنَآ","‘alaynā","against us","আমাদের সাথে"],["أَوْ","aw","or","অথবা"],["أَن","an","that","যে"],["يَطْغَىٰ","yaṭghā","he will transgress","সে সীমালংঘন করবে\""]],"t":"قَالَا رَبَّ<o>نَآ</> إِ<g>نَّ</>نَا نَخَافُ <d>أَن يَ</>فْرُطَ عَلَيْ<o>نَآ</> أَوْ <d>أَن يَ</><q>طْ</>غَىٰ"},{"n":46,"w":[["قَالَ","qāla","He said","তিনি বললেন"],["لَا","lā","(Do) not","\"না"],["تَخَافَآ ۖ","takhāfā","fear","তোমরা দু'জনে ভয় করো"],["إِنَّنِى","innanī","Indeed, I Am","আমি নিশ্চয়ই"],["مَعَكُمَآ","ma‘akumā","with you both","তোমাদের দু'জনের সাথে (আছি)"],["أَسْمَعُ","asma‘u","I hear","আমি শুনি (সবকিছু)"],["وَأَرَىٰ","wa-arā","and I see","ও আমি দেখি (সবকিছু)"]],"t":"قَالَ لَا تَخَا<o>فَآ ۖ</> إِ<g>نَّ</>نِى مَعَكُ<o>مَآ</> أَسْمَعُ وَأَرَىٰ"},{"n":47,"w":[["فَأْتِيَاهُ","fatiyāhu","So go to him","সুতরাং তার কাছে দু'জনে যাও"],["فَقُولَآ","faqūlā","and say","অতঃপর দু'জনে বলো"],["إِنَّا","innā","Indeed, we","\"নিশ্চয়ই আমরা"],["رَسُولَا","rasūlā","both (are) Messengers","দুই রাসূল"],["رَبِّكَ","rabbika","(of) your Lord","তোমার রবের"],["فَأَرْسِلْ","fa-arsil","so send","সুতরাং পাঠাও"],["مَعَنَا","ma‘anā","with us","আমাদের সাথে"],["بَنِىٓ","banī","(the) Children of Israel","বনী"],["إِسْرَٰٓءِيلَ","is'rāīla","(the) Children of Israel","ইসরাঈলকে"],["وَلَا","walā","and (do) not","এবং না"],["تُعَذِّبْهُمْ ۖ","tu‘adhib'hum","torment them","তাদেরকে শাস্তি দিও"],["قَدْ","qad","Verily","নিশ্চয়ই"],["جِئْنَـٰكَ","ji'nāka","we came to you","তোমার কাছে আমরা এসেছি"],["بِـَٔايَةٍۢ","biāyatin","with a Sign","নিয়ে নিদর্শন"],["مِّن","min","from","পক্ষ হ'তে"],["رَّبِّكَ ۖ","rabbika","your Lord","তোমার রবের"],["وَٱلسَّلَـٰمُ","wal-salāmu","And peace","এবং শান্তি"],["عَلَىٰ","‘alā","on","উপর"],["مَنِ","mani","(one) who","(তার) যে"],["ٱتَّبَعَ","ittaba‘a","follows","অনুসরণ করে"],["ٱلْهُدَىٰٓ","l-hudā","the Guidance","সঠিক পথের"]],"t":"فَأْتِيَاهُ فَقُو<o>لَآ</> إِ<g>نَّ</>ا رَسُولَا رَبِّكَ فَأَرْسِلْ مَعَنَا بَ<o>نِىٓ</> إِسْ<o>رَٰٓ</>ءِيلَ وَلَا تُعَذِّ<q>بْ</>هُمْ ۖ قَ<q>دْ</> جِئْ<m>نَٰ</>كَ بِـَٔايَ<d>ةٍۢ مِّ</><w>ن رَّ</>بِّكَ ۖ وَ<h>ٱ</><l>ل</>سَّ<m>لَٰ</>مُ عَلَىٰ مَنِ <h>ٱ</>تَّبَعَ <h>ٱ</>لْهُدَىٰٓ"},{"n":48,"w":[["إِنَّا","innā","Indeed, we","আমরা নিশ্চয়ই (এমন যে)"],["قَدْ","qad","verily","নিশ্চয়ই"],["أُوحِىَ","ūḥiya","it has been revealed","ওহী করা হয়েছে"],["إِلَيْنَآ","ilaynā","to us","প্রতি আমাদের"],["أَنَّ","anna","that","যে"],["ٱلْعَذَابَ","l-‘adhāba","the punishment","শাস্তি"],["عَلَىٰ","‘alā","(will be) on","উপর"],["مَن","man","(one) who","(তার) যে"],["كَذَّبَ","kadhaba","denies","মিথ্যারোপ করবে"],["وَتَوَلَّىٰ","watawallā","and turns away","ও মুখ ফিরাবে (অমান্য করবে)\""]],"t":"إِ<g>نَّ</>ا قَ<q>دْ</> أُوحِىَ إِلَيْ<o>نَآ</> أَ<g>نَّ</> <h>ٱ</>لْعَذَابَ عَلَىٰ مَ<k>ن كَ</>ذَّبَ وَتَوَلَّىٰ"},{"n":49,"w":[["قَالَ","qāla","He said","(ফিরআউন) বললো"],["فَمَن","faman","Then who","\"তাহ'লে কে"],["رَّبُّكُمَا","rabbukumā","(is) your Lord","তোমাদের দু'জনের রব"],["يَـٰمُوسَىٰ","yāmūsā","O Musa","হে মূসা\""]],"t":"قَالَ فَ<w>مَن رَّ</>بُّكُمَا <m>يَٰ</>مُوسَىٰ"},{"n":50,"w":[["قَالَ","qāla","He said","মূসা বললো"],["رَبُّنَا","rabbunā","Our Lord","\"আমাদের রব"],["ٱلَّذِىٓ","alladhī","(is) the One Who","(তিনি) যিনি"],["أَعْطَىٰ","a‘ṭā","gave","দিয়েছেন"],["كُلَّ","kulla","(to) every","প্রত্যেক"],["شَىْءٍ","shayin","thing","বস্তুকে"],["خَلْقَهُۥ","khalqahu","its form","তার সৃষ্টি কাঠামো"],["ثُمَّ","thumma","then","এরপর"],["هَدَىٰ","hadā","He guided (it)","পথ দেখিয়েছেন\""]],"t":"قَالَ رَبُّنَا <h>ٱ</>لَّ<o>ذِىٓ</> أَعْطَىٰ كُلَّ شَىْءٍ خَلْقَهُ<m>ۥ</> ثُ<g>مَّ</> هَدَىٰ"},{"n":51,"w":[["قَالَ","qāla","He said","সে বললো"],["فَمَا","famā","Then what","\"তাহ'লে কি (হবে)"],["بَالُ","bālu","(is the) case","অবস্থা"],["ٱلْقُرُونِ","l-qurūni","(of) the generations","শত শত বছরের বংশধরদের"],["ٱلْأُولَىٰ","l-ūlā","(of) the former","পূর্বের\""]],"t":"قَالَ فَمَا بَالُ <h>ٱ</>لْقُرُونِ <h>ٱ</>لْأُولَىٰ"},{"n":52,"w":[["قَالَ","qāla","He said","সে বললো"],["عِلْمُهَا","‘il'muhā","Its knowledge","\"তার জ্ঞান"],["عِندَ","‘inda","(is) with","নিকট (আছে)"],["رَبِّى","rabbī","my Lord","আমার রবের"],["فِى","fī","in","মধ্যে"],["كِتَـٰبٍۢ ۖ","kitābin","a Record","একটি কিতাবের (সংরক্ষিত)"],["لَّا","lā","Not","না"],["يَضِلُّ","yaḍillu","errs","ভুল করেন"],["رَبِّى","rabbī","my Lord","আমার রব"],["وَلَا","walā","and not","আর না"],["يَنسَى","yansā","forgets","ভুলে যান\""]],"t":"قَالَ عِلْمُهَا عِ<k>ندَ</> رَبِّى فِى كِ<m>تَٰ</><w>بٍۢ ۖ لَّ</>ا يَضِلُّ رَبِّى وَلَا يَ<k>نسَ</>ى"},{"n":53,"w":[["ٱلَّذِى","alladhī","The One Who","যিনি"],["جَعَلَ","ja‘ala","made","করেছেন"],["لَكُمُ","lakumu","for you","জন্যে তোমাদের"],["ٱلْأَرْضَ","l-arḍa","the earth","পৃথিবীকে"],["مَهْدًۭا","mahdan","(as) a bed","বিছানা"],["وَسَلَكَ","wasalaka","and inserted","ও চালিয়ে দিয়েছেন"],["لَكُمْ","lakum","for you","তোমাদের জন্য"],["فِيهَا","fīhā","therein","তার মধ্যে"],["سُبُلًۭا","subulan","ways","পথসমূহ"],["وَأَنزَلَ","wa-anzala","and sent down","এবং বর্ষণ করেছেন"],["مِنَ","mina","from","থেকে"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশ"],["مَآءًۭ","māan","water","পানি"],["فَأَخْرَجْنَا","fa-akhrajnā","then We (have) brought forth","(আল্লাহ বলেন) অতঃপর আমরা বের করেছি"],["بِهِۦٓ","bihi","with it","তা দিয়ে"],["أَزْوَٰجًۭا","azwājan","pairs","জোড়া জোড়া"],["مِّن","min","of","থেকে"],["نَّبَاتٍۢ","nabātin","plants","উদ্ভিদ"],["شَتَّىٰ","shattā","diverse","বিভিন্ন"]],"t":"ٱلَّذِى جَعَلَ لَكُمُ <h>ٱ</>لْأَرْضَ مَهْ<d>دًۭا وَ</>سَلَكَ لَكُمْ فِيهَا سُبُلًۭ<d>ا وَ</>أَ<k>نزَ</>لَ مِنَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ <o>مَآ</><k>ءًۭ فَ</>أَخْرَ<q>جْ</>نَا بِ<o>هِۦٓ</> أَزْ<m>وَٰ</><d>جًۭا مِّن نَّ</>بَا<k>تٍۢ شَ</>تَّىٰ"},{"n":54,"w":[["كُلُوا۟","kulū","Eat","তোমরা খাও"],["وَٱرْعَوْا۟","wa-ir'‘aw","and pasture","ও তোমরা চড়াও"],["أَنْعَـٰمَكُمْ ۗ","an‘āmakum","your cattle","তোমাদের গবাদি পশুগুলোকে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে (রয়েছে)"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَـٰتٍۢ","laāyātin","surely (are) Signs","অবশ্যই নিদর্শনাবলী"],["لِّأُو۟لِى","li-ulī","for possessors","সম্পন্নদেরদের জন্যে"],["ٱلنُّهَىٰ","l-nuhā","(of) intelligence","বিবেক"]],"t":"كُلُو<s>ا۟</> وَ<h>ٱ</>رْعَوْ<s>ا۟</> أَنْ<m>عَٰ</>مَكُمْ ۗ إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَا<m>يَٰ</><w>تٍۢ لِّ</>أُ<s>و۟</>لِى <h>ٱ</><l>ل</><g>نُّ</>هَىٰ"},{"n":55,"w":[["۞ مِنْهَا","min'hā","From it","তা (অর্থাৎ মাটি) হ'তে"],["خَلَقْنَـٰكُمْ","khalaqnākum","We created you","তোমাদের আমরা সৃষ্টি করেছি"],["وَفِيهَا","wafīhā","and in it","ও তার মধ্যে"],["نُعِيدُكُمْ","nu‘īdukum","We will return you","তোমাদের ফিরিয়ে আনবো আমরা"],["وَمِنْهَا","wamin'hā","and from it","এবং তার মধ্য হ'তে"],["نُخْرِجُكُمْ","nukh'rijukum","We will bring you out","তোমাদের বের করবো আমরা"],["تَارَةً","tāratan","time","একবার"],["أُخْرَىٰ","ukh'rā","another","আরও"]],"t":"۞ مِنْهَا خَلَ<q>قْ</><m>نَٰ</>كُمْ وَفِيهَا نُعِيدُكُمْ وَمِنْهَا نُخْرِجُكُمْ تَارَةً أُخْرَىٰ"},{"n":56,"w":[["وَلَقَدْ","walaqad","And verily","এবং নিশ্চয়ই"],["أَرَيْنَـٰهُ","araynāhu","We showed him","(ফিরআউনকে) তাকে আমরা দেখিয়েছি"],["ءَايَـٰتِنَا","āyātinā","Our Signs","আমাদের নিদর্শনাবলী"],["كُلَّهَا","kullahā","all of them","তা সবই"],["فَكَذَّبَ","fakadhaba","but he denied","কিন্তু সে মিথ্যারোপ করেছে"],["وَأَبَىٰ","wa-abā","and refused","ও অমান্য করেছে"]],"t":"وَلَقَ<q>دْ</> أَرَيْ<m>نَٰ</>هُ ءَا<m>يَٰ</>تِنَا كُلَّهَا فَكَذَّبَ وَأَبَىٰ"},{"n":57,"w":[["قَالَ","qāla","He said","(ফিরআউন) বললো"],["أَجِئْتَنَا","aji'tanā","Have you come to us","\"আমাদের কাছে তুমি এসেছ কি"],["لِتُخْرِجَنَا","litukh'rijanā","to drive us out","আমাদের তুমি বের করার জন্যে"],["مِنْ","min","of","থেকে"],["أَرْضِنَا","arḍinā","our land","আমাদের দেশ"],["بِسِحْرِكَ","bisiḥ'rika","with your magic","তোমার জাদুর বলে"],["يَـٰمُوسَىٰ","yāmūsā","O Musa","হে মূসা"]],"t":"قَالَ أَجِئْتَنَا لِتُخْرِجَنَا مِنْ أَرْضِنَا بِسِحْرِكَ <m>يَٰ</>مُوسَىٰ"},{"n":58,"w":[["فَلَنَأْتِيَنَّكَ","falanatiyannaka","Then we will surely produce for you","সুতরাং আমরা তোমার কাছে অবশ্যই আসবো"],["بِسِحْرٍۢ","bisiḥ'rin","magic","জাদু নিয়ে"],["مِّثْلِهِۦ","mith'lihi","like it","তার অনুরূপ"],["فَٱجْعَلْ","fa-ij'‘al","So make","অতএব স্থির করো"],["بَيْنَنَا","baynanā","between us","আমাদের মাঝে"],["وَبَيْنَكَ","wabaynaka","and between you","ও তোমার মাঝে"],["مَوْعِدًۭا","maw‘idan","an appointment","নির্দিষ্ট সময়"],["لَّا","lā","not","না"],["نُخْلِفُهُۥ","nukh'lifuhu","we will fail it","তা আমরা ব্যতিক্রম করবো"],["نَحْنُ","naḥnu","[we]","(না) আমরা"],["وَلَآ","walā","and not","আর না"],["أَنتَ","anta","you","তুমি"],["مَكَانًۭا","makānan","(in) a place","প্রান্তর"],["سُوًۭى","suwan","even","সমতল\""]],"t":"فَلَنَأْتِيَ<g>نَّ</>كَ بِسِحْ<d>رٍۢ مِّ</>ثْلِ<m>هِۦ</> فَ<h>ٱ</><q>جْ</>عَلْ بَيْنَنَا وَبَيْنَكَ مَوْعِ<w>دًۭا لَّ</>ا نُخْلِفُهُ<m>ۥ</> نَحْنُ وَ<o>لَآ</> أَ<k>نتَ</> مَكَا<k>نًۭا سُ</>وًۭى"},{"n":59,"w":[["قَالَ","qāla","He said","(মূসা) বললো"],["مَوْعِدُكُمْ","maw‘idukum","Your appointment","\"নির্দিষ্ট সময় তোমাদের"],["يَوْمُ","yawmu","(is on the) day","দিন"],["ٱلزِّينَةِ","l-zīnati","(of) the festival","উৎসবের"],["وَأَن","wa-an","and that","এবং (এও) যে"],["يُحْشَرَ","yuḥ'shara","will be assembled","জমায়েত হবে"],["ٱلنَّاسُ","l-nāsu","the people","জনতা"],["ضُحًۭى","ḍuḥan","(at) forenoon","সূর্যোদয়ের সাথে\""]],"t":"قَالَ مَوْعِدُكُمْ يَوْمُ <h>ٱ</><l>ل</>زِّينَةِ وَ<d>أَن يُ</>حْشَرَ <h>ٱ</><l>ل</><g>نَّ</>اسُ ضُحًۭى"},{"n":60,"w":[["فَتَوَلَّىٰ","fatawallā","Then went away","অতঃপর চলে গেলো"],["فِرْعَوْنُ","fir'‘awnu","Firaun","ফিরআউন"],["فَجَمَعَ","fajama‘a","and put together","অতঃপর একত্র করলো"],["كَيْدَهُۥ","kaydahu","his plan","তার কলাকৌশল"],["ثُمَّ","thumma","then","এরপর"],["أَتَىٰ","atā","came","আসলো"]],"t":"فَتَوَلَّىٰ فِرْعَوْنُ فَجَمَعَ كَيْدَهُ<m>ۥ</> ثُ<g>مَّ</> أَتَىٰ"},{"n":61,"w":[["قَالَ","qāla","Said","বললো"],["لَهُم","lahum","to them","তাদেরকে"],["مُّوسَىٰ","mūsā","Musa","মূসা"],["وَيْلَكُمْ","waylakum","Woe to you","\"তোমাদের জন্যে দুর্ভোগ"],["لَا","lā","(Do) not","না"],["تَفْتَرُوا۟","taftarū","invent","তোমরা আরোপ করো"],["عَلَى","‘alā","against","প্রতি"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["كَذِبًۭا","kadhiban","a lie","মিথ্যা"],["فَيُسْحِتَكُم","fayus'ḥitakum","lest He will destroy you","তাহ'লে তোমাদের  ধ্বংস করে দিবেন"],["بِعَذَابٍۢ ۖ","bi‘adhābin","with a punishment","শাস্তি দিয়ে"],["وَقَدْ","waqad","And verily","এবং নিশ্চয়ই"],["خَابَ","khāba","he failed","ব্যর্থ হয়েছে"],["مَنِ","mani","who","(সে) যে"],["ٱفْتَرَىٰ","if'tarā","invented","মিথ্যা রচনা করেছে\""]],"t":"قَالَ لَ<y>هُم مُّ</>وسَىٰ وَيْلَكُمْ لَا تَفْتَرُو<s>ا۟</> عَلَى <h>ٱ</>للَّهِ كَذِ<k>بًۭا فَ</>يُسْحِتَ<f>كُم بِ</>عَذَا<d>بٍۢ ۖ وَ</>قَ<q>دْ</> خَابَ مَنِ <h>ٱ</>فْتَرَىٰ"},{"n":62,"w":[["فَتَنَـٰزَعُوٓا۟","fatanāza‘ū","Then they disputed","অতঃপর তারা মতবিরোধ করলো"],["أَمْرَهُم","amrahum","(in) their affair","কাজে তাদের"],["بَيْنَهُمْ","baynahum","among them","মাঝে তাদের"],["وَأَسَرُّوا۟","wa-asarrū","and they kept secret","এবং গোপনে করলো"],["ٱلنَّجْوَىٰ","l-najwā","the private conversation","পরামর্শ"]],"t":"فَتَ<m>نَٰ</>زَ<o>عُوٓ</><s>ا۟</> أَمْرَ<f>هُم بَ</>يْنَهُمْ وَأَسَرُّو<s>ا۟</> <h>ٱ</><l>ل</><g>نَّ</><q>جْ</>وَىٰ"},{"n":63,"w":[["قَالُوٓا۟","qālū","They said","(অবশেষে কিছু লোক) বললো"],["إِنْ","in","Indeed","\"নিশ্চয়ই"],["هَـٰذَٰنِ","hādhāni","these two","এ দু'জন"],["لَسَـٰحِرَٰنِ","lasāḥirāni","[two] magicians","অবশ্যই দুই জাদুকর"],["يُرِيدَانِ","yurīdāni","they intend","দু'জনে চায়"],["أَن","an","that","যে"],["يُخْرِجَاكُم","yukh'rijākum","they drive you out","দু'জনে বের করে দিবে তোমাদেরকে"],["مِّنْ","min","of","থেকে"],["أَرْضِكُم","arḍikum","your land","তোমাদের দেশ"],["بِسِحْرِهِمَا","bisiḥ'rihimā","with their magic","জাদুর বলে তাদের দু'জনের"],["وَيَذْهَبَا","wayadhhabā","and do away","এবং দু'জনে যাবে (নসাৎ করবে)"],["بِطَرِيقَتِكُمُ","biṭarīqatikumu","with your way","নিয়ে তোমাদের জীবন ব্যবস্থাকে"],["ٱلْمُثْلَىٰ","l-muth'lā","the exemplary","(যা হলো) আদর্শ"]],"t":"قَا<o>لُوٓ</><s>ا۟</> إِنْ <m>هَٰذَٰ</>نِ لَ<m>سَٰحِرَٰ</>نِ يُرِيدَانِ <d>أَن يُ</>خْرِجَا<y>كُم مِّ</>نْ أَرْضِ<f>كُم بِ</>سِحْرِهِمَا وَيَذْهَبَا بِطَرِيقَتِكُمُ <h>ٱ</>لْمُثْلَىٰ"},{"n":64,"w":[["فَأَجْمِعُوا۟","fa-ajmi‘ū","So put together","সুতরাং তোমরা একত্র করো"],["كَيْدَكُمْ","kaydakum","your plan","কলাকৌশল তোমাদের"],["ثُمَّ","thumma","then","এরপর"],["ٱئْتُوا۟","i'tū","come","আসো"],["صَفًّۭا ۚ","ṣaffan","(in) a line","সারি বেঁধে (একত্রিত হয়ে)"],["وَقَدْ","waqad","And verily","এবং নিশ্চয়ই"],["أَفْلَحَ","aflaḥa","(will be) successful","সফল হবে"],["ٱلْيَوْمَ","l-yawma","today","আজ"],["مَنِ","mani","who","যে"],["ٱسْتَعْلَىٰ","is'ta‘lā","overcomes","প্রাধান্য বিস্তার করবে\""]],"t":"فَأَ<q>جْ</>مِعُو<s>ا۟</> كَيْدَكُمْ ثُ<g>مَّ</> <h>ٱ</>ئْتُو<s>ا۟</> صَ<d>فًّۭا ۚ وَ</>قَ<q>دْ</> أَفْلَحَ <h>ٱ</>لْيَوْمَ مَنِ <h>ٱ</>سْتَعْلَىٰ"},{"n":65,"w":[["قَالُوا۟","qālū","They said","(জাদুকররা) বললো"],["يَـٰمُوسَىٰٓ","yāmūsā","O Musa","\"হে মূসা"],["إِمَّآ","immā","Either","হয়"],["أَن","an","[that]","যে"],["تُلْقِىَ","tul'qiya","you throw","তুমি নিক্ষেপ করবে"],["وَإِمَّآ","wa-immā","or","আর (না) হয়"],["أَن","an","[that]","যে"],["نَّكُونَ","nakūna","we will be","আমরা হবো"],["أَوَّلَ","awwala","the first","প্রথম"],["مَنْ","man","who","যে"],["أَلْقَىٰ","alqā","throws","নিক্ষেপ করবে\""]],"t":"قَالُو<s>ا۟</> <m>يَٰ</>مُوسَ<o>ىٰٓ</> إِ<g>مَّ</><o>آ</> أَ<k>ن تُ</>لْقِىَ وَإِ<g>مَّ</><o>آ</> <d>أَن نَّ</>كُونَ أَوَّلَ مَنْ أَلْقَىٰ"},{"n":66,"w":[["قَالَ","qāla","He said","(মূসা) বললো"],["بَلْ","bal","Nay","\"বরং"],["أَلْقُوا۟ ۖ","alqū","you throw","তোমরা নিক্ষেপ করো\""],["فَإِذَا","fa-idhā","Then behold","অতঃপর তখন"],["حِبَالُهُمْ","ḥibāluhum","Their ropes","তাদের দড়াদড়ি"],["وَعِصِيُّهُمْ","wa‘iṣiyyuhum","and their staffs","ও তাদের লাঠিসোটাগুলো"],["يُخَيَّلُ","yukhayyalu","seemed","মনে হলো"],["إِلَيْهِ","ilayhi","to him","তার দিকে"],["مِن","min","by","কারণে"],["سِحْرِهِمْ","siḥ'rihim","their magic","তাদের জাদুর"],["أَنَّهَا","annahā","that they","তা যে"],["تَسْعَىٰ","tas‘ā","(were) moving","ছুটোছুটি"]],"t":"قَالَ بَلْ أَلْقُو<s>ا۟ ۖ</> فَإِذَا حِبَالُهُمْ وَعِصِيُّهُمْ يُخَيَّلُ إِلَيْهِ مِ<k>ن سِ</>حْرِهِمْ أَ<g>نَّ</>هَا تَسْعَىٰ"},{"n":67,"w":[["فَأَوْجَسَ","fa-awjasa","So sensed","অতঃপর অনুভব করলো"],["فِى","fī","in","মধ্যে"],["نَفْسِهِۦ","nafsihi","himself","তার নিজের"],["خِيفَةًۭ","khīfatan","a fear","ভয়"],["مُّوسَىٰ","mūsā","Musa","মূসা (নিজেও)"]],"t":"فَأَوْجَسَ فِى نَفْسِ<m>هِۦ</> خِيفَ<d>ةًۭ مُّ</>وسَىٰ"},{"n":68,"w":[["قُلْنَا","qul'nā","We said","আমরা বললাম"],["لَا","lā","(Do) not","\"না"],["تَخَفْ","takhaf","fear","ভয় করো"],["إِنَّكَ","innaka","Indeed, you","তুমি নিশ্চয়ই"],["أَنتَ","anta","you","তুমিই"],["ٱلْأَعْلَىٰ","l-a‘lā","(will be) superior","বিজয়ী (হবে)"]],"t":"قُلْنَا لَا تَخَفْ إِ<g>نَّ</>كَ أَ<k>نتَ</> <h>ٱ</>لْأَعْلَىٰ"},{"n":69,"w":[["وَأَلْقِ","wa-alqi","And throw","এবং নিক্ষেপ করো"],["مَا","mā","what","যা"],["فِى","fī","(is) in","মধ্যে (আছে)"],["يَمِينِكَ","yamīnika","your right hand","তোমার ডান হাতের"],["تَلْقَفْ","talqaf","it will swallow up","গ্রাস করবে"],["مَا","mā","what","যা কিছু"],["صَنَعُوٓا۟ ۖ","ṣana‘ū","they have made","তারা বানিয়েছে"],["إِنَّمَا","innamā","Only","মূলতঃ"],["صَنَعُوا۟","ṣana‘ū","they (have) made","তারা বানিয়েছে"],["كَيْدُ","kaydu","a trick","কলাকৌশল"],["سَـٰحِرٍۢ ۖ","sāḥirin","(of) a magician","জাদুকরের"],["وَلَا","walā","and not","এবং না"],["يُفْلِحُ","yuf'liḥu","will be successful","সফল হয়"],["ٱلسَّاحِرُ","l-sāḥiru","the magician","জাদুকর"],["حَيْثُ","ḥaythu","wherever","যেখান থেকেই"],["أَتَىٰ","atā","he comes","আসুক (না কেন)\""]],"t":"وَأَلْقِ مَا فِى يَمِينِكَ تَلْقَفْ مَا صَنَ<o>عُوٓ</><s>ا۟</> ۖ إِ<g>نَّ</>مَا صَنَعُو<s>ا۟</> كَيْدُ <m>سَٰ</>حِ<d>رٍۢ ۖ وَ</>لَا يُفْلِحُ <h>ٱ</><l>ل</>سَّاحِرُ حَيْثُ أَتَىٰ"},{"n":70,"w":[["فَأُلْقِىَ","fa-ul'qiya","So were thrown down","অতঃপর পড়ে গেল"],["ٱلسَّحَرَةُ","l-saḥaratu","the magicians","জাদুকররা"],["سُجَّدًۭا","sujjadan","prostrating","সিজদায়"],["قَالُوٓا۟","qālū","They said","তারা বললো"],["ءَامَنَّا","āmannā","We believe","\"আমরা ঈমান আনলাম"],["بِرَبِّ","birabbi","in (the) Lord","রবের উপর"],["هَـٰرُونَ","hārūna","(of) Harun","হারূনের"],["وَمُوسَىٰ","wamūsā","and Musa","ও মূসার\""]],"t":"فَأُلْقِىَ <h>ٱ</><l>ل</>سَّحَرَةُ سُجَّ<k>دًۭا قَ</>ا<o>لُوٓ</><s>ا۟</> ءَامَ<g>نَّ</>ا بِرَبِّ <m>هَٰ</>رُونَ وَمُوسَىٰ"},{"n":71,"w":[["قَالَ","qāla","He said","(ফিরআউন) বললো"],["ءَامَنتُمْ","āmantum","You believe","\"তোমরা ঈমান এনেছো"],["لَهُۥ","lahu","[to] him","তার উপর"],["قَبْلَ","qabla","before","পূর্বেই"],["أَنْ","an","[that]","যে"],["ءَاذَنَ","ādhana","I gave permission","আমি অনুমতি দিবো"],["لَكُمْ ۖ","lakum","to you","তোমাদেরকে"],["إِنَّهُۥ","innahu","Indeed, he","সে নিশ্চয়ই"],["لَكَبِيرُكُمُ","lakabīrukumu","(is) your chief","অবশ্যই তোমাদের প্রধান"],["ٱلَّذِى","alladhī","the one who","যে"],["عَلَّمَكُمُ","‘allamakumu","taught you","তোমাদেরকে শিখিয়েছে"],["ٱلسِّحْرَ ۖ","l-siḥ'ra","the magic","জাদু"],["فَلَأُقَطِّعَنَّ","fala-uqaṭṭi‘anna","So surely I will cut off","সুতরাং অবশ্যই আমি কেটে দিবো"],["أَيْدِيَكُمْ","aydiyakum","your hands","তোমাদের হাতগুলো"],["وَأَرْجُلَكُم","wa-arjulakum","and your feet","ও তোমাদের পাগুলো"],["مِّنْ","min","of","থেকে"],["خِلَـٰفٍۢ","khilāfin","opposite sides","বিপরীত দিক"],["وَلَأُصَلِّبَنَّكُمْ","wala-uṣallibannakum","and surely I will crucify you","এবং অবশ্যই তোমাদেরকে আমি শুলে চড়াবোই"],["فِى","fī","on","মধ্যে"],["جُذُوعِ","judhū‘i","(the) trunks","কাণ্ডের"],["ٱلنَّخْلِ","l-nakhli","(of) date-palms","খেজুরের"],["وَلَتَعْلَمُنَّ","walata‘lamunna","and surely you will know","এবং তোমরা অবশ্যই জানবেই"],["أَيُّنَآ","ayyunā","which of us","আমাদের মধ্যে কে"],["أَشَدُّ","ashaddu","(is) more severe","কঠোরতর"],["عَذَابًۭا","‘adhāban","(in) punishment","শাস্তি দেওয়াতে"],["وَأَبْقَىٰ","wa-abqā","and more lasting","ও অধিক স্থায়ী\""]],"t":"قَالَ ءَامَ<k>نتُ</>مْ لَهُ<m>ۥ</> قَ<q>بْ</>لَ أَنْ ءَاذَنَ لَكُمْ ۖ إِ<g>نَّ</>هُ<m>ۥ</> لَكَبِيرُكُمُ <h>ٱ</>لَّذِى عَلَّمَكُمُ <h>ٱ</><l>ل</>سِّحْرَ ۖ فَلَأُقَطِّعَ<g>نَّ</> أَيْدِيَكُمْ وَأَرْجُلَ<y>كُم مِّ</>نْ خِ<m>لَٰ</><d>فٍۢ وَ</>لَأُصَلِّبَ<g>نَّ</>كُمْ فِى جُذُوعِ <h>ٱ</><l>ل</><g>نَّ</>خْلِ وَلَتَعْلَمُ<g>نَّ</> أَيُّ<o>نَآ</> أَشَدُّ عَذَا<d>بًۭا وَ</>أَ<q>بْ</>قَىٰ"},{"n":72,"w":[["قَالُوا۟","qālū","They said","তারা বলেছিলো"],["لَن","lan","Never","\"কখনও না"],["نُّؤْثِرَكَ","nu'thiraka","we will prefer you","তোমাকে প্রাধান্য দিবো আমরা"],["عَلَىٰ","‘alā","over","এর উপর"],["مَا","mā","what","যা"],["جَآءَنَا","jāanā","has come to us","আমাদের কাছে এসেছে"],["مِنَ","mina","of","থেকে"],["ٱلْبَيِّنَـٰتِ","l-bayināti","the clear proofs","সুস্পষ্ট নিদর্শনাবলী"],["وَٱلَّذِى","wa-alladhī","and the One Who","এবং যিনি"],["فَطَرَنَا ۖ","faṭaranā","created us","আমাদের সৃষ্টি করেছেন"],["فَٱقْضِ","fa-iq'ḍi","So decree","তাই তুমি বিচার করো"],["مَآ","mā","whatever","যা কিছু"],["أَنتَ","anta","you","তুমি"],["قَاضٍ ۖ","qāḍin","(are) decreeing","বিচারক (করতে চাও)"],["إِنَّمَا","innamā","Only","মূলতঃ"],["تَقْضِى","taqḍī","you can decree","তুমি তো বিচার করতে পারবে"],["هَـٰذِهِ","hādhihi","(for) this","এই"],["ٱلْحَيَوٰةَ","l-ḥayata","life","জীবনে"],["ٱلدُّنْيَآ","l-dun'yā","(of) the world","দুনিয়ার"]],"t":"قَالُو<s>ا۟</> <d>لَن نُّ</>ؤْثِرَكَ عَلَىٰ مَا <o>جَآ</>ءَنَا مِنَ <h>ٱ</>لْبَيِّ<m>نَٰ</>تِ وَ<h>ٱ</>لَّذِى فَطَرَنَا ۖ فَ<h>ٱ</><q>قْ</>ضِ <o>مَآ</> أَ<k>نتَ</> قَاضٍ ۖ إِ<g>نَّ</>مَا تَ<q>قْ</>ضِى <m>هَٰ</>ذِهِ <h>ٱ</>لْحَيَ<s>وٰ</>ةَ <h>ٱ</><l>ل</>دُّنْيَآ"},{"n":73,"w":[["إِنَّآ","innā","Indeed, [we]","নিশ্চয়ই আমরা"],["ءَامَنَّا","āmannā","we believe","আমরা ঈমান এনেছি"],["بِرَبِّنَا","birabbinā","in our Lord","আমাদের রবের উপর"],["لِيَغْفِرَ","liyaghfira","that He may forgive","যেন তিনি ক্ষমা করেন"],["لَنَا","lanā","for us","আমাদের"],["خَطَـٰيَـٰنَا","khaṭāyānā","our sins","আমাদের পাপসমূহকে"],["وَمَآ","wamā","and what","এবং যা"],["أَكْرَهْتَنَا","akrahtanā","you compelled us","আমাদেরকে তুমি বাধ্য করেছো"],["عَلَيْهِ","‘alayhi","on it","তার উপর"],["مِنَ","mina","of","কারণে"],["ٱلسِّحْرِ ۗ","l-siḥ'ri","the magic","জাদুর"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["خَيْرٌۭ","khayrun","(is) Best","উত্তম"],["وَأَبْقَىٰٓ","wa-abqā","and Ever Lasting","ও চিরস্থায়ী\""]],"t":"إِ<g>نَّ</><o>آ</> ءَامَ<g>نَّ</>ا بِرَبِّنَا لِيَغْفِرَ لَنَا خَ<m>طَٰيَٰ</>نَا وَ<o>مَآ</> أَكْرَهْتَنَا عَلَيْهِ مِنَ <h>ٱ</><l>ل</>سِّحْرِ ۗ وَ<h>ٱ</>للَّهُ خَيْ<d>رٌۭ وَ</>أَ<q>بْ</>قَىٰٓ"},{"n":74,"w":[["إِنَّهُۥ","innahu","Indeed, he","(প্রকৃত কথা) তাই নিশ্চয়ই"],["مَن","man","who","যে কেউ"],["يَأْتِ","yati","comes","আসবে"],["رَبَّهُۥ","rabbahu","(to) his Lord","তাদের রবের কাছে"],["مُجْرِمًۭا","muj'riman","(as) a criminal","অপরাধী হয়ে"],["فَإِنَّ","fa-inna","then indeed","অতঃপর নিশ্চয়ই"],["لَهُۥ","lahu","for him","তার জন্যে"],["جَهَنَّمَ","jahannama","(is) Hell","জাহান্নাম"],["لَا","lā","Not","না"],["يَمُوتُ","yamūtu","he will die","সে মরবে"],["فِيهَا","fīhā","in it","তার মধ্যে"],["وَلَا","walā","and not","আর না"],["يَحْيَىٰ","yaḥyā","live","বাঁচবে"]],"t":"إِ<g>نَّ</>هُ<m>ۥ</> <d>مَن يَ</>أْتِ رَبَّهُ<m>ۥ</> مُ<q>جْ</>رِ<k>مًۭا فَ</>إِ<g>نَّ</> لَهُ<m>ۥ</> جَهَ<g>نَّ</>مَ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ"},{"n":75,"w":[["وَمَن","waman","But whoever","এবং যে"],["يَأْتِهِۦ","yatihi","comes to Him","তাঁর কাছে আসবে"],["مُؤْمِنًۭا","mu'minan","(as) a believer","মু'মিন হয়ে"],["قَدْ","qad","verily","নিশ্চয়ই"],["عَمِلَ","‘amila","he has done","সে কাজ করেছে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","the righteous deeds","সৎ"],["فَأُو۟لَـٰٓئِكَ","fa-ulāika","then those","অতঃপর ঐসব লোক"],["لَهُمُ","lahumu","for them","তাদের জন্যে (রয়েছে)"],["ٱلدَّرَجَـٰتُ","l-darajātu","(will be) the ranks","মর্যাদাসমূহ"],["ٱلْعُلَىٰ","l-‘ulā","[the] high","সমুচ্চ"]],"t":"وَ<d>مَن يَ</>أْتِ<m>هِۦ</> مُؤْمِ<k>نًۭا قَ</><q>دْ</> عَمِلَ <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ فَأُ<s>و۟</><o>لَٰٓ</>ئِكَ لَهُمُ <h>ٱ</><l>ل</>دَّرَ<m>جَٰ</>تُ <h>ٱ</>لْعُلَىٰ"},{"n":76,"w":[["جَنَّـٰتُ","jannātu","Gardens","জান্নাত"],["عَدْنٍۢ","‘adnin","(of) Eden","স্থায়ী"],["تَجْرِى","tajrī","flows","প্রবাহিত হয়"],["مِن","min","from","থেকে"],["تَحْتِهَا","taḥtihā","underneath them","তার নিচ"],["ٱلْأَنْهَـٰرُ","l-anhāru","the rivers","ঝর্ণাসমূহ"],["خَـٰلِدِينَ","khālidīna","abiding forever","তারা স্থায়ী হবে"],["فِيهَا ۚ","fīhā","in it","তার মধ্যে"],["وَذَٰلِكَ","wadhālika","And that","এবং এটা"],["جَزَآءُ","jazāu","(is) the reward","পুরস্কার"],["مَن","man","(for him) who","(তার) যে"],["تَزَكَّىٰ","tazakkā","purifies himself","পরিশুদ্ধ হবে"]],"t":"جَ<g>نَّٰ</>تُ عَ<q>دْ</><k>نٍۢ تَ</><q>جْ</>رِى مِ<k>ن تَ</>حْتِهَا <h>ٱ</>لْأَنْ<m>هَٰ</>رُ <m>خَٰ</>لِدِينَ فِيهَا ۚ وَ<m>ذَٰ</>لِكَ جَ<o>زَآ</>ءُ مَ<k>ن تَ</>زَكَّىٰ"},{"n":77,"w":[["وَلَقَدْ","walaqad","And verily","এবং নিশ্চয়ই"],["أَوْحَيْنَآ","awḥaynā","We inspired","আমরা ওহী করেছিলাম"],["إِلَىٰ","ilā","to","প্রতি"],["مُوسَىٰٓ","mūsā","Musa","মূসার"],["أَنْ","an","that","যে"],["أَسْرِ","asri","Travel by night","\"রাতে বেরিয়ে পড়ো"],["بِعِبَادِى","bi‘ibādī","with My slaves","নিয়ে আমার দাসদের"],["فَٱضْرِبْ","fa-iḍ'rib","and strike","অতঃপর (লাঠির) আঘাত করো (অবলম্বন করো)"],["لَهُمْ","lahum","for them","তাদের জন্যে"],["طَرِيقًۭا","ṭarīqan","a path","পথ"],["فِى","fī","in","মধ্যে"],["ٱلْبَحْرِ","l-baḥri","the sea","সাগরের"],["يَبَسًۭا","yabasan","dry","শুকনো"],["لَّا","lā","not","না"],["تَخَـٰفُ","takhāfu","fearing","ভয় করো তুমি"],["دَرَكًۭا","darakan","to be overtaken","ধরা পড়ার"],["وَلَا","walā","and not","আর না"],["تَخْشَىٰ","takhshā","being afraid","ঘাবড়ে যাও তুমি (ডুবে যাওয়ার)\""]],"t":"وَلَقَ<q>دْ</> أَوْحَيْ<o>نَآ</> إِلَىٰ مُوسَ<o>ىٰٓ</> أَنْ أَسْرِ بِعِبَادِى فَ<h>ٱ</>ضْرِ<q>بْ</> لَهُمْ طَرِي<k>قًۭا فِ</>ى <h>ٱ</>لْبَحْرِ يَبَ<w>سًۭا لَّ</>ا تَ<m>خَٰ</>فُ دَرَ<d>كًۭا وَ</>لَا تَخْشَىٰ"},{"n":78,"w":[["فَأَتْبَعَهُمْ","fa-atba‘ahum","Then followed them","অতঃপর তাদের পিছনে তাড়া করলো"],["فِرْعَوْنُ","fir'‘awnu","Firaun","ফিরআউন"],["بِجُنُودِهِۦ","bijunūdihi","with his forces","নিয়ে তার সৈন্যবাহিনী"],["فَغَشِيَهُم","faghashiyahum","but covered them","অতঃপর তাদেরকে ছেয়ে ফেললো"],["مِّنَ","mina","from","(তার) ভিতরে"],["ٱلْيَمِّ","l-yami","the sea","সাগর"],["مَا","mā","what","যা"],["غَشِيَهُمْ","ghashiyahum","covered them","তাদেরকে ছেয়ে নিয়েছিলো"]],"t":"فَأَتْبَعَهُمْ فِرْعَوْنُ بِجُنُودِ<m>هِۦ</> فَغَشِيَ<y>هُم مِّ</>نَ <h>ٱ</>لْيَ<g>مِّ</> مَا غَشِيَهُمْ"},{"n":79,"w":[["وَأَضَلَّ","wa-aḍalla","And led astray","এবং পথভ্রষ্ট করেছিলো"],["فِرْعَوْنُ","fir'‘awnu","Firaun","ফিরআউন"],["قَوْمَهُۥ","qawmahu","his people","তার জাতিকে"],["وَمَا","wamā","and (did) not","এবং না"],["هَدَىٰ","hadā","guide them","সৎপথ দেখিয়েছিলো"]],"t":"وَأَضَلَّ فِرْعَوْنُ قَوْمَهُ<m>ۥ</> وَمَا هَدَىٰ"},{"n":80,"w":[["يَـٰبَنِىٓ","yābanī","O Children of Israel","হে সন্তানগণ"],["إِسْرَٰٓءِيلَ","is'rāīla","O Children of Israel","ইসরাঈলের"],["قَدْ","qad","Verily","নিশ্চয়ই"],["أَنجَيْنَـٰكُم","anjaynākum","We delivered you","তোমাদেরকে আমরা উদ্ধার করেছি"],["مِّنْ","min","from","থেকে"],["عَدُوِّكُمْ","‘aduwwikum","your enemy","তোমাদের শত্রু"],["وَوَٰعَدْنَـٰكُمْ","wawā‘adnākum","and We made a covenant with you","ও তোমাদেরকে 