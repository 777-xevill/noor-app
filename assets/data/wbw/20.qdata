মান আনলো"],["وَعَمِلَ","wa‘amila","and does","এবং কাজ করলো"],["صَـٰلِحًۭا","ṣāliḥan","righteous (deeds)","সৎ"],["ثُمَّ","thumma","then","এরপর"],["ٱهْتَدَىٰ","ih'tadā","remains guided","সৎপথে অবিচলিত থাকলো"]],"t":"وَإِ<g>نِّ</>ى لَغَفَّا<w>رٌۭ لِّ</>مَ<k>ن تَ</>ابَ وَءَامَنَ وَعَمِلَ <m>صَٰ</>لِ<k>حًۭا ثُ</><g>مَّ</> <h>ٱ</>هْتَدَىٰ"},{"n":83,"w":[["۞ وَمَآ","wamā","And what","\"এবং কিসে"],["أَعْجَلَكَ","a‘jalaka","made you hasten","তোমাকে তাড়াহুড়া করালো"],["عَن","‘an","from","থেকে"],["قَوْمِكَ","qawmika","your people","তোমার জাতি"],["يَـٰمُوسَىٰ","yāmūsā","O Musa","হে মূসা\""]],"t":"۞ وَ<o>مَآ</> أَعْجَلَكَ عَ<k>ن قَ</>وْمِكَ <m>يَٰ</>مُوسَىٰ"},{"n":84,"w":[["قَالَ","qāla","He said","সে বললো"],["هُمْ","hum","They","\"তারা"],["أُو۟لَآءِ","ulāi","(are) close","ঐ তো"],["عَلَىٰٓ","‘alā","upon","উপর"],["أَثَرِى","atharī","my tracks","আমার চিহ্নের"],["وَعَجِلْتُ","wa‘ajil'tu","and I hastened","এবং আমি তাড়াহুড়া করেছি"],["إِلَيْكَ","ilayka","to you","তোমার দিকে"],["رَبِّ","rabbi","my Lord","হে আমার রব"],["لِتَرْضَىٰ","litarḍā","that You be pleased","যেন তুমি সন্তুষ্ট হও\""]],"t":"قَالَ هُمْ أُ<s>و۟</><o>لَآ</>ءِ عَلَ<o>ىٰٓ</> أَثَرِى وَعَجِلْتُ إِلَيْكَ رَبِّ لِتَرْضَىٰ"},{"n":85,"w":[["قَالَ","qāla","He said","(আল্লাহ) বললেন"],["فَإِنَّا","fa-innā","But indeed, We","\"অতঃপর নিশ্চয়ই আমরা"],["قَدْ","qad","[verily]","নিশ্চয়ই"],["فَتَنَّا","fatannā","We (have) tried","আমরা পরীক্ষায় ফেলেছি"],["قَوْمَكَ","qawmaka","your people","তোমার জাতিকে"],["مِنۢ","min","after you","থেকে"],["بَعْدِكَ","ba‘dika","after you","তোমার পর"],["وَأَضَلَّهُمُ","wa-aḍallahumu","and has led them astray","এবং তাদেরকে পথভ্রষ্ট করেছে"],["ٱلسَّامِرِىُّ","l-sāmiriyu","the Samiri","সামেরী\""]],"t":"قَالَ فَإِ<g>نَّ</>ا قَ<q>دْ</> فَتَ<g>نَّ</>ا قَوْمَكَ <i>مِنۢ بَ</>عْدِكَ وَأَضَلَّهُمُ <h>ٱ</><l>ل</>سَّامِرِىُّ"},{"n":86,"w":[["فَرَجَعَ","faraja‘a","Then Musa returned","অতঃপর ফিরে আসলো"],["مُوسَىٰٓ","mūsā","Then Musa returned","মূসা"],["إِلَىٰ","ilā","to","কাছে"],["قَوْمِهِۦ","qawmihi","his people","তার লোকদের"],["غَضْبَـٰنَ","ghaḍbāna","angry","রাগান্বিত হয়ে"],["أَسِفًۭا ۚ","asifan","(and) sorrowful","অনুতপ্ত অবস্থায়"],["قَالَ","qāla","He said","সে বললো"],["يَـٰقَوْمِ","yāqawmi","O my people","\"হে আমার জাতি"],["أَلَمْ","alam","Did not","নি কি"],["يَعِدْكُمْ","ya‘id'kum","promise you","প্রতিশ্রুতি দেন তোমাদের"],["رَبُّكُمْ","rabbukum","your Lord","তোমাদের রব"],["وَعْدًا","wa‘dan","a promise","প্রতিশ্রুতি"],["حَسَنًا ۚ","ḥasanan","good","উত্তম"],["أَفَطَالَ","afaṭāla","Then, did seem long","কি  সুদীর্ঘ হয়েছে তবে"],["عَلَيْكُمُ","‘alaykumu","to you","তোমাদের উপর"],["ٱلْعَهْدُ","l-‘ahdu","the promise","প্রতিশ্রুতির সময়"],["أَمْ","am","or","অথবা"],["أَرَدتُّمْ","aradttum","did you desire","তোমরা চেয়েছো"],["أَن","an","that","যে"],["يَحِلَّ","yaḥilla","descend","অবধারিত হোক"],["عَلَيْكُمْ","‘alaykum","upon you","তোমাদের উপর"],["غَضَبٌۭ","ghaḍabun","(the) Anger","রাগ"],["مِّن","min","of","পক্ষ হ'তে"],["رَّبِّكُمْ","rabbikum","your Lord","তোমাদের রবের"],["فَأَخْلَفْتُم","fa-akhlaftum","so you broke","অতঃপর তোমরা ভঙ্গ করেছ"],["مَّوْعِدِى","maw‘idī","(the) promise to me","আমার সাথে করা প্রতিশ্রুতি\""]],"t":"فَرَجَعَ مُوسَ<o>ىٰٓ</> إِلَىٰ قَوْمِ<m>هِۦ</> غَضْ<m>بَٰ</>نَ أَسِ<k>فًۭا ۚ قَ</>الَ <m>يَٰ</>قَوْمِ أَلَمْ يَعِ<q>دْ</>كُمْ رَبُّكُمْ وَعْدًا حَسَنًا ۚ أَفَطَالَ عَلَيْكُمُ <h>ٱ</>لْعَهْدُ أَمْ أَرَ<j>د</>تُّمْ <d>أَن يَ</>حِلَّ عَلَيْكُمْ غَضَ<d>بٌۭ مِّ</><w>ن رَّ</>بِّكُمْ فَأَخْلَفْ<y>تُم مَّ</>وْعِدِى"},{"n":87,"w":[["قَالُوا۟","qālū","They said","তারা বললো"],["مَآ","mā","Not","\"না"],["أَخْلَفْنَا","akhlafnā","we broke","আমরা ভঙ্গ করেছি"],["مَوْعِدَكَ","maw‘idaka","promise to you","তোমার সাথে করা প্রতিশ্রুতি"],["بِمَلْكِنَا","bimalkinā","by our will","আমাদের ইচ্ছেমত"],["وَلَـٰكِنَّا","walākinnā","but we","কিন্তু"],["حُمِّلْنَآ","ḥummil'nā","[we] were made to carry","আমাদের উপর চাপানো হয়েছিলো"],["أَوْزَارًۭا","awzāran","burdens","বোঝা সমূহ"],["مِّن","min","from","তৈরি"],["زِينَةِ","zīnati","ornaments","অলংকারের"],["ٱلْقَوْمِ","l-qawmi","(of) the people","লোকদের"],["فَقَذَفْنَـٰهَا","faqadhafnāhā","so we threw them","ফলে তা আমরা ছুঁড়ে ফেলি"],["فَكَذَٰلِكَ","fakadhālika","and thus","পরে ঐভাবে"],["أَلْقَى","alqā","threw","নিক্ষেপ করলো"],["ٱلسَّامِرِىُّ","l-sāmiriyu","the Samiri","সামেরীও\""]],"t":"قَالُو<s>ا۟</> <o>مَآ</> أَخْلَفْنَا مَوْعِدَكَ بِمَلْكِنَا وَ<m>لَٰ</>كِ<g>نَّ</>ا حُ<g>مِّ</>لْ<o>نَآ</> أَوْزَا<d>رًۭا مِّ</><k>ن زِ</>ينَةِ <h>ٱ</>لْقَوْمِ فَقَذَفْ<m>نَٰ</>هَا فَكَ<m>ذَٰ</>لِكَ أَلْقَى <h>ٱ</><l>ل</>سَّامِرِىُّ"},{"n":88,"w":[["فَأَخْرَجَ","fa-akhraja","Then he brought forth","অতঃপর বের করলো"],["لَهُمْ","lahum","for them","তাদের জন্য"],["عِجْلًۭا","‘ij'lan","a calf's","একটি বাছুর"],["جَسَدًۭا","jasadan","body","অবয়ব"],["لَّهُۥ","lahu","it had","তার ছিলো"],["خُوَارٌۭ","khuwārun","a lowing sound","হাম্বা শব্দ"],["فَقَالُوا۟","faqālū","and they said","তখন তারা বললো"],["هَـٰذَآ","hādhā","This","\"এটা"],["إِلَـٰهُكُمْ","ilāhukum","(is) your god","তোমাদের উপাস্য"],["وَإِلَـٰهُ","wa-ilāhu","and the god","ও উপাস্য"],["مُوسَىٰ","mūsā","(of) Musa","মূসার"],["فَنَسِىَ","fanasiya","but he forgot","(মূসা) আসলে ভুলে গিয়েছিলো\""]],"t":"فَأَخْرَجَ لَهُمْ عِ<q>جْ</>لًۭ<k>ا جَ</>سَ<w>دًۭا لَّ</>هُ<m>ۥ</> خُوَا<k>رٌۭ فَ</>قَالُو<s>ا۟</> <m>هَٰ</><o>ذَآ</> إِ<m>لَٰ</>هُكُمْ وَإِ<m>لَٰ</>هُ مُوسَىٰ فَنَسِىَ"},{"n":89,"w":[["أَفَلَا","afalā","Then, did not","নি কি"],["يَرَوْنَ","yarawna","they see","তারা (ভেবে) দেখে"],["أَلَّا","allā","that not","যে না"],["يَرْجِعُ","yarji‘u","it (could) return","ফিরে আসে"],["إِلَيْهِمْ","ilayhim","to them","তাদের দিকে (অর্থাৎ উত্তর দেয়)"],["قَوْلًۭا","qawlan","a word","কথার"],["وَلَا","walā","and not","এবং না"],["يَمْلِكُ","yamliku","possess","ক্ষমতা রাখে"],["لَهُمْ","lahum","for them","তাদের জন্যে"],["ضَرًّۭا","ḍarran","any harm","ক্ষতি (করতে)"],["وَلَا","walā","and not","আর না"],["نَفْعًۭا","naf‘an","any benefit","উপকার (করতে)"]],"t":"أَفَلَا يَرَوْنَ أَلَّا يَرْجِعُ إِلَيْهِمْ قَوْلًۭ<d>ا وَ</>لَا يَمْلِكُ لَهُمْ ضَ<d>رًّۭا وَ</>لَا نَفْعًۭا"},{"n":90,"w":[["وَلَقَدْ","walaqad","And verily","এবং নিশ্চয়ই"],["قَالَ","qāla","(had) said","বলেছিলো"],["لَهُمْ","lahum","to them","তাদেরকে"],["هَـٰرُونُ","hārūnu","Harun","হারূন"],["مِن","min","before","থেকেই"],["قَبْلُ","qablu","before","পূর্ব"],["يَـٰقَوْمِ","yāqawmi","O my people","\"হে আমার জাতি"],["إِنَّمَا","innamā","Only","মূলত"],["فُتِنتُم","futintum","you are being tested","তোমাদের পরীক্ষায় ফেলা হয়েছে"],["بِهِۦ ۖ","bihi","by it","তা দ্বারা"],["وَإِنَّ","wa-inna","and indeed","এবং নিশ্চয়ই"],["رَبَّكُمُ","rabbakumu","your Lord","তোমাদের রব"],["ٱلرَّحْمَـٰنُ","l-raḥmānu","(is) the Most Gracious","দয়াময় (আল্লাহ)"],["فَٱتَّبِعُونِى","fa-ittabi‘ūnī","so follow me","সুতরাং তোমরা আমাকে অনুসরণ করো"],["وَأَطِيعُوٓا۟","wa-aṭī‘ū","and obey","ও তোমরা আনুগত্য করো"],["أَمْرِى","amrī","my order","আমার আদেশের\""]],"t":"وَلَقَ<q>دْ</> قَالَ لَهُمْ <m>هَٰ</>رُونُ مِ<k>ن قَ</><q>بْ</>لُ <m>يَٰ</>قَوْمِ إِ<g>نَّ</>مَا فُتِ<k>نتُ</><f>م بِ</><m>هِۦ</> ۖ وَإِ<g>نَّ</> رَبَّكُمُ <h>ٱ</><l>ل</>رَّحْ<m>مَٰ</>نُ فَ<h>ٱ</>تَّبِعُونِى وَأَطِي<o>عُوٓ</><s>ا۟</> أَمْرِى"},{"n":91,"w":[["قَالُوا۟","qālū","They said","তারা বলেছিলো"],["لَن","lan","Never","\"কখনও না"],["نَّبْرَحَ","nabraḥa","we will cease","বিরত হবো আমরা"],["عَلَيْهِ","‘alayhi","being devoted to it","তার কাছে"],["عَـٰكِفِينَ","‘ākifīna","being devoted to it","লেগে থাকা (বা পূজা করা হ'তে)_"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["يَرْجِعَ","yarji‘a","returns","ফিরে আসবে"],["إِلَيْنَا","ilaynā","to us","আমাদের কাছে"],["مُوسَىٰ","mūsā","Musa","মূসা\""]],"t":"قَالُو<s>ا۟</> <d>لَن نَّ</><q>بْ</>رَحَ عَلَيْهِ <m>عَٰ</>كِفِينَ حَتَّىٰ يَرْجِعَ إِلَيْنَا مُوسَىٰ"},{"n":92,"w":[["قَالَ","qāla","He said","(মূসা) বললো"],["يَـٰهَـٰرُونُ","yāhārūnu","O Harun","\"হে হারূন"],["مَا","mā","What","কিসে"],["مَنَعَكَ","mana‘aka","prevented you","তোমাকে নিষেধ করলো"],["إِذْ","idh","when","যখন"],["رَأَيْتَهُمْ","ra-aytahum","you saw them","তাদের তুমি দেখলে"],["ضَلُّوٓا۟","ḍallū","going astray","তারা পথভ্রষ্ট হয়েছে"]],"t":"قَالَ <m>يَٰهَٰ</>رُونُ مَا مَنَعَكَ إِذْ رَأَيْتَهُمْ ضَلُّوٓ<s>ا۟</>"},{"n":93,"w":[["أَلَّا","allā","That not","যে না"],["تَتَّبِعَنِ ۖ","tattabi‘ani","you follow me","আমার (আদেশের) অনুসরণ করলে"],["أَفَعَصَيْتَ","afa‘aṣayta","Then, have you disobeyed","তবে কি তুমি অমান্য করেছো"],["أَمْرِى","amrī","my order","আমার আদেশের\""]],"t":"أَلَّا تَتَّبِعَنِ ۖ أَفَعَصَيْتَ أَمْرِى"},{"n":94,"w":[["قَالَ","qāla","He said","সে বললো"],["يَبْنَؤُمَّ","yabna-umma","O son of my mother","\"হে আমার মায়ের ছেলে (অর্থাৎ ভাই)"],["لَا","lā","(Do) not","না"],["تَأْخُذْ","takhudh","seize (me)","ধরো"],["بِلِحْيَتِى","biliḥ'yatī","by my beard","আমার দাড়ি"],["وَلَا","walā","and not","আর না"],["بِرَأْسِىٓ ۖ","birasī","by my head","আমার মাথার (চুল)"],["إِنِّى","innī","Indeed, I","নিশ্চয়ই আমি"],["خَشِيتُ","khashītu","[I] feared","আশঙ্কা করেছি"],["أَن","an","that","যে"],["تَقُولَ","taqūla","you would say","বলবে তুমি"],["فَرَّقْتَ","farraqta","You caused division","\"তুমি বিভেদ সৃষ্টি করেছো"],["بَيْنَ","bayna","between","মাঝে"],["بَنِىٓ","banī","(the) Children of Israel","সন্তানদের"],["إِسْرَٰٓءِيلَ","is'rāīla","(the) Children of Israel","ইসরাঈলের"],["وَلَمْ","walam","and not","এবং নি"],["تَرْقُبْ","tarqub","you respect","তুমি মূল্য দাও"],["قَوْلِى","qawlī","my word","আমার কথা\""]],"t":"قَالَ يَ<q>بْ</>نَؤُ<g>مَّ</> لَا تَأْخُذْ بِلِحْيَتِى وَلَا بِرَأْ<o>سِىٓ ۖ</> إِ<g>نِّ</>ى خَشِيتُ أَ<k>ن تَ</>قُولَ فَرَّ<q>قْ</>تَ بَيْنَ بَ<o>نِىٓ</> إِسْ<o>رَٰٓ</>ءِيلَ وَلَمْ تَرْقُ<q>بْ</> قَوْلِى"},{"n":95,"w":[["قَالَ","qāla","He said","সে বললো"],["فَمَا","famā","Then what","\"তাহ'লে কি"],["خَطْبُكَ","khaṭbuka","(is) your case","তোমার ব্যাপার"],["يَـٰسَـٰمِرِىُّ","yāsāmiriyyu","O Samiri","হে সামেরী\""]],"t":"قَالَ فَمَا خَ<q>طْ</>بُكَ <m>يَٰسَٰ</>مِرِىُّ"},{"n":96,"w":[["قَالَ","qāla","He said","(সামেরী) বললো"],["بَصُرْتُ","baṣur'tu","I perceived","\"আমি দেখেছি"],["بِمَا","bimā","what","ঐ বিষয়ে যা"],["لَمْ","lam","not","নি"],["يَبْصُرُوا۟","yabṣurū","they perceive","তারা দেখে"],["بِهِۦ","bihi","in it","সে সম্পর্কে"],["فَقَبَضْتُ","faqabaḍtu","so I took","অতঃপর আমি মুঠিতে নিয়েছি"],["قَبْضَةًۭ","qabḍatan","a handful","এক মুঠো"],["مِّنْ","min","from","হ'তে"],["أَثَرِ","athari","(the) track","পায়ের চিহ্ন"],["ٱلرَّسُولِ","l-rasūli","(of) the Messenger","রাসূলের (অর্থাৎ জিবরাঈল বা মূসা আঃ)"],["فَنَبَذْتُهَا","fanabadhtuhā","then threw it","অতঃপর তা আমি ছুঁড়ে ফেলেছি"],["وَكَذَٰلِكَ","wakadhālika","and thus","এবং এভাবেই"],["سَوَّلَتْ","sawwalat","suggested","উদ্বুদ্ধ করেছিলো"],["لِى","lī","to me","আমাকে"],["نَفْسِى","nafsī","my soul","আমার মন\""]],"t":"قَالَ بَصُرْتُ بِمَا لَمْ يَ<q>بْ</>صُرُو<s>ا۟</> بِ<m>هِۦ</> فَقَبَضْتُ قَ<q>بْ</>ضَ<d>ةًۭ مِّ</>نْ أَثَرِ <h>ٱ</><l>ل</>رَّسُولِ فَنَبَذْتُهَا وَكَ<m>ذَٰ</>لِكَ سَوَّلَتْ لِى نَفْسِى"},{"n":97,"w":[["قَالَ","qāla","He said","সে বললো"],["فَٱذْهَبْ","fa-idh'hab","Then go","\"তাহ'লে তুমি যাও"],["فَإِنَّ","fa-inna","And indeed","নিশ্চয়ই এখন"],["لَكَ","laka","for you","তোমার জন্যে"],["فِى","fī","in","মধ্যে আছে"],["ٱلْحَيَوٰةِ","l-ḥayati","the life","(সারা) জীবনের"],["أَن","an","that","(এই নির্দেশ) যে"],["تَقُولَ","taqūla","you will say","বলবে তুমি"],["لَا","lā","(Do) not","\"না"],["مِسَاسَ ۖ","misāsa","touch","স্পর্শ করবে (আমাকে)\""],["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই (আছে)"],["لَكَ","laka","for you","তোমার জন্য"],["مَوْعِدًۭا","maw‘idan","(is) an appointment","নির্দিষ্ট সময় (জিজ্ঞাসাবাদের)"],["لَّن","lan","never","কখনও না"],["تُخْلَفَهُۥ ۖ","tukh'lafahu","you will fail to (keep) it","তার ব্যতিক্রম করা হবে"],["وَٱنظُرْ","wa-unẓur","And look","এবং দেখো"],["إِلَىٰٓ","ilā","at","প্রতি"],["إِلَـٰهِكَ","ilāhika","your god","তোমার উপাস্যের"],["ٱلَّذِى","alladhī","that which","যার"],["ظَلْتَ","ẓalta","you have remained","তুমি সর্বদা ছিলে"],["عَلَيْهِ","‘alayhi","to it","তার কাছে"],["عَاكِفًۭا ۖ","‘ākifan","devoted","পূজারত"],["لَّنُحَرِّقَنَّهُۥ","lanuḥarriqannahu","Surely we will burn it","অবশ্যই আমরা জ্বালাবো"],["ثُمَّ","thumma","then","এরপর"],["لَنَنسِفَنَّهُۥ","lanansifannahu","certainly we will scatter it","তাকে আমরা অবশ্যই বিক্ষিপ্তভাবে ছড়াবো"],["فِى","fī","in","মধ্যে"],["ٱلْيَمِّ","l-yami","the sea","সাগরের"],["نَسْفًا","nasfan","(in) particles","বিক্ষিপ্ত করে\""]],"t":"قَالَ فَ<h>ٱ</>ذْهَ<q>بْ</> فَإِ<g>نَّ</> لَكَ فِى <h>ٱ</>لْحَيَ<s>وٰ</>ةِ أَ<k>ن تَ</>قُولَ لَا مِسَاسَ ۖ وَإِ<g>نَّ</> لَكَ مَوْعِ<w>دًۭا لَّ</><k>ن تُ</>خْلَفَهُ<m>ۥ</> ۖ وَ<h>ٱ</><k>نظُ</>رْ إِلَ<o>ىٰٓ</> إِ<m>لَٰ</>هِكَ <h>ٱ</>لَّذِى ظَلْتَ عَلَيْهِ عَاكِ<w>فًۭا ۖ لَّ</>نُحَرِّقَ<g>نَّ</>هُ<m>ۥ</> ثُ<g>مَّ</> لَنَ<k>نسِ</>فَ<g>نَّ</>هُ<m>ۥ</> فِى <h>ٱ</>لْيَ<g>مِّ</> نَسْفًا"},{"n":98,"w":[["إِنَّمَآ","innamā","Only","প্রকৃতপক্ষে"],["إِلَـٰهُكُمُ","ilāhukumu","your God","তোমাদের ইলাহ"],["ٱللَّهُ","l-lahu","(is) Allah","একমাত্র আল্লাহ"],["ٱلَّذِى","alladhī","the One","যিনি (এমন যে)"],["لَآ","lā","(there is) no","নেই"],["إِلَـٰهَ","ilāha","god","কোন ইলাহ"],["إِلَّا","illā","but","ছাড়া"],["هُوَ ۚ","huwa","He","তিনি"],["وَسِعَ","wasi‘a","He has encompassed","পরিবেষ্টিত"],["كُلَّ","kulla","all","সব"],["شَىْءٍ","shayin","things","কিছু"],["عِلْمًۭا","‘il'man","(in) knowledge","(তাঁর) জ্ঞানে"]],"t":"إِ<g>نَّ</><o>مَآ</> إِ<m>لَٰ</>هُكُمُ <h>ٱ</>للَّهُ <h>ٱ</>لَّذِى <o>لَآ</> إِ<m>لَٰ</>هَ إِلَّا هُوَ ۚ وَسِعَ كُلَّ شَىْءٍ عِلْمًۭا"},{"n":99,"w":[["كَذَٰلِكَ","kadhālika","Thus","এরূপে"],["نَقُصُّ","naquṣṣu","We relate","বর্ণনা করছি আমরা"],["عَلَيْكَ","‘alayka","to you","তোমার কাছে"],["مِنْ","min","from","হ'তে"],["أَنۢبَآءِ","anbāi","(the) news","সংবাদ"],["مَا","mā","(of) what","যা"],["قَدْ","qad","has preceded","নিশ্চয়ই"],["سَبَقَ ۚ","sabaqa","has preceded","আগে ঘটেছে"],["وَقَدْ","waqad","And certainly","এবং নিশ্চয়ই"],["ءَاتَيْنَـٰكَ","ātaynāka","We have given you","তোমাকে আমরা দিয়েছি"],["مِن","min","from","হ'তে"],["لَّدُنَّا","ladunnā","Us","আমার নিকট"],["ذِكْرًۭا","dhik'ran","a Reminder","উপদেশ"]],"t":"كَ<m>ذَٰ</>لِكَ نَقُصُّ عَلَيْكَ مِنْ أَ<i>نۢبَ</><o>آ</>ءِ مَا قَ<q>دْ</> سَبَقَ ۚ وَقَ<q>دْ</> ءَاتَيْ<m>نَٰ</>كَ <w>مِن لَّ</>دُ<g>نَّ</>ا ذِكْرًۭا"},{"n":100,"w":[["مَّنْ","man","Whoever","যে"],["أَعْرَضَ","a‘raḍa","turns away","বিমুখ হবে"],["عَنْهُ","‘anhu","from it","তা থেকে"],["فَإِنَّهُۥ","fa-innahu","then indeed, he","তবে সে নিশ্চয়ই"],["يَحْمِلُ","yaḥmilu","will bear","বহন করবে"],["يَوْمَ","yawma","(on the) Day","দিনে"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) Resurrection","ক্বিয়ামাতের"],["وِزْرًا","wiz'ran","a burden","(দূর্বহ) ভার"]],"t":"مَّنْ أَعْرَضَ عَنْهُ فَإِ<g>نَّ</>هُ<m>ۥ</> يَحْمِلُ يَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ وِزْرًا"},{"n":101,"w":[["خَـٰلِدِينَ","khālidīna","Abiding forever","চিরস্থায়ী হবে তারা"],["فِيهِ ۖ","fīhi","in it","তার মধ্যে"],["وَسَآءَ","wasāa","and evil","এবং কত মন্দ হবে"],["لَهُمْ","lahum","for them","তাদের জন্যে"],["يَوْمَ","yawma","(on the) Day","দিনে"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) the Resurrection","ক্বিয়ামাতের"],["حِمْلًۭا","ḥim'lan","(as) a load","বোঝা"]],"t":"<m>خَٰ</>لِدِينَ فِيهِ ۖ وَ<o>سَآ</>ءَ لَهُمْ يَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ حِمْلًۭا"},{"n":102,"w":[["يَوْمَ","yawma","(The) Day","যেদিন"],["يُنفَخُ","yunfakhu","will be blown","ফুঁ দেয়া হবে"],["فِى","fī","in","মধ্যে"],["ٱلصُّورِ ۚ","l-ṣūri","the Trumpet","শিঙ্গার"],["وَنَحْشُرُ","wanaḥshuru","and We will gather","এবং সমবেত করবো আমরা"],["ٱلْمُجْرِمِينَ","l-muj'rimīna","the criminals","অপরাধীদেরকে"],["يَوْمَئِذٍۢ","yawma-idhin","that Day","সেদিন"],["زُرْقًۭا","zur'qan","blue-eyed","নীল-চোখ বিশিষ্ট (দৃষ্টিহীন অবস্থায়)"]],"t":"يَوْمَ يُ<k>نفَ</>خُ فِى <h>ٱ</><l>ل</>صُّورِ ۚ وَنَحْشُرُ <h>ٱ</>لْمُ<q>جْ</>رِمِينَ يَوْمَئِ<k>ذٍۢ زُ</>رْقًۭا"},{"n":103,"w":[["يَتَخَـٰفَتُونَ","yatakhāfatūna","They are murmuring","তারা পরস্পরে চুপে-চুপে বলবে"],["بَيْنَهُمْ","baynahum","among themselves","তাদের মাঝে"],["إِن","in","Not","\"না"],["لَّبِثْتُمْ","labith'tum","you remained","তোমরা অবস্থান করেছিলে"],["إِلَّا","illā","except (for)","কিন্তু"],["عَشْرًۭا","‘ashran","ten","দশ (দিন)\""]],"t":"يَتَ<m>خَٰ</>فَتُونَ بَيْنَهُمْ <w>إِن لَّ</>بِثْتُمْ إِلَّا عَشْرًۭا"},{"n":104,"w":[["نَّحْنُ","naḥnu","We","আমরা"],["أَعْلَمُ","a‘lamu","know best","খুব জানি"],["بِمَا","bimā","what","ঐ বিষয়ে যা"],["يَقُولُونَ","yaqūlūna","they will say","তারা বলবে"],["إِذْ","idh","when","যখন"],["يَقُولُ","yaqūlu","will say","বলবে"],["أَمْثَلُهُمْ","amthaluhum","(the) best of them","তাদের মধ্যকার অপেক্ষাকৃত উত্তম ব্যক্তি"],["طَرِيقَةً","ṭarīqatan","(in) conduct","বুদ্ধিমত্তায়"],["إِن","in","Not","\"না"],["لَّبِثْتُمْ","labith'tum","you remained","তোমরা অবস্থান করেছিলে"],["إِلَّا","illā","except (for)","এছাড়া"],["يَوْمًۭا","yawman","a day","একদিন\""]],"t":"نَّحْنُ أَعْلَمُ بِمَا يَقُولُونَ إِذْ يَقُولُ أَمْثَلُهُمْ طَرِيقَةً <w>إِن لَّ</>بِثْتُمْ إِلَّا يَوْمًۭا"},{"n":105,"w":[["وَيَسْـَٔلُونَكَ","wayasalūnaka","And they ask you","এবং তোমাকে তারা প্রশ্ন করে"],["عَنِ","‘ani","about","সম্পর্কে"],["ٱلْجِبَالِ","l-jibāli","the mountains","পর্বতসমূহ"],["فَقُلْ","faqul","so say","অতঃপর বলো"],["يَنسِفُهَا","yansifuhā","Will blast them","\"তা উড়িয়ে দিবেন ধুলো করে"],["رَبِّى","rabbī","my Lord","আমার রব"],["نَسْفًۭا","nasfan","(into) particles","(খুব করে) উড়িয়ে দেয়া"]],"t":"وَيَسْـَٔلُونَكَ عَنِ <h>ٱ</>لْجِبَالِ فَقُلْ يَ<k>نسِ</>فُهَا رَبِّى نَسْفًۭا"},{"n":106,"w":[["فَيَذَرُهَا","fayadharuhā","Then He will leave it","অতঃপর তা পরিণত করবেন"],["قَاعًۭا","qā‘an","a level","সমতল"],["صَفْصَفًۭا","ṣafṣafan","plain","মসৃণ ময়দানে"]],"t":"فَيَذَرُهَا قَا<k>عًۭا صَ</>فْصَفًۭا"},{"n":107,"w":[["لَّا","lā","Not","না"],["تَرَىٰ","tarā","you will see","দেখবে তুমি"],["فِيهَا","fīhā","in it","তার মধ্যে"],["عِوَجًۭا","‘iwajan","any crookedness","বাঁকা"],["وَلَآ","walā","and not","আর না"],["أَمْتًۭا","amtan","any curve","অসমান (উঁচুনিচু)\""]],"t":"لَّا تَرَىٰ فِيهَا عِوَ<d>جًۭا وَ</><o>لَآ</> أَمْتًۭا"},{"n":108,"w":[["يَوْمَئِذٍۢ","yawma-idhin","On that Day","সে দিন"],["يَتَّبِعُونَ","yattabi‘ūna","they will follow","তারা অনুসরণ করবে"],["ٱلدَّاعِىَ","l-dā‘iya","the caller","এক আহ্বানকারীকে"],["لَا","lā","no","না থাকবে"],["عِوَجَ","‘iwaja","deviation","বক্রতা"],["لَهُۥ ۖ","lahu","from it","তার মধ্যে"],["وَخَشَعَتِ","wakhasha‘ati","And (will be) humbled","এবং ক্ষীণ হবে"],["ٱلْأَصْوَاتُ","l-aṣwātu","the voices","আওয়াজ সমূহ"],["لِلرَّحْمَـٰنِ","lilrraḥmāni","for the Most Gracious","দয়াময়ের সামনে"],["فَلَا","falā","so not","অতঃপর না"],["تَسْمَعُ","tasma‘u","you will hear","শুনবে তুমি"],["إِلَّا","illā","except","কিন্তু"],["هَمْسًۭا","hamsan","a faint sound","অস্পষ্ট ধ্বনি (পদ শব্দ)"]],"t":"يَوْمَئِ<d>ذٍۢ يَ</>تَّبِعُونَ <h>ٱ</><l>ل</>دَّاعِىَ لَا عِوَجَ لَهُ<m>ۥ</> ۖ وَخَشَعَتِ <h>ٱ</>لْأَصْوَاتُ لِلرَّحْ<m>مَٰ</>نِ فَلَا تَسْمَعُ إِلَّا هَمْسًۭا"},{"n":109,"w":[["يَوْمَئِذٍۢ","yawma-idhin","(On) that Day","সে দিন"],["لَّا","lā","not","না"],["تَنفَعُ","tanfa‘u","will benefit","উপকার দিবে"],["ٱلشَّفَـٰعَةُ","l-shafā‘atu","the intercession","সুপারিশ"],["إِلَّا","illā","except","কিন্তু"],["مَنْ","man","(to) whom","যাকে"],["أَذِنَ","adhina","has given permission","অনুমতি দিবেন"],["لَهُ","lahu","[to him]","তার জন্য"],["ٱلرَّحْمَـٰنُ","l-raḥmānu","the Most Gracious","দয়াময় (আল্লাহ)"],["وَرَضِىَ","waraḍiya","and He has accepted","এবং পছন্দ করবেন"],["لَهُۥ","lahu","for him","তার জন্য"],["قَوْلًۭا","qawlan","a word","কথাকে"]],"t":"يَوْمَئِ<w>ذٍۢ لَّ</>ا تَ<k>نفَ</>عُ <h>ٱ</><l>ل</>شَّ<m>فَٰ</>عَةُ إِلَّا مَنْ أَذِنَ لَهُ <h>ٱ</><l>ل</>رَّحْ<m>مَٰ</>نُ وَرَضِىَ لَهُ<m>ۥ</> قَوْلًۭا"},{"n":110,"w":[["يَعْلَمُ","ya‘lamu","He knows","তিনি জানেন"],["مَا","mā","what","যা কিছু (আছে)"],["بَيْنَ","bayna","(is) before them","মাঝে"],["أَيْدِيهِمْ","aydīhim","(is) before them","তাদের হাতের (সামনে)"],["وَمَا","wamā","and what","এবং যা কিছু"],["خَلْفَهُمْ","khalfahum","(is) behind them","তাদের পিছনে (আছে)"],["وَلَا","walā","while not","এবং না"],["يُحِيطُونَ","yuḥīṭūna","they encompass","তারা আয়ত্ত্ব করতে পারে"],["بِهِۦ","bihi","it","তাঁকে"],["عِلْمًۭا","‘il'man","(in) knowledge","জ্ঞানে"]],"t":"يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ وَلَا يُحِيطُونَ بِ<m>هِۦ</> عِلْمًۭا"},{"n":111,"w":[["۞ وَعَنَتِ","wa‘anati","And (will be) humbled","এবং অবনমিত হবে"],["ٱلْوُجُوهُ","l-wujūhu","the faces","মুখমণ্ডলসমূহ"],["لِلْحَىِّ","lil'ḥayyi","before the Ever-Living","কাছে চিরঞ্জীবের"],["ٱلْقَيُّومِ ۖ","l-qayūmi","the Self-Subsisting","চিরস্থায়ীর"],["وَقَدْ","waqad","And verily","এবং নিশ্চয়ই"],["خَابَ","khāba","will have failed","ব্যর্থ হবে"],["مَنْ","man","(he) who","যে"],["حَمَلَ","ḥamala","carried","বহন করবে"],["ظُلْمًۭا","ẓul'man","wrongdoing","অত্যাচার (গুনাহের বোঝা)"]],"t":"۞ وَعَنَتِ <h>ٱ</>لْوُجُوهُ لِلْحَىِّ <h>ٱ</>لْقَيُّومِ ۖ وَقَ<q>دْ</> خَابَ مَنْ حَمَلَ ظُلْمًۭا"},{"n":112,"w":[["وَمَن","waman","But (he) who","এবং যে"],["يَعْمَلْ","ya‘mal","does","কাজ করবে"],["مِنَ","mina","of","থেকে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","the righteous deeds","সৎকাজ"],["وَهُوَ","wahuwa","while he","এ অবস্থায়(যে) সে"],["مُؤْمِنٌۭ","mu'minun","(is) a believer","মু'মিন (হবে)"],["فَلَا","falā","then not","তাহ'লে না"],["يَخَافُ","yakhāfu","he will fear","সে ভয় করবে"],["ظُلْمًۭا","ẓul'man","injustice","অত্যাচার"],["وَلَا","walā","and not","আর না"],["هَضْمًۭا","haḍman","deprivation","ক্ষতির"]],"t":"وَ<d>مَن يَ</>عْمَلْ مِنَ <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ وَهُوَ مُؤْمِ<k>نٌۭ فَ</>لَا يَخَافُ ظُلْ<d>مًۭا وَ</>لَا هَضْمًۭا"},{"n":113,"w":[["وَكَذَٰلِكَ","wakadhālika","And thus","আর এরূপে"],["أَنزَلْنَـٰهُ","anzalnāhu","We have sent it down","তা আমরা অবতীর্ণ করেছি"],["قُرْءَانًا","qur'ānan","(the) Quran","(অর্থাৎ) কুরআনকে"],["عَرَبِيًّۭا","‘arabiyyan","(in) Arabic","আরবী ভাষায়"],["وَصَرَّفْنَا","waṣarrafnā","and We have explained","এবং আমরা বিশদভাবে বর্ণনা করেছি"],["فِيهِ","fīhi","in it","তার মধ্যে"],["مِنَ","mina","of","দিয়ে"],["ٱلْوَعِيدِ","l-wa‘īdi","the warnings","সতর্কবাণী"],["لَعَلَّهُمْ","la‘allahum","that they may","তারা যাতে"],["يَتَّقُونَ","yattaqūna","fear","তাকওয়া অবলম্বন করে"],["أَوْ","aw","or","অথবা"],["يُحْدِثُ","yuḥ'dithu","it may cause","সৃষ্টি করবে"],["لَهُمْ","lahum","[for] them","তাদের জন্যে"],["ذِكْرًۭا","dhik'ran","remembrance","উপদেশ(হুঁশজ্ঞান)"]],"t":"وَكَ<m>ذَٰ</>لِكَ أَ<k>نزَ</>لْ<m>نَٰ</>هُ قُرْءَانًا عَرَبِ<d>يًّۭا وَ</>صَرَّفْنَا فِيهِ مِنَ <h>ٱ</>لْوَعِيدِ لَعَلَّهُمْ يَتَّقُونَ أَوْ يُحْدِثُ لَهُمْ ذِكْرًۭا"},{"n":114,"w":[["فَتَعَـٰلَى","fata‘ālā","So high (above all)","সুতরাং মহান"],["ٱللَّهُ","l-lahu","(is) Allah","আল্লাহ"],["ٱلْمَلِكُ","l-maliku","the King","অধিপতি"],["ٱلْحَقُّ ۗ","l-ḥaqu","the True","সত্যিকার"],["وَلَا","walā","And (do) not","এবং না"],["تَعْجَلْ","ta‘jal","hasten","তাড়াহুড়া করো"],["بِٱلْقُرْءَانِ","bil-qur'āni","with the Quran","নিয়ে কুরআন (পাঠে)"],["مِن","min","before","থেকে"],["قَبْلِ","qabli","before","এর পূর্ব"],["أَن","an","[that]","যে"],["يُقْضَىٰٓ","yuq'ḍā","is completed","সম্পূর্ণ করা হয়"],["إِلَيْكَ","ilayka","to you","তোমার প্রতি"],["وَحْيُهُۥ ۖ","waḥyuhu","its revelation","তার ওহী(প্রেরণ)"],["وَقُل","waqul","and say","এবং বলো"],["رَّبِّ","rabbi","My Lord","\"হে আমার রব"],["زِدْنِى","zid'nī","Increase me","আমাকে বাড়িয়ে দাও"],["عِلْمًۭا","‘il'man","(in) knowledge","জ্ঞান\""]],"t":"فَتَ<m>عَٰ</>لَى <h>ٱ</>للَّهُ <h>ٱ</>لْمَلِكُ <h>ٱ</>لْحَقُّ ۗ وَلَا تَعْجَلْ بِ<h>ٱ</>لْقُرْءَانِ مِ<k>ن قَ</><q>بْ</>لِ <d>أَن يُ</><q>قْ</>ضَ<o>ىٰٓ</> إِلَيْكَ وَحْيُهُ<m>ۥ</> ۖ وَقُ<r>ل</> رَّبِّ زِ<q>دْ</>نِى عِلْمًۭا"},{"n":115,"w":[["وَلَقَدْ","walaqad","And verily","এবং নিশ্চয়ই"],["عَهِدْنَآ","‘ahid'nā","We made a covenant","আমরা নির্দেশ দিয়েছিলাম"],["إِلَىٰٓ","ilā","with","প্রতি"],["ءَادَمَ","ādama","Adam","আদমের"],["مِن","min","before","থেকে"],["قَبْلُ","qablu","before","ইতিপূর্ব"],["فَنَسِىَ","fanasiya","but he forgot","কিন্তু সে ভুলে যায়"],["وَلَمْ","walam","and not","এবং নি"],["نَجِدْ","najid","We found","আমরা পাই"],["لَهُۥ","lahu","in him","তার মধ্যে"],["عَزْمًۭا","‘azman","determination","দৃঢ় সংকল্প"]],"t":"وَلَقَ<q>دْ</> عَهِ<q>دْ</><o>نَآ</> إِلَ<o>ىٰٓ</> ءَادَمَ مِ<k>ن قَ</><q>بْ</>لُ فَنَسِىَ وَلَمْ نَجِ<q>دْ</> لَهُ<m>ۥ</> عَزْمًۭا"},{"n":116,"w":[["وَإِذْ","wa-idh","And when","এবং(স্মরণ করো) যখন"],["قُلْنَا","qul'nā","We said","আমরা বলেছিলাম"],["لِلْمَلَـٰٓئِكَةِ","lil'malāikati","to the Angels","ফিরিশতাদেরকে"],["ٱسْجُدُوا۟","us'judū","Prostrate","\"তোমরা সিজদা করো"],["لِـَٔادَمَ","liādama","to Adam","জন্য আদমের\""],["فَسَجَدُوٓا۟","fasajadū","then they prostrated","তখন তারা সিজদা করলো"],["إِلَّآ","illā","except","কিন্তু"],["إِبْلِيسَ","ib'līsa","Iblis","ইবলিস (করলো না)"],["أَبَىٰ","abā","he refused","সে অমান্য করলো"]],"t":"وَإِذْ قُلْنَا لِلْمَ<o>لَٰٓ</>ئِكَةِ <h>ٱ</>سْجُدُو<s>ا۟</> لِءَادَمَ فَسَجَ<o>دُوٓ</><s>ا۟</> إِ<o>لَّآ</> إِ<q>بْ</>لِيسَ أَبَىٰ"},{"n":117,"w":[["فَقُلْنَا","faqul'nā","Then We said","তখন আমরা বললাম"],["يَـٰٓـَٔادَمُ","yāādamu","O Adam","\"হে আদম"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["هَـٰذَا","hādhā","this","এটা"],["عَدُوٌّۭ","‘aduwwun","(is) an enemy","শত্রু"],["لَّكَ","laka","to you","জন্য তোমার"],["وَلِزَوْجِكَ","walizawjika","and to your wife","এবং জন্য তোমার স্ত্রীর"],["فَلَا","falā","So not","অতএব না যেন"],["يُخْرِجَنَّكُمَا","yukh'rijannakumā","(let) him drive you both","তোমাদের দু'জনকে বের করে দেয়"],["مِنَ","mina","from","হ'তে"],["ٱلْجَنَّةِ","l-janati","Paradise","জান্নাত"],["فَتَشْقَىٰٓ","fatashqā","so (that) you would suffer","ফলে তুমি কষ্টে পড়বে"]],"t":"فَقُلْنَا <o>يَٰٓـَٔ</>ادَمُ إِ<g>نَّ</> <m>هَٰ</>ذَا عَدُ<w>وٌّۭ لَّ</>كَ وَلِزَوْجِكَ فَلَا يُخْرِجَ<g>نَّ</>كُمَا مِنَ <h>ٱ</>لْجَ<g>نَّ</>ةِ فَتَشْقَىٰٓ"},{"n":118,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["لَكَ","laka","for you","জন্যে তোমার"],["أَلَّا","allā","that not","(এ ব্যবস্থা) যে না"],["تَجُوعَ","tajū‘a","you will be hungry","তুমি ক্ষুধার্ত হবে"],["فِيهَا","fīhā","therein","তার মধ্যে"],["وَلَا","walā","and not","আর না"],["تَعْرَىٰ","ta‘rā","you will be unclothed","তুমি উলঙ্গ হবে"]],"t":"إِ<g>نَّ</> لَكَ أَلَّا تَجُوعَ فِيهَا وَلَا تَعْرَىٰ"},{"n":119,"w":[["وَأَنَّكَ","wa-annaka","And that you","এবং (এও) যে তুমি"],["لَا","lā","not","না"],["تَظْمَؤُا۟","taẓma-u","will suffer from thirst","পিপাসার্ত হবে"],["فِيهَا","fīhā","therein","তার মধ্যে"],["وَلَا","walā","and not","আর না"],["تَضْحَىٰ","taḍḥā","exposed to the sun's heat","রোদে উতপ্ত হবে"]],"t":"وَأَ<g>نَّ</>كَ لَا تَظْمَؤُ<s>ا۟</> فِيهَا وَلَا تَضْحَىٰ"},{"n":120,"w":[["فَوَسْوَسَ","fawaswasa","Then whispered","কিন্তু কুমন্ত্রনা দিলো"],["إِلَيْهِ","ilayhi","to him","তার দিকে"],["ٱلشَّيْطَـٰنُ","l-shayṭānu","Shaitaan","শয়তান"],["قَالَ","qāla","he said","সে বললো"],["يَـٰٓـَٔادَمُ","yāādamu","O Adam","\"হে আদম"],["هَلْ","hal","Shall","কি"],["أَدُلُّكَ","adulluka","I direct you","তোমাকে আমি বলে দিবো"],["عَلَىٰ","‘alā","to","সমন্ধে"],["شَجَرَةِ","shajarati","(the) tree","এই গাছের"],["ٱلْخُلْدِ","l-khul'di","(of) the Eternity","চিরন্তন জীবনের"],["وَمُلْكٍۢ","wamul'kin","and a kingdom","ও এমন রাজ্যের"],["لَّا","lā","not","(যা) না"],["يَبْلَىٰ","yablā","(that will) deteriorate","ক্ষয় হয়\""]],"t":"فَوَسْوَسَ إِلَيْهِ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نُ قَالَ <o>يَٰٓـَٔ</>ادَمُ هَلْ أَدُلُّكَ عَلَىٰ شَجَرَةِ <h>ٱ</>لْخُلْدِ وَمُلْ<w>كٍۢ لَّ</>ا يَ<q>بْ</>لَىٰ"},{"n":121,"w":[["فَأَكَلَا","fa-akalā","Then they both ate","অতঃপর উভয়ে খেলো"],["مِنْهَا","min'hā","from it","তা থেকে"],["فَبَدَتْ","fabadat","so became apparent","তখন প্রকাশ হয়ে পড়লো"],["لَهُمَا","lahumā","to them","কাছে তাদের উভয়ের"],["سَوْءَٰتُهُمَا","sawātuhumā","their shame","তাদের উভয়ের লজ্জাস্থানসমূহ"],["وَطَفِقَا","waṭafiqā","and they began","এবং উভয়ে শুরু করলো"],["يَخْصِفَانِ","yakhṣifāni","(to) fasten","উভয়ে ঢাকতে"],["عَلَيْهِمَا","‘alayhimā","on themselves","তাদের দুজনের উপর"],["مِن","min","from","দিয়ে"],["وَرَقِ","waraqi","(the) leaves","পাতা"],["ٱلْجَنَّةِ ۚ","l-janati","(of) Paradise","জান্নাতের"],["وَعَصَىٰٓ","wa‘aṣā","And Adam disobeyed","এবং অমান্য করলো"],["ءَادَمُ","ādamu","And Adam disobeyed","আদম"],["رَبَّهُۥ","rabbahu","his Lord","তার রবকে"],["فَغَوَىٰ","faghawā","and erred","অতঃপর সে বিভ্রান্ত হলো"]],"t":"فَأَكَلَا مِنْهَا فَبَدَتْ لَهُمَا سَوْ<m>ءَٰ</>تُهُمَا وَطَفِقَا يَخْصِفَانِ عَلَيْهِمَا <d>مِن وَ</>رَقِ <h>ٱ</>لْجَ<g>نَّ</>ةِ ۚ وَعَصَ<o>ىٰٓ</> ءَادَمُ رَبَّهُ<m>ۥ</> فَغَوَىٰ"},{"n":122,"w":[["ثُمَّ","thumma","Then","এরপরে"],["ٱجْتَبَـٰهُ","ij'tabāhu","chose him","তাকে মনোনীত করলেন (সম্মানিত করলেন)"],["رَبُّهُۥ","rabbuhu","his Lord","তাঁর রব"],["فَتَابَ","fatāba","and turned","অতঃপর ক্ষমা করলেন"],["عَلَيْهِ","‘alayhi","to him","তার প্রতি"],["وَهَدَىٰ","wahadā","and guided (him)","ও পথ দেখালেন"]],"t":"ثُ<g>مَّ</> <h>ٱ</><q>جْ</>تَ<m>بَٰ</>هُ رَبُّهُ<m>ۥ</> فَتَابَ عَلَيْهِ وَهَدَىٰ"},{"n":123,"w":[["قَالَ","qāla","He said","(আল্লাহ) বললেন"],["ٱهْبِطَا","ih'biṭā","Go down","\"উভয়ে নেমে যাও"],["مِنْهَا","min'hā","from it","তা থেকে"],["جَمِيعًۢا ۖ","jamī‘an","all","এক সঙ্গে"],["بَعْضُكُمْ","ba‘ḍukum","some of you","তোমরা একে"],["لِبَعْضٍ","liba‘ḍin","to others","জন্যে অপরের"],["عَدُوٌّۭ ۖ","‘aduwwun","(as) enemy","শত্রু (হবে)"],["فَإِمَّا","fa-immā","Then if","অতঃপর যখন"],["يَأْتِيَنَّكُم","yatiyannakum","comes to you","তোমাদের কাছে আসবে"],["مِّنِّى","minnī","from Me","আমার পক্ষ হ'তে"],["هُدًۭى","hudan","guidance","পথনির্দেশ"],["فَمَنِ","famani","then whoever","তখন যে"],["ٱتَّبَعَ","ittaba‘a","follows","অনুসরণ করবে"],["هُدَاىَ","hudāya","My guidance","আমার পথনির্দেশ"],["فَلَا","falā","then not","ফলে না"],["يَضِلُّ","yaḍillu","he will go astray","বিভ্রান্ত হবে"],["وَلَا","walā","and not","আর না"],["يَشْقَىٰ","yashqā","suffer","কষ্ট পাবে"]],"t":"قَالَ <h>ٱ</>هْبِطَا مِنْهَا جَمِي<i>عًۢا ۖ بَ</>عْضُكُمْ لِبَعْضٍ عَدُ<k>وٌّۭ ۖ فَ</>إِ<g>مَّ</>ا يَأْتِيَ<g>نَّ</><y>كُم مِّ</><g>نِّ</>ى هُ<k>دًۭى فَ</>مَنِ <h>ٱ</>تَّبَعَ هُدَاىَ فَلَا يَضِلُّ وَلَا يَشْقَىٰ"},{"n":124,"w":[["وَمَنْ","waman","And whoever","আর যে"],["أَعْرَضَ","a‘raḍa","turns away","বিমুখ হবে"],["عَن","‘an","from","হ'তে"],["ذِكْرِى","dhik'rī","My remembrance","আমার স্মরণ"],["فَإِنَّ","fa-inna","then indeed","নিশ্চয়ই তবে"],["لَهُۥ","lahu","for him","তার জন্যে (হবে)"],["مَعِيشَةًۭ","ma‘īshatan","(is) a life","জীবন যাপন"],["ضَنكًۭا","ḍankan","straitened","সংকুচিত"],["وَنَحْشُرُهُۥ","wanaḥshuruhu","and We will gather him","আর তাকে উঠাবো আমরা"],["يَوْمَ","yawma","(on the) Day","দিনে"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) the Resurrection","ক্বিয়ামাতের"],["أَعْمَىٰ","a‘mā","blind","অন্ধ অবস্থায়\""]],"t":"وَمَنْ أَعْرَضَ عَ<k>ن ذِ</>كْرِى فَإِ<g>نَّ</> لَهُ<m>ۥ</> مَعِيشَ<k>ةًۭ ضَ</>ن<d>كًۭا وَ</>نَحْشُرُهُ<m>ۥ</> يَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ أَعْمَىٰ"},{"n":125,"w":[["قَالَ","qāla","He will say","সে বলবে"],["رَبِّ","rabbi","My Lord","\"হে আমার রব"],["لِمَ","lima","Why","কেন"],["حَشَرْتَنِىٓ","ḥashartanī","You raised me","আমাকে আপনি উঠালেন"],["أَعْمَىٰ","a‘mā","blind","অন্ধ অবস্থায়"],["وَقَدْ","waqad","while [verily]","অথচ নিশ্চয়ই"],["كُنتُ","kuntu","I had","আমি ছিলাম"],["بَصِيرًۭا","baṣīran","sight","চক্ষুষ্মান\""]],"t":"قَالَ رَبِّ لِمَ حَشَرْتَ<o>نِىٓ</> أَعْمَىٰ وَقَ<q>دْ</> كُ<k>نتُ</> بَصِيرًۭا"},{"n":126,"w":[["قَالَ","qāla","He will say","তিনি বলবেন"],["كَذَٰلِكَ","kadhālika","Thus","\"এমনিভাবেই"],["أَتَتْكَ","atatka","came to you","তোমাদের কাছে এসেছিলো"],["ءَايَـٰتُنَا","āyātunā","Our Signs","আমাদের নিদর্শনাবলী"],["فَنَسِيتَهَا ۖ","fanasītahā","but you forgot them","তখন তা তুমি ভুলে গিয়েছিলে"],["وَكَذَٰلِكَ","wakadhālika","and thus","এবং এভাবেই"],["ٱلْيَوْمَ","l-yawma","today","আজ"],["تُنسَىٰ","tunsā","you will be forgotten","বিস্মৃত হয়েছো তুমি\""]],"t":"قَالَ كَ<m>ذَٰ</>لِكَ أَتَتْكَ ءَا<m>يَٰ</>تُنَا فَنَسِيتَهَا ۖ وَكَ<m>ذَٰ</>لِكَ <h>ٱ</>لْيَوْمَ تُ<k>نسَ</>ىٰ"},{"n":127,"w":[["وَكَذَٰلِكَ","wakadhālika","And thus","এবং এরূপেই"],["نَجْزِى","najzī","We recompense","প্রতিফল দিই আমরা"],["مَنْ","man","(he) who","(তাকে) যে"],["أَسْرَفَ","asrafa","transgresses","বাড়াবাড়ি করে"],["وَلَمْ","walam","and not","এবং না"],["يُؤْمِنۢ","yu'min","believes","বিশ্বাস করে"],["بِـَٔايَـٰتِ","biāyāti","in (the) Signs","নিদর্শনাবলীর প্রতি"],["رَبِّهِۦ ۚ","rabbihi","(of) his Lord","তার রবের"],["وَلَعَذَابُ","wala‘adhābu","And surely (the) punishment","এবং অবশ্যই শাস্তি"],["ٱلْـَٔاخِرَةِ","l-ākhirati","(of) the Hereafter","আখিরাতের"],["أَشَدُّ","ashaddu","(is) more severe","কঠোরতর"],["وَأَبْقَىٰٓ","wa-abqā","and more lasting","ও অধিক স্থায়ী"]],"t":"وَكَ<m>ذَٰ</>لِكَ نَ<q>جْ</>زِى مَنْ أَسْرَفَ وَلَمْ يُؤْ<i>مِنۢ بِـَٔ</>ا<m>يَٰ</>تِ رَبِّ<m>هِۦ</> ۚ وَلَعَذَابُ <h>ٱ</>لْءَاخِرَةِ أَشَدُّ وَأَ<q>بْ</>قَىٰٓ"},{"n":128,"w":[["أَفَلَمْ","afalam","Then has not","নি তবে কি"],["يَهْدِ","yahdi","it guided","পথ দেখায় (ইতিহাসের এ শিক্ষা)"],["لَهُمْ","lahum","[for] them","তাদের জন্যে"],["كَمْ","kam","how many","কতই (না)"],["أَهْلَكْنَا","ahlaknā","We (have) destroyed","আমরা ধ্বংস করেছি (জনপদ)"],["قَبْلَهُم","qablahum","before them","তাদের পূর্বে"],["مِّنَ","mina","of","মধ্য হ'তে"],["ٱلْقُرُونِ","l-qurūni","the generations","মানব গোষ্ঠির"],["يَمْشُونَ","yamshūna","(as) they walk","তারা চলছে (আজ)"],["فِى","fī","in","মধ্য দিয়ে"],["مَسَـٰكِنِهِمْ ۗ","masākinihim","their dwellings","তাদের বাসস্থানসমূহের"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে (রয়েছে)"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَـٰتٍۢ","laāyātin","surely (are) Signs","অবশ্যই নিদর্শনাবলী"],["لِّأُو۟لِى","li-ulī","for possessors","জন্যে অধিকারীদের"],["ٱلنُّهَىٰ","l-nuhā","(of) intelligence","বুদ্ধি-বিবেকের"]],"t":"أَفَلَمْ يَهْدِ لَهُمْ كَمْ أَهْلَكْنَا قَ<q>بْ</>لَ<y>هُم مِّ</>نَ <h>ٱ</>لْقُرُونِ يَمْشُونَ فِى مَ<m>سَٰ</>كِنِهِمْ ۗ إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَا<m>يَٰ</><w>تٍۢ لِّ</>أُ<s>و۟</>لِى <h>ٱ</><l>ل</><g>نُّ</>هَىٰ"},{"n":129,"w":[["وَلَوْلَا","walawlā","And if not","এবং যদি না"],["كَلِمَةٌۭ","kalimatun","(for) a Word","একটি বাণী"],["سَبَقَتْ","sabaqat","(that) preceded","পূর্বে নির্দিষ্ট হয়ে থাকতো"],["مِن","min","from","পক্ষ হ'তে"],["رَّبِّكَ","rabbika","your Lord","তোমার রবের"],["لَكَانَ","lakāna","surely (would) have been","অবশ্যই হতো (শাস্তি)"],["لِزَامًۭا","lizāman","an obligation","অবশ্যম্ভাবী"],["وَأَجَلٌۭ","wa-ajalun","and a term","ও একটি কাল (যদি না থাকতো)"],["مُّسَمًّۭى","musamman","determined","নির্দিষ্ট"]],"t":"وَلَوْلَا كَلِمَ<k>ةٌۭ سَ</>بَقَتْ <w>مِن رَّ</>بِّكَ لَكَانَ لِزَا<d>مًۭا وَ</>أَجَ<d>لٌۭ مُّ</>سَ<g>مًّۭ</>ى"},{"n":130,"w":[["فَٱصْبِرْ","fa-iṣ'bir","So be patient","সুতরাং ধৈর্য ধরো"],["عَلَىٰ","‘alā","over","উপর"],["مَا","mā","what","যা"],["يَقُولُونَ","yaqūlūna","they say","তারা বলে"],["وَسَبِّحْ","wasabbiḥ","and glorify","ও মহিমা ঘোষণা করো"],["بِحَمْدِ","biḥamdi","with praise","প্রশংসা সহ"],["رَبِّكَ","rabbika","(of) your Lord","তোমার রবের"],["قَبْلَ","qabla","before","পূর্বে"],["طُلُوعِ","ṭulū‘i","(the) rising","উদয়ের"],["ٱلشَّمْسِ","l-shamsi","(of) the sun","সূর্য"],["وَقَبْلَ","waqabla","and before","ও পূর্বে"],["غُرُوبِهَا ۖ","ghurūbihā","its setting","তার অস্তের"],["وَمِنْ","wamin","and from","এবং"],["ءَانَآئِ","ānāi","(the) hours","কিছু অংশে"],["ٱلَّيْلِ","al-layli","(of) the night","রাতের"],["فَسَبِّحْ","fasabbiḥ","and glorify","অতঃপর মহিমা ঘোষণা করো"],["وَأَطْرَافَ","wa-aṭrāfa","(at the) ends","ও প্রান্ত ভাগে"],["ٱلنَّهَارِ","l-nahāri","(of) the day","দিনের"],["لَعَلَّكَ","la‘allaka","so that you may","সম্ভবতঃ তুমি"],["تَرْضَىٰ","tarḍā","be satisfied","সন্তুষ্ট হবে"]],"t":"فَ<h>ٱ</>صْبِرْ عَلَىٰ مَا يَقُولُونَ وَسَبِّحْ بِحَمْدِ رَبِّكَ قَ<q>بْ</>لَ طُلُوعِ <h>ٱ</><l>ل</>شَّمْسِ وَقَ<q>بْ</>لَ غُرُوبِهَا ۖ وَمِنْ ءَانَآئِ <h>ٱ</>لَّيْلِ فَسَبِّحْ وَأَ<q>طْ</>رَافَ <h>ٱ</><l>ل</><g>نَّ</>هَارِ لَعَلَّكَ تَرْضَىٰ"},{"n":131,"w":[["وَلَا","walā","And (do) not","এবং না"],["تَمُدَّنَّ","tamuddanna","extend","প্রসারিত তুমি করো"],["عَيْنَيْكَ","‘aynayka","your eyes","তোমার দুচোখ"],["إِلَىٰ","ilā","towards","প্রতি"],["مَا","mā","what","যা"],["مَتَّعْنَا","matta‘nā","We have given for enjoyment","আমরা উপকরণ দিয়েছি"],["بِهِۦٓ","bihi","[with it]","সে সম্পর্কে"],["أَزْوَٰجًۭا","azwājan","pairs","বিভিন্ন শ্রেণীকে"],["مِّنْهُمْ","min'hum","of them","তাদের মধ্যকার"],["زَهْرَةَ","zahrata","(the) splendor","সৌন্দর্য হিসেবে"],["ٱلْحَيَوٰةِ","l-ḥayati","(of) the life","জীবনের"],["ٱلدُّنْيَا","l-dun'yā","(of) the world","পার্থিব"],["لِنَفْتِنَهُمْ","linaftinahum","that We may test them","যেন তাদের পরীক্ষা করি আমরা"],["فِيهِ ۚ","fīhi","in it","তার মধ্যে"],["وَرِزْقُ","wariz'qu","And (the) provision","আর জীবিকাই"],["رَبِّكَ","rabbika","(of) your Lord","তোমার রবের"],["خَيْرٌۭ","khayrun","(is) better","উত্তম"],["وَأَبْقَىٰ","wa-abqā","and more lasting","ও স্থায়ী"]],"t":"وَلَا تَمُدَّ<g>نَّ</> عَيْنَيْكَ إِلَىٰ مَا مَتَّعْنَا بِ<o>هِۦٓ</> أَزْ<m>وَٰ</><d>جًۭا مِّ</>نْهُمْ زَهْرَةَ <h>ٱ</>لْحَيَ<s>وٰ</>ةِ <h>ٱ</><l>ل</>دُّنْيَا لِنَفْتِنَهُمْ فِيهِ ۚ وَرِزْقُ رَبِّكَ خَيْ<d>رٌۭ وَ</>أَ<q>بْ</>قَىٰ"},{"n":132,"w":[["وَأْمُرْ","wamur","And enjoin","এবং নির্দেশ দাও"],["أَهْلَكَ","ahlaka","(on) your family","তোমার পরিবারকে"],["بِٱلصَّلَوٰةِ","bil-ṣalati","the prayer","সালাত সম্পর্কে"],["وَٱصْطَبِرْ","wa-iṣ'ṭabir","and be steadfast","এবং দৃঢ় থাকো"],["عَلَيْهَا ۖ","‘alayhā","therein","তার উপর"],["لَا","lā","Not","না"],["نَسْـَٔلُكَ","nasaluka","We ask you","তোমার কাছে চাই আমরা"],["رِزْقًۭا ۖ","riz'qan","(for) provision","কোন জীবিকা"],["نَّحْنُ","naḥnu","We","আমরাই"],["نَرْزُقُكَ ۗ","narzuquka","provide (for) you","তোমাকে জীবিকা দিই"],["وَٱلْعَـٰقِبَةُ","wal-‘āqibatu","and the outcome","এবং পরিণাম (শুভ)"],["لِلتَّقْوَىٰ","lilttaqwā","(is) for the righteous[ness]","জন্যে মুত্তাকীদের"]],"t":"وَأْمُرْ أَهْلَكَ بِ<h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةِ وَ<h>ٱ</>صْطَبِرْ عَلَيْهَا ۖ لَا نَسْـَٔلُكَ رِزْ<d>قًۭا ۖ نَّ</>حْنُ نَرْزُقُكَ ۗ وَ<h>ٱ</>لْ<m>عَٰ</>قِبَةُ لِلتَّ<q>قْ</>وَىٰ"},{"n":133,"w":[["وَقَالُوا۟","waqālū","And they say","এবং তারা বলে"],["لَوْلَا","lawlā","Why not","\"কেন না"],["يَأْتِينَا","yatīnā","he brings us","আমাদের কাছে আসে"],["بِـَٔايَةٍۢ","biāyatin","a sign","একটি নিদর্শন (অর্থাৎ মুজি'যা)"],["مِّن","min","from","থেকে"],["رَّبِّهِۦٓ ۚ","rabbihi","his Lord","তার রবের\""],["أَوَلَمْ","awalam","Has not","কি নি"],["تَأْتِهِم","tatihim","come to them","তাদের কাছে আসে"],["بَيِّنَةُ","bayyinatu","evidence","সুস্পষ্ট (শিক্ষা)"],["مَا","mā","(of) what","যা (আছে)"],["فِى","fī","(was) in","মধ্যে (আছে)"],["ٱلصُّحُفِ","l-ṣuḥufi","the Scriptures","কিতাব"],["ٱلْأُولَىٰ","l-ūlā","the former","পূর্ববর্তীদের"]],"t":"وَقَالُو<s>ا۟</> لَوْلَا يَأْتِينَا بِـَٔايَ<d>ةٍۢ مِّ</><w>ن رَّ</>بِّ<o>هِۦٓ ۚ</> أَوَلَمْ تَأْتِ<f>هِم بَ</>يِّنَةُ مَا فِى <h>ٱ</><l>ل</>صُّحُفِ <h>ٱ</>لْأُولَىٰ"},{"n":134,"w":[["وَلَوْ","walaw","And if","এবং যদি (এমন হতো)"],["أَنَّآ","annā","We","যে আমরা"],["أَهْلَكْنَـٰهُم","ahlaknāhum","(had) destroyed them","তাদের আমরা ধ্বংস করে দিতাম"],["بِعَذَابٍۢ","bi‘adhābin","with a punishment","দিয়ে শাস্তি"],["مِّن","min","before him","থেকে"],["قَبْلِهِۦ","qablihi","before him","তার পূর্ব"],["لَقَالُوا۟","laqālū","surely they (would) have said","অবশ্যই তারা  বলতো"],["رَبَّنَا","rabbanā","Our Lord","\"হে আমাদের রব"],["لَوْلَآ","lawlā","why not","কেন না"],["أَرْسَلْتَ","arsalta","You sent","তুমি পাঠিয়েছিলে"],["إِلَيْنَا","ilaynā","to us","আমাদের প্রতি"],["رَسُولًۭا","rasūlan","a Messenger","কোন রাসূল"],["فَنَتَّبِعَ","fanattabi‘a","so we (could) have followed","আমরা তাহ'লে অনুসরণ করতাম"],["ءَايَـٰتِكَ","āyātika","Your signs","তোমার নিদর্শনাবলীর"],["مِن","min","before","থেকে"],["قَبْلِ","qabli","before","এর পূর্ব"],["أَن","an","[that]","যে"],["نَّذِلَّ","nadhilla","we were humiliated","লাঞ্ছিত হতাম আমরা"],["وَنَخْزَىٰ","wanakhzā","and disgraced","ও আমরা অপমানিত হতাম\""]],"t":"وَلَوْ أَ<g>نَّ</><o>آ</> أَهْلَكْ<m>نَٰ</><f>هُم بِ</>عَذَا<d>بٍۢ مِّ</><k>ن قَ</><q>بْ</>لِ<m>هِۦ</> لَقَالُو<s>ا۟</> رَبَّنَا لَوْ<o>لَآ</> أَرْسَلْتَ إِلَيْنَا رَسُولًۭ<k>ا فَ</>نَتَّبِعَ ءَا<m>يَٰ</>تِكَ مِ<k>ن قَ</><q>بْ</>لِ <d>أَن نَّ</>ذِلَّ وَنَخْزَىٰ"},{"n":135,"w":[["قُلْ","qul","Say","বলো"],["كُلٌّۭ","kullun","Each","\"প্রত্যেকেই"],["مُّتَرَبِّصٌۭ","mutarabbiṣun","(is) waiting","অপেক্ষাকারী"],["فَتَرَبَّصُوا۟ ۖ","fatarabbaṣū","so await","সুতরাং তোমরা অপেক্ষা করো"],["فَسَتَعْلَمُونَ","fasata‘lamūna","Then you will know","অতঃপর তোমরা জানবে শীঘ্রই"],["مَنْ","man","who","কারা"],["أَصْحَـٰبُ","aṣḥābu","(are the) companions","অধিকারী"],["ٱلصِّرَٰطِ","l-ṣirāṭi","(of) the way","পথের"],["ٱلسَّوِىِّ","l-sawiyi","[the] even","সরল সঠিক"],["وَمَنِ","wamani","and who","এবং কারা"],["ٱهْتَدَىٰ","ih'tadā","is guided","সৎপথ অবলম্বন করেছে\""]],"t":"قُلْ كُ<d>لٌّۭ مُّ</>تَرَبِّ<k>صٌۭ فَ</>تَرَبَّصُو<s>ا۟ ۖ</> فَسَتَعْلَمُونَ مَنْ أَصْ<m>حَٰ</>بُ <h>ٱ</><l>ل</>صِّ<m>رَٰ</>طِ <h>ٱ</><l>ل</>سَّوِىِّ وَمَنِ <h>ٱ</>هْتَدَىٰ"}]}