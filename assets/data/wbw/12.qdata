for you","তোমাদের জন্যে"],["رَبِّىٓ ۖ","rabbī","(from) my Lord","আমার রবের কাছে"],["إِنَّهُۥ","innahu","Indeed, He","নিশ্চয়ই তিনি"],["هُوَ","huwa","He","তিনিই"],["ٱلْغَفُورُ","l-ghafūru","(is) the Oft-Forgiving","ক্ষমাশীল"],["ٱلرَّحِيمُ","l-raḥīmu","the Most Merciful","পরম দয়ালু\""]],"t":"قَالَ سَوْفَ أَسْتَغْفِرُ لَكُمْ رَ<o>بِّىٓ ۖ</> إِ<g>نَّ</>هُ<m>ۥ</> هُوَ <h>ٱ</>لْغَفُورُ <h>ٱ</><l>ل</>رَّ<p>حِي</>مُ"},{"n":99,"w":[["فَلَمَّا","falammā","Then when","অতঃপর যখন"],["دَخَلُوا۟","dakhalū","they entered","তারা উপস্থিত হলো"],["عَلَىٰ","‘alā","upon","নিকট"],["يُوسُفَ","yūsufa","Yusuf","ইউসুফের"],["ءَاوَىٰٓ","āwā","he took","সে জায়গা দিলো"],["إِلَيْهِ","ilayhi","to himself","তার কাছে"],["أَبَوَيْهِ","abawayhi","his parents","তার পিতা-মাতাকে"],["وَقَالَ","waqāla","and said","এবং সে বললো"],["ٱدْخُلُوا۟","ud'khulū","Enter","\"আপনারা প্রবেশ করুন"],["مِصْرَ","miṣ'ra","Egypt","মিশরে"],["إِن","in","if","যদি"],["شَآءَ","shāa","Allah wills","চান"],["ٱللَّهُ","l-lahu","Allah wills","আল্লাহ্‌"],["ءَامِنِينَ","āminīna","safe","নিরাপদ (থাকবেন)\""]],"t":"فَلَ<g>مَّ</>ا دَخَلُو<s>ا۟</> عَلَىٰ يُوسُفَ ءَاوَ<o>ىٰٓ</> إِلَيْهِ أَبَوَيْهِ وَقَالَ <h>ٱ</><q>دْ</>خُلُو<s>ا۟</> مِصْرَ إِ<k>ن شَ</><o>آ</>ءَ <h>ٱ</>للَّهُ ءَامِ<p>نِي</>نَ"},{"n":100,"w":[["وَرَفَعَ","warafa‘a","And he raised","এবং চড়ালেন"],["أَبَوَيْهِ","abawayhi","his parents","তার পিতা-মাতাকে"],["عَلَى","‘alā","upon","উপর"],["ٱلْعَرْشِ","l-‘arshi","the throne","সিংহাসনের"],["وَخَرُّوا۟","wakharrū","and they fell down","এবং তারা ঝুঁকে পড়লো"],["لَهُۥ","lahu","to him","তার দিকে"],["سُجَّدًۭا ۖ","sujjadan","prostrate","সিজদায় (অর্থাৎ নত হয়ে)"],["وَقَالَ","waqāla","And he said","এবং সে বললো"],["يَـٰٓأَبَتِ","yāabati","O my father","\"হে আমার পিতা"],["هَـٰذَا","hādhā","This","এটা"],["تَأْوِيلُ","tawīlu","(is the) interpretation","ব্যখ্যা"],["رُءْيَـٰىَ","ru'yāya","(of) my dream","আমার স্বপ্নের"],["مِن","min","(of) before","থেকে"],["قَبْلُ","qablu","(of) before","পূর্ব"],["قَدْ","qad","Verily","নিশ্চয়ই"],["جَعَلَهَا","ja‘alahā","has made it","তা পরিণত করেছেন"],["رَبِّى","rabbī","my Lord","আমার রব"],["حَقًّۭا ۖ","ḥaqqan","true","সত্য"],["وَقَدْ","waqad","And indeed","এবং নিশ্চয়ই"],["أَحْسَنَ","aḥsana","He was good","অনুুগ্রহ করেছেন"],["بِىٓ","bī","to me","আমার উপর (আমার রব)"],["إِذْ","idh","when","যখন"],["أَخْرَجَنِى","akhrajanī","He took me out","আমাকে তিনি বের করেছেন"],["مِنَ","mina","of","থেকে"],["ٱلسِّجْنِ","l-sij'ni","the prison","কারাগার"],["وَجَآءَ","wajāa","and brought","এবং নিয়ে এনেছেন"],["بِكُم","bikum","you","আপনাদেরকে"],["مِّنَ","mina","from","থেকে"],["ٱلْبَدْوِ","l-badwi","the bedouin life","মরুভূমি"],["مِنۢ","min","after","থেকে"],["بَعْدِ","ba‘di","after","পর"],["أَن","an","[that]","যে"],["نَّزَغَ","nazagha","had caused discord","বিরোধ সৃষ্টি করেছে"],["ٱلشَّيْطَـٰنُ","l-shayṭānu","the Shaitaan","শয়তান"],["بَيْنِى","baynī","between me","আমার মাঝে"],["وَبَيْنَ","wabayna","and between","ও মাঝে"],["إِخْوَتِىٓ ۚ","ikh'watī","my brothers","আমার ভাইদের"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["رَبِّى","rabbī","my Lord","আমার রব"],["لَطِيفٌۭ","laṭīfun","(is) Most Subtle","সুক্ষ্মদর্শী"],["لِّمَا","limā","to what","তার যা"],["يَشَآءُ ۚ","yashāu","He wills","তিনি চান"],["إِنَّهُۥ","innahu","Indeed, He","নিশ্চয়ই তিনি"],["هُوَ","huwa","He","তিনিই"],["ٱلْعَلِيمُ","l-‘alīmu","(is) the All-Knower","মহাবিজ্ঞ"],["ٱلْحَكِيمُ","l-ḥakīmu","the All-Wise","প্রজ্ঞাময়"]],"t":"وَرَفَعَ أَبَوَيْهِ عَلَى <h>ٱ</>لْعَرْشِ وَخَرُّو<s>ا۟</> لَهُ<m>ۥ</> سُجَّ<d>دًۭا ۖ وَ</>قَالَ <o>يَٰٓ</>أَبَتِ <m>هَٰ</>ذَا تَأْوِيلُ رُءْ<m>يَٰ</>ىَ مِ<k>ن قَ</><q>بْ</>لُ قَ<q>دْ</> جَعَلَهَا رَبِّى حَ<d>قًّۭا ۖ وَ</>قَ<q>دْ</> أَحْسَنَ <o>بِىٓ</> إِذْ أَخْرَجَنِى مِنَ <h>ٱ</><l>ل</>سِّ<q>جْ</>نِ وَ<o>جَآ</>ءَ بِ<y>كُم مِّ</>نَ <h>ٱ</>لْبَ<q>دْ</>وِ <i>مِنۢ بَ</>عْدِ <d>أَن نَّ</>زَغَ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نُ بَيْنِى وَبَيْنَ إِخْوَ<o>تِىٓ ۚ</> إِ<g>نَّ</> رَبِّى لَطِي<w>فٌۭ لِّ</>مَا يَ<o>شَآ</>ءُ ۚ إِ<g>نَّ</>هُ<m>ۥ</> هُوَ <h>ٱ</>لْعَلِيمُ <h>ٱ</>لْحَ<p>كِي</>مُ"},{"n":101,"w":[["۞ رَبِّ","rabbi","My Lord","হে আমার রব"],["قَدْ","qad","indeed","নিশ্চয়ই"],["ءَاتَيْتَنِى","ātaytanī","you have given me","আমাকে দিয়েছো ‍তুমি"],["مِنَ","mina","of","কিছু"],["ٱلْمُلْكِ","l-mul'ki","the sovereignty","রাষ্ট্রক্ষমতার"],["وَعَلَّمْتَنِى","wa‘allamtanī","and taught me","ও আমাকে তুমি শিখিয়েছো"],["مِن","min","of","করা"],["تَأْوِيلِ","tawīli","the interpretation","ব্যাখ্যা"],["ٱلْأَحَادِيثِ ۚ","l-aḥādīthi","of the events","স্বপ্নের"],["فَاطِرَ","fāṭira","Creator","(তুমিই) স্রষ্টা"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশের"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীর"],["أَنتَ","anta","You","তুমিই"],["وَلِىِّۦ","waliyyī","(are) my Protector","আমার অভিভাবক"],["فِى","fī","in","মধ্যে"],["ٱلدُّنْيَا","l-dun'yā","the world","পৃথিবীর"],["وَٱلْـَٔاخِرَةِ ۖ","wal-ākhirati","and the Hereafter","এবং আখিরাতেও"],["تَوَفَّنِى","tawaffanī","Cause me to die","আমাকে মৃত্যু দিও"],["مُسْلِمًۭا","mus'liman","(as) a Muslim","মুসলিম হিসেবে"],["وَأَلْحِقْنِى","wa-alḥiq'nī","and join me","ও আমাকে মিলিত করো"],["بِٱلصَّـٰلِحِينَ","bil-ṣāliḥīna","with the righteous","সাথে ভালো লোকদের\""]],"t":"۞ رَبِّ قَ<q>دْ</> ءَاتَيْتَنِى مِنَ <h>ٱ</>لْمُلْكِ وَعَلَّمْتَنِى مِ<k>ن تَ</>أْوِيلِ <h>ٱ</>لْأَحَادِيثِ ۚ فَاطِرَ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ أَ<k>نتَ</> وَلِ<m>ىِّۦ</> فِى <h>ٱ</><l>ل</>دُّنْيَا وَ<h>ٱ</>لْءَاخِرَةِ ۖ تَوَفَّنِى مُسْلِ<d>مًۭا وَ</>أَلْحِ<q>قْ</>نِى بِ<h>ٱ</><l>ل</><m>صَّٰ</>لِ<p>حِي</>نَ"},{"n":102,"w":[["ذَٰلِكَ","dhālika","That","(হে নাবী) এটা"],["مِنْ","min","(is) from","একটি"],["أَنۢبَآءِ","anbāi","the news","সংবাদ সমূহের"],["ٱلْغَيْبِ","l-ghaybi","(of) the unseen","অদৃশ্যের"],["نُوحِيهِ","nūḥīhi","which We reveal","তা আমরা ওহী করছি"],["إِلَيْكَ ۖ","ilayka","to you","তোমার প্রতি"],["وَمَا","wamā","And not","এবং না"],["كُنتَ","kunta","you were","তুমি ছিলে"],["لَدَيْهِمْ","ladayhim","with them","তাদের সঙ্গে"],["إِذْ","idh","when","যখন"],["أَجْمَعُوٓا۟","ajma‘ū","they put together","তারা একজোট হয়েছিলো"],["أَمْرَهُمْ","amrahum","their plan","তাদের কাজে"],["وَهُمْ","wahum","while they","এমতাবস্হায় যে তারা"],["يَمْكُرُونَ","yamkurūna","(were) plotting","ষড়যন্ত্র করছিলো"]],"t":"<m>ذَٰ</>لِكَ مِنْ أَ<i>نۢبَ</><o>آ</>ءِ <h>ٱ</>لْغَيْبِ نُوحِيهِ إِلَيْكَ ۖ وَمَا كُ<k>نتَ</> لَدَيْهِمْ إِذْ أَ<q>جْ</>مَ<o>عُوٓ</><s>ا۟</> أَمْرَهُمْ وَهُمْ يَمْكُ<p>رُو</>نَ"},{"n":103,"w":[["وَمَآ","wamā","And not","এবং নয়"],["أَكْثَرُ","aktharu","most","অধিকাংশ"],["ٱلنَّاسِ","l-nāsi","(of) the mankind","মানুষ"],["وَلَوْ","walaw","even though","এবং যদিও"],["حَرَصْتَ","ḥaraṣta","you desire","তুমি আকাঙ্ক্ষা করো"],["بِمُؤْمِنِينَ","bimu'minīna","(will be) believers","বিশ্বাসী (হবে)"]],"t":"وَ<o>مَآ</> أَكْثَرُ <h>ٱ</><l>ل</><g>نَّ</>اسِ وَلَوْ حَرَصْتَ بِمُؤْمِ<p>نِي</>نَ"},{"n":104,"w":[["وَمَا","wamā","And not","এবং না"],["تَسْـَٔلُهُمْ","tasaluhum","you ask them","তাদের কাছে তুমি চাচ্ছো"],["عَلَيْهِ","‘alayhi","for it","এ জন্যে"],["مِنْ","min","any","কোন"],["أَجْرٍ ۚ","ajrin","reward","পারিশ্রমিক"],["إِنْ","in","Not","নয়"],["هُوَ","huwa","(is) it","তা"],["إِلَّا","illā","but","ছাড়া"],["ذِكْرٌۭ","dhik'run","a reminder","উপদেশ"],["لِّلْعَـٰلَمِينَ","lil'‘ālamīna","to the worlds","বিশ্বজগতের জন্যে"]],"t":"وَمَا تَسْـَٔلُهُمْ عَلَيْهِ مِنْ أَ<q>جْ</>رٍ ۚ إِنْ هُوَ إِلَّا ذِكْ<w>رٌۭ لِّ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":105,"w":[["وَكَأَيِّن","waka-ayyin","And how many","এবং কতইনা"],["مِّنْ","min","of","থেকে"],["ءَايَةٍۢ","āyatin","a Sign","নিদর্শন (রয়েছে)"],["فِى","fī","in","মধ্যে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশের"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","এবং পৃথিবীর"],["يَمُرُّونَ","yamurrūna","they pass","তারা অতিক্রম করে"],["عَلَيْهَا","‘alayhā","over it","তার উপর (দিয়ে)"],["وَهُمْ","wahum","while they","অথচ তারা"],["عَنْهَا","‘anhā","(are) from them","তা থেকে"],["مُعْرِضُونَ","mu‘'riḍūna","the ones who turn away","উপেক্ষাকারী"]],"t":"وَكَأَ<d>يِّن مِّ</>نْ ءَايَ<k>ةٍۢ فِ</>ى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ يَمُرُّونَ عَلَيْهَا وَهُمْ عَنْهَا مُعْرِ<p>ضُو</>نَ"},{"n":106,"w":[["وَمَا","wamā","And not","এবং না"],["يُؤْمِنُ","yu'minu","believe","বিশ্বাস করে"],["أَكْثَرُهُم","aktharuhum","most of them","তাদের অধিকাংশ"],["بِٱللَّهِ","bil-lahi","in Allah","উপর আল্লাহর"],["إِلَّا","illā","except","ছাড়া যে"],["وَهُم","wahum","while they","তখন তারা (বিশ্বাস করলেও)"],["مُّشْرِكُونَ","mush'rikūna","associate partners with Him","শিরক করে"]],"t":"وَمَا يُؤْمِنُ أَكْثَرُ<f>هُم بِ</><h>ٱ</>للَّهِ إِلَّا وَ<y>هُم مُّ</>شْرِ<p>كُو</>نَ"},{"n":107,"w":[["أَفَأَمِنُوٓا۟","afa-aminū","Do they then feel secure","তবে কি তারা নিরাপদ হয়েছে"],["أَن","an","(against) that","যে"],["تَأْتِيَهُمْ","tatiyahum","comes to them","তাদের উপর আসবে"],["غَـٰشِيَةٌۭ","ghāshiyatun","an overwhelming","আচ্ছন্নকারী"],["مِّنْ","min","[of]","কোন"],["عَذَابِ","‘adhābi","punishment","শাস্তি"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহ্‌র"],["أَوْ","aw","or","অথবা"],["تَأْتِيَهُمُ","tatiyahumu","comes to them","তাদের উপর আসবে"],["ٱلسَّاعَةُ","l-sā‘atu","the Hour","ক্বিয়ামাত"],["بَغْتَةًۭ","baghtatan","suddenly","হঠাৎ করে"],["وَهُمْ","wahum","while they","এমতাবস্হায় যে তারা"],["لَا","lā","(do) not","না"],["يَشْعُرُونَ","yash‘urūna","perceive","টেরও পাবে"]],"t":"أَفَأَمِ<o>نُوٓ</><s>ا۟</> أَ<k>ن تَ</>أْتِيَهُمْ <m>غَٰ</>شِيَ<d>ةٌۭ مِّ</>نْ عَذَابِ <h>ٱ</>للَّهِ أَوْ تَأْتِيَهُمُ <h>ٱ</><l>ل</>سَّاعَةُ بَغْتَ<d>ةًۭ وَ</>هُمْ لَا يَشْعُ<p>رُو</>نَ"},{"n":108,"w":[["قُلْ","qul","Say","(হে নাবী) বলো"],["هَـٰذِهِۦ","hādhihi","This","\"এই"],["سَبِيلِىٓ","sabīlī","(is) my way","আমার পথ"],["أَدْعُوٓا۟","ad‘ū","I invite","ডাকি আমি"],["إِلَى","ilā","to","দিকে"],["ٱللَّهِ ۚ","l-lahi","Allah","আল্লাহ্‌র"],["عَلَىٰ","‘alā","with","ভিত্তিতে"],["بَصِيرَةٍ","baṣīratin","insight","জ্ঞানের"],["أَنَا۠","anā","I","আমি"],["وَمَنِ","wamani","and whoever","এবং যে"],["ٱتَّبَعَنِى ۖ","ittaba‘anī","follows me","আমার অনুসরণ করে"],["وَسُبْحَـٰنَ","wasub'ḥāna","And Glory be","এবং মহান পবিত্র"],["ٱللَّهِ","l-lahi","(to) Allah","আল্লাহ্‌"],["وَمَآ","wamā","and not","এবং নই"],["أَنَا۠","anā","I am","আমি"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْمُشْرِكِينَ","l-mush'rikīna","the polytheists","মুশরিকদের\""]],"t":"قُلْ <m>هَٰذِهِۦ</> سَبِي<o>لِىٓ</> أَ<q>دْ</><o>عُوٓ</><s>ا۟</> إِلَى <h>ٱ</>للَّهِ ۚ عَلَىٰ بَصِيرَةٍ أَنَا۠ وَمَنِ <h>ٱ</>تَّبَعَنِى ۖ وَسُ<q>بْ</><m>حَٰ</>نَ <h>ٱ</>للَّهِ وَ<o>مَآ</> أَنَا۠ مِنَ <h>ٱ</>لْمُشْرِ<p>كِي</>نَ"},{"n":109,"w":[["وَمَآ","wamā","And not","এবং না"],["أَرْسَلْنَا","arsalnā","We sent","আমরা পাঠিয়েছি"],["مِن","min","before you","থেকে"],["قَبْلِكَ","qablika","before you","আগে তোমার (রাসূলদেরকে)"],["إِلَّا","illā","but","ছাড়া"],["رِجَالًۭا","rijālan","men","পুরুষদেরকে"],["نُّوحِىٓ","nūḥī","We revealed","আমরা ওহী করেছি"],["إِلَيْهِم","ilayhim","to them","তাদের প্রতি"],["مِّنْ","min","from (among)","মধ্য থেকে"],["أَهْلِ","ahli","(the) people","অধিবাসীদের"],["ٱلْقُرَىٰٓ ۗ","l-qurā","(of) the townships","জনপদের"],["أَفَلَمْ","afalam","So have not","নি তবে কি"],["يَسِيرُوا۟","yasīrū","they traveled","তারা ভ্রমণ করে"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["فَيَنظُرُوا۟","fayanẓurū","and seen","অতঃপর তারা দেখেনি"],["كَيْفَ","kayfa","how","কেমন"],["كَانَ","kāna","was","ছিলো"],["عَـٰقِبَةُ","‘āqibatu","(the) end","পরিণতি (তাদের)"],["ٱلَّذِينَ","alladhīna","(of) those who","যারা (ছিলো)"],["مِن","min","(were) before them","থেকে"],["قَبْلِهِمْ ۗ","qablihim","(were) before them","পূর্ব তাদের"],["وَلَدَارُ","waladāru","And surely the home","এবং অবশ্যই ঘর"],["ٱلْـَٔاخِرَةِ","l-ākhirati","(of) the Hereafter","পরকালের"],["خَيْرٌۭ","khayrun","(is) best","উত্তম"],["لِّلَّذِينَ","lilladhīna","for those who","তাদের জন্যে (যারা)"],["ٱتَّقَوْا۟ ۗ","ittaqaw","fear Allah","ভয় করে চলে"],["أَفَلَا","afalā","Then will not","তবে কি না"],["تَعْقِلُونَ","ta‘qilūna","you use reason","তোমরা বুঝবে"]],"t":"وَ<o>مَآ</> أَرْسَلْنَا مِ<k>ن قَ</><q>بْ</>لِكَ إِلَّا رِجَالًۭ<d>ا نُّ</>و<o>حِىٓ</> إِلَيْ<y>هِم مِّ</>نْ أَهْلِ <h>ٱ</>لْقُرَ<o>ىٰٓ ۗ</> أَفَلَمْ يَسِيرُو<s>ا۟</> فِى <h>ٱ</>لْأَرْضِ فَيَ<k>نظُ</>رُو<s>ا۟</> كَيْفَ كَانَ <m>عَٰ</>قِبَةُ <h>ٱ</>لَّذِينَ مِ<k>ن قَ</><q>بْ</>لِهِمْ ۗ وَلَدَارُ <h>ٱ</>لْءَاخِرَةِ خَيْ<w>رٌۭ لِّ</>لَّذِينَ <h>ٱ</>تَّقَوْ<s>ا۟ ۗ</> أَفَلَا تَعْقِ<p>لُو</>نَ"},{"n":110,"w":[["حَتَّىٰٓ","ḥattā","Until","এমনকি"],["إِذَا","idhā","when","যখন"],["ٱسْتَيْـَٔسَ","is'tayasa","gave up hope","নিরাশ হলো"],["ٱلرُّسُلُ","l-rusulu","the Messengers","রাসূলরা"],["وَظَنُّوٓا۟","waẓannū","and thought","এবং (লোকেরা) ভাবলো"],["أَنَّهُمْ","annahum","that they","যে তাদেরকে"],["قَدْ","qad","certainly","নিশ্চয়ই"],["كُذِبُوا۟","kudhibū","were denied","তাদেরকে মিথ্যা আশ্বাস দেয়া হয়েছে"],["جَآءَهُمْ","jāahum","then came to them","তাদের (রাসূলদের) কাছে আসলো"],["نَصْرُنَا","naṣrunā","Our help","আমাদের সাহায্য"],["فَنُجِّىَ","fanujjiya","and was saved","অতঃপর উদ্ধার করা হলো"],["مَن","man","whom","যাদেরকে"],["نَّشَآءُ ۖ","nashāu","We willed","আমরা চেয়েছি"],["وَلَا","walā","And not","এবং না"],["يُرَدُّ","yuraddu","(can) be repelled","প্রতিরোধ করা হয়"],["بَأْسُنَا","basunā","Our punishment","আমাদের শাস্তি"],["عَنِ","‘ani","from","হ'তে"],["ٱلْقَوْمِ","l-qawmi","the people","সম্প্রদায়"],["ٱلْمُجْرِمِينَ","l-muj'rimīna","(who are) criminals","অপরাধী"]],"t":"حَتَّ<o>ىٰٓ</> إِذَا <h>ٱ</>سْتَيْـَٔسَ <h>ٱ</><l>ل</>رُّسُلُ وَظَ<g>نُّ</><o>وٓ</><s>ا۟</> أَ<g>نَّ</>هُمْ قَ<q>دْ</> كُذِبُو<s>ا۟</> <o>جَآ</>ءَهُمْ نَصْرُنَا فَنُجِّىَ <d>مَن نَّ</><o>شَآ</>ءُ ۖ وَلَا يُرَدُّ بَأْسُنَا عَنِ <h>ٱ</>لْقَوْمِ <h>ٱ</>لْمُ<q>جْ</>رِ<p>مِي</>نَ"},{"n":111,"w":[["لَقَدْ","laqad","Verily","নিশ্চয়ই"],["كَانَ","kāna","(there) is","রয়েছে"],["فِى","fī","in","মধ্যে"],["قَصَصِهِمْ","qaṣaṣihim","their stories","তাদের কাহিনীগুলোর"],["عِبْرَةٌۭ","‘ib'ratun","a lesson","শিক্ষা"],["لِّأُو۟لِى","li-ulī","for men","জন্যে সম্পন্নদের"],["ٱلْأَلْبَـٰبِ ۗ","l-albābi","(of) understanding","জ্ঞানবুদ্ধি"],["مَا","mā","Not","না"],["كَانَ","kāna","(it) is","ছিলো"],["حَدِيثًۭا","ḥadīthan","a narration","এ কথা"],["يُفْتَرَىٰ","yuf'tarā","invented","মনগড়া"],["وَلَـٰكِن","walākin","but","কিন্তু"],["تَصْدِيقَ","taṣdīqa","a confirmation","সত্যায়নকারী"],["ٱلَّذِى","alladhī","(of that) which","যা"],["بَيْنَ","bayna","(was) before it","বিদ্যমান"],["يَدَيْهِ","yadayhi","(was) before it","তার সামনে"],["وَتَفْصِيلَ","watafṣīla","and a detailed explanation","এবং বিশদ ব্যাখ্যা"],["كُلِّ","kulli","(of) all","সব"],["شَىْءٍۢ","shayin","things","কিছুর"],["وَهُدًۭى","wahudan","and a guidance","এবং দিশা"],["وَرَحْمَةًۭ","waraḥmatan","and mercy","ও অনুগ্রহ"],["لِّقَوْمٍۢ","liqawmin","for a people","লোকদের জন্যে"],["يُؤْمِنُونَ","yu'minūna","who believe","(যারা) ঈমান আনে"]],"t":"لَقَ<q>دْ</> كَانَ فِى قَصَصِهِمْ عِ<q>بْ</>رَ<w>ةٌۭ لِّ</>أُ<s>و۟</>لِى <h>ٱ</>لْأَلْ<m>بَٰ</>بِ ۗ مَا كَانَ حَدِي<d>ثًۭا يُ</>فْتَرَىٰ وَ<m>لَٰ</>كِ<k>ن تَ</>صْدِيقَ <h>ٱ</>لَّذِى بَيْنَ يَدَيْهِ وَتَفْصِيلَ كُلِّ <d>شَىْءٍۢ وَهُدًۭى وَ</>رَحْمَ<w>ةًۭ لِّ</>قَوْ<d>مٍۢ يُ</>ؤْمِ<p>نُو</>نَ"}]}