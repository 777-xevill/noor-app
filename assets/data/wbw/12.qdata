{"n":12,"a":[{"n":1,"w":[["الٓر ۚ","alif-lam-ra","Alif Laam Ra","আলিফ লাম-রা"],["تِلْكَ","til'ka","These","এই"],["ءَايَـٰتُ","āyātu","(are the) Verses","আয়াতগুলো"],["ٱلْكِتَـٰبِ","l-kitābi","(of) the Book","(এমন) কিতাবের"],["ٱلْمُبِينِ","l-mubīni","[the] clear","(যা) সুস্পষ্ট"]],"t":"ا<n>لٓ</>ر ۚ تِلْكَ ءَا<m>يَٰ</>تُ <h>ٱ</>لْكِ<m>تَٰ</>بِ <h>ٱ</>لْمُ<p>بِي</>نِ"},{"n":2,"w":[["إِنَّآ","innā","Indeed, We","নিশ্চয়ই আমরা"],["أَنزَلْنَـٰهُ","anzalnāhu","We have sent it down","তা আমরা অবতীর্ণ করেছি"],["قُرْءَٰنًا","qur'ānan","(as) a Quran in Arabic","কুরআন (বানিয়ে)"],["عَرَبِيًّۭا","‘arabiyyan","(as) a Quran in Arabic","আরবী (ভাষায়)"],["لَّعَلَّكُمْ","la‘allakum","so that you may","তোমরা যাতে"],["تَعْقِلُونَ","ta‘qilūna","understand","বুঝতে পারো"]],"t":"إِ<g>نَّ</><o>آ</> أَ<k>نزَ</>لْ<m>نَٰ</>هُ قُرْ<m>ءَٰ</>نًا عَرَبِ<w>يًّۭا لَّ</>عَلَّكُمْ تَعْقِ<p>لُو</>نَ"},{"n":3,"w":[["نَحْنُ","naḥnu","We","আমরা"],["نَقُصُّ","naquṣṣu","relate","বর্ণনা করছি"],["عَلَيْكَ","‘alayka","to you","তোমার কাছে"],["أَحْسَنَ","aḥsana","the best","অতি উত্তম"],["ٱلْقَصَصِ","l-qaṣaṣi","of the narrations","কাহিনীসমূহ"],["بِمَآ","bimā","in what","মাধ্যমে যা"],["أَوْحَيْنَآ","awḥaynā","We have revealed","আমরা ওহী করেছি"],["إِلَيْكَ","ilayka","to you","তোমার প্রতি"],["هَـٰذَا","hādhā","(of) this","এই"],["ٱلْقُرْءَانَ","l-qur'āna","the Quran","কুর'আন"],["وَإِن","wa-in","although","যদিও নিশ্চয়ই"],["كُنتَ","kunta","you were","তুমি ছিলে"],["مِن","min","before it","থেকে"],["قَبْلِهِۦ","qablihi","before it","পূর্ব এর"],["لَمِنَ","lamina","surely among","অবশ্যই অন্তর্ভুক্ত"],["ٱلْغَـٰفِلِينَ","l-ghāfilīna","the unaware","অনবহিতদের"]],"t":"نَحْنُ نَقُصُّ عَلَيْكَ أَحْسَنَ <h>ٱ</>لْقَصَصِ بِ<o>مَآ</> أَوْحَيْ<o>نَآ</> إِلَيْكَ <m>هَٰ</>ذَا <h>ٱ</>لْقُرْءَانَ وَإِ<k>ن كُنتَ</> مِ<k>ن قَ</><q>بْ</>لِ<m>هِۦ</> لَمِنَ <h>ٱ</>لْ<m>غَٰ</>فِ<p>لِي</>نَ"},{"n":4,"w":[["إِذْ","idh","When","যখন (স্মরণ করো)"],["قَالَ","qāla","said","বলেছিলো"],["يُوسُفُ","yūsufu","Yusuf","ইউসুফ"],["لِأَبِيهِ","li-abīhi","to his father","তার পিতাকে"],["يَـٰٓأَبَتِ","yāabati","O my father","\"হে আমার পিতা"],["إِنِّى","innī","Indeed, I","নিশ্চয়ই আমি"],["رَأَيْتُ","ra-aytu","I saw","(স্বপ্নে) দেখেছি"],["أَحَدَ","aḥada","eleven","এগারো"],["عَشَرَ","‘ashara","eleven","এগারো"],["كَوْكَبًۭا","kawkaban","stars","তারাকে"],["وَٱلشَّمْسَ","wal-shamsa","and the sun","এবং সূর্যকে"],["وَٱلْقَمَرَ","wal-qamara","and the moon","এবং চাঁদকে"],["رَأَيْتُهُمْ","ra-aytuhum","I saw them","তাদের আমি দেখেছি"],["لِى","lī","to me","আমাকে"],["سَـٰجِدِينَ","sājidīna","prostrating","(তারা) সিজদাকারী\""]],"t":"إِذْ قَالَ يُوسُفُ لِأَبِيهِ <o>يَٰٓ</>أَبَتِ إِ<g>نِّ</>ى رَأَيْتُ أَحَدَ عَشَرَ كَوْكَ<d>بًۭا وَ</><h>ٱ</><l>ل</>شَّمْسَ وَ<h>ٱ</>لْقَمَرَ رَأَيْتُهُمْ لِى <m>سَٰ</>جِ<p>دِي</>نَ"},{"n":5,"w":[["قَالَ","qāla","He said","সে বললো"],["يَـٰبُنَىَّ","yābunayya","O my son","\"হে আমার পুত্র"],["لَا","lā","(Do) not","না"],["تَقْصُصْ","taqṣuṣ","relate","বর্ণনা করো"],["رُءْيَاكَ","ru'yāka","your vision","তোমার স্বপ্ন"],["عَلَىٰٓ","‘alā","to","কাছে"],["إِخْوَتِكَ","ikh'watika","your brothers","তোমার ভাইদের"],["فَيَكِيدُوا۟","fayakīdū","lest they plan","তাহ'লে তারা চক্রান্ত করবে"],["لَكَ","laka","against you","তোমার বিরুদ্ধে"],["كَيْدًا ۖ","kaydan","a plot","(বড়) চক্রান্ত"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلشَّيْطَـٰنَ","l-shayṭāna","the Shaitaan","শয়তান"],["لِلْإِنسَـٰنِ","lil'insāni","(is) to man","মানুষের জন্যে"],["عَدُوٌّۭ","‘aduwwun","an enemy","শত্রু"],["مُّبِينٌۭ","mubīnun","open","প্রকাশ্য"]],"t":"قَالَ <m>يَٰ</>بُنَىَّ لَا تَ<q>قْ</>صُصْ رُءْيَاكَ عَلَ<o>ىٰٓ</> إِخْوَتِكَ فَيَكِيدُو<s>ا۟</> لَكَ كَيْدًا ۖ إِ<g>نَّ</> <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نَ لِلْإِ<k>نسَٰ</>نِ عَدُ<d>وٌّۭ مُّ</><p>بِي</>نٌۭ"},{"n":6,"w":[["وَكَذَٰلِكَ","wakadhālika","And thus","এবং এভাবেই (হবে)"],["يَجْتَبِيكَ","yajtabīka","will choose you","তোমাকে মনোনীত করবেন"],["رَبُّكَ","rabbuka","your Lord","তোমার রব"],["وَيُعَلِّمُكَ","wayu‘allimuka","and will teach you","ও তোমাকে শিখাবেন"],["مِن","min","of","থেকে"],["تَأْوِيلِ","tawīli","(the) interpretation","ব্যাখ্যা"],["ٱلْأَحَادِيثِ","l-aḥādīthi","(of) the narratives","স্বপ্নের"],["وَيُتِمُّ","wayutimmu","and complete","পূর্ণ করবেন"],["نِعْمَتَهُۥ","ni‘'matahu","His Favor","তাঁর অনুগ্রহ"],["عَلَيْكَ","‘alayka","on you","তোমার উপর"],["وَعَلَىٰٓ","wa‘alā","and on","এবং উপর"],["ءَالِ","āli","(the) family","বংশধরদের"],["يَعْقُوبَ","ya‘qūba","(of) Yaqub","ইয়াকুবের"],["كَمَآ","kamā","as","যেমন"],["أَتَمَّهَا","atammahā","He completed it","তা পূর্ণ করেছিলেন"],["عَلَىٰٓ","‘alā","on","উপর"],["أَبَوَيْكَ","abawayka","your two forefathers","তোমার পিতৃ-পুরুষের"],["مِن","min","before ","থেকে"],["قَبْلُ","qablu","before ","পূর্ব"],["إِبْرَٰهِيمَ","ib'rāhīma","Ibrahim","(যেমন) ইবরাহীমের"],["وَإِسْحَـٰقَ ۚ","wa-is'ḥāqa","and Isaac","ও ইসহাকের (উপর)"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["رَبَّكَ","rabbaka","your Lord","তোমার রব"],["عَلِيمٌ","‘alīmun","(is) All-Knower","সর্বজ্ঞ"],["حَكِيمٌۭ","ḥakīmun","All-Wise","প্রজ্ঞাময়\""]],"t":"وَكَ<m>ذَٰ</>لِكَ يَ<q>جْ</>تَبِيكَ رَبُّكَ وَيُعَلِّمُكَ مِ<k>ن تَ</>أْوِيلِ <h>ٱ</>لْأَحَادِيثِ وَيُتِ<g>مُّ</> نِعْمَتَهُ<m>ۥ</> عَلَيْكَ وَعَلَ<o>ىٰٓ</> ءَالِ يَعْقُوبَ كَ<o>مَآ</> أَتَ<g>مَّ</>هَا عَلَ<o>ىٰٓ</> أَبَوَيْكَ مِ<k>ن قَ</><q>بْ</>لُ إِ<q>بْ</><m>رَٰ</>هِيمَ وَإِسْ<m>حَٰ</>قَ ۚ إِ<g>نَّ</> رَبَّكَ عَلِيمٌ حَ<p>كِي</>مٌۭ"},{"n":7,"w":[["۞ لَّقَدْ","laqad","Certainly","নিশ্চয়ই"],["كَانَ","kāna","were","ছিলো"],["فِى","fī","in","মধ্যে"],["يُوسُفَ","yūsufa","Yusuf","ইউসুফের (কাহিনীর)"],["وَإِخْوَتِهِۦٓ","wa-ikh'watihi","and his brothers","ও তার ভাইদের"],["ءَايَـٰتٌۭ","āyātun","signs","নিদর্শনসমূহ"],["لِّلسَّآئِلِينَ","lilssāilīna","for those who ask","জিজ্ঞাসাকারীদের জন্যে"]],"t":"۞ لَّقَ<q>دْ</> كَانَ فِى يُوسُفَ وَإِخْوَتِ<o>هِۦٓ</> ءَا<m>يَٰ</><w>تٌۭ لِّ</>ل<o>سَّآ</>ئِ<p>لِي</>نَ"},{"n":8,"w":[["إِذْ","idh","When","যখন (স্মরণ করো)"],["قَالُوا۟","qālū","they said","(তারা ভাইয়েরা) বলেছিলো"],["لَيُوسُفُ","layūsufu","Surely Yusuf","\"অবশ্যই ইউসুফ"],["وَأَخُوهُ","wa-akhūhu","and his brother","ও তার ভাই"],["أَحَبُّ","aḥabbu","(are) more beloved","অধিক প্রিয়"],["إِلَىٰٓ","ilā","to","কাছে"],["أَبِينَا","abīnā","our father","আমাদের পিতার"],["مِنَّا","minnā","than we","আমাদের চেয়ে"],["وَنَحْنُ","wanaḥnu","while we","অথচ আমরা"],["عُصْبَةٌ","‘uṣ'batun","(are) a group","একটি ঐক্যবদ্ধ দল"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["أَبَانَا","abānā","our father","আমাদের পিতা"],["لَفِى","lafī","(is) surely in","অবশ্যই মধ্যে"],["ضَلَـٰلٍۢ","ḍalālin","an error","বিভ্রান্তির"],["مُّبِينٍ","mubīnin","clear","প্রকাশ্য"]],"t":"إِذْ قَالُو<s>ا۟</> لَيُوسُفُ وَأَخُوهُ أَحَبُّ إِلَ<o>ىٰٓ</> أَبِينَا مِ<g>نَّ</>ا وَنَحْنُ عُصْبَةٌ إِ<g>نَّ</> أَبَانَا لَفِى ضَ<m>لَٰ</><d>لٍۢ مُّ</><p>بِي</>نٍ"},{"n":9,"w":[["ٱقْتُلُوا۟","uq'tulū","Kill","তোমরা হত্যা করো"],["يُوسُفَ","yūsufa","Yusuf","ইউসুফকে"],["أَوِ","awi","or","বা"],["ٱطْرَحُوهُ","iṭ'raḥūhu","cast him","তাকে ফেলে আসো"],["أَرْضًۭا","arḍan","(to) a land","কোন স্থানে"],["يَخْلُ","yakhlu","so will be free","নিবিষ্ট হবে"],["لَكُمْ","lakum","for you","তোমাদের দিকে"],["وَجْهُ","wajhu","(the) face","দৃষ্টি"],["أَبِيكُمْ","abīkum","(of) your father","তোমাদের পিতার"],["وَتَكُونُوا۟","watakūnū","and you will be","ও তোমরা হয়ে যাবে"],["مِنۢ","min","after that","থেকে"],["بَعْدِهِۦ","ba‘dihi","after that","এরপর"],["قَوْمًۭا","qawman","a people","লোক"],["صَـٰلِحِينَ","ṣāliḥīna","righteous","সৎকর্মশীল\""]],"t":"ٱ<q>قْ</>تُلُو<s>ا۟</> يُوسُفَ أَوِ <h>ٱ</><q>طْ</>رَحُوهُ أَرْ<d>ضًۭا يَ</>خْلُ لَكُمْ وَ<q>جْ</>هُ أَبِيكُمْ وَتَكُونُو<s>ا۟</> <i>مِنۢ بَ</>عْدِ<m>هِۦ</> قَوْ<k>مًۭا صَٰ</>لِ<p>حِي</>نَ"},{"n":10,"w":[["قَالَ","qāla","Said","বললো"],["قَآئِلٌۭ","qāilun","a speaker","এক প্রবক্তা"],["مِّنْهُمْ","min'hum","among them","তাদের মধ্য হ'তে"],["لَا","lā","(Do) not","\"না"],["تَقْتُلُوا۟","taqtulū","kill","তোমরা হত্যা করো"],["يُوسُفَ","yūsufa","Yusuf","ইউসুফকে"],["وَأَلْقُوهُ","wa-alqūhu","but throw him","বরং তাকে নিক্ষেপ করো"],["فِى","fī","in","মধ্যে"],["غَيَـٰبَتِ","ghayābati","the bottom","(অন্ধকার) গভীরে"],["ٱلْجُبِّ","l-jubi","(of) the well","কূপের"],["يَلْتَقِطْهُ","yaltaqiṭ'hu","will pick him","তাকে তুলে নিবে"],["بَعْضُ","ba‘ḍu","some","কেউ"],["ٱلسَّيَّارَةِ","l-sayārati","[the] caravan","পথযাত্রীদলের"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you are","তোমরা হও"],["فَـٰعِلِينَ","fā‘ilīna","doing","কর্মসম্পাদনকারী\""]],"t":"قَالَ <o>قَآ</>ئِ<d>لٌۭ مِّ</>نْهُمْ لَا تَ<q>قْ</>تُلُو<s>ا۟</> يُوسُفَ وَأَلْقُوهُ فِى غَ<m>يَٰ</>بَتِ <h>ٱ</>لْجُبِّ يَلْتَقِ<q>طْ</>هُ بَعْضُ <h>ٱ</><l>ل</>سَّيَّارَةِ إِ<k>ن كُنتُ</>مْ <m>فَٰ</>عِ<p>لِي</>نَ"},{"n":11,"w":[["قَالُوا۟","qālū","They said","তারা বললো"],["يَـٰٓأَبَانَا","yāabānā","O our father","\"হে আমাদের পিতা"],["مَا","mā","Why","কি"],["لَكَ","laka","(do) you","আপনার হয়েছে"],["لَا","lā","not","না"],["تَأْمَ۫نَّا","tamannā","trust us","আমাদের বিশ্বাস করেন"],["عَلَىٰ","‘alā","with","ব্যাপারে"],["يُوسُفَ","yūsufa","Yusuf","ইউসুফের"],["وَإِنَّا","wa-innā","while indeed, we","অথচ নিশ্চয়ই আমরা"],["لَهُۥ","lahu","(are) for him","জন্যে তার"],["لَنَـٰصِحُونَ","lanāṣiḥūna","surely well-wishers","অবশ্যই (সবাই) হিতাকাঙ্ক্ষী"]],"t":"قَالُو<s>ا۟</> <o>يَٰٓ</>أَبَانَا مَا لَكَ لَا تَأْمَ۫<g>نَّ</>ا عَلَىٰ يُوسُفَ وَإِ<g>نَّ</>ا لَهُ<m>ۥ</> لَ<m>نَٰ</>صِ<p>حُو</>نَ"},{"n":12,"w":[["أَرْسِلْهُ","arsil'hu","Send him","তাকে পাঠান"],["مَعَنَا","ma‘anā","with us","আমাদের সাথে"],["غَدًۭا","ghadan","tomorrow","আগামীকাল"],["يَرْتَعْ","yarta‘","(to) enjoy","সে ফল খাবে"],["وَيَلْعَبْ","wayal‘ab","and play","ও খেলবে"],["وَإِنَّا","wa-innā","And indeed, we","এবং নিশ্চয়ই আমরা"],["لَهُۥ","lahu","for him","তার জন্যে\""],["لَحَـٰفِظُونَ","laḥāfiẓūna","(will) surely (be) guardians","অবশ্যই (সবাই) সংরক্ষক\""]],"t":"أَرْسِلْهُ مَعَنَا غَ<d>دًۭا يَ</>رْتَعْ وَيَلْعَ<q>بْ</> وَإِ<g>نَّ</>ا لَهُ<m>ۥ</> لَ<m>حَٰ</>فِ<p>ظُو</>نَ"},{"n":13,"w":[["قَالَ","qāla","He said","সে বললো"],["إِنِّى","innī","Indeed, [I]","\"নিশ্চয়ই আমার"],["لَيَحْزُنُنِىٓ","layaḥzununī","it surely saddens me","আমার অবশ্যই চিন্তা লাগে"],["أَن","an","that","যে"],["تَذْهَبُوا۟","tadhhabū","you should take him","তোমরা যাবে"],["بِهِۦ","bihi","you should take him","নিয়ে তাকে"],["وَأَخَافُ","wa-akhāfu","and I fear","এবং আমি ভয় করি"],["أَن","an","that","যে"],["يَأْكُلَهُ","yakulahu","would eat him","তাকে খেয়ে ফেলবে"],["ٱلذِّئْبُ","l-dhi'bu","a wolf","নেকড়ে বাঘ"],["وَأَنتُمْ","wa-antum","while you","এ অবস্থায় যে তোমরা"],["عَنْهُ","‘anhu","of him","তার থেকে"],["غَـٰفِلُونَ","ghāfilūna","(are) unaware","অমনোযোগী হয়ে যাবে\""]],"t":"قَالَ إِ<g>نِّ</>ى لَيَحْزُنُ<o>نِىٓ</> أَ<k>ن تَ</>ذْهَبُو<s>ا۟</> بِ<m>هِۦ</> وَأَخَافُ <d>أَن يَ</>أْكُلَهُ <h>ٱ</><l>ل</>ذِّئْبُ وَأَ<k>نتُ</>مْ عَنْهُ <m>غَٰ</>فِ<p>لُو</>نَ"},{"n":14,"w":[["قَالُوا۟","qālū","They said","তারা বললো"],["لَئِنْ","la-in","If","\"অবশ্য যদি"],["أَكَلَهُ","akalahu","eats him","তাকে খায়"],["ٱلذِّئْبُ","l-dhi'bu","the wolf","নেকড়ে বাঘ"],["وَنَحْنُ","wanaḥnu","while we","এ অবস্থায় যে আমরা"],["عُصْبَةٌ","‘uṣ'batun","(are) a group","একটি ঐক্যবদ্ধ দল"],["إِنَّآ","innā","indeed, we","নিশ্চয়ই আমরা"],["إِذًۭا","idhan","then","তাহ'লে"],["لَّخَـٰسِرُونَ","lakhāsirūna","surely (would be) losers","অবশ্যই ক্ষতিগ্রস্ত হবো\""]],"t":"قَالُو<s>ا۟</> لَئِنْ أَكَلَهُ <h>ٱ</><l>ل</>ذِّئْبُ وَنَحْنُ عُصْبَةٌ إِ<g>نَّ</><o>آ</> إِ<w>ذًۭا لَّ</><m>خَٰ</>سِ<p>رُو</>نَ"},{"n":15,"w":[["فَلَمَّا","falammā","So when","অতঃপর যখন"],["ذَهَبُوا۟","dhahabū","they took him","তারা গেলো"],["بِهِۦ","bihi","they took him","নিয়ে তাকে"],["وَأَجْمَعُوٓا۟","wa-ajma‘ū","and agreed","এবং তারা একমত হলো"],["أَن","an","that","যে"],["يَجْعَلُوهُ","yaj‘alūhu","they put him","তাকে তারা ফেলে দিবে"],["فِى","fī","in","মধ্যে"],["غَيَـٰبَتِ","ghayābati","(the) bottom","(অন্ধকার) গভীরে"],["ٱلْجُبِّ ۚ","l-jubi","(of) the well","কূপের"],["وَأَوْحَيْنَآ","wa-awḥaynā","But We inspired","এ অবস্থায় আমরা ওহী করলাম"],["إِلَيْهِ","ilayhi","to him","তার কাছে"],["لَتُنَبِّئَنَّهُم","latunabbi-annahum","Surely, you will inform them","\"তাদের তুমি নিশ্চয়ই এক সময় জানিয়ে দিবে"],["بِأَمْرِهِمْ","bi-amrihim","about this affair","সম্পর্কে তাদের কাজ"],["هَـٰذَا","hādhā","about this affair","এই"],["وَهُمْ","wahum","while they","(এখন) অথচ তারা"],["لَا","lā","(do) not","না"],["يَشْعُرُونَ","yash‘urūna","perceive","তারা অনুভব করছে\""]],"t":"فَلَ<g>مَّ</>ا ذَهَبُو<s>ا۟</> بِ<m>هِۦ</> وَأَ<q>جْ</>مَ<o>عُوٓ</><s>ا۟</> <d>أَن يَ</><q>جْ</>عَلُوهُ فِى غَ<m>يَٰ</>بَتِ <h>ٱ</>لْجُبِّ ۚ وَأَوْحَيْ<o>نَآ</> إِلَيْهِ لَتُنَبِّئَ<g>نَّ</><f>هُم بِ</>أَمْرِهِمْ <m>هَٰ</>ذَا وَهُمْ لَا يَشْعُ<p>رُو</>نَ"},{"n":16,"w":[["وَجَآءُوٓ","wajāū","And they came","এবং তারা আসলো"],["أَبَاهُمْ","abāhum","(to) their father","তাদের পিতার কাছে"],["عِشَآءًۭ","‘ishāan","early at night","সন্ধ্যাকালে"],["يَبْكُونَ","yabkūna","weeping","কাঁদতে কাঁদতে"]],"t":"وَ<o>جَآءُوٓ</> أَبَاهُمْ عِ<o>شَآ</><d>ءًۭ يَ</><q>بْ</><p>كُو</>نَ"},{"n":17,"w":[["قَالُوا۟","qālū","They said","তারা বললো"],["يَـٰٓأَبَانَآ","yāabānā","O our father","\"হে আমাদের পিতা"],["إِنَّا","innā","Indeed, we","নিশ্চয়ই আমরা"],["ذَهَبْنَا","dhahabnā","[we] went","আমরা গিয়েছিলাম"],["نَسْتَبِقُ","nastabiqu","racing each other","দৌড়ের পাল্লা দিচ্ছিলাম"],["وَتَرَكْنَا","wataraknā","and we left","ও আমরা রেখে গিয়েছিলাম"],["يُوسُفَ","yūsufa","Yusuf","ইউসুফকে"],["عِندَ","‘inda","with","কাছে"],["مَتَـٰعِنَا","matā‘inā","our possessions","আমাদের মালপত্রের"],["فَأَكَلَهُ","fa-akalahu","and ate him","তাকে তখন খেয়ে ফেলে"],["ٱلذِّئْبُ ۖ","l-dhi'bu","the wolf","নেকড়ে বাঘ"],["وَمَآ","wamā","But not","অথচ নন"],["أَنتَ","anta","you","আপনি"],["بِمُؤْمِنٍۢ","bimu'minin","(will) believe","বিশ্বাসকারী"],["لَّنَا","lanā","us","আমাদেরকে"],["وَلَوْ","walaw","even if","যদিও"],["كُنَّا","kunnā","we are","আমরা হই"],["صَـٰدِقِينَ","ṣādiqīna","truthful","(সবাই) সত্যবাদী\""]],"t":"قَالُو<s>ا۟</> <o>يَٰٓ</>أَبَا<o>نَآ</> إِ<g>نَّ</>ا ذَهَ<q>بْ</>نَا نَسْتَبِقُ وَتَرَكْنَا يُوسُفَ عِ<k>ندَ</> مَ<m>تَٰ</>عِنَا فَأَكَلَهُ <h>ٱ</><l>ل</>ذِّئْبُ ۖ وَ<o>مَآ</> أَ<k>نتَ</> بِمُؤْمِ<w>نٍۢ لَّ</>نَا وَلَوْ كُ<g>نَّ</>ا <m>صَٰ</>دِ<p>قِي</>نَ"},{"n":18,"w":[["وَجَآءُو","wajāū","And they brought","এবং তারা আসলো"],["عَلَىٰ","‘alā","upon","উপর"],["قَمِيصِهِۦ","qamīṣihi","his shirt","তার জামার"],["بِدَمٍۢ","bidamin","with false blood","নিয়ে রক্ত (লাগিয়ে)"],["كَذِبٍۢ ۚ","kadhibin","with false blood","মিথ্যা"],["قَالَ","qāla","He said","সে বললো"],["بَلْ","bal","Nay","\"বরং"],["سَوَّلَتْ","sawwalat","has enticed you","সাজিয়ে দিয়েছে"],["لَكُمْ","lakum","has enticed you","তোমাদেরকে"],["أَنفُسُكُمْ","anfusukum","your souls","তোমাদের মন"],["أَمْرًۭا ۖ","amran","(to) a matter","এ কাজ"],["فَصَبْرٌۭ","faṣabrun","so patience","অতএব ধৈর্য ধরাই"],["جَمِيلٌۭ ۖ","jamīlun","(is) beautiful","উত্তম"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহই"],["ٱلْمُسْتَعَانُ","l-mus'ta‘ānu","(is) the One sought for help","সাহায্যস্থল"],["عَلَىٰ","‘alā","against","এক্ষেত্রে"],["مَا","mā","what","যা"],["تَصِفُونَ","taṣifūna","you describe","তোমরা বর্ণনা করছো\""]],"t":"وَ<o>جَآ</>ءُو عَلَىٰ قَمِيصِ<m>هِۦ</> بِدَ<k>مٍۢ كَذِبٍۢ ۚ قَ</>الَ بَلْ سَوَّلَتْ لَكُمْ أَ<k>نفُ</>سُكُمْ أَمْ<k>رًۭا ۖ فَ</>صَ<q>بْ</><k>رٌۭ جَ</>مِي<d>لٌۭ ۖ وَ</><h>ٱ</>للَّهُ <h>ٱ</>لْمُسْتَعَانُ عَلَىٰ مَا تَصِ<p>فُو</>نَ"},{"n":19,"w":[["وَجَآءَتْ","wajāat","And there came","এবং আসলো"],["سَيَّارَةٌۭ","sayyāratun","a caravan","এক যাত্রীদল"],["فَأَرْسَلُوا۟","fa-arsalū","and they sent","অতঃপর তারা পাঠালো"],["وَارِدَهُمْ","wāridahum","their water drawer","তাদের পানি সংগ্রাহককে"],["فَأَدْلَىٰ","fa-adlā","then he let down","সে তখন নামিয়ে দিলো"],["دَلْوَهُۥ ۖ","dalwahu","his bucket","তার বালতি"],["قَالَ","qāla","He said","সে বললো"],["يَـٰبُشْرَىٰ","yābush'rā","O good news","\"কি সুখবর!"],["هَـٰذَا","hādhā","This","এযে"],["غُلَـٰمٌۭ ۚ","ghulāmun","(is) a boy","একটি ছেলে\""],["وَأَسَرُّوهُ","wa-asarrūhu","And they hid him","এবং তাকে লুকালো"],["بِضَـٰعَةًۭ ۚ","biḍā‘atan","(as) a merchandise","পণ্যদ্রব্য হিসেবে"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["عَلِيمٌۢ","‘alīmun","(is) All-Knower","খুবই অবহিত"],["بِمَا","bimā","of what","বিষয়ে যা"],["يَعْمَلُونَ","ya‘malūna","they do","তারা কাজ করছিলো"]],"t":"وَ<o>جَآ</>ءَتْ سَيَّارَ<k>ةٌۭ فَ</>أَرْسَلُو<s>ا۟</> وَارِدَهُمْ فَأَ<q>دْ</>لَىٰ دَلْوَهُ<m>ۥ</> ۖ قَالَ <m>يَٰ</>بُشْرَىٰ <m>هَٰ</>ذَا غُ<m>لَٰ</><d>مٌۭ ۚ وَ</>أَسَرُّوهُ بِ<m>ضَٰ</>عَ<d>ةًۭ ۚ وَ</><h>ٱ</>للَّهُ عَلِي<i>مٌۢ بِ</>مَا يَعْمَ<p>لُو</>نَ"},{"n":20,"w":[["وَشَرَوْهُ","washarawhu","And they sold him","এবং তাকে তারা বিক্রি করে দিলো"],["بِثَمَنٍۭ","bithamanin","for a price","দাম দিয়ে"],["بَخْسٍۢ","bakhsin","very low","সামান্য"],["دَرَٰهِمَ","darāhima","dirhams","দিরহাম"],["مَعْدُودَةٍۢ","ma‘dūdatin","few","কয়েকটি মাত্র"],["وَكَانُوا۟","wakānū","and they were","এবং তারা ছিলো"],["فِيهِ","fīhi","about him","তার (দামের) ব্যাপারে"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلزَّٰهِدِينَ","l-zāhidīna","those keen to give up","নিরাসক্তদের"]],"t":"وَشَرَوْهُ بِثَمَ<i>نٍۭ بَ</>خْ<k>سٍۢ دَ</><m>رَٰ</>هِمَ مَعْدُودَ<d>ةٍۢ وَ</>كَانُو<s>ا۟</> فِيهِ مِنَ <h>ٱ</><l>ل</><m>زَّٰ</>هِ<p>دِي</>نَ"},{"n":21,"w":[["وَقَالَ","waqāla","And said","এবং বললো"],["ٱلَّذِى","alladhī","the one who","যে"],["ٱشْتَرَىٰهُ","ish'tarāhu","bought him","তাকে কিনেছিলো"],["مِن","min","of","থেকে"],["مِّصْرَ","miṣ'ra","Egypt","মিশর"],["لِٱمْرَأَتِهِۦٓ","li-im'ra-atihi","to his wife","তার স্ত্রীকে"],["أَكْرِمِى","akrimī","Make comfortable","\"সম্মানজনক ব্যবস্থা করো"],["مَثْوَىٰهُ","mathwāhu","his stay","তার থাকার"],["عَسَىٰٓ","‘asā","Perhaps","আশা করা যায়"],["أَن","an","that","যে"],["يَنفَعَنَآ","yanfa‘anā","(he) will benefit us","আমাদের সে উপকারে আসবে"],["أَوْ","aw","or","অথবা"],["نَتَّخِذَهُۥ","nattakhidhahu","we will take him","তাকে আমরা গ্রহণ করবো"],["وَلَدًۭا ۚ","waladan","(as) a son","পুত্র হিসাবে\""],["وَكَذَٰلِكَ","wakadhālika","And thus","এবং এভাবে"],["مَكَّنَّا","makkannā","We established","আমরা প্রতিষ্ঠিত করলাম"],["لِيُوسُفَ","liyūsufa","Yusuf","ইউসুফকে"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the land","(সে) দেশের"],["وَلِنُعَلِّمَهُۥ","walinu‘allimahu","that We might teach him","এবং আমরা যেন তাকে শিক্ষা দিতে পারি"],["مِن","min","(the) interpretation of","থেকে"],["تَأْوِيلِ","tawīli","(the) interpretation of","ব্যখ্যা"],["ٱلْأَحَادِيثِ ۚ","l-aḥādīthi","the events","স্বপ্নের"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["غَالِبٌ","ghālibun","(is) Predominant","অপ্রতিহত"],["عَلَىٰٓ","‘alā","over","ক্ষেত্রে"],["أَمْرِهِۦ","amrihi","His affairs","তাঁর কাজের"],["وَلَـٰكِنَّ","walākinna","but","কিন্তু"],["أَكْثَرَ","akthara","most","অধিকাংশ"],["ٱلنَّاسِ","l-nāsi","(of) the people","মানুষ"],["لَا","lā","(do) not","না"],["يَعْلَمُونَ","ya‘lamūna","know","তারা জানে"]],"t":"وَقَالَ <h>ٱ</>لَّذِى <h>ٱ</>شْتَرَ<m>ىٰ</>هُ <d>مِن مِّ</>صْرَ لِ<h>ٱ</>مْرَأَتِ<o>هِۦٓ</> أَكْرِمِى مَثْوَ<m>ىٰ</>هُ عَسَ<o>ىٰٓ</> <d>أَن يَ</><k>نفَ</>عَ<o>نَآ</> أَوْ نَتَّخِذَهُ<m>ۥ</> وَلَ<d>دًۭا ۚ وَ</>كَ<m>ذَٰ</>لِكَ مَكَّ<g>نَّ</>ا لِيُوسُفَ فِى <h>ٱ</>لْأَرْضِ وَلِنُعَلِّمَهُ<m>ۥ</> مِ<k>ن تَ</>أْوِيلِ <h>ٱ</>لْأَحَادِيثِ ۚ وَ<h>ٱ</>للَّهُ غَالِبٌ عَلَ<o>ىٰٓ</> أَمْرِ<m>هِۦ</> وَ<m>لَٰ</>كِ<g>نَّ</> أَكْثَرَ <h>ٱ</><l>ل</><g>نَّ</>اسِ لَا يَعْلَ<p>مُو</>نَ"},{"n":22,"w":[["وَلَمَّا","walammā","And when","এবং যখন"],["بَلَغَ","balagha","he reached","সে পৌঁছলো"],["أَشُدَّهُۥٓ","ashuddahu","his maturity","তার যৌবনে"],["ءَاتَيْنَـٰهُ","ātaynāhu","We gave him","তাকে আমরা দিলাম"],["حُكْمًۭا","ḥuk'man","wisdom","প্রজ্ঞা"],["وَعِلْمًۭا ۚ","wa‘il'man","and knowledge","ও জ্ঞান"],["وَكَذَٰلِكَ","wakadhālika","And thus","এবং এভাবে"],["نَجْزِى","najzī","We reward","প্রতিফল দিই আমরা"],["ٱلْمُحْسِنِينَ","l-muḥ'sinīna","the good-doers","সৎকর্মশীললোকদেরকে"]],"t":"وَلَ<g>مَّ</>ا بَلَغَ أَشُدَّهُ<o>ۥٓ</> ءَاتَيْ<m>نَٰ</>هُ حُكْ<d>مًۭا وَ</>عِلْ<d>مًۭا ۚ وَ</>كَ<m>ذَٰ</>لِكَ نَ<q>جْ</>زِى <h>ٱ</>لْمُحْسِ<p>نِي</>نَ"},{"n":23,"w":[["وَرَٰوَدَتْهُ","warāwadathu","And sought to seduce him","এবং তাকে ফুসলিয়েছিলো"],["ٱلَّتِى","allatī","she who","(সেই মহিলা) যার"],["هُوَ","huwa","he (was)","সে (ছিলো)"],["فِى","fī","in","মধ্যে"],["بَيْتِهَا","baytihā","her house","তার ঘরের"],["عَن","‘an","from","প্রতি"],["نَّفْسِهِۦ","nafsihi","his self","তার নিজের (আত্মসংবরণ)"],["وَغَلَّقَتِ","waghallaqati","And she closed","এবং বন্ধ করলো (মহিলাটি)"],["ٱلْأَبْوَٰبَ","l-abwāba","the doors","দরজাগুলো"],["وَقَالَتْ","waqālat","and she said","এবং বললো"],["هَيْتَ","hayta","Come on","\"চলে এসো"],["لَكَ ۚ","laka","you","তোমাকে বলছি\""],["قَالَ","qāla","He said","সে বললো"],["مَعَاذَ","ma‘ādha","I seek refuge in Allah","\"আশ্রয় চাই"],["ٱللَّهِ ۖ","l-lahi","I seek refuge in Allah","\"আল্লাহর"],["إِنَّهُۥ","innahu","Indeed, he","নিশ্চয়ই তিনি"],["رَبِّىٓ","rabbī","(is) my lord","আমার রব"],["أَحْسَنَ","aḥsana","(who has) made good","উত্তম ব্যবস্হা করেছেন"],["مَثْوَاىَ ۖ","mathwāya","my stay","আমার বসবাসের"],["إِنَّهُۥ","innahu","Indeed","নিশ্চয়ই"],["لَا","lā","not","না"],["يُفْلِحُ","yuf'liḥu","will succeed","সফল হয়"],["ٱلظَّـٰلِمُونَ","l-ẓālimūna","the wrongdoers","সীমালঙ্ঘনকারীরা\""]],"t":"وَ<m>رَٰ</>وَدَتْهُ <h>ٱ</>لَّتِى هُوَ فِى بَيْتِهَا <d>عَن نَّ</>فْسِ<m>هِۦ</> وَغَلَّقَتِ <h>ٱ</>لْأَ<q>بْ</><m>وَٰ</>بَ وَقَالَتْ هَيْتَ لَكَ ۚ قَالَ مَعَاذَ <h>ٱ</>للَّهِ ۖ إِ<g>نَّ</>هُ<m>ۥ</> رَ<o>بِّىٓ</> أَحْسَنَ مَثْوَاىَ ۖ إِ<g>نَّ</>هُ<m>ۥ</> لَا يُفْلِحُ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مُو</>نَ"},{"n":24,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["هَمَّتْ","hammat","she did desire","আসক্ত হয়েছিলো (সে মহিলা)"],["بِهِۦ ۖ","bihi","him","প্রতি তার"],["وَهَمَّ","wahamma","and he would have desired","এবং সেও আসক্ত হতো"],["بِهَا","bihā","her","প্রতি তার"],["لَوْلَآ","lawlā","if not","যদি না"],["أَن","an","that","যে"],["رَّءَا","raā","he saw","সে দেখতো"],["بُرْهَـٰنَ","bur'hāna","the proof","নিদর্শন"],["رَبِّهِۦ ۚ","rabbihi","(of) his Lord","তার রবের"],["كَذَٰلِكَ","kadhālika","Thus","এভাবে (ঘটলো)"],["لِنَصْرِفَ","linaṣrifa","that We might avert","যেন আমরা ফিরিয়ে রাখি"],["عَنْهُ","‘anhu","from him","তার থেকে"],["ٱلسُّوٓءَ","l-sūa","the evil","মন্দ"],["وَٱلْفَحْشَآءَ ۚ","wal-faḥshāa","and the immorality","ও অশ্লীলতা"],["إِنَّهُۥ","innahu","Indeed, he","নিশ্চয়ই সে (ছিলো)"],["مِنْ","min","(was) of","অন্তর্ভুক্ত"],["عِبَادِنَا","‘ibādinā","Our slaves","আমাদের দাসদের"],["ٱلْمُخْلَصِينَ","l-mukh'laṣīna","the sincere","(যারা ছিলো) বিশুদ্ধ চিত্ত"]],"t":"وَلَقَ<q>دْ</> هَ<g>مَّ</>تْ بِ<m>هِۦ</> ۖ وَهَ<g>مَّ</> بِهَا لَوْ<o>لَآ</> <w>أَن رَّ</>ءَا بُرْ<m>هَٰ</>نَ رَبِّ<m>هِۦ</> ۚ كَ<m>ذَٰ</>لِكَ لِنَصْرِفَ عَنْهُ <h>ٱ</><l>ل</><o>سُّوٓ</>ءَ وَ<h>ٱ</>لْفَحْ<o>شَآ</>ءَ ۚ إِ<g>نَّ</>هُ<m>ۥ</> مِنْ عِبَادِنَا <h>ٱ</>لْمُخْلَ<p>صِي</>نَ"},{"n":25,"w":[["وَٱسْتَبَقَا","wa-is'tabaqā","And they both raced","এবং উভয়ে দৌঁড়ে গেলো"],["ٱلْبَابَ","l-bāba","(to) the door","দরজার দিকে"],["وَقَدَّتْ","waqaddat","and she tore","এবং (রমণী) সে ছিঁড়ে ফেললো"],["قَمِيصَهُۥ","qamīṣahu","his shirt","তার জামা"],["مِن","min","from","থেকে"],["دُبُرٍۢ","duburin","the back","পিছন"],["وَأَلْفَيَا","wa-alfayā","and they both found","এবং উভয়ে পেলো"],["سَيِّدَهَا","sayyidahā","her husband","তার স্বামীকে"],["لَدَا","ladā","at","কাছে"],["ٱلْبَابِ ۚ","l-bābi","the door","দরজার"],["قَالَتْ","qālat","She said","(রমনী) সে বললো"],["مَا","mā","What","\"কি"],["جَزَآءُ","jazāu","(is) the recompense","শাস্তি (হ'তে পারে)"],["مَنْ","man","(of one) who","যে"],["أَرَادَ","arāda","intended","কামনা করে"],["بِأَهْلِكَ","bi-ahlika","for your wife","সাথে তোমার পরিবারের"],["سُوٓءًا","sūan","evil","কুকর্ম"],["إِلَّآ","illā","except","এ ছাড়া (কি অন্য কিছু)"],["أَن","an","that","যে"],["يُسْجَنَ","yus'jana","he be imprisoned","বন্দী করা হবে"],["أَوْ","aw","or","বা"],["عَذَابٌ","‘adhābun","a punishment","কোন শাস্তি"],["أَلِيمٌۭ","alīmun","painful","নিদারুণ\""]],"t":"وَ<h>ٱ</>سْتَبَقَا <h>ٱ</>لْبَابَ وَقَدَّتْ قَمِيصَهُ<m>ۥ</> مِ<k>ن دُ</>بُ<d>رٍۢ وَ</>أَلْفَيَا سَيِّدَهَا لَدَا <h>ٱ</>لْبَابِ ۚ قَالَتْ مَا جَ<o>زَآ</>ءُ مَنْ أَرَادَ بِأَهْلِكَ <o>سُوٓ</>ءًا إِ<o>لَّآ</> <d>أَن يُ</>سْجَنَ أَوْ عَذَابٌ أَ<p>لِي</>مٌۭ"},{"n":26,"w":[["قَالَ","qāla","He said","(ইউসুফ) বললো"],["هِىَ","hiya","She","\"সে (মহিলা)"],["رَٰوَدَتْنِى","rāwadatnī","sought to seduce me","আমাকে ফুসলিয়েছিলো"],["عَن","‘an","about","হ'তে"],["نَّفْسِى ۚ","nafsī","myself","আমার নিজের (আত্মসংবরণ)\""],["وَشَهِدَ","washahida","And testified","এবং সাক্ষ্য দেয়"],["شَاهِدٌۭ","shāhidun","a witness","এক সাক্ষ্যদাতা"],["مِّنْ","min","of","মধ্য হ'তে"],["أَهْلِهَآ","ahlihā","her family","তার পরিবারের"],["إِن","in","If","\"যদি"],["كَانَ","kāna","[is]","হয়"],["قَمِيصُهُۥ","qamīṣuhu","his shirt","তার জামা"],["قُدَّ","qudda","(is) torn","ছেঁড়া"],["مِن","min","from","থেকে"],["قُبُلٍۢ","qubulin","the front","সামনের দিক"],["فَصَدَقَتْ","faṣadaqat","then she has spoken the truth","তবে সে (রমনী) সত্য বলেছে"],["وَهُوَ","wahuwa","and he","এবং সে (ইউসুফ)"],["مِنَ","mina","(is) of","অন্তর্ভুক্ত"],["ٱلْكَـٰذِبِينَ","l-kādhibīna","the liars","মিথ্যাবাদীদের"]],"t":"قَالَ هِىَ <m>رَٰ</>وَدَتْنِى <d>عَن نَّ</>فْسِى ۚ وَشَهِدَ شَاهِ<d>دٌۭ مِّ</>نْ أَهْلِ<o>هَآ</> إِ<k>ن كَ</>انَ قَمِيصُهُ<m>ۥ</> قُدَّ مِ<k>ن قُبُلٍۢ فَ</>صَدَقَتْ وَهُوَ مِنَ <h>ٱ</>لْ<m>كَٰ</>ذِ<p>بِي</>نَ"},{"n":27,"w":[["وَإِن","wa-in","But if","আর যদি"],["كَانَ","kāna","[is]","হয়"],["قَمِيصُهُۥ","qamīṣuhu","his shirt","তার জামা"],["قُدَّ","qudda","(is) torn","ছেঁড়া"],["مِن","min","from","থেকে"],["دُبُرٍۢ","duburin","(the) back","পিছনের দিক"],["فَكَذَبَتْ","fakadhabat","then she has lied","তবে সে (রমনী) মিথ্যা বলেছে"],["وَهُوَ","wahuwa","and he","এবং সে (ইউসুফ)"],["مِنَ","mina","(is) of","অন্তর্ভুক্ত"],["ٱلصَّـٰدِقِينَ","l-ṣādiqīna","the truthful","সত্যবাদীদের\""]],"t":"وَإِ<k>ن كَ</>انَ قَمِيصُهُ<m>ۥ</> قُدَّ مِ<k>ن دُبُرٍۢ فَ</>كَذَبَتْ وَهُوَ مِنَ <h>ٱ</><l>ل</><m>صَّٰ</>دِ<p>قِي</>نَ"},{"n":28,"w":[["فَلَمَّا","falammā","So when","অতঃপর যখন"],["رَءَا","raā","he saw","দেখলো"],["قَمِيصَهُۥ","qamīṣahu","his shirt","তার জামা"],["قُدَّ","qudda","torn","ছেঁড়া"],["مِن","min","from","হ'তে"],["دُبُرٍۢ","duburin","(the) back","পিছন দিক"],["قَالَ","qāla","he said","গৃহস্বামী বললো"],["إِنَّهُۥ","innahu","Indeed, it","\"তা নিশ্চয়ই"],["مِن","min","(is) of","অন্তর্ভুক্ত"],["كَيْدِكُنَّ ۖ","kaydikunna","your plot","তোমাদের (অর্থাৎ নারীদের) ছলনা"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["كَيْدَكُنَّ","kaydakunna","your plot","তোমাদের ছলনা"],["عَظِيمٌۭ","‘aẓīmun","(is) great","ভয়ানক"]],"t":"فَلَ<g>مَّ</>ا رَءَا قَمِيصَهُ<m>ۥ</> قُدَّ مِ<k>ن دُبُرٍۢ قَ</>الَ إِ<g>نَّ</>هُ<m>ۥ</> مِ<k>ن كَ</>يْدِكُ<g>نَّ</> ۖ إِ<g>نَّ</> كَيْدَكُ<g>نَّ</> عَ<p>ظِي</>مٌۭ"},{"n":29,"w":[["يُوسُفُ","yūsufu","Yusuf","(হে) ইউসুফ"],["أَعْرِضْ","a‘riḍ","turn away","উপেক্ষা করো"],["عَنْ","‘an","from","হ'তে"],["هَـٰذَا ۚ","hādhā","this","এই (ব্যাপার)"],["وَٱسْتَغْفِرِى","wa-is'taghfirī","And ask forgiveness","এবং (হে মহিলা) ক্ষমা চাও"],["لِذَنۢبِكِ ۖ","lidhanbiki","for your sin","তোমার অপরাধের জন্যে"],["إِنَّكِ","innaki","Indeed, you","নিশ্চয়ই তুমি"],["كُنتِ","kunti","are","ছিলে"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْخَاطِـِٔينَ","l-khāṭiīna","the sinful","অপরাধীদের\""]],"t":"يُوسُفُ أَعْرِضْ عَنْ <m>هَٰ</>ذَا ۚ وَ<h>ٱ</>سْتَغْفِرِى لِذَ<i>نۢبِ</>كِ ۖ إِ<g>نَّ</>كِ كُ<k>نتِ</> مِنَ <h>ٱ</>لْخَا<p>طِـِٔي</>نَ"},{"n":30,"w":[["۞ وَقَالَ","waqāla","And said","এবং বললো"],["نِسْوَةٌۭ","nis'watun","women","মহিলারা"],["فِى","fī","in","মধ্যে"],["ٱلْمَدِينَةِ","l-madīnati","the city","শহরের"],["ٱمْرَأَتُ","im'ra-atu","The wife of","\"(যে) স্ত্রী"],["ٱلْعَزِيزِ","l-‘azīzi","Aziz","আযীযের"],["تُرَٰوِدُ","turāwidu","(is) seeking to seduce","ফুসলাচ্ছে"],["فَتَىٰهَا","fatāhā","her slave boy","তার যুবক (দাস)-কে"],["عَن","‘an","about","হ'তে"],["نَّفْسِهِۦ ۖ","nafsihi","himself","তার নিজের (আত্মসংবরণ)"],["قَدْ","qad","indeed","নিশ্চয়ই"],["شَغَفَهَا","shaghafahā","he has impassioned her","তাকে উন্মাদ করেছে"],["حُبًّا ۖ","ḥubban","(with) love","প্রেমে"],["إِنَّا","innā","Indeed, we","নিশ্চয়ই আমরা"],["لَنَرَىٰهَا","lanarāhā","[we] surely see her","অবশ্যই তাকে আমরা দেখছি"],["فِى","fī","in","মধ্যে"],["ضَلَـٰلٍۢ","ḍalālin","an error","বিভ্রান্তির"],["مُّبِينٍۢ","mubīnin","clear","সুস্পষ্ট\""]],"t":"۞ وَقَالَ نِسْوَ<k>ةٌۭ فِ</>ى <h>ٱ</>لْمَدِينَةِ <h>ٱ</>مْرَأَتُ <h>ٱ</>لْعَزِيزِ تُ<m>رَٰ</>وِدُ فَتَ<m>ىٰ</>هَا <d>عَن نَّ</>فْسِ<m>هِۦ</> ۖ قَ<q>دْ</> شَغَفَهَا حُبًّا ۖ إِ<g>نَّ</>ا لَنَرَ<m>ىٰ</>هَا فِى ضَ<m>لَٰ</><d>لٍۢ مُّ</><p>بِي</>نٍۢ"},{"n":31,"w":[["فَلَمَّا","falammā","So when","অতঃপর যখন"],["سَمِعَتْ","sami‘at","she heard","(মহিলা) শুনলো"],["بِمَكْرِهِنَّ","bimakrihinna","of their scheming","সম্বন্ধে তাদের ষড়যন্ত্রেরর কথা"],["أَرْسَلَتْ","arsalat","she sent","মহিলা (লোক) প্রেরণ করলো"],["إِلَيْهِنَّ","ilayhinna","for them","তাদের কাছে"],["وَأَعْتَدَتْ","wa-a‘tadat","and she prepared","ও প্রস্তুত করলো"],["لَهُنَّ","lahunna","for them","তাদের জন্যে"],["مُتَّكَـًۭٔا","muttaka-an","a banquet","(হেলান দিয়ে) বসার আসন"],["وَءَاتَتْ","waātat","and she gave","ও দিলো"],["كُلَّ","kulla","each","ব্যক্তিকে"],["وَٰحِدَةٍۢ","wāḥidatin","one","প্রত্যেক"],["مِّنْهُنَّ","min'hunna","of them","তাদের মধ্যকার"],["سِكِّينًۭا","sikkīnan","a knife","একটি করে ছুরি (ফল কেটে খেতে)"],["وَقَالَتِ","waqālati","and she said","এবং বললো (ইউসুফকে)"],["ٱخْرُجْ","ukh'ruj","Come out","\"বের হও"],["عَلَيْهِنَّ ۖ","‘alayhinna","before them","সামনে তাদের\""],["فَلَمَّا","falammā","Then when","অতঃপর যখন"],["رَأَيْنَهُۥٓ","ra-aynahu","they saw him","তাকে তারা দেখলো"],["أَكْبَرْنَهُۥ","akbarnahu","they greatly admired him","তারা অভিভূত হলো"],["وَقَطَّعْنَ","waqaṭṭa‘na","and cut","ও তারা কেটে ফেললো"],["أَيْدِيَهُنَّ","aydiyahunna","their hands","(ফলের পরিবর্তে) তাদের হাত"],["وَقُلْنَ","waqul'na","they said","ও তারা বললো"],["حَـٰشَ","ḥāsha","Forbid","\"মহিমা"],["لِلَّهِ","lillahi","Allah","জন্যে আল্লাহর"],["مَا","mā","not","নয়"],["هَـٰذَا","hādhā","(is) this","এতো"],["بَشَرًا","basharan","a man","মানুষ"],["إِنْ","in","not","নয়"],["هَـٰذَآ","hādhā","(is) this","এতো"],["إِلَّا","illā","but","এ ছাড়া"],["مَلَكٌۭ","malakun","an angel","ফেরেশতা"],["كَرِيمٌۭ","karīmun","noble","সম্মানিত\""]],"t":"فَلَ<g>مَّ</>ا سَمِعَتْ بِمَكْرِهِ<g>نَّ</> أَرْسَلَتْ إِلَيْهِ<g>نَّ</> وَأَعْتَدَتْ لَهُ<g>نَّ</> مُتَّ<d>كَـًۭٔا وَ</>ءَاتَتْ كُلَّ <m>وَٰ</>حِدَ<d>ةٍۢ مِّ</>نْهُ<g>نَّ</> سِكِّي<d>نًۭا وَ</>قَالَتِ <h>ٱ</>خْرُ<q>جْ</> عَلَيْهِ<g>نَّ</> ۖ فَلَ<g>مَّ</>ا رَأَيْنَهُ<o>ۥٓ</> أَكْبَرْنَهُ<m>ۥ</> وَقَطَّعْنَ أَيْدِيَهُ<g>نَّ</> وَقُلْنَ <m>حَٰ</>شَ لِلَّهِ مَا <m>هَٰ</>ذَا بَشَرًا إِنْ <m>هَٰ</><o>ذَآ</> إِلَّا مَلَ<k>كٌۭ كَ</><p>رِي</>مٌۭ"},{"n":32,"w":[["قَالَتْ","qālat","She said","সে বললো"],["فَذَٰلِكُنَّ","fadhālikunna","That","\"অতঃপর এ-ই সে"],["ٱلَّذِى","alladhī","(is) the one","যার (যুবক)"],["لُمْتُنَّنِى","lum'tunnanī","you blamed me","আমাকে তোমরা নিন্দা করেছো"],["فِيهِ ۖ","fīhi","about him","ব্যাপারে"],["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["رَٰوَدتُّهُۥ","rāwadttuhu","I sought to seduce him","তাকে আমি ফুসলিয়েছি"],["عَن","‘an","[from]","হ'তে"],["نَّفْسِهِۦ","nafsihi","[himself]","তার নিজের (আত্মসংবরণ)"],["فَٱسْتَعْصَمَ ۖ","fa-is'ta‘ṣama","but he saved himself","তবুও সে নিজেকে পবিত্র রেখেছে"],["وَلَئِن","wala-in","and if","এবং অবশ্যই যদি"],["لَّمْ","lam","not","না"],["يَفْعَلْ","yaf‘al","he does","সে করে"],["مَآ","mā","what","তা যা"],["ءَامُرُهُۥ","āmuruhu","I order him","তাকে নির্দেশ দিই আমি"],["لَيُسْجَنَنَّ","layus'jananna","surely, he will be imprisoned","অবশ্যই সে কারারুদ্ধ হবে"],["وَلَيَكُونًۭا","walayakūnan","and certainly will be","এবং অবশ্যই সে হবে"],["مِّنَ","mina","of","অন্তর্ভুক্ত"],["ٱلصَّـٰغِرِينَ","l-ṣāghirīna","those who are disgraced","লাঞ্ছিতদের"]],"t":"قَالَتْ فَ<m>ذَٰ</>لِكُ<g>نَّ</> <h>ٱ</>لَّذِى لُمْتُ<g>نَّ</>نِى فِيهِ ۖ وَلَقَ<q>دْ</> <m>رَٰ</>وَ<j>د</>تُّهُ<m>ۥ</> <d>عَن نَّ</>فْسِ<m>هِۦ</> فَ<h>ٱ</>سْتَعْصَمَ ۖ وَلَ<w>ئِن لَّ</>مْ يَفْعَلْ <o>مَآ</> ءَامُرُهُ<m>ۥ</> لَيُسْجَنَ<g>نَّ</> وَلَيَكُو<d>نًۭا مِّ</>نَ <h>ٱ</><l>ل</><m>صَّٰ</>غِ<p>رِي</>نَ"},{"n":33,"w":[["قَالَ","qāla","He said","(ইউসুফ) বললো"],["رَبِّ","rabbi","My Lord","\"হে আমার রব"],["ٱلسِّجْنُ","l-sij'nu","the prison","কারাগারই"],["أَحَبُّ","aḥabbu","(is) dearer","অধিক প্রিয়"],["إِلَىَّ","ilayya","to me","আমার কাছে"],["مِمَّا","mimmā","than what","তা হ'তে"],["يَدْعُونَنِىٓ","yad‘ūnanī","they invite me","আমাকে তারা ডাকছে"],["إِلَيْهِ ۖ","ilayhi","to it","যার দিকে"],["وَإِلَّا","wa-illā","And unless","এবং যদি না (হে রব)"],["تَصْرِفْ","taṣrif","You turn away","তুমি ফিরাও"],["عَنِّى","‘annī","from me","আমার থেকে"],["كَيْدَهُنَّ","kaydahunna","their plot","তাদের ছলনা (তাহ'লে হয়তো)"],["أَصْبُ","aṣbu","I might incline","আকৃষ্ট হয়ে পড়বো আমি"],["إِلَيْهِنَّ","ilayhinna","towards them","তাদের দিকে"],["وَأَكُن","wa-akun","and [I] be","এবং আমি হবো"],["مِّنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْجَـٰهِلِينَ","l-jāhilīna","the ignorant","অজ্ঞদের\""]],"t":"قَالَ رَبِّ <h>ٱ</><l>ل</>سِّ<q>جْ</>نُ أَحَبُّ إِلَىَّ مِ<g>مَّ</>ا يَ<q>دْ</>عُونَ<o>نِىٓ</> إِلَيْهِ ۖ وَإِلَّا تَصْرِفْ عَ<g>نِّ</>ى كَيْدَهُ<g>نَّ</> أَصْبُ إِلَيْهِ<g>نَّ</> وَأَ<d>كُن مِّ</>نَ <h>ٱ</>لْ<m>جَٰ</>هِ<p>لِي</>نَ"},{"n":34,"w":[["فَٱسْتَجَابَ","fa-is'tajāba","So responded","অতঃপর সাড়া দিলেন"],["لَهُۥ","lahu","to him","তার জন্যে"],["رَبُّهُۥ","rabbuhu","his Lord","তার রব"],["فَصَرَفَ","faṣarafa","and turned away","অতঃপর ফিরালেন"],["عَنْهُ","‘anhu","from him","তার থেকে"],["كَيْدَهُنَّ ۚ","kaydahunna","their plot","তাদের ছলনা"],["إِنَّهُۥ","innahu","Indeed, [He]","নিশ্চয়ই তিনি"],["هُوَ","huwa","He","তিনিই"],["ٱلسَّمِيعُ","l-samī‘u","(is) All-Hearer","সব কিছু শুনেন"],["ٱلْعَلِيمُ","l-‘alīmu","All-Knower","সব কিছু জানেন"]],"t":"فَ<h>ٱ</>سْتَجَابَ لَهُ<m>ۥ</> رَبُّهُ<m>ۥ</> فَصَرَفَ عَنْهُ كَيْدَهُ<g>نَّ</> ۚ إِ<g>نَّ</>هُ<m>ۥ</> هُوَ <h>ٱ</><l>ل</>سَّمِيعُ <h>ٱ</>لْعَ<p>لِي</>مُ"},{"n":35,"w":[["ثُمَّ","thumma","Then","এরপর"],["بَدَا","badā","(it) appeared","প্রকাশ পেলো"],["لَهُم","lahum","to them","তাদের কাছে"],["مِّنۢ","min","after","থেকে"],["بَعْدِ","ba‘di","after","এরপর"],["مَا","mā","[what]","যা কিছু"],["رَأَوُا۟","ra-awū","they had seen","তারা দেখেছিলো"],["ٱلْـَٔايَـٰتِ","l-āyāti","the signs","নিদর্শনগুলো (তবুও ভাবলো)"],["لَيَسْجُنُنَّهُۥ","layasjununnahu","surely they should imprison him","অবশ্যই তাকে কারারুদ্ধ করা হবে"],["حَتَّىٰ","ḥattā","until","পর্যন্ত"],["حِينٍۢ","ḥīnin","a time","কিছু সময়"]],"t":"ثُ<g>مَّ</> بَدَا لَ<y>هُم مِّ</><i>نۢ بَ</>عْدِ مَا رَأَوُ<s>ا۟</> <h>ٱ</>لْءَا<m>يَٰ</>تِ لَيَسْجُنُ<g>نَّ</>هُ<m>ۥ</> حَتَّىٰ <p>حِي</>نٍۢ"},{"n":36,"w":[["وَدَخَلَ","wadakhala","And entered","এবং (কারাবাসকালে) (একবার) প্রবেশ করলো"],["مَعَهُ","ma‘ahu","with him","সঙ্গে তার"],["ٱلسِّجْنَ","l-sij'na","(in) the prison","কারাগারে"],["فَتَيَانِ ۖ","fatayāni","two young men","দু'জন যুবক"],["قَالَ","qāla","Said","(ইউসুফকে) বললো"],["أَحَدُهُمَآ","aḥaduhumā","one of them","তাদের দু'জনার একজন"],["إِنِّىٓ","innī","Indeed, I","\"নিশ্চয়ই আমি"],["أَرَىٰنِىٓ","arānī","[I] see myself","স্বপ্নে দেখেছি"],["أَعْصِرُ","a‘ṣiru","pressing","নিংড়ে বের করছি আমি"],["خَمْرًۭا ۖ","khamran","wine","মদ\""],["وَقَالَ","waqāla","And said","এবং বললো"],["ٱلْـَٔاخَرُ","l-ākharu","the other","অপরজন"],["إِنِّىٓ","innī","Indeed, I","\"নিশ্চয়ই আমি"],["أَرَىٰنِىٓ","arānī","[I] see myself","স্বপ্নে দেখেছি"],["أَحْمِلُ","aḥmilu","[I am] carrying","বহন করছি"],["فَوْقَ","fawqa","over","উপর"],["رَأْسِى","rasī","my head","আমার মাথার"],["خُبْزًۭا","khub'zan","bread","রুটি"],["تَأْكُلُ","takulu","(were) eating","খাচ্ছে"],["ٱلطَّيْرُ","l-ṭayru","the birds","পাখি"],["مِنْهُ ۖ","min'hu","from it","তা থেকে"],["نَبِّئْنَا","nabbi'nā","Inform us","বলে দিন আমাদেরকে"],["بِتَأْوِيلِهِۦٓ ۖ","bitawīlihi","of its interpretation","সম্পর্কে তার ব্যাখ্যা"],["إِنَّا","innā","indeed, we","নিশ্চয়ই আমরা"],["نَرَىٰكَ","narāka","[we] see you","আপনাকে দেখছি আমরা"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْمُحْسِنِينَ","l-muḥ'sinīna","the good-doers","সৎকর্মশীলদের\""]],"t":"وَدَخَلَ مَعَهُ <h>ٱ</><l>ل</>سِّ<q>جْ</>نَ فَتَيَانِ ۖ قَالَ أَحَدُهُ<o>مَآ</> إِ<g>نِّ</><o>ىٓ</> أَرَ<m>ىٰ</><o>نِىٓ</> أَعْصِرُ خَمْ<d>رًۭا ۖ وَ</>قَالَ <h>ٱ</>لْءَاخَرُ إِ<g>نِّ</><o>ىٓ</> أَرَ<m>ىٰ</><o>نِىٓ</> أَحْمِلُ فَوْقَ رَأْسِى خُ<q>بْ</><k>زًۭا تَ</>أْكُلُ <h>ٱ</><l>ل</>طَّيْرُ مِنْهُ ۖ نَبِّئْنَا بِتَأْوِيلِ<o>هِۦٓ ۖ</> إِ<g>نَّ</>ا نَرَ<m>ىٰ</>كَ مِنَ <h>ٱ</>لْمُحْسِ<p>نِي</>نَ"},{"n":37,"w":[["قَالَ","qāla","He said","সে বললো"],["لَا","lā","Not","\"না"],["يَأْتِيكُمَا","yatīkumā","(will) come to both of you","তোমাদের দু'জনের কাছে আসবে"],["طَعَامٌۭ","ṭa‘āmun","food","খাবার"],["تُرْزَقَانِهِۦٓ","tur'zaqānihi","you are provided with","যা দু'জনকে খাদ্য দেয়া হয়"],["إِلَّا","illā","but","এছাড়া যে"],["نَبَّأْتُكُمَا","nabbatukumā","I will inform both of you","তোমাদের দু'জনকে আমি বলে দিবো"],["بِتَأْوِيلِهِۦ","bitawīlihi","of its interpretation","সম্পর্কে তার ব্যখ্যা"],["قَبْلَ","qabla","before","পূর্বেই"],["أَن","an","[that]","যে"],["يَأْتِيَكُمَا ۚ","yatiyakumā","[it] comes to both of you","তোমাদের দু'জনের কাছে আসবে"],["ذَٰلِكُمَا","dhālikumā","That","এটা তোমাদের (বলবো)"],["مِمَّا","mimmā","(is) of what","তা হ'তে যা"],["عَلَّمَنِى","‘allamanī","has taught me","আমাকে শিখিয়েছেন"],["رَبِّىٓ ۚ","rabbī","my Lord","আমার রব"],["إِنِّى","innī","Indeed, I","নিশ্চয়ই আমি"],["تَرَكْتُ","taraktu","[I] abandon","আমি বর্জন করেছি"],["مِلَّةَ","millata","(the) religion","ধর্মসমাজ"],["قَوْمٍۢ","qawmin","(of) a people","ঐ জাতির"],["لَّا","lā","not","না"],["يُؤْمِنُونَ","yu'minūna","they believe","(যারা) ঈমান আনে"],["بِٱللَّهِ","bil-lahi","in Allah","উপর আল্লাহর"],["وَهُم","wahum","and they","এবং তারা"],["بِٱلْـَٔاخِرَةِ","bil-ākhirati","in the Hereafter","উপর আখিরাতের"],["هُمْ","hum","[they]","তারাই"],["كَـٰفِرُونَ","kāfirūna","(are) disbelievers","অস্বীকারকারী"]],"t":"قَالَ لَا يَأْتِيكُمَا طَعَا<k>مٌۭ تُ</>رْزَقَانِ<o>هِۦٓ</> إِلَّا نَبَّأْتُكُمَا بِتَأْوِيلِ<m>هِۦ</> قَ<q>بْ</>لَ <d>أَن يَ</>أْتِيَكُمَا ۚ <m>ذَٰ</>لِكُمَا مِ<g>مَّ</>ا عَلَّمَنِى رَ<o>بِّىٓ ۚ</> إِ<g>نِّ</>ى تَرَكْتُ مِلَّةَ قَوْ<w>مٍۢ لَّ</>ا يُؤْمِنُونَ بِ<h>ٱ</>للَّهِ وَ<f>هُم بِ</><h>ٱ</>لْءَاخِرَةِ هُمْ <m>كَٰ</>فِ<p>رُو</>نَ"},{"n":38,"w":[["وَٱتَّبَعْتُ","wa-ittaba‘tu","And I follow","এবং আমি অনুসরণ করেছি"],["مِلَّةَ","millata","(the) religion","আদর্শ"],["ءَابَآءِىٓ","ābāī","(of) my forefathers","আমার পিতৃ-পুরুষদের"],["إِبْرَٰهِيمَ","ib'rāhīma","Ibrahim","(যেমন) ইবরাহীম"],["وَإِسْحَـٰقَ","wa-is'ḥāqa","and Isaac","ও ইসহাক"],["وَيَعْقُوبَ ۚ","waya‘qūba","and Yaqub","ও ইয়াকুবের"],["مَا","mā","Not","নয়"],["كَانَ","kāna","was","সমীচীন"],["لَنَآ","lanā","for us","জন্যে আমাদের"],["أَن","an","that","যে"],["نُّشْرِكَ","nush'rika","we associate","আমরা শরীক করবো"],["بِٱللَّهِ","bil-lahi","with Allah","সাথে আল্লাহর"],["مِن","min","any","কোন"],["شَىْءٍۢ ۚ","shayin","thing","কিছুরই"],["ذَٰلِكَ","dhālika","That","এটা"],["مِن","min","(is) from","অন্যতম"],["فَضْلِ","faḍli","(the) Grace","অনুগ্রহ"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহ্‌র"],["عَلَيْنَا","‘alaynā","upon us","আমাদের উপর"],["وَعَلَى","wa‘alā","and upon","এবং উপর"],["ٱلنَّاسِ","l-nāsi","the mankind","মানুষের"],["وَلَـٰكِنَّ","walākinna","but","কিন্তু"],["أَكْثَرَ","akthara","most","অধিকাংশ"],["ٱلنَّاسِ","l-nāsi","(of) the men","মানুষ"],["لَا","lā","(are) not","না"],["يَشْكُرُونَ","yashkurūna","grateful","কৃতজ্ঞতা প্রকাশ করে"]],"t":"وَ<h>ٱ</>تَّبَعْتُ مِلَّةَ ءَا<o>بَآءِىٓ</> إِ<q>بْ</><m>رَٰ</>هِيمَ وَإِسْ<m>حَٰ</>قَ وَيَعْقُوبَ ۚ مَا كَانَ لَ<o>نَآ</> <d>أَن نُّ</>شْرِكَ بِ<h>ٱ</>للَّهِ مِ<k>ن شَىْءٍۢ ۚ ذَٰ</>لِكَ مِ<k>ن فَ</>ضْلِ <h>ٱ</>للَّهِ عَلَيْنَا وَعَلَى <h>ٱ</><l>ل</><g>نَّ</>اسِ وَ<m>لَٰ</>كِ<g>نَّ</> أَكْثَرَ <h>ٱ</><l>ل</><g>نَّ</>اسِ لَا يَشْكُ<p>رُو</>نَ"},{"n":39,"w":[["يَـٰصَـٰحِبَىِ","yāṣāḥibayi","O my two companions","হে সঙ্গী দু'জন"],["ٱلسِّجْنِ","l-sij'ni","(of) the prison","কারাগারের"],["ءَأَرْبَابٌۭ","a-arbābun","Are lords","কি বহু রব"],["مُّتَفَرِّقُونَ","mutafarriqūna","separate","পৃথক পৃথক"],["خَيْرٌ","khayrun","better","উত্তম"],["أَمِ","ami","or","না কি"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["ٱلْوَٰحِدُ","l-wāḥidu","the One","এক (উত্তম রব)"],["ٱلْقَهَّارُ","l-qahāru","the Irresistible","(যিনি) মহাপরাক্রমশালী"]],"t":"<m>يَٰصَىٰ</>حِبَىِ <h>ٱ</><l>ل</>سِّ<q>جْ</>نِ ءَأَرْبَا<d>بٌۭ مُّ</>تَفَرِّقُونَ خَيْرٌ أَمِ <h>ٱ</>للَّهُ <h>ٱ</>لْ<m>وَٰ</>حِدُ <h>ٱ</>لْقَ<p>هَّا</>رُ"},{"n":40,"w":[["مَا","mā","Not","না"],["تَعْبُدُونَ","ta‘budūna","you worship","তোমরা উপাসনা করছো"],["مِن","min","besides Him","ছেড়ে"],["دُونِهِۦٓ","dūnihi","besides Him","তাকে"],["إِلَّآ","illā","but","এ ছাড়া"],["أَسْمَآءًۭ","asmāan","names","(কিছু) নামের"],["سَمَّيْتُمُوهَآ","sammaytumūhā","which you have named them","যার তোমরা নামকরণ করেছো"],["أَنتُمْ","antum","you","তোমরা"],["وَءَابَآؤُكُم","waābāukum","and your forefathers","ও তোমাদের পিতৃ-পুরুষেরা"],["مَّآ","mā","not","না"],["أَنزَلَ","anzala","(has) sent down","পাঠিয়েছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["بِهَا","bihā","for it","সে সম্বন্ধে"],["مِن","min","any","কোন"],["سُلْطَـٰنٍ ۚ","sul'ṭānin","authority","প্রমাণ"],["إِنِ","ini","Not","নেই (কারও)"],["ٱلْحُكْمُ","l-ḥuk'mu","(is) the command","বিধান দেয়ার অধিকার"],["إِلَّا","illā","but","ছাড়া"],["لِلَّهِ ۚ","lillahi","for Allah","আল্লাহ"],["أَمَرَ","amara","He has commanded","তিনি আদেশ দিয়েছেন"],["أَلَّا","allā","that not","যে না"],["تَعْبُدُوٓا۟","ta‘budū","you worship","তোমরা ইবাদত করো"],["إِلَّآ","illā","but","ছাড়া"],["إِيَّاهُ ۚ","iyyāhu","Him Alone","শুধু (তাঁরই)"],["ذَٰلِكَ","dhālika","That","এটা"],["ٱلدِّينُ","l-dīnu","(is) the religion","ধর্ম"],["ٱلْقَيِّمُ","l-qayimu","the right","সঠিক"],["وَلَـٰكِنَّ","walākinna","but","কিন্তু"],["أَكْثَرَ","akthara","most","অধিকাংশ"],["ٱلنَّاسِ","l-nāsi","[the] men","মানুষ"],["لَا","lā","(do) not","না"],["يَعْلَمُونَ","ya‘lamūna","know","জানে"]],"t":"مَا تَعْبُدُونَ مِ<k>ن دُ</>ونِ<o>هِۦٓ</> إِ<o>لَّآ</> أَسْ<o>مَآ</><k>ءًۭ سَ</><g>مَّ</>يْتُمُو<o>هَآ</> أَ<k>نتُ</>مْ وَءَا<o>بَآ</>ؤُ<y>كُم مَّ</><o>آ</> أَ<k>نزَ</>لَ <h>ٱ</>للَّهُ بِهَا مِ<k>ن سُ</>لْ<m>طَٰ</>نٍ ۚ إِنِ <h>ٱ</>لْحُكْمُ إِلَّا لِلَّهِ ۚ أَمَرَ أَلَّا تَعْبُ<o>دُوٓ</><s>ا۟</> إِ<o>لَّآ</> إِيَّاهُ ۚ <m>ذَٰ</>لِكَ <h>ٱ</><l>ل</>دِّينُ <h>ٱ</>لْقَيِّمُ وَ<m>لَٰ</>كِ<g>نَّ</> أَكْثَرَ <h>ٱ</><l>ل</><g>نَّ</>اسِ لَا يَعْلَ<p>مُو</>نَ"},{"n":41,"w":[["يَـٰصَـٰحِبَىِ","yāṣāḥibayi","O my two companions","হে সঙ্গী দু'জন"],["ٱلسِّجْنِ","l-sij'ni","(of) the prison","কারাগারের"],["أَمَّآ","ammā","As for","(ব্যখ্যা হলো) এ প্রসঙ্গে"],["أَحَدُكُمَا","aḥadukumā","one of you","তোমরা দু'জনের মধ্যে একজনের"],["فَيَسْقِى","fayasqī","he will give drink","সে পান করাবে"],["رَبَّهُۥ","rabbahu","(to) his master","তার প্রভুকে"],["خَمْرًۭا ۖ","khamran","wine","মদ"],["وَأَمَّا","wa-ammā","and as for","আর (ব্যাখ্যা) এ প্রসঙ্গে"],["ٱلْـَٔاخَرُ","l-ākharu","the other","অন্যজনের"],["فَيُصْلَبُ","fayuṣ'labu","he will be crucified","সে শূলবিদ্ধ হবে"],["فَتَأْكُلُ","fatakulu","and will eat","এরপর খাবে"],["ٱلطَّيْرُ","l-ṭayru","the birds","পাখি"],["مِن","min","from","থেকে"],["رَّأْسِهِۦ ۚ","rasihi","his head","তার মাথা"],["قُضِىَ","quḍiya","Has been decreed","সিদ্ধান্ত হয়ে গেছে"],["ٱلْأَمْرُ","l-amru","the matter","বিষয়ের"],["ٱلَّذِى","alladhī","about which","এমন"],["فِيهِ","fīhi","about which","যা সম্বন্ধে"],["تَسْتَفْتِيَانِ","tastaftiyāni","you both inquire","তোমরা দু'জনে জানতে চেয়েছো\""]],"t":"<m>يَٰصَىٰ</>حِبَىِ <h>ٱ</><l>ل</>سِّ<q>جْ</>نِ أَ<g>مَّ</><o>آ</> أَحَدُكُمَا فَيَسْقِى رَبَّهُ<m>ۥ</> خَمْ<d>رًۭا ۖ وَ</>أَ<g>مَّ</>ا <h>ٱ</>لْءَاخَرُ فَيُصْلَبُ فَتَأْكُلُ <h>ٱ</><l>ل</>طَّيْرُ <w>مِن رَّ</>أْسِ<m>هِۦ</> ۚ قُضِىَ <h>ٱ</>لْأَمْرُ <h>ٱ</>لَّذِى فِيهِ تَسْتَفْتِ<p>يَا</>نِ"},{"n":42,"w":[["وَقَالَ","waqāla","And he said","এবং (ইউসুফ) বললো"],["لِلَّذِى","lilladhī","to the one whom","(তাকে) যার ব্যাপারে"],["ظَنَّ","ẓanna","he thought","সে ভেবেছিলো"],["أَنَّهُۥ","annahu","that he","যে সে"],["نَاجٍۢ","nājin","(would be) saved","মুক্তি পাবে"],["مِّنْهُمَا","min'humā","of both of them","তাদের দু'জনের মধ্য হ'তে"],["ٱذْكُرْنِى","udh'kur'nī","Mention me","\"আমার কথা উল্লেখ করবে"],["عِندَ","‘inda","to","কাছে"],["رَبِّكَ","rabbika","your master","তোমার প্রভুর\""],["فَأَنسَىٰهُ","fa-ansāhu","But made him forget","অতঃপর তাকে ভুলিয়েছিলো"],["ٱلشَّيْطَـٰنُ","l-shayṭānu","the Shaitaan","শয়তান"],["ذِكْرَ","dhik'ra","(the) mention","উল্লেখ করতে"],["رَبِّهِۦ","rabbihi","(to) his master","তার প্রভুর কাছে"],["فَلَبِثَ","falabitha","so he remained","অতঃপর সে রয়ে গেলো"],["فِى","fī","in","মধ্যে"],["ٱلسِّجْنِ","l-sij'ni","the prison","কারাগারের"],["بِضْعَ","biḍ'‘a","several","কয়েক"],["سِنِينَ","sinīna","years","বছর (পর্যন্ত)"]],"t":"وَقَالَ لِلَّذِى ظَ<g>نَّ</> أَ<g>نَّ</>هُ<m>ۥ</> نَا<d>جٍۢ مِّ</>نْهُمَا <h>ٱ</>ذْكُرْنِى عِ<k>ندَ</> رَبِّكَ فَأَ<k>نسَ</><m>ىٰ</>هُ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نُ ذِكْرَ رَبِّ<m>هِۦ</> فَلَبِثَ فِى <h>ٱ</><l>ل</>سِّ<q>جْ</>نِ بِضْعَ سِ<p>نِي</>نَ"},{"n":43,"w":[["وَقَالَ","waqāla","And said","এবং বললো"],["ٱلْمَلِكُ","l-maliku","the king","রাজা"],["إِنِّىٓ","innī","Indeed, I","\"নিশ্চয়ই আমি"],["أَرَىٰ","arā","[I] have seen","(স্বপ্নে) দেখেছি"],["سَبْعَ","sab‘a","seven","সাতটি"],["بَقَرَٰتٍۢ","baqarātin","cows","গাভী"],["سِمَانٍۢ","simānin","fat","মোটাসোটা"],["يَأْكُلُهُنَّ","yakuluhunna","eating them","খাচ্ছে তাদের"],["سَبْعٌ","sab‘un","seven","সাতটি"],["عِجَافٌۭ","‘ijāfun","lean ones","শুঁটকো (গাভী)"],["وَسَبْعَ","wasab‘a","and seven","এবং সাতটি"],["سُنۢبُلَـٰتٍ","sunbulātin","ears (of corn)","শীষ"],["خُضْرٍۢ","khuḍ'rin","green","সবুজ"],["وَأُخَرَ","wa-ukhara","and others","এবং (অন্য) সাতটি"],["يَابِسَـٰتٍۢ ۖ","yābisātin","dry","শুকনো"],["يَـٰٓأَيُّهَا","yāayyuhā","O","হে"],["ٱلْمَلَأُ","l-mala-u","chiefs","প্রধানগণ"],["أَفْتُونِى","aftūnī","Explain to me","আমাকে অভিমত দাও"],["فِى","fī","about","ব্যপারে"],["رُءْيَـٰىَ","ru'yāya","my vision","আমার স্বপ্নের"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you can","তোমরা হও (এমন যে)"],["لِلرُّءْيَا","lilrru'yā","of visions","ব্যাপারে আমার স্বপ্নের"],["تَعْبُرُونَ","ta‘burūna","interpret","তোমরা ব্যাখ্যা করতে পারো\""]],"t":"وَقَالَ <h>ٱ</>لْمَلِكُ إِ<g>نِّ</><o>ىٓ</> أَرَىٰ سَ<q>بْ</>عَ بَقَ<m>رَٰ</><k>تٍۢ سِ</>مَا<d>نٍۢ يَ</>أْكُلُهُ<g>نَّ</> سَ<q>بْ</>عٌ عِجَا<d>فٌۭ وَ</>سَ<q>بْ</>عَ سُ<i>نۢبُ</><m>لَٰ</>تٍ خُضْ<d>رٍۢ وَ</>أُخَرَ يَابِ<m>سَٰ</><d>تٍۢ ۖ يَٰٓ</>أَيُّهَا <h>ٱ</>لْمَلَأُ أَفْتُونِى فِى رُءْ<m>يَٰ</>ىَ إِ<k>ن كُنتُ</>مْ لِلرُّءْيَا تَعْبُ<p>رُو</>نَ"},{"n":44,"w":[["قَالُوٓا۟","qālū","They said","তারা বলেছিলো"],["أَضْغَـٰثُ","aḍghāthu","Confused","\"অর্থহীন"],["أَحْلَـٰمٍۢ ۖ","aḥlāmin","dreams","স্বপ্ন"],["وَمَا","wamā","and not","এবং নই"],["نَحْنُ","naḥnu","we","আমরা"],["بِتَأْوِيلِ","bitawīli","(are) in the interpretation","সম্বন্ধে ব্যাখ্যা"],["ٱلْأَحْلَـٰمِ","l-aḥlāmi","(of) the dreams","স্বপ্নের"],["بِعَـٰلِمِينَ","bi‘ālimīna","learned","অভিজ্ঞ\""]],"t":"قَا<o>لُوٓ</><s>ا۟</> أَضْ<m>غَٰ</>ثُ أَحْ<m>لَٰ</><d>مٍۢ ۖ وَ</>مَا نَحْنُ بِتَأْوِيلِ <h>ٱ</>لْأَحْ<m>لَٰ</>مِ بِ<m>عَٰ</>لِ<p>مِي</>نَ"},{"n":45,"w":[["وَقَالَ","waqāla","But said","এবং বললো"],["ٱلَّذِى","alladhī","the one who","যে"],["نَجَا","najā","was saved","মুক্তি পেয়েছিলো"],["مِنْهُمَا","min'humā","of the two","তাদের দু'জনের মধ্য হ'তে"],["وَٱدَّكَرَ","wa-iddakara","and remembered","এবং স্মরণ হলো (ইউসুফের কথা)"],["بَعْدَ","ba‘da","after","পরে"],["أُمَّةٍ","ummatin","a period","দীর্ঘকাল"],["أَنَا۠","anā","I","\"(সে বললো) আমি"],["أُنَبِّئُكُم","unabbi-ukum","[I] will inform you","তোমাদেরকে জানাবো"],["بِتَأْوِيلِهِۦ","bitawīlihi","of its interpretation","সম্বন্ধে তার ব্যখ্যা"],["فَأَرْسِلُونِ","fa-arsilūni","so send me forth","অতএব আমাকে তোমরা পাঠাও (কারাগারে)"]],"t":"وَقَالَ <h>ٱ</>لَّذِى نَجَا مِنْهُمَا وَ<h>ٱ</>دَّكَرَ بَعْدَ أُ<g>مَّ</>ةٍ أَنَا۠ أُنَبِّئُ<f>كُم بِ</>تَأْوِيلِ<m>هِۦ</> فَأَرْسِ<p>لُو</>نِ"},{"n":46,"w":[["يُوسُفُ","yūsufu","Yusuf","(সেখানে পৌঁছে বললো) ইউসুফ"],["أَيُّهَا","ayyuhā","O","হে"],["ٱلصِّدِّيقُ","l-ṣidīqu","the truthful one","সত্যবাদী"],["أَفْتِنَا","aftinā","Explain to us","আমাদের অভিমত দাও"],["فِى","fī","about","(স্বপ্নের) ব্যাপারে"],["سَبْعِ","sab‘i","(the) seven","(এমন যে) সাতটি"],["بَقَرَٰتٍۢ","baqarātin","cows","গাভী"],["سِمَانٍۢ","simānin","fat","মোটাসোটা"],["يَأْكُلُهُنَّ","yakuluhunna","eating them","তাদের খাচ্ছে"],["سَبْعٌ","sab‘un","seven","সাতটি (গাভী)"],["عِجَافٌۭ","‘ijāfun","lean ones","শুঁটকো"],["وَسَبْعِ","wasab‘i","and seven","এবং সাতটি"],["سُنۢبُلَـٰتٍ","sunbulātin","ears (of corn)","শীষ"],["خُضْرٍۢ","khuḍ'rin","green","সবুজ সতেজ"],["وَأُخَرَ","wa-ukhara","and other","এবং অন্য"],["يَابِسَـٰتٍۢ","yābisātin","dry","(সাতটি) শুকনো"],["لَّعَلِّىٓ","la‘allī","that I may","আমি যাতে"],["أَرْجِعُ","arji‘u","return","ফিরে যাই"],["إِلَى","ilā","to","কাছে"],["ٱلنَّاسِ","l-nāsi","the people","লোকদের"],["لَعَلَّهُمْ","la‘allahum","so that they may","তারা যাতে"],["يَعْلَمُونَ","ya‘lamūna","know","জানতে পারে (এর ব্যাখা)\""]],"t":"يُوسُفُ أَيُّهَا <h>ٱ</><l>ل</>صِّدِّيقُ أَفْتِنَا فِى سَ<q>بْ</>عِ بَقَ<m>رَٰ</><k>تٍۢ سِ</>مَا<d>نٍۢ يَ</>أْكُلُهُ<g>نَّ</> سَ<q>بْ</>عٌ عِجَا<d>فٌۭ وَ</>سَ<q>بْ</>عِ سُ<i>نۢبُ</><m>لَٰ</>تٍ خُضْ<d>رٍۢ وَ</>أُخَرَ يَابِ<m>سَٰ</><w>تٍۢ لَّ</>عَ<o>لِّىٓ</> أَرْجِعُ إِلَى <h>ٱ</><l>ل</><g>نَّ</>اسِ لَعَلَّهُمْ يَعْلَ<p>مُو</>نَ"},{"n":47,"w":[["قَالَ","qāla","He said","(ইউসুফ) বললো"],["تَزْرَعُونَ","tazra‘ūna","You will sow","\"তোমরা চাষ করবে"],["سَبْعَ","sab‘a","(for) seven","সাত"],["سِنِينَ","sinīna","years","বছর"],["دَأَبًۭا","da-aban","as usual","একটানা"],["فَمَا","famā","and that which","অতঃপর যা"],["حَصَدتُّمْ","ḥaṣadttum","you reap","তোমরা ফসল কাটবে"],["فَذَرُوهُ","fadharūhu","so leave it","তখন তা তোমরা রেখে দিবে"],["فِى","fī","in","মধ্যে"],["سُنۢبُلِهِۦٓ","sunbulihi","its ears","এর শীষগুলোর"],["إِلَّا","illā","except","ছাড়া"],["قَلِيلًۭا","qalīlan","a little","সামান্য (পরিমাণ)"],["مِّمَّا","mimmā","from which","তা হ'তে যা"],["تَأْكُلُونَ","takulūna","you (will) eat","তোমরা খাবে"]],"t":"قَالَ تَزْرَعُونَ سَ<q>بْ</>عَ سِنِينَ دَأَ<k>بًۭا فَ</>مَا حَصَ<j>د</>تُّمْ فَذَرُوهُ فِى سُ<i>نۢبُ</>لِ<o>هِۦٓ</> إِلَّا قَلِيلًۭ<d>ا مِّ</><g>مَّ</>ا تَأْكُ<p>لُو</>نَ"},{"n":48,"w":[["ثُمَّ","thumma","Then","এরপর"],["يَأْتِى","yatī","will come","আসবে"],["مِنۢ","min","after","থেকে"],["بَعْدِ","ba‘di","after","পর"],["ذَٰلِكَ","dhālika","that","এর"],["سَبْعٌۭ","sab‘un","seven","সাত (বছর)"],["شِدَادٌۭ","shidādun","hard (years)","কঠিন (দুর্ভিক্ষের)"],["يَأْكُلْنَ","yakul'na","(which will) consume","(যখন) তারা খাবে"],["مَا","mā","what","যা"],["قَدَّمْتُمْ","qaddamtum","you advanced","তোমরা জমিয়ে রেখেছো"],["لَهُنَّ","lahunna","for them","তাদের জন্যে"],["إِلَّا","illā","except","ছাড়া"],["قَلِيلًۭا","qalīlan","a little","সামান্য (পরিমাণ)"],["مِّمَّا","mimmā","of what","তা হ'তে যা"],["تُحْصِنُونَ","tuḥ'ṣinūna","you (will) store","তোমরা বাঁচিয়ে রাখবে"]],"t":"ثُ<g>مَّ</> يَأْتِى <i>مِنۢ بَ</>عْدِ <m>ذَٰ</>لِكَ سَ<q>بْ</><k>عٌۭ شِ</>دَا<d>دٌۭ يَ</>أْكُلْنَ مَا قَدَّمْتُمْ لَهُ<g>نَّ</> إِلَّا قَلِيلًۭ<d>ا مِّ</><g>مَّ</>ا تُحْصِ<p>نُو</>نَ"},{"n":49,"w":[["ثُمَّ","thumma","Then","তারপর"],["يَأْتِى","yatī","will come","আসবে"],["مِنۢ","min","after","থেকে"],["بَعْدِ","ba‘di","after","পর"],["ذَٰلِكَ","dhālika","that","এর"],["عَامٌۭ","‘āmun","a year","এক বছর"],["فِيهِ","fīhi","in it","তার মধ্যে"],["يُغَاثُ","yughāthu","will be given abundant rain","প্রচুর বৃষ্টি হবে"],["ٱلنَّاسُ","l-nāsu","the people","মানুষের জন্যে"],["وَفِيهِ","wafīhi","and in it","এবং তার মধ্যে"],["يَعْصِرُونَ","ya‘ṣirūna","they will press","তারা ফলের রস নিংড়াবে\""]],"t":"ثُ<g>مَّ</> يَأْتِى <i>مِنۢ بَ</>عْدِ <m>ذَٰ</>لِكَ عَا<k>مٌۭ فِ</>يهِ يُغَاثُ <h>ٱ</><l>ل</><g>نَّ</>اسُ وَفِيهِ يَعْصِ<p>رُو</>نَ"},{"n":50,"w":[["وَقَالَ","waqāla","And said","এবং (এসব শুনে) বললো"],["ٱلْمَلِكُ","l-maliku","the king","রাজা"],["ٱئْتُونِى","i'tūnī","Bring him to me","\"আমার কাছে আসো\""],["بِهِۦ ۖ","bihi","Bring him to me","\"নিয়ে তাকে\""],["فَلَمَّا","falammā","But when","অতঃপর যখন"],["جَآءَهُ","jāahu","came to him","তার কাছে আসলো"],["ٱلرَّسُولُ","l-rasūlu","the messenger","দূত"],["قَالَ","qāla","he said","(ইউসুফ) বললো"],["ٱرْجِعْ","ir'ji‘","Return","\"তুমি ফিরে যাও"],["إِلَىٰ","ilā","to","কাছে"],["رَبِّكَ","rabbika","your lord","তোমার প্রভুর"],["فَسْـَٔلْهُ","fasalhu","and ask him","অতঃপর তাকে জিজ্ঞেস করো"],["مَا","mā","what","কি (ছিলো)"],["بَالُ","bālu","(is the) case","অবস্থা"],["ٱلنِّسْوَةِ","l-nis'wati","(of) the women","মহিলাদের"],["ٱلَّـٰتِى","allātī","who","যারা"],["قَطَّعْنَ","qaṭṭa‘na","cut","কেটে ফেলেছিলো"],["أَيْدِيَهُنَّ ۚ","aydiyahunna","their hands","তাদের হাতগুলো"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["رَبِّى","rabbī","my Lord","আমার রব"],["بِكَيْدِهِنَّ","bikaydihinna","of their plot","সম্বন্ধে তাদের ছলনা"],["عَلِيمٌۭ","‘alīmun","(is) All-Knower","খুব অবহিত\""]],"t":"وَقَالَ <h>ٱ</>لْمَلِكُ <h>ٱ</>ئْتُونِى بِ<m>هِۦ</> ۖ فَلَ<g>مَّ</>ا <o>جَآ</>ءَهُ <h>ٱ</><l>ل</>رَّسُولُ قَالَ <h>ٱ</>رْجِعْ إِلَىٰ رَبِّكَ فَسْـَٔلْهُ مَا بَالُ <h>ٱ</><l>ل</><g>نِّ</>سْوَةِ <h>ٱ</><m>لَّٰ</>تِى قَطَّعْنَ أَيْدِيَهُ<g>نَّ</> ۚ إِ<g>نَّ</> رَبِّى بِكَيْدِهِ<g>نَّ</> عَ<p>لِي</>مٌۭ"},{"n":51,"w":[["قَالَ","qāla","He said","(বাদশাহ) বললো"],["مَا","mā","What","\"কি (ছিলো)"],["خَطْبُكُنَّ","khaṭbukunna","(was) your affair","হয়েছিলো তোমাদের"],["إِذْ","idh","when","যখন"],["رَٰوَدتُّنَّ","rāwadttunna","you sought to seduce","তোমরা ফুসলিয়েছিলে"],["يُوسُفَ","yūsufa","Yusuf","ইউসুফকে"],["عَن","‘an","from","হ'তে"],["نَّفْسِهِۦ ۚ","nafsihi","himself","তার নিজের (আত্মসংবরণ)\""],["قُلْنَ","qul'na","They said","তারা বললো"],["حَـٰشَ","ḥāsha","Allah forbid","\"পবিত্রতা"],["لِلَّهِ","lillahi","Allah forbid","\"জন্যে আল্লাহর"],["مَا","mā","Not","না"],["عَلِمْنَا","‘alim'nā","we know","আমরা জানি"],["عَلَيْهِ","‘alayhi","about him","মধ্যে তার"],["مِن","min","any","কোন প্রকার"],["سُوٓءٍۢ ۚ","sūin","evil","দোষ\""],["قَالَتِ","qālati","Said","বললো"],["ٱمْرَأَتُ","im'ra-atu","(the) wife","স্ত্রী"],["ٱلْعَزِيزِ","l-‘azīzi","(of) Aziz","আযীযের"],["ٱلْـَٔـٰنَ","l-āna","Now","\"এখন"],["حَصْحَصَ","ḥaṣḥaṣa","(is) manifest","প্রকাশ পেলো"],["ٱلْحَقُّ","l-ḥaqu","the truth","সত্য"],["أَنَا۠","anā","I","আমি"],["رَٰوَدتُّهُۥ","rāwadttuhu","sought to seduce him","তাকে ফুসলিয়েছিলাম"],["عَن","‘an","from","হ'তে"],["نَّفْسِهِۦ","nafsihi","himself","তার নিজের (আত্মসংবরণ)"],["وَإِنَّهُۥ","wa-innahu","and indeed, he","এবং নিশ্চয়ই সে"],["لَمِنَ","lamina","(is) surely of","অবশ্যই অন্তর্ভুক্ত"],["ٱلصَّـٰدِقِينَ","l-ṣādiqīna","the truthful","সত্যবাদীদের"]],"t":"قَالَ مَا خَ<q>طْ</>بُكُ<g>نَّ</> إِذْ <m>رَٰ</>وَ<j>د</>تُّ<g>نَّ</> يُوسُفَ <d>عَن نَّ</>فْسِ<m>هِۦ</> ۚ قُلْنَ <m>حَٰ</>شَ لِلَّهِ مَا عَلِمْنَا عَلَيْهِ مِ<k>ن سُ</><o>وٓ</><k>ءٍۢ ۚ قَ</>الَتِ <h>ٱ</>مْرَأَتُ <h>ٱ</>لْعَزِيزِ <h>ٱ</><m>لْـَٰٔ</>نَ حَصْحَصَ <h>ٱ</>لْحَقُّ أَنَا۠ <m>رَٰ</>وَ<j>د</>تُّهُ<m>ۥ</> <d>عَن نَّ</>فْسِ<m>هِۦ</> وَإِ<g>نَّ</>هُ<m>ۥ</> لَمِنَ <h>ٱ</><l>ل</><m>صَّٰ</>دِ<p>قِي</>نَ"},{"n":52,"w":[["ذَٰلِكَ","dhālika","That","এটা (এজন্যে)"],["لِيَعْلَمَ","liya‘lama","he may know","যেন সে জানে (আযীয)"],["أَنِّى","annī","that I","যে আমি"],["لَمْ","lam","not","নি"],["أَخُنْهُ","akhun'hu","[I] betray him","তার আমি বিশ্বাসঘাতকতা করি"],["بِٱلْغَيْبِ","bil-ghaybi","in secret","(তার) অনুপস্থিতিতে"],["وَأَنَّ","wa-anna","and that","এবং নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَا","lā","(does) not","না"],["يَهْدِى","yahdī","guide","সফল করেন"],["كَيْدَ","kayda","(the) plan","ষড়যন্ত্র"],["ٱلْخَآئِنِينَ","l-khāinīna","(of) the betrayers","বিশ্বাসঘাতকদের\""]],"t":"<m>ذَٰ</>لِكَ لِيَعْلَمَ أَ<g>نِّ</>ى لَمْ أَخُنْهُ بِ<h>ٱ</>لْغَيْبِ وَأَ<g>نَّ</> <h>ٱ</>للَّهَ لَا يَهْدِى كَيْدَ <h>ٱ</>لْ<o>خَآ</>ئِ<p>نِي</>نَ"},{"n":53,"w":[["۞ وَمَآ","wamā","And not","\"এবং না"],["أُبَرِّئُ","ubarri-u","I absolve","নির্দোষ মনে করি"],["نَفْسِىٓ ۚ","nafsī","myself","নিজেকে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلنَّفْسَ","l-nafsa","the soul","মন (নফস)"],["لَأَمَّارَةٌۢ","la-ammāratun","(is) a certain enjoiner","অবশ্যই নির্দেশ দিয়েই থাকে"],["بِٱلسُّوٓءِ","bil-sūi","of evil","মন্দের দিকে"],["إِلَّا","illā","unless","তবে"],["مَا","mā","[that]","যাকে"],["رَحِمَ","raḥima","bestows Mercy","অনুগ্রহ করেন"],["رَبِّىٓ ۚ","rabbī","my Lord","আমার রব (সেটা ভিন্ন কথা)"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["رَبِّى","rabbī","my Lord","আমার রব"],["غَفُورٌۭ","ghafūrun","(is) Oft-Forgiving","ক্ষমাশীল"],["رَّحِيمٌۭ","raḥīmun","Most Merciful","পরম দয়ালু\""]],"t":"۞ وَ<o>مَآ</> أُبَرِّئُ نَفْ<o>سِىٓ ۚ</> إِ<g>نَّ</> <h>ٱ</><l>ل</><g>نَّ</>فْسَ لَأَ<g>مَّ</>ارَ<i>ةٌۢ بِ</><h>ٱ</><l>ل</><o>سُّوٓ</>ءِ إِلَّا مَا رَحِمَ رَ<o>بِّىٓ ۚ</> إِ<g>نَّ</> رَبِّى غَفُو<w>رٌۭ رَّ</><p>حِي</>مٌۭ"},{"n":54,"w":[["وَقَالَ","waqāla","And said","এবং বলল"],["ٱلْمَلِكُ","l-maliku","the king","রাজা"],["ٱئْتُونِى","i'tūnī","Bring him to me","\"আমার কাছে আসো"],["بِهِۦٓ","bihi","Bring him to me","\"নিয়ে তাকে"],["أَسْتَخْلِصْهُ","astakhliṣ'hu","I will select him","তাকে বিশেষভাবে আমি গ্রহণ করবো"],["لِنَفْسِى ۖ","linafsī","for myself","আমার নিজের জন্যে\""],["فَلَمَّا","falammā","Then when","অতঃপর যখন"],["كَلَّمَهُۥ","kallamahu","he spoke to him","তার সাথে কথা বললো"],["قَالَ","qāla","he said","(রাজা) বললো"],["إِنَّكَ","innaka","Indeed, you","\"তুমি নিশ্চয়ই"],["ٱلْيَوْمَ","l-yawma","(are) today","আজ"],["لَدَيْنَا","ladaynā","with us","আমাদের কাছে"],["مَكِينٌ","makīnun","firmly established","মর্যাদাশালী"],["أَمِينٌۭ","amīnun","(and) trusted","বিশ্বস্ত\""]],"t":"وَقَالَ <h>ٱ</>لْمَلِكُ <h>ٱ</>ئْتُونِى بِ<o>هِۦٓ</> أَسْتَخْلِصْهُ لِنَفْسِى ۖ فَلَ<g>مَّ</>ا كَلَّمَهُ<m>ۥ</> قَالَ إِ<g>نَّ</>كَ <h>ٱ</>لْيَوْمَ لَدَيْنَا مَكِينٌ أَ<p>مِي</>نٌۭ"},{"n":55,"w":[["قَالَ","qāla","He said","সে বললো"],["ٱجْعَلْنِى","ij'‘alnī","Appoint me","\"আমাকে নিযুক্ত করুন"],["عَلَىٰ","‘alā","over","উপর"],["خَزَآئِنِ","khazāini","(the) treasuries","ধনভান্ডারের (দায়িত্বের)"],["ٱلْأَرْضِ ۖ","l-arḍi","(of) the land","দেশের"],["إِنِّى","innī","Indeed, I","নিশ্চয়ই আমি"],["حَفِيظٌ","ḥafīẓun","(will be) a guardian","বিশ্বস্তরক্ষক"],["عَلِيمٌۭ","‘alīmun","knowing","সুবিজ্ঞ\""]],"t":"قَالَ <h>ٱ</><q>جْ</>عَلْنِى عَلَىٰ خَ<o>زَآ</>ئِنِ <h>ٱ</>لْأَرْضِ ۖ إِ<g>نِّ</>ى حَفِيظٌ عَ<p>لِي</>مٌۭ"},{"n":56,"w":[["وَكَذَٰلِكَ","wakadhālika","And thus","এবং এভাবে"],["مَكَّنَّا","makkannā","We established","আমরা প্রতিষ্ঠিত করি"],["لِيُوسُفَ","liyūsufa","[to] Yusuf","ইউসুফকে"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the land","(সে) দেশের"],["يَتَبَوَّأُ","yatabawwa-u","to settle","সে বসবাস করতো"],["مِنْهَا","min'hā","therein","তার মধ্যে"],["حَيْثُ","ḥaythu","where ever","যেখানে"],["يَشَآءُ ۚ","yashāu","he willed","সে চাইতো"],["نُصِيبُ","nuṣību","We bestow","ধন্য করি আমরা"],["بِرَحْمَتِنَا","biraḥmatinā","Our Mercy","দিয়ে আমাদের দয়া"],["مَن","man","(on) whom","যাকে"],["نَّشَآءُ ۖ","nashāu","We will","আমরা চাই"],["وَلَا","walā","And not","এবং না"],["نُضِيعُ","nuḍī‘u","We let go waste","নষ্ট করি আমরা"],["أَجْرَ","ajra","(the) reward","কর্মফল"],["ٱلْمُحْسِنِينَ","l-muḥ'sinīna","(of) the good-doers","সৎকর্মশীলদের"]],"t":"وَكَ<m>ذَٰ</>لِكَ مَكَّ<g>نَّ</>ا لِيُوسُفَ فِى <h>ٱ</>لْأَرْضِ يَتَبَوَّأُ مِنْهَا حَيْثُ يَ<o>شَآ</>ءُ ۚ نُصِيبُ بِرَحْمَتِنَا <d>مَن نَّ</><o>شَآ</>ءُ ۖ وَلَا نُضِيعُ أَ<q>جْ</>رَ <h>ٱ</>لْمُحْسِ<p>نِي</>نَ"},{"n":57,"w":[["وَلَأَجْرُ","wala-ajru","And surely (the) reward","এবং অবশ্যই পুরস্কার (রয়েছে)"],["ٱلْـَٔاخِرَةِ","l-ākhirati","(of) the Hereafter","আখিরাতের"],["خَيْرٌۭ","khayrun","(is) better","উত্তম"],["لِّلَّذِينَ","lilladhīna","for those who","(তাদের) জন্য যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["وَكَانُوا۟","wakānū","and are","ও তারা"],["يَتَّقُونَ","yattaqūna","God conscious","ভয় করে চলতো"]],"t":"وَلَأَ<q>جْ</>رُ <h>ٱ</>لْءَاخِرَةِ خَيْ<w>رٌۭ لِّ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَكَانُو<s>ا۟</> يَتَّ<p>قُو</>نَ"},{"n":58,"w":[["وَجَآءَ","wajāa","And came","এবং আসলো"],["إِخْوَةُ","ikh'watu","(the) brothers","ভাইয়েরা"],["يُوسُفَ","yūsufa","(of) Yusuf","ইউসুফের"],["فَدَخَلُوا۟","fadakhalū","and they entered","অতঃপর তারা প্রবেশ করলো"],["عَلَيْهِ","‘alayhi","upon him","তার কাছে"],["فَعَرَفَهُمْ","fa‘arafahum","and he recognized them","অতঃপর তাদেরকে সে চিনলো"],["وَهُمْ","wahum","but they","অথচ তারা (ছিলো)"],["لَهُۥ","lahu","knew him not","তার সম্পর্কে"],["مُنكِرُونَ","munkirūna","knew him not","অপরিচিত-অজ্ঞাত"]],"t":"وَ<o>جَآ</>ءَ إِخْوَةُ يُوسُفَ فَدَخَلُو<s>ا۟</> عَلَيْهِ فَعَرَفَهُمْ وَهُمْ لَهُ<m>ۥ</> مُ<k>نكِ</><p>رُو</>نَ"},{"n":59,"w":[["وَلَمَّا","walammā","And when","এবং যখন"],["جَهَّزَهُم","jahhazahum","he had furnished them","তাদের প্রস্তুত করলো"],["بِجَهَازِهِمْ","bijahāzihim","with their supplies","দিয়ে তাদের খাদ্যসামগ্রী"],["قَالَ","qāla","he said","সে বললো"],["ٱئْتُونِى","i'tūnī","Bring to me","\"আমার কাছে আসবে তোমরা"],["بِأَخٍۢ","bi-akhin","a brother","নিয়ে ভাইকে"],["لَّكُم","lakum","of yours","তোমাদের"],["مِّنْ","min","from","দিক থেকে"],["أَبِيكُمْ ۚ","abīkum","your father","তোমাদের বাপের (অর্থাৎ বৈমাত্রেয় ভাই)"],["أَلَا","alā","Do not","না কি"],["تَرَوْنَ","tarawna","you see","তোমরা দেখো"],["أَنِّىٓ","annī","that I","যে আমি"],["أُوفِى","ūfī","[I] give full","পুরোপুরি দিই"],["ٱلْكَيْلَ","l-kayla","[the] measure","মাপ"],["وَأَنَا۠","wa-anā","and that I am","এবং আমি"],["خَيْرُ","khayru","(the) best","উত্তম"],["ٱلْمُنزِلِينَ","l-munzilīna","(of) the hosts","অতিথি সমাদরকারী"]],"t":"وَلَ<g>مَّ</>ا جَهَّزَ<f>هُم بِ</>جَهَازِهِمْ قَالَ <h>ٱ</>ئْتُونِى بِأَ<w>خٍۢ لَّ</><y>كُم مِّ</>نْ أَبِيكُمْ ۚ أَلَا تَرَوْنَ أَ<g>نِّ</><o>ىٓ</> أُوفِى <h>ٱ</>لْكَيْلَ وَأَنَا۠ خَيْرُ <h>ٱ</>لْمُ<k>نزِ</><p>لِي</>نَ"},{"n":60,"w":[["فَإِن","fa-in","But if","অতঃপর যদি"],["لَّمْ","lam","not","না"],["تَأْتُونِى","tatūnī","you bring him to me","তোমরা আসো আমার কাছে"],["بِهِۦ","bihi","you bring him to me","নিয়ে তাকে"],["فَلَا","falā","then (there will be) no","তবে নেই"],["كَيْلَ","kayla","measure","মাপ (বরাদ্দ)"],["لَكُمْ","lakum","for you","জন্যে তোমাদের"],["عِندِى","‘indī","from me","আমার কাছে"],["وَلَا","walā","and not","এবং না"],["تَقْرَبُونِ","taqrabūni","you will come near me","তোমরা আমার কাছে আসবে\""]],"t":"فَ<w>إِن لَّ</>مْ تَأْتُونِى بِ<m>هِۦ</> فَلَا كَيْلَ لَكُمْ عِ<k>ندِ</>ى وَلَا تَ<q>قْ</>رَ<p>بُو</>نِ"},{"n":61,"w":[["قَالُوا۟","qālū","They said","তারা বললো"],["سَنُرَٰوِدُ","sanurāwidu","We will try to get permission","\"আমরা শীঘ্রই রাজি করাবো"],["عَنْهُ","‘anhu","for him","তার সম্পর্কে"],["أَبَاهُ","abāhu","(from) his father","তার পিতাকে"],["وَإِنَّا","wa-innā","and indeed we","এবং নিশ্চয়ই আমরা"],["لَفَـٰعِلُونَ","lafā‘ilūna","surely will do","অবশ্যই করবো\""]],"t":"قَالُو<s>ا۟</> سَنُ<m>رَٰ</>وِدُ عَنْهُ أَبَاهُ وَإِ<g>نَّ</>ا لَ<m>فَٰ</>عِ<p>لُو</>نَ"},{"n":62,"w":[["وَقَالَ","waqāla","And he said","এবং (ইউসুফ) বললো"],["لِفِتْيَـٰنِهِ","lifit'yānihi","to his servants","তার চাকরদেরকে"],["ٱجْعَلُوا۟","ij'‘alū","Put","\"তোমরা রেখে দাও"],["بِضَـٰعَتَهُمْ","biḍā‘atahum","their merchandise","তাদের পণ্য (দাম)"],["فِى","fī","in","মধ্যে"],["رِحَالِهِمْ","riḥālihim","their saddlebags","তাদের মালপত্রের"],["لَعَلَّهُمْ","la‘allahum","so that they","তারা যাতে"],["يَعْرِفُونَهَآ","ya‘rifūnahā","may recognize it","তা জানতে পারে"],["إِذَا","idhā","when","যখন"],["ٱنقَلَبُوٓا۟","inqalabū","they go back","তারা ফিরবে"],["إِلَىٰٓ","ilā","to","কাছে"],["أَهْلِهِمْ","ahlihim","their people","তার পরিবারের"],["لَعَلَّهُمْ","la‘allahum","so that they may","তারা সম্ভবত"],["يَرْجِعُونَ","yarji‘ūna","return","ফিরে আসবে (আবার)\""]],"t":"وَقَالَ لِفِتْ<m>يَٰ</>نِهِ <h>ٱ</><q>جْ</>عَلُو<s>ا۟</> بِ<m>ضَٰ</>عَتَهُمْ فِى رِحَالِهِمْ لَعَلَّهُمْ يَعْرِفُونَ<o>هَآ</> إِذَا <h>ٱ</><k>نقَ</>لَ<o>بُوٓ</><s>ا۟</> إِلَ<o>ىٰٓ</> أَهْلِهِمْ لَعَلَّهُمْ يَرْجِ<p>عُو</>نَ"},{"n":63,"w":[["فَلَمَّا","falammā","So when","অতঃপর যখন"],["رَجَعُوٓا۟","raja‘ū","they returned","তারা ফিরে গেলো"],["إِلَىٰٓ","ilā","to","কাছে"],["أَبِيهِمْ","abīhim","their father","তার পিতার"],["قَالُوا۟","qālū","they said","তারা বললো"],["يَـٰٓأَبَانَا","yāabānā","O our father","\"হে আমাদের পিতা"],["مُنِعَ","muni‘a","Has been denied","বন্ধ করা হয়েছে"],["مِنَّا","minnā","to us","আমাদের থেকে"],["ٱلْكَيْلُ","l-kaylu","the measure","মাপ (অর্থাৎ বরাদ্দ)"],["فَأَرْسِلْ","fa-arsil","so send","অতএব পাঠান"],["مَعَنَآ","ma‘anā","with us","আমাদের সাথে"],["أَخَانَا","akhānā","our brother","আমাদের ভাইকে (যেন)"],["نَكْتَلْ","naktal","(that) we will get measure","বরাদ্দ পাই (পূর্ণ)"],["وَإِنَّا","wa-innā","And indeed, we","এবং নিশ্চয়ই আমরা"],["لَهُۥ","lahu","for him","তার জন্যে"],["لَحَـٰفِظُونَ","laḥāfiẓūna","(will) surely (be) guardians","অবশ্যই (হবো) রক্ষাকারী\""]],"t":"فَلَ<g>مَّ</>ا رَجَ<o>عُوٓ</><s>ا۟</> إِلَ<o>ىٰٓ</> أَبِيهِمْ قَالُو<s>ا۟</> <o>يَٰٓ</>أَبَانَا مُنِعَ مِ<g>نَّ</>ا <h>ٱ</>لْكَيْلُ فَأَرْسِلْ مَعَ<o>نَآ</> أَخَانَا نَكْتَلْ وَإِ<g>نَّ</>ا لَهُ<m>ۥ</> لَ<m>حَٰ</>فِ<p>ظُو</>نَ"},{"n":64,"w":[["قَالَ","qāla","He said","সে বললো"],["هَلْ","hal","Should","\"কি"],["ءَامَنُكُمْ","āmanukum","I entrust you","তোমাদের আমি বিশ্বাস করবো"],["عَلَيْهِ","‘alayhi","with him","তার ব্যাপারে"],["إِلَّا","illā","except","এ ছাড়া"],["كَمَآ","kamā","as","যেমন"],["أَمِنتُكُمْ","amintukum","I entrusted you","আমি বিশ্বাস করেছিলাম তোমাদেরকে"],["عَلَىٰٓ","‘alā","with","ব্যাপারে"],["أَخِيهِ","akhīhi","his brother","তার ভাইয়ের"],["مِن","min","before","থেকে"],["قَبْلُ ۖ","qablu","before","পূর্ব"],["فَٱللَّهُ","fal-lahu","But Allah","তবে আল্লাহই"],["خَيْرٌ","khayrun","(is) the best","উত্তম"],["حَـٰفِظًۭا ۖ","ḥāfiẓan","Guardian","রক্ষণাবেক্ষণকারী"],["وَهُوَ","wahuwa","and He","এবং তিনিই"],["أَرْحَمُ","arḥamu","(is the) Most Merciful","শ্রেষ্ঠ দয়ালু"],["ٱلرَّٰحِمِينَ","l-rāḥimīna","(of) the merciful","দয়াশীলদের (মধ্যে)\""]],"t":"قَالَ هَلْ ءَامَنُكُمْ عَلَيْهِ إِلَّا كَ<o>مَآ</> أَمِ<k>نتُ</>كُمْ عَلَ<o>ىٰٓ</> أَخِيهِ مِ<k>ن قَ</><q>بْ</>لُ ۖ فَ<h>ٱ</>للَّهُ خَيْرٌ <m>حَٰ</>فِ<d>ظًۭا ۖ وَ</>هُوَ أَرْحَمُ <h>ٱ</><l>ل</><m>رَّٰ</>حِ<p>مِي</>نَ"},{"n":65,"w":[["وَلَمَّا","walammā","And when","এবং যখন"],["فَتَحُوا۟","fataḥū","they opened","তারা খুললো"],["مَتَـٰعَهُمْ","matā‘ahum","their baggage","তাদের মালপত্র"],["وَجَدُوا۟","wajadū","they found","তারা পেলো"],["بِضَـٰعَتَهُمْ","biḍā‘atahum","their merchandise","তাদের পণ্যমূল্য"],["رُدَّتْ","ruddat","returned","ফেরত দেয়া হয়েছে"],["إِلَيْهِمْ ۖ","ilayhim","to them","তাদের প্রতি"],["قَالُوا۟","qālū","They said","তারা বললো"],["يَـٰٓأَبَانَا","yāabānā","O our father","\"হে আমাদের পিতা"],["مَا","mā","What","কি"],["نَبْغِى ۖ","nabghī","(could) we desire","আশা করি আমরা"],["هَـٰذِهِۦ","hādhihi","This","এই যে"],["بِضَـٰعَتُنَا","biḍā‘atunā","(is) our merchandise","আমাদের পণ্যমূল্য"],["رُدَّتْ","ruddat","returned","ফেরত দেয়া হয়েছে"],["إِلَيْنَا ۖ","ilaynā","to us","আমাদের প্রতি"],["وَنَمِيرُ","wanamīru","And we will get provision","এবং আমরা খাদ্য এনে দিবো"],["أَهْلَنَا","ahlanā","(for) our family","আমাদের পরিবারকে"],["وَنَحْفَظُ","wanaḥfaẓu","and we will protect","আমরা দেখাশুনা করবো"],["أَخَانَا","akhānā","our brother","আমাদের ভাইকে"],["وَنَزْدَادُ","wanazdādu","and get an increase","ও অতিরিক্ত আনবো আমরা"],["كَيْلَ","kayla","measure","পরিমাণ (বরাদ্দ)"],["بَعِيرٍۢ ۖ","ba‘īrin","(of) a camel's (load)","এক উটবোঝাই"],["ذَٰلِكَ","dhālika","That","ঐ"],["كَيْلٌۭ","kaylun","(is) a measurement","পরিমাপ"],["يَسِيرٌۭ","yasīrun","easy","সহজ\""]],"t":"وَلَ<g>مَّ</>ا فَتَحُو<s>ا۟</> مَ<m>تَٰ</>عَهُمْ وَجَدُو<s>ا۟</> بِ<m>ضَٰ</>عَتَهُمْ رُدَّتْ إِلَيْهِمْ ۖ قَالُو<s>ا۟</> <o>يَٰٓ</>أَبَانَا مَا نَ<q>بْ</>غِى ۖ <m>هَٰذِهِۦ</> بِ<m>ضَٰ</>عَتُنَا رُدَّتْ إِلَيْنَا ۖ وَنَمِيرُ أَهْلَنَا وَنَحْفَظُ أَخَانَا وَنَزْدَادُ كَيْلَ بَعِي<k>رٍۢ ۖ ذَٰ</>لِكَ كَيْ<d>لٌۭ يَ</><p>سِي</>رٌۭ"},{"n":66,"w":[["قَالَ","qāla","He said","সে বললো"],["لَنْ","lan","Never","\"কখনও না"],["أُرْسِلَهُۥ","ur'silahu","will I send him","তাকে আমি পাঠাবো"],["مَعَكُمْ","ma‘akum","with you","তোমাদের সাথে"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["تُؤْتُونِ","tu'tūni","you give to me","তোমরা দিবে আমাকে"],["مَوْثِقًۭا","mawthiqan","a promise","প্রতিশ্রুতি"],["مِّنَ","mina","by","নামে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌র"],["لَتَأْتُنَّنِى","latatunnanī","that surely you will bring him to me","অবশ্যই আমার কাছে আসবে তোমরা"],["بِهِۦٓ","bihi","that surely you will bring him to me","নিয়ে তাকে"],["إِلَّآ","illā","unless","তবে"],["أَن","an","that","যদি"],["يُحَاطَ","yuḥāṭa","you are surrounded","পরিবেষ্টিত করা হয় (সেটা ভিন্ন কথা)\""],["بِكُمْ ۖ","bikum","you are surrounded","তোমাদেরকে\""],["فَلَمَّآ","falammā","And when","অতঃপর যখন"],["ءَاتَوْهُ","ātawhu","they had given him","তাকে দিলো"],["مَوْثِقَهُمْ","mawthiqahum","their promise","তাদের প্রতিশ্রুতি"],["قَالَ","qāla","he said","(ইয়াকুব) বললো"],["ٱللَّهُ","l-lahu","Allah","\"আল্লাহর"],["عَلَىٰ","‘alā","over","উপর (ভরসা)"],["مَا","mā","what","যা"],["نَقُولُ","naqūlu","we say","আমরা বলছি"],["وَكِيلٌۭ","wakīlun","(is) a Guardian","তিনিই কর্মবিধায়ক\""]],"t":"قَالَ لَنْ أُرْسِلَهُ<m>ۥ</> مَعَكُمْ حَتَّىٰ تُؤْتُونِ مَوْثِ<d>قًۭا مِّ</>نَ <h>ٱ</>للَّهِ لَتَأْتُ<g>نَّ</>نِى بِ<o>هِۦٓ</> إِ<o>لَّآ</> <d>أَن يُ</>حَاطَ بِكُمْ ۖ فَلَ<g>مَّ</><o>آ</> ءَاتَوْهُ مَوْثِقَهُمْ قَالَ <h>ٱ</>للَّهُ عَلَىٰ مَا نَقُولُ وَ<p>كِي</>لٌۭ"},{"n":67,"w":[["وَقَالَ","waqāla","And he said","এবং সে বললো"],["يَـٰبَنِىَّ","yābaniyya","O my sons","\"হে আমার ছেলেরা"],["لَا","lā","(Do) not","না"],["تَدْخُلُوا۟","tadkhulū","enter","তোমরা প্রবেশ করো"],["مِنۢ","min","from","দিয়ে"],["بَابٍۢ","bābin","one gate","দরজা"],["وَٰحِدٍۢ","wāḥidin","one gate","একটা"],["وَٱدْخُلُوا۟","wa-ud'khulū","but enter","বরং তোমরা প্রবেশ করো"],["مِنْ","min","from","দিয়ে"],["أَبْوَٰبٍۢ","abwābin","gates","দরজা"],["مُّتَفَرِّقَةٍۢ ۖ","mutafarriqatin","different","ভিন্ন ভিন্ন"],["وَمَآ","wamā","And not","এবং না"],["أُغْنِى","ugh'nī","I can avail","আমি কাজে আসবো"],["عَنكُم","‘ankum","you","তোমাদের জন্যে"],["مِّنَ","mina","against","থেকে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["مِن","min","any","কোন"],["شَىْءٍ ۖ","shayin","thing","কিছুই"],["إِنِ","ini","Not","নেই"],["ٱلْحُكْمُ","l-ḥuk'mu","(is) the decision","বিধান দেয়ার অধিকার"],["إِلَّا","illā","except","ছাড়া"],["لِلَّهِ ۖ","lillahi","with Allah","আল্লাহ"],["عَلَيْهِ","‘alayhi","upon Him","তাঁরই উপর"],["تَوَكَّلْتُ ۖ","tawakkaltu","I put my trust","আমি নির্ভর করছি"],["وَعَلَيْهِ","wa‘alayhi","and upon Him","এবং তাঁরই উপর"],["فَلْيَتَوَكَّلِ","falyatawakkali","let put (their) trust","নির্ভর করা উচিত"],["ٱلْمُتَوَكِّلُونَ","l-mutawakilūna","the ones who put trust","ভরসাকারীদের\""]],"t":"وَقَالَ <m>يَٰ</>بَنِىَّ لَا تَ<q>دْ</>خُلُو<s>ا۟</> <i>مِنۢ بَ</>ا<d>بٍۢ وَٰحِدٍۢ وَ</><h>ٱ</><q>دْ</>خُلُو<s>ا۟</> مِنْ أَ<q>بْ</><m>وَٰ</><d>بٍۢ مُّ</>تَفَرِّقَ<d>ةٍۢ ۖ وَ</><o>مَآ</> أُغْنِى عَ<k>نكُ</><y>م مِّ</>نَ <h>ٱ</>للَّهِ مِ<k>ن شَ</>ىْءٍ ۖ إِنِ <h>ٱ</>لْحُكْمُ إِلَّا لِلَّهِ ۖ عَلَيْهِ تَوَكَّلْتُ ۖ وَعَلَيْهِ فَلْيَتَوَكَّلِ <h>ٱ</>لْمُتَوَكِّ<p>لُو</>نَ"},{"n":68,"w":[["وَلَمَّا","walammā","And when","এবং যখন"],["دَخَلُوا۟","dakhalū","they entered","তারা প্রবেশ করলো"],["مِنْ","min","from","দিয়ে"],["حَيْثُ","ḥaythu","where","যেখান"],["أَمَرَهُمْ","amarahum","ordered them","তাদের নির্দেশ দিয়েছিল"],["أَبُوهُم","abūhum","their father","তাদের পিতা"],["مَّا","mā","not","না"],["كَانَ","kāna","it","(হল)"],["يُغْنِى","yugh'nī","avail(ed)","কাজে আসল"],["عَنْهُم","‘anhum","them","তাদের জন্যে"],["مِّنَ","mina","against","হ'তে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌"],["مِن","min","any","কোন"],["شَىْءٍ","shayin","thing","কিছুই"],["إِلَّا","illā","but","ছাড়া যে"],["حَاجَةًۭ","ḥājatan","(it was) a need","অভিপ্রায় (ছিলো)"],["فِى","fī","of","মধ্যে"],["نَفْسِ","nafsi","Yaqub's soul","মনের"],["يَعْقُوبَ","ya‘qūba","Yaqub's soul","ইয়াকুবের"],["قَضَىٰهَا ۚ","qaḍāhā","which he carried out","যা সে পূর্ণ করেছিলো"],["وَإِنَّهُۥ","wa-innahu","And indeed, he","এবং সে নিশ্চয়ই"],["لَذُو","ladhū","(was) a possessor","অবশ্যই সম্পন্ন"],["عِلْمٍۢ","‘il'min","(of) knowledge","জ্ঞান (ছিলো)"],["لِّمَا","limā","because","ঐ বিষয়ে যা"],["عَلَّمْنَـٰهُ","‘allamnāhu","We had taught him","তাকে আমরা শিখিয়েছিলাম"],["وَلَـٰكِنَّ","walākinna","but","কিন্তু"],["أَكْثَرَ","akthara","most","অধিকাংশ"],["ٱلنَّاسِ","l-nāsi","(of) the people","মানুষ"],["لَا","lā","(do) not","না"],["يَعْلَمُونَ","ya‘lamūna","know","তারা জ্ঞান রাখে"]],"t":"وَلَ<g>مَّ</>ا دَخَلُو<s>ا۟</> مِنْ حَيْثُ أَمَرَهُمْ أَبُو<y>هُم مَّ</>ا كَانَ يُغْنِى عَنْ<y>هُم مِّ</>نَ <h>ٱ</>للَّهِ مِ<k>ن شَ</>ىْءٍ إِلَّا حَاجَ<k>ةًۭ فِ</>ى نَفْسِ يَعْقُوبَ قَضَ<m>ىٰ</>هَا ۚ وَإِ<g>نَّ</>هُ<m>ۥ</> لَذُو عِلْ<w>مٍۢ لِّ</>مَا عَلَّمْ<m>نَٰ</>هُ وَ<m>لَٰ</>كِ<g>نَّ</> أَكْثَرَ <h>ٱ</><l>ل</><g>نَّ</>اسِ لَا يَعْلَ<p>مُو</>نَ"},{"n":69,"w":[["وَلَمَّا","walammā","And when","এবং যখন"],["دَخَلُوا۟","dakhalū","they entered","তারা প্রবেশ করলো"],["عَلَىٰ","‘alā","upon","কাছে"],["يُوسُفَ","yūsufa","Yusuf","ইউসুফের"],["ءَاوَىٰٓ","āwā","he took","সে আশ্রয় দিলো"],["إِلَيْهِ","ilayhi","to himself","তার কাছে"],["أَخَاهُ ۖ","akhāhu","his brother","তার ভাইকে"],["قَالَ","qāla","He said","সে বললো"],["إِنِّىٓ","innī","Indeed, I","\"আমি নিশ্চয়ই"],["أَنَا۠","anā","[I] am","আমি"],["أَخُوكَ","akhūka","your brother","তোমার ভাই (ইউসুফ)"],["فَلَا","falā","so (do) not","সুতরাং না"],["تَبْتَئِسْ","tabta-is","grieve","দুঃখ করো"],["بِمَا","bimā","for what","ঐ সম্বন্ধে যা"],["كَانُوا۟","kānū","they used (to)","তারা ছিলো"],["يَعْمَلُونَ","ya‘malūna","do","তারা কাজ করতে\""]],"t":"وَلَ<g>مَّ</>ا دَخَلُو<s>ا۟</> عَلَىٰ يُوسُفَ ءَاوَ<o>ىٰٓ</> إِلَيْهِ أَخَاهُ ۖ قَالَ إِ<g>نِّ</><o>ىٓ</> أَنَا۠ أَخُوكَ فَلَا تَ<q>بْ</>تَئِسْ بِمَا كَانُو<s>ا۟</> يَعْمَ<p>لُو</>نَ"},{"n":70,"w":[["فَلَمَّا","falammā","So when","অতঃপর যখন"],["جَهَّزَهُم","jahhazahum","he had furnished them","তাদেরকে সে প্রস্তুত করলো"],["بِجَهَازِهِمْ","bijahāzihim","with their supplies","সহ তাদের খাদ্য সামগ্রী"],["جَعَلَ","ja‘ala","he put","সে রেখে দিলো"],["ٱلسِّقَايَةَ","l-siqāyata","the drinking cup","(নিজের) পানপাত্র"],["فِى","fī","in","মধ্যে"],["رَحْلِ","raḥli","the bag","মালপত্রের"],["أَخِيهِ","akhīhi","(of) his brother","তার ভাইয়ের"],["ثُمَّ","thumma","Then","এরপর"],["أَذَّنَ","adhana","called out","ঘোষণা দিলো"],["مُؤَذِّنٌ","mu-adhinun","an announcer","এক ঘোষক"],["أَيَّتُهَا","ayyatuhā","O you","\"হে"],["ٱلْعِيرُ","l-‘īru","(in) the caravan","যাত্রীদল"],["إِنَّكُمْ","innakum","Indeed, you","নিশ্চয়ই তোমরা"],["لَسَـٰرِقُونَ","lasāriqūna","surely (are) thieves","অবশ্যই চোর\""]],"t":"فَلَ<g>مَّ</>ا جَهَّزَ<f>هُم بِ</>جَهَازِهِمْ جَعَلَ <h>ٱ</><l>ل</>سِّقَايَةَ فِى رَحْلِ أَخِيهِ ثُ<g>مَّ</> أَذَّنَ مُؤَذِّنٌ أَيَّتُهَا <h>ٱ</>لْعِيرُ إِ<g>نَّ</>كُمْ لَ<m>سَٰ</>رِ<p>قُو</>نَ"},{"n":71,"w":[["قَالُوا۟","qālū","They said","তারা বললো"],["وَأَقْبَلُوا۟","wa-aqbalū","turning towards","এবং এগিয়ে এলো"],["عَلَيْهِم","‘alayhim","them","দিকে তাদের"],["مَّاذَا","mādhā","What (is it)","\"কি"],["تَفْقِدُونَ","tafqidūna","you miss","তোমরা হারিয়েছো\""]],"t":"قَالُو<s>ا۟</> وَأَ<q>قْ</>بَلُو<s>ا۟</> عَلَيْ<y>هِم مَّ</>اذَا تَفْقِ<p>دُو</>نَ"},{"n":72,"w":[["قَالُوا۟","qālū","They said","তারা বললো"],["نَفْقِدُ","nafqidu","We are missing","\"আমরা হারিয়েছি"],["صُوَاعَ","ṣuwā‘a","(the) cup","পানপাত্র"],["ٱلْمَلِكِ","l-maliki","(of) the king","রাজার"],["وَلِمَن","waliman","And for (one) who","এবং যে কেউ"],["جَآءَ","jāa","brings","আসবে"],["بِهِۦ","bihi","it","নিয়ে তা (সে খাদ্য পাবে)"],["حِمْلُ","ḥim'lu","(is) a load","বোঝা পরিমাণ"],["بَعِيرٍۢ","ba‘īrin","(of) a camel","এক উটের"],["وَأَنَا۠","wa-anā","and I","এবং আমি"],["بِهِۦ","bihi","for it","এ সম্বন্ধে"],["زَعِيمٌۭ","za‘īmun","(is) responsible","মুখপাত্র\""]],"t":"قَالُو<s>ا۟</> نَفْقِدُ صُوَاعَ <h>ٱ</>لْمَلِكِ وَلِمَ<k>ن جَ</><o>آ</>ءَ بِ<m>هِۦ</> حِمْلُ بَعِي<d>رٍۢ وَ</>أَنَا۠ بِ<m>هِۦ</> زَ<p>عِي</>مٌۭ"},{"n":73,"w":[["قَالُوا۟","qālū","They said","তারা বললো"],["تَٱللَّهِ","tal-lahi","By Allah","\"শপথ আল্লাহর"],["لَقَدْ","laqad","certainly","নিশ্চয়ই"],["عَلِمْتُم","‘alim'tum","you know","তোমরা জেনেছো (যে)"],["مَّا","mā","not","না"],["جِئْنَا","ji'nā","we came","আমরা এসেছি"],["لِنُفْسِدَ","linuf'sida","that we cause corruption","জন্যে আমরা খারাপ কাজ করার"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the land","এ দেশের"],["وَمَا","wamā","and not","এবং নই"],["كُنَّا","kunnā","we are","আমরা"],["سَـٰرِقِينَ","sāriqīna","thieves","চোর\""]],"t":"قَالُو<s>ا۟</> تَ<h>ٱ</>للَّهِ لَقَ<q>دْ</> عَلِمْ<y>تُم مَّ</>ا جِئْنَا لِنُفْسِدَ فِى <h>ٱ</>لْأَرْضِ وَمَا كُ<g>نَّ</>ا <m>سَٰ</>رِ<p>قِي</>نَ"},{"n":74,"w":[["قَالُوا۟","qālū","They said","তারা বললো"],["فَمَا","famā","Then what","\"তবে কি"],["جَزَٰٓؤُهُۥٓ","jazāuhu","(will be the) recompense (of) it","তার শাস্তি"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you are","তোমরা হও"],["كَـٰذِبِينَ","kādhibīna","liars","মিথ্যাবাদী\""]],"t":"قَالُو<s>ا۟</> فَمَا جَ<o>زَٰٓ</>ؤُهُ<o>ۥٓ</> إِ<k>ن كُنتُ</>مْ <m>كَٰ</>ذِ<p>بِي</>نَ"},{"n":75,"w":[["قَالُوا۟","qālū","They said","তারা বললো"],["جَزَٰٓؤُهُۥ","jazāuhu","Its recompense","\"তার শাস্তি"],["مَن","man","(is that one) who","যার"],["وُجِدَ","wujida","it is found","পাওয়া যাবে"],["فِى","fī","in","মধ্যে"],["رَحْلِهِۦ","raḥlihi","his bag","তার মালপত্রের"],["فَهُوَ","fahuwa","then he","অতঃপর সেই"],["جَزَٰٓؤُهُۥ ۚ","jazāuhu","(will be) his recompense","তার বিনিময় হবে"],["كَذَٰلِكَ","kadhālika","Thus","এভাবে"],["نَجْزِى","najzī","(do) we recompense","প্রতিদান দিই আমরা"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","সীমালঙ্ঘনকারীদেরকে\""]],"t":"قَالُو<s>ا۟</> جَ<o>زَٰٓ</>ؤُهُ<m>ۥ</> <d>مَن وُ</>جِدَ فِى رَحْلِ<m>هِۦ</> فَهُوَ جَ<o>زَٰٓ</>ؤُهُ<m>ۥ</> ۚ كَ<m>ذَٰ</>لِكَ نَ<q>جْ</>زِى <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":76,"w":[["فَبَدَأَ","fabada-a","So he began","অতঃপর (তল্লাশি) সে শুরু করলো"],["بِأَوْعِيَتِهِمْ","bi-aw‘iyatihim","with their bags","তাদের পাত্রের"],["قَبْلَ","qabla","before","পূর্বে"],["وِعَآءِ","wi‘āi","(the) bag","পাত্রের"],["أَخِيهِ","akhīhi","(of) his brother","তার ভাইয়ের"],["ثُمَّ","thumma","then","এরপর"],["ٱسْتَخْرَجَهَا","is'takhrajahā","he brought it out","তা সে বের করলো"],["مِن","min","from","হ'তে"],["وِعَآءِ","wi‘āi","(the) bag","পাত্রের"],["أَخِيهِ ۚ","akhīhi","(of) his brother","তার ভাইয়ের"],["كَذَٰلِكَ","kadhālika","Thus","এভাবে"],["كِدْنَا","kid'nā","(did) We plan","আমরা কৌশল করেছিলাম"],["لِيُوسُفَ ۖ","liyūsufa","for Yusuf","ইউসুফের জন্যে"],["مَا","mā","He could not","না"],["كَانَ","kāna","He could not","শোভা পেতো"],["لِيَأْخُذَ","liyakhudha","take","যে সে ধরে রাখবে"],["أَخَاهُ","akhāhu","his brother","তার ভাইকে"],["فِى","fī","by","অনুযায়ী"],["دِينِ","dīni","the law","আইন"],["ٱلْمَلِكِ","l-maliki","(of) the king","রাজার"],["إِلَّآ","illā","except","তবে"],["أَن","an","that","যদি"],["يَشَآءَ","yashāa","Allah willed","ইচ্ছে করেন"],["ٱللَّهُ ۚ","l-lahu","Allah willed","আল্লাহ"],["نَرْفَعُ","narfa‘u","We raise","আমরা উন্নীত করি"],["دَرَجَـٰتٍۢ","darajātin","(in) degrees","মর্যাদা"],["مَّن","man","whom","যাকে"],["نَّشَآءُ ۗ","nashāu","We will","ইচ্ছে করি আমরা"],["وَفَوْقَ","wafawqa","but over","এবং উপরে"],["كُلِّ","kulli","every","(তাদের) প্রত্যেক"],["ذِى","dhī","possessor","সম্পন্নের"],["عِلْمٍ","‘il'min","(of) knowledge","জ্ঞান (আছেন)"],["عَلِيمٌۭ","‘alīmun","(is) the All-Knower","একজন মহাজ্ঞানী"]],"t":"فَبَدَأَ بِأَوْعِيَتِهِمْ قَ<q>بْ</>لَ وِ<o>عَآ</>ءِ أَخِيهِ ثُ<g>مَّ</> <h>ٱ</>سْتَخْرَجَهَا <d>مِن وِ</><o>عَآ</>ءِ أَخِيهِ ۚ كَ<m>ذَٰ</>لِكَ كِ<q>دْ</>نَا لِيُوسُفَ ۖ مَا كَانَ لِيَأْخُذَ أَخَاهُ فِى دِينِ <h>ٱ</>لْمَلِكِ إِ<o>لَّآ</> <d>أَن يَ</><o>شَآ</>ءَ <h>ٱ</>للَّهُ ۚ نَرْفَعُ دَرَ<m>جَٰ</><d>تٍۢ مَّن نَّ</><o>شَآ</>ءُ ۗ وَفَوْقَ كُلِّ ذِى عِلْمٍ عَ<p>لِي</>مٌۭ"},{"n":77,"w":[["۞ قَالُوٓا۟","qālū","They said","তারা বললো"],["إِن","in","If","\"যদি"],["يَسْرِقْ","yasriq","he steals ","সে চুরি করে থাকে"],["فَقَدْ","faqad","then verily","তবে নিশ্চয়ই (আশ্চর্য নয়)"],["سَرَقَ","saraqa","stole","চুরি করেছিলো"],["أَخٌۭ","akhun","a brother","ভাই"],["لَّهُۥ","lahu","of his","তার (অর্থাৎ ইউসুফ)"],["مِن","min","before","থেকেই\""],["قَبْلُ ۚ","qablu","before","আগে\""],["فَأَسَرَّهَا","fa-asarrahā","But Yusuf kept it secret","অতঃপর রাখলো তা গোপন"],["يُوسُفُ","yūsufu","But Yusuf kept it secret","ইউসুফ"],["فِى","fī","within","মধ্যে"],["نَفْسِهِۦ","nafsihi","himself","তার নিজের"],["وَلَمْ","walam","and (did) not","এবং না"],["يُبْدِهَا","yub'dihā","reveal it","তা প্রকাশ করলো"],["لَهُمْ ۚ","lahum","to them","তাদের কাছে"],["قَالَ","qāla","He said","সে বললো (মনে মনে)"],["أَنتُمْ","antum","You","\"তোমরা (লোক)"],["شَرٌّۭ","sharrun","(are the) worse","খারাপ"],["مَّكَانًۭا ۖ","makānan","(in) position","অবস্থার (প্রকৃতির)"],["وَٱللَّهُ","wal-lahu","and Allah","এবং আল্লাহই"],["أَعْلَمُ","a‘lamu","knows best","খুব অবহিত"],["بِمَا","bimā","of what","ঐ সম্বন্ধে যা"],["تَصِفُونَ","taṣifūna","you describe","তোমরা বর্ণনা করছো\""]],"t":"۞ قَا<o>لُوٓ</><s>ا۟</> <d>إِن يَ</>سْرِ<q>قْ</> فَقَ<q>دْ</> سَرَقَ أَ<w>خٌۭ لَّ</>هُ<m>ۥ</> مِ<k>ن قَ</><q>بْ</>لُ ۚ فَأَسَرَّهَا يُوسُفُ فِى نَفْسِ<m>هِۦ</> وَلَمْ يُ<q>بْ</>دِهَا لَهُمْ ۚ قَالَ أَ<k>نتُ</>مْ شَ<d>رٌّۭ مَّ</>كَا<d>نًۭا ۖ وَ</><h>ٱ</>للَّهُ أَعْلَمُ بِمَا تَصِ<p>فُو</>نَ"},{"n":78,"w":[["قَالُوا۟","qālū","They said","তারা বললো"],["يَـٰٓأَيُّهَا","yāayyuhā","O","\"হে"],["ٱلْعَزِيزُ","l-‘azīzu","Aziz","আজীজ"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["لَهُۥٓ","lahu","he has","তার আছে"],["أَبًۭا","aban","a father","পিতা"],["شَيْخًۭا","shaykhan","old","বৃদ্ধ"],["كَبِيرًۭا","kabīran","[great]","অতিশয়"],["فَخُذْ","fakhudh","so take","অতএব ধরে রাখুন"],["أَحَدَنَا","aḥadanā","one of us","আমাদের একজনকে"],["مَكَانَهُۥٓ ۖ","makānahu","(in) his place","তার জায়গায়"],["إِنَّا","innā","Indeed, we","নিশ্চয়ই আমরা"],["نَرَىٰكَ","narāka","[we] see you","আপনাকে দেখছি"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْمُحْسِنِينَ","l-muḥ'sinīna","the good-doers","মহানুভবদের\""]],"t":"قَالُو<s>ا۟</> <o>يَٰٓ</>أَيُّهَا <h>ٱ</>لْعَزِيزُ إِ<g>نَّ</> لَهُ<o>ۥٓ</> أَ<k>بًۭا شَيْخًۭا كَ</>بِي<k>رًۭا فَ</>خُذْ أَحَدَنَا