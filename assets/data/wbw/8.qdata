{"n":8,"a":[{"n":1,"w":[["يَسْـَٔلُونَكَ","yasalūnaka","They ask you","তোমাকে তারা জিজ্ঞাসা করে"],["عَنِ","‘ani","about","সম্পর্কে"],["ٱلْأَنفَالِ ۖ","l-anfāli","the spoils of war","যুদ্ধলব্ধ সম্পদ"],["قُلِ","quli","Say","বলো"],["ٱلْأَنفَالُ","l-anfālu","The spoils of war","\"যুদ্ধলব্ধ সম্পদ"],["لِلَّهِ","lillahi","(are) for Allah","জন্যে আল্লাহর"],["وَٱلرَّسُولِ ۖ","wal-rasūli","and the Messenger","ও রাসূলের (জন্যে)"],["فَٱتَّقُوا۟","fa-ittaqū","So fear","অতএব তোমরা ভয় করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["وَأَصْلِحُوا۟","wa-aṣliḥū","and set right","এবং তোমরা সংশোধন করো"],["ذَاتَ","dhāta","that","অবস্থা"],["بَيْنِكُمْ ۖ","baynikum","(which is) between you","মধ্যকার তোমাদের"],["وَأَطِيعُوا۟","wa-aṭī‘ū","and obey","এবং তোমরা আনুগত্য করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহর"],["وَرَسُولَهُۥٓ","warasūlahu","and His Messenger","এবং রাসূলের তাঁর"],["إِن","in","if","যদি"],["كُنتُم","kuntum","you are","হও তোমরা"],["مُّؤْمِنِينَ","mu'minīna","believers","মু'মিন\""]],"t":"يَسْـَٔلُونَكَ عَنِ <h>ٱ</>لْأَ<k>نفَ</>الِ ۖ قُلِ <h>ٱ</>لْأَ<k>نفَ</>الُ لِلَّهِ وَ<h>ٱ</><l>ل</>رَّسُولِ ۖ فَ<h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</>للَّهَ وَأَصْلِحُو<s>ا۟</> ذَاتَ بَيْنِكُمْ ۖ وَأَطِيعُو<s>ا۟</> <h>ٱ</>للَّهَ وَرَسُولَهُ<o>ۥٓ</> إِ<k>ن كُنتُ</><y>م مُّ</>ؤْمِ<p>نِي</>نَ"},{"n":2,"w":[["إِنَّمَا","innamā","Only","প্রকৃতপক্ষে"],["ٱلْمُؤْمِنُونَ","l-mu'minūna","the believers","মু'মিন"],["ٱلَّذِينَ","alladhīna","(are) those who","(তারাই) যারা"],["إِذَا","idhā","when","(এমন যে) যখন"],["ذُكِرَ","dhukira","is mentioned","স্মরণ করা হয়"],["ٱللَّهُ","l-lahu","Allah","আল্লাহর"],["وَجِلَتْ","wajilat","feel fear","কেঁপে উঠে"],["قُلُوبُهُمْ","qulūbuhum","their hearts","অন্তরগুলো তাদের"],["وَإِذَا","wa-idhā","and when","এবং যখন"],["تُلِيَتْ","tuliyat","are recited","পাঠ করা হয়"],["عَلَيْهِمْ","‘alayhim","to them","নিকট তাদের"],["ءَايَـٰتُهُۥ","āyātuhu","His Verses","আয়াতগুলো তাঁর"],["زَادَتْهُمْ","zādathum","they increase them","বৃদ্ধি পায় তাদের"],["إِيمَـٰنًۭا","īmānan","(in) faith","ঈমান"],["وَعَلَىٰ","wa‘alā","and upon","ও উপর"],["رَبِّهِمْ","rabbihim","their Lord","রবের তাদের"],["يَتَوَكَّلُونَ","yatawakkalūna","they put their trust","তারা নির্ভর করে"]],"t":"إِ<g>نَّ</>مَا <h>ٱ</>لْمُؤْمِنُونَ <h>ٱ</>لَّذِينَ إِذَا ذُكِرَ <h>ٱ</>للَّهُ وَجِلَتْ قُلُوبُهُمْ وَإِذَا تُلِيَتْ عَلَيْهِمْ ءَا<m>يَٰ</>تُهُ<m>ۥ</> زَادَتْهُمْ إِي<m>مَٰ</><d>نًۭا وَ</>عَلَىٰ رَبِّهِمْ يَتَوَكَّ<p>لُو</>نَ"},{"n":3,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["يُقِيمُونَ","yuqīmūna","establish","প্রতিষ্ঠা করে"],["ٱلصَّلَوٰةَ","l-ṣalata","the prayer","সালাত"],["وَمِمَّا","wamimmā","and out of what","ও (তা) হতে যা"],["رَزَقْنَـٰهُمْ","razaqnāhum","We have provided them","আমরা জীবিকা দিয়েছি তাদের"],["يُنفِقُونَ","yunfiqūna","they spend","তারা ব্যয় করে"]],"t":"ٱلَّذِينَ يُقِيمُونَ <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةَ وَمِ<g>مَّ</>ا رَزَ<q>قْ</><m>نَٰ</>هُمْ يُ<k>نفِ</><p>قُو</>نَ"},{"n":4,"w":[["أُو۟لَـٰٓئِكَ","ulāika","Those ","ঐসব(লোক)"],["هُمُ","humu","they are","তারাই"],["ٱلْمُؤْمِنُونَ","l-mu'minūna","the believers","মু'মিন"],["حَقًّۭا ۚ","ḥaqqan","(in) truth","প্রকৃত"],["لَّهُمْ","lahum","For them","জন্যে তাদের(রয়েছে)"],["دَرَجَـٰتٌ","darajātun","(are) ranks","মর্যাদাসমূহ"],["عِندَ","‘inda","with","কাছে"],["رَبِّهِمْ","rabbihim","their Lord","রবের তাদের"],["وَمَغْفِرَةٌۭ","wamaghfiratun","and forgiveness","ও ক্ষমা"],["وَرِزْقٌۭ","wariz'qun","and a provision","ও জীবিকা"],["كَرِيمٌۭ","karīmun","noble","সম্মানজনক"]],"t":"أُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</>لْمُؤْمِنُونَ حَ<w>قًّۭا ۚ لَّ</>هُمْ دَرَ<m>جَٰ</>تٌ عِ<k>ندَ</> رَبِّهِمْ وَمَغْفِرَ<d>ةٌۭ وَ</>رِزْ<k>قٌۭ كَ</><p>رِي</>مٌۭ"},{"n":5,"w":[["كَمَآ","kamā","As","যেমন"],["أَخْرَجَكَ","akhrajaka","brought you out","তোমাকে বের করেছিলেন"],["رَبُّكَ","rabbuka","your Lord","তোমার রব"],["مِنۢ","min","from","থেকে"],["بَيْتِكَ","baytika","your home","তোমার ঘর"],["بِٱلْحَقِّ","bil-ḥaqi","in truth","ভাবে ন্যায়"],["وَإِنَّ","wa-inna","while indeed","এবং নিশ্চয়ই"],["فَرِيقًۭا","farīqan","a party","একদল"],["مِّنَ","mina","among","মধ্য হতে(ছিলো)"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believers","মু'মিনদের"],["لَكَـٰرِهُونَ","lakārihūna","certainly disliked","অবশ্যই অপছন্দকারী"]],"t":"كَ<o>مَآ</> أَخْرَجَكَ رَبُّكَ <i>مِنۢ بَ</>يْتِكَ بِ<h>ٱ</>لْحَقِّ وَإِ<g>نَّ</> فَرِي<d>قًۭا مِّ</>نَ <h>ٱ</>لْمُؤْمِنِينَ لَ<m>كَٰ</>رِ<p>هُو</>نَ"},{"n":6,"w":[["يُجَـٰدِلُونَكَ","yujādilūnaka","They dispute with you","তোমার সাথে তারা বিতর্ক করে"],["فِى","fī","concerning","ব্যাপারে"],["ٱلْحَقِّ","l-ḥaqi","the truth","সত্যের"],["بَعْدَ مَا","ba‘damā","after what","পরেও তা"],["تَبَيَّنَ","tabayyana","was made clear","সুস্পষ্ট হওয়ার"],["كَأَنَّمَا","ka-annamā","as if","যেন প্রকৃতপক্ষে"],["يُسَاقُونَ","yusāqūna","they were driven","তারা চালিত হচ্ছে"],["إِلَى","ilā","to","দিকে"],["ٱلْمَوْتِ","l-mawti","[the] death","মৃত্যুর"],["وَهُمْ","wahum","while they","এ অবস্থায়(যেন) তারা"],["يَنظُرُونَ","yanẓurūna","(were) looking","প্রত্যক্ষ করছে(মৃত্যু)"]],"t":"يُ<m>جَٰ</>دِلُونَكَ فِى <h>ٱ</>لْحَقِّ بَعْدَمَا تَبَيَّنَ كَأَ<g>نَّ</>مَا يُسَاقُونَ إِلَى <h>ٱ</>لْمَوْتِ وَهُمْ يَ<k>نظُ</><p>رُو</>نَ"},{"n":7,"w":[["وَإِذْ","wa-idh","And when","এবং (স্মরণ করো)যখন"],["يَعِدُكُمُ","ya‘idukumu","promised you","প্রতিশ্রুতি দেন তোমাদের"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["إِحْدَى","iḥ'dā","one","একটির"],["ٱلطَّآئِفَتَيْنِ","l-ṭāifatayni","(of) the two groups ","দুইদলের(মধ্যে)"],["أَنَّهَا","annahā","that it (would be)","যে তা(আওতাধীন হবে)"],["لَكُمْ","lakum","for you ","জন্যে তোমাদের"],["وَتَوَدُّونَ","watawaddūna","and you wished","অথচ তোমরা চেয়েছিলে"],["أَنَّ","anna","that","যে"],["غَيْرَ","ghayra","(one) other than","নয়"],["ذَاتِ","dhāti","that","যুক্ত"],["ٱلشَّوْكَةِ","l-shawkati","(of) the armed","কাঁটা"],["تَكُونُ","takūnu","would be","তা হবে (সংঘর্ষশীল)"],["لَكُمْ","lakum","for you","জন্যে তোমাদের"],["وَيُرِيدُ","wayurīdu","But intended","কিন্তু চান"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["أَن","an","to","যে"],["يُحِقَّ","yuḥiqqa","justify","সত্যে পরিণত করতে"],["ٱلْحَقَّ","l-ḥaqa","the truth","সত্যকে"],["بِكَلِمَـٰتِهِۦ","bikalimātihi","by His words","দিয়ে বাণীসমূহ তাঁর"],["وَيَقْطَعَ","wayaqṭa‘a","and cut off","এবং কাটবেন"],["دَابِرَ","dābira","(the) roots","মূল"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","(of) the disbelievers","কাফেরদের"]],"t":"وَإِذْ يَعِدُكُمُ <h>ٱ</>للَّهُ إِحْدَى <h>ٱ</><l>ل</><o>طَّآ</>ئِفَتَيْنِ أَ<g>نَّ</>هَا لَكُمْ وَتَوَدُّونَ أَ<g>نَّ</> غَيْرَ ذَاتِ <h>ٱ</><l>ل</>شَّوْكَةِ تَكُونُ لَكُمْ وَيُرِيدُ <h>ٱ</>للَّهُ <d>أَن يُ</>حِقَّ <h>ٱ</>لْحَقَّ بِكَلِ<m>مَٰتِهِۦ</> وَيَ<q>قْ</>طَعَ دَابِرَ <h>ٱ</>لْ<m>كَٰ</>فِ<p>رِي</>نَ"},{"n":8,"w":[["لِيُحِقَّ","liyuḥiqqa","That He might justify","যেন সত্যে পরিণত করেন"],["ٱلْحَقَّ","l-ḥaqa","the truth","সত্যকে"],["وَيُبْطِلَ","wayub'ṭila","and prove false","ও অসত্যে পরিণত করেন"],["ٱلْبَـٰطِلَ","l-bāṭila","the falsehood","অসত্যকে"],["وَلَوْ","walaw","even if","এবং যদিও (তা)"],["كَرِهَ","kariha","disliked (it)","অপছন্দ করে"],["ٱلْمُجْرِمُونَ","l-muj'rimūna","the criminals","অপরাধীরা"]],"t":"لِيُحِقَّ <h>ٱ</>لْحَقَّ وَيُ<q>بْ</>طِلَ <h>ٱ</>لْ<m>بَٰ</>طِلَ وَلَوْ كَرِهَ <h>ٱ</>لْمُ<q>جْ</>رِ<p>مُو</>نَ"},{"n":9,"w":[["إِذْ","idh","When","(স্মরণ করো) যখন"],["تَسْتَغِيثُونَ","tastaghīthūna","you were seeking help","তোমরা সাহায্য চেয়েছিলে"],["رَبَّكُمْ","rabbakum","(of) your Lord","তোমাদের রবের কাছে"],["فَٱسْتَجَابَ","fa-is'tajāba","and He answered","তখন তিনি ডাকে সাড়া দিলেন"],["لَكُمْ","lakum","[to] you","প্রতি তোমাদের"],["أَنِّى","annī","Indeed, I am","\"(এভাবে) যে আমি"],["مُمِدُّكُم","mumiddukum","going to reinforce you","সাহায্য করছি তোমাদের"],["بِأَلْفٍۢ","bi-alfin","with a thousand","দিয়ে এক হাজার"],["مِّنَ","mina","of","মধ্য হতে"],["ٱلْمَلَـٰٓئِكَةِ","l-malāikati","the Angels","ফেরেশতাদের"],["مُرْدِفِينَ","mur'difīna","one after another","ধারাবাহিকভাবে আগত\""]],"t":"إِذْ تَسْتَغِيثُونَ رَبَّكُمْ فَ<h>ٱ</>سْتَجَابَ لَكُمْ أَ<g>نِّ</>ى مُمِدُّ<f>كُم بِ</>أَلْ<d>فٍۢ مِّ</>نَ <h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةِ مُرْدِ<p>فِي</>نَ"},{"n":10,"w":[["وَمَا","wamā","And not","এবং না"],["جَعَلَهُ","ja‘alahu","(it was) made","করেছিলেন তা"],["ٱللَّهُ","l-lahu","(by) Allah","আল্লাহ"],["إِلَّا","illā","but","এ ছাড়া"],["بُشْرَىٰ","bush'rā","good tidings","সুসংবাদ হিসেবে"],["وَلِتَطْمَئِنَّ","walitaṭma-inna","and so that might be at rest","এবং যেন প্রশান্ত হয়"],["بِهِۦ","bihi","with it","দিয়ে তা"],["قُلُوبُكُمْ ۚ","qulūbukum","your hearts","অন্তরসমূহ তোমাদের"],["وَمَا","wamā","And (there is) no","এবং না"],["ٱلنَّصْرُ","l-naṣru","[the] victory","সাহায্য(আসে)"],["إِلَّا","illā","except","এ ছাড়া"],["مِنْ","min","from","হতে"],["عِندِ","‘indi","[of]","নিকট"],["ٱللَّهِ ۚ","l-lahi","Allah","আল্লাহর"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["عَزِيزٌ","‘azīzun","(is) All-Mighty","পরাক্রমশালী"],["حَكِيمٌ","ḥakīmun","All-Wise","মহাবিজ্ঞ"]],"t":"وَمَا جَعَلَهُ <h>ٱ</>للَّهُ إِلَّا بُشْرَىٰ وَلِتَ<q>طْ</>مَئِ<g>نَّ</> بِ<m>هِۦ</> قُلُوبُكُمْ ۚ وَمَا <h>ٱ</><l>ل</><g>نَّ</>صْرُ إِلَّا مِنْ عِ<k>ندِ</> <h>ٱ</>للَّهِ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ عَزِيزٌ حَ<p>كِي</>مٌ"},{"n":11,"w":[["إِذْ","idh","When","(স্মরণ করো) যখন"],["يُغَشِّيكُمُ","yughashīkumu","He covered you","তিনি আচ্ছন্ন করেন তোমাদেরকে"],["ٱلنُّعَاسَ","l-nu‘āsa","with [the] slumber","তন্দ্রা(দিয়ে)"],["أَمَنَةًۭ","amanatan","a security","নিরাপত্তার জন্যে"],["مِّنْهُ","min'hu","from Him","পক্ষ হতে তাঁর"],["وَيُنَزِّلُ","wayunazzilu","and sent down","ও অবতীর্ণ করেন"],["عَلَيْكُم","‘alaykum","upon you","উপর তোমাদের"],["مِّنَ","mina","from","হতে"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশ"],["مَآءًۭ","māan","water","পানি"],["لِّيُطَهِّرَكُم","liyuṭahhirakum","so that He may purify you","জন্যে পবিত্র করার তোমাদেরকে"],["بِهِۦ","bihi","with it","দিয়ে তা"],["وَيُذْهِبَ","wayudh'hiba","and take away","এবং দূর করার(জন্যে)"],["عَنكُمْ","‘ankum","from you","হতে তোমাদের"],["رِجْزَ","rij'za","evil (suggestions)","অপবিত্রতা"],["ٱلشَّيْطَـٰنِ","l-shayṭāni","(of) the Shaitaan","শয়তানের"],["وَلِيَرْبِطَ","waliyarbiṭa","And to strengthen","এবং জন্যে  দূঢ় করার"],["عَلَىٰ","‘alā","[on]","উপর"],["قُلُوبِكُمْ","qulūbikum","your hearts","অন্তরসমূহের তোমাদের"],["وَيُثَبِّتَ","wayuthabbita","and make firm","ও স্থির করার (জন্যে)"],["بِهِ","bihi","with it","দিয়ে তা"],["ٱلْأَقْدَامَ","l-aqdāma","your feet","(তোমাদের) পাগুলোকে"]],"t":"إِذْ يُغَشِّيكُمُ <h>ٱ</><l>ل</><g>نُّ</>عَاسَ أَمَنَ<d>ةًۭ مِّ</>نْهُ وَيُنَزِّلُ عَلَيْ<y>كُم مِّ</>نَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ <o>مَآ</><w>ءًۭ لِّ</>يُطَهِّرَ<f>كُم بِ</><m>هِۦ</> وَيُذْهِبَ عَ<k>نكُ</>مْ رِ<q>جْ</>زَ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نِ وَلِيَرْبِطَ عَلَىٰ قُلُوبِكُمْ وَيُثَبِّتَ بِهِ <h>ٱ</>لْأَ<q>قْ</><p>دَا</>مَ"},{"n":12,"w":[["إِذْ","idh","When","(স্মরণ করো) যখন"],["يُوحِى","yūḥī","inspired","ওহী করেন"],["رَبُّكَ","rabbuka","your Lord","তোমার রব"],["إِلَى","ilā","to","প্রতি"],["ٱلْمَلَـٰٓئِكَةِ","l-malāikati","the Angels","ফেরেশতাদের"],["أَنِّى","annī","I am","\"যে আমি"],["مَعَكُمْ","ma‘akum","with you","সাথে(আছি)তোমাদের"],["فَثَبِّتُوا۟","fathabbitū","so strengthen","সুতরাং তোমরা অবিচল রাখো"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["ءَامَنُوا۟ ۚ","āmanū","believed","ঈমান এনেছে"],["سَأُلْقِى","sa-ul'qī","I will cast","অচিরেই আমি ঢুকিয়ে দিবো"],["فِى","fī","in","মধ্যে"],["قُلُوبِ","qulūbi","(the) hearts","অন্তরসমূহের"],["ٱلَّذِينَ","alladhīna","(of) those who","যারা"],["كَفَرُوا۟","kafarū","disbelieved ","অস্বীকার করেছে"],["ٱلرُّعْبَ","l-ru‘'ba","the terror","ভয়"],["فَٱضْرِبُوا۟","fa-iḍ'ribū","so strike","অতএব তোমরা আঘাত করো"],["فَوْقَ","fawqa","above","উপর"],["ٱلْأَعْنَاقِ","l-a‘nāqi","the necks","(তাদের)ঘাড়সমূহের"],["وَٱضْرِبُوا۟","wa-iḍ'ribū","and strike","এবং তোমরা আঘাত করো"],["مِنْهُمْ","min'hum","from them","মধ্য থেকে তাদের"],["كُلَّ","kulla","every","প্রত্যেকে"],["بَنَانٍۢ","banānin","fingertip[s]","জোড়ায় জোড়ায়\""]],"t":"إِذْ يُوحِى رَبُّكَ إِلَى <h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةِ أَ<g>نِّ</>ى مَعَكُمْ فَثَبِّتُو<s>ا۟</> <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟ ۚ</> سَأُلْقِى فِى قُلُوبِ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> <h>ٱ</><l>ل</>رُّعْبَ فَ<h>ٱ</>ضْرِبُو<s>ا۟</> فَوْقَ <h>ٱ</>لْأَعْنَاقِ وَ<h>ٱ</>ضْرِبُو<s>ا۟</> مِنْهُمْ كُلَّ بَ<p>نَا</>نٍۢ"},{"n":13,"w":[["ذَٰلِكَ","dhālika","That","এটা"],["بِأَنَّهُمْ","bi-annahum","(is) because they","এজন্য যে তারা"],["شَآقُّوا۟","shāqqū","opposed","তারা বিরোধিতা করেছিলো"],["ٱللَّهَ","l-laha","Allah","আল্লাহর"],["وَرَسُولَهُۥ ۚ","warasūlahu","and His Messenger","ও রাসূলের তাঁর"],["وَمَن","waman","And whoever","এবং যে"],["يُشَاقِقِ","yushāqiqi","opposes","বিরোধিতা করে"],["ٱللَّهَ","l-laha","Allah","আল্লাহর"],["وَرَسُولَهُۥ","warasūlahu","and His Messenger","ও রাসূলের তাঁর"],["فَإِنَّ","fa-inna","then indeed","সেক্ষেত্রে নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["شَدِيدُ","shadīdu","(is) severe","কঠোর"],["ٱلْعِقَابِ","l-‘iqābi","in [the] penalty","দন্ডদানে"]],"t":"<m>ذَٰ</>لِكَ بِأَ<g>نَّ</>هُمْ <n>شَآ</>قُّو<s>ا۟</> <h>ٱ</>للَّهَ وَرَسُولَهُ<m>ۥ</> ۚ وَ<d>مَن يُ</>شَاقِقِ <h>ٱ</>للَّهَ وَرَسُولَهُ<m>ۥ</> فَإِ<g>نَّ</> <h>ٱ</>للَّهَ شَدِيدُ <h>ٱ</>لْعِ<p>قَا</><q>بِ</>"},{"n":14,"w":[["ذَٰلِكُمْ","dhālikum","That ","এটাই(শাস্তি)তোমাদের"],["فَذُوقُوهُ","fadhūqūhu","So taste it","\"তাই তোমরা স্বাদ নাও তার\""],["وَأَنَّ","wa-anna","And that","এবং নিশ্চয়ই"],["لِلْكَـٰفِرِينَ","lil'kāfirīna","for the disbelievers","জন্যে কাফেরদের(রয়েছে)"],["عَذَابَ","‘adhāba","(is the) punishment","শাস্তি"],["ٱلنَّارِ","l-nāri","(of) the Fire","আগুনের"]],"t":"<m>ذَٰ</>لِكُمْ فَذُوقُوهُ وَأَ<g>نَّ</> لِلْ<m>كَٰ</>فِرِينَ عَذَابَ <h>ٱ</><l>ل</><g>نَّ</><p>ا</>رِ"},{"n":15,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you","হে"],["ٱلَّذِينَ","alladhīna","who","যারা"],["ءَامَنُوٓا۟","āmanū","believe","ঈমান এনেছো"],["إِذَا","idhā","When","যখন"],["لَقِيتُمُ","laqītumu","you meet","তোমরা সম্মুখীন হও"],["ٱلَّذِينَ","alladhīna","those who","(তাদের)যারা"],["كَفَرُوا۟","kafarū","disbelieve","অবিশ্বাস করেছে"],["زَحْفًۭا","zaḥfan","advancing","(সৈন্য) বাহিনী হিসেবে"],["فَلَا","falā","then (do) not","তখন না"],["تُوَلُّوهُمُ","tuwallūhumu","turn to them","দিকে ফিরাবে তাদের"],["ٱلْأَدْبَارَ","l-adbāra","the backs","পিঠসমূহকে"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَ<o>نُوٓ</><s>ا۟</> إِذَا لَقِيتُمُ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> زَحْ<k>فًۭا فَ</>لَا تُوَلُّوهُمُ <h>ٱ</>لْأَ<q>دْ</><p>بَا</>رَ"},{"n":16,"w":[["وَمَن","waman","And whoever","এবং যে"],["يُوَلِّهِمْ","yuwallihim","turns to them","দিকে ফিরাবে তাদের"],["يَوْمَئِذٍۢ","yawma-idhin","that day","সেদিন"],["دُبُرَهُۥٓ","duburahu","his back","পিঠ তার"],["إِلَّا","illā","except","এ ছাড়া যে"],["مُتَحَرِّفًۭا","mutaḥarrifan","(as) a strategy","কৌশল গ্রহণ (হিসেবে)"],["لِّقِتَالٍ","liqitālin","of war","জন্যে যুদ্ধের"],["أَوْ","aw","or","অথবা"],["مُتَحَيِّزًا","mutaḥayyizan","(to) join","মিলিত হওয়ার(জন্যে)"],["إِلَىٰ","ilā","to","সাথে"],["فِئَةٍۢ","fi-atin","a group","অপর দলের"],["فَقَدْ","faqad","certainly","তাহ'লে নিশ্চয়ই"],["بَآءَ","bāa","(he has) incurred","সে পরিবেষ্টিত হবে"],["بِغَضَبٍۢ","bighaḍabin","wrath","দিয়ে রাগ"],["مِّنَ","mina","of","পক্ষ হতে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["وَمَأْوَىٰهُ","wamawāhu","and his abode","এবং  আশ্রয়স্থল তার(হবে)"],["جَهَنَّمُ ۖ","jahannamu","(is) Hell","জাহান্নাম"],["وَبِئْسَ","wabi'sa","a wretched","এবং(তা) কত নিকৃষ্ট"],["ٱلْمَصِيرُ","l-maṣīru","destination","গন্তব্যস্থল"]],"t":"وَ<d>مَن يُ</>وَلِّهِمْ يَوْمَئِ<k>ذٍۢ دُ</>بُرَهُ<o>ۥٓ</> إِلَّا مُتَحَرِّ<w>فًۭا لِّ</>قِتَالٍ أَوْ مُتَحَيِّزًا إِلَىٰ فِئَ<k>ةٍۢ فَ</>قَ<q>دْ</> <o>بَآ</>ءَ بِغَضَ<d>بٍۢ مِّ</>نَ <h>ٱ</>للَّهِ وَمَأْوَ<m>ىٰ</>هُ جَهَ<g>نَّ</>مُ ۖ وَبِئْسَ <h>ٱ</>لْمَ<p>صِي</>رُ"},{"n":17,"w":[["فَلَمْ","falam","And not","আসলে কর নি"],["تَقْتُلُوهُمْ","taqtulūhum","you kill them","তোমরা হত্যা তাদেরকে"],["وَلَـٰكِنَّ","walākinna","but","কিন্তু"],["ٱللَّهَ","l-laha","Allah","আল্লাহই"],["قَتَلَهُمْ ۚ","qatalahum","killed them","হত্যা করেছেন তাদের"],["وَمَا","wamā","And not","এবং না"],["رَمَيْتَ","ramayta","you threw","তুমি নিক্ষেপ করেছিলে(কংকর)"],["إِذْ","idh","when","যখন"],["رَمَيْتَ","ramayta","you threw","তুমি নিক্ষেপ করেছিলে"],["وَلَـٰكِنَّ","walākinna","but","কিন্তু"],["ٱللَّهَ","l-laha","Allah","আল্লাহই"],["رَمَىٰ ۚ","ramā","threw","নিক্ষেপ করেছিলেন"],["وَلِيُبْلِىَ","waliyub'liya","and that He may test","এবং জন্যে পরীক্ষার"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believers","মু'মিনদেরকে"],["مِنْهُ","min'hu","from Him","হতে তা"],["بَلَآءً","balāan","(with) a trial","পরীক্ষা"],["حَسَنًا ۚ","ḥasanan","good","উত্তম"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["سَمِيعٌ","samī‘un","(is) All-Hearing","সবকিছু শুনেন"],["عَلِيمٌۭ","‘alīmun","All-Knowing","সবকিছু জানেন"]],"t":"فَلَمْ تَ<q>قْ</>تُلُوهُمْ وَ<m>لَٰ</>كِ<g>نَّ</> <h>ٱ</>للَّهَ قَتَلَهُمْ ۚ وَمَا رَمَيْتَ إِذْ رَمَيْتَ وَ<m>لَٰ</>كِ<g>نَّ</> <h>ٱ</>للَّهَ رَمَىٰ ۚ وَلِيُ<q>بْ</>لِىَ <h>ٱ</>لْمُؤْمِنِينَ مِنْهُ بَ<o>لَآ</>ءً حَسَنًا ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ سَمِيعٌ عَ<p>لِي</>مٌۭ"},{"n":18,"w":[["ذَٰلِكُمْ","dhālikum","That (is the case)","এ (আচরণ)তোমাদের (সাথে)"],["وَأَنَّ","wa-anna","and that","আর যে(কাফেরদের সাথে এরূপ)"],["ٱللَّهَ","l-laha","Allah (is)","আল্লাহই"],["مُوهِنُ","mūhinu","one who makes weak","দুর্বলকারী"],["كَيْدِ","kaydi","(the) plan","কৌশল"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","(of) the disbelievers","কাফেরদের"]],"t":"<m>ذَٰ</>لِكُمْ وَأَ<g>نَّ</> <h>ٱ</>للَّهَ مُوهِنُ كَيْدِ <h>ٱ</>لْ<m>كَٰ</>فِ<p>رِي</>نَ"},{"n":19,"w":[["إِن","in","If","(হে কাফেররা) যদি"],["تَسْتَفْتِحُوا۟","tastaftiḥū","you ask for victory","তোমরা মীমাংসা চাও"],["فَقَدْ","faqad","then certainly","তবে নিশ্চয়ই"],["جَآءَكُمُ","jāakumu","has come to you","কাছে এসেছে তোমাদের"],["ٱلْفَتْحُ ۖ","l-fatḥu","the victory","মীমাংসা"],["وَإِن","wa-in","And if","এবং যদি"],["تَنتَهُوا۟","tantahū","you desist","তোমরা বিরত হও"],["فَهُوَ","fahuwa","then it (is)","তবে তা"],["خَيْرٌۭ","khayrun","good","উত্তম"],["لَّكُمْ ۖ","lakum","for you","জন্যে তোমাদের"],["وَإِن","wa-in","but if","এবং যদি"],["تَعُودُوا۟","ta‘ūdū","you return","তোমরা পুনরাবৃত্তি করো"],["نَعُدْ","na‘ud","We will return (too)","পুনরাবৃত্তি করবো আমরা"],["وَلَن","walan","And never","এবং কখনও না"],["تُغْنِىَ","tugh'niya","will avail","কাজে আসবে"],["عَنكُمْ","‘ankum","you","জন্যে তোমাদের"],["فِئَتُكُمْ","fi-atukum","your forces","দলবল তোমাদের"],["شَيْـًۭٔا","shayan","anything","কিছুমাত্রই"],["وَلَوْ","walaw","even if","আর যদি"],["كَثُرَتْ","kathurat","(they are) numerous","অধিকও হয়(তবুও)"],["وَأَنَّ","wa-anna","And that","এবং (জেনে রেখো) যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["مَعَ","ma‘a","(is) with","সাথে(আছেন)"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believers","মু'মিনদের"]],"t":"إِ<k>ن تَ</>سْتَفْتِحُو<s>ا۟</> فَقَ<q>دْ</> <o>جَآ</>ءَكُمُ <h>ٱ</>لْفَتْحُ ۖ وَإِ<k>ن تَنتَ</>هُو<s>ا۟</> فَهُوَ خَيْ<w>رٌۭ لَّ</>كُمْ ۖ وَإِ<k>ن تَ</>عُودُو<s>ا۟</> نَعُ<q>دْ</> وَلَ<k>ن تُ</>غْنِىَ عَ<k>نكُ</>مْ فِئَتُكُمْ شَ<d>يْـًۭٔا وَ</>لَوْ كَثُرَتْ وَأَ<g>نَّ</> <h>ٱ</>للَّهَ مَعَ <h>ٱ</>لْمُؤْمِ<p>نِي</>نَ"},{"n":20,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you","হে"],["ٱلَّذِينَ","alladhīna","who","যারা"],["ءَامَنُوٓا۟","āmanū","believe","ঈমান এনেছো"],["أَطِيعُوا۟","aṭī‘ū","Obey","তোমরা আনুগত্য করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহর"],["وَرَسُولَهُۥ","warasūlahu","and His Messenger","ও রাসূলের তাঁর"],["وَلَا","walā","And (do) not","এবং না"],["تَوَلَّوْا۟","tawallaw","turn away","তোমরা মুখ ফিরাবে"],["عَنْهُ","‘anhu","from him","হতে তা"],["وَأَنتُمْ","wa-antum","while you","যখন তোমরা"],["تَسْمَعُونَ","tasma‘ūna","hear","তোমরা শুনছো"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَ<o>نُوٓ</><s>ا۟</> أَطِيعُو<s>ا۟</> <h>ٱ</>للَّهَ وَرَسُولَهُ<m>ۥ</> وَلَا تَوَلَّوْ<s>ا۟</> عَنْهُ وَأَ<k>نتُ</>مْ تَسْمَ<p>عُو</>نَ"},{"n":21,"w":[["وَلَا","walā","And (do) not","এবং না"],["تَكُونُوا۟","takūnū","be","তোমরা হয়ো"],["كَٱلَّذِينَ","ka-alladhīna","like those who","(তাদের) মতো যারা"],["قَالُوا۟","qālū","say","বলেছিলো"],["سَمِعْنَا","sami‘'nā","We heard","\"আমরা শুনলাম\""],["وَهُمْ","wahum","while they","অথচ তারা"],["لَا","lā","(do) not","না"],["يَسْمَعُونَ","yasma‘ūna","hear","তারা শোনে"]],"t":"وَلَا تَكُونُو<s>ا۟</> كَ<h>ٱ</>لَّذِينَ قَالُو<s>ا۟</> سَمِعْنَا وَهُمْ لَا يَسْمَ<p>عُو</>نَ"},{"n":22,"w":[["۞ إِنَّ","inna","Indeed","নিশ্চয়ই"],["شَرَّ","sharra","worst","নিকৃষ্ট"],["ٱلدَّوَآبِّ","l-dawābi","(of) the living creatures","জীবগুলোর(মধ্যে)"],["عِندَ","‘inda","near","কাছে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["ٱلصُّمُّ","l-ṣumu","(are) the deaf","(এসব) বধির"],["ٱلْبُكْمُ","l-buk'mu","the dumb ","বোবা"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["لَا","lā","(do) not","না"],["يَعْقِلُونَ","ya‘qilūna","use (their) intellect","বুদ্ধি কাজে লাগায়"]],"t":"۞ إِ<g>نَّ</> شَرَّ <h>ٱ</><l>ل</>دَّ<n>وَآ</>بِّ عِ<k>ندَ</> <h>ٱ</>للَّهِ <h>ٱ</><l>ل</>صُّ<g>مُّ</> <h>ٱ</>لْبُكْمُ <h>ٱ</>لَّذِينَ لَا يَعْقِ<p>لُو</>نَ"},{"n":23,"w":[["وَلَوْ","walaw","And if","এবং যদি"],["عَلِمَ","‘alima","(had) known","জানতেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["فِيهِمْ","fīhim","in them","মধ্যে তাদের(রয়েছে)"],["خَيْرًۭا","khayran","any good","কোনো কল্যাণ"],["لَّأَسْمَعَهُمْ ۖ","la-asma‘ahum","surely, He (would) have made them hear","অবশ্যই শুনাতেন তাদের"],["وَلَوْ","walaw","And if","এবং যদি"],["أَسْمَعَهُمْ","asma‘ahum","He had made them hear","তিনি শুনাতেনও তাদের"],["لَتَوَلَّوا۟","latawallaw","surely they would have turned away","অবশ্যই তারা মুখ ফিরাতো"],["وَّهُم","wahum","while they","ও তারা"],["مُّعْرِضُونَ","mu‘'riḍūna","(were) averse","উপেক্ষা করতো"]],"t":"وَلَوْ عَلِمَ <h>ٱ</>للَّهُ فِيهِمْ خَيْ<w>رًۭا لَّ</>أَسْمَعَهُمْ ۖ وَلَوْ أَسْمَعَهُمْ لَتَوَلَّو<s>ا۟</> وَّ<y>هُم مُّ</>عْرِ<p>ضُو</>نَ"},{"n":24,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you","হে"],["ٱلَّذِينَ","alladhīna","who","যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছো"],["ٱسْتَجِيبُوا۟","is'tajībū","Respond","তোমরা সাড়া দাও"],["لِلَّهِ","lillahi","to Allah","উদ্দেশ্যে আল্লাহর"],["وَلِلرَّسُولِ","walilrrasūli","and His Messenger","ও উদ্দেশ্যে রাসূলের (ডাকে)"],["إِذَا","idhā","when","যখন"],["دَعَاكُمْ","da‘ākum","he calls you","তিনি ডাকেন তোমাদেরকে"],["لِمَا","limā","to what","(তাই) তার জন্যে যা"],["يُحْيِيكُمْ ۖ","yuḥ'yīkum","gives you life","উদ্দীপ্ত করবে তোমাদেরকে"],["وَٱعْلَمُوٓا۟","wa-i‘'lamū","And know","এবং তোমরা জেনে রাখো"],["أَنَّ","anna","that","যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يَحُولُ","yaḥūlu","comes","অন্তরায় হয়ে থাকেন"],["بَيْنَ","bayna","(in) between","মাঝে"],["ٱلْمَرْءِ","l-mari","a man","ব্যক্তি"],["وَقَلْبِهِۦ","waqalbihi","and his heart","ও অন্তরের তার"],["وَأَنَّهُۥٓ","wa-annahu","and that","এবং (এও) যে"],["إِلَيْهِ","ilayhi","to Him","দিকে তাঁরই"],["تُحْشَرُونَ","tuḥ'sharūna","you will be gathered","তোমাদের একত্র করা হবে"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> <h>ٱ</>سْتَجِيبُو<s>ا۟</> لِلَّهِ وَلِلرَّسُولِ إِذَا دَعَاكُمْ لِمَا يُحْيِيكُمْ ۖ وَ<h>ٱ</>عْلَ<o>مُوٓ</><s>ا۟</> أَ<g>نَّ</> <h>ٱ</>للَّهَ يَحُولُ بَيْنَ <h>ٱ</>لْمَرْءِ وَقَلْبِ<m>هِۦ</> وَأَ<g>نَّ</>هُ<o>ۥٓ</> إِلَيْهِ تُحْشَ<p>رُو</>نَ"},{"n":25,"w":[["وَٱتَّقُوا۟","wa-ittaqū","And fear","ও তোমরা দূরে থাকো"],["فِتْنَةًۭ","fit'natan","a trial","ফিতনা (হতে)"],["لَّا","lā","not","(যা) না"],["تُصِيبَنَّ","tuṣībanna","which will afflict","(শুধু) পৌঁছবে"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["ظَلَمُوا۟","ẓalamū","do wrong","সীমালঙ্ঘন করেছে"],["مِنكُمْ","minkum","among you","মধ্য হতে তোমাদের"],["خَآصَّةًۭ ۖ","khāṣṣatan","exclusively","বিশেষভাবে"],["وَٱعْلَمُوٓا۟","wa-i‘'lamū","And know","এবং তোমরা জেনে রাখো"],["أَنَّ","anna","that","যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["شَدِيدُ","shadīdu","(is) severe","কঠোর"],["ٱلْعِقَابِ","l-‘iqābi","(in) the penalty","দন্ডদানে"]],"t":"وَ<h>ٱ</>تَّقُو<s>ا۟</> فِتْنَ<w>ةًۭ لَّ</>ا تُصِيبَ<g>نَّ</> <h>ٱ</>لَّذِينَ ظَلَمُو<s>ا۟</> مِ<k>نكُ</>مْ <n>خَآ</>صَّ<d>ةًۭ ۖ وَ</><h>ٱ</>عْلَ<o>مُوٓ</><s>ا۟</> أَ<g>نَّ</> <h>ٱ</>للَّهَ شَدِيدُ <h>ٱ</>لْعِ<p>قَا</><q>بِ</>"},{"n":26,"w":[["وَٱذْكُرُوٓا۟","wa-udh'kurū","And remember","এবং তোমরা স্বরণ করো"],["إِذْ","idh","when","যখন"],["أَنتُمْ","antum","you","তোমরা (ছিলে)"],["قَلِيلٌۭ","qalīlun","(were) few","স্বল্প (সংখ্যক)"],["مُّسْتَضْعَفُونَ","mus'taḍ‘afūna","(and) deemed weak","তোমাদেরকে দুর্বল মনে করে হতো"],["فِى","fī","in","উপর"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["تَخَافُونَ","takhāfūna","fearing","তোমরা ভয় করতে"],["أَن","an","that","যে"],["يَتَخَطَّفَكُمُ","yatakhaṭṭafakumu","might do away with you","নিশ্চিহ্ন করে ফেলবে তোমাদেরকে"],["ٱلنَّاسُ","l-nāsu","the men","মানুষেরা"],["فَـَٔاوَىٰكُمْ","faāwākum","then He sheltered you","তখন তিনি আশ্রয় দেন তোমাদেরকে"],["وَأَيَّدَكُم","wa-ayyadakum","and strengthened you","ও শক্তিশালী করেন তোমাদের"],["بِنَصْرِهِۦ","binaṣrihi","with His help","দিয়ে সাহায্য তাঁর"],["وَرَزَقَكُم","warazaqakum","and provided you","ও জীবিকা দেন তোমাদেরকে"],["مِّنَ","mina","of","হতে"],["ٱلطَّيِّبَـٰتِ","l-ṭayibāti","the good things","পবিত্র জিনিসগুলো"],["لَعَلَّكُمْ","la‘allakum","so that you may","যাতে তোমরা"],["تَشْكُرُونَ","tashkurūna","(be) thankful","কৃতজ্ঞতা প্রকাশ করো"]],"t":"وَ<h>ٱ</>ذْكُ<o>رُوٓ</><s>ا۟</> إِذْ أَ<k>نتُ</>مْ قَلِي<d>لٌۭ مُّ</>سْتَضْعَفُونَ فِى <h>ٱ</>لْأَرْضِ تَخَافُونَ <d>أَن يَ</>تَخَطَّفَكُمُ <h>ٱ</><l>ل</><g>نَّ</>اسُ فَـَٔاوَ<m>ىٰ</>كُمْ وَأَيَّدَ<f>كُم بِ</>نَصْرِ<m>هِۦ</> وَرَزَقَ<y>كُم مِّ</>نَ <h>ٱ</><l>ل</>طَّيِّ<m>بَٰ</>تِ لَعَلَّكُمْ تَشْكُ<p>رُو</>نَ"},{"n":27,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you","হে"],["ٱلَّذِينَ","alladhīna","who","যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছো"],["لَا","lā","(Do) not","না"],["تَخُونُوا۟","takhūnū","betray","তোমরা বিশ্বাস ভঙ্গ করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহর"],["وَٱلرَّسُولَ","wal-rasūla","and the Messenger","ও রাসূলের"],["وَتَخُونُوٓا۟","watakhūnū","or betray","এবং তোমরা বিশ্বাস ভঙ্গ করো (না)"],["أَمَـٰنَـٰتِكُمْ","amānātikum","your trusts","আমানতসমূহের তোমাদের"],["وَأَنتُمْ","wa-antum","while you","এমতাবস্হায় যে তোমরা"],["تَعْلَمُونَ","ta‘lamūna","know","জানো"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> لَا تَخُونُو<s>ا۟</> <h>ٱ</>للَّهَ وَ<h>ٱ</><l>ل</>رَّسُولَ وَتَخُو<o>نُوٓ</><s>ا۟</> أَ<m>مَٰنَٰ</>تِكُمْ وَأَ<k>نتُ</>مْ تَعْلَ<p>مُو</>نَ"},{"n":28,"w":[["وَٱعْلَمُوٓا۟","wa-i‘'lamū","And know","এবং তোমরা জেনে রাখো"],["أَنَّمَآ","annamā","that","প্রকৃতপক্ষে"],["أَمْوَٰلُكُمْ","amwālukum","your wealth","সম্পদগুলো তোমাদের"],["وَأَوْلَـٰدُكُمْ","wa-awlādukum","and your children","ও সন্তানেরা তোমাদের"],["فِتْنَةٌۭ","fit'natun","(are) a trial","পরীক্ষা (মাত্র)"],["وَأَنَّ","wa-anna","And that","এবং বাস্তবিকই"],["ٱللَّهَ","l-laha","Allah ","আল্লাহ"],["عِندَهُۥٓ","‘indahu","with Him","কাছে তাঁরই (আছে)"],["أَجْرٌ","ajrun","(is) a reward","পুরস্কার"],["عَظِيمٌۭ","‘aẓīmun","great","বিরাট"]],"t":"وَ<h>ٱ</>عْلَ<o>مُوٓ</><s>ا۟</> أَ<g>نَّ</><o>مَآ</> أَمْ<m>وَٰ</>لُكُمْ وَأَوْ<m>لَٰ</>دُكُمْ فِتْنَ<d>ةٌۭ وَ</>أَ<g>نَّ</> <h>ٱ</>للَّهَ عِ<k>ندَ</>هُ<o>ۥٓ</> أَ<q>جْ</>رٌ عَ<p>ظِي</>مٌۭ"},{"n":29,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you","হে"],["ٱلَّذِينَ","alladhīna","who","যারা"],["ءَامَنُوٓا۟","āmanū","believe","ঈমান এনেছো"],["إِن","in","If","যদি"],["تَتَّقُوا۟","tattaqū","you fear","তোমরা ভয় করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["يَجْعَل","yaj‘al","He will grant","তিনি দিবেন"],["لَّكُمْ","lakum","you","জন্যে তোমাদের"],["فُرْقَانًۭا","fur'qānan","a criterion","ন্যায়-অন্যায় পার্থক্যের কষ্টিপাথর"],["وَيُكَفِّرْ","wayukaffir","and will remove","এবং মোচন করবেন"],["عَنكُمْ","‘ankum","from you","হতে তোমাদের"],["سَيِّـَٔاتِكُمْ","sayyiātikum","your evil deeds","পাপগুলো তোমাদের"],["وَيَغْفِرْ","wayaghfir","and forgive","এবং ক্ষমা করবেন"],["لَكُمْ ۗ","lakum","you","প্রতি তোমাদের"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["ذُو","dhū","(is) the Possessor","সম্পন্ন"],["ٱلْفَضْلِ","l-faḍli","(of) Bounty","অনুগ্রহ"],["ٱلْعَظِيمِ","l-‘aẓīmi","the Great","মহান"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَ<o>نُوٓ</><s>ا۟</> إِ<k>ن تَ</>تَّقُو<s>ا۟</> <h>ٱ</>للَّهَ يَ<q>جْ</>عَل لَّكُمْ فُرْقَا<d>نًۭا وَ</>يُكَفِّرْ عَ<k>نكُ</>مْ سَيِّـَٔاتِكُمْ وَيَغْفِرْ لَكُمْ ۗ وَ<h>ٱ</>للَّهُ ذُو <h>ٱ</>لْفَضْلِ <h>ٱ</>لْعَ<p>ظِي</>مِ"},{"n":30,"w":[["وَإِذْ","wa-idh","And when","এবং (স্বরণ করো) যখন"],["يَمْكُرُ","yamkuru","plotted","ষড়যন্ত্র করেছিলো"],["بِكَ","bika","against you","বিরুদ্ধে তোমার"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieved","অস্বীকার করেছে"],["لِيُثْبِتُوكَ","liyuth'bitūka","that they restrain you","জন্যে তোমাকে তারা বন্দি করার"],["أَوْ","aw","or","বা"],["يَقْتُلُوكَ","yaqtulūka","kill you","তোমাকে তারা হত্যা করবে"],["أَوْ","aw","or","বা"],["يُخْرِجُوكَ ۚ","yukh'rijūka","drive you out","তোমাকে তারা নির্বাসিত করবে"],["وَيَمْكُرُونَ","wayamkurūna","And they were planning","এবং তারা ষড়যন্ত্র করবে"],["وَيَمْكُرُ","wayamkuru","and (also) was planning","আর পরিকল্পনা করেন"],["ٱللَّهُ ۖ","l-lahu","Allah","আল্লাহ"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["خَيْرُ","khayru","is (the) Best","উত্তম"],["ٱلْمَـٰكِرِينَ","l-mākirīna","(of) the Planners","পরিকল্পনাকারীদের"]],"t":"وَإِذْ يَمْكُرُ بِكَ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> لِيُثْبِتُوكَ أَوْ يَ<q>قْ</>تُلُوكَ أَوْ يُخْرِجُوكَ ۚ وَيَمْكُرُونَ وَيَمْكُرُ <h>ٱ</>للَّهُ ۖ وَ<h>ٱ</>للَّهُ خَيْرُ <h>ٱ</>لْ<m>مَٰ</>كِ<p>رِي</>نَ"},{"n":31,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["تُتْلَىٰ","tut'lā","are recited","তিলাওয়াত করা হয়"],["عَلَيْهِمْ","‘alayhim","to them","নিকট তাদের"],["ءَايَـٰتُنَا","āyātunā","Our Verses","আয়াতগুলো আমাদের"],["قَالُوا۟","qālū","they say","তারা বলে"],["قَدْ","qad","Verily","\"নিশ্চয়ই"],["سَمِعْنَا","sami‘'nā","we have heard","আমরা শুনলাম"],["لَوْ","law","if","যদি"],["نَشَآءُ","nashāu","we wish","ইচ্ছে করি আমরা"],["لَقُلْنَا","laqul'nā","surely, we could say","অবশ্যই আমরা বলতে পারি"],["مِثْلَ","mith'la","like","মতো"],["هَـٰذَآ ۙ","hādhā","this","এই (আয়াতগুলোর)"],["إِنْ","in","Not","নয়"],["هَـٰذَآ","hādhā","is this","এটা"],["إِلَّآ","illā","but","এ ছাড়া"],["أَسَـٰطِيرُ","asāṭīru","tales","উপকথাগুলো"],["ٱلْأَوَّلِينَ","l-awalīna","(of) the former (people)","পূর্বকালের লোকদের\""]],"t":"وَإِذَا تُتْلَىٰ عَلَيْهِمْ ءَا<m>يَٰ</>تُنَا قَالُو<s>ا۟</> قَ<q>دْ</> سَمِعْنَا لَوْ نَ<o>شَآ</>ءُ لَقُلْنَا مِثْلَ <m>هَٰ</><o>ذَآ ۙ</> إِنْ <m>هَٰ</><o>ذَآ</> إِ<o>لَّآ</> أَ<m>سَٰ</>طِيرُ <h>ٱ</>لْأَوَّ<p>لِي</>نَ"},{"n":32,"w":[["وَإِذْ","wa-idh","And when","এবং (স্মরণ করো) যখন"],["قَالُوا۟","qālū","they said","তারা বলেছিলো"],["ٱللَّهُمَّ","l-lahuma","O Allah","\"হে আল্লাহ"],["إِن","in","If","যদি"],["كَانَ","kāna","was","হয়"],["هَـٰذَا","hādhā","this","এটা"],["هُوَ","huwa","[it]","সেই"],["ٱلْحَقَّ","l-ḥaqa","the truth","সত্য"],["مِنْ","min","[of]","হতে"],["عِندِكَ","‘indika","from You","তোমার নিকট"],["فَأَمْطِرْ","fa-amṭir","then (send) rain","তবে বর্ষন করো"],["عَلَيْنَا","‘alaynā","upon us","উপর আমাদের"],["حِجَارَةًۭ","ḥijāratan","(of) stones","পাথর"],["مِّنَ","mina","from","হতে"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশ"],["أَوِ","awi","or","অথবা"],["ٱئْتِنَا","i'tinā","bring (upon) us","আমাদের উপর আসো"],["بِعَذَابٍ","bi‘adhābin","a punishment","নিয়ে শাস্তি"],["أَلِيمٍۢ","alīmin","painful","নিদারুণ\""]],"t":"وَإِذْ قَالُو<s>ا۟</> <h>ٱ</><l>ل</>لَّهُ<g>مَّ</> إِ<k>ن كَ</>انَ <m>هَٰ</>ذَا هُوَ <h>ٱ</>لْحَقَّ مِنْ عِ<k>ندِ</>كَ فَأَمْطِرْ عَلَيْنَا حِجَارَ<d>ةًۭ مِّ</>نَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ أَوِ <h>ٱ</>ئْتِنَا بِعَذَابٍ أَ<p>لِي</>مٍۢ"},{"n":33,"w":[["وَمَا","wamā","But not","এবং না"],["كَانَ","kāna","is","হয় (এমন যে)"],["ٱللَّهُ","l-lahu","(for) Allah","আল্লাহ"],["لِيُعَذِّبَهُمْ","liyu‘adhibahum","that He punishes them","যেন শাস্তি দিবেন তাদেরকে"],["وَأَنتَ","wa-anta","while you","যখন তুমি"],["فِيهِمْ ۚ","fīhim","(are) among them","মধ্যে তাদের(উপস্থিত আছো)"],["وَمَا","wamā","and not","এবং না"],["كَانَ","kāna","is","হয় (এমনও যে)"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["مُعَذِّبَهُمْ","mu‘adhibahum","the One Who punishes them","শাস্তিদানকারী তাদেরকে"],["وَهُمْ","wahum","while they","অথচ তারা"],["يَسْتَغْفِرُونَ","yastaghfirūna","seek forgiveness","ক্ষমা চাচ্ছে"]],"t":"وَمَا كَانَ <h>ٱ</>للَّهُ لِيُعَذِّبَهُمْ وَأَ<k>نتَ</> فِيهِمْ ۚ وَمَا كَانَ <h>ٱ</>للَّهُ مُعَذِّبَهُمْ وَهُمْ يَسْتَغْفِ<p>رُو</>نَ"},{"n":34,"w":[["وَمَا","wamā","But what","এবং (এখন এমন) কি (রয়েছে)"],["لَهُمْ","lahum","(is) for them","জন্যে তাদের"],["أَلَّا","allā","that not","যে না"],["يُعَذِّبَهُمُ","yu‘adhibahumu","(should) punish them","শাস্তি দিবেন তাদের"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ (যখন তুমি নাই)"],["وَهُمْ","wahum","while they","আর তারা"],["يَصُدُّونَ","yaṣuddūna","hinder (people)","(পথ) রোধ করছে"],["عَنِ","‘ani","from","হতে"],["ٱلْمَسْجِدِ","l-masjidi","Al-Masjid","মাসজীদুল"],["ٱلْحَرَامِ","l-ḥarāmi","Al-Haraam","হারাম"],["وَمَا","wamā","while not","অথচ না"],["كَانُوٓا۟","kānū","they are","তারা হলো"],["أَوْلِيَآءَهُۥٓ ۚ","awliyāahu","its guardians","তত্ত্বাবধায়ক তার"],["إِنْ","in","Not (can be)","(প্রকৃতপক্ষে) না"],["أَوْلِيَآؤُهُۥٓ","awliyāuhu","its guardians","তত্ত্বাবধায়ক তার"],["إِلَّا","illā","except","এ ছাড়া"],["ٱلْمُتَّقُونَ","l-mutaqūna","the ones who fear Allah","(যারা) মুত্তাক্বী"],["وَلَـٰكِنَّ","walākinna","but","কিন্তু"],["أَكْثَرَهُمْ","aktharahum","most of them","অধিকাংশ তাদের"],["لَا","lā","(do) not","না"],["يَعْلَمُونَ","ya‘lamūna","know","জানে"]],"t":"وَمَا لَهُمْ أَلَّا يُعَذِّبَهُمُ <h>ٱ</>للَّهُ وَهُمْ يَصُدُّونَ عَنِ <h>ٱ</>لْمَسْجِدِ <h>ٱ</>لْحَرَامِ وَمَا كَا<o>نُوٓ</><s>ا۟</> أَوْلِ<o>يَآ</>ءَهُ<o>ۥٓ ۚ</> إِنْ أَوْلِ<o>يَآ</>ؤُهُ<o>ۥٓ</> إِلَّا <h>ٱ</>لْمُتَّقُونَ وَ<m>لَٰ</>كِ<g>نَّ</> أَكْثَرَهُمْ لَا يَعْلَ<p>مُو</>نَ"},{"n":35,"w":[["وَمَا","wamā","And not","এবং না"],["كَانَ","kāna","was","ছিলো"],["صَلَاتُهُمْ","ṣalātuhum","their prayer","সালাত তাদের"],["عِندَ","‘inda","at","কাছে"],["ٱلْبَيْتِ","l-bayti","the House","(কা'বা) ঘরের"],["إِلَّا","illā","except","এ ছাড়া"],["مُكَآءًۭ","mukāan","whistling","শিষ দেওয়া"],["وَتَصْدِيَةًۭ ۚ","wataṣdiyatan","and clapping","ও করতালি বাজানো"],["فَذُوقُوا۟","fadhūqū","So taste","অতএব তোমরা স্বাদ নাও"],["ٱلْعَذَابَ","l-‘adhāba","the punishment","শাস্তির"],["بِمَا","bimā","because","এ কারণে যা"],["كُنتُمْ","kuntum","you used to","তোমরা ছিলে"],["تَكْفُرُونَ","takfurūna","disbelieve","তোমরা অবিশ্বাস করতে"]],"t":"وَمَا كَانَ صَلَاتُهُمْ عِ<k>ندَ</> <h>ٱ</>لْبَيْتِ إِلَّا مُ<o>كَآ</><d>ءًۭ وَ</>تَصْدِيَ<k>ةًۭ ۚ فَ</>ذُوقُو<s>ا۟</> <h>ٱ</>لْعَذَابَ بِمَا كُ<k>نتُ</>مْ تَكْفُ<p>رُو</>نَ"},{"n":36,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieve","অবিশ্বাস করেছে"],["يُنفِقُونَ","yunfiqūna","they spend","তারা ব্যয় করে"],["أَمْوَٰلَهُمْ","amwālahum","their wealth","সম্পদসমূহকে তাদের"],["لِيَصُدُّوا۟","liyaṣuddū","to hinder (people)","জন্যে বাধা দেওয়ার"],["عَن","‘an","from","হতে"],["سَبِيلِ","sabīli","(the) way","পথ"],["ٱللَّهِ ۚ","l-lahi","(of) Allah","আল্লাহর"],["فَسَيُنفِقُونَهَا","fasayunfiqūnahā","So they will spend it","অতঃপর অচিরেই তারা খরচ করতে থাকবে তা"],["ثُمَّ","thumma","then","এরপর"],["تَكُونُ","takūnu","it will be","তা হবে"],["عَلَيْهِمْ","‘alayhim","for them","উপর তাদের"],["حَسْرَةًۭ","ḥasratan","a regret","অাক্ষেপ"],["ثُمَّ","thumma","then","এরপর"],["يُغْلَبُونَ ۗ","yugh'labūna","they will be overcome","তারা পরাজিত হবে"],["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["كَفَرُوٓا۟","kafarū","disbelieve","অস্বীকার করেছে"],["إِلَىٰ","ilā","to","দিকে"],["جَهَنَّمَ","jahannama","Hell","জাহান্নামের"],["يُحْشَرُونَ","yuḥ'sharūna","they will be gathered","তাদের একত্র করা হবে"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> يُ<k>نفِ</>قُونَ أَمْ<m>وَٰ</>لَهُمْ لِيَصُدُّو<s>ا۟</> عَ<k>ن سَ</>بِيلِ <h>ٱ</>للَّهِ ۚ فَسَيُ<k>نفِ</>قُونَهَا ثُ<g>مَّ</> تَكُونُ عَلَيْهِمْ حَسْرَ<k>ةًۭ ثُ</><g>مَّ</> يُغْلَبُونَ ۗ وَ<h>ٱ</>لَّذِينَ كَفَ<o>رُوٓ</><s>ا۟</> إِلَىٰ جَهَ<g>نَّ</>مَ يُحْشَ<p>رُو</>نَ"},{"n":37,"w":[["لِيَمِيزَ","liyamīza","That may distinguish","যেন পৃথক করেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["ٱلْخَبِيثَ","l-khabītha","the wicked","অপবিত্রতাকে (অর্থাৎ কাফেরদেরকে)"],["مِنَ","mina","from","হতে"],["ٱلطَّيِّبِ","l-ṭayibi","the good","পবিত্রতা (অর্থাৎ মু'মিনদের)"],["وَيَجْعَلَ","wayaj‘ala","and place","ও রাখবেন"],["ٱلْخَبِيثَ","l-khabītha","the wicked","অপবিত্রতাকে"],["بَعْضَهُۥ","ba‘ḍahu","some of them","এককে তার"],["عَلَىٰ","‘alā","on","উপর"],["بَعْضٍۢ","ba‘ḍin","others","অন্যের"],["فَيَرْكُمَهُۥ","fayarkumahu","and heap them","অতঃপর তিনি জমা করবেন তা"],["جَمِيعًۭا","jamī‘an","all together","সকলকে"],["فَيَجْعَلَهُۥ","fayaj‘alahu","and put them","অতঃপর রাখবেন তা"],["فِى","fī","in","মধ্যে"],["جَهَنَّمَ ۚ","jahannama","Hell","জাহান্নামের"],["أُو۟لَـٰٓئِكَ","ulāika","Those ","ঐসবলোক"],["هُمُ","humu","they","তারাই"],["ٱلْخَـٰسِرُونَ","l-khāsirūna","(are) the losers","ক্ষতিগ্রস্ত"]],"t":"لِيَمِيزَ <h>ٱ</>للَّهُ <h>ٱ</>لْخَبِيثَ مِنَ <h>ٱ</><l>ل</>طَّيِّبِ وَيَ<q>جْ</>عَلَ <h>ٱ</>لْخَبِيثَ بَعْضَهُ<m>ۥ</> عَلَىٰ بَعْ<k>ضٍۢ فَ</>يَرْكُمَهُ<m>ۥ</> جَمِي<k>عًۭا فَ</>يَ<q>جْ</>عَلَهُ<m>ۥ</> فِى جَهَ<g>نَّ</>مَ ۚ أُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</>لْ<m>خَٰ</>سِ<p>رُو</>نَ"},{"n":38,"w":[["قُل","qul","Say","বলো"],["لِّلَّذِينَ","lilladhīna","to those who","উদ্দেশ্যে (তাদের) যারা"],["كَفَرُوٓا۟","kafarū","disbelieve","অবিশ্বাস করেছে"],["إِن","in","if","যদি"],["يَنتَهُوا۟","yantahū","they cease","তারা বিরত হয়"],["يُغْفَرْ","yugh'far","will be forgiven","ক্ষমা করে দেয়া হবে"],["لَهُم","lahum","for them","প্রতি তাদের"],["مَّا","mā","what","যা"],["قَدْ","qad","[verily]","নিশ্চিত"],["سَلَفَ","salafa","(is) past","অতীত হয়েছে"],["وَإِن","wa-in","But if","কিন্তু যদি"],["يَعُودُوا۟","ya‘ūdū","they return","তারা পুনরাবৃত্তি করে"],["فَقَدْ","faqad","then verily","তবে নিশ্চয়ই (সবার জানা যা)"],["مَضَتْ","maḍat","preceded","গত হয়েছে"],["سُنَّتُ","sunnatu","(the) practice","অনুসৃত রীতি"],["ٱلْأَوَّلِينَ","l-awalīna","(of) the former (people)","পুর্ববর্তীদের (ক্ষেত্রে)"]],"t":"قُل لِّلَّذِينَ كَفَ<o>رُوٓ</><s>ا۟</> <d>إِن يَ</><k>نتَ</>هُو<s>ا۟</> يُغْفَرْ لَ<y>هُم مَّ</>ا قَ<q>دْ</> سَلَفَ وَ<d>إِن يَ</>عُودُو<s>ا۟</> فَقَ<q>دْ</> مَضَتْ سُ<g>نَّ</>تُ <h>ٱ</>لْأَوَّ<p>لِي</>نَ"},{"n":39,"w":[["وَقَـٰتِلُوهُمْ","waqātilūhum","And fight them","তাদের সাথে তোমরা লড়াই করো"],["حَتَّىٰ","ḥattā","until","যতক্ষণ"],["لَا","lā","not","না"],["تَكُونَ","takūna","there is","থাকে (বাকী)"],["فِتْنَةٌۭ","fit'natun","oppression","ফিতনা"],["وَيَكُونَ","wayakūna","and is","এবং (প্রতিষ্ঠিত) হয়"],["ٱلدِّينُ","l-dīnu","the religion","দীন"],["كُلُّهُۥ","kulluhu","all of it","সামগ্রিকভাবে"],["لِلَّهِ ۚ","lillahi","for Allah","জন্যে আল্লাহরই"],["فَإِنِ","fa-ini","But if","অতঃপর যদি"],["ٱنتَهَوْا۟","intahaw","they cease","তারা বিরত হয়"],["فَإِنَّ","fa-inna","then indeed","তবে নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["بِمَا","bimā","of what","সে বিষয়ে যা"],["يَعْمَلُونَ","ya‘malūna","they do","তারা কাজ করেছে"],["بَصِيرٌۭ","baṣīrun","(is) All-Seer","খুব দেখছেন"]],"t":"وَ<m>قَٰ</>تِلُوهُمْ حَتَّىٰ لَا تَكُونَ فِتْنَ<d>ةٌۭ وَ</>يَكُونَ <h>ٱ</><l>ل</>دِّينُ كُلُّهُ<m>ۥ</> لِلَّهِ ۚ فَإِنِ <h>ٱ</><k>نتَ</>هَوْ<s>ا۟</> فَإِ<g>نَّ</> <h>ٱ</>للَّهَ بِمَا يَعْمَلُونَ بَ<p>صِي</>رٌۭ"},{"n":40,"w":[["وَإِن","wa-in","And if","এবং যদি"],["تَوَلَّوْا۟","tawallaw","they turn away","তারা মুখ ফিরিয়ে নেয়"],["فَٱعْلَمُوٓا۟","fa-i‘'lamū","then know","তবে তোমরা জেনে রাখো"],["أَنَّ","anna","that","যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["مَوْلَىٰكُمْ ۚ","mawlākum","(is) your Protector","অভিভাবক তোমাদের"],["نِعْمَ","ni‘'ma","Excellent","কত উত্তম"],["ٱلْمَوْلَىٰ","l-mawlā","(is) the Protector","অভিভাবক"],["وَنِعْمَ","wani‘'ma","and Excellent","ও কত উত্তম"],["ٱلنَّصِيرُ","l-naṣīru","(is) the Helper","সাহায্যকারী"]],"t":"وَإِ<k>ن تَ</>وَلَّوْ<s>ا۟</> فَ<h>ٱ</>عْلَ<o>مُوٓ</><s>ا۟</> أَ<g>نَّ</> <h>ٱ</>للَّهَ مَوْلَ<m>ىٰ</>كُمْ ۚ نِعْمَ <h>ٱ</>لْمَوْلَىٰ وَنِعْمَ <h>ٱ</><l>ل</><g>نَّ</><p>صِي</>رُ"},{"n":41,"w":[["۞ وَٱعْلَمُوٓا۟","wa-i‘'lamū","And know","আর তোমরা জেনে রাখো"],["أَنَّمَا","annamā","that what","মূলতঃ"],["غَنِمْتُم","ghanim'tum","you obtain (as) spoils of war","গণীমত পেয়েছো তোমরা"],["مِّن","min","of","থেকে"],["شَىْءٍۢ","shayin","anything","(যা) কিছু"],["فَأَنَّ","fa-anna","then that","তা নিশ্চয়ই"],["لِلَّهِ","lillahi","for Allah","জন্যে আল্লাহর"],["خُمُسَهُۥ","khumusahu","(is) one fifth of it","এক পঞ্চমাংশ তার"],["وَلِلرَّسُولِ","walilrrasūli","and for the Messenger","এবং জন্যে  রাসূলের"],["وَلِذِى","walidhī","and for the","ও জন্যে সম্পন্ন"],["ٱلْقُرْبَىٰ","l-qur'bā","near relatives","নৈকট্য"],["وَٱلْيَتَـٰمَىٰ","wal-yatāmā","and the orphans","ও ইয়াতিমদের"],["وَٱلْمَسَـٰكِينِ","wal-masākīni","and the needy","ও দরিদ্রদের"],["وَٱبْنِ","wa-ib'ni","and the","ও পুত্র"],["ٱلسَّبِيلِ","l-sabīli","wayfarer","পথের"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you","তোমরা থাকো"],["ءَامَنتُم","āmantum","believe","তোমরা ঈমান এনে"],["بِٱللَّهِ","bil-lahi","in Allah","উপর আল্লাহর"],["وَمَآ","wamā","and (in) what","এবং যা"],["أَنزَلْنَا","anzalnā","We sent down","আমরা অবতীর্ণ করেছি"],["عَلَىٰ","‘alā","to","উপর"],["عَبْدِنَا","‘abdinā","Our slave","আমাদের দাসদের (অর্থাৎ রাসূলের)"],["يَوْمَ","yawma","(on the) day","দিন"],["ٱلْفُرْقَانِ","l-fur'qāni","(of) the criterion","মীমাংসার"],["يَوْمَ","yawma","(the) day","(অর্থাৎ) দিন"],["ٱلْتَقَى","l-taqā","(when) met","সাক্ষাতের"],["ٱلْجَمْعَانِ ۗ","l-jam‘āni","the two forces","দু'দলের (বদরের যুদ্ধে)"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["عَلَىٰ","‘alā","(is) on","উপর"],["كُلِّ","kulli","every","সব"],["شَىْءٍۢ","shayin","thing","কিছুরই"],["قَدِيرٌ","qadīrun","All-Powerful","শক্তিশালী"]],"t":"۞ وَ<h>ٱ</>عْلَ<o>مُوٓ</><s>ا۟</> أَ<g>نَّ</>مَا غَنِمْ<y>تُم مِّ</><k>ن شَىْءٍۢ فَ</>أَ<g>نَّ</> لِلَّهِ خُمُسَهُ<m>ۥ</> وَلِلرَّسُولِ وَلِذِى <h>ٱ</>لْقُرْبَىٰ وَ<h>ٱ</>لْيَ<m>تَٰ</>مَىٰ وَ<h>ٱ</>لْمَ<m>سَٰ</>كِينِ وَ<h>ٱ</><q>بْ</>نِ <h>ٱ</><l>ل</>سَّبِيلِ إِ<k>ن كُنتُ</>مْ ءَامَ<k>نتُ</><f>م بِ</><h>ٱ</>للَّهِ وَ<o>مَآ</> أَ<k>نزَ</>لْنَا عَلَىٰ عَ<q>بْ</>دِنَا يَوْمَ <h>ٱ</>لْفُرْقَانِ يَوْمَ <h>ٱ</><l>لْ</>تَقَى <h>ٱ</>لْجَمْعَانِ ۗ وَ<h>ٱ</>للَّهُ عَلَىٰ كُلِّ <k>شَىْءٍۢ قَ</><p>دِي</>رٌ"},{"n":42,"w":[["إِذْ","idh","When","(স্মরণ করো) যখন"],["أَنتُم","antum","you (were)","তোমরা (ছিলে)"],["بِٱلْعُدْوَةِ","bil-‘ud'wati","on side of the valley","প্রান্তে উপত্যকার"],["ٱلدُّنْيَا","l-dun'yā","the nearer","নিকটতর"],["وَهُم","wahum","and they","ও তারা (ছিলো)"],["بِٱلْعُدْوَةِ","bil-‘ud'wati","(were) on the side","প্রান্তে উপত্যকার"],["ٱلْقُصْوَىٰ","l-quṣ'wā","the farther","দূরবর্তী"],["وَٱلرَّكْبُ","wal-rakbu","and the caravan","এবং উট বাহিনী  (বানিজ্য কাফেলা)"],["أَسْفَلَ","asfala","(was) lower","নিম্নভূমিতে"],["مِنكُمْ ۚ","minkum","than you","হতে তোমাদের"],["وَلَوْ","walaw","And if","এবং যদি"],["تَوَاعَدتُّمْ","tawā‘adttum","you (had) made an appointment","পরস্পরে (যুদ্ধ) নির্ধারণ করতে তোমরা"],["لَٱخْتَلَفْتُمْ","la-ikh'talaftum","certainly you would have failed","অবশ্যই মতভেদ করতে তোমরা"],["فِى","fī","in","ব্যাপারে"],["ٱلْمِيعَـٰدِ ۙ","l-mī‘ādi","the appointment","(যুদ্ধ) নির্ধারণের"],["وَلَـٰكِن","walākin","But","কিন্তু"],["لِّيَقْضِىَ","liyaqḍiya","that might accomplish","জন্যে মীমাংসা করার"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["أَمْرًۭا","amran","a matter","একটা বিষয়ে"],["كَانَ","kāna","(that) was","(যা) ছিলো"],["مَفْعُولًۭا","maf‘ūlan","destined","ঘটার (যুদ্ধে সমবেত করানো)"],["لِّيَهْلِكَ","liyahlika","that (might be) destroyed","যেন ধ্বংস হয়ে যায়"],["مَنْ","man","(those) who","যে (কেউ)"],["هَلَكَ","halaka","(were to be) destroyed","ধ্বংস হওয়ার"],["عَنۢ","‘an","on","ভিত্তিতে"],["بَيِّنَةٍۢ","bayyinatin","a clear evidence","সুস্পষ্ট প্রমাণের"],["وَيَحْيَىٰ","wayaḥyā","and (might) live","ও জীবিত থাকার"],["مَنْ","man","(those) who","যে (কেউ)"],["حَىَّ","ḥayya","(were to) live","জীবিত থাকবে"],["عَنۢ","‘an","on","ভিত্তিতে"],["بَيِّنَةٍۢ ۗ","bayyinatin","a clear evidence","সুস্পষ্ট প্রমাণের"],["وَإِنَّ","wa-inna","And indeed","ও নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَسَمِيعٌ","lasamī‘un","(is) All-Hearing","অবশ্যই সবকিছু শুনেন"],["عَلِيمٌ","‘alīmun","All-Knowing","সবকিছু জানেন"]],"t":"إِذْ أَ<k>نتُ</><f>م بِ</><h>ٱ</>لْعُ<q>دْ</>وَةِ <h>ٱ</><l>ل</>دُّنْيَا وَ<f>هُم بِ</><h>ٱ</>لْعُ<q>دْ</>وَةِ <h>ٱ</>لْقُصْوَىٰ وَ<h>ٱ</><l>ل</>رَّكْبُ أَسْفَلَ مِ<k>نكُ</>مْ ۚ وَلَوْ تَوَاعَ<j>د</>تُّمْ لَ<h>ٱ</>خْتَلَفْتُمْ فِى <h>ٱ</>لْمِي<m>عَٰ</>دِ ۙ وَ<m>لَٰ</><w>كِن لِّ</>يَ<q>قْ</>ضِىَ <h>ٱ</>للَّهُ أَمْ<k>رًۭا كَ</>انَ مَفْعُولًۭ<w>ا لِّ</>يَهْلِكَ مَنْ هَلَكَ <i>عَنۢ بَ</>يِّنَ<d>ةٍۢ وَ</>يَحْيَىٰ مَنْ حَىَّ <i>عَنۢ بَ</>يِّنَ<d>ةٍۢ ۗ وَ</>إِ<g>نَّ</> <h>ٱ</>للَّهَ لَسَمِيعٌ عَ<p>لِي</>مٌ"},{"n":43,"w":[["إِذْ","idh","When","যখন"],["يُرِيكَهُمُ","yurīkahumu","you (where) shown them","তোমাকে দেখান তাদেরকে"],["ٱللَّهُ","l-lahu","(by) Allah","আল্লাহ"],["فِى","fī","in","মধ্যে"],["مَنَامِكَ","manāmika","your dream","তোমার স্বপ্নের"],["قَلِيلًۭا ۖ","qalīlan","(as) few","স্বল্প (সংখ্যক)"],["وَلَوْ","walaw","and if","এবং যদি"],["أَرَىٰكَهُمْ","arākahum","He had shown them to you","তোমাকে দেখাতেন তাদেরকে"],["كَثِيرًۭا","kathīran","(as) many","অধিক (সংখ্যক)"],["لَّفَشِلْتُمْ","lafashil'tum","surely you would have lost courage","অবশ্যই সাহস হারাতে তোমরা"],["وَلَتَنَـٰزَعْتُمْ","walatanāza‘tum","and surely you would have disputed","ও অবশ্যই বিবাদ করতে তোমরা"],["فِى","fī","in","ব্যাপারে"],["ٱلْأَمْرِ","l-amri","the matter","কাজের (অর্থাৎ যুদ্ধের)"],["وَلَـٰكِنَّ","walākinna","but","কিন্তু"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["سَلَّمَ ۗ","sallama","saved (you)","নিরাপদ করেছিলেন (তা থেকে)"],["إِنَّهُۥ","innahu","Indeed, He","নিশ্চয়ই তিনি"],["عَلِيمٌۢ","‘alīmun","(is) All-Knower","খুব জানেন"],["بِذَاتِ","bidhāti","of what is in","অবস্থার"],["ٱلصُّدُورِ","l-ṣudūri","the breasts","অন্তরসমূহের"]],"t":"إِذْ يُرِيكَهُمُ <h>ٱ</>للَّهُ فِى مَنَامِكَ قَلِيلًۭ<d>ا ۖ وَ</>لَوْ أَرَ<m>ىٰ</>كَهُمْ كَثِي<w>رًۭا لَّ</>فَشِلْتُمْ وَلَتَ<m>نَٰ</>زَعْتُمْ فِى <h>ٱ</>لْأَمْرِ وَ<m>لَٰ</>كِ<g>نَّ</> <h>ٱ</>للَّهَ سَلَّمَ ۗ إِ<g>نَّ</>هُ<m>ۥ</> عَلِي<i>مٌۢ بِ</>ذَاتِ <h>ٱ</><l>ل</>صُّ<p>دُو</>رِ"},{"n":44,"w":[["وَإِذْ","wa-idh","And when","এবং (স্মরণ করো) যখন"],["يُرِيكُمُوهُمْ","yurīkumūhum","He showed them to you","তোমাদেরকে দেখালেন তাদেরকে"],["إِذِ","idhi","when","যখন"],["ٱلْتَقَيْتُمْ","l-taqaytum","you met ","মুখোমুখি হয়েছিলে তোমরা"],["فِىٓ","fī","in","মধ্যে"],["أَعْيُنِكُمْ","a‘yunikum","your eyes","তোমাদের চোখের"],["قَلِيلًۭا","qalīlan","(as) few","স্বল্প (সংখ্যক)"],["وَيُقَلِّلُكُمْ","wayuqallilukum","and He made you (appear) as few","স্বল্প করে দেখালেন তোমাদেরকে"],["فِىٓ","fī","in","মধ্যে"],["أَعْيُنِهِمْ","a‘yunihim","their eyes","তাদের চোখের"],["لِيَقْضِىَ","liyaqḍiya","that might accomplish","যেন সম্পন্ন করেন"],["ٱللَّهُ","l-lahu","Allah might accomplish","আল্লাহ"],["أَمْرًۭا","amran","a matter","একটি কাজ"],["كَانَ","kāna","(that) was","(যা) ছিলো"],["مَفْعُولًۭا ۗ","maf‘ūlan","(already) destined","ঘটার"],["وَإِلَى","wa-ilā","And to","এবং দিকে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহরই"],["تُرْجَعُ","tur'ja‘u","return","প্রত্যাবর্তিত হয়"],["ٱلْأُمُورُ","l-umūru","(all) the matters","সব ব্যাপার"]],"t":"وَإِذْ يُرِيكُمُوهُمْ إِذِ <h>ٱ</><l>لْ</>تَقَيْتُمْ <o>فِىٓ</> أَعْيُنِكُمْ قَلِيلًۭ<d>ا وَ</>يُقَلِّلُكُمْ <o>فِىٓ</> أَعْيُنِهِمْ لِيَ<q>قْ</>ضِىَ <h>ٱ</>للَّهُ أَمْ<k>رًۭا كَ</>انَ مَفْعُولًۭ<d>ا ۗ وَ</>إِلَى <h>ٱ</>للَّهِ تُرْجَعُ <h>ٱ</>لْأُ<p>مُو</>رُ"},{"n":45,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you","হে"],["ٱلَّذِينَ","alladhīna","who","যারা"],["ءَامَنُوٓا۟","āmanū","believe","ঈমান এনেছো"],["إِذَا","idhā","When","যখন"],["لَقِيتُمْ","laqītum","you meet","তোমরা মোকাবেলা করো"],["فِئَةًۭ","fi-atan","a force","কোনো দলের (সাথে)"],["فَٱثْبُتُوا۟","fa-uth'butū","then be firm","তখন তোমরা দৃঢ় থাকো"],["وَٱذْكُرُوا۟","wa-udh'kurū","and remember","ও তোমরা স্মরণ করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["كَثِيرًۭا","kathīran","much","অধিক মাত্রায়"],["لَّعَلَّكُمْ","la‘allakum","so that you may","যাতে তোমরা"],["تُفْلِحُونَ","tuf'liḥūna","(be) successful","সফলকাম হও"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَ<o>نُوٓ</><s>ا۟</> إِذَا لَقِيتُمْ فِئَ<k>ةًۭ فَ</><h>ٱ</>ثْبُتُو<s>ا۟</> وَ<h>ٱ</>ذْكُرُو<s>ا۟</> <h>ٱ</>للَّهَ كَثِي<w>رًۭا لَّ</>عَلَّكُمْ تُفْلِ<p>حُو</>نَ"},{"n":46,"w":[["وَأَطِيعُوا۟","wa-aṭī‘ū","And obey","এবং তোমরা আনুগত্য করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহর"],["وَرَسُولَهُۥ","warasūlahu","and His Messenger","ও রাসূলের তাঁর"],["وَلَا","walā","and (do) not","এবং না"],["تَنَـٰزَعُوا۟","tanāza‘ū","dispute","তোমরা বিবাদ করো"],["فَتَفْشَلُوا۟","fatafshalū","lest you lose courage","তাহ'লে তোমরা সাহস হারাবে"],["وَتَذْهَبَ","watadhhaba","and (would) depart","ও চলে যাবে"],["رِيحُكُمْ ۖ","rīḥukum","your strength","শক্তি তোমাদের"],["وَٱصْبِرُوٓا۟ ۚ","wa-iṣ'birū","and be patient","এবং তোমরা ধৈর্য ধরো"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["مَعَ","ma‘a","(is) with","সাথে (থাকেন)"],["ٱلصَّـٰبِرِينَ","l-ṣābirīna","the patient ones","ধৈর্যশীলদের"]],"t":"وَأَطِيعُو<s>ا۟</> <h>ٱ</>للَّهَ وَرَسُولَهُ<m>ۥ</> وَلَا تَ<m>نَٰ</>زَعُو<s>ا۟</> فَتَفْشَلُو<s>ا۟</> وَتَذْهَبَ رِيحُكُمْ ۖ وَ<h>ٱ</>صْبِ<o>رُوٓ</><s>ا۟</> ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ مَعَ <h>ٱ</><l>ل</><m>صَّٰ</>بِ<p>رِي</>نَ"},{"n":47,"w":[["وَلَا","walā","And (do) not","এবং না"],["تَكُونُوا۟","takūnū","be","তোমরা হয়ো"],["كَٱلَّذِينَ","ka-alladhīna","like those who","(তাদের) মতো যারা"],["خَرَجُوا۟","kharajū","came forth","বের হয়েছিলো"],["مِن","min","from","থেকে"],["دِيَـٰرِهِم","diyārihim","their homes","ঘরগুলো তাদের"],["بَطَرًۭا","baṭaran","boastfully","গর্বভরে"],["وَرِئَآءَ","wariāa","and showing off","ও দেখানোর (জন্যে)"],["ٱلنَّاسِ","l-nāsi","(to) the people","লোকদের"],["وَيَصُدُّونَ","wayaṣuddūna","and hinder (them)","ও তারা বাধা দেয়"],["عَن","‘an","from","হতে"],["سَبِيلِ","sabīli","(the) way","পথ"],["ٱللَّهِ ۚ","l-lahi","(of) Allah","আল্লাহর"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["بِمَا","bimā","of what","ঐবিষয়ে যা"],["يَعْمَلُونَ","ya‘malūna","they do","তারা কাজ করেছে"],["مُحِيطٌۭ","muḥīṭun","(is) All-Encompassing","পরিবেষ্টনকারী"]],"t":"وَلَا تَكُونُو<s>ا۟</> كَ<h>ٱ</>لَّذِينَ خَرَجُو<s>ا۟</> مِ<k>ن دِ</><m>يَٰ</>رِ<f>هِم بَ</>طَ<d>رًۭا وَ</>رِ<o>ئَآ</>ءَ <h>ٱ</><l>ل</><g>نَّ</>اسِ وَيَصُدُّونَ عَ<k>ن سَ</>بِيلِ <h>ٱ</>للَّهِ ۚ وَ<h>ٱ</>للَّهُ بِمَا يَعْمَلُونَ مُ<p>حِي</><q>طٌۭ</>"},{"n":48,"w":[["وَإِذْ","wa-idh","And when","এবং যখন"],["زَيَّنَ","zayyana","made fair-seeming","শোভন করেছিলো"],["لَهُمُ","lahumu","to them","জন্যে তাদের"],["ٱلشَّيْطَـٰنُ","l-shayṭānu","the Shaitaan","শয়তান"],["أَعْمَـٰلَهُمْ","a‘mālahum","their deeds","কাজগুলোকে তাদের"],["وَقَالَ","waqāla","and he said","এবং বলেছিলো"],["لَا","lā","No (one)","\"না"],["غَالِبَ","ghāliba","(can) overcome","বিজয়ী হবে"],["لَكُمُ","lakumu","[to] you","উপর তোমাদের"],["ٱلْيَوْمَ","l-yawma","today","আজ"],["مِنَ","mina","from","মধ্য থেকে (কেউ)"],["ٱلنَّاسِ","l-nāsi","the people","মানুষদের"],["وَإِنِّى","wa-innī","and indeed, I am","এবং নিশ্চয়ই আমি"],["جَارٌۭ","jārun","a neighbor","প্রতিবেশী"],["لَّكُمْ ۖ","lakum","for you","তোমাদের\""],["فَلَمَّا","falammā","But when","অতঃপর যখন"],["تَرَآءَتِ","tarāati","came in sight","পরস্পরে সম্মুখীন হলো"],["ٱلْفِئَتَانِ","l-fi-atāni","the two forces","দু'দল"],["نَكَصَ","nakaṣa","he turned away","সে সড়ে পড়লো"],["عَلَىٰ","‘alā","on","উপর"],["عَقِبَيْهِ","‘aqibayhi","his heels","দু'গোড়ালীর (অর্থাৎ পেছন দিকে)"],["وَقَالَ","waqāla","and said","এবং বললো"],["إِنِّى","innī","Indeed, I am","\"নিশ্চয়ই আমি"],["بَرِىٓءٌۭ","barīon","free","দায়িত্বমুক্ত"],["مِّنكُمْ","minkum","of you","থেকে তোমাদের"],["إِنِّىٓ","innī","Indeed, I","নিশ্চয়ই আমি"],["أَرَىٰ","arā","see","দেখছি (ফেরেশতাদের)"],["مَا","mā","what","যা"],["لَا","lā","not","না"],["تَرَوْنَ","tarawna","you see","তোমরা দেখতে পাচ্ছো"],["إِنِّىٓ","innī","indeed, I","নিশ্চয়ই আমি"],["أَخَافُ","akhāfu","[I] fear","ভয় করি"],["ٱللَّهَ ۚ","l-laha","Allah","আল্লাহকে"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["شَدِيدُ","shadīdu","(is) severe","কঠোর"],["ٱلْعِقَابِ","l-‘iqābi","(in) the penalty","দন্ডদানে\""]],"t":"وَإِذْ زَيَّنَ لَهُمُ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نُ أَعْ<m>مَٰ</>لَهُمْ وَقَالَ لَا غَالِبَ لَكُمُ <h>ٱ</>لْيَوْمَ مِنَ <h>ٱ</><l>ل</><g>نَّ</>اسِ وَإِ<g>نِّ</>ى جَا<w>رٌۭ لَّ</>كُمْ ۖ فَلَ<g>مَّ</>ا تَ<o>رَآ</>ءَتِ <h>ٱ</>لْفِئَتَانِ نَكَصَ عَلَىٰ عَقِبَيْهِ وَقَالَ إِ<g>نِّ</>ى بَ<o>رِىٓ</><d>ءٌۭ مِّ</><k>نكُ</>مْ إِ<g>نِّ</><o>ىٓ</> أَرَىٰ مَا لَا تَرَوْنَ إِ<g>نِّ</><o>ىٓ</> أَخَافُ <h>ٱ</>للَّهَ ۚ وَ<h>ٱ</>للَّهُ شَدِيدُ <h>ٱ</>لْعِ<p>قَا</><q>بِ</>"},{"n":49,"w":[["إِذْ","idh","When","(স্মরণ করো) যখন"],["يَقُولُ","yaqūlu","said","বলেছিলো"],["ٱلْمُنَـٰفِقُونَ","l-munāfiqūna","the hypocrites","মুনাফিক্বরা"],["وَٱلَّذِينَ","wa-alladhīna","and those who ","ও যাদের"],["فِى","fī","in","মধ্যে (আছে)"],["قُلُوبِهِم","qulūbihim","their hearts","অন্তরসমূহে তাদের"],["مَّرَضٌ","maraḍun","(was) a disease","রোগ"],["غَرَّ","gharra","(Had) deluded","\"ধোঁকা দিয়েছে"],["هَـٰٓؤُلَآءِ","hāulāi","these (people)","এদেরকে"],["دِينُهُمْ ۗ","dīnuhum","their religion","দীন তাদের\""],["وَمَن","waman","But whoever","অথচ যে কেউ"],["يَتَوَكَّلْ","yatawakkal","puts (his) trust","নির্ভর করে"],["عَلَى","‘alā","in","উপর"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["فَإِنَّ","fa-inna","then indeed","তবে নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহই"],["عَزِيزٌ","‘azīzun","(is) All-Mighty","পরাক্রমশালী"],["حَكِيمٌۭ","ḥakīmun","All-Wise","মহাবিজ্ঞ\""]],"t":"إِذْ يَقُولُ <h>ٱ</>لْمُ<m>نَٰ</>فِقُونَ وَ<h>ٱ</>لَّذِينَ فِى قُلُوبِ<y>هِم مَّ</>رَضٌ غَرَّ <o>هَٰٓؤُلَآ</>ءِ دِينُهُمْ ۗ وَ<d>مَن يَ</>تَوَكَّلْ عَلَى <h>ٱ</>للَّهِ فَإِ<g>نَّ</> <h>ٱ</>للَّهَ عَزِيزٌ حَ<p>كِي</>مٌۭ"},{"n":50,"w":[["وَلَوْ","walaw","And if","এবং যদি"],["تَرَىٰٓ","tarā","you (could) see","দেখতে তুমি"],["إِذْ","idh","when","যখন"],["يَتَوَفَّى","yatawaffā","take away souls","প্রাণ কেড়ে নেয়"],["ٱلَّذِينَ","alladhīna","(of) those who","(তাদেরকে) যারা"],["كَفَرُوا۟ ۙ","kafarū","disbelieve","অবিশ্বাস করেছে"],["ٱلْمَلَـٰٓئِكَةُ","l-malāikatu","the Angels","ফেরেশতারা"],["يَضْرِبُونَ","yaḍribūna","striking","তারা আঘাত করে"],["وُجُوهَهُمْ","wujūhahum","their faces","মুখমণ্ডলগুলোতে তাদের"],["وَأَدْبَـٰرَهُمْ","wa-adbārahum","and their backs","ও পিঠগুলোতে তাদের"],["وَذُوقُوا۟","wadhūqū","Taste","\"এবং (বলো) তোমরা স্বাদ নাও"],["عَذَابَ","‘adhāba","(the) punishment","শাস্তির"],["ٱلْحَرِيقِ","l-ḥarīqi","(of) the Blazing Fire","দহনের\""]],"t":"وَلَوْ تَرَ<o>ىٰٓ</> إِذْ يَتَوَفَّى <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟ ۙ</> <h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةُ يَضْرِبُونَ وُجُوهَهُمْ وَأَ<q>دْ</><m>بَٰ</>رَهُمْ وَذُوقُو<s>ا۟</> عَذَابَ <h>ٱ</>لْحَ<p>رِي</><q>قِ</>"},{"n":51,"w":[["ذَٰلِكَ","dhālika","That","এটা"],["بِمَا","bimā","(is) for what","একারণে যা"],["قَدَّمَتْ","qaddamat","sent forth","আগে পাঠিয়েছে"],["أَيْدِيكُمْ","aydīkum","your hands","হাতগুলো তাদের"],["وَأَنَّ","wa-anna","And indeed","এবং (এটা সত্য যে)"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَيْسَ","laysa","(is) not","নন"],["بِظَلَّـٰمٍۢ","biẓallāmin","unjust","অত্যাচারী"],["لِّلْعَبِيدِ","lil'‘abīdi","to His slaves","প্রতি দাসদের"]],"t":"<m>ذَٰ</>لِكَ بِمَا قَدَّمَتْ أَيْدِيكُمْ وَأَ<g>نَّ</> <h>ٱ</>للَّهَ لَيْسَ بِظَ<m>لَّٰ</><w>مٍۢ لِّ</>لْعَ<p>بِي</><q>دِ</>"},{"n":52,"w":[["كَدَأْبِ","kadabi","Like (the) way","মতো অভ্যাসের"],["ءَالِ","āli","(of) people","বংশধরদের"],["فِرْعَوْنَ ۙ","fir'‘awna","(of) Firaun","ফিরাউনের"],["وَٱلَّذِينَ","wa-alladhīna","and those who","এবং যারা(ছিলো)"],["مِن","min","(were) from","থেকে"],["قَبْلِهِمْ ۚ","qablihim","before them","পূর্ব তাদের(এদের সাথে তাই হবে)"],["كَفَرُوا۟","kafarū","They disbelieved","তারা অবিশ্বাস করেছিলো"],["بِـَٔايَـٰتِ","biāyāti","in (the) Signs","সাথে নিদর্শনগুলোর"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["فَأَخَذَهُمُ","fa-akhadhahumu","so seized them","তাই ধরেছিলেন তাদেরকে"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["بِذُنُوبِهِمْ ۗ","bidhunūbihim","for their sins","কারণে পাপগুলোর তাদের"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["قَوِىٌّۭ","qawiyyun","(is) All-Strong","শক্তিশালী"],["شَدِيدُ","shadīdu","(and) severe","কঠোর"],["ٱلْعِقَابِ","l-‘iqābi","(in) the penalty","দন্ডদানে"]],"t":"كَدَأْبِ ءَالِ فِرْعَوْنَ ۙ وَ<h>ٱ</>لَّذِينَ مِ<k>ن قَ</><q>بْ</>لِهِمْ ۚ كَفَرُو<s>ا۟</> بِـَٔا<m>يَٰ</>تِ <h>ٱ</>للَّهِ فَأَخَذَهُمُ <h>ٱ</>للَّهُ بِذُنُوبِهِمْ ۗ إِ<g>نَّ</> <h>ٱ</>للَّهَ قَوِ<k>ىٌّۭ شَ</>دِيدُ <h>ٱ</>لْعِ<p>قَا</><q>بِ</>"},{"n":53,"w":[["ذَٰلِكَ","dhālika","That","এটা"],["بِأَنَّ","bi-anna","(is) because","এজন্যে যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَمْ","lam","not","না"],["يَكُ","yaku","is","ছিলেন"],["مُغَيِّرًۭا","mughayyiran","One Who changes","পরিবর্তনকারী"],["نِّعْمَةً","ni‘'matan","a favor","(তাঁর)অনুগ্রহের"],["أَنْعَمَهَا","an‘amahā","which He had bestowed","যা তিনি দান করেছেন"],["عَلَىٰ","‘alā","on","উপর"],["قَوْمٍ","qawmin","a people","সম্প্রদায়ের"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["يُغَيِّرُوا۟","yughayyirū","they change","তারা পরিবর্তন করে"],["مَا","mā","what","তা"],["بِأَنفُسِهِمْ ۙ","bi-anfusihim","(is) in themselves","উপর নিজেদের তাদের"],["وَأَنَّ","wa-anna","And indeed","এবং (এও) যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["سَمِيعٌ","samī‘un","(is) All-Hearing","সবকিছু শুনেন"],["عَلِيمٌۭ","‘alīmun","All-Knowing","সবকিছু জানেন"]],"t":"<m>ذَٰ</>لِكَ بِأَ<g>نَّ</> <h>ٱ</>للَّهَ لَمْ يَكُ مُغَيِّ<d>رًۭا نِّ</>عْمَةً أَنْعَمَهَا عَلَىٰ قَوْمٍ حَتَّىٰ يُغَيِّرُو<s>ا۟</> مَا بِأَ<k>نفُ</>سِهِمْ ۙ وَأَ<g>نَّ</> <h>ٱ</>للَّهَ سَمِيعٌ عَ<p>لِي</>مٌۭ"},{"n":54,"w":[["كَدَأْبِ","kadabi","Like (the) way","মতো স্বভাবের"],["ءَالِ","āli","(of) people","বংশধরদের"],["فِرْعَوْنَ ۙ","fir'‘awna","(of) Firaun","ফিরাউনের"],["وَٱلَّذِينَ","wa-alladhīna","and those who","ও যারা (ছিলো)"],["مِن","min","(were) from","থেকে"],["قَبْلِهِمْ ۚ","qablihim","before them","পূর্ব তাদের(এদের সাথে তাই হবে)"],["كَذَّبُوا۟","kadhabū","They denied","তারা অস্বীকার করেছিলো"],["بِـَٔايَـٰتِ","biāyāti","(the) Signs","প্রতি নিদর্শনগুলোর"],["رَبِّهِمْ","rabbihim","(of) their Lord","রবের তাদের"],["فَأَهْلَكْنَـٰهُم","fa-ahlaknāhum","so We destroyed them","তাই ধ্বংস করেছিলাম আমরা তাদেরকে"],["بِذُنُوبِهِمْ","bidhunūbihim","for their sins","কারণে পাপসমূহের তাদের"],["وَأَغْرَقْنَآ","wa-aghraqnā","and We drowned","এবং ডুবিয়ে দিয়েছিলাম আমরা"],["ءَالَ","āla","(the) people","বংশধরদের"],["فِرْعَوْنَ ۚ","fir'‘awna","(of) Firaun","ফিরআউনের"],["وَكُلٌّۭ","wakullun","and (they) all","এবং সবাই"],["كَانُوا۟","kānū","were","তারা ছিলো"],["ظَـٰلِمِينَ","ẓālimīna","wrongdoers","সীমালঙ্ঘনকারী"]],"t":"كَدَأْبِ ءَالِ فِرْعَوْنَ ۙ وَ<h>ٱ</>لَّذِينَ مِ<k>ن قَ</><q>بْ</>لِهِمْ ۚ كَذَّبُو<s>ا۟</> بِـَٔا<m>يَٰ</>تِ رَبِّهِمْ فَأَهْلَكْ<m>نَٰ</><f>هُم بِ</>ذُنُوبِهِمْ وَأَغْرَ<q>قْ</><o>نَآ</> ءَالَ فِرْعَوْنَ ۚ وَكُ<k>لٌّۭ كَ</>انُو<s>ا۟</> <m>ظَٰ</>لِ<p>مِي</>نَ"},{"n":55,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["شَرَّ","sharra","(the) worst","নিকৃষ্ট"],["ٱلدَّوَآبِّ","l-dawābi","(of) the living creatures","বিচরণশীল জীবদের (মধ্যে তারাই)"],["عِندَ","‘inda","near","কাছে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["ٱلَّذِينَ","alladhīna","(are) those who","যারা"],["كَفَرُوا۟","kafarū","disbelieve","অস্বীকার করেছে"],["فَهُمْ","fahum","and they","অতঃপর তারা"],["لَا","lā","(will) not","না"],["يُؤْمِنُونَ","yu'minūna","believe","ঈমান আনে"]],"t":"إِ<g>نَّ</> شَرَّ <h>ٱ</><l>ل</>دَّ<n>وَآ</>بِّ عِ<k>ندَ</> <h>ٱ</>للَّهِ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> فَهُمْ لَا يُؤْمِ<p>نُو</>نَ"},{"n":56,"w":[["ٱلَّذِينَ","alladhīna","Those who ","যাদের (সাথে)"],["عَـٰهَدتَّ","‘āhadtta","you made a covenant","তুমি সন্ধিচুক্তি করেছো"],["مِنْهُمْ","min'hum","with them","মধ্য হতে তাদের"],["ثُمَّ","thumma","then","এরপর"],["يَنقُضُونَ","yanquḍūna","they break","তারা ভঙ্গ করে"],["عَهْدَهُمْ","‘ahdahum","their covenant","সন্ধিচুক্তি তাদের"],["فِى","fī","[in]","এ"],["كُلِّ","kulli","every","প্রত্যেক"],["مَرَّةٍۢ","marratin","time","বার"],["وَهُمْ","wahum","and they","এবং তারা"],["لَا","lā","(do) not","না"],["يَتَّقُونَ","yattaqūna","fear (Allah)","ভয় করে"]],"t":"ٱلَّذِينَ <m>عَٰ</>هَ<j>د</>تَّ مِنْهُمْ ثُ<g>مَّ</> يَ<k>نقُ</>ضُونَ عَهْدَهُمْ فِى كُلِّ مَرَّ<d>ةٍۢ وَ</>هُمْ لَا يَتَّ<p>قُو</>نَ"},{"n":57,"w":[["فَإِمَّا","fa-immā","So if","অতঃপর যদি"],["تَثْقَفَنَّهُمْ","tathqafannahum","you gain dominance over them","তুমি আয়ত্তে পাও তাদের"],["فِى","fī","in","মধ্যে"],["ٱلْحَرْبِ","l-ḥarbi","the war","যুদ্ধের"],["فَشَرِّدْ","fasharrid","disperse","তাহ'লে বিধ্বস্ত করো"],["بِهِم","bihim","by them","তাদেরকে"],["مَّنْ","man","(those) who","যারা"],["خَلْفَهُمْ","khalfahum","(are) behind them","পিছনে তাদের(আছে)"],["لَعَلَّهُمْ","la‘allahum","so that they may","যাতে তারা"],["يَذَّكَّرُونَ","yadhakkarūna","take heed","শিক্ষাগ্রহণ করে"]],"t":"فَإِ<g>مَّ</>ا تَثْقَفَ<g>نَّ</>هُمْ فِى <h>ٱ</>لْحَرْبِ فَشَرِّ<q>دْ</> بِ<y>هِم مَّ</>نْ خَلْفَهُمْ لَعَلَّهُمْ يَذَّكَّ<p>رُو</>نَ"},{"n":58,"w":[["وَإِمَّا","wa-immā","And if","এবং যদি"],["تَخَافَنَّ","takhāfanna","you fear","তুমি আশঙ্কা করো"],["مِن","min","from","হতে"],["قَوْمٍ","qawmin","a people","কোনো জাতি"],["خِيَانَةًۭ","khiyānatan","betrayal","বিশ্বাসভঙ্গের"],["فَٱنۢبِذْ","fa-inbidh","throw back","তবে নিক্ষেপ করো"],["إِلَيْهِمْ","ilayhim","to them","দিকে তাদের (তাদের সন্ধিচুক্তি)"],["عَلَىٰ","‘alā","on","ভাবে"],["سَوَآءٍ ۚ","sawāin","equal (terms)","সমান (একই)"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَا","lā","(does) not","না"],["يُحِبُّ","yuḥibbu","love","ভালোবাসেন"],["ٱلْخَآئِنِينَ","l-khāinīna","the traitors","বিশ্বাসভঙ্গকারীদেরকে"]],"t":"وَإِ<g>مَّ</>ا تَخَافَ<g>نَّ</> مِ<k>ن قَ</>وْمٍ خِيَانَ<k>ةًۭ فَ</><h>ٱ</><i>نۢبِ</>ذْ إِلَيْهِمْ عَلَىٰ سَ<o>وَآ</>ءٍ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ لَا يُحِبُّ <h>ٱ</>لْ<o>خَآ</>ئِ<p>نِي</>نَ"},{"n":59,"w":[["وَلَا","walā","And (let) not","এবং না"],["يَحْسَبَنَّ","yaḥsabanna","think","(যেন) তারা মনে করে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieve","অস্বীকার করেছে (যে)"],["سَبَقُوٓا۟ ۚ","sabaqū","they can outstrip","তারা আগে চলে গিয়েছে"],["إِنَّهُمْ","innahum","Indeed, they","নিশ্চয়ই তারা"],["لَا","lā","(can) not","না"],["يُعْجِزُونَ","yu‘'jizūna","escape","অক্ষম করতে পারবে (আল্লাহকে)"]],"t":"وَلَا يَحْسَبَ<g>نَّ</> <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> سَبَ<o>قُوٓ</><s>ا۟</> ۚ إِ<g>نَّ</>هُمْ لَا يُعْجِ<p>زُو</>نَ"},{"n":60,"w":[["وَأَعِدُّوا۟","wa-a‘iddū","And prepare","এবং তোমরা প্রস্তুত রাখো"],["لَهُم","lahum","for them","জন্যে তাদের"],["مَّا","mā","whatever","যা (কিছু)"],["ٱسْتَطَعْتُم","is'taṭa‘tum","you able (to)","তোমরা সমর্থ হও"],["مِّن","min","of","সব"],["قُوَّةٍۢ","quwwatin","force","শক্তি"],["وَمِن","wamin","and of","এবং সব"],["رِّبَاطِ","ribāṭi","tethered","সাজ-সরঞ্জাম"],["ٱلْخَيْلِ","l-khayli","horses","(যুদ্ধের) ঘোড়ার"],["تُرْهِبُونَ","tur'hibūna","(to) terrify","তোমরা সন্ত্রস্ত করবে"],["بِهِۦ","bihi","therewith","দিয়ে তা"],["عَدُوَّ","‘aduwwa","(the) enemy","শত্রুকে"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَعَدُوَّكُمْ","wa‘aduwwakum","and your enemy","ও শত্রুকে তোমাদের"],["وَءَاخَرِينَ","waākharīna","and others","এবং অন্যদেরকে"],["مِن","min","from","থেকে"],["دُونِهِمْ","dūnihim","besides them","ছাড়া তাদের"],["لَا","lā","not","না"],["تَعْلَمُونَهُمُ","ta‘lamūnahumu","(do) you know them","তোমরা জানো তাদেরকে"],["ٱللَّهُ","l-lahu","(but) Allah","আল্লাহ"],["يَعْلَمُهُمْ ۚ","ya‘lamuhum","knows them","জানেন তাদেরকে"],["وَمَا","wamā","And whatever","এবং যা"],["تُنفِقُوا۟","tunfiqū","you spend","তোমরা ব্যয় করো"],["مِن","min","from","কোনো"],["شَىْءٍۢ","shayin","(any) thing","কিছু"],["فِى","fī","in","মধ্যে"],["سَبِيلِ","sabīli","(the) way","পথের"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["يُوَفَّ","yuwaffa","it will be fully repaid","পুর্ণ প্রতিফল দেয়া হবে"],["إِلَيْكُمْ","ilaykum","to you","প্রতি তোমাদের"],["وَأَنتُمْ","wa-antum","and you","এবং তোমাদের (উপর)"],["لَا","lā","(will) not","না"],["تُظْلَمُونَ","tuẓ'lamūna","be wronged","অন্যায় করা হবে"]],"t":"وَأَعِدُّو<s>ا۟</> لَ<y>هُم مَّ</>ا <h>ٱ</>سْتَطَعْ<y>تُم مِّ</><k>ن قُ</>وَّ<d>ةٍۢ وَ</><w>مِن رِّ</>بَاطِ <h>ٱ</>لْخَيْلِ تُرْهِبُونَ بِ<m>هِۦ</> عَدُوَّ <h>ٱ</>للَّهِ وَعَدُوَّكُمْ وَءَاخَرِينَ مِ<k>ن دُ</>ونِهِمْ لَا تَعْلَمُونَهُمُ <h>ٱ</>للَّهُ يَعْلَمُهُمْ ۚ وَمَا تُ<k>نفِ</>قُو<s>ا۟</> مِ<k>ن شَىْءٍۢ فِ</>ى سَبِيلِ <h>ٱ</>للَّهِ يُوَفَّ إِلَيْكُمْ وَأَ<k>نتُ</>مْ لَا تُظْلَ<p>مُو</>نَ"},{"n":61,"w":[["۞ وَإِن","wa-in","And if","এবং যদি"],["جَنَحُوا۟","janaḥū","they incline","তারা ঝুঁকে পড়ে"],["لِلسَّلْمِ","lilssalmi","to peace","জন্যে সন্ধি ও শান্তির"],["فَٱجْنَحْ","fa-ij'naḥ","then you (also) incline","তবে তুমিও ঝুঁকে পড়ো"],["لَهَا","lahā","to it","জন্যে তার"],["وَتَوَكَّلْ","watawakkal","and put (your) trust","এবং নির্ভর করো"],["عَلَى","‘alā","in","উপর"],["ٱللَّهِ ۚ","l-lahi","Allah","আল্লাহর"],["إِنَّهُۥ","innahu","Indeed","নিশ্চয়ই তিনি"],["هُوَ","huwa","He","তিনিই"],["ٱلسَّمِيعُ","l-samī‘u","(is) All-Hearer","সবকিছু শুনেন"],["ٱلْعَلِيمُ","l-‘alīmu","All-Knower","সবকিছু জানেন"]],"t":"۞ وَإِ<k>ن جَ</>نَحُو<s>ا۟</> لِلسَّلْمِ فَ<h>ٱ</><q>جْ</>نَحْ لَهَا وَتَوَكَّلْ عَلَى <h>ٱ</>للَّهِ ۚ إِ<g>نَّ</>هُ<m>ۥ</> هُوَ <h>ٱ</><l>ل</>سَّمِيعُ <h>ٱ</>لْعَ<p>لِي</>مُ"},{"n":62,"w":[["وَإِن","wa-in","But if","এবং যদি"],["يُرِيدُوٓا۟","yurīdū","they intend","তারা চায়"],["أَن","an","to","যে"],["يَخْدَعُوكَ","yakhda‘ūka","deceive you","তোমাকে তারা ধোঁকা দিবে"],["فَإِنَّ","fa-inna","then indeed","তবে বিশ্চয়ই"],["حَسْبَكَ","ḥasbaka","is sufficient for you","তোমার জন্যে যথেষ্ট"],["ٱللَّهُ ۚ","l-lahu","Allah","আল্লাহ"],["هُوَ","huwa","He","তিনিই"],["ٱلَّذِىٓ","alladhī","(is) the One Who","যিনি"],["أَيَّدَكَ","ayyadaka","supported you","তোমাকে শক্তিশালী করেছেন"],["بِنَصْرِهِۦ","binaṣrihi","with His help","দিয়ে তাঁর সাহায্য"],["وَبِٱلْمُؤْمِنِينَ","wabil-mu'minīna","and with the believers","ও দিয়ে মু'মিনদের"]],"t":"وَ<d>إِن يُ</>رِي<o>دُوٓ</><s>ا۟</> <d>أَن يَ</>خْدَعُوكَ فَإِ<g>نَّ</> حَسْبَكَ <h>ٱ</>للَّهُ ۚ هُوَ <h>ٱ</>لَّ<o>ذِىٓ</> أَيَّدَكَ بِنَصْرِ<m>هِۦ</> وَبِ<h>ٱ</>لْمُؤْمِ<p>نِي</>نَ"},{"n":63,"w":[["وَأَلَّفَ","wa-allafa","And He (has) put affection","এবং সম্প্রীতি স্থাপন করেছেন"],["بَيْنَ","bayna","between","মাঝে"],["قُلُوبِهِمْ ۚ","qulūbihim","their hearts","অন্তরগুলোর তাদের"],["لَوْ","law","If","যদি"],["أَنفَقْتَ","anfaqta","you (had) spent","তুমি ব্যয় করতে"],["مَا","mā","whatever","যা কিছু"],["فِى","fī","(is) in","মধ্যে (আছে)"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["جَمِيعًۭا","jamī‘an","all","সব কিছুই"],["مَّآ","mā","not","(তবুও) না"],["أَلَّفْتَ","allafta","(could) you (have) put affection","তুমি সম্প্রীতি স্থাপন করতে পারতে"],["بَيْنَ","bayna","between","মাঝে"],["قُلُوبِهِمْ","qulūbihim","their hearts","অন্তরসমূহের তাদের"],["وَلَـٰكِنَّ","walākinna","but","কিন্তু"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["أَلَّفَ","allafa","(has) put affection","সম্প্রীতি স্থাপন করেছেন"],["بَيْنَهُمْ ۚ","baynahum","between them","মাঝে তাদের"],["إِنَّهُۥ","innahu","Indeed, He","নিশ্চয়ই তিনি"],["عَزِيزٌ","‘azīzun","(is) All-Mighty","পরাক্রমশালী"],["حَكِيمٌۭ","ḥakīmun","All-Wise","মহাবিজ্ঞ"]],"t":"وَأَلَّفَ بَيْنَ قُلُوبِهِمْ ۚ لَوْ أَ<k>نفَ</><q>قْ</>تَ مَا فِى <h>ٱ</>لْأَرْضِ جَمِي<d>عًۭا مَّ</><o>آ</> أَلَّفْتَ بَيْنَ قُلُوبِهِمْ وَ<m>لَٰ</>كِ<g>نَّ</> <h>ٱ</>للَّهَ أَلَّفَ بَيْنَهُمْ ۚ إِ<g>نَّ</>هُ<m>ۥ</> عَزِيزٌ حَ<p>كِي</>مٌۭ"},{"n":64,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O","হে"],["ٱلنَّبِىُّ","l-nabiyu","Prophet","নাবী"],["حَسْبُكَ","ḥasbuka","Sufficient for you","তোমার জন্যে যথেষ্ট"],["ٱللَّهُ","l-lahu","(is) Allah","আল্লাহই"],["وَمَنِ","wamani","and whoever","এবং (তাদের জন্যে) যারা"],["ٱتَّبَعَكَ","ittaba‘aka","follows you","তোমাকে অনুসরণ করে"],["مِنَ","mina","of","মধ্যে"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believers","মু'মিনদের (জন্যে)"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</><l>ل</><g>نَّ</>بِىُّ حَسْبُكَ <h>ٱ</>للَّهُ وَمَنِ <h>ٱ</>تَّبَعَكَ مِنَ <h>ٱ</>لْمُؤْمِ<p>نِي</>نَ"},{"n":65,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O","হে"],["ٱلنَّبِىُّ","l-nabiyu","Prophet","নাবী"],["حَرِّضِ","ḥarriḍi","Urge","উদ্বুদ্ধ করো"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believers","মু'মিনদেরকে"],["عَلَى","‘alā","to","জন্যে"],["ٱلْقِتَالِ ۚ","l-qitāli","[the] fight","যুদ্ধের"],["إِن","in","If","যদি"],["يَكُن","yakun","(there) are","হয়"],["مِّنكُمْ","minkum","among you","মধ্য হতে তোমাদের"],["عِشْرُونَ","‘ish'rūna","twenty","বিশজন"],["صَـٰبِرُونَ","ṣābirūna","steadfast","ধৈর্যশীল"],["يَغْلِبُوا۟","yaghlibū","they will overcome","তারা বিজয়ী হবে"],["مِا۟ئَتَيْنِ ۚ","mi-atayni","two hundred","দু'শতের (উপর)"],["وَإِن","wa-in","And if","এবং যদি"],["يَكُن","yakun","(there) are","হয়"],["مِّنكُم","minkum","among you","মধ্য হতে তোমাদের"],["مِّا۟ئَةٌۭ","mi-atun","a hundred","একশত"],["يَغْلِبُوٓا۟","yaghlibū","they will overcome","তারা বিজয়ী হবে"],["أَلْفًۭا","alfan","a thousand","এক হাজারের (উপর)"],["مِّنَ","mina","of","(তাদের) হতে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieve","অবিশ্বাস করেছে"],["بِأَنَّهُمْ","bi-annahum","because they","একারণে যে তারা"],["قَوْمٌۭ","qawmun","(are) a people","(এমন)সম্প্রদায়"],["لَّا","lā","(who do) not","(যারা) না"],["يَفْقَهُونَ","yafqahūna","understand","তারা বুঝে"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</><l>ل</><g>نَّ</>بِىُّ حَرِّضِ <h>ٱ</>لْمُؤْمِنِينَ عَلَى <h>ٱ</>لْقِتَالِ ۚ <d>إِن يَكُن مِّ</><k>نكُ</>مْ عِشْرُونَ <m>صَٰ</>بِرُونَ يَغْلِبُو<s>ا۟</> مِ<s>ا۟</>ئَتَيْنِ ۚ وَ<d>إِن يَكُن مِّ</><k>نكُ</><y>م مِّ</><s>ا۟</>ئَ<d>ةٌۭ يَ</>غْلِ<o>بُوٓ</><s>ا۟</> أَلْ<d>فًۭا مِّ</>نَ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> بِأَ<g>نَّ</>هُمْ قَوْ<w>مٌۭ لَّ</>ا يَفْقَ<p>هُو</>نَ"},{"n":66,"w":[["ٱلْـَٔـٰنَ","al-āna","Now","এখন"],["خَفَّفَ","khaffafa","has (been) lightened","(বোঝা) হালকা করেছেন"],["ٱللَّهُ","l-lahu","(by) Allah","আল্লাহ"],["عَنكُمْ","‘ankum","for you","হতে তোমাদের"],["وَعَلِمَ","wa‘alima","and He knows","এবং তিনি জানেন"],["أَنَّ","anna","that","যে"],["فِيكُمْ","fīkum","in you","মধ্যে (আছে) তোমাদের"],["ضَعْفًۭا ۚ","ḍa‘fan","(there) is weakness","দুর্বলতা"],["فَإِن","fa-in","So if","অতএব যদি"],["يَكُن","yakun","(there) are","হয়"],["مِّنكُم","minkum","among you","মধ্য হতে তোমাদের"],["مِّا۟ئَةٌۭ","mi-atun","a hundred","একশত (জন)"],["صَابِرَةٌۭ","ṣābiratun","steadfast","ধৈর্যশীল"],["يَغْلِبُوا۟","yaghlibū","they will overcome","তারা বিজয়ী হবে"],["مِا۟ئَتَيْنِ ۚ","mi-atayni","two hundred","দু'শতের (উপর)"],["وَإِن","wa-in","And if","এবং যদি"],["يَكُن","yakun","(there) are","হয়"],["مِّنكُمْ","minkum","among you","মধ্য হতে তোমাদের"],["أَلْفٌۭ","alfun","a thousand","এক হাজার (জন)"],["يَغْلِبُوٓا۟","yaghlibū","they will overcome","তারা বিজয়ী হবে"],["أَلْفَيْنِ","alfayni","two thousand","দু'হাজারের (উপর)"],["بِإِذْنِ","bi-idh'ni","with (the) permission","সাহায্যে অনুমতির"],["ٱللَّهِ ۗ","l-lahi","(of) Allah","আল্লাহর"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["مَعَ","ma‘a","(is) with","সাথে (আছেন)"],["ٱلصَّـٰبِرِينَ","l-ṣābirīna","the steadfast","ধৈর্যশীলদের"]],"t":"ٱ<m>لْـَٰٔ</>نَ خَفَّفَ <h>ٱ</>للَّهُ عَ<k>نكُ</>مْ وَعَلِمَ أَ<g>نَّ</> فِيكُمْ ضَعْ<k>فًۭا ۚ فَ</><d>إِن يَكُن مِّ</><k>نكُ</><y>م مِّ</><s>ا۟</>ئَ<k>ةٌۭ صَ</>ابِرَ<d>ةٌۭ يَ</>غْلِبُو<s>ا۟</> مِ<s>ا۟</>ئَتَيْنِ ۚ وَ<d>إِن يَكُن مِّ</><k>نكُ</>مْ أَلْ<d>فٌۭ يَ</>غْلِ<o>بُوٓ</><s>ا۟</> أَلْفَيْنِ بِإِذْنِ <h>ٱ</>للَّهِ ۗ وَ<h>ٱ</>للَّهُ مَعَ <h>ٱ</><l>ل</><m>صَّٰ</>بِ<p>رِي</>نَ"},{"n":67,"w":[["مَا","mā","Not","না"],["كَانَ","kāna","is","শোভা পায়"],["لِنَبِىٍّ","linabiyyin","for a Prophet","জন্যে নাবীর"],["أَن","an","that","যে"],["يَكُونَ","yakūna","(there) should be","হবে"],["لَهُۥٓ","lahu","for him","কাছে তার"],["أَسْرَىٰ","asrā","prisoners of war","কোনো বন্দি"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["يُثْخِنَ","yuth'khina","he has battled strenuously","(শত্রুবাহিনীকে)সম্পূর্ণরূপে নিঃশেষ করবে"],["فِى","fī","in","উপর"],["ٱلْأَرْضِ ۚ","l-arḍi","the land","জমিনের"],["تُرِيدُونَ","turīdūna","You desire","তোমরা চাও"],["عَرَضَ","‘araḍa","(the) commodities","সম্পদ"],["ٱلدُّنْيَا","l-dun'yā","(of) the world","পার্থিব"],["وَٱللَّهُ","wal-lahu","but Allah","আর আল্লাহ"],["يُرِيدُ","yurīdu","desires","চান"],["ٱلْـَٔاخِرَةَ ۗ","l-ākhirata","(for you) the Hereafter","আখেরাত"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["عَزِيزٌ","‘azīzun","(is) All-Mighty","পরাক্রমশালী"],["حَكِيمٌۭ","ḥakīmun","All-Wise","প্রজ্ঞাময়"]],"t":"مَا كَانَ لِنَبِىٍّ <d>أَن يَ</>كُونَ لَهُ<o>ۥٓ</> أَسْرَىٰ حَتَّىٰ يُثْخِنَ فِى <h>ٱ</>لْأَرْضِ ۚ تُرِيدُونَ عَرَضَ <h>ٱ</><l>ل</>دُّنْيَا وَ<h>ٱ</>للَّهُ يُرِيدُ <h>ٱ</>لْءَاخِرَةَ ۗ وَ<h>ٱ</>للَّهُ عَزِيزٌ حَ<p>كِي</>مٌۭ"},{"n":68,"w":[["لَّوْلَا","lawlā","Had not","যদি না"],["كِتَـٰبٌۭ","kitābun","an ordainment","লিখিত বিধান (থাকতো)"],["مِّنَ","mina","from","পক্ষ থেকে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["سَبَقَ","sabaqa","preceded","যা পূর্ব হতে নির্ধারিত হয়ে আছে"],["لَمَسَّكُمْ","lamassakum","surely (would) have touched you","অবশ্যই তোমাদেরকে স্পর্শ করতো"],["فِيمَآ","fīmā","for what","তার জন্যে যা"],["أَخَذْتُمْ","akhadhtum","you took ","তোমরা গ্রহণ করেছো"],["عَذَابٌ","‘adhābun","a punishment","শাস্তি"],["عَظِيمٌۭ","‘aẓīmun","great","কঠিন"]],"t":"لَّوْلَا كِ<m>تَٰ</><d>بٌۭ مِّ</>نَ <h>ٱ</>للَّهِ سَبَقَ لَمَسَّكُمْ فِي<o>مَآ</> أَخَذْتُمْ عَذَابٌ عَ<p>ظِي</>مٌۭ"},{"n":69,"w":[["فَكُلُوا۟","fakulū","So eat","অতএব তোমরা খাও"],["مِمَّا","mimmā","from what","(তা) হতে যা"],["غَنِمْتُمْ","ghanim'tum","you got as war booty ","তোমরা গণীমত পেয়েছো"],["حَلَـٰلًۭا","ḥalālan","lawful","হালাল"],["طَيِّبًۭا ۚ","ṭayyiban","(and) good","পবিত্র (হিসেবে)"],["وَٱتَّقُوا۟","wa-ittaqū","and fear","এবং তোমরা ভয় করো"],["ٱللَّهَ ۚ","l-laha","Allah","আল্লাহকে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["غَفُورٌۭ","ghafūrun","(is) Oft-Forgiving","ক্ষমাশীল"],["رَّحِيمٌۭ","raḥīmun","Most Merciful","পরম দয়ালু"]],"t":"فَكُلُو<s>ا۟</> مِ<g>مَّ</>ا غَنِمْتُمْ حَ<m>لَٰ</>لًۭ<k>ا طَ</>يِّ<d>بًۭا ۚ وَ</><h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</>للَّهَ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ غَفُو<w>رٌۭ رَّ</><p>حِي</>مٌۭ"},{"n":70,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O","হে"],["ٱلنَّبِىُّ","l-nabiyu","Prophet","নাবী"],["قُل","qul","Say","বলো"],["لِّمَن","liman","to whoever","উদ্দেশ্যে (তাদের) যারা"],["فِىٓ","fī","(is) in","মধ্যে (আছে)"],["أَيْدِيكُم","aydīkum","your hands","হাতে তোমাদের"],["مِّنَ","mina","of","মধ্য হতে"],["ٱلْأَسْرَىٰٓ","l-asrā","the captives","বন্দিদের"],["إِن","in","If","\"যদি"],["يَعْلَمِ","ya‘lami","knows","জানেন (দেখেন)"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["فِى","fī","in","মধ্যে (আছে)"],["قُلُوبِكُمْ","qulūbikum","your hearts","অন্তরের তোমাদের"],["خَيْرًۭا","khayran","any good","কোনো কল্যাণ"],["يُؤْتِكُمْ","yu'tikum","He will give you","তিনি দিবেন তোমাদের"],["خَيْرًۭا","khayran","better","উত্তম"],["مِّمَّآ","mimmā","than what","(তা) হতেও যা"],["أُخِذَ","ukhidha","was taken","নেয়া হয়েছে"],["مِنكُمْ","minkum","from you","থেকে তোমাদের"],["وَيَغْفِرْ","wayaghfir","and He will forgive","ও ক্ষমা করবেন"],["لَكُمْ ۗ","lakum","you","প্রতি তোমাদের"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["غَفُورٌۭ","ghafūrun","(is) Oft-Forgiving","ক্ষমাশীল"],["رَّحِيمٌۭ","raḥīmun","Most Merciful","পরম দয়ালু\""]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</><l>ل</><g>نَّ</>بِىُّ قُل لِّمَ<k>ن فِ</><o>ىٓ</> أَيْدِي<y>كُم مِّ</>نَ <h>ٱ</>لْأَسْرَ<o>ىٰٓ</> <d>إِن يَ</>عْلَمِ <h>ٱ</>للَّهُ فِى قُلُوبِكُمْ خَيْ<d>رًۭا يُ</>ؤْتِكُمْ خَيْ<d>رًۭا مِّ</><g>مَّ</><o>آ</> أُخِذَ مِ<k>نكُ</>مْ وَيَغْفِرْ لَكُمْ ۗ وَ<h>ٱ</>للَّهُ غَفُو<w>رٌۭ رَّ</><p>حِي</>مٌۭ"},{"n":71,"w":[["وَإِن","wa-in","But if","এবং যদি"],["يُرِيدُوا۟","yurīdū","they intend","তারা চায়"],["خِيَانَتَكَ","khiyānataka","(to) betray you","তোমার সাথে বিশ্বাসভঙ্গ করতে"],["فَقَدْ","faqad","certainly","তবে নিশ্চয়ই"],["خَانُوا۟","khānū","they have betrayed","তারা বিশ্বাসভঙ্গ করেছে"],["ٱللَّهَ","l-laha","Allah","আল্লাহর সাথে"],["مِن","min","from","থেকে"],["قَبْلُ","qablu","before","পূর্ব"],["فَأَمْكَنَ","fa-amkana","So He gave (you) power","অতঃপর শক্তিশালী করে দিয়েছেন"],["مِنْهُمْ ۗ","min'hum","over them","উপর তাদের  (তোমাদেরকে)"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["عَلِيمٌ","‘alīmun","(is) All-Knower","সবকিছু জানেন"],["حَكِيمٌ","ḥakīmun","All-Wise","প্রজ্ঞাময়"]],"t":"وَ<d>إِن يُ</>رِيدُو<s>ا۟</> خِيَانَتَكَ فَقَ<q>دْ</> خَانُو<s>ا۟</> <h>ٱ</>للَّهَ مِ<k>ن قَ</><q>بْ</>لُ فَأَمْكَنَ مِنْهُمْ ۗ وَ<h>ٱ</>للَّهُ عَلِيمٌ حَ<p>كِي</>مٌ"},{"n":72,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ءَامَنُوا۟","āmanū","believed","ঈমান এনেছে"],["وَهَاجَرُوا۟","wahājarū","and emigrated","ও হিজরত করেছে"],["وَجَـٰهَدُوا۟","wajāhadū","and strove hard","ও জিহাদ করেছে"],["بِأَمْوَٰلِهِمْ","bi-amwālihim","with their wealth","দিয়ে ধনসম্পদ তাদের"],["وَأَنفُسِهِمْ","wa-anfusihim","and their lives","এবং প্রাণসমূহ তাদের (দিয়ে)"],["فِى","fī","in","মধ্যে"],["سَبِيلِ","sabīli","(the) way","পথের"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَٱلَّذِينَ","wa-alladhīna","and those who","ও যারা"],["ءَاوَوا۟","āwaw","gave shelter","আশ্রয় দিয়েছে"],["وَّنَصَرُوٓا۟","wanaṣarū","and helped","ও সাহায্য করেছে"],["أُو۟لَـٰٓئِكَ","ulāika","those ","ঐসবলোক"],["بَعْضُهُمْ","ba‘ḍuhum","some of them","একে তাদের"],["أَوْلِيَآءُ","awliyāu","(are) allies","বন্ধু"],["بَعْضٍۢ ۚ","ba‘ḍin","(of) another","অপরের"],["وَٱلَّذِينَ","wa-alladhīna","But those who","এবং যারা"],["ءَامَنُوا۟","āmanū","believed","ঈমান এনেছে"],["وَلَمْ","walam","and (did) not","কিন্তু নি"],["يُهَاجِرُوا۟","yuhājirū","emigrate","তারা হিজরত করে"],["مَا","mā","(it is) not","নেই"],["لَكُم","lakum","for you","জন্যে তোমাদের"],["مِّن","min","(of)","থেকে"],["وَلَـٰيَتِهِم","walāyatihim","their protection","অভিভাবকের দায়-দায়িত্ত্ব তাদের"],["مِّن","min","(in)","কোনো"],["شَىْءٍ","shayin","(in) anything","কিছুই"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["يُهَاجِرُوا۟ ۚ","yuhājirū","they emigrate","তারা হিজরত করে"],["وَإِنِ","wa-ini","And if","এবং যদি"],["ٱسْتَنصَرُوكُمْ","is'tanṣarūkum","they seek your help","তোমাদের কাছে তারা সাহায্য চায়"],["فِى","fī","in","ব্যাপারে"],["ٱلدِّينِ","l-dīni","the religion","দীনের"],["فَعَلَيْكُمُ","fa‘alaykumu","then upon you","তবে তোমাদের দায়িত্ব"],["ٱلنَّصْرُ","l-naṣru","(is to) help them","সাহায্য করা"],["إِلَّا","illā","except","ছাড়া"],["عَلَىٰ","‘alā","against","বিরুদ্ধে"],["قَوْمٍۭ","qawmin","a people","কোনো জাতির"],["بَيْنَكُمْ","baynakum","between you","মাঝে তোমাদের"],["وَبَيْنَهُم","wabaynahum","and between them","ও মাঝে তাদের"],["مِّيثَـٰقٌۭ ۗ","mīthāqun","(is) a treaty","সন্ধিচুক্তি (থাকে)"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["بِمَا","bimā","of what","ঐ সম্বন্ধে যা"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা কাজ করো"],["بَصِيرٌۭ","baṣīrun","(is) All-Seer","খুব ভালো করে দেখছেন"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَهَاجَرُو<s>ا۟</> وَ<m>جَٰ</>هَدُو<s>ا۟</> بِأَمْ<m>وَٰ</>لِهِمْ وَأَ<k>نفُ</>سِهِمْ فِى سَبِيلِ <h>ٱ</>للَّهِ وَ<h>ٱ</>لَّذِينَ ءَاوَو<s>ا۟</> وَّنَصَ<o>رُوٓ</><s>ا۟</> أُ<s>و۟</><o>لَٰٓ</>ئِكَ بَعْضُهُمْ أَوْلِ<o>يَآ</>ءُ بَعْ<d>ضٍۢ ۚ وَ</><h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَلَمْ يُهَاجِرُو<s>ا۟</> مَا لَ<y>كُم مِّ</><d>ن وَ</><m>لَٰ</>يَتِ<y>هِم مِّ</><k>ن شَ</>ىْءٍ حَتَّىٰ يُهَاجِرُو<s>ا۟ ۚ</> وَإِنِ <h>ٱ</>سْتَ<k>نصَ</>رُوكُمْ فِى <h>ٱ</><l>ل</>دِّينِ فَعَلَيْكُمُ <h>ٱ</><l>ل</><g>نَّ</>صْرُ إِلَّا عَلَىٰ قَوْ<i>مٍۭ بَ</>يْنَكُمْ وَبَيْنَ<y>هُم مِّ</>ي<m>ثَٰ</><d>قٌۭ ۗ وَ</><h>ٱ</>للَّهُ بِمَا تَعْمَلُونَ بَ<p>صِي</>رٌۭ"},{"n":73,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["كَفَرُوا۟","kafarū","disbelieve","অবিশ্বাস করেছে"],["بَعْضُهُمْ","ba‘ḍuhum","some of them","একে তারা"],["أَوْلِيَآءُ","awliyāu","(are) allies","বন্ধু"],["بَعْضٍ ۚ","ba‘ḍin","(to) another","অপরের"],["إِلَّا","illā","If not","যদি না"],["تَفْعَلُوهُ","taf‘alūhu","you do it","তোমরা করো তা"],["تَكُن","takun","(there) will be","(তবে) হবে"],["فِتْنَةٌۭ","fit'natun","oppression","ফিতনা"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["وَفَسَادٌۭ","wafasādun","and corruption","ও বিপর্যয়"],["كَبِيرٌۭ","kabīrun","great","বড়"]],"t":"وَ<h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> بَعْضُهُمْ أَوْلِ<o>يَآ</>ءُ بَعْضٍ ۚ إِلَّا تَفْعَلُوهُ تَكُ<k>ن فِ</>تْنَ<k>ةٌۭ فِ</>ى <h>ٱ</>لْأَرْضِ وَفَسَا<k>دٌۭ كَ</><p>بِي</>رٌۭ"},{"n":74,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["ءَامَنُوا۟","āmanū","believed","ঈমান এনেছে"],["وَهَاجَرُوا۟","wahājarū","and emigrated","ও হিজরত করেছে"],["وَجَـٰهَدُوا۟","wajāhadū","and strove hard","ও জিহাদ করেছে"],["فِى","fī","in","মধ্যে"],["سَبِيلِ","sabīli","(the) way","পথের"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَٱلَّذِينَ","wa-alladhīna","and those who","এবং যারা"],["ءَاوَوا۟","āwaw","gave shelter","আশ্রয় দিয়েছে"],["وَّنَصَرُوٓا۟","wanaṣarū","and helped","ও সাহায্য করেছে"],["أُو۟لَـٰٓئِكَ","ulāika","those ","ঐসব লোক"],["هُمُ","humu","they (are)","তারাই"],["ٱلْمُؤْمِنُونَ","l-mu'minūna","the believers","মু'মিন"],["حَقًّۭا ۚ","ḥaqqan","(in) truth","প্রকৃত"],["لَّهُم","lahum","For them","জন্যে তাদের (রয়েছে)"],["مَّغْفِرَةٌۭ","maghfiratun","(is) forgiveness","ক্ষমা"],["وَرِزْقٌۭ","wariz'qun","and a provision","ও জীবিকা"],["كَرِيمٌۭ","karīmun","noble","সম্মানজনক"]],"t":"وَ<h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَهَاجَرُو<s>ا۟</> وَ<m>جَٰ</>هَدُو<s>ا۟</> فِى سَبِيلِ <h>ٱ</>للَّهِ وَ<h>ٱ</>لَّذِينَ ءَاوَو<s>ا۟</> وَّنَصَ<o>رُوٓ</><s>ا۟</> أُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</>لْمُؤْمِنُونَ حَ<w>قًّۭا ۚ لَّ</><y>هُم مَّ</>غْفِرَ<d>ةٌۭ وَ</>رِزْ<k>قٌۭ كَ</><p>رِي</>مٌۭ"},{"n":75,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["ءَامَنُوا۟","āmanū","believed","ঈমান এনেছে"],["مِنۢ","min","from","থেকে"],["بَعْدُ","ba‘du","afterwards","পর"],["وَهَاجَرُوا۟","wahājarū","and emigrated","এবং হিজরত করেছে"],["وَجَـٰهَدُوا۟","wajāhadū","and strove hard","ও জিহাদ করেছে"],["مَعَكُمْ","ma‘akum","with you","সাথে তোমাদের"],["فَأُو۟لَـٰٓئِكَ","fa-ulāika","then those","তবে ঐসবলোকও"],["مِنكُمْ ۚ","minkum","(are) of you","অন্তর্ভুক্ত তোমাদের"],["وَأُو۟لُوا۟","wa-ulū","But those","এবং সম্পন্নরা"],["ٱلْأَرْحَامِ","l-arḥāmi","(of) blood relationship","গর্ভ"],["بَعْضُهُمْ","ba‘ḍuhum","some of them","একে তাদের"],["أَوْلَىٰ","awlā","(are) nearer","অধিক অধিকারী"],["بِبَعْضٍۢ","biba‘ḍin","to another","ক্ষেত্রে অপরের"],["فِى","fī","in","অনুযায়ী"],["كِتَـٰبِ","kitābi","(the) Book","বিধান"],["ٱللَّهِ ۗ","l-lahi","(of) Allah","আল্লাহর"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["بِكُلِّ","bikulli","of every","সম্পর্কে সব"],["شَىْءٍ","shayin","thing","কিছুরই"],["عَلِيمٌۢ","‘alīmun","(is) All-Knower","খুব অবহিত"]],"t":"وَ<h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> <i>مِنۢ بَ</>عْدُ وَهَاجَرُو<s>ا۟</> وَ<m>جَٰ</>هَدُو<s>ا۟</> مَعَكُمْ فَأُ<s>و۟</><o>لَٰٓ</>ئِكَ مِ<k>نكُ</>مْ ۚ وَأُ<s>و۟</>لُو<s>ا۟</> <h>ٱ</>لْأَرْحَامِ بَعْضُهُمْ أَوْلَىٰ بِبَعْ<k>ضٍۢ فِ</>ى كِ<m>تَٰ</>بِ <h>ٱ</>للَّهِ ۗ إِ<g>نَّ</> <h>ٱ</>للَّهَ بِكُلِّ شَىْءٍ عَ<p>لِي</>مٌۢ"}]}