{"n":89,"a":[{"n":1,"w":[["وَٱلْفَجْرِ","wal-fajri","By the dawn","শপথ ঊষার"]],"t":"وَ<h>ٱ</>لْفَ<q>جْ</>رِ"},{"n":2,"w":[["وَلَيَالٍ","walayālin","And the nights","শপথ রাতের"],["عَشْرٍۢ","‘ashrin","ten","দশ"]],"t":"وَلَيَالٍ عَشْرٍۢ"},{"n":3,"w":[["وَٱلشَّفْعِ","wal-shaf‘i","And the even","শপথ জোড়ের"],["وَٱلْوَتْرِ","wal-watri","and the odd","ও বেজোড়ের"]],"t":"وَ<h>ٱ</><l>ل</>شَّفْعِ وَ<h>ٱ</>لْوَتْرِ"},{"n":4,"w":[["وَٱلَّيْلِ","wa-al-layli","And the night","শপথ রাতের"],["إِذَا","idhā","when","যখন"],["يَسْرِ","yasri","it passes","তা যেতে থাকে"]],"t":"وَ<h>ٱ</>لَّيْلِ إِذَا يَسْرِ"},{"n":5,"w":[["هَلْ","hal","Is","কি"],["فِى","fī","in","মধ্যে (আছে)"],["ذَٰلِكَ","dhālika","that","এর"],["قَسَمٌۭ","qasamun","(not) an oath","কোনো শপথ (কোনো প্রমাণ)"],["لِّذِى","lidhī","for those","সম্পন্ন ব্যক্তির জন্য"],["حِجْرٍ","ḥij'rin","who understand","বোধশক্তি"]],"t":"هَلْ فِى <m>ذَٰ</>لِكَ قَسَ<w>مٌۭ لِّ</>ذِى حِ<q>جْ</>رٍ"},{"n":6,"w":[["أَلَمْ","alam","Did not","নি কি"],["تَرَ","tara","you see","তুমি দেখ"],["كَيْفَ","kayfa","how","কেমন"],["فَعَلَ","fa‘ala","dealt","করেছেন"],["رَبُّكَ","rabbuka","your Lord","তোমার রব"],["بِعَادٍ","bi‘ādin","with Aad","আ'দ বংশের সাথে"]],"t":"أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِ<p>عَا</><q>دٍ</>"},{"n":7,"w":[["إِرَمَ","irama","Iram","ইরাম গোত্রের (প্রতি)"],["ذَاتِ","dhāti","possessors (of)","অধিকারী (ছিল)"],["ٱلْعِمَادِ","l-‘imādi","lofty pillars","সুউচ্চ প্রাসাদের"]],"t":"إِرَمَ ذَاتِ <h>ٱ</>لْعِ<p>مَا</><q>دِ</>"},{"n":8,"w":[["ٱلَّتِى","allatī","Which","যা (এমন ছিল যে)"],["لَمْ","lam","not","নি"],["يُخْلَقْ","yukh'laq","had been created","নির্মিত হয়"],["مِثْلُهَا","mith'luhā","like them","তার সমতুল্য (কোন জাতি)"],["فِى","fī","in","হতে"],["ٱلْبِلَـٰدِ","l-bilādi","the cities","দেশ সমূহে"]],"t":"ٱلَّتِى لَمْ يُخْلَ<q>قْ</> مِثْلُهَا فِى <h>ٱ</>لْبِ<p>لَٰ</><q>دِ</>"},{"n":9,"w":[["وَثَمُودَ","wathamūda","And Thamud","এবং (কেমন করেছেন সামূদদের সাথে)"],["ٱلَّذِينَ","alladhīna","who","যারা"],["جَابُوا۟","jābū","carved out","কেটেছিল"],["ٱلصَّخْرَ","l-ṣakhra","the rocks","পাথর (ভূমি সমূহ)"],["بِٱلْوَادِ","bil-wādi","in the valley","উপত্যকার"]],"t":"وَثَمُودَ <h>ٱ</>لَّذِينَ جَابُو<s>ا۟</> <h>ٱ</><l>ل</>صَّخْرَ بِ<h>ٱ</>لْ<p>وَا</><q>دِ</>"},{"n":10,"w":[["وَفِرْعَوْنَ","wafir'‘awna","And Firaun","এবং (কেমন করেছেন) ফিরআউনের সাথে"],["ذِى","dhī","owner of","(যে ছিল) অধিপতি"],["ٱلْأَوْتَادِ","l-awtādi","stakes","কীলকসমূহের (সৈন্য শিবিরের)"]],"t":"وَفِرْعَوْنَ ذِى <h>ٱ</>لْأَوْ<p>تَا</><q>دِ</>"},{"n":11,"w":[["ٱلَّذِينَ","alladhīna","Who","যারা"],["طَغَوْا۟","ṭaghaw","transgressed","সীমালঙ্ঘন করেছিলো"],["فِى","fī","in","মধ্যে"],["ٱلْبِلَـٰدِ","l-bilādi","the lands","(বিভিন্ন) দেশে"]],"t":"ٱلَّذِينَ طَغَوْ<s>ا۟</> فِى <h>ٱ</>لْبِ<p>لَٰ</><q>دِ</>"},{"n":12,"w":[["فَأَكْثَرُوا۟","fa-aktharū","And (made) much","আর বৃদ্ধি করেছিল"],["فِيهَا","fīhā","therein","তার মধ্যে"],["ٱلْفَسَادَ","l-fasāda","corruption","বিপর্যয়/ অশান্তি"]],"t":"فَأَكْثَرُو<s>ا۟</> فِيهَا <h>ٱ</>لْفَ<p>سَا</><q>دَ</>"},{"n":13,"w":[["فَصَبَّ","faṣabba","So poured","তারপর আঘাত করলেন"],["عَلَيْهِمْ","‘alayhim","on them","তাদের উপর"],["رَبُّكَ","rabbuka","your Lord","তোমার রব"],["سَوْطَ","sawṭa","scourge","চাবুকের"],["عَذَابٍ","‘adhābin","(of) punishment","শাস্তির"]],"t":"فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَ<p>ذَا</><q>بٍ</>"},{"n":14,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["رَبَّكَ","rabbaka","your Lord","তোমার রব"],["لَبِٱلْمِرْصَادِ","labil-mir'ṣādi","(is) surely Ever Watchful","অবশ্যই (ধরবেন) ঘাঁটিতে"]],"t":"إِ<g>نَّ</> رَبَّكَ لَبِ<h>ٱ</>لْمِرْ<p>صَا</><q>دِ</>"},{"n":15,"w":[["فَأَمَّا","fa-ammā","And as for","অতঃপর ব্যাপার হলো"],["ٱلْإِنسَـٰنُ","l-insānu","man","মানুষের"],["إِذَا","idhā","when","যখন"],["مَا","mā","does","তাকে"],["ٱبْتَلَىٰهُ","ib'talāhu","try him","পরীক্ষা করেন"],["رَبُّهُۥ","rabbuhu","his Lord","তার রব"],["فَأَكْرَمَهُۥ","fa-akramahu","and is generous to him","তাকে সম্মান দেন"],["وَنَعَّمَهُۥ","wana‘‘amahu","and favors him","ও তাকে অনুগ্রহ করেন"],["فَيَقُولُ","fayaqūlu","he says","তখন সে বলে"],["رَبِّىٓ","rabbī","My Lord","\"আমার রব"],["أَكْرَمَنِ","akramani","has honored me","আমাকে সম্মানিত করেছেন\""]],"t":"فَأَ<g>مَّ</>ا <h>ٱ</>لْإِ<k>نسَٰ</>نُ إِذَا مَا <h>ٱ</><q>بْ</>تَلَ<m>ىٰ</>هُ رَبُّهُ<m>ۥ</> فَأَكْرَمَهُ<m>ۥ</> وَنَعَّمَهُ<m>ۥ</> فَيَقُولُ رَ<o>بِّىٓ</> أَكْرَمَنِ"},{"n":16,"w":[["وَأَمَّآ","wa-ammā","But","আর"],["إِذَا","idhā","when","যখন"],["مَا","mā","does","তাকে"],["ٱبْتَلَىٰهُ","ib'talāhu","He try him","পরীক্ষা করেন"],["فَقَدَرَ","faqadara","and restricts","সংকীর্ণ করেন"],["عَلَيْهِ","‘alayhi","for him","তার  উপর"],["رِزْقَهُۥ","riz'qahu","his provision","তার রিযক"],["فَيَقُولُ","fayaqūlu","then he says","তখন সে বলে"],["رَبِّىٓ","rabbī","My Lord","\"আমার রব"],["أَهَـٰنَنِ","ahānani","(has) humiliated me","আমাকে হেয় করেছেন\""]],"t":"وَأَ<g>مَّ</><o>آ</> إِذَا مَا <h>ٱ</><q>بْ</>تَلَ<m>ىٰ</>هُ فَقَدَرَ عَلَيْهِ رِزْقَهُ<m>ۥ</> فَيَقُولُ رَ<o>بِّىٓ</> أَ<m>هَٰ</>نَنِ"},{"n":17,"w":[["كَلَّا ۖ","kallā","Nay","কখনও না"],["بَل","bal","But","বরং"],["لَّا","lā","not","না"],["تُكْرِمُونَ","tuk'rimūna","you honor","তোমরা সম্মান করো"],["ٱلْيَتِيمَ","l-yatīma","the orphan","ইয়াতীমের"]],"t":"كَلَّا ۖ بَل لَّا تُكْرِمُونَ <h>ٱ</>لْيَ<p>تِي</>مَ"},{"n":18,"w":[["وَلَا","walā","And not","এবং না"],["تَحَـٰٓضُّونَ","taḥāḍḍūna","you feel the urge","তোমরা পরস্পরকে উৎসাহিত করো"],["عَلَىٰ","‘alā","to","জন্য"],["طَعَامِ","ṭa‘āmi","feed","খাদ্য দানের"],["ٱلْمِسْكِينِ","l-mis'kīni","the poor","অভাবগ্রস্তদের"]],"t":"وَلَا تَ<n>حَٰٓ</>ضُّونَ عَلَىٰ طَعَامِ <h>ٱ</>لْمِسْ<p>كِي</>نِ"},{"n":19,"w":[["وَتَأْكُلُونَ","watakulūna","And you consume","এবং তোমরা খাও"],["ٱلتُّرَاثَ","l-turātha","the inheritance","উত্তরাধিকারীদের প্রাপ্য সম্পদ"],["أَكْلًۭا","aklan","devouring","খাওয়া"],["لَّمًّۭا","lamman","altogether","সম্পূর্ণরূপে"]],"t":"وَتَأْكُلُونَ <h>ٱ</><l>ل</>تُّرَاثَ أَكْلًۭ<w>ا لَّ</><g>مًّۭ</>ا"},{"n":20,"w":[["وَتُحِبُّونَ","watuḥibbūna","And you love","এবং তোমরা ভালোবাস"],["ٱلْمَالَ","l-māla","wealth","ধনসম্পদ"],["حُبًّۭا","ḥubban","(with) love","ভালোবাসা"],["جَمًّۭا","jamman","immense","খুব বেশি"]],"t":"وَتُحِبُّونَ <h>ٱ</>لْمَالَ حُ<k>بًّۭا جَ</><g>مًّۭ</>ا"},{"n":21,"w":[["كَلَّآ","kallā","Nay","কখনও নয়"],["إِذَا","idhā","When","যখন"],["دُكَّتِ","dukkati","is leveled","চূর্ণবিচূর্ণ করা হবে"],["ٱلْأَرْضُ","l-arḍu","the earth","পৃথিবী"],["دَكًّۭا","dakkan","pounded","চূর্ণ"],["دَكًّۭا","dakkan","(and) crushed","বিচূর্ণ"]],"t":"كَ<o>لَّآ</> إِذَا دُكَّتِ <h>ٱ</>لْأَرْضُ دَ<k>كًّۭا دَ</>كًّۭا"},{"n":22,"w":[["وَجَآءَ","wajāa","And comes","এবং আসবেন"],["رَبُّكَ","rabbuka","your Lord","তোমার রব"],["وَٱلْمَلَكُ","wal-malaku","and the Angels","ও ফেরেশতারা"],["صَفًّۭا","ṣaffan","rank","সারি"],["صَفًّۭا","ṣaffan","(upon) rank","সারি"]],"t":"وَ<o>جَآ</>ءَ رَبُّكَ وَ<h>ٱ</>لْمَلَكُ صَ<k>فًّۭا صَ</>فًّۭا"},{"n":23,"w":[["وَجِا۟ىٓءَ","wajīa","And is brought","এবং আনা হবে"],["يَوْمَئِذٍۭ","yawma-idhin","that Day","সেদিন"],["بِجَهَنَّمَ ۚ","bijahannama","Hell","জাহান্নামকে (সর্বসমক্ষে)"],["يَوْمَئِذٍۢ","yawma-idhin","That Day","সেদিন"],["يَتَذَكَّرُ","yatadhakkaru","will remember","স্মরণ করবে"],["ٱلْإِنسَـٰنُ","l-insānu","man","মানুষ"],["وَأَنَّىٰ","wa-annā","but how","আর কোথায়"],["لَهُ","lahu","(will be) for him","তার জন্য"],["ٱلذِّكْرَىٰ","l-dhik'rā","the remembrance","এ স্মরণ (লাভজনক হবে)"]],"t":"وَجِ<s>ا۟</><o>ىٓ</>ءَ يَوْمَئِ<i>ذٍۭ بِ</>جَهَ<g>نَّ</>مَ ۚ يَوْمَئِ<d>ذٍۢ يَ</>تَذَكَّرُ <h>ٱ</>لْإِ<k>نسَٰ</>نُ وَأَ<g>نَّ</>ىٰ لَهُ <h>ٱ</><l>ل</>ذِّكْرَىٰ"},{"n":24,"w":[["يَقُولُ","yaqūlu","He will say","সে বলবে"],["يَـٰلَيْتَنِى","yālaytanī","O I wish","\"হায় আমার আফসোস"],["قَدَّمْتُ","qaddamtu","I had sent forth","আমি আগে পাঠাতাম (যদি)"],["لِحَيَاتِى","liḥayātī","for my life","আমার এ জীবনের জন্য (কিছু নেকী)\""]],"t":"يَقُولُ <m>يَٰ</>لَيْتَنِى قَدَّمْتُ لِحَيَاتِى"},{"n":25,"w":[["فَيَوْمَئِذٍۢ","fayawma-idhin","So that Day","অতঃপর সেদিন"],["لَّا","lā","not","না"],["يُعَذِّبُ","yu‘adhibu","will punish","শাস্তি দিতে পারবে"],["عَذَابَهُۥٓ","‘adhābahu","(as) His punishment","তাঁর শাস্তির মতো"],["أَحَدٌۭ","aḥadun","anyone","(অন্য) কেউ"]],"t":"فَيَوْمَئِ<w>ذٍۢ لَّ</>ا يُعَذِّبُ عَذَابَهُ<o>ۥٓ</> أَحَ<q>دٌۭ</>"},{"n":26,"w":[["وَلَا","walā","And not","এবং না"],["يُوثِقُ","yūthiqu","will bind","বাঁধতে পারবে"],["وَثَاقَهُۥٓ","wathāqahu","(as) His binding","তাঁর বাঁধনের (মতো)"],["أَحَدٌۭ","aḥadun","anyone","(অন্য) কেউ"]],"t":"وَلَا يُوثِقُ وَثَاقَهُ<o>ۥٓ</> أَحَ<q>دٌۭ</>"},{"n":27,"w":[["يَـٰٓأَيَّتُهَا","yāayyatuhā","O","\"(বলা হবে) হে"],["ٱلنَّفْسُ","l-nafsu","soul","আত্মা"],["ٱلْمُطْمَئِنَّةُ","l-muṭ'ma-inatu","who is satisfied","প্রশান্ত"]],"t":"<o>يَٰٓ</>أَيَّتُهَا <h>ٱ</><l>ل</><g>نَّ</>فْسُ <h>ٱ</>لْمُ<q>طْ</>مَئِ<g>نَّ</>ةُ"},{"n":28,"w":[["ٱرْجِعِىٓ","ir'ji‘ī","Return","তুমি ফিরে আস"],["إِلَىٰ","ilā","to","দিকে"],["رَبِّكِ","rabbiki","your Lord","তোমার রবের (এ অবস্থায় যে)"],["رَاضِيَةًۭ","rāḍiyatan","well pleased","(তুমি) সন্তুষ্ট"],["مَّرْضِيَّةًۭ","marḍiyyatan","and pleasing","প্রিয় পাত্রও (তাঁর নিকট)"]],"t":"ٱرْجِ<o>عِىٓ</> إِلَىٰ رَبِّكِ رَاضِيَ<d>ةًۭ مَّ</>رْضِيَّةًۭ"},{"n":29,"w":[["فَٱدْخُلِى","fa-ud'khulī","So enter","অতঃপর শামিল হও"],["فِى","fī","among","মধ্যে"],["عِبَـٰدِى","‘ibādī","My slaves","আমার (নেক) বান্দাদের/ দাসদের"]],"t":"فَ<h>ٱ</><q>دْ</>خُلِى فِى عِ<m>بَٰ</>دِى"},{"n":30,"w":[["وَٱدْخُلِى","wa-ud'khulī","And enter","এবং তুমি প্রবেশ করো"],["جَنَّتِى","jannatī","My Paradise","আমার জান্নাতে\""]],"t":"وَ<h>ٱ</><q>دْ</>خُلِى جَ<g>نَّ</>تِى"}]}