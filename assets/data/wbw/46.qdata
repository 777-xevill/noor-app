{"n":46,"a":[{"n":1,"w":[["حمٓ","hha-meem","Ha Meem","হা-মীম"]],"t":"ح<n>مٓ</>"},{"n":2,"w":[["تَنزِيلُ","tanzīlu","(The) revelation","অবতীর্ণ করা"],["ٱلْكِتَـٰبِ","l-kitābi","(of) the Book","এই কিতাব"],["مِنَ","mina","(is) from","পক্ষ হতে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["ٱلْعَزِيزِ","l-‘azīzi","the All-Mighty","(যিনি) পরাক্রমশালী"],["ٱلْحَكِيمِ","l-ḥakīmi","the All-Wise","মহাবিজ্ঞ"]],"t":"تَ<k>نزِ</>يلُ <h>ٱ</>لْكِ<m>تَٰ</>بِ مِنَ <h>ٱ</>للَّهِ <h>ٱ</>لْعَزِيزِ <h>ٱ</>لْحَ<p>كِي</>مِ"},{"n":3,"w":[["مَا","mā","Not","না"],["خَلَقْنَا","khalaqnā","We created","আমরা সৃষ্টি করেছি"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশ"],["وَٱلْأَرْضَ","wal-arḍa","and the earth","আর (না)পৃথিবীকে"],["وَمَا","wamā","and what","এবং যা কিছু (আছে)"],["بَيْنَهُمَآ","baynahumā","(is) between both of them","উভয়ের মাঝে"],["إِلَّا","illā","except","ব্যতীত"],["بِٱلْحَقِّ","bil-ḥaqi","in truth","যথাযথভাবে"],["وَأَجَلٍۢ","wa-ajalin","and (for) a term","এবং একটা সময়ের (জন্যে)"],["مُّسَمًّۭى ۚ","musamman","appointed","সুনির্দিষ্ট"],["وَٱلَّذِينَ","wa-alladhīna","But those who","কিন্তু যারা"],["كَفَرُوا۟","kafarū","disbelieve","অস্বীকার করেছে"],["عَمَّآ","‘ammā","from what","সে সম্পর্কে যার"],["أُنذِرُوا۟","undhirū","they are warned","তাদেরকে সতর্ক করা হয়েছে"],["مُعْرِضُونَ","mu‘'riḍūna","(are) turning away","(তা হতে) তারা মুখ ফিরিয়ে নিয়েছে"]],"t":"مَا خَلَ<q>قْ</>نَا <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضَ وَمَا بَيْنَهُ<o>مَآ</> إِلَّا بِ<h>ٱ</>لْحَقِّ وَأَجَ<d>لٍۢ مُّسَمًّۭى ۚ وَ</><h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> عَ<g>مَّ</><o>آ</> أُ<k>نذِ</>رُو<s>ا۟</> مُعْرِ<p>ضُو</>نَ"},{"n":4,"w":[["قُلْ","qul","Say","(হে নাবী) বলো"],["أَرَءَيْتُم","ara-aytum","Do you see","\"তোমরা কি (ভেবে) দেখেছ"],["مَّا","mā","what","যাদেরকে"],["تَدْعُونَ","tad‘ūna","you call","তোমরা ডাক"],["مِن","min","besides","মধ্য হতে"],["دُونِ","dūni","besides","ছাড়া"],["ٱللَّهِ","l-lahi","Allah","আল্লাহকে (তারা কারা?)"],["أَرُونِى","arūnī","Show me","আমাকে দেখাও"],["مَاذَا","mādhā","what","কি"],["خَلَقُوا۟","khalaqū","they have created","তারা সৃষ্টি করেছে"],["مِنَ","mina","of","মধ্য হতে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["أَمْ","am","or","অথবা কি"],["لَهُمْ","lahum","for them","তাদের জন্যে আছে"],["شِرْكٌۭ","shir'kun","(is) any share","কোন অংশ"],["فِى","fī","in","মধ্যে"],["ٱلسَّمَـٰوَٰتِ ۖ","l-samāwāti","the heavens","আকাশসমূহের"],["ٱئْتُونِى","i'tūnī","Bring me","আমার কাছে আন"],["بِكِتَـٰبٍۢ","bikitābin","a book","কোন বই নিয়ে (এর সমর্থনে)"],["مِّن","min","from","থেকে"],["قَبْلِ","qabli","before","পূর্বের"],["هَـٰذَآ","hādhā","this","এর"],["أَوْ","aw","or","অথবা"],["أَثَـٰرَةٍۢ","athāratin","a trace","ঐতিহ্যগত"],["مِّنْ","min","of","কোনো"],["عِلْمٍ","‘il'min","knowledge","জ্ঞান"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you are","তোমরা হও"],["صَـٰدِقِينَ","ṣādiqīna","truthful","সত্যবাদী\""]],"t":"قُلْ أَرَءَيْ<y>تُم مَّ</>ا تَ<q>دْ</>عُونَ مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ أَرُونِى مَاذَا خَلَقُو<s>ا۟</> مِنَ <h>ٱ</>لْأَرْضِ أَمْ لَهُمْ شِرْ<k>كٌۭ فِ</>ى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ ۖ <h>ٱ</>ئْتُونِى بِكِ<m>تَٰ</><d>بٍۢ مِّ</><k>ن قَ</><q>بْ</>لِ <m>هَٰ</><o>ذَآ</> أَوْ أَ<m>ثَٰ</>رَ<d>ةٍۢ مِّ</>نْ عِلْمٍ إِ<k>ن كُنتُ</>مْ <m>صَٰ</>دِ<p>قِي</>نَ"},{"n":5,"w":[["وَمَنْ","waman","And who","এবং কে"],["أَضَلُّ","aḍallu","(is) more astray","অধিক বিভ্রান্ত (হতে পারে)"],["مِمَّن","mimman","than (he) who","তার চেয়ে যে"],["يَدْعُوا۟","yad‘ū","calls","ডাকে"],["مِن","min","besides","মধ্য হতে"],["دُونِ","dūni","besides","ছাড়া"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["مَن","man","who","(এমন সত্তাকে) যা"],["لَّا","lā","will not respond","না"],["يَسْتَجِيبُ","yastajību","will not respond","ডাকে সাড়া দেবে"],["لَهُۥٓ","lahu","to him","তাকে"],["إِلَىٰ","ilā","until","পর্যন্ত"],["يَوْمِ","yawmi","(the) Day","দিন"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) Resurrection","কিয়ামতের"],["وَهُمْ","wahum","and they","এবং তারা"],["عَن","‘an","of","সম্বন্ধে"],["دُعَآئِهِمْ","du‘āihim","their calls","তাদের প্রার্থনা"],["غَـٰفِلُونَ","ghāfilūna","(are) unaware","অনবহিত"]],"t":"وَمَنْ أَضَلُّ مِ<g>مَّ</><d>ن يَ</><q>دْ</>عُو<s>ا۟</> مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ <w>مَن لَّ</>ا يَسْتَجِيبُ لَهُ<o>ۥٓ</> إِلَىٰ يَوْمِ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ وَهُمْ عَ<k>ن دُ</><o>عَآ</>ئِهِمْ <m>غَٰ</>فِ<p>لُو</>نَ"},{"n":6,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["حُشِرَ","ḥushira","are gathered","একত্র করা হবে"],["ٱلنَّاسُ","l-nāsu","the people","সব মানুষকে"],["كَانُوا۟","kānū","they will be","তারা হবে"],["لَهُمْ","lahum","for them","তাদের জন্যে"],["أَعْدَآءًۭ","a‘dāan","enemies","শত্রু"],["وَكَانُوا۟","wakānū","and they will be","এবং তারা হবে"],["بِعِبَادَتِهِمْ","bi‘ibādatihim","of their worship","তাদের উপাসনা সম্বন্ধে"],["كَـٰفِرِينَ","kāfirīna","deniers","অস্বীকারকারী"]],"t":"وَإِذَا حُشِرَ <h>ٱ</><l>ل</><g>نَّ</>اسُ كَانُو<s>ا۟</> لَهُمْ أَعْ<o>دَآ</><d>ءًۭ وَ</>كَانُو<s>ا۟</> بِعِبَادَتِهِمْ <m>كَٰ</>فِ<p>رِي</>نَ"},{"n":7,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["تُتْلَىٰ","tut'lā","are recited","আবৃত্তি করা হয়"],["عَلَيْهِمْ","‘alayhim","to them","তাদের নিকট"],["ءَايَـٰتُنَا","āyātunā","Our Verses","আমাদের আয়াতগুলোকে"],["بَيِّنَـٰتٍۢ","bayyinātin","clear","সুস্পষ্ট"],["قَالَ","qāla","say","(তখন) বলে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieve","অস্বীকার করেছে"],["لِلْحَقِّ","lil'ḥaqqi","of the truth","মহাসত্যকে"],["لَمَّا","lammā","when","যখন"],["جَآءَهُمْ","jāahum","it comes to them","তাদের কাছে এসেছে"],["هَـٰذَا","hādhā","This","\"এটা"],["سِحْرٌۭ","siḥ'run","(is) a magic","জাদু"],["مُّبِينٌ","mubīnun","clear","সুস্পষ্ট\""]],"t":"وَإِذَا تُتْلَىٰ عَلَيْهِمْ ءَا<m>يَٰ</>تُنَا بَيِّ<m>نَٰ</><k>تٍۢ قَ</>الَ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> لِلْحَقِّ لَ<g>مَّ</>ا <o>جَآ</>ءَهُمْ <m>هَٰ</>ذَا سِحْ<d>رٌۭ مُّ</><p>بِي</>نٌ"},{"n":8,"w":[["أَمْ","am","Or","অথবা"],["يَقُولُونَ","yaqūlūna","they say","তারা বলে"],["ٱفْتَرَىٰهُ ۖ","if'tarāhu","He has invented it","\"সে তা রচনা করেছে\""],["قُلْ","qul","Say","বলো"],["إِنِ","ini","If","\"যদি"],["ٱفْتَرَيْتُهُۥ","if'taraytuhu","I have invented it","তা আমি রচনা করে থাকি"],["فَلَا","falā","then not","না তবে"],["تَمْلِكُونَ","tamlikūna","you have power","তোমরা সক্ষম"],["لِى","lī","for me","আমাকে (রক্ষা করতে)"],["مِنَ","mina","against","হতে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["شَيْـًٔا ۖ","shayan","anything","কিছুমাত্র"],["هُوَ","huwa","He","তিনি"],["أَعْلَمُ","a‘lamu","knows best","খুব জানেন"],["بِمَا","bimā","of what","ঐ বিষয়ে"],["تُفِيضُونَ","tufīḍūna","you utter","তোমরা আলোচনা করে বেড়াচ্ছ"],["فِيهِ ۖ","fīhi","concerning it","যে সম্বন্ধে"],["كَفَىٰ","kafā","Sufficient is He","(তিনিই) যথেষ্ট"],["بِهِۦ","bihi","Sufficient is He","সে বিষয়ে"],["شَهِيدًۢا","shahīdan","(as) a Witness","সাক্ষী (হিসাবে)"],["بَيْنِى","baynī","between me","আমার মাঝে"],["وَبَيْنَكُمْ ۖ","wabaynakum","and between you","ও তোমাদের মাঝে"],["وَهُوَ","wahuwa","and He","এবং তিনিই"],["ٱلْغَفُورُ","l-ghafūru","(is) the Oft-Forgiving","ক্ষমাশীল"],["ٱلرَّحِيمُ","l-raḥīmu","the Most Merciful","দয়াময়"]],"t":"أَمْ يَقُولُونَ <h>ٱ</>فْتَرَ<m>ىٰ</>هُ ۖ قُلْ إِنِ <h>ٱ</>فْتَرَيْتُهُ<m>ۥ</> فَلَا تَمْلِكُونَ لِى مِنَ <h>ٱ</>للَّهِ شَيْـًٔا ۖ هُوَ أَعْلَمُ بِمَا تُفِيضُونَ فِيهِ ۖ كَفَىٰ بِ<m>هِۦ</> شَهِي<i>دًۢا بَ</>يْنِى وَبَيْنَكُمْ ۖ وَهُوَ <h>ٱ</>لْغَفُورُ <h>ٱ</><l>ل</>رَّ<p>حِي</>مُ"},{"n":9,"w":[["قُلْ","qul","Say","বলো"],["مَا","mā","Not","\"নই"],["كُنتُ","kuntu","I am","আমি (কোন রাসূল)"],["بِدْعًۭا","bid'‘an","a new (one)","অভিনব"],["مِّنَ","mina","among","মধ্য হতে"],["ٱلرُّسُلِ","l-rusuli","the Messengers","রাসূলগণের"],["وَمَآ","wamā","and not","এবং না"],["أَدْرِى","adrī","I know","আমি জানি"],["مَا","mā","what","কি"],["يُفْعَلُ","yuf'‘alu","will be done","(আচরণ) করা হবে"],["بِى","bī","with me","আমার সাথে"],["وَلَا","walā","and not","আর না"],["بِكُمْ ۖ","bikum","with you","তোমাদের সাথে"],["إِنْ","in","Not","না"],["أَتَّبِعُ","attabi‘u","I follow","আমি অনুসরণ করি"],["إِلَّا","illā","but","এ ব্যতীত"],["مَا","mā","what","যা"],["يُوحَىٰٓ","yūḥā","is revealed","ওহী করা হয়"],["إِلَىَّ","ilayya","to me","আমার প্রতি"],["وَمَآ","wamā","and not","এবং নই"],["أَنَا۠","anā","I am","আমি (আর কিছু)"],["إِلَّا","illā","but","এ ব্যতীত"],["نَذِيرٌۭ","nadhīrun","a warner","একজন সতর্ককারী"],["مُّبِينٌۭ","mubīnun","clear","সুস্পষ্ট\""]],"t":"قُلْ مَا كُ<k>نتُ</> بِ<q>دْ</><d>عًۭا مِّ</>نَ <h>ٱ</><l>ل</>رُّسُلِ وَ<o>مَآ</> أَ<q>دْ</>رِى مَا يُفْعَلُ بِى وَلَا بِكُمْ ۖ إِنْ أَتَّبِعُ إِلَّا مَا يُوحَ<o>ىٰٓ</> إِلَىَّ وَ<o>مَآ</> أَنَا۠ إِلَّا نَذِي<d>رٌۭ مُّ</><p>بِي</>نٌۭ"},{"n":10,"w":[["قُلْ","qul","Say","বলো"],["أَرَءَيْتُمْ","ara-aytum","Do you see","\"তোমরা (ভেবে) দেখেছ কি"],["إِن","in","if","যদি"],["كَانَ","kāna","it is","হয় (এটা)"],["مِنْ","min","from Allah","হতে"],["عِندِ","‘indi","from Allah","নিকট"],["ٱللَّهِ","l-lahi","from Allah","আল্লাহর"],["وَكَفَرْتُم","wakafartum","and you disbelieve","আর তোমরা অস্বীকার করছ (তবে কি পরিণতি হবে)"],["بِهِۦ","bihi","in it","তা"],["وَشَهِدَ","washahida","and testifies","এবং সাক্ষ্য দিয়েছে"],["شَاهِدٌۭ","shāhidun","a witness","একজন সাক্ষী"],["مِّنۢ","min","from","মধ্য হতে"],["بَنِىٓ","banī","(the) Children of Israel","বনী"],["إِسْرَٰٓءِيلَ","is'rāīla","(the) Children of Israel","ইসরাঈলের"],["عَلَىٰ","‘alā","to","উপর"],["مِثْلِهِۦ","mith'lihi","(the) like thereof","তার অনুরূপ (কালামের)"],["فَـَٔامَنَ","faāmana","then he believed","এরপরে সে ঈমান আনল"],["وَٱسْتَكْبَرْتُمْ ۖ","wa-is'takbartum","while you are arrogant","অথচ তোমরা অহংকার করলে\""],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَا","lā","(does) not","না"],["يَهْدِى","yahdī","guide","পথ দেখান"],["ٱلْقَوْمَ","l-qawma","the people","সম্প্রদায়কে"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","সীমালঙ্ঘনকারী"]],"t":"قُلْ أَرَءَيْتُمْ إِ<k>ن كَ</>انَ مِنْ عِ<k>ندِ</> <h>ٱ</>للَّهِ وَكَفَرْ<f>تُم بِ</><m>هِۦ</> وَشَهِدَ شَاهِ<d>دٌۭ مِّ</><i>نۢ بَ</><o>نِىٓ</> إِسْ<o>رَٰٓ</>ءِيلَ عَلَىٰ مِثْلِ<m>هِۦ</> فَـَٔامَنَ وَ<h>ٱ</>سْتَكْبَرْتُمْ ۖ إِ<g>نَّ</> <h>ٱ</>للَّهَ لَا يَهْدِى <h>ٱ</>لْقَوْمَ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":11,"w":[["وَقَالَ","waqāla","And say","এবং বলে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieve","অস্বীকার করেছে"],["لِلَّذِينَ","lilladhīna","of those who","(তাদের)-কে যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["لَوْ","law","If","\"যদি"],["كَانَ","kāna","it had been","হতো"],["خَيْرًۭا","khayran","good","উত্তম"],["مَّا","mā","not","না"],["سَبَقُونَآ","sabaqūnā","they (would) have preceded us","তারা আমাদের আগে যেতে পারত"],["إِلَيْهِ ۚ","ilayhi","to it","তার প্রতি\""],["وَإِذْ","wa-idh","And when","এবং যখন"],["لَمْ","lam","not","নি"],["يَهْتَدُوا۟","yahtadū","they (are) guided","পথ পায়"],["بِهِۦ","bihi","by it","তার দ্বারা"],["فَسَيَقُولُونَ","fasayaqūlūna","they say","তখন অচিরেই তারা বলবেই"],["هَـٰذَآ","hādhā","This","\"এটা"],["إِفْكٌۭ","if'kun","(is) a lie","মিথ্যা"],["قَدِيمٌۭ","qadīmun","ancient","পুরাতন\""]],"t":"وَقَالَ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> لِلَّذِينَ ءَامَنُو<s>ا۟</> لَوْ كَانَ خَيْ<d>رًۭا مَّ</>ا سَبَقُو<o>نَآ</> إِلَيْهِ ۚ وَإِذْ لَمْ يَهْتَدُو<s>ا۟</> بِ<m>هِۦ</> فَسَيَقُولُونَ <m>هَٰ</><o>ذَآ</> إِفْ<k>كٌۭ قَ</><p>دِي</>مٌۭ"},{"n":12,"w":[["وَمِن","wamin","And before it","এবং"],["قَبْلِهِۦ","qablihi","And before it","তার পূর্বে"],["كِتَـٰبُ","kitābu","(was the) Scripture","কিতাব (এসেছে)"],["مُوسَىٰٓ","mūsā","(of) Musa","মুসার"],["إِمَامًۭا","imāman","(as) a guide","পথ প্রদর্শক"],["وَرَحْمَةًۭ ۚ","waraḥmatan","and a mercy","ও অনুগ্রহ (স্বরূপ)"],["وَهَـٰذَا","wahādhā","And this","এবং এই"],["كِتَـٰبٌۭ","kitābun","(is) a Book","কিতাব"],["مُّصَدِّقٌۭ","muṣaddiqun","confirming","(তার) সত্যায়নকারী/ সমর্থক"],["لِّسَانًا","lisānan","(in) language","ভাষায়"],["عَرَبِيًّۭا","‘arabiyyan","Arabic","আরবী"],["لِّيُنذِرَ","liyundhira","to warn","যেন সতর্ক করে"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["ظَلَمُوا۟","ẓalamū","do wrong","যুলুম করেছে"],["وَبُشْرَىٰ","wabush'rā","and (as) glad tidings","এবং সুসংবাদ (দেয়)"],["لِلْمُحْسِنِينَ","lil'muḥ'sinīna","for the good-doers","সৎকর্মশীলদের জন্যে"]],"t":"وَمِ<k>ن قَ</><q>بْ</>لِ<m>هِۦ</> كِ<m>تَٰ</>بُ مُوسَ<o>ىٰٓ</> إِمَا<d>مًۭا وَ</>رَحْمَ<d>ةًۭ ۚ وَ</><m>هَٰ</>ذَا كِ<m>تَٰ</><d>بٌۭ مُّ</>صَدِّ<w>قٌۭ لِّ</>سَانًا عَرَبِ<w>يًّۭا لِّ</>يُ<k>نذِ</>رَ <h>ٱ</>لَّذِينَ ظَلَمُو<s>ا۟</> وَبُشْرَىٰ لِلْمُحْسِ<p>نِي</>نَ"},{"n":13,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["قَالُوا۟","qālū","say","বলে"],["رَبُّنَا","rabbunā","Our Lord","\"আমাদের রব"],["ٱللَّهُ","l-lahu","(is) Allah","আল্লাহই\""],["ثُمَّ","thumma","then","এরপর"],["ٱسْتَقَـٰمُوا۟","is'taqāmū","remain firm","তারা অবিচল থাকে"],["فَلَا","falā","then no","নেইতখন"],["خَوْفٌ","khawfun","fear","কোনো ভয়"],["عَلَيْهِمْ","‘alayhim","on them","তাদের উপর"],["وَلَا","walā","and not","আর না"],["هُمْ","hum","they","তারা"],["يَحْزَنُونَ","yaḥzanūna","will grieve","দুঃখিত হবে"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ قَالُو<s>ا۟</> رَبُّنَا <h>ٱ</>للَّهُ ثُ<g>مَّ</> <h>ٱ</>سْتَ<m>قَٰ</>مُو<s>ا۟</> فَلَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَ<p>نُو</>نَ"},{"n":14,"w":[["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব লোক"],["أَصْحَـٰبُ","aṣḥābu","(are the) companions","অধিবাসী (হবে)"],["ٱلْجَنَّةِ","l-janati","(of) Paradise","জান্নাতের"],["خَـٰلِدِينَ","khālidīna","abiding forever","তারা চিরস্থায়ী হবে"],["فِيهَا","fīhā","therein","তার মধ্যে"],["جَزَآءًۢ","jazāan","a reward","পুরস্কার"],["بِمَا","bimā","for what","বিনিময়ে যা"],["كَانُوا۟","kānū","they used to","তারা ছিল"],["يَعْمَلُونَ","ya‘malūna","do","তারা কাজ করে"]],"t":"أُ<s>و۟</><o>لَٰٓ</>ئِكَ أَصْ<m>حَٰ</>بُ <h>ٱ</>لْجَ<g>نَّ</>ةِ <m>خَٰ</>لِدِينَ فِيهَا جَ<o>زَآ</><i>ءًۢ بِ</>مَا كَانُو<s>ا۟</> يَعْمَ<p>لُو</>نَ"},{"n":15,"w":[["وَوَصَّيْنَا","wawaṣṣaynā","And We have enjoined","এবং আমরা নির্দেশ দিয়েছি"],["ٱلْإِنسَـٰنَ","l-insāna","(on) man","মানুষকে"],["بِوَٰلِدَيْهِ","biwālidayhi","to his parents","তার পিতামাতার সাথে"],["إِحْسَـٰنًا ۖ","iḥ'sānan","kindness","ভালো ব্যবহারের"],["حَمَلَتْهُ","ḥamalathu","Carried him","তাকে গর্ভেধারণ করেছে"],["أُمُّهُۥ","ummuhu","his mother","তার মা"],["كُرْهًۭا","kur'han","(with) hardship","কষ্ট করে"],["وَوَضَعَتْهُ","wawaḍa‘athu","and gave birth to him","ও তাকে প্রসব করেছে"],["كُرْهًۭا ۖ","kur'han","(with) hardship","কষ্টে"],["وَحَمْلُهُۥ","waḥamluhu","And (the) bearing of him","এবং তার গর্ভধারণ"],["وَفِصَـٰلُهُۥ","wafiṣāluhu","and (the) weaning of him","ও তার দুধ ছাড়ানোর মেয়াদ"],["ثَلَـٰثُونَ","thalāthūna","(is) thirty","ত্রিশ"],["شَهْرًا ۚ","shahran","month(s)","মাস"],["حَتَّىٰٓ","ḥattā","until","এমনকি"],["إِذَا","idhā","when","যখন"],["بَلَغَ","balagha","he reaches","সে পৌঁছে"],["أَشُدَّهُۥ","ashuddahu","his maturity","তার পূর্ণশক্তিতে/ তার যৌবন বয়সে"],["وَبَلَغَ","wabalagha","and reaches","ও পৌঁছে (বয়স)"],["أَرْبَعِينَ","arba‘īna","forty","চল্লিশ"],["سَنَةًۭ","sanatan","year(s)","বছরে"],["قَالَ","qāla","he says","সে বলে"],["رَبِّ","rabbi","My Lord","\"হে আমার রব"],["أَوْزِعْنِىٓ","awzi‘'nī","grant me (the) power","আমাকে সামর্থ্য দাও"],["أَنْ","an","that","যেন"],["أَشْكُرَ","ashkura","I may be grateful","আমি কৃতজ্ঞতা প্রকাশ করি"],["نِعْمَتَكَ","ni‘'mataka","(for) Your favor","তোমার অনুগ্রহের"],["ٱلَّتِىٓ","allatī","which","যা"],["أَنْعَمْتَ","an‘amta","You have bestowed","তুমি অনুগ্রহ দান করেছ"],["عَلَىَّ","‘alayya","upon me","আমার উপর"],["وَعَلَىٰ","wa‘alā","and upon","ও উপর"],["وَٰلِدَىَّ","wālidayya","my parents","আমার পিতা-মাতার"],["وَأَنْ","wa-an","and that","এবং যেন"],["أَعْمَلَ","a‘mala","I do","আমি কাজ করি"],["صَـٰلِحًۭا","ṣāliḥan","righteous (deeds)","সৎকর্ম"],["تَرْضَىٰهُ","tarḍāhu","which please You","যা পছন্দ কর তুমি"],["وَأَصْلِحْ","wa-aṣliḥ","and make righteous","এবং যোগ্যতা সৃষ্টি করে দাও"],["لِى","lī","for me","আমার জন্যে"],["فِى","fī","among","মধ্যে"],["ذُرِّيَّتِىٓ ۖ","dhurriyyatī","my offspring","আমার সন্তানদের"],["إِنِّى","innī","indeed","আমি নিশ্চয়ই"],["تُبْتُ","tub'tu","I turn","তওবা করছি"],["إِلَيْكَ","ilayka","to You","তোমার কাছে"],["وَإِنِّى","wa-innī","and indeed, I am","এবং আমি নিশ্চয়ই"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْمُسْلِمِينَ","l-mus'limīna","those who submit","আত্মসমর্পণকারীদের\""]],"t":"وَوَصَّيْنَا <h>ٱ</>لْإِ<k>نسَٰ</>نَ بِ<m>وَٰ</>لِدَيْهِ إِحْ<m>سَٰ</>نًا ۖ حَمَلَتْهُ أُ<g>مُّ</>هُ<m>ۥ</> كُرْ<d>هًۭا وَ</>وَضَعَتْهُ كُرْ<d>هًۭا ۖ وَ</>حَمْلُهُ<m>ۥ</> وَفِ<m>صَٰ</>لُهُ<m>ۥ</> ثَ<m>لَٰ</>ثُونَ شَهْرًا ۚ حَتَّ<o>ىٰٓ</> إِذَا بَلَغَ أَشُدَّهُ<m>ۥ</> وَبَلَغَ أَرْبَعِينَ سَنَ<k>ةًۭ قَ</>الَ رَبِّ أَوْزِعْ<o>نِىٓ</> أَنْ أَشْكُرَ نِعْمَتَكَ <h>ٱ</>لَّ<o>تِىٓ</> أَنْعَمْتَ عَلَىَّ وَعَلَىٰ <m>وَٰ</>لِدَىَّ وَأَنْ أَعْمَلَ <m>صَٰ</>لِ<k>حًۭا تَ</>رْضَ<m>ىٰ</>هُ وَأَصْلِحْ لِى فِى ذُرِّيَّ<o>تِىٓ ۖ</> إِ<g>نِّ</>ى تُ<q>بْ</>تُ إِلَيْكَ وَإِ<g>نِّ</>ى مِنَ <h>ٱ</>لْمُسْلِ<p>مِي</>نَ"},{"n":16,"w":[["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব লোক"],["ٱلَّذِينَ","alladhīna","(are) the ones","(তারাই) যাদের"],["نَتَقَبَّلُ","nataqabbalu","We will accept","আমরা গ্রহণ করি"],["عَنْهُمْ","‘anhum","from them","তাদের থেকে"],["أَحْسَنَ","aḥsana","(the) best","সর্বোত্তম"],["مَا","mā","(of) what","যা"],["عَمِلُوا۟","‘amilū","they did","তারা কাজ করেছে"],["وَنَتَجَاوَزُ","wanatajāwazu","and We will overlook","এবং আমরা মার্জনা করি"],["عَن","‘an","[from]","যে"],["سَيِّـَٔاتِهِمْ","sayyiātihim","their evil deeds","তাদের মন্দকাজগুলোকে"],["فِىٓ","fī","among","হতে"],["أَصْحَـٰبِ","aṣḥābi","(the) companions","অধিবাসীদের"],["ٱلْجَنَّةِ ۖ","l-janati","(of) Paradise","জান্নাতের"],["وَعْدَ","wa‘da","A promise","প্রতিশ্রুতি"],["ٱلصِّدْقِ","l-ṣid'qi","true","সত্য"],["ٱلَّذِى","alladhī","which","যা"],["كَانُوا۟","kānū","they were","দেওয়া হয়েছিল"],["يُوعَدُونَ","yū‘adūna","promised","তাদের প্রতিশ্রুতি"]],"t":"أُ<s>و۟</><o>لَٰٓ</>ئِكَ <h>ٱ</>لَّذِينَ نَتَقَبَّلُ عَنْهُمْ أَحْسَنَ مَا عَمِلُو<s>ا۟</> وَنَتَجَاوَزُ عَ<k>ن سَ</>يِّـَٔاتِهِمْ <o>فِىٓ</> أَصْ<m>حَٰ</>بِ <h>ٱ</>لْجَ<g>نَّ</>ةِ ۖ وَعْدَ <h>ٱ</><l>ل</>صِّ<q>دْ</>قِ <h>ٱ</>لَّذِى كَانُو<s>ا۟</> يُوعَ<p>دُو</>نَ"},{"n":17,"w":[["وَٱلَّذِى","wa-alladhī","But the one who","এবং যে"],["قَالَ","qāla","says","বলে"],["لِوَٰلِدَيْهِ","liwālidayhi","to his parents","তার পিতামাতাকে"],["أُفٍّۢ","uffin","Uff","\"ধিক (আফসোস)"],["لَّكُمَآ","lakumā","to both of you","তোমাদের দু'জনের জন্যে"],["أَتَعِدَانِنِىٓ","ata‘idāninī","Do you promise me","আমাকে কি তোমরা ভয় দেখাচ্ছ"],["أَنْ","an","that","যে"],["أُخْرَجَ","ukh'raja","I will be brought forth","আমাকে বের করে আনা হবে"],["وَقَدْ","waqad","and have already passed away","অথচ নিশ্চয়ই"],["خَلَتِ","khalati","and have already passed away","অতীত হয়েছে"],["ٱلْقُرُونُ","l-qurūnu","the generations","বহু জনগোষ্ঠী"],["مِن","min","before me","\""],["قَبْلِى","qablī","before me","আমার পূর্বে\""],["وَهُمَا","wahumā","And they both","এবং তারা দু'জন"],["يَسْتَغِيثَانِ","yastaghīthāni","seek help","ফরিয়াদ করে"],["ٱللَّهَ","l-laha","(of) Allah","আল্লাহর কাছে (এবং বলে)"],["وَيْلَكَ","waylaka","Woe to you","\"তোমার জন্যে দুর্ভোগ"],["ءَامِنْ","āmin","Believe","ঈমান আন"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["وَعْدَ","wa‘da","(the) Promise","প্রতিশ্রুতি"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["حَقٌّۭ","ḥaqqun","(is) true","সত্য\""],["فَيَقُولُ","fayaqūlu","But he says","অতঃপর সে বলে"],["مَا","mā","Not","\"নয়"],["هَـٰذَآ","hādhā","(is) this","এটা"],["إِلَّآ","illā","but","এ ব্যতীত"],["أَسَـٰطِيرُ","asāṭīru","(the) stories","উপকথা সমূহ"],["ٱلْأَوَّلِينَ","l-awalīna","(of) the former (people)","পুরাতনকালের লোকদের\""]],"t":"وَ<h>ٱ</>لَّذِى قَالَ لِ<m>وَٰ</>لِدَيْهِ أُ<w>فٍّۢ لَّ</>كُ<o>مَآ</> أَتَعِدَانِ<o>نِىٓ</> أَنْ أُخْرَجَ وَقَ<q>دْ</> خَلَتِ <h>ٱ</>لْقُرُونُ مِ<k>ن قَ</><q>بْ</>لِى وَهُمَا يَسْتَغِيثَانِ <h>ٱ</>للَّهَ وَيْلَكَ ءَامِنْ إِ<g>نَّ</> وَعْدَ <h>ٱ</>للَّهِ حَ<k>قٌّۭ فَ</>يَقُولُ مَا <m>هَٰ</><o>ذَآ</> إِ<o>لَّآ</> أَ<m>سَٰ</>طِيرُ <h>ٱ</>لْأَوَّ<p>لِي</>نَ"},{"n":18,"w":[["أُو۟لَـٰٓئِكَ","ulāika","Those ","ঐসব লোক"],["ٱلَّذِينَ","alladhīna","(are) the ones","তারাই"],["حَقَّ","ḥaqqa","(has) proved true","অবধারিত হয়েছে"],["عَلَيْهِمُ","‘alayhimu","against them","তাদের উপর"],["ٱلْقَوْلُ","l-qawlu","the word","(আল্লাহর) বাণী"],["فِىٓ","fī","among","(তারা হবে) অন্তর্ভুক্ত"],["أُمَمٍۢ","umamin","nations","(শাস্তিপ্রাপ্ত) সম্প্রদায়গুলোর"],["قَدْ","qad","(that) already passed away","অবশ্যই"],["خَلَتْ","khalat","(that) already passed away","(যারা) অতীত হয়েছে"],["مِن","min","before them","মধ্য হতে"],["قَبْلِهِم","qablihim","before them","তাদের পূর্বে"],["مِّنَ","mina","of","মধ্য হতে"],["ٱلْجِنِّ","l-jini","(the) jinn","জিন"],["وَٱلْإِنسِ ۖ","wal-insi","and the men","ও মানুষের"],["إِنَّهُمْ","innahum","Indeed, they","তারা নিশ্চয়ই"],["كَانُوا۟","kānū","are","তারা ছিল"],["خَـٰسِرِينَ","khāsirīna","(the) losers","ক্ষতিগ্রস্ত"]],"t":"أُ<s>و۟</><o>لَٰٓ</>ئِكَ <h>ٱ</>لَّذِينَ حَقَّ عَلَيْهِمُ <h>ٱ</>لْقَوْلُ <o>فِىٓ</> أُمَ<k>مٍۢ قَ</><q>دْ</> خَلَتْ مِ<k>ن قَ</><q>بْ</>لِ<y>هِم مِّ</>نَ <h>ٱ</>لْجِ<g>نِّ</> وَ<h>ٱ</>لْإِ<k>نسِ</> ۖ إِ<g>نَّ</>هُمْ كَانُو<s>ا۟</> <m>خَٰ</>سِ<p>رِي</>نَ"},{"n":19,"w":[["وَلِكُلٍّۢ","walikullin","And for all","এবং প্রত্যেকের জন্যে"],["دَرَجَـٰتٌۭ","darajātun","(are) degrees","মর্যাদা (রয়েছে)"],["مِّمَّا","mimmā","for what","তা হতে যা"],["عَمِلُوا۟ ۖ","‘amilū","they did","তারা কাজ করেছে"],["وَلِيُوَفِّيَهُمْ","waliyuwaffiyahum","and that He may fully compensate them","এবং তাদেরকে যেন পূর্ণ দেন"],["أَعْمَـٰلَهُمْ","a‘mālahum","(for) their deeds","তাদের কাজের (প্রতিফল)"],["وَهُمْ","wahum","and they","এবং তাদের (উপর)"],["لَا","lā","will not be wronged","না"],["يُظْلَمُونَ","yuẓ'lamūna","will not be wronged","অবিচার করা হবে"]],"t":"وَلِكُ<k>لٍّۢ دَ</>رَ<m>جَٰ</><d>تٌۭ مِّ</><g>مَّ</>ا عَمِلُو<s>ا۟ ۖ</> وَلِيُوَفِّيَهُمْ أَعْ<m>مَٰ</>لَهُمْ وَهُمْ لَا يُظْلَ<p>مُو</>نَ"},{"n":20,"w":[["وَيَوْمَ","wayawma","And (the) Day","এবং যেদিন"],["يُعْرَضُ","yu‘'raḍu","will be exposed","উপস্থিত করা হবে"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["كَفَرُوا۟","kafarū","disbelieved","অস্বীকার করেছিল"],["عَلَى","‘alā","to","নিকট"],["ٱلنَّارِ","l-nāri","the Fire","আগুনের (বলা হবে)"],["أَذْهَبْتُمْ","adhhabtum","You exhausted","\"তোমরা নিঃশেষ করেছ"],["طَيِّبَـٰتِكُمْ","ṭayyibātikum","your good things","তোমাদের সুখ-সুবিধাগুলোকে"],["فِى","fī","in","মধ্যে"],["حَيَاتِكُمُ","ḥayātikumu","your life","তোমাদের জীবনের"],["ٱلدُّنْيَا","l-dun'yā","(of) the world","দুনিয়ার"],["وَٱسْتَمْتَعْتُم","wa-is'tamta‘tum","and you took your pleasures","এবং তোমরা ভোগ করেছ"],["بِهَا","bihā","therein","তার দ্বারা"],["فَٱلْيَوْمَ","fal-yawma","So today","অতএব আজ"],["تُجْزَوْنَ","tuj'zawna","you will be recompensed","তোমাদের প্রতিফল দেওয়া হবে"],["عَذَابَ","‘adhāba","(with) a punishment","শাস্তি"],["ٱلْهُونِ","l-hūni","humiliating","অপমানের"],["بِمَا","bimā","because","এ কারণে যা"],["كُنتُمْ","kuntum","you were","তোমরা করছিলে"],["تَسْتَكْبِرُونَ","tastakbirūna","arrogant","অহংকার"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["بِغَيْرِ","bighayri","without","ব্যতীত"],["ٱلْحَقِّ","l-ḥaqi","[the] right","অধিকার"],["وَبِمَا","wabimā","and because","এবং এ কারণে যা"],["كُنتُمْ","kuntum","you were","তোমরা করছিলে"],["تَفْسُقُونَ","tafsuqūna","defiantly disobedient","পাপাচার\""]],"t":"وَيَوْمَ يُعْرَضُ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> عَلَى <h>ٱ</><l>ل</><g>نَّ</>ارِ أَذْهَ<q>بْ</>تُمْ طَيِّ<m>بَٰ</>تِكُمْ فِى حَيَاتِكُمُ <h>ٱ</><l>ل</>دُّنْيَا وَ<h>ٱ</>سْتَمْتَعْ<f>تُم بِ</>هَا فَ<h>ٱ</>لْيَوْمَ تُ<q>جْ</>زَوْنَ عَذَابَ <h>ٱ</>لْهُونِ بِمَا كُ<k>نتُ</>مْ تَسْتَكْبِرُونَ فِى <h>ٱ</>لْأَرْضِ بِغَيْرِ <h>ٱ</>لْحَقِّ وَبِمَا كُ<k>نتُ</>مْ تَفْسُ<p>قُو</>نَ"},{"n":21,"w":[["۞ وَٱذْكُرْ","wa-udh'kur","And mention","এবং স্মরণ করো"],["أَخَا","akhā","(the) brother","ভাই"],["عَادٍ","‘ādin","(of) Aad","আ'দের (অর্থাৎ হুদের কথা)"],["إِذْ","idh","when","যখন"],["أَنذَرَ","andhara","he warned","সে সতর্ক করেছিল"],["قَوْمَهُۥ","qawmahu","his people","তার জাতিকে"],["بِٱلْأَحْقَافِ","bil-aḥqāfi","in the Al-Ahqaf ","আহকাফ (উপত্যকায়)"],["وَقَدْ","waqad","and had already passed away","এবং নিশ্চয়ই"],["خَلَتِ","khalati","and had already passed away","অতীত হয়েছে"],["ٱلنُّذُرُ","l-nudhuru","[the] warners","সতর্ককারীরা"],["مِنۢ","min","before him","মধ্য হতে"],["بَيْنِ","bayni","before him","মধ্য হতে"],["يَدَيْهِ","yadayhi","before him","তার নিকট অতীতেও"],["وَمِنْ","wamin","and after him","এবং"],["خَلْفِهِۦٓ","khalfihi","and after him","তার পরেও (এই বলে)"],["أَلَّا","allā","That not","\"যে না"],["تَعْبُدُوٓا۟","ta‘budū","you worship","তোমরা এবাদত করো (অন্য কারো)"],["إِلَّا","illā","except","ব্যতীত"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["إِنِّىٓ","innī","Indeed, I","আমি নিশ্চয়ই"],["أَخَافُ","akhāfu","[I] fear","ভয় করি"],["عَلَيْكُمْ","‘alaykum","for you","তোমাদের উপর"],["عَذَابَ","‘adhāba","a punishment","শাস্তির"],["يَوْمٍ","yawmin","(of) a Day","(এমন এক) দিনের"],["عَظِيمٍۢ","‘aẓīmin","Great","(যা) বড় কঠিন\""]],"t":"۞ وَ<h>ٱ</>ذْكُرْ أَخَا عَادٍ إِذْ أَ<k>نذَ</>رَ قَوْمَهُ<m>ۥ</> بِ<h>ٱ</>لْأَحْقَافِ وَقَ<q>دْ</> خَلَتِ <h>ٱ</><l>ل</><g>نُّ</>ذُرُ <i>مِنۢ بَ</>يْنِ يَدَيْهِ وَمِنْ خَلْفِ<o>هِۦٓ</> أَلَّا تَعْبُ<o>دُوٓ</><s>ا۟</> إِلَّا <h>ٱ</>للَّهَ إِ<g>نِّ</><o>ىٓ</> أَخَافُ عَلَيْكُمْ عَذَابَ يَوْمٍ عَ<p>ظِي</>مٍۢ"},{"n":22,"w":[["قَالُوٓا۟","qālū","They said","তারা বলেছিল"],["أَجِئْتَنَا","aji'tanā","Have you come to us","\"তুমি আমাদের কাছে এসেছ কি"],["لِتَأْفِكَنَا","litafikanā","to turn us away","আমাদেরকে ফিরাবে তুমি"],["عَنْ","‘an","from","হতে"],["ءَالِهَتِنَا","ālihatinā","our gods","আমাদের উপাস্যগুলো"],["فَأْتِنَا","fatinā","Then bring us","আমাদের কাছে আন তাহলে"],["بِمَا","bimā","what","ঐ বিষয় নিয়ে যার"],["تَعِدُنَآ","ta‘idunā","you threaten us","তুমি আমাদেরকে ভয় দেখাচ্ছ"],["إِن","in","if","যদি"],["كُنتَ","kunta","you are","তুমি হও"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلصَّـٰدِقِينَ","l-ṣādiqīna","the truthful","সত্যবাদীদের\""]],"t":"قَا<o>لُوٓ</><s>ا۟</> أَجِئْتَنَا لِتَأْفِكَنَا عَنْ ءَالِهَتِنَا فَأْتِنَا بِمَا تَعِدُ<o>نَآ</> إِ<k>ن كُنتَ</> مِنَ <h>ٱ</><l>ل</><m>صَّٰ</>دِ<p>قِي</>نَ"},{"n":23,"w":[["قَالَ","qāla","He said","সে বলল"],["إِنَّمَا","innamā","Only","\"প্রকৃতপক্ষে"],["ٱلْعِلْمُ","l-‘il'mu","the knowledge","এ জ্ঞান (আছে)"],["عِندَ","‘inda","(is) with Allah","(শুধুমাত্র) নিকট"],["ٱللَّهِ","l-lahi","(is) with Allah","আল্লাহরই"],["وَأُبَلِّغُكُم","wa-uballighukum","and I convey to you","এবং আমি তোমাদের পৌঁছাই"],["مَّآ","mā","what","সেই (পয়গাম)"],["أُرْسِلْتُ","ur'sil'tu","I am sent","আমি প্রেরিত হয়েছি"],["بِهِۦ","bihi","with it","যা নিয়ে"],["وَلَـٰكِنِّىٓ","walākinnī","but","কিন্তু আমি"],["أَرَىٰكُمْ","arākum","I see you","তোমাদেরকে দেখছি"],["قَوْمًۭا","qawman","a people","(এমন) লোক"],["تَجْهَلُونَ","tajhalūna","ignorant","(যারা) মূর্খতা করছ\""]],"t":"قَالَ إِ<g>نَّ</>مَا <h>ٱ</>لْعِلْمُ عِ<k>ندَ</> <h>ٱ</>للَّهِ وَأُبَلِّغُ<y>كُم مَّ</><o>آ</> أُرْسِلْتُ بِ<m>هِۦ</> وَ<m>لَٰ</>كِ<g>نِّ</><o>ىٓ</> أَرَ<m>ىٰ</>كُمْ قَوْ<k>مًۭا تَ</><q>جْ</>هَ<p>لُو</>نَ"},{"n":24,"w":[["فَلَمَّا","falammā","Then when","অতঃপর যখন"],["رَأَوْهُ","ra-awhu","they saw it","তারা তা দেখলো"],["عَارِضًۭا","‘āriḍan","(as) a cloud","মেঘমালারূপে"],["مُّسْتَقْبِلَ","mus'taqbila","approaching","আগ্রসরমান"],["أَوْدِيَتِهِمْ","awdiyatihim","their valleys","তাদের উপত্যকাগুলোর (দিকে)"],["قَالُوا۟","qālū","they said","তারা বলল"],["هَـٰذَا","hādhā","This","\"এটা"],["عَارِضٌۭ","‘āriḍun","(is) a cloud","মেঘমালা"],["مُّمْطِرُنَا ۚ","mum'ṭirunā","bringing us rain","আমাদেরকে বৃষ্টি দিবে\""],["بَلْ","bal","Nay","বরং না"],["هُوَ","huwa","it","সেই (জিনিস)"],["مَا","mā","(is) what","যা"],["ٱسْتَعْجَلْتُم","is'ta‘jaltum","you were asking it to be hastened","তোমরা তাড়াতাড়ি চেয়েছিলে"],["بِهِۦ ۖ","bihi","you were asking it to be hastened","তার"],["رِيحٌۭ","rīḥun","a wind","(এটা) ঝড়ো বাতাস"],["فِيهَا","fīhā","in it","তার মধ্যে আছে"],["عَذَابٌ","‘adhābun","(is) a punishment","শাস্তি"],["أَلِيمٌۭ","alīmun","painful","বড় যন্ত্রণাদায়ক"]],"t":"فَلَ<g>مَّ</>ا رَأَوْهُ عَارِ<d>ضًۭا مُّ</>سْتَ<q>قْ</>بِلَ أَوْدِيَتِهِمْ قَالُو<s>ا۟</> <m>هَٰ</>ذَا عَارِ<d>ضٌۭ مُّ</>مْطِرُنَا ۚ بَلْ هُوَ مَا <h>ٱ</>سْتَعْجَلْ<f>تُم بِ</><m>هِۦ</> ۖ رِي<k>حٌۭ فِ</>يهَا عَذَابٌ أَ<p>لِي</>مٌۭ"},{"n":25,"w":[["تُدَمِّرُ","tudammiru","Destroying","ধ্বংস করে দিবে"],["كُلَّ","kulla","every","প্রত্যেক"],["شَىْءٍۭ","shayin","thing","জিনিসকে"],["بِأَمْرِ","bi-amri","by (the) command","নির্দেশের মাধ্যমে"],["رَبِّهَا","rabbihā","(of) its Lord","তার রবের"],["فَأَصْبَحُوا۟","fa-aṣbaḥū","Then they became (such)","তখন তারা হয়ে গেল (এমন যে)"],["لَا","lā","not","না"],["يُرَىٰٓ","yurā","is seen","দেখা যাচ্ছিল (আর কিছু)"],["إِلَّا","illā","except","এ ব্যতীত"],["مَسَـٰكِنُهُمْ ۚ","masākinuhum","their dwellings","তাদের বসতিগুলো"],["كَذَٰلِكَ","kadhālika","Thus","এভাবে"],["نَجْزِى","najzī","We recompense","আমরা কর্মফল দিই"],["ٱلْقَوْمَ","l-qawma","the people","সম্প্রদায়কে"],["ٱلْمُجْرِمِينَ","l-muj'rimīna","[the] criminals","(যারা) অপরাধী"]],"t":"تُدَ<g>مِّ</>رُ كُلَّ شَىْ<i>ءٍۭ بِ</>أَمْرِ رَبِّهَا فَأَصْبَحُو<s>ا۟</> لَا يُرَ<o>ىٰٓ</> إِلَّا مَ<m>سَٰ</>كِنُهُمْ ۚ كَ<m>ذَٰ</>لِكَ نَ<q>جْ</>زِى <h>ٱ</>لْقَوْمَ <h>ٱ</>لْمُ<q>جْ</>رِ<p>مِي</>نَ"},{"n":26,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["مَكَّنَّـٰهُمْ","makkannāhum","We had established them","তাদেরকে আমরা ক্ষমতা দিয়েছিলাম"],["فِيمَآ","fīmā","in what","এমন বিষয়ে যার"],["إِن","in","not","না"],["مَّكَّنَّـٰكُمْ","makkannākum","We have established you","তোমাদেরকে আমরা ক্ষমতা দিয়েছি"],["فِيهِ","fīhi","in it","সেসব বিষয়ে"],["وَجَعَلْنَا","waja‘alnā","and We made","এবং আমরা দিয়েছিলাম"],["لَهُمْ","lahum","for them","তাদেরকে"],["سَمْعًۭا","sam‘an","hearing","কান"],["وَأَبْصَـٰرًۭا","wa-abṣāran","and vision","ও চোখ"],["وَأَفْـِٔدَةًۭ","wa-afidatan","and hearts","ও হৃদয়"],["فَمَآ","famā","But not","অতঃপর না"],["أَغْنَىٰ","aghnā","availed","কাজে আসল"],["عَنْهُمْ","‘anhum","them","তাদের জন্যে"],["سَمْعُهُمْ","sam‘uhum","their hearing","তাদের কান"],["وَلَآ","walā","and not","এবং না"],["أَبْصَـٰرُهُمْ","abṣāruhum","their vision","তাদের চোখ"],["وَلَآ","walā","and not","আর না"],["أَفْـِٔدَتُهُم","afidatuhum","their hearts","তাদের অন্তর"],["مِّن","min","any","কোনো"],["شَىْءٍ","shayin","thing","কিছুই"],["إِذْ","idh","when","যখন"],["كَانُوا۟","kānū","they were","করছিল"],["يَجْحَدُونَ","yajḥadūna","rejecting","তারা অস্বীকার"],["بِـَٔايَـٰتِ","biāyāti","(the) Signs","আয়াতগুলোকে"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَحَاقَ","waḥāqa","and enveloped","এবং ঘিরে নিল"],["بِهِم","bihim","them","তাদেরকে"],["مَّا","mā","what","তাই"],["كَانُوا۟","kānū","they used to","তারা ছিল"],["بِهِۦ","bihi","[at it]","যে সম্পর্কে"],["يَسْتَهْزِءُونَ","yastahziūna","ridicule","ঠাট্টা-বিদ্রুপ করত"]],"t":"وَلَقَ<q>دْ</> مَكَّ<g>نَّٰ</>هُمْ فِي<o>مَآ</> <d>إِن مَّ</>كَّ<g>نَّٰ</>كُمْ فِيهِ وَجَعَلْنَا لَهُمْ سَمْ<d>عًۭا وَ</>أَ<q>بْ</><m>صَٰ</><d>رًۭا وَ</>أَفْـِٔدَ<k>ةًۭ فَ</><o>مَآ</> أَغْنَىٰ عَنْهُمْ سَمْعُهُمْ وَ<o>لَآ</> أَ<q>بْ</><m>صَٰ</>رُهُمْ وَ<o>لَآ</> أَفْـِٔدَتُ<y>هُم مِّ</><k>ن شَ</>ىْءٍ إِذْ كَانُو<s>ا۟</> يَ<q>جْ</>حَدُونَ بِـَٔا<m>يَٰ</>تِ <h>ٱ</>للَّهِ وَحَاقَ بِ<y>هِم مَّ</>ا كَانُو<s>ا۟</> بِ<m>هِۦ</> يَسْتَهْزِ<p>ءُو</>نَ"},{"n":27,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["أَهْلَكْنَا","ahlaknā","We destroyed","আমরা ধ্বংস করেছি"],["مَا","mā","what","যা"],["حَوْلَكُم","ḥawlakum","surrounds you","তোমাদের চারপাশে (আজ দেখছ)"],["مِّنَ","mina","of","মধ্য হতে"],["ٱلْقُرَىٰ","l-qurā","the towns","জনপদ সমূহের"],["وَصَرَّفْنَا","waṣarrafnā","and We have diversified","এবং আমরা বিভিন্নভাবে বর্ণনা করেছি"],["ٱلْـَٔايَـٰتِ","l-āyāti","the Signs","আমার নিদর্শন সমূহকে"],["لَعَلَّهُمْ","la‘allahum","that they may","যাতে তারা"],["يَرْجِعُونَ","yarji‘ūna","return","ফিরে আসে"]],"t":"وَلَقَ<q>دْ</> أَهْلَكْنَا مَا حَوْلَ<y>كُم مِّ</>نَ <h>ٱ</>لْقُرَىٰ وَصَرَّفْنَا <h>ٱ</>لْءَا<m>يَٰ</>تِ لَعَلَّهُمْ يَرْجِ<p>عُو</>نَ"},{"n":28,"w":[["فَلَوْلَا","falawlā","Then why (did) not","অতঃপর কেন না"],["نَصَرَهُمُ","naṣarahumu","help them","তাদেরকে সাহায্য করল"],["ٱلَّذِينَ","alladhīna","those whom","(সেসব সত্তা) যাদেরকে"],["ٱتَّخَذُوا۟","ittakhadhū","they had taken","তারা গ্রহণ করেছিল"],["مِن","min","besides","মধ্য হতে"],["دُونِ","dūni","besides","ছাড়া"],["ٱللَّهِ","l-lahi","Allah","আল্লাহকে"],["قُرْبَانًا","qur'bānan","gods as a way of approach","নৈকট্যের মাধ্যম"],["ءَالِهَةًۢ ۖ","ālihatan","gods as a way of approach","উপাস্যরূপে"],["بَلْ","bal","Nay","বরং"],["ضَلُّوا۟","ḍallū","they were lost","তারা হারিয়ে গেল"],["عَنْهُمْ ۚ","‘anhum","from them","তাদের থেকে"],["وَ