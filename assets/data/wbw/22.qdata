m","তাদেরকে জীবিকা (হিসেবে) দিয়েছেন"],["مِّنۢ","min","of","হ'তে"],["بَهِيمَةِ","bahīmati","(the) beast","চতুষ্পদ জন্তু"],["ٱلْأَنْعَـٰمِ ۖ","l-an‘āmi","(of) cattle","গৃহপালিত"],["فَكُلُوا۟","fakulū","So eat","অতঃপর তোমরা খাও"],["مِنْهَا","min'hā","of them","তা হ'তে"],["وَأَطْعِمُوا۟","wa-aṭ‘imū","and feed","ও খাওয়াও"],["ٱلْبَآئِسَ","l-bāisa","the miserable","দুস্থদেরকে"],["ٱلْفَقِيرَ","l-faqīra","the poor","অভাবগ্রস্তদেরকে"]],"t":"لِّيَشْهَدُو<s>ا۟</> مَ<m>نَٰ</>فِعَ لَهُمْ وَيَذْكُرُو<s>ا۟</> <h>ٱ</>سْمَ <h>ٱ</>للَّهِ <o>فِىٓ</> أَيَّا<d>مٍۢ مَّ</>عْلُو<m>مَٰ</>تٍ عَلَىٰ مَا رَزَقَ<y>هُم مِّ</><i>نۢ بَ</>هِيمَةِ <h>ٱ</>لْأَنْ<m>عَٰ</>مِ ۖ فَكُلُو<s>ا۟</> مِنْهَا وَأَ<q>طْ</>عِمُو<s>ا۟</> <h>ٱ</>لْ<o>بَآ</>ئِسَ <h>ٱ</>لْفَ<p>قِي</>رَ"},{"n":29,"w":[["ثُمَّ","thumma","Then","এরপর"],["لْيَقْضُوا۟","l'yaqḍū","let them end","যেন তারা দূর করে"],["تَفَثَهُمْ","tafathahum","their prescribed duties","তাদের অপরিচ্ছন্নতা"],["وَلْيُوفُوا۟","walyūfū","and fulfil","ও যেন তারা পূর্ণ করে"],["نُذُورَهُمْ","nudhūrahum","their vows","তাদের মানতগুলোকে"],["وَلْيَطَّوَّفُوا۟","walyaṭṭawwafū","and circumambulate","ও যেন তারা তওয়াফ করে"],["بِٱلْبَيْتِ","bil-bayti","the House","ঘরের"],["ٱلْعَتِيقِ","l-‘atīqi","[the] Ancient","প্রাচীন\""]],"t":"ثُ<g>مَّ</> لْيَ<q>قْ</>ضُو<s>ا۟</> تَفَثَهُمْ وَلْيُوفُو<s>ا۟</> نُذُورَهُمْ وَلْيَطَّوَّفُو<s>ا۟</> بِ<h>ٱ</>لْبَيْتِ <h>ٱ</>لْعَ<p>تِي</><q>قِ</>"},{"n":30,"w":[["ذَٰلِكَ","dhālika","That","এটাই (বিধান)"],["وَمَن","waman","and whoever","আর যে"],["يُعَظِّمْ","yu‘aẓẓim","honors","সম্মান করে"],["حُرُمَـٰتِ","ḥurumāti","(the) sacred rites","(নির্ধারিত) মর্যাদাসমূহের"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["فَهُوَ","fahuwa","then it","তবেই তা (হবে)"],["خَيْرٌۭ","khayrun","(is) best","উত্তম"],["لَّهُۥ","lahu","for him","জন্যে তার"],["عِندَ","‘inda","near","নিকট"],["رَبِّهِۦ ۗ","rabbihi","his Lord","তার রবের"],["وَأُحِلَّتْ","wa-uḥillat","And are made lawful","আর হালাল করা হয়েছে"],["لَكُمُ","lakumu","to you","জন্যে তোমাদের"],["ٱلْأَنْعَـٰمُ","l-an‘āmu","the cattle","গৃহপালিত জন্তু"],["إِلَّا","illā","except","এ ছাড়া"],["مَا","mā","what","যা"],["يُتْلَىٰ","yut'lā","is recited","শোনানো হয়েছে"],["عَلَيْكُمْ ۖ","‘alaykum","to you","তোমাদের কাছে"],["فَٱجْتَنِبُوا۟","fa-ij'tanibū","So avoid","অতঃপর তোমরা বেঁচে থাকো"],["ٱلرِّجْسَ","l-rij'sa","the abomination","অপবিত্রতা (হ'তে)"],["مِنَ","mina","of","(কারণে) তৈরি"],["ٱلْأَوْثَـٰنِ","l-awthāni","the idols","মূর্তিসমূহের"],["وَٱجْتَنِبُوا۟","wa-ij'tanibū","and avoid","আর তোমরা দূরে থাকো"],["قَوْلَ","qawla","(the) word","কথা"],["ٱلزُّورِ","l-zūri","false","মিথ্যার"]],"t":"<m>ذَٰ</>لِكَ وَ<d>مَن يُ</>عَظِّمْ حُرُ<m>مَٰ</>تِ <h>ٱ</>للَّهِ فَهُوَ خَيْ<w>رٌۭ لَّ</>هُ<m>ۥ</> عِ<k>ندَ</> رَبِّ<m>هِۦ</> ۗ وَأُحِلَّتْ لَكُمُ <h>ٱ</>لْأَنْ<m>عَٰ</>مُ إِلَّا مَا يُتْلَىٰ عَلَيْكُمْ ۖ فَ<h>ٱ</><q>جْ</>تَنِبُو<s>ا۟</> <h>ٱ</><l>ل</>رِّ<q>جْ</>سَ مِنَ <h>ٱ</>لْأَوْ<m>ثَٰ</>نِ وَ<h>ٱ</><q>جْ</>تَنِبُو<s>ا۟</> قَوْلَ <h>ٱ</><l>ل</><p>زُّو</>رِ"},{"n":31,"w":[["حُنَفَآءَ","ḥunafāa","Being upright","একনিষ্ঠ হয়ে"],["لِلَّهِ","lillahi","to Allah","জন্যে আল্লাহরই"],["غَيْرَ","ghayra","not","ছাড়া"],["مُشْرِكِينَ","mush'rikīna","associating partners","মুশরিক (হওয়া)"],["بِهِۦ ۚ","bihi","with Him","তাঁর সাথে"],["وَمَن","waman","And whoever","আর যে"],["يُشْرِكْ","yush'rik","associates partners","শরীক করে"],["بِٱللَّهِ","bil-lahi","with Allah","আল্লাহর সাথে"],["فَكَأَنَّمَا","faka-annamā","then (it is) as though","অতঃপর যেন"],["خَرَّ","kharra","he had fallen","সে পড়ে গেলো"],["مِنَ","mina","from","হ'তে"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশ"],["فَتَخْطَفُهُ","fatakhṭafuhu","and (had) snatched him","অতঃপর তাকে ছোঁ মেরে নিয়ে যাবে"],["ٱلطَّيْرُ","l-ṭayru","the birds","পাখি"],["أَوْ","aw","or","অথবা"],["تَهْوِى","tahwī","had blown","উড়িয়ে যাবে"],["بِهِ","bihi","him","নিয়ে তাকে"],["ٱلرِّيحُ","l-rīḥu","the wind","বাতাস"],["فِى","fī","to","মধ্যে"],["مَكَانٍۢ","makānin","a place","স্থানের"],["سَحِيقٍۢ","saḥīqin","far off","দূরবর্তী"]],"t":"حُنَ<o>فَآ</>ءَ لِلَّهِ غَيْرَ مُشْرِكِينَ بِ<m>هِۦ</> ۚ وَ<d>مَن يُ</>شْرِكْ بِ<h>ٱ</>للَّهِ فَكَأَ<g>نَّ</>مَا خَرَّ مِنَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ فَتَخْطَفُهُ <h>ٱ</><l>ل</>طَّيْرُ أَوْ تَهْوِى بِهِ <h>ٱ</><l>ل</>رِّيحُ فِى مَكَا<k>نٍۢ سَ</><p>حِي</><q>قٍۢ</>"},{"n":32,"w":[["ذَٰلِكَ","dhālika","That","এটাই (আসল ব্যাপার)"],["وَمَن","waman","and whoever","আর যে"],["يُعَظِّمْ","yu‘aẓẓim","honors","সম্মান করে"],["شَعَـٰٓئِرَ","sha‘āira","(the) Symbols","নিদর্শনাবলী কে"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["فَإِنَّهَا","fa-innahā","then indeed, it","তবে তা নিশ্চয়ই (উৎসারিত হয়)"],["مِن","min","(is) from","হ'তে"],["تَقْوَى","taqwā","(the) piety","তাক্বওয়া"],["ٱلْقُلُوبِ","l-qulūbi","(of) the hearts","অন্তরসমূহের"]],"t":"<m>ذَٰ</>لِكَ وَ<d>مَن يُ</>عَظِّمْ شَ<o>عَٰٓ</>ئِرَ <h>ٱ</>للَّهِ فَإِ<g>نَّ</>هَا مِ<k>ن تَ</><q>قْ</>وَى <h>ٱ</>لْقُ<p>لُو</><q>بِ</>"},{"n":33,"w":[["لَكُمْ","lakum","For you","জন্যে তোমাদের"],["فِيهَا","fīhā","therein","মধ্যে এর"],["مَنَـٰفِعُ","manāfi‘u","(are) benefits","নানা উপকার"],["إِلَىٰٓ","ilā","for","পর্যন্ত"],["أَجَلٍۢ","ajalin","a term","সময়"],["مُّسَمًّۭى","musamman","appointed","নির্দিষ্ট"],["ثُمَّ","thumma","then","এরপর"],["مَحِلُّهَآ","maḥilluhā","their place of sacrifice","তার (কুরবানির জায়গা)"],["إِلَى","ilā","(is) at","নিকট (অবস্থিত)"],["ٱلْبَيْتِ","l-bayti","the House","ঘরের"],["ٱلْعَتِيقِ","l-‘atīqi","the Ancient","প্রাচীন"]],"t":"لَكُمْ فِيهَا مَ<m>نَٰ</>فِعُ إِلَ<o>ىٰٓ</> أَجَ<d>لٍۢ مُّ</>سَ<k>مًّۭى ثُ</><g>مَّ</> مَحِلُّ<o>هَآ</> إِلَى <h>ٱ</>لْبَيْتِ <h>ٱ</>لْعَ<p>تِي</><q>قِ</>"},{"n":34,"w":[["وَلِكُلِّ","walikulli","And for every","এবং জন্যে প্রত্যেক"],["أُمَّةٍۢ","ummatin","nation","জাতির"],["جَعَلْنَا","ja‘alnā","We have appointed","আমরা নির্দিষ্ট করে দিয়েছি"],["مَنسَكًۭا","mansakan","a rite","কুরবানির নিয়ম"],["لِّيَذْكُرُوا۟","liyadhkurū","that they may mention","যেন তারা স্মরণ করে"],["ٱسْمَ","is'ma","(the) name","নাম"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["عَلَىٰ","‘alā","over","উপর"],["مَا","mā","what","যা"],["رَزَقَهُم","razaqahum","He (has) provided them","তাদেরকে জীবিকা দিয়েছেন"],["مِّنۢ","min","of","মধ্য হ'তে"],["بَهِيمَةِ","bahīmati","(the) beast","চতুষ্পদজন্তুর"],["ٱلْأَنْعَـٰمِ ۗ","l-an‘āmi","(of) cattle","গৃহপালিত"],["فَإِلَـٰهُكُمْ","fa-ilāhukum","And your God","অতএব তোমাদের ইলাহ"],["إِلَـٰهٌۭ","ilāhun","(is) God","ইলাহ"],["وَٰحِدٌۭ","wāḥidun","One","একই"],["فَلَهُۥٓ","falahu","so to Him","সুতরাং তাঁরই নিকট"],["أَسْلِمُوا۟ ۗ","aslimū","submit","আত্মসমর্পণ করো"],["وَبَشِّرِ","wabashiri","And give glad tidings","আর সুসংবাদ দাও"],["ٱلْمُخْبِتِينَ","l-mukh'bitīna","(to) the humble ones","(আল্লাহর হুকুমের কাছে) অবনতকারীদের"]],"t":"وَلِكُلِّ أُ<g>مَّ</><k>ةٍۢ جَ</>عَلْنَا مَ<k>نسَ</><w>كًۭا لِّ</>يَذْكُرُو<s>ا۟</> <h>ٱ</>سْمَ <h>ٱ</>للَّهِ عَلَىٰ مَا رَزَقَ<y>هُم مِّ</><i>نۢ بَ</>هِيمَةِ <h>ٱ</>لْأَنْ<m>عَٰ</>مِ ۗ فَإِ<m>لَٰ</>هُكُمْ إِ<m>لَٰ</><d>هٌۭ وَٰ</>حِ<k>دٌۭ فَ</>لَهُ<o>ۥٓ</> أَسْلِمُو<s>ا۟ ۗ</> وَبَشِّرِ <h>ٱ</>لْمُخْبِ<p>تِي</>نَ"},{"n":35,"w":[["ٱلَّذِينَ","alladhīna","Those","যারা (এরূপ যে)"],["إِذَا","idhā","when","যখন"],["ذُكِرَ","dhukira","is mentioned","উল্লেখ করা হয়"],["ٱللَّهُ","l-lahu","Allah ","আল্লাহর (নাম)"],["وَجِلَتْ","wajilat","fear","কেঁপে উঠে"],["قُلُوبُهُمْ","qulūbuhum","their hearts","তাদের অন্তরগুলো"],["وَٱلصَّـٰبِرِينَ","wal-ṣābirīna","and those who are patient","ধৈর্য্যধারণকারী (হয়)"],["عَلَىٰ","‘alā","over","(এর) উপর"],["مَآ","mā","whatever","যা"],["أَصَابَهُمْ","aṣābahum","has afflicted them","তাদের উপর আপতিত হয়"],["وَٱلْمُقِيمِى","wal-muqīmī","and those who establish","ও প্রতিষ্ঠাকারী (হয়)"],["ٱلصَّلَوٰةِ","l-ṣalati","the prayer","সালাত"],["وَمِمَّا","wamimmā","and out of what","এবং (তা) হ'তে যা"],["رَزَقْنَـٰهُمْ","razaqnāhum","We have provided them","তাদের আমরা জীবিকা দিয়েছি"],["يُنفِقُونَ","yunfiqūna","they spend","তারা খরচ করে"]],"t":"ٱلَّذِينَ إِذَا ذُكِرَ <h>ٱ</>للَّهُ وَجِلَتْ قُلُوبُهُمْ وَ<h>ٱ</><l>ل</><m>صَّٰ</>بِرِينَ عَلَىٰ <o>مَآ</> أَصَابَهُمْ وَ<h>ٱ</>لْمُقِيمِى <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةِ وَمِ<g>مَّ</>ا رَزَ<q>قْ</><m>نَٰ</>هُمْ يُ<k>نفِ</><p>قُو</>نَ"},{"n":36,"w":[["وَٱلْبُدْنَ","wal-bud'na","And the camels and cattle ","এবং কুরবানির উটগুলো"],["جَعَلْنَـٰهَا","ja‘alnāhā","We have made them","সেগুলোকে আমরা করেছি"],["لَكُم","lakum","for you","জন্যে তোমাদের"],["مِّن","min","among","অন্তর্ভুক্ত"],["شَعَـٰٓئِرِ","sha‘āiri","(the) Symbols","নিদর্শনাবলীর"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["لَكُمْ","lakum","for you","জন্যে তোমাদের রয়েছে"],["فِيهَا","fīhā","therein","তার মধ্যে"],["خَيْرٌۭ ۖ","khayrun","(is) good","কল্যাণ"],["فَٱذْكُرُوا۟","fa-udh'kurū","So mention","তাই (জবেহ করার সময়) উচ্চারণ করো"],["ٱسْمَ","is'ma","(the) name","নাম"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["عَلَيْهَا","‘alayhā","over them","তাদের উপর"],["صَوَآفَّ ۖ","ṣawāffa","(when) lined up","সারিবদ্ধভাবে (দাঁড়ানো অবস্থায়)"],["فَإِذَا","fa-idhā","and when","অতঃপর যখন"],["وَجَبَتْ","wajabat","are down","কাত হয়ে পড়ে"],["جُنُوبُهَا","junūbuhā","their sides","তাদের পাশগুলো (অর্থাৎ প্রাণ নির্গত হয়)"],["فَكُلُوا۟","fakulū","then eat","তখন তোমরাখাও"],["مِنْهَا","min'hā","from them","তা হ'তে"],["وَأَطْعِمُوا۟","wa-aṭ‘imū","and feed","এবং তোমরা খাওয়াও"],["ٱلْقَانِعَ","l-qāni‘a","the needy who do not ask","ধৈর্য্যশীল অভাবগ্রস্তকে"],["وَٱلْمُعْتَرَّ ۚ","wal-mu‘'tara","and the needy who ask","ও চায় এমন অভাবগ্রস্তকে"],["كَذَٰلِكَ","kadhālika","Thus","এভাবে"],["سَخَّرْنَـٰهَا","sakharnāhā","We have subjected them","সেগুলোকে আমরা নিয়ন্ত্রিত করেছি"],["لَكُمْ","lakum","to you","জন্যে তোমাদের"],["لَعَلَّكُمْ","la‘allakum","so that you may","যাতে তোমরা"],["تَشْكُرُونَ","tashkurūna","be grateful","শোকর করো"]],"t":"وَ<h>ٱ</>لْبُ<q>دْ</>نَ جَعَلْ<m>نَٰ</>هَا لَ<y>كُم مِّ</><k>ن شَ</><o>عَٰٓ</>ئِرِ <h>ٱ</>للَّهِ لَكُمْ فِيهَا خَيْ<k>رٌۭ ۖ فَ</><h>ٱ</>ذْكُرُو<s>ا۟</> <h>ٱ</>سْمَ <h>ٱ</>للَّهِ عَلَيْهَا صَ<n>وَآ</>فَّ ۖ فَإِذَا وَجَبَتْ جُنُوبُهَا فَكُلُو<s>ا۟</> مِنْهَا وَأَ<q>طْ</>عِمُو<s>ا۟</> <h>ٱ</>لْقَانِعَ وَ<h>ٱ</>لْمُعْتَرَّ ۚ كَ<m>ذَٰ</>لِكَ سَخَّرْ<m>نَٰ</>هَا لَكُمْ لَعَلَّكُمْ تَشْكُ<p>رُو</>نَ"},{"n":37,"w":[["لَن","lan","Will not","কখনও না"],["يَنَالَ","yanāla","reach","পৌঁছে"],["ٱللَّهَ","l-laha","Allah","আল্লাহর (নিকট)"],["لُحُومُهَا","luḥūmuhā","their meat","তাদের গোশ্‌তসমূহ"],["وَلَا","walā","and not","আর না"],["دِمَآؤُهَا","dimāuhā","their blood","তাদের রক্ত"],["وَلَـٰكِن","walākin","but","কিন্তু"],["يَنَالُهُ","yanāluhu","reaches Him","তাঁর (নিকট) পৌঁছে"],["ٱلتَّقْوَىٰ","l-taqwā","the piety","তাক্বওয়া"],["مِنكُمْ ۚ","minkum","from you","তোমাদের হ'তে"],["كَذَٰلِكَ","kadhālika","Thus","এভাবে"],["سَخَّرَهَا","sakharahā","He subjected them","সেগুলোকে তিনি নিয়ন্ত্রিত করেছেন"],["لَكُمْ","lakum","to you","জন্যে তোমাদের"],["لِتُكَبِّرُوا۟","litukabbirū","so that you may magnify","যেন তোমরা শ্রেষ্ঠত্ব ঘোষণা (তাকবীর) করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহর"],["عَلَىٰ","‘alā","for","সে অনুযায়ী"],["مَا","mā","what","যেমন"],["هَدَىٰكُمْ ۗ","hadākum","He has guided you","তোমাদেরকে পথ দেখিয়েছেন"],["وَبَشِّرِ","wabashiri","And give glad tidings","আর সুসংবাদ দাও"],["ٱلْمُحْسِنِينَ","l-muḥ'sinīna","(to) the good-doers","সৎকর্মপরায়ণদেরকে"]],"t":"<d>لَن يَ</>نَالَ <h>ٱ</>للَّهَ لُحُومُهَا وَلَا دِ<o>مَآ</>ؤُهَا وَ<m>لَٰ</><d>كِن يَ</>نَالُهُ <h>ٱ</><l>ل</>تَّ<q>قْ</>وَىٰ مِ<k>نكُ</>مْ ۚ كَ<m>ذَٰ</>لِكَ سَخَّرَهَا لَكُمْ لِتُكَبِّرُو<s>ا۟</> <h>ٱ</>للَّهَ عَلَىٰ مَا هَدَ<m>ىٰ</>كُمْ ۗ وَبَشِّرِ <h>ٱ</>لْمُحْسِ<p>نِي</>نَ"},{"n":38,"w":[["۞ إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يُدَٰفِعُ","yudāfi‘u","defends","প্রতিরোধ করেন"],["عَنِ","‘ani","defends","(তাদের পক্ষ) হ'তে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ءَامَنُوٓا۟ ۗ","āmanū","believe","ঈমান এনেছে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَا","lā","(does) not","না"],["يُحِبُّ","yuḥibbu","like","পছন্দ করেন"],["كُلَّ","kulla","every","প্রত্যেক"],["خَوَّانٍۢ","khawwānin","treacherous","বিশ্বাসঘাতক"],["كَفُورٍ","kafūrin","ungrateful","অকৃতজ্ঞকে"]],"t":"۞ إِ<g>نَّ</> <h>ٱ</>للَّهَ يُ<m>دَٰ</>فِعُ عَنِ <h>ٱ</>لَّذِينَ ءَامَ<o>نُوٓ</><s>ا۟</> ۗ إِ<g>نَّ</> <h>ٱ</>للَّهَ لَا يُحِبُّ كُلَّ خَوَّا<k>نٍۢ كَ</><p>فُو</>رٍ"},{"n":39,"w":[["أُذِنَ","udhina","Permission is given","অনুমতি দেয়া হলো"],["لِلَّذِينَ","lilladhīna","to those who","জন্যে তাদের (যাদের বিরুদ্ধে)"],["يُقَـٰتَلُونَ","yuqātalūna","are being fought","যুদ্ধ করা হচ্ছে"],["بِأَنَّهُمْ","bi-annahum","because they","কারণ তারা"],["ظُلِمُوا۟ ۚ","ẓulimū","were wronged","নির্যাতিত"],["وَإِنَّ","wa-inna","And indeed","আর নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["عَلَىٰ","‘alā","for","ক্ষেত্রে"],["نَصْرِهِمْ","naṣrihim","their victory","সাহায্যের তাদের"],["لَقَدِيرٌ","laqadīrun","(is) surely Able","অবশ্যই ক্ষমতাবান"]],"t":"أُذِنَ لِلَّذِينَ يُ<m>قَٰ</>تَلُونَ بِأَ<g>نَّ</>هُمْ ظُلِمُو<s>ا۟ ۚ</> وَإِ<g>نَّ</> <h>ٱ</>للَّهَ عَلَىٰ نَصْرِهِمْ لَقَ<p>دِي</>رٌ"},{"n":40,"w":[["ٱلَّذِينَ","alladhīna","Those who","যাদেরকে"],["أُخْرِجُوا۟","ukh'rijū","have been evicted","বের করে দেয়া হয়েছে"],["مِن","min","from","হ'তে"],["دِيَـٰرِهِم","diyārihim","their homes","তাদের ঘরবাড়িগুলো"],["بِغَيْرِ","bighayri","without","সঙ্গে নয়"],["حَقٍّ","ḥaqqin","right","সত্যের (অন্যায়ভাবে)"],["إِلَّآ","illā","except","(তাদের অপরাধ) এছাড়া নয়"],["أَن","an","that","যে"],["يَقُولُوا۟","yaqūlū","they said","তারা বলে"],["رَبُّنَا","rabbunā","Our Lord","\"আমাদের রব"],["ٱللَّهُ ۗ","l-lahu","(is) Allah","আল্লাহই\""],["وَلَوْلَا","walawlā","And if not","এবং যদি না"],["دَفْعُ","daf‘u","Allah checks","প্রতিহত করতেন"],["ٱللَّهِ","l-lahi","Allah checks","আল্লাহ"],["ٱلنَّاسَ","l-nāsa","the people","লোকদের"],["بَعْضَهُم","ba‘ḍahum","some of them","তাদের কিছু অংশকে"],["بِبَعْضٍۢ","biba‘ḍin","by others","(অন্য) কিছু অংশ দ্বারা"],["لَّهُدِّمَتْ","lahuddimat","surely (would) have been demolished","অবশ্যই বিধ্বস্ত করা হতো"],["صَوَٰمِعُ","ṣawāmi‘u","monasteries","সংসার বিরাগীদের উপাসনালয়গুলো"],["وَبِيَعٌۭ","wabiya‘un","and churches","ও গীর্জা"],["وَصَلَوَٰتٌۭ","waṣalawātun","and synagogues","ও ইহুদীদের উপাসনালয়গুলো"],["وَمَسَـٰجِدُ","wamasājidu","and masajid ","এবং মাসজিদসমূহ"],["يُذْكَرُ","yudh'karu","is mentioned","স্মরণ করা হয়"],["فِيهَا","fīhā","in it","তার মধ্যে"],["ٱسْمُ","us'mu","(the) name of Allah","নাম"],["ٱللَّهِ","l-lahi","(the) name of Allah","আল্লাহর"],["كَثِيرًۭا ۗ","kathīran","much","অধিক (পরিমাণে)"],["وَلَيَنصُرَنَّ","walayanṣuranna","And surely Allah will help","আর অবশ্যই সাহায্য করবেন"],["ٱللَّهُ","l-lahu","And surely Allah will help","আল্লাহ"],["مَن","man","(those) who","যে"],["يَنصُرُهُۥٓ ۗ","yanṣuruhu","help Him","তাঁকে সাহায্য করে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَقَوِىٌّ","laqawiyyun","(is) surely All-Strong","অবশ্যই শক্তিমান"],["عَزِيزٌ","‘azīzun","All-Mighty","পরাক্রমশালী"]],"t":"ٱلَّذِينَ أُخْرِجُو<s>ا۟</> مِ<k>ن دِ</><m>يَٰ</>رِ<f>هِم بِ</>غَيْرِ حَقٍّ إِ<o>لَّآ</> <d>أَن يَ</>قُولُو<s>ا۟</> رَبُّنَا <h>ٱ</>للَّهُ ۗ وَلَوْلَا دَفْعُ <h>ٱ</>للَّهِ <h>ٱ</><l>ل</><g>نَّ</>اسَ بَعْضَ<f>هُم بِ</>بَعْ<w>ضٍۢ لَّ</>هُدِّمَتْ صَ<m>وَٰ</>مِعُ وَبِيَ<d>عٌۭ وَ</>صَلَ<m>وَٰ</><d>تٌۭ وَ</>مَ<m>سَٰ</>جِدُ يُذْكَرُ فِيهَا <h>ٱ</>سْمُ <h>ٱ</>للَّهِ كَثِي<d>رًۭا ۗ وَ</>لَيَ<k>نصُ</>رَ<g>نَّ</> <h>ٱ</>للَّهُ <d>مَن يَ</><k>نصُ</>رُهُ<o>ۥٓ ۗ</> إِ<g>نَّ</> <h>ٱ</>للَّهَ لَقَوِىٌّ عَ<p>زِي</>زٌ"},{"n":41,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা (সেই লোক)"],["إِن","in","if","যদি"],["مَّكَّنَّـٰهُمْ","makkannāhum","We establish them","তাদেরকে আমরা ক্ষমতা দিই"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the land","পৃথিবীর"],["أَقَامُوا۟","aqāmū","they establish","তারা প্রতিষ্ঠা করে"],["ٱلصَّلَوٰةَ","l-ṣalata","the prayer","সালাত"],["وَءَاتَوُا۟","waātawū","and they give","ও তারা দেয়"],["ٱلزَّكَوٰةَ","l-zakata","zakah","জাকাত"],["وَأَمَرُوا۟","wa-amarū","and they enjoin","আর তারা নির্দেশ দেয়"],["بِٱلْمَعْرُوفِ","bil-ma‘rūfi","the right","ব্যাপারে সৎকাজের"],["وَنَهَوْا۟","wanahaw","and forbid","ও তারা নিষেধ করে"],["عَنِ","‘ani","from","হ'তে"],["ٱلْمُنكَرِ ۗ","l-munkari","the wrong","অসৎ কাজ"],["وَلِلَّهِ","walillahi","And for Allah","আর আল্লাহরই হাতে"],["عَـٰقِبَةُ","‘āqibatu","(is the) end","পরিণতি (চূড়ান্ত)"],["ٱلْأُمُورِ","l-umūri","(of) the matters","সব ব্যাপারের"]],"t":"ٱلَّذِينَ <d>إِن مَّ</>كَّ<g>نَّٰ</>هُمْ فِى <h>ٱ</>لْأَرْضِ أَقَامُو<s>ا۟</> <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةَ وَءَاتَوُ<s>ا۟</> <h>ٱ</><l>ل</>زَّكَ<s>وٰ</>ةَ وَأَمَرُو<s>ا۟</> بِ<h>ٱ</>لْمَعْرُوفِ وَنَهَوْ<s>ا۟</> عَنِ <h>ٱ</>لْمُ<k>نكَ</>رِ ۗ وَلِلَّهِ <m>عَٰ</>قِبَةُ <h>ٱ</>لْأُ<p>مُو</>رِ"},{"n":42,"w":[["وَإِن","wa-in","And if","আর (হে নাবী) যদি"],["يُكَذِّبُوكَ","yukadhibūka","they deny you","তোমাকে মিথ্যারোপ করে"],["فَقَدْ","faqad","so verily","(তবে আশ্চর্য কি) নিশ্চয়ই"],["كَذَّبَتْ","kadhabat","denied","মিথ্যারোপ করেছিলো"],["قَبْلَهُمْ","qablahum","before them","তাদের পূর্বেও"],["قَوْمُ","qawmu","(the) people","জাতি"],["نُوحٍۢ","nūḥin","(of) Nuh","নূহের"],["وَعَادٌۭ","wa‘ādun","and Aad","ও আদ"],["وَثَمُودُ","wathamūdu","and Thamud","ও সামূদ"]],"t":"وَ<d>إِن يُ</>كَذِّبُوكَ فَقَ<q>دْ</> كَذَّبَتْ قَ<q>بْ</>لَهُمْ قَوْمُ نُو<d>حٍۢ وَ</>عَا<d>دٌۭ وَ</>ثَ<p>مُو</><q>دُ</>"},{"n":43,"w":[["وَقَوْمُ","waqawmu","And (the) people","এবং জাতি"],["إِبْرَٰهِيمَ","ib'rāhīma","(of) Ibrahim","ইব্রাহীমের"],["وَقَوْمُ","waqawmu","and (the) people","ও জাতি"],["لُوطٍۢ","lūṭin","(of) Lut","লূতের"]],"t":"وَقَوْمُ إِ<q>بْ</><m>رَٰ</>هِيمَ وَقَوْمُ <p>لُو</><q>طٍۢ</>"},{"n":44,"w":[["وَأَصْحَـٰبُ","wa-aṣḥābu","And the inhabitants","এবং অধিবাসীরা"],["مَدْيَنَ ۖ","madyana","(of) Madyan","মাদইয়ানের"],["وَكُذِّبَ","wakudhiba","And Musa was denied","এবং মিথ্যারোপ করা হয়েছিলো"],["مُوسَىٰ","mūsā","And Musa was denied","মূসাকেও"],["فَأَمْلَيْتُ","fa-amlaytu","so I granted respite","অতঃএব আমি অবকাশ দিয়েছিলাম"],["لِلْكَـٰفِرِينَ","lil'kāfirīna","to the disbelievers","জন্যে কাফিরদের"],["ثُمَّ","thumma","then","এরপর"],["أَخَذْتُهُمْ ۖ","akhadhtuhum","I seized them","তাদেরকে আমি পাকড়াও করেছিলাম"],["فَكَيْفَ","fakayfa","and how","(ভেবে দেখো) তখন কেমন"],["كَانَ","kāna","was","ছিলো"],["نَكِيرِ","nakīri","My punishment","আমার শাস্তি"]],"t":"وَأَصْ<m>حَٰ</>بُ مَ<q>دْ</>يَنَ ۖ وَكُذِّبَ مُوسَىٰ فَأَمْلَيْتُ لِلْ<m>كَٰ</>فِرِينَ ثُ<g>مَّ</> أَخَذْتُهُمْ ۖ فَكَيْفَ كَانَ نَ<p>كِي</>رِ"},{"n":45,"w":[["فَكَأَيِّن","faka-ayyin","And how many","অতঃপর কতই না"],["مِّن","min","of","থেকে"],["قَرْيَةٍ","qaryatin","a township","জনপদ"],["أَهْلَكْنَـٰهَا","ahlaknāhā","We have destroyed it","তা আমরা ধ্বংস করেছি"],["وَهِىَ","wahiya","while it","যখন তা (ছিলো)"],["ظَالِمَةٌۭ","ẓālimatun","was doing wrong","অপরাধী"],["فَهِىَ","fahiya","so it","ফলে তা"],["خَاوِيَةٌ","khāwiyatun","fell","ধ্বংসপ্রাপ্ত"],["عَلَىٰ","‘alā","on","উপর"],["عُرُوشِهَا","‘urūshihā","its roofs","তার ছাদসমূহের"],["وَبِئْرٍۢ","wabi'rin","and well","এবং কূপ"],["مُّعَطَّلَةٍۢ","mu‘aṭṭalatin","abandoned","পরিত্যক্ত (হয়েছে)"],["وَقَصْرٍۢ","waqaṣrin","and castle","ও প্রাসাদ"],["مَّشِيدٍ","mashīdin","lofty","সুদৃঢ় (বিধ্বস্ত হয়েছে)"]],"t":"فَكَأَ<d>يِّن مِّ</><k>ن قَ</>رْيَةٍ أَهْلَكْ<m>نَٰ</>هَا وَهِىَ ظَالِمَ<k>ةٌۭ فَ</>هِىَ خَاوِيَةٌ عَلَىٰ عُرُوشِهَا وَبِئْ<d>رٍۢ مُّ</>عَطَّلَ<d>ةٍۢ وَ</>قَصْ<d>رٍۢ مَّ</><p>شِي</><q>دٍ</>"},{"n":46,"w":[["أَفَلَمْ","afalam","So have not","কি তবে নি"],["يَسِيرُوا۟","yasīrū","they traveled","তারা ভ্রমণ করে"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the land","জমীনে"],["فَتَكُونَ","fatakūna","and is","তাহ'লে হতো"],["لَهُمْ","lahum","for them","জন্যে তাদের"],["قُلُوبٌۭ","qulūbun","hearts","অন্তরসমূহ (এমন যে)"],["يَعْقِلُونَ","ya‘qilūna","(to) reason","বুঝতো"],["بِهَآ","bihā","with it","দিয়ে তা"],["أَوْ","aw","or","অথবা"],["ءَاذَانٌۭ","ādhānun","ears","কানগুলো"],["يَسْمَعُونَ","yasma‘ūna","(to) hear","শুনতো"],["بِهَا ۖ","bihā","with it","দিয়ে তা"],["فَإِنَّهَا","fa-innahā","For indeed, [it]","বস্তুতঃ তা অবশ্যই (এমন যে)"],["لَا","lā","not","না"],["تَعْمَى","ta‘mā","(are) blinded","অন্ধ হয়"],["ٱلْأَبْصَـٰرُ","l-abṣāru","the eyes","চোখগুলো"],["وَلَـٰكِن","walākin","but","কিন্তু"],["تَعْمَى","ta‘mā","(are) blinded","অন্ধ হয়"],["ٱلْقُلُوبُ","l-qulūbu","the hearts","অন্তরগুলো"],["ٱلَّتِى","allatī","which","যা"],["فِى","fī","(are) in","মধ্যে (আছে)"],["ٱلصُّدُورِ","l-ṣudūri","the breasts","বুকসমূহের"]],"t":"أَفَلَمْ يَسِيرُو<s>ا۟</> فِى <h>ٱ</>لْأَرْضِ فَتَكُونَ لَهُمْ قُلُو<d>بٌۭ يَ</>عْقِلُونَ بِ<o>هَآ</> أَوْ ءَاذَا<d>نٌۭ يَ</>سْمَعُونَ بِهَا ۖ فَإِ<g>نَّ</>هَا لَا تَعْمَى <h>ٱ</>لْأَ<q>بْ</><m>صَٰ</>رُ وَ<m>لَٰ</>كِ<k>ن تَ</>عْمَى <h>ٱ</>لْقُلُوبُ <h>ٱ</>لَّتِى فِى <h>ٱ</><l>ل</>صُّ<p>دُو</>رِ"},{"n":47,"w":[["وَيَسْتَعْجِلُونَكَ","wayasta‘jilūnaka","And they ask you to hasten","আর তোমাকে তাড়াতাড়ি করতে বলে"],["بِٱلْعَذَابِ","bil-‘adhābi","the punishment","ব্যাপারে শাস্তির"],["وَلَن","walan","But never will","অথচ কখনও না"],["يُخْلِفَ","yukh'lifa","fail/violate","ভঙ্গ করবেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["وَعْدَهُۥ ۚ","wa‘dahu","(in) His Promise","তাঁর প্রতিজ্ঞা"],["وَإِنَّ","wa-inna","And indeed","আর নিশ্চয়ই"],["يَوْمًا","yawman","a day","সেদিন (হবে)"],["عِندَ","‘inda","with","নিকট"],["رَبِّكَ","rabbika","your Lord","তোমার রবের"],["كَأَلْفِ","ka-alfi","(is) like a thousand","মতো এক হাজার"],["سَنَةٍۢ","sanatin","year(s)","বছর"],["مِّمَّا","mimmā","of what","তা হ'তে যা"],["تَعُدُّونَ","ta‘uddūna","you count","তোমরা গণনা করো"]],"t":"وَيَسْتَعْجِلُونَكَ بِ<h>ٱ</>لْعَذَابِ وَ<d>لَن يُ</>خْلِفَ <h>ٱ</>للَّهُ وَعْدَهُ<m>ۥ</> ۚ وَإِ<g>نَّ</> يَوْمًا عِ<k>ندَ</> رَبِّكَ كَأَلْفِ سَنَ<d>ةٍۢ مِّ</><g>مَّ</>ا تَعُ<p>دُّو</>نَ"},{"n":48,"w":[["وَكَأَيِّن","waka-ayyin","And how many","আর কত"],["مِّن","min","of","থেকে"],["قَرْيَةٍ","qaryatin","a township","জনবসতির (এমন ছিলো)"],["أَمْلَيْتُ","amlaytu","I gave respite","আমি অবকাশ দিয়েছি"],["لَهَا","lahā","to it","জন্যে তাদের"],["وَهِىَ","wahiya","while it","যখন তা"],["ظَالِمَةٌۭ","ẓālimatun","(was) doing wrong","সীমালঙ্ঘনকারী (ছিলো)"],["ثُمَّ","thumma","Then","এরপর"],["أَخَذْتُهَا","akhadhtuhā","I seized it","তাদেরকে আমি পাকড়াও করেছি"],["وَإِلَىَّ","wa-ilayya","and to Me","আর নিকট আমারই"],["ٱلْمَصِيرُ","l-maṣīru","(is) the destination","প্রত্যাবর্তন (সকলেরই)"]],"t":"وَكَأَ<d>يِّن مِّ</><k>ن قَ</>رْيَةٍ أَمْلَيْتُ لَهَا وَهِىَ ظَالِمَ<k>ةٌۭ ثُ</><g>مَّ</> أَخَذْتُهَا وَإِلَىَّ <h>ٱ</>لْمَ<p>صِي</>رُ"},{"n":49,"w":[["قُلْ","qul","Say","(হে নাবী) বলো"],["يَـٰٓأَيُّهَا","yāayyuhā","O mankind","\"হে"],["ٱلنَّاسُ","l-nāsu","O mankind","\"মানবজাতি"],["إِنَّمَآ","innamā","Only","মূলতঃ"],["أَنَا۠","anā","I am","আমি"],["لَكُمْ","lakum","to you","জন্যে তোমাদের"],["نَذِيرٌۭ","nadhīrun","a warner","একজন সতর্ককারী"],["مُّبِينٌۭ","mubīnun","clear","সুস্পষ্ট\""]],"t":"قُلْ <o>يَٰٓ</>أَيُّهَا <h>ٱ</><l>ل</><g>نَّ</>اسُ إِ<g>نَّ</><o>مَآ</> أَنَا۠ لَكُمْ نَذِي<d>رٌۭ مُّ</><p>بِي</>نٌۭ"},{"n":50,"w":[["فَٱلَّذِينَ","fa-alladhīna","So those who","অতঃপর যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান আনে"],["وَعَمِلُوا۟","wa‘amilū","and do","ও কাজ করে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","righteous deeds ","সৎকাজসমূহের"],["لَهُم","lahum","for them","জন্যে তাদের (রয়েছে)"],["مَّغْفِرَةٌۭ","maghfiratun","(is) forgiveness","ক্ষমা"],["وَرِزْقٌۭ","wariz'qun","and a provision","ও জীবিকা"],["كَرِيمٌۭ","karīmun","noble","সম্মানজনক"]],"t":"فَ<h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ لَ<y>هُم مَّ</>غْفِرَ<d>ةٌۭ وَ</>رِزْ<k>قٌۭ كَ</><p>رِي</>مٌۭ"},{"n":51,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","আর যারা"],["سَعَوْا۟","sa‘aw","strove","চেষ্টা করে"],["فِىٓ","fī","against","মধ্যে"],["ءَايَـٰتِنَا","āyātinā","Our Verses","আমাদের আয়াত সমূহের"],["مُعَـٰجِزِينَ","mu‘ājizīna","(to) cause failure","ব্যর্থ করে দেখাতে"],["أُو۟لَـٰٓئِكَ","ulāika","those","ঐসবলোক"],["أَصْحَـٰبُ","aṣḥābu","(are the) companions","অধিবাসী"],["ٱلْجَحِيمِ","l-jaḥīmi","(of) the Hellfire","জাহান্নামের"]],"t":"وَ<h>ٱ</>لَّذِينَ سَعَوْ<s>ا۟</> <o>فِىٓ</> ءَا<m>يَٰ</>تِنَا مُ<m>عَٰ</>جِزِينَ أُ<s>و۟</><o>لَٰٓ</>ئِكَ أَصْ<m>حَٰ</>بُ <h>ٱ</>لْجَ<p>حِي</>مِ"},{"n":52,"w":[["وَمَآ","wamā","And not","এবং না"],["أَرْسَلْنَا","arsalnā","We sent","আমরা পাঠিয়েছি"],["مِن","min","before you","থেকে"],["قَبْلِكَ","qablika","before you","তোমার পূর্ব"],["مِن","min","any","কোন"],["رَّسُولٍۢ","rasūlin","Messenger","রাসূলকে"],["وَلَا","walā","and not","আর না"],["نَبِىٍّ","nabiyyin","a Prophet","কোন নাবীকে"],["إِلَّآ","illā","but","এ ছাড়া যে"],["إِذَا","idhā","when","যখন"],["تَمَنَّىٰٓ","tamannā","he recited","আকাঙ্ক্ষা করেছে (তিলাওয়াত করেছে)"],["أَلْقَى","alqā","threw","ছুঁড়ে দিয়েছে"],["ٱلشَّيْطَـٰنُ","l-shayṭānu","the Shaitaan","শয়তান (প্রতিবন্ধকতা)"],["فِىٓ","fī","in","মধ্যে"],["أُمْنِيَّتِهِۦ","um'niyyatihi","his recitation","তার আকাঙ্ক্ষার (তিলাওয়াতে)"],["فَيَنسَخُ","fayansakhu","But Allah abolishes","তখন দূর করেছেন"],["ٱللَّهُ","l-lahu","But Allah abolishes","আল্লাহ"],["مَا","mā","what","যা"],["يُلْقِى","yul'qī","throws","ছুঁড়ে  দেয়"],["ٱلشَّيْطَـٰنُ","l-shayṭānu","the Shaitaan","শয়তান"],["ثُمَّ","thumma","then","এরপর"],["يُحْكِمُ","yuḥ'kimu","Allah will establish","সুদৃঢ় করেন"],["ٱللَّهُ","l-lahu","Allah will establish","আল্লাহ"],["ءَايَـٰتِهِۦ ۗ","āyātihi","His Verses","তাঁর আয়াতকে"],["وَٱللَّهُ","wal-lahu","And Allah","আর আল্লাহ"],["عَلِيمٌ","‘alīmun","(is) All-Knower","জ্ঞানময়"],["حَكِيمٌۭ","ḥakīmun","All-Wise","প্রজ্ঞাময়"]],"t":"وَ<o>مَآ</> أَرْسَلْنَا مِ<k>ن قَ</><q>بْ</>لِكَ <w>مِن رَّ</>سُو<d>لٍۢ وَ</>لَا نَبِىٍّ إِ<o>لَّآ</> إِذَا تَمَ<g>نَّ</><o>ىٰٓ</> أَلْقَى <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نُ <o>فِىٓ</> أُمْنِيَّتِ<m>هِۦ</> فَيَ<k>نسَ</>خُ <h>ٱ</>للَّهُ مَا يُلْقِى <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نُ ثُ<g>مَّ</> يُحْكِمُ <h>ٱ</>للَّهُ ءَا<m>يَٰتِهِۦ</> ۗ وَ<h>ٱ</>للَّهُ عَلِيمٌ حَ<p>كِي</>مٌۭ"},{"n":53,"w":[["لِّيَجْعَلَ","liyaj‘ala","That He may make","(এরূপ এজন্যে হয়) যেন তিনি বানিয়ে দেন"],["مَا","mā","what","যা"],["يُلْقِى","yul'qī","the Shaitaan throws","ছুঁড়ে দেয়"],["ٱلشَّيْطَـٰنُ","l-shayṭānu","the Shaitaan throws","শয়তান"],["فِتْنَةًۭ","fit'natan","a trial","পরীক্ষাস্বরূপ"],["لِّلَّذِينَ","lilladhīna","for those","জন্যে তাদের"],["فِى","fī","in","মধ্যে (আছে)"],["قُلُوبِهِم","qulūbihim","their hearts","যাদের অন্তরসমূহে"],["مَّرَضٌۭ","maraḍun","(is) a disease","রোগ"],["وَٱلْقَاسِيَةِ","wal-qāsiyati","and (are) hardened","এবং পাষাণ (হয়েছে)"],["قُلُوبُهُمْ ۗ","qulūbuhum","their hearts","তাদের অন্তরগুলো"],["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","সীমালঙ্ঘনকারীরা"],["لَفِى","lafī","(are) surely, in","অবশ্যই মধ্যে"],["شِقَاقٍۭ","shiqāqin","schism","(সত্যের) বিরোধিতার"],["بَعِيدٍۢ","ba‘īdin","far","বহুদূরে (অগ্রসর হয়ে গিয়েছে)"]],"t":"لِّيَ<q>جْ</>عَلَ مَا يُلْقِى <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نُ فِتْنَ<w>ةًۭ لِّ</>لَّذِينَ فِى قُلُوبِ<y>هِم مَّ</>رَ<d>ضٌۭ وَ</><h>ٱ</>لْقَاسِيَةِ قُلُوبُهُمْ ۗ وَإِ<g>نَّ</> <h>ٱ</><l>ل</><m>ظَّٰ</>لِمِينَ لَفِى شِقَا<i>قٍۭ بَ</><p>عِي</><q>دٍۢ</>"},{"n":54,"w":[["وَلِيَعْلَمَ","waliya‘lama","And that may know","আর যেন জানে"],["ٱلَّذِينَ","alladhīna","those who","যাদেরকে"],["أُوتُوا۟","ūtū","have been given","দেয়া হয়েছে"],["ٱلْعِلْمَ","l-‘il'ma","the knowledge","জ্ঞান"],["أَنَّهُ","annahu","that it","যে তা"],["ٱلْحَقُّ","l-ḥaqu","(is) the truth","সত্য"],["مِن","min","from","নিকট হ'তে"],["رَّبِّكَ","rabbika","your Lord","তোমার রবের"],["فَيُؤْمِنُوا۟","fayu'minū","and they believe","তারা অতঃপর ঈমান আনে"],["بِهِۦ","bihi","in it","উপর তাঁর"],["فَتُخْبِتَ","fatukh'bita","and may humbly submit","অতঃপর অবনমিত হয়"],["لَهُۥ","lahu","to it","প্রতি তাঁর"],["قُلُوبُهُمْ ۗ","qulūbuhum","their hearts","তাদের অন্তরসমূহ"],["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَهَادِ","lahādi","(is) surely (the) Guide","অবশ্যই পথপ্রদর্শনকারী"],["ٱلَّذِينَ","alladhīna","(of) those who","(তাদেরকে) যারা"],["ءَامَنُوٓا۟","āmanū","believe","ঈমান এনেছে"],["إِلَىٰ","ilā","to","দিকে"],["صِرَٰطٍۢ","ṣirāṭin","a Path","পথের"],["مُّسْتَقِيمٍۢ","mus'taqīmin","Straight","সরল"]],"t":"وَلِيَعْلَمَ <h>ٱ</>لَّذِينَ أُوتُو<s>ا۟</> <h>ٱ</>لْعِلْمَ أَ<g>نَّ</>هُ <h>ٱ</>لْحَقُّ <w>مِن رَّ</>بِّكَ فَيُؤْمِنُو<s>ا۟</> بِ<m>هِۦ</> فَتُخْبِتَ لَهُ<m>ۥ</> قُلُوبُهُمْ ۗ وَإِ<g>نَّ</> <h>ٱ</>للَّهَ لَهَادِ <h>ٱ</>لَّذِينَ ءَامَ<o>نُوٓ</><s>ا۟</> إِلَىٰ صِ<m>رَٰ</><d>طٍۢ مُّ</>سْتَ<p>قِي</>مٍۢ"},{"n":55,"w":[["وَلَا","walā","And not","এবং না"],["يَزَالُ","yazālu","will cease","বিরত হবে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieve","অমান্য করেছে"],["فِى","fī","(to be) in","মধ্যে"],["مِرْيَةٍۢ","mir'yatin","doubt","সন্দেহের"],["مِّنْهُ","min'hu","of it","তা হ'তে"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["تَأْتِيَهُمُ","tatiyahumu","comes to them","তাদের (নিকট) এসে পড়বে"],["ٱلسَّاعَةُ","l-sā‘atu","the Hour","ক্বিয়ামাত"],["بَغْتَةً","baghtatan","suddenly","হঠাৎ করে"],["أَوْ","aw","or","অথবা"],["يَأْتِيَهُمْ","yatiyahum","comes to them","তাদের (নিকট) আসবে"],["عَذَابُ","‘adhābu","(the) punishment","শাস্তি"],["يَوْمٍ","yawmin","(of) a Day","দিনের"],["عَقِيمٍ","‘aqīmin","barren","বন্ধ্যা (খারাপ)"]],"t":"وَلَا يَزَالُ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> فِى مِرْيَ<d>ةٍۢ مِّ</>نْهُ حَتَّىٰ تَأْتِيَهُمُ <h>ٱ</><l>ل</>سَّاعَةُ بَغْتَةً أَوْ يَأْتِيَهُمْ عَذَابُ يَوْمٍ عَ<p>قِي</>مٍ"},{"n":56,"w":[["ٱلْمُلْكُ","al-mul'ku","The Sovereignty","চূড়ান্ত কর্তৃত্ব"],["يَوْمَئِذٍۢ","yawma-idhin","(on) that Day","সেদিন হবে"],["لِّلَّهِ","lillahi","(will be) for Allah","জন্যে আল্লাহরই"],["يَحْكُمُ","yaḥkumu","He will judge","তিনি বিচার করবেন"],["بَيْنَهُمْ ۚ","baynahum","between them","তাদের মাঝে"],["فَٱلَّذِينَ","fa-alladhīna","So those who","সুতরাং যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["وَعَمِلُوا۟","wa‘amilū","and did","ও কাজ করেছে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","righteous deeds","সৎকাজসমূহের"],["فِى","fī","(will be) in","(তারা থাকবে) মধ্যে"],["جَنَّـٰتِ","jannāti","Gardens","জান্নাতসমূহের"],["ٱلنَّعِيمِ","l-na‘īmi","(of) Delight","সুখকর"]],"t":"ٱلْمُلْكُ يَوْمَئِ<w>ذٍۢ لِّ</>لَّهِ يَحْكُمُ بَيْنَهُمْ ۚ فَ<h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ فِى جَ<g>نَّٰ</>تِ <h>ٱ</><l>ل</><g>نَّ</><p>عِي</>مِ"},{"n":57,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","আর যারা"],["كَفَرُوا۟","kafarū","disbelieved","অস্বীকার করেছে"],["وَكَذَّبُوا۟","wakadhabū","and denied","ও অমান্য করেছে"],["بِـَٔايَـٰتِنَا","biāyātinā","Our Verses","প্রতি আমাদের নিদর্শনাবলীর"],["فَأُو۟لَـٰٓئِكَ","fa-ulāika","then those","তবে ঐসবলোক"],["لَهُمْ","lahum","for them","জন্যে তাদের  (রয়েছে)"],["عَذَابٌۭ","‘adhābun","(will be) a punishment","শাস্তি"],["مُّهِينٌۭ","muhīnun","humiliating","লাঞ্ছনাদায়ক"]],"t":"وَ<h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> وَكَذَّبُو<s>ا۟</> بِـَٔا<m>يَٰ</>تِنَا فَأُ<s>و۟</><o>لَٰٓ</>ئِكَ لَهُمْ عَذَا<d>بٌۭ مُّ</><p>هِي</>نٌۭ"},{"n":58,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","আর যারা"],["هَاجَرُوا۟","hājarū","emigrated","হিজরত করেছে"],["فِى","fī","in","মধ্যে"],["سَبِيلِ","sabīli","(the) way","পথের"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["ثُمَّ","thumma","then","এরপর"],["قُتِلُوٓا۟","qutilū","were killed","নিহত হয়েছে"],["أَوْ","aw","or","অথবা"],["مَاتُوا۟","mātū","died","মারা গিয়েছে"],["لَيَرْزُقَنَّهُمُ","layarzuqannahumu","surely, Allah will provide them","অবশ্যই তাদেরকে জীবিকা দিবেন"],["ٱللَّهُ","l-lahu","surely, Allah will provide them","আল্লাহ"],["رِزْقًا","riz'qan","a provision","জীবিকা"],["حَسَنًۭا ۚ","ḥasanan","good","উৎকৃষ্ট"],["وَإِنَّ","wa-inna","And indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَهُوَ","lahuwa","surely, He","অবশ্যই তিনি"],["خَيْرُ","khayru","(is the) Best","উত্তম"],["ٱلرَّٰزِقِينَ","l-rāziqīna","(of) the Providers","জীবিকাদাতাদের"]],"t":"وَ<h>ٱ</>لَّذِينَ هَاجَرُو<s>ا۟</> فِى سَبِيلِ <h>ٱ</>للَّهِ ثُ<g>مَّ</> قُتِ<o>لُوٓ</><s>ا۟</> أَوْ مَاتُو<s>ا۟</> لَيَرْزُقَ<g>نَّ</>هُمُ <h>ٱ</>للَّهُ رِزْقًا حَسَ<d>نًۭا ۚ وَ</>إِ<g>نَّ</> <h>ٱ</>للَّهَ لَهُوَ خَيْرُ <h>ٱ</><l>ل</><m>رَّٰ</>زِ<p>قِي</>نَ"},{"n":59,"w":[["لَيُدْخِلَنَّهُم","layud'khilannahum","Surely, He will admit them","অবশ্যই তাদেরকে তিনি প্রবেশ করাবেন"],["مُّدْخَلًۭا","mud'khalan","(to) an entrance","(এমন) প্রবেশস্থানে"],["يَرْضَوْنَهُۥ ۗ","yarḍawnahu","they will be pleased (with) it","তাতে তারা সন্তুষ্ট হবে"],["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَعَلِيمٌ","la‘alīmun","surely, (is) All-Knowing","অবশ্যই সর্বজ্ঞ"],["حَلِيمٌۭ","ḥalīmun","Most Forbearing","পরম সহনশীল"]],"t":"لَيُ<q>دْ</>خِلَ<g>نَّ</><y>هُم مُّ</><q>دْ</>خَلًۭ<d>ا يَ</>رْضَوْنَهُ<m>ۥ</> ۗ وَإِ<g>نَّ</> <h>ٱ</>للَّهَ لَعَلِيمٌ حَ<p>لِي</>مٌۭ"},{"n":60,"w":[["۞ ذَٰلِكَ","dhālika","That","এটা (এদের পরিনতি)"],["وَمَنْ","waman","and whoever","আর যে"],["عَاقَبَ","‘āqaba","has retaliated","প্রতিশোধ নিবে"],["بِمِثْلِ","bimith'li","with the like","(তার) সমতুল্য"],["مَا","mā","(of) that","যেমন"],["عُوقِبَ","‘ūqiba","he was made to suffer","নিপীড়ন করা হয়েছে"],["بِهِۦ","bihi","by it","প্রতি তার"],["ثُمَّ","thumma","then","আবার"],["بُغِىَ","bughiya","he was oppressed","বাড়াবাড়ি করা হয়েছে"],["عَلَيْهِ","‘alayhi","[on him]","তার উপর"],["لَيَنصُرَنَّهُ","layanṣurannahu","Allah will surely help him","অবশ্যই তাকে সাহায্য করবেন"],["ٱللَّهُ ۗ","l-lahu","Allah will surely help him","আল্লাহ"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَعَفُوٌّ","la‘afuwwun","(is) surely Oft-Pardoning","অবশ্যই পাপমোচনকারী"],["غَفُورٌۭ","ghafūrun","Oft-Forgiving","ক্ষমাশীল"]],"t":"۞ <m>ذَٰ</>لِكَ وَمَنْ عَاقَبَ بِمِثْلِ مَا عُوقِبَ بِ<m>هِۦ</> ثُ<g>مَّ</> بُغِىَ عَلَيْهِ لَيَ<k>نصُ</>رَ<g>نَّ</>هُ <h>ٱ</>للَّهُ ۗ إِ<g>نَّ</> <h>ٱ</>للَّهَ لَعَفُوٌّ غَ<p>فُو</>رٌۭ"},{"n":61,"w":[["ذَٰلِكَ","dhālika","That","এটা"],["بِأَنَّ","bi-anna","(is) because","এজন্যে যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يُولِجُ","yūliju","causes to enter","প্রবেশ করান"],["ٱلَّيْلَ","al-layla","the night","রাতকে"],["فِى","fī","in (to)","মধ্যে"],["ٱلنَّهَارِ","l-nahāri","the day","দিনের"],["وَيُولِجُ","wayūliju","and causes to enter","ও তিনি প্রবেশ করান"],["ٱلنَّهَارَ","l-nahāra","the day","দিনকে"],["فِى","fī","in (to)","মধ্যে"],["ٱلَّيْلِ","al-layli","the night","রাতের"],["وَأَنَّ","wa-anna","And indeed","আর নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["سَمِيعٌۢ","samī‘un","(is) All-Hearer","সব শুনেন"],["بَصِيرٌۭ","baṣīrun","All-Seer","সব দেখেন"]],"t":"<m>ذَٰ</>لِكَ بِأَ<g>نَّ</> <h>ٱ</>للَّهَ يُولِجُ <h>ٱ</>لَّيْلَ فِى <h>ٱ</><l>ل</><g>نَّ</>هَارِ وَيُولِجُ <h>ٱ</><l>ل</><g>نَّ</>هَارَ فِى <h>ٱ</>لَّيْلِ وَأَ<g>نَّ</> <h>ٱ</>للَّهَ سَمِي<i>عٌۢ بَ</><p>صِي</>رٌۭ"},{"n":62,"w":[["ذَٰلِكَ","dhālika","That (is)","এটা"],["بِأَنَّ","bi-anna","because","এজন্য যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["هُوَ","huwa","He","তিনিই"],["ٱلْحَقُّ","l-ḥaqu","(is) the Truth","সত্য"],["وَأَنَّ","wa-anna","and that","আর (এও সত্য) যে"],["مَا","mā","what","যাকে"],["يَدْعُونَ","yad‘ūna","they invoke","তারা ডাকে"],["مِن","min","besides Him","মধ্য হতে"],["دُونِهِۦ","dūnihi","besides Him","তাঁকে ছাড়া"],["هُوَ","huwa","it","তা"],["ٱلْبَـٰطِلُ","l-bāṭilu","(is) the falsehood","অসত্য"],["وَأَنَّ","wa-anna","And that","আর (এও সত্য) যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["هُوَ","huwa","He","তিনিই"],["ٱلْعَلِىُّ","l-‘aliyu","(is) the Most High","সমুচ্চ"],["ٱلْكَبِيرُ","l-kabīru","the Most Great","সুমহান"]],"t":"<m>ذَٰ</>لِكَ بِأَ<g>نَّ</> <h>ٱ</>للَّهَ هُوَ <h>ٱ</>لْحَقُّ وَأَ<g>نَّ</> مَا يَ<q>دْ</>عُونَ مِ<k>ن دُ</>ونِ<m>هِۦ</> هُوَ <h>ٱ</>لْ<m>بَٰ</>طِلُ وَأَ<g>نَّ</> <h>ٱ</>للَّهَ هُوَ <h>ٱ</>لْعَلِىُّ <h>ٱ</>لْكَ<p>بِي</>رُ"},{"n":63,"w":[["أَلَمْ","alam","Do not","নি কি"],["تَرَ","tara","you see","তুমি দেখো"],["أَنَّ","anna","that","যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["أَنزَلَ","anzala","sends down","বর্ষণ করেন"],["مِنَ","mina","from","হ'তে"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশ"],["مَآءًۭ","māan","water","পানি"],["فَتُصْبِحُ","fatuṣ'biḥu","then becomes","ফলে হয়ে উঠে"],["ٱلْأَرْضُ","l-arḍu","the earth","জমিন"],["مُخْضَرَّةً ۗ","mukh'ḍarratan","green","সবুজ শ্যামল"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَطِيفٌ","laṭīfun","(is) surely Subtle","সূক্ষ্ণদর্শী"],["خَبِيرٌۭ","khabīrun","All-Aware","খুব অবহিত"]],"t":"أَلَمْ تَرَ أَ<g>نَّ</> <h>ٱ</>للَّهَ أَ<k>نزَ</>لَ مِنَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ <o>مَآ</><k>ءًۭ فَ</>تُصْبِحُ <h>ٱ</>لْأَرْضُ مُخْضَرَّةً ۗ إِ<g>نَّ</> <h>ٱ</>للَّهَ لَطِيفٌ خَ<p>بِي</>رٌۭ"},{"n":64,"w":[["لَّهُۥ","lahu","For Him","জন্যে তাঁরই"],["مَا","mā","(is) whatever","যা কিছু"],["فِى","fī","(is) in","মধ্যে (আছে)"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশমন্ডলীর"],["وَمَا","wamā","and whatever","ও যা কিছু"],["فِى","fī","(is) in","মধ্যে (আছে)"],["ٱلْأَرْضِ ۗ","l-arḍi","the earth","পৃথিবীর"],["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَهُوَ","lahuwa","surely, He","অবশ্যই তিনি"],["ٱلْغَنِىُّ","l-ghaniyu","(is) Free of need","অভাবমুক্ত"],["ٱلْحَمِيدُ","l-ḥamīdu","the Praiseworthy","প্রশংসিত"]],"t":"لَّهُ<m>ۥ</> مَا فِى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَمَا فِى <h>ٱ</>لْأَرْضِ ۗ وَإِ<g>نَّ</> <h>ٱ</>للَّهَ لَهُوَ <h>ٱ</>لْغَنِىُّ <h>ٱ</>لْحَ<p>مِي</><q>دُ</>"},{"n":65,"w":[["أَلَمْ","alam","Do not","নি কি"],["تَرَ","tara","you see","তুমি দেখো"],["أَنَّ","anna","that","যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["سَخَّرَ","sakhara","(has) subjected","অধীন করে দিয়েছেন"],["لَكُم","lakum","to you","জন্যে তোমাদের"],["مَّا","mā","what","যা কিছু"],["فِى","fī","(is) in","মধ্যে (আছে)"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["وَٱلْفُلْكَ","wal-ful'ka","and the ships","এবং নৌযানসমূহ"],["تَجْرِى","tajrī","that sail","চলাচল করে"],["فِى","fī","through","মধ্যে"],["ٱلْبَحْرِ","l-baḥri","the sea","সমুদ্রের"],["بِأَمْرِهِۦ","bi-amrihi","by His Command","তাঁর নির্দেশ অনুসারে"],["وَيُمْسِكُ","wayum'siku","And He withholds","এবং তিনি ধরে রেখেছেন"],["ٱلسَّمَآءَ","l-samāa","the sky","আকাশকে"],["أَن","an","lest","যেন (না)"],["تَقَعَ","taqa‘a","it falls","পতিত হয়"],["عَلَى","‘alā","on","উপর"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["إِلَّا","illā","except","ছাড়া"],["بِإِذْنِهِۦٓ ۗ","bi-idh'nihi","by His permission","নিয়ে তাঁর অনুমতি"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["بِٱلنَّاسِ","bil-nāsi","to mankind","উপর মানুষের"],["لَرَءُوفٌۭ","laraūfun","(is) Full of Kindness","অবশ্যই দয়াপরবশ"],["رَّحِيمٌۭ","raḥīmun","Most Merciful","পরম দয়ালু"]],"t":"أَلَمْ تَرَ أَ<g>نَّ</> <h>ٱ</>للَّهَ سَخَّرَ لَ<y>كُم مَّ</>ا فِى <h>ٱ</>لْأَرْضِ وَ<h>ٱ</>لْفُلْكَ تَ<q>جْ</>رِى فِى <h>ٱ</>لْبَحْرِ بِأَمْرِ<m>هِۦ</> وَيُمْسِكُ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءَ أَ<k>ن تَ</>قَعَ عَلَى <h>ٱ</>لْأَرْضِ إِلَّا بِإِذْنِ<o>هِۦٓ ۗ</> إِ<g>نَّ</> <h>ٱ</>للَّهَ بِ<h>ٱ</><l>ل</><g>نَّ</>اسِ لَرَءُو<w>فٌۭ رَّ</><p>حِي</>مٌۭ"},{"n":66,"w":[["وَهُوَ","wahuwa","And He","এবং তিনিই"],["ٱلَّذِىٓ","alladhī","(is) the One Who","যিনি"],["أَحْيَاكُمْ","aḥyākum","gave you life","জীবন দিয়েছেন তোমাদেরকে"],["ثُمَّ","thumma","then","এরপর"],["يُمِيتُكُمْ","yumītukum","He will cause you to die","তোমাদেরকে মৃত্যু দিবেন"],["ثُمَّ","thumma","then","এরপর"],["يُحْيِيكُمْ ۗ","yuḥ'yīkum","He will give you life (again)","তোমাদের জীবিত করবেন"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلْإِنسَـٰنَ","l-insāna","man","মানুষ"],["لَكَفُورٌۭ","lakafūrun","(is) surely ungrateful","অবশ্যই অকৃতজ্ঞ বড়"]],"t":"وَهُوَ <h>ٱ</>لَّ<o>ذِىٓ</> أَحْيَاكُمْ ثُ<g>مَّ</> يُمِيتُكُمْ ثُ<g>مَّ</> يُحْيِيكُمْ ۗ إِ<g>نَّ</> <h>ٱ</>لْإِ<k>نسَٰ</>نَ لَكَ<p>فُو</>رٌۭ"},{"n":67,"w":[["لِّكُلِّ","likulli","For every","জন্যে প্রত্যেক"],["أُمَّةٍۢ","ummatin","nation","জাতির"],["جَعَلْنَا","ja‘alnā","We have made","আমরা নির্ধারণ করেছি"],["مَنسَكًا","mansakan","rite(s)","ইবাদাত পদ্ধতি"],["هُمْ","hum","they","তারা"],["نَاسِكُوهُ ۖ","nāsikūhu","perform it","সেই প্রথা অনুসরণকারী"],["فَلَا","falā","So let them not dispute with you","সুতরাং না (যেন)"],["يُنَـٰزِعُنَّكَ","yunāzi‘unnaka","So let them not dispute with you","তোমার (সাথে) ঝগড়া করে"],["فِى","fī","in","নিয়ে"],["ٱلْأَمْرِ ۚ","l-amri","the matter","এই (ব্যাপার)"],["وَٱدْعُ","wa-ud'‘u","but invite (them)","এবং তুমি ডাকো"],["إِلَىٰ","ilā","to","দিকে"],["رَبِّكَ ۖ","rabbika","your Lord","তোমার রবের"],["إِنَّكَ","innaka","Indeed, you","তুমি নিশ্চয়ই (আছো)"],["لَعَلَىٰ","la‘alā","(are) surely on","অবশ্যই উপর"],["هُدًۭى","hudan","guidance","পথের"],["مُّسْتَقِيمٍۢ","mus'taqīmin","straight","সরল সঠিক"]],"t":"لِّكُلِّ أُ<g>مَّ</><k>ةٍۢ جَ</>عَلْنَا مَ<k>نسَ</>كًا هُمْ نَاسِكُوهُ ۖ فَلَا يُ<m>نَٰ</>زِعُ<g>نَّ</>كَ فِى <h>ٱ</>لْأَمْرِ ۚ وَ<h>ٱ</><q>دْ</>عُ إِلَىٰ رَبِّكَ ۖ إِ<g>نَّ</>كَ لَعَلَىٰ هُ<d>دًۭى مُّ</>سْتَ<p>قِي</>مٍۢ"},{"n":68,"w":[["وَإِن","wa-in","And if","আর যদি"],["جَـٰدَلُوكَ","jādalūka","they argue (with) you","তোমার সাথে তারা বিতর্ক করে"],["فَقُلِ","faquli","then say","তবে বলো"],["ٱللَّهُ","l-lahu","Allah","\"আল্লাহ"],["أَعْلَمُ","a‘lamu","(is) most knowing","খুব জানেন"],["بِمَا","bimā","of what","যা সে বিষয়ে"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা কাজ করছো"]],"t":"وَإِ<k>ن جَٰ</>دَلُوكَ فَقُلِ <h>ٱ</>للَّهُ أَعْلَمُ بِمَا تَعْمَ<p>لُو</>نَ"},{"n":69,"w":[["ٱللَّهُ","al-lahu","Allah","আল্লাহ"],["يَحْكُمُ","yaḥkumu","will judge","মীমাংসা করে দিবেন"],["بَيْنَكُمْ","baynakum","between you","তোমাদের মাঝে"],["يَوْمَ","yawma","(on the) Day","দিনে"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) the Resurrection","ক্বিয়ামাতের"],["فِيمَا","fīmā","concerning what","সে বিষয়ে"],["كُنتُمْ","kuntum","you used (to)","তোমরা ছিলে"],["فِيهِ","fīhi","in it","যার মধ্যে"],["تَخْتَلِفُونَ","takhtalifūna","differ","মতভেদ করতে\""]],"t":"ٱللَّهُ يَحْكُمُ بَيْنَكُمْ يَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ فِيمَا كُ<k>نتُ</>مْ فِيهِ تَخْتَلِ<p>فُو</>نَ"},{"n":70,"w":[["أَلَمْ","alam","Do not","নি কি"],["تَعْلَمْ","ta‘lam","you know","তুমি জানো"],["أَنَّ","anna","that","যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يَعْلَمُ","ya‘lamu","knows","জানেন"],["مَا","mā","what","যা কিছু"],["فِى","fī","(is) in","মধ্যে (আছে)"],["ٱلسَّمَآءِ","l-samāi","the heaven","আকাশের"],["وَٱلْأَرْضِ ۗ","wal-arḍi","and the earth","ও পৃথিবীতে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ذَٰلِكَ","dhālika","that","এটা"],["فِى","fī","(is) in","মধ্যে (আছে)"],["كِتَـٰبٍ ۚ","kitābin","a Record","এক কিতাবে (লিপিবদ্ধ)"],["إِنَّ","inna","indeed","নিশ্চয়ই"],["ذَٰلِكَ","dhālika","that","এটা"],["عَلَى","‘alā","(is) for","নিকট"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["يَسِيرٌۭ","yasīrun","easy","সহজ"]],"t":"أَلَمْ تَعْلَمْ أَ<g>نَّ</> <h>ٱ</>للَّهَ يَعْلَمُ مَا فِى <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ وَ<h>ٱ</>لْأَرْضِ ۗ إِ<g>نَّ</> <m>ذَٰ</>لِكَ فِى كِ<m>تَٰ</>بٍ ۚ إِ<g>نَّ</> <m>ذَٰ</>لِكَ عَلَى <h>ٱ</>للَّهِ يَ<p>سِي</>رٌۭ"},{"n":71,"w":[["وَيَعْبُدُونَ","waya‘budūna","And they worship","এবং তারা উপাসনা করে"],["مِن","min","besides Allah","মধ্য হতে"],["دُونِ","dūni","besides Allah","পরিবর্তে"],["ٱللَّهِ","l-lahi","besides Allah","আল্লাহ্‌র"],["مَا","mā","what","(এমন কিছুর) যা"],["لَمْ","lam","not","নি"],["يُنَزِّلْ","yunazzil","He (has) sent down","অবতীর্ণ করেন (আল্লাহ)"],["بِهِۦ","bihi","for it","সে সম্বন্ধে"],["سُلْطَـٰنًۭا","sul'ṭānan","any authority","কোন প্রমাণ"],["وَمَا","wamā","and what","আর যার"],["لَيْسَ","laysa","not","নেই"],["لَهُم","lahum","they have","কাছে তাদের"],["بِهِۦ","bihi","of it","সম্বন্ধে সে"],["عِلْمٌۭ ۗ","‘il'mun","any knowledge","কোন জ্ঞান"],["وَمَا","wamā","And not","এবং নেই"],["لِلظَّـٰلِمِينَ","lilẓẓālimīna","(will be) for the wrongdoers","জন্যে সীমালঙ্ঘনকারীদের"],["مِن","min","any","কোন"],["نَّصِيرٍۢ","naṣīrin","helper","সাহায্যকারী"]],"t":"وَيَعْبُدُونَ مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ مَا لَمْ يُنَزِّلْ بِ<m>هِۦ</> سُلْ<m>طَٰ</><d>نًۭا وَ</>مَا لَيْسَ لَ<f>هُم بِ</><m>هِۦ</> عِلْ<d>مٌۭ ۗ وَ</>مَا لِل<m>ظَّٰ</>لِمِينَ <d>مِن نَّ</><p>صِي</>رٍۢ"},{"n":72,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["تُتْلَىٰ","tut'lā","are recited","তিলাওয়াত করা হয়"],["عَلَيْهِمْ","‘alayhim","to them","তাদের নিকট"],["ءَايَـٰتُنَا","āyātunā","Our Verses","আমাদের আয়াতগুলোকে"],["بَيِّنَـٰتٍۢ","bayyinātin","clear","সুস্পষ্ট"],["تَعْرِفُ","ta‘rifu","you will recognize","তুমি লক্ষ্য করবে"],["فِى","fī","on","মধ্যে"],["وُجُوهِ","wujūhi","(the) faces","মুখমণ্ডলসমূহে"],["ٱلَّذِينَ","alladhīna","(of) those who","(তাদের) যারা"],["كَفَرُوا۟","kafarū","disbelieve","অস্বীকার করেছে"],["ٱلْمُنكَرَ ۖ","l-munkara","the denial","অসন্তোষের লক্ষণ"],["يَكَادُونَ","yakādūna","They almost","তারা উপক্রম হয়"],["يَسْطُونَ","yasṭūna","attack","আক্রমণ করবে তারা"],["بِٱلَّذِينَ","bi-alladhīna","those who","উপর (তাদের) যারা"],["يَتْلُونَ","yatlūna","recite","তিলাওয়াত করে"],["عَلَيْهِمْ","‘alayhim","to them","নিকট তাদের"],["ءَايَـٰتِنَا ۗ","āyātinā","Our Verses","আমাদের আয়াতগুলোকে"],["قُلْ","qul","Say","বলো"],["أَفَأُنَبِّئُكُم","afa-unabbi-ukum","Then shall I inform you","\"কি তবে তোমাদের সংবাদ দিবো"],["بِشَرٍّۢ","bisharrin","of worse","নিকৃষ্ট কিছু সম্পর্কে"],["مِّن","min","than","চেয়েও"],["ذَٰلِكُمُ ۗ","dhālikumu","that","এর (তোমাদের)"],["ٱلنَّارُ","l-nāru","The Fire","(সেটা হলো) আগুন"],["وَعَدَهَا","wa‘adahā","Allah (has) promised it","যা প্রতিশ্রুতি দিয়েছেন"],["ٱللَّهُ","l-lahu","Allah (has) promised it","আল্লাহ"],["ٱلَّذِينَ","alladhīna","(for) those who","(তাদের জন্যে) যারা"],["كَفَرُوا۟ ۖ","kafarū","disbelieve","অস্বীকার করেছে"],["وَبِئْسَ","wabi'sa","and wretched","এবং কত নিকৃষ্ট"],["ٱلْمَصِيرُ","l-maṣīru","(is) the destination","প্রত্যাবর্তনস্থল\""]],"t":"وَإِذَا تُتْلَىٰ عَلَيْهِمْ ءَا<m>يَٰ</>تُنَا بَيِّ<m>نَٰ</><k>تٍۢ تَ</>عْرِفُ فِى وُجُوهِ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> <h>ٱ</>لْمُ<k>نكَ</>رَ ۖ يَكَادُونَ يَسْطُونَ بِ<h>ٱ</>لَّذِينَ يَتْلُونَ عَلَيْهِمْ ءَا<m>يَٰ</>تِنَا ۗ قُلْ أَفَأُنَبِّئُ<f>كُم بِ</>شَ<d>رٍّۢ مِّ</><k>ن ذَٰ</>لِكُمُ ۗ <h>ٱ</><l>ل</><g>نَّ</>ارُ وَعَدَهَا <h>ٱ</>للَّهُ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟ ۖ</> وَبِئْسَ <h>ٱ</>لْمَ<p>صِي</>رُ"},{"n":73,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O mankind","হে"],["ٱلنَّاسُ","l-nāsu","O mankind","মানুষ"],["ضُرِبَ","ḍuriba","Is set forth","পেশ করা হচ্ছে"],["مَثَلٌۭ","mathalun","an example","একটি উপমা"],["فَٱسْتَمِعُوا۟","fa-is'tami‘ū","so listen","তাই তোমরা মনযোগ দিয়ে শুনো"],["لَهُۥٓ ۚ","lahu","to it","প্রতি তার"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those whom","যাদেরকে"],["تَدْعُونَ","tad‘ūna","you invoke","ডাকছো তোমরা"],["مِن","min","besides Allah","মধ্য হতে"],["دُونِ","dūni","besides Allah","পরিবর্তে"],["ٱللَّهِ","l-lahi","besides Allah","আল্লাহর"],["لَن","lan","will never","কখনও না"],["يَخْلُقُوا۟","yakhluqū","create","তারা সৃষ্টি করতে পারে"],["ذُبَابًۭا","dhubāban","a fly","একটি মাছিও"],["وَلَوِ","walawi","even if","যদি"],["ٱجْتَمَعُوا۟","ij'tama‘ū","they gathered together","তারা একত্র হয়"],["لَهُۥ ۖ","lahu","for it","সেজন্যে"],["وَإِن","wa-in","And if","আর যদি"],["يَسْلُبْهُمُ","yaslub'humu","snatched away from them","তাদের থেকে ছিনিয়ে নেয়"],["ٱلذُّبَابُ","l-dhubābu","the fly","মাছি"],["شَيْـًۭٔا","shayan","a thing","কোন কিছুই"],["لَّا","lā","not","না"],["يَسْتَنقِذُوهُ","yastanqidhūhu","they (could) take it back","তা উদ্ধার করতে পারে"],["مِنْهُ ۚ","min'hu","from it","তা হ'তে"],["ضَعُفَ","ḍa‘ufa","So weak","দুর্বল (কতই না)"],["ٱلطَّالِبُ","l-ṭālibu","(are) the seeker","(সাহায্য) অন্বেষণকারী"],["وَٱلْمَطْلُوبُ","wal-maṭlūbu","and the one who is sought","ও অন্বেষণকৃত (সেও দুর্বল)"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</><l>ل</><g>نَّ</>اسُ ضُرِبَ مَثَ<k>لٌۭ فَ</><h>ٱ</>سْتَمِعُو<s>ا۟</> لَهُ<o>ۥٓ ۚ</> إِ<g>نَّ</> <h>ٱ</>لَّذِينَ تَ<q>دْ</>عُونَ مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ <d>لَن يَ</>خْلُقُو<s>ا۟</> ذُبَا<d>بًۭا وَ</>لَوِ <h>ٱ</><q>جْ</>تَمَعُو<s>ا۟</> لَهُ<m>ۥ</> ۖ وَ<d>إِن يَ</>سْلُ<q>بْ</>هُمُ <h>ٱ</><l>ل</>ذُّبَابُ شَ<w>يْـًۭٔا لَّ</>ا يَسْتَ<k>نقِ</>ذُوهُ مِنْهُ ۚ ضَعُفَ <h>ٱ</><l>ل</>طَّالِبُ وَ<h>ٱ</>لْمَ<q>طْ</><p>لُو</><q>بُ</>"},{"n":74,"w":[["مَا","mā","Not","না"],["قَدَرُوا۟","qadarū","they (have) estimated","তারা মর্যাদা দিলো"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌র"],["حَقَّ","ḥaqqa","(with) due","যথোচিত"],["قَدْرِهِۦٓ ۗ","qadrihi","[His] estimation","তাঁর মর্যাদা"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["لَقَوِىٌّ","laqawiyyun","(is) surely All-Strong","অবশ্যই শক্তিমান"],["عَزِيزٌ","‘azīzun","All-Mighty","পরাক্রমশালী"]],"t":"مَا قَدَرُو<s>ا۟</> <h>ٱ</>للَّهَ حَقَّ قَ<q>دْ</>رِ<o>هِۦٓ ۗ</> إِ<g>نَّ</> <h>ٱ</>للَّهَ لَقَوِىٌّ عَ<p>زِي</>زٌ"},{"n":75,"w":[["ٱللَّهُ","al-lahu","Allah","(বস্তুতঃ) আল্লাহ্‌"],["يَصْطَفِى","yaṣṭafī","chooses","মনোনীত করেন"],["مِنَ","mina","from","মধ্য হ'তে"],["ٱلْمَلَـٰٓئِكَةِ","l-malāikati","the Angels","ফেরেশতাদের"],["رُسُلًۭا","rusulan","Messengers","বাণীবাহকরূপে"],["وَمِنَ","wamina","and from","আর মধ্য হ'তেও"],["ٱلنَّاسِ ۚ","l-nāsi","the mankind","মানুষের"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["سَمِيعٌۢ","samī‘un","(is) All-Hearer","সব শুনেন"],["بَصِيرٌۭ","baṣīrun","All-Seer","সব দেখেন"]],"t":"ٱللَّهُ يَصْطَفِى مِنَ <h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةِ رُسُلًۭ<d>ا وَ</>مِنَ <h>ٱ</><l>ل</><g>نَّ</>اسِ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ سَمِي<i>عٌۢ بَ</><p>صِي</>رٌۭ"},{"n":76,"w":[["يَعْلَمُ","ya‘lamu","He knows","তিনি জানেন"],["مَا","mā","what","যা (আছে)"],["بَيْنَ","bayna","(is) before them","মাঝে"],["أَيْدِيهِمْ","aydīhim","(is) before them","হাতের তাদের (সম্মুখে)"],["وَمَا","wamā","and what","ও যা (আছে)"],["خَلْفَهُمْ ۗ","khalfahum","(is) after them","তাদের পিছনে"],["وَإِلَى","wa-ilā","And to","এবং দিকে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌রই"],["تُرْجَعُ","tur'ja‘u","return","প্রত্যাবর্তিত হয়"],["ٱلْأُمُورُ","l-umūru","all the matters","সব ব্যাপারে"]],"t":"يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ ۗ وَإِلَى <h>ٱ</>للَّهِ تُرْجَعُ <h>ٱ</>لْأُ<p>مُو</>رُ"},{"n":77,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you who believe","হে"],["ٱلَّذِينَ","alladhīna","O you who believe","যারা"],["ءَامَنُوا۟","āmanū","O you who believe","ঈমান এনেছো"],["ٱرْكَعُوا۟","ir'ka‘ū","Bow","তোমরা রূকূ করো"],["وَٱسْجُدُوا۟","wa-us'judū","and prostrate","ও তোমরা সিজদা করো"],["وَٱعْبُدُوا۟","wa-u‘'budū","and worship","ও তোমরা ইবাদাত করো"],["رَبَّكُمْ","rabbakum","your Lord","তোমাদের রবের"],["وَٱفْعَلُوا۟","wa-if'‘alū","and do","ও তোমরা করো"],["ٱلْخَيْرَ","l-khayra","[the] good","ভালো কাজ"],["لَعَلَّكُمْ","la‘allakum","so that you may","যাতে তোমরা"],["تُفْلِحُونَ ۩","tuf'liḥūna","be successful","সফলকাম হ'তে পারো"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> <h>ٱ</>رْكَعُو<s>ا۟</> وَ<h>ٱ</>سْجُدُو<s>ا۟</> وَ<h>ٱ</>عْبُدُو<s>ا۟</> رَبَّكُمْ وَ<h>ٱ</>فْعَلُو<s>ا۟</> <h>ٱ</>لْخَيْرَ لَعَلَّكُمْ تُفْلِحُ<p>و</>نَ ۩"},{"n":78,"w":[["وَجَـٰهِدُوا۟","wajāhidū","And strive","আর তোমরা জিহাদ করো"],["فِى","fī","for","মধ্যে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর (পথে)"],["حَقَّ","ḥaqqa","(with the) striving due (to) Him","যথাযথ"],["جِهَادِهِۦ ۚ","jihādihi","(with the) striving due (to) Him","তাঁর জিহাদ"],["هُوَ","huwa","He","তিনি"],["ٱجْتَبَىٰكُمْ","ij'tabākum","(has) chosen you","তোমাদের মনোনীত  করেছেন"],["وَمَا","wamā","and not","এবং না"],["جَعَلَ","ja‘ala","placed","আরোপ করেছেন"],["عَلَيْكُمْ","‘alaykum","upon you","তোমাদের উপর"],["فِى","fī","in","ব্যাপারে"],["ٱلدِّينِ","l-dīni","the religion","দ্বীনের"],["مِنْ","min","any","কোন"],["حَرَجٍۢ ۚ","ḥarajin","difficulty","সংকীর্ণতা"],["مِّلَّةَ","millata","(The) religion","ধর্মে (মিল্লাতে)"],["أَبِيكُمْ","abīkum","(of) your father","তোমাদের পিতার (প্রতিষ্ঠিত থাকো)"],["إِبْرَٰهِيمَ ۚ","ib'rāhīma","Ibrahim","(অর্থাৎ) ইব্রাহীমের"],["هُوَ","huwa","He","তিনি (অর্থাৎ আল্লাহ)"],["سَمَّىٰكُمُ","sammākumu","named you","তোমাদের নাম দিয়েছেন"],["ٱلْمُسْلِمِينَ","l-mus'limīna","Muslims","মুসলিম"],["مِن","min","before","থেকে"],["قَبْلُ","qablu","before","পূর্ব"],["وَفِى","wafī","and in","এবং মধ্যে"],["هَـٰذَا","hādhā","this","এই (ক্বুর'আনেও)"],["لِيَكُونَ","liyakūna","that may be","যেন হয়"],["ٱلرَّسُولُ","l-rasūlu","the Messenger","রাসূল"],["شَهِيدًا","shahīdan","a witness","সাক্ষী"],["عَلَيْكُمْ","‘alaykum","over you","তোমাদের উপর"],["وَتَكُونُوا۟","watakūnū","and you may be","আর তোমরাও হও"],["شُهَدَآءَ","shuhadāa","witnesses","সাক্ষী"],["عَلَى","‘alā","on","উপর"],["ٱلنَّاسِ ۚ","l-nāsi","the mankind","সমস্ত মানুষের"],["فَأَقِيمُوا۟","fa-aqīmū","So establish","সুতরাং তোমরা প্রতিষ্ঠা করো"],["ٱلصَّلَوٰةَ","l-ṣalata","the prayer","সালাত"],["وَءَاتُوا۟","waātū","and give","ও দাও"],["ٱلزَّكَوٰةَ","l-zakata","zakah","জাকাত"],["وَٱعْتَصِمُوا۟","wa-i‘'taṣimū","and hold fast","এবং তোমরা আঁকড়ে ধরো"],["بِٱللَّهِ","bil-lahi","to Allah","প্রতি আল্লাহ্‌র"],["هُوَ","huwa","He","তিনিই"],["مَوْلَىٰكُمْ ۖ","mawlākum","(is) your Protector ","তোমাদের অভিভাবক"],["فَنِعْمَ","fani‘'ma","so an Excellent","অতএব কত উত্তম"],["ٱلْمَوْلَىٰ","l-mawlā","[the] Protector","অভিভাবক"],["وَنِعْمَ","wani‘'ma","and an Excellent","আর কত উত্তম"],["ٱلنَّصِيرُ","l-naṣīru","[the] Helper","সাহায্যকারী"]],"t":"وَ<m>جَٰ</>هِدُو<s>ا۟</> فِى <h>ٱ</>للَّهِ حَقَّ جِهَادِ<m>هِۦ</> ۚ هُوَ <h>ٱ</><q>جْ</>تَبَ<m>ىٰ</>كُمْ وَمَا جَعَلَ عَلَيْكُمْ فِى <h>ٱ</><l>ل</>دِّينِ مِنْ حَرَ<d>جٍۢ ۚ مِّ</>لَّةَ أَبِيكُمْ إِ<q>بْ</><m>رَٰ</>هِيمَ ۚ هُوَ سَ<g>مَّ</><m>ىٰ</>كُمُ <h>ٱ</>لْمُسْلِمِينَ مِ<k>ن قَ</><q>بْ</>لُ وَفِى <m>هَٰ</>ذَا لِيَكُونَ <h>ٱ</><l>ل</>رَّسُولُ شَهِيدًا عَلَيْكُمْ وَتَكُونُو<s>ا۟</> شُهَ<o>دَآ</>ءَ عَلَى <h>ٱ</><l>ل</><g>نَّ</>اسِ ۚ فَأَقِيمُو<s>ا۟</> <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةَ وَءَاتُو<s>ا۟</> <h>ٱ</><l>ل</>زَّكَ<s>وٰ</>ةَ وَ<h>ٱ</>عْتَصِمُو<s>ا۟</> بِ<h>ٱ</>للَّهِ هُوَ مَوْلَ<m>ىٰ</>كُمْ ۖ فَنِعْمَ <h>ٱ</>لْمَوْلَىٰ وَنِعْمَ <h>ٱ</><l>ل</><g>نَّ</><p>صِي</>رُ"}]}