{"n":22,"a":[{"n":1,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O mankind","হে"],["ٱلنَّاسُ","l-nāsu","O mankind","মানবজাতি"],["ٱتَّقُوا۟","ittaqū","Fear","তোমরা ভয় করো"],["رَبَّكُمْ ۚ","rabbakum","your Lord","তোমাদের রবকে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["زَلْزَلَةَ","zalzalata","(the) convulsion","প্রকম্পন"],["ٱلسَّاعَةِ","l-sā‘ati","(of) the Hour","ক্বিয়ামাতের"],["شَىْءٌ","shayon","(is) a thing","ব্যাপার"],["عَظِيمٌۭ","‘aẓīmun","great","ভয়ংকর"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</><l>ل</><g>نَّ</>اسُ <h>ٱ</>تَّقُو<s>ا۟</> رَبَّكُمْ ۚ إِ<g>نَّ</> زَلْزَلَةَ <h>ٱ</><l>ل</>سَّاعَةِ شَىْءٌ عَ<p>ظِي</>مٌۭ"},{"n":2,"w":[["يَوْمَ","yawma","(The) Day","যেদিন"],["تَرَوْنَهَا","tarawnahā","you will see it","তা তোমরা দেখবে (সেদিন)"],["تَذْهَلُ","tadhhalu","will forget","বিস্মৃত হবে"],["كُلُّ","kullu","every","প্রত্যেক"],["مُرْضِعَةٍ","mur'ḍi‘atin","nursing mother","স্তন্যদাত্রী (মা)"],["عَمَّآ","‘ammā","that which","তাহ'তে যাকে"],["أَرْضَعَتْ","arḍa‘at","she was nursing","সে দুধপান করিয়েছে (অর্থাৎ দুগ্ধপোষ্যকে)"],["وَتَضَعُ","wataḍa‘u","and will deliver","ও গর্ভপাত করবে"],["كُلُّ","kullu","every","প্রত্যেক"],["ذَاتِ","dhāti","pregnant woman","সম্পন্ন"],["حَمْلٍ","ḥamlin","pregnant woman","গর্ভ (গর্ভবতী)"],["حَمْلَهَا","ḥamlahā","her load","তার গর্ভকে"],["وَتَرَى","watarā","and you will see","এবং দেখবে"],["ٱلنَّاسَ","l-nāsa","[the] mankind","লোকদেরকে"],["سُكَـٰرَىٰ","sukārā","intoxicated","মাতালের মতো"],["وَمَا","wamā","while not","অথচ না"],["هُم","hum","they","তারা (হবে)"],["بِسُكَـٰرَىٰ","bisukārā","(are) intoxicated","মাতাল"],["وَلَـٰكِنَّ","walākinna","but","কিন্তু"],["عَذَابَ","‘adhāba","(the) punishment","শাস্তি"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহ্‌র"],["شَدِيدٌۭ","shadīdun","(will be) severe","কঠিন (শাস্তি)"]],"t":"يَوْمَ تَرَوْنَهَا تَذْهَلُ كُلُّ مُرْضِعَةٍ عَ<g>مَّ</><o>آ</> أَرْضَعَتْ وَتَضَعُ كُلُّ ذَاتِ حَمْلٍ حَمْلَهَا وَتَرَى <h>ٱ</><l>ل</><g>نَّ</>اسَ سُ<m>كَٰ</>رَىٰ وَمَا <f>هُم بِ</>سُ<m>كَٰ</>رَىٰ وَ<m>لَٰ</>كِ<g>نَّ</> عَذَابَ <h>ٱ</>للَّهِ شَ<p>دِي</><q>دٌۭ</>"},{"n":3,"w":[["وَمِنَ","wamina","And among","আর কেউ কেউ (মধ্য হ'তে)"],["ٱلنَّاسِ","l-nāsi","the mankind","মানুষের"],["مَن","man","(is he) who","যারা"],["يُجَـٰدِلُ","yujādilu","disputes","(যারা) বিতর্ক করে"],["فِى","fī","concerning","সম্বন্ধে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["بِغَيْرِ","bighayri","without","ব্যতীত"],["عِلْمٍۢ","‘il'min","knowledge","কোন জ্ঞান"],["وَيَتَّبِعُ","wayattabi‘u","and follows","এবং অনুসরণ করে"],["كُلَّ","kulla","every","প্রত্যেক"],["شَيْطَـٰنٍۢ","shayṭānin","devil","শয়তানকে"],["مَّرِيدٍۢ","marīdin","rebellious","উদ্ধত"]],"t":"وَمِنَ <h>ٱ</><l>ل</><g>نَّ</>اسِ <d>مَن يُ</><m>جَٰ</>دِلُ فِى <h>ٱ</>للَّهِ بِغَيْرِ عِلْ<d>مٍۢ وَ</>يَتَّبِعُ كُلَّ شَيْ<m>طَٰ</><d>نٍۢ مَّ</><p>رِي</><q>دٍۢ</>"},{"n":4,"w":[["كُتِبَ","kutiba","It has been decreed","লিখে দেয়া হয়েছে"],["عَلَيْهِ","‘alayhi","for him","তার সম্পর্কে"],["أَنَّهُۥ","annahu","that he","যে তা (এমন)"],["مَن","man","who","যে কেউ"],["تَوَلَّاهُ","tawallāhu","befriends him","তাকে বন্ধু বানাবে"],["فَأَنَّهُۥ","fa-annahu","then indeed, he","তখন সে নিশ্চয়ই"],["يُضِلُّهُۥ","yuḍilluhu","will misguide him","তাকে বিভ্রান্ত করবে"],["وَيَهْدِيهِ","wayahdīhi","and will guide him","ও তাকে পরিচালিত করবে"],["إِلَىٰ","ilā","to","দিকে"],["عَذَابِ","‘adhābi","(the) punishment","শাস্তির"],["ٱلسَّعِيرِ","l-sa‘īri","(of) the Blaze","জ্বলন্ত অাগুনের"]],"t":"كُتِبَ عَلَيْهِ أَ<g>نَّ</>هُ<m>ۥ</> مَ<k>ن تَ</>وَلَّاهُ فَأَ<g>نَّ</>هُ<m>ۥ</> يُضِلُّهُ<m>ۥ</> وَيَهْدِيهِ إِلَىٰ عَذَابِ <h>ٱ</><l>ل</>سَّ<p>عِي</>رِ"},{"n":5,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O mankind","হে"],["ٱلنَّاسُ","l-nāsu","O mankind","মানবজাতি"],["إِن","in","If","যদি"],["كُنتُمْ","kuntum","you are","তোমরা হও"],["فِى","fī","in","মধ্যে"],["رَيْبٍۢ","raybin","doubt","সন্দেহের"],["مِّنَ","mina","about","সম্পর্কে"],["ٱلْبَعْثِ","l-ba‘thi","the Resurrection","উত্থান"],["فَإِنَّا","fa-innā","then indeed, We","তবে নিশ্চয়ই আমরা"],["خَلَقْنَـٰكُم","khalaqnākum","We created you","তোমাদেরকে আমরা সৃষ্টি করেছি"],["مِّن","min","from","হ'তে"],["تُرَابٍۢ","turābin","dust","মাটি"],["ثُمَّ","thumma","then","এরপর"],["مِن","min","from","হ'তে"],["نُّطْفَةٍۢ","nuṭ'fatin","a semen-drop","শুক্র"],["ثُمَّ","thumma","then","এরপর"],["مِنْ","min","from","হ'তে"],["عَلَقَةٍۢ","‘alaqatin","a clinging substance","রক্তপিন্ড"],["ثُمَّ","thumma","then","এরপর"],["مِن","min","from","হ'তে"],["مُّضْغَةٍۢ","muḍ'ghatin","an embryonic lump","মাংসপিন্ড"],["مُّخَلَّقَةٍۢ","mukhallaqatin","formed","পূর্ণাকৃতির"],["وَغَيْرِ","waghayri","and unformed","ও নয়"],["مُخَلَّقَةٍۢ","mukhallaqatin","and unformed","পূর্ণাকৃতির"],["لِّنُبَيِّنَ","linubayyina","that We may make clear","যেন স্পষ্ট করি আমরা প্রকৃত সত্য"],["لَكُمْ ۚ","lakum","to you","কাছে তোমাদের"],["وَنُقِرُّ","wanuqirru","And We cause to remain","এবং আমরা স্থিতিশীল করি"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْحَامِ","l-arḥāmi","the wombs","জরায়ুসমূহের"],["مَا","mā","what","যেমন"],["نَشَآءُ","nashāu","We will","চাই আমরা"],["إِلَىٰٓ","ilā","for","পর্যন্ত"],["أَجَلٍۢ","ajalin","a term","সময়"],["مُّسَمًّۭى","musamman","appointed","নির্দিষ্ট"],["ثُمَّ","thumma","then","এরপর"],["نُخْرِجُكُمْ","nukh'rijukum","We bring you out","তোমাদেরকে বের করি আমরা"],["طِفْلًۭا","ṭif'lan","(as) a child","শিশুরূপে"],["ثُمَّ","thumma","[then]","এরপর (ব্যবস্থা করি)"],["لِتَبْلُغُوٓا۟","litablughū","that you may reach","যেন তোমরা পৌঁছে যাও"],["أَشُدَّكُمْ ۖ","ashuddakum","[your] maturity","যৌবনে তোমাদের"],["وَمِنكُم","waminkum","And among you","আর তোমাদের মধ্য হ'তে"],["مَّن","man","(is he) who","কাউকে"],["يُتَوَفَّىٰ","yutawaffā","dies","মৃত্যূ দেয়া হয়"],["وَمِنكُم","waminkum","and among you","আবার তোমাদের মধ্য হ'তে"],["مَّن","man","(is he) who","কাউকে"],["يُرَدُّ","yuraddu","is returned","প্রত্যাবর্তন করানো হয়"],["إِلَىٰٓ","ilā","to","দিকে"],["أَرْذَلِ","ardhali","the most abject","হীনতম"],["ٱلْعُمُرِ","l-‘umuri","age","বয়সের"],["لِكَيْلَا","likaylā","so that not","যেন না"],["يَعْلَمَ","ya‘lama","he knows","সে জানবে"],["مِنۢ","min","after","থেকে"],["بَعْدِ","ba‘di","after","পর"],["عِلْمٍۢ","‘il'min","having known","সবকিছু জেনে নেয়ার"],["شَيْـًۭٔا ۚ","shayan","anything","কিছুমাত্র"],["وَتَرَى","watarā","And you see","এবং তুমি দেখছো"],["ٱلْأَرْضَ","l-arḍa","the earth","ভূমিকে"],["هَامِدَةًۭ","hāmidatan","barren","শুকনো"],["فَإِذَآ","fa-idhā","then when","অতঃপর যখন"],["أَنزَلْنَا","anzalnā","We send down","আমরা বর্ষণ করি"],["عَلَيْهَا","‘alayhā","on it","তার উপর"],["ٱلْمَآءَ","l-māa","water","পানি"],["ٱهْتَزَّتْ","ih'tazzat","it gets stirred","তা সতেজ হয়"],["وَرَبَتْ","warabat","and it swells","ও ফুলে ফেঁপে ওঠে"],["وَأَنۢبَتَتْ","wa-anbatat","and grows","এবং উদ্‌গত করে"],["مِن","min","of","প্রকার"],["كُلِّ","kulli","every","সর্ব"],["زَوْجٍۭ","zawjin","kind","উদ্ভিদ"],["بَهِيجٍۢ","bahījin","beautiful","সুদৃশ্য"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</><l>ل</><g>نَّ</>اسُ إِ<k>ن كُنتُ</>مْ فِى رَيْ<d>بٍۢ مِّ</>نَ <h>ٱ</>لْبَعْثِ فَإِ<g>نَّ</>ا خَلَ<q>قْ</><m>نَٰ</><y>كُم مِّ</><k>ن تُ</>رَا<k>بٍۢ ثُ</><g>مَّ</> <d>مِن نُّ</><q>طْ</>فَ<k>ةٍۢ ثُ</><g>مَّ</> مِنْ عَلَقَ<k>ةٍۢ ثُ</><g>مَّ</> <d>مِن مُّ</>ضْغَ<d>ةٍۢ مُّ</>خَلَّقَ<d>ةٍۢ وَ</>غَيْرِ مُخَلَّقَ<w>ةٍۢ لِّ</>نُبَيِّنَ لَكُمْ ۚ وَنُقِرُّ فِى <h>ٱ</>لْأَرْحَامِ مَا نَ<o>شَآ</>ءُ إِلَ<o>ىٰٓ</> أَجَ<d>لٍۢ مُّ</>سَ<k>مًّۭى ثُ</><g>مَّ</> نُخْرِجُكُمْ طِفْلًۭ<k>ا ثُ</><g>مَّ</> لِتَ<q>بْ</>لُ<o>غُوٓ</><s>ا۟</> أَشُدَّكُمْ ۖ وَمِ<k>نكُ</><y>م مَّ</><d>ن يُ</>تَوَفَّىٰ وَمِ<k>نكُ</><y>م مَّ</><d>ن يُ</>رَدُّ إِلَ<o>ىٰٓ</> أَرْذَلِ <h>ٱ</>لْعُمُرِ لِكَيْلَا يَعْلَمَ <i>مِنۢ بَ</>عْدِ عِلْ<k>مٍۢ شَ</><d>يْـًۭٔا ۚ وَ</>تَرَى <h>ٱ</>لْأَرْضَ هَامِدَ<k>ةًۭ فَ</>إِ<o>ذَآ</> أَ<k>نزَ</>لْنَا عَلَيْهَا <h>ٱ</>لْ<o>مَآ</>ءَ <h>ٱ</>هْتَزَّتْ وَرَبَتْ وَأَ<i>نۢبَ</>تَتْ مِ<k>ن كُ</>لِّ زَوْ<i>جٍۭ بَ</><p>هِي</><q>جٍۢ</>"},{"n":6,"w":[["ذَٰلِكَ","dhālika","That","এটা"],["بِأَنَّ","bi-anna","(is) because","এজন্যে যে"],["ٱللَّهَ","l-laha","Allah ","আল্লাহ"],["هُوَ","huwa","He","তিনিই"],["ٱلْحَقُّ","l-ḥaqu","(is) the Truth","প্রকৃত সত্য"],["وَأَنَّهُۥ","wa-annahu","And that He","এবং এসব এজন্যে যে তিনিই"],["يُحْىِ","yuḥ'yī","[He] gives life","জীবিত করেন"],["ٱلْمَوْتَىٰ","l-mawtā","(to) the dead","মৃতদেরকে"],["وَأَنَّهُۥ","wa-annahu","and that He","এবং (এটা প্রমাণ করে যে) তিনিই"],["عَلَىٰ","‘alā","(is) over","উপর"],["كُلِّ","kulli","every","সব"],["شَىْءٍۢ","shayin","thing","কিছুর"],["قَدِيرٌۭ","qadīrun","All-Powerful","শক্তিমান"]],"t":"<m>ذَٰ</>لِكَ بِأَ<g>نَّ</> <h>ٱ</>للَّهَ هُوَ <h>ٱ</>لْحَقُّ وَأَ<g>نَّ</>هُ<m>ۥ</> يُحْىِ <h>ٱ</>لْمَوْتَىٰ وَأَ<g>نَّ</>هُ<m>ۥ</> عَلَىٰ كُلِّ <k>شَىْءٍۢ قَ</><p>دِي</>رٌۭ"},{"n":7,"w":[["وَأَنَّ","wa-anna","And that","এবং (এটা প্রমাণ করে) যে"],["ٱلسَّاعَةَ","l-sā‘ata","the Hour","ক্বিয়ামাত"],["ءَاتِيَةٌۭ","ātiyatun","will come","অবশ্যম্ভাবী"],["لَّا","lā","(there is) no","নেই"],["رَيْبَ","rayba","doubt","কোন সন্দেহ"],["فِيهَا","fīhā","about it","মধ্যে তার"],["وَأَنَّ","wa-anna","and that","এবং (এটা প্রমাণ করে) যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يَبْعَثُ","yab‘athu","will resurrect","উত্থিত করবেন"],["مَن","man","(those) who","যারা (আছে)"],["فِى","fī","(are) in","মধ্যে"],["ٱلْقُبُورِ","l-qubūri","the graves","কবরসমূহের"]],"t":"وَأَ<g>نَّ</> <h>ٱ</><l>ل</>سَّاعَةَ ءَاتِيَ<w>ةٌۭ لَّ</>ا رَيْبَ فِيهَا وَأَ<g>نَّ</> <h>ٱ</>للَّهَ يَ<q>بْ</>عَثُ مَ<k>ن فِ</>ى <h>ٱ</>لْقُ<p>بُو</>رِ"},{"n":8,"w":[["وَمِنَ","wamina","And among","এবং কেউ কেউ (মধ্য হ'তে)"],["ٱلنَّاسِ","l-nāsi","mankind","লোকদের"],["مَن","man","(is he) who","যে"],["يُجَـٰدِلُ","yujādilu","disputes","ঝগড়া করে"],["فِى","fī","concerning","সম্বন্ধে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["بِغَيْرِ","bighayri","without","ছাড়াই"],["عِلْمٍۢ","‘il'min","any knowledge","কোন জ্ঞান"],["وَلَا","walā","and not","এবং না (আছে)"],["هُدًۭى","hudan","any guidance","(তাদের কাছে) পথ নির্দেশনা"],["وَلَا","walā","and not","আর না (আছে)"],["كِتَـٰبٍۢ","kitābin","a Book","কিতাব"],["مُّنِيرٍۢ","munīrin","enlightening","আলোকময়"]],"t":"وَمِنَ <h>ٱ</><l>ل</><g>نَّ</>اسِ <d>مَن يُ</><m>جَٰ</>دِلُ فِى <h>ٱ</>للَّهِ بِغَيْرِ عِلْ<d>مٍۢ وَ</>لَا هُ<d>دًۭى وَ</>لَا كِ<m>تَٰ</><d>بٍۢ مُّ</><p>نِي</>رٍۢ"},{"n":9,"w":[