ruhu","his harm","যার ক্ষতি"],["أَقْرَبُ","aqrabu","(is) closer","নিকটতর অধিকতর"],["مِن","min","than","অপেক্ষা"],["نَّفْعِهِۦ ۚ","naf‘ihi","his benefit","তার উপকারিতা"],["لَبِئْسَ","labi'sa","Surely, an evil","অবশ্যই কত নিকৃষ্ট"],["ٱلْمَوْلَىٰ","l-mawlā","protector","অভিভাবক"],["وَلَبِئْسَ","walabi'sa","and surely an evil","আর অবশ্যই কত নিকৃষ্ট"],["ٱلْعَشِيرُ","l-‘ashīru","friend","সঙ্গী"]],"t":"يَ<q>دْ</>عُو<s>ا۟</> لَمَ<k>ن ضَ</>رُّهُ<o>ۥٓ</> أَ<q>قْ</>رَبُ <d>مِن نَّ</>فْعِ<m>هِۦ</> ۚ لَبِئْسَ <h>ٱ</>لْمَوْلَىٰ وَلَبِئْسَ <h>ٱ</>لْعَ<p>شِي</>رُ"},{"n":14,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يُدْخِلُ","yud'khilu","will admit","প্রবেশ করাবেন"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["وَعَمِلُوا۟","wa‘amilū","and do","ও কাজ করেছে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","the righteous deeds","সৎকাজসমূহের"],["جَنَّـٰتٍۢ","jannātin","(to) Gardens","(এমন) জান্নাতে"],["تَجْرِى","tajrī","flow","প্রবাহিত হয়"],["مِن","min","from","থেকে"],["تَحْتِهَا","taḥtihā","underneath it","যার নিচ"],["ٱلْأَنْهَـٰرُ ۚ","l-anhāru","the rivers","ঝর্নাসমূহ"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يَفْعَلُ","yaf‘alu","does","করেন"],["مَا","mā","what","যা"],["يُرِيدُ","yurīdu","He intends","চান তিনি"]],"t":"إِ<g>نَّ</> <h>ٱ</>للَّهَ يُ<q>دْ</>خِلُ <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ جَ<g>نَّٰ</><k>تٍۢ تَ</><q>جْ</>رِى مِ<k>ن تَ</>حْتِهَا <h>ٱ</>لْأَنْ<m>هَٰ</>رُ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ يَفْعَلُ مَا يُ<p>رِي</><q>دُ</>"},{"n":15,"w":[["مَن","man","Whoever","যে"],["كَانَ","kāna","[is]","ছিলো"],["يَظُنُّ","yaẓunnu","thinks","ধারণা করতো"],["أَن","an","that","যে"],["لَّن","lan","not","কখনও না"],["يَنصُرَهُ","yanṣurahu","Allah will help him","তাকে (রাসূল সাল্লাল্লাহু 'আলাইহি ওয়া সাল্লাম-কে) সাহায্য করবেন"],["ٱللَّهُ","l-lahu","Allah will help him","আল্লাহ"],["فِى","fī","in","মধ্যে"],["ٱلدُّنْيَا","l-dun'yā","the world","দুনিয়ার"],["وَٱلْـَٔاخِرَةِ","wal-ākhirati","and the Hereafter","ও আখিরাতে"],["فَلْيَمْدُدْ","falyamdud","then let him extend","তাহ'লে সে লম্বা করুক"],["بِسَبَبٍ","bisababin","a rope","নিয়ে একটি রশিকে"],["إِلَى","ilā","to","পর্যন্ত"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশ"],["ثُمَّ","thumma","then","এরপর (সেখানে পৌঁছে)"],["لْيَقْطَعْ","l'yaqṭa‘","let him cut off","যেন তা কেটে দেয় (ওহীর ধারা)"],["فَلْيَنظُرْ","falyanẓur","then let him see","অতঃপর দেখুক"],["هَلْ","hal","whether","কি"],["يُذْهِبَنَّ","yudh'hibanna","will remove","দূর করতে পারবে"],["كَيْدُهُۥ","kayduhu","his plan","তার কৌশল"],["مَا","mā","what","যা"],["يَغِيظُ","yaghīẓu","enrages","রাগান্বিত করে (তাকে)"]],"t":"مَ<k>ن كَ</>انَ يَظُ<g>نُّ</> <w>أَن لَّ</><d>ن يَ</><k>نصُ</>رَهُ <h>ٱ</>للَّهُ فِى <h>ٱ</><l>ل</>دُّنْيَا وَ<h>ٱ</>لْءَاخِرَةِ فَلْيَمْدُ<q>دْ</> بِسَبَبٍ إِلَى <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ ثُ<g>مَّ</> لْيَ<q>قْ</>طَعْ فَلْيَ<k>نظُ</>رْ هَلْ يُذْهِبَ<g>نَّ</> كَيْدُهُ<m>ۥ</> مَا يَ<p>غِي</>ظُ"},{"n":16,"w":[["وَكَذَٰلِكَ","wakadhālika","And thus","আর এরূপেই"],["أَنزَلْنَـٰهُ","anzalnāhu","We sent it down","তা আমরা অবতীর্ণ করেছি"],["ءَايَـٰتٍۭ","āyātin","(as) clear Verses","আয়াত (রূপে)"],["بَيِّنَـٰتٍۢ","bayyinātin","(as) clear Verses","সুস্পষ্ট"],["وَأَنَّ","wa-anna","and that","আর নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يَهْدِى","yahdī","guides","পথ দেখান"],["مَن","man","whom","যাকে"],["يُرِيدُ","yurīdu","He intends","চান"]],"t":"وَكَ<m>ذَٰ</>لِكَ أَ<k>نزَ</>لْ<m>نَٰ</>هُ ءَا<m>يَٰ</><i>تٍۭ بَ</>يِّ<m>نَٰ</><d>تٍۢ وَ</>أَ<g>نَّ</> <h>ٱ</>للَّهَ يَهْدِى <d>مَن يُ</><p>رِي</><q>دُ</>"},{"n":17,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ءَامَنُوا۟","āmanū","have believed","ঈমান এনেছে"],["وَٱلَّذِينَ","wa-alladhīna","and those who","ও যারা"],["هَادُوا۟","hādū","were Jews","ইয়াহুদী হয়েছে"],["وَٱلصَّـٰبِـِٔينَ","wal-ṣābiīna","and the Sabians","ও সাবেয়ী"],["وَٱلنَّصَـٰرَىٰ","wal-naṣārā","and the Christians","ও খ্রিষ্টান"],["وَٱلْمَجُوسَ","wal-majūsa","and the Magians","ও অগ্নি পূজারক"],["وَٱلَّذِينَ","wa-alladhīna","and those who","এবং যারা"],["أَشْرَكُوٓا۟","ashrakū","(are) polytheists","শিরক করেছে"],["إِنَّ","inna","indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يَفْصِلُ","yafṣilu","will judge","মীমাংসা করে দিবেন"],["بَيْنَهُمْ","baynahum","between them","তাদের মাঝে"],["يَوْمَ","yawma","(on) the Day","দিনে"],["ٱلْقِيَـٰمَةِ ۚ","l-qiyāmati","(of) the Resurrection","ক্বিয়ামাতের"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["عَلَىٰ","‘alā","over","সম্পর্কে"],["كُلِّ","kulli","every","সব"],["شَىْءٍۢ","shayin","thing","কিছু"],["شَهِيدٌ","shahīdun","(is) a Witness","প্রত্যক্ষকারী"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَ<h>ٱ</>لَّذِينَ هَادُو<s>ا۟</> وَ<h>ٱ</><l>ل</><m>صَّٰ</>بِـِٔينَ وَ<h>ٱ</><l>ل</><g>نَّ</><m>صَٰ</>رَىٰ وَ<h>ٱ</>لْمَجُوسَ وَ<h>ٱ</>لَّذِينَ أَشْرَ<o>كُوٓ</><s>ا۟</> إِ<g>نَّ</> <h>ٱ</>للَّهَ يَفْصِلُ بَيْنَهُمْ يَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ عَلَىٰ كُلِّ <k>شَىْءٍۢ شَ</><p>هِي</><q>دٌ</>"},{"n":18,"w":[["أَلَمْ","alam","Do not","নি কি"],["تَرَ","tara","you see","তুমি দেখো"],["أَنَّ","anna","that","যে"],["ٱللَّهَ","l-laha","(to) Allah","আল্লাহ (এমন সত্ত্বা)"],["يَسْجُدُ","yasjudu","prostrates","সিজদা করে"],["لَهُۥ","lahu","to Him","তাঁর জন্যে"],["مَن","man","whoever","যা কিছু"],["فِى","fī","(is) in","আছে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশমন্ডলীতে"],["وَمَن","waman","and whoever","ও যা কিছু"],["فِى","fī","(is) in","আছে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীতে"],["وَٱلشَّمْسُ","wal-shamsu","and the sun","এবং সূর্য"],["وَٱلْقَمَرُ","wal-qamaru","and the moon","ও চাঁদ"],["وَٱلنُّجُومُ","wal-nujūmu","and the stars","ও নক্ষত্রমণ্ডলী"],["وَٱلْجِبَالُ","wal-jibālu","and the mountains","ও পর্বতরাজি"],["وَٱلشَّجَرُ","wal-shajaru","and the trees","ও গাছপালা"],["وَٱلدَّوَآبُّ","wal-dawābu","and the moving creatures","ও জীবজন্তু"],["وَكَثِيرٌۭ","wakathīrun","and many","এবং অনেকে"],["مِّنَ","mina","of","মধ্য হ'তে"],["ٱلنَّاسِ ۖ","l-nāsi","the people","মানুষের (সিজদাবনত থাকে)"],["وَكَثِيرٌ","wakathīrun","But many ","আবার অনেকের"],["حَقَّ","ḥaqqa","(is) justly due","অবধারিত হয়েছে"],["عَلَيْهِ","‘alayhi","on him","যার উপর"],["ٱلْعَذَابُ ۗ","l-‘adhābu","the punishment","শাস্তি (তারা এর বিপরীত)"],["وَمَن","waman","And whoever","এবং যাকে"],["يُهِنِ","yuhini","Allah humiliates","হেয় করেন"],["ٱللَّهُ","l-lahu","Allah humiliates","আল্লাহ"],["فَمَا","famā","then not","সেক্ষেত্রে নেই"],["لَهُۥ","lahu","for him","জন্যে তার"],["مِن","min","any","কোন"],["مُّكْرِمٍ ۚ","muk'rimin","bestower of honor","সম্মানদাতা"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يَفْعَلُ","yaf‘alu","does","করেন"],["مَا","mā","what","যা"],["يَشَآءُ ۩","yashāu","He wills","তিনি চান"]],"t":"أَلَمْ تَرَ أَ<g>نَّ</> <h>ٱ</>للَّهَ يَسْجُدُ لَهُ<m>ۥ</> مَ<k>ن فِ</>ى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَمَ<k>ن فِ</>ى <h>ٱ</>لْأَرْضِ وَ<h>ٱ</><l>ل</>شَّمْسُ وَ<h>ٱ</>لْقَمَرُ وَ<h>ٱ</><l>ل</><g>نُّ</>جُومُ وَ<h>ٱ</>لْجِبَالُ وَ<h>ٱ</><l>ل</>شَّجَرُ وَ<h>ٱ</><l>ل</>دَّ<n>وَآ</>بُّ وَكَثِي<d>رٌۭ مِّ</>نَ <h>ٱ</><l>ل</><g>نَّ</>اسِ ۖ وَكَثِيرٌ حَقَّ عَلَيْهِ <h>ٱ</>لْعَذَابُ ۗ وَ<d>مَن يُ</>هِنِ <h>ٱ</>للَّهُ فَمَا لَهُ<m>ۥ</> <d>مِن مُّ</>كْرِمٍ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ يَفْعَلُ مَا يَ<o>شَآ</>ءُ ۩"},{"n":19,"w":[["۞ هَـٰذَانِ","hādhāni","These two","এই দুই"],["خَصْمَانِ","khaṣmāni","opponents","বিবদমান পক্ষদ্বয়"],["ٱخْتَصَمُوا۟","ikh'taṣamū","dispute","বিতর্ক করছে"],["فِى","fī","concerning","সম্পর্কে"],["رَبِّهِمْ ۖ","rabbihim","their Lord","তাদের রব"],["فَٱلَّذِينَ","fa-alladhīna","But those who","তাই যারা"],["كَفَرُوا۟","kafarū","disbelieved","অস্বীকার করেছে"],["قُطِّعَتْ","quṭṭi‘at","will be cut out","কেটে তৈরী করা হয়েছে"],["لَهُمْ","lahum","for them","জন্যে তাদের"],["ثِيَابٌۭ","thiyābun","garments","পোশাক"],["مِّن","min","of","তৈরি"],["نَّارٍۢ","nārin","fire","আগুনের"],["يُصَبُّ","yuṣabbu","Will be poured","ঢেলে দেয়া হবে"],["مِن","min","over","হ'তে"],["فَوْقِ","fawqi","over","উপর"],["رُءُوسِهِمُ","ruūsihimu","their heads","তাদের মাথার"],["ٱلْحَمِيمُ","l-ḥamīmu","[the] scalding water","ফুটন্ত পানি"]],"t":"۞ <m>هَٰ</>ذَانِ خَصْمَانِ <h>ٱ</>خْتَصَمُو<s>ا۟</> فِى رَبِّهِمْ ۖ فَ<h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> قُطِّعَتْ لَهُمْ ثِيَا<d>بٌۭ مِّن نَّارٍۢ يُ</>صَبُّ مِ<k>ن فَ</>وْقِ رُءُوسِهِمُ <h>ٱ</>لْحَ<p>مِي</>مُ"},{"n":20,"w":[["يُصْهَرُ","yuṣ'haru","Will be melted","গলে যায়"],["بِهِۦ","bihi","with it","দিয়ে তা"],["مَا","mā","what","যা কিছু"],["فِى","fī","(is) in","মধ্যে (আছে)"],["بُطُونِهِمْ","buṭūnihim","their bellies","তাদের পেটসমূহের"],["وَٱلْجُلُودُ","wal-julūdu","and the skins","ও চামড়াগুলো"]],"t":"يُصْهَرُ بِ<m>هِۦ</> مَا فِى بُطُونِهِمْ وَ<h>ٱ</>لْجُ<p>لُو</><q>دُ</>"},{"n":21,"w":[["وَلَهُم","walahum","And for them","আর জন্যে তাদের রয়েছে"],["مَّقَـٰمِعُ","maqāmi‘u","(are) hooked rods","মুগুরগুলো"],["مِنْ","min","of","(তৈরী) দিয়ে"],["حَدِيدٍۢ","ḥadīdin","iron","লোহা"]],"t":"وَلَ<y>هُم مَّ</><m>قَٰ</>مِعُ مِنْ حَ<p>دِي</><q>دٍۢ</>"},{"n":22,"w":[["كُلَّمَآ","kullamā","Every time","যখনই"],["أَرَادُوٓا۟","arādū","they want","চাইবে তারা"],["أَن","an","to","যে"],["يَخْرُجُوا۟","yakhrujū","come out","তারা বের হবে"],["مِنْهَا","min'hā","from it","তা হ'তে"],["مِنْ","min","from","কারণে"],["غَمٍّ","ghammin","anguish","যন্ত্রণার"],["أُعِيدُوا۟","u‘īdū","they will be returned","তাদেরকে ফিরিয়ে দেয়া হবে"],["فِيهَا","fīhā","therein","তার মধ্যে"],["وَذُوقُوا۟","wadhūqū","Taste","\"এবং (বলা হবে) তোমরা স্বাদ নাও"],["عَذَابَ","‘adhāba","(the) punishment","শাস্তির"],["ٱلْحَرِيقِ","l-ḥarīqi","(of) the Burning Fire","দহনের\""]],"t":"كُلَّ<o>مَآ</> أَرَا<o>دُوٓ</><s>ا۟</> <d>أَن يَ</>خْرُجُو<s>ا۟</> مِنْهَا مِنْ غَ<g>مٍّ</> أُعِيدُو<s>ا۟</> فِيهَا وَذُوقُو<s>ا۟</> عَذَابَ <h>ٱ</>لْحَ<p>رِي</><q>قِ</>"},{"n":23,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يُدْخِلُ","yud'khilu","will admit","প্রবেশ করাবেন"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["وَعَمِلُوا۟","wa‘amilū","and do","ও কাজ করেছে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","the righteous deeds","সৎ"],["جَنَّـٰتٍۢ","jannātin","(to) Gardens","জান্নাতসমূহে"],["تَجْرِى","tajrī","flow","প্রবাহিত হয়"],["مِن","min","from","থেকে"],["تَحْتِهَا","taḥtihā","underneath it","তার নিচ"],["ٱلْأَنْهَـٰرُ","l-anhāru","the rivers","ঝর্ণাসমূহ"],["يُحَلَّوْنَ","yuḥallawna","They will be adorned","তাদেরকে অলংকৃত করা হবে"],["فِيهَا","fīhā","therein","তার মধ্যে"],["مِنْ","min","with","দ্বারা"],["أَسَاوِرَ","asāwira","bracelets","কঙ্কণ"],["مِن","min","of","তৈরি"],["ذَهَبٍۢ","dhahabin","gold","সোনার"],["وَلُؤْلُؤًۭا ۖ","walu'lu-an","and pearl","ও মুক্তার"],["وَلِبَاسُهُمْ","walibāsuhum","and their garments","তাদের পোশাক (হবে)"],["فِيهَا","fīhā","therein","তার মধ্যে"],["حَرِيرٌۭ","ḥarīrun","(will be of) silk","রেশমের"]],"t":"إِ<g>نَّ</> <h>ٱ</>للَّهَ يُ<q>دْ</>خِلُ <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ جَ<g>نَّٰ</><k>تٍۢ تَ</><q>جْ</>رِى مِ<k>ن تَ</>حْتِهَا <h>ٱ</>لْأَنْ<m>هَٰ</>رُ يُحَلَّوْنَ فِيهَا مِنْ أَسَاوِرَ مِ<k>ن ذَ</>هَ<d>بٍۢ وَ</>لُؤْلُ<d>ؤًۭا ۖ وَ</>لِبَاسُهُمْ فِيهَا حَ<p>رِي</>رٌۭ"},{"n":24,"w":[["وَهُدُوٓا۟","wahudū","And they were guided","এবং তাদেরকে সৎপথের দিশা দেয়া হয়েছে"],["إِلَى","ilā","to","প্রতি"],["ٱلطَّيِّبِ","l-ṭayibi","the good","পবিত্র"],["مِنَ","mina","of","থেকে"],["ٱلْقَوْلِ","l-qawli","the speech","বাণীর (কবুলের)"],["وَهُدُوٓا۟","wahudū","and they were guided","পরিচালিত করা হয়েছে"],["إِلَىٰ","ilā","to","দিকে"],["صِرَٰطِ","ṣirāṭi","(the) path","পথের"],["ٱلْحَمِيدِ","l-ḥamīdi","(of) the Praiseworthy","প্রশংসিতের (অর্থাৎ আল্লাহর)"]],"t":"وَهُ<o>دُوٓ</><s>ا۟</> إِلَى <h>ٱ</><l>ل</>طَّيِّبِ مِنَ <h>ٱ</>لْقَوْلِ وَهُ<o>دُوٓ</><s>ا۟</> إِلَىٰ صِ<m>رَٰ</>طِ <h>ٱ</>لْحَ<p>مِي</><q>دِ</>"},{"n":25,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieved","অস্বীকার করেছে"],["وَيَصُدُّونَ","wayaṣuddūna","and hinder","ও বাদা 