لَّا","illā","but","এ ছাড়া"],["نَذِيرٌۭ","nadhīrun","a warner","সতর্ককারী (মাত্র)"],["مُّبِينٌۭ","mubīnun","clear","সুস্পষ্ট\""]],"t":"إِنْ أَنَا۠ إِلَّا نَذِي<d>رٌۭ مُّ</><p>بِي</>نٌۭ"},{"n":116,"w":[["قَالُوا۟","qālū","They said","তারা বললো"],["لَئِن","la-in","If","\"অবশ্যই যদি"],["لَّمْ","lam","not","না"],["تَنتَهِ","tantahi","you desist","বিরত হও"],["يَـٰنُوحُ","yānūḥu","O Nuh","হে নূহ"],["لَتَكُونَنَّ","latakūnanna","Surely you will be","অবশ্যই তুমি হবেই"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْمَرْجُومِينَ","l-marjūmīna","those who are stoned","পাথরের আঘাতে নিহতদের"]],"t":"قَالُو<s>ا۟</> لَ<w>ئِن لَّ</>مْ تَ<k>نتَ</>هِ <m>يَٰ</>نُوحُ لَتَكُونَ<g>نَّ</> مِنَ <h>ٱ</>لْمَرْجُو<p>مِي</>نَ"},{"n":117,"w":[["قَالَ","qāla","He said","(নূহ) বললো"],["رَبِّ","rabbi","My Lord","\"হে আমার রব"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["قَوْمِى","qawmī","my people","আমার জাতি"],["كَذَّبُونِ","kadhabūni","have denied me","আমাকে মিথ্যাবাদী বলেছে"]],"t":"قَالَ رَبِّ إِ<g>نَّ</> قَوْمِى كَذَّ<p>بُو</>نِ"},{"n":118,"w":[["فَٱفْتَحْ","fa-if'taḥ","So judge","সুতরাং মীমাংসা করো"],["بَيْنِى","baynī","between me","মাঝে আমার"],["وَبَيْنَهُمْ","wabaynahum","and between them","ও মাঝে তাদের"],["فَتْحًۭا","fatḥan","(with decisive) judgment","(চূড়ান্ত) মীমাংসা"],["وَنَجِّنِى","wanajjinī","and save me","এবং আমাকে রক্ষা করো"],["وَمَن","waman","and who","ও যারা (আছে)"],["مَّعِىَ","ma‘iya","(are) with me","আমার সাথে"],["مِنَ","mina","of","(অর্থাৎ ) মধ্য থেকে"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believers","মু'মিন\""]],"t":"فَ<h>ٱ</>فْتَحْ بَيْنِى وَبَيْنَهُمْ فَتْ<d>حًۭا وَ</>نَجِّنِى وَ<d>مَن مَّ</>عِىَ مِنَ <h>ٱ</>لْمُؤْمِ<p>نِي</>نَ"},{"n":119,"w":[["فَأَنجَيْنَـٰهُ","fa-anjaynāhu","So We saved him","অতঃপর আমরা তাকে রক্ষা করলাম"],["وَمَن","waman","and who","ও যারা (ছিলো)"],["مَّعَهُۥ","ma‘ahu","(were) with him","তাঁর সাথে"],["فِى","fī","in","মধ্যে"],["ٱلْفُلْكِ","l-ful'ki","the ship","নৌযানের"],["ٱلْمَشْحُونِ","l-mashḥūni","laden","বোঝাই করা"]],"t":"فَأَ<k>نجَ</>يْ<m>نَٰ</>هُ وَ<d>مَن مَّ</>عَهُ<m>ۥ</> فِى <h>ٱ</>لْفُلْكِ <h>ٱ</>لْمَشْ<p>حُو</>نِ"},{"n":120,"w":[["ثُمَّ","thumma","Then","এরপর"],["أَغْرَقْنَا","aghraqnā","We drowned","আমরা ডুবিয়ে দিলাম"],["بَعْدُ","ba‘du","thereafter","পরে (রক্ষা করার)"],["ٱلْبَاقِينَ","l-bāqīna","the remaining ones","অবশিষ্টদেরকে"]],"t":"ثُ<g>مَّ</> أَغْرَ<q>قْ</>نَا بَعْدُ <h>ٱ</>لْبَا<p>قِي</>نَ"},{"n":121,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে (আছে)"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَةًۭ ۖ","laāyatan","surely, (is) a sign","অবশ্যই নিদর্শন"],["وَمَا","wamā","but not","আর না"],["كَانَ","kāna","are","ছিলো"],["أَكْثَرُهُم","aktharuhum","most of them","অধিকাংশই তাদের"],["مُّؤْمِنِينَ","mu'minīna","believers","মু'মিন"]],"t":"إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَايَ<d>ةًۭ ۖ وَ</>مَا كَانَ أَكْثَرُ<y>هُم مُّ</>ؤْمِ<p>نِي</>نَ"},{"n":122,"w":[["وَإِنَّ","wa-inna","And indeed","আর নিশ্চয়ই"],["رَبَّكَ","rabbaka","your Lord","তোমার রব"],["لَهُوَ","lahuwa","surely, He","অবশ্যই তিনি"],["ٱلْعَزِيزُ","l-‘azīzu","(is) the All-Mighty","পরাক্রমশালী"],["ٱلرَّحِيمُ","l-raḥīmu","the Most Merciful","পরম দয়ালু"]],"t":"وَإِ<g>نَّ</> رَبَّكَ لَهُوَ <h>ٱ</>لْعَزِيزُ <h>ٱ</><l>ل</>رَّ<p>حِي</>مُ"},{"n":123,"w":[["كَذَّبَتْ","kadhabat","Denied","মিথ্যারোপ করেছিলো"],["عَادٌ","‘ādun","(the people) of Aad","আ'দ জাতিও"],["ٱلْمُرْسَلِينَ","l-mur'salīna","the Messengers","রাসূলদেরকে"]],"t":"كَذَّبَتْ عَادٌ <h>ٱ</>لْمُرْسَ<p>لِي</>نَ"},{"n":124,"w":[["إِذْ","idh","When","(স্মরণ করো) যখন"],["قَالَ","qāla","said","বলেছিলো"],["لَهُمْ","lahum","to them","উদ্দেশ্যে তাদের"],["أَخُوهُمْ","akhūhum","their brother","ভাই তাদের"],["هُودٌ","hūdun","Hud","হূদ"],["أَلَا","alā","Will not","\"কি না"],["تَتَّقُونَ","tattaqūna","you fear (Allah)","তোমরা ভয় করবে"]],"t":"إِذْ قَالَ لَهُمْ أَخُوهُمْ هُودٌ أَلَا تَتَّ<p>قُو</>نَ"},{"n":125,"w":[["إِنِّى","innī","Indeed, I am","নিশ্চয়ই আমি"],["لَكُمْ","lakum","to you","জন্যে তোমাদের"],["رَسُولٌ","rasūlun","a Messenger","একজন রাসূল"],["أَمِينٌۭ","amīnun","trustworthy","বিশ্বস্ত"]],"t":"إِ<g>نِّ</>ى لَكُمْ رَسُولٌ أَ<p>مِي</>نٌۭ"},{"n":126,"w":[["فَٱتَّقُوا۟","fa-ittaqū","So fear","অতএব তোমরা ভয় করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["وَأَطِيعُونِ","wa-aṭī‘ūni","and obey me","ও তোমরা আমার আনুগত্য করো"]],"t":"فَ<h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</>للَّهَ وَأَطِي<p>عُو</>نِ"},{"n":127,"w":[["وَمَآ","wamā","And not","আর না"],["أَسْـَٔلُكُمْ","asalukum","I ask you","তোমাদের (নিকট) আমি চাচ্ছি"],["عَلَيْهِ","‘alayhi","for it","জন্যে এর"],["مِنْ","min","any","কোনো"],["أَجْرٍ ۖ","ajrin","payment","প্রতিদান"],["إِنْ","in","Not","নেই"],["أَجْرِىَ","ajriya","(is) my payment","আমার প্রতিদান (অন্য কারো নিকট)"],["إِلَّا","illā","except","ছাড়া"],["عَلَىٰ","‘alā","from","নিকট"],["رَبِّ","rabbi","(the) Lord","রবের"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","(of) the worlds","বিশ্বজগতের"]],"t":"وَ<o>مَآ</> أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَ<q>جْ</>رٍ ۖ إِنْ أَ<q>جْ</>رِىَ إِلَّا عَلَىٰ رَبِّ <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":128,"w":[["أَتَبْنُونَ","atabnūna","Do you construct","কি তোমরা নির্মাণ করছো"],["بِكُلِّ","bikulli","on every","স্হানে প্রত্যক"],["رِيعٍ","rī‘in","elevation","উঁচু"],["ءَايَةًۭ","āyatan","a sign","(স্মৃতিচিহ্ন) নিদর্শন"],["تَعْبَثُونَ","ta‘bathūna","amusing yourselves","তোমরা নিরর্থক কাজ করছো"]],"t":"أَتَ<q>بْ</>نُونَ بِكُلِّ رِيعٍ ءَايَ<k>ةًۭ تَ</>عْبَ<p>ثُو</>نَ"},{"n":129,"w":[["وَتَتَّخِذُونَ","watattakhidhūna","And take for yourselves","ও তোমরা তৈরী করছো"],["مَصَانِعَ","maṣāni‘a","strongholds","প্রাসাদ"],["لَعَلَّكُمْ","la‘allakum","that you may","যেন তোমরা"],["تَخْلُدُونَ","takhludūna","live forever","চিরস্থায়ী হবে"]],"t":"وَتَتَّخِذُونَ مَصَانِعَ لَعَلَّكُمْ تَخْلُ<p>دُو</>نَ"},{"n":130,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["بَطَشْتُم","baṭashtum","you seize","তোমরা আঘাত করো"],["بَطَشْتُمْ","baṭashtum","you seize","তোমরা আঘাত করো"],["جَبَّارِينَ","jabbārīna","(as) tyrants","স্বেচ্ছাচারী হয়ে"]],"t":"وَإِذَا بَطَشْ<f>تُم بَ</>طَشْتُمْ جَبَّا<p>رِي</>نَ"},{"n":131,"w":[["فَٱتَّقُوا۟","fa-ittaqū","So fear","অতএব তোমরা ভয় করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["وَأَطِيعُونِ","wa-aṭī‘ūni","and obey me","এবং তোমরা আমার আনুগত্য করো"]],"t":"فَ<h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</>للَّهَ وَأَطِي<p>عُو</>نِ"},{"n":132,"w":[["وَٱتَّقُوا۟","wa-ittaqū","And fear","এবং তোমরা ভয় করো"],["ٱلَّذِىٓ","alladhī","the One Who","(তাকে) যিনি"],["أَمَدَّكُم","amaddakum","has aided you","সাহায্য করেছেন তোমাদেরকে"],["بِمَا","bimā","with what","যা কিছু(তা)"],["تَعْلَمُونَ","ta‘lamūna","you know","তোমরা জানো"]],"t":"وَ<h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</>لَّ<o>ذِىٓ</> أَمَدَّ<f>كُم بِ</>مَا تَعْلَ<p>مُو</>نَ"},{"n":133,"w":[["أَمَدَّكُم","amaddakum","He has aided you","সাহায্য করেছেন তোমাদেরকে"],["بِأَنْعَـٰمٍۢ","bi-an‘āmin","with cattle","দিয়ে গবাদিপশু"],["وَبَنِينَ","wabanīna","and children","ও সন্তান সন্তুতি"]],"t":"أَمَدَّ<f>كُم بِ</>أَنْ<m>عَٰ</><d>مٍۢ وَ</>بَ<p>نِي</>نَ"},{"n":134,"w":[["وَجَنَّـٰتٍۢ","wajannātin","And gardens","এবং বাগান"],["وَعُيُونٍ","wa‘uyūnin","and springs","ও ঝর্ণাসমূহ (দিয়ে)"]],"t":"وَجَ<g>نَّٰ</><d>تٍۢ وَ</>عُ<p>يُو</>نٍ"},{"n":135,"w":[["إِنِّىٓ","innī","Indeed, I","নিশ্চয়ই আমি"],["أَخَافُ","akhāfu","[I] fear","আশংকা করছি"],["عَلَيْكُمْ","‘alaykum","for you","উপর তোমাদের"],["عَذَابَ","‘adhāba","(the) punishment","শাস্তির"],["يَوْمٍ","yawmin","(of) a Day","দিনের"],["عَظِيمٍۢ","‘aẓīmin","Great","মহা\""]],"t":"إِ<g>نِّ</><o>ىٓ</> أَخَافُ عَلَيْكُمْ عَذَابَ يَوْمٍ عَ<p>ظِي</>مٍۢ"},{"n":136,"w":[["قَالُوا۟","qālū","They said","তারা বললো"],["سَوَآءٌ","sawāon","(It is) same","\"সমান"],["عَلَيْنَآ","‘alaynā","to us","জন্যে আমাদের"],["أَوَعَظْتَ","awa‘aẓta","whether you advise","কি তুমি উপদেশ দাও"],["أَمْ","am","or","অথবা"],["لَمْ","lam","not","না-ই"],["تَكُن","takun","you are","তুমি হও"],["مِّنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْوَٰعِظِينَ","l-wā‘iẓīna","the advisors","উপদেশকারীদের"]],"t":"قَالُو<s>ا۟</> سَ<o>وَآ</>ءٌ عَلَيْ<o>نَآ</> أَوَعَظْتَ أَمْ لَمْ تَ<d>كُن مِّ</>نَ <h>ٱ</>لْ<m>وَٰ</>عِ<p>ظِي</>نَ"},{"n":137,"w":[["إِنْ","in","Not","নয়"],["هَـٰذَآ","hādhā","(is) this","এটা"],["إِلَّا","illā","but","এ ছাড়া যে"],["خُلُقُ","khuluqu","(the) custom","স্বভাব"],["ٱلْأَوَّلِينَ","l-awalīna","(of) the former (people)","পুর্ববর্তীদের"]],"t":"إِنْ <m>هَٰ</><o>ذَآ</> إِلَّا خُلُقُ <h>ٱ</>لْأَوَّ<p>لِي</>نَ"},{"n":138,"w":[["وَمَا","wamā","And not","আর না"],["نَحْنُ","naḥnu","we","আমরা"],["بِمُعَذَّبِينَ","bimu‘adhabīna","(are) the ones to be punished","শাস্তিপ্রাপ্ত হবো\""]],"t":"وَمَا نَحْنُ بِمُعَذَّ<p>بِي</>نَ"},{"n":139,"w":[["فَكَذَّبُوهُ","fakadhabūhu","So they denied him","তারা তাকে মিথ্যা সাব্যস্ত করলো"],["فَأَهْلَكْنَـٰهُمْ ۗ","fa-ahlaknāhum","then We destroyed them","তখন আমরা ধ্বংস করলাম তাদেরকে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে (আছে)"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَةًۭ ۖ","laāyatan","surely, is a sign","অবশ্যই নিদর্শন"],["وَمَا","wamā","but not","কিন্তু না"],["كَانَ","kāna","are","ছিলো"],["أَكْثَرُهُم","aktharuhum","most of them","অধিকাংশ তাদের"],["مُّؤْمِنِينَ","mu'minīna","believers","মু'মিন"]],"t":"فَكَذَّبُوهُ فَأَهْلَكْ<m>نَٰ</>هُمْ ۗ إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَايَ<d>ةًۭ ۖ وَ</>مَا كَانَ أَكْثَرُ<y>هُم مُّ</>ؤْمِ<p>نِي</>نَ"},{"n":140,"w":[["وَإِنَّ","wa-inna","And indeed","আর নিশ্চয়ই"],["رَبَّكَ","rabbaka","your Lord","তোমার রব"],["لَهُوَ","lahuwa","surely, He","অবশ্যই তিনি"],["ٱلْعَزِيزُ","l-‘azīzu","(is) the All-Mighty","পরাক্রমশালী"],["ٱلرَّحِيمُ","l-raḥīmu","the Most Merciful","পরম দয়ালু"]],"t":"وَإِ<g>نَّ</> رَبَّكَ لَهُوَ <h>ٱ</>لْعَزِيزُ <h>ٱ</><l>ل</>رَّ<p>حِي</>مُ"},{"n":141,"w":[["كَذَّبَتْ","kadhabat","Denied","মিথ্যারোপ করেছিলো"],["ثَمُودُ","thamūdu","Thamud","সামূদ জাতি"],["ٱلْمُرْسَلِينَ","l-mur'salīna","the Messengers","রাসূলদেরকে"]],"t":"كَذَّبَتْ ثَمُودُ <h>ٱ</>لْمُرْسَ<p>لِي</>نَ"},{"n":142,"w":[["إِذْ","idh","When","(স্মরণ করো) যখন"],["قَالَ","qāla","said","বলেছিলো"],["لَهُمْ","lahum","to them","উদ্দেশ্যে তাদের"],["أَخُوهُمْ","akhūhum","their brother","ভাই তাদের"],["صَـٰلِحٌ","ṣāliḥun","Salih","সালেহ"],["أَلَا","alā","Will not","\"কি না"],["تَتَّقُونَ","tattaqūna","you fear (A