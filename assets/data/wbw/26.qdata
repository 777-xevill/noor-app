{"n":26,"a":[{"n":1,"w":[["طسٓمٓ","tta-seen-meem","Ta Seem Meem","ত্বা-সীন-মীম"]],"t":"ط<n>سٓمٓ</>"},{"n":2,"w":[["تِلْكَ","til'ka","These","এই"],["ءَايَـٰتُ","āyātu","(are the) Verses","আয়াতগুলো"],["ٱلْكِتَـٰبِ","l-kitābi","(of) the Book","কিতাবের"],["ٱلْمُبِينِ","l-mubīni","clear","(যা) সুস্পষ্ট"]],"t":"تِلْكَ ءَا<m>يَٰ</>تُ <h>ٱ</>لْكِ<m>تَٰ</>بِ <h>ٱ</>لْمُ<p>بِي</>نِ"},{"n":3,"w":[["لَعَلَّكَ","la‘allaka","Perhaps you","হয়তো তুমি (হে নাবী)"],["بَـٰخِعٌۭ","bākhi‘un","(would) kill","ধ্বংসকারী"],["نَّفْسَكَ","nafsaka","yourself","তোমার প্রাণ (এ চিন্তায়)"],["أَلَّا","allā","that not","যে না"],["يَكُونُوا۟","yakūnū","they become","তারা হচ্ছে"],["مُؤْمِنِينَ","mu'minīna","believers","মু'মিন"]],"t":"لَعَلَّكَ <m>بَٰ</>خِ<d>عٌۭ نَّ</>فْسَكَ أَلَّا يَكُونُو<s>ا۟</> مُؤْمِ<p>نِي</>نَ"},{"n":4,"w":[["إِن","in","If","যদি"],["نَّشَأْ","nasha","We will","আমরা চাইতাম"],["نُنَزِّلْ","nunazzil","We can send down","অবতীর্ণ করতাম আমরা"],["عَلَيْهِم","‘alayhim","to them","উপর তাদের"],["مِّنَ","mina","from","হ'তে"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশ"],["ءَايَةًۭ","āyatan","a Sign","(এমন) কোনো নিদর্শন"],["فَظَلَّتْ","faẓallat","so would bend","ফলে হয়ে পড়তো"],["أَعْنَـٰقُهُمْ","a‘nāquhum","their necks","ঘাড়গুলো তাদের"],["لَهَا","lahā","to it","প্রতি তাঁর"],["خَـٰضِعِينَ","khāḍi‘īna","(in) humility","অবনত"]],"t":"<d>إِن نَّ</>شَأْ نُنَزِّلْ عَلَيْ<y>هِم مِّ</>نَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ ءَايَ<k>ةًۭ فَ</>ظَلَّتْ أَعْ<m>نَٰ</>قُهُمْ لَهَا <m>خَٰ</>ضِ<p>عِي</>نَ"},{"n":5,"w":[["وَمَا","wamā","And (does) not","এবং না"],["يَأْتِيهِم","yatīhim","come to them","আসে তাদের (কাছে)"],["مِّن","min","any","কোনো"],["ذِكْرٍۢ","dhik'rin","reminder","উপদেশ"],["مِّنَ","mina","from","হ'তে"],["ٱلرَّحْمَـٰنِ","l-raḥmāni","the Most Gracious","দয়াময়"],["مُحْدَثٍ","muḥ'dathin","new","(উপদেশ) নতুন"],["إِلَّا","illā","but","এ ছাড়া যে"],["كَانُوا۟","kānū","they","তারা ছিলো"],["عَنْهُ","‘anhu","from it","তা হতে"],["مُعْرِضِينَ","mu‘'riḍīna","turn away","মুখ ফিরিয়ে নিতো"]],"t":"وَمَا يَأْتِي<y>هِم مِّ</><k>ن ذِ</>كْ<d>رٍۢ مِّ</>نَ <h>ٱ</><l>ل</>رَّحْ<m>مَٰ</>نِ مُحْدَثٍ إِلَّا كَانُو<s>ا۟</> عَنْهُ مُعْرِ<p>ضِي</>نَ"},{"n":6,"w":[["فَقَدْ","faqad","So verily","এখন নিশ্চয়ই"],["كَذَّبُوا۟","kadhabū","they have denied","তারা মিথ্যারোপ করেছে"],["فَسَيَأْتِيهِمْ","fasayatīhim","then will come to them","সুতরাং শীঘ্রই আসবে তাদের (কাছে)"],["أَنۢبَـٰٓؤُا۟","anbāu","the news","সংবাদ"],["مَا","mā","(of) what","যা কিছু"],["كَانُوا۟","kānū","they used","তারা ছিলো"],["بِهِۦ","bihi","at it","সম্পর্কে সে"],["يَسْتَهْزِءُونَ","yastahziūna","(to) mock","ঠাট্টা-বিদ্রুপ করতো"]],"t":"فَقَ<q>دْ</> كَذَّبُو<s>ا۟</> فَسَيَأْتِيهِمْ أَ<i>نۢبَٰٓ</>ؤُ<s>ا۟</> مَا كَانُو<s>ا۟</> بِ<m>هِۦ</> يَسْتَهْزِ<p>ءُو</>نَ"},{"n":7,"w":[["أَوَلَمْ","awalam","Do not","কি নি"],["يَرَوْا۟","yaraw","they see","তারা লক্ষ্য করে"],["إِلَى","ilā","at","প্রতি"],["ٱلْأَرْضِ","l-arḍi","the earth ","পৃথিবীর"],["كَمْ","kam","how many","কত (বিপুল পরিমাণ)"],["أَنۢبَتْنَا","anbatnā","We produced","উদ্গত করেছি আমরা"],["فِيهَا","fīhā","in it","মধ্যে তার"],["مِن","min","of","থেকে"],["كُلِّ","kulli","every","প্রত্যেক"],["زَوْجٍۢ","zawjin","kind","প্রকার (উদ্ভিদ)"],["كَرِيمٍ","karīmin","noble","চমৎকার"]],"t":"أَوَلَمْ يَرَوْ<s>ا۟</> إِلَى <h>ٱ</>لْأَرْضِ كَمْ أَ<i>نۢبَ</>تْنَا فِيهَا مِ<k>ن كُ</>لِّ زَوْ<k>جٍۢ كَ</><p>رِي</>مٍ"},{"n":8,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে (রয়েছে)"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَةًۭ ۖ","laāyatan","surely (is) a sign","অবশ্যই নিদর্শন"],["وَمَا","wamā","but not","কিন্তু না"],["كَانَ","kāna","are","ছিলো"],["أَكْثَرُهُم","aktharuhum","most of them","অধিকাংশ তাদের"],["مُّؤْمِنِينَ","mu'minīna","believers","মু'মিন"]],"t":"إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَايَ<d>ةًۭ ۖ وَ</>مَا كَانَ أَكْثَرُ<y>هُم مُّ</>ؤْمِ<p>نِي</>نَ"},{"n":9,"w":[["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["رَبَّكَ","rabbaka","your Lord","তোমার রব"],["لَهُوَ","lahuwa","surely, He","অবশ্যই তিনি"],["ٱلْعَزِيزُ","l-‘azīzu","(is) the All-Mighty","পরাক্রমশালী"],["ٱلرَّحِيمُ","l-raḥīmu","the Most Merciful","পরম দয়ালুও"]],"t":"وَإِ<g>نَّ</> رَبَّكَ لَهُوَ <h>ٱ</>لْعَزِيزُ <h>ٱ</><l>ل</>رَّ<p>حِي</>مُ"},{"n":10,"w":[["وَإِذْ","wa-idh","And when","এবং (স্মরণ করো) যখন"],["نَادَىٰ","nādā","your Lord called","ডেকেছিলেন"],["رَبُّكَ","rabbuka","your Lord called","তোমার রব"],["مُوسَىٰٓ","mūsā","Musa","মূসাকে"],["أَنِ","ani","[that]","যে"],["ٱئْتِ","i'ti","Go","\"যাও তুমি"],["ٱلْقَوْمَ","l-qawma","(to) the people","জাতির (নিকট)"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","(who are) wrongdoers","সীমালঙ্ঘনকারী"]],"t":"وَإِذْ نَادَىٰ رَبُّكَ مُوسَ<o>ىٰٓ</> أَنِ <h>ٱ</>ئْتِ <h>ٱ</>لْقَوْمَ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":11,"w":[["قَوْمَ","qawma","(The) people","জাতি"],["فِرْعَوْنَ ۚ","fir'‘awna","(of) Firaun","ফিরআউনের"],["أَلَا","alā","Will not","কি না"],["يَتَّقُونَ","yattaqūna","they fear","তারা ভয় করে\""]],"t":"قَوْمَ فِرْعَوْنَ ۚ أَلَا يَتَّ<p>قُو</>نَ"},{"n":12,"w":[["قَالَ","qāla","He said","(মূসা) বললো"],["رَبِّ","rabbi","My Lord","\"হে আমার রব"],["إِنِّىٓ","innī","Indeed, I","নিশ্চয়ই আমি"],["أَخَافُ","akhāfu","[I] fear","আমি আশংকা করছি"],["أَن","an","that","যে"],["يُكَذِّبُونِ","yukadhibūni","they will deny me","মিথ্যাবাদী বলবে তারা আমাকে"]],"t":"قَالَ رَبِّ إِ<g>نِّ</><o>ىٓ</> أَخَافُ <d>أَن يُ</>كَذِّ<p>بُو</>نِ"},{"n":13,"w":[["وَيَضِيقُ","wayaḍīqu","And straitens","এবং সংকুচিত হচ্ছে"],["صَدْرِى","ṣadrī","my breast","আমার অন্তর"],["وَلَا","walā","and not","আর না"],["يَنطَلِقُ","yanṭaliqu","expresses well","অগ্রসর হয়"],["لِسَانِى","lisānī","my tongue","জিহবা আমার"],["فَأَرْسِلْ","fa-arsil","so send","সুতরাং আপনি পাঠান (ওহি)"],["إِلَىٰ","ilā","for","প্রতিও"],["هَـٰرُونَ","hārūna","Harun","হারূনের"]],"t":"وَيَضِيقُ صَ<q>دْ</>رِى وَلَا يَ<k>نطَ</>لِقُ لِسَانِى فَأَرْسِلْ إِلَىٰ <m>هَٰ</><p>رُو</>نَ"},{"n":14,"w":[["وَلَهُمْ","walahum","And they have","এবং আছে তাদের"],["عَلَىَّ","‘alayya","against me","বিরুদ্ধে আমার"],["ذَنۢبٌۭ","dhanbun","a crime","(অপরাধের) অভিযোগ"],["فَأَخَافُ","fa-akhāfu","so I fear","তাই আমি আশংকা করছি"],["أَن","an","that","যে"],["يَقْتُلُونِ","yaqtulūni","they will kill me","আমাকে তারা হত্যা করবে\""]],"t":"وَلَهُمْ عَلَىَّ ذَ<i>نۢبٌۭ</><k> فَ</>أَخَافُ <d>أَن يَ</><q>قْ</>تُ<p>لُو</>نِ"},{"n":15,"w":[["قَالَ","qāla","He said","(আল্লাহ) বললেন"],["كَلَّا ۖ","kallā","Nay","\"কখনও না (তারা পারবে)"],["فَٱذْهَبَا","fa-idh'habā","go both of you","অতএব তোমরা দু'জনে যাও"],["بِـَٔايَـٰتِنَآ ۖ","biāyātinā","with Our Signs","নিয়ে নিদর্শনাবলী আমাদের"],["إِنَّا","innā","Indeed, We","নিশ্চয়ই আমরা"],["مَعَكُم","ma‘akum","(are) with you","সাথে তোমাদের (আছি)"],["مُّسْتَمِعُونَ","mus'tami‘ūna","listening","(সদা সর্বদা)শ্রবণকারী"]],"t":"قَالَ كَلَّا ۖ فَ<h>ٱ</>ذْهَبَا بِـَٔا<m>يَٰ</>تِ<o>نَآ ۖ</> إِ<g>نَّ</>ا مَعَ<y>كُم مُّ</>سْتَمِ<p>عُو</>نَ"},{"n":16,"w":[["فَأْتِيَا","fatiyā","So go both of you","সুতরাং দু'জনে যাও"],["فِرْعَوْنَ","fir'‘awna","(to) Firaun","ফিরআউনের (নিকট)"],["فَقُولَآ","faqūlā","and say","অতঃপর দু'জনে বলো"],["إِنَّا","innā","'Indeed, we","নিশ্চয়ই আমরা"],["رَسُولُ","rasūlu","(are the) Messenger","রাসূল"],["رَبِّ","rabbi","(of the) Lord","রবের"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","(of) the worlds","বিশ্বজগতের"]],"t":"فَأْتِيَا فِرْعَوْنَ فَقُو<o>لَآ</> إِ<g>نَّ</>ا رَسُولُ رَبِّ <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":17,"w":[["أَنْ","an","[That]","(আরও বলো) যে"],["أَرْسِلْ","arsil","send","পাঠাও"],["مَعَنَا","ma‘anā","with us","সাথে আমাদের"],["بَنِىٓ","banī","(the) Children of Israel.'","বনী"],["إِسْرَٰٓءِيلَ","is'rāīla","(the) Children of Israel.'","ইসরাঈলকে"]],"t":"أَنْ أَرْسِلْ مَعَنَا بَ<o>نِىٓ</> إِسْ<o>رَٰٓ</><p>ءِي</>لَ"},{"n":18,"w":[["قَالَ","qāla","He said","(ফিরআউন) বললো"],["أَلَمْ","alam","Did not","\"কি নি"],["نُرَبِّكَ","nurabbika","we bring you up","আমরা তোমাকে প্রতিপালন করি"],["فِينَا","fīnā","among us","মাঝে আমাদের"],["وَلِيدًۭا","walīdan","(as) a child","শৈশবে"],["وَلَبِثْتَ","walabith'ta","and you remained","এবং তুমি কাটিয়েছো"],["فِينَا","fīnā","among us","মাঝে আমাদের"],["مِنْ","min","of","থেকে"],["عُمُرِكَ","‘umurika","your life","জীবনের তোমার"],["سِنِينَ","sinīna","years","(কয়েকটি) বছর"]],"t":"قَالَ أَلَمْ نُرَبِّكَ فِينَا وَلِي<d>دًۭا وَ</>لَبِثْتَ فِينَا مِنْ عُمُرِكَ سِ<p>نِي</>نَ"},{"n":19,"w":[["وَفَعَلْتَ","wafa‘alta","And you did","এবং তুমি করেছো"],["فَعْلَتَكَ","fa‘lataka","your deed","কর্ম তোমার"],["ٱلَّتِى","allatī","which","যা কিছু"],["فَعَلْتَ","fa‘alta","you did","তুমি করেছো"],["وَأَنتَ","wa-anta","and you","আর তুমি"],["مِنَ","mina","(were) of","অন্তর্ভূক্ত"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","the ungrateful","অকৃতজ্ঞদের\""]],"t":"وَفَعَلْتَ فَعْلَتَكَ <h>ٱ</>لَّتِى فَعَلْتَ وَأَ<k>نتَ</> مِنَ <h>ٱ</>لْ<m>كَٰ</>فِ<p>رِي</>نَ"},{"n":20,"w":[["قَالَ","qāla","He said","(মূসা) বললো"],["فَعَلْتُهَآ","fa‘altuhā","I did it","\"তা আমি করেছিলাম"],["إِذًۭا","idhan","when","তখন (সে সময়)"],["وَأَنَا۠","wa-anā","I","যখন আমি (ছিলাম)"],["مِنَ","mina","(was) of","অন্তর্ভূক্ত"],["ٱلضَّآلِّينَ","l-ḍālīna","those who are astray","পথভ্রষ্টদের"]],"t":"قَالَ فَعَلْتُ<o>هَآ</> إِ<d>ذًۭا وَ</>أَنَا۠ مِنَ <h>ٱ</><l>ل</><n>ضَّآ</><p>لِّي</>نَ"},{"n":21,"w":[["فَفَرَرْتُ","fafarartu","So I fled","অতঃপর আমি পালিয়ে গেলাম"],["مِنكُمْ","minkum","from you","হ'তে তোমাদের"],["لَمَّا","lammā","when","যখন"],["خِفْتُكُمْ","khif'tukum","I feared you","ভয় করেছিলাম তোমাদেরকে"],["فَوَهَبَ","fawahaba","But granted","অতঃপর দান করলেন"],["لِى","lī","to me","জন্যে আমার"],["رَبِّى","rabbī","my Lord","আমার রব"],["حُكْمًۭا","ḥuk'man","judgment","প্রজ্ঞা"],["وَجَعَلَنِى","waja‘alanī","and made me","এবং আমাকে করলেন"],["مِنَ","mina","of","অন্তর্ভূক্ত"],["ٱلْمُرْسَلِينَ","l-mur'salīna","the Messengers","রাসূলদের"]],"t":"فَفَرَرْتُ مِ<k>نكُ</>مْ لَ<g>مَّ</>ا خِفْتُكُمْ فَوَهَبَ لِى رَبِّى حُكْ<d>مًۭا وَ</>جَعَلَنِى مِنَ <h>ٱ</>لْمُرْسَ<p>لِي</>نَ"},{"n":22,"w":[["وَتِلْكَ","watil'ka","And this","আর ঐ"],["نِعْمَةٌۭ","ni‘'matun","(is the) favor","অনুগ্রহ"],["تَمُنُّهَا","tamunnuhā","with which you reproach","যা তুমি দয়া দেখাচ্ছো"],["عَلَىَّ","‘alayya","[on] me","আমার উপর (তা কি)"],["أَنْ","an","that","(এ নয়) যে"],["عَبَّدتَّ","‘abbadtta","you have enslaved","তুমি দাস বানিয়ে রেখেছো"],["بَنِىٓ","banī","(the) Children of Israel","বনী\""],["إِسْرَٰٓءِيلَ","is'rāīla","(the) Children of Israel","ইসরাঈলকে\""]],"t":"وَتِلْكَ نِعْمَ<k>ةٌۭ تَ</>مُ<g>نُّ</>هَا عَلَىَّ أَنْ عَبَّ<j>د</>تَّ بَ<o>نِىٓ</> إِسْ<o>رَٰٓ</><p>ءِي</>لَ"},{"n":23,"w":[["قَالَ","qāla","Firaun said","বললো"],["فِرْعَوْنُ","fir'‘awnu","Firaun said","ফিরআউন"],["وَمَا","wamā","And what","\"আবার কি (কে)"],["رَبُّ","rabbu","(is the) Lord","রব"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","(of) the worlds","বিশ্বজগতের\""]],"t":"قَالَ فِرْعَوْنُ وَمَا رَبُّ <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":24,"w":[["قَالَ","qāla","He said","(মূসা) বললো"],["رَبُّ","rabbu","Lord","\"রব"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশমন্ডলীর"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীর"],["وَمَا","wamā","and whatever","এবং যা কিছু (আছে)"],["بَيْنَهُمَآ ۖ","baynahumā","(is) between them","উভয়ের মাঝে তাদের"],["إِن","in","if","যদি"],["كُنتُم","kuntum","you (should) be","হও তোমরা"],["مُّوقِنِينَ","mūqinīna","convinced","দৃঢ় বিশ্বাসী\""]],"t":"قَالَ رَبُّ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ وَمَا بَيْنَهُ<o>مَآ ۖ</> إِ<k>ن كُنتُ</><y>م مُّ</>وقِ<p>نِي</>نَ"},{"n":25,"w":[["قَالَ","qāla","He said","(ফিরআউন) বললো"],["لِمَنْ","liman","to those","তাদেরকে (যারা ছিলো)"],["حَوْلَهُۥٓ","ḥawlahu","around him","চারপাশে তার"],["أَلَا","alā","Do not","\"কি না"],["تَسْتَمِعُونَ","tastami‘ūna","you hear","তোমরা শুনছো\""]],"t":"قَالَ لِمَنْ حَوْلَهُ<o>ۥٓ</> أَلَا تَسْتَمِ<p>عُو</>نَ"},{"n":26,"w":[["قَالَ","qāla","He said","(মূসা) বললো"],["رَبُّكُمْ","rabbukum","Your Lord","\"রব তোমাদের"],["وَرَبُّ","warabbu","and (the) Lord","ও রব"],["ءَابَآئِكُمُ","ābāikumu","(of) your forefathers","পিতৃ-পুরুষদেরও তোমাদের\""],["ٱلْأَوَّلِينَ","l-awalīna","(of) your forefathers","পূর্ববর্তী\""]],"t":"قَالَ رَبُّكُمْ وَرَبُّ ءَا<o>بَآ</>ئِكُمُ <h>ٱ</>لْأَوَّ<p>لِي</>نَ"},{"n":27,"w":[["قَالَ","qāla","He said","(ফিরআউন) বললো"],["إِنَّ","inna","Indeed","\"নিশ্চয়ই"],["رَسُولَكُمُ","rasūlakumu","your Messenger","রাসূল তোমাদের"],["ٱلَّذِىٓ","alladhī","who","যাকে"],["أُرْسِلَ","ur'sila","has been sent","পাঠানো হয়েছে"],["إِلَيْكُمْ","ilaykum","to you","প্রতি তোমাদের"],["لَمَجْنُونٌۭ","lamajnūnun","(is) surely mad","অবশ্যই পাগল\""]],"t":"قَالَ إِ<g>نَّ</> رَسُولَكُمُ <h>ٱ</>لَّ<o>ذِىٓ</> أُرْسِلَ إِلَيْكُمْ لَمَ<q>جْ</><p>نُو</>نٌۭ"},{"n":28,"w":[["قَالَ","qāla","He said","(মূসা) বললো"],["رَبُّ","rabbu","Lord","\"(তিনি তো) রব"],["ٱلْمَشْرِقِ","l-mashriqi","(of) the east","পূর্বের"],["وَٱلْمَغْرِبِ","wal-maghribi","and the west","এবং পশ্চিমের"],["وَمَا","wamā","and whatever","এবং যা কিছু (আছে)"],["بَيْنَهُمَآ ۖ","baynahumā","(is) between them","উভয়ের মাঝে তাদের"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you were","তোমরা থাকো"],["تَعْقِلُونَ","ta‘qilūna","(to) reason","তোমরা বুঝো\""]],"t":"قَالَ رَبُّ <h>ٱ</>لْمَشْرِقِ وَ<h>ٱ</>لْمَغْرِبِ وَمَا بَيْنَهُ<o>مَآ ۖ</> إِ<k>ن كُنتُ</>مْ تَعْقِ<p>لُو</>نَ"},{"n":29,"w":[["قَالَ","qāla","He said","(ফিরআউন) বললো"],["لَئِنِ","la-ini","If","\"অবশ্যই যদি"],["ٱتَّخَذْتَ","ittakhadhta","you take","তুমি গ্রহণ করো"],["إِلَـٰهًا","ilāhan","a god","(অন্যকে) ইলাহরূপে"],["غَيْرِى","ghayrī","other than me","ছাড়া আমাকে"],["لَأَجْعَلَنَّكَ","la-aj‘alannaka","I will surely make you","অবশ্যই আমি তোমাকে করবোই"],["مِنَ","mina","among","অন্তর্ভূক্ত"],["ٱلْمَسْجُونِينَ","l-masjūnīna","those imprisoned","কারারুদ্ধদের\""]],"t":"قَالَ لَئِنِ <h>ٱ</>تَّخَذْتَ إِ<m>لَٰ</>هًا غَيْرِى لَأَ<q>جْ</>عَلَ<g>نَّ</>كَ مِنَ <h>ٱ</>لْمَسْجُو<p>نِي</>نَ"},{"n":30,"w":[["قَالَ","qāla","He said","(মূসা) বললো"],["أَوَلَوْ","awalaw","Even if","\"কি যদিও"],["جِئْتُكَ","ji'tuka","I bring you","তোমাদের (কাছে) আসি আমি"],["بِشَىْءٍۢ","bishayin","something","নিয়ে এক বস্তু (নিদর্শন)"],["مُّبِينٍۢ","mubīnin","manifest","সুস্পষ্ট (তবুও)\""]],"t":"قَالَ أَوَلَوْ جِئْتُكَ بِ<d>شَىْءٍۢ مُّ</><p>بِي</>نٍۢ"},{"n":31,"w":[["قَالَ","qāla","He said","(ফিরআউন) বললো"],["فَأْتِ","fati","Then bring","\"তবে আসো"],["بِهِۦٓ","bihi","it","নিয়ে তা"],["إِن","in","if","যদি"],["كُنتَ","kunta","you are","তুমি হও"],["مِنَ","mina","of","অন্তর্ভূক্ত"],["ٱلصَّـٰدِقِينَ","l-ṣādiqīna","the truthful","সত্যবাদীদের\""]],"t":"قَالَ فَأْتِ بِ<o>هِۦٓ</> إِ<k>ن كُنتَ</> مِنَ <h>ٱ</><l>ل</><m>صَّٰ</>دِ<p>قِي</>نَ"},{"n":32,"w":[["فَأَلْقَىٰ","fa-alqā","So he threw","অতঃপর সে ছুঁড়ে ফেললো"],["عَصَاهُ","‘aṣāhu","his staff","লাঠি তাঁর"],["فَإِذَا","fa-idhā","and behold","তখনই"],["هِىَ","hiya","It","তা (হয়ে গেলো)"],["ثُعْبَانٌۭ","thu‘'bānun","(was) a serpent","অজগর"],["مُّبِينٌۭ","mubīnun","manifest","সুস্পষ্ট"]],"t":"فَأَلْقَىٰ عَصَاهُ فَإِذَا هِىَ ثُعْبَا<d>نٌۭ مُّ</><p>بِي</>نٌۭ"},{"n":33,"w":[["وَنَزَعَ","wanaza‘a","And he drew out","এবং টেনে বের করলো (বগল হ'তে)"],["يَدَهُۥ","yadahu","his hand","হাত তাঁর"],["فَإِذَا","fa-idhā","and behold","তখনই"],["هِىَ","hiya","It","তা (হয়ে গেলো)"],["بَيْضَآءُ","bayḍāu","(was) white","শুভ্র উজ্জ্বল"],["لِلنَّـٰظِرِينَ","lilnnāẓirīna","for the observers","জন্যে দর্শকদের"]],"t":"وَنَزَعَ يَدَهُ<m>ۥ</> فَإِذَا هِىَ بَيْ<o>ضَآ</>ءُ لِل<g>نَّٰ</>ظِ<p>رِي</>نَ"},{"n":34,"w":[["قَالَ","qāla","He said","(ফিরআউন) বললো"],["لِلْمَلَإِ","lil'mala-i","to the chiefs","সভাষদদের"],["حَوْلَهُۥٓ","ḥawlahu","around him","চারপাশের তার"],["إِنَّ","inna","Indeed","\"নিশ্চয়ই"],["هَـٰذَا","hādhā","this","এতো"],["لَسَـٰحِرٌ","lasāḥirun","(is) surely a magician","অবশ্যই জাদুকর"],["عَلِيمٌۭ","‘alīmun","learned","সূদক্ষ"]],"t":"قَالَ لِلْمَلَإِ حَوْلَهُ<o>ۥٓ</> إِ<g>نَّ</> <m>هَٰ</>ذَا لَ<m>سَٰ</>حِرٌ عَ<p>لِي</>مٌۭ"},{"n":35,"w":[["يُرِيدُ","yurīdu","He wants","সে চায়"],["أَن","an","to","যে"],["يُخْرِجَكُم","yukh'rijakum","drive you out","সে বের করবে তোমাদেরকে"],["مِّنْ","min","from","হ'তে"],["أَرْضِكُم","arḍikum","your land","দেশ তোমাদের"],["بِسِحْرِهِۦ","bisiḥ'rihi","by his magic","সাহায্যে তাঁর জাদুর"],["فَمَاذَا","famādhā","so what","অতঃপর কি"],["تَأْمُرُونَ","tamurūna","(do) you advise","তোমরা পরামর্শ দিচ্ছো\""]],"t":"يُرِيدُ <d>أَن يُ</>خْرِجَ<y>كُم مِّ</>نْ أَرْضِ<f>كُم بِ</>سِحْرِ<m>هِۦ</> فَمَاذَا تَأْمُ<p>رُو</>نَ"},{"n":36,"w":[["قَالُوٓا۟","qālū","They said","তারা বললো"],["أَرْجِهْ","arjih","Postpone him","\"তাঁর (ব্যাপার) স্থগিত রাখুন"],["وَأَخَاهُ","wa-akhāhu","and his brother","ও তাঁর ভায়ের (ব্যাপারে)"],["وَٱبْعَثْ","wa-ib'‘ath","and send","এবং পাঠিয়ে দিন"],["فِى","fī","in","মধ্যে"],["ٱلْمَدَآئِنِ","l-madāini","the cities","শহরে শহরে"],["حَـٰشِرِينَ","ḥāshirīna","gatherers ","সংগ্রহকারীদেরকে"]],"t":"قَا<o>لُوٓ</><s>ا۟</> أَرْجِهْ وَأَخَاهُ وَ<h>ٱ</><q>بْ</>عَثْ فِى <h>ٱ</>لْمَ<o>دَآ</>ئِنِ <m>حَٰ</>شِ<p>رِي</>نَ"},{"n":37,"w":[["يَأْتُوكَ","yatūka","They (will) bring to you","আপনার নিকট আসবে তারা"],["بِكُلِّ","bikulli","every","নিয়ে প্রত্যেক"],["سَحَّارٍ","saḥḥārin","magician","বড় জাদুকরকে"],["عَلِيمٍۢ","‘alīmin","learned","সূদক্ষ\""]],"t":"يَأْتُوكَ بِكُلِّ سَحَّارٍ عَ<p>لِي</>مٍۢ"},{"n":38,"w":[["فَجُمِعَ","fajumi‘a","So were assembled","অতঃপর জড়ো করা হলো"],["ٱلسَّحَرَةُ","l-saḥaratu","the magicians","জাদুকরদেরকে"],["لِمِيقَـٰتِ","limīqāti","for (the) appointment","জন্যে নির্দিষ্ট সময়ের"],["يَوْمٍۢ","yawmin","(on) a day","দিনের"],["مَّعْلُومٍۢ","ma‘lūmin","well-known","নির্ধারিত"]],"t":"فَجُمِعَ <h>ٱ</><l>ل</>سَّحَرَةُ لِمِي<m>قَٰ</>تِ يَوْ<d>مٍۢ مَّ</>عْ<p>لُو</>مٍۢ"},{"n":39,"w":[["وَقِيلَ","waqīla","And it was said","এবং বলা হলো"],["لِلنَّاسِ","lilnnāsi","to the people","লোকদেরকে"],["هَلْ","hal","Will","\"(তাহ'লে) কি"],["أَنتُم","antum","you","তোমরা"],["مُّجْتَمِعُونَ","muj'tami‘ūna","assemble","(সম্মেলনে) সমবেত হচ্ছো"]],"t":"وَقِيلَ لِل<g>نَّ</>اسِ هَلْ أَ<k>نتُ</><y>م مُّ</><q>جْ</>تَمِ<p>عُو</>نَ"},{"n":40,"w":[["لَعَلَّنَا","la‘allanā","That we may","সম্ভবতঃ আমরা"],["نَتَّبِعُ","nattabi‘u","follow","অনুসরণ করবো"],["ٱلسَّحَرَةَ","l-saḥarata","the magicians","জাদুকরদের (দ্বীনকে)"],["إِن","in","if","যদি"],["كَانُوا۟","kānū","they are","তারা হয়"],["هُمُ","humu","they are","তারা"],["ٱلْغَـٰلِبِينَ","l-ghālibīna","the victorious","বিজয়ী\""]],"t":"لَعَلَّنَا نَتَّبِعُ <h>ٱ</><l>ل</>سَّحَرَةَ إِ<k>ن كَ</>انُو<s>ا۟</> هُمُ <h>ٱ</>لْ<m>غَٰ</>لِ<p>بِي</>نَ"},{"n":41,"w":[["فَلَمَّا","falammā","So when","অতঃপর যখন"],["جَآءَ","jāa","came","আসলো (ময়দানে)"],["ٱلسَّحَرَةُ","l-saḥaratu","the magicians","জাদুকররা"],["قَالُوا۟","qālū","they said","তারা বললো"],["لِفِرْعَوْنَ","lifir'‘awna","to Firaun","উদ্দেশ্যে ফিরআউনের"],["أَئِنَّ","a-inna","Is there","\"কি নিশ্চয়ই (আছে)"],["لَنَا","lanā","for us","জন্যে আমাদের"],["لَأَجْرًا","la-ajran","a reward","অবশ্যই পুরস্কার"],["إِن","in","if","যদি"],["كُنَّا","kunnā","we are","আমরা হই"],["نَحْنُ","naḥnu","we are","আমরা"],["ٱلْغَـٰلِبِينَ","l-ghālibīna","the victorious","বিজয়ী\""]],"t":"فَلَ<g>مَّ</>ا <o>جَآ</>ءَ <h>ٱ</><l>ل</>سَّحَرَةُ قَالُو<s>ا۟</> لِفِرْعَوْنَ أَئِ<g>نَّ</> لَنَا لَأَ<q>جْ</>رًا إِ<k>ن كُ</><g>نَّ</>ا نَحْنُ <h>ٱ</>لْ<m>غَٰ</>لِ<p>بِي</>نَ"},{"n":42,"w":[["قَالَ","qāla","He said","(ফিরআউন) বললো"],["نَعَمْ","na‘am","Yes","\"হ্যাঁ"],["وَإِنَّكُمْ","wa-innakum","and indeed you","এবং নিশ্চয়ই তোমরা"],["إِذًۭا","idhan","then","তখন"],["لَّمِنَ","lamina","surely (will be) of","অবশ্যই অন্তর্ভূক্ত (হবে)"],["ٱلْمُقَرَّبِينَ","l-muqarabīna","the ones who are brought near","(আমার) ঘনিষ্ঠদের\""]],"t":"قَالَ نَعَمْ وَإِ<g>نَّ</>كُمْ إِ<w>ذًۭا لَّ</>مِنَ <h>ٱ</>لْمُقَرَّ<p>بِي</>نَ"},{"n":43,"w":[["قَالَ","qāla","Said","বললো"],["لَهُم","lahum","to them","উদ্দশ্যে তাদের"],["مُّوسَىٰٓ","mūsā","Musa","মূসা"],["أَلْقُوا۟","alqū","Throw","\"তোমরা ছোড়ো"],["مَآ","mā","what","যা কিছু"],["أَنتُم","antum","you","তোমরা"],["مُّلْقُونَ","mul'qūna","(are) going to throw","নিক্ষেপকারী\""]],"t":"قَالَ لَ<y>هُم مُّ</>وسَ<o>ىٰٓ</> أَلْقُو<s>ا۟</> <o>مَآ</> أَ<k>نتُ</><y>م مُّ</>لْ<p>قُو</>نَ"},{"n":44,"w":[["فَأَلْقَوْا۟","fa-alqaw","So they threw","অতঃপর তারা ছুঁড়লো"],["حِبَالَهُمْ","ḥibālahum","their ropes","দড়িদড়া তাদের"],["وَعِصِيَّهُمْ","wa‘iṣiyyahum","and their staffs","ও লাঠিসোটা তাদের"],["وَقَالُوا۟","waqālū","and said","এবং বললো"],["بِعِزَّةِ","bi‘izzati","By the might","\"শপথ মর্যাদার"],["فِرْعَوْنَ","fir'‘awna","(of) Firaun","ফিরআউনের"],["إِنَّا","innā","indeed, we","নিশ্চয়ই"],["لَنَحْنُ","lanaḥnu","surely, we","অবশ্যই আমরাই"],["ٱلْغَـٰلِبُونَ","l-ghālibūna","(are) the victorious","বিজয়ী (হবো)\""]],"t":"فَأَلْقَوْ<s>ا۟</> حِبَالَهُمْ وَعِصِيَّهُمْ وَقَالُو<s>ا۟</> بِعِزَّةِ فِرْعَوْنَ إِ<g>نَّ</>ا لَنَحْنُ <h>ٱ</>لْ<m>غَٰ</>لِ<p>بُو</>نَ"},{"n":45,"w":[["فَأَلْقَىٰ","fa-alqā","Then threw","অতঃপর ছুঁড়লো"],["مُوسَىٰ","mūsā","Musa","মূসা"],["عَصَاهُ","‘aṣāhu","his staff","তাঁর লাঠি"],["فَإِذَا","fa-idhā","and behold","তখনই"],["هِىَ","hiya","It","তা"],["تَلْقَفُ","talqafu","swallowed","গিলে ফেলতে লাগলো"],["مَا","mā","what","যা কিছু"],["يَأْفِكُونَ","yafikūna","they falsified","তারা মিথ্যা সৃষ্টি করে"]],"t":"فَأَلْقَىٰ مُوسَىٰ عَصَاهُ فَإِذَا هِىَ تَلْقَفُ مَا يَأْفِ<p>كُو</>نَ"},{"n":46,"w":[["فَأُلْقِىَ","fa-ul'qiya","Then fell down","তখন পড়ে গেলো"],["ٱلسَّحَرَةُ","l-saḥaratu","the magicians","জাদুকররা"],["سَـٰجِدِينَ","sājidīna","prostrate","সিজদাকারী হিসেবে"]],"t":"فَأُلْقِىَ <h>ٱ</><l>ل</>سَّحَرَةُ <m>سَٰ</>جِ<p>دِي</>نَ"},{"n":47,"w":[["قَالُوٓا۟","qālū","They said","তারা বললো"],["ءَامَنَّا","āmannā","We believe","\"আমরা ঈমান এনেছি"],["بِرَبِّ","birabbi","in (the) Lord","উপর রবের"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","(of) the worlds","বিশ্ব্বজগতের"]],"t":"قَا<o>لُوٓ</><s>ا۟</> ءَامَ<g>نَّ</>ا بِرَبِّ <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":48,"w":[["رَبِّ","rabbi","Lord","(যিনি) রব"],["مُوسَىٰ","mūsā","(of) Musa","মূসার"],["وَهَـٰرُونَ","wahārūna","and Harun","ও হারুনের\""]],"t":"رَبِّ مُوسَىٰ وَ<m>هَٰ</><p>رُو</>نَ"},{"n":49,"w":[["قَالَ","qāla","He said","(ফিরআউন) বললো"],["ءَامَنتُمْ","āmantum","You believed","\"কি তোমরা ঈমান আনলে"],["لَهُۥ","lahu","in him","প্রতি তাঁর"],["قَبْلَ","qabla","before","এর পূর্বেই"],["أَنْ","an","[that]","যে"],["ءَاذَنَ","ādhana","I gave permission","আমি দিবো অনুমতি"],["لَكُمْ ۖ","lakum","to you","জন্যে তোমাদের"],["إِنَّهُۥ","innahu","Indeed, he","নিশ্চয়ই সে"],["لَكَبِيرُكُمُ","lakabīrukumu","(is) surely your chief","অবশ্যই প্রধান (নেতা) তোমাদের"],["ٱلَّذِى","alladhī","who","যে"],["عَلَّمَكُمُ","‘allamakumu","has taught you","তোমাদেরকে শিখিয়েছে"],["ٱلسِّحْرَ","l-siḥ'ra","the magic","জাদু"],["فَلَسَوْفَ","falasawfa","so surely soon","অতএব শীঘ্রই"],["تَعْلَمُونَ ۚ","ta‘lamūna","you will know","তোমরা জানতে পারবে (পরিণাম)"],["لَأُقَطِّعَنَّ","la-uqaṭṭi‘anna","I will surely cut off","অবশ্যই আমি কাটবোই"],["أَيْدِيَكُمْ","aydiyakum","your hands","হাতগুলোকে তোমাদের"],["وَأَرْجُلَكُم","wa-arjulakum","and your feet","ও পাগুলোকে তোমাদের"],["مِّنْ","min","of","হ'তে"],["خِلَـٰفٍۢ","khilāfin","opposite sides","বিপরীত দিক"],["وَلَأُصَلِّبَنَّكُمْ","wala-uṣallibannakum","and I will surely crucify you","আর অবশ্যই তোমাদেরকে শূলে চড়াবো"],["أَجْمَعِينَ","ajma‘īna","all","সবাইকে\""]],"t":"قَالَ ءَامَ<k>نتُ</>مْ لَهُ<m>ۥ</> قَ<q>بْ</>لَ أَنْ ءَاذَنَ لَكُمْ ۖ إِ<g>نَّ</>هُ<m>ۥ</> لَكَبِيرُكُمُ <h>ٱ</>لَّذِى عَلَّمَكُمُ <h>ٱ</><l>ل</>سِّحْرَ فَلَسَوْفَ تَعْلَمُونَ ۚ لَأُقَطِّعَ<g>نَّ</> أَيْدِيَكُمْ وَأَرْجُلَ<y>كُم مِّ</>نْ خِ<m>لَٰ</><d>فٍۢ وَ</>لَأُصَلِّبَ<g>نَّ</>كُمْ أَ<q>جْ</>مَ<p>عِي</>نَ"},{"n":50,"w":[["قَالُوا۟","qālū","They said","তারা বললো"],["لَا","lā","No","\"নেই"],["ضَيْرَ ۖ","ḍayra","harm","কোনো ক্ষতি"],["إِنَّآ","innā","Indeed, we","নিশ্চয়ই আমরা"],["إِلَىٰ","ilā","to","দিকে"],["رَبِّنَا","rabbinā","our Lord","আমাদের রবের"],["مُنقَلِبُونَ","munqalibūna","(will) return","প্রত্যাবর্তনকারী"]],"t":"قَالُو<s>ا۟</> لَا ضَيْرَ ۖ إِ<g>نَّ</><o>آ</> إِلَىٰ رَبِّنَا مُ<k>نقَ</>لِ<p>بُو</>نَ"},{"n":51,"w":[["إِنَّا","innā","Indeed, we","নিশ্চয়ই  আমরা"],["نَطْمَعُ","naṭma‘u","hope","আশা করি"],["أَن","an","that","যে"],["يَغْفِرَ","yaghfira","will forgive","ক্ষমা করবেন"],["لَنَا","lanā","us","আমাদেরকে"],["رَبُّنَا","rabbunā","our Lord","রব আমাদের"],["خَطَـٰيَـٰنَآ","khaṭāyānā","our sins","ভুলক্রটিগুলোকে আমাদের"],["أَن","an","because","(এজন্য) যে"],["كُنَّآ","kunnā","we are","আমরা হলাম"],["أَوَّلَ","awwala","(the) first","প্রথম"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","(of) the believers","মু'মিন\""]],"t":"إِ<g>نَّ</>ا نَ<q>طْ</>مَعُ <d>أَن يَ</>غْفِرَ لَنَا رَبُّنَا خَ<m>طَٰيَٰ</><o>نَآ</> أَ<k>ن كُ</><g>نَّ</><o>آ</> أَوَّلَ <h>ٱ</>لْمُؤْمِ<p>نِي</>نَ"},{"n":52,"w":[["۞ وَأَوْحَيْنَآ","wa-awḥaynā","And We inspired","এবং আমরা ওহী পাঠালাম"],["إِلَىٰ","ilā","to","প্রতি"],["مُوسَىٰٓ","mūsā","Musa","মূসার"],["أَنْ","an","[that]","যে"],["أَسْرِ","asri","Travel by night","\"রাতে বের হয়ে যাও"],["بِعِبَادِىٓ","bi‘ibādī","with My slaves","নিয়ে আমার দাসদের"],["إِنَّكُم","innakum","indeed, you","নিশ্চয়ই তোমাদেরকে"],["مُّتَّبَعُونَ","muttaba‘ūna","(will be) followed","পিছনে অনুসরণ করা হবে\""]],"t":"۞ وَأَوْحَيْ<o>نَآ</> إِلَىٰ مُوسَ<o>ىٰٓ</> أَنْ أَسْرِ بِعِبَا<o>دِىٓ</> إِ<g>نَّ</><y>كُم مُّ</>تَّبَ<p>عُو</>نَ"},{"n":53,"w":[["فَأَرْسَلَ","fa-arsala","Then sent","অতঃপর পাঠালো"],["فِرْعَوْنُ","fir'‘awnu","Firaun","ফিরআউন"],["فِى","fī","in","মধ্যে"],["ٱلْمَدَآئِنِ","l-madāini","the cities","শহরগুলোর"],["حَـٰشِرِينَ","ḥāshirīna","gatherers","(লোক) সংগ্রহকারীদেরকে"]],"t":"فَأَرْسَلَ فِرْعَوْنُ فِى <h>ٱ</>لْمَ<o>دَآ</>ئِنِ <m>حَٰ</>شِ<p>رِي</>نَ"},{"n":54,"w":[["إِنَّ","inna","Indeed","\"(এই বলে যে) নিশ্চয়ই"],["هَـٰٓؤُلَآءِ","hāulāi","these","এরা"],["لَشِرْذِمَةٌۭ","lashir'dhimatun","(are) certainly a band","অবশ্যই একটি ক্ষুদে দল"],["قَلِيلُونَ","qalīlūna","small","কম (লোক)"]],"t":"إِ<g>نَّ</> <o>هَٰٓؤُلَآ</>ءِ لَشِرْذِمَ<k>ةٌۭ قَ</>لِي<p>لُو</>نَ"},{"n":55,"w":[["وَإِنَّهُمْ","wa-innahum","And indeed, they","এবং নিশ্চয়ই তারা"],["لَنَا","lanā","[to] us","জন্যে আমাদের"],["لَغَآئِظُونَ","laghāiẓūna","(are) surely enraging","রাগউদ্রেককারী"]],"t":"وَإِ<g>نَّ</>هُمْ لَنَا لَ<o>غَآ</>ئِ<p>ظُو</>نَ"},{"n":56,"w":[["وَإِنَّا","wa-innā","And indeed, we","এবং নিশ্চয়ই আমরা"],["لَجَمِيعٌ","lajamī‘un","(are) surely a multitude","অবশ্যই সবাই"],["حَـٰذِرُونَ","ḥādhirūna","forewarned","সদা-সতর্ক\""]],"t":"وَإِ<g>نَّ</>ا لَجَمِيعٌ <m>حَٰ</>ذِ<p>رُو</>نَ"},{"n":57,"w":[["فَأَخْرَجْنَـٰهُم","fa-akhrajnāhum","So We expelled them","এরপর আমরা বের করলাম তাদেরকে"],["مِّن","min","from","হ'তে"],["جَنَّـٰتٍۢ","jannātin","gardens","বাগান"],["وَعُيُونٍۢ","wa‘uyūnin","and springs","ও ঝর্ণাসমূহ"]],"t":"فَأَخْرَ<q>جْ</><m>نَٰ</><y>هُم مِّ</><k>ن جَ</><g>نَّٰ</><d>تٍۢ وَ</>عُ<p>يُو</>نٍۢ"},{"n":58,"w":[["وَكُنُوزٍۢ","wakunūzin","And treasures","এবং ধন-ভান্ডার"],["وَمَقَامٍۢ","wamaqāmin","and a place","ও (হ'তে) স্থানসমূহ"],["كَرِيمٍۢ","karīmin","honorable","সম্মানের"]],"t":"وَكُنُو<d>زٍۢ وَ</>مَقَا<k>مٍۢ كَ</><p>رِي</>مٍۢ"},{"n":59,"w":[["كَذَٰلِكَ","kadhālika","Thus","এরূপই (ঘটেছিলো)"],["وَأَوْرَثْنَـٰهَا","wa-awrathnāhā","And We caused to inherit them","আর আমরা উত্তরাধিকারী করেছিলাম তার"],["بَنِىٓ","banī","(the) Children of Israel","বনী"],["إِسْرَٰٓءِيلَ","is'rāīla","(the) Children of Israel","ইসরাঈলদেরকে"]],"t":"كَ<m>ذَٰ</>لِكَ وَأَوْرَثْ<m>نَٰ</>هَا بَ<o>نِىٓ</> إِسْ<o>رَٰٓ</><p>ءِي</>لَ"},{"n":60,"w":[["فَأَتْبَعُوهُم","fa-atba‘ūhum","So they followed them","অতঃপর তারা পিছু নিলো তাদেরকে"],["مُّشْرِقِينَ","mush'riqīna","(at) sunrise","সূর্যোদয়ের সময়"]],"t":"فَأَتْبَعُو<y>هُم مُّ</>شْرِ<p>قِي</>نَ"},{"n":61,"w":[["فَلَمَّا","falammā","Then when","অতঃপর যখন"],["تَرَٰٓءَا","tarāā","saw each other","পরস্পরকে দেখলো"],["ٱلْجَمْعَانِ","l-jam‘āni","the two hosts","দল দু'টো"],["قَالَ","qāla","said","বললো"],["أَصْحَـٰبُ","aṣḥābu","(the) companions","সাথীরা"],["مُوسَىٰٓ","mūsā","(of) Musa","মূসার"],["إِنَّا","innā","Indeed, we","\"নিশ্চয়ই আমরা"],["لَمُدْرَكُونَ","lamud'rakūna","(are) surely to be overtaken","অবশ্যই ধরা পড়ে গেলাম\""]],"t":"فَلَ<g>مَّ</>ا تَ<o>رَٰٓ</>ءَا <h>ٱ</>لْجَمْعَانِ قَالَ أَصْ<m>حَٰ</>بُ مُوسَ<o>ىٰٓ</> إِ<g>نَّ</>ا لَمُ<q>دْ</>رَ<p>كُو</>نَ"},{"n":62,"w":[["قَالَ","qāla","He said","(মূসা) বললো"],["كَلَّآ ۖ","kallā","Nay","\"কখনও না"],["إِنَّ","inna","indeed","নিশ্চয়ই"],["مَعِىَ","ma‘iya","with me","আমার সাথে (আছেন)"],["رَبِّى","rabbī","(is) my Lord","আমার রব"],["سَيَهْدِينِ","sayahdīni","He will guide me","শীঘ্রই তিনি আমাকে পথ দেখাবেন\""]],"t":"قَالَ كَ<o>لَّآ ۖ</> إِ<g>نَّ</> مَعِىَ رَبِّى سَيَهْ<p>دِي</>نِ"},{"n":63,"w":[["فَأَوْحَيْنَآ","fa-awḥaynā","Then We inspired","অতঃপর আমরা ওহী পাঠালাম"],["إِلَىٰ","ilā","to","প্রতি"],["مُوسَىٰٓ","mūsā","Musa","মূসার"],["أَنِ","ani","[that]","যে"],["ٱضْرِب","iḍ'rib","Strike","\"আঘাত করো"],["بِّعَصَاكَ","bi‘aṣāka","with your staff","দিয়ে তোমার লাঠি"],["ٱلْبَحْرَ ۖ","l-baḥra","the sea","সমূদ্রকে\""],["فَٱنفَلَقَ","fa-infalaqa","So it parted","ফলে ফেটে গেল (সমুদ্র)"],["فَكَانَ","fakāna","and became","অতঃপর হলো"],["كُلُّ","kullu","each","প্রত্যেক"],["فِرْقٍۢ","fir'qin","part","ভাগ"],["كَٱلطَّوْدِ","kal-ṭawdi","like the mountain","মতো পর্বতের"],["ٱلْعَظِيمِ","l-‘aẓīmi","[the] great","বিশাল"]],"t":"فَأَوْحَيْ<o>نَآ</> إِلَىٰ مُوسَ<o>ىٰٓ</> أَنِ <h>ٱ</>ضْرِب بِّعَصَاكَ <h>ٱ</>لْبَحْرَ ۖ فَ<h>ٱ</><k>نفَ</>لَقَ فَكَانَ كُلُّ فِرْ<k>قٍۢ كَ</><h>ٱ</><l>ل</>طَّوْدِ <h>ٱ</>لْعَ<p>ظِي</>مِ"},{"n":64,"w":[["وَأَزْلَفْنَا","wa-azlafnā","And We brought near","এবং আমরা নিকটে আনলাম"],["ثَمَّ","thamma","there","সেখানেই"],["ٱلْـَٔاخَرِينَ","l-ākharīna","the others","অন্যান্যদেরকে (অপর দলকে)"]],"t":"وَأَزْلَفْنَا ثَ<g>مَّ</> <h>ٱ</>لْءَاخَ<p>رِي</>نَ"},{"n":65,"w":[["وَأَنجَيْنَا","wa-anjaynā","And We saved","এবং আমরা উদ্ধার করলাম"],["مُوسَىٰ","mūsā","Musa","মূসাকে"],["وَمَن","waman","and who","ও যারা (ছিলো)"],["مَّعَهُۥٓ","ma‘ahu","(were) with him","তাঁর সাথে"],["أَجْمَعِينَ","ajma‘īna","all","সবাইকে"]],"t":"وَأَ<k>نجَ</>يْنَا مُوسَىٰ وَ<d>مَن مَّ</>عَهُ<o>ۥٓ</> أَ<q>جْ</>مَ<p>عِي</>نَ"},{"n":66,"w":[["ثُمَّ","thumma","Then","এরপর"],["أَغْرَقْنَا","aghraqnā","We drowned","আমরা ডুবিয়ে দিলাম"],["ٱلْـَٔاخَرِينَ","l-ākharīna","the others","অন্যান্যদেরকে"]],"t":"ثُ<g>مَّ</> أَغْرَ<q>قْ</>نَا <h>ٱ</>لْءَاخَ<p>رِي</>نَ"},{"n":67,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে (আছে)"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَةًۭ ۖ","laāyatan","surely (is) a Sign","অবশ্যই একটি নিদর্শন"],["وَمَا","wamā","but not","কিন্তু না"],["كَانَ","kāna","are","ছিলো"],["أَكْثَرُهُم","aktharuhum","most of them","অধিকাংশই তাদের"],["مُّؤْمِنِينَ","mu'minīna","believers","বিশ্বাসী"]],"t":"إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَايَ<d>ةًۭ ۖ وَ</>مَا كَانَ أَكْثَرُ<y>هُم مُّ</>ؤْمِ<p>نِي</>نَ"},{"n":68,"w":[["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["رَبَّكَ","rabbaka","your Lord","তোমার রব"],["لَهُوَ","lahuwa","surely He","অবশ্যই তিনিই"],["ٱلْعَزِيزُ","l-‘azīzu","(is) the All-Mighty","পরাক্রমশালী"],["ٱلرَّحِيمُ","l-raḥīmu","the Most Merciful","পরম দয়ালু"]],"t":"وَإِ<g>نَّ</> رَبَّكَ لَهُوَ <h>ٱ</>لْعَزِيزُ <h>ٱ</><l>ل</>رَّ<p>حِي</>مُ"},{"n":69,"w":[["وَٱتْلُ","wa-ut'lu","And recite","আর পাঠ করে শুনাও"],["عَلَيْهِمْ","‘alayhim","to them","কাছে তাদের"],["نَبَأَ","naba-a","(the) news","সংবাদ"],["إِبْرَٰهِيمَ","ib'rāhīma","(of) Ibrahim","ইবরাহীমের"]],"t":"وَ<h>ٱ</>تْلُ عَلَيْهِمْ نَبَأَ إِ<q>بْ</><m>رَٰ</><p>هِي</>مَ"},{"n":70,"w":[["إِذْ","idh","When","যখন"],["قَالَ","qāla","he said","সে বলেছিলো"],["لِأَبِيهِ","li-abīhi","to his father","উদ্দেশ্যে তার পিতার"],["وَقَوْمِهِۦ","waqawmihi","and his people","ও তার জাতির"],["مَا","mā","What","\"কিসের"],["تَعْبُدُونَ","ta‘budūna","(do) you worship","তোমরা পূজা করছো\""]],"t":"إِذْ قَالَ لِأَبِيهِ وَقَوْمِ<m>هِۦ</> مَا تَعْبُ<p>دُو</>نَ"},{"n":71,"w":[["قَالُوا۟","qālū","They said","তারা বলেছিলো"],["نَعْبُدُ","na‘budu","We worship","\"আমরা পূজা করি"],["أَصْنَامًۭا","aṣnāman","idols","(কিছু) মূর্তির"],["فَنَظَلُّ","fanaẓallu","so we will remain","অতঃপর আমরা লেগে থাকি"],["لَهَا","lahā","to them","জন্যে তাদের"],["عَـٰكِفِينَ","‘ākifīna","devoted","নিষ্ঠাবান হয়ে\""]],"t":"قَالُو<s>ا۟</> نَعْبُدُ أَصْنَا<k>مًۭا فَ</>نَظَلُّ لَهَا <m>عَٰ</>كِ<p>فِي</>نَ"},{"n":72,"w":[["قَالَ","qāla","He said","(ইবরাহীম) বললো"],["هَلْ","hal","Do","\"কি"],["يَسْمَعُونَكُمْ","yasma‘ūnakum","they hear you","তারা শুনতে পায় তোমাদেরকে"],["إِذْ","idh","when","যখন"],["تَدْعُونَ","tad‘ūna","you call","তোমরা ডাকো"]],"t":"قَالَ هَلْ يَسْمَعُونَكُمْ إِذْ تَ<q>دْ</><p>عُو</>نَ"},{"n":73,"w":[["أَوْ","aw","Or","অথবা"],["يَنفَعُونَكُمْ","yanfa‘ūnakum","(do) they benefit you","উপকার করতে পারে তোমাদেরকে"],["أَوْ","aw","or","অথবা"],["يَضُرُّونَ","yaḍurrūna","they harm (you)","ক্ষতি করতে পারে\""]],"t":"أَوْ يَ<k>نفَ</>عُونَكُمْ أَوْ يَضُ<p>رُّو</>نَ"},{"n":74,"w":[["قَالُوا۟","qālū","They said","তারা বললো"],["بَلْ","bal","Nay","\"(না) বরং"],["وَجَدْنَآ","wajadnā","but we found","আমরা পেয়েছি"],["ءَابَآءَنَا","ābāanā","our forefathers","আমাদের বাপ দাদাদেরকে"],["كَذَٰلِكَ","kadhālika","like that ","এরূপই"],["يَفْعَلُونَ","yaf‘alūna","doing","তারা করতেন\""]],"t":"قَالُو<s>ا۟</> بَلْ وَجَ<q>دْ</><o>نَآ</> ءَا<o>بَآ</>ءَنَا كَ<m>ذَٰ</>لِكَ يَفْعَ<p>لُو</>نَ"},{"n":75,"w":[["قَالَ","qāla","He said","সে বললো"],["أَفَرَءَيْتُم","afara-aytum","Do you see","\"কি তবে (ভেবে) দেখেছো তোমরা"],["مَّا","mā","what","(ঐগুলোকে) যার"],["كُنتُمْ","kuntum","you have been","তোমরা ছিলে"],["تَعْبُدُونَ","ta‘budūna","worshipping","তোমরা পূজা করো"]],"t":"قَالَ أَفَرَءَيْ<y>تُم مَّ</>ا كُ<k>نتُ</>مْ تَعْبُ<p>دُو</>نَ"},{"n":76,"w":[["أَنتُمْ","antum","You","তোমরা"],["وَءَابَآؤُكُمُ","waābāukumu","and your forefathers","ও পিতৃ-পুরুষেরা তোমাদের"],["ٱلْأَقْدَمُونَ","l-aqdamūna","and your forefathers","(যারা) অতীত হয়েছে"]],"t":"أَ<k>نتُ</>مْ وَءَا<o>بَآ</>ؤُكُمُ <h>ٱ</>لْأَ<q>قْ</>دَ<p>مُو</>نَ"},{"n":77,"w":[["فَإِنَّهُمْ","fa-innahum","Indeed, they","সুতরাং নিশ্চয়ই তারা"],["عَدُوٌّۭ","‘aduwwun","(are) enemies","শত্রু"],["لِّىٓ","lī","to me","আমার"],["إِلَّا","illā","except","ছাড়া"],["رَبَّ","rabba","(the) Lord","রব"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","(of) the worlds","বিশ্বজগতের"]],"t":"فَإِ<g>نَّ</>هُمْ عَدُ<w>وٌّۭ لِّ</><o>ىٓ</> إِلَّا رَبَّ <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":78,"w":[["ٱلَّذِى","alladhī","The One Who","যিনি"],["خَلَقَنِى","khalaqanī","created me","আমাকে সৃষ্টি করেছেন"],["فَهُوَ","fahuwa","and He","অতঃপর তিনিই"],["يَهْدِينِ","yahdīni","guides me","আমাকে পথ দেখান"]],"t":"ٱلَّذِى خَلَقَنِى فَهُوَ يَهْ<p>دِي</>نِ"},{"n":79,"w":[["وَٱلَّذِى","wa-alladhī","And the One Who","এবং তিনিই"],["هُوَ","huwa","[He]","যিনি"],["يُطْعِمُنِى","yuṭ'‘imunī","gives me food","আমাকে খাওয়ান"],["وَيَسْقِينِ","wayasqīni","and gives me drink","ও আমাকে পান করান"]],"t":"وَ<h>ٱ</>لَّذِى هُوَ يُ<q>طْ</>عِمُنِى وَيَسْ<p>قِي</>نِ"},{"n":80,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["مَرِضْتُ","mariḍ'tu","I am ill","আমি অসুস্থ হই"],["فَهُوَ","fahuwa","then He","তখন তিনিই"],["يَشْفِينِ","yashfīni","cures me","আমাকে আরোগ্য দান করেন"]],"t":"وَإِذَا مَرِضْتُ فَهُوَ يَشْ<p>فِي</>نِ"},{"n":81,"w":[["وَٱلَّذِى","wa-alladhī","And the One Who","এবং (তিনিই) যিনি"],["يُمِيتُنِى","yumītunī","will cause me to die","আমাকে মৃত্যু দিবেন"],["ثُمَّ","thumma","then","এরপর"],["يُحْيِينِ","yuḥ'yīni","he will give me life","জীবিত করবেন"]],"t":"وَ<h>ٱ</>لَّذِى يُمِيتُنِى ثُ<g>مَّ</> يُحْ<p>يِي</>نِ"},{"n":82,"w":[["وَٱلَّذِىٓ","wa-alladhī","And the One Who ","(তিনিই) যার (নিকট)"],["أَطْمَعُ","aṭma‘u","I hope","আশা করি আমি"],["أَن","an","that","যে"],["يَغْفِرَ","yaghfira","He will forgive","ক্ষমা করবেন"],["لِى","lī","for me","আমাকে"],["خَطِيٓـَٔتِى","khaṭīatī","my faults","আমার ভুলত্রুটি"],["يَوْمَ","yawma","(on the) Day","দিনে"],["ٱلدِّينِ","l-dīni","(of) the Judgment","বিচারের"]],"t":"وَ<h>ٱ</>لَّ<o>ذِىٓ</> أَ<q>طْ</>مَعُ <d>أَن يَ</>غْفِرَ لِى خَطِ<o>يٓـَٔ</>تِى يَوْمَ <h>ٱ</><l>ل</><p>دِّي</>نِ"},{"n":83,"w":[["رَبِّ","rabbi","My Lord","(পরে বললেন) হে আমার রব"],["هَبْ","hab","Grant","দান করো"],["لِى","lī","[for] me","জন্যে আমার"],["حُكْمًۭا","ḥuk'man","wisdom","প্রজ্ঞা"],["وَأَلْحِقْنِى","wa-alḥiq'nī","and join me","ও মিলিত করো"],["بِٱلصَّـٰلِحِينَ","bil-ṣāliḥīna","with the righteous","সাথে সৎকর্মশীলদের"]],"t":"رَبِّ هَ<q>بْ</> لِى حُكْ<d>مًۭا وَ</>أَلْحِ<q>قْ</>نِى بِ<h>ٱ</><l>ل</><m>صَّٰ</>لِ<p>حِي</>نَ"},{"n":84,"w":[["وَٱجْعَل","wa-ij'‘al","And grant","এবং দাও"],["لِّى","lī","[for] me","জন্যে আমার"],["لِسَانَ","lisāna","a mention","জিহবা (খ্যাতি)"],["صِدْقٍۢ","ṣid'qin","(of) honor","সত্যিকার"],["فِى","fī","among","মধ্যে"],["ٱلْـَٔاخِرِينَ","l-ākhirīna","the later (generations)","পরবর্তীদের"]],"t":"وَ<h>ٱ</><q>جْ</>عَل لِّى لِسَانَ صِ<q>دْ</><k>قٍۢ فِ</>ى <h>ٱ</>لْءَاخِ<p>رِي</>نَ"},{"n":85,"w":[["وَٱجْعَلْنِى","wa-ij'‘alnī","And make me","এবং আমাকে করো"],["مِن","min","of","অন্তর্ভূক্ত"],["وَرَثَةِ","warathati"