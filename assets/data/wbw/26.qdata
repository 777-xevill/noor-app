"you","তুমি হও"],["مِنَ","mina","(are) of","অন্তর্ভুক্ত"],["ٱلصَّـٰدِقِينَ","l-ṣādiqīna","the truthful","সত্যবাদীদের\""]],"t":"<o>مَآ</> أَ<k>نتَ</> إِلَّا بَشَ<d>رٌۭ مِّ</>ثْلُنَا فَأْتِ بِـَٔايَةٍ إِ<k>ن كُنتَ</> مِنَ <h>ٱ</><l>ل</><m>صَّٰ</>دِ<p>قِي</>نَ"},{"n":155,"w":[["قَالَ","qāla","He said","(সালেহ) বললো"],["هَـٰذِهِۦ","hādhihi","This","\"এই"],["نَاقَةٌۭ","nāqatun","(is) a she-camel","একটি মাদি উট"],["لَّهَا","lahā","For her","জন্যে তার (রয়েছে)"],["شِرْبٌۭ","shir'bun","(is a share of) drink","পানি পান করার পালা"],["وَلَكُمْ","walakum","and for you","এবং জন্যে তোমাদের"],["شِرْبُ","shir'bu","(is a share of) drink","পানি পান করার পালা"],["يَوْمٍۢ","yawmin","(on) a day","দিন"],["مَّعْلُومٍۢ","ma‘lūmin","known","নির্দিষ্ট"]],"t":"قَالَ <m>هَٰذِهِۦ</> نَاقَ<w>ةٌۭ لَّ</>هَا شِرْ<d>بٌۭ وَ</>لَكُمْ شِرْبُ يَوْ<d>مٍۢ مَّ</>عْ<p>لُو</>مٍۢ"},{"n":156,"w":[["وَلَا","walā","And (do) not","আর না"],["تَمَسُّوهَا","tamassūhā","touch her","স্পর্শ করো তাকে"],["بِسُوٓءٍۢ","bisūin","with harm","মন্দভাবে"],["فَيَأْخُذَكُمْ","fayakhudhakum","lest seize you","তাহলে ধরবে তোমাদেরকে"],["عَذَابُ","‘adhābu","(the) punishment","শাস্তি"],["يَوْمٍ","yawmin","(of) a Day","দিনের"],["عَظِيمٍۢ","‘aẓīmin","Great","কঠিন\""]],"t":"وَلَا تَمَسُّوهَا بِ<o>سُوٓ</><k>ءٍۢ فَ</>يَأْخُذَكُمْ عَذَابُ يَوْمٍ عَ<p>ظِي</>مٍۢ"},{"n":157,"w":[["فَعَقَرُوهَا","fa‘aqarūhā","But they hamstrung her","কিন্তু তার পায়ের রগ কেটে দিয়ে হত্যা করলো"],["فَأَصْبَحُوا۟","fa-aṣbaḥū","then they became","পরিণামে তারা হলো"],["نَـٰدِمِينَ","nādimīna","regretful","অনুতপ্ত"]],"t":"فَعَقَرُوهَا فَأَصْبَحُو<s>ا۟</> <m>نَٰ</>دِ<p>مِي</>نَ"},{"n":158,"w":[["فَأَخَذَهُمُ","fa-akhadhahumu","So seized them","অতঃপর গ্রাস করলো তাদেরকে"],["ٱلْعَذَابُ ۗ","l-‘adhābu","the punishment","শাস্তি"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে (আছে)"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَةًۭ ۖ","laāyatan","surely is a sign","অবশ্যই নিদর্শন"],["وَمَا","wamā","but not","আর না"],["كَانَ","kāna","are","ছিলো"],["أَكْثَرُهُم","aktharuhum","most of them","অধিকাংশ তাদের"],["مُّؤْمِنِينَ","mu'minīna","believers","মু'মিন"]],"t":"فَأَخَذَهُمُ <h>ٱ</>لْعَذَابُ ۗ إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَايَ<d>ةًۭ ۖ وَ</>مَا كَانَ أَكْثَرُ<y>هُم مُّ</>ؤْمِ<p>نِي</>نَ"},{"n":159,"w":[["وَإِنَّ","wa-inna","And indeed","অথচ নিশ্চয়ই"],["رَبَّكَ","rabbaka","your Lord","তোমার রব"],["لَهُوَ","lahuwa","surely He","অবশ্যই তিনি"],["ٱلْعَزِيزُ","l-‘azīzu","(is) the All-Mighty","পরাক্রমশালী"],["ٱلرَّحِيمُ","l-raḥīmu","the Most Merciful","পরম দয়ালু"]],"t":"وَإِ<g>نَّ</> رَبَّكَ لَهُوَ <h>ٱ</>لْعَزِيزُ <h>ٱ</><l>ل</>رَّ<p>حِي</>مُ"},{"n":160,"w":[["كَذَّبَتْ","kadhabat","Denied","মিথ্যারোপ করেছিলো"],["قَوْمُ","qawmu","(the) people","জাতি"],["لُوطٍ","lūṭin","(of) Lut","লুতের"],["ٱلْمُرْسَلِينَ","l-mur'salīna","the Messengers","রাসূলদেরকে"]],"t":"كَذَّبَتْ قَوْمُ لُوطٍ <h>ٱ</>لْمُرْسَ<p>لِي</>نَ"},{"n":161,"w":[["إِذْ","idh","When","(স্মরণ করো) যখন"],["قَالَ","qāla","said","বলেছিলো"],["لَهُمْ","lahum","to them","উদ্দেশ্যে তাদের"],["أَخُوهُمْ","akhūhum","their brother","ভাই তাদের"],["لُوطٌ","lūṭun","Lut","লুত"],["أَلَا","alā","Will not","\"কি না"],["تَتَّقُونَ","tattaqūna","you fear (Allah)","তোমরা ভয় করবে"]],"t":"إِذْ قَالَ لَهُمْ أَخُوهُمْ لُوطٌ أَلَا تَتَّ<p>قُو</>نَ"},{"n":162,"w":[["إِنِّى","innī","Indeed, I am","নিশ্চয়ই আমি"],["لَكُمْ","lakum","to you","জন্যে তোমাদের"],["رَسُولٌ","rasūlun","a Messenger","একজন রাসূল"],["أَمِينٌۭ","amīnun","trustworthy","বিশ্বস্ত"]],"t":"إِ<g>نِّ</>ى لَكُمْ رَسُولٌ أَ<p>مِي</>نٌۭ"},{"n":163,"w":[["فَٱتَّقُوا۟","fa-ittaqū","So fear","অতএব তোমরা ভয় করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["وَأَطِيعُونِ","wa-aṭī‘ūni","and obey me","ও আমার আনুগত্য করো"]],"t":"فَ<h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</>للَّهَ وَأَطِي<p>عُو</>نِ"},{"n":164,"w":[["وَمَآ","wamā","And not","আর না"],["أَسْـَٔلُكُمْ","asalukum","I ask you","তোমাদের (নিকট) আমি চাচ্ছি"],["عَلَيْهِ","‘alayhi","for it","জন্যে এর"],["مِنْ","min","any","কোনো"],["أَجْرٍ ۖ","ajrin","payment","পারিশ্রমিক"],["إِنْ","in","Not","নেই"],["أَجْرِىَ","ajriya","(is) my payment","আমার প্রতিদান (কারো নিকট)"],["إِلَّا","illā","except","এ ছাড়া"],["عَلَىٰ","‘alā","from","নিকট"],["رَبِّ","rabbi","(the) Lord","রবের"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","(of) the worlds","বিশ্বজগতের"]],"t":"وَ<o>مَآ</> أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَ<q>جْ</>رٍ ۖ إِنْ أَ<q>جْ</>رِىَ إِلَّا عَلَىٰ رَبِّ <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":165,"w":[["أَتَأْتُونَ","atatūna","Do you approach","কি তোমরা উপগত হও"],["ٱلذُّكْرَانَ","l-dhuk'rāna","the males","পুরুষদের (নিকট)"],["مِنَ","mina","among","মধ্য হ'তে"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","the worlds","বিশ্বজগতের"]],"t":"أَتَأْتُونَ <h>ٱ</><l>ل</>ذُّكْرَانَ مِنَ <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":166,"w":[["وَتَذَرُونَ","watadharūna","And you leave","ও তোমরা পরিহার করছো"],["مَا","mā","what","যা"],["خَلَقَ","khalaqa","created","সৃষ্টি করেছেন"],["لَكُمْ","lakum","for you","জন্যে তোমাদের"],["رَبُّكُم","rabbukum","your Lord","রব তোমাদের"],["مِّنْ","min","of","মধ্য থেকে"],["أَزْوَٰجِكُم ۚ","azwājikum","your mates","তোমাদের স্ত্রীদের"],["بَلْ","bal","Nay","বরং"],["أَنتُمْ","antum","you","তোমরা"],["قَوْمٌ","qawmun","(are) a people","জাতি"],["عَادُونَ","‘ādūna","transgressing","সীমালঙ্ঘনকারী\""]],"t":"وَتَذَرُونَ مَا خَلَقَ لَكُمْ رَبُّ<y>كُم مِّ</>نْ أَزْ<m>وَٰ</>جِ<f>كُم ۚ بَ</>لْ أَ<k>نتُ</>مْ قَوْمٌ عَا<p>دُو</>نَ"},{"n":167,"w":[["قَالُوا۟","qālū","They said","তারা বললো"],["لَئِن","la-in","If","\"অবশ্যই যদি"],["لَّمْ","lam","not","না"],["تَنتَهِ","tantahi","you desist","বিরত হও"],["يَـٰلُوطُ","yālūṭu","O Lut","হে লুত"],["لَتَكُونَنَّ","latakūnanna","Surely, you will be","অবশ্যই তুমি হবে"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْمُخْرَجِينَ","l-mukh'rajīna","the ones driven out","বহিষ্কৃতদের\""]],"t":"قَالُو<s>ا۟</> لَ<w>ئِن لَّ</>مْ تَ<k>نتَ</>هِ <m>يَٰ</>لُوطُ لَتَكُونَ<g>نَّ</> مِنَ <h>ٱ</>لْمُخْرَ<p>جِي</>نَ"},{"n":168,"w":[["قَالَ","qāla","He said","(লুত) বললো"],["إِنِّى","innī","Indeed, I am","\"নিশ্চয়ই আমি"],["لِعَمَلِكُم","li‘amalikum","(of) your deed","জন্যে তোমাদের কাজের"],["مِّنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْقَالِينَ","l-qālīna","those who detest","ঘৃণাকারীদের"]],"t":"قَالَ إِ<g>نِّ</>ى لِعَمَلِ<y>كُم مِّ</>نَ <h>ٱ</>لْقَا<p>لِي</>نَ"},{"n":169,"w":[["رَبِّ","rabbi","My Lord","হে আমার রব"],["نَجِّنِى","najjinī","Save me","আমাকে রক্ষা করো"],["وَأَهْلِى","wa-ahlī","and my family","ও আমার পরিবারকে"],["مِمَّا","mimmā","from what","(তা) হ'তে যা"],["يَعْمَلُونَ","ya‘malūna","they do","তারা করেছে\""]],"t":"رَبِّ نَجِّنِى وَأَهْلِى مِ<g>مَّ</>ا يَعْمَ<p>لُو</>نَ"},{"n":170,"w":[["فَنَجَّيْنَـٰهُ","fanajjaynāhu","So We saved him","অতঃপর তাকে আমরা রক্ষা করলাম"],["وَأَهْلَهُۥٓ","wa-ahlahu","and his family","ও তার পরিবারকে"],["أَجْمَعِينَ","ajma‘īna","all","সবাইকে (একযোগে)"]],"t":"فَنَجَّيْ<m>نَٰ</>هُ وَأَهْلَهُ<o>ۥٓ</> أَ<q>جْ</>مَ<p>عِي</>نَ"},{"n":171,"w":[["إِلَّا","illā","Except","ছাড়া"],["عَجُوزًۭا","‘ajūzan","an old woman","এক বৃদ্ধা (তার স্ত্রী)"],["فِى","fī","(was) among","(সে ছিলো) অন্তর্ভুক্ত"],["ٱلْغَـٰبِرِينَ","l-ghābirīna","those who remained behind","পিছনে অবস্থানকারীদের"]],"t":"إِلَّا عَجُو<k>زًۭا فِ</>ى <h>ٱ</>لْ<m>غَٰ</>بِ<p>رِي</>نَ"},{"n":172,"w":[["ثُمَّ","thumma","Then","এরপর"],["دَمَّرْنَا","dammarnā","We destroyed","আমরা ধ্বংস করলাম"],["ٱلْـَٔاخَرِينَ","l-ākharīna","the others","অন্যদেরকে"]],"t":"ثُ<g>مَّ</> دَ<g>مَّ</>رْنَا <h>ٱ</>لْءَاخَ<p>رِي</>نَ"},{"n":173,"w":[["وَأَمْطَرْنَا","wa-amṭarnā","And We rained","এবং আমরা বর্ষণ করেছিলাম"],["عَلَيْهِم","‘alayhim","upon them","উপর তাদের"],["مَّطَرًۭا ۖ","maṭaran","a rain","এক বর্ষণ (শাস্তিমূলক)"],["فَسَآءَ","fasāa","and evil was","অতএব কত নিকৃষ্ট"],["مَطَرُ","maṭaru","(was) the rain","বর্ষণ"],["ٱلْمُنذَرِينَ","l-mundharīna","(on) those who were warned","সতর্ককৃতদের (জন্যে)"]],"t":"وَأَمْطَرْنَا عَلَيْ<y>هِم مَّ</>طَ<k>رًۭا ۖ فَ</><o>سَآ</>ءَ مَطَرُ <h>ٱ</>لْمُ<k>نذَ</><p>رِي</>نَ"},{"n":174,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে (আছে)"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَةًۭ ۖ","laāyatan","surely is a sign","অবশ্যই নিদর্শন"],["وَمَا","wamā","but not","আর না"],["كَانَ","kāna","are","ছিলো"],["أَكْثَرُهُم","aktharuhum","most of them","অধিকাংশই তাদের"],["مُّؤْمِنِينَ","mu'minīna","believers","মু'মিন"]],"t":"إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَايَ<d>ةًۭ ۖ وَ</>مَا كَانَ أَكْثَرُ<y>هُم مُّ</>ؤْمِ<p>نِي</>نَ"},{"n":175,"w":[["وَإِنَّ","wa-inna","And indeed","অথচ নিশ্চয়ই"],["رَبَّكَ","rabbaka","your Lord","তোমার রব"],["لَهُوَ","lahuwa","surely, He","অবশ্যই তিনি"],["ٱلْعَزِيزُ","l-‘azīzu","(is) the All-Mighty","পরাক্রমশালী"],["ٱلرَّحِيمُ","l-raḥīmu","the Most Merciful","পরম দয়ালু"]],"t":"وَإِ<g>نَّ</> رَبَّكَ لَهُوَ <h>ٱ</>لْعَزِيزُ <h>ٱ</><l>ل</>رَّ<p>حِي</>مُ"},{"n":176,"w":[["كَذَّبَ","kadhaba","Denied","মিথ্যারোপ করেছিলো"],["أَصْحَـٰبُ","aṣḥābu","(the) companions","অধিবাসীরাও"],["لْـَٔيْكَةِ","al'aykati","(of the) Wood","আইকার"],["ٱلْمُرْسَلِينَ","l-mur'salīna","the Messengers","রাসূলদেরকে"]],"t":"كَذَّبَ أَصْ<m>حَٰ</>بُ لْـَٔيْكَةِ <h>ٱ</>لْمُرْسَ<p>لِي</>نَ"},{"n":177,"w":[["إِذْ","idh","When","(স্মরণ করো) যখন"],["قَالَ","qāla","said","বলেছিলো"],["لَهُمْ","lahum","to them","উদ্দেশ্যে তাদের"],["شُعَيْبٌ","shu‘aybun","Shuaib","শু'আইব"],["أَلَا","alā","Will not","\"কি না"],["تَتَّقُونَ","tattaqūna","you fear (Allah)","তোমরা ভয় করবে"]],"t":"إِذْ قَالَ لَهُمْ شُعَيْبٌ أَلَا تَتَّ<p>قُو</>نَ"},{"n":178,"w":[["إِنِّى","innī","Indeed, I am","নিশ্চয়ই আমি"],["لَكُمْ","lakum","to you","জন্যে তোমাদের"],["رَسُولٌ","rasūlun","a Messenger","একজন রাসূল"],["أَمِينٌۭ","amīnun","trustworthy","বিশ্বস্ত"]],"t":"إِ<g>نِّ</>ى لَكُمْ رَسُولٌ أَ<p>مِي</>نٌۭ"},{"n":179,"w":[["فَٱتَّقُوا۟","fa-ittaqū","So fear","অতঃপর তোমরা ভয় করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["وَأَطِيعُونِ","wa-aṭī‘ūni","and obey me","ও তোমরা আমার আনুগত্য করো"]],"t":"فَ<h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</>للَّهَ وَأَطِي<p>عُو</>نِ"},{"n":180,"w":[["وَمَآ","wamā","And not","আর না"],["أَسْـَٔلُكُمْ","asalukum","I ask (of) you","তোমাদের (নিকট) আমি চাচ্ছি"],["عَلَيْهِ","‘alayhi","for it","জন্যে এর"],["مِنْ","min","any","কোনো"],["أَجْرٍ ۖ","ajrin","payment","প্রতিদান"],["إِنْ","in","Not","নেই"],["أَجْرِىَ","ajriya","(is) my payment","আমার প্রতিদান (অন্য কারো নিকট)"],["إِلَّا","illā","except","ছাড়া"],["عَلَىٰ","‘alā","from","নিকট"],["رَبِّ","rabbi","(the) Lord","রবের"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","(of) the worlds","বিশ্বজগতের"]],"t":"وَ<o>مَآ</> أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَ<q>جْ</>رٍ ۖ إِنْ أَ<q>جْ</>رِىَ إِلَّا عَلَىٰ رَبِّ <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":181,"w":[["۞ أَوْفُوا۟","awfū","Give full","তোমরা পূর্ণ দাও"],["ٱلْكَيْلَ","l-kayla","measure","মাপ"],["وَلَا","walā","and (do) not","ও না"],["تَكُونُوا۟","takūnū","be","তোমরা হয়ো"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْمُخْسِرِينَ","l-mukh'sirīna","those who cause loss","মাপে কমদানকারীদের"]],"t":"۞ أَوْفُو<s>ا۟</> <h>ٱ</>لْكَيْلَ وَلَا تَكُونُو<s>ا۟</> مِنَ <h>ٱ</>لْمُخْسِ<p>رِي</>نَ"},{"n":182,"w":[["وَزِنُوا۟","wazinū","And weigh","এবং তোমরা ওজন করবে"],["بِٱلْقِسْطَاسِ","bil-qis'ṭāsi","with a balance","দিয়ে দাঁড়িপাল্লা"],["ٱلْمُسْتَقِيمِ","l-mus'taqīmi","[the] even","সঠিক"]],"t":"وَزِنُو<s>ا۟</> بِ<h>ٱ</>لْقِسْطَاسِ <h>ٱ</>لْمُسْتَ<p>قِي</>مِ"},{"n":183,"w":[["وَلَا","walā","And (do) not","আর না"],["تَبْخَسُوا۟","tabkhasū","deprive","তোমরা কম দিবে"],["ٱلنَّاسَ","l-nāsa","people","মানুষকে"],["أَشْيَآءَهُمْ","ashyāahum","(of) their things","জিনিসগুলোকে তাদের"],["وَلَا","walā","and (do) not","আর না"],["تَعْثَوْا۟","ta‘thaw","commit evil","গোলযোগ সৃষ্টি করো"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["مُفْسِدِينَ","muf'sidīna","spreading corruption","বিপর্যয় সৃষ্টিকারী হিসেবে"]],"t":"وَلَا تَ<q>بْ</>خَسُو<s>ا۟</> <h>ٱ</><l>ل</><g>نَّ</>اسَ أَشْ<o>يَآ</>ءَهُمْ وَلَا تَعْثَوْ<s>ا۟</> فِى <h>ٱ</>لْأَرْضِ مُفْسِ<p>دِي</>نَ"},{"n":184,"w":[["وَٱتَّقُوا۟","wa-ittaqū","And fear","এবং তোমরা ভয় করো"],["ٱلَّذِى","alladhī","the One Who","(তাঁকে) যিনি"],["خَلَقَكُمْ","khalaqakum","created you","সৃষ্টি করেছেন তোমাদেরকে"],["وَٱلْجِبِلَّةَ","wal-jibilata","and the generations","জনগোষ্ঠীকেও"],["ٱلْأَوَّلِينَ","l-awalīna","the former","পুর্ববর্তী\""]],"t":"وَ<h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</>لَّذِى خَلَقَكُمْ وَ<h>ٱ</>لْجِبِلَّةَ <h>ٱ</>لْأَوَّ<p>لِي</>نَ"},{"n":185,"w":[["قَالُوٓا۟","qālū","They said","তারা বলেছিলো"],["إِنَّمَآ","innamā","Only","\"মূলতঃ"],["أَنتَ","anta","you","তুমি"],["مِنَ","mina","(are) of","অন্তর্ভুক্ত"],["ٱلْمُسَحَّرِينَ","l-musaḥarīna","those bewitched","জাদুগ্রস্তদের"]],"t":"قَا<o>لُوٓ</><s>ا۟</> إِ<g>نَّ</><o>مَآ</> أَ<k>نتَ</> مِنَ <h>ٱ</>لْمُسَحَّ<p>رِي</>نَ"},{"n":186,"w":[["وَمَآ","wamā","And not","আর না"],["أَنتَ","anta","you","তুমি"],["إِلَّا","illā","(are) except","এ ছাড়া"],["بَشَرٌۭ","basharun","a man","একজন মানুষ"],["مِّثْلُنَا","mith'lunā","like us","মতো আমাদেরই"],["وَإِن","wa-in","and indeed","আর নিশ্চয়ই"],["نَّظُنُّكَ","naẓunnuka","we think you","তোমাকে আমরা মনেকরি"],["لَمِنَ","lamina","surely (are) of","অবশ্যই অন্তর্ভুক্ত"],["ٱلْكَـٰذِبِينَ","l-kādhibīna","the liars","মিথ্যাবাদীদের"]],"t":"وَ<o>مَآ</> أَ<k>نتَ</> إِلَّا بَشَ<d>رٌۭ مِّ</>ثْلُنَا وَ<d>إِن نَّ</>ظُ<g>نُّ</>كَ لَمِنَ <h>ٱ</>لْ<m>كَٰ</>ذِ<p>بِي</>نَ"},{"n":187,"w":[["فَأَسْقِطْ","fa-asqiṭ","Then cause to fall","অতএব ফেলে দাও"],["عَلَيْنَا","‘alaynā","upon us","উপর আমাদের"],["كِسَفًۭا","kisafan","fragments","এক টুকরো"],["مِّنَ","mina","of","থেকে"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশের"],["إِن","in","if","যদি"],["كُنتَ","kunta","you are","তুমি হও"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلصَّـٰدِقِينَ","l-ṣādiqīna","the truthful","সত্যবাদীদের\""]],"t":"فَأَسْقِ<q>طْ</> عَلَيْنَا كِسَ<d>فًۭا مِّ</>نَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ إِ<k>ن كُنتَ</> مِنَ <h>ٱ</><l>ل</><m>صَّٰ</>دِ<p>قِي</>نَ"},{"n":188,"w":[["قَالَ","qāla","He said","(শু'আইব) বললো"],["رَبِّىٓ","rabbī","My Lord","\"আমার রব"],["أَعْلَمُ","a‘lamu","knows best","খুব জানেন"],["بِمَا","bimā","of what","ঐ বিষয়ে যা"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা করছো\""]],"t":"قَالَ رَ<o>بِّىٓ</> أَعْلَمُ بِمَا تَعْمَ<p>لُو</>نَ"},{"n":189,"w":[["فَكَذَّبُوهُ","fakadhabūhu","But they denied him","অতঃপর তারা তাকে মিথ্যা সাব্যস্ত করলো"],["فَأَخَذَهُمْ","fa-akhadhahum","so seized them","তখন ধরলো তাদেরকে"],["عَذَابُ","‘adhābu","(the) punishment","শাস্তি"],["يَوْمِ","yawmi","(of the) day","দিনের"],["ٱلظُّلَّةِ ۚ","l-ẓulati","(of) the shadow","(ছায়াওয়ালা) মেঘাচ্ছন্ন"],["إِنَّهُۥ","innahu","Indeed, it","নিশ্চয়ই তা"],["كَانَ","kāna","was","ছিলো"],["عَذَابَ","‘adhāba","(the) punishment","শাস্তি"],["يَوْمٍ","yawmin","(of) a Day","দিনের"],["عَظِيمٍ","‘aẓīmin","Great","ভয়াবহ"]],"t":"فَكَذَّبُوهُ فَأَخَذَهُمْ عَذَابُ يَوْمِ <h>ٱ</><l>ل</>ظُّلَّةِ ۚ إِ<g>نَّ</>هُ<m>ۥ</> كَانَ عَذَابَ يَوْمٍ عَ<p>ظِي</>مٍ"},{"n":190,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে (আছে)"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَةًۭ ۖ","laāyatan","surely, is a sign","অবশ্যই নিদর্শন"],["وَمَا","wamā","but not","কিন্তু না"],["كَانَ","kāna","are","ছিলো"],["أَكْثَرُهُم","aktharuhum","most of them","অধিকাংশ তাদের"],["مُّؤْمِنِينَ","mu'minīna","believers","মু'মিন"]],"t":"إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَايَ<d>ةًۭ ۖ وَ</>مَا كَانَ أَكْثَرُ<y>هُم مُّ</>ؤْمِ<p>نِي</>نَ"},{"n":191,"w":[["وَإِنَّ","wa-inna","And indeed","আর নিশ্চয়ই"],["رَبَّكَ","rabbaka","your Lord","তোমার রব"],["لَهُوَ","lahuwa","surely, He","অবশ্যই তিনি"],["ٱلْعَزِيزُ","l-‘azīzu","(is) the All-Mighty","পরাক্রমশালী"],["ٱلرَّحِيمُ","l-raḥīmu","the Most Merciful","পরম দয়ালু"]],"t":"وَإِ<g>نَّ</> رَبَّكَ لَهُوَ <h>ٱ</>لْعَزِيزُ <h>ٱ</><l>ل</>رَّ<p>حِي</>مُ"},{"n":192,"w":[["وَإِنَّهُۥ","wa-innahu","And indeed, it","এবং নিশ্চয়ই তা"],["لَتَنزِيلُ","latanzīlu","surely, is a Revelation","অবশ্যই অবতীর্ণ"],["رَبِّ","rabbi","(of the) Lord","রবের (পক্ষ হ'তে)"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","(of) the worlds","বিশ্বজগতের"]],"t":"وَإِ<g>نَّ</>هُ<m>ۥ</> لَتَ<k>نزِ</>يلُ رَبِّ <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":193,"w":[["نَزَلَ","nazala","Has brought it down","অবতরণ করেছে"],["بِهِ","bihi","Has brought it down","নিয়ে তা"],["ٱلرُّوحُ","l-rūḥu","the Spirit","রূহ (জিবরাঈল)"],["ٱلْأَمِينُ","l-amīnu","[the] Trustworthy","বিশ্বস্ত"]],"t":"نَزَلَ بِهِ <h>ٱ</><l>ل</>رُّوحُ <h>ٱ</>لْأَ<p>مِي</>نُ"},{"n":194,"w":[["عَلَىٰ","‘alā","Upon","উপর"],["قَلْبِكَ","qalbika","your heart","তোমার অন্তরের"],["لِتَكُونَ","litakūna","that you may be","যেন তুমি হও"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْمُنذِرِينَ","l-mundhirīna","the warners","সতর্ককারীদের"]],"t":"عَلَىٰ قَلْبِكَ لِتَكُونَ مِنَ <h>ٱ</>لْمُ<k>نذِ</><p>رِي</>نَ"},{"n":195,"w":[["بِلِسَانٍ","bilisānin","In language","মাধ্যমে ভাষায়"],["عَرَبِىٍّۢ","‘arabiyyin","Arabic","আরবী"],["مُّبِينٍۢ","mubīnin","clear","সুস্পষ্ট"]],"t":"بِلِسَانٍ عَرَبِ<d>ىٍّۢ مُّ</><p>بِي</>نٍۢ"},{"n":196,"w":[["وَإِنَّهُۥ","wa-innahu","And indeed, it","এবং নিশ্চয়ই তা"],["لَفِى","lafī","surely, (is) in","অবশ্যই মধ্যে (আছে)"],["زُبُرِ","zuburi","(the) Scriptures","কিতাবসমূহের"],["ٱلْأَوَّلِينَ","l-awalīna","(of) the former (people)","পুর্ববর্তী"]],"t":"وَإِ<g>نَّ</>هُ<m>ۥ</> لَفِى زُبُرِ <h>ٱ</>لْأَوَّ<p>لِي</>نَ"},{"n":197,"w":[["أَوَلَمْ","awalam","Is it not","কি নি"],["يَكُن","yakun","Is it not","হয়"],["لَّهُمْ","lahum","to them","জন্যে তাদের"],["ءَايَةً","āyatan","a sign","একটি নিদর্শন"],["أَن","an","that","যে"],["يَعْلَمَهُۥ","ya‘lamahu","know it","তা জানে"],["عُلَمَـٰٓؤُا۟","‘ulamāu","(the) scholars","পন্ডিতরা"],["بَنِىٓ","banī","(of the) Children","বনী"],["إِسْرَٰٓءِيلَ","is'rāīla","(of) Israel","ইসরাঈলের"]],"t":"أَوَلَمْ يَ<w>كُن لَّ</>هُمْ ءَايَةً <d>أَن يَ</>عْلَمَهُ<m>ۥ</> عُلَ<o>مَٰٓ</>ؤُ<s>ا۟</> بَ<o>نِىٓ</> إِسْ<o>رَٰٓ</><p>ءِي</>لَ"},{"n":198,"w":[["وَلَوْ","walaw","And if","আর যদি"],["نَزَّلْنَـٰهُ","nazzalnāhu","We (had) revealed it","তা আমরা অবতীর্ণ করতাম"],["عَلَىٰ","‘alā","to","উপর"],["بَعْضِ","ba‘ḍi","any","কারোও"],["ٱلْأَعْجَمِينَ","l-a‘jamīna","(of) the non-Arabs","অনারবদের"]],"t":"وَلَوْ نَزَّلْ<m>نَٰ</>هُ عَلَىٰ بَعْضِ <h>ٱ</>لْأَعْجَ<p>مِي</>نَ"},{"n":199,"w":[["فَقَرَأَهُۥ","faqara-ahu","And he (had) recited it","অতঃপর পাঠ করতো তা"],["عَلَيْهِم","‘alayhim","to them","কাছে তাদের"],["مَّا","mā","not","না"],["كَانُوا۟","kānū","they would","তারা হতো"],["بِهِۦ","bihi","in it","প্রতি তার"],["مُؤْمِنِينَ","mu'minīna","(be) believers","মু'মিন"]],"t":"فَقَرَأَهُ<m>ۥ</> عَلَيْ<y>هِم مَّ</>ا كَانُو<s>ا۟</> بِ<m>هِۦ</> مُؤْمِ<p>نِي</>نَ"},{"n":200,"w":[["كَذَٰلِكَ","kadhālika","Thus","এরূপেই"],["سَلَكْنَـٰهُ","salaknāhu","We have inserted it","তা আমরা সঞ্চার করেছি"],["فِى","fī","into","মধ্যে"],["قُلُوبِ","qulūbi","(the) hearts","অন্তরসমূহের"],["ٱلْمُجْرِمِينَ","l-muj'rimīna","(of) the criminals","অপরাধীদের"]],"t":"كَ<m>ذَٰ</>لِكَ سَلَكْ<m>نَٰ</>هُ فِى قُلُوبِ <h>ٱ</>لْمُ<q>جْ</>رِ<p>مِي</>نَ"},{"n":201,"w":[["لَا","lā","Not","না"],["يُؤْمِنُونَ","yu'minūna","they will believe","তারা ঈমান আনবে"],["بِهِۦ","bihi","in it","প্রতি তার"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["يَرَوُا۟","yarawū","they see","তারা দেখবে"],["ٱلْعَذَابَ","l-‘adhāba","the punishment","শাস্তি"],["ٱلْأَلِيمَ","l-alīma","[the] painful","নিদারুণ"]],"t":"لَا يُؤْمِنُونَ بِ<m>هِۦ</> حَتَّىٰ يَرَوُ<s>ا۟</> <h>ٱ</>لْعَذَابَ <h>ٱ</>لْأَ<p>لِي</>مَ"},{"n":202,"w":[["فَيَأْتِيَهُم","fayatiyahum","And it will come to them","অতঃপর তাদের (উপর) এসে পড়বে"],["بَغْتَةًۭ","baghtatan","suddenly","হঠাৎ করে"],["وَهُمْ","wahum","while they","এমতাবস্হায় যে তারা"],["لَا","lā","(do) not","না"],["يَشْعُرُونَ","yash‘urūna","perceive","অনুভবও করবে"]],"t":"فَيَأْتِيَ<f>هُم بَ</>غْتَ<d>ةًۭ وَ</>هُمْ لَا يَشْعُ<p>رُو</>نَ"},{"n":203,"w":[["فَيَقُولُوا۟","fayaqūlū","Then they will say","তখন তারা বলবে"],["هَلْ","hal","Are","\"কি"],["نَحْنُ","naḥnu","we","আমরা"],["مُنظَرُونَ","munẓarūna","(to be) reprieved","অবকাশপ্রাপ্ত\""]],"t":"فَيَقُولُو<s>ا۟</> هَلْ نَحْنُ مُ<k>نظَ</><p>رُو</>نَ"},{"n":204,"w":[["أَفَبِعَذَابِنَا","afabi‘adhābinā","So is it for Our punishment","কি তবে শাস্তি সম্পর্কে আমাদের"],["يَسْتَعْجِلُونَ","yasta‘jilūna","they wish to hasten","তারা তাড়াহুড়া করছে"]],"t":"أَفَبِعَذَابِنَا يَسْتَعْجِ<p>لُو</>نَ"},{"n":205,"w":[["أَفَرَءَيْتَ","afara-ayta","Then have you seen","কি তবে তুমি ভেবে দেখেছো"],["إِن","in","if","যদি"],["مَّتَّعْنَـٰهُمْ","matta‘nāhum","We let them enjoy","আমরা ভোগবিলাস করতে দিই তাদেরকে"],["سِنِينَ","sinīna","(for) years","(বহু) বছর"]],"t":"أَفَرَءَيْتَ <d>إِن مَّ</>تَّعْ<m>نَٰ</>هُمْ سِ<p>نِي</>نَ"},{"n":206,"w":[["ثُمَّ","thumma","Then","এরপরও"],["جَآءَهُم","jāahum","comes to them","আসে তাদের (নিকট)"],["مَّا","mā","what","যা"],["كَانُوا۟","kānū","they were","তারা ছিলো"],["يُوعَدُونَ","yū‘adūna","promised","তাদেরকে সতর্ক করা হচ্ছে"]],"t":"ثُ<g>مَّ</> <o>جَآ</>ءَ<y>هُم مَّ</>ا كَانُو<s>ا۟</> يُوعَ<p>دُو</>نَ"},{"n":207,"w":[["مَآ","mā","Not","(তাহ'লেও) কি"],["أَغْنَىٰ","aghnā","(will) avail","উপকারে আসবে"],["عَنْهُم","‘anhum","them","জন্যে তাদের"],["مَّا","mā","what","যা কিছু"],["كَانُوا۟","kānū","enjoyment they were given","তারা ছিলো"],["يُمَتَّعُونَ","yumatta‘ūna","enjoyment they were given","তারা উপভোগ করে"]],"t":"<o>مَآ</> أَغْنَىٰ عَنْ<y>هُم مَّ</>ا كَانُو<s>ا۟</> يُمَتَّ<p>عُو</>نَ"},{"n":208,"w":[["وَمَآ","wamā","And not","আর না"],["أَهْلَكْنَا","ahlaknā","We destroyed","আমরা ধ্বংস করেছি"],["مِن","min","any","কোনো"],["قَرْيَةٍ","qaryatin","town","জনপদ"],["إِلَّا","illā","but","এ ছাড়া (যে)"],["لَهَا","lahā","it had","জন্যে তার (এসেছে)"],["مُنذِرُونَ","mundhirūna","warners","সতর্ককারীরা"]],"t":"وَ<o>مَآ</> أَهْلَكْنَا مِ<k>ن قَ</>رْيَةٍ إِلَّا لَهَا مُ<k>نذِ</><p>رُو</>نَ"},{"n":209,"w":[["ذِكْرَىٰ","dhik'rā","(To) remind","উপদেশস্বরূপ"],["وَمَا","wamā","and not","আর না"],["كُنَّا","kunnā","We are","আমরা ছিলাম"],["ظَـٰلِمِينَ","ẓālimīna","unjust","সীমালঙ্ঘনকারী"]],"t":"ذِكْرَىٰ وَمَا كُ<g>نَّ</>ا <m>ظَٰ</>لِ<p>مِي</>نَ"},{"n":210,"w":[["وَمَا","wamā","And not","এবং না"],["تَنَزَّلَتْ","tanazzalat","have brought it down","অবতীর্ণ করেছে"],["بِهِ","bihi","have brought it down","নিয়ে তা"],["ٱلشَّيَـٰطِينُ","l-shayāṭīnu","the devils","শয়তানরা"]],"t":"وَمَا تَنَزَّلَتْ بِهِ <h>ٱ</><l>ل</>شَّ<m>يَٰ</><p>طِي</>نُ"},{"n":211,"w":[["وَمَا","wamā","And not","আর না"],["يَنۢبَغِى","yanbaghī","(it) suits","উচিত"],["لَهُمْ","lahum","[for] them","জন্যে তাদের"],["وَمَا","wamā","and not","আর না"],["يَسْتَطِيعُونَ","yastaṭī‘ūna","they are able","তারা সামর্থ্য রাখে"]],"t":"وَمَا يَ<i>نۢبَ</>غِى لَهُمْ وَمَا يَسْتَطِي<p>عُو</>نَ"},{"n":212,"w":[["إِنَّهُمْ","innahum","Indeed, they","নিশ্চয়ই তাদেরকে"],["عَنِ","‘ani","from","হ'তে"],["ٱلسَّمْعِ","l-sam‘i","the hearing","শোনা"],["لَمَعْزُولُونَ","lama‘zūlūna","(are) surely banished","অবশ্যই দূরে রাখা হয়েছে"]],"t":"إِ<g>نَّ</>هُمْ عَنِ <h>ٱ</><l>ل</>سَّمْعِ لَمَعْزُو<p>لُو</>نَ"},{"n":213,"w":[["فَلَا","falā","So (do) not","অতএব না"],["تَدْعُ","tad‘u","invoke","তুমি ডেকো"],["مَعَ","ma‘a","with","সাথে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["إِلَـٰهًا","ilāhan","god","কোনো ইলাহ"],["ءَاخَرَ","ākhara","another","অন্য"],["فَتَكُونَ","fatakūna","lest you be","তাহ'লে তুমি হবে"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْمُعَذَّبِينَ","l-mu‘adhabīna","those punished","শাস্তিপ্রাপ্তদের"]],"t":"فَلَا تَ<q>دْ</>عُ مَعَ <h>ٱ</>للَّهِ إِ<m>لَٰ</>هًا ءَاخَرَ فَتَكُونَ مِنَ <h>ٱ</>لْمُعَذَّ<p>بِي</>نَ"},{"n":214,"w":[["وَأَنذِرْ","wa-andhir","And warn","এবং সতর্ক করো"],["عَشِيرَتَكَ","‘ashīrataka","your kindred","তোমার আত্মীয় স্বজনদেরকে"],["ٱلْأَقْرَبِينَ","l-aqrabīna","[the] closest","নিকটতম"]],"t":"وَأَ<k>نذِ</>رْ عَشِيرَتَكَ <h>ٱ</>لْأَ<q>قْ</>رَ<p>بِي</>نَ"},{"n":215,"w":[["وَٱخْفِضْ","wa-ikh'fiḍ","And lower","আর অবনত করো (অর্থাৎ বিনয়ী হও)"],["جَنَاحَكَ","janāḥaka","your wing","তোমার বাহু"],["لِمَنِ","limani","to (those) who","জন্যে তাদের (যারা)"],["ٱتَّبَعَكَ","ittaba‘aka","follow you","তোমার অনুসরন করে"],["مِنَ","mina","of","মধ্য হ'তে"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believers","মু'মিনদের"]],"t":"وَ<h>ٱ</>خْفِضْ جَنَاحَكَ لِمَنِ <h>ٱ</>تَّبَعَكَ مِنَ <h>ٱ</>لْمُؤْمِ<p>نِي</>نَ"},{"n":216,"w":[["فَإِنْ","fa-in","Then if","কিন্তু যদি"],["عَصَوْكَ","‘aṣawka","they disobey you","তোমার তারা অবাধ্য হয়"],["فَقُلْ","faqul","then say","তবে বলো"],["إِنِّى","innī","Indeed, I am","\"নিশ্চয়ই আমি"],["بَرِىٓءٌۭ","barīon","innocent","দায়মুক্ত"],["مِّمَّا","mimmā","of what","(তা) হ'তে যা"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা কাজ করছো\""]],"t":"فَإِنْ عَصَوْكَ فَقُلْ إِ<g>نِّ</>ى بَ<o>رِىٓ</><d>ءٌۭ مِّ</><g>مَّ</>ا تَعْمَ<p>لُو</>نَ"},{"n":217,"w":[["وَتَوَكَّلْ","watawakkal","And put (your) trust","এবং নির্ভর করো"],["عَلَى","‘alā","in","(আল্লাহর) উপর"],["ٱلْعَزِيزِ","l-‘azīzi","the All-Mighty","(যিনি) পরাক্রমশালী"],["ٱلرَّحِيمِ","l-raḥīmi","the Most Merciful","পরম দয়ালু"]],"t":"وَتَوَكَّلْ عَلَى <h>ٱ</>لْعَزِيزِ <h>ٱ</><l>ل</>رَّ<p>حِي</>مِ"},{"n":218,"w":[["ٱلَّذِى","alladhī","The One Who","যিনি"],["يَرَىٰكَ","yarāka","sees you","তোমাকে দেখছেন"],["حِينَ","ḥīna","when","যখন"],["تَقُومُ","taqūmu","you stand up","তুমি দাঁড়াও"]],"t":"ٱلَّذِى يَرَ<m>ىٰ</>كَ حِينَ تَ<p>قُو</>مُ"},{"n":219,"w":[["وَتَقَلُّبَكَ","wataqallubaka","And your movements","তোমার গতিবিধি"],["فِى","fī","among","মধ্যে"],["ٱلسَّـٰجِدِينَ","l-sājidīna","those who prostrate","সিজদাকারীদের"]],"t":"وَتَقَلُّبَكَ فِى <h>ٱ</><l>ل</><m>سَّٰ</>جِ<p>دِي</>نَ"},{"n":220,"w":[["إِنَّهُۥ","innahu","Indeed, He","নিশ্চয়ই তিনি"],["هُوَ","huwa","[He]","তিনিই"],["ٱلسَّمِيعُ","l-samī‘u","(is) the All-Hearer","সবকিছু শুনেন"],["ٱلْعَلِيمُ","l-‘alīmu","the All-Knower","সবকিছু জানেন"]],"t":"إِ<g>نَّ</>هُ<m>ۥ</> هُوَ <h>ٱ</><l>ل</>سَّمِيعُ <h>ٱ</>لْعَ<p>لِي</>مُ"},{"n":221,"w":[["هَلْ","hal","Shall","কি"],["أُنَبِّئُكُمْ","unabbi-ukum","I inform you","জানাবো তোমাদেরকে"],["عَلَىٰ","‘alā","upon","উপর"],["مَن","man","whom","কার"],["تَنَزَّلُ","tanazzalu","descend","অবতীর্ণ হয়"],["ٱلشَّيَـٰطِينُ","l-shayāṭīnu","the devils","শয়তানরা"]],"t":"هَلْ أُنَبِّئُكُمْ عَلَىٰ مَ<k>ن تَ</>نَزَّلُ <h>ٱ</><l>ل</>شَّ<m>يَٰ</><p>طِي</>نُ"},{"n":222,"w":[["تَنَزَّلُ","tanazzalu","They descend","অবতীর্ণ হয়"],["عَلَىٰ","‘alā","upon","উপর"],["كُلِّ","kulli","every","প্রত্যেক"],["أَفَّاكٍ","affākin","liar","ঘোর মিথ্যাবাদী"],["أَثِيمٍۢ","athīmin","sinful","পাপীর"]],"t":"تَنَزَّلُ عَلَىٰ كُلِّ أَفَّاكٍ أَ<p>ثِي</>مٍۢ"},{"n":223,"w":[["يُلْقُونَ","yul'qūna","They pass on","(যারা) পেতে রাখে"],["ٱلسَّمْعَ","l-sam‘a","(what is) heard","কান (শয়তানের কথায়)"],["وَأَكْثَرُهُمْ","wa-aktharuhum","and most of them","আর অধিকাংশ তাদের"],["كَـٰذِبُونَ","kādhibūna","(are) liars","মিথ্যাবাদী"]],"t":"يُلْقُونَ <h>ٱ</><l>ل</>سَّمْعَ وَأَكْثَرُهُمْ <m>كَٰ</>ذِ<p>بُو</>نَ"},{"n":224,"w":[["وَٱلشُّعَرَآءُ","wal-shu‘arāu","And the poets ","এবং কবিদের (কথা)"],["يَتَّبِعُهُمُ","yattabi‘uhumu","follow them","অনুসরণ করে তাদেরকে"],["ٱلْغَاوُۥنَ","l-ghāwūna","the deviators","বিভ্রান্তলোকেরা"]],"t":"وَ<h>ٱ</><l>ل</>شُّعَ<o>رَآ</>ءُ يَتَّبِعُهُمُ <h>ٱ</>لْغَاوُ<p>ۥ</>نَ"},{"n":225,"w":[["أَلَمْ","alam","Do not","কি নি"],["تَرَ","tara","you see","তুমি দেখো"],["أَنَّهُمْ","annahum","that they","যে তারা"],["فِى","fī","in","মধ্যে"],["كُلِّ","kulli","every","প্রত্যেক"],["وَادٍۢ","wādin","valley","উপত্যকার"],["يَهِيمُونَ","yahīmūna","[they] roam","উদভ্রান্ত হয়ে ঘুরছে"]],"t":"أَلَمْ تَرَ أَ<g>نَّ</>هُمْ فِى كُلِّ وَا<d>دٍۢ يَ</>هِي<p>مُو</>نَ"},{"n":226,"w":[["وَأَنَّهُمْ","wa-annahum","And that they","এবং (এও) যে তারা"],["يَقُولُونَ","yaqūlūna","say","বলে (এমন কথা)"],["مَا","mā","what","যা"],["لَا","lā","not","না"],["يَفْعَلُونَ","yaf‘alūna","they do","(নিজেরা) তারা করে"]],"t":"وَأَ<g>نَّ</>هُمْ يَقُولُونَ مَا لَا يَفْعَ<p>لُو</>نَ"},{"n":227,"w":[["إِلَّا","illā","Except","তবে (ব্যতিক্রম)"],["ٱلَّذِينَ","alladhīna","those who","(তারা) যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান আনে"],["وَعَمِلُوا۟","wa‘amilū","and do","ও কাজ করে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","righteous deeds","সৎ"],["وَذَكَرُوا۟","wadhakarū","and remember","এবং স্মরণ করে"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["كَثِيرًۭا","kathīran","much","বেশী বেশী"],["وَٱنتَصَرُوا۟","wa-intaṣarū","and defend themselves","এবং প্রতিশোধ নেয়"],["مِنۢ","min","after","থেকে"],["بَعْدِ","ba‘di","after","পর"],["مَا","mā","after","যা"],["ظُلِمُوا۟ ۗ","ẓulimū","they were wronged","তারা নির্যাতিত হ'লে"],["وَسَيَعْلَمُ","wasaya‘lamu","And will come to know","এবং শীঘ্রই জানবে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ظَلَمُوٓا۟","ẓalamū","have wronged","নির্যাতন করেছে"],["أَىَّ","ayya","(to) what","কোনো"],["مُنقَلَبٍۢ","munqalabin","return","প্রত্যাবর্তনস্থলে"],["يَنقَلِبُونَ","yanqalibūna","they will return","তারা প্রত্যাবর্তন করছে"]],"t":"إِلَّا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ وَذَكَرُو<s>ا۟</> <h>ٱ</>للَّهَ كَثِي<d>رًۭا وَ</><h>ٱ</><k>نتَ</>صَرُو<s>ا۟</> <i>مِنۢ بَ</>عْدِ مَا ظُلِمُو<s>ا۟ ۗ</> وَسَيَعْلَمُ <h>ٱ</>لَّذِينَ ظَلَ<o>مُوٓ</><s>ا۟</> أَىَّ مُ<k>نقَ</>لَ<d>بٍۢ يَ</><k>نقَ</>لِ<p>بُو</>نَ"}]}