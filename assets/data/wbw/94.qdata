{"n":94,"a":[{"n":1,"w":[["أَلَمْ","alam","Have not","করি দিই নি?"],["نَشْرَحْ","nashraḥ","We expanded","আমরা উন্মুক্ত"],["لَكَ","laka","for you","তোমার জন্যে"],["صَدْرَكَ","ṣadraka","your breast","তোমার বক্ষকে"]],"t":"أَلَمْ نَشْرَحْ لَكَ صَ<q>دْ</>رَكَ"},{"n":2,"w":[["وَوَضَعْنَا","wawaḍa‘nā","And We removed","এবং আমরা নামিয়েছি"],["عَنكَ","‘anka","from you","তোমার থেকে"],["وِزْرَكَ","wiz'raka","your burden","তোমার ভার"]],"t":"وَوَضَعْنَا عَ<k>نكَ</> وِزْرَكَ"},{"n":3,"w":[["ٱلَّذِىٓ","alladhī","Which","যা"],["أَنقَضَ","anqaḍa","weighed upon","ভেঙ্গে দিচ্ছিলো"],["ظَهْرَكَ","ẓahraka","your back","তোমার পিঠ"]],"t":"ٱلَّ<o>ذِىٓ</> أَ<k>نقَ</>ضَ ظَهْرَكَ"},{"n":4,"w":[["وَرَفَعْنَا","warafa‘nā","And We raised high","ও আমরা সুউচ্চ করেছি"],["لَكَ","laka","for you","তোমার জন্যে"],["ذِكْرَكَ","dhik'raka","your reputation","তোমার খ্যাতি/ স্মরণকে"]],"t":"وَرَفَعْنَا لَكَ ذِكْرَكَ"},{"n":5,"w":[["فَإِنَّ","fa-inna","So indeed","অতএব নিশ্চয়ই"],["مَعَ","ma‘a","with","সাথে"],["ٱلْعُسْرِ","l-‘us'ri","the hardship","কষ্টের"],["يُسْرًا","yus'ran","(is) ease","স্বস্তি (আছে)"]],"t":"فَإِ<g>نَّ</> مَعَ <h>ٱ</>لْعُسْرِ يُسْرًا"},{"n":6,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["مَعَ","ma‘a","with","সাথে"],["ٱلْعُسْرِ","l-‘us'ri","the hardship","কষ্টের"],["يُسْرًۭا","yus'ran","(is) ease","স্বস্তি (আছে)"]],"t":"إِ<g>نَّ</> مَعَ <h>ٱ</>لْعُسْرِ يُسْرًۭا"},{"n":7,"w":[["فَإِذَا","fa-idhā","So when","অতএব যখনই"],["فَرَغْتَ","faraghta","you have finished","তুমি অবসর হও"],["فَٱنصَبْ","fa-inṣab","then labor hard","তুমি তখন ইবাদাত করো"]],"t":"فَإِذَا فَرَغْتَ فَ<h>ٱ</><k>نصَ</><q>بْ</>"},{"n":8,"w":[["وَإِلَىٰ","wa-ilā","And to","এবং প্রতি"],["رَبِّكَ","rabbika","your Lord","তোমার রবের"],["فَٱرْغَب","fa-ir'ghab","turn your attention","তখন মনোনিবেশ করো"]],"t":"وَإِلَىٰ رَبِّكَ فَ<h>ٱ</>رْغَ<q>ب</>"}]}