{"n":43,"a":[{"n":1,"w":[["حمٓ","hha-meem","Ha Meem","হা-মীম"]],"t":"ح<n>مٓ</>"},{"n":2,"w":[["وَٱلْكِتَـٰبِ","wal-kitābi","By the Book","শপথ (এই) কিতাবের"],["ٱلْمُبِينِ","l-mubīni","the clear","সুস্পষ্ট"]],"t":"وَ<h>ٱ</>لْكِ<m>تَٰ</>بِ <h>ٱ</>لْمُ<p>بِي</>نِ"},{"n":3,"w":[["إِنَّا","innā","Indeed, We","নিশ্চয়ই আমরা"],["جَعَلْنَـٰهُ","ja‘alnāhu","(have) made it","তা আমরা বানিয়েছি"],["قُرْءَٰنًا","qur'ānan","a Quran","(অর্থাৎ) কুরআন"],["عَرَبِيًّۭا","‘arabiyyan","(in) Arabic","আরবী (ভাষায়)"],["لَّعَلَّكُمْ","la‘allakum","so that you may","তোমরা যাতে"],["تَعْقِلُونَ","ta‘qilūna","understand","বুঝতে পারো"]],"t":"إِ<g>نَّ</>ا جَعَلْ<m>نَٰ</>هُ قُرْ<m>ءَٰ</>نًا عَرَبِ<w>يًّۭا لَّ</>عَلَّكُمْ تَعْقِ<p>لُو</>نَ"},{"n":4,"w":[["وَإِنَّهُۥ","wa-innahu","And indeed, it","এবং তা নিশ্চয়ই"],["فِىٓ","fī","(is) in","মধ্যে আছে"],["أُمِّ","ummi","(the) Mother","মূল"],["ٱلْكِتَـٰبِ","l-kitābi","(of) the Book","কিতাবের"],["لَدَيْنَا","ladaynā","with Us","আমাদের কাছে"],["لَعَلِىٌّ","la‘aliyyun","surely exalted","অতীব উচ্চ মর্যাদার"],["حَكِيمٌ","ḥakīmun","full of wisdom","অবশ্যই মহান"]],"t":"وَإِ<g>نَّ</>هُ<m>ۥ</> <o>فِىٓ</> أُ<g>مِّ</> <h>ٱ</>لْكِ<m>تَٰ</>بِ لَدَيْنَا لَعَلِىٌّ حَ<p>كِي</>مٌ"},{"n":5,"w":[["أَفَنَضْرِبُ","afanaḍribu","Then should We take away","তবে কি আমরা করবো"],["عَنكُمُ","‘ankumu","from you","তোমাদের থেকে"],["ٱلذِّكْرَ","l-dhik'ra","the Reminder","উপদেশ"],["صَفْحًا","ṣafḥan","disregarding (you)","প্রত্যাহার"],["أَن","an","because","(এ জন্যে) যে"],["كُنتُمْ","kuntum","you are","তোমরা হ'লে"],["قَوْمًۭا","qawman","a people","সম্প্রদায়"],["مُّسْرِفِينَ","mus'rifīna","transgressing","অসংযমী"]],"t":"أَفَنَضْرِبُ عَ<k>نكُ</>مُ <h>ٱ</><l>ل</>ذِّكْرَ صَفْحًا أَ<k>ن كُنتُ</>مْ قَوْ<d>مًۭا مُّ</>سْرِ<p>فِي</>نَ"},{"n":6,"w":[["وَكَمْ","wakam","And how many","এবং কত (বার)"],["أَرْسَلْنَا","arsalnā","We sent","আমরা পাঠিয়েছি"],["مِن","min","of","থেকে"],["نَّبِىٍّۢ","nabiyyin","a Prophet","নাবী"],["فِى","fī","among","মধ্যে"],["ٱلْأَوَّلِينَ","l-awalīna","the former (people)","পূর্ববর্তীদের"]],"t":"وَكَمْ أَرْسَلْنَا <d>مِن نَّ</>بِ<k>ىٍّۢ فِ</>ى <h>ٱ</>لْأَوَّ<p>لِي</>نَ"},{"n":7,"w":[["وَمَا","wamā","And not","এবং না"],["يَأْتِيهِم","yatīhim","came to them","তাদের কাছে এসেছে"],["مِّن","min","any Prophet","(এমন) কোনো"],["نَّبِىٍّ","nabiyyin","any Prophet","নাবী"],["إِلَّا","illā","but","এ ব্যতীত যে"],["كَانُوا۟","kānū","they used to","তারা ছিলো"],["بِهِۦ","bihi","mock at him","তার সাথে"],["يَسْتَهْزِءُونَ","yastahziūna","mock at him","ঠাট্টা-বিদ্রুপ করতো"]],"t":"وَمَا يَأْتِي<y>هِم مِّ</><d>ن نَّ</>بِىٍّ إِلَّا كَانُو<s>ا۟</> بِ<m>هِۦ</> يَسْتَهْزِ<p>ءُو</>نَ"},{"n":8,"w":[["فَأَهْلَكْنَآ","fa-ahlaknā","Then We destroyed","আমরা তাই ধ্বংস করে দিয়েছি"],["أَشَدَّ","ashadda","stronger","(যারা ছিলো) প্রবল"],["مِنْهُم","min'hum","than them","তাদের মধ্য থেকে"],["بَطْشًۭا","baṭshan","(in) power","শক্তিতে"],["وَمَضَىٰ","wamaḍā","and has passed","এবং অতীত হয়েছে"],["مَثَلُ","mathalu","(the) example","অনুরূপ দৃষ্টান্ত"],["ٱلْأَوَّلِينَ","l-awalīna","(of) the former (people)","পূর্ববর্তীদের"]],"t":"فَأَهْلَكْ<o>نَآ</> أَشَدَّ مِنْ<f>هُم بَ</><q>طْ</><d>شًۭا وَ</>مَضَىٰ مَثَلُ <h>ٱ</>لْأَوَّ<p>لِي</>نَ"},{"n":9,"w":[["وَلَئِن","wala-in","And if","এবং অবশ্যই যদি"],["سَأَلْتَهُم","sa-altahum","you ask them","তাদের তুমি প্রশ্ন করো"],["مَّنْ","man","Who","\"কে"],["خَلَقَ","khalaqa","created","সৃষ্টি করেছেন"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশকে"],["وَٱلْأَرْضَ","wal-arḍa","and the earth","ও পৃথিবীকে\""],["لَيَقُولُنَّ","layaqūlunna","They will surely say","তারা বলবে অবশ্যই"],["خَلَقَهُنَّ","khalaqahunna","Created them","\"তাদের সৃষ্টি করেছেন"],["ٱلْعَزِيزُ","l-‘azīzu","the All-Mighty","পরাক্রমশালী"],["ٱلْعَلِيمُ","l-‘alīmu","the All-Knower","মহাজ্ঞানী (আল্লাহ)\""]],"t":"وَلَئِ<k>ن سَ</>أَلْتَ<y>هُم مَّ</>نْ خَلَقَ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضَ لَيَقُولُ<g>نَّ</> خَلَقَهُ<g>نَّ</> <h>ٱ</>لْعَزِيزُ <h>ٱ</>لْعَ<p>لِي</>مُ"},{"n":10,"w":[["ٱلَّذِى","alladhī","The One Who","যিনি"],["جَعَلَ","ja‘ala","made","করেছেন"],["لَكُمُ","lakumu","for you","তোমাদের জন্যে"],["ٱلْأَرْضَ","l-arḍa","the earth","জমিকে"],["مَهْدًۭا","mahdan","a bed","শয্যা (আশ্রয়স্থল)"],["وَجَعَلَ","waja‘ala","and made","এবং করে দিয়েছেন"],["لَكُمْ","lakum","for you","তোমাদের জন্যে"],["فِيهَا","fīhā","therein","তার মধ্যে"],["سُبُلًۭا","subulan","roads","পথসমূহ"],["لَّعَلَّكُمْ","la‘allakum","so that you may","তোমরা যাতে"],["تَهْتَدُونَ","tahtadūna","(be) guided","(গন্তব্যস্থলের) পথ পেতে পারো"]],"t":"ٱلَّذِى جَعَلَ لَكُمُ <h>ٱ</>لْأَرْضَ مَهْ<d>دًۭا وَ</>جَعَلَ لَكُمْ فِيهَا سُبُلًۭ<w>ا لَّ</>عَلَّكُمْ تَهْتَ<p>دُو</>نَ"},{"n":11,"w":[["وَٱلَّذِى","wa-alladhī","And the One Who","এবং যিনি"],["نَزَّلَ","nazzala","sends down","বর্ষণ করেছেন"],["مِنَ","mina","from","থেকে"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশ"],["مَآءًۢ","māan","water","পানি"],["بِقَدَرٍۢ","biqadarin","in (due) measure","পরিমিতভাবে"],["فَأَنشَرْنَا","fa-ansharnā","then We revive","আমরা অতঃপর জীবিত করি"],["بِهِۦ","bihi","with it","তা দিয়ে"],["بَلْدَةًۭ","baldatan","a land","ভূমিকে"],["مَّيْتًۭا ۚ","maytan","dead","মৃত (নিষ্প্রাণ)"],["كَذَٰلِكَ","kadhālika","thus","এভাবেই"],["تُخْرَجُونَ","tukh'rajūna","you will be brought forth","তোমাদের ওঠানো হবে"]],"t":"وَ<h>ٱ</>لَّذِى نَزَّلَ مِنَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ <o>مَآ</><i>ءًۢ بِ</>قَدَ<k>رٍۢ فَأَنشَ</>رْنَا بِ<m>هِۦ</> بَلْدَ<d>ةًۭ مَّ</>يْ<k>تًۭا ۚ كَ</><m>ذَٰ</>لِكَ تُخْرَ<p>جُو</>نَ"},{"n":12,"w":[["وَٱلَّذِى","wa-alladhī","And the One Who","এবং যিনি"],["خَلَقَ","khalaqa","created","সৃষ্টি করেছেন"],["ٱلْأَزْوَٰجَ","l-azwāja","the pairs","জোড়া জোড়া"],["كُلَّهَا","kullahā","all of them","তার প্রত্যেকটি (জিনিসকে)"],["وَجَعَلَ","waja‘ala","and made","এবং সৃষ্টি করেছেন"],["لَكُم","lakum","for you","তোমাদের জন্যে"],["مِّنَ","mina","[of]","কিছু"],["ٱلْفُلْكِ","l-ful'ki","the ships","নৌযান"],["وَٱلْأَنْعَـٰمِ","wal-an‘āmi","and the cattle","ও চতুষ্পদ জন্তু"],["مَا","mā","what","যার (উপর)"],["تَرْكَبُونَ","tarkabūna","you ride","তোমরা চড়তে পারো"]],"t":"وَ<h>ٱ</>لَّذِى خَلَقَ <h>ٱ</>لْأَزْ<m>وَٰ</>جَ كُلَّهَا وَجَعَلَ لَ<y>كُم مِّ</>نَ <h>ٱ</>لْفُلْكِ وَ<h>ٱ</>لْأَنْ<m>عَٰ</>مِ مَا تَرْكَ<p>بُو</>نَ"},{"n":13,"w":[["لِتَسْتَوُۥا۟","litastawū","That you may sit firmly","তোমরা যেন স্হির হয়ে বসতে পারো"],["عَلَىٰ","‘alā","on","উপর"],["ظُهُورِهِۦ","ẓuhūrihi","their backs","তাদের পিঠের"],["ثُمَّ","thumma","then","এরপর"],["تَذْكُرُوا۟","tadhkurū","remember","তোমরা স্মরণ করো"],["نِعْمَةَ","ni‘'mata","(the) favor","অনুগ্রহের (কথা)"],["رَبِّكُمْ","rabbikum","(of) your Lord","তোমাদের রবের"],["إِذَا","idhā","when","যখন"],["ٱسْتَوَيْتُمْ","is'tawaytum","you sit firmly","তোমরা চড়ে বসো"],["عَلَيْهِ","‘alayhi","on them","তার উপর"],["وَتَقُولُوا۟","wataqūlū","and say","এবং তোমরা বলো"],["سُبْحَـٰنَ","sub'ḥāna","Glory be (to)","\"মহান পবিত্র (আল্লাহ)"],["ٱلَّذِى","alladhī","the One Who","যিনি"],["سَخَّرَ","sakhara","(has) subjected","বশ করে দিয়েছেন"],["لَنَا","lanā","to us","আমাদের জন্যে"],["هَـٰذَا","hādhā","this","এটা"],["وَمَا","wamā","and not","এবং না"],["كُنَّا","kunnā","we were","আমরা ছিলাম"],["لَهُۥ","lahu","of it","তাকে"],["مُقْرِنِينَ","muq'rinīna","capable","বশীভূতকারী"]],"t":"لِتَسْتَوُ<m>ۥ</>ا۟ عَلَىٰ ظُهُورِ<m>هِۦ</> ثُ<g>مَّ</> تَذْكُرُو<s>ا۟</> نِعْمَةَ رَبِّكُمْ إِذَا <h>ٱ</>سْتَوَيْتُمْ عَلَيْهِ وَتَقُولُو<s>ا۟</> سُ<q>بْ</><m>حَٰ</>نَ <h>ٱ</>لَّذِى سَخَّرَ لَنَا <m>هَٰ</>ذَا وَمَا كُ<g>نَّ</>ا لَهُ<m>ۥ</> مُ<q>قْ</>رِ<p>نِي</>نَ"},{"n":14,"w":[["وَإِنَّآ","wa-innā","And indeed, we","এবং নিশ্চয়ই আমরা"],["إِلَىٰ","ilā","to","দিকে"],["رَبِّنَا","rabbinā","our Lord","আমাদের রবের"],["لَمُنقَلِبُونَ","lamunqalibūna","will surely return","অবশ্যই প্রত্যাবর্তনকারী\""]],"t":"وَإِ<g>نَّ</><o>آ</> إِلَىٰ رَبِّنَا لَمُ<k>نقَ</>لِ<p>بُو</>نَ"},{"n":15,"w":[["وَجَعَلُوا۟","waja‘alū","But they attribute","এবং (এ সত্ত্বেও) সাব্যস্ত করেছে তারা"],["لَهُۥ","lahu","to Him","তাঁর জন্যে"],["مِنْ","min","from","মধ্য হ'তে (কতককে)"],["عِبَادِهِۦ","‘ibādihi","His slaves","তাঁর দাসদের"],["جُزْءًا ۚ","juz'an","a portion","একটি অংশ"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلْإِنسَـٰنَ","l-insāna","man","মানুষ"],["لَكَفُورٌۭ","lakafūrun","surely (is) clearly ungrateful","অকৃতজ্ঞ অবশ্যই"],["مُّبِينٌ","mubīnun","surely (is) clearly ungrateful","স্পষ্টই"]],"t":"وَجَعَلُو<s>ا۟</> لَهُ<m>ۥ</> مِنْ عِبَادِ<m>هِۦ</> جُزْءًا ۚ إِ<g>نَّ</> <h>ٱ</>لْإِ<k>نسَٰ</>نَ لَكَفُو<d>رٌۭ مُّ</><p>بِي</>نٌ"},{"n":16,"w":[["أَمِ","ami","Or","তবে কি"],["ٱتَّخَذَ","ittakhadha","has He taken","তিনি গ্রহণ করেছেন"],["مِمَّا","mimmā","of what","তা হ'তে যা"],["يَخْلُقُ","yakhluqu","He has created","তিনি সৃষ্টি করেন"],["بَنَاتٍۢ","banātin","daughters","অথচ কন্যারূপে"],["وَأَصْفَىٰكُم","wa-aṣfākum","and He has chosen (for) you","তোমাদেরকে নির্ধারণ করেছেন"],["بِٱلْبَنِينَ","bil-banīna","sons","পুত্রদের দিয়ে"]],"t":"أَمِ <h>ٱ</>تَّخَذَ مِ<g>مَّ</>ا يَخْلُقُ بَنَا<d>تٍۢ وَ</>أَصْفَ<m>ىٰ</><f>كُم بِ</><h>ٱ</>لْبَ<p>نِي</>نَ"},{"n":17,"w":[["وَإِذَا","wa-idhā","And when","অথচ যখন"],["بُشِّرَ","bushira","is given good news","সুসংবাদ দেওয়া হয়"],["أَحَدُهُم","aḥaduhum","(to) one of them","তাদের কাউকে"],["بِمَا","bimā","of what","ঐ বিষয়ে যা"],["ضَرَبَ","ḍaraba","he sets up","সে আরোপ করে"],["لِلرَّحْمَـٰنِ","lilrraḥmāni","for the Most Gracious","দয়াময়ের জন্যে"],["مَثَلًۭا","mathalan","(as) a likeness","(কন্যা গ্রহণের) দৃষ্টান্ত হিসেবে"],["ظَلَّ","ẓalla","becomes","হয়ে যায়"],["وَجْهُهُۥ","wajhuhu","his face","তার মুখমন্ডল"],["مُسْوَدًّۭا","mus'waddan","dark","কালো"],["وَهُوَ","wahuwa","and he","এ অবস্থায় সে"],["كَظِيمٌ","kaẓīmun","(is) filled with grief","দুশ্চিন্তাগ্রস্তও (হয়ে যায়)"]],"t":"وَإِذَا بُشِّرَ أَحَدُ<f>هُم بِ</>مَا ضَرَبَ لِلرَّحْ<m>مَٰ</>نِ مَثَلًۭ<k>ا ظَ</>لَّ وَ<q>جْ</>هُهُ<m>ۥ</> مُسْوَ<d>دًّۭا وَ</>هُوَ كَ<p>ظِي</>مٌ"},{"n":18,"w":[["أَوَمَن","awaman","Then (is one) who","কি (আল্লাহর ভাগে সে সন্তান) যে"],["يُنَشَّؤُا۟","yunasha-u","is brought up","লালিত পালিত হয়"],["فِى","fī","in","মধ্যে"],["ٱلْحِلْيَةِ","l-ḥil'yati","ornaments","অলংকারের"],["وَهُوَ","wahuwa","and he","এবং সে"],["فِى","fī","in","মধ্যে"],["ٱلْخِصَامِ","l-khiṣāmi","the dispute","বিতর্কের"],["غَيْرُ","ghayru","(is) not","নয়"],["مُبِينٍۢ","mubīnin","clear","সুস্পষ্ট"]],"t":"أَوَ<d>مَن يُ</>نَشَّؤُ<s>ا۟</> فِى <h>ٱ</>لْحِلْيَةِ وَهُوَ فِى <h>ٱ</>لْخِصَامِ غَيْرُ مُ<p>بِي</>نٍۢ"},{"n":19,"w":[["وَجَعَلُوا۟","waja‘alū","And they made","এবং তারা গণ্য করে"],["ٱلْمَلَـٰٓئِكَةَ","l-malāikata","the Angels","ফেরেশতাগণকে"],["ٱلَّذِينَ","alladhīna","those who","যারা (এমন যে)"],["هُمْ","hum","themselves","তারা"],["عِبَـٰدُ","‘ibādu","(are) slaves","দাস"],["ٱلرَّحْمَـٰنِ","l-raḥmāni","(of) the Most Gracious","দয়াময়ের"],["إِنَـٰثًا ۚ","ināthan","females","নারীরূপে"],["أَشَهِدُوا۟","ashahidū","Did they witness","কি তারা প্রত্যক্ষ করেছে"],["خَلْقَهُمْ ۚ","khalqahum","their creation","তাদের সৃষ্টি"],["سَتُكْتَبُ","satuk'tabu","Will be recorded","অচিরেই লিখে রাখা হবে"],["شَهَـٰدَتُهُمْ","shahādatuhum","their testimony","তাদের সাক্ষ্য"],["وَيُسْـَٔلُونَ","wayus'alūna","and they will be questioned","এবং তাদের জিজ্ঞেস করা হবে"]],"t":"وَجَعَلُو<s>ا۟</> <h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةَ <h>ٱ</>لَّذِينَ هُمْ عِ<m>بَٰ</>دُ <h>ٱ</><l>ل</>رَّحْ<m>مَٰ</>نِ إِ<m>نَٰ</>ثًا ۚ أَشَهِدُو<s>ا۟</> خَلْقَهُمْ ۚ سَتُكْتَبُ شَ<m>هَٰ</>دَتُهُمْ وَيُسْـَٔ<p>لُو</>نَ"},{"n":20,"w":[["وَقَالُوا۟","waqālū","And they say","এবং তারা বলে"],["لَوْ","law","If","\"যদি"],["شَآءَ","shāa","had willed","ইচ্ছে করতেন"],["ٱلرَّحْمَـٰنُ","l-raḥmānu","the Most Gracious","দয়াময়"],["مَا","mā","we would not have worshipped them","না\""],["عَبَدْنَـٰهُم ۗ","‘abadnāhum","we would not have worshipped them","তাদের আমরা পূজা করতাম\""],["مَّا","mā","Not","নেই"],["لَهُم","lahum","they have","তাদের জন্যে"],["بِذَٰلِكَ","bidhālika","about that","এই সম্পর্কে"],["مِنْ","min","any","কোনো"],["عِلْمٍ ۖ","‘il'min","knowledge","জ্ঞান"],["إِنْ","in","Nothing","না"],["هُمْ","hum","they (do)","তারা"],["إِلَّا","illā","but","এ ব্যতীত"],["يَخْرُصُونَ","yakhruṣūna","lie","আন্দাজ অনুমান করে"]],"t":"وَقَالُو<s>ا۟</> لَوْ <o>شَآ</>ءَ <h>ٱ</><l>ل</>رَّحْ<m>مَٰ</>نُ مَا عَبَ<q>دْ</><m>نَٰ</><y>هُم ۗ مَّ</>ا لَ<f>هُم بِ</><m>ذَٰ</>لِكَ مِنْ عِلْمٍ ۖ إِنْ هُمْ إِلَّا يَخْرُ<p>صُو</>نَ"},{"n":21,"w":[["أَمْ","am","Or","তবে কি"],["ءَاتَيْنَـٰهُمْ","ātaynāhum","have We given them","তাদেরকে আমরা দিয়েছি"],["كِتَـٰبًۭا","kitāban","a book","কোন কিতাব (তার স্বপক্ষে)"],["مِّن","min","before it","থেকে"],["قَبْلِهِۦ","qablihi","before it","এর পূর্বে"],["فَهُم","fahum","so they","অতঃপর তারা"],["بِهِۦ","bihi","to it","তাকে"],["مُسْتَمْسِكُونَ","mus'tamsikūna","(are) holding fast","দৃঢ়ভাবে ধারণকারী"]],"t":"أَمْ ءَاتَيْ<m>نَٰ</>هُمْ كِ<m>تَٰ</><d>بًۭا مِّ</><k>ن قَ</><q>بْ</>لِ<m>هِۦ</> فَ<f>هُم بِ</><m>هِۦ</> مُسْتَمْسِ<p>كُو</>نَ"},{"n":22,"w":[["بَلْ","bal","Nay","(না) বরং"],["قَالُوٓا۟","qālū","they say","তারা বলে"],["إِنَّا","innā","Indeed, we","\"নিশ্চয়ই আমরা"],["وَجَدْنَآ","wajadnā","[we] found","আমরা পেয়েছি"],["ءَابَآءَنَا","ābāanā","our forefathers","আমাদের বাপ-দাদাদেরকে"],["عَلَىٰٓ","‘alā","upon","উপর"],["أُمَّةٍۢ","ummatin","a religion","(এই) মতাদর্শের"],["وَإِنَّا","wa-innā","and indeed, we","ও নিশ্চয়ই আমরা"],["عَلَىٰٓ","‘alā","on","উপর"],["ءَاثَـٰرِهِم","āthārihim","their footsteps","তাদের পদাঙ্কসমূহের"],["مُّهْتَدُونَ","muh'tadūna","(are) guided","সঠিক পথপ্রাপ্ত\""]],"t":"بَلْ قَا<o>لُوٓ</><s>ا۟</> إِ<g>نَّ</>ا وَجَ<q>دْ</><o>نَآ</> ءَا<o>بَآ</>ءَنَا عَلَ<o>ىٰٓ</> أُ<g>مَّ</><d>ةٍۢ وَ</>إِ<g>نَّ</>ا عَلَ<o>ىٰٓ</> ءَا<m>ثَٰ</>رِ<y>هِم مُّ</>هْتَ<p>دُو</>نَ"},{"n":23,"w":[["وَكَذَٰلِكَ","wakadhālika","And thus","এবং এভাবে"],["مَآ","mā","not","না"],["أَرْسَلْنَا","arsalnā","We sent","আমরা পাঠিয়েছি"],["مِن","min","before you","মধ্য হতে"],["قَبْلِكَ","qablika","before you","তোমার পূর্বে"],["فِى","fī","in","মধ্যে"],["قَرْيَةٍۢ","qaryatin","a town","কোন জনপদের"],["مِّن","min","any","কোনো"],["نَّذِيرٍ","nadhīrin","warner","সতর্ককারী"],["إِلَّا","illā","except","এ ব্যতীত যে"],["قَالَ","qāla","said","বলেছিলো"],["مُتْرَفُوهَآ","mut'rafūhā","(the) wealthy ones of it","তার বিত্তশালীরা"],["إِنَّا","innā","Indeed, we","\"নিশ্চয়ই আমরা"],["وَجَدْنَآ","wajadnā","[we] found","আমরা পেয়েছি"],["ءَابَآءَنَا","ābāanā","our forefathers","আমাদের বাপ-দাদাদেরকে"],["عَلَىٰٓ","‘alā","on","উপর"],["أُمَّةٍۢ","ummatin","a religion","(এই) মতাদর্শের"],["وَإِنَّا","wa-innā","and indeed, we","এবং নিশ্চয়ই আমরা"],["عَلَىٰٓ","‘alā","[on]","উপর"],["ءَاثَـٰرِهِم","āthārihim","their footsteps","তাদের পদাঙ্কসমূহের"],["مُّقْتَدُونَ","muq'tadūna","(are) following","অনুসরণকারী\""]],"t":"وَكَ<m>ذَٰ</>لِكَ <o>مَآ</> أَرْسَلْنَا مِ<k>ن قَ</><q>بْ</>لِكَ فِى قَرْيَ<d>ةٍۢ مِّن نَّ</>ذِيرٍ إِلَّا قَالَ مُتْرَفُو<o>هَآ</> إِ<g>نَّ</>ا وَجَ<q>دْ</><o>نَآ</> ءَا<o>بَآ</>ءَنَا عَلَ<o>ىٰٓ</> أُ<g>مَّ</><d>ةٍۢ وَ</>إِ<g>نَّ</>ا عَلَ<o>ىٰٓ</> ءَا<m>ثَٰ</>رِ<y>هِم مُّ</><q>قْ</>تَ<p>دُو</>نَ"},{"n":24,"w":[["۞ قَـٰلَ","qāla","He said","(প্রত্যেক নাবী) বলতো"],["أَوَلَوْ","awalaw","Even if","\"যদিও কি"],["جِئْتُكُم","ji'tukum","I brought you","তোমাদের কাছে আসি"],["بِأَهْدَىٰ","bi-ahdā","better guidance","নিয়ে অধিক নির্ভুল পথ"],["مِمَّا","mimmā","than what","তার চেয়ে যা"],["وَجَدتُّمْ","wajadttum","you found","তোমরা পেয়েছো"],["عَلَيْهِ","‘alayhi","on it","যার উপর"],["ءَابَآءَكُمْ ۖ","ābāakum","your forefathers","তোমাদের বাপ-দাদাদেরকে\""],["قَالُوٓا۟","qālū","They said","তারা বলতো"],["إِنَّا","innā","Indeed, we","\"নিশ্চয়ই আমরা"],["بِمَآ","bimā","with what","যা নিয়ে"],["أُرْسِلْتُم","ur'sil'tum","you are sent","তোমরা প্রেরিত হয়েছো"],["بِهِۦ","bihi","with [it]","তাকে"],["كَـٰفِرُونَ","kāfirūna","(are) disbelievers","প্রত্যাখানকারী\""]],"t":"۞ <m>قَٰ</>لَ أَوَلَوْ جِئْتُ<f>كُم بِ</>أَهْدَىٰ مِ<g>مَّ</>ا وَجَ<j>د</>تُّمْ عَلَيْهِ ءَا<o>بَآ</>ءَكُمْ ۖ قَا<o>لُوٓ</><s>ا۟</> إِ<g>نَّ</>ا بِ<o>مَآ</> أُرْسِلْ<f>تُم بِ</><m>هِۦ كَٰ</>فِ<p>رُو</>نَ"},{"n":25,"w":[["فَٱنتَقَمْنَا","fa-intaqamnā","So We took retribution","আমরা তখন প্রতিশোধ নিয়েছি"],["مِنْهُمْ ۖ","min'hum","from them","তাদের থেকে"],["فَٱنظُرْ","fa-unẓur","Then see","অতঃপর দেখো"],["كَيْفَ","kayfa","how","কেমন"],["كَانَ","kāna","was","ছিলো"],["عَـٰقِبَةُ","‘āqibatu","(the) end","পরিণাম"],["ٱلْمُكَذِّبِينَ","l-mukadhibīna","(of) the deniers","মিথ্যারোপকারীদের (সত্য অমান্যকারীদের)"]],"t":"فَ<h>ٱ</><k>نتَ</>قَمْنَا مِنْهُمْ ۖ فَ<h>ٱ</><k>نظُ</>رْ كَيْفَ كَانَ <m>عَٰ</>قِبَةُ <h>ٱ</>لْمُكَذِّ<p>بِي</>نَ"},{"n":26,"w":[["وَإِذْ","wa-idh","And when","এবং (স্মরণ করো) যখন"],["قَالَ","qāla","Ibrahim Said","বলেছিলো"],["إِبْرَٰهِيمُ","ib'rāhīmu","Ibrahim Said","ইব্রাহীম"],["لِأَبِيهِ","li-abīhi","to his father","তার পিতাকে"],["وَقَوْمِهِۦٓ","waqawmihi","and his people","ও তার জাতিকে"],["إِنَّنِى","innanī","Indeed, I (am)","\"আমি নিশ্চয়ই"],["بَرَآءٌۭ","barāon","disassociated","সম্পর্কমুক্ত"],["مِّمَّا","mimmā","from what","তা হ'তে যার"],["تَعْبُدُونَ","ta‘budūna","you worship","পূজা করছো তোমরা"]],"t":"وَإِذْ قَالَ إِ<q>بْ</><m>رَٰ</>هِيمُ لِأَبِيهِ وَقَوْمِ<o>هِۦٓ</> إِ<g>نَّ</>نِى بَ<o>رَآ</><d>ءٌۭ مِّ</><g>مَّ</>ا تَعْبُ<p>دُو</>نَ"},{"n":27,"w":[["إِلَّا","illā","Except","কিন্তু (এবাদত করি)"],["ٱلَّذِى","alladhī","the One Who","(তার) যিনি"],["فَطَرَنِى","faṭaranī","created me","আমাকে সৃষ্টি করেছেন"],["فَإِنَّهُۥ","fa-innahu","and indeed, He","সুতরাং নিশ্চয়ই তিনি"],["سَيَهْدِينِ","sayahdīni","will guide me","শীঘ্রই আমাকে পথ দেখাবেন\""]],"t":"إِلَّا <h>ٱ</>لَّذِى فَطَرَنِى فَإِ<g>نَّ</>هُ<m>ۥ</> سَيَهْ<p>دِي</>نِ"},{"n":28,"w":[["وَجَعَلَهَا","waja‘alahā","And he made it","এবং তা সে রেখে গিয়েছে"],["كَلِمَةًۢ","kalimatan","a word","একটি বাণী হিসেবে"],["بَاقِيَةًۭ","bāqiyatan","lasting","চিরন্তন"],["فِى","fī","among","মধ্যে"],["عَقِبِهِۦ","‘aqibihi","his descendents","তার পরবর্তীদের"],["لَعَلَّهُمْ","la‘allahum","so that they may","তারা যেন"],["يَرْجِعُونَ","yarji‘ūna","return","ফিরে আসে"]],"t":"وَجَعَلَهَا كَلِمَ<i>ةًۢ بَ</>اقِيَ<k>ةًۭ فِ</>ى عَقِبِ<m>هِۦ</> لَعَلَّهُمْ يَرْجِ<p>عُو</>نَ"},{"n":29,"w":[["بَلْ","bal","Nay","বরং"],["مَتَّعْتُ","matta‘tu","I gave enjoyment","আমি ভোগের সুযোগ দিয়েছি"],["هَـٰٓؤُلَآءِ","hāulāi","(to) these","তাদেরকে"],["وَءَابَآءَهُمْ","waābāahum","and their forefathers","ও তাদের পূর্বপুরুষদেরকে"],["حَتَّىٰ","ḥattā","until","অবশেষে"],["جَآءَهُمُ","jāahumu","came to them","এসেছে তাদের (কাছে)"],["ٱلْحَقُّ","l-ḥaqu","the truth","প্রকৃত সত্য"],["وَرَسُولٌۭ","warasūlun","and a Messenger","এবং রাসূল"],["مُّبِينٌۭ","mubīnun","clear","সুস্পষ্ট"]],"t":"بَلْ مَتَّعْتُ <o>هَٰٓؤُلَآ</>ءِ وَءَا<o>بَآ</>ءَهُمْ حَتَّىٰ <o>جَآ</>ءَهُمُ <h>ٱ</>لْحَقُّ وَرَسُو<d>لٌۭ مُّ</><p>بِي</>نٌۭ"},{"n":30,"w":[["وَلَمَّا","walammā","And when","এবং যখন"],["جَآءَهُمُ","jāahumu","came to them","আসলো তাদের কাছে"],["ٱلْحَقُّ","l-ḥaqu","the truth","প্রকৃত সত্য"],["قَالُوا۟","qālū","they said","তারা বললো"],["هَـٰذَا","hādhā","This","\"এটা"],["سِحْرٌۭ","siḥ'run","(is) magic","যাদু"],["وَإِنَّا","wa-innā","and indeed, we","এবং নিশ্চয়ই আমরা"],["بِهِۦ","bihi","of it","সে বিষয়ে"],["كَـٰفِرُونَ","kāfirūna","(are) disbelievers","অস্বীকারকারী\""]],"t":"وَلَ<g>مَّ</>ا <o>جَآ</>ءَهُمُ <h>ٱ</>لْحَقُّ قَالُو<s>ا۟</> <m>هَٰ</>ذَا سِحْ<d>رٌۭ وَ</>إِ<g>نَّ</>ا بِ<m>هِۦ كَٰ</>فِ<p>رُو</>نَ"},{"n":31,"w":[["وَقَالُوا۟","waqālū","And they say","এবং তারা বললো"],["لَوْلَا","lawlā","Why not","\"কেন না"],["نُزِّلَ","nuzzila","was sent down","অবতীর্ণ হলো"],["هَـٰذَا","hādhā","this","এই"],["ٱلْقُرْءَانُ","l-qur'ānu","the Quran","কুরআন"],["عَلَىٰ","‘alā","to","উপর"],["رَجُلٍۢ","rajulin","a man","এক ব্যক্তির"],["مِّنَ","mina","from","মধ্য হ'তে"],["ٱلْقَرْيَتَيْنِ","l-qaryatayni","the two towns","(মাক্কা ও তায়েফের) দু'টি জনপদের"],["عَظِيمٍ","‘aẓīmin","great","(যে) বড় বা প্রতিপত্তিশালীর\""]],"t":"وَقَالُو<s>ا۟</> لَوْلَا نُزِّلَ <m>هَٰ</>ذَا <h>ٱ</>لْقُرْءَانُ عَلَىٰ رَجُ<d>لٍۢ مِّ</>نَ <h>ٱ</>لْقَرْيَتَيْنِ عَ<p>ظِي</>مٍ"},{"n":32,"w":[["أَهُمْ","ahum","Do they","(তাদেরকে বলো) তারা কি"],["يَقْسِمُونَ","yaqsimūna","distribute","বণ্টন করে"],["رَحْمَتَ","raḥmata","(the) Mercy","(দয়া-করুণা) অনুগ্রহ"],["رَبِّكَ ۚ","rabbika","(of) your Lord","তোমার রবের"],["نَحْنُ","naḥnu","We","আমরা"],["قَسَمْنَا","qasamnā","[We] distribute","বণ্টন করি"],["بَيْنَهُم","baynahum","among them","তাদের মাঝে"],["مَّعِيشَتَهُمْ","ma‘īshatahum","their livelihood","তাদের জীবিকা"],["فِى","fī","in","মধ্যে"],["ٱلْحَيَوٰةِ","l-ḥayati","the life","জীবনের"],["ٱلدُّنْيَا ۚ","l-dun'yā","(of) the world","পার্থিব"],["وَرَفَعْنَا","warafa‘nā","and We raise","ও আমরা উন্নত করি"],["بَعْضَهُمْ","ba‘ḍahum","some of them","তাদের কাউকে"],["فَوْقَ","fawqa","above","উপর"],["بَعْضٍۢ","ba‘ḍin","others","কারও"],["دَرَجَـٰتٍۢ","darajātin","(in) degrees","মর্যাদাসমূহে"],["لِّيَتَّخِذَ","liyattakhidha","so that may take","গ্রহণ করে যেন"],["بَعْضُهُم","ba‘ḍuhum","some of them","তাদের একে"],["بَعْضًۭا","ba‘ḍan","others","অপরকে"],["سُخْرِيًّۭا ۗ","sukh'riyyan","(for) service","সেবকরূপে"],["وَرَحْمَتُ","waraḥmatu","But (the) Mercy","আর অনুগ্রহ"],["رَبِّكَ","rabbika","(of) your Lord","তোমার রবের"],["خَيْرٌۭ","khayrun","(is) better","উত্তম"],["مِّمَّا","mimmā","than what","তা হ'তে যা"],["يَجْمَعُونَ","yajma‘ūna","they accumulate","তারা জমা করছে"]],"t":"أَهُمْ يَ<q>قْ</>سِمُونَ رَحْمَتَ رَبِّكَ ۚ نَحْنُ قَسَمْنَا بَيْنَ<y>هُم مَّ</>عِيشَتَهُمْ فِى <h>ٱ</>لْحَيَ<s>وٰ</>ةِ <h>ٱ</><l>ل</>دُّنْيَا ۚ وَرَفَعْنَا بَعْضَهُمْ فَوْقَ بَعْ<k>ضٍۢ دَ</>رَ<m>جَٰ</><w>تٍۢ لِّ</>يَتَّخِذَ بَعْضُ<f>هُم بَ</>عْ<k>ضًۭا سُ</>خْرِ<d>يًّۭا ۗ وَ</>رَحْمَتُ رَبِّكَ خَيْ<d>رٌۭ مِّ</><g>مَّ</>ا يَ<q>جْ</>مَ<p>عُو</>نَ"},{"n":33,"w":[["وَلَوْلَآ","walawlā","And if not","এবং না যদি (আশংকা থাকতো)"],["أَن","an","that","যে"],["يَكُونَ","yakūna","(would) become","হবে"],["ٱلنَّاسُ","l-nāsu","[the] mankind","সব মানুষ"],["أُمَّةًۭ","ummatan","a community","মতাবলম্বী"],["وَٰحِدَةًۭ","wāḥidatan","one","একই (কুফরীর ক্ষেত্রে)"],["لَّجَعَلْنَا","laja‘alnā","We (would have) made","দিতাম অবশ্যই আমরা বানিয়ে"],["لِمَن","liman","for (one) who","(তাদের) জন্যে যারা"],["يَكْفُرُ","yakfuru","disbelieves","অস্বীকার করে"],["بِٱلرَّحْمَـٰنِ","bil-raḥmāni","in the Most Gracious","দয়াময়কে"],["لِبُيُوتِهِمْ","libuyūtihim","for their houses","জন্যে তাদের ঘরগুলোর"],["سُقُفًۭا","suqufan","roofs","ছাদসমূহকে"],["مِّن","min","of","দিয়ে"],["فِضَّةٍۢ","fiḍḍatin","silver","রূপা"],["وَمَعَارِجَ","wama‘ārija","and stairways","ও সিঁড়িগুলো"],["عَلَيْهَا","‘alayhā","upon which","যার উপর"],["يَظْهَرُونَ","yaẓharūna","they mount","তারা চড়ে"]],"t":"وَلَوْ<o>لَآ</> <d>أَن يَ</>كُونَ <h>ٱ</><l>ل</><g>نَّ</>اسُ أُ<g>مَّ</><d>ةًۭ وَٰ</>حِدَ<w>ةًۭ لَّ</>جَعَلْنَا لِ<d>مَن يَ</>كْفُرُ بِ<h>ٱ</><l>ل</>رَّحْ<m>مَٰ</>نِ لِبُيُوتِهِمْ سُقُ<d>فًۭا مِّ</><k>ن فِ</>ضَّ<d>ةٍۢ وَ</>مَعَارِجَ عَلَيْهَا يَظْهَ<p>رُو</>نَ"},{"n":34,"w":[["وَلِبُيُوتِهِمْ","walibuyūtihim","And for their houses","ও জন্যে তাদের ঘরগুলোর"],["أَبْوَٰبًۭا","abwāban","doors","দরজাসমূহকে"],["وَسُرُرًا","wasururan","and couches","ও পালঙ্কসমূহকে"],["عَلَيْهَا","‘alayhā","upon which","যার উপর"],["يَتَّكِـُٔونَ","yattakiūna","they recline","তারা হেলান দেয়"]],"t":"وَلِبُيُوتِهِمْ أَ<q>بْ</><m>وَٰ</><d>بًۭا وَ</>سُرُرًا عَلَيْهَا يَتَّ<p>كِـُٔو</>نَ"},{"n":35,"w":[["وَزُخْرُفًۭا ۚ","wazukh'rufan","And ornaments of gold","ও সোনার (বানাতাম)"],["وَإِن","wa-in","And not (is)","এবং নয়"],["كُلُّ","kullu","all","প্রতি"],["ذَٰلِكَ","dhālika","that","এসব"],["لَمَّا","lammā","but","এ ব্যতীত"],["مَتَـٰعُ","matā‘u","an enjoyment","ভোগসম্ভার"],["ٱلْحَيَوٰةِ","l-ḥayati","(of) the life","জীবনের"],["ٱلدُّنْيَا ۚ","l-dun'yā","(of) the world","পার্থিব"],["وَٱلْـَٔاخِرَةُ","wal-ākhiratu","And the Hereafter","আর পরকালই"],["عِندَ","‘inda","with","কাছে"],["رَبِّكَ","rabbika","your Lord","তোমার রবের"],["لِلْمُتَّقِينَ","lil'muttaqīna","(is) for the righteous","মুত্তাকীদের জন্য (নির্দিষ্ট)"]],"t":"وَزُخْرُ<d>فًۭا ۚ وَ</>إِ<k>ن كُ</>لُّ <m>ذَٰ</>لِكَ لَ<g>مَّ</>ا مَ<m>تَٰ</>عُ <h>ٱ</>لْحَيَ<s>وٰ</>ةِ <h>ٱ</><l>ل</>دُّنْيَا ۚ وَ<h>ٱ</>لْءَاخِرَةُ عِ<k>ندَ</> رَبِّكَ لِلْمُتَّ<p>قِي</>نَ"},{"n":36,"w":[["وَمَن","waman","And whoever","এবং যে"],["يَعْشُ","ya‘shu","turns away","বিমুখ হয়"],["عَن","‘an","from","হ'তে"],["ذِكْرِ","dhik'ri","(the) remembrance","স্মরণ"],["ٱلرَّحْمَـٰنِ","l-raḥmāni","(of) the Most Gracious","দয়াময়ের"],["نُقَيِّضْ","nuqayyiḍ","We appoint","নিয়োজিত করি আমরা"],["لَهُۥ","lahu","for him","তার জন্যে"],["شَيْطَـٰنًۭا","shayṭānan","a devil","শয়তানকে"],["فَهُوَ","fahuwa","then he","তখন সে"],["لَهُۥ","lahu","(is) to him","তার জন্যে হয়"],["قَرِينٌۭ","qarīnun","a companion","সঙ্গী"]],"t":"وَ<d>مَن يَ</>عْشُ عَ<k>ن ذِ</>كْرِ <h>ٱ</><l>ل</>رَّحْ<m>مَٰ</>نِ نُقَيِّضْ لَهُ<m>ۥ</> شَيْ<m>طَٰ</><k>نًۭا فَ</>هُوَ لَهُ<m>ۥ</> قَ<p>رِي</>نٌۭ"},{"n":37,"w":[["وَإِنَّهُمْ","wa-innahum","And indeed, they","এবং নিশ্চয়ই তারা"],["لَيَصُدُّونَهُمْ","layaṣuddūnahum","surely, turn them","তাদেরকে বাধা দেয় অবশ্যই"],["عَنِ","‘ani","from","হ'তে"],["ٱلسَّبِيلِ","l-sabīli","the Path","(হেদায়াতের) পথ"],["وَيَحْسَبُونَ","wayaḥsabūna","and they think","ও তারা মনে করে"],["أَنَّهُم","annahum","that they","যে তারা"],["مُّهْتَدُونَ","muh'tadūna","(are) guided","সঠিক পথপ্রাপ্ত"]],"t":"وَإِ<g>نَّ</>هُمْ لَيَصُدُّونَهُمْ عَنِ <h>ٱ</><l>ل</>سَّبِيلِ وَيَحْسَبُونَ أَ<g>نَّ</><y>هُم مُّ</>هْتَ<p>دُو</>نَ"},{"n":38,"w":[["حَتَّىٰٓ","ḥattā","Until","শেষপর্যন্ত"],["إِذَا","idhā","when","যখন"],["جَآءَنَا","jāanā","he comes to Us","আমাদের কাছে আসবে"],["قَالَ","qāla","he says","বলবে (শয়তানকে)"],["يَـٰلَيْتَ","yālayta","O would that","\"হায়"],["بَيْنِى","baynī","between me","আমার মাঝে"],["وَبَيْنَكَ","wabaynaka","and between you","ও তোমার মাঝে (থাকতো)"],["بُعْدَ","bu‘'da","(were the) distance","দুরত্ব"],["ٱلْمَشْرِقَيْنِ","l-mashriqayni","(of) the East and the West","পূর্ব ও পশ্চিমের\""],["فَبِئْسَ","fabi'sa","How wretched is","অতএব কত নিকৃষ্ট"],["ٱلْقَرِينُ","l-qarīnu","the companion","সঙ্গী (শয়তান)"]],"t":"حَتَّ<o>ىٰٓ</> إِذَا <o>جَآ</>ءَنَا قَالَ <m>يَٰ</>لَيْتَ بَيْنِى وَبَيْنَكَ بُعْدَ <h>ٱ</>لْمَشْرِقَيْنِ فَبِئْسَ <h>ٱ</>لْقَ<p>رِي</>نُ"},{"n":39,"w":[["وَلَن","walan","And never","এবং (বলা হবে) কখনও না"],["يَنفَعَكُمُ","yanfa‘akumu","will benefit you","তোমাদের কল্যাণ দিবে"],["ٱلْيَوْمَ","l-yawma","the Day","আজ (তোমাদের অনুতাপ)"],["إِذ","idh","when","যখন"],["ظَّلَمْتُمْ","ẓalamtum","you have wronged","তোমরা সীমালঙ্ঘন করেছো"],["أَنَّكُمْ","annakum","that you","(এও) যে তোমরা"],["فِى","fī","(will be) in","মধ্যে হবে"],["ٱلْعَذَابِ","l-‘adhābi","the punishment","শাস্তির"],["مُشْتَرِكُونَ","mush'tarikūna","sharing","(তোমরা ও শয়তান) সমঅংশ গ্রহণকারী"]],"t":"وَ<d>لَن يَ</><k>نفَ</>عَكُمُ <h>ٱ</>لْيَوْمَ إِ<j>ذ</> ظَّلَمْتُمْ أَ<g>نَّ</>كُمْ فِى <h>ٱ</>لْعَذَابِ مُشْتَرِ<p>كُو</>نَ"},{"n":40,"w":[["أَفَأَنتَ","afa-anta","Then can you","(হে নাবী) তুমি তবে কি"],["تُسْمِعُ","tus'mi‘u","cause to hear","শুনাবে"],["ٱلصُّمَّ","l-ṣuma","the deaf","বধিরকে"],["أَوْ","aw","or","বা"],["تَهْدِى","tahdī","guide","পথ দেখাবে"],["ٱلْعُمْىَ","l-‘um'ya","the blind","অন্ধকে"],["وَمَن","waman","and (one) who","এবং (তাকে) যে"],["كَانَ","kāna","is","আছে"],["فِى","fī","in","মধ্যে"],["ضَلَـٰلٍۢ","ḍalālin","an error","বিভ্রান্তির"],["مُّبِينٍۢ","mubīnin","clear","সুস্পষ্ট"]],"t":"أَفَأَ<k>نتَ</> تُسْمِعُ <h>ٱ</><l>ل</>صُّ<g>مَّ</> أَوْ تَهْدِى <h>ٱ</>لْعُمْىَ وَمَ<k>ن كَ</>انَ فِى ضَ<m>لَٰ</><d>لٍۢ مُّ</><p>بِي</>نٍۢ"},{"n":41,"w":[["فَإِمَّا","fa-immā","And whether","সুতরাং যদি"],["نَذْهَبَنَّ","nadhhabanna","We take you away","আমরা উঠিয়ে নিই"],["بِكَ","bika","We take you away","তোমাকে"],["فَإِنَّا","fa-innā","then indeed, We","নিশ্চয় তবুও আমরা"],["مِنْهُم","min'hum","from them","তাদের হাতে"],["مُّنتَقِمُونَ","muntaqimūna","(will) take retribution","প্রতিশোধ গ্রহণকারী (অর্থাৎ শাস্তি দিবো)"]],"t":"فَإِ<g>مَّ</>ا نَذْهَبَ<g>نَّ</> بِكَ فَإِ<g>نَّ</>ا مِنْ<y>هُم مُّ</><k>نتَ</>قِ<p>مُو</>نَ"},{"n":42,"w":[["أَوْ","aw","Or","অথবা"],["نُرِيَنَّكَ","nuriyannaka","We show you","তোমাকে দেখাই আমরা"],["ٱلَّذِى","alladhī","that which","যা"],["وَعَدْنَـٰهُمْ","wa‘adnāhum","We have promised them","তাদেরকে আমরা প্রতিশ্রুতি দিয়েছি"],["فَإِنَّا","fa-innā","then indeed, We","তবুও আমরা নিশ্চয়ই"],["عَلَيْهِم","‘alayhim","over them","তাদের উপর"],["مُّقْتَدِرُونَ","muq'tadirūna","have full power","পূর্ণ ক্ষমতাবান"]],"t":"أَوْ نُرِيَ<g>نَّ</>كَ <h>ٱ</>لَّذِى وَعَ<q>دْ</><m>نَٰ</>هُمْ فَإِ<g>نَّ</>ا عَلَيْ<y>هِم مُّ</><q>قْ</>تَدِ<p>رُو</>نَ"},{"n":43,"w":[["فَٱسْتَمْسِكْ","fa-is'tamsik","So hold fast","তুমি অতএব দৃঢ়ভাবে ধারণ করো"],["بِٱلَّذِىٓ","bi-alladhī","to that which","তার ওপর যা"],["أُوحِىَ","ūḥiya","is revealed","ওহী করা হয়েছে"],["إِلَيْكَ ۖ","ilayka","to you","তোমার প্রতি"],["إِنَّكَ","innaka","Indeed, you","তুমি নিশ্চয়ই (আছো)"],["عَلَىٰ","‘alā","(are) on","উপর"],["صِرَٰطٍۢ","ṣirāṭin","a Path","পথের"],["مُّسْتَقِيمٍۢ","mus'taqīmin","Straight","সরল সঠিক"]],"t":"فَ<h>ٱ</>سْتَمْسِكْ بِ<h>ٱ</>لَّ<o>ذِىٓ</> أُوحِىَ إِلَيْكَ ۖ إِ<g>نَّ</>كَ عَلَىٰ صِ<m>رَٰ</><d>طٍۢ مُّ</>سْتَ<p>قِي</>مٍۢ"},{"n":44,"w":[["وَإِنَّهُۥ","wa-innahu","And indeed, it","এবং তা নিশ্চয়ই"],["لَذِكْرٌۭ","ladhik'run","(is) surely, a Reminder","অবশ্যই সম্মানের বিষয়"],["لَّكَ","laka","for you","তোমার জন্যে"],["وَلِقَوْمِكَ ۖ","waliqawmika","and your people","এবং তোমার জাতির জন্যে"],["وَسَوْفَ","wasawfa","and soon","এবং শীঘ্রই"],["تُسْـَٔلُونَ","tus'alūna","you will be questioned","তোমরা জিজ্ঞাসিত হবে"]],"t":"وَإِ<g>نَّ</>هُ<m>ۥ</> لَذِكْ<w>رٌۭ لَّ</>كَ وَلِقَوْمِكَ ۖ وَسَوْفَ تُسْـَٔ<p>لُو</>نَ"},{"n":45,"w":[["وَسْـَٔلْ","wasal","And ask","এবং জিজ্ঞেস করো"],["مَنْ","man","(those) whom","যাদেরকে"],["أَرْسَلْنَا","arsalnā","We sent","আমরা পাঠিয়েছি"],["مِن","min","before you","মধ্য হতে"],["قَبْلِكَ","qablika","before you","তোমার পূর্বে"],["مِن","min","of","মধ্য হ'তে"],["رُّسُلِنَآ","rusulinā","Our Messengers","আমাদের রাসূলগণের"],["أَجَعَلْنَا","aja‘alnā","did We make","আমরা  নির্দিষ্ট করেছি কি"],["مِن","min","besides","মধ্য হতে"],["دُونِ","dūni","besides","ব্যতীত"],["ٱلرَّحْمَـٰنِ","l-raḥmāni","the Most Gracious","দয়াময়"],["ءَالِهَةًۭ","ālihatan","gods","(অন্য কোন) উপাস্যকে"],["يُعْبَدُونَ","yu‘'badūna","to be worshipped","উপাসনা করা হবে (যার)"]],"t":"وَسْـَٔلْ مَنْ أَرْسَلْنَا مِ<k>ن قَ</><q>بْ</>لِكَ <w>مِن رُّ</>سُلِ<o>نَآ</> أَجَعَلْنَا مِ<k>ن دُ</>ونِ <h>ٱ</><l>ل</>رَّحْ<m>مَٰ</>نِ ءَالِهَ<d>ةًۭ يُ</>عْبَ<p>دُو</>نَ"},{"n":46,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["أَرْسَلْنَا","arsalnā","We sent","আমরা পাঠিয়েছি"],["مُوسَىٰ","mūsā","Musa","মূসাকে"],["بِـَٔايَـٰتِنَآ","biāyātinā","with Our Signs","আমাদের নির্দেশনাবলীসহ"],["إِلَىٰ","ilā","to","প্রতি"],["فِرْعَوْنَ","fir'‘awna","Firaun","ফিরআউনের"],["وَمَلَإِي۟هِۦ","wamala-ihi","and his chiefs","ও তার পারিষদবর্গের"],["فَقَالَ","faqāla","and he said","তখন সে বললো"],["إِنِّى","innī","Indeed, I am","\"আমি নিশ্চয়ই"],["رَسُولُ","rasūlu","a Messenger","রাসূল"],["رَبِّ","rabbi","(of the) Lord","রবের"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","(of) the worlds","বিশ্ব জগতের\""]],"t":"وَلَقَ<q>دْ</> أَرْسَلْنَا مُوسَىٰ بِـَٔا<m>يَٰ</>تِ<o>نَآ</> إِلَىٰ فِرْعَوْنَ وَمَلَإِ<s>ي۟</><m>هِۦ</> فَقَالَ إِ<g>نِّ</>ى رَسُولُ رَبِّ <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":47,"w":[["فَلَمَّا","falammā","But when","অতঃপর যখন"],["جَآءَهُم","jāahum","he came to them","তাদের কাছে আসলো"],["بِـَٔايَـٰتِنَآ","biāyātinā","with Our Signs","আমাদের নির্দেশনাবলীসহ"],["إِذَا","idhā","behold","তখন"],["هُم","hum","They","তারা"],["مِّنْهَا","min'hā","at them","তা হ'তে"],["يَضْحَكُونَ","yaḍḥakūna","laughed","হাসিঠাট্টা করতে লাগলো"]],"t":"فَلَ<g>مَّ</>ا <o>جَآ</>ءَ<f>هُم بِـَٔ</>ا<m>يَٰ</>تِ<o>نَآ</> إِذَا <y>هُم مِّ</>نْهَا يَضْحَ<p>كُو</>نَ"},{"n":48,"w":[["وَمَا","wamā","And not","এবং না"],["نُرِيهِم","nurīhim","We showed them","তাদের দেখাই আমরা"],["مِّنْ","min","of","কোনো"],["ءَايَةٍ","āyatin","a Sign","নিদর্শন"],["إِلَّا","illā","but","এছাড়া যে"],["هِىَ","hiya","it","তা ছিলো"],["أَكْبَرُ","akbaru","(was) greater","উৎকৃষ্ট"],["مِنْ","min","than","চেয়ে"],["أُخْتِهَا ۖ","ukh'tihā","its sister","তার (পূর্বেকার) অনুরূপ"],["وَأَخَذْنَـٰهُم","wa-akhadhnāhum","and We seized them","এবং তাদেরকে আমরা ধরেছিলাম"],["بِٱلْعَذَابِ","bil-‘adhābi","with the punishment","শাস্তি দিয়ে"],["لَعَلَّهُمْ","la‘allahum","so that they may","তারা যাতে"],["يَرْجِعُونَ","yarji‘ūna","return","ফিরে আসে"]],"t":"وَمَا نُرِي<y>هِم مِّ</>نْ ءَايَةٍ إِلَّا هِىَ أَكْبَرُ مِنْ أُخْتِهَا ۖ وَأَخَذْ<m>نَٰ</><f>هُم بِ</><h>ٱ</>لْعَذَابِ لَعَلَّهُمْ يَرْجِ<p>عُو</>نَ"},{"n":49,"w":[["وَقَالُوا۟","waqālū","And they said","এবং (প্রত্যেকবার) তারা বলেছিলো"],["يَـٰٓأَيُّهَ","yāayyuha","O","\"হে"],["ٱلسَّاحِرُ","l-sāḥiru","[the] magician","যাদুকর"],["ٱدْعُ","ud'‘u","Invoke","দু'আ করো"],["لَنَا","lanā","for us","আমাদের জন্যে"],["رَبَّكَ","rabbaka","your Lord","তোমার রবের কাছে"],["بِمَا","bimā","by what","তার ভিত্তিতে যা"],["عَهِدَ","‘ahida","He has made covenant","অঙ্গীকার করেছেন"],["عِندَكَ","‘indaka","with you","তোমাকে"],["إِنَّنَا","innanā","Indeed, we","আমরা নিশ্চয়ই"],["لَمُهْتَدُونَ","lamuh'tadūna","(will) surely be guided","সৎপথপ্রাপ্ত হবো অবশ্যই\""]],"t":"وَقَالُو<s>ا۟</> <o>يَٰٓ</>أَيُّهَ <h>ٱ</><l>ل</>سَّاحِرُ <h>ٱ</><q>دْ</>عُ لَنَا رَبَّكَ بِمَا عَهِدَ عِ<k>ندَ</>كَ إِ<g>نَّ</>نَا لَمُهْتَ<p>دُو</>نَ"},{"n":50,"w":[["فَلَمَّا","falammā","But when","কিন্তু যখন"],["كَشَفْنَا","kashafnā","We removed","আমরা দূর করলাম"],["عَنْهُمُ","‘anhumu","from them","তাদের হ'তে"],["ٱلْعَذَابَ","l-‘adhāba","the punishment","শাস্তি"],["إِذَا","idhā","behold","তখনই"],["هُمْ","hum","They","তারা"],["يَنكُثُونَ","yankuthūna","broke (their word)","অঙ্গীকার ভঙ্গ করে"]],"t":"فَلَ<g>مَّ</>ا كَشَفْنَا عَنْهُمُ <h>ٱ</>لْعَذَابَ إِذَا هُمْ يَ<k>نكُ</><p>ثُو</>نَ"},{"n":51,"w":[["وَنَادَىٰ","wanādā","And called out","এবং (একদিন) ডেকে বললো"],["فِرْعَوْنُ","fir'‘awnu","Firaun","ফিরআউন"],["فِى","fī","among","মধ্যে"],["قَوْمِهِۦ","qawmihi","his people","তার জাতির"],["قَالَ","qāla","he said","সে বললো"],["يَـٰقَوْمِ","yāqawmi","O my people","\"হে জাতি আমার"],["أَلَيْسَ","alaysa","Is not","নয় কি"],["لِى","lī","for me","আমারই"],["مُلْكُ","mul'ku","(the) kingdom","রাজত্ব"],["مِصْرَ","miṣ'ra","(of) Egypt","মিসরে"],["وَهَـٰذِهِ","wahādhihi","and these","এবং এই"],["ٱلْأَنْهَـٰرُ","l-anhāru","[the] rivers","নদীগুলো"],["تَجْرِى","tajrī","flowing","বয়ে যায় (নাকি)"],["مِن","min","underneath me","থেকে"],["تَحْتِىٓ ۖ","taḥtī","underneath me","আমার অধীনে"],["أَفَلَا","afalā","Then do not","তবে কি না"],["تُبْصِرُونَ","tub'ṣirūna","you see","তোমরা দেখতে পাও"]],"t":"وَنَادَىٰ فِرْعَوْنُ فِى قَوْمِ<m>هِۦ</> قَالَ <m>يَٰ</>قَوْمِ أَلَيْسَ لِى مُلْكُ مِصْرَ وَ<m>هَٰ</>ذِهِ <h>ٱ</>لْأَنْ<m>هَٰ</>رُ تَ<q>جْ</>رِى مِ<k>ن تَ</>حْ<o>تِىٓ ۖ</> أَفَلَا تُ<q>بْ</>صِ<p>رُو</>نَ"},{"n":52,"w":[["أَمْ","am","Or","অথবা"],["أَنَا۠","anā","am I","আমি (নই কি)"],["خَيْرٌۭ","khayrun","better","উত্তম"],["مِّنْ","min","than","চেয়ে"],["هَـٰذَا","hādhā","this","এই (মুসার)"],["ٱلَّذِى","alladhī","one who ","(এমন) যে"],["هُوَ","huwa","he","সে"],["مَهِينٌۭ","mahīnun","(is) insignificant","হীন"],["وَلَا","walā","and hardly","এবং না"],["يَكَادُ","yakādu","and hardly","প্রায়"],["يُبِينُ","yubīnu","clear","স্পষ্ট বর্ণনা করতে পারে (কথা)"]],"t":"أَمْ أَنَا۠ خَيْ<d>رٌۭ مِّ</>نْ <m>هَٰ</>ذَا <h>ٱ</>لَّذِى هُوَ مَهِي<d>نٌۭ وَ</>لَا يَكَادُ يُ<p>بِي</>نُ"},{"n":53,"w":[["فَلَوْلَآ","falawlā","Then why not","না তবে কেন"],["أُلْقِىَ","ul'qiya","are placed","দেওয়া হলো"],["عَلَيْهِ","‘alayhi","on him","তার উপর"],["أَسْوِرَةٌۭ","aswiratun","bracelets","বালা"],["مِّن","min","of","তৈরী"],["ذَهَبٍ","dhahabin","gold","সোনার"],["أَوْ","aw","or","বা"],["جَآءَ","jāa","come","আসলো (না কেন)"],["مَعَهُ","ma‘ahu","with him","তার সাথে"],["ٱلْمَلَـٰٓئِكَةُ","l-malāikatu","the Angels","ফেরেশতারা"],["مُقْتَرِنِينَ","muq'tarinīna","accompanying (him)","দলবেঁধে\""]],"t":"فَلَوْ<o>لَآ</> أُلْقِىَ عَلَيْهِ أَسْوِرَ<d>ةٌۭ مِّ</><k>ن ذَ</>هَبٍ أَوْ <o>جَآ</>ءَ مَعَهُ <h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةُ مُ<q>قْ</>تَرِ<p>نِي</>نَ"},{"n":54,"w":[["فَٱسْتَخَفَّ","fa-is'takhaffa","So he bluffed","সে এভাবে বোকা বানালো"],["قَوْمَهُۥ","qawmahu","his people","তার জাতিকে"],["فَأَطَاعُوهُ ۚ","fa-aṭā‘ūhu","and they obeyed him","তখন তাকে তারা মেনে নিলো"],["إِنَّهُمْ","innahum","Indeed, they","তারা নিশ্চয়ই"],["كَانُوا۟","kānū","were","ছিলো"],["قَوْمًۭا","qawman","a people","সম্প্রদায়"],["فَـٰسِقِينَ","fāsiqīna","defiantly disobedient","সত্যত্যাগী"]],"t":"فَ<h>ٱ</>سْتَخَفَّ قَوْمَهُ<m>ۥ</> فَأَطَاعُوهُ ۚ إِ<g>نَّ</>هُمْ كَانُو<s>ا۟</> قَوْ<k>مًۭا فَٰ</>سِ<p>قِي</>نَ"},{"n":55,"w":[["فَلَمَّآ","falammā","So when","অতঃপর যখন"],["ءَاسَفُونَا","āsafūnā","they angered Us","আমাদেরকে বিরক্ত করলো"],["ٱنتَقَمْنَا","intaqamnā","We took retribution","আমরা প্রতিশোধ নিলাম"],["مِنْهُمْ","min'hum","from them","তাদের থেকে"],["فَأَغْرَقْنَـٰهُمْ","fa-aghraqnāhum","and We drowned them","তখন তাদেরকে আমরা ডুবিয়ে দিলাম"],["أَجْمَعِينَ","ajma‘īna","all","সকলকেই"]],"t":"فَلَ<g>مَّ</><o>آ</> ءَاسَفُونَا <h>ٱ</><k>نتَ</>قَمْنَا مِنْهُمْ فَأَغْرَ<q>قْ</><m>نَٰ</>هُمْ أَ<q>جْ</>مَ<p>عِي</>نَ"},{"n":56,"w":[["فَجَعَلْنَـٰهُمْ","faja‘alnāhum","And We made them","এরপর তাদেরকে আমরা রেখে দিলাম"],["سَلَفًۭا","salafan","a precedent","অতীতের ইতিহাস"],["وَمَثَلًۭا","wamathalan","and an example","ও (শিক্ষার) দৃষ্টান্ত করে"],["لِّلْـَٔاخِرِينَ","lil'ākhirīna","for the later (generations)","পরবর্তীদের জন্যে"]],"t":"فَجَعَلْ<m>نَٰ</>هُمْ سَلَ<d>فًۭا وَ</>مَثَلًۭ<w>ا لِّ</>لْءَاخِ<p>رِي</>نَ"},{"n":57,"w":[["۞ وَلَمَّا","walammā","And when","এবং যখন"],["ضُرِبَ","ḍuriba","is presented","পেশ করা হলো"],["ٱبْنُ","ub'nu","(the) son","পুত্রকে"],["مَرْيَمَ","maryama","(of) Maryam","মারইয়ামের"],["مَثَلًا","mathalan","(as) an example","দৃষ্টান্তরূপে"],["إِذَا","idhā","behold","তখনই"],["قَوْمُكَ","qawmuka","Your people","তোমার জাতি"],["مِنْهُ","min'hu","about it","তা হ'তে"],["يَصِدُّونَ","yaṣiddūna","laughed aloud","হৈ চৈ শুরু করলো"]],"t":"۞ وَلَ<g>مَّ</>ا ضُرِبَ <h>ٱ</><q>بْ</>نُ مَرْيَمَ مَثَلًا إِذَا قَوْمُكَ مِنْهُ يَصِ<p>دُّو</>نَ"},{"n":58,"w":[["وَقَالُوٓا۟","waqālū","And they said","এবং বললো"],["ءَأَـٰلِهَتُنَا","aālihatunā","Are our gods","\"আমাদের দেবতারা কি"],["خَيْرٌ","khayrun","better","উত্তম"],["أَمْ","am","or","না কি"],["هُوَ ۚ","huwa","he","সে\""],["مَا","mā","Not","না"],["ضَرَبُوهُ","ḍarabūhu","they present it","তারা পেশ করেছে তা"],["لَكَ","laka","to you","তোমার জন্যে"],["إِلَّا","illā","except","এ ব্যতীত যে"],["جَدَلًۢا ۚ","jadalan","(for) argument","বিতর্ক করার (উদ্দেশ্যে)"],["بَلْ","bal","Nay","বরং"],["هُمْ","hum","they","তারা"],["قَوْمٌ","qawmun","(are) a people","সম্প্রদায়"],["خَصِمُونَ","khaṣimūna","argumentative","ঝগড়াটে"]],"t":"وَقَا<o>لُوٓ</><s>ا۟</> ءَ<m>أَٰ</>لِهَتُنَا خَيْرٌ أَمْ هُوَ ۚ مَا ضَرَبُوهُ لَكَ إِلَّا جَدَلًۢ<i>ا ۚ بَ</>لْ هُمْ قَوْمٌ خَصِ<p>مُو</>نَ"},{"n":59,"w":[["إِنْ","in","Not","নয়"],["هُوَ","huwa","he","সে (অর্থাৎ ঈসা আঃ)"],["إِلَّا","illā","(was) except","এ ব্যতীত"],["عَبْدٌ","‘abdun","a slave","এক দাস"],["أَنْعَمْنَا","an‘amnā","We bestowed Our favor","আমরা অনুগ্রহ করেছিলাম"],["عَلَيْهِ","‘alayhi","on him","তার উপর"],["وَجَعَلْنَـٰهُ","waja‘alnāhu","and We made him","এবং তাকে আমরা করেছিলাম"],["مَثَلًۭا","mathalan","an example","আদর্শস্বরূপ"],["لِّبَنِىٓ","libanī","for (the) Children of Israel","সন্তানদের জন্যে"],["إِسْرَٰٓءِيلَ","is'rāīla","for (the) Children of Israel","ইসরাঈলের"]],"t":"إِنْ هُوَ إِلَّا عَ<q>بْ</>دٌ أَنْعَمْنَا عَلَيْهِ وَجَعَلْ<m>نَٰ</>هُ مَثَلًۭ<w>ا لِّ</>بَ<o>نِىٓ</> إِسْ<o>رَٰٓ</><p>ءِي</>لَ"},{"n":60,"w":[["وَلَوْ","walaw","And if","এবং যদি"],["نَشَآءُ","nashāu","We willed","আমরা চাইতাম"],["لَجَعَلْنَا","laja‘alnā","surely We (could have) made","আমরা অবশ্যই সৃষ্টি করতাম"],["مِنكُم","minkum","among you","তোমাদের মধ্য থেকে"],["مَّلَـٰٓئِكَةًۭ","malāikatan","Angels","ফেরেশতা"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["يَخْلُفُونَ","yakhlufūna","succeeding","তারা স্থলাভিষিক্ত হতো (তোমাদের)"]],"t":"وَلَوْ نَ<o>شَآ</>ءُ لَجَعَلْنَا مِ<k>نكُ</><y>م مَّ</><o>لَٰٓ</>ئِكَ<k>ةًۭ فِ</>ى <h>ٱ</>لْأَرْضِ يَخْلُ<p>فُو</>نَ"},{"n":61,"w":[["وَإِنَّهُۥ","wa-innahu","And indeed, it","এবং নিশ্চয়ই সে"],["لَعِلْمٌۭ","la‘il'mun","surely (is) a knowledge","অবশ্যই নিদর্শন"],["لِّلسَّاعَةِ","lilssā‘ati","of the Hour","ক্বিয়ামাতের জন্যে"],["فَلَا","falā","So (do) not","সুতরাং না"],["تَمْتَرُنَّ","tamtarunna","(be) doubtful","তোমরা সন্দেহ করো"],["بِهَا","bihā","about it","তা সম্বন্ধে"],["وَٱتَّبِعُونِ ۚ","wa-ittabi‘ūni","and follow Me","এবং আমাকে তোমরা অনুসরণ করো"],["هَـٰذَا","hādhā","This","এটাই"],["صِرَٰطٌۭ","ṣirāṭun","(is the) Path","পথ"],["مُّسْتَقِيمٌۭ","mus'taqīmun","Straight","সরল সঠিক"]],"t":"وَإِ<g>نَّ</>هُ<m>ۥ</> لَعِلْ<w>مٌۭ لِّ</>لسَّاعَةِ فَلَا تَمْتَرُ<g>نَّ</> بِهَا وَ<h>ٱ</>تَّبِعُونِ ۚ <m>هَٰ</>ذَا صِ<m>رَٰ</><d>طٌۭ مُّ</>سْتَ<p>قِي</>مٌۭ"},{"n":62,"w":[["وَلَا","walā","And (let) not","এবং না"],["يَصُدَّنَّكُمُ","yaṣuddannakumu","avert you","তোমাদেরকে বাঁধা দিতে পারে (যেন)"],["ٱلشَّيْطَـٰنُ ۖ","l-shayṭānu","the Shaitaan","শয়তান"],["إِنَّهُۥ","innahu","Indeed, he","নিশ্চয়ই সে"],["لَكُمْ","lakum","(is) for you","তোমাদের জন্যে"],["عَدُوٌّۭ","‘aduwwun","an enemy","শত্রু"],["مُّبِينٌۭ","mubīnun","clear","প্রকাশ্য"]],"t":"وَلَا يَصُدَّ<g>نَّ</>كُمُ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نُ ۖ إِ<g>نَّ</>هُ<m>ۥ</> لَكُمْ عَدُ<d>وٌّۭ مُّ</><p>بِي</>نٌۭ"},{"n":63,"w":[["وَلَمَّا","walammā","And when","এবং যখন"],["جَآءَ","jāa","came","এসেছিলো"],["عِيسَىٰ","‘īsā","Isa","ঈসা"],["بِٱلْبَيِّنَـٰتِ","bil-bayināti","with clear proofs","সুস্পষ্ট নিদর্শনাবলীসহ"],["قَالَ","qāla","he said","সে বলেছিলো"],["قَدْ","qad","Verily","\"নিশ্চয়ই"],["جِئْتُكُم","ji'tukum","I have come to you","আমি তোমাদের কাছে এসেছি"],["بِٱلْحِكْمَةِ","bil-ḥik'mati","with wisdom","প্রজ্ঞাসহ"],["وَلِأُبَيِّنَ","wali-ubayyina","and that I make clear","এবং আমি সুস্পষ্ট করার জন্যে"],["لَكُم","lakum","to you","তোমাদের কাছে"],["بَعْضَ","ba‘ḍa","some","এমন কিছু"],["ٱلَّذِى","alladhī","(of) that which","যা"],["تَخْتَلِفُونَ","takhtalifūna","you differ","তোমরা মতভেদ করছো"],["فِيهِ ۖ","fīhi","in it","তার মধ্যে"],["فَٱتَّقُوا۟","fa-ittaqū","So fear","সুতরাং তোমরা ভয় করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["وَأَطِيعُونِ","wa-aṭī‘ūni","and obey me","এবং তোমরা আনুগত্য করো আমার"]],"t":"وَلَ<g>مَّ</>ا <o>جَآ</>ءَ عِيسَىٰ بِ<h>ٱ</>لْبَيِّ<m>نَٰ</>تِ قَالَ قَ<q>دْ</> جِئْتُ<f>كُم بِ</><h>ٱ</>لْحِكْمَةِ وَلِأُبَيِّنَ لَ<f>كُم بَ</>عْضَ <h>ٱ</>لَّذِى تَخْتَلِفُونَ فِيهِ ۖ فَ<h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</>للَّهَ وَأَطِي<p>عُو</>نِ"},{"n":64,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["هُوَ","huwa","He","তিনিই"],["رَبِّى","rabbī","(is) my Lord","আমার রব"],["وَرَبُّكُمْ","warabbukum","and your Lord","ও তোমাদের রব"],["فَٱعْبُدُوهُ ۚ","fa-u‘'budūhu","so worship Him","সুতরাং তাঁরই তোমরা ইবাদত করো"],["هَـٰذَا","hādhā","This","এটা"],["صِرَٰطٌۭ","ṣirāṭun","(is) a Path","পথ"],["مُّسْتَقِيمٌۭ","mus'taqīmun","Straight","সরল সঠিক\""]],"t":"إِ<g>نَّ</> <h>ٱ</>للَّهَ هُوَ رَبِّى وَرَبُّكُمْ فَ<h>ٱ</>عْبُدُوهُ ۚ <m>هَٰ</>ذَا صِ<m>رَٰ</><d>طٌۭ مُّ</>سْتَ<p>قِي</>مٌۭ"},{"n":65,"w":[["فَٱخْتَلَفَ","fa-ikh'talafa","But differed","অতঃপর মতভেদ করলো"],["ٱلْأَحْزَابُ","l-aḥzābu","the factions","বিভিন্ন দল"],["مِنۢ","min","from","থেকে"],["بَيْنِهِمْ ۖ","baynihim","among them","তাদের মাঝ"],["فَوَيْلٌۭ","fawaylun","so woe","সুতরাং দুর্ভোগ"],["لِّلَّذِينَ","lilladhīna","to those who","(তাদের) জন্যে যারা"],["ظَلَمُوا۟","ẓalamū","wronged","সীমালঙ্ঘন করেছে"],["مِنْ","min","from","থেকে"],["عَذَابِ","‘adhābi","(the) punishment","শাস্তির"],["يَوْمٍ","yawmin","(of the) Day","দিনের"],["أَلِيمٍ","alīmin","painful","নিদারুণ"]],"t":"فَ<h>ٱ</>خْتَلَفَ <h>ٱ</>لْأَحْزَابُ <i>مِنۢ بَ</>يْنِهِمْ ۖ فَوَيْ<w>لٌۭ لِّ</>لَّذِينَ ظَلَمُو<s>ا۟</> مِنْ عَذَابِ يَوْمٍ أَ<p>لِي</>مٍ"},{"n":66,"w":[["هَلْ","hal","Are","কি"],["يَنظُرُونَ","yanẓurūna","they waiting","তারা অপেক্ষা করছে"],["إِلَّا","illā","except","এ ব্যতীত"],["ٱلسَّاعَةَ","l-sā‘ata","(for) the Hour","ক্বিয়ামাতের (দিনের)"],["أَن","an","that","যে"],["تَأْتِيَهُم","tatiyahum","it should come on them","তাদের উপর আসবে"],["بَغْتَةًۭ","baghtatan","suddenly","হঠাৎ"],["وَهُمْ","wahum","while they","এবং তারা"],["لَا","lā","(do) not","না"],["يَشْعُرُونَ","yash‘urūna","perceive","টেরও পাবে"]],"t":"هَلْ يَ<k>نظُ</>رُونَ إِلَّا <h>ٱ</><l>ل</>سَّاعَةَ أَ<k>ن تَ</>أْتِيَ<f>هُم بَ</>غْتَ<d>ةًۭ وَ</>هُمْ لَا يَشْعُ<p>رُو</>نَ"},{"n":67,"w":[["ٱلْأَخِلَّآءُ","al-akhilāu","Friends","বন্ধুরা"],["يَوْمَئِذٍۭ","yawma-idhin","that Day","সেদিন"],["بَعْضُهُمْ","ba‘ḍuhum","some of them","তাদের একে"],["لِبَعْضٍ","liba‘ḍin","to others","অপরের জন্যে"],["عَدُوٌّ","‘aduwwun","(will be) enemies","শত্রু (হবে)"],["إِلَّا","illā","except","ব্যতীত"],["ٱلْمُتَّقِينَ","l-mutaqīna","the righteous","মুত্তাকীরা"]],"t":"ٱلْأَخِ<o>لَّآ</>ءُ يَوْمَئِ<i>ذٍۭ بَ</>عْضُهُمْ لِبَعْضٍ عَدُوٌّ إِلَّا <h>ٱ</>لْمُتَّ<p>قِي</>نَ"},{"n":68,"w":[["يَـٰعِبَادِ","yā‘ibādi","O My slaves","\"(বলা হবে) হে আমার দাসরা"],["لَا","lā","No","নেই"],["خَوْفٌ","khawfun","fear","কোনো ভয়"],["عَلَيْكُمُ","‘alaykumu","on you","তোমাদের উপর"],["ٱلْيَوْمَ","l-yawma","this Day","আজ"],["وَلَآ","walā","and not","আর না"],["أَنتُمْ","antum","you","তোমরা"],["تَحْزَنُونَ","taḥzanūna","will grieve","চিন্তা করবে"]],"t":"<m>يَٰ</>عِبَادِ لَا خَوْفٌ عَلَيْكُمُ <h>ٱ</>لْيَوْمَ وَ<o>لَآ</> أَ<k>نتُ</>مْ تَحْزَ<p>نُو</>نَ"},{"n":69,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["ءَامَنُوا۟","āmanū","believed","ঈমান এনেছিলো"],["بِـَٔايَـٰتِنَا","biāyātinā","in Our Verses","আমাদের আয়াতগুলোর উপর"],["وَكَانُوا۟","wakānū","and were","এবং তারা ছিলো"],["مُسْلِمِينَ","mus'limīna","submissive","আত্মসমর্পণকারী (অর্থাৎ মুসলমান)"]],"t":"ٱلَّذِينَ ءَامَنُو<s>ا۟</> بِـَٔا<m>يَٰ</>تِنَا وَكَانُو<s>ا۟</> مُسْلِ<p>مِي</>نَ"},{"n":70,"w":[["ٱدْخُلُوا۟","ud'khulū","Enter","(তাদেরকে বলা হবে) তোমরা প্রবেশ করো"],["ٱلْجَنَّةَ","l-janata","Paradise","জান্নাতে"],["أَنتُمْ","antum","you","তোমরা"],["وَأَزْوَٰجُكُمْ","wa-azwājukum","and your spouses","ও তোমাদের স্ত্রীরা"],["تُحْبَرُونَ","tuḥ'barūna","delighted","তোমাদের সন্তুষ্ট করে দেওয়া হবে\""]],"t":"ٱ<q>دْ</>خُلُو<s>ا۟</> <h>ٱ</>لْجَ<g>نَّ</>ةَ أَ<k>نتُ</>مْ وَأَزْ<m>وَٰ</>جُكُمْ تُحْبَ<p>رُو</>نَ"},{"n":71,"w":[["يُطَافُ","yuṭāfu","Will be circulated","পরিবেশন করা হবে"],["عَلَيْهِم","‘alayhim","for them","তাদের কাছে"],["بِصِحَافٍۢ","biṣiḥāfin","plates","থালাসমূহকে"],["مِّن","min","of","তৈরী"],["ذَهَبٍۢ","dhahabin","gold","স্বর্ণের"],["وَأَكْوَابٍۢ ۖ","wa-akwābin","and cups","এবং পানপাত্রসমুহও (স্বর্ণের)"],["وَفِيهَا","wafīhā","And therein","এবং তার মধ্যে থাকবে"],["مَا","mā","(is) what","যা কিছু"],["تَشْتَهِيهِ","tashtahīhi","desires","তা চাইবে"],["ٱلْأَنفُسُ","l-anfusu","the souls","(তাদের) অন্তরগুলো"],["وَتَلَذُّ","wataladhu","and delights","এবং তৃপ্ত হবে (তা দেখে)"],["ٱلْأَعْيُنُ ۖ","l-a‘yunu","the eyes","(তাদের) চোখগুলো"],["وَأَنتُمْ","wa-antum","and you","এবং (বলা হবে) তোমরা"],["فِيهَا","fīhā","therein","তার মধ্যে"],["خَـٰلِدُونَ","khālidūna","will abide forever","চিরকাল"]],"t":"يُطَافُ عَلَيْ<f>هِم بِ</>صِحَا<d>فٍۢ مِّ</><k>ن ذَ</>هَ<d>بٍۢ وَ</>أَكْوَا<d>بٍۢ ۖ وَ</>فِيهَا مَا تَشْتَهِيهِ <h>ٱ</>لْأَ<k>نفُ</>سُ وَتَلَذُّ <h>ٱ</>لْأَعْيُنُ ۖ وَأَ<k>نتُ</>مْ فِيهَا <m>خَٰ</>لِ<p>دُو</>نَ"},{"n":72,"w":[["وَتِلْكَ","watil'ka","And this","এবং এই"],["ٱلْجَنَّةُ","l-janatu","(is) the Paradise","জান্নাত"],["ٱلَّتِىٓ","allatī","which","(সেই) যা"],["أُورِثْتُمُوهَا","ūrith'tumūhā","you are made to inherit","তোমাদেরকে তার উত্তরাধিকারী করা হয়েছে"],["بِمَا","bimā","for what","বিনিময়ে যা"],["كُنتُمْ","kuntum","you used to","তোমরা"],["تَعْمَلُونَ","ta‘malūna","do","কাজ করেছিলে"]],"t":"وَتِلْكَ <h>ٱ</>لْجَ<g>نَّ</>ةُ <h>ٱ</>لَّ<o>تِىٓ</> أُورِثْتُمُوهَا بِمَا كُ<k>نتُ</>مْ تَعْمَ<p>لُو</>نَ"},{"n":73,"w":[["لَكُمْ","lakum","For you","তোমাদের জন্যে"],["فِيهَا","fīhā","therein","তার মধ্যে (থাকবে)"],["فَـٰكِهَةٌۭ","fākihatun","(are) fruits","ফলমূল"],["كَثِيرَةٌۭ","kathīratun","abundant","প্রচুর"],["مِّنْهَا","min'hā","from it","তা থেকে"],["تَأْكُلُونَ","takulūna","you will eat","তোমরা খাবে"]],"t":"لَكُمْ فِيهَا <m>فَٰ</>كِهَ<k>ةٌۭ كَ</>ثِيرَ<d>ةٌۭ مِّ</>نْهَا تَأْكُ<p>لُو</>نَ"},{"n":74,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلْمُجْرِمِينَ","l-muj'rimīna","the criminals","অপরাধীরা"],["فِى","fī","(will be) in","(হবে) মধ্যে"],["عَذَابِ","‘adhābi","(the) punishment","শাস্তির"],["جَهَنَّمَ","jahannama","(of) Hell","জাহান্নামের"],["خَـٰلِدُونَ","khālidūna","abiding forever","তারা স্থায়ী হবে (সেখানে)"]],"t":"إِ<g>نَّ</> <h>ٱ</>لْمُ<q>جْ</>رِمِينَ فِى عَذَابِ جَهَ<g>نَّ</>مَ <m>خَٰ</>لِ<p>دُو</>نَ"},{"n":75,"w":[["لَا","lā","Not","না"],["يُفَتَّرُ","yufattaru","will it subside","কম করা হবে"],["عَنْهُمْ","‘anhum","for them","তাদের থেকে (শাস্তি)"],["وَهُمْ","wahum","and they","এবং তারা"],["فِيهِ","fīhi","in it","তার মধ্যে"],["مُبْلِسُونَ","mub'lisūna","(will) despair","হতাশ হয়ে পড়ে থাকবে"]],"t":"لَا يُفَتَّرُ عَنْهُمْ وَهُمْ فِيهِ مُ<q>بْ</>لِ<p>سُو</>نَ"},{"n":76,"w":[["وَمَا","wamā","And not","এবং না"],["ظَلَمْنَـٰهُمْ","ẓalamnāhum","We wronged them","তাদেরকে আমরা অত্যাচার করেছি"],["وَلَـٰكِن","walākin","but","কিন্তু"],["كَانُوا۟","kānū","they were","ছিলো"],["هُمُ","humu","themselves","তারা"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","wrongdoers","সীমালঙ্ঘনকারী (তাদের নিজেদের উপর)"]],"t":"وَمَا ظَلَمْ<m>نَٰ</>هُمْ وَ<m>لَٰ</>كِ<k>ن كَ</>انُو<s>ا۟</> هُمُ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":77,"w":[["وَنَادَوْا۟","wanādaw","And they will call","এবং তারা ডেকে বলবে"],["يَـٰمَـٰلِكُ","yāmāliku","O Malik","\"হে মালিক (জাহান্নামের প্রহরী)"],["لِيَقْضِ","liyaqḍi","Let put an end","শেষ করে দিক"],["عَلَيْنَا","‘alaynā","to us","আমাদের উপর (ব্যাপারটা)"],["رَبُّكَ ۖ","rabbuka","your Lord","তোমার রব\""],["قَالَ","qāla","He (will) say","সে বলবে"],["إِنَّكُم","innakum","Indeed, you","\"তোমরা নিশ্চয়ই"],["مَّـٰكِثُونَ","mākithūna","(will) remain","অবস্থানকারী (এভাবেই)\""]],"t":"وَنَادَوْ<s>ا۟</> <m>يَٰمَٰ</>لِكُ لِيَ<q>قْ</>ضِ عَلَيْنَا رَبُّكَ ۖ قَالَ إِ<g>نَّ</><y>كُم مَّٰ</>كِ<p>ثُو</>نَ"},{"n":78,"w":[["لَقَدْ","laqad","Certainly","নিশ্চয়ই"],["جِئْنَـٰكُم","ji'nākum","We have brought you","তোমাদের কাছে আমরা এসেছিলাম"],["بِٱلْحَقِّ","bil-ḥaqi","the truth","সত্যসহ"],["وَلَـٰكِنَّ","walākinna","but","কিন্তু"],["أَكْثَرَكُمْ","aktharakum","most of you","তোমাদের বেশীর ভাগই (ছিলে)"],["لِلْحَقِّ","lil'ḥaqqi","to the truth","সত্যের প্রতি"],["كَـٰرِهُونَ","kārihūna","(are) averse","বিমুখ"]],"t":"لَقَ<q>دْ</> جِئْ<m>نَٰ</><f>كُم بِ</><h>ٱ</>لْحَقِّ وَ<m>لَٰ</>كِ<g>نَّ</> أَكْثَرَكُمْ لِلْحَقِّ <m>كَٰ</>رِ<p>هُو</>نَ"},{"n":79,"w":[["أَمْ","am","Or","তবে কি"],["أَبْرَمُوٓا۟","abramū","have they determined","তারা সিদ্ধান্ত নিয়েছে"],["أَمْرًۭا","amran","an affair","একটি বিষয়ে"],["فَإِنَّا","fa-innā","Then indeed, We","নিশ্চয়ই তবে আমরাও"],["مُبْرِمُونَ","mub'rimūna","(are) determined","সিদ্ধান্ত গ্রহণকারী (তাদের ব্যাপারে)"]],"t":"أَمْ أَ<q>بْ</>رَ<o>مُوٓ</><s>ا۟</> أَمْ<k>رًۭا فَ</>إِ<g>نَّ</>ا مُ<q>بْ</>رِ<p>مُو</>نَ"},{"n":80,"w":[["أَمْ","am","Or","না কি"],["يَحْسَبُونَ","yaḥsabūna","(do) they think","তারা মনে করেছে"],["أَنَّا","annā","that We","যে আমরা"],["لَا","lā","(can) not","না"],["نَسْمَعُ","nasma‘u","hear","আমরা শুনি"],["سِرَّهُمْ","sirrahum","their secret(s)","তাদের গোপন কথাবার্তা"],["وَنَجْوَىٰهُم ۚ","wanajwāhum","and their private counsel(s)","ও তাদের গোপন পরামর্শ"],["بَلَىٰ","balā","Nay","হ্যাঁ (সবই শুনি)"],["وَرُسُلُنَا","warusulunā","and Our Messengers","এবং আমাদের ফেরেশতারা"],["لَدَيْهِمْ","ladayhim","with them","তাদের কাছে আছে"],["يَكْتُبُونَ","yaktubūna","are recording","তারা লিখছে"]],"t":"أَمْ يَحْسَبُونَ أَ<g>نَّ</>ا لَا نَسْمَعُ سِرَّهُمْ وَنَ<q>جْ</>وَ<m>ىٰ</><f>هُم ۚ بَ</>لَىٰ وَرُسُلُنَا لَدَيْهِمْ يَكْتُ<p>بُو</>نَ"},{"n":81,"w":[["قُلْ","qul","Say","বলো"],["إِن","in","If","\"যদি"],["كَانَ","kāna","had","থাকতো"],["لِلرَّحْمَـٰنِ","lilrraḥmāni","the Most Gracious","দয়াময়ের জন্যে"],["وَلَدٌۭ","waladun","a son","কোনো ছেলে"],["فَأَنَا۠","fa-anā","Then, I","তবে আমি"],["أَوَّلُ","awwalu","(would be the) first","প্রথম (হতাম)"],["ٱلْعَـٰبِدِينَ","l-‘ābidīna","(of) the worshippers","উপাসকদের মধ্যে\""]],"t":"قُلْ إِ<k>ن كَ</>انَ لِلرَّحْ<m>مَٰ</>نِ وَلَ<k>دٌۭ فَ</>أَنَا۠ أَوَّلُ <h>ٱ</>لْ<m>عَٰ</>بِ<p>دِي</>نَ"},{"n":82,"w":[["سُبْحَـٰنَ","sub'ḥāna","Glory be","মহান পবিত্র"],["رَبِّ","rabbi","(to the) Lord","রব"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশের"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীর"],["رَبِّ","rabbi","(the) Lord","রব"],["ٱلْعَرْشِ","l-‘arshi","(of) the Throne","আরশের"],["عَمَّا","‘ammā","above what","তা হ'তে যা"],["يَصِفُونَ","yaṣifūna","they ascribe","তারা আরোপ করে"]],"t":"سُ<q>بْ</><m>حَٰ</>نَ رَبِّ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ رَبِّ <h>ٱ</>لْعَرْشِ عَ<g>مَّ</>ا يَصِ<p>فُو</>نَ"},{"n":83,"w":[["فَذَرْهُمْ","fadharhum","So leave them","সুতরাং ছেড়ে দাও তাদেরকে"],["يَخُوضُوا۟","yakhūḍū","(to) converse vainly","বাকবিতন্ডা করতে"],["وَيَلْعَبُوا۟","wayal‘abū","and play","ও ক্রীড়া-কৌতুক করতে"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["يُلَـٰقُوا۟","yulāqū","they meet","তারা সাক্ষাত পায়"],["يَوْمَهُمُ","yawmahumu","their Day","তাদের দিনের"],["ٱلَّذِى","alladhī","which","যা"],["يُوعَدُونَ","yū‘adūna","they are promised","তাদের প্রতিশ্রুতি দেয়া হচ্ছে"]],"t":"فَذَرْهُمْ يَخُوضُو<s>ا۟</> وَيَلْعَبُو<s>ا۟</> حَتَّىٰ يُ<m>لَٰ</>قُو<s>ا۟</> يَوْمَهُمُ <h>ٱ</>لَّذِى يُوعَ<p>دُو</>نَ"},{"n":84,"w":[["وَهُوَ","wahuwa","And He","এবং তিনিই (আল্লাহ)"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["فِى","fī","(is) in","আছেন"],["ٱلسَّمَآءِ","l-samāi","the heaven ","আকাশে"],["إِلَـٰهٌۭ","ilāhun","God","ইলাহ"],["وَفِى","wafī","and in","এবং আছেন"],["ٱلْأَرْضِ","l-arḍi","the earth ","পৃথিবীতেও"],["إِلَـٰهٌۭ ۚ","ilāhun","God","ইলাহ"],["وَهُوَ","wahuwa","And He","এবং তিনিই"],["ٱلْحَكِيمُ","l-ḥakīmu","(is) the All-Wise","মহাজ্ঞানী"],["ٱلْعَلِيمُ","l-‘alīmu","the All-Knower","মহাবিজ্ঞ"]],"t":"وَهُوَ <h>ٱ</>لَّذِى فِى <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ إِ<m>لَٰ</><d>هٌۭ وَ</>فِى <h>ٱ</>لْأَرْضِ إِ<m>لَٰ</><d>هٌۭ ۚ وَ</>هُوَ <h>ٱ</>لْحَكِيمُ <h>ٱ</>لْعَ<p>لِي</>مُ"},{"n":85,"w":[["وَتَبَارَكَ","watabāraka","And blessed (is)","এবং মহান তিনি"],["ٱلَّذِى","alladhī","the One Who ","যিনি (এমন সত্ত্বা যে)"],["لَهُۥ","lahu","to Whom","তাঁরই"],["مُلْكُ","mul'ku","(belongs the) dominion","সার্বভৌমত্ব"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশের"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীর"],["وَمَا","wamā","and whatever","এবং যা কিছু"],["بَيْنَهُمَا","baynahumā","(is) between both of them","তাদের উভয়ের মাঝে আছে"],["وَعِندَهُۥ","wa‘indahu","and with Him","এবং তাঁরই কাছে আছে"],["عِلْمُ","‘il'mu","(is the) knowledge","জ্ঞান"],["ٱلسَّاعَةِ","l-sā‘ati","(of) the Hour","ক্বিয়ামাতের"],["وَإِلَيْهِ","wa-ilayhi","and to Him","এবং তাঁরই দিকে"],["تُرْجَعُونَ","tur'ja‘ūna","you will be returned","তোমাদেরকে ফিরে যেতে হবে"]],"t":"وَتَبَارَكَ <h>ٱ</>لَّذِى لَهُ<m>ۥ</> مُلْكُ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ وَمَا بَيْنَهُمَا وَعِ<k>ندَ</>هُ<m>ۥ</> عِلْمُ <h>ٱ</><l>ل</>سَّاعَةِ وَإِلَيْهِ تُرْجَ<p>عُو</>نَ"},{"n":86,"w":[["وَلَا","walā","And not","এবং না"],["يَمْلِكُ","yamliku","have power","ক্ষমতা রাখে"],["ٱلَّذِينَ","alladhīna","those whom","যাদেরকে"],["يَدْعُونَ","yad‘ūna","they invoke","তারা ডাকে"],["مِن","min","besides Him","মধ্য হতে"],["دُونِهِ","dūnihi","besides Him","তাঁকে ছাড়া"],["ٱلشَّفَـٰعَةَ","l-shafā‘ata","(for) the intercession","সুপারিশের"],["إِلَّا","illā","except","কিন্তু"],["مَن","man","who","যে"],["شَهِدَ","shahida","testifies","সাক্ষ্য দেয়"],["بِٱلْحَقِّ","bil-ḥaqi","to the truth","সত্যের"],["وَهُمْ","wahum","and they","তারা যখন"],["يَعْلَمُونَ","ya‘lamūna","know","জানেও"]],"t":"وَلَا يَمْلِكُ <h>ٱ</>لَّذِينَ يَ<q>دْ</>عُونَ مِ<k>ن دُ</>ونِهِ <h>ٱ</><l>ل</>شَّ<m>فَٰ</>عَةَ إِلَّا مَ<k>ن شَ</>هِدَ بِ<h>ٱ</>لْحَقِّ وَهُمْ يَعْلَ<p>مُو</>نَ"},{"n":87,"w":[["وَلَئِن","wala-in","And if","এবং অবশ্যই যদি"],["سَأَلْتَهُم","sa-altahum","you ask them","তাদেরকে তুমি জিজ্ঞেস করো"],["مَّنْ","man","who","কে"],["خَلَقَهُمْ","khalaqahum","created them","তাদের সৃষ্টি করেছে"],["لَيَقُولُنَّ","layaqūlunna","they will certainly say","অবশ্যই তারা বলবে"],["ٱللَّهُ ۖ","l-lahu","Allah","\"আল্লাহ\""],["فَأَنَّىٰ","fa-annā","Then how","তাহ'লে কোথায়"],["يُؤْفَكُونَ","yu'fakūna","are they deluded","তাদের ফিরানো হচ্ছে"]],"t":"وَلَئِ<k>ن سَ</>أَلْتَ<y>هُم مَّ</>نْ خَلَقَهُمْ لَيَقُولُ<g>نَّ</> <h>ٱ</>للَّهُ ۖ فَأَ<g>نَّ</>ىٰ يُؤْفَ<p>كُو</>نَ"},{"n":88,"w":[["وَقِيلِهِۦ","waqīlihi","And his saying","শপথ তার (অর্থাৎ নাবীর) কথার"],["يَـٰرَبِّ","yārabbi","O my Lord","\"হে আমার রব"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["هَـٰٓؤُلَآءِ","hāulāi","these","এসব"],["قَوْمٌۭ","qawmun","(are) a people","সম্প্রদায়"],["لَّا","lā","(who do) not","না"],["يُؤْمِنُونَ","yu'minūna","believe","ঈমান আনবে\""]],"t":"وَقِيلِ<m>هِۦ يَٰ</>رَبِّ إِ<g>نَّ</> <o>هَٰٓؤُلَآ</>ءِ قَوْ<w>مٌۭ لَّ</>ا يُؤْمِ<p>نُو</>نَ"},{"n":89,"w":[["فَٱصْفَحْ","fa-iṣ'faḥ","So turn away","সুতরাং উপেক্ষা করো"],["عَنْهُمْ","‘anhum","from them","থেকে তাদের"],["وَقُلْ","waqul","and say","এবং বলো"],["سَلَـٰمٌۭ ۚ","salāmun","Peace","\"সালাম\""],["فَسَوْفَ","fasawfa","But soon","অতঃপর শীঘ্রই"],["يَعْلَمُونَ","ya‘lamūna","they will know","তারা জানতে পারবে"]],"t":"فَ<h>ٱ</>صْفَحْ عَنْهُمْ وَقُلْ سَ<m>لَٰ</><k>مٌۭ ۚ فَ</>سَوْفَ يَعْلَ<p>مُو</>نَ"}]}