{"n":48,"a":[{"n":1,"w":[["إِنَّا","innā","Indeed","নিশ্চয়ই আমরা"],["فَتَحْنَا","fataḥnā","We have given victory","আমরা বিজয় দিয়েছি"],["لَكَ","laka","to you","তোমাকে (হে নবী)"],["فَتْحًۭا","fatḥan","a victory","বিজয়"],["مُّبِينًۭا","mubīnan","clear","সুস্পষ্ট"]],"t":"إِ<g>نَّ</>ا فَتَحْنَا لَكَ فَتْ<d>حًۭا مُّ</>بِينًۭا"},{"n":2,"w":[["لِّيَغْفِرَ","liyaghfira","That may forgive","তিনি ক্ষমা করেন যেন"],["لَكَ","laka","for you","তোমাকে"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["مَا","mā","what","যা"],["تَقَدَّمَ","taqaddama","preceded","পূর্বে হয়েছে"],["مِن","min","of","থেকে"],["ذَنۢبِكَ","dhanbika","your sins","তোমার পাপ"],["وَمَا","wamā","and what","ও যা"],["تَأَخَّرَ","ta-akhara","will follow","পরে হয়েছে"],["وَيُتِمَّ","wayutimma","and complete","এবং সম্পূর্ণ করেন (যেন)"],["نِعْمَتَهُۥ","ni‘'matahu","His favor","তাঁর অনুগ্রহ"],["عَلَيْكَ","‘alayka","upon you","তোমার প্রতি"],["وَيَهْدِيَكَ","wayahdiyaka","and guide you","ও তোমাকে পরিচালনা করেন"],["صِرَٰطًۭا","ṣirāṭan","(to) a Path","পথে"],["مُّسْتَقِيمًۭا","mus'taqīman","Straight","সরল সঠিক"]],"t":"لِّيَغْفِرَ لَكَ <h>ٱ</>للَّهُ مَا تَقَدَّمَ مِ<k>ن ذَ</><i>نۢبِ</>كَ وَمَا تَأَخَّرَ وَيُتِ<g>مَّ</> نِعْمَتَهُ<m>ۥ</> عَلَيْكَ وَيَهْدِيَكَ صِ<m>رَٰ</><d>طًۭا مُّ</>سْتَقِيمًۭا"},{"n":3,"w":[["وَيَنصُرَكَ","wayanṣuraka","And Allah may help you","এবং তোমাকে সাহায্য করেন যেন"],["ٱللَّهُ","l-lahu","And Allah may help you","আল্লাহ"],["نَصْرًا","naṣran","(with) a help","সাহায্য"],["عَزِيزًا","‘azīzan","mighty","বলিষ্ঠ/ জোর"]],"t":"وَيَ<k>نصُ</>رَكَ <h>ٱ</>للَّهُ نَصْرًا عَزِيزًا"},{"n":4,"w":[["هُوَ","huwa","He","তিনিই (আল্লাহ)"],["ٱلَّذِىٓ","alladhī","(is) the One Who","যিনি"],["أَنزَلَ","anzala","sent down","অবতীর্ণ করেছেন"],["ٱلسَّكِينَةَ","l-sakīnata","[the] tranquility","প্রশান্তি"],["فِى","fī","in(to)","মধ্যে"],["قُلُوبِ","qulūbi","(the) hearts","অন্তর সমূহের"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","(of) the believers","মু'মিনদের"],["لِيَزْدَادُوٓا۟","liyazdādū","that they may increase","তারা বৃদ্ধি করে যেন"],["إِيمَـٰنًۭا","īmānan","(in) faith","(আরও) ঈমান"],["مَّعَ","ma‘a","with","সাথে"],["إِيمَـٰنِهِمْ ۗ","īmānihim","their faith","তাদের ঈমানের"],["وَلِلَّهِ","walillahi","And for Allah","এবং আল্লাহরই জন্য"],["جُنُودُ","junūdu","(are the) hosts","সৈন্যসমূহ"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশের"],["وَٱلْأَرْضِ ۚ","wal-arḍi","and the earth","ও পৃথিবীর"],["وَكَانَ","wakāna","and Allah","এবং হলেন"],["ٱللَّهُ","l-lahu","and Allah","আল্লাহ"],["عَلِيمًا","‘alīman","(is) All-Knower","সর্বজ্ঞ"],["حَكِيمًۭا","ḥakīman","All-Wise","প্রজ্ঞাময়"]],"t":"هُوَ <h>ٱ</>لَّ<o>ذِىٓ</> أَ<k>نزَ</>لَ <h>ٱ</><l>ل</>سَّكِينَةَ فِى قُلُوبِ <h>ٱ</>لْمُؤْمِنِينَ لِيَزْدَا<o>دُوٓ</><s>ا۟</> إِي<m>مَٰ</><d>نًۭا مَّ</>عَ إِي<m>مَٰ</>نِهِمْ ۗ وَلِلَّهِ جُنُودُ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ ۚ وَكَانَ <h>ٱ</>للَّهُ عَلِيمًا حَكِيمًۭا"},{"n":5,"w":[["لِّيُدْخِلَ","liyud'khila","That He may admit","প্রবেশ করান যেন"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believing men","মু'মিন পুরুষদেরকে"],["وَٱلْمُؤْمِنَـٰتِ","wal-mu'mināti","and the believing women","ও মু'মিন নারীদেরকে"],["جَنَّـٰتٍۢ","jannātin","(to) Gardens","জান্নাতে"],["تَجْرِى","tajrī","flow","প্রবাহিত হয়"],["مِن","min","from","থেকে"],["تَحْتِهَا","taḥtihā","underneath them","তার (যার) নিচ"],["ٱلْأَنْهَـٰرُ","l-anhāru","the rivers","ঝর্ণাধারা সমূহ"],["خَـٰلِدِينَ","khālidīna","(to) abide forever","তারা চিরস্থায়ী হবে"],["فِيهَا","fīhā","therein","তার মধ্যে"],["وَيُكَفِّرَ","wayukaffira","and (to) remove","এবং মিটিয়ে দেবেন"],["عَنْهُمْ","‘anhum","from them","তাদের হতে"],["سَيِّـَٔاتِهِمْ ۚ","sayyiātihim","their misdeeds","তাদের দোষত্রুটি সমূহকে"],["وَكَانَ","wakāna","and is","এবং হল"],["ذَٰلِكَ","dhālika","that","এটা"],["عِندَ","‘inda","with","নিকট"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["فَوْزًا","fawzan","a success","সাফল্য"],["عَظِيمًۭا","‘aẓīman","great","বিরাট"]],"t":"لِّيُ<q>دْ</>خِلَ <h>ٱ</>لْمُؤْمِنِينَ وَ<h>ٱ</>لْمُؤْمِ<m>نَٰ</>تِ جَ<g>نَّٰ</><k>تٍۢ تَ</><q>جْ</>رِى مِ<k>ن تَ</>حْتِهَا <h>ٱ</>لْأَنْ<m>هَٰ</>رُ <m>خَٰ</>لِدِينَ فِيهَا وَيُكَفِّرَ عَنْهُمْ سَيِّـَٔاتِهِمْ ۚ وَكَانَ <m>ذَٰ</>لِكَ عِ<k>ندَ</> <h>ٱ</>للَّهِ فَوْزًا عَظِيمًۭا"},{"n":6,"w":[["وَيُعَذِّبَ","wayu‘adhiba","And He (may) punish","এবং তিনি শাস্তি দেবেন"],["ٱلْمُنَـٰفِقِينَ","l-munāfiqīna","the hypocrite men","মুনাফেক পুরুষদেরকে"],["وَٱلْمُنَـٰفِقَـٰتِ","wal-munāfiqāti","and the hypocrite women","ও মুনাফেক নারীদেরকে"],["وَٱلْمُشْرِكِينَ","wal-mush'rikīna","and the polytheist men","এবং মুশরিক পুরুষদেরকে"],["وَٱلْمُشْرِكَـٰتِ","wal-mush'rikāti","and the polytheist women","ও মুশরিক নারীদেরকে"],["ٱلظَّآنِّينَ","l-ẓānīna","who assume","(যারা) ধারণাকারী"],["بِٱللَّهِ","bil-lahi","about Allah","আল্লাহ সম্পর্কে"],["ظَنَّ","ẓanna","an assumption","ধারণা"],["ٱلسَّوْءِ ۚ","l-sawi","evil","খারাপ/ ভ্রান্ত"],["عَلَيْهِمْ","‘alayhim","Upon them","তাদের উপর (পড়েছে)"],["دَآئِرَةُ","dāiratu","(is) a turn","আবর্তন"],["ٱلسَّوْءِ ۖ","l-sawi","(of) evil","অকল্যাণকর"],["وَغَضِبَ","waghaḍiba","and Allah's wrath (is)","এবং রুষ্ট হয়েছেন"],["ٱللَّهُ","l-lahu","and Allah's wrath (is)","আল্লাহ"],["عَلَيْهِمْ","‘alayhim","upon them","তাদের উপর"],["وَلَعَنَهُمْ","wala‘anahum","and He has cursed them","ও তাদেরকে অভিশাপ দিয়েছেন"],["وَأَعَدَّ","wa-a‘adda","and prepared","এবং প্রস্তুত করে রেখেছেন"],["لَهُمْ","lahum","for them","তাদের জন্যে"],["جَهَنَّمَ ۖ","jahannama","Hell","জাহান্নাম"],["وَسَآءَتْ","wasāat","and evil","এবং তা অতিনিকৃষ্ট"],["مَصِيرًۭا","maṣīran","(is the) destination","গন্তব্য"]],"t":"وَيُعَذِّبَ <h>ٱ</>لْمُ<m>نَٰ</>فِقِينَ وَ<h>ٱ</>لْمُ<m>نَٰفِقَٰ</>تِ وَ<h>ٱ</>لْمُشْرِكِينَ وَ<h>ٱ</>لْمُشْرِ<m>كَٰ</>تِ <h>ٱ</><l>ل</><n>ظَّآ</><g>نِّ</>ينَ بِ<h>ٱ</>للَّهِ ظَ<g>نَّ</> <h>ٱ</><l>ل</>سَّوْءِ ۚ عَلَيْهِمْ <o>دَآ</>ئِرَةُ <h>ٱ</><l>ل</>سَّوْءِ ۖ وَغَضِبَ <h>ٱ</>للَّهُ عَلَيْهِمْ وَلَعَنَهُمْ وَأَعَدَّ لَهُمْ جَهَ<g>نَّ</>مَ ۖ وَ<o>سَآ</>ءَتْ مَصِيرًۭا"},{"n":7,"w":[["وَلِلَّهِ","walillahi","And for Allah","এবং আল্লাহরই"],["جُنُودُ","junūdu","(are the) hosts","সৈন্যসমূহ"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশের"],["وَٱلْأَرْضِ ۚ","wal-arḍi","and the earth","ও পৃথিবীর"],["وَكَانَ","wakāna","and Allah","এবং হলেন"],["ٱللَّهُ","l-lahu","and Allah","আল্লাহ"],["عَزِيزًا","‘azīzan","(is) All-Mighty","মহাপরাক্রমশালী"],["حَكِيمًا","ḥakīman","All-Wise","মহাজ্ঞানী"]],"t":"وَلِلَّهِ جُنُودُ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ ۚ وَكَانَ <h>ٱ</>للَّهُ عَزِيزًا حَكِيمًا"},{"n":8,"w":[["إِنَّآ","innā","Indeed, We","নিশ্চয়ই আমরা"],["أَرْسَلْنَـٰكَ","arsalnāka","[We] have sent you","তোমাকে আমরা প্রেরণ করেছি"],["شَـٰهِدًۭا","shāhidan","(as) a witness","সাক্ষ্যদাতা"],["وَمُبَشِّرًۭا","wamubashiran","and (as) a bearer of glad tidings","ও সুসংবাদদাতা হিসেবে"],["وَنَذِيرًۭا","wanadhīran","and (as) a warner","এবং সতর্ককারীরূপে"]],"t":"إِ<g>نَّ</><o>آ</> أَرْسَلْ<m>نَٰ</>كَ <m>شَٰ</>هِ<d>دًۭا وَ</>مُبَشِّ<d>رًۭا وَ</>نَذِيرًۭا"},{"n":9,"w":[["لِّتُؤْمِنُوا۟","litu'minū","That you may believe","যাতে তোমরা ঈমান আন"],["بِٱللَّهِ","bil-lahi","in Allah","আল্লাহর উপর"],["وَرَسُولِهِۦ","warasūlihi","and His Messenger","ও তাঁর রাসূলের উপর"],["وَتُعَزِّرُوهُ","watu‘azzirūhu","and (may) honor him","এবং তাঁকে তোমরা সাহায্য কর"],["وَتُوَقِّرُوهُ","watuwaqqirūhu","and respect him","ও তাঁকে তোমরা সম্মান কর"],["وَتُسَبِّحُوهُ","watusabbiḥūhu","and glorify Him","এবং তাঁর (অর্থাৎ আল্লাহর) পবিত্রতা ঘোষণা কর"],["بُكْرَةًۭ","buk'ratan","morning","সকালে"],["وَأَصِيلًا","wa-aṣīlan","and evening","ও সন্ধ্যায়"]],"t":"لِّتُؤْمِنُو<s>ا۟</> بِ<h>ٱ</>للَّهِ وَرَسُولِ<m>هِۦ</> وَتُعَزِّرُوهُ وَتُوَقِّرُوهُ وَتُسَبِّحُوهُ بُكْرَ<d>ةًۭ وَ</>أَصِيلًا"},{"n":10,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["يُبَايِعُونَكَ","yubāyi‘ūnaka","pledge allegiance to you","তোমার কাছে আনুগত্যের শপথ নেয়"],["إِنَّمَا","innamā","only","প্রকৃতপক্ষে"],["يُبَايِعُونَ","yubāyi‘ūna","they pledge allegiance","তারা আনুগত্যের শপথ নেয়"],["ٱللَّهَ","l-laha","(to) Allah","আল্লাহর (নিকট)"],["يَدُ","yadu","(The) Hand","(ছিল) হাত"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["فَوْقَ","fawqa","(is) over","উপর"],["أَيْدِيهِمْ ۚ","aydīhim","their hands","তাদের হাতগুলোর"],["فَمَن","faman","Then whoever","সুতরাং যে"],["نَّكَثَ","nakatha","breaks (his oath)","ভঙ্গ করবে (তার ওয়াদা)"],["فَإِنَّمَا","fa-innamā","then only","প্রকৃতপক্ষে"],["يَنكُثُ","yankuthu","he breaks","সে ভঙ্গ করবে"],["عَلَىٰ","‘alā","against","উপর"],["نَفْسِهِۦ ۖ","nafsihi","himself","তার নিজের (কৃত ওয়াদা)"],["وَمَنْ","waman","and whoever","এবং যে"],["أَوْفَىٰ","awfā","fulfils","পূর্ণ করবে"],["بِمَا","bimā","what","ঐ বিষয়ে যা"],["عَـٰهَدَ","‘āhada","he has covenanted","সে অঙ্গীকার করেছে"],["عَلَيْهُ","‘alayhu","(with)","তার উপর"],["ٱللَّهَ","l-laha","Allah","আল্লাহর সাথে"],["فَسَيُؤْتِيهِ","fasayu'tīhi","soon He will give him","তবে তাকে শীঘ্রই দিবেন তিনি"],["أَجْرًا","ajran","a reward","পুরস্কার"],["عَظِيمًۭا","‘aẓīman","great","বিরাট"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ يُبَايِعُونَكَ إِ<g>نَّ</>مَا يُبَايِعُونَ <h>ٱ</>للَّهَ يَدُ <h>ٱ</>للَّهِ فَوْقَ أَيْدِيهِمْ ۚ فَ<d>مَن نَّ</>كَثَ فَإِ<g>نَّ</>مَا يَ<k>نكُ</>ثُ عَلَىٰ نَفْسِ<m>هِۦ</> ۖ وَمَنْ أَوْفَىٰ بِمَا <m>عَٰ</>هَدَ عَلَيْهُ <h>ٱ</>للَّهَ فَسَيُؤْتِيهِ أَ<q>جْ</>رًا عَظِيمًۭا"},{"n":11,"w":[["سَيَقُولُ","sayaqūlu","Will say","(হে নবী) বলবে শীঘ্রই"],["لَكَ","laka","to you","তোমাকে"],["ٱلْمُخَلَّفُونَ","l-mukhalafūna","those who remained behind","পিছনে থেকে যাওয়া লোকেরা"],["مِنَ","mina","of","মধ্যহতে"],["ٱلْأَعْرَابِ","l-a‘rābi","the Bedouins","মরুবাসীদের"],["شَغَلَتْنَآ","shaghalatnā","Kept us busy","\"আমাদেরকে ব্যস্ত রেখেছিল"],["أَمْوَٰلُنَا","amwālunā","our properties","আমাদের ধনসম্পদ"],["وَأَهْلُونَا","wa-ahlūnā","and our families","ও পরিবার পরিজন"],["فَٱسْتَغْفِرْ","fa-is'taghfir","so ask forgiveness","তাই ক্ষমাপ্রার্থনা করুন"],["لَنَا ۚ","lanā","for us","আমাদের জন্যে\""],["يَقُولُونَ","yaqūlūna","They say","তারা বলে"],["بِأَلْسِنَتِهِم","bi-alsinatihim","with their tongues","তাদের জিহ্বা দিয়ে (এমন কথা)"],["مَّا","mā","what","যা"],["لَيْسَ","laysa","is not","না"],["فِى","fī","in","মধ্যে আছে"],["قُلُوبِهِمْ ۚ","qulūbihim","their hearts","তাদের অন্তরে"],["قُلْ","qul","Say","বলো"],["فَمَن","faman","Then who","\"কে তবে"],["يَمْلِكُ","yamliku","has power","ক্ষমতা রাখে"],["لَكُم","lakum","for you","তোমাদের জন্যে"],["مِّنَ","mina","against","হতে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["شَيْـًٔا","shayan","(in) anything","কিছুমাত্র (বাঁচাতে)"],["إِنْ","in","if","যদি"],["أَرَادَ","arāda","He intends","ইচ্ছে করেন তিনি"],["بِكُمْ","bikum","for you","তোমাদেরকে"],["ضَرًّا","ḍarran","harm","ক্ষতি করতে"],["أَوْ","aw","or","অথবা"],["أَرَادَ","arāda","He intends","ইচ্ছে করেন"],["بِكُمْ","bikum","for you","তোমাদেরকে"],["نَفْعًۢا ۚ","naf‘an","a benefit","কল্যাণের (কে রুখতে পারে)"],["بَلْ","bal","Nay","বরং"],["كَانَ","kāna","is","হলেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["بِمَا","bimā","of what","ঐ বিষয়ে যা"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা কাজকর্ম করছ"],["خَبِيرًۢا","khabīran","All-Aware","খুব অবহিত"]],"t":"سَيَقُولُ لَكَ <h>ٱ</>لْمُخَلَّفُونَ مِنَ <h>ٱ</>لْأَعْرَابِ شَغَلَتْ<o>نَآ</> أَمْ<m>وَٰ</>لُنَا وَأَهْلُونَا فَ<h>ٱ</>سْتَغْفِرْ لَنَا ۚ يَقُولُونَ بِأَلْسِنَتِ<y>هِم مَّ</>ا لَيْسَ فِى قُلُوبِهِمْ ۚ قُلْ فَ<d>مَن يَ</>مْلِكُ لَ<y>كُم مِّ</>نَ <h>ٱ</>للَّهِ شَيْـًٔا إِنْ أَرَادَ بِكُمْ ضَرًّا أَوْ أَرَادَ بِكُمْ نَفْ<i>عًۢا ۚ بَ</>لْ كَانَ <h>ٱ</>للَّهُ بِمَا تَعْمَلُونَ خَبِيرًۢا"},{"n":12,"w":[["بَلْ","bal","Nay","বরং"],["ظَنَنتُمْ","ẓanantum","you thought","তোমরা ধারণা করেছিলে"],["أَن","an","that","যে"],["لَّن","lan","(would) never","কখনও না"],["يَنقَلِبَ","yanqaliba","return","ফিরে আসতে পারবে"],["ٱلرَّسُولُ","l-rasūlu","the Messenger","রাসূল"],["وَٱلْمُؤْمِنُونَ","wal-mu'minūna","and the believers","ও মু'মিনরা"],["إِلَىٰٓ","ilā","to","কাছে"],["أَهْلِيهِمْ","ahlīhim","their families","তাদের পরিবারের"],["أَبَدًۭا","abadan","ever","কখনও"],["وَزُيِّنَ","wazuyyina","that was made fair-seeming","এবং সুখকর লেগেছিল"],["ذَٰلِكَ","dhālika","that was made fair-seeming","এটা"],["فِى","fī","in","মধ্যে"],["قُلُوبِكُمْ","qulūbikum","your hearts","তোমাদের অন্তরের"],["وَظَنَنتُمْ","waẓanantum","And you assumed","এবং তোমরা ধারণা করেছিলে"],["ظَنَّ","ẓanna","an assumption","একটা ধারণা"],["ٱلسَّوْءِ","l-sawi","evil","খারাপ/ ভুল"],["وَكُنتُمْ","wakuntum","and you became","এবং তোমরা ছিলে"],["قَوْمًۢا","qawman","a people","সম্প্রদায়"],["بُورًۭا","būran","ruined","বড় (খারাপ মানসিকতার)\""]],"t":"بَلْ ظَنَ<k>نتُ</>مْ <w>أَن لَّ</><d>ن يَ</><k>نقَ</>لِبَ <h>ٱ</><l>ل</>رَّسُولُ وَ<h>ٱ</>لْمُؤْمِنُونَ إِلَ<o>ىٰٓ</> أَهْلِيهِمْ أَبَ<d>دًۭا وَ</>زُيِّنَ <m>ذَٰ</>لِكَ فِى قُلُوبِكُمْ وَظَنَ<k>نتُ</>مْ ظَ<g>نَّ</> <h>ٱ</><l>ل</>سَّوْءِ وَكُ<k>نتُ</>مْ قَوْ<i>مًۢا بُ</>ورًۭا"},{"n":13,"w":[["وَمَن","waman","And whoever","এবং যে"],["لَّمْ","lam","(has) not believed","না"],["يُؤْمِنۢ","yu'min","(has) not believed","ঈমান আনে"],["بِٱللَّهِ","bil-lahi","in Allah","আল্লাহর উপর"],["وَرَسُولِهِۦ","warasūlihi","and His Messenger","ও তাঁর রাসূলের উপর"],["فَإِنَّآ","fa-innā","then indeed, We","নিশ্চয়ই সেক্ষেত্রে আমরা"],["أَعْتَدْنَا","a‘tadnā","[We] have prepared","আমরা প্রস্তুত করে রেখেছি"],["لِلْكَـٰفِرِينَ","lil'kāfirīna","for the disbelievers","কাফেরদের জন্য"],["سَعِيرًۭا","sa‘īran","a Blazing Fire","জ্বলন্ত আগুন"]],"t":"وَ<w>مَن لَّ</>مْ يُؤْ<i>مِنۢ بِ</><h>ٱ</>للَّهِ وَرَسُولِ<m>هِۦ</> فَإِ<g>نَّ</><o>آ</> أَعْتَ<q>دْ</>نَا لِلْ<m>كَٰ</>فِرِينَ سَعِيرًۭا"},{"n":14,"w":[["وَلِلَّهِ","walillahi","And for Allah","এবং আল্লাহরই জন্য"],["مُلْكُ","mul'ku","(is the) kingdom","সার্বভৌমত্ব"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশের"],["وَٱلْأَرْضِ ۚ","wal-arḍi","and the earth","ও পৃথিবীর"],["يَغْفِرُ","yaghfiru","He forgives","তিনি মাফ করেন"],["لِمَن","liman","whom","যাকে"],["يَشَآءُ","yashāu","He wills","তিনি ইচ্ছে করেন"],["وَيُعَذِّبُ","wayu‘adhibu","and punishes","ও তিনি শাস্তি দেন"],["مَن","man","whom","যাকে"],["يَشَآءُ ۚ","yashāu","He wills","তিনি ইচ্ছে করেন"],["وَكَانَ","wakāna","And is","আর হলেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["غَفُورًۭا","ghafūran","Oft-Forgiving","ক্ষমাশীল"],["رَّحِيمًۭا","raḥīman","Most Merciful","দয়ালু"]],"t":"وَلِلَّهِ مُلْكُ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ ۚ يَغْفِرُ لِ<d>مَن يَ</><o>شَآ</>ءُ وَيُعَذِّبُ <d>مَن يَ</><o>شَآ</>ءُ ۚ وَكَانَ <h>ٱ</>للَّهُ غَفُو<w>رًۭا رَّ</>حِيمًۭا"},{"n":15,"w":[["سَيَقُولُ","sayaqūlu","Will say","বলবে শীঘ্রই"],["ٱلْمُخَلَّفُونَ","l-mukhalafūna","those who remained behind","পিছনে থেকে যাওয়া লোকেরা"],["إِذَا","idhā","when","যখন"],["ٱنطَلَقْتُمْ","inṭalaqtum","you set forth","তোমরা চলবে"],["إِلَىٰ","ilā","towards","দিকে"],["مَغَانِمَ","maghānima","(the) spoils of war","যুদ্ধলব্ধ সম্পদের"],["لِتَأْخُذُوهَا","litakhudhūhā","to take it","তা গ্রহণ করার জন্য"],["ذَرُونَا","dharūnā","Allow us","\"আমাদেরও যেতে দাও"],["نَتَّبِعْكُمْ ۖ","nattabi‘'kum","(to) follow you","তোমাদেরকে অনুসরণ করব আমরা\""],["يُرِيدُونَ","yurīdūna","They wish","তারা চায়"],["أَن","an","to","যে"],["يُبَدِّلُوا۟","yubaddilū","change","পরিবর্তন করতে"],["كَلَـٰمَ","kalāma","(the) Words","প্রতিশ্রুতি"],["ٱللَّهِ ۚ","l-lahi","(of) Allah","আল্লাহ্‌র"],["قُل","qul","Say","বলো (তাদেরকে)"],["لَّن","lan","Never","\"কখনও না"],["تَتَّبِعُونَا","tattabi‘ūnā","will you follow us","আমাদের অনুসরণ করবে তোমরা"],["كَذَٰلِكُمْ","kadhālikum","Thus","তোমাদের সম্পর্কে এরূপ"],["قَالَ","qāla","Allah said","বলে দিয়েছেন"],["ٱللَّهُ","l-lahu","Allah said","আল্লাহ্‌"],["مِن","min","before","\"থেকে"],["قَبْلُ ۖ","qablu","before","পূর্বেই (একথা)\""],["فَسَيَقُولُونَ","fasayaqūlūna","Then they will say","অতঃপর তারা বলবে অবশ্যই"],["بَلْ","bal","Nay","\"বরং"],["تَحْسُدُونَنَا ۚ","taḥsudūnanā","you envy us","আমাদেরকে তোমরা হিংসা করছ\""],["بَلْ","bal","Nay","আসলে"],["كَانُوا۟","kānū","they were","তারা হলো (এমন লোক যে)"],["لَا","lā","not","না"],["يَفْقَهُونَ","yafqahūna","understanding","তারা বুঝে"],["إِلَّا","illā","except","এছাড়া"],["قَلِيلًۭا","qalīlan","a little","অতি সামান্য"]],"t":"سَيَقُولُ <h>ٱ</>لْمُخَلَّفُونَ إِذَا <h>ٱ</><k>نطَ</>لَ<q>قْ</>تُمْ إِلَىٰ مَغَانِمَ لِتَأْخُذُوهَا ذَرُونَا نَتَّبِعْكُمْ ۖ يُرِيدُونَ <d>أَن يُ</>بَدِّلُو<s>ا۟</> كَ<m>لَٰ</>مَ <h>ٱ</>للَّهِ ۚ قُل لَّ<k>ن تَ</>تَّبِعُونَا كَ<m>ذَٰ</>لِكُمْ قَالَ <h>ٱ</>للَّهُ مِ<k>ن قَ</><q>بْ</>لُ ۖ فَسَيَقُولُونَ بَلْ تَحْسُدُونَنَا ۚ بَلْ كَانُو<s>ا۟</> لَا يَفْقَهُونَ إِلَّا قَلِيلًۭا"},{"n":16,"w":[["قُل","qul","Say","বলো"],["لِّلْمُخَلَّفِينَ","lil'mukhallafīna","to those who remained behind","পিছে থেকে যাওয়া লোকদেরকে"],["مِنَ","mina","of","মধ্য হতে"],["ٱلْأَعْرَابِ","l-a‘rābi","the Bedouins","মরুবাসীদের"],["سَتُدْعَوْنَ","satud'‘awna","You will be called","\"তোমাদের ডাকা হবে শীঘ্রই (যুদ্ধ করতে)"],["إِلَىٰ","ilā","to","দিকে"],["قَوْمٍ","qawmin","a people","এক জাতির"],["أُو۟لِى","ulī","possessors of military might","সম্পন্ন"],["بَأْسٍۢ","basin","possessors of military might","শক্তি"],["شَدِيدٍۢ","shadīdin","great","প্রবল"],["تُقَـٰتِلُونَهُمْ","tuqātilūnahum","you will fight them","তাদের সাথে তোমাদের যুদ্ধ করতে হবে"],["أَوْ","aw","or","অথবা"],["يُسْلِمُونَ ۖ","yus'limūna","they will submit","তারা আত্নসমর্পণ করবে"],["فَإِن","fa-in","Then if","যদি অতঃপর"],["تُطِيعُوا۟","tuṭī‘ū","you obey","তোমরা আনুগত্য কর"],["يُؤْتِكُمُ","yu'tikumu","Allah will give you","তোমাদেরকে দিবেন"],["ٱللَّهُ","l-lahu","Allah will give you","আল্লাহ্‌"],["أَجْرًا","ajran","a reward","পুরস্কার"],["حَسَنًۭا ۖ","ḥasanan","good","উত্তম"],["وَإِن","wa-in","but if","আর যদি"],["تَتَوَلَّوْا۟","tatawallaw","you turn away","তোমরা পিছে ফের"],["كَمَا","kamā","as","যেমন"],["تَوَلَّيْتُم","tawallaytum","you turned away","তোমরা পিছে ফিরেছ"],["مِّن","min","before","থেকে"],["قَبْلُ","qablu","before","ইতিপূর্বে"],["يُعَذِّبْكُمْ","yu‘adhib'kum","He will punish you","তিনি তোমাদের শাস্তি দিবেন"],["عَذَابًا","‘adhāban","(with) a punishment","শাস্তি"],["أَلِيمًۭا","alīman","painful","যন্ত্রণাদায়ক\""]],"t":"قُل لِّلْمُخَلَّفِينَ مِنَ <h>ٱ</>لْأَعْرَابِ سَتُ<q>دْ</>عَوْنَ إِلَىٰ قَوْمٍ أُ<s>و۟</>لِى بَأْ<k>سٍۢ شَ</>دِي<k>دٍۢ تُ</><m>قَٰ</>تِلُونَهُمْ أَوْ يُسْلِمُونَ ۖ فَإِ<k>ن تُ</>طِيعُو<s>ا۟</> يُؤْتِكُمُ <h>ٱ</>للَّهُ أَ<q>جْ</>رًا حَسَ<d>نًۭا ۖ وَ</>إِ<k>ن تَ</>تَوَلَّوْ<s>ا۟</> كَمَا تَوَلَّيْ<y>تُم مِّ</><k>ن قَ</><q>بْ</>لُ يُعَذِّ<q>بْ</>كُمْ عَذَابًا أَلِيمًۭا"},{"n":17,"w":[["لَّيْسَ","laysa","Not is","নেই"],["عَلَى","‘alā","upon","জন্যে"],["ٱلْأَعْمَىٰ","l-a‘mā","the blind","অন্ধের"],["حَرَجٌۭ","ḥarajun","any blame","কোনো অপরাধ (জিহাদে না গেলে)"],["وَلَا","walā","and not","আর নেই"],["عَلَى","‘alā","on","জন্যে"],["ٱلْأَعْرَجِ","l-a‘raji","the lame","পঙ্গুর"],["حَرَجٌۭ","ḥarajun","any blame","কোনো অপরাধ"],["وَلَا","walā","and not","এবং না"],["عَلَى","‘alā","on","জন্যে"],["ٱلْمَرِيضِ","l-marīḍi","the sick","রোগীর"],["حَرَجٌۭ ۗ","ḥarajun","any blame","কোনো অপরাধ"],["وَمَن","waman","And whoever","এবং যে"],["يُطِعِ","yuṭi‘i","obeys","আনুগত্য করে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌র"],["وَرَسُولَهُۥ","warasūlahu","and His Messenger","ও তাঁর রাসুলের"],["يُدْخِلْهُ","yud'khil'hu","He will admit him","তাকে প্রবেশ করাবেন তিনি"],["جَنَّـٰتٍۢ","jannātin","(to) Gardens","জান্নাতে"],["تَجْرِى","tajrī","flow","প্রবাহিত হয়"],["مِن","min","from","থেকে"],["تَحْتِهَا","taḥtihā","underneath them","তার নিচ"],["ٱلْأَنْهَـٰرُ ۖ","l-anhāru","the rivers","ঝর্ণাধারাসমূহ"],["وَمَن","waman","but whoever","এবং যে"],["يَتَوَلَّ","yatawalla","turns away","পিঠ ফিরাবে"],["يُعَذِّبْهُ","yu‘adhib'hu","He will punish him","তাকে তিনি শাস্তি দিবেন"],["عَذَابًا","‘adhāban","(with) a punishment","শাস্তি"],["أَلِيمًۭا","alīman","painful","যন্ত্রণাদায়ক"]],"t":"لَّيْسَ عَلَى <h>ٱ</>لْأَعْمَىٰ حَرَ<d>جٌۭ وَ</>لَا عَلَى <h>ٱ</>لْأَعْرَجِ حَرَ<d>جٌۭ وَ</>لَا عَلَى <h>ٱ</>لْمَرِيضِ حَرَ<d>جٌۭ ۗ وَمَن يُ</>طِعِ <h>ٱ</>للَّهَ وَرَسُولَهُ<m>ۥ</> يُ<q>دْ</>خِلْهُ جَ<g>نَّٰ</><k>تٍۢ تَ</><q>جْ</>رِى مِ<k>ن تَ</>حْتِهَا <h>ٱ</>لْأَنْ<m>هَٰ</>رُ ۖ وَ<d>مَن يَ</>تَوَلَّ يُعَذِّ<q>بْ</>هُ عَذَابًا أَلِيمًۭا"},{"n":18,"w":[["۞ لَّقَدْ","laqad","Certainly","নিশ্চয়ই"],["رَضِىَ","raḍiya","Allah was pleased","সন্তুষ্ট হয়েছেন"],["ٱللَّهُ","l-lahu","Allah was pleased","আল্লাহ্‌"],["عَنِ","‘ani","with","প্রতি"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believers","মু'মিনদের"],["إِذْ","idh","when","যখন"],["يُبَايِعُونَكَ","yubāyi‘ūnaka","they pledged allegiance to you","তোমার কাছে বায়'আত গ্রহণ করে তারা"],["تَحْتَ","taḥta","under","নিচে"],["ٱلشَّجَرَةِ","l-shajarati","the tree","গাছটির"],["فَعَلِمَ","fa‘alima","and He knew","তিনি তখন জানতেন"],["مَا","mā","what","যা"],["فِى","fī","(was) in","মধ্যে (ছিল)"],["قُلُوبِهِمْ","qulūbihim","their hearts","তাদের অন্তরসমূহের"],["فَأَنزَلَ","fa-anzala","so He sent down","অতঃপর অবতীর্ণ করলেন"],["ٱلسَّكِينَةَ","l-sakīnata","the tranquility","প্রশান্তি"],["عَلَيْهِمْ","‘alayhim","upon them","তাদের উপর"],["وَأَثَـٰبَهُمْ","wa-athābahum","and rewarded them","এবং তাদের পুরস্কার দিলেন"],["فَتْحًۭا","fatḥan","(with) a victory","বিজয়ের"],["قَرِيبًۭا","qarīban","near","আসন্ন"]],"t":"۞ لَّقَ<q>دْ</> رَضِىَ <h>ٱ</>للَّهُ عَنِ <h>ٱ</>لْمُؤْمِنِينَ إِذْ يُبَايِعُونَكَ تَحْتَ <h>ٱ</><l>ل</>شَّجَرَةِ فَعَلِمَ مَا فِى قُلُوبِهِمْ فَأَ<k>نزَ</>لَ <h>ٱ</><l>ل</>سَّكِينَةَ عَلَيْهِمْ وَأَ<m>ثَٰ</>بَهُمْ فَتْ<k>حًۭا قَ</>رِيبًۭا"},{"n":19,"w":[["وَمَغَانِمَ","wamaghānima","And spoils of war","এবং যুদ্ধলব্ধ সম্পদসমূহ"],["كَثِيرَةًۭ","kathīratan","much","বিপুল পরিমাণে"],["يَأْخُذُونَهَا ۗ","yakhudhūnahā","that they will take","তা তারা গ্রহণ করবে"],["وَكَانَ","wakāna","and is","এবং হলেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ্‌"],["عَزِيزًا","‘azīzan","All-Mighty","পরাক্রমশালী"],["حَكِيمًۭا","ḥakīman","All-Wise","মহাবিজ্ঞ"]],"t":"وَمَغَانِمَ كَثِيرَ<d>ةًۭ يَ</>أْخُذُونَهَا ۗ وَكَانَ <h>ٱ</>للَّهُ عَزِيزًا حَكِيمًۭا"},{"n":20,"w":[["وَعَدَكُمُ","wa‘adakumu","Allah has promised you","তোমাদেরকে প্রতিশ্রুতি দিয়েছেন"],["ٱللَّهُ","l-lahu","Allah has promised you","আল্লাহ্‌"],["مَغَانِمَ","maghānima","spoils of war","যুদ্ধলব্ধ সম্পদ সমুহের"],["كَثِيرَةًۭ","kathīratan","much","বিপুল পরিমাণ"],["تَأْخُذُونَهَا","takhudhūnahā","that you will take it","তা তোমরা গ্রহণ করবে"],["فَعَجَّلَ","fa‘ajjala","and He has hastened","এখন তিনি ত্বরান্বিত করেছেন"],["لَكُمْ","lakum","for you","তোমাদের জন্য"],["هَـٰذِهِۦ","hādhihi","this","এটা"],["وَكَفَّ","wakaffa","and has withheld","এবং বিরত রাখলেন"],["أَيْدِىَ","aydiya","(the) hands","হাতগুলোকে"],["ٱلنَّاسِ","l-nāsi","(of) the people","লোকদের"],["عَنكُمْ","‘ankum","from you ","তোমাদের থেকে"],["وَلِتَكُونَ","walitakūna","that it may be","এবং এটা হয় যেন"],["ءَايَةًۭ","āyatan","a sign","একটি নিদর্শন"],["لِّلْمُؤْمِنِينَ","lil'mu'minīna","for the believers","মু'মিনদের জন্যে"],["وَيَهْدِيَكُمْ","wayahdiyakum","and He may guide you","ও তিনি তোমাদের পরিচালনা করেন"],["صِرَٰطًۭا","ṣirāṭan","(to the) Path","পথে"],["مُّسْتَقِيمًۭا","mus'taqīman","Straight","সরল সঠিক"]],"t":"وَعَدَكُمُ <h>ٱ</>للَّهُ مَغَانِمَ كَثِيرَ<k>ةًۭ تَ</>أْخُذُونَهَا فَعَجَّلَ لَكُمْ <m>هَٰذِهِۦ</> وَكَفَّ أَيْدِىَ <h>ٱ</><l>ل</><g>نَّ</>اسِ عَ<k>نكُ</>مْ وَلِتَكُونَ ءَايَ<w>ةًۭ لِّ</>لْمُؤْمِنِينَ وَيَهْدِيَكُمْ صِ<m>رَٰ</><d>طًۭا مُّ</>سْتَقِيمًۭا"},{"n":21,"w":[["وَأُخْرَىٰ","wa-ukh'rā","And others","এবং অন্যটি"],["لَمْ","lam","not","নি"],["تَقْدِرُوا۟","taqdirū","you had power","তোমরা সক্ষম হও"],["عَلَيْهَا","‘alayhā","over them","তার উপর"],["قَدْ","qad","surely","নিশ্চয়ই"],["أَحَاطَ","aḥāṭa","Allah encompassed","পরিবেষ্টন করে রেখেছেন"],["ٱللَّهُ","l-lahu","Allah encompassed","আল্লাহ্‌"],["بِهَا ۚ","bihā","them","তা"],["وَكَانَ","wakāna","and is","এবং হলেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ্‌"],["عَلَىٰ","‘alā","over","উপর"],["كُلِّ","kulli","all","সব"],["شَىْءٍۢ","shayin","things","কিছুরই"],["قَدِيرًۭا","qadīran","All-Powerful","সর্বশক্তিমান"]],"t":"وَأُخْرَىٰ لَمْ تَ<q>قْ</>دِرُو<s>ا۟</> عَلَيْهَا قَ<q>دْ</> أَحَاطَ <h>ٱ</>للَّهُ بِهَا ۚ وَكَانَ <h>ٱ</>للَّهُ عَلَىٰ كُلِّ <k>شَىْءٍۢ قَ</>دِيرًۭا"},{"n":22,"w":[["وَلَوْ","walaw","And if","এবং যদি"],["قَـٰتَلَكُمُ","qātalakumu","fight you","তোমাদের সাথে যুদ্ধ করত"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieve","অস্বীকার করেছে"],["لَوَلَّوُا۟","lawallawū","surely they would turn","অবশ্যই ফিরত তারা"],["ٱلْأَدْبَـٰرَ","l-adbāra","the backs","পিঠ সমূহকে"],["ثُمَّ","thumma","Then","এরপর"],["لَا","lā","not","না"],["يَجِدُونَ","yajidūna","they would find","তারা পেত"],["وَلِيًّۭا","waliyyan","any protector","কোনো অভিভাবক"],["وَلَا","walā","and not","আর না"],["نَصِيرًۭا","naṣīran","any helper","কোনো সাহায্যকারী"]],"t":"وَلَوْ <m>قَٰ</>تَلَكُمُ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> لَوَلَّوُ<s>ا۟</> <h>ٱ</>لْأَ<q>دْ</><m>بَٰ</>رَ ثُ<g>مَّ</> لَا يَجِدُونَ وَلِ<d>يًّۭا وَ</>لَا نَصِيرًۭا"},{"n":23,"w":[["سُنَّةَ","sunnata","(The established) way","বিধান"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহ্‌র"],["ٱلَّتِى","allatī","which","যা"],["قَدْ","qad","passed away","নিশ্চয়ই"],["خَلَتْ","khalat","passed away","অতীত হয়েছে"],["مِن","min","before","থেকে"],["قَبْلُ ۖ","qablu","before","পূর্বেও"],["وَلَن","walan","and never","এবং কখনো না"],["تَجِدَ","tajida","you will find","পাবে তুমি"],["لِسُنَّةِ","lisunnati","in (the) way of Allah","বিধানে"],["ٱللَّهِ","l-lahi","in (the) way of Allah","আল্লাহ্‌র"],["تَبْدِيلًۭا","tabdīlan","any change","কোনো পরিবর্তন"]],"t":"سُ<g>نَّ</>ةَ <h>ٱ</>للَّهِ <h>ٱ</>لَّتِى قَ<q>دْ</> خَلَتْ مِ<k>ن قَ</><q>بْ</>لُ ۖ وَلَ<k>ن تَ</>جِدَ لِسُ<g>نَّ</>ةِ <h>ٱ</>للَّهِ تَ<q>بْ</>دِيلًۭا"},{"n":24,"w":[["وَهُوَ","wahuwa","And He","এবং তিনিই"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["كَفَّ","kaffa","withheld","বিরত রেখেছিলেন"],["أَيْدِيَهُمْ","aydiyahum","their hands","তাদের হাতগুলোকে"],["عَنكُمْ","‘ankum","from you","তোমাদের হতে"],["وَأَيْدِيَكُمْ","wa-aydiyakum","and your hands","ও তোমাদের হাতগুলোকে"],["عَنْهُم","‘anhum","from them","তাদের হতে"],["بِبَطْنِ","bibaṭni","within","উপকণ্ঠে"],["مَكَّةَ","makkata","Makkah","মক্কার"],["مِنۢ","min","after","থেকে"],["بَعْدِ","ba‘di","after","এরপরেও"],["أَنْ","an","that","যে"],["أَظْفَرَكُمْ","aẓfarakum","He gave you victory","তোমাদের বিজয় দিয়েছিলেন"],["عَلَيْهِمْ ۚ","‘alayhim","over them","তাদের বিরুদ্ধে"],["وَكَانَ","wakāna","And is","এবং হলেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ্‌"],["بِمَا","bimā","of what","ঐ বিষয়ে যা"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা কাজ কর"],["بَصِيرًا","baṣīran","All-Seer","খুব দেখছেন"]],"t":"وَهُوَ <h>ٱ</>لَّذِى كَفَّ أَيْدِيَهُمْ عَ<k>نكُ</>مْ وَأَيْدِيَكُمْ عَنْ<f>هُم بِ</>بَ<q>طْ</>نِ مَكَّةَ <i>مِنۢ بَ</>عْدِ أَنْ أَظْفَرَكُمْ عَلَيْهِمْ ۚ وَكَانَ <h>ٱ</>للَّهُ بِمَا تَعْمَلُونَ بَصِيرًا"},{"n":25,"w":[["هُمُ","humu","They","তিনিই"],["ٱلَّذِينَ","alladhīna","(are) those who","যারা"],["كَفَرُوا۟","kafarū","disbelieved","অস্বীকার করেছে"],["وَصَدُّوكُمْ","waṣaddūkum","and hindered you","ও তোমাদের বাধা দিয়েছে"],["عَنِ","‘ani","from","হতে"],["ٱلْمَسْجِدِ","l-masjidi","Al-Masjid Al-Haraam","মসজিদে"],["ٱلْحَرَامِ","l-ḥarāmi","Al-Masjid Al-Haraam","হারাম"],["وَٱلْهَدْىَ","wal-hadya","while the offering","এবং কুরবানির পশুগুলোকে"],["مَعْكُوفًا","ma‘kūfan","(was) prevented","(যা ছিল) 'আবদ্ধ'"],["أَن","an","from","যে"],["يَبْلُغَ","yablugha","reaching","পৌঁছবে"],["مَحِلَّهُۥ ۚ","maḥillahu","its place (of sacrifice)","তার কুরবানির জায়গায়"],["وَلَوْلَا","walawlā","And if not","এবং যদি না (আশংকা থাকত)"],["رِجَالٌۭ","rijālun","(for) men","(এমন কিছু) পুরুষ"],["مُّؤْمِنُونَ","mu'minūna","believing","মু'মিন"],["وَنِسَآءٌۭ","wanisāon","and women","ও নারী"],["مُّؤْمِنَـٰتٌۭ","mu'minātun","believing","মু'মিন"],["لَّمْ","lam","not","না"],["تَعْلَمُوهُمْ","ta‘lamūhum","you knew them","যাদেরকে তোমরা জানতে"],["أَن","an","that","যে"],["تَطَـُٔوهُمْ","taṭaūhum","you may trample them","তাদেরকে পদদলিত করতে তোমরা"],["فَتُصِيبَكُم","fatuṣībakum","and would befall you","ফলে তোমাদের পৌছুত"],["مِّنْهُم","min'hum","from them","তাদের কারণে"],["مَّعَرَّةٌۢ","ma‘arratun","any harm","ক্ষতির সম্মুখীন"],["بِغَيْرِ","bighayri","without","না"],["عِلْمٍۢ ۖ","‘il'min","knowledge","জেনে"],["لِّيُدْخِلَ","liyud'khila","That Allah may admit","(এটা করেছেন এজন্যে) প্রবেশ করান যেন"],["ٱللَّهُ","l-lahu","That Allah may admit","আল্লাহ্‌"],["فِى","fī","to","মধ্যে"],["رَحْمَتِهِۦ","raḥmatihi","His Mercy","তাঁর অনুগ্রহের"],["مَن","man","whom","যাকে"],["يَشَآءُ ۚ","yashāu","He wills","তিনি ইচ্ছে করেন"],["لَوْ","law","If","যদি"],["تَزَيَّلُوا۟","tazayyalū","they had been apart","তারা পৃথক হত"],["لَعَذَّبْنَا","la‘adhabnā","surely, We would have punished","আমরা শাস্তি দিতাম অবশ্যই"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["كَفَرُوا۟","kafarū","disbelieved","অস্বীকার করেছে"],["مِنْهُمْ","min'hum","among them","তাদের মধ্য হতে"],["عَذَابًا","‘adhāban","(with) a punishment","শাস্তি"],["أَلِيمًا","alīman","painful","যন্ত্রণাদায়ক"]],"t":"هُمُ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> وَصَدُّوكُمْ عَنِ <h>ٱ</>لْمَسْجِدِ <h>ٱ</>لْحَرَامِ وَ<h>ٱ</>لْهَ<q>دْ</>ىَ مَعْكُوفًا <d>أَن يَ</><q>بْ</>لُغَ مَحِلَّهُ<m>ۥ</> ۚ وَلَوْلَا رِجَا<d>لٌۭ مُّ</>ؤْمِنُونَ وَنِ<o>سَآ</><d>ءٌۭ مُّ</>ؤْمِ<m>نَٰ</><w>تٌۭ لَّ</>مْ تَعْلَمُوهُمْ أَ<k>ن تَ</>طَـُٔوهُمْ فَتُصِيبَ<y>كُم مِّنْهُم مَّ</>عَرَّ<i>ةٌۢ بِ</>غَيْرِ عِلْ<w>مٍۢ ۖ لِّ</>يُ<q>دْ</>خِلَ <h>ٱ</>للَّهُ فِى رَحْمَتِ<m>هِۦ</> <d>مَن يَ</><o>شَآ</>ءُ ۚ لَوْ تَزَيَّلُو<s>ا۟</> لَعَذَّ<q>بْ</>نَا <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> مِنْهُمْ عَذَابًا أَلِيمًا"},{"n":26,"w":[["إِذْ","idh","When","যখন"],["جَعَلَ","ja‘ala","had put","পোষণ করল"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieved","অস্বীকার করেছিল"],["فِى","fī","in","মধ্যে"],["قُلُوبِهِمُ","qulūbihimu","their hearts","তাদের অন্তরগুলোর"],["ٱلْحَمِيَّةَ","l-ḥamiyata","disdain ","হঠকারিতা"],["حَمِيَّةَ","ḥamiyyata","(the) disdain","হঠকারিতা"],["ٱلْجَـٰهِلِيَّةِ","l-jāhiliyati","(of the time of) ignorance","অজ্ঞতার"],["فَأَنزَلَ","fa-anzala","Then Allah sent down","তখন অবতীর্ণ করলেন"],["ٱللَّهُ","l-lahu","Then Allah sent down","আল্লাহ্‌"],["سَكِينَتَهُۥ","sakīnatahu","His tranquility","তাঁর প্রশান্তি"],["عَلَىٰ","‘alā","upon","উপর"],["رَسُولِهِۦ","rasūlihi","His Messenger","তাঁর রাসূলের"],["وَعَلَى","wa‘alā","and upon","ও উপর"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believers","মু'মিনদের"],["وَأَلْزَمَهُمْ","wa-alzamahum","and made them adhere","এবং তাদেরকে সংহত করলেন"],["كَلِمَةَ","kalimata","(to the) word","(কথায়) নীতিতে"],["ٱلتَّقْوَىٰ","l-taqwā","(of) righteousness","তাকওয়ার"],["وَكَانُوٓا۟","wakānū","and they were","এবং তারা ছিল"],["أَحَقَّ","aḥaqqa","more deserving","অধিক যোগ্য"],["بِهَا","bihā","of it","এর"],["وَأَهْلَهَا ۚ","wa-ahlahā","and worthy of it","ও তার উপযুক্ত"],["وَكَانَ","wakāna","And is","এবং হলেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ্‌"],["بِكُلِّ","bikulli","of every","সম্পর্কে"],["شَىْءٍ","shayin","thing","সবকিছু"],["عَلِيمًۭا","‘alīman","All-Knower","খুব জ্ঞাত"]],"t":"إِذْ جَعَلَ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> فِى قُلُوبِهِمُ <h>ٱ</>لْحَمِيَّةَ حَمِيَّةَ <h>ٱ</>لْ<m>جَٰ</>هِلِيَّةِ فَأَ<k>نزَ</>لَ <h>ٱ</>للَّهُ سَكِينَتَهُ<m>ۥ</> عَلَىٰ رَسُولِ<m>هِۦ</> وَعَلَى <h>ٱ</>لْمُؤْمِنِينَ وَأَلْزَمَهُمْ كَلِمَةَ <h>ٱ</><l>ل</>تَّ<q>قْ</>وَىٰ وَكَا<o>نُوٓ</><s>ا۟</> أَحَقَّ بِهَا وَأَهْلَهَا ۚ وَكَانَ <h>ٱ</>للَّهُ بِكُلِّ شَىْءٍ عَلِيمًۭا"},{"n":27,"w":[["لَّقَدْ","laqad","Certainly","নিশ্চয়ই"],["صَدَقَ","ṣadaqa","Allah has fulfilled","সত্য করে দেখিয়েছেন"],["ٱللَّهُ","l-lahu","Allah has fulfilled","আল্লাহ্‌"],["رَسُولَهُ","rasūlahu","His Messenger's","তাঁর রাসুলের"],["ٱلرُّءْيَا","l-ru'yā","vision","স্বপ্নকে"],["بِٱلْحَقِّ ۖ","bil-ḥaqi","in truth","সঠিকভাবে"],["لَتَدْخُلُنَّ","latadkhulunna","Surely, you will enter","অবশ্যই তোমরা প্রবেশ করবে"],["ٱلْمَسْجِدَ","l-masjida","Al-Masjid Al-Haraam","মসজিদে"],["ٱلْحَرَامَ","l-ḥarāma","Al-Masjid Al-Haraam","হারামে"],["إِن","in","if","যদি"],["شَآءَ","shāa","Allah wills","ইচ্ছে করেন"],["ٱللَّهُ","l-lahu","Allah wills","আল্লাহ্‌"],["ءَامِنِينَ","āminīna","secure","নিরাপদে"],["مُحَلِّقِينَ","muḥalliqīna","having shaved","(কেউ কেউ) মুণ্ডনকারী"],["رُءُوسَكُمْ","ruūsakum","your heads","তোমাদের মাথা"],["وَمُقَصِّرِينَ","wamuqaṣṣirīna","and shortened","ও (কেউ কেউ) চুল ছোটকারী হয়ে"],["لَا","lā","not","না"],["تَخَافُونَ ۖ","takhāfūna","fearing","তোমরা ভয় পাবে"],["فَعَلِمَ","fa‘alima","But He knew","তিনি বস্তুতঃ জানেন"],["مَا","mā","what","যা"],["لَمْ","lam","not","না"],["تَعْلَمُوا۟","ta‘lamū","you knew","তোমরা জান"],["فَجَعَلَ","faja‘ala","and He made","তাই তিনি দিয়েছেন"],["مِن","min","besides","থেকে"],["دُونِ","dūni","besides","ছাড়া"],["ذَٰلِكَ","dhālika","that","সেটা"],["فَتْحًۭا","fatḥan","a victory","একটি বিজয়"],["قَرِيبًا","qarīban","near","আসন্ন"]],"t":"لَّقَ<q>دْ</> صَدَقَ <h>ٱ</>للَّهُ رَسُولَهُ <h>ٱ</><l>ل</>رُّءْيَا بِ<h>ٱ</>لْحَقِّ ۖ لَتَ<q>دْ</>خُلُ<g>نَّ</> <h>ٱ</>لْمَسْجِدَ <h>ٱ</>لْحَرَامَ إِ<k>ن شَ</><o>آ</>ءَ <h>ٱ</>للَّهُ ءَامِنِينَ مُحَلِّقِينَ رُءُوسَكُمْ وَمُقَصِّرِينَ لَا تَخَافُونَ ۖ فَعَلِمَ مَا لَمْ تَعْلَمُو<s>ا۟</> فَجَعَلَ مِ<k>ن دُ</>ونِ <m>ذَٰ</>لِكَ فَتْ<k>حًۭا قَ</>رِيبًا"},{"n":28,"w":[["هُوَ","huwa","He","তিনিই"],["ٱلَّذِىٓ","alladhī","(is) the One Who","যিনি"],["أَرْسَلَ","arsala","(has) sent","প্রেরণ করেছেন"],["رَسُولَهُۥ","rasūlahu","His Messenger","তাঁর রাসুলকে"],["بِٱلْهُدَىٰ","bil-hudā","with guidance","দিয়ে দিক-নির্দেশনা"],["وَدِينِ","wadīni","and (the) religion","ও দীন"],["ٱلْحَقِّ","l-ḥaqi","the true","সত্য (দিয়ে)"],["لِيُظْهِرَهُۥ","liyuẓ'hirahu","that He (may) make it prevail","তা বিজয়ী করার জন্যে"],["عَلَى","‘alā","over","উপর"],["ٱلدِّينِ","l-dīni","the religions","দীনের"],["كُلِّهِۦ ۚ","kullihi","all","অন্যান্য সব"],["وَكَفَىٰ","wakafā","And sufficient is","এবং যথেষ্ট"],["بِٱللَّهِ","bil-lahi","Allah","আল্লাহই এ বিষয়ে"],["شَهِيدًۭا","shahīdan","(as) a Witness","সাক্ষী হিসেবে"]],"t":"هُوَ <h>ٱ</>لَّ<o>ذِىٓ</> أَرْسَلَ رَسُولَهُ<m>ۥ</> بِ<h>ٱ</>لْهُدَىٰ وَدِينِ <h>ٱ</>لْحَقِّ لِيُظْهِرَهُ<m>ۥ</> عَلَى <h>ٱ</><l>ل</>دِّينِ كُلِّ<m>هِۦ</> ۚ وَكَفَىٰ بِ<h>ٱ</>للَّهِ شَهِيدًۭا"},{"n":29,"w":[["مُّحَمَّدٌۭ","muḥammadun","Muhammad","মুহাম্মাদ"],["رَّسُولُ","rasūlu","(is the) Messenger","রাসুল"],["ٱللَّهِ ۚ","l-lahi","of Allah","আল্লাহ্‌র"],["وَٱلَّذِينَ","wa-alladhīna","and those who","এবং যারা"],["مَعَهُۥٓ","ma‘ahu","(are) with him","তাঁর সাথে (আছে)"],["أَشِدَّآءُ","ashiddāu","(are) firm","তারা কঠোর"],["عَلَى","‘alā","against","বিরুদ্ধে"],["ٱلْكُفَّارِ","l-kufāri","the disbelievers","কাফিরদের"],["رُحَمَآءُ","ruḥamāu","and merciful","তারা সহানুভূতিশীল"],["بَيْنَهُمْ ۖ","baynahum","among themselves","তাদের (নিজেদের) মাঝে"],["تَرَىٰهُمْ","tarāhum","You see them","তাদের দেখবে তুমি"],["رُكَّعًۭا","rukka‘an","bowing","রুকুকারী"],["سُجَّدًۭا","sujjadan","and prostrating","সিজদাকারী হিসেবে"],["يَبْتَغُونَ","yabtaghūna","seeking","তারা সন্ধান করে"],["فَضْلًۭا","faḍlan","Bounty","অনুগ্রহ"],["مِّنَ","mina","from Allah","নিকট হতে"],["ٱللَّهِ","l-lahi","from Allah","আল্লাহ্‌র"],["وَرِضْوَٰنًۭا ۖ","wariḍ'wānan","and pleasure","ও (তাঁর) সন্তুষ্টি"],["سِيمَاهُمْ","sīmāhum","Their mark","তাদের চিহ্ন (উজ্জ্বল হয়ে আছে)"],["فِى","fī","(is) on","মধ্যে"],["وُجُوهِهِم","wujūhihim","their faces","তাদের চেহারার"],["مِّنْ","min","from","থেকে"],["أَثَرِ","athari","(the) trace","প্রভাবে"],["ٱلسُّجُودِ ۚ","l-sujūdi","(of) the prostration","সিজদাসমূহের"],["ذَٰلِكَ","dhālika","That","এই"],["مَثَلُهُمْ","mathaluhum","(is) their similitude","তাদের গুণ পরিচয়"],["فِى","fī","in","মধ্যে (রয়েছে)"],["ٱلتَّوْرَىٰةِ ۚ","l-tawrāti","the Taurah","তাওরাতের"],["وَمَثَلُهُمْ","wamathaluhum","And their similitude","এবং তাদের গুণ পরিচয়"],["فِى","fī","in","মধ্যে (রয়েছে)"],["ٱلْإِنجِيلِ","l-injīli","the Injeel","ইনজিলেরও"],["كَزَرْعٍ","kazar‘in","(is) like a seed","(তাদের) উপমা একটি চারাগাছের"],["أَخْرَجَ","akhraja","(which) sends forth","(যা) নির্গত করে"],["شَطْـَٔهُۥ","shaṭahu","its shoot","তার অংকুর"],["فَـَٔازَرَهُۥ","faāzarahu","then strengthens it","এরপর তাকে শক্তিশালী করে"],["فَٱسْتَغْلَظَ","fa-is'taghlaẓa","then it becomes thick","অতঃপর মোটা হয়"],["فَٱسْتَوَىٰ","fa-is'tawā","and it stands","অতঃপর দৃঢ়ভাবে দাঁড়ায়"],["عَلَىٰ","‘alā","upon","উপর"],["سُوقِهِۦ","sūqihi","its stem","তার কাণ্ডের"],["يُعْجِبُ","yu‘'jibu","delighting","আনন্দ দেয়"],["ٱلزُّرَّاعَ","l-zurā‘a","the sowers","চাষীদেরকে"],["لِيَغِيظَ","liyaghīẓa","that He (may) enrage","তিনি জ্বালা সৃষ্টি করেন যেন"],["بِهِمُ","bihimu","by them","তাদের কারণে"],["ٱلْكُفَّارَ ۗ","l-kufāra","the disbelievers","কাফিরদের"],["وَعَدَ","wa‘ada","Allah has promised","প্রতিশ্রুতি দিয়েছেন"],["ٱللَّهُ","l-lahu","Allah has promised","আল্লাহ্‌"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["وَعَمِلُوا۟","wa‘amilū","and do","ও কাজ করেছে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","righteous deeds","সৎকর্ম"],["مِنْهُم","min'hum","among them","তাদের মধ্য হতে"],["مَّغْفِرَةًۭ","maghfiratan","forgiveness","ক্ষমা"],["وَأَجْرًا","wa-ajran","and a reward","ও পুরস্কার"],["عَظِيمًۢا","‘aẓīman","great","মহা"]],"t":"مُّحَ<g>مَّ</><w>دٌۭ رَّ</>سُولُ <h>ٱ</>للَّهِ ۚ وَ<h>ٱ</>لَّذِينَ مَعَهُ<o>ۥٓ</> أَشِ<o>دَّآ</>ءُ عَلَى <h>ٱ</>لْكُفَّارِ رُحَ<o>مَآ</>ءُ بَيْنَهُمْ ۖ تَرَ<m>ىٰ</>هُمْ رُكَّ<k>عًۭا سُ</>جَّ<d>دًۭا يَ</><q>بْ</>تَغُونَ فَضْلًۭ<d>ا مِّ</>نَ <h>ٱ</>للَّهِ وَرِضْ<m>وَٰ</><k>نًۭا ۖ سِ</>يمَاهُمْ فِى وُجُوهِ<y>هِم مِّ</>نْ أَثَرِ <h>ٱ</><l>ل</>سُّجُودِ ۚ <m>ذَٰ</>لِكَ مَثَلُهُمْ فِى <h>ٱ</><l>ل</>تَّوْرَ<m>ىٰ</>ةِ ۚ وَمَثَلُهُمْ فِى <h>ٱ</>لْإِ<k>نجِ</>يلِ كَزَرْعٍ أَخْرَجَ شَ<q>طْـَٔ</>هُ<m>ۥ</> فَـَٔازَرَهُ<m>ۥ</> فَ<h>ٱ</>سْتَغْلَظَ فَ<h>ٱ</>سْتَوَىٰ عَلَىٰ سُوقِ<m>هِۦ</> يُعْجِبُ <h>ٱ</><l>ل</>زُّرَّاعَ لِيَغِيظَ بِهِمُ <h>ٱ</>لْكُفَّارَ ۗ وَعَدَ <h>ٱ</>للَّهُ <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ مِنْ<y>هُم مَّ</>غْفِرَ<d>ةًۭ وَ</>أَ<q>جْ</>رًا عَظِيمًۢا"}]}