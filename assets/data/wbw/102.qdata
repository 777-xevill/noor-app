{"n":102,"a":[{"n":1,"w":[["أَلْهَىٰكُمُ","alhākumu","Diverts you","তোমাদের মোহাচ্ছন্ন করে রেখেছে"],["ٱلتَّكَاثُرُ","l-takāthuru","the competition to increase","প্রাচুর্যের প্রতিযোগিতা"]],"t":"أَلْهَ<m>ىٰ</>كُمُ <h>ٱ</><l>ل</>تَّكَاثُرُ"},{"n":2,"w":[["حَتَّىٰ","ḥattā","Until","যতক্ষণ না"],["زُرْتُمُ","zur'tumu","you visit","তোমরা উপস্থিত হও"],["ٱلْمَقَابِرَ","l-maqābira","the graves","কবরসমূহে"]],"t":"حَتَّىٰ زُرْتُمُ <h>ٱ</>لْمَقَابِرَ"},{"n":3,"w":[["كَلَّا","kallā","Nay","এটা সঙ্গত নয়"],["سَوْفَ","sawfa","Soon","শীঘ্রই"],["تَعْلَمُونَ","ta‘lamūna","you will know","তোমরা জানবে"]],"t":"كَلَّا سَوْفَ تَعْلَ<p>مُو</>نَ"},{"n":4,"w":[["ثُمَّ","thumma","Then","আবার বলি"],["كَلَّا","kallā","nay","এটা সঙ্গত নয়"],["سَوْفَ","sawfa","Soon","শীঘ্রই"],["تَعْلَمُونَ","ta‘lamūna","you will know","তোমরা জানবে"]],"t":"ثُ<g>مَّ</> كَلَّا سَوْفَ تَعْلَ<p>مُو</>نَ"},{"n":5,"w":[["كَلَّا","kallā","Nay","সাবধান!"],["لَوْ","law","If","যদি"],["تَعْلَمُونَ","ta‘lamūna","you know","তোমরা জানতে"],["عِلْمَ","‘il'ma","(with) a knowledge","জ্ঞানে"],["ٱلْيَقِينِ","l-yaqīni","(of) certainty","নিশ্চিত"]],"t":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ <h>ٱ</>لْيَ<p>قِي</>نِ"},{"n":6,"w":[["لَتَرَوُنَّ","latarawunna","Surely you will see","অবশ্যই তোমরা দেখবে"],["ٱلْجَحِيمَ","l-jaḥīma","the Hellfire","দোযখ"]],"t":"لَتَرَوُ<g>نَّ</> <h>ٱ</>لْجَ<p>حِي</>مَ"},{"n":7,"w":[["ثُمَّ","thumma","Then","আবার (শুনো)"],["لَتَرَوُنَّهَا","latarawunnahā","surely you will see it","অবশ্যই তা তোমরা দেখবে"],["عَيْنَ","‘ayna","(with the) eye","চোখে"],["ٱلْيَقِينِ","l-yaqīni","(of) certainty","প্রত্যয়"]],"t":"ثُ<g>مَّ</> لَتَرَوُ<g>نَّ</>هَا عَيْنَ <h>ٱ</>لْيَ<p>قِي</>نِ"},{"n":8,"w":[["ثُمَّ","thumma","Then","পরে"],["لَتُسْـَٔلُنَّ","latus'alunna","surely you will be asked","অবশ্যই তোমাদের জিজ্ঞেস করা হবেই"],["يَوْمَئِذٍ","yawma-idhin","that Day","সেদিন"],["عَنِ","‘ani","about","সম্পর্কে"],["ٱلنَّعِيمِ","l-na‘īmi","the pleasures","নিয়ামতসমূহ"]],"t":"ثُ<g>مَّ</> لَتُسْـَٔلُ<g>نَّ</> يَوْمَئِذٍ عَنِ <h>ٱ</><l>ل</><g>نَّ</><p>عِي</>مِ"}]}