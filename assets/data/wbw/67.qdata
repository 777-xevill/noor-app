{"n":67,"a":[{"n":1,"w":[["تَبَـٰرَكَ","tabāraka","Blessed is","বড় বরকতময়"],["ٱلَّذِى","alladhī","He","সেই(সত্তা)"],["بِيَدِهِ","biyadihi","in Whose Hand","যার হাতে"],["ٱلْمُلْكُ","l-mul'ku","(is) the Dominion","কর্তৃত্ব"],["وَهُوَ","wahuwa","and He","এবং তিনিই"],["عَلَىٰ","‘alā","(is) over","উপর"],["كُلِّ","kulli","every","সব"],["شَىْءٍۢ","shayin","thing","কিছুর"],["قَدِيرٌ","qadīrun","All-Powerful","ক্ষমতাবান"]],"t":"تَ<m>بَٰ</>رَكَ <h>ٱ</>لَّذِى بِيَدِهِ <h>ٱ</>لْمُلْكُ وَهُوَ عَلَىٰ كُلِّ <k>شَىْءٍۢ قَ</><p>دِي</>رٌ"},{"n":2,"w":[["ٱلَّذِى","alladhī","The One Who","যিনি"],["خَلَقَ","khalaqa","created","সৃষ্টি করেছেন"],["ٱلْمَوْتَ","l-mawta","death","মৃত্যু"],["وَٱلْحَيَوٰةَ","wal-ḥayata","and life","এবং জীবন"],["لِيَبْلُوَكُمْ","liyabluwakum","that He may test you","তোমাদের পরীক্ষা করার জন্য"],["أَيُّكُمْ","ayyukum","which of you","তোমাদের মধ্যে কে"],["أَحْسَنُ","aḥsanu","(is) best","সর্বোত্তম"],["عَمَلًۭا ۚ","‘amalan","(in) deed","আমলে"],["وَهُوَ","wahuwa","And He","এবং তিনিই"],["ٱلْعَزِيزُ","l-‘azīzu","(is) the All-Mighty","পরাক্রমশালী"],["ٱلْغَفُورُ","l-ghafūru","the Oft-Forgiving","ক্ষমাশীল"]],"t":"ٱلَّذِى خَلَقَ <h>ٱ</>لْمَوْتَ وَ<h>ٱ</>لْحَيَ<s>وٰ</>ةَ لِيَ<q>بْ</>لُوَكُمْ أَيُّكُمْ أَحْسَنُ عَمَلًۭ<d>ا ۚ وَ</>هُوَ <h>ٱ</>لْعَزِيزُ <h>ٱ</>لْغَ<p>فُو</>رُ"},{"n":3,"w":[["ٱلَّذِى","alladhī","The One Who","তিনিই"],["خَلَقَ","khalaqa","created","সৃষ্টি করেছেন"],["سَبْعَ","sab‘a","seven","সাত"],["سَمَـٰوَٰتٍۢ","samāwātin","heavens","আকাশ"],["طِبَاقًۭا ۖ","ṭibāqan","one above another","স্তরে স্তরে"],["مَّا","mā","Not","না"],["تَرَىٰ","tarā","you see","দেখতে পাবে"],["فِى","fī","in","মধ্যে"],["خَلْقِ","khalqi","(the) creation","সৃষ্টির"],["ٱلرَّحْمَـٰنِ","l-raḥmāni","(of) the Most Gracious","দয়াবানের"],["مِن","min","any","কোন"],["تَفَـٰوُتٍۢ ۖ","tafāwutin","fault","অসঙ্গতি"],["فَٱرْجِعِ","fa-ir'ji‘i","So return","অতএব ফিরাও"],["ٱلْبَصَرَ","l-baṣara","the vision","দৃষ্টিশক্তি"],["هَلْ","hal","can","কি"],["تَرَىٰ","tarā","you see","দেখতে পাও"],["مِن","min","any","কোন"],["فُطُورٍۢ","fuṭūrin","flaw","ত্রুটি"]],"t":"ٱلَّذِى خَلَقَ سَ<q>بْ</>عَ سَ<m>مَٰوَٰ</><k>تٍۢ طِ</>بَا<d>قًۭا ۖ مَّ</>ا تَرَىٰ فِى خَلْقِ <h>ٱ</><l>ل</>رَّحْ<m>مَٰ</>نِ مِ<k>ن تَ</><m>فَٰ</>وُ<k>تٍۢ ۖ فَ</><h>ٱ</>رْجِعِ <h>ٱ</>لْبَصَرَ هَلْ تَرَىٰ مِ<k>ن فُ</><p>طُو</>رٍۢ"},{"n":4,"w":[["ثُمَّ","thumma","Then","আবার"],["ٱرْجِعِ","ir'ji‘i","return","ফিরাও"],["ٱلْبَصَرَ","l-baṣara","the vision","দৃষ্টি"],["كَرَّتَيْنِ","karratayni","twice (again)","বার বার"],["يَنقَلِبْ","yanqalib","Will return","ফিরে আসবে"],["إِلَيْكَ","ilayka","to you","তোমার দিকে"],["ٱلْبَصَرُ","l-baṣaru","the vision","দৃষ্টি"],["خَاسِئًۭا","khāsi-an","humbled","ব্যর্থ হয়ে"],["وَهُوَ","wahuwa","while it","এবং তা (হবে)"],["حَسِيرٌۭ","ḥasīrun","(is) fatigued","ক্লান্তশ্রান্ত"]],"t":"ثُ<g>مَّ</> <h>ٱ</>رْجِعِ <h>ٱ</>لْبَصَرَ كَرَّتَيْنِ يَ<k>نقَ</>لِ<q>بْ</> إِلَيْكَ <h>ٱ</>لْبَصَرُ خَاسِ<d>ئًۭا وَ</>هُوَ حَ<p>سِي</>رٌۭ"},{"n":5,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়"],["زَيَّنَّا","zayyannā","We have beautified","আমরা সাজিয়েছি"],["ٱلسَّمَآءَ","l-samāa","the heaven","আকাশকে"],["ٱلدُّنْيَا","l-dun'yā","nearest","নিকটবর্তী"],["بِمَصَـٰبِيحَ","bimaṣābīḥa","with lamps","প্রদীপরাশি দিয়ে"],["وَجَعَلْنَـٰهَا","waja‘alnāhā","and We have made them","এবং তা আমরা বানিয়েছি"],["رُجُومًۭا","rujūman","(as) missiles","নিক্ষেপ উপকরণ"],["لِّلشَّيَـٰطِينِ ۖ","lilshayāṭīni","for the devils","শয়তানদের জন্য"],["وَأَعْتَدْنَا","wa-a‘tadnā","and We have prepared","এবং আমরা প্রস্তুত করে রেখেছি"],["لَهُمْ","lahum","for them","তাদের জন্যে"],["عَذَابَ","‘adhāba","punishment","শাস্তি"],["ٱلسَّعِيرِ","l-sa‘īri","(of) the Blaze","প্রজ্জ্বলিত আগুনের"]],"t":"وَلَقَ<q>دْ</> زَيَّ<g>نَّ</>ا <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءَ <h>ٱ</><l>ل</>دُّنْيَا بِمَ<m>صَٰ</>بِيحَ وَجَعَلْ<m>نَٰ</>هَا رُجُو<w>مًۭا لِّ</>لشَّ<m>يَٰ</>طِينِ ۖ وَأَعْتَ<q>دْ</>نَا لَهُمْ عَذَابَ <h>ٱ</><l>ل</>سَّ<p>عِي</>رِ"},{"n":6,"w":[["وَلِلَّذِينَ","walilladhīna","And for those who","এবং যারা জন্যে"],["كَفَرُوا۟","kafarū","disbelieved","অস্বীকার করেছে"],["بِرَبِّهِمْ","birabbihim","in their Lord","তাদের রবকে"],["عَذَابُ","‘adhābu","(is the) punishment","শাস্তি"],["جَهَنَّمَ ۖ","jahannama","(of) Hell","জাহান্নামের"],["وَبِئْسَ","wabi'sa","and wretched is","এবং অত্যন্ত খারাপ"],["ٱلْمَصِيرُ","l-maṣīru","the destination","প্রত্যাবর্তন স্থল"]],"t":"وَلِلَّذِينَ كَفَرُو<s>ا۟</> بِرَبِّهِمْ عَذَابُ جَهَ<g>نَّ</>مَ ۖ وَبِئْسَ <h>ٱ</>لْمَ<p>صِي</>رُ"},{"n":7,"w":[["إِذَآ","idhā","When","যখন"],["أُلْقُوا۟","ul'qū","they are thrown","নিক্ষিপ্ত হবে"],["فِيهَا","fīhā","therein","তার মধ্যে"],["سَمِعُوا۟","sami‘ū","they will hear","তারা শুনবে"],["لَهَا","lahā","from it","তার জন্য"],["شَهِيقًۭا","shahīqan","an inhaling","বিকট শব্দ"],["وَهِىَ","wahiya","while it","এবং তা"],["تَفُورُ","tafūru","boils up","উদ্বেলিত হবে"]],"t":"إِ<o>ذَآ</> أُلْقُو<s>ا۟</> فِيهَا سَمِعُو<s>ا۟</> لَهَا شَهِي<d>قًۭا وَ</>هِىَ تَ<p>فُو</>رُ"},{"n":8,"w":[["تَكَادُ","takādu","It almost","উপক্রম হবে"],["تَمَيَّزُ","tamayyazu","bursts","ফেটে পড়ার"],["مِنَ","mina","from","মধ্য হতে"],["ٱلْغَيْظِ ۖ","l-ghayẓi","rage","রোষে"],["كُلَّمَآ","kullamā","Every time","যখনই"],["أُلْقِىَ","ul'qiya","is thrown","নিক্ষিপ্ত হবে"],["فِيهَا","fīhā","therein","তার মধ্যে"],["فَوْجٌۭ","fawjun","a group","কোন দল"],["سَأَلَهُمْ","sa-alahum","(will) ask them","জিজ্ঞেস তাদের করবে"],["خَزَنَتُهَآ","khazanatuhā","its keepers","তার রক্ষীরা"],["أَلَمْ","alam","Did not","\"নাই কি"],["يَأْتِكُمْ","yatikum","come to you","তোমাদের কাছে আসে"],["نَذِيرٌۭ","nadhīrun","a warner","সতর্ককারী\""]],"t":"تَكَادُ تَمَيَّزُ مِنَ <h>ٱ</>لْغَيْظِ ۖ كُلَّ<o>مَآ</> أُلْقِىَ فِيهَا فَوْ<k>جٌۭ سَ</>أَلَهُمْ خَزَنَتُ<o>هَآ</> أَلَمْ يَأْتِكُمْ نَ<p>ذِي</>رٌۭ"},{"n":9,"w":[["قَالُوا۟","qālū","They will say","তারা বলবে"],["بَلَىٰ","balā","Yes","\"হ্যাঁ"],["قَدْ","qad","indeed","অবশ্যই"],["جَآءَنَا","jāanā","came to us","এসেছিল আমাদের (কাছে)"],["نَذِيرٌۭ","nadhīrun","a warner","সতর্ককারী"],["فَكَذَّبْنَا","fakadhabnā","but we denied","তবে আমরা মিথ্যারোপ করেছিলাম"],["وَقُلْنَا","waqul'nā","and we said","এবং আমরা বলে ছিলাম"],["مَا","mā","Not","\"নাই"],["نَزَّلَ","nazzala","has sent down","নাযিল করেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ্‌"],["مِن","min","any","কোন"],["شَىْءٍ","shayin","thing","কিছু"],["إِنْ","in","Not","নও"],["أَنتُمْ","antum","you (are)","তোমরা"],["إِلَّا","illā","but","এছাড়া"],["فِى","fī","in","মধ্যে"],["ضَلَـٰلٍۢ","ḍalālin","error","গুমরাহীর"],["كَبِيرٍۢ","kabīrin","great","বড়\""]],"t":"قَالُو<s>ا۟</> بَلَىٰ قَ<q>دْ</> <o>جَآ</>ءَنَا نَذِي<k>رٌۭ فَ</>كَذَّ<q>بْ</>نَا وَقُلْنَا مَا نَزَّلَ <h>ٱ</>للَّهُ مِ<k>ن شَ</>ىْءٍ إِنْ أَ<k>نتُ</>مْ إِلَّا فِى ضَ<m>لَٰ</><k>لٍۢ كَ</><p>بِي</>رٍۢ"},{"n":10,"w":[["وَقَالُوا۟","waqālū","And they will say","এবং তারা বলবে"],["لَوْ","law","If","\"'যদি"],["كُنَّا","kunnā","we had","আমরা"],["نَسْمَعُ","nasma‘u","listened","শুনতাম"],["أَوْ","aw","or","অথবা"],["نَعْقِلُ","na‘qilu","reasoned","আমরা বিবেচনা করতাম"],["مَا","mā","not","না"],["كُنَّا","kunnā","we (would) have been","আমরা হতাম"],["فِىٓ","fī","among","মধ্যে"],["أَصْحَـٰبِ","aṣḥābi","(the) companions","অধিবাসীদের"],["ٱلسَّعِيرِ","l-sa‘īri","(of) the Blaze","প্রজ্বলিত আগুনের\""]],"t":"وَقَالُو<s>ا۟</> لَوْ كُ<g>نَّ</>ا نَسْمَعُ أَوْ نَعْقِلُ مَا كُ<g>نَّ</>ا <o>فِىٓ</> أَصْ<m>حَٰ</>بِ <h>ٱ</><l>ل</>سَّ<p>عِي</>رِ"},{"n":11,"w":[["فَٱعْتَرَفُوا۟","fa-i‘'tarafū","Then they (will) confess","এভাবে তারা স্বীকার করবে"],["بِذَنۢبِهِمْ","bidhanbihim","their sins","তাদের অপরাধকে"],["فَسُحْقًۭا","fasuḥ'qan","so away with","অভিশাপ অতএব"],["لِّأَصْحَـٰبِ","li-aṣḥābi","(the) companions","অধিবাসীদের জন্য"],["ٱلسَّعِيرِ","l-sa‘īri","(of) the Blaze","প্রজ্বলিত আগুনের"]],"t":"فَ<h>ٱ</>عْتَرَفُو<s>ا۟</> بِذَ<i>نۢبِ</>هِمْ فَسُحْ<w>قًۭا لِّ</>أَصْ<m>حَٰ</>بِ <h>ٱ</><l>ل</>سَّ<p>عِي</>رِ"},{"n":12,"w":[["إِنَّ","inna","Indeed","নিশ্চয়"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["يَخْشَوْنَ","yakhshawna","fear","ভয় করে"],["رَبَّهُم","rabbahum","their Lord","তাদের রবকে"],["بِٱلْغَيْبِ","bil-ghaybi","unseen","অদেখা অবস্থায়"],["لَهُم","lahum","for them","তাদের জন্য"],["مَّغْفِرَةٌۭ","maghfiratun","(is) forgiveness","ক্ষমা"],["وَأَجْرٌۭ","wa-ajrun","and a reward","এবং প্রতিদান"],["كَبِيرٌۭ","kabīrun","great","বড়"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ يَخْشَوْنَ رَبَّ<f>هُم بِ</><h>ٱ</>لْغَيْبِ لَ<y>هُم مَّ</>غْفِرَ<d>ةٌۭ وَ</>أَ<q>جْ</><k>رٌۭ كَ</><p>بِي</>رٌۭ"},{"n":13,"w":[["وَأَسِرُّوا۟","wa-asirrū","And conceal","এবং তোমরা গোপন কর"],["قَوْلَكُمْ","qawlakum","your speech","তোমাদের কথা"],["أَوِ","awi","or","অথবা"],["ٱجْهَرُوا۟","ij'harū","proclaim","প্রকাশ কর"],["بِهِۦٓ ۖ","bihi","it","তাকে"],["إِنَّهُۥ","innahu","Indeed, He","তিনি নিশ্চয়ই"],["عَلِيمٌۢ","‘alīmun","(is the) All-Knower","খুব জ্ঞাত"],["بِذَاتِ","bidhāti","of what (is in)","অবস্থা সম্পর্কে"],["ٱلصُّدُورِ","l-ṣudūri","the breasts","অন্তরগুলোর"]],"t":"وَأَسِرُّو<s>ا۟</> قَوْلَكُمْ أَوِ <h>ٱ</><q>جْ</>هَرُو<s>ا۟</> بِ<o>هِۦٓ ۖ</> إِ<g>نَّ</>هُ<m>ۥ</> عَلِي<i>مٌۢ بِ</>ذَاتِ <h>ٱ</><l>ل</>صُّ<p>دُو</>رِ"},{"n":14,"w":[["أَلَا","alā","Does not","না কি"],["يَعْلَمُ","ya‘lamu","know","তিনি জানেন"],["مَنْ","man","(the One) Who","যিনি"],["خَلَقَ","khalaqa","created","সৃষ্টি করেছেন"],["وَهُوَ","wahuwa","And He","অথচ তিনি"],["ٱللَّطِيفُ","l-laṭīfu","(is) the Subtle","সূক্ষ্মদর্শী"],["ٱلْخَبِيرُ","l-khabīru","the All-Aware","খুব অবগত"]],"t":"أَلَا يَعْلَمُ مَنْ خَلَقَ وَهُوَ <h>ٱ</><l>ل</>لَّطِيفُ <h>ٱ</>لْخَ<p>بِي</>رُ"},{"n":15,"w":[["هُوَ","huwa","He","তিনিই"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["جَعَلَ","ja‘ala","made","বানিয়েছেন"],["لَكُمُ","lakumu","for you","তোমাদের জন্য"],["ٱلْأَرْضَ","l-arḍa","the earth","ভূতলকে"],["ذَلُولًۭا","dhalūlan","subservient","অধীন"],["فَٱمْشُوا۟","fa-im'shū","so walk","তোমরা অতঃপর চল"],["فِى","fī","in","উপর"],["مَنَاكِبِهَا","manākibihā","(the) paths thereof","তার বক্ষের"],["وَكُلُوا۟","wakulū","and eat","এবং তোমরা খাও"],["مِن","min","of","হতে"],["رِّزْقِهِۦ ۖ","riz'qihi","His provision","তার রিযক"],["وَإِلَيْهِ","wa-ilayhi","and to Him","এবং তাঁরই দিকে"],["ٱلنُّشُورُ","l-nushūru","(is) the Resurrection","পুনরুত্থান"]],"t":"هُوَ <h>ٱ</>لَّذِى جَعَلَ لَكُمُ <h>ٱ</>لْأَرْضَ ذَلُولًۭ<k>ا فَ</><h>ٱ</>مْشُو<s>ا۟</> فِى مَنَاكِبِهَا وَكُلُو<s>ا۟</> <w>مِن رِّ</>زْقِ<m>هِۦ</> ۖ وَإِلَيْهِ <h>ٱ</><l>ل</><g>نُّ</><p>شُو</>رُ"},{"n":16,"w":[["ءَأَمِنتُم","a-amintum","Do you feel secure","তোমরা নিরাপদ কি হয়েছ"],["مَّن","man","(from Him) Who","(তাঁর থেকে) যিনি"],["فِى","fī","(is) in","আছেন"],["ٱلسَّمَآءِ","l-samāi","the heaven","আসমানে"],["أَن","an","not","যে"],["يَخْسِفَ","yakhsifa","He will cause to swallow","ধসিয়ে দেবেন"],["بِكُمُ","bikumu","you","তোমাদের সহ"],["ٱلْأَرْضَ","l-arḍa","the earth","মাটিকে"],["فَإِذَا","fa-idhā","when","অতঃপর"],["هِىَ","hiya","it","তা"],["تَمُورُ","tamūru","sways","কাঁপবে"]],"t":"ءَأَمِ<k>نتُ</><y>م مَّ</><k>ن فِ</>ى <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ <d>أَن يَ</>خْسِفَ بِكُمُ <h>ٱ</>لْأَرْضَ فَإِذَا هِىَ تَ<p>مُو</>رُ"},{"n":17,"w":[["أَمْ","am","Or","অথবা"],["أَمِنتُم","amintum","do you feel secure","তোমরা নির্ভয় হয়েছ"],["مَّن","man","(from Him) Who","(তাঁর থেকে) যিনি"],["فِى","fī","(is) in","আছেন"],["ٱلسَّمَآءِ","l-samāi","the heaven","আসমানে"],["أَن","an","that","যে"],["يُرْسِلَ","yur'sila","He will send","পাঠাবেন"],["عَلَيْكُمْ","‘alaykum","against you","তোমাদের উপর"],["حَاصِبًۭا ۖ","ḥāṣiban","a storm of stones","কঙ্করবর্ষী ঝঞ্ঝা"],["فَسَتَعْلَمُونَ","fasata‘lamūna","Then you would know","তোমরা জানবে তখন"],["كَيْفَ","kayfa","how","কেমন"],["نَذِيرِ","nadhīri","(was) My warning","আমার সতর্কীকরণ"]],"t":"أَمْ أَمِ<k>نتُ</><y>م مَّ</><k>ن فِ</>ى <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ <d>أَن يُ</>رْسِلَ عَلَيْكُمْ حَاصِ<k>بًۭا ۖ فَ</>سَتَعْلَمُونَ كَيْفَ نَ<p>ذِي</>رِ"},{"n":18,"w":[["وَلَقَدْ","walaqad","And indeed","এবং করে ছিল নিশ্চয়"],["كَذَّبَ","kadhaba","denied","মিথ্যারোপ"],["ٱلَّذِينَ","alladhīna","those","যারা"],["مِن","min","from","(ছিল)"],["قَبْلِهِمْ","qablihim","before them","তাদের পূর্বে"],["فَكَيْفَ","fakayfa","and how","কেমন ফলে"],["كَانَ","kāna","was","ছিল"],["نَكِيرِ","nakīri","My rejection","আমার পাক্‌ড়াও"]],"t":"وَلَقَ<q>دْ</> كَذَّبَ <h>ٱ</>لَّذِينَ مِ<k>ن قَ</><q>بْ</>لِهِمْ فَكَيْفَ كَانَ نَ<p>كِي</>رِ"},{"n":19,"w":[["أَوَلَمْ","awalam","Do not","কি নাই"],["يَرَوْا۟","yaraw","they see","তারা দেখে"],["إِلَى","ilā","[to]","প্রতি"],["ٱلطَّيْرِ","l-ṭayri","the birds","পাখিগুলির"],["فَوْقَهُمْ","fawqahum","above them","তাদের উপরে"],["صَـٰٓفَّـٰتٍۢ","ṣāffātin","spreading (their wings)","পাখা বিস্তার করে"],["وَيَقْبِضْنَ ۚ","wayaqbiḍ'na","and folding","ও গুটিয়ে নেয়"],["مَا","mā","Not","না"],["يُمْسِكُهُنَّ","yum'sikuhunna","holds them","তাদের ধরে ধরে (অন্য কেউ)"],["إِلَّا","illā","except","ছাড়া"],["ٱلرَّحْمَـٰنُ ۚ","l-raḥmānu","the Most Gracious","দয়াবান"],["إِنَّهُۥ","innahu","Indeed, He","তিনি নিশ্চয়"],["بِكُلِّ","bikulli","(is) of every","সব উপর"],["شَىْءٍۭ","shayin","thing","কিছুর"],["بَصِيرٌ","baṣīrun","All-Seer","দৃষ্টিবান"]],"t":"أَوَلَمْ يَرَوْ<s>ا۟</> إِلَى <h>ٱ</><l>ل</>طَّيْرِ فَوْقَهُمْ <n>صَٰٓ</><m>فَّٰ</><d>تٍۢ وَ</>يَ<q>قْ</>بِضْنَ ۚ مَا يُمْسِكُهُ<g>نَّ</> إِلَّا <h>ٱ</><l>ل</>رَّحْ<m>مَٰ</>نُ ۚ إِ<g>نَّ</>هُ<m>ۥ</> بِكُلِّ شَىْ<i>ءٍۭ بَ</><p>صِي</>رٌ"},{"n":20,"w":[["أَمَّنْ","amman","Who is","অথবা কোন"],["هَـٰذَا","hādhā","this","এমন"],["ٱلَّذِى","alladhī","the one","যা"],["هُوَ","huwa","he","সেই"],["جُندٌۭ","jundun","(is) an army","সৈন্যবাহিনী"],["لَّكُمْ","lakum","for you","তোমাদের জন্য আছে"],["يَنصُرُكُم","yanṣurukum","to help you","তোমাদের সাহায্য করবে"],["مِّن","min","from","থেকে"],["دُونِ","dūni","besides","ছাড়া"],["ٱلرَّحْمَـٰنِ ۚ","l-raḥmāni","the Most Gracious","রহমান"],["إِنِ","ini","Not","নয়"],["ٱلْكَـٰفِرُونَ","l-kāfirūna","(are) the disbelievers","আমান্যকারীরা"],["إِلَّا","illā","but","এ ছাড়া"],["فِى","fī","in","মধ্যে"],["غُرُورٍ","ghurūrin","delusion","ধোঁকার"]],"t":"أَ<g>مَّ</>نْ <m>هَٰ</>ذَا <h>ٱ</>لَّذِى هُوَ جُن<w>دٌۭ لَّ</>كُمْ يَ<k>نصُ</>رُ<y>كُم مِّ</><k>ن دُ</>ونِ <h>ٱ</><l>ل</>رَّحْ<m>مَٰ</>نِ ۚ إِنِ <h>ٱ</>لْ<m>كَٰ</>فِرُونَ إِلَّا فِى غُ<p>رُو</>رٍ"},{"n":21,"w":[["أَمَّنْ","amman","Who is","কে অথবা আছে"],["هَـٰذَا","hādhā","this","এমন"],["ٱلَّذِى","alladhī","the one","যে"],["يَرْزُقُكُمْ","yarzuqukum","to provide you","তোমাদের রিযক দেবে"],["إِنْ","in","if","যদি"],["أَمْسَكَ","amsaka","He withheld","তিনি বন্ধ করেন"],["رِزْقَهُۥ ۚ","riz'qahu","His provision","তার রিযক"],["بَل","bal","Nay","বরং"],["لَّجُّوا۟","lajjū","they persist","তারা অবিচল"],["فِى","fī","in","মধ্যে"],["عُتُوٍّۢ","‘utuwwin","pride","খোদাদ্রোহিতার"],["وَنُفُورٍ","wanufūrin","and aversion","এবং সত্য পরিহারে"]],"t":"أَ<g>مَّ</>نْ <m>هَٰ</>ذَا <h>ٱ</>لَّذِى يَرْزُقُكُمْ إِنْ أَمْسَكَ رِزْقَهُ<m>ۥ</> ۚ بَل لَّجُّو<s>ا۟</> فِى عُتُ<d>وٍّۢ وَ</>نُ<p>فُو</>رٍ"},{"n":22,"w":[["أَفَمَن","afaman","Then is he who","যে অতএব কি"],["يَمْشِى","yamshī","walks","চলে"],["مُكِبًّا","mukibban","fallen","অধঃগতি"],["عَلَىٰ","‘alā","on","উপর"],["وَجْهِهِۦٓ","wajhihi","his face","তার মুখের"],["أَهْدَىٰٓ","ahdā","better guided","অধিক সত্য পথপ্রাপ্ত"],["أَمَّن","amman","or (he) who","যে অথবা"],["يَمْشِى","yamshī","walks","চলে"],["سَوِيًّا","sawiyyan","upright","সোজাসুজি"],["عَلَىٰ","‘alā","on","উপর"],["صِرَٰطٍۢ","ṣirāṭin","(the) Path","পথের"],["مُّسْتَقِيمٍۢ","mus'taqīmin","Straight","সরল"]],"t":"أَفَ<d>مَن يَ</>مْشِى مُكِبًّا عَلَىٰ وَ<q>جْ</>هِ<o>هِۦٓ</> أَهْدَ<o>ىٰٓ</> أَ<g>مَّ</><d>ن يَ</>مْشِى سَوِيًّا عَلَىٰ صِ<m>رَٰ</><d>طٍۢ مُّ</>سْتَ<p>قِي</>مٍۢ"},{"n":23,"w":[["قُلْ","qul","Say","বল"],["هُوَ","huwa","He","\"তিনিই"],["ٱلَّذِىٓ","alladhī","(is) the One Who","যিনি"],["أَنشَأَكُمْ","ansha-akum","produced you","তোমাদের সৃষ্টি করেছেন"],["وَجَعَلَ","waja‘ala","and made","এবং দিয়েছেন"],["لَكُمُ","lakumu","for you","তোমাদের জন্য"],["ٱلسَّمْعَ","l-sam‘a","the hearing","শ্রবণশক্তি"],["وَٱلْأَبْصَـٰرَ","wal-abṣāra","and the vision","ও দৃষ্টিশক্তি"],["وَٱلْأَفْـِٔدَةَ ۖ","wal-afidata","and the feelings","এবং অন্তঃকরণ"],["قَلِيلًۭا","qalīlan","Little","কমই"],["مَّا","mā","(is) what","যা"],["تَشْكُرُونَ","tashkurūna","you give thanks","তোমরা শোকর কর\""]],"t":"قُلْ هُوَ <h>ٱ</>لَّ<o>ذِىٓ</> أَ<k>نشَ</>أَكُمْ وَجَعَلَ لَكُمُ <h>ٱ</><l>ل</>سَّمْعَ وَ<h>ٱ</>لْأَ<q>بْ</><m>صَٰ</>رَ وَ<h>ٱ</>لْأَفْـِٔدَةَ ۖ قَلِيلًۭ<d>ا مَّ</>ا تَشْكُ<p>رُو</>نَ"},{"n":24,"w":[["قُلْ","qul","Say","বল"],["هُوَ","huwa","He","\"তিনিই"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["ذَرَأَكُمْ","dhara-akum","multiplied you","তোমাদের ছড়িয়ে দিয়েছেন"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["وَإِلَيْهِ","wa-ilayhi","and to Him","এবং তাঁরই দিকে"],["تُحْشَرُونَ","tuḥ'sharūna","you will be gathered","তোমাদের একত্রিত করা হবে\""]],"t":"قُلْ هُوَ <h>ٱ</>لَّذِى ذَرَأَكُمْ فِى <h>ٱ</>لْأَرْضِ وَإِلَيْهِ تُحْشَ<p>رُو</>نَ"},{"n":25,"w":[["وَيَقُولُونَ","wayaqūlūna","And they say","এবং তারা বলে"],["مَتَىٰ","matā","When","\"কখন"],["هَـٰذَا","hādhā","(is) this","এই"],["ٱلْوَعْدُ","l-wa‘du","promise","প্রতিশ্রুতি"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you are","তোমরা হও"],["صَـٰدِقِينَ","ṣādiqīna","truthful","সত্যবাদী\""]],"t":"وَيَقُولُونَ مَتَىٰ <m>هَٰ</>ذَا <h>ٱ</>لْوَعْدُ إِ<k>ن كُنتُ</>مْ <m>صَٰ</>دِ<p>قِي</>نَ"},{"n":26,"w":[["قُلْ","qul","Say","তুমি বল"],["إِنَّمَا","innamā","Only","\"শুধুমাত্র"],["ٱلْعِلْمُ","l-‘il'mu","the knowledge","(তার) জ্ঞান"],["عِندَ","‘inda","(is) with","কাছে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["وَإِنَّمَآ","wa-innamā","and only","এবং শুধুমাত্র"],["أَنَا۠","anā","I am","আমি"],["نَذِيرٌۭ","nadhīrun","a warner","সাবধানকারী"],["مُّبِينٌۭ","mubīnun","clear","স্পষ্ট\""]],"t":"قُلْ إِ<g>نَّ</>مَا <h>ٱ</>لْعِلْمُ عِ<k>ندَ</> <h>ٱ</>للَّهِ وَإِ<g>نَّ</><o>مَآ</> أَنَا۠ نَذِي<d>رٌۭ مُّ</><p>بِي</>نٌۭ"},{"n":27,"w":[["فَلَمَّا","falammā","But when","যখন পরে"],["رَأَوْهُ","ra-awhu","they (will) see it","তা দেখবে"],["زُلْفَةًۭ","zul'fatan","approaching","নিকটে"],["سِيٓـَٔتْ","sīat","(will be) distressed","মলিন হবে"],["وُجُوهُ","wujūhu","(the) faces","মুখগুলো"],["ٱلَّذِينَ","alladhīna","(of) those who","যারা (তাদের)"],["كَفَرُوا۟","kafarū","disbelieved","অস্বীকার করেছে"],["وَقِيلَ","waqīla","and it will be said","এবং বলা হবে"],["هَـٰذَا","hādhā","This","\"এই"],["ٱلَّذِى","alladhī","(is) that which","যা (সেই)"],["كُنتُم","kuntum","you used to","তোমরা ছিলে"],["بِهِۦ","bihi","for it","তা সম্পর্কে"],["تَدَّعُونَ","tadda‘ūna","call","দাবি করতে\""]],"t":"فَلَ<g>مَّ</>ا رَأَوْهُ زُلْفَ<k>ةًۭ سِ</><o>يٓـَٔ</>تْ وُجُوهُ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> وَقِيلَ <m>هَٰ</>ذَا <h>ٱ</>لَّذِى كُ<k>نتُ</><f>م بِ</><m>هِۦ</> تَدَّ<p>عُو</>نَ"},{"n":28,"w":[["قُلْ","qul","Say","বল"],["أَرَءَيْتُمْ","ara-aytum","Have you seen","\"তোমরা চিন্তা কি করেছ"],["إِنْ","in","if","যদি"],["أَهْلَكَنِىَ","ahlakaniya","destroys me","আমাকে ধ্বংস করেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["وَمَن","waman","and whoever","এবং যারা"],["مَّعِىَ","ma‘iya","(is) with me","আমার সাথে"],["أَوْ","aw","or","অথবা"],["رَحِمَنَا","raḥimanā","has mercy upon us","আমাদের প্রতি দয়া করেন"],["فَمَن","faman","then who","কে কিন্তু"],["يُجِيرُ","yujīru","(can) protect","আশ্রয় দেবে"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","the disbelievers","অস্বীকার কারীদের"],["مِنْ","min","from","থেকে"],["عَذَابٍ","‘adhābin","a punishment","আযাব"],["أَلِيمٍۢ","alīmin","painful","অত্যন্ত পীড়াদায়ক\""]],"t":"قُلْ أَرَءَيْتُمْ إِنْ أَهْلَكَنِىَ <h>ٱ</>للَّهُ وَ<d>مَن مَّ</>عِىَ أَوْ رَحِمَنَا فَ<d>مَن يُ</>جِيرُ <h>ٱ</>لْ<m>كَٰ</>فِرِينَ مِنْ عَذَابٍ أَ<p>لِي</>مٍۢ"},{"n":29,"w":[["قُلْ","qul","Say","বল"],["هُوَ","huwa","He","\"তিনিই"],["ٱلرَّحْمَـٰنُ","l-raḥmānu","(is) the Most Gracious","পরম করুণাময়"],["ءَامَنَّا","āmannā","we believe","আমরা ঈমান এনেছি"],["بِهِۦ","bihi","in Him","তার উপর"],["وَعَلَيْهِ","wa‘alayhi","and upon Him","এবং তার উপর"],["تَوَكَّلْنَا ۖ","tawakkalnā","we put (our) trust","আমরা নির্ভর করেছি"],["فَسَتَعْلَمُونَ","fasata‘lamūna","So you will know","অতএব শীঘ্রই তোমরা জানতে পারবে"],["مَنْ","man","who","কে"],["هُوَ","huwa","(is) it","সে"],["فِى","fī","(that is) in","মধ্যে"],["ضَلَـٰلٍۢ","ḍalālin","error","গুমরাহীর"],["مُّبِينٍۢ","mubīnin","clear","সুস্পষ্ট\""]],"t":"قُلْ هُوَ <h>ٱ</><l>ل</>رَّحْ<m>مَٰ</>نُ ءَامَ<g>نَّ</>ا بِ<m>هِۦ</> وَعَلَيْهِ تَوَكَّلْنَا ۖ فَسَتَعْلَمُونَ مَنْ هُوَ فِى ضَ<m>لَٰ</><d>لٍۢ مُّ</><p>بِي</>نٍۢ"},{"n":30,"w":[["قُلْ","qul","Say","বলো"],["أَرَءَيْتُمْ","ara-aytum","Have you seen","\"তোমরা ভেবে কি দেখেছ"],["إِنْ","in","if","যদি"],["أَصْبَحَ","aṣbaḥa","becomes","হয়ে যায়"],["مَآؤُكُمْ","māukum","your water","তোমাদের পানি"],["غَوْرًۭا","ghawran","sunken","ভূগর্ভস্থ"],["فَمَن","faman","then who","কে তবে"],["يَأْتِيكُم","yatīkum","could bring you","তোমাদের কাছে আনবে"],["بِمَآءٍۢ","bimāin","water","পানি"],["مَّعِينٍۭ","ma‘īnin","flowing","প্রবহমান\""]],"t":"قُلْ أَرَءَيْتُمْ إِنْ أَصْبَحَ <o>مَآ</>ؤُكُمْ غَوْ<k>رًۭا فَ</><d>مَن يَ</>أْتِي<f>كُم بِ</><o>مَآ</><d>ءٍۢ مَّ</><p>عِي</>نٍۭ"}]}