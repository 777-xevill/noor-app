,{"n":31,"w":[["إِن","in","If","যদি"],["تَجْتَنِبُوا۟","tajtanibū","you avoid","তোমরা বেঁচে চল"],["كَبَآئِرَ","kabāira","great (sins)","বড় বড় গুনাহ (থেকে)"],["مَا","mā","(of) what","যা"],["تُنْهَوْنَ","tun'hawna","you are forbidden","তোমাদের নিষেধ করা হয়"],["عَنْهُ","‘anhu","from [it]","তা থেকে"],["نُكَفِّرْ","nukaffir","We will remove","মোচন করব আমরা"],["عَنكُمْ","‘ankum","from you","তোমাদের থেকে"],["سَيِّـَٔاتِكُمْ","sayyiātikum","your evil deeds","তোমাদের ছোট পাপগুলো"],["وَنُدْخِلْكُم","wanud'khil'kum","and We will admit you","ও তোমাদের আমরা প্রবেশ করাব"],["مُّدْخَلًۭا","mud'khalan","(to) an entrance","প্রবেশ পথে"],["كَرِيمًۭا","karīman","noble","সন্মানজনক"]],"t":"إِ<k>ن تَ</><q>جْ</>تَنِبُو<s>ا۟</> كَ<o>بَآ</>ئِرَ مَا تُنْهَوْنَ عَنْهُ نُكَفِّرْ عَ<k>نكُ</>مْ سَيِّـَٔاتِكُمْ وَنُ<q>دْ</>خِلْ<y>كُم مُّ</><q>دْ</>خَلًۭ<k>ا كَ</>رِيمًۭا"},{"n":32,"w":[["وَلَا","walā","And (do) not","এবং না"],["تَتَمَنَّوْا۟","tatamannaw","covet","তোমরা লোভ করো"],["مَا","mā","what","যা"],["فَضَّلَ","faḍḍala","(has) bestowed","শ্রেষ্টত্ব দিয়েছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["بِهِۦ","bihi","[with it]","তার"],["بَعْضَكُمْ","ba‘ḍakum","some of you","তোমাদের কাউকে"],["عَلَىٰ","‘alā","over","উপর"],["بَعْضٍۢ ۚ","ba‘ḍin","others","কারও"],["لِّلرِّجَالِ","lilrrijāli","For men","পুরুষদের জন্য"],["نَصِيبٌۭ","naṣībun","(is) a share","অংশ (রয়েছে)"],["مِّمَّا","mimmā","of what","তা হতে যা"],["ٱكْتَسَبُوا۟ ۖ","ik'tasabū","they earned","তারা অর্জন করেছে"],["وَلِلنِّسَآءِ","walilnnisāi","and for women","এবং মহিলাদের জন্য (রয়েছে)"],["نَصِيبٌۭ","naṣībun","(is) a share","অংশ"],["مِّمَّا","mimmā","of what","তা হতে যা"],["ٱكْتَسَبْنَ ۚ","ik'tasabna","they earned","তারা অর্জন করে"],["وَسْـَٔلُوا۟","wasalū","And ask","এবং চাও তোমরা"],["ٱللَّهَ","l-laha","Allah","আল্লাহর (কাছে)"],["مِن","min","of","হতে"],["فَضْلِهِۦٓ ۗ","faḍlihi","His bounty","তাঁর অনুগ্রহ"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["كَانَ","kāna","is","হলেন"],["بِكُلِّ","bikulli","of e