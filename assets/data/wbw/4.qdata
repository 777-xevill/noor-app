ndeed","নিশ্চয়"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["يَكْفُرُونَ","yakfurūna","disbelieve","অমান্য করে"],["بِٱللَّهِ","bil-lahi","in Allah","আল্লাহকে"],["وَرُسُلِهِۦ","warusulihi","and His Messengers","ও তাঁর রাসূলকে"],["وَيُرِيدُونَ","wayurīdūna","and they wish","ও তারা চায়"],["أَن","an","that","যে"],["يُفَرِّقُوا۟","yufarriqū","they differentiate","তারা পার্থক্য করবে"],["بَيْنَ","bayna","between","মাঝে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর (প্রতি ঈমানে)"],["وَرُسُلِهِۦ","warusulihi","and His Messengers","এবং তাঁর রাসূলদের (প্রতি ঈমানে)"],["وَيَقُولُونَ","wayaqūlūna","and they say","ও তারা বলে"],["نُؤْمِنُ","nu'minu","We believe","''ঈমান আনব আমরা"],["بِبَعْضٍۢ","biba‘ḍin","in some","কাউকে"],["وَنَكْفُرُ","wanakfuru","and we disbelieve","ও অস্বীকার করব আমরা"],["بِبَعْضٍۢ","biba‘ḍin","in others","কাউকে''"],["وَيُرِيدُونَ","wayurīdūna","And they wish","ও তারা চায়"],["أَن","an","that","যে"],["يَتَّخِذُوا۟","yattakhidhū","they take","তারা গ্রহণ করবে"],["بَيْنَ","bayna","between","মধ্যবর্তী"],["ذَٰلِكَ","dhālika","that","এর"],["سَبِيلًا","sabīlan","a way","পথ"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ يَكْفُرُونَ بِ<h>ٱ</>للَّهِ وَرُسُلِ<m>هِۦ</> وَيُرِيدُونَ <d>أَن يُ</>فَرِّقُو<s>ا۟</> بَيْنَ <h>ٱ</>للَّهِ وَرُسُلِ<m>هِۦ</> وَيَقُولُونَ نُؤْمِنُ بِبَعْ<d>ضٍۢ وَ</>نَكْفُرُ بِبَعْ<d>ضٍۢ وَ</>يُرِيدُونَ <d>أَن يَ</>تَّخِذُو<s>ا۟</> بَيْنَ <m>ذَٰ</>لِكَ سَبِيلًا"},{"n":151,"w":[["أُو۟لَـٰٓئِكَ","ulāika","Those ","ঐসব লোক"],["هُمُ","humu","they","তারাই"],["ٱلْكَـٰفِرُونَ","l-kāfirūna","(are) the disbelievers","কাফির"],["حَقًّۭا ۚ","ḥaqqan","truly","যথার্থ"],["وَأَعْتَدْنَا","wa-a‘tadnā","And We have prepared","এবং আমরা প্রস্তুত করে রেখেছি"],["لِلْكَـٰفِرِينَ","lil'kāfirīna","for the disbelievers","কাফিরদের জন্য"],["عَذَابًۭا","‘adhāban","a punishment","শাস্তি"],["مُّهِينًۭا","muhīnan","humiliating","লাঞ্ছনাদায়ক"]],"t":"أُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</>لْ<m>كَٰ</>فِرُونَ حَ<d>قًّۭا ۚ وَ</>أَعْتَ<q>دْ</>نَا لِلْ<m>كَٰ</>فِرِينَ عَذَا<d>بًۭا مُّ</>هِينًۭا"},{"n":152,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["بِٱللَّهِ","bil-lahi","in Allah","আল্লাহর উপর"],["وَرُسُلِهِۦ","warusulihi","and His Messengers","ও তাঁর রাসূলদের উপর"],["وَلَمْ","walam","and not","ও করেনি"],["يُفَرِّقُوا۟","yufarriqū","they differentiate","তারা পার্থক্য"],["بَيْنَ","bayna","between","মাঝে"],["أَحَدٍۢ","aḥadin","(any) one","কারও"],["مِّنْهُمْ","min'hum","of them","তাদের মধ্য হতে"],["أُو۟لَـٰٓئِكَ","ulāika","those ","ঐসব লোকদের"],["سَوْفَ","sawfa","soon","শীঘ্রই"],["يُؤْتِيهِمْ","yu'tīhim","He will give them","তাদের দিবেন তিনি"],["أُجُورَهُمْ ۗ","ujūrahum","their reward","তাদের পুরস্কারগুলো"],["وَكَانَ","wakāna","And is","এবং হলেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["غَفُورًۭا","ghafūran","Oft-Forgiving","ক্ষমাশীল"],["رَّحِيمًۭا","raḥīman","Most Merciful","মেহেরবান"]],"t":"وَ<h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> بِ<h>ٱ</>للَّهِ وَرُسُلِ<m>هِۦ</> وَلَمْ يُفَرِّقُو<s>ا۟</> بَيْنَ أَحَ<d>دٍۢ مِّ</>نْهُمْ أُ<s>و۟</><o>لَٰٓ</>ئِكَ سَوْفَ يُؤْتِيهِمْ أُجُورَهُمْ ۗ وَكَانَ <h>ٱ</>للَّهُ غَفُو<w>رًۭا رَّ</>حِيمًۭا"},{"n":153,"w":[["يَسْـَٔلُكَ","yasaluka","Ask you","তোমার কাছে দাবি করে"],["أَهْلُ","ahlu","(the) People","আহলি"],["ٱلْكِتَـٰبِ","l-kitābi","(of) the Book","কিতাবরা"],["أَن","an","that","যে"],["تُنَزِّلَ","tunazzila","you bring down","নাযিল করাবে তুমি"],["عَلَيْهِمْ","‘alayhim","to them","তাদের উপর"],["كِتَـٰبًۭا","kitāban","a book","কিতাব (লিখিত দলীল)"],["مِّنَ","mina","from","হতে"],["ٱلسَّمَآءِ ۚ","l-samāi","the heaven","আসমান"],["فَقَدْ","faqad","Then indeed","বস্তুত (এটা নতুন কিছু নয়)"],["سَأَلُوا۟","sa-alū","they (had) asked","তারা দাবি করেছিল"],["مُوسَىٰٓ","mūsā","Musa","মূসার (কাছে)"],["أَكْبَرَ","akbara","greater","অনেক বড়"],["مِن","min","than","চেয়েও"],["ذَٰلِكَ","dhālika","that","এর"],["فَقَالُوٓا۟","faqālū","for they said","অতঃপর তারা বলেছিল"],["أَرِنَا","arinā","Show us","''আমাদের দেখাও"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["جَهْرَةًۭ","jahratan","manifestly","প্রকাশ্যে''"],["فَأَخَذَتْهُمُ","fa-akhadhathumu","so struck them","অতঃপর তাদের ধরে ছিল"],["ٱلصَّـٰعِقَةُ","l-ṣā‘iqatu","the thunderbolt","বজ্রপাতে"],["بِظُلْمِهِمْ ۚ","biẓul'mihim","for their wrongdoing","তাদের জুলুমের কারণে"],["ثُمَّ","thumma","Then","এরপর"],["ٱتَّخَذُوا۟","ittakhadhū","they took","তারা গ্রহণ করেছিল"],["ٱلْعِجْلَ","l-‘ij'la","the calf (for worship)","বাছুরকে (উপাস্যরূপে)"],["مِنۢ","min","from","(থেকে)"],["بَعْدِ","ba‘di","after","এরপরেও"],["مَا","mā","[what]","যা"],["جَآءَتْهُمُ","jāathumu","came to them","তাদের কাছে এসেছিল"],["ٱلْبَيِّنَـٰتُ","l-bayinātu","the clear proofs","সুস্পষ্ট প্রমাণগুলো"],["فَعَفَوْنَا","fa‘afawnā","then We forgave them","আমরা তবুও মাফ করেছিলাম"],["عَن","‘an","for","হতে"],["ذَٰلِكَ ۚ","dhālika","that","এটা"],["وَءَاتَيْنَا","waātaynā","And We gave","এবং আমরা দিয়েছিলাম"],["مُوسَىٰ","mūsā","Musa","মূসাকে"],["سُلْطَـٰنًۭا","sul'ṭānan","an authority","প্রমাণ"],["مُّبِينًۭا","mubīnan","clear","সুস্পষ্ট"]],"t":"يَسْـَٔلُكَ أَهْلُ <h>ٱ</>لْكِ<m>تَٰ</>بِ أَ<k>ن تُ</>نَزِّلَ عَلَيْهِمْ كِ<m>تَٰ</><d>بًۭا مِّ</>نَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ ۚ فَقَ<q>دْ</> سَأَلُو<s>ا۟</> مُوسَ<o>ىٰٓ</> أَكْبَرَ مِ<k>ن ذَٰ</>لِكَ فَقَا<o>لُوٓ</><s>ا۟</> أَرِنَا <h>ٱ</>للَّهَ جَهْرَ<k>ةًۭ فَ</>أَخَذَتْهُمُ <h>ٱ</><l>ل</><m>صَّٰ</>عِقَةُ بِظُلْمِهِمْ ۚ ثُ<g>مَّ</> <h>ٱ</>تَّخَذُو<s>ا۟</> <h>ٱ</>لْعِ<q>جْ</>لَ <i>مِنۢ بَ</>عْدِ مَا <o>جَآ</>ءَتْهُمُ <h>ٱ</>لْبَيِّ<m>نَٰ</>تُ فَعَفَوْنَا عَ<k>ن ذَٰ</>لِكَ ۚ وَءَاتَيْنَا مُوسَىٰ سُلْ<m>طَٰ</><d>نًۭا مُّ</>بِينًۭا"},{"n":154,"w":[["وَرَفَعْنَا","warafa‘nā","And We raised","ও আমরা উঠিয়ে ছিলাম"],["فَوْقَهُمُ","fawqahumu","over them","তাদের উপর"],["ٱلطُّورَ","l-ṭūra","the mount","তুর পাহাড়"],["بِمِيثَـٰقِهِمْ","bimīthāqihim","for their covenant","তাদের অঙ্গীকারের জন্য"],["وَقُلْنَا","waqul'nā","and We said","ও আমরা বলেছিলাম"],["لَهُمُ","lahumu","to them","তাদেরকে"],["ٱدْخُلُوا۟","ud'khulū","Enter","''প্রবেশ কর"],["ٱلْبَابَ","l-bāba","the gate","দরজায়"],["سُجَّدًۭا","sujjadan","prostrating","নতশিরে''"],["وَقُلْنَا","waqul'nā","And We said","ও আমরা বলেছিলাম"],["لَهُمْ","lahum","to them","তাদেরকে"],["لَا","lā","(Do) not","''না"],["تَعْدُوا۟","ta‘dū","transgress","সীমালঙ্ঘন করো"],["فِى","fī","in","(বিধিনিষেধ) সম্পর্কে"],["ٱلسَّبْتِ","l-sabti","the Sabbath","শনিবারের''"],["وَأَخَذْنَا","wa-akhadhnā","And We took","ও আমরা নিয়েছিলাম"],["مِنْهُم","min'hum","from them","তাদের থেকে"],["مِّيثَـٰقًا","mīthāqan","a covenant","অঙ্গীকার"],["غَلِيظًۭا","ghalīẓan","solemn","সুদৃঢ়"]],"t":"وَرَفَعْنَا فَوْقَهُمُ <h>ٱ</><l>ل</>طُّورَ بِمِي<m>ثَٰ</>قِهِمْ وَقُلْنَا لَهُمُ <h>ٱ</><q>دْ</>خُلُو<s>ا۟</> <h>ٱ</>لْبَابَ سُجَّ<d>دًۭا وَ</>قُلْنَا لَهُمْ لَا تَعْدُو<s>ا۟</> فِى <h>ٱ</><l>ل</>سَّ<q>بْ</>تِ وَأَخَذْنَا مِنْ<y>هُم مِّ</>ي<m>ثَٰ</>قًا غَلِيظًۭا"},{"n":155,"w":[["فَبِمَا","fabimā","Then because of","অতঃপর কারণে"],["نَقْضِهِم","naqḍihim","their breaking","তাদের ভঙ্গের"],["مِّيثَـٰقَهُمْ","mīthāqahum","(of) their covenant","তাদের অঙ্গীকার"],["وَكُفْرِهِم","wakuf'rihim","and their disbelief","ও তাদের অস্বীকার করার"],["بِـَٔايَـٰتِ","biāyāti","in (the) Signs","আয়াতগুলোকে"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَقَتْلِهِمُ","waqatlihimu","and their killing","ও তাদের হত্যা করার"],["ٱلْأَنۢبِيَآءَ","l-anbiyāa","(of) the Prophets","নবীদেরকে"],["بِغَيْرِ","bighayri","without","(অন্যভাবে)"],["حَقٍّۢ","ḥaqqin","any right","অন্যায়ভাবে"],["وَقَوْلِهِمْ","waqawlihim","and their saying","ও তাদের এ উক্তির (কারণে যে)"],["قُلُوبُنَا","qulūbunā","Our hearts","''আমাদের অন্তরগুলো"],["غُلْفٌۢ ۚ","ghul'fun","(are) wrapped","আচ্ছাদিত (তারা অভিশপ্ত হয়)''"],["بَلْ","bal","Nay","বরং"],["طَبَعَ","ṭaba‘a","(has) set a seal","মোহর মেরে দিয়েছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["عَلَيْهَا","‘alayhā","on their (hearts)","তার উপর"],["بِكُفْرِهِمْ","bikuf'rihim","for their disbelief","তাদের কুফরীর কারণে"],["فَلَا","falā","so not","তাই না"],["يُؤْمِنُونَ","yu'minūna","they believe","তারা ঈমান আনবে"],["إِلَّا","illā","except","তবে"],["قَلِيلًۭا","qalīlan","a few","অল্পসংখ্যক"]],"t":"فَبِمَا نَ<q>قْ</>ضِ<y>هِم مِّ</>ي<m>ثَٰ</>قَهُمْ وَكُفْرِ<f>هِم بِـَٔ</>ا<m>يَٰ</>تِ <h>ٱ</>للَّهِ وَقَتْلِهِمُ <h>ٱ</>لْأَ<i>نۢبِ</><o>يَآ</>ءَ بِغَيْرِ حَ<d>قٍّۢ وَ</>قَوْلِهِمْ قُلُوبُنَا غُلْ<i>فٌۢ ۚ بَ</>لْ طَبَعَ <h>ٱ</>للَّهُ عَلَيْهَا بِكُفْرِهِمْ فَلَا يُؤْمِنُونَ إِلَّا قَلِيلًۭا"},{"n":156,"w":[["وَبِكُفْرِهِمْ","wabikuf'rihim","And for their disbelief","এবং তাদের কুফরীর কারণে"],["وَقَوْلِهِمْ","waqawlihim","and their saying","এবং তাদের উক্তির (কারণেও)"],["عَلَىٰ","‘alā","against","উপর"],["مَرْيَمَ","maryama","Maryam","মারইয়ামের"],["بُهْتَـٰنًا","buh'tānan","a slander","(যা ছিল) অপবাদ"],["عَظِيمًۭا","‘aẓīman","great","গুরুতর"]],"t":"وَبِكُفْرِهِمْ وَقَوْلِهِمْ عَلَىٰ مَرْيَمَ بُهْ<m>تَٰ</>نًا عَظِيمًۭا"},{"n":157,"w":[["وَقَوْلِهِمْ","waqawlihim","And for their saying","এবং তাদের উক্তি (এও যে)"],["إِنَّا","innā","Indeed, we","''আমরা নিশ্চয়"],["قَتَلْنَا","qatalnā","killed","আমরা হত্যা করেছি"],["ٱلْمَسِيحَ","l-masīḥa","the Messiah","মসীহকে"],["عِيسَى","‘īsā","Isa","(অর্থাৎ) ঈসাকে"],["ٱبْنَ","ib'na","son","তনয়"],["مَرْيَمَ","maryama","(of) Maryam","মারইয়ামের"],["رَسُولَ","rasūla","(the) Messenger","(যিনি) রাসূল"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর''"],["وَمَا","wamā","And not","এবং না"],["قَتَلُوهُ","qatalūhu","they killed him","তাকে তারা হত্যা করেছে"],["وَمَا","wamā","and not","এবং না"],["صَلَبُوهُ","ṣalabūhu","they crucified him","তাকে তারা শুলে চড়িয়েছে"],["وَلَـٰكِن","walākin","but","কিন্তু"],["شُبِّهَ","shubbiha","it was made to appear (so)","বিভ্রম হয়েছিল"],["لَهُمْ ۚ","lahum","to them","তাদের জন্য"],["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ٱخْتَلَفُوا۟","ikh'talafū","differ","মতভেদ করেছিল"],["فِيهِ","fīhi","in it","সে বিষয়ে"],["لَفِى","lafī","(are) surely in","অবশ্যই মধ্যে আছে"],["شَكٍّۢ","shakkin","doubt","সন্দেহের"],["مِّنْهُ ۚ","min'hu","about it","তা থেকে"],["مَا","mā","Not","না"],["لَهُم","lahum","for them","তাদের আছে"],["بِهِۦ","bihi","about it","এ সম্পর্কে"],["مِنْ","min","[of]","কোন"],["عِلْمٍ","‘il'min","(any) knowledge","জ্ঞান"],["إِلَّا","illā","except","এছাড়া যে"],["ٱتِّبَاعَ","ittibā‘a","(the) following","অনুসরণ করে"],["ٱلظَّنِّ ۚ","l-ẓani","(of) assumption","অনুমানের"],["وَمَا","wamā","And not","এবং না"],["قَتَلُوهُ","qatalūhu","they killed him","তাকে তারা হত্যা করেছে"],["يَقِينًۢا","yaqīnan","certainly","নিঃসন্দেহে"]],"t":"وَقَوْلِهِمْ إِ<g>نَّ</>ا قَتَلْنَا <h>ٱ</>لْمَسِيحَ عِيسَى <h>ٱ</><q>بْ</>نَ مَرْيَمَ رَسُولَ <h>ٱ</>للَّهِ وَمَا قَتَلُوهُ وَمَا صَلَبُوهُ وَ<m>لَٰ</>كِ<k>ن شُ</>بِّهَ لَهُمْ ۚ وَإِ<g>نَّ</> <h>ٱ</>لَّذِينَ <h>ٱ</>خْتَلَفُو<s>ا۟</> فِيهِ لَفِى شَ<d>كٍّۢ مِّ</>نْهُ ۚ مَا لَ<f>هُم بِ</><m>هِۦ</> مِنْ عِلْمٍ إِلَّا <h>ٱ</>تِّبَاعَ <h>ٱ</><l>ل</>ظَّ<g>نِّ</> ۚ وَمَا قَتَلُوهُ يَقِينًۢا"},{"n":158,"w":[["بَل","bal","Nay","বরং"],["رَّفَعَهُ","rafa‘ahu","he was raised","তাকে উঠিয়ে নেন"],["ٱللَّهُ","l-lahu","(by) Allah","আল্লাহ"],["إِلَيْهِ ۚ","ilayhi","towards Him","তাঁর দিকে"],["وَكَانَ","wakāna","And is","এবং হলেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["عَزِيزًا","‘azīzan","All-Mighty","পরাক্রমশালী"],["حَكِيمًۭا","ḥakīman","All-Wise","প্রজ্ঞাময়"]],"t":"بَ<r>ل</> رَّفَعَهُ <h>ٱ</>للَّهُ إِلَيْهِ ۚ وَكَانَ <h>ٱ</>للَّهُ عَزِيزًا حَكِيمًۭا"},{"n":159,"w":[["وَإِن","wa-in","And (there is) not","এবং না (আছে এমন কেউ)"],["مِّنْ","min","from","মধ্য হতে"],["أَهْلِ","ahli","(the) People","আহলি"],["ٱلْكِتَـٰبِ","l-kitābi","(of) the Book","কিতাবদের"],["إِلَّا","illā","but","এছাড়া"],["لَيُؤْمِنَنَّ","layu'minanna","surely he believes","ঈমান আনবে অবশ্য"],["بِهِۦ","bihi","in him","তার উপর"],["قَبْلَ","qabla","before","পূর্বে"],["مَوْتِهِۦ ۖ","mawtihi","his death","তার মৃত্যুর"],["وَيَوْمَ","wayawma","And (on the) Day","এবং দিনে"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) the Resurrection","কিয়ামাতের"],["يَكُونُ","yakūnu","he will be","সে হবে"],["عَلَيْهِمْ","‘alayhim","against them","তাদের বিরুদ্ধে"],["شَهِيدًۭا","shahīdan","a witness","সাক্ষী"]],"t":"وَ<d>إِن مِّ</>نْ أَهْلِ <h>ٱ</>لْكِ<m>تَٰ</>بِ إِلَّا لَيُؤْمِنَ<g>نَّ</> بِ<m>هِۦ</> قَ<q>بْ</>لَ مَوْتِ<m>هِۦ</> ۖ وَيَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ يَكُونُ عَلَيْهِمْ شَهِيدًۭا"},{"n":160,"w":[["فَبِظُلْمٍۢ","fabiẓul'min","Then for (the) wrongdoing","তাই জুলুমের কারণে"],["مِّنَ","mina","of","(তাদের) মধ্য হতে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["هَادُوا۟","hādū","were Jews","ইহুদী রয়েছে"],["حَرَّمْنَا","ḥarramnā","We made unlawful","আমরা নিষিদ্ধ করেছিলাম"],["عَلَيْهِمْ","‘alayhim","for them","তাদের উপর"],["طَيِّبَـٰتٍ","ṭayyibātin","good things","পবিত্র বস্তুগুলোকে (যা)"],["أُحِلَّتْ","uḥillat","which had been lawful","বৈধ করা হয়েছিল (পূর্বে)"],["لَهُمْ","lahum","for them","তাদের জন্য"],["وَبِصَدِّهِمْ","wabiṣaddihim","and for their hindering","এবং তাদের বাধাদানের কারণেও"],["عَن","‘an","from","থেকে"],["سَبِيلِ","sabīli","(the) way","পথ"],["ٱللَّهِ","l-lahi","(of) Allah ","আল্লাহর"],["كَثِيرًۭا","kathīran","many","অনেককে"]],"t":"فَبِظُلْ<d>مٍۢ مِّ</>نَ <h>ٱ</>لَّذِينَ هَادُو<s>ا۟</> حَرَّمْنَا عَلَيْهِمْ طَيِّ<m>بَٰ</>تٍ أُحِلَّتْ لَهُمْ وَبِصَدِّهِمْ عَ<k>ن سَ</>بِيلِ <h>ٱ</>للَّهِ كَثِيرًۭا"},{"n":161,"w":[["وَأَخْذِهِمُ","wa-akhdhihimu","And for their taking","এবং তাদের গ্রহণেরও (কারণে)"],["ٱلرِّبَوٰا۟","l-riba","(of) [the] usury","সুদ"],["وَقَدْ","waqad","while certainly","ও নিশ্চয়"],["نُهُوا۟","nuhū","they were forbidden","তাদেরকে মানা করা হয়েছিল"],["عَنْهُ","‘anhu","from it","তা থেকে"],["وَأَكْلِهِمْ","wa-aklihim","and (for) their consuming","ও তাদের খাওয়ার (জন্য)"],["أَمْوَٰلَ","amwāla","wealth","মালসমূহ"],["ٱلنَّاسِ","l-nāsi","(of) the people","মানুষের"],["بِٱلْبَـٰطِلِ ۚ","bil-bāṭili","wrongfully","অন্যায়ভাবে (এ কঠোরতা দিয়েছিলাম)"],["وَأَعْتَدْنَا","wa-a‘tadnā","And We have prepared","ও আমরা প্রস্তুত করে রেখেছি"],["لِلْكَـٰفِرِينَ","lil'kāfirīna","for the disbelievers","কাফিরদের জন্য"],["مِنْهُمْ","min'hum","among them","তাদের মধ্যকার"],["عَذَابًا","‘adhāban","a punishment","শাস্তি"],["أَلِيمًۭا","alīman","painful","মর্মন্তুদ"]],"t":"وَأَخْذِهِمُ <h>ٱ</><l>ل</>رِّبَ<s>وٰ</>ا۟ وَقَ<q>دْ</> نُهُو<s>ا۟</> عَنْهُ وَأَكْلِهِمْ أَمْ<m>وَٰ</>لَ <h>ٱ</><l>ل</><g>نَّ</>اسِ بِ<h>ٱ</>لْ<m>بَٰ</>طِلِ ۚ وَأَعْتَ<q>دْ</>نَا لِلْ<m>كَٰ</>فِرِينَ مِنْهُمْ عَذَابًا أَلِيمًۭا"},{"n":162,"w":[["لَّـٰكِنِ","lākini","But","কিন্তু"],["ٱلرَّٰسِخُونَ","l-rāsikhūna","the ones who are firm","সুগভীর ব্যক্তিরা"],["فِى","fī","in","(মধ্যে)"],["ٱلْعِلْمِ","l-‘il'mi","the knowledge","জ্ঞানে"],["مِنْهُمْ","min'hum","among them","তাদের মধ্যকার"],["وَٱلْمُؤْمِنُونَ","wal-mu'minūna","and the believers","ও মু'মিনরা"],["يُؤْمِنُونَ","yu'minūna","believe","ঈমান আনে"],["بِمَآ","bimā","in what","(ঐবিষয়ে) যা"],["أُنزِلَ","unzila","(is) revealed","নাযিল করা হয়েছে"],["إِلَيْكَ","ilayka","to you","তোমার প্রতি"],["وَمَآ","wamā","and what","এবং যা"],["أُنزِلَ","unzila","was revealed","নাযিল করা হয়েছে"],["مِن","min","from","(থেকে)"],["قَبْلِكَ ۚ","qablika","before you","তোমার পূর্বে"],["وَٱلْمُقِيمِينَ","wal-muqīmīna","And the ones who establish","এবং (তারা) প্রতিষ্ঠাকারীরা"],["ٱلصَّلَوٰةَ ۚ","l-ṣalata","the prayer","সলাত"],["وَٱلْمُؤْتُونَ","wal-mu'tūna","and the ones who give","ও (তারা) আদায়কারী"],["ٱلزَّكَوٰةَ","l-zakata","the zakah","জাকাত"],["وَٱلْمُؤْمِنُونَ","wal-mu'minūna","and the ones who believe","ও (তারা) ঈমানদার"],["بِٱللَّهِ","bil-lahi","in Allah","আল্লাহর উপর"],["وَٱلْيَوْمِ","wal-yawmi","and the Day","ও দিনের (উপর)"],["ٱلْـَٔاخِرِ","l-ākhiri","the Last ","আখিরাতের"],["أُو۟لَـٰٓئِكَ","ulāika","those","ঐসব লোকদেরকে"],["سَنُؤْتِيهِمْ","sanu'tīhim","We will give them","তাদের দিব আমরা"],["أَجْرًا","ajran","a reward","প্রতিফল"],["عَظِيمًا","‘aẓīman","great","বিরাট"]],"t":"<m>لَّٰ</>كِنِ <h>ٱ</><l>ل</><m>رَّٰ</>سِخُونَ فِى <h>ٱ</>لْعِلْمِ مِنْهُمْ وَ<h>ٱ</>لْمُؤْمِنُونَ يُؤْمِنُونَ بِ<o>مَآ</> أُ<k>نزِ</>لَ إِلَيْكَ وَ<o>مَآ</> أُ<k>نزِ</>لَ مِ<k>ن قَ</><q>بْ</>لِكَ ۚ وَ<h>ٱ</>لْمُقِيمِينَ <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةَ ۚ وَ<h>ٱ</>لْمُؤْتُونَ <h>ٱ</><l>ل</>زَّكَ<s>وٰ</>ةَ وَ<h>ٱ</>لْمُؤْمِنُونَ بِ<h>ٱ</>للَّهِ وَ<h>ٱ</>لْيَوْمِ <h>ٱ</>لْءَاخِرِ أُ<s>و۟</><o>لَٰٓ</>ئِكَ سَنُؤْتِيهِمْ أَ<q>جْ</>رًا عَظِيمًا"},{"n":163,"w":[["۞ إِنَّآ","innā","Indeed, We","(হে নবী) আমরা নিশ্চয়"],["أَوْحَيْنَآ","awḥaynā","have revealed","আমরা ওহী পাঠিয়েছি"],["إِلَيْكَ","ilayka","to you","তোমার প্রতি"],["كَمَآ","kamā","as","যেমন"],["أَوْحَيْنَآ","awḥaynā","We revealed","আমরা ওহী পাঠিয়েছি"],["إِلَىٰ","ilā","to","প্রতি"],["نُوحٍۢ","nūḥin","Nuh","নূহের"],["وَٱلنَّبِيِّـۧنَ","wal-nabiyīna","and the Prophets","ও নবীদের"],["مِنۢ","min","from","পরে"],["بَعْدِهِۦ ۚ","ba‘dihi","after him","তার"],["وَأَوْحَيْنَآ","wa-awḥaynā","and We revealed","ও আমরা ওহী পাঠিয়েছি"],["إِلَىٰٓ","ilā","to","প্রতি"],["إِبْرَٰهِيمَ","ib'rāhīma","Ibrahim","ইবরাহীমের"],["وَإِسْمَـٰعِيلَ","wa-is'mā‘īla","and Ishmael","ও ইসমাঈলের"],["وَإِسْحَـٰقَ","wa-is'ḥāqa","and Isaac","ও ইসহাকের"],["وَيَعْقُوبَ","waya‘qūba","and Yaqub","ও ইয়াকুবের"],["وَٱلْأَسْبَاطِ","wal-asbāṭi","and the tribes","ও (তার) বংশধরদের (প্রতি)"],["وَعِيسَىٰ","wa‘īsā","and Isa","ও ঈসার"],["وَأَيُّوبَ","wa-ayyūba","and Ayyub","ও আইয়ুবের"],["وَيُونُسَ","wayūnusa","and Yunus","ও ইউনুসের"],["وَهَـٰرُونَ","wahārūna","and Harun","ও হারুনের"],["وَسُلَيْمَـٰنَ ۚ","wasulaymāna","and Sulaiman","ও সুলাইমানের (প্রতি)"],["وَءَاتَيْنَا","waātaynā","and We gave","এবং আমরা দিয়েছি"],["دَاوُۥدَ","dāwūda","(to) Dawood","দাঊদকে"],["زَبُورًۭا","zabūran","the Zaboor","যাবুর"]],"t":"۞ إِ<g>نَّ</><o>آ</> أَوْحَيْ<o>نَآ</> إِلَيْكَ كَ<o>مَآ</> أَوْحَيْ<o>نَآ</> إِلَىٰ نُو<d>حٍۢ وَ</><h>ٱ</><l>ل</><g>نَّ</>بِيِّۦنَ <i>مِنۢ بَ</>عْدِ<m>هِۦ</> ۚ وَأَوْحَيْ<o>نَآ</> إِلَ<o>ىٰٓ</> إِ<q>بْ</><m>رَٰ</>هِيمَ وَإِسْ<m>مَٰ</>عِيلَ وَإِسْ<m>حَٰ</>قَ وَيَعْقُوبَ وَ<h>ٱ</>لْأَسْبَاطِ وَعِيسَىٰ وَأَيُّوبَ وَيُونُسَ وَ<m>هَٰ</>رُونَ وَسُلَيْ<m>مَٰ</>نَ ۚ وَءَاتَيْنَا دَاوُ<m>ۥ</>دَ زَبُورًۭا"},{"n":164,"w":[["وَرُسُلًۭا","warusulan","And Messengers","এবং (এসব) রাসূলদেরকে"],["قَدْ","qad","surely","নিশ্চয়ই"],["قَصَصْنَـٰهُمْ","qaṣaṣnāhum","We (have) mentioned them","তাদের আমরা বর্ণনা করেছি"],["عَلَيْكَ","‘alayka","to you","তোমার নিকট"],["مِن","min","from","(থেকে)"],["قَبْلُ","qablu","before","ইতিপূর্বে"],["وَرُسُلًۭا","warusulan","and Messengers","এবং (এমন সব) রাসূলও (ছিলেন)"],["لَّمْ","lam","not","না"],["نَقْصُصْهُمْ","naqṣuṣ'hum","We (have) mentioned them","তাদের আমরা বর্ণনা করেছি"],["عَلَيْكَ ۚ","‘alayka","to you","তোমার কাছে"],["وَكَلَّمَ","wakallama","And spoke","এবং কথা বলেছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["مُوسَىٰ","mūsā","(to) Musa","মূসার (সাথে)"],["تَكْلِيمًۭا","taklīman","(in a) conversation","(সরাসরি) কথাবার্তা"]],"t":"وَرُسُلًۭ<k>ا قَ</><q>دْ</> قَصَصْ<m>نَٰ</>هُمْ عَلَيْكَ مِ<k>ن قَ</><q>بْ</>لُ وَرُسُلًۭ<w>ا لَّ</>مْ نَ<q>قْ</>صُصْهُمْ عَلَيْكَ ۚ وَكَلَّمَ <h>ٱ</>للَّهُ مُوسَىٰ تَكْلِيمًۭا"},{"n":165,"w":[["رُّسُلًۭا","rusulan","Messengers","(এসব) রাসূল"],["مُّبَشِّرِينَ","mubashirīna","bearers of glad tidings","সুসংবাদদাতা"],["وَمُنذِرِينَ","wamundhirīna","and warners","ও সতর্ককারী (ছিলেন)"],["لِئَلَّا","li-allā","so that not","না যেন"],["يَكُونَ","yakūna","there is","থাকে"],["لِلنَّاسِ","lilnnāsi","for mankind","লোকদের জন্য"],["عَلَى","‘alā","against","বিরুদ্ধে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["حُجَّةٌۢ","ḥujjatun","any argument","কোন যুক্তি"],["بَعْدَ","ba‘da","after","পরে"],["ٱلرُّسُلِ ۚ","l-rusuli","the Messengers","রাসূলদের (আগমনের)"],["وَكَانَ","wakāna","And is","এবং হলেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["عَزِيزًا","‘azīzan","All-Mighty","পরাক্রমশালী"],["حَكِيمًۭا","ḥakīman","All-Wise","প্রজ্ঞাময়"]],"t":"رُّسُلًۭ<d>ا مُّ</>بَشِّرِينَ وَمُ<k>نذِ</>رِينَ لِئَلَّا يَكُونَ لِل<g>نَّ</>اسِ عَلَى <h>ٱ</>للَّهِ حُجَّ<i>ةٌۢ بَ</>عْدَ <h>ٱ</><l>ل</>رُّسُلِ ۚ وَكَانَ <h>ٱ</>للَّهُ عَزِيزًا حَكِيمًۭا"},{"n":166,"w":[["لَّـٰكِنِ","lākini","But","কিন্তু"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["يَشْهَدُ","yashhadu","bears witness","সাক্ষ্য দিচ্ছেন"],["بِمَآ","bimā","to what","(ঐ বিষয়ে) যা"],["أَنزَلَ","anzala","He (has) revealed","নাযিল করেছেন"],["إِلَيْكَ ۖ","ilayka","to you","তোমার প্রতি"],["أَنزَلَهُۥ","anzalahu","He has sent it down","তা তিনি নাযিল করেছেন"],["بِعِلْمِهِۦ ۖ","bi‘il'mihi","with His Knowledge","তাঁর জ্ঞানের ভিত্তিতে"],["وَٱلْمَلَـٰٓئِكَةُ