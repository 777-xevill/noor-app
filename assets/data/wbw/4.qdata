,"those whom ","যারা"],["تَوَفَّىٰهُمُ","tawaffāhumu","take them (in death)","তাদের জান কবজ করে"],["ٱلْمَلَـٰٓئِكَةُ","l-malāikatu","the Angels","ফেরেশতারা"],["ظَالِمِىٓ","ẓālimī","(while) they (were) wronging","জুলুমকারী"],["أَنفُسِهِمْ","anfusihim","themselves","তাদের নিজেদের উপর"],["قَالُوا۟","qālū","they say","(ফেরেশতারা) বলে"],["فِيمَ","fīma","In what (condition)","''কেমন তার মধ্যে"],["كُنتُمْ ۖ","kuntum","were you","তোমরা ছিলে''"],["قَالُوا۟","qālū","They said","তারা বলে"],["كُنَّا","kunnā","We were","''আমরা ছিলাম"],["مُسْتَضْعَفِينَ","mus'taḍ‘afīna","oppressed","দুর্বল"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ ۚ","l-arḍi","the earth","দুনিয়ার"],["قَالُوٓا۟","qālū","They said","তারা বলে"],["أَلَمْ","alam","Not","''কি না"],["تَكُنْ","takun","was","ছিল"],["أَرْضُ","arḍu","(the) earth","জমিন"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَٰسِعَةًۭ","wāsi‘atan","spacious (enough)","প্রশস্ত"],["فَتُهَاجِرُوا۟","fatuhājirū","so that you (could) emigrate","তোমরা অতঃপর হিজরত করতে"],["فِيهَا ۚ","fīhā","in it","তার মধ্যে''"],["فَأُو۟لَـٰٓئِكَ","fa-ulāika","Then those","ঐসব লোক অতএব"],["مَأْوَىٰهُمْ","mawāhum","(will have) their abode","তাদের বাসস্থল (হবে)"],["جَهَنَّمُ ۖ","jahannamu","(in) Hell ","জাহান্নাম"],["وَسَآءَتْ","wasāat","and it is an evil","এবং অতি খারাপ"],["مَصِيرًا","maṣīran","destination","গন্তব্যস্থান"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ تَوَفَّ<m>ىٰ</>هُمُ <h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةُ ظَالِ<o>مِىٓ</> أَ<k>نفُ</>سِهِمْ قَالُو<s>ا۟</> فِيمَ كُ<k>نتُ</>مْ ۖ قَالُو<s>ا۟</> كُ<g>نَّ</>ا مُسْتَضْعَفِينَ فِى <h>ٱ</>لْأَرْضِ ۚ قَا<o>لُوٓ</><s>ا۟</> أَلَمْ تَكُنْ أَرْضُ <h>ٱ</>للَّهِ <m>وَٰ</>سِعَ<k>ةًۭ فَ</>تُهَاجِرُو<s>ا۟</> فِيهَا ۚ فَأُ<s>و۟</><o>لَٰٓ</>ئِكَ مَأْوَ<m>ىٰ</>هُمْ جَهَ<g>نَّ</>مُ ۖ وَ<o>سَآ</>ءَتْ مَصِيرًا"},{"n":98,"w":[["إِلَّا","illā","Except","তবে"],["ٱلْمُسْتَضْعَفِينَ","l-mus'taḍ‘afīna","the oppressed","(যারা ছিল) দুর্বল অসহায়"],["مِنَ","mina","among","মধ্য হতে"],["ٱلرِّجَالِ","l-rijāli","the men","পুরুষদের"],["وَٱلنِّسَآءِ","wal-nisāi","and the women","ও নারীদের"],["وَٱلْوِلْدَٰنِ","wal-wil'dāni","and the children","ও শিশুদের (তাদের অবস্থা ভিন্ন)"],["لَا","lā","(who) not","না"],["يَسْتَطِيعُونَ","yastaṭī‘ūna","are able to","(যারা) সক্ষম হয়"],["حِيلَةًۭ","ḥīlatan","plan","উপায় অবলম্বন"],["وَلَا","walā","and not","ও না"],["يَهْتَدُونَ","yahtadūna","they are directed","তারা চিনে"],["سَبِيلًۭا","sabīlan","(to) a way","পথ"]],"t":"إِلَّا <h>ٱ</>لْمُسْتَضْعَفِينَ مِنَ <h>ٱ</><l>ل</>رِّجَالِ وَ<h>ٱ</><l>ل</><g>نِّ</><o>سَآ</>ءِ وَ<h>ٱ</>لْوِلْ<m>دَٰ</>نِ لَا يَسْتَطِيعُونَ حِيلَ<d>ةًۭ وَ</>لَا يَهْتَدُونَ سَبِيلًۭا"},{"n":99,"w":[["فَأُو۟لَـٰٓئِكَ","fa-ulāika","Then those","সুতরাং ঐসব লোক"],["عَسَى","‘asā","may be","হয়ত"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["أَن","an","will","(যে)"],["يَعْفُوَ","ya‘fuwa","pardon","মাফ করবেন"],["عَنْهُمْ ۚ","‘anhum","[on] them","তাদেরকে"],["وَكَانَ","wakāna","and is","এবং হলেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["عَفُوًّا","‘afuwwan","Oft-Pardoning","মার্জনাকারী"],["غَفُورًۭا","ghafūran","Oft-Forgiving","ক্ষমাশীল"]],"t":"فَأُ<s>و۟</><o>لَٰٓ</>ئِكَ عَسَى <h>ٱ</>للَّهُ <d>أَن يَ</>عْفُوَ عَنْهُمْ ۚ وَكَانَ <h>ٱ</>للَّهُ عَفُوًّا غَفُورًۭا"},{"n":100,"w":[["۞ وَمَن","waman","And whoever","এবং যে"],["يُهَاجِرْ","yuhājir","emigrates","হিজরত করবে"],["فِى","fī","in","(মধ্যে)"],["سَبِيلِ","sabīli","(the) way","পথে"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["يَجِدْ","yajid","will find","সে পাবে"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["مُرَٰغَمًۭا","murāghaman","place(s) of refuge ","আশ্রয়স্থল"],["كَثِيرًۭا","kathīran","many","অনেক"],["وَسَعَةًۭ ۚ","wasa‘atan","and abundance","ও প্রাচুর্য"],["وَمَن","waman","And whoever","এবং যে"],["يَخْرُجْ","yakhruj","leaves","বের হবে"],["مِنۢ","min","from","থেকে"],["بَيْتِهِۦ","baytihi","his home","তার ঘর"],["مُهَاجِرًا","muhājiran","(as) an emigrant","মুহাজির হয়ে"],["إِلَى","ilā","to","দিকে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["وَرَسُولِهِۦ","warasūlihi","and His Messenger","ও তাঁর রাসূলের (দিকে)"],["ثُمَّ","thumma","then","এরপর"],["يُدْرِكْهُ","yud'rik'hu","overtakes him","তাকে পাবে"],["ٱلْمَوْتُ","l-mawtu","[the] death","মৃত্যু"],["فَقَدْ","faqad","then certainly","নিশ্চয় তবে"],["وَقَعَ","waqa‘a","(became) incumbent","(দায়িত্ব ভার) পড়ল"],["أَجْرُهُۥ","ajruhu","his reward","তার পুরস্কারের"],["عَلَى","‘alā","on","উপর"],["ٱللَّهِ ۗ","l-lahi","Allah","আল্লাহর"],["وَكَانَ","wakāna","And is","এবং হলেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["غَفُورًۭا","ghafūran","Oft-Forgiving","ক্ষমাশীল"],["رَّحِيمًۭا","raḥīman","Most Merciful","মেহেরবান"]],"t":"۞ وَ<d>مَن يُ</>هَاجِرْ فِى سَبِيلِ <h>ٱ</>للَّهِ يَجِ<q>دْ</> فِى <h>ٱ</>لْأَرْضِ مُ<m>رَٰ</>غَ<k>مًۭا كَ</>ثِي<d>رًۭا وَ</>سَعَ<d>ةًۭ ۚ وَمَن يَ</>خْرُ<q>جْ</> <i>مِنۢ بَ</>يْتِ<m>هِۦ</> مُهَاجِرًا إِلَى <h>ٱ</>للَّهِ وَرَسُولِ<m>هِۦ</> ثُ<g>مَّ</> يُ<q>دْ</>رِكْهُ <h>ٱ</>لْمَوْتُ فَقَ<q>دْ</> وَقَعَ أَ<q>جْ</>رُهُ<m>ۥ</> عَلَى <h>ٱ</>للَّهِ ۗ وَكَانَ <h>ٱ</>للَّهُ غَفُو<w>رًۭا رَّ</>حِيمًۭا"},{"n":101,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["ضَرَبْتُمْ","ḍarabtum","you travel","তোমরা সফর কর"],["فِى","fī","in","(মধ্যে)"],["ٱلْأَرْضِ","l-arḍi","the earth","জমিনে"],["فَلَيْسَ","falaysa","then not","নাই তখন"],["عَلَيْكُمْ","‘alaykum","upon you","তোমাদের উপর"],["جُنَاحٌ","junāḥun","(is) any blame","কোন গুনাহ"],["أَن","an","that","যে"],["تَقْصُرُوا۟","taqṣurū","you shorten","তোমরা কসর করবে"],["مِنَ","mina","[of]","থেকে"],["ٱلصَّلَوٰةِ","l-ṣalati","the prayer","সলাতে"],["إِنْ","in","if","যদি"],["خِفْتُمْ","khif'tum","you fear","তোমরা ভয় কর"],["أَن","an","that","যে"],["يَفْتِنَكُمُ","yaftinakumu","(may) harm you","তোমাদের বিপদে ফেলবে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوٓا۟ ۚ","kafarū","disbelieved","কুফরী করেছে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","the disbelievers","কাফিররা"],["كَانُوا۟","kānū","are","হলো"],["لَكُمْ","lakum","for you","তোমাদের জন্য"],["عَدُوًّۭا","‘aduwwan","an enemy","শত্রু"],["مُّبِينًۭا","mubīnan","open","প্রকাশ্য"]],"t":"وَإِذَا ضَرَ<q>بْ</>تُمْ فِى <h>ٱ</>لْأَرْضِ فَلَيْسَ عَلَيْكُمْ جُنَاحٌ أَ<k>ن تَ</><q>قْ</>صُرُو<s>ا۟</> مِنَ <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةِ إِنْ خِفْتُمْ <d>أَن يَ</>فْتِنَكُمُ <h>ٱ</>لَّذِينَ كَفَ<o>رُوٓ</><s>ا۟</> ۚ إِ<g>نَّ</> <h>ٱ</>لْ<m>كَٰ</>فِرِينَ كَانُو<s>ا۟</> لَكُمْ عَدُ<d>وًّۭا مُّ</>بِينًۭا"},{"n":102,"w":[["وَإِذَا","wa-idhā","And when","এবং (হে নবী) যখন"],["كُنتَ","kunta","you are","তুমি হও"],["فِيهِمْ","fīhim","among them","তাদের মধ্যে"],["فَأَقَمْتَ","fa-aqamta","and you lead","তুমি অতঃপর কায়েম করবে"],["لَهُمُ","lahumu","for them","তাদের জন্য"],["ٱلصَّلَوٰةَ","l-ṣalata","the prayer","সলাত"],["فَلْتَقُمْ","faltaqum","then let stand","দাঁড়ায় যেন তখন"],["طَآئِفَةٌۭ","ṭāifatun","a group","একদল"],["مِّنْهُم","min'hum","of them","তাদের মধ্য হতে"],["مَّعَكَ","ma‘aka","with you","তোমার সাথে"],["وَلْيَأْخُذُوٓا۟","walyakhudhū","and let them take","এবং তারা যেন রাখে"],["أَسْلِحَتَهُمْ","asliḥatahum","their arms","তাদের অস্ত্র (তাদের কাছে)"],["فَإِذَا","fa-idhā","Then when","অতঃপর যখন"],["سَجَدُوا۟","sajadū","they have prostrated","তারা সিজদা করে ফেলে"],["فَلْيَكُونُوا۟","falyakūnū","then let them be","তারা তখন হবে"],["مِن","min","from","(থেকে)"],["وَرَآئِكُمْ","warāikum","behind you","তোমাদের পিছনে"],["وَلْتَأْتِ","waltati","and let come (forward)","এবং আসে যেন"],["طَآئِفَةٌ","ṭāifatun","a group ","দল"],["أُخْرَىٰ","ukh'rā","other","অন্য (যারা)"],["لَمْ","lam","(which has) not","নাই"],["يُصَلُّوا۟","yuṣallū","prayed","সলাত পড়ে"],["فَلْيُصَلُّوا۟","falyuṣallū","and let them pray","তারা পড়ে যেন তখন"],["مَعَكَ","ma‘aka","with you","তোমার সাথে"],["وَلْيَأْخُذُوا۟","walyakhudhū","and let them take","ও তারাও রাখে যেন"],["حِذْرَهُمْ","ḥidh'rahum","their precautions","সতর্কতা তাদের"],["وَأَسْلِحَتَهُمْ ۗ","wa-asliḥatahum","and their arms","ও তাদের অস্ত্রশস্ত্র (তাদের কাছে)"],["وَدَّ","wadda","Wished","কামনা করে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieved","কুফরী করেছে"],["لَوْ","law","if","যদি"],["تَغْفُلُونَ","taghfulūna","you neglect","গাফিল হও তোমরা"],["عَنْ","‘an","[about]","হতে"],["أَسْلِحَتِكُمْ","asliḥatikum","your arms","তোমাদের অস্ত্রশস্ত্র"],["وَأَمْتِعَتِكُمْ","wa-amti‘atikum","and your baggage","ও সাজসরঞ্জাম (হতে)"],["فَيَمِيلُونَ","fayamīlūna","so (that) they (can) assault","তারা তবে আক্রমণ করবে"],["عَلَيْكُم","‘alaykum","[upon] you","তোমাদের উপর"],["مَّيْلَةًۭ","maylatan","(in) an attack","আক্রমণ"],["وَٰحِدَةًۭ ۚ","wāḥidatan","single","একবারই"],["وَلَا","walā","But (there is) no","এবং না (হবে)"],["جُنَاحَ","junāḥa","blame","গুনাহ"],["عَلَيْكُمْ","‘alaykum","upon you","তোমাদের উপর"],["إِن","in","if","যদি"],["كَانَ","kāna","was","হয়"],["بِكُمْ","bikum","with you","তোমাদের"],["أَذًۭى","adhan","any trouble","কষ্ট"],["مِّن","min","(because) of","হতে"],["مَّطَرٍ","maṭarin","rain","বৃষ্টি"],["أَوْ","aw","or","অথবা"],["كُنتُم","kuntum","you are","তোমরা হও"],["مَّرْضَىٰٓ","marḍā","sick","অসুস্থ"],["أَن","an","that","(যে)"],["تَضَعُوٓا۟","taḍa‘ū","you lay down","তোমাদের সংবরণ করায়"],["أَسْلِحَتَكُمْ ۖ","asliḥatakum","your arms","তোমাদের অস্ত্রশস্ত্র"],["وَخُذُوا۟","wakhudhū","but take","কিন্তু তোমরা অবলম্বন করবে"],["حِذْرَكُمْ ۗ","ḥidh'rakum","your precautions","তোমাদের সতর্কতা"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["أَعَدَّ","a‘adda","has prepared","প্রস্তুত করে রেখেছেন"],["لِلْكَـٰفِرِينَ","lil'kāfirīna","for the disbelievers","কাফিরদের জন্য"],["عَذَابًۭا","‘adhāban","a punishment","আজাব"],["مُّهِينًۭا","muhīnan","humiliating","লাঞ্ছনাকর"]],"t":"وَإِذَا كُ<k>نتَ</> فِيهِمْ فَأَقَمْتَ لَهُمُ <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةَ فَلْتَقُمْ <o>طَآ</>ئِفَ<d>ةٌۭ مِّ</>نْ<y>هُم مَّ</>عَكَ وَلْيَأْخُ<o>ذُوٓ</><s>ا۟</> أَسْلِحَتَهُمْ فَإِذَا سَجَدُو<s>ا۟</> فَلْيَكُونُو<s>ا۟</> <d>مِن وَ</><o>رَآ</>ئِكُمْ وَلْتَأْتِ <o>طَآ</>ئِفَةٌ أُخْرَىٰ لَمْ يُصَلُّو<s>ا۟</> فَلْيُصَلُّو<s>ا۟</> مَعَكَ وَلْيَأْخُذُو<s>ا۟</> حِذْرَهُمْ وَأَسْلِحَتَهُمْ ۗ وَدَّ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> لَوْ تَغْفُلُونَ عَنْ أَسْلِحَتِكُمْ وَأَمْتِعَتِكُمْ فَيَمِيلُونَ عَلَيْ<y>كُم مَّ</>يْلَ<d>ةًۭ وَٰ</>حِدَ<d>ةًۭ ۚ وَ</>لَا جُنَاحَ عَلَيْكُمْ إِ<k>ن كَ</>انَ بِكُمْ أَ<d>ذًۭى مِّن مَّ</>طَرٍ أَوْ كُ<k>نتُ</><y>م مَّ</>رْضَ<o>ىٰٓ</> أَ<k>ن تَ</>ضَ<o>عُوٓ</><s>ا۟</> أَسْلِحَتَكُمْ ۖ وَخُذُو<s>ا۟</> حِذْرَكُمْ ۗ إِ<g>نَّ</> <h>ٱ</>للَّهَ أَعَدَّ لِلْ<m>كَٰ</>فِرِينَ عَذَا<d>بًۭا مُّ</>هِينًۭا"},{"n":103,"w":[["فَإِذَا","fa-idhā","Then when","অতঃপর যখন"],["قَضَيْتُمُ","qaḍaytumu","you (have) finished","তোমরা সমাপ্ত কর"],["ٱلصَّلَوٰةَ","l-ṣalata","the prayer","সলাত"],["فَٱذْكُرُوا۟","fa-udh'kurū","then remember","তোমরা তখন স্মরণ কর"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["قِيَـٰمًۭا","qiyāman","standing","দাঁড়িয়ে"],["وَقُعُودًۭا","waqu‘ūdan","and sitting","ও বসে"],["وَعَلَىٰ","wa‘alā","and (lying) on","ও উপর"],["جُنُوبِكُمْ ۚ","junūbikum","your sides","তোমাদের পাশগুলোর (অর্থাৎ শুয়ে)"],["فَإِذَا","fa-idhā","But when","যখন অতঃপর"],["ٱطْمَأْنَنتُمْ","iṭ'manantum","you are secure","তোমরা নিরাপদ হও"],["فَأَقِيمُوا۟","fa-aqīmū","then establish","তোমরা তখন কায়েম কর"],["ٱلصَّلَوٰةَ ۚ","l-ṣalata","the (regular) prayer","সলাত"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلصَّلَوٰةَ","l-ṣalata","the prayer","সলাত"],["كَانَتْ","kānat","is","হলো"],["عَلَى","‘alā","on","উপর"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believers","মু'মিনদের"],["كِتَـٰبًۭا","kitāban","prescribed","ফরজ"],["مَّوْقُوتًۭا","mawqūtan","(at) fixed times","নির্দিষ্ট সময়ে"]],"t":"فَإِذَا قَضَيْتُمُ <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةَ فَ<h>ٱ</>ذْكُرُو<s>ا۟</> <h>ٱ</>للَّهَ قِ<m>يَٰ</><d>مًۭا وَ</>قُعُو<d>دًۭا وَ</>عَلَىٰ جُنُوبِكُمْ ۚ فَإِذَا <h>ٱ</><q>طْ</>مَأْنَ<k>نتُ</>مْ فَأَقِيمُو<s>ا۟</> <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةَ ۚ إِ<g>نَّ</> <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةَ كَانَتْ عَلَى <h>ٱ</>لْمُؤْمِنِينَ كِ<m>تَٰ</><d>بًۭا مَّ</>وْقُوتًۭا"},{"n":104,"w":[["وَلَا","walā","And (do) not","এবং না"],["تَهِنُوا۟","tahinū","be weak","তোমরা হতোদ্যম হয়ো"],["فِى","fī","in","(মধ্যে)"],["ٱبْتِغَآءِ","ib'tighāi","pursuit","পশ্চাদ্ধাবনে"],["ٱلْقَوْمِ ۖ","l-qawmi","(of) the people","(শত্রু) জাতির"],["إِن","in","If","যদি"],["تَكُونُوا۟","takūnū","you are","পেয়ে থাকো"],["تَأْلَمُونَ","talamūna","suffering","তোমরা যন্ত্রণা"],["فَإِنَّهُمْ","fa-innahum","then indeed, they","নিশ্চয় তবে তারাও"],["يَأْلَمُونَ","yalamūna","are (also) suffering","যন্ত্রণা পায়"],["كَمَا","kamā","like what","যেমন"],["تَأْلَمُونَ ۖ","talamūna","you are suffering","তোমরা যন্ত্রণা পাও"],["وَتَرْجُونَ","watarjūna","while you (have) hope","আর তোমরা আশা কর (পুরস্কার)"],["مِنَ","mina","from","হতে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["مَا","mā","what","যা"],["لَا","lā","not","না"],["يَرْجُونَ ۗ","yarjūna","they hope","তারা আশা করে"],["وَكَانَ","wakāna","And is","এবং হলেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["عَلِيمًا","‘alīman","All-Knowing","সর্বজ্ঞ"],["حَكِيمًا","ḥakīman","All-Wise","প্রজ্ঞাময়"]],"t":"وَلَا تَهِنُو<s>ا۟</> فِى <h>ٱ</><q>بْ</>تِ<o>غَآ</>ءِ <h>ٱ</>لْقَوْمِ ۖ إِ<k>ن تَ</>كُونُو<s>ا۟</> تَأْلَمُونَ فَإِ<g>نَّ</>هُمْ يَأْلَمُونَ كَمَا تَأْلَمُونَ ۖ وَتَرْجُونَ مِنَ <h>ٱ</>للَّهِ مَا لَا يَرْجُونَ ۗ وَكَانَ <h>ٱ</>للَّهُ عَلِيمًا حَكِيمًا"},{"n":105,"w":[["إِنَّآ","innā","Indeed","আমরা নিশ্চয়ই"],["أَنزَلْنَآ","anzalnā","We (have) sent down","আমরা নাযিল করেছি"],["إِلَيْكَ","ilayka","to you","তোমার প্রতি"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","(এই) গ্রন্থখানি"],["بِٱلْحَقِّ","bil-ḥaqi","with the truth","সত্য সহকারে"],["لِتَحْكُمَ","litaḥkuma","so that you may judge","তুমি যাতে বিচার কর"],["بَيْنَ","bayna","between","মাঝে"],["ٱلنَّاسِ","l-nāsi","the people","লোকদের"],["بِمَآ","bimā","with what","তেমনি যা"],["أَرَىٰكَ","arāka","has shown you","তোমাকে দেখিয়েছেন"],["ٱللَّهُ ۚ","l-lahu","Allah","আল্লাহ"],["وَلَا","walā","And (do) not","এবং না"],["تَكُن","takun","be","তুমি হয়ো"],["لِّلْخَآئِنِينَ","lil'khāinīna","for the deceitful","খিয়ানতকারীদের জন্য"],["خَصِيمًۭا","khaṣīman","a pleader","বিতর্ককারী"]],"t":"إِ<g>نَّ</><o>آ</> أَ<k>نزَ</>لْ<o>نَآ</> إِلَيْكَ <h>ٱ</>لْكِ<m>تَٰ</>بَ بِ<h>ٱ</>لْحَقِّ لِتَحْكُمَ بَيْنَ <h>ٱ</><l>ل</><g>نَّ</>اسِ بِ<o>مَآ</> أَرَ<m>ىٰ</>كَ <h>ٱ</>للَّهُ ۚ وَلَا تَ<w>كُن لِّ</>لْ<o>خَآ</>ئِنِينَ خَصِيمًۭا"},{"n":106,"w":[["وَٱسْتَغْفِرِ","wa-is'taghfiri","And seek forgiveness","এবং ক্ষমা চাও (কাছে)"],["ٱللَّهَ ۖ","l-laha","(of) Allah","আল্লাহর"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["كَانَ","kāna","is","হলেন"],["غَفُورًۭا","ghafūran","Oft-Forgiving","ক্ষমাশীল"],["رَّحِيمًۭا","raḥīman","Most Merciful","মেহেরবান"]],"t":"وَ<h>ٱ</>سْتَغْفِرِ <h>ٱ</>للَّهَ ۖ إِ<g>نَّ</> <h>ٱ</>للَّهَ كَانَ غَفُو<w>رًۭا رَّ</>حِيمًۭا"},{"n":107,"w":[["وَلَا","walā","And (do) not","এবং না"],["تُجَـٰدِلْ","tujādil","argue","তুমি বিসম্বাদ করো"],["عَنِ","‘ani","for","(তাদের) জন্য"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["يَخْتَانُونَ","yakhtānūna","deceive","খিয়ানত করে"],["أَنفُسَهُمْ ۚ","anfusahum","themselves","তাদের নিজেদের (উপর)"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَا","lā","(does) not","না"],["يُحِبُّ","yuḥibbu","love","পছন্দ করেন"],["مَن","man","(the one) who","যে"],["كَانَ","kāna","is","হবে"],["خَوَّانًا","khawwānan","treacherous","খিয়ানতকারী"],["أَثِيمًۭا","athīman","(and) sinful","পাপিষ্ঠ"]],"t":"وَلَا تُ<m>جَٰ</>دِلْ عَنِ <h>ٱ</>لَّذِينَ يَخْتَانُونَ أَ<k>نفُ</>سَهُمْ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ لَا يُحِبُّ مَ<k>ن كَ</>انَ خَوَّانًا أَثِيمًۭا"},{"n":108,"w":[["يَسْتَخْفُونَ","yastakhfūna","They seek to hide","তারা লুকাতে চায়"],["مِنَ","mina","from","থেকে"],["ٱلنَّاسِ","l-nāsi","the people","লোকদের"],["وَلَا","walā","but not","অথচ না"],["يَسْتَخْفُونَ","yastakhfūna","(can) they hide","তারা লুকাতে পারে"],["مِنَ","mina","from","থেকে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["وَهُوَ","wahuwa","and He","ও তিনি (ছিলেন)"],["مَعَهُمْ","ma‘ahum","(is) with them","তাদের সাথে"],["إِذْ","idh","when","যখন"],["يُبَيِّتُونَ","yubayyitūna","they plot by night","তারা রাতে পরামর্শ করে"],["مَا","mā","what","যা"],["لَا","lā","not","না"],["يَرْضَىٰ","yarḍā","(does) he approve","তিনি পছন্দ করেন"],["مِنَ","mina","of","(থেকে)"],["ٱلْقَوْلِ ۚ","l-qawli","the word","(কুট-কৌশলের) কথাবার্তা"],["وَكَانَ","wakāna","And is","এবং হলেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["بِمَا","bimā","of what","ঐ বিষয় যা"],["يَعْمَلُونَ","ya‘malūna","they do ","তারা কাজ করছে"],["مُحِيطًا","muḥīṭan","All-Encompassing","আয়ত্তকারী"]],"t":"يَسْتَخْفُونَ مِنَ <h>ٱ</><l>ل</><g>نَّ</>اسِ وَلَا يَسْتَخْفُونَ مِنَ <h>ٱ</>للَّهِ وَهُوَ مَعَهُمْ إِذْ يُبَيِّتُونَ مَا لَا يَرْضَىٰ مِنَ <h>ٱ</>لْقَوْلِ ۚ وَكَانَ <h>ٱ</>للَّهُ بِمَا يَعْمَلُونَ مُحِيطًا"},{"n":109,"w":[["هَـٰٓأَنتُمْ","hāantum","Here you are ","হ্যাঁ তোমরাই"],["هَـٰٓؤُلَآءِ","hāulāi","those who","ঐসব লোক (যারা)"],["جَـٰدَلْتُمْ","jādaltum","[you] argue","তোমরা ঝগড়া করেছ"],["عَنْهُمْ","‘anhum","for them","তাদের পক্ষে"],["فِى","fī","in","(মধ্যে)"],["ٱلْحَيَوٰةِ","l-ḥayati","the life","জীবনে"],["ٱلدُّنْيَا","l-dun'yā","(of) the world","দুনিয়ায়"],["فَمَن","faman","but who","কে অতঃপর"],["يُجَـٰدِلُ","yujādilu","will argue","ঝগড়া করবে"],["ٱللَّهَ","l-laha","(with) Allah","আল্লাহর (সাথে)"],["عَنْهُمْ","‘anhum","for them","তাদের পক্ষে"],["يَوْمَ","yawma","(on the) Day","দিনে"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) [the] Resurrection","কিয়ামাতের"],["أَم","am","or","অথবা"],["مَّن","man","who","কে"],["يَكُونُ","yakūnu","will be","হবে"],["عَلَيْهِمْ","‘alayhim","[over them]","তাদের পক্ষে"],["وَكِيلًۭا","wakīlan","(their) defender","উকিল"]],"t":"<o>هَٰٓ</>أَ<k>نتُ</>مْ <o>هَٰٓؤُلَآ</>ءِ <m>جَٰ</>دَلْتُمْ عَنْهُمْ فِى <h>ٱ</>لْحَيَ<s>وٰ</>ةِ <h>ٱ</><l>ل</>دُّنْيَا فَ<d>مَن يُ</><m>جَٰ</>دِلُ <h>ٱ</>للَّهَ عَنْهُمْ يَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ <y>أَم مَّ</><d>ن يَ</>كُونُ عَلَيْهِمْ وَكِيلًۭا"},{"n":110,"w":[["وَمَن","waman","And whoever","এবং যে"],["يَعْمَلْ","ya‘mal","does","কাজ করবে"],["سُوٓءًا","sūan","evil","মন্দ"],["أَوْ","aw","or","বা"],["يَظْلِمْ","yaẓlim","wrongs","জুলুম করবে"],["نَفْسَهُۥ","nafsahu","his soul","তার নিজের উপর"],["ثُمَّ","thumma","then","এরপর"],["يَسْتَغْفِرِ","yastaghfiri","seeks forgiveness","ক্ষমা চাইবে"],["ٱللَّهَ","l-laha","(of) Allah","আল্লাহর (কাছে)"],["يَجِدِ","yajidi","he will find","সে পাবে"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["غَفُورًۭا","ghafūran","Oft-Forgiving","ক্ষমাশীল"],["رَّحِيمًۭا","raḥīman","Most Merciful","মেহেরবান হিসেবে"]],"t":"وَ<d>مَن يَ</>عْمَلْ <o>سُوٓ</>ءًا أَوْ يَظْلِمْ نَفْسَهُ<m>ۥ</> ثُ<g>مَّ</> يَسْتَغْفِرِ <h>ٱ</>للَّهَ يَجِدِ <h>ٱ</>للَّهَ غَفُو<w>رًۭا رَّ</>حِيمًۭا"},{"n":111,"w":[["وَمَن","waman","And whoever","আর যে"],["يَكْسِبْ","yaksib","earns","অর্জন করে"],["إِثْمًۭا","ith'man","sin","গুনাহ"],["فَإِنَّمَا","fa-innamā","then only","তাহলে মূলত"],["يَكْسِبُهُۥ","yaksibuhu","he earns it","তা অর্জন করে সে"],["عَلَىٰ","‘alā","against","উপর"],["نَفْسِهِۦ ۚ","nafsihi","his soul","তার নিজের"],["وَكَانَ","wakāna","And is","এবং হলেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["عَلِيمًا","‘alīman","All-Knowing","সর্বজ্ঞ"],["حَكِيمًۭا","ḥakīman","All-Wise","প্রজ্ঞাময়"]],"t":"وَ<d>مَن يَ</>كْسِ<q>بْ</> إِثْ<k>مًۭا فَ</>إِ<g>نَّ</>مَا يَكْسِبُهُ<m>ۥ</> عَلَىٰ نَفْسِ<m>هِۦ</> ۚ وَكَانَ <h>ٱ</>للَّهُ عَلِيمًا حَكِيمًۭا"},{"n":112,"w":[["وَمَن","waman","And whoever","এবং যে"],["يَكْسِبْ","yaksib","earns","অর্জন করে"],["خَطِيٓـَٔةً","khaṭīatan","a fault","অন্যায়"],["أَوْ","aw","or","বা"],["إِثْمًۭا","ith'man","a sin","পাপ কাজ"],["ثُمَّ","thumma","then","এরপর"],["يَرْمِ","yarmi","throws","চাপিয়ে দেয়"],["بِهِۦ","bihi","it","তা"],["بَرِيٓـًۭٔا","barīan","(on) an innocent","নির্দোষের (উপর)"],["فَقَدِ","faqadi","then surely","নিশ্চয় তবে"],["ٱحْتَمَلَ","iḥ'tamala","he (has) burdened (himself)","সে বহন করল"],["بُهْتَـٰنًۭا","buh'tānan","(with) a slander","মিথ্যা অপবাদ"],["وَإِثْمًۭا","wa-ith'man","and a sin","ও পাপ"],["مُّبِينًۭا","mubīnan","manifest","সুস্পষ্ট"]],"t":"وَ<d>مَن يَ</>كْسِ<q>بْ</> خَطِ<o>يٓـَٔ</>ةً أَوْ إِثْ<k>مًۭا ثُ</><g>مَّ</> يَرْمِ بِ<m>هِۦ</> بَرِ<o>يٓـًۭٔ</><k>ا فَ</>قَدِ <h>ٱ</>حْتَمَلَ بُهْ<m>تَٰ</><d>نًۭا وَ</>إِثْ<d>مًۭا مُّ</>بِينًۭا"},{"n":113,"w":[["وَلَوْلَا","walawlā","And if not","এবং যদি না"],["فَضْلُ","faḍlu","(for the) Grace","অনুগ্রহ (হত)"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["عَلَيْكَ","‘alayka","upon you","তোম