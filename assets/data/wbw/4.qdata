":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> لَا تَ<q>قْ</>رَبُو<s>ا۟</> <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةَ وَأَ<k>نتُ</>مْ سُ<m>كَٰ</>رَىٰ حَتَّىٰ تَعْلَمُو<s>ا۟</> مَا تَقُولُونَ وَلَا جُنُبًا إِلَّا عَابِرِى سَبِيلٍ حَتَّىٰ تَغْتَسِلُو<s>ا۟ ۚ</> وَإِ<k>ن كُنتُ</><y>م مَّ</>رْضَ<o>ىٰٓ</> أَوْ عَلَىٰ سَفَرٍ أَوْ <o>جَآ</>ءَ أَحَ<d>دٌۭ مِّ</><k>نكُ</><y>م مِّ</>نَ <h>ٱ</>لْ<o>غَآ</>ئِطِ أَوْ <m>لَٰ</>مَسْتُمُ <h>ٱ</><l>ل</><g>نِّ</><o>سَآ</>ءَ فَلَمْ تَجِدُو<s>ا۟</> <o>مَآ</><k>ءًۭ فَ</>تَيَ<g>مَّ</>مُو<s>ا۟</> صَعِي<k>دًۭا طَيِّبًۭا فَ</><h>ٱ</>مْسَحُو<s>ا۟</> بِوُجُوهِكُمْ وَأَيْدِيكُمْ ۗ إِ<g>نَّ</> <h>ٱ</>للَّهَ كَانَ عَفُوًّا غَفُورًا"},{"n":44,"w":[["أَلَمْ","alam","Did not","নাই কি"],["تَرَ","tara","you see","তুমি দেখ"],["إِلَى","ilā","[towards]","তাদের প্রতি"],["ٱلَّذِينَ","alladhīna","those who","যাদের"],["أُوتُوا۟","ūtū","were given","দেয়া হয়েছিল"],["نَصِيبًۭا","naṣīban","a portion","এক অংশ"],["مِّنَ","mina","of","(থেকে)"],["ٱلْكِتَـٰبِ","l-kitābi","the Book","কিতাবের (জ্ঞানের)"],["يَشْتَرُونَ","yashtarūna","purchasing","তারা ক্রয় করে"],["ٱلضَّلَـٰلَةَ","l-ḍalālata","[the] error","পথ-ভ্রষ্টতা"],["وَيُرِيدُونَ","wayurīdūna","and wishing","ও তারা কামনা করে"],["أَن","an","that","যে"],["تَضِلُّوا۟","taḍillū","you stray","তোমরা হারিয়ে ফেল"],["ٱلسَّبِيلَ","l-sabīla","(from) the way","(সঠিক) পথ"]],"t":"أَلَمْ تَرَ إِلَى <h>ٱ</>لَّذِينَ أُوتُو<s>ا۟</> نَصِي<d>بًۭا مِّ</>نَ <h>ٱ</>لْكِ<m>تَٰ</>بِ يَشْتَرُونَ <h>ٱ</><l>ل</>ضَّ<m>لَٰ</>لَةَ وَيُرِيدُونَ أَ<k>ن تَ</>ضِلُّو<s>ا۟</> <h>ٱ</><l>ل</>سَّ<p>بِي</>لَ"},{"n":45,"w":[["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["أَعْلَمُ","a‘lamu","knows better","খুব জানেন"],["بِأَعْدَآئِكُمْ ۚ","bi-a‘dāikum","about your enemies","তোমাদের শত্রুদের সম্পর্কে"],["وَكَفَىٰ","wakafā","and (is) sufficient","এবং যথেষ্ট"],["بِٱللَّهِ","bil-lahi","Allah","আল্লাহই"],["وَلِيًّۭا","waliyyan","(as) a Protector","অভিভাবক হিসেবে"],["وَكَفَىٰ","wakafā","and sufficient","ও যথেষ্ট"],["بِٱللَّهِ","bil-lahi","(is) Allah","আল্লাহই"],["نَصِيرًۭا","naṣīran","(as) a Helper","সাহায্যকারী হিসেবে"]],"t":"وَ<h>ٱ</>للَّهُ أَعْلَمُ بِأَعْ<o>دَآ</>ئِكُمْ ۚ وَكَفَىٰ بِ<h>ٱ</>للَّهِ وَلِ<d>يًّۭا وَ</>كَفَىٰ بِ<h>ٱ</>للَّهِ نَصِيرًۭا"},{"n":46,"w":[["مِّنَ","mina","Of","(তাদের) মধ্য হতে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["هَادُوا۟","hādū","are Jews","ইহুদী হয়েছে"],["يُحَرِّفُونَ","yuḥarrifūna","they distort","তারা বিকৃত করে"],["ٱلْكَلِمَ","l-kalima","the words","শব্দগুলোকে"],["عَن","‘an","from","হতে"],["مَّوَاضِعِهِۦ","mawāḍi‘ihi","their places","তাঁর জায়গাগুলো (অর্থ মূলঅর্থ হতে)"],["وَيَقُولُونَ","wayaqūlūna","and they say","এবং তারা বলে"],["سَمِعْنَا","sami‘'nā","We hear[d]","''আমরা শুনলাম"],["وَعَصَيْنَا","wa‘aṣaynā","and we disobey[ed]","কিন্তু আমরা অমান্য করলাম''"],["وَٱسْمَعْ","wa-is'ma‘","and \"Hear","ও শুনুন"],["غَيْرَ","ghayra","not","ব্যতীত"],["مُسْمَعٍۢ","mus'ma‘in","to be heard","শুনা"],["وَرَٰعِنَا","warā‘inā","and \"Raina","এবং (বলে) 'রাইনা'''"],["لَيًّۢا","layyan","twisting","মুড়া দিয়ে"],["بِأَلْسِنَتِهِمْ","bi-alsinatihim","[with] their tongues","তাদের জিহ্বাগুলো (অর্থ বিকৃত করার জন্য)"],["وَطَعْنًۭا","waṭa‘nan","and defaming","ও তাচ্ছিল্য করে"],["فِى","fī","[in]","ক্ষেত্রে"],["ٱلدِّينِ ۚ","l-dīni","the religion","দ্বীনের"],["وَلَوْ","walaw","And if","এবং যদি"],["أَنَّهُمْ","annahum","[that] they","তারা বাস্তবিক"],["قَالُوا۟","qālū","(had) said","বলত"],["سَمِعْنَا","sami‘'nā","We hear[d]","''আমরা শুনলাম"],["وَأَطَعْنَا","wa-aṭa‘nā","and we obey[ed]","এবং আমরা মানলাম''"],["وَٱسْمَعْ","wa-is'ma‘","and \"Hear","ও শুনুন"],["وَٱنظُرْنَا","wa-unẓur'nā","and look (at) us","ও আমাদের প্রতি লক্ষ্য করুন"],["لَكَانَ","lakāna","surely it (would) have been","হত নিশ্চয়"],["خَيْرًۭا","khayran","better","উত্তম"],["لَّهُمْ","lahum","for them","তাদের জন্য"],["وَأَقْوَمَ","wa-aqwama","and more suitable","ও সংগত (হত)"],["وَلَـٰكِن","walākin","[And] but","কিন্তু"],["لَّعَنَهُمُ","la‘anahumu","cursed them","তাদের অভিশাপ দিয়েছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["بِكُفْرِهِمْ","bikuf'rihim","for their disbelief","কুফরীর কারণে তাদের"],["فَلَا","falā","so not","অতএব না"],["يُؤْمِنُونَ","yu'minūna","they believe","তারা ঈমান আনবে"],["إِلَّا","illā","except","এ ছাড়া"],["قَلِيلًۭا","qalīlan","a few","অল্প সংখ্যক"]],"t":"مِّنَ <h>ٱ</>لَّذِينَ هَادُو<s>ا۟</> يُحَرِّفُونَ <h>ٱ</>لْكَلِمَ <d>عَن مَّ</>وَاضِعِ<m>هِۦ</> وَيَقُولُونَ سَمِعْنَا وَعَصَيْنَا وَ<h>ٱ</>سْمَعْ غَيْرَ مُسْمَ<d>عٍۢ وَ</><m>رَٰ</>عِنَا لَ<i>يًّۢا بِ</>أَلْسِنَتِهِمْ وَطَعْ<k>نًۭا فِ</>ى <h>ٱ</><l>ل</>دِّينِ ۚ وَلَوْ أَ<g>نَّ</>هُمْ قَالُو<s>ا۟</> سَمِعْنَا وَأَطَعْنَا وَ<h>ٱ</>سْمَعْ وَ<h>ٱ</><k>نظُ</>رْنَا لَكَانَ خَيْ<w>رًۭا لَّ</>هُمْ وَأَ<q>قْ</>وَمَ وَ<m>لَٰ</><w>كِن لَّ</>عَنَهُمُ <h>ٱ</>للَّهُ بِكُفْرِهِمْ فَلَا يُؤْمِنُونَ إِلَّا قَلِيلًۭا"},{"n":47,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you","ওহে"],["ٱلَّذِينَ","alladhīna","who","যাদের"],["أُوتُوا۟","ūtū","(have) been given","দেয়া হয়েছে"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","কিতাব"],["ءَامِنُوا۟","āminū","believe","তোমরা ঈমান আন"],["بِمَا","bimā","in what","ঐবিষয়ে যা"],["نَزَّلْنَا","nazzalnā","We (have) revealed","আমরা নাযিল করেছি"],["مُصَدِّقًۭا","muṣaddiqan","confirming","সত্যায়নকারী"],["لِّمَا","limā","what is","সেটারও যা"],["مَعَكُم","ma‘akum","with you","তোমাদের (আছে)"],["مِّن","min","from","(থেকে)"],["قَبْلِ","qabli","before","ইতিপূর্বে"],["أَن","an","[that]","যে"],["نَّطْمِسَ","naṭmisa","We efface","বিকৃত করব আমরা"],["وُجُوهًۭا","wujūhan","faces","মুখের আকৃতি"],["فَنَرُدَّهَا","fanaruddahā","and turn them","অতঃপর ফিরাবো আমরা তা"],["عَلَىٰٓ","‘alā","on","উপর"],["أَدْبَارِهَآ","adbārihā","their backs","তার পিছন দিয়ে"],["أَوْ","aw","or","অথবা"],["نَلْعَنَهُمْ","nal‘anahum","We curse them","তাদের অভিশাপ দেব আমরা"],["كَمَا","kamā","as","যেমন"],["لَعَنَّآ","la‘annā","We cursed","আমরা অভিশাপ দিয়েছিলাম"],["أَصْحَـٰبَ","aṣḥāba","companions","ওয়ালাদেরকে"],["ٱلسَّبْتِ ۚ","l-sabti","(of) the Sabbath","শনিবার"],["وَكَانَ","wakāna","And is","এবং হয় ই"],["أَمْرُ","amru","(the) command","আদেশ"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহ"],["مَفْعُولًا","maf‘ūlan","(always) executed","কার্যকরী"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ أُوتُو<s>ا۟</> <h>ٱ</>لْكِ<m>تَٰ</>بَ ءَامِنُو<s>ا۟</> بِمَا نَزَّلْنَا مُصَدِّ<w>قًۭا لِّ</>مَا مَعَ<y>كُم مِّ</><k>ن قَ</><q>بْ</>لِ <d>أَن نَّ</><q>طْ</>مِسَ وُجُو<k>هًۭا فَ</>نَرُدَّهَا عَلَ<o>ىٰٓ</> أَ<q>دْ</>بَارِ<o>هَآ</> أَوْ نَلْعَنَهُمْ كَمَا لَعَ<g>نَّ</><o>آ</> أَصْ<m>حَٰ</>بَ <h>ٱ</><l>ل</>سَّ<q>بْ</>تِ ۚ وَكَانَ أَمْرُ <h>ٱ</>للَّهِ مَفْعُولًا"},{"n":48,"w":[["إِنَّ","inna","Indeed","নিশ্চয়"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَا","lā","(does) not","না"],["يَغْفِرُ","yaghfiru","forgive","মাফ করেন"],["أَن","an","that","(যে)"],["يُشْرَكَ","yush'raka","partners be associated","শিরক করাকে"],["بِهِۦ","bihi","with Him","তার সাথে"],["وَيَغْفِرُ","wayaghfiru","but He forgives","কিন্তু মাফ করেন"],["مَا","mā","from","যা (আছে)"],["دُونَ","dūna","other than","ছাড়া"],["ذَٰلِكَ","dhālika","that","এটা (অর্থাৎ শিরক)"],["لِمَن","liman","for whom","যাকে"],["يَشَآءُ ۚ","yashāu","He wills","তিনি ইচ্ছা করেন"],["وَمَن","waman","And whoever","এবং যে কেউ"],["يُشْرِكْ","yush'rik","associates partners","শিরক করে"],["بِٱللَّهِ","bil-lahi","with Allah","আল্লাহর সাথে"],["فَقَدِ","faqadi","then surely","নিশ্চয়ই তবে"],["ٱفْتَرَىٰٓ","if'tarā","he has fabricated","সে রচনা করল"],["إِثْمًا","ith'man","a sin ","গুনাহ"],["عَظِيمًا","‘aẓīman","tremendous","বিরাট"]],"t":"إِ<g>نَّ</> <h>ٱ</>للَّهَ لَا يَغْفِرُ <d>أَن يُ</>شْرَكَ بِ<m>هِۦ</> وَيَغْفِرُ مَا دُونَ <m>ذَٰ</>لِكَ لِ<d>مَن يَ</><o>شَآ</>ءُ ۚ وَ<d>مَن يُ</>شْرِكْ بِ<h>ٱ</>للَّهِ فَقَدِ <h>ٱ</>فْتَرَ<o>ىٰٓ</> إِثْمًا عَظِيمًا"},{"n":49,"w":[["أَلَمْ","alam","Do not","নাই কি"],["تَرَ","tara","you see","তুমি দেখ"],["إِلَى","ilā","[towards]","প্রতি"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["يُزَكُّونَ","yuzakkūna","claim purity","পবিত্র করেছে (বলে দাবী করে)"],["أَنفُسَهُم ۚ","anfusahum","(for) themselves","তাদের নিজেদেরকে"],["بَلِ","bali","Nay","বরং"],["ٱللَّهُ","l-lahu","(it is) Allah","আল্লাহ্‌ই"],["يُزَكِّى","yuzakkī","He purifies","পবিত্র করেন"],["مَن","man","whom","যাকে"],["يَشَآءُ","yashāu","He wills","তিনি ইচ্ছে করেন"],["وَلَا","walā","and not","এবং না"],["يُظْلَمُونَ","yuẓ'lamūna","they will be wronged","জুলুম করা হয় (কারও প্রতি)"],["فَتِيلًا","fatīlan","(even as much as) a hair on a date-seed","সুতা পরিমাণও"]],"t":"أَلَمْ تَرَ إِلَى <h>ٱ</>لَّذِينَ يُزَكُّونَ أَ<k>نفُ</>سَ<f>هُم ۚ بَ</>لِ <h>ٱ</>للَّهُ يُزَكِّى <d>مَن يَ</><o>شَآ</>ءُ وَلَا يُظْلَمُونَ فَتِيلًا"},{"n":50,"w":[["ٱنظُرْ","unẓur","See","লক্ষ্য কর"],["كَيْفَ","kayfa","how","কেমন"],["يَفْتَرُونَ","yaftarūna","they invent","তারা রচনা করে"],["عَلَى","‘alā","about","উপর"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["ٱلْكَذِبَ ۖ","l-kadhiba","[the] lie","মিথ্যার"],["وَكَفَىٰ","wakafā","and sufficient","এবং যথেষ্ট"],["بِهِۦٓ","bihi","is it ","তা"],["إِثْمًۭا","ith'man","(as) a sin","গুনাহ (হিসেবে)"],["مُّبِينًا","mubīnan","manifest","সুস্পষ্ট"]],"t":"ٱ<k>نظُ</>رْ كَيْفَ يَفْتَرُونَ عَلَى <h>ٱ</>للَّهِ <h>ٱ</>لْكَذِبَ ۖ وَكَفَىٰ بِ<o>هِۦٓ</> إِثْ<d>مًۭا مُّ</>بِينًا"},{"n":51,"w":[["أَلَمْ","alam","Do not","নাই কি"],["تَرَ","tara","you see","তুমি দেখ"],["إِلَى","ilā","[towards]","প্রতি"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যাদের"],["أُوتُوا۟","ūtū","were given","দেওয়া হয়েছিল"],["نَصِيبًۭا","naṣīban","a portion","এক অংশ"],["مِّنَ","mina","of","(থেকে)"],["ٱلْكِتَـٰبِ","l-kitābi","the Book","কিতাবের (জ্ঞানের)"],["يُؤْمِنُونَ","yu'minūna","They believe","তারা বিশ্বাস করে"],["بِٱلْجِبْتِ","bil-jib'ti","in the superstition","জিবতের' উপর"],["وَٱلطَّـٰغُوتِ","wal-ṭāghūti","and the false deities","এবং তাগুতের (উপর)"],["وَيَقُولُونَ","wayaqūlūna","and they say","ও তারা বলে"],["لِلَّذِينَ","lilladhīna","for those who","যারা (তাদেরকে)"],["كَفَرُوا۟","kafarū","disbelieve[d]","কুফরী করেছে"],["هَـٰٓؤُلَآءِ","hāulāi","These","''এরা"],["أَهْدَىٰ","ahdā","(are) better guided","অধিকতর সঠিক"],["مِنَ","mina","than","(তাদের) চেয়ে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ءَامَنُوا۟","āmanū","believe[d]","ঈমান এনেছে"],["سَبِيلًا","sabīlan","(as to the) way","পথ (প্রাপ্তির ব্যাপারে)"]],"t":"أَلَمْ تَرَ إِلَى <h>ٱ</>لَّذِينَ أُوتُو<s>ا۟</> نَصِي<d>بًۭا مِّ</>نَ <h>ٱ</>لْكِ<m>تَٰ</>بِ يُؤْمِنُونَ بِ<h>ٱ</>لْجِ<q>بْ</>تِ وَ<h>ٱ</><l>ل</><m>طَّٰ</>غُوتِ وَيَقُولُونَ لِلَّذِينَ كَفَرُو<s>ا۟</> <o>هَٰٓؤُلَآ</>ءِ أَهْدَىٰ مِنَ <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> سَبِيلًا"},{"n":52,"w":[["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐ সব লোক"],["ٱلَّذِينَ","alladhīna","(are) the ones","(তারাই) যাদের"],["لَعَنَهُمُ","la‘anahumu","(who have been) cursed","তাদেরকে অভিশাপ দিয়েছেন"],["ٱللَّهُ ۖ","l-lahu","(by) Allah","আল্লাহ"],["وَمَن","waman","and whoever","এবং যাকে"],["يَلْعَنِ","yal‘ani","(is) cursed","অভিশাপ দেন"],["ٱللَّهُ","l-lahu","(by) Allah","আল্লাহ"],["فَلَن","falan","then never","এরপর কক্ষনো না"],["تَجِدَ","tajida","will you find","তুমি পাবে"],["لَهُۥ","lahu","for him","তাঁর জন্য"],["نَصِيرًا","naṣīran","(any) helper","কোন সাহায্যকারী"]],"t":"أُ<s>و۟</><o>لَٰٓ</>ئِكَ <h>ٱ</>لَّذِينَ لَعَنَهُمُ <h>ٱ</>للَّهُ ۖ وَ<d>مَن يَ</>لْعَنِ <h>ٱ</>للَّهُ فَلَ<k>ن تَ</>جِدَ لَهُ<m>ۥ</> نَصِيرًا"},{"n":53,"w":[["أَمْ","am","Or","কি"],["لَهُمْ","lahum","for them","তাদের জন্য আছে"],["نَصِيبٌۭ","naṣībun","(is) a share","কোন অংশ"],["مِّنَ","mina","of","(থেকে)"],["ٱلْمُلْكِ","l-mul'ki","the Kingdom","রাজশক্তিতে"],["فَإِذًۭا","fa-idhan","Then","অতঃপর যদি (থাকত)"],["لَّا","lā","not would","না"],["يُؤْتُونَ","yu'tūna","they give","তারা দিত"],["ٱلنَّاسَ","l-nāsa","the people","মানুষকে"],["نَقِيرًا","naqīran","(even as much as the) speck on a date seed","এক কপর্দকও"]],"t":"أَمْ لَهُمْ نَصِي<d>بٌۭ مِّ</>نَ <h>ٱ</>لْمُلْكِ فَإِ<w>ذًۭا لَّ</>ا يُؤْتُونَ <h>ٱ</><l>ل</><g>نَّ</>اسَ نَقِيرًا"},{"n":54,"w":[["أَمْ","am","Or","(তাহলে) কি"],["يَحْسُدُونَ","yaḥsudūna","are they jealous","তারা হিংসা করে"],["ٱلنَّاسَ","l-nāsa","(of) the people","লোকদের"],["عَلَىٰ","‘alā","for","উপর"],["مَآ","mā","what","(এজন্য) যা"],["ءَاتَىٰهُمُ","ātāhumu","gave them","তাদের দিয়েছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],