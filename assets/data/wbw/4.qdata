qaryati","[the] town","জনপদ"],["ٱلظَّالِمِ","l-ẓālimi","[the] oppressor(s)","জালিম"],["أَهْلُهَا","ahluhā","(are) its people","তার অধিবাসীরা"],["وَٱجْعَل","wa-ij'‘al","and appoint","এবং বানিয়ে দাও"],["لَّنَا","lanā","for us","আমাদের জন্য"],["مِن","min","from","থেকে"],["لَّدُنكَ","ladunka","Yourself","তোমার নিকট"],["وَلِيًّۭا","waliyyan","a protector","কোন অভিভাবক"],["وَٱجْعَل","wa-ij'‘al","and appoint","ও বানাও"],["لَّنَا","lanā","for us","আমাদের জন্য"],["مِن","min","from","থেকে"],["لَّدُنكَ","ladunka","Yourself","তোমার নিকট"],["نَصِيرًا","naṣīran","a helper","কোন সাহায্যকারী"]],"t":"وَمَا لَكُمْ لَا تُ<m>قَٰ</>تِلُونَ فِى سَبِيلِ <h>ٱ</>للَّهِ وَ<h>ٱ</>لْمُسْتَضْعَفِينَ مِنَ <h>ٱ</><l>ل</>رِّجَالِ وَ<h>ٱ</><l>ل</><g>نِّ</><o>سَآ</>ءِ وَ<h>ٱ</>لْوِلْ<m>دَٰ</>نِ <h>ٱ</>لَّذِينَ يَقُولُونَ رَبَّ<o>نَآ</> أَخْرِ<q>جْ</>نَا مِنْ <m>هَٰ</>ذِهِ <h>ٱ</>لْقَرْيَةِ <h>ٱ</><l>ل</>ظَّالِمِ أَهْلُهَا وَ<h>ٱ</><q>جْ</>عَل لَّنَا <w>مِن لَّ</>دُ<k>نكَ</> وَلِ<d>يًّۭا وَ</><h>ٱ</><q>جْ</>عَل لَّنَا <w>مِن لَّ</>دُ<k>نكَ</> نَصِيرًا"},{"n":76,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["يُقَـٰتِلُونَ","yuqātilūna","they fight","তারা লড়ে"],["فِى","fī","in","(মধ্যে)"],["سَبِيلِ","sabīli","(the) way","পথে"],["ٱللَّهِ ۖ","l-lahi","(of) Allah","আল্লাহর"],["وَٱلَّذِينَ","wa-alladhīna","and those","এবং যারা"],["كَفَرُوا۟","kafarū","who disbelieve","কুফরী করেছে"],["يُقَـٰتِلُونَ","yuqātilūna","they fight","তারা লড়ে"],["فِى","fī","in","(মধ্যে)"],["سَبِيلِ","sabīli","(the) way","পথে"],["ٱلطَّـٰغُوتِ","l-ṭāghūti","(of) the false deities","তাগুতের"],["فَقَـٰتِلُوٓا۟","faqātilū","So fight (against)","অতএব তোমরা লড়"],["أَوْلِيَآءَ","awliyāa","(the) friends","(বিরুদ্ধে) বন্ধুদের"],["ٱلشَّيْطَـٰنِ ۖ","l-shayṭāni","(of) the Shaitaan","শয়তানের"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["كَيْدَ","kayda","(the) strategy","কৌশল"],["ٱلشَّيْطَـٰنِ","l-shayṭāni","(of) the Shaitaan","শয়তানের"],["كَانَ","kāna","is","হলো"],["ضَعِيفًا","ḍa‘īfan","weak","(বড়) দুর্বল"]],"t":"ٱلَّذِينَ ءَامَنُو<s>ا۟</> يُ<m>قَٰ</>تِلُونَ فِى سَبِيلِ <h>ٱ</>للَّهِ ۖ وَ<h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> يُ<m>قَٰ</>تِلُونَ فِى سَبِيلِ <h>ٱ</><l>ل</><m>طَّٰ</>غُوتِ فَ<m>قَٰ</>تِ<o>لُوٓ</><s>ا۟</> أَوْلِ<o>يَآ</>ءَ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نِ ۖ إِ<g>نَّ</> كَيْدَ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نِ كَانَ ضَعِيفًا"},{"n":77,"w":[["أَلَمْ","alam","Have not","নাই কি"],["تَرَ","tara","you seen","তুমি দেখ"],["إِلَى","ilā","[towards]","প্রতি"],["ٱلَّذِينَ","alladhīna","those who","যাদের"],["قِيلَ","qīla","(when) it was said","বলা হয়েছিল"],["لَهُمْ","lahum","to them","তাদেরকে"],["كُفُّوٓا۟","kuffū","Restrain","''সংবরণ কর (তোমরা)"],["أَيْدِيَكُمْ","aydiyakum","your hands","তোমাদের হাতগুলো"],["وَأَقِيمُوا۟","wa-aqīmū","and establish","ও তোমরা কায়েম কর"],["ٱلصَّلَوٰةَ","l-ṣalata","the prayer","সলাত"],["وَءَاتُوا۟","waātū","and give","ও তোমরা দাও"],["ٱلزَّكَوٰةَ","l-zakata","the zakah","জাকাত''"],["فَلَمَّا","falammā","Then when","যখন অতঃপর"],["كُتِبَ","kutiba","was ordained","নির্দেশ দেয়া হলো"],["عَلَيْهِمُ","‘alayhimu","on them","তাদের উপর"],["ٱلْقِتَالُ","l-qitālu","the fighting","যুদ্ধের"],["إِذَا","idhā","then","তখন"],["فَرِيقٌۭ","farīqun","a group","একদল"],["مِّنْهُمْ","min'hum","of them","তাদের মধ্য হতে"],["يَخْشَوْنَ","yakhshawna","[they] fear","ভয় করেছে"],["ٱلنَّاسَ","l-nāsa","the people","মানুষকে"],["كَخَشْيَةِ","kakhashyati","as (they) fear","ভয় যেমন (করা উচিৎ)"],["ٱللَّهِ","l-lahi","Allah","আল্লাহকে"],["أَوْ","aw","or","বা"],["أَشَدَّ","ashadda","more intense","অধিকতর"],["خَشْيَةًۭ ۚ","khashyatan","fear","ভয়"],["وَقَالُوا۟","waqālū","and they said","এবং তারা বলেছিল"],["رَبَّنَا","rabbanā","Our Lord","''হে আমাদের রব"],["لِمَ","lima","why","কেন"],["كَتَبْتَ","katabta","have You ordained","তুমি নির্ধারিত করলে"],["عَلَيْنَا","‘alaynā","upon us","আমাদের উপর"],["ٱلْقِتَالَ","l-qitāla","[the] fighting","যুদ্ধ"],["لَوْلَآ","lawlā","Why not","না কেন"],["أَخَّرْتَنَآ","akhartanā","You postpone (it for) us","আমাদের অবকাশ দিলে"],["إِلَىٰٓ","ilā","to","পর্য