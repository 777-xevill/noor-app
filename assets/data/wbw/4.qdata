k>ن شَ</>هِدُو<s>ا۟</> فَأَمْسِكُوهُ<g>نَّ</> فِى <h>ٱ</>لْبُيُوتِ حَتَّىٰ يَتَوَفَّ<m>ىٰ</>هُ<g>نَّ</> <h>ٱ</>لْمَوْتُ أَوْ يَ<q>جْ</>عَلَ <h>ٱ</>للَّهُ لَهُ<g>نَّ</> سَبِيلًۭا"},{"n":16,"w":[["وَٱلَّذَانِ","wa-alladhāni","And the two who","এবং যে দুজন"],["يَأْتِيَـٰنِهَا","yatiyānihā","commit it","তাতে লিপ্ত হবে"],["مِنكُمْ","minkum","among you","তোমাদের মধ্য হতে"],["فَـَٔاذُوهُمَا ۖ","faādhūhumā","then punish both of them","তাদের দুজনকে অতঃপর শাস্তি দাও"],["فَإِن","fa-in","But if","অতঃপর যদি"],["تَابَا","tābā","they repent","দুজনে তওবা করে"],["وَأَصْلَحَا","wa-aṣlaḥā","and correct themselves","ও দুজনে সংশোধন হয়"],["فَأَعْرِضُوا۟","fa-a‘riḍū","then turn away","তোমরা তবে উপেক্ষা কর"],["عَنْهُمَآ ۗ","‘anhumā","from both of them","তাদের দুজনকে (অর্থাৎ মাফ করে দাও)"],["إِنَّ","inna","Indeed","নিশ্চয়"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["كَانَ","kāna","is","হলেন"],["تَوَّابًۭا","tawwāban","Oft-Forgiving","বড়ই ক্ষমাশীল"],["رَّحِيمًا","raḥīman","Most-Merciful","মেহেরবান"]],"t":"وَ<h>ٱ</>لَّذَانِ يَأْتِ<m>يَٰ</>نِهَا مِ<k>نكُ</>مْ فَـَٔاذُوهُمَا ۖ فَإِ<k>ن تَ</>ابَا وَأَصْلَحَا فَأَعْرِضُو<s>ا۟</> عَنْهُ<o>مَآ ۗ</> إِ<g>نَّ</> <h>ٱ</>للَّهَ كَانَ تَوَّا<w>بًۭا رَّ</>حِيمًا"},{"n":17,"w":[["إِنَّمَا","innamā","Only","মুলতঃ"],["ٱلتَّوْبَةُ","l-tawbatu","the acceptance of repentance","তওবা"],["عَلَى","‘alā","by","কাছে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["لِلَّذِينَ","lilladhīna","(is) for those who","(তাদের) জন্য যারা"],["يَعْمَلُونَ","ya‘malūna","do","কাজ করে"],["ٱلسُّوٓءَ","l-sūa","the evil","মন্দ"],["بِجَهَـٰلَةٍۢ","bijahālatin","in ignorance","অজ্ঞতার কারণে"],["ثُمَّ","thumma","then","এরপর"],["يَتُوبُونَ","yatūbūna","they repent","তারা তওবা করে"],["مِن","min","from","(থেকে)"],["قَرِيبٍۢ","qarībin","soon after","অবিলম্বে"],["فَأُو۟لَـٰٓئِكَ","fa-ulāika","Then those","ঐসব লোক অতঃপর"],["يَتُوبُ","yatūbu","will have forgiveness","ক্ষমাশীল হন"],["ٱللَّهُ","l-lahu","(from) Allah","আল্লাহ"],["عَلَيْهِمْ ۗ","‘alayhim","upon them","তাদের উপর"],["وَكَانَ","wakāna","and is","এবং হলেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["عَلِيمًا","‘alīman","All-Knowing","সর্বজ্ঞ"],["حَكِيمًۭا","ḥakīman","All-Wise","প্রজ্ঞাময়"]],"t":"إِ<g>نَّ</>مَا <h>ٱ</><l>ل</>تَّوْبَةُ عَلَى <h>ٱ</>للَّهِ لِلَّذِينَ يَعْمَلُونَ <h>ٱ</><l>ل</><o>سُّوٓ</>ءَ بِجَ<m>هَٰ</>لَ<k>ةٍۢ ثُ</><g>مَّ</> يَتُوبُونَ مِ<k>ن قَ</>رِي<k>بٍۢ فَ</>أُ<s>و۟</><o>لَٰٓ</>ئِكَ يَتُوبُ <h>ٱ</>للَّهُ عَلَيْهِمْ ۗ وَكَانَ <h>ٱ</>للَّهُ عَلِيمًا حَكِيمًۭا"},{"n":18,"w":[["وَلَيْسَتِ","walaysati","And not","এবং নয়"],["ٱلتَّوْبَةُ","l-tawbatu","(is) the acceptance of repentance","তওবা"],["لِلَّذِينَ","lilladhīna","for those who","(তাদের) জন্য যারা"],["يَعْمَلُونَ","ya‘malūna","do","কাজ করে"],["ٱلسَّيِّـَٔاتِ","l-sayiāti","the evil deeds","পাপের"],["حَتَّىٰٓ","ḥattā","until","এমনকি"],["إِذَا","idhā","when","যখন"],["حَضَرَ","ḥaḍara","approaches","উপস্থিত হয়"],["أَحَدَهُمُ","aḥadahumu","one of them","কারও তাদের"],["ٱلْمَوْتُ","l-mawtu","[the] death","মৃত্যু"],["قَالَ","qāla","he says","সে বলে"],["إِنِّى","innī","Indeed I","''আমি নিশ্চয়ই"],["تُبْتُ","tub'tu","repent","তওবা করছি"],["ٱلْـَٔـٰنَ","l-āna","now","এখন''"],["وَلَا","walā","and not","এবং নয়"],["ٱلَّذِينَ","alladhīna","those who","(তাদের জন্যও) যারা"],["يَمُوتُونَ","yamūtūna","die","মারা যায়"],["وَهُمْ","wahum","while they","তারা এ অবস্থায় যে"],["كُفَّارٌ ۚ","kuffārun","(are) disbelievers","কাফির"],["أُو۟لَـٰٓئِكَ","ulāika","Those ","ঐসব লোক"],["أَعْتَدْنَا","a‘tadnā","We have prepared","আমরা তৈরী করে রেখেছি"],["لَهُمْ","lahum","for them","তাদের জন্য"],["عَذَابًا","‘adhāban","a punishment","আজাব"],["أَلِيمًۭا","alīman","painful","বড় যন্ত্রণাদায়ক"]],"t":"وَلَيْسَتِ <h>ٱ</><l>ل</>تَّوْبَةُ لِلَّذِينَ يَعْمَلُونَ <h>ٱ</><l>ل</>سَّيِّـَٔاتِ حَتَّ<o>ىٰٓ</> إِذَا حَضَرَ أَحَدَهُمُ <h>ٱ</>لْمَوْتُ قَالَ إِ<g>نِّ</>ى تُ<q>بْ</>تُ <h>ٱ</><m>لْـَٰٔ</>نَ وَلَا <h>ٱ</>لَّذِينَ يَمُوتُونَ وَهُمْ كُفَّارٌ ۚ أُ<s>و۟</><o>لَٰٓ</>ئِكَ أَعْتَ<q>دْ</>نَا لَهُمْ عَذَابًا أَلِيمًۭا"},{"n":19,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you","ওহে"],["ٱلَّذِينَ","alladhīna","who","যারা"],["ءَامَنُوا۟","āmanū","believe[d]","ঈমান এনেছ"],["لَا","lā","Not","না"],["يَحِلُّ","yaḥillu","(is) lawful","বৈধ হবে"],["لَكُمْ","lakum","for you","তোমাদের জন্য"],["أَن","an","that","যে"],["تَرِثُوا۟","tarithū","you inherit","তোমরা উত্তরাধিকারী হবে"],["ٱلنِّسَآءَ","l-nisāa","the women","স্ত্রীলোকদের"],["كَرْهًۭا ۖ","karhan","(by) force","জোরপূর্বক"],["وَلَا","walā","And not","এবং না"],["تَعْضُلُوهُنَّ","ta‘ḍulūhunna","you constraint them","তোমরা বাধা দিও (বিবাহবন্ধন হতে) তাদেরকে"],["لِتَذْهَبُوا۟","litadhhabū","so that you may take","তোমরা নেয়ার জন্য"],["بِبَعْضِ","biba‘ḍi","a part","কিছু অংশ"],["مَآ","mā","(of) what","যা"],["ءَاتَيْتُمُوهُنَّ","ātaytumūhunna","you have given them","তোমরা দিয়েছ তাদেরকে"],["إِلَّآ","illā","except","কিন্তু"],["أَن","an","that","(যে)"],["يَأْتِينَ","yatīna","they commit","তারা লিপ্ত হলে"],["بِفَـٰحِشَةٍۢ","bifāḥishatin","immorality","ব্যভিচারে"],["مُّبَيِّنَةٍۢ ۚ","mubayyinatin","open","প্রকাশ্য (তা হতে বাধা দিও)"],["وَعَاشِرُوهُنَّ","wa‘āshirūhunna","And live with them","এবং তোমরা জীবনযাপন কর তাদের নিয়ে"],["بِٱلْمَعْرُوفِ ۚ","bil-ma‘rūfi","in kindness","সদ্ভাবে"],["فَإِن","fa-in","But if","যদি অতঃপর"],["كَرِهْتُمُوهُنَّ","karih'tumūhunna","you dislike them","তোমরা অপছন্দ কর তাদেরকে"],["فَعَسَىٰٓ","fa‘asā","then perhaps","হতে পারে তবে"],["أَن","an","that","যে"],["تَكْرَهُوا۟","takrahū","you dislike","তোমরা অপছন্দ কর"],["شَيْـًۭٔا","shayan","a thing","এক জিনিস"],["وَيَجْعَلَ","wayaj‘ala","and has placed","কিন্তু রেখেছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["فِيهِ","fīhi","in it","তার মধ্যে"],["خَيْرًۭا","khayran","good","কল্যাণ"],["كَثِيرًۭا","kathīran","much","অনেক"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> لَا يَحِلُّ لَكُمْ أَ<k>ن تَ</>رِثُو<s>ا۟</> <h>ٱ</><l>ل</><g>نِّ</><o>سَآ</>ءَ كَرْ<d>هًۭا ۖ وَ</>لَا تَعْضُلُوهُ<g>نَّ</> لِتَذْهَبُو<s>ا۟</> بِبَعْضِ <o>مَآ</> ءَاتَيْتُمُوهُ<g>نَّ</> إِ<o>لَّآ</> <d>أَن يَ</>أْتِينَ بِ<m>فَٰ</>حِشَ<d>ةٍۢ مُّ</>بَيِّنَ<d>ةٍۢ ۚ وَ</>عَاشِرُوهُ<g>نَّ</> بِ<h>ٱ</>لْمَعْرُوفِ ۚ فَإِ<k>ن كَ</>رِهْتُمُوهُ<g>نَّ</> فَعَسَ<o>ىٰٓ</> أَ<k>ن تَ</>كْرَهُو<s>ا۟</> شَ<d>يْـًۭٔا وَ</>يَ<q>جْ</>عَلَ <h>ٱ</>للَّهُ فِيهِ خَيْ<k>رًۭا كَ</>ثِيرًۭا"},{"n":20,"w":[["وَإِنْ","wa-in","And if","এবং যদি"],["أَرَدتُّمُ","aradttumu","you intend","তোমরা ইচ্ছা করে থাক"],["ٱسْتِبْدَالَ","is'tib'dāla","replacing","পরিবর্তন করতে"],["زَوْجٍۢ","zawjin","a wife","এক স্ত্রী"],["مَّكَانَ","makāna","(in) place","জায়গায়"],["زَوْجٍۢ","zawjin","(of) a wife","(অন্য) এক স্ত্রীর"],["وَءَاتَيْتُمْ","waātaytum","and you have given","এবং তোমরা দিয়েছ"],["إِحْدَىٰهُنَّ","iḥ'dāhunna","one of them","তাদের কাউকে"],["قِنطَارًۭا","qinṭāran","heap (of gold)","অগাধ সম্পদ"],["فَلَا","falā","then (do) not","না তবুও"],["تَأْخُذُوا۟","takhudhū","take away","তোমরা গ্রহণ করবে"],["مِنْهُ","min'hu","from it","তা থেকে"],["شَيْـًٔا ۚ","shayan","anything","কোন কিছু"],["أَتَأْخُذُونَهُۥ","atakhudhūnahu","Would you take it","কি তা তোমরা নিবে"],["بُهْتَـٰنًۭا","buh'tānan","(by) slander","দোষারোপ (করে)"],["وَإِثْمًۭا","wa-ith'man","and a sin","ও পাপ (করে)"],["مُّبِينًۭا","mubīnan","open","সুস্পষ্ট"]],"t":"وَإِنْ أَرَ<j>د</>تُّمُ <h>ٱ</>سْتِ<q>بْ</>دَالَ زَوْ<d>جٍۢ مَّ</>كَانَ زَوْ<d>جٍۢ وَ</>ءَاتَيْتُمْ إِحْدَ<m>ىٰ</>هُ<g>نَّ</> قِ<k>نطَارًۭا فَ</>لَا تَأْخُذُو<s>ا۟</> مِنْهُ شَيْـًٔا ۚ أَتَأْخُذُونَهُ<m>ۥ</> بُهْ<m>تَٰ</><d>نًۭا وَ</>إِثْ<d>مًۭا مُّ</>بِينًۭا"},{"n":21,"w":[["وَكَيْفَ","wakayfa","And how","এবং কিরূপে"],["تَأْخُذُونَهُۥ","takhudhūnahu","could you take it","তা তোমরা গ্রহণ করবে"],["وَقَدْ","waqad","when surely","অথচ নিশ্চয়"],["أَفْضَىٰ","afḍā","has gone ","স্বাদ নিয়েছ (স্ত্রী মিলনের)"],["بَعْضُكُمْ","ba‘ḍukum","one of you","তোমাদের একে"],["إِلَىٰ","ilā","to","থেকে"],["بَعْضٍۢ","ba‘ḍin","another","অপরের"],["وَأَخَذْنَ","wa-akhadhna","and they have taken","এবং তারা নিয়েছে"],["مِنكُم","minkum","from you","তোমাদের থেকে"],["مِّيثَـٰقًا","mīthāqan","covenant","প্রতিশ্রুতি"],["غَلِيظًۭا","ghalīẓan","strong","দৃঢ়"]],"t":"وَكَيْفَ تَأْخُذُونَهُ<m>ۥ</> وَقَ<q>دْ</> أَفْضَىٰ بَعْضُكُمْ إِلَىٰ بَعْ<d>ضٍۢ وَ</>أَخَذْنَ مِ<k>نكُ</><y>م مِّ</>ي<m>ثَٰ</>قًا غَلِيظًۭا"},{"n":22,"w":[["وَلَا","walā","And (do) not","এবং না"],["تَنكِحُوا۟","tankiḥū","marry","তোমরা বিবাহ করো"],["مَا","mā","whom","যাদের"],["نَكَحَ","nakaḥa","married","বিবাহ করেছে"],["ءَابَآؤُكُم","ābāukum","your fathers","তোমাদের পিতা (পিতামহ ইত্যাদি)"],["مِّنَ","mina","of","মধ্য হতে"],["ٱلنِّسَآءِ","l-nisāi","the women","স্ত্রীলোকদের"],["إِلَّا","illā","except","কিন্তু"],["مَا","mā","what","যা"],["قَدْ","qad","has","হয়েছে"],["سَلَفَ ۚ","salafa","passed before","বিগত (সেটা ধর্তব্য নয়)"],["إِنَّهُۥ","innahu","indeed it","তা নিশ্চয়ই"],["كَانَ","kāna","was","হল"],["فَـٰحِشَةًۭ","fāḥishatan","an immorality","অশ্লীল কাজ"],["وَمَقْتًۭا","wamaqtan","and hateful","ও বড়ই অপছন্দনীয়"],["وَسَآءَ","wasāa","and (an) evil","এবং নিকৃষ্ট"],["سَبِيلًا","sabīlan","way","আচরণ"]],"t":"وَلَا تَ<k>نكِ</>حُو<s>ا۟</> مَا نَكَحَ ءَا<o>بَآ</>ؤُ<y>كُم مِّ</>نَ <h>ٱ</><l>ل</><g>نِّ</><o>سَآ</>ءِ إِلَّا مَا قَ<q>دْ</> سَلَفَ ۚ إِ<g>نَّ</>هُ<m>ۥ</> كَانَ <m>فَٰ</>حِشَ<d>ةًۭ وَ</>مَ<q>قْ</><d>تًۭا وَ</><o>سَآ</>ءَ سَبِيلًا"},{"n":23,"w":[["حُرِّمَتْ","ḥurrimat","Forbidden","নিষিদ্ধ করা হয়েছে (বিবাহ)"],["عَلَيْكُمْ","‘alaykum","to you","তোমাদের উপর"],["أُمَّهَـٰتُكُمْ","ummahātukum","(are) your mothers","তোমাদের মাতাদেরকে"],["وَبَنَاتُكُمْ","wabanātukum","and your daughters","ও তোমাদের কন্যাদেরকে"],["وَأَخَوَٰتُكُمْ","wa-akhawātukum","and your sisters","ও তোমাদের বোনদেরকে"],["وَعَمَّـٰتُكُمْ","wa‘ammātukum","and your father's sisters","ও তোমাদের ফুফুদেরকে"],["وَخَـٰلَـٰتُكُمْ","wakhālātukum","and your mother's sisters","ও তোমাদের খালাদেরকে"],["وَبَنَاتُ","wabanātu","and daughters","ও কন্যাদেরকে"],["ٱلْأَخِ","l-akhi","(of) brothers","ভাই এর"],["وَبَنَاتُ","wabanātu","and daughters","ও কন্যাদেরকে"],["ٱلْأُخْتِ","l-ukh'ti","(of) sisters","বোনের"],["وَأُمَّهَـٰتُكُمُ","wa-ummahātukumu","and (the) mothers","ও তোমাদের (সেই সব) মাতাদেরকে"],["ٱلَّـٰتِىٓ","allātī","who","যারা"],["أَرْضَعْنَكُمْ","arḍa‘nakum","nurs