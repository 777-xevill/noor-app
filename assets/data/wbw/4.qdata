<l>ل</>ثُّمُنُ مِ<g>مَّ</>ا تَرَكْ<y>تُم ۚ مِّ</><i>نۢ بَ</>عْدِ وَصِيَّ<k>ةٍۢ تُ</>وصُونَ بِ<o>هَآ</> أَوْ دَيْ<d>نٍۢ ۗ وَ</>إِ<k>ن كَ</>انَ رَجُ<d>لٌۭ يُ</>ورَثُ كَ<m>لَٰ</>لَةً أَوِ <h>ٱ</>مْرَأَ<d>ةٌۭ وَ</>لَهُ<o>ۥٓ</> أَخٌ أَوْ أُخْ<k>تٌۭ فَ</>لِكُلِّ <m>وَٰ</>حِ<d>دٍۢ مِّ</>نْهُمَا <h>ٱ</><l>ل</>سُّدُسُ ۚ فَإِ<k>ن كَ</>ا<o>نُوٓ</><s>ا۟</> أَكْثَرَ مِ<k>ن ذَٰ</>لِكَ فَهُمْ شُرَ<o>كَآ</>ءُ فِى <h>ٱ</><l>ل</>ثُّلُثِ ۚ <i>مِنۢ بَ</>عْدِ وَصِيَّ<d>ةٍۢ يُ</>وصَىٰ بِ<o>هَآ</> أَوْ دَيْنٍ غَيْرَ مُ<n>ضَآ</><d>رٍّۢ ۚ وَ</>صِيَّ<d>ةًۭ مِّ</>نَ <h>ٱ</>للَّهِ ۗ وَ<h>ٱ</>للَّهُ عَلِيمٌ حَ<p>لِي</>مٌۭ"},{"n":13,"w":[["تِلْكَ","til'ka","These","এইসব"],["حُدُودُ","ḥudūdu","(are the) limits","সীমাসমূহ"],["ٱللَّهِ ۚ","l-lahi","(of) Allah","আল্লাহর"],["وَمَن","waman","and whoever","এবং যে"],["يُطِعِ","yuṭi‘i","obeys","আনুগত্য করবে"],["ٱللَّهَ","l-laha","Allah","আল্লাহর"],["وَرَسُولَهُۥ","warasūlahu","and His Messenger","ও তাঁর রাসূলের"],["يُدْخِلْهُ","yud'khil'hu","He will admit him","তিনি তাকে প্রবেশ করাবেন"],["جَنَّـٰتٍۢ","jannātin","(to) Gardens","জান্নাতে"],["تَجْرِى","tajrī","flows","প্রবাহিত হয়"],["مِن","min","from","(থেকে)"],["تَحْتِهَا","taḥtihā","underneath them","তার পাদদেশে"],["ٱلْأَنْهَـٰرُ","l-anhāru","the rivers ","ঝর্ণাধারা"],["خَـٰلِدِينَ","khālidīna","(will) abide forever","তারা স্থায়ী হবে"],["فِيهَا ۚ","fīhā","in it","তার মধ্যে"],["وَذَٰلِكَ","wadhālika","And that","এবং এটাই"],["ٱلْفَوْزُ","l-fawzu","(is) the success","সাফল্য"],["ٱلْعَظِيمُ","l-‘aẓīmu","[the] great","বিরাট"]],"t":"تِلْكَ حُدُودُ <h>ٱ</>للَّهِ ۚ وَ<d>مَن يُ</>طِعِ <h>ٱ</>للَّهَ وَرَسُولَهُ<m>ۥ</> يُ<q>دْ</>خِلْهُ جَ<g>نَّٰ</><k>تٍۢ تَ</><q>جْ</>رِى مِ<k>ن تَ</>حْتِهَا <h>ٱ</>لْأَنْ<m>هَٰ</>رُ <m>خَٰ</>لِدِينَ فِيهَا ۚ وَ<m>ذَٰ</>لِكَ <h>ٱ</>لْفَوْزُ <h>ٱ</>لْعَ<p>ظِي</>مُ"},{"n":14,"w":[["وَمَن","waman","And whoever","এবং যে"],["يَعْصِ","ya‘ṣi","disobeys","অবাধ্য হবে"],["ٱللَّهَ","l-laha","Allah","আল্লাহর"],["وَرَسُولَهُۥ","warasūlahu","and His Messenger","ও তাঁর রাসূলের"],["وَيَتَعَدَّ","wa