has) bestowed","বিশিষ্টতা দিয়েছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["بَعْضَهُمْ","ba‘ḍahum","some of them","তাদের কাউকে"],["عَلَىٰ","‘alā","over","উপর"],["بَعْضٍۢ","ba‘ḍin","others","কারও"],["وَبِمَآ","wabimā","and because","এবং এ জন্যও যে"],["أَنفَقُوا۟","anfaqū","they spend","তারা খরচ করে"],["مِنْ","min","from","থেকে"],["أَمْوَٰلِهِمْ ۚ","amwālihim","their wealth","তাদের মাল সম্পদ"],["فَٱلصَّـٰلِحَـٰتُ","fal-ṣāliḥātu","So the righteous women","অতএব (যারা) সৎ মহিলা"],["قَـٰنِتَـٰتٌ","qānitātun","(are) obedient","আনুগত্য পরায়না (হয়ে থাকে)"],["حَـٰفِظَـٰتٌۭ","ḥāfiẓātun","guarding","(তারা) রক্ষণাবেক্ষণ কারিনী"],["لِّلْغَيْبِ","lil'ghaybi","in the unseen","লোক চক্ষুর অন্তরালে"],["بِمَا","bimā","that which","ঐ বিষয়ে যা"],["حَفِظَ","ḥafiẓa","(orders) them to guard","হিফাজত করেছেন"],["ٱللَّهُ ۚ","l-lahu","(by) Allah","আল্লাহ"],["وَٱلَّـٰتِى","wa-allātī","And those (from) whom","এবং যাদেরকে"],["تَخَافُونَ","takhāfūna","you fear","তোমরা ভয় কর"],["نُشُوزَهُنَّ","nushūzahunna","their ill-conduct","তাদের অবাধ্যতার"],["فَعِظُوهُنَّ","fa‘iẓūhunna","then advise them","তোমরা তবে উপদেশ দাও তাদেরকে"],["وَٱهْجُرُوهُنَّ","wa-uh'jurūhunna","and forsake them","ও তাদেরকে তোমরা ত্যাগ কর (একাকী)"],["فِى","fī","in","উপর"],["ٱلْمَضَاجِعِ","l-maḍāji‘i","the bed","শয্যার"],["وَٱضْرِبُوهُنَّ ۖ","wa-iḍ'ribūhunna","and [finally] strike them","ও তোমরা মার তাদেরকে"],["فَإِنْ","fa-in","Then if","যদি অতঃপর"],["أَطَعْنَكُمْ","aṭa‘nakum","they obey you","তোমাদের তারা অনুগত হয়"],["فَلَا","falā","then (do) not","না তবে"],["تَبْغُوا۟","tabghū","seek","তোমরা তালাশ করো"],["عَلَيْهِنَّ","‘alayhinna","against them","তাদের বিরুদ্ধে"],["سَبِيلًا ۗ","sabīlan","a way","কোন বাহানা"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["كَانَ","kāna","is","হলেন"],["عَلِيًّۭا","‘aliyyan","Most High","উচ্চতর"],["كَبِيرًۭا","kabīran","Most Great","শ্রেষ্ট"]],"t":"ٱ<l>ل</>رِّجَالُ قَ<m>وَّٰ</>مُونَ عَلَى <h>ٱ</><l>ل</><g>نِّ</><o>سَآ</>ءِ بِمَا فَضَّلَ <h>ٱ</>للَّهُ بَعْضَهُمْ عَلَىٰ بَعْ<d>ضٍۢ وَ</>بِ<o>مَآ</> أَ<k>نفَ</>قُو<s>ا۟</> مِنْ أَمْ<m>وَٰ</>لِهِمْ ۚ فَ<h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تُ <m>قَٰنِتَٰ</>تٌ <m>حَٰفِظَٰ</><w>تٌۭ لِّ</>لْغَيْبِ بِمَا حَفِظَ <h>ٱ</>للَّهُ ۚ وَ<h>ٱ</><m>لَّٰ</>تِى تَخَافُونَ نُشُوزَهُ<g>نَّ</> فَعِظُوهُ<g>نَّ</> وَ<h>ٱ</>هْجُرُوهُ<g>نَّ</> فِى <h>ٱ</>لْمَضَاجِعِ وَ<h>ٱ</>ضْرِبُوهُ<g>نَّ</> ۖ فَإِنْ أَطَعْنَكُمْ فَلَا تَ<q>بْ</>غُو<s>ا۟</> عَلَيْهِ<g>نَّ</> سَبِيلًا ۗ إِ<g>نَّ</> <h>ٱ</>للَّهَ كَانَ عَلِ<k>يًّۭا كَ</>بِيرًۭا"},{"n":35,"w":[["وَإِنْ","wa-in","And if","এবং যদি"],["خِفْتُمْ","khif'tum","you fear","তোমরা আশঙ্কা কর"],["شِقَاقَ","shiqāqa","a dissension","সম্পর্কচ্ছেদের"],["بَيْنِهِمَا","baynihimā","between (the) two of them","তাদের দুজনের মাঝে"],["فَٱبْعَثُوا۟","fa-ib'‘athū","then send","তোমরা তবে নিযুক্ত কর"],["حَكَمًۭا","ḥakaman","an arbitrator","একজন সালিশ"],["مِّنْ","min","from","মধ্যহতে"],["أَهْلِهِۦ","ahlihi","his family","তাঁর পরিবারের (অর্থাৎ স্বামীর)"],["وَحَكَمًۭا","waḥakaman","and an arbitrator","ও একজন সালিশ"],["مِّنْ","min","from","মধ্যে হতে"],["أَهْلِهَآ","ahlihā","her family","তার পরিবারের (অর্থাৎ স্ত্রীর)"],["إِن","in","If","যদি"],["يُرِيدَآ","yurīdā","they both wish","দুজনে চায়"],["إِصْلَـٰحًۭا","iṣ'lāḥan","reconciliation","মীমাংসা"],["يُوَفِّقِ","yuwaffiqi","will cause reconciliation","তৌফিক দিবেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["بَيْنَهُمَآ ۗ","baynahumā","between both of them","তাদের দুজনের মাঝে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["كَانَ","kāna","is","হলেন"],["عَلِيمًا","‘alīman","All-Knower","সর্বজ্ঞ"],["خَبِيرًۭا","khabīran","All-Aware","খুব অবহিত"]],"t":"وَإِنْ خِفْتُمْ شِقَاقَ بَيْنِهِمَا فَ<h>ٱ</><q>بْ</>عَثُو<s>ا۟</> حَكَ<d>مًۭا مِّ</>نْ أَهْلِ<m>هِۦ</> وَحَكَ<d>مًۭا مِّ</>نْ أَهْلِ<o>هَآ</> <d>إِن يُ</>رِي<o>دَآ</> إِصْ<m>لَٰ</><d>حًۭا يُ</>وَفِّقِ <h>ٱ</>للَّهُ بَيْنَهُ<o>مَآ ۗ</> إِ<g>نَّ</> <h>ٱ</>للَّهَ كَانَ عَلِيمًا خَبِيرًۭا"},{"n":36,"w":[["۞ وَٱعْبُدُوا۟","wa-u‘'budū","And worship","এবং তোমরা ইবাদাত কর"],["ٱللَّهَ","l-laha","Allah","আল্লাহর"],["وَلَا","walā","And (do) not","ও না"],["تُشْرِكُوا۟","tush'rikū","associate","তোমরা শিরক করো"],["بِهِۦ","bihi","with Him","তাঁর সাথে"],["شَيْـًۭٔا ۖ","shayan","anything","কোন কিছুকে"],["وَبِٱلْوَٰلِدَيْنِ","wabil-wālidayni","and to the parents","ও পিতা মাতার সাথে"],["إِحْسَـٰنًۭا","iḥ'sānan","(do) good","সৎ ব্যবহার (করবে)"],["وَبِذِى","wabidhī","and with","এবং সাথে"],["ٱلْقُرْبَىٰ","l-qur'bā","the relatives","আত্মীয়-স্বজনদের সাথে"],["وَٱلْيَتَـٰمَىٰ","wal-yatāmā","and the orphans","ও ইয়াতীমদের"],["وَٱلْمَسَـٰكِينِ","wal-masākīni","and the needy","ও অভাবগ্রস্তদের"],["وَٱلْجَارِ","wal-jāri","and the neighbor","ও প্রতিবেশী"],["ذِى","dhī","(who is)","(চিরকাল)"],["ٱلْقُرْبَىٰ","l-qur'bā","near","আত্মীয়"],["وَٱلْجَارِ","wal-jāri","and the neighbor","ও প্রতিবেশী"],["ٱلْجُنُبِ","l-junubi","(who is) farther away","দূরের (অর্থাৎ অনাত্মীয়ও)"],["وَٱلصَّاحِبِ","wal-ṣāḥibi","and the companion","ও সাথী"],["بِٱلْجَنۢبِ","bil-janbi","by your side","পাশাপাশি চলার"],["وَٱبْنِ","wa-ib'ni","and the","ও"],["ٱلسَّبِيلِ","l-sabīli","traveler","পথ চারী"],["وَمَا","wamā","and what","ও যা"],["مَلَكَتْ","malakat","possess[ed]","মালিক হয়েছে"],["أَيْمَـٰنُكُمْ ۗ","aymānukum","your right hands","তোমাদের ডান হাত (সবার সাথে ভাল ব্যবহার করবে)"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَا","lā","(does) not","না"],["يُحِبُّ","yuḥibbu","love","পছন্দ করেন"],["مَن","man","(the one) who","(তাকে) যে"],["كَانَ","kāna","is","হল"],["مُخْتَالًۭا","mukh'tālan","[a] proud","দাম্ভিক"],["فَخُورًا","fakhūran","(and) [a] boastful","গর্বকারী"]],"t":"۞ وَ<h>ٱ</>عْبُدُو<s>ا۟</> <h>ٱ</>للَّهَ وَلَا تُشْرِكُو<s>ا۟</> بِ<m>هِۦ</> شَ<d>يْـًۭٔا ۖ وَ</>بِ<h>ٱ</>لْ<m>وَٰ</>لِدَيْنِ إِحْ<m>سَٰ</><d>نًۭا وَ</>بِذِى <h>ٱ</>لْقُرْبَىٰ وَ<h>ٱ</>لْيَ<m>تَٰ</>مَىٰ وَ<h>ٱ</>لْمَ<m>سَٰ</>كِينِ وَ<h>ٱ</>لْجَارِ ذِى <h>ٱ</>لْقُرْبَىٰ وَ<h>ٱ</>لْجَارِ <h>ٱ</>لْجُنُبِ وَ<h>ٱ</><l>ل</>صَّاحِبِ بِ<h>ٱ</>لْجَ<i>نۢبِ</> وَ<h>ٱ</><q>بْ</>نِ <h>ٱ</><l>ل</>سَّبِيلِ وَمَا مَلَكَتْ أَيْ<m>مَٰ</>نُكُمْ ۗ إِ<g>نَّ</> <h>ٱ</>للَّهَ لَا يُحِبُّ مَ<k>ن كَ</>انَ مُخْتَالًۭ<k>ا فَ</>خُورًا"},{"n":37,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["يَبْخَلُونَ","yabkhalūna","are stingy","কৃপণতা করে"],["وَيَأْمُرُونَ","wayamurūna","and order","ও নির্দেশ দেয়"],["ٱلنَّاسَ","l-nāsa","the people","মানুষকে"],["بِٱلْبُخْلِ","bil-bukh'li","[of] stinginess","কৃপণতার জন্য"],["وَيَكْتُمُونَ","wayaktumūna","and hide","ও গোপন করে"],["مَآ","mā","what","যা"],["ءَاتَىٰهُمُ","ātāhumu","(has) given them","তাদের দিয়েছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["مِن","min","of","হতে"],["فَضْلِهِۦ ۗ","faḍlihi","His Bounty ","তাঁর অনুগ্রহ"],["وَأَعْتَدْنَا","wa-a‘tadnā","and We (have) prepared","এবং আমরা প্রস্তুত করে রেখেছি"],["لِلْكَـٰفِرِينَ","lil'kāfirīna","for the disbelievers","এমন অকৃতজ্ঞদের জন্য"],["عَذَابًۭا","‘adhāban","a punishment","আজাব"],["مُّهِينًۭا","muhīnan","humiliating","অপমানকর"]],"t":"ٱلَّذِينَ يَ<q>بْ</>خَلُونَ وَيَأْمُرُونَ <h>ٱ</><l>ل</><g>نَّ</>اسَ بِ<h>ٱ</>لْبُخْلِ وَيَكْتُمُونَ <o>مَآ</> ءَاتَ<m>ىٰ</>هُمُ <h>ٱ</>للَّهُ مِ<k>ن فَ</>ضْلِ<m>هِۦ</> ۗ وَأَعْتَ<q>دْ</>نَا لِلْ<m>كَٰ</>فِرِينَ عَذَا<d>بًۭا مُّ</>هِينًۭا"},{"n":38,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["يُنفِقُونَ","yunfiqūna","spend","খুরচ করে"],["أَمْوَٰلَهُمْ","amwālahum","their wealth","তাদের সম্পদ গুলো"],["رِئَآءَ","riāa","to be seen","দেখানোর জন্য"],["ٱلنَّاسِ","l-nāsi","(by) the people","লোকদেরকে"],["وَلَا","walā","and not","এবং না"],["يُؤْمِنُونَ","yu'minūna","they believe","ঈমান আনে"],["بِٱللَّهِ","bil-lahi","in Allah","আল্লাহর উপর"],["وَلَا","walā","and not","এবং না"],["بِٱلْيَوْمِ","bil-yawmi","in the Day","দিনের উপর"],["ٱلْـَٔاخِرِ ۗ","l-ākhiri","the Last","আখিরাতের"],["وَمَن","waman","and whoever","এবং যার"],["يَكُنِ","yakuni","has","হবে"],["ٱلشَّيْطَـٰنُ","l-shayṭānu","the Shaitaan","শয়তান"],["لَهُۥ","lahu","for him","তার জন্য"],["قَرِينًۭا","qarīnan","(as) companion ","সঙ্গী"],["فَسَآءَ","fasāa","then evil","অতি অতঃপর খারাপ"],["قَرِينًۭا","qarīnan","(is he as) a companion","সঙ্গী (তার জুটেছে)"]],"t":"وَ<h>ٱ</>لَّذِينَ يُ<k>نفِ</>قُونَ أَمْ<m>وَٰ</>لَهُمْ رِ<o>ئَآ</>ءَ <h>ٱ</><l>ل</><g>نَّ</>اسِ وَلَا يُؤْمِنُونَ بِ<h>ٱ</>للَّهِ وَلَا بِ<h>ٱ</>لْيَوْمِ <h>ٱ</>لْءَاخِرِ ۗ وَ<d>مَن يَ</>كُنِ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نُ لَهُ<m>ۥ</> قَرِي<k>نًۭا فَ</><o>سَآ</>ءَ قَرِينًۭا"},{"n":39,"w":[["وَمَاذَا","wamādhā","And what","এবং কি (হত)"],["عَلَيْهِمْ","‘alayhim","(is) against them","তাদের উপর"],["لَوْ","law","if","যদি"],["ءَامَنُوا۟","āmanū","they believed","তারা ঈমান আনত"],["بِٱللَّهِ","bil-lahi","in Allah","আল্লাহর উপর"],["وَٱلْيَوْمِ","wal-yawmi","and the Day","ও দিনে"],["ٱلْـَٔاخِرِ","l-ākhiri","the Last","আখিরাতের"],["وَأَنفَقُوا۟","wa-anfaqū","and spent","ও তারা খরচ করত"],["مِمَّا","mimmā","from what","তা হতে যা"],["رَزَقَهُمُ","razaqahumu","(has) provided them","তাদের রিয্‌ক দিয়েছেন"],["ٱللَّهُ ۚ","l-lahu","Allah","আল্লাহ"],["وَكَانَ","wakāna","And is","এবং হলেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["بِهِمْ","bihim","about them","তাদের সম্পর্কে"],["عَلِيمًا","‘alīman","All-Knower","খুব অবগত"]],"t":"وَمَاذَا عَلَيْهِمْ لَوْ ءَامَنُو<s>ا۟</> بِ<h>ٱ</>للَّهِ وَ<h>ٱ</>لْيَوْمِ <h>ٱ</>لْءَاخِرِ وَأَ<k>نفَ</>قُو<s>ا۟</> مِ<g>مَّ</>ا رَزَقَهُمُ <h>ٱ</>للَّهُ ۚ وَكَانَ <h>ٱ</>للَّهُ بِهِمْ عَلِيمًا"},{"n":40,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَا","lā","(does) not","না"],["يَظْلِمُ","yaẓlimu","wrong","জুলুম করেন"],["مِثْقَالَ","mith'qāla","(as much as) weight","পরিমাণ (কারও উপরে)"],["ذَرَّةٍۢ ۖ","dharratin","(of) an atom","অনু"],["وَإِن","wa-in","And if","এবং যদি"],["تَكُ","taku","there is","হয়"],["حَسَنَةًۭ","ḥasanatan","a good","নেকী (কারও)"],["يُضَـٰعِفْهَا","yuḍā‘if'hā","He doubles it","তা দ্বিগুন করেন (তার জন্য)"],["وَيُؤْتِ","wayu'ti","and gives","এবং দেন"],["مِن","min","from","থেকে"],["لَّدُنْهُ","ladun'hu","near Him","তাঁর নিক"],["أَجْرًا","ajran","a reward","পুরস্কার"],["عَظِيمًۭا","‘aẓīman","great","বিরাট"]],"t":"إِ<g>نَّ</> <h>ٱ</>للَّهَ لَا يَظْلِمُ مِثْقَالَ ذَرَّ<d>ةٍۢ ۖ وَ</>إِ<k>ن تَ</>كُ حَسَنَ<d>ةًۭ يُ</><m>ضَٰ</>عِفْهَا وَيُؤْتِ <w>مِن لَّ</>دُنْهُ أَ<q>جْ</>رًا عَظِيمًۭا"},{"n":41,"w":[["فَكَيْفَ","fakayfa","So how (will it be)","কেমন অতঃপর (হবে)"],["إِذَا","idhā","when","যখন"],["جِئْنَا","ji'nā","We bring","আমরা হাজির করব"],["مِن","min","from","মধ্য হতে"],["كُلِّ","kulli","every","প্রত্যেক"],["أُمَّةٍۭ","ummatin","nation","উম্মতের"],["بِشَهِيدٍۢ","bishahīdin","a witness","একজন সাক্ষী"],["وَجِئْنَا","waji'nā","and We bring","এবং আমরা হাজির করব"],["بِكَ","bika","you","তোমাকে"],["عَلَىٰ","‘alā","against","উপর"],["هَـٰٓؤُلَآءِ","hāulāi","these (people)","তাদের"],["شَهِيدًۭا","shahīdan","(as) a witness","সাক্ষী হিসেবে"]],"t":"فَكَيْفَ إِذَا جِئْنَا مِ<k>ن كُ</>لِّ أُ<g>مَّ</><i>ةٍۭ بِ</>شَهِي<d>دٍۢ وَ</>جِئْنَا بِكَ عَلَىٰ <o>هَٰٓؤُلَآ</>ءِ شَهِيدًۭا"},{"n":42,"w":[["يَوْمَئِذٍۢ","yawma-idhin","(On) that Day","সে দিন"],["يَوَدُّ","yawaddu","will wish","কামনা করবে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieved","কুফুরী করেছে"],["وَعَصَوُا۟","wa‘aṣawū","and disobeyed","ও অবাধ্যতা করেছে"],["ٱلرَّسُولَ","l-rasūla","the Messenger","রাসূলের"],["لَوْ","law","if","যদি"],["تُسَوَّىٰ","tusawwā","was leveled","মিশিয়ে দেয়া হত"],["بِهِمُ","bihimu","with them","তাদেরকে"],["ٱلْأَرْضُ","l-arḍu","the earth","জমিনে"],["وَلَا","walā","and not","কিন্তু (তবুও) না"],["يَكْتُمُونَ","yaktumūna","they will (be able to) hide","গোপন করতে পারবে"],["ٱللَّهَ","l-laha","(from) Allah","আল্লাহ (থেকে)"],["حَدِيثًۭا","ḥadīthan","(any) statement","কোন-কথা"]],"t":"يَوْمَئِ<d>ذٍۢ يَ</>وَدُّ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> وَعَصَوُ<s>ا۟</> <h>ٱ</><l>ل</>رَّسُولَ لَوْ تُسَوَّىٰ بِهِمُ <h>ٱ</>لْأَرْضُ وَلَا يَكْتُمُونَ <h>ٱ</>للَّهَ حَدِيثًۭا"},{"n":43,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you","ওহে"],["ٱلَّذِينَ","alladhīna","who","যারা"],["ءَامَنُوا۟","āmanū","believe[d]","ঈমান এনেছ"],["لَا","lā","(Do) not","না"],["تَقْرَبُوا۟","taqrabū","go near","তোমরা কাছে যেয়ো"],["ٱلصَّلَوٰةَ","l-ṣa