َن","an","to","(যে)"],["تَنكِحُوهُنَّ","tankiḥūhunna","marry them","তোমরা বিবাহ করতে তাদেরকে"],["وَٱلْمُسْتَضْعَفِينَ","wal-mus'taḍ‘afīna","and the ones who are weak","এবং অসহায়"],["مِنَ","mina","of","(থেকে)"],["ٱلْوِلْدَٰنِ","l-wil'dāni","the children","শিশুদের (সম্পর্কেও)"],["وَأَن","wa-an","and to","এবং (এও নির্দেশ দিচ্ছেন) যে"],["تَقُومُوا۟","taqūmū","stand","তোমরা কায়েম থাক"],["لِلْيَتَـٰمَىٰ","lil'yatāmā","for orphans","ইয়াতীমদের জন্য"],["بِٱلْقِسْطِ ۚ","bil-qis'ṭi","with justice","ইনসাফের সাথে"],["وَمَا","wamā","And whatever","এবং যা"],["تَفْعَلُوا۟","taf‘alū","you do","তোমরা কর"],["مِنْ","min","of","(থেকে)"],["خَيْرٍۢ","khayrin","good","কল্যাণ"],["فَإِنَّ","fa-inna","then indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["كَانَ","kāna","is","হলেন"],["بِهِۦ","bihi","about it","সে ব্যাপারে"],["عَلِيمًۭا","‘alīman","All-Knowing","সবিশেষ অবহিত"]],"t":"وَيَسْتَفْتُونَكَ فِى <h>ٱ</><l>ل</><g>نِّ</><o>سَآ</>ءِ ۖ قُلِ <h>ٱ</>للَّهُ يُفْتِيكُمْ فِيهِ<g>نَّ</> وَمَا يُتْلَىٰ عَلَيْكُمْ فِى <h>ٱ</>لْكِ<m>تَٰ</>بِ فِى يَ<m>تَٰ</>مَى <h>ٱ</><l>ل</><g>نِّ</><o>سَآ</>ءِ <h>ٱ</><m>لَّٰ</>تِى لَا تُؤْتُونَهُ<g>نَّ</> مَا كُتِبَ لَهُ<g>نَّ</> وَتَرْغَبُونَ أَ<k>ن تَنكِ</>حُوهُ<g>نَّ</> وَ<h>ٱ</>لْمُسْتَضْعَفِينَ مِنَ <h>ٱ</>لْوِلْ<m>دَٰ</>نِ وَأَ<k>ن تَ</>قُومُو<s>ا۟</> لِلْيَ<m>تَٰ</>مَىٰ بِ<h>ٱ</>لْقِسْطِ ۚ وَمَا تَفْعَلُو<s>ا۟</> مِنْ خَيْ<k>رٍۢ فَ</>إِ<g>نَّ</> <h>ٱ</>للَّهَ كَانَ بِ<m>هِۦ</> عَلِيمًۭا"},{"n":128,"w":[["وَإِنِ","wa-ini","And if","এবং যদি"],["ٱمْرَأَةٌ","im'ra-atun","a woman","কোন স্ত্রী"],["خَافَتْ","khāfat","fears","ভয় করে"],["مِنۢ","min","from","থেকে"],["بَعْلِهَا","ba‘lihā","her husband","তার স্বামীর"],["نُشُوزًا","nushūzan","ill-conduct","দুর্ব্যবহারের"],["أَوْ","aw","or","বা"],["إِعْرَاضًۭا","i‘'rāḍan","desertion","উপেক্ষার"],["فَلَا","falā","then (there is) no","নাই তবে"],["جُنَاحَ","junāḥa","sin","কোন দোষ"],["عَلَيْهِمَآ","‘alayhimā","on both of them","তাদের দুজনের উপর"],["أَن","an","that","যে"],["يُصْلِحَا","yuṣ'liḥā","they make terms o