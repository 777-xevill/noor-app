,["نَّجْوَىٰهُمْ","najwāhum","their secret talk","তাদের গোপন পরামর্শের"],["إِلَّا","illā","except","তবে (দোষ নেই তার শলাপরামর্শে)"],["مَنْ","man","(he) who","যে"],["أَمَرَ","amara","orders","নির্দেশ দেয়"],["بِصَدَقَةٍ","biṣadaqatin","charity","দান খয়রাতের"],["أَوْ","aw","or","বা"],["مَعْرُوفٍ","ma‘rūfin","kindness","সৎকাজের"],["أَوْ","aw","or","বা"],["إِصْلَـٰحٍۭ","iṣ'lāḥin","conciliation","সন্ধি স্থাপনের"],["بَيْنَ","bayna","between","মাঝে"],["ٱلنَّاسِ ۚ","l-nāsi","the people","লোকদের"],["وَمَن","waman","And who","এবং যে"],["يَفْعَلْ","yaf‘al","does","করে"],["ذَٰلِكَ","dhālika","that","এরূপ"],["ٱبْتِغَآءَ","ib'tighāa","seeking","সন্ধানে"],["مَرْضَاتِ","marḍāti","pleasure","সন্তুষ্টির"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["فَسَوْفَ","fasawfa","then soon","শীঘ্রই সেক্ষেত্রে"],["نُؤْتِيهِ","nu'tīhi","We will give him","তাকে আমরা দেব"],["أَجْرًا","ajran","a reward","প্রতিফল"],["عَظِيمًۭا","‘aẓīman","great","বিরাট"]],"t":"۞ لَّا خَيْرَ فِى كَثِي<d>رٍۢ مِّن نَّ</><q>جْ</>وَ<m>ىٰ</>هُمْ إِلَّا مَنْ أَمَرَ بِصَدَقَةٍ أَوْ مَعْرُوفٍ أَوْ إِصْ<m>لَٰ</><i>حٍۭ بَ</>يْنَ <h>ٱ</><l>ل</><g>نَّ</>اسِ ۚ وَ<d>مَن يَ</>فْعَلْ <m>ذَٰ</>لِكَ <h>ٱ</><q>بْ</>تِ<o>غَآ</>ءَ مَرْضَاتِ <h>ٱ</>للَّهِ فَسَوْفَ نُؤْتِيهِ أَ<q>جْ</>رًا عَظِيمًۭا"},{"n":115,"w":[["وَمَن","waman","And whoever","এবং যে"],["يُشَاقِقِ","yushāqiqi","opposes","বিরুদ্ধাচারণ করে"],["ٱلرَّسُولَ","l-rasūla","the Messenger","রাসূলের"],["مِنۢ","min","from","(থেকে)"],["بَعْدِ","ba‘di","after","এরপরেও"],["مَا","mā","what","যা"],["تَبَيَّنَ","tabayyana","(has) become clear","সুস্পষ্ট হয়েছে"],["لَهُ","lahu","to him","তার কাছে"],["ٱلْهُدَىٰ","l-hudā","(of) the guidance","সৎ পথ"],["وَيَتَّبِعْ","wayattabi‘","and he follows","ও অনুসরণ করে"],["غَيْرَ","ghayra","other than","ব্যতীত"],["سَبِيلِ","sabīli","(the) way","পথ"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","(of) the believers","মু'মিনদের (তাহলে)"],["نُوَلِّهِۦ","nuwallihi","We will turn him","তাকে ফিরাব আমরা"],["مَا","mā","(to) what","(সে দিকেই) যে দিকে"],["تَوَلَّىٰ","tawallā","he (has) turned","সে ফিরেছে"],["وَنُصْلِهِۦ","wanuṣ'lihi","and We will burn him","ও তাকে দগ্ধ করব আমরা"],["جَهَنَّمَ ۖ","jahannama","(in) Hell","জাহান্নামে"],["وَسَآءَتْ","wasāat","and evil it is","এবং (তা) কত নিকৃষ্ট"],["مَصِيرًا","maṣīran","(as) a destination","গন্তব্যস্থল"]],"t":"وَ<d>مَن يُ</>شَاقِقِ <h>ٱ</><l>ل</>رَّسُولَ <i>مِنۢ بَ</>عْدِ مَا تَبَيَّنَ لَهُ <h>ٱ</>لْهُدَىٰ وَيَتَّبِعْ غَيْرَ سَبِيلِ <h>ٱ</>لْمُؤْمِنِينَ نُوَلِّ<m>هِۦ</> مَا تَوَلَّىٰ وَنُصْلِ<m>هِۦ</> جَهَ<g>نَّ</>مَ ۖ وَ<o>سَآ</>ءَتْ مَصِيرًا"},{"n":116,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَا","lā","does not","না"],["يَغْفِرُ","yaghfiru","forgive","মাফ করেন"],["أَن","an","that","(যে)"],["يُشْرَكَ","yush'raka","partners be associated","শিরক করাকে"],["بِهِۦ","bihi","with Him","তার সাথে"],["وَيَغْفِرُ","wayaghfiru","but He forgives","কিন্তু মাফ করবেন"],["مَا","mā","[what]","যা (আছে)"],["دُونَ","dūna","other than","ব্যতীত"],["ذَٰلِكَ","dhālika","that","এটা"],["لِمَن","liman","for whom","যাকে"],["يَشَآءُ ۚ","yashāu","He wills","তিনি ইচ্ছে করবেন"],["وَمَن","waman","And whoever","ও যে"],["يُشْرِكْ","yush'rik","associates partners","শিরক করে"],["بِٱللَّهِ","bil-lahi","with Allah","আল্লাহর সাথে"],["فَقَدْ","faqad","then surely","নিশ্চয় অতঃপর"],["ضَلَّ","ḍalla","he lost (the) way","সে পথভ্রষ্ট হয়েছে"],["ضَلَـٰلًۢا","ḍalālan","straying","পথভ্রষ্টতায়"],["بَعِيدًا","ba‘īdan","far away","বহুদূরে"]],"t":"إِ<g>نَّ</> <h>ٱ</>للَّهَ لَا يَغْفِرُ <d>أَن يُ</>شْرَكَ بِ<m>هِۦ</> وَيَغْفِرُ مَا دُونَ <m>ذَٰ</>لِكَ لِ<d>مَن يَ</><o>شَآ</>ءُ ۚ وَ<d>مَن يُ</>شْرِكْ بِ<h>ٱ</>للَّهِ فَقَ<q>دْ</> ضَلَّ ضَ<m>لَٰ</>لًۢ<i>ا بَ</>عِيدًا"},{"n":117,"w":[["إِن","in","Not","না"],["يَدْعُونَ","yad‘ūna","they invoke","তারা ডাকে"],["مِن","min","from","(থেকে)"],["دُونِهِۦٓ","dūnihi","besides Him","তাঁকে ছাড়া"],["إِلَّآ","illā","but","কিন্তু"],["إِنَـٰثًۭا","ināthan","female (deities)","দেবীদেরকে"],["وَإِن","wa-in","and not","এবং না"],["يَدْعُونَ","yad‘ūna","they invoke","তারা ডাকে"],["إِلَّا","illā","except","এছাড়া"],["شَيْطَـٰنًۭا","shayṭānan","Shaitaan ","শয়তানকে"],["مَّرِيدًۭا","marīdan","rebellious","বিদ্রোহী"]],"t":"<d>إِن يَ</><q>دْ</>عُونَ مِ<k>ن دُ</>ونِ<o>هِۦٓ</> إِ<o>لَّآ</> إِ<m>نَٰ</><d>ثًۭا وَإِن يَ</><q>دْ</>عُونَ إِلَّا شَيْ<m>طَٰ</><d>نًۭا مَّ</>رِيدًۭا"},{"n":118,"w":[["لَّعَنَهُ","la‘anahu","He was cursed","যাকে লানত দিয়েছেন"],["ٱللَّهُ ۘ","l-lahu","by Allah","আল্লাহ"],["وَقَالَ","waqāla","and he said","এবং (শয়তান) বলেছিল"],["لَأَتَّخِذَنَّ","la-attakhidhanna","I will surely take","''আমি অবশ্যই নিয়ে ছাড়ব"],["مِنْ","min","from","মধ্য হতে"],["عِبَادِكَ","‘ibādika","your slaves","তোমার বান্দাদের"],["نَصِيبًۭا","naṣīban","a portion","এক অংশ"],["مَّفْرُوضًۭا","mafrūḍan","appointed","নির্দিষ্ট''"]],"t":"لَّعَنَهُ <h>ٱ</>للَّهُ ۘ وَقَالَ لَأَتَّخِذَ<g>نَّ</> مِنْ عِبَادِكَ نَصِي<d>بًۭا مَّ</>فْرُوضًۭا"},{"n":119,"w":[["وَلَأُضِلَّنَّهُمْ","wala-uḍillannahum","And I will surely mislead them","''এবং তাদের আমি অবশ্যই পথভ্রষ্ট করব"],["وَلَأُمَنِّيَنَّهُمْ","wala-umanniyannahum","and surely arouse desires in them","এবং তাদের আমি অবশ্যই আশা আকাঙ্ক্ষা দিব"],["وَلَـَٔامُرَنَّهُمْ","walaāmurannahum","and surely I will order them","এবং তাদের আমি অবশ্যই নির্দেশ দেব"],["فَلَيُبَتِّكُنَّ","falayubattikunna","so they will surely cut off","অতঃপর তারা অবশ্যই ছেদ করবে"],["ءَاذَانَ","ādhāna","(the) ears","কানগুলো"],["ٱلْأَنْعَـٰمِ","l-an‘āmi","(of) the cattle","গবাদিপশুর"],["وَلَـَٔامُرَنَّهُمْ","walaāmurannahum","and surely I will order them","ও তাদের অবশ্যই আমি নির্দেশ দেব"],["فَلَيُغَيِّرُنَّ","falayughayyirunna","so they will surely change","অতঃপর তারা অবশ্যই বিকৃত করবে"],["خَلْقَ","khalqa","(the) creation","সৃষ্টিকে"],["ٱللَّهِ ۚ","l-lahi","(of) Allah","আল্লাহর''"],["وَمَن","waman","And whoever","এবং যে"],["يَتَّخِذِ","yattakhidhi","takes","গ্রহণ করে"],["ٱلشَّيْطَـٰنَ","l-shayṭāna","the Shaitaan","শয়তানকে"],["وَلِيًّۭا","waliyyan","(as) a friend","অভিভাবকরূপে"],["مِّن","min","from","(থেকে)"],["دُونِ","dūni","besides","ছাড়া"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["فَقَدْ","faqad","then surely","নিশ্চয়ই তবে"],["خَسِرَ","khasira","he (has) lost ","সে ক্ষতিগ্রস্ত হয়"],["خُسْرَانًۭا","khus'rānan","a loss","ক্ষতিতে"],["مُّبِينًۭا","mubīnan","manifest","প্রকাশ্য"]],"t":"وَلَأُضِلَّ<g>نَّ</>هُمْ وَلَأُمَ<g>نِّيَنَّ</>هُمْ وَلَءَامُرَ<g>نَّ</>هُمْ فَلَيُبَتِّكُ<g>نَّ</> ءَاذَانَ <h>ٱ</>لْأَنْ<m>عَٰ</>مِ وَلَءَامُرَ<g>نَّ</>هُمْ فَلَيُغَيِّرُ<g>نَّ</> خَلْقَ <h>ٱ</>للَّهِ ۚ وَ<d>مَن يَ</>تَّخِذِ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نَ وَلِ<d>يًّۭا مِّ</><k>ن دُ</>ونِ <h>ٱ</>للَّهِ فَقَ<q>دْ</> خَسِرَ خُسْرَا<d>نًۭا مُّ</>بِينًۭا"},{"n":120,"w":[["يَعِدُهُمْ","ya‘iduhum","He promises them","তাদের ওয়াদা দেয় সে"],["وَيُمَنِّيهِمْ ۖ","wayumannīhim","and arouses desires in them","ও তাদের আশা দেয়"],["وَمَا","wamā","and not","এবং না"],["يَعِدُهُمُ","ya‘iduhumu","promises them","তাদের ওয়াদা দেয়"],["ٱلشَّيْطَـٰنُ","l-shayṭānu","the Shaitaan ","শয়তান"],["إِلَّا","illā","except","এছাড়া"],["غُرُورًا","ghurūran","deception","প্রতারণা"]],"t":"يَعِدُهُمْ وَيُمَ<g>نِّ</>يهِمْ ۖ وَمَا يَعِدُهُمُ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نُ إِلَّا غُرُورًا"},{"n":121,"w":[["أُو۟لَـٰٓئِكَ","ulāika","Those ","ঐসব লোক"],["مَأْوَىٰهُمْ","mawāhum","their abode","তাদের আশ্রয়স্থল"],["جَهَنَّمُ","jahannamu","(is) Hell","জাহান্নাম"],["وَلَا","walā","and not","এবং না"],["يَجِدُونَ","yajidūna","they will find","তারা পাবে"],["عَنْهَا","‘anhā","from it","তা থেকে"],["مَحِيصًۭا","maḥīṣan","any escape","পালানোর জায়গা"]],"t":"أُ<s>و۟</><o>لَٰٓ</>ئِكَ مَأْوَ<m>ىٰ</>هُمْ جَهَ<g>نَّ</>مُ وَلَا يَجِدُونَ عَنْهَا مَحِيصًۭا"},{"n":122,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["ءَامَنُوا۟","āmanū","believe[d]","ঈমান এনেছে"],["وَعَمِلُوا۟","wa‘amilū","and do","ও কাজ করেছে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","[the] righteous deeds","নেকীর"],["سَنُدْخِلُهُمْ","sanud'khiluhum","We will admit them","তাদের প্রবেশ করাব আমরা"],["جَنَّـٰتٍۢ","jannātin","(in) Gardens","জান্নাতে"],["تَجْرِى","tajrī","flow","প্রবাহিত হয়"],["مِن","min","from","(থেকে)"],["تَحْتِهَا","taḥtihā","underneath it","তার পাদদেশে"],["ٱلْأَنْهَـٰرُ","l-anhāru","the rivers","ঝর্ণাধারাসমুহ"],["خَـٰلِدِينَ","khālidīna","will abide","তারা অবস্থানকারী হবে"],["فِيهَآ","fīhā","in it","তার মধ্যে"],["أَبَدًۭا ۖ","abadan","forever","চিরকাল"],["وَعْدَ","wa‘da","A Promise","ওয়াদা"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["حَقًّۭا ۚ","ḥaqqan","(in) truth","সত্য"],["وَمَنْ","waman","and who","এবং কে"],["أَصْدَقُ","aṣdaqu","(is) truer","অধিক সত্যবাদী"],["مِنَ","mina","than","চেয়ে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["قِيلًۭا","qīlan","(in) statement","কথায়"]],"t":"وَ<h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ سَنُ<q>دْ</>خِلُهُمْ جَ<g>نَّٰ</><k>تٍۢ تَ</><q>جْ</>رِى مِ<k>ن تَ</>حْتِهَا <h>ٱ</>لْأَنْ<m>هَٰ</>رُ <m>خَٰ</>لِدِينَ فِي<o>هَآ</> أَبَ<d>دًۭا ۖ وَ</>عْدَ <h>ٱ</>للَّهِ حَ<d>قًّۭا ۚ وَ</>مَنْ أَصْدَقُ مِنَ <h>ٱ</>للَّهِ قِيلًۭا"},{"n":123,"w":[["لَّيْسَ","laysa","Not","না (হবে শেষ পরিণিতি)"],["بِأَمَانِيِّكُمْ","bi-amāniyyikum","by your desire","তোমাদের আকাঙ্ক্ষা অনুযায়ী"],["وَلَآ","walā","and not","আর না"],["أَمَانِىِّ","amāniyyi","(by the) desire","আকাঙ্ক্ষা (অনুযায়ী)"],["أَهْلِ","ahli","(of the) People","আহলি"],["ٱلْكِتَـٰبِ ۗ","l-kitābi","(of) the Book","কিতাবদের"],["مَن","man","Whoever","যে"],["يَعْمَلْ","ya‘mal","does","কাজ করবে"],["سُوٓءًۭا","sūan","evil","মন্দ"],["يُجْزَ","yuj'za","will be recompensed","প্রতিফল দেয়া হবে"],["بِهِۦ","bihi","for it","সে অনুযায়ী"],["وَلَا","walā","and not","এবং না"],["يَجِدْ","yajid","he will find","সে পাবে"],["لَهُۥ","lahu","for him","তার জন্য"],["مِن","min","from","(থেকে)"],["دُونِ","dūni","besides","ছাড়া"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["وَلِيًّۭا","waliyyan","any protector","কোন অভিভাবক"],["وَلَا","walā","and not","এবং না"],["نَصِيرًۭا","naṣīran","any helper","কোন সাহায্যকারী"]],"t":"لَّيْسَ بِأَمَانِيِّكُمْ وَ<o>لَآ</> أَمَانِىِّ أَهْلِ <h>ٱ</>لْكِ<m>تَٰ</>بِ ۗ <d>مَن يَ</>عْمَلْ <o>سُوٓ</><d>ءًۭا يُ</><q>جْ</>زَ بِ<m>هِۦ</> وَلَا يَجِ<q>دْ</> لَهُ<m>ۥ</> مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ وَلِ<d>يًّۭا وَ</>لَا نَصِيرًۭا"},{"n":124,"w":[["وَمَن","waman","And whoever","এবং যে"],["يَعْمَلْ","ya‘mal","does","কাজ করবে"],["مِنَ","mina","[of]","(থেকে)"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","[the] righteous deeds","নেকীসমূহের"],["مِن","min","from","মধ্য হতে"],["ذَكَرٍ","dhakarin","(the) male","পুরুষদের"],["أَوْ","aw","or","অথবা"],["أُنثَىٰ","unthā","female","নারীদের"],["وَهُوَ","wahuwa","and he","এবং সে"],["مُؤْمِنٌۭ","mu'minun","(is) a believer","মু'মিনও"],["فَأُو۟لَـٰٓئِكَ","fa-ulāika","then those","ঐসব লোক তখন"],["يَدْخُلُونَ","yadkhulūna","will enter","প্রবেশ করবে"],["ٱلْجَنَّةَ","l-janata","Paradise","জান্নাতে"],["وَلَا","walā","and not","এবং না"],["يُظْلَمُونَ","yuẓ'lamūna","they will be wronged","জুলুম করা হবে"],["نَقِيرًۭا","naqīran","(even as much as) the speck on a date-seed","সামান্য পরিমাণেও"]],"t":"وَ<d>مَن يَ</>عْمَلْ مِنَ <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ مِ<k>ن ذَ</>كَرٍ أَوْ أُ<k>نثَ</>ىٰ وَهُوَ مُؤْمِ<k>نٌۭ فَ</>أُ<s>و۟</><o>لَٰٓ</>ئِكَ يَ<q>دْ</>خُلُونَ <h>ٱ</>لْجَ<g>نَّ</>ةَ وَلَا يُظْلَمُونَ نَقِيرًۭا"},{"n":125,"w":[["وَمَنْ","waman","And who","এবং কার"],["أَحْسَنُ","aḥsanu","(is) better","উত্তম"],["دِينًۭا","dīnan","(in) religion","জীবন-যাপন পন্থা"],["مِّمَّنْ","mimman","than (one) who","(তার) চেয়ে যে"],["أَسْلَمَ","aslama","submits","আত্মসমর্পণ করল"],["وَجْهَهُۥ","wajhahu","his face","তার নিজেকে"],["لِلَّهِ","lillahi","to Allah","আল্লাহর কাছে"],["وَهُوَ","wahuwa","and he","এবং সে"],["مُحْسِنٌۭ","muḥ'sinun","(is) a good-doer","সৎকর্মশীলও"],["وَٱتَّبَعَ","wa-ittaba‘a","and follows","এবং অনুসরণ করল"],["مِلَّةَ","millata","(the) religion","পন্থা"],["إِبْرَٰهِيمَ","ib'rāhīma","(of) Ibrahim","ইবরাহীমের"],["حَنِيفًۭا ۗ","ḥanīfan","(the) upright","একনিষ্ঠভাবে"],["وَٱتَّخَذَ","wa-ittakhadha","And was taken","এবং গ্রহণ করেছেন"],["ٱللَّهُ","l-lahu","(by) Allah","আল্লাহ"],["إِبْرَٰهِيمَ","ib'rāhīma","Ibrahim","ইবরাহীমকে"],["خَلِيلًۭا","khalīlan","(as) a friend","বন্ধু হিসেবে"]],"t":"وَمَنْ أَحْسَنُ دِي<d>نًۭا مِّ</><g>مَّ</>نْ أَ