sihim","their souls","তাদের অন্তরে"],["قَوْلًۢا","qawlan","a word","কথা"],["بَلِيغًۭا","balīghan","penetrating","পৌঁছে"]],"t":"أُ<s>و۟</><o>لَٰٓ</>ئِكَ <h>ٱ</>لَّذِينَ يَعْلَمُ <h>ٱ</>للَّهُ مَا فِى قُلُوبِهِمْ فَأَعْرِضْ عَنْهُمْ وَعِظْهُمْ وَقُل لَّهُمْ <o>فِىٓ</> أَ<k>نفُ</>سِهِمْ قَوْلًۢ<i>ا بَ</>لِيغًۭا"},{"n":64,"w":[["وَمَآ","wamā","And not","এবং না"],["أَرْسَلْنَا","arsalnā","We sent","আমরা পাঠিয়েছি"],["مِن","min","any","(থেকে)"],["رَّسُولٍ","rasūlin","Messenger","কোন রাসূল"],["إِلَّا","illā","except","এছাড়া যে"],["لِيُطَاعَ","liyuṭā‘a","to be obeyed","আনুগত্য করার জন্য"],["بِإِذْنِ","bi-idh'ni","by (the) permission","অনুমতিক্রমে"],["ٱللَّهِ ۚ","l-lahi","(of) Allah","আল্লাহর"],["وَلَوْ","walaw","And if","এবং যদি"],["أَنَّهُمْ","annahum","[that] they","তারা বাস্তবিক"],["إِذ","idh","when","যখন"],["ظَّلَمُوٓا۟","ẓalamū","they wronged","জুলুম করেছিল"],["أَنفُسَهُمْ","anfusahum","themselves","তাদের নিজেদের উপর"],["جَآءُوكَ","jāūka","(had) come to you","তোমার কাছে আসত"],["فَٱسْتَغْفَرُوا۟","fa-is'taghfarū","and asked forgiveness","তারা অতঃপর ক্ষমা চাইত"],["ٱللَّهَ","l-laha","(of) Allah","আল্লাহর কাছে"],["وَٱسْتَغْفَرَ","wa-is'taghfara","and asked forgiveness","ও ক্ষমা চাইত"],["لَهُمُ","lahumu","for them","তাদের জন্য"],["ٱلرَّسُولُ","l-rasūlu","the Messenger","রাসূল"],["لَوَجَدُوا۟","lawajadū","surely they would have found","তারা পেত অবশ্যই"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["تَوَّابًۭا","tawwāban","Oft-Forgiving","ক্ষমাশীল"],["رَّحِيمًۭا","raḥīman","Most Merciful","মেহেরবান (হিসেবে)"]],"t":"وَ<o>مَآ</> أَرْسَلْنَا <w>مِن رَّ</>سُولٍ إِلَّا لِيُطَاعَ بِإِذْنِ <h>ٱ</>للَّهِ ۚ وَلَوْ أَ<g>نَّ</>هُمْ إِ<j>ذ</> ظَّلَ<o>مُوٓ</><s>ا۟</> أَ<k>نفُ</>سَهُمْ <o>جَآ</>ءُوكَ فَ<h>ٱ</>سْتَغْفَرُو<s>ا۟</> <h>ٱ</>للَّهَ وَ<h>ٱ</>سْتَغْفَرَ لَهُمُ <h>ٱ</><l>ل</>رَّسُولُ لَوَجَدُو<s>ا۟</> <h>ٱ</>للَّهَ تَوَّا<w>بًۭا رَّ</>حِيمًۭا"},{"n":65,"w":[["فَلَا","falā","But no","অতএব না"],["وَرَبِّكَ","warabbika","by your Lord","কসম তোমার রবের"],["لَا","lā","not","না"],["يُؤْمِنُونَ","yu'minūna","will they believe","তারা মু’মিন হবে"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["يُحَكِّمُوكَ","yuḥakkimūka","they make you judge","তোমাকে বিচারক মানবে"],["فِيمَا","fīmā","about what","সে ক্ষেত্রে (যে বিষয়ে)"],["شَجَرَ","shajara","arises","মতভেদ করে"],["بَيْنَهُمْ","baynahum","between them","তাদের মাঝে"],["ثُمَّ","thumma","then","এরপর"],["لَا","lā","not","না"],["يَجِدُوا۟","yajidū","they find","তারা পাবে"],["فِىٓ","fī","in","মধ্যে"],["أَنفُسِهِمْ","anfusihim","themselves","তাদের মনের"],["حَرَجًۭا","ḥarajan","any discomfort","কুণ্ঠাবোধ"],["مِّمَّا","mimmā","about what","তা হতে যা"],["قَضَيْتَ","qaḍayta","you (have) decided","তুমি সিদ্ধান্ত দিয়েছ"],["وَيُسَلِّمُوا۟","wayusallimū","and submit","ও তারা আত্মসমর্পণ করবে"],["تَسْلِيمًۭا","taslīman","(in full) submission","পূর্ণ আত্মসমর্পণ"]],"t":"فَلَا وَرَبِّكَ لَا يُؤْمِنُونَ حَتَّىٰ يُحَكِّمُوكَ فِيمَا شَجَرَ بَيْنَهُمْ ثُ<g>مَّ</> لَا يَجِدُو<s>ا۟</> <o>فِىٓ</> أَ<k>نفُ</>سِهِمْ حَرَ<d>جًۭا مِّ</><g>مَّ</>ا قَضَيْتَ وَيُسَلِّمُو<s>ا۟</> تَسْلِيمًۭا"},{"n":66,"w":[["وَلَوْ","walaw","And if","এবং যদি"],["أَنَّا","annā","[that] We","নিশ্চয়ই আমরা"],["كَتَبْنَا","katabnā","(had) decreed","হুকুম দিতাম"],["عَلَيْهِمْ","‘alayhim","on them","তাদের উপর"],["أَنِ","ani","that","যে"],["ٱقْتُلُوٓا۟","uq'tulū","Kill","''তোমরা হত্যা কর"],["أَنفُسَكُمْ","anfusakum","yourselves","তোমাদের নিজেদেরকে''"],["أَوِ","awi","or","বা"],["ٱخْرُجُوا۟","ukh'rujū","Go forth","''তোমরা বের হও"],["مِن","min","from","থেকে"],["دِيَـٰرِكُم","diyārikum","your homes","তোমাদের ঘরগুলো''"],["مَّا","mā","not","না"],["فَعَلُوهُ","fa‘alūhu","they would have done it","তা তারা করত"],["إِلَّا","illā","except","এছাড়া"],["قَلِيلٌۭ","qalīlun","a few","অল্প কিছু সংখ্যক"],["مِّنْهُمْ ۖ","min'hum","of them","তাদের মধ্যে হতে"],["وَلَوْ","walaw","But if","এবং যদি"],["أَنَّهُمْ","annahum","[that] they","তারা বাস্তবিক"],["فَعَلُوا۟","fa‘alū","had done","করত"],["مَا","mā","what","যা"],["يُوعَظُونَ","yū‘aẓūna","they were advised","তাদের উপদেশ দেয়া হয়"],["بِهِۦ","bihi","with [it]","সে সে সম্পর্কে"],["لَكَانَ","lakāna","surely (it) would have been","নিশ্চয়ই হত"],["خَيْرًۭا","khayran","better","উত্তম"],["لَّهُمْ","lahum","for them","তাদের জন্য"],["وَأَشَدَّ","wa-ashadda","and stronger","এবং দৃঢ়তর (হত)"],["تَثْبِيتًۭا","tathbītan","strengthen(ing)","চিত্ত স্থিরতায়"]],"t":"وَلَوْ أَ<g>نَّ</>ا كَتَ<q>بْ</>نَا عَلَيْهِمْ أَنِ <h>ٱ</><q>قْ</>تُ<o>لُوٓ</><s>ا۟</> أَ<k>نفُ</>سَكُمْ أَوِ <h>ٱ</>خْرُجُو<s>ا۟</> مِ<k>ن دِ</><m>يَٰ</>رِ<y>كُم مَّ</>ا فَعَلُوهُ إِلَّا قَلِي<d>لٌۭ مِّ</>نْهُمْ ۖ وَلَوْ أَ<g>نَّ</>هُمْ فَعَلُو<s>ا۟</> مَا يُوعَظُونَ بِ<m>هِۦ</> لَكَانَ خَيْ<w>رًۭا لَّ</>هُمْ وَأَشَدَّ تَثْبِيتًۭا"},{"n":67,"w":[["وَإِذًۭا","wa-idhan","And then","এবং তখন"],["لَّـَٔاتَيْنَـٰهُم","laātaynāhum","We would (have) given them","তাদের অবশ্যই দিতাম আমরা"],["مِّن","min","from","থেকে"],["لَّدُنَّآ","ladunnā","Ourselves","নিজের কাছ"],["أَجْرًا","ajran","a reward","প্রতিফল"],["عَظِيمًۭا","‘aẓīman","great","বিরাট"]],"t":"وَإِ<w>ذًۭا لَّ</>ءَاتَيْ<m>نَٰ</><y>هُم مِّ</><w>ن لَّ</>دُ<g>نَّ</><o>آ</> أَ<q>جْ</>رًا عَظِيمًۭا"},{"n":68,"w":[["وَلَهَدَيْنَـٰهُمْ","walahadaynāhum","And We would have guided them","এবং আমরা তাদের হিদায়াত দিতাম"],["صِرَٰطًۭا","ṣirāṭan","(to the) way","পথের"],["مُّسْتَقِيمًۭا","mus'taqīman","(the) straight","সরল সঠিক"]],"t":"وَلَهَدَيْ<m>نَٰ</>هُمْ صِ<m>رَٰ</><d>طًۭا مُّ</>سْتَقِيمًۭا"},{"n":69,"w":[["وَمَن","waman","And whoever","এবং যে"],["يُطِعِ","yuṭi‘i","obeys","আনুগত্য করবে"],["ٱللَّهَ","l-laha","Allah","আল্লাহর"],["وَٱلرَّسُولَ","wal-rasūla","and the Messenger","ও রাসূলের"],["فَأُو۟لَـٰٓئِكَ","fa-ulāika","then those","ঐসব লোকে তখন (হবে)"],["مَعَ","ma‘a","(will be) with","সাথে"],["ٱلَّذِينَ","alladhīna","those whom","(তাদের) যাদের"],["أَنْعَمَ","an‘ama","has bestowed (His) Favor","নিয়ামত দিয়েছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["عَلَيْهِم","‘alayhim","upon them ","তাদের উপর"],["مِّنَ","mina","of","(যেমন) থেকে"],["ٱلنَّبِيِّـۧنَ","l-nabiyīna","the Prophets","নবীদের"],["وَٱلصِّدِّيقِينَ","wal-ṣidīqīna","and the truthful","ও সিদ্দিকদের"],["وَٱلشُّهَدَآءِ","wal-shuhadāi","and the martyrs","ও শহীদদের"],["وَٱلصَّـٰلِحِينَ ۚ","wal-ṣāliḥīna","and the righteous","ও সৎ লোকদের (সাথে)"],["وَحَسُنَ","waḥasuna","And excellent","এবং কতই উত্তম"],["أُو۟لَـٰٓئِكَ","ulāika","(are) those","ঐসব"],["رَفِيقًۭا","rafīqan","companion(s)","সাথী"]],"t":"وَ<d>مَن يُ</>طِعِ <h>ٱ</>للَّهَ وَ<h>ٱ</><l>ل</>رَّسُولَ فَأُ<s>و۟</><o>لَٰٓ</>ئِكَ مَعَ <h>ٱ</>لَّذِينَ أَنْعَمَ <h>ٱ</>للَّهُ عَلَيْ<y>هِم مِّ</>نَ <h>ٱ</><l>ل</><g>نَّ</>بِيِّۦنَ وَ<h>ٱ</><l>ل</>صِّدِّيقِينَ وَ<h>ٱ</><l>ل</>شُّهَ<o>دَآ</>ءِ وَ<h>ٱ</><l>ل</><m>صَّٰ</>لِحِينَ ۚ وَحَسُنَ أُ<s>و۟</><o>لَٰٓ</>ئِكَ رَفِيقًۭا"},{"n":70,"w":[["ذَٰلِكَ","dhālika","That","এটা"],["ٱلْفَضْلُ","l-faḍlu","(is) the Bounty","অনুগ্রহ"],["مِنَ","mina","of","(থেকে)"],["ٱللَّهِ ۚ","l-lahi","Allah","আল্লাহর"],["وَكَفَىٰ","wakafā","and sufficient","এবং যথেষ্ট"],["بِٱللَّهِ","bil-lahi","Allah","আল্লাহই"],["عَلِيمًۭا","‘alīman","(as) All-Knower","জ্ঞানে"]],"t":"<m>ذَٰ</>لِكَ <h>ٱ</>لْفَضْلُ مِنَ <h>ٱ</>للَّهِ ۚ وَكَفَىٰ بِ<h>ٱ</>للَّهِ عَلِيمًۭا"},{"n":71,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you","ওহে"],["ٱلَّذِينَ","alladhīna","who","যারা"],["ءَامَنُوا۟","āmanū","believe[d]","ঈমান এনেছ"],["خُذُوا۟","khudhū","Take","তোমরা অবলম্বন কর"],["حِذْرَكُمْ","ḥidh'rakum","your precautions","তোমাদের সতর্কতা"],["فَٱنفِرُوا۟","fa-infirū","and advance","তোমরা অতঃপর বের হও"],["ثُبَاتٍ","thubātin","(in) groups","পৃথক দলে"],["أَوِ","awi","or","অথবা"],["ٱنفِرُوا۟","infirū","advance","তোমরা বের হও"],["جَمِيعًۭا","jamī‘an","all together","একত্রে"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> خُذُو<s>ا۟</> حِذْرَكُمْ فَ<h>ٱ</><k>نفِ</>رُو<s>ا۟</> ثُبَاتٍ أَوِ <h>ٱ</><k>نفِ</>رُو<s>ا۟</> جَمِيعًۭا"},{"n":72,"w":[["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["مِنكُمْ","minkum","among you","তোমাদের মধ্যে (এমনও আছে)"],["لَمَن","laman","(is he) who","অবশ্যই যে"],["لَّيُبَطِّئَنَّ","layubaṭṭi-anna","lags behind","(যুদ্ধে) পশ্চাদপদ হবেই"],["فَإِنْ","fa-in","then if","অতঃপর যদি"],["أَصَـٰبَتْكُم","aṣābatkum","befalls you","তোমাদের পৌঁছে"],["مُّصِيبَةٌۭ","muṣībatun","a disaster","কোন বিপদ"],["قَالَ","qāla","he said","বলবে"],["قَدْ","qad","Verily","''নিশ্চয়"],["أَنْعَمَ","an‘ama","(has) favored","অনুগ্রহ করেছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["عَلَىَّ","‘alayya","[on] me","আমার উপর"],["إِذْ","idh","[when]","তখন"],["لَمْ","lam","(that) not","না"],["أَكُن","akun","I was","আমি ছিলাম"],["مَّعَهُمْ","ma‘ahum","with them","তাদের সাথে''"],["شَهِيدًۭا","shahīdan","present","উপস্থিত''"]],"t":"وَإِ<g>نَّ</> مِ<k>نكُ</>مْ لَ<w>مَن لَّ</>يُبَطِّئَ<g>نَّ</> فَإِنْ أَ<m>صَٰ</>بَتْ<y>كُم مُّ</>صِيبَ<k>ةٌۭ قَ</>الَ قَ<q>دْ</> أَنْعَمَ <h>ٱ</>للَّهُ عَلَىَّ إِذْ لَمْ أَ<d>كُن مَّ</>عَهُمْ شَهِيدًۭا"},{"n":73,"w":[["وَلَئِنْ","wala-in","And if","এবং অবশ্য যদি"],["أَصَـٰبَكُمْ","aṣābakum","befalls you","তোমাদের পৌঁছে"],["فَضْلٌۭ","faḍlun","bounty","কোন অনুগ্রহ"],["مِّنَ","mina","from","পক্ষ হতে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["لَيَقُولَنَّ","layaqūlanna","he would surely say","তারা বলবেই"],["كَأَن","ka-an","as if","এমন ভাবে যে"],["لَّمْ","lam","(had) not","না"],["تَكُنۢ","takun","there been","ছিল"],["بَيْنَكُمْ","baynakum","between you","তোমাদের মাঝে"],["وَبَيْنَهُۥ","wabaynahu","and between him","ও তার মাঝে"],["مَوَدَّةٌۭ","mawaddatun","any affection","কোন সম্পর্ক"],["يَـٰلَيْتَنِى","yālaytanī","Oh! I wish","''হায় আফসোস আমার"],["كُنتُ","kuntu","I had been","আমি হতাম (যদি)"],["مَعَهُمْ","ma‘ahum","with them","তাদের সাথে"],["فَأَفُوزَ","fa-afūza","then I would have attained","তবে আমি সফল হতাম"],["فَوْزًا","fawzan","a success","সাফল্য"],["عَظِيمًۭا","‘aẓīman","great","বিরাট''"]],"t":"وَلَئِنْ أَ<m>صَٰ</>بَكُمْ فَضْ<d>لٌۭ مِّ</>نَ <h>ٱ</>للَّهِ لَيَقُولَ<g>نَّ</> كَ<w>أَن لَّ</>مْ تَ<i>كُنۢ بَ</>يْنَكُمْ وَبَيْنَهُ<m>ۥ</> مَوَدَّ<d>ةٌۭ يَٰ</>لَيْتَنِى كُ<k>نتُ</> مَعَهُمْ فَأَفُوزَ فَوْزًا عَظِيمًۭا"},{"n":74,"w":[["۞ فَلْيُقَـٰتِلْ","falyuqātil","So let fight","অতএব লড়াই করা উচিত"],["فِى","fī","in","(মধ্যে)"],["سَبِيلِ","sabīli","(t