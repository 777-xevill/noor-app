{"n":4,"a":[{"n":1,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O","''হে"],["ٱلنَّاسُ","l-nāsu","mankind","মানবজাতি!"],["ٱتَّقُوا۟","ittaqū","Fear","তোমরা ভয় কর"],["رَبَّكُمُ","rabbakumu","your Lord","তোমাদের রবকে"],["ٱلَّذِى","alladhī","the One Who","যিনি"],["خَلَقَكُم","khalaqakum","created you","তোমাদেরকে সৃষ্টি করেছেন"],["مِّن","min","from","থেকে"],["نَّفْسٍۢ","nafsin","a soul","প্রাণ"],["وَٰحِدَةٍۢ","wāḥidatin","single","একটি (অর্থাৎ আদম (আঃ))"],["وَخَلَقَ","wakhalaqa","and created","ও তিনি সৃষ্টি করেছেন"],["مِنْهَا","min'hā","from it","তা হতে"],["زَوْجَهَا","zawjahā","its mate","তার জুড়ী (অর্থাৎ হাওয়া)"],["وَبَثَّ","wabatha","and dispersed","ও ছড়িয়ে দিয়েছেন"],["مِنْهُمَا","min'humā","from both of them","তাদের দুজন থেকে"],["رِجَالًۭا","rijālan","men","পুরুষ লোক"],["كَثِيرًۭا","kathīran","many","অনেক"],["وَنِسَآءًۭ ۚ","wanisāan","and women","ও স্ত্রীলোক (অনেক)"],["وَٱتَّقُوا۟","wa-ittaqū","And fear","এবং তোমরা ভয় কর"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["ٱلَّذِى","alladhī","(through) Whom","সেই (সত্তার)"],["تَسَآءَلُونَ","tasāalūna","you ask","তোমরা পরস্পরে (হক) দাবী কর"],["بِهِۦ","bihi","[with it]","যার (দোহাই দিয়ে)"],["وَٱلْأَرْحَامَ ۚ","wal-arḥāma","and the wombs","আর আত্মীয়তার বন্ধন সম্পর্কে সতর্ক থাক"],["إِنَّ","inna","Indeed","নিশ্চয়"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["كَانَ","kāna","is","আছেন"],["عَلَيْكُمْ","‘alaykum","over you","তোমাদের উপর"],["رَقِيبًۭا","raqīban","Ever-Watchful","দৃষ্টিবান"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</><l>ل</><g>نَّ</>اسُ <h>ٱ</>تَّقُو<s>ا۟</> رَبَّكُمُ <h>ٱ</>لَّذِى خَلَقَ<y>كُم مِّ</><d>ن نَّفْسٍۢ وَٰ</>حِدَ<d>ةٍۢ وَ</>خَلَقَ مِنْهَا زَوْجَهَا وَبَثَّ مِنْهُمَا رِجَالًۭ<k>ا كَ</>ثِي<d>رًۭا وَ</>نِ<o>سَآ</><d>ءًۭ ۚ وَ</><h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</>للَّهَ <h>ٱ</>لَّذِى تَ<o>سَآ</>ءَلُونَ بِ<m>هِۦ</> وَ<h>ٱ</>لْأَرْحَامَ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ كَانَ عَلَيْكُمْ رَقِيبًۭا"},{"n":2,"w":[["وَءَاتُوا۟","waātū","And give","এবং তোমরা (ফেরত) দাও"],["ٱلْيَتَـٰمَىٰٓ","l-yatāmā","(to) the orphans","ইয়াতীমদেরকে"],["أَمْوَٰلَهُمْ 