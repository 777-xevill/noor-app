"<d>لَّن يَ</>سْتَ<k>نكِ</>فَ <h>ٱ</>لْمَسِيحُ <d>أَن يَ</>كُونَ عَ<q>بْ</><w>دًۭا لِّ</>لَّهِ وَلَا <h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةُ <h>ٱ</>لْمُقَرَّبُونَ ۚ وَ<d>مَن يَ</>سْتَ<k>نكِ</>فْ عَنْ عِبَادَتِ<m>هِۦ</> وَيَسْتَكْبِرْ فَسَيَحْشُرُهُمْ إِلَيْهِ جَمِيعًۭا"},{"n":173,"w":[["فَأَمَّا","fa-ammā","Then as for","অতঃপর"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ءَامَنُوا۟","āmanū","believed","ঈমান এনেছে"],["وَعَمِلُوا۟","wa‘amilū","and did","ও কাজ করেছে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","the righteous deeds","নেকীসমূহের"],["فَيُوَفِّيهِمْ","fayuwaffīhim","then He will give them in full","তাদেরকে অতঃপর পূর্ণ দেবেন"],["أُجُورَهُمْ","ujūrahum","their reward","তাদের কর্মফলসমূহ"],["وَيَزِيدُهُم","wayazīduhum","and give them more","এবং বেশীও দিবেন তাদেরকে"],["مِّن","min","from","হতে"],["فَضْلِهِۦ ۖ","faḍlihi","His Bounty","তাঁর অনুগ্রহ"],["وَأَمَّا","wa-ammā","And as for","আর"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ٱسْتَنكَفُوا۟","is'tankafū","disdained","হেয় জ্ঞান করলো"],["وَٱسْتَكْبَرُوا۟","wa-is'takbarū","and were arrogant","ও অহংকার করল"],["فَيُعَذِّبُهُمْ","fayu‘adhibuhum","then He will punish them","তাদেরকে তাহলে শাস্তি দিবেন"],["عَذَابًا","‘adhāban","(with) a punishment","শাস্তি"],["أَلِيمًۭا","alīman","painful","মর্মন্তুদ"],["وَلَا","walā","and not","এবং না"],["يَجِدُونَ","yajidūna","will they find","তারা পাবে"],["لَهُم","lahum","for themselves","তাদের জন্য"],["مِّن","min","from","(থেকে)"],["دُونِ","dūni","besides","ছাড়া"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["وَلِيًّۭا","waliyyan","any protector","কোন অভিভাবক"],["وَلَا","walā","and not","আর না"],["نَصِيرًۭا","naṣīran","any helper","কোন সাহায্যকারী"]],"t":"فَأَ<g>مَّ</>ا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ فَيُوَفِّيهِمْ أُجُورَهُمْ وَيَزِيدُ<y>هُم مِّ</><k>ن فَ</>ضْلِ<m>هِۦ</> ۖ وَأَ<g>مَّ</>ا <h>ٱ</>لَّذِينَ <h>ٱ</>سْتَ<k>نكَ</>فُو<s>ا۟</> وَ<h>ٱ</>سْتَكْبَرُو<s>ا۟</> فَيُعَذِّبُهُمْ عَذَابًا أَلِي<d>مًۭا وَ</>لَا يَجِدُونَ لَ<y>هُم مِّ</><k>ن دُ</>ونِ <h>ٱ</>للَّهِ وَلِ<d>يًّۭا وَ</>لَا نَصِيرًۭا"},{"n":174,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O","হে"],["ٱلنَّاسُ","l-nāsu","mankind","মানবজাতি"],["قَدْ","qad","Surely","নিশ্চয়ই"],["جَآءَكُم","jāakum","has come to you","কাছে এসেছে তোমাদের"],["بُرْهَـٰنٌۭ","bur'hānun","a convincing proof","দলীল প্রমাণ"],["مِّن","min","from","পক্ষ হতে"],["رَّبِّكُمْ","rabbikum","your Lord","তোমাদের রবের"],["وَأَنزَلْنَآ","wa-anzalnā","and We (have) sent down","ও আমরা নাযিল করেছি"],["إِلَيْكُمْ","ilaykum","to you","তোমাদের প্রতি"],["نُورًۭا","nūran","a light","আলো'"],["مُّبِينًۭا","mubīnan","clear","সুস্পষ্ট"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</><l>ل</><g>نَّ</>اسُ قَ<q>دْ</> <o>جَآ</>ءَ<f>كُم بُ</>رْ<m>هَٰ</><d>نٌۭ مِّ</><w>ن رَّ</>بِّكُمْ وَأَ<k>نزَ</>لْ<o>نَآ</> إِلَيْكُمْ نُو<d>رًۭا مُّ</>بِينًۭا"},{"n":175,"w":[["فَأَمَّا","fa-ammā","So as for","অতঃপর"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ءَامَنُوا۟","āmanū","believed","ঈমান এনেছে"],["بِٱللَّهِ","bil-lahi","in Allah","আল্লাহর উপর"],["وَٱعْتَصَمُوا۟","wa-i‘'taṣamū","and held fast","ও দৃঢ়তা অবলম্বন করেছে"],["بِهِۦ","bihi","to Him","তাতে"],["فَسَيُدْخِلُهُمْ","fasayud'khiluhum","then He will admit them","অতঃপর শীঘ্রই তাদেরকে  প্রবেশ করাবেন"],["فِى","fī","in","মধ্যে"],["رَحْمَةٍۢ","raḥmatin","Mercy","রহমতের"],["مِّنْهُ","min'hu","from Himself","তাঁর পক্ষ হতে"],["وَفَضْلٍۢ","wafaḍlin","and Bounty","ও অনুগ্রহে"],["وَيَهْدِيهِمْ","wayahdīhim","and will guide them","ও তাদেরকে পরিচালিত করবেন"],["إِلَيْهِ","ilayhi","to Himself","তাঁর দিকে"],["صِرَٰطًۭا","ṣirāṭan","(on) a way","(অর্থাৎ) পথে"],["مُّسْتَقِيمًۭا","mus'taqīman","straight","সরল সঠিক"]],"t":"فَأَ<g>مَّ</>ا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> بِ<h>ٱ</>للَّهِ وَ<h>ٱ</>عْتَصَمُو<s>ا۟</> بِ<m>هِۦ</> فَسَيُ<q>دْ</>خِلُهُمْ فِى رَحْمَ<d>ةٍۢ مِّ</>نْهُ وَفَضْ<d>لٍۢ وَ</>يَهْدِيهِمْ إِلَيْهِ صِ<m>رَٰ</><d>طًۭا مُّ</>سْتَقِيمًۭا"},{"n":176,"w":[["يَسْتَفْتُونَكَ","yastaftūnaka","They seek your ruling","তোমার কাছে সমাধান চায় তারা"],["قُلِ","quli","Say","বল"],["ٱللَّهُ","l-lahu","Allah","''আল্লাহ"],["يُفْتِيكُمْ","yuf'tīkum","gives you a ruling","তোমাদেরকে সমাধান দিচ্ছেন"],["فِى","fī","concerning","ব্যাপারে"],["ٱلْكَلَـٰلَةِ ۚ","l-kalālati","the Kalala","মাতা-পিতাহীনও নিঃসন্তান ব্যক্তির"],["إِنِ","ini","if","যদি"],["ٱمْرُؤٌا۟","im'ru-on","a man","কোন পুরুষ (এ ধরনের)"],["هَلَكَ","halaka","died","মারা যায়"],["لَيْسَ","laysa","(and) not","না (থাকে)"],["لَهُۥ","lahu","he has","তার"],["وَلَدٌۭ","waladun","a child","কোন সন্তান"],["وَلَهُۥٓ","walahu","and he has","ও তার থাকে"],["أُخْتٌۭ","ukh'tun","a sister","এক বোন (বৈমাত্রেয় বা সহোদর)"],["فَلَهَا","falahā","then for her","তার জন্য তবে (অর্থাৎ সেই বোন)"],["نِصْفُ","niṣ'fu","(is) a half","(পাবে) অর্ধেক"],["مَا","mā","(of) what","যা আছে"],["تَرَكَ ۚ","taraka","he left","পরিত্যক্ত সম্পত্তি"],["وَهُوَ","wahuwa","And he","এবং সে (অর্থাৎ ভাই)"],["يَرِثُهَآ","yarithuhā","will inherit from her","তার (অর্থাৎ মৃত বোনের) উত্তরাধিকারী হবে"],["إِن","in","if","যদি"],["لَّمْ","lam","not","না"],["يَكُن","yakun","is","থাকে"],["لَّهَا","lahā","for her","তার (অর্থাৎ বোনের)"],["وَلَدٌۭ ۚ","waladun","a child","কোন সন্তান"],["فَإِن","fa-in","But if","যদি তবে"],["كَانَتَا","kānatā","there were","তারা হয়"],["ٱثْنَتَيْنِ","ith'natayni","two females","দুই (বোন মৃতের উত্তরাধিকারী)"],["فَلَهُمَا","falahumā","then for them","তবে জন্য তাদের দুজনের"],["ٱلثُّلُثَانِ","l-thuluthāni","two thirds","দুই তৃতীয়াংশ"],["مِمَّا","mimmā","of what","তা হতে যা"],["تَرَكَ ۚ","taraka","he left","পরিত্যক্ত সম্পত্তি"],["وَإِن","wa-in","But if","এবং যদি"],["كَانُوٓا۟","kānū","they were","তারা হয়"],["إِخْوَةًۭ","ikh'watan","brothers and sisters","ভাই-বোন"],["رِّجَالًۭا","rijālan","men","পুরুষ (কয়েকজন)"],["وَنِسَآءًۭ","wanisāan","and women","ও নারী (কয়েকজন)"],["فَلِلذَّكَرِ","falildhakari","then the male will have","জন্য তবে একজন পুরুষের"],["مِثْلُ","mith'lu","like","সমান"],["حَظِّ","ḥaẓẓi","share","অংশ"],["ٱلْأُنثَيَيْنِ ۗ","l-unthayayni","(of) the two females","দুই নারীর"],["يُبَيِّنُ","yubayyinu","makes clear","বর্ণনা করেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["لَكُمْ","lakum","to you","তোমাদের জন্য"],["أَن","an","lest","যেন"],["تَضِلُّوا۟ ۗ","taḍillū","you go astray","তোমরা বিভ্রান্ত (না) হও"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["بِكُلِّ","bikulli","of every","সম্পর্কে সব"],["شَىْءٍ","shayin","thing","কিছুর"],["عَلِيمٌۢ","‘alīmun","(is) All-Knower","খুব অবহিত"]],"t":"يَسْتَفْتُونَكَ قُلِ <h>ٱ</>للَّهُ يُفْتِيكُمْ فِى <h>ٱ</>لْكَ<m>لَٰ</>لَةِ ۚ إِنِ <h>ٱ</>مْرُؤٌا۟ هَلَكَ لَيْسَ لَهُ<m>ۥ</> وَلَ<d>دٌۭ وَ</>لَهُ<o>ۥٓ</> أُخْ<k>تٌۭ فَ</>لَهَا نِصْفُ مَا تَرَكَ ۚ وَهُوَ يَرِثُ<o>هَآ</> <w>إِن لَّ</>مْ يَ<w>كُن لَّ</>هَا وَلَ<k>دٌۭ ۚ فَإِن كَ</>انَتَا <h>ٱ</>ثْنَتَيْنِ فَلَهُمَا <h>ٱ</><l>ل</>ثُّلُثَانِ مِ<g>مَّ</>ا تَرَكَ ۚ وَإِ<k>ن كَ</>ا<o>نُوٓ</><s>ا۟</> إِخْوَ<w>ةًۭ رِّ</>جَالًۭ<d>ا وَ</>نِ<o>سَآ</><k>ءًۭ فَ</>لِلذَّكَرِ مِثْلُ حَظِّ <h>ٱ</>لْأُ<k>نثَ</>يَيْنِ ۗ يُبَيِّنُ <h>ٱ</>للَّهُ لَكُمْ أَ<k>ن تَ</>ضِلُّو<s>ا۟ ۗ</> وَ<h>ٱ</>للَّهُ بِكُلِّ شَىْءٍ عَ<p>لِي</>مٌۢ"}]}