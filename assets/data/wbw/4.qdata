rriḍi","And encourage","ও উদ্বুদ্ধ কর (যুদ্ধে)"],["ٱلْمُؤْمِنِينَ ۖ","l-mu'minīna","the believers","মু’মিনদেরকে"],["عَسَى","‘asā","perhaps","হয়ত"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["أَن","an","will","(যে)"],["يَكُفَّ","yakuffa","restrain","খর্ব করবেন"],["بَأْسَ","basa","(the) might","শক্তি (ঐসব লোকদের)"],["ٱلَّذِينَ","alladhīna","(of) those who","যারা"],["كَفَرُوا۟ ۚ","kafarū","disbelieved","কুফুরী করেছে"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["أَشَدُّ","ashaddu","(is) Stronger","প্রবলতর"],["بَأْسًۭا","basan","(in) Might","শক্তিতে"],["وَأَشَدُّ","wa-ashaddu","and Stronger","ও কঠোরতর"],["تَنكِيلًۭا","tankīlan","(in) punishment","শাস্তি দানে"]],"t":"فَ<m>قَٰ</>تِلْ فِى سَبِيلِ <h>ٱ</>للَّهِ لَا تُكَلَّفُ إِلَّا نَفْسَكَ ۚ وَحَرِّضِ <h>ٱ</>لْمُؤْمِنِينَ ۖ عَسَى <h>ٱ</>للَّهُ <d>أَن يَ</>كُفَّ بَأْسَ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟ ۚ</> وَ<h>ٱ</>للَّهُ أَشَدُّ بَأْ<d>سًۭا وَ</>أَشَدُّ تَ<k>نكِ</>يلًۭا"},{"n":85,"w":[["مَّن","man","Whoever","যে"],["يَشْفَعْ","yashfa‘","intercedes ","সুপারিশ করবে"],["شَفَـٰعَةً","shafā‘atan","an intercession","কোন সুপারিশ"],["حَسَنَةًۭ","ḥasanatan","good","উত্তম (কাজের)"],["يَكُن","yakun","will have","থাকবে"],["لَّهُۥ","lahu","for him","তার জন্য"],["نَصِيبٌۭ","naṣībun","a share","একটি অংশ"],["مِّنْهَا ۖ","min'hā","of it","তা থেকে"],["وَمَن","waman","and whoever","ও যে"],["يَشْفَعْ","yashfa‘","intercedes ","সুপারিশ করবে"],["شَفَـٰعَةًۭ","shafā‘atan","an intercession","কোন সুপারিশ"],["سَيِّئَةًۭ","sayyi-atan","evil","মন্দ (কাজের)"],["يَكُن","yakun","will have","থাকবে"],["لَّهُۥ","lahu","for him","তার জন্য"],["كِفْلٌۭ","kif'lun","a portion","একটি অংশ"],["مِّنْهَا ۗ","min'hā","of it","তা থেকে"],["وَكَانَ","wakāna","And is","এবং আছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["عَلَىٰ","‘alā","on","উপর"],["كُلِّ","kulli","every","সব"],["شَىْءٍۢ","shayin","thing","কিছুরই"],["مُّقِيتًۭا","muqītan","a Keeper","দৃষ্টিমান"]],"t":"<d>مَّن يَ</>شْفَعْ شَ<m>فَٰ</>عَةً حَسَنَ<d>ةًۭ يَ</><w>كُن لَّ</>هُ<m>ۥ</> نَصِي<d>بٌۭ مِّ</>نْهَا ۖ وَ<d>مَن يَ</>شْفَعْ شَ<m>فَٰ</>عَ<k>ةًۭ سَ</>يِّئَ<d>ةًۭ يَ</><w>كُن لَّ</>هُ<m>ۥ</> كِفْ<d>لٌۭ مِّ</>نْهَا ۗ وَكَانَ <h>ٱ</>للَّهُ عَلَىٰ كُلِّ <d>شَىْءٍۢ مُّ</>قِيتًۭا"},{"n":86,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["حُيِّيتُم","ḥuyyītum","you are greeted","তোমাদেরকে সালাম করা হয়"],["بِتَحِيَّةٍۢ","bitaḥiyyatin","with a greeting","সম্মান সহকারে"],["فَحَيُّوا۟","faḥayyū","then greet","তোমরাও তখন সালাম দাও"],["بِأَحْسَنَ","bi-aḥsana","with better","উত্তমভাবে"],["مِنْهَآ","min'hā","than it","তার চেয়েও"],["أَوْ","aw","or","বা"],["رُدُّوهَآ ۗ","ruddūhā","return it","তার জওয়াব দাও (অনুরূপ ভাবে)"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["كَانَ","kāna","is","আছেন"],["عَلَىٰ","‘alā","of","উপর"],["كُلِّ","kulli","every","সব"],["شَىْءٍ","shayin","thing","কিছুর"],["حَسِيبًا","ḥasīban","an Accountant","হিসাবগ্রহণকারী"]],"t":"وَإِذَا حُيِّي<f>تُم بِ</>تَحِيَّ<k>ةٍۢ فَ</>حَيُّو<s>ا۟</> بِأَحْسَنَ مِنْ<o>هَآ</> أَوْ رُدُّو<o>هَآ ۗ</> إِ<g>نَّ</> <h>ٱ</>للَّهَ كَانَ عَلَىٰ كُلِّ شَىْءٍ حَسِيبًا"},{"n":87,"w":[["ٱللَّهُ","al-lahu","Allah ","আল্লাহ (এমন সত্তা যে)"],["لَآ","lā","(there is) no","নাই"],["إِلَـٰهَ","ilāha","god","কোন ইলাহ"],["إِلَّا","illā","except","ছাড়া"],["هُوَ ۚ","huwa","Him","তিনি"],["لَيَجْمَعَنَّكُمْ","layajma‘annakum","surely He will gather you","তোমাদের একত্রিত করবেনই"],["إِلَىٰ","ilā","to","(থেকে)"],["يَوْمِ","yawmi","(the) Day","দিনে"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) Resurrection ","কিয়ামাতের"],["لَا","lā","no","নাই"],["رَيْبَ","rayba","doubt","কোন সন্দেহ (বিন্দুমাত্র)"],["فِيهِ ۗ","fīhi","about it","তারে মধ্যে"],["وَمَنْ","waman","And who","এবং কে"],["أَصْدَقُ","aṣdaqu","(is) more truthful","অধিক সত্য"],["مِنَ","mina","than","চেয়ে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["حَدِيثًۭا","ḥadīthan","(in) statement","কথায়"]],"t":"ٱللَّهُ <o>لَآ</> إِ<m>لَٰ</>هَ إِلَّا هُوَ ۚ لَيَ<q>جْ</>مَعَ<g>نَّ</>كُمْ إِلَىٰ يَوْمِ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ لَا رَيْبَ فِيهِ ۗ وَمَنْ أَصْدَقُ مِنَ <h>ٱ</>للَّهِ حَدِيثًۭا"},{"n":88,"w":[["۞ فَمَا","famā","So what","অতঃপর কি হয়েছে"],["لَكُمْ","lakum","(is the matter) with you","তোমাদের"],["فِى","fī","concerning","(মধ্যে)"],["ٱلْمُنَـٰفِقِينَ","l-munāfiqīna","the hypocrites (that)","মুনাফিকদের"],["فِئَتَيْنِ","fi-atayni","(you have become) two parties","(তোমরা) দুই মতের অধিকারী"],["وَٱللَّهُ","wal-lahu","While Allah","অথচ আল্লাহই"],["أَرْكَسَهُم","arkasahum","cast them back","তাদের ঘুরিয়ে দিয়েছেন"],["بِمَا","bimā","for what","এ কারণে যা"],["كَسَبُوٓا۟ ۚ","kasabū","they earned","তারা অর্জন করেছে"],["أَتُرِيدُونَ","aturīdūna","Do you wish","কি তোমরা চাও"],["أَن","an","that","যে"],["تَهْدُوا۟","tahdū","you guide","তোমরা হিদায়াত দিবে"],["مَنْ","man","whom","যাকে"],["أَضَلَّ","aḍalla","is let astray","পথভ্রষ্ট করেছেন"],["ٱللَّهُ ۖ","l-lahu","(by) Allah","আল্লাহ"],["وَمَن","waman","And whoever","অথচ যাকে"],["يُضْلِلِ","yuḍ'lili","is let astray","পথভ্রষ্ট করেন"],["ٱللَّهُ","l-lahu","(by) Allah","আল্লাহ"],["فَلَن","falan","then never","কক্ষনো না তখন"],["تَجِدَ","tajida","will you find","পাবে তুমি"],["لَهُۥ","lahu","for him","তার জন্য"],["سَبِيلًۭا","sabīlan","a way","কোন পথ"]],"t":"۞ فَمَا لَكُمْ فِى <h>ٱ</>لْمُ<m>نَٰ</>فِقِينَ فِئَتَيْنِ وَ<h>ٱ</>للَّهُ أَرْكَسَ<f>هُم بِ</>مَا كَسَ<o>بُوٓ</><s>ا۟</> ۚ أَتُرِيدُونَ أَ<k>ن تَ</>هْدُو<s>ا۟</> مَنْ أَضَلَّ <h>ٱ</>للَّهُ ۖ وَ<d>مَن يُ</>ضْلِلِ <h>ٱ</>للَّهُ فَلَ<k>ن تَ</>جِدَ لَهُ<m>ۥ</> سَبِيلًۭا"},{"n":89,"w":[["وَدُّوا۟","waddū","They wish","তারা কামনা করে"],["لَوْ","law","if","যদি"],["تَكْفُرُونَ","takfurūna","you disbelieve","তোমরা কাফির হয়ে যাও"],["كَمَا","kamā","as","যেমন"],["كَفَرُوا۟","kafarū","they disbelieved","তারা কাফির হয়েছে"],["فَتَكُونُونَ","fatakūnūna","and you would be","তবে তোমরা হয়ে যাবে"],["سَوَآءًۭ ۖ","sawāan","alike","(তাদের সাথে) সমান"],["فَلَا","falā","So (do) not","না সুতরাং"],["تَتَّخِذُوا۟","tattakhidhū","take","তোমরা গ্রহণ করো"],["مِنْهُمْ","min'hum","from them","তাদেরকে"],["أَوْلِيَآءَ","awliyāa","allies","বন্ধুরূপে"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["يُهَاجِرُوا۟","yuhājirū","they emigrate","তারা হিজরত করে"],["فِى","fī","in","(মধ্যে)"],["سَبِيلِ","sabīli","(the) way","পথে"],["ٱللَّهِ ۚ","l-lahi","(of) Allah","আল্লাহর"],["فَإِن","fa-in","But if","অতঃপর যদি"],["تَوَلَّوْا۟","tawallaw","they turn back","তারা মুখ ফিরায়"],["فَخُذُوهُمْ","fakhudhūhum","seize them","তবে তাদের তোমরা ধর"],["وَٱقْتُلُوهُمْ","wa-uq'tulūhum","and kill them","ও তাদেরকে হত্যা কর"],["حَيْثُ","ḥaythu","wherever","যেখানে"],["وَجَدتُّمُوهُمْ ۖ","wajadttumūhum","you find them","তাদের তোমরা পাও"],["وَلَا","walā","And (do) not","এবং না"],["تَتَّخِذُوا۟","tattakhidhū","take","তোমরা গ্রহণ করো (কাউকে)"],["مِنْهُمْ","min'hum","from them","তাদের মধ্য হতে"],["وَلِيًّۭا","waliyyan","any ally","বন্ধুরূপে"],["وَلَا","walā","and not","আর না"],["نَصِيرًا","naṣīran","any helper","সাহায্যকারীরূপে"]],"t":"وَدُّو<s>ا۟</> لَوْ تَكْفُرُونَ كَمَا كَفَرُو<s>ا۟</> فَتَكُونُونَ سَ<o>وَآ</><k>ءًۭ ۖ فَ</>لَا تَتَّخِذُو<s>ا۟</> مِنْهُمْ أَوْلِ<o>يَآ</>ءَ حَتَّىٰ يُهَاجِرُو<s>ا۟</> فِى سَبِيلِ <h>ٱ</>للَّهِ ۚ فَإِ<k>ن تَ</>وَلَّوْ<s>ا۟</> فَخُذُوهُمْ وَ<h>ٱ</><q>قْ</>تُلُوهُمْ حَيْثُ وَجَ<j>د</>تُّمُوهُمْ ۖ وَلَا تَتَّخِذُو<s>ا۟</> مِنْهُمْ وَلِ<d>يًّۭا وَ</>لَا نَصِيرًا"},{"n":90,"w":[["إِلَّا","illā","Except","তবে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["يَصِلُونَ","yaṣilūna","join","মিলিত হয়"],["إِلَىٰ","ilā","[to]","সাথে"],["قَوْمٍۭ","qawmin","a group","(এমন কোন) জাতির"],["بَيْنَكُمْ","baynakum","between you","তোমাদের মাঝে"],["وَبَيْنَهُم","wabaynahum","and between them","ও তাদের মাঝে"],["مِّيثَـٰقٌ","mīthāqun","(is) a treaty","চুক্তি (রয়েছে)"],["أَوْ","aw","or","অথবা"],["جَآءُوكُمْ","jāūkum","those who come to you","তোমাদের কাছে আসে (এমন ভাবে যে)"],["حَصِرَتْ","ḥaṣirat","restraining","অনিচ্ছুক"],["صُدُورُهُمْ","ṣudūruhum","their hearts","তাদের অন্তর"],["أَن","an","that","(যে)"],["يُقَـٰتِلُوكُمْ","yuqātilūkum","they fight you","তোমাদের বিরুদ্ধে যুদ্ধ করতে"],["أَوْ","aw","or","অথবা"],["يُقَـٰتِلُوا۟","yuqātilū","they fight","যুদ্ধ করতে"],["قَوْمَهُمْ ۚ","qawmahum","their people","তাদের জাতির বিরুদ্ধে (তবে ভিন্ন কথা)"],["وَلَوْ","walaw","And if","এবং যদি"],["شَآءَ","shāa","(had) willed","চাইতেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["لَسَلَّطَهُمْ","lasallaṭahum","surely He (would have) given them power","তাদের চাপিয়ে দিতেনই"],["عَلَيْكُمْ","‘alaykum","over you","তোমাদের উপর"],["فَلَقَـٰتَلُوكُمْ ۚ","falaqātalūkum","and surely they (would have) fought you","তোমাদের সাথে তখন যুদ্ধ করতই"],["فَإِنِ","fa-ini","So if","সুতরাং যদি"],["ٱعْتَزَلُوكُمْ","i‘'tazalūkum","they withdraw from you","তোমাদের থেকে সরে দাড়ায়"],["فَلَمْ","falam","and (do) not","অতঃপর না"],["يُقَـٰتِلُوكُمْ","yuqātilūkum","fight against you","তোমাদের সাথে যুদ্ধ করে"],["وَأَلْقَوْا۟","wa-alqaw","and offer","ও তারা প্রস্তাব করে"],["إِلَيْكُمُ","ilaykumu","to you","তোমাদের কাছে"],["ٱلسَّلَمَ","l-salama","[the] peace","শান্তির"],["فَمَا","famā","then not","তবে না"],["جَعَلَ","ja‘ala","(has) made","রেখেছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["لَكُمْ","lakum","for you","তোমাদের জন্য"],["عَلَيْهِمْ","‘alayhim","against them","তাদের বিরুদ্ধে"],["سَبِيلًۭا","sabīlan","a way","(ব্যবস্থা গ্রহণের) কোন পথ"]],"t":"إِلَّا <h>ٱ</>لَّذِينَ يَصِلُونَ إِلَىٰ قَوْ<i>مٍۭ بَ</>يْنَكُمْ وَبَيْنَ<y>هُم مِّ</>ي<m>ثَٰ</>قٌ أَوْ <o>جَآ</>ءُوكُمْ حَصِرَتْ صُدُورُهُمْ <d>أَن يُ</><m>قَٰ</>تِلُوكُمْ أَوْ يُ<m>قَٰ</>تِلُو<s>ا۟</> قَوْمَهُمْ ۚ وَلَوْ <o>شَآ</>ءَ <h>ٱ</>للَّهُ لَسَلَّطَهُمْ عَلَيْكُمْ فَلَ<m>قَٰ</>تَلُوكُمْ ۚ فَإِنِ <h>ٱ</>عْتَزَلُوكُمْ فَلَمْ يُ<m>قَٰ</>تِلُوكُمْ وَأَلْقَوْ<s>ا۟</> إِلَيْكُمُ <h>ٱ</><l>ل</>سَّلَمَ فَمَا جَعَلَ <h>ٱ</>للَّهُ لَكُمْ عَلَيْهِمْ سَبِيلًۭا"},{"n":91,"w":[["سَتَجِدُونَ","satajidūna","You will find","তোমরা পাবে শীঘ্রই"],["ءَاخَرِينَ","ākharīna","others","অপর কতক (মুনাফিক)"],["يُرِيدُونَ","yurīdūna","wishing","তারা চায়"],["أَن","an","that","(যে)"],["يَأْمَنُوكُمْ","yamanūkum","they be secure from you","তোমাদের থেকে নিরাপত্তা পেতে"],["وَيَأْمَنُوا۟","wayamanū","and they be secure from","ও নিরাপত্তা পেতে"],["قَوْمَهُمْ","qawmahum","their people","তাদের জাতি হতেও"],["كُلَّ","kulla","Everytime","যখনই (সুযোগ পায়)"],["مَا","mā","that","(কি)"],["رُدُّوٓا۟","ruddū","they are returned","তারা ফিরে যায়"],["إِلَى","ilā","to","দিকে"],["ٱلْفِتْنَةِ","l-fit'nati","the temptation","ফিতনার"],["أُرْكِسُوا۟","ur'kisū","they are plunged","তারা ঝাঁপিয়ে পড়ে"],["فِيهَا ۚ","fīhā","into it","তার মধ্যে"],["فَإِن","fa-in","So if","অতএব যদি"],["لَّمْ","lam","not","না"],["يَعْتَزِلُوكُمْ","ya‘tazilūkum","they withdraw from you","তোমাদেরর থেকে সরে যায়"],["وَيُلْقُوٓا۟","wayul'qū","and offer","এবং প্রস্তাব ও (না) দেয়"],["إِلَيْكُمُ","ilaykumu","to you","তোমাদের কাছে"],["ٱلسَّلَمَ","l-salama","[the] peace","শান্তি চুক্তির"],["وَيَكُفُّوٓا۟","wayakuffū","and they restrain","ও তারা বিরত (না) রাখে"],["أَيْدِيَهُمْ","aydiyahum","their hands","তাদের হাতগুলো"],["فَخُذُوهُمْ","fakhudhūhum","then seize them","তাদেরকে তোমরা তবে ধর"],["وَٱقْتُلُوهُمْ","wa-uq'tulūhum","and kill them","ও তাদের তোমরা হত্যা কর"],["حَيْثُ","ḥaythu","wherever","যেখানেই"],["ثَقِفْتُمُوهُمْ ۚ","thaqif'tumūhum","you find them","তাদের তোমরা পাও"],["وَأُو۟لَـٰٓئِكُمْ","wa-ulāikum","And those ","ও ঐসব লোকদের"],["جَعَلْنَا","ja‘alnā","We made","আমরা দিয়েছি"],["لَكُمْ","lakum","for you","তোমাদেরকে"],["عَلَيْهِمْ","‘alayhim","against them","তাদের উপর"],["سُلْطَـٰنًۭا","sul'ṭānan","an authority","অধিকার"],["مُّبِينًۭا","mubīnan","clear","সুস্পষ্ট"]],"t":"سَتَجِدُونَ ءَاخَرِينَ يُرِيدُونَ <d>أَن يَ</>أْمَنُوكُمْ وَيَأْمَنُو<s>ا۟</> قَوْمَهُمْ كُلَّ مَا رُ<o>دُّوٓ</><s>ا۟</> إِلَى <h>ٱ</>لْفِتْنَةِ أُرْكِسُو<s>ا۟</> فِيهَا ۚ فَ<w>إِن لَّ</>مْ يَعْتَزِلُوكُمْ وَيُلْ<o>قُوٓ</><s>ا۟</> إِلَيْكُمُ <h>ٱ</><l>ل</>سَّلَمَ وَيَكُ<o>فُّوٓ</><s>ا۟</> أَيْدِيَهُمْ فَخُذُوهُمْ وَ<h>ٱ</><q>قْ</>تُلُوهُمْ حَيْثُ ثَقِفْتُمُوهُمْ ۚ وَأُ<s>و۟</><o>لَٰٓ</>ئِكُمْ جَعَلْنَا لَكُمْ عَلَيْهِمْ سُلْ<m>طَٰ</><d>نًۭا مُّ</>بِينًۭا"},{"n":92,"w":[["وَمَا","wamā","And not","এবং নয়"],["كَانَ","kāna","is","কাজ"],["لِمُؤْمِنٍ","limu'minin","for a believer","মু'মিনদের জন্য"],["أَن","an","that","যে"],["يَقْتُلَ","ya