{"n":86,"a":[{"n":1,"w":[["وَٱلسَّمَآءِ","wal-samāi","By the sky","শপথ আকাশের"],["وَٱلطَّارِقِ","wal-ṭāriqi","and the night comer","এবং রাত্রে আত্মপ্রকাশকারী (নক্ষত্রের)"]],"t":"وَ<h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ وَ<h>ٱ</><l>ل</>طَّارِ<q>قِ</>"},{"n":2,"w":[["وَمَآ","wamā","And what","এবং কিসে"],["أَدْرَىٰكَ","adrāka","can make you know","তোমাকে জানাবে"],["مَا","mā","what","কি সেই"],["ٱلطَّارِقُ","l-ṭāriqu","the night comer (is)","রাতে আত্মপ্রকাশকারী"]],"t":"وَ<o>مَآ</> أَ<q>دْ</>رَ<m>ىٰ</>كَ مَا <h>ٱ</><l>ل</>طَّارِ<q>قُ</>"},{"n":3,"w":[["ٱلنَّجْمُ","al-najmu","(It is) the star","নক্ষত্র"],["ٱلثَّاقِبُ","l-thāqibu","the piercing","উজ্জ্বল"]],"t":"ٱ<l>ل</><g>نَّ</><q>جْ</>مُ <h>ٱ</><l>ل</>ثَّاقِ<q>بُ</>"},{"n":4,"w":[["إِن","in","Not","নেই"],["كُلُّ","kullu","(is) every","কোন"],["نَفْسٍۢ","nafsin","soul","ব্যক্তি"],["لَّمَّا","lammā","but","এ ছাড়া যে"],["عَلَيْهَا","‘alayhā","over it","তার উপর"],["حَافِظٌۭ","ḥāfiẓun","(is) a protector","তত্ত্বাবধায়ক"]],"t":"إِ<k>ن كُ</>لُّ نَفْ<w>سٍۢ لَّ</><g>مَّ</>ا عَلَيْهَا حَافِظٌۭ"},{"n":5,"w":[["فَلْيَنظُرِ","falyanẓuri","So let see","অতএব লক্ষ করা উচিৎ"],["ٱلْإِنسَـٰنُ","l-insānu","man","মানুষের"],["مِمَّ","mimma","from what","কি থেকে"],["خُلِقَ","khuliqa","he is created","সৃষ্টি করা হয়েছে (তাকে)"]],"t":"فَلْيَ<k>نظُ</>رِ <h>ٱ</>لْإِ<k>نسَٰ</>نُ مِ<g>مَّ</> خُلِ<q>قَ</>"},{"n":6,"w":[["خُلِقَ","khuliqa","He is created","সৃষ্টি করা হয়েছে"],["مِن","min","from","থেকে"],["مَّآءٍۢ","māin","a water","পানি"],["دَافِقٍۢ","dāfiqin","ejected","সবেগে স্খলিত"]],"t":"خُلِقَ <d>مِن مَّ</><o>آ</><k>ءٍۢ دَ</>افِ<q>قٍۢ</>"},{"n":7,"w":[["يَخْرُجُ","yakhruju","Coming forth","যা বের হয়"],["مِنۢ","min","from","থেকে"],["بَيْنِ","bayni","between","মাঝ"],["ٱلصُّلْبِ","l-ṣul'bi","the backbone","মেরুদণ্ড"],["وَٱلتَّرَآئِبِ","wal-tarāibi","and the ribs","ও বক্ষপিঞ্জরের"]],"t":"يَخْرُجُ <i>مِنۢ بَ</>يْنِ <h>ٱ</><l>ل</>صُّلْبِ وَ<h>ٱ</><l>ل</>تَّ<o>رَآ</>ئِ<q>بِ</>"},{"n":8,"w":[["إِنَّهُۥ","innahu","Indeed, He","নিশ্চয়ই তিনি"],["عَلَىٰ","‘alā","to","ব্যাপারে"],["رَجْعِهِۦ","raj‘ihi","return him","তার প্রত্যাবর্তনে"],["لَقَادِرٌۭ","laqādirun","(is) Able","অবশ্যই সক্ষম"]],"t":"إِ<g>نَّ</>هُ<m>ۥ</> عَلَىٰ رَ<q>جْ</>عِ<m>هِۦ</> لَقَادِرٌۭ"},{"n":9,"w":[["يَوْمَ","yawma","(The) Day","সেদিন"],["تُبْلَى","tub'lā","will be tested","পরীক্ষা করা হবে"],["ٱلسَّرَآئِرُ","l-sarāiru","the secrets","গোপন বিষয়াবলী"]],"t":"يَوْمَ تُ<q>بْ</>لَى <h>ٱ</><l>ل</>سَّ<o>رَآ</>ئِرُ"},{"n":10,"w":[["فَمَا","famā","Then not","অতঃপর না"],["لَهُۥ","lahu","(is) for him","তার জন্য (থাকবে)"],["مِن","min","any","কোন"],["قُوَّةٍۢ","quwwatin","power","শক্তি"],["وَلَا","walā","and not","আর না"],["نَاصِرٍۢ","nāṣirin","any helper","কোনো সাহায্যকারী"]],"t":"فَمَا لَهُ<m>ۥ</> مِ<k>ن قُ</>وَّ<d>ةٍۢ وَ</>لَا نَاصِرٍۢ"},{"n":11,"w":[["وَٱلسَّمَآءِ","wal-samāi","By the sky","শপথ আকাশের"],["ذَاتِ","dhāti","which","ধারণকারী"],["ٱلرَّجْعِ","l-raj‘i","returns","বৃষ্টির"]],"t":"وَ<h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ ذَاتِ <h>ٱ</><l>ل</>رَّ<q>جْ</>عِ"},{"n":12,"w":[["وَٱلْأَرْضِ","wal-arḍi","And the earth","শপথ পৃথিবীর (যা)"],["ذَاتِ","dhāti","which","বিশিষ্ট"],["ٱلصَّدْعِ","l-ṣad‘i","cracks open","বিদীর্ণ (বক্ষ)"]],"t":"وَ<h>ٱ</>لْأَرْضِ ذَاتِ <h>ٱ</><l>ل</>صَّ<q>دْ</>عِ"},{"n":13,"w":[["إِنَّهُۥ","innahu","Indeed, it","নিশ্চয় তা"],["لَقَوْلٌۭ","laqawlun","(is) surely a Word","অবশ্যই বাণী"],["فَصْلٌۭ","faṣlun","decisive","মীমাংসাকারী"]],"t":"إِ<g>نَّ</>هُ<m>ۥ</> لَقَوْ<k>لٌۭ فَ</>صْلٌۭ"},{"n":14,"w":[["وَمَا","wamā","And not","এবং না"],["هُوَ","huwa","it","তা"],["بِٱلْهَزْلِ","bil-hazli","(is) for amusement","হাসি-ঠাট্টার কথা"]],"t":"وَمَا هُوَ بِ<h>ٱ</>لْهَزْلِ"},{"n":15,"w":[["إِنَّهُمْ","innahum","Indeed, they","নিশ্চয়ই তারা"],["يَكِيدُونَ","yakīdūna","are plotting","ষড়যন্ত্র করছে"],["كَيْدًۭا","kaydan","a plot","ভীষণ ষড়যন্ত্র"]],"t":"إِ<g>نَّ</>هُمْ يَكِيدُونَ كَيْدًۭا"},{"n":16,"w":[["وَأَكِيدُ","wa-akīdu","But I am planning","এবং আমি কৌশল করছি"],["كَيْدًۭا","kaydan","a plan","ভীষণ কৌশল"]],"t":"وَأَكِيدُ كَيْدًۭا"},{"n":17,"w":[["فَمَهِّلِ","famahhili","So give respite","তাই অবকাশ দাও"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","(to) the disbelievers","কাফেরদেরকে"],["أَمْهِلْهُمْ","amhil'hum","Give respite to them ","তাদের অবকাশ দাও"],["رُوَيْدًۢا","ruwaydan","little","কিছুক্ষণের"]],"t":"فَمَهِّلِ <h>ٱ</>لْ<m>كَٰ</>فِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا"}]}