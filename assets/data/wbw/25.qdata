arḍi","the earth","জমিনের"],["هَوْنًۭا","hawnan","(in) humbleness","নম্রভাবে"],["وَإِذَا","wa-idhā","and when","আর যখন"],["خَاطَبَهُمُ","khāṭabahumu","address them","সম্বোধন করে তাদেরকে"],["ٱلْجَـٰهِلُونَ","l-jāhilūna","the ignorant ones","অজ্ঞ লোকেরা"],["قَالُوا۟","qālū","they say","তারা বলে"],["سَلَـٰمًۭا","salāman","Peace","\"(তোমাদেরকে) সালাম\""]],"t":"وَعِبَادُ <h>ٱ</><l>ل</>رَّحْ<m>مَٰ</>نِ <h>ٱ</>لَّذِينَ يَمْشُونَ عَلَى <h>ٱ</>لْأَرْضِ هَوْ<d>نًۭا وَ</>إِذَا خَاطَبَهُمُ <h>ٱ</>لْ<m>جَٰ</>هِلُونَ قَالُو<s>ا۟</> سَ<m>لَٰ</>مًۭا"},{"n":64,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["يَبِيتُونَ","yabītūna","spend (the) night","রাত কাটায়"],["لِرَبِّهِمْ","lirabbihim","before their Lord","উদ্দেশ্যে তাদেের রবের"],["سُجَّدًۭا","sujjadan","prostrating","সিজদায়"],["وَقِيَـٰمًۭا","waqiyāman","and standing","ও দাঁড়ানো অবস্থায়"]],"t":"وَ<h>ٱ</>لَّذِينَ يَبِيتُونَ لِرَبِّهِمْ سُجَّ<d>دًۭا وَ</>قِ<m>يَٰ</>مًۭا"},{"n":65,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["يَقُولُونَ","yaqūlūna","say","বলে"],["رَبَّنَا","rabbanā","Our Lord","\"হে আমাদের রব"],["ٱصْرِفْ","iṣ'rif","Avert","দূর করো"],["عَنَّا","‘annā","from us","হ'তে আমাদের"],["عَذَابَ","‘adhāba","the punishment","শাস্তি"],["جَهَنَّمَ ۖ","jahannama","(of) Hell","জাহান্নামের"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["عَذَابَهَا","‘adhābahā","its punishment","তার শাস্তি"],["كَانَ","kāna","is","হলো"],["غَرَامًا","gharāman","inseparable","প্রাণান্তকর (ধ্বংস)"]],"t":"وَ<h>ٱ</>لَّذِينَ يَقُولُونَ رَبَّنَا <h>ٱ</>صْرِفْ عَ<g>نَّ</>ا عَذَابَ جَهَ<g>نَّ</>مَ ۖ إِ<g>نَّ</> عَذَابَهَا كَانَ غَرَامًا"},{"n":66,"w":[["إِنَّهَا","innahā","Indeed, it","নিশ্চয়ই তা"],["سَآءَتْ","sāat","(is) an evil","কত নিকৃষ্ট"],["مُسْتَقَرًّۭا","mus'taqarran","abode","বিশ্রামস্থল"],["وَمُقَامًۭا","wamuqāman","and resting place","ও বাসস্থান\""]],"t":"إِ<g>نَّ</>هَا <o>سَآ</>ءَتْ مُسْتَقَ<d>رًّۭا وَ</>مُقَامًۭا"},{"n":67,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং তারা (এমন যে)"],["إِذَآ","idhā","when","যখন"],["أَنفَقُوا۟","anfaqū","they spend","ব্যয় করে"],["لَمْ","lam","(are) not extravagant","না"],["يُسْرِفُوا۟","yus'rifū","(are) not extravagant","অমিতব্যয় করে"],["وَلَمْ","walam","and are not stingy","আর না"],["يَقْتُرُوا۟","yaqturū","and are not stingy","কার্পণ্য করে"],["وَكَانَ","wakāna","but are","বরং থাকে"],["بَيْنَ","bayna","between","মাঝে"],["ذَٰلِكَ","dhālika","that ","এই (দু'য়ের)"],["قَوَامًۭا","qawāman","moderate","দন্ডায়মান"]],"t":"وَ<h>ٱ</>لَّذِينَ إِ<o>ذَآ</> أَ<k>نفَ</>قُو<s>ا۟</> لَمْ يُسْرِفُو<s>ا۟</> وَلَمْ يَ<q>قْ</>تُرُو<s>ا۟</> وَكَانَ بَيْنَ <m>ذَٰ</>لِكَ قَوَامًۭا"},{"n":68,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["لَا","lā","(do) not","না"],["يَدْعُونَ","yad‘ūna","invoke","তারা ডাকে"],["مَعَ","ma‘a","with","সাথে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["إِلَـٰهًا","ilāhan","god","উপাস্য"],["ءَاخَرَ","ākhara","another","অন্যকে"],["وَلَا","walā","and (do) not","আর না"],["يَقْتُلُونَ","yaqtulūna","[they] kill","হত্যা করে তারা"],["ٱلنَّفْسَ","l-nafsa","the soul","কোন প্রাণকে"],["ٱلَّتِى","allatī","which","যাকে"],["حَرَّمَ","ḥarrama","Allah has forbidden","নিষিদ্ধ করেছেন"],["ٱللَّهُ","l-lahu","Allah has forbidden","আল্লাহ"],["إِلَّا","illā","except","তবে"],["بِٱلْحَقِّ","bil-ḥaqi","by right","সাথে যথার্থতার (হ'লে ভিন্ন কথা)"],["وَلَا","walā","and (do) not","আর না"],["يَزْنُونَ ۚ","yaznūna","commit unlawful sexual intercourse","ব্যভিচার করে"],["وَمَن","waman","And whoever","এবং যে"],["يَفْعَلْ","yaf‘al","does","করবে"],["ذَٰلِكَ","dhālika","that","এটা"],["يَلْقَ","yalqa","will meet","অর্জন করবে"],["أَثَامًۭا","athāman","a penalty","পাপ"]],"t":"وَ<h>ٱ</>لَّذِينَ لَا يَ<q>دْ</>عُونَ مَعَ <h>ٱ</>للَّهِ إِ<m>لَٰ</>هًا ءَاخَرَ وَلَا يَ<q>قْ</>تُلُونَ <h>ٱ</><l>ل</><g>نَّ</>فْسَ <h>ٱ</>لَّتِى حَرَّمَ <h>ٱ</>للَّهُ إِلَّا بِ<h>ٱ</>لْحَقِّ وَلَا يَزْنُونَ ۚ وَ<d>مَن يَ</>فْعَلْ <m>ذَٰ</>لِكَ يَلْقَ أَثَامًۭا"},{"n":69,"w":[["يُضَـٰعَفْ","yuḍā‘af","Will be doubled","দ্বিগুণ করা হবে"],["لَهُ","lahu","for him","তার জন্যই"],["ٱلْعَذَابُ","l-‘adhābu","the punishment","শাস্তি"],["يَوْمَ","yawma","(on the) Day","দিনে"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) Resurrection","ক্বিয়ামাতের"],["وَيَخْلُدْ","wayakhlud","and he will abide forever","এবং স্থায়ী হবে"],["فِيهِۦ","fīhi","therein","তার মধ্যে"],["مُهَانًا","muhānan","humiliated","হীন অবস্থায়"]],"t":"يُ<m>ضَٰ</>عَفْ لَهُ <h>ٱ</>لْعَذَابُ يَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ وَيَخْلُ<q>دْ</> فِي<m>هِۦ</> مُهَانًا"},{"n":70,"w":[["إِلَّا","illā","Except","তবেে"],["مَن","man","(he) who","যে"],["تَابَ","tāba","repents","তওবা করবে"],["وَءَامَنَ","waāmana","and believes","ও ঈমান আনবে"],["وَعَمِلَ","wa‘amila","and does","ও কাজ করবে"],["عَمَلًۭا","‘amalan","righteous deeds","কর্ম"],["صَـٰلِحًۭا","ṣāliḥan","righteous deeds","সৎ"],["فَأُو۟لَـٰٓئِكَ","fa-ulāika","then (for) those","তখন ঐসব লোকদেরকে"],["يُبَدِّلُ","yubaddilu","Allah will replace","পরিবর্তন করে দিবেন"],["ٱللَّهُ","l-lahu","Allah will replace","আল্লাহ"],["سَيِّـَٔاتِهِمْ","sayyiātihim","their evil deeds","তাদের অন্যায়কে"],["حَسَنَـٰتٍۢ ۗ","ḥasanātin","(with) good ones","ভালোয়"],["وَكَانَ","wakāna","And is","আর হলেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["غَفُورًۭا","ghafūran","Oft-Forgiving","ক্ষমাশীল"],["رَّحِيمًۭا","raḥīman","Most Merciful","পরম দয়ালু"]],"t":"إِلَّا مَ<k>ن تَ</>ابَ وَءَامَنَ وَعَمِلَ عَمَلًۭ<k>ا صَٰلِحًۭا فَ</>أُ<s>و۟</><o>لَٰٓ</>ئِكَ يُبَدِّلُ <h>ٱ</>للَّهُ سَيِّـَٔاتِهِمْ حَسَ<m>نَٰ</><d>تٍۢ ۗ وَ</>كَانَ <h>ٱ</>للَّهُ غَفُو<w>رًۭا رَّ</>حِيمًۭا"},{"n":71,"w":[["وَمَن","waman","And whoever","এবং যে"],["تَابَ","tāba","repents","তওবা করে"],["وَعَمِلَ","wa‘amila","and does","ও কাজ করে"],["صَـٰلِحًۭا","ṣāliḥan","righteous (deeds)","সৎ"],["فَإِنَّهُۥ","fa-innahu","then indeed, he","তখন নিশ্চয়ই সে"],["يَتُوبُ","yatūbu","turns","ফিরে আসে"],["إِلَى","ilā","to","দিকে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["مَتَابًۭا","matāban","(with) repentance","অনুতপ্ত হয়ে"]],"t":"وَمَ<k>ن تَ</>ابَ وَعَمِلَ <m>صَٰ</>لِ<k>حًۭا فَ</>إِ<g>نَّ</>هُ<m>ۥ</> يَتُوبُ إِلَى <h>ٱ</>للَّهِ مَتَابًۭا"},{"n":72,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["لَا","lā","(do) not","না"],["يَشْهَدُونَ","yashhadūna","bear witness","সাক্ষ্য দেয়"],["ٱلزُّورَ","l-zūra","(to) the falsehood","মিথ্যার"],["وَإِذَا","wa-idhā","and when","এবং যখন"],["مَرُّوا۟","marrū","they pass","অতিক্রম করে"],["بِٱللَّغْوِ","bil-laghwi","by futility","পাশ দিয়ে কোন অর্থহীন বিষয়কে"],["مَرُّوا۟","marrū","they pass","তারা অতিক্রম করে"],["كِرَامًۭا","kirāman","(as) dignified ones","ভদ্রভাবে"]],"t":"وَ<h>ٱ</>لَّذِينَ لَا يَشْهَدُونَ <h>ٱ</><l>ل</>زُّورَ وَإِذَا مَرُّو<s>ا۟</> بِ<h>ٱ</><l>ل</>لَّغْوِ مَرُّو<s>ا۟</> كِرَامًۭا"},{"n":73,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং তাদেরকে"],["إِذَا","idhā","when","যখন"],["ذُكِّرُوا۟","dhukkirū","they are reminded","স্মরণ করানো হয়"],["بِـَٔايَـٰتِ","biāyāti","of (the) Verses","প্রতি আয়াতগুলোর"],["رَبِّهِمْ","rabbihim","(of) their Lord","তাদের রবের"],["لَمْ","lam","(do) not","না"],["يَخِرُّوا۟","yakhirrū","fall","তারা পড়ে থাকে"],["عَلَيْهَا","‘alayhā","upon them","তার উপর"],["صُمًّۭا","ṣumman","deaf","অন্ধ"],["وَعُمْيَانًۭا","wa‘um'yānan","and blind","ও বধির হয়ে"]],"t":"وَ<h>ٱ</>لَّذِينَ إِذَا ذُكِّرُو<s>ا۟</> بِـَٔا<m>يَٰ</>تِ رَبِّهِمْ لَمْ يَخِرُّو<s>ا۟</> عَلَيْهَا صُ<d>مًّۭا وَ</>عُمْيَانًۭا"},{"n":74,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["يَقُولُونَ","yaqūlūna","say","বলে"],["رَبَّنَا","rabbanā","Our Lord","\"হে আমাদের রব"],["هَبْ","hab","Grant","তুমি দাও"],["لَنَا","lanā","to us","জন্যে আমাদের"],["مِنْ","min","from","থেকে"],["أَزْوَٰجِنَا","azwājinā","our spouses","আমাদের স্ত্রীদেরকে"],["وَذُرِّيَّـٰتِنَا","wadhurriyyātinā","and our offspring","এবং আমাদের বংশধরদেরকে"],["قُرَّةَ","qurrata","comfort","শীতলতা (অর্থাৎ শান্তি)"],["أَعْيُنٍۢ","a‘yunin","(to) our eyes","চোখের"],["وَٱجْعَلْنَا","wa-ij'‘alnā","and make us","এবং আমাদেরকে বানাও"],["لِلْمُتَّقِينَ","lil'muttaqīna","for the righteous","জন্যে মুত্তাকীদের"],["إِمَامًا","imāman","a leader","নেতা\""]],"t":"وَ<h>ٱ</>لَّذِينَ يَقُولُونَ رَبَّنَا هَ<q>بْ</> لَنَا مِنْ أَزْ<m>وَٰ</>جِنَا وَذُرِّ<m>يَّٰ</>تِنَا قُرَّةَ أَعْيُ<d>نٍۢ وَ</><h>ٱ</><q>جْ</>عَلْنَا لِلْمُتَّقِينَ إِمَامًا"},{"n":75,"w":[["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব লোকদেরকে"],["يُجْزَوْنَ","yuj'zawna","will be awarded","তাদেরকে প্রতিদান দেয়া হবে"],["ٱلْغُرْفَةَ","l-ghur'fata","the Chamber","উচ্চতম কক্ষ"],["بِمَا","bimā","because","যা এ কারণে"],["صَبَرُوا۟","ṣabarū","they were patient","তারা ধৈর্য ধরেছে"],["وَيُلَقَّوْنَ","wayulaqqawna","and they will be met","ও তারা পাবে"],["فِيهَا","fīhā","therein","তার মধ্যে"],["تَحِيَّةًۭ","taḥiyyatan","(with) greetings","অভিবাদন"],["وَسَلَـٰمًا","wasalāman","and peace","ও সালাম"]],"t":"أُ<s>و۟</><o>لَٰٓ</>ئِكَ يُ<q>جْ</>زَوْنَ <h>ٱ</>لْغُرْفَةَ بِمَا صَبَرُو<s>ا۟</> وَيُلَقَّوْنَ فِيهَا تَحِيَّ<d>ةًۭ وَ</>سَ<m>لَٰ</>مًا"},{"n":76,"w":[["خَـٰلِدِينَ","khālidīna","Will abide forever","চিরস্থায়ী হবে"],["فِيهَا ۚ","fīhā","in it","তার মধ্যে"],["حَسُنَتْ","ḥasunat","Good","কত উত্তম হবে"],["مُسْتَقَرًّۭا","mus'taqarran","(is) the settlement","বিশ্রামাগার"],["وَمُقَامًۭا","wamuqāman","and a resting place","আর (কত উত্তম) বাসস্থান"]],"t":"<m>خَٰ</>لِدِينَ فِيهَا ۚ حَسُنَتْ مُسْتَقَ<d>رًّۭا وَ</>مُقَامًۭا"},{"n":77,"w":[["قُلْ","qul","Say","(হে নাবী) বলো"],["مَا","mā","Not","\"না"],["يَعْبَؤُا۟","ya‘ba-u","will care","ভ্রুক্ষেপ করেন তিনি"],["بِكُمْ","bikum","for you","প্রতি তোমাদের"],["رَبِّى","rabbī","my Lord","আমার রব"],["لَوْلَا","lawlā","if not","যদি না"],["دُعَآؤُكُمْ ۖ","du‘āukum","your prayer (is to Him)","তোমাদের প্রার্থনা (হয় তাঁর কাছে)"],["فَقَدْ","faqad","But verily","নিশ্চয়ই (এখন)"],["كَذَّبْتُمْ","kadhabtum","you have denied","তোমরা অস্বীকার করেছো"],["فَسَوْفَ","fasawfa","so soon","ফলে অতিশীঘ্রই"],["يَكُونُ","yakūnu","will be","হবে"],["لِزَامًۢا","lizāman","the inevitable (punishment)","স্থায়ী অনিবার্য (শাস্তি)\""]],"t":"قُلْ مَا يَعْبَؤُ<s>ا۟</> بِكُمْ رَبِّى لَوْلَا دُ<o>عَآ</>ؤُكُمْ ۖ فَقَ<q>دْ</> كَذَّ<q>بْ</>تُمْ فَسَوْفَ يَكُونُ لِزَامًۢا"}]}