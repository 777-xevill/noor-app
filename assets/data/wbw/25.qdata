{"n":25,"a":[{"n":1,"w":[["تَبَارَكَ","tabāraka","Blessed is He","অতীব কল্যাণময়"],["ٱلَّذِى","alladhī","Who","(সেই সত্ত্বা) যিনি"],["نَزَّلَ","nazzala","sent down","অবতীর্ণ করেছেন"],["ٱلْفُرْقَانَ","l-fur'qāna","the Criterion","সত্য-মিথ্যার মাপকাঠি"],["عَلَىٰ","‘alā","upon","উপর"],["عَبْدِهِۦ","‘abdihi","His slave","তাঁর দাসের"],["لِيَكُونَ","liyakūna","that he may be","যেন সে হয়"],["لِلْعَـٰلَمِينَ","lil'‘ālamīna","to the worlds","জন্যে বিশ্ববাসীর"],["نَذِيرًا","nadhīran","a warner ","সতর্ককারী"]],"t":"تَبَارَكَ <h>ٱ</>لَّذِى نَزَّلَ <h>ٱ</>لْفُرْقَانَ عَلَىٰ عَ<q>بْ</>دِ<m>هِۦ</> لِيَكُونَ لِلْ<m>عَٰ</>لَمِينَ نَذِيرًا"},{"n":2,"w":[["ٱلَّذِى","alladhī","The One Who ","যিনি (এমন সত্ত্বা যে)"],["لَهُۥ","lahu","to Him (belongs)","জন্যে তাঁরই"],["مُلْكُ","mul'ku","(the) dominion","সার্বভৌমত্ব"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশমন্ডলীর"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীর"],["وَلَمْ","walam","and not","এবং নি"],["يَتَّخِذْ","yattakhidh","He has taken","তিনি গ্রহন করেন"],["وَلَدًۭا","waladan","a son","কোন সন্তান"],["وَلَمْ","walam","and not","আর না"],["يَكُن","yakun","He has","আছে"],["لَّهُۥ","lahu","for Him","জন্যে তাঁর"],["شَرِيكٌۭ","sharīkun","a partner","কোন শরীক"],["فِى","fī","in","মধ্যে"],["ٱلْمُلْكِ","l-mul'ki","the dominion","সার্বভৌমত্বের"],["وَخَلَقَ","wakhalaqa","and He (has) created","এবং তিনি সৃষ্টি করেছেন"],["كُلَّ","kulla","every","প্রত্যেক"],["شَىْءٍۢ","shayin","thing","জিনিসকে"],["فَقَدَّرَهُۥ","faqaddarahu","and determined it","অতঃপর তা পরিমিত করেছেন"],["تَقْدِيرًۭا","taqdīran","(with) determination","(যথাযথ) পরিমাণে"]],"t":"ٱلَّذِى لَهُ<m>ۥ</> مُلْكُ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ وَلَمْ يَتَّخِذْ وَلَ<d>دًۭا وَ</>لَمْ يَ<w>كُن لَّ</>هُ<m>ۥ</> شَرِي<k>كٌۭ فِ</>ى <h>ٱ</>لْمُلْكِ وَخَلَقَ كُلَّ <k>شَىْءٍۢ فَ</>قَدَّرَهُ<m>ۥ</> تَ<q>قْ</>دِيرًۭا"},{"n":3,"w":[["وَٱتَّخَذُوا۟","wa-ittakhadhū","Yet they have taken","আর (কিছু লোক) তারা গ্রহণ করেছে"],["مِن","min","besides Him","মধ্য হতে"],["دُونِهِۦٓ","dūnihi","besides Him","তাঁর পরিবর্তে"],["ءَالِهَةًۭ","ālihatan","gods","ইলাহরূপে (অন্যদেরকে)"],["لَّا","lā","not","না"],["يَخْلُقُونَ","yakhluqūna","they create","( সেই ইলাহরা) সৃষ্টি করে"],["شَيْـًۭٔا","shayan","anything","কোন কিছু"],["وَهُمْ","wahum","while they","অথচ তাদেরকেই"],["يُخْلَقُونَ","yukh'laqūna","are created","সৃষ্টি করা হয়েছে"],["وَلَا","walā","and not","আর না"],["يَمْلِكُونَ","yamlikūna","they possess","তারা ক্ষমতা রাখে"],["لِأَنفُسِهِمْ","li-anfusihim","for themselves","জন্যেও তাদের নিজেদের"],["ضَرًّۭا","ḍarran","any harm","কোন ক্ষতির"],["وَلَا","walā","and not","আর না"],["نَفْعًۭا","naf‘an","any benefit","উপকারের"],["وَلَا","walā","and not","এবং না"],["يَمْلِكُونَ","yamlikūna","they control","তারা ক্ষমতা রাখে"],["مَوْتًۭا","mawtan","death","মৃত্যুর"],["وَلَا","walā","and not","আর না"],["حَيَوٰةًۭ","ḥayatan","life","জীবনের"],["وَلَا","walā","and not","আর না"],["نُشُورًۭا","nushūran","resurrection","উত্থানের"]],"t":"وَ<h>ٱ</>تَّخَذُو<s>ا۟</> مِ<k>ن دُ</>ونِ<o>هِۦٓ</> ءَالِهَ<w>ةًۭ لَّ</>ا يَخْلُقُونَ شَ<d>يْـًۭٔا وَ</>هُمْ يُخْلَقُونَ وَلَا يَمْلِكُونَ لِأَ<k>نفُ</>سِهِمْ ضَ<d>رًّۭا وَ</>لَا نَفْ<d>عًۭا وَ</>لَا يَمْلِكُونَ مَوْ<d>تًۭا وَ</>لَا حَيَ<s>وٰ</><d>ةًۭ وَ</>لَا نُشُورًۭا"},{"n":4,"w":[["وَقَالَ","waqāla","And say","এবং বলে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوٓا۟","kafarū","disbelieve","অস্বীকার করেছে"],["إِنْ","in","Not","\"নয়"],["هَـٰذَآ","hādhā","this","এই (কুরআন)"],["إِلَّآ","illā","(is) but","এ ছাড়া"],["إِفْكٌ","if'kun","a lie","মনগড়া জিনিস"],["ٱفْتَرَىٰهُ","if'tarāhu","he invented it","তা (মুহাম্মাদ সাল্লাল্লাহু 'অালাইহি ওয়া সাল্লাম) রচনা করেছে"],["وَأَعَانَهُۥ","wa-a‘ānahu","and helped him","ও তাকে সাহায্য করেছে"],["عَلَيْهِ","‘alayhi","at it","এক্ষেত্রে"],["قَوْمٌ","qawmun","people","লোকেরা"],["ءَاخَرُونَ ۖ","ākharūna","other","অন্য সব\""],["فَقَدْ","faqad","But verily","এভাবে নিশ্চয়ই"],["جَآءُو","jāū","they (have) produced","তারা এসেছে"],["ظُلْمًۭا","ẓul'man","an injustice","সীমালঙ্ঘনে"],["وَزُورًۭا","wazūran","and a lie","ও মিথ্যায়"]],"t":"وَقَالَ <h>ٱ</>لَّذِينَ كَفَ<o>رُوٓ</><s>ا۟</> إِنْ <m>هَٰ</><o>ذَآ</> إِ<o>لَّآ</> إِفْكٌ <h>ٱ</>فْتَرَ<m>ىٰ</>هُ وَأَعَانَهُ<m>ۥ</> عَلَيْهِ قَوْمٌ ءَاخَرُونَ ۖ فَقَ<q>دْ</> <o>جَآ</>ءُو ظُلْ<d>مًۭا وَ</>زُورًۭا"},{"n":5,"w":[["وَقَالُوٓا۟","waqālū","And they say","এবং তারা বলে"],["أَسَـٰطِيرُ","asāṭīru","Tales","\"(এই কুরআন) উপকথার সমাহার"],["ٱلْأَوَّلِينَ","l-awalīna","(of) the former people","পূর্বকালের"],["ٱكْتَتَبَهَا","ik'tatabahā","which he has had written","তা সে লিখিয়ে নিয়েছে"],["فَهِىَ","fahiya","and they","অতঃপর তা"],["تُمْلَىٰ","tum'lā","are dictated","তিলাওয়াত করা হয়"],["عَلَيْهِ","‘alayhi","to him","তার নিকট"],["بُكْرَةًۭ","buk'ratan","morning","সকালে"],["وَأَصِيلًۭا","wa-aṣīlan","and evening","ও সন্ধ্যায়\""]],"t":"وَقَا<o>لُوٓ</><s>ا۟</> أَ<m>سَٰ</>طِيرُ <h>ٱ</>لْأَوَّلِينَ <h>ٱ</>كْتَتَبَهَا فَهِىَ تُمْلَىٰ عَلَيْهِ بُكْرَ<d>ةًۭ وَ</>أَصِيلًۭا"},{"n":6,"w":[["قُلْ","qul","Say","বলো (হে নাবী)"],["أَنزَلَهُ","anzalahu","Has sent it down","\"তা অবতীর্ণ করেছেন"],["ٱلَّذِى","alladhī","the One Who","(এমন সত্ত্বা) যিনি"],["يَعْلَمُ","ya‘lamu","knows","জানেন"],["ٱلسِّرَّ","l-sira","the secret","(সমুদয়) রহস্য (গোপন)"],["فِى","fī","in","মধ্যকার"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশমন্ডলীর"],["وَٱلْأَرْضِ ۚ","wal-arḍi","and the earth","ও পৃথিবীর"],["إِنَّهُۥ","innahu","Indeed, He","নিশ্চয়ই তিনি"],["كَانَ","kāna","is","হলেন"],["غَفُورًۭا","ghafūran","Oft-Forgiving","ক্ষমাশীল"],["رَّحِيمًۭا","raḥīman","Most Merciful","পরম দয়ালু\""]],"t":"قُلْ أَ<k>نزَ</>لَهُ <h>ٱ</>لَّذِى يَعْلَمُ <h>ٱ</><l>ل</>سِّرَّ فِى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ ۚ إِ<g>نَّ</>هُ<m>ۥ</> كَانَ غَفُو<w>رًۭا رَّ</>حِيمًۭا"},{"n":7,"w":[["وَقَالُوا۟","waqālū","And they say","এবং তারা বলে"],["مَالِ","māli","Why does","\"কেমন"],["هَـٰذَا","hādhā","this","এই"],["ٱلرَّسُولِ","l-rasūli","Messenger","রাসূল"],["يَأْكُلُ","yakulu","eat","সে খায়"],["ٱلطَّعَامَ","l-ṭa‘āma","[the] food","খাবার"],["وَيَمْشِى","wayamshī","and walk","ও চলাফেরা করে"],["فِى","fī","in","মধ্যে"],["ٱلْأَسْوَاقِ ۙ","l-aswāqi","the markets","হাট বাজারসমূহে"],["لَوْلَآ","lawlā","Why not","কেন না"],["أُنزِلَ","unzila","is sent down","অবতীর্ণ করা হলো"],["إِلَيْهِ","ilayhi","to him","তার কাছে"],["مَلَكٌۭ","malakun","an Angel","কোন ফেরেশতা"],["فَيَكُونَ","fayakūna","then he be","অতঃপর সে হতো"],["مَعَهُۥ","ma‘ahu","with him","তার সাথে"],["نَذِيرًا","nadhīran","a warner","ভীতি প্রদর্শনকারী"]],"t":"وَقَالُو<s>ا۟</> مَالِ <m>هَٰ</>ذَا <h>ٱ</><l>ل</>رَّسُولِ يَأْكُلُ <h>ٱ</><l>ل</>طَّعَامَ وَيَمْشِى فِى <h>ٱ</>لْأَسْوَاقِ ۙ لَوْ<o>لَآ</> أُ<k>نزِ</>لَ إِلَيْهِ مَلَ<k>كٌۭ فَ</>يَكُونَ مَعَهُ<m>ۥ</> نَذِيرًا"},{"n":8,"w":[["أَوْ","aw","Or","অথবা"],["يُلْقَىٰٓ","yul'qā","is delivered","নিক্ষেপ করা হতো"],["إِلَيْهِ","ilayhi","to him","তার কাছে"],["كَنزٌ","kanzun","a treasure","কোন ধনভান্ডার"],["أَوْ","aw","or","অথবা"],["تَكُونُ","takūnu","is","হতো"],["لَهُۥ","lahu","for him","জন্যে তার"],["جَنَّةٌۭ","jannatun","a garden","একটি বাগান"],["يَأْكُلُ","yakulu","he may eat","সে খেতো"],["مِنْهَا ۚ","min'hā","from it","তা হ'তে"],["وَقَالَ","waqāla","And say","এবং বলেে"],["ٱلظَّـٰلِمُونَ","l-ẓālimūna","the wrongdoers","সীমালঙ্ঘনকারীরা"],["إِن","in","Not","\"না"],["تَتَّبِعُونَ","tattabi‘ūna","you follow","তোমরা অনুসরণ করছো"],["إِلَّا","illā","but","এ ছাড়া"],["رَجُلًۭا","rajulan","a man","এক ব্যক্তিকে"],["مَّسْحُورًا","masḥūran","bewitched","জাদুগ্রস্ত\""]],"t":"أَوْ يُلْقَ<o>ىٰٓ</> إِلَيْهِ كَ<k>نزٌ</> أَوْ تَكُونُ لَهُ<m>ۥ</> جَ<g>نَّ</><d>ةٌۭ يَ</>أْكُلُ مِنْهَا ۚ وَقَالَ <h>ٱ</><l>ل</><m>ظَّٰ</>لِمُونَ إِ<k>ن تَ</>تَّبِعُونَ إِلَّا رَجُلًۭ<d>ا مَّ</>سْحُورًا"},{"n":9,"w":[["ٱنظُرْ","unẓur","See","লক্ষ্য করো"],["كَيْفَ","kayfa","how","কেমন"],["ضَرَبُوا۟","ḍarabū","they set forth","পেশ করেছে"],["لَكَ","laka","for you","জন্যে তোমার"],["ٱلْأَمْثَـٰلَ","l-amthāla","the similitudes","উপমাসমূহ"],["فَضَلُّوا۟","faḍallū","but they have gone astray","এভাবে তারা বিভ্রান্ত হয়েছে"],["فَلَا","falā","so not","অতএব না"],["يَسْتَطِيعُونَ","yastaṭī‘ūna","they are able (to find)","তারা পেতে পারে"],["سَبِيلًۭا","sabīlan","a way","কোন (সঠিক) পথ"]],"t":"ٱ<k>نظُ</>رْ كَيْفَ ضَرَبُو<s>ا۟</> لَكَ <h>ٱ</>لْأَمْ<m>ثَٰ</>لَ فَضَلُّو<s>ا۟</> فَلَا يَسْتَطِيعُونَ سَبِيلًۭا"},{"n":10,"w":[["تَبَارَكَ","tabāraka","Blessed is He","অতীব কল্যাণময়"],["ٱلَّذِىٓ","alladhī","Who","(সেই সত্ত্বা) যিনি"],["إِن","in","if","যদি"],["شَآءَ","shāa","He willed","চান তিনি"],["جَعَلَ","ja‘ala","(could have) made","দিতে পারেন"],["لَكَ","laka","for you","জন্যে তোমার"],["خَيْرًۭا","khayran","better","(আরও) উত্তম"],["مِّن","min","than","চেয়েও"],["ذَٰلِكَ","dhālika","that ","এর"],["جَنَّـٰتٍۢ","jannātin","gardens ","(অনেক) বাগান"],["تَجْرِى","tajrī","flow","প্রবাহিত হয়"],["مِن","min","from","থেকে"],["تَحْتِهَا","taḥtihā","underneath it","তার নিচ"],["ٱلْأَنْهَـٰرُ","l-anhāru","the rivers","ঝর্ণাধারাসমূহ"],["وَيَجْعَل","wayaj‘al","and He (could) make","এবং দিতে পারেন"],["لَّكَ","laka","for you","জন্যে তোমার"],["قُصُورًۢا","quṣūran","palaces","(অনেক) প্রাসাদ"]],"t":"تَبَارَكَ <h>ٱ</>لَّ<o>ذِىٓ</> إِ<k>ن شَ</><o>آ</>ءَ جَعَلَ لَكَ خَيْ<d>رًۭا مِّ</><k>ن ذَٰ</>لِكَ جَ<g>نَّٰ</><k>تٍۢ تَ</><q>جْ</>رِى مِ<k>ن تَ</>حْتِهَا <h>ٱ</>لْأَنْ<m>هَٰ</>رُ وَيَ<q>جْ</>عَل لَّكَ قُصُورًۢا"},{"n":11,"w":[["بَلْ","bal","Nay","কিন্তু"],["كَذَّبُوا۟","kadhabū","they deny","তারা মিথ্যা ভাবছে"],["بِٱلسَّاعَةِ ۖ","bil-sā‘ati","the Hour","ব্যাপারকে ক্বিয়ামাতের"],["وَأَعْتَدْنَا","wa-a‘tadnā","and We have prepared","আর আমরা প্রস্তুত করে রেখেছি"],["لِمَن","liman","for (those) who","জন্যে (তার) যে"],["كَذَّبَ","kadhaba","deny","মিথ্যারোপ করেছে"],["بِٱلسَّاعَةِ","bil-sā‘ati","the Hour","ব্যাপারকে ক্বিয়ামাতের"],["سَعِيرًا","sa‘īran","a Blazing Fire","জ্বলন্ত অাগুন"]],"t":"بَلْ كَذَّبُو<s>ا۟</> بِ<h>ٱ</><l>ل</>سَّاعَةِ ۖ وَأَعْتَ<q>دْ</>نَا لِمَ<k>ن كَ</>ذَّبَ بِ<h>ٱ</><l>ل</>سَّاعَةِ سَعِيرًا"},{"n":12,"w":[["إِذَا","idhā","When","যখন (আগুন )"],["رَأَتْهُم","ra-athum","it sees them","তুমি দেখবে তাদেরকে"],["مِّن","min","from","হ'তে"],["مَّكَانٍۭ","makānin","a place","জায়গা"],["بَعِيدٍۢ","ba‘īdin","far","দূরবর্তী"],["سَمِعُوا۟","sami‘ū","they will hear","তারা শুনতে পাবে (তখন)"],["لَهَا","lahā","its","প্রতি তার"],["تَغَيُّظًۭا","taghayyuẓan","raging","ক্রোধের গর্জন"],["وَزَفِيرًۭا","wazafīran","and roaring","ও চীৎকার"]],"t":"إِذَا رَأَتْ<y>هُم مِّ</><d>ن مَّ</>كَا<i>نٍۭ بَ</>عِي<k>دٍۢ سَ</>مِعُو<s>ا۟</> لَهَا تَغَيُّ<d>ظًۭا وَ</>زَفِيرًۭا"},{"n":13,"w":[["وَإِذَآ","wa-idhā","And when","এবং যখন"],["أُلْقُوا۟","ul'qū","they are thrown","নিক্ষেপ করা হবে"],["مِنْهَا","min'hā","thereof","তার মধ্যে"],["مَكَانًۭا","makānan","(in) a place","জায়গায়"],["ضَيِّقًۭا","ḍayyiqan","narrow","সংকীর্ণ"],["مُّقَرَّنِينَ","muqarranīna","bound in chains","শিকল পরা অবস্থায়"],["دَعَوْا۟","da‘aw","they will call","তারা ডাকবে"],["هُنَالِكَ","hunālika","there","সেখানে"],["ثُبُورًۭا","thubūran","(for) destruction","মৃত্যুকে (ধ্বংস)"]],"t":"وَإِ<o>ذَآ</> أُلْقُو<s>ا۟</> مِنْهَا مَكَا<k>نًۭا ضَ</>يِّ<d>قًۭا مُّ</>قَرَّنِينَ دَعَوْ<s>ا۟</> هُنَالِكَ ثُبُورًۭا"},{"n":14,"w":[["لَّا","lā","(Do) not","\"(বলা হবে) না"],["تَدْعُوا۟","tad‘ū","call","তোমরা ডাকো"],["ٱلْيَوْمَ","l-yawma","this day","আজ"],["ثُبُورًۭا","thubūran","(for) destruction","মৃত্যুকে (ধ্বংস)"],["وَٰحِدًۭا","wāḥidan","one","এক (বার)"],["وَٱدْعُوا۟","wa-id'‘ū","but call","বরং তোমরা ডাকো"],["ثُبُورًۭا","thubūran","(for) destructions","মৃত্যু"],["كَثِيرًۭا","kathīran","many","বহুবার\""]],"t":"لَّا تَ<q>دْ</>عُو<s>ا۟</> <h>ٱ</>لْيَوْمَ ثُبُو<d>رًۭا وَٰحِدًۭا وَ</><h>ٱ</><q>دْ</>عُو<s>ا۟</> ثُبُو<k>رًۭا كَ</>ثِيرًۭا"},{"n":15,"w":[["قُلْ","qul","Say","বলো"],["أَذَٰلِكَ","adhālika","Is that","\"কি এটা"],["خَيْرٌ","khayrun","better","উত্তম"],["أَمْ","am","or","না"],["جَنَّةُ","jannatu","Garden","জান্নাত"],["ٱلْخُلْدِ","l-khul'di","(of) Eternity","চিরস্থায়ী"],["ٱلَّتِى","allatī","which","যা"],["وُعِدَ","wu‘ida","is promised","প্রতিশ্রুতি দেয়া হয়েছে"],["ٱلْمُتَّقُونَ ۚ","l-mutaqūna","(to) the righteous","মুত্তাকীদেরকে"],["كَانَتْ","kānat","It will be","(সেটা) হবে"],["لَهُمْ","lahum","for them","জন্যে তাদের"],["جَزَآءًۭ","jazāan","a reward","পুরস্কার"],["وَمَصِيرًۭا","wamaṣīran","and destination","ও প্রত্যাবর্তনস্থল"]],"t":"قُلْ أَ<m>ذَٰ</>لِكَ خَيْرٌ أَمْ جَ<g>نَّ</>ةُ <h>ٱ</>لْخُلْدِ <h>ٱ</>لَّتِى وُعِدَ <h>ٱ</>لْمُتَّقُونَ ۚ كَانَتْ لَهُمْ جَ<o>زَآ</><d>ءًۭ وَ</>مَصِيرًۭا"},{"n":16,"w":[["لَّهُمْ","lahum","For them","জন্যে তাদের (থাকবে)"],["فِيهَا","fīhā","therein","তার মধ্যে"],["مَا","mā","(is) whatever","যা"],["يَشَآءُونَ","yashāūna","they wish","তারা চাইবে"],["خَـٰلِدِينَ ۚ","khālidīna","they will abide forever","তারা স্থায়ী হবে (সেখানে)"],["كَانَ","kāna","It is","(এটা) হলো"],["عَلَىٰ","‘alā","on","উপর"],["رَبِّكَ","rabbika","your Lord","তোমার রবের"],["وَعْدًۭا","wa‘dan","a promise","প্রতিশ্রুতি"],["مَّسْـُٔولًۭا","masūlan","requested","অবশ্য পালনীয়\""]],"t":"لَّهُمْ فِيهَا مَا يَ<o>شَآ</>ءُونَ <m>خَٰ</>لِدِينَ ۚ كَانَ عَلَىٰ رَبِّكَ وَعْ<d>دًۭا مَّ</>سْـُٔولًۭا"},{"n":17,"w":[["وَيَوْمَ","wayawma","And (the) Day","আর যেদিন"],["يَحْشُرُهُمْ","yaḥshuruhum","He will gather them","তিনি একত্র করবেন তাদেরকে"],["وَمَا","wamā","and what","এবং যাদেরকে"],["يَعْبُدُونَ","ya‘budūna","they worship","তারা ইবাদাত করতো"],["مِن","min","besides Allah","থেকে"],["دُونِ","dūni","besides Allah","পরিবর্তে"],["ٱللَّهِ","l-lahi","besides Allah","আল্লাহর"],["فَيَقُولُ","fayaqūlu","and He will say","তখন তিনি বলবেন"],["ءَأَنتُمْ","a-antum","Did you","\"কি তোমরাই"],["أَضْلَلْتُمْ","aḍlaltum","[you] mislead","তোমরা বিভ্রান্ত করেছিলে"],["عِبَادِى","‘ibādī","My slaves","আমার দাসদেরকে"],["هَـٰٓؤُلَآءِ","hāulāi","these","এসব"],["أَمْ","am","or","না"],["هُمْ","hum","they","তারাই"],["ضَلُّوا۟","ḍallū","went astray","ভ্রান্ত হয়েছিলো"],["ٱلسَّبِيلَ","l-sabīla","(from) the way","পথ\""]],"t":"وَيَوْمَ يَحْشُرُهُمْ وَمَا يَعْبُدُونَ مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ فَيَقُولُ ءَأَ<k>نتُ</>مْ أَضْلَلْتُمْ عِبَادِى <o>هَٰٓؤُلَآ</>ءِ أَمْ هُمْ ضَلُّو<s>ا۟</> <h>ٱ</><l>ل</>سَّ<p>بِي</>لَ"},{"n":18,"w":[["قَالُوا۟","qālū","They say","তারা বলবে"],["سُبْحَـٰنَكَ","sub'ḥānaka","Glory be to You","\"সত্ত্বা আপনার পবিত্র মহান"],["مَا","mā","Not","না"],["كَانَ","kāna","it was proper","ছিলো"],["يَنۢبَغِى","yanbaghī","it was proper","উচিত"],["لَنَآ","lanā","for us","জন্যে আমাদের"],["أَن","an","that","যে"],["نَّتَّخِذَ","nattakhidha","we take","গ্রহণ করবো আমরা"],["مِن","min","besides You","থেকে"],["دُونِكَ","dūnika","besides You","আপনার পরিবর্তে"],["مِنْ","min","any","কোন"],["أَوْلِيَآءَ","awliyāa","protectors","অভিভাবক"],["وَلَـٰكِن","walākin","But","কিন্তু"],["مَّتَّعْتَهُمْ","matta‘tahum","You gave them comforts","আপনি ভোগ-সম্ভার দিয়েছেলেন তাদেরকে"],["وَءَابَآءَهُمْ","waābāahum","and their forefathers","এবং তাদের পিতৃ পুরুষদেরকেও"],["حَتَّىٰ","ḥattā","until","শেষ পর্যন্ত"],["نَسُوا۟","nasū","they forgot","তারা ভুলে গিয়েছিলো"],["ٱلذِّكْرَ","l-dhik'ra","the Message","(আপনার) স্মরণ"],["وَكَانُوا۟","wakānū","and became","এবং তারা হয়েছিলো"],["قَوْمًۢا","qawman","a people","জাতিতে"],["بُورًۭا","būran","ruined","ধ্বংসপ্রাপ্ত\""]],"t":"قَالُو<s>ا۟</> سُ<q>بْ</><m>حَٰ</>نَكَ مَا كَانَ يَ<i>نۢبَ</>غِى لَ<o>نَآ</> <d>أَن نَّ</>تَّخِذَ مِ<k>ن دُ</>ونِكَ مِنْ أَوْلِ<o>يَآ</>ءَ وَ<m>لَٰ</><d>كِن مَّ</>تَّعْتَهُمْ وَءَا<o>بَآ</>ءَهُمْ حَتَّىٰ نَسُو<s>ا۟</> <h>ٱ</><l>ل</>ذِّكْرَ وَكَانُو<s>ا۟</> قَوْ<i>مًۢا بُ</>ورًۭا"},{"n":19,"w":[["فَقَدْ","faqad","So verily","\"তখন নিশ্চয়ই"],["كَذَّبُوكُم","kadhabūkum","they deny you","তারা মিথ্যা সাব্যস্ত করেছে তোমাদেরকে"],["بِمَا","bimā","in what","ঐবিষয় যা"],["تَقُولُونَ","taqūlūna","you say","তোমরা বলছো"],["فَمَا","famā","so not","সুতরাং না"],["تَسْتَطِيعُونَ","tastaṭī‘ūna","you are able","তোমরা পারবে"],["صَرْفًۭا","ṣarfan","(to) avert","ফিরাতে (শাস্তি)"],["وَلَا","walā","and not","আর না"],["نَصْرًۭا ۚ","naṣran","(to) help","সাহায্যও (পাবে)\""],["وَمَن","waman","And whoever","আর যে"],["يَظْلِم","yaẓlim","does wrong","সীমালঙ্ঘন করবে"],["مِّنكُمْ","minkum","among you","তোমাদের মধ্য হ'তে"],["نُذِقْهُ","nudhiq'hu","We will make him taste","তাকে আস্বাদ করাবো আমরা"],["عَذَابًۭا","‘adhāban","a punishment","শাস্তি"],["كَبِيرًۭا","kabīran","great","গুরুতর"]],"t":"فَقَ<q>دْ</> كَذَّبُو<f>كُم بِ</>مَا تَقُولُونَ فَمَا تَسْتَطِيعُونَ صَرْ<d>فًۭا وَ</>لَا نَصْ<d>رًۭا ۚ وَمَن يَ</>ظْ<y>لِم مِّ</><k>نكُ</>مْ نُذِ<q>قْ</>هُ عَذَا<k>بًۭا كَ</>بِيرًۭا"},{"n":20,"w":[["وَمَآ","wamā","And not","আর (হে নাবী) না"],["أَرْسَلْنَا","arsalnā","We sent","আমরা পাঠিয়েছি"],["قَبْلَكَ","qablaka","before you","তোমার পূর্বে (কাউকে)"],["مِنَ","mina","any","মধ্য হ'তে"],["ٱلْمُرْسَلِينَ","l-mur'salīna","Messengers","রাসূলদের"],["إِلَّآ","illā","but","এ ছাড়া যে"],["إِنَّهُمْ","innahum","indeed, they","নিশ্চয়ই তারা"],["لَيَأْكُلُونَ","layakulūna","[surely] ate","অবশ্যই তারা খায়"],["ٱلطَّعَامَ","l-ṭa‘āma","food","খাবার"],["وَيَمْشُونَ","wayamshūna","and walked","ও চলাফেরা করে"],["فِى","fī","in","মধ্যে"],["ٱلْأَسْوَاقِ ۗ","l-aswāqi","the markets","হাট-বাজারগুলোর"],["وَجَعَلْنَا","waja‘alnā","And We have made","আর আমরা করেছি"],["بَعْضَكُمْ","ba‘ḍakum","some of you","একে তোমাদের"],["لِبَعْضٍۢ","liba‘ḍin","for others","জন্যে অপরের"],["فِتْنَةً","fit'natan","a trial","পরীক্ষাস্বরূপ"],["أَتَصْبِرُونَ ۗ","ataṣbirūna","will you have patience","তোমরা ধৈর্য ধারণ করবে কি"],["وَكَانَ","wakāna","And is","আর (জেনে রেখো) হলেন"],["رَبُّكَ","rabbuka","your Lord","তোমার রব (এমন যে)"],["بَصِيرًۭا","baṣīran","All-Seer","তিনি সবকিছু দেখেন"]],"t":"وَ<o>مَآ</> أَرْسَلْنَا قَ<q>بْ</>لَكَ مِنَ <h>ٱ</>لْمُرْسَلِينَ إِ<o>لَّآ</> إِ<g>نَّ</>هُمْ لَيَأْكُلُونَ <h>ٱ</><l>ل</>طَّعَامَ وَيَمْشُونَ فِى <h>ٱ</>لْأَسْوَاقِ ۗ وَجَعَلْنَا بَعْضَكُمْ لِبَعْ<k>ضٍۢ فِ</>تْنَةً أَتَصْبِرُونَ ۗ وَكَانَ رَبُّكَ بَصِيرًۭا"},{"n":21,"w":[["۞ وَقَالَ","waqāla","And said","এবং বলবে"],["ٱلَّذِينَ","alladhīna","those who","(তারা) যারা"],["لَا","lā","(do) not","না"],["يَرْجُونَ","yarjūna","expect","আশা করে"],["لِقَآءَنَا","liqāanā","(the) meeting with Us","প্রতি আমাদের সাক্ষাতের"],["لَوْلَآ","lawlā","Why not","\"কেন না"],["أُنزِلَ","unzila","are sent down","অবতীর্ণ করা হলো"],["عَلَيْنَا","‘alaynā","to us","আমাদের উপর"],["ٱلْمَلَـٰٓئِكَةُ","l-malāikatu","the Angels","ফেরেশতাদের"],["أَوْ","aw","or","অথবা"],["نَرَىٰ","narā","we see","আমরা প্রত্যক্ষ করি"],["رَبَّنَا ۗ","rabbanā","our Lord","আমাদের রবকে\""],["لَقَدِ","laqadi","Indeed","নিশ্চয়ই"],["ٱسْتَكْبَرُوا۟","is'takbarū","they have become arrogant","তারা অহঙ্কার করেছে"],["فِىٓ","fī","within","মধ্যে"],["أَنفُسِهِمْ","anfusihim","themselves","নিজেদের মনের তাদের"],["وَعَتَوْ","wa‘ataw","and (become) insolent","ও  অবাধ্য হয়েছে"],["عُتُوًّۭا","‘utuwwan","(with) insolence","অবাধ্য"],["كَبِيرًۭا","kabīran","great","গুরুতর"]],"t":"۞ وَقَالَ <h>ٱ</>لَّذِينَ لَا يَرْجُونَ لِ<o>قَآ</>ءَنَا لَوْ<o>لَآ</> أُ<k>نزِ</>لَ عَلَيْنَا <h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةُ أَوْ نَرَىٰ رَبَّنَا ۗ لَقَدِ <h>ٱ</>سْتَكْبَرُو<s>ا۟</> <o>فِىٓ</> أَ<k>نفُ</>سِهِمْ وَعَتَوْ عُتُ<k>وًّۭا كَ</>بِيرًۭا"},{"n":22,"w":[["يَوْمَ","yawma","(The) Day","যেদিন"],["يَرَوْنَ","yarawna","they see","তারা দেখবে"],["ٱلْمَلَـٰٓئِكَةَ","l-malāikata","the Angels","ফেরেশতাদেরকে"],["لَا","lā","no","না"],["بُشْرَىٰ","bush'rā","glad tidings","সুসংবাদ (থাকবে)"],["يَوْمَئِذٍۢ","yawma-idhin","(will be) that Day","সেদিন"],["لِّلْمُجْرِمِينَ","lil'muj'rimīna","for the criminals","জন্যে অপরাধীদের"],["وَيَقُولُونَ","wayaqūlūna","and they will say","এবং তারা বলবে (আছে কি)"],["حِجْرًۭا","ḥij'ran","A partition","\"কোন আড়াল"],["مَّحْجُورًۭا","maḥjūran","forbidden","দুর্ভেদ্য\""]],"t":"يَوْمَ يَرَوْنَ <h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةَ لَا بُشْرَىٰ يَوْمَئِ<w>ذٍۢ لِّ</>لْمُ<q>جْ</>رِمِينَ وَيَقُولُونَ حِ<q>جْ</><d>رًۭا مَّ</>حْجُورًۭا"},{"n":23,"w":[["وَقَدِمْنَآ","waqadim'nā","And We will proceed","এবং আমরা অগ্রসর হবো (বিবেচনা করবো)"],["إِلَىٰ","ilā","to","(তার) প্রতি"],["مَا","mā","whatever","যা"],["عَمِلُوا۟","‘amilū","they did","তারা করেছে"],["مِنْ","min","of","কোন"],["عَمَلٍۢ","‘amalin","(the) deed(s)","কাজ"],["فَجَعَلْنَـٰهُ","faja‘alnāhu","and We will make them","অতঃপর তা আমরা পরিণত করবো"],["هَبَآءًۭ","habāan","(as) dust","ধুলিকণায়"],["مَّنثُورًا","manthūran","dispersed","বিক্ষিপ্ত"]],"t":"وَقَدِمْ<o>نَآ</> إِلَىٰ مَا عَمِلُو<s>ا۟</> مِنْ عَمَ<k>لٍۢ فَ</>جَعَلْ<m>نَٰ</>هُ هَ<o>بَآ</><d>ءًۭ مَّ</><k>نثُ</>ورًا"},{"n":24,"w":[["أَصْحَـٰبُ","aṣḥābu","(The) companions","অধিবাসীদের (জন্যে)"],["ٱلْجَنَّةِ","l-janati","(of) Paradise","জান্নাতের"],["يَوْمَئِذٍ","yawma-idhin","that Day","সেদিন"],["خَيْرٌۭ","khayrun","(will be in) a better","উত্তম"],["مُّسْتَقَرًّۭا","mus'taqarran","abode","বাসস্থান (থাকবে)"],["وَأَحْسَنُ","wa-aḥsanu","and a better","ও উৎকৃষ্ট"],["مَقِيلًۭا","maqīlan","resting-place","(দুপুরের) বিশ্রামস্থল"]],"t":"أَصْ<m>حَٰ</>بُ <h>ٱ</>لْجَ<g>نَّ</>ةِ يَوْمَئِذٍ خَيْ<d>رٌۭ مُّ</>سْتَقَ<d>رًّۭا وَ</>أَحْسَنُ مَقِيلًۭا"},{"n":25,"w":[["وَيَوْمَ","wayawma","And (the) Day","এবং সেদিন"],["تَشَقَّقُ","tashaqqaqu","will split open","বিদীর্ণ হবে"],["ٱلسَّمَآءُ","l-samāu","the heavens","আকাশ"],["بِٱلْغَمَـٰمِ","bil-ghamāmi","with the clouds","সহ মেঘ"],["وَنُزِّلَ","wanuzzila","and (will be) sent down","ও অবতীর্ণ করা হবে"],["ٱلْمَلَـٰٓئِكَةُ","l-malāikatu","the Angels","ফেরেশতাদেরকে"],["تَنزِيلًا","tanzīlan","descending","অবতরণ (ক্রমাগতভাবে)"]],"t":"وَيَوْمَ تَشَقَّقُ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءُ بِ<h>ٱ</>لْغَ<m>مَٰ</>مِ وَنُزِّلَ <h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةُ تَ<k>نزِ</>يلًا"},{"n":26,"w":[["ٱلْمُلْكُ","al-mul'ku","The Sovereignty","কর্তৃত্ব (হবে)"],["يَوْمَئِذٍ","yawma-idhin","that Day","সেদিন"],["ٱلْحَقُّ","l-ḥaqu","(will be) truly","প্রকৃত (কর্তৃত্ব)"],["لِلرَّحْمَـٰنِ ۚ","lilrraḥmāni","for the Most Gracious","জন্যে দয়াময়ের"],["وَكَانَ","wakāna","And (it will) be","আর হবে"],["يَوْمًا","yawman","a Day","সেদিন"],["عَلَى","‘alā","for","জন্যে"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","the disbelievers","কাফিরদের"],["عَسِيرًۭا","‘asīran","difficult","কঠিন"]],"t":"ٱلْمُلْكُ يَوْمَئِذٍ <h>ٱ</>لْحَقُّ لِلرَّحْ<m>مَٰ</>نِ ۚ وَكَانَ يَوْمًا عَلَى <h>ٱ</>لْ<m>كَٰ</>فِرِينَ عَسِيرًۭا"},{"n":27,"w":[["وَيَوْمَ","wayawma","And (the) Day","এবং সেদিন"],["يَعَضُّ","ya‘aḍḍu","will bite","কামড়াবে"],["ٱلظَّالِمُ","l-ẓālimu","the wrongdoer","সীমালঙ্ঘনকারী"],["عَلَىٰ","‘alā","[on]","উপর"],["يَدَيْهِ","yadayhi","his hands","তার দু'হাতের"],["يَقُولُ","yaqūlu","he will say","বলবে"],["يَـٰلَيْتَنِى","yālaytanī","O I wish","\"হায়! আমার দুর্ভোগ"],["ٱتَّخَذْتُ","ittakhadhtu","I had taken","আমি ধরতাম (যদি)"],["مَعَ","ma‘a","with","সাথে"],["ٱلرَّسُولِ","l-rasūli","the Messenger","রাসূলের"],["سَبِيلًۭا","sabīlan","a way","পথ"]],"t":"وَيَوْمَ يَعَضُّ <h>ٱ</><l>ل</>ظَّالِمُ عَلَىٰ يَدَيْهِ يَقُولُ <m>يَٰ</>لَيْتَنِى <h>ٱ</>تَّخَذْتُ مَعَ <h>ٱ</><l>ل</>رَّسُولِ سَبِيلًۭا"},{"n":28,"w":[["يَـٰوَيْلَتَىٰ","yāwaylatā","O woe to me","হায়! আমার দুর্ভাগ্য"],["لَيْتَنِى","laytanī","I wish","আমার দুর্ভোগ"],["لَمْ","lam","not","না"],["أَتَّخِذْ","attakhidh","I had taken","গ্রহণ করতাম"],["فُلَانًا","fulānan","that one","অমুককে"],["خَلِيلًۭا","khalīlan","(as) a friend","বন্ধুরূপে"]],"t":"<m>يَٰ</>وَيْلَتَىٰ لَيْتَنِى لَمْ أَتَّخِذْ فُلَانًا خَلِيلًۭا"},{"n":29,"w":[["لَّقَدْ","laqad","Verily","নিশ্চয়ই"],["أَضَلَّنِى","aḍallanī","he led me astray","আমাকে সে বিভ্রান্ত করেছে"],["عَنِ","‘ani","from","হ'তে"],["ٱلذِّكْرِ","l-dhik'ri","the Reminder","উপদেশ (কুরআন)"],["بَعْدَ","ba‘da","after","এরপরও"],["إِذْ","idh","[when]","যখন"],["جَآءَنِى ۗ","jāanī","it (had) come to me","আমার (নিকট) এসেছিলো"],["وَكَانَ","wakāna","And is","আর হলো"],["ٱلشَّيْطَـٰنُ","l-shayṭānu","the Shaitaan","শয়তান"],["لِلْإِنسَـٰنِ","lil'insāni","to the man","জন্যে মানুষের"],["خَذُولًۭا","khadhūlan","a deserter","প্রতারক\""]],"t":"لَّقَ<q>دْ</> أَضَلَّنِى عَنِ <h>ٱ</><l>ل</>ذِّكْرِ بَعْدَ إِذْ <o>جَآ</>ءَنِى ۗ وَكَانَ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نُ لِلْإِ<k>نسَٰ</>نِ خَذُولًۭا"},{"n":30,"w":[["وَقَالَ","waqāla","And said","এবং বলবে"],["ٱلرَّسُولُ","l-rasūlu","the Messenger","রাসূল"],["يَـٰرَبِّ","yārabbi","O my Lord","\"হে আমার রব"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["قَوْمِى","qawmī","my people","আমার জাতি"],["ٱتَّخَذُوا۟","ittakhadhū","took","গ্রহণ করেছিলো"],["هَـٰذَا","hādhā","this","এই"],["ٱلْقُرْءَانَ","l-qur'āna","the Quran","কুরআনকে"],["مَهْجُورًۭا","mahjūran","(as) a forsaken thing","পরিত্যাজ্য\""]],"t":"وَقَالَ <h>ٱ</><l>ل</>رَّسُولُ <m>يَٰ</>رَبِّ إِ<g>نَّ</> قَوْمِى <h>ٱ</>تَّخَذُو<s>ا۟</> <m>هَٰ</>ذَا <h>ٱ</>لْقُرْءَانَ مَهْجُورًۭا"},{"n":31,"w":[["وَكَذَٰلِكَ","wakadhālika","And thus","এবং এভাবে"],["جَعَلْنَا","ja‘alnā","We have made","আমরা করেছি"],["لِكُلِّ","likulli","for every","জন্যে প্রত্যেক"],["نَبِىٍّ","nabiyyin","Prophet","নাবীর"],["عَدُوًّۭا","‘aduwwan","an enemy","শত্রু"],["مِّنَ","mina","among","থেকে"],["ٱلْمُجْرِمِينَ ۗ","l-muj'rimīna","the criminals","দুষ্কৃতিকারীদেরকে"],["وَكَفَىٰ","wakafā","But sufficient is","এবং যথেষ্ট"],["بِرَبِّكَ","birabbika","your Lord","তোমার রব (তোমার জন্যে)"],["هَادِيًۭا","hādiyan","(as) a Guide","পথপ্রদর্শক"],["وَنَصِيرًۭا","wanaṣīran","and a Helper","ও সাহায্যকারীরূপে"]],"t":"وَكَ<m>ذَٰ</>لِكَ جَعَلْنَا لِكُلِّ نَبِىٍّ عَدُ<d>وًّۭا مِّ</>نَ <h>ٱ</>لْمُ<q>جْ</>رِمِينَ ۗ وَكَفَىٰ بِرَبِّكَ هَادِ<d>يًۭا وَ</>نَصِيرًۭا"},{"n":32,"w":[["وَقَالَ","waqāla","And said","এবং বলে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieve","অস্বীকার করেছে"],["لَوْلَا","lawlā","Why not","\"কেন না"],["نُزِّلَ","nuzzila","was revealed","অবতীর্ণ হলো"],["عَلَيْهِ","‘alayhi","to him","তার উপর"],["ٱلْقُرْءَانُ","l-qur'ānu","the Quran","কুরআন"],["جُمْلَةًۭ","jum'latan","all at once","সমগ্র\""],["وَٰحِدَةًۭ ۚ","wāḥidatan","all at once","একবারে\""],["كَذَٰلِكَ","kadhālika","Thus","এভাবে (করেছি)"],["لِنُثَبِّتَ","linuthabbita","that We may strengthen","যেন আমরা দৃঢ় করি"],["بِهِۦ","bihi","thereby","এদ্বারা"],["فُؤَادَكَ ۖ","fuādaka","your heart","তোমার অন্তরকে"],["وَرَتَّلْنَـٰهُ","warattalnāhu","and We have recited it","এবং তা আমরা আবৃত্তি করেছি (সাজিয়েছি)"],["تَرْتِيلًۭا","tartīlan","(with distinct) recitation","থেমে থেমে আবৃত্তি (স্পষ্টভাবে সাজানো)"]],"t":"وَقَالَ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> لَوْلَا نُزِّلَ عَلَيْهِ <h>ٱ</>لْقُرْءَانُ جُمْلَ<d>ةًۭ وَٰ</>حِدَ<k>ةًۭ ۚ كَ</><m>ذَٰ</>لِكَ لِنُثَبِّتَ بِ<m>هِۦ</> فُؤَادَكَ ۖ وَرَتَّلْ<m>نَٰ</>هُ تَرْتِيلًۭا"},{"n":33,"w":[["وَلَا","walā","And not","এবং না"],["يَأْتُونَكَ","yatūnaka","they come to you","তোমার (কাছে) তারা আসে"],["بِمَثَلٍ","bimathalin","with an example","নিয়ে কোন সমস্যাকে"],["إِلَّا","illā","but","এ ছাড়া যে"],["جِئْنَـٰكَ","ji'nāka","We bring you","তোমার কাছে আসি আমরা"],["بِٱلْحَقِّ","bil-ḥaqi","the truth","ভাবে সঠিক (সমাধান)"],["وَأَحْسَنَ","wa-aḥsana","and (the) best","ও অতি উত্তম"],["تَفْسِيرًا","tafsīran","explanation","ব্যাখ্যা (প্রদান করি)"]],"t":"وَلَا يَأْتُونَكَ بِمَثَلٍ إِلَّا جِئْ<m>نَٰ</>كَ بِ<h>ٱ</>لْحَقِّ وَأَحْسَنَ تَفْسِيرًا"},{"n":34,"w":[["ٱلَّذِينَ","alladhīna","Those who","যাদেরকে"],["يُحْشَرُونَ","yuḥ'sharūna","will be gathered","একত্র করা হবে"],["عَلَىٰ","‘alā","on","উপর (ভর করে)"],["وُجُوهِهِمْ","wujūhihim","their faces","মুখমণ্ডলের তাদের"],["إِلَىٰ","ilā","to","দিকে"],["جَهَنَّمَ","jahannama","Hell","জাহান্নামের"],["أُو۟لَـٰٓئِكَ","ulāika","those","ঐসব লোকের  (জন্যে হবে)"],["شَرٌّۭ","sharrun","(are the) worst","নিকৃষ্ট"],["مَّكَانًۭا","makānan","(in) position","অবস্থান"],["وَأَضَلُّ","wa-aḍallu","and most astray","ও চূড়ান্তভাবে ভ্রষ্ট হয়েছে"],["سَبِيلًۭا","sabīlan","(from the) way","পথ"]],"t":"ٱلَّذِينَ يُحْشَرُونَ عَلَىٰ وُجُوهِهِمْ إِلَىٰ جَهَ<g>نَّ</>مَ أُ<s>و۟</><o>لَٰٓ</>ئِكَ شَ<d>رٌّۭ مَّ</>كَا<d>نًۭا وَ</>أَضَلُّ سَبِيلًۭا"},{"n":35,"w":[["وَلَقَدْ","walaqad","And verily","এবং  নিশ্চয়ই"],["ءَاتَيْنَا","ātaynā","We gave","আমরা দিয়েছিলাম"],["مُوسَى","mūsā","Musa","মূসাকে"],["ٱلْكِتَـٰبَ","l-kitāba","the Scripture","কিতাব"],["وَجَعَلْنَا","waja‘alnā","and We appointed","ও আমরা করেছিলাম"],["مَعَهُۥٓ","ma‘ahu","with him","তার সাথে"],["أَخَاهُ","akhāhu","his brother","তার ভাই"],["هَـٰرُونَ","hārūna","Harun","হারুনকে"],["وَزِيرًۭا","wazīran","(as) an assistant","সাহায্যকারী"]],"t":"وَلَقَ<q>دْ</> ءَاتَيْنَا مُوسَى <h>ٱ</>لْكِ<m>تَٰ</>بَ وَجَعَلْنَا مَعَهُ<o>ۥٓ</> أَخَاهُ <m>هَٰ</>رُونَ وَزِيرًۭا"},{"n":36,"w":[["فَقُلْنَا","faqul'nā","Then We said","অতঃপর আমরা বলেছিলাম"],["ٱذْهَبَآ","idh'habā","Go both of you","\"দু'জনে যাও"],["إِلَى","ilā","to","প্রতি"],["ٱلْقَوْمِ","l-qawmi","the people","(সে জাতির) লোকদের"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَذَّبُوا۟","kadhabū","have denied","মিথ্যারোপ করেছে"],["بِـَٔايَـٰتِنَا","biāyātinā","Our Signs","প্রতি আমার নির্দেশনাবলীর\""],["فَدَمَّرْنَـٰهُمْ","fadammarnāhum","Then We destroyed them","ফলে আমরা ধ্বংস করে দিয়েছি তাদেরকে"],["تَدْمِيرًۭا","tadmīran","(with) destruction","ধ্বংস (সম্পূর্ণ রূপে)"]],"t":"فَقُلْنَا <h>ٱ</>ذْهَ<o>بَآ</> إِلَى <h>ٱ</>لْقَوْمِ <h>ٱ</>لَّذِينَ كَذَّبُو<s>ا۟</> بِـَٔا<m>يَٰ</>تِنَا فَدَ<g>مَّ</>رْ<m>نَٰ</>هُمْ تَ<q>دْ</>مِيرًۭا"},{"n":37,"w":[["وَقَوْمَ","waqawma","And (the) people","এবং জাতি"],["نُوحٍۢ","nūḥin","(of) Nuh","নূহের"],["لَّمَّا","lammā","when","যখন"],["كَذَّبُوا۟","kadhabū","they denied","মিথ্যারোপ করেছিলো"],["ٱلرُّسُلَ","l-rusula","the Messengers","রাসুলদেরকে"],["أَغْرَقْنَـٰهُمْ","aghraqnāhum","We drowned them","আমরা ডুবিয়ে দিয়েছি তাদেরকে"],["وَجَعَلْنَـٰهُمْ","waja‘alnāhum","and We made them","এবং আমরা করেছিলাম তাদেরকে"],["لِلنَّاسِ","lilnnāsi","for mankind","জন্যে মানুষের"],["ءَايَةًۭ ۖ","āyatan","a sign","নিদর্শন"],["وَأَعْتَدْنَا","wa-a‘tadnā","And We have prepared","আর আমরা প্রস্তুত করে রেখেছি"],["لِلظَّـٰلِمِينَ","lilẓẓālimīna","for the wrongdoers","জন্যে সীমালঙ্ঘনকারীদের"],["عَذَابًا","‘adhāban","a punishment","শাস্তি"],["أَلِيمًۭا","alīman","painful","নিদারুণ"]],"t":"وَقَوْمَ نُو<w>حٍۢ لَّ</><g>مَّ</>ا كَذَّبُو<s>ا۟</> <h>ٱ</><l>ل</>رُّسُلَ أَغْرَ<q>قْ</><m>نَٰ</>هُمْ وَجَعَلْ<m>نَٰ</>هُمْ لِل<g>نَّ</>اسِ ءَايَ<d>ةًۭ ۖ وَ</>أَعْتَ<q>دْ</>نَا لِل<m>ظَّٰ</>لِمِينَ عَذَابًا أَلِيمًۭا"},{"n":38,"w":[["وَعَادًۭا","wa‘ādan","And Ad","এবং (ধ্বংস করেছি) আদ"],["وَثَمُودَا۟","wathamūdā","and Thamud","ও সামূদ"],["وَأَصْحَـٰبَ","wa-aṣḥāba","and (the) dwellers","ও অধিবাসী"],["ٱلرَّسِّ","l-rasi","(of) Ar-rass","রাস্‌"],["وَقُرُونًۢا","waqurūnan","and generations","এবং শতাব্দীসমূহে"],["بَيْنَ","bayna","between","মাঝের"],["ذَٰلِكَ","dhālika","that","এদের"],["كَثِيرًۭا","kathīran","many","অনেক (লোক)"]],"t":"وَعَا<d>دًۭا وَ</>ثَمُودَ<s>ا۟</> وَأَصْ<m>حَٰ</>بَ <h>ٱ</><l>ل</>رَّسِّ وَقُرُو<i>نًۢا بَ</>يْنَ <m>ذَٰ</>لِكَ كَثِيرًۭا"},{"n":39,"w":[["وَكُلًّۭا","wakullan","And each","এবং প্রত্যেক (জাতিকে)"],["ضَرَبْنَا","ḍarabnā","We have set forth","আমরা বর্ণনা দিয়েছি"],["لَهُ","lahu","for him","জন্যে তার"],["ٱلْأَمْثَـٰلَ ۖ","l-amthāla","the examples","দৃষ্টান্তসমূহ (পুর্বের)"],["وَكُلًّۭا","wakullan","and each","এবং প্রত্যেককে"],["تَبَّرْنَا","tabbarnā","We destroyed","আমরা ধ্বংস করেছি"],["تَتْبِيرًۭا","tatbīran","(with) destruction","ধ্বংস (সম্পূর্ণরূপে)"]],"t":"وَكُ<k>لًّۭا ضَ</>رَ<q>بْ</>نَا لَهُ <h>ٱ</>لْأَمْ<m>ثَٰ</>لَ ۖ وَكُ<k>لًّۭا تَ</>بَّرْنَا تَتْبِيرًۭا"},{"n":40,"w":[["وَلَقَدْ","walaqad","And verily","এবং নিশ্চয়ই"],["أَتَوْا۟","ataw","they have come","তারা আসা যাওয়া করে"],["عَلَى","‘alā","upon","উপর (দিয়ে)"],["ٱلْقَرْيَةِ","l-qaryati","the town","(সেই) জনপদের"],["ٱلَّتِىٓ","allatī","which","যার (উপর)"],["أُمْطِرَتْ","um'ṭirat","was showered","বৃষ্টি বর্ষিত হয়েছিল"],["مَطَرَ","maṭara","(with) a rain","বৃষ্টি"],["ٱلسَّوْءِ ۚ","l-sawi","(of) evil","নিকৃষ্ট রকমের"],["أَفَلَمْ","afalam","Then do not","কি তবে না"],["يَكُونُوا۟","yakūnū","they [were]","তারা থাকে"],["يَرَوْنَهَا ۚ","yarawnahā","see it","তা তারা দেখে"],["بَلْ","bal","Nay","বরং"],["كَانُوا۟","kānū","they are","তারা হলো (এমন যে)"],["لَا","lā","not","না"],["يَرْجُونَ","yarjūna","expecting","তারা আশা করে"],["نُشُورًۭا","nushūran","Resurrection","উত্থানের"]],"t":"وَلَقَ<q>دْ</> أَتَوْ<s>ا۟</> عَلَى <h>ٱ</>لْقَرْيَةِ <h>ٱ</>لَّ<o>تِىٓ</> أُمْطِرَتْ مَطَرَ <h>ٱ</><l>ل</>سَّوْءِ ۚ أَفَلَمْ يَكُونُو<s>ا۟</> يَرَوْنَهَا ۚ بَلْ كَانُو<s>ا۟</> لَا يَرْجُونَ نُشُورًۭا"},{"n":41,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["رَأَوْكَ","ra-awka","they see you","তোমাকে তারা দেখে"],["إِن","in","not","না"],["يَتَّخِذُونَكَ","yattakhidhūnaka","they take you","তোমাকে তারা গ্রহণ করে"],["إِلَّا","illā","except","এ ছাড়া যে"],["هُزُوًا","huzuwan","(in) mockery","বিদ্রূপের পাত্ররূপে"],["أَهَـٰذَا","ahādhā","Is this","\"(তারা বলে) কি এই"],["ٱلَّذِى","alladhī","the one whom","যাকে"],["بَعَثَ","ba‘atha","Allah has sent","পাঠিয়েছেন"],["ٱللَّهُ","l-lahu","Allah has sent","আল্লাহ"],["رَسُولًا","rasūlan","(as) a Messenger","রাসূলরূপে"]],"t":"وَإِذَا رَأَوْكَ <d>إِن يَ</>تَّخِذُونَكَ إِلَّا هُزُوًا أَ<m>هَٰ</>ذَا <h>ٱ</>لَّذِى بَعَثَ <h>ٱ</>للَّهُ رَسُولًا"},{"n":42,"w":[["إِن","in","He would have almost","যদি"],["كَادَ","kāda","He would have almost","উপক্রম হয়েছিলো"],["لَيُضِلُّنَا","layuḍillunā","[surely] misled us","অবশ্যই আমাদেরকে ভ্রষ্ট করে দিতো"],["عَنْ","‘an","from","হ'তে"],["ءَالِهَتِنَا","ālihatinā","our gods","আমাদের দেবতাগুলো"],["لَوْلَآ","lawlā","if not","যদি না"],["أَن","an","that","যে"],["صَبَرْنَا","ṣabarnā","we had been steadfast","আমরা ধৈর্য ধরতাম"],["عَلَيْهَا ۚ","‘alayhā","to them","তাদের উপর\""],["وَسَوْفَ","wasawfa","And soon","আর শীঘ্রই"],["يَعْلَمُونَ","ya‘lamūna","will know","তারা জানতে পারবে"],["حِينَ","ḥīna","when","যখন"],["يَرَوْنَ","yarawna","they will see","তারা দেখবে"],["ٱلْعَذَابَ","l-‘adhāba","the punishment","শাস্তি"],["مَنْ","man","who","কে"],["أَضَلُّ","aḍallu","(is) more astray","চূড়ান্তরূপে ভ্রষ্ট হয়েছে"],["سَبِيلًا","sabīlan","(from the) way","পথ"]],"t":"إِ<k>ن كَ</>ادَ لَيُضِلُّنَا عَنْ ءَالِهَتِنَا لَوْ<o>لَآ</> أَ<k>ن صَ</>بَرْنَا عَلَيْهَا ۚ وَسَوْفَ يَعْلَمُونَ حِينَ يَرَوْنَ <h>ٱ</>لْعَذَابَ مَنْ أَضَلُّ سَبِيلًا"},{"n":43,"w":[["أَرَءَيْتَ","ara-ayta","Have you seen","কি তুমি (ভেবে) দেখেছো"],["مَنِ","mani","(one) who","যে"],["ٱتَّخَذَ","ittakhadha","takes","গ্রহণ করেছে"],["إِلَـٰهَهُۥ","ilāhahu","(as) his god","উপাস্যরূপে"],["هَوَىٰهُ","hawāhu","his own desire","তার বাসনা লালসাকে"],["أَفَأَنتَ","afa-anta","Then would you","কি তবে তুমি"],["تَكُونُ","takūnu","be","তুমি হবে"],["عَلَيْهِ","‘alayhi","over him","তার উপর"],["وَكِيلًا","wakīlan","a guardian","কর্মবিধায়ক"]],"t":"أَرَءَيْتَ مَنِ <h>ٱ</>تَّخَذَ إِ<m>لَٰ</>هَهُ<m>ۥ</> هَوَ<m>ىٰ</>هُ أَفَأَ<k>نتَ</> تَكُونُ عَلَيْهِ وَكِيلًا"},{"n":44,"w":[["أَمْ","am","Or","অথবা কি"],["تَحْسَبُ","taḥsabu","do you think","মনে করো তুমি"],["أَنَّ","anna","that","যে"],["أَكْثَرَهُمْ","aktharahum","most of them","অধিকাংশ তাদের"],["يَسْمَعُونَ","yasma‘ūna","hear","শূনতে পায়"],["أَوْ","aw","or","অথবা"],["يَعْقِلُونَ ۚ","ya‘qilūna","understand","বুঝতে পারে"],["إِنْ","in","Not","নয়"],["هُمْ","hum","they","তারা"],["إِلَّا","illā","(are) except","এ ছাড়া"],["كَٱلْأَنْعَـٰمِ ۖ","kal-an‘āmi","like cattle","মতো চতুষ্পদ পশুর"],["بَلْ","bal","Nay","বরং"],["هُمْ","hum","they","তারা"],["أَضَلُّ","aḍallu","(are) more astray","অধিকতর ভ্রষ্ট হয়েছে"],["سَبِيلًا","sabīlan","(from the) way","পথ"]],"t":"أَمْ تَحْسَبُ أَ<g>نَّ</> أَكْثَرَهُمْ يَسْمَعُونَ أَوْ يَعْقِلُونَ ۚ إِنْ هُمْ إِلَّا كَ<h>ٱ</>لْأَنْ<m>عَٰ</>مِ ۖ بَلْ هُمْ أَضَلُّ سَبِيلًا"},{"n":45,"w":[["أَلَمْ","alam","Do you not","কি নি"],["تَرَ","tara","see","তুমি (ভেবে) দেখো"],["إِلَىٰ","ilā","[to]","প্রতি"],["رَبِّكَ","rabbika","your Lord","তোমার রবের"],["كَيْفَ","kayfa","how","কিভাবে"],["مَدَّ","madda","He extends","তিনি বিস্তার করেছেন"],["ٱلظِّلَّ","l-ẓila","the shadow","ছায়া"],["وَلَوْ","walaw","And if","এবং যদি"],["شَآءَ","shāa","He willed","তিনি চাইতেন"],["لَجَعَلَهُۥ","laja‘alahu","surely He (could) have made it","অবশ্যই তাকে করতে পারতেন"],["سَاكِنًۭا","sākinan","stationary","স্থির"],["ثُمَّ","thumma","Then","এরপর"],["جَعَلْنَا","ja‘alnā","We made","আমরা করেছি"],["ٱلشَّمْسَ","l-shamsa","the sun","সূর্যকে"],["عَلَيْهِ","‘alayhi","for it","তার উপর"],["دَلِيلًۭا","dalīlan","an indication","প্রমাণ"]],"t":"أَلَمْ تَرَ إِلَىٰ رَبِّكَ كَيْفَ مَدَّ <h>ٱ</><l>ل</>ظِّلَّ وَلَوْ <o>شَآ</>ءَ لَجَعَلَهُ<m>ۥ</> سَاكِ<k>نًۭا ثُ</><g>مَّ</> جَعَلْنَا <h>ٱ</><l>ل</>شَّمْسَ عَلَيْهِ دَلِيلًۭا"},{"n":46,"w":[["ثُمَّ","thumma","Then","এরপর"],["قَبَضْنَـٰهُ","qabaḍnāhu","We withdraw it","তাকে আমরা গুটিয়ে আনি"],["إِلَيْنَا","ilaynā","to Us","আমাদের দিকে"],["قَبْضًۭا","qabḍan","a withdrawal","গুটিয়ে"],["يَسِيرًۭا","yasīran","gradual","ধীর ভাবে"]],"t":"ثُ<g>مَّ</> قَبَضْ<m>نَٰ</>هُ إِلَيْنَا قَ<q>بْ</><d>ضًۭا يَ</>سِيرًۭا"},{"n":47,"w":[["وَهُوَ","wahuwa","And He","এবং তিনিই (আল্লাহ)"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["جَعَلَ","ja‘ala","made","করেছেন"],["لَكُمُ","lakumu","for you","জন্যে তোমাদের"],["ٱلَّيْلَ","al-layla","the night","রাতকে"],["لِبَاسًۭا","libāsan","(as) a covering","(আবরণ ও) পোশাকস্বরূপ"],["وَٱلنَّوْمَ","wal-nawma","and the sleep","ও ঘুমকে (করেছেন)"],["سُبَاتًۭا","subātan","a rest","(মৃত্যুর সম) বিশ্রামস্বরূপ"],["وَجَعَلَ","waja‘ala","and made","ও তিনি করেছেন"],["ٱلنَّهَارَ","l-nahāra","the day","দিনকে"],["نُشُورًۭا","nushūran","a resurrection","(জীবন্ত করে) উত্থানস্বরূপ"]],"t":"وَهُوَ <h>ٱ</>لَّذِى جَعَلَ لَكُمُ <h>ٱ</>لَّيْلَ لِبَا<d>سًۭا وَ</><h>ٱ</><l>ل</><g>نَّ</>وْمَ سُبَا<d>تًۭا وَ</>جَعَلَ <h>ٱ</><l>ل</><g>نَّ</>هَارَ نُشُورًۭا"},{"n":48,"w":[["وَهُوَ","wahuwa","And He","এবং তিনিই"],["ٱلَّذِىٓ","alladhī","(is) the One Who","যিনি"],["أَرْسَلَ","arsala","sends","প্রেরণ করেন"],["ٱلرِّيَـٰحَ","l-riyāḥa","the winds","বাতাসকে"],["بُشْرًۢا","bush'ran","(as) glad tidings","সুসংবাদরূপে"],["بَيْنَ","bayna","before","মাঝে"],["يَدَىْ","yaday","before","হাতের (প্রাক্কালে)"],["رَحْمَتِهِۦ ۚ","raḥmatihi","His Mercy","তাঁর অনুগ্রহের"],["وَأَنزَلْنَا","wa-anzalnā","and We send down","এবং আমরা বর্ষণ করি"],["مِنَ","mina","from","হ'তে"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশ"],["مَآءًۭ","māan","water","পানি"],["طَهُورًۭا","ṭahūran","pure","বিশুদ্ধ"]],"t":"وَهُوَ <h>ٱ</>لَّ<o>ذِىٓ</> أَرْسَلَ <h>ٱ</><l>ل</>رِّ<m>يَٰ</>حَ بُشْ<i>رًۢا بَ</>يْنَ يَدَىْ رَحْمَتِ<m>هِۦ</> ۚ وَأَ<k>نزَ</>لْنَا مِنَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ <o>مَآ</><k>ءًۭ طَ</>هُورًۭا"},{"n":49,"w":[["لِّنُحْـِۧىَ","linuḥ'yiya","That We may give life","যেন জীবিত করি আমরা"],["بِهِۦ","bihi","thereby","দ্বারা তা"],["بَلْدَةًۭ","baldatan","(to) a land","ভূখণ্ডকে"],["مَّيْتًۭا","maytan","dead","মৃত"],["وَنُسْقِيَهُۥ","wanus'qiyahu","and We give drink","ও তা পান করাই আমরা"],["مِمَّا","mimmā","thereof","মধ্যে যাদের"],["خَلَقْنَآ","khalaqnā","(to those) We created","আমরা সৃষ্টি করেছি"],["أَنْعَـٰمًۭا","an‘āman","cattle","জীবজন্তু"],["وَأَنَاسِىَّ","wa-anāsiyya","and men","ও মানুষ"],["كَثِيرًۭا","kathīran","many","বহু"]],"t":"لِّنُحْۦِىَ بِ<m>هِۦ</> بَلْدَ<d>ةًۭ مَّيْتًۭا وَ</>نُسْقِيَهُ<m>ۥ</> مِ<g>مَّ</>ا خَلَ<q>قْ</><o>نَآ</> أَنْ<m>عَٰ</><d>مًۭا وَ</>أَنَاسِىَّ كَثِيرًۭا"},{"n":50,"w":[["وَلَقَدْ","walaqad","And verily","এবং নিশ্চয়ই"],["صَرَّفْنَـٰهُ","ṣarrafnāhu","We have distributed it","তা আমরা বারবার পেশ করি"],["بَيْنَهُمْ","baynahum","among them","তাদের মাঝে"],["لِيَذَّكَّرُوا۟","liyadhakkarū","that they may remember","যেন তারা শিক্ষা নেয়"],["فَأَبَىٰٓ","fa-abā","but refuse","কিন্তু অস্বীকার করে"],["أَكْثَرُ","aktharu","most","অধিকাংশ"],["ٱلنَّاسِ","l-nāsi","(of) the people","মানুষ"],["إِلَّا","illā","except","(আর) কেবল"],["كُفُورًۭا","kufūran","disbelief","অকৃতজ্ঞতা প্রকাশ করে"]],"t":"وَلَقَ<q>دْ</> صَرَّفْ<m>نَٰ</>هُ بَيْنَهُمْ لِيَذَّكَّرُو<s>ا۟</> فَأَبَ<o>ىٰٓ</> أَكْثَرُ <h>ٱ</><l>ل</><g>نَّ</>اسِ إِلَّا كُفُورًۭا"},{"n":51,"w":[["وَلَوْ","walaw","And if","আর যদি"],["شِئْنَا","shi'nā","We willed","আমরা চাইতাম"],["لَبَعَثْنَا","laba‘athnā","surely, We (would) have raised","অবশ্যই আমরাপাঠাতাম"],["فِى","fī","in","মধ্যে"],["كُلِّ","kulli","every","প্রত্যেক"],["قَرْيَةٍۢ","qaryatin","town","জনপদের"],["نَّذِيرًۭا","nadhīran","a warner","একজন  সতর্ককারী"]],"t":"وَلَوْ شِئْنَا لَبَعَثْنَا فِى كُلِّ قَرْيَ<d>ةٍۢ نَّ</>ذِيرًۭا"},{"n":52,"w":[["فَلَا","falā","So (do) not","সুতরাং না"],["تُطِعِ","tuṭi‘i","obey","তুমি অনুসরণ করো"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","the disbelievers","কাফিরদেরকে"],["وَجَـٰهِدْهُم","wajāhid'hum","and strive (against) them","এবং জিহাদ করো তাদের সাথে"],["بِهِۦ","bihi","with it","দ্বারা এ"],["جِهَادًۭا","jihādan","a striving","জিহাদ"],["كَبِيرًۭا","kabīran","great","বড়"]],"t":"فَلَا تُطِعِ <h>ٱ</>لْ<m>كَٰ</>فِرِينَ وَ<m>جَٰ</>هِ<q>دْ</><f>هُم بِ</><m>هِۦ</> جِهَا<k>دًۭا كَ</>بِيرًۭا"},{"n":53,"w":[["۞ وَهُوَ","wahuwa","And He","এবং তিনি (আল্লাহ)"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["مَرَجَ","maraja","(has) released","মিলিয়ে প্রবাহিত করেছেন"],["ٱلْبَحْرَيْنِ","l-baḥrayni","the two seas","দুই সমুদ্রকে"],["هَـٰذَا","hādhā","[this] (one)","এটা"],["عَذْبٌۭ","‘adhbun","palatable","সুমিষ্ট"],["فُرَاتٌۭ","furātun","and sweet","সুপেয়"],["وَهَـٰذَا","wahādhā","and [this] (one)","এবং ওটা"],["مِلْحٌ","mil'ḥun","salty","লোনা"],["أُجَاجٌۭ","ujājun","(and) bitter","বিস্বাদ"],["وَجَعَلَ","waja‘ala","and He has made","এবং তিনি করেছেন"],["بَيْنَهُمَا","baynahumā","between them","উভয়ের মাঝে"],["بَرْزَخًۭا","barzakhan","a barrier","অন্তরায়"],["وَحِجْرًۭا","waḥij'ran","and a partition","ও আড়াল"],["مَّحْجُورًۭا","maḥjūran","forbidden","দুর্ভেদ্য"]],"t":"۞ وَهُوَ <h>ٱ</>لَّذِى مَرَجَ <h>ٱ</>لْبَحْرَيْنِ <m>هَٰ</>ذَا عَذْ<k>بٌۭ فُ</>رَا<d>تٌۭ وَ</><m>هَٰ</>ذَا مِلْحٌ أُجَا<d>جٌۭ وَ</>جَعَلَ بَيْنَهُمَا بَرْزَ<d>خًۭا وَ</>حِ<q>جْ</><d>رًۭا مَّ</>حْجُورًۭا"},{"n":54,"w":[["وَهُوَ","wahuwa","And He","এবং তিনিই"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["خَلَقَ","khalaqa","has created","সৃষ্টি করেছেন"],["مِنَ","mina","from","হ'তে"],["ٱلْمَآءِ","l-māi","the water","পানি"],["بَشَرًۭا","basharan","human being","মানুষকে"],["فَجَعَلَهُۥ","faja‘alahu","and has made (for) him","অতঃপর তা স্থাপন করেছেন"],["نَسَبًۭا","nasaban","blood relationship","বংশগত সম্পর্ক"],["وَصِهْرًۭا ۗ","waṣih'ran","and marriage relationship","ও বৈবাহিক সম্পর্ক"],["وَكَانَ","wakāna","And is","আর হলেন"],["رَبُّكَ","rabbuka","your Lord","তোমার রব"],["قَدِيرًۭا","qadīran","All-Powerful","(সবকিছুর উপর) শক্তিমান"]],"t":"وَهُوَ <h>ٱ</>لَّذِى خَلَقَ مِنَ <h>ٱ</>لْ<o>مَآ</>ءِ بَشَ<k>رًۭا فَ</>جَعَلَهُ<m>ۥ</> نَسَ<d>بًۭا وَ</>صِهْ<d>رًۭا ۗ وَ</>كَانَ رَبُّكَ قَدِيرًۭا"},{"n":55,"w":[["وَيَعْبُدُونَ","waya‘budūna","But they worship","ও তারা ইবাদাত করে"],["مِن","min","besides Allah","মধ্য হতে"],["دُونِ","dūni","besides Allah","পরিবর্তে"],["ٱللَّهِ","l-lahi","besides Allah","আল্লাহর"],["مَا","mā","what","(এমন কিছুর) যা"],["لَا","lā","not profits them","না"],["يَنفَعُهُمْ","yanfa‘uhum","not profits them","তাদের উপকার করতে পারে"],["وَلَا","walā","and not","আর না"],["يَضُرُّهُمْ ۗ","yaḍurruhum","harms them","তাদের ক্ষতি করতে পারে"],["وَكَانَ","wakāna","and is","আর হলো"],["ٱلْكَافِرُ","l-kāfiru","the disbeliever","কাফিররা"],["عَلَىٰ","‘alā","against","বিরুদ্ধে"],["رَبِّهِۦ","rabbihi","his Lord","তার রবের"],["ظَهِيرًۭا","ẓahīran","a helper","সাহায্যকারী (প্রত্যেক বিদ্রোহীর)"]],"t":"وَيَعْبُدُونَ مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ مَا لَا يَ<k>نفَ</>عُهُمْ وَلَا يَضُرُّهُمْ ۗ وَكَانَ <h>ٱ</>لْكَافِرُ عَلَىٰ رَبِّ<m>هِۦ</> ظَهِيرًۭا"},{"n":56,"w":[["وَمَآ","wamā","And not","এবং না"],["أَرْسَلْنَـٰكَ","arsalnāka","We sent you","তোমাকে আমরা পাঠিয়েছি"],["إِلَّا","illā","except","এ ছাড়া যে"],["مُبَشِّرًۭا","mubashiran","(as) a bearer of glad tidings","সুসংবাদদাতা"],["وَنَذِيرًۭا","wanadhīran","and a warner","ও সতর্ক কারী রূপে"]],"t":"وَ<o>مَآ</> أَرْسَلْ<m>نَٰ</>كَ إِلَّا مُبَشِّ<d>رًۭا وَ</>نَذِيرًۭا"},{"n":57,"w":[["قُلْ","qul","Say","বলো"],["مَآ","mā","Not","\"না"],["أَسْـَٔلُكُمْ","asalukum","I ask (of) you","তোমাদের (নিকট) চাচ্ছি আমি"],["عَلَيْهِ","‘alayhi","for it","এর জন্য"],["مِنْ","min","any","কোন"],["أَجْرٍ","ajrin","payment","প্রতিদান"],["إِلَّا","illā","except","তবে (এতটুকু)"],["مَن","man","(that) whoever wills","যে"],["شَآءَ","shāa","(that) whoever wills","ইচ্ছে করে"],["أَن","an","to","যে"],["يَتَّخِذَ","yattakhidha","take","সে গ্রহণ করবে"],["إِلَىٰ","ilā","to","দিকে"],["رَبِّهِۦ","rabbihi","his Lord","তার রবের"],["سَبِيلًۭا","sabīlan","a way","পথ\""]],"t":"قُلْ <o>مَآ</> أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَ<q>جْ</>رٍ إِلَّا مَ<k>ن شَ</><o>آ</>ءَ <d>أَن يَ</>تَّخِذَ إِلَىٰ رَبِّ<m>هِۦ</> سَبِيلًۭا"},{"n":58,"w":[["وَتَوَكَّلْ","watawakkal","And put your trust","এবং নির্ভর করো"],["عَلَى","‘alā","in","উপর"],["ٱلْحَىِّ","l-ḥayi","the Ever-Living","চিরঞ্জীব (আল্লাহর)"],["ٱلَّذِى","alladhī","the One Who","যিনি"],["لَا","lā","does not die","না"],["يَمُوتُ","yamūtu","does not die","মরবেন (কখনও)"],["وَسَبِّحْ","wasabbiḥ","and glorify","ও পবিত্রতা ঘোষণা করো"],["بِحَمْدِهِۦ ۚ","biḥamdihi","with His Praise","তাঁর প্রশংসাসহ"],["وَكَفَىٰ","wakafā","And sufficient is","আর যথেষ্ট"],["بِهِۦ","bihi","He","এ ব্যাপারে"],["بِذُنُوبِ","bidhunūbi","regarding the sins","সম্পর্কে পাপ"],["عِبَادِهِۦ","‘ibādihi","(of) His slaves","তাঁর দাসদের"],["خَبِيرًا","khabīran","All-Aware","(তাঁরই) অবহিত হওয়া"]],"t":"وَتَوَكَّلْ عَلَى <h>ٱ</>لْحَىِّ <h>ٱ</>لَّذِى لَا يَمُوتُ وَسَبِّحْ بِحَمْدِ<m>هِۦ</> ۚ وَكَفَىٰ بِ<m>هِۦ</> بِذُنُوبِ عِبَادِ<m>هِۦ</> خَبِيرًا"},{"n":59,"w":[["ٱلَّذِى","alladhī","The One Who","যিনি"],["خَلَقَ","khalaqa","created","সৃষ্টি করেছেন"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশমণ্ডলী"],["وَٱلْأَرْضَ","wal-arḍa","and the earth","ও পৃথিবী"],["وَمَا","wamā","and whatever","এবং যা কিছু"],["بَيْنَهُمَا","baynahumā","(is) between them","উভয়ের মাঝে (আছে)"],["فِى","fī","in","মধ্যে"],["سِتَّةِ","sittati","six","ছয়"],["أَيَّامٍۢ","ayyāmin","periods","দিনে"],["ثُمَّ","thumma","then","এরপর"],["ٱسْتَوَىٰ","is'tawā","He established Himself","সমাসীন হন"],["عَلَى","‘alā","over","উপর"],["ٱلْعَرْشِ ۚ","l-‘arshi","the Throne ","আরশের"],["ٱلرَّحْمَـٰنُ","l-raḥmānu","the Most Gracious","অশেষ দয়াবান"],["فَسْـَٔلْ","fasal","so ask","সুতরাং জিজ্ঞেস করো"],["بِهِۦ","bihi","Him","সম্পর্কে তাঁর"],["خَبِيرًۭا","khabīran","(as He is) All-Aware","(তাদের হ'তে) যারা অবহিত"]],"t":"ٱلَّذِى خَلَقَ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضَ وَمَا بَيْنَهُمَا فِى سِتَّةِ أَيَّا<k>مٍۢ ثُ</><g>مَّ</> <h>ٱ</>سْتَوَىٰ عَلَى <h>ٱ</>لْعَرْشِ ۚ <h>ٱ</><l>ل</>رَّحْ<m>مَٰ</>نُ فَسْـَٔلْ بِ<m>هِۦ</> خَبِيرًۭا"},{"n":60,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["قِيلَ","qīla","it is said","বলা হয়"],["لَهُمُ","lahumu","to them","তাদেরকে"],["ٱسْجُدُوا۟","us'judū","Prostrate","\"তোমরা সিজদা করো"],["لِلرَّحْمَـٰنِ","lilrraḥmāni","to the Most Gracious","জন্যে দয়াময়ের\""],["قَالُوا۟","qālū","They say","তারা বলে"],["وَمَا","wamā","And what","\"কে আবার"],["ٱلرَّحْمَـٰنُ","l-raḥmānu","(is) the Most Gracious","(সেই) দয়াময়"],["أَنَسْجُدُ","anasjudu","Should we prostrate","কি আমরা সিজদা করবো"],["لِمَا","limā","to what","(তাকে) যাকে"],["تَأْمُرُنَا","tamurunā","you order us","আমাদের তুমি নির্দেশ দিবে\""],["وَزَادَهُمْ","wazādahum","And it increases them","আর (এভা