{"n":39,"a":[{"n":1,"w":[["تَنزِيلُ","tanzīlu","(The) revelation","অবতীর্ণ করা"],["ٱلْكِتَـٰبِ","l-kitābi","(of) the Book","(এই) কিতাব"],["مِنَ","mina","(is) from","পক্ষ হ'তে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["ٱلْعَزِيزِ","l-‘azīzi","the All-Mighty","( যিনি) পরাক্রমশালী"],["ٱلْحَكِيمِ","l-ḥakīmi","the All-Wise","প্রজ্ঞাময়"]],"t":"تَ<k>نزِ</>يلُ <h>ٱ</>لْكِ<m>تَٰ</>بِ مِنَ <h>ٱ</>للَّهِ <h>ٱ</>لْعَزِيزِ <h>ٱ</>لْحَ<p>كِي</>مِ"},{"n":2,"w":[["إِنَّآ","innā","Indeed, We","নিশ্চয়ই আমরা"],["أَنزَلْنَآ","anzalnā","[We] have revealed","আমরা অবতীর্ণ করেছি"],["إِلَيْكَ","ilayka","to you","তোমার প্রতি"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","(এই) কিতাবকে"],["بِٱلْحَقِّ","bil-ḥaqi","in truth","সত্যসহকারে"],["فَٱعْبُدِ","fa-u‘'budi","so worship","সুতরাং ইবাদাত করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহর"],["مُخْلِصًۭا","mukh'liṣan","(being) sincere","একনিষ্ঠভাবে"],["لَّهُ","lahu","to Him","তাঁরই জন্যে"],["ٱلدِّينَ","l-dīna","(in) the religion","আনুগত্যে (নির্দিষ্ট করে)"]],"t":"إِ<g>نَّ</><o>آ</> أَ<k>نزَ</>لْ<o>نَآ</> إِلَيْكَ <h>ٱ</>لْكِ<m>تَٰ</>بَ بِ<h>ٱ</>لْحَقِّ فَ<h>ٱ</>عْبُدِ <h>ٱ</>للَّهَ مُخْلِ<w>صًۭا لَّ</>هُ <h>ٱ</><l>ل</><p>دِّي</>نَ"},{"n":3,"w":[["أَلَا","alā","Unquestionably","জেনে রাখো"],["لِلَّهِ","lillahi","for Allah","আল্লাহরই জন্যে"],["ٱلدِّينُ","l-dīnu","(is) the religion","আনুগত্য"],["ٱلْخَالِصُ ۚ","l-khāliṣu","the pure","একনিষ্ঠ"],["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["ٱتَّخَذُوا۟","ittakhadhū","take","গ্রহণ করেছো"],["مِن","min","besides Him","ছাড়া"],["دُونِهِۦٓ","dūnihi","besides Him","তাঁকে"],["أَوْلِيَآءَ","awliyāa","protectors","অভিভাবকরূপে (অন্যদেরকে)"],["مَا","mā","Not","\"(এবং বলে) না"],["نَعْبُدُهُمْ","na‘buduhum","we worship them","তাদের পূজা করি আমরা"],["إِلَّا","illā","except","এ ব্যতীত"],["لِيُقَرِّبُونَآ","liyuqarribūnā","that they may bring us near","আমাদের নিকটে করে দেয় যেন"],["إِلَى","ilā","to","দিকে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["زُلْفَىٰٓ","zul'fā","(in) nearness","(তাঁর) কাছাকাছি\""],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يَحْكُمُ","yaḥkumu","will judge","মীমাংসা করে দিবেন"],["بَيْنَهُمْ","baynahum","between them","তাদের মাঝে"],["فِى","fī","in","মধ্যে"],["مَا","mā","what","(ঐ বিষয়ে) যা"],["هُمْ","hum","they","তারা"],["فِيهِ","fīhi","[in it]","যাতে"],["يَخْتَلِفُونَ ۗ","yakhtalifūna","differ","মতভেদ করছে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَا","lā","(does) not","না"],["يَهْدِى","yahdī","guide","সৎপথে পরিচালনা করেন"],["مَنْ","man","(one) who","তাকে"],["هُوَ","huwa","[he]","যে"],["كَـٰذِبٌۭ","kādhibun","(is) a liar","মিথ্যাবাদী"],["كَفَّارٌۭ","kaffārun","and a disbeliever","কট্টর কাফির"]],"t":"أَلَا لِلَّهِ <h>ٱ</><l>ل</>دِّينُ <h>ٱ</>لْخَالِصُ ۚ وَ<h>ٱ</>لَّذِينَ <h>ٱ</>تَّخَذُو<s>ا۟</> مِ<k>ن دُ</>ونِ<o>هِۦٓ</> أَوْلِ<o>يَآ</>ءَ مَا نَعْبُدُهُمْ إِلَّا لِيُقَرِّبُو<o>نَآ</> إِلَى <h>ٱ</>للَّهِ زُلْفَ<o>ىٰٓ</> إِ<g>نَّ</> <h>ٱ</>للَّهَ يَحْكُمُ بَيْنَهُمْ فِى مَا هُمْ فِيهِ يَخْتَلِفُونَ ۗ إِ<g>نَّ</> <h>ٱ</>للَّهَ لَا يَهْدِى مَنْ هُوَ <m>كَٰ</>ذِ<k>بٌۭ كَ</><p>فَّا</>رٌۭ"},{"n":4,"w":[["لَّوْ","law","If","যদি"],["أَرَادَ","arāda","Allah (had) intended","ইচ্ছে করতেন"],["ٱللَّهُ","l-lahu","Allah (had) intended","আল্লাহ"],["أَن","an","to","যে"],["يَتَّخِذَ","yattakhidha","take","গ্রহণ করবেন"],["وَلَدًۭا","waladan","a son","কোনো পুত্র সন্তান"],["لَّٱصْطَفَىٰ","la-iṣ'ṭafā","surely, He (could) have chosen","মনোনীত করতেন অবশ্যই"],["مِمَّا","mimmā","from what","তা হ'তে যা"],["يَخْلُقُ","yakhluqu","He creates","তিনি সৃষ্টি করেন"],["مَا","mā","whatever","যাকে"],["يَشَآءُ ۚ","yashāu","He willed","তিনি চাইতেন"],["سُبْحَـٰنَهُۥ ۖ","sub'ḥānahu","Glory be to Him","(কিন্তু তা হ'তে) তিনি পবিত্র/মহান"],["هُوَ","huwa","He","তিনিই"],["ٱللَّهُ","l-lahu","(is) Allah","আল্লাহ"],["ٱلْوَٰحِدُ","l-wāḥidu","the One","এক"],["ٱلْقَهَّارُ","l-qahāru","the Irresistible","প্রবল পরাক্রমশালী"]],"t":"لَّوْ أَرَادَ <h>ٱ</>للَّهُ <d>أَن يَ</>تَّخِذَ وَلَ<w>دًۭا لَّ</><h>ٱ</>صْطَفَىٰ مِ<g>مَّ</>ا يَخْلُقُ مَا يَ<o>شَآ</>ءُ ۚ سُ<q>بْ</><m>حَٰ</>نَهُ<m>ۥ</> ۖ هُوَ <h>ٱ</>للَّهُ <h>ٱ</>لْ<m>وَٰ</>حِدُ <h>ٱ</>لْقَ<p>هَّا</>رُ"},{"n":5,"w":[["خَلَقَ","khalaqa","He created","তিনি সৃৃষ্টি করেছেন"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশকে"],["وَٱلْأَرْضَ","wal-arḍa","and the earth","ও পৃথিবীকে"],["بِٱلْحَقِّ ۖ","bil-ḥaqi","in [the] truth","সুপরিকল্পিতভাবে"],["يُكَوِّرُ","yukawwiru","He wraps","তিনি ঢেকে রাখেন"],["ٱلَّيْلَ","al-layla","the night","রাতকে"],["عَلَى","‘alā","over","উপর"],["ٱلنَّهَارِ","l-nahāri","the day","দিনের"],["وَيُكَوِّرُ","wayukawwiru","and wraps","এবং ঢেকে রাখেন"],["ٱلنَّهَارَ","l-nahāra","the day","দিনকে"],["عَلَى","‘alā","over","উপর"],["ٱلَّيْلِ ۖ","al-layli","the night","রাতের"],["وَسَخَّرَ","wasakhara","And He subjected","এবং নিয়ন্ত্রিত করেছেন"],["ٱلشَّمْسَ","l-shamsa","the sun","সূর্যকে"],["وَٱلْقَمَرَ ۖ","wal-qamara","and the moon","ও চাঁদকে"],["كُلٌّۭ","kullun","each","প্রত্যেকেই"],["يَجْرِى","yajrī","running","আবর্তন করে"],["لِأَجَلٍۢ","li-ajalin","for a term","একটি কাল পর্যন্ত"],["مُّسَمًّى ۗ","musamman","specified","নির্দিষ্ট"],["أَلَا","alā","Unquestionably","জেনে রেখো"],["هُوَ","huwa","He","তিনিই"],["ٱلْعَزِيزُ","l-‘azīzu","(is) the All-Mighty","মহাপরাক্রমশালী"],["ٱلْغَفَّـٰرُ","l-ghafāru","the Oft-Forgiving","পরম ক্ষমাশীল"]],"t":"خَلَقَ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضَ بِ<h>ٱ</>لْحَقِّ ۖ يُكَوِّرُ <h>ٱ</>لَّيْلَ عَلَى <h>ٱ</><l>ل</><g>نَّ</>هَارِ وَيُكَوِّرُ <h>ٱ</><l>ل</><g>نَّ</>هَارَ عَلَى <h>ٱ</>لَّيْلِ ۖ وَسَخَّرَ <h>ٱ</><l>ل</>شَّمْسَ وَ<h>ٱ</>لْقَمَرَ ۖ كُ<d>لٌّۭ يَ</><q>جْ</>رِى لِأَجَ<d>لٍۢ مُّ</>سَ<g>مًّ</>ى ۗ أَلَا هُوَ <h>ٱ</>لْعَزِيزُ <h>ٱ</>لْغَ<p>فَّٰ</>رُ"},{"n":6,"w":[["خَلَقَكُم","khalaqakum","He created you","তোমাদের তিনি সৃষ্টি করেছেন"],["مِّن","min","from","থেকে"],["نَّفْسٍۢ","nafsin","a soul","ব্যক্তি"],["وَٰحِدَةٍۢ","wāḥidatin","single","একই"],["ثُمَّ","thumma","Then","এরপর"],["جَعَلَ","ja‘ala","He made","সৃষ্টি করেছেন"],["مِنْهَا","min'hā","from it","তার থেকে"],["زَوْجَهَا","zawjahā","its mate","তার জোড়া"],["وَأَنزَلَ","wa-anzala","And He sent down","ও দিয়েছেন"],["لَكُم","lakum","for you","তোমাদের জন্যে"],["مِّنَ","mina","of","মধ্যে হতে"],["ٱلْأَنْعَـٰمِ","l-an‘āmi","the cattle","গবাদি পশুদের"],["ثَمَـٰنِيَةَ","thamāniyata","eight","আট"],["أَزْوَٰجٍۢ ۚ","azwājin","kinds","জোড়া"],["يَخْلُقُكُمْ","yakhluqukum","He creates you","তোমাদেরকে সৃষ্টি করেন"],["فِى","fī","in","মধ্যে"],["بُطُونِ","buṭūni","(the) wombs","পেটসমূহের"],["أُمَّهَـٰتِكُمْ","ummahātikum","(of) your mothers","তোমাদের মায়েদের"],["خَلْقًۭا","khalqan","creation","সৃষ্টির"],["مِّنۢ","min","after","থেকে"],["بَعْدِ","ba‘di","after","পরে"],["خَلْقٍۢ","khalqin","creation","সৃষ্টি"],["فِى","fī","in","মধ্যে"],["ظُلُمَـٰتٍۢ","ẓulumātin","darkness[es]","অন্ধকারসমূহের"],["ثَلَـٰثٍۢ ۚ","thalāthin","three","তিনটি (আবরণের)"],["ذَٰلِكُمُ","dhālikumu","That","তিনিই তোমাদের"],["ٱللَّهُ","l-lahu","(is) Allah","আল্লাহ"],["رَبُّكُمْ","rabbukum","your Lord","তোমাদের রব"],["لَهُ","lahu","for Him","তাঁরই"],["ٱلْمُلْكُ ۖ","l-mul'ku","(is) the dominion","সার্বভৌমত্ব"],["لَآ","lā","(There is) no","নেই"],["إِلَـٰهَ","ilāha","god","কোনো ইলাহ"],["إِلَّا","illā","except","ব্যতীত"],["هُوَ ۖ","huwa","He","তিনি"],["فَأَنَّىٰ","fa-annā","Then how","সুতরাং কোথায়"],["تُصْرَفُونَ","tuṣ'rafūna","are you turning away","তোমাদের ফিরানো হচ্ছে"]],"t":"خَلَقَ<y>كُم مِّ</><d>ن نَّفْسٍۢ وَٰ</>حِدَ<k>ةٍۢ ثُ</><g>مَّ</> جَعَلَ مِنْهَا زَوْجَهَا وَأَ<k>نزَ</>لَ لَ<y>كُم مِّ</>نَ <h>ٱ</>لْأَنْ<m>عَٰ</>مِ ثَ<m>مَٰ</>نِيَةَ أَزْ<m>وَٰ</><d>جٍۢ ۚ يَ</>خْلُقُكُمْ فِى بُطُونِ أُ<g>مَّ</><m>هَٰ</>تِكُمْ خَلْ<d>قًۭا مِّ</><i>نۢ بَ</>عْدِ خَلْ<k>قٍۢ فِ</>ى ظُلُ<m>مَٰ</><k>تٍۢ ثَ</><m>لَٰ</><k>ثٍۢ ۚ ذَٰ</>لِكُمُ <h>ٱ</>للَّهُ رَبُّكُمْ لَهُ <h>ٱ</>لْمُلْكُ ۖ <o>لَآ</> إِ<m>لَٰ</>هَ إِلَّا هُوَ ۖ فَأَ<g>نَّ</>ىٰ تُصْرَ<p>فُو</>نَ"},{"n":7,"w":[["إِن","in","If","যদি"],["تَكْفُرُوا۟","takfurū","you disbelieve","তোমরা অকৃতজ্ঞ হও"],["فَإِنَّ","fa-inna","then indeed","নিশ্চযই তবুও়"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["غَنِىٌّ","ghaniyyun","(is) free from need","অমুখাপেক্ষী"],["عَنكُمْ ۖ","‘ankum","of you","তোমাদের থেকে"],["وَلَا","walā","And not","কিন্তু না"],["يَرْضَىٰ","yarḍā","He likes","পছন্দ করেন তিনি"],["لِعِبَادِهِ","li‘ibādihi","in His slaves","তাঁর দাসদের জন্যে"],["ٱلْكُفْرَ ۖ","l-kuf'ra","ungratefulness","অকৃতজ্ঞতাকে"],["وَإِن","wa-in","And if","এবং যদি"],["تَشْكُرُوا۟","tashkurū","you are grateful","তোমরা কৃতজ্ঞ হও"],["يَرْضَهُ","yarḍahu","He likes it","তা  তিনি পছন্দ করেন"],["لَكُمْ ۗ","lakum","in you","তোমাদের জন্যে"],["وَلَا","walā","And not","এবং না"],["تَزِرُ","taziru","will bear","বহন করবে"],["وَازِرَةٌۭ","wāziratun","bearer of burdens","কোনো বোঝাবহনকারী"],["وِزْرَ","wiz'ra","(the) burden","বোঝা"],["أُخْرَىٰ ۗ","ukh'rā","(of) another","অন্যের"],["ثُمَّ","thumma","Then","এরপর"],["إِلَىٰ","ilā","to","দিকে"],["رَبِّكُم","rabbikum","your Lord","তোমাদের রবের"],["مَّرْجِعُكُمْ","marji‘ukum","(is) your return","তোমাদের প্রত্যাবর্তন হবে"],["فَيُنَبِّئُكُم","fayunabbi-ukum","then He will inform you","তোমাদেরকে অতঃপর তিনি জানিয়ে দিবেন"],["بِمَا","bimā","about what","ঐ বিষয়ে যা"],["كُنتُمْ","kuntum","you used to","তোমরা"],["تَعْمَلُونَ ۚ","ta‘malūna","do","কাজ করতেছিলে"],["إِنَّهُۥ","innahu","Indeed, He","তিনি নিশ্চয়ই"],["عَلِيمٌۢ","‘alīmun","(is) the All-Knower","ভালোভাবেই জানেন"],["بِذَاتِ","bidhāti","of what (is) in the breasts","অবস্থা সম্পর্কে"],["ٱلصُّدُورِ","l-ṣudūri","of what (is) in the breasts","অন্তরসমূহের"]],"t":"إِ<k>ن تَ</>كْفُرُو<s>ا۟</> فَإِ<g>نَّ</> <h>ٱ</>للَّهَ غَنِىٌّ عَ<k>نكُ</>مْ ۖ وَلَا يَرْضَىٰ لِعِبَادِهِ <h>ٱ</>لْكُفْرَ ۖ وَإِ<k>ن تَ</>شْكُرُو<s>ا۟</> يَرْضَهُ لَكُمْ ۗ وَلَا تَزِرُ وَازِرَ<d>ةٌۭ وِ</>زْرَ أُخْرَىٰ ۗ ثُ<g>مَّ</> إِلَىٰ رَبِّ<y>كُم مَّ</>رْجِعُكُمْ فَيُنَبِّئُ<f>كُم بِ</>مَا كُ<k>نتُ</>مْ تَعْمَلُونَ ۚ إِ<g>نَّ</>هُ<m>ۥ</> عَلِي<i>مٌۢ بِ</>ذَاتِ <h>ٱ</><l>ل</>صُّ<p>دُو</>رِ"},{"n":8,"w":[["۞ وَإِذَا","wa-idhā","And when","এবং যখন"],["مَسَّ","massa","touches","স্পর্শ করে"],["ٱلْإِنسَـٰنَ","l-insāna","[the] man","মানুষকে"],["ضُرٌّۭ","ḍurrun","adversity","কোনো দুঃখদৈন্য"],["دَعَا","da‘ā","he calls","সে ডাকে"],["رَبَّهُۥ","rabbahu","his Lord","তার রবকে"],["مُنِيبًا","munīban","turning","একাগ্রচিত্তে"],["إِلَيْهِ","ilayhi","to Him","তাঁর দিকে"],["ثُمَّ","thumma","then","এরপর"],["إِذَا","idhā","when","যখন"],["خَوَّلَهُۥ","khawwalahu","He bestows on him","তাকে দান করেন"],["نِعْمَةًۭ","ni‘'matan","a favor","অনুগ্রহ"],["مِّنْهُ","min'hu","from Himself","তাঁর পক্ষ হতে"],["نَسِىَ","nasiya","he forgets","সে ভুলে যায়"],["مَا","mā","(for) what","যার(জন্য)"],["كَانَ","kāna","he used to call","সে"],["يَدْعُوٓا۟","yad‘ū","he used to call","ডাকছিলো"],["إِلَيْهِ","ilayhi","[to] Him","তার দিকে (একনিষ্ঠভাবে)"],["مِن","min","before","হ'তে"],["قَبْلُ","qablu","before","পূর্বে"],["وَجَعَلَ","waja‘ala","and he sets up","এবং দাঁড় করায়"],["لِلَّهِ","lillahi","to Allah","আল্লাহর জন্যে"],["أَندَادًۭا","andādan","rivals","সমকক্ষ"],["لِّيُضِلَّ","liyuḍilla","to mislead","বিভ্রান্ত করে যেন"],["عَن","‘an","from","হ'তে"],["سَبِيلِهِۦ ۚ","sabīlihi","His Path","তাঁর পথ"],["قُلْ","qul","Say","(হে নাবী) বলো"],["تَمَتَّعْ","tamatta‘","Enjoy","\"উপভোগ করো"],["بِكُفْرِكَ","bikuf'rika","in your disbelief","তোমার অকৃতজ্ঞ অবস্থার (স্বাদ)"],["قَلِيلًا ۖ","qalīlan","(for) a little","কিছুক্ষণ"],["إِنَّكَ","innaka","Indeed, you","তুমি নিশ্চয়ই"],["مِنْ","min","(are) of","অন্তর্ভুক্ত"],["أَصْحَـٰبِ","aṣḥābi","(the) companions","অধিবাসীদের"],["ٱلنَّارِ","l-nāri","(of) the Fire","জাহান্নামের\""]],"t":"۞ وَإِذَا مَسَّ <h>ٱ</>لْإِ<k>نسَٰ</>نَ ضُ<k>رٌّۭ دَ</>عَا رَبَّهُ<m>ۥ</> مُنِيبًا إِلَيْهِ ثُ<g>مَّ</> إِذَا خَوَّلَهُ<m>ۥ</> نِعْمَ<d>ةًۭ مِّ</>نْهُ نَسِىَ مَا كَانَ يَ<q>دْ</><o>عُوٓ</><s>ا۟</> إِلَيْهِ مِ<k>ن قَ</><q>بْ</>لُ وَجَعَلَ لِلَّهِ أَ<k>ندَ</>ا<w>دًۭا لِّ</>يُضِلَّ عَ<k>ن سَ</>بِيلِ<m>هِۦ</> ۚ قُلْ تَمَتَّعْ بِكُفْرِكَ قَلِيلًا ۖ إِ<g>نَّ</>كَ مِنْ أَصْ<m>حَٰ</>بِ <h>ٱ</><l>ل</><g>نَّ</><p>ا</>رِ"},{"n":9,"w":[["أَمَّنْ","amman","Is (one) who","সে কি সমান"],["هُوَ","huwa","[he]","যে"],["قَـٰنِتٌ","qānitun","(is) devoutly obedient ","আনুগত্য প্রকাশকারী"],["ءَانَآءَ","ānāa","(during) hours","বেলায়"],["ٱلَّيْلِ","al-layli","(of) the night","রাতের"],["سَاجِدًۭا","sājidan","prostrating","অথবা সিজদারত অবস্হায়"],["وَقَآئِمًۭا","waqāiman","and standing","দাঁড়ানো অবস্হায়"],["يَحْذَرُ","yaḥdharu","fearing","ভয় করে"],["ٱلْـَٔاخِرَةَ","l-ākhirata","the Hereafter","পরকালকে"],["وَيَرْجُوا۟","wayarjū","and hoping","ও প্রত্যাশা করে"],["رَحْمَةَ","raḥmata","(for the) Mercy","অনুগ্রহের"],["رَبِّهِۦ ۗ","rabbihi","(of) his Lord","তার রবের"],["قُلْ","qul","Say","বলো"],["هَلْ","hal","Are","\"কি"],["يَسْتَوِى","yastawī","equal","সমান হয়"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["يَعْلَمُونَ","ya‘lamūna","know","জানে"],["وَٱلَّذِينَ","wa-alladhīna","and those who","ও যারা"],["لَا","lā","(do) not","না"],["يَعْلَمُونَ ۗ","ya‘lamūna","know","জানে\""],["إِنَّمَا","innamā","Only","প্রকৃতপক্ষে"],["يَتَذَكَّرُ","yatadhakkaru","will take heed","শিক্ষা গ্রহণ করে"],["أُو۟لُوا۟","ulū","those of understanding","সম্পন্নরাই"],["ٱلْأَلْبَـٰبِ","l-albābi","those of understanding","বোধ-বুদ্ধি"]],"t":"أَ<g>مَّ</>نْ هُوَ <m>قَٰ</>نِتٌ ءَا<o>نَآ</>ءَ <h>ٱ</>لَّيْلِ سَاجِ<d>دًۭا وَ</><o>قَآ</>ئِ<d>مًۭا يَ</>حْذَرُ <h>ٱ</>لْءَاخِرَةَ وَيَرْجُو<s>ا۟</> رَحْمَةَ رَبِّ<m>هِۦ</> ۗ قُلْ هَلْ يَسْتَوِى <h>ٱ</>لَّذِينَ يَعْلَمُونَ وَ<h>ٱ</>لَّذِينَ لَا يَعْلَمُونَ ۗ إِ<g>نَّ</>مَا يَتَذَكَّرُ أُ<s>و۟</>لُو<s>ا۟</> <h>ٱ</>لْأَلْ<p>بَٰ</><q>بِ</>"},{"n":10,"w":[["قُلْ","qul","Say","বলো"],["يَـٰعِبَادِ","yā‘ibādi","O My slaves","\"হে আমার দাসগণ"],["ٱلَّذِينَ","alladhīna","[those] who","যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছো"],["ٱتَّقُوا۟","ittaqū","Fear","তোমরা ভয় করো"],["رَبَّكُمْ ۚ","rabbakum","your Lord","তোমাদের রবকে"],["لِلَّذِينَ","lilladhīna","For those who","(তাদের) জন্যে যারা"],["أَحْسَنُوا۟","aḥsanū","do good","উত্তম কাজ করেছে"],["فِى","fī","in","মধ্যে"],["هَـٰذِهِ","hādhihi","this","এই"],["ٱلدُّنْيَا","l-dun'yā","world","পৃথিবীতে"],["حَسَنَةٌۭ ۗ","ḥasanatun","(is) good","কল্যাণ (রয়েছে)"],["وَأَرْضُ","wa-arḍu","and the earth","এবং পৃথিবী"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَٰسِعَةٌ ۗ","wāsi‘atun","(is) spacious","প্রশস্ত"],["إِنَّمَا","innamā","Only","মূলতঃ"],["يُوَفَّى","yuwaffā","will be paid back in full","পূর্ণ দেওয়া হবে"],["ٱلصَّـٰبِرُونَ","l-ṣābirūna","the patient ones","ধৈর্য্যশীলদেরকে"],["أَجْرَهُم","ajrahum","their reward","প্রতিফল তাদের"],["بِغَيْرِ","bighayri","without","ব্যতীতই"],["حِسَابٍۢ","ḥisābin","account","কোনো হিসাব\""]],"t":"قُلْ <m>يَٰ</>عِبَادِ <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> <h>ٱ</>تَّقُو<s>ا۟</> رَبَّكُمْ ۚ لِلَّذِينَ أَحْسَنُو<s>ا۟</> فِى <m>هَٰ</>ذِهِ <h>ٱ</><l>ل</>دُّنْيَا حَسَنَ<d>ةٌۭ ۗ وَ</>أَرْضُ <h>ٱ</>للَّهِ <m>وَٰ</>سِعَةٌ ۗ إِ<g>نَّ</>مَا يُوَفَّى <h>ٱ</><l>ل</><m>صَّٰ</>بِرُونَ أَ<q>جْ</>رَ<f>هُم بِ</>غَيْرِ حِ<p>سَا</><q>بٍۢ</>"},{"n":11,"w":[["قُلْ","qul","Say","(হে নাবী) বলো"],["إِنِّىٓ","innī","Indeed, I","\"নিশ্চয়ই আমি"],["أُمِرْتُ","umir'tu","[I] am commanded","আমি আদিষ্ট হয়েছি"],["أَنْ","an","that","যে"],["أَعْبُدَ","a‘buda","I worship","আমি (যেন) ইবাদত করি"],["ٱللَّهَ","l-laha","Allah","আল্লাহর"],["مُخْلِصًۭا","mukh'liṣan","(being) sincere","একনিষ্ঠভাবে"],["لَّهُ","lahu","to Him","তাঁরই জন্যে"],["ٱلدِّينَ","l-dīna","(in) the religion","আনুগত্যকে (নির্দিষ্ট করে)"]],"t":"قُلْ إِ<g>نِّ</><o>ىٓ</> أُمِرْتُ أَنْ أَعْبُدَ <h>ٱ</>للَّهَ مُخْلِ<w>صًۭا لَّ</>هُ <h>ٱ</><l>ل</><p>دِّي</>نَ"},{"n":12,"w":[["وَأُمِرْتُ","wa-umir'tu","And I am commanded","এবং আমি আদিষ্ট হয়েছি"],["لِأَنْ","li-an","that","এজন্যেও যে"],["أَكُونَ","akūna","I be","আমি হই (যেন)"],["أَوَّلَ","awwala","(the) first","প্রথম"],["ٱلْمُسْلِمِينَ","l-mus'limīna","(of) those who submit","মুসলমানদের\""]],"t":"وَأُمِرْتُ لِأَنْ أَكُونَ أَوَّلَ <h>ٱ</>لْمُسْلِ<p>مِي</>نَ"},{"n":13,"w":[["قُلْ","qul","Say","বলো"],["إِنِّىٓ","innī","Indeed, I","\"আমি নিশ্চয়ই"],["أَخَافُ","akhāfu","[I] fear","ভয় করি"],["إِنْ","in","if","যদি"],["عَصَيْتُ","‘aṣaytu","I disobey","আমি অবাধ্য হই"],["رَبِّى","rabbī","my Lord","আমার রবের"],["عَذَابَ","‘adhāba","(the) punishment","শাস্তির"],["يَوْمٍ","yawmin","(of) a Day","দিনের"],["عَظِيمٍۢ","‘aẓīmin","great","কঠিন\""]],"t":"قُلْ إِ<g>نِّ</><o>ىٓ</> أَخَافُ إِنْ عَصَيْتُ رَبِّى عَذَابَ يَوْمٍ عَ<p>ظِي</>مٍۢ"},{"n":14,"w":[["قُلِ","quli","Say","বলো"],["ٱللَّهَ","l-laha","I worship Allah","\"আল্লাহকে"],["أَعْبُدُ","a‘budu","I worship Allah","\"ইবাদাত করি আমি"],["مُخْلِصًۭا","mukh'liṣan","(being) sincere","একনিষ্ঠভাবে"],["لَّهُۥ","lahu","to Him","তাঁরই জন্যে"],["دِينِى","dīnī","(in) my religion","আমার আনুগত্যকে (নির্দিষ্ট করে)"]],"t":"قُلِ <h>ٱ</>للَّهَ أَعْبُدُ مُخْلِ<w>صًۭا لَّ</>هُ<m>ۥ</> دِينِى"},{"n":15,"w":[["فَٱعْبُدُوا۟","fa-u‘'budū","So worship","তোমরা দাসত্ব করো"],["مَا","mā","what","যাকে"],["شِئْتُم","shi'tum","you will","তোমরা চাও"],["مِّن","min","besides Him","\""],["دُونِهِۦ ۗ","dūnihi","besides Him","তাঁকে ছাড়া\""],["قُلْ","qul","Say","বলো"],["إِنَّ","inna","Indeed","\"নিশ্চয়ই"],["ٱلْخَـٰسِرِينَ","l-khāsirīna","the losers","ক্ষতিগ্রস্ত হবে (তারাই)"],["ٱلَّذِينَ","alladhīna","(are) those who","যারা"],["خَسِرُوٓا۟","khasirū","(will) lose","ক্ষতিগ্রস্ত করেছে"],["أَنفُسَهُمْ","anfusahum","themselves","তাদের নিজেদেরকে"],["وَأَهْلِيهِمْ","wa-ahlīhim","and their families","ও তাদের পরিবারকে"],["يَوْمَ","yawma","(on the) Day","দিনে"],["ٱلْقِيَـٰمَةِ ۗ","l-qiyāmati","(of) the Resurrection","ক্বিয়ামাতের"],["أَلَا","alā","Unquestionably","জেনে রাখো"],["ذَٰلِكَ","dhālika","that ","এটাই"],["هُوَ","huwa","it","সেই"],["ٱلْخُسْرَانُ","l-khus'rānu","(is) the loss","ক্ষতি"],["ٱلْمُبِينُ","l-mubīnu","the clear","সুস্পষ্ট\""]],"t":"فَ<h>ٱ</>عْبُدُو<s>ا۟</> مَا شِئْ<y>تُم مِّ</><k>ن دُ</>ونِ<m>هِۦ</> ۗ قُلْ إِ<g>نَّ</> <h>ٱ</>لْ<m>خَٰ</>سِرِينَ <h>ٱ</>لَّذِينَ خَسِ<o>رُوٓ</><s>ا۟</> أَ<k>نفُ</>سَهُمْ وَأَهْلِيهِمْ يَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ ۗ أَلَا <m>ذَٰ</>لِكَ هُوَ <h>ٱ</>لْخُسْرَانُ <h>ٱ</>لْمُ<p>بِي</>نُ"},{"n":16,"w":[["لَهُم","lahum","For them","তাদের জন্যে (রয়েছে)"],["مِّن","min","from","হ'তে"],["فَوْقِهِمْ","fawqihim","above them","তাদের উপর (দিক)"],["ظُلَلٌۭ","ẓulalun","coverings","আচ্ছাদন"],["مِّنَ","mina","of","তৈরী"],["ٱلنَّارِ","l-nāri","the Fire","আগুনের"],["وَمِن","wamin","and from","ও হ'তে"],["تَحْتِهِمْ","taḥtihim","below them","তাদের নীচ"],["ظُلَلٌۭ ۚ","ẓulalun","coverings","(আগুনের) আচ্ছাদন"],["ذَٰلِكَ","dhālika","(With) that","এটা"],["يُخَوِّفُ","yukhawwifu","threatens","সতর্ক করেন (ভয় দেখান)"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["بِهِۦ","bihi","[with it]","এ দিয়ে"],["عِبَادَهُۥ ۚ","‘ibādahu","His slaves","তাঁর দাসদেরকে"],["يَـٰعِبَادِ","yā‘ibādi","O My slaves","\"হে আমার দাসগণ"],["فَٱتَّقُونِ","fa-ittaqūni","So fear Me","তাই তোমরা আমাকে ভয় করো\""]],"t":"لَ<y>هُم مِّ</><k>ن فَ</>وْقِهِمْ ظُلَ<d>لٌۭ مِّ</>نَ <h>ٱ</><l>ل</><g>نَّ</>ارِ وَمِ<k>ن تَ</>حْتِهِمْ ظُلَ<k>لٌۭ ۚ ذَٰ</>لِكَ يُخَوِّفُ <h>ٱ</>للَّهُ بِ<m>هِۦ</> عِبَادَهُ<m>ۥ</> ۚ <m>يَٰ</>عِبَادِ فَ<h>ٱ</>تَّ<p>قُو</>نِ"},{"n":17,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["ٱجْتَنَبُوا۟","ij'tanabū","avoid","দূরে থাকে"],["ٱلطَّـٰغُوتَ","l-ṭāghūta","the false gods","তাগুত (থেকে)"],["أَن","an","lest","যে"],["يَعْبُدُوهَا","ya‘budūhā","they worship them","দাসত্ব করে তারা তার"],["وَأَنَابُوٓا۟","wa-anābū","and turn","এবং অনুরাগী হয়"],["إِلَى","ilā","to","দিকে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["لَهُمُ","lahumu","for them","তাদের জন্যে (রয়েছে)"],["ٱلْبُشْرَىٰ ۚ","l-bush'rā","(are) glad tidings","সুসংবাদ"],["فَبَشِّرْ","fabashir","So give glad tidings","সুতরাং সুসংবাদ দাও"],["عِبَادِ","‘ibādi","(to) My slaves","আমার দাসদেরকে"]],"t":"وَ<h>ٱ</>لَّذِينَ <h>ٱ</><q>جْ</>تَنَبُو<s>ا۟</> <h>ٱ</><l>ل</><m>طَّٰ</>غُوتَ <d>أَن يَ</>عْبُدُوهَا وَأَنَا<o>بُوٓ</><s>ا۟</> إِلَى <h>ٱ</>للَّهِ لَهُمُ <h>ٱ</>لْبُشْرَىٰ ۚ فَبَشِّرْ عِ<p>بَا</><q>دِ</>"},{"n":18,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["يَسْتَمِعُونَ","yastami‘ūna","they listen (to)","মনোযোগ দিয়ে শুনে"],["ٱلْقَوْلَ","l-qawla","the Word","কথা"],["فَيَتَّبِعُونَ","fayattabi‘ūna","then follow","অতঃপর অনুসরণ করে"],["أَحْسَنَهُۥٓ ۚ","aḥsanahu","the best thereof","তার উত্তম (সবদিকগুলোর)"],["أُو۟لَـٰٓئِكَ","ulāika","those","ঐ সবলোক"],["ٱلَّذِينَ","alladhīna","(are) they whom","(তারাই) যাদেরকে"],["هَدَىٰهُمُ","hadāhumu","Allah has guided them","সৎপথে পরিচালনা করেন তাদের"],["ٱللَّهُ ۖ","l-lahu","Allah has guided them","আল্লাহ"],["وَأُو۟لَـٰٓئِكَ","wa-ulāika","and those","এবং ঐ সবলোক"],["هُمْ","hum","are [they]","তারাই"],["أُو۟لُوا۟","ulū","the men of understanding","সম্পন্ন"],["ٱلْأَلْبَـٰبِ","l-albābi","the men of understanding","বিবেক বুদ্ধি"]],"t":"ٱلَّذِينَ يَسْتَمِعُونَ <h>ٱ</>لْقَوْلَ فَيَتَّبِعُونَ أَحْسَنَهُ<o>ۥٓ ۚ</> أُ<s>و۟</><o>لَٰٓ</>ئِكَ <h>ٱ</>لَّذِينَ هَدَ<m>ىٰ</>هُمُ <h>ٱ</>للَّهُ ۖ وَأُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمْ أُ<s>و۟</>لُو<s>ا۟</> <h>ٱ</>لْأَلْ<p>بَٰ</><q>بِ</>"},{"n":19,"w":[["أَفَمَنْ","afaman","Then, is (one) who","তবে কি যে"],["حَقَّ","ḥaqqa","became due","অবধারিত হয়েছে"],["عَلَيْهِ","‘alayhi","on him","তার উপর"],["كَلِمَةُ","kalimatu","the word","বাণী"],["ٱلْعَذَابِ","l-‘adhābi","(of) the punishment","শাস্তির (পরিত্রাণ পেতে পারে?)"],["أَفَأَنتَ","afa-anta","Then can you","তবে কি তুমি"],["تُنقِذُ","tunqidhu","save","উদ্ধার করতে পারবে"],["مَن","man","(one) who","যে"],["فِى","fī","(is) in","মধ্যে (পড়েছে)"],["ٱلنَّارِ","l-nāri","the Fire","আগুনের"]],"t":"أَفَمَنْ حَقَّ عَلَيْهِ كَلِمَةُ <h>ٱ</>لْعَذَابِ أَفَأَ<k>نتَ</> تُ<k>نقِ</>ذُ مَ<k>ن فِ</>ى <h>ٱ</><l>ل</><g>نَّ</><p>ا</>رِ"},{"n":20,"w":[["لَـٰكِنِ","lākini","But","কিন্তু"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ٱتَّقَوْا۟","ittaqaw","fear","ভয় করে"],["رَبَّهُمْ","rabbahum","their Lord","তাদের রবকে"],["لَهُمْ","lahum","for them","তাদের জন্যে (রয়েছে)"],["غُرَفٌۭ","ghurafun","(are) lofty mansions","প্রাসাদ"],["مِّن","min","above them","থেকে"],["فَوْقِهَا","fawqihā","above them","তার উপর"],["غُرَفٌۭ","ghurafun","lofty mansions","প্রাসাদ"],["مَّبْنِيَّةٌۭ","mabniyyatun","built high","নির্মিত"],["تَجْرِى","tajrī","flow","বইবে"],["مِن","min","from","থেকে"],["تَحْتِهَا","taḥtihā","beneath it","তার নীচ"],["ٱلْأَنْهَـٰرُ ۖ","l-anhāru","the rivers","ঝর্ণাসমূহ"],["وَعْدَ","wa‘da","(The) Promise","প্রতিশ্রুতি"],["ٱللَّهِ ۖ","l-lahi","(of) Allah","আল্লাহর"],["لَا","lā","Not","না"],["يُخْلِفُ","yukh'lifu","Allah fails","ভঙ্গ করেন"],["ٱللَّهُ","l-lahu","Allah fails","আল্লাহ"],["ٱلْمِيعَادَ","l-mī‘āda","(in His) promise","প্রতিশ্রুতি"]],"t":"<m>لَٰ</>كِنِ <h>ٱ</>لَّذِينَ <h>ٱ</>تَّقَوْ<s>ا۟</> رَبَّهُمْ لَهُمْ غُرَ<d>فٌۭ مِّ</><k>ن فَ</>وْقِهَا غُرَ<d>فٌۭ مَّ</><q>بْ</>نِيَّ<k>ةٌۭ تَ</><q>جْ</>رِى مِ<k>ن تَ</>حْتِهَا <h>ٱ</>لْأَنْ<m>هَٰ</>رُ ۖ وَعْدَ <h>ٱ</>للَّهِ ۖ لَا يُخْلِفُ <h>ٱ</>للَّهُ <h>ٱ</>لْمِي<p>عَا</><q>دَ</>"},{"n":21,"w":[["أَلَمْ","alam","Do not","তুমি কি"],["تَرَ","tara","you see","দেখো না"],["أَنَّ","anna","that","যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["أَنزَلَ","anzala","sends down","বর্ষণ করেন"],["مِنَ","mina","from","হ'তে"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশ"],["مَآءًۭ","māan","water","পানি"],["فَسَلَكَهُۥ","fasalakahu","and He makes it flow","তা অতঃপর প্রবাহিত করেন"],["يَنَـٰبِيعَ","yanābī‘a","(as) springs","স্রোতধারা"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","ভূমির"],["ثُمَّ","thumma","then","এরপর"],["يُخْرِجُ","yukh'riju","He produces","বের করেন"],["بِهِۦ","bihi","with it","তা দিয়ে"],["زَرْعًۭا","zar‘an","crops","ফসল"],["مُّخْتَلِفًا","mukh'talifan","(of) different","বিভিন্ন প্রকার"],["أَلْوَٰنُهُۥ","alwānuhu","colors","তার রংসমূহও"],["ثُمَّ","thumma","then","এরপর"],["يَهِيجُ","yahīju","they wither","শুকিয়ে যায়"],["فَتَرَىٰهُ","fatarāhu","and you see it","তা তখন তুমি দেখো"],["مُصْفَرًّۭا","muṣ'farran","turn yellow","হলুদবর্ণ"],["ثُمَّ","thumma","then","এরপর"],["يَجْعَلُهُۥ","yaj‘aluhu","He makes them","তা পরিণত করেন"],["حُطَـٰمًا ۚ","ḥuṭāman","debris","খড়কুটায়"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে"],["ذَٰلِكَ","dhālika","that","(রয়েছে) এর"],["لَذِكْرَىٰ","ladhik'rā","surely, (is) a reminder","শিক্ষা অবশ্যই"],["لِأُو۟لِى","li-ulī","for those of understanding","সম্পন্নদের জন্যে"],["ٱلْأَلْبَـٰبِ","l-albābi","for those of understanding","জ্ঞান-বুদ্ধির"]],"t":"أَلَمْ تَرَ أَ<g>نَّ</> <h>ٱ</>للَّهَ أَ<k>نزَ</>لَ مِنَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ <o>مَآ</><k>ءًۭ فَ</>سَلَكَهُ<m>ۥ</> يَ<m>نَٰ</>بِيعَ فِى <h>ٱ</>لْأَرْضِ ثُ<g>مَّ</> يُخْرِجُ بِ<m>هِۦ</> زَرْ<d>عًۭا مُّ</>خْتَلِفًا أَلْ<m>وَٰ</>نُهُ<m>ۥ</> ثُ<g>مَّ</> يَهِيجُ فَتَرَ<m>ىٰ</>هُ مُصْفَ<k>رًّۭا ثُ</><g>مَّ</> يَ<q>جْ</>عَلُهُ<m>ۥ</> حُ<m>طَٰ</>مًا ۚ إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَذِكْرَىٰ لِأُ<s>و۟</>لِى <h>ٱ</>لْأَلْ<p>بَٰ</><q>بِ</>"},{"n":22,"w":[["أَفَمَن","afaman","So is (one for) whom","তবে কি যার"],["شَرَحَ","sharaḥa","Allah has expanded","খুলে দিয়েছেন"],["ٱللَّهُ","l-lahu","Allah has expanded","আল্লাহ"],["صَدْرَهُۥ","ṣadrahu","his breast","তার হৃদয়কে"],["لِلْإِسْلَـٰمِ","lil'is'lāmi","for Islam","ইসলামের জন্যে"],["فَهُوَ","fahuwa","so he","অতঃপর সে"],["عَلَىٰ","‘alā","(is) upon","(চলে)উপর"],["نُورٍۢ","nūrin","a light","আলোর"],["مِّن","min","from","পক্ষ হ'তে"],["رَّبِّهِۦ ۚ","rabbihi","his Lord","তার রবের (সে অন্যদের মতো কি?)"],["فَوَيْلٌۭ","fawaylun","So woe","সুতরাং দুর্ভোগ"],["لِّلْقَـٰسِيَةِ","lil'qāsiyati","to (those are) hardened","(সেই লোকদের) জন্যে পাষাণের"],["قُلُوبُهُم","qulūbuhum","their hearts","যাদের অন্তরসমূহ"],["مِّن","min","from","হ'তে"],["ذِكْرِ","dhik'ri","(the) remembrance of Allah","স্মরণ"],["ٱللَّهِ ۚ","l-lahi","(the) remembrance of Allah","আল্লাহর"],["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব লোক"],["فِى","fī","(are) in","মধ্যে (রয়েছে)"],["ضَلَـٰلٍۢ","ḍalālin","error","বিভ্রান্তির"],["مُّبِينٍ","mubīnin","clear","সুস্পষ্ট"]],"t":"أَفَمَ<k>ن شَ</>رَحَ <h>ٱ</>للَّهُ صَ<q>دْ</>رَهُ<m>ۥ</> لِلْإِسْ<m>لَٰ</>مِ فَهُوَ عَلَىٰ نُو<d>رٍۢ مِّ</><w>ن رَّ</>بِّ<m>هِۦ</> ۚ فَوَيْ<w>لٌۭ لِّ</>لْ<m>قَٰ</>سِيَةِ قُلُوبُ<y>هُم مِّ</><k>ن ذِ</>كْرِ <h>ٱ</>للَّهِ ۚ أُ<s>و۟</><o>لَٰٓ</>ئِكَ فِى ضَ<m>لَٰ</><d>لٍۢ مُّ</><p>بِي</>نٍ"},{"n":23,"w":[["ٱللَّهُ","al-lahu","Allah","আল্লাহ"],["نَزَّلَ","nazzala","has revealed","অবতীর্ণ করেছেন"],["أَحْسَنَ","aḥsana","(the) best","উত্তম"],["ٱلْحَدِيثِ","l-ḥadīthi","(of) [the] statement ","বাণী (সম্বলিত)"],["كِتَـٰبًۭا","kitāban","a Book","কিতাব"],["مُّتَشَـٰبِهًۭا","mutashābihan","(its parts) resembling each other","সুসামঞ্জস্যপূর্ণ"],["مَّثَانِىَ","mathāniya","oft-repeated","পুনরাবৃত্ত"],["تَقْشَعِرُّ","taqsha‘irru","Shiver","রোমাঞ্চিত হয়"],["مِنْهُ","min'hu","from it","তা থেকে"],["جُلُودُ","julūdu","(the) skins","দেহ"],["ٱلَّذِينَ","alladhīna","(of) those who","(তাদের) যারা"],["يَخْشَوْنَ","yakhshawna","fear","ভয় করে"],["رَبَّهُمْ","rabbahum","their Lord","তাদের রবকে"],["ثُمَّ","thumma","then","এরপর"],["تَلِينُ","talīnu","relax","নরম হয়"],["جُلُودُهُمْ","julūduhum","their skins","তাদের দেহ (সারা দেহ)"],["وَقُلُوبُهُمْ","waqulūbuhum","and their hearts","ও তাদের মনগুলো"],["إِلَىٰ","ilā","at","প্রতি"],["ذِكْرِ","dhik'ri","(the) remembrance","স্মরণের"],["ٱللَّهِ ۚ","l-lahi","(of) Allah","আল্লাহর"],["ذَٰلِكَ","dhālika","That","এটা"],["هُدَى","hudā","(is the) guidance","পথনির্দেশ"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["يَهْدِى","yahdī","He guides","সৎপথে চালান তিনি"],["بِهِۦ","bihi","with it","এ দিয়ে"],["مَن","man","whom","যাকে"],["يَشَآءُ ۚ","yashāu","He wills","তিনি চান"],["وَمَن","waman","And whoever","এবং যাকে"],["يُضْلِلِ","yuḍ'lili","Allah lets go astray","বিভ্রান্ত করেন"],["ٱللَّهُ","l-lahu","Allah lets go astray","আল্লাহ"],["فَمَا","famā","then not","তখন নেই"],["لَهُۥ","lahu","for him","তার"],["مِنْ","min","any","কোনো"],["هَادٍ","hādin","guide","পথ প্রদর্শক"]],"t":"ٱللَّهُ نَزَّلَ أَحْسَنَ <h>ٱ</>لْحَدِيثِ كِ<m>تَٰ</><d>بًۭا مُّ</>تَ<m>شَٰ</>بِ<d>هًۭا مَّ</>ثَانِىَ تَ<q>قْ</>شَعِرُّ مِنْهُ جُلُودُ <h>ٱ</>لَّذِينَ يَخْشَوْنَ رَبَّهُمْ ثُ<g>مَّ</> تَلِينُ جُلُودُهُمْ وَقُلُوبُهُمْ إِلَىٰ ذِكْرِ <h>ٱ</>للَّهِ ۚ <m>ذَٰ</>لِكَ هُدَى <h>ٱ</>للَّهِ يَهْدِى بِ<m>هِۦ</> <d>مَن يَ</><o>شَآ</>ءُ ۚ وَ<d>مَن يُ</>ضْلِلِ <h>ٱ</>للَّهُ فَمَا لَهُ<m>ۥ</> مِنْ <p>هَا</><q>دٍ</>"},{"n":24,"w":[["أَفَمَن","afaman","Then (is) he who","তবে কি যে"],["يَتَّقِى","yattaqī","will shield","ঠেকাতে চাইবে"],["بِوَجْهِهِۦ","biwajhihi","with his face","তার চেহারা দিয়ে"],["سُوٓءَ","sūa","(the) worst","কঠিন"],["ٱلْعَذَابِ","l-‘adhābi","punishment","শাস্তিকে"],["يَوْمَ","yawma","(on the) Day","দিনে"],["ٱلْقِيَـٰمَةِ ۚ","l-qiyāmati","(of) the Resurrection","ক্বিয়ামাতের (বাঁচতে পারবে?)"],["وَقِيلَ","waqīla","And it will be said","এবং বলা হবে"],["لِلظَّـٰلِمِينَ","lilẓẓālimīna","to the wrongdoers","সীমালঙ্ঘনকারীদেরকে"],["ذُوقُوا۟","dhūqū","Taste","\"তোমরা স্বাদ নাও"],["مَا","mā","what","যা"],["كُنتُمْ","kuntum","you used to","তোমরা"],["تَكْسِبُونَ","taksibūna","earn","অর্জন করেছিলে\""]],"t":"أَفَ<d>مَن يَ</>تَّقِى بِوَ<q>جْ</>هِ<m>هِۦ</> <o>سُوٓ</>ءَ <h>ٱ</>لْعَذَابِ يَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ ۚ وَقِيلَ لِل<m>ظَّٰ</>لِمِينَ ذُوقُو<s>ا۟</> مَا كُ<k>نتُ</>مْ تَكْسِ<p>بُو</>نَ"},{"n":25,"w":[["كَذَّبَ","kadhaba","Denied","মিথ্যারোপ করেছিলো"],["ٱلَّذِينَ","alladhīna","those who","যারা (ছিলো)"],["مِن","min","(were) before them","পূর্বেও"],["قَبْلِهِمْ","qablihim","(were) before them","তাদের"],["فَأَتَىٰهُمُ","fa-atāhumu","so came upon them","তাদের উপর অতঃপর এসেছিলো"],["ٱلْعَذَابُ","l-‘adhābu","the punishment","শাস্তি"],["مِنْ","min","from","(এমনদিক) হ'তে"],["حَيْثُ","ḥaythu","where","যেদিকে"],["لَا","lā","not","না"],["يَشْعُرُونَ","yash‘urūna","they perceive","তারা কল্পনাও করে"]],"t":"كَذَّبَ <h>ٱ</>لَّذِينَ مِ<k>ن قَ</><q>بْ</>لِهِمْ فَأَتَ<m>ىٰ</>هُمُ <h>ٱ</>لْعَذَابُ مِنْ حَيْثُ لَا يَشْعُ<p>رُو</>نَ"},{"n":26,"w":[["فَأَذَاقَهُمُ","fa-adhāqahumu","So Allah made them","তাদেরকে ফলে আস্বাদন করালেন"],["ٱللَّهُ","l-lahu","So Allah made them","আল্লাহ"],["ٱلْخِزْىَ","l-khiz'ya","the disgrace","অপমানের"],["فِى","fī","in","মধ্যে"],["ٱلْحَيَوٰةِ","l-ḥayati","the life","জীবনের"],["ٱلدُّنْيَا ۖ","l-dun'yā","(of) the world","পার্থিব"],["وَلَعَذَابُ","wala‘adhābu","and certainly (the) punishment","আর শাস্তি অবশ্যই"],["ٱلْـَٔاخِرَةِ","l-ākhirati","(of) the Hereafter","আখিরাতের"],["أَكْبَرُ ۚ","akbaru","(is) greater","কঠিন"],["لَوْ","law","if","(হায়) যদি"],["كَانُوا۟","kānū","they","তারা"],["يَعْلَمُونَ","ya‘lamūna","knew","জানতো"]],"t":"فَأَذَاقَهُمُ <h>ٱ</>للَّهُ <h>ٱ</>لْخِزْىَ فِى <h>ٱ</>لْحَيَ<s>وٰ</>ةِ <h>ٱ</><l>ل</>دُّنْيَا ۖ وَلَعَذَابُ <h>ٱ</>لْءَاخِرَةِ أَكْبَرُ ۚ لَوْ كَانُو<s>ا۟</> يَعْلَ<p>مُو</>نَ"},{"n":27,"w":[["وَلَقَدْ","walaqad","And indeed","এবং নিশ্চয়ই"],["ضَرَبْنَا","ḍarabnā","We have set forth","আমরা পেশ করেছি"],["لِلنَّاسِ","lilnnāsi","for people","লোকদের জন্যে"],["فِى","fī","in","মধ্যে"],["هَـٰذَا","hādhā","this","এই"],["ٱلْقُرْءَانِ","l-qur'āni","Quran","কোরআনের"],["مِن","min","of","থেকে"],["كُلِّ","kulli","every","প্রত্যেক রকম"],["مَثَلٍۢ","mathalin","example","দৃষ্টান্ত"],["لَّعَلَّهُمْ","la‘allahum","so that they may","তারা যাতে"],["يَتَذَكَّرُونَ","yatadhakkarūna","take heed","উপদেশ গ্রহণ করে"]],"t":"وَلَقَ<q>دْ</> ضَرَ<q>بْ</>نَا لِل<g>نَّ</>اسِ فِى <m>هَٰ</>ذَا <h>ٱ</>لْقُرْءَانِ مِ<k>ن كُ</>لِّ مَثَ<w>لٍۢ لَّ</>عَلَّهُمْ يَتَذَكَّ<p>رُو</>نَ"},{"n":28,"w":[["قُرْءَانًا","qur'ānan","A Quran","(এই) কোরআন"],["عَرَبِيًّا","‘arabiyyan","(in) Arabic","আরবী (ভাষায়)"],["غَيْرَ","ghayra","without","(তা) মুক্ত"],["ذِى","dhī","any","আছে"],["عِوَجٍۢ","‘iwajin","crookedness","বক্রতা বিশিষ্ট"],["لَّعَلَّهُمْ","la‘allahum","so that they may","তারা যাতে"],["يَتَّقُونَ","yattaqūna","(become) righteous","সতর্ক হয়"]],"t":"قُرْءَانًا عَرَبِيًّا غَيْرَ ذِى عِوَ<w>جٍۢ لَّ</>عَلَّهُمْ يَتَّ<p>قُو</>نَ"},{"n":29,"w":[["ضَرَبَ","ḍaraba","Allah sets forth","পেশ করেন"],["ٱللَّهُ","l-lahu","Allah sets forth","আল্লাহ"],["مَثَلًۭا","mathalan","an example ","একটি দৃষ্টান্ত"],["رَّجُلًۭا","rajulan","a man","এক ব্যক্তির"],["فِيهِ","fīhi","about him","তার আছে"],["شُرَكَآءُ","shurakāu","partners","অনেক অংশীদার (মনিব)"],["مُتَشَـٰكِسُونَ","mutashākisūna","quarreling","পরস্পরকে দেখতে পারে না"],["وَرَجُلًۭا","warajulan","and a man","এবং এক ব্যক্তি"],["سَلَمًۭا","salaman","(belonging) exclusively","সম্পূর্ণরূপে"],["لِّرَجُلٍ","lirajulin","to one man ","এক(জনের) (মালিকানায়)"],["هَلْ","hal","are","কি"],["يَسْتَوِيَانِ","yastawiyāni","they both equal","দু'জনের (অবস্থা) সমান"],["مَثَلًا ۚ","mathalan","(in) comparison","দৃষ্টান্তে"],["ٱلْحَمْدُ","l-ḥamdu","All praise","সব প্রশংসাই"],["لِلَّهِ ۚ","lillahi","(be) to Allah","আল্লাহর জন্যে"],["بَلْ","bal","Nay","কিন্তু"],["أَكْثَرُهُمْ","aktharuhum","most of them","অধিকাংশই তাদের"],["لَا","lā","(do) not","না"],["يَعْلَمُونَ","ya‘lamūna","know","জানে"]],"t":"ضَرَبَ <h>ٱ</>للَّهُ مَثَلًۭ<w>ا رَّ</>جُلًۭ<k>ا فِ</>يهِ شُرَ<o>كَآ</>ءُ مُتَ<m>شَٰ</>كِسُونَ وَرَجُلًۭ<k>ا سَ</>لَ<w>مًۭا لِّ</>رَجُلٍ هَلْ يَسْتَوِيَانِ مَثَلًا ۚ <h>ٱ</>لْحَمْدُ لِلَّهِ ۚ بَلْ أَكْثَرُهُمْ لَا يَعْلَ<p>مُو</>نَ"},{"n":30,"w":[["إِنَّكَ","innaka","Indeed, you","তুমি নিশ্চয়ই"],["مَيِّتٌۭ","mayyitun","will die","মৃত্যুবরণ করবে"],["وَإِنَّهُم","wa-innahum","and indeed, they","এবং তারা নিশ্চয়ই"],["مَّيِّتُونَ","mayyitūna","(will also) die","মৃত্যুবরণ করবে"]],"t":"إِ<g>نَّ</>كَ مَيِّ<d>تٌۭ وَ</>إِ<g>نَّ</><y>هُم مَّ</>يِّ<p>تُو</>نَ"},{"n":31,"w":[["ثُمَّ","thumma","Then","এরপর"],["إِنَّكُمْ","innakum","indeed you","তোমরা নিশ্চয়ই"],["يَوْمَ","yawma","(on the) Day","দিনে"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) the Resurrection","ক্বিয়ামাতের"],["عِندَ","‘inda","before","কাছে"],["رَبِّكُمْ","rabbikum","your Lord","তোমাদের রবের"],["تَخْتَصِمُونَ","takhtaṣimūna","will dispute","তর্কাতর্কি করবে"]],"t":"ثُ<g>مَّ</> إِ<g>نَّ</>كُمْ يَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ عِ<k>ندَ</> رَبِّكُمْ تَخْتَصِ<p>مُو</>نَ"},{"n":32,"w":[["۞ فَمَنْ","faman","Then who","অতঃপর কে"],["أَظْلَمُ","aẓlamu","(is) more unjust","বড় সীমালঙ্ঘনকারী (হতে পারে)"],["مِمَّن","mimman","than (one) who","(তার) চেয়ে যে"],["كَذَبَ","kadhaba","lies","মিথ্যা বলে"],["عَلَى","‘alā","against","সম্পর্কে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["وَكَذَّبَ","wakadhaba","and denies","ও প্রত্যাখ্যান করে"],["بِٱلصِّدْقِ","bil-ṣid'qi","the truth","পরম সত্যকে"],["إِذْ","idh","when","যখন"],["جَآءَهُۥٓ ۚ","jāahu","it comes to him","তার কাছে এসেছে"],["أَلَيْسَ","alaysa","Is (there) not","নয় কি"],["فِى","fī","in","মধ্যে"],["جَهَنَّمَ","jahannama","Hell","জাহান্নামের"],["مَثْوًۭى","mathwan","an abode","আবাসস্থল"],["لِّلْكَـٰفِرِينَ","lil'kāfirīna","for the disbelievers","(এমন সব) কাফেরদের জন্যে"]],"t":"۞ فَمَنْ أَظْلَمُ مِ<g>مَّ</><k>ن كَ</>ذَبَ عَلَى <h>ٱ</>للَّهِ وَكَذَّبَ بِ<h>ٱ</><l>ل</>صِّ<q>دْ</>قِ إِذْ <o>جَآ</>ءَهُ<o>ۥٓ ۚ</> أَلَيْسَ فِى جَهَ<g>نَّ</>مَ مَثْ<w>وًۭى لِّ</>لْ<m>كَٰ</>فِ<p>رِي</>نَ"},{"n":33,"w":[["وَٱلَّذِى","wa-alladhī","And the one who","এবং যে"],["جَآءَ","jāa","brought","এসেছে"],["بِٱلصِّدْقِ","bil-ṣid'qi","the truth","পরম সত্যসহ"],["وَصَدَّقَ","waṣaddaqa","and believed","এবং (যারা) সত্য বলে মেনে নিয়েছে"],["بِهِۦٓ ۙ","bihi","in it","তাঁকে"],["أُو۟لَـٰٓئِكَ","ulāika","those","ঐসব লোক"],["هُمُ","humu","[they]","তারাই"],["ٱلْمُتَّقُونَ","l-mutaqūna","(are) the righteous","মুত্তাকী"]],"t":"وَ<h>ٱ</>لَّذِى <o>جَآ</>ءَ بِ<h>ٱ</><l>ل</>صِّ<q>دْ</>قِ وَصَدَّقَ بِ<o>هِۦٓ ۙ</> أُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</>لْمُتَّ<p>قُو</>نَ"},{"n":34,"w":[["لَهُم","lahum","For them","তাদের জন্যে"],["مَّا","mā","(is) what","(থাকবে) যা"],["يَشَآءُونَ","yashāūna","they wish","তারা ইচ্ছে করবে"],["عِندَ","‘inda","with","কাছে"],["رَبِّهِمْ ۚ","rabbihim","their Lord","তাদের রবের"],["ذَٰلِكَ","dhālika","That","এটা"],["جَزَآءُ","jazāu","(is the) reward","পুরস্কার"],["ٱلْمُحْسِنِينَ","l-muḥ'sinīna","(of) the good-doers","সৎকর্মপরায়ণদের"]],"t":"لَ<y>هُم مَّ</>ا يَ<o>شَآ</>ءُونَ عِ<k>ندَ</> رَبِّهِمْ ۚ <m>ذَٰ</>لِكَ جَ<o>زَآ</>ءُ <h>ٱ</>لْمُحْسِ<p>نِي</>نَ"},{"n":35,"w":[["لِيُكَفِّرَ","liyukaffira","That Allah will remove","মোচন করেন যেন"],["ٱللَّهُ","l-lahu","That Allah will remove","আল্লাহ"],["عَنْهُمْ","‘anhum","from them","তাদের থেকে"],["أَسْوَأَ","aswa-a","(the) worst","মন্দকাজ"],["ٱلَّذِى","alladhī","(of) what","যা"],["عَمِلُوا۟","‘amilū","they did","তারা কাজ করেছিলো"],["وَيَجْزِيَهُمْ","wayajziyahum","and reward them","এবং তাদের প্রতিফল দেন (যেন)"],["أَجْرَهُم","ajrahum","their due","পুরস্কার তাদের"],["بِأَحْسَنِ","bi-aḥsani","for (the) best","উত্তমভাবে"],["ٱلَّذِى","alladhī","(of) what","(ঐ বিষয়ের) যা"],["كَانُوا۟","kānū","they used to","তারা"],["يَعْمَلُونَ","ya‘malūna","do","কাজ করেছিলো"]],"t":"لِيُكَفِّرَ <h>ٱ</>للَّهُ عَنْهُمْ أَسْوَأَ <h>ٱ</>لَّذِى عَمِلُو<s>ا۟</> وَيَ<q>جْ</>زِيَهُمْ أَ<q>جْ</>رَ<f>هُم بِ</>أَحْسَنِ <h>ٱ</>لَّذِى كَانُو<s>ا۟</> يَعْمَ<p>لُو</>نَ"},{"n":36,"w":[["أَلَيْسَ","alaysa","Is not","কি নন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["بِكَافٍ","bikāfin","sufficient","যথেষ্ট"],["عَبْدَهُۥ ۖ","‘abdahu","(for) His slave","তাঁর দাসের (জন্যে)"],["وَيُخَوِّفُونَكَ","wayukhawwifūnaka","And they threaten you","এবং তোমাকে  তারা ভয় দেখায়"],["بِٱلَّذِينَ","bi-alladhīna","with those","অন্যদের সম্পর্কে"],["مِن","min","besides Him","মধ্য হতে"],["دُونِهِۦ ۚ","dūnihi","besides Him","তিনি ছাড়া"],["وَمَن","waman","And whoever","অথচ যাকে"],["يُضْلِلِ","yuḍ'lili","Allah lets go astray ","পথভ্রষ্ট করেন"],["ٱللَّهُ","l-lahu","Allah lets go astray ","আল্লাহ"],["فَمَا","famā","then not","অতঃপর নেই"],["لَهُۥ","lahu","for him","তার জন্যে"],["مِنْ","min","any","কোনো"],["هَادٍۢ","hādin","guide","পথ প্রদর্শক"]],"t":"أَلَيْسَ <h>ٱ</>للَّهُ بِكَافٍ عَ<q>بْ</>دَهُ<m>ۥ</> ۖ وَيُخَوِّفُونَكَ بِ<h>ٱ</>لَّذِينَ مِ<k>ن دُ</>ونِ<m>هِۦ</> ۚ وَ<d>مَن يُ</>ضْلِلِ <h>ٱ</>للَّهُ فَمَا لَهُ<m>ۥ</> مِنْ <p>هَا</><q>دٍۢ</>"},{"n":37,"w":[["وَمَن","waman","And whoever","এবং যাকে"],["يَهْدِ","yahdi","Allah guides","পথ দেখান"],["ٱللَّهُ","l-lahu","Allah guides","আল্লাহ"],["فَمَا","famā","then not","তখন নেই"],["لَهُۥ","lahu","for him","তার জন্যে"],["مِن","min","any","কোনো"],["مُّضِلٍّ ۗ","muḍillin","misleader","বিভ্রান্তকারী"],["أَلَيْسَ","alaysa","Is not","নন কি"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["بِعَزِيزٍۢ","bi‘azīzin","All-Mighty","মহাপরাক্রমশালী"],["ذِى","dhī","All-Able of retribution","আছে"],["ٱنتِقَامٍۢ","intiqāmin","All-Able of retribution","প্রতিশোধ গ্রহণকারী"]],"t":"وَ<d>مَن يَ</>هْدِ <h>ٱ</>للَّهُ فَمَا لَهُ<m>ۥ</> <d>مِن مُّ</>ضِلٍّ ۗ أَلَيْسَ <h>ٱ</>للَّهُ بِعَزِي<k>زٍۢ ذِ</>ى <h>ٱ</><k>نتِ</><p>قَا</>مٍۢ"},{"n":38,"w":[["وَلَئِن","wala-in","And if","এবং অবশ্যই যদি"],["سَأَلْتَهُم","sa-altahum","you ask them","তাদের তুমি প্রশ্ন করো"],["مَّنْ","man","who","কে"],["خَلَقَ","khalaqa","created","সৃষ্টি করেছে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশকে"],["وَٱلْأَرْضَ","wal-arḍa","and the earth","ও পৃথিবীকে"],["لَيَقُولُنَّ","layaqūlunna","Surely, they will say","অবশ্যই  তারা বলবে"],["ٱللَّهُ ۚ","l-lahu","Allah","\"আল্লাহ\""],["قُلْ","qul","Say","বলো"],["أَفَرَءَيْتُم","afara-aytum","Then do you see","\"তবে তোমরা (ভেবে) দেখেছো কি"],["مَّا","mā","what","যাদেরকে"],["تَدْعُونَ","tad‘ūna","you invoke","তোমরা ডাকো"],["مِن","min","besides","মধ্য হতে"],["دُونِ","dūni","besides","ছাড়া"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["إِنْ","in","if","যদি"],["أَرَادَنِىَ","arādaniya","Allah intended for me","আমাকে চান"],["ٱللَّهُ","l-lahu","Allah intended for me","আল্লাহ"],["بِضُرٍّ","biḍurrin","harm","কোনো অনিষ্ট (করতে)"],["هَلْ","hal","are","কি"],["هُنَّ","hunna","they","তারা"],["كَـٰشِفَـٰتُ","kāshifātu","removers","রক্ষাকারী (হতে পারবে)"],["ضُرِّهِۦٓ","ḍurrihi","(of) harm (from) Him","তার অনিষ্ট (হ'তে)"],["أَوْ","aw","or","অথবা"],["أَرَادَنِى","arādanī","if He intended for me","তিনি আমাকে চান"],["بِرَحْمَةٍ","biraḥmatin","mercy","অনুগ্রহ (করতে)"],["هَلْ","hal","are","কি"],["هُنَّ","hunna","they","তারা"],["مُمْسِكَـٰتُ","mum'sikātu","withholders","বাধাদানকারী (হতে পারবে)"],["رَحْمَتِهِۦ ۚ","raḥmatihi","(of) His mercy","তার অনুগ্রহকে\""],["قُلْ","qul","Say","বলো"],["حَسْبِىَ","ḥasbiya","Sufficient (is) Allah for me","\"আমার জন্যে যথেষ্ট"],["ٱللَّهُ ۖ","l-lahu","Sufficient (is) Allah for me","\"আল্লাহ"],["عَلَيْهِ","‘alayhi","upon Him","তাঁরই উপর"],["يَتَوَكَّلُ","yatawakkalu","put trust","নির্ভর করে থাকে"],["ٱلْمُتَوَكِّلُونَ","l-mutawakilūna","those who trust","নির্ভরকারীরা\""]],"t":"وَلَئِ<k>ن سَ</>أَلْتَ<y>هُم مَّ</>نْ خَلَقَ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضَ لَيَقُولُ<g>نَّ</> <h>ٱ</>للَّهُ ۚ قُلْ أَفَرَءَيْ<y>تُم مَّ</>ا تَ<q>دْ</>عُونَ مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ إِنْ أَرَادَنِىَ <h>ٱ</>للَّهُ بِضُرٍّ هَلْ هُ<g>نَّ</> <m>كَٰشِفَٰ</>تُ ضُرِّ<o>هِۦٓ</> أَوْ أَرَادَنِى بِرَحْمَةٍ هَلْ هُ<g>نَّ</> مُمْسِ<m>كَٰ</>تُ رَحْمَتِ<m>هِۦ</> ۚ قُلْ حَسْبِىَ <h>ٱ</>للَّهُ ۖ عَلَيْهِ يَتَوَكَّلُ <h>ٱ</>لْمُتَوَكِّ<p>لُو</>نَ"},{"n":39,"w":[["قُلْ","qul","Say","বলো"],["يَـٰقَوْمِ","yāqawmi","O my people","\"হে আমার জাতি"],["ٱعْمَلُوا۟","i‘'malū","Work","তোমরা কাজ করো"],["عَلَىٰ","‘alā","(according) to","উপর"],["مَكَانَتِكُمْ","makānatikum","your position","তোমাদের অবস্থার"],["إِنِّى","innī","indeed, I am","নিশ্চয়ই আমি"],["عَـٰمِلٌۭ ۖ","‘āmilun","working","কাজ করে যাচ্ছি"],["فَسَوْفَ","fasawfa","then soon","শীঘ্রই অতঃপর"],["تَعْلَمُونَ","ta‘lamūna","you will know","তোমরা জানবে"]],"t":"قُلْ <m>يَٰ</>قَوْمِ <h>ٱ</>عْمَلُو<s>ا۟</> عَلَىٰ مَكَانَتِكُمْ إِ<g>نِّ</>ى <m>عَٰ</>مِ<k>لٌۭ ۖ فَ</>سَوْفَ تَعْلَ<p>مُو</>نَ"},{"n":40,"w":[["مَن","man","(Upon) whom","কার উপর"],["يَأْتِيهِ","yatīhi","will come","আসবে"],["عَذَابٌۭ","‘adhābun","a punishment","শাস্তি"],["يُخْزِيهِ","yukh'zīhi","disgracing him","তাকে লাঞ্ছিত করবে"],["وَيَحِلُّ","wayaḥillu","and descends","ও আপতিত হবে"],["عَلَيْهِ","‘alayhi","on him","তার উপর"],["عَذَابٌۭ","‘adhābun","a punishment","শাস্তি"],["مُّقِيمٌ","muqīmun","everlasting","স্থায়ী\""]],"t":"<d>مَن يَ</>أْتِيهِ عَذَا<d>بٌۭ يُ</>خْزِيهِ وَيَحِلُّ عَلَيْهِ عَذَا<d>بٌۭ مُّ</><p>قِي</>مٌ"},{"n":41,"w":[["إِنَّآ","innā","Indeed We","নিশ্চয়ই আমরা"],["أَنزَلْنَا","anzalnā","We revealed","আমরা অবতীর্ণ করেছি"],["عَلَيْكَ","‘alayka","to you","তোমার উপর"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","(এই) কিতাব"],["لِلنَّاسِ","lilnnāsi","for [the] mankind","মানুষের জন্যে"],["بِٱلْحَقِّ ۖ","bil-ḥaqi","in truth","সত্যসহ"],["فَمَنِ","famani","So whoever","অতঃপর যে"],["ٱهْتَدَىٰ","ih'tadā","accepts guidance","সৎপথ গ্রহন করে"],["فَلِنَفْسِهِۦ ۖ","falinafsihi","then (it is) for his soul","তা তার নিজের জন্যে"],["وَمَن","waman","and whoever","এবং যে"],["ضَلَّ","ḍalla","goes astray","পথভ্রষ্ট হয়"],["فَإِنَّمَا","fa-innamā","then only","মূলতঃ তখন"],["يَضِلُّ","yaḍillu","he strays","সে বিপথে চলে"],["عَلَيْهَا ۖ","‘alayhā","against his (soul)","তার নিজের বিরুদ্ধে"],["وَمَآ","wamā","And not","এবং নও"],["أَنتَ","anta","you","তুমি"],["عَلَيْهِم","‘alayhim","(are) over them","তাদের উপর"],["بِوَكِيلٍ","biwakīlin","a manager","তত্ত্বাবধায়ক"]],"t":"إِ<g>نَّ</><o>آ</> أَ<k>نزَ</>لْنَا عَلَيْكَ <h>ٱ</>لْكِ<m>تَٰ</>بَ لِل<g>نَّ</>اسِ بِ<h>ٱ</>لْحَقِّ ۖ فَمَنِ <h>ٱ</>هْتَدَىٰ فَلِنَفْسِ<m>هِۦ</> ۖ وَمَ<k>ن ضَ</>لَّ فَإِ<g>نَّ</>مَا يَضِلُّ عَلَيْهَا ۖ وَ<o>مَآ</> أَ<k>نتَ</> عَلَيْ<f>هِم بِ</>وَ<p>كِي</>لٍ"},{"n":42,"w":[["ٱللَّهُ","al-lahu","Allah","আল্লাই"],["يَتَوَفَّى","yatawaffā","takes","হরণ করেন"],["ٱلْأَنفُسَ","l-anfusa","the souls","প্রাণসমূহকে (রূহগুলোকে)"],["حِينَ","ḥīna","(at the) time","সময়"],["مَوْتِهَا","mawtihā","(of) their death","তার মৃত্যুর"],["وَٱلَّتِى","wa-allatī","and the one who","এবং তারও (যে)"],["لَمْ","lam","(does) not","নাই"],["تَمُتْ","tamut","die","মরে (কিন্তু)"],["فِى","fī","in","মধ্যে (থাকে)"],["مَنَامِهَا ۖ","manāmihā","their sleep","তার ঘুমের"],["فَيُمْسِكُ","fayum'siku","Then He keeps","অতঃপর প্রাণকে ধরে রাখেন"],["ٱلَّتِى","allatī","the one whom","যার"],["قَضَىٰ","qaḍā","He has decreed","অবধারিত হয়েছে"],["عَلَيْهَا","‘alayhā","for them","তাদের উপর"],["ٱلْمَوْتَ","l-mawta","the death","মৃত্যু"],["وَيُرْسِلُ","wayur'silu","and sends","এবং ফিরিয়ে দেন"],["ٱلْأُخْرَىٰٓ","l-ukh'rā","the others","অন্যদের (রূহগুলোকে)"],["إِلَىٰٓ","ilā","for","পর্যন্ত"],["أَجَلٍۢ","ajalin","a term","একটি মেয়াদ"],["مُّسَمًّى ۚ","musamman","specified","নির্দিষ্ট"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে আছে"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَـٰتٍۢ","laāyātin","surely (are) signs","অবশ্যই নিদর্শনাবলী"],["لِّقَوْمٍۢ","liqawmin","for a people","লোকদের জন্যে"],["يَتَفَكَّرُونَ","yatafakkarūna","who ponder","(যারা) চিন্তা ভাবনা করে"]],"t":"ٱللَّهُ يَتَوَفَّى <h>ٱ</>لْأَ<k>نفُ</>سَ حِينَ مَوْتِهَا وَ<h>ٱ</>لَّتِى لَمْ تَمُتْ فِى مَنَامِهَا ۖ فَيُمْسِكُ <h>ٱ</>لَّتِى قَضَىٰ عَلَيْهَا <h>ٱ</>لْمَوْتَ وَيُرْسِلُ <h>ٱ</>لْأُخْرَ<o>ىٰٓ</> إِلَ<o>ىٰٓ</> أَجَ<d>لٍۢ مُّ</>سَ<g>مًّ</>ى ۚ إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَا<m>يَٰ</><w>تٍۢ لِّ</>قَوْ<d>مٍۢ يَ</>تَفَكَّ<p>رُو</>نَ"},{"n":43,"w":[["أَمِ","ami","Or","কি"],["ٱتَّخَذُوا۟","ittakhadhū","have they taken","তারা গ্রহণ করেছে"],["مِن","min","besides","মধ্য হতে"],["دُونِ","dūni","besides","ছাড়া"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["شُفَعَآءَ ۚ","shufa‘āa","intercessors","(অন্যান্যদেরকে) সুপারিশকারী রূপে"],["قُلْ","qul","Say","বলো"],["أَوَلَوْ","awalaw","Even though","\"যদিও তবুওকি"],["كَانُوا۟","kānū","they were","তারা হলো (এমন যে)"],["لَا","lā","not","না"],["يَمْلِكُونَ","yamlikūna","possessing","ক্ষমতা রাখে"],["شَيْـًۭٔا","shayan","anything","কোনো কিছুরই"],["وَلَا","walā","and not","এবং না"],["يَعْقِلُونَ","ya‘qilūna","they understand","তারা বুঝেও\""]],"t":"أَمِ <h>ٱ</>تَّخَذُو<s>ا۟</> مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ شُفَ<o>عَآ</>ءَ ۚ قُلْ أَوَلَوْ كَانُو<s>ا۟</> لَا يَمْلِكُونَ شَ<d>يْـًۭٔا وَ</>لَا يَعْقِ<p>لُو</>نَ"},{"n":44,"w":[["قُل","qul","Say","বলো"],["لِّلَّهِ","lillahi","To Allah (belongs)","\"আল্লাহরই (এখতিয়ারভুক্ত)"],["ٱلشَّفَـٰعَةُ","l-shafā‘atu","the intercession","সুপারিশ"],["جَمِيعًۭا ۖ","jamī‘an","all","সকল"],["لَّهُۥ","lahu","For Him","তাঁরই"],["مُلْكُ","mul'ku","(is the) dominion","সার্বভৌমত্ব"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশের"],["وَٱلْأَرْضِ ۖ","wal-arḍi","and the earth","ও পৃথিবীর"],["ثُمَّ","thumma","Then","এরপর"],["إِلَيْهِ","ilayhi","to Him","তাঁরই দিকে"],["تُرْجَعُونَ","tur'ja‘ūna","you will be returned","তোমাদেরকে ফিরিয়ে আনা হবে\""]],"t":"قُل لِّلَّهِ <h>ٱ</><l>ل</>شَّ<m>فَٰ</>عَةُ جَمِي<w>عًۭا ۖ لَّ</>هُ<m>ۥ</> مُلْكُ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ ۖ ثُ<g>مَّ</> إِلَيْهِ تُرْجَ<p>عُو</>نَ"},{"n":45,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["ذُكِرَ","dhukira","Allah is mentioned","উল্লেখ করা হয়"],["ٱللَّهُ","l-lahu","Allah is mentioned","আল্লাহর"],["وَحْدَهُ","waḥdahu","Alone","তাঁর একারই"],["ٱشْمَأَزَّتْ","ish'ma-azzat","shrink with aversion","সংকুচিত হয় বিতৃষ্ণায়"],["قُلُوبُ","qulūbu","(the) hearts","অন্তরসমূহ"],["ٱلَّذِينَ","alladhīna","(of) those who","(তাদের) যারা"],["لَا","lā","(do) not","না"],["يُؤْمِنُونَ","yu'minūna","believe","বিশ্বাস করে"],["بِٱلْـَٔاخِرَةِ ۖ","bil-ākhirati","in the Hereafter","পরকালের উপর"],["وَإِذَا","wa-idhā","and when","এবং যখন"],["ذُكِرَ","dhukira","are mentioned","উল্লেখ করা হয়"],["ٱلَّذِينَ","alladhīna","those","(অন্যদেরকে) যারা (আছে)"],["مِن","min","besides Him","ছাড়া"],["دُونِهِۦٓ","dūnihi","besides Him","তিনি"],["إِذَا","idhā","behold","তখন"],["هُمْ","hum","They","তারা"],["يَسْتَبْشِرُونَ","yastabshirūna","rejoice","আনন্দে উল্লসিত হয়"]],"t":"وَإِذَا ذُكِرَ <h>ٱ</>للَّهُ وَحْدَهُ <h>ٱ</>شْمَأَزَّتْ قُلُوبُ <h>ٱ</>لَّذِينَ لَا يُؤْمِنُونَ بِ<h>ٱ</>لْءَاخِرَةِ ۖ وَإِذَا ذُكِرَ <h>ٱ</>لَّذِينَ مِ<k>ن دُ</>ونِ<o>هِۦٓ</> إِذَا هُمْ يَسْتَ<q>بْ</>شِ<p>رُو</>نَ"},{"n":46,"w":[["قُلِ","quli","Say","বলো"],["ٱللَّهُمَّ","l-lahuma","O Allah","\"হে আল্লাহ"],["فَاطِرَ","fāṭira","Creator","স্রষ্টা"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশের"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীর"],["عَـٰلِمَ","‘ālima","Knower","খুব অবহিত"],["ٱلْغَيْبِ","l-ghaybi","(of) the unseen","অদৃশ্যের"],["وَٱلشَّهَـٰدَةِ","wal-shahādati","and the witnessed","ও দৃশ্যের"],["أَنتَ","anta","You","তুমিই"],["تَحْكُمُ","taḥkumu","will judge","মীমাংসা করে দিও"],["بَيْنَ","bayna","between","মাঝে"],["عِبَادِكَ","‘ibādika","Your slaves","তোমার দাসদের"],["فِى","fī","in","মধ্যে"],["مَا","mā","what","(ঐ বিষয়ের) যা"],["كَانُوا۟","kānū","they used to","তারা ছিলো"],["فِيهِ","fīhi","therein","তার মধ্যে"],["يَخْتَلِفُونَ","yakhtalifūna","differ","মতভেদ করতো\""]],"t":"قُلِ <h>ٱ</><l>ل</>لَّهُ<g>مَّ</> فَاطِرَ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ <m>عَٰ</>لِمَ <h>ٱ</>لْغَيْبِ وَ<h>ٱ</><l>ل</>شَّ<m>هَٰ</>دَةِ أَ<k>نتَ</> تَحْكُمُ بَيْنَ عِبَادِكَ فِى مَا كَانُو<s>ا۟</> فِيهِ يَخْتَلِ<p>فُو</>نَ"},{"n":47,"w":[["وَلَوْ","walaw","And if","এবং (এমন) যে"],["أَنَّ","anna","And if","যে"],["لِلَّذِينَ","lilladhīna","those who","(তাদের) জন্যে যারা"],["ظَلَمُوا۟","ẓalamū","did wrong","সীমালঙ্ঘন করেছে"],["مَا","mā","(had) whatever","যা কিছু"],["فِى","fī","(is) in","মধ্যে আছে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["جَمِيعًۭا","jamī‘an","all","সবই (তাদের মালিকানায়)"],["وَمِثْلَهُۥ","wamith'lahu","and (the) like of it","এবং তারও সমপরিমাণ"],["مَعَهُۥ","ma‘ahu","with it","তার সাথে"],["لَٱفْتَدَوْا۟","la-if'tadaw","they would ransom","তারা অবশ্যই মুক্তিপণ দিতে চাইতো"],["بِهِۦ","bihi","with it","তা দিয়ে"],["مِن","min","from","হ'তে"],["سُوٓءِ","sūi","(the) evil","কঠিন"],["ٱلْعَذَابِ","l-‘adhābi","(of) the punishment","শাস্তি (বাঁচতে)"],["يَوْمَ","yawma","(on the) Day","দিনে"],["ٱلْقِيَـٰمَةِ ۚ","l-qiyāmati","(of) the Resurrection","ক্বিয়ামাতের"],["وَبَدَا","wabadā","And (will) appear","এবং প্রকাশিত হবে"],["لَهُم","lahum","to them","তাদের জন্যে"],["مِّنَ","mina","from","পক্ষ হ'তে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["مَا","mā","what","যা"],["لَمْ","lam","not","নি"],["يَكُونُوا۟","yakūnū","they had","তারা করেছিল"],["يَحْتَسِبُونَ","yaḥtasibūna","taken into account","তারা ধারনাও করে"]],"t":"وَلَوْ أَ<g>نَّ</> لِلَّذِينَ ظَلَمُو<s>ا۟</> مَا فِى <h>ٱ</>لْأَرْضِ جَمِي<d>عًۭا وَ</>مِثْلَهُ<m>ۥ</> مَعَهُ<m>ۥ</> لَ<h>ٱ</>فْتَدَوْ<s>ا۟</> بِ<m>هِۦ</> مِ<k>ن سُ</><o>وٓ</>ءِ <h>ٱ</>لْعَذَابِ يَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ ۚ وَبَدَا لَ<y>هُم مِّ</>نَ <h>ٱ</>للَّهِ مَا لَمْ يَكُونُو<s>ا۟</> يَحْتَسِ<p>بُو</>نَ"},{"n":48,"w":[["وَبَدَا","wabadā","And will become apparent","এবং প্রকাশ হয়ে যাবে"],["لَهُمْ","lahum","to them","তাদের জন্যে"],["سَيِّـَٔاتُ","sayyiātu","(the) evils","মন্দ (ফল) সমূহ"],["مَا","mā","(of) what","যা"],["كَسَبُوا۟","kasabū","they earned","তারা কামাই করতো"],["وَحَاقَ","waḥāqa","and will surround","এবং ঘিরে রাখবে"],["بِهِم","bihim","them","তাদেরকে"],["مَّا","mā","what","যা"],["كَانُوا۟","kānū","they used to","তারা ছিলো"],["بِهِۦ","bihi","[in it]","সে সম্পর্কে"],["يَسْتَهْزِءُونَ","yastahziūna","mock","ঠাট্রা বিদ্রুপ করতো"]],"t":"وَبَدَا لَهُمْ سَيِّـَٔاتُ مَا كَسَبُو<s>ا۟</> وَحَاقَ بِ<y>هِم مَّ</>ا كَانُو<s>ا۟</> بِ<m>هِۦ</> يَسْتَهْزِ<p>ءُو</>نَ"},{"n":49,"w":[["فَإِذَا","fa-idhā","So when","অতঃপর যখন"],["مَسَّ","massa","touches","স্পর্শ করে"],["ٱلْإِنسَـٰنَ","l-insāna","[the] man","মানুষকে"],["ضُرٌّۭ","ḍurrun","adversity","কোনো দুঃখদৈন্য"],["دَعَانَا","da‘ānā","he calls upon Us","আমাদেরকে ডাকে"],["ثُمَّ","thumma","then","এরপর"],["إِذَا","idhā","when","যখন"],["خَوَّلْنَـٰهُ","khawwalnāhu","We bestow (on) him","তাকে আমরা দিয়েছি"],["نِعْمَةًۭ","ni‘'matan","a favor","অনুগ্রহ"],["مِّنَّا","minnā","from Us","আমাদের পক্ষ হ'তে"],["قَالَ","qāla","he says","সে বলে"],["إِنَّمَآ","innamā","Only","\"মূলতঃ"],["أُوتِيتُهُۥ","ūtītuhu","I have been given it","তা দেওয়া হয়েছিলো আমাকে"],["عَلَىٰ","‘alā","for","কারণে"],["عِلْمٍۭ ۚ","‘il'min","knowledge","জ্ঞানের\""],["بَلْ","bal","Nay","বরং"],["هِىَ","hiya","it","এটা"],["فِتْنَةٌۭ","fit'natun","(is) a trial","একটি পরীক্ষা"],["وَلَـٰكِنَّ","walākinna","but","কিন্তু"],["أَكْثَرَهُمْ","aktharahum","most of them","তারা অধিকাংশই"],["لَا","lā","(do) not","না"],["يَعْلَمُونَ","ya‘lamūna","know","জানে"]],"t":"فَإِذَا مَسَّ <h>ٱ</>لْإِ<k>نسَٰ</>نَ ضُ<k>رٌّۭ دَ</>عَانَا ثُ<g>مَّ</> إِذَا خَوَّلْ<m>نَٰ</>هُ نِعْمَ<d>ةًۭ مِّ</><g>نَّ</>ا قَالَ إِ<g>نَّ</><o>مَآ</> أُوتِيتُهُ<m>ۥ</> عَلَىٰ عِلْ<i>مٍۭ ۚ بَ</>لْ هِىَ فِتْنَ<d>ةٌۭ وَ</><m>لَٰ</>كِ<g>نَّ</> أَكْثَرَهُمْ لَا يَعْلَ<p>مُو</>نَ"},{"n":50,"w":[["قَدْ","qad","Indeed","নিশ্চয়ই"],["قَالَهَا","qālahā","said it","তা বলেছিলো"],["ٱلَّذِينَ","alladhīna","those","(তারাও) যারা"],["مِن","min","before them","পূর্বে (ছিলো)"],["قَبْلِهِمْ","qablihim","before them","তাদের"],["فَمَآ","famā","but (did) not","কিন্তু না"],["أَغْنَىٰ","aghnā","avail","কাছে এসেছে"],["عَنْهُم","‘anhum","them","তাদের জন্যে"],["مَّا","mā","what","যা"],["كَانُوا۟","kānū","they used to","তারা"],["يَكْسِبُونَ","yaksibūna","earn","অর্জন করতেছিলো"]],"t":"قَ<q>دْ</> قَالَهَا <h>ٱ</>لَّذِينَ مِ<k>ن قَ</><q>بْ</>لِهِمْ فَ<o>مَآ</> أَغْنَىٰ عَنْ<y>هُم مَّ</>ا كَانُو<s>ا۟</> يَكْسِ<p>بُو</>نَ"},{"n":51,"w":[["فَأَصَابَهُمْ","fa-aṣābahum","Then struck them","তাদের উপর  এরপর আপতিত হয়েছে"],["سَيِّـَٔاتُ","sayyiātu","(the) evils","মন্দ ফলসমূহ"],["مَا","mā","(of) what","যা"],["كَسَبُوا۟ ۚ","kasabū","they earned","তারা কামাই করেছিলো"],["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["ظَلَمُوا۟","ẓalamū","have wronged","সীমালঙ্ঘন করেছে"],["مِنْ","min","of","মধ্য হ'তে"],["هَـٰٓؤُلَآءِ","hāulāi","these","এদের"],["سَيُصِيبُهُمْ","sayuṣībuhum","will strike them","তাদের উপর এসে পড়বে শীঘ্রই"],["سَيِّـَٔاتُ","sayyiātu","(the) evils","মন্দ ফলসমূহ"],["مَا","mā","(of) what","যা"],["كَسَبُوا۟","kasabū","they earned","তারা কামাই করেছে"],["وَمَا","wamā","and not","এবং না"],["هُم","hum","they","তারা"],["بِمُعْجِزِينَ","bimu‘'jizīna","will be able to escape","(আমাকে) অক্ষম করতে পারবে"]],"t":"فَأَصَابَهُمْ سَيِّـَٔاتُ مَا كَسَبُو<s>ا۟ ۚ</> وَ<h>ٱ</>لَّذِينَ ظَلَمُو<s>ا۟</> مِنْ <o>هَٰٓؤُلَآ</>ءِ سَيُصِيبُهُمْ سَيِّـَٔاتُ مَا كَسَبُو<s>ا۟</> وَمَا <f>هُم بِ</>مُعْجِ<p>زِي</>نَ"},{"n":52,"w":[["أَوَلَمْ","awalam","Do not","কি না"],["يَعْلَمُوٓا۟","ya‘lamū","they know","তারা জানে"],["أَنَّ","anna","that","যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يَبْسُطُ","yabsuṭu","extends","প্রশস্ত করে দেন"],["ٱلرِّزْقَ","l-riz'qa","the provision","জীবনের উপকরণ"],["لِمَن","liman","for whom","(তার) জন্যে যাকে"],["يَشَآءُ","yashāu","He wills","ইচ্ছে করেন"],["وَيَقْدِرُ ۚ","wayaqdiru","and restricts","এবং সংকীর্ণ করেন (যাকে চান)"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে (আছে)"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَـٰتٍۢ","laāyātin","surely (are) signs","অবশ্যই নিদর্শনাবলী"],["لِّقَوْمٍۢ","liqawmin","for a people","লোকদের জন্যে"],["يُؤْمِنُونَ","yu'minūna","who believe","(যারা) ঈমান আনে"]],"t":"أَوَلَمْ يَعْلَ<o>مُوٓ</><s>ا۟</> أَ<g>نَّ</> <h>ٱ</>للَّهَ يَ<q>بْ</>سُطُ <h>ٱ</><l>ل</>رِّزْقَ لِ<d>مَن يَ</><o>شَآ</>ءُ وَيَ<q>قْ</>دِرُ ۚ إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَا<m>يَٰ</><w>تٍۢ لِّ</>قَوْ<d>مٍۢ يُ</>ؤْمِ<p>نُو</>نَ"},{"n":53,"w":[["۞ قُلْ","qul","Say","বলো"],["يَـٰعِبَادِىَ","yā‘ibādiya","O My slaves","\"হে আমার দাসরা"],["ٱلَّذِينَ","alladhīna","Those who","যারা"],["أَسْرَفُوا۟","asrafū","have transgressed","বাড়াবাড়ি করেছো"],["عَلَىٰٓ","‘alā","against","উপর"],["أَنفُسِهِمْ","anfusihim","themselves","তাদের নিজেদের"],["لَا","lā","(do) not","না"],["تَقْنَطُوا۟","taqnaṭū","despair","তোমরা নিরাশ হয়ো"],["مِن","min","of","হ'তে"],["رَّحْمَةِ","raḥmati","(the) Mercy","অনুগ্রহ"],["ٱللَّهِ ۚ","l-lahi","(of) Allah","আল্লাহর"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يَغْفِرُ","yaghfiru","forgives","মাফ করেন"],["ٱلذُّنُوبَ","l-dhunūba","the sins","পাপসমূহকে"],["جَمِيعًا ۚ","jamī‘an","all","সমস্তই"],["إِنَّهُۥ","innahu","Indeed He","নিশ্চয়ই তিনি"],["هُوَ","huwa","He","তিনিই"],["ٱلْغَفُورُ","l-ghafūru","(is) the Oft-Forgiving","ক্ষমাশীল"],["ٱلرَّحِيمُ","l-raḥīmu","the Most Merciful","পরম দয়ালু"]],"t":"۞ قُلْ <m>يَٰ</>عِبَادِىَ <h>ٱ</>لَّذِينَ أَسْرَفُو<s>ا۟</> عَلَ<o>ىٰٓ</> أَ<k>نفُ</>سِهِمْ لَا تَ<q>قْ</>نَطُو<s>ا۟</> <w>مِن رَّ</>حْمَةِ <h>ٱ</>للَّهِ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ يَغْفِرُ <h>ٱ</><l>ل</>ذُّنُوبَ جَمِيعًا ۚ إِ<g>نَّ</>هُ<m>ۥ</> هُوَ <h>ٱ</>لْغَفُورُ <h>ٱ</><l>ل</>رَّ<p>حِي</>مُ"},{"n":54,"w":[["وَأَنِيبُوٓا۟","wa-anībū","And turn","এবং তোমরা অভিমুখী হও"],["إِلَىٰ","ilā","to","দিকে"],["رَبِّكُمْ","rabbikum","your Lord","তোমার রবের"],["وَأَسْلِمُوا۟","wa-aslimū","and submit","এবং তোমরা আত্মসমর্পণ করো"],["لَهُۥ","lahu","to Him","তাঁর কাছে"],["مِن","min","before","মধ্য হতে"],["قَبْلِ","qabli","before","(এর) পূর্বে"],["أَن","an","[that]","যে"],["يَأْتِيَكُمُ","yatiyakumu","comes to you","তোমাদের উপর আসবে"],["ٱلْعَذَابُ","l-‘adhābu","the punishment","শাস্তি"],["ثُمَّ","thumma","then","এরপর"],["لَا","lā","not","না"],["تُنصَرُونَ","tunṣarūna","you will be helped","তোমাদের সাহায্য করা হবে"]],"t":"وَأَنِي<o>بُوٓ</><s>ا۟</> إِلَىٰ رَبِّكُمْ وَأَسْلِمُو<s>ا۟</> لَهُ<m>ۥ</> مِ<k>ن قَ</><q>بْ</>لِ <d>أَن يَ</>أْتِيَكُمُ <h>ٱ</>لْعَذَابُ ثُ<g>مَّ</> لَا تُ<k>نصَ</><p>رُو</>نَ"},{"n":55,"w":[["وَٱتَّبِعُوٓا۟","wa-ittabi‘ū","And follow","এবং অনুসরণ করো"],["أَحْسَنَ","aḥsana","(the) best","উত্তম"],["مَآ","mā","(of) what","যা"],["أُنزِلَ","unzila","is revealed","অবতীর্ণ করা হয়েছে"],["إِلَيْكُم","ilaykum","to you","তোমাদের প্রতি"],["مِّن","min","from","পক্ষ হ'তে"],["رَّبِّكُم","rabbikum","your Lord","তোমাদের রবের"],["مِّن","min","before","থেকে"],["قَبْلِ","qabli","before","(এর) পূর্বে"],["أَن","an","[that]","যে"],["يَأْتِيَكُمُ","yatiyakumu","comes to you","তোমাদের উপর আসবে"],["ٱلْعَذَابُ","l-‘adhābu","the punishment","শাস্তি"],["بَغْتَةًۭ","baghtatan","suddenly","হঠাৎ"],["وَأَنتُمْ","wa-antum","while you","যখন তোমরা"],["لَا","lā","(do) not","না"],["تَشْعُرُونَ","tash‘urūna","perceive","টেরই পাবে"]],"t":"وَ<h>ٱ</>تَّبِ<o>عُوٓ</><s>ا۟</> أَحْسَنَ <o>مَآ</> أُ<k>نزِ</>لَ إِلَيْ<y>كُم مِّ</><w>ن رَّ</>بِّ<y>كُم مِّ</><k>ن قَ</><q>بْ</>لِ <d>أَن يَ</>أْتِيَكُمُ <h>ٱ</>لْعَذَابُ بَغْتَ<d>ةًۭ وَ</>أَ<k>نتُ</>مْ لَا تَشْعُ<p>رُو</>نَ"},{"n":56,"w":[["أَن","an","Lest","(এমন না হয়) যে"],["تَقُولَ","taqūla","should say","বলে"],["نَفْسٌۭ","nafsun","a soul","কেউ"],["يَـٰحَسْرَتَىٰ","yāḥasratā","Oh! My regret","\"হায়!"],["عَلَىٰ","‘alā","over","(এর) উপর"],["مَا","mā","what","যা"],["فَرَّطتُ","farraṭtu","I neglected","আমি অবহেলা করেছি"],["فِى","fī","in","ক্ষেত্রে"],["جَنۢبِ","janbi","regard (to)","কর্তব্যের"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর (প্রতি)"],["وَإِن","wa-in","and that","এবং নিশ্চয়ই"],["كُنتُ","kuntu","I was","আমি ছিলাম"],["لَمِنَ","lamina","surely, among","অবশ্যই অন্তর্ভুক্ত"],["ٱلسَّـٰخِرِينَ","l-sākhirīna","the mockers","বিদ্রুপকারীদের\""]],"t":"أَ<k>ن تَ</>قُولَ نَفْ<d>سٌۭ يَٰ</>حَسْرَتَىٰ عَلَىٰ مَا فَرَّطتُ فِى جَ<i>نۢبِ</> <h>ٱ</>للَّهِ وَإِ<k>ن كُنتُ</> لَمِنَ <h>ٱ</><l>ل</><m>سَّٰ</>خِ<p>رِي</>نَ"},{"n":57,"w":[["أَوْ","aw","Or","অথবা"],["تَقُولَ","taqūla","it should say","কেউ বলে"],["لَوْ","law","If that","\"যদি (এমন হতো)"],["أَنَّ","anna","If that","\"যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["هَدَىٰنِى","hadānī","(had) guided me","আমাকে পথপ্রদর্শন করতেন"],["لَكُنتُ","lakuntu","surely, I (would) have been","অবশ্যই আমি হতাম"],["مِنَ","mina","among","অন্তর্ভুক্ত"],["ٱلْمُتَّقِينَ","l-mutaqīna","the righteous","মুত্তাকীদের\""]],"t":"أَوْ تَقُولَ لَوْ أَ<g>نَّ</> <h>ٱ</>للَّهَ هَدَ<m>ىٰ</>نِى لَكُ<k>نتُ</> مِنَ <h>ٱ</>لْمُتَّ<p>قِي</>نَ"},{"n":58,"w":[["أَوْ","aw","Or","অথবা"],["تَقُولَ","taqūla","it should say","কেউ বলে"],["حِينَ","ḥīna","when","যখন"],["تَرَى","tarā","it sees","দেখবে"],["ٱلْعَذَابَ","l-‘adhāba","the punishment","শাস্তি"],["لَوْ","law","If","\"যদি (সম্ভব হতো)"],["أَنَّ","anna","only","যে"],["لِى","lī","for me","আমার জন্যে"],["كَرَّةًۭ","karratan","another chance","একবার প্রত্যাবর্তন"],["فَأَكُونَ","fa-akūna","then I could be","হতাম আমি তবে"],["مِنَ","mina","among","অন্তর্ভুক্ত"],["ٱلْمُحْسِنِينَ","l-muḥ'sinīna","the good-doers","সৎকর্মপরায়ণদের\""]],"t":"أَوْ تَقُولَ حِينَ تَرَى <h>ٱ</>لْعَذَابَ لَوْ أَ<g>نَّ</> لِى كَرَّ<k>ةًۭ فَ</>أَكُونَ مِنَ <h>ٱ</>لْمُحْسِ<p>نِي</>نَ"},{"n":59,"w":[["بَلَىٰ","balā","Yes","\"(বলা হবে) কেন নয়"],["قَدْ","qad","verily","নিশ্চয়ই"],["جَآءَتْكَ","jāatka","came to you","তোমার কাছে এসেছিলো"],["ءَايَـٰتِى","āyātī","My Verses","আমার নিদর্শনাবলী"],["فَكَذَّبْتَ","fakadhabta","but you denied","তুমি তখন মিথ্যা বলেছিলে"],["بِهَا","bihā","them","তা"],["وَٱسْتَكْبَرْتَ","wa-is'takbarta","and were arrogant","এবং তুমি অহংকার করেছিলে"],["وَكُنتَ","wakunta","and you were","এবং তুমি হয়েছিলে"],["مِنَ","mina","among","অন্তর্ভুক্ত"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","the disbelievers","কাফেরদের"]],"t":"بَلَىٰ قَ<q>دْ</> <o>جَآ</>ءَتْكَ ءَا<m>يَٰ</>تِى فَكَذَّ<q>بْ</>تَ بِهَا وَ<h>ٱ</>سْتَكْبَرْتَ وَكُ<k>نتَ</> مِنَ <h>ٱ</>لْ<m>كَٰ</>فِ<p>رِي</>نَ"},{"n":60,"w":[["وَيَوْمَ","wayawma","And (on the) Day","এবং দিনে"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) the Resurrection","ক্বিয়ামাতের"],["تَرَى","tarā","you will see","তুমি দেখবে"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["كَذَبُوا۟","kadhabū","lied","মিথ্যারোপ করেছে"],["عَلَى","‘alā","about","উপর"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["وُجُوهُهُم","wujūhuhum","their faces","তাদের মুখগুলো"],["مُّسْوَدَّةٌ ۚ","mus'waddatun","(will be) blackened","কালো (হয়ে গিয়েছে)"],["أَلَيْسَ","alaysa","Is (there) not","নয় কি"],["فِى","fī","in","মধ্যে"],["جَهَنَّمَ","jahannama","Hell","জাহান্নামের"],["مَثْوًۭى","mathwan","an abode","আবাসস্থল (যথেষ্ঠ)"],["لِّلْمُتَكَبِّرِينَ","lil'mutakabbirīna","for the arrogant","অহংকারকারীদের জন্যে"]],"t":"وَيَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ تَرَى <h>ٱ</>لَّذِينَ كَذَبُو<s>ا۟</> عَلَى <h>ٱ</>للَّهِ وُجُوهُ<y>هُم مُّ</>سْوَدَّةٌ ۚ أَلَيْسَ فِى جَهَ<g>نَّ</>مَ مَثْ<w>وًۭى لِّ</>لْمُتَكَبِّ<p>رِي</>نَ"},{"n":61,"w":[["وَيُنَجِّى","wayunajjī","And Allah will deliver","এবং উদ্ধার করবেন"],["ٱللَّهُ","l-lahu","And Allah will deliver","আল্লাহ"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["ٱتَّقَوْا۟","ittaqaw","feared (Him)","আত্মরক্ষা করেছিলো"],["بِمَفَازَتِهِمْ","bimafāzatihim","to their place of salvation","তাদের সাফল্যসহ"],["لَا","lā","not","না"],["يَمَسُّهُمُ","yamassuhumu","will touch them","তাদেরকে স্পর্শ করবে"],["ٱلسُّوٓءُ","l-sūu","the evil","অমঙ্গল"],["وَلَا","walā","and not","আর না"],["هُمْ","hum","they","তারা"],["يَحْزَنُونَ","yaḥzanūna","will grieve","চিন্তিত হবে"]],"t":"وَيُنَجِّى <h>ٱ</>للَّهُ <h>ٱ</>لَّذِينَ <h>ٱ</>تَّقَوْ<s>ا۟</> بِمَفَازَتِهِمْ لَا يَمَسُّهُمُ <h>ٱ</><l>ل</><o>سُّوٓ</>ءُ وَلَا هُمْ يَحْزَ<p>نُو</>نَ"},{"n":62,"w":[["ٱللَّهُ","al-lahu","Allah","আল্লাহ"],["خَـٰلِقُ","khāliqu","(is the) Creator","স্রষ্টা"],["كُلِّ","kulli","(of) all","প্রত্যেক"],["شَىْءٍۢ ۖ","shayin","things","জিনিসের"],["وَهُوَ","wahuwa","and He","এবং তিনি"],["عَلَىٰ","‘alā","(is) over","উপর"],["كُلِّ","kulli","all","সব"],["شَىْءٍۢ","shayin","things","জিনিসের"],["وَكِيلٌۭ","wakīlun","a Guardian","কর্মবিধায়ক"]],"t":"ٱللَّهُ <m>خَٰ</>لِقُ كُلِّ <d>شَىْءٍۢ ۖ وَ</>هُوَ عَلَىٰ كُلِّ <d>شَىْءٍۢ وَ</><p>كِي</>لٌۭ"},{"n":63,"w":[["لَّهُۥ","lahu","For Him","তাঁরই (কাছে রক্ষিত)"],["مَقَالِيدُ","maqālīdu","(are the) keys","চাবিসমূহ"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশের"],["وَٱلْأَرْضِ ۗ","wal-arḍi","and the earth","ও পৃথিবীর"],["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["كَفَرُوا۟","kafarū","disbelieve","অমান্য করেছে"],["بِـَٔايَـٰتِ","biāyāti","in (the) Verses","আয়াতগুলোকে"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["أُو۟لَـٰٓئِكَ","ulāika","those ","ঐসব লোক"],["هُمُ","humu","they","তারাই"],["ٱلْخَـٰسِرُونَ","l-khāsirūna","(are) the losers","ক্ষতিগ্রস্ত"]],"t":"لَّهُ<m>ۥ</> مَقَالِيدُ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ ۗ وَ<h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> بِـَٔا<m>يَٰ</>تِ <h>ٱ</>للَّهِ أُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</>لْ<m>خَٰ</>سِ<p>رُو</>نَ"},{"n":64,"w":[["قُلْ","qul","Say","(হে নাবী) বলো"],["أَفَغَيْرَ","afaghayra","Is (it) other than","\"তবে কি ব্যতীত"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["تَأْمُرُوٓنِّىٓ","tamurūnnī","you order me","আমাকে তোমরা নির্দেশ দিচ্ছো (যে)"],["أَعْبُدُ","a‘budu","(to) worship","ইবাদাত করবো আমি (অন্যকে)"],["أَيُّهَا","ayyuhā","O","ও হে"],["ٱلْجَـٰهِلُونَ","l-jāhilūna","ignorant ones","অজ্ঞ লোকেরা\""]],"t":"قُلْ أَفَغَيْرَ <h>ٱ</>للَّهِ تَأْمُ<n>رُوٓ</><g>نِّ</><o>ىٓ</> أَعْبُدُ أَيُّهَا <h>ٱ</>لْ<m>جَٰ</>هِ<p>لُو</>نَ"},{"n":65,"w":[["وَلَقَدْ","walaqad","And verily","এবং নিশ্চয়ই"],["أُوحِىَ","ūḥiya","it has been revealed","ওহী করা হয়েছে"],["إِلَيْكَ","ilayka","to you","তোমার প্রতি"],["وَإِلَى","wa-ilā","and to","এবং প্রতি"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["مِن","min","(were) before you","মধ্য হতে"],["قَبْلِكَ","qablika","(were) before you","তোমার পূর্বে (ছিলো)"],["لَئِنْ","la-in","if","অবশ্য যদি"],["أَشْرَكْتَ","ashrakta","you associate (with Allah)","তুমি শরিক করো"],["لَيَحْبَطَنَّ","layaḥbaṭanna","surely, will become worthless","বিনষ্ট হবে যাবেই"],["عَمَلُكَ","‘amaluka","your deeds","তোমার কৃতকর্ম"],["وَلَتَكُونَنَّ","walatakūnanna","and you will surely be","এবং তুমি অবশ্যই হয়ে যাবে"],["مِنَ","mina","among","অন্তর্ভুক্ত"],["ٱلْخَـٰسِرِينَ","l-khāsirīna","the losers","ক্ষতিগ্রস্তদের"]],"t":"وَلَقَ<q>دْ</> أُوحِىَ إِلَيْكَ وَإِلَى <h>ٱ</>لَّذِينَ مِ<k>ن قَ</><q>بْ</>لِكَ لَئِنْ أَشْرَكْتَ لَيَحْبَطَ<g>نَّ</> عَمَلُكَ وَلَتَكُونَ<g>نَّ</> مِنَ <h>ٱ</>لْ<m>خَٰ</>سِ<p>رِي</>نَ"},{"n":66,"w":[["بَلِ","bali","Nay","বরং"],["ٱللَّهَ","l-laha","But worship Allah","আল্লাহরই"],["فَٱعْبُدْ","fa-u‘'bud","But worship Allah","তুমি তাই  ইবাদাত করো"],["وَكُن","wakun","and be","এবং হয়ে যাও"],["مِّنَ","mina","among","অন্তর্ভুক্ত"],["ٱلشَّـٰكِرِينَ","l-shākirīna","the thankful ones","কৃতজ্ঞদের"]],"t":"بَلِ <h>ٱ</>للَّهَ فَ<h>ٱ</>عْبُ<q>دْ</> وَ<d>كُن مِّ</>نَ <h>ٱ</><l>ل</><m>شَّٰ</>كِ<p>رِي</>نَ"},{"n":67,"w":[["وَمَا","wamā","And not","এবং না"],["قَدَرُوا۟","qadarū","they appraised","তারা সম্মান করে"],["ٱللَّهَ","l-laha","Allah","আল্লাহর"],["حَقَّ","ḥaqqa","(with) true","যথোচিত"],["قَدْرِهِۦ","qadrihi","appraisal","তাঁর সম্মান"],["وَٱلْأَرْضُ","wal-arḍu","while the earth","অথচ পৃথিবী"],["جَمِيعًۭا","jamī‘an","entirely","সবটাই"],["قَبْضَتُهُۥ","qabḍatuhu","(will be) in His Grip","তাঁরই মুঠিতে হবে"],["يَوْمَ","yawma","(on the) Day","দিনে"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) the Resurrection","ক্বিয়ামাতের"],["وَٱلسَّمَـٰوَٰتُ","wal-samāwātu","and the heavens","ও আকাশ (থাকবে)"],["مَطْوِيَّـٰتٌۢ","maṭwiyyātun","(will be) folded","গুটানো অবস্থায়"],["بِيَمِينِهِۦ ۚ","biyamīnihi","in His Right Hand","তাঁর ডান হাতের মধ্যে"],["سُبْحَـٰنَهُۥ","sub'ḥānahu","Glory be to Him","তিনি মহান পবিত্র"],["وَتَعَـٰلَىٰ","wata‘ālā","And High is He","ও বহু ঊর্ধ্বে"],["عَمَّا","‘ammā","above what","তা হ'তে যা"],["يُشْرِكُونَ","yush'rikūna","they associate (with Him)","তারা শরিক করে"]],"t":"وَمَا قَدَرُو<s>ا۟</> <h>ٱ</>للَّهَ حَقَّ قَ<q>دْ</>رِ<m>هِۦ</> وَ<h>ٱ</>لْأَرْضُ جَمِي<k>عًۭا قَ</><q>بْ</>ضَتُهُ<m>ۥ</> يَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ وَ<h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تُ مَ<q>طْ</>وِ<m>يَّٰ</><i>تٌۢ بِ</>يَمِينِ<m>هِۦ</> ۚ سُ<q>بْ</><m>حَٰ</>نَهُ<m>ۥ</> وَتَ<m>عَٰ</>لَىٰ عَ<g>مَّ</>ا يُشْرِ<p>كُو</>نَ"},{"n":68,"w":[["وَنُفِخَ","wanufikha","And (will) be blown","এবং ফুঁ দেওয়া হবে"],["فِى","fī","[in]","মধ্যে"],["ٱلصُّورِ","l-ṣūri","the trumpet","শিংগার"],["فَصَعِقَ","faṣa‘iqa","then (will) fall dead","অতঃপর মূর্ছা যাবে"],["مَن","man","whoever","যারা"],["فِى","fī","(is) in","মধ্যে (আছে)"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশের"],["وَمَن","waman","and whoever","ও যারা"],["فِى","fī","(is) on","মধ্যে আছে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["إِلَّا","illā","except","এ ছাড়া"],["مَن","man","whom","যাদেরকে"],["شَآءَ","shāa","Allah wills","ইচ্ছে করবেন"],["ٱللَّهُ ۖ","l-lahu","Allah wills","আল্লাহ"],["ثُمَّ","thumma","Then","এরপর"],["نُفِخَ","nufikha","(it will) be blown","ফুঁ দেওয়া হবে"],["فِيهِ","fīhi","[in it]","তার মধ্যে"],["أُخْرَىٰ","ukh'rā","a second time","আবার"],["فَإِذَا","fa-idhā","and behold","ফলে তখন"],["هُمْ","hum","They","তারা"],["قِيَامٌۭ","qiyāmun","(will be) standing","দাঁড়িয়ে"],["يَنظُرُونَ","yanẓurūna","waiting","দেখতে থাকবে"]],"t":"وَنُفِخَ فِى <h>ٱ</><l>ل</>صُّورِ فَصَعِقَ مَ<k>ن فِ</>ى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَمَ<k>ن فِ</>ى <h>ٱ</>لْأَرْضِ إِلَّا مَ<k>ن شَ</><o>آ</>ءَ <h>ٱ</>للَّهُ ۖ ثُ<g>مَّ</> نُفِخَ فِيهِ أُخْرَىٰ فَإِذَا هُمْ قِيَا<d>مٌۭ يَ</><k>نظُ</><p>رُو</>نَ"},{"n":69,"w":[["وَأَشْرَقَتِ","wa-ashraqati","And (will) shine","এবং উদ্ভাসিত হবে"],["ٱلْأَرْضُ","l-arḍu","the earth","পৃথিবী"],["بِنُورِ","binūri","with (the) light","দিয়ে আলো (আলোতে)"],["رَبِّهَا","rabbihā","(of) its Lord","তাঁর রবের"],["وَوُضِعَ","wawuḍi‘a","and (will) be placed","এবং উপস্হিত করা হবে"],["ٱلْكِتَـٰبُ","l-kitābu","the Record","আমলনামা"],["وَجِا۟ىٓءَ","wajīa","and (will) be brought","এবং উপস্থিত করা হবে"],["بِٱلنَّبِيِّـۧنَ","bil-nabiyīna","the Prophets","নাবী (রাসূল)গণকে"],["وَٱلشُّهَدَآءِ","wal-shuhadāi","and the witnesses","ও সাক্ষীদেরকে"],["وَقُضِىَ","waquḍiya","and it (will) be judged","এবং মীমাংসা করে দেওয়া হবে"],["بَيْنَهُم","baynahum","between them","তাদের মাঝে"],["بِٱلْحَقِّ","bil-ḥaqi","in truth","ন্যায়ভাবে"],["وَهُمْ","wahum","and they","এবং তাদের (উপর)"],["لَا","lā","will not be wronged","না"],["يُظْلَمُونَ","yuẓ'lamūna","will not be wronged","অবিচার করা হবে"]],"t":"وَأَشْرَقَتِ <h>ٱ</>لْأَرْضُ بِنُورِ رَبِّهَا وَوُضِعَ <h>ٱ</>لْكِ<m>تَٰ</>بُ وَجِ<s>ا۟</><o>ىٓ</>ءَ بِ<h>ٱ</><l>ل</><g>نَّ</>بِيِّۦنَ وَ<h>ٱ</><l>ل</>شُّهَ<o>دَآ</>ءِ وَقُضِىَ بَيْنَ<f>هُم بِ</><h>ٱ</>لْحَقِّ وَهُمْ لَا يُظْلَ<p>مُو</>نَ"},{"n":70,"w":[["وَوُفِّيَتْ","wawuffiyat","And (will) be paid in full","এবং পূর্ণ (প্রতিফল) দেওয়া হবে"],["كُلُّ","kullu","every","প্রত্যেক"],["نَفْسٍۢ","nafsin","soul","ব্যক্তিকে"],["مَّا","mā","what","যা"],["عَمِلَتْ","‘amilat","it did","সে কর্মে করেছে"],["وَهُوَ","wahuwa","and He","এবং তিনি"],["أَعْلَمُ","a‘lamu","(is the) Best-Knower","খুব জানেন"],["بِمَا","bimā","of what","ঐ সম্পর্কে যা"],["يَفْعَلُونَ","yaf‘alūna","they do","তারা করে"]],"t":"وَوُفِّيَتْ كُلُّ نَفْ<d>سٍۢ مَّ</>ا عَمِلَتْ وَهُوَ أَعْلَمُ بِمَا يَفْعَ<p>لُو</>نَ"},{"n":71,"w":[["وَسِيقَ","wasīqa","And (will) be driven","এবং তাড়িয়ে নেওয়া হবে"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["كَفَرُوٓا۟","kafarū","disbelieve","অস্বীকার করেছে"],["إِلَىٰ","ilā","to","দিকে"],["جَهَنَّمَ","jahannama","Hell","জাহান্নামের"],["زُمَرًا ۖ","zumaran","(in) groups","দলে দলে"],["حَتَّىٰٓ","ḥattā","until","শেষ পর্যন্ত"],["إِذَا","idhā","when","যখন"],["جَآءُوهَا","jāūhā","they reach it","তার (কাছে) আসবে"],["فُتِحَتْ","futiḥat","(will) be opened","খুলে দেওয়া হবে"],["أَبْوَٰبُهَا","abwābuhā","its gates","তার ফটকগুলো"],["وَقَالَ","waqāla","and (will) say","এবং বলবে"],["لَهُمْ","lahum","to them","তাদেরকে"],["خَزَنَتُهَآ","khazanatuhā","its keepers","তার রক্ষীরা"],["أَلَمْ","alam","Did not","\"নি কি"],["يَأْتِكُمْ","yatikum","come to you","তোমাদের কাছে আসে"],["رُسُلٌۭ","rusulun","Messengers","রাসূলগণ"],["مِّنكُمْ","minkum","from you","তোমাদের মধ্য হ'তে"],["يَتْلُونَ","yatlūna","reciting","তারা আবৃত্তি করে শুনাতো"],["عَلَيْكُمْ","‘alaykum","to you","তোমাদের কাছে"],["ءَايَـٰتِ","āyāti","(the) Verses","আয়াতসমূহ"],["رَبِّكُمْ","rabbikum","(of) your Lord","তোমাদের রবের"],["وَيُنذِرُونَكُمْ","wayundhirūnakum","and warning you","ও তোমাদেরকে সতর্ক করতো"],["لِقَآءَ","liqāa","(of the) meeting","সাক্ষাতের"],["يَوْمِكُمْ","yawmikum","(of) your Day","তোমাদের দিনের"],["هَـٰذَا ۚ","hādhā","this","এই\""],["قَالُوا۟","qālū","They (will) say","তারা বলবে"],["بَلَىٰ","balā","Yes","\"অবশ্যই (এসেছিলো)\""],["وَلَـٰكِنْ","walākin","But","কিন্তু"],["حَقَّتْ","ḥaqqat","has been justified","অবধারিত হয়েছিলো"],["كَلِمَةُ","kalimatu","(the) word","বাণী"],["ٱلْعَذَابِ","l-‘adhābi","(of) punishment","শাস্তির"],["عَلَى","‘alā","against","উপর"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","the disbelievers","কাফেরদের"]],"t":"وَسِيقَ <h>ٱ</>لَّذِينَ كَفَ<o>رُوٓ</><s>ا۟</> إِلَىٰ جَهَ<g>نَّ</>مَ زُمَرًا ۖ حَتَّ<o>ىٰٓ</> إِذَا <o>جَآ</>ءُوهَا فُتِحَتْ أَ<q>بْ</><m>وَٰ</>بُهَا وَقَالَ لَهُمْ خَزَنَتُ<o>هَآ</> أَلَمْ يَأْتِكُمْ رُسُ<d>لٌۭ مِّ</><k>نكُ</>مْ يَتْلُونَ عَلَيْكُمْ ءَا<m>يَٰ</>تِ رَبِّكُمْ وَيُ<k>نذِ</>رُونَكُمْ لِ<o>قَآ</>ءَ يَوْمِكُمْ <m>هَٰ</>ذَا ۚ قَالُو<s>ا۟</> بَلَىٰ وَ<m>لَٰ</>كِنْ حَقَّتْ كَلِمَةُ <h>ٱ</>لْعَذَابِ عَلَى <h>ٱ</>لْ<m>كَٰ</>فِ<p>رِي</>نَ"},{"n":72,"w":[["قِيلَ","qīla","It will be said","বলা হবে"],["ٱدْخُلُوٓا۟","ud'khulū","Enter","\"তোমরা প্রবেশ করো"],["أَبْوَٰبَ","abwāba","(the) gates","দরজাসমূহে"],["جَهَنَّمَ","jahannama","(of) Hell","জাহান্নামের"],["خَـٰلِدِينَ","khālidīna","(to) abide eternally","চিরস্থায়ী হবে"],["فِيهَا ۖ","fīhā","therein","তার মধ্যে"],["فَبِئْسَ","fabi'sa","and wretched is","অতঃপর কত নিকৃষ্ট"],["مَثْوَى","mathwā","(the) abode","আবাসস্থল"],["ٱلْمُتَكَبِّرِينَ","l-mutakabirīna","(of) the arrogant","অহংকারীদের\""]],"t":"قِيلَ <h>ٱ</><q>دْ</>خُ<o>لُوٓ</><s>ا۟</> أَ<q>بْ</><m>وَٰ</>بَ جَهَ<g>نَّ</>مَ <m>خَٰ</>لِدِينَ فِيهَا ۖ فَبِئْسَ مَثْوَى <h>ٱ</>لْمُتَكَبِّ<p>رِي</>نَ"},{"n":73,"w":[["وَسِيقَ","wasīqa","And (will) be driven","এবং নিয়ে যাওয়া হবে"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["ٱتَّقَوْا۟","ittaqaw","feared","বেঁচে থাকতো"],["رَبَّهُمْ","rabbahum","their Lord","তাদের রবের"],["إِلَى","ilā","to","দিকে"],["ٱلْجَنَّةِ","l-janati","Paradise","জান্নাতের"],["زُمَرًا ۖ","zumaran","(in) groups","দলে দলে"],["حَتَّىٰٓ","ḥattā","until","শেষ পর্যন্ত"],["إِذَا","idhā","when","যখন"],["جَآءُوهَا","jāūhā","they reach it","তার (কাছে) আসবে"],["وَفُتِحَتْ","wafutiḥat","and (will) be opened","এবং খুলে দেওয়া হবে"],["أَبْوَٰبُهَا","abwābuhā","its gates","তার দরজাগুলো"],["وَقَالَ","waqāla","and (will) say","এবং বলবে"],["لَهُمْ","lahum","to them","তাদেরকে"],["خَزَنَتُهَا","khazanatuhā","its keepers","তার রক্ষীরা"],["سَلَـٰمٌ","salāmun","Peace be","\"সালাম"],["عَلَيْكُمْ","‘alaykum","upon you","তোমাদের উপর"],["طِبْتُمْ","ṭib'tum","you have done well","তোমরা সুখী হও"],["فَٱدْخُلُوهَا","fa-ud'khulūhā","so enter it","তাতে তোমরা অতঃপর প্রবেশ করো"],["خَـٰلِدِينَ","khālidīna","(to) abide eternally","তোমরা চিরস্থায়ী হবে (সেখানে).\""]],"t":"وَسِيقَ <h>ٱ</>لَّذِينَ <h>ٱ</>تَّقَوْ<s>ا۟</> رَبَّهُمْ إِلَى <h>ٱ</>لْجَ<g>نَّ</>ةِ زُمَرًا ۖ حَتَّ<o>ىٰٓ</> إِذَا <o>جَآ</>ءُوهَا وَفُتِحَتْ أَ<q>بْ</><m>وَٰ</>بُهَا وَقَالَ لَهُمْ خَزَنَتُهَا سَ<m>لَٰ</>مٌ عَلَيْكُمْ طِ<q>بْ</>تُمْ فَ<h>ٱ</><q>دْ</>خُلُوهَا <m>خَٰ</>لِ<p>دِي</>نَ"},{"n":74,"w":[["وَقَالُوا۟","waqālū","And they will say","এবং তারা বলবে"],["ٱلْحَمْدُ","l-ḥamdu","All praise","\"সব প্রশংসা (ও শোকর)"],["لِلَّهِ","lillahi","(be) to Allah","আল্লাহর জন্যে"],["ٱلَّذِى","alladhī","Who","যিনি"],["صَدَقَنَا","ṣadaqanā","has fulfilled for us","আমাদেরকে সত্য করে দেখিয়েছেন"],["وَعْدَهُۥ","wa‘dahu","His promise","তাঁর প্রতিশ্রুতি"],["وَأَوْرَثَنَا","wa-awrathanā","and has made us inherit","এবং আমাদেরকে অধিকারী করেছেন"],["ٱلْأَرْضَ","l-arḍa","the earth","এ-স্হানের"],["نَتَبَوَّأُ","natabawwa-u","we may settle","বসবাস করবো আমরা"],["مِنَ","mina","[from]","মধ্য হ'তে"],["ٱلْجَنَّةِ","l-janati","(in) Paradise","জান্নাতের"],["حَيْثُ","ḥaythu","wherever","যেখানে"],["نَشَآءُ ۖ","nashāu","we wish","ইচ্ছে করবো আমরা"],["فَنِعْمَ","fani‘'ma","So excellent","অতএব কত উত্তম"],["أَجْرُ","ajru","(is the) reward","পুরস্কার"],["ٱلْعَـٰمِلِينَ","l-‘āmilīna","(of) the workers","সৎকর্মসম্পাদনকারীদের\""]],"t":"وَقَالُو<s>ا۟</> <h>ٱ</>لْحَمْدُ لِلَّهِ <h>ٱ</>لَّذِى صَدَقَنَا وَعْدَهُ<m>ۥ</> وَأَوْرَثَنَا <h>ٱ</>لْأَرْضَ نَتَبَوَّأُ مِنَ <h>ٱ</>لْجَ<g>نَّ</>ةِ حَيْثُ نَ<o>شَآ</>ءُ ۖ فَنِعْمَ أَ<q>جْ</>رُ <h>ٱ</>لْ<m>عَٰ</>مِ<p>لِي</>نَ"},{"n":75,"w":[["وَتَرَى","watarā","And you will see","এবং দেখবে তুমি"],["ٱلْمَلَـٰٓئِكَةَ","l-malāikata","the Angels","ফেরেশতাদেরকে"],["حَآفِّينَ","ḥāffīna","surrounding","ঘিরে থাকতে"],["مِنْ","min","[from]","থেকে"],["حَوْلِ","ḥawli","around","পাশ"],["ٱلْعَرْشِ","l-‘arshi","the Throne","আরশের"],["يُسَبِّحُونَ","yusabbiḥūna","glorifying","তারা মহিমা ঘোষণা করতে থাকবে"],["بِحَمْدِ","biḥamdi","(the) praise","প্রশংসাসহ"],["رَبِّهِمْ ۖ","rabbihim","(of) their Lord","তাদের রবের"],["وَقُضِىَ","waquḍiya","And (will) be judged","এবং বিচার করে দেওয়া হবে"],["بَيْنَهُم","baynahum","between them","তাদের মাঝে"],["بِٱلْحَقِّ","bil-ḥaqi","in truth","ন্যায়ভাবে"],["وَقِيلَ","waqīla","and it will be said","এবং বলা হবে"],["ٱلْحَمْدُ","l-ḥamdu","All praise be","\"সকল প্রশংসা"],["لِلَّهِ","lillahi","to Allah","আল্লাহর জন্যে"],["رَبِّ","rabbi","(the) Lord","(যিনি) রব"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","(of) the worlds","বিশ্বজগতের\""]],"t":"وَتَرَى <h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةَ <n>حَآ</>فِّينَ مِنْ حَوْلِ <h>ٱ</>لْعَرْشِ يُسَبِّحُونَ بِحَمْدِ رَبِّهِمْ ۖ وَقُضِىَ بَيْنَ<f>هُم بِ</><h>ٱ</>لْحَقِّ وَقِيلَ <h>ٱ</>لْحَمْدُ لِلَّهِ رَبِّ <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"}]}