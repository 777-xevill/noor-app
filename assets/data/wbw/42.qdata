{"n":42,"a":[{"n":1,"w":[["حمٓ","hha-meem","Ha Meem","হা-মীম"]],"t":"ح<n>مٓ</>"},{"n":2,"w":[["عٓسٓقٓ","ain-seen-qaf","Ayn Seen Qaaf","আইন - সীন-ক্কাফ"]],"t":"<n>عٓسٓقٓ</>"},{"n":3,"w":[["كَذَٰلِكَ","kadhālika","Thus","এভাবে"],["يُوحِىٓ","yūḥī","reveals","ওহী পাঠান (আল্লাহ)"],["إِلَيْكَ","ilayka","to you","তোমার প্রতি"],["وَإِلَى","wa-ilā","and to","এবং প্রতি"],["ٱلَّذِينَ","alladhīna","those","(তাদের) যারা"],["مِن","min","before you ","মধ্য হতে"],["قَبْلِكَ","qablika","before you ","তোমার পূর্বে (নাবী-রাসূল ছিলো)"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["ٱلْعَزِيزُ","l-‘azīzu","the All-Mighty","পরাক্রমশালী"],["ٱلْحَكِيمُ","l-ḥakīmu","the All-Wise","প্রজ্ঞাময়"]],"t":"كَ<m>ذَٰ</>لِكَ يُو<o>حِىٓ</> إِلَيْكَ وَإِلَى <h>ٱ</>لَّذِينَ مِ<k>ن قَ</><q>بْ</>لِكَ <h>ٱ</>للَّهُ <h>ٱ</>لْعَزِيزُ <h>ٱ</>لْحَ<p>كِي</>مُ"},{"n":4,"w":[["لَهُۥ","lahu","To Him","তাঁরই"],["مَا","mā","(belong) whatever","যা কিছু"],["فِى","fī","(is) in","মধ্যে (আছে)"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশের"],["وَمَا","wamā","and whatever","এবং যা কিছু"],["فِى","fī","(is) in","মধ্যে আছে"],["ٱلْأَرْضِ ۖ","l-arḍi","the earth","পৃথিবীর"],["وَهُوَ","wahuwa","and He","এবং তিনিই"],["ٱلْعَلِىُّ","l-‘aliyu","(is) the Most High","সমুন্নত"],["ٱلْعَظِيمُ","l-‘aẓīmu","the Most Great","সুমহান"]],"t":"لَهُ<m>ۥ</> مَا فِى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَمَا فِى <h>ٱ</>لْأَرْضِ ۖ وَهُوَ <h>ٱ</>لْعَلِىُّ <h>ٱ</>لْعَ<p>ظِي</>مُ"},{"n":5,"w":[["تَكَادُ","takādu","Almost","(তাঁর সাথে শরিক করায়) উপক্রম হয়"],["ٱلسَّمَـٰوَٰتُ","l-samāwātu","the heavens","আকাশ"],["يَتَفَطَّرْنَ","yatafaṭṭarna","break up","ভেঙে পড়ার"],["مِن","min","from","থেকে"],["فَوْقِهِنَّ ۚ","fawqihinna","above them","তাদের উপর"],["وَٱلْمَلَـٰٓئِكَةُ","wal-malāikatu","and the Angels","এবং ফেরেশতারা"],["يُسَبِّحُونَ","yusabbiḥūna","glorify","পবিত্রতা ঘোষণা করে"],["بِحَمْدِ","biḥamdi","(the) praise","প্রশংসাসহ"],["رَبِّهِمْ","rabbihim","(of) their Lord","তাদের রবের"],["وَيَسْتَغْفِرُونَ","wayastaghfirūna","and ask for forgiveness","এবং ক্ষমা প্রার্থনা করে"],["لِمَن","liman","for those","(তাদের) জন্যে যারা"],["فِى","fī","on","মধ্যে (আছে)"],["ٱلْأَرْضِ ۗ","l-arḍi","the earth","পৃথিবীর"],["أَلَآ","alā","Unquestionably","জেনে রাখো"],["إِنَّ","inna","indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["هُوَ","huwa","He","তিনিই"],["ٱلْغَفُورُ","l-ghafūru","(is) the Oft-Forgiving","ক্ষমাশীল"],["ٱلرَّحِيمُ","l-raḥīmu","the Most Merciful","পরম দয়ালু"]],"t":"تَكَادُ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تُ يَتَفَطَّرْنَ مِ<k>ن فَ</>وْقِهِ<g>نَّ</> ۚ وَ<h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةُ يُسَبِّحُونَ بِحَمْدِ رَبِّهِمْ وَيَسْتَغْفِرُونَ لِمَ<k>ن فِ</>ى <h>ٱ</>لْأَرْضِ ۗ أَ<o>لَآ</> إِ<g>نَّ</> <h>ٱ</>للَّهَ هُوَ <h>ٱ</>لْغَفُورُ <h>ٱ</><l>ل</>رَّ<p>حِي</>مُ"},{"n":6,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["ٱتَّخَذُوا۟","ittakhadhū","take","গ্রহণ করেছে"],["مِن","min","besides","ছাড়া"],["دُونِهِۦٓ","dūnihi","besides","তাঁকে"],["أَوْلِيَآءَ","awliyāa","protectors","অভিভাবকরূপে"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ-ই"],["حَفِيظٌ","ḥafīẓun","(is) a Guardian","সংরক্ষক"],["عَلَيْهِمْ","‘alayhim","over them","তাদের উপর"],["وَمَآ","wamā","and not","এবং নও"],["أَنتَ","anta","you","তুমি"],["عَلَيْهِم","‘alayhim","(are) over them","তাদের উপর (নিযুক্ত হয়েছে)"],["بِوَكِيلٍۢ","biwakīlin","a manager","কর্ম বিধায়ক"]],"t":"وَ<h>ٱ</>لَّذِينَ <h>ٱ</>تَّخَذُو<s>ا۟</> مِ<k>ن دُ</>ونِ<o>هِۦٓ</> أَوْلِ<o>يَآ</>ءَ <h>ٱ</>للَّهُ حَفِيظٌ عَلَيْهِمْ وَ<o>مَآ</> أَ<k>نتَ</> عَلَيْ<f>هِم بِ</>وَ<p>كِي</>لٍۢ"},{"n":7,"w":[["وَكَذَٰلِكَ","wakadhālika","And thus","এবং এভাবে"],["أَوْحَيْنَآ","awḥaynā","We have revealed","আমরা ওহী করেছি"],["إِلَيْكَ","ilayka","to you","তোমার প্রতি"],["قُرْءَانًا","qur'ānan","a Quran","কুরআনকে"],["عَرَبِيًّۭا","‘arabiyyan","(in) Arabic","আরবী (ভাষায়)"],["لِّتُنذِرَ","litundhira","that you may warn","সতর্ক করো তুমি যেনো"],["أُمَّ","umma","(the) mother","কেন্দ্রকে"],["ٱلْقُرَىٰ","l-qurā","(of) the towns","জনপদসমূহের (অর্থাৎ মাক্কাবাসীদেরকে)"],["وَمَنْ","waman","and whoever","এবং যারা"],["حَوْلَهَا","ḥawlahā","(is) around it","তার চার পাশে (আছে)"],["وَتُنذِرَ","watundhira","and warn","এবং সতর্ক করো তুমি (যেনো)"],["يَوْمَ","yawma","(of the) Day","দিন (সম্পর্কে)"],["ٱلْجَمْعِ","l-jam‘i","(of) Assembly","সমবেত হওয়ার (অর্থাৎ ক্বিয়ামাতের)"],["لَا","lā","(there is) no","নেই"],["رَيْبَ","rayba","doubt","কোনো সন্দেহ"],["فِيهِ ۚ","fīhi","in it","তার মধ্যে"],["فَرِيقٌۭ","farīqun","A party","একদল (সেদিন হবে)"],["فِى","fī","(will be) in","মধ্যে"],["ٱلْجَنَّةِ","l-janati","Paradise","জান্নাতের"],["وَفَرِيقٌۭ","wafarīqun","and a party","এবং একদল (হবে)"],["فِى","fī","in","মধ্যে"],["ٱلسَّعِيرِ","l-sa‘īri","the Blazing Fire","জাহান্নামের"]],"t":"وَكَ<m>ذَٰ</>لِكَ أَوْحَيْ<o>نَآ</> إِلَيْكَ قُرْءَانًا عَرَبِ<w>يًّۭا لِّ</>تُ<k>نذِ</>رَ أُ<g>مَّ</> <h>ٱ</>لْقُرَىٰ وَمَنْ حَوْلَهَا وَتُ<k>نذِ</>رَ يَوْمَ <h>ٱ</>لْجَمْعِ لَا رَيْبَ فِيهِ ۚ فَرِي<k>قٌۭ فِ</>ى <h>ٱ</>لْجَ<g>نَّ</>ةِ وَفَرِي<k>قٌۭ فِ</>ى <h>ٱ</><l>ل</>سَّ<p>عِي</>رِ"},{"n":8,"w":[["وَلَوْ","walaw","And if","এবং যদি"],["شَآءَ","shāa","Allah willed","চাইতেন"],["ٱللَّهُ","l-lahu","Allah willed","আল্লাহ"],["لَجَعَلَهُمْ","laja‘alahum","He could have made them","তাদেরকে অবশ্যই করতেন"],["أُمَّةًۭ","ummatan","a community","জাতি"],["وَٰحِدَةًۭ","wāḥidatan","one","একই"],["وَلَـٰكِن","walākin","but","কিন্তু"],["يُدْخِلُ","yud'khilu","He admits","প্রবেশ করান"],["مَن","man","whom","যাকে"],["يَشَآءُ","yashāu","He wills","ইচ্ছে করেন (আল্লাহ)"],["فِى","fī","in (to)","মধ্যে"],["رَحْمَتِهِۦ ۚ","raḥmatihi","His Mercy","তাঁর অনুগ্রহের"],["وَٱلظَّـٰلِمُونَ","wal-ẓālimūna","And the wrongdoers","এবং সীমালঙ্ঘনকারীদের (অবস্থা হলো)"],["مَا","mā","not","নেই"],["لَهُم","lahum","for them","তাদের জন্যে"],["مِّن","min","any","কোনো"],["وَلِىٍّۢ","waliyyin","protector","অভিভাবক"],["وَلَا","walā","and not","আর নেই"],["نَصِيرٍ","naṣīrin","any helper","কোনো সাহায্যকারী"]],"t":"وَلَوْ <o>شَآ</>ءَ <h>ٱ</>للَّهُ لَجَعَلَهُمْ أُ<g>مَّ</><d>ةًۭ وَٰ</>حِدَ<d>ةًۭ وَ</><m>لَٰ</><d>كِن يُ</><q>دْ</>خِلُ <d>مَن يَ</><o>شَآ</>ءُ فِى رَحْمَتِ<m>هِۦ</> ۚ وَ<h>ٱ</><l>ل</><m>ظَّٰ</>لِمُونَ مَا لَ<y>هُم مِّ</><d>ن وَلِىٍّۢ وَ</>لَا نَ<p>صِي</>رٍ"},{"n":9,"w":[["أَمِ","ami","Or","তবে কি"],["ٱتَّخَذُوا۟","ittakhadhū","have they taken","তারা গ্রহণ করেছে"],["مِن","min","besides Him","মধ্য হতে"],["دُونِهِۦٓ","dūnihi","besides Him","তাঁকে ছাড়া"],["أَوْلِيَآءَ ۖ","awliyāa","protectors","অভিভাবকরূপে (অন্যান্যদেরকে)"],["فَٱللَّهُ","fal-lahu","But Allah ","অথচ আল্লাহ"],["هُوَ","huwa","He","তিনিই"],["ٱلْوَلِىُّ","l-waliyu","(is) the Protector","অভিভাবক"],["وَهُوَ","wahuwa","and He","এবং তিনিই"],["يُحْىِ","yuḥ'yī","gives life","জীবিত করেন"],["ٱلْمَوْتَىٰ","l-mawtā","(to) the dead","মৃতদেরকে"],["وَهُوَ","wahuwa","And He","এবং তিনি"],["عَلَىٰ","‘alā","(is) on","উপর"],["كُلِّ","kulli","every","সব"],["شَىْءٍۢ","shayin","thing","কিছুরই"],["قَدِيرٌۭ","qadīrun","All-Powerful","সর্বশক্তিমান"]],"t":"أَمِ <h>ٱ</>تَّخَذُو<s>ا۟</> مِ<k>ن دُ</>ونِ<o>هِۦٓ</> أَوْلِ<o>يَآ</>ءَ ۖ فَ<h>ٱ</>للَّهُ هُوَ <h>ٱ</>لْوَلِىُّ وَهُوَ يُحْىِ <h>ٱ</>لْمَوْتَىٰ وَهُوَ عَلَىٰ كُلِّ <k>شَىْءٍۢ قَ</><p>دِي</>رٌۭ"},{"n":10,"w":[["وَمَا","wamā","And whatever","এবং যা"],["ٱخْتَلَفْتُمْ","ikh'talaftum","you differ","তোমরা মতভেদ করো"],["فِيهِ","fīhi","in it","সেক্ষেত্রে"],["مِن","min","of","কোনো"],["شَىْءٍۢ","shayin","a thing","কিছু"],["فَحُكْمُهُۥٓ","faḥuk'muhu","then its ruling","তার অতঃপর  মীমাংসা (হবে)"],["إِلَى","ilā","(is) to","কাছে"],["ٱللَّهِ ۚ","l-lahi","Allah","আল্লাহ্‌র"],["ذَٰلِكُمُ","dhālikumu","That","তিনিই"],["ٱللَّهُ","l-lahu","(is) Allah","আল্লাহ-ই"],["رَبِّى","rabbī","my Lord","আমার রব"],["عَلَيْهِ","‘alayhi","upon Him","তাঁর উপর"],["تَوَكَّلْتُ","tawakkaltu","I put my trust","আমি নির্ভর করি"],["وَإِلَيْهِ","wa-ilayhi","and to Him","এবং তাঁরই দিকে"],["أُنِيبُ","unību","I turn","মুখ ফিরিয়েছি আমি"]],"t":"وَمَا <h>ٱ</>خْتَلَفْتُمْ فِيهِ مِ<k>ن شَىْءٍۢ فَ</>حُكْمُهُ<o>ۥٓ</> إِلَى <h>ٱ</>للَّهِ ۚ <m>ذَٰ</>لِكُمُ <h>ٱ</>للَّهُ رَبِّى عَلَيْهِ تَوَكَّلْتُ وَإِلَيْهِ أُ<p>نِي</><q>بُ</>"},{"n":11,"w":[["فَاطِرُ","fāṭiru","(The) Creator","(আল্লাহ-ই) সৃষ্টিকর্তা"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশের"],["وَٱلْأَرْضِ ۚ","wal-arḍi","and the earth","এবং পৃথিবীর"],["جَعَلَ","ja‘ala","He made","তিনি সৃষ্টি করেছেন"],["لَكُم","lakum","for you","তোমাদের জন্যে"],["مِّنْ","min","from","মধ্য হ'তে"],["أَنفُسِكُمْ","anfusikum","yourselves","তোমাদের নিজেদের"],["أَزْوَٰجًۭا","azwājan","mates","জোড়া জোড়া"],["وَمِنَ","wamina","and among","এবং মধ্য হতে"],["ٱلْأَنْعَـٰمِ","l-an‘āmi","the cattle","গবাদি পশুর"],["أَزْوَٰجًۭا ۖ","azwājan","mates","জোড়া জোড়া"],["يَذْرَؤُكُمْ","yadhra-ukum","He multiplies you","তোমাদের বিস্তার করেন (বংশ)"],["فِيهِ ۚ","fīhi","thereby","তার মধ্যে"],["لَيْسَ","laysa","(There) is not","নেই"],["كَمِثْلِهِۦ","kamith'lihi","like Him","তাঁর মতো"],["شَىْءٌۭ ۖ","shayon","anything","কোনো কিছুই"],["وَهُوَ","wahuwa","and He","এবং তিনি"],["ٱلسَّمِيعُ","l-samī‘u","(is) the All-Hearer","সবকিছু শুনেন"],["ٱلْبَصِيرُ","l-baṣīru","the All-Seer","সবকিছুই দেখেন"]],"t":"فَاطِرُ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ ۚ جَعَلَ لَ<y>كُم مِّ</>نْ أَ<k>نفُ</>سِكُمْ أَزْ<m>وَٰ</><d>جًۭا وَ</>مِنَ <h>ٱ</>لْأَنْ<m>عَٰ</>مِ أَزْ<m>وَٰ</><d>جًۭا ۖ يَ</>ذْرَؤُكُمْ فِيهِ ۚ لَيْسَ كَمِثْلِ<m>هِۦ</> <d>شَىْءٌۭ ۖ وَ</>هُوَ <h>ٱ</><l>ل</>سَّمِيعُ <h>ٱ</>لْبَ<p>صِي</>رُ"},{"n":12,"w":[["لَهُۥ","lahu","To Him (belongs)","তাঁরই (নিয়ন্ত্রণে)"],["مَقَالِيدُ","maqālīdu","(the) keys","চাবিসমূহ"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশের"],["وَٱلْأَرْضِ ۖ","wal-arḍi","and the earth","ও পৃথিবীর"],["يَبْسُطُ","yabsuṭu","He extends","প্রশস্ত করে দেন"],["ٱلرِّزْقَ","l-riz'qa","the provision","জীবনের উপকরণ"],["لِمَن","liman","for whom","(তার) জন্যে যাকে"],["يَشَآءُ","yashāu","He wills","তিনি ইচ্ছে করেন"],["وَيَقْدِرُ ۚ","wayaqdiru","and restricts","এবং পরিমিত দেন (যাকে ইচ্ছে করেন)"],["إِنَّهُۥ","innahu","Indeed, He","তিনি নিশ্চয়ই"],["بِكُلِّ","bikulli","of every","সম্পর্কে সব"],["شَىْءٍ","shayin","thing","কিছু"],["عَلِيمٌۭ","‘alīmun","(is) All-Knower","খুব অবহিত"]],"t":"لَهُ<m>ۥ</> مَقَالِيدُ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ ۖ يَ<q>بْ</>سُطُ <h>ٱ</><l>ل</>رِّزْقَ لِ<d>مَن يَ</><o>شَآ</>ءُ وَيَ<q>قْ</>دِرُ ۚ إِ<g>نَّ</>هُ<m>ۥ</> بِكُلِّ شَىْءٍ عَ<p>لِي</>مٌۭ"},{"n":13,"w":[["۞ شَرَعَ","shara‘a","He has ordained","তিনি বিধান দিয়েছেন"],["لَكُم","lakum","for you","তোমাদের জন্যে (একমাত্র)"],["مِّنَ","mina","of","থেকে"],["ٱلدِّينِ","l-dīni","the religion","দ্বীনের"],["مَا","mā","what","যা"],["وَصَّىٰ","waṣṣā","He enjoined","আদেশ দিয়েছিলেন"],["بِهِۦ","bihi","upon","সে সম্পর্কে"],["نُوحًۭا","nūḥan","Nuh","নূহকে"],["وَٱلَّذِىٓ","wa-alladhī","and that which","এবং (হে নাবী) যা"],["أَوْحَيْنَآ","awḥaynā","We have revealed","আমরা ওহী করেছি"],["إِلَيْكَ","ilayka","to you","তোমার প্রতিও"],["وَمَا","wamā","and what","এবং যা"],["وَصَّيْنَا","waṣṣaynā","We enjoined","আমরা আদেশ দিয়েছি"],["بِهِۦٓ","bihi","upon","সে সম্পর্কে"],["إِبْرَٰهِيمَ","ib'rāhīma","Ibrahim","ইব্রাহীমকে"],["وَمُوسَىٰ","wamūsā","and Musa","ও মূসাকে"],["وَعِيسَىٰٓ ۖ","wa‘īsā","and Isa","ও ঈসাকে"],["أَنْ","an","To","(এ তাগিদসহ) যে"],["أَقِيمُوا۟","aqīmū","establish","তোমরা প্রতিষ্ঠিত করো"],["ٱلدِّينَ","l-dīna","the religion","দ্বীনকে"],["وَلَا","walā","and not","এবং না"],["تَتَفَرَّقُوا۟","tatafarraqū","be divided","তোমরা মতবিরোধ করো"],["فِيهِ ۚ","fīhi","therein","তার মধ্যে"],["كَبُرَ","kabura","Is difficult","বড় কঠিন হয়েছে"],["عَلَى","‘alā","on","কাছে"],["ٱلْمُشْرِكِينَ","l-mush'rikīna","the polytheists","মুশরিকদের"],["مَا","mā","what","যার"],["تَدْعُوهُمْ","tad‘ūhum","you call them","তুমি আহবান করছো তাদেরকে"],["إِلَيْهِ ۚ","ilayhi","to it","তাঁর দিকে"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["يَجْتَبِىٓ","yajtabī","chooses","বেছে নেন"],["إِلَيْهِ","ilayhi","for Himself","তাঁর দিকে"],["مَن","man","whom","যাকে"],["يَشَآءُ","yashāu","He wills","তিনি ইচ্ছে করেন"],["وَيَهْدِىٓ","wayahdī","and guides","এবং পথ দেখান"],["إِلَيْهِ","ilayhi","to Himself","তাঁর দিকে"],["مَن","man","whoever","যে"],["يُنِيبُ","yunību","turns","মুখ ফিরায় (তাঁর দিকে)"]],"t":"۞ شَرَعَ لَ<y>كُم مِّ</>نَ <h>ٱ</><l>ل</>دِّينِ مَا وَصَّىٰ بِ<m>هِۦ</> نُو<d>حًۭا وَ</><h>ٱ</>لَّ<o>ذِىٓ</> أَوْحَيْ<o>نَآ</> إِلَيْكَ وَمَا وَصَّيْنَا بِ<o>هِۦٓ</> إِ<q>بْ</><m>رَٰ</>هِيمَ وَمُوسَىٰ وَعِيسَ<o>ىٰٓ ۖ</> أَنْ أَقِيمُو<s>ا۟</> <h>ٱ</><l>ل</>دِّينَ وَلَا تَتَفَرَّقُو<s>ا۟</> فِيهِ ۚ كَبُرَ عَلَى <h>ٱ</>لْمُشْرِكِينَ مَا تَ<q>دْ</>عُوهُمْ إِلَيْهِ ۚ <h>ٱ</>للَّهُ يَ<q>جْ</>تَ<o>بِىٓ</> إِلَيْهِ <d>مَن يَ</><o>شَآ</>ءُ وَيَهْ<o>دِىٓ</> إِلَيْهِ <d>مَن يُ</><p>نِي</><q>بُ</>"},{"n":14,"w":[["وَمَا","wamā","And not","এবং না"],["تَفَرَّقُوٓا۟","tafarraqū","they became divided","তারা মতবিরোধ করেছে"],["إِلَّا","illā","until","এ ব্যতীত"],["مِنۢ","min","after","মধ্য হতে"],["بَعْدِ","ba‘di","after","পরে"],["مَا","mā","[what]","যা"],["جَآءَهُمُ","jāahumu","came to them","(কাছে) এসেছিলো তাদের"],["ٱلْعِلْمُ","l-‘il'mu","the knowledge","(অর্থাৎ) জ্ঞান"],["بَغْيًۢا","baghyan","(out of) rivalry","(এমন করেছে) বিদ্বেষ বশতঃ"],["بَيْنَهُمْ ۚ","baynahum","among them","তাদের মাঝে"],["وَلَوْلَا","walawlā","And if not","এবং যদি না"],["كَلِمَةٌۭ","kalimatun","(for) a word","একটি বাণী (ফায়সালার)"],["سَبَقَتْ","sabaqat","(that) preceded","অতীতে সিদ্ধান্ত করা হতো"],["مِن","min","from","পক্ষ হতে"],["رَّبِّكَ","rabbika","your Lord","তোমার রবের"],["إِلَىٰٓ","ilā","for","পর্যন্ত"],["أَجَلٍۢ","ajalin","a term","সময় (অবকাশের)"],["مُّسَمًّۭى","musamman","specified","নির্ধারিত"],["لَّقُضِىَ","laquḍiya","surely, it (would have) been settled","মীমাংসা অবশ্যই করে দেওয়া হতো"],["بَيْنَهُمْ ۚ","baynahum","between them","তাদের মাঝে"],["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যাদের"],["أُورِثُوا۟","ūrithū","were made to inherit","উত্তরাধিকারী করা হয়েছিলো"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","কিতাবের"],["مِنۢ","min","after them","মধ্য হতে"],["بَعْدِهِمْ","ba‘dihim","after them","তাদের পরে"],["لَفِى","lafī","(are) surely in","অবশ্যই মধ্যে আছে"],["شَكٍّۢ","shakkin","doubt","সন্দেহের"],["مِّنْهُ","min'hu","concerning it ","তা সম্পর্কে"],["مُرِيبٍۢ","murībin","disquieting","বিভ্রান্তিকর"]],"t":"وَمَا تَفَرَّ<o>قُوٓ</><s>ا۟</> إِلَّا <i>مِنۢ بَ</>عْدِ مَا <o>جَآ</>ءَهُمُ <h>ٱ</>لْعِلْمُ بَغْ<i>يًۢا بَ</>يْنَهُمْ ۚ وَلَوْلَا كَلِمَ<k>ةٌۭ سَ</>بَقَتْ <w>مِن رَّ</>بِّكَ إِلَ<o>ىٰٓ</> أَجَ<d>لٍۢ مُّ</>سَ<w>مًّۭى لَّ</>قُضِىَ بَيْنَهُمْ ۚ وَإِ<g>نَّ</> <h>ٱ</>لَّذِينَ أُورِثُو<s>ا۟</> <h>ٱ</>لْكِ<m>تَٰ</>بَ <i>مِنۢ بَ</>عْدِهِمْ لَفِى شَ<d>كٍّۢ مِّ</>نْهُ مُ<p>رِي</><q>بٍۢ</>"},{"n":15,"w":[["فَلِذَٰلِكَ","falidhālika","So to that","(হে নাবী) এজন্যে"],["فَٱدْعُ ۖ","fa-ud'‘u","then invite","তাই আহবান করো"],["وَٱسْتَقِمْ","wa-is'taqim","and stand firm","এবং অবিচল থাকো"],["كَمَآ","kamā","as","যেমন"],["أُمِرْتَ ۖ","umir'ta","you are commanded","তোমাকে আদেশ করা হয়েছে"],["وَلَا","walā","and (do) not","এবং না"],["تَتَّبِعْ","tattabi‘","follow","অনুসরণ করো"],["أَهْوَآءَهُمْ ۖ","ahwāahum","their desires","তাদের খেয়ালখুশীর"],["وَقُلْ","waqul","but say","এবং বলো"],["ءَامَنتُ","āmantu","I believe","\"আমি ঈমান এনেছি"],["بِمَآ","bimā","in what","ঐ বিষয়ে যা"],["أَنزَلَ","anzala","Allah has sent down","অবতীর্ণ করেছেন"],["ٱللَّهُ","l-lahu","Allah has sent down","আল্লাহ"],["مِن","min","of","থেকে"],["كِتَـٰبٍۢ ۖ","kitābin","(the) Book","(অর্থাৎ) কিতাব"],["وَأُمِرْتُ","wa-umir'tu","and I am commanded","এবং আমাকে আদেশ করা হয়েছে"],["لِأَعْدِلَ","li-a‘dila","that I do justice","আমি যেন ন্যায় বিচার করি"],["بَيْنَكُمُ ۖ","baynakumu","between you","তোমাদের মাঝে"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["رَبُّنَا","rabbunā","(is) our Lord","আমাদের রব"],["وَرَبُّكُمْ ۖ","warabbukum","and your Lord","ও তোমাদের রব"],["لَنَآ","lanā","For us","আমাদের জন্যে"],["أَعْمَـٰلُنَا","a‘mālunā","our deeds","আমাদের কাজসমূহ"],["وَلَكُمْ","walakum","and for you","ও তোমাদের জন্যে"],["أَعْمَـٰلُكُمْ ۖ","a‘mālukum","your deeds","তোমাদের কাজসমূহ"],["لَا","lā","(There is) no","নেই"],["حُجَّةَ","ḥujjata","argument","কোনো বিবাদ"],["بَيْنَنَا","baynanā","between us","আমাদের মাঝে"],["وَبَيْنَكُمُ ۖ","wabaynakumu","and between you","ও তোমাদের মাঝে"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["يَجْمَعُ","yajma‘u","will assemble","একত্র করবেন"],["بَيْنَنَا ۖ","baynanā","[between] us","আমাদেরকে"],["وَإِلَيْهِ","wa-ilayhi","and to Him","এবং তাঁরই দিকে"],["ٱلْمَصِيرُ","l-maṣīru","(is) the final return","প্রত্যাবর্তন (হবে সবার)\""]],"t":"فَلِ<m>ذَٰ</>لِكَ فَ<h>ٱ</><q>دْ</>عُ ۖ وَ<h>ٱ</>سْتَقِمْ كَ<o>مَآ</> أُمِرْتَ ۖ وَلَا تَتَّبِعْ أَهْ<o>وَآ</>ءَهُمْ ۖ وَقُلْ ءَامَ<k>نتُ</> بِ<o>مَآ</> أَ<k>نزَ</>لَ <h>ٱ</>للَّهُ مِ<k>ن كِ</><m>تَٰ</><d>بٍۢ ۖ وَ</>أُمِرْتُ لِأَعْدِلَ بَيْنَكُمُ ۖ <h>ٱ</>للَّهُ رَبُّنَا وَرَبُّكُمْ ۖ لَ<o>نَآ</> أَعْ<m>مَٰ</>لُنَا وَلَكُمْ أَعْ<m>مَٰ</>لُكُمْ ۖ لَا حُجَّةَ بَيْنَنَا وَبَيْنَكُمُ ۖ <h>ٱ</>للَّهُ يَ<q>جْ</>مَعُ بَيْنَنَا ۖ وَإِلَيْهِ <h>ٱ</>لْمَ<p>صِي</>رُ"},{"n":16,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["يُحَآجُّونَ","yuḥājjūna","argue","বিতর্ক করে"],["فِى","fī","concerning","সম্পর্কে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌র দ্বীনের"],["مِنۢ","min","after","মধ্য হতে"],["بَعْدِ","ba‘di","after","পরেও"],["مَا","mā","[what]","যা"],["ٱسْتُجِيبَ","us'tujība","response has been made to Him","সাড়া দেওয়া হয়েছে (অর্থাৎ দ্বীন গ্রহণের পরেও)"],["لَهُۥ","lahu","response has been made to Him","তাকে"],["حُجَّتُهُمْ","ḥujjatuhum","their argument","তাদের যুক্তিতর্ক"],["دَاحِضَةٌ","dāḥiḍatun","(is) invalid","নিরর্থক"],["عِندَ","‘inda","with","কাছে"],["رَبِّهِمْ","rabbihim","their Lord","তাদের রবের"],["وَعَلَيْهِمْ","wa‘alayhim","and upon them","এবং তাদের উপর"],["غَضَبٌۭ","ghaḍabun","(is) wrath","অভিসম্পাত"],["وَلَهُمْ","walahum","and for them","এবং তাদের জন্যে"],["عَذَابٌۭ","‘adhābun","(is) a punishment","শাস্তি (রয়েছে)"],["شَدِيدٌ","shadīdun","severe","কঠিন"]],"t":"وَ<h>ٱ</>لَّذِينَ يُ<n>حَآ</>جُّونَ فِى <h>ٱ</>للَّهِ <i>مِنۢ بَ</>عْدِ مَا <h>ٱ</>سْتُجِيبَ لَهُ<m>ۥ</> حُجَّتُهُمْ دَاحِضَةٌ عِ<k>ندَ</> رَبِّهِمْ وَعَلَيْهِمْ غَضَ<d>بٌۭ وَ</>لَهُمْ عَذَا<k>بٌۭ شَ</><p>دِي</><q>دٌ</>"},{"n":17,"w":[["ٱللَّهُ","al-lahu","Allah","(তিনিই) আল্লাহ্‌"],["ٱلَّذِىٓ","alladhī","(is) the One Who","যিনি"],["أَنزَلَ","anzala","(has) sent down","অবতীর্ণ করেছেন"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","কিতাব"],["بِٱلْحَقِّ","bil-ḥaqi","in truth","সত্যসহ"],["وَٱلْمِيزَانَ ۗ","wal-mīzāna","and the Balance","এবং মীযান"],["وَمَا","wamā","And what","এবং কিসে"],["يُدْرِيكَ","yud'rīka","will make you know","তোমাকে জানাবে"],["لَعَلَّ","la‘alla","Perhaps","সম্ভবতঃ"],["ٱلسَّاعَةَ","l-sā‘ata","the Hour","ক্বিয়ামাত"],["قَرِيبٌۭ","qarībun","(is) near","আসন্ন"]],"t":"ٱللَّهُ <h>ٱ</>لَّ<o>ذِىٓ</> أَ<k>نزَ</>لَ <h>ٱ</>لْكِ<m>تَٰ</>بَ بِ<h>ٱ</>لْحَقِّ وَ<h>ٱ</>لْمِيزَانَ ۗ وَمَا يُ<q>دْ</>رِيكَ لَعَلَّ <h>ٱ</><l>ل</>سَّاعَةَ قَ<p>رِي</><q>بٌۭ</>"},{"n":18,"w":[["يَسْتَعْجِلُ","yasta‘jilu","Seek to hasten","তাড়াহুড়া করে"],["بِهَا","bihā","[of] it","তা সম্পর্কে"],["ٱلَّذِينَ","alladhīna","those who","(তারাই) যারা"],["لَا","lā","(do) not","না"],["يُؤْمِنُونَ","yu'minūna","believe","ঈমান আনে"],["بِهَا ۖ","bihā","in it","তা সম্পর্কে"],["وَٱلَّذِينَ","wa-alladhīna","and those who","কিন্তু যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["مُشْفِقُونَ","mush'fiqūna","(are) fearful","তারা ভয় করে"],["مِنْهَا","min'hā","of it","তা থেকে"],["وَيَعْلَمُونَ","waya‘lamūna","and know","এবং তারা জানে"],["أَنَّهَا","annahā","that it","তা যে"],["ٱلْحَقُّ ۗ","l-ḥaqu","(is) the truth","মহাসত্য"],["أَلَآ","alā","Unquestionably","জেনে রাখো"],["إِنَّ","inna","indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["يُمَارُونَ","yumārūna","dispute","কুতর্ক করে"],["فِى","fī","concerning","সম্পর্কে"],["ٱلسَّاعَةِ","l-sā‘ati","the Hour","ক্বিয়ামাতের"],["لَفِى","lafī","(are) certainly in","অবশ্যই মধ্যে"],["ضَلَـٰلٍۭ","ḍalālin","error","বিভ্রান্তির"],["بَعِيدٍ","ba‘īdin","far","বহুদূরে (চলে গিয়েছে)"]],"t":"يَسْتَعْجِلُ بِهَا <h>ٱ</>لَّذِينَ لَا يُؤْمِنُونَ بِهَا ۖ وَ<h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> مُشْفِقُونَ مِنْهَا وَيَعْلَمُونَ أَ<g>نَّ</>هَا <h>ٱ</>لْحَقُّ ۗ أَ<o>لَآ</> إِ<g>نَّ</> <h>ٱ</>لَّذِينَ يُمَارُونَ فِى <h>ٱ</><l>ل</>سَّاعَةِ لَفِى ضَ<m>لَٰ</><i>لٍۭ بَ</><p>عِي</><q>دٍ</>"},{"n":19,"w":[["ٱللَّهُ","al-lahu","Allah","আল্লাহ্‌"],["لَطِيفٌۢ","laṭīfun","(is) Subtle","অতি দয়ালু"],["بِعِبَادِهِۦ","bi‘ibādihi","with His slaves","তার দাসদের উপর"],["يَرْزُقُ","yarzuqu","He gives provision","তিনি জীবিকা দান করেন"],["مَن","man","(to) whom","যাকে"],["يَشَآءُ ۖ","yashāu","He wills","ইচ্ছে করেন"],["وَهُوَ","wahuwa","And He","এবং তিনি"],["ٱلْقَوِىُّ","l-qawiyu","(is) the All-Strong","প্রবল শক্তিমান"],["ٱلْعَزِيزُ","l-‘azīzu","the All-Mighty","পরাক্রমশালী"]],"t":"ٱللَّهُ لَطِي<i>فٌۢ بِ</>عِبَادِ<m>هِۦ</> يَرْزُقُ <d>مَن يَ</><o>شَآ</>ءُ ۖ وَهُوَ <h>ٱ</>لْقَوِىُّ <h>ٱ</>لْعَ<p>زِي</>زُ"},{"n":20,"w":[["مَن","man","Whoever","যে"],["كَانَ","kāna","is","ছিল"],["يُرِيدُ","yurīdu","desiring","কামনা করে"],["حَرْثَ","ḥartha","(the) harvest","ফসল"],["ٱلْـَٔاخِرَةِ","l-ākhirati","(of) the Hereafter ","পরকালের"],["نَزِدْ","nazid","We increase","বাড়িয়ে দিই আমরা"],["لَهُۥ","lahu","for him","তার জন্যে"],["فِى","fī","in","মধ্যে"],["حَرْثِهِۦ ۖ","ḥarthihi","his harvest","তার ফসলের"],["وَمَن","waman","And whoever","এবং যে"],["كَانَ","kāna","is","ছিল"],["يُرِيدُ","yurīdu","desiring","কামনা করে"],["حَرْثَ","ḥartha","(the) harvest","ফসল"],["ٱلدُّنْيَا","l-dun'yā","(of) the world","দুনিয়ার"],["نُؤْتِهِۦ","nu'tihi","We give him","তাকে দিই আমরা"],["مِنْهَا","min'hā","of it","তা থেকে কিছু"],["وَمَا","wamā","but not","এবং নেই"],["لَهُۥ","lahu","for him","তার জন্যে"],["فِى","fī","in","মধ্যে"],["ٱلْـَٔاخِرَةِ","l-ākhirati","the Hereafter","পরকালের"],["مِن","min","any","কোনো"],["نَّصِيبٍ","naṣībin","share","অংশ"]],"t":"مَ<k>ن كَ</>انَ يُرِيدُ حَرْثَ <h>ٱ</>لْءَاخِرَةِ نَزِ<q>دْ</> لَهُ<m>ۥ</> فِى حَرْثِ<m>هِۦ</> ۖ وَمَ<k>ن كَ</>انَ يُرِيدُ حَرْثَ <h>ٱ</><l>ل</>دُّنْيَا نُؤْتِ<m>هِۦ</> مِنْهَا وَمَا لَهُ<m>ۥ</> فِى <h>ٱ</>لْءَاخِرَةِ <d>مِن نَّ</><p>صِي</><q>بٍ</>"},{"n":21,"w":[["أَمْ","am","Or","তবে কি"],["لَهُمْ","lahum","for them","তাদের জন্যে আছে"],["شُرَكَـٰٓؤُا۟","shurakāu","(are) partners","(কতক) শরিক"],["شَرَعُوا۟","shara‘ū","who have ordained","(যারা) বিধান দিয়েছে"],["لَهُم","lahum","for them","তাদের জন্যে (ভিন্ন কিছু)"],["مِّنَ","mina","of","থেকে"],["ٱلدِّينِ","l-dīni","the religion","ধর্মের"],["مَا","mā","what","যার"],["لَمْ","lam","not","না"],["يَأْذَنۢ","yadhan","Allah has given permission of it","অনুমতি দেন নি"],["بِهِ","bihi","Allah has given permission of it","সে সম্পর্কে"],["ٱللَّهُ ۚ","l-lahu","Allah has given permission of it","আল্লাহ"],["وَلَوْلَا","walawlā","And if not","এবং যদি না (নির্ধারিত হতো)"],["كَلِمَةُ","kalimatu","(for) a word","একটি কথা"],["ٱلْفَصْلِ","l-faṣli","decisive","মীমাংসার"],["لَقُضِىَ","laquḍiya","surely, it (would have) been judged","চুড়ান্ত করে দেওয়া হতো অবশ্যই"],["بَيْنَهُمْ ۗ","baynahum","between them","তাদের মাঝে"],["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","সীমালঙ্ঘনকারীরা"],["لَهُمْ","lahum","for them","তাদের জন্যে (রয়েছে)"],["عَذَابٌ","‘adhābun","(is a) punishment","শাস্তি"],["أَلِيمٌۭ","alīmun","painful","যন্ত্রণাদায়ক"]],"t":"أَمْ لَهُمْ شُرَ<o>كَٰٓ</>ؤُ<s>ا۟</> شَرَعُو<s>ا۟</> لَ<y>هُم مِّ</>نَ <h>ٱ</><l>ل</>دِّينِ مَا لَمْ يَأْ<i>ذَنۢ بِ</>هِ <h>ٱ</>للَّهُ ۚ وَلَوْلَا كَلِمَةُ <h>ٱ</>لْفَصْلِ لَقُضِىَ بَيْنَهُمْ ۗ وَإِ<g>نَّ</> <h>ٱ</><l>ل</><m>ظَّٰ</>لِمِينَ لَهُمْ عَذَابٌ أَ<p>لِي</>مٌۭ"},{"n":22,"w":[["تَرَى","tarā","You will see","দেখবে তুমি"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","সীমালঙ্ঘনকারীদেরকে"],["مُشْفِقِينَ","mush'fiqīna","fearful","ভীত অবস্থায়"],["مِمَّا","mimmā","of what","ঐ বিষয়ে যা"],["كَسَبُوا۟","kasabū","they earned","তারা কামাই করেছে"],["وَهُوَ","wahuwa","and it","এবং তা"],["وَاقِعٌۢ","wāqi‘un","(will) befall","পতিত হবেই"],["بِهِمْ ۗ","bihim","[on] them","তাদের উপর"],["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["وَعَمِلُوا۟","wa‘amilū","and do","ও কাজ করেছে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","righteous deeds","সৎ"],["فِى","fī","(will be) in","মধ্যে (হবে)"],["رَوْضَاتِ","rawḍāti","flowering meadows","বাগানসমূহের"],["ٱلْجَنَّاتِ ۖ","l-janāti","(of) the Gardens","জান্নাতের"],["لَهُم","lahum","for them","তাদের জন্যে রয়েছে"],["مَّا","mā","(is) whatever","যা"],["يَشَآءُونَ","yashāūna","they wish","তারা ইচ্ছে করবে"],["عِندَ","‘inda","with","কাছে"],["رَبِّهِمْ ۚ","rabbihim","their Lord","তাদের রবের"],["ذَٰلِكَ","dhālika","That ","এটাই"],["هُوَ","huwa","it","সেই"],["ٱلْفَضْلُ","l-faḍlu","(is) the Bounty","অনুগ্রহ"],["ٱلْكَبِيرُ","l-kabīru","the Great","মহা"]],"t":"تَرَى <h>ٱ</><l>ل</><m>ظَّٰ</>لِمِينَ مُشْفِقِينَ مِ<g>مَّ</>ا كَسَبُو<s>ا۟</> وَهُوَ وَاقِ<i>عٌۢ بِ</>هِمْ ۗ وَ<h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ فِى رَوْضَاتِ <h>ٱ</>لْجَ<g>نَّ</>اتِ ۖ لَ<y>هُم مَّ</>ا يَ<o>شَآ</>ءُونَ عِ<k>ندَ</> رَبِّهِمْ ۚ <m>ذَٰ</>لِكَ هُوَ <h>ٱ</>لْفَضْلُ <h>ٱ</>لْكَ<p>بِي</>رُ"},{"n":23,"w":[["ذَٰلِكَ","dhālika","That","এটাই"],["ٱلَّذِى","alladhī","(is of) which","যার"],["يُبَشِّرُ","yubashiru","Allah gives glad tidings","সুসংবাদ দিয়েছেন"],["ٱللَّهُ","l-lahu","Allah gives glad tidings","আল্লাহ"],["عِبَادَهُ","‘ibādahu","(to) His slaves ","তাঁর দাসদেরকে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["وَعَمِلُوا۟","wa‘amilū","and do","ও কাজ করেছে"],["ٱلصَّـٰلِحَـٰتِ ۗ","l-ṣāliḥāti","righteous deeds","সৎ"],["قُل","qul","Say","(হে নাবী) বলো"],["لَّآ","lā","Not","\"না"],["أَسْـَٔلُكُمْ","asalukum","I ask you","তোমাদের কাছে চাই আমি"],["عَلَيْهِ","‘alayhi","for it","তার উপর"],["أَجْرًا","ajran","any payment","কোনো পারিশ্রমিক"],["إِلَّا","illā","except","কিন্তু"],["ٱلْمَوَدَّةَ","l-mawadata","the love","ভালোবাসা"],["فِى","fī","among","আছে"],["ٱلْقُرْبَىٰ ۗ","l-qur'bā","the relatives","আত্মীয়ের\""],["وَمَن","waman","And whoever","এবং যে"],["يَقْتَرِفْ","yaqtarif","earns","অর্জন করবে"],["حَسَنَةًۭ","ḥasanatan","any good","ভালো কাজ"],["نَّزِدْ","nazid","We increase","বাড়িয়ে দিই আমরা"],["لَهُۥ","lahu","for him","তার জন্যে"],["فِيهَا","fīhā","therein","তার মধ্যে"],["حُسْنًا ۚ","ḥus'nan","good","কল্যাণ"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["غَفُورٌۭ","ghafūrun","(is) Oft-Forgiving","ক্ষমাশীল"],["شَكُورٌ","shakūrun","All-Appreciative","গুণগ্রাহী"]],"t":"<m>ذَٰ</>لِكَ <h>ٱ</>لَّذِى يُبَشِّرُ <h>ٱ</>للَّهُ عِبَادَهُ <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ ۗ قُل <o>لَّآ</> أَسْـَٔلُكُمْ عَلَيْهِ أَ<q>جْ</>رًا إِلَّا <h>ٱ</>لْمَوَدَّةَ فِى <h>ٱ</>لْقُرْبَىٰ ۗ وَ<d>مَن يَ</><q>قْ</>تَرِفْ حَسَنَ<d>ةًۭ نَّ</>زِ<q>دْ</> لَهُ<m>ۥ</> فِيهَا حُسْنًا ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ غَفُو<k>رٌۭ شَ</><p>كُو</>رٌ"},{"n":24,"w":[["أَمْ","am","Or","তবে কি"],["يَقُولُونَ","yaqūlūna","(do) they say","(এই লোকেরা) বলে"],["ٱفْتَرَىٰ","if'tarā","He has invented","\"সে রচনা করেছে"],["عَلَى","‘alā","about","উপর"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["كَذِبًۭا ۖ","kadhiban","a lie","মিথ্যা\""],["فَإِن","fa-in","But if","তবে যদি"],["يَشَإِ","yasha-i","Allah willed","ইচ্ছে করতেন"],["ٱللَّهُ","l-lahu","Allah willed","আল্লাহ"],["يَخْتِمْ","yakhtim","He would seal","সীল করে দিতেন"],["عَلَىٰ","‘alā","[over]","উপর"],["قَلْبِكَ ۗ","qalbika","your heart","তোমার অন্তরের"],["وَيَمْحُ","wayamḥu","And Allah eliminates","আর মুছে দেন"],["ٱللَّهُ","l-lahu","And Allah eliminates","আল্লাহ"],["ٱلْبَـٰطِلَ","l-bāṭila","the falsehood","অসত্যকে"],["وَيُحِقُّ","wayuḥiqqu","and establishes","এবং প্রতিষ্ঠিত করেন"],["ٱلْحَقَّ","l-ḥaqa","the truth","সত্যকে"],["بِكَلِمَـٰتِهِۦٓ ۚ","bikalimātihi","by His Words","তাঁর বাণী দিয়ে"],["إِنَّهُۥ","innahu","Indeed, He","তিনি নিশ্চয়ই"],["عَلِيمٌۢ","‘alīmun","(is) All-Knowing","খুব অবহিত"],["بِذَاتِ","bidhāti","of what","অবস্থা সম্পর্কে"],["ٱلصُّدُورِ","l-ṣudūri","(is in) the breasts","অন্তরসমূহের"]],"t":"أَمْ يَقُولُونَ <h>ٱ</>فْتَرَىٰ عَلَى <h>ٱ</>للَّهِ كَذِ<k>بًۭا ۖ فَ</><d>إِن يَ</>شَإِ <h>ٱ</>للَّهُ يَخْتِمْ عَلَىٰ قَلْبِكَ ۗ وَيَمْحُ <h>ٱ</>للَّهُ <h>ٱ</>لْ<m>بَٰ</>طِلَ وَيُحِقُّ <h>ٱ</>لْحَقَّ بِكَلِ<m>مَٰ</>تِ<o>هِۦٓ ۚ</> إِ<g>نَّ</>هُ<m>ۥ</> عَلِي<i>مٌۢ بِ</>ذَاتِ <h>ٱ</><l>ل</>صُّ<p>دُو</>رِ"},{"n":25,"w":[["وَهُوَ","wahuwa","And He","এবং তিনিই (আল্লাহ)"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["يَقْبَلُ","yaqbalu","accepts","কবুল করেন"],["ٱلتَّوْبَةَ","l-tawbata","the repentance","তওবা"],["عَنْ","‘an","of","থেকে"],["عِبَادِهِۦ","‘ibādihi","His slaves","তাঁর দাসদের"],["وَيَعْفُوا۟","waya‘fū","and pardons","এবং মোচন করেন"],["عَنِ","‘ani","[of]","থেকে"],["ٱلسَّيِّـَٔاتِ","l-sayiāti","the evil","পাপসমূহ"],["وَيَعْلَمُ","waya‘lamu","and He knows","অথচ তিনি জানেন"],["مَا","mā","what","যা কিছু"],["تَفْعَلُونَ","taf‘alūna","you do","তোমরা করছো"]],"t":"وَهُوَ <h>ٱ</>لَّذِى يَ<q>قْ</>بَلُ <h>ٱ</><l>ل</>تَّوْبَةَ عَنْ عِبَادِ<m>هِۦ</> وَيَعْفُو<s>ا۟</> عَنِ <h>ٱ</><l>ل</>سَّيِّـَٔاتِ وَيَعْلَمُ مَا تَفْعَ<p>لُو</>نَ"},{"n":26,"w":[["وَيَسْتَجِيبُ","wayastajību","And He answers","এবং তিনি ডাকে সাড়া দেন"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান আনে"],["وَعَمِلُوا۟","wa‘amilū","and do","ও কাজ করে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","righteous deeds","সৎ"],["وَيَزِيدُهُم","wayazīduhum","and increases (for) them","এবং বৃদ্ধি করেন তাদেরকে"],["مِّن","min","from","হ'তে"],["فَضْلِهِۦ ۚ","faḍlihi","His Bounty","তাঁর অনুগ্রহ"],["وَٱلْكَـٰفِرُونَ","wal-kāfirūna","And the disbelievers ","এবং কাফেরদের (অবস্থা হলো)"],["لَهُمْ","lahum","for them","তাদের জন্যে রয়েছে"],["عَذَابٌۭ","‘adhābun","(will be) a punishment","শাস্তি"],["شَدِيدٌۭ","shadīdun","severe","কঠিন"]],"t":"وَيَسْتَجِيبُ <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ وَيَزِيدُ<y>هُم مِّ</><k>ن فَ</>ضْلِ<m>هِۦ</> ۚ وَ<h>ٱ</>لْ<m>كَٰ</>فِرُونَ لَهُمْ عَذَا<k>بٌۭ شَ</><p>دِي</><q>دٌۭ</>"},{"n":27,"w":[["۞ وَلَوْ","walaw","And if","এবং যদি"],["بَسَطَ","basaṭa","Allah extends","প্রচুর দিতেন"],["ٱللَّهُ","l-lahu","Allah extends","আল্লাহ"],["ٱلرِّزْقَ","l-riz'qa","the provision","জীবিকা"],["لِعِبَادِهِۦ","li‘ibādihi","for His slaves","তাঁর দাসদের জন্যে"],["لَبَغَوْا۟","labaghaw","surely they would rebel","তারা অবশ্যই বিপর্যয় সৃষ্টি করতো"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["وَلَـٰكِن","walākin","but","কিন্তু"],["يُنَزِّلُ","yunazzilu","He sends down","দেন"],["بِقَدَرٍۢ","biqadarin","in (due) measure","একটি পরিমাণ মত"],["مَّا","mā","what","যা"],["يَشَآءُ ۚ","yashāu","He wills","তিনি ইচ্ছে করেন"],["إِنَّهُۥ","innahu","Indeed, He","নিশ্চয়ই তিনি"],["بِعِبَادِهِۦ","bi‘ibādihi","of His slaves","তাঁর দাসদের সম্পর্কে"],["خَبِيرٌۢ","khabīrun","(is) All-Aware","খুব অবহিত"],["بَصِيرٌۭ","baṣīrun","All-Seer","সবকিছুই দেখেন"]],"t":"۞ وَلَوْ بَسَطَ <h>ٱ</>للَّهُ <h>ٱ</><l>ل</>رِّزْقَ لِعِبَادِ<m>هِۦ</> لَبَغَوْ<s>ا۟</> فِى <h>ٱ</>لْأَرْضِ وَ<m>لَٰ</><d>كِن يُ</>نَزِّلُ بِقَدَ<d>رٍۢ مَّ</>ا يَ<o>شَآ</>ءُ ۚ إِ<g>نَّ</>هُ<m>ۥ</> بِعِبَادِ<m>هِۦ</> خَبِي<i>رٌۢ بَ</><p>صِي</>رٌۭ"},{"n":28,"w":[["وَهُوَ","wahuwa","And He","এবং তিনিই(আল্লাহ)"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["يُنَزِّلُ","yunazzilu","sends down","বর্ষণ করেন"],["ٱلْغَيْثَ","l-ghaytha","the rain","বৃষ্টি"],["مِنۢ","min","after","মধ্য হতে"],["بَعْدِ","ba‘di","after","পরে"],["مَا","mā","[what]","যখন"],["قَنَطُوا۟","qanaṭū","they have despaired","তারা নিরাশ হয়"],["وَيَنشُرُ","wayanshuru","and spreads","এবং বিস্তার করেন"],["رَحْمَتَهُۥ ۚ","raḥmatahu","His mercy","তাঁর করুণা"],["وَهُوَ","wahuwa","And He","এবং তিনিই"],["ٱلْوَلِىُّ","l-waliyu","(is) the Protector","অভিভাবক (ওলী)"],["ٱلْحَمِيدُ","l-ḥamīdu","the Praiseworthy","প্রশংসিত"]],"t":"وَهُوَ <h>ٱ</>لَّذِى يُنَزِّلُ <h>ٱ</>لْغَيْثَ <i>مِنۢ بَ</>عْدِ مَا قَنَطُو<s>ا۟</> وَيَ<k>نشُ</>رُ رَحْمَتَهُ<m>ۥ</> ۚ وَهُوَ <h>ٱ</>لْوَلِىُّ <h>ٱ</>لْحَ<p>مِي</><q>دُ</>"},{"n":29,"w":[["وَمِنْ","wamin","And among","এবং মধ্য হ'তে (রয়েছে)"],["ءَايَـٰتِهِۦ","āyātihi","His Signs","তাঁর নিদর্শনাবলীর"],["خَلْقُ","khalqu","(is the) creation","সৃষ্টি"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশের"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীর"],["وَمَا","wamā","and whatever","এবং যা কিছু"],["بَثَّ","batha","He has dispersed","ছড়িয়ে দিয়েছেন"],["فِيهِمَا","fīhimā","in both of them","তার উভয়ের মধ্যে"],["مِن","min","of","(বিভিন্ন) ধরণের"],["دَآبَّةٍۢ ۚ","dābbatin","(the) creatures","জীবজন্তু"],["وَهُوَ","wahuwa","And He","এবং তিনি"],["عَلَىٰ","‘alā","(is) over","উপর"],["جَمْعِهِمْ","jam‘ihim","their gathering","তাদের একত্রিত করার"],["إِذَا","idhā","when","যখন"],["يَشَآءُ","yashāu","He wills","তিনি ইচ্ছে করবেন"],["قَدِيرٌۭ","qadīrun","All-Powerful","সক্ষম"]],"t":"وَمِنْ ءَا<m>يَٰتِهِۦ</> خَلْقُ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ وَمَا بَثَّ فِيهِمَا مِ<k>ن دَ</><n>آ</>بَّ<d>ةٍۢ ۚ وَ</>هُوَ عَلَىٰ جَمْعِهِمْ إِذَا يَ<o>شَآ</>ءُ قَ<p>دِي</>رٌۭ"},{"n":30,"w":[["وَمَآ","wamā","And whatever","এবং যা"],["أَصَـٰبَكُم","aṣābakum","befalls you","তোমাদের পৌঁছে"],["مِّن","min","of","কোনো"],["مُّصِيبَةٍۢ","muṣībatin","(the) misfortune","বিপদ"],["فَبِمَا","fabimā","(is because) of what","তা এ কারণে যা"],["كَسَبَتْ","kasabat","have earned","কামাই করেছে"],["أَيْدِيكُمْ","aydīkum","your hands","তোমাদের হাতগুলো"],["وَيَعْفُوا۟","waya‘fū","But He pardons","এবং তিনি ক্ষমা করেন"],["عَن","‘an","[from]","থেকে"],["كَثِيرٍۢ","kathīrin","much","অনেককিছু (নিজের থেকে)"]],"t":"وَ<o>مَآ</> أَ<m>صَٰ</>بَ<y>كُم مِّ</><d>ن مُّ</>صِيبَ<k>ةٍۢ فَ</>بِمَا كَسَبَتْ أَيْدِيكُمْ وَيَعْفُو<s>ا۟</> عَ<k>ن كَ</><p>ثِي</>رٍۢ"},{"n":31,"w":[["وَمَآ","wamā","And not","এবং নও"],["أَنتُم","antum","you","তোমরা"],["بِمُعْجِزِينَ","bimu‘'jizīna","(can) escape","অক্ষমকারী (আল্লাহকে)"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ ۖ","l-arḍi","the earth","পৃথিবীর"],["وَمَا","wamā","and not","আর নেই (আছে)"],["لَكُم","lakum","for you","তোমাদের জন্যে"],["مِّن","min","besides","থেকে"],["دُونِ","dūni","besides","ছাড়া"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["مِن","min","any","কোনো"],["وَلِىٍّۢ","waliyyin","protector","অভিভাবক"],["وَلَا","walā","and not","আর নেই"],["نَصِيرٍۢ","naṣīrin","any helper","কোন সাহায্যকারী"]],"t":"وَ<o>مَآ</> أَ<k>نتُ</><f>م بِ</>مُعْجِزِينَ فِى <h>ٱ</>لْأَرْضِ ۖ وَمَا لَ<y>كُم مِّ</><k>ن دُ</>ونِ <h>ٱ</>للَّهِ <d>مِن وَلِىٍّۢ وَ</>لَا نَ<p>صِي</>رٍۢ"},{"n":32,"w":[["وَمِنْ","wamin","And among","এবং মধ্যে রয়েছে"],["ءَايَـٰتِهِ","āyātihi","His Signs","তাঁর নিদর্শনাবলী"],["ٱلْجَوَارِ","l-jawāri","(are) the ships","নৌযানসমূহ"],["فِى","fī","in","মধ্যে"],["ٱلْبَحْرِ","l-baḥri","the sea","সাগরের"],["كَٱلْأَعْلَـٰمِ","kal-a‘lāmi","like [the] mountains","পাহাড়ের মতো"]],"t":"وَمِنْ ءَا<m>يَٰ</>تِهِ <h>ٱ</>لْجَوَارِ فِى <h>ٱ</>لْبَحْرِ كَ<h>ٱ</>لْأَعْ<p>لَٰ</>مِ"},{"n":33,"w":[["إِن","in","If","যদি"],["يَشَأْ","yasha","He wills","ইচ্ছে করেন তিনি"],["يُسْكِنِ","yus'kini","He can cause the wind to become still","(থামিয়ে দিবেন) ধরে রাখবেন"],["ٱلرِّيحَ","l-rīḥa","He can cause the wind to become still","বাতাসকে"],["فَيَظْلَلْنَ","fayaẓlalna","then they would remain","ফলে তা হয়ে যাবে"],["رَوَاكِدَ","rawākida","motionless","নিশ্চল"],["عَلَىٰ","‘alā","on","উপর"],["ظَهْرِهِۦٓ ۚ","ẓahrihi","its back","তার উপরিভাগের"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে রয়েছে"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَـٰتٍۢ","laāyātin","surely (are) Signs","অবশ্যই নিদর্শনাবলী"],["لِّكُلِّ","likulli","for everyone","জন্যে প্রত্যেক"],["صَبَّارٍۢ","ṣabbārin","patient","পূর্ণ ধৈর্য্যশীলের"],["شَكُورٍ","shakūrin","(and) grateful","কৃতজ্ঞতা প্রকাশকারীর"]],"t":"<d>إِن يَ</>شَأْ يُسْكِنِ <h>ٱ</><l>ل</>رِّيحَ فَيَظْلَلْنَ رَوَاكِدَ عَلَىٰ ظَهْرِ<o>هِۦٓ ۚ</> إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَا<m>يَٰ</><w>تٍۢ لِّ</>كُلِّ صَبَّا<k>رٍۢ شَ</><p>كُو</>رٍ"},{"n":34,"w":[["أَوْ","aw","Or","বা"],["يُوبِقْهُنَّ","yūbiq'hunna","He could destroy them","সেগুলো (ডুবিয়ে দিতে) ধ্বংস করতে পারেন"],["بِمَا","bimā","for what","এ কারণে যা"],["كَسَبُوا۟","kasabū","they have earned","তারা কামাই করেছে"],["وَيَعْفُ","waya‘fu","but He pardons","এ অবস্থায় যখন মাফ করেও দেন"],["عَن","‘an","[from]","থেকে"],["كَثِيرٍۢ","kathīrin","much","অনেক কিছু"]],"t":"أَوْ يُوبِ<q>قْ</>هُ<g>نَّ</> بِمَا كَسَبُو<s>ا۟</> وَيَعْفُ عَ<k>ن كَ</><p>ثِي</>رٍۢ"},{"n":35,"w":[["وَيَعْلَمَ","waya‘lama","And may know","এবং (তখন) জানতে পারবে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["يُجَـٰدِلُونَ","yujādilūna","dispute","বিতর্ক করে"],["فِىٓ","fī","concerning","সম্পর্কে"],["ءَايَـٰتِنَا","āyātinā","Our Signs","আমাদের নিদর্শনাবলী"],["مَا","mā","(that) not","নেই"],["لَهُم","lahum","for them","তাদের জন্যে"],["مِّن","min","any","কোনো"],["مَّحِيصٍۢ","maḥīṣin","place of refuge","আশ্রয়স্থল"]],"t":"وَيَعْلَمَ <h>ٱ</>لَّذِينَ يُ<m>جَٰ</>دِلُونَ <o>فِىٓ</> ءَا<m>يَٰ</>تِنَا مَا لَ<y>هُم مِّ</><d>ن مَّ</><p>حِي</>صٍۢ"},{"n":36,"w":[["فَمَآ","famā","So whatever","বস্তুতঃ যা"],["أُوتِيتُم","ūtītum","you are given","তোমাদের দেওয়া হয়েছে"],["مِّن","min","of","কোনো"],["شَىْءٍۢ","shayin","a thing","কিছু"],["فَمَتَـٰعُ","famatā‘u","(is) but a passing enjoyment","তা ভোগসামগ্রী"],["ٱلْحَيَوٰةِ","l-ḥayati","(for) the life","জীবনের"],["ٱلدُّنْيَا ۖ","l-dun'yā","(of) the world","পার্থিব"],["وَمَا","wamā","But what","এবং যা কিছূ"],["عِندَ","‘inda","(is) with","কাছে আছে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["خَيْرٌۭ","khayrun","(is) better","(তাই) উত্তম"],["وَأَبْقَىٰ","wa-abqā","and more lasting","এবং অধিক স্থায়ী"],["لِلَّذِينَ","lilladhīna","for those who","(তাদের) জন্যে যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["وَعَلَىٰ","wa‘alā","and upon","এবং উপর"],["رَبِّهِمْ","rabbihim","their Lord","তাদের রবের"],["يَتَوَكَّلُونَ","yatawakkalūna","put (their) trust","তারা নির্ভর করে"]],"t":"فَ<o>مَآ</> أُوتِي<y>تُم مِّ</><k>ن شَىْءٍۢ فَ</>مَ<m>تَٰ</>عُ <h>ٱ</>لْحَيَ<s>وٰ</>ةِ <h>ٱ</><l>ل</>دُّنْيَا ۖ وَمَا عِ<k>ندَ</> <h>ٱ</>للَّهِ خَيْ<d>رٌۭ وَ</>أَ<q>بْ</>قَىٰ لِلَّذِينَ ءَامَنُو<s>ا۟</> وَعَلَىٰ رَبِّهِمْ يَتَوَكَّ<p>لُو</>نَ"},{"n":37,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["يَجْتَنِبُونَ","yajtanibūna","avoid","বেঁচে থাকে"],["كَبَـٰٓئِرَ","kabāira","(the) greater","গুরুতর"],["ٱلْإِثْمِ","l-ith'mi","sins","পাপ"],["وَٱلْفَوَٰحِشَ","wal-fawāḥisha","and the immoralities","ও অশ্লীল কার্য সমূহ (হ'তে)"],["وَإِذَا","wa-idhā","and when","এবং যখন"],["مَا","mā","and when","যা"],["غَضِبُوا۟","ghaḍibū","they are angry","তারা রাগান্বিত হয়"],["هُمْ","hum","they","তারা"],["يَغْفِرُونَ","yaghfirūna","forgive","মাফ করে দেয়"]],"t":"وَ<h>ٱ</>لَّذِينَ يَ<q>جْ</>تَنِبُونَ كَ<o>بَٰٓ</>ئِرَ <h>ٱ</>لْإِثْمِ وَ<h>ٱ</>لْفَ<m>وَٰ</>حِشَ وَإِذَا مَا غَضِبُو<s>ا۟</> هُمْ يَغْفِ<p>رُو</>نَ"},{"n":38,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["ٱسْتَجَابُوا۟","is'tajābū","respond","সাড়া দেয় ডাকে"],["لِرَبِّهِمْ","lirabbihim","to their Lord","তাদের রবের"],["وَأَقَامُوا۟","wa-aqāmū","and establish","প্রতিষ্ঠা করে"],["ٱلصَّلَوٰةَ","l-ṣalata","prayer","সালাত"],["وَأَمْرُهُمْ","wa-amruhum","and their affairs","এবং তাদের কাজ (সম্পন্ন করে)"],["شُورَىٰ","shūrā","(are conducted by) consultation","পরামর্শেরর মাধ্যমে"],["بَيْنَهُمْ","baynahum","among them","তাদের মাঝে"],["وَمِمَّا","wamimmā","and from what","এবং তা হতে যা"],["رَزَقْنَـٰهُمْ","razaqnāhum","We have provided them","তাদের আমরা জীবিকা দিয়েছি"],["يُنفِقُونَ","yunfiqūna","they spend","তারা ব্যয় করে"]],"t":"وَ<h>ٱ</>لَّذِينَ <h>ٱ</>سْتَجَابُو<s>ا۟</> لِرَبِّهِمْ وَأَقَامُو<s>ا۟</> <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةَ وَأَمْرُهُمْ شُورَىٰ بَيْنَهُمْ وَمِ<g>مَّ</>ا رَزَ<q>قْ</><m>نَٰ</>هُمْ يُ<k>نفِ</><p>قُو</>نَ"},{"n":39,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা (এমন যে)"],["إِذَآ","idhā","when","যখন"],["أَصَابَهُمُ","aṣābahumu","strikes them","তাদের পৌঁছে"],["ٱلْبَغْىُ","l-baghyu","tyranny","নির্যাতন (বাড়াবাড়ি)"],["هُمْ","hum","they","তারা"],["يَنتَصِرُونَ","yantaṣirūna","defend themselves","প্রতিশোধ গ্রহণ করে (মোকাবেলা করে)"]],"t":"وَ<h>ٱ</>لَّذِينَ إِ<o>ذَآ</> أَصَابَهُمُ <h>ٱ</>لْبَغْىُ هُمْ يَ<k>نتَ</>صِ<p>رُو</>نَ"},{"n":40,"w":[["وَجَزَٰٓؤُا۟","wajazāu","(The) recompense","এবং প্রতিফল"],["سَيِّئَةٍۢ","sayyi-atin","(of) an evil","মন্দের"],["سَيِّئَةٌۭ","sayyi-atun","(is) an evil","মন্দ"],["مِّثْلُهَا ۖ","mith'luhā","like it","তার সমান"],["فَمَنْ","faman","But whoever","তবে যে"],["عَفَا","‘afā","pardons","ক্ষমা করবে"],["وَأَصْلَحَ","wa-aṣlaḥa","and makes reconciliation","ও আপোষ  নিষ্পত্তি করবে"],["فَأَجْرُهُۥ","fa-ajruhu","then his reward","তবে তার পুরষ্কার (রয়েছে)"],["عَلَى","‘alā","(is) on","কাছে"],["ٱللَّهِ ۚ","l-lahi","Allah","আল্লাহর"],["إِنَّهُۥ","innahu","Indeed, He","তিনি নিশ্চয়ই"],["لَا","lā","(does) not","না"],["يُحِبُّ","yuḥibbu","like","ভালোবাসেন"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","সীমালঙ্ঘনকারীদেরকে"]],"t":"وَجَ<o>زَٰٓ</>ؤُ<s>ا۟</> سَيِّئَ<k>ةٍۢ سَ</>يِّئَ<d>ةٌۭ مِّ</>ثْلُهَا ۖ فَمَنْ عَفَا وَأَصْلَحَ فَأَ<q>جْ</>رُهُ<m>ۥ</> عَلَى <h>ٱ</>للَّهِ ۚ إِ<g>نَّ</>هُ<m>ۥ</> لَا يُحِبُّ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":41,"w":[["وَلَمَنِ","walamani","And surely whosoever","এবং অবশ্য যে"],["ٱنتَصَرَ","intaṣara","defends himself","প্রতিশোধ নেয়"],["بَعْدَ","ba‘da","after","পরে"],["ظُلْمِهِۦ","ẓul'mihi","he has been wronged","তার নির্যাতনের"],["فَأُو۟لَـٰٓئِكَ","fa-ulāika","then those","তাদের তবে"],["مَا","mā","not","নেই"],["عَلَيْهِم","‘alayhim","(is) against them","তাদের বিরুদ্ধে"],["مِّن","min","any","কোনো"],["سَبِيلٍ","sabīlin","way","ব্যবস্থা"]],"t":"وَلَمَنِ <h>ٱ</><k>نتَ</>صَرَ بَعْدَ ظُلْمِ<m>هِۦ</> فَأُ<s>و۟</><o>لَٰٓ</>ئِكَ مَا عَلَيْ<y>هِم مِّ</><k>ن سَ</><p>بِي</>لٍ"},{"n":42,"w":[["إِنَّمَا","innamā","Only","কেবল"],["ٱلسَّبِيلُ","l-sabīlu","the way","ব্যবস্থা গ্রহণ"],["عَلَى","‘alā","against","বিরুদ্ধে"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["يَظْلِمُونَ","yaẓlimūna","oppress","অত্যাচার করে"],["ٱلنَّاسَ","l-nāsa","the people","মানুষের (উপর)"],["وَيَبْغُونَ","wayabghūna","and rebel","এবং বিদ্রোহ করে"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["بِغَيْرِ","bighayri","without","ছাড়া"],["ٱلْحَقِّ ۚ","l-ḥaqi","right","অহেতুক"],["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব লোক"],["لَهُمْ","lahum","for them","তাদের জন্যে (রয়েছে)"],["عَذَابٌ","‘adhābun","(is) a punishment","শাস্তি"],["أَلِيمٌۭ","alīmun","painful","যন্ত্রণাদায়ক"]],"t":"إِ<g>نَّ</>مَا <h>ٱ</><l>ل</>سَّبِيلُ عَلَى <h>ٱ</>لَّذِينَ يَظْلِمُونَ <h>ٱ</><l>ل</><g>نَّ</>اسَ وَيَ<q>بْ</>غُونَ فِى <h>ٱ</>لْأَرْضِ بِغَيْرِ <h>ٱ</>لْحَقِّ ۚ أُ<s>و۟</><o>لَٰٓ</>ئِكَ لَهُمْ عَذَابٌ أَ<p>لِي</>مٌۭ"},{"n":43,"w":[["وَلَمَن","walaman","And whoever","এবং যে অবশ্য"],["صَبَرَ","ṣabara","(is) patient","ধৈর্য্য ধরে"],["وَغَفَرَ","waghafara","and forgives","ও মাফ করে"],["إِنَّ","inna","indeed","নিশ্চয়ই"],["ذَٰلِكَ","dhālika","that","এটা"],["لَمِنْ","lamin","(is) surely of","অবশ্যই অন্তর্ভুক্ত"],["عَزْمِ","‘azmi","matters of determination","দৃঢ়সংকল্পের (উচ্চমানের)"],["ٱلْأُمُورِ","l-umūri","matters of determination","কাজসমুহের"]],"t":"وَلَمَ<k>ن صَ</>بَرَ وَغَفَرَ إِ<g>نَّ</> <m>ذَٰ</>لِكَ لَمِنْ عَزْمِ <h>ٱ</>لْأُ<p>مُو</>رِ"},{"n":44,"w":[["وَمَن","waman","And whoever","এবং যাকে"],["يُضْلِلِ","yuḍ'lili","Allah lets go astray","পথভ্রষ্ট করেন"],["ٱللَّهُ","l-lahu","Allah lets go astray","আল্লাহ"],["فَمَا","famā","then not","তখন নেই"],["لَهُۥ","lahu","for him","তার জন্যে"],["مِن","min","any","কোনো"],["وَلِىٍّۢ","waliyyin","protector","অভিভাবক"],["مِّنۢ","min","after Him","থেকে"],["بَعْدِهِۦ ۗ","ba‘dihi","after Him","পরে তাঁর"],["وَتَرَى","watarā","And you will see","এবং তুমি দেখবে"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","সীমালঙ্ঘনকারীদেরকে"],["لَمَّا","lammā","when","যখন"],["رَأَوُا۟","ra-awū","they see","তারা দেখবে"],["ٱلْعَذَابَ","l-‘adhāba","the punishment","শাস্তি"],["يَقُولُونَ","yaqūlūna","saying","তারা বলবে"],["هَلْ","hal","Is","\"কি (আছে)"],["إِلَىٰ","ilā","(there) for","দিকে"],["مَرَدٍّۢ","maraddin","return","ফেরার"],["مِّن","min","any","কোনো"],["سَبِيلٍۢ","sabīlin","way","উপায়\""]],"t":"وَ<d>مَن يُ</>ضْلِلِ <h>ٱ</>للَّهُ فَمَا لَهُ<m>ۥ</> <d>مِن وَلِىٍّۢ مِّ</><i>نۢ بَ</>عْدِ<m>هِۦ</> ۗ وَتَرَى <h>ٱ</><l>ل</><m>ظَّٰ</>لِمِينَ لَ<g>مَّ</>ا رَأَوُ<s>ا۟</> <h>ٱ</>لْعَذَابَ يَقُولُونَ هَلْ إِلَىٰ مَرَ<d>دٍّۢ مِّ</><k>ن سَ</><p>بِي</>لٍۢ"},{"n":45,"w":[["وَتَرَىٰهُمْ","watarāhum","And you will see them","এবং  তাদের দেখবে তুমি"],["يُعْرَضُونَ","yu‘'raḍūna","being exposed","উপস্থিত করা হচ্ছে"],["عَلَيْهَا","‘alayhā","to it","তার (অর্থাৎ জাহান্নামের) কাছে"],["خَـٰشِعِينَ","khāshi‘īna","humbled","অবনত হয়ে থাকবে"],["مِنَ","mina","by","কার