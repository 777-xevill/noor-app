 astray","পথভ্রষ্ট করেন"],["ٱللَّهُ","l-lahu","Allah lets go astray","আল্লাহ"],["فَمَا","famā","then not","তখন নেই"],["لَهُۥ","lahu","for him","তার জন্যে"],["مِن","min","any","কোনো"],["سَبِيلٍ","sabīlin","way","পথ"]],"t":"وَمَا كَانَ لَ<y>هُم مِّ</>نْ أَوْلِ<o>يَآ</>ءَ يَ<k>نصُ</>رُونَ<y>هُم مِّ</><k>ن دُ</>ونِ <h>ٱ</>للَّهِ ۗ وَ<d>مَن يُ</>ضْلِلِ <h>ٱ</>للَّهُ فَمَا لَهُ<m>ۥ</> مِ<k>ن سَ</><p>بِي</>لٍ"},{"n":47,"w":[["ٱسْتَجِيبُوا۟","is'tajībū","Respond","তোমরা ডাকে সাড়া দাও (মেনে নাও)"],["لِرَبِّكُم","lirabbikum","to your Lord","তোমাদের রবের (কথা)"],["مِّن","min","before","থেকে"],["قَبْلِ","qabli","before","(এর) পূর্বেই"],["أَن","an","[that]","যে"],["يَأْتِىَ","yatiya","comes","আসবে"],["يَوْمٌۭ","yawmun","a Day","(এমন) দিন"],["لَّا","lā","(there is) no","নেই"],["مَرَدَّ","maradda","averting","প্রতিরোধ"],["لَهُۥ","lahu","for it","তার জন্যে"],["مِنَ","mina","from","থেকে"],["ٱللَّهِ ۚ","l-lahi","Allah","আল্লাহর"],["مَا","mā","Not","নেই"],["لَكُم","lakum","(is) for you","তোমাদের জন্যে"],["مِّن","min","any","কোনো"],["مَّلْجَإٍۢ","malja-in","refuge","আশ্রয়স্থল"],["يَوْمَئِذٍۢ","yawma-idhin","(on) that Day","সেদিন"],["وَمَا","wamā","and not","আর নেই"],["لَكُم","lakum","for you","তোমাদের জন্যে"],["مِّن","min","any","কোনো"],["نَّكِيرٍۢ","nakīrin","denial","প্রতিরোধকারী"]],"t":"ٱسْتَجِيبُو<s>ا۟</> لِرَبِّ<y>كُم مِّ</><k>ن قَ</><q>بْ</>لِ <d>أَن يَ</>أْتِىَ يَوْ<w>مٌۭ لَّ</>ا مَرَدَّ لَهُ<m>ۥ</> مِنَ <h>ٱ</>للَّهِ ۚ مَا لَ<y>كُم مِّ</><d>ن مَّ</>لْجَ<d>إٍۢ يَ</>وْمَئِ<d>ذٍۢ وَ</>مَا لَ<y>كُم مِّ</><d>ن نَّ</><p>كِي</>رٍۢ"},{"n":48,"w":[["فَإِنْ","fa-in","Then if","অতএব যদি"],["أَعْرَضُوا۟","a‘raḍū","they turn away","তারা মুখ ফেরায়"],["فَمَآ","famā","then not","তবে না"],["أَرْسَلْنَـٰكَ","arsalnāka","We have sent you","তোমাকে আমরা পাঠিয়েছি"],["عَلَيْهِمْ","‘alayhim","over them","তাদের উপর"],["حَفِيظًا ۖ","ḥafīẓan","(as) a guardian","রক্ষক করে"],["إِنْ","in","Not","নেই"],["عَلَيْكَ","‘alayka","(is) on you","তোমার উপর (দায়িত্ব)"],["إِلَّا","illā","except","এ ব্যতীত"],["ٱلْبَلَـٰغُ ۗ","l-balāghu","the conveyance","পৌঁছানো"],["وَإِنَّآ","wa-innā","And indeed","এবং নিশ্চয়ই আমরা"],["إِذَآ","idhā","when","যখন"],["أَذَقْنَا","adhaqnā","We cause to taste","আস্বাদন করাই"],["ٱلْإِنسَـٰنَ","l-insāna","[the] man","মানুষকে"],["مِنَّا","minnā","from Us","আমাদের থেকে"],["رَحْمَةًۭ","raḥmatan","Mercy","অনুগ্রহ"],["فَرِحَ","fariḥa","he rejoices","উৎফুল্ল হয়"],["بِهَا ۖ","bihā","in it","তা দ্বারা"],["وَإِن","wa-in","But if","এবং যদি"],["تُصِبْهُمْ","tuṣib'hum","befalls them","তাদের পৌঁছে"],["سَيِّئَةٌۢ","sayyi-atun","evil","অনিষ্ট"],["بِمَا","bimā","for what","এ কারণে যা"],["قَدَّمَتْ","qaddamat","have sent forth","আগে করেছে"],["أَيْدِيهِمْ","aydīhim","their hands","তাদের হাতগুলো"],["فَإِنَّ","fa-inna","then indeed","নিশ্চয়ই তখন"],["ٱلْإِنسَـٰنَ","l-insāna","[the] man","মানুষ"],["كَفُورٌۭ","kafūrun","(is) ungrateful","অকৃতজ্ঞ হয়"]],"t":"فَإِنْ أَعْرَضُو<s>ا۟</> فَ<o>مَآ</> أَرْسَلْ<m>نَٰ</>كَ عَلَيْهِمْ حَفِيظًا ۖ إِنْ عَلَيْكَ إِلَّا <h>ٱ</>لْبَ<m>لَٰ</>غُ ۗ وَإِ<g>نَّ</><o>آ</> إِ<o>ذَآ</> أَذَ<q>قْ</>نَا <h>ٱ</>لْإِ<k>نسَٰ</>نَ مِ<g>نَّ</>ا رَحْمَ<k>ةًۭ فَ</>رِحَ بِهَا ۖ وَإِ<k>ن تُ</>صِ<q>بْ</>هُمْ سَيِّئَ<i>ةٌۢ بِ</>مَا قَدَّمَتْ أَيْدِيهِمْ فَإِ<g>نَّ</> <h>ٱ</>لْإِ<k>نسَٰ</>نَ كَ<p>فُو</>رٌۭ"},{"n":49,"w":[["لِّلَّهِ","lillahi","To Allah","আল্লাহরই জন্যে"],["مُلْكُ","mul'ku","(belongs the) dominion","সার্বভৌমত্ব"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশের"],["وَٱلْأَرْضِ ۚ","wal-arḍi","and the earth","ও পৃথিবীর"],["يَخْلُقُ","yakhluqu","He creates","তিনি সৃষ্টি করেন"],["مَا","mā","what","যা"],["يَشَآءُ ۚ","yashāu","He wills","ইচ্ছে করেন"],["يَهَبُ","yahabu","He grants","তিনি দেন"],["لِمَن","liman","to whom","যাকে"],["يَشَآءُ","yashāu","He wills","ইচ্ছে করেন"],["إِنَـٰثًۭا","ināthan","females","কন্যাসমূহ"],["وَيَهَبُ","wayahabu","and He grants","এবং তিনি দেন"],["لِمَن","liman","to whom","যাকে"],["يَشَآءُ","yashāu","He wills","ইচ্ছে করেন"],["ٱلذُّكُورَ","l-dhukūra","[the] males","পুত্রসমূহ"]],"t":"لِّلَّهِ مُلْكُ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ ۚ يَخْلُقُ مَا يَ<o>شَآ</>ءُ ۚ يَهَبُ لِ<d>مَن يَ</><o>شَآ</>ءُ إِ<m>نَٰ</><d>ثًۭا وَ</>يَهَبُ لِ<d>مَن يَ</><o>شَآ</>ءُ <h>ٱ</><l>ل</>ذُّ<p>كُو</>رَ"},{"n":50,"w":[["أَوْ","aw","Or","অথবা"],["يُزَوِّجُهُمْ","yuzawwijuhum","He grants them","তাদেরকে মিলিয়ে দেন"],["ذُكْرَانًۭا","dhuk'rānan","males","পুত্রসমূহ"],["وَإِنَـٰثًۭا ۖ","wa-ināthan","and females","ও কন্যাসমূহ"],["وَيَجْعَلُ","wayaj‘alu","and He makes","এবং করে দেন"],["مَن","man","whom","যাকে"],["يَشَآءُ","yashāu","He wills","ইচ্ছে করেন"],["عَقِيمًا ۚ","‘aqīman","barren","বন্ধ্যা"],["إِنَّهُۥ","innahu","Indeed, He","তিনি নিশ্চয়ই"],["عَلِيمٌۭ","‘alīmun","(is) All-Knower","সর্বজ্ঞ (সবকিছু জানেন)"],["قَدِيرٌۭ","qadīrun","All-Powerful","সর্বশক্তিমান"]],"t":"أَوْ يُزَوِّجُهُمْ ذُكْرَا<d>نًۭا وَ</>إِ<m>نَٰ</><d>ثًۭا ۖ وَ</>يَ<q>جْ</>عَلُ <d>مَن يَ</><o>شَآ</>ءُ عَقِيمًا ۚ إِ<g>نَّ</>هُ<m>ۥ</> عَلِي<k>مٌۭ قَ</><p>دِي</>رٌۭ"},{"n":51,"w":[["۞ وَمَا","wamā","And not","এবং নয় (মর্যাদা)"],["كَانَ","kāna","is","ছিল"],["لِبَشَرٍ","libasharin","for any human","মানুষের জন্যে"],["أَن","an","that","যে"],["يُكَلِّمَهُ","yukallimahu","Allah should speak to him","তার সাথে কথা বলবেন"],["ٱللَّهُ","l-lahu","Allah should speak to him","আল্লাহ"],["إِلَّا","illā","except","ছাড়া"],["وَحْيًا","waḥyan","(by) revelation","ওহী"],["أَوْ","aw","or","বা"],["مِن","min","from","থেকে"],["وَرَآئِ","warāi","behind","আড়াল"],["حِجَابٍ","ḥijābin","a veil","পর্দার"],["أَوْ","aw","or","অথবা"],["يُرْسِلَ","yur'sila","(by) sending","প্রেরণ করেন"],["رَسُولًۭا","rasūlan","a messenger","দূত হিসেবে (ফেরেশতা)"],["فَيُوحِىَ","fayūḥiya","then he reveals","অতঃপর ওহী করে"],["بِإِذْنِهِۦ","bi-idh'nihi","by His permission","তাঁর অনুমতিক্রমে"],["مَا","mā","what","যা"],["يَشَآءُ ۚ","yashāu","He wills","তিনি ইচ্ছে করেন"],["إِنَّهُۥ","innahu","Indeed, He","তিনি নিশ্চয়ই"],["عَلِىٌّ","‘aliyyun","(is) Most High","মহান"],["حَكِيمٌۭ","ḥakīmun","Most Wise","প্রজ্ঞাময়"]],"t":"۞ وَمَا كَانَ لِبَشَرٍ <d>أَن يُ</>كَلِّمَهُ <h>ٱ</>للَّهُ إِلَّا وَحْيًا أَوْ <d>مِن وَ</>رَآئِ حِجَابٍ أَوْ يُرْسِلَ رَسُولًۭ<k>ا فَ</>يُوحِىَ بِإِذْنِ<m>هِۦ</> مَا يَ<o>شَآ</>ءُ ۚ إِ<g>نَّ</>هُ<m>ۥ</> عَلِىٌّ حَ<p>كِي</>مٌۭ"},{"n":52,"w":[["وَكَذَٰلِكَ","wakadhālika","And thus","এবং এভাবে"],["أَوْحَيْنَآ","awḥaynā","We have revealed","আমরা ওহী পাঠিয়েছি"],["إِلَيْكَ","ilayka","to you","তোমার প্রতি"],["رُوحًۭا","rūḥan","an inspiration","রূহ (অর্থাৎ ওহী) বা কোরআন"],["مِّنْ","min","by","থেকে"],["أَمْرِنَا ۚ","amrinā","Our Command","আমাদের নির্দেশ"],["مَا","mā","Not","না"],["كُنتَ","kunta","(did) you","তুমি"],["تَدْرِى","tadrī","know","জানতে"],["مَا","mā","what","কি"],["ٱلْكِتَـٰبُ","l-kitābu","the Book (is)","কিতাব"],["وَلَا","walā","and not","আর না (জানতে)"],["ٱلْإِيمَـٰنُ","l-īmānu","the faith","ঈমান"],["وَلَـٰكِن","walākin","But","কিন্তু"],["جَعَلْنَـٰهُ","ja‘alnāhu","We have made it","তাকে আমরা করেছি"],["نُورًۭا","nūran","a light","আলো'"],["نَّهْدِى","nahdī","We guide","পথ দেখাই আমরা"],["بِهِۦ","bihi","with it","তা দিয়ে"],["مَن","man","whom","যাকে"],["نَّشَآءُ","nashāu","We will","ইচ্ছে করি আমরা"],["مِنْ","min","of","মধ্য হ'তে"],["عِبَادِنَا ۚ","‘ibādinā","Our slaves","আমাদের দাসদের"],["وَإِنَّكَ","wa-innaka","And indeed, you","এবং তুমি নিশ্চয়ই"],["لَتَهْدِىٓ","latahdī","surely guide","পথ দেখাচ্ছো তুমি অবশ্যই"],["إِلَىٰ","ilā","to","দিকে"],["صِرَٰطٍۢ","ṣirāṭin","(the) Path","পথের"],["مُّسْتَقِيمٍۢ","mus'taqīmin","Straight","সরল-সঠিক"]],"t":"وَكَ<m>ذَٰ</>لِكَ أَوْحَيْ<o>نَآ</> إِلَيْكَ رُو<d>حًۭا مِّ</>نْ أَمْرِنَا ۚ مَا كُ<k>نتَ</> تَ<q>دْ</>رِى مَا <h>ٱ</>لْكِ<m>تَٰ</>بُ وَلَا <h>ٱ</>لْإِي<m>مَٰ</>نُ وَ<m>لَٰ</>كِ<k>ن جَ</>عَلْ<m>نَٰ</>هُ نُو<d>رًۭا نَّ</>هْدِى بِ<m>هِۦ</> <d>مَن نَّ</><o>شَآ</>ءُ مِنْ عِبَادِنَا ۚ وَإِ<g>نَّ</>كَ لَتَهْ<o>دِىٓ</> إِلَىٰ صِ<m>رَٰ</><d>طٍۢ مُّ</>سْتَ<p>قِي</>مٍۢ"},{"n":53,"w":[["صِرَٰطِ","ṣirāṭi","(The) path","পথ"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["ٱلَّذِى","alladhī","the One","যিনি (এমন সত্ত্বা যে)"],["لَهُۥ","lahu","to Whom","তাঁরই জন্যে"],["مَا","mā","(belongs) whatever","যা কিছু"],["فِى","fī","(is) in","মধ্যে আছে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশের"],["وَمَا","wamā","and whatever","এবং যা কিছু"],["فِى","fī","(is) in","মধ্যে আছে"],["ٱلْأَرْضِ ۗ","l-arḍi","the earth","পৃথিবীর"],["أَلَآ","alā","Unquestionably","জেনে রাখো"],["إِلَى","ilā","To","দিকে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহরই"],["تَصِيرُ","taṣīru","reach","ফিরে যায়"],["ٱلْأُمُورُ","l-umūru","all affairs","সকল বিষয়"]],"t":"صِ<m>رَٰ</>طِ <h>ٱ</>للَّهِ <h>ٱ</>لَّذِى لَهُ<m>ۥ</> مَا فِى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَمَا فِى <h>ٱ</>لْأَرْضِ ۗ أَ<o>لَآ</> إِلَى <h>ٱ</>للَّهِ تَصِيرُ <h>ٱ</>لْأُ<p>مُو</>رُ"}]}