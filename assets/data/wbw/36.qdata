{"n":36,"a":[{"n":1,"w":[["يسٓ","ya-seen","Ya Seen","ইয়া-সীন।"]],"t":"ي<n>سٓ</>"},{"n":2,"w":[["وَٱلْقُرْءَانِ","wal-qur'āni","By the Quran","শপথ কুরআনের (যা)"],["ٱلْحَكِيمِ","l-ḥakīmi","the Wise","জ্ঞানময়  (বিজ্ঞানময়)।"]],"t":"وَ<h>ٱ</>لْقُرْءَانِ <h>ٱ</>لْحَ<p>كِي</>مِ"},{"n":3,"w":[["إِنَّكَ","innaka","Indeed, you","তুমি নিশ্চয়ই"],["لَمِنَ","lamina","(are) among","অন্তর্ভুক্ত অবশ্যই"],["ٱلْمُرْسَلِينَ","l-mur'salīna","the Messengers","রাসূলদের।"]],"t":"إِ<g>نَّ</>كَ لَمِنَ <h>ٱ</>لْمُرْسَ<p>لِي</>نَ"},{"n":4,"w":[["عَلَىٰ","‘alā","On","(তুমি প্রতিষ্ঠিত) উপর"],["صِرَٰطٍۢ","ṣirāṭin","a Path","পথের"],["مُّسْتَقِيمٍۢ","mus'taqīmin","Straight","সরল সঠিক"]],"t":"عَلَىٰ صِ<m>رَٰ</><d>طٍۢ مُّ</>سْتَ<p>قِي</>مٍۢ"},{"n":5,"w":[["تَنزِيلَ","tanzīla","A revelation","(এই কোরআন) অবতীর্ণ করা"],["ٱلْعَزِيزِ","l-‘azīzi","(of) the All-Mighty","পরাক্রমশালীর (পক্ষ হ'তে)"],["ٱلرَّحِيمِ","l-raḥīmi","the Most Merciful","(যিনি) পরম দয়ালু"]],"t":"تَ<k>نزِ</>يلَ <h>ٱ</>لْعَزِيزِ <h>ٱ</><l>ل</>رَّ<p>حِي</>مِ"},{"n":6,"w":[["لِتُنذِرَ","litundhira","That you may warn","সতর্ক করো তুমি যেন"],["قَوْمًۭا","qawman","a people","(এমন) জাতিকে"],["مَّآ","mā","not","না"],["أُنذِرَ","undhira","were warned","সতর্ক করা হয়েছে"],["ءَابَآؤُهُمْ","ābāuhum","their forefathers","তাদের পিতৃ-পুরুষদেরকে"],["فَهُمْ","fahum","so they","অতএব তারা"],["غَـٰفِلُونَ","ghāfilūna","(are) heedless","উদাসীন (হয়ে আছে)"]],"t":"لِتُ<k>نذِ</>رَ قَوْ<d>مًۭا مَّ</><o>آ</> أُ<k>نذِ</>رَ ءَا<o>بَآ</>ؤُهُمْ فَهُمْ <m>غَٰ</>فِ<p>لُو</>نَ"},{"n":7,"w":[["لَقَدْ","laqad","Certainly","নিশ্চয়ই"],["حَقَّ","ḥaqqa","(has) proved true","অবধারিত হয়েছে"],["ٱلْقَوْلُ","l-qawlu","the word","(শান্তির) বাণী"],["عَلَىٰٓ","‘alā","upon","উপর"],["أَكْثَرِهِمْ","aktharihim","most of them","তাদের অধিক অংশের"],["فَهُمْ","fahum","so they","সুতরাং তারা"],["لَا","lā","(do) not","না"],["يُؤْمِنُونَ","yu'minūna","believe","ঈমান আনবে"]],"t":"لَقَ<q>دْ</> حَقَّ <h>ٱ</>لْقَوْلُ عَلَ<o>ىٰٓ</> أَكْثَرِهِمْ فَهُمْ لَا يُؤْمِ<p>نُو</>نَ"},{"n":8,"w":[["إِنَّا","innā","Indeed, We","নিশ্চয়ই আমরা"],["جَعَلْنَا","ja‘alnā","[We] have placed","আমরা লাগিয়েছি"],["فِىٓ","fī","on","উপর"],["أَعْنَـٰقِهِمْ","a‘nāqihim","their necks","তাদের গলায়"],["أَغْلَـٰلًۭا","aghlālan","iron collars","বেড়িসমূহ"],["فَهِىَ","fahiya","and they","তা তাই"],["إِلَى","ilā","(are up) to","(রয়েছে) পর্যন্ত"],["ٱلْأَذْقَانِ","l-adhqāni","the chins","চিবুকগুলো (শৃঙ্খলিত হয়ে)"],["فَهُم","fahum","so they","তারা এজন্য"],["مُّقْمَحُونَ","muq'maḥūna","(are with) heads raised up","ঊর্ধ্বমুখী (হয়ে আছে)"]],"t":"إِ<g>نَّ</>ا جَعَلْنَا <o>فِىٓ</> أَعْ<m>نَٰ</>قِهِمْ أَغْ<m>لَٰ</>لًۭ<k>ا فَ</>هِىَ إِلَى <h>ٱ</>لْأَذْقَانِ فَ<y>هُم مُّ</><q>قْ</>مَ<p>حُو</>نَ"},{"n":9,"w":[["وَجَعَلْنَا","waja‘alnā","And We have made","এবং আমরা খাড়া করেছি"],["مِنۢ","min","from","থেকে"],["بَيْنِ","bayni","before/between","সামনে"],["أَيْدِيهِمْ","aydīhim","their hands/their front","তাদের"],["سَدًّۭا","saddan","a barrier","প্রাচীর"],["وَمِنْ","wamin","and from","ও থেকে"],["خَلْفِهِمْ","khalfihim","behind them","তাদের পিছন"],["سَدًّۭا","saddan","a barrier","প্রাচীর"],["فَأَغْشَيْنَـٰهُمْ","fa-aghshaynāhum","and We covered them","তাদেরকে আমরা এভাবে ঢেকে দিয়েছি"],["فَهُمْ","fahum","so they","তারা অতএব"],["لَا","lā","(do) not","না"],["يُبْصِرُونَ","yub'ṣirūna","see","দেখতে পায়"]],"t":"وَجَعَلْنَا <i>مِنۢ بَ</>يْنِ أَيْدِيهِمْ سَ<d>دًّۭا وَ</>مِنْ خَلْفِهِمْ سَ<k>دًّۭا فَ</>أَغْشَيْ<m>نَٰ</>هُمْ فَهُمْ لَا يُ<q>بْ</>صِ<p>رُو</>نَ"},{"n":10,"w":[["وَسَوَآءٌ","wasawāon","And it (is) same","এবং সমান"],["عَلَيْهِمْ","‘alayhim","to them","তাদের পক্ষে"],["ءَأَنذَرْتَهُمْ","a-andhartahum","whether you warn them","তাদের তুমি সতর্ক করো কি"],["أَمْ","am","or","বা"],["لَمْ","lam","(do) not","নি"],["تُنذِرْهُمْ","tundhir'hum","warn them","তাদের সতর্ক করো তুমি"],["لَا","lā","not","না"],["يُؤْمِنُونَ","yu'minūna","they will believe","তারা ঈমান আনবে"]],"t":"وَسَ<o>وَآ</>ءٌ عَلَيْهِمْ ءَأَ<k>نذَ</>رْتَهُمْ أَمْ لَمْ تُ<k>نذِ</>رْهُمْ لَا يُؤْمِ<p>نُو</>نَ"},{"n":11,"w":[["إِنَّمَا","innamā","Only","প্রকৃতপক্ষে"],["تُنذِرُ","tundhiru","you (can) warn","সতর্ক করো তুমি"],["مَنِ","mani","(him) who","(তাকে) যে"],["ٱتَّبَعَ","ittaba‘a","follows","মেনে চলে"],["ٱلذِّكْرَ","l-dhik'ra","the Reminder","উপদেশ"],["وَخَشِىَ","wakhashiya","and fears","ও ভয় করে"],["ٱلرَّحْمَـٰنَ","l-raḥmāna","the Most Gracious","দয়াময়কে"],["بِٱلْغَيْبِ ۖ","bil-ghaybi","in the unseen","না দেখা অবস্থায়"],["فَبَشِّرْهُ","fabashir'hu","So give him glad tidings","তাকে সুতরাং দাও সুসংবাদ"],["بِمَغْفِرَةٍۢ","bimaghfiratin","of forgiveness","ক্ষমার"],["وَأَجْرٍۢ","wa-ajrin","and a reward","ও প্রতিফলের"],["كَرِيمٍ","karīmin","noble","সম্মানজনক"]],"t":"إِ<g>نَّ</>مَا تُ<k>نذِ</>رُ مَنِ <h>ٱ</>تَّبَعَ <h>ٱ</><l>ل</>ذِّكْرَ وَخَشِىَ <h>ٱ</><l>ل</>رَّحْ<m>مَٰ</>نَ بِ<h>ٱ</>لْغَيْبِ ۖ فَبَشِّرْهُ بِمَغْفِرَ<d>ةٍۢ وَ</>أَ<q>جْ</><k>رٍۢ كَ</><p>رِي</>مٍ"},{"n":12,"w":[["إِنَّا","innā","Indeed, We","নিশ্চয়ই"],["نَحْنُ","naḥnu","[We]","আমরা"],["نُحْىِ","nuḥ'yī","[We] give life","জীবিত করবো (একদিন)"],["ٱلْمَوْتَىٰ","l-mawtā","(to) the dead","মৃতদেরকে"],["وَنَكْتُبُ","wanaktubu","and We record","এবং আমরা লিখে রাখি"],["مَا","mā","what","যা"],["قَدَّمُوا۟","qaddamū","they have sent before","তারা আগে পাঠিয়েছে"],["وَءَاثَـٰرَهُمْ ۚ","waāthārahum","and their footprints","ও তাদের কীর্তিসমূহ (যা পিছনে রেখেছে)"],["وَكُلَّ","wakulla","and every","এবং প্রত্যেক"],["شَىْءٍ","shayin","thing","জিনিস"],["أَحْصَيْنَـٰهُ","aḥṣaynāhu","We have enumerated it","তা আমরা সংরক্ষণ করেছি"],["فِىٓ","fī","in","মধ্যে"],["إِمَامٍۢ","imāmin","a Register","একটি কিতাবের"],["مُّبِينٍۢ","mubīnin","clear","সুস্পষ্ট"]],"t":"إِ<g>نَّ</>ا نَحْنُ نُحْىِ <h>ٱ</>لْمَوْتَىٰ وَنَكْتُبُ مَا قَدَّمُو<s>ا۟</> وَءَا<m>ثَٰ</>رَهُمْ ۚ وَكُلَّ شَىْءٍ أَحْصَيْ<m>نَٰ</>هُ <o>فِىٓ</> إِمَا<d>مٍۢ مُّ</><p>بِي</>نٍۢ"},{"n":13,"w":[["وَٱضْرِبْ","wa-iḍ'rib","And set forth","এবং বর্ণনা করো"],["لَهُم","lahum","to them","তাদের কাছে"],["مَّثَلًا","mathalan","an example","দৃষ্টান্ত"],["أَصْحَـٰبَ","aṣḥāba","(of the) companions","অধিবাসীদেরকে"],["ٱلْقَرْيَةِ","l-qaryati","(of) the city","জনপদের"],["إِذْ","idh","when","যখন"],["جَآءَهَا","jāahā","came to it","সেখানে এসেছিলো"],["ٱلْمُرْسَلُونَ","l-mur'salūna","the Messengers","রাসূলগণ"]],"t":"وَ<h>ٱ</>ضْرِ<q>بْ</> لَ<y>هُم مَّ</>ثَلًا أَصْ<m>حَٰ</>بَ <h>ٱ</>لْقَرْيَةِ إِذْ <o>جَآ</>ءَهَا <h>ٱ</>لْمُرْسَ<p>لُو</>نَ"},{"n":14,"w":[["إِذْ","idh","When","যখন"],["أَرْسَلْنَآ","arsalnā","We sent","আমরা পাঠিয়েছিলাম"],["إِلَيْهِمُ","ilayhimu","to them","তাদের প্রতি"],["ٱثْنَيْنِ","ith'nayni","two (Messengers)","দু'জনকে"],["فَكَذَّبُوهُمَا","fakadhabūhumā","but they denied both of them","তখন উভয়কে তারা মিথ্যারোপ করলো"],["فَعَزَّزْنَا","fa‘azzaznā","so We strengthened them","আমরা শক্তিশালী করলাম তখন"],["بِثَالِثٍۢ","bithālithin","with a third","তৃতীয়জনকে দিয়ে"],["فَقَالُوٓا۟","faqālū","and they said","তারা অতঃপর বললো"],["إِنَّآ","innā","Indeed, We","\"নিশ্চয়ই আমরা"],["إِلَيْكُم","ilaykum","to you","তোমাদের প্রতি"],["مُّرْسَلُونَ","mur'salūna","(are) Messengers","প্রেরিত রাসূল\""]],"t":"إِذْ أَرْسَلْ<o>نَآ</> إِلَيْهِمُ <h>ٱ</>ثْنَيْنِ فَكَذَّبُوهُمَا فَعَزَّزْنَا بِثَالِ<k>ثٍۢ فَ</>قَا<o>لُوٓ</><s>ا۟</> إِ<g>نَّ</><o>آ</> إِلَيْ<y>كُم مُّ</>رْسَ<p>لُو</>نَ"},{"n":15,"w":[["قَالُوا۟","qālū","They said","(লোকেরা) বললো"],["مَآ","mā","Not","\"না"],["أَنتُمْ","antum","you","তোমরা"],["إِلَّا","illā","(are) but","এছাড়া"],["بَشَرٌۭ","basharun","human beings","মানুষ"],["مِّثْلُنَا","mith'lunā","like us","আমাদেরই মতো"],["وَمَآ","wamā","and not","না এবং"],["أَنزَلَ","anzala","has revealed","অবতীর্ণ করেছেন"],["ٱلرَّحْمَـٰنُ","l-raḥmānu","the Most Gracious","দয়াময়"],["مِن","min","any","কোনো"],["شَىْءٍ","shayin","thing","কিছুই"],["إِنْ","in","Not","না"],["أَنتُمْ","antum","you","তোমরা"],["إِلَّا","illā","(are) but","এছাড়া"],["تَكْذِبُونَ","takdhibūna","lying","মিথ্যা বলছো\""]],"t":"قَالُو<s>ا۟</> <o>مَآ</> أَ<k>نتُ</>مْ إِلَّا بَشَ<d>رٌۭ مِّ</>ثْلُنَا وَ<o>مَآ</> أَ<k>نزَ</>لَ <h>ٱ</><l>ل</>رَّحْ<m>مَٰ</>نُ مِ<k>ن شَ</>ىْءٍ إِنْ أَ<k>نتُ</>مْ إِلَّا تَكْذِ<p>بُو</>نَ"},{"n":16,"w":[["قَالُوا۟","qālū","They said","(রাসূলগণ) বললেন"],["رَبُّنَا","rabbunā","Our Lord","\"আমাদের রব"],["يَعْلَمُ","ya‘lamu","knows","জানেন"],["إِنَّآ","innā","that we","নিশ্চযই় আমরা"],["إِلَيْكُمْ","ilaykum","to you","তোমাদের প্রতি"],["لَمُرْسَلُونَ","lamur'salūna","(are) surely Messengers","প্রেরিত অবশ্যই (রাসূল হিসেবে)"]],"t":"قَالُو<s>ا۟</> رَبُّنَا يَعْلَمُ إِ<g>نَّ</><o>آ</> إِلَيْكُمْ لَمُرْسَ<p>لُو</>نَ"},{"n":17,"w":[["وَمَا","wamā","And not","এবং না"],["عَلَيْنَآ","‘alaynā","(is) on us","আমাদের উপর (দায়িত্ব)"],["إِلَّا","illā","except","এ ব্যতীত"],["ٱلْبَلَـٰغُ","l-balāghu","the conveyance","প্রচার"],["ٱلْمُبِينُ","l-mubīnu","clear","সুস্পষ্ট (পয়গাম)\""]],"t":"وَمَا عَلَيْ<o>نَآ</> إِلَّا <h>ٱ</>لْبَ<m>لَٰ</>غُ <h>ٱ</>لْمُ<p>بِي</>نُ"},{"n":18,"w":[["قَالُوٓا۟","qālū","They said","তারা বললো"],["إِنَّا","innā","Indeed, we","\"নিশ্চযই় আমরা"],["تَطَيَّرْنَا","taṭayyarnā","[we] see an evil omen","আমরা অমঙ্গল মনে করি"],["بِكُمْ ۖ","bikum","from you","তোমাদেরকে"],["لَئِن","la-in","If","অবশ্যই যদি"],["لَّمْ","lam","not","না"],["تَنتَهُوا۟","tantahū","you desist","তোমরা বিরত হও"],["لَنَرْجُمَنَّكُمْ","lanarjumannakum","surely, we will stone you","তোমাদেরকে আমরা পাথর মেরে হত্যা করবোই"],["وَلَيَمَسَّنَّكُم","walayamassannakum","and surely will touch you","এবং তোমাদেরকে ধরবে অবশ্যই"],["مِّنَّا","minnā","from us","আমাদের পক্ষ হ'তে"],["عَذَابٌ","‘adhābun","a punishment","শাস্তি"],["أَلِيمٌۭ","alīmun","painful","নিদারুণ\""]],"t":"قَا<o>لُوٓ</><s>ا۟</> إِ<g>نَّ</>ا تَطَيَّرْنَا بِكُمْ ۖ لَ<w>ئِن لَّ</>مْ تَ<k>نتَ</>هُو<s>ا۟</> لَنَرْجُمَ<g>نَّ</>كُمْ وَلَيَمَسَّ<g>نَّ</><y>كُم مِّ</><g>نَّ</>ا عَذَابٌ أَ<p>لِي</>مٌۭ"},{"n":19,"w":[["قَالُوا۟","qālū","They said","(রাসূলগণ) বললেন"],["طَـٰٓئِرُكُم","ṭāirukum","Your evil omen","\"তোমাদের অমঙ্গলের (কারণ)"],["مَّعَكُمْ ۚ","ma‘akum","(be) with you","তোমাদের সাথে"],["أَئِن","a-in","Is it because","(এসব বলছো) কি"],["ذُكِّرْتُم ۚ","dhukkir'tum","you are admonished","তোমাদের উপদেশ দেওয়া হয়েছে"],["بَلْ","bal","Nay","বরং"],["أَنتُمْ","antum","you","তোমরা"],["قَوْمٌۭ","qawmun","(are) a people","সম্প্রদায়"],["مُّسْرِفُونَ","mus'rifūna","transgressing","সীমালঙ্ঘনকারী\""]],"t":"قَالُو<s>ا۟</> <o>طَٰٓ</>ئِرُ<y>كُم مَّ</>عَكُمْ ۚ أَئِ<k>ن ذُ</>كِّرْ<f>تُم ۚ بَ</>لْ أَ<k>نتُ</>مْ قَوْ<d>مٌۭ مُّ</>سْرِ<p>فُو</>نَ"},{"n":20,"w":[["وَجَآءَ","wajāa","And came","এ অবস্থায় আসলো"],["مِنْ","min","from","হ'তে"],["أَقْصَا","aqṣā","(the) farthest end","এক প্রান্ত"],["ٱلْمَدِينَةِ","l-madīnati","(of) the city","শহরের"],["رَجُلٌۭ","rajulun","a man","এক ব্যক্তি"],["يَسْعَىٰ","yas‘ā","running","দৌঁড়ে"],["قَالَ","qāla","He said","সে বললো"],["يَـٰقَوْمِ","yāqawmi","O my People","\"হে আমার জাতি"],["ٱتَّبِعُوا۟","ittabi‘ū","Follow","তোমরা অনুসরণ করো"],["ٱلْمُرْسَلِينَ","l-mur'salīna","the Messengers","রাসূলগণকে"]],"t":"وَ<o>جَآ</>ءَ مِنْ أَ<q>قْ</>صَا <h>ٱ</>لْمَدِينَةِ رَجُ<d>لٌۭ يَ</>سْعَىٰ قَالَ <m>يَٰ</>قَوْمِ <h>ٱ</>تَّبِعُو<s>ا۟</> <h>ٱ</>لْمُرْسَ<p>لِي</>نَ"},{"n":21,"w":[["ٱتَّبِعُوا۟","ittabi‘ū","Follow","তোমরা অনুসরণ করো"],["مَن","man","(those) who","(তার) যে"],["لَّا","lā","(do) not","না"],["يَسْـَٔلُكُمْ","yasalukum","ask (of) you","তোমাদের কাছে চায়"],["أَجْرًۭا","ajran","any payment","কোনো বিনিময়"],["وَهُم","wahum","and they","এবং তারা"],["مُّهْتَدُونَ","muh'tadūna","(are) rightly guided","সৎপথপ্রাপ্ত"]],"t":"ٱتَّبِعُو<s>ا۟</> <w>مَن لَّ</>ا يَسْـَٔلُكُمْ أَ<q>جْ</><d>رًۭا وَ</><y>هُم مُّ</>هْتَ<p>دُو</>نَ"},{"n":22,"w":[["وَمَا","wamā","And what","এবং কি"],["لِىَ","liya","(is) for me","আমার জন্য (যুক্তি আছে যে)"],["لَآ","lā","(that) not","না"],["أَعْبُدُ","a‘budu","I worship","ইবাদত করবো আমি"],["ٱلَّذِى","alladhī","the One Who","(তাঁর) যিনি"],["فَطَرَنِى","faṭaranī","created me","আমাকে সৃষ্টি করেছেন"],["وَإِلَيْهِ","wa-ilayhi","and to Whom","ও তাঁরই দিকে"],["تُرْجَعُونَ","tur'ja‘ūna","you will be returned","তোমাদেরকে ফিরিয়ে নেয়া হবে"]],"t":"وَمَا لِىَ <o>لَآ</> أَعْبُدُ <h>ٱ</>لَّذِى فَطَرَنِى وَإِلَيْهِ تُرْجَ<p>عُو</>نَ"},{"n":23,"w":[["ءَأَتَّخِذُ","a-attakhidhu","Should I take","গ্রহণ করবো আমি কি"],["مِن","min","besides Him","ছাড়া"],["دُونِهِۦٓ","dūnihi","besides Him","তাঁকে"],["ءَالِهَةً","ālihatan","gods","উপাস্য (অন্য কাউকে)"],["إِن","in","If","(অথচ) যদি"],["يُرِدْنِ","yurid'ni","intends for me","আমাকে চান"],["ٱلرَّحْمَـٰنُ","l-raḥmānu","the Most Gracious","দয়াময়"],["بِضُرٍّۢ","biḍurrin","any harm","কোনো ক্ষতি করতে"],["لَّا","lā","not","না"],["تُغْنِ","tugh'ni","will avail","কাজে আসবে"],["عَنِّى","‘annī","[from] me","আমার জন্যে"],["شَفَـٰعَتُهُمْ","shafā‘atuhum","their intercession","তাদের সুপারিশ"],["شَيْـًۭٔا","shayan","(in) anything","কিছু মাত্র"],["وَلَا","walā","and not","আর না"],["يُنقِذُونِ","yunqidhūni","they (can) save me","আমাকে তারা উদ্ধার করতে পারবে"]],"t":"ءَأَتَّخِذُ مِ<k>ن دُ</>ونِ<o>هِۦٓ</> ءَالِهَةً <d>إِن يُ</>رِ<q>دْ</>نِ <h>ٱ</><l>ل</>رَّحْ<m>مَٰ</>نُ بِضُ<w>رٍّۢ لَّ</>ا تُغْنِ عَ<g>نِّ</>ى شَ<m>فَٰ</>عَتُهُمْ شَ<d>يْـًۭٔا وَ</>لَا يُ<k>نقِ</><p>ذُو</>نِ"},{"n":24,"w":[["إِنِّىٓ","innī","Indeed, I","নিশ্চয়ই আমি"],["إِذًۭا","idhan","then","তাহ'লে"],["لَّفِى","lafī","surely would be in","অবশ্যই মধ্যে হব"],["ضَلَـٰلٍۢ","ḍalālin","an error","বিভ্রান্তির"],["مُّبِينٍ","mubīnin","clear","সুস্পষ্ট"]],"t":"إِ<g>نِّ</><o>ىٓ</> إِ<w>ذًۭا لَّ</>فِى ضَ<m>لَٰ</><d>لٍۢ مُّ</><p>بِي</>نٍ"},{"n":25,"w":[["إِنِّىٓ","innī","Indeed, I","নিশ্চযই় আমি"],["ءَامَنتُ","āmantu","[I] have believed","আমি ঈমান এনেছি"],["بِرَبِّكُمْ","birabbikum","in your Lord","প্রতি তোমাদের রবের"],["فَٱسْمَعُونِ","fa-is'ma‘ūni","so listen to me","সুতরা তোমরা আমার কথা শোনো (ও মানো)\""]],"t":"إِ<g>نِّ</><o>ىٓ</> ءَامَ<k>نتُ</> بِرَبِّكُمْ فَ<h>ٱ</>سْمَ<p>عُو</>نِ"},{"n":26,"w":[["قِيلَ","qīla","It was said","(তাকে তারা হত্যা করলো এবং তাকে) বলা হলো"],["ٱدْخُلِ","ud'khuli","Enter","\"প্রবেশ করো"],["ٱلْجَنَّةَ ۖ","l-janata","Paradise","জান্নাতে\""],["قَالَ","qāla","He said","সে বললো"],["يَـٰلَيْتَ","yālayta","I wish","\"হায় আফসোস্‌"],["قَوْمِى","qawmī","my people","আমার জাতি"],["يَعْلَمُونَ","ya‘lamūna","knew","(যদি) জানতো"]],"t":"قِيلَ <h>ٱ</><q>دْ</>خُلِ <h>ٱ</>لْجَ<g>نَّ</>ةَ ۖ قَالَ <m>يَٰ</>لَيْتَ قَوْمِى يَعْلَ<p>مُو</>نَ"},{"n":27,"w":[["بِمَا","bimā","Of how","যে কারণে"],["غَفَرَ","ghafara","has forgiven","ক্ষমা করেছেন"],["لِى","lī","me","আমাকে"],["رَبِّى","rabbī","my Lord","আমার রব্‌"],["وَجَعَلَنِى","waja‘alanī","and placed me","ও আমাকে করেছেন"],["مِنَ","mina","among","অন্তর্ভুক্ত"],["ٱلْمُكْرَمِينَ","l-muk'ramīna","the honored ones","সম্মানিতদের\""]],"t":"بِمَا غَفَرَ لِى رَبِّى وَجَعَلَنِى مِنَ <h>ٱ</>لْمُكْرَ<p>مِي</>نَ"},{"n":28,"w":[["۞ وَمَآ","wamā","And not","এবং না"],["أَنزَلْنَا","anzalnā","We sent down","আমরা অবতীর্ণ করেছি"],["عَلَىٰ","‘alā","upon","বিরুদ্ধে"],["قَوْمِهِۦ","qawmihi","his people","তার জাতির"],["مِنۢ","min","after him","পরে"],["بَعْدِهِۦ","ba‘dihi","after him","তার"],["مِن","min","any","কোনো"],["جُندٍۢ","jundin","host","সৈন্য"],["مِّنَ","mina","from","থেকে"],["ٱلسَّمَآءِ","l-samāi","the heaven","আকাশ"],["وَمَا","wamā","and not","আর না"],["كُنَّا","kunnā","were We","আমরা ছিলাম"],["مُنزِلِينَ","munzilīna","(to) send down","অবতীর্ণকারী"]],"t":"۞ وَ<o>مَآ</> أَ<k>نزَ</>لْنَا عَلَىٰ قَوْمِ<m>هِۦ</> <i>مِنۢ بَ</>عْدِ<m>هِۦ</> مِ<k>ن جُ</>ن<d>دٍۢ مِّ</>نَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ وَمَا كُ<g>نَّ</>ا مُ<k>نزِ</><p>لِي</>نَ"},{"n":29,"w":[["إِن","in","Not","না"],["كَانَتْ","kānat","it was","ছিলো"],["إِلَّا","illā","but","এছাড়া"],["صَيْحَةًۭ","ṣayḥatan","a shout","মহাগর্জন"],["وَٰحِدَةًۭ","wāḥidatan","one","একটি মাত্র"],["فَإِذَا","fa-idhā","then behold","তখন"],["هُمْ","hum","They","তারা"],["خَـٰمِدُونَ","khāmidūna","(were) extinguished","নিথর নিস্তব্ধ হয়ে গেলো"]],"t":"إِ<k>ن كَ</>انَتْ إِلَّا صَيْحَ<d>ةًۭ وَٰ</>حِدَ<k>ةًۭ فَ</>إِذَا هُمْ <m>خَٰ</>مِ<p>دُو</>نَ"},{"n":30,"w":[["يَـٰحَسْرَةً","yāḥasratan","Alas","হায় পরিতাপ"],["عَلَى","‘alā","for","জন্য"],["ٱلْعِبَادِ ۚ","l-‘ibādi","the servants","দাসদের"],["مَا","mā","Not","না"],["يَأْتِيهِم","yatīhim","came to them","তাদেরর কাছে এসেছে"],["مِّن","min","any","(এমন) কোন"],["رَّسُولٍ","rasūlin","Messenger","রাসূল"],["إِلَّا","illā","but","এ ব্যতীত যে"],["كَانُوا۟","kānū","they did","তারা ছিলো"],["بِهِۦ","bihi","mock at him","তাঁর সাথে"],["يَسْتَهْزِءُونَ","yastahziūna","mock at him","ঠাট্টা বিদ্রূপ করতো"]],"t":"<m>يَٰ</>حَسْرَةً عَلَى <h>ٱ</>لْعِبَادِ ۚ مَا يَأْتِي<y>هِم مِّ</><w>ن رَّ</>سُولٍ إِلَّا كَانُو<s>ا۟</> بِ<m>هِۦ</> يَسْتَهْزِ<p>ءُو</>نَ"},{"n":31,"w":[["أَلَمْ","alam","Do not","দেখে নি কি"],["يَرَوْا۟","yaraw","they see","তারা"],["كَمْ","kam","how many","কত (জাতিকে)"],["أَهْلَكْنَا","ahlaknā","We destroyed","আমরা ধ্বংস করেছি"],["قَبْلَهُم","qablahum","before them","তাদের পূর্বে"],["مِّنَ","mina","of","মধ্য হ'তে"],["ٱلْقُرُونِ","l-qurūni","the generations","মানবগোষ্ঠীর"],["أَنَّهُمْ","annahum","That they","তারা যে"],["إِلَيْهِمْ","ilayhim","to them","তাদের মধ্যে"],["لَا","lā","will not return","না"],["يَرْجِعُونَ","yarji‘ūna","will not return","ফিরে আসবে"]],"t":"أَلَمْ يَرَوْ<s>ا۟</> كَمْ أَهْلَكْنَا قَ<q>بْ</>لَ<y>هُم مِّ</>نَ <h>ٱ</>لْقُرُونِ أَ<g>نَّ</>هُمْ إِلَيْهِمْ لَا يَرْجِ<p>عُو</>نَ"},{"n":32,"w":[["وَإِن","wa-in","And surely","এবং নি"],["كُلٌّۭ","kullun","all","কেউ (এমন)"],["لَّمَّا","lammā","then","এছাড়া"],["جَمِيعٌۭ","jamī‘un","together","সকলকেই"],["لَّدَيْنَا","ladaynā","before Us","আমাদের কাছে"],["مُحْضَرُونَ","muḥ'ḍarūna","(will be) brought","উপস্থিত করা হবে"]],"t":"وَإِ<k>ن كُ</><w>لٌّۭ لَّ</><g>مَّ</>ا جَمِي<w>عٌۭ لَّ</>دَيْنَا مُحْضَ<p>رُو</>نَ"},{"n":33,"w":[["وَءَايَةٌۭ","waāyatun","And a Sign","এবং (অন্যতম) নিদর্শন"],["لَّهُمُ","lahumu","for them","তাদের জন্য (রয়েছে)"],["ٱلْأَرْضُ","l-arḍu","(is) the earth","মাটি"],["ٱلْمَيْتَةُ","l-maytatu","dead","নিষ্প্রাণ"],["أَحْيَيْنَـٰهَا","aḥyaynāhā","We give it life","তাকে আমরা জীবিত করি"],["وَأَخْرَجْنَا","wa-akhrajnā","and We bring forth","ও আমরা উৎপন্ন করি"],["مِنْهَا","min'hā","from it","তা থেকে"],["حَبًّۭا","ḥabban","grain","শস্যদানা"],["فَمِنْهُ","famin'hu","and from it","অতঃপর তা থেকে"],["يَأْكُلُونَ","yakulūna","they eat","তারা খায়"]],"t":"وَءَايَ<w>ةٌۭ لَّ</>هُمُ <h>ٱ</>لْأَرْضُ <h>ٱ</>لْمَيْتَةُ أَحْيَيْ<m>نَٰ</>هَا وَأَخْرَ<q>جْ</>نَا مِنْهَا حَ<k>بًّۭا فَ</>مِنْهُ يَأْكُ<p>لُو</>نَ"},{"n":34,"w":[["وَجَعَلْنَا","waja‘alnā","And We placed","এবং আমরা বানিয়েছি"],["فِيهَا","fīhā","therein","তার মধ্যে"],["جَنَّـٰتٍۢ","jannātin","gardens","বাগানসমূহ"],["مِّن","min","of","থেকে"],["نَّخِيلٍۢ","nakhīlin","date-palms","খেজুরের"],["وَأَعْنَـٰبٍۢ","wa-a‘nābin","and grapevines","ও আঙ্গুরের"],["وَفَجَّرْنَا","wafajjarnā","and We caused to gush forth","এবং আমরা বইয়ে দিয়েছি"],["فِيهَا","fīhā","in it","তার মধ্যে"],["مِنَ","mina","of","মধ্য হতে"],["ٱلْعُيُونِ","l-‘uyūni","the springs","ঝর্ণা সমূহ"]],"t":"وَجَعَلْنَا فِيهَا جَ<g>نَّٰ</><d>تٍۢ مِّن نَّ</>خِي<d>لٍۢ وَ</>أَعْ<m>نَٰ</><d>بٍۢ وَ</>فَجَّرْنَا فِيهَا مِنَ <h>ٱ</>لْعُ<p>يُو</>نِ"},{"n":35,"w":[["لِيَأْكُلُوا۟","liyakulū","That they may eat","তারা খেতে পারে যেন"],["مِن","min","of","থেকে"],["ثَمَرِهِۦ","thamarihi","its fruit","তার ফলমূল"],["وَمَا","wamā","And not","অথচ নি"],["عَمِلَتْهُ","‘amilathu","made it","তা সৃষ্টি করেছে"],["أَيْدِيهِمْ ۖ","aydīhim","their hands","তাদের হাতগুলো"],["أَفَلَا","afalā","So will not","তবুও কি না"],["يَشْكُرُونَ","yashkurūna","they be grateful","তারা কৃতজ্ঞতা প্রকাশ করে"]],"t":"لِيَأْكُلُو<s>ا۟</> مِ<k>ن ثَ</>مَرِ<m>هِۦ</> وَمَا عَمِلَتْهُ أَيْدِيهِمْ ۖ أَفَلَا يَشْكُ<p>رُو</>نَ"},{"n":36,"w":[["سُبْحَـٰنَ","sub'ḥāna","Glory be","(আল্লাহ) মহান পবিত্র"],["ٱلَّذِى","alladhī","(to) the One Who","যিনি"],["خَلَقَ","khalaqa","created","সৃষ্টি করেছেন"],["ٱلْأَزْوَٰجَ","l-azwāja","(in) pairs","জোড়া জোড়া"],["كُلَّهَا","kullahā","all","সব কিছুকেই"],["مِمَّا","mimmā","of what","তা হ'তে যা"],["تُنۢبِتُ","tunbitu","grows","উৎপন্ন করে"],["ٱلْأَرْضُ","l-arḍu","the earth","ভূমি"],["وَمِنْ","wamin","and of","এবং মধ্য হ'তে"],["أَنفُسِهِمْ","anfusihim","themselves","তাদের নিজেদের (মানব জাতিরও)"],["وَمِمَّا","wamimmā","and of what","এবং তাহ'তেও যা"],["لَا","lā","not","না"],["يَعْلَمُونَ","ya‘lamūna","they know","(এখনও) তারা জানে"]],"t":"سُ<q>بْ</><m>حَٰ</>نَ <h>ٱ</>لَّذِى خَلَقَ <h>ٱ</>لْأَزْ<m>وَٰ</>جَ كُلَّهَا مِ<g>مَّ</>ا تُ<i>نۢبِ</>تُ <h>ٱ</>لْأَرْضُ وَمِنْ أَ<k>نفُ</>سِهِمْ وَمِ<g>مَّ</>ا لَا يَعْلَ<p>مُو</>نَ"},{"n":37,"w":[["وَءَايَةٌۭ","waāyatun","And a Sign","এবং (আরো) একটি নিদর্শন"],["لَّهُمُ","lahumu","for them","তাদের জন্যে"],["ٱلَّيْلُ","al-laylu","(is) the night","রাত"],["نَسْلَخُ","naslakhu","We withdraw","সরিয়ে দিই আমরা"],["مِنْهُ","min'hu","from it","তা থেকে"],["ٱلنَّهَارَ","l-nahāra","the day","দিনকে"],["فَإِذَا","fa-idhā","Then behold","অতঃপর তখন"],["هُم","hum","They","তারা"],["مُّظْلِمُونَ","muẓ'limūna","(are) those in darkness","অন্ধকারাচ্ছন্ন (হয়ে যায়)"]],"t":"وَءَايَ<w>ةٌۭ لَّ</>هُمُ <h>ٱ</>لَّيْلُ نَسْلَخُ مِنْهُ <h>ٱ</><l>ل</><g>نَّ</>هَارَ فَإِذَا <y>هُم مُّ</>ظْلِ<p>مُو</>نَ"},{"n":38,"w":[["وَٱلشَّمْسُ","wal-shamsu","And the sun","এবং সূর্য"],["تَجْرِى","tajrī","runs","আবর্তন করে"],["لِمُسْتَقَرٍّۢ","limus'taqarrin","to a term appointed","নির্দিষ্ট গন্ডির মধ্যে"],["لَّهَا ۚ","lahā","for it","তার"],["ذَٰلِكَ","dhālika","That","এটা"],["تَقْدِيرُ","taqdīru","(is the) Decree","নির্দিষ্ট (হিসাব)"],["ٱلْعَزِيزِ","l-‘azīzi","(of) the All-Mighty","পরাক্রমশালীর"],["ٱلْعَلِيمِ","l-‘alīmi","the All-Knowing","(যিনি) সুবিজ্ঞ"]],"t":"وَ<h>ٱ</><l>ل</>شَّمْسُ تَ<q>جْ</>رِى لِمُسْتَقَ<w>رٍّۢ لَّ</>هَا ۚ <m>ذَٰ</>لِكَ تَ<q>قْ</>دِيرُ <h>ٱ</>لْعَزِيزِ <h>ٱ</>لْعَ<p>لِي</>مِ"},{"n":39,"w":[["وَٱلْقَمَرَ","wal-qamara","And the moon ","এবং চাঁদকে"],["قَدَّرْنَـٰهُ","qaddarnāhu","We have ordained for it","তার আমরা নির্দিষ্ট করেছি"],["مَنَازِلَ","manāzila","phases","বিভিন্ন কক্ষপথ (যার উপর চলে)"],["حَتَّىٰ","ḥattā","until","অবশেষে"],["عَادَ","‘āda","it returns","সে ফিরে আসে"],["كَٱلْعُرْجُونِ","kal-‘ur'jūni","like the date stalk","খেজুর শাখার মতো"],["ٱلْقَدِيمِ","l-qadīmi","the old","(এমন যা শুষ্ক) পুরান"]],"t":"وَ<h>ٱ</>لْقَمَرَ قَدَّرْ<m>نَٰ</>هُ مَنَازِلَ حَتَّىٰ عَادَ كَ<h>ٱ</>لْعُرْجُونِ <h>ٱ</>لْقَ<p>دِي</>مِ"},{"n":40,"w":[["لَا","lā","Not","না"],["ٱلشَّمْسُ","l-shamsu","the sun","সূর্য"],["يَنۢبَغِى","yanbaghī","is permitted","ক্ষমতা রাখে"],["لَهَآ","lahā","for it ","তার জন্যে"],["أَن","an","that","যে"],["تُدْرِكَ","tud'rika","it overtakes","নাগাল পাবে"],["ٱلْقَمَرَ","l-qamara","the moon","চাঁদের"],["وَلَا","walā","and not","আর না"],["ٱلَّيْلُ","al-laylu","the night","রাত"],["سَابِقُ","sābiqu","(can) outstrip","অতিক্রমকারী (হ'তে পারে)"],["ٱلنَّهَارِ ۚ","l-nahāri","the day","দিনের"],["وَكُلٌّۭ","wakullun","but all","এবং প্রত্যেকে"],["فِى","fī","in","উপর"],["فَلَكٍۢ","falakin","an orbit","কক্ষের"],["يَسْبَحُونَ","yasbaḥūna","they are floating","সাঁতার কাটছে"]],"t":"لَا <h>ٱ</><l>ل</>شَّمْسُ يَ<i>نۢبَ</>غِى لَ<o>هَآ</> أَ<k>ن تُ</><q>دْ</>رِكَ <h>ٱ</>لْقَمَرَ وَلَا <h>ٱ</>لَّيْلُ سَابِقُ <h>ٱ</><l>ل</><g>نَّ</>هَارِ ۚ وَكُ<k>لٌّۭ فِ</>ى فَلَ<d>كٍۢ يَ</>سْبَ<p>حُو</>نَ"},{"n":41,"w":[["وَءَايَةٌۭ","waāyatun","And a Sign","এবং একটি নিদর্শন"],["لَّهُمْ","lahum","for them","তাদের জন্যে"],["أَنَّا","annā","(is) that","(এও) যে আমরা"],["حَمَلْنَا","ḥamalnā","We carried","আমরা আরোহণ করিয়েছি"],["ذُرِّيَّتَهُمْ","dhurriyyatahum","their offspring","তাদের বংশধরদেরকে"],["فِى","fī","in","মধ্যে"],["ٱلْفُلْكِ","l-ful'ki","the ship","জাহাজের"],["ٱلْمَشْحُونِ","l-mashḥūni","laden","বোঝাই"]],"t":"وَءَايَ<w>ةٌۭ لَّ</>هُمْ أَ<g>نَّ</>ا حَمَلْنَا ذُرِّيَّتَهُمْ فِى <h>ٱ</>لْفُلْكِ <h>ٱ</>لْمَشْ<p>حُو</>نِ"},{"n":42,"w":[["وَخَلَقْنَا","wakhalaqnā","And We created","এবং আমরা সৃষ্টি করেছি"],["لَهُم","lahum","for them","তাদের জন্যে"],["مِّن","min","from","থেকে"],["مِّثْلِهِۦ","mith'lihi","(the) likes of it","সেটার অনুরূপ (আরো অনেকে)"],["مَا","mā","what","যাতে"],["يَرْكَبُونَ","yarkabūna","they ride","তারা চড়তে পারে"]],"t":"وَخَلَ<q>قْ</>نَا لَ<y>هُم مِّ</><d>ن مِّ</>ثْلِ<m>هِۦ</> مَا يَرْكَ<p>بُو</>نَ"},{"n":43,"w":[["وَإِن","wa-in","And if","এবং যদি"],["نَّشَأْ","nasha","We will","আমরা চাই"],["نُغْرِقْهُمْ","nugh'riq'hum","We could drown them","তাদেরকে ডোবাতে আমরা"],["فَلَا","falā","then not","তখন না"],["صَرِيخَ","ṣarīkha","(would be) a responder to a cry","ডাকে সাড়াদানকারী (পাবে)"],["لَهُمْ","lahum","for them","তাদের জন্যে"],["وَلَا","walā","and not","আর না"],["هُمْ","hum","they","তাদের"],["يُنقَذُونَ","yunqadhūna","would be saved","নিস্তার পাবে"]],"t":"وَ<d>إِن نَّ</>شَأْ نُغْرِ<q>قْ</>هُمْ فَلَا صَرِيخَ لَهُمْ وَلَا هُمْ يُ<k>نقَ</><p>ذُو</>نَ"},{"n":44,"w":[["إِلَّا","illā","Except","কিন্তু"],["رَحْمَةًۭ","raḥmatan","(by) Mercy","অনুগ্রহ"],["مِّنَّا","minnā","from Us","আমাদের পক্ষ হ'তে"],["وَمَتَـٰعًا","wamatā‘an","and provision","এবং জীবনোপভোগ"],["إِلَىٰ","ilā","for","পর্যন্ত"],["حِينٍۢ","ḥīnin","a time","কিছুকাল"]],"t":"إِلَّا رَحْمَ<d>ةًۭ مِّ</><g>نَّ</>ا وَمَ<m>تَٰ</>عًا إِلَىٰ <p>حِي</>نٍۢ"},{"n":45,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["قِيلَ","qīla","it is said","বলা হয়"],["لَهُمُ","lahumu","to them","তাদেরকে"],["ٱتَّقُوا۟","ittaqū","Fear","\"তোমরা ভয় করো"],["مَا","mā","what","(পরিণামের) যা"],["بَيْنَ","bayna","(is) before you","সামনে"],["أَيْدِيكُمْ","aydīkum","(is) before you","তোমাদের"],["وَمَا","wamā","and what","এবং যা"],["خَلْفَكُمْ","khalfakum","(is) behind you","তোমাদের পিছনে (আছে)"],["لَعَلَّكُمْ","la‘allakum","so that you may","তোমাদের যাতে (উপর)"],["تُرْحَمُونَ","tur'ḥamūna","receive mercy","অনুগ্রহ করা যায়\""]],"t":"وَإِذَا قِيلَ لَهُمُ <h>ٱ</>تَّقُو<s>ا۟</> مَا بَيْنَ أَيْدِيكُمْ وَمَا خَلْفَكُمْ لَعَلَّكُمْ تُرْحَ<p>مُو</>نَ"},{"n":46,"w":[["وَمَا","wamā","And not","এবং না"],["تَأْتِيهِم","tatīhim","comes to them","তাদের কাছে এসেছে"],["مِّنْ","min","of","(এমন) কোনো"],["ءَايَةٍۢ","āyatin","a Sign","নিদর্শন"],["مِّنْ","min","from","মধ্য হ'তে"],["ءَايَـٰتِ","āyāti","(the) Signs","নিদর্শনের"],["رَبِّهِمْ","rabbihim","(of) their Lord","তাদের রবের"],["إِلَّا","illā","but","এছাড়া"],["كَانُوا۟","kānū","they","তারা ছিলো"],["عَنْهَا","‘anhā","from it","তা হ'তে"],["مُعْرِضِينَ","mu‘'riḍīna","turn away","উপেক্ষাকারী"]],"t":"وَمَا تَأْتِي<y>هِم مِّ</>نْ ءَايَ<d>ةٍۢ مِّ</>نْ ءَا<m>يَٰ</>تِ رَبِّهِمْ إِلَّا كَانُو<s>ا۟</> عَنْهَا مُعْرِ<p>ضِي</>نَ"},{"n":47,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["قِيلَ","qīla","it is said","বলা হয়"],["لَهُمْ","lahum","to them","তাদেরকে"],["أَنفِقُوا۟","anfiqū","Spend","\"তোমরা ব্যয় করো"],["مِمَّا","mimmā","from what","তাহ'তে যা"],["رَزَقَكُمُ","razaqakumu","(has) provided you","তোমাদেরকে জীবিকা দিয়েছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ\""],["قَالَ","qāla","Said","বলে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieved","অস্বীকার করেছে"],["لِلَّذِينَ","lilladhīna","to those who","তাদেরকে (যারা)"],["ءَامَنُوٓا۟","āmanū","believed","ঈমান এনেছে"],["أَنُطْعِمُ","anuṭ'‘imu","Should we feed","\"খাওয়াবো আমরা কি"],["مَن","man","whom","যাকে (এমন কাউকে)"],["لَّوْ","law","if","যদি"],["يَشَآءُ","yashāu","Allah willed ","ইচ্ছে করতেন"],["ٱللَّهُ","l-lahu","Allah willed ","আল্লাহ্‌"],["أَطْعَمَهُۥٓ","aṭ‘amahu","He would have fed him","তাকে খাওয়াতে পারতেন\""],["إِنْ","in","Not","না"],["أَنتُمْ","antum","(are) you","তোমরা"],["إِلَّا","illā","except","এছাড়া"],["فِى","fī","in","মধ্যে"],["ضَلَـٰلٍۢ","ḍalālin","an error","বিভ্রান্তির"],["مُّبِينٍۢ","mubīnin","clear","সুস্পষ্ট"]],"t":"وَإِذَا قِيلَ لَهُمْ أَ<k>نفِ</>قُو<s>ا۟</> مِ<g>مَّ</>ا رَزَقَكُمُ <h>ٱ</>للَّهُ قَالَ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> لِلَّذِينَ ءَامَ<o>نُوٓ</><s>ا۟</> أَنُ<q>طْ</>عِمُ <w>مَن لَّ</>وْ يَ<o>شَآ</>ءُ <h>ٱ</>للَّهُ أَ<q>طْ</>عَمَهُ<o>ۥٓ</> إِنْ أَ<k>نتُ</>مْ إِلَّا فِى ضَ<m>لَٰ</><d>لٍۢ مُّ</><p>بِي</>نٍۢ"},{"n":48,"w":[["وَيَقُولُونَ","wayaqūlūna","And they say","এবং তারা বলে"],["مَتَىٰ","matā","When (is)","\"কখন (পূর্ণ হবে)"],["هَـٰذَا","hādhā","this","সেই"],["ٱلْوَعْدُ","l-wa‘du","promise","(কেয়ামতের) প্রতিশ্রুতি"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you are","তোমরা হও"],["صَـٰدِقِينَ","ṣādiqīna","truthful","সত্যবাদী\""]],"t":"وَيَقُولُونَ مَتَىٰ <m>هَٰ</>ذَا <h>ٱ</>لْوَعْدُ إِ<k>ن كُنتُ</>مْ <m>صَٰ</>دِ<p>قِي</>نَ"},{"n":49,"w":[["مَا","mā","Not","না"],["يَنظُرُونَ","yanẓurūna","they await","তারা অপেক্ষা করছে"],["إِلَّا","illā","except","এছাড়া"],["صَيْحَةًۭ","ṣayḥatan","a shout","মহাগর্জনের"],["وَٰحِدَةًۭ","wāḥidatan","one","একটি মাত্র"],["تَأْخُذُهُمْ","takhudhuhum","it will seize them","তাদেরকে আঘাত করবে"],["وَهُمْ","wahum","while they","এ অবস্থায় যে তারা"],["يَخِصِّمُونَ","yakhiṣṣimūna","are disputing","তর্কাতর্কি করতে থাকবে"]],"t":"مَا يَ<k>نظُ</>رُونَ إِلَّا صَيْحَ<d>ةًۭ وَٰ</>حِدَ<k>ةًۭ تَ</>أْخُذُهُمْ وَهُمْ يَخِصِّ<p>مُو</>نَ"},{"n":50,"w":[["فَلَا","falā","Then not","না তখন"],["يَسْتَطِيعُونَ","yastaṭī‘ūna","they will be able","তারা সমর্থ হবে"],["تَوْصِيَةًۭ","tawṣiyatan","(to) make a will","উপদেশ করতে"],["وَلَآ","walā","and not","আর না"],["إِلَىٰٓ","ilā","to","প্রতি"],["أَهْلِهِمْ","ahlihim","their people","তাদের পরিবারের"],["يَرْجِعُونَ","yarji‘ūna","they (can) return","তারা ফিরে যেতে পারবে"]],"t":"فَلَا يَسْتَطِيعُونَ تَوْصِيَ<d>ةًۭ وَ</><o>لَآ</> إِلَ<o>ىٰٓ</> أَهْلِهِمْ يَرْجِ<p>عُو</>نَ"},{"n":51,"w":[["وَنُفِخَ","wanufikha","And will be blown","এবং ফুঁ দেওয়া হবে"],["فِى","fī","[in]","মধ্যে"],["ٱلصُّورِ","l-ṣūri","the trumpet","শিঙ্গার"],["فَإِذَا","fa-idhā","and behold","তখন অতঃপর"],["هُم","hum","They","তারা"],["مِّنَ","mina","from","হ'তে"],["ٱلْأَجْدَاثِ","l-ajdāthi","the graves","কবরসমূহ"],["إِلَىٰ","ilā","to","দিকে"],["رَبِّهِمْ","rabbihim","their Lord","তাদের রবের"],["يَنسِلُونَ","yansilūna","[they] will hasten","ছুটে আসবে"]],"t":"وَنُفِخَ فِى <h>ٱ</><l>ل</>صُّورِ فَإِذَا <y>هُم مِّ</>نَ <h>ٱ</>لْأَ<q>جْ</>دَاثِ إِلَىٰ رَبِّهِمْ يَ<k>نسِ</><p>لُو</>نَ"},{"n":52,"w":[["قَالُوا۟","qālū","They [will] say","(ভীত হয়ে) তারা বলবে"],["يَـٰوَيْلَنَا","yāwaylanā","O woe to us","\"আমাদের দুর্ভোগ হায়"],["مَنۢ","man","Who","কে"],["بَعَثَنَا","ba‘athanā","has raised us","আমাদেরকে উঠালো"],["مِن","min","from","হ'তে"],["مَّرْقَدِنَا ۜ ۗ","marqadinā","our sleeping place","আমাদের ঘুমের স্হান\""],["هَـٰذَا","hādhā","This (is)","\"এটাই"],["مَا","mā","What","(তাই) যার"],["وَعَدَ","wa‘ada","(had) promised","প্রতিশ্রুতি দিয়েছিলেন"],["ٱلرَّحْمَـٰنُ","l-raḥmānu","the Most Gracious","দয়াময়"],["وَصَدَقَ","waṣadaqa","and told (the) truth","এবং সত্যই বলেছিলেন"],["ٱلْمُرْسَلُونَ","l-mur'salūna","the Messengers","রাসূলগণ\""]],"t":"قَالُ