ades","ছায়ার"],["عَلَى","‘alā","on","উপর"],["ٱلْأَرَآئِكِ","l-arāiki","[the] couches","সুসজ্জিত আসনে"],["مُتَّكِـُٔونَ","muttakiūna","reclining","হেলান দিয়ে বসবে"]],"t":"هُمْ وَأَزْ<m>وَٰ</>جُهُمْ فِى ظِ<m>لَٰ</>لٍ عَلَى <h>ٱ</>لْأَ<o>رَآ</>ئِكِ مُتَّ<p>كِـُٔو</>نَ"},{"n":57,"w":[["لَهُمْ","lahum","For them","তাদের জন্যে (থাকবে)"],["فِيهَا","fīhā","therein","তার মধ্যে"],["فَـٰكِهَةٌۭ","fākihatun","(are) fruits","ফলমূল"],["وَلَهُم","walahum","and for them","ও তাদের জন্যে (থাকবে)"],["مَّا","mā","(is) whatever","যা"],["يَدَّعُونَ","yadda‘ūna","they call for","তারা চাইবে"]],"t":"لَهُمْ فِيهَا <m>فَٰ</>كِهَ<d>ةٌۭ وَ</>لَ<y>هُم مَّ</>ا يَدَّ<p>عُو</>نَ"},{"n":58,"w":[["سَلَـٰمٌۭ","salāmun","Peace","\"সালাম\""],["قَوْلًۭا","qawlan","A word","বলা (হবে)"],["مِّن","min","from","পক্ষ হ'তে"],["رَّبٍّۢ","rabbin","a Lord","রবের"],["رَّحِيمٍۢ","raḥīmin","Most Merciful","(যিনি) পরম দয়ালু"]],"t":"سَ<m>لَٰ</><k>مٌۭ قَ</>وْلًۭ<d>ا مِّ</><w>ن رَّبٍّۢ رَّ</><p>حِي</>مٍۢ"},{"n":59,"w":[["وَٱمْتَـٰزُوا۟","wa-im'tāzū","But stand apart","\"এবং (বলা হবে) তোমারা আলাদা হয়ে যাও"],["ٱلْيَوْمَ","l-yawma","today","আজ"],["أَيُّهَا","ayyuhā","O criminals","হে"],["ٱلْمُجْرِمُونَ","l-muj'rimūna","O criminals","অপরাধীরা"]],"t":"وَ<h>ٱ</>مْ<m>تَٰ</>زُو<s>ا۟</> <h>ٱ</>لْيَوْمَ أَيُّهَا <h>ٱ</>لْمُ<q>جْ</>رِ<p>مُو</>نَ"},{"n":60,"w":[["۞ أَلَمْ","alam","Did not","দিই নি কি"],["أَعْهَدْ","a‘had","I enjoin","আমি নির্দেশ"],["إِلَيْكُمْ","ilaykum","upon you","তোমাদের প্রতি"],["يَـٰبَنِىٓ","yābanī","O Children of Adam","হে সন্তান"],["ءَادَمَ","ādama","O Children of Adam","আদমের"],["أَن","an","That","যে"],["لَّا","lā","(do) not","না"],["تَعْبُدُوا۟","ta‘budū","worship","তোমরা দাসত্ব করো"],["ٱلشَّيْطَـٰنَ ۖ","l-shayṭāna","the Shaitaan","শয়তানের"],["إِنَّهُۥ","innahu","indeed, he","সে নিশ্চয়ই"],["لَكُمْ","lakum","(is) for you","তোমাদের জন্যে"],["عَدُوٌّۭ","‘aduwwun","an enemy","শত্রু"],["مُّبِينٌۭ","mubīnun","clear","প্রকাশ্য"]],"t":"۞ أَلَمْ أَعْهَ<q>دْ</> إِلَيْكُمْ <m>يَٰ</>بَ<o>نِىٓ</> ءَادَمَ <w>أَن لَّ</>ا تَعْبُدُو<s>ا۟</> <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نَ ۖ إِ<g>نَّ</>هُ<m>ۥ</> لَكُمْ عَدُ<d>وٌّۭ مُّ</><p>بِي</>نٌۭ"},{"n":61,"w":[["وَأَنِ","wa-ani","And that","এবং (এও) যে"],["ٱعْبُدُونِى ۚ","u‘'budūnī","you worship Me","আমারই তোমরা ইবাদত করো"],["هَـٰذَا","hādhā","This","এটাই"],["صِرَٰطٌۭ","ṣirāṭun","(is) a Path","পথ"],["مُّسْتَقِيمٌۭ","mus'taqīmun","Straight","সরল সঠিক"]],"t":"وَأَنِ <h>ٱ</>عْبُدُونِى ۚ <m>هَٰ</>ذَا صِ<m>رَٰ</><d>طٌۭ مُّ</>سْتَ<p>قِي</>مٌۭ"},{"n":62,"w":[["وَلَقَدْ","walaqad","And indeed","এবং (এ সত্ত্বেও) নিশ্চয়ই"],["أَضَلَّ","aḍalla","he led astray","সে পথ ভ্রষ্ট করেছে"],["مِنكُمْ","minkum","from you","তোমাদের মধ্য হ'তে"],["جِبِلًّۭا","jibillan","a multitude","বড় দলকে"],["كَثِيرًا ۖ","kathīran","great","অনেক"],["أَفَلَمْ","afalam","Then did not","তবুও কি না"],["تَكُونُوا۟","takūnū","you","হবে"],["تَعْقِلُونَ","ta‘qilūna","use reason","তোমরা বুঝতে"]],"t":"وَلَقَ<q>دْ</> أَضَلَّ مِ<k>نكُ</>مْ جِبِ<k>لًّۭا كَ</>ثِيرًا ۖ أَفَلَمْ تَكُونُو<s>ا۟</> تَعْقِ<p>لُو</>نَ"},{"n":63,"w":[["هَـٰذِهِۦ","hādhihi","This (is)","এই সেই"],["جَهَنَّمُ","jahannamu","(the) Hell","জাহান্নাম"],["ٱلَّتِى","allatī","which","যার"],["كُنتُمْ","kuntum","you were","তোমাদের"],["تُوعَدُونَ","tū‘adūna","promised","প্রতিশ্রুতি দেয়া হয়েছিলো"]],"t":"<m>هَٰذِهِۦ</> جَهَ<g>نَّ</>مُ <h>ٱ</>لَّتِى كُ<k>نتُ</>مْ تُوعَ<p>دُو</>نَ"},{"n":64,"w":[["ٱصْلَوْهَا","iṣ'lawhā","Burn therein","তাতে তোমরা প্রবেশ করো"],["ٱلْيَوْمَ","l-yawma","today","আজ"],["بِمَا","bimā","because","বিনিময়ে যা"],["كُنتُمْ","kuntum","you used to","তোমরা"],["تَكْفُرُونَ","takfurūna","disbelieve","অস্বীকার করছিলে\""]],"t":"ٱصْلَوْهَا <h>ٱ</>لْيَوْمَ بِمَا كُ<k>نتُ</>مْ تَكْفُ<p>رُو</>نَ"},{"n":65,"w":[["ٱلْيَوْمَ","al-yawma","This Day","আজ"],["نَخْتِمُ","nakhtimu","We will seal","সীল করে দিবো আমরা"],["عَلَىٰٓ","‘alā","[on]","উপর"],["أَفْوَٰهِهِمْ","afwāhihim","their mouths","তাদের মুখগুলোর"],["وَتُكَلِّمُنَآ","watukallimunā","and will speak to Us","এবং আমাদের সাথে কথা বলবে"],["أَيْدِيهِمْ","aydīhim","their hands","তাদের হাতগুলো"],["وَتَشْهَدُ","watashhadu","and will bear witness","এবং সাক্ষ্য দিবে"],["أَرْجُلُهُم","arjuluhum","their feet","তাদের পাগুলো"],["بِمَا","bimā","about what","ঐ বিষয়ে যা"],["كَانُوا۟","kānū","they used to","করেছিলো"],["يَكْسِبُونَ","yaksibūna","earn","তারা কামাই"]],"t":"ٱلْيَوْمَ نَخْتِمُ عَلَ<o>ىٰٓ</> أَفْ<m>وَٰ</>هِهِمْ وَتُكَلِّمُ<o>نَآ</> أَيْدِيهِمْ وَتَشْهَدُ أَرْجُلُ<f>هُم بِ</>مَا كَانُو<s>ا۟</> يَكْسِ<p>بُو</>نَ"},{"n":66,"w":[["وَلَوْ","walaw","And if","এবং যদি"],["نَشَآءُ","nashāu","We willed","চাই আমরা"],["لَطَمَسْنَا","laṭamasnā","We (would have) surely obliterated","দিতে পারি অবশ্যই"],["عَلَىٰٓ","‘alā","[over]","আমরা আলো নিভিয়ে"],["أَعْيُنِهِمْ","a‘yunihim","their eyes","তাদের চোখের"],["فَٱسْتَبَقُوا۟","fa-is'tabaqū","then they (would) race","তারা অতঃপর চলতে চাইতো"],["ٱلصِّرَٰطَ","l-ṣirāṭa","(to find) the path","পথে"],["فَأَنَّىٰ","fa-annā","then how","তখন কেমন করে"],["يُبْصِرُونَ","yub'ṣirūna","(could) they see","তারা দেখতে পাবে"]],"t":"وَلَوْ نَ<o>شَآ</>ءُ لَطَمَسْنَا عَلَ<o>ىٰٓ</> أَعْيُنِهِمْ فَ<h>ٱ</>سْتَبَقُو<s>ا۟</> <h>ٱ</><l>ل</>صِّ<m>رَٰ</>طَ فَأَ<g>نَّ</>ىٰ يُ<q>بْ</>صِ<p>رُو</>نَ"},{"n":67,"w":[["وَلَوْ","walaw","And if","এবং যদি"],["نَشَآءُ","nashāu","We willed","চাই আমরা"],["لَمَسَخْنَـٰهُمْ","lamasakhnāhum","surely, We (would have) transformed them","তাদেরকে আমরা অবশ্যই বিকৃত করে দিতে পারি"],["عَلَىٰ","‘alā","in","উপর"],["مَكَانَتِهِمْ","makānatihim","their places","তাদের (নিজ নিজ) অবস্থানেই"],["فَمَا","famā","then not","অতঃপর না"],["ٱسْتَطَـٰعُوا۟","is'taṭā‘ū","they would have been able","তারা সমর্থ হবে"],["مُضِيًّۭا","muḍiyyan","to proceed","আগে যেতে"],["وَلَا","walā","and not","আর না"],["يَرْجِعُونَ","yarji‘ūna","return","পিছনে ফিরতে"]],"t":"وَلَوْ نَ<o>شَآ</>ءُ لَمَسَخْ<m>نَٰ</>هُمْ عَلَىٰ مَكَانَتِهِمْ فَمَا <h>ٱ</>سْتَ<m>طَٰ</>عُو<s>ا۟</> مُضِ<d>يًّۭا وَ</>لَا يَرْجِ<p>عُو</>نَ"},{"n":68,"w":[["وَمَن","waman","And (he) whom","এবং কোনো ব্যক্তি"],["نُّعَمِّرْهُ","nu‘ammir'hu","We grant him long life","যাকে দীর্ঘায়ু দিই আমরা"],["نُنَكِّسْهُ","nunakkis'hu","We reverse him","উল্টিয়ে দিই আমরা তার"],["فِى","fī","in","মধ্যে"],["ٱلْخَلْقِ ۖ","l-khalqi","the creation","আকৃতি-প্রকৃতির (বুদ্ধি ও যোগ্যতার)"],["أَفَلَا","afalā","Then will not","তবুও কি না"],["يَعْقِلُونَ","ya‘qilūna","they use intellect","তারা জ্ঞানবুদ্ধি কাজে লাগায়"]],"t":"وَ<d>مَن نُّ</>عَ<g>مِّ</>رْهُ نُنَكِّسْهُ فِى <h>ٱ</>لْخَلْقِ ۖ أَفَلَا يَعْقِ<p>لُو</>نَ"},{"n":69,"w":[["وَمَا","wamā","And not","এবং না"],["عَلَّمْنَـٰهُ","‘allamnāhu","We taught him","তাকে আমরা শিখিয়েছি"],["ٱلشِّعْرَ","l-shi‘'ra","[the] poetry","কবিতা"],["وَمَا","wamā","and not","আর না"],["يَنۢبَغِى","yanbaghī","it is befitting","শোভা পায় (এটা)"],["لَهُۥٓ ۚ","lahu","for him","তার জন্যে"],["إِنْ","in","Not","না"],["هُوَ","huwa","it","তা"],["إِلَّا","illā","(is) except","এছাড়া"],["ذِكْرٌۭ","dhik'run","a Reminder","উপদেশ"],["وَقُرْءَانٌۭ","waqur'ānun","and a Quran","ও (পাঠযোগ্য কিতাব) কোরআন"],["مُّبِينٌۭ","mubīnun","clear","সুস্পষ্ট"]],"t":"وَمَا عَلَّمْ<m>نَٰ</>هُ <h>ٱ</><l>ل</>شِّعْرَ وَمَا يَ<i>نۢبَ</>غِى لَهُ<o>ۥٓ ۚ</> إِنْ هُوَ إِلَّا ذِكْ<d>رٌۭ وَ</>قُرْءَا<d>نٌۭ مُّ</><p>بِي</>نٌۭ"},{"n":70,"w":[["لِّيُنذِرَ","liyundhira","To warn","সতর্ক করে যেন"],["مَن","man","(him) who","(এমন প্রত্যেককে) যে"],["كَانَ","kāna","is","হলো"],["حَيًّۭا","ḥayyan","alive","জীবিত"],["وَيَحِقَّ","wayaḥiqqa","and may be proved true","এবং প্রতিষ্ঠিত হতে পারে (যেন)"],["ٱلْقَوْلُ","l-qawlu","the Word","(শাস্তির) বাণী"],["عَلَى","‘alā","against","বিরুদ্ধে"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","the disbelievers","কাফিরদের"]],"t":"لِّيُ<k>نذِ</>رَ مَ<k>ن كَ</>انَ حَ<d>يًّۭا وَ</>يَحِقَّ <h>ٱ</>لْقَوْلُ عَلَى <h>ٱ</>لْ<m>كَٰ</>فِ<p>رِي</>نَ"},{"n":71,"w":[["أَوَلَمْ","awalam","Do not","নি কি"],["يَرَوْا۟","yaraw","they see","তারা দেখে"],["أَنَّا","annā","that We","যে আমরা"],["خَلَقْنَا","khalaqnā","[We] created","আমরা সৃষ্টি করেছি"],["لَهُم","lahum","for them","তাদের জন্যে"],["مِّمَّا","mimmā","from what","সেসব থেকে যা"],["عَمِلَتْ","‘amilat","have made","সৃষ্টি করেছে"],["أَيْدِينَآ","aydīnā","Our hands","আমাদের হাতগুলো"],["أَنْعَـٰمًۭا","an‘āman","cattle","(যেমন) গবাদি পশু"],["فَهُمْ","fahum","then they","এখন তারাই"],["لَهَا","lahā","[for them]","সেগুলোর"],["مَـٰلِكُونَ","mālikūna","(are the) owners","মালিক"]],"t":"أَوَلَمْ يَرَوْ<s>ا۟</> أَ<g>نَّ</>ا خَلَ<q>قْ</>نَا لَ<y>هُم مِّ</><g>مَّ</>ا عَمِلَتْ أَيْدِي<o>نَآ</> أَنْ<m>عَٰ</><k>مًۭا فَ</>هُمْ لَهَا <m>مَٰ</>لِ<p>كُو</>نَ"},{"n":72,"w":[["وَذَلَّلْنَـٰهَا","wadhallalnāhā","And We have tamed them","এবং সেগুলোকে আমরা বশীভূত করেছি"],["لَهُمْ","lahum","for them","তাদের জন্যে"],["فَمِنْهَا","famin'hā","so some of them ","অতঃপর (রয়েছে) সেগুলোর কিছু কিছু"],["رَكُوبُهُمْ","rakūbuhum","they ride them","তাদের বাহনও (যেমন উট)"],["وَمِنْهَا","wamin'hā","and some of them","এবং সেগুলোর কিছু কিছু"],["يَأْكُلُونَ","yakulūna","they eat","তারা আহারও করে"]],"t":"وَذَلَّلْ<m>نَٰ</>هَا لَهُمْ فَمِنْهَا رَكُوبُهُمْ وَمِنْهَا يَأْكُ<p>لُو</>نَ"},{"n":73,"w":[["وَلَهُمْ","walahum","And for them","এবং তাদের জন্যে রয়েছে"],["فِيهَا","fīhā","therein","সেগুলোর মধ্যে"],["مَنَـٰفِعُ","manāfi‘u","(are) benefits","(নানা রকম) উপকার"],["وَمَشَارِبُ ۖ","wamashāribu","and drinks","এবং (নানা প্রকার) পানীয়"],["أَفَلَا","afalā","so (will) not","তবুও কি না"],["يَشْكُرُونَ","yashkurūna","they give thanks","তারা কৃতজ্ঞ হবে"]],"t":"وَلَهُمْ فِيهَا مَ<m>نَٰ</>فِعُ وَمَشَارِبُ ۖ أَفَلَا يَشْكُ<p>رُو</>نَ"},{"n":74,"w":[["وَٱتَّخَذُوا۟","wa-ittakhadhū","But they have taken","এবং (এ সত্ত্বেও) তারা গ্রহণ করেছে"],["مِن","min","besides","মধ্য হতে"],["دُونِ","dūni","besides","ছাড়া"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["ءَالِهَةًۭ","ālihatan","gods","উপাস্যরূপে (অন্যদেরকে)"],["لَّعَلَّهُمْ","la‘allahum","that they may","তারা যাতে"],["يُنصَرُونَ","yunṣarūna","be helped","তারা সাহায্য পাবে"]],"t":"وَ<h>ٱ</>تَّخَذُو<s>ا۟</> مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ ءَالِهَ<w>ةًۭ لَّ</>عَلَّهُمْ يُ<k>نصَ</><p>رُو</>نَ"},{"n":75,"w":[["لَا","lā","Not","না"],["يَسْتَطِيعُونَ","yastaṭī‘ūna","they are able","তারা সমর্থ হবে"],["نَصْرَهُمْ","naṣrahum","to help them","তাদের সাহায্য করতে"],["وَهُمْ","wahum","but they ","বরং তারাই (হয়ে আছে)"],["لَهُمْ","lahum","for them","তাদের জন্যে"],["جُندٌۭ","jundun","(are) hosts","সৈন্য (রক্ষাকারী রূপে)"],["مُّحْضَرُونَ","muḥ'ḍarūna","(who will) be brought","সদা উপস্থিত"]],"t":"لَا يَسْتَطِيعُونَ نَصْرَهُمْ وَهُمْ لَهُمْ جُن<d>دٌۭ مُّ</>حْضَ<p>رُو</>نَ"},{"n":76,"w":[["فَلَا","falā","So (let) not","কাজেই না (যেন)"],["يَحْزُنكَ","yaḥzunka","grieve you","তোমাকে দুঃখ দেয়"],["قَوْلُهُمْ ۘ","qawluhum","their speech","তাদের কথা"],["إِنَّا","innā","Indeed, We","আমরা নিশ্চয়ই"],["نَعْلَمُ","na‘lamu","[We] know","জানি আমরা"],["مَا","mā","what","যা"],["يُسِرُّونَ","yusirrūna","they conceal","তারা গোপন করে"],["وَمَا","wamā","and what","আর যা"],["يُعْلِنُونَ","yu‘'linūna","they declare","তারা প্রকাশ করে"]],"t":"فَلَا يَحْزُ<k>نكَ</> قَوْلُهُمْ ۘ إِ<g>نَّ</>ا نَعْلَمُ مَا يُسِرُّونَ وَمَا يُعْلِ<p>نُو</>نَ"},{"n":77,"w":[["أَوَلَمْ","awalam","Does not","নি কি"],["يَرَ","yara","see","দেখে"],["ٱلْإِنسَـٰنُ","l-insānu","[the] man","মানুষ"],["أَنَّا","annā","that We","যে আমরা"],["خَلَقْنَـٰهُ","khalaqnāhu","[We] created him","তাকে আমরা সৃষ্টি করেছি"],["مِن","min","from","থেকে"],["نُّطْفَةٍۢ","nuṭ'fatin","a semen-drop","শুক্রবিন্দু"],["فَإِذَا","fa-idhā","Then behold","অথচ পরে"],["هُوَ","huwa","He","সে (হয়েছে)"],["خَصِيمٌۭ","khaṣīmun","(is) an opponent","ঝগড়াটে"],["مُّبِينٌۭ","mubīnun","clear","প্রকাশ্য"]],"t":"أَوَلَمْ يَرَ <h>ٱ</>لْإِ<k>نسَٰ</>نُ أَ<g>نَّ</>ا خَلَ<q>قْ</><m>نَٰ</>هُ <d>مِن نُّ</><q>طْ</>فَ<k>ةٍۢ فَ</>إِذَا هُوَ خَصِي<d>مٌۭ مُّ</><p>بِي</>نٌۭ"},{"n":78,"w":[["وَضَرَبَ","waḍaraba","And he sets forth","এবং পেশ করে"],["لَنَا","lanā","for Us","আমাদের জন্যে"],["مَثَلًۭا","mathalan","an example","উপমা"],["وَنَسِىَ","wanasiya","and forgets","অথচ সে ভুলে যায়"],["خَلْقَهُۥ ۖ","khalqahu","his (own) creation","তার সৃষ্টিকে"],["قَالَ","qāla","He says","সে বলে"],["مَن","man","Who","\"কে"],["يُحْىِ","yuḥ'yī","will give life","প্রাণ দিবে"],["ٱلْعِظَـٰمَ","l-‘iẓāma","(to) the bones","হাড়ে"],["وَهِىَ","wahiya","while they","যখন তা (হয়ে যাবে)"],["رَمِيمٌۭ","ramīmun","(are) decomposed","পচাগলা জরাজীর্ণ\""]],"t":"وَضَرَبَ لَنَا مَثَلًۭ<d>ا وَ</>نَسِىَ خَلْقَهُ<m>ۥ</> ۖ قَالَ <d>مَن يُ</>حْىِ <h>ٱ</>لْعِ<m>ظَٰ</>مَ وَهِىَ رَ<p>مِي</>مٌۭ"},{"n":79,"w":[["قُلْ","qul","Say","বলো (তাদেরকে)"],["يُحْيِيهَا","yuḥ'yīhā","He will give them life","\"তাতে প্রাণ দিবেন"],["ٱلَّذِىٓ","alladhī","Who","(তিনিই) যিনি"],["أَنشَأَهَآ","ansha-ahā","produced them","তা সৃষ্টি করেছেন"],["أَوَّلَ","awwala","(the) first","প্রথম"],["مَرَّةٍۢ ۖ","marratin","time","বার"],["وَهُوَ","wahuwa","and He","এবং তিনি"],["بِكُلِّ","bikulli","(is) of every","সম্পর্কে সবকিছু"],["خَلْقٍ","khalqin","creation","(তাঁর) সৃষ্টির"],["عَلِيمٌ","‘alīmun","All-Knower","সম্যক অবগত\""]],"t":"قُلْ يُحْيِيهَا <h>ٱ</>لَّ<o>ذِىٓ</> أَ<k>نشَ</>أَ<o>هَآ</> أَوَّلَ مَرَّ<d>ةٍۢ ۖ وَ</>هُوَ بِكُلِّ خَلْقٍ عَ<p>لِي</>مٌ"},{"n":80,"w":[["ٱلَّذِى","alladhī","The One Who","যিনি"],["جَعَلَ","ja‘ala","made","সৃষ্টি করেছেন"],["لَكُم","lakum","for you","তোমাদের জন্যে"],["مِّنَ","mina","from","থেকে"],["ٱلشَّجَرِ","l-shajari","the tree","গাছ"],["ٱلْأَخْضَرِ","l-akhḍari","[the] green ","সবুজ"],["نَارًۭا","nāran","fire","আগুন"],["فَإِذَآ","fa-idhā","and behold","অতঃপর"],["أَنتُم","antum","You","তোমরা"],["مِّنْهُ","min'hu","from it","তা থেকে"],["تُوقِدُونَ","tūqidūna","ignite","আগুন জ্বালো"]],"t":"ٱلَّذِى جَعَلَ لَ<y>كُم مِّ</>نَ <h>ٱ</><l>ل</>شَّجَرِ <h>ٱ</>لْأَخْضَرِ نَا<k>رًۭا فَ</>إِ<o>ذَآ</> أَ<k>نتُ</><y>م مِّ</>نْهُ تُوقِ<p>دُو</>نَ"},{"n":81,"w":[["أَوَلَيْسَ","awalaysa","Is it not","নন কি (সেই আল্লাহ)"],["ٱلَّذِى","alladhī","(He) Who","যিনি"],["خَلَقَ","khalaqa","created","সৃষ্টি করেছেন"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশ সমূহ"],["وَٱلْأَرْضَ","wal-arḍa","and the earth","ও পৃথিবীকে"],["بِقَـٰدِرٍ","biqādirin","Able","সক্ষম"],["عَلَىٰٓ","‘alā","to","এক্ষেত্রে"],["أَن","an","[that]","যে"],["يَخْلُقَ","yakhluqa","create","সৃষ্টি করবেন"],["مِثْلَهُم ۚ","mith'lahum","(the) like of them","তাদের মতো"],["بَلَىٰ","balā","Yes, indeed","হ্যাঁ নিশ্চয়ই"],["وَهُوَ","wahuwa","and He","এবং তিনিই"],["ٱلْخَلَّـٰقُ","l-khalāqu","(is) the Supreme Creator","মহাস্রষ্টা"],["ٱلْعَلِيمُ","l-‘alīmu","the All-Knower","সর্বজ্ঞ"]],"t":"أَوَلَيْسَ <h>ٱ</>لَّذِى خَلَقَ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضَ بِ<m>قَٰ</>دِرٍ عَلَ<o>ىٰٓ</> <d>أَن يَ</>خْلُقَ مِثْلَ<f>هُم ۚ بَ</>لَىٰ وَهُوَ <h>ٱ</>لْخَ<m>لَّٰ</>قُ <h>ٱ</>لْعَ<p>لِي</>مُ"},{"n":82,"w":[["إِنَّمَآ","innamā","Only","কেবল"],["أَمْرُهُۥٓ","amruhu","His Command","তাঁর নির্দেশ হয়"],["إِذَآ","idhā","when","যখন"],["أَرَادَ","arāda","He intends","ইচ্ছে করেন"],["شَيْـًٔا","shayan","a thing","কিছু (করতে)"],["أَن","an","that","যে"],["يَقُولَ","yaqūla","He says","বলেন"],["لَهُۥ","lahu","to it","তাকে"],["كُن","kun","Be","\"হও\""],["فَيَكُونُ","fayakūnu","and it is","তখনই হয়ে যায়"]],"t":"إِ<g>نَّ</><o>مَآ</> أَمْرُهُ<o>ۥٓ</> إِ<o>ذَآ</> أَرَادَ شَيْـًٔا <d>أَن يَ</>قُولَ لَهُ<m>ۥ</> كُ<k>ن فَ</>يَ<p>كُو</>نُ"},{"n":83,"w":[["فَسُبْحَـٰنَ","fasub'ḥāna","So glory be","অতএব মহান পবিত্র"],["ٱلَّذِى","alladhī","(to) the One who","(সেই সত্ত্বা) তিনিই"],["بِيَدِهِۦ","biyadihi","in Whose hand","যার হাতে (আছে)"],["مَلَكُوتُ","malakūtu","is (the) dominion","সার্বভৌম ক্ষমতা"],["كُلِّ","kulli","(of) all","সব"],["شَىْءٍۢ","shayin","things","জিনিসের"],["وَإِلَيْهِ","wa-ilayhi","and to Him","এবং তাঁরই দিকে"],["تُرْجَعُونَ","tur'ja‘ūna","you will be returned","তোমাদেরকে ফিরিয়ে নেয়া হবে"]],"t":"فَسُ<q>بْ</><m>حَٰ</>نَ <h>ٱ</>لَّذِى بِيَدِ<m>هِۦ</> مَلَكُوتُ كُلِّ <d>شَىْءٍۢ وَ</>إِلَيْهِ تُرْجَ<p>عُو</>نَ"}]}