{"n":54,"a":[{"n":1,"w":[["ٱقْتَرَبَتِ","iq'tarabati","Has come near","নিকটবর্তী হয়েছে"],["ٱلسَّاعَةُ","l-sā‘atu","the Hour","কিয়ামত"],["وَٱنشَقَّ","wa-inshaqqa","and has split","এবং বিদীর্ণ হয়েছে"],["ٱلْقَمَرُ","l-qamaru","the moon","চাঁদ"]],"t":"ٱ<q>قْ</>تَرَبَتِ <h>ٱ</><l>ل</>سَّاعَةُ وَ<h>ٱ</><k>نشَ</>قَّ <h>ٱ</>لْقَمَرُ"},{"n":2,"w":[["وَإِن","wa-in","And if","কিন্তু যদি"],["يَرَوْا۟","yaraw","they see","তারা দেখে"],["ءَايَةًۭ","āyatan","a Sign","কোনো নিদর্শন"],["يُعْرِضُوا۟","yu‘'riḍū","they turn away","তারা মুখ ফিরিয়ে নেয়"],["وَيَقُولُوا۟","wayaqūlū","and say","এবং তারা বলে"],["سِحْرٌۭ","siḥ'run","Magic","\"(এটা) জাদু"],["مُّسْتَمِرٌّۭ","mus'tamirrun","continuing","চিরাচরিত\""]],"t":"وَ<d>إِن يَ</>رَوْ<s>ا۟</> ءَايَ<d>ةًۭ يُ</>عْرِضُو<s>ا۟</> وَيَقُولُو<s>ا۟</> سِحْ<d>رٌۭ مُّ</>سْتَمِرٌّۭ"},{"n":3,"w":[["وَكَذَّبُوا۟","wakadhabū","And they denied","এবং তারা মিথ্যারোপ করেছে"],["وَٱتَّبَعُوٓا۟","wa-ittaba‘ū","and followed","ও অনুসরণ করেছে"],["أَهْوَآءَهُمْ ۚ","ahwāahum","their desires","তাদের খেয়ালখুশির"],["وَكُلُّ","wakullu","but (for) every","এবং প্রত্যেক"],["أَمْرٍۢ","amrin","matter","কাজই"],["مُّسْتَقِرٌّۭ","mus'taqirrun","(will be a) settlement","লক্ষ্যে পৌঁছুবে"]],"t":"وَكَذَّبُو<s>ا۟</> وَ<h>ٱ</>تَّبَ<o>عُوٓ</><s>ا۟</> أَهْ<o>وَآ</>ءَهُمْ ۚ وَكُلُّ أَمْ<d>رٍۢ مُّ</>سْتَقِرٌّۭ"},{"n":4,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["جَآءَهُم","jāahum","has come to them","তাদের কাছে এসেছে"],["مِّنَ","mina","of","হতে"],["ٱلْأَنۢبَآءِ","l-anbāi","the information","সংবাদ গুলো(অতীত জাতিসমূহের)"],["مَا","mā","wherein","যার"],["فِيهِ","fīhi","wherein","মধ্যে আছে"],["مُزْدَجَرٌ","muz'dajarun","(is) deterrence","সতর্কবাণী"]],"t":"وَلَقَ<q>دْ</> <o>جَآ</>ءَ<y>هُم مِّ</>نَ <h>ٱ</>لْأَ<i>نۢبَ</><o>آ</>ءِ مَا فِيهِ مُزْدَجَرٌ"},{"n":5,"w":[["حِكْمَةٌۢ","ḥik'matun","Wisdom","প্রজ্ঞা"],["بَـٰلِغَةٌۭ ۖ","bālighatun","perfect","পরিপূর্ণ"],["فَمَا","famā","but not","না কিন্তু"],["تُغْنِ","tugh'ni","will avail","কাজে আসে"],["ٱلنُّذُرُ","l-nudhuru","the warnings","সতর্কবাণী (তাদের জন্য)"]],"t":"حِكْمَ<i>ةٌۢ بَٰ</>لِغَ<k>ةٌۭ ۖ فَ</>مَا تُغْنِ <h>ٱ</><l>ل</><g>نُّ</>ذُرُ"},{"n":6,"w":[["فَتَوَلَّ","fatawalla","So turn away","(হে নবী) অতএব মুখ ফিরাও/ উপেক্ষা করো"],["عَنْهُمْ ۘ","‘anhum","from them","তাদের হতে"],["يَوْمَ","yawma","(The) Day","যেদিন"],["يَدْعُ","yad‘u","will call","আহ্বান করবে"],["ٱلدَّاعِ","l-dā‘i","the caller","এক আহ্বানকারী"],["إِلَىٰ","ilā","to","দিকে"],["شَىْءٍۢ","shayin","a thing","একটা জিনিসের"],["نُّكُرٍ","nukurin","terrible","অপ্রীতিকর"]],"t":"فَتَوَلَّ عَنْهُمْ ۘ يَوْمَ يَ<q>دْ</>عُ <h>ٱ</><l>ل</>دَّاعِ إِلَىٰ <d>شَىْءٍۢ نُّ</>كُرٍ"},{"n":7,"w":[["خُشَّعًا","khusha‘an","(Will be) humbled","অবনমিত অবস্থায়(থাকবে)"],["أَبْصَـٰرُهُمْ","abṣāruhum","their eyes","তাদের দৃষ্টি"],["يَخْرُجُونَ","yakhrujūna","they will come forth","তারা বের হবে (সেদিন)"],["مِنَ","mina","from","হতে"],["ٱلْأَجْدَاثِ","l-ajdāthi","the graves","কবরসমূহ"],["كَأَنَّهُمْ","ka-annahum","as if they (were)","(মনে হবে) তারা যেন"],["جَرَادٌۭ","jarādun","locusts","পঙ্গপাল"],["مُّنتَشِرٌۭ","muntashirun","spreading","বিক্ষিপ্ত"]],"t":"خُشَّعًا أَ<q>بْ</><m>صَٰ</>رُهُمْ يَخْرُجُونَ مِنَ <h>ٱ</>لْأَ<q>جْ</>دَاثِ كَأَ<g>نَّ</>هُمْ جَرَا<d>دٌۭ مُّ</><k>نتَ</>شِرٌۭ"},{"n":8,"w":[["مُّهْطِعِينَ","muh'ṭi‘īna","Racing ahead","তারা দৌড়াবে (ভীতবিহ্বল হয়ে)"],["إِلَى","ilā","towards","দিকে"],["ٱلدَّاعِ ۖ","l-dā‘i","the caller","আহ্বানকারীর"],["يَقُولُ","yaqūlu","Will say","বলবে"],["ٱلْكَـٰفِرُونَ","l-kāfirūna","the disbelievers","কাফিররা"],["هَـٰذَا","hādhā","This","\"এটা"],["يَوْمٌ","yawmun","(is) a Day","দিন"],["عَسِرٌۭ","‘asirun","difficult","কঠিন\""]],"t":"مُّهْطِعِينَ إِلَى <h>ٱ</><l>ل</>دَّاعِ ۖ يَقُولُ <h>ٱ</>لْ<m>كَٰ</>فِرُونَ <m>هَٰ</>ذَا يَوْمٌ عَسِرٌۭ"},{"n":9,"w":[["۞ كَذَّبَتْ","kadhabat","Denied","মিথ্যারোপ করেছিল"],["قَبْلَهُمْ","qablahum","before them","তাদের পূর্বে"],["قَوْمُ","qawmu","(the) people","জাতি"],["نُوحٍۢ","nūḥin","(of) Nuh","নূহের"],["فَكَذَّبُوا۟","fakadhabū","and they denied","আর তারা মিথ্যা আরোপ করেছিল"],["عَبْدَنَا","‘abdanā","Our slave","আমাদের বান্দাকে/ দাসকে"],["وَقَالُوا۟","waqālū","and said","এবং বলেছিল"],["مَجْنُونٌۭ","majnūnun","A madman","\"সে পাগল\""],["وَٱزْدُجِرَ","wa-uz'dujira","and he was repelled","ও তাকে ধমকানো হয়েছিল"]],"t":"۞ كَذَّبَتْ قَ<q>بْ</>لَهُمْ قَوْمُ نُو<k>حٍۢ فَ</>كَذَّبُو<s>ا۟</> عَ<q>بْ</>دَنَا وَقَالُو<s>ا۟</> مَ<q>جْ</>نُو<d>نٌۭ وَ</><h>ٱ</>زْدُجِرَ"},{"n":10,"w":[["فَدَعَا","fada‘ā","So he called","সে তখন ডেকেছিল"],["رَبَّهُۥٓ","rabbahu","his Lord","তার রবকে"],["أَنِّى","annī","I am","\"যে আমি"],["مَغْلُوبٌۭ","maghlūbun","one overpowered","পরাজিত"],["فَٱنتَصِرْ","fa-intaṣir","so help","অতএব তুমি প্রতিবিধান করো\""]],"t":"فَدَعَا رَبَّهُ<o>ۥٓ</> أَ<g>نِّ</>ى مَغْلُو<k>بٌۭ فَ</><h>ٱ</><k>نتَ</>صِرْ"},{"n":11,"w":[["فَفَتَحْنَآ","fafataḥnā","So We opened","তখন আমরা খুলে দিয়েছিলাম"],["أَبْوَٰبَ","abwāba","(the) gates","দরজাগুলোকে"],["ٱلسَّمَآءِ","l-samāi","(of) heaven","আকাশের"],["بِمَآءٍۢ","bimāin","with water","বৃষ্টি দ্বারা"],["مُّنْهَمِرٍۢ","mun'hamirin","pouring down","মুষলধারে"]],"t":"فَفَتَحْ<o>نَآ</> أَ<q>بْ</><m>وَٰ</>بَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ بِ<o>مَآ</><d>ءٍۢ مُّ</>نْهَمِرٍۢ"},{"n":12,"w":[["وَفَجَّرْنَا","wafajjarnā","And We caused to burst","এবং আমরা দীর্ণকরে বের করলাম"],["ٱلْأَرْضَ","l-arḍa","the earth","মাটি (হতে)"],["عُيُونًۭا","‘uyūnan","(with) springs","ফোয়ারা"],["فَٱلْتَقَى","fal-taqā","so met","অতঃপর মিলে গেল"],["ٱلْمَآءُ","l-māu","the water(s)","(সমস্ত) পানি"],["عَلَىٰٓ","‘alā","for","উপর"],["أَمْرٍۢ","amrin","a matter","এমন এক ব্যাপারে (সম্পূর্ণ করতে)"],["قَدْ","qad","already","(যা ছিল)"],["قُدِرَ","qudira","predestined","নির্দিষ্ট করা"]],"t":"وَفَجَّرْنَا <h>ٱ</>لْأَرْضَ عُيُو<k>نًۭا فَ</><h>ٱ</>لْتَقَى <h>ٱ</>لْ<o>مَآ</>ءُ عَلَ<o>ىٰٓ</> أَمْ<k>رٍۢ قَ</><q>دْ</> قُدِرَ"},{"n":13,"w":[["وَحَمَلْنَـٰهُ","waḥamalnāhu","And We carried him","এবং তাকে আমরা আরোহণ করালাম"],["عَلَىٰ","‘alā","on","(নৌকার) উপর"],["ذَاتِ","dhāti","(ark) made of planks","(তৈরি) বিশিষ্ট"],["أَلْوَٰحٍۢ","alwāḥin","(ark) made of planks","(অনেক) তক্তা"],["وَدُسُرٍۢ","wadusurin","and nails","এবং (বহু) পেরেকের"]],"t":"وَحَمَلْ<m>نَٰ</>هُ عَلَىٰ ذَاتِ أَلْ<m>وَٰ</><d>حٍۢ وَ</>دُسُرٍۢ"},{"n":14,"w":[["تَجْرِى","tajrī","Sailing","চলে"],["بِأَعْيُنِنَا","bi-a‘yuninā","before Our eyes","আমাদের পর্যবেক্ষণে"],["جَزَآءًۭ","jazāan","a reward","পুরস্কার"],["لِّمَن","liman","for (he) who","তার জন্য যে"],["كَانَ","kāna","was","হয়েছিল"],["كُفِرَ","kufira","denied","প্রত্যাখ্যাত"]],"t":"تَ<q>جْ</>رِى بِأَعْيُنِنَا جَ<o>زَآ</><w>ءًۭ لِّ</>مَ<k>ن كَ</>انَ كُفِرَ"},{"n":15,"w":[["وَلَقَد","walaqad","And certainly","এবং নিশ্চয়ই"],["تَّرَكْنَـٰهَآ","taraknāhā","We left it","তা আমরা রেখেছি"],["ءَايَةًۭ","āyatan","(as) a Sign","একটি নিদর্শন হিসেবে"],["فَهَلْ","fahal","so is (there)","কি তবে (আছে)"],["مِن","min","any","কোনো"],["مُّدَّكِرٍۢ","muddakirin","who will receive admonition","উপদেশ গ্রহণকারী"]],"t":"وَلَقَ<j>د</> تَّرَكْ<m>نَٰ</><o>هَآ</> ءَايَ<k>ةًۭ فَ</>هَلْ <d>مِن مُّ</>دَّكِرٍۢ"},{"n":16,"w":[["فَكَيْفَ","fakayfa","So how","তখন কেমন"],["كَانَ","kāna","was","ছিল"],["عَذَابِى","‘adhābī","My punishment","আমার শাস্তি(তা লক্ষ্য কর)"],["وَنُذُرِ","wanudhuri","and My warnings","ও আমার সতর্ক বাণী"]],"t":"فَكَيْفَ كَانَ عَذَابِى وَنُذُرِ"},{"n":17,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["يَسَّرْنَا","yassarnā","We have made easy","আমরা সহজ করে দিয়েছি"],["ٱلْقُرْءَانَ","l-qur'āna","the Quran","কুরআনকে"],["لِلذِّكْرِ","lildhik'ri","for remembrance","উপদেশ গ্রহণের জন্য"],["فَهَلْ","fahal","so is (there)","তবে কি(আছে)"],["مِن","min","any","কোনো"],["مُّدَّكِرٍۢ","muddakirin","who will receive admonition","উপদেশ গ্রহণকারী"]],"t":"وَلَقَ<q>دْ</> يَسَّرْنَا <h>ٱ</>لْقُرْءَانَ لِلذِّكْرِ فَهَلْ <d>مِن مُّ</>دَّكِرٍۢ"},{"n":18,"w":[["كَذَّبَتْ","kadhabat","Denied","মিথ্যারোপ করেছিল"],["عَادٌۭ","‘ādun","Aad","আদ'"],["فَكَيْفَ","fakayfa","so how","কেমন অতঃপর"],["كَانَ","kāna","was","ছিল"],["عَذَابِى","‘adhābī","My punishment","আমার শাস্তি"],["وَنُذُرِ","wanudhuri","and My warnings","ও আমার সতর্কবাণী(তা লক্ষ্যকর)"]],"t":"كَذَّبَتْ عَا<k>دٌۭ فَ</>كَيْفَ كَانَ عَذَابِى وَنُذُرِ"},{"n":19,"w":[["إِنَّآ","innā","Indeed, We","নিশ্চয়ই আমরা"],["أَرْسَلْنَا","arsalnā","[We] sent","আমরা পাঠিয়েছি"],["عَلَيْهِمْ","‘alayhim","upon them","তাদের উপর"],["رِيحًۭا","rīḥan","a wind","বাতাস"],["صَرْصَرًۭا","ṣarṣaran","furious","প্রবল বেগে"],["فِى","fī","on","(আছে)"],["يَوْمِ","yawmi","a day","দিনে"],["نَحْسٍۢ","naḥsin","(of) misfortune","দুর্ভাগ্য"],["مُّسْتَمِرٍّۢ","mus'tamirrin","continuous","ক্রমাগত"]],"t":"إِ<g>نَّ</><o>آ</> أَرْسَلْنَا عَلَيْهِمْ رِي<k>حًۭا صَ</>رْصَ<k>رًۭا فِ</>ى يَوْمِ نَحْ<d>سٍۢ مُّ</>سْتَمِرٍّۢ"},{"n":20,"w":[["تَنزِعُ","tanzi‘u","Plucking out","উৎখাত করে"],["ٱلنَّاسَ","l-nāsa","men","মানুষকে"],["كَأَنَّهُمْ","ka-annahum","as if they (were)","তারা যেন"],["أَعْجَازُ","a‘jāzu","trunks","কাণ্ডসমূহ"],["نَخْلٍۢ","nakhlin","(of) date-palms","খেজুরগাছের"],["مُّنقَعِرٍۢ","munqa‘irin","uprooted","উপড়ানো (মূল হতে)"]],"t":"تَ<k>نزِ</>عُ <h>ٱ</><l>ل</><g>نَّ</>اسَ كَأَ<g>نَّ</>هُمْ أَعْجَازُ نَخْ<d>لٍۢ مُّ</><k>نقَ</>عِرٍۢ"},{"n":21,"w":[["فَكَيْفَ","fakayfa","So how","কেমন অতএব"],["كَانَ","kāna","was","ছিল"],["عَذَابِى","‘adhābī","My punishment","আমার শাস্তি"],["وَنُذُرِ","wanudhuri","and My warnings","ও আমার সতর্কবাণী (লক্ষ্যকর)"]],"t":"فَكَيْفَ كَانَ عَذَابِى وَنُذُرِ"},{"n":22,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["يَسَّرْنَا","yassarnā","We have made easy","আমরা সহজ করেছি"],["ٱلْقُرْءَانَ","l-qur'āna","the Quran","কুরআনকে"],["لِلذِّكْرِ","lildhik'ri","for remembrance","উপদেশ গ্রহণের জন্যে"],["فَهَلْ","fahal","so is (there)","তবে কি (আছে)"],["مِن","min","any","কোনো"],["مُّدَّكِرٍۢ","muddakirin","who will receive admonition","উপদেশ গ্রহণকারী"]],"t":"وَلَقَ<q>دْ</> يَسَّرْنَا <h>ٱ</>لْقُرْءَانَ لِلذِّكْرِ فَهَلْ <d>مِن مُّ</>دَّكِرٍۢ"},{"n":23,"w":[["كَذَّبَتْ","kadhabat","Denied","মিথ্যারোপ করেছিল"],["ثَمُودُ","thamūdu","Thamud","সামুদ'"],["بِٱلنُّذُرِ","bil-nudhuri","the warnings","সতর্ককারীদেরকে"]],"t":"كَذَّبَتْ ثَمُودُ بِ<h>ٱ</><l>ل</><g>نُّ</>ذُرِ"},{"n":24,"w":[["فَقَالُوٓا۟","faqālū","And said","তারা তখন বলেছিল"],["أَبَشَرًۭا","abasharan","Is (it) a human being","\"মানুষ কি"],["مِّنَّا","minnā","among us","আমাদের মধ্য হতে"],["وَٰحِدًۭا","wāḥidan","one","একজন"],["نَّتَّبِعُهُۥٓ","nattabi‘uhu","(that) we should follow him","যাকে আমরা অনুসরণ করবো"],["إِنَّآ","innā","Indeed, we","নিশ্চয়ই আমরা"],["إِذًۭا","idhan","then","তখন (হব)"],["لَّفِى","lafī","(will be) surely in","অবশ্যই মধ্যে"],["ضَلَـٰلٍۢ","ḍalālin","error","ভ্রান্তির"],["وَسُعُرٍ","wasu‘urin","and madness","ও বিকৃতবুদ্ধির"]],"t":"فَقَا<o>لُوٓ</><s>ا۟</> أَبَشَ<d>رًۭا مِّ</><g>نَّ</>ا <m>وَٰ</>حِ<d>دًۭا نَّ</>تَّبِعُهُ<o>ۥٓ</> إِ<g>نَّ</><o>آ</> إِ<w>ذًۭا لَّ</>فِى ضَ<m>لَٰ</><d>لٍۢ وَ</>سُعُرٍ"},{"n":25,"w":[["أَءُلْقِىَ","a-ul'qiya","Has been sent","অবতীর্ণ করা হয়েছে কি"],["ٱلذِّكْرُ","l-dhik'ru","the Reminder","উপদেশ (আল্লাহর বিধান)"],["عَلَيْهِ","‘alayhi","to him","তার উপর"],["مِنۢ","min","from","হতে"],["بَيْنِنَا","bayninā","among us","আমাদের মাঝে"],["بَلْ","bal","Nay","বরং"],["هُوَ","huwa","he","সে"],["كَذَّابٌ","kadhābun","(is) a liar","খুব মিথ্যাবাদী"],["أَشِرٌۭ","ashirun","insolent","দাম্ভিক\""]],"t":"أَءُلْقِىَ <h>ٱ</><l>ل</>ذِّكْرُ عَلَيْهِ <i>مِنۢ بَ</>يْنِنَا بَلْ هُوَ كَذَّابٌ أَشِرٌۭ"},{"n":26,"w":[["سَيَعْلَمُونَ","saya‘lamūna","They will know","(বলা হল) অচিরেই তারা জানবে"],["غَدًۭا","ghadan","tomorrow","আগামীকালই"],["مَّنِ","mani","who","কে"],["ٱلْكَذَّابُ","l-kadhābu","(is) the liar","খুব মিথ্যাবাদী"],["ٱلْأَشِرُ","l-ashiru","the insolent one","দাম্ভিক"]],"t":"سَيَعْلَمُونَ غَ<d>دًۭا مَّ</>نِ <h>ٱ</>لْكَذَّابُ <h>ٱ</>لْأَشِرُ"},{"n":27,"w":[["إِنَّا","innā","Indeed, We","নিশ্চয়ই আমরা"],["مُرْسِلُوا۟","mur'silū","(are) sending","প্রেরণকারী"],["ٱلنَّاقَةِ","l-nāqati","the she-camel","একটি উটনী"],["فِتْنَةًۭ","fit'natan","(as) a trial","পরীক্ষা হিসেবে"],["لَّهُمْ","lahum","for them","তাদের জন্যে"],["فَٱرْتَقِبْهُمْ","fa-ir'taqib'hum","so watch them","অতএব তুমি তাদের প্রতি লক্ষ্য রাখ"],["وَٱصْطَبِرْ","wa-iṣ'ṭabir","and be patient","ও ধৈর্য ধরো"]],"t":"إِ<g>نَّ</>ا مُرْسِلُو<s>ا۟</> <h>ٱ</><l>ل</><g>نَّ</>اقَةِ فِتْنَ<w>ةًۭ لَّ</>هُمْ فَ<h>ٱ</>رْتَقِ<q>بْ</>هُمْ وَ<h>ٱ</>صْطَبِرْ"},{"n":28,"w":[["وَنَبِّئْهُمْ","wanabbi'hum","And inform them","এবং তাদের জানিয়ে দাও"],["أَنَّ","anna","that","যে"],["ٱلْمَآءَ","l-māa","the water","পানি"],["قِسْمَةٌۢ","qis'matun","(is) to be shared","পালা করে দেওয়া হলো (হয়েছে)"],["بَيْنَهُمْ ۖ","baynahum","between them","তাদের মাঝে"],["كُلُّ","kullu","each","প্রত্যেকে"],["شِرْبٍۢ","shir'bin","drink","পান করতে"],["مُّحْتَضَرٌۭ","muḥ'taḍarun","attended","উপস্থিত হবে (পালাক্রমে)"]],"t":"وَنَبِّئْهُمْ أَ<g>نَّ</> <h>ٱ</>لْ<o>مَآ</>ءَ قِسْمَ<i>ةٌۢ بَ</>يْنَهُمْ ۖ كُلُّ شِرْ<d>بٍۢ مُّ</>حْتَضَرٌۭ"},{"n":29,"w":[["فَنَادَوْا۟","fanādaw","But they called","তারা অতঃপর ডাকল"],["صَاحِبَهُمْ","ṣāḥibahum","their companion","তাদের এক সঙ্গীকে"],["فَتَعَاطَىٰ","fata‘āṭā","and he took","সে তখন হস্তক্ষেপ করল"],["فَعَقَرَ","fa‘aqara","and hamstrung","সে অতঃপর উটনী মেরে ফেলল"]],"t":"فَنَادَوْ<s>ا۟</> صَاحِبَهُمْ فَتَعَاطَىٰ فَعَقَرَ"},{"n":30,"w":[["فَكَيْفَ","fakayfa","So how","তখন কেমন"],["كَانَ","kāna","was","ছিল"],["عَذَابِى","‘adhābī","My punishment","আমার শাস্তি"],["وَنُذُرِ","wanudhuri","and My warnings","ও আমার সতর্কবাণী (তা লক্ষ্যকর)"]],"t":"فَكَيْفَ كَانَ عَذَابِى وَنُذُرِ"},{"n":31,"w":[["إِنَّآ","innā","Indeed, We","নিশ্চয়ই আমরা"],["أَرْسَلْنَا","arsalnā","[We] sent","আমরা পাঠালাম"],["عَلَيْهِمْ","‘alayhim","upon them","তাদের উপর"],["صَيْحَةًۭ","ṣayḥatan","thunderous blast","প্রচণ্ড গর্জন"],["وَٰحِدَةًۭ","wāḥidatan","single","একটি (মাত্র)"],["فَكَانُوا۟","fakānū","and they became","ফলে তারা হয়ে গেল"],["كَهَشِيمِ","kahashīmi","like dry twig fragments","শুকনা খড়্রের মতো"],["ٱلْمُحْتَظِرِ","l-muḥ'taẓiri","(used by) a fence builder","খোঁয়াড় প্রস্তুতকারীর"]],"t":"إِ<g>نَّ</><o>آ</> أَرْسَلْنَا عَلَيْهِمْ صَيْحَ<d>ةًۭ وَٰ</>حِدَ<k>ةًۭ فَ</>كَانُو<s>ا۟</> كَهَشِيمِ <h>ٱ</>لْمُحْتَظِرِ"},{"n":32,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["يَسَّرْنَا","yassarnā","We have made easy","আমরা সহজ করেছি"],["ٱلْقُرْءَانَ","l-qur'āna","the Quran","কুরআনকে"],["لِلذِّكْرِ","lildhik'ri","for remembrance","উপদেশ গ্রহনের জন্যে"],["فَهَلْ","fahal","so is (there)","কি তবে (আছে)"],["مِن","min","any","কোনো"],["مُّدَّكِرٍۢ","muddakirin","who will receive admonition","উপদেশ গ্রহণকারী"]],"t":"وَلَقَ<q>دْ</> يَسَّرْنَا <h>ٱ</>لْقُرْءَانَ لِلذِّكْرِ فَهَلْ <d>مِن مُّ</>دَّكِرٍۢ"},{"n":33,"w":[["كَذَّبَتْ","kadhabat","Denied","মিথ্যারোপ করেছিল"],["قَوْمُ","qawmu","(the) people","জাতি"],["لُوطٍۭ","lūṭin","(of) Lut","লূতের"],["بِٱلنُّذُرِ","bil-nudhuri","the warnings","সতর্কবাণীকে"]],"t":"كَذَّبَتْ قَوْمُ لُو<i>طٍۭ بِ</><h>ٱ</><l>ل</><g>نُّ</>ذُرِ"},{"n":34,"w":[["إِنَّآ","innā","Indeed, We","আমরা নিশ্চয়ই"],["أَرْسَلْنَا","arsalnā","[We] sent","আমরা পাঠিয়েছি"],["عَلَيْهِمْ","‘alayhim","upon them","তাদের উপর"],["حَاصِبًا","ḥāṣiban","a storm of stones","পাথরবর্ষণকারী ঝড়ো বাতাস"],["إِلَّآ","illā","except","তবে"],["ءَالَ","āla","(the) family","পরিবারকে"],["لُوطٍۢ ۖ","lūṭin","(of) Lut","লূতের (রক্ষা করি)"],["نَّجَّيْنَـٰهُم","najjaynāhum","We saved them","তাদেরকে আমরা উদ্ধার করেছিলাম"],["بِسَحَرٍۢ","bisaḥarin","by dawn","রাতের শেষে"]],"t":"إِ<g>نَّ</><o>آ</> أَرْسَلْنَا عَلَيْهِمْ حَاصِبًا إِ<o>لَّآ</> ءَالَ لُو<d>طٍۢ ۖ نَّ</>جَّيْ<m>نَٰ</><f>هُم بِ</>سَحَرٍۢ"},{"n":35,"w":[["نِّعْمَةًۭ","ni‘'matan","(As) a favor","অনুগ্রহে"],["مِّنْ","min","from","হতে"],["عِندِنَا ۚ","‘indinā","Us","আমাদের নিকট"],["كَذَٰلِكَ","kadhālika","Thus","এভাবেই"],["نَجْزِى","najzī","We reward","পুরস্কার দেই আমরা"],["مَن","man","(one) who","যে"],["شَكَرَ","shakara","(is) grateful","কৃতজ্ঞতা প্রকাশ করে"]],"t":"نِّعْمَ<d>ةًۭ مِّ</>نْ عِ<k>ندِ</>نَا ۚ كَ<m>ذَٰ</>لِكَ نَ<q>جْ</>زِى مَ<k>ن شَ</>كَرَ"},{"n":36,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["أَنذَرَهُم","andharahum","he warned them","তাদেরকে সতর্ক করেছিল সে"],["بَطْشَتَنَا","baṭshatanā","(of) Our seizure","আমাদের পাকড়াও সম্পর্কে"],["فَتَمَارَوْا۟","fatamāraw","but they disputed","তারা সন্দেহ তবে করেছিল"],["بِٱلنُّذُرِ","bil-nudhuri","the warnings","সতর্কবাণী সম্পর্কে"]],"t":"وَلَقَ<q>دْ</> أَ<k>نذَ</>رَ<f>هُم بَ</><q>طْ</>شَتَنَا فَتَمَارَوْ<s>ا۟</> بِ<h>ٱ</><l>ل</><g>نُّ</>ذُرِ"},{"n":37,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["رَٰوَدُوهُ","rāwadūhu","they demanded from him","তারা তাকে ফুঁসলিয়েছিল"],["عَن","‘an","they demanded from him","সম্পর্কে"],["ضَيْفِهِۦ","ḍayfihi","his guests","তার মেহমান (দের)"],["فَطَمَسْنَآ","faṭamasnā","so We blinded","আমরা তখন নিষ্প্রভ করেছিলাম"],["أَعْيُنَهُمْ","a‘yunahum","their eyes","তাদের চোখগুলোকে"],["فَذُوقُوا۟","fadhūqū","So taste","\"তোমরা এখন স্বাদ নাও"],["عَذَابِى","‘adhābī","My punishment","আমার শাস্তির"],["وَنُذُرِ","wanudhuri","and My warnings","ও আমার সতর্কবাণীর\""]],"t":"وَلَقَ<q>دْ</> <m>رَٰ</>وَدُوهُ عَ<k>ن ضَ</>يْفِ<m>هِۦ</> فَطَمَسْ<o>نَآ</> أَعْيُنَهُمْ فَذُوقُو<s>ا۟</> عَذَابِى وَنُذُرِ"},{"n":38,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["صَبَّحَهُم","ṣabbaḥahum","seized them in the morning","তাদের উপর আপতিত হলো"],["بُكْرَةً","buk'ratan","early","খুব ভোরে"],["عَذَابٌۭ","‘adhābun","a punishment","শাস্তি"],["مُّسْتَقِرٌّۭ","mus'taqirrun","abiding","বিরামহীন"]],"t":"وَلَقَ<q>دْ</> صَبَّحَ<f>هُم بُ</>كْرَةً عَذَا<d>بٌۭ مُّ</>سْتَقِرٌّۭ"},{"n":39,"w":[["فَذُوقُوا۟","fadhūqū","So taste","তোমরা এখন স্বাদ নাও"],["عَذَابِى","‘adhābī","My punishment","আমার শাস্তির"],["وَنُذُرِ","wanudhuri","and My warnings","ও আমার সতর্কবাণীর"]],"t":"فَذُوقُو<s>ا۟</> عَذَابِى وَنُذُرِ"},{"n":40,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["يَسَّرْنَا","yassarnā","We have made easy","আমরা সহজ করেছি"],["ٱلْقُرْءَانَ","l-qur'āna","the Quran","কুরআনকে"],["لِلذِّكْرِ","lildhik'ri","for remembrance","উপদেশ গ্রহণের জন্য"],["فَهَلْ","fahal","so is (there)","কি তবে (আছে)"],["مِن","min","any","কোনো"],["مُّدَّكِرٍۢ","muddakirin","who will receive admonition","উপদেশ গ্রহণকারী"]],"t":"وَلَقَ<q>دْ</> يَسَّرْنَا <h>ٱ</>لْقُرْءَانَ لِلذِّكْرِ فَهَلْ <d>مِن مُّ</>دَّكِرٍۢ"},{"n":41,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["جَآءَ","jāa","came","এসেছিল"],["ءَالَ","āla","(to the) people","সম্প্রদায়ের (কাছে)"],["فِرْعَوْنَ","fir'‘awna","(of) Firaun","ফিরআউনের"],["ٱلنُّذُرُ","l-nudhuru","warnings","সতর্ককারীরা"]],"t":"وَلَقَ<q>دْ</> <o>جَآ</>ءَ ءَالَ فِرْعَوْنَ <h>ٱ</><l>ل</><g>نُّ</>ذُرُ"},{"n":42,"w":[["كَذَّبُوا۟","kadhabū","They denied","তারা মিথ্যা বলেছিল"],["بِـَٔايَـٰتِنَا","biāyātinā","Our Signs","আমাদের নিদর্শনের"],["كُلِّهَا","kullihā","all of them","সবগুলোকেই"],["فَأَخَذْنَـٰهُمْ","fa-akhadhnāhum","so We seized them","ফলে তাদেরকে আমরা পাকড়াও করলাম"],["أَخْذَ","akhdha","(with) a seizure","পাকড়াও"],["عَزِيزٍۢ","‘azīzin","(of) All-Mighty","পরাক্রমশালীর"],["مُّقْتَدِرٍ","muq'tadirin","(the) Powerful One","মহাশক্তিমানের"]],"t":"كَذَّبُو<s>ا۟</> بِـَٔا<m>يَٰ</>تِنَا كُلِّهَا فَأَخَذْ<m>نَٰ</>هُمْ أَخْذَ عَزِي<d>زٍۢ مُّ</><q>قْ</>تَدِرٍ"},{"n":43,"w":[["أَكُفَّارُكُمْ","akuffārukum","Are your disbelievers","তোমাদের কাফিররা কি"],["خَيْرٌۭ","khayrun","better","উত্তম"],["مِّنْ","min","than","চেয়ে"],["أُو۟لَـٰٓئِكُمْ","ulāikum","those","ঐসব লোকদের"],["أَمْ","am","or","কিংবা"],["لَكُم","lakum","for you","তোমাদের জন্যে আছে"],["بَرَآءَةٌۭ","barāatun","(is) an exemption","(লিখিত) মুক্তির সনদ"],["فِى","fī","in","মধ্যে"],["ٱلزُّبُرِ","l-zuburi","the Scriptures","(পূর্বের) গ্রন্থসমূহের"]],"t":"أَكُفَّارُكُمْ خَيْ<d>رٌۭ مِّ</>نْ أُ<s>و۟</><o>لَٰٓ</>ئِكُمْ أَمْ لَ<f>كُم بَ</><o>رَآ</>ءَ<k>ةٌۭ فِ</>ى <h>ٱ</><l>ل</>زُّبُرِ"},{"n":44,"w":[["أَمْ","am","Or","অথবা (কি)"],["يَقُولُونَ","yaqūlūna","(do) they say","তারা বলে"],["نَحْنُ","naḥnu","We","\"আমরা"],["جَمِيعٌۭ","jamī‘un","(are) an assembly","সংঘবদ্ধ দল"],["مُّنتَصِرٌۭ","muntaṣirun","helping (each other)","বিজয়ী\""]],"t":"أَمْ يَقُولُونَ نَحْنُ جَمِي<d>عٌۭ مُّ</><k>نتَ</>صِرٌۭ"},{"n":45,"w":[["سَيُهْزَمُ","sayuh'zamu","Soon will be defeated","শীঘ্রই পরাজিত করা হবে"],["ٱلْجَمْعُ","l-jam‘u","(their) assembly","(এই) সংঘবদ্ধ দলকে"],["وَيُوَلُّونَ","wayuwallūna","and they will turn","এবং তারা ফিরাবে"],["ٱلدُّبُرَ","l-dubura","(their) backs","পিঠ"]],"t":"سَيُهْزَمُ <h>ٱ</>لْجَمْعُ وَيُوَلُّونَ <h>ٱ</><l>ل</>دُّبُرَ"},{"n":46,"w":[["بَلِ","bali","Nay","বরং"],["ٱلسَّاعَةُ","l-sā‘atu","the Hour","কিয়ামত"],["مَوْعِدُهُمْ","maw‘iduhum","(is) their promised time","তাদের নির্ধারিত সময় (বুঝাপড়ার)"],["وَٱلسَّاعَةُ","wal-sā‘atu","and the Hour","এবং কিয়ামত"],["أَدْهَىٰ","adhā","(will be) more grievous","বড়ই ভয়াবহ"],["وَأَمَرُّ","wa-amarru","and more bitter","ও বড়ই তিক্ত"]],"t":"بَلِ <h>ٱ</><l>ل</>سَّاعَةُ مَوْعِدُهُمْ وَ<h>ٱ</><l>ل</>سَّاعَةُ أَ<q>دْ</>هَىٰ وَأَمَرُّ"},{"n":47,"w":[["إِنَّ","inna","Indeed","নিশ্চয়"],["ٱلْمُجْرِمِينَ","l-muj'rimīna","the criminals","অপরাধীরা (রয়েছে)"],["فِى","fī","(are) in","মধ্যে"],["ضَلَـٰلٍۢ","ḍalālin","an error","বিভ্রান্তির"],["وَسُعُرٍۢ","wasu‘urin","and madness","ও বিকৃতবুদ্ধির মধ্যে"]],"t":"إِ<g>نَّ</> <h>ٱ</>لْمُ<q>جْ</>رِمِينَ فِى ضَ<m>لَٰ</><d>لٍۢ وَ</>سُعُرٍۢ"},{"n":48,"w":[["يَوْمَ","yawma","(The) Day","যেদিন"],["يُسْحَبُونَ","yus'ḥabūna","they will be dragged","(তাদেরকে) টেনে নেওয়া হবে"],["فِى","fī","into","মধ্যে"],["ٱلنَّارِ","l-nāri","the Fire","আগুনের"],["عَلَىٰ","‘alā","on","উপর"],["وُجُوهِهِمْ","wujūhihim","their faces","তাদের মুখের (ভর করে)"],["ذُوقُوا۟","dhūqū","Taste","\"(বলা হবে) স্বাদ নাও"],["مَسَّ","massa","(the) touch","স্পর্শের"],["سَقَرَ","saqara","(of) Hell","জাহান্নামের\""]],"t":"يَوْمَ يُسْحَبُونَ فِى <h>ٱ</><l>ل</><g>نَّ</>ارِ عَلَىٰ وُجُوهِهِمْ ذُوقُو<s>ا۟</> مَسَّ سَقَرَ"},{"n":49,"w":[["إِنَّا","innā","Indeed, [We]","নিশ্চয়ই আমরা"],["كُلَّ","kulla","every","প্রত্যেক"],["شَىْءٍ","shayin","thing","জিনিসকে"],["خَلَقْنَـٰهُ","khalaqnāhu","We created it","তা আমরা সৃষ্টি করেছি"],["بِقَدَرٍۢ","biqadarin","by a measure","নির্ধারিত পরিমাণ দিয়ে"]],"t":"إِ<g>نَّ</>ا كُلَّ شَىْءٍ خَلَ<q>قْ</><m>نَٰ</>هُ بِقَدَرٍۢ"},{"n":50,"w":[["وَمَآ","wamā","And not","এবং না"],["أَمْرُنَآ","amrunā","(is) Our Command","আমাদের নির্দেশ (দেওয়া হয়)"],["إِلَّا","illā","but","এছাড়া যে"],["وَٰحِدَةٌۭ","wāḥidatun","one","একবারই"],["كَلَمْحٍۭ","kalamḥin","like the