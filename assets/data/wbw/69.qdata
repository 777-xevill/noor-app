{"n":69,"a":[{"n":1,"w":[["ٱلْحَآقَّةُ","al-ḥāqatu","The Inevitable Reality","সুনিশ্চিত ঘটনা!"]],"t":"ٱلْ<n>حَآ</>قَّةُ"},{"n":2,"w":[["مَا","mā","What","কি সেই?"],["ٱلْحَآقَّةُ","l-ḥāqatu","(is) the Inevitable Reality","সুনিশ্চিত ঘটনা"]],"t":"مَا <h>ٱ</>لْ<n>حَآ</>قَّةُ"},{"n":3,"w":[["وَمَآ","wamā","And what","এবং কি?"],["أَدْرَىٰكَ","adrāka","will make you know","জান তুমি"],["مَا","mā","what","কি সেই"],["ٱلْحَآقَّةُ","l-ḥāqatu","(is) the Inevitable Reality","সুনিশ্চিত ঘটনা"]],"t":"وَ<o>مَآ</> أَ<q>دْ</>رَ<m>ىٰ</>كَ مَا <h>ٱ</>لْ<n>حَآ</>قَّةُ"},{"n":4,"w":[["كَذَّبَتْ","kadhabat","Denied","মিথারোপ করেছিল"],["ثَمُودُ","thamūdu","Thamud","সামুদ"],["وَعَادٌۢ","wa‘ādun","and Aad","এবং আদ"],["بِٱلْقَارِعَةِ","bil-qāri‘ati","the Striking Calamity","মহাপ্রলয়কে"]],"t":"كَذَّبَتْ ثَمُودُ وَعَا<i>دٌۢ بِ</><h>ٱ</>لْقَارِعَةِ"},{"n":5,"w":[["فَأَمَّا","fa-ammā","So as for","আর"],["ثَمُودُ","thamūdu","Thamud","সামুদ"],["فَأُهْلِكُوا۟","fa-uh'likū","they were destroyed","ধ্বংস করা হয়েছে অতঃপর"],["بِٱلطَّاغِيَةِ","bil-ṭāghiyati","by the overpowering (blast)","তাঁর ঝনঝা বায়ু দিয়ে"]],"t":"فَأَ<g>مَّ</>ا ثَمُودُ فَأُهْلِكُو<s>ا۟</> بِ<h>ٱ</><l>ل</>طَّاغِيَةِ"},{"n":6,"w":[["وَأَمَّا","wa-ammā","And as for","আর"],["عَادٌۭ","‘ādun","Aad","আদ"],["فَأُهْلِكُوا۟","fa-uh'likū","they were destroyed","অতঃপর ধ্বংস করা হয়েছে"],["بِرِيحٍۢ","birīḥin","by a wind","বায়ু দিয়ে"],["صَرْصَرٍ","ṣarṣarin","screaming","ঝঞ্জা"],["عَاتِيَةٍۢ","‘ātiyatin","violent","প্রচন্ড"]],"t":"وَأَ<g>مَّ</>ا عَا<k>دٌۭ فَ</>أُهْلِكُو<s>ا۟</> بِرِي<k>حٍۢ صَ</>رْصَرٍ عَاتِيَةٍۢ"},{"n":7,"w":[["سَخَّرَهَا","sakharahā","Which He imposed","তা প্রবাহিত করেন"],["عَلَيْهِمْ","‘alayhim","upon them","তাদের উপর"],["سَبْعَ","sab‘a","(for) seven","সাত"],["لَيَالٍۢ","layālin","nights","রাত"],["وَثَمَـٰنِيَةَ","wathamāniyata","and eight","এবং আট"],["أَيَّامٍ","ayyāmin","days","দিন"],["حُسُومًۭا","ḥusūman","(in) succession","ক্রমাগত"],["فَتَرَى","fatarā","so you would see","তুমি দেখতে তখন (তথায় থাকিলে)"],["ٱلْقَوْمَ","l-qawma","the people","সে জাতিকে"],["فِيهَا","fīhā","therein","তার মধ্যে"],["صَرْعَىٰ","ṣar‘ā","fallen","পড়ে থাকা"],["كَأَنَّهُمْ","ka-annahum","as if they were","তারা যেন"],["أَعْجَازُ","a‘jāzu","trunks","কাণ্ড সমূহ"],["نَخْلٍ","nakhlin","(of) date-palms","খেজুর গাছের"],["خَاوِيَةٍۢ","khāwiyatin","hollow","পরিত্যাক্ত"]],"t":"سَخَّرَهَا عَلَيْهِمْ سَ<q>بْ</>عَ لَيَا<d>لٍۢ وَ</>ثَ<m>مَٰ</>نِيَةَ أَيَّامٍ حُسُو<k>مًۭا فَ</>تَرَى <h>ٱ</>لْقَوْمَ فِيهَا صَرْعَىٰ كَأَ<g>نَّ</>هُمْ أَعْجَازُ نَخْلٍ خَاوِيَةٍۢ"},{"n":8,"w":[["فَهَلْ","fahal","Then do","কি এক্ষণে"],["تَرَىٰ","tarā","you see","তুমি দেখ"],["لَهُم","lahum","of them","তদেরকে"],["مِّنۢ","min","any","কিছু"],["بَاقِيَةٍۢ","bāqiyatin","remains","অবশিষ্ট"]],"t":"فَهَلْ تَرَىٰ لَ<y>هُم مِّ</><i>نۢ بَ</>اقِيَةٍۢ"},{"n":9,"w":[["وَجَآءَ","wajāa","And came","এবং এসেছিল"],["فِرْعَوْنُ","fir'‘awnu","Firaun","ফিরাউন"],["وَمَن","waman","and (those)","ও যারা"],["قَبْلَهُۥ","qablahu","before him","তার পূর্বে"],["وَٱلْمُؤْتَفِكَـٰتُ","wal-mu'tafikātu","and the overturned cities","এবং উলটে দেয়া বস্তীবাসীদের"],["بِٱلْخَاطِئَةِ","bil-khāṭi-ati","with sin","অপরাধের কারণে"]],"t":"وَ<o>جَآ</>ءَ فِرْعَوْنُ وَمَ<k>ن قَ</><q>بْ</>لَهُ<m>ۥ</> وَ<h>ٱ</>لْمُؤْتَفِ<m>كَٰ</>تُ بِ<h>ٱ</>لْخَاطِئَةِ"},{"n":10,"w":[["فَعَصَوْا۟","fa‘aṣaw","And they disobeyed","অতঃপর তারা অমান্য করেছিল"],["رَسُولَ","rasūla","(the) Messenger","রাসূলকে"],["رَبِّهِمْ","rabbihim","(of) their Lord","তাদের রবের"],["فَأَخَذَهُمْ","fa-akhadhahum","so He seized them","ফলে তাদের ধরলেন"],["أَخْذَةًۭ","akhdhatan","(with) a seizure","ধরা"],["رَّابِيَةً","rābiyatan","exceeding","শক্ত"]],"t":"فَعَصَوْ<s>ا۟</> رَسُولَ رَبِّهِمْ فَأَخَذَهُمْ أَخْذَ<w>ةًۭ رَّ</>ابِيَةً"},{"n":11,"w":[["إِنَّا","innā","Indeed, We","আমরা নিশ্চয়ই"],["لَمَّا","lammā","when","যখন"],["طَغَا","ṭaghā","overflowed","জলোচ্ছ্বাস হয়েছিল"],["ٱلْمَآءُ","l-māu","the water","(পানি)"],["حَمَلْنَـٰكُمْ","ḥamalnākum","We carried you","তোমাদের আমরা আরোহী করেছিলাম"],["فِى","fī","in","মধ্যে"],["ٱلْجَارِيَةِ","l-jāriyati","the sailing (ship)","নৌযানের"]],"t":"إِ<g>نَّ</>ا لَ<g>مَّ</>ا طَغَا <h>ٱ</>لْ<o>مَآ</>ءُ حَمَلْ<m>نَٰ</>كُمْ فِى <h>ٱ</>لْجَارِيَةِ"},{"n":12,"w":[["لِنَجْعَلَهَا","linaj‘alahā","That We might make it","তা বানাই আমরা যেন"],["لَكُمْ","lakum","for you","তোমাদের জন্যে"],["تَذْكِرَةًۭ","tadhkiratan","a reminder","শিক্ষা"],["وَتَعِيَهَآ","wata‘iyahā","and would be conscious of it","এবং তার ষ্মৃতি বহন করে"],["أُذُنٌۭ","udhunun","an ear","কান"],["وَٰعِيَةٌۭ","wā‘iyatun","conscious","স্মরন বাহক"]],"t":"لِنَ<q>جْ</>عَلَهَا لَكُمْ تَذْكِرَ<d>ةًۭ وَ</>تَعِيَ<o>هَآ</> أُذُ<d>نٌۭ وَٰ</>عِيَةٌۭ"},{"n":13,"w":[["فَإِذَا","fa-idhā","Then when","যখন অতঃপর"],["نُفِخَ","nufikha","is blown","ফুক দেয়া হবে"],["فِى","fī","in","মধ্যে"],["ٱلصُّورِ","l-ṣūri","the trumpet ","শিঙ্গায়"],["نَفْخَةٌۭ","nafkhatun","a blast","ফুক"],["وَٰحِدَةٌۭ","wāḥidatun","single","একবার"]],"t":"فَإِذَا نُفِخَ فِى <h>ٱ</><l>ل</>صُّورِ نَفْخَ<d>ةٌۭ وَٰ</>حِدَةٌۭ"},{"n":14,"w":[["وَحُمِلَتِ","waḥumilati","And are lifted","এবং উঠানো হবে"],["ٱلْأَرْضُ","l-arḍu","the earth","যমীন"],["وَٱلْجِبَالُ","wal-jibālu","and the mountains","এবং পাহাড়গুলো"],["فَدُكَّتَا","fadukkatā","and crushed","বিচূর্ণ করা হবে অতঃপর"],["دَكَّةًۭ","dakkatan","(with) a crushing","চূর্ণ বিচূর্ণ"],["وَٰحِدَةًۭ","wāḥidatan","single","একবার"]],"t":"وَحُمِلَتِ <h>ٱ</>لْأَرْضُ وَ<h>ٱ</>لْجِبَالُ فَدُكَّتَا دَكَّ<d>ةًۭ وَٰ</>حِدَةًۭ"},{"n":15,"w":[["فَيَوْمَئِذٍۢ","fayawma-idhin","Then (on) that Day","সেদিন অতঃপর"],["وَقَعَتِ","waqa‘ati","will occur","সংঘটিত হবে"],["ٱلْوَاقِعَةُ","l-wāqi‘atu","the Occurrence","মহাপ্রলয়"]],"t":"فَيَوْمَئِ<d>ذٍۢ وَ</>قَعَتِ <h>ٱ</>لْوَاقِعَةُ"},{"n":16,"w":[["وَٱنشَقَّتِ","wa-inshaqqati","And will split","এবং বিদীর্ণ হবে"],["ٱلسَّمَآءُ","l-samāu","the heaven","আসমান"],["فَهِىَ","fahiya","so it","তা অতঃপর"],["يَوْمَئِذٍۢ","yawma-idhin","(is on) that Day","সেদিন"],["وَاهِيَةٌۭ","wāhiyatun","frail","বিশ্লিষ্ট হবে"]],"t":"وَ<h>ٱ</><k>نشَ</>قَّتِ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءُ فَهِىَ يَوْمَئِ<d>ذٍۢ وَ</>اهِيَةٌۭ"},{"n":17,"w":[["وَٱلْمَلَكُ","wal-malaku","And the Angels","এবং ফেরেশতাগণ"],["عَلَىٰٓ","‘alā","(will be) on","উপর"],["أَرْجَآئِهَا ۚ","arjāihā","its edges","(আসমানের) বিভিন্ন প্রান্তে থাকবে"],["وَيَحْمِلُ","wayaḥmilu","and will bear","এবং বহন করবে"],["عَرْشَ","‘arsha","(the) Throne","আরশ"],["رَبِّكَ","rabbika","(of) your Lord","তোমার রবের"],["فَوْقَهُمْ","fawqahum","above them","তাদের উপরে,"],["يَوْمَئِذٍۢ","yawma-idhin","that Day","সেদিন"],["ثَمَـٰنِيَةٌۭ","thamāniyatun","eight","আট (ফেরেশতা)"]],"t":"وَ<h>ٱ</>لْمَلَكُ عَلَ<o>ىٰٓ</> أَرْ<o>جَآ</>ئِهَا ۚ وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِ<k>ذٍۢ ثَ</><m>مَٰ</>نِيَةٌۭ"},{"n":18,"w":[["يَوْمَئِذٍۢ","yawma-idhin","That Day","সেদিন"],["تُعْرَضُونَ","tu‘'raḍūna","you will be exhibited","পেশ করা হবে তোমাদের"],["لَا","lā","not","না"],["تَخْفَىٰ","takhfā","will be hidden","আড়াল করা হবে"],["مِنكُمْ","minkum","among you","তোমাদের মধ্যে"],["خَافِيَةٌۭ","khāfiyatun","any secret","কোন গোপন কিছুই"]],"t":"يَوْمَئِ<k>ذٍۢ تُ</>عْرَضُونَ لَا تَخْفَىٰ مِ<k>نكُ</>مْ خَافِيَةٌۭ"},{"n":19,"w":[["فَأَمَّا","fa-ammā","Then as for","আর"],["مَنْ","man","(him) who","যাকে"],["أُوتِىَ","ūtiya","is given","দেয়া হবে"],["كِتَـٰبَهُۥ","kitābahu","his record","তার আমলনামা"],["بِيَمِينِهِۦ","biyamīnihi","in his right hand","তাঁর ডান হাতে"],["فَيَقُولُ","fayaqūlu","will say","সে বলবে অতংপর"],["هَآؤُمُ","hāumu","Here","\"এখানে,"],["ٱقْرَءُوا۟","iq'raū","read","তোমরা পড়"],["كِتَـٰبِيَهْ","kitābiyah","my record","আমার আমলনামা"]],"t":"فَأَ<g>مَّ</>ا مَنْ أُوتِىَ كِ<m>تَٰ</>بَهُ<m>ۥ</> بِيَمِينِ<m>هِۦ</> فَيَقُولُ <o>هَآ</>ؤُمُ <h>ٱ</><q>قْ</>رَءُو<s>ا۟</> كِ<m>تَٰ</>بِيَهْ"},{"n":20,"w":[["إِنِّى","innī","Indeed, I","নিশ্চয়ই, আমি"],["ظَنَنتُ","ẓanantu","was certain","মনে করেছিলাম"],["أَنِّى","annī","that I","আমি যে"],["مُلَـٰقٍ","mulāqin","(will) meet","সাক্ষাৎকারী"],["حِسَابِيَهْ","ḥisābiyah","my account","আমার হিসাবের\""]],"t":"إِ<g>نِّ</>ى ظَنَ<k>نتُ</> أَ<g>نِّ</>ى مُ<m>لَٰ</>قٍ حِسَابِيَهْ"},{"n":21,"w":[["فَهُوَ","fahuwa","So he","সে অতংপর"],["فِى","fī","(will be) in","মধ্যে হবে"],["عِيشَةٍۢ","‘īshatin","a life","জীবনের"],["رَّاضِيَةٍۢ","rāḍiyatin","pleasant","সন্তোষজনক"]],"t":"فَهُوَ فِى عِيشَ<w>ةٍۢ رَّ</>اضِيَةٍۢ"},{"n":22,"w":[["فِى","fī","In","মধ্যে"],["جَنَّةٍ","jannatin","a Garden","জান্নাতের"],["عَالِيَةٍۢ","‘āliyatin","elevated","সুউচ্চ"]],"t":"فِى جَ<g>نَّ</>ةٍ عَالِيَةٍۢ"},{"n":23,"w":[["قُطُوفُهَا","quṭūfuhā","Its clusters of fruits","তার ফলরাশি (থাকবে)"],["دَانِيَةٌۭ","dāniyatun","hanging near","নিকটে"]],"t":"قُطُوفُهَا دَانِيَةٌۭ"},{"n":24,"w":[["كُلُوا۟","kulū","Eat","\"তোমরা খাও"],["وَٱشْرَبُوا۟","wa-ish'rabū","and drink","ও পান কর"],["هَنِيٓـًٔۢا","hanīan","(in) satisfaction","মজা করে"],["بِمَآ","bimā","for what","যা বদলে"],["أَسْلَفْتُمْ","aslaftum","you sent before you","তোমরা অতিবাহিত করেছ"],["فِى","fī","in","মধ্যে"],["ٱلْأَيَّامِ","l-ayāmi","the days","দিনগুলোর"],["ٱلْخَالِيَةِ","l-khāliyati","past","বিগত\""]],"t":"كُلُو<s>ا۟</> وَ<h>ٱ</>شْرَبُو<s>ا۟</> هَنِ<o>يٓـًٔۢ</><i>ا بِ</><o>مَآ</> أَسْلَفْتُمْ فِى <h>ٱ</>لْأَيَّامِ <h>ٱ</>لْخَالِيَةِ"},{"n":25,"w":[["وَأَمَّا","wa-ammā","But as for","আর"],["مَنْ","man","(him) who","যাকে"],["أُوتِىَ","ūtiya","is given","দেয়া হবে"],["كِتَـٰبَهُۥ","kitābahu","his record","তার আমলনামা"],["بِشِمَالِهِۦ","bishimālihi","in his left hand","তার বাম হাতে"],["فَيَقُولُ","fayaqūlu","will say","সে বলবে অতংপর"],["يَـٰلَيْتَنِى","yālaytanī","O! I wish","\"আমার আফসোস"],["لَمْ","lam","not","না (যদি)"],["أُوتَ","ūta","I had been given","দেয়া হত"],["كِتَـٰبِيَهْ","kitābiyah","my record","আমার আমলনামা"]],"t":"وَأَ<g>مَّ</>ا مَنْ أُوتِىَ كِ<m>تَٰ</>بَهُ<m>ۥ</> بِشِمَالِ<m>هِۦ</> فَيَقُولُ <m>يَٰ</>لَيْتَنِى لَمْ أُوتَ كِ<m>تَٰ</>بِيَهْ"},{"n":26,"w":[["وَلَمْ","walam","And not","এবং না"],["أَدْرِ","adri","I had known","আমি জানতাম"],["مَا","mā","what","যা"],["حِسَابِيَهْ","ḥisābiyah","(is) my account","আমার হিসাব"]],"t":"وَلَمْ أَ<q>دْ</>رِ مَا حِسَابِيَهْ"},{"n":27,"w":[["يَـٰلَيْتَهَا","yālaytahā","O! I wish it","হায় তা"],["كَانَتِ","kānati","had been","যদি হত"],["ٱلْقَاضِيَةَ","l-qāḍiyata","the end","(মৃত্যু) চূড়ান্ত"]],"t":"<m>يَٰ</>لَيْتَهَا كَانَتِ <h>ٱ</>لْقَاضِيَةَ"},{"n":28,"w":[["مَآ","mā","Not","না"],["أَغْنَىٰ","aghnā","has availed","কাজে আসল"],["عَنِّى","‘annī","me","আমার জন্যে"],["مَالِيَهْ ۜ","māliyah","my wealth","আমার ধন-সম্পদ,"]],"t":"<o>مَآ</> أَغْنَىٰ عَ<g>نِّ</>ى مَالِيَهْ ۜ"},{"n":29,"w":[["هَلَكَ","halaka","Is gone","বরবাদ হয়েছে"],["عَنِّى","‘annī","from me","আমার থেকে"],["سُلْطَـٰنِيَهْ","sul'ṭāniyah","my authority","আমার ক্ষমতা\""]],"t":"هَلَكَ عَ<g>نِّ</>ى سُلْ<m>طَٰ</>نِيَهْ"},{"n":30,"w":[["خُذُوهُ","khudhūhu","Seize him","\"তাকে ধর"],["فَغُلُّوهُ","faghullūhu","and shackle him","তাকে বেড়ি অতংপর পরাও"]],"t":"خُذُوهُ فَغُ<p>لُّو</>هُ"},{"n":31,"w":[["ثُمَّ","thumma","Then","তারপর"],["ٱلْجَحِيمَ","l-jaḥīma","(into) the Hellfire","জাহান্নামে"],["صَلُّوهُ","ṣallūhu","burn him","অগ্নিদগ্ধ কর."]],"t":"ثُ<g>مَّ</> <h>ٱ</>لْجَحِيمَ صَ<p>لُّو</>هُ"},{"n":32,"w":[["ثُمَّ","thumma","Then","তারপর"],["فِى","fī","into","মধ্যে"],["سِلْسِلَةٍۢ","sil'silatin","a chain","শিকল"],["ذَرْعُهَا","dhar‘uhā","its length","তার দীর্ঘতা"],["سَبْعُونَ","sab‘ūna","(is) seventy","সত্তর"],["ذِرَاعًۭا","dhirā‘an","cubits","হাত"],["فَٱسْلُكُوهُ","fa-us'lukūhu","insert him","অতংপর তাকে বেধে ফেল\""]],"t":"ثُ<g>مَّ</> فِى سِلْسِلَ<k>ةٍۢ ذَ</>رْعُهَا سَ<q>بْ</>عُونَ ذِرَا<k>عًۭا فَ</><h>ٱ</>سْلُ<p>كُو</>هُ"},{"n":33,"w":[["إِنَّهُۥ","innahu","Indeed, he","সে নিশ্চয়"],["كَانَ","kāna","was","ছিল"],["لَا","lā","not","না"],["يُؤْمِنُ","yu'minu","believing","বিশ্বাসী"],["بِٱللَّهِ","bil-lahi","in Allah","আল্লাহতে"],["ٱلْعَظِيمِ","l-‘aẓīmi","the Most Great","মহান,"]],"t":"إِ<g>نَّ</>هُ<m>ۥ</> كَانَ لَا يُؤْمِنُ بِ<h>ٱ</>للَّهِ <h>ٱ</>لْعَ<p>ظِي</>مِ"},{"n":34,"w":[["وَلَا","walā","And (did) not","আর (করেনি) না"],["يَحُضُّ","yaḥuḍḍu","feel the urge","উৎসাহ দিত"],["عَلَىٰ","‘alā","on","উপর"],["طَعَامِ","ṭa‘āmi","(the) feeding","খাওয়ানোর"],["ٱلْمِسْكِينِ","l-mis'kīni","(of) the poor","মিসকিনকে"]],"t":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ <h>ٱ</>لْمِسْ<p>كِي</>نِ"},{"n":35,"w":[["فَلَيْسَ","falaysa","So not","নাই অতএব"],["لَهُ","lahu","for him","তার জন্য"],["ٱلْيَوْمَ","l-yawma","today","আজ"],["هَـٰهُنَا","hāhunā","here","এখানে"],["حَمِيمٌۭ","ḥamīmun","any devoted friend","কোন অন্তরঙ্গ বন্ধু,"]],"t":"فَلَيْسَ لَهُ <h>ٱ</>لْيَوْمَ <m>هَٰ</>هُنَا حَ<p>مِي</>مٌۭ"},{"n":36,"w":[["وَلَا","walā","And not","এবং না"],["طَعَامٌ","ṭa‘āmun","any food","খাবার"],["إِلَّا","illā","except","ছাড়া"],["مِنْ","min","from","থেকে"],["غِسْلِينٍۢ","ghis'līnin","(the) discharge of wounds","ক্ষতনিংস্রিত রস"]],"t":"وَلَا طَعَامٌ إِلَّا مِنْ غِسْ<p>لِي</>نٍۢ"},{"n":37,"w":[["لَّا","lā","Not","না"],["يَأْكُلُهُۥٓ","yakuluhu","will eat it","তা খায়"],["إِلَّا","illā","except","ছাড়া"],["ٱلْخَـٰطِـُٔونَ","l-khāṭiūna","the sinners","অপরাধীরা"]],"t":"لَّا يَأْكُلُهُ<o>ۥٓ</> إِلَّا <h>ٱ</>لْ<m>خَٰ</><p>طِـُٔو</>نَ"},{"n":38,"w":[["فَلَآ","falā","But nay","না অতংপর"],["أُقْسِمُ","uq'simu","I swear","আমি শপথ করে বলছি"],["بِمَا","bimā","by what","যা"],["تُبْصِرُونَ","tub'ṣirūna","you see","তুমি দেখো,"]],"t":"فَ<o>لَآ</> أُ<q>قْ</>سِمُ بِمَا تُ<q>بْ</>صِ<p>رُو</>نَ"},{"n":39,"w":[["وَمَا","wamā","And what","এবং যা"],["لَا","lā","not","না"],["تُبْصِرُونَ","tub'ṣirūna","you see","তুমি দেখো,"]],"t":"وَمَا لَا تُ<q>بْ</>صِ<p>رُو</>نَ"},{"n":40,"w":[["إِنَّهُۥ","innahu","Indeed, it (is)","নিশ্চয় তা"],["لَقَوْلُ","laqawlu","surely (the) Word","বানী অবশ্যই"],["رَسُولٍۢ","rasūlin","(of) a Messenger","একজন রসূল (এর)"],["كَرِيمٍۢ","karīmin","noble","সম্মানিত"]],"t":"إِ<g>نَّ</>هُ<m>ۥ</> لَقَوْلُ رَسُو<k>لٍۢ كَ</><p>رِي</>مٍۢ"},{"n":41,"w":[["وَمَا","wamā","And not","এবং না"],["هُوَ","huwa","it","তা"],["بِقَوْلِ","biqawli","(is the) word","কথা"],["شَاعِرٍۢ ۚ","shā‘irin","(of) a poet","কবির"],["قَلِيلًۭا","qalīlan","little","কমই"],["مَّا","mā","(is) what","যা"],["تُؤْمِنُونَ","tu'minūna","you believe","তোমরা ইমান আন"]],"t":"وَمَا هُوَ بِقَوْلِ شَاعِ<k>رٍۢ ۚ قَ</>لِيلًۭ<d>ا مَّ</>ا تُؤْمِ<p>نُو</>نَ"},{"n":42,"w":[["وَلَا","walā","And not","এবং না"],["بِقَوْلِ","biqawli","(it is the) word","বানী"],["كَاهِنٍۢ ۚ","kāhinin","(of) a soothsayer","কোন গণকের"],["قَلِيلًۭا","qalīlan","little","কমই"],["مَّا","mā","(is) what","যা"],["تَذَكَّرُونَ","tadhakkarūna","you take heed","তোমরা উপদেশ গ্রহণ কর"]],"t":"وَلَا بِقَوْلِ كَاهِ<k>نٍۢ ۚ قَ</>لِيلًۭ<d>ا مَّ</>ا تَذَكَّ<p>رُو</>نَ"},{"n":43,"w":[["تَنزِيلٌۭ","tanzīlun","(It is) a revelation","নাযিলকৃত"],["مِّن","min","from","থেকে"],["رَّبِّ","rabbi","(the) Lord","রবের"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","(of) the worlds","মহাবিশ্বের"]],"t":"تَ<k>نزِ</>ي<d>لٌۭ مِّ</><w>ن رَّ</>بِّ <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":44,"w":[["وَلَوْ","walaw","And if","এবং যদি"],["تَقَوَّلَ","taqawwala","he (had) fabricated","কথা বানাত"],["عَلَيْنَا","‘alaynā","against Us","আমাদের বিপক্ষে"],["بَعْضَ","ba‘ḍa","some","কিছু"],["ٱلْأَقَاوِيلِ","l-aqāwīli","sayings","কথা"]],"t":"وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ <h>ٱ</>لْأَقَا<p>وِي</>لِ"},{"n":45,"w":[["لَأَخَذْنَا","la-akhadhnā","Certainly We (would) have seized","অবশ্যই আমরা ধরতাম"],["مِنْهُ","min'hu","him","তাকে"],["بِٱلْيَمِينِ","bil-yamīni","by the right hand","ডান হাত দ্বারা;"]],"t":"لَأَخَذْنَا مِنْهُ بِ<h>ٱ</>لْيَ<p>مِي</>نِ"},{"n":46,"w":[["ثُمَّ","thumma","Then","তারপর"],["لَقَطَعْنَا","laqaṭa‘nā","certainly We (would) have cut off","অবশ্যই আমরা কাটতাম"],["مِنْهُ","min'hu","from him","তার থেকে"],["ٱلْوَتِينَ","l-watīna","the aorta","মহাধমনী."]],"t":"ثُ<g>مَّ</> لَقَطَعْنَا مِنْهُ <h>ٱ</>لْوَ<p>تِي</>نَ"},{"n":47,"w":[["فَمَا","famā","And not","এবং না"],["مِنكُم","minkum","from you","তোমাদের মধ্যে"],["مِّنْ","min","any","কোন"],["أَحَدٍ","aḥadin","one","কেও"],["عَنْهُ","‘anhu","[from him]","[তার কাছ থেকে]"],["حَـٰجِزِينَ","ḥājizīna","(who could) prevent (it)","বিরতকারী"]],"t":"فَمَا مِ<k>نكُ</><y>م مِّ</>نْ أَحَدٍ عَنْهُ <m>حَٰ</>جِ<p>زِي</>نَ"},{"n":48,"w":[["وَإِنَّهُۥ","wa-innahu","And indeed, it","এবং তা"],["لَتَذْكِرَةٌۭ","latadhkiratun","(is) surely a reminder","অবশ্যই উপদেশ"],["لِّلْمُتَّقِينَ","lil'muttaqīna","for the Allah-fearing","মুত্তাকীদের"]],"t":"وَإِ<g>نَّ</>هُ<m>ۥ</> لَتَذْكِرَ<w>ةٌۭ لِّ</>لْمُتَّ<p>قِي</>نَ"},{"n":49,"w":[["وَإِنَّا","wa-innā","And indeed, We","এবং নিশ্চয় আমরা"],["لَنَعْلَمُ","lana‘lamu","surely know","অবশ্যই জানি"],["أَنَّ","anna","that","যে"],["مِنكُم","minkum","among you","তোমাদের মধ্যে"],["مُّكَذِّبِينَ","mukadhibīna","(are) deniers","অস্বীকারকারীরা (সম্পূর্ণ)."]],"t":"وَإِ<g>نَّ</>ا لَنَعْلَمُ أَ<g>نَّ</> مِ<k>نكُ</><y>م مُّ</>كَذِّ<p>بِي</>نَ"},{"n":50,"w":[["وَإِنَّهُۥ","wa-innahu","And indeed, it","এবং নিশ্চয় তা"],["لَحَسْرَةٌ","laḥasratun","(is) surely a regret","আক্ষেপের"],["عَلَى","‘alā","upon","উপর"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","the disbelievers","কাফিরদের."]],"t":"وَإِ<g>نَّ</>هُ<m>ۥ</> لَحَسْرَةٌ عَلَى <h>ٱ</>لْ<m>كَٰ</>فِ<p>رِي</>نَ"},{"n":51,"w":[["وَإِنَّهُۥ","wa-innahu","And indeed, it (is)","ও নিশ্চয় তা"],["لَحَقُّ","laḥaqqu","surely (the) truth","অবশ্যই সত্য"],["ٱلْيَقِينِ","l-yaqīni","(of) certainty","সুনিশ্চিত"]],"t":"وَإِ<g>نَّ</>هُ<m>ۥ</> لَحَقُّ <h>ٱ</>لْيَ<p>قِي</>نِ"},{"n":52,"w":[["فَسَبِّحْ","fasabbiḥ","So glorify","অতএব তাসবীহ পাঠ কর"],["بِٱسْمِ","bi-is'mi","(the) name","নামের"],["رَبِّكَ","rabbika","(of) your Lord","তোমার রবের"],["ٱلْعَظِيمِ","l-‘aẓīmi","the Most Great","মহান"]],"t":"فَسَبِّحْ بِ<h>ٱ</>سْمِ رَبِّكَ <h>ٱ</>لْعَ<p>ظِي</>مِ"}]}