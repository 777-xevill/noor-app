{"n":13,"a":[{"n":1,"w":[["الٓمٓر ۚ","alif-lam-meem-ra","Alif Laam Mim Ra","আলিফ লা-ম মী-ম রা-"],["تِلْكَ","til'ka","These","এই"],["ءَايَـٰتُ","āyātu","(are) the Verses","আয়াতসমূহ"],["ٱلْكِتَـٰبِ ۗ","l-kitābi","(of) the Book","কিতাবের"],["وَٱلَّذِىٓ","wa-alladhī","And that which","এবং যা"],["أُنزِلَ","unzila","has been revealed","অবতীর্ণ হয়েছে"],["إِلَيْكَ","ilayka","to you","তোমার প্রতি"],["مِن","min","from","থেকে"],["رَّبِّكَ","rabbika","your Lord","তোমার রবের"],["ٱلْحَقُّ","l-ḥaqu","(is) the truth","(তা) সত্য"],["وَلَـٰكِنَّ","walākinna","but","কিন্তু"],["أَكْثَرَ","akthara","most","অধিকাংশ"],["ٱلنَّاسِ","l-nāsi","(of) the mankind","মানুষ"],["لَا","lā","(do) not","না"],["يُؤْمِنُونَ","yu'minūna","believe","ঈমান আনে"]],"t":"ا<n>لٓمٓ</>ر ۚ تِلْكَ ءَا<m>يَٰ</>تُ <h>ٱ</>لْكِ<m>تَٰ</>بِ ۗ وَ<h>ٱ</>لَّ<o>ذِىٓ</> أُ<k>نزِ</>لَ إِلَيْكَ <w>مِن رَّ</>بِّكَ <h>ٱ</>لْحَقُّ وَ<m>لَٰ</>كِ<g>نَّ</> أَكْثَرَ <h>ٱ</><l>ل</><g>نَّ</>اسِ لَا يُؤْمِ<p>نُو</>نَ"},{"n":2,"w":[["ٱللَّهُ","al-lahu","Allah","(তিনিই) আল্লাহ"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["رَفَعَ","rafa‘a","raised","উপরে স্থাপন করেছেন"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশমন্ডলী"],["بِغَيْرِ","bighayri","without","ছাড়া"],["عَمَدٍۢ","‘amadin","pillars","কোন খুঁটি"],["تَرَوْنَهَا ۖ","tarawnahā","that you see","তা তোমরা দেখছো"],["ثُمَّ","thumma","then","এরপর"],["ٱسْتَوَىٰ","is'tawā","He established","উঠেছেন"],["عَلَى","‘alā","on","উপর"],["ٱلْعَرْشِ ۖ","l-‘arshi","the Throne","আরশের"],["وَسَخَّرَ","wasakhara","and subjected","এবং অধীন করেছেন"],["ٱلشَّمْسَ","l-shamsa","the sun","সূর্যকে (নিয়মের)"],["وَٱلْقَمَرَ ۖ","wal-qamara","and the moon","ও চাঁদকে"],["كُلٌّۭ","kullun","each","প্রত্যেকে"],["يَجْرِى","yajrī","running","চলছে"],["لِأَجَلٍۢ","li-ajalin","for a term","জন্যে সময়ের"],["مُّسَمًّۭى ۚ","musamman","appointed","নির্দিষ্ট"],["يُدَبِّرُ","yudabbiru","He arranges","তিনি পরিচালনা করেন"],["ٱلْأَمْرَ","l-amra","the matter","সকল বিষয়"],["يُفَصِّلُ","yufaṣṣilu","He details","বিশদ বর্ণনা করেন"],["ٱلْـَٔايَـٰتِ","l-āyāti","the Signs","নিদর্শনসমূহ"],["لَعَلَّكُم","la‘allakum","so that you may","তোমরা যাতে"],["بِلِقَآءِ","biliqāi","in the meeting","সম্পর্কে সাক্ষাত"],["رَبِّكُمْ","rabbikum","(with) your Lord","তোমাদের রবের"],["تُوقِنُونَ","tūqinūna","believe with certainty","তোমরা দৃঢ় বিশ্বাস করো"]],"t":"ٱللَّهُ <h>ٱ</>لَّذِى رَفَعَ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ بِغَيْرِ عَمَ<k>دٍۢ تَ</>رَوْنَهَا ۖ ثُ<g>مَّ</> <h>ٱ</>سْتَوَىٰ عَلَى <h>ٱ</>لْعَرْشِ ۖ وَسَخَّرَ <h>ٱ</><l>ل</>شَّمْسَ وَ<h>ٱ</>لْقَمَرَ ۖ كُ<d>لٌّۭ يَ</><q>جْ</>رِى لِأَجَ<d>لٍۢ مُّسَمًّۭى ۚ يُ</>دَبِّرُ <h>ٱ</>لْأَمْرَ يُفَصِّلُ <h>ٱ</>لْءَا<m>يَٰ</>تِ لَعَلَّ<f>كُم بِ</>لِ<o>قَآ</>ءِ رَبِّكُمْ تُوقِ<p>نُو</>نَ"},{"n":3,"w":[["وَهُوَ","wahuwa","And He","এবং তিনিই"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["مَدَّ","madda","spread","বিস্তৃত করেছেন"],["ٱلْأَرْضَ","l-arḍa","the earth","জমিনকে"],["وَجَعَلَ","waja‘ala","and placed","ও সৃষ্টি করেছেন"],["فِيهَا","fīhā","in it","তার মধ্যে"],["رَوَٰسِىَ","rawāsiya","firm mountains","সুদৃঢ় পর্বত"],["وَأَنْهَـٰرًۭا ۖ","wa-anhāran","and rivers","ও নদীসমূহ"],["وَمِن","wamin","and from","এবং রকমের"],["كُلِّ","kulli","all","সব"],["ٱلثَّمَرَٰتِ","l-thamarāti","(of) the fruits","ফলমূলসমূহ"],["جَعَلَ","ja‘ala","He made","সৃষ্টি করেছেন"],["فِيهَا","fīhā","in it","তার মধ্যে"],["زَوْجَيْنِ","zawjayni","pairs","জোড়া"],["ٱثْنَيْنِ ۖ","ith'nayni","two","দুই (ধরণের)"],["يُغْشِى","yugh'shī","He covers","তিনি ঢেকে রেখেছেন"],["ٱلَّيْلَ","al-layla","the night","রাত (দিয়ে)"],["ٱلنَّهَارَ ۚ","l-nahāra","(with) the day","দিনকে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে (আছে)"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَـٰتٍۢ","laāyātin","surely (are) Signs","অবশ্যই নিদর্শনাবলী"],["لِّقَوْمٍۢ","liqawmin","for a people","লোকদের জন্যে (যারা)"],["يَتَفَكَّرُونَ","yatafakkarūna","who ponder","চিন্তা-ভাবনা করে"]],"t":"وَهُوَ <h>ٱ</>لَّذِى مَدَّ <h>ٱ</>لْأَرْضَ وَجَعَلَ فِيهَا رَ<m>وَٰ</>سِىَ وَأَنْ<m>هَٰ</><d>رًۭا ۖ وَ</>مِ<k>ن كُ</>لِّ <h>ٱ</><l>ل</>ثَّمَ<m>رَٰ</>تِ جَعَلَ فِيهَا زَوْجَيْنِ <h>ٱ</>ثْنَيْنِ ۖ يُغْشِى <h>ٱ</>لَّيْلَ <h>ٱ</><l>ل</><g>نَّ</>هَارَ ۚ إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَا<m>يَٰ</><w>تٍۢ لِّ</>قَوْ<d>مٍۢ يَ</>تَفَكَّ<p>رُو</>نَ"},{"n":4,"w":[["وَفِى","wafī","And in","এবং মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["قِطَعٌۭ","qiṭa‘un","are tracks","ভূখন্ড"],["مُّتَجَـٰوِرَٰتٌۭ","mutajāwirātun","neighboring","পরস্পর সংলগ্ন"],["وَجَنَّـٰتٌۭ","wajannātun","and gardens","ও বাগানসমূহ"],["مِّنْ","min","of","এর"],["أَعْنَـٰبٍۢ","a‘nābin","grapevines","আঙ্গুর"],["وَزَرْعٌۭ","wazar‘un","and crops","ও শস্যক্ষেত"],["وَنَخِيلٌۭ","wanakhīlun","and date-palms","ও খেজুর গাছসমূহ"],["صِنْوَانٌۭ","ṣin'wānun","trees (growing) from a single root","একাধিক শিরবিশিষ্ট"],["وَغَيْرُ","waghayru","and not","ও নয়"],["صِنْوَانٍۢ","ṣin'wānin","trees (growing) from a single root","একাধিক শিরবিশিষ্ট"],["يُسْقَىٰ","yus'qā","watered","সেচ করা হয়"],["بِمَآءٍۢ","bimāin","with water","দিয়ে পানি"],["وَٰحِدٍۢ","wāḥidin","one","একই"],["وَنُفَضِّلُ","wanufaḍḍilu","but We cause to exceed","এবং শ্রেষ্ঠত্ব দিই আমরা"],["بَعْضَهَا","ba‘ḍahā","some of them","কিছু সংখ্যককে তার"],["عَلَىٰ","‘alā","over","উপর"],["بَعْضٍۢ","ba‘ḍin","others","কিছু সংখ্যকের"],["فِى","fī","in","(স্বাদের) মধ্যে"],["ٱلْأُكُلِ ۚ","l-ukuli","the fruit","ফলের"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَـٰتٍۢ","laāyātin","surely (are) Signs","অবশ্যই নিদর্শনাবলী"],["لِّقَوْمٍۢ","liqawmin","for a people","লোকদের জন্যে (রয়েছে)"],["يَعْقِلُونَ","ya‘qilūna","who use reason","(যারা) বুঝে"]],"t":"وَفِى <h>ٱ</>لْأَرْضِ قِطَ<d>عٌۭ مُّ</>تَ<m>جَٰوِرَٰ</><d>تٌۭ وَ</>جَ<g>نَّٰ</><d>تٌۭ مِّ</>نْ أَعْ<m>نَٰ</><d>بٍۢ وَ</>زَرْ<d>عٌۭ وَ</>نَخِي<k>لٌۭ صِ</>نْوَا<d>نٌۭ وَ</>غَيْرُ صِنْوَا<d>نٍۢ يُ</>سْقَىٰ بِ<o>مَآ</><d>ءٍۢ وَٰحِدٍۢ وَ</>نُفَضِّلُ بَعْضَهَا عَلَىٰ بَعْ<k>ضٍۢ فِ</>ى <h>ٱ</>لْأُكُلِ ۚ إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَا<m>يَٰ</><w>تٍۢ لِّ</>قَوْ<d>مٍۢ يَ</>عْقِ<p>لُو</>نَ"},{"n":5,"w":[["۞ وَإِن","wa-in","And if","এবং যদি"],["تَعْجَبْ","ta‘jab","you (are) astonished","তুমি বিস্মিত হও"],["فَعَجَبٌۭ","fa‘ajabun","then astonishing","তবে বিস্ময়কর বিষয় (হলো)"],["قَوْلُهُمْ","qawluhum","(is) their saying","তাদের কথা"],["أَءِذَا","a-idhā","When","\"যখন কি"],["كُنَّا","kunnā","we are","আমরা হবো"],["تُرَٰبًا","turāban","dust","মাটি"],["أَءِنَّا","a-innā","will we","আমরা কি নিশ্চয়ই"],["لَفِى","lafī","(be) indeed, in","অবশ্যই মধ্যে (হবো)"],["خَلْقٍۢ","khalqin","a creation","সৃষ্টির"],["جَدِيدٍ ۗ","jadīdin","new","নতুন\""],["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব লোক"],["ٱلَّذِينَ","alladhīna","(are) the ones who","যারা"],["كَفَرُوا۟","kafarū","disbelieved","অস্বীকার করেছে"],["بِرَبِّهِمْ ۖ","birabbihim","in their Lord","রবকে তাদের"],["وَأُو۟لَـٰٓئِكَ","wa-ulāika","and those","এবং ঐসব লোকের"],["ٱلْأَغْلَـٰلُ","l-aghlālu","the iron chains","শিকল"],["فِىٓ","fī","(will be) in","মধ্যে (থাকবে)"],["أَعْنَاقِهِمْ ۖ","a‘nāqihim","their necks","তাদের গলার"],["وَأُو۟لَـٰٓئِكَ","wa-ulāika","those","এবং ঐসব লোক"],["أَصْحَـٰبُ","aṣḥābu","(are the) companions","অধিবাসী"],["ٱلنَّارِ ۖ","l-nāri","(of) the Fire","আগুনের"],["هُمْ","hum","they","তারা"],["فِيهَا","fīhā","in it","তার মধ্যে"],["خَـٰلِدُونَ","khālidūna","(will) abide forever","স্থায়ী অবস্থানকারী"]],"t":"۞ وَإِ<k>ن تَ</>عْجَ<q>بْ</> فَعَجَ<k>بٌۭ قَ</>وْلُهُمْ أَءِذَا كُ<g>نَّ</>ا تُ<m>رَٰ</>بًا أَءِ<g>نَّ</>ا لَفِى خَلْ<k>قٍۢ جَ</>دِيدٍ ۗ أُ<s>و۟</><o>لَٰٓ</>ئِكَ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> بِرَبِّهِمْ ۖ وَأُ<s>و۟</><o>لَٰٓ</>ئِكَ <h>ٱ</>لْأَغْ<m>لَٰ</>لُ <o>فِىٓ</> أَعْنَاقِهِمْ ۖ وَأُ<s>و۟</><o>لَٰٓ</>ئِكَ أَصْ<m>حَٰ</>بُ <h>ٱ</><l>ل</><g>نَّ</>ارِ ۖ هُمْ فِيهَا <m>خَٰ</>لِ<p>دُو</>نَ"},{"n":6,"w":[["وَيَسْتَعْجِلُونَكَ","wayasta‘jilūnaka","And they ask you to hasten","এবং তোমার কাছে তারা তাড়াহুড়ো করছে"],["بِٱلسَّيِّئَةِ","bil-sayi-ati","the evil","ব্যাপারে মন্দের"],["قَبْلَ","qabla","before","পূর্বে"],["ٱلْحَسَنَةِ","l-ḥasanati","the good","ভালোর"],["وَقَدْ","waqad","and verily","অথচ নিশ্চয়ই"],["خَلَتْ","khalat","has occurred","গত হয়েছে"],["مِن","min","from","থেকেই"],["قَبْلِهِمُ","qablihimu","before them","তাদের আগে"],["ٱلْمَثُلَـٰتُ ۗ","l-mathulātu","[the] similar punishments","শিক্ষামূলক দৃষ্টান্তসমূহ"],["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["رَبَّكَ","rabbaka","your Lord","তোমার রব"],["لَذُو","ladhū","(is) full","অবশ্যই"],["مَغْفِرَةٍۢ","maghfiratin","(of) forgiveness","সম্পন্ন ক্ষমাশীল"],["لِّلنَّاسِ","lilnnāsi","for mankind","মানুষের  জন্যে"],["عَلَىٰ","‘alā","for","সত্ত্বেও"],["ظُلْمِهِمْ ۖ","ẓul'mihim","their wrongdoing","তাদের সীমালঙ্ঘন"],["وَإِنَّ","wa-inna","and indeed","এবং নিশ্চয়ই"],["رَبَّكَ","rabbaka","your Lord","তোমার রব"],["لَشَدِيدُ","lashadīdu","(is) severe","অবশ্যই কঠোর"],["ٱلْعِقَابِ","l-‘iqābi","(in) the penalty","শাস্তিদানে"]],"t":"وَيَسْتَعْجِلُونَكَ بِ<h>ٱ</><l>ل</>سَّيِّئَةِ قَ<q>بْ</>لَ <h>ٱ</>لْحَسَنَةِ وَقَ<q>دْ</> خَلَتْ مِ<k>ن قَ</><q>بْ</>لِهِمُ <h>ٱ</>لْمَثُ<m>لَٰ</>تُ ۗ وَإِ<g>نَّ</> رَبَّكَ لَذُو مَغْفِرَ<w>ةٍۢ لِّ</>ل<g>نَّ</>اسِ عَلَىٰ ظُلْمِهِمْ ۖ وَإِ<g>نَّ</> رَبَّكَ لَشَدِيدُ <h>ٱ</>لْعِ<p>قَا</><q>بِ</>"},{"n":7,"w":[["وَيَقُولُ","wayaqūlu","And say","এবং বলে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieved","অস্বীকার করেছে"],["لَوْلَآ","lawlā","Why not","\"কেন না"],["أُنزِلَ","unzila","has been sent down","অবতীর্ণ করা হলো"],["عَلَيْهِ","‘alayhi","to him","তার উপর"],["ءَايَةٌۭ","āyatun","a sign","কোনো নিদর্শন"],["مِّن","min","from","থেকে"],["رَّبِّهِۦٓ ۗ","rabbihi","his Lord","তার রবের\""],["إِنَّمَآ","innamā","Only","কেবল"],["أَنتَ","anta","you","তুমি"],["مُنذِرٌۭ ۖ","mundhirun","(are) a warner","একজন সতর্ককারী"],["وَلِكُلِّ","walikulli","and for every","ও জন্যে প্রত্যেক"],["قَوْمٍ","qawmin","people","জাতির"],["هَادٍ","hādin","(is) a guide","একজন পথ প্রদর্শক (আছে)"]],"t":"وَيَقُولُ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> لَوْ<o>لَآ</> أُ<k>نزِ</>لَ عَلَيْهِ ءَايَ<d>ةٌۭ مِّ</><w>ن رَّ</>بِّ<o>هِۦٓ ۗ</> إِ<g>نَّ</><o>مَآ</> أَ<k>نتَ</> مُ<k>نذِ</><d>رٌۭ ۖ وَ</>لِكُلِّ قَوْمٍ <p>هَا</><q>دٍ</>"},{"n":8,"w":[["ٱللَّهُ","al-lahu","Allah","আল্লাহ তা'লা"],["يَعْلَمُ","ya‘lamu","knows","জানেন"],["مَا","mā","what","যা"],["تَحْمِلُ","taḥmilu","carries","গর্ভধারণ করে"],["كُلُّ","kullu","every","প্রত্যেক"],["أُنثَىٰ","unthā","female","নারী"],["وَمَا","wamā","and what","এবং যা"],["تَغِيضُ","taghīḍu","fall short","কমায়"],["ٱلْأَرْحَامُ","l-arḥāmu","the womb","জরায়ু"],["وَمَا","wamā","and what","ও যা"],["تَزْدَادُ ۖ","tazdādu","they exceed","বাড়ায়"],["وَكُلُّ","wakullu","And every","এবং প্রত্যেক"],["شَىْءٍ","shayin","thing","বস্তুর"],["عِندَهُۥ","‘indahu","with Him","তাঁর কাছে (আছে)"],["بِمِقْدَارٍ","bimiq'dārin","(is) in due proportion","পরিমাণ নির্দিষ্ট"]],"t":"ٱللَّهُ يَعْلَمُ مَا تَحْمِلُ كُلُّ أُ<k>نثَ</>ىٰ وَمَا تَغِيضُ <h>ٱ</>لْأَرْحَامُ وَمَا تَزْدَادُ ۖ وَكُلُّ شَىْءٍ عِ<k>ندَ</>هُ<m>ۥ</> بِمِ<q>قْ</><p>دَا</>رٍ"},{"n":9,"w":[["عَـٰلِمُ","‘ālimu","Knower","তিনি জ্ঞানী"],["ٱلْغَيْبِ","l-ghaybi","(of) the unseen","অদৃশ্যের (সম্পর্কে)"],["وَٱلشَّهَـٰدَةِ","wal-shahādati","and the witnessed","ও দৃশ্যের"],["ٱلْكَبِيرُ","l-kabīru","the Most Great","তিনি মহান"],["ٱلْمُتَعَالِ","l-muta‘āli","the Most High","সর্বোচ্চ (মর্যাদাবান)"]],"t":"<m>عَٰ</>لِمُ <h>ٱ</>لْغَيْبِ وَ<h>ٱ</><l>ل</>شَّ<m>هَٰ</>دَةِ <h>ٱ</>لْكَبِيرُ <h>ٱ</>لْمُتَ<p>عَا</>لِ"},{"n":10,"w":[["سَوَآءٌۭ","sawāon","(It is) same (to Him)","(তারা) সমান"],["مِّنكُم","minkum","[of you]","তোমাদের মধ্য হ'তে"],["مَّنْ","man","(one) who","যে"],["أَسَرَّ","asarra","conceals","গোপন করে"],["ٱلْقَوْلَ","l-qawla","the speech","কথা"],["وَمَن","waman","or (one) who","ও যে"],["جَهَرَ","jahara","publicizes","প্রকাশ করে"],["بِهِۦ","bihi","it","সম্পর্কে তা"],["وَمَنْ","waman","and (one) who","এবং যে"],["هُوَ","huwa","[he]","সে"],["مُسْتَخْفٍۭ","mus'takhfin","(is) hidden","আত্নগোপনকারী"],["بِٱلَّيْلِ","bi-al-layli","by night","বেলায় রাতের"],["وَسَارِبٌۢ","wasāribun","or goes freely","ও বিচরণকারী"],["بِٱلنَّهَارِ","bil-nahāri","by day","বেলায় দিনের"]],"t":"سَ<o>وَآ</><d>ءٌۭ مِّ</><k>نكُ</><y>م مَّ</>نْ أَسَرَّ <h>ٱ</>لْقَوْلَ وَمَ<k>ن جَ</>هَرَ بِ<m>هِۦ</> وَمَنْ هُوَ مُسْتَخْ<i>فٍۭ بِ</><h>ٱ</>لَّيْلِ وَسَارِ<i>بٌۢ بِ</><h>ٱ</><l>ل</><g>نَّ</><p>هَا</>رِ"},{"n":11,"w":[["لَهُۥ","lahu","For him","তার জন্যে (আছে)"],["مُعَقِّبَـٰتٌۭ","mu‘aqqibātun","(are) successive (Angels)","একের পর এক আগমনকারী প্রহরী"],["مِّنۢ","min","from","থেকে"],["بَيْنِ","bayni","(before)","সামনে"],["يَدَيْهِ","yadayhi","(him)","তার"],["وَمِنْ","wamin","and from","এবং থেকে"],["خَلْفِهِۦ","khalfihi","and behind him","তার পিছন"],["يَحْفَظُونَهُۥ","yaḥfaẓūnahu","who guard him","তাকে তারা রক্ষণাবেক্ষণ  করে"],["مِنْ","min","by","মধ্যে সে"],["أَمْرِ","amri","(the) command","নির্দেশের"],["ٱللَّهِ ۗ","l-lahi","(of) Allah","আল্লাহর"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَا","lā","(does) not","না"],["يُغَيِّرُ","yughayyiru","change","পরিবর্তন করেন"],["مَا","mā","(the condition)","অবস্থা"],["بِقَوْمٍ","biqawmin","of a people","কোন জাতির"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["يُغَيِّرُوا۟","yughayyirū","they change","তারা পরিবর্তন করে"],["مَا","mā","what","অবস্থা"],["بِأَنفُسِهِمْ ۗ","bi-anfusihim","(is) in themselves","তাদের নিজেদের"],["وَإِذَآ","wa-idhā","And when","এবং যখন"],["أَرَادَ","arāda","wills","ইচ্ছে করেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["بِقَوْمٍۢ","biqawmin","for a people","সম্পর্কে কোনো জাতির"],["سُوٓءًۭا","sūan","misfortune","অশুভ"],["فَلَا","falā","then (there is) no","তখন নেই"],["مَرَدَّ","maradda","turning away","ফেরানোর"],["لَهُۥ ۚ","lahu","of it","তার জন্যে"],["وَمَا","wamā","and not","এবং নেই"],["لَهُم","lahum","for them","তাদের জন্যে"],["مِّن","min","from","ছাড়া"],["دُونِهِۦ","dūnihi","besides Him","তিনি"],["مِن","min","any","কোনো"],["وَالٍ","wālin","protector","অভিভাবক"]],"t":"لَهُ<m>ۥ</> مُعَقِّ<m>بَٰ</><d>تٌۭ مِّ</><i>نۢ بَ</>يْنِ يَدَيْهِ وَمِنْ خَلْفِ<m>هِۦ</> يَحْفَظُونَهُ<m>ۥ</> مِنْ أَمْرِ <h>ٱ</>للَّهِ ۗ إِ<g>نَّ</> <h>ٱ</>للَّهَ لَا يُغَيِّرُ مَا بِقَوْمٍ حَتَّىٰ يُغَيِّرُو<s>ا۟</> مَا بِأَ<k>نفُ</>سِهِمْ ۗ وَإِ<o>ذَآ</> أَرَادَ <h>ٱ</>للَّهُ بِقَوْ<k>مٍۢ سُ</><o>وٓ</><k>ءًۭا فَ</>لَا مَرَدَّ لَهُ<m>ۥ</> ۚ وَمَا لَ<y>هُم مِّ</><k>ن دُ</>ونِ<m>هِۦ</> <d>مِن وَ</><p>ا</>لٍ"},{"n":12,"w":[["هُوَ","huwa","He","তিনিই"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["يُرِيكُمُ","yurīkumu","shows you","তোমাদের দেখান"],["ٱلْبَرْقَ","l-barqa","the lightning","বিদ্যুৎ"],["خَوْفًۭا","khawfan","a fear","ভয়ের (জন্যে)"],["وَطَمَعًۭا","waṭama‘an","and a hope","ও আশার"],["وَيُنشِئُ","wayunshi-u","and brings up","এবং সৃষ্টি করেন"],["ٱلسَّحَابَ","l-saḥāba","the clouds","মেঘ"],["ٱلثِّقَالَ","l-thiqāla","the heavy","(পানিভরা) ঘন"]],"t":"هُوَ <h>ٱ</>لَّذِى يُرِيكُمُ <h>ٱ</>لْبَرْقَ خَوْ<d>فًۭا وَ</>طَمَ<d>عًۭا وَ</>يُ<k>نشِ</>ئُ <h>ٱ</><l>ل</>سَّحَابَ <h>ٱ</><l>ل</>ثِّ<p>قَا</>لَ"},{"n":13,"w":[["وَيُسَبِّحُ","wayusabbiḥu","And glorifies","এবং মহিমা প্রকাশ করে"],["ٱلرَّعْدُ","l-ra‘du","the thunder","বজ্রনির্ঘোষ"],["بِحَمْدِهِۦ","biḥamdihi","with his praise ","সাথে তাঁর প্রশংসার"],["وَٱلْمَلَـٰٓئِكَةُ","wal-malāikatu","and the Angels","এবং ফেরেশতারাও"],["مِنْ","min","for","থেকে"],["خِيفَتِهِۦ","khīfatihi","fear of Him","তাঁর ভয়"],["وَيُرْسِلُ","wayur'silu","And He sends","এবং তিনি পাঠান"],["ٱلصَّوَٰعِقَ","l-ṣawā‘iqa","the thunderbolts","গর্জনকারী বজ্রসমূহ"],["فَيُصِيبُ","fayuṣību","and strikes","অতঃপর আঘাত করেন"],["بِهَا","bihā","with it","দিয়ে তা"],["مَن","man","whom","যাকে"],["يَشَآءُ","yashāu","He wills","ইচ্ছে করেন"],["وَهُمْ","wahum","yet they","তবুও তারা"],["يُجَـٰدِلُونَ","yujādilūna","dispute","বাক-বিতন্ডা করে"],["فِى","fī","about","সম্বন্ধে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["وَهُوَ","wahuwa","And He","অথচ তিনি"],["شَدِيدُ","shadīdu","(is) Mighty","শক্তিতে প্রবল"],["ٱلْمِحَالِ","l-miḥāli","(in) Strength","শাস্তিতে কঠোর"]],"t":"وَيُسَبِّحُ <h>ٱ</><l>ل</>رَّعْدُ بِحَمْدِ<m>هِۦ</> وَ<h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةُ مِنْ خِيفَتِ<m>هِۦ</> وَيُرْسِلُ <h>ٱ</><l>ل</>صَّ<m>وَٰ</>عِقَ فَيُصِيبُ بِهَا <d>مَن يَ</><o>شَآ</>ءُ وَهُمْ يُ<m>جَٰ</>دِلُونَ فِى <h>ٱ</>للَّهِ وَهُوَ شَدِيدُ <h>ٱ</>لْمِ<p>حَا</>لِ"},{"n":14,"w":[["لَهُۥ","lahu","To Him","তাঁরই জন্য"],["دَعْوَةُ","da‘watu","(is) supplication","আহবান"],["ٱلْحَقِّ ۖ","l-ḥaqi","(of) the truth","সত্যের"],["وَٱلَّذِينَ","wa-alladhīna","And those whom","এবং যারা"],["يَدْعُونَ","yad‘ūna","they invoke","ডাকে"],["مِن","min","besides Him","ছাড়া"],["دُونِهِۦ","dūnihi","besides Him","তাঁকে (অন্য কাউকে)"],["لَا","lā","not","না"],["يَسْتَجِيبُونَ","yastajībūna","they respond","তারা সাড়া দেয়"],["لَهُم","lahum","to them","তাদেরকে"],["بِشَىْءٍ","bishayin","with a thing","কোনো কিছুর"],["إِلَّا","illā","except","এ ছাড়া"],["كَبَـٰسِطِ","kabāsiṭi","like one who stretches","মতো সম্প্রসারণকারীর"],["كَفَّيْهِ","kaffayhi","his hands","তার দু'হাত"],["إِلَى","ilā","towards","প্রতি"],["ٱلْمَآءِ","l-māi","water","পানির"],["لِيَبْلُغَ","liyablugha","to reach","যেন পৌঁছে"],["فَاهُ","fāhu","his mouth","তার মুখে"],["وَمَا","wamā","but not","অথচ নয়"],["هُوَ","huwa","it","তা"],["بِبَـٰلِغِهِۦ ۚ","bibālighihi","reaches it","তার কাছে পৌঁছবার"],["وَمَا","wamā","And not","এবং নয়"],["دُعَآءُ","du‘āu","(is) the supplication","ডাক"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","(of) the disbelievers","কাফেরদের"],["إِلَّا","illā","but","এ ছাড়া"],["فِى","fī","in","মধ্যে"],["ضَلَـٰلٍۢ","ḍalālin","error","ভ্রান্তির"]],"t":"لَهُ<m>ۥ</> دَعْوَةُ <h>ٱ</>لْحَقِّ ۖ وَ<h>ٱ</>لَّذِينَ يَ<q>دْ</>عُونَ مِ<k>ن دُ</>ونِ<m>هِۦ</> لَا يَسْتَجِيبُونَ لَ<f>هُم بِ</>شَىْءٍ إِلَّا كَ<m>بَٰ</>سِطِ كَفَّيْهِ إِلَى <h>ٱ</>لْ<o>مَآ</>ءِ لِيَ<q>بْ</>لُغَ فَاهُ وَمَا هُوَ بِ<m>بَٰ</>لِغِ<m>هِۦ</> ۚ وَمَا دُ<o>عَآ</>ءُ <h>ٱ</>لْ<m>كَٰ</>فِرِينَ إِلَّا فِى ضَ<p>لَٰ</>لٍۢ"},{"n":15,"w":[["وَلِلَّهِ","walillahi","And to Allah","এবং আল্লাহকেই"],["يَسْجُدُ","yasjudu","prostrates","সিজদা করে"],["مَن","man","whoever","যা কিছু"],["فِى","fī","(is) in","মধ্যে আছে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশের"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীর"],["طَوْعًۭا","ṭaw‘an","willingly","ইচ্ছায়"],["وَكَرْهًۭا","wakarhan","or unwillingly","ও অনিচ্ছায়"],["وَظِلَـٰلُهُم","waẓilāluhum","and (so do) their shadows","এবং তাদের ছায়াগুলোও"],["بِٱلْغُدُوِّ","bil-ghuduwi","in the mornings","বেলায় সকাল"],["وَٱلْـَٔاصَالِ ۩","wal-āṣāli","and in the afternoons","এবং সন্ধ্যায় (নত হয়)"]],"t":"وَلِلَّهِ يَسْجُدُ مَ<k>ن فِ</>ى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ طَوْ<d>عًۭا وَ</>كَرْ<d>هًۭا وَ</>ظِ<m>لَٰ</>لُ<f>هُم بِ</><h>ٱ</>لْغُدُوِّ وَ<h>ٱ</>لْءَاصَ<p>ا</>لِ ۩"},{"n":16,"w":[["قُلْ","qul","Say","বলো"],["مَن","man","Who","\"কে"],["رَّبُّ","rabbu","(is) the Lord","রব"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশের"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীর\""],["قُلِ","quli","Say","বলো"],["ٱللَّهُ ۚ","l-lahu","Allah","\"(তিনিই) আল্লাহ\""],["قُلْ","qul","Say","বলো"],["أَفَٱتَّخَذْتُم","afa-ittakhadhtum","Have you then taken","\"তোমরা তাহ'লে কি গ্রহণ করেছো"],["مِّن","min","from","পরিবর্তে"],["دُونِهِۦٓ","dūnihi","besides Him","তার"],["أَوْلِيَآءَ","awliyāa","protectors","অভিভাবকরূপে (অন্য অনেককে)"],["لَا","lā","not","না"],["يَمْلِكُونَ","yamlikūna","they have power","তারা সক্ষম হয়"],["لِأَنفُسِهِمْ","li-anfusihim","for themselves","তাদের নিজেদের জন্য"],["نَفْعًۭا","naf‘an","(to) benefit","কোনো উপকারের"],["وَلَا","walā","and not","আর না"],["ضَرًّۭا ۚ","ḍarran","(to) harm","কোনো ক্ষতির\""],["قُلْ","qul","Say","বলো"],["هَلْ","hal","Is","\"কি"],["يَسْتَوِى","yastawī","equal","সমান হয়"],["ٱلْأَعْمَىٰ","l-a‘mā","the blind","অন্ধ"],["وَٱلْبَصِيرُ","wal-baṣīru","and the seeing","ও চক্ষুষ্মান"],["أَمْ","am","Or","অথবা"],["هَلْ","hal","is","কি"],["تَسْتَوِى","tastawī","equal","সমান হয়"],["ٱلظُّلُمَـٰتُ","l-ẓulumātu","the darkness[es]","অন্ধকারসমূহ"],["وَٱلنُّورُ ۗ","wal-nūru","and the light","ও আলো"],["أَمْ","am","Or","(তবে) কি"],["جَعَلُوا۟","ja‘alū","they attribute","তারা স্হির করেছে"],["لِلَّهِ","lillahi","to Allah","আল্লাহর জন্যে"],["شُرَكَآءَ","shurakāa","partners","এমন শরীকদের"],["خَلَقُوا۟","khalaqū","who created","যা সৃষ্টি করেছে"],["كَخَلْقِهِۦ","kakhalqihi","like His creation","মতো তাঁর সৃষ্টি"],["فَتَشَـٰبَهَ","fatashābaha","so that seemed alike","এ কারণে বিভ্রান্তি ঘটিয়েছে"],["ٱلْخَلْقُ","l-khalqu","the creation","সৃষ্টি"],["عَلَيْهِمْ ۚ","‘alayhim","to them","কাছে তাদের\""],["قُلِ","quli","Say","বলো"],["ٱللَّهُ","l-lahu","Allah","\"আল্লাহই"],["خَـٰلِقُ","khāliqu","(is) the Creator","স্রষ্টা"],["كُلِّ","kulli","of all","সব"],["شَىْءٍۢ","shayin","things","কিছুর"],["وَهُوَ","wahuwa","and He","এবং তিনি"],["ٱلْوَٰحِدُ","l-wāḥidu","(is) the One","এক"],["ٱلْقَهَّـٰرُ","l-qahāru","the Irresistible","মহাপরাক্রমশালী\""]],"t":"قُلْ <w>مَن رَّ</>بُّ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ قُلِ <h>ٱ</>للَّهُ ۚ قُلْ أَفَ<h>ٱ</>تَّخَذْ<y>تُم مِّ</><k>ن دُ</>ونِ<o>هِۦٓ</> أَوْلِ<o>يَآ</>ءَ لَا يَمْلِكُونَ لِأَ<k>نفُ</>سِهِمْ نَفْ<d>عًۭا وَ</>لَا ضَ<k>رًّۭا ۚ قُ</>لْ هَلْ يَسْتَوِى <h>ٱ</>لْأَعْمَىٰ وَ<h>ٱ</>لْبَصِيرُ أَمْ هَلْ تَسْتَوِى <h>ٱ</><l>ل</>ظُّلُ<m>مَٰ</>تُ وَ<h>ٱ</><l>ل</><g>نُّ</>ورُ ۗ أَمْ جَعَلُو<s>ا۟</> لِلَّهِ شُرَ<o>كَآ</>ءَ خَلَقُو<s>ا۟</> كَخَلْقِ<m>هِۦ</> فَتَ<m>شَٰ</>بَهَ <h>ٱ</>لْخَلْقُ عَلَيْهِمْ ۚ قُلِ <h>ٱ</>للَّهُ <m>خَٰ</>لِقُ كُلِّ <d>شَىْءٍۢ وَ</>هُوَ <h>ٱ</>لْ<m>وَٰ</>حِدُ <h>ٱ</>لْقَ<p>هَّٰ</>رُ"},{"n":17,"w":[["أَنزَلَ","anzala","He sends down","তিনি বর্ষণ করেন"],["مِنَ","mina","from","থেকে"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশ"],["مَآءًۭ","māan","water","পানি"],["فَسَالَتْ","fasālat","and flows","ফলে প্লাবিত হয়"],["أَوْدِيَةٌۢ","awdiyatun","the valleys","উপত্যকাসমূহ"],["بِقَدَرِهَا","biqadarihā","according to their measure","তার পরিমাণ অনুসারে"],["فَٱحْتَمَلَ","fa-iḥ'tamala","and carries","অতঃপর বহন করে"],["ٱلسَّيْلُ","l-saylu","the torrent","প্লাবন"],["زَبَدًۭا","zabadan","a foam","ফেনা"],["رَّابِيًۭا ۚ","rābiyan","rising","উপরিভাগে"],["وَمِمَّا","wamimmā","And from what","এবং তা থেকেও যা"],["يُوقِدُونَ","yūqidūna","they heat","তারা উত্তপ্ত করে"],["عَلَيْهِ","‘alayhi","[on] it","তার উপর"],["فِى","fī","in","মধ্যে"],["ٱلنَّارِ","l-nāri","the fire","আগুনের"],["ٱبْتِغَآءَ","ib'tighāa","in order to make","(বানাতে) চায়"],["حِلْيَةٍ","ḥil'yatin","ornaments","অলংকা