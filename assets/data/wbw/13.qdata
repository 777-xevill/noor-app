yahdī","and guides","ও পথ দেখান"],["إِلَيْهِ","ilayhi","to Himself","তাঁর দিকে"],["مَنْ","man","whoever","যে"],["أَنَابَ","anāba","turns back","মুখ ফিরায়"]],"t":"وَيَقُولُ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> لَوْ<o>لَآ</> أُ<k>نزِ</>لَ عَلَيْهِ ءَايَ<d>ةٌۭ مِّ</><w>ن رَّ</>بِّ<m>هِۦ</> ۗ قُلْ إِ<g>نَّ</> <h>ٱ</>للَّهَ يُضِلُّ <d>مَن يَ</><o>شَآ</>ءُ وَيَهْ<o>دِىٓ</> إِلَيْهِ مَنْ أَ<p>نَا</><q>بَ</>"},{"n":28,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["ءَامَنُوا۟","āmanū","believed","ঈমান এনেছে"],["وَتَطْمَئِنُّ","wataṭma-innu","and find satisfaction","ও শান্তি লাভ করে"],["قُلُوبُهُم","qulūbuhum","their hearts","তাদের অন্তরগুলো"],["بِذِكْرِ","bidhik'ri","in the remembrance","মাধ্যমে স্মরণের"],["ٱللَّهِ ۗ","l-lahi","(of) Allah","আল্লাহর"],["أَلَا","alā","No doubt","জেনে রাখো"],["بِذِكْرِ","bidhik'ri","in the remembrance","স্মরণে"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["تَطْمَئِنُّ","taṭma-innu","find satisfaction","শান্তি লাভ করে"],["ٱلْقُلُوبُ","l-qulūbu","the hearts","অন্তরসমূহ\""]],"t":"ٱلَّذِينَ ءَامَنُو<s>ا۟</> وَتَ<q>طْ</>مَئِ<g>نُّ</> قُلُوبُ<f>هُم بِ</>ذِكْرِ <h>ٱ</>للَّهِ ۗ أَلَا بِذِكْرِ <h>ٱ</>للَّهِ تَ<q>طْ</>مَئِ<g>نُّ</> <h>ٱ</>لْقُ<p>لُو</><q>بُ</>"},{"n":29,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["ءَامَنُوا۟","āmanū","believed","ঈমান এসেছে"],["وَعَمِلُوا۟","wa‘amilū","and did","ও কাজ করেছে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","righteous deeds","সৎ"],["طُوبَىٰ","ṭūbā","blessedness","সুসংবাদ"],["لَهُمْ","lahum","(is) for them","তাদের জন্যে রয়েছে"],["وَحُسْنُ","waḥus'nu","and a beautiful","ও উত্তম"],["مَـَٔابٍۢ","maābin","place of return","পরিণাম"]],"t":"ٱلَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ طُوبَىٰ لَهُمْ وَحُسْنُ <p>مَـَٔا</><q>بٍۢ</>"},{"n":30,"w":[["كَذَٰلِكَ","kadhālika","Thus","(হে মুহাম্মাদ) এভাবে"],["أَرْسَلْنَـٰكَ","arsalnāka","We have sent you","তোমাকে আমরা পাঠিয়েছি (রাসূলরূপে)"],["فِىٓ","fī","to","মধ্যে"],["أُمَّةٍۢ","ummatin","a nation","এক জাতির"],["قَدْ","qad","verily","নিশ্চয়ই"],["خَلَتْ","khalat","have passed away","অতীত হয়েছে"],["مِن","min","from","থেকেই"],["قَبْلِهَآ","qablihā","before it","তার পূর্ব"],["أُمَمٌۭ","umamun","nations","বহু জাতি"],["لِّتَتْلُوَا۟","litatluwā","so that you might recite","যাতে তুমি পাঠ করো"],["عَلَيْهِمُ","‘alayhimu","to them","কাছে তাদের"],["ٱلَّذِىٓ","alladhī","what","যা"],["أَوْحَيْنَآ","awḥaynā","We revealed","আমরা ওহী করেছি"],["إِلَيْكَ","ilayka","to you","তোমার প্রতি"],["وَهُمْ","wahum","while they","এ অবস্থায়ও তারা"],["يَكْفُرُونَ","yakfurūna","disbelieve","অস্বীকার করে"],["بِٱلرَّحْمَـٰنِ ۚ","bil-raḥmāni","in the Most Gracious","পরম দয়াময়কে"],["قُلْ","qul","Say","বলো"],["هُوَ","huwa","He","\"তিনিই"],["رَبِّى","rabbī","(is) my Lord","আমার রব"],["لَآ","lā","(there is) no","নেই"],["إِلَـٰهَ","ilāha","god","কোন ইলাহ"],["إِلَّا","illā","except","ছাড়া"],["هُوَ","huwa","Him","তিনি"],["عَلَيْهِ","‘alayhi","Upon Him","তাঁরই উপর"],["تَوَكَّلْتُ","tawakkaltu","I put my trust","আমি নির্ভর করেছি"],["وَإِلَيْهِ","wa-ilayhi","and to Him","এবং তাঁরই দিকে"],["مَتَابِ","matābi","(is) my return","আমার প্রত্যাবর্তন\""]],"t":"كَ<m>ذَٰ</>لِكَ أَرْسَلْ<m>نَٰ</>كَ <o>فِىٓ</> أُ<g>مَّ</><k>ةٍۢ قَ</><q>دْ</> خَلَتْ مِ<k>ن قَ</><q>بْ</>لِ<o>هَآ</> أُمَ<w>مٌۭ لِّ</>تَتْلُوَ<s>ا۟</> عَلَيْهِمُ <h>ٱ</>لَّ<o>ذِىٓ</> أَوْحَيْ<o>نَآ</> إِلَيْكَ وَهُمْ يَكْفُرُونَ بِ<h>ٱ</><l>ل</>رَّحْ<m>مَٰ</>نِ ۚ قُلْ هُوَ رَبِّى <o>لَآ</> إِ<m>لَٰ</>هَ إِلَّا هُوَ عَلَيْهِ تَوَكَّلْتُ وَإِلَيْهِ مَ<p>تَا</><q>بِ</>"},{"n":31,"w":[["وَلَوْ","walaw","And if","এবং যদি (এমন হতো)"],["أَنَّ","anna","that was","যে"],["قُرْءَانًۭا","qur'ānan","any Quran","(এই) কুরআন"],["سُيِّرَتْ","suyyirat","could be moved","গতিশীল করা যেতো"],["بِهِ","bihi","by it","দিয়ে তা"],["ٱلْجِبَالُ","l-jibālu","the mountains","পাহাড়সমূহকে"],["أَوْ","aw","or","বা"],["قُطِّعَتْ","quṭṭi‘at","could be cloven asunder","টুকরো টুকরো করা যেতো"],["بِهِ","bihi","by it","দিয়ে তা"],["ٱلْأَرْضُ","l-arḍu","the earth","জমিনকে"],["أَوْ","aw","or","অথবা"],["كُلِّمَ","kullima","could be made to speak","কথা বলা যেতো"],["بِهِ","bihi","by it","দিয়ে তা"],["ٱلْمَوْتَىٰ ۗ","l-mawtā","the dead","মৃতদের সাথে (তবুও ঈমান আনতো না)"],["بَل","bal","Nay","বরং"],["لِّلَّهِ","lillahi","with Allah","আল্লাহর নিয়ন্ত্রণে"],["ٱلْأَمْرُ","l-amru","(is) the command","বিষয়"],["جَمِيعًا ۗ","jamī‘an","all","সমস্তই"],["أَفَلَمْ","afalam","Then do not","তবে কি না"],["يَا۟يْـَٔسِ","yāy'asi","know","নিরাশ হয়েছে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ءَامَنُوٓا۟","āmanū","believe","ঈমান এনেছে"],["أَن","an","that","যে"],["لَّوْ","law","if","যদি"],["يَشَآءُ","yashāu","had willed","ইচ্ছে করতেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["لَهَدَى","lahadā","surely, He would have guided","অবশ্যই পথ দেখাতেন"],["ٱلنَّاسَ","l-nāsa","all","মানুষকে"],["جَمِيعًۭا ۗ","jamī‘an","all of the mankind","সকল"],["وَلَا","walā","And not","এবং না"],["يَزَالُ","yazālu","will cease","সর্বদাই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieve","অস্বীকার করেছে"],["تُصِيبُهُم","tuṣībuhum","to strike them","তাদের কাছে পৌঁছবে"],["بِمَا","bimā","for what","এ কারণে যা"],["صَنَعُوا۟","ṣana‘ū","they did","তারা করেছে"],["قَارِعَةٌ","qāri‘atun","a disaster","বিপর্যয়"],["أَوْ","aw","or","অথবা"],["تَحُلُّ","taḥullu","it settles","আপতিত হবে"],["قَرِيبًۭا","qarīban","close","নিকটে"],["مِّن","min","from","থেকে"],["دَارِهِمْ","dārihim","their homes","তাদের ঘরের"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["يَأْتِىَ","yatiya","comes","আসবে"],["وَعْدُ","wa‘du","(the) promise","অঙ্গীকার"],["ٱللَّهِ ۚ","l-lahi","(of) Allah","আল্লাহর"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَا","lā","(will) not","না"],["يُخْلِفُ","yukh'lifu","fail","ভঙ্গ করেন"],["ٱلْمِيعَادَ","l-mī‘āda","(in) the Promise","অঙ্গীকার"]],"t":"وَلَوْ أَ<g>نَّ</> قُرْءَا<k>نًۭا سُ</>يِّرَتْ بِهِ <h>ٱ</>لْجِبَالُ أَوْ قُطِّعَتْ بِهِ <h>ٱ</>لْأَرْضُ أَوْ كُلِّمَ بِهِ <h>ٱ</>لْمَوْتَىٰ ۗ بَل لِّلَّهِ <h>ٱ</>لْأَمْرُ جَمِيعًا ۗ أَفَلَمْ يَ<s>ا۟</>يْـَٔسِ <h>ٱ</>لَّذِينَ ءَامَ<o>نُوٓ</><s>ا۟</> <w>أَن لَّ</>وْ يَ<o>شَآ</>ءُ <h>ٱ</>للَّهُ لَهَدَى <h>ٱ</><l>ل</><g>نَّ</>اسَ جَمِي<d>عًۭا ۗ وَ</>لَا يَزَالُ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> تُصِيبُ<f>هُم بِ</>مَا صَنَعُو<s>ا۟</> قَارِعَةٌ أَوْ تَحُلُّ قَرِي<d>بًۭا مِّ</><k>ن دَ</>ارِهِمْ حَتَّىٰ يَأْتِىَ وَعْدُ <h>ٱ</>للَّهِ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ لَا يُخْلِفُ <h>ٱ</>لْمِي<p>عَا</><q>دَ</>"},{"n":32,"w":[["وَلَقَدِ","walaqadi","And certainly","এবং নিশ্চয়ই"],["ٱسْتُهْزِئَ","us'tuh'zi-a","were mocked","বিদ্রুপ করা হয়েছে"],["بِرُسُلٍۢ","birusulin","Messengers","সাথে রাসূলদের"],["مِّن","min","from","থেকেই"],["قَبْلِكَ","qablika","before you","তোমার পূর্ব"],["فَأَمْلَيْتُ","fa-amlaytu","but I granted respite","অতঃপর আমি অবকাশ দিয়েছি"],["لِلَّذِينَ","lilladhīna","to those who","(তাদেরকে) জন্যে যারা"],["كَفَرُوا۟","kafarū","disbelieved","অস্বীকার করেছে"],["ثُمَّ","thumma","then","এরপর"],["أَخَذْتُهُمْ ۖ","akhadhtuhum","I seized them","তাদের আমি পাকড়াও করেছি"],["فَكَيْفَ","fakayfa","and how","অতঃপর (দেখো) কেমন"],["كَانَ","kāna","was","ছিলো"],["عِقَابِ","‘iqābi","My penalty","আমার শাস্তি"]],"t":"وَلَقَدِ <h>ٱ</>سْتُهْزِئَ بِرُسُ<d>لٍۢ مِّ</><k>ن قَ</><q>بْ</>لِكَ فَأَمْلَيْتُ لِلَّذِينَ كَفَرُو<s>ا۟</> ثُ<g>مَّ</> أَخَذْتُهُمْ ۖ فَكَيْفَ كَانَ عِ<p>قَا</><q>بِ</>"},{"n":33,"w":[["أَفَمَنْ","afaman","Is then He Who","তবে কি সেই (সত্ত্বা)"],["هُوَ","huwa","(He)","যিনি"],["قَآئِمٌ","qāimun","(is) a Maintainer","দন্ডায়মান (পর্যবেক্ষক)"],["عَلَىٰ","‘alā","of","উপর"],["كُلِّ","kulli","every","প্রত্যেক"],["نَفْسٍۭ","nafsin","soul","মানুষ"],["بِمَا","bimā","for what","ঐ সম্পর্কে যা"],["كَسَبَتْ ۗ","kasabat","it has earned","সে উপার্জন করেছে"],["وَجَعَلُوا۟","waja‘alū","Yet they ascribe","এ অবস্হায়ও তারা বানিয়েছে"],["لِلَّهِ","lillahi","to Allah","আল্লাহর জন্যে"],["شُرَكَآءَ","shurakāa","partners","বহু শরীক"],["قُلْ","qul","Say","বলো"],["سَمُّوهُمْ ۚ","sammūhum","Name them","\"তাদের নাম বলো"],["أَمْ","am","Or","কি"],["تُنَبِّـُٔونَهُۥ","tunabbiūnahu","(do) you inform Him","তাঁকে তোমরা সংবাদ দিচ্ছো"],["بِمَا","bimā","of what","ঐ সম্পর্কে যা"],["لَا","lā","not","না"],["يَعْلَمُ","ya‘lamu","He knows","তিনি জানেন"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["أَم","am","or","অথবা"],["بِظَـٰهِرٍۢ","biẓāhirin","of the apparent","বাহ্যিক দিক"],["مِّنَ","mina","of","কিছু"],["ٱلْقَوْلِ ۗ","l-qawli","the words","(অর্থহীন) কথার\""],["بَلْ","bal","Nay","বরং"],["زُيِّنَ","zuyyina","(is) made fair-seeming","শোভনীয় করা হয়েছে"],["لِلَّذِينَ","lilladhīna","to those who","(তাদের) জন্যে যারা"],["كَفَرُوا۟","kafarū","disbelieve","অস্বীকার করেছে"],["مَكْرُهُمْ","makruhum","their plotting","তাদের ছলনা"],["وَصُدُّوا۟","waṣuddū","and they are hindered","এবং নিবৃত্ত করা হয়েছে"],["عَنِ","‘ani","from","থেকে"],["ٱلسَّبِيلِ ۗ","l-sabīli","the Path","পথ"],["وَمَن","waman","And whoever","এবং যাকে"],["يُضْلِلِ","yuḍ'lili","(by) Allah","পথভ্রষ্ট করেন"],["ٱللَّهُ","l-lahu","Allah lets go astray","আল্লাহ"],["فَمَا","famā","then not","অতঃপর নেই"],["لَهُۥ","lahu","for him","জন্যে তার"],["مِنْ","min","any","কোনো"],["هَادٍۢ","hādin","guide","পথ প্রদর্শক"]],"t":"أَفَمَنْ هُوَ <o>قَآ</>ئِمٌ عَلَىٰ كُلِّ نَفْ<i>سٍۭ بِ</>مَا كَسَبَتْ ۗ وَجَعَلُو<s>ا۟</> لِلَّهِ شُرَ<o>كَآ</>ءَ قُلْ سَ<g>مُّ</>وهُمْ ۚ أَمْ تُنَبِّـُٔونَهُ<m>ۥ</> بِمَا لَا يَعْلَمُ فِى <h>ٱ</>لْأَرْضِ <f>أَم بِ</><m>ظَٰ</>هِ<d>رٍۢ مِّ</>نَ <h>ٱ</>لْقَوْلِ ۗ بَلْ زُيِّنَ لِلَّذِينَ كَفَرُو<s>ا۟</> مَكْرُهُمْ وَصُدُّو<s>ا۟</> عَنِ <h>ٱ</><l>ل</>سَّبِيلِ ۗ وَ<d>مَن يُ</>ضْلِلِ <h>ٱ</>للَّهُ فَمَا لَهُ<m>ۥ</> مِنْ <p>هَا</><q>دٍۢ</>"},{"n":34,"w":[["لَّهُمْ","lahum","For them","তাদের জন্যে"],["عَذَابٌۭ","‘adhābun","(is) a punishment","শাস্তি (রয়েছে)"],["فِى","fī","in","মধ্যে"],["ٱلْحَيَوٰةِ","l-ḥayati","the life","জীবনের"],["ٱلدُّنْيَا ۖ","l-dun'yā","(of) the world","পার্থিব"],["وَلَعَذَابُ","wala‘adhābu","and surely the punishment","এবং অবশ্যই শাস্তি"],["ٱلْـَٔاخِرَةِ","l-ākhirati","(of) the Hereafter","আখিরাতের"],["أَشَقُّ ۖ","ashaqqu","(is) harder","কঠোরতর"],["وَمَا","wamā","And not","এবং নেই"],["لَهُم","lahum","for them","তাদের জন্যে"],["مِّنَ","mina","against","থেকে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["مِن","min","any","কোনো"],["وَاقٍۢ","wāqin","defender","রক্ষাকারী"]],"t":"لَّهُمْ عَذَا<k>بٌۭ فِ</>ى <h>ٱ</>لْحَيَ<s>وٰ</>ةِ <h>ٱ</><l>ل</>دُّنْيَا ۖ وَلَعَذَابُ <h>ٱ</>لْءَاخِرَةِ أَشَقُّ ۖ وَمَا لَ<y>هُم مِّ</>نَ <h>ٱ</>للَّهِ <d>مِن وَ</><p>ا</><q>قٍۢ</>"},{"n":35,"w":[["۞ مَّثَلُ","mathalu","The example","দৃষ্টান্ত (পরিচয়)"],["ٱلْجَنَّةِ","l-janati","of Paradise","জান্নাতের"],["ٱلَّتِى","allatī","which","যা"],["وُعِدَ","wu‘ida","(is) promised","প্রতিশ্রুতি দেয়া হয়েছে"],["ٱلْمُتَّقُونَ ۖ","l-mutaqūna","(to) the righteous","মুত্তাকীদের (এমন যে)"],["تَجْرِى","tajrī","flows","প্রবাহিত হয়"],["مِن","min","from","থেকে"],["تَحْتِهَا","taḥtihā","underneath it","তার নিচ"],["ٱلْأَنْهَـٰرُ ۖ","l-anhāru","the rivers","ঝর্ণাসমূহ"],["أُكُلُهَا","ukuluhā","Its food","তার ফলসমূহ"],["دَآئِمٌۭ","dāimun","(is) everlasting","চিরস্হায়ী"],["وَظِلُّهَا ۚ","waẓilluhā","and its shade","এবং তার ছায়াও (অবিনশ্বর)"],["تِلْكَ","til'ka","This","এসব"],["عُقْبَى","‘uq'bā","(is the) end","পরিণাম"],["ٱلَّذِينَ","alladhīna","of those who","(তাদের) যারা"],["ٱتَّقَوا۟ ۖ","ittaqaw","(are) righteous","(আল্লাহকে) ভয় করে"],["وَّعُقْبَى","wa‘uq'bā","and (the) end","ও পরিণাম"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","(of) the disbelievers","কাফেরদের"],["ٱلنَّارُ","l-nāru","(is) the Fire","(জাহান্নামের) আগুন"]],"t":"۞ مَّثَلُ <h>ٱ</>لْجَ<g>نَّ</>ةِ <h>ٱ</>لَّتِى وُعِدَ <h>ٱ</>لْمُتَّقُونَ ۖ تَ<q>جْ</>رِى مِ<k>ن تَ</>حْتِهَا <h>ٱ</>لْأَنْ<m>هَٰ</>رُ ۖ أُكُلُهَا <o>دَآ</>ئِ<d>مٌۭ وَ</>ظِلُّهَا ۚ تِلْكَ عُ<q>قْ</>بَى <h>ٱ</>لَّذِينَ <h>ٱ</>تَّقَو<s>ا۟ ۖ</> وَّعُ<q>قْ</>بَى <h>ٱ</>لْ<m>كَٰ</>فِرِينَ <h>ٱ</><l>ل</><g>نَّ</><p>ا</>رُ"},{"n":36,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those (to) whom","এবং যাদেরকে"],["ءَاتَيْنَـٰهُمُ","ātaynāhumu","We have given them","আমরা দিয়েছি তাদের"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","কিতাব"],["يَفْرَحُونَ","yafraḥūna","rejoice","তারা আনন্দ পায়"],["بِمَآ","bimā","at what","এ কারণে যা"],["أُنزِلَ","unzila","has been revealed","অবতরণ করা হয়েছে"],["إِلَيْكَ ۖ","ilayka","to you","তোমার প্রতি"],["وَمِنَ","wamina","but among","আবার কিন্তু"],["ٱلْأَحْزَابِ","l-aḥzābi","the groups","বিভিন্ন দলের"],["مَن","man","(those) who","কেউ কেউ"],["يُنكِرُ","yunkiru","deny","অস্বীকার করে"],["بَعْضَهُۥ ۚ","ba‘ḍahu","a part of it","তার কিছু অংশ"],["قُلْ","qul","Say","বলো"],["إِنَّمَآ","innamā","Only","\"শুধুমাত্র"],["أُمِرْتُ","umir'tu","I have been commanded","আমাকে আদেশ করা হয়েছে"],["أَنْ","an","that","যে"],["أَعْبُدَ","a‘buda","I worship","আমি (যেন) ইবাদত করি"],["ٱللَّهَ","l-laha","Allah","আল্লাহর"],["وَلَآ","walā","and not","এবং না (যেন)"],["أُشْرِكَ","ush'rika","I associate partners","আমি শরীক করি"],["بِهِۦٓ ۚ","bihi","with Him","তাঁর সাথে (অন্য কাউকে)"],["إِلَيْهِ","ilayhi","To Him","তাঁরই দিকে"],["أَدْعُوا۟","ad‘ū","I call","আমি ডাকি"],["وَإِلَيْهِ","wa-ilayhi","and to Him","ও তাঁরই দিকে"],["مَـَٔابِ","maābi","(is) my return","আমার গন্তব্যস্থান\""]],"t":"وَ<h>ٱ</>لَّذِينَ ءَاتَيْ<m>نَٰ</>هُمُ <h>ٱ</>لْكِ<m>تَٰ</>بَ يَفْرَحُونَ بِ<o>مَآ</> أُ<k>نزِ</>لَ إِلَيْكَ ۖ وَمِنَ <h>ٱ</>لْأَحْزَابِ <d>مَن يُ</><k>نكِ</>رُ بَعْضَهُ<m>ۥ</> ۚ قُلْ إِ<g>نَّ</><o>مَآ</> أُمِرْتُ أَنْ أَعْبُدَ <h>ٱ</>للَّهَ وَ<o>لَآ</> أُشْرِكَ بِ<o>هِۦٓ ۚ</> إِلَيْهِ أَ<q>دْ</>عُو<s>ا۟</> وَإِلَيْهِ مَـَٔ<p>ا</><q>بِ</>"},{"n":37,"w":[["وَكَذَٰلِكَ","wakadhālika","And thus","এবং এভাবে"],["أَنزَلْنَـٰهُ","anzalnāhu","We have revealed it","তা আমরা অবতীর্ণ করেছি"],["حُكْمًا","ḥuk'man","(to be) a judgment of authority","বিধানরূপে"],["عَرَبِيًّۭا ۚ","‘arabiyyan","(in) Arabic","আরবী ভাষায়"],["وَلَئِنِ","wala-ini","And if","এবং অবশ্যই যদি"],["ٱتَّبَعْتَ","ittaba‘ta","you follow","তুমি অনুসরণ করো"],["أَهْوَآءَهُم","ahwāahum","their desires","তাদের খেয়ালখুশীর"],["بَعْدَ مَا","ba‘damā","after what","পরেও যা"],["جَآءَكَ","jāaka","came to you","তোমার কাছে এসেছে"],["مِنَ","mina","of","থেকে"],["ٱلْعِلْمِ","l-‘il'mi","the knowledge","জ্ঞান"],["مَا","mā","not","নেই"],["لَكَ","laka","for you","তোমার জন্যে"],["مِنَ","mina","against","বিরুদ্ধে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["مِن","min","any","কোনো"],["وَلِىٍّۢ","waliyyin","protector","অভিভাবক (বাঁচাতে)"],["وَلَا","walā","and not","এবং না"],["وَاقٍۢ","wāqin","defender","কোনো রক্ষাকারী"]],"t":"وَكَ<m>ذَٰ</>لِكَ أَ<k>نزَ</>لْ<m>نَٰ</>هُ حُكْمًا عَرَبِ<d>يًّۭا ۚ وَ</>لَئِنِ <h>ٱ</>تَّبَعْتَ أَهْ<o>وَآ</>ءَ<f>هُم بَ</>عْدَمَا <o>جَآ</>ءَكَ مِنَ <h>ٱ</>لْعِلْمِ مَا لَكَ مِنَ <h>ٱ</>للَّهِ <d>مِن وَلِىٍّۢ وَ</>لَا <p>وَا</><q>قٍۢ</>"},{"n":38,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["أَرْسَلْنَا","arsalnā","We sent","আমরা প্রেরণ করেছি"],["رُسُلًۭا","rusulan","Messengers","রাসূলদেরকে"],["مِّن","min","from","থেকেই"],["قَبْلِكَ","qablika","before you","তোমার পূর্ব"],["وَجَعَلْنَا","waja‘alnā","and We made","এবং আমরা দিয়েছিলাম"],["لَهُمْ","lahum","for them","জন্যে তাদের"],["أَزْوَٰجًۭا","azwājan","wives","স্ত্রীসমূহ"],["وَذُرِّيَّةًۭ ۚ","wadhurriyyatan","and offspring","ও সন্তান-সন্ততি"],["وَمَا","wamā","And not","এবং না"],["كَانَ","kāna","was","ছিলো (সম্ভব)"],["لِرَسُولٍ","lirasūlin","for a Messenger","কোনো রাসূলের জন্যে"],["أَن","an","that","যে"],["يَأْتِىَ","yatiya","he comes","সে আসবে"],["بِـَٔايَةٍ","biāyatin","with a sign","নিয়ে কোনো নিদর্শন"],["إِلَّا","illā","except","ছাড়া"],["بِإِذْنِ","bi-idh'ni","by the leave","নিয়ে অনুমতি"],["ٱللَّهِ ۗ","l-lahi","(of) Allah","আল্লাহর"],["لِكُلِّ","likulli","For everything","জন্যে প্রত্যেক"],["أَجَلٍۢ","ajalin","(is) a time","নির্ধারিত যুগের"],["كِتَابٌۭ","kitābun","prescribed","একটি কিতাব (আছে)"]],"t":"وَلَقَ<q>دْ</> أَرْسَلْنَا رُسُلًۭ<d>ا مِّ</><k>ن قَ</><q>بْ</>لِكَ وَجَعَلْنَا لَهُمْ أَزْ<m>وَٰ</><d>جًۭا وَ</>ذُرِّيَّ<d>ةًۭ ۚ وَ</>مَا كَانَ لِرَسُولٍ <d>أَن يَ</>أْتِىَ بِـَٔايَةٍ إِلَّا بِإِذْنِ <h>ٱ</>للَّهِ ۗ لِكُلِّ أَجَ<k>لٍۢ كِ</><p>تَا</><q>بٌۭ</>"},{"n":39,"w":[["يَمْحُوا۟","yamḥū","(Is) eliminated","নিশ্চিহ্ন করেন"],["ٱللَّهُ","l-lahu","(by) Allah","আল্লাহ"],["مَا","mā","what","যা"],["يَشَآءُ","yashāu","He wills","ইচ্ছে করেন"],["وَيُثْبِتُ ۖ","wayuth'bitu","and confirms","ও বহাল রাখেন (যা চান)"],["وَعِندَهُۥٓ","wa‘indahu","and with Him","এবং তাঁর কাছে আছে"],["أُمُّ","ummu","(is) the Mother (of) the Book","মূল"],["ٱلْكِتَـٰبِ","l-kitābi","(is) the Mother (of) the Book","কিতাবের"]],"t":"يَمْحُو<s>ا۟</> <h>ٱ</>للَّهُ مَا يَ<o>شَآ</>ءُ وَيُثْبِتُ ۖ وَعِ<k>ندَ</>هُ<o>ۥٓ</> أُ<g>مُّ</> <h>ٱ</>لْكِ<p>تَٰ</><q>بِ</>"},{"n":40,"w":[["وَإِن","wa-in","And whether","এবং যদি"],["مَّا","mā","(what)","যা"],["نُرِيَنَّكَ","nuriyannaka","We show you","তোমাকে আমরা দেখাই"],["بَعْضَ","ba‘ḍa","a part","কিছুটা"],["ٱلَّذِى","alladhī","(of) what","যা"],["نَعِدُهُمْ","na‘iduhum","We have promised them","তাদের প্রতিশ্রুতি দিচ্ছি আমরা"],["أَوْ","aw","or","অথবা"],["نَتَوَفَّيَنَّكَ","natawaffayannaka","We cause you to die","তোমাকে মৃত্যু দিই আমরা (যাই হউক)"],["فَإِنَّمَا","fa-innamā","so only","প্রকৃতপক্ষে"],["عَلَيْكَ","‘alayka","on you","তোমার দায়িত্ব"],["ٱلْبَلَـٰغُ","l-balāghu","(is) the conveyance","প্রচার করা"],["وَعَلَيْنَا","wa‘alaynā","and on Us","এবং আমাদের দায়িত্ব"],["ٱلْحِسَابُ","l-ḥisābu","(is) the reckoning","হিসাব-নিকাশের"]],"t":"وَ<d>إِن مَّ</>ا نُرِيَ<g>نَّ</>كَ بَعْضَ <h>ٱ</>لَّذِى نَعِدُهُمْ أَوْ نَتَوَفَّيَ<g>نَّ</>كَ فَإِ<g>نَّ</>مَا عَلَيْكَ <h>ٱ</>لْبَ<m>لَٰ</>غُ وَعَلَيْنَا <h>ٱ</>لْحِ<p>سَا</><q>بُ</>"},{"n":41,"w":[["أَوَلَمْ","awalam","Did not","কি নি"],["يَرَوْا۟","yaraw","they see","তারা দেখে"],["أَنَّا","annā","that We","যে আমরা"],["نَأْتِى","natī","come","আমরা চলে আসছি"],["ٱلْأَرْضَ","l-arḍa","(to) the land","জমিনের (উপর)"],["نَنقُصُهَا","nanquṣuhā","reducing it","তা সংকুচিত করছি আমরা"],["مِنْ","min","from","হ'তে"],["أَطْرَافِهَا ۚ","aṭrāfihā","its borders","তার চারপাশ"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["يَحْكُمُ","yaḥkumu","judges","আদেশ করেন"],["لَا","lā","(there is) no","নেই"],["مُعَقِّبَ","mu‘aqqiba","adjuster","কোনো প্রতিহতকারী"],["لِحُكْمِهِۦ ۚ","liḥuk'mihi","(of) His Judgment","তাঁর আদেশের"],["وَهُوَ","wahuwa","And He","এবং তিনি"],["سَرِيعُ","sarī‘u","(is) Swift","দ্রুত"],["ٱلْحِسَابِ","l-ḥisābi","(in) the reckoning","হিসাব-নিকাশে"]],"t":"أَوَلَمْ يَرَوْ<s>ا۟</> أَ<g>نَّ</>ا نَأْتِى <h>ٱ</>لْأَرْضَ نَ<k>نقُ</>صُهَا مِنْ أَ<q>طْ</>رَافِهَا ۚ وَ<h>ٱ</>للَّهُ يَحْكُمُ لَا مُعَقِّبَ لِحُكْمِ<m>هِۦ</> ۚ وَهُوَ سَرِيعُ <h>ٱ</>لْحِ<p>سَا</><q>بِ</>"},{"n":42,"w":[["وَقَدْ","waqad","And certainly","এবং নিশ্চয়ই"],["مَكَرَ","makara","plotted","চক্রান্ত করেছিলো"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["مِن","min","(were) from","থেকে"],["قَبْلِهِمْ","qablihim","before them","পূর্ব তাদের (ছিলো)"],["فَلِلَّهِ","falillahi","but for Allah","অতএব অধীনে আল্লাহর"],["ٱلْمَكْرُ","l-makru","(is) the plot","চক্রান্ত"],["جَمِيعًۭا ۖ","jamī‘an","all","সমস্তই"],["يَعْلَمُ","ya‘lamu","He knows","তিনি জানেন"],["مَا","mā","what","যা"],["تَكْسِبُ","taksibu","earns","অর্জন করে"],["كُلُّ","kullu","every","প্রত্যেক"],["نَفْسٍۢ ۗ","nafsin","soul","ব্যক্তি"],["وَسَيَعْلَمُ","wasaya‘lamu","and will know","এবং শীঘ্রই জানবে"],["ٱلْكُفَّـٰرُ","l-kufāru","the disbelievers","কাফেররা"],["لِمَنْ","liman","for whom","কার জন্যে"],["عُقْبَى","‘uq'bā","(is) the final","পরকালের"],["ٱلدَّارِ","l-dāri","the home","ঘর"]],"t":"وَقَ<q>دْ</> مَكَرَ <h>ٱ</>لَّذِينَ مِ<k>ن قَ</><q>بْ</>لِهِمْ فَلِلَّهِ <h>ٱ</>لْمَكْرُ جَمِي<d>عًۭا ۖ يَ</>عْلَمُ مَا تَكْسِبُ كُلُّ نَفْ<d>سٍۢ ۗ وَ</>سَيَعْلَمُ <h>ٱ</>لْكُ<m>فَّٰ</>رُ لِمَنْ عُ<q>قْ</>بَى <h>ٱ</><l>ل</><p>دَّا</>رِ"},{"n":43,"w":[["وَيَقُولُ","wayaqūlu","And say","এবং বলে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieve","অস্বীকার করেছে"],["لَسْتَ","lasta","You are not","\"তুমি নও"],["مُرْسَلًۭا ۚ","mur'salan","a Messenger","প্রেরিত (নাবী)\""],["قُلْ","qul","Say","বলো"],["كَفَىٰ","kafā","Sufficient","\"যথেষ্ট"],["بِٱللَّهِ","bil-lahi","(is) Allah","আল্লাহ তা'লা-ই"],["شَهِيدًۢا","shahīdan","(as) a Witness","সাক্ষী হিসেবে"],["بَيْنِى","baynī","between me","আমার মাঝে"],["وَبَيْنَكُمْ","wabaynakum","and between you","ও তোমাদের মাঝে"],["وَمَنْ","waman","and whoever","এবং (সাক্ষ্য) যে"],["عِندَهُۥ","‘indahu","[he] has",