e bliss","কল্যাণ (রয়েছে)"],["وَٱلَّذِينَ","wa-alladhīna","And for those who","এবং যারা"],["لَمْ","lam","(did) not","না"],["يَسْتَجِيبُوا۟","yastajībū","respond","সাড়া দেয়"],["لَهُۥ","lahu","to Him","তাঁর ডাকে"],["لَوْ","law","if","যদি"],["أَنَّ","anna","that","হয়"],["لَهُم","lahum","they had","জন্যে তাদের"],["مَّا","mā","whatever","যা কিছু"],["فِى","fī","(is) in","মধ্যে আছে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["جَمِيعًۭا","jamī‘an","all","সমস্তই"],["وَمِثْلَهُۥ","wamith'lahu","and like of it","আরও তার সমপরিমাণ"],["مَعَهُۥ","ma‘ahu","with it","তার সাথে"],["لَٱفْتَدَوْا۟","la-if'tadaw","surely they would offer ransom","অবশ্যই তারা মুক্তিপণ দিবে"],["بِهِۦٓ ۚ","bihi","with it","দিয়ে তা"],["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব (লোক)"],["لَهُمْ","lahum","for them","তাদের জন্যে রয়েছে"],["سُوٓءُ","sūu","(is) a terrible","মন্দ"],["ٱلْحِسَابِ","l-ḥisābi","reckoning","হিসাব"],["وَمَأْوَىٰهُمْ","wamawāhum","and their abode","এবং তাদের আবাস"],["جَهَنَّمُ ۖ","jahannamu","(is) Hell","জাহান্নাম"],["وَبِئْسَ","wabi'sa","and wretched","এবং অতি নিকৃষ্ট"],["ٱلْمِهَادُ","l-mihādu","(is) the resting place","আশ্রয়স্হল"]],"t":"لِلَّذِينَ <h>ٱ</>سْتَجَابُو<s>ا۟</> لِرَبِّهِمُ <h>ٱ</>لْحُسْنَىٰ ۚ وَ<h>ٱ</>لَّذِينَ لَمْ يَسْتَجِيبُو<s>ا۟</> لَهُ<m>ۥ</> لَوْ أَ<g>نَّ</> لَ<y>هُم مَّ</>ا فِى <h>ٱ</>لْأَرْضِ جَمِي<d>عًۭا وَ</>مِثْلَهُ<m>ۥ</> مَعَهُ<m>ۥ</> لَ<h>ٱ</>فْتَدَوْ<s>ا۟</> بِ<o>هِۦٓ ۚ</> أُ<s>و۟</><o>لَٰٓ</>ئِكَ لَهُمْ <o>سُوٓ</>ءُ <h>ٱ</>لْحِسَابِ وَمَأْوَ<m>ىٰ</>هُمْ جَهَ<g>نَّ</>مُ ۖ وَبِئْسَ <h>ٱ</>لْمِ<p>هَا</><q>دُ</>"},{"n":19,"w":[["۞ أَفَمَن","afaman","Then is (he) who","তবে কি যে ব্যক্তি"],["يَعْلَمُ","ya‘lamu","knows","জানে"],["أَنَّمَآ","annamā","that which","যে যা কিছু"],["أُنزِلَ","unzila","has been revealed","অবতীর্ণ হয়েছে"],["إِلَيْكَ","ilayka","to you","তোমার প্রতি"],["مِن","min","from","থেকে"],["رَّبِّكَ","rabbika","your Lord","তোমার রবের"],["ٱلْحَقُّ","l-ḥaqu","(is) the truth","সত্য"],["كَمَنْ","kaman","like (one) who","(ঐ ব্যক্তির) মতো যে"],["هُوَ","huwa","[he]","সে"],["أَعْمَىٰٓ ۚ","a‘mā","(is) blind","অন্ধ"],["إِنَّمَا","innamā","Only","প্রকৃতপক্ষে"],["يَتَذَكَّرُ","yatadhakkaru","pay heed","শিক্ষা গ্রহণ করে (তা থেকে)"],["أُو۟لُوا۟","ulū","men","সম্পন্নরাই"],["ٱلْأَلْبَـٰبِ","l-albābi","(of) understanding","বিবেক"]],"t":"۞ أَفَ<d>مَن يَ</>عْلَمُ أَ<g>نَّ</><o>مَآ</> أُ<k>نزِ</>لَ إِلَيْكَ <w>مِن رَّ</>بِّكَ <h>ٱ</>لْحَقُّ كَمَنْ هُوَ أَعْمَ<o>ىٰٓ ۚ</> إِ<g>نَّ</>مَا يَتَذَكَّرُ أُ<s>و۟</>لُو<s>ا۟</> <h>ٱ</>لْأَلْ<p>بَٰ</><q>بِ</>"},{"n":20,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["يُوفُونَ","yūfūna","fulfill","পূর্ণ করে সাথে"],["بِعَهْدِ","bi‘ahdi","the covenant","অঙ্গীকার"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَلَا","walā","and not","এবং না"],["يَنقُضُونَ","yanquḍūna","they break","তারা ভঙ্গ করে"],["ٱلْمِيثَـٰقَ","l-mīthāqa","the contract","প্রতিজ্ঞা"]],"t":"ٱلَّذِينَ يُوفُونَ بِعَهْدِ <h>ٱ</>للَّهِ وَلَا يَ<k>نقُ</>ضُونَ <h>ٱ</>لْمِي<p>ثَٰ</><q>قَ</>"},{"n":21,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["يَصِلُونَ","yaṣilūna","join","অক্ষুন্ন রাখে"],["مَآ","mā","what","যা"],["أَمَرَ","amara","(has been) commanded","নির্দেশ দিয়েছেন"],["ٱللَّهُ","l-lahu","(by) Allah","আল্লাহ তা'লা"],["بِهِۦٓ","bihi","[for it]","তা সম্বন্ধে"],["أَن","an","to","যে"],["يُوصَلَ","yūṣala","be joined","অক্ষুন্ন রাখতে"],["وَيَخْشَوْنَ","wayakhshawna","and fear","ও তারা ভয় করে"],["رَبَّهُمْ","rabbahum","their Lord","তাদের রবকে"],["وَيَخَافُونَ","wayakhāfūna","and are afraid","এবং তারা আশঙ্কা করে"],["سُوٓءَ","sūa","(of) the evil","মন্দ"],["ٱلْحِسَابِ","l-ḥisābi","the account","হিসাবের"]],"t":"وَ<h>ٱ</>لَّذِينَ يَصِلُونَ <o>مَآ</> أَمَرَ <h>ٱ</>للَّهُ بِ<o>هِۦٓ</> <d>أَن يُ</>وصَلَ وَيَخْشَوْنَ رَبَّهُمْ وَيَخَافُونَ <o>سُوٓ</>ءَ <h>ٱ</>لْحِ<p>سَا</><q>بِ</>"},{"n":22,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["صَبَرُوا۟","ṣabarū","(are) patient","ধৈর্য ধরে"],["ٱبْتِغَآءَ","ib'tighāa","seeking","লাভের জন্যে"],["وَجْهِ","wajhi","(the) Face","সন্তুষ্টি"],["رَبِّهِمْ","rabbihim","(of) their Lord","তাদের রবের"],["وَأَقَامُوا۟","wa-aqāmū","and establish","এবং তারা প্রতিষ্ঠা করে"],["ٱلصَّلَوٰةَ","l-ṣalata","the prayer","সালাত"],["وَأَنفَقُوا۟","wa-anfaqū","and spend","ও তারা ব্যয় করে"],["مِمَّا","mimmā","from what","(তা) থেকে যা"],["رَزَقْنَـٰهُمْ","razaqnāhum","We have provided them","আমরা জীবিকা দিয়েছি তাদের"],["سِرًّۭا","sirran","secretly","গোপনে"],["وَعَلَانِيَةًۭ","wa‘alāniyatan","and publicly","ও প্রকাশ্যে"],["وَيَدْرَءُونَ","wayadraūna","and they repel","এবং তারা প্রতিরোধ করে"],["بِٱلْحَسَنَةِ","bil-ḥasanati","with the good","দিয়ে ভালো"],["ٱلسَّيِّئَةَ","l-sayi-ata","the evil ","মন্দকে"],["أُو۟لَـٰٓئِكَ","ulāika","those","ঐসব লোক"],["لَهُمْ","lahum","for them","তাদের জন্যে (রয়েছে)"],["عُقْبَى","‘uq'bā","(is) the final attainment","পরকালের"],["ٱلدَّارِ","l-dāri","(of) the Home ","ঘর"]],"t":"وَ<h>ٱ</>لَّذِينَ صَبَرُو<s>ا۟</> <h>ٱ</><q>بْ</>تِ<o>غَآ</>ءَ وَ<q>جْ</>هِ رَبِّهِمْ وَأَقَامُو<s>ا۟</> <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةَ وَأَ<k>نفَ</>قُو<s>ا۟</> مِ<g>مَّ</>ا رَزَ<q>قْ</><m>نَٰ</>هُمْ سِ<d>رًّۭا وَ</>عَلَانِيَ<d>ةًۭ وَ</>يَ<q>دْ</>رَءُونَ بِ<h>ٱ</>لْحَسَنَةِ <h>ٱ</><l>ل</>سَّيِّئَةَ أُ<s>و۟</><o>لَٰٓ</>ئِكَ لَهُمْ عُ<q>قْ</>بَى <h>ٱ</><l>ل</><p>دَّا</>رِ"},{"n":23,"w":[["جَنَّـٰتُ","jannātu","Gardens","জান্নাত"],["عَدْنٍۢ","‘adnin","of Eden","স্হায়ী"],["يَدْخُلُونَهَا","yadkhulūnahā","they will enter them","তাতে তারা প্রবেশ করবে"],["وَمَن","waman","and whoever","এবং যে"],["صَلَحَ","ṣalaḥa","(were) righteous","সৎকাজ করেছে"],["مِنْ","min","among","মধ্য হ'তে"],["ءَابَآئِهِمْ","ābāihim","their fathers","তাদের পূর্ব-পুরুষদের"],["وَأَزْوَٰجِهِمْ","wa-azwājihim","and their spouses","ও তাদের পতি-পত্নীদের"],["وَذُرِّيَّـٰتِهِمْ ۖ","wadhurriyyātihim","and their offsprings","ও তাদের সন্তান-সন্ততিদের"],["وَٱلْمَلَـٰٓئِكَةُ","wal-malāikatu","And the Angels","এবং ফেরেশতারা"],["يَدْخُلُونَ","yadkhulūna","will enter","প্রবেশ করবে (উপস্হিত হবে)"],["عَلَيْهِم","‘alayhim","upon them","কাছে তাদের"],["مِّن","min","from","দিয়ে"],["كُلِّ","kulli","every","প্