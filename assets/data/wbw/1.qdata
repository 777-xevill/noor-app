{"n":1,"a":[{"n":1,"w":[["بِسْمِ","bis'mi","In (the) name","নামে"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহ (র)"],["ٱلرَّحْمَـٰنِ","l-raḥmāni","the Most Gracious","পরম করুণাময়"],["ٱلرَّحِيمِ","l-raḥīmi","the Most Merciful","অসীম দয়ালু"]],"t":"بِسْمِ <h>ٱ</>للَّهِ <h>ٱ</><l>ل</>رَّحْ<m>مَٰ</>نِ <h>ٱ</><l>ل</>رَّ<p>حِي</>مِ"},{"n":2,"w":[["ٱلْحَمْدُ","al-ḥamdu","All praises and thanks","সকল প্রশংসা"],["لِلَّهِ","lillahi","(be) to Allah","আল্লাহ্‌রই জন্য"],["رَبِّ","rabbi","the Lord","(যিনি) রব"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","of the universe","সারা জগতের"]],"t":"ٱلْحَمْدُ لِلَّهِ رَبِّ <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":3,"w":[["ٱلرَّحْمَـٰنِ","al-raḥmāni","The Most Gracious","অশেষ করুণাময়"],["ٱلرَّحِيمِ","l-raḥīmi","the Most Merciful","পরম দয়ালু"]],"t":"ٱ<l>ل</>رَّحْ<m>مَٰ</>نِ <h>ٱ</><l>ل</>رَّ<p>حِي</>مِ"},{"n":4,"w":[["مَـٰلِكِ","māliki","(The) Master","অধিপতি"],["يَوْمِ","yawmi","(of the) Day","দিনের"],["ٱلدِّينِ","l-dīni","(of the) Judgment","বিচারের"]],"t":"<m>مَٰ</>لِكِ يَوْمِ <h>ٱ</><l>ل</><p>دِّي</>نِ"},{"n":5,"w":[["إِيَّاكَ","iyyāka","You Alone","আপনারই শুধু"],["نَعْبُدُ","na‘budu","we worship","আমরা ইবাদত করি"],["وَإِيَّاكَ","wa-iyyāka","and You Alone","এবং আপনারই (কাছে  শুধু)"],["نَسْتَعِينُ","nasta‘īnu","we ask for help","আমরা সাহায্য চাই।"]],"t":"إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَ<p>عِي</>نُ"},{"n":6,"w":[["ٱهْدِنَا","ih'dinā","Guide us","আমাদেরকে দেখান"],["ٱلصِّرَٰطَ","l-ṣirāṭa","(to) the path","পথ"],["ٱلْمُسْتَقِيمَ","l-mus'taqīma","the straight","সরল সঠিক"]],"t":"ٱهْدِنَا <h>ٱ</><l>ل</>صِّ<m>رَٰ</>طَ <h>ٱ</>لْمُسْتَ<p>قِي</>مَ"},{"n":7,"w":[["صِرَٰطَ","ṣirāṭa","(The) path","(সেই) পথে"],["ٱلَّذِينَ","alladhīna","(of) those","যাদেরকে"],["أَنْعَمْتَ","an‘amta","You have bestowed (Your) Favors","আপনি অনুগ্রহ দান করেছেন"],["عَلَيْهِمْ","‘alayhim","on them","তাদের উপর"],["غَيْرِ","ghayri","not (of)","নয় (পথ)"],["ٱلْمَغْضُوبِ","l-maghḍūbi","those who earned (Your) wrath","অভিশপ্তদের"],["عَلَيْهِمْ","‘alayhim","on themselves","যাদের উপর (গজব পরেছে)"],["وَلَا","walā","and not","এবং না"],["ٱلضَّآلِّينَ","l-ḍālīna","(of) those who go astray","পথভ্রষ্টদের"]],"t":"صِ<m>رَٰ</>طَ <h>ٱ</>لَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ <h>ٱ</>لْمَغْضُوبِ عَلَيْهِمْ وَلَا <h>ٱ</><l>ل</><n>ضَّآ</><p>لِّي</>نَ"}]}