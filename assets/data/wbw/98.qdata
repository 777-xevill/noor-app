{"n":98,"a":[{"n":1,"w":[["لَمْ","lam","Not","না"],["يَكُنِ","yakuni","were","ছিল (প্রস্তুত)"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieved","কুফরি করেছে"],["مِنْ","min","from","মধ্য হতে"],["أَهْلِ","ahli","(the) People","অধিকারী"],["ٱلْكِتَـٰبِ","l-kitābi","of the Book","কিতাবের"],["وَٱلْمُشْرِكِينَ","wal-mush'rikīna","and the polytheists","এবং মুশরিকদের (মধ্য হতে)"],["مُنفَكِّينَ","munfakkīna","to be abandoned","(কুফরী হতে) বিরত"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["تَأْتِيَهُمُ","tatiyahumu","(there) comes to them","তাদের কাছে আসবে"],["ٱلْبَيِّنَةُ","l-bayinatu","the clear evidence","অকাট্য প্রমাণ (অর্থাৎ)"]],"t":"لَمْ يَكُنِ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> مِنْ أَهْلِ <h>ٱ</>لْكِ<m>تَٰ</>بِ وَ<h>ٱ</>لْمُشْرِكِينَ مُ<k>نفَ</>كِّينَ حَتَّىٰ تَأْتِيَهُمُ <h>ٱ</>لْبَيِّنَةُ"},{"n":2,"w":[["رَسُولٌۭ","rasūlun","A Messenger","একজন রাসূল"],["مِّنَ","mina","from","পক্ষ হতে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["يَتْلُوا۟","yatlū","reciting","যে আবৃত্তি করবে"],["صُحُفًۭا","ṣuḥufan","pages","সহীফাসমূহ"],["مُّطَهَّرَةًۭ","muṭahharatan","purified","পবিত্র"]],"t":"رَسُو<d>لٌۭ مِّ</>نَ <h>ٱ</>للَّهِ يَتْلُو<s>ا۟</> صُحُ<d>فًۭا مُّ</>طَهَّرَةًۭ"},{"n":3,"w":[["فِيهَا","fīhā","Wherein","তার মধ্যে (থাকবে)"],["كُتُبٌۭ","kutubun","(are) writings","বিধানাবলী"],["قَيِّمَةٌۭ","qayyimatun","correct","সঠিক"]],"t":"فِيهَا كُتُ<k>بٌۭ قَ</>يِّمَةٌۭ"},{"n":4,"w":[["وَمَا","wamā","And not","এবং না"],["تَفَرَّقَ","tafarraqa","became divided","বিভেদে লিপ্ত হয়েছে"],["ٱلَّذِينَ","alladhīna","those who","(তারা) যাদের"],["أُوتُوا۟","ūtū","were given","দেয়া হয়েছিল"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","কিতাব"],["إِلَّا","illā","until","তবে"],["مِنۢ","min","from","থেকে"],["بَعْدِ","ba‘di","after","পরে"],["مَا","mā","what","যা"],["جَآءَتْهُمُ","jāathumu","came (to) them","তাদের কাছে এসেছিল"],["ٱلْبَيِّنَةُ","l-bayinatu","(of) the clear evidence","সুস্পষ্ট প্রমাণ"]],"t":"وَمَا تَفَرَّقَ <h>ٱ</>لَّذِينَ أُوتُو<s>ا۟</> <h>ٱ</>لْكِ<m>تَٰ</>بَ إِلَّا <i>مِنۢ بَ</>عْدِ مَا <o>جَآ</>ءَتْهُمُ <h>ٱ</>لْبَيِّنَةُ"},{"n":5,"w":[["وَمَآ","wamā","And not","এবং না"],["أُمِرُوٓا۟","umirū","they were commanded","তারা আদিষ্ট হয়েছে"],["إِلَّا","illā","except","এ ছাড়া যে"],["لِيَعْبُدُوا۟","liya‘budū","to worship","তারা ইবাদত করুক"],["ٱللَّهَ","l-laha","Allah","আল্লাহর"],["مُخْلِصِينَ","mukh'liṣīna","(being) sincere","একনিষ্ঠভাবে"],["لَهُ","lahu","to Him","তাঁরই জন্যে"],["ٱلدِّينَ","l-dīna","(in) the religion","আনুগত্যকে"],["حُنَفَآءَ","ḥunafāa","upright","খাঁটি মনে"],["وَيُقِيمُوا۟","wayuqīmū","and to establish","এবং তারা কায়েম করবে"],["ٱلصَّلَوٰةَ","l-ṣalata","the prayer","সালাত"],["وَيُؤْتُوا۟","wayu'tū","and to give","ও তারা দেবে"],["ٱلزَّكَوٰةَ ۚ","l-zakata","the zakah","যাকাত"],["وَذَٰلِكَ","wadhālika","And that","এবং এটাই"],["دِينُ","dīnu","(is the) religion","দীন"],["ٱلْقَيِّمَةِ","l-qayimati","the correct","সঠিক"]],"t":"وَ<o>مَآ</> أُمِ<o>رُوٓ</><s>ا۟</> إِلَّا لِيَعْبُدُو<s>ا۟</> <h>ٱ</>للَّهَ مُخْلِصِينَ لَهُ <h>ٱ</><l>ل</>دِّينَ حُنَ<o>فَآ</>ءَ وَيُقِيمُو<s>ا۟</> <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةَ وَيُؤْتُو<s>ا۟</> <h>ٱ</><l>ل</>زَّكَ<s>وٰ</>ةَ ۚ وَ<m>ذَٰ</>لِكَ دِينُ <h>ٱ</>لْقَيِّمَةِ"},{"n":6,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieve","কুফরি করেছে"],["مِنْ","min","from","মধ্য হতে"],["أَهْلِ","ahli","(the) People","অধিকারী"],["ٱلْكِتَـٰبِ","l-kitābi","(of) the Book","কিতাবের"],["وَٱلْمُشْرِكِينَ","wal-mush'rikīna","and the polytheists","এবং মুশরিকদের"],["فِى","fī","(will be) in","মধ্যে (থাকবে)"],["نَارِ","nāri","(the) Fire","আগুনের"],["جَهَنَّمَ","jahannama","(of) Hell","জাহান্নামের"],["خَـٰلِدِينَ","khālidīna","abiding eternally","চিরস্থায়ী (হবে)"],["فِيهَآ ۚ","fīhā","therein","তার মধ্যে"],["أُو۟لَـٰٓئِكَ","ulāika","Those ","ঐসব লোক"],["هُمْ","hum","they","তারাই"],["شَرُّ","sharru","(are the) worst","অধম"],["ٱلْبَرِيَّةِ","l-bariyati","(of) the creatures","সৃষ্টির"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> مِنْ أَهْلِ <h>ٱ</>لْكِ<m>تَٰ</>بِ وَ<h>ٱ</>لْمُشْرِكِينَ فِى نَارِ جَهَ<g>نَّ</>مَ <m>خَٰ</>لِدِينَ فِي<o>هَآ ۚ</> أُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمْ شَرُّ <h>ٱ</>لْبَرِيَّةِ"},{"n":7,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["وَعَمِلُوا۟","wa‘amilū","and do","এবং করেছে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","righteous deeds","সৎকাজ"],["أُو۟لَـٰٓئِكَ","ulāika","those ","ঐসব লোক"],["هُمْ","hum","they","তারাই"],["خَيْرُ","khayru","(are the) best","সেরা"],["ٱلْبَرِيَّةِ","l-bariyati","(of) the creatures","সৃষ্টির"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ أُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمْ خَيْرُ <h>ٱ</>لْبَرِيَّةِ"},{"n":8,"w":[["جَزَآؤُهُمْ","jazāuhum","Their reward","তাদের পুরস্কার (রয়েছে)"],["عِندَ","‘inda","(is) with","কাছে"],["رَبِّهِمْ","rabbihim","their Lord ","তাদের রবের"],["جَنَّـٰتُ","jannātu","Gardens","জান্নাত"],["عَدْنٍۢ","‘adnin","(of) Eternity","চিরস্থায়ী"],["تَجْرِى","tajrī","flow","প্রবাহিত হয়"],["مِن","min","from","দিয়ে"],["تَحْتِهَا","taḥtihā","underneath them","তার তলদেশ"],["ٱلْأَنْهَـٰرُ","l-anhāru","the rivers","ঝর্ণা ধারা"],["خَـٰلِدِينَ","khālidīna","will abide","চিরস্থায়ী হবে"],["فِيهَآ","fīhā","therein","তার মধ্যে"],["أَبَدًۭا ۖ","abadan","forever","সর্বদা"],["رَّضِىَ","raḍiya","(will be) pleased","সন্তুষ্ট হয়েছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ্‌"],["عَنْهُمْ","‘anhum","with them","তাদের প্রতি"],["وَرَضُوا۟","waraḍū","and they (will be) pleased","এবং তারা সন্তুষ্ট হয়েছে"],["عَنْهُ ۚ","‘anhu","with Him","তাঁর প্রতি"],["ذَٰلِكَ","dhālika","That","এটা"],["لِمَنْ","liman","(is) for whoever","তাঁর জন্যে যে"],["خَشِىَ","khashiya","feared","ভয় করে"],["رَبَّهُۥ","rabbahu","his Lord","তার রবকে"]],"t":"جَ<o>زَآ</>ؤُهُمْ عِ<k>ندَ</> رَبِّهِمْ جَ<g>نَّٰ</>تُ عَ<q>دْ</><k>نٍۢ تَ</><q>جْ</>رِى مِ<k>ن تَ</>حْتِهَا <h>ٱ</>لْأَنْ<m>هَٰ</>رُ <m>خَٰ</>لِدِينَ فِي<o>هَآ</> أَبَ<w>دًۭا ۖ رَّ</>ضِىَ <h>ٱ</>للَّهُ عَنْهُمْ وَرَ