{"n":73,"a":[{"n":1,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you","হে"],["ٱلْمُزَّمِّلُ","l-muzamilu","who wraps himself","বস্ত্রাবৃত"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لْمُزَّ<g>مِّ</>لُ"},{"n":2,"w":[["قُمِ","qumi","Stand","উঠো"],["ٱلَّيْلَ","al-layla","(in) the night","রাতে (ইবাদত করো)"],["إِلَّا","illā","except","ব্যতীত"],["قَلِيلًۭا","qalīlan","a little","কিছু অংশ"]],"t":"قُمِ <h>ٱ</>لَّيْلَ إِلَّا قَلِيلًۭا"},{"n":3,"w":[["نِّصْفَهُۥٓ","niṣ'fahu","Half of it","তার অর্ধেক"],["أَوِ","awi","or","বা"],["ٱنقُصْ","unquṣ","lessen","কম করো"],["مِنْهُ","min'hu","from it","তা থেকে"],["قَلِيلًا","qalīlan","a little","সামান্য"]],"t":"نِّصْفَهُ<o>ۥٓ</> أَوِ <h>ٱ</><k>نقُ</>صْ مِنْهُ قَلِيلًا"},{"n":4,"w":[["أَوْ","aw","Or","অথবা"],["زِدْ","zid","add","বাড়াও"],["عَلَيْهِ","‘alayhi","to it","তার উপর"],["وَرَتِّلِ","warattili","and recite","এবং আবৃতি করো ধীরে ধীরে"],["ٱلْقُرْءَانَ","l-qur'āna","the Quran","কুরআন"],["تَرْتِيلًا","tartīlan","(with) measured rhythmic recitation","তারতিলসহ"]],"t":"أَوْ زِ<q>دْ</> عَلَيْهِ وَرَتِّلِ <h>ٱ</>لْقُرْءَانَ تَرْتِيلًا"},{"n":5,"w":[["إِنَّا","innā","Indeed, We","আমরা নিশ্চয়"],["سَنُلْقِى","sanul'qī","will cast","অর্পণ আমরা শিঘ্রই করবো"],["عَلَيْكَ","‘alayka","upon you","তোমার উপর"],["قَوْلًۭا","qawlan","a Word","বাণী"],["ثَقِيلًا","thaqīlan","heavy","ভারী"]],"t":"إِ<g>نَّ</>ا سَنُلْقِى عَلَيْكَ قَوْلًۭ<k>ا ثَ</>قِيلًا"},{"n":6,"w":[["إِنَّ","inna","Indeed","নিশ্চয়"],["نَاشِئَةَ","nāshi-ata","(the) rising","উথান (শয্যা ত্যাগ)"],["ٱلَّيْلِ","al-layli","(at) the night","রাত্রি কালের"],["هِىَ","hiya","it","তা"],["أَشَدُّ","ashaddu","(is) very hard","প্রবলতর"],["وَطْـًۭٔا","waṭan","and most potent","দলনে (প্রবৃত্তি)"],["وَأَقْوَمُ","wa-aqwamu","and more suitable","এবং সঠিকতর"],["قِيلًا","qīlan","(for) Word","বাক্য স্ফুরণে"]],"t":"إِ<g>نَّ</> نَاشِئَةَ <h>ٱ</>لَّيْلِ هِىَ أَشَدُّ وَ<q>طْـًۭٔ</><d>ا وَ</>أَ<q>قْ</>وَمُ قِيلًا"},{"n":7,"w":[["إِنَّ","inna","Indeed","নিশ্চয়"],["لَكَ","laka","for you","তোমার জন্যে"],["فِى","fī","in","মধ্যে"],["ٱلنَّهَا