","stand","(ইবাদতে) দাঁড়াও"],["أَدْنَىٰ","adnā","(a little) less","প্রায়"],["مِن","min","than","মধ্য হতে"],["ثُلُثَىِ","thuluthayi","two-thirds","দুই তৃিতীয়াংশ"],["ٱلَّيْلِ","al-layli","(of) the night","রাতের"],["وَنِصْفَهُۥ","waniṣ'fahu","and half of it","এবং তার অর্ধেক"],["وَثُلُثَهُۥ","wathuluthahu","and a third of it","এবং এক তৃিতীয়াংশ"],["وَطَآئِفَةٌۭ","waṭāifatun","and (so do) a group","এবং একদল"],["مِّنَ","mina","of","থেকে"],["ٱلَّذِينَ","alladhīna","those who","যারা (তাদের)"],["مَعَكَ ۚ","ma‘aka","(are) with you","তোমার সাথে"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহই"],["يُقَدِّرُ","yuqaddiru","determines","নির্ধারণ করেন"],["ٱلَّيْلَ","al-layla","the night","রাত কে"],["وَٱلنَّهَارَ ۚ","wal-nahāra","and the day","ও দিনকে"],["عَلِمَ","‘alima","He knows","তিনি জেনেছেন"],["أَن","an","that","যে"],["لَّن","lan","not","পারবে না"],["تُحْصُوهُ","tuḥ'ṣūhu","you count it","তা হিসাব রাখতে"],["فَتَابَ","fatāba","so He has turned","তিনি মাফ অতএব করলেন"],["عَلَيْكُمْ ۖ","‘alaykum","to you","তোমাদেরকে"],["فَٱقْرَءُوا۟","fa-iq'raū","so recite","তোমরা পর অতএব"],["مَا","mā","what","যা"],["تَيَسَّرَ","tayassara","is easy","সহজসাধ্য হয়"],["مِنَ","mina","of","থেকে"],["ٱلْقُرْءَانِ ۚ","l-qur'āni","the Quran","কুরআন"],["عَلِمَ","‘alima","He knows","তিনি জেনেছেন"],["أَن","an","that","যে"],["سَيَكُونُ","sayakūnu","there will be","হবে"],["مِنكُم","minkum","among you","তোমাদের মধ্যে (বিতর্ক)"],["مَّرْضَىٰ ۙ","marḍā","sick","রোগী"],["وَءَاخَرُونَ","waākharūna","and others","এবং অন্য অনেকে"],["يَضْرِبُونَ","yaḍribūna","traveling","ভ্রমণ করবে"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the land","পৃথিবীর"],["يَبْتَغُونَ","yabtaghūna","seeking","অনুসন্ধান করবে"],["مِن","min","of","থেকে"],["فَضْلِ","faḍli","(the) Bounty","অনুগ্র্রহ"],["ٱللَّهِ ۙ","l-lahi","(of) Allah","আল্লাহ্‌র"],["وَءَاخَرُونَ","waākharūna","and others","এবং অন্য অনেকে"],["يُقَـٰتِلُونَ","yuqātilūna","fighting","যুদ্ধ করবে"],["فِى","fī","in","মধ্যে"],["سَبِيلِ","sabīli","(the) way","পথে"],["ٱللَّهِ ۖ","l-lahi","(of) Allah","আল্লাহ্‌‌র"],["فَٱقْرَءُوا۟","fa-iq'raū","So recite","তোমরা পর সুতরাং"],["مَا","mā","what","যা"],["تَيَسَّرَ","tayassara","is easy","সহজ হয়"],["مِنْهُ ۚ","min'hu","of it","তা থেকে"],["وَأَقِيمُوا۟","wa-aqīmū","and establish","এবং তোমরা কায়েম করো"],["ٱلصَّلَوٰةَ","l-ṣalata","the prayer","নামায"],["وَءَاتُوا۟","waātū","and give","এবং তোমরা দাও"],["ٱلزَّكَوٰةَ","l-zakata","the zakah","যাকাত"],["وَأَقْرِضُوا۟","wa-aqriḍū","and loan","এবং তোমরা কর্জ দাও"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌কে"],["قَرْضًا","qarḍan","a loan","কর্জ"],["حَسَنًۭا ۚ","ḥasanan","goodly","উত্তম"],["وَمَا","wamā","And whatever","এবং যা"],["تُقَدِّمُوا۟","tuqaddimū","you send forth","তোমরা আগে পাঠাবে"],["لِأَنفُسِكُم","li-anfusikum","for yourselves","তোমাদের নিজেদের জন্যে"],["مِّنْ","min","of","থেকে"],["خَيْرٍۢ","khayrin","good","ভালো"],["تَجِدُوهُ","tajidūhu","you will find it","তা তোমরা পাবে"],["عِندَ","‘inda","with","কাছে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌র"],["هُوَ","huwa","It","তাই"],["خَيْرًۭا","khayran","(will be) better","উত্তম"],["وَأَعْظَمَ","wa-a‘ẓama","and greater","এবং অতীব উত্তম"],["أَجْرًۭا ۚ","ajran","(in) reward","প্রতিফল"],["وَٱسْتَغْفِرُوا۟","wa-is'taghfirū","And seek forgiveness","এবং তোমরা ক্ষমা চাও"],["ٱللَّهَ ۖ","l-laha","(of) Allah","আল্লাহ্‌র কাছে"],["إِنَّ","inna","Indeed","নিশ্চয়"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌"],["غَفُورٌۭ","ghafūrun","(is) Oft-Forgiving","বড় ক্ষমাশীল"],["رَّحِيمٌۢ","raḥīmun","Most Merciful","অত্যন্ত মেহেরবান"]],"t":"۞ إِ<g>نَّ</> رَبَّكَ يَعْلَمُ أَ<g>نَّ</>كَ تَقُومُ أَ<q>دْ</>نَىٰ مِ<k>ن ثُ</>لُثَىِ <h>ٱ</>لَّيْلِ وَنِصْفَهُ<m>ۥ</> وَثُلُثَهُ<m>ۥ</> وَ<o>طَآ</>ئِفَ<d>ةٌۭ مِّ</>نَ <h>ٱ</>لَّذِينَ مَعَكَ ۚ وَ<h>ٱ</>للَّهُ يُقَدِّرُ <h>ٱ</>لَّيْلَ وَ<h>ٱ</><l>ل</><g>نَّ</>هَارَ ۚ عَلِمَ <w>أَن لَّ</><k>ن تُ</>حْصُوهُ فَتَابَ عَلَيْكُمْ ۖ فَ<h>ٱ</><q>قْ</>رَءُو<s>ا۟</> مَا تَيَسَّرَ مِنَ <h>ٱ</>لْقُرْءَانِ ۚ عَلِمَ أَ<k>ن سَ</>يَكُونُ مِ<k>نكُ</><y>م مَّ</>رْضَىٰ ۙ وَءَاخَرُونَ يَضْرِبُونَ فِى <h>ٱ</>لْأَرْضِ يَ<q>بْ</>