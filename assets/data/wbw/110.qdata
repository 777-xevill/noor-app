{"n":110,"a":[{"n":1,"w":[["إِذَا","idhā","When","যখন"],["جَآءَ","jāa","comes","আসবে"],["نَصْرُ","naṣru","(the) Help","সাহায্য"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَٱلْفَتْحُ","wal-fatḥu","and the Victory","ও বিজয়"]],"t":"إِذَا <o>جَآ</>ءَ نَصْرُ <h>ٱ</>للَّهِ وَ<h>ٱ</>لْفَتْحُ"},{"n":2,"w":[["وَرَأَيْتَ","wara-ayta","And you see","এবং তুমি দেখবে"],["ٱلنَّاسَ","l-nāsa","the people","মানুষকে"],["يَدْخُلُونَ","yadkhulūna","entering","প্রবেশ করছে"],["فِى","fī","into","মধ্যে"],["دِينِ","dīni","(the) religion","দীনের"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["أَفْوَاجًۭا","afwājan","(in) multitudes","দলে দলে"]],"t":"وَرَأَيْتَ <h>ٱ</><l>ل</><g>نَّ</>اسَ يَ<q>دْ</>خُلُونَ فِى دِينِ <h>ٱ</>للَّهِ أَفْوَاجًۭا"},{"n":3,"w":[["فَسَبِّحْ","fasabbiḥ","Then glorify","তখন তুমি গুণগান করবে"],["بِحَمْدِ","biḥamdi","with (the) praises","প্রশংসার সাথে"],["رَبِّكَ","rabbika","(of) your Lord","তোমার রবের"],["وَٱسْتَغْفِرْهُ ۚ","wa-is'taghfir'hu","and ask His forgiveness","এবং তাঁর (নিকট) ক্ষমা চাও"],["إِنَّهُۥ","innahu","Indeed, He","নিশ্চয়ই"],["كَانَ","kāna","is","হলেন"],["تَوَّابًۢا","tawwāban","Oft-Returning","ক্ষমাপরবশ"]],"t":"فَسَبِّحْ بِحَمْدِ رَبِّكَ وَ<h>ٱ</>سْتَغْفِرْهُ ۚ إِ<g>نَّ</>هُ<m>ۥ</> كَانَ تَوَّابًۢا"}]}