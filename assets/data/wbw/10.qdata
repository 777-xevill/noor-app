{"n":10,"a":[{"n":1,"w":[["الٓر ۚ","alif-lam-ra","Alif Lam Ra","আলিফ- লাম- রা"],["تِلْكَ","til'ka","These","এই"],["ءَايَـٰتُ","āyātu","(are the) verses","এই আয়াতগুলো"],["ٱلْكِتَـٰبِ","l-kitābi","(of) the Book","(এমন) কিতাবের"],["ٱلْحَكِيمِ","l-ḥakīmi","the wise","(যা)প্রজ্ঞাপূর্ণ"]],"t":"ا<n>لٓ</>ر ۚ تِلْكَ ءَا<m>يَٰ</>تُ <h>ٱ</>لْكِ<m>تَٰ</>بِ <h>ٱ</>لْحَ<p>كِي</>مِ"},{"n":2,"w":[["أَكَانَ","akāna","Is it","কি হয়েছে"],["لِلنَّاسِ","lilnnāsi","for the mankind","জন্যে মানুষের"],["عَجَبًا","‘ajaban","a wonder","আশ্চর্যজনক"],["أَنْ","an","that","যে"],["أَوْحَيْنَآ","awḥaynā","We revealed","আমরা ওহী পাঠিয়েছি"],["إِلَىٰ","ilā","to","প্রতি"],["رَجُلٍۢ","rajulin","a man","একজন ব্যক্তির"],["مِّنْهُمْ","min'hum","from (among) them","মধ্য হতে তাদেরই"],["أَنْ","an","that","যে"],["أَنذِرِ","andhiri","Warn","\"সতর্ক করো"],["ٱلنَّاسَ","l-nāsa","the mankind","মানুষকে"],["وَبَشِّرِ","wabashiri","and give glad tidings","ও সুসংবাদ দাও"],["ٱلَّذِينَ","alladhīna","(to) those who","(তাদেরকে) যারা"],["ءَامَنُوٓا۟","āmanū","believe","ঈমান এনেছে"],["أَنَّ","anna","that","যে"],["لَهُمْ","lahum","for them","জন্যে তাদের (রয়েছে)"],["قَدَمَ","qadama","(will be) a respectable position","পদ (মর্যাদা)"],["صِدْقٍ","ṣid'qin","(will be) a respectable position","সত্যিকার"],["عِندَ","‘inda","near","কাছে"],["رَبِّهِمْ ۗ","rabbihim","their Lord","রবের তাদের\""],["قَالَ","qāla","Said","(এ কথাই) বলেছে"],["ٱلْكَـٰفِرُونَ","l-kāfirūna","the disbelievers","কাফিররা"],["إِنَّ","inna","Indeed","\"নিশ্চয়ই"],["هَـٰذَا","hādhā","this","এই (ব্যক্তি)"],["لَسَـٰحِرٌۭ","lasāḥirun","(is) surely a magician","অবশ্যই জাদুকর"],["مُّبِينٌ","mubīnun","obvious","সুস্পষ্ট\""]],"t":"أَكَانَ لِل<g>نَّ</>اسِ عَجَبًا أَنْ أَوْحَيْ<o>نَآ</> إِلَىٰ رَجُ<d>لٍۢ مِّ</>نْهُمْ أَنْ أَ<k>نذِ</>رِ <h>ٱ</><l>ل</><g>نَّ</>اسَ وَبَشِّرِ <h>ٱ</>لَّذِينَ ءَامَ<o>نُوٓ</><s>ا۟</> أَ<g>نَّ</> لَهُمْ قَدَمَ صِ<q>دْ</>قٍ عِ<k>ندَ</> رَبِّهِمْ ۗ قَالَ <h>ٱ</>لْ<m>كَٰ</>فِرُونَ إِ<g>نَّ</> <m>هَٰ</>ذَا لَ<m>سَٰ</>حِ<d>رٌۭ مُّ</><p>بِي</>نٌ"},{"n":3,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["رَبَّكُمُ","rabbakumu","your Lord","রব তোমাদের"],["ٱللَّهُ","l-lahu","(is) Allah","(সেই) আল্লাহ"],["ٱلَّذِى","alladhī","the One Who","যিনি"],["خَلَقَ","khalaqa","created","সৃষ্টি করেছেন"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশসমূহকে"],["وَٱلْأَرْضَ","wal-arḍa","and the earth","ও পৃথিবীকে"],["فِى","fī","in","মধ্যে"],["سِتَّةِ","sittati","six","ছয়টি"],["أَيَّامٍۢ","ayyāmin","periods","দিনে"],["ثُمَّ","thumma","then","এরপর"],["ٱسْتَوَىٰ","is'tawā","He established","সমাসীন হয়েছেন"],["عَلَى","‘alā","on","উপর"],["ٱلْعَرْشِ ۖ","l-‘arshi","the Throne","আরশের"],["يُدَبِّرُ","yudabbiru","disposing","পরিচালনা করেন"],["ٱلْأَمْرَ ۖ","l-amra","the affairs","সকল (বিষয়)"],["مَا","mā","Not","নেই"],["مِن","min","(is) any intercessor","কোনো"],["شَفِيعٍ","shafī‘in","(is) any intercessor","সুপারিশকারী"],["إِلَّا","illā","except","তবে (কেউ সুপারিশ করলে)"],["مِنۢ","min","after","থেকে"],["بَعْدِ","ba‘di","after","পর"],["إِذْنِهِۦ ۚ","idh'nihi","His permission","তাঁর অনুমতির (সেটা অন্য কথা)"],["ذَٰلِكُمُ","dhālikumu","That","তিনিই"],["ٱللَّهُ","l-lahu","(is) Allah","আল্লাহ্‌"],["رَبُّكُمْ","rabbukum","your Lord","তোমাদের রব"],["فَٱعْبُدُوهُ ۚ","fa-u‘'budūhu","so worship Him","অতএব তাঁরই ইবাদত করো তোমরা"],["أَفَلَا","afalā","Then will not","কি তবুও  না"],["تَذَكَّرُونَ","tadhakkarūna","you remember","তোমরা শিক্ষা গ্রহণ করবে"]],"t":"إِ<g>نَّ</> رَبَّكُمُ <h>ٱ</>للَّهُ <h>ٱ</>لَّذِى خَلَقَ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضَ فِى سِتَّةِ أَيَّا<k>مٍۢ ثُ</><g>مَّ</> <h>ٱ</>سْتَوَىٰ عَلَى <h>ٱ</>لْعَرْشِ ۖ يُدَبِّرُ <h>ٱ</>لْأَمْرَ ۖ مَا مِ<k>ن شَ</>فِيعٍ إِلَّا <i>مِنۢ بَ</>عْدِ إِذْنِ<m>هِۦ</> ۚ <m>ذَٰ</>لِكُمُ <h>ٱ</>للَّهُ رَبُّكُمْ فَ<h>ٱ</>عْبُدُوهُ ۚ أَفَلَا تَذَكَّ<p>رُو</>نَ"},{"n":4,"w":[["إِلَيْهِ","ilayhi","To Him","দিকে তাঁরই"],["مَرْجِعُكُمْ","marji‘ukum","(will be) your return","তোমাদের প্রত্যাবর্তন"],["جَمِيعًۭا ۖ","jamī‘an","[all]","সকলেরই"],["وَعْدَ","wa‘da","Promise","(এটা)প্রতিশ্রুতি"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["حَقًّا ۚ","ḥaqqan","(is) true","সত্য"],["إِنَّهُۥ","innahu","Indeed, He","নিশ্চয়ই তিনি"],["يَبْدَؤُا۟","yabda-u","originates","প্রথম অস্তিত্বে আনেন"],["ٱلْخَلْقَ","l-khalqa","the creation","সৃষ্টিকে"],["ثُمَّ","thumma","then","অতঃপর"],["يُعِيدُهُۥ","yu‘īduhu","He repeats it","পুনরাবর্তন করবেন তার"],["لِيَجْزِىَ","liyajziya","that He may reward","যেন তিনি প্রতিফল দিতে পারেন"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["ءَامَنُوا۟","āmanū","believed","ঈমান এনেছে"],["وَعَمِلُوا۟","wa‘amilū","and did","ও কাজ করেছে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","the good deeds","সৎ"],["بِٱلْقِسْطِ ۚ","bil-qis'ṭi","in justice","সাথে ন্যায় বিচারের"],["وَٱلَّذِينَ","wa-alladhīna","But those who","ও যারা"],["كَفَرُوا۟","kafarū","disbelieved","অস্বীকার করেছে"],["لَهُمْ","lahum","for them","জন্যে তাদের (হবে)"],["شَرَابٌۭ","sharābun","(will be) a drink","পানীয়"],["مِّنْ","min","of","হতে"],["حَمِيمٍۢ","ḥamīmin","boiling fluids","ফুটন্ত পানি"],["وَعَذَابٌ","wa‘adhābun","and a punishment","ও শাস্তি"],["أَلِيمٌۢ","alīmun","painful","নিদারুণ"],["بِمَا","bimā","because","এ কারণে যা"],["كَانُوا۟","kānū","they used (to)","তারা ছিলো"],["يَكْفُرُونَ","yakfurūna","disbelieve","তারা অস্বীকার করতে"]],"t":"إِلَيْهِ مَرْجِعُكُمْ جَمِي<d>عًۭا ۖ وَ</>عْدَ <h>ٱ</>للَّهِ حَقًّا ۚ إِ<g>نَّ</>هُ<m>ۥ</> يَ<q>بْ</>دَؤُ<s>ا۟</> <h>ٱ</>لْخَلْقَ ثُ<g>مَّ</> يُعِيدُهُ<m>ۥ</> لِيَ<q>جْ</>زِىَ <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ بِ<h>ٱ</>لْقِسْطِ ۚ وَ<h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> لَهُمْ شَرَا<d>بٌۭ مِّ</>نْ حَمِي<d>مٍۢ وَ</>عَذَابٌ أَلِي<i>مٌۢ بِ</>مَا كَانُو<s>ا۟</> يَكْفُ<p>رُو</>نَ"},{"n":5,"w":[["هُوَ","huwa","He","তিনিই (আল্লাহ)"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["جَعَلَ","ja‘ala","made","বানিয়েছেন"],["ٱلشَّمْسَ","l-shamsa","the sun","সূর্যকে"],["ضِيَآءًۭ","ḍiyāan","a shining light","দীপ্তিময়"],["وَٱلْقَمَرَ","wal-qamara","and the moon","ও চাঁদকে"],["نُورًۭا","nūran","a reflected light","আলোকময়"],["وَقَدَّرَهُۥ","waqaddarahu","and determined for it","ও তার জন্যে নির্দিষ্ট করেছেন"],["مَنَازِلَ","manāzila","phases","(হ্রাস-বৃদ্ধির)কক্ষপথ"],["لِتَعْلَمُوا۟","lita‘lamū","that you may know","যেন তোমরা জানো"],["عَدَدَ","‘adada","(the) number","গণনা"],["ٱلسِّنِينَ","l-sinīna","(of) the years","বছরগুলোর"],["وَٱلْحِسَابَ ۚ","wal-ḥisāba","and the count (of time)","ও (তারিখের) হিসাব"],["مَا","mā","Not","নেই"],["خَلَقَ","khalaqa","created","সৃষ্টি করেছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ্‌"],["ذَٰلِكَ","dhālika","that","এসব"],["إِلَّا","illā","except","ছাড়া"],["بِٱلْحَقِّ ۚ","bil-ḥaqi","in truth","ভাবে যথাযথ (উদ্দেশ্যে)"],["يُفَصِّلُ","yufaṣṣilu","He explains","বিশদ বিবৃত করেন তিনি"],["ٱلْـَٔايَـٰتِ","l-āyāti","the Signs","নিদর্শনগুলোকে"],["لِقَوْمٍۢ","liqawmin","for a people","জন্যে সম্প্রদায়ের"],["يَعْلَمُونَ","ya‘lamūna","(who) know","যারা জানে"]],"t":"هُوَ <h>ٱ</>لَّذِى جَعَلَ <h>ٱ</><l>ل</>شَّمْسَ ضِ<o>يَآ</><d>ءًۭ وَ</><h>ٱ</>لْقَمَرَ نُو<d>رًۭا وَ</>قَدَّرَهُ<m>ۥ</> مَنَازِلَ لِتَعْلَمُو<s>ا۟</> عَدَدَ <h>ٱ</><l>ل</>سِّنِينَ وَ<h>ٱ</>لْحِسَابَ ۚ مَا خَلَقَ <h>ٱ</>للَّهُ <m>ذَٰ</>لِكَ إِلَّا بِ<h>ٱ</>لْحَقِّ ۚ يُفَصِّلُ <h>ٱ</>لْءَا<m>يَٰ</>تِ لِقَوْ<d>مٍۢ يَ</>عْلَ<p>مُو</>نَ"},{"n":6,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে (রয়েছে)"],["ٱخْتِلَـٰفِ","ikh'tilāfi","(the) alternation","পরিবর্তনে"],["ٱلَّيْلِ","al-layli","(of) the night","রাতের"],["وَٱلنَّهَارِ","wal-nahāri","and the day","ও দিনের"],["وَمَا","wamā","and what","ও যা কিছু"],["خَلَقَ","khalaqa","(has been) created","সৃষ্টি করেছেন"],["ٱللَّهُ","l-lahu","(by) Allah","আল্লাহ্‌"],["فِى","fī","in","মধ্যে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশসমূহের"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীর"],["لَـَٔايَـٰتٍۢ","laāyātin","(are) Signs","অবশ্যই নিদর্শনসমূহ"],["لِّقَوْمٍۢ","liqawmin","for a people","জন্যে সম্প্রদায়ের"],["يَتَّقُونَ","yattaqūna","who are God conscious","যারা তাকওয়া অবলম্বন করে"]],"t":"إِ<g>نَّ</> فِى <h>ٱ</>خْتِ<m>لَٰ</>فِ <h>ٱ</>لَّيْلِ وَ<h>ٱ</><l>ل</><g>نَّ</>هَارِ وَمَا خَلَقَ <h>ٱ</>للَّهُ فِى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ لَءَا<m>يَٰ</><w>تٍۢ لِّ</>قَوْ<d>مٍۢ يَ</>تَّ<p>قُو</>نَ"},{"n":7,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["لَا","lā","(do) not","না"],["يَرْجُونَ","yarjūna","expect","আশা রাখে"],["لِقَآءَنَا","liqāanā","the meeting with Us","সাক্ষাতের আমাদের"],["وَرَضُوا۟","waraḍū","and are pleased","ও পরিতৃপ্ত হয়েছে"],["بِٱلْحَيَوٰةِ","bil-ḥayati","with the life","নিয়ে জীবন"],["ٱلدُّنْيَا","l-dun'yā","(of) the world","পার্থিব"],["وَٱطْمَأَنُّوا۟","wa-iṭ'ma-annū","and feel satisfied","এবং নিশ্চিত থাকে"],["بِهَا","bihā","with it","নিয়ে তা"],["وَٱلَّذِينَ","wa-alladhīna","and those ","এবং (এমন) যারা"],["هُمْ","hum","they","তারাই"],["عَنْ","‘an","(are) of","হতে"],["ءَايَـٰتِنَا","āyātinā","Our Signs","নিদর্শনগুলো আমাদের"],["غَـٰفِلُونَ","ghāfilūna","heedless","উদাসীন"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ لَا يَرْجُونَ لِ<o>قَآ</>ءَنَا وَرَضُو<s>ا۟</> بِ<h>ٱ</>لْحَيَ<s>وٰ</>ةِ <h>ٱ</><l>ل</>دُّنْيَا وَ<h>ٱ</><q>طْ</>مَأَ<g>نُّ</>و<s>ا۟</> بِهَا وَ<h>ٱ</>لَّذِينَ هُمْ عَنْ ءَا<m>يَٰ</>تِنَا <m>غَٰ</>فِ<p>لُو</>نَ"},{"n":8,"w":[["أُو۟لَـٰٓئِكَ","ulāika","Those ","ঐসব লোক"],["مَأْوَىٰهُمُ","mawāhumu","their abode","তাদের বাসস্থান (হবে)"],["ٱلنَّارُ","l-nāru","(will be) the Fire","আগুন"],["بِمَا","bimā","for what","এ কারণে যা"],["كَانُوا۟","kānū","they used (to)","তারা ছিলো"],["يَكْسِبُونَ","yaksibūna","earn","তারা অর্জন করতে"]],"t":"أُ<s>و۟</><o>لَٰٓ</>ئِكَ مَأْوَ<m>ىٰ</>هُمُ <h>ٱ</><l>ل</><g>نَّ</>ارُ بِمَا كَانُو<s>ا۟</> يَكْسِ<p>بُو</>نَ"},{"n":9,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ءَامَنُوا۟","āmanū","believed","ঈমান এনেছে"],["وَعَمِلُوا۟","wa‘amilū","and did","ও কাজ করেছে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","good deeds","সৎ"],["يَهْدِيهِمْ","yahdīhim","(will) guide them","সৎপথে পরিচালিত করবেন তাদেরকে"],["رَبُّهُم","rabbuhum","their Lord","রব তাদের"],["بِإِيمَـٰنِهِمْ ۖ","biīmānihim","by their faith","কারনে ঈমানের তাদের"],["تَجْرِى","tajrī","Will flow","প্রবাহিত হয়"],["مِن","min","from","দিয়ে"],["تَحْتِهِمُ","taḥtihimu","underneath them","নিচ তাদের"],["ٱلْأَنْهَـٰرُ","l-anhāru","the rivers","ঝর্ণাধারাসমূহ"],["فِى","fī","in","মধ্যে"],["جَنَّـٰتِ","jannāti","Gardens","জান্নাতের"],["ٱلنَّعِيمِ","l-na‘īmi","(of) Delight","সুখকর"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ يَهْدِيهِمْ رَبُّ<f>هُم بِ</>إِي<m>مَٰ</>نِهِمْ ۖ تَ<q>جْ</>رِى مِ<k>ن تَ</>حْتِهِمُ <h>ٱ</>لْأَنْ<m>هَٰ</>رُ فِى جَ<g>نَّٰ</>تِ <h>ٱ</><l>ل</><g>نَّ</><p>عِي</>مِ"},{"n":10,"w":[["دَعْوَىٰهُمْ","da‘wāhum","Their prayer","তাদের ধ্বনি (হবে)"],["فِيهَا","fīhā","therein","মধ্যে তার"],["سُبْحَـٰنَكَ","sub'ḥānaka","(will be), \"Glory be to You","পবিত্র তুমি"],["ٱللَّهُمَّ","l-lahuma","O Allah","হে আল্লাহ\""],["وَتَحِيَّتُهُمْ","wataḥiyyatuhum","And their greeting","ও তাদের অভিবাদন (হবে)"],["فِيهَا","fīhā","therein (will be)","মধ্যে তার"],["سَلَـٰمٌۭ ۚ","salāmun","Peace","\"সালাম (বর্ষিত হোক)\""],["وَءَاخِرُ","waākhiru","And the last","এবং শেষ (হবে)"],["دَعْوَىٰهُمْ","da‘wāhum","(of) their call","ধ্বনি তাদের"],["أَنِ","ani","(will be) [that]","এই (যে)"],["ٱلْحَمْدُ","l-ḥamdu","All the Praise be","\"সব প্রশংসা"],["لِلَّهِ","lillahi","to Allah","জন্যে আল্লাহরই"],["رَبِّ","rabbi","Lord","রব"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","(of) the worlds","বিশ্বজগতের\""]],"t":"دَعْوَ<m>ىٰ</>هُمْ فِيهَا سُ<q>بْ</><m>حَٰ</>نَكَ <h>ٱ</><l>ل</>لَّهُ<g>مَّ</> وَتَحِيَّتُهُمْ فِيهَا سَ<m>لَٰ</><d>مٌۭ ۚ وَ</>ءَاخِرُ دَعْوَ<m>ىٰ</>هُمْ أَنِ <h>ٱ</>لْحَمْدُ لِلَّهِ رَبِّ <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":11,"w":[["۞ وَلَوْ","walaw","And if","এবং যদি"],["يُعَجِّلُ","yu‘ajjilu","hastens","তাড়াতাড়ি করতেন"],["ٱللَّهُ","l-lahu","(by) Allah","আল্লাহ"],["لِلنَّاسِ","lilnnāsi","for the mankind","জন্যে মানুষের"],["ٱلشَّرَّ","l-shara","the evil","অকল্যাণ"],["ٱسْتِعْجَالَهُم","is'ti‘'jālahum","(as) He hastens for them","(যেমন) তারা তাড়াতাড়ি চায়"],["بِٱلْخَيْرِ","bil-khayri","the good","ব্যাপারে (দুনিয়ার) কল্যাণের"],["لَقُضِىَ","laquḍiya","surely, would have been decreed","অবশ্যই পুরা হয়ে যেতো"],["إِلَيْهِمْ","ilayhim","for them","প্রতি তাদের"],["أَجَلُهُمْ ۖ","ajaluhum","their term","মেয়াদ তাদের"],["فَنَذَرُ","fanadharu","But We leave","অতএব আমরা ছেড়ে দিয়েছি"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["لَا","lā","(do) not","না"],["يَرْجُونَ","yarjūna","expect","আশা রাখে"],["لِقَآءَنَا","liqāanā","the meeting with Us","সাক্ষাতের আমাদের"],["فِى","fī","in","মধ্যে"],["طُغْيَـٰنِهِمْ","ṭugh'yānihim","their transgression","অবাধ্যতার তাদের"],["يَعْمَهُونَ","ya‘mahūna","wandering blindly","উদ্‌ভ্রান্ত হয়ে ঘুরে বেড়ায়"]],"t":"۞ وَلَوْ يُعَجِّلُ <h>ٱ</>للَّهُ لِل<g>نَّ</>اسِ <h>ٱ</><l>ل</>شَّرَّ <h>ٱ</>سْتِعْجَالَ<f>هُم بِ</><h>ٱ</>لْخَيْرِ لَقُضِىَ إِلَيْهِمْ أَجَلُهُمْ ۖ فَنَذَرُ <h>ٱ</>لَّذِينَ لَا يَرْجُونَ لِ<o>قَآ</>ءَنَا فِى طُغْ<m>يَٰ</>نِهِمْ يَعْمَ<p>هُو</>نَ"},{"n":12,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["مَسَّ","massa","touches","স্পর্শ করে"],["ٱلْإِنسَـٰنَ","l-insāna","the man","মানুষকে"],["ٱلضُّرُّ","l-ḍuru","the affliction","দুঃখ-দৈন্য (দিয়ে)"],["دَعَانَا","da‘ānā","he calls Us","(তখন) ডাকে আমাদেরকে"],["لِجَنۢبِهِۦٓ","lijanbihi","(lying) on his side","উপর পাশের তার (অর্থাৎ শুয়ে)"],["أَوْ","aw","or","বা"],["قَاعِدًا","qā‘idan","sitting","বসে"],["أَوْ","aw","or","বা"],["قَآئِمًۭا","qāiman","standing","দাঁড়িয়ে"],["فَلَمَّا","falammā","But when","অতঃপর যখন"],["كَشَفْنَا","kashafnā","We remove","আমরা দূর করি"],["عَنْهُ","‘anhu","from him","থেকে তার"],["ضُرَّهُۥ","ḍurrahu","his affliction","দুঃখ-দৈন্য তার"],["مَرَّ","marra","he passes on","সে চলে (এমনভাবে)"],["كَأَن","ka-an","as if he","যেন"],["لَّمْ","lam","(had) not","নি"],["يَدْعُنَآ","yad‘unā","called Us","আমাদেরকে ডাকেই"],["إِلَىٰ","ilā","for","জন্যে"],["ضُرٍّۢ","ḍurrin","(the) affliction","দুঃখের"],["مَّسَّهُۥ ۚ","massahu","(that) touched him","স্পর্শ করেছিলো তাকে"],["كَذَٰلِكَ","kadhālika","Thus","এভাবে"],["زُيِّنَ","zuyyina","(it) is made fair seeming","সুশোভিত করা হয়েছে"],["لِلْمُسْرِفِينَ","lil'mus'rifīna","to the extravagant","জন্যে সীমালঙ্ঘনকারীদের"],["مَا","mā","what","যা"],["كَانُوا۟","kānū","they used (to)","তারা ছিলো"],["يَعْمَلُونَ","ya‘malūna","do","তারা কাজ করতে"]],"t":"وَإِذَا مَسَّ <h>ٱ</>لْإِ<k>نسَٰ</>نَ <h>ٱ</><l>ل</>ضُّرُّ دَعَانَا لِجَ<i>نۢبِ</><o>هِۦٓ</> أَوْ قَاعِدًا أَوْ <o>قَآ</>ئِ<k>مًۭا فَ</>لَ<g>مَّ</>ا كَشَفْنَا عَنْهُ ضُرَّهُ<m>ۥ</> مَرَّ كَ<w>أَن لَّ</>مْ يَ<q>دْ</>عُ<o>نَآ</> إِلَىٰ ضُ<d>رٍّۢ مَّ</>سَّهُ<m>ۥ</> ۚ كَ<m>ذَٰ</>لِكَ زُيِّنَ لِلْمُسْرِفِينَ مَا كَانُو<s>ا۟</> يَعْمَ<p>لُو</>نَ"},{"n":13,"w":[["وَلَقَدْ","walaqad","And verily","এবং নিশ্চয়ই"],["أَهْلَكْنَا","ahlaknā","We destroyed","ধ্বংস করেছি আমরা"],["ٱلْقُرُونَ","l-qurūna","the generations","বহু মানবগোষ্ঠীকে"],["مِن","min","before you","থেকেও"],["قَبْلِكُمْ","qablikum","before you","পূর্ব তোমাদের"],["لَمَّا","lammā","when","যখন"],["ظَلَمُوا۟ ۙ","ẓalamū","they wronged","তারা অবিচার করেছিলো"],["وَجَآءَتْهُمْ","wajāathum","and came to them","ও কাছে এসেছিলো তাদের"],["رُسُلُهُم","rusuluhum","their Messengers","রাসূলরা তাদের"],["بِٱلْبَيِّنَـٰتِ","bil-bayināti","with clear proofs","সহ সুস্পষ্ট নিদর্শনগুলো"],["وَمَا","wamā","but not","এবং না"],["كَانُوا۟","kānū","they were","তারা ছিলো"],["لِيُؤْمِنُوا۟ ۚ","liyu'minū","to believe","জন্যে ঈমান আনার"],["كَذَٰلِكَ","kadhālika","Thus","এভাবে"],["نَجْزِى","najzī","We recompense","প্রতিফল দিই আমরা"],["ٱلْقَوْمَ","l-qawma","the people","সসম্প্রদায়কে"],["ٱلْمُجْرِمِينَ","l-muj'rimīna","(who are) criminals","অপরাধী"]],"t":"وَلَقَ<q>دْ</> أَهْلَكْنَا <h>ٱ</>لْقُرُونَ مِ<k>ن قَ</><q>بْ</>لِكُمْ لَ<g>مَّ</>ا ظَلَمُو<s>ا۟ ۙ</> وَ<o>جَآ</>ءَتْهُمْ رُسُلُ<f>هُم بِ</><h>ٱ</>لْبَيِّ<m>نَٰ</>تِ وَمَا كَانُو<s>ا۟</> لِيُؤْمِنُو<s>ا۟ ۚ</> كَ<m>ذَٰ</>لِكَ نَ<q>جْ</>زِى <h>ٱ</>لْقَوْمَ <h>ٱ</>لْمُ<q>جْ</>رِ<p>مِي</>نَ"},{"n":14,"w":[["ثُمَّ","thumma","Then","এরপর"],["جَعَلْنَـٰكُمْ","ja‘alnākum","We made you","আমরা বানালাম তোমাদেরকে"],["خَلَـٰٓئِفَ","khalāifa","successors","প্রতিনিধি"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["مِنۢ","min","after them","থেকে"],["بَعْدِهِمْ","ba‘dihim","after them","পর তাদের"],["لِنَنظُرَ","linanẓura","so that We may see","যেন দেখি আমরা"],["كَيْفَ","kayfa","how","কেমন"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা কাজ করো"]],"t":"ثُ<g>مَّ</> جَعَلْ<m>نَٰ</>كُمْ خَ<o>لَٰٓ</>ئِفَ فِى <h>ٱ</>لْأَرْضِ <i>مِنۢ بَ</>عْدِهِمْ لِنَ<k>نظُ</>رَ كَيْفَ تَعْمَ<p>لُو</>نَ"},{"n":15,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["تُتْلَىٰ","tut'lā","are recited","তিলাওয়াত করা হয়"],["عَلَيْهِمْ","‘alayhim","to them","নিকট তাদের"],["ءَايَاتُنَا","āyātunā","Our Verses","আয়াতগুলোকে আমাদের"],["بَيِّنَـٰتٍۢ ۙ","bayyinātin","(as) clear proofs","সুস্পষ্ট"],["قَالَ","qāla","said","বলে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["لَا","lā","(do) not","না"],["يَرْجُونَ","yarjūna","hope","আশা রাখে"],["لِقَآءَنَا","liqāanā","(for the) meeting (with) Us","সাক্ষাতের আমাদের"],["ٱئْتِ","i'ti","Bring us","\"আসো"],["بِقُرْءَانٍ","biqur'ānin","a Quran","নিয়ে কুরআন"],["غَيْرِ","ghayri","other (than)","ছাড়া"],["هَـٰذَآ","hādhā","this","এটা (অন্য একটি)"],["أَوْ","aw","or","অথবা"],["بَدِّلْهُ ۚ","baddil'hu","change it","পরিবর্তন করো তা\""],["قُلْ","qul","Say","বলো"],["مَا","mā","Not","\"নয়"],["يَكُونُ","yakūnu","(it) is","সঙ্গত"],["لِىٓ","lī","for me","জন্যে আমার"],["أَنْ","an","that","যে"],["أُبَدِّلَهُۥ","ubaddilahu","I change it","পরিবর্তন করবো আমি তা"],["مِن","min","of","হতে"],["تِلْقَآئِ","til'qāi","my own accord","পক্ষ"],["نَفْسِىٓ ۖ","nafsī","my own accord","নিজের আমার"],["إِنْ","in","Not","না"],["أَتَّبِعُ","attabi‘u","I follow","আমি অনুসরণ করি"],["إِلَّا","illā","except","এ ছাড়া"],["مَا","mā","what","যা"],["يُوحَىٰٓ","yūḥā","is revealed","ওহী করা হয়"],["إِلَىَّ ۖ","ilayya","to me","প্রতি আমার"],["إِنِّىٓ","innī","Indeed, I","নিশ্চয়ই আমি"],["أَخَافُ","akhāfu","[I] fear","ভয় করি"],["إِنْ","in","if","যদি"],["عَصَيْتُ","‘aṣaytu","I were to disobey","আমি অবাধ্যতা করি"],["رَبِّى","rabbī","my Lord","আমার রবের"],["عَذَابَ","‘adhāba","(the) punishment","শাস্তির"],["يَوْمٍ","yawmin","(of) a Day","দিনের\""],["عَظِيمٍۢ","‘aẓīmin","Great","মহা\""]],"t":"وَإِذَا تُتْلَىٰ عَلَيْهِمْ ءَايَاتُنَا بَيِّ<m>نَٰ</><k>تٍۢ ۙ قَ</>الَ <h>ٱ</>لَّذِينَ لَا يَرْجُونَ لِ<o>قَآ</>ءَنَا <h>ٱ</>ئْتِ بِقُرْءَانٍ غَيْرِ <m>هَٰ</><o>ذَآ</> أَوْ بَدِّلْهُ ۚ قُلْ مَا يَكُونُ <o>لِىٓ</> أَنْ أُبَدِّلَهُ<m>ۥ</> مِ<k>ن تِ</>لْقَآئِ نَفْ<o>سِىٓ ۖ</> إِنْ أَتَّبِعُ إِلَّا مَا يُوحَ<o>ىٰٓ</> إِلَىَّ ۖ إِ<g>نِّ</><o>ىٓ</> أَخَافُ إِنْ عَصَيْتُ رَبِّى عَذَابَ يَوْمٍ عَ<p>ظِي</>مٍۢ"},{"n":16,"w":[["قُل","qul","Say","বলো"],["لَّوْ","law","If","\"যদি"],["شَآءَ","shāa","(had) willed","চাইতেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["مَا","mā","not","না"],["تَلَوْتُهُۥ","talawtuhu","I (would) have recited it","আমি তিলাওয়াত করতাম তা"],["عَلَيْكُمْ","‘alaykum","to you","কাছে তোমাদের"],["وَلَآ","walā","and not","এবং না"],["أَدْرَىٰكُم","adrākum","He (would) have made it known to you","তিনি জানাতেন তোমাদের"],["بِهِۦ ۖ","bihi","He (would) have made it known to you","সম্বন্ধে তা"],["فَقَدْ","faqad","Verily","অতঃপর নিশ্চয়ই"],["لَبِثْتُ","labith'tu","I have stayed","আমি অবস্থান করেছি"],["فِيكُمْ","fīkum","among you","মাঝে তোমাদের"],["عُمُرًۭا","‘umuran","a lifetime","এক বয়স"],["مِّن","min","before it","থেকে"],["قَبْلِهِۦٓ ۚ","qablihi","before it","পূর্ব এর"],["أَفَلَا","afalā","Then will not","কি তবুও না"],["تَعْقِلُونَ","ta‘qilūna","you use reason","তোমরা বুঝবে\""]],"t":"قُل لَّوْ <o>شَآ</>ءَ <h>ٱ</>للَّهُ مَا تَلَوْتُهُ<m>ۥ</> عَلَيْكُمْ وَ<o>لَآ</> أَ<q>دْ</>رَ<m>ىٰ</><f>كُم بِ</><m>هِۦ</> ۖ فَقَ<q>دْ</> لَبِثْتُ فِيكُمْ عُمُ<d>رًۭا مِّ</><k>ن قَ</><q>بْ</>لِ<o>هِۦٓ ۚ</> أَفَلَا تَعْقِ<p>لُو</>نَ"},{"n":17,"w":[["فَمَنْ","faman","So who","অতএব কে"],["أَظْلَمُ","aẓlamu","(is) more wrong","অধিক সীমালঙ্ঘনকারী (হতে পারে)"],["مِمَّنِ","mimmani","than he who","(তার) চেয়ে যে"],["ٱفْتَرَىٰ","if'tarā","invents","রচনা করে"],["عَلَى","‘alā","against","উপর"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["كَذِبًا","kadhiban","a lie","মিথ্যা"],["أَوْ","aw","or","বা"],["كَذَّبَ","kadhaba","denies","মিথ্যারোপ করে"],["بِـَٔايَـٰتِهِۦٓ ۚ","biāyātihi","His Signs","সম্পর্কে তাঁর নিদর্শনগুলো"],["إِنَّهُۥ","innahu","Indeed","নিশ্চয়ই তা"],["لَا","lā","not","না"],["يُفْلِحُ","yuf'liḥu","will succeed","সফলকাম হয়"],["ٱلْمُجْرِمُونَ","l-muj'rimūna","the criminals","অপরাধীরা"]],"t":"فَمَنْ أَظْلَمُ مِ<g>مَّ</>نِ <h>ٱ</>فْتَرَىٰ عَلَى <h>ٱ</>للَّهِ كَذِبًا أَوْ كَذَّبَ بِـَٔا<m>يَٰ</>تِ<o>هِۦٓ ۚ</> إِ<g>نَّ</>هُ<m>ۥ</> لَا يُفْلِحُ <h>ٱ</>لْمُ<q>جْ</>رِ<p>مُو</>نَ"},{"n":18,"w":[["وَيَعْبُدُونَ","waya‘budūna","And they worship","এবং তারা ইবাদত করে"],["مِن","min","from","দিয়ে"],["دُونِ","dūni","other than","ছেড়ে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহকে"],["مَا","mā","that (which)","যা"],["لَا","lā","(does) not","না"],["يَضُرُّهُمْ","yaḍurruhum","harm them","ক্ষতি করতে পারে তাদের"],["وَلَا","walā","and not","আর না"],["يَنفَعُهُمْ","yanfa‘uhum","benefit them","উপকার করতে পারে তাদের"],["وَيَقُولُونَ","wayaqūlūna","and they say","এবং তারা বলে"],["هَـٰٓؤُلَآءِ","hāulāi","These","\"এসব"],["شُفَعَـٰٓؤُنَا","shufa‘āunā","(are) our intercessors","সুপারিশকারী আমাদের"],["عِندَ","‘inda","with","কাছে"],["ٱللَّهِ ۚ","l-lahi","Allah","আল্লাহর\""],["قُلْ","qul","Say","বলো"],["أَتُنَبِّـُٔونَ","atunabbiūna","Do you inform","\"কি তোমরা সংবাদ দিচ্ছো"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["بِمَا","bimā","of what","তা সম্বন্ধে যা"],["لَا","lā","not","না"],["يَعْلَمُ","ya‘lamu","he knows","তিনি জানেন"],["فِى","fī","in","মধ্যে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশসমূহের"],["وَلَا","walā","and not","এবং না"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ ۚ","l-arḍi","the earth","পৃথিবীর\""],["سُبْحَـٰنَهُۥ","sub'ḥānahu","Glorified is He","পবিত্র তিনি"],["وَتَعَـٰلَىٰ","wata‘ālā","and Exalted","এবং বহু উর্ধ্বে"],["عَمَّا","‘ammā","above what","তা হতে যা"],["يُشْرِكُونَ","yush'rikūna","they associate (with Him)","তারা শিরক করছে"]],"t":"وَيَعْبُدُونَ مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ مَا لَا يَضُرُّهُمْ وَلَا يَ<k>نفَ</>عُهُمْ وَيَقُولُونَ <o>هَٰٓؤُلَآ</>ءِ شُفَ<o>عَٰٓ</>ؤُنَا عِ<k>ندَ</> <h>ٱ</>للَّهِ ۚ قُلْ أَتُنَبِّـُٔونَ <h>ٱ</>للَّهَ بِمَا لَا يَعْلَمُ فِى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَلَا فِى <h>ٱ</>لْأَرْضِ ۚ سُ<q>بْ</><m>حَٰ</>نَهُ<m>ۥ</> وَتَ<m>عَٰ</>لَىٰ عَ<g>مَّ</>ا يُشْرِ<p>كُو</>نَ"},{"n":19,"w":[["وَمَا","wamā","And not","এবং না"],["كَانَ","kāna","was","ছিলো"],["ٱلنَّاسُ","l-nāsu","the mankind","মানুষ"],["إِلَّآ","illā","but","এ ছাড়া"],["أُمَّةًۭ","ummatan","a community","উম্মত"],["وَٰحِدَةًۭ","wāḥidatan","one","একই"],["فَٱخْتَلَفُوا۟ ۚ","fa-ikh'talafū","then they differed","এরপর তারা মতভেদ করে"],["وَلَوْلَا","walawlā","And had (it) not been","এবং যদি না"],["كَلِمَةٌۭ","kalimatun","a word","একটি কথা"],["سَبَقَتْ","sabaqat","(that) preceded","পূর্ব ঘোষিত হতে"],["مِن","min","from","পক্ষ হতে"],["رَّبِّكَ","rabbika","your Lord","তোমার রবের"],["لَقُضِىَ","laquḍiya","surely, it (would) have been judged","অবশ্যই মীমাংসা করে দেয়া হতো"],["بَيْنَهُمْ","baynahum","between them","মাঝে তাদের"],["فِيمَا","fīmā","concerning what","বিষয়ে সে"],["فِيهِ","fīhi","[therein]","সম্পর্কে যা"],["يَخْتَلِفُونَ","yakhtalifūna","they differ","তারা মতভেদ করছে"]],"t":"وَمَا كَانَ <h>ٱ</><l>ل</><g>نَّ</>اسُ إِ<o>لَّآ</> أُ<g>مَّ</><d>ةًۭ وَٰ</>حِدَ<k>ةًۭ فَ</><h>ٱ</>خْتَلَفُو<s>ا۟ ۚ</> وَلَوْلَا كَلِمَ<k>ةٌۭ سَ</>بَقَتْ <w>مِن رَّ</>بِّكَ لَقُضِىَ بَيْنَهُمْ فِيمَا فِيهِ يَخْتَلِ<p>فُو</>نَ"},{"n":20,"w":[["وَيَقُولُونَ","wayaqūlūna","And they say","এবং তারা বলে"],["لَوْلَآ","lawlā","Why not","\"কেন না"],["أُنزِلَ","unzila","is sent down","অবতীর্ণ করা হলো"],["عَلَيْهِ","‘alayhi","to him","উপর তার"],["ءَايَةٌۭ","āyatun","a Sign","কোনো নিদর্শন"],["مِّن","min","from","পক্ষ হতে"],["رَّبِّهِۦ ۖ","rabbihi","his Lord","রবের তার\""],["فَقُلْ","faqul","So say","তাহ'লে বলো"],["إِنَّمَا","innamā","Only","\"মুলতঃ"],["ٱلْغَيْبُ","l-ghaybu","the unseen","অদৃশ্যের (জ্ঞান)"],["لِلَّهِ","lillahi","(is) for Allah","নিকট আল্লাহরই (আছে)"],["فَٱنتَظِرُوٓا۟","fa-intaẓirū","so wait","অতএব তোমরা অপেক্ষা করো"],["إِنِّى","innī","indeed, I am","নিশ্চয়ই আমি"],["مَعَكُم","ma‘akum","with you","সাথে তোমাদের"],["مِّنَ","mina","among","অন্তর্ভুক্ত"],["ٱلْمُنتَظِرِينَ","l-muntaẓirīna","the ones who wait","অপেক্ষাকারীদের\""]],"t":"وَيَقُولُونَ لَوْ<o>لَآ</> أُ<k>نزِ</>لَ عَلَيْهِ ءَايَ<d>ةٌۭ مِّ</><w>ن رَّ</>بِّ<m>هِۦ</> ۖ فَقُلْ إِ<g>نَّ</>مَا <h>ٱ</>لْغَيْبُ لِلَّهِ فَ<h>ٱ</><k>نتَ</>ظِ<o>رُوٓ</><s>ا۟</> إِ<g>نِّ</>ى مَعَ<y>كُم مِّ</>نَ <h>ٱ</>لْمُ<k>نتَ</>ظِ<p>رِي</>نَ"},{"n":21,"w":[["وَإِذَآ","wa-idhā","And when","এবং যখন"],["أَذَقْنَا","adhaqnā","We let [the] mankind taste","আস্বাদন করাই আমরা"],["ٱلنَّاسَ","l-nāsa","We let [the] mankind taste","মানুষকে"],["رَحْمَةًۭ","raḥmatan","mercy","অনুগ্রহ"],["مِّنۢ","min","after","থেকে"],["بَعْدِ","ba‘di","after","পর"],["ضَرَّآءَ","ḍarrāa","adversity","দুঃখদৈন্য"],["مَسَّتْهُمْ","massathum","has touched them","স্পর্শ করেছিলো তাদের (যা)"],["إِذَا","idhā","behold","তখন"],["لَهُم","lahum","They have","থেকে তাদের"],["مَّكْرٌۭ","makrun","a plot","চক্রান্ত শুরু হয়"],["فِىٓ","fī","against","ব্যাপারে"],["ءَايَاتِنَا ۚ","āyātinā","Our Verses","নিদর্শনগুলোর আমাদের"],["قُلِ","quli","Say","বলো"],["ٱللَّهُ","l-lahu","Allah","\"আল্লাহ"],["أَسْرَعُ","asra‘u","(is) more swift","অধিক দ্রুত"],["مَكْرًا ۚ","makran","(in) planning","কৌশলে\""],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["رُسُلَنَا","rusulanā","Our Messengers","ফেরেশতারা আমাদের"],["يَكْتُبُونَ","yaktubūna","write down","লিখছে"],["مَا","mā","what","যা"],["تَمْكُرُونَ","tamkurūna","you plot","তোমরা ষড়যন্ত্র করছো"]],"t":"وَإِ<o>ذَآ</> أَذَ<q>قْ</>نَا <h>ٱ</><l>ل</><g>نَّ</>اسَ رَحْمَ<d>ةًۭ مِّ</><i>نۢ بَ</>عْدِ ضَ<o>رَّآ</>ءَ مَسَّتْهُمْ إِذَا لَ<y>هُم مَّ</>كْ<k>رٌۭ فِ</><o>ىٓ</> ءَايَاتِنَا ۚ قُلِ <h>ٱ</>للَّهُ أَسْرَعُ مَكْرًا ۚ إِ<g>نَّ</> رُسُلَنَا يَكْتُبُونَ مَا تَمْكُ<p>رُو</>نَ"},{"n":22,"w":[["هُوَ","huwa","He","তিনিই (আল্লাহ)"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["يُسَيِّرُكُمْ","yusayyirukum","enables you to travel","ভ্রমণ করান তোমাদের"],["فِى","fī","in","মধ্যে"],["ٱلْبَرِّ","l-bari","the land","স্থল ভাগে"],["وَٱلْبَحْرِ ۖ","wal-baḥri","and the sea","ও জলভাগে"],["حَتَّىٰٓ","ḥattā","until","এমনকি"],["إِذَا","idhā","when","যখন"],["كُنتُمْ","kuntum","you are","থাকো তোমরা"],["فِى","fī","in","মধ্যে"],["ٱلْفُلْكِ","l-ful'ki","the ships","নৌযানের"],["وَجَرَيْنَ","wajarayna","and they sail","ও সেগুলো চলে"],["بِهِم","bihim","with them","নিয়ে তাদের"],["بِرِيحٍۢ","birīḥin","with a wind","সাথে বাতাসের"],["طَيِّبَةٍۢ","ṭayyibatin","good","উত্তম"],["وَفَرِحُوا۟","wafariḥū","and they rejoice","ও তারা আনন্দিত হয়"],["بِهَا","bihā","therein","কারণে সে"],["جَآءَتْهَا","jāathā","comes to it","(এরপর যখন) তার উপর আসে"],["رِيحٌ","rīḥun","a wind","বাতাস"],["عَاصِفٌۭ","‘āṣifun","stormy","ঝড়ো"],["وَجَآءَهُمُ","wajāahumu","and comes to them","ও তাদের উপর আসে"],["ٱلْمَوْجُ","l-mawju","the waves","ঢেউ"],["مِن","min","from","থেকে"],["كُلِّ","kulli","every","সব"],["مَكَانٍۢ","makānin","place","জায়গা"],["وَظَنُّوٓا۟","waẓannū","and they assume","ও তারা ভাবে"],["أَنَّهُمْ","annahum","that they","যে তারা"],["أُحِيطَ","uḥīṭa","are surrounded","পরিবেষ্টিত হয়েছে"],["بِهِمْ ۙ","bihim","with them","দিয়ে সেগুলো"],["دَعَوُا۟","da‘awū","They call","(তখন) তারা ডাকে"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["مُخْلِصِينَ","mukh'liṣīna","sincerely","একনিষ্ঠ হয়ে"],["لَهُ","lahu","to Him","জন্যে তাঁরই"],["ٱلدِّينَ","l-dīna","(in) the religion","আনুগত্য"],["لَئِنْ","la-in","(saying), \"If","(এই বলে) অবশ্যই যদি"],["أَنجَيْتَنَا","anjaytanā","You save us","তুমি উদ্ধার করো আমাদের"],["مِنْ","min","from","হতে"],["هَـٰذِهِۦ","hādhihi","this","এটা"],["لَنَكُونَنَّ","lanakūnanna","surely we will be","অবশ্যই আমরা হবো"],["مِنَ","mina","among","অন্তর্ভুক্ত"],["ٱلشَّـٰكِرِينَ","l-shākirīna","the thankful","কৃতজ্ঞদের\""]],"t":"هُوَ <h>ٱ</>لَّذِى يُسَيِّرُكُمْ فِى <h>ٱ</>لْبَرِّ وَ<h>ٱ</>لْبَحْرِ ۖ حَتَّ<o>ىٰٓ</> إِذَا كُ<k>نتُ</>مْ فِى <h>ٱ</>لْفُلْكِ وَجَرَيْنَ بِ<f>هِم بِ</>رِي<k>حٍۢ طَ</>يِّبَ<d>ةٍۢ وَ</>فَرِحُو<s>ا۟</> بِهَا <o>جَآ</>ءَتْهَا رِيحٌ عَاصِ<d>فٌۭ وَ</><o>جَآ</>ءَهُمُ <h>ٱ</>لْمَوْجُ مِ<k>ن كُ</>لِّ مَكَا<d>نٍۢ وَ</>ظَ<g>نُّ</><o>وٓ</><s>ا۟</> أَ<g>نَّ</>هُمْ أُحِيطَ بِهِمْ ۙ دَعَوُ<s>ا۟</> <h>ٱ</>للَّهَ مُخْلِصِينَ لَهُ <h>ٱ</><l>ل</>دِّينَ لَئِنْ أَ<k>نجَ</>يْتَنَا مِنْ <m>هَٰذِهِۦ</> لَنَكُونَ<g>نَّ</> مِنَ <h>ٱ</><l>ل</><m>شَّٰ</>كِ<p>رِي</>نَ"},{"n":23,"w":[["فَلَمَّآ","falammā","But when","অতঃপর যখন"],["أَنجَىٰهُمْ","anjāhum","He saved them","উদ্ধার করেন তিনি তাদের"],["إِذَا","idhā","behold","তখন"],["هُمْ","hum","They","তারা"],["يَبْغُونَ","yabghūna","rebel","বিদ্রোহ করে"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["بِغَيْرِ","bighayri","without","ভাবে নয়"],["ٱلْحَقِّ ۗ","l-ḥaqi","[the] right","ন্যায়"],["يَـٰٓأَيُّهَا","yāayyuhā","O mankind","হে"],["ٱلنَّاسُ","l-nāsu","O mankind","মানুষ"],["إِنَّمَا","innamā","Only","প্রকৃতপক্ষে"],["بَغْيُكُمْ","baghyukum","your rebellion","তোমাদের বিদ্রোহ"],["عَلَىٰٓ","‘alā","(is) against","(উল্টো পড়েছে) উপর"],["أَنفُسِكُم ۖ","anfusikum","yourselves","নিজেদের তোমাদের"],["مَّتَـٰعَ","matā‘a","(the) enjoyment","(ভোগ করে নাও) ভোগসামগ্রী"],["ٱلْحَيَوٰةِ","l-ḥayati","(of) the life","জীবনের"],["ٱلدُّنْيَا ۖ","l-dun'yā","(of) the world","পার্থিব"],["ثُمَّ","thumma","Then","এরপর"],["إِلَيْنَا","ilaynā","to Us","দিকে আমাদেরই"],["مَرْجِعُكُمْ","marji‘ukum","(is) your return","প্রত্যাবর্তন (হবে) তোমাদের"],["فَنُنَبِّئُكُم","fanunabbi-ukum","and We will inform you","তখন জানিয়ে দিবো আমরা তোমাদের"],["بِمَا","bimā","of what","তা সম্বন্ধে যা"],["كُنتُمْ","kuntum","you used (to)","তোমরা ছিলে"],["تَعْمَلُونَ","ta‘malūna","do","তোমরা কাজ-কর্ম করতে"]],"t":"فَلَ<g>مَّ</><o>آ</> أَ<k>نجَ</><m>ىٰ</>هُمْ إِذَا هُمْ يَ<q>بْ</>غُونَ فِى <h>ٱ</>لْأَرْضِ بِغَيْرِ <h>ٱ</>لْحَقِّ ۗ <o>يَٰٓ</>أَيُّهَا <h>ٱ</><l>ل</><g>نَّ</>اسُ إِ<g>نَّ</>مَا بَغْيُكُمْ عَلَ<o>ىٰٓ</> أَ<k>نفُ</>سِ<y>كُم ۖ مَّ</><m>تَٰ</>عَ <h>ٱ</>لْحَيَ<s>وٰ</>ةِ <h>ٱ</><l>ل</>دُّنْيَا ۖ ثُ<g>مَّ</> إِلَيْنَا مَرْجِعُكُمْ فَنُنَبِّئُ<f>كُم بِ</>مَا كُ<k>نتُ</>مْ تَعْمَ<p>لُو</>نَ"},{"n":24,"w":[["إِنَّمَا","innamā","Only","প্রকৃতপক্ষে"],["مَثَلُ","mathalu","(the) example","উদাহরণ"],["ٱلْحَيَوٰةِ","l-ḥayati","(of) the life","জীবনের"],["ٱلدُّنْيَا","l-dun'yā","(of) the world","পার্থিব"],["كَمَآءٍ","kamāin","(is) like (the) water","মতো পানির"],["أَنزَلْنَـٰهُ","anzalnāhu","which We sent down","আমরা বর্ষণ করি তা"],["مِنَ","mina","from","থেকে"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশ"],["فَٱخْتَلَطَ","fa-ikh'talaṭa","so absorbs","অতঃপর সংমিশ্রিত হয়ে (উদ্‌গত হয়)"],["بِهِۦ","bihi","[with] it","দিয়ে তা"],["نَبَاتُ","nabātu","(the) plants","উদ্ভিদ"],["ٱلْأَرْضِ","l-arḍi","(of) the earth","মাটির"],["مِمَّا","mimmā","from which","হতে যা"],["يَأْكُلُ","yakulu","eat","খায়"],["ٱلنَّاسُ","l-nāsu","the men","মানুষ"],["وَٱلْأَنْعَـٰمُ","wal-an‘āmu","and the cattle","ও জীবজন্তু"],["حَتَّىٰٓ","ḥattā","until","এমনকি"],["إِذَآ","idhā","when","যখন"],["أَخَذَتِ","akhadhati","takes","ধারণ করলো"],["ٱلْأَرْضُ","l-arḍu","the earth","জমি"],["زُخْرُفَهَا","zukh'rufahā","its adornment","শোভা তার"],["وَٱزَّيَّنَتْ","wa-izzayyanat","and is beautified","ও চাকচিক্যময় হলো"],["وَظَنَّ","waẓanna","and think","এবং মনে করলো"],["أَهْلُهَآ","ahluhā","its people","মালিকরা তার"],["أَنَّهُمْ","annahum","that they","যে তারা"],["قَـٰدِرُونَ","qādirūna","have the power","সক্ষম হবে"],["عَلَيْهَآ","‘alayhā","over it","তার উপর (ভোগ করতে)"],["أَتَىٰهَآ","atāhā","comes (to) it","তার উপর এসে পড়ে"],["أَمْرُنَا","amrunā","Our command","নির্দেশ আমাদের"],["لَيْلًا","laylan","(by) night","রাতে"],["أَوْ","aw","or","অথবা"],["نَهَارًۭا","nahāran","(by) day","দিনে"],["فَجَعَلْنَـٰهَا","faja‘alnāhā","and We make it","অতঃপর আমরা বানিয়ে দিই তা"],["حَصِيدًۭا","ḥaṣīdan","a harvest clean-mown","কর্তিত ফসল (নির্মূল)"],["كَأَن","ka-an","as if","যেন"],["لَّمْ","lam","not","ছিলোই না"],["تَغْنَ","taghna","it had flourished","অবস্থিত"],["بِٱلْأَمْسِ ۚ","bil-amsi","yesterday","গতকাল (কোনো ফসল)"],["كَذَٰلِكَ","kadhālika","Thus","এভাবে"],["نُفَصِّلُ","nufaṣṣilu","We explain","বিশদ বর্ণনা করি আমরা"],["ٱلْـَٔايَـٰتِ","l-āyāti","the Signs","নিদর্শনগুলোকে"],["لِقَوْمٍۢ","liqawmin","for a people","জন্যে সম্প্রদায়ের"],["يَتَفَكَّرُونَ","yatafakkarūna","who reflect","(যারা) চিন্তা-ভাবনা করে"]],"t":"إِ<g>نَّ</>مَا مَثَلُ <h>ٱ</>لْحَيَ<s>وٰ</>ةِ <h>ٱ</><l>ل</>دُّنْيَا كَ<o>مَآ</>ءٍ أَ<k>نزَ</>لْ<m>نَٰ</>هُ مِنَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ فَ<h>ٱ</>خْتَلَطَ بِ<m>هِۦ</> نَبَاتُ <h>ٱ</>لْأَرْضِ مِ<g>مَّ</>ا يَأْكُلُ <h>ٱ</><l>ل</><g>نَّ</>اسُ وَ<h>ٱ</>لْأَنْ<m>عَٰ</>مُ حَتَّ<o>ىٰٓ</> إِ<o>ذَآ</> أَخَذَتِ <h>ٱ</>لْأَرْضُ زُخْرُفَهَا وَ<h>ٱ</>زَّيَّنَتْ وَظَ<g>نَّ</> أَهْلُ<o>هَآ</> أَ<g>نَّ</>هُمْ <m>قَٰ</>دِرُونَ عَلَيْ<o>هَآ</> أَتَ<m>ىٰ</><o>هَآ</> أَمْرُنَا لَيْلًا أَوْ نَهَا<k>رًۭا فَ</>جَعَلْ<m>نَٰ</>هَا حَصِي<k>دًۭا كَ</><w>أَن لَّ</>مْ تَغْنَ بِ<h>ٱ</>لْأَمْسِ ۚ كَ<m>ذَٰ</>لِكَ نُفَصِّلُ <h>ٱ</>لْءَا<m>يَٰ</>تِ لِقَوْ<d>مٍۢ يَ</>تَفَكَّ<p>رُو</>نَ"},{"n":25,"w":[["وَٱللَّهُ","wal-lahu","And Allah","আর আল্লাহ"],["يَدْعُوٓا۟","yad‘ū","calls","ডাকেন"],["إِلَىٰ","ilā","to","দিকে"],["دَارِ","dāri","(the) Home","আবাসের"],["ٱلسَّلَـٰمِ","l-salāmi","(of) the Peace","শান্তির"],["وَيَهْدِى","wayahdī","and guides","ও পথ দেখান"],["مَن","man","whom","যাকে"],["يَشَآءُ","yashāu","He wills","তিনিই ইচ্ছা করেন"],["إِلَىٰ","ilā","to","দিকে"],["صِرَٰطٍۢ","ṣirāṭin","(the) straight path","পথের"],["مُّسْتَقِيمٍۢ","mus'taqīmin","(the) straight path","সরল সঠিক"]],"t":"وَ<h>ٱ</>للَّهُ يَ<q>دْ</><o>عُوٓ</><s>ا۟</> إِلَىٰ دَارِ <h>ٱ</><l>ل</>سَّ<m>لَٰ</>مِ وَيَهْدِى <d>مَن يَ</><o>شَآ</>ءُ إِلَىٰ صِ<m>رَٰ</><d>طٍۢ مُّ</>سْتَ<p>قِي</>مٍۢ"},{"n":26,"w":[["۞ لِّلَّذِينَ","lilladhīna","For those who","জন্যে তাদের (আছে)"],["أَحْسَنُوا۟","aḥsanū","do good","(যারা) ভালো কাজ করে"],["ٱلْحُسْنَىٰ","l-ḥus'nā","(is) the best","উত্তম ফল"],["وَزِيَادَةٌۭ ۖ","waziyādatun","and more","এবং আরও বেশি (অনুগ্রহ)"],["وَلَا","walā","And not","এবং না"],["يَرْهَقُ","yarhaqu","(will) cover","আচ্ছন্ন করবে"],["وُجُوهَهُمْ","wujūhahum","their faces","মুখমন্ডলসমূহকে তাদের"],["قَتَرٌۭ","qatarun","dust","কালিমা"],["وَلَا","walā","and not","এবং না"],["ذِلَّةٌ ۚ","dhillatun","humiliation","লাঞ্ছনা"],["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব লোক"],["أَصْحَـٰبُ","aṣḥābu","(are the) companions","অধিবাসী (হবে)"],["ٱلْجَنَّةِ ۖ","l-janati","(of) Paradise","জান্নাতের"],["هُمْ","hum","they","তারা"],["فِيهَا","fīhā","in it","মধ্যে তার"],["خَـٰلِدُونَ","khālidūna","(will) abide forever","স্থায়ী হবে"]],"t":"۞ لِّلَّذِينَ أَحْسَنُو<s>ا۟</> <h>ٱ</>لْحُسْنَىٰ وَزِيَادَ<d>ةٌۭ ۖ وَ</>لَا يَرْهَقُ وُجُوهَهُمْ قَتَ<d>رٌۭ وَ</>لَا ذِلَّةٌ ۚ أُ<s>و۟</><o>لَٰٓ</>ئِكَ أَصْ<m>حَٰ</>بُ <h>ٱ</>لْجَ<g>نَّ</>ةِ ۖ هُمْ فِيهَا <m>خَٰ</>لِ<p>دُو</>نَ"},{"n":27,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["كَسَبُوا۟","kasabū","earned","অর্জন করেছে"],["ٱلسَّيِّـَٔاتِ","l-sayiāti","the evil deeds","মন্দ কাজ"],["جَزَآءُ","jazāu","(the) recompense","(তারা পাবে) প্রতিফল"],["سَيِّئَةٍۭ","sayyi-atin","(of) an evil deed","মন্দ কাজের"],["بِمِثْلِهَا","bimith'lihā","(is) like it","অনুরূপ তার"],["وَتَرْهَقُهُمْ","watarhaquhum","and (will) cover them","ও আচ্ছন্ন করবে তাদের"],["ذِلَّةٌۭ ۖ","dhillatun","humiliation","লাঞ্ছনা"],["مَّا","mā","They will not have","নেই"],["لَهُم","lahum","They will not have","জন্যে তাদের"],["مِّنَ","mina","from","হতে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["مِنْ","min","any","কোনো"],["عَاصِمٍۢ ۖ","‘āṣimin","defender","রক্ষাকারী"],["كَأَنَّمَآ","ka-annamā","As if","যেন প্রকৃতপক্ষে"],["أُغْشِيَتْ","ugh'shiyat","had been covered","ঢেকে ফেলেছে"],["وُجُوهُهُمْ","wujūhuhum","their faces","মুখমন্ডলগুলো তাদের"],["قِطَعًۭا","qiṭa‘an","(with) pieces","টুকরা"],["مِّنَ","mina","from","এর"],["ٱلَّيْلِ","al-layli","the darkness (of) night","রাত"],["مُظْلِمًا ۚ","muẓ'liman","the darkness (of) night","অন্ধকার"],["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসবলোক"],["أَصْحَـٰبُ","aṣḥābu","(are the) companions","অধিবাসী (হবে)"],["ٱلنَّارِ ۖ","l-nāri","(of) the Fire","আগুনের"],["هُمْ","hum","they","তারা"],["فِيهَا","fīhā","in it","মধ্যে তার"],["خَـٰلِدُونَ","khālidūna","(will) abide forever","স্থায়ী হবে"]],"t":"وَ<h>ٱ</>لَّذِينَ كَسَبُو<s>ا۟</> <h>ٱ</><l>ل</>سَّيِّـَٔاتِ جَ<o>زَآ</>ءُ سَيِّئَ<i>ةٍۭ بِ</>مِثْلِهَا وَتَرْهَقُهُمْ ذِلَّ<d>ةٌۭ ۖ مَّ</>ا لَ<y>هُم مِّ</>نَ <h>ٱ</>للَّهِ مِنْ عَاصِ<k>مٍۢ ۖ كَ</>أَ<g>نَّ</><o>مَآ</> أُغْشِيَتْ وُجُوهُهُمْ قِطَ<d>عًۭا مِّ</>نَ <h>ٱ</>لَّيْلِ مُظْلِمًا ۚ أُ<s>و۟</><o>لَٰٓ</>ئِكَ أَصْ<m>حَٰ</>بُ <h>ٱ</><l>ل</><g>نَّ</>ارِ ۖ هُمْ فِيهَا <m>خَٰ</>لِ<p>دُو</>نَ"},{"n":28,"w":[["وَيَوْمَ","wayawma","And (the) Day","এবং যেদিন"],["نَحْشُرُهُمْ","naḥshuruhum","We will gather them","একত্র করবো আমরা তাদের"],["جَمِيعًۭا","jamī‘an","all together","সকলকে (আমার আদালতে)"],["ثُمَّ","thumma","then","এরপর"],["نَقُولُ","naqūlu","We will say","আমরা বলবো"],["لِلَّذِينَ","lilladhīna","to those who","উদ্দেশ্যে তাদের (যারা)"],["أَشْرَكُوا۟","ashrakū","associate partners (with Allah)","শিরক করেছিলো"],["مَكَانَكُمْ","makānakum","(Remain in) your place","\"তোমাদের স্থানে (অবস্হান করো)"],["أَنتُمْ","antum","you","তোমরা"],["وَشُرَكَآؤُكُمْ ۚ","washurakāukum","and your partners","ও তোমাদের শরীকরা\""],["فَزَيَّلْنَا","fazayyalnā","Then We will separate","অতঃপর পৃথক করে দিবো আমরা"],["بَيْنَهُمْ ۖ","baynahum","[between] them","মাঝে তাদের"],["وَقَالَ","waqāla","and (will) say","এবং বলবে"],["شُرَكَآؤُهُم","shurakāuhum","their partners","শরীকেরা তাদের"],["مَّا","mā","Not","\"না"],["كُنتُمْ","kuntum","you used (to)","তোমরা ছিলে"],["إِيَّانَا","iyyānā","worship us","আমাদেরকে\""],["تَعْبُدُونَ","ta‘budūna","worship us","উপাসনা করতে\""]],"t":"وَيَوْمَ نَحْشُرُهُمْ جَمِي<k>عًۭا ثُ</><g>مَّ</> نَقُولُ لِلَّذِينَ أَشْرَكُو<s>ا۟</> مَكَانَكُمْ أَ<k>نتُ</>مْ وَشُرَ<o>كَآ</>ؤُكُمْ ۚ فَزَيَّلْنَا بَيْنَهُمْ ۖ وَقَالَ شُرَ<o>كَآ</>ؤُ<y>هُم مَّ</>ا كُ<k>نتُ</>مْ إِيَّانَا تَعْبُ<p>دُو</>نَ"},{"n":29,"w":[["فَكَفَىٰ","fakafā","So sufficient","অতএব যথেষ্ট"],["بِٱللَّهِ","bil-lahi","(is) Allah","আল্লাহই"],["شَهِيدًۢا","shahīdan","(as) a witness","সাক্ষী হিসেবে"],["بَيْنَنَا","baynanā","between us","মাঝে আমাদের"],["وَبَيْنَكُمْ","wabaynakum","and between you","ও মাঝে তোমাদের"],["إِن","in","that","নিশ্চয়ই"],["كُنَّا","kunnā","we were","আমরা ছিলাম"],["عَنْ","‘an","of","হতে"],["عِبَادَتِكُمْ","‘ibādatikum","your worship","উপাসনা তোমাদের"],["لَغَـٰفِلِينَ","laghāfilīna","certainly unaware","অবশ্যই উদাসীন"]],"t":"فَكَفَىٰ بِ<h>ٱ</>للَّهِ شَهِي<i>دًۢا بَ</>يْنَنَا وَبَيْنَكُمْ إِ<k>ن كُ</><g>نَّ</>ا عَنْ عِبَادَتِكُمْ لَ<m>غَٰ</>فِ<p>لِي</>نَ"},{"n":30,"w":[["هُنَالِكَ","hunālika","There","সেখানে"],["تَبْلُوا۟","tablū","will be put to trial","যাচাই করে নিতে পারবে"],["كُلُّ","kullu","every","প্রত্যেক"],["نَفْسٍۢ","nafsin","soul","ব্যক্তি"],["مَّآ","mā","(for) what","যা"],["أَسْلَفَتْ ۚ","aslafat","it did previously","অতীতে করেছে"],["وَرُدُّوٓا۟","waruddū","and they will be returned","এবং তাদেরকে ফিরিয়ে নেয়া হবে"],["إِلَى","ilā","to","দিকে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["مَوْلَىٰهُمُ","mawlāhumu","their Lord","অভিভাবক তাদের"],["ٱلْحَقِّ ۖ","l-ḥaqi","the true","প্রকৃত"],["وَضَلَّ","waḍalla","and will be lost","এবং সরে যাবে"],["عَنْهُم","‘anhum","from them","থেকে তাদের"],["مَّا","mā","what","যা"],["كَانُوا۟","kānū","they used (to)","তারা ছিলো"],["يَفْتَرُونَ","yaftarūna","invent","তারা রচনা করতে"]],"t":"هُنَالِكَ تَ<q>بْ</>لُو<s>ا۟</> كُلُّ نَفْ<d>سٍۢ مَّ</><o>آ</> أَسْلَفَتْ ۚ وَرُ<o>دُّوٓ</><s>ا۟</> إِلَى <h>ٱ</>للَّهِ مَوْلَ<m>ىٰ</>هُمُ <h>ٱ</>لْحَقِّ ۖ وَضَلَّ عَنْ<y>هُم مَّ</>ا كَانُو<s>ا۟</> يَفْتَ<p>رُو</>نَ"},{"n":31,"w":[["قُلْ","qul","Say","বলো"],["مَن","man","Who","\"কে"],["يَرْزُقُكُم","yarzuqukum","provides for you","জীবিকা দেন তোমাদের"],["مِّنَ","mina","from","থেকে"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশ"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবী (থেকে)"],["أَمَّن","amman","Or who","অথবা কে"],["يَمْلِكُ","yamliku","controls","কর্তৃত্ব রাখেন"],["ٱلسَّمْعَ","l-sam‘a","the hearing","শ্রবণশক্তির"],["وَٱلْأَبْصَـٰرَ","wal-abṣāra","and the sight","ও দৃষ্টিশক্তিসমূহের"],["وَمَن","waman","And who","এবং কে"],["يُخْرِجُ","yukh'riju","brings out","বের করেন"],["ٱلْحَىَّ","l-ḥaya","the living","জীবন্তকে"],["مِنَ","mina","from","হতে"],["ٱلْمَيِّتِ","l-mayiti","the dead","মৃত"],["وَيُخْرِجُ","wayukh'riju","and brings forth","এবং (কে) বের করেন"],["ٱلْمَيِّتَ","l-mayita","the dead","মৃতকে"],["مِنَ","mina","from","হতে"],["ٱلْحَىِّ","l-ḥayi","the living","জীবন্ত"],["وَمَن","waman","And who","এবং কে"],["يُدَبِّرُ","yudabbiru","disposes","পরিচালনা করেন"],["ٱلْأَمْرَ ۚ","l-amra","the affairs","(বিশ্ব ব্যবস্থার সকল) কাজ\""],["فَسَيَقُولُونَ","fasayaqūlūna","Then they will say","তখন অচিরেই তারা বলবে"],["ٱللَّهُ ۚ","l-lahu","Allah","\"আল্লাহই\""],["فَقُلْ","faqul","Then say","তাহলে বলো"],["أَفَلَا","afalā","Then will not","\"কি তবুও না"],["تَتَّقُونَ","tattaqūna","you fear (Him)","(সত্য বিরোধিতায়) তোমরা বিরত থাকবে\""]],"t":"قُلْ <d>مَن يَ</>رْزُقُ<y>كُم مِّ</>نَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ وَ<h>ٱ</>لْأَرْضِ أَ<g>مَّ</><d>ن يَ</>مْلِكُ <h>ٱ</><l>ل</>سَّمْعَ وَ<h>ٱ</>لْأَ<q>بْ</><m>صَٰ</>رَ وَ<d>مَن يُ</>خْرِجُ <h>ٱ</>لْحَىَّ مِنَ <h>ٱ</>لْمَيِّتِ وَيُخْرِجُ <h>ٱ</>لْمَيِّتَ مِنَ <h>ٱ</>لْحَىِّ وَ<d>مَن يُ</>دَبِّرُ <h>ٱ</>لْأَمْرَ ۚ فَسَيَقُولُونَ <h>ٱ</>للَّهُ ۚ فَقُلْ أَفَلَا تَتَّ<p>قُو</>نَ"},{"n":32,"w":[["فَذَٰلِكُمُ","fadhālikumu","For that","অতএব এই"],["ٱللَّهُ","l-lahu","(is) Allah","আল্লাহই"],["رَبُّكُمُ","rabbukumu","your Lord","রব তোমাদের"],["ٱلْحَقُّ ۖ","l-ḥaqu","the true","প্রকৃত"],["فَمَاذَا","famādhā","So what (can be)","তাহ'লে কি (থাকতে পারে)"],["بَعْدَ","ba‘da","after","পরে"],["ٱلْحَقِّ","l-ḥaqi","the truth","মহাসত্যের"],["إِلَّا","illā","except","এ ছাড়া"],["ٱلضَّلَـٰلُ ۖ","l-ḍalālu","the error","বিভ্রান্তি"],["فَأَنَّىٰ","fa-annā","So how","অতএব কোথায়"],["تُصْرَفُونَ","tuṣ'rafūna","(are) you turned away","তোমরা চালিত হচ্ছো"]],"t":"فَ<m>ذَٰ</>لِكُمُ <h>ٱ</>للَّهُ رَبُّكُمُ <h>ٱ</>لْحَقُّ ۖ فَمَاذَا بَعْدَ <h>ٱ</>لْحَقِّ إِلَّا <h>ٱ</><l>ل</>ضَّ<m>لَٰ</>لُ ۖ فَأَ<g>نَّ</>ىٰ تُصْرَ<p>فُو</>نَ"},{"n":33,"w":[["كَذَٰلِكَ","kadhālika","Thus","এভাবে"],["حَقَّتْ","ḥaqqat","(is) proved true","সত্য প্রমাণিত হলো"],["كَلِمَتُ","kalimatu","(the) Word","বাণী"],["رَبِّكَ","rabbika","(of) your Lord","তোমার রবের"],["عَلَى","‘alā","upon","সম্পর্কে"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["فَسَقُوٓا۟","fasaqū","defiantly disobeyed","সত্যত্যাগ করেছে"],["أَنَّهُمْ","annahum","that they","যে তারা"],["لَا","lā","(will) not","না"],["يُؤْمِنُونَ","yu'minūna","believe","ঈমান আনবে"]],"t":"كَ<m>ذَٰ</>لِكَ حَقَّتْ كَلِمَتُ رَبِّكَ عَلَى <h>ٱ</>لَّذِينَ فَسَ<o>قُوٓ</><s>ا۟</> أَ<g>نَّ</>هُمْ لَا يُؤْمِ<p>نُو</>نَ"},{"n":34,"w":[["قُلْ","qul","Say","বলো"],["هَلْ","hal","Is (there)","\"(আছে) কি"],["مِن","min","of","মধ্যে হতে"],["شُرَكَآئِكُم","shurakāikum","your partners","শরীকদের তোমাদের"],["مَّن","man","(any) who","(এমন কেউ) যে"],["يَبْدَؤُا۟","yabda-u","originates","সূচনা করে"],["ٱلْخَلْقَ","l-khalqa","the creation","সৃষ্টির"],["ثُمَّ","thumma","then","এরপর"],["يُعِيدُهُۥ ۚ","yu‘īduhu","repeats it","পুনরাবর্তন ঘটায় তার\""],["قُلِ","quli","Say","বলো"],["ٱللَّهُ","l-lahu","Allah","\"আল্লাহই"],["يَبْدَؤُا۟","yabda-u","originates","সূচনা করেন"],["ٱلْخَلْقَ","l-khalqa","the creation","সৃষ্টির"],["ثُمَّ","thumma","then","এরপর"],["يُعِيدُهُۥ ۖ","yu‘īduhu","repeats it","পুনরাবর্তন ঘটান তার"],["فَأَنَّىٰ","fa-annā","So how","অতএব কোথায়"],["تُؤْفَكُونَ","tu'fakūna","you are deluded","তোমাদের ফিরানো হচ্ছে\""]],"t":"قُلْ هَلْ مِ<k>ن شُ</>رَ<o>كَآ</>ئِ<y>كُم مَّ</><d>ن يَ</><q>بْ</>دَؤُ<s>ا۟</> <h>ٱ</>لْخَلْقَ ثُ<g>مَّ</> يُعِيدُهُ<m>ۥ</> ۚ قُلِ <h>ٱ</>للَّهُ يَ<q>بْ</>دَؤُ<s>ا۟</> <h>ٱ</>لْخَلْقَ ثُ<g>مَّ</> يُعِيدُهُ<m>ۥ</> ۖ فَأَ<g>نَّ</>ىٰ تُؤْفَ<p>كُو</>نَ"},{"n":35,"w":[["قُلْ","qul","Say","বলো"],["هَلْ","hal","Is (there)","\"(আছে) কি"],["مِن","min","of","মধ্য হতে"],["شُرَكَآئِكُم","shurakāikum","your partners","শরীকদের তোমাদের"],["مَّن","man","(any) who","(এমন কেউ) যে"],["يَهْدِىٓ","yahdī","guides","পথ দেখায়"],["إِلَى","ilā","to","দিকে"],["ٱلْحَقِّ ۚ","l-ḥaqi","the truth","সত্যের\""],["قُلِ","quli","Say","বলো"],["ٱللَّهُ","l-lahu","Allah","\"আল্লাহই"],["يَهْدِى","yahdī","guides","পথ দেখান"],["لِلْحَقِّ ۗ","lil'ḥaqqi","to the truth","দিকে সত্যের"],["أَفَمَن","afaman","Is then (he) who","কি তবে যে"],["يَهْدِىٓ","yahdī","guides","স