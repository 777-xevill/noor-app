الَ","qāla","he said","সে বলেছিলো"],["لِقَوْمِهِۦ","liqawmihi","to his people","উদ্দেশ্যে তার জাতির"],["يَـٰقَوْمِ","yāqawmi","O my people","\"হে আমার জাতি"],["إِن","in","If","যদি"],["كَانَ","kāna","is","হয়"],["كَبُرَ","kabura","hard","দুঃসহ"],["عَلَيْكُم","‘alaykum","on you","উপর তোমাদের"],["مَّقَامِى","maqāmī","my stay","আমার অবস্থান"],["وَتَذْكِيرِى","watadhkīrī","and my reminding","ও আমার উপদেশ"],["بِـَٔايَـٰتِ","biāyāti","the Signs of Allah","দ্বারা নিদর্শনাবলী"],["ٱللَّهِ","l-lahi","the Signs of Allah","আল্লাহর"],["فَعَلَى","fa‘alā","then on","তবে উপর"],["ٱللَّهِ","l-lahi","Allah","আল্লাহরই"],["تَوَكَّلْتُ","tawakkaltu","I put my trust","আমি নির্ভর করছি"],["فَأَجْمِعُوٓا۟","fa-ajmi‘ū","So you all resolve","সুতরাং তোমরা সমবেত (হয়ে সম্পন্ন) করো"],["أَمْرَكُمْ","amrakum","your plan","(করণীয়)কর্তব্য তোমাদের"],["وَشُرَكَآءَكُمْ","washurakāakum","and your partners","ও শরীকদেরকেও তোমাদের  (সমবেত করো)"],["ثُمَّ","thumma","Then","এরপর"],["لَا","lā","let not be","না"],["يَكُنْ","yakun","let not be","হয় (যেন)"],["أَمْرُكُمْ","amrukum","(in) your plan","কর্তব্য তোমাদের"],["عَلَيْكُمْ","‘alaykum","for you","কাছে তোমাদের"],["غُمَّةًۭ","ghummatan","any doubt","সংশয়পূর্ণ"],["ثُمَّ","thumma","Then","এরপর"],["ٱقْضُوٓا۟","iq'ḍū","carry (it out)","তোমরা সিদ্ধান্ত  নিষ্পন্ন করো"],["إِلَىَّ","ilayya","upon me","আমার প্রতি"],["وَلَا","walā","and (do) not","এবং না"],["تُنظِرُونِ","tunẓirūni","give me respite","আমাকে তোমরা অবকাশ দিও"]],"t":"۞ وَ<h>ٱ</>تْلُ عَلَيْهِمْ نَبَأَ نُوحٍ إِذْ قَالَ لِقَوْمِ<m>هِۦ يَٰ</>قَوْمِ إِ<k>ن كَ</>انَ كَبُرَ عَلَيْ<y>كُم مَّ</>قَامِى وَتَذْكِيرِى بِـَٔا<m>يَٰ</>تِ <h>ٱ</>للَّهِ فَعَلَى <h>ٱ</>للَّهِ تَوَكَّلْتُ فَأَ<q>جْ</>مِ<o>عُوٓ</><s>ا۟</> أَمْرَكُمْ وَشُرَ<o>كَآ</>ءَكُمْ ثُ<g>مَّ</> لَا يَكُنْ أَمْرُكُمْ عَلَيْكُمْ غُ<g>مَّ</><k>ةًۭ ثُ</><g>مَّ</> <h>ٱ</><q>قْ</><o>ضُوٓ</><s>ا۟</> إِلَىَّ وَلَا تُ<k>نظِ</><p>رُو</>نِ"},{"n":72,"w":[["فَإِن","fa-in","But if","এরপরও যদি"],["تَوَلَّيْتُمْ","tawallaytum","you turn away","তোমরা মুখ ফিরাও"],["فَمَا","famā","then not","তবে না"],["سَأَلْتُكُم","sa-altukum","I have asked you","তোমাদের কাছে আমি চাই"],["مِّنْ","min","any","কোনো"],["أَجْرٍ ۖ","ajrin","reward","পারিশ্রমিক"],["إِنْ","in","Not","নেই"],["أَجْرِىَ","ajriya","(is) my reward","প্রতিদান আমার"],["إِلَّا","illā","but","এ ছাড়া"],["عَلَى","‘alā","on","নিকট"],["ٱللَّهِ ۖ","l-lahi","Allah","আল্লাহর"],["وَأُمِرْتُ","wa-umir'tu","and I have been commanded","এবং আমাকে আদেশ করা হয়েছে"],["أَنْ","an","that","যে"],["أَكُونَ","akūna","I be","আমি হই (যেন)"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْمُسْلِمِينَ","l-mus'limīna","the Muslims","আত্মসমর্পণকারীদের\""]],"t":"فَإِ<k>ن تَ</>وَلَّيْتُمْ فَمَا سَأَلْتُ<y>كُم مِّ</>نْ أَ<q>جْ</>رٍ ۖ إِنْ أَ<q>جْ</>رِىَ إِلَّا عَلَى <h>ٱ</>للَّهِ ۖ وَأُمِرْتُ أَنْ أَكُونَ مِنَ <h>ٱ</>لْمُسْلِ<p>مِي</>نَ"},{"n":73,"w":[["فَكَذَّبُوهُ","fakadhabūhu","But they denied him","অতঃপর তাঁর প্রতি তারা মিথ্যারোপ করলো"],["فَنَجَّيْنَـٰهُ","fanajjaynāhu","so We saved him","তখন আমরা উদ্ধার করলাম তাঁকে"],["وَمَن","waman","and (those) who","এবং যারা"],["مَّعَهُۥ","ma‘ahu","(were) with him","সাথে তাঁর(ছিলো)"],["فِى","fī","in","মধ্যে"],["ٱلْفُلْكِ","l-ful'ki","the ship","নৌকার"],["وَجَعَلْنَـٰهُمْ","waja‘alnāhum","and We made them","এবং আমরা বানালাম তাদেরকে"],["خَلَـٰٓئِفَ","khalāifa","successors","প্রতিনিধি"],["وَأَغْرَقْنَا","wa-aghraqnā","and We drowned","এবং ডুবিয়ে দিলাম আমরা"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["كَذَّبُوا۟","kadhabū","denied","মিথ্যারোপ করেছিলো"],["بِـَٔايَـٰتِنَا ۖ","biāyātinā","Our Signs","প্রতি নিদর্শনাবলীর আমাদের"],["فَٱنظُرْ","fa-unẓur","Then see","সুতরাং দেখো"],["كَيْفَ","kayfa","how","কেমন"],["كَانَ","kāna","was","হয়েছিলো"],["عَـٰقِبَةُ","‘āqibatu","(the) end","পরিণাম"],["ٱلْمُنذَرِينَ","l-mundharīna","(of) those who were warned","যাদের সতর্ক করা হয়েছিলো"]],"t":"فَكَذَّبُوهُ فَنَجَّيْ<m>نَٰ</>هُ وَ<d>مَن مَّ</>عَهُ<m>ۥ</> فِى <h>ٱ</>لْفُلْكِ وَجَعَلْ<m>نَٰ</>هُمْ خَ<o>لَٰٓ</>ئِفَ وَأَغْرَ<q>قْ</>نَا <h>ٱ</>لَّذِينَ كَذَّبُو<s>ا۟</> بِـَٔا<m>يَٰ</>تِنَا ۖ فَ<h>ٱ</><k>نظُ</>رْ كَيْفَ كَانَ <m>عَٰ</>قِبَةُ <h>ٱ</>لْمُ<k>نذَ</><p>رِي</>نَ"},{"n":74,"w":[["ثُمَّ","thumma","Then","এরপর"],["بَعَثْنَا","ba‘athnā","We sent","পাঠালাম আমরা"],["مِنۢ","min","after him","থেকে"],["بَعْدِهِۦ","ba‘dihi","after him","পর তার"],["رُسُلًا","rusulan","Messengers","রাসূলদেরকে"],["إِلَىٰ","ilā","to","প্রতি"],["قَوْمِهِمْ","qawmihim","their people","জাতির তাদের"],["فَجَآءُوهُم","fajāūhum","and they came to them","অতঃপর তারা কাছে এসেছিলো তাদের"],["بِٱلْبَيِّنَـٰتِ","bil-bayināti","with clear proofs","নিয়ে স্পষ্ট নিদর্শনাবলী"],["فَمَا","famā","But not","কিন্তু না"],["كَانُوا۟","kānū","they were","তারা ছিলো"],["لِيُؤْمِنُوا۟","liyu'minū","to believe","জন্যে (প্রস্তুত) ঈমান আনার"],["بِمَا","bimā","what","ঐ বিষয়ে যা"],["كَذَّبُوا۟","kadhabū","they had denied","তারা মিথ্যারোপ করেছিলো"],["بِهِۦ","bihi","[it]","উপর তার"],["مِن","min","before","থেকে"],["قَبْلُ ۚ","qablu","before","পূর্ব"],["كَذَٰلِكَ","kadhālika","Thus","এভাবে"],["نَطْبَعُ","naṭba‘u","We seal","সীল মেরে দিই আমরা"],["عَلَىٰ","‘alā","[on]","উপর"],["قُلُوبِ","qulūbi","the hearts","অন্তরসমূহের"],["ٱلْمُعْتَدِينَ","l-mu‘'tadīna","(of) the transgressors","সীমালঙ্ঘনকারীদের"]],"t":"ثُ<g>مَّ</> بَعَثْنَا <i>مِنۢ بَ</>عْدِ<m>هِۦ</> رُسُلًا إِلَىٰ قَوْمِهِمْ فَ<o>جَآ</>ءُو<f>هُم بِ</><h>ٱ</>لْبَيِّ<m>نَٰ</>تِ فَمَا كَانُو<s>ا۟</> لِيُؤْمِنُو<s>ا۟</> بِمَا كَذَّبُو<s>ا۟</> بِ<m>هِۦ</> مِ<k>ن قَ</><q>بْ</>لُ ۚ كَ<m>ذَٰ</>لِكَ نَ<q>طْ</>بَعُ عَلَىٰ قُلُوبِ <h>ٱ</>لْمُعْتَ<p>دِي</>نَ"},{"n":75,"w":[["ثُمَّ","thumma","Then","এরপর"],["بَعَثْنَا","ba‘athnā","We sent","পাঠিয়েছি আমরা"],["مِنۢ","min","after them","থেকে"],["بَعْدِهِم","ba‘dihim","after them","পর তাদের"],["مُّوسَىٰ","mūsā","Musa","মূসাকে"],["وَهَـٰرُونَ","wahārūna","and Harun","ও হারূনকে"],["إِلَىٰ","ilā","to","প্রতি"],["فِرْعَوْنَ","fir'‘awna","Firaun","ফিরাউনের"],["وَمَلَإِي۟هِۦ","wamala-ihi","and his chiefs","এবং তার পরিষদবর্গের (প্রতি)"],["بِـَٔايَـٰتِنَا","biāyātinā","with Our Signs","সহ আমাদের নিদর্শনাবলী"],["فَٱسْتَكْبَرُوا۟","fa-is'takbarū","but they were arrogant","কিন্তু তারা অহংকার করেছিলো"],["وَكَانُوا۟","wakānū","and were","এবং তারা ছিলো"],["قَوْمًۭا","qawman","a people","জাতি"],["مُّجْرِمِينَ","muj'rimīna","criminal","অপরাধী"]],"t":"ثُ<g>مَّ</> بَعَثْنَا <i>مِنۢ بَ</>عْدِ<y>هِم مُّ</>وسَىٰ وَ<m>هَٰ</>رُونَ إِلَىٰ فِرْعَوْنَ وَمَلَإِ<s>ي۟</><m>هِۦ</> بِـَٔا<m>يَٰ</>تِنَا فَ<h>ٱ</>سْتَكْبَرُو<s>ا۟</> وَكَانُو<s>ا۟</> قَوْ<d>مًۭا مُّ</><q>جْ</>رِ<p>مِي</>نَ"},{"n":76,"w":[["فَلَمَّا","falammā","So when","অতঃপর যখন"],["جَآءَهُمُ","jāahumu","came to them","কাছে আসলো তাদের"],["ٱلْحَقُّ","l-ḥaqu","the truth","প্রকৃত সত্য"],["مِنْ","min","from Us","হতে"],["عِندِنَا","‘indinā","from Us","নিকট আমাদের"],["قَالُوٓا۟","qālū","they said","তারা বললো"],["إِنَّ","inna","Indeed","\"নিশ্চয়ই"],["هَـٰذَا","hādhā","this","এটা"],["لَسِحْرٌۭ","lasiḥ'run","(is) surely, a magic","অবশ্যই জাদু"],["مُّبِينٌۭ","mubīnun","clear","সুস্পষ্ট\""]],"t":"فَلَ<g>مَّ</>ا <o>جَآ</>ءَهُمُ <h>ٱ</>لْحَقُّ مِنْ عِ<k>ندِ</>نَا قَا<o>لُوٓ</><s>ا۟</> إِ<g>نَّ</> <m>هَٰ</>ذَا لَسِحْ<d>رٌۭ مُّ</><p>بِي</>نٌۭ"},{"n":77,"w":[["قَالَ","qāla","Musa said","বললো"],["مُوسَىٰٓ","mūsā","Musa said","মূসা"],["أَتَقُولُونَ","ataqūlūna","Do you say","\"কি তোমরা বলছো"],["لِلْحَقِّ","lil'ḥaqqi","about the truth","সম্পর্কে সত্য (এরূপ কথা)"],["لَمَّا","lammā","when","যখন"],["جَآءَكُمْ ۖ","jāakum","it has come to you","তোমাদের কাছে (তা) এসেছে"],["أَسِحْرٌ","asiḥ'run","Is this magic","কি জাদু"],["هَـٰذَا","hādhā","Is this magic","এটা"],["وَلَا","walā","But (will) not","আর না"],["يُفْلِحُ","yuf'liḥu","succeed","সফলকাম হয়"],["ٱلسَّـٰحِرُونَ","l-sāḥirūna","the magicians","জাদুকররা\""]],"t":"قَالَ مُوسَ<o>ىٰٓ</> أَتَقُولُونَ لِلْحَقِّ لَ<g>مَّ</>ا <o>جَآ</>ءَكُمْ ۖ أَسِحْرٌ <m>هَٰ</>ذَا وَلَا يُفْلِحُ <h>ٱ</><l>ل</><m>سَّٰ</>حِ<p>رُو</>نَ"},{"n":78,"w":[["قَالُوٓا۟","qālū","They said","তারা বলেছিলো"],["أَجِئْتَنَا","aji'tanā","Have you come to us","\"কি আমাদের কাছে তুমি এসেছো"],["لِتَلْفِتَنَا","litalfitanā","to turn us away","যাতে তুমি আমাদেরকে সরিয়ে দিবে"],["عَمَّا","‘ammā","from that","তা হতে যা"],["وَجَدْنَا","wajadnā","we found","পেয়েছি আমরা"],["عَلَيْهِ","‘alayhi","on it","উপর তার"],["ءَابَآءَنَا","ābāanā","our forefathers","পূর্বপুরুষদেরকে আমাদের"],["وَتَكُونَ","watakūna","and you two (may) have","এবং হয় (যেন)"],["لَكُمَا","lakumā","and you two (may) have","জন্যে তোমাদের দু'জনের"],["ٱلْكِبْرِيَآءُ","l-kib'riyāu","the greatness","প্রতিপত্তি"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the land","দেশের"],["وَمَا","wamā","And we (are) not","এবং নই"],["نَحْنُ","naḥnu","And we (are) not","আমরা"],["لَكُمَا","lakumā","(in) you two","প্রতি তোমাদের দু'জনের"],["بِمُؤْمِنِينَ","bimu'minīna","believers","বিশ্বাসী\""]],"t":"قَا<o>لُوٓ</><s>ا۟</> أَجِئْتَنَا لِتَلْفِتَنَا عَ<g>مَّ</>ا وَجَ<q>دْ</>نَا عَلَيْهِ ءَا<o>بَآ</>ءَنَا وَتَكُونَ لَكُمَا <h>ٱ</>لْكِ<q>بْ</>رِ<o>يَآ</>ءُ فِى <h>ٱ</>لْأَرْضِ وَمَا نَحْنُ لَكُمَا بِمُؤْمِ<p>نِي</>نَ"},{"n":79,"w":[["وَقَالَ","waqāla","And Firaun said","এবং বললো"],["فِرْعَوْنُ","fir'‘awnu","And Firaun said","ফিরাউন"],["ٱئْتُونِى","i'tūnī","Bring to me","\"আমার কাছে আসো"],["بِكُلِّ","bikulli","every","নিয়ে প্রত্যেক"],["سَـٰحِرٍ","sāḥirin","magician","জাদুকরকে"],["عَلِيمٍۢ","‘alīmin","learned","সুদক্ষ\""]],"t":"وَقَالَ فِرْعَوْنُ <h>ٱ</>ئْتُونِى بِكُلِّ <m>سَٰ</>حِرٍ عَ<p>لِي</>مٍۢ"},{"n":80,"w":[["فَلَمَّا","falammā","So when","অতঃপর যখন"],["جَآءَ","jāa","came","আসলো"],["ٱلسَّحَرَةُ","l-saḥaratu","the magicians","জাদুকররা"],["قَالَ","qāla","said","বললো"],["لَهُم","lahum","to them","উদ্দেশ্যে তাদের"],["مُّوسَىٰٓ","mūsā","Musa","মূসা"],["أَلْقُوا۟","alqū","Throw","\"তোমরা নিক্ষেপ করো"],["مَآ","mā","whatever","যা"],["أَنتُم","antum","you","তোমরা"],["مُّلْقُونَ","mul'qūna","(wish to) throw","নিক্ষেপকারী\""]],"t":"فَلَ<g>مَّ</>ا <o>جَآ</>ءَ <h>ٱ</><l>ل</>سَّحَرَةُ قَالَ لَ<y>هُم مُّ</>وسَ<o>ىٰٓ</> أَلْقُو<s>ا۟</> <o>مَآ</> أَ<k>نتُ</><y>م مُّ</>لْ<p>قُو</>نَ"},{"n":81,"w":[["فَلَمَّآ","falammā","Then when","অতঃপর যখন"],["أَلْقَوْا۟","alqaw","they (had) thrown","তারা নিক্ষেপ করলো"],["قَالَ","qāla","Musa said","বললো"],["مُوسَىٰ","mūsā","Musa said","মূসা"],["مَا","mā","What","\"(ঐসব) যা"],["جِئْتُم","ji'tum","you have brought","তোমরা এসেছো"],["بِهِ","bihi","[it]","নিয়ে তা"],["ٱلسِّحْرُ ۖ","l-siḥ'ru","(is) the magic","জাদু"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["سَيُبْطِلُهُۥٓ ۖ","sayub'ṭiluhu","will nullify it","শীঘ্রই ব্যর্থ করে দিবেন তা"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَا","lā","(does) not","না"],["يُصْلِحُ","yuṣ'liḥu","amend","পরিশুদ্ধ করেন"],["عَمَلَ","‘amala","the work","কাজকে"],["ٱلْمُفْسِدِينَ","l-muf'sidīna","(of) the corrupters","বিপর্যয়সৃষ্টিকারীদের"]],"t":"فَلَ<g>مَّ</><o>آ</> أَلْقَوْ<s>ا۟</> قَالَ مُوسَىٰ مَا جِئْ<f>تُم بِ</>هِ <h>ٱ</><l>ل</>سِّحْرُ ۖ إِ<g>نَّ</> <h>ٱ</>للَّهَ سَيُ<q>بْ</>طِلُهُ<o>ۥٓ ۖ</> إِ<g>نَّ</> <h>ٱ</>للَّهَ لَا يُصْلِحُ عَمَلَ <h>ٱ</>لْمُفْسِ<p>دِي</>نَ"},{"n":82,"w":[["وَيُحِقُّ","wayuḥiqqu","And Allah will establish","এবং সত্যে পরিণত করবেন"],["ٱللَّهُ","l-lahu","And Allah will establish","আল্লাহ"],["ٱلْحَقَّ","l-ḥaqa","the truth","সত্যকে"],["بِكَلِمَـٰتِهِۦ","bikalimātihi","by His words","মাধ্যমে বাণীর তাঁর"],["وَلَوْ","walaw","even if","এবং যদিও"],["كَرِهَ","kariha","dislike it","অপছন্দ করে (তা)"],["ٱلْمُجْرِمُونَ","l-muj'rimūna","the criminals","অপরাধীরা\""]],"t":"وَيُحِقُّ <h>ٱ</>للَّهُ <h>ٱ</>لْحَقَّ بِكَلِ<m>مَٰتِهِۦ</> وَلَوْ كَرِهَ <h>ٱ</>لْمُ<q>جْ</>رِ<p>مُو</>نَ"},{"n":83,"w":[["فَمَآ","famā","But none","এরপরও না"],["ءَامَنَ","āmana","believed","ঈমান আনলো"],["لِمُوسَىٰٓ","limūsā","Musa","প্রতি মূসার (সেদেশের লোক)"],["إِلَّا","illā","except","এ ছাড়া"],["ذُرِّيَّةٌۭ","dhurriyyatun","(the) offspring","বংশধর (কিছু যুবক)"],["مِّن","min","among","মধ্য হতে"],["قَوْمِهِۦ","qawmihi","his people","জাতির তার"],["عَلَىٰ","‘alā","for","কারণে"],["خَوْفٍۢ","khawfin","fear","ভয়ের"],["مِّن","min","of","থেকে"],["فِرْعَوْنَ","fir'‘awna","Firaun","ফিরাউন"],["وَمَلَإِي۟هِمْ","wamala-ihim","and their chiefs","ও প্রধানদের তাদের"],["أَن","an","lest","যে"],["يَفْتِنَهُمْ ۚ","yaftinahum","they persecute them","সে নির্যাতন করবে তাদেরকে"],["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["فِرْعَوْنَ","fir'‘awna","Firaun","ফিরাউন  (ছিলো)"],["لَعَالٍۢ","la‘ālin","(was) a tyrant","অবশ্যই স্বেচ্ছাচারী"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","দেশের"],["وَإِنَّهُۥ","wa-innahu","and indeed, he","এবং নিশ্চয়ই সে"],["لَمِنَ","lamina","(was) of","অবশ্যই অন্তর্ভুক্ত"],["ٱلْمُسْرِفِينَ","l-mus'rifīna","the ones who commit excesses","সীমালঙ্ঘনকারীদের"]],"t":"فَ<o>مَآ</> ءَامَنَ لِمُوسَ<o>ىٰٓ</> إِلَّا ذُرِّيَّ<d>ةٌۭ مِّ</><k>ن قَ</>وْمِ<m>هِۦ</> عَلَىٰ خَوْ<d>فٍۢ مِّ</><k>ن فِ</>رْعَوْنَ وَمَلَإِ<s>ي۟</>هِمْ <d>أَن يَ</>فْتِنَهُمْ ۚ وَإِ<g>نَّ</> فِرْعَوْنَ لَعَا<k>لٍۢ فِ</>ى <h>ٱ</>لْأَرْضِ وَإِ<g>نَّ</>هُ<m>ۥ</> لَمِنَ <h>ٱ</>لْمُسْرِ<p>فِي</>نَ"},{"n":84,"w":[["وَقَالَ","waqāla","And Musa said","এবং বললো"],["مُوسَىٰ","mūsā","And Musa said","মূসা"],["يَـٰقَوْمِ","yāqawmi","O my people","\"হে আমার জাতি"],["إِن","in","If","যদি"],["كُنتُمْ","kuntum","you have","থাকো তোমরা"],["ءَامَنتُم","āmantum","believed","ঈমান এনে"],["بِٱللَّهِ","bil-lahi","in Allah","উপর আল্লাহর"],["فَعَلَيْهِ","fa‘alayhi","then on Him","তবে উপর তাঁরই"],["تَوَكَّلُوٓا۟","tawakkalū","put your trust","তোমরা নির্ভর করো"],["إِن","in","if","যদি"],["كُنتُم","kuntum","you are","হও তোমরা"],["مُّسْلِمِينَ","mus'limīna","Muslims","আত্মসমর্পণকারী (অর্থাৎ মুসলমান)\""]],"t":"وَقَالَ مُوسَىٰ <m>يَٰ</>قَوْمِ إِ<k>ن كُنتُ</>مْ ءَامَ<k>نتُ</><f>م بِ</><h>ٱ</>للَّهِ فَعَلَيْهِ تَوَكَّ<o>لُوٓ</><s>ا۟</> إِ<k>ن كُنتُ</><y>م مُّ</>سْلِ<p>مِي</>نَ"},{"n":85,"w":[["فَقَالُوا۟","faqālū","Then they said","অতঃপর তারা বললো"],["عَلَى","‘alā","Upon","\"উপর"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["تَوَكَّلْنَا","tawakkalnā","we put our trust","নির্ভর করেছি আমরা"],["رَبَّنَا","rabbanā","Our Lord","হে আমাদের রব"],["لَا","lā","(Do) not","না"],["تَجْعَلْنَا","taj‘alnā","make us","বানিয়ো আমাদের"],["فِتْنَةًۭ","fit'natan","a trial","উৎপীড়নের পাত্র"],["لِّلْقَوْمِ","lil'qawmi","for the people ","জন্যে জাতির"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","(যারা)সীমালঙ্ঘনকারী"]],"t":"فَقَالُو<s>ا۟</> عَلَى <h>ٱ</>للَّهِ تَوَكَّلْنَا رَبَّنَا لَا تَ<q>جْ</>عَلْنَا فِتْنَ<w>ةًۭ لِّ</>لْقَوْمِ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":86,"w":[["وَنَجِّنَا","wanajjinā","And save us","এবং রক্ষা করো আমাদেরকে"],["بِرَحْمَتِكَ","biraḥmatika","by Your Mercy","দ্বারা তোমার অনুগ্রহ"],["مِنَ","mina","from","হতে"],["ٱلْقَوْمِ","l-qawmi","the people ","জাতি"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","the disbelievers","(যারা) কাফির\""]],"t":"وَنَجِّنَا بِرَحْمَتِكَ مِنَ <h>ٱ</>لْقَوْمِ <h>ٱ</>لْ<m>كَٰ</>فِ<p>رِي</>نَ"},{"n":87,"w":[["وَأَوْحَيْنَآ","wa-awḥaynā","And We inspired","এবং ওহী করলাম আমরা"],["إِلَىٰ","ilā","to","প্রতি"],["مُوسَىٰ","mūsā","Musa","মূসার"],["وَأَخِيهِ","wa-akhīhi","and his brother","ও তার ভাইয়ের (প্রতি)"],["أَن","an","that","যে"],["تَبَوَّءَا","tabawwaā","Settle","\"দু'জনে স্থাপন করো"],["لِقَوْمِكُمَا","liqawmikumā","your people","জন্যে তোমাদের দু'জনের জাতির"],["بِمِصْرَ","bimiṣ'ra","in Egypt","মিশরে"],["بُيُوتًۭا","buyūtan","(in) houses","কিছু ঘর"],["وَٱجْعَلُوا۟","wa-ij'‘alū","and make","এবং তোমরা বানাও"],["بُيُوتَكُمْ","buyūtakum","your houses","ঘরগুলোকে তোমাদের"],["قِبْلَةًۭ","qib'latan","(as) places of worship","ক্বিবলা"],["وَأَقِيمُوا۟","wa-aqīmū","and establish","এবং তোমরা প্রতিষ্ঠা করো"],["ٱلصَّلَوٰةَ ۗ","l-ṣalata","the prayer","সালাত"],["وَبَشِّرِ","wabashiri","And give glad tidings","এবং সুসংবাদ দাও"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","(to) the believers","মু'মিনদেরকে\""]],"t":"وَأَوْحَيْ<o>نَآ</> إِلَىٰ مُوسَىٰ وَأَخِيهِ أَ<k>ن تَ</>بَوَّءَا لِقَوْمِكُمَا بِمِصْرَ بُيُو<d>تًۭا وَ</><h>ٱ</><q>جْ</>عَلُو<s>ا۟</> بُيُوتَكُمْ قِ<q>بْ</>لَ<d>ةًۭ وَ</>أَقِيمُو<s>ا۟</> <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةَ ۗ وَبَشِّرِ <h>ٱ</>لْمُؤْمِ<p>نِي</>نَ"},{"n":88,"w":[["وَقَالَ","waqāla","And Musa said","এবং বললো"],["مُوسَىٰ","mūsā","And Musa said","মূসা"],["رَبَّنَآ","rabbanā","Our Lord","\"হে আমাদের রব"],["إِنَّكَ","innaka","Indeed, You","নিশ্চয়ই তুমি"],["ءَاتَيْتَ","ātayta","have given","তুমি দিয়েছো"],["فِرْعَوْنَ","fir'‘awna","Firaun","ফিরাউনকে"],["وَمَلَأَهُۥ","wamala-ahu","and his chiefs","এবং পরিবারবর্গকে তার"],["زِينَةًۭ","zīnatan","splendor","শোভা"],["وَأَمْوَٰلًۭا","wa-amwālan","and wealth","ও ধনসম্পদ"],["فِى","fī","in","মধ্যে"],["ٱلْحَيَوٰةِ","l-ḥayati","the life","জীবনের"],["ٱلدُّنْيَا","l-dun'yā","(of) the world","পার্থিব"],["رَبَّنَا","rabbanā","Our Lord","হে আমাদের রব"],["لِيُضِلُّوا۟","liyuḍillū","That they may lead astray","জন্যে পথভ্রষ্ট করার(লোকদেরকে)"],["عَن","‘an","from","হতে"],["سَبِيلِكَ ۖ","sabīlika","Your way","তোমার পথ"],["رَبَّنَا","rabbanā","Our Lord","হে আমাদের রব"],["ٱطْمِسْ","iṭ'mis","Destroy","বিনষ্ট করো"],["عَلَىٰٓ","‘alā","[on]","ব্যাপারকে"],["أَمْوَٰلِهِمْ","amwālihim","their wealth","সম্পদগুলোর তাদের"],["وَٱشْدُدْ","wa-ush'dud","and harden","ও কঠোর করো (অর্থাৎ সীল করে দাও)"],["عَلَىٰ","‘alā","[on]","উপর"],["قُلُوبِهِمْ","qulūbihim","their hearts","অন্তরগুলোর তাদের"],["فَلَا","falā","so (that) not","ফলে যেন না"],["يُؤْمِنُوا۟","yu'minū","they believe","তারা ঈমান আনে"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["يَرَوُا۟","yarawū","they see","তারা দেখবে"],["ٱلْعَذَابَ","l-‘adhāba","the punishment ","শাস্তি"],["ٱلْأَلِيمَ","l-alīma","the painful","নিদারুণ\""]],"t":"وَقَالَ مُوسَىٰ رَبَّ<o>نَآ</> إِ<g>نَّ</>كَ ءَاتَيْتَ فِرْعَوْنَ وَمَلَأَهُ<m>ۥ</> زِينَ<d>ةًۭ وَ</>أَمْ<m>وَٰ</>لًۭ<k>ا فِ</>ى <h>ٱ</>لْحَيَ<s>وٰ</>ةِ <h>ٱ</><l>ل</>دُّنْيَا رَبَّنَا لِيُضِلُّو<s>ا۟</> عَ<k>ن سَ</>بِيلِكَ ۖ رَبَّنَا <h>ٱ</><q>طْ</>مِسْ عَلَ<o>ىٰٓ</> أَمْ<m>وَٰ</>لِهِمْ وَ<h>ٱ</>شْدُ<q>دْ</> عَلَىٰ قُلُوبِهِمْ فَلَا يُؤْمِنُو<s>ا۟</> حَتَّىٰ يَرَوُ<s>ا۟</> <h>ٱ</>لْعَذَابَ <h>ٱ</>لْأَ<p>لِي</>مَ"},{"n":89,"w":[["قَالَ","qāla","He said","তিনি (আল্লাহ)বললেন"],["قَدْ","qad","Verily","\"নিশ্চয়ই"],["أُجِيبَت","ujībat","has been answered","গৃহীত হলো"],["دَّعْوَتُكُمَا","da‘watukumā","(the) invocation of both of you","তোমাদের দু'জনের দু'আ"],["فَٱسْتَقِيمَا","fa-is'taqīmā","So you two (keep to the) straight way","অতএব দু'জন দৃঢ় থাকো"],["وَلَا","walā","And (do) not","এবং না"],["تَتَّبِعَآنِّ","tattabi‘ānni","follow","দু'জনে অনুসরণ করো"],["سَبِيلَ","sabīla","(the) way","পথ"],["ٱلَّذِينَ","alladhīna","(of) those who","(তাদের) যারা"],["لَا","lā","(do) not","না"],["يَعْلَمُونَ","ya‘lamūna","know","তারা জানে\""]],"t":"قَالَ قَ<q>دْ</> أُجِيبَ<j>ت</> دَّعْوَتُكُمَا فَ<h>ٱ</>سْتَقِيمَا وَلَا تَتَّبِ<n>عَآ</><g>نِّ</> سَبِيلَ <h>ٱ</>لَّذِينَ لَا يَعْلَ<p>مُو</>نَ"},{"n":90,"w":[["۞ وَجَـٰوَزْنَا","wajāwaznā","And We took across","এবং পার করালাম আমরা"],["بِبَنِىٓ","bibanī","(the) Children","সহ সন্তানদের"],["إِسْرَٰٓءِيلَ","is'rāīla","(of) Israel ","ইসরাঈলের"],["ٱلْبَحْرَ","l-baḥra","the sea","সাগর"],["فَأَتْبَعَهُمْ","fa-atba‘ahum","and followed them","অতঃপর পিছনে ধাওয়া করলো তাদের"],["فِرْعَوْنُ","fir'‘awnu","Firaun","ফিরাউন"],["وَجُنُودُهُۥ","wajunūduhu","and his hosts","ও সৈন্যবাহিনী তার"],["بَغْيًۭا","baghyan","(in) rebellion","সীমালঙ্ঘন"],["وَعَدْوًا ۖ","wa‘adwan","and enmity","এবং শত্রুতাবশতঃ"],["حَتَّىٰٓ","ḥattā","until","এমনকি"],["إِذَآ","idhā","when","যখন"],["أَدْرَكَهُ","adrakahu","overtook him","পেলো তাকে"],["ٱلْغَرَقُ","l-gharaqu","the drowning","ডুবে যাওয়া (অর্থাৎ সাগরে ডুবে যাচ্ছিলো)"],["قَالَ","qāla","he said","সে বললো"],["ءَامَنتُ","āmantu","I believe","\"আমি ঈমান আনলাম"],["أَنَّهُۥ","annahu","that","এই (বলে) যে"],["لَآ","lā","(there is) no","নেই"],["إِلَـٰهَ","ilāha","god","কোনো ইলাহ"],["إِلَّا","illā","except","(তিনি) ছাড়া"],["ٱلَّذِىٓ","alladhī","the One","যিনি (সেই সত্ত্বা)"],["ءَامَنَتْ","āmanat","in Whom believe","ঈমান এনেছে"],["بِهِۦ","bihi","in Whom believe","উপর তার"],["بَنُوٓا۟","banū","the Children of Israel","সন্তানরা"],["إِسْرَٰٓءِيلَ","is'rāīla","the Children of Israel","ইসরাঈলের"],["وَأَنَا۠","wa-anā","and I am","এবং আমি"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْمُسْلِمِينَ","l-mus'limīna","the Muslims","আত্মসমর্পনকারীদের (অর্থাৎ মুসলমানদের)\""]],"t":"۞ وَ<m>جَٰ</>وَزْنَا بِبَ<o>نِىٓ</> إِسْ<o>رَٰٓ</>ءِيلَ <h>ٱ</>لْبَحْرَ فَأَتْبَعَهُمْ فِرْعَوْنُ وَجُنُودُهُ<m>ۥ</> بَغْ<d>يًۭا وَ</>عَ<q>دْ</>وًا ۖ حَتَّ<o>ىٰٓ</> إِ<o>ذَآ</> أَ<q>دْ</>رَكَهُ <h>ٱ</>لْغَرَقُ قَالَ ءَامَ<k>نتُ</> أَ<g>نَّ</>هُ<m>ۥ</> <o>لَآ</> إِ<m>لَٰ</>هَ إِلَّا <h>ٱ</>لَّ<o>ذِىٓ</> ءَامَنَتْ بِ<m>هِۦ</> بَ<o>نُوٓ</><s>ا۟</> إِسْ<o>رَٰٓ</>ءِيلَ وَأَنَا۠ مِنَ <h>ٱ</>لْمُسْلِ<p>مِي</>نَ"},{"n":91,"w":[["ءَآلْـَٔـٰنَ","āl'āna","Now","\"কি এখন (ঈমান আনলে)"],["وَقَدْ","waqad","And verily","অথচ নিশ্চয়ই"],["عَصَيْتَ","‘aṣayta","you (had) disobeyed","তুমি অমান্য করেছো"],["قَبْلُ","qablu","before","পূর্বে"],["وَكُنتَ","wakunta","and you were","এবং তুমি ছিলে"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْمُفْسِدِينَ","l-muf'sidīna","the corrupters","বিপর্যয়কারীদের\""]],"t":"ءَ<n>آ</><m>لْـَٰٔ</>نَ وَقَ<q>دْ</> عَصَيْتَ قَ<q>بْ</>لُ وَكُ<k>نتَ</> مِنَ <h>ٱ</>لْمُفْسِ<p>دِي</>نَ"},{"n":92,"w":[["فَٱلْيَوْمَ","fal-yawma","So today","সুতরাং আজ"],["نُنَجِّيكَ","nunajjīka","We will save you","তোমাকে আমরা রক্ষা করবো"],["بِبَدَنِكَ","bibadanika","in your body","দ্বারা তোমার শরীর (অর্থাৎ তোমার লাশকে)"],["لِتَكُونَ","litakūna","that you may be","যেন তুমি হও"],["لِمَنْ","liman","for (those) who","(তাদের) জন্যে যারা"],["خَلْفَكَ","khalfaka","succeed you","তোমার পরবর্তীতে (আসবে)"],["ءَايَةًۭ ۚ","āyatan","a sign","একটি নিদর্শন"],["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["كَثِيرًۭا","kathīran","many","অনেকে"],["مِّنَ","mina","among","মধ্য হতে"],["ٱلنَّاسِ","l-nāsi","the mankind","মানুষের"],["عَنْ","‘an","of","সম্বন্ধে"],["ءَايَـٰتِنَا","āyātinā","Our Signs","নিদর্শনাবলী আমাদের"],["لَغَـٰفِلُونَ","laghāfilūna","(are) surely heedless","অবশ্যই উদাসীন\""]],"t":"فَ<h>ٱ</>لْيَوْمَ نُنَجِّيكَ بِبَدَنِكَ لِتَكُونَ لِمَنْ خَلْفَكَ ءَايَ<d>ةًۭ ۚ وَ</>إِ<g>نَّ</> كَثِي<d>رًۭا مِّ</>نَ <h>ٱ</><l>ل</><g>نَّ</>اسِ عَنْ ءَا<m>يَٰ</>تِنَا لَ<m>غَٰ</>فِ<p>لُو</>نَ"},{"n":93,"w":[["وَلَقَدْ","walaqad","And verily","এবং নিশ্চয়ই"],["بَوَّأْنَا","bawwanā","We settled","আমরা বসবাস করিয়েছি"],["بَنِىٓ","banī","(the) Children","সন্তানদেরকে"],["إِسْرَٰٓءِيلَ","is'rāīla","(of) Israel","ইসরাঈলের"],["مُبَوَّأَ","mubawwa-a","(in) a settlement","আবাসভূমিতে"],["صِدْقٍۢ","ṣid'qin","honorable","উত্তম"],["وَرَزَقْنَـٰهُم","warazaqnāhum","and We provided them","ও জীবিকা দিয়েছি আমরা তাদের"],["مِّنَ","mina","with","থেকে"],["ٱلطَّيِّبَـٰتِ","l-ṭayibāti","the good things","পবিত্র জিনিসগুলো"],["فَمَا","famā","and not","অতঃপর না"],["ٱخْتَلَفُوا۟","ikh'talafū","they differ","তারা বিভেদ করেছে"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["جَآءَهُمُ","jāahumu","came to them","কাছে এসেছে তাদের"],["ٱلْعِلْمُ ۚ","l-‘il'mu","the knowledge","(সত্যিকার) জ্ঞান"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["رَبَّكَ","rabbaka","your Lord","তোমার রব"],["يَقْضِى","yaqḍī","will judge","মীমাংসা করে দিবেন"],["بَيْنَهُمْ","baynahum","between them","মাঝে তাদের"],["يَوْمَ","yawma","(on) the Day","দিনে"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) the Resurrection","ক্বিয়ামাতের"],["فِيمَا","fīmā","concerning what","সে বিষয়ে যা"],["كَانُوا۟","kānū","they used (to)","তারা ছিলো"],["فِيهِ","fīhi","[in it]","মধ্যে তার"],["يَخْتَلِفُونَ","yakhtalifūna","differ","বিভেদ করতো"]],"t":"وَلَقَ<q>دْ</> بَوَّأْنَا بَ<o>نِىٓ</> إِسْ<o>رَٰٓ</>ءِيلَ مُبَوَّأَ صِ<q>دْ</><d>قٍۢ وَ</>رَزَ<q>قْ</><m>نَٰ</><y>هُم مِّ</>نَ <h>ٱ</><l>ل</>طَّيِّ<m>بَٰ</>تِ فَمَا <h>ٱ</>خْتَلَفُو<s>ا۟</> حَتَّىٰ <o>جَآ</>ءَهُمُ <h>ٱ</>لْعِلْمُ ۚ إِ<g>نَّ</> رَبَّكَ يَ<q>قْ</>ضِى بَيْنَهُمْ يَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ فِيمَا كَانُو<s>ا۟</> فِيهِ يَخْتَلِ<p>فُو</>نَ"},{"n":94,"w":[["فَإِن","fa-in","So if","অতঃপর যদি"],["كُنتَ","kunta","you are","হও তুমি"],["فِى","fī","in","মধ্যে"],["شَكٍّۢ","shakkin","doubt","সন্দেহের"],["مِّمَّآ","mimmā","of what","তা হতে যা"],["أَنزَلْنَآ","anzalnā","We have revealed","আমরা অবতীর্ণ করেছি"],["إِلَيْكَ","ilayka","to you","প্রতি তোমার"],["فَسْـَٔلِ","fasali","then ask","তবে জিজ্ঞাসা করো"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["يَقْرَءُونَ","yaqraūna","(have been) reading","পাঠ করে"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","কিতাব"],["مِن","min","before you","থেকে"],["قَبْلِكَ ۚ","qablika","before you","পূর্ব তোমার"],["لَقَدْ","laqad","Verily","নিশ্চয়ই"],["جَآءَكَ","jāaka","has come to you","কাছে এসেছে তোমার"],["ٱلْحَقُّ","l-ḥaqu","the truth","(প্রকৃত) সত্য"],["مِن","min","from","পক্ষ হতে"],["رَّبِّكَ","rabbika","your Lord","তোমার রবের"],["فَلَا","falā","so (do) not","অতএব না"],["تَكُونَنَّ","takūnanna","be","তুমি হয়ো"],["مِنَ","mina","among","অন্তর্ভুক্ত"],["ٱلْمُمْتَرِينَ","l-mum'tarīna","the doubters","সন্দিহানদের"]],"t":"فَإِ<k>ن كُنتَ</> فِى شَ<d>كٍّۢ مِّ</><g>مَّ</><o>آ</> أَ<k>نزَ</>لْ<o>نَآ</> إِلَيْكَ فَسْـَٔلِ <h>ٱ</>لَّذِينَ يَ<q>قْ</>رَءُونَ <h>ٱ</>لْكِ<m>تَٰ</>بَ مِ<k>ن قَ</><q>بْ</>لِكَ ۚ لَقَ<q>دْ</> <o>جَآ</>ءَكَ <h>ٱ</>لْحَقُّ <w>مِن رَّ</>بِّكَ فَلَا تَكُونَ<g>نَّ</> مِنَ <h>ٱ</>لْمُمْتَ<p>رِي</>نَ"},{"n":95,"w":[["وَلَا","walā","And (do) not","এবং না"],["تَكُونَنَّ","takūnanna","be","তুমি হয়ো"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["كَذَّبُوا۟","kadhabū","deny","মিথ্যারোপ করেছে"],["بِـَٔايَـٰتِ","biāyāti","(the) Signs of Allah","প্রতি নিদর্শনগুলোর"],["ٱللَّهِ","l-lahi","(the) Signs of Allah","আল্লাহর"],["فَتَكُونَ","fatakūna","then you will be","তাহ'লে  তুমি হবে"],["مِنَ","mina","among","অন্তর্ভুক্ত"],["ٱلْخَـٰسِرِينَ","l-khāsirīna","the losers","ক্ষতিগ্রস্তদের"]],"t":"وَلَا تَكُونَ<g>نَّ</> مِنَ <h>ٱ</>لَّذِينَ كَذَّبُو<s>ا۟</> بِـَٔا<m>يَٰ</>تِ <h>ٱ</>للَّهِ فَتَكُونَ مِنَ <h>ٱ</>لْ<m>خَٰ</>سِ<p>رِي</>نَ"},{"n":96,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those [whom]","যারা"],["حَقَّتْ","ḥaqqat","has become due","সত্য প্রমাণিত হয়েছে"],["عَلَيْهِمْ","‘alayhim","on them","উপর তাদের"],["كَلِمَتُ","kalimatu","(the) Word","বাণী"],["رَبِّكَ","rabbika","(of) your Lord","তোমার রবের"],["لَا","lā","will not","না"],["يُؤْمِنُونَ","yu'minūna","believe","তারা ঈমান আনবে"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ حَقَّتْ عَلَيْهِمْ كَلِمَتُ رَبِّكَ لَا يُؤْمِ<p>نُو</>نَ"},{"n":97,"w":[["وَلَوْ","walaw","Even if","এবং যদি"],["جَآءَتْهُمْ","jāathum","comes to them","কাছে আসে তাদের"],["كُلُّ","kullu","every","সব"],["ءَايَةٍ","āyatin","Sign","নিদর্শন"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["يَرَوُا۟","yarawū","they see","তারা দেখবে"],["ٱلْعَذَابَ","l-‘adhāba","the punishment ","শাস্তি"],["ٱلْأَلِيمَ","l-alīma","the painful","নিদারুণ"]],"t":"وَلَوْ <o>جَآ</>ءَتْهُمْ كُلُّ ءَايَةٍ حَتَّىٰ يَرَوُ<s>ا۟</> <h>ٱ</>لْعَذَابَ <h>ٱ</>لْأَ<p>لِي</>مَ"},{"n":98,"w":[["فَلَوْلَا","falawlā","So why not","অতঃপর কেন না"],["كَانَتْ","kānat","was","(এমন) হলো যে"],["قَرْيَةٌ","qaryatun","any town","জনপদবাসী"],["ءَامَنَتْ","āmanat","that believed","(শাস্তি আসার পূর্বেই) ঈমান আনতো"],["فَنَفَعَهَآ","fanafa‘ahā","and benefited it","তাহ'লে উপকারে আসতো তার"],["إِيمَـٰنُهَآ","īmānuhā","its faith","তার ঈমান (আনা)"],["إِلَّا","illā","except","তবে (ব্যতিক্রম)"],["قَوْمَ","qawma","the people","জাতি"],["يُونُسَ","yūnusa","(of) Yunus","ইউনুসের"],["لَمَّآ","lammā","When","যখন (শাস্তি দেখে)"],["ءَامَنُوا۟","āmanū","they believed","তারা ঈমান এনেছিলো"],["كَشَفْنَا","kashafnā","We removed","সরিয়ে দিয়েছি আমরা"],["عَنْهُمْ","‘anhum","from them","থেকে তাদের"],["عَذَابَ","‘adhāba","(the) punishment","শাস্তি"],["ٱلْخِزْىِ","l-khiz'yi","(of) the disgrace","অপমানজনক"],["فِى","fī","in","মধ্যে"],["ٱلْحَيَوٰةِ","l-ḥayati","the life","জীবনের"],["ٱلدُّنْيَا","l-dun'yā","of the world","পার্থিব"],["وَمَتَّعْنَـٰهُمْ","wamatta‘nāhum","and We granted them enjoyment","ও ভোগের সুযোগ দিয়েছি আমরা তাদেরকে"],["إِلَىٰ","ilā","for","পর্যন্ত"],["حِينٍۢ","ḥīnin","a time","এক নির্দিষ্ট সময়"]],"t":"فَلَوْلَا كَانَتْ قَرْيَةٌ ءَامَنَتْ فَنَفَعَ<o>هَآ</> إِي<m>مَٰ</>نُ<o>هَآ</> إِلَّا قَوْمَ يُونُسَ لَ<g>مَّ</><o>آ</> ءَامَنُو<s>ا۟</> كَشَفْنَا عَنْهُمْ عَذَابَ <h>ٱ</>لْخِزْىِ فِى <h>ٱ</>لْحَيَ<s>وٰ</>ةِ <h>ٱ</><l>ل</>دُّنْيَا وَمَتَّعْ<m>نَٰ</>هُمْ إِلَىٰ <p>حِي</>نٍۢ"},{"n":99,"w":[["وَلَوْ","walaw","And if","এবং যদি"],["شَآءَ","shāa","(had) willed","ইচ্ছে করতেন"],["رَبُّكَ","rabbuka","your Lord","রব তোমার"],["لَـَٔامَنَ","laāmana","surely, (would) have believed","অবশ্যই ঈমান আনতো"],["مَن","man","who","যারা"],["فِى","fī","(are) in","মধ্যে (আছে)"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["كُلُّهُمْ","kulluhum","all of them","সবাই তাদের"],["جَمِيعًا ۚ","jamī‘an","together","একসাথে"],["أَفَأَنتَ","afa-anta","Then, will you","কি তবে তুমি"],["تُكْرِهُ","tuk'rihu","compel","জবরদস্তি করবে"],["ٱلنَّاسَ","l-nāsa","the mankind","মানুষদেরকে"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["يَكُونُوا۟","yakūnū","they become","তারা হবে"],["مُؤْمِنِينَ","mu'minīna","believers","মু'মিন"]],"t":"وَلَوْ <o>شَآ</>ءَ رَبُّكَ لَءَامَنَ مَ<k>ن فِ</>ى <h>ٱ</>لْأَرْضِ كُلُّهُمْ جَمِيعًا ۚ أَفَأَ<k>نتَ</> تُكْرِهُ <h>ٱ</><l>ل</><g>نَّ</>اسَ حَتَّىٰ يَكُونُو<s>ا۟</> مُؤْمِ<p>نِي</>نَ"},{"n":100,"w":[["وَمَا","wamā","And not","এবং নয়"],["كَانَ","kāna","is","সম্ভব"],["لِنَفْسٍ","linafsin","for a soul","জন্যে কোনো ব্যক্তির"],["أَن","an","to","যে"],["تُؤْمِنَ","tu'mina","believe","সে ঈমান আনবে"],["إِلَّا","illā","except","ছাড়া"],["بِإِذْنِ","bi-idh'ni","by (the) permission","নিয়ে অনুমতি"],["ٱللَّهِ ۚ","l-lahi","(of) Allah","আল্লাহর"],["وَيَجْعَلُ","wayaj‘alu","And He will place","এবং তিনি রাখবেন"],["ٱلرِّجْسَ","l-rij'sa","the wrath","অপবিত্রতা"],["عَلَى","‘alā","on","উপর"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["لَا","lā","(do) not","না"],["يَعْقِلُونَ","ya‘qilūna","use reason","বুঝতে পারে"]],"t":"وَمَا كَانَ لِنَفْسٍ أَ<k>ن تُ</>ؤْمِنَ إِلَّا بِإِذْنِ <h>ٱ</>للَّهِ ۚ وَيَ<q>جْ</>عَلُ <h>ٱ</><l>ل</>رِّ<q>جْ</>سَ عَلَى <h>ٱ</>لَّذِينَ لَا يَعْقِ<p>لُو</>نَ"},{"n":101,"w":[["قُلِ","quli","Say","(তুমি) বলো"],["ٱنظُرُوا۟","unẓurū","See","\"তোমরা লক্ষ্য করো"],["مَاذَا","mādhā","what","কি"],["فِى","fī","(is) in","মধ্যে (আছে)"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশসমূহের"],["وَٱلْأَرْضِ ۚ","wal-arḍi","and the earth","এবং পৃথিবীর\""],["وَمَا","wamā","But not","এবং না"],["تُغْنِى","tugh'nī","will avail","উপকারে আসে"],["ٱلْـَٔايَـٰتُ","l-āyātu","the Signs","নিদর্শনসমূহ"],["وَٱلنُّذُرُ","wal-nudhuru","and the warners","আর (না) সতর্কীকরণ"],["عَن","‘an","to","জন্যে"],["قَوْمٍۢ","qawmin","a people","(সেই) জাতির"],["لَّا","lā","(who do) not","না"],["يُؤْمِنُونَ","yu'minūna","believe","(যারা) ঈমান আনে"]],"t":"قُلِ <h>ٱ</><k>نظُ</>رُو<s>ا۟</> مَاذَا فِى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ ۚ وَمَا تُغْنِى <h>ٱ</>لْءَا<m>يَٰ</>تُ وَ<h>ٱ</><l>ل</><g>نُّ</>ذُرُ عَ<k>ن قَ</>وْ<w>مٍۢ لَّ</>ا يُؤْمِ<p>نُو</>نَ"},{"n":102,"w":[["فَهَلْ","fahal","Then do","তবে কি"],["يَنتَظِرُونَ","yantaẓirūna","they wait","তারা অপেক্ষা করছে"],["إِلَّا","illā","except","এ ছাড়া"],["مِثْلَ","mith'la","like","অনুরূপ (খারাপ)"],["أَيَّامِ","ayyāmi","the days","দিনগুলোর"],["ٱلَّذِينَ","alladhīna","(of) those who","(তাদের) যারা"],["خَلَوْا۟","khalaw","passed away","অতিবাহিত হয়েছে"],["مِن","min","before them","থেকে"],["قَبْلِهِمْ ۚ","qablihim","before them","পূর্ব তাদের"],["قُلْ","qul","Say","বলো"],["فَٱنتَظِرُوٓا۟","fa-intaẓirū","Then wait","\"তবে তোমরা অপেক্ষা করো"],["إِنِّى","innī","indeed, I (am)","নিশ্চয়ই আমি"],["مَعَكُم","ma‘akum","with you","সাথে তোমাদের"],["مِّنَ","mina","among","অন্তর্ভুক্ত"],["ٱلْمُنتَظِرِينَ","l-muntaẓirīna","the ones who wait","অপেক্ষাকারীদের\""]],"t":"فَهَلْ يَ<k>نتَ</>ظِرُونَ إِلَّا مِثْلَ أَيَّامِ <h>ٱ</>لَّذِينَ خَلَوْ<s>ا۟</> مِ<k>ن قَ</><q>بْ</>لِهِمْ ۚ قُلْ فَ<h>ٱ</><k>نتَ</>ظِ<o>رُوٓ</><s>ا۟</> إِ<g>نِّ</>ى مَعَ<y>كُم مِّ</>نَ <h>ٱ</>لْمُ<k>نتَ</>ظِ<p>رِي</>نَ"},{"n":103,"w":[["ثُمَّ","thumma","Then","এরপর"],["نُنَجِّى","nunajjī","We will save","উদ্বার করবো আমরা"],["رُسُلَنَا","rusulanā","Our Messengers","রাসূলদেরকে আমাদের"],["وَٱلَّذِينَ","wa-alladhīna","and those who","ও যারা"],["ءَامَنُوا۟ ۚ","āmanū","believe","ঈমান এনেছিলো (তাদের সাথে)"],["كَذَٰلِكَ","kadhālika","Thus","এভাবে"],["حَقًّا","ḥaqqan","(it is) an obligation","(এটা) দায়িত্ব"],["عَلَيْنَا","‘alaynā","upon Us","উপর আমাদের"],["نُنجِ","nunji","(that) We save","উদ্ধার করা"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believers","মু'মিনদেরকে"]],"t":"ثُ<g>مَّ</> نُنَجِّى رُسُلَنَا وَ<h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟ ۚ</> كَ<m>ذَٰ</>لِكَ حَقًّا عَلَيْنَا نُ<k>نجِ</> <h>ٱ</>لْمُؤْمِ<p>نِي</>نَ"},{"n":104,"w":[["قُلْ","qul","Say","বলো"],["يَـٰٓأَيُّهَا","yāayyuhā","O mankind","\"হে"],["ٱلنَّاسُ","l-nāsu","O mankind","\"মানুষ"],["إِن","in","If","যদি"],["كُنتُمْ","kuntum","you are","তোমরা হয়ে থাকো"],["فِى","fī","in","মধ্যে"],["شَكٍّۢ","shakkin","doubt","সন্দেহের"],["مِّن","min","of","সম্পর্কে"],["دِينِى","dīnī","my religion","আমার দীন"],["فَلَآ","falā","then not","তবে (জেনে রাখো) না"],["أَعْبُدُ","a‘budu","I worship","আমি ইবাদত করি"],["ٱلَّذِينَ","alladhīna","those whom","(তাদেরকে) যাদের"],["تَعْبُدُونَ","ta‘budūna","you worship","তোমরা উপাসনা করো"],["مِن","min","besides Allah","দিয়ে"],["دُونِ","dūni","besides Allah","বাদ"],["ٱللَّهِ","l-lahi","besides Allah","আল্লাহর"],["وَلَـٰكِنْ","walākin","but","বরং"],["أَعْبُدُ","a‘budu","I worship","আমি ইবাদাত করি"],["ٱللَّهَ","l-laha","Allah","আল্লাহরই"],["ٱلَّذِى","alladhī","the One Who","যিনি"],["يَتَوَفَّىٰكُمْ ۖ","yatawaffākum","causes you to die","মৃত্যু ঘটান তোমাদের"],["وَأُمِرْتُ","wa-umir'tu","And I am commanded","এবং আমি আদিষ্ট হয়েছি"],["أَنْ","an","that","যে"],["أَكُونَ","akūna","I be","(যেন) আমি হই"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believers","মু'মিনদের\""]],"t":"قُلْ <o>يَٰٓ</>أَيُّهَا <h>ٱ</><l>ل</><g>نَّ</>اسُ إِ<k>ن كُنتُ</>مْ فِى شَ<d>كٍّۢ مِّ</><k>ن دِ</>ينِى فَ<o>لَآ</> أَعْبُدُ <h>ٱ</>لَّذِينَ تَعْبُدُونَ مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ وَ<m>لَٰ</>كِنْ أَعْبُدُ <h>ٱ</>للَّهَ <h>ٱ</>لَّذِى يَتَوَفَّ<m>ىٰ</>كُمْ ۖ وَأُمِرْتُ أَنْ أَكُونَ مِنَ <h>ٱ</>لْمُؤْمِ<p>نِي</>نَ"},{"n":105,"w":[["وَأَنْ","wa-an","And that","এবং (এও) যে"],["أَقِمْ","aqim","Direct","\"প্রতিষ্ঠিত করো"],["وَجْهَكَ","wajhaka","your face","চেহারাকে তোমার (লক্ষ্যকে)"],["لِلدِّينِ","lilddīni","to the religion","জন্যে দীনের"],["حَنِيفًۭا","ḥanīfan","upright","একনিষ্ঠভাবে"],["وَلَا","walā","and (do) not","এবং না"],["تَكُونَنَّ","takūnanna","be","তোমরা হয়ো"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْمُشْرِكِينَ","l-mush'rikīna","the polytheists","মুশরিকদের"]],"t":"وَأَنْ أَقِمْ وَ<q>جْ</>هَكَ لِلدِّينِ حَنِي<d>فًۭا وَ</>لَا تَكُونَ<g>نَّ</> مِنَ <h>ٱ</>لْمُشْرِ<p>كِي</>نَ"},{"n":106,"w":[["وَلَا","walā","And (do) not","এবং না"],["تَدْعُ","tad‘u","invoke","তুমি ডেকো (অন্য কাউকে)"],["مِن","min","besides Allah","দিয়ে"],["دُونِ","dūni","besides Allah","বাদ"],["ٱللَّهِ","l-lahi","besides Allah","আল্লাহ"],["مَا","mā","what","যা"],["لَا","lā","(will) not","না"],["يَنفَعُكَ","yanfa‘uka","benefit you","তোমার উপকার করতে পারে"],["وَلَا","walā","and not","আর না"],["يَضُرُّكَ ۖ","yaḍurruka","harm you","তোমার অপকার করতে পারে"],["فَإِن","fa-in","But if","অতঃপর যদি"],["فَعَلْتَ","fa‘alta","you did so","তুমি করো (তা)"],["فَإِنَّكَ","fa-innaka","indeed, you","তবে নিশ্চয়ই তুমি"],["إِذًۭا","idhan","then (will be)","তখন"],["مِّنَ","mina","of","অন্তর্ভুক্ত হবে"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","সীমালঙ্ঘনকারীদের\""]],"t":"وَلَا تَ<q>دْ</>عُ مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ مَا لَا يَ<k>نفَ</>عُكَ وَلَا يَضُرُّكَ ۖ فَإِ<k>ن فَ</>عَلْتَ فَإِ<g>نَّ</>كَ إِ<d>ذًۭا مِّ</>نَ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":107,"w":[["وَإِن","wa-in","And if","এবং যদি"],["يَمْسَسْكَ","yamsaska","Allah touches you","তোমাকে স্পর্শ করেন"],["ٱللَّهُ","l-lahu","Allah touches you","আল্লাহ"],["بِضُرٍّۢ","biḍurrin","with adversity","দিয়ে কষ্ট"],["فَلَا","falā","(there is) no","তবে নেই"],["كَاشِفَ","kāshifa","remover","মোচনকারী"],["لَهُۥٓ","lahu","of it","জন্যে তার"],["إِلَّا","illā","except","এ ছাড়া"],["هُوَ ۖ","huwa","Him","তিনিই"],["وَإِن","wa-in","and if","এবং যদি (আল্লাহ)"],["يُرِدْكَ","yurid'ka","He intends for you","তোমার জন্যে চান"],["بِخَيْرٍۢ","bikhayrin","any good","বিষয় কল্যাণের"],["فَلَا","falā","then (there is) no","তবে নেই"],["رَآدَّ","rādda","repeller","কোনো রদকারী"],["لِفَضْلِهِۦ ۚ","lifaḍlihi","(of) His Bounty","জন্যে অনুগ্রহের তাঁর"],["يُصِيبُ","yuṣību","He causes it to reach","তিনি পৌঁছান"],["بِهِۦ","bihi","He causes it to reach","সহ তা"],["مَن","man","whom","যাকে"],["يَشَآءُ","yashāu","He wills","তিনি ইচ্ছে 