","বানিয়েছেন"],["لَكُمُ","lakumu","for you","জন্যে তোমাদের"],["ٱلَّيْلَ","al-layla","the night","রাতকে"],["لِتَسْكُنُوا۟","litaskunū","that you may rest","যেন তোমরা বিশ্রাম নাও"],["فِيهِ","fīhi","in it","মধ্যে তার"],["وَٱلنَّهَارَ","wal-nahāra","and the day","এবং দিনকে (বানিয়েছেন)"],["مُبْصِرًا ۚ","mub'ṣiran","giving visibility","দেখার জন্যে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে (রয়েছে)"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَـٰتٍۢ","laāyātin","surely (are) Signs","অবশ্যই নিদর্শনাবলী"],["لِّقَوْمٍۢ","liqawmin","for a people","জন্যে সম্প্রদায়ের"],["يَسْمَعُونَ","yasma‘ūna","(who) listen","(যারা উন্মুক্ত কানে) শোনে"]],"t":"هُوَ <h>ٱ</>لَّذِى جَعَلَ لَكُمُ <h>ٱ</>لَّيْلَ لِتَسْكُنُو<s>ا۟</> فِيهِ وَ<h>ٱ</><l>ل</><g>نَّ</>هَارَ مُ<q>بْ</>صِرًا ۚ إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَا<m>يَٰ</><w>تٍۢ لِّ</>قَوْ<d>مٍۢ يَ</>سْمَ<p>عُو</>نَ"},{"n":68,"w":[["قَالُوا۟","qālū","They say","তারা বলে"],["ٱتَّخَذَ","ittakhadha","Allah has taken","\"গ্রহণ করেছেন"],["ٱللَّهُ","l-lahu","Allah has taken","\"আল্লাহ"],["وَلَدًۭا ۗ","waladan","a son","সন্তান\""],["سُبْحَـٰنَهُۥ ۖ","sub'ḥānahu","Glory be to Him","(প্রকৃতপক্ষে)পবিত্র তিনি"],["هُوَ","huwa","He","তিনি"],["ٱلْغَنِىُّ ۖ","l-ghaniyu","(is) the Self-sufficient","অভাবমুক্ত"],["لَهُۥ","lahu","To Him (belongs)","জন্যে তাঁরই"],["مَا","mā","whatever","যা কিছু"],["فِى","fī","(is) in","মধ্যে (আছে)"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশের"],["وَمَا","wamā","and whatever","এবং যা কিছু"],["فِى","fī","(is) in","মধ্যে (আছে)"],["ٱلْأَرْضِ ۚ","l-arḍi","the earth","পৃথিবীর"],["إِنْ","in","Not","নেই"],["عِندَكُم","‘indakum","you have","কাছে তোমাদের"],["مِّن","min","any","কোনো"],["سُلْطَـٰنٍۭ","sul'ṭānin","authority","প্রমাণ"],["بِهَـٰذَآ ۚ","bihādhā","for this","সম্বন্ধে এই(তোমাদের দাবীর)"],["أَتَقُولُونَ","ataqūlūna","Do you say","কি তোমরা বলছো"],["عَلَى","‘alā","about","উপর"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["مَا","mā","what","যা"],["لَا","lā","not","না"],["تَعْلَمُونَ","ta‘lamūna","you know","ত