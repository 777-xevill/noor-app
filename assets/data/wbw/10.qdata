"kāna","is","হওয়ার"],["هَـٰذَا","hādhā","this","এই"],["ٱلْقُرْءَانُ","l-qur'ānu","the Quran","কুর'আন"],["أَن","an","that","(এমন) যে"],["يُفْتَرَىٰ","yuf'tarā","(it could be) produced","রচনা করা যেতে পারে"],["مِن","min","by","দিয়ে"],["دُونِ","dūni","other than Allah","বাদ"],["ٱللَّهِ","l-lahi","other than Allah","আল্লাহ"],["وَلَـٰكِن","walākin","but","বরং (এটা)"],["تَصْدِيقَ","taṣdīqa","(it is) a confirmation","সত্যায়ন"],["ٱلَّذِى","alladhī","(of that) which","(তার) যা"],["بَيْنَ","bayna","(was) before it","মাঝে"],["يَدَيْهِ","yadayhi","(was) before it","হাতের তার"],["وَتَفْصِيلَ","watafṣīla","and a detailed explanation","ও বিস্তারিত বর্ণনা"],["ٱلْكِتَـٰبِ","l-kitābi","(of) the Book","সেই কিতাবের"],["لَا","lā","(there is) no","নেই"],["رَيْبَ","rayba","doubt","কোনো সন্দেহ"],["فِيهِ","fīhi","in it","মধ্যে তার(যে এটা)"],["مِن","min","from","(এসেছে) পক্ষ হতে"],["رَّبِّ","rabbi","(the) Lord","রবের"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","(of) the worlds","বিশ্বজগতের"]],"t":"وَمَا كَانَ <m>هَٰ</>ذَا <h>ٱ</>لْقُرْءَانُ <d>أَن يُ</>فْتَرَىٰ مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ وَ<m>لَٰ</>كِ<k>ن تَ</>صْدِيقَ <h>ٱ</>لَّذِى بَيْنَ يَدَيْهِ وَتَفْصِيلَ <h>ٱ</>لْكِ<m>تَٰ</>بِ لَا رَيْبَ فِيهِ <w>مِن رَّ</>بِّ <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":38,"w":[["أَمْ","am","Or","অথবা কি"],["يَقُولُونَ","yaqūlūna","(do) they say","তারা বলে"],["ٱفْتَرَىٰهُ ۖ","if'tarāhu","He has invented it","\"সে রচনা করেছে তা\""],["قُلْ","qul","Say","(হে নাবী) বলো"],["فَأْتُوا۟","fatū","Then bring","\"তা হলে তোমরা আসো"],["بِسُورَةٍۢ","bisūratin","a Surah","নিয়ে একটি সূরাহ (রচনা করে)"],["مِّثْلِهِۦ","mith'lihi","like it","মতো তার"],["وَٱدْعُوا۟","wa-id'‘ū","and call","এবং তোমরা ডাকো"],["مَنِ","mani","whoever","যাকে"],["ٱسْتَطَعْتُم","is'taṭa‘tum","you can","তোমরা পারো"],["مِّن","min","besides Allah","দিয়ে"],["دُونِ","dūni","besides Allah","বাদ"],["ٱللَّهِ","l-lahi","besides Allah","আল্লাহ"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you are","হও তোমরা"],["صَـٰدِقِينَ","ṣādiqīna","truthful","সত্যবাদী\""]],"t":"أَمْ يَقُولُونَ <h>ٱ</>فْتَرَ<m>ىٰ</>هُ ۖ قُلْ فَأْتُو<s>ا۟</> بِسُورَ<d>ةٍۢ مِّ</>ثْلِ<m>هِۦ</> وَ<h>ٱ</><q>دْ</>عُو<s>ا۟</> مَنِ <h>ٱ</>سْتَطَعْ<y>تُم مِّ</><k>ن دُ</>ونِ <h>ٱ</>للَّهِ إِ<k>ن كُنتُ</>مْ <m>صَٰ</>دِ<p>قِي</>نَ"},{"n":39,"w":[["بَلْ","bal","Nay","বরং"],["كَذَّبُوا۟","kadhabū","they denied","তারা মিথ্যা মনে করেছে"],["بِمَا","bimā","what","ঐবিষয়ে যা"],["لَمْ","lam","not","নি"],["يُحِيطُوا۟","yuḥīṭū","they could encompass","তারা আয়ত্ত করতে পারে"],["بِعِلْمِهِۦ","bi‘il'mihi","(of) its knowledge","দিয়ে জ্ঞান তা"],["وَلَمَّا","walammā","and not","এবং এখনও নি"],["يَأْتِهِمْ","yatihim","has come (to) them","তাদের কাছে আসে"],["تَأْوِيلُهُۥ ۚ","tawīluhu","its interpretation","ব্যাখ্যা তার"],["كَذَٰلِكَ","kadhālika","Thus","এভাবে"],["كَذَّبَ","kadhaba","denied","মিথ্যারোপ করেছিলো"],["ٱلَّذِينَ","alladhīna","those","যারা"],["مِن","min","before them","থেকে"],["قَبْلِهِمْ ۖ","qablihim","before them","পূর্ব তাদের(ছিলো)"],["فَٱنظُرْ","fa-unẓur","then see","অতএব দেখো"],["كَيْفَ","kayfa","how","কেমন"],["كَانَ","kāna","was","ছিলো"],["عَـٰقِبَةُ","‘āqibatu","(the) end","পরিণাম"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","(of) the wrongdoers","সীমালঙ্ঘনকারীদের"]],"t":"بَلْ كَذَّبُو<s>ا۟</> بِمَا لَمْ يُحِيطُو<s>ا۟</> بِعِلْمِ<m>هِۦ</> وَلَ<g>مَّ</>ا يَأْتِهِمْ تَأْوِيلُهُ<m>ۥ</> ۚ كَ<m>ذَٰ</>لِكَ كَذَّبَ <h>ٱ</>لَّذِينَ مِ<k>ن قَ</><q>بْ</>لِهِمْ ۖ فَ<h>ٱ</><k>نظُ</>رْ كَيْفَ كَانَ <m>عَٰ</>قِبَةُ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":40,"w":[["وَمِنْهُم","wamin'hum","And of them","এবং মধ্য হতে তাদের"],["مَّن","man","(is one) who","কেউ কেউ"],["يُؤْمِنُ","yu'minu","believes","ঈমান আনবে"],["بِهِۦ","bihi","in it","উপর তার"],["وَمِنْهُم","wamin'hum","and of them","আবার মধ্য হতে তাদের"],["مَّن","man","(is one) who","কেউ কেউ"],["لَّا","lā","(does) not","না"],["يُؤْمِنُ","yu'minu","believe","ঈমান আনবে"],["بِهِۦ ۚ","bihi","in it","উপর তার"],["وَرَبُّكَ","warabbuka","And your Lord","এবং তোমার রব"],["أَعْلَمُ","a‘lamu","(is) All-Knower","খুব জানেন"],["بِٱلْمُفْسِدِينَ","bil-muf'sidīna","of the corrupters","সম্পর্কে বিপর্যয় সৃষ্টকারীদের"]],"t":"وَمِنْ<y>هُم مَّ</><d>ن يُ</>ؤْمِنُ بِ<m>هِۦ</> وَمِنْ<y>هُم مَّ</><w>ن لَّ</>ا يُؤْمِنُ بِ<m>هِۦ</> ۚ وَرَبُّكَ أَعْلَمُ بِ<h>ٱ</>لْمُفْسِ<p>دِي</>نَ"},{"n":41,"w":[["وَإِن","wa-in","And if","এবং যদি"],["كَذَّبُوكَ","kadhabūka","they deny you","তোমার প্রতি মিথ্যারোপ করে"],["فَقُل","faqul","then say","তবে বলো"],["لِّى","lī","For me","\"জন্যে আমার"],["عَمَلِى","‘amalī","(are) my deeds","আমার কাজের (পরিণতি)"],["وَلَكُمْ","walakum","and for you","আর জন্যে তোমাদের"],["عَمَلُكُمْ ۖ","‘amalukum","(are) your deeds","তোমাদের কাজের (পরিণতি)"],["أَنتُم","antum","You","তোমরা"],["بَرِيٓـُٔونَ","barīūna","(are) disassociated","দায়িত্বমুক্ত"],["مِمَّآ","mimmā","from what","তা হতে যা"],["أَعْمَلُ","a‘malu","I do","আমি কাজ করি"],["وَأَنَا۠","wa-anā","and I am","এবং আমি"],["بَرِىٓءٌۭ","barīon","disassociated","দায়িত্বমুক্ত"],["مِّمَّا","mimmā","from what","তা হতে যা"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা কাজ করো\""]],"t":"وَإِ<k>ن كَ</>ذَّبُوكَ فَقُل لِّى عَمَلِى وَلَكُمْ عَمَلُكُمْ ۖ أَ<k>نتُ</><f>م بَ</>رِ<o>يٓـُٔ</>ونَ مِ<g>مَّ</><o>آ</> أَعْمَلُ وَأَنَا۠ بَ<o>رِىٓ</><d>ءٌۭ مِّ</><g>مَّ</>ا تَعْمَ<p>لُو</>نَ"},{"n":42,"w":[["وَمِنْهُم","wamin'hum","And among them","এবং  মধ্যে থেকে তাদের"],["مَّن","man","(are some) who","কেউ কেউ"],["يَسْتَمِعُونَ","yastami‘ūna","listen","মনোযোগ দিয়ে শোনে"],["إِلَيْكَ ۚ","ilayka","to you","দিকে তোমার"],["أَفَأَنتَ","afa-anta","But (can) you","কি তবে তুমি"],["تُسْمِعُ","tus'mi‘u","cause the deaf to hear","শুনাবে"],["ٱلصُّمَّ","l-ṣuma","cause the deaf to hear","বধিরদেরকে"],["وَلَوْ","walaw","even though","এবং যদিও"],["كَانُوا۟","kānū","they [were]","তারা হলো (এমন যে)"],["لَا","lā","(do) not","না"],["يَعْقِلُونَ","ya‘qilūna","use reason","তারা বুঝতে পারে"]],"t":"وَمِنْ<y>هُم مَّ</><d>ن يَ</>سْتَمِعُونَ إِلَيْكَ ۚ أَفَأَ<k>نتَ</> تُسْمِعُ <h>ٱ</><l>ل</>صُّ<g>مَّ</> وَلَوْ كَانُو<s>ا۟</> لَا يَعْقِ<p>لُو</>نَ"},{"n":43,"w":[["وَمِنْهُم","wamin'hum","And among them","এবং মধ্যে থেকে তাদের"],["مَّن","man","(are some) who","কেউ কেউ"],["يَنظُرُ","yanẓuru","look","তাকিয়ে থাকে"],["إِلَيْكَ ۚ","ilayka","at you","দিকে তোমার"],["أَفَأَنتَ","afa-anta","But (can) you","কি তবে তুমি"],["تَهْدِى","tahdī","guide","পথ দেখাবে"],["ٱلْعُمْىَ","l-‘um'ya","the blind","অন্ধকে"],["وَلَوْ","walaw","even though","এবং যদিও"],["كَانُوا۟","kānū","they [were]","তারা হলো (এমন যে)"],["لَا","lā","(do) not","না"],["يُبْصِرُونَ","yub'ṣirūna","see","দেখতে পায়"]],"t":"وَمِنْ<y>هُم مَّ</><d>ن يَ</><k>نظُ</>رُ إِلَيْكَ ۚ أَفَأَ<k>نتَ</> تَهْدِى <h>ٱ</>لْعُمْىَ وَلَوْ كَانُو<s>ا۟</> لَا يُ<q>بْ</>صِ<p>رُو</>نَ"},{"n":44,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَا","lā","(does) not","না"],["يَظْلِمُ","yaẓlimu","wrong","অবিচার করেন"],["ٱلنَّاسَ","l-nāsa","the people","মানুষের (উপর)"],["شَيْـًۭٔا","shayan","(in) anything","কিছুমাত্রও"],["وَلَـٰكِنَّ","walākinna","but","কিন্তু"],["ٱلنَّاسَ","l-nāsa","the people","মানুষ"],["أَنفُسَهُمْ","anfusahum","wrong themselves","নিজেদের তাদের (উপর)"],["يَظْلِمُونَ","yaẓlimūna","wrong themselves","তারা অবিচার করে"]],"t":"إِ<g>نَّ</> <h>ٱ</>للَّهَ لَا يَظْلِمُ <h>ٱ</><l>ل</><g>نَّ</>اسَ شَ<d>يْـًۭٔا وَ</><m>لَٰ</>كِ<g>نَّ</> <h>ٱ</><l>ل</><g>نَّ</>اسَ أَ<k>نفُ</>سَهُمْ يَظْلِ<p>مُو</>نَ"},{"n":45,"w":[["وَيَوْمَ","wayawma","And the Day","এবং যেদিন"],["يَحْشُرُهُمْ","yaḥshuruhum","He will gather them","একত্র করবেন তিনি তাদেরকে"],["كَأَن","ka-an","as if","(তারা ভাববে) যেন"],["لَّمْ","lam","they had not remained","নি"],["يَلْبَثُوٓا۟","yalbathū","they had not remained","তারা অবস্হান করে"],["إِلَّا","illā","except","এ ছাড়া"],["سَاعَةًۭ","sā‘atan","an hour","(মাত্র)এক মুহূর্তকাল"],["مِّنَ","mina","of","থেকে"],["ٱلنَّهَارِ","l-nahāri","the day","দিনের"],["يَتَعَارَفُونَ","yata‘ārafūna","they will recognize each other","তারা পরস্পরে চিনবে"],["بَيْنَهُمْ ۚ","baynahum","between them","তাদের মাঝের (লোকদেরকে)"],["قَدْ","qad","Certainly","নিশ্চয়ই"],["خَسِرَ","khasira","(will have) lost","ক্ষতিগ্রস্ত হয়েছে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَذَّبُوا۟","kadhabū","denied","মিথ্যারোপ করেছে"],["بِلِقَآءِ","biliqāi","the meeting","প্রতি সাক্ষাতের"],["ٱللَّهِ","l-lahi","(with) Allah","আল্লাহর"],["وَمَا","wamā","and not","এবং না"],["كَانُوا۟","kānū","they were","তারা ছিলো"],["مُهْتَدِينَ","muh'tadīna","the guided ones","সৎপথ প্রাপ্ত"]],"t":"وَيَوْمَ يَحْشُرُهُمْ كَ<w>أَن لَّ</>مْ يَلْبَ<o>ثُوٓ</><s>ا۟</> إِلَّا سَاعَ<d>ةًۭ مِّ</>نَ <h>ٱ</><l>ل</><g>نَّ</>هَارِ يَتَعَارَفُونَ بَيْنَهُمْ ۚ قَ<q>دْ</> خَسِرَ <h>ٱ</>لَّذِينَ كَذَّبُو<s>ا۟</> بِلِ<o>قَآ</>ءِ <h>ٱ</>للَّهِ وَمَا كَانُو<s>ا۟</> مُهْتَ<p>دِي</>نَ"},{"n":46,"w":[["وَإِمَّا","wa-immā","And whether","এবং যদি"],["نُرِيَنَّكَ","nuriyannaka","We show you","তোমাকে দেখাই আমরা"],["بَعْضَ","ba‘ḍa","some","কিছু অংশ"],["ٱلَّذِى","alladhī","(of) that which","যার"],["نَعِدُهُمْ","na‘iduhum","We promised them","ভয় দেখাচ্ছি তাদের"],["أَوْ","aw","or","অথবা"],["نَتَوَفَّيَنَّكَ","natawaffayannaka","We cause you to die","তোমার মৃত্যু ঘটাই আমরা"],["فَإِلَيْنَا","fa-ilaynā","then to Us","তবুও দিকে আমাদেরই"],["مَرْجِعُهُمْ","marji‘uhum","(is) their return","প্রত্যাবর্তন তাদের (হবে)"],["ثُمَّ","thumma","then","এরপর"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["شَهِيدٌ","shahīdun","(is) a Witness","সাক্ষী (আছেন)"],["عَلَىٰ","‘alā","over","উপর"],["مَا","mā","what","(ঐ বিষয়ের) যা"],["يَفْعَلُونَ","yaf‘alūna","they do","তারা করছে"]],"t":"وَإِ<g>مَّ</>ا نُرِيَ<g>نَّ</>كَ بَعْضَ <h>ٱ</>لَّذِى نَعِدُهُمْ أَوْ نَتَوَفَّيَ<g>نَّ</>كَ فَإِلَيْنَا مَرْجِعُهُمْ ثُ<g>مَّ</> <h>ٱ</>للَّهُ شَهِيدٌ عَلَىٰ مَا يَفْعَ<p>لُو</>نَ"},{"n":47,"w":[["وَلِكُلِّ","walikulli","And for every","এবং জন্যে প্রত্যেক"],["أُمَّةٍۢ","ummatin","nation","জাতির"],["رَّسُولٌۭ ۖ","rasūlun","(is) a Messenger","একজন রাসূল(রয়েছে)"],["فَإِذَا","fa-idhā","So when","অতঃপর যখন"],["جَآءَ","jāa","comes","এসেছে"],["رَسُولُهُمْ","rasūluhum","their Messenger","রাসূল তাদের(রয়েছে)"],["قُضِىَ","quḍiya","it will be judged","মীমাংসা করা হয়েছে"],["بَيْنَهُم","baynahum","between them","মাঝে তাদের"],["بِٱلْقِسْطِ","bil-qis'ṭi","in justice","সাথে ন্যায়বিচারের"],["وَهُمْ","wahum","and they","এবং তাদের (উপর)"],["لَا","lā","(will) not","না"],["يُظْلَمُونَ","yuẓ'lamūna","be wronged","অবিচার করা হয়েছে"]],"t":"وَلِكُلِّ أُ<g>مَّ</><w>ةٍۢ رَّ</>سُو<k>لٌۭ ۖ فَ</>إِذَا <o>جَآ</>ءَ رَسُولُهُمْ قُضِىَ بَيْنَ<f>هُم بِ</><h>ٱ</>لْقِسْطِ وَهُمْ لَا يُظْلَ<p>مُو</>نَ"},{"n":48,"w":[["وَيَقُولُونَ","wayaqūlūna","And they say","এবং তারা বলে"],["مَتَىٰ","matā","When","\"কখন (বাস্তবায়িত হবে)"],["هَـٰذَا","hādhā","(will) this","এই"],["ٱلْوَعْدُ","l-wa‘du","the promise (be fulfilled)","প্রতিশ্রুতি"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you are","হও তোমরা"],["صَـٰدِقِينَ","ṣādiqīna","truthful","সত্যবাদী\""]],"t":"وَيَقُولُونَ مَتَىٰ <m>هَٰ</>ذَا <h>ٱ</>لْوَعْدُ إِ<k>ن كُنتُ</>مْ <m>صَٰ</>دِ<p>قِي</>نَ"},{"n":49,"w":[["قُل","qul","Say","বলো"],["لَّآ","lā","Not","\"না"],["أَمْلِكُ","amliku","I have power","অধিকার রাখি আমি"],["لِنَفْسِى","linafsī","for myself","(এমনকি) জন্যও নিজের"],["ضَرًّۭا","ḍarran","(for) any harm","কোনো ক্ষতির"],["وَلَا","walā","and not","আর না"],["نَفْعًا","naf‘an","(for) any profit","কোনো উপকারের"],["إِلَّا","illā","except","এ ছাড়া"],["مَا","mā","what","যা"],["شَآءَ","shāa","Allah wills","ইচ্ছে করেন"],["ٱللَّهُ ۗ","l-lahu","Allah wills","আল্লাহ"],["لِكُلِّ","likulli","For every","জন্যে প্রত্যেক"],["أُمَّةٍ","ummatin","nation","জাতির"],["أَجَلٌ ۚ","ajalun","(is) a term","নির্দিষ্ট সময় (রয়েছে)"],["إِذَا","idhā","When","যখন"],["جَآءَ","jāa","comes","আসবে"],["أَجَلُهُمْ","ajaluhum","their term","নির্দিষ্ট সময় তার"],["فَلَا","falā","then not","অতঃপর না"],["يَسْتَـْٔخِرُونَ","yastakhirūna","they remain behind","পিছাতে পারবে"],["سَاعَةًۭ ۖ","sā‘atan","an hour","মুহূর্তকালও"],["وَلَا","walā","and not","আর না"],["يَسْتَقْدِمُونَ","yastaqdimūna","they can precede (it)","এগিয়ে নিতে পারবে\""]],"t":"قُل <o>لَّآ</> أَمْلِكُ لِنَفْسِى ضَ<d>رًّۭا وَ</>لَا نَفْعًا إِلَّا مَا <o>شَآ</>ءَ <h>ٱ</>للَّهُ ۗ لِكُلِّ أُ<g>مَّ</>ةٍ أَجَلٌ ۚ إِذَا <o>جَآ</>ءَ أَجَلُهُمْ فَلَا يَسْتَـْٔخِرُونَ سَاعَ<d>ةًۭ ۖ وَ</>لَا يَسْتَ<q>قْ</>دِ<p>مُو</>نَ"},{"n":50,"w":[["قُلْ","qul","Say","বলো"],["أَرَءَيْتُمْ","ara-aytum","Do you see","\"কি (ভেবে) দেখেছো তোমরা"],["إِنْ","in","if","যদি"],["أَتَىٰكُمْ","atākum","comes to you","তোমাদের উপর আসে"],["عَذَابُهُۥ","‘adhābuhu","His punishment","শাস্তি তাঁর(সহসা)"],["بَيَـٰتًا","bayātan","(by) night","রাতে"],["أَوْ","aw","or","বা"],["نَهَارًۭا","nahāran","(by) day","দিনে (তবে তোমরা কি করবে)"],["مَّاذَا","mādhā","what (portion)","কি (কারণ আছে)"],["يَسْتَعْجِلُ","yasta‘jilu","of it would (wish to) hasten","তাড়াহুড়া করতে চায়"],["مِنْهُ","min'hu","of it would (wish to) hasten","থেকে তা"],["ٱلْمُجْرِمُونَ","l-muj'rimūna","the criminals","অপরাধীরা\""]],"t":"قُلْ أَرَءَيْتُمْ إِنْ أَتَ<m>ىٰ</>كُمْ عَذَابُهُ<m>ۥ</> بَ<m>يَٰ</>تًا أَوْ نَهَا<d>رًۭا مَّ</>اذَا يَسْتَعْجِلُ مِنْهُ <h>ٱ</>لْمُ<q>جْ</>رِ<p>مُو</>نَ"},{"n":51,"w":[["أَثُمَّ","athumma","Is (it) then","কি এরপর"],["إِذَا","idhā","when","যখন"],["مَا","mā","when","তা"],["وَقَعَ","waqa‘a","(it had) occurred","ঘটে যাবে"],["ءَامَنتُم","āmantum","you (will) believe","বিশ্বাস করবে তোমরা"],["بِهِۦٓ ۚ","bihi","in it","উপর তার"],["ءَآلْـَٔـٰنَ","āl'āna","Now","কি এখন (রক্ষা পেতে চাও)"],["وَقَدْ","waqad","And certainly","অথচ নিশ্চয়ই"],["كُنتُم","kuntum","you were","তোমরা ছিলে"],["بِهِۦ","bihi","seeking to hasten it","সম্বন্ধে তা"],["تَسْتَعْجِلُونَ","tasta‘jilūna","seeking to hasten it","তাড়াহুড়া করতে চাইতে"]],"t":"أَثُ<g>مَّ</> إِذَا مَا وَقَعَ ءَامَ<k>نتُ</><f>م بِ</><o>هِۦٓ ۚ</> ءَ<n>آ</><m>لْـَٰٔ</>نَ وَقَ<q>دْ</> كُ<k>نتُ</><f>م بِ</><m>هِۦ</> تَسْتَعْجِ<p>لُو</>نَ"},{"n":52,"w":[["ثُمَّ","thumma","Then","এরপর"],["قِيلَ","qīla","it will be said","বলা হবে"],["لِلَّذِينَ","lilladhīna","to those who","উদ্দেশ্যে তাদের (যারা)"],["ظَلَمُوا۟","ẓalamū","wronged","সীমালঙ্ঘন করেছিলো"],["ذُوقُوا۟","dhūqū","Taste","\"তোমরা স্বাদ নাও"],["عَذَابَ","‘adhāba","punishment","শাস্তির"],["ٱلْخُلْدِ","l-khul'di","the everlasting","স্থায়ী"],["هَلْ","hal","Are you (being) recompensed","কি"],["تُجْزَوْنَ","tuj'zawna","Are you (being) recompensed","তোমাদের প্রতিফল দেয়া হবে"],["إِلَّا","illā","except","এ ছাড়া"],["بِمَا","bimā","for what","ঐ বিষয়ে যা"],["كُنتُمْ","kuntum","you used (to)","তোমরা ছিলে"],["تَكْسِبُونَ","taksibūna","earn","তোমরা অর্জন করতে\""]],"t":"ثُ<g>مَّ</> قِيلَ لِلَّذِينَ ظَلَمُو<s>ا۟</> ذُوقُو<s>ا۟</> عَذَابَ <h>ٱ</>لْخُلْدِ هَلْ تُ<q>جْ</>زَوْنَ إِلَّا بِمَا كُ<k>نتُ</>مْ تَكْسِ<p>بُو</>نَ"},{"n":53,"w":[["۞ وَيَسْتَنۢبِـُٔونَكَ","wayastanbiūnaka","And they ask you to inform","এবং তোমার কাছে তারা জানতে চায়"],["أَحَقٌّ","aḥaqqun","Is it true","\"কি সত্য\""],["هُوَ ۖ","huwa","Is it true","\"তা\""],["قُلْ","qul","Say","বলো"],["إِى","ī","Yes","\"হ্যাঁ"],["وَرَبِّىٓ","warabbī","by my Lord","শপথ আমার রবের"],["إِنَّهُۥ","innahu","Indeed, it","নিশ্চয়ই তা"],["لَحَقٌّۭ ۖ","laḥaqqun","(is) surely the truth","অবশ্যই সত্য"],["وَمَآ","wamā","and not","এবং নও"],["أَنتُم","antum","you","তোমরা"],["بِمُعْجِزِينَ","bimu‘'jizīna","(can) escape (it)","ব্যর্থকারী\""]],"t":"۞ وَيَسْتَ<i>نۢبِـُٔ</>ونَكَ أَحَقٌّ هُوَ ۖ قُلْ إِى وَرَ<o>بِّىٓ</> إِ<g>نَّ</>هُ<m>ۥ</> لَحَ<d>قٌّۭ ۖ وَ</><o>مَآ</> أَ<k>نتُ</><f>م بِ</>مُعْجِ<p>زِي</>نَ"},{"n":54,"w":[["وَلَوْ","walaw","And if","এবং যদি (এমন হতো)"],["أَنَّ","anna","that","অবশ্যই"],["لِكُلِّ","likulli","for every","জন্যে প্রত্যেক"],["نَفْسٍۢ","nafsin","soul","ব্যক্তির"],["ظَلَمَتْ","ẓalamat","(that) wronged","(যে) সীমালঙ্ঘন করেছে"],["مَا","mā","whatever","যা কিছু"],["فِى","fī","(is) in","মধ্যে (আছে)"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর (সব তারই)"],["لَٱفْتَدَتْ","la-if'tadat","it (would) seek to ransom","অবশ্যই মুক্তিপণ হিসেবে দিতো(বাঁচার জন্য)"],["بِهِۦ ۗ","bihi","with it","দিয়ে তা"],["وَأَسَرُّوا۟","wa-asarrū","and they (will) confide","এবং তারা গোপনে করবে"],["ٱلنَّدَامَةَ","l-nadāmata","the regret","অনুতাপ"],["لَمَّا","lammā","when","যখন"],["رَأَوُا۟","ra-awū","they see","দেখবে"],["ٱلْعَذَابَ ۖ","l-‘adhāba","the punishment","শাস্তি"],["وَقُضِىَ","waquḍiya","But will be judged","এবং মীমাংসা করা হবে"