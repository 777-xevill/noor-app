{"n":81,"a":[{"n":1,"w":[["إِذَا","idhā","When","যখন"],["ٱلشَّمْسُ","l-shamsu","the sun","সূর্য"],["كُوِّرَتْ","kuwwirat","is wrapped up","নিষ্প্রভ হবে"]],"t":"إِذَا <h>ٱ</><l>ل</>شَّمْسُ كُوِّرَتْ"},{"n":2,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["ٱلنُّجُومُ","l-nujūmu","the stars","তারকাগুলো"],["ٱنكَدَرَتْ","inkadarat","fall, losing their luster","খসে পড়বে"]],"t":"وَإِذَا <h>ٱ</><l>ل</><g>نُّ</>جُومُ <h>ٱ</><k>نكَ</>دَرَتْ"},{"n":3,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["ٱلْجِبَالُ","l-jibālu","the mountains","পাহাড়গুলো"],["سُيِّرَتْ","suyyirat","are moved away","চালানো হবে"]],"t":"وَإِذَا <h>ٱ</>لْجِبَالُ سُيِّرَتْ"},{"n":4,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["ٱلْعِشَارُ","l-‘ishāru","the full-term she-camels","পূর্ণ গর্ভবতী উট"],["عُطِّلَتْ","‘uṭṭilat","(are) left untended","উপেক্ষিত হবে"]],"t":"وَإِذَا <h>ٱ</>لْعِشَارُ عُطِّلَتْ"},{"n":5,"w":[["وَإِذَا","wa-idhā","And when","ও যখন"],["ٱلْوُحُوشُ","l-wuḥūshu","the wild beasts","বন্য পশুদের"],["حُشِرَتْ","ḥushirat","are gathered","একত্র করা হবে"]],"t":"وَإِذَا <h>ٱ</>لْوُحُوشُ حُشِرَتْ"},{"n":6,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["ٱلْبِحَارُ","l-biḥāru","the seas","সাগরগুলো"],["سُجِّرَتْ","sujjirat","are made to overflow","প্রজ্বলিত করা হবে"]],"t":"وَإِذَا <h>ٱ</>لْبِحَارُ سُجِّرَتْ"},{"n":7,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["ٱلنُّفُوسُ","l-nufūsu","the souls","আত্মাগুলোকে"],["زُوِّجَتْ","zuwwijat","are paired","জুড়ে দেয়া হবে (শরীরের সাথে)"]],"t":"وَإِذَا <h>ٱ</><l>ل</><g>نُّ</>فُوسُ زُوِّجَتْ"},{"n":8,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["ٱلْمَوْءُۥدَةُ","l-mawūdatu","the female infant buried alive","জীবন্ত কবর দেয়া কন্যাকে"],["سُئِلَتْ","su-ilat","is asked","জিজ্ঞাসা করা হবে"]],"t":"وَإِذَا <h>ٱ</>لْمَوْءُ<m>ۥ</>دَةُ سُئِلَتْ"},{"n":9,"w":[["بِأَىِّ","bi-ayyi","For what","কোন কারণে"],["ذَنۢبٍۢ","dhanbin","sin","দোষের"],["قُتِلَتْ","qutilat","she was killed","তাকে হত্যা করা হয়েছে"]],"t":"بِأَىِّ ذَ<i>نۢبٍۢ</><k> قُ</>تِلَتْ"},{"n":10,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["ٱلصُّحُفُ","l-ṣuḥufu","the pages","আমলনামাগুলো"],["نُشِرَتْ","nushirat","are laid open","উন্মোচিত হবে"]],"t":"وَإِذَا <h>ٱ</><l>ل</>صُّحُفُ نُشِرَتْ"},{"n":11,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["ٱلسَّمَآءُ","l-samāu","the sky","আকাশ"],["كُشِطَتْ","kushiṭat","is stripped away","আবরণ অপসারিত হবে"]],"t":"وَإِذَا <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءُ كُشِطَتْ"},{"n":12,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["ٱلْجَحِيمُ","l-jaḥīmu","the Hellfire","জাহান্নাম"],["سُعِّرَتْ","su‘‘irat","is set ablaze","প্রজ্বলিত করা হবে"]],"t":"وَإِذَا <h>ٱ</>لْجَحِيمُ سُعِّرَتْ"},{"n":13,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["ٱلْجَنَّةُ","l-janatu","Paradise","জান্নাত"],["أُزْلِفَتْ","uz'lifat","is brought near","নিকটে আনা হবে"]],"t":"وَإِذَا <h>ٱ</>لْجَ<g>نَّ</>ةُ أُزْلِفَتْ"},{"n":14,"w":[["عَلِمَتْ","‘alimat","Will know","জানবে"],["نَفْسٌۭ","nafsun","a soul","(প্রত্যেক) ব্যক্তি"],["مَّآ","mā","what","যা"],["أَحْضَرَتْ","aḥḍarat","it has brought","উপস্থিত করেছে"]],"t":"عَلِمَتْ نَفْ<d>سٌۭ مَّ</><o>آ</> أَحْضَرَتْ"},{"n":15,"w":[["فَلَآ","falā","But nay","অতঃপর না"],["أُقْسِمُ","uq'simu","I swear","আমি শপথ করছি"],["بِٱلْخُنَّسِ","bil-khunasi","by the retreating planets","পশ্চাদপসরণকারী"]],"t":"فَ<o>لَآ</> أُ<q>قْ</>سِمُ بِ<h>ٱ</>لْخُ<g>نَّ</>سِ"},{"n":16,"w":[["ٱلْجَوَارِ","al-jawāri","Those that run","চলমান"],["ٱلْكُنَّسِ","l-kunasi","(and) disappear","অদৃশ্যমান (নক্ষত্রগুলোর)"]],"t":"ٱلْجَوَارِ <h>ٱ</>لْكُ<g>نَّ</>سِ"},{"n":17,"w":[["وَٱلَّيْلِ","wa-al-layli","And the night","শপথ রাতের"],["إِذَا","idhā","when","যখন"],["عَسْعَسَ","‘as‘asa","it departs","শেষ হয়"]],"t":"وَ<h>ٱ</>لَّيْلِ إِذَا عَسْعَسَ"},{"n":18,"w":[["وَٱلصُّبْحِ","wal-ṣub'ḥi","And the dawn","শপথ প্রভাতের"],["إِذَا","idhā","when","যখন"],["تَنَفَّسَ","tanaffasa","it breathes","শ্বাস নেয়"]],"t":"وَ<h>ٱ</><l>ل</>صُّ<q>بْ</>حِ إِذَا تَنَفَّسَ"},{"n":19,"w":[["إِنَّهُۥ","innahu","Indeed, it","নিশ্চয়ই তা"],["لَقَوْلُ","laqawlu","(is) surely a word","অবশ্যই বাণী"],["رَسُولٍۢ","rasūlin","(of) a Messenger","বার্তা-বাহকের"],["كَرِيمٍۢ","karīmin","noble","সম্মানিত"]],"t":"إِ<g>نَّ</>هُ<m>ۥ</> لَقَوْلُ رَسُو<k>لٍۢ كَ</><p>رِي</>مٍۢ"},{"n":20,"w":[["ذِى","dhī","Possessor of","সম্পন্ন"],["قُوَّةٍ","quwwatin","power","শক্তি"],["عِندَ","‘inda","with","কাছে"],["ذِى","dhī","(the) Owner of","অধিপতির"],["ٱلْعَرْشِ","l-‘arshi","the Throne","আরশের"],["مَكِينٍۢ","makīnin","secure","সামর্থ্যশালী"]],"t":"ذِى قُوَّةٍ عِ<k>ندَ</> ذِى <h>ٱ</>لْعَرْشِ مَ<p>كِي</>نٍۢ"},{"n":21,"w":[["مُّطَاعٍۢ","muṭā‘in","One to be obeyed","মান্য করা হয়"],["ثَمَّ","thamma","and","সেখানে"],["أَمِينٍۢ","amīnin","trustworthy","(এবং সে) বিশ্বস্ত"]],"t":"مُّطَا<k>عٍۢ ثَ</><g>مَّ</> أَ<p>مِي</>نٍۢ"},{"n":22,"w":[["وَمَا","wamā","And not","এবং না"],["صَاحِبُكُم","ṣāḥibukum","(is) your companion","তোমাদের সাথী"],["بِمَجْنُونٍۢ","bimajnūnin","mad","পাগল"]],"t":"وَمَا صَاحِبُ<f>كُم بِ</>مَ<q>جْ</><p>نُو</>نٍۢ"},{"n":23,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই সে"],["رَءَاهُ","raāhu","he saw him","তাকে দেখেছে"],["بِٱلْأُفُقِ","bil-ufuqi","in the horizon","দিগন্তে"],["ٱلْمُبِينِ","l-mubīni","the clear","সুস্পষ্ট"]],"t":"وَلَقَ<q>دْ</> رَءَاهُ بِ<h>ٱ</>لْأُفُقِ <h>ٱ</>لْمُ<p>بِي</>نِ"},{"n":24,"w":[["وَمَا","wamā","And not","এবং না"],["هُوَ","huwa","he (is)","সে"],["عَلَى","‘alā","on","ব্যাপারে"],["ٱلْغَيْبِ","l-ghaybi","the unseen","অদৃশ্যের"],["بِضَنِينٍۢ","biḍanīnin","a withholder","কৃপণ"]],"t":"وَمَا هُوَ عَلَى <h>ٱ</>لْغَيْبِ بِضَ<p>نِي</>نٍۢ"},{"n":25,"w":[["وَمَا","wamā","And not","এবং না"],["هُوَ","huwa","it","তা"],["بِقَوْلِ","biqawli","(is the) word","কথা"],["شَيْطَـٰنٍۢ","shayṭānin","(of) Shaitaan","শয়তানের"],["رَّجِيمٍۢ","rajīmin","accursed","অভিশপ্ত"]],"t":"وَمَا هُوَ بِقَوْلِ شَيْ<m>طَٰ</><w>نٍۢ رَّ</><p>جِي</>مٍۢ"},{"n":26,"w":[["فَأَيْنَ","fa-ayna","So where","অতএব কোথায়"],["تَذْهَبُونَ","tadhhabūna","are you going","তোমরা চলেছ"]],"t":"فَأَيْنَ تَذْهَ<p>بُو</>نَ"},{"n":27,"w":[["إِنْ","in","Not","নয়"],["هُوَ","huwa","it","তা"],["إِلَّا","illā","(is) except","এ ছাড়া"],["ذِكْرٌۭ","dhik'run","a reminder","উপদেশ"],["لِّلْعَـٰلَمِينَ","lil'‘ālamīna","to the worlds","বিশ্ব-জগতের জন্যে"]],"t":"إِنْ هُوَ إِلَّا ذِكْ<w>رٌۭ لِّ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":28,"w":[["لِمَن","liman","For whoever","তার জন্যে"],["شَآءَ","shāa","wills","যে চায়"],["مِنكُمْ","minkum","among you","তোমাদের মধ্যে"],["أَن","an","to","যে"],["يَسْتَقِيمَ","yastaqīma","take a straight way","সোজা চলতে"]],"t":"لِمَ<k>ن شَ</><o>آ</>ءَ مِ<k>نكُ</>مْ <d>أَن يَ</>سْتَ<p>قِي</>مَ"},{"n":29,"w":[["وَمَا","wamā","And not","এবং না"],["تَشَآءُونَ","tashāūna","you will","(যা) তোমরা চাও (তা কিছু হয়)"],["إِلَّآ","illā","except","এ ছাড়া"],["أَن","an","that","যে"],["يَشَآءَ","yashāa","wills","চান"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["رَبُّ","rabbu","Lord","রব"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","(of) the worlds","জগতসমূহের"]],"t":"وَمَا تَ<o>شَآ</>ءُونَ إِ<o>لَّآ</> <d>أَن يَ</><o>شَآ</>ءَ <h>ٱ</>للَّهُ رَبُّ <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"}]}