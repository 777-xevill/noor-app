{"n":99,"a":[{"n":1,"w":[["إِذَا","idhā","When","যখন"],["زُلْزِلَتِ","zul'zilati","is shaken","প্রকম্পিত হবে"],["ٱلْأَرْضُ","l-arḍu","the earth","পৃথিবী"],["زِلْزَالَهَا","zil'zālahā","(with) its earthquake","তার (ভীষণ) কম্পনে"]],"t":"إِذَا زُلْزِلَتِ <h>ٱ</>لْأَرْضُ زِلْزَالَهَا"},{"n":2,"w":[["وَأَخْرَجَتِ","wa-akhrajati","And brings forth","এবং বের করবে"],["ٱلْأَرْضُ","l-arḍu","the earth","পৃথিবী"],["أَثْقَالَهَا","athqālahā","its burdens","বোঝাগুলোকে তার"]],"t":"وَأَخْرَجَتِ <h>ٱ</>لْأَرْضُ أَثْقَالَهَا"},{"n":3,"w":[["وَقَالَ","waqāla","And says","এবং বলবে"],["ٱلْإِنسَـٰنُ","l-insānu","man","মানুষ"],["مَا","mā","What","\"কি"],["لَهَا","lahā","(is) with it","হয়েছে তার\""]],"t":"وَقَالَ <h>ٱ</>لْإِ<k>نسَٰ</>نُ مَا لَهَا"},{"n":4,"w":[["يَوْمَئِذٍۢ","yawma-idhin","That Day","সেদিন"],["تُحَدِّثُ","tuḥaddithu","it will report","সে বর্ণনা করবে"],["أَخْبَارَهَا","akhbārahā","its news","তার বৃত্তান্ত"]],"t":"يَوْمَئِ<k>ذٍۢ تُ</>حَدِّثُ أَخْبَارَهَا"},{"n":5,"w":[["بِأَنَّ","bi-anna","Because","কেননা"],["رَبَّكَ","rabbaka","your Lord","তোমার রব"],["أَوْحَىٰ","awḥā","inspired","আদেশ করবেন (এইরূপ করার)"],["لَهَا","lahā","[to] it","তাকে"]],"t":"بِأَ<g>نَّ</> رَبَّكَ أَوْحَىٰ لَهَا"},{"n":6,"w":[["يَوْمَئِذٍۢ","yawma-idhin","That Day","সেদিন"],["يَصْدُرُ","yaṣduru","will proceed","বের হবে"],["ٱلنَّاسُ","l-nāsu","the mankind","মানুষ"],["أَشْتَاتًۭا","ashtātan","(in) scattered groups","দলে দলে ভাগ হয়ে"],["لِّيُرَوْا۟","liyuraw","to be shown","দেখানোর জন্য"],["أَعْمَـٰلَهُمْ","a‘mālahum","their deeds","তাদের কৃতকর্মকে"]],"t":"يَوْمَئِ<d>ذٍۢ يَ</>صْدُرُ <h>ٱ</><l>ل</><g>نَّ</>اسُ أَشْتَا<w>تًۭا لِّ</>يُرَوْ<s>ا۟</> أَعْ<m>مَٰ</>لَهُمْ"},{"n":7,"w":[["فَمَن","faman","So whoever","অতঃপর যে"],["يَعْمَلْ","ya‘mal","does","করবে"],["مِثْقَالَ","mith'qāla","(equal to the) weight","পরিমাণ"],["ذَرَّةٍ","dharratin","(of) an atom","অণু"],["خَيْرًۭا","khayran","good","সৎকর্ম"],["يَرَهُۥ","yarahu","will see it","সে তা দেখবে"]],"t":"فَ<d>مَن يَ</>عْمَلْ مِثْقَالَ ذَرَّةٍ خَيْ<d>رًۭا يَ</>رَهُۥ"},{"n":8,"w":[["وَمَن","waman","And whoever","এবং যে"],["يَعْمَلْ","ya‘mal","does","করবে"],["مِثْقَالَ","mith'qāla","(equal to the) weight","পরিমাণ"],["ذَرَّةٍۢ","dharratin","(of) an atom","অণু"],["شَرًّۭا","sharran","evil","অসৎকর্ম"],["يَرَهُۥ","yarahu","will see it","সে তা  দেখবে"]],"t":"وَ<d>مَن يَ</>عْمَلْ مِثْقَالَ ذَرَّ<k>ةٍۢ شَ</><d>رًّۭا يَ</>رَهُۥ"}]}