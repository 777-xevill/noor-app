{"n":109,"a":[{"n":1,"w":[["قُلْ","qul","Say","বলো"],["يَـٰٓأَيُّهَا","yāayyuhā","O","\"হে"],["ٱلْكَـٰفِرُونَ","l-kāfirūna","disbelievers","কাফিররা"]],"t":"قُلْ <o>يَٰٓ</>أَيُّهَا <h>ٱ</>لْ<m>كَٰ</>فِ<p>رُو</>نَ"},{"n":2,"w":[["لَآ","lā","Not","না"],["أَعْبُدُ","a‘budu","I worship","আমি ইবাদাত করি"],["مَا","mā","what","যার"],["تَعْبُدُونَ","ta‘budūna","you worship","তোমরা ইবাদাত কর"]],"t":"<o>لَآ</> أَعْبُدُ مَا تَعْبُ<p>دُو</>نَ"},{"n":3,"w":[["وَلَآ","walā","And not","এবং না"],["أَنتُمْ","antum","you","তোমরা"],["عَـٰبِدُونَ","‘ābidūna","(are) worshippers","ইবাদাতকারী"],["مَآ","mā","(of) what","যার"],["أَعْبُدُ","a‘budu","I worship","আমি ইবাদাত করি"]],"t":"وَ<o>لَآ</> أَ<k>نتُ</>مْ <m>عَٰ</>بِدُونَ <o>مَآ</> أَعْبُ<q>دُ</>"},{"n":4,"w":[["وَلَآ","walā","And not","আর না"],["أَنَا۠","anā","I am","আমি"],["عَابِدٌۭ","‘ābidun","a worshipper","ইবাদাতকারী"],["مَّا","mā","(of) what","যার"],["عَبَدتُّمْ","‘abadttum","you worship","তোমরা ইবাদাত করেছ"]],"t":"وَ<o>لَآ</> أَنَا۠ عَابِ<d>دٌۭ مَّ</>ا عَبَ<j>د</>تُّمْ"},{"n":5,"w":[["وَلَآ","walā","And not","আর না"],["أَنتُمْ","antum","you","তোমরা"],["عَـٰبِدُونَ","‘ābidūna","(are) worshippers","ইবাদাতকারী"],["مَآ","mā","(of) what","যার"],["أَعْبُدُ","a‘budu","I worship","আমি ইবাদাত করি"]],"t":"وَ<o>لَآ</> أَ<k>نتُ</>مْ <m>عَٰ</>بِدُونَ <o>مَآ</> أَعْبُ<q>دُ</>"},{"n":6,"w":[["لَكُمْ","lakum","For you","তোমাদের জন্য"],["دِينُكُمْ","dīnukum","(is) your religion","তোমার ধর্ম"],["وَلِىَ","waliya","and for me","এবং আমার জন্য"],["دِينِ","dīni","(is) my religion","আমার ধর্ম\""]],"t":"لَكُمْ دِينُكُمْ وَلِىَ <p>دِي</>نِ"}]}