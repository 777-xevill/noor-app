{"n":31,"a":[{"n":1,"w":[["الٓمٓ","alif-lam-meem","Alif Lam Meem","আলিফ লাম - মীম-"]],"t":"ا<n>لٓمٓ</>"},{"n":2,"w":[["تِلْكَ","til'ka","These","এই"],["ءَايَـٰتُ","āyātu","(are) Verses","আয়াতগুলো"],["ٱلْكِتَـٰبِ","l-kitābi","(of) the Book","কিতাবের"],["ٱلْحَكِيمِ","l-ḥakīmi","the Wise","(যা) জ্ঞানময়"]],"t":"تِلْكَ ءَا<m>يَٰ</>تُ <h>ٱ</>لْكِ<m>تَٰ</>بِ <h>ٱ</>لْحَ<p>كِي</>مِ"},{"n":3,"w":[["هُدًۭى","hudan","A guidance","পথ নির্দেশনা"],["وَرَحْمَةًۭ","waraḥmatan","and a mercy","ও দয়াস্বরূপ"],["لِّلْمُحْسِنِينَ","lil'muḥ'sinīna","for the good-doers","জন্যে সৎকর্মশীলদের"]],"t":"هُ<d>دًۭى وَ</>رَحْمَ<w>ةًۭ لِّ</>لْمُحْسِ<p>نِي</>نَ"},{"n":4,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["يُقِيمُونَ","yuqīmūna","establish","তারা প্রতিষ্ঠা করে"],["ٱلصَّلَوٰةَ","l-ṣalata","the prayer","সালাত"],["وَيُؤْتُونَ","wayu'tūna","and give","ও তারা দেয়"],["ٱلزَّكَوٰةَ","l-zakata","zakah","যাকাত"],["وَهُم","wahum","and they","এবং তারা"],["بِٱلْـَٔاخِرَةِ","bil-ākhirati","in the Hereafter","উপর আখিরাতের"],["هُمْ","hum","[they]","তারাই"],["يُوقِنُونَ","yūqinūna","believe firmly","দৃঢ় বিশ্বাস করে"]],"t":"ٱلَّذِينَ يُقِيمُونَ <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةَ وَيُؤْتُونَ <h>ٱ</><l>ل</>زَّكَ<s>وٰ</>ةَ وَ<f>هُم بِ</><h>ٱ</>لْءَاخِرَةِ هُمْ يُوقِ<p>نُو</>نَ"},{"n":5,"w":[["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব (লোকই)"],["عَلَىٰ","‘alā","(are) on","উপর (প্রতিষ্ঠিত)"],["هُدًۭى","hudan","guidance","পথনির্দেশের"],["مِّن","min","from","পক্ষ থেকে"],["رَّبِّهِمْ ۖ","rabbihim","their Lord","রবের তাদের"],["وَأُو۟لَـٰٓئِكَ","wa-ulāika","and those","এবং ঐসব (লোক)"],["هُمُ","humu","[they]","তারাই"],["ٱلْمُفْلِحُونَ","l-muf'liḥūna","(are) the successful","সফলকাম"]],"t":"أُ<s>و۟</><o>لَٰٓ</>ئِكَ عَلَىٰ هُ<d>دًۭى مِّ</><w>ن رَّ</>بِّهِمْ ۖ وَأُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</>لْمُفْلِ<p>حُو</>نَ"},{"n":6,"w":[["وَمِنَ","wamina","And of","এবং মধ্য থেকে"],["ٱلنَّاسِ","l-nāsi","the mankind","মানুষের (এমনও আছে)"],["مَن","man","(is he) who","যে"],["يَشْتَرِى","yashtarī","purchases","কোনো"],["لَهْوَ","lahwa","idle tales","অসার"],["ٱلْحَدِيثِ","l-ḥadīthi","idle tales","কথা"],["لِيُضِلَّ","liyuḍilla","to mislead","যেন সে বিভ্রান্ত করতে পারে"],["عَن","‘an","from","থেকে"],["سَبِيلِ","sabīli","(the) path","পথ"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["بِغَيْرِ","bighayri","without","ছাড়া"],["عِلْمٍۢ","‘il'min","knowledge","কোনো জ্ঞান"],["وَيَتَّخِذَهَا","wayattakhidhahā","and takes it","এবং গ্রহণ করে তা"],["هُزُوًا ۚ","huzuwan","(in) ridicule","বিদ্রুপরূপে"],["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব (লোক)"],["لَهُمْ","lahum","for them","জন্যে তাদের (রয়েছে)"],["عَذَابٌۭ","‘adhābun","(is) a punishment","শাস্তি"],["مُّهِينٌۭ","muhīnun","humiliating","অপমানকর"]],"t":"وَمِنَ <h>ٱ</><l>ل</><g>نَّ</>اسِ <d>مَن يَ</>شْتَرِى لَهْوَ <h>ٱ</>لْحَدِيثِ لِيُضِلَّ عَ<k>ن سَ</>بِيلِ <h>ٱ</>للَّهِ بِغَيْرِ عِلْ<d>مٍۢ وَ</>يَتَّخِذَهَا هُزُوًا ۚ أُ<s>و۟</><o>لَٰٓ</>ئِكَ لَهُمْ عَذَا<d>بٌۭ مُّ</><p>هِي</>نٌۭ"},{"n":7,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["تُتْلَىٰ","tut'lā","are recited","তিলাওয়াত করা হয়"],["عَلَيْهِ","‘alayhi","to him","নিকট তার"],["ءَايَـٰتُنَا","āyātunā","Our Verses","আয়াতসমূহ আমাদের"],["وَلَّىٰ","wallā","he turns away","সে মুখ ফিরায়"],["مُسْتَكْبِرًۭا","mus'takbiran","arrogantly","অহঙ্কারী হিসেবে"],["كَأَن","ka-an","as if","যেন"],["لَّمْ","lam","not","নি"],["يَسْمَعْهَا","yasma‘hā","he (had) heard them","শুনতে পায় তা"],["كَأَنَّ","ka-anna","as if","যেন"],["فِىٓ","fī","in","মধ্যে (আছে)"],["أُذُنَيْهِ","udhunayhi","his ears","দু'কানের তার"],["وَقْرًۭا ۖ","waqran","(is) deafness","বধিরতা"],["فَبَشِّرْهُ","fabashir'hu","So give him tidings","অতএব সুসংবাদ দাও তাকে"],["بِعَذَابٍ","bi‘adhābin","of a punishment","ব্যাপারে শাস্তির"],["أَلِيمٍ","alīmin","painful","নিদারুণ"]],"t":"وَإِذَا تُتْلَىٰ عَلَيْهِ ءَا<m>يَٰ</>تُنَا وَلَّىٰ مُسْتَكْبِ<k>رًۭا كَ</><w>أَن لَّ</>مْ يَسْمَعْهَا كَأَ<g>نَّ</> <o>فِىٓ</> أُذُنَيْهِ وَ<q>قْ</><k>رًۭا ۖ فَ</>بَشِّرْهُ بِعَذَابٍ أَ<p>لِي</>مٍ"},{"n":8,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["وَعَمِلُوا۟","wa‘amilū","and do","ও কাজ করেছে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","righteous deeds","সৎ"],["لَهُمْ","lahum","for them","জন্যে তাদের (রয়েছে)"],["جَنَّـٰتُ","jannātu","(are) Gardens","জান্নাতসমুহ"],["ٱلنَّعِيمِ","l-na‘īmi","(of) Delight","সুখকর"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ لَهُمْ جَ<g>نَّٰ</>تُ <h>ٱ</><l>ل</><g>نَّ</><p>عِي</>مِ"},{"n":9,"w":[["خَـٰلِدِينَ","khālidīna","(To) abide forever","চিরস্থায়ীভাবে থাকবে তারা"],["فِيهَا ۖ","fīhā","in it","মধ্যে তার"],["وَعْدَ","wa‘da","(The) Promise of Allah","প্রতিশ্রুতি"],["ٱللَّهِ","l-lahi","(The) Promise of Allah","আল্লাহ"],["حَقًّۭا ۚ","ḥaqqan","(is) true","সত্য"],["وَهُوَ","wahuwa","And He","এবং তিনিই"],["ٱلْعَزِيزُ","l-‘azīzu","(is) the All-Mighty","পরাক্রমশালী"],["ٱلْحَكِيمُ","l-ḥakīmu","the All-Wise","প্রজ্ঞাময়"]],"t":"<m>خَٰ</>لِدِينَ فِيهَا ۖ وَعْدَ <h>ٱ</>للَّهِ حَ<d>قًّۭا ۚ وَ</>هُوَ <h>ٱ</>لْعَزِيزُ <h>ٱ</>لْحَ<p>كِي</>مُ"},{"n":10,"w":[["خَلَقَ","khalaqa","He created","তিনি সৃষ্টি করেছেন"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশসমূহ"],["بِغَيْرِ","bighayri","without","ছাড়া"],["عَمَدٍۢ","‘amadin","pillars","কোন খুঁটি"],["تَرَوْنَهَا ۖ","tarawnahā","that you see","তোমরা দেখছো তা"],["وَأَلْقَىٰ","wa-alqā","and has cast","এবং স্থাপন করেছেন"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["رَوَٰسِىَ","rawāsiya","firm mountains","পর্বতমালা"],["أَن","an","lest","( এমন না হয় ) যে"],["تَمِيدَ","tamīda","it (might) shake","ঢলে যায়"],["بِكُمْ","bikum","with you","নিয়ে তোমাদেরকে"],["وَبَثَّ","wabatha","and He dispersed","এবং ছড়িয়ে দিয়েছেন"],["فِيهَا","fīhā","in it","মধ্যে তার"],["مِن","min","from","প্রকার"],["كُلِّ","kulli","every","প্রত্যেক"],["دَآبَّةٍۢ ۚ","dābbatin","creature","জীবজন্তু"],["وَأَنزَلْنَا","wa-anzalnā","And We sent down","এবং আমরা বর্ষণ করেছি"],["مِنَ","mina","from","থেকে"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশ"],["مَآءًۭ","māan","water","পানি"],["فَأَنۢبَتْنَا","fa-anbatnā","then We caused to grow","অতঃপর উৎপন্ন করি আমরা"],["فِيهَا","fīhā","therein","মধ্যে তার"],["مِن","min","of","প্রকার"],["كُلِّ","kulli","every","প্রত্যেক"],["زَوْجٍۢ","zawjin","kind","জোড়া জোড়া (উদ্ভিদ)"],["كَرِيمٍ","karīmin","noble","উত্তম"]],"t":"خَلَقَ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ بِغَيْرِ عَمَ<k>دٍۢ تَ</>رَوْنَهَا ۖ وَأَلْقَىٰ فِى <h>ٱ</>لْأَرْضِ رَ<m>وَٰ</>سِىَ أَ<k>ن تَ</>مِيدَ بِكُمْ وَبَثَّ فِيهَا مِ<k>ن كُ</>لِّ <n>دَآ</>بَّ<d>ةٍۢ ۚ وَ</>أَ<k>نزَ</>لْنَا مِنَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ <o>مَآ</><k>ءًۭ فَ</>أَ<i>نۢبَ</>تْنَا فِيهَا مِ<k>ن كُ</>لِّ زَوْ<k>جٍۢ كَ</><p>رِي</>مٍ"},{"n":11,"w":[["هَـٰذَا","hādhā","This","এটা"],["خَلْقُ","khalqu","(is the) creation","সৃষ্টি"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["فَأَرُونِى","fa-arūnī","So show Me","তাহ'লে দেখাও তোমরা আমাকে"],["مَاذَا","mādhā","what","কি"],["خَلَقَ","khalaqa","have created","সৃষ্টি করেছে"],["ٱلَّذِينَ","alladhīna","those","(তারা) যারা (আছে)"],["مِن","min","besides Him","ছাড়া"],["دُونِهِۦ ۚ","dūnihi","besides Him","তিনি"],["بَلِ","bali","Nay","বরং"],["ٱلظَّـٰلِمُونَ","l-ẓālimūna","the wrongdoers","সীমালঙ্ঘনকারীরা"],["فِى","fī","(are) in","মধ্যে(লিপ্ত)"],["ضَلَـٰلٍۢ","ḍalālin","error","বিভ্রান্তির"],["مُّبِينٍۢ","mubīnin","clear","সুস্পষ্ট"]],"t":"<m>هَٰ</>ذَا خَلْقُ <h>ٱ</>للَّهِ فَأَرُونِى مَاذَا خَلَقَ <h>ٱ</>لَّذِينَ مِ<k>ن دُ</>ونِ<m>هِۦ</> ۚ بَلِ <h>ٱ</><l>ل</><m>ظَّٰ</>لِمُونَ فِى ضَ<m>لَٰ</><d>لٍۢ مُّ</><p>بِي</>نٍۢ"},{"n":12,"w":[["وَلَقَدْ","walaqad","And verily","এবং নিশ্চয়ই"],["ءَاتَيْنَا","ātaynā","We gave","দিয়েছিলাম আমরা"],["لُقْمَـٰنَ","luq'māna","Luqman","লুকমানকে"],["ٱلْحِكْمَةَ","l-ḥik'mata","the wisdom","প্রজ্ঞা"],["أَنِ","ani","that","যে"],["ٱشْكُرْ","ush'kur","Be grateful","\"তুমি কৃতজ্ঞতা প্রকাশ করো"],["لِلَّهِ ۚ","lillahi","to Allah","জন্যে আল্লাহ্‌রই\""],["وَمَن","waman","And whoever","এবং যে"],["يَشْكُرْ","yashkur","(is) grateful","(আল্লাহর) কৃতজ্ঞতা প্রকাশ করে"],["فَإِنَّمَا","fa-innamā","then only","তখন মূলতঃ"],["يَشْكُرُ","yashkuru","he is grateful","সে কৃতজ্ঞতা প্রকাশ করে"],["لِنَفْسِهِۦ ۖ","linafsihi","for himself","জন্যে নিজের তার"],["وَمَن","waman","And whoever","এবং যে"],["كَفَرَ","kafara","(is) ungrateful","অকৃতজ্ঞ হয়"],["فَإِنَّ","fa-inna","then indeed","তবে নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["غَنِىٌّ","ghaniyyun","(is) Free of need","অমুখাপেক্ষী"],["حَمِيدٌۭ","ḥamīdun","Praiseworthy","প্রশংসিত"]],"t":"وَلَقَ<q>دْ</> ءَاتَيْنَا لُ<q>قْ</><m>مَٰ</>نَ <h>ٱ</>لْحِكْمَةَ أَنِ <h>ٱ</>شْكُرْ لِلَّهِ ۚ وَ<d>مَن يَ</>شْكُرْ فَإِ<g>نَّ</>مَا يَشْكُرُ لِنَفْسِ<m>هِۦ</> ۖ وَمَ<k>ن كَ</>فَرَ فَإِ<g>نَّ</> <h>ٱ</>للَّهَ غَنِىٌّ حَ<p>مِي</><q>دٌۭ</>"},{"n":13,"w":[["وَإِذْ","wa-idh","And when","এবং (স্মরণ করো) যখন"],["قَالَ","qāla","said","বলেছিলো"],["لُقْمَـٰنُ","luq'mānu","Luqman","লুকমান"],["لِٱبْنِهِۦ","li-ib'nihi","to his son","উদ্দেশ্যে পুত্রের তার"],["وَهُوَ","wahuwa","while he","এমতাবস্হায় যে সে"],["يَعِظُهُۥ","ya‘iẓuhu","(was) instructing him","উপদেশ দিচ্ছিলো তাকে"],["يَـٰبُنَىَّ","yābunayya","O my son","\"হে আমার পুত্র"],["لَا","lā","(Do) not","না"],["تُشْرِكْ","tush'rik","associate partners","শিরক করো"],["بِٱللَّهِ ۖ","bil-lahi","with Allah","সাথে আল্লাহর(কাউকে)"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلشِّرْكَ","l-shir'ka","associating partners","শিরক করা"],["لَظُلْمٌ","laẓul'mun","(is) surely an injustice","অবশ্যই সীমালঙ্ঘন"],["عَظِيمٌۭ","‘aẓīmun","great","চরম\""]],"t":"وَإِذْ قَالَ لُ<q>قْ</><m>مَٰ</>نُ لِ<h>ٱ</><q>بْ</>نِ<m>هِۦ</> وَهُوَ يَعِظُهُ<m>ۥ يَٰ</>بُنَىَّ لَا تُشْرِكْ بِ<h>ٱ</>للَّهِ ۖ إِ<g>نَّ</> <h>ٱ</><l>ل</>شِّرْكَ لَظُلْمٌ عَ<p>ظِي</>مٌۭ"},{"n":14,"w":[["وَوَصَّيْنَا","wawaṣṣaynā","And We have enjoined","এবং জোর উপদেশ দিয়েছি আমরা"],["ٱلْإِنسَـٰنَ","l-insāna","(upon) man","মানুষকে"],["بِوَٰلِدَيْهِ","biwālidayhi","for his parents ","সাথে তার মাতা-পিতার (ভালো ব্যবহারের জন্যে)"],["حَمَلَتْهُ","ḥamalathu","carried him","বহন করেছে তাকে (পেটে)"],["أُمُّهُۥ","ummuhu","his mother","মা তার"],["وَهْنًا","wahnan","(in) weakness","কষ্টের"],["عَلَىٰ","‘alā","upon","উপর"],["وَهْنٍۢ","wahnin","weakness","কষ্ট (করে)"],["وَفِصَـٰلُهُۥ","wafiṣāluhu","and his weaning","এবং দুধ ছাড়ান তার"],["فِى","fī","(is) in","মধ্যে"],["عَامَيْنِ","‘āmayni","two years","দু'বছরের"],["أَنِ","ani","that","যে"],["ٱشْكُرْ","ush'kur","Be grateful","\"কৃতজ্ঞতা প্রকাশ করো"],["لِى","lī","to Me","প্রতি আমার"],["وَلِوَٰلِدَيْكَ","waliwālidayka","and to your parents","এবং প্রতি তোমার মা-বাপেরও"],["إِلَىَّ","ilayya","towards Me","দিকে আমারই"],["ٱلْمَصِيرُ","l-maṣīru","(is) the destination","(তোমাদের) প্রত্যাবর্তন"]],"t":"وَوَصَّيْنَا <h>ٱ</>لْإِ<k>نسَٰ</>نَ بِ<m>وَٰ</>لِدَيْهِ حَمَلَتْهُ أُ<g>مُّ</>هُ<m>ۥ</> وَهْنًا عَلَىٰ وَهْ<d>نٍۢ وَ</>فِ<m>صَٰ</>لُهُ<m>ۥ</> فِى عَامَيْنِ أَنِ <h>ٱ</>شْكُرْ لِى وَلِ<m>وَٰ</>لِدَيْكَ إِلَىَّ <h>ٱ</>لْمَ<p>صِي</>رُ"},{"n":15,"w":[["وَإِن","wa-in","But if","এবং যদি"],["جَـٰهَدَاكَ","jāhadāka","they strive against you","তারা দু'জনে তোমাকে চাপ দেয়"],["عَلَىٰٓ","‘alā","on","(এর)উপর"],["أَن","an","that","যে"],["تُشْرِكَ","tush'rika","you associate partners","তুমি শিরক করো"],["بِى","bī","with Me","সাথে আমার"],["مَا","mā","what","যা"],["لَيْسَ","laysa","not","নেই"],["لَكَ","laka","you have","কাছে তোমার"],["بِهِۦ","bihi","of it","সম্পর্কে সে"],["عِلْمٌۭ","‘il'mun","any knowledge","কোনো জ্ঞান"],["فَلَا","falā","then (do) not","তবে না"],["تُطِعْهُمَا ۖ","tuṭi‘'humā","obey both of them","উভয়ের (কাউকে) মানবে"],["وَصَاحِبْهُمَا","waṣāḥib'humā","But accompany them","তবে উভয়ের সাথে ব্যবহার করবে"],["فِى","fī","in","মধ্যে"],["ٱلدُّنْيَا","l-dun'yā","the world","দুনিয়ার"],["مَعْرُوفًۭا ۖ","ma‘rūfan","(with) kindness","সদ্ভাবে"],["وَٱتَّبِعْ","wa-ittabi‘","and follow","এবং অনুসরণ করো"],["سَبِيلَ","sabīla","(the) path","পথ"],["مَنْ","man","(of him) who","(তার)যে"],["أَنَابَ","anāba","turns","অভিমুখী হয়েছে"],["إِلَىَّ ۚ","ilayya","to Me","দিকে আমারই"],["ثُمَّ","thumma","Then","এরপর"],["إِلَىَّ","ilayya","towards Me","দিকে আমারই"],["مَرْجِعُكُمْ","marji‘ukum","(is) your return","প্রত্যাবর্তন তোমাদের(হবে)"],["فَأُنَبِّئُكُم","fa-unabbi-ukum","then I will inform you","তখন আমি জানিয়ে দিবো তোমাদেরকে"],["بِمَا","bimā","of what","ঐ বিষয়ে যা"],["كُنتُمْ","kuntum","you used (to)","তোমরা ছিলে"],["تَعْمَلُونَ","ta‘malūna","do","তোমরা কাজ করতে\""]],"t":"وَإِ<k>ن جَٰ</>هَدَاكَ عَلَ<o>ىٰٓ</> أَ<k>ن تُ</>شْرِكَ بِى مَا لَيْسَ لَكَ بِ<m>هِۦ</> عِلْ<k>مٌۭ فَ</>لَا تُطِعْهُمَا ۖ وَصَاحِ<q>بْ</>هُمَا فِى <h>ٱ</><l>ل</>دُّنْيَا مَعْرُو<d>فًۭا ۖ وَ</><h>ٱ</>تَّبِعْ سَبِيلَ مَنْ أَنَابَ إِلَىَّ ۚ ثُ<g>مَّ</> إِلَىَّ مَرْجِعُكُمْ فَأُنَبِّئُ<f>كُم بِ</>مَا كُ<k>نتُ</>مْ تَعْمَ<p>لُو</>نَ"},{"n":16,"w":[["يَـٰبُنَىَّ","yābunayya","O my son","\"হে আমার পুত্র"],["إِنَّهَآ","innahā","Indeed it","নিশ্চয়ই তা"],["إِن","in","if","যদি"],["تَكُ","taku","it be","তা হয়"],["مِثْقَالَ","mith'qāla","(the) weight","পরিমাণ"],["حَبَّةٍۢ","ḥabbatin","(of) a grain","দানার"],["مِّنْ","min","of","মধ্যকার"],["خَرْدَلٍۢ","khardalin","a mustard seed","সরিষার"],["فَتَكُن","fatakun","and it be","অতঃপর তা হয়"],["فِى","fī","in","মধ্যে"],["صَخْرَةٍ","ṣakhratin","a rock","শিলাখন্ডের"],["أَوْ","aw","or","অথবা"],["فِى","fī","in","মধ্যে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আসমানসমূহের"],["أَوْ","aw","or","অথবা"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","জমিনের"],["يَأْتِ","yati","Allah will bring it forth","আসবেন"],["بِهَا","bihā","Allah will bring it forth","নিয়ে তাকে (তাকে বের করে আনবেন)"],["ٱللَّهُ ۚ","l-lahu","Allah will bring it forth","আল্লাহ"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَطِيفٌ","laṭīfun","(is) All-Subtle","সূক্ষ্মদর্শী"],["خَبِيرٌۭ","khabīrun","All-Aware","খুব অবহিত"]],"t":"<m>يَٰ</>بُنَىَّ إِ<g>نَّ</><o>هَآ</> إِ<k>ن تَ</>كُ مِثْقَالَ حَبَّ<d>ةٍۢ مِّ</>نْ خَرْدَ<k>لٍۢ فَ</>تَكُ<k>ن فِ</>ى صَخْرَةٍ أَوْ فِى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ أَوْ فِى <h>ٱ</>لْأَرْضِ يَأْتِ بِهَا <h>ٱ</>للَّهُ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ لَطِيفٌ خَ<p>بِي</>رٌۭ"},{"n":17,"w":[["يَـٰبُنَىَّ","yābunayya","O my son","হে আমার পুত্র"],["أَقِمِ","aqimi","Establish","প্রতিষ্ঠা করো"],["ٱلصَّلَوٰةَ","l-ṣalata","the prayer","সালাত"],["وَأْمُرْ","wamur","and enjoin","ও নির্দেশ দাও"],["بِٱلْمَعْرُوفِ","bil-ma‘rūfi","[with] the right","প্রতি সৎকাজের"],["وَٱنْهَ","wa-in'ha","and forbid","এবং নিষেধ করো"],["عَنِ","‘ani","from","থেকে"],["ٱلْمُنكَرِ","l-munkari","the wrong","অসৎকাজ"],["وَٱصْبِرْ","wa-iṣ'bir","and be patient","এবং ধৈর্য ধরো"],["عَلَىٰ","‘alā","over","(ঐ বিষয়ের) উপর"],["مَآ","mā","what","যা"],["أَصَابَكَ ۖ","aṣābaka","befalls you","তোমার উপর আপতিত হবে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ذَٰلِكَ","dhālika","that","এটা"],["مِنْ","min","(is) of","অন্তর্ভুক্ত"],["عَزْمِ","‘azmi","the matters requiring determination","দৃঢ় সংকল্পের (সাহসের)"],["ٱلْأُمُورِ","l-umūri","the matters requiring determination","কাজসমূহের"]],"t":"<m>يَٰ</>بُنَىَّ أَقِمِ <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةَ وَأْمُرْ بِ<h>ٱ</>لْمَعْرُوفِ وَ<h>ٱ</>نْهَ عَنِ <h>ٱ</>لْمُ<k>نكَ</>رِ وَ<h>ٱ</>صْبِرْ عَلَىٰ <o>مَآ</> أَصَابَكَ ۖ إِ<g>نَّ</> <m>ذَٰ</>لِكَ مِنْ عَزْمِ <h>ٱ</>لْأُ<p>مُو</>رِ"},{"n":18,"w":[["وَلَا","walā","And (do) not","এবং না"],["تُصَعِّرْ","tuṣa‘‘ir","turn","তুমি ফিরাও"],["خَدَّكَ","khaddaka","your cheek","তোমার গাল"],["لِلنَّاسِ","lilnnāsi","from men","থেকে মানুষের"],["وَلَا","walā","and (do) not","আর না"],["تَمْشِ","tamshi","walk","চলো"],["فِى","fī","in","উপর"],["ٱلْأَرْضِ","l-arḍi","the earth","জমিনের"],["مَرَحًا ۖ","maraḥan","exultantly","দেমাক করে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَا","lā","(does) not","না"],["يُحِبُّ","yuḥibbu","like","ভালোবাসেন"],["كُلَّ","kulla","every","কোনো"],["مُخْتَالٍۢ","mukh'tālin","self-conceited","উদ্ধত"],["فَخُورٍۢ","fakhūrin","boaster","অহংকারীকে"]],"t":"وَلَا تُصَعِّرْ خَدَّكَ لِل<g>نَّ</>اسِ وَلَا تَمْشِ فِى <h>ٱ</>لْأَرْضِ مَرَحًا ۖ إِ<g>نَّ</> <h>ٱ</>للَّهَ لَا يُحِبُّ كُلَّ مُخْتَا<k>لٍۢ فَ</><p>خُو</>رٍۢ"},{"n":19,"w":[["وَٱقْصِدْ","wa-iq'ṣid","And be moderate","এবং মধ্যম পন্থা অবলম্বন করো"],["فِى","fī","in","ক্ষেত্রে"],["مَشْيِكَ","mashyika","your pace","তোমার চলার"],["وَٱغْضُضْ","wa-ugh'ḍuḍ","and lower","এবং নিচু করো"],["مِن","min","[of]","থেকে"],["صَوْتِكَ ۚ","ṣawtika","your voice","তোমার কণ্ঠস্বর"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["أَنكَرَ","ankara","(the) harshest","অধিক শ্রুতিকটু"],["ٱلْأَصْوَٰتِ","l-aṣwāti","(of all) sounds","স্বরসমূহের মধ্যে"],["لَصَوْتُ","laṣawtu","(is) surely (the) voice","অবশ্যই আওয়াজ"],["ٱلْحَمِيرِ","l-ḥamīri","(of) the donkeys","গাধার\""]],"t":"وَ<h>ٱ</><q>قْصِدْ</> فِى مَشْيِكَ وَ<h>ٱ</>غْضُضْ مِ<k>ن صَ</>وْتِكَ ۚ إِ<g>نَّ</> أَ<k>نكَ</>رَ <h>ٱ</>لْأَصْ<m>وَٰ</>تِ لَصَوْتُ <h>ٱ</>لْحَ<p>مِي</>رِ"},{"n":20,"w":[["أَلَمْ","alam","Do not","কি না"],["تَرَوْا۟","taraw","you see","তোমরা দেখো"],["أَنَّ","anna","that","যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["سَخَّرَ","sakhara","has subjected","অধীন করে দিয়েছেন"],["لَكُم","lakum","to you","জন্যে তোমাদের"],["مَّا","mā","whatever","যা"],["فِى","fī","(is) in","মধ্যে (আছে)"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশমন্ডলীর"],["وَمَا","wamā","and whatever","ও যা"],["فِى","fī","(is) in","মধ্যে (আছে)"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["وَأَسْبَغَ","wa-asbagha","and amply bestowed","এবং সম্পূর্ণ করে দিয়েছেন"],["عَلَيْكُمْ","‘alaykum","upon you","উপর তোমাদের"],["نِعَمَهُۥ","ni‘amahu","His Bounties","অনুগ্রহসমূহ তাঁর"],["ظَـٰهِرَةًۭ","ẓāhiratan","apparent","প্রকাশ্য"],["وَبَاطِنَةًۭ ۗ","wabāṭinatan","and hidden","ও অপ্রকাশ্য"],["وَمِنَ","wamina","But of","এবং মধ্যে"],["ٱلنَّاسِ","l-nāsi","the people","মানুষের"],["مَن","man","(is he) who","কেউ কেউ (এমনও আছে)"],["يُجَـٰدِلُ","yujādilu","disputes","তর্ক করে"],["فِى","fī","about","সম্পর্কে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["بِغَيْرِ","bighayri","without","ছাড়া"],["عِلْمٍۢ","‘il'min","knowledge","কোনো জ্ঞান"],["وَلَا","walā","and not","আর না"],["هُدًۭى","hudan","guidance","কোনো পথনির্দেশ"],["وَلَا","walā","and not","আর না"],["كِتَـٰبٍۢ","kitābin","a book","কোনো কিতাব"],["مُّنِيرٍۢ","munīrin","enlightening","দীপ্তিময়"]],"t":"أَلَمْ تَرَوْ<s>ا۟</> أَ<g>نَّ</> <h>ٱ</>للَّهَ سَخَّرَ لَ<y>كُم مَّ</>ا فِى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَمَا فِى <h>ٱ</>لْأَرْضِ وَأَسْبَغَ عَلَيْكُمْ نِعَمَهُ<m>ۥ ظَٰ</>هِرَ<d>ةًۭ وَ</>بَاطِنَ<d>ةًۭ ۗ وَ</>مِنَ <h>ٱ</><l>ل</><g>نَّ</>اسِ <d>مَن يُ</><m>جَٰ</>دِلُ فِى <h>ٱ</>للَّهِ بِغَيْرِ عِلْ<d>مٍۢ وَ</>لَا هُ<d>دًۭى وَ</>لَا كِ<m>تَٰ</><d>بٍۢ مُّ</><p>نِي</>رٍۢ"},{"n":21,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["قِيلَ","qīla","it is said","বলা হয়"],["لَهُمُ","lahumu","to them","তাদেরকে"],["ٱتَّبِعُوا۟","ittabi‘ū","Follow","\"তোমরা অনুসরণ করো"],["مَآ","mā","what","যা"],["أَنزَلَ","anzala","Allah (has) revealed","অবতীর্ণ করেছেন\""],["ٱللَّهُ","l-lahu","Allah (has) revealed","আল্লাহ\""],["قَالُوا۟","qālū","they say","তারা বলে"],["بَلْ","bal","Nay","\"বরং"],["نَتَّبِعُ","nattabi‘u","we will follow","আমরা অনুসরণ করবো"],["مَا","mā","what","যা"],["وَجَدْنَا","wajadnā","we found","আমরা পেয়েছি"],["عَلَيْهِ","‘alayhi","on it","উপর তার"],["ءَابَآءَنَآ ۚ","ābāanā","our forefathers","আমার পিতৃ-পুরুষদেরকে\""],["أَوَلَوْ","awalaw","Even if","কি যদিও"],["كَانَ","kāna","Shaitaan was","হলো"],["ٱلشَّيْطَـٰنُ","l-shayṭānu","Shaitaan was","শয়তান (এমন যে)"],["يَدْعُوهُمْ","yad‘ūhum","(to) call them","ডেকে আসছে তাদেরকে"],["إِلَىٰ","ilā","to","দিকে"],["عَذَابِ","‘adhābi","(the) punishment","শাস্তির"],["ٱلسَّعِيرِ","l-sa‘īri","(of) the Blaze","জ্বলন্ত আগুনের (তবুও অনুসরণ করবেই)"]],"t":"وَإِذَا قِيلَ لَهُمُ <h>ٱ</>تَّبِعُو<s>ا۟</> <o>مَآ</> أَ<k>نزَ</>لَ <h>ٱ</>للَّهُ قَالُو<s>ا۟</> بَلْ نَتَّبِعُ مَا وَجَ<q>دْ</>نَا عَلَيْهِ ءَا<o>بَآءَنَآ ۚ</> أَوَلَوْ كَانَ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نُ يَ<q>دْ</>عُوهُمْ إِلَىٰ عَذَابِ <h>ٱ</><l>ل</>سَّ<p>عِي</>رِ"},{"n":22,"w":[["۞ وَمَن","waman","And whoever","এবং যে"],["يُسْلِمْ","yus'lim","submits","সমর্পণ করে"],["وَجْهَهُۥٓ","wajhahu","his face","চেহারাকে (নিজেকে) তার"],["إِلَى","ilā","to","কাছে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["وَهُوَ","wahuwa","while he","এমতাবস্হায় যে সে"],["مُحْسِنٌۭ","muḥ'sinun","(is) a good-doer","সৎকর্মপরায়ণ"],["فَقَدِ","faqadi","then indeed","তবে নিশ্চয়ই"],["ٱسْتَمْسَكَ","is'tamsaka","he has grasped","সে শক্ত করে ধরেছে"],["بِٱلْعُرْوَةِ","bil-‘ur'wati","the handhold","নিয়ে হাতলকে (অর্থাৎ আশ্রয়কে)"],["ٱلْوُثْقَىٰ ۗ","l-wuth'qā","the most trustworthy","সুদৃঢ়"],["وَإِلَى","wa-ilā","And to","এবং দিকে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌রই"],["عَـٰقِبَةُ","‘āqibatu","(is the) end","পরিণাম"],["ٱلْأُمُورِ","l-umūri","(of) the matters","সব ব্যাপারের"]],"t":"۞ وَ<d>مَن يُ</>سْلِمْ وَ<q>جْ</>هَهُ<o>ۥٓ</> إِلَى <h>ٱ</>للَّهِ وَهُوَ مُحْسِ<k>نٌۭ فَ</>قَدِ <h>ٱ</>سْتَمْسَكَ بِ<h>ٱ</>لْعُرْوَةِ <h>ٱ</>لْوُثْقَىٰ ۗ وَإِلَى <h>ٱ</>للَّهِ <m>عَٰ</>قِبَةُ <h>ٱ</>لْأُ<p>مُو</>رِ"},{"n":23,"w":[["وَمَن","waman","And whoever","এবং যে"],["كَفَرَ","kafara","disbelieves","অবিশ্বাস করলো"],["فَلَا","falā","let not","অতঃপর না (যেন)"],["يَحْزُنكَ","yaḥzunka","grieve you","চিন্তিত করে তোমাকে"],["كُفْرُهُۥٓ ۚ","kuf'ruhu","his disbelief","অবিশ্বাস তার"],["إِلَيْنَا","ilaynā","To Us","দিকে আমাদেরই"],["مَرْجِعُهُمْ","marji‘uhum","(is) their return","প্রত্যাবর্তন তাদের ( হবে )"],["فَنُنَبِّئُهُم","fanunabbi-uhum","then We will inform them","তখন আমরা জানিয়ে দিবো তাদের"],["بِمَا","bimā","of what","ঐ বিষয়ে যা"],["عَمِلُوٓا۟ ۚ","‘amilū","they did","তারা করেছে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["عَلِيمٌۢ","‘alīmun","(is) the All-Knower","খুব অবহিত"],["بِذَاتِ","bidhāti","of what","সম্পর্কে অবস্থা"],["ٱلصُّدُورِ","l-ṣudūri","(is in) the breasts","অন্তরসমূহের"]],"t":"وَمَ<k>ن كَ</>فَرَ فَلَا يَحْزُ<k>نكَ</> كُفْرُهُ<o>ۥٓ ۚ</> إِلَيْنَا مَرْجِعُهُمْ فَنُنَبِّئُ<f>هُم بِ</>مَا عَمِ<o>لُوٓ</><s>ا۟</> ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ عَلِي<i>مٌۢ بِ</>ذَاتِ <h>ٱ</><l>ل</>صُّ<p>دُو</>رِ"},{"n":24,"w":[["نُمَتِّعُهُمْ","numatti‘uhum","We grant them enjoyment","আমরা ভোগ করতে দিবো তাদেরকে"],["قَلِيلًۭا","qalīlan","(for) a little","অল্প (কাল)"],["ثُمَّ","thumma","then","এরপর"],["نَضْطَرُّهُمْ","naḍṭarruhum","We will force them","আমরা বাধ্য করবো তাদেরকে"],["إِلَىٰ","ilā","to","দিকে"],["عَذَابٍ","‘adhābin","a punishment","শাস্তির"],["غَلِيظٍۢ","ghalīẓin","severe","কঠিন"]],"t":"نُمَتِّعُهُمْ قَلِيلًۭ<k>ا ثُ</><g>مَّ</> نَضْطَرُّهُمْ إِلَىٰ عَذَابٍ غَ<p>لِي</>ظٍۢ"},{"n":25,"w":[["وَلَئِن","wala-in","And if","এবং অবশ্যই যদি"],["سَأَلْتَهُم","sa-altahum","you ask them","তুমি প্রশ্ন করো তাদের"],["مَّنْ","man","Who","\"কে"],["خَلَقَ","khalaqa","created","সৃষ্টি করেছেন"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশ মন্ডলী"],["وَٱلْأَرْضَ","wal-arḍa","and the earth","ও পৃথিবী\""],["لَيَقُولُنَّ","layaqūlunna","They will surely say","অবশ্যই তারা বলবে"],["ٱللَّهُ ۚ","l-lahu","Allah","\"আল্লাহ্‌\""],["قُلِ","quli","Say","বলো"],["ٱلْحَمْدُ","l-ḥamdu","All praises","\"সব প্রশংসা"],["لِلَّهِ ۚ","lillahi","(are) for Allah","জন্যে আল্লাহ্‌রই\""],["بَلْ","bal","But","কিন্তু"],["أَكْثَرُهُمْ","aktharuhum","most of them","অধিকাংশ (লোক) তাদের"],["لَا","lā","(do) not","না"],["يَعْلَمُونَ","ya‘lamūna","know","তারা জানে"]],"t":"وَلَئِ<k>ن سَ</>أَلْتَ<y>هُم مَّ</>نْ خَلَقَ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضَ لَيَقُولُ<g>نَّ</> <h>ٱ</>للَّهُ ۚ قُلِ <h>ٱ</>لْحَمْدُ لِلَّهِ ۚ بَلْ أَكْثَرُهُمْ لَا يَعْلَ<p>مُو</>نَ"},{"n":26,"w":[["لِلَّهِ","lillahi","To Allah (belongs)","জন্যে আল্লাহ্‌রই"],["مَا","mā","whatever","যা কিছু"],["فِى","fī","(is) in","মধ্যে (আছে)"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশমন্ডলীর"],["وَٱلْأَرْضِ ۚ","wal-arḍi","and the earth","ও পৃথিবীর"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["هُوَ","huwa","He","তিনিই"],["ٱلْغَنِىُّ","l-ghaniyu","(is) Free of need","অভাবমুক্ত"],["ٱلْحَمِيدُ","l-ḥamīdu","the Praiseworthy","প্রশংসিত"]],"t":"لِلَّهِ مَا فِى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ هُوَ <h>ٱ</>لْغَنِىُّ <h>ٱ</>لْحَ<p>مِي</><q>دُ</>"},{"n":27,"w":[["وَلَوْ","walaw","And if","এবং যদি (হয়)"],["أَنَّمَا","annamā","whatever","নিশ্চয়ই যা কিছু"],["فِى","fī","(is) in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["مِن","min","of","দিয়ে"],["شَجَرَةٍ","shajaratin","(the) trees","গাছ"],["أَقْلَـٰمٌۭ","aqlāmun","(were) pens","কলমসমূহ"],["وَٱلْبَحْرُ","wal-baḥru","and the sea","এবং সমুদ্র(কালি হয়)"],["يَمُدُّهُۥ","yamudduhu","(to) add to it","বৃদ্ধি করে তাকে"],["مِنۢ","min","after it","থেকেও"],["بَعْدِهِۦ","ba‘dihi","after it","পর তার"],["سَبْعَةُ","sab‘atu","seven","সাত"],["أَبْحُرٍۢ","abḥurin","seas","সমুদ্র ( এবং রবের কথা লেখা হয় )"],["مَّا","mā","not","(তবুও) না (এবং রবের কথা লেখা হয়)"],["نَفِدَتْ","nafidat","would be exhausted","শেষ হবে"],["كَلِمَـٰتُ","kalimātu","(the) Words","কথাগুলো (লেখা)"],["ٱللَّهِ ۗ","l-lahi","(of) Allah","আল্লাহর"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["عَزِيزٌ","‘azīzun","(is) All-Mighty","মহাপরাক্রমশালী"],["حَكِيمٌۭ","ḥakīmun","All-Wise","প্রজ্ঞাময়"]],"t":"وَلَوْ أَ<g>نَّ</>مَا فِى <h>ٱ</>لْأَرْضِ مِ<k>ن شَ</>جَرَةٍ أَ<q>قْ</><m>لَٰ</><d>مٌۭ وَ</><h>ٱ</>لْبَحْرُ يَمُدُّهُ<m>ۥ</> <i>مِنۢ بَ</>عْدِ<m>هِۦ</> سَ<q>بْ</>عَةُ أَ<q>بْ</>حُ<d>رٍۢ مَّ</>ا نَفِدَتْ كَلِ<m>مَٰ</>تُ <h>ٱ</>للَّهِ ۗ إِ<g>نَّ</> <h>ٱ</>للَّهَ عَزِيزٌ حَ<p>كِي</>مٌۭ"},{"n":28,"w":[["مَّا","mā","Not","নয়"],["خَلْقُكُمْ","khalqukum","(is) your creation","সৃষ্টি তোমাদের"],["وَلَا","walā","and not","আর না"],["بَعْثُكُمْ","ba‘thukum","your resurrection","উত্থান তোমাদের"],["إِلَّا","illā","but","এ ছাড়া"],["كَنَفْسٍۢ","kanafsin","as a soul","মতো(সৃষ্টি ও উত্থান)প্রাণীর"],["وَٰحِدَةٍ ۗ","wāḥidatin","single","একটিমাত্র"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["سَمِيعٌۢ","samī‘un","(is) All-Hearer","সব শুনেন"],["بَصِيرٌ","baṣīrun","All-Seer","সব দেখেন"]],"t":"مَّا خَلْقُكُمْ وَلَا بَعْثُكُمْ إِلَّا كَنَفْ<d>سٍۢ وَٰ</>حِدَةٍ ۗ إِ<g>نَّ</> <h>ٱ</>للَّهَ سَمِي<i>عٌۢ بَ</><p>صِي</>رٌ"},{"n":29,"w":[["أَلَمْ","alam","Do not","কি না"],["تَرَ","tara","you see","তুমি দেখো"],["أَنَّ","anna","that","যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يُولِجُ","yūliju","causes to enter","প্রবেশ করান"],["ٱلَّيْلَ","al-layla","the night","রাতকে"],["فِى","fī","into","মধ্যে"],["ٱلنَّهَارِ","l-nahāri","the day","দিনের"],["وَيُولِجُ","wayūliju","and causes to enter","ও প্রবেশ করান"],["ٱلنَّهَارَ","l-nahāra","the day","দিনকে"],["فِى","fī","into","মধ্যে"],["ٱلَّيْلِ","al-layli","the night","রাতের"],["وَسَخَّرَ","wasakhara","and has subjected","এবং নিয়মাধীন করেছেন"],["ٱلشَّمْسَ","l-shamsa","the sun","সূর্যকে"],["وَٱلْقَمَرَ","wal-qamara","and the moon","ও চাঁদকে"],["كُلٌّۭ","kullun","each","প্রত্যেকে"],["يَجْرِىٓ","yajrī","moving","চলছে"],["إِلَىٰٓ","ilā","for","পর্যন্ত"],["أَجَلٍۢ","ajalin","a term","কাল"],["مُّسَمًّۭى","musamman","appointed","নির্দিষ্ট"],["وَأَنَّ","wa-anna","and that","এবং নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["بِمَا","bimā","of what","ঐ বিষয়ে যা"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা করছো"],["خَبِيرٌۭ","khabīrun","(is) All-Aware","খুব অবহিত"]],"t":"أَلَمْ تَرَ أَ<g>نَّ</> <h>ٱ</>للَّهَ يُولِجُ <h>ٱ</>لَّيْلَ فِى <h>ٱ</><l>ل</><g>نَّ</>هَارِ وَيُولِجُ <h>ٱ</><l>ل</><g>نَّ</>هَارَ فِى <h>ٱ</>لَّيْلِ وَسَخَّرَ <h>ٱ</><l>ل</>شَّمْسَ وَ<h>ٱ</>لْقَمَرَ كُ<d>لٌّۭ يَ</><q>جْ</><o>رِىٓ</> إِلَ<o>ىٰٓ</> أَجَ<d>لٍۢ مُّسَمًّۭى وَ</>أَ<g>نَّ</> <h>ٱ</>للَّهَ بِمَا تَعْمَلُونَ خَ<p>بِي</>رٌۭ"},{"n":30,"w":[["ذَٰلِكَ","dhālika","That","এটা"],["بِأَنَّ","bi-anna","(is) because","একারণে যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["هُوَ","huwa","He","তিনিই"],["ٱلْحَقُّ","l-ḥaqu","(is) the Truth","সত্য"],["وَأَنَّ","wa-anna","and that","এবং (এও) যে"],["مَا","mā","what","যাকে"],["يَدْعُونَ","yad‘ūna","they call","তারা ডাকছে"],["مِن","min","besides Him","ছাড়া"],["دُونِهِ","dūnihi","besides Him","তাঁকে"],["ٱلْبَـٰطِلُ","l-bāṭilu","(is) [the] falsehood","( তা সবই )অসত্য"],["وَأَنَّ","wa-anna","and that","এবং (এও সত্য) যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["هُوَ","huwa","He","তিনিই"],["ٱلْعَلِىُّ","l-‘aliyu","(is) the Most High","সমুন্নত"],["ٱلْكَبِيرُ","l-kabīru","the Most Great","সুমহান"]],"t":"<m>ذَٰ</>لِكَ بِأَ<g>نَّ</> <h>ٱ</>للَّهَ هُوَ <h>ٱ</>لْحَقُّ وَأَ<g>نَّ</> مَا يَ<q>دْ</>عُونَ مِ<k>ن دُ</>ونِهِ <h>ٱ</>لْ<m>بَٰ</>طِلُ وَأَ<g>نَّ</> <h>ٱ</>للَّهَ هُوَ <h>ٱ</>لْعَلِىُّ <h>ٱ</>لْكَ<p>بِي</>رُ"},{"n":31,"w":[["أَلَمْ","alam","Do not","কি না"],["تَرَ","tara","you see","তুমি দেখো"],["أَنَّ","anna","that","যে"],["ٱلْفُلْكَ","l-ful'ka","the ships","জলযান"],["تَجْرِى","tajrī","sail","চলে"],["فِى","fī","through","মধ্যে"],["ٱلْبَحْرِ","l-baḥri","the sea","সমুদ্রের"],["بِنِعْمَتِ","bini‘'mati","by (the) Grace","সাহায্যে অনুগ্রহের"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["لِيُرِيَكُم","liyuriyakum","that He may show you","যেন তিনি তোমাদের দেখান"],["مِّنْ","min","of","কিছু"],["ءَايَـٰتِهِۦٓ ۚ","āyātihi","His Signs","নির্দেশাবলী তাঁর"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে (আছে)"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَـٰتٍۢ","laāyātin","surely (are) Signs","অবশ্যই নিদর্শনাবলী"],["لِّكُلِّ","likulli","for everyone","জন্যে প্রত্যেক"],["صَبَّارٍۢ","ṣabbārin","(who is) patient","ধৈর্যশীলের"],["شَكُورٍۢ","shakūrin","grateful","কৃতজ্ঞের"]],"t":"أَلَمْ تَرَ أَ<g>نَّ</> <h>ٱ</>لْفُلْكَ تَ<q>جْ</>رِى فِى <h>ٱ</>لْبَحْرِ بِنِعْمَتِ <h>ٱ</>للَّهِ لِيُرِيَ<y>كُم مِّ</>نْ ءَا<m>يَٰ</>تِ<o>هِۦٓ ۚ</> إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَا<m>يَٰ</><w>تٍۢ لِّ</>كُلِّ صَبَّا<k>رٍۢ شَ</><p>كُو</>رٍۢ"},{"n":32,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["غَشِيَهُم","ghashiyahum","covers them","ঢেকে ফেলে তাদের"],["مَّوْجٌۭ","mawjun","a wave","ঢেউ"],["كَٱلظُّلَلِ","kal-ẓulali","like canopies","মতো চাঁদোয়ার"],["دَعَوُا۟","da‘awū","they call","তারা ডাকে"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["مُخْلِصِينَ","mukh'liṣīna","(being) sincere","বিশুদ্ধ করে"],["لَهُ","lahu","to Him","জন্যে তাঁর"],["ٱلدِّينَ","l-dīna","(in) religion","আনুগত্যকে"],["فَلَمَّا","falammā","But when","অতঃপর যখন"],["نَجَّىٰهُمْ","najjāhum","He delivers them","তিনিই উদ্ধার করেন তাদেরকে"],["إِلَى","ilā","to","দিকে"],["ٱلْبَرِّ","l-bari","the land","স্থলের"],["فَمِنْهُم","famin'hum","then among them","তখন মধ্যে তাদের (কেউ কেউ)"],["مُّقْتَصِدٌۭ ۚ","muq'taṣidun","(some are) moderate","মধ্যম নীতি গ্রহন করে"],["وَمَا","wamā","And not","এবং না"],["يَجْحَدُ","yajḥadu","deny","অস্বীকার করে (আর কেউ)"],["بِـَٔايَـٰتِنَآ","biāyātinā","Our Signs","প্রতি আমাদের নিদর্শনগুলোর"],["إِلَّا","illā","except","এ ছাড়া"],["كُلُّ","kullu","every","প্রত্যেক"],["خَتَّارٍۢ","khattārin","traitor","বিশ্বাসঘাতক"],["كَفُورٍۢ","kafūrin","ungrateful","অকৃতজ্ঞ"]],"t":"وَإِذَا غَشِيَ<y>هُم مَّ</>وْ<k>جٌۭ كَ</><h>ٱ</><l>ل</>ظُّلَلِ دَعَوُ<s>ا۟</> <h>ٱ</>للَّهَ مُخْلِصِينَ لَهُ <h>ٱ</><l>ل</>دِّينَ فَلَ<g>مَّ</>ا نَجَّ<m>ىٰ</>هُمْ إِلَى <h>ٱ</>لْبَرِّ فَمِنْ<y>هُم مُّ</><q>قْ</>تَصِ<d>دٌۭ ۚ وَ</>مَا يَ<q>جْ</>حَدُ بِـَٔا<m>يَٰ</>تِ<o>نَآ</> إِلَّا كُلُّ خَتَّا<k>رٍۢ كَ</><p>فُو</>رٍۢ"},{"n":33,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O","হে"],["ٱلنَّاسُ","l-nāsu","mankind","মানব সম্প্রদায়"],["ٱتَّقُوا۟","ittaqū","Fear","তোমরা ভয় করো"],["رَبَّكُمْ","rabbakum","your Lord","রবকে তোমাদের"],["وَٱخْشَوْا۟","wa-ikh'shaw","and fear","এবং ভয় করো"],["يَوْمًۭا","yawman","a Day","সেই দিনকে (যখন)"],["لَّا","lā","not","না"],["يَجْزِى","yajzī","can avail","প্রতিদান দিবে"],["وَالِدٌ","wālidun","a father","কোনো পিতা"],["عَن","‘an","[for]","পক্ষ হ'তে"],["وَلَدِهِۦ","waladihi","his son","সন্তানের তার"],["وَلَا","walā","and not","আর না"],["مَوْلُودٌ","mawlūdun","a son","কোনো সন্তান"],["هُوَ","huwa","he","সে"],["جَازٍ","jāzin","(can) avail","প্রতিদান দাতা হবে"],["عَن","‘an","[for]","পক্ষ হ'তে"],["وَالِدِهِۦ","wālidihi","his father","পিতার তার"],["شَيْـًٔا ۚ","shayan","anything","কিছুমাত্র"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["وَعْدَ","wa‘da","(the) Promise","প্রতিশ্রুতি"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["حَقٌّۭ ۖ","ḥaqqun","(is) True","সত্য"],["فَلَا","falā","so let not deceive you","সুতরাং না(যেন)"],["تَغُرَّنَّكُمُ","taghurrannakumu","so let not deceive you","ধোঁকায় ফেলে তোমাদেরকে"],["ٱلْحَيَوٰةُ","l-ḥayatu","the life","জীবন"],["ٱلدُّنْيَا","l-dun'yā","(of) the world","পার্থিব"],["وَلَا","walā","and let not deceive you","আর না"],["يَغُرَّنَّكُم","yaghurrannakum","and let not deceive you","ধোঁকায় ফেলে তোমাদেরকে"],["بِٱللَّهِ","bil-lahi","about Allah","ব্যাপারে আল্লাহর"],["ٱلْغَرُورُ","l-gharūru","the deceiver","কোনো ধোঁকাবাজ (জীন , শয়তান বা মানুষ)"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</><l>ل</><g>نَّ</>اسُ <h>ٱ</>تَّقُو<s>ا۟</> رَبَّكُمْ وَ<h>ٱ</>خْشَوْ<s>ا۟</> يَوْ<w>مًۭا لَّ</>ا يَ<q>جْ</>زِى وَالِدٌ <d>عَن وَ</>لَدِ<m>هِۦ</> وَلَا مَوْلُودٌ هُوَ جَازٍ <d>عَن وَ</>الِدِ<m>هِۦ</> شَيْـًٔا ۚ إِ<g>نَّ</> وَعْدَ <h>ٱ</>للَّهِ حَ<k>قٌّۭ ۖ فَ</>لَا تَغُرَّ<g>نَّ</>كُمُ <h>ٱ</>لْحَيَ<s>وٰ</>ةُ <h>ٱ</><l>ل</>دُّنْيَا وَلَا يَغُرَّ<g>نَّ</><f>كُم بِ</><h>ٱ</>للَّهِ <h>ٱ</>لْغَ<p>رُو</>رُ"},{"n":34,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ (এমন সত্ত্বা)"],["عِندَهُۥ","‘indahu","with Him","কাছে তাঁরই (আছে)"],["عِلْمُ","‘il'mu","(is the) knowledge","জ্ঞান"],["ٱلسَّاعَةِ","l-sā‘ati","(of) the Hour","ক্বিয়ামাতের"],["وَيُنَزِّلُ","wayunazzilu","and He sends down","এবং তিনিই বর্ষণ করেন"],["ٱلْغَيْثَ","l-ghaytha","the rain","বৃষ্টি"],["وَيَعْلَمُ","waya‘lamu","and knows","এবং তিনিই জানেন"],["مَا","mā","what","যা কিছু"],["فِى","fī","(is) in","মধ্যে(আছে)"],["ٱلْأَرْحَامِ ۖ","l-arḥāmi","the wombs","জরায়ুসমূহের"],["وَمَا","wamā","And not","এবং না"],["تَدْرِى","tadrī","knows","জানে"],["نَفْسٌۭ","nafsun","any soul","কোনো প্রাণীই"],["مَّاذَا","mādhā","what","কি"],["تَكْسِبُ","taksibu","it will earn","সে অর্জন করবে"],["غَدًۭا ۖ","ghadan","tomorrow","আগামীকাল"],["وَمَا","wamā","and not","এবং না"],["تَدْرِى","tadrī","knows","জানে"],["نَفْسٌۢ","nafsun","any soul","কোনো প্রাণীই"],["بِأَىِّ","bi-ayyi","in what","কোনো"],["أَرْضٍۢ","arḍin","land","জমিনে"],["تَمُوتُ ۚ","tamūtu","it will die","সে মরবে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["عَلِيمٌ","‘alīmun","(is) All-Knower","সবকিছু জানেন"],["خَبِيرٌۢ","khabīrun","All-Aware","সব বিষয়ে অবহিত"]],"t":"إِ<g>نَّ</> <h>ٱ</>للَّهَ عِ<k>ندَ</>هُ<m>ۥ</> عِلْمُ <h>ٱ</><l>ل</>سَّاعَةِ وَيُنَزِّلُ <h>ٱ</>لْغَيْثَ وَيَعْلَمُ مَا فِى <h>ٱ</>لْأَرْحَامِ ۖ وَمَا تَ<q>دْ</>رِى نَفْ<d>سٌۭ مَّ</>اذَا تَكْسِبُ غَ<d>دًۭا ۖ وَ</>مَا تَ<q>دْ</>رِى نَفْ<i>سٌۢ بِ</>أَىِّ أَرْ<k>ضٍۢ تَ</>مُوتُ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ عَلِيمٌ خَ<p>بِي</>رٌۢ"}]}