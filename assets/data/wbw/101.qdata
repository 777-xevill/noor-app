{"n":101,"a":[{"n":1,"w":[["ٱلْقَارِعَةُ","al-qāri‘atu","The Striking Calamity","মহাপ্রলয়"]],"t":"ٱلْقَارِعَةُ"},{"n":2,"w":[["مَا","mā","What","কি সেই"],["ٱلْقَارِعَةُ","l-qāri‘atu","(is) the Striking Calamity","মহাপ্রলয়"]],"t":"مَا <h>ٱ</>لْقَارِعَةُ"},{"n":3,"w":[["وَمَآ","wamā","And what","এবং কিসে"],["أَدْرَىٰكَ","adrāka","will make you know","তোমাকে জানাবে"],["مَا","mā","what","মহাপ্রলয়"],["ٱلْقَارِعَةُ","l-qāri‘atu","(is) the Striking Calamity","ভয়াবহ দুর্ঘটনা"]],"t":"وَ<o>مَآ</> أَ<q>دْ</>رَ<m>ىٰ</>كَ مَا <h>ٱ</>لْقَارِعَةُ"},{"n":4,"w":[["يَوْمَ","yawma","(The) Day","সেদিন"],["يَكُونُ","yakūnu","will be","হবে"],["ٱلنَّاسُ","l-nāsu","the mankind","মানুষ"],["كَٱلْفَرَاشِ","kal-farāshi","like moths","পতঙ্গের মতো"],["ٱلْمَبْثُوثِ","l-mabthūthi","scattered","বিক্ষিপ্ত"]],"t":"يَوْمَ يَكُونُ <h>ٱ</><l>ل</><g>نَّ</>اسُ كَ<h>ٱ</>لْفَرَاشِ <h>ٱ</>لْمَ<q>بْ</><p>ثُو</>ثِ"},{"n":5,"w":[["وَتَكُونُ","watakūnu","And will be","এবং হবে"],["ٱلْجِبَالُ","l-jibālu","the mountains","পাহাড়সমূহ"],["كَٱلْعِهْنِ","kal-‘ih'ni","like wool","রঙিন পশমের মতো"],["ٱلْمَنفُوشِ","l-manfūshi","fluffed up","ধুনিত"]],"t":"وَتَكُونُ <h>ٱ</>لْجِبَالُ كَ<h>ٱ</>لْعِهْنِ <h>ٱ</>لْمَ<k>نفُ</><p>و</>شِ"},{"n":6,"w":[["فَأَمَّا","fa-ammā","Then as for","অতঃপর তার (ব্যাপার)"],["مَن","man","(him) whose","যার"],["ثَقُلَتْ","thaqulat","(are) heavy","ভারী হবে"],["مَوَٰزِينُهُۥ","mawāzīnuhu","his scales","তার (পূণ্যের) পাল্লাসমূহ"]],"t":"فَأَ<g>مَّ</>ا مَ<k>ن ثَ</>قُلَتْ مَ<m>وَٰ</>زِينُهُۥ"},{"n":7,"w":[["فَهُوَ","fahuwa","Then he","সে অতঃপর থাকবে"],["فِى","fī","(will be) in","মধ্যে"],["عِيشَةٍۢ","‘īshatin","a life","জীবনের"],["رَّاضِيَةٍۢ","rāḍiyatin","pleasant","সন্তোষজনক"]],"t":"فَهُوَ فِى عِيشَ<w>ةٍۢ رَّ</>اضِيَةٍۢ"},{"n":8,"w":[["وَأَمَّا","wa-ammā","But as for","আর (তার) ব্যাপার"],["مَنْ","man","(him) whose","যার"],["خَفَّتْ","khaffat","(are) light","হালকা হবে"],["مَوَٰزِينُهُۥ","mawāzīnuhu","his scales","তার পাল্লাসমূহ নেকীর"]],"t":"وَأَ<g>مَّ</>ا مَنْ خَفَّتْ مَ<m>وَٰ</>زِينُهُۥ"},{"n":9,"w":[["فَأُمُّهُۥ","fa-ummuhu","His abode","অতঃপর তার বাসস্থান"],["هَاوِيَةٌۭ","hāwiyatun","(will be the) Pit","গভীর গর্ত হবে"]],"t":"فَأُ<g>مُّ</>هُ<m>ۥ</> هَاوِيَةٌۭ"},{"n":10,"w":[["وَمَآ","wamā","And what","এবং কিসে"],["أَدْرَىٰكَ","adrāka","will make you know","তোমাকে জানাবে"],["مَا","mā","what","কি"],["هِيَهْ","hiyah","it is","সেটা"]],"t":"وَ<o>مَآ</> أَ<q>دْ</>رَ<m>ىٰ</>كَ مَا هِيَهْ"},{"n":11,"w":[["نَارٌ","nārun","A Fire","(সেটা হলো) আগুন"],["حَامِيَةٌۢ","ḥāmiyatun","intensely hot","গণগণে"]],"t":"نَارٌ حَامِيَةٌۢ"}]}