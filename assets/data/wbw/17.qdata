/>عُ وَ<h>ٱ</>لْأَرْضُ وَمَ<k>ن فِ</>يهِ<g>نَّ</> ۚ وَ<d>إِن مِّ</><k>ن شَ</>ىْءٍ إِلَّا يُسَبِّحُ بِحَمْدِ<m>هِۦ</> وَ<m>لَٰ</><w>كِن لَّ</>ا تَفْقَهُونَ تَسْبِيحَهُمْ ۗ إِ<g>نَّ</>هُ<m>ۥ</> كَانَ حَلِيمًا غَفُورًۭا"},{"n":45,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["قَرَأْتَ","qarata","you recite","তুমি পাঠ করো"],["ٱلْقُرْءَانَ","l-qur'āna","the Quran","কুরআন"],["جَعَلْنَا","ja‘alnā","We place","আমরা বানাই"],["بَيْنَكَ","baynaka","between you","তোমার মাঝে"],["وَبَيْنَ","wabayna","and between","ও মাঝে"],["ٱلَّذِينَ","alladhīna","those who","তাদের (যারা)"],["لَا","lā","(do) not","না"],["يُؤْمِنُونَ","yu'minūna","believe","ঈমান আনে"],["بِٱلْـَٔاخِرَةِ","bil-ākhirati","in the Hereafter","উপর আখিরাতের"],["حِجَابًۭا","ḥijāban","a barrier","পর্দা"],["مَّسْتُورًۭا","mastūran","hidden","প্রচ্ছন্ন"]],"t":"وَإِذَا قَرَأْتَ <h>ٱ</>لْقُرْءَانَ جَعَلْنَا بَيْنَكَ وَبَيْنَ <h>ٱ</>لَّذِينَ لَا يُؤْمِنُونَ بِ<h>ٱ</>لْءَاخِرَةِ حِجَا<d>بًۭا مَّ</>سْتُورًۭا"},{"n":46,"w":[["وَجَعَلْنَا","waja‘alnā","And We have placed","এবং আমরা রেখে দিই"],["عَلَىٰ","‘alā","over","উপর"],["قُلُوبِهِمْ","qulūbihim","their hearts","অন্তরসমূহের তাদের"],["أَكِنَّةً","akinnatan","coverings","আবরণ"],["أَن","an","lest","যে (না)"],["يَفْقَهُوهُ","yafqahūhu","they understand it","তা তারা বুঝে"],["وَفِىٓ","wafī","and in","এবং মধ্যে আছে"],["ءَاذَانِهِمْ","ādhānihim","their ears","কানগুলোর তাদের"],["وَقْرًۭا ۚ","waqran","deafness","বধিরতা"],["وَإِذَا","wa-idhā","And when","এবং যখন"],["ذَكَرْتَ","dhakarta","you mention","তুমি উল্লেখ করো"],["رَبَّكَ","rabbaka","your Lord","তোমার রবকে"],["فِى","fī","in","মধ্যে"],["ٱلْقُرْءَانِ","l-qur'āni","the Quran","কুরআনের"],["وَحْدَهُۥ","waḥdahu","Alone","তাঁর একত্ত্বতা"],["وَلَّوْا۟","wallaw","they turn","তারা ফিরে"],["عَلَىٰٓ","‘alā","on","দিকে"],["أَدْبَـٰرِهِمْ","adbārihim","their backs","পিঠের তাদের"],["نُفُورًۭا","nufūran","(in) aversion","ঘৃণায়"]],"t":"وَجَعَلْنَا عَلَىٰ قُلُوبِهِمْ أَكِ<g>نَّ</>ةً <d>أَن يَ</>فْقَهُوهُ وَ<o>فِىٓ</> ءَاذَانِهِمْ وَ<q>قْ</><d>رًۭا ۚ وَ</>إِذَا ذَكَرْتَ رَبَّكَ فِى <h>ٱ</>لْقُرْءَانِ وَحْدَهُ<m>ۥ</> وَلَّوْ<s>ا۟</> عَلَ<o>ىٰٓ</> أَ<q>دْ</><m>بَٰ</>رِهِمْ نُفُورًۭا"},{"n":47,"w":[["نَّحْنُ","naḥnu","We","আমরা"],["أَعْلَمُ","a‘lamu","know best","খুব জানি"],["بِمَا","bimā","[of] what","ঐ বিষয়ে যা"],["يَسْتَمِعُونَ","yastami‘ūna","they listen","তারা মনোযোগ দিয়ে শুনে"],["بِهِۦٓ","bihi","to [it]","তা সম্বন্ধে"],["إِذْ","idh","when","যখন"],["يَسْتَمِعُونَ","yastami‘ūna","they listen","তারা কান পেতে শোনে"],["إِلَيْكَ","ilayka","to you","তোমার প্রতি"],["وَإِذْ","wa-idh","and when","এবং যখন"],["هُمْ","hum","they","তারা"],["نَجْوَىٰٓ","najwā","(are) in private conversation","গোপন পরামর্শ করে"],["إِذْ","idh","when","তখন"],["يَقُولُ","yaqūlu","say","বলে"],["ٱلظَّـٰلِمُونَ","l-ẓālimūna","the wrongdoers","সীমালঙ্ঘনকারীরা"],["إِن","in","Not","\"না"],["تَتَّبِعُونَ","tattabi‘ūna","you follow","তোমরা অনুসরণ করছো"],["إِلَّا","illā","but","ছাড়া"],["رَجُلًۭا","rajulan","a man","এক ব্যক্তিকে"],["مَّسْحُورًا","masḥūran","bewitched","জাদুগ্রস্ত\""]],"t":"نَّحْنُ أَعْلَمُ بِمَا يَسْتَمِعُونَ بِ<o>هِۦٓ</> إِذْ يَسْتَمِعُونَ إِلَيْكَ وَإِذْ هُمْ نَ<q>جْ</>وَ<o>ىٰٓ</> إِذْ يَقُولُ <h>ٱ</><l>ل</><m>ظَّٰ</>لِمُونَ إِ<k>ن تَ</>تَّبِعُونَ إِلَّا رَجُلًۭ<d>ا مَّ</>سْحُورًا"},{"n":48,"w":[["ٱنظُرْ","unẓur","See","লক্ষ্য করো"],["كَيْفَ","kayfa","how","কেমন"],["ضَرَبُوا۟","ḍarabū","they put forth","তারা বর্ণনা করে"],["لَكَ","laka","for you","জন্যে তোমার"],["ٱلْأَمْثَالَ","l-amthāla","the examples","উপমাগুলো"],["فَضَلُّوا۟","faḍallū","but they have gone astray","অতএব তারা বিভ্রান্ত হয়েছে"],["فَلَا","falā","so not","তাই না"],["يَسْتَطِيعُونَ","yastaṭī‘ūna","they can","তারা পেতে পারে"],["سَبِيلًۭا","sabīlan","(find) a way","পথ"]],"t":"ٱ<k>نظُ</>رْ كَيْفَ ضَرَبُو<s>ا۟</> لَكَ <h>ٱ</>لْأَمْثَالَ فَضَلُّو<s>ا۟</> فَلَا يَسْتَطِيعُونَ سَبِيلًۭا"},{"n":49,"w":[["وَقَالُوٓا۟","waqālū","And they say","এবং তারা বলে"],["أَءِذَا","a-idhā","Is it when","\"কি যখন"],["كُنَّا","kunnā","we are","আমরা পরিণত হবো"],["عِظَـٰمًۭا","‘iẓāman","bones",