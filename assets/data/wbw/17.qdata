>عَآ</>ءَهُ<m>ۥ</> بِ<h>ٱ</>لْخَيْرِ ۖ وَكَانَ <h>ٱ</>لْإِ<k>نسَٰ</>نُ عَجُولًۭا"},{"n":12,"w":[["وَجَعَلْنَا","waja‘alnā","And We have made","এবং আমরা করেছি"],["ٱلَّيْلَ","al-layla","the night","রাতকে"],["وَٱلنَّهَارَ","wal-nahāra","and the day","ও দিনকে"],["ءَايَتَيْنِ ۖ","āyatayni","(as) two signs","দু'টি নিদর্শন"],["فَمَحَوْنَآ","famaḥawnā","Then We erased","অতঃপর আমরা নিষ্প্রভ করেছি"],["ءَايَةَ","āyata","(the) sign","নিদর্শনকে"],["ٱلَّيْلِ","al-layli","(of) the night","রাতের"],["وَجَعَلْنَآ","waja‘alnā","and We made","এবং আমরা করেছি"],["ءَايَةَ","āyata","(the) sign","নিদর্শনকে"],["ٱلنَّهَارِ","l-nahāri","(of) the day","দিনের"],["مُبْصِرَةًۭ","mub'ṣiratan","visible","উজ্জ্বল"],["لِّتَبْتَغُوا۟","litabtaghū","that you may seek","যেন তোমরা সন্ধান করতে পারো"],["فَضْلًۭا","faḍlan","bounty","অনুগ্রহ"],["مِّن","min","from","থেকে"],["رَّبِّكُمْ","rabbikum","your Lord","তোমাদের রবের"],["وَلِتَعْلَمُوا۟","walita‘lamū","and that you may know","এবং যেন তোমরা জানো"],["عَدَدَ","‘adada","(the) number","গণনা"],["ٱلسِّنِينَ","l-sinīna","(of) the years","বছর সমূহের"],["وَٱلْحِسَابَ ۚ","wal-ḥisāba","and the account","ও হিসেবের"],["وَكُلَّ","wakulla","And every","এবং প্রত্যেক"],["شَىْءٍۢ","shayin","thing ","বস্তু"],["فَصَّلْنَـٰهُ","faṣṣalnāhu","We have explained it","তা আমরা বিশদ বর্ণনা করেছি"],["تَفْصِيلًۭا","tafṣīlan","(in) detail","বিশদ বর্ণনা"]],"t":"وَجَعَلْنَا <h>ٱ</>لَّيْلَ وَ<h>ٱ</><l>ل</><g>نَّ</>هَارَ ءَايَتَيْنِ ۖ فَمَحَوْ<o>نَآ</> ءَايَةَ <h>ٱ</>لَّيْلِ وَجَعَلْ<o>نَآ</> ءَايَةَ <h>ٱ</><l>ل</><g>نَّ</>هَارِ مُ<q>بْ</>صِرَ<w>ةًۭ لِّ</>تَ<q>بْ</>تَغُو<s>ا۟</> فَضْلًۭ<d>ا مِّ</><w>ن رَّ</>بِّكُمْ وَلِتَعْلَمُو<s>ا۟</> عَدَدَ <h>ٱ</><l>ل</>سِّنِينَ وَ<h>ٱ</>لْحِسَابَ ۚ وَكُلَّ <k>شَىْءٍۢ فَ</>صَّلْ<m>نَٰ</>هُ تَفْصِيلًۭا"},{"n":13,"w":[["وَكُلَّ","wakulla","And (for) every","এবং প্রত্যেক"],["إِنسَـٰنٍ","insānin","man","মানুষের"],["أَلْزَمْنَـٰهُ","alzamnāhu","We have fastened to him","তাকে আমরা ঝুলিয়ে দিয়েছি"],["طَـٰٓئِرَهُۥ","ṭāirahu","his fate","তার কৃতকর্মকে"],["فِى","fī","in","মধ্যে"],["عُنُقِهِۦ ۖ","‘unuqihi","his neck","তার গলার"],["وَنُخْرِجُ","wanukh'riju","and We will bring forth","এবং বের করবো আমরা"],["لَهُۥ","lahu","for him","জন্যে তার"],["يَوْمَ","yawma","(on the) Day","দিনে"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) the Resurrection","ক্বিয়ামাতের"],["كِتَـٰبًۭا","kitāban","a record","কিতাব (স্বরুপ)"],["يَلْقَىٰهُ","yalqāhu","which he will find","তা পাবে সে"],["مَنشُورًا","manshūran","wide open","খোলা"]],"t":"وَكُلَّ إِ<k>نسَٰ</>نٍ أَلْزَمْ<m>نَٰ</>هُ <o>طَٰٓ</>ئِرَهُ<m>ۥ</> فِى عُنُقِ<m>هِۦ</> ۖ وَنُخْرِجُ لَهُ<m>ۥ</> يَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ كِ<m>تَٰ</><d>بًۭا يَ</>لْقَ<m>ىٰ</>هُ مَ<k>نشُ</>ورًا"},{"n":14,"w":[["ٱقْرَأْ","iq'ra","Read","\"পড়ো"],["كِتَـٰبَكَ","kitābaka","your record","তোমরা কিতাব (কর্মফল)"],["كَفَىٰ","kafā","Sufficient","যথেষ্ট"],["بِنَفْسِكَ","binafsika","(is) yourself","নিয়ে তুমি নিজেই"],["ٱلْيَوْمَ","l-yawma","today","আজ"],["عَلَيْكَ","‘alayka","against you","তোমার উপর"],["حَسِيبًۭا","ḥasīban","(as) accountant","হিসাব গ্রহণকারী হিসেবে\""]],"t":"ٱ<q>قْ</>رَأْ كِ<m>تَٰ</>بَكَ كَفَىٰ بِنَفْسِكَ <h>ٱ</>لْيَوْمَ عَلَيْكَ حَسِيبًۭا"},{"n":15,"w":[["مَّنِ","mani","Whoever","যে"],["ٱهْتَدَىٰ","ih'tadā","(is) guided","সৎপথে চলে"],["فَإِنَّمَا","fa-innamā","then only","তবে মূলতঃ"],["يَهْتَدِى","yahtadī","he is guided","সে সৎপথে চলে"],["لِنَفْسِهِۦ ۖ","linafsihi","for his soul","জন্যে তার নিজের"],["وَمَن","waman","And whoever","এবং যে"],["ضَلَّ","ḍalla","goes astray","পথভ্রষ্ট হয়ে যায়"],["فَإِنَّمَا","fa-innamā","then only","তবে মূলতঃ"],["يَضِلُّ","yaḍillu","he goes astray","সে পথভ্রষ্ট হয়"],["عَلَيْهَا ۚ","‘alayhā","against it","তার বিরুদ্ধে"],["وَلَا","walā","And not","এবং না"],["تَزِرُ","taziru","will bear","ভার বইবে"],["وَازِرَةٌۭ","wāziratun","a bearer of burden","কোনো ভার বহনকারী"],["وِزْرَ","wiz'ra","burden","ভার"],["أُخْرَىٰ ۗ","ukh'rā","(of) another","অন্যের"],["وَمَا","wamā","And not","এবং না"],["كُنَّا","kunnā","We","আমরা ছিলাম"],["مُعَذِّبِينَ","mu‘adhibīna","are to punish","শাস্তিদানকারী"],["حَتَّىٰ","ḥattā","until","যতক্ষণ  না"],["نَبْعَثَ","nab‘atha","We have sent","পাঠাই আমরা"],["رَسُولًۭا","rasūlan","a Messenger","কোনো রাসূল"]],"t":"مَّنِ <h>ٱ</>هْتَدَىٰ فَإِ<g>نَّ</>مَا يَهْتَدِى لِنَفْسِ<m>هِۦ</> ۖ وَمَ<k>ن ضَ</>لَّ فَإِ<g>نَّ</>مَا يَضِلُّ عَلَيْهَا ۚ وَلَا تَزِرُ وَازِرَ<d>ةٌۭ وِ</>زْرَ أُخْرَىٰ ۗ وَمَا كُ<g>نَّ</>ا مُعَذِّبِينَ حَتَّىٰ نَ<q>بْ</>عَثَ رَسُولًۭا"},{"n":16,"w":[["وَإِذَآ","wa-idhā","And when","এবং যখন"],["أَرَدْنَآ","aradnā","We intend","আমরা চাই"],["أَن","an","that","যে"],["نُّهْلِكَ","nuh'lika","We destroy","ধ্বংস করবো আমরা"],["قَرْيَةً","qaryatan","a town","কোনো জনপদকে"],["أَمَرْنَا","amarnā","We order","আমরা আদেশ দিই"],["مُتْرَفِيهَا","mut'rafīhā","its wealthy people","তার সমৃদ্ধশালী লোকদেরকে (সৎকর্মের)"],["فَفَسَقُوا۟","fafasaqū","but they defiantly disobey","কিন্তু তারা অসৎ কর্ম করে"],["فِيهَا","fīhā","therein","তার মধ্যে"],["فَحَقَّ","faḥaqqa","so (is) proved true","তখন অবধারিত হয়"],["عَلَيْهَا","‘alayhā","against it","উপর তার"],["ٱلْقَوْلُ","l-qawlu","the word","(শাস্তির) আদেশ"],["فَدَمَّرْنَـٰهَا","fadammarnāhā","and We destroy it","অতঃপর তা আমরা বিধ্বংস করি"],["تَدْمِيرًۭا","tadmīran","(with) destruction","ধ্বংস"]],"t":"وَإِ<o>ذَآ</> أَرَ<q>دْ</><o>نَآ</> <d>أَن نُّ</>هْلِكَ قَرْيَةً أَمَرْنَا مُتْرَفِيهَا فَفَسَقُو<s>ا۟</> فِيهَا فَحَقَّ عَلَيْهَا <h>ٱ</>لْقَوْلُ فَدَ<g>مَّ</>رْ<m>نَٰ</>هَا تَ<q>دْ</>مِيرًۭا"},{"n":17,"w":[["وَكَمْ","wakam","And how many","এবং কত"],["أَهْلَكْنَا","ahlaknā","We destroyed","ধ্বংস করেছি আমরা"],["مِنَ","mina","from","থেকে"],["ٱلْقُرُونِ","l-qurūni","the generations","মানবগোষ্ঠী"],["مِنۢ","min","after","থেকে"],["بَعْدِ","ba‘di","after","পর"],["نُوحٍۢ ۗ","nūḥin","Nuh","নূহের"],["وَكَفَىٰ","wakafā","And sufficient","এবং যথেষ্ট"],["بِرَبِّكَ","birabbika","(is) your Lord","তোমার রবই"],["بِذُنُوبِ","bidhunūbi","concerning the sins","সম্পর্কে পাপ"],["عِبَادِهِۦ","‘ibādihi","(of) His servants","তার দাসদের"],["خَبِيرًۢا","khabīran","All-Aware","খুব অবহিত"],["بَصِيرًۭا","baṣīran","All-Seer","সর্বদ্রষ্টা"]],"t":"وَكَمْ أَهْلَكْنَا مِنَ <h>ٱ</>لْقُرُونِ <i>مِنۢ بَ</>عْدِ نُو<d>حٍۢ ۗ وَ</>كَفَىٰ بِرَبِّكَ بِذُنُوبِ عِبَادِ<m>هِۦ</> خَبِي<i>رًۢا بَ</>صِيرًۭا"},{"n":18,"w":[["مَّن","man","Whoever","যে"],["كَانَ","kāna","should","ছিলো"],["يُرِيدُ","yurīdu","desire","চায়"],["ٱلْعَاجِلَةَ","l-‘ājilata","the immediate","(সুখসম্ভোগ) পার্থিব"],["عَجَّلْنَا","‘ajjalnā","We hasten","তাড়াতাড়ি দিই আমরা"],["لَهُۥ","lahu","for him","তাকে"],["فِيهَا","fīhā","in it","মধ্যে তার"],["مَا","mā","what","যা"],["نَشَآءُ","nashāu","We will","ইচ্ছে করি আমরা"],["لِمَن","liman","to whom","জন্যে যার"],["نُّرِيدُ","nurīdu","We intend","আমরা চাই"],["ثُمَّ","thumma","Then","এরপর"],["جَعَلْنَا","ja‘alnā","We have made","আমরা নির্ধারণ করি"],["لَهُۥ","lahu","for him","জন্যে তার"],["جَهَنَّمَ","jahannama","Hell","জাহান্নাম"],["يَصْلَىٰهَا","yaṣlāhā","he will burn","সে উত্তপ্ত হবে"],["مَذْمُومًۭا","madhmūman","disgraced","নিন্দিত অবস্হায়"],["مَّدْحُورًۭا","madḥūran","rejected","(অনুগ্রহ থেকে) বিতাড়িত হয়ে"]],"t":"مَّ<k>ن كَ</>انَ يُرِيدُ <h>ٱ</>لْعَاجِلَةَ عَجَّلْنَا لَهُ<m>ۥ</> فِيهَا مَا نَ<o>شَآ</>ءُ لِ<d>مَن نُّ</>رِيدُ ثُ<g>مَّ</> جَعَلْنَا لَهُ<m>ۥ</> جَهَ<g>نَّ</>مَ يَصْلَ<m>ىٰ</>هَا مَذْمُو<d>مًۭا مَّ</><q>دْ</>حُورًۭا"},{"n":19,"w":[["وَمَنْ","waman","And whoever","এবং যে"],["أَرَادَ","arāda","desires","চেয়েছে"],["ٱلْـَٔاخِرَةَ","l-ākhirata","the Hereafter","আখিরাত"],["وَسَعَىٰ","wasa‘ā","and exerts","ও চেষ্টা করেছে"],["لَهَا","lahā","for it","জন্যে তার"],["سَعْيَهَا","sa‘yahā","the effort","তার চেষ্টা"],["وَهُوَ","wahuwa","while he","যখন সে"],["مُؤْمِنٌۭ","mu'minun","(is) a believer","মু'মিনও"],["فَأُو۟لَـٰٓئِكَ","fa-ulāika","then those","সে ক্ষেত্রে ঐসব লোকদের"],["كَانَ","kāna","[are]","হলো"],["سَعْيُهُم","sa‘yuhum","their effort","তাদের প্রচেষ্টা"],["مَّشْكُورًۭا","mashkūran","(is) appreciated","স্বীকৃত"]],"t":"وَمَنْ أَرَادَ <h>ٱ</>لْءَاخِرَةَ وَسَعَىٰ لَهَا سَعْيَهَا وَهُوَ مُؤْمِ<k>نٌۭ فَ</>أُ<s>و۟</><o>لَٰٓ</>ئِكَ كَانَ سَعْيُ<y>هُم مَّ</>شْكُورًۭا"},{"n":20,"w":[["كُلًّۭا","kullan","(To) each","আমরা প্রত্যেককে"],["نُّمِدُّ","numiddu","We extend","সাহায্য করি"],["هَـٰٓؤُلَآءِ","hāulāi","(to) these","এদেরকে"],["وَهَـٰٓؤُلَآءِ","wahāulāi","and (to) these","ও ওদেরকে"],["مِنْ","min","from","থেকে"],["عَطَآءِ","‘aṭāi","(the) gift","দান"],["رَبِّكَ ۚ","rabbika","(of) your Lord","তোমার রবের"],["وَمَا","wamā","And not","এবং নয়"],["كَانَ","kāna","is","হলো"],["عَطَآءُ","‘aṭāu","(the) gift","দান"],["رَبِّكَ","rabbika","(of) your Lord","তোমার রবের"],["مَحْظُورًا","maḥẓūran","restricted","বারিত"]],"t":"كُ<d>لًّۭا نُّ</>مِدُّ <o>هَٰٓؤُلَآ</>ءِ وَ<o>هَٰٓؤُلَآ</>ءِ مِنْ عَ<o>طَآ</>ءِ رَبِّكَ ۚ وَمَا كَانَ عَ<o>طَآ</>ءُ رَبِّكَ مَحْظُورًا"},{"n":21,"w":[["ٱنظُرْ","unẓur","See","লক্ষ্য করো"],["كَيْفَ","kayfa","how","কিভাবে"],["فَضَّلْنَا","faḍḍalnā","We preferred","শ্রেষ্ঠত্ব দিয়েছি আমরা"],["بَعْضَهُمْ","ba‘ḍahum","some of them","কাউকে তাদেন"],["عَلَىٰ","‘alā","over","উপর"],["بَعْضٍۢ ۚ","ba‘ḍin","others","কারও"],["وَلَلْـَٔاخِرَةُ","walalākhiratu","And surely the Hereafter","এবং অবশ্যই আখিরাত"],["أَكْبَرُ","akbaru","(is) greater","শ্রেষ্ঠ"],["دَرَجَـٰتٍۢ","darajātin","(in) degrees","মর্যাদায়"],["وَأَكْبَرُ","wa-akbaru","and greater","এবং শ্রেষ্ঠতর"],["تَفْضِيلًۭا","tafḍīlan","(in) excellence","শ্রেষ্ঠত্বেও"]],"t":"ٱ<k>نظُ</>رْ كَيْفَ فَضَّلْنَا بَعْضَهُمْ عَلَىٰ بَعْ<d>ضٍۢ ۚ وَ</>لَلْءَاخِرَةُ أَكْبَرُ دَرَ<m>جَٰ</><d>تٍۢ وَ</>أَكْبَرُ تَفْضِيلًۭا"},{"n":22,"w":[["لَّا","lā","(Do) not","না"],["تَجْعَلْ","taj‘al","make","বানিয়ো"],["مَعَ","ma‘a","with","সাথে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["إِلَـٰهًا","ilāhan","god","ইলাহ"],["ءَاخَرَ","ākhara","another","অন্য কাউকে"],["فَتَقْعُدَ","fataq‘uda","lest you will sit","তাহ'লে বসে পড়বে"],["مَذْمُومًۭا","madhmūman","disgraced","নিন্দিত অবস্হায়"],["مَّخْذُولًۭا","makhdhūlan","forsaken","অসহায়"]],"t":"لَّا تَ<q>جْ</>عَلْ مَعَ <h>ٱ</>للَّهِ إِ<m>لَٰ</>هًا ءَاخَرَ فَتَ<q>قْ</>عُدَ مَذْمُو<d>مًۭا مَّ</>خْذُولًۭا"},{"n":23,"w":[["۞ وَقَضَىٰ","waqaḍā","And has decreed","এবং সিদ্ধান্ত দিয়েছেন"],["رَبُّكَ","rabbuka","your Lord","তোমার রব"],["أَلَّا","allā","that (do) not","যে না"],["تَعْبُدُوٓا۟","ta‘budū","worship","তোমরা ইবাদাত করো"],["إِلَّآ","illā","except","ছাড়া"],["إِيَّاهُ","iyyāhu","Him Alone","শুধু তাঁকেই"],["وَبِٱلْوَٰلِدَيْنِ","wabil-wālidayni","and to the parents","ও সাথে পিতা-মাতার"],["إِحْسَـٰنًا ۚ","iḥ'sānan","(be) good","উত্তম ব্যবহারের"],["إِمَّا","immā","Whether","যদি"],["يَبْلُغَنَّ","yablughanna","reach","তারা পৌঁছে"],["عِندَكَ","‘indaka","with you","তোমার কাছে"],["ٱلْكِبَرَ","l-kibara","the old age","বার্ধক্যে"],["أَحَدُهُمَآ","aḥaduhumā","one of them","তাদের দু'জনের একজন"],["أَوْ","aw","or","বা"],["كِلَاهُمَا","kilāhumā","both of them","তাদের উভয়ে"],["فَلَا","falā","then (do) not","তবে না"],["تَقُل","taqul","say","তুমি বলবে"],["لَّهُمَآ","lahumā","to both of them","তাদের দু'জনকে"],["أُفٍّۢ","uffin","a word of disrespect","উহ"],["وَلَا","walā","and (do) not","এবং না"],["تَنْهَرْهُمَا","tanharhumā","repel them","তাদের দু'জনকে ধমক দিবে"],["وَقُل","waqul","but speak","এবং বলবে"],["لَّهُمَا","lahumā","to them","তাদের দু'জনকে"],["قَوْلًۭا","qawlan","a word","কথা"],["كَرِيمًۭا","karīman","noble","সম্মানসূচক"]],"t":"۞ وَقَضَىٰ رَبُّكَ أَلَّا تَعْبُ<o>دُوٓ</><s>ا۟</> إِ<o>لَّآ</> إِيَّاهُ وَبِ<h>ٱ</>لْ<m>وَٰ</>لِدَيْنِ إِحْ<m>سَٰ</>نًا ۚ إِ<g>مَّ</>ا يَ<q>بْ</>لُغَ<g>نَّ</> عِ<k>ندَ</>كَ <h>ٱ</>لْكِبَرَ أَحَدُهُ<o>مَآ</> أَوْ كِلَاهُمَا فَلَا تَقُل لَّهُ<o>مَآ</> أُ<d>فٍّۢ وَ</>لَا تَنْهَرْهُمَا وَقُل لَّهُمَا قَوْلًۭ<k>ا كَ</>رِيمًۭا"},{"n":24,"w":[["وَٱخْفِضْ","wa-ikh'fiḍ","And lower","নত করবে"],["لَهُمَا","lahumā","to them","জন্যে তাদের দু'জনের"],["جَنَاحَ","janāḥa","(the) wing","ডানা"],["ٱلذُّلِّ","l-dhuli","(of) humility","বিনয়ের"],["مِنَ","mina","(out) of","সঙ্গে"],["ٱلرَّحْمَةِ","l-raḥmati","[the] mercy","অনুকম্পার"],["وَقُل","waqul","and say","এবং বলবে"],["رَّبِّ","rabbi","My Lord","\"হে আমার রব"],["ٱرْحَمْهُمَا","ir'ḥamhumā","Have mercy on both of them","দু'জনকে দয়া করো তাদের"],["كَمَا","kamā","as","যেমন"],["رَبَّيَانِى","rabbayānī","they brought me up","আমাকে দু'জনে পালন করেছে"],["صَغِيرًۭا","ṣaghīran","(when I was) small","ছেলেবেলায়\""]],"t":"وَ<h>ٱ</>خْفِضْ لَهُمَا جَنَاحَ <h>ٱ</><l>ل</>ذُّلِّ مِنَ <h>ٱ</><l>ل</>رَّحْمَةِ وَقُ<r>ل</> رَّبِّ <h>ٱ</>رْحَمْهُمَا كَمَا رَبَّيَانِى صَغِيرًۭا"},{"n":25,"w":[["رَّبُّكُمْ","rabbukum","Your Lord","তোমাদের রব"],["أَعْلَمُ","a‘lamu","(is) most knowing","খুব জানেন"],["بِمَا","bimā","of what","ঐ সম্বন্ধে যা"],["فِى","fī","(is) in","মধ্যে আছে"],["نُفُوسِكُمْ ۚ","nufūsikum","yourselves","তোমাদের অন্তরসমূহের"],["إِن","in","If","যদি"],["تَكُونُوا۟","takūnū","you are","তোমরা হও"],["صَـٰلِحِينَ","ṣāliḥīna","righteous","সৎকর্মশীল"],["فَإِنَّهُۥ","fa-innahu","then indeed, He","তবে নিশ্চয়ই তিনি"],["كَانَ","kāna","is","হলেন"],["لِلْأَوَّٰبِينَ","lil'awwābīna","to those who often turn (to Him)","জন্যে (আল্লাহ) অভিমুখীদের"],["غَفُورًۭا","ghafūran","Most Forgiving","ক্ষমাশীল"]],"t":"رَّبُّكُمْ أَعْلَمُ بِمَا فِى نُفُوسِكُمْ ۚ إِ<k>ن تَ</>كُونُو<s>ا۟</> <m>صَٰ</>لِحِينَ فَإِ<g>نَّ</>هُ<m>ۥ</> كَانَ لِلْأَ<m>وَّٰ</>بِينَ غَفُورًۭا"},{"n":26,"w":[["وَءَاتِ","waāti","And give","এবং দিবে"],["ذَا","dhā","the relatives","সম্পন্নকে"],["ٱلْقُرْبَىٰ","l-qur'bā","the relatives","নৈকট্য (আত্নীয় স্বজনকে)"],["حَقَّهُۥ","ḥaqqahu","his right","তার প্রাপ্য"],["وَٱلْمِسْكِينَ","wal-mis'kīna","and the needy","ও অভাবগ্রস্তকে"],["وَٱبْنَ","wa-ib'na","and the wayfarer","ও ছেলেকে"],["ٱلسَّبِيلِ","l-sabīli","and the wayfarer","পথের (পথচারীকে)"],["وَلَا","walā","and (do) not","এবং না"],["تُبَذِّرْ","tubadhir","spend","অপব্যয় করো"],["تَبْذِيرًا","tabdhīran","wastefully","কোনো অপব্যয়"]],"t":"وَءَاتِ ذَا <h>ٱ</>لْقُرْبَىٰ حَقَّهُ<m>ۥ</> وَ<h>ٱ</>لْمِسْكِينَ وَ<h>ٱ</><q>بْ</>نَ <h>ٱ</><l>ل</>سَّبِيلِ وَلَا تُبَذِّرْ تَ<q>بْ</>ذِيرًا"},{"n":27,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلْمُبَذِّرِينَ","l-mubadhirīna","the spendthrifts","অপব্যয়কারীরা"],["كَانُوٓا۟","kānū","are","হলো"],["إِخْوَٰنَ","ikh'wāna","brothers","ভাই"],["ٱلشَّيَـٰطِينِ ۖ","l-shayāṭīni","(of) the devils","শয়তানদের"],["وَكَانَ","wakāna","And is","এবং হলো"],["ٱلشَّيْطَـٰنُ","l-shayṭānu","the Shaitaan","শয়তান"],["لِرَبِّهِۦ","lirabbihi","to his Lord","প্রতি রবের তার"],["كَفُورًۭا","kafūran","ungrateful","বড়ই অকৃতজ্ঞ"]],"t":"إِ<g>نَّ</> <h>ٱ</>لْمُبَذِّرِينَ كَا<o>نُوٓ</><s>ا۟</> إِخْ<m>وَٰ</>نَ <h>ٱ</><l>ل</>شَّ<m>يَٰ</>طِينِ ۖ وَكَانَ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نُ لِرَبِّ<m>هِۦ</> كَفُورًۭا"},{"n":28,"w":[["وَإِمَّا","wa-immā","And if","এবং যদি"],["تُعْرِضَنَّ","tu‘'riḍanna","you turn away","পাশ কাটাতে চাও"],["عَنْهُمُ","‘anhumu","from them","থেকে তাদের"],["ٱبْتِغَآءَ","ib'tighāa","seeking","সন্ধানে"],["رَحْمَةٍۢ","raḥmatin","mercy","অনুগ্রহের"],["مِّن","min","from","থেকে"],["رَّبِّكَ","rabbika","your Lord","তোমার রবের"],["تَرْجُوهَا","tarjūhā","which you expect","তা তোমরা আশা করো"],["فَقُل","faqul","then say","তখন বলো"],["لَّهُمْ","lahum","to them","তাদেরকে"],["قَوْلًۭا","qawlan","a word","কথা"],["مَّيْسُورًۭا","maysūran","gentle","সহজভাবে"]],"t":"وَإِ<g>مَّ</>ا تُعْرِضَ<g>نَّ</> عَنْهُمُ <h>ٱ</><q>بْ</>تِ<o>غَآ</>ءَ رَحْمَ<d>ةٍۢ مِّ</><w>ن رَّ</>بِّكَ تَرْجُوهَا فَقُل لَّهُمْ قَوْلًۭ<d>ا مَّ</>يْسُورًۭا"},{"n":29,"w":[["وَلَا","walā","And (do) not","এবং না"],["تَجْعَلْ","taj‘al","make","রেখো"],["يَدَكَ","yadaka","your hand","তোমার হাত"],["مَغْلُولَةً","maghlūlatan","chained","আবদ্ধ"],["إِلَىٰ","ilā","to","সাথে"],["عُنُقِكَ","‘unuqika","your neck","তোমার গলার"],["وَلَا","walā","and not","এবং না"],["تَبْسُطْهَا","tabsuṭ'hā","extend it","তা প্রসারিত করো"],["كُلَّ","kulla","(to its) utmost","সম্পূর্ণ"],["ٱلْبَسْطِ","l-basṭi","reach","প্রসারিত"],["فَتَقْعُدَ","fataq‘uda","so that you sit","তাহ'লে বসে পড়বে"],["مَلُومًۭا","malūman","blameworthy","নিন্দিত"],["مَّحْسُورًا","maḥsūran","insolvent","অক্ষম অবস্হায়"]],"t":"وَلَا تَ<q>جْ</>عَلْ يَدَكَ مَغْلُولَةً إِلَىٰ عُنُقِكَ وَلَا تَ<q>بْسُطْ</>هَا كُلَّ <h>ٱ</>لْبَسْطِ فَتَ<q>قْ</>عُدَ مَلُو<d>مًۭا مَّ</>حْسُورًا"},{"n":30,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["رَبَّكَ","rabbaka","your Lord","তোমার রব"],["يَبْسُطُ","yabsuṭu","extends","প্র