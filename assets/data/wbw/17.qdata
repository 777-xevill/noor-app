,{"n":74,"w":[["وَلَوْلَآ","walawlā","And if not","এবং যদি না (হতো এমন)"],["أَن","an","[that]","যে"],["ثَبَّتْنَـٰكَ","thabbatnāka","We (had) strengthened you","তোমাকে আমরা অবিচল রাখতাম"],["لَقَدْ","laqad","certainly","নিশ্চিতই"],["كِدتَّ","kidtta","you almost","তুমি প্রায়"],["تَرْكَنُ","tarkanu","(would) have inclined","তুমি ঝুঁকে পড়তে"],["إِلَيْهِمْ","ilayhim","to them","দিকে তাদের"],["شَيْـًۭٔا","shayan","(in) something","কিছুটা"],["قَلِيلًا","qalīlan","a little","সামান্য (হলেও)"]],"t":"وَلَوْ<o>لَآ</> أَ<k>ن ثَ</>بَّتْ<m>نَٰ</>كَ لَقَ<q>دْ</> كِ<j>د</>تَّ تَرْكَنُ إِلَيْهِمْ شَ<k>يْـًۭٔا قَ</>لِيلًا"},{"n":75,"w":[["إِذًۭا","idhan","Then","তাহ'লে"],["لَّأَذَقْنَـٰكَ","la-adhaqnāka","We (would) have made you taste","তোমাকে আমরা অবশ্যই স্বাদ গ্রহণ করাতাম"],["ضِعْفَ","ḍi‘'fa","double","দ্বিগুণ"],["ٱلْحَيَوٰةِ","l-ḥayati","(in) the life","(এই) জীবনে"],["وَضِعْفَ","waḍi‘'fa","and double","ও দ্বিগুণ"],["ٱلْمَمَاتِ","l-mamāti","(after) the death","মৃত্যুতে (পরকালে)"],["ثُمَّ","thumma","Then","এরপর"],["لَا","lā","not","না"],["تَجِدُ","tajidu","you (would) have found","তুমি পেতে"],["لَكَ","laka","for you","জন্যে তোমার"],["عَلَيْنَا","‘alaynā","against Us","বিরুদ্ধে আমাদের"],["نَصِيرًۭا","naṣīran","any helper","কোনো সাহায্যকারী"]],"t":"إِ<w>ذًۭا لَّ</>أَذَ<q>قْ</><m>نَٰ</>كَ ضِعْفَ <h>ٱ</>لْحَيَ<s>وٰ</>ةِ وَضِعْفَ <h>ٱ</>لْمَمَاتِ ثُ<g>مَّ</> لَا تَجِدُ لَكَ عَلَيْنَا نَصِيرًۭا"},{"n":76,"w":[["وَإِن","wa-in","And indeed","এবং যদিও"],["كَادُوا۟","kādū","they were about","তারা প্রচেষ্টায় ক্রুটি রাখেনি"],["لَيَسْتَفِزُّونَكَ","layastafizzūnaka","(to) scare you","অবশ্যই তোমাকে উচ্ছেদ করবে"],["مِنَ","mina","from","হ'তে"],["ٱلْأَرْضِ","l-arḍi","the land","এ দেশ"],["لِيُخْرِجُوكَ","liyukh'rijūka","that they evict you","জন্যে তোমাকে বের করার"],["مِنْهَا ۖ","min'hā","from it","থেকে তা"],["وَإِذًۭا","wa-idhan","But then","কিন্তু তাহ'লে"],["لَّا","lā","not","না"],["يَلْبَثُونَ","yalbathūna","they (would) have stayed","তারা টিকতো"],["خِلَـٰفَكَ","khilāfaka","after you","তোমার পরে"],["إِلَّا","illā","except","এ ছাড়া"],["قَلِيلًۭا","qalīlan","a little","স্বল্পকাল"]],"t":"وَإِ<k>ن كَ</>ادُو<s>ا۟</> لَيَسْتَفِزُّونَكَ مِنَ <h>ٱ</>لْأَرْضِ لِيُخْرِجُوكَ مِنْهَا ۖ وَإِ<w>ذًۭا لَّ</>ا يَلْبَثُونَ خِ<m>لَٰ</>فَكَ إِلَّا قَلِيلًۭا"},{"n":77,"w":[["سُنَّةَ","sunnata","(Such is Our) Way","স্হায়ী নীতি"],["مَن","man","(for) whom","(তাদের ক্ষেত্রে) যাদের"],["قَدْ","qad","[verily]","নিশ্চয়ই"],["أَرْسَلْنَا","arsalnā","We sent","আমরা পাঠিয়েছি"],["قَبْلَكَ","qablaka","before you","তোমার পূর্বে"],["مِن","min","of","মধ্য থেকে"],["رُّسُلِنَا ۖ","rusulinā","Our Messengers","আমাদের রাসূলদের"],["وَلَا","walā","And not","এবং না"],["تَجِدُ","tajidu","you will find","তুমি পাবে"],["لِسُنَّتِنَا","lisunnatinā","(in) Our way","আমাদের বেলায় নীতির"],["تَحْوِيلًا","taḥwīlan","any alteration","কোনো পরিবর্তন"]],"t":"سُ<g>نَّ</>ةَ مَ<k>ن قَ</><q>دْ</> أَرْسَلْنَا قَ<q>بْ</>لَكَ <w>مِن رُّ</>سُلِنَا ۖ وَلَا تَجِدُ لِسُ<g>نَّ</>تِنَا تَحْوِيلًا"},{"n":78,"w":[["أَقِمِ","aqimi","Establish","প্রতিষ্ঠা করো"],["ٱلصَّلَوٰةَ","l-ṣalata","the prayer","সালাত"],["لِدُلُوكِ","lidulūki","at the decline","থেকে ঢলে পড়ার সময়"],["ٱلشَّمْسِ","l-shamsi","(of) the sun","সূর্য"],["إِلَىٰ","ilā","till","পর্যন্ত"],["غَسَقِ","ghasaqi","(the) darkness","ঘন অন্ধকার"],["ٱلَّيْلِ","al-layli","(of) the night","রাতের"],["وَقُرْءَانَ","waqur'āna","and Quran","এবং (সালাত) কুরআন পাঠ"],["ٱلْفَجْرِ ۖ","l-fajri","at dawn","ফজরের"],["إِنَّ","inna","indeed","নিশ্চয়ই"],["قُرْءَانَ","qur'āna","the Quran","(সালাত) কুরআন পাঠ"],["ٱلْفَجْرِ","l-fajri","(at) the dawn","ফজরের"],["كَانَ","kāna","is","হলো"],["مَشْهُودًۭا","mashhūdan","ever witnessed","(এমন যাতে) উপস্হিতির সময়"]],"t":"أَقِمِ <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةَ لِدُلُوكِ <h>ٱ</><l>ل</>شَّمْسِ إِلَىٰ غَسَقِ <h>ٱ</>لَّيْلِ وَقُرْءَانَ <h>ٱ</>لْفَ<q>جْ</>رِ ۖ إِ<g>نَّ</> قُرْءَانَ <h>ٱ</>لْفَ<q>جْ</>رِ كَانَ مَشْهُودًۭا"},{"n":79,"w":[["وَمِنَ","wamina","And from","এবং কিছু অংশে"],["ٱلَّيْلِ","al-layli","the night","রাতের"],["فَتَهَجَّدْ","fatahajjad","arise from sl