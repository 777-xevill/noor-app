h>ٱ</>لَّذِى فَطَرَكُمْ أَوَّلَ مَرَّ<k>ةٍۢ ۚ فَ</>سَيُنْغِضُونَ إِلَيْكَ رُءُوسَهُمْ وَيَقُولُونَ مَتَىٰ هُوَ ۖ قُلْ عَسَ<o>ىٰٓ</> <d>أَن يَ</>كُونَ قَرِيبًۭا"},{"n":52,"w":[["يَوْمَ","yawma","(On) the Day","যেদিন"],["يَدْعُوكُمْ","yad‘ūkum","He will call you","তিনি ডাকবেন তোমাদেরকে"],["فَتَسْتَجِيبُونَ","fatastajībūna","and you will respond","তখন তোমরা ডাকে সাড়া দিবে"],["بِحَمْدِهِۦ","biḥamdihi","with His Praise","সাথে তাঁর প্রশংসার"],["وَتَظُنُّونَ","wataẓunnūna","and you will think","ও তোমরা মনে করবে"],["إِن","in","not","না"],["لَّبِثْتُمْ","labith'tum","you had remained","অবস্থান করেছিলে তোমরা"],["إِلَّا","illā","except","ছাড়া"],["قَلِيلًۭا","qalīlan","a little (while)","অল্প (সময়)"]],"t":"يَوْمَ يَ<q>دْ</>عُوكُمْ فَتَسْتَجِيبُونَ بِحَمْدِ<m>هِۦ</> وَتَظُ<g>نُّ</>ونَ <w>إِن لَّ</>بِثْتُمْ إِلَّا قَلِيلًۭا"},{"n":53,"w":[["وَقُل","waqul","And say","এবং বলো"],["لِّعِبَادِى","li‘ibādī","to My slaves","আমাদের দাসদেরকে"],["يَقُولُوا۟","yaqūlū","(to) say","(যেন) তারা বলে"],["ٱلَّتِى","allatī","that","ঐ (কথা)"],["هِىَ","hiya","which","যা"],["أَحْسَنُ ۚ","aḥsanu","(is) best","উত্তম"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلشَّيْطَـٰنَ","l-shayṭāna","the Shaitaan","শয়তান"],["يَنزَغُ","yanzaghu","sows discord","উস্কানি দেয়"],["بَيْنَهُمْ ۚ","baynahum","between them","মাঝে তাদের"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلشَّيْطَـٰنَ","l-shayṭāna","the Shaitaan","শয়তান"],["كَانَ","kāna","is","হলো"],["لِلْإِنسَـٰنِ","lil'insāni","to the man","জন্যে মানুষের"],["عَدُوًّۭا","‘aduwwan","an enemy","শত্রু"],["مُّبِينًۭا","mubīnan","clear","প্রকাশ্য"]],"t":"وَقُل لِّعِبَادِى يَقُولُو<s>ا۟</> <h>ٱ</>لَّتِى هِىَ أَحْسَنُ ۚ إِ<g>نَّ</> <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نَ يَ<k>نزَ</>غُ بَيْنَهُمْ ۚ إِ<g>نَّ</> <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نَ كَانَ لِلْإِ<k>نسَٰ</>نِ عَدُ<d>وًّۭا مُّ</>بِينًۭا"},{"n":54,"w":[["رَّبُّكُمْ","rabbukum","Your Lord","রব তোমাদের"],["أَعْلَمُ","a‘lamu","(is) most knowing","খুব জানেন"],["بِكُمْ ۖ","bikum","of you","সম্পর্কে তোমাদের"],["إِن","in","If","যদি"],["يَشَأْ","yasha","He wills","ইচ্ছে করেন"],["يَرْحَمْكُمْ","yarḥamkum","He will have mercy on you","তোমাদের প্রতি দয়া করবেন"],["أَوْ","aw","or","বা"],["إِن","in","if","যদি"],["يَشَأْ","yasha","He wills","ইচ্ছে করেন"],["يُعَذِّبْكُمْ ۚ","yu‘adhib'kum","He will punish you","তোমাদের শাস্তি দিবেন"],["وَمَآ","wamā","And not","এবং না"],["أَرْسَلْنَـٰكَ","arsalnāka","We have sent you","তোমাকে আমরা প্রেরণ করেছি"],["عَلَيْهِمْ","‘alayhim","over them","কাছে তাদের"],["وَكِيلًۭا","wakīlan","(as) a guardian","কর্মবিধায়করূপে"]],"t":"رَّبُّكُمْ أَعْلَمُ بِكُمْ ۖ <d>إِن يَ</>شَأْ يَرْحَمْكُمْ أَوْ <d>إِن يَ</>شَأْ يُعَذِّ<q>بْ</>كُمْ ۚ وَ<o>مَآ</> أَرْسَلْ<m>نَٰ</>كَ عَلَيْهِمْ وَكِيلًۭا"},{"n":55,"w":[["وَرَبُّكَ","warabbuka","And your Lord","এবং তোমার রব"],["أَعْلَمُ","a‘lamu","(is) most knowing","খুব জানেন"],["بِمَن","biman","of whoever","সম্বন্ধে ঐ যা"],["فِى","fī","(is) in","মধ্যে আছে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশমন্ডলীর"],["وَٱلْأَرْضِ ۗ","wal-arḍi","and the earth","ও পৃথিবীর"],["وَلَقَدْ","walaqad","And verily","এবং নিশ্চয়ই"],["فَضَّلْنَا","faḍḍalnā","We have preferred","আমরা মর্যাদা দিয়েছি"],["بَعْضَ","ba‘ḍa","some","কাউকে"],["ٱلنَّبِيِّـۧنَ","l-nabiyīna","(of) the Prophets","নাবীদের মধ্যে"],["عَلَىٰ","‘alā","to","উপর"],["بَعْضٍۢ ۖ","ba‘ḍin","others","কারও"],["وَءَاتَيْنَا","waātaynā","And We gave","এবং আমরা দিয়েছি"],["دَاوُۥدَ","dāwūda","Dawood","দাঊদকে"],["زَبُورًۭا","zabūran","Zaboor","যাবূর"]],"t":"وَرَبُّكَ أَعْلَمُ بِمَ<k>ن فِ</>ى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ ۗ وَلَقَ<q>دْ</> فَضَّلْنَا بَعْضَ <h>ٱ</><l>ل</><g>نَّ</>بِيِّۦنَ عَلَىٰ بَعْ<d>ضٍۢ ۖ وَ</>ءَاتَيْنَا دَاوُ<m>ۥ</>دَ زَبُورًۭا"},{"n":56,"w":[["قُلِ","quli","Say","বলো"],["ٱدْعُوا۟","id'‘ū","Call","\"তোমরা ডাকো"],["ٱلَّذِينَ","alladhīna","those whom","(তাদেরকে) যাদের"],["زَعَمْتُم","za‘amtum","you claimed","তোমরা ধারণা করো"],["مِّن","min","besides Him","ছাড়া"],["دُونِهِۦ","dūnihi","besides Him","তিনি (ইলাহ)"],["فَلَا","falā","[then] not","অতঃপর না"],["يَمْلِكُونَ","yamlikūna","they have power","তারা শক্তি রাখে"],["كَشْفَ","kashfa","(to) remove","দূর করতে"],["ٱلضُّرِّ","l-ḍuri","the misfortunes","দুঃখ-দৈন্য"],["عَنكُمْ","‘ankum","from you","থেকে তোমাদের"],["وَلَا","walā","and not","এবং না"],["تَحْوِيلًا","taḥwīlan","(to) transfer (it)","পরিবর্তন\""]],"t":"قُلِ <h>ٱ</><q>دْ</>عُو<s>ا۟</> <h>ٱ</>لَّذِينَ زَعَمْ<y>تُم مِّ</><k>ن دُ</>ونِ<m>هِۦ</> فَلَا يَمْلِكُونَ كَشْفَ <h>ٱ</><l>ل</>ضُّرِّ عَ<k>نكُ</>مْ وَلَا تَحْوِيلًا"},{"n":57,"w":[["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব লোক"],["ٱلَّذِينَ","alladhīna","whom","যাদেরকে"],["يَدْعُونَ","yad‘ūna","they call","তারা ডাকে"],["يَبْتَغُونَ","yabtaghūna","seek","তারা খোঁজ করে"],["إِلَىٰ","ilā","to","দিকে"],["رَبِّهِمُ","rabbihimu","their Lord","রবের তাদের"],["ٱلْوَسِيلَةَ","l-wasīlata","the means of access","নৈকট্য লাভের উপায়"],["أَيُّهُمْ","ayyuhum","which of them","মধ্যে কে তাদের"],["أَقْرَبُ","aqrabu","(is) nearest","অধিক নিকটবর্তী"],["وَيَرْجُونَ","wayarjūna","and they hope","এবং তারা প্রত্যাশা করে"],["رَحْمَتَهُۥ","raḥmatahu","(for) His mercy","তাঁর দয়া"],["وَيَخَافُونَ","wayakhāfūna","and fear","ও তারা ভয় করে"],["عَذَابَهُۥٓ ۚ","‘adhābahu","His punishment","তাঁর শাস্তিকে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["عَذَابَ","‘adhāba","(the) punishment","শাস্তি"],["رَبِّكَ","rabbika","(of) your Lord","তোমার রবের"],["كَانَ","kāna","is","হলো"],["مَحْذُورًۭا","maḥdhūran","(ever) feared","ভয়াবহ"]],"t":"أُ<s>و۟</><o>لَٰٓ</>ئِكَ <h>ٱ</>لَّذِينَ يَ<q>دْ</>عُونَ يَ<q>بْ</>تَغُونَ إِلَىٰ رَبِّهِمُ <h>ٱ</>لْوَسِيلَةَ أَيُّهُمْ أَ<q>قْ</>رَبُ وَيَرْجُونَ رَحْمَتَهُ<m>ۥ</> وَيَخَافُونَ عَذَابَهُ<o>ۥٓ ۚ</> إِ<g>نَّ</> عَذَابَ رَبِّكَ كَانَ مَحْذُورًۭا"},{"n":58,"w":[["وَإِن","wa-in","And not","এবং নেই"],["مِّن","min","(is) any","কোনো"],["قَرْيَةٍ","qaryatin","town","জনপদ"],["إِلَّا","illā","but","এ ছাড়া যে"],["نَحْنُ","naḥnu","We","আমরা"],["مُهْلِكُوهَا","muh'likūhā","(will) destroy it","তা আমরা ধ্বংসকারী"],["قَبْلَ","qabla","before","পূর্বে"],["يَوْمِ","yawmi","(the) Day","দিনের"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) the Resurrection","ক্বিয়ামাতের"],["أَوْ","aw","or","বা"],["مُعَذِّبُوهَا","mu‘adhibūhā","punish it","তাকে আমরা শাস্তিদানকারী"],["عَذَابًۭا","‘adhāban","with a punishment","শাস্তি (দ্বারা)"],["شَدِيدًۭا ۚ","shadīdan","severe","কঠোর"],["كَانَ","kāna","That is","হলো"],["ذَٰلِكَ","dhālika","That is","এটা"],["فِى","fī","in","মধ্যে"],["ٱلْكِتَـٰبِ","l-kitābi","the Book","(আল্লাহর) কিতাবের"],["مَسْطُورًۭا","masṭūran","written","লিখিত"]],"t":"وَ<d>إِن مِّ</><k>ن قَ</>رْيَةٍ إِلَّا نَحْنُ مُهْلِكُوهَا قَ<q>بْ</>لَ يَوْمِ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ أَوْ مُعَذِّبُوهَا عَذَا<k>بًۭا شَ</>دِي<k>دًۭا ۚ كَ</>انَ <m>ذَٰ</>لِكَ فِى <h>ٱ</>لْكِ<m>تَٰ</>بِ مَسْطُورًۭا"},{"n":59,"w":[["وَمَا","wamā","And not","এবং না"],["مَنَعَنَآ","mana‘anā","stopped Us","কেউ আমাদেরকে বিরত রেখেছে"],["أَن","an","that","যে"],["نُّرْسِلَ","nur'sila","We send","আমরা পাঠাবো"],["بِٱلْـَٔايَـٰتِ","bil-āyāti","the Signs","দিয়ে নিদর্শনাদি"],["إِلَّآ","illā","except","এ ছাড়া"],["أَن","an","that","যে"],["كَذَّبَ","kadhaba","denied","মিথ্যারোপ করেছে"],["بِهَا","bihā","them","ব্যাপারে তার"],["ٱلْأَوَّلُونَ ۚ","l-awalūna","the former (people)","পূর্ববর্তীরা"],["وَءَاتَيْنَا","waātaynā","And We gave","এবং আমরা দিয়েছি"],["ثَمُودَ","thamūda","Thamud","সামুদকে"],["ٱلنَّاقَةَ","l-nāqata","the she-camel","মাদি উট"],["مُبْصِرَةًۭ","mub'ṣiratan","(as) a visible sign","প্রকাশ্য"],["فَظَلَمُوا۟","faẓalamū","but they wronged","তখন তারা নির্যাতন করে"],["بِهَا ۚ","bihā","her","সাথে তার"],["وَمَا","wamā","And not","এবং না"],["نُرْسِلُ","nur'silu","We send","আমরা পাঠাই"],["بِٱلْـَٔايَـٰتِ","bil-āyāti","the Signs","দিয়ে নিদের্শনাদি"],["إِلَّا","illā","except","এ ছাড়া যে"],["تَخْوِيفًۭا","takhwīfan","(as) a warning","ভয় স্বরূপ"]],"t":"وَمَا مَنَعَ<o>نَآ</> <d>أَن نُّ</>رْسِلَ بِ<h>ٱ</>لْءَا<m>يَٰ</>تِ إِ<o>لَّآ</> أَ<k>ن كَ</>ذَّبَ بِهَا <h>ٱ</>لْأَوَّلُونَ ۚ وَءَاتَيْنَا ثَمُودَ <h>ٱ</><l>ل</><g>نَّ</>اقَةَ مُ<q>بْ</>صِرَ<k>ةًۭ فَ</>ظَلَمُو<s>ا۟</> بِهَا ۚ وَمَا نُرْسِلُ بِ<h>ٱ</>لْءَا<m>يَٰ</>تِ إِلَّا تَخْوِيفًۭا"},{"n":60,"w":[["وَإِذْ","wa-idh","And when","এবং যখন"],["قُلْنَا","qul'nā","We said","আমরা বলেছিলাম"],["لَكَ","laka","to you","তোমাকে"],["إِنَّ","inna","Indeed","\"নিশ্চয়ই"],["رَبَّكَ","rabbaka","your Lord","তোমার রব"],["أَحَاطَ","aḥāṭa","has encompassed","ঘিরে রেখেছেন"],["بِٱلنَّاسِ ۚ","bil-nāsi","the mankind","নিয়ে মানুষকে\""],["وَمَا","wamā","And not","এবং না"],["جَعَلْنَا","ja‘alnā","We made","আমরা করেছি"],["ٱلرُّءْيَا","l-ru'yā","the vision","দৃশ্য"],["ٱلَّتِىٓ","allatī","which","যা"],["أَرَيْنَـٰكَ","araynāka","We showed you","তোমাকে আমরা দেখিয়েছি"],["إِلَّا","illā","except","এ ছাড়া যে"],["فِتْنَةًۭ","fit'natan","(as) a trial","পরীক্ষা"],["لِّلنَّاسِ","lilnnāsi","for mankind","মানুষের জন্যে"],["وَٱلشَّجَرَةَ","wal-shajarata","and the tree","এবং গাছটিকেও"],["ٱلْمَلْعُونَةَ","l-mal‘ūnata","the accursed","অভিশপ্ত"],["فِى","fī","in","মধ্যে"],["ٱلْقُرْءَانِ ۚ","l-qur'āni","the Quran","কুরআনের"],["وَنُخَوِّفُهُمْ","wanukhawwifuhum","And We threaten them","এবং ভয় দেখাই আমরা তাদের"],["فَمَا","famā","but not","কিন্তু না"],["يَزِيدُهُمْ","yazīduhum","it increases them","তাদের বৃদ্ধি করে"],["إِلَّا","illā","except","এ ছাড়া"],["طُغْيَـٰنًۭا","ṭugh'yānan","(in) transgression","অবাধ্যতা"],["كَبِيرًۭا","kabīran","great","ঘোর"]],"t":"وَإِذْ قُلْنَا لَكَ إِ<g>نَّ</> رَبَّكَ أَحَاطَ بِ<h>ٱ</><l>ل</><g>نَّ</>اسِ ۚ وَمَا جَعَلْنَا <h>ٱ</><l>ل</>رُّءْيَا <h>ٱ</>لَّ<o>تِىٓ</> أَرَيْ<m>نَٰ</>كَ إِلَّا فِتْنَ<w>ةًۭ لِّ</>ل<g>نَّ</>اسِ وَ<h>ٱ</><l>ل</>شَّجَرَةَ <h>ٱ</>لْمَلْعُونَةَ فِى <h>ٱ</>لْقُرْءَانِ ۚ وَنُخَوِّفُهُمْ فَمَا يَزِيدُهُمْ إِلَّا طُغْ<m>يَٰ</><k>نًۭا كَ</>بِيرًۭا"},{"n":61,"w":[["وَإِذْ","wa-idh","And when","এবং যখন"],["قُلْنَا","qul'nā","We said","আমরা বলেছিলাম"],["لِلْمَلَـٰٓئِكَةِ","lil'malāikati","to the Angels","ফেরেশতাদেরকে"],["ٱسْجُدُوا۟","us'judū","Prostrate","\"তোমরা সিজদা করো"],["لِـَٔادَمَ","liādama","to Adam","আদমকে\""],["فَسَجَدُوٓا۟","fasajadū","So they prostrated","অতঃপর তারা সিজদা করলো"],["إِلَّآ","illā","except","ছাড়া"],["إِبْلِيسَ","ib'līsa","Iblis","ইবলীস"],["قَالَ","qāla","He said","সে বললো"],["ءَأَسْجُدُ","a-asjudu","Shall I prostrate","\"আমি কি সিজদা করবো"],["لِمَنْ","liman","to (one) whom","জন্যে তার (যাকে)"],["خَلَقْتَ","khalaqta","You created","আপনি সৃষ্টি করেছেন"],["طِينًۭا","ṭīnan","(from) clay","কাদা মাটি (হ'তে)\""]],"t":"وَإِذْ قُلْنَا لِلْمَ<o>لَٰٓ</>ئِكَةِ <h>ٱ</>سْجُدُو<s>ا۟</> لِءَادَمَ فَسَجَ<o>دُوٓ</><s>ا۟</> إِ<o>لَّآ</> إِ<q>بْ</>لِيسَ قَالَ ءَأَسْجُدُ لِمَنْ خَلَ<q>قْ</>تَ طِينًۭا"},{"n":62,"w":[["قَالَ","qāla","He said","সে বললো"],["أَرَءَيْتَكَ","ara-aytaka","Do You see","\"কি আপনি মনে করেন"],["هَـٰذَا","hādhā","this","এই"],["ٱلَّذِى","alladhī","whom","যাকে"],["كَرَّمْتَ","karramta","You have honored","আপনি মর্যাদা দিয়েছেন"],["عَلَىَّ","‘alayya","above me","আমার উপর"],["لَئِنْ","la-in","If","অবশ্যই যদি"],["أَخَّرْتَنِ","akhartani","You give me respite","আমাকে আপনি অবকাশ দেন"],["إِلَىٰ","ilā","till","পর্যন্ত"],["يَوْمِ","yawmi","(the) Day","দিন"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) the Resurrection","ক্বিয়ামাতের"],["لَأَحْتَنِكَنَّ","la-aḥtanikanna","I will surely destroy","আমি অবশ্যই সমূলে নষ্ট করবো"],["ذُرِّيَّتَهُۥٓ","dhurriyyatahu","his offspring","তার বংশধরদের"],["إِلَّا","illā","except","ছাড়া"],["قَلِيلًۭا","qalīlan","a few","স্বল্প সংখ্যক\""]],"t":"قَالَ أَرَءَيْتَكَ <m>هَٰ</>ذَا <h>ٱ</>لَّذِى كَرَّمْتَ عَلَىَّ لَئِنْ أَخَّرْتَنِ إِلَىٰ يَوْمِ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ لَأَحْتَنِكَ<g>نَّ</> ذُرِّيَّتَهُ<o>ۥٓ</> إِلَّا قَلِيلًۭا"},{"n":63,"w":[["قَالَ","qāla","He said","তিনি বললেন"],["ٱذْهَبْ","idh'hab","Go","\"তুমি যাও"],["فَمَن","faman","and whoever","অতঃপর যে"],["تَبِعَكَ","tabi‘aka","follows you","তোমার অনুসরণ করবে"],["مِنْهُمْ","min'hum","among them","তাদের মধ্যে থেকে"],["فَإِنَّ","fa-inna","then indeed","তাহ'লে  নিশ্চয়ই"],["جَهَنَّمَ","jahannama","Hell","জাহান্নাম হবে"],["جَزَآؤُكُمْ","jazāukum","(is) your recompense ","তোমাদের প্রতিফল"],["جَزَآءًۭ","jazāan","a recompense","প্রতিফল"],["مَّوْفُورًۭا","mawfūran","ample","পূর্ণ"]],"t":"قَالَ <h>ٱ</>ذْهَ<q>بْ</> فَمَ<k>ن تَ</>بِعَكَ مِنْهُمْ فَإِ<g>نَّ</> جَهَ<g>نَّ</>مَ جَ<o>زَآ</>ؤُكُمْ جَ<o>زَآ</><d>ءًۭ مَّ</>وْفُورًۭا"},{"n":64,"w":[["وَٱسْتَفْزِزْ","wa-is'tafziz","And incite","এবং পদস্খলিত করো"],["مَنِ","mani","whoever","যাকে"],["ٱسْتَطَعْتَ","is'taṭa‘ta","you can","তুমি পারো"],["مِنْهُم","min'hum","among them","মধ্য হ'তে তাদের"],["بِصَوْتِكَ","biṣawtika","with your voice","দিয়ে তোমার কন্ঠস্বর"],["وَأَجْلِبْ","wa-ajlib","and assault","ও চড়াও হও"],["عَلَيْهِم","‘alayhim","[on] them","উপর তাদের"],["بِخَيْلِكَ","bikhaylika","with your cavalry","নিয়ে তোমার অশ্বারোহী বাহিনী"],["وَرَجِلِكَ","warajilika","and infantry","ও তোমার পদাতিক বাহিনী"],["وَشَارِكْهُمْ","washārik'hum","and be a partner","এবং সহযোগী করো তাদের"],["فِى","fī","in","মধ্যে"],["ٱلْأَمْوَٰلِ","l-amwāli","the wealth","সম্পদসমূহের"],["وَٱلْأَوْلَـٰدِ","wal-awlādi","and the children","ও সন্তানদের"],["وَعِدْهُمْ ۚ","wa‘id'hum","and promise them","এবং তাদের প্রতিশ্রুতি দাও\""],["وَمَا","wamā","And not","আর না"],["يَعِدُهُمُ","ya‘iduhumu","promises them","তাদেরকে প্রতিশ্রুতি দেয়"],["ٱلشَّيْطَـٰنُ","l-shayṭānu","the Shaitaan","শয়তান"],["إِلَّا","illā","except","এ ছাড়া"],["غُرُورًا","ghurūran","delusion","প্রতারণা"]],"t":"وَ<h>ٱ</>سْتَفْزِزْ مَنِ <h>ٱ</>سْتَطَعْتَ مِنْ<f>هُم بِ</>صَوْتِكَ وَأَ<q>جْلِبْ</> عَلَيْ<f>هِم بِ</>خَيْلِكَ وَرَجِلِكَ وَشَارِكْهُمْ فِى <h>ٱ</>لْأَمْ<m>وَٰ</>لِ وَ<h>ٱ</>لْأَوْ<m>لَٰ</>دِ وَعِ<q>دْ</>هُمْ ۚ وَمَا يَعِدُهُمُ <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نُ إِلَّا غُرُورًا"},{"n":65,"w":[["إِنَّ","inna","Indeed","\"নিশ্চয়ই"],["عِبَادِى","‘ibādī","My slaves","আমার দাসদের"],["لَيْسَ","laysa","not","নেই"],["لَكَ","laka","for you","জন্যে তোমার"],["عَلَيْهِمْ","‘alayhim","over them","উপর তাদের"],["سُلْطَـٰنٌۭ ۚ","sul'ṭānun","any authority","কোনো আধিপত্য"],["وَكَفَىٰ","wakafā","And sufficient","এবং যথেষ্ট"],["بِرَبِّكَ","birabbika","(is) your Lord","তোমার রব"],["وَكِيلًۭا","wakīlan","(as) a Guardian","কর্মবিধায়ক হিসেবে\""]],"t":"إِ<g>نَّ</> عِبَادِى لَيْسَ لَكَ عَلَيْهِمْ سُلْ<m>طَٰ</><d>نٌۭ ۚ وَ</>كَفَىٰ بِرَبِّكَ وَكِيلًۭا"},{"n":66,"w":[["رَّبُّكُمُ","rabbukumu","Your Lord","তোমাদের রব"],["ٱلَّذِى","alladhī","(is) the One Who","(তিনিই) যিনি"],["يُزْجِى","yuz'jī","drives","চালনা করেন"],["لَكُمُ","lakumu","for you","জন্যে তোমাদের"],["ٱلْفُلْكَ","l-ful'ka","the ship","নৌযান"],["فِى","fī","in","মধ্যে"],["ٱلْبَحْرِ","l-baḥri","the sea","সাগরের"],["لِتَبْتَغُوا۟","litabtaghū","that you may seek","যেন তোমরা সন্ধান করতে পারো"],["مِن","min","of","থেকে"],["فَضْلِهِۦٓ ۚ","faḍlihi","His Bounty","তাঁর অনুগ্রহ"],["إِنَّهُۥ","innahu","Indeed, He","নিশ্চয়ই তিনি"],["كَانَ","kāna","is","হলেন"],["بِكُمْ","bikum","to you","উপর তোমাদের"],["رَحِيمًۭا","raḥīman","Ever Merciful","দয়াশীল"]],"t":"رَّبُّكُمُ <h>ٱ</>لَّذِى يُزْجِى لَكُمُ <h>ٱ</>لْفُلْكَ فِى <h>ٱ</>لْبَحْرِ لِتَ<q>بْ</>تَغُو<s>ا۟</> مِ<k>ن فَ</>ضْلِ<o>هِۦٓ ۚ</> إِ<g>نَّ</>هُ<m>ۥ</> كَانَ بِكُمْ رَحِيمًۭا"},{"n":67,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["مَسَّكُمُ","massakumu","touches you","তোমাদের স্পর্শ করে"],["ٱلضُّرُّ","l-ḍuru","the hardship","বিপদ"],["فِى","fī","in","মধ্যে"],["ٱلْبَحْرِ","l-baḥri","the sea","সাগরের"],["ضَلَّ","ḍalla","lost","হারিয়ে যায়"],["مَن","man","(are) who","যাকে"],["تَدْعُونَ","tad‘ūna","you call","তোমরা ডাকো"],["إِلَّآ","illā","except","ছাড়া"],["إِيَّاهُ ۖ","iyyāhu","Him Alone","শুধু তিনিই"],["فَلَمَّا","falammā","But when","অতএব যখন"],["نَجَّىٰكُمْ","najjākum","He delivers you","আমরা উদ্ধার করি তোমাদের"],["إِلَى","ilā","to","দিকে"],["ٱلْبَرِّ","l-bari","the land","স্থলের"],["أَعْرَضْتُمْ ۚ","a‘raḍtum","you turn away","মুখ ফিরাও তোমরা"],["وَكَانَ","wakāna","And is","এবং হলো"],["ٱلْإِنسَـٰنُ","l-insānu","man","মানুষ"],["كَفُورًا","kafūran","ungrateful","বড়ই অকৃতজ্ঞ"]],"t":"وَإِذَا مَسَّكُمُ <h>ٱ</><l>ل</>ضُّرُّ فِى <h>ٱ</>لْبَحْرِ ضَلَّ مَ<k>ن تَ</><q>دْ</>عُونَ إِ<o>لَّآ</> إِيَّاهُ ۖ فَلَ<g>مَّ</>ا نَجَّ<m>ىٰ</>كُمْ إِلَى <h>ٱ</>لْبَرِّ أَعْرَضْتُمْ ۚ وَكَانَ <h>ٱ</>لْإِ<k>نسَٰ</>نُ كَفُورًا"},{"n":68,"w":[["أَفَأَمِنتُمْ","afa-amintum","Do you then feel secure","কি তবে নিশ্চিত আছো তোমরা"],["أَن","an","that (not)","যে (না)"],["يَخْسِفَ","yakhsifa","He will cause to swallow","ধ্বসিয়ে দিবেন"],["بِكُمْ","bikum","you","সহ তোমাদেরকে"],["جَانِبَ","jāniba","side","পাশে"],["ٱلْبَرِّ","l-bari","(of) the land","স্থলভাগের"],["أَوْ","aw","or","বা"],["يُرْسِلَ","yur'sila","send","পাঠাবেন (না)"],["عَلَيْكُمْ","‘alaykum","against you","বিরুদ্ধে তোমাদের"],["حَاصِبًۭا","ḥāṣiban","a storm of stones","কংকর বর্ষণকারী ঝড়ো হাওয়া"],["ثُمَّ","thumma","Then","এরপর"],["لَا","lā","not","না"],["تَجِدُوا۟","tajidū","you will find","তোমরা পাবে"],["لَكُمْ","lakum","for you","জন্যে তোমাদের"],["وَكِيلًا","wakīlan","a guardian","কোনো কর্মবিধায়ক"]],"t":"أَفَأَمِ<k>نتُ</>مْ <d>أَن يَ</>خْسِفَ بِكُمْ جَانِبَ <h>ٱ</>لْبَرِّ أَوْ يُرْسِلَ عَلَيْكُمْ حَاصِ<k>بًۭا ثُ</><g>مَّ</> لَا تَجِدُو<s>ا۟</> لَكُمْ وَكِيلًا"},{"n":69,"w":[["أَمْ","am","Or","অথবা (কি)"],["أَمِنتُمْ","amintum","do you feel secure","নিশ্চিত হয়েছো তোমরা"],["أَن","an","that (not)","যে (না)"],["يُعِيدَكُمْ","yu‘īdakum","He will send you back","ফিরিয়ে নিবেন তোমাদেরকে"],["فِيهِ","fīhi","into it","মধ্যে তার"],["تَارَةً","tāratan","another time","একবার"],["أُخْرَىٰ","ukh'rā","another time","অন্য"],["فَيُرْسِلَ","fayur'sila","and send","অতঃপর পাঠাবেন"],["عَلَيْكُمْ","‘alaykum","upon you","বিরুদ্ধে তোমাদের"],["قَاصِفًۭا","qāṣifan","a hurricane","প্রচন্ড ঝড়"],["مِّنَ","mina","of","থেকে"],["ٱلرِّيحِ","l-rīḥi","the wind","বাতাস"],["فَيُغْرِقَكُم","fayugh'riqakum","and drown you","অতঃপর ডুবাবেন তোমাদের"],["بِمَا","bimā","because","এ কারণে যা"],["كَفَرْتُمْ ۙ","kafartum","you disbelieved","অকৃতজ্ঞতা করেছো তোমরা"],["ثُمَّ","thumma","Then","এরপর"],["لَا","lā","not","না"],["تَجِدُوا۟","tajidū","you will find","তোমরা পাবে"],["لَكُمْ","lakum","for you","জন্যে তোমাদের"],["عَلَيْنَا","‘alaynā","against Us","বিরুদ্ধে আমাদের"],["بِهِۦ","bihi","therein","উপর এর"],["تَبِيعًۭا","tabī‘an","an avenger","কোনো সাহায্যকারী"]],"t":"أَمْ أَمِ<k>نتُ</>مْ <d>أَن يُ</>عِيدَكُمْ فِيهِ تَارَةً أُخْرَىٰ فَيُرْسِلَ عَلَيْكُمْ قَاصِ<d>فًۭا مِّ</>نَ <h>ٱ</><l>ل</>رِّيحِ فَيُغْرِقَ<f>كُم بِ</>مَا كَفَرْتُمْ ۙ ثُ<g>مَّ</> لَا تَجِدُو<s>ا۟</> لَكُمْ عَلَيْنَا بِ<m>هِۦ</> تَبِيعًۭا"},{"n":70,"w":[["۞ وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["كَرَّمْنَا","karramnā","We have honored","আমরা মর্যাদা দিয়েছি"],["بَنِىٓ","banī","(the) children of Adam","সন্তানকে"],["ءَادَمَ","ādama","(the) children of Adam","আদমের"],["وَحَمَلْنَـٰهُمْ","waḥamalnāhum","and We carried them","ও আমরা বাহন দিয়েছি তাদেরকে"],["فِى","fī","on","মধ্যে"],["ٱلْبَرِّ","l-bari","the land","স্থলের"],["وَٱلْبَحْرِ","wal-baḥri","and the sea","ও সমুদ্রের"],["وَرَزَقْنَـٰهُم","warazaqnāhum","and We have provided them","এবং আমরা জীবিকা‌ দিয়েছি তাদেরকে"],["مِّنَ","mina","of","থেকে"],["ٱلطَّيِّبَـٰتِ","l-ṭayibāti","the good things","পাক জিনিসসমূহ"],["وَفَضَّلْنَـٰهُمْ","wafaḍḍalnāhum","and We preferred them","ও আমরা শ্রেষ্ঠত্ব দিয়েছি তাদেরকে"],["عَلَىٰ","‘alā","over","উপর"],["كَثِيرٍۢ","kathīrin","many","অনেকের"],["مِّمَّنْ","mimman","of those whom","তা হ'তে যা"],["خَلَقْنَا","khalaqnā","We have created","সৃষ্টি করেছি আমরা"],["تَفْضِيلًۭا","tafḍīlan","(with) preference","যথার্থ মর্যাদা"]],"t":"۞ وَلَقَ<q>دْ</> كَرَّمْنَا بَ<o>نِىٓ</> ءَادَمَ وَحَمَلْ<m>نَٰ</>هُمْ فِى <h>ٱ</>لْبَرِّ وَ<h>ٱ</>لْبَحْرِ وَرَزَ<q>قْ</><m>نَٰ</><y>هُم مِّ</>نَ <h>ٱ</><l>ل</>طَّيِّ<m>بَٰ</>تِ وَفَضَّلْ<m>نَٰ</>هُمْ عَلَىٰ كَثِي<d>رٍۢ مِّ</><g>مَّ</>نْ خَلَ<q>قْ</>نَا تَفْضِيلًۭا"},{"n":71,"w":[["يَوْمَ","yawma","(The) Day","যেদিন"],["نَدْعُوا۟","nad‘ū","We will call","আমরা ডাকবো"],["كُلَّ","kulla","all","প্রত্যেক"],["أُنَاسٍۭ","unāsin","human beings","মানবদলকে"],["بِإِمَـٰمِهِمْ ۖ","bi-imāmihim","with their record","সহ তাদের নেতা"],["فَمَنْ","faman","then whoever","অতঃপর যাকে"],["أُوتِىَ","ūtiya","is given","দেয়া হবে"],["كِتَـٰبَهُۥ","kitābahu","his record","কর্মফল তার"],["بِيَمِينِهِۦ","biyamīnihi","in his right hand","মধ্যে তার ডানহাতের"],["فَأُو۟لَـٰٓئِكَ","fa-ulāika","then those","ঐসব লোক"],["يَقْرَءُونَ","yaqraūna","will read","তারা পড়বে"],["كِتَـٰبَهُمْ","kitābahum","their records","কর