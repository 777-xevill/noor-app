,"(of) the mankind","মানুষ"],["إِلَّا","illā","except","কিন্তু"],["كُفُورًۭا","kufūran","disbelief","অস্বীকৃতি"]],"t":"وَلَقَ<q>دْ</> صَرَّفْنَا لِل<g>نَّ</>اسِ فِى <m>هَٰ</>ذَا <h>ٱ</>لْقُرْءَانِ مِ<k>ن كُ</>لِّ مَثَ<k>لٍۢ فَ</>أَبَ<o>ىٰٓ</> أَكْثَرُ <h>ٱ</><l>ل</><g>نَّ</>اسِ إِلَّا كُفُورًۭا"},{"n":90,"w":[["وَقَالُوا۟","waqālū","And they say","এবং তারা বললো"],["لَن","lan","Never","\"কখনও না"],["نُّؤْمِنَ","nu'mina","we will believe","ঈমান আনবো আমরা"],["لَكَ","laka","in you","তোমার উপর"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["تَفْجُرَ","tafjura","you cause to gush forth","প্রবাহিত করবে তুমি"],["لَنَا","lanā","for us","জন্যে আমাদের"],["مِنَ","mina","from","থেকে"],["ٱلْأَرْضِ","l-arḍi","the earth","মাটি"],["يَنۢبُوعًا","yanbū‘an","a spring","একটি ঝর্না"]],"t":"وَقَالُو<s>ا۟</> <d>لَن نُّ</>ؤْمِنَ لَكَ حَتَّىٰ تَفْجُرَ لَنَا مِنَ <h>ٱ</>لْأَرْضِ يَ<i>نۢبُ</>وعًا"},{"n":91,"w":[["أَوْ","aw","Or","অথবা"],["تَكُونَ","takūna","you have","হবে"],["لَكَ","laka","for you","তোমার জন্যে"],["جَنَّةٌۭ","jannatun","a garden","একটি বাগান"],["مِّن","min","of","তৈরি"],["نَّخِيلٍۢ","nakhīlin","date-palms","খেজুরের (গাছের)"],["وَعِنَبٍۢ","wa‘inabin","and grapes","ও আঙ্গুরের"],["فَتُفَجِّرَ","fatufajjira","and cause to gush forth","অতঃপর প্রবাহিত করবে"],["ٱلْأَنْهَـٰرَ","l-anhāra","the rivers","ঝর্নাসমূহ"],["خِلَـٰلَهَا","khilālahā","within them","তার ভিতর দিয়ে"],["تَفْجِيرًا","tafjīran","abundantly","খুব প্রবাহিত করা"]],"t":"أَوْ تَكُونَ لَكَ جَ<g>نَّ</><d>ةٌۭ مِّن نَّ</>خِي<d>لٍۢ وَ</>عِنَ<k>بٍۢ فَ</>تُفَجِّرَ <h>ٱ</>لْأَنْ<m>هَٰ</>رَ خِ<m>لَٰ</>لَهَا تَفْجِيرًا"},{"n":92,"w":[["أَوْ","aw","Or","অথবা"],["تُسْقِطَ","tus'qiṭa","you cause to fall","তুমি ফেলে দিবে"],["ٱلسَّمَآءَ","l-samāa","the sky","আকাশ"],["كَمَا","kamā","as","যেমন"],["زَعَمْتَ","za‘amta","you have claimed","তুমি দাবি করেছো"],["عَلَيْنَا","‘alaynā","upon us","উপর আমাদের"],["كِسَفًا","kisafan","(in) pieces","টুকরো টুকরো করে"],["أَوْ","aw","or","বা"],["تَأْتِىَ","tatiya","you bring","আসবে"],["بِٱللَّهِ","bil-lahi","Allah","নিয়ে আল্লাহকে"],["وَٱلْمَلَـٰٓئِكَةِ","wal-malāikati","and the Angels","ও ফেরেশতাদেরকে"],["قَبِيلًا","qabīlan","before (us)","সামনাসামনি"]],"t":"أَوْ تُسْقِطَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءَ كَمَا زَعَمْتَ عَلَيْنَا كِسَفًا أَوْ تَأْتِىَ بِ<h>ٱ</>للَّهِ وَ<h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةِ قَبِيلًا"},{"n":93,"w":[["أَوْ","aw","Or","অথবা"],["يَكُونَ","yakūna","is","হবে"],["لَكَ","laka","for you","জন্যে তোমার"],["بَيْتٌۭ","baytun","a house","ঘর"],["مِّن","min","of","তৈরি"],["زُخْرُفٍ","zukh'rufin","ornament","সোনার"],["أَوْ","aw","or","বা"],["تَرْقَىٰ","tarqā","you ascend","আরোহণ করবে তুমি"],["فِى","fī","into","মধ্য"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশের"],["وَلَن","walan","And never","এবং কখনও না"],["نُّؤْمِنَ","nu'mina","we will believe","আমরা বিশ্বাস করবো"],["لِرُقِيِّكَ","liruqiyyika","in your ascension","তোমার আরোহণকে"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["تُنَزِّلَ","tunazzila","you bring down","অবতীর্ণ করবে তুমি"],["عَلَيْنَا","‘alaynā","to us","উপর আমাদের"],["كِتَـٰبًۭا","kitāban","a book","একটি কিতাব"],["نَّقْرَؤُهُۥ ۗ","naqra-uhu","we could read it","তা আমরা পাঠ করবো\""],["قُلْ","qul","Say","বলো"],["سُبْحَانَ","sub'ḥāna","Glorified (is)","\"পবিত্র মহান"],["رَبِّى","rabbī","my Lord","আমার রব"],["هَلْ","hal","What","\"কি (নই)"],["كُنتُ","kuntu","am I","আমি হলাম (আর কিছু)"],["إِلَّا","illā","but","এ ছাড়া"],["بَشَرًۭا","basharan","a human","মানুষ"],["رَّسُولًۭا","rasūlan","a Messenger","বার্তা-বাহক\""]],"t":"أَوْ يَكُونَ لَكَ بَيْ<d>تٌۭ مِّ</><k>ن زُ</>خْرُفٍ أَوْ تَرْقَىٰ فِى <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ وَ<d>لَن نُّ</>ؤْمِنَ لِرُقِيِّكَ حَتَّىٰ تُنَزِّلَ عَلَيْنَا كِ<m>تَٰ</><d>بًۭا نَّ</><q>قْ</>رَؤُهُ<m>ۥ</> ۗ قُلْ سُ<q>بْ</>حَانَ رَبِّى هَلْ كُ<k>نتُ</> إِلَّا بَشَ<w>رًۭا رَّ</>سُولًۭا"},{"n":94,"w":[["وَمَا","wamā","And what","এবং না"],["مَنَعَ","mana‘a","prevented","বিরত রেখেছে"],["ٱلنَّاسَ","l-nāsa","the people","মানুষদেরকে"],["أَن","an","that","যে"],["يُؤْمِنُوٓا۟","yu'minū","they believe","তারা ঈমান আনবে"],["إِذْ","idh","when","যখন"],["جَآءَهُمُ","jāahumu","came to them","তাদের কাছে এসেছে"],["ٱلْهُدَىٰٓ","l-hudā","the guidance","পথ নির্দেশ"],["إِلَّآ","illā","except","এ ছাড়া"],["أَن","an","that","যে"],["قَالُوٓا۟","qālū","they said","তারা বলেছিলো"],["أَبَعَثَ","aba‘atha","Has Allah sent","\"কি পাঠিয়েছেন"],["ٱللَّهُ","l-lahu","Has Allah sent","\"আল্লাহ্‌"],["بَشَرًۭا","basharan","a human","কোনো মানুষকে"],["رَّسُولًۭا","rasūlan","Messenger","রাসূল হিসেবে\""]],"t":"وَمَا مَنَعَ <h>ٱ</><l>ل</><g>نَّ</>اسَ <d>أَن يُ</>ؤْمِ<o>نُوٓ</><s>ا۟</> إِذْ <o>جَآ</>ءَهُمُ <h>ٱ</>لْهُدَ<o>ىٰٓ</> إِ<o>لَّآ</> أَ<k>ن قَ</>ا<o>لُوٓ</><s>ا۟</> أَبَعَثَ <h>ٱ</>للَّهُ بَشَ<w>رًۭا رَّ</>سُولًۭا"},{"n":95,"w":[["قُل","qul","Say","বলো"],["لَّوْ","law","If","\"যদি (এমন)"],["كَانَ","kāna","(there) were","হতো"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["مَلَـٰٓئِكَةٌۭ","malāikatun","Angels","ফেরেশতারা"],["يَمْشُونَ","yamshūna","walking","চলাফেরা করতো"],["مُطْمَئِنِّينَ","muṭ'ma-innīna","securely","নিশ্চিন্তে"],["لَنَزَّلْنَا","lanazzalnā","surely We (would) have sent down","অবশ্যই আমরা অবতীর্ণ নাযিল করতাম"],["عَلَيْهِم","‘alayhim","to them","উপর তাদের"],["مِّنَ","mina","from","থেকে"],["ٱلسَّمَآءِ","l-samāi","the heaven","আকাশ"],["مَلَكًۭا","malakan","an Angel","ফেরেশতা"],["رَّسُولًۭا","rasūlan","(as) a Messenger","রাসূল হিসেবে\""]],"t":"قُل لَّوْ كَانَ فِى <h>ٱ</>لْأَرْضِ مَ<o>لَٰٓ</>ئِكَ<d>ةٌۭ يَ</>مْشُونَ مُ<q>طْ</>مَئِ<g>نِّ</>ينَ لَنَزَّلْنَا عَلَيْ<y>هِم مِّ</>نَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ مَلَ<w>كًۭا رَّ</>سُولًۭا"},{"n":96,"w":[["قُلْ","qul","Say","বলো"],["كَفَىٰ","kafā","Sufficient is","\"যথেষ্ঠ"],["بِٱللَّهِ","bil-lahi","Allah","আল্লাহই"],["شَهِيدًۢا","shahīdan","(as) a witness","সাক্ষী হিসেবে"],["بَيْنِى","baynī","between me","আমার মাঝে"],["وَبَيْنَكُمْ ۚ","wabaynakum","and between you","ও তোমাদের মাঝে"],["إِنَّهُۥ","innahu","Indeed, He","নিশ্চয়ই তিনি"],["كَانَ","kāna","is","হলেন"],["بِعِبَادِهِۦ","bi‘ibādihi","of His slaves","সম্পর্কে তাঁর দাসদের"],["خَبِيرًۢا","khabīran","All-Aware","খুব অবহিত"],["بَصِيرًۭا","baṣīran","All-Seer","সর্বদ্রষ্টা\""]],"t":"قُلْ كَفَىٰ بِ<h>ٱ</>للَّهِ شَهِي<i>دًۢا بَ</>يْنِى وَبَيْنَكُمْ ۚ إِ<g>نَّ</>هُ<m>ۥ</> كَانَ بِعِبَادِ<m>هِۦ</> خَبِي<i>رًۢا بَ</>صِيرًۭا"},{"n":97,"w":[["وَمَن","waman","And whoever","এবং যাকে"],["يَهْدِ","yahdi","Allah guides","পথ দেখান"],["ٱللَّهُ","l-lahu","Allah guides","আল্লাহ"],["فَهُوَ","fahuwa","then he (is)","অতঃপর সেই"],["ٱلْمُهْتَدِ ۖ","l-muh'tadi","the guided one","সঠিক পথপ্রাপ্ত"],["وَمَن","waman","and whoever","এবং যাকে"],["يُضْلِلْ","yuḍ'lil","He lets go astray ","তিনি পথভ্রষ্ট করেন"],["فَلَن","falan","then never","অতঃপর কখনও না"],["تَجِدَ","tajida","you will find","তুমি পাবে"],["لَهُمْ","lahum","for them","জন্যে তাদের"],["أَوْلِيَآءَ","awliyāa","protectors","অভিভাবকসমূহ"],["مِن","min","besides Him","ছাড়া"],["دُونِهِۦ ۖ","dūnihi","besides Him","তাঁকে"],["وَنَحْشُرُهُمْ","wanaḥshuruhum","And We will gather them","এবং আমরা সমবেত করবো তাদেরকে"],["يَوْمَ","yawma","(on) the Day","দিনে"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) the Resurrection","ক্বিয়ামাতের"],["عَلَىٰ","‘alā","on","উপর"],["وُجُوهِهِمْ","wujūhihim","their faces ","মুখগুলোর তাদের"],["عُمْيًۭا","‘um'yan","blind","অন্ধ অবস্থায়"],["وَبُكْمًۭا","wabuk'man","and dumb","ও বোবা অবস্থায়"],["وَصُمًّۭا ۖ","waṣumman","and deaf","ও বধির অবস্হায়"],["مَّأْوَىٰهُمْ","mawāhum","Their abode","আবাসস্থল তাদের"],["جَهَنَّمُ ۖ","jahannamu","(is) Hell","জাহান্নাম"],["كُلَّمَا","kullamā","every time","যখনই"],["خَبَتْ","khabat","it subsides","তেজ কমে আসবে"],["زِدْنَـٰهُمْ","zid'nāhum","We (will) increase (for) them","আমরা বাড়িয়ে দিবো তাদের"],["سَعِيرًۭا","sa‘īran","the blazing fire","আগুন"]],"t":"وَ<d>مَن يَ</>هْدِ <h>ٱ</>للَّهُ فَهُوَ <h>ٱ</>لْمُهْتَدِ ۖ وَ<d>مَن يُ</>ضْلِلْ فَلَ<k>ن تَ</>جِدَ لَهُمْ أَوْلِ<o>يَآ</>ءَ مِ<k>ن دُ</>ونِ<m>هِۦ</> ۖ وَنَحْشُرُهُمْ يَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ عَلَىٰ وُجُوهِهِمْ عُمْ<d>يًۭا وَ</>بُكْ<d>مًۭا وَصُمًّۭا ۖ مَّ</>أْوَ<m>ىٰ</>هُمْ جَهَ<g>نَّ</>مُ ۖ كُلَّمَا خَبَتْ زِ<q>دْ</><m>نَٰ</>هُمْ سَعِيرًۭا"},{"n":98,"w":[["ذَٰلِكَ","dhālika","That","এটাই"],["جَزَآؤُهُم","jazāuhum","(is) their recompense","তাদের প্রতিফল"],["بِأَنَّهُمْ","bi-annahum","because they","এ কারণে যে তারা"],["كَفَرُوا۟","kafarū","disbelieved","অস্বীকার করেছে"],["بِـَٔايَـٰتِنَا","biāyātinā","in Our Verses","সহ আমাদের নিদর্শনাদি"],["وَقَالُوٓا۟","waqālū","and said","এবং তারা বলেছে"],["أَءِذَا","a-idhā","When","\"কি যখন"],["كُنَّا","kunnā","we are","আমরা হবো"],["عِظَـٰمًۭا","‘iẓāman","bones","হাড়"],["وَرُفَـٰتًا","warufātan","and crumbled particles","ও চূর্ণ-বিচূর্ণ"],["أَءِنَّا","a-innā","will we","কি নিশ্চয়ই আমরা"],["لَمَبْعُوثُونَ","lamab‘ūthūna","surely (be) resurrected","অবশ্যই উত্থিত হবো"],["خَلْقًۭا","khalqan","(as) a creation","সৃষ্টিতে"],["جَدِيدًا","jadīdan","new","নতুন\""]],"t":"<m>ذَٰ</>لِكَ جَ<o>زَآ</>ؤُ<f>هُم بِ</>أَ<g>نَّ</>هُمْ كَفَرُو<s>ا۟</> بِـَٔا<m>يَٰ</>تِنَا وَقَا<o>لُوٓ</><s>ا۟</> أَءِذَا كُ<g>نَّ</>ا عِ<m>ظَٰ</><d>مًۭا وَ</>رُ<m>فَٰ</>تًا أَءِ<g>نَّ</>ا لَمَ<q>بْ</>عُوثُونَ خَلْ<k>قًۭا جَ</>دِيدًا"},{"n":99,"w":[["۞ أَوَلَمْ","awalam","Do not","কি না"],["يَرَوْا۟","yaraw","they see","তারা লক্ষ্য করে"],["أَنَّ","anna","that","যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["ٱلَّذِى","alladhī","the One Who","(তিনি) যিনি"],["خَلَقَ","khalaqa","created","সৃষ্টি করেছেন"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশসমূহকে"],["وَٱلْأَرْضَ","wal-arḍa","and the earth","ও পৃথিবীকে"],["قَادِرٌ","qādirun","(is) Able","সক্ষম (নন কি)"],["عَلَىٰٓ","‘alā","[on]","উপর"],["أَن","an","to","যে"],["يَخْلُقَ","yakhluqa","create","সৃষ্টি করবেন"],["مِثْلَهُمْ","mith'lahum","the like of them","তাদের অনুরূপ"],["وَجَعَلَ","waja‘ala","And He has made","এবং স্থির করে রেখেছেন"],["لَهُمْ","lahum","for them","জন্যে তাদের"],["أَجَلًۭا","ajalan","a term","নির্দিষ্টকাল"],["لَّا","lā","no","নেই"],["رَيْبَ","rayba","doubt","কোনো সন্দেহ"],["فِيهِ","fīhi","in it","মধ্যে তার"],["فَأَبَى","fa-abā","But refused","তবুও অস্বীকার করলো"],["ٱلظَّـٰلِمُونَ","l-ẓālimūna","the wrongdoers","সীমালঙ্ঘনকারীরা"],["إِلَّا","illā","except","ছাড়া"],["كُفُورًۭا","kufūran","disbelief","অস্বীকৃতি"]],"t":"۞ أَوَلَمْ يَرَوْ<s>ا۟</> أَ<g>نَّ</> <h>ٱ</>للَّهَ <h>ٱ</>لَّذِى خَلَقَ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضَ قَادِرٌ عَلَ<o>ىٰٓ</> <d>أَن يَ</>خْلُقَ مِثْلَهُمْ وَجَعَلَ لَهُمْ أَجَلًۭ<w>ا لَّ</>ا رَيْبَ فِيهِ فَأَبَى <h>ٱ</><l>ل</><m>ظَّٰ</>لِمُونَ إِلَّا كُفُورًۭا"},{"n":100,"w":[["قُل","qul","Say","বলো"],["لَّوْ","law","If","\"যদি"],["أَنتُمْ","antum","you","তোমরা"],["تَمْلِكُونَ","tamlikūna","possess","অধিকারী হ'তে"],["خَزَآئِنَ","khazāina","the treasures","ভান্ডারসমূহের"],["رَحْمَةِ","raḥmati","(of) the Mercy","অনুগ্রহের"],["رَبِّىٓ","rabbī","(of) my Lord","আমার রবের"],["إِذًۭا","idhan","then","তাহ'লে"],["لَّأَمْسَكْتُمْ","la-amsaktum","surely you would withhold","অবশ্যই তোমরা ধরে রাখতে"],["خَشْيَةَ","khashyata","(out of) fear","ভয়ে"],["ٱلْإِنفَاقِ ۚ","l-infāqi","(of) spending","খরচ হওয়ার\""],["وَكَانَ","wakāna","And is","এবং হলো"],["ٱلْإِنسَـٰنُ","l-insānu","man","মানুষ"],["قَتُورًۭا","qatūran","stingy","বড়ই কৃপণ"]],"t":"قُل لَّوْ أَ<k>نتُ</>مْ تَمْلِكُونَ خَ<o>زَآ</>ئِنَ رَحْمَةِ رَ<o>بِّىٓ</> إِ<w>ذًۭا لَّ</>أَمْسَكْتُمْ خَشْيَةَ <h>ٱ</>لْإِ<k>نفَ</>اقِ ۚ وَكَانَ <h>ٱ</>لْإِ<k>نسَٰ</>نُ قَتُورًۭا"},{"n":101,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["ءَاتَيْنَا","ātaynā","We had given","আমরা দিয়েছিলাম"],["مُوسَىٰ","mūsā","Musa","মূসাকে"],["تِسْعَ","tis'‘a","nine","নয়টি"],["ءَايَـٰتٍۭ","āyātin","Signs","নিদর্শন"],["بَيِّنَـٰتٍۢ ۖ","bayyinātin","clear","সুস্পষ্ট"],["فَسْـَٔلْ","fasal","so ask","অতএব জিজ্ঞেস করো"],["بَنِىٓ","banī","(the) Children of Israel","বনী"],["إِسْرَٰٓءِيلَ","is'rāīla","(the) Children of Israel","ইসরাঈলকে"],["إِذْ","idh","when","যখন"],["جَآءَهُمْ","jāahum","he came to them","কাছে সে এসেছিলো তাদের"],["فَقَالَ","faqāla","then said","তখন বলেছিলো"],["لَهُۥ","lahu","to him","তাকে"],["فِرْعَوْنُ","fir'‘awnu","Firaun","ফিরআউন"],["إِنِّى","innī","Indeed, I","\"নিশ্চয়ই আমি"],["لَأَظُنُّكَ","la-aẓunnuka","[I] think you ","অবশ্যই আমি মনে করি তোমাকে"],["يَـٰمُوسَىٰ","yāmūsā","O Musa","হে মূসা"],["مَسْحُورًۭا","masḥūran","(you are) bewitched","জাদুগ্রস্ত\""]],"t":"وَلَقَ<q>دْ</> ءَاتَيْنَا مُوسَىٰ تِسْعَ ءَا<m>يَٰ</><i>تٍۭ بَ</>يِّ<m>نَٰ</><k>تٍۢ ۖ فَ</>سْـَٔلْ بَ<o>نِىٓ</> إِسْ<o>رَٰٓ</>ءِيلَ إِذْ <o>جَآ</>ءَهُمْ فَقَالَ لَهُ<m>ۥ</> فِرْعَوْنُ إِ<g>نِّ</>ى لَأَظُ<g>نُّ</>كَ <m>يَٰ</>مُوسَىٰ مَسْحُورًۭا"},{"n":102,"w":[["قَالَ","qāla","He said","সে বলেছিলো"],["لَقَدْ","laqad","Verily","\"নিশ্চয়ই"],["عَلِمْتَ","‘alim'ta","you have known","তুমি জেনেছো"],["مَآ","mā","none","না"],["أَنزَلَ","anzala","has sent down","অবতীর্ণ করেছেন"],["هَـٰٓؤُلَآءِ","hāulāi","these","(অন্য কেউ) এসব"],["إِلَّا","illā","except","কিন্তু"],["رَبُّ","rabbu","(the) Lord","রব"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশসমূহের"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীর"],["بَصَآئِرَ","baṣāira","(as) evidence","প্রত্যক্ষ প্রমাণ হিসেবে"],["وَإِنِّى","wa-innī","and indeed, I","এবং নিশ্চয়ই আমি"],["لَأَظُنُّكَ","la-aẓunnuka","[I] surely think you","অবশ্যই মনে করি আমি তোমাকে"],["يَـٰفِرْعَوْنُ","yāfir'‘awnu","O Firaun","হে ফিরআউন"],["مَثْبُورًۭا","mathbūran","(you are) destroyed","(ধ্বংসকৃত) হতভাগ্য\""]],"t":"قَالَ لَقَ<q>دْ</> عَلِمْتَ <o>مَآ</> أَ<k>نزَ</>لَ <o>هَٰٓؤُلَآ</>ءِ إِلَّا رَبُّ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ بَ<o>صَآ</>ئِرَ وَإِ<g>نِّ</>ى لَأَظُ<g>نُّ</>كَ <m>يَٰ</>فِرْعَوْنُ مَثْبُورًۭا"},{"n":103,"w":[["فَأَرَادَ","fa-arāda","So he intended","অতঃপর সে চাইলো"],["أَن","an","to","যে"],["يَسْتَفِزَّهُم","yastafizzahum","drive them out","উচ্ছেদ করবে তাদেরকে"],["مِّنَ","mina","from","থেকে"],["ٱلْأَرْضِ","l-arḍi","the land","দেশ"],["فَأَغْرَقْنَـٰهُ","fa-aghraqnāhu","but We drowned him","অতঃপর আমরা ডুবিয়েছিলাম তাকে"],["وَمَن","waman","and who","এবং যারা (ছিলো)"],["مَّعَهُۥ","ma‘ahu","(were) with him","সাথে তার"],["جَمِيعًۭا","jamī‘an","all","সকলকে"]],"t":"فَأَرَادَ <d>أَن يَ</>سْتَفِزَّ<y>هُم مِّ</>نَ <h>ٱ</>لْأَرْضِ فَأَغْرَ<q>قْ</><m>نَٰ</>هُ وَ<d>مَن مَّ</>عَهُ<m>ۥ</> جَمِيعًۭا"},{"n":104,"w":[["وَقُلْنَا","waqul'nā","And We said","এবং আমরা বলেছিলাম"],["مِنۢ","min","after him","থেকে"],["بَعْدِهِۦ","ba‘dihi","after him","তারপর"],["لِبَنِىٓ","libanī","to the Children of Israel","জন্যে বনী"],["إِسْرَٰٓءِيلَ","is'rāīla","to the Children of Israel","ইসরাঈলের"],["ٱسْكُنُوا۟","us'kunū","Dwell","\"তোমরা বসবাস করো"],["ٱلْأَرْضَ","l-arḍa","(in) the land","এ দেশে"],["فَإِذَا","fa-idhā","then when","অতঃপর যখন"],["جَآءَ","jāa","comes","আসবে"],["وَعْدُ","wa‘du","(the) promise","প্রতিশ্রুতি"],["ٱلْـَٔاخِرَةِ","l-ākhirati","(of) the Hereafter","আখিরাতের"],["جِئْنَا","ji'nā","We will bring","আমরা আসবো"],["بِكُمْ","bikum","you","নিয়ে তোমাদেরকে"],["لَفِيفًۭا","lafīfan","(as) a mixed crowd","সমবেত করে\""]],"t":"وَقُلْنَا <i>مِنۢ بَ</>عْدِ<m>هِۦ</> لِبَ<o>نِىٓ</> إِسْ<o>رَٰٓ</>ءِيلَ <h>ٱ</>سْكُنُو<s>ا۟</> <h>ٱ</>لْأَرْضَ فَإِذَا <o>جَآ</>ءَ وَعْدُ <h>ٱ</>لْءَاخِرَةِ جِئْنَا بِكُمْ لَفِيفًۭا"},{"n":105,"w":[["وَبِٱلْحَقِّ","wabil-ḥaqi","And with the truth","এবং সহ সত্য"],["أَنزَلْنَـٰهُ","anzalnāhu","We sent it down","তা আমরা অবতীর্ণ করেছি"],["وَبِٱلْحَقِّ","wabil-ḥaqi","and with the truth","এবং সহ সত্য"],["نَزَلَ ۗ","nazala","it descended","অবতীর্ণ হয়েছে"],["وَمَآ","wamā","And not","এবং নি"],["أَرْسَلْنَـٰكَ","arsalnāka","We sent you","তোমাকে আমরা পাঠিয়েছি"],["إِلَّا","illā","except","এছাড়া"],["مُبَشِّرًۭا","mubashiran","(as) a bearer of glad tidings","সুসংবাদদাতা হিসেবে"],["وَنَذِيرًۭا","wanadhīran","and a warner","ও সতর্ককারী হিসেবে"]],"t":"وَبِ<h>ٱ</>لْحَقِّ أَ<k>نزَ</>لْ<m>نَٰ</>هُ وَبِ<h>ٱ</>لْحَقِّ نَزَلَ ۗ وَ<o>مَآ</> أَرْسَلْ<m>نَٰ</>كَ إِلَّا مُبَشِّ<d>رًۭا وَ</>نَذِيرًۭا"},{"n":106,"w":[["وَقُرْءَانًۭا","waqur'ānan","And the Quran","এবং (এই) কুরআন"],["فَرَقْنَـٰهُ","faraqnāhu","We have divided","আমরা খন্ড খন্ড করেছি তাকে"],["لِتَقْرَأَهُۥ","litaqra-ahu","that you might recite it","যেন তুমি পাঠ করো তা"],["عَلَى","‘alā","to","নিকট"],["ٱلنَّاسِ","l-nāsi","the people","মানুষের"],["عَلَىٰ","‘alā","at","উপর"],["مُكْثٍۢ","muk'thin","intervals","অল্প অল্প করে"],["وَنَزَّلْنَـٰهُ","wanazzalnāhu","And We have revealed it","এবং আমরা অবতীর্ণ করেছি তা"],["تَنزِيلًۭا","tanzīlan","(in) stages","(ক্রমশঃ) অবতরণ"]],"t":"وَقُرْءَا<k>نًۭا فَ</>رَ<q>قْ</><m>نَٰ</>هُ لِتَ<q>قْ</>رَأَهُ<m>ۥ</> عَلَى <h>ٱ</><l>ل</><g>نَّ</>اسِ عَلَىٰ مُكْ<d>ثٍۢ وَ</>نَزَّلْ<m>نَٰ</>هُ تَ<k>نزِ</>يلًۭا"},{"n":107,"w":[["قُلْ","qul","Say","বলো"],["ءَامِنُوا۟","āminū","Believe","\"ঈমান আনো"],["بِهِۦٓ","bihi","in it","উপর এর"],["أَوْ","aw","or","বা"],["لَا","lā","(do) not","না"],["تُؤْمِنُوٓا۟ ۚ","tu'minū","believe","তোমরা ঈমান আনো"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যাদেরকে"],["أُوتُوا۟","ūtū","were given","দেয়া হয়েছে"],["ٱلْعِلْمَ","l-‘il'ma","the knowledge","জ্ঞান"],["مِن","min","before it","থেকে"],["قَبْلِهِۦٓ","qablihi","before it","পূর্ব এর"],["إِذَا","idhā","when","যখন"],["يُتْلَىٰ","yut'lā","it is recited","পাঠ করা হয়"],["عَلَيْهِمْ","‘alayhim","to them","কাছে তাদের"],["يَخِرُّونَ","yakhirrūna","they fall","তারা লুটিয়ে পড়ে যায়"],["لِلْأَذْقَانِ","lil'adhqāni","on their faces","উপর চিবুকসমূহের"],["سُجَّدًۭا","sujjadan","(in) prostration","সিজদা অবস্থায়\""]],"t":"قُلْ ءَامِنُو<s>ا۟</> بِ<o>هِۦٓ</> أَوْ لَا تُؤْمِ<o>نُوٓ</><s>ا۟</> ۚ إِ<g>نَّ</> <h>ٱ</>لَّذِينَ أُوتُو<s>ا۟</> <h>ٱ</>لْعِلْمَ مِ<k>ن قَ</><q>بْ</>لِ<o>هِۦٓ</> إِذَا يُتْلَىٰ عَلَيْهِمْ يَخِرُّونَ لِلْأَذْقَانِ سُجَّدًۭا"},{"n":108,"w":[["وَيَقُولُونَ","wayaqūlūna","And they say","এবং তারা বলে"],["سُبْحَـٰنَ","sub'ḥāna","Glory be to","\"পবিত্র মহান"],["رَبِّنَآ","rabbinā","our Lord","আমাদের রব"],["إِن","in","Indeed","নিশ্চয়ই"],["كَانَ","kāna","is","হবে"],["وَعْدُ","wa‘du","(the) promise","প্রতিশ্রুতি"],["رَبِّنَا","rabbinā","(of) our Lord","আমাদের রবের"],["لَمَفْعُولًۭا","lamaf‘ūlan","surely fulfilled","অবশ্যই কার্যকরী\""]],"t":"وَيَقُولُونَ سُ<q>بْ</><m>حَٰ</>نَ رَبِّ<o>نَآ</> إِ<k>ن كَ</>انَ وَعْدُ رَبِّنَا لَمَفْعُولًۭا"},{"n":109,"w":[["وَيَخِرُّونَ","wayakhirrūna","And they fall","এবং তারা লুটিয়ে পড়ে যায়"],["لِلْأَذْقَانِ","lil'adhqāni","on their faces","(সিজদায়) উপর চিবুকসমূহের"],["يَبْكُونَ","yabkūna","weeping","তারা কাঁদতে থাকে"],["وَيَزِيدُهُمْ","wayazīduhum","and it increases them","ও তাদের বৃদ্ধি করে"],["خُشُوعًۭا ۩","khushū‘an","(in) humility","বিনয় অবস্থা (নিবিড় আনুগত্য)"]],"t":"وَيَخِرُّونَ لِلْأَذْقَانِ يَ<q>بْ</>كُونَ وَيَزِيدُهُمْ خُشُوعًۭا ۩"},{"n":110,"w":[["قُلِ","quli","Say","বলো"],["ٱدْعُوا۟","id'‘ū","Invoke","\"তোমরা ডাকো"],["ٱللَّهَ","l-laha","Allah","আল্লাহ (বলে)"],["أَوِ","awi","or","বা"],["ٱدْعُوا۟","id'‘ū","invoke","তোমরা ডাক"],["ٱلرَّحْمَـٰنَ ۖ","l-raḥmāna","the Most Gracious","রহমান (বলে)"],["أَيًّۭا","ayyan","By whatever (name)","যেই (নামেই)"],["مَّا","mā","By whatever (name)","যেই (নামেই)"],["تَدْعُوا۟","tad‘ū","you invoke","তোমরা ডাকো"],["فَلَهُ","falahu","to Him (belongs)","অতঃপর তাঁর আছে"],["ٱلْأَسْمَآءُ","l-asmāu","the Most Beautiful Names","নামসমূহ"],["ٱلْحُسْنَىٰ ۚ","l-ḥus'nā","the Most Beautiful Names","সুন্দর"],["وَلَا","walā","And (do) not","এবং না"],["تَجْهَرْ","tajhar","be loud","খুব উঁচু স্বর করো"],["بِصَلَاتِكَ","biṣalātika","in your prayers","তোমার সালাতে"],["وَلَا","walā","and not","এবং না"],["تُخَافِتْ","tukhāfit","be silent","খুব নিচু স্বর করো"],["بِهَا","bihā","therein","তাতে"],["وَٱبْتَغِ","wa-ib'taghi","but seek","এবং অবলম্বন করো"],["بَيْنَ","bayna","between","মাঝে"],["ذَٰلِكَ","dhālika","that","এর"],["سَبِيلًۭا","sabīlan","a way","মধ্য পথ\""]],"t":"قُلِ <h>ٱ</><q>دْ</>عُو<s>ا۟</> <h>ٱ</>للَّهَ أَوِ <h>ٱ</><q>دْ</>عُو<s>ا۟</> <h>ٱ</><l>ل</>رَّحْ<m>مَٰ</>نَ ۖ أَ<d>يًّۭا مَّ</>ا تَ<q>دْ</>عُو<s>ا۟</> فَلَهُ <h>ٱ</>لْأَسْ<o>مَآ</>ءُ <h>ٱ</>لْحُسْنَىٰ ۚ وَلَا تَ<q>جْ</>هَرْ بِصَلَاتِكَ وَلَا تُخَافِتْ بِهَا وَ<h>ٱ</><q>بْ</>تَغِ بَيْنَ <m>ذَٰ</>لِكَ سَبِيلًۭا"},{"n":111,"w":[["وَقُلِ","waquli","And say","এবং বলো"],["ٱلْحَمْدُ","l-ḥamdu","All Praise","\"সব প্রশংসাই"],["لِلَّهِ","lillahi","(is) for Allah","জন্যে আল্লাহ তা'লার"],["ٱلَّذِى","alladhī","the One Who","যিনি"],["لَمْ","lam","has not taken","নি"],["يَتَّخِذْ","yattakhidh","has not taken","গ্রহণ করেন"],["وَلَدًۭا","waladan","a son","পুত্রসন্তান"],["وَلَمْ","walam","and not","আর না"],["يَكُن","yakun","is","আছে"],["لَّهُۥ","lahu","for Him","জন্যে তাঁর"],["شَرِيكٌۭ","sharīkun","a partner","কোনো অংশীদার"],["فِى","fī","in","মধ্যে"],["ٱلْمُلْكِ","l-mul'ki","the dominion","সার্বভৌমত্বে"],["وَلَمْ","walam","and not","এবং না (প্রয়োজন)"],["يَكُن","yakun","is","আছে"],["لَّهُۥ","lahu","for Him","জন্যে তাঁর"],["وَلِىٌّۭ","waliyyun","any protector","কোনো অভিভাবক"],["مِّنَ","mina","out of","থেকে"],["ٱلذُّلِّ ۖ","l-dhuli","weakness","(এমন কোন) দুর্বলতা"],["وَكَبِّرْهُ","wakabbir'hu","And magnify Him","এবং তাঁর মাহাত্ম্য  ঘোষণা করো"],["تَكْبِيرًۢا","takbīran","(with all) magnificence","(পূর্ণভাবে) মাহাত্ম্য\""]],"t":"وَقُلِ <h>ٱ</>لْحَمْدُ لِلَّهِ <h>ٱ</>لَّذِى لَمْ يَتَّخِذْ وَلَ<d>دًۭا وَ</>لَمْ يَ<w>كُن لَّ</>هُ<m>ۥ</> شَرِي<k>كٌۭ فِ</>ى <h>ٱ</>لْمُلْكِ وَلَمْ يَ<w>كُن لَّ</>هُ<m>ۥ</> وَلِ<d>ىٌّۭ مِّ</>نَ <h>ٱ</><l>ل</>ذُّلِّ ۖ وَكَبِّرْهُ تَكْبِيرًۢا"}]}