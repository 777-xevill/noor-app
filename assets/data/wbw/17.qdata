ْ<m>بَٰ</>طِلُ ۚ إِ<g>نَّ</> <h>ٱ</>لْ<m>بَٰ</>طِلَ كَانَ زَهُوقًۭا"},{"n":82,"w":[["وَنُنَزِّلُ","wanunazzilu","And We reveal","এবং আমরা অবতীর্ণ করেছি"],["مِنَ","mina","from","মধ্যে"],["ٱلْقُرْءَانِ","l-qur'āni","the Quran","কুরআনের"],["مَا","mā","that","যা (এমন যে)"],["هُوَ","huwa","it","তা"],["شِفَآءٌۭ","shifāon","(is) a healing","আরোগ্য"],["وَرَحْمَةٌۭ","waraḥmatun","and a mercy","ও অনুগ্রহ"],["لِّلْمُؤْمِنِينَ ۙ","lil'mu'minīna","for the believers","জন্যে মু'মিনদের"],["وَلَا","walā","but not","কিন্তু না"],["يَزِيدُ","yazīdu","it increases","বৃদ্ধি করে"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","সীমালঙ্ঘনকারীদের"],["إِلَّا","illā","except","এ ছাড়া"],["خَسَارًۭا","khasāran","(in) loss","ক্ষতি"]],"t":"وَنُنَزِّلُ مِنَ <h>ٱ</>لْقُرْءَانِ مَا هُوَ شِ<o>فَآ</><d>ءٌۭ وَ</>رَحْمَ<w>ةٌۭ لِّ</>لْمُؤْمِنِينَ ۙ وَلَا يَزِيدُ <h>ٱ</><l>ل</><m>ظَّٰ</>لِمِينَ إِلَّا خَسَارًۭا"},{"n":83,"w":[["وَإِذَآ","wa-idhā","And when","এবং যখন"],["أَنْعَمْنَا","an‘amnā","We bestow favor","আমরা অনুগ্রহ করি"],["عَلَى","‘alā","on","উপর"],["ٱلْإِنسَـٰنِ","l-insāni","man","মানুষের"],["أَعْرَضَ","a‘raḍa","he turns away","সে মুখ ফিরায়"],["وَنَـَٔا","wanaā","and becomes remote","এবং দূরে সরে"],["بِجَانِبِهِۦ ۖ","bijānibihi","on his side","(অহংকার করে) সহ তার পার্শ্ব"],["وَإِذَا","wa-idhā","And when","আর যখন"],["مَسَّهُ","massahu","touches him","তাকে স্পর্শ করে"],["ٱلشَّرُّ","l-sharu","the evil","অনিষ্ট"],["كَانَ","kāna","he is","সে হয়"],["يَـُٔوسًۭا","yaūsan","(in) despair","হতাশ"]],"t":"وَإِ<o>ذَآ</> أَنْعَمْنَا عَلَى <h>ٱ</>لْإِ<k>نسَٰ</>نِ أَعْرَضَ وَنَـَٔا بِجَانِبِ<m>هِۦ</> ۖ وَإِذَا مَسَّهُ <h>ٱ</><l>ل</>شَّرُّ كَانَ يَـُٔوسًۭا"},{"n":84,"w":[["قُلْ","qul","Say","বলো"],["كُلٌّۭ","kullun","Each","\"প্রত্যেকে"],["يَعْمَلُ","ya‘malu","works","কাজ করে"],["عَلَىٰ","‘alā","on","উপর"],["شَاكِلَتِهِۦ","shākilatihi","his manner","তার স্বভাব অনুযায়ী"],["فَرَبُّكُمْ","farabbukum","but your Lord","অতঃপর তোমাদের রবই"],["أَعْلَمُ","a‘lamu","(is) most knowing","খুব জানেন"],["بِمَنْ","biman","of who","সম্পর্কে তার (যে)"],["هُوَ","huwa","[he]","সে"],["أَهْدَىٰ","ahdā","(is) best guided","অধিক পরিচালিত"],["سَبِيلًۭا","sabīlan","(in) way","(সঠিক) পথে\""]],"t":"قُلْ كُ<d>لٌّۭ يَ</>عْمَلُ عَلَىٰ شَاكِلَتِ<m>هِۦ</> فَرَبُّكُمْ أَعْلَمُ بِمَنْ هُوَ أَهْدَىٰ سَبِيلًۭا"},{"n":85,"w":[["وَيَسْـَٔلُونَكَ","wayasalūnaka","And they ask you","এবং তোমাকে তারা প্রশ্ন করে"],["عَنِ","‘ani","concerning","সম্পর্কে"],["ٱلرُّوحِ ۖ","l-rūḥi","the soul","রুহ"],["قُلِ","quli","Say","বলো"],["ٱلرُّوحُ","l-rūḥu","The soul","\"রুহ (আসে)"],["مِنْ","min","(is) of","থেকে"],["أَمْرِ","amri","(the) affair","নির্দেশ"],["رَبِّى","rabbī","(of) my Lord","আমার রবের"],["وَمَآ","wamā","And not","এবং না"],["أُوتِيتُم","ūtītum","you have been given","তোমাদের দেয়া হয়েছে"],["مِّنَ","mina","of","থেকে"],["ٱلْعِلْمِ","l-‘il'mi","the knowledge","জ্ঞান"],["إِلَّا","illā","except","ছাড়া"],["قَلِيلًۭا","qalīlan","a little","সামান্য\""]],"t":"وَيَسْـَٔلُونَكَ عَنِ <h>ٱ</><l>ل</>رُّوحِ ۖ قُلِ <h>ٱ</><l>ل</>رُّوحُ مِنْ أَمْرِ رَبِّى وَ<o>مَآ</> أُوتِي<y>تُم مِّ</>نَ <h>ٱ</>لْعِلْمِ إِلَّا قَلِيلًۭا"},{"n":86,"w":[["وَلَئِن","wala-in","And if","এবং অবশ্যই যদি"],["شِئْنَا","shi'nā","We willed","আমরা চাইতাম"],["لَنَذْهَبَنَّ","lanadhhabanna","We (would) have surely taken away","অবশ্যই আমরা যেতাম"],["بِٱلَّذِىٓ","bi-alladhī","that which","নিয়ে ঐ জিনিস যা"],["أَوْحَيْنَآ","awḥaynā","We have revealed","আমরা ওহী করেছি"],["إِلَيْكَ","ilayka","to you","তোমার প্রতি"],["ثُمَّ","thumma","Then","এরপর"],["لَا","lā","not","না"],["تَجِدُ","tajidu","you would find","পেতে"],["لَكَ","laka","for you","তোমার জন্যে"],["بِهِۦ","bihi","concerning it","তা সম্পর্কে"],["عَلَيْنَا","‘alaynā","against Us","বিরুদ্ধে আমাদের"],["وَكِيلًا","wakīlan","any advocate","কোনো কর্মবিধায়ক"]],"t":"وَلَئِ<k>ن شِ</>ئْنَا لَنَذْهَبَ<g>نَّ</> بِ<h>ٱ</>لَّ<o>ذِىٓ</> أَوْحَيْ<o>نَآ</> إِلَيْكَ ثُ<g>مَّ</> لَا تَجِدُ لَكَ بِ<m>هِۦ</> عَلَيْنَا وَكِيلًا"},{"n":87,"w":[["إِلَّا","illā","Except","কিন্তু"],["رَحْمَةًۭ","raḥmatan","a mercy","(তা না করা) অনুগ্