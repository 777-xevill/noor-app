لْمُطَّهِّرِينَ","l-muṭahirīna","the ones who purify themselves","পবিত্রতা অর্জনকারীদেরকে"]],"t":"لَا تَقُمْ فِيهِ أَبَ<w>دًۭا ۚ لَّ</>مَسْجِدٌ أُسِّسَ عَلَى <h>ٱ</><l>ل</>تَّ<q>قْ</>وَىٰ مِنْ أَوَّلِ يَوْمٍ أَحَقُّ أَ<k>ن تَ</>قُومَ فِيهِ ۚ فِيهِ رِجَا<d>لٌۭ يُ</>حِبُّونَ <d>أَن يَ</>تَطَهَّرُو<s>ا۟ ۚ</> وَ<h>ٱ</>للَّهُ يُحِبُّ <h>ٱ</>لْمُطَّهِّ<p>رِي</>نَ"},{"n":109,"w":[["أَفَمَنْ","afaman","Then is (one) who","কি তবে যে"],["أَسَّسَ","assasa","founded","ভিত্তি স্হাপন করেছে"],["بُنْيَـٰنَهُۥ","bun'yānahu","his building","ঘরের তার"],["عَلَىٰ","‘alā","on","উপর"],["تَقْوَىٰ","taqwā","righteousness","তাকওয়ার"],["مِنَ","mina","from","এর"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["وَرِضْوَٰنٍ","wariḍ'wānin","and (His) pleasure","ও তাঁর সন্তুষ্টির (জন্যে)"],["خَيْرٌ","khayrun","better","উত্তম"],["أَم","am","or","না কি"],["مَّنْ","man","(one) who","যে"],["أَسَّسَ","assasa","founded","ভিত্তি স্হাপন করেছে"],["بُنْيَـٰنَهُۥ","bun'yānahu","his building","ঘরের তার"],["عَلَىٰ","‘alā","on","উপর"],["شَفَا","shafā","edge","কিনারার"],["جُرُفٍ","jurufin","(of) a cliff","খাদের"],["هَارٍۢ","hārin","(about to) collapse","পড়ন্ত"],["فَٱنْهَارَ","fa-in'hāra","so it collapsed","অতঃপর তা পড়লো"],["بِهِۦ","bihi","with him","সহ তাকে"],["فِى","fī","in","মধ্যে"],["نَارِ","nāri","(the) Fire","আগুনের"],["جَهَنَّمَ ۗ","jahannama","(of) Hell","জাহান্নামের"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["لَا","lā","(does) not","না"],["يَهْدِى","yahdī","guide","পথ দেখান"],["ٱلْقَوْمَ","l-qawma","the wrongdoing people","(এমন)সম্প্রদায়কে"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoing people","(যারা)সীমালঙ্ঘনকারী"]],"t":"أَفَمَنْ أَسَّسَ بُنْ<m>يَٰ</>نَهُ<m>ۥ</> عَلَىٰ تَ<q>قْ</>وَىٰ مِنَ <h>ٱ</>للَّهِ وَرِضْ<m>وَٰ</>نٍ خَيْرٌ <y>أَم مَّ</>نْ أَسَّسَ بُنْ<m>يَٰ</>نَهُ<m>ۥ</> عَلَىٰ شَفَا جُرُفٍ هَا<k>رٍۢ فَ</><h>ٱ</>نْهَارَ بِ<m>هِۦ</> فِى نَارِ جَهَ<g>نَّ</>مَ ۗ وَ<h>ٱ</>للَّهُ لَا يَهْدِى <h>ٱ</>لْقَوْمَ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":110,"w":[["لَا","lā","Not","না"],["يَزَالُ","yazālu","(will) cease","সর্বদা হয়ে থাকবে"],["بُنْيَـٰنُهُمُ","bun'yānuhumu","their building","ঘর তাদের"],["ٱلَّذِى","alladhī","which","যা"],["بَنَوْا۟","banaw","they built","তারা বানিয়েছে"],["رِيبَةًۭ","rībatan","a (cause of) doubt","সন্দেহের কারণ (বীজ)"],["فِى","fī","in","মধ্যে"],["قُلُوبِهِمْ","qulūbihim","their hearts","অন্তরের তাদের"],["إِلَّآ","illā","except","যে পর্যন্ত না"],["أَن","an","that","যে"],["تَقَطَّعَ","taqaṭṭa‘a","(are) cut into pieces","ছিন্নভিন্ন হবে"],["قُلُوبُهُمْ ۗ","qulūbuhum","their hearts","অন্তর তাদের"],["وَٱللَّهُ","wal-lahu","And Allah","আর আল্লাহ"],["عَلِيمٌ","‘alīmun","(is) All-Knower","সবকিছু জানেন"],["حَكِيمٌ","ḥakīmun","All-Wise","মহাবিজ্ঞ"]],"t":"لَا يَزَالُ بُنْ<m>يَٰ</>نُهُمُ <h>ٱ</>لَّذِى بَنَوْ<s>ا۟</> رِيبَ<k>ةًۭ فِ</>ى قُلُوبِهِمْ إِ<o>لَّآ</> أَ<k>ن تَ</>قَطَّعَ قُلُوبُهُمْ ۗ وَ<h>ٱ</>للَّهُ عَلِيمٌ حَ<p>كِي</>مٌ"},{"n":111,"w":[["۞ إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["ٱشْتَرَىٰ","ish'tarā","(has) purchased","কিনে নিয়েছেন"],["مِنَ","mina","from","হতে"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believers","মু'মিনদের"],["أَنفُسَهُمْ","anfusahum","their lives","জীবনকে তাদের"],["وَأَمْوَٰلَهُم","wa-amwālahum","and their wealth","ও ধনসম্পদকে তাদের"],["بِأَنَّ","bi-anna","because","বিনিময়ে যে"],["لَهُمُ","lahumu","for them","জন্যে তাদের (রয়েছে)"],["ٱلْجَنَّةَ ۚ","l-janata","(is) Paradise","জান্নাত"],["يُقَـٰتِلُونَ","yuqātilūna","They fight","তারা লড়াই করে"],["فِى","fī","in","মধ্যে"],["سَبِيلِ","sabīli","(the) way","পথের"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["فَيَقْتُلُونَ","fayaqtulūna","they slay","অতঃপর তারা মারে"],["وَيُقْتَلُونَ ۖ","wayuq'talūna","and they are slain","ও তারা নিহত হয়"],["وَعْدًا","wa‘dan","A promise","প্রতিশ্রুতি (রয়েছে)"],["عَلَيْهِ","‘alayhi","upon Him","সম্পর্কে এ"],["حَقًّۭا","ḥaqqan","true","সত্য"],["فِى","fī","in","মধ্যে"],["ٱلتَّوْرَىٰةِ","l-tawrāti","the Taurat","তাওরাতের"],["وَٱلْإِنجِيلِ","wal-injīli","and the Injeel","ও ইনজিলের"],["وَٱلْقُرْءَانِ ۚ","wal-qur'āni","and the Quran","এবং কুরআনেও"],["وَمَنْ","waman","And who","এবং (আর) কে"],["أَوْفَىٰ","awfā","(is) more faithful","অধিক পালনকারী (হতে পারে)"],["بِعَهْدِهِۦ","bi‘ahdihi","to his promise","সম্পর্কে প্রতিশ্রুতি তার"],["مِنَ","mina","than","চেয়েও"],["ٱللَّهِ ۚ","l-lahi","Allah","আল্লাহর"],["فَٱسْتَبْشِرُوا۟","fa-is'tabshirū","So rejoice","অতএব তোমরা খুশি হও"],["بِبَيْعِكُمُ","bibay‘ikumu","in your transaction","নিয়ে তোমাদের কেনা বেচার"],["ٱلَّذِى","alladhī","which","যা"],["بَايَعْتُم","bāya‘tum","you have contracted","কেনাবেচা করছো তোমরা"],["بِهِۦ ۚ","bihi","[with it]","সাথে তাঁর"],["وَذَٰلِكَ","wadhālika","And that","এবং এটা"],["هُوَ","huwa","it","সেই"],["ٱلْفَوْزُ","l-fawzu","(is) the success","সফলতা"],["ٱلْعَظِيمُ","l-‘aẓīmu","the great","মহা"]],"t":"۞ إِ<g>نَّ</> <h>ٱ</>للَّهَ <h>ٱ</>شْتَرَىٰ مِنَ <h>ٱ</>لْمُؤْمِنِينَ أَ<k>نفُ</>سَهُمْ وَأَمْ<m>وَٰ</>لَ<f>هُم بِ</>أَ<g>نَّ</> لَهُمُ <h>ٱ</>لْجَ<g>نَّ</>ةَ ۚ يُ<m>قَٰ</>تِلُونَ فِى سَبِيلِ <h>ٱ</>للَّهِ فَيَ<q>قْ</>تُلُونَ وَيُ<q>قْ</>تَلُونَ ۖ وَعْدًا عَلَيْهِ حَ<k>قًّۭا فِ</>ى <h>ٱ</><l>ل</>تَّوْرَ<m>ىٰ</>ةِ وَ<h>ٱ</>لْإِ<k>نجِ</>يلِ وَ<h>ٱ</>لْقُرْءَانِ ۚ وَمَنْ أَوْفَىٰ بِعَهْدِ<m>هِۦ</> مِنَ <h>ٱ</>للَّهِ ۚ فَ<h>ٱ</>سْتَ<q>بْ</>شِرُو<s>ا۟</> بِبَيْعِكُمُ <h>ٱ</>لَّذِى بَايَعْ<f>تُم بِ</><m>هِۦ</> ۚ وَ<m>ذَٰ</>لِكَ هُوَ <h>ٱ</>لْفَوْزُ <h>ٱ</>لْعَ<p>ظِي</>مُ"},{"n":112,"w":[["ٱلتَّـٰٓئِبُونَ","al-tāibūna","Those who turn in repentance","(তারা) তওবাকারী"],["ٱلْعَـٰبِدُونَ","l-‘ābidūna","those who worship","ইবাদতকারী"],["ٱلْحَـٰمِدُونَ","l-ḥāmidūna","those who praise","(আল্লাহর) প্রশংসাকারী"],["ٱلسَّـٰٓئِحُونَ","l-sāiḥūna","those who go out","সিয়াম পালনকারী"],["ٱلرَّٰكِعُونَ","l-rāki‘ūna","those who bow down","রুকুকারী"],["ٱلسَّـٰجِدُونَ","l-sājidūna","those who prostrate","সিজদাকারী"],["ٱلْـَٔامِرُونَ","l-āmirūna","those who enjoin","নির্দেশদানকারী"],["بِٱلْمَعْرُوفِ","bil-ma‘rūfi","the right","ব্যাপারে ভালো কাজের"],["وَٱلنَّاهُونَ","wal-nāhūna","and those who forbid","ও নিষেধকারী"],["عَنِ","‘ani","[on]","হতে"],["ٱلْمُنكَرِ","l-munkari","the wrong","মন্দকাজ"],["وَٱلْحَـٰفِظُونَ","wal-ḥāfiẓūna","and those who observe","এবং সংরক্ষণকারী"],["لِحُدُودِ","liḥudūdi","(the) limits","প্রতি সীমারেখার"],["ٱللَّهِ ۗ","l-lahi","(of) Allah","আল্লাহর"],["وَبَشِّرِ","wabashiri","And give glad tidings","আর তুমি সুসংবাদ দাও"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","(to) the believers","(ঐসব) মু'মিনদেরকে"]],"t":"ٱ<l>ل</><o>تَّٰٓ</>ئِبُونَ <h>ٱ</>لْ<m>عَٰ</>بِدُونَ <h>ٱ</>لْ<m>حَٰ</>مِدُونَ <h>ٱ</><l>ل</><o>سَّٰٓ</>ئِحُونَ <h>ٱ</><l>ل</><m>رَّٰ</>كِعُونَ <h>ٱ</><l>ل</><m>سَّٰ</>جِدُونَ <h>ٱ</>لْءَامِرُونَ بِ<h>ٱ</>لْمَعْرُوفِ وَ<h>ٱ</><l>ل</><g>نَّ</>اهُونَ عَنِ <h>ٱ</>لْمُ<k>نكَ</>رِ وَ<h>ٱ</>لْ<m>حَٰ</>فِظُونَ لِحُدُودِ <h>ٱ</>للَّهِ ۗ وَبَشِّرِ <h>ٱ</>لْمُؤْمِ<p>نِي</>نَ"},{"n":113,"w":[["مَا","mā","Not","নয়"],["كَانَ","kāna","(it) is","শোভনীয়"],["لِلنَّبِىِّ","lilnnabiyyi","for the Prophet","জন্যে নাবীর"],["وَٱلَّذِينَ","wa-alladhīna","and those who","এবং যারা"],["ءَامَنُوٓا۟","āmanū","believe","ঈমান এনেছে (তাদের জন্যে)"],["أَن","an","that","যে"],["يَسْتَغْفِرُوا۟","yastaghfirū","they ask forgiveness","তারা ক্ষমা চাইবে (আল্লাহর কাছে)"],["لِلْمُشْرِكِينَ","lil'mush'rikīna","for the polytheists","জন্যে মুশরিকদের"],["وَلَوْ","walaw","even though","এবং যদিও"],["كَانُوٓا۟","kānū","they be","তারা হয়"],["أُو۟لِى","ulī","near of kin","সম্পন্নরা"],["قُرْبَىٰ","qur'bā","near of kin","নৈকট্য"],["مِنۢ","min","after","থেকেও"],["بَعْدِ","ba‘di","after","পর"],["مَا","mā","[what]","যা"],["تَبَيَّنَ","tabayyana","has become clear","স্পষ্ট হয়েছে"],["لَهُمْ","lahum","to them","কাছে তাদের"],["أَنَّهُمْ","annahum","that they","যে তারা"],["أَصْحَـٰبُ","aṣḥābu","(are the) companions","অধিবাসী"],["ٱلْجَحِيمِ","l-jaḥīmi","(of) the Hellfire","জাহান্নামের"]],"t":"مَا كَانَ لِل<g>نَّ</>بِىِّ وَ<h>ٱ</>لَّذِينَ ءَامَ<o>نُوٓ</><s>ا۟</> <d>أَن يَ</>سْتَغْفِرُو<s>ا۟</> لِلْمُشْرِكِينَ وَلَوْ كَا<o>نُوٓ</><s>ا۟</> أُ<s>و۟</>لِى قُرْبَىٰ <i>مِنۢ بَ</>عْدِ مَا تَبَيَّنَ لَهُمْ أَ<g>نَّ</>هُمْ أَصْ<m>حَٰ</>بُ <h>ٱ</>لْجَ<p>حِي</>مِ"},{"n":114,"w":[["وَمَا","wamā","And not","এবং না"],["كَانَ","kāna","was","ছিলো"],["ٱسْتِغْفَارُ","is'tigh'fāru","(the) asking of forgiveness","ক্ষমা চাওয়া"],["إِبْرَٰهِيمَ","ib'rāhīma","(by) Ibrahim","ইবরাহীমের"],["لِأَبِيهِ","li-abīhi","for his father","জন্যে পিতার তার"],["إِلَّا","illā","except","এ ছাড়া যে"],["عَن","‘an","because","জন্যে"],["مَّوْعِدَةٍۢ","maw‘idatin","(of) a promise","প্রতিশ্রুতির"],["وَعَدَهَآ","wa‘adahā","he had promised it","যা সে প্রতিশ্রুতি দিয়েছিলো"],["إِيَّاهُ","iyyāhu","(to) him","কাছে তার"],["فَلَمَّا","falammā","But when","অতঃপর যখন"],["تَبَيَّنَ","tabayyana","it became clear","প্রকাশ হলো"],["لَهُۥٓ","lahu","to him","কাছে তার"],["أَنَّهُۥ","annahu","that he","যে সে"],["عَدُوٌّۭ","‘aduwwun","(was) an enemy","শত্রু"],["لِّلَّهِ","lillahi","to Allah","জন্যে আল্লাহর"],["تَبَرَّأَ","tabarra-a","he disassociated","সে সম্পর্ক ছিন্ন করলো"],["مِنْهُ ۚ","min'hu","from him","থেকে তার"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["إِبْرَٰهِيمَ","ib'rāhīma","Ibrahim","ইবরাহীম (ছিলো)"],["لَأَوَّٰهٌ","la-awwāhun","(was) compassionate","অবশ্যই কোমল হৃদয়ের"],["حَلِيمٌۭ","ḥalīmun","forbearing","সহনশীল (মানুষ)"]],"t":"وَمَا كَانَ <h>ٱ</>سْتِغْفَارُ إِ<q>بْ</><m>رَٰ</>هِيمَ لِأَبِيهِ إِلَّا <d>عَن مَّ</>وْعِدَ<d>ةٍۢ وَ</>عَدَ<o>هَآ</> إِيَّاهُ فَلَ<g>مَّ</>ا تَبَيَّنَ لَهُ<o>ۥٓ</> أَ<g>نَّ</>هُ<m>ۥ</> عَدُ<w>وٌّۭ لِّ</>لَّهِ تَبَرَّأَ مِنْهُ ۚ إِ<g>نَّ</> إِ<q>بْ</><m>رَٰ</>هِيمَ لَأَ<m>وَّٰ</>هٌ حَ<p>لِي</>مٌۭ"},{"n":115,"w":[["وَمَا","wamā","And not","এবং না"],["كَانَ","kāna","is","এমন হোন যে"],["ٱللَّهُ","l-lahu","(for) Allah","আল্লাহ"],["لِيُضِلَّ","liyuḍilla","that He lets go astray","যেন তিনি পথভ্রষ্ট করেন"],["قَوْمًۢا","qawman","a people","সম্প্রদায়কে"],["بَعْدَ","ba‘da","after","এরপরও"],["إِذْ","idh","[when]","যখন"],["هَدَىٰهُمْ","hadāhum","He has guided them","পথ প্রদর্শন করেছেন তাদেরকে"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["يُبَيِّنَ","yubayyina","He makes clear","স্পষ্ট বলে দেন"],["لَهُم","lahum","to them","কাছে তাদের"],["مَّا","mā","what","কি (থেকে)"],["يَتَّقُونَ ۚ","yattaqūna","they should fear","তারা বিরত থাকবে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["بِكُلِّ","bikulli","(of) every","সম্পর্কে সব"],["شَىْءٍ","shayin","thing","কিছু"],["عَلِيمٌ","‘alīmun","(is) All-Knower","খুব অবহিত"]],"t":"وَمَا كَانَ <h>ٱ</>للَّهُ لِيُضِلَّ قَوْ<i>مًۢا بَ</>عْدَ إِذْ هَدَ<m>ىٰ</>هُمْ حَتَّىٰ يُبَيِّنَ لَ<y>هُم مَّ</>ا يَتَّقُونَ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ بِكُلِّ شَىْءٍ عَ<p>لِي</>مٌ"},{"n":116,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ (এমন সত্ত্বা) যে"],["لَهُۥ","lahu","to Him (belongs)","জন্যে তাঁরই"],["مُلْكُ","mul'ku","the dominion","সার্বভৌমত্ব"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশসমূহের"],["وَٱلْأَرْضِ ۖ","wal-arḍi","and the earth","ও পৃথিবীর"],["يُحْىِۦ","yuḥ'yī","He gives life","তিনি জীবিত করেন"],["وَيُمِيتُ ۚ","wayumītu","and He causes death","এবং তিনি মৃত্যু ঘটান"],["وَمَا","wamā","And not","এবং নেই"],["لَكُم","lakum","for you","জন্যে তোমাদের"],["مِّن","min","besides Allah","দিয়ে"],["دُونِ","dūni","besides Allah","ছেড়ে"],["ٱللَّهِ","l-lahi","besides Allah","আল্লাহ"],["مِن","min","any","কোনো"],["وَلِىٍّۢ","waliyyin","protector","অভিভাবক"],["وَلَا","walā","and not","আর না"],["نَصِيرٍۢ","naṣīrin","any helper","সাহায্যকারী"]],"t":"إِ<g>نَّ</> <h>ٱ</>للَّهَ لَهُ<m>ۥ</> مُلْكُ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ ۖ يُحْ<m>ىِۦ</> وَيُمِيتُ ۚ وَمَا لَ<y>كُم مِّ</><k>ن دُ</>ونِ <h>ٱ</>للَّهِ <d>مِن وَلِىٍّۢ وَ</>لَا نَ<p>صِي</>رٍۢ"},{"n":117,"w":[["لَّقَد","laqad","Verily","নিশ্চয়ই"],["تَّابَ","tāba","Allah turned (in mercy)","ক্ষমা করলেন"],["ٱللَّهُ","l-lahu","Allah turned (in mercy)","আল্লাহ"],["عَلَى","‘alā","to","প্রতি"],["ٱلنَّبِىِّ","l-nabiyi","the Prophet","নাবীর"],["وَٱلْمُهَـٰجِرِينَ","wal-muhājirīna","and the emigrants","এবং মুহাজিরদের"],["وَٱلْأَنصَارِ","wal-anṣāri","and the helpers","ও আনসারদের (প্রতি)"],["ٱلَّذِينَ","alladhīna","[those] who","যারা"],["ٱتَّبَعُوهُ","ittaba‘ūhu","followed him","অনুসরণ করেছে তাকে"],["فِى","fī","in","মধ্যে"],["سَاعَةِ","sā‘ati","(the) hour","সময়ের"],["ٱلْعُسْرَةِ","l-‘us'rati","(of) difficulty","কঠিন"],["مِنۢ","min","after","থেকে"],["بَعْدِ","ba‘di","after","পর"],["مَا","mā","[what]","এর"],["كَادَ","kāda","had nearly","উপক্রম হয়েছিলো"],["يَزِيغُ","yazīghu","deviated","বাঁকা হওয়ার"],["قُلُوبُ","qulūbu","(the) hearts","অন্তরসমূহ"],["فَرِيقٍۢ","farīqin","(of) a party","এক দলের"],["مِّنْهُمْ","min'hum","of them","মধ্য থেকে তাদের"],["ثُمَّ","thumma","then","এরপর"],["تَابَ","tāba","He turned (in mercy)","ক্ষমা করলেন"],["عَلَيْهِمْ ۚ","‘alayhim","to them","প্রতি তাদের"],["إِنَّهُۥ","innahu","Indeed, He","নিশ্চয়ই তিনি"],["بِهِمْ","bihim","to them","উপর তাদের"],["رَءُوفٌۭ","raūfun","(is) Most Kind","স্নেহশীল"],["رَّحِيمٌۭ","raḥīmun","Most Merciful","পরম দয়ালু"]],"t":"لَّقَ<j>د</> تَّابَ <h>ٱ</>للَّهُ عَلَى <h>ٱ</><l>ل</><g>نَّ</>بِىِّ وَ<h>ٱ</>لْمُ<m>هَٰ</>جِرِينَ وَ<h>ٱ</>لْأَ<k>نصَ</>ارِ <h>ٱ</>لَّذِينَ <h>ٱ</>تَّبَعُوهُ فِى سَاعَةِ <h>ٱ</>لْعُسْرَةِ <i>مِنۢ بَ</>عْدِ مَا كَادَ يَزِيغُ قُلُوبُ فَرِي<d>قٍۢ مِّ</>نْهُمْ ثُ<g>مَّ</> تَابَ عَلَيْهِمْ ۚ إِ<g>نَّ</>هُ<m>ۥ</> بِهِمْ رَءُو<w>فٌۭ رَّ</><p>حِي</>مٌۭ"},{"n":118,"w":[["وَعَلَى","wa‘alā","And on","এবং উপর"],["ٱلثَّلَـٰثَةِ","l-thalāthati","the three","(ঐ) তিনজনের (ক্ষমা করলেন)"],["ٱلَّذِينَ","alladhīna","(of) those who","যারা"],["خُلِّفُوا۟","khullifū","were left behind","(তাদের সিদ্ধান্ত)স্হগিত রাখা হয়েছিলো"],["حَتَّىٰٓ","ḥattā","until","এমনকি"],["إِذَا","idhā","when","যখন"],["ضَاقَتْ","ḍāqat","(was) straitened","সংকুচিত হয়ে গেলো"],["عَلَيْهِمُ","‘alayhimu","for them","জন্যে তাদের"],["ٱلْأَرْضُ","l-arḍu","the earth","পৃথিবী"],["بِمَا","bimā","though","এ সত্ত্বেও যা"],["رَحُبَتْ","raḥubat","it was vast","বিস্তৃত"],["وَضَاقَتْ","waḍāqat","And (was) straitened","এবং সংকীর্ণ হলো"],["عَلَيْهِمْ","‘alayhim","for them","জন্যে তাদের"],["أَنفُسُهُمْ","anfusuhum","their own souls","জীবন তাদের"],["وَظَنُّوٓا۟","waẓannū","and they were certain","এবং তারা ভাবলো"],["أَن","an","that","যে"],["لَّا","lā","(there is) no","নেই"],["مَلْجَأَ","malja-a","refuge","কোনো আশ্রয় (বাঁচার)"],["مِنَ","mina","from","হতে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ (শাস্তি)"],["إِلَّآ","illā","except","এ ছাড়া"],["إِلَيْهِ","ilayhi","to Him","দিকে তাঁর(প্রত্যাবর্তন)"],["ثُمَّ","thumma","Then","এরপর"],["تَابَ","tāba","He turned (in mercy)","তিনি ক্ষমা করলেন"],["عَلَيْهِمْ","‘alayhim","to them","প্রতি তাদের"],["لِيَتُوبُوٓا۟ ۚ","liyatūbū","that they may repent","যেন তারা ফিরে আসে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["هُوَ","huwa","He","তিনিই"],["ٱلتَّوَّابُ","l-tawābu","(is) the Acceptor of repentance","বড় ক্ষমাশীল"],["ٱلرَّحِيمُ","l-raḥīmu","the Most Merciful","পরম দয়ালু"]],"t":"وَعَلَى <h>ٱ</><l>ل</>ثَّ<m>لَٰ</>ثَةِ <h>ٱ</>لَّذِينَ خُلِّفُو<s>ا۟</> حَتَّ<o>ىٰٓ</> إِذَا ضَاقَتْ عَلَيْهِمُ <h>ٱ</>لْأَرْضُ بِمَا رَحُبَتْ وَضَاقَتْ عَلَيْهِمْ أَ<k>نفُ</>سُهُمْ وَظَ<g>نُّ</><o>وٓ</><s>ا۟</> <w>أَن لَّ</>ا مَلْجَأَ مِنَ <h>ٱ</>للَّهِ إِ<o>لَّآ</> إِلَيْهِ ثُ<g>مَّ</> تَابَ عَلَيْهِمْ لِيَتُو<o>بُوٓ</><s>ا۟</> ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ هُوَ <h>ٱ</><l>ل</>تَّوَّابُ <h>ٱ</><l>ل</>رَّ<p>حِي</>مُ"},{"n":119,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you who believe","হে"],["ٱلَّذِينَ","alladhīna","O you who believe","যারা"],["ءَامَنُوا۟","āmanū","O you who believe","ঈমান এনেছো"],["ٱتَّقُوا۟","ittaqū","Fear","ভয় করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["وَكُونُوا۟","wakūnū","and be","ও তোমরা হও"],["مَعَ","ma‘a","with","(অন্তর্ভুক্ত)সাথে থাকো"],["ٱلصَّـٰدِقِينَ","l-ṣādiqīna","those who are truthful","সত্যবাদীদের"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> <h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</>للَّهَ وَكُونُو<s>ا۟</> مَعَ <h>ٱ</><l>ل</><m>صَّٰ</>دِ<p>قِي</>نَ"},{"n":120,"w":[["مَا","mā","Not","না"],["كَانَ","kāna","it was","শোভা পায়"],["لِأَهْلِ","li-ahli","(for) the people","জন্যে অধিবাসীদের"],["ٱلْمَدِينَةِ","l-madīnati","of the Madinah","মাদীনার"],["وَمَنْ","waman","and who","ও যারা"],["حَوْلَهُم","ḥawlahum","were around them","তাদের চার পাশে (থাকে)"],["مِّنَ","mina","of","মধ্য হতে"],["ٱلْأَعْرَابِ","l-a‘rābi","the bedouins","বেদুঈনদের"],["أَن","an","that","যে"],["يَتَخَلَّفُوا۟","yatakhallafū","they remain behind","তারা পিছনে রয়ে যাবে"],["عَن","‘an","after","(সহগামী হওয়া) থেকে"],["رَّسُولِ","rasūli","the Messenger","রাসূলের"],["ٱللَّهِ","l-lahi","of Allah","আল্লাহর"],["وَلَا","walā","and not","এবং না"],["يَرْغَبُوا۟","yarghabū","they prefer","তারা প্রিয় মনে করবে"],["بِأَنفُسِهِمْ","bi-anfusihim","their lives","ব্যাপারে জীবনের তাদের"],["عَن","‘an","to","চেয়ে"],["نَّفْسِهِۦ ۚ","nafsihi","his life","প্রাণের তার"],["ذَٰلِكَ","dhālika","That is","এটা"],["بِأَنَّهُمْ","bi-annahum","because [they]","এই জন্যে যে তাদের"],["لَا","lā","(does) not","না"],["يُصِيبُهُمْ","yuṣībuhum","afflict them","তাদের কাছে পৌঁছে"],["ظَمَأٌۭ","ẓama-on","thirst","(এমন)তৃষ্ণা"],["وَلَا","walā","and not","ও না"],["نَصَبٌۭ","naṣabun","fatigue","(এমন)ক্লান্তি"],["وَلَا","walā","and not","এবং না"],["مَخْمَصَةٌۭ","makhmaṣatun","hunger","(এমন) ক্ষুধা"],["فِى","fī","in","মধ্যে"],["سَبِيلِ","sabīli","(the) way","পথের"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَلَا","walā","and not","এবং না"],["يَطَـُٔونَ","yaṭaūna","they step","পদক্ষেপ নেয়"],["مَوْطِئًۭا","mawṭi-an","any step","(এমন) পদক্ষেপ"],["يَغِيظُ","yaghīẓu","that angers","(যা) রাগান্বিত করে"],["ٱلْكُفَّارَ","l-kufāra","the disbelievers","কাফেরদেরকে"],["وَلَا","walā","and not","এবং না"],["يَنَالُونَ","yanālūna","they inflict","তারা পায়"],["مِنْ","min","on","কোনো"],["عَدُوٍّۢ","‘aduwwin","an enemy","শত্রুর"],["نَّيْلًا","naylan","an infliction","কোনো প্রাপ্তি"],["إِلَّا","illā","except","এ ছাড়া যে"],["كُتِبَ","kutiba","is recorded","লেখা হয়"],["لَهُم","lahum","for them","জন্যে তাদের"],["بِهِۦ","bihi","in it","বিনিময়ে এর"],["عَمَلٌۭ","‘amalun","(as) a deed","কাজ"],["صَـٰلِحٌ ۚ","ṣāliḥun","righteous","ভালো"],["إِنَّ","inna","Indeed","লিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَا","lā","(does) not","না"],["يُضِيعُ","yuḍī‘u","allow to be lost","নষ্ট করেন"],["أَجْرَ","ajra","the reward","প্রতিফল"],["ٱلْمُحْسِنِينَ","l-muḥ'sinīna","(of) the good-doers","সৎকর্মশীলদের"]],"t":"مَا كَانَ لِأَهْلِ <h>ٱ</>لْمَدِينَةِ وَمَنْ حَوْلَ<y>هُم مِّ</>نَ <h>ٱ</>لْأَعْرَابِ <d>أَن يَ</>تَخَلَّفُو<s>ا۟</> <w>عَن رَّ</>سُولِ <h>ٱ</>للَّهِ وَلَا يَرْغَبُو<s>ا۟</> بِأَ<k>نفُ</>سِهِمْ <d>عَن نَّ</>فْسِ<m>هِۦ</> ۚ <m>ذَٰ</>لِكَ بِأَ<g>نَّ</>هُمْ لَا يُصِيبُهُمْ ظَمَ<d>أٌۭ وَ</>لَا نَصَ<d>بٌۭ وَ</>لَا مَخْمَصَ<k>ةٌۭ فِ</>ى سَبِيلِ <h>ٱ</>للَّهِ وَلَا يَطَـُٔونَ مَوْطِ<d>ئًۭا يَ</>غِيظُ <h>ٱ</>لْكُفَّارَ وَلَا يَنَالُونَ مِنْ عَدُ<d>وٍّۢ نَّ</>يْلًا إِلَّا كُتِبَ لَ<f>هُم بِ</><m>هِۦ</> عَمَ<k>لٌۭ صَٰ</>لِحٌ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ لَا يُضِيعُ أَ<q>جْ</>رَ <h>ٱ</>لْمُحْسِ<p>نِي</>نَ"},{"n":121,"w":[["وَلَا","walā","And not","এবং না"],["يُنفِقُونَ","yunfiqūna","they spend","তারা ব্যয় করে"],["نَفَقَةًۭ","nafaqatan","any spending","(এমন) কোনো ব্যয়"],["صَغِيرَةًۭ","ṣaghīratan","small","ছোট"],["وَلَا","walā","and not","এবং না"],["كَبِيرَةًۭ","kabīratan","big","বড়"],["وَلَا","walā","and not","এবং না"],["يَقْطَعُونَ","yaqṭa‘ūna","they cross","তারা অতিক্রম করে"],["وَادِيًا","wādiyan","a valley","(এমন) উপত্যকা"],["إِلَّا","illā","but","এ ছাড়া যে"],["كُتِبَ","kutiba","is recorded","লেখা হয়"],["لَهُمْ","lahum","for them","জন্যে তাদের"],["لِيَجْزِيَهُمُ","liyajziyahumu","that Allah may reward them","যেন প্রতিফল দেন তাদেরকে"],["ٱللَّهُ","l-lahu","that Allah may reward them","আল্লাহ"],["أَحْسَنَ","aḥsana","the best","অতি উত্তম"],["مَا","mā","(of) what","যা"],["كَانُوا۟","kānū","they used (to)","তারা ছিলো"],["يَعْمَلُونَ","ya‘malūna","do","তারা কাজ করতে"]],"t":"وَلَا يُ<k>نفِ</>قُونَ نَفَقَ<k>ةًۭ صَ</>غِيرَ<d>ةًۭ وَ</>لَا كَبِيرَ<d>ةًۭ وَ</>لَا يَ<q>قْ</>طَعُونَ وَادِيًا إِلَّا كُتِبَ لَهُمْ لِيَ<q>جْ</>زِيَهُمُ <h>ٱ</>للَّهُ أَحْسَنَ مَا كَانُو<s>ا۟</> يَعْمَ<p>لُو</>نَ"},{"n":122,"w":[["۞ وَمَا","wamā","And not","এবং না"],["كَانَ","kāna","is","সঙ্গত (ছিলো)"],["ٱلْمُؤْمِنُونَ","l-mu'minūna","(for) the believers","মু'মিনদের (জন্যে যে)"],["لِيَنفِرُوا۟","liyanfirū","that they go forth","যেন তারা বের হবে"],["كَآفَّةًۭ ۚ","kāffatan","all together","সবাই (একযোগে)"],["فَلَوْلَا","falawlā","So if not","আর কেন না"],["نَفَرَ","nafara","go forth","বের হলো"],["مِن","min","from","হতে"],["كُلِّ","kulli","every","প্রত্যেক"],["فِرْقَةٍۢ","fir'qatin","group","দলের"],["مِّنْهُمْ","min'hum","among them","মধ্য থেকে তাদের"],["طَآئِفَةٌۭ","ṭāifatun","a party","একটি অংশ"],["لِّيَتَفَقَّهُوا۟","liyatafaqqahū","that they may obtain understanding","যেন তারা গভীর জ্ঞান অনুশীলন করতো"],["فِى","fī","in","ব্যাপারে"],["ٱلدِّينِ","l-dīni","the religion","দীনের"],["وَلِيُنذِرُوا۟","waliyundhirū","and that they may warn","এবং যেন তারা সতর্ক করে"],["قَوْمَهُمْ","qawmahum","their people","সম্প্রদায়কে তাদের"],["إِذَا","idhā","when","যখন"],["رَجَعُوٓا۟","raja‘ū","they return","তারা ফিরে যায়"],["إِلَيْهِمْ","ilayhim","to them","দিকে তাদের"],["لَعَلَّهُمْ","la‘allahum","so that they may","যাতে তারা(এভাবে)"],["يَحْذَرُونَ","yaḥdharūna","beware","(ইসলাম বিরোধী কাজ থেকে) সতর্ক থাকে"]],"t":"۞ وَمَا كَانَ <h>ٱ</>لْمُؤْمِنُونَ لِيَ<k>نفِ</>رُو<s>ا۟</> <n>كَآ</>فَّ<k>ةًۭ ۚ فَ</>لَوْلَا نَفَرَ مِ<k>ن كُ</>لِّ فِرْقَ<d>ةٍۢ مِّ</>نْهُمْ <o>طَآ</>ئِفَ<w>ةٌۭ لِّ</>يَتَفَقَّهُو<s>ا۟</> فِى <h>ٱ</><l>ل</>دِّينِ وَلِيُ<k>نذِ</>رُو<s>ا۟</> قَوْمَهُمْ إِذَا رَجَ<o>عُوٓ</><s>ا۟</> إِلَيْهِمْ لَعَلَّهُمْ يَحْذَ<p>رُو</>نَ"},{"n":123,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you who believe","হে"],["ٱلَّذِينَ","alladhīna","O you who believe","যারা"],["ءَامَنُوا۟","āmanū","O you who believe","ঈমান এনেছো"],["قَـٰتِلُوا۟","qātilū","Fight","তোমরা যুদ্ধ করো"],["ٱلَّذِينَ","alladhīna","those who","(তাদের বিরুদ্ধে) যারা"],["يَلُونَكُم","yalūnakum","(are) close to you","কাছাকাছি আছে তোমাদের"],["مِّنَ","mina","of","মধ্যে হতে"],["ٱلْكُفَّارِ","l-kufāri","the disbelievers","কাফেরদের"],["وَلْيَجِدُوا۟","walyajidū","and let them find","ও যেন তারা পায়"],["فِيكُمْ","fīkum","in you","মধ্যে তোমাদের"],["غِلْظَةًۭ ۚ","ghil'ẓatan","harshness","কঠোরতা"],["وَٱعْلَمُوٓا۟","wa-i‘'lamū","And know","এবং তোমরা জেনে রাখো"],["أَنَّ","anna","that","যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["مَعَ","ma‘a","(is) with","সাথে (আছেন)"],["ٱلْمُتَّقِينَ","l-mutaqīna","those who fear (Him)","মুত্তাকীদের"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> <m>قَٰ</>تِلُو<s>ا۟</> <h>ٱ</>لَّذِينَ يَلُونَ<y>كُم مِّ</>نَ <h>ٱ</>لْكُفَّارِ وَلْيَجِدُو<s>ا۟</> فِيكُمْ غِلْظَ<d>ةًۭ ۚ وَ</><h>ٱ</>عْلَ<o>مُوٓ</><s>ا۟</> أَ<g>نَّ</> <h>ٱ</>للَّهَ مَعَ <h>ٱ</>لْمُتَّ<p>قِي</>نَ"},{"n":124,"w":[["وَإِذَا","wa-idhā","And whenever","এবং যখন"],["مَآ","mā","And whenever","যা"],["أُنزِلَتْ","unzilat","is revealed","অবতীর্ণ করা হয়"],["سُورَةٌۭ","sūratun","a Surah","কোনো সূরাহ"],["فَمِنْهُم","famin'hum","among them","তখন মধ্যে তাদের"],["مَّن","man","(are some) who","কেউ কেউ"],["يَقُولُ","yaqūlu","say","বলে"],["أَيُّكُمْ","ayyukum","Which of you","\"মধ্যে কার তোমাদের"],["زَادَتْهُ","zādathu","(has) increased [it]","বৃদ্ধি করেছে তার"],["هَـٰذِهِۦٓ","hādhihi","(by) this","এটা (দিয়ে)"],["إِيمَـٰنًۭا ۚ","īmānan","(in) faith","ঈমান\""],["فَأَمَّا","fa-ammā","As for","অতঃপর আর বাস্তবিকই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["فَزَادَتْهُمْ","fazādathum","then it has increased them","তখন তা তাদের বৃদ্ধি করেছে"],["إِيمَـٰنًۭا","īmānan","(in) faith","ঈমান"],["وَهُمْ","wahum","and they","এবং তারা"],["يَسْتَبْشِرُونَ","yastabshirūna","rejoice","আনন্দিত হয়"]],"t":"وَإِذَا <o>مَآ</> أُ<k>نزِ</>لَتْ سُورَ<k>ةٌۭ فَ</>مِنْ<y>هُم مَّ</><d>ن يَ</>قُولُ أَيُّكُمْ زَادَتْهُ <m>هَٰ</>ذِ<o>هِۦٓ</> إِي<m>مَٰ</><k>نًۭا ۚ فَ</>أَ<g>مَّ</>ا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> فَزَادَتْهُمْ إِي<m>مَٰ</><d>نًۭا وَ</>هُمْ يَسْتَ<q>بْ</>شِ<p>رُو</>نَ"},{"n":125,"w":[["وَأَمَّا","wa-ammā","But as for","আর পক্ষান্তরে"],["ٱلَّذِينَ","alladhīna","those","যাদের"],["فِى","fī","in","মধ্যে (আছে)"],["قُلُوبِهِم","qulūbihim","their hearts","অন্তরসমূহে তাদের"],["مَّرَضٌۭ","maraḍun","(is) a disease","রোগ"],["فَزَادَتْهُمْ","fazādathum","(it) increases them","তখন তা তাদের বৃদ্ধি করেছে"],["رِجْسًا","rij'san","(in) evil","কলুষতার"],["إِلَىٰ","ilā","to","সাথে"],["رِجْسِهِمْ","rij'sihim","their evil","কলুষতা তাদের"],["وَمَاتُوا۟","wamātū","And they die","এবং তারা মারা গিয়েছে"],["وَهُمْ","wahum","while they","এ অবস্থায় যে তারা"],["كَـٰفِرُونَ","kāfirūna","(are) disbelievers","কাফের (থাকবে)"]],"t":"وَأَ<g>مَّ</>ا <h>ٱ</>لَّذِينَ فِى قُلُوبِ<y>هِم مَّ</>رَ<k>ضٌۭ فَ</>زَادَتْهُمْ رِ<q>جْ</>سًا إِلَىٰ رِ<q>جْ</>سِهِمْ وَمَاتُو<s>ا۟</> وَهُمْ <m>كَٰ</>فِ<p>رُو</>نَ"},{"n":126,"w":[["أَوَلَا","awalā","Do not","কি না"],["يَرَوْنَ","yarawna","they see","তারা দেখে"],["أَنَّهُمْ","annahum","that they","যে তারা"],["يُفْتَنُونَ","yuf'tanūna","are tried","পরীক্ষায় নিক্ষিপ্ত হয়"],["فِى","fī","[in]","মধ্যে"],["كُلِّ","kulli","every","প্রত্যেক"],["عَامٍۢ","‘āmin","year","বছরে"],["مَّرَّةً","marratan","once","একবার"],["أَوْ","aw","or","বা"],["مَرَّتَيْنِ","marratayni","twice","দু'বার"],["ثُمَّ","thumma","Yet","এরপরও"],["لَا","lā","not","না"],["يَتُوبُونَ","yatūbūna","they turn (in repentance)","তারা তওবা করে"],["وَلَا","walā","and not","আর না"],["هُمْ","hum","they","তারা"],["يَذَّكَّرُونَ","yadhakkarūna","pay heed","শিক্ষা নেয়"]],"t":"أَوَلَا يَرَوْنَ أَ<g>نَّ</>هُمْ يُفْتَنُونَ فِى كُلِّ عَا<d>مٍۢ مَّ</>رَّةً أَوْ مَرَّتَيْنِ ثُ<g>مَّ</> لَا يَتُوبُونَ وَلَا هُمْ يَذَّكَّ<p>رُو</>نَ"},{"n":127,"w":[["وَإِذَا","wa-idhā","And whenever","এবং যখন"],["مَآ","mā","And whenever","যা"],["أُنزِلَتْ","unzilat","is revealed","অবতীর্ণ হয়"],["سُورَةٌۭ","sūratun","a Surah","কোনো সূরাহ"],["نَّظَرَ","naẓara","look","দেখে"],["بَعْضُهُمْ","ba‘ḍuhum","some of them","একে তাদের"],["إِلَىٰ","ilā","to","দিকে"],["بَعْضٍ","ba‘ḍin","others","অন্যের"],["هَلْ","hal","Does","\"(তারা ইশারায় বলে) কি"],["يَرَىٰكُم","yarākum","see you","তোমাদের দেখছে"],["مِّنْ","min","any","কোনো"],["أَحَدٍۢ","aḥadin","one","একজন\""],["ثُمَّ","thumma","Then","এরপর"],["ٱنصَرَفُوا۟ ۚ","inṣarafū","they turn away","তারা সরে পড়ে"],["صَرَفَ","ṣarafa","Allah has turned away","ফিরিয়ে দিয়েছেন"],["ٱللَّهُ","l-lahu","Allah has turned away","আল্লাহ"],["قُلُوبَهُم","qulūbahum","their hearts","অন্তরগুলোকে তাদের"],["بِأَنَّهُمْ","bi-annahum","because they","কারণ তারা"],["قَوْمٌۭ","qawmun","(are) a people","(এমন)সম্প্রদায়"],["لَّا","lā","not","(যে) না"],["يَفْقَهُونَ","yafqahūna","they understand","তারা বুঝে"]],"t":"وَإِذَا <o>مَآ</> أُ<k>نزِ</>لَتْ سُورَ<d>ةٌۭ نَّ</>ظَرَ بَعْضُهُمْ إِلَىٰ بَعْضٍ هَلْ يَرَ<m>ىٰ</><y>كُم مِّ</>نْ أَحَ<k>دٍۢ ثُ</><g>مَّ</> <h>ٱ</><k>نصَ</>رَفُو<s>ا۟ ۚ</> صَرَفَ <h>ٱ</>للَّهُ قُلُوبَ<f>هُم بِ</>أَ<g>نَّ</>هُمْ قَوْ<w>مٌۭ لَّ</>ا يَفْقَ<p>هُو</>نَ"},{"n":128,"w":[["لَقَدْ","laqad","Certainly","নিশ্চয়ই"],["جَآءَكُمْ","jāakum","(has) come to you","তোমাদের কাছে এসেছে তোমাদের"],["رَسُولٌۭ","rasūlun","a Messenger","একজন রাসূল"],["مِّنْ","min","from","মধ্য হতে"],["أَنفُسِكُمْ","anfusikum","yourselves","নিজেদের তোমাদের"],["عَزِيزٌ","‘azīzun","Grievous","কষ্টদায়ক"],["عَلَيْهِ","‘alayhi","to him","কাছে তার"],["مَا","mā","(is) what","যা"],["عَنِتُّمْ","‘anittum","you suffer","তোমরা ক্ষতিগ্রস্ত হও"],["حَرِيصٌ","ḥarīṣun","(he is) concerned","সে কল্যাণকামী"],["عَلَيْكُم","‘alaykum","over you","জন্যে তোমাদের"],["بِٱلْمُؤْمِنِينَ","bil-mu'minīna","to the believers","সাথে মু'মিনদের"],["رَءُوفٌۭ","raūfun","(he is) kind","স্নেহশীল"],["رَّحِيمٌۭ","raḥīmun","(and) merciful","পরম দয়ালু"]],"t":"لَقَ<q>دْ</> <o>جَآ</>ءَكُمْ رَسُو<d>لٌۭ مِّ</>نْ أَ<k>نفُ</>سِكُمْ عَزِيزٌ عَلَيْهِ مَا عَنِتُّمْ حَرِيصٌ عَلَيْ<f>كُم بِ</><h>ٱ</>لْمُؤْمِنِينَ رَءُو<w>فٌۭ رَّ</><p>حِي</>مٌۭ"},{"n":129,"w":[["فَإِن","fa-in","But if","অতঃপর যদি"],["تَوَلَّوْا۟","tawallaw","they turn away","তারা ফিরে যায়"],["فَقُلْ","faqul","then say","তবে বলো"],["حَسْبِىَ","ḥasbiya","Sufficient for me","\"আমরা জন্যে যথেষ্ট"],["ٱللَّهُ","l-lahu","(is) Allah","আল্লাহই"],["لَآ","lā","(There is) no","নেই"],["إِلَـٰهَ","ilāha","god","কোনো ইলাহ"],["إِلَّا","illā","except","ছাড়া"],["هُوَ ۖ","huwa","Him","তিনি"],["عَلَيْهِ","‘alayhi","On Him","উপর তাঁরই"],["تَوَكَّلْتُ ۖ","tawakkaltu","I put my trust","আমি নির্ভর করেছি"],["وَهُوَ","wahuwa","And He","এবং তিনিই"],["رَبُّ","rabbu","(is the) Lord","রব/অধিপতি"],["ٱلْعَرْشِ","l-‘arshi","(of) the Throne","আরশের"],["ٱلْعَظِيمِ","l-‘aẓīmi","the Great","মহান\""]],"t":"فَإِ<k>ن تَ</>وَلَّوْ<s>ا۟</> فَقُلْ حَسْبِىَ <h>ٱ</>للَّهُ <o>لَآ</> إِ<m>لَٰ</>هَ إِلَّا هُوَ ۖ عَلَيْهِ تَوَكَّلْتُ ۖ وَهُوَ رَبُّ <h>ٱ</>لْعَرْشِ <h>ٱ</>لْعَ<p>ظِي</>مِ"}]}