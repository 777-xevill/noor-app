{"n":9,"a":[{"n":1,"w":[["بَرَآءَةٌۭ","barāatun","Freedom from obligations","সম্পর্কচ্ছেদ (ঘোষণা)"],["مِّنَ","mina","from","পক্ষ হতে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["وَرَسُولِهِۦٓ","warasūlihi","and His Messenger","ও রাসূলের তাঁর"],["إِلَى","ilā","to","প্রতি"],["ٱلَّذِينَ","alladhīna","those (with) whom","তাদের (যাদের সাথে)"],["عَـٰهَدتُّم","‘āhadttum","you made a covenant","চুক্তি করেছিলে তোমরা"],["مِّنَ","mina","from","মধ্য হতে"],["ٱلْمُشْرِكِينَ","l-mush'rikīna","the polytheists","মুশরিকদের"]],"t":"بَ<o>رَآ</>ءَ<d>ةٌۭ مِّ</>نَ <h>ٱ</>للَّهِ وَرَسُولِ<o>هِۦٓ</> إِلَى <h>ٱ</>لَّذِينَ <m>عَٰ</>هَ<j>د</><y>تُّم مِّ</>نَ <h>ٱ</>لْمُشْرِ<p>كِي</>نَ"},{"n":2,"w":[["فَسِيحُوا۟","fasīḥū","So move about","অতএব তোমরা চলাচল করো"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the land","দেশের"],["أَرْبَعَةَ","arba‘ata","(during) four","চার"],["أَشْهُرٍۢ","ashhurin","months","মাস (পর্যন্ত)"],["وَٱعْلَمُوٓا۟","wa-i‘'lamū","but know","ও তোমরা জেনে রাখো"],["أَنَّكُمْ","annakum","that you","যে তোমরা"],["غَيْرُ","ghayru","(can) not","নও"],["مُعْجِزِى","mu‘'jizī","escape","অক্ষমকারী"],["ٱللَّهِ ۙ","l-lahi","Allah","আল্লাহকে"],["وَأَنَّ","wa-anna","and that","ও নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["مُخْزِى","mukh'zī","(is) the One Who (will) disgrace","লাঞ্ছনাকারী"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","the disbelievers","কাফেরদেরকে"]],"t":"فَسِيحُو<s>ا۟</> فِى <h>ٱ</>لْأَرْضِ أَرْبَعَةَ أَشْهُ<d>رٍۢ وَ</><h>ٱ</>عْلَ<o>مُوٓ</><s>ا۟</> أَ<g>نَّ</>كُمْ غَيْرُ مُعْجِزِى <h>ٱ</>للَّهِ ۙ وَأَ<g>نَّ</> <h>ٱ</>للَّهَ مُخْزِى <h>ٱ</>لْ<m>كَٰ</>فِ<p>رِي</>نَ"},{"n":3,"w":[["وَأَذَٰنٌۭ","wa-adhānun","And an announcement","এবং সাধারণ ঘোষণা"],["مِّنَ","mina","from Allah","পক্ষ হতে"],["ٱللَّهِ","l-lahi","from Allah","আল্লাহর"],["وَرَسُولِهِۦٓ","warasūlihi","and His Messenger","এবং রাসূলের তাঁর"],["إِلَى","ilā","to","প্রতি"],["ٱلنَّاسِ","l-nāsi","the people","জনসাধারণের"],["يَوْمَ","yawma","(on the) day","দিনে"],["ٱلْحَجِّ","l-ḥaji","(of) the greater Pilgrimage","হজ্জের"],["ٱلْأَكْبَرِ","l-akbari","(of) the greater Pilgrimage","মহান"],["أَنَّ","anna","that","যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["بَرِىٓءٌۭ","barīon","(is) free from obligations","দায়মুক্ত"],["مِّنَ","mina","[of]","থেকে"],["ٱلْمُشْرِكِينَ ۙ","l-mush'rikīna","(to) the polytheists","মুশরিকদের"],["وَرَسُولُهُۥ ۚ","warasūluhu","and (so is) His Messenger","এবং রাসূলও তাঁর (দ্বায়িত্বমুক্ত)"],["فَإِن","fa-in","So if","অতএব যদি"],["تُبْتُمْ","tub'tum","you repent","তোমরা তাওবা করো"],["فَهُوَ","fahuwa","then, it is","তবে তা"],["خَيْرٌۭ","khayrun","best","উত্তম"],["لَّكُمْ ۖ","lakum","for you","জন্যে তোমাদের"],["وَإِن","wa-in","But if","আর যদি"],["تَوَلَّيْتُمْ","tawallaytum","you turn away","ফিরে যাও তোমরা"],["فَٱعْلَمُوٓا۟","fa-i‘'lamū","then know","তবে তোমরা জেনে রাখো"],["أَنَّكُمْ","annakum","that you","যে তোমরা"],["غَيْرُ","ghayru","(can) not","নও"],["مُعْجِزِى","mu‘'jizī","escape","অক্ষমকারী"],["ٱللَّهِ ۗ","l-lahi","Allah","আল্লাহকে"],["وَبَشِّرِ","wabashiri","And give glad tidings","এবং সুসংবাদ দাও"],["ٱلَّذِينَ","alladhīna","(to) those who","(তাদেরকে) যারা"],["كَفَرُوا۟","kafarū","disbelieve","অস্বীকার করেছে"],["بِعَذَابٍ","bi‘adhābin","of a punishment","সম্পর্কে শাস্তির"],["أَلِيمٍ","alīmin","painful","নিদারুণ"]],"t":"وَأَ<m>ذَٰ</><d>نٌۭ مِّ</>نَ <h>ٱ</>للَّهِ وَرَسُولِ<o>هِۦٓ</> إِلَى <h>ٱ</><l>ل</><g>نَّ</>اسِ يَوْمَ <h>ٱ</>لْحَجِّ <h>ٱ</>لْأَكْبَرِ أَ<g>نَّ</> <h>ٱ</>للَّهَ بَ<o>رِىٓ</><d>ءٌۭ مِّ</>نَ <h>ٱ</>لْمُشْرِكِينَ ۙ وَرَسُولُهُ<m>ۥ</> ۚ فَإِ<k>ن تُ</><q>بْ</>تُمْ فَهُوَ خَيْ<w>رٌۭ لَّ</>كُمْ ۖ وَإِ<k>ن تَ</>وَلَّيْتُمْ فَ<h>ٱ</>عْلَ<o>مُوٓ</><s>ا۟</> أَ<g>نَّ</>كُمْ غَيْرُ مُعْجِزِى <h>ٱ</>للَّهِ ۗ وَبَشِّرِ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> بِعَذَابٍ أَ<p>لِي</>مٍ"},{"n":4,"w":[["إِلَّا","illā","Except","তবে"],["ٱلَّذِينَ","alladhīna","those (with) whom","যাদের (সাথে)"],["عَـٰهَدتُّم","‘āhadttum","you have a covenant","চুক্তি করেছো তোমরা"],["مِّنَ","mina","among","মধ্য হতে"],["ٱلْمُشْرِكِينَ","l-mush'rikīna","the polytheists","মুশরিকদের"],["ثُمَّ","thumma","then","এরপর"],["لَمْ","lam","not","নি"],["يَنقُصُوكُمْ","yanquṣūkum","they have failed you","তোমাদের সাথে ত্রুটি করে(চুক্তি রক্ষায়)"],["شَيْـًۭٔا","shayan","(in any) thing","কিছুমাত্র"],["وَلَمْ","walam","and not","এবং নি"],["يُظَـٰهِرُوا۟","yuẓāhirū","they have supported","তারা সাহায্য করে"],["عَلَيْكُمْ","‘alaykum","against you","বিরুদ্ধে তোমাদের"],["أَحَدًۭا","aḥadan","anyone","কাউকে"],["فَأَتِمُّوٓا۟","fa-atimmū","so fulfil","তাহ'লে তোমরা পূর্ণ করো"],["إِلَيْهِمْ","ilayhim","to them","সাথে তাদের"],["عَهْدَهُمْ","‘ahdahum","their treaty","চুক্তি তাদের"],["إِلَىٰ","ilā","till","পর্যন্ত"],["مُدَّتِهِمْ ۚ","muddatihim","their term","মেয়াদ তাদের"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يُحِبُّ","yuḥibbu","loves","ভালোবাসেন"],["ٱلْمُتَّقِينَ","l-mutaqīna","the righteous","মুত্তাকীদেরকে"]],"t":"إِلَّا <h>ٱ</>لَّذِينَ <m>عَٰ</>هَ<j>د</><y>تُّم مِّ</>نَ <h>ٱ</>لْمُشْرِكِينَ ثُ<g>مَّ</> لَمْ يَ<k>نقُ</>صُوكُمْ شَ<d>يْـًۭٔا وَ</>لَمْ يُ<m>ظَٰ</>هِرُو<s>ا۟</> عَلَيْكُمْ أَحَ<k>دًۭا فَ</>أَتِ<g>مُّ</><o>وٓ</><s>ا۟</> إِلَيْهِمْ عَهْدَهُمْ إِلَىٰ مُدَّتِهِمْ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ يُحِبُّ <h>ٱ</>لْمُتَّ<p>قِي</>نَ"},{"n":5,"w":[["فَإِذَا","fa-idhā","Then when","অতঃপর যখন"],["ٱنسَلَخَ","insalakha","have passed","অতিবাহিত হয়"],["ٱلْأَشْهُرُ","l-ashhuru","the sacred months","মাসসমূহ"],["ٱلْحُرُمُ","l-ḥurumu","the sacred months","নিষিদ্ধ"],["فَٱقْتُلُوا۟","fa-uq'tulū","then kill","তখন তোমরা হত্যা করো"],["ٱلْمُشْرِكِينَ","l-mush'rikīna","the polytheists","মুশরিকদেরকে"],["حَيْثُ","ḥaythu","wherever","যেখানে"],["وَجَدتُّمُوهُمْ","wajadttumūhum","you find them","তোমরা পাও তাদেরকে"],["وَخُذُوهُمْ","wakhudhūhum","and seize them","ও তোমরা ধরো তাদেরকে"],["وَٱحْصُرُوهُمْ","wa-uḥ'ṣurūhum","and besiege them","ও তোমরা অবরোধ করো তাদেরকে"],["وَٱقْعُدُوا۟","wa-uq'‘udū","and sit (in wait)","এবং তোমরা বসো"],["لَهُمْ","lahum","for them","জন্যে তাদের"],["كُلَّ","kulla","(at) every","প্রত্যেক"],["مَرْصَدٍۢ ۚ","marṣadin","place of ambush","ঘাঁটিতে"],["فَإِن","fa-in","But if","অতঃপর যদি"],["تَابُوا۟","tābū","they repent","তারা তওবা করে"],["وَأَقَامُوا۟","wa-aqāmū","and establish","ও তারা প্রতিষ্ঠা করে"],["ٱلصَّلَوٰةَ","l-ṣalata","the prayer","সালাত"],["وَءَاتَوُا۟","waātawū","and give","ও তারা দেয়"],["ٱلزَّكَوٰةَ","l-zakata","the zakah","যাকাত"],["فَخَلُّوا۟","fakhallū","then leave","তবে তোমরা ছেড়ে দাও"],["سَبِيلَهُمْ ۚ","sabīlahum","their way","রাস্তা তাদের"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["غَفُورٌۭ","ghafūrun","(is) Oft-Forgiving","ক্ষমাশীল"],["رَّحِيمٌۭ","raḥīmun","Most Merciful","পরম দয়ালু"]],"t":"فَإِذَا <h>ٱ</><k>نسَ</>لَخَ <h>ٱ</>لْأَشْهُرُ <h>ٱ</>لْحُرُمُ فَ<h>ٱ</><q>قْ</>تُلُو<s>ا۟</> <h>ٱ</>لْمُشْرِكِينَ حَيْثُ وَجَ<j>د</>تُّمُوهُمْ وَخُذُوهُمْ وَ<h>ٱ</>حْصُرُوهُمْ وَ<h>ٱ</><q>قْ</>عُدُو<s>ا۟</> لَهُمْ كُلَّ مَرْصَ<k>دٍۢ ۚ فَإِن تَ</>ابُو<s>ا۟</> وَأَقَامُو<s>ا۟</> <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةَ وَءَاتَوُ<s>ا۟</> <h>ٱ</><l>ل</>زَّكَ<s>وٰ</>ةَ فَخَلُّو<s>ا۟</> سَبِيلَهُمْ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ غَفُو<w>رٌۭ رَّ</><p>حِي</>مٌۭ"},{"n":6,"w":[["وَإِنْ","wa-in","And if","এবং যদি"],["أَحَدٌۭ","aḥadun","anyone","কেউ"],["مِّنَ","mina","of","মধ্য হতে"],["ٱلْمُشْرِكِينَ","l-mush'rikīna","the polytheists","মুশরিকদের"],["ٱسْتَجَارَكَ","is'tajāraka","seek your protection","তোমার আশ্রয় চায়"],["فَأَجِرْهُ","fa-ajir'hu","then grant him protection","তবে তাকে আশ্রয় দাও"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["يَسْمَعَ","yasma‘a","he hears","সে শুনে"],["كَلَـٰمَ","kalāma","(the) Words of Allah","বাণী"],["ٱللَّهِ","l-lahi","(the) Words of Allah","আল্লাহর"],["ثُمَّ","thumma","Then","এরপর"],["أَبْلِغْهُ","abligh'hu","escort him","তাকে পৌঁছাও"],["مَأْمَنَهُۥ ۚ","mamanahu","(to) his place of safety","নিরাপদ স্থানে তার"],["ذَٰلِكَ","dhālika","That","এটা"],["بِأَنَّهُمْ","bi-annahum","(is) because they","এজন্যে যে তারা"],["قَوْمٌۭ","qawmun","(are) a people","(এমন)সম্প্রদায়"],["لَّا","lā","(who) do not know","না"],["يَعْلَمُونَ","ya‘lamūna","(who) do not know","তারা জানে"]],"t":"وَإِنْ أَحَ<d>دٌۭ مِّ</>نَ <h>ٱ</>لْمُشْرِكِينَ <h>ٱ</>سْتَجَارَكَ فَأَجِرْهُ حَتَّىٰ يَسْمَعَ كَ<m>لَٰ</>مَ <h>ٱ</>للَّهِ ثُ<g>مَّ</> أَ<q>بْ</>لِغْهُ مَأْمَنَهُ<m>ۥ</> ۚ <m>ذَٰ</>لِكَ بِأَ<g>نَّ</>هُمْ قَوْ<w>مٌۭ لَّ</>ا يَعْلَ<p>مُو</>نَ"},{"n":7,"w":[["كَيْفَ","kayfa","How","কেমন করে"],["يَكُونُ","yakūnu","can (there) be","(বহাল) থাকবে"],["لِلْمُشْرِكِينَ","lil'mush'rikīna","for the polytheists","জন্যে মুশরিকদের"],["عَهْدٌ","‘ahdun","a covenant","চুক্তি"],["عِندَ","‘inda","with","কাছে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["وَعِندَ","wa‘inda","and with","ও কাছে"],["رَسُولِهِۦٓ","rasūlihi","His Messenger","রাসূলের তাঁর"],["إِلَّا","illā","except","এ ছাড়া"],["ٱلَّذِينَ","alladhīna","those (with) whom","যাদের (সাথে)"],["عَـٰهَدتُّمْ","‘āhadttum","you made a covenant","তোমরা চুক্তি করেছো"],["عِندَ","‘inda","near","কাছে"],["ٱلْمَسْجِدِ","l-masjidi","Al-Masjid","মাসজিদে"],["ٱلْحَرَامِ ۖ","l-ḥarāmi","Al-Haraam","হারামের"],["فَمَا","famā","So long as","তাই যতক্ষণ"],["ٱسْتَقَـٰمُوا۟","is'taqāmū","they are upright","তারা স্হির থাকে"],["لَكُمْ","lakum","to you","জন্যে তোমাদের"],["فَٱسْتَقِيمُوا۟","fa-is'taqīmū","then you be upright","অতঃপর তোমরাও স্হির থাকো"],["لَهُمْ ۚ","lahum","to them","জন্যে তাদের"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يُحِبُّ","yuḥibbu","loves","ভালোবাসেন"],["ٱلْمُتَّقِينَ","l-mutaqīna","the righteous","মুত্তাকীদের"]],"t":"كَيْفَ يَكُونُ لِلْمُشْرِكِينَ عَهْدٌ عِ<k>ندَ</> <h>ٱ</>للَّهِ وَعِ<k>ندَ</> رَسُولِ<o>هِۦٓ</> إِلَّا <h>ٱ</>لَّذِينَ <m>عَٰ</>هَ<j>د</>تُّمْ عِ<k>ندَ</> <h>ٱ</>لْمَسْجِدِ <h>ٱ</>لْحَرَامِ ۖ فَمَا <h>ٱ</>سْتَ<m>قَٰ</>مُو<s>ا۟</> لَكُمْ فَ<h>ٱ</>سْتَقِيمُو<s>ا۟</> لَهُمْ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ يُحِبُّ <h>ٱ</>لْمُتَّ<p>قِي</>نَ"},{"n":8,"w":[["كَيْفَ","kayfa","How","কেমন করে (চুক্তি বহাল) থাকবে"],["وَإِن","wa-in","while, if","অথচ যদি"],["يَظْهَرُوا۟","yaẓharū","they gain dominance","তারা বিজয়ী হয়"],["عَلَيْكُمْ","‘alaykum","over you","উপর তোমাদের"],["لَا","lā","they do not regard (the ties)","না"],["يَرْقُبُوا۟","yarqubū","they do not regard (the ties)","তারা সম্মান করে"],["فِيكُمْ","fīkum","with you","ব্যাপারে তোমাদের"],["إِلًّۭا","illan","(of) kinship","আত্মীয়তার"],["وَلَا","walā","and not","আর না"],["ذِمَّةًۭ ۚ","dhimmatan","covenant of protection","প্রতিশ্রুতির (দায়িত্ব)"],["يُرْضُونَكُم","yur'ḍūnakum","They satisfy you","খুশী করে তোমাদের"],["بِأَفْوَٰهِهِمْ","bi-afwāhihim","with their mouths","দিয়ে মুখের কথা তাদের"],["وَتَأْبَىٰ","watabā","but refuse","ও অস্বীকার করে"],["قُلُوبُهُمْ","qulūbuhum","their hearts","অন্তর তাদের"],["وَأَكْثَرُهُمْ","wa-aktharuhum","and most of them","এবং অধিকাংশই তাদের"],["فَـٰسِقُونَ","fāsiqūna","(are) defiantly disobedient","সত্যত্যাগী"]],"t":"كَيْفَ وَ<d>إِن يَ</>ظْهَرُو<s>ا۟</> عَلَيْكُمْ لَا يَرْقُبُو<s>ا۟</> فِيكُمْ إِ<d>لًّۭا وَ</>لَا ذِ<g>مَّ</><d>ةًۭ ۚ يُ</>رْضُونَ<f>كُم بِ</>أَفْ<m>وَٰ</>هِهِمْ وَتَأْبَىٰ قُلُوبُهُمْ وَأَكْثَرُهُمْ <m>فَٰ</>سِ<p>قُو</>نَ"},{"n":9,"w":[["ٱشْتَرَوْا۟","ish'taraw","They exchange","তারা কিনেছে"],["بِـَٔايَـٰتِ","biāyāti","[with] the Verses of Allah","বিনিময়ে আয়াতের"],["ٱللَّهِ","l-lahi","[with] the Verses of Allah","আল্লাহর"],["ثَمَنًۭا","thamanan","(for) a little price","মূল্য"],["قَلِيلًۭا","qalīlan","(for) a little price","সামান্য"],["فَصَدُّوا۟","faṣaddū","and they hinder (people)","অতঃপর তারা বাধা দেয় (লোকদেরকে)"],["عَن","‘an","from","হতে"],["سَبِيلِهِۦٓ ۚ","sabīlihi","His way","তাঁর পথ"],["إِنَّهُمْ","innahum","Indeed","নিশ্চয়ই তারা"],["سَآءَ","sāa","evil","অতি নিকৃষ্ট"],["مَا","mā","(is) what","যা"],["كَانُوا۟","kānū","they used to","তারা ছিলো"],["يَعْمَلُونَ","ya‘malūna","do","তারা কাজ করে আসছে"]],"t":"ٱشْتَرَوْ<s>ا۟</> بِـَٔا<m>يَٰ</>تِ <h>ٱ</>للَّهِ ثَمَ<k>نًۭا قَ</>لِيلًۭ<k>ا فَ</>صَدُّو<s>ا۟</> عَ<k>ن سَ</>بِيلِ<o>هِۦٓ ۚ</> إِ<g>نَّ</>هُمْ <o>سَآ</>ءَ مَا كَانُو<s>ا۟</> يَعْمَ<p>لُو</>نَ"},{"n":10,"w":[["لَا","lā","Not","না"],["يَرْقُبُونَ","yarqubūna","they respect (the ties)","তারা সম্মান করে"],["فِى","fī","towards","ব্যাপারে"],["مُؤْمِنٍ","mu'minin","a believer","মু'মিনের"],["إِلًّۭا","illan","(of) kinship","আত্মীয়তার"],["وَلَا","walā","and not","আর না"],["ذِمَّةًۭ ۚ","dhimmatan","covenant of protection","প্রতিশ্রুতির (দায়িত্ব)"],["وَأُو۟لَـٰٓئِكَ","wa-ulāika","And those","এবং ঐসব লোক"],["هُمُ","humu","[they]","তারা"],["ٱلْمُعْتَدُونَ","l-mu‘'tadūna","(are) the transgressors","সীমালঙ্ঘনকারী"]],"t":"لَا يَرْقُبُونَ فِى مُؤْمِنٍ إِ<d>لًّۭا وَ</>لَا ذِ<g>مَّ</><d>ةًۭ ۚ وَ</>أُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</>لْمُعْتَ<p>دُو</>نَ"},{"n":11,"w":[["فَإِن","fa-in","But if","অতঃপর যদি"],["تَابُوا۟","tābū","they repent","তারা তওবা করে"],["وَأَقَامُوا۟","wa-aqāmū","and establish","ও প্রতিষ্ঠা করে"],["ٱلصَّلَوٰةَ","l-ṣalata","the prayer","সালাত"],["وَءَاتَوُا۟","waātawū","and give","ও আদায় করে"],["ٱلزَّكَوٰةَ","l-zakata","the zakah","যাকাত"],["فَإِخْوَٰنُكُمْ","fa-ikh'wānukum","then (they are) your brothers","তবে ভাই তোমাদের"],["فِى","fī","in","ভিত্তিতে"],["ٱلدِّينِ ۗ","l-dīni","[the] religion","দীনের"],["وَنُفَصِّلُ","wanufaṣṣilu","And We explain in detail","এবং বিস্তারিত বর্ণনা করছি আমরা"],["ٱلْـَٔايَـٰتِ","l-āyāti","the Verses","বিধানাবলী"],["لِقَوْمٍۢ","liqawmin","for a people","জন্যে সম্প্রদায়ের"],["يَعْلَمُونَ","ya‘lamūna","(who) know","(যারা) জ্ঞান রাখে"]],"t":"فَإِ<k>ن تَ</>ابُو<s>ا۟</> وَأَقَامُو<s>ا۟</> <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةَ وَءَاتَوُ<s>ا۟</> <h>ٱ</><l>ل</>زَّكَ<s>وٰ</>ةَ فَإِخْ<m>وَٰ</>نُكُمْ فِى <h>ٱ</><l>ل</>دِّينِ ۗ وَنُفَصِّلُ <h>ٱ</>لْءَا<m>يَٰ</>تِ لِقَوْ<d>مٍۢ يَ</>عْلَ<p>مُو</>نَ"},{"n":12,"w":[["وَإِن","wa-in","And if","আর যদি"],["نَّكَثُوٓا۟","nakathū","they break","তারা ভঙ্গ করে"],["أَيْمَـٰنَهُم","aymānahum","their oaths","শপথ তাদের"],["مِّنۢ","min","after","থেকে"],["بَعْدِ","ba‘di","after","পর"],["عَهْدِهِمْ","‘ahdihim","their treaty","চুক্তির তাদের"],["وَطَعَنُوا۟","waṭa‘anū","and defame","ও বিদ্রূপ করে"],["فِى","fī","[in]","সম্পর্কে"],["دِينِكُمْ","dīnikum","your religion","দীনের তোমাদের"],["فَقَـٰتِلُوٓا۟","faqātilū","then fight","তখন তোমরা লড়াই করো"],["أَئِمَّةَ","a-immata","the leaders","নেতৃবৃন্দের (বিরুদ্ধে)"],["ٱلْكُفْرِ ۙ","l-kuf'ri","(of) [the] disbelief","অবিশ্বাসের"],["إِنَّهُمْ","innahum","indeed, they ","নিশ্চয়ই তারা (এমন যে)"],["لَآ","lā","no","নেই(বিশ্বাস)"],["أَيْمَـٰنَ","aymāna","oaths","শপথ"],["لَهُمْ","lahum","for them","কাছে তাদের"],["لَعَلَّهُمْ","la‘allahum","so that they may","(এরূপ আচরণে)সম্ভবতঃ তারা"],["يَنتَهُونَ","yantahūna","cease","বিরত হবে"]],"t":"وَ<d>إِن نَّ</>كَ<o>ثُوٓ</><s>ا۟</> أَيْ<m>مَٰ</>نَ<y>هُم مِّ</><i>نۢ بَ</>عْدِ عَهْدِهِمْ وَطَعَنُو<s>ا۟</> فِى دِينِكُمْ فَ<m>قَٰ</>تِ<o>لُوٓ</><s>ا۟</> أَئِ<g>مَّ</>ةَ <h>ٱ</>لْكُفْرِ ۙ إِ<g>نَّ</>هُمْ <o>لَآ</> أَيْ<m>مَٰ</>نَ لَهُمْ لَعَلَّهُمْ يَ<k>نتَ</><p>هُو</>نَ"},{"n":13,"w":[["أَلَا","alā","Will not","কি না"],["تُقَـٰتِلُونَ","tuqātilūna","you fight","তোমরা যুদ্ধ করবে"],["قَوْمًۭا","qawman","a people","সম্প্রদায়ের(বিরুদ্ধে)"],["نَّكَثُوٓا۟","nakathū","who broke","(যারা) ভঙ্গ করেছে"],["أَيْمَـٰنَهُمْ","aymānahum","their oaths","শপথ তাদের"],["وَهَمُّوا۟","wahammū","and determined","এবং সংকল্প করেছিলো"],["بِإِخْرَاجِ","bi-ikh'rāji","to drive out","ব্যাপারে বহিষ্কার করার"],["ٱلرَّسُولِ","l-rasūli","the Messenger","রাসূলকে"],["وَهُم","wahum","and they","ও তারা"],["بَدَءُوكُمْ","badaūkum","began (to attack) you","তোমাদের সাথে শুরু করেছিলো (বাড়াবাড়ি)"],["أَوَّلَ","awwala","first","প্রথম"],["مَرَّةٍ ۚ","marratin","time","বারেই"],["أَتَخْشَوْنَهُمْ ۚ","atakhshawnahum","Do you fear them","কি তোমরা ভয় করো তাদেরকে"],["فَٱللَّهُ","fal-lahu","But Allah","অথচ আল্লাহই"],["أَحَقُّ","aḥaqqu","(has) more right","অধিক অধিকারী"],["أَن","an","that","যে"],["تَخْشَوْهُ","takhshawhu","you should fear Him","তোমরা ভয় করো তাঁকে"],["إِن","in","if","যদি"],["كُنتُم","kuntum","you are","হয়ে থাকো তোমরা"],["مُّؤْمِنِينَ","mu'minīna","believers","মু'মিন"]],"t":"أَلَا تُ<m>قَٰ</>تِلُونَ قَوْ<d>مًۭا نَّ</>كَ<o>ثُوٓ</><s>ا۟</> أَيْ<m>مَٰ</>نَهُمْ وَهَ<g>مُّ</>و<s>ا۟</> بِإِخْرَاجِ <h>ٱ</><l>ل</>رَّسُولِ وَ<f>هُم بَ</>دَءُوكُمْ أَوَّلَ مَرَّةٍ ۚ أَتَخْشَوْنَهُمْ ۚ فَ<h>ٱ</>للَّهُ أَحَقُّ أَ<k>ن تَ</>خْشَوْهُ إِ<k>ن كُنتُ</><y>م مُّ</>ؤْمِ<p>نِي</>نَ"},{"n":14,"w":[["قَـٰتِلُوهُمْ","qātilūhum","Fight them ","তাদের বিরুদ্ধে লড়াই করো"],["يُعَذِّبْهُمُ","yu‘adhib'humu","Allah will punish them","শাস্তি দিবেন তাদেরকে"],["ٱللَّهُ","l-lahu","Allah will punish them","আল্লাহ"],["بِأَيْدِيكُمْ","bi-aydīkum","by your hands","দিয়ে হাত তোমাদের"],["وَيُخْزِهِمْ","wayukh'zihim","and disgrace them","এবং লাঞ্ছিত করবেন তাদেরকে"],["وَيَنصُرْكُمْ","wayanṣur'kum","and give you victory","এবং সাহায্য করবেন তোমাদেরকে"],["عَلَيْهِمْ","‘alayhim","over them","বিরুদ্ধে তাদের"],["وَيَشْفِ","wayashfi","and will heal","ও আরোগ্য করবেন"],["صُدُورَ","ṣudūra","(the) breasts","অন্তরসমুহকে"],["قَوْمٍۢ","qawmin","(of) a people","সম্প্রদায়ের"],["مُّؤْمِنِينَ","mu'minīna","(who are) believers","(যারা)মু'মিন"]],"t":"<m>قَٰ</>تِلُوهُمْ يُعَذِّ<q>بْ</>هُمُ <h>ٱ</>للَّهُ بِأَيْدِيكُمْ وَيُخْزِهِمْ وَيَ<k>نصُ</>رْكُمْ عَلَيْهِمْ وَيَشْفِ صُدُورَ قَوْ<d>مٍۢ مُّ</>ؤْمِ<p>نِي</>نَ"},{"n":15,"w":[["وَيُذْهِبْ","wayudh'hib","And remove","এবং দূর করবেন তিনি"],["غَيْظَ","ghayẓa","(the) anger","ক্ষোভ (জ্বালা)"],["قُلُوبِهِمْ ۗ","qulūbihim","(of) their hearts","অন্তরসমূহের তাদের"],["وَيَتُوبُ","wayatūbu","And Allah accepts repentance","ও তওবা কবুল করবেন"],["ٱللَّهُ","l-lahu","And Allah accepts repentance","আল্লাহ"],["عَلَىٰ","‘alā","of","(তাদের) প্রতি"],["مَن","man","whom","যাদেরকে"],["يَشَآءُ ۗ","yashāu","He wills","তিনি ইচ্ছে করবেন"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["عَلِيمٌ","‘alīmun","(is) All-Knower","সর্বজ্ঞ"],["حَكِيمٌ","ḥakīmun","All-Wise","সুবিজ্ঞ"]],"t":"وَيُذْهِ<q>بْ</> غَيْظَ قُلُوبِهِمْ ۗ وَيَتُوبُ <h>ٱ</>للَّهُ عَلَىٰ <d>مَن يَ</><o>شَآ</>ءُ ۗ وَ<h>ٱ</>للَّهُ عَلِيمٌ حَ<p>كِي</>مٌ"},{"n":16,"w":[["أَمْ","am","Or","কি"],["حَسِبْتُمْ","ḥasib'tum","(do) you think","মনে করেছো তোমরা"],["أَن","an","that","যে"],["تُتْرَكُوا۟","tut'rakū","you would be left","তোমাদেরকে ছেড়ে দেয়া হবে"],["وَلَمَّا","walammā","while not","অথচ নি"],["يَعْلَمِ","ya‘lami","Allah made evident","জানেন(এখন পর্যন্ত)"],["ٱللَّهُ","l-lahu","Allah made evident","আল্লাহ"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) কারা"],["جَـٰهَدُوا۟","jāhadū","strive","তারা জিহাদ করেছে (তাঁর পথে)"],["مِنكُمْ","minkum","among you","মধ্য থেকে তোমাদের"],["وَلَمْ","walam","and not","ও নি"],["يَتَّخِذُوا۟","yattakhidhū","take","ও তারা গ্রহণ করে(অন্য কাউকে)"],["مِن","min","besides Allah","দিয়ে"],["دُونِ","dūni","besides Allah","বাদ"],["ٱللَّهِ","l-lahi","besides Allah","আল্লাহ"],["وَلَا","walā","and not","ও না"],["رَسُولِهِۦ","rasūlihi","His Messenger","তাঁর রাসূল"],["وَلَا","walā","and not","ও না"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believers","মু'মিনদেরকে"],["وَلِيجَةًۭ ۚ","walījatan","(as) intimates","অন্তরঙ্গ বন্ধু হিসেবে"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["خَبِيرٌۢ","khabīrun","(is) All-Aware","খুব জানেন"],["بِمَا","bimā","of what","ঐ বিষয়ে যা"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা কাজ করছো"]],"t":"أَمْ حَسِ<q>بْ</>تُمْ أَ<k>ن تُ</>تْرَكُو<s>ا۟</> وَلَ<g>مَّ</>ا يَعْلَمِ <h>ٱ</>للَّهُ <h>ٱ</>لَّذِينَ <m>جَٰ</>هَدُو<s>ا۟</> مِ<k>نكُ</>مْ وَلَمْ يَتَّخِذُو<s>ا۟</> مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ وَلَا رَسُولِ<m>هِۦ</> وَلَا <h>ٱ</>لْمُؤْمِنِينَ وَلِيجَ<d>ةًۭ ۚ وَ</><h>ٱ</>للَّهُ خَبِي<i>رٌۢ بِ</>مَا تَعْمَ<p>لُو</>نَ"},{"n":17,"w":[["مَا","mā","(It) is not","না"],["كَانَ","kāna","(It) is not","হতে পারে (এমন)"],["لِلْمُشْرِكِينَ","lil'mush'rikīna","for the polytheists","জন্যে মুশরিকদের"],["أَن","an","that","যে"],["يَعْمُرُوا۟","ya‘murū","they maintain","রক্ষণাবেক্ষণ করবে তারা"],["مَسَـٰجِدَ","masājida","(the) masajid of Allah","মাসজিদসমূহের"],["ٱللَّهِ","l-lahi","(the) masajid of Allah","আল্লাহর"],["شَـٰهِدِينَ","shāhidīna","(while) witnessing","(যখন) তারা সাক্ষ্যদাতা"],["عَلَىٰٓ","‘alā","against","উপর"],["أَنفُسِهِم","anfusihim","themselves","নিজেদের তাদের"],["بِٱلْكُفْرِ ۚ","bil-kuf'ri","[with] disbelief","সম্পর্কে অবিশ্বাস"],["أُو۟لَـٰٓئِكَ","ulāika","(For) those","ঐসব লোকের"],["حَبِطَتْ","ḥabiṭat","worthless","নষ্ট হয়েছে"],["أَعْمَـٰلُهُمْ","a‘māluhum","(are) their deeds","কাজকর্ম তাদের"],["وَفِى","wafī","and in","ও মধ্যে"],["ٱلنَّارِ","l-nāri","the Fire","জাহান্নামের"],["هُمْ","hum","they","তারা"],["خَـٰلِدُونَ","khālidūna","(will) abide forever","চিরস্থায়ী হবে"]],"t":"مَا كَانَ لِلْمُشْرِكِينَ <d>أَن يَ</>عْمُرُو<s>ا۟</> مَ<m>سَٰ</>جِدَ <h>ٱ</>للَّهِ <m>شَٰ</>هِدِينَ عَلَ<o>ىٰٓ</> أَ<k>نفُ</>سِ<f>هِم بِ</><h>ٱ</>لْكُفْرِ ۚ أُ<s>و۟</><o>لَٰٓ</>ئِكَ حَبِطَتْ أَعْ<m>مَٰ</>لُهُمْ وَفِى <h>ٱ</><l>ل</><g>نَّ</>ارِ هُمْ <m>خَٰ</>لِ<p>دُو</>نَ"},{"n":18,"w":[["إِنَّمَا","innamā","Only","মূলত"],["يَعْمُرُ","ya‘muru","will maintain","রক্ষণাবেক্ষণ করবে"],["مَسَـٰجِدَ","masājida","(the) masajid of Allah","মাসজিদসমূহের"],["ٱللَّهِ","l-lahi","(the) masajid of Allah","আল্লাহর"],["مَنْ","man","(the one) who","(সেই) যে"],["ءَامَنَ","āmana","believes","ঈমান এনেছে"],["بِٱللَّهِ","bil-lahi","in Allah","উপর আল্লাহর"],["وَٱلْيَوْمِ","wal-yawmi","and the Day","ও দিনের"],["ٱلْـَٔاخِرِ","l-ākhiri","the Last","আখিরাতের"],["وَأَقَامَ","wa-aqāma","and establishes","ও প্রতিষ্ঠা করে"],["ٱلصَّلَوٰةَ","l-ṣalata","the prayer","সালাত"],["وَءَاتَى","waātā","and gives","ও আদায় করে"],["ٱلزَّكَوٰةَ","l-zakata","the zakah","যাকাত"],["وَلَمْ","walam","and not","ও না"],["يَخْشَ","yakhsha","fear","ভয় করে (অন্য কাউকে)"],["إِلَّا","illā","except","ছাড়া"],["ٱللَّهَ ۖ","l-laha","Allah","আল্লাহ"],["فَعَسَىٰٓ","fa‘asā","Then perhaps","আশা করা যায়"],["أُو۟لَـٰٓئِكَ","ulāika","those","ঐসব লোক"],["أَن","an","[that]","যে"],["يَكُونُوا۟","yakūnū","they are","তারাই হবে"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْمُهْتَدِينَ","l-muh'tadīna","the guided ones","সঠিক পথপ্রাপ্তদের"]],"t":"إِ<g>نَّ</>مَا يَعْمُرُ مَ<m>سَٰ</>جِدَ <h>ٱ</>للَّهِ مَنْ ءَامَنَ بِ<h>ٱ</>للَّهِ وَ<h>ٱ</>لْيَوْمِ <h>ٱ</>لْءَاخِرِ وَأَقَامَ <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةَ وَءَاتَى <h>ٱ</><l>ل</>زَّكَ<s>وٰ</>ةَ وَلَمْ يَخْشَ إِلَّا <h>ٱ</>للَّهَ ۖ فَعَسَ<o>ىٰٓ</> أُ<s>و۟</><o>لَٰٓ</>ئِكَ <d>أَن يَ</>كُونُو<s>ا۟</> مِنَ <h>ٱ</>لْمُهْتَ<p>دِي</>نَ"},{"n":19,"w":[["۞ أَجَعَلْتُمْ","aja‘altum","Do you make","কি তোমরা মনে করেছো"],["سِقَايَةَ","siqāyata","the providing of water","পানি পান করানো"],["ٱلْحَآجِّ","l-ḥāji","(to) the pilgrims","হাজ্বীদের"],["وَعِمَارَةَ","wa‘imārata","and (the) maintenance","ও রক্ষণাবেক্ষণ করা"],["ٱلْمَسْجِدِ","l-masjidi","(of) Al-Masjid Al-Haraam","মাসজিদে"],["ٱلْحَرَامِ","l-ḥarāmi","(of) Al-Masjid Al-Haraam","হারামের"],["كَمَنْ","kaman","like (the one) who","সমান তার যে"],["ءَامَنَ","āmana","believes","ঈমান এনেছে"],["بِٱللَّهِ","bil-lahi","in Allah","প্রতি আল্লাহর"],["وَٱلْيَوْمِ","wal-yawmi","and the Day","ও দিনের"],["ٱلْـَٔاخِرِ","l-ākhiri","the Last","আখিরাতের"],["وَجَـٰهَدَ","wajāhada","and strives","ও জিহাদ করে"],["فِى","fī","in","মধ্যে"],["سَبِيلِ","sabīli","(the) way","পথের"],["ٱللَّهِ ۚ","l-lahi","(of) Allah","আল্লাহর"],["لَا","lā","They are not equal","নয়"],["يَسْتَوُۥنَ","yastawūna","They are not equal","তারা সমান"],["عِندَ","‘inda","near","নিকট"],["ٱللَّهِ ۗ","l-lahi","Allah","আল্লাহর"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["لَا","lā","(does) not","না"],["يَهْدِى","yahdī","guide","সঠিক পথ দেখান"],["ٱلْقَوْمَ","l-qawma","the people ","সম্প্রদায়কে"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","(যারা)সীমালঙ্ঘনকারী"]],"t":"۞ أَجَعَلْتُمْ سِقَايَةَ <h>ٱ</>لْ<n>حَآ</>جِّ وَعِمَارَةَ <h>ٱ</>لْمَسْجِدِ <h>ٱ</>لْحَرَامِ كَمَنْ ءَامَنَ بِ<h>ٱ</>للَّهِ وَ<h>ٱ</>لْيَوْمِ <h>ٱ</>لْءَاخِرِ وَ<m>جَٰ</>هَدَ فِى سَبِيلِ <h>ٱ</>للَّهِ ۚ لَا يَسْتَوُ<m>ۥ</>نَ عِ<k>ندَ</> <h>ٱ</>للَّهِ ۗ وَ<h>ٱ</>للَّهُ لَا يَهْدِى <h>ٱ</>لْقَوْمَ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":20,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["ءَامَنُوا۟","āmanū","believed","ঈমান এনেছে"],["وَهَاجَرُوا۟","wahājarū","and emigrated","ও হিজরত করেছে"],["وَجَـٰهَدُوا۟","wajāhadū","and strove","ও জিহাদ করেছে"],["فِى","fī","in","মধ্যে"],["سَبِيلِ","sabīli","(the) way","পথের"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["بِأَمْوَٰلِهِمْ","bi-amwālihim","with their wealth","দিয়ে ধনসম্পদ তাদের"],["وَأَنفُسِهِمْ","wa-anfusihim","and their lives","ও প্রাণসমূহ তাদের (দিয়ে)"],["أَعْظَمُ","a‘ẓamu","(are) greater","(তারা) অতি বড়"],["دَرَجَةً","darajatan","(in) rank","মর্যাদায় (অধিষ্ঠিত)"],["عِندَ","‘inda","near","কাছে"],["ٱللَّهِ ۚ","l-lahi","Allah","আল্লাহর"],["وَأُو۟لَـٰٓئِكَ","wa-ulāika","And those ","এবং ঐসব লোক"],["هُمُ","humu","they","তারাই"],["ٱلْفَآئِزُونَ","l-fāizūna","(are) the successful","সফলকাম"]],"t":"ٱلَّذِينَ ءَامَنُو<s>ا۟</> وَهَاجَرُو<s>ا۟</> وَ<m>جَٰ</>هَدُو<s>ا۟</> فِى سَبِيلِ <h>ٱ</>للَّهِ بِأَمْ<m>وَٰ</>لِهِمْ وَأَ<k>نفُ</>سِهِمْ أَعْظَمُ دَرَجَةً عِ<k>ندَ</> <h>ٱ</>للَّهِ ۚ وَأُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</>لْ<o>فَآ</>ئِ<p>زُو</>نَ"},{"n":21,"w":[["يُبَشِّرُهُمْ","yubashiruhum","Their Lord gives them glad tidings","সুসংবাদ দিচ্ছেন তাদেরকে"],["رَبُّهُم","rabbuhum","Their Lord gives them glad tidings","তাদের রব"],["بِرَحْمَةٍۢ","biraḥmatin","of Mercy","সাহায্যে দয়ার"],["مِّنْهُ","min'hu","from Him","পক্ষ হতে তাঁর"],["وَرِضْوَٰنٍۢ","wariḍ'wānin","and Pleasure","ও (তাঁর) সন্তুষ্টির"],["وَجَنَّـٰتٍۢ","wajannātin","and Gardens","এবং জান্নাতের"],["لَّهُمْ","lahum","for them ","জন্যে তাদের"],["فِيهَا","fīhā","in it","মধ্যে তার(রয়েছে)"],["نَعِيمٌۭ","na‘īmun","(is) bliss","সুখ"],["مُّقِيمٌ","muqīmun","enduring","স্থায়ী"]],"t":"يُبَشِّرُهُمْ رَبُّ<f>هُم بِ</>رَحْمَ<d>ةٍۢ مِّ</>نْهُ وَرِضْ<m>وَٰ</><d>نٍۢ وَ</>جَ<g>نَّٰ</><w>تٍۢ لَّ</>هُمْ فِيهَا نَعِي<d>مٌۭ مُّ</><p>قِي</>مٌ"},{"n":22,"w":[["خَـٰلِدِينَ","khālidīna","(They will) abide","তারা চিরস্থায়ী হবে"],["فِيهَآ","fīhā","in it","মধ্যে তার"],["أَبَدًا ۚ","abadan","forever","অনাগতকাল (পর্যন্ত)"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah ","আল্লাহর"],["عِندَهُۥٓ","‘indahu","with Him","কাছে (আছে) তাঁর"],["أَجْرٌ","ajrun","(is) a reward","পুরস্কার"],["عَظِيمٌۭ","‘aẓīmun","great","বিরাট"]],"t":"<m>خَٰ</>لِدِينَ فِي<o>هَآ</> أَبَدًا ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ عِ<k>ندَ</>هُ<o>ۥٓ</> أَ<q>جْ</>رٌ عَ<p>ظِي</>مٌۭ"},{"n":23,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O you","হে"],["ٱلَّذِينَ","alladhīna","who","যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছো"],["لَا","lā","(Do) not","না"],["تَتَّخِذُوٓا۟","tattakhidhū","take","তোমরা গ্রহণ করো"],["ءَابَآءَكُمْ","ābāakum","your fathers","বাপ-দাদাদেরকে তোমাদের"],["وَإِخْوَٰنَكُمْ","wa-ikh'wānakum","and your brothers","ও ভাইদেরকে তোমাদের"],["أَوْلِيَآءَ","awliyāa","(as) allies","বন্ধু্রূপে"],["إِنِ","ini","if","যদি"],["ٱسْتَحَبُّوا۟","is'taḥabbū","they prefer","তারা অধিক ভালবাসে"],["ٱلْكُفْرَ","l-kuf'ra","[the] disbelief","অবিশ্বাসকে"],["عَلَى","‘alā","over","উপর"],["ٱلْإِيمَـٰنِ ۚ","l-īmāni","[the] belief","ঈমানের (তুলনায়)"],["وَمَن","waman","And whoever","এবং যে"],["يَتَوَلَّهُم","yatawallahum","takes them as allies","ভালোবাসবে তাদেরকে"],["مِّنكُمْ","minkum","among you","মধ্য হতে তোমাদের"],["فَأُو۟لَـٰٓئِكَ","fa-ulāika","then those","তবে ঐসব লোক"],["هُمُ","humu","[they]","তারাই"],["ٱلظَّـٰلِمُونَ","l-ẓālimūna","(are) the wrongdoers","সীমালঙ্ঘনকারী"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> لَا تَتَّخِ<o>ذُوٓ</><s>ا۟</> ءَا<o>بَآ</>ءَكُمْ وَإِخْ<m>وَٰ</>نَكُمْ أَوْلِ<o>يَآ</>ءَ إِنِ <h>ٱ</>سْتَحَبُّو<s>ا۟</> <h>ٱ</>لْكُفْرَ عَلَى <h>ٱ</>لْإِي<m>مَٰ</>نِ ۚ وَ<d>مَن يَ</>تَوَلَّ<y>هُم مِّ</><k>نكُ</>مْ فَأُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مُو</>نَ"},{"n":24,"w":[["قُلْ","qul","Say","বলো"],["إِن","in","If","\"যদি"],["كَانَ","kāna","are","হয়"],["ءَابَآؤُكُمْ","ābāukum","your fathers","বাপ-দাদারা তোমাদের"],["وَأَبْنَآؤُكُمْ","wa-abnāukum","and your sons","ও সন্তানেরা তোমাদের"],["وَإِخْوَٰنُكُمْ","wa-ikh'wānukum","and your brothers","ও ভাইয়েরা তোমাদের"],["وَأَزْوَٰجُكُمْ","wa-azwājukum","and your spouses","ও স্ত্রীরা তোমাদের"],["وَعَشِيرَتُكُمْ","wa‘ashīratukum","and your relatives","ও স্বজনগোষ্ঠি তোমাদের"],["وَأَمْوَٰلٌ","wa-amwālun","and wealth","ও ধনসম্পদ"],["ٱقْتَرَفْتُمُوهَا","iq'taraftumūhā","that you have acquired","যা তোমরা অর্জন করেছো"],["وَتِجَـٰرَةٌۭ","watijāratun","and the commerce","ও ব্যবসা-বাণিজ্য"],["تَخْشَوْنَ","takhshawna","you fear","তোমরা ভয় করো"],["كَسَادَهَا","kasādahā","a decline (in) it","মন্দা পড়ার যার"],["وَمَسَـٰكِنُ","wamasākinu","and the dwellings","ও বাসগৃহসমূহ"],["تَرْضَوْنَهَآ","tarḍawnahā","you delight (in) it","তোমরা পছন্দ করো যা"],["أَحَبَّ","aḥabba","(are) more beloved","অধিক প্রিয়"],["إِلَيْكُم","ilaykum","to you","কাছে তোমাদের"],["مِّنَ","mina","than","হতে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["وَرَسُولِهِۦ","warasūlihi","and His Messenger","ও তাঁর রাসূল (হতে)"],["وَجِهَادٍۢ","wajihādin","and striving","ও জিহাদ(হতে)"],["فِى","fī","in","মধ্যে"],["سَبِيلِهِۦ","sabīlihi","His way","পথের তাঁর"],["فَتَرَبَّصُوا۟","fatarabbaṣū","then wait","তবে তোমরা অপেক্ষা করো"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["يَأْتِىَ","yatiya","Allah brings","আসেন"],["ٱللَّهُ","l-lahu","Allah brings","আল্লাহ"],["بِأَمْرِهِۦ ۗ","bi-amrihi","His Command","নিয়ে তাঁর নির্দেশ"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["لَا","lā","(does) not","না"],["يَهْدِى","yahdī","guide","পথে দেখান"],["ٱلْقَوْمَ","l-qawma","the people ","সম্প্রদায়কে"],["ٱلْفَـٰسِقِينَ","l-fāsiqīna","the defiantly disobedient","(যারা) সত্যত্যাগী\""]],"t":"قُلْ إِ<k>ن كَ</>انَ ءَا<o>بَآ</>ؤُكُمْ وَأَ<q>بْ</><o>نَآ</>ؤُكُمْ وَإِخْ<m>وَٰ</>نُكُمْ وَأَزْ<m>وَٰ</>جُكُمْ وَعَشِيرَتُكُمْ وَأَمْ<m>وَٰ</>لٌ <h>ٱ</><q>قْ</>تَرَفْتُمُوهَا وَتِ<m>جَٰ</>رَ<k>ةٌۭ تَ</>خْشَوْنَ كَسَادَهَا وَمَ<m>سَٰ</>كِنُ تَرْضَوْنَ<o>هَآ</> أَحَبَّ إِلَيْ<y>كُم مِّ</>نَ <h>ٱ</>للَّهِ وَرَسُولِ<m>هِۦ</> وَجِهَا<k>دٍۢ فِ</>ى سَبِيلِ<m>هِۦ</> فَتَرَبَّصُو<s>ا۟</> حَتَّىٰ يَأْتِىَ <h>ٱ</>للَّهُ بِأَمْرِ<m>هِۦ</> ۗ وَ<h>ٱ</>للَّهُ لَا يَهْدِى <h>ٱ</>لْقَوْمَ <h>ٱ</>لْ<m>فَٰ</>سِ<p>قِي</>نَ"},{"n":25,"w":[["لَقَدْ","laqad","Verily","নিশ্চয়ই"],["نَصَرَكُمُ","naṣarakumu","Allah helped you","সাহায্য করেছেন তোমাদের"],["ٱللَّهُ","l-lahu","Allah helped you","আল্লাহ"],["فِى","fī","in","মধ্যে"],["مَوَاطِنَ","mawāṭina","regions","জায়গায়"],["كَثِيرَةٍۢ ۙ","kathīratin","many","অনেক"],["وَيَوْمَ","wayawma","and (on the) day","ও দিনে"],["حُنَيْنٍ ۙ","ḥunaynin","(of) Hunain","হুনায়নের (যুদ্ধে)"],["إِذْ","idh","when","যখন"],["أَعْجَبَتْكُمْ","a‘jabatkum","pleased you","উৎফুল্ল করেছিলো তোমাদের"],["كَثْرَتُكُمْ","kathratukum","your multitude","সংখ্যাধিক্য তোমাদের"],["فَلَمْ","falam","but not","অতঃপর নি"],["تُغْنِ","tugh'ni","availed","কাজে আসে"],["عَنكُمْ","‘ankum","you","জন্যে তোমাদের"],["شَيْـًۭٔا","shayan","anything","কিছুমাত্র (সংখ্যাধিক্য)"],["وَضَاقَتْ","waḍāqat","and (was) straitened","এবং সংকীর্ণ হয়েছিলো"],["عَلَيْكُمُ","‘alaykumu","for you","তোমাদের উপর"],["ٱلْأَرْضُ","l-arḍu","the earth","পৃথিবী"],["بِمَا","bimā","(in spite) of its vastness","এ সত্ত্বেও যা"],["رَحُبَتْ","raḥubat","(in spite) of its vastness","প্রশস্ত ছিলো"],["ثُمَّ","thumma","then","এরপর"],["وَلَّيْتُم","wallaytum","you turned back","তোমরা ফিরে গেলে"],["مُّدْبِرِينَ","mud'birīna","fleeing","পিঠ প্রদর্শনকারী হয়ে"]],"t":"لَقَ<q>دْ</> نَصَرَكُمُ <h>ٱ</>للَّهُ فِى مَوَاطِنَ كَثِيرَ<d>ةٍۢ ۙ وَ</>يَوْمَ حُنَيْنٍ ۙ إِذْ أَعْجَبَتْكُمْ كَثْرَتُكُمْ فَلَمْ تُغْنِ عَ<k>نكُ</>مْ شَ<d>يْـًۭٔا وَ</>ضَاقَتْ عَلَيْكُمُ <h>ٱ</>لْأَرْضُ بِمَا رَحُبَتْ ثُ<g>مَّ</> وَلَّيْ<y>تُم مُّ</><q>دْ</>بِ<p>رِي</>نَ"},{"n":26,"w":[["ثُمَّ","thumma","Then","এরপর"],["أَنزَلَ","anzala","Allah sent down","অবতীর্ণ করলেন"],["ٱللَّهُ","l-lahu","Allah sent down","আল্লাহ"],["سَكِينَتَهُۥ","sakīnatahu","His tranquility","তাঁর প্রশান্তি"],["عَلَىٰ","‘alā","on","উপর"],["رَسُولِهِۦ","rasūlihi","His Messenger","তাঁর রাসূলের"],["وَعَلَى","wa‘alā","and on","ও উপর"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believers","মু'মিনদের"],["وَأَنزَلَ","wa-anzala","and sent down","ও অবতীর্ণ করলেন"],["جُنُودًۭا","junūdan","forces","(এমন) বাহিনী"],["لَّمْ","lam","which you did not see","নি"],["تَرَوْهَا","tarawhā","which you did not see","তা তোমরা দেখতে পাও"],["وَعَذَّبَ","wa‘adhaba","and He punished","ও শাস্তি দিলেন"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["كَفَرُوا۟ ۚ","kafarū","disbelieved","অস্বীকার করেছিলো"],["وَذَٰلِكَ","wadhālika","And that","ও এটা (ছিলো)"],["جَزَآءُ","jazāu","(is) the recompense","কর্মফল"],["ٱلْكَـٰفِرِينَ","l-kāfirī