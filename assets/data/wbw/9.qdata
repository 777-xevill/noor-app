তোমাদের"],["ٱللَّهُ","l-lahu","Allah will enrich you","আল্লাহ"],["مِن","min","from","দিয়ে"],["فَضْلِهِۦٓ","faḍlihi","His Bounty","অনুগ্রহ তাঁর"],["إِن","in","if","যদি"],["شَآءَ ۚ","shāa","He wills","তিনি ইচ্ছে করেন"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["عَلِيمٌ","‘alīmun","(is) All-Knower","সর্বজ্ঞ"],["حَكِيمٌۭ","ḥakīmun","All-Wise","মহাবিজ্ঞ"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَ<o>نُوٓ</><s>ا۟</> إِ<g>نَّ</>مَا <h>ٱ</>لْمُشْرِكُونَ نَجَ<k>سٌۭ فَ</>لَا يَ<q>قْ</>رَبُو<s>ا۟</> <h>ٱ</>لْمَسْجِدَ <h>ٱ</>لْحَرَامَ بَعْدَ عَامِهِمْ <m>هَٰ</>ذَا ۚ وَإِنْ خِفْتُمْ عَيْلَ<k>ةًۭ فَ</>سَوْفَ يُغْنِيكُمُ <h>ٱ</>للَّهُ مِ<k>ن فَ</>ضْلِ<o>هِۦٓ</> إِ<k>ن شَ</><o>آ</>ءَ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ عَلِيمٌ حَ<p>كِي</>مٌۭ"},{"n":29,"w":[["قَـٰتِلُوا۟","qātilū","Fight","তোমরা যুদ্ধ করো"],["ٱلَّذِينَ","alladhīna","those who","(তাদের বিরুদ্ধে) যারা"],["لَا","lā","(do) not","না"],["يُؤْمِنُونَ","yu'minūna","believe","ঈমান আনে"],["بِٱللَّهِ","bil-lahi","in Allah","উপর আল্লাহর"],["وَلَا","walā","and not","এবং না"],["بِٱلْيَوْمِ","bil-yawmi","in the Day","উপর দিনের"],["ٱلْـَٔاخِرِ","l-ākhiri","the Last","আখেরাতের"],["وَلَا","walā","and not","এবং না"],["يُحَرِّمُونَ","yuḥarrimūna","they make unlawful","নিষিদ্ধ করে"],["مَا","mā","what","যা কিছু"],["حَرَّمَ","ḥarrama","Allah has made unlawful","নিষিদ্ধ করেছেন"],["ٱللَّهُ","l-lahu","Allah has made unlawful","আল্লাহ"],["وَرَسُولُهُۥ","warasūluhu","and His Messenger","ও তাঁর রাসূল"],["وَلَا","walā","and not","এবং না"],["يَدِينُونَ","yadīnūna","they acknowledge","আনুগত্য করে"],["دِينَ","dīna","(the) religion","দ্বীনের"],["ٱلْحَقِّ","l-ḥaqi","(of) the truth","সত্যকে"],["مِنَ","mina","from","মধ্য হতে"],["ٱلَّذِينَ","alladhīna","those who","যাদেরকে"],["أُوتُوا۟","ūtū","were given","দেয়া হয়েছে"],["ٱلْكِتَـٰبَ","l-kitāba","the Scripture","কিতাব"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["يُعْطُوا۟","yu‘'ṭū","they pay","তারা দেয়"],["ٱلْجِزْيَةَ","l-jiz'yata","the jizyah","(জিযিয়া) কর"],["عَن","‘an","willingly","দিয়ে"],["يَدٍۢ","yadin","willingly","(নিজেদের) হাত"],["وَهُمْ","wahum","while they","এমতাবস্হায় যে তারা"],["صَـٰغِرُونَ","ṣāghirūna","(are) subdued","ছোট (হয়ে থাকে)"]],"t":"<m>قَٰ</>تِلُو<s>ا۟</> <h>ٱ</>لَّذِينَ لَا يُؤْمِنُونَ بِ<h>ٱ</>للَّهِ وَلَا بِ<h>ٱ</>لْيَوْمِ <h>ٱ</>لْءَاخِرِ وَلَا يُحَرِّمُونَ مَا حَرَّمَ <h>ٱ</>للَّهُ وَرَسُولُهُ<m>ۥ</> وَلَا يَدِينُونَ دِينَ <h>ٱ</>لْحَقِّ مِنَ <h>ٱ</>لَّذِينَ أُوتُو<s>ا۟</> <h>ٱ</>لْكِ<m>تَٰ</>بَ حَتَّىٰ يُعْطُو<s>ا۟</> <h>ٱ</>لْجِزْيَةَ <d>عَن يَدٍۢ وَ</>هُمْ <m>صَٰ</>غِ<p>رُو</>نَ"},{"n":30,"w":[["وَقَالَتِ","waqālati","And said","আর বলে"],["ٱلْيَهُودُ","l-yahūdu","the Jews","ইয়াহুদীরা"],["عُزَيْرٌ","‘uzayrun","Uzair","\"উজাইর"],["ٱبْنُ","ub'nu","(is) son","পুত্র"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর\""],["وَقَالَتِ","waqālati","And said","আর বলে"],["ٱلنَّصَـٰرَى","l-naṣārā","the Christians","নাসারা (খ্রিষ্টানরা)"],["ٱلْمَسِيحُ","l-masīḥu","Messiah","\"মসীহ (ঈসা আঃ)"],["ٱبْنُ","ub'nu","(is) son","পুত্র"],["ٱللَّهِ ۖ","l-lahi","(of) Allah","আল্লাহর\""],["ذَٰلِكَ","dhālika","That","এটা"],["قَوْلُهُم","qawluhum","(is) their saying","কথা তাদের"],["بِأَفْوَٰهِهِمْ ۖ","bi-afwāhihim","with their mouths","দিয়ে মুখ তাদের"],["يُضَـٰهِـُٔونَ","yuḍāhiūna","they imitate","তারা মিল রেখে বলে"],["قَوْلَ","qawla","the saying","কথা"],["ٱلَّذِينَ","alladhīna","(of) those who","(তাদের) যারা"],["كَفَرُوا۟","kafarū","disbelieved","অস্বীকার করেছে"],["مِن","min","before","থেকেও"],["قَبْلُ ۚ","qablu","before","পূর্ব"],["قَـٰتَلَهُمُ","qātalahumu","(May) Allah destroy them","ধ্বংস করুন তাদের"],["ٱللَّهُ ۚ","l-lahu","(May) Allah destroy them","আল্লাহ"],["أَنَّىٰ","annā","How","কেমন করে"],["يُؤْفَكُونَ","yu'fakūna","deluded are they","তাদের ফিরিয়ে নেয়া হচ্ছে"]],"t":"وَقَالَتِ <h>ٱ</>لْيَهُودُ عُزَيْرٌ <h>ٱ</><q>بْ</>نُ <h>ٱ</>للَّهِ وَقَالَتِ <h>ٱ</><l>ل</><g>نَّ</><m>صَٰ</>رَى <h>ٱ</>لْمَسِيحُ <h>ٱ</><q>بْ</>نُ <h>ٱ</>للَّهِ ۖ <m>ذَٰ</>لِكَ قَوْلُ<f>هُم بِ</>أَفْ<m>وَٰ</>هِهِمْ ۖ يُ<m>ضَٰ</>هِـُٔونَ قَوْلَ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> مِ<k>ن قَ</><q>بْ</>لُ ۚ <m>قَٰ</>تَلَهُمُ <h>ٱ</>للَّهُ ۚ أَ<g>نَّ</>ىٰ يُؤْفَ<p>كُو</>نَ"},{"n":31,"w":[["ٱتَّخَذُوٓا۟","ittakhadhū","They have taken","তারা গ্রহণ করেছে"],["أَحْبَارَهُمْ","aḥbārahum","their rabbis","পন্ডিতদেরকে তাদের"],["وَرُهْبَـٰنَهُمْ","waruh'bānahum","and their monks","ও সংসার-বিরাগীদেরকে তাদের"],["أَرْبَابًۭا","arbāban","(as) Lords","রব হিসেবে (অর্থাৎ হুকুম দেয়ার মালিক)"],["مِّن","min","besides","বাদ"],["دُونِ","dūni","besides","দিয়ে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহকে"],["وَٱلْمَسِيحَ","wal-masīḥa","and the Messiah","ও মসীহকে"],["ٱبْنَ","ib'na","son","পুত্র"],["مَرْيَمَ","maryama","(of) Maryam","মারইয়ামের"],["وَمَآ","wamā","And not","অথচ না"],["أُمِرُوٓا۟","umirū","they were commanded","তাদেরকে নির্দেশ দেয়া হয়েছে"],["إِلَّا","illā","except","এ ছাড়া"],["لِيَعْبُدُوٓا۟","liya‘budū","that they worship","যেন তারা ইবাদত করে"],["إِلَـٰهًۭا","ilāhan","One God","ইলাহর"],["وَٰحِدًۭا ۖ","wāḥidan","One God","একই (অর্থাৎ আল্লাহর)"],["لَّآ","lā","(There) is no","নেই"],["إِلَـٰهَ","ilāha","god","কোনো ইলাহ"],["إِلَّا","illā","except","ছাড়া"],["هُوَ ۚ","huwa","Him","তিনি"],["سُبْحَـٰنَهُۥ","sub'ḥānahu","Glory be to Him","তিনি পবিত্র"],["عَمَّا","‘ammā","from what","তা হতে যা"],["يُشْرِكُونَ","yush'rikūna","they associate (with Him)","তারা শিরক করছে"]],"t":"ٱتَّخَ<o>ذُوٓ</><s>ا۟</> أَحْبَارَهُمْ وَرُهْ<m>بَٰ</>نَهُمْ أَرْبَا<d>بًۭا مِّ</><k>ن دُ</>ونِ <h>ٱ</>للَّهِ وَ<h>ٱ</>لْمَسِيحَ <h>ٱ</><q>بْ</>نَ مَرْيَمَ وَ<o>مَآ</> أُمِ<o>رُوٓ</><s>ا۟</> إِلَّا لِيَعْبُ<o>دُوٓ</><s>ا۟</> إِ<m>لَٰ</><d>هًۭا وَٰ</>حِ<w>دًۭا ۖ لَّ</><o>آ</> إِ<m>لَٰ</>هَ إِلَّا هُوَ ۚ سُ<q>بْ</><m>حَٰ</>نَهُ<m>ۥ</> عَ<g>مَّ</>ا يُشْرِ<p>كُو</>نَ"},{"n":32,"w":[["يُرِيدُونَ","yurīdūna","They want","তারা চায়"],["أَن","an","to","যে"],["يُطْفِـُٔوا۟","yuṭ'fiū","extinguish","তারা ফুঁৎকারে নিভাবে"],["نُورَ","nūra","Allah's light","আলো"],["ٱللَّهِ","l-lahi","Allah's light","আল্লাহর"],["بِأَفْوَٰهِهِمْ","bi-afwāhihim","with their mouths","দিয়ে মুখ তাদের"],["وَيَأْبَى","wayabā","but Allah refuses","কিন্তু প্রত্যাখ্যান করেন"],["ٱللَّهُ","l-lahu","but Allah refuses","আল্লাহ (সে ইচ্ছা)"],["إِلَّآ","illā","except","এ ছাড়া"],["أَن","an","to","যে"],["يُتِمَّ","yutimma","perfect","তিনি পূর্ণ করবেন"],["نُورَهُۥ","nūrahu","His Light","আলো তাঁর"],["وَلَوْ","walaw","even if","এবং যদিও"],["كَرِهَ","kariha","the disbelievers dislike (it)","অপছন্দ করে"],["ٱلْكَـٰفِرُونَ","l-kāfirūna","the disbelievers dislike (it)","কাফেররা"]],"t":"يُرِيدُونَ <d>أَن يُ</><q>طْ</>فِـُٔو<s>ا۟</> نُورَ <h>ٱ</>للَّهِ بِأَفْ<m>وَٰ</>هِهِمْ وَيَأْبَى <h>ٱ</>للَّهُ إِ<o>لَّآ</> <d>أَن يُ</>تِ<g>مَّ</> نُورَهُ<m>ۥ</> وَلَوْ كَرِهَ <h>ٱ</>لْ<m>كَٰ</>فِ<p>رُو</>نَ"},{"n":33,"w":[["هُوَ","huwa","He","তিনি (আল্লাহই)"],["ٱلَّذِىٓ","alladhī","(is) the One Who","যিনি"],["أَرْسَلَ","arsala","has sent","পাঠিয়েছেন"],["رَسُولَهُۥ","rasūlahu","His Messenger","রাসূূলকে তাঁর"],["بِٱلْهُدَىٰ","bil-hudā","with the guidance","দিয়ে পথনির্দেশ"],["وَدِينِ","wadīni","and the religion","ও দীন"],["ٱلْحَقِّ","l-ḥaqi","(of) [the] truth","সত্য(সহ)"],["لِيُظْهِرَهُۥ","liyuẓ'hirahu","to manifest it","যেন তিনি বিজয়ী করেন তা"],["عَلَى","‘alā","over","উপর"],["ٱلدِّينِ","l-dīni","all religions","দীনের"],["كُلِّهِۦ","kullihi","all religions","সব অপর"],["وَلَوْ","walaw","Even if","এবং যদিও"],["كَرِهَ","kariha","dislike (it)","অপছন্দ করে"],["ٱلْمُشْرِكُونَ","l-mush'rikūna","the polytheists","মুশরিকরা"]],"t":"هُوَ <h>ٱ</>لَّ<o>ذِىٓ</> أَرْسَلَ رَسُولَهُ<m>ۥ</> بِ<h>ٱ</>لْهُدَىٰ وَدِينِ <h>ٱ</>لْحَقِّ لِيُظْهِرَهُ<m>ۥ</> عَلَى <h>ٱ</><l>ل</>دِّينِ كُلِّ<m>هِۦ</> وَلَوْ كَرِهَ <h>ٱ</>لْمُشْرِ<p>كُو</>نَ"},{"n":34,"w":[["۞ يَـٰٓأَيُّهَا","yāayyuhā","O you who believe","হে"],["ٱلَّذِينَ","alladhīna","O you who believe","যারা"],["ءَامَنُوٓا۟","āmanū","O you who believe","ঈমান এনেছো"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["كَثِيرًۭا","kathīran","many","অধিকাংশ"],["مِّنَ","mina","of","মধ্য হতে"],["ٱلْأَحْبَارِ","l-aḥbāri","the rabbis","(আহলে কিতাব) পন্ডিতদের"],["وَٱلرُّهْبَانِ","wal-ruh'bāni","and the