life","নিয়ে জীবন"],["ٱلدُّنْيَا","l-dun'yā","(of) the world","পার্থিব"],["مِنَ","mina","(rather) than","পরিবর্তে"],["ٱلْـَٔاخِرَةِ ۚ","l-ākhirati","the Hereafter","আখেরাতের"],["فَمَا","famā","But what","অথচ নয়"],["مَتَـٰعُ","matā‘u","(is the) enjoyment","ভোগ সামগ্রী"],["ٱلْحَيَوٰةِ","l-ḥayati","(of) the life","জীবনের"],["ٱلدُّنْيَا","l-dun'yā","(of) the world","পার্থিব"],["فِى","fī","in (comparison to)","তুলনায়"],["ٱلْـَٔاخِرَةِ","l-ākhirati","the hereafter","আখেরাতের"],["إِلَّا","illā","except","এ ছাড়া"],["قَلِيلٌ","qalīlun","a little","অতি তুচ্ছ"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> مَا لَكُمْ إِذَا قِيلَ لَكُمُ <h>ٱ</><k>نفِ</>رُو<s>ا۟</> فِى سَبِيلِ <h>ٱ</>للَّهِ <h>ٱ</>ثَّاقَلْتُمْ إِلَى <h>ٱ</>لْأَرْضِ ۚ أَرَضِي<f>تُم بِ</><h>ٱ</>لْحَيَ<s>وٰ</>ةِ <h>ٱ</><l>ل</>دُّنْيَا مِنَ <h>ٱ</>لْءَاخِرَةِ ۚ فَمَا مَ<m>تَٰ</>عُ <h>ٱ</>لْحَيَ<s>وٰ</>ةِ <h>ٱ</><l>ل</>دُّنْيَا فِى <h>ٱ</>لْءَاخِرَةِ إِلَّا قَ<p>لِي</>لٌ"},{"n":39,"w":[["إِلَّا","illā","If not","যদি না"],["تَنفِرُوا۟","tanfirū","you go forth","তোমরা বের হও"],["يُعَذِّبْكُمْ","yu‘adhib'kum","He will punish you","তিনি শাস্তি দিবেন তোমাদের"],["عَذَابًا","‘adhāban","(with) a painful punishment","শাস্তি"],["أَلِيمًۭا","alīman","(with) a painful punishment","বড় কষ্টদায়ক"],["وَيَسْتَبْدِلْ","wayastabdil","and will replace you","ও তিনি পরিবর্তন করবেন"],["قَوْمًا","qawman","(with) a people","(অন্য) জাতিকে"],["غَيْرَكُمْ","ghayrakum","other than you","ছাড়া তোমাদের"],["وَلَا","walā","and not","এবং না"],["تَضُرُّوهُ","taḍurrūhu","you can harm Him","তার তোমরা ক্ষতি করতে পারবে"],["شَيْـًۭٔا ۗ","shayan","(in) anything","কিছুমাত্র"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["عَلَىٰ","‘alā","(is) on","উপর"],["كُلِّ","kulli","every","সব"],["شَىْءٍۢ","shayin","thing","কিছুর"],["قَدِيرٌ","qadīrun","All-Powerful","সর্বশক্তিমান"]],"t":"إِلَّا تَ<k>نفِ</>رُو<s>ا۟</> يُعَذِّ<q>بْ</>كُمْ عَذَابًا أَلِي<d>مًۭا وَ</>يَسْتَ<q>بْ</>دِلْ قَوْمًا غَيْرَكُمْ وَلَا تَضُرُّوهُ شَ<d>يْـًۭٔا ۗ وَ</><h>ٱ</>للَّهُ عَلَىٰ كُلِّ <k>شَىْءٍۢ قَ</><p>دِي</>رٌ"},{"n":40,"w":[["إِلَّا","illā","If not","যদি না"],["تَنصُرُوهُ","tanṣurūhu","you help him","তোমরা সাহায্য করো তাকে"],["فَقَدْ","faqad","certainly","তবে নিশ্চয়ই"],["نَصَرَهُ","naṣarahu","Allah helped him","সাহায্য করেছেন তাকে"],["ٱللَّهُ","l-lahu","Allah helped him","আল্লাহ"],["إِذْ","idh","when","যখন"],["أَخْرَجَهُ","akhrajahu","drove him out","বের করেছিলো তাকে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieved","অবিশ্বাস করেছে"],["ثَانِىَ","thāniya","the second","(সে ছিলো) দ্বিতীয়"],["ٱثْنَيْنِ","ith'nayni","(of) the two","দুজনের"],["إِذْ","idh","when","যখন"],["هُمَا","humā","they both","তারা দু'জনে (ছিলো)"],["فِى","fī","(were) in","মধ্যে"],["ٱلْغَارِ","l-ghāri","the cave","গুহার"],["إِذْ","idh","when","তখন"],["يَقُولُ","yaqūlu","he said","সে বলেছিলো"],["لِصَـٰحِبِهِۦ","liṣāḥibihi","to his companion","উদ্দেশ্যে সাথীর তার"],["لَا","lā","(Do) not","\"না"],["تَحْزَنْ","taḥzan","grieve","চিন্তিত হয়ো তুমি"],["إِنَّ","inna","indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["مَعَنَا ۖ","ma‘anā","(is) with us","সাথে (আছেন)আমাদের\""],["فَأَنزَلَ","fa-anzala","Then Allah sent down","তখন অবতীর্ণ করলেন"],["ٱللَّهُ","l-lahu","Then Allah sent down","আল্লাহ"],["سَكِينَتَهُۥ","sakīnatahu","His tranquility","প্রশান্তি তাঁর"],["عَلَيْهِ","‘alayhi","upon him","উপর তার"],["وَأَيَّدَهُۥ","wa-ayyadahu","and supported him","ও শক্তিশালী করলেন তাকে"],["بِجُنُودٍۢ","bijunūdin","with forces","দিয়ে (এমন সব) সৈন্য"],["لَّمْ","lam","which you did not see","নি"],["تَرَوْهَا","tarawhā","which you did not see","যাদেরকে তোমরা দেখতে পাও"],["وَجَعَلَ","waja‘ala","and made","ও করলেন"],["كَلِمَةَ","kalimata","(the) word","কথাকে"],["ٱلَّذِينَ","alladhīna","(of) those who","(তাদের) যারা"],["كَفَرُوا۟","kafarū","disbelieved","অবিশ্বাস করেছিলো"],["ٱلسُّفْلَىٰ ۗ","l-suf'lā","the lowest","নিচু"],["وَكَلِمَةُ","wakalimatu","while (the) Word","ও (করলেন) কথা"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["هِىَ","hiya","it (is)","তা"],["ٱلْعُلْيَا ۗ","l-‘ul'yā","the highest","সমুন্নত"],["وَٱللَّهُ","wal-lahu","And Allah","ও আল্লাহ"],["عَزِيزٌ","‘azīzun","(is) All-Mighty","মহাপরাক্রমশালী"],["حَكِيمٌ","ḥakīmun","All-Wise","মহাবিজ্ঞ"]],"t":"إِلَّا تَ<k>نصُ</>رُوهُ فَقَ<q>دْ</> نَصَرَهُ <h>ٱ</>للَّهُ إِذْ أَخْرَجَهُ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> ثَانِىَ <h>ٱ</>ثْنَيْنِ إِذْ هُمَا فِى <h>ٱ</>لْغَارِ إِذْ يَقُولُ لِ<m>صَٰ</>حِبِ<m>هِۦ</> لَا تَحْزَنْ إِ<g>نَّ</> <h>ٱ</>للَّهَ مَعَنَا ۖ فَأَ<k>نزَ</>لَ <h>ٱ</>للَّهُ سَكِينَتَهُ<m>ۥ</> عَلَيْهِ وَأَيَّدَهُ<m>ۥ</> بِجُنُو<w>دٍۢ لَّ</>مْ تَرَوْهَا وَجَعَلَ كَلِمَةَ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> <h>ٱ</><l>ل</>سُّفْلَىٰ ۗ وَكَلِمَةُ <h>ٱ</>للَّهِ هِىَ <h>ٱ</>لْعُلْيَا ۗ وَ<h>ٱ</>للَّهُ عَزِيزٌ حَ<p>كِي</>مٌ"},{"n":41,"w":[["ٱنفِرُوا۟","infirū","Go forth","তোমরা বের হও"],["خِفَافًۭا","khifāfan","light","হালকা অবস্থায় (থাকো)"],["وَثِقَالًۭا","wathiqālan","or heavy","কিংবা ভারী অবস্থায়"],["وَجَـٰهِدُوا۟","wajāhidū","and strive","এবং তোমরা জিহাদ করো"],["بِأَمْوَٰلِكُمْ","bi-amwālikum","with your wealth","দিয়ে ধনসম্পদ তোমাদের"],["وَأَنفُسِكُمْ","wa-anfusikum","and your lives","ও জান-প্রাণ (দিয়ে) তোমাদের"],["فِى","fī","in","মধ্যে"],["سَبِيلِ","sabīli","(the) way","পথের"],["ٱللَّهِ ۚ","l-lahi","(of) Allah","আল্লাহর"],["ذَٰلِكُمْ","dhālikum","That","(তোমাদের) সেটাই"],["خَيْرٌۭ","khayrun","(is) better","উত্তম"],["لَّكُمْ","lakum","for you","জন্যে তোমাদের"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you","তোমরা ছিলে"],["تَعْلَمُونَ","ta‘lamūna","know","জানতে"]],"t":"ٱ<k>نفِ</>رُو<s>ا۟</> خِفَا<d>فًۭا وَ</>ثِقَالًۭ<d>ا وَ</><m>جَٰ</>هِدُو<s>ا۟</> بِأَمْ<m>وَٰ</>لِكُمْ وَأَ<k>نفُ</>سِكُمْ فِى سَبِيلِ <h>ٱ</>للَّهِ ۚ <m>ذَٰ</>لِكُمْ خَيْ<w>رٌۭ لَّ</>كُمْ إِ<k>ن كُنتُ</>مْ تَعْلَ<p>مُو</>نَ"},{"n":42,"w":[["لَوْ","law","If","যদি"],["كَانَ","kāna","it had been","হতো"],["عَرَضًۭا","‘araḍan","a gain","সম্পদ লাভের আশা"],["قَرِيبًۭا","qarīban","near","নিকটবর্তী (সহজলভ্য)"],["وَسَفَرًۭا","wasafaran","and a journey","ও ভ্রমণ"],["قَاصِدًۭا","qāṣidan","easy","সুগম"],["لَّٱتَّبَعُوكَ","la-ittaba‘ūka","surely they (would) have followed you","অবশ্যই তোমাকে তারা অনুসরণ করতো"],["وَلَـٰكِنۢ","walākin","but","কিন্তু"],["بَعُدَتْ","ba‘udat","was long","দীর্ঘ লাগলো"],["عَلَيْهِمُ","‘alayhimu","for them","কাছে তাদের"],["ٱلشُّقَّةُ ۚ","l-shuqatu","the distance","কষ্টসাধ্য যাত্রাপথ"],["وَسَيَحْلِفُونَ","wasayaḥlifūna","And they will swear","ও (এখন)অচিরেই তারা শপথ করে বলবে"],["بِٱللَّهِ","bil-lahi","by Allah","নামে আল্লাহর"],["لَوِ","lawi","If","\"যদি"],["ٱسْتَطَعْنَا","is'taṭa‘nā","we were able","পারতাম আমরা"],["لَخَرَجْنَا","lakharajnā","certainly we (would) have come forth","অবশ্যই বের হতাম আমরা"],["مَعَكُمْ","ma‘akum","with you","সাথে তোমাদের\""],["يُهْلِكُونَ","yuh'likūna","They destroy","(আসলে) তারা ধ্বংস করছে"],["أَنفُسَهُمْ","anfusahum","their own selves","নিজেদেরকে তাদের"],["وَٱللَّهُ","wal-lahu","and Allah","এবং আল্লাহ"],["يَعْلَمُ","ya‘lamu","knows","জানেন"],["إِنَّهُمْ","innahum","(that) indeed, they","নিশ্চয়ই তারা"],["لَكَـٰذِبُونَ","lakādhibūna","(are) surely liars","অবশ্যই মিথ্যাবাদী"]],"t":"لَوْ كَانَ عَرَ<k>ضًۭا قَ</>رِي<d>بًۭا وَ</>سَفَ<k>رًۭا قَ</>اصِ<w>دًۭا لَّ</><h>ٱ</>تَّبَعُوكَ وَ<m>لَٰ</><i>كِنۢ بَ</>عُدَتْ عَلَيْهِمُ <h>ٱ</><l>ل</>شُّقَّةُ ۚ وَسَيَحْلِفُونَ بِ<h>ٱ</>للَّهِ لَوِ <h>ٱ</>سْتَطَعْنَا لَخَرَ<q>جْ</>نَا مَعَكُمْ يُهْلِكُونَ أَ<k>نفُ</>سَهُمْ وَ<h>ٱ</>للَّهُ يَعْلَمُ إِ<g>نَّ</>هُمْ لَ<m>كَٰ</>ذِ<p>بُو</>نَ"},{"n":43,"w":[["عَفَا","‘afā","(May) Allah forgive","ক্ষমা করেছেন"],["ٱللَّهُ","l-lahu","(May) Allah forgive","আল্লাহ"],["عَنكَ","‘anka","you","বিষয়কে তোমার"],["لِمَ","lima","Why (did)","কেন"],["أَذِنتَ","adhinta","you grant leave","অব্যহতি দিলে"],["لَهُمْ","lahum","to them","তাদেরকে"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["يَتَبَيَّنَ","yatabayyana","(became) evident","সুস্পষ্ট হয়ে যায়"],["لَكَ","laka","to you","কাছে তোমার"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["صَدَقُوا۟","ṣadaqū","were truthful","সত্য বলেছে"],["وَتَعْلَمَ","wata‘lama","and you knew","ও তুমি জানতে পারো"],["ٱلْكَـٰذِبِينَ","l-kādhibīna","the liars","মিথ্যাবাদীদেরকে"]],"t":"عَفَا <h>ٱ</>للَّهُ عَ<k>نكَ</> لِمَ أَذِ<k>نتَ</> لَهُمْ حَتَّىٰ يَتَبَيَّنَ لَكَ <h>ٱ</>لَّذِينَ صَدَقُو<s>ا۟</> وَتَعْلَمَ <h>ٱ</>لْ<m>كَٰ</>ذِ<p>بِي</>نَ"},{"n":44,"w":[["لَا","lā","(Would) not ask your permission","না"],["يَسْتَـْٔذِنُكَ","yastadhinuka","(Would) not ask your permission","তোমার কাছে অব্যহতি চায়"],["ٱلَّذِينَ","alladhīna","those who","(তারা) যারা"],["يُؤْمِنُونَ","yu'minūna","believe","ঈমান আনে"],["بِٱللَّهِ","bil-lahi","in Allah","উপর আল্লাহর"],["وَٱلْيَوْمِ","wal-yawmi","and the Day","ও দিনে"],["ٱلْـَٔاخِرِ","l-ākhiri","the Last","আখেরাতের (উপর)"],["أَن","an","that","যে"],["يُجَـٰهِدُوا۟","yujāhidū","they strive","তারা জিহাদ করবে (না)"],["بِأَمْوَٰلِهِمْ","bi-amwālihim","with their wealth","দিয়ে ধনসম্পদ তাদের"],["وَأَنفُسِهِمْ ۗ","wa-anfusihim","and their lives","ও জান-প্রাণ তাদের (দিয়ে)"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["عَلِيمٌۢ","‘alīmun","(is) All-Knower","খুব জানেন"],["بِٱلْمُتَّقِينَ","bil-mutaqīna","of the righteous","সম্পর্কে মুত্তাকীদের"]],"t":"لَا يَسْتَـْٔذِنُكَ <h>ٱ</>لَّذِينَ يُؤْمِنُونَ بِ<h>ٱ</>للَّهِ وَ<h>ٱ</>لْيَوْمِ <h>ٱ</>لْءَاخِرِ <d>أَن يُ</><m>جَٰ</>هِدُو<s>ا۟</> بِأَمْ<m>وَٰ</>لِهِمْ وَأَ<k>نفُ</>سِهِمْ ۗ وَ<h>ٱ</>للَّهُ عَلِي<i>مٌۢ بِ</><h>ٱ</>لْمُتَّ<p>قِي</>نَ"},{"n":45,"w":[["إِنَّمَا","innamā","Only","প্রকৃতপক্ষে"],["يَسْتَـْٔذِنُكَ","yastadhinuka","ask your leave","তোমার কাছে অব্যহতি চায়"],["ٱلَّذِينَ","alladhīna","those who","(তারাই) যারা"],["لَا","lā","(do) not","না"],["يُؤْمِنُونَ","yu'minūna","believe","ঈমান আনে"],["بِٱللَّهِ","bil-lahi","in Allah","উপর আল্লাহর"],["وَٱلْيَوْمِ","wal-yawmi","and the Day","ও দিনে"],["ٱلْـَٔاخِرِ","l-ākhiri","the Last","আখেরাতের (উপর)"],["وَٱرْتَابَتْ","wa-ir'tābat","and (are in) doubts","এবং সন্দেহে পড়েছে"],["قُلُوبُهُمْ","qulūbuhum","their hearts","অন্তর তাদের"],["فَهُمْ","fahum","so they","তাই তারা"],["فِى","fī","in","মধ্যে"],["رَيْبِهِمْ","raybihim","their doubts","সন্দেহের তাদের"],["يَتَرَدَّدُونَ","yataraddadūna","they waver","তারা দ্বিধাগ্রস্ত হচ্ছে"]],"t":"إِ<g>نَّ</>مَا يَسْتَـْٔذِنُكَ <h>ٱ</>لَّذِينَ لَا يُؤْمِنُونَ بِ<h>ٱ</>للَّهِ وَ<h>ٱ</>لْيَوْمِ <h>ٱ</>لْءَاخِرِ وَ<h>ٱ</>رْتَابَتْ قُلُوبُهُمْ فَهُمْ فِى رَيْبِهِمْ يَتَرَدَّ<p>دُو</>نَ"},{"n":46,"w":[["۞ وَلَوْ","walaw","And if","এবং যদি"],["أَرَادُوا۟","arādū","they had wished","তারা ইচ্ছা করতো"],["ٱلْخُرُوجَ","l-khurūja","(to) go forth","বের হওয়ার"],["لَأَعَدُّوا۟","la-a‘addū","surely they (would) have prepared","তারা অবশ্যই প্রস্তুতি নিতো"],["لَهُۥ","lahu","for it","জন্যে তার"],["عُدَّةًۭ","‘uddatan","(some) preparation","প্রস্তুতি (যথাযথ)"],["وَلَـٰكِن","walākin","But","কিন্তু"],["كَرِهَ","kariha","Allah disliked","অপছন্দ করেছেন"],["ٱللَّهُ","l-lahu","Allah disliked","আল্লাহ"],["ٱنۢبِعَاثَهُمْ","inbi‘āthahum","their being sent","অভিযাত্রা তাদের"],["فَثَبَّطَهُمْ","fathabbaṭahum","so He made them lag behind","অতঃপর বিরত রাখলেন তাদেরকে"],["وَقِيلَ","waqīla","and it was said","এবং বলা হলো"],["ٱقْعُدُوا۟","uq'‘udū","Sit","\"তোমরা বসে থাকো"],["مَعَ","ma‘a","with","সাথে"],["ٱلْقَـٰعِدِينَ","l-qā‘idīna","those who sit","বসে থাকা লোকদের\""]],"t":"۞ وَلَوْ أَرَادُو<s>ا۟</> <h>ٱ</>لْخُرُوجَ لَأَعَدُّو<s>ا۟</> لَهُ<m>ۥ</> عُدَّ<d>ةًۭ وَ</><m>لَٰ</>كِ<k>ن كَ</>رِهَ <h>ٱ</>للَّهُ <h>ٱ</><i>نۢبِ</>عَاثَهُمْ فَثَبَّطَهُمْ وَقِيلَ <h>ٱ</><q>قْ</>عُدُو<s>ا۟</> مَعَ <h>ٱ</>لْ<m>قَٰ</>عِ<p>دِي</>نَ"},{"n":47,"w":[["لَوْ","law","If","যদি"],["خَرَجُوا۟","kharajū","they (had) gone forth","তারা বের হতো"],["فِيكُم","fīkum","with you","মধ্যে তোমাদের"],["مَّا","mā","not","না"],["زَادُوكُمْ","zādūkum","they (would) have increased you","তোমাদের মধ্যে বাড়াতো (আর কিছু)"],["إِلَّا","illā","except","এ ছাড়া"],["خَبَالًۭا","khabālan","(in) confusion","বিভ্রান্তি"],["وَلَأَوْضَعُوا۟","wala-awḍa‘ū","and would have been active","এবং অবশ্যই তারা ঘোড়া দৌড়াতো (ছুটাছুটি করতো)"],["خِلَـٰلَكُمْ","khilālakum","in your midst","মাঝে তোমাদের"],["يَبْغُونَكُمُ","yabghūnakumu","seeking (for) you","তোমাদের মধ্যে তারা চাইতো"],["ٱلْفِتْنَةَ","l-fit'nata","dissension","বিপর্যয় (সৃষ্টি করতে)"],["وَفِيكُمْ","wafīkum","And among you (are some)","এবং মধ্যে তোমাদের (আছে)"],["سَمَّـٰعُونَ","sammā‘ūna","who would have listened","গুপ্তচর (কান দেয়ার লোক)"],["لَهُمْ ۗ","lahum","to them","জন্যে তাদের"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["عَلِيمٌۢ","‘alīmun","(is) All-Knower","খুব জানেন"],["بِٱلظَّـٰلِمِينَ","bil-ẓālimīna","of the wrongdoers","সম্পর্কে সীমালঙ্ঘনকারীদের"]],"t":"لَوْ خَرَجُو<s>ا۟</> فِي<y>كُم مَّ</>ا زَادُوكُمْ إِلَّا خَبَالًۭ<d>ا وَ</>لَأَوْضَعُو<s>ا۟</> خِ<m>لَٰ</>لَكُمْ يَ<q>بْ</>غُونَكُمُ <h>ٱ</>لْفِتْنَةَ وَفِيكُمْ سَ<g>مَّٰ</>عُونَ لَهُمْ ۗ وَ<h>ٱ</>للَّهُ عَلِي<i>مٌۢ بِ</><h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":48,"w":[["لَقَدِ","laqadi","Verily","নিশ্চয়ই"],["ٱبْتَغَوُا۟","ib'taghawū","they had sought","তারা চেয়েছিলো"],["ٱلْفِتْنَةَ","l-fit'nata","dissension","বিপর্যয়(সৃষ্টি করতে)"],["مِن","min","before","থেকেও"],["قَبْلُ","qablu","before","পূর্ব"],["وَقَلَّبُوا۟","waqallabū","and had upset","এবং উল্টাপাল্টা করেছে"],["لَكَ","laka","for you","জন্যে তোমার"],["ٱلْأُمُورَ","l-umūra","the matters","কাজ-কর্ম"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["جَآءَ","jāa","came","এসেছে"],["ٱلْحَقُّ","l-ḥaqu","the truth","সত্য"],["وَظَهَرَ","waẓahara","and became manifest","ও বিজয়ী হয়েছে"],["أَمْرُ","amru","(the) Order of Allah","নির্দেশ"],["ٱللَّهِ","l-lahi","(the) Order of Allah","আল্লাহর"],["وَهُمْ","wahum","while they","অথচ তারা"],["كَـٰرِهُونَ","kārihūna","disliked (it)","অপছন্দকারী"]],"t":"لَقَدِ <h>ٱ</><q>بْ</>تَغَوُ<s>ا۟</> <h>ٱ</>لْفِتْنَةَ مِ<k>ن قَ</><q>بْ</>لُ وَقَلَّبُو<s>ا۟</> لَكَ <h>ٱ</>لْأُمُورَ حَتَّىٰ <o>جَآ</>ءَ <h>ٱ</>لْحَقُّ وَظَهَرَ أَمْرُ <h>ٱ</>للَّهِ وَهُمْ <m>كَٰ</>رِ<p>هُو</>نَ"},{"n":49,"w":[["وَمِنْهُم","wamin'hum","And among them","ও মধ্যে তাদের(এমনও আছে)"],["مَّن","man","(is he) who","যে"],["يَقُولُ","yaqūlu","says","বলে"],["ٱئْذَن","i'dhan","Grant me leave","\"অব্যাহতি দিন"],["لِّى","lī","Grant me leave","\"আমাকে"],["وَلَا","walā","and (do) not","এবং না"],["تَفْتِنِّىٓ ۚ","taftinnī","put me to trial","আমাকে বিপর্যয়ে ফেলবেন\""],["أَلَا","alā","Surely","সাবধান (শুনে রাখো)"],["فِى","fī","in","মধ্যে"],["ٱلْفِتْنَةِ","l-fit'nati","the trial","বিপর্যয়ের"],["سَقَطُوا۟ ۗ","saqaṭū","they have fallen","তারা পড়েছে"],["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["جَهَنَّمَ","jahannama","Hell","জাহান্নাম"],["لَمُحِيطَةٌۢ","lamuḥīṭatun","(will) surely surround","অবশ্যই পরিবেষ্টনকারী"],["بِٱلْكَـٰفِرِينَ","bil-kāfirīna","the disbelievers","নিয়ে কাফেরদেরকে"]],"t":"وَمِنْ<y>هُم مَّ</><d>ن يَ</>قُولُ <h>ٱ</>ئْ<w>ذَن لِّ</>ى وَلَا تَفْتِ<g>نِّ</><o>ىٓ ۚ</> أَلَا فِى <h>ٱ</>لْفِتْنَةِ سَقَطُو<s>ا۟ ۗ</> وَإِ<g>نَّ</> جَهَ<g>نَّ</>مَ لَمُحِيطَ<i>ةٌۢ بِ</><h>ٱ</>لْ<m>كَٰ</>فِ<p>رِي</>نَ"},{"n":50,"w":[["إِن","in","If","যদি"],["تُصِبْكَ","tuṣib'ka","befalls you","তোমার পৌঁছে"],["حَسَنَةٌۭ","ḥasanatun","good","কোনো কল্যাণ"],["تَسُؤْهُمْ ۖ","tasu'hum","it distresses them","তা পীড়া দেয় তাদেরকে"],["وَإِن","wa-in","but if","এবং যদি"],["تُصِبْكَ","tuṣib'ka","befalls you","তোমার পৌঁছে"],["مُصِيبَةٌۭ","muṣībatun","a calamity","কোনো বিপদ"],["يَقُولُوا۟","yaqūlū","they say","তারা বলে"],["قَدْ","qad","Verily","\"নিশ্চয়ই"],["أَخَذْنَآ","akhadhnā","we took","আমরা (সামলে নিয়েছি)"],["أَمْرَنَا","amranā","our matter","কাজ আমাদের"],["مِن","min","before","থেকেই\""],["قَبْلُ","qablu","before","পূর্ব\""],["وَيَتَوَلَّوا۟","wayatawallaw","And they turn away","ও তারা ফিরে যায়"],["وَّهُمْ","wahum","while they","এ অবস্থায় যে তারা"],["فَرِحُونَ","fariḥūna","(are) rejoicing","উৎফুল্ল"]],"t":"إِ<k>ن تُ</>صِ<q>بْ</>كَ حَسَنَ<k>ةٌۭ تَ</>سُؤْهُمْ ۖ وَإِ<k>ن تُ</>صِ<q>بْ</>كَ مُصِيبَ<d>ةٌۭ يَ</>قُولُو<s>ا۟</> قَ<q>دْ</> أَخَذْ<o>نَآ</> أَمْرَنَا مِ<k>ن قَ</><q>بْ</>لُ وَيَتَوَلَّو<s>ا۟</> وَّهُمْ فَرِ<p>حُو</>نَ"},{"n":51,"w":[["قُل","qul","Say","বলো"],["لَّن","lan","Never","\"কখনও না"],["يُصِيبَنَآ","yuṣībanā","will befall us","কাছে পৌঁছুবে আমাদের"],["إِلَّا","illā","except","এ ছাড়া"],["مَا","mā","what","যা"],["كَتَبَ","kataba","Allah has decreed","নির্ধারিত করেছেন"],["ٱللَّهُ","l-lahu","Allah has decreed","আল্লাহ"],["لَنَا","lanā","for us","জন্যে আমাদের"],["هُوَ","huwa","He","তিনিই"],["مَوْلَىٰنَا ۚ","mawlānā","(is) our Protector","অভিভাবক আমাদের\""],["وَعَلَى","wa‘alā","And on","এবং উপর"],["ٱللَّهِ","l-lahi","Allah","আল্লাহরই"],["فَلْيَتَوَكَّلِ","falyatawakkali","[so] let the believers put (their) trust","নির্ভর করা উচিৎ"],["ٱلْمُؤْمِنُونَ","l-mu'minūna","[so] let the believers put (their) trust","মু'মিনদের"]],"t":"قُل <d>لَّن يُ</>صِيبَ<o>نَآ</> إِلَّا مَا كَتَبَ <h>ٱ</>للَّهُ لَنَا هُوَ مَوْلَ<m>ىٰ</>نَا ۚ وَعَلَى <h>ٱ</>للَّهِ فَلْيَتَوَكَّلِ <h>ٱ</>لْمُؤْمِ<p>نُو</>نَ"},{"n":52,"w":[["قُلْ","qul","Say","বলো"],["هَلْ","hal","Do","\"কি"],["تَرَبَّصُونَ","tarabbaṣūna","you await","তোমরা অপেক্ষা করছো"],["بِنَآ","binā","for us","জন্যে আমাদের"],["إِلَّآ","illā","except","এ ছাড়া"],["إِحْدَى","iḥ'dā","one","একটি"],["ٱلْحُسْنَيَيْنِ ۖ","l-ḥus'nayayni","(of) the two best (things)","দুই কল্যাণের (অর্থাৎ শাহাদাত বা বিজয়)"],["وَنَحْنُ","wanaḥnu","while we","এবং আমরা"],["نَتَرَبَّصُ","natarabbaṣu","[we] await","অপেক্ষা করছি"],["بِكُمْ","bikum","for you","জন্যে তোমাদের"],["أَن","an","that","যে"],["يُصِيبَكُمُ","yuṣībakumu","Allah will afflict you","কাছে পৌঁছাবেন তোমাদের"],["ٱللَّهُ","l-lahu","Allah will afflict you","আল্লাহ"],["بِعَذَابٍۢ","bi‘adhābin","with a punishment","শাস্তি"],["مِّنْ","min","from","হতে"],["عِندِهِۦٓ","‘indihi","[near] Him","তাঁর নিজের নিকট"],["أَوْ","aw","or","অথবা"],["بِأَيْدِينَا ۖ","bi-aydīnā","by our hands","দিয়ে হাত আমাদের(শাস্তি দিবেন)"],["فَتَرَبَّصُوٓا۟","fatarabbaṣū","So wait","তাই তোমরা অপেক্ষা করো"],["إِنَّا","innā","indeed, we","নিশ্চয়ই আমরা"],["مَعَكُم","ma‘akum","with you","সাথে তোমাদের"],["مُّتَرَبِّصُونَ","mutarabbiṣūna","(are) waiting","অপেক্ষাকারী\""]],"t":"قُلْ هَلْ تَرَبَّصُونَ بِ<o>نَآ</> إِ<o>لَّآ</> إِحْدَى <h>ٱ</>لْحُسْنَيَيْنِ ۖ وَنَحْنُ نَتَرَبَّصُ بِكُمْ <d>أَن يُ</>صِيبَكُمُ <h>ٱ</>للَّهُ بِعَذَا<d>بٍۢ مِّ</>نْ عِ<k>ندِ</><o>هِۦٓ</> أَوْ بِأَيْدِينَا ۖ فَتَرَبَّ<o>صُوٓ</><s>ا۟</> إِ<g>نَّ</>ا مَعَ<y>كُم مُّ</>تَرَبِّ<p>صُو</>نَ"},{"n":53,"w":[["قُلْ","qul","Say","বলো"],["أَنفِقُوا۟","anfiqū","Spend","\"তোমরা ব্যয় করো"],["طَوْعًا","ṭaw‘an","willingly","ইচ্ছায়"],["أَوْ","aw","or","অথবা"],["كَرْهًۭا","karhan","unwillingly","অনিচ্ছায়"],["لَّن","lan","never","কখনও না"],["يُتَقَبَّلَ","yutaqabbala","will be accepted","গ্রহণ করা হবে (তা)"],["مِنكُمْ ۖ","minkum","from you","হতে তোমাদের"],["إِنَّكُمْ","innakum","Indeed, you","নিশ্চয়ই তোমরা"],["كُنتُمْ","kuntum","[you] are","হলে"],["قَوْمًۭا","qawman","a people","সম্প্রদায়"],["فَـٰسِقِينَ","fāsiqīna","defiantly disobedient","সত্যত্যাগী\""]],"t":"قُلْ أَ<k>نفِ</>قُو<s>ا۟</> طَوْعًا أَوْ كَرْ<w>هًۭا لَّ</><d>ن يُ</>تَقَبَّلَ مِ<k>نكُ</>مْ ۖ إِ<g>نَّ</>كُمْ كُ<k>نتُ</>مْ قَوْ<k>مًۭا فَٰ</>سِ<p>قِي</>نَ"},{"n":54,"w":[["وَمَا","wamā","And not","এবং না"],["مَنَعَهُمْ","mana‘ahum","prevents them","নিষেধ করা হয়েছে তাদেরকে"],["أَن","an","that","যে"],["تُقْبَلَ","tuq'bala","is accepted","গ্রহণ করা হবে"],["مِنْهُمْ","min'hum","from them","থেকে তাদের"],["نَفَقَـٰتُهُمْ","nafaqātuhum","their contributions","অর্থ সাহায্য তাদের"],["إِلَّآ","illā","except","এ ছাড়া (অন্য কোনো কারণে)"],["أَنَّهُمْ","annahum","that they","যে তারা"],["كَفَرُوا۟","kafarū","disbelieve","অবিশ্বাস করেছে"],["بِٱللَّهِ","bil-lahi","in Allah","উপর আল্লাহর"],["وَبِرَسُولِهِۦ","wabirasūlihi","and in His Messenger","ও উপর রাসূলের তাঁর"],["وَلَا","walā","and not","এবং না"],["يَأْتُونَ","yatūna","they come","তারা আসে"],["ٱلصَّلَوٰةَ","l-ṣalata","(to) the prayer","সালাতে"],["إِلَّا","illā","except","ছাড়া"],["وَهُمْ","wahum","while they","এমতাবস্থায় যে তারা"],["كُسَالَىٰ","kusālā","(are) lazy","অলস"],["وَلَا","walā","and not","এবং না"],["يُنفِقُونَ","yunfiqūna","they spend","তারা ব্যয় করে"],["إِلَّا","illā","except","ছাড়া"],["وَهُمْ","wahum","while they","এমতাবস্থায় যে তারা"],["كَـٰرِهُونَ","kārihūna","(are) unwilling","অনিচ্ছুক"]],"t":"وَمَا مَنَعَهُمْ أَ<k>ن تُ</><q>قْ</>بَلَ مِنْهُمْ نَفَ<m>قَٰ</>تُهُمْ إِ<o>لَّآ</> أَ<g>نَّ</>هُمْ كَفَرُو<s>ا۟</> بِ<h>ٱ</>للَّهِ وَبِرَسُولِ<m>هِۦ</> وَلَا يَأْتُونَ <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةَ إِلَّا وَهُمْ كُسَالَىٰ وَلَا يُ<k>نفِ</>قُونَ إِلَّا وَهُمْ <m>كَٰ</>رِ<p>هُو</>نَ"},{"n":55,"w":[["فَلَا","falā","So (let) not","অতএব না"],["تُعْجِبْكَ","tu‘'jib'ka","impress you","তোমাকে বিস্মিত করে (যেন)"],["أَمْوَٰلُهُمْ","amwāluhum","their wealth","ধনসম্পদ তাদের"],["وَلَآ","walā","and not","ও না"],["أَوْلَـٰدُهُمْ ۚ","awlāduhum","their children","সন্তান-সন্ততি তাদের"],["إِنَّمَا","innamā","Only","প্রকৃতপক্ষে"],["يُرِيدُ","yurīdu","Allah intends","চান"],["ٱللَّهُ","l-lahu","Allah intends","আল্লাহ"],["لِيُعَذِّبَهُم","liyu‘adhibahum","to punish them","যেন শাস্তি দেন তাদের"],["بِهَا","bihā","with it","দিয়ে তা"],["فِى","fī","in","মধ্যে"],["ٱلْحَيَوٰةِ","l-ḥayati","the life","জীবনে"],["ٱلدُّنْيَا","l-dun'yā","(of) the world","পার্থিব"],["وَتَزْهَقَ","watazhaqa","and should depart","ও চলে যায়"],["أَنفُسُهُمْ","anfusuhum","their souls","অাত্মা তাদের"],["وَهُمْ","wahum","while they","এমতাবস্থায় যে তারা"],["كَـٰفِرُونَ","kāfirūna","(are) disbelievers","কাফের"]],"t":"فَلَا تُعْجِ<q>بْ</>كَ أَمْ<m>وَٰ</>لُهُمْ وَ<o>لَآ</> أَوْ<m>لَٰ</>دُهُمْ ۚ إِ<g>نَّ</>مَا يُرِيدُ <h>ٱ</>للَّهُ لِيُعَذِّبَ<f>هُم بِ</>هَا فِى <h>ٱ</>لْحَيَ<s>وٰ</>ةِ <h>ٱ</><l>ل</>دُّنْيَا وَتَزْهَقَ أَ<k>نفُ</>سُهُمْ وَهُمْ <m>كَٰ</>فِ<p>رُو</>نَ"},{"n":56,"w":[["وَيَحْلِفُونَ","wayaḥlifūna","And they swear","এবং তারা শপথ করে বলে"],["بِٱللَّهِ","bil-lahi","by Allah","নামে আল্লাহর"],["إِنَّهُمْ","innahum","indeed, they","নিশ্চয়ই তারা"],["لَمِنكُمْ","laminkum","surely (are) of you","অবশ্যই অন্তর্ভুক্ত তোমাদের"],["وَمَا","wamā","while not","কিন্ত না"],["هُم","hum","they","তারা"],["مِّنكُمْ","minkum","(are) of you","অন্তর্ভুক্ত তোমাদের"],["وَلَـٰكِنَّهُمْ","walākinnahum","but they","কিন্তু তারা"],["قَوْمٌۭ","qawmun","(are) a people","(এমন) সম্প্রদায়"],["يَفْرَقُونَ","yafraqūna","(who) are afraid","(যারা) ভয় করে"]],"t":"وَيَحْلِفُونَ بِ<h>ٱ</>للَّهِ إِ<g>نَّ</>هُمْ لَمِ<k>نكُ</>مْ وَمَا <y>هُم مِّ</><k>نكُ</>مْ وَ<m>لَٰ</>كِ<g>نَّ</>هُمْ قَوْ<d>مٌۭ يَ</>فْرَ<p>قُو</>نَ"},{"n":57,"w":[["لَوْ","law","If","যদি"],["يَجِدُونَ","yajidūna","they could find","তারা পেতো"],["مَلْجَـًٔا","malja-an","a refuge","আশ্রয়স্থল"],["أَوْ","aw","or","অথবা"],["مَغَـٰرَٰتٍ","maghārātin","caves","গুহা"],["أَوْ","aw","or","অথবা"],["مُدَّخَلًۭا","muddakhalan","a place to enter","ঢোকার জায়গা"],["لَّوَلَّوْا۟","lawallaw","surely, they would turn","অবশ্যই তারা ফিরে যেতো"],["إِلَيْهِ","ilayhi","to it","সেদিকে"],["وَهُمْ","wahum","and they","এ অবস্থায় যে তারা"],["يَجْمَحُونَ","yajmaḥūna","run wild","দ্রুত ছুটে যেতো"]],"t":"لَوْ يَجِدُونَ مَلْجَـًٔا أَوْ مَ<m>غَٰرَٰ</>تٍ أَوْ مُدَّخَلًۭ<w>ا لَّ</>وَلَّوْ<s>ا۟</> إِلَيْهِ وَهُمْ يَ<q>جْ</>مَ<p>حُو</>نَ"},{"n":58,"w":[["وَمِنْهُم","wamin'hum","And among them","এবং মধ্যে (আছে) তাদের"],["مَّن","man","(is he) who","কেউ কেউ"],["يَلْمِزُكَ","yalmizuka","criticizes you","তোমাকে দোষারোপ করবে"],["فِى","fī","concerning","ব্যাপারে"],["ٱلصَّدَقَـٰتِ","l-ṣadaqāti","the charities","সদকা (বণ্টনের)"],["فَإِنْ","fa-in","Then if","কিন্তু যদি"],["أُعْطُوا۟","u‘'ṭū","they are given","তাদের দেয়া হয়"],["مِنْهَا","min'hā","from it","থেকে তা (কিছু)"],["رَضُوا۟","raḍū","they are pleased","তারা খুশি হয়"],["وَإِن","wa-in","but if","আর যদি"],["لَّمْ","lam","not","না"],["يُعْطَوْا۟","yu‘'ṭaw","they are given","তাদের দেয়া হয়"],["مِنْهَآ","min'hā","from it","হতে তা (কিছুই)"],["إِذَا","idhā","then","তখন"],["هُمْ","hum","they","তারা"],["يَسْخَطُونَ","yaskhaṭūna","(are) enraged","অসন্তোষ হয়ে যায়"]],"t":"وَمِنْ<y>هُم مَّ</><d>ن يَ</>لْمِزُكَ فِى <h>ٱ</><l>ل</>صَّدَ<m>قَٰ</>تِ فَإِنْ أُعْطُو<s>ا۟</> مِنْهَا رَضُو<s>ا۟</> وَ<w>إِن لَّ</>مْ يُعْطَوْ<s>ا۟</> مِنْ<o>هَآ</> إِذَا هُمْ يَسْخَ<p>طُو</>نَ"},{"n":59,"w":[["وَلَوْ","walaw","And if","এবং যদি"],["أَنَّهُمْ","annahum","[that] they","তারা"],["رَضُوا۟","raḍū","(were) satisfied","খুশি হতো"],["مَآ","mā","(with) what","যা"],["ءَاتَىٰهُمُ","ātāhumu","Allah gave them","দিয়েছেন তাদের"],["ٱللَّهُ","l-lahu","Allah gave them","আল্লাহ"],["وَرَسُولُهُۥ","warasūluhu","and His Messenger","এবং রাসূল তাঁর"],["وَقَالُوا۟","waqālū","and said","এবং (উত্তম হতো যদি) তারা বলতো"],["حَسْبُنَا","ḥasbunā","Sufficient for us","\"আমাদের জন্যে যথেষ্ঠ"],["ٱللَّهُ","l-lahu","(is) Allah","আল্লাহই"],["سَيُؤْتِينَا","sayu'tīnā","Allah will give us","শীঘ্রই আমাদের দিবেন"],["ٱللَّهُ","l-lahu","Allah will give us","আল্লাহ"],["مِن","min","of","হতে"],["فَضْلِهِۦ","faḍlihi","His Bounty","অনুগ্রহ তাঁর"],["وَرَسُولُهُۥٓ","warasūluhu","and His Messenger","ও রাসূল তাঁর"],["إِنَّآ","innā","Indeed, we","নিশ্চয়ই আমরা"],["إِلَى","ilā","to","প্রতি"],["ٱللَّهِ","l-lahi","Allah","আল্লাহরই"],["رَٰغِبُونَ","rāghibūna","turn our hopes","অনুরক্ত\""]],"t":"وَلَوْ أَ<g>نَّ</>هُمْ رَضُو<s>ا۟</> <o>مَآ</> ءَاتَ<m>ىٰ</>هُمُ <h>ٱ</>للَّهُ وَرَسُولُهُ<m>ۥ</> وَقَالُو<s>ا۟</> حَسْبُنَا <h>ٱ</>للَّهُ سَيُؤْتِينَا <h>ٱ</>للَّهُ مِ<k>ن فَ</>ضْلِ<m>هِۦ</> وَرَسُولُهُ<o>ۥٓ</> إِ<g>نَّ</><o>آ</> إِلَى <h>ٱ</>للَّهِ <m>رَٰ</>غِ<p>بُو</>نَ"},{"n":60,"w":[["۞ إِنَّمَا","innamā","Only","প্রকৃতপক্ষে"],["ٱلصَّدَقَـٰتُ","l-ṣadaqātu","the charities","সদকা"],["لِلْفُقَرَآءِ","lil'fuqarāi","(are) for the poor","জন্যে ফকীরদের"],["وَٱلْمَسَـٰكِينِ","wal-masākīni","and the needy","ও অভাবগ্রস্তদের"],["وَٱلْعَـٰمِلِينَ","wal-‘āmilīna","and those who collect","ও কর্মচারীদের (জন্যে)"],["عَلَيْهَا","‘alayhā","them","উপর তার"],["وَٱلْمُؤَلَّفَةِ","wal-mu-alafati","and the ones inclined","ও আকৃষ্ট করতে (দীনের প্রতি)"],["قُلُوبُهُمْ","qulūbuhum","their hearts","অন্তর তাদের"],["وَفِى","wafī","and in","এবং ক্ষেত্রে"],["ٱلرِّقَابِ","l-riqābi","the (freeing of) the necks","গলদেশের মুক্তিদানের (অর্থাৎ দাস মুক্তির)"],["وَٱلْغَـٰرِمِينَ","wal-ghārimīna","and for those in debt","ও ঋণগ্রস্তদের (সাহায্যে)"],["وَفِى","wafī","and in","ও মধ্যে"],["سَبِيلِ","sabīli","(the) way","পথের"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর (অর্থাৎ জিহাদে)"],["وَٱبْنِ","wa-ib'ni","and the wayfarer ","ও ছেলে"],["ٱلسَّبِيلِ ۖ","l-sabīli","and the wayfarer ","পথের"],["فَرِيضَةًۭ","farīḍatan","an obligation","নির্ধারিত"],["مِّنَ","mina","from","হতে"],["ٱللَّهِ ۗ","l-lahi","Allah","আল্লাহর"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["عَلِيمٌ","‘alīmun","(is) All-Knowing","সবকিছুই জানেন"],["حَكِيمٌۭ","ḥakīmun","All-Wise","মহাবিজ্ঞ"]],"t":"۞ إِ<g>نَّ</>مَا <h>ٱ</><l>ل</>صَّدَ<m>قَٰ</>تُ لِلْفُقَ<o>رَآ</>ءِ وَ<h>ٱ</>لْمَ<m>سَٰ</>كِينِ وَ<h>ٱ</>لْ<m>عَٰ</>مِلِينَ عَلَيْهَا وَ<h>ٱ</>لْمُؤَلَّفَةِ قُلُوبُهُمْ وَفِى <h>ٱ</><l>ل</>رِّقَابِ وَ<h>ٱ</>لْ<m>غَٰ</>رِمِينَ وَفِى سَبِيلِ <h>ٱ</>للَّهِ وَ<h>ٱ</><q>بْ</>نِ <h>ٱ</><l>ل</>سَّبِيلِ ۖ فَرِيضَ<d>ةًۭ مِّ</>نَ <h>ٱ</>للَّهِ ۗ وَ<h>ٱ</>للَّهُ عَلِيمٌ حَ<p>كِي</>مٌۭ"},{"n":61,"w":[["وَمِنْهُمُ","wamin'humu","And among them","এবং মধ্যে (আছে) তাদের"],["ٱلَّذِينَ","alladhīna","(are) those who","যারা"],["يُؤْذُونَ","yu'dhūna","hurt","কষ্ট দেয়"],["ٱلنَّبِىَّ","l-nabiya","the Prophet","নাবীকে"],["وَيَقُولُونَ","wayaqūlūna","and they say","এবং তারা বলে"],["هُوَ","huwa","He is","\"সে"],["أُذُنٌۭ ۚ","udhunun","(all) ear","কান (কথা শুনে)\""],["قُلْ","qul","Say","বলো"],["أُذُنُ","udhunu","An ear","\"কান (কথা শুনা)"],["خَيْرٍۢ","khayrin","(of) goodness","উত্তম"],["لَّكُمْ","lakum","for you","জন্যে তোমাদের"],["يُؤْمِنُ","yu'minu","he believes","সে ঈমান রাখে"],["بِٱللَّهِ","bil-lahi","in Allah","উপর আল্লাহর"],["وَيُؤْمِنُ","wayu'minu","and believes","ও বিশ্বাস করে"],["لِلْمُؤْمِنِينَ","lil'mu'minīna","the believers","প্রতি মু'মিনদের"],["وَرَحْمَةٌۭ","waraḥmatun","and (is) a mercy","ও দয়া"],["لِّلَّذِينَ","lilladhīna","to those who","(তাদের) জন্যে যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["مِنكُمْ ۚ","minkum","among you","মধ্য থেকে তোমাদের\""],["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["يُؤْذُونَ","yu'dhūna","hurt","কষ্ট দেয়"],["رَسُولَ","rasūla","(the) Messenger","রাসূলকে"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["لَهُمْ","lahum","for them","জন্যে তাদের(রয়েছে)"],["عَذَابٌ","‘adhābun","(is) a punishment","শাস্তি"],["أَلِيمٌۭ","alīmun","painful","নিদারুণ"]],"t":"وَمِنْهُمُ <h>ٱ</>لَّذِينَ يُؤْذُونَ <h>ٱ</><l>ل</><g>نَّ</>بِىَّ وَيَقُولُونَ هُوَ أُذُ<k>نٌۭ ۚ قُ</>لْ أُذُنُ خَيْ<w>رٍۢ لَّ</>كُمْ يُؤْمِنُ بِ<h>ٱ</>للَّهِ وَيُؤْمِنُ لِلْمُؤْمِنِينَ وَرَحْمَ<w>ةٌۭ لِّ</>لَّذِينَ ءَامَنُو<s>ا۟</> مِ<k>نكُ</>مْ ۚ وَ<h>ٱ</>لَّذِينَ يُؤْذُونَ رَسُولَ <h>ٱ</>للَّهِ لَهُمْ عَذَابٌ أَ<p>لِي</>مٌۭ"},{"n":62,"w":[["يَحْلِفُونَ","yaḥlifūna","They swear","তারা শপথ করে"],["بِٱللَّهِ","bil-lahi","by Allah","নামে আল্লাহর"],["لَكُمْ","lakum","to you","জন্যে তোমাদের"],["لِيُرْضُوكُمْ","liyur'ḍūkum","to please you","যেন খুশি করতে পারে তোমাদেরকে"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["وَرَسُولُهُۥٓ","warasūluhu","and His Messenger","ও রাসূল তাঁর"],["أَحَقُّ","aḥaqqu","(have) more right","অধিকযোগ্য"],["أَن","an","that","যে"],["يُرْضُوهُ","yur'ḍūhu","they should please Him","তাকে সন্তুষ্ট করবে তারা"],["إِن","in","if","যদি"],["كَانُوا۟","kānū","they are","তারা হয়"],["مُؤْمِنِينَ","mu'minīna","believers","মু'মিন"]],"t":"يَحْلِفُونَ بِ<h>ٱ</>للَّهِ لَكُمْ لِيُرْضُوكُمْ وَ<h>ٱ</>للَّهُ وَرَسُولُهُ<o>ۥٓ</> أَحَقُّ <d>أَن يُ</>رْضُوهُ إِ<k>ن كَ</>انُو<s>ا۟</> مُؤْمِ<p>نِي</>نَ"},{"n":63,"w":[["أَلَمْ","alam","Do not","কি না"],["يَعْلَمُوٓا۟","ya‘lamū","they know","তারা জানে"],["أَنَّهُۥ","annahu","that he","নিশ্চিত যে"],["مَن","man","who","যে ব্যক্তি"],["يُحَادِدِ","yuḥādidi","opposes","বিরোধিতা করে"],["ٱللَّهَ","l-laha","Allah","আল্লাহর"],["وَرَسُولَهُۥ","warasūlahu","and His Messenger","ও রাসূলের তাঁর (সাথে)"],["فَأَنَّ","fa-anna","[then] that","অতঃপর নিশ্চয়ই"],["لَهُۥ","lahu","for him","জন্যে তার(রয়েছে)"],["نَارَ","nāra","(is the) Fire","আগুন"],["جَهَنَّمَ","jahannama","(of) Hell","জাহান্নামের"],["خَـٰلِدًۭا","khālidan","(will) abide forever","সে চিরস্থায়ী হবে"],["فِيهَا ۚ","fīhā","in it","মধ্যে তার"],["ذَٰلِكَ","dhālika","That","এটা"],["ٱلْخِزْىُ","l-khiz'yu","(is) the disgrace","অপমান"],["ٱلْعَظِيمُ","l-‘aẓīmu","the great","চরম"]],"t":"أَلَمْ يَعْلَ<o>مُوٓ</><s>ا۟</> أَ<g>نَّ</>هُ<m>ۥ</> <d>مَن يُ</>حَادِدِ <h>ٱ</>للَّهَ وَرَسُولَهُ<m>ۥ</> فَأَ<g>نَّ</> لَهُ<m>ۥ</> نَارَ جَهَ<g>نَّ</>مَ <m>خَٰ</>لِ<k>دًۭا فِ</>يهَا ۚ <m>ذَٰ</>لِكَ <h>ٱ</>لْخِزْىُ <h>ٱ</>لْعَ<p>ظِي</>مُ"},{"n":64,"w":[["يَحْذَرُ","yaḥdharu","Fear","ভয় করে"],["ٱلْمُنَـٰفِقُونَ","l-munāfiqūna","the hypocrites","মুনাফিকরা"],["أَن","an","lest","(যে) না"],["تُنَزَّلَ","tunazzala","be revealed","অবতীর্ণ হবে"],["عَلَيْهِمْ","‘alayhim","about them","সম্পর্কে তাদের"],["سُورَةٌۭ","sūratun","a Surah","কোনো সূরাহ"],["تُنَبِّئُهُم","tunabbi-uhum","informing them","জানিয়ে দিবে তাদেরকে"],["بِمَا","bimā","of what","ঐ বিষয় যা"],["فِى","fī","(is) in","মধ্যে (আছে)"],["قُلُوبِهِمْ ۚ","qulūbihim","their hearts","অন্তরে তাদের"],["قُلِ","quli","Say","বলো"],["ٱسْتَهْزِءُوٓا۟","is'tahziū","Mock","\"তোমরা ঠাট্টা করো"],["إِنَّ","inna","indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["مُخْرِجٌۭ","mukh'rijun","(will) bring forth","প্রকাশকারী"],["مَّا","mā","what","যা"],["تَحْذَرُونَ","taḥdharūna","you fear","তোমরা ভয় করছো\""]],"t":"يَحْذَرُ <h>ٱ</>لْمُ<m>نَٰ</>فِقُونَ أَ<k>ن تُ</>نَزَّلَ عَلَيْهِمْ سُورَ<k>ةٌۭ تُ</>نَبِّئُ<f>هُم بِ</>مَا فِى قُلُوبِهِمْ ۚ قُلِ <h>ٱ</>سْتَهْزِ<o>ءُوٓ</><s>ا۟</> إِ<g>نَّ</> <h>ٱ</>للَّهَ مُخْرِ<d>جٌۭ مَّ</>ا تَحْذَ<p>رُو</>نَ"},{"n":65,"w":[["وَلَئِن","wala-in","And if","এবং  অবশ্যই যদি"],["سَأَلْتَهُمْ","sa-altahum","you ask them","তুমি প্রশ্ন করো তাদের"],["لَيَقُولُنَّ","layaqūlunna","surely they will say","অবশ্যই তারা বলবেই"],["إِنَّمَا","innamā","Only","\"প্রকৃত পক্ষে"],["كُنَّا","kunnā","we were","আমরা ছিলো"],["نَخُوضُ","nakhūḍu","conversing","আলাপ-আলোচনা করতে"],["وَنَلْعَبُ ۚ","wanal‘abu","and playing","ও আমরা কৌতুক করতেছিলাম\""],["قُلْ","qul","Say","বলো"],["أَبِٱللَّهِ","abil-lahi","Is it Allah","\"কি সাথে আল্লাহর"],["وَءَايَـٰتِهِۦ","waāyātihi","and His Verses","ও আয়াতের তাঁর(সাথে)"],["وَرَسُولِهِۦ","warasūlihi","and His Messenger","ও রাসূলের তাঁর (সাথে)"],["كُنتُمْ","kuntum","(that) you were","তোমরা ছিলে"],["تَسْتَهْزِءُونَ","tastahziūna","mocking","তোমরা ঠাট্টা করতে\""]],"t":"وَلَئِ<k>ن سَ</>أَلْتَهُمْ لَيَقُولُ<g>نَّ</> إِ<g>نَّ</>مَا كُ<g>نَّ</>ا نَخُوضُ وَنَلْعَبُ ۚ قُلْ أَبِ<h>ٱ</>للَّهِ وَءَا<m>يَٰتِهِۦ</> وَرَسُولِ<m>هِۦ</> كُ<k>نتُ</>مْ تَسْتَهْزِ<p>ءُو</>نَ"},{"n":66,"w":[["لَا","lā","(Do) not","না"],["تَعْتَذِرُوا۟","ta‘tadhirū","make excuse","তোমরা অজুহাত পেশ করো"],["قَدْ","qad","verily","নিশ্চয়ই"],["كَفَرْتُم","kafartum","you have disbelieved","তোমার অবিশ্বাস করেছো"],["بَعْدَ","ba‘da","after","পরেও"],["إِيمَـٰنِكُمْ ۚ","īmānikum","your belief","তোমাদের ঈমান আনার"],["إِن","in","If","যদিও"],["نَّعْفُ","na‘fu","We pardon","ক্ষমা করি আমরা"],["عَن","‘an","[on]","হতে"],["طَآئِفَةٍۢ","ṭāifatin","a party","একদল (তার অপরাধ)"],["مِّنكُمْ","minkum","of you","মধ্য থেকে তোমাদের"],["نُعَذِّبْ","nu‘adhib","We will punish","আমরা (তবে)শাস্তি দিবো"],["طَآئِفَةًۢ","ṭāifatan","a party","(অপর)এক দলকে"],["بِأَنَّهُمْ","bi-annahum","because they","কারণ নিশ্চয়ই তারা"],["كَانُوا۟","kānū","were","ছিলো"],["مُجْرِمِينَ","muj'rimīna","criminals","অপরাধী"]],"t":"لَا تَعْتَذِرُو<s>ا۟</> قَ<q>دْ</> كَفَرْ<f>تُم بَ</>عْدَ إِي<m>مَٰ</>نِكُمْ ۚ <d>إِن نَّ</>عْفُ عَ<k>ن طَ</><o>آ</>ئِفَ<d>ةٍۢ مِّ</><k>نكُ</>مْ نُعَذِّ<q>بْ</> <o>طَآ</>ئِفَ<i>ةًۢ بِ</>أَ<g>نَّ</>هُمْ كَانُو<s>ا۟</> مُ<q>جْ</>رِ<p>مِي</>نَ"},{"n":67,"w":[["ٱلْمُنَـٰفِقُونَ","al-munāfiqūna","The hypocrite men","মুনাফেক পুরুষ"],["وَٱلْمُنَـٰفِقَـٰتُ","wal-munāfiqātu","and the hypocrite women","ও মুনাফেক নারী"],["بَعْضُهُم","ba‘ḍuhum","some of them","একে তারা"],["مِّنۢ","min","(are) of","অংশ"],["بَعْضٍۢ ۚ","ba‘ḍin","others","অপরের (অনুরূপ)"],["يَأْمُرُونَ","yamurūna","They enjoin","তারা নির্দেশ দেয়"],["بِٱلْمُنكَرِ","bil-munkari","the wrong","ব্যাপারে অন্যায় কাজের"],["وَيَنْهَوْنَ","wayanhawna","and forbid","ও তারা নিষেধ করে"],["عَنِ","‘ani","what","হতে"],["ٱلْمَعْرُوفِ","l-ma‘rūfi","(is) the right","সৎ কাজ"],["وَيَقْبِضُونَ","wayaqbiḍūna","and they close","ও তারা গুটিয়ে রাখে"],["أَيْدِيَهُمْ ۚ","aydiyahum","their hands","হাত তাদের (ভালো কাজ হতে)"],["نَسُوا۟","nasū","They forget","তারা ভুলে গেছে"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["فَنَسِيَهُمْ ۗ","fanasiyahum","so He has forgotten them","তাই তিনি ভুলে গেলেন তাদেরকে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلْمُنَـٰفِقِينَ","l-munāfiqīna","the hypocrites","মুনাফিকরা"],["هُمُ","humu","they (are)","তারাই"],["ٱلْفَـٰسِقُونَ","l-fāsiqūna","the defiantly disobedient","সত্যত্যাগী"]],"t":"ٱلْمُ<m>نَٰ</>فِقُونَ وَ<h>ٱ</>لْمُ<m>نَٰفِقَٰ</>تُ بَعْضُ<y>هُم مِّ</><i>نۢ بَ</>عْ<d>ضٍۢ ۚ يَ</>أْمُرُونَ بِ<h>ٱ</>لْمُ<k>نكَ</>رِ وَيَنْهَوْنَ عَنِ <h>ٱ</>لْمَعْرُوفِ وَيَ<q>قْ</>بِضُونَ أَيْدِيَهُمْ ۚ نَسُو<s>ا۟</> <h>ٱ</>للَّهَ فَنَسِيَهُمْ ۗ إِ<g>نَّ</> <h>ٱ</>لْمُ<m>نَٰ</>فِقِينَ هُمُ <h>ٱ</>لْ<m>فَٰ</>سِ<p>قُو</>نَ"},{"n":68,"w":[["وَعَدَ","wa‘ada","Allah has promised","প্রতিশ্রুতি দিয়েছেন"],["ٱللَّهُ","l-lahu","Allah has promised","আল্লাহ"],["ٱلْمُنَـٰفِقِينَ","l-munāfiqīna","the hypocrite men","মুনাফিক পুরুষদের (জন্যে)"],["وَٱلْمُنَـٰفِقَـٰتِ","wal-munāfiqāti","and the hypocrite women","ও মুনাফিক নারীদের (জন্যে)"],["وَٱلْكُفَّارَ","wal-kufāra","and the disbelievers","ও কাফেরদের (জন্যে)"],["نَارَ","nāra","Fire","আগুন"],["جَهَنَّمَ","jahannama","(of) Hell","জাহান্নামের"],["خَـٰلِدِينَ","khālidīna","they (will) abide forever","তারা চিরস্থায়ী হবে"],["فِيهَا ۚ","fīhā","in it","মধ্যে তার"],["هِىَ","hiya","It (is)","তা"],["حَسْبُهُمْ ۚ","ḥasbuhum","sufficient for them","তাদের জন্যে যথেষ্ঠ"],["وَلَعَنَهُمُ","wala‘anahumu","And Allah has cursed them","ও তাদের উপর অভিশাপ করেছেন"],["ٱللَّهُ ۖ","l-lahu","And Allah has cursed them","আল্লাহ"],["وَلَهُمْ","walahum","and for them","ও জন্যে তাদের (রয়েছে)"],["عَذَابٌۭ","‘adhābun","(is) a punishment","শাস্তি"],["مُّقِيمٌۭ","muqīmun","enduring","স্থায়ী"]],"t":"وَعَدَ <h>ٱ</>للَّهُ <h>ٱ</>لْمُ<m>نَٰ</>فِقِينَ وَ<h>ٱ</>لْمُ<m>نَٰفِقَٰ</>تِ وَ<h>ٱ</>لْكُفَّارَ نَارَ جَهَ<g>نَّ</>مَ <m>خَٰ</>لِدِينَ فِيهَا ۚ هِىَ حَسْبُهُمْ ۚ وَلَعَنَهُمُ <h>ٱ</>للَّهُ ۖ وَلَهُمْ عَذَا<d>بٌۭ مُّ</><p>قِي</>مٌۭ"},{"n":69,"w":[["كَٱلَّذِينَ","ka-alladhīna","Like those","(তাদের) মতো যারা"],["مِن","min","before you","থেকে"],["قَبْلِكُمْ","qablikum","before you","পূর্ব তোমাদের(ছিলো)"],["كَانُوٓا۟","kānū","they were","তারা ছিলো"],["أَشَدَّ","ashadda","mightier","প্রবলতর"],["مِنكُمْ","minkum","than you","চেয়ে তোমাদের"],["قُوَّةًۭ","quwwatan","(in) strength","শক্তিতে"],["وَأَكْثَرَ","wa-akthara","and more abundant","ও অধিক"],["أَمْوَٰلًۭا","amwālan","(in) wealth","ধনসম্পদে"],["وَأَوْلَـٰدًۭا","wa-awlādan","and children","ও সন্তান-সন্তুতিতে"],["فَٱسْتَمْتَعُوا۟","fa-is'tamta‘ū","So they enjoyed","অতঃপর তারা ভোগ করেছে"],["بِخَلَـٰقِهِمْ","bikhalāqihim","their portion","তাদের"],["فَٱسْتَمْتَعْتُم","fa-is'tamta‘tum","and you have enjoyed","এখন তোমরা ভোগ করেছো"],["بِخَلَـٰقِكُمْ","bikhalāqikum","your portion","তোমাদের"],["كَمَا","kamā","like","যেমন"],["ٱسْتَمْتَعَ","is'tamta‘a","enjoyed","ভোগ করেছে"],["ٱلَّذِينَ","alladhīna","those","যারা"],["مِن","min","before you","থেকে"],["قَبْلِكُم","qablikum","before you","পূর্ব তোমাদের (ছিলো)"],["بِخَلَـٰقِهِمْ","bikhalāqihim","their portion","তাদের"],["وَخُضْتُمْ","wakhuḍ'tum","and you indulge","ও তোমরা আলাপ-আলোচনা করেছো"],["كَٱلَّذِى","ka-alladhī","like the one who","মতো তাদের যারা"],["خَاضُوٓا۟ ۚ","khāḍū","indulges (in idle talk)","তারা আলাপ-আলোচনা করেছে"],["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব লোকের"],["حَبِطَتْ","ḥabiṭat","worthless","নষ্ট হয়েছে"],["أَعْمَـٰلُهُمْ","a‘māluhum","(are) their deeds","কাজকর্ম তাদের"],["فِى","fī","in","মধ্যে"],["ٱلدُّنْيَا","l-dun'yā","the world","পৃথিবীর"],["وَٱلْـَٔاخِرَةِ ۖ","wal-ākhirati","and (in) the Hereafter","এবং আখেরাতেও"],["وَأُو۟لَـٰٓئِكَ","wa-ulāika","And those","এবং ঐসব লোক"],["هُمُ","humu","they","তারাই"],["ٱلْخَـٰسِرُونَ","l-khāsirūna","(are) the losers","ক্ষতিগ্রস্ত"]],"t":"كَ<h>ٱ</>لَّذِينَ مِ<k>ن قَ</><q>بْ</>لِكُمْ كَا<o>نُوٓ</><s>ا۟</> أَشَدَّ مِ<k>نكُ</>مْ قُوَّ<d>ةًۭ وَ</>أَكْثَرَ أَمْ<m>وَٰ</>لًۭ<d>ا وَ</>أَوْ<m>لَٰ</><k>دًۭا فَ</><h>ٱ</>سْتَمْتَعُو<s>ا۟</> بِخَ<m>لَٰ</>قِهِمْ فَ<h>ٱ</>سْتَمْتَعْ<f>تُم بِ</>خَ<m>لَٰ</>قِكُمْ كَمَا <h>ٱ</>سْتَمْتَعَ <h>ٱ</>لَّذِينَ مِ<k>ن قَ</><q>بْ</>لِ<f>كُم بِ</>خَ<m>لَٰ</>قِهِمْ وَخُضْتُمْ كَ<h>ٱ</>لَّذِى خَا<o>ضُوٓ</><s>ا۟</> ۚ أُ<s>و۟</><o>لَٰٓ</>ئِكَ حَبِطَتْ أَعْ<m>مَٰ</>لُهُمْ فِى <h>ٱ</><l>ل</>دُّنْيَا وَ<h>ٱ</>لْءَاخِرَةِ ۖ وَأُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</>لْ<m>خَٰ</>سِ<p>رُو</>نَ"},{"n":70,"w":[["أَلَمْ","alam","Has not","কি নি"],["يَأْتِهِمْ","yatihim","come to them","তাদের কাছে আসে"],["نَبَأُ","naba-u","(the) news","সংবাদ"],["ٱلَّذِينَ","alladhīna","(of) those who","(তাদের) যারা"],["مِن","min","(were) before them","থেকে"],["قَبْلِهِمْ","qablihim","(were) before them","পূর্ব তাদের(ছিলো)"],["قَوْمِ","qawmi","(the) people","(যেমন) জাতি"],["نُوحٍۢ","nūḥin","(of) Nuh","নূহের"],["وَعَادٍۢ","wa‘ādin","and Aad","ও আদের"],["وَثَمُودَ","wathamūda","and Thamud","ও সামুদের"],["وَقَوْمِ","waqawmi","and (the) people","ও জাতি"],["إِبْرَٰهِيمَ","ib'rāhīma","(of) Ibrahim","ইবরাহীমের"],["وَأَصْحَـٰبِ","wa-aṣḥābi","and (the) companions","ও অধিবাসী"],["مَدْيَنَ","madyana","(of) Madyan","মাদইয়ানের"],["وَٱلْمُؤْتَفِكَـٰتِ ۚ","wal-mu'tafikāti","and the towns overturned","ও বিধ্বস্ত নগরের"],["أَتَتْهُمْ","atathum","Came to them","তাদের কাছে এসেছিলো"],["رُسُلُهُم","rusuluhum","their Messengers","রাসূলরা তাদের"],["بِٱلْبَيِّنَـٰتِ ۖ","bil-bayināti","with clear proofs","নিয়ে সুস্পষ্ট নিদর্শন"],["فَمَا","famā","And not","অতঃপর"],["كَانَ","kāna","was","নন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ (এমন যে)"],["لِيَظْلِمَهُمْ","liyaẓlimahum","to wrong them","তাদের উপর অবিচার করবেন"],["وَلَـٰكِن","walākin","but","কিন্তু"],["كَانُوٓا۟","kānū","they were (to)","তারা ছিলো"],["أَنفُسَهُمْ","anfusahum","themselves","তাদের নিজেদের উপর"],["يَظْلِمُونَ","yaẓlimūna","doing wrong","অবিচার করতো"]],"t":"أَلَمْ يَأْتِهِمْ نَبَأُ <h>ٱ</>لَّذِينَ مِ<k>ن قَ</><q>بْ</>لِهِمْ قَوْمِ نُو<d>حٍۢ وَ</>عَا<d>دٍۢ وَ</>ثَمُودَ وَقَوْمِ إِ<q>بْ</><m>رَٰ</>هِيمَ وَأَصْ<m>حَٰ</>بِ مَ<q>دْ</>يَنَ وَ<h>ٱ</>لْمُؤْتَفِ<m>كَٰ</>تِ ۚ أَتَتْهُمْ رُسُلُ<f>هُم بِ</><h>ٱ</>لْبَيِّ<m>نَٰ</>تِ ۖ فَمَا كَانَ <h>ٱ</>للَّهُ لِيَظْلِمَهُمْ وَ<m>لَٰ</>كِ<k>ن كَ</>ا<o>نُوٓ</><s>ا۟</> أَ<k>نفُ</>سَهُمْ يَظْلِ<p>مُو</>نَ"},{"n":71,"w":[["وَٱلْمُؤْمِنُونَ","wal-mu'minūna","And the believing men","এবং মু'মিন পুরুষ"],["وَٱلْمُؤْمِنَـٰتُ","wal-mu'minātu","and the believing women","মু'মিন নারী"],["بَعْضُهُمْ","ba‘ḍuhum","some of them","একে তারা"],["أَوْلِيَآءُ","awliyāu","(are) allies","বন্ধু"],["بَعْضٍۢ ۚ","ba‘ḍin","(of) others","অপরের"],["يَأْمُرُونَ","yamurūna","They enjoin","তারা নির্দেশ দেয়"],["بِٱلْمَعْرُوفِ","bil-ma‘rūfi","the right","ব্যাপারে সৎকাজের"],["وَيَنْهَوْنَ","wayanhawna","and forbid","ও তারা নিষেধ করে"],["عَنِ","‘ani","from","হতে"],["ٱلْمُنكَرِ","l-munkari","the wrong","অন্যায় কাজ"],["وَيُقِيمُونَ","wayuqīmūna","and they establish","ও প্রতিষ্ঠা করে"],["ٱلصَّلَوٰةَ","l-ṣalata","the prayer","সালাত"],["وَيُؤْتُونَ","wayu'tūna","and give","ও তারা দেয়"],["ٱلزَّكَوٰةَ","l-zakata","the zakah","জাকাত"],["وَيُطِيعُونَ","wayuṭī‘ūna","and they obey","ও তারা আনুগত্য করে"],["ٱللَّهَ","l-laha","Allah","আল্লাহর"],["وَرَسُولَهُۥٓ ۚ","warasūlahu","and His Messenger","ও রাসূলের তাঁর"],["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব লোক"],["سَيَرْحَمُهُمُ","sayarḥamuhumu","Allah will have mercy on them","শীঘ্রই তাদের উপর অনুগ্রহ করবেন"],["ٱللَّهُ ۗ","l-lahu","Allah will have mercy on them","আল্লাহ"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["عَزِيزٌ","‘azīzun","(is) All-Mighty","মহাপরাক্রমশালী"],["حَكِيمٌۭ","ḥakīmun","All-Wise","মহাবিজ্ঞ"]],"t":"وَ<h>ٱ</>لْمُؤْمِنُونَ وَ<h>ٱ</>لْمُؤْمِ<m>نَٰ</>تُ بَعْضُهُمْ أَوْلِ<o>يَآ</>ءُ بَعْ<d>ضٍۢ ۚ يَ</>أْمُرُونَ بِ<h>ٱ</>لْمَعْرُوفِ وَيَنْهَوْنَ عَنِ <h>ٱ</>لْمُ<k>نكَ</>رِ وَيُقِيمُونَ <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةَ وَيُؤْتُونَ <h>ٱ</><l>ل</>زَّكَ<s>وٰ</>ةَ وَيُطِيعُونَ <h>ٱ</>للَّهَ وَرَسُولَهُ<o>ۥٓ ۚ</> أُ<s>و۟</><o>لَٰٓ</>ئِكَ سَيَرْحَمُهُمُ <h>ٱ</>للَّهُ ۗ إِ<g>نَّ</> <h>ٱ</>للَّهَ عَزِيزٌ حَ<p>كِي</>مٌۭ"},{"n":72,"w":[["وَعَدَ","wa‘ada","(Has been) promised","প্রতিশ্রুতি দিয়েছেন"],["ٱللَّهُ","l-lahu","(by) Allah","আল্লাহ"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","(to) the believing men","মু'মিন পুরুষদের জন্যে"],["وَٱلْمُؤْمِنَـٰتِ","wal-mu'mināti","and the believing women","ও মু'মিন নারীদের (জন্যে)"],["جَنَّـٰتٍۢ","jannātin","Gardens","জান্নাতের"],["تَجْرِى","tajrī","flow","প্রবাহিত হয়"],["مِن","min","from","হতে"],["تَحْتِهَا","taḥtihā","underneath it","নিচ তার"],["ٱلْأَنْهَـٰرُ","l-anhāru","the rivers","ঝর্নাধারা"],["خَـٰلِدِينَ","khālidīna","(will) abide forever","তারা চিরিস্থায়ী হবে"],["فِيهَا","fīhā","in it","মধ্যে তার"],["وَمَسَـٰكِنَ","wamasākina","and dwellings","ও (প্রতিশ্রুতি) বসবাসস্থানের"],["طَيِّبَةًۭ","ṭayyibatan","blessed","পবিত্র"],["فِى","fī","in","মধ্যে"],["جَنَّـٰتِ","jannāti","Gardens","জান্নাতের"],["عَدْنٍۢ ۚ","‘adnin","(of) everlasting bliss","চিরস্থায়ী"],["وَرِضْوَٰنٌۭ","wariḍ'wānun","But the pleasure","ও সন্তুষ্টি"],["مِّنَ","mina","of","পক্ষ থেকে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["أَكْبَرُ ۚ","akbaru","(is) greater","সবচেয়ে বড়"],["ذَٰلِكَ","dhālika","That","এটাই"],["هُوَ","huwa","it","সেই"],["ٱلْفَوْزُ","l-fawzu","(is) the success","সাফল্য"],["ٱلْعَظِيمُ","l-‘aẓīmu","great","মহা"]],"t":"وَعَدَ <h>ٱ</>للَّهُ <h>ٱ</>لْمُؤْمِنِينَ وَ<h>ٱ</>لْمُؤْمِ<m>نَٰ</>تِ جَ<g>نَّٰ</><k>تٍۢ تَ</><q>جْ</>رِى مِ<k>ن تَ</>حْتِهَا <h>ٱ</>لْأَنْ<m>هَٰ</>رُ <m>خَٰ</>لِدِينَ فِيهَا وَمَ<m>سَٰ</>كِنَ طَيِّبَ<k>ةًۭ فِ</>ى جَ<g>نَّٰ</>تِ عَ<q>دْ</><d>نٍۢ ۚ وَ</>رِضْ<m>وَٰ</><d>نٌۭ مِّ</>نَ <h>ٱ</>للَّهِ أَكْبَرُ ۚ <m>ذَٰ</>لِكَ هُوَ <h>ٱ</>لْفَوْزُ <h>ٱ</>لْعَ<p>ظِي</>مُ"},{"n":73,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O Prophet","হে"],["ٱلنَّبِىُّ","l-nabiyu","O Prophet","নাবী"],["جَـٰهِدِ","jāhidi","Strive (against)","জিহাদ করো"],["ٱلْكُفَّارَ","l-kufāra","the disbelievers","কাফেরদের বিরুদ্ধে"],["وَٱلْمُنَـٰفِقِينَ","wal-munāfiqīna","and the hypocrites","ও মুনাফিকদের (বিরুদ্ধে)"],["وَٱغْلُظْ","wa-ugh'luẓ","and be stern","ও কঠোর হও"],["عَلَيْهِمْ ۚ","‘alayhim","with them","প্রতি তাদের"],["وَمَأْوَىٰهُمْ","wamawāhum","And their abode","এবং তাদের ঠিকানা"],["جَهَنَّمُ ۖ","jahannamu","(is) Hell","জাহান্নাম"],["وَبِئْسَ","wabi'sa","and wretched","ও (তা) অতি নিকৃষ্ট"],["ٱلْمَصِيرُ","l-maṣīru","(is) the destination","প্রত্যাবর্তন স্হান"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</><l>ل</><g>نَّ</>بِىُّ <m>جَٰ</>هِدِ <h>ٱ</>لْكُفَّارَ وَ<h>ٱ</>لْمُ<m>نَٰ</>فِقِينَ وَ<h>ٱ</>غْلُظْ عَلَيْهِمْ ۚ وَمَأْوَ<m>ىٰ</>هُمْ جَهَ<g>نَّ</>مُ ۖ وَبِئْسَ <h>ٱ</>لْمَ<p>صِي</>رُ"},{"n":74,"w":[["يَحْلِفُونَ","yaḥlifūna","They swear","তারা শপথ করে (বলে)"],["بِٱللَّهِ","bil-lahi","by Allah","নামে আল্লাহর"],["مَا","mā","(that) they said nothing","না"],["قَالُوا۟","qālū","(that) they said nothing","তারা বলেছে"],["وَلَقَدْ","walaqad","while certainly","অথচ নিশ্চয়ই"],["قَالُوا۟","qālū","they said","তারা বলেছে"],["كَلِمَةَ","kalimata","(the) word","কথা"],["ٱلْكُفْرِ","l-kuf'ri","(of) the disbelief","অবিশ্বাসের"],["وَكَفَرُوا۟","wakafarū","and disbelieved","এবং তারা অবিশ্বাস করেছে"],["بَعْدَ","ba‘da","after","পরেও"],["إِسْلَـٰمِهِمْ","is'lāmihim","their (pretense of) Islam","তাদের ইসলাম গ্রহণের"],["وَهَمُّوا۟","wahammū","and planned","ও তারা ইচ্ছে করেছিলো"],["بِمَا","bimā","[of] what","বিষয়ে এমন যা"],["لَمْ","lam","not","নি"],["يَنَالُوا۟ ۚ","yanālū","they could attain","তাদের হাতে পৌঁছে"],["وَمَا","wamā","And not","এবং না"],["نَقَمُوٓا۟","naqamū","they were resentful","তারা প্রতিশোধ নিচ্ছে"],["إِلَّآ","illā","except","এছাড়া (অন্যকিছুর)"],["أَنْ","an","that","যে"],["أَغْنَىٰهُمُ","aghnāhumu","Allah had enriched them","ধনী করেছিলেন তাদের"],["ٱللَّهُ","l-lahu","Allah had enriched them","আল্লাহ"],["وَرَسُولُهُۥ","warasūluhu","and His Messenger","ও  রাসূল তাঁর"],["مِن","min","of","দিয়ে"],["فَضْلِهِۦ ۚ","faḍlihi","His Bounty","অনুগ্রহ তাঁর"],["فَإِن","fa-in","So if","অতএব যদি"],["يَتُوبُوا۟","yatūbū","they repent","তারা তওবা করে"],["يَكُ","yaku","it is","তা হবে"],["خَيْرًۭا","khayran","better","উত্তম"],["لَّهُمْ ۖ","lahum","for them","জন্যে তাদের"],["وَإِن","wa-in","and if","এবং যদি"],["يَتَوَلَّوْا۟","yatawallaw","they turn away","তারা ফিরে যায়"],["يُعَذِّبْهُمُ","yu‘adhib'humu","Allah will punish them","শাস্তি দিবেন তাদেরকে"],["ٱللَّهُ","l-lahu","Allah will punish them","আল্লাহ"],["عَذَابًا","‘adhāban","(with) a punishment","শাস্তি"],["أَلِيمًۭا","alīman","painful","অতি কষ্টদায়ক"],["فِى","fī","in","মধ্যে"],["ٱلدُّنْيَا","l-dun'yā","the world","পৃথিবীর"],["وَٱلْـَٔاخِرَةِ ۚ","wal-ākhirati","and (in) the Hereafter","ও আখেরাতে"],["وَمَا","wamā","And not","এবং না"],["لَهُمْ","lahum","for them","জন্যে তাদের (আছে)"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["مِن","min","any","কোনো"],["وَلِىٍّۢ","waliyyin","protector","বন্ধু"],["وَلَا","walā","and not","আর না"],["نَصِيرٍۢ","naṣīrin","a helper","কোনো সাহায্যকারী"]],"t":"يَحْلِفُونَ بِ<h>ٱ</>للَّهِ مَا قَالُو<s>ا۟</> وَلَقَ<q>دْ</> قَالُو<s>ا۟</> كَلِمَةَ <h>ٱ</>لْكُفْرِ وَكَفَرُو<s>ا۟</> بَعْدَ إِسْ<m>لَٰ</>مِهِمْ وَهَ<g>مُّ</>و<s>ا۟</> بِمَا لَمْ يَنَالُو<s>ا۟ ۚ</> وَمَا نَقَ<o>مُوٓ</><s>ا۟</> إِ<o>لَّآ</> أَنْ أَغْنَ<m>ىٰ</>هُمُ <h>ٱ</>للَّهُ وَرَسُولُهُ<m>ۥ</> مِ<k>ن فَ</>ضْلِ<m>هِۦ</> ۚ فَ<d>إِن يَ</>تُوبُو<s>ا۟</> يَكُ خَيْ<w>رًۭا لَّ</>هُمْ ۖ وَ<d>إِن يَ</>تَوَلَّوْ<s>ا۟</> يُعَذِّ<q>بْ</>هُمُ <h>ٱ</>للَّهُ عَذَابًا أَلِي<k>مًۭا فِ</>ى <h>ٱ</><l>ل</>دُّنْيَا وَ<h>ٱ</>لْءَاخِرَةِ ۚ وَمَا لَهُمْ فِى <h>ٱ</>لْأَرْضِ <d>مِن وَلِىٍّۢ وَ</>لَا نَ<p>صِي</>رٍۢ"},{"n":75,"w":[["۞ وَمِنْهُم","wamin'hum","And among them","ও তাদের মধ্যে (আছে)"],["مَّنْ","man","(is he) who","কেউ কেউ"],["عَـٰهَدَ","‘āhada","made a covenant","অঙ্গীকার করেছিলো"],["ٱللَّهَ","l-laha","(with) Allah","আল্লাহর কাছে"],["لَئِنْ","la-in","If","\"অবশ্যই যদি"],["ءَاتَىٰنَا","ātānā","He gives us","আমাদের দেন (আল্লাহ)"],["مِن","min","of","হতে"],["فَضْلِهِۦ","faḍlihi","His bounty","অনুগ্রহ তাঁর"],["لَنَصَّدَّقَنَّ","lanaṣṣaddaqanna","surely we will give charity","অবশ্যই আমরা সদকা করবোই"],["وَلَنَكُونَنَّ","walanakūnanna","and surely we will be","এবং অবশ্যই আমরা হবো"],["مِنَ","mina","among","অন্তর্ভুক্ত"],["ٱلصَّـٰلِحِينَ","l-ṣāliḥīna","the righteous","সৎলোকদের\""]],"t":"۞ وَمِنْ<y>هُم مَّ</>نْ <m>عَٰ</>هَدَ <h>ٱ</>للَّهَ لَئِنْ ءَاتَ<m>ىٰ</>نَا مِ<k>ن فَ</>ضْلِ<m>هِۦ</> لَنَصَّدَّقَ<g>نَّ</> وَلَنَكُونَ<g>نَّ</> مِنَ <h>ٱ</><l>ل</><m>صَّٰ</>لِ<p>حِي</>نَ"},{"n":76,"w":[["فَلَمَّآ","falammā","But when","অতঃপর যখন"],["ءَاتَىٰهُم","ātāhum","He gave them","তিনি দান করলেন তাদেরকে"],["مِّن","min","of","থেকে"],["فَضْلِهِۦ","faḍlihi","His Bounty","অনুগ্রহ তাঁর"],["بَخِلُوا۟","bakhilū","they became stingy","তারা কৃপণতা করলো"],["بِهِۦ","bihi","with it","সাথে তার"],["وَتَوَلَّوا۟","watawallaw","and turned away","ও তারা বিমুখ হলো"],["وَّهُم","wahum","while they","এমতাবস্হায় যে তারা"],["مُّعْرِضُونَ","mu‘'riḍūna","(were) averse","বিরুদ্ধভাবাপন্ন (হয়ে গেলো)"]],"t":"فَلَ<g>مَّ</><o>آ</> ءَاتَ<m>ىٰ</><y>هُم مِّ</><k>ن فَ</>ضْلِ<m>هِۦ</> بَخِلُو<s>ا۟</> بِ<m>هِۦ</> وَتَوَلَّو<s>ا۟</> وَّ<y>هُم مُّ</>عْرِ<p>ضُو</>نَ"},{"n":77,"w":[["فَأَعْقَبَهُمْ","fa-a‘qabahum","So He penalized them","তাই তিনি সাজা দিলেন তাদেরকে"],["نِفَاقًۭا","nifāqan","(with) hypocrisy","মুনাফেকী (দিয়ে)"],["فِى","fī","in","মধ্যে"],["قُلُوبِهِمْ","qulūbihim","their hearts","অন্তরে তাদের"],["إِلَىٰ","ilā","until","পর্যন্ত"],["يَوْمِ","yawmi","the day","সেদিন করবে তারা"],["يَلْقَوْنَهُۥ","yalqawnahu","when they will meet Him","তাঁর সাথে সাক্ষাত"],["بِمَآ","bimā","because","এ কারণে যে"],["أَخْلَفُوا۟","akhlafū","they broke","তারা ভঙ্গ করেছিলো"],["ٱللَّهَ","l-laha","(the covenant with) Allah","আল্লাহর (সাথে)"],["مَا","mā","what","যা"],["وَعَدُوهُ","wa‘adūhu","they had promised Him","তারা প্রতিশ্রুতি দিয়েছিলো তাঁকে"],["وَبِمَا","wabimā","and because","এবং এ কারণেও (সাজা পেলো) যে"],["كَانُوا۟","kānū","they used to","তারা ছিলো"],["يَكْذِبُونَ","yakdhibūna","lie","তারা মিথ্যা বলতে"]],"t":"فَأَعْقَبَهُمْ نِفَا<k>قًۭا فِ</>ى قُلُوبِهِمْ إِلَىٰ يَوْمِ يَلْقَوْنَهُ<m>ۥ</> بِ<o>مَآ</> أَخْلَفُو<s>ا۟</> <h>ٱ</>للَّهَ مَا وَعَدُوهُ وَبِمَا كَانُو<s>ا۟</> يَكْذِ<p>بُو</>نَ"},{"n":78,"w":[["أَلَمْ","alam","Do not","কি না"],["يَعْلَمُوٓا۟","ya‘lamū","they know","তারা জানে"],["أَنَّ","anna","that","যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يَعْلَمُ","ya‘lamu","knows","জানেন"],["سِرَّهُمْ","sirrahum","their secret","তাদের গোপন (কথা)"],["وَنَجْوَىٰهُمْ","wanajwāhum","and their secret conversation","ও তাদের গোপন পরামর্শ"],["وَأَنَّ","wa-anna","and that","এবং (তারা জানে না) যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["عَلَّـٰمُ","‘allāmu","(is) All-Knower","খুব জানেন"],["ٱلْغُيُوبِ","l-ghuyūbi","(of) the unseen","গোপন বিষয়গুলো"]],"t":"أَلَمْ يَعْلَ<o>مُوٓ</><s>ا۟</> أَ<g>نَّ</> <h>ٱ</>للَّهَ يَعْلَمُ سِرَّهُمْ وَنَ<q>جْ</>وَ<m>ىٰ</>هُمْ وَأَ<g>نَّ</> <h>ٱ</>للَّهَ عَ<m>لَّٰ</>مُ <h>ٱ</>لْغُ<p>يُو</><q>بِ</>"},{"n":79,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["يَلْمِزُونَ","yalmizūna","criticize","দোষারোপ করে"],["ٱلْمُطَّوِّعِينَ","l-muṭawi‘īna","the ones who give willingly","স্বতঃস্ফুর্তভাবে দানকারীদেরকে"],["مِنَ","mina","of","মধ্য হতে"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believers","মু'মিনদের"],["فِى","fī","concerning","ব্যাপারে"],["ٱلصَّدَقَـٰتِ","l-ṣadaqāti","the charities","দানের"],["وَٱلَّذِينَ","wa-alladhīna","and those who","এবং (তাদেরকেও) যারা"],["لَا","lā","not","না"],["يَجِدُونَ","yajidūna","find","পায় (কোনো কিছু দান করতে)"],["إِلَّا","illā","except","এ ছাড়া"],["جُهْدَهُمْ","juh'dahum","their effort","শ্রম তাদের"],["فَيَسْخَرُونَ","fayaskharūna","so they ridicule","তাই তারা ঠাট্টা করে"],["مِنْهُمْ ۙ","min'hum","them","সম্পর্কে তাদের"],["سَخِرَ","sakhira","Allah will ridicule","ঠাট্টা করেন"],["ٱللَّهُ","l-lahu","Allah will ridicule","আল্লাহ"],["مِنْهُمْ","min'hum","them","ব্যাপারে তাদের (বিদ্রুপকারীদেরকে)"],["وَلَهُمْ","walahum","and for them","এবং জন্যে তাদের (রয়েছে)"],["عَذَابٌ","‘adhābun","(is) a punishment","শাস্তি"],["أَلِيمٌ","alīmun","painful","নিদারুণ"]],"t":"ٱلَّذِينَ يَلْمِزُونَ <h>ٱ</>لْمُطَّوِّعِينَ مِنَ <h>ٱ</>لْمُؤْمِنِينَ فِى <h>ٱ</><l>ل</>صَّدَ<m>قَٰ</>تِ وَ<h>ٱ</>لَّذِينَ لَا يَجِدُونَ إِلَّا جُهْدَهُمْ فَيَسْخَرُونَ مِنْهُمْ ۙ سَخِرَ <h>ٱ</>للَّهُ مِنْهُمْ وَلَهُمْ عَذَابٌ أَ<p>لِي</>مٌ"},{"n":80,"w":[["ٱسْتَغْفِرْ","is'taghfir","Ask forgiveness","ক্ষমা প্রার্থনা করো তুমি"],["لَهُمْ","lahum","for them","জন্যে তাদের"],["أَوْ","aw","or","অথবা"],["لَا","lā","(do) not","না"],["تَسْتَغْفِرْ","tastaghfir","ask forgiveness","ক্ষমা প্রার্থনা করো"],["لَهُمْ","lahum","for them","জন্যে তাদের(একই কথা)"],["إِن","in","If","(এমনকি) যদি"],["تَسْتَغْفِرْ","tastaghfir","you ask forgiveness","ক্ষমা প্রার্থনা করো তুমি"],["لَهُمْ","lahum","for them","জন্যে তাদের"],["سَبْعِينَ","sab‘īna","seventy","সত্তর"],["مَرَّةًۭ","marratan","times","বারও"],["فَلَن","falan","never","তারপরও কখনও না"],["يَغْفِرَ","yaghfira","will Allah forgive","ক্ষমা করবেন"],["ٱللَّهُ","l-lahu","will Allah forgive","আল্লাহ"],["لَهُمْ ۚ","lahum","[for] them","প্রতি তাদের"],["ذَٰلِكَ","dhālika","That","এটা"],["بِأَنَّهُمْ","bi-annahum","(is) because they","এজন্যে যে তারা"],["كَفَرُوا۟","kafarū","disbelieved","অবিশ্বাস করেছে"],["بِٱللَّهِ","bil-lahi","in Allah","প্রতি আল্লাহর"],["وَرَسُولِهِۦ ۗ","warasūlihi","and His Messenger","ও তাঁর রাসূলের"],["وَٱللَّهُ","wal-lahu","and Allah","এবং আল্লাহ"],["لَا","lā","(does) not","না"],["يَهْدِى","yahdī","guide","সঠিক পথ দেখান"],["ٱلْقَوْمَ","l-qawma","the people","(এমন) সম্প্রদায়কে"],["ٱلْفَـٰسِقِينَ","l-fāsiqīna","the defiantly disobedient","(যারা) সত্যত্যাগী"]],"t":"ٱسْتَغْفِرْ لَهُمْ أَوْ لَا تَسْتَغْفِرْ لَهُمْ إِ<k>ن تَ</>سْتَغْفِرْ لَهُمْ سَ<q>بْ</>عِينَ مَرَّ<k>ةًۭ فَ</><d>لَن يَ</>غْفِرَ <h>ٱ</>للَّهُ لَهُمْ ۚ <m>ذَٰ</>لِكَ بِأَ<g>نَّ</>هُمْ كَفَرُو<s>ا۟</> بِ<h>ٱ</>للَّهِ وَرَسُولِ<m>هِۦ</> ۗ وَ<h>ٱ</>للَّهُ لَا يَهْدِى <h>ٱ</>لْقَوْمَ <h>ٱ</>لْ<m>فَٰ</>سِ<p>قِي</>نَ"},{"n":81,"w":[["فَرِحَ","fariḥa","Rejoice","খুশি হয়েছে"],["ٱلْمُخَلَّفُونَ","l-mukhalafūna","those who remained behind","পিছনে থাকা লোকেরা"],["بِمَقْعَدِهِمْ","bimaq‘adihim","in their staying","নিয়ে বসে থাকা তাদের"],["خِلَـٰفَ","khilāfa","behind","বিরোধিতা করে"],["رَسُولِ","rasūli","(the) Messenger","রাসূলের"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَكَرِهُوٓا۟","wakarihū","and they disliked","এবং তারা অপছন্দ করেছে"],["أَن","an","to","যে"],["يُجَـٰهِدُوا۟","yujāhidū","strive","তারা জেহাদ করবে"],["بِأَمْوَٰلِهِمْ","bi-amwālihim","with their wealth","দিয়ে ধনসসম্পদ তাদের"],["وَأَنفُسِهِمْ","wa-anfusihim","and their lives","ও প্রাণ(দিয়ে)তাদের"],["فِى","fī","in","মধ্যে"],["سَبِيلِ","sabīli","(the) way","পথের"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَقَالُوا۟","waqālū","and they said","এবং তারা বললো"],["لَا","lā","(Do) not","\"না"],["تَنفِرُوا۟","tanfirū","go forth","তোমরা অভিযানে যেও"],["فِى","fī","in","মধ্যে"],["ٱلْحَرِّ ۗ","l-ḥari","the heat","গরমের\""],["قُلْ","qul","Say","বলো"],["نَارُ","nāru","(The) Fire","\"আগুন"],["جَهَنَّمَ","jahannama","(of) Hell","জাহান্নামের"],["أَشَدُّ","ashaddu","(is) more intense","প্রচন্ডতম"],["حَرًّۭا ۚ","ḥarran","(in) heat","গরম\""],["لَّوْ","law","If (only)","যদি"],["كَانُوا۟","kānū","they could","তারা থাকতো"],["يَفْقَهُونَ","yafqahūna","understand","তারা বুঝে"]],"t":"فَرِحَ <h>ٱ</>لْمُخَلَّفُونَ بِمَ<q>قْ</>عَدِهِمْ خِ<m>لَٰ</>فَ رَسُولِ <h>ٱ</>للَّهِ وَكَرِ<o>هُوٓ</><s>ا۟</> <d>أَن يُ</><m>جَٰ</>هِدُو<s>ا۟</> بِأَمْ<m>وَٰ</>لِهِمْ وَأَ<k>نفُ</>سِهِمْ فِى سَبِيلِ <h>ٱ</>للَّهِ وَقَالُو<s>ا۟</> لَا تَ<k>نفِ</>رُو<s>ا۟</> فِى <h>ٱ</>لْحَرِّ ۗ قُلْ نَارُ جَهَ<g>نَّ</>مَ أَشَدُّ حَ<w>رًّۭا ۚ لَّ</>وْ كَانُو<s>ا۟</> يَفْقَ<p>هُو</>نَ"},{"n":82,"w":[["فَلْيَضْحَكُوا۟","falyaḍḥakū","So let them laugh","অতএব হাসা উচিৎ তাদের"],["قَلِيلًۭا","qalīlan","a little","অল্প"],["وَلْيَبْكُوا۟","walyabkū","and let them weep","ও কাঁদা উচিৎ তাদের"],["كَثِيرًۭا","kathīran","much","বেশি"],["جَزَآءًۢ","jazāan","(as) a recompense","প্রতিফল"],["بِمَا","bimā","for what","পরিবর্তে যাকিছু"],["كَانُوا۟","kānū","they used to","তারা ছিলো"],["يَكْسِبُونَ","yaksibūna","earn","অর্জন করে আসছে"]],"t":"فَلْيَضْحَكُو<s>ا۟</> قَلِيلًۭ<d>ا وَ</>لْيَ<q>بْ</>كُو<s>ا۟</> كَثِي<k>رًۭا جَ</><o>زَآ</><i>ءًۢ بِ</>مَا كَانُو<s>ا۟</> يَكْسِ<p>بُو</>نَ"},{"n":83,"w":[["فَإِن","fa-in","Then if","অতঃপর যদি"],["رَّجَعَكَ","raja‘aka","Allah returns you","তোমাকে ফিরিয়ে আনেন"],["ٱللَّهُ","l-lahu","Allah returns you","আল্লাহ"],["إِلَىٰ","ilā","to","দিকে"],["طَآئِفَةٍۢ","ṭāifatin","a group","কোনো দলের"],["مِّنْهُمْ","min'hum","of them","মধ্য থেকে তাদের"],["فَٱسْتَـْٔذَنُوكَ","fa-is'tadhanūka","and they ask you permission","তবে তোমার কাছে তারা অনুমতি চাইবে"],["لِلْخُرُوجِ","lil'khurūji","to go out","জন্যে বের হওয়ার"],["فَقُل","faqul","then say","তখন বলো"],["لَّن","lan","Never","\"না কিছুতেই"],["تَخْرُجُوا۟","takhrujū","will you come out","তোমরা বের হবে"],["مَعِىَ","ma‘iya","with me","আমার সাথে"],["أَبَدًۭا","abadan","ever","কখনও"],["وَلَن","walan","and never","এবং কখনও না"],["تُقَـٰتِلُوا۟","tuqātilū","will you fight","তোমরা যুদ্ধ করবে"],["مَعِىَ","ma‘iya","with me","আমার সাথে"],["عَدُوًّا ۖ","‘aduwwan","any enemy","কোনো শত্রুর (বিরুদ্ধে)"],["إِنَّكُمْ","innakum","Indeed, you","নিশ্চয়ই তোমরা"],["رَضِيتُم","raḍītum","were satisfied","তোমরাই পছন্দ করেছিলে"],["بِٱلْقُعُودِ","bil-qu‘ūdi","with sitting","বিষয়কে বসে থাকার"],["أَوَّلَ","awwala","(the) first","প্রথম"],["مَرَّةٍۢ","marratin","time","বার"],["فَٱقْعُدُوا۟","fa-uq'‘udū","so sit","অতএব তোমরা বসে থাকো"],["مَعَ","ma‘a","with","সাথে"],["ٱلْخَـٰلِفِينَ","l-khālifīna","those who stay behind","বসে থাকা লোকদের\""]],"t":"فَ<w>إِن رَّ</>جَعَكَ <h>ٱ</>للَّهُ إِلَىٰ <o>طَآ</>ئِفَ<d>ةٍۢ مِّ</>نْهُمْ فَ<h>ٱ</>سْتَـْٔذَنُوكَ لِلْخُرُوجِ فَقُل لَّ<k>ن تَ</>خْرُجُو<s>ا۟</> مَعِىَ أَبَ<d>دًۭا وَ</>لَ<k>ن تُ</><m>قَٰ</>تِلُو<s>ا۟</> مَعِىَ عَدُوًّا ۖ إِ<g>نَّ</>كُمْ رَضِي<f>تُم بِ</><h>ٱ</>لْقُعُودِ أَوَّلَ مَرَّ<k>ةٍۢ فَ</><h>ٱ</><q>قْ</>عُدُو<s>ا۟</> مَعَ <h>ٱ</>لْ<m>خَٰ</>لِ<p>فِي</>نَ"},{"n":84,"w":[["وَلَا","walā","And not","এবং না"],["تُصَلِّ","tuṣalli","you pray","তুমি সালাত পড়বে"],["عَلَىٰٓ","‘alā","for","উপর"],["أَحَدٍۢ","aḥadin","any","কারও"],["مِّنْهُم","min'hum","of them","মধ্য থেকে তাদের"],["مَّاتَ","māta","who dies","মরে গেলে"],["أَبَدًۭا","abadan","ever","কখনও"],["وَلَا","walā","and not","এবং না"],["تَقُمْ","taqum","you stand","দাঁড়াবে তুমি"],["عَلَىٰ","‘alā","by","পাশে"],["قَبْرِهِۦٓ ۖ","qabrihi","his grave","কবরের তার"],["إِنَّهُمْ","innahum","Indeed, they","নিশ্চয়ই তারা"],["كَفَرُوا۟","kafarū","disbelieved","অবিশ্বাস করেছে"],["بِٱللَّهِ","bil-lahi","in Allah","প্রতি আল্লাহর"],["وَرَسُولِهِۦ","warasūlihi","and His Messenger","ও তাঁর রাসূলের"],["وَمَاتُوا۟","wamātū","and died","এবং তারা মরে গেছে"],["وَهُمْ","wahum","while they were","এ অবস্থায় যে তারা (ছিলো)"],["فَـٰسِقُونَ","fāsiqūna","defiantly disobedient","সত্যত্যাগী"]],"t":"وَلَا تُصَلِّ عَلَ<o>ىٰٓ</> أَحَ<d>دٍۢ مِّ</>نْ<y>هُم مَّ</>اتَ أَبَ<d>دًۭا وَ</>لَا تَقُمْ عَلَىٰ قَ<q>بْ</>رِ<o>هِۦٓ ۖ</> إِ<g>نَّ</>هُمْ كَفَرُو<s>ا۟</> بِ<h>ٱ</>للَّهِ وَرَسُولِ<m>هِۦ</> وَمَاتُو<s>ا۟</> وَهُمْ <m>فَٰ</>سِ<p>قُو</>نَ"},{"n":85,"w":[["وَلَا","walā","And (let) not","এবং না (যেন)"],["تُعْجِبْكَ","tu‘'jib'ka","impress you","তোমাকে বিস্মিত করে"],["أَمْوَٰلُهُمْ","amwāluhum","their wealth","ধনসম্পদ তাদের"],["وَأَوْلَـٰدُهُمْ ۚ","wa-awlāduhum","and their children","ও সন্তান-সন্তুতি তাদের"],["إِنَّمَا","innamā","Only","প্রকৃতপক্ষে"],["يُرِيدُ","yurīdu","Allah intends","চান"],["ٱللَّهُ","l-lahu","Allah intends","আল্লাহ"],["أَن","an","to","যে"],["يُعَذِّبَهُم","yu‘adhibahum","punish them","শাস্তি দিবেন তাদেরকে"],["بِهَا","bihā","with it","দিয়ে তা"],["فِى","fī","in","মধ্যে"],["ٱلدُّنْيَا","l-dun'yā","the world","পৃথিবীর"],["وَتَزْهَقَ","watazhaqa","and will depart","ও চলে যাবে"],["أَنفُسُهُمْ","anfusuhum","their souls","আত্মা তাদের"],["وَهُمْ","wahum","while they","এ অবস্থায় যে তারা"],["كَـٰفِرُونَ","kāfirūna","(are) disbelievers","কাফের (থাকবে)"]],"t":"وَلَا تُعْجِ<q>بْ</>كَ أَمْ<m>وَٰ</>لُهُمْ وَأَوْ<m>لَٰ</>دُهُمْ ۚ إِ<g>نَّ</>مَا يُرِيدُ <h>ٱ</>للَّهُ <d>أَن يُ</>عَذِّبَ<f>هُم بِ</>هَا فِى <h>ٱ</><l>ل</>دُّنْيَا وَتَزْهَقَ أَ<k>نفُ</>سُهُمْ وَهُمْ <m>كَٰ</>فِ<p>رُو</>نَ"},{"n":86,"w":[["وَإِذَآ","wa-idhā","And when","এবং যখন"],["أُنزِلَتْ","unzilat","was revealed","অবতীর্ণ হয়"],["سُورَةٌ","sūratun","a Surah","কোনো সূরাহ"],["أَنْ","an","that","যে"],["ءَامِنُوا۟","āminū","believe","তোমরা ঈমান আনো"],["بِٱللَّهِ","bil-lahi","in Allah","উপর আল্লাহর"],["وَجَـٰهِدُوا۟","wajāhidū","and strive","ও তোমরা জিহাদ করো"],["مَعَ","ma‘a","with","সাথে"],["رَسُولِهِ","rasūlihi","His Messenger","রাসূলের তাঁর"],["ٱسْتَـْٔذَنَكَ","is'tadhanaka","ask your permission","তোমার কাছে অব্যাহতি চায়"],["أُو۟لُوا۟","ulū","(the) men","সম্পন্নরা"],["ٱلطَّوْلِ","l-ṭawli","(of) wealth","শক্তি-সামর্থ্য"],["مِنْهُمْ","min'hum","among them","মধ্য থেকে তাদের"],["وَقَالُوا۟","waqālū","and said","ও তারা বলে"],["ذَرْنَا","dharnā","Leave us","\"আমাদের ছেড়ে দিন"],["نَكُن","nakun","(to) be","আমরা থাকবো"],["مَّعَ","ma‘a","with","সাথে"],["ٱلْقَـٰعِدِينَ","l-qā‘idīna","those who sit","বসে থাকা লোকদের\""]],"t":"وَإِ<o>ذَآ</> أُ<k>نزِ</>لَتْ سُورَةٌ أَنْ ءَامِنُو<s>ا۟</> بِ<h>ٱ</>للَّهِ وَ<m>جَٰ</>هِدُو<s>ا۟</> مَعَ رَسُولِهِ <h>ٱ</>سْتَـْٔذَنَكَ أُ<s>و۟</>لُو<s>ا۟</> <h>ٱ</><l>ل</>طَّوْلِ مِنْهُمْ وَقَالُو<s>ا۟</> ذَرْنَا نَ<d>كُن مَّ</>عَ <h>ٱ</>لْ<m>قَٰ</>عِ<p>دِي</>نَ"},{"n":87,"w":[["رَضُوا۟","raḍū","They (were) satisfied","তারা পছন্দ করেছে"],["بِأَن","bi-an","to","নিয়ে যে"],["يَكُونُوا۟","yakūnū","be","তারা থাকবে"],["مَعَ","ma‘a","with","সাথে"],["ٱلْخَوَالِفِ","l-khawālifi","those who stay behind","অন্তঃপুরবাসিনীদের"],["وَطُبِعَ","waṭubi‘a","and were sealed","ও সীল করা হয়েছে"],["عَلَىٰ","‘alā","[on]","উপর"],["قُلُوبِهِمْ","qulūbihim","their hearts","অন্তরসমূহের তাদের"],["فَهُمْ","fahum","so they","অতএব তারা"],["لَا","lā","(do) not","না"],["يَفْقَهُونَ","yafqahūna","understand","তারা বুঝে"]],"t":"رَضُو<s>ا۟</> بِ<d>أَن يَ</>كُونُو<s>ا۟</> مَعَ <h>ٱ</>لْخَوَالِفِ وَطُبِعَ عَلَىٰ قُلُوبِهِمْ فَهُمْ لَا يَفْقَ<p>هُو</>نَ"},{"n":88,"w":[["لَـٰكِنِ","lākini","But","কিন্তু"],["ٱلرَّسُولُ","l-rasūlu","the Messenger","রাসূল"],["وَٱلَّذِينَ","wa-alladhīna","and those who","ও যারা"],["ءَامَنُوا۟","āmanū","believed","ঈমান এনেছে"],["مَعَهُۥ","ma‘ahu","with him","সাথে তার"],["جَـٰهَدُوا۟","jāhadū","strove","জিহাদ করেছে"],["بِأَمْوَٰلِهِمْ","bi-amwālihim","with their wealth","দিয়ে ধনসম্পদ তাদের"],["وَأَنفُسِهِمْ ۚ","wa-anfusihim","and their lives","ও প্রাণ (দিয়ে)তাদের"],["وَأُو۟لَـٰٓئِكَ","wa-ulāika","And those","ও ঐসব লোক"],["لَهُمُ","lahumu","for them","জন্যে তাদের (রয়েছে)"],["ٱلْخَيْرَٰتُ ۖ","l-khayrātu","(are) the good things","সব কল্যাণ"],["وَأُو۟لَـٰٓئِكَ","wa-ulāika","and those ","ও ঐসব লোক"],["هُمُ","humu","they","তারাই"],["ٱلْمُفْلِحُونَ","l-muf'liḥūna","(are) the successful ones","সফলকাম"]],"t":"<m>لَٰ</>كِنِ <h>ٱ</><l>ل</>رَّسُولُ وَ<h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> مَعَهُ<m>ۥ جَٰ</>هَدُو<s>ا۟</> بِأَمْ<m>وَٰ</>لِهِمْ وَأَ<k>نفُ</>سِهِمْ ۚ وَأُ<s>و۟</><o>لَٰٓ</>ئِكَ لَهُمُ <h>ٱ</>لْخَيْ<m>رَٰ</>تُ ۖ وَأُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</>لْمُفْلِ<p>حُو</>نَ"},{"n":89,"w":[["أَعَدَّ","a‘adda","Allah has prepared","প্রস্তুত করে রেখেছেন"],["ٱللَّهُ","l-lahu","Allah has prepared","আল্লাহ"],["لَهُمْ","lahum","for them","জন্যে তাদের"],["جَنَّـٰتٍۢ","jannātin","Gardens","জান্নাত"],["تَجْرِى","tajrī","flows","প্রবাহিত হয়"],["مِن","min","from","থেকে"],["تَحْتِهَا","taḥtihā","underneath it","নিচ তার"],["ٱلْأَنْهَـٰرُ","l-anhāru","the rivers","ঝর্ণাধারা"],["خَـٰلِدِينَ","khālidīna","(will) abide forever","তারা চিরিস্থায়ী হবে"],["فِيهَا ۚ","fīhā","in it","মধ্যে তার"],["ذَٰلِكَ","dhālika","That","এটা"],["ٱلْفَوْزُ","l-fawzu","(is) the success","সাফল্য"],["ٱلْعَظِيمُ","l-‘aẓīmu","the great","মহা"]],"t":"أَعَدَّ <h>ٱ</>للَّهُ لَهُمْ جَ<g>نَّٰ</><k>تٍۢ تَ</><q>جْ</>رِى مِ<k>ن تَ</>حْتِهَا <h>ٱ</>لْأَنْ<m>هَٰ</>رُ <m>خَٰ</>لِدِينَ فِيهَا ۚ <m>ذَٰ</>لِكَ <h>ٱ</>لْفَوْزُ <h>ٱ</>لْعَ<p>ظِي</>مُ"},{"n":90,"w":[["وَجَآءَ","wajāa","And came","এবং আসলো"],["ٱلْمُعَذِّرُونَ","l-mu‘adhirūna","the ones who make excuses","অজুহাত পেশকারীরা"],["مِنَ","mina","of","মধ্যে হতে"],["ٱلْأَعْرَابِ","l-a‘rābi","the bedouins","বেদুঈনদের"],["لِيُؤْذَنَ","liyu'dhana","that permission be granted","অব্যাহতি দেয়া হয়"],["لَهُمْ","lahum","to them","জন্যে তাদের"],["وَقَعَدَ","waqa‘ada","and sat","এবং (এভাবে) বসে থাকলো"],["ٱلَّذِينَ","alladhīna","those who","(এসব লোক) যারা"],["كَذَبُوا۟","kadhabū","lied","মিথ্যা বলেছিলো (ঈমানের ওয়াদায়)"],["ٱللَّهَ","l-laha","(to) Allah","আল্লাহকে"],["وَرَسُولَهُۥ ۚ","warasūlahu","and His Messenger","ও তাঁর রাসূলকে"],["سَيُصِيبُ","sayuṣību","Will strike","শীঘ্রই পৌঁছবে"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["كَفَرُوا۟","kafarū","disbelieved","অস্বীকার করেছিলো"],["مِنْهُمْ","min'hum","among them","মধ্য হতে তাদের"],["عَذَابٌ","‘adhābun","a punishment","শাস্তি"],["أَلِيمٌۭ","alīmun","painful","নিদারুণ"]],"t":"وَ<o>جَآ</>ءَ <h>ٱ</>لْمُعَذِّرُونَ مِنَ <h>ٱ</>لْأَعْرَابِ لِيُؤْذَنَ لَهُمْ وَقَعَدَ <h>ٱ</>لَّذِينَ كَذَبُو<s>ا۟</> <h>ٱ</>للَّهَ وَرَسُولَهُ<m>ۥ</> ۚ سَيُصِيبُ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> مِنْهُمْ عَذَابٌ أَ<p>لِي</>مٌۭ"},{"n":91,"w":[["لَّيْسَ","laysa","Not","নেই (কোনো অপরাধ)"],["عَلَى","‘alā","on","উপর"],["ٱلضُّعَفَآءِ","l-ḍu‘afāi","the weak","দুর্বলদের"],["وَلَا","walā","and not","ও না"],["عَلَى","‘alā","on","উপর"],["ٱلْمَرْضَىٰ","l-marḍā","the sick","রোগীদের"],["وَلَا","walā","and not","এবং না"],["عَلَى","‘alā","on","উপর"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["لَا","lā","not","না"],["يَجِدُونَ","yajidūna","they find","(এমন সম্বল) পায়"],["مَا","mā","what","যা"],["يُنفِقُونَ","yunfiqūna","they (can) spend","তারা ব্যয় করবে"],["حَرَجٌ","ḥarajun","any blame","কোনো অপরাধ (নাই তাদেরও)"],["إِذَا","idhā","if","যখন"],["نَصَحُوا۟","naṣaḥū","they (are) sincere","তারা কল্যাণ কামনা করে"],["لِلَّهِ","lillahi","to Allah","জন্যে আল্লাহর"],["وَرَسُولِهِۦ ۚ","warasūlihi","and His Messenger","ও রাসূলের তাঁর(জন্যে)"],["مَا","mā","Not","নেই"],["عَلَى","‘alā","(is) on","উপর"],["ٱلْمُحْسِنِينَ","l-muḥ'sinīna","the good-doers","সৎকর্মশীলদের"],["مِن","min","any","কোনো"],["سَبِيلٍۢ ۚ","sabīlin","way (for blame)","পথ (অভিযোগের)"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["غَفُورٌۭ","ghafūrun","(is) Oft-Forgiving","ক্ষমাশীল"],["رَّحِيمٌۭ","raḥīmun","Most Merciful","পরম দয়ালু"]],"t":"لَّيْسَ عَلَى <h>ٱ</><l>ل</>ضُّعَ<o>فَآ</>ءِ وَلَا عَلَى <h>ٱ</>لْمَرْضَىٰ وَلَا عَلَى <h>ٱ</>لَّذِينَ لَا يَجِدُونَ مَا يُ<k>نفِ</>قُونَ حَرَجٌ إِذَا نَصَحُو<s>ا۟</> لِلَّهِ وَرَسُولِ<m>هِۦ</> ۚ مَا عَلَى <h>ٱ</>لْمُحْسِنِينَ مِ<k>ن سَ</>بِي<d>لٍۢ ۚ وَ</><h>ٱ</>للَّهُ غَفُو<w>رٌۭ رَّ</><p>حِي</>مٌۭ"},{"n":92,"w":[["وَلَا","walā","And not","এবং নেই(দোষ)"],["عَلَى","‘alā","on","উপর"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["إِذَا","idhā","when","যখন"],["مَآ","mā","when","যা"],["أَتَوْكَ","atawka","they came to you","তোমার কাছে এসেছিলো"],["لِتَحْمِلَهُمْ","litaḥmilahum","that you provide them with mounts","যেন তুমি তাদের বাহনের ব্যবস্হা করে দাও"],["قُلْتَ","qul'ta","you said","তুমি বলেছিলে"],["لَآ","lā","Not","\"না"],["أَجِدُ","ajidu","I find","পাচ্ছি"],["مَآ","mā","what","(এমন কিছু) যা"],["أَحْمِلُكُمْ","aḥmilukum","to mount you","তোমাদেরকে বহন করার আমি"],["عَلَيْهِ","‘alayhi","on [it]","উপর তার"],["تَوَلَّوا۟","tawallaw","They turned back","তারা ফিরে গিয়েছে"],["وَّأَعْيُنُهُمْ","wa-a‘yunuhum","with their eyes","এ অবস্থায় যে তাদের চোখগুলো"],["تَفِيضُ","tafīḍu","flowing","ঝরাচ্ছিলো"],["مِنَ","mina","[of]","থেকে"],["ٱلدَّمْعِ","l-dam‘i","(with) the tears","অশ্রু"],["حَزَنًا","ḥazanan","(of) sorrow","দুঃখে"],["أَلَّا","allā","that not","যে না"],["يَجِدُوا۟","yajidū","they find","তারা পাচ্ছে (এমন কিছু)"],["مَا","mā","what","যা"],["يُنفِقُونَ","yunfiqūna","they (could) spend","তারা ব্যয় করবে"]],"t":"وَلَا عَلَى <h>ٱ</>لَّذِينَ إِذَا <o>مَآ</> أَتَوْكَ لِتَحْمِلَهُمْ قُلْتَ <o>لَآ</> أَجِدُ <o>مَآ</> أَحْمِلُكُمْ عَلَيْهِ تَوَلَّو<s>ا۟</> وَّأَعْيُنُهُمْ تَفِيضُ مِنَ <h>ٱ</><l>ل</>دَّمْعِ حَزَنًا أَلَّا يَجِدُو<s>ا۟</> مَا يُ<k>نفِ</><p>قُو</>نَ"},{"n":93,"w":[["۞ إِنَّمَا","innamā","Only","প্রকৃতপক্ষে"],["ٱلسَّبِيلُ","l-sabīlu","the way (blame)","(অভিযোগের)পথ"],["عَلَى","‘alā","(is) on","(তাদের) উপর"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["يَسْتَـْٔذِنُونَكَ","yastadhinūnaka","ask your permission","তোমার কাছে অব্যাহতি চায়"],["وَهُمْ","wahum","while they","এ অবস্থায় যে তারা"],["أَغْنِيَآءُ ۚ","aghniyāu","(are) rich","ধনী লোক"],["رَضُوا۟","raḍū","They (are) satisfied","তারা পছন্দ করেছে"],["بِأَن","bi-an","to","নিয়ে যে"],["يَكُونُوا۟","yakūnū","be","তারা থাকবে (বসে)"],["مَعَ","ma‘a","with","সাথে"],["ٱلْخَوَالِفِ","l-khawālifi","those who stay behind","অন্তঃপুরবাসিনীদের"],["وَطَبَعَ","waṭaba‘a","and Allah sealed","ও সীল মেরে দিয়েছেন"],["ٱللَّهُ","l-lahu","and Allah sealed","আল্লাহ"],["عَلَىٰ","‘alā","[on]","উপর"],["قُلُوبِهِمْ","qulūbihim","their hearts","অন্তরের তাদের"],["فَهُمْ","fahum","so they","তাই তারা"],["لَا","lā","(do) not","না (কিছুই)"],["يَعْلَمُونَ","ya‘lamūna","know","জানতে পারে"]],"t":"۞ إِ<g>نَّ</>مَا <h>ٱ</><l>ل</>سَّبِيلُ عَلَى <h>ٱ</>لَّذِينَ يَسْتَـْٔذِنُونَكَ وَهُمْ أَغْنِ<o>يَآ</>ءُ ۚ رَضُو<s>ا۟</> بِ<d>أَن يَ</>كُونُو<s>ا۟</> مَعَ <h>ٱ</>لْخَوَالِفِ وَطَبَعَ <h>ٱ</>للَّهُ عَلَىٰ قُلُوبِهِمْ فَهُمْ لَا يَعْلَ<p>مُو</>نَ"},{"n":94,"w":[["يَعْتَذِرُونَ","ya‘tadhirūna","They will make excuses","তারা অজুহাত পেশ করবে"],["إِلَيْكُمْ","ilaykum","to you","কাছে তোমাদের"],["إِذَا","idhā","when","যখন"],["رَجَعْتُمْ","raja‘tum","you (have) returned","তোমরা ফিরে যাবে"],["إِلَيْهِمْ ۚ","ilayhim","to them","নিকট তাদের"],["قُل","qul","Say","বলো"],["لَّا","lā","(Do) not","\"না"],["تَعْتَذِرُوا۟","ta‘tadhirū","make excuse","তোমরা অজুহাত পেশ করো"],["لَن","lan","never","কখনও না"],["نُّؤْمِنَ","nu'mina","we will believe","বিশ্বাস করব আমরা"],["لَكُمْ","lakum","you","প্রতি তোমাদের"],["قَدْ","qad","Verily","নিশ্চয়ই"],["نَبَّأَنَا","nabba-anā","Allah (has) informed us","আমাদের জানিয়ে দিয়েছেন"],["ٱللَّهُ","l-lahu","Allah (has) informed us","আল্লাহ"],["مِنْ","min","of","হতে"],["أَخْبَارِكُمْ ۚ","akhbārikum","your news","সংবাদ তোমাদের"],["وَسَيَرَى","wasayarā","and Allah will see","এবং শীঘ্রই দেখবেন"],["ٱللَّهُ","l-lahu","and Allah will see","আল্লাহ"],["عَمَلَكُمْ","‘amalakum","your deeds","কাজকর্ম তোমাদের"],["وَرَسُولُهُۥ","warasūluhu","and His Messenger","ও রাসূল তাঁর"],["ثُمَّ","thumma","Then","এরপর"],["تُرَدُّونَ","turaddūna","you will be brought back","প্রত্যাবর্তিত হবে তোমরা"],["إِلَىٰ","ilā","to","(তাঁর) দিকে"],["عَـٰلِمِ","‘ālimi","(the) Knower","(যিনি) খুব অবহিত"],["ٱلْغَيْبِ","l-ghaybi","(of) the unseen","অদৃশ্যের"],["وَٱلشَّهَـٰدَةِ","wal-shahādati","and the seen","ও দৃশ্যের"],["فَيُنَبِّئُكُم","fayunabbi-ukum","then He will inform you","তখন জানিয়ে দিবেন তোমাদের"],["بِمَا","bimā","of what","ঐ বিষয়ে যা"],["كُنتُمْ","kuntum","you used (to)","তোমরা ছিলে"],["تَعْمَلُونَ","ta‘malūna","do","কাজ করতে"]],"t":"يَعْتَذِرُونَ إِلَيْكُمْ إِذَا رَجَعْتُمْ إِلَيْهِمْ ۚ قُل لَّا تَعْتَذِرُو<s>ا۟</> <d>لَن نُّ</>ؤْمِنَ لَكُمْ قَ<q>دْ</> نَبَّأَنَا <h>ٱ</>للَّهُ مِنْ أَخْبَارِكُمْ ۚ وَسَيَرَى <h>ٱ</>للَّهُ عَمَلَكُمْ وَرَسُولُهُ<m>ۥ</> ثُ<g>مَّ</> تُرَدُّونَ إِلَىٰ <m>عَٰ</>لِمِ <h>ٱ</>لْغَيْبِ وَ<h>ٱ</><l>ل</>شَّ<m>هَٰ</>دَةِ فَيُنَبِّئُ<f>كُم بِ</>مَا كُ<k>نتُ</>مْ تَعْمَ<p>لُو</>نَ"},{"n":95,"w":[["سَيَحْلِفُونَ","sayaḥlifūna","They will swear","শীঘ্রই তারা শপথ করে বলবে"],["بِٱللَّهِ","bil-lahi","by Allah","নামে আল্লাহর"],["لَكُمْ","lakum","to you","উদ্দেশ্যে তোমাদের"],["إِذَا","idhā","when","যখন"],["ٱنقَلَبْتُمْ","inqalabtum","you returned","ফিরে যাবে তোমরা"],["إِلَيْهِمْ","ilayhim","to them","দিকে তাদের"],["لِتُعْرِضُوا۟","litu‘'riḍū","that you may turn away","যেন তোমরা উপেক্ষা করো"],["عَنْهُمْ ۖ","‘anhum","from them","ব্যাপারে তাদের"],["فَأَعْرِضُوا۟","fa-a‘riḍū","So turn away","তাই তোমরা উপেক্ষা করো"],["عَنْهُمْ ۖ","‘anhum","from them","ব্যাপারে তাদের"],["إِنَّهُمْ","innahum","indeed, they","নিশ্চয়ই তারা"],["رِجْسٌۭ ۖ","rij'sun","(are) impure","অপবিত্র"],["وَمَأْوَىٰهُمْ","wamawāhum","and their abode","এবং আবাসস্থল তাদের"],["جَهَنَّمُ","jahannamu","(is) Hell","জাহান্নাম"],["جَزَآءًۢ","jazāan","a recompense","প্রতিফল (স্বরূপ)"],["بِمَا","bimā","for what","ঐ বিষয়ের যা"],["كَانُوا۟","kānū","they used (to)","তারা ছিলো"],["يَكْسِبُونَ","yaksibūna","earn","তারা উপার্জন করে আসতে"]],"t":"سَيَحْلِفُونَ بِ<h>ٱ</>للَّهِ لَكُمْ إِذَا <h>ٱ</><k>نقَ</>لَ<q>بْ</>تُمْ إِلَيْهِمْ لِتُعْرِضُو<s>ا۟</> عَنْهُمْ ۖ فَأَعْرِضُو<s>ا۟</> عَنْهُمْ ۖ إِ<g>نَّ</>هُمْ رِ<q>جْ</><d>سٌۭ ۖ وَ</>مَأْوَ<m>ىٰ</>هُمْ جَهَ<g>نَّ</>مُ جَ<o>زَآ</><i>ءًۢ بِ</>مَا كَانُو<s>ا۟</> يَكْسِ<p>بُو</>نَ"},{"n":96,"w":[["يَحْلِفُونَ","yaḥlifūna","They swear","শপথ করে তারা বলবে"],["لَكُمْ","lakum","to you","উদ্দেশ্যে তোমাদের"],["لِتَرْضَوْا۟","litarḍaw","that you may be pleased","যেন তোমরা সন্তুষ্ট হও"],["عَنْهُمْ ۖ","‘anhum","with them","ব্যাপারে তাদের"],["فَإِن","fa-in","But if","অতঃপর যদি"],["تَرْضَوْا۟","tarḍaw","you are pleased","তোমরা সন্তুষ্ট হও"],["عَنْهُمْ","‘anhum","with them","ব্যাপারে তাদের"],["فَإِنَّ","fa-inna","then indeed","তবে নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَا","lā","(is) not pleased","না"],["يَرْضَىٰ","yarḍā","(is) not pleased","সন্তুষ্ট হন"],["عَنِ","‘ani","with","হতে"],["ٱلْقَوْمِ","l-qawmi","the people","(এমন)সম্প্রদায়"],["ٱلْفَـٰسِقِينَ","l-fāsiqīna","(who are) defiantly disobedient","(যারা)সত্যত্যাগী"]],"t":"يَحْلِفُونَ لَكُمْ لِتَرْضَوْ<s>ا۟</> عَنْهُمْ ۖ فَإِ<k>ن تَ</>رْضَوْ<s>ا۟</> عَنْهُمْ فَإِ<g>نَّ</> <h>ٱ</>للَّهَ لَا يَرْضَىٰ عَنِ <h>ٱ</>لْقَوْمِ <h>ٱ</>لْ<m>فَٰ</>سِ<p>قِي</>نَ"},{"n":97,"w":[["ٱلْأَعْرَابُ","al-a‘rābu","The bedouins","বেদুঈনরা"],["أَشَدُّ","ashaddu","(are) stronger","কঠোরতর"],["كُفْرًۭا","kuf'ran","(in) disbelief","অবিশ্বাসে"],["وَنِفَاقًۭا","wanifāqan","and hypocrisy","ও কপটতায়"],["وَأَجْدَرُ","wa-ajdaru","and more likely","এবং বেশি উপযুক্ত"],["أَلَّا","allā","that not","যে না"],["يَعْلَمُوا۟","ya‘lamū","they know","তারা জানবে"],["حُدُودَ","ḥudūda","(the) limits","সীমারেখা"],["مَآ","mā","(of) what","যা"],["أَنزَلَ","anzala","Allah (has) revealed","অবতীর্ণ করেছেন"],["ٱللَّهُ","l-lahu","Allah (has) revealed","আল্লাহ"],["عَلَىٰ","‘alā","to","উপর"],["رَسُولِهِۦ ۗ","rasūlihi","His Messenger","রাসূলের তাঁর"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["عَلِيمٌ","‘alīmun","(is) All-Knower","মহাজ্ঞানী"],["حَكِيمٌۭ","ḥakīmun","All-Wise","মহাবিজ্ঞ"]],"t":"ٱلْأَعْرَابُ أَشَدُّ كُفْ<d>رًۭا وَ</>نِفَا<d>قًۭا وَ</>أَ<q>جْ</>دَرُ أَلَّا يَعْلَمُو<s>ا۟</> حُدُودَ <o>مَآ</> أَ<k>نزَ</>لَ <h>ٱ</>للَّهُ عَلَىٰ رَسُولِ<m>هِۦ</> ۗ وَ<h>ٱ</>للَّهُ عَلِيمٌ حَ<p>كِي</>مٌۭ"},{"n":98,"w":[["وَمِنَ","wamina","And among","এবং মধ্য থেকে"],["ٱلْأَعْرَابِ","l-a‘rābi","the bedouins","বেদুঈনদের"],["مَن","man","(is he) who","কেউ কেউ"],["يَتَّخِذُ","yattakhidhu","takes","মনর করে"],["مَا","mā","what","যা"],["يُنفِقُ","yunfiqu","he spends","ব্যয় করে (আল্লাহর পথে)"],["مَغْرَمًۭا","maghraman","(as) a loss","জরিমানাস্বরূপ"],["وَيَتَرَبَّصُ","wayatarabbaṣu","and he awaits","ও অপেক্ষা করে"],["بِكُمُ","bikumu","for you","জন্যে তোমাদের"],["ٱلدَّوَآئِرَ ۚ","l-dawāira","the turns (of misfortune)","ভাগ্যচক্রের পরিবর্তনের (অর্থাৎ অমঙ্গলের)"],["عَلَيْهِمْ","‘alayhim","Upon them","তাদের  উপর (আসছে)"],["دَآئِرَةُ","dāiratu","(will be) the turn","ভাগ্য বিপর্যয়"],["ٱلسَّوْءِ ۗ","l-sawi","(of) the evil","খারাপ"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["سَمِيعٌ","samī‘un","(is) All-Hearer","সবকিছু শুনেন"],["عَلِيمٌۭ","‘alīmun","All-Knower","সবকিছু জানেন"]],"t":"وَمِنَ <h>ٱ</>لْأَعْرَابِ <d>مَن يَ</>تَّخِذُ مَا يُ<k>نفِ</>قُ مَغْرَ<d>مًۭا وَ</>يَتَرَبَّصُ بِكُمُ <h>ٱ</><l>ل</>دَّ<o>وَآ</>ئِرَ ۚ عَلَيْهِمْ <o>دَآ</>ئِرَةُ <h>ٱ</><l>ل</>سَّوْءِ ۗ وَ<h>ٱ</>للَّهُ سَمِيعٌ عَ<p>لِي</>مٌۭ"},{"n":99,"w":[["وَمِنَ","wamina","But among","এবং মধ্য হতে"],["ٱلْأَعْرَابِ","l-a‘rābi","the bedouins","বেদুঈনদের"],["مَن","man","(is he) who","কেউ কেউ"],["يُؤْمِنُ","yu'minu","believes","বিশ্বাস করে"],["بِٱللَّهِ","bil-lahi","in Allah","উপর আল্লাহর"],["وَٱلْيَوْمِ","wal-yawmi","and the Day","এবং দিনে"],["ٱلْـَٔاخِرِ","l-ākhiri","the Last","আখেরাতের"],["وَيَتَّخِذُ","wayattakhidhu","and takes","ও মনে করে"],["مَا","mā","what","যা"],["يُنفِقُ","yunfiqu","he spends","ব্যয় করে (আল্লাহর পথে)"],["قُرُبَـٰتٍ","qurubātin","(as) means of nearness","সান্নিধ্য লাভের উপায়"],["عِندَ","‘inda","with","কাছে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["وَصَلَوَٰتِ","waṣalawāti","and blessings","ও দোয়ার (মাধ্যম হিসেবে)"],["ٱلرَّسُولِ ۚ","l-rasūli","(of) the Messenger","রাসূলের"],["أَلَآ","alā","Behold","জেনে রাখো"],["إِنَّهَا","innahā","Indeed, it","নিশ্চয়ই তা"],["قُرْبَةٌۭ","qur'batun","(is) a means of nearness","সান্নিধ্য লাভের মাধ্যম"],["لَّهُمْ ۚ","lahum","for them","জন্যে তাদের"],["سَيُدْخِلُهُمُ","sayud'khiluhumu","Allah will admit them","শীঘ্রই প্রবেশ করাবেন তাদের"],["ٱللَّهُ","l-lahu","Allah will admit them","আল্লাহ"],["فِى","fī","to","মধ্যে"],["رَحْمَتِهِۦٓ ۗ","raḥmatihi","His Mercy","দয়ার তাঁর"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["غَفُورٌۭ","ghafūrun","(is) Oft-Forgiving","ক্ষমাশীল"],["رَّحِيمٌۭ","raḥīmun","Most Merciful","পরম দয়ালু"]],"t":"وَمِنَ <h>ٱ</>لْأَعْرَابِ <d>مَن يُ</>ؤْمِنُ بِ<h>ٱ</>للَّهِ وَ<h>ٱ</>لْيَوْمِ <h>ٱ</>لْءَاخِرِ وَيَتَّخِذُ مَا يُ<k>نفِ</>قُ قُرُ<m>بَٰ</>تٍ عِ<k>ندَ</> <h>ٱ</>للَّهِ وَصَلَ<m>وَٰ</>تِ <h>ٱ</><l>ل</>رَّسُولِ ۚ أَ<o>لَآ</> إِ<g>نَّ</>هَا قُرْبَ<w>ةٌۭ لَّ</>هُمْ ۚ سَيُ<q>دْ</>خِلُهُمُ <h>ٱ</>للَّهُ فِى رَحْمَتِ<o>هِۦٓ ۗ</> إِ<g>نَّ</> <h>ٱ</>للَّهَ غَفُو<w>رٌۭ رَّ</><p>حِي</>مٌۭ"},{"n":100,"w":[["وَٱلسَّـٰبِقُونَ","wal-sābiqūna","And the forerunners","ও অগ্রগামীরা"],["ٱلْأَوَّلُونَ","l-awalūna","the first","প্রথম"],["مِنَ","mina","among","মধ্য হতে"],["ٱلْمُهَـٰجِرِينَ","l-muhājirīna","the emigrants","মুহাজেরদের"],["وَٱلْأَنصَارِ","wal-anṣāri","and the helpers","ও আনসারদের"],["وَٱلَّذِينَ","wa-alladhīna","and those who","ও যারা"],["ٱتَّبَعُوهُم","ittaba‘ūhum","followed them","অনুসরণ করেছে তাদের"],["بِإِحْسَـٰنٍۢ","bi-iḥ'sānin","in righteousness","সাথে সততার"],["رَّضِىَ","raḍiya","Allah is pleased","সন্তুষ্ট হয়েছেন"],["ٱللَّهُ","l-lahu","Allah is pleased","আল্লাহ"],["عَنْهُمْ","‘anhum","with them","উপর তাদের"],["وَرَضُوا۟","waraḍū","and they are pleased","ও তারা খুশি হয়েছে"],["عَنْهُ","‘anhu","with Him","উপর তাঁর"],["وَأَعَدَّ","wa-a‘adda","And He has prepared","ও প্রস্তুত করে তিনি রেখেছেন"],["لَهُمْ","lahum","for them","জন্যে তাদের"],["جَنَّـٰتٍۢ","jannātin","Gardens","জান্নাত"],["تَجْرِى","tajrī","flows","প্রবাহিত হয়"],["تَحْتَهَا","taḥtahā","underneath it","নিচে তার"],["ٱلْأَنْهَـٰرُ","l-anhāru","the rivers","ঝর্নাধারা"],["خَـٰلِدِينَ","khālidīna","will abide","তারা স্হায়ী হবে"],["فِيهَآ","fīhā","in it","মধ্যে তার"],["أَبَدًۭا ۚ","abadan","forever","চিরকাল"],["ذَٰلِكَ","dhālika","That","এটাই"],["ٱلْفَوْزُ","l-fawzu","(is) the success","সফলতা"],["ٱلْعَظِيمُ","l-‘aẓīmu","the great","মহা"]],"t":"وَ<h>ٱ</><l>ل</><m>سَّٰ</>بِقُونَ <h>ٱ</>لْأَوَّلُونَ مِنَ <h>ٱ</>لْمُ<m>هَٰ</>جِرِينَ وَ<h>ٱ</>لْأَ<k>نصَ</>ارِ وَ<h>ٱ</>لَّذِينَ <h>ٱ</>تَّبَعُو<f>هُم بِ</>إِحْ<m>سَٰ</><w>نٍۢ رَّ</>ضِىَ <h>ٱ</>للَّهُ عَنْهُمْ وَرَضُو<s>ا۟</> عَنْهُ وَأَعَدَّ لَهُمْ جَ<g>نَّٰ</><k>تٍۢ تَ</><q>جْ</>رِى تَحْتَهَا <h>ٱ</>لْأَنْ<m>هَٰ</>رُ <m>خَٰ</>لِدِينَ فِي<o>هَآ</> أَبَ<k>دًۭا ۚ ذَٰ</>لِكَ <h>ٱ</>لْفَوْزُ <h>ٱ</>لْعَ<p>ظِي</>مُ"},{"n":101,"w":[["وَمِمَّنْ","wamimman","And among those","এবং মধ্যে তাদের যারা"],["حَوْلَكُم","ḥawlakum","around you","তোমাদের আশপাশে(আছে)"],["مِّنَ","mina","of","কেউ কেউ"],["ٱلْأَعْرَابِ","l-a‘rābi","the bedouins","বেদুঈনদের"],["مُنَـٰفِقُونَ ۖ","munāfiqūna","(are) hypocrites","(অনেকেই) মুনাফেক"],["وَمِنْ","wamin","and (also) from","এবং কেউ কেউ"],["أَهْلِ","ahli","people","অধিবাসী"],["ٱلْمَدِينَةِ ۖ","l-madīnati","(of) the Madinah","মাদীনাহ"],["مَرَدُوا۟","maradū","They persist","তারা চরমে পৌঁছে গিয়েছে"],["عَلَى","‘alā","in","ক্ষেত্রে"],["ٱلنِّفَاقِ","l-nifāqi","the hypocrisy","কপটতার"],["لَا","lā","not","না"],["تَعْلَمُهُمْ ۖ","ta‘lamuhum","you know them","জানো তুমি তাদের"],["نَحْنُ","naḥnu","We","আমরা"],["نَعْلَمُهُمْ ۚ","na‘lamuhum","[We] know them","জানি তাদের"],["سَنُعَذِّبُهُم","sanu‘adhibuhum","We will punish them","শীঘ্রই আমরা শাস্তি দিবো তাদের"],["مَّرَّتَيْنِ","marratayni","twice","দু'বার"],["ثُمَّ","thumma","then","এরপর"],["يُرَدُّونَ","yuraddūna","they will be returned","তাদের ফিরিয়ে নেয়া হবে"],["إِلَىٰ","ilā","to","দিকে"],["عَذَابٍ","‘adhābin","a punishment","শাস্তির"],["عَظِيمٍۢ","‘aẓīmin","great","কঠোর"]],"t":"وَمِ<g>مَّ</>نْ حَوْلَ<y>كُم مِّ</>نَ <h>ٱ</>لْأَعْرَابِ مُ<m>نَٰ</>فِقُونَ ۖ وَمِنْ أَهْلِ <h>ٱ</>لْمَدِينَةِ ۖ مَرَدُو<s>ا۟</> عَلَى <h>ٱ</><l>ل</><g>نِّ</>فَاقِ لَا تَعْلَمُهُمْ ۖ نَحْنُ نَعْلَمُهُمْ ۚ سَنُعَذِّبُ<y>هُم مَّ</>رَّتَيْنِ ثُ<g>مَّ</> يُرَدُّونَ إِلَىٰ عَذَابٍ عَ<p>ظِي</>مٍۢ"},{"n":102,"w":[["وَءَاخَرُونَ","waākharūna","And others","এবং আরো কিছু লোক (আছে)"],["ٱعْتَرَفُوا۟","i‘'tarafū","(who have) acknowledged","তারা স্বীকার করেছে"],["بِذُنُوبِهِمْ","bidhunūbihim","their sins","অপরাধ তাদের"],["خَلَطُوا۟","khalaṭū","They had mixed","তারা মিশিয়ে ফেলেছে"],["عَمَلًۭا","‘amalan","a deed","(কিছু) কাজ"],["صَـٰلِحًۭا","ṣāliḥan","righteous","ভালো"],["وَءَاخَرَ","waākhara","(with) other","ও অন্য কিছু"],["سَيِّئًا","sayyi-an","(that was) evil","(কাজ) মন্দ"],["عَسَى","‘asā","Perhaps","আশা করা যায়"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["أَن","an","[that]","যে"],["يَتُوبَ","yatūba","will turn (in mercy)","ক্ষমা করবেন"],["عَلَيْهِمْ ۚ","‘alayhim","to them","প্রতি তাদের"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["غَفُورٌۭ","ghafūrun","(is) Oft-Forgiving","ক্ষমাশীল"],["رَّحِيمٌ","raḥīmun","Most Merciful","পরম দয়ালু"]],"t":"وَءَاخَرُونَ <h>ٱ</>عْتَرَفُو<s>ا۟</> بِذُنُوبِهِمْ خَلَطُو<s>ا۟</> عَمَلًۭ<k>ا صَٰ</>لِ<d>حًۭا وَ</>ءَاخَرَ سَيِّئًا عَسَى <h>ٱ</>للَّهُ <d>أَن يَ</>تُوبَ عَلَيْهِمْ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ غَفُو<w>رٌۭ رَّ</><p>حِي</>مٌ"},{"n":103,"w":[["خُذْ","khudh","Take","গ্রহণ করো"],["مِنْ","min","from","হতে"],["أَمْوَٰلِهِمْ","amwālihim","their wealth","ধনসম্পদ তাদের"],["صَدَقَةًۭ","ṣadaqatan","a charity","সদকা"],["تُطَهِّرُهُمْ","tuṭahhiruhum","purifying them","তুমি পবিত্র করবে তাদের"],["وَتُزَكِّيهِم","watuzakkīhim","and cause them increase","ও পরিশুদ্ধি করবে তাদের"],["بِهَا","bihā","by it","দিয়ে তা"],["وَصَلِّ","waṣalli","and bless","ও দোয়া করো তুমি"],["عَلَيْهِمْ ۖ","‘alayhim","[upon] them","জন্যে তাদের"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["صَلَوٰتَكَ","ṣalataka","your blessings","দোয়া তোমার"],["سَكَنٌۭ","sakanun","(are a) reassurance","প্রশান্তি"],["لَّهُمْ ۗ","lahum","for them","জন্যে তাদের"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["سَمِيعٌ","samī‘un","(is) All-Hearer","সব শুনেন"],["عَلِيمٌ","‘alīmun","All-Knower","সব জানেন"]],"t":"خُذْ مِنْ أَمْ<m>وَٰ</>لِهِمْ صَدَقَ<k>ةًۭ تُ</>طَهِّرُهُمْ وَتُزَكِّي<f>هِم بِ</>هَا وَصَلِّ عَلَيْهِمْ ۖ إِ<g>نَّ</> صَلَ<s>وٰ</>تَكَ سَكَ<w>نٌۭ لَّ</>هُمْ ۗ وَ<h>ٱ</>للَّهُ سَمِيعٌ عَ<p>لِي</>مٌ"},{"n":104,"w":[["أَلَمْ","alam","Do not","কি না"],["يَعْلَمُوٓا۟","ya‘lamū","they know","তারা জানে"],["أَنَّ","anna","that","যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["هُوَ","huwa","(is) He","তিনিই (যিনি)"],["يَقْبَلُ","yaqbalu","(Who) accepts","গ্রহণ করেন"],["ٱلتَّوْبَةَ","l-tawbata","the repentance","তওবা"],["عَنْ","‘an","from","হতে"],["عِبَادِهِۦ","‘ibādihi","His slaves","দাসদের তাঁর"],["وَيَأْخُذُ","wayakhudhu","and takes","ও গ্রহণ করেন"],["ٱلصَّدَقَـٰتِ","l-ṣadaqāti","the charities","সদকা"],["وَأَنَّ","wa-anna","and that","এবং (এও) যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["هُوَ","huwa","He","তিনিই"],["ٱلتَّوَّابُ","l-tawābu","(is) the Acceptor of repentance","ক্ষমাশীল"],["ٱلرَّحِيمُ","l-raḥīmu","the Most Merciful","পরম দয়ালু"]],"t":"أَلَمْ يَعْلَ<o>مُوٓ</><s>ا۟</> أَ<g>نَّ</> <h>ٱ</>للَّهَ هُوَ يَ<q>قْ</>بَلُ <h>ٱ</><l>ل</>تَّوْبَةَ عَنْ عِبَادِ<m>هِۦ</> وَيَأْخُذُ <h>ٱ</><l>ل</>صَّدَ<m>قَٰ</>تِ وَأَ<g>نَّ</> <h>ٱ</>للَّهَ هُوَ <h>ٱ</><l>ل</>تَّوَّابُ <h>ٱ</><l>ل</>رَّ<p>حِي</>مُ"},{"n":105,"w":[["وَقُلِ","waquli","And say","এবং বলো"],["ٱعْمَلُوا۟","i‘'malū","Do","\"তোমরা কাজ করো"],["فَسَيَرَى","fasayarā","then Allah will see","অতঃপর শীঘ্রই দেখবেন"],["ٱللَّهُ","l-lahu","then Allah will see","আল্লাহ"],["عَمَلَكُمْ","‘amalakum","your deed","কাজ তোমাদের"],["وَرَسُولُهُۥ","warasūluhu","and His Messenger","এবং  রাসূল তাঁর"],["وَٱلْمُؤْمِنُونَ ۖ","wal-mu'minūna","and the believers","এবং মু'মিনরাও (দেখবে)"],["وَسَتُرَدُّونَ","wasaturaddūna","And you will be brought back","এবং অচিরেই তোমাদের ফিরিয়ে নেয়া হবে"],["إِلَىٰ","ilā","to","(তাঁর) দিকে"],["عَـٰلِمِ","‘ālimi","(the) Knower","(যিনি) অবহিত"],["ٱلْغَيْبِ","l-ghaybi","(of) the unseen","অদৃশ্য(সম্পর্কে)"],["وَٱلشَّهَـٰدَةِ","wal-shahādati","and the seen","এবং দৃশ্য (সম্পর্কেও)"],["فَيُنَبِّئُكُم","fayunabbi-ukum","then He will inform you","অতঃপর জানাবেন তোমাদেরকে"],["بِمَا","bimā","of what","ঐ বিষয়ে যা"],["كُنتُمْ","kuntum","you used (to)","তোমরা ছিলে"],["تَعْمَلُونَ","ta‘malūna","do","কাজ করতে\""]],"t":"وَقُلِ <h>ٱ</>عْمَلُو<s>ا۟</> فَسَيَرَى <h>ٱ</>للَّهُ عَمَلَكُمْ وَرَسُولُهُ<m>ۥ</> وَ<h>ٱ</>لْمُؤْمِنُونَ ۖ وَسَتُرَدُّونَ إِلَىٰ <m>عَٰ</>لِمِ <h>ٱ</>لْغَيْبِ وَ<h>ٱ</><l>ل</>شَّ<m>هَٰ</>دَةِ فَيُنَبِّئُ<f>كُم بِ</>مَا كُ<k>نتُ</>مْ تَعْمَ<p>لُو</>نَ"},{"n":106,"w":[["وَءَاخَرُونَ","waākharūna","And others","এবং অন্যকিছু (লোক)"],["مُرْجَوْنَ","mur'jawna","deferred","অপেক্ষামান"],["لِأَمْرِ","li-amri","for the Command of Allah ","জন্যে নির্দেশের"],["ٱللَّهِ","l-lahi","for the Command of Allah ","আল্লাহর"],["إِمَّا","immā","whether","হয়"],["يُعَذِّبُهُمْ","yu‘adhibuhum","He will punish them","তিনি শাস্তি দিবেন তাদের"],["وَإِمَّا","wa-immā","or","আর না হয়"],["يَتُوبُ","yatūbu","He will turn (in mercy)","ক্ষমা করবেন"],["عَلَيْهِمْ ۗ","‘alayhim","to them","প্রতি তাদের"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["عَلِيمٌ","‘alīmun","(is) All-Knower","সবকিছু জানেন"],["حَكِيمٌۭ","ḥakīmun","All-Wise","প্রজ্ঞাময়"]],"t":"وَءَاخَرُونَ مُرْجَوْنَ لِأَمْرِ <h>ٱ</>للَّهِ إِ<g>مَّ</>ا يُعَذِّبُهُمْ وَإِ<g>مَّ</>ا يَتُوبُ عَلَيْهِمْ ۗ وَ<h>ٱ</>للَّهُ عَلِيمٌ حَ<p>كِي</>مٌۭ"},{"n":107,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["ٱتَّخَذُوا۟","ittakhadhū","take","নির্মাণ করেছে"],["مَسْجِدًۭا","masjidan","a masjid","মাসজিদকে"],["ضِرَارًۭا","ḍirāran","(for causing) harm","ক্ষতি করার"],["وَكُفْرًۭا","wakuf'ran","and (for) disbelief","ও সত্য প্রত্যাখ্যানের"],["وَتَفْرِيقًۢا","watafrīqan","and (for) division","ও বিভেদ সৃষ্টির উদ্দেশ্যে"],["بَيْنَ","bayna","among","মাঝে"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believers","মু'মিনদের"],["وَإِرْصَادًۭا","wa-ir'ṣādan","and (as) a station","ও ঘাঁটি হিসেবে (ব্যবহারের জন্যে)"],["لِّمَنْ","liman","for whoever","জন্যে তার যে"],["حَارَبَ","ḥāraba","warred","যুদ্ধ করেছে"],["ٱللَّهَ","l-laha","(against) Allah","আল্লাহর"],["وَرَسُولَهُۥ","warasūlahu","and His 