ho","যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["وَعَمِلُوا۟","wa‘amilū","and do","এবং করেছে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","the righteous deeds","সৎকর্ম"],["لَهُمْ","lahum","for them","তাদের জন্য (রয়েছে)"],["جَنَّـٰتٌۭ","jannātun","(will be) Gardens","জান্নাত"],["تَجْرِى","tajrī","flow","প্রবাহিত হচ্ছে"],["مِن","min","from","হতে"],["تَحْتِهَا","taḥtihā","underneath it","তার নীচ"],["ٱلْأَنْهَـٰرُ ۚ","l-anhāru","the rivers","ঝর্ণাসমূহ"],["ذَٰلِكَ","dhālika","That","সেটাই"],["ٱلْفَوْزُ","l-fawzu","(is) the success","সাফল্য"],["ٱلْكَبِيرُ","l-kabīru","the great","মহা"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ لَهُمْ جَ<g>نَّٰ</><k>تٌۭ تَ</><q>جْ</>رِى مِ<k>ن تَ</>حْتِهَا <h>ٱ</>لْأَنْ<m>هَٰ</>رُ ۚ <m>ذَٰ</>لِكَ <h>ٱ</>لْفَوْزُ <h>ٱ</>لْكَ<p>بِي</>رُ"},{"n":12,"w":[["إِنَّ","inna","Indeed","নিশ্চয়"],["بَطْشَ","baṭsha","(the) Grip","পাকড়াও"],["رَبِّكَ","rabbika","(of) your Lord","তোমার রবের"],["لَشَدِيدٌ","lashadīdun","(is) surely strong","অবশ্যই কঠিন"]],"t":"إِ<g>نَّ</> بَ<q>طْ</>شَ رَبِّكَ لَشَ<p>دِي</><q>دٌ</>"},{"n":13,"w":[["إِنَّهُۥ","innahu","Indeed He","নিশ্চয়ই তিনি"],["هُوَ","huwa","He","তিনিই"],["يُبْدِئُ","yub'di-u","originates","অস্তিত্ব দান করেন"],["وَيُعِيدُ","wayu‘īdu","and repeats","ও তিনি পুনরাবর্তন ঘটান"]],"t":"إِ<g>نَّ</>هُ<m>ۥ</> هُوَ يُ<q>بْ</>دِئُ وَيُ<p>عِي</><q>دُ</>"},{"n":14,"w":[["وَهُوَ","wahuwa","And He","এবং তিনিই"],["ٱلْغَفُورُ","l-ghafūru","(is) the Oft-Forgiving","ক্ষমাশীল"],["ٱلْوَدُودُ","l-wadūdu","the Most Loving","প্রেমময়"]],"t":"وَهُوَ <h>ٱ</>لْغَفُورُ <h>ٱ</>لْوَ<p>دُو</><q>دُ</>"},{"n":15,"w":[["ذُو","dhū","Owner (of)","অধিকারী"],["ٱلْعَرْشِ","l-‘arshi","the Throne","আরশের"],["ٱلْمَجِيدُ","l-majīdu","the Glorious","সম্মানিত"]],"t":"ذُو <h>ٱ</>لْعَرْشِ <h>ٱ</>لْمَ<p>جِي</><q>دُ</>"},{"n":16,"w":[["فَعَّالٌۭ","fa‘‘ālun","Doer","সম্পন্নকারী"],["لِّمَا","limā","of what","যা"],["يُرِيدُ","yurīdu","He intends","তিনি চান"]],"t":"فَعَّا<w>لٌۭ لِّ</>مَا يُ<p>رِي</><q>دُ</>"},{"n":17,"w":[["هَلْ","hal","Has","কি"],["أَتَىٰكَ","atāka","come to you","তোমার কাছে পৌঁছেছে"],["حَدِيثُ","ḥadīthu","(the) story","বৃত্তান্ত"],["ٱلْجُنُودِ","l-junūdi","(of) the hosts","সৈন্যদের"]],"t":"هَلْ أَتَ<m>ىٰ</>كَ حَدِيثُ <h>ٱ</>لْجُ<p>نُو</><q>دِ</>"},{"n":18,"w":[["فِرْعَوْنَ","fir'‘awna","Firaun","ফিরআউনের"],["وَثَمُودَ","wathamūda","and Thamud","ও সামূদের"]],"t":"فِرْعَوْنَ وَثَ<p>مُو</><q>دَ</>"},{"n":19,"w":[["بَلِ","bali","Nay","বরং"],["ٱلَّذِينَ","alladhīna","Those who","যারা"],["كَفَرُوا۟","kafarū","disbelieve","অবিশ্বাস করেছে"],["فِى","fī","(are) in","মধ্যে (রত)"],["تَكْذِيبٍۢ","takdhībin","denial","মিথ্যারোপে"]],"t":"بَلِ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> فِى تَكْ<p>ذِي</><q>بٍۢ</>"},{"n":20,"w":[["وَٱللَّهُ","wal-lahu","But Allah","অথচ আল্লাহ"],["مِن","min","from","হতে"],["وَرَآئِهِم","warāihim","behind them","তাদের অলক্ষ্য"],["مُّحِيطٌۢ","muḥīṭun","encompasses","(তাদেরকে) পরিবেষ্টনকারী"]],"t":"وَ<h>ٱ</>للَّهُ <d>مِن وَ</><o>رَآ</>ئِ<y>هِم مُّ</><p>حِي</><q>طٌۢ</>"},{"n":21,"w":[["بَلْ","bal","Nay","বরং"],["هُوَ","huwa","It","তা"],["قُرْءَانٌۭ","qur'ānun","(is) a Quran","কুর'আন"],["مَّجِيدٌۭ","majīdun","Glorious","সম্মানিত"]],"t":"بَلْ هُوَ قُرْءَا<d>نٌۭ مَّ</><p>جِي</><q>دٌۭ</>"},{"n":22,"w":[["فِى","fī","In","মধ্যে"],["لَوْحٍۢ","lawḥin","a Tablet","ফলকের"],["مَّحْفُوظٍۭ","maḥfūẓin","Guarded","সুরক্ষিত"]],"t":"فِى لَوْ<d>حٍۢ مَّ</>حْ<p>فُو</>ظٍۭ"}]}