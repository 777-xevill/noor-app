{"n":85,"a":[{"n":1,"w":[["وَٱلسَّمَآءِ","wal-samāi","By the sky","শপথ আকাশের"],["ذَاتِ","dhāti","containing","বিশিষ্ট"],["ٱلْبُرُوجِ","l-burūji","the constellations","বুরুজ/ গ্রহ-নক্ষত্র"]],"t":"وَ<h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ ذَاتِ <h>ٱ</>لْبُ<p>رُو</><q>جِ</>"},{"n":2,"w":[["وَٱلْيَوْمِ","wal-yawmi","And the Day","এবং দিনের"],["ٱلْمَوْعُودِ","l-maw‘ūdi","Promised","প্রতিশ্রুত"]],"t":"وَ<h>ٱ</>لْيَوْمِ <h>ٱ</>لْمَوْ<p>عُو</><q>دِ</>"},{"n":3,"w":[["وَشَاهِدٍۢ","washāhidin","And (the) witness","শপথ দর্শকের"],["وَمَشْهُودٍۢ","wamashhūdin","and what is witnessed","ও যা পরিদৃষ্ট হয়"]],"t":"وَشَاهِ<d>دٍۢ وَ</>مَشْ<p>هُو</><q>دٍۢ</>"},{"n":4,"w":[["قُتِلَ","qutila","Destroyed were","ধ্বংস হয়েছে"],["أَصْحَـٰبُ","aṣḥābu","(the) companions","কর্তারা/ অধিপতিরা"],["ٱلْأُخْدُودِ","l-ukh'dūdi","(of) the pit","গর্তের"]],"t":"قُتِلَ أَصْ<m>حَٰ</>بُ <h>ٱ</>لْأُخْ<p>دُو</><q>دِ</>"},{"n":5,"w":[["ٱلنَّارِ","al-nāri","(Of) the fire","আগুনের"],["ذَاتِ","dhāti","full","বিশিষ্ট"],["ٱلْوَقُودِ","l-waqūdi","(of) the fuel","(প্রজ্জ্বলিত) ইন্ধন"]],"t":"ٱ<l>ل</><g>نَّ</>ارِ ذَاتِ <h>ٱ</>لْوَ<p>قُو</><q>دِ</>"},{"n":6,"w":[["إِذْ","idh","When","যখন"],["هُمْ","hum","they","তারা (ছিল)"],["عَلَيْهَا","‘alayhā","by it","তার পাশে"],["قُعُودٌۭ","qu‘ūdun","(were) sitting","উপবিষ্ট"]],"t":"إِذْ هُمْ عَلَيْهَا قُ<p>عُو</><q>دٌۭ</>"},{"n":7,"w":[["وَهُمْ","wahum","And they","এবং তারা (ছিল)"],["عَلَىٰ","‘alā","over","ঐ সম্পর্কে"],["مَا","mā","what","যা"],["يَفْعَلُونَ","yaf‘alūna","they were doing","তারা করছিল"],["بِٱلْمُؤْمِنِينَ","bil-mu'minīna","to the believers","মু'মিনদের সাথে"],["شُهُودٌۭ","shuhūdun","witnesses","প্রত্যক্ষকারী"]],"t":"وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِ<h>ٱ</>لْمُؤْمِنِينَ شُ<p>هُو</><q>دٌۭ</>"},{"n":8,"w":[["وَمَا","wamā","And not","এবং না"],["نَقَمُوا۟","naqamū","they resented","তারা প্রতিশোধ নিয়েছিল"],["مِنْهُمْ","min'hum","[of] them","তাদের থেকে (অন্য কারণে)"],["إِلَّآ","illā","except","এ ছাড়া"],["أَن","an","that","যে"],["يُؤْمِنُوا۟","yu'minū","they believed","তারা ঈমান এ