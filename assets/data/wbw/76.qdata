{"n":76,"a":[{"n":1,"w":[["هَلْ","hal","Has","কি"],["أَتَىٰ","atā","(there) come","এসেছে"],["عَلَى","‘alā","upon","উপর"],["ٱلْإِنسَـٰنِ","l-insāni","man","মানুষের"],["حِينٌۭ","ḥīnun","a period","এক সময়"],["مِّنَ","mina","of","থেকে"],["ٱلدَّهْرِ","l-dahri","time","সীমাহীন কালের"],["لَمْ","lam","not","না"],["يَكُن","yakun","he was","সে ছিল"],["شَيْـًۭٔا","shayan","a thing","কিছুই"],["مَّذْكُورًا","madhkūran","mentioned","উল্লেখযোগ্য"]],"t":"هَلْ أَتَىٰ عَلَى <h>ٱ</>لْإِ<k>نسَٰ</>نِ حِي<d>نٌۭ مِّ</>نَ <h>ٱ</><l>ل</>دَّهْرِ لَمْ يَكُ<k>ن شَ</><d>يْـًۭٔا مَّ</>ذْكُورًا"},{"n":2,"w":[["إِنَّا","innā","Indeed, We","আমরা নিশ্চয়ই"],["خَلَقْنَا","khalaqnā","[We] created","আমরা সৃষ্টি করেছি"],["ٱلْإِنسَـٰنَ","l-insāna","man","মানুষকে"],["مِن","min","from","থেকে"],["نُّطْفَةٍ","nuṭ'fatin","a semen-drop","শুক্রের ফোটা"],["أَمْشَاجٍۢ","amshājin","a mixture","মিশ্রিত"],["نَّبْتَلِيهِ","nabtalīhi","(that) We test him","তাকে পরীক্ষা আমরা করবো"],["فَجَعَلْنَـٰهُ","faja‘alnāhu","so We made (for) him","অতঃপর তাকে আমরা বানিয়েছি"],["سَمِيعًۢا","samī‘an","hearing","শ্রবণ শক্তি সম্পন্ন"],["بَصِيرًا","baṣīran","and sight","দৃষ্টি শক্তি সম্পন্ন"]],"t":"إِ<g>نَّ</>ا خَلَ<q>قْ</>نَا <h>ٱ</>لْإِ<k>نسَٰ</>نَ <d>مِن نُّ</><q>طْ</>فَةٍ أَمْشَا<d>جٍۢ نَّ</><q>بْ</>تَلِيهِ فَجَعَلْ<m>نَٰ</>هُ سَمِي<i>عًۢا بَ</>صِيرًا"},{"n":3,"w":[["إِنَّا","innā","Indeed, We","আমরা নিশ্চয়ই"],["هَدَيْنَـٰهُ","hadaynāhu","guided him","তাকে আমরা দেখিয়েছি"],["ٱلسَّبِيلَ","l-sabīla","(to) the way","পথ"],["إِمَّا","immā","whether","হয়"],["شَاكِرًۭا","shākiran","(he) be grateful","শুকুর কারি হবে"],["وَإِمَّا","wa-immā","and whether","আর না হয়"],["كَفُورًا","kafūran","(he) be ungrateful","অকৃতজ্ঞ হবে"]],"t":"إِ<g>نَّ</>ا هَدَيْ<m>نَٰ</>هُ <h>ٱ</><l>ل</>سَّبِيلَ إِ<g>مَّ</>ا شَاكِ<d>رًۭا وَ</>إِ<g>مَّ</>ا كَفُورًا"},{"n":4,"w":[["إِنَّآ","innā","Indeed, We","আমরা নিশ্চয়ই"],["أَعْتَدْنَا","a‘tadnā","[We] have prepared","আমরা প্রস্তুত"],["لِلْكَـٰفِرِينَ","lil'kāfirīna","for the disbelievers","কাফির দের জন্যে"],["سَلَـٰسِلَا