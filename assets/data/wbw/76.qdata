","wayatīman","and (the) orphan","ও ইয়াতীমকে"],["وَأَسِيرًا","wa-asīran","and (the) captive","ও বন্দীকে"]],"t":"وَيُ<q>طْ</>عِمُونَ <h>ٱ</><l>ل</>طَّعَامَ عَلَىٰ حُبِّ<m>هِۦ</> مِسْكِي<d>نًۭا وَ</>يَتِي<d>مًۭا وَ</>أَسِيرًا"},{"n":9,"w":[["إِنَّمَا","innamā","Only","\"মূলত (আর বলে)"],["نُطْعِمُكُمْ","nuṭ'‘imukum","we feed you","তোমাাদের আহার্য দেই আমরা"],["لِوَجْهِ","liwajhi","for (the) Countenance","সন্তুষ্টির জন্যে"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহ্‌র"],["لَا","lā","Not","না"],["نُرِيدُ","nurīdu","we desire","চাই আমরা"],["مِنكُمْ","minkum","from you","তোমাদের থেকে"],["جَزَآءًۭ","jazāan","any reward","প্রতিদান"],["وَلَا","walā","and not","এবং না"],["شُكُورًا","shukūran","thanks","কৃতজ্ঞতা"]],"t":"إِ<g>نَّ</>مَا نُ<q>طْ</>عِمُكُمْ لِوَ<q>جْ</>هِ <h>ٱ</>للَّهِ لَا نُرِيدُ مِ<k>نكُ</>مْ جَ<o>زَآ</><d>ءًۭ وَ</>لَا شُكُورًا"},{"n":10,"w":[["إِنَّا","innā","Indeed, we","নিশ্চয়"],["نَخَافُ","nakhāfu","fear","ভয় করি আমরা"],["مِن","min","from","থেকে"],["رَّبِّنَا","rabbinā","our Lord","আমাদের রবের"],["يَوْمًا","yawman","a Day ","সেই দিনের"],["عَبُوسًۭا","‘abūsan","harsh","ভয়ংকর (যা)"],["قَمْطَرِيرًۭا","qamṭarīran","and distressful","ক্লেশকর\""]],"t":"إِ<g>نَّ</>ا نَخَافُ <w>مِن رَّ</>بِّنَا يَوْمًا عَبُو<k>سًۭا قَ</>مْطَرِيرًۭا"},{"n":11,"w":[["فَوَقَىٰهُمُ","fawaqāhumu","But will protect them","তাদের বাচাবেন অতএব"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["شَرَّ","sharra","(from the) evil","অনিষ্ঠতা (থেকে)"],["ذَٰلِكَ","dhālika","(of) that","সেই"],["ٱلْيَوْمِ","l-yawmi","Day","দিনের"],["وَلَقَّىٰهُمْ","walaqqāhum","and will cause them to meet","এবং তাদের দান করবেন"],["نَضْرَةًۭ","naḍratan","radiance","উৎফুল্লতা"],["وَسُرُورًۭا","wasurūran","and happiness","ও আনন্দ"]],"t":"فَوَقَ<m>ىٰ</>هُمُ <h>ٱ</>للَّهُ شَرَّ <m>ذَٰ</>لِكَ <h>ٱ</>لْيَوْمِ وَلَقَّ<m>ىٰ</>هُمْ نَضْرَ<d>ةًۭ وَ</>سُرُورًۭا"},{"n":12,"w":[["وَجَزَىٰهُم","wajazāhum","And will reward them","এবং তাদের প্রতিদান"],["بِمَا","bimā","because","যা বিনিময়ে"],["صَبَرُوا۟","ṣabarū","they were patient","তারা সবর ক