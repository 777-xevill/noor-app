{"n":72,"a":[{"n":1,"w":[["قُلْ","qul","Say","বল (হে নবী)"],["أُوحِىَ","ūḥiya","It has been revealed","\"ওহী করা হয়েছে"],["إِلَىَّ","ilayya","to me","আমার প্রতি"],["أَنَّهُ","annahu","that","যে"],["ٱسْتَمَعَ","is'tama‘a","listened","মনযোগসহ শুনেছে"],["نَفَرٌۭ","nafarun","a group","একটি দল"],["مِّنَ","mina","of","মধ্যে"],["ٱلْجِنِّ","l-jini","the jinn","জ্বীনদের"],["فَقَالُوٓا۟","faqālū","and they said","তারা বলেছে অতঃপর"],["إِنَّا","innā","Indeed, we","\"আমরা নিশ্চয়ই"],["سَمِعْنَا","sami‘'nā","heard","আমরা শুনেছি"],["قُرْءَانًا","qur'ānan","a Quran","কুরআন"],["عَجَبًۭا","‘ajaban","amazing","বিস্ময়কর"]],"t":"قُلْ أُوحِىَ إِلَىَّ أَ<g>نَّ</>هُ <h>ٱ</>سْتَمَعَ نَفَ<d>رٌۭ مِّ</>نَ <h>ٱ</>لْجِ<g>نِّ</> فَقَا<o>لُوٓ</><s>ا۟</> إِ<g>نَّ</>ا سَمِعْنَا قُرْءَانًا عَجَبًۭا"},{"n":2,"w":[["يَهْدِىٓ","yahdī","It guides","পথ দেখায়"],["إِلَى","ilā","to","দিকে"],["ٱلرُّشْدِ","l-rush'di","the right way","সত্যের"],["فَـَٔامَنَّا","faāmannā","so we believe","আমরা ঈমান অতঃপর এনেছি"],["بِهِۦ ۖ","bihi","in it","তার উপর"],["وَلَن","walan","and never","এবং কক্ষণ না"],["نُّشْرِكَ","nush'rika","we will associate","শরীক আমরা করবো"],["بِرَبِّنَآ","birabbinā","with our Lord","আমাদের রবের সাথে"],["أَحَدًۭا","aḥadan","anyone","কাউকে"]],"t":"يَهْ<o>دِىٓ</> إِلَى <h>ٱ</><l>ل</>رُّشْدِ فَـَٔامَ<g>نَّ</>ا بِ<m>هِۦ</> ۖ وَ<d>لَن نُّ</>شْرِكَ بِرَبِّ<o>نَآ</> أَحَدًۭا"},{"n":3,"w":[["وَأَنَّهُۥ","wa-annahu","And that He ","এবং যে"],["تَعَـٰلَىٰ","ta‘ālā","Exalted is","অতি উচ্চ"],["جَدُّ","jaddu","(the) Majesty","মর্যাদা"],["رَبِّنَا","rabbinā","(of) our Lord ","আমাদের রবের"],["مَا","mā","not","নাই"],["ٱتَّخَذَ","ittakhadha","He has taken","তিনি গ্রহণ করেন"],["صَـٰحِبَةًۭ","ṣāḥibatan","a wife","স্ত্রী"],["وَلَا","walā","and not","আর না"],["وَلَدًۭا","waladan","a son","পুত্র"]],"t":"وَأَ<g>نَّ</>هُ<m>ۥ</> تَ<m>عَٰ</>لَىٰ جَدُّ رَبِّنَا مَا <h>ٱ</>تَّخَذَ <m>صَٰ</>حِبَ<d>ةًۭ وَ</>لَا وَلَدًۭا"},{"n":4,"w":[["وَأَنَّهُۥ","wa-annahu","And that he","এবং যে"],["كَانَ","kāna","used to","ছিল"],["يَقُولُ","yaqūlu","speak ","বলত"],["سَفِيهُنَا","safīhunā","the foolish among us","আমাদের নির্বোধরা"],["عَلَى","‘alā","against","উপর"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["شَطَطًۭا","shaṭaṭan","an excessive transgression","সীমাহীন মিথ্যা"]],"t":"وَأَ<g>نَّ</>هُ<m>ۥ</> كَانَ يَقُولُ سَفِيهُنَا عَلَى <h>ٱ</>للَّهِ شَطَطًۭا"},{"n":5,"w":[["وَأَنَّا","wa-annā","And that we","এবং আমরা যে"],["ظَنَنَّآ","ẓanannā","thought","ভেবেছিলাম"],["أَن","an","that","যে"],["لَّن","lan","never","কখনও না"],["تَقُولَ","taqūla","will say","বলবে"],["ٱلْإِنسُ","l-insu","the men","মানুষ"],["وَٱلْجِنُّ","wal-jinu","and the jinn","ও জীন্ন"],["عَلَى","‘alā","against","সম্পর্কে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["كَذِبًۭا","kadhiban","any lie","মিথ্যা"]],"t":"وَأَ<g>نَّ</>ا ظَنَ<g>نَّ</><o>آ</> <w>أَن لَّ</><k>ن تَ</>قُولَ <h>ٱ</>لْإِ<k>نسُ</> وَ<h>ٱ</>لْجِ<g>نُّ</> عَلَى <h>ٱ</>للَّهِ كَذِبًۭا"},{"n":6,"w":[["وَأَنَّهُۥ","wa-annahu","And that","এবং যে"],["كَانَ","kāna","(there) were","ছিল"],["رِجَالٌۭ","rijālun","men","কিছু লোক"],["مِّنَ","mina","among","মধ্যে"],["ٱلْإِنسِ","l-insi","mankind","মানুষের"],["يَعُوذُونَ","ya‘ūdhūna","who sought refuge","আশ্রয় চাইত"],["بِرِجَالٍۢ","birijālin","in (the) men","কিছু লোকের"],["مِّنَ","mina","from","মধ্যের"],["ٱلْجِنِّ","l-jini","the jinn","জিন্নদের"],["فَزَادُوهُمْ","fazādūhum","so they increased them","তাদের বাড়িয়েছিল এভাবে"],["رَهَقًۭا","rahaqan","(in) burden","অহংকার"]],"t":"وَأَ<g>نَّ</>هُ<m>ۥ</> كَانَ رِجَا<d>لٌۭ مِّ</>نَ <h>ٱ</>لْإِ<k>نسِ</> يَعُوذُونَ بِرِجَا<d>لٍۢ مِّ</>نَ <h>ٱ</>لْجِ<g>نِّ</> فَزَادُوهُمْ رَهَقًۭا"},{"n":7,"w":[["وَأَنَّهُمْ","wa-annahum","And that they","এবং তারা যে"],["ظَنُّوا۟","ẓannū","thought","ভেবেছিল"],["كَمَا","kamā","as","যেমন"],["ظَنَنتُمْ","ẓanantum","you thought","তোমরা ভেবেছ"],["أَن","an","that","যে"],["لَّن","lan","never","কখনও না"],["يَبْعَثَ","yab‘atha","will raise","পাঠাবেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["أَحَدًۭا","aḥadan","anyone","কাউকে (রাসূলরূপে)"]],"t":"وَأَ<g>نَّ</>هُمْ ظَ<g>نُّ</>و<s>ا۟</> كَمَا ظَنَ<k>نتُ</>مْ <w>أَن لَّ</><d>ن يَ</><q>بْ</>عَثَ <h>ٱ</>للَّهُ أَحَدًۭا"},{"n":8,"w":[["وَأَنَّا","wa-annā","And that we","এবং আমরা যে"],["لَمَسْنَا","lamasnā","sought to touch","আমরা তালাশ করেছি"],["ٱلسَّمَآءَ","l-samāa","the heaven","আসমানে"],["فَوَجَدْنَـٰهَا","fawajadnāhā","but we found it","তা আমরা পেয়েছি ফলে"],["مُلِئَتْ","muli-at","filled (with)","পরিপূর্ণ"],["حَرَسًۭا","ḥarasan","guards","পাহারাদারে"],["شَدِيدًۭا","shadīdan","severe","কঠোর"],["وَشُهُبًۭا","washuhuban","and flaming fires","ও অগ্নিশিখা সমূহে"]],"t":"وَأَ<g>نَّ</>ا لَمَسْنَا <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءَ فَوَجَ<q>دْ</><m>نَٰ</>هَا مُلِئَتْ حَرَ<k>سًۭا شَ</>دِي<d>دًۭا وَ</>شُهُبًۭا"},{"n":9,"w":[["وَأَنَّا","wa-annā","And that we","এবং যে"],["كُنَّا","kunnā","used to","(আমরা)"],["نَقْعُدُ","naq‘udu","sit","আমরা বসতাম"],["مِنْهَا","min'hā","there in","সেখানে"],["مَقَـٰعِدَ","maqā‘ida","positions","আসনগুলোতে"],["لِلسَّمْعِ ۖ","lilssam‘i","for hearing","শুনার জন্য"],["فَمَن","faman","but (he) who","যে কিন্তু"],["يَسْتَمِعِ","yastami‘i","listens","শুনবে"],["ٱلْـَٔانَ","l-āna","now","এখন"],["يَجِدْ","yajid","will find","সে পাবে"],["لَهُۥ","lahu","for him","তার জন্য"],["شِهَابًۭا","shihāban","a flaming fire","অগ্নিশিখা"],["رَّصَدًۭا","raṣadan","waiting","পেতে রাখা"]],"t":"وَأَ<g>نَّ</>ا كُ<g>نَّ</>ا نَ<q>قْ</>عُدُ مِنْهَا مَ<m>قَٰ</>عِدَ لِلسَّمْعِ ۖ فَ<d>مَن يَ</>سْتَمِعِ <h>ٱ</>لْءَانَ يَجِ<q>دْ</> لَهُ<m>ۥ</> شِهَا<w>بًۭا رَّ</>صَدًۭا"},{"n":10,"w":[["وَأَنَّا","wa-annā","And that we ","এবং আমরা যে"],["لَا","lā","not","না"],["نَدْرِىٓ","nadrī","we know","জানি আমরা"],["أَشَرٌّ","asharrun","whether evil","অকল্যাণ"],["أُرِيدَ","urīda","is intended","অভিপ্রেত"],["بِمَن","biman","for (those) who","যারা সাথে"],["فِى","fī","(are) in","উপর"],["ٱلْأَرْضِ","l-arḍi","the earth","যমীনের"],["أَمْ","am","or","কিম্বা"],["أَرَادَ","arāda","intends","চান"],["بِهِمْ","bihim","for them","তাদের সাথে"],["رَبُّهُمْ","rabbuhum","their Lord","তাদের রব"],["رَشَدًۭا","rashadan","a right path","কল্যাণ"]],"t":"وَأَ<g>نَّ</>ا لَا نَ<q>دْ</><o>رِىٓ</> أَشَرٌّ أُرِيدَ بِمَ<k>ن فِ</>ى <h>ٱ</>لْأَرْضِ أَمْ أَرَادَ بِهِمْ رَبُّهُمْ رَشَدًۭا"},{"n":11,"w":[["وَأَنَّا","wa-annā","And that [we]","এবং যে"],["مِنَّا","minnā","among us","আমাদের মধ্যে (আছে)"],["ٱلصَّـٰلِحُونَ","l-ṣāliḥūna","(are) the righteous","সৎলোক (কিছু)"],["وَمِنَّا","waminnā","and among us","আবার আমাদের"],["دُونَ","dūna","(are) other than","ছাড়াও (আছে)"],["ذَٰلِكَ ۖ","dhālika","that","এ"],["كُنَّا","kunnā","We","আমরা ছিলাম"],["طَرَآئِقَ","ṭarāiqa","(are on) ways","বিভিন্ন পথে"],["قِدَدًۭا","qidadan","different","বিভক্ত"]],"t":"وَأَ<g>نَّ</>ا مِ<g>نَّ</>ا <h>ٱ</><l>ل</><m>صَّٰ</>لِحُونَ وَمِ<g>نَّ</>ا دُونَ <m>ذَٰ</>لِكَ ۖ كُ<g>نَّ</>ا طَ<o>رَآ</>ئِقَ قِدَدًۭا"},{"n":12,"w":[["وَأَنَّا","wa-annā","And that we","এবং আমরা যে"],["ظَنَنَّآ","ẓanannā","[we] have become certain","আমরা ভেবেছিলাম"],["أَن","an","that","যে"],["لَّن","lan","never","কখনও না"],["نُّعْجِزَ","nu‘'jiza","we will cause failure","আক্ষম আমরা কএওতে পারবো"],["ٱللَّهَ","l-laha","(to) Allah","আল্লাহকে"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["وَلَن","walan","and never","এবং কখন না"],["نُّعْجِزَهُۥ","nu‘'jizahu","we can escape Him","আমরা পরাভূত করতে পারবো তাঁকে"],["هَرَبًۭا","haraban","(by) flight","পলায়ন করে"]],"t":"وَأَ<g>نَّ</>ا ظَنَ<g>نَّ</><o>آ</> <w>أَن لَّ</><d>ن نُّ</>عْجِزَ <h>ٱ</>للَّهَ فِى <h>ٱ</>لْأَرْضِ وَ<d>لَن نُّ</>عْجِزَهُ<m>ۥ</> هَرَبًۭا"},{"n":13,"w":[["وَأَنَّا","wa-annā","And that [we]","এবং আমরা যে"],["لَمَّا","lammā","when","যখন"],["سَمِعْنَا","sami‘'nā","we heard","আমরা শুনেছি"],["ٱلْهُدَىٰٓ","l-hudā","the Guidance","হেদায়াত"],["ءَامَنَّا","āmannā","we believed","আমরা ঈমান এনেছি"],["بِهِۦ ۖ","bihi","in it","তার উপর"],["فَمَن","faman","And whoever","যে অতএব"],["يُؤْمِنۢ","yu'min","believes","ঈমান আনবে"],["بِرَبِّهِۦ","birabbihi","in his Lord","তার রবের উপর"],["فَلَا","falā","then not","না অতএব"],["يَخَافُ","yakhāfu","he will fear","সে ভয় করবে"],["بَخْسًۭا","bakhsan","any loss","অবিচারের"],["وَلَا","walā","and not","এবং না"],["رَهَقًۭا","rahaqan","any burden","জুলুমের"]],"t":"وَأَ<g>نَّ</>ا لَ<g>مَّ</>ا سَمِعْنَا <h>ٱ</>لْهُدَ<o>ىٰٓ</> ءَامَ<g>نَّ</>ا بِ<m>هِۦ</> ۖ فَ<d>مَن يُ</>ؤْ<i>مِنۢ بِ</>رَبِّ<m>هِۦ</> فَلَا يَخَافُ بَخْ<d>سًۭا وَ</>لَا رَهَقًۭا"},{"n":14,"w":[["وَأَنَّا","wa-annā","And that we","এবং যে"],["مِنَّا","minnā","among us","আমাদের মধ্যে"],["ٱلْمُسْلِمُونَ","l-mus'limūna","(are) Muslims","মুসলমান (আছে)"],["وَمِنَّا","waminnā","and among us","আবার আমাদের মধ্যে"],["ٱلْقَـٰسِطُونَ ۖ","l-qāsiṭūna","(are) unjust","সত্যবিমুখও (আছে)"],["فَمَنْ","faman","And whoever","যে অতএব"],["أَسْلَمَ","aslama","submits","ইসলাম গ্রহণও করেছে"],["فَأُو۟لَـٰٓئِكَ","fa-ulāika","then those","ঐসব লোক তবে"],["تَحَرَّوْا۟","taḥarraw","have sought","বেছে নিয়েছে"],["رَشَدًۭا","rashadan","(the) right path","সত্য পথ"]],"t":"وَأَ<g>نَّ</>ا مِ<g>نَّ</>ا <h>ٱ</>لْمُسْلِمُونَ وَمِ<g>نَّ</>ا <h>ٱ</>لْ<m>قَٰ</>سِطُونَ ۖ فَمَنْ أَسْلَمَ فَأُ<s>و۟</><o>لَٰٓ</>ئِكَ تَحَرَّوْ<s>ا۟</> رَشَدًۭا"},{"n":15,"w":[["وَأَمَّا","wa-ammā","And as for","অপরপক্ষে"],["ٱلْقَـٰسِطُونَ","l-qāsiṭūna","the unjust","সত্য বিমুখরা"],["فَكَانُوا۟","fakānū","they will be","তারা অতঃপর হলো"],["لِجَهَنَّمَ","lijahannama","for Hell","জাহান্নামের জন্য"],["حَطَبًۭا","ḥaṭaban","firewood","ইন্ধন\""]],"t":"وَأَ<g>مَّ</>ا <h>ٱ</>لْ<m>قَٰ</>سِطُونَ فَكَانُو<s>ا۟</> لِجَهَ<g>نَّ</>مَ حَطَبًۭا"},{"n":16,"w":[["وَأَلَّوِ","wa-allawi","And that if","এবং যদি"],["ٱسْتَقَـٰمُوا۟","is'taqāmū","they had remained","তারা দৃঢ় থাকতো"],["عَلَى","‘alā","on","উপর"],["ٱلطَّرِيقَةِ","l-ṭarīqati","the Way","সত্য পথের"],["لَأَسْقَيْنَـٰهُم","la-asqaynāhum","surely We (would) have given them to drink","তাদের আমরা পান অবশ্যই করাতাম"],["مَّآءً","māan","water","পানি"],["غَدَقًۭا","ghadaqan","(in) abundance","প্রচুর"]],"t":"وَأَلَّوِ <h>ٱ</>سْتَ<m>قَٰ</>مُو<s>ا۟</> عَلَى <h>ٱ</><l>ل</>طَّرِيقَةِ لَأَسْقَيْ<m>نَٰ</><y>هُم مَّ</><o>آ</>ءً غَدَقًۭا"},{"n":17,"w":[["لِّنَفْتِنَهُمْ","linaftinahum","That We might test them","তাদের পরীক্ষা আমরা যেন করি"],["فِيهِ ۚ","fīhi","therein","তার মধ্যে"],["وَمَن","waman","And whoever","এবং যে"],["يُعْرِضْ","yu‘'riḍ","turns away","মুখ ফেরাবে"],["عَن","‘an","from","থেকে"],["ذِكْرِ","dhik'ri","the Remembrance","স্মরণ"],["رَبِّهِۦ","rabbihi","(of) his Lord","তার রবের উপর"],["يَسْلُكْهُ","yasluk'hu","He will make him enter","তাকে প্রবেশ করাবে"],["عَذَابًۭا","‘adhāban","a punishment","আযাবে"],["صَعَدًۭا","ṣa‘adan","severe","দুঃসহ"]],"t":"لِّنَفْتِنَهُمْ فِيهِ ۚ وَ<d>مَن يُ</>عْرِضْ عَ<k>ن ذِ</>كْرِ رَبِّ<m>هِۦ</> يَسْلُكْهُ عَذَا<k>بًۭا صَ</>عَدًۭا"},{"n":18,"w":[["وَأَنَّ","wa-anna","And that","এবং যে"],["ٱلْمَسَـٰجِدَ","l-masājida","the masjids","মসজিদ সমূহ"],["لِلَّهِ","lillahi","(are) for Allah","আল্লাহর জন্যে"],["فَلَا","falā","so (do) not","না অতএব"],["تَدْعُوا۟","tad‘ū","call","তোমরা ডেকো"],["مَعَ","ma‘a","with","সাথে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["أَحَدًۭا","aḥadan","anyone","কাউকে"]],"t":"وَأَ<g>نَّ</> <h>ٱ</>لْمَ<m>سَٰ</>جِدَ لِلَّهِ فَلَا تَ<q>دْ</>عُو<s>ا۟</> مَعَ <h>ٱ</>للَّهِ أَحَدًۭا"},{"n":19,"w":[["وَأَنَّهُۥ","wa-annahu","And that","এবং যে"],["لَمَّا","lammā","when","যখন"],["قَامَ","qāma","stood up","দাঁড়াল"],["عَبْدُ","‘abdu","(the) slave","বান্দা"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["يَدْعُوهُ","yad‘ūhu","calling (upon) Him","তাঁকে ডাকতে"],["كَادُوا۟","kādū","they almost","করল (যেন)"],["يَكُونُونَ","yakūnūna","became","তারা উপক্রম"],["عَلَيْهِ","‘alayhi","around him","তার উপর"],["لِبَدًۭا","libadan","a compacted mass","ঘিরে ধরার"]],"t":"وَأَ<g>نَّ</>هُ<m>ۥ</> لَ<g>مَّ</>ا قَامَ عَ<q>بْ</>دُ <h>ٱ</>للَّهِ يَ<q>دْ</>عُوهُ كَادُو<s>ا۟</> يَكُونُونَ عَلَيْهِ لِبَدًۭا"},{"n":20,"w":[["قُلْ","qul","Say","বল"],["إِنَّمَآ","innamā","Only","\"মুলত"],["أَدْعُوا۟","ad‘ū","I call upon","আমি ডাকি"],["رَبِّى","rabbī","my Lord","আমার রবকে"],["وَلَآ","walā","and not","এবং না"],["أُشْرِكُ","ush'riku","I associate","শরীক করি"],["بِهِۦٓ","bihi","with Him","তার সাথে"],["أَحَدًۭا","aḥadan","anyone","কাউকে\""]],"t":"قُلْ إِ<g>نَّ</><o>مَآ</> أَ<q>دْ</>عُو<s>ا۟</> رَبِّى وَ<o>لَآ</> أُشْرِكُ بِ<o>هِۦٓ</> أَحَدًۭا"},{"n":21,"w":[["قُلْ","qul","Say","বল"],["إِنِّى","innī","Indeed, I","\"আমি নিশ্চয়"],["لَآ","lā","(do) not","না"],["أَمْلِكُ","amliku","possess","ক্ষমতা রাখি আমি"],["لَكُمْ","lakum","for you","তোমাদের জন্যে"],["ضَرًّۭا","ḍarran","any harm","ক্ষতির"],["وَلَا","walā","and not","এবং না"],["رَشَدًۭا","rashadan","right path","কল্যাণের\""]],"t":"قُلْ إِ<g>نِّ</>ى <o>لَآ</> أَمْلِكُ لَكُمْ ضَ<d>رًّۭا وَ</>لَا رَشَدًۭا"},{"n":22,"w":[["قُلْ","qul","Say","বল"],["إِنِّى","innī","Indeed I","\"আমি নিশ্চয়"],["لَن","lan","never","কখন না"],["يُجِيرَنِى","yujīranī","can protect me","আশ্রয় দিতে পারে আমাকে"],["مِنَ","mina","from","থেকে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["أَحَدٌۭ","aḥadun","anyone","কেউ"],["وَلَنْ","walan","and never","এবং কখন না"],["أَجِدَ","ajida","can I find","পাব আমি"],["مِن","min","from","তাঁকে"],["دُونِهِۦ","dūnihi","besides Him","ছাড়া"],["مُلْتَحَدًا","mul'taḥadan","any refuge","আশ্রয়স্থল"]],"t":"قُلْ إِ<g>نِّ</>ى <d>لَن يُ</>جِيرَنِى مِنَ <h>ٱ</>للَّهِ أَحَ<d>دٌۭ وَ</>لَنْ أَجِدَ مِ<k>ن دُ</>ونِ<m>هِۦ</> مُلْتَحَدًا"},{"n":23,"w":[["إِلَّا","illā","But","এছাড়া নয় (আমার কাজ)"],["بَلَـٰغًۭا","balāghan","(the) notification","পৌঁছান"],["مِّنَ","mina","from","হতে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["وَرِسَـٰلَـٰتِهِۦ ۚ","warisālātihi","and His Messages","ও তাঁর পয়গাম সমূহ\""],["وَمَن","waman","And whoever","এবং যে"],["يَعْصِ","ya‘ṣi","disobeys","অমান্য করবে"],["ٱللَّهَ","l-laha","Allah","আল্লাহর"],["وَرَسُولَهُۥ","warasūlahu","and His Messenger","ও তাঁর রাসূলের"],["فَإِنَّ","fa-inna","then indeed","নিশ্চয় অতঃপর"],["لَهُۥ","lahu","for him","তার জন্যে"],["نَارَ","nāra","(is the) Fire","আগুন"],["جَهَنَّمَ","jahannama","(of) Hell","জাহান্নামের জন্য"],["خَـٰلِدِينَ","khālidīna","(they will) abide","তারা স্থায়ী হবে"],["فِيهَآ","fīhā","therein","তার মধ্যে"],["أَبَدًا","abadan","forever","চিরকাল"]],"t":"إِلَّا بَ<m>لَٰ</><d>غًۭا مِّ</>نَ <h>ٱ</>للَّهِ وَرِ<m>سَٰلَٰتِهِۦ</> ۚ وَ<d>مَن يَ</>عْصِ <h>ٱ</>للَّهَ وَرَسُولَهُ<m>ۥ</> فَإِ<g>نَّ</> لَهُ<m>ۥ</> نَارَ جَهَ<g>نَّ</>مَ <m>خَٰ</>لِدِينَ فِي<o>هَآ</> أَبَدًا"},{"n":24,"w":[["حَتَّىٰٓ","ḥattā","Until","যতক্ষণ না"],["إِذَا","idhā","when","যখন"],["رَأَوْا۟","ra-aw","they see","তারা দেখবে"],["مَا","mā","what","যা"],["يُوعَدُونَ","yū‘adūna","they are promised","তাদের ওয়াদা হয়েছে করা"],["فَسَيَعْلَمُونَ","fasaya‘lamūna","then they will know","তারা জানতে শীঘ্রই অতঃপর পারবে"],["مَنْ","man","who","কেউ"],["أَضْعَفُ","aḍ‘afu","(is) weaker","অধিক দুর্বল"],["نَاصِرًۭا","nāṣiran","(in) helpers","সাহায্যকারী"],["وَأَقَلُّ","wa-aqallu","and fewer","এবং অতি কম"],["عَدَدًۭا","‘adadan","(in) number","সংখ্যায়"]],"t":"حَتَّ<o>ىٰٓ</> إِذَا رَأَوْ<s>ا۟</> مَا يُوعَدُونَ فَسَيَعْلَمُونَ مَنْ أَضْعَفُ نَاصِ<d>رًۭا وَ</>أَقَلُّ عَدَدًۭا"},{"n":25,"w":[["قُلْ","qul","Say","বল"],["إِنْ","in","Not","\"না"],["أَدْرِىٓ","adrī","I know","জানি আমি"],["أَقَرِيبٌۭ","aqarībun","whether is near","নিকটবর্তী কী"],["مَّا","mā","what","যা"],["تُوعَدُونَ","tū‘adūna","you are promised","তোমাদের ওয়াদা হচ্ছে করা"],["أَمْ","am","or (whether)","অথবা"],["يَجْعَلُ","yaj‘alu","will appoint","করেছেন"],["لَهُۥ","lahu","for it","তার জন্যে"],["رَبِّىٓ","rabbī","my Lord","আমার রব"],["أَمَدًا","amadan","a (distant) term","দীর্ঘ মেয়াদ"]],"t":"قُلْ إِنْ أَ<q>دْ</><o>رِىٓ</> أَقَرِي<d>بٌۭ مَّ</>ا تُوعَدُونَ أَمْ يَ<q>جْ</>عَلُ لَهُ<m>ۥ</> رَ<o>بِّىٓ</> أَمَدًا"},{"n":26,"w":[["عَـٰلِمُ","‘ālimu","(The) All-Knower","আবহিত তিনি"],["ٱلْغَيْبِ","l-ghaybi","(of) the unseen","গায়েব"],["فَلَا","falā","so not","না অতএব"],["يُظْهِرُ","yuẓ'hiru","He reveals","তিনি প্রকাশ করেন"],["عَلَىٰ","‘alā","from","সম্পর্কে"],["غَيْبِهِۦٓ","ghaybihi","His unseen","তাঁর গায়েব"],["أَحَدًا","aḥadan","(to) anyone","কাউকে"]],"t":"<m>عَٰ</>لِمُ <h>ٱ</>لْغَيْبِ فَلَا يُظْهِرُ عَلَىٰ غَيْبِ<o>هِۦٓ</> أَحَدًا"},{"n":27,"w":[["إِلَّا","illā","Except","কিন্তু"],["مَنِ","mani","whom","যাকে"],["ٱرْتَضَىٰ","ir'taḍā","He has approved","তিনি রাজী হন"],["مِن","min","of","মধ্যে"],["رَّسُولٍۢ","rasūlin","a 