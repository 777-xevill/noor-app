um","so you","অতঃপর তোমরা"],["فِيهِ","fīhi","in it","মধ্যে তার"],["سَوَآءٌۭ","sawāon","(are) equal","সমান (অংশীদারিত্বে)"],["تَخَافُونَهُمْ","takhāfūnahum","you fear them","তোমরা ভয় করবে তাদেরকে (কি?)"],["كَخِيفَتِكُمْ","kakhīfatikum","as you fear","যেমন ভয় তোমাদের"],["أَنفُسَكُمْ ۚ","anfusakum","yourselves","নিজেদের তোমাদের (সমান লোকদের ক্ষেত্রে)"],["كَذَٰلِكَ","kadhālika","Thus","এরূপে"],["نُفَصِّلُ","nufaṣṣilu","We explain","আমরা বর্ণনা করি বিশদভাবে"],["ٱلْـَٔايَـٰتِ","l-āyāti","the Verses","নিদর্শনাবলী"],["لِقَوْمٍۢ","liqawmin","for a people","জন্যে সম্প্রদায়ের"],["يَعْقِلُونَ","ya‘qilūna","(who) use reason","(যারা) বুদ্ধি কাজে লাগায়"]],"t":"ضَرَبَ لَ<y>كُم مَّ</>ثَلًۭ<d>ا مِّ</>نْ أَ<k>نفُ</>سِكُمْ ۖ هَل لَّ<y>كُم مِّ</><d>ن مَّ</>ا مَلَكَتْ أَيْ<m>مَٰ</>نُ<y>كُم مِّ</><k>ن شُ</>رَ<o>كَآ</>ءَ فِى مَا رَزَ<q>قْ</><m>نَٰ</>كُمْ فَأَ<k>نتُ</>مْ فِيهِ سَ<o>وَآ</><k>ءٌۭ تَ</>خَافُونَهُمْ كَخِيفَتِكُمْ أَ<k>نفُ</>سَكُمْ ۚ كَ<m>ذَٰ</>لِكَ نُفَصِّلُ <h>ٱ</>لْءَا<m>يَٰ</>تِ لِقَوْ<d>مٍۢ يَ</>عْقِ<p>لُو</>نَ"},{"n":29,"w":[["بَلِ","bali","Nay","বরং"],["ٱتَّبَعَ","ittaba‘a","follow","অনুসরণ করে"],["ٱلَّذِينَ","alladhīna","those who","তারা (যারা)"],["ظَلَمُوٓا۟","ẓalamū","do wrong","সীমালঙ্ঘন করেছে"],["أَهْوَآءَهُم","ahwāahum","their desires","খেয়ালখুশির তাদের"],["بِغَيْرِ","bighayri","without","ছাড়া"],["عِلْمٍۢ ۖ","‘il'min","knowledge","কোনো জ্ঞান"],["فَمَن","faman","Then who","সুতরাং কে"],["يَهْدِى","yahdī","(can) guide","পথ দেখাবে"],["مَنْ","man","(one) whom","যাকে"],["أَضَلَّ","aḍalla","Allah has let go astray","পথভ্রষ্ট করেছেন"],["ٱللَّهُ ۖ","l-lahu","Allah has let go astray","আল্লাহ"],["وَمَا","wamā","And not","এবং নেই"],["لَهُم","lahum","for them","জন্যে তাদের"],["مِّن","min","any","কোনো"],["نَّـٰصِرِينَ","nāṣirīna","helpers","সাহায্যকারী"]],"t":"بَلِ <h>ٱ</>تَّبَعَ <h>ٱ</>لَّذِينَ ظَلَ<o>مُوٓ</><s>ا۟</> أَهْ<o>وَآ</>ءَ<f>هُم بِ</>غَيْرِ عِلْ<k>مٍۢ ۖ فَ</><d>مَن يَ</>هْدِى مَنْ أَضَلَّ <h>ٱ</>للَّهُ ۖ وَمَا لَ<y>هُم مِّ</><d>ن نَّٰ</>صِ<p>رِي</>نَ"},{"n":30,"w":[["فَأَقِمْ","fa-aqim","So set","অতএব (হে নাবী) প্রতিষ্ঠিত করো"],["وَجْهَكَ","wajhaka","your face","তোমার চেহারা (লক্ষ্য)কে"],["لِلدِّينِ","lilddīni","to the religion","জন্যে দ্বীনের"],["حَنِيفًۭا ۚ","ḥanīfan","upright","একনিষ্ঠভাবে"],["فِطْرَتَ","fiṭ'rata","Nature","(সেই দ্বীন) প্রকৃতির"],["ٱللَّهِ","l-lahi","(made by) Allah","আল্লাহর"],["ٱلَّتِى","allatī","(upon) which","যা"],["فَطَرَ","faṭara","He has created","তিনি সৃষ্টি করেছেন"],["ٱلنَّاسَ","l-nāsa","mankind","মানুষকে"],["عَلَيْهَا ۚ","‘alayhā","[on it]","উপর তার"],["لَا","lā","No","না (হ'তে পারে)"],["تَبْدِيلَ","tabdīla","change","কোনো  পরিবর্তন"],["لِخَلْقِ","likhalqi","(should there be) in the creation","জন্যে সৃষ্টির"],["ٱللَّهِ ۚ","l-lahi","(of) Allah","আল্লাহর"],["ذَٰلِكَ","dhālika","That","এটাই"],["ٱلدِّينُ","l-dīnu","(is) the religion","দীন"],["ٱلْقَيِّمُ","l-qayimu","the correct","প্রতিষ্ঠিত"],["وَلَـٰكِنَّ","walākinna","but","কিন্তু"],["أَكْثَرَ","akthara","most","অধিকাংশ"],["ٱلنَّاسِ","l-nāsi","men","মানুষ"],["لَا","lā","(do) not","না"],["يَعْلَمُونَ","ya‘lamūna","know","তারা জানে"]],"t":"فَأَقِمْ وَ<q>جْ</>هَكَ لِلدِّينِ حَنِي<k>فًۭا ۚ فِ</><q>طْ</>رَتَ <h>ٱ</>للَّهِ <h>ٱ</>لَّتِى فَطَرَ <h>ٱ</><l>ل</><g>نَّ</>اسَ عَلَيْهَا ۚ لَا تَ<q>بْ</>دِيلَ لِخَلْقِ <h>ٱ</>للَّهِ ۚ <m>ذَٰ</>لِكَ <h>ٱ</><l>ل</>دِّينُ <h>ٱ</>لْقَيِّمُ وَ<m>لَٰ</>كِ<g>نَّ</> أَكْثَرَ <h>ٱ</><l>ل</><g>نَّ</>اسِ لَا يَعْلَ<p>مُو</>نَ"},{"n":31,"w":[["۞ مُنِيبِينَ","munībīna","Turning","(বিশুদ্ধচিত্তে) অভিমূখী হয়ে"],["إِلَيْهِ","ilayhi","to Him","দিকে তাঁরই"],["وَٱتَّقُوهُ","wa-ittaqūhu","and fear Him","এবং তাঁকে ভয় কর"],["وَأَقِيمُوا۟","wa-aqīmū","and establish","ও প্রতিষ্ঠা করো"],["ٱلصَّلَوٰةَ","l-ṣalata","the prayer","সালাত"],["وَلَا","walā","and (do) not","এবং না"],["تَكُونُوا۟","takūnū","be","তোমরা হয়ো"],["مِنَ","mina","of","অন্তর্ভূক্ত"],["ٱلْمُشْرِكِينَ","l-mush'rikīna","the polytheists","মুশরেকদের"]],"t":"۞ مُنِيبِينَ إِلَيْهِ وَ<h>ٱ</>تَّقُوهُ وَأَقِيمُو<s>ا۟</> <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةَ وَلَا تَكُونُو<s>ا۟</> مِنَ <h>ٱ</>لْمُشْرِ<p>كِي</>نَ"},{"n":32,"w":[["مِنَ","mina","Of","মধ্যে"],["ٱلَّذِينَ","alladhīna","those who","তাদের (যারা)"],["فَرَّقُوا۟","farraqū","divide","বিভক্ত করেছে"],["دِينَهُمْ","dīnahum","their religion","দীনকে তাদের"],["وَكَانُوا۟","wakānū","and become","এবং হয়ে গিয়েছে"],["شِيَعًۭا ۖ","shiya‘an","sects","বিভিন্ন দল"],["كُلُّ","kullu","each","প্রত্যেক"],["حِزْبٍۭ","ḥiz'bin","party","দলই"],["بِمَا","bimā","in what","নিয়ে ঐ বিষয় যা"],["لَدَيْهِمْ","ladayhim","they have","কাছে আছে তাদের"],["فَرِحُونَ","fariḥūna","rejoicing","সন্তুষ্ট"]],"t":"مِنَ <h>ٱ</>لَّذِينَ فَرَّقُو<s>ا۟</> دِينَهُمْ وَكَانُو<s>ا۟</> شِيَ<k>عًۭا ۖ كُ</>لُّ حِزْ<i>بٍۭ بِ</>مَا لَدَيْهِمْ فَرِ<p>حُو</>نَ"},{"n":33,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["مَسَّ","massa","touches","স্পর্শ করে"],["ٱلنَّاسَ","l-nāsa","people","মানুষকে"],["ضُرٌّۭ","ḍurrun","hardship","দুঃখ-দৈন্যে"],["دَعَوْا۟","da‘aw","they call","তারা ডাকে"],["رَبَّهُم","rabbahum","their Lord","রবকে তাদের"],["مُّنِيبِينَ","munībīna","turning","বিশুদ্ধচিত্তে"],["إِلَيْهِ","ilayhi","to Him","দিকে তাঁরই"],["ثُمَّ","thumma","Then","এরপর"],["إِذَآ","idhā","when","যখন"],["أَذَاقَهُم","adhāqahum","He causes them to taste","তিনি আস্বাদন করান তাদেরকে"],["مِّنْهُ","min'hu","from Him","পক্ষ হ'তে তাঁর"],["رَحْمَةً","raḥmatan","Mercy","অনুগ্রহ"],["إِذَا","idhā","behold","তখন"],["فَرِيقٌۭ","farīqun","A party","একদল"],["مِّنْهُم","min'hum","of them","মধ্য থেকে তাদের"],["بِرَبِّهِمْ","birabbihim","with their Lord","সাথে রবের তাদের"],["يُشْرِكُونَ","yush'rikūna","associate partners","তারা শিরক করে"]],"t":"وَإِذَا مَسَّ <h>ٱ</><l>ل</><g>نَّ</>اسَ ضُ<k>رٌّۭ دَ</>عَوْ<s>ا۟</> رَبَّ<y>هُم مُّ</>نِيبِينَ إِلَيْهِ ثُ<g>مَّ</> إِ<o>ذَآ</> أَذَاقَ<y>هُم مِّ</>نْهُ رَحْمَةً إِذَا فَرِي<d>قٌۭ مِّ</>نْ<f>هُم بِ</>رَبِّهِمْ يُشْرِ<p>كُو</>نَ"},{"n":34,"w":[["لِيَكْفُرُوا۟","liyakfurū","So as to deny","যেন তারা অকৃতজ্ঞতা করে"],["بِمَآ","bimā","[in] what","ঐ বিষয়ে যা"],["ءَاتَيْنَـٰهُمْ ۚ","ātaynāhum","We have granted them","আমরা দান করেছি তাদেরকে"],["فَتَمَتَّعُوا۟","fatamatta‘ū","Then enjoy","সুতরাং তোমরা (ঠিক আছে) ভোগ করো"],["فَسَوْفَ","fasawfa","but soon","অতঃপর শীঘ্রই"],["تَعْلَمُونَ","ta‘lamūna","you will know","তোমরা জানবে"]],"t":"لِيَكْفُرُو<s>ا۟</> بِ<o>مَآ</> ءَاتَيْ<m>نَٰ</>هُمْ ۚ فَتَمَتَّعُو<s>ا۟</> فَسَوْفَ تَعْلَ<p>مُو</>نَ"},{"n":35,"w":[["أَمْ","am","Or","কি"],["أَنزَلْنَا","anzalnā","have We sent","অবতীর্ণ করেছি আমরা"],["عَلَيْهِمْ","‘alayhim","to them","উপর তাদের"],["سُلْطَـٰنًۭا","sul'ṭānan","an authority","কোনো প্রমাণ"],["فَهُوَ","fahuwa","and it","সুতরাং তা"],["يَتَكَلَّمُ","yatakallamu","speaks","বলে"],["بِمَا","bimā","of what","ঐ বিষয়ে যা"],["كَانُوا۟","kānū","they were","তারা ছিলো"],["بِهِۦ","bihi","with Him","সাথে তাঁর"],["يُشْرِكُونَ","yush'rikūna","associating","শিরক করতো"]],"t":"أَمْ أَ<k>نزَ</>لْنَا عَلَيْهِمْ سُلْ<m>طَٰ</><k>نًۭا فَ</>هُوَ يَتَكَلَّمُ بِمَا كَانُو<s>ا۟</> بِ<m>هِۦ</> يُشْرِ<p>كُو</>نَ"},{"n":36,"w":[["وَإِذَآ","wa-idhā","And when","এবং যখন"],["أَذَقْنَا","adhaqnā","We cause people to taste","আস্বাদন করাই আমরা"],["ٱلنَّاسَ","l-nāsa","We cause people to taste","মানুষকে"],["رَحْمَةًۭ","raḥmatan","mercy","অনুগ্রহের"],["فَرِحُوا۟","fariḥū","they rejoice","ফলে তারা উৎফুল্ল হয়"],["بِهَا ۖ","bihā","therein","কারণে তার"],["وَإِن","wa-in","But if","এবং যদি"],["تُصِبْهُمْ","tuṣib'hum","afflicts them","পৌঁছে তাদের"],["سَيِّئَةٌۢ","sayyi-atun","an evil","কোনো দুর্দশা"],["بِمَا","bimā","for what","এ কারণে যা"],["قَدَّمَتْ","qaddamat","have sent forth","আগে পাঠিয়েছে"],["أَيْدِيهِمْ","aydīhim","their hands","হাত তাদের"],["إِذَا","idhā","behold","তখন"],["هُمْ","hum","They","তারা"],["يَقْنَطُونَ","yaqnaṭūna","despair","হতাশ হয়ে পড়ে"]],"t":"وَإِ<o>ذَآ</> أَذَ<q>قْ</>نَا <h>ٱ</><l>ل</><g>نَّ</>اسَ رَحْمَ<k>ةًۭ فَ</>رِحُو<s>ا۟</> بِهَا ۖ وَإِ<k>ن تُ</>صِ<q>بْ</>هُمْ سَيِّئَ<i>ةٌۢ بِ</>مَا قَدَّمَتْ أَيْدِيهِمْ إِذَا هُمْ يَ<q>قْ</>نَ<p>طُو</>نَ"},{"n":37,"w":[["أَوَلَمْ","awalam","Do not","কি না"],["يَرَوْا۟","yaraw","they see","তারা দেখে"],["أَنَّ","anna","that","যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يَبْسُطُ","yabsuṭu","extends","প্রশস্ত করে দেন"],["ٱلرِّزْقَ","l-riz'qa","the provision","জীবিকা"],["لِمَن","liman","for whom","(তার) জন্যে যাকে"],["يَشَآءُ","yashāu","He wills","তিনি চান"],["وَيَقْدِرُ ۚ","wayaqdiru","and straitens (it)","আবার সীমিতও করেন"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে (রয়েছে)"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَـٰتٍۢ","laāyātin","surely (are) Signs","অবশ্যই নিদর্শনাবলী"],["لِّقَوْمٍۢ","liqawmin","for a people","জন্যে সম্প্রদায়ের"],["يُؤْمِنُونَ","yu'minūna","who believe","(যারা) ঈমান আনে"]],"t":"أَوَلَمْ يَرَوْ<s>ا۟</> أَ<g>نَّ</> <h>ٱ</>للَّهَ يَ<q>بْ</>سُطُ <h>ٱ</><l>ل</>رِّزْقَ لِ<d>مَن يَ</><o>شَآ</>ءُ وَيَ<q>قْ</>دِرُ ۚ إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَا<m>يَٰ</><w>تٍۢ لِّ</>قَوْ<d>مٍۢ يُ</>ؤْمِ<p>نُو</>نَ"},{"n":38,"w":[["فَـَٔاتِ","faāti","So give","অতএব দাও"],["ذَا","dhā","the relative","সম্পন্নকে"],["ٱلْقُرْبَىٰ","l-qur'bā","the relative","নৈকট্য  (নিকট আত্নীয়কে)"],["حَقَّهُۥ","ḥaqqahu","his right","তার প্রাপ্য"],["وَٱلْمِسْكِينَ","wal-mis'kīna","and the poor","ও অভাবগ্রস্তকে"],["وَٱبْنَ","wa-ib'na","and the wayfarer","ও ছেলেকে"],["ٱلسَّبِيلِ ۚ","l-sabīli","and the wayfarer","পথের (পথিককে)"],["ذَٰلِكَ","dhālika","That","এটা"],["خَيْرٌۭ","khayrun","(is) best","উত্তম"],["لِّلَّذِينَ","lilladhīna","for those who","(তাদের) জন্যে যারা"],["يُرِيدُونَ","yurīdūna","desire","তারা চায়"],["وَجْهَ","wajha","(the) Countenance","চেহারা (সন্তুষ্টি)"],["ٱللَّهِ ۖ","l-lahi","(of) Allah","আল্লাহর"],["وَأُو۟لَـٰٓئِكَ","wa-ulāika","And those","এবং ঐ সব লোক"],["هُمُ","humu","they","তারাই"],["ٱلْمُفْلِحُونَ","l-muf'liḥūna","(are) the successful ones","সফলকাম"]],"t":"فَـَٔاتِ ذَا <h>ٱ</>لْقُرْبَىٰ حَقَّهُ<m>ۥ</> وَ<h>ٱ</>لْمِسْكِينَ وَ<h>ٱ</><q>بْ</>نَ <h>ٱ</><l>ل</>سَّبِيلِ ۚ <m>ذَٰ</>لِكَ خَيْ<w>رٌۭ لِّ</>لَّذِينَ يُرِيدُونَ وَ<q>جْ</>هَ <h>ٱ</>للَّهِ ۖ وَأُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</>لْمُفْلِ<p>حُو</>نَ"},{"n":39,"w":[["وَمَآ","wamā","And what","এবং যা কিছু"],["ءَاتَيْتُم","ātaytum","you give","দিয়ে থাকো তোমরা"],["مِّن","min","for","থেকে"],["رِّبًۭا","riban","usury","সূদ"],["لِّيَرْبُوَا۟","liyarbuwā","to increase","যেন বৃদ্ধি পায়"],["فِىٓ","fī","in","মধ্যে"],["أَمْوَٰلِ","amwāli","(the) wealth","ধনসম্পদের"],["ٱلنَّاسِ","l-nāsi","(of) people","মানুষের"],["فَلَا","falā","not","প্রকৃতপক্ষে না"],["يَرْبُوا۟","yarbū","(will) increase","বৃদ্ধি পায়"],["عِندَ","‘inda","with","কাছে"],["ٱللَّهِ ۖ","l-lahi","Allah","আল্লাহর"],["وَمَآ","wamā","But what","এবং যা কিছু"],["ءَاتَيْتُم","ātaytum","you give","দিয়ে থাকো তোমরা"],["مِّن","min","of","থেকে"],["زَكَوٰةٍۢ","zakatin","zakah","যাকাত"],["تُرِيدُونَ","turīdūna","desiring","(এ উদ্দেশ্যে যে) তোমরা চাও"],["وَجْهَ","wajha","(the) Countenance","চেহারা (সন্তুষ্টি)"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["فَأُو۟لَـٰٓئِكَ","fa-ulāika","then those","প্রকৃতপক্ষে ঐসব লোক"],["هُمُ","humu","[they]","তারাই"],["ٱلْمُضْعِفُونَ","l-muḍ'‘ifūna","(will) get manifold","সমৃদ্ধশালী"]],"t":"وَ<o>مَآ</> ءَاتَيْ<y>تُم مِّ</><w>ن رِّبًۭا لِّ</>يَرْبُوَ<s>ا۟</> <o>فِىٓ</> أَمْ<m>وَٰ</>لِ <h>ٱ</><l>ل</><g>نَّ</>اسِ فَلَا يَرْبُو<s>ا۟</> عِ<k>ندَ</> <h>ٱ</>للَّهِ ۖ وَ<o>مَآ</> ءَاتَيْ<y>تُم مِّ</><k>ن زَ</>كَ<s>وٰ</><k>ةٍۢ تُ</>رِيدُونَ وَ<q>جْ</>هَ <h>ٱ</>للَّهِ فَأُ<s>و۟</><o>لَٰٓ</>ئِكَ هُمُ <h>ٱ</>لْمُضْعِ<p>فُو</>نَ"},{"n":40,"w":[["ٱللَّهُ","al-lahu","Allah","আল্লাহ (সেই সত্ত্বা)"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["خَلَقَكُمْ","khalaqakum","created you","সৃষ্টি করেছেন তোমাদের"],["ثُمَّ","thumma","then","এরপর"],["رَزَقَكُمْ","razaqakum","He provided (for) you","জীবিকা দিয়েছেন তোমাদের"],["ثُمَّ","thumma","then","এরপর"],["يُمِيتُكُمْ","yumītukum","He will cause you to die","মৃত্যু দিবেন তোমাদের"],["ثُمَّ","thumma","then","এরপর"],["يُحْيِيكُمْ ۖ","yuḥ'yīkum","He will give you life","জীবিত করবেন তোমাদের"],["هَلْ","hal","Is (there)","আছে কি"],["مِن","min","any","মধ্য থেকে"],["شُرَكَآئِكُم","shurakāikum","(of) your partners","(বানানো) শরিকদের তোমাদের"],["مَّن","man","who","যে (কেউ)"],["يَفْعَلُ","yaf‘alu","does","করতে পারে"],["مِن","min","of","থেকে"],["ذَٰلِكُم","dhālikum","that","এগুলোর"],["مِّن","min","any","কোনো"],["شَىْءٍۢ ۚ","shayin","thing","কিছু"],["سُبْحَـٰنَهُۥ","sub'ḥānahu","Glory be to Him","তিনি পবিত্র মহান"],["وَتَعَـٰلَىٰ","wata‘ālā","and exalted is He","এবং অনেক উর্দ্ধে"],["عَمَّا","‘ammā","above what","(তা) হ'তে যা"],["يُشْرِكُونَ","yush'rikūna","they associate","তারা শিরক করে"]],"t":"ٱللَّهُ <h>ٱ</>لَّذِى خَلَقَكُمْ ثُ<g>مَّ</> رَزَقَكُمْ ثُ<g>مَّ</> يُمِيتُكُمْ ثُ<g>مَّ</> يُحْيِيكُمْ ۖ هَلْ مِ<k>ن شُ</>رَ<o>كَآ</>ئِ<y>كُم مَّ</><d>ن يَ</>فْعَلُ مِ<k>ن ذَٰ</>لِ<y>كُم مِّ</><k>ن شَىْءٍۢ ۚ سُ</><q>بْ</><m>حَٰ</>نَهُ<m>ۥ</> وَتَ<m>عَٰ</>لَىٰ عَ<g>مَّ</>ا يُشْرِ<p>كُو</>نَ"},{"n":41,"w":[["ظَهَرَ","ẓahara","Has appeared","ছড়িয়ে পড়েছে"],["ٱلْفَسَادُ","l-fasādu","the corruption","বিপর্যয়"],["فِى","fī","in","মধ্যে"],["ٱلْبَرِّ","l-bari","the land","স্থলের (স্হলভাগে)"],["وَٱلْبَحْرِ","wal-baḥri","and the sea","ও সাগরের (জলভাগে)"],["بِمَا","bimā","for what","একারণে যা"],["كَسَبَتْ","kasabat","have earned","অর্জন করেছে"],["أَيْدِى","aydī","(the) hands","হাত"],["ٱلنَّاسِ","l-nāsi","(of) people","মানুষের"],["لِيُذِيقَهُم","liyudhīqahum","so that He may let them taste","যেন তিনি আস্বাদন করান তাদের"],["بَعْضَ","ba‘ḍa","a part","কিছুটা"],["ٱلَّذِى","alladhī","(of) that which","যা"],["عَمِلُوا۟","‘amilū","they have done","তারা কাজ করেছে"],["لَعَلَّهُمْ","la‘allahum","so that they may","যাতে তারা"],["يَرْجِعُونَ","yarji‘ūna","return","ফিরে আসে"]],"t":"ظَهَرَ <h>ٱ</>لْفَسَادُ فِى <h>ٱ</>لْبَرِّ وَ<h>ٱ</>لْبَحْرِ بِمَا كَسَبَتْ أَيْدِى <h>ٱ</><l>ل</><g>نَّ</>اسِ لِيُذِيقَ<f>هُم بَ</>عْضَ <h>ٱ</>لَّذِى عَمِلُو<s>ا۟</> لَعَلَّهُمْ يَرْجِ<p>عُو</>نَ"},{"n":42,"w":[["قُلْ","qul","Say","বলো( হে নাবী )"],["سِيرُوا۟","sīrū","Travel","\"তোমরা ভ্রমণ করো"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["فَٱنظُرُوا۟","fa-unẓurū","and see","অতঃপর লক্ষ্য করো"],["كَيْفَ","kayfa","how","কেমন"],["كَانَ","kāna","was","ছিলো"],["عَـٰقِبَةُ","‘āqibatu","(the) end","( তাদের ) পরিণাম"],["ٱلَّذِينَ","alladhīna","(of) those who","যারা"],["مِن","min","(were) before","থেকে"],["قَبْلُ ۚ","qablu","(were) before","পূর্ব ( ছিলো )"],["كَانَ","kāna","Most of them were","ছিলো"],["أَكْثَرُهُم","aktharuhum","Most of them were","অধিকাংশ তাদের"],["مُّشْرِكِينَ","mush'rikīna","polytheists","মুশরেক\""]],"t":"قُلْ سِيرُو<s>ا۟</> فِى <h>ٱ</>لْأَرْضِ فَ<h>ٱ</><k>نظُ</>رُو<s>ا۟</> كَيْفَ كَانَ <m>عَٰ</>قِبَةُ <h>ٱ</>لَّذِينَ مِ<k>ن قَ</><q>بْ</>لُ ۚ كَانَ أَكْثَرُ<y>هُم مُّ</>شْرِ<p>كِي</>نَ"},{"n":43,"w":[["فَأَقِمْ","fa-aqim","So set","অতএব ( হে নাবী ) প্রতিষ্ঠিত করো"],["وَجْهَكَ","wajhaka","your face","তোমার চেহারা (তোমার লক্ষ্য)"],["لِلدِّينِ","lilddīni","to the religion","প্রতি দ্বীনের"],["ٱلْقَيِّمِ","l-qayimi","right","(যা) সঠিক"],["مِن","min","before","থেকেই"],["قَبْلِ","qabli","before","পূর্ব"],["أَن","an","[that]","যে"],["يَأْتِىَ","yatiya","comes","আসবে"],["يَوْمٌۭ","yawmun","a Day","একদিন"],["لَّا","lā","not","নয়"],["مَرَدَّ","maradda","(can be) averted","টলে যাওয়ার"],["لَهُۥ","lahu","[it]","তা"],["مِنَ","mina","from","পক্ষ থেকে"],["ٱللَّهِ ۖ","l-lahi","Allah","আল্লাহর"],["يَوْمَئِذٍۢ","yawma-idhin","That Day","সেদিন"],["يَصَّدَّعُونَ","yaṣṣadda‘ūna","they will be divided","তারা বিভক্ত হয়ে পড়বে"]],"t":"فَأَقِمْ وَ<q>جْ</>هَكَ لِلدِّينِ <h>ٱ</>لْقَيِّمِ مِ<k>ن قَ</><q>بْ</>لِ <d>أَن يَ</>أْتِىَ يَوْ<w>مٌۭ لَّ</>ا مَرَدَّ لَهُ<m>ۥ</> مِنَ <h>ٱ</>للَّهِ ۖ يَوْمَئِ<d>ذٍۢ يَ</>صَّدَّ<p>عُو</>نَ"},{"n":44,"w":[["مَن","man","Whoever","যে"],["كَفَرَ","kafara","disbelieves","অস্বীকার করবে"],["فَعَلَيْهِ","fa‘alayhi","then against him","তবে (পড়বে)উপর তার"],["كُفْرُهُۥ ۖ","kuf'ruhu","(is) his disbelief","তার অস্বীকৃতির ( কুফল )"],["وَمَنْ","waman","And whoever","এবং যারা"],["عَمِلَ","‘amila","does","কাজ করবে"],["صَـٰلِحًۭا","ṣāliḥan","righteousness","সৎ"],["فَلِأَنفُسِهِمْ","fali-anfusihim","then for themselves","তবে জন্যে নিজেদের তাদের"],["يَمْهَدُونَ","yamhadūna","they are preparing","তারা সুখশয্যা তৈরী করে"]],"t":"مَ<k>ن كَ</>فَرَ فَعَلَيْهِ كُفْرُهُ<m>ۥ</> ۖ وَمَنْ عَمِلَ <m>صَٰ</>لِ<k>حًۭا فَ</>لِأَ<k>نفُ</>سِهِمْ يَمْهَ<p>دُو</>نَ"},{"n":45,"w":[["لِيَجْزِىَ","liyajziya","That He may reward","যেন তিনি পুরস্কার দেন"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে)যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["وَعَمِلُوا۟","wa‘amilū","and do","ও কাজ করেছে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","righteous deeds","সৎ"],["مِن","min","(out) of","কারণে"],["فَضْلِهِۦٓ ۚ","faḍlihi","His Bounty","অনুগ্রহের তাঁর"],["إِنَّهُۥ","innahu","Indeed, He","নিশ্চয়ই তিনি"],["لَا","lā","(does) not","না"],["يُحِبُّ","yuḥibbu","like","ভালবাসেন"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","the disbelievers","কাফিরদেরকে"]],"t":"لِيَ<q>جْ</>زِىَ <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ مِ<k>ن فَ</>ضْلِ<o>هِۦٓ ۚ</> إِ<g>نَّ</>هُ<m>ۥ</> لَا يُحِبُّ <h>ٱ</>لْ<m>كَٰ</>فِ<p>رِي</>نَ"},{"n":46,"w":[["وَمِنْ","wamin","And among","এবং হ'তে"],["ءَايَـٰتِهِۦٓ","āyātihi","His Signs","নিদর্শনাবলী তাঁর"],["أَن","an","(is) that","( এও ) যে"],["يُرْسِلَ","yur'sila","He sends","তিনি পাঠান"],["ٱلرِّيَاحَ","l-riyāḥa","the winds","বাতাস"],["مُبَشِّرَٰتٍۢ","mubashirātin","(as) bearers of glad tidings","সুসংবাদ বাহক হিসাবে"],["وَلِيُذِيقَكُم","waliyudhīqakum","and to let you taste","এবং যাতে তিনি আস্বাদন করাতে পারেন তোমাদেরকে"],["مِّن","min","of","মাধ্যমে"],["رَّحْمَتِهِۦ","raḥmatihi","His Mercy","দয়ার তাঁর"],["وَلِتَجْرِىَ","walitajriya","and that may sail","ও যেন চলে"],["ٱلْفُلْكُ","l-ful'ku","the ships","নৌযান"],["بِأَمْرِهِۦ","bi-amrihi","at His Command","অনুসারে আদেশ তাঁর"],["وَلِتَبْتَغُوا۟","walitabtaghū","and that you may seek","ও যেন তোমরা সন্ধান করো"],["مِن","min","of","হ'তে"],["فَضْلِهِۦ","faḍlihi","His Bounty","অনুগ্রহ তাঁর"],["وَلَعَلَّكُمْ","wala‘allakum","and that you may","এবং যাতে  তোমরা"],["تَشْكُرُونَ","tashkurūna","be grateful","কৃতজ্ঞতা প্রকাশ করো"]],"t":"وَمِنْ ءَا<m>يَٰ</>تِ<o>هِۦٓ</> <d>أَن يُ</>رْسِلَ <h>ٱ</><l>ل</>رِّيَاحَ مُبَشِّ<m>رَٰ</><d>تٍۢ وَ</>لِيُذِيقَ<y>كُم مِّ</><w>ن رَّ</>حْمَتِ<m>هِۦ</> وَلِتَ<q>جْ</>رِىَ <h>ٱ</>لْفُلْكُ بِأَمْرِ<m>هِۦ</> وَلِتَ<q>بْ</>تَغُو<s>ا۟</> مِ<k>ن فَ</>ضْلِ<m>هِۦ</> وَلَعَلَّكُمْ تَشْكُ<p>رُو</>نَ"},{"n":47,"w":[["وَلَقَدْ","walaqad","And verily","এবং নিশ্চয়ই"],["أَرْسَلْنَا","arsalnā","We sent","পাঠিয়েছি আমরা"],["مِن","min","before you","থেকে"],["قَبْلِكَ","qablika","before you","তোমার পূর্ব"],["رُسُلًا","rusulan","Messengers","রাসূলদেরকে"],["إِلَىٰ","ilā","to","প্রতি"],["قَوْمِهِمْ","qawmihim","their people","জাতির তাদের"],["فَجَآءُوهُم","fajāūhum","and they came to them","অতঃপর তারা এসেছিলো তাদের কাছে"],["بِٱلْبَيِّنَـٰتِ","bil-bayināti","with clear proofs","নিয়ে সুস্পষ্ট নিদর্শনসমূহ"],["فَٱنتَقَمْنَا","fa-intaqamnā","then We took retribution","অতঃপর প্রতিশোধ নিয়েছি আমরা"],["مِنَ","mina","from","হ'তে"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["أَجْرَمُوا۟ ۖ","ajramū","committed crimes","অপরাধ করেছিলো"],["وَكَانَ","wakāna","And it was","এবং (এটা) হলো"],["حَقًّا","ḥaqqan","incumbent","দায়িত্ব"],["عَلَيْنَا","‘alaynā","upon Us","উপর আমাদের"],["نَصْرُ","naṣru","(to) help","সাহায্য করা"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believers","মু'মিনদেরকে"]],"t":"وَلَقَ<q>دْ</> أَرْسَلْنَا مِ<k>ن قَ</><q>بْ</>لِكَ رُسُلًا إِلَىٰ قَوْمِهِمْ فَ<o>جَآ</>ءُو<f>هُم بِ</><h>ٱ</>لْبَيِّ<m>نَٰ</>تِ فَ<h>ٱ</><k>نتَ</>قَمْنَا مِنَ <h>ٱ</>لَّذِينَ أَ<q>جْ</>رَمُو<s>ا۟ ۖ</> وَكَانَ حَقًّا عَلَيْنَا نَصْرُ <h>ٱ</>لْمُؤْمِ<p>نِي</>نَ"},{"n":48,"w":[["ٱللَّهُ","al-lahu","Allah","আল্লাহ (তিনিই)"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["يُرْسِلُ","yur'silu","sends","পাঠান"],["ٱلرِّيَـٰحَ","l-riyāḥa","the winds","বাতাস"],["فَتُثِيرُ","fatuthīru","so they raise","ফলে তা সঞ্চালিত করে"],["سَحَابًۭا","saḥāban","(the) clouds","মেঘমালাকে"],["فَيَبْسُطُهُۥ","fayabsuṭuhu","then He spreads them","অতঃপর তিনি ছড়িয়ে দেন তা"],["فِى","fī","in","মধ্যে"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশের"],["كَيْفَ","kayfa","how","যেমন"],["يَشَآءُ","yashāu","He wills","তিনি চান"],["وَيَجْعَلُهُۥ","wayaj‘aluhu","and He makes them","এবং করেন তা"],["كِسَفًۭا","kisafan","fragments","খণ্ড-বিখন্ড"],["فَتَرَى","fatarā","so you see","অতঃপর তুমি দেখতে পাও"],["ٱلْوَدْقَ","l-wadqa","the rain","বৃষ্টির ফোঁটা"],["يَخْرُجُ","yakhruju","coming forth","তা বের হয়"],["مِنْ","min","from","হ'তে"],["خِلَـٰلِهِۦ ۖ","khilālihi","their midst","ভিতর তার"],["فَإِذَآ","fa-idhā","Then when","অতঃপর যখন"],["أَصَابَ","aṣāba","He causes it to fall on","পৌঁছে দেন"],["بِهِۦ","bihi","He causes it to fall on","সহ তা"],["مَن","man","whom","যাকে"],["يَشَآءُ","yashāu","He wills","তিনি চান"],["مِنْ","min","of","মধ্যে হ'তে"],["عِبَادِهِۦٓ","‘ibādihi","His slaves","দাসদের তাঁর"],["إِذَا","idhā","behold","তখন"],["هُمْ","hum","They","তারা"],["يَسْتَبْشِرُونَ","yastabshirūna","rejoice","আনন্দিত হয়ে যায়"]],"t":"ٱللَّهُ <h>ٱ</>لَّذِى يُرْسِلُ <h>ٱ</><l>ل</>رِّ<m>يَٰ</>حَ فَتُثِيرُ سَحَا<k>بًۭا فَ</>يَ<q>بْ</>سُطُهُ<m>ۥ</> فِى <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ كَيْفَ يَ<o>شَآ</>ءُ وَيَ<q>جْ</>عَلُهُ<m>ۥ</> كِسَ<k>فًۭا فَ</>تَرَى <h>ٱ</>لْوَ<q>دْ</>قَ يَخْرُجُ مِنْ خِ<m>لَٰلِهِۦ</> ۖ فَإِ<o>ذَآ</> أَصَابَ بِ<m>هِۦ</> <d>مَن يَ</><o>شَآ</>ءُ مِنْ عِبَادِ<o>هِۦٓ</> إِذَا هُمْ يَسْتَ<q>بْ</>شِ<p>رُو</>نَ"},{"n":49,"w":[["وَإِن","wa-in","And certainly","এবং যদিও"],["كَانُوا۟","kānū","they were","তারা ছিলো"],["مِن","min","before","থেকে"],["قَبْلِ","qabli","before","পূর্ব"],["أَن","an","[that]","যে"],["يُنَزَّلَ","yunazzala","it was sent down","( বৃষ্টি )বর্ষণ করা হবে"],["عَلَيْهِم","‘alayhim","upon them","উপর তাদের"],["مِّن","min","[before it]","থেকেই"],["قَبْلِهِۦ","qablihi","[before it]","পূর্ব এর"],["لَمُبْلِسِينَ","lamub'lisīna","surely in despair","অবশ্যই নিরাশ"]],"t":"وَإِ<k>ن كَ</>انُو<s>ا۟</> مِ<k>ن قَ</><q>بْ</>لِ <d>أَن يُ</>نَزَّلَ عَلَيْ<y>هِم مِّ</><k>ن قَ</><q>بْ</>لِ<m>هِۦ</> لَمُ<q>بْ</>لِ<p>سِي</>نَ"},{"n":50,"w":[["فَٱنظُرْ","fa-unẓur","So look","অতঃপর লক্ষ্য করো"],["إِلَىٰٓ","ilā","at","প্রতি"],["ءَاثَـٰرِ","āthāri","(the) effects","প্রভাবের"],["رَحْمَتِ","raḥmati","(of the) Mercy","অনুগ্রহের"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["كَيْفَ","kayfa","how","কিভাবে"],["يُحْىِ","yuḥ'yī","He gives life","জীবিত করেন"],["ٱلْأَرْضَ","l-arḍa","(to) the earth","জমিনকে"],["بَعْدَ","ba‘da","after","পর"],["مَوْتِهَآ ۚ","mawtihā","its death","মৃত্যুর তার"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ذَٰلِكَ","dhālika","that","এভাবে"],["لَمُحْىِ","lamuḥ'yī","surely He (will) give life","অবশ্যই তিনি জীবন্তকারী"],["ٱلْمَوْتَىٰ ۖ","l-mawtā","(to) the dead","মৃতদেরকে"],["وَهُوَ","wahuwa","And He","এবং তিনিই"],["عَلَىٰ","‘alā","(is) on","উপর"],["كُلِّ","kulli","every","সব"],["شَىْءٍۢ","shayin","thing","কিছুর"],["قَدِيرٌۭ","qadīrun","All-Powerful","সর্বশক্তিমান"]],"t":"فَ<h>ٱ</><k>نظُ</>رْ إِلَ<o>ىٰٓ</> ءَا<m>ثَٰ</>رِ رَحْمَتِ <h>ٱ</>للَّهِ كَيْفَ يُحْىِ <h>ٱ</>لْأَرْضَ بَعْدَ مَوْتِ<o>هَآ ۚ</> إِ<g>نَّ</> <m>ذَٰ</>لِكَ لَمُحْىِ <h>ٱ</>لْمَوْتَىٰ ۖ وَهُوَ عَلَىٰ كُلِّ <k>شَىْءٍۢ قَ</><p>دِي</>رٌۭ"},{"n":51,"w":[["وَلَئِنْ","wala-in","But if","এবং অবশ্যই যদি"],["أَرْسَلْنَا","arsalnā","We sent","আমরা পাঠাই"],["رِيحًۭا","rīḥan","a wind","(এমন)বাতাস"],["فَرَأَوْهُ","fara-awhu","and they see it","ফলে তারা দেখে তা"],["مُصْفَرًّۭا","muṣ'farran","turn yellow","হলুদ রঙ"],["لَّظَلُّوا۟","laẓallū","certainly they continue","অবশ্যই লেগে থাকে তবুও"],["مِنۢ","min","after it","থেকে"],["بَعْدِهِۦ","ba‘dihi","after it","পর তার"],["يَكْفُرُونَ","yakfurūna","(in) disbelief","অকৃতজ্ঞতা করতে"]],"t":"وَلَئِنْ أَرْسَلْنَا رِي<k>حًۭا فَ</>رَأَوْهُ مُصْفَ<w>رًّۭا لَّ</>ظَلُّو<s>ا۟</> <i>مِنۢ بَ</>عْدِ<m>هِۦ</> يَكْفُ<p>رُو</>نَ"},{"n":52,"w":[["فَإِنَّكَ","fa-innaka","So indeed, you","তাই নিশ্চয়ই তুমি"],["لَا","lā","(can) not","না"],["تُسْمِعُ","tus'mi‘u","make the dead hear","শুনাতে পারো"],["ٱلْمَوْتَىٰ","l-mawtā","make the dead hear","মৃতদেরকে"],["وَلَا","walā","and not","আর না"],["تُسْمِعُ","tus'mi‘u","make the deaf hear","শুনাতে পারো"],["ٱلصُّمَّ","l-ṣuma","make the deaf hear","বধিরকেও"],["ٱلدُّعَآءَ","l-du‘āa","the call","আহবান"],["إِذَا","idhā","when","যখন"],["وَلَّوْا۟","wallaw","they turn","তারা ফিরায়"],["مُدْبِرِينَ","mud'birīna","retreating","পিঠসমূহ"]],"t":"فَإِ<g>نَّ</>كَ لَا تُسْمِعُ <h>ٱ</>لْمَوْتَىٰ وَلَا تُسْمِعُ <h>ٱ</><l>ل</>صُّ<g>مَّ</> <h>ٱ</><l>ل</>دُّ<o>عَآ</>ءَ إِذَا وَلَّوْ<s>ا۟</> مُ<q>دْ</>بِ<p>رِي</>نَ"},{"n":53,"w":[["وَمَآ","wamā","And not","এবং না"],["أَنتَ","anta","you","তুমি"],["بِهَـٰدِ","bihādi","can guide","পথপ্রদর্শক"],["ٱلْعُمْىِ","l-‘um'yi","the blind","অন্ধলোকদের"],["عَن","‘an","from","হ'তে"],["ضَلَـٰلَتِهِمْ ۖ","ḍalālatihim","their error","পথভ্রষ্টতা তাদের"],["إِن","in","Not","না"],["تُسْمِعُ","tus'mi‘u","you can make hear","তুমি শুনাতে পারো"],["إِلَّا","illā","except","ছাড়া"],["مَن","man","(those) who","(তাকে) যে"],["يُؤْمِنُ","yu'minu","believe","ঈমান আনে"],["بِـَٔايَـٰتِنَا","biāyātinā","in Our Verses","প্রতি আমাদের নিদর্শনসমূহের"],["فَهُم","fahum","so they","কারণ তারা"],["مُّسْلِمُونَ","mus'limūna","surrender","আত্নসমর্পনকারী (মুসলমান)"]],"t":"وَ<o>مَآ</> أَ<k>نتَ</> بِ<m>هَٰ</>دِ <h>ٱ</>لْعُمْىِ عَ<k>ن ضَ</><m>لَٰ</>لَتِهِمْ ۖ إِ<k>ن تُ</>سْمِعُ إِلَّا <d>مَن يُ</>ؤْمِنُ بِـَٔا<m>يَٰ</>تِنَا فَ<y>هُم مُّ</>سْلِ<p>مُو</>نَ"},{"n":54,"w":[["۞ ٱللَّهُ","al-lahu","Allah","( তিনিই ) আল্লাহ"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["خَلَقَكُم","khalaqakum","created you","সৃষ্টি করেছেন তোমাদের"],["مِّن","min","from","হ'তে"],["ضَعْفٍۢ","ḍa‘fin","weakness","দুর্বল অবস্থা"],["ثُمَّ","thumma","then","এরপর"],["جَعَلَ","ja‘ala","made","দান করেছেন"],["مِنۢ","min","after","থেকে"],["بَعْدِ","ba‘di","after","পর"],["ضَعْفٍۢ","ḍa‘fin","weakness","দুর্বল অবস্থার"],["قُوَّةًۭ","quwwatan","strength","শক্তি"],["ثُمَّ","thumma","then","এরপর"],["جَعَلَ","ja‘ala","made","করে দিয়েছেন"],["مِنۢ","min","after","থেকে"],["بَعْدِ","ba‘di","after","পর"],["قُوَّةٍۢ","quwwatin","strength","শক্তির"],["ضَعْفًۭا","ḍa‘fan","weakness","দুর্বল"],["وَشَيْبَةًۭ ۚ","washaybatan","and gray hair","ও বৃদ্ধ"],["يَخْلُقُ","yakhluqu","He creates","তিনি সৃষ্টি করেন"],["مَا","mā","what","যা"],["يَشَآءُ ۖ","yashāu","He wills","তিনি চান"],["وَهُوَ","wahuwa","and He"