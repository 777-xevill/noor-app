"walākinnakum","but you","কিন্তু তোমরা"],["كُنتُمْ","kuntum","were","তোমরা ছিলে (এমন)"],["لَا","lā","not","না"],["تَعْلَمُونَ","ta‘lamūna","knowing","তোমরা জানতে"]],"t":"وَقَالَ <h>ٱ</>لَّذِينَ أُوتُو<s>ا۟</> <h>ٱ</>لْعِلْمَ وَ<h>ٱ</>لْإِي<m>مَٰ</>نَ لَقَ<q>دْ</> لَبِثْتُمْ فِى كِ<m>تَٰ</>بِ <h>ٱ</>للَّهِ إِلَىٰ يَوْمِ <h>ٱ</>لْبَعْثِ ۖ فَ<m>هَٰ</>ذَا يَوْمُ <h>ٱ</>لْبَعْثِ وَ<m>لَٰ</>كِ<g>نَّ</>كُمْ كُ<k>نتُ</>مْ لَا تَعْلَ<p>مُو</>نَ"},{"n":57,"w":[["فَيَوْمَئِذٍۢ","fayawma-idhin","So that Day","অতএব সেদিন"],["لَّا","lā","not","না"],["يَنفَعُ","yanfa‘u","will profit","উপকারে আসবে"],["ٱلَّذِينَ","alladhīna","those who","( তাদেরকে ) যারা"],["ظَلَمُوا۟","ẓalamū","wronged","সীমালঙ্ঘন করেছে"],["مَعْذِرَتُهُمْ","ma‘dhiratuhum","their excuses","অজুহাত তাদের"],["وَلَا","walā","and not","আর না"],["هُمْ","hum","they","তাদের"],["يُسْتَعْتَبُونَ","yus'ta‘tabūna","will be allowed to make amends","তাদেরকে তওবা করে আল্লাহ তা'লাকে খুশি করার সুযোগও দেয়া হবে"]],"t":"فَيَوْمَئِ<w>ذٍۢ لَّ</>ا يَ<k>نفَ</>عُ <h>ٱ</>لَّذِينَ ظَلَمُو<s>ا۟</> مَعْذِرَتُهُمْ وَلَا هُمْ يُسْتَعْتَ<p>بُو</>نَ"},{"n":58,"w":[["وَلَقَدْ","walaqad","And verily","এবং নিশ্চয়ই"],["ضَرَبْنَا","ḍarabnā","We (have) set forth","পেশ করেছি আমরা"],["لِلنَّاسِ","lilnnāsi","for mankind","জন্যে মানুষের"],["فِى","fī","in","মধ্যে"],["هَـٰذَا","hādhā","this ","এই"],["ٱلْقُرْءَانِ","l-qur'āni","[the] Quran","কুরআনের"],["مِن","min","of","প্রকার"],["كُلِّ","kulli","every","প্রত্যেক"],["مَثَلٍۢ ۚ","mathalin","example","দৃষ্টান্ত"],["وَلَئِن","wala-in","But if","এবং অবশ্যই যদি"],["جِئْتَهُم","ji'tahum","you bring them","তুমি আসো নিকট তাদের"],["بِـَٔايَةٍۢ","biāyatin","a sign","নিয়ে (যে)নিদর্শন"],["لَّيَقُولَنَّ","layaqūlanna","surely will say","অবশ্যই তারা বলবেই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوٓا۟","kafarū","disbelieve","অস্বীকার করেছে"],["إِنْ","in","Not","\"না"],["أَنتُمْ","antum","you","তোমরা"],["إِلَّا","illā","(are) except","এ ছাড়া"],["مُبْطِلُونَ","mub'ṭilūna","falsifiers","মিথ্যাশ্রয়ী (বাতিলপন্থী)\""]],"t":"وَلَقَ<q>دْ</> ضَرَ<q>بْ</>نَا لِل<g>نَّ</>اسِ فِى <m>هَٰ</>ذَا <h>ٱ</>لْقُرْءَانِ مِ<k>ن كُ</>لِّ مَثَ<d>لٍۢ ۚ وَ</>لَئِ<k>ن جِ</>ئْتَ<f>هُم بِـَٔ</>ايَ<w>ةٍۢ لَّ</>يَقُولَ<g>نَّ</> <h>ٱ</>لَّذِينَ كَفَ<o>رُوٓ</><s>ا۟</> إِنْ أَ<k>نتُ</>مْ إِلَّا مُ<q>بْ</>طِ<p>لُو</>نَ"},{"n":59,"w":[["كَذَٰلِكَ","kadhālika","Thus","এরূপে"],["يَطْبَعُ","yaṭba‘u","Allah seals","সীল মেরে দিয়েছেন (মোহর করে দিয়েছেন)"],["ٱللَّهُ","l-lahu","Allah seals","আল্লাহ"],["عَلَىٰ","‘alā","[on]","উপর"],["قُلُوبِ","qulūbi","(the) hearts","অন্তরসমূহের"],["ٱلَّذِينَ","alladhīna","(of) those who","(তাদের) যারা"],["لَا","lā","(do) not","না"],["يَعْلَمُونَ","ya‘lamūna","know","তারা জানে"]],"t":"كَ<m>ذَٰ</>لِكَ يَ<q>طْ</>بَعُ <h>ٱ</>للَّهُ عَلَىٰ قُلُوبِ <h>ٱ</>لَّذِينَ لَا يَعْلَ<p>مُو</>نَ"},{"n":60,"w":[["فَٱصْبِرْ","fa-iṣ'bir","So be patient","অতএব ধৈর্য ধরো"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["وَعْدَ","wa‘da","(the) Promise","প্রতিশ্রুতি"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["حَقٌّۭ ۖ","ḥaqqun","(is) true","সত্য"],["وَلَا","walā","And (let) not","এবং না"],["يَسْتَخِفَّنَّكَ","yastakhiffannaka","take you in light estimation","তোমাকে হালকা পায় (বিচলিত করে)"],["ٱلَّذِينَ","alladhīna","those who","(তারা)যারা"],["لَا","lā","(are) not","না"],["يُوقِنُونَ","yūqinūna","certain in faith","দৃঢ় বিশ্বাস করে"]],"t":"فَ<h>ٱ</>صْبِرْ إِ<g>نَّ</> وَعْدَ <h>ٱ</>للَّهِ حَ<d>قٌّۭ ۖ وَ</>لَا يَسْتَخِفَّ<g>نَّ</>كَ <h>ٱ</>لَّذِينَ لَا يُوقِ<p>نُو</>نَ"}]}