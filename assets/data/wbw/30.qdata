{"n":30,"a":[{"n":1,"w":[["الٓمٓ","alif-lam-meem","Alif Lam Meem","আলিফ লাম- মীম-"]],"t":"ا<n>لٓمٓ</>"},{"n":2,"w":[["غُلِبَتِ","ghulibati","Have been defeated","পরাজিত হয়েছে"],["ٱلرُّومُ","l-rūmu","the Romans","রোমানরা"]],"t":"غُلِبَتِ <h>ٱ</><l>ل</><p>رُّو</>مُ"},{"n":3,"w":[["فِىٓ","fī","In","মধ্যে"],["أَدْنَى","adnā","(the) nearest","নিকটবর্তী"],["ٱلْأَرْضِ","l-arḍi","land","অঞ্চলের"],["وَهُم","wahum","But they","কিন্তু তারা"],["مِّنۢ","min","after","থেকে"],["بَعْدِ","ba‘di","after","পর"],["غَلَبِهِمْ","ghalabihim","their defeat","পরাজয়ের তাদের"],["سَيَغْلِبُونَ","sayaghlibūna","will overcome","শীঘ্রই জয়লাভ করবে"]],"t":"<o>فِىٓ</> أَ<q>دْ</>نَى <h>ٱ</>لْأَرْضِ وَ<y>هُم مِّ</><i>نۢ بَ</>عْدِ غَلَبِهِمْ سَيَغْلِ<p>بُو</>نَ"},{"n":4,"w":[["فِى","fī","Within","মধ্যে"],["بِضْعِ","biḍ'‘i","a few","কয়েক"],["سِنِينَ ۗ","sinīna","years","বছরের"],["لِلَّهِ","lillahi","For Allah","জন্যে আল্লাহরই"],["ٱلْأَمْرُ","l-amru","(is) the command","সিদ্ধান্ত"],["مِن","min","before","এর"],["قَبْلُ","qablu","before","পূর্ব"],["وَمِنۢ","wamin","and after","এবং এর"],["بَعْدُ ۚ","ba‘du","and after","এবং পরও"],["وَيَوْمَئِذٍۢ","wayawma-idhin","And that day","এবং সেদিন"],["يَفْرَحُ","yafraḥu","will rejoice","উৎফুল্ল হবে"],["ٱلْمُؤْمِنُونَ","l-mu'minūna","the believers","মু'মিনরা"]],"t":"فِى بِضْعِ سِنِينَ ۗ لِلَّهِ <h>ٱ</>لْأَمْرُ مِ<k>ن قَ</><q>بْ</>لُ وَ<i>مِنۢ بَ</>عْدُ ۚ وَيَوْمَئِ<d>ذٍۢ يَ</>فْرَحُ <h>ٱ</>لْمُؤْمِ<p>نُو</>نَ"},{"n":5,"w":[["بِنَصْرِ","binaṣri","With (the) help","মাধ্যমে সাহায্যের"],["ٱللَّهِ ۚ","l-lahi","(of) Allah","আল্লাহর"],["يَنصُرُ","yanṣuru","He helps","তিনি সাহায্য করেন"],["مَن","man","whom","যাকে"],["يَشَآءُ ۖ","yashāu","He wills","তিনি চান"],["وَهُوَ","wahuwa","And He","এবং তিনিই"],["ٱلْعَزِيزُ","l-‘azīzu","(is) the All-Mighty","পরাক্রমশালী"],["ٱلرَّحِيمُ","l-raḥīmu","the Most Merciful","পরম দয়ালু"]],"t":"بِنَصْرِ <h>ٱ</>للَّهِ ۚ يَ<k>نصُ</>رُ <d>مَن يَ</><o>شَآ</>ءُ ۖ وَهُوَ <h>ٱ</>لْعَزِيزُ <h>ٱ</><l>ل</>رَّ<p>حِي</>مُ"},{"n":6,"w":[["وَعْدَ","wa‘da","(It is the) Promise","(এটা)প্রতিশ্রুতি"],["ٱللَّهِ ۖ","l-lahi","(of) Allah","আল্লাহর"],["لَا","lā","(Does) not","না"],["يُخْلِفُ","yukh'lifu","fail","ভঙ্গ করেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["وَعْدَهُۥ","wa‘dahu","(in) His promise","প্রতিশ্রুতি তাঁর"],["وَلَـٰكِنَّ","walākinna","but","কিন্তু"],["أَكْثَرَ","akthara","most (of)","অধিকাংশ"],["ٱلنَّاسِ","l-nāsi","[the] people","মানুষ"],["لَا","lā","(do) not","না"],["يَعْلَمُونَ","ya‘lamūna","know","তারা জানে"]],"t":"وَعْدَ <h>ٱ</>للَّهِ ۖ لَا يُخْلِفُ <h>ٱ</>للَّهُ وَعْدَهُ<m>ۥ</> وَ<m>لَٰ</>كِ<g>نَّ</> أَكْثَرَ <h>ٱ</><l>ل</><g>نَّ</>اسِ لَا يَعْلَ<p>مُو</>نَ"},{"n":7,"w":[["يَعْلَمُونَ","ya‘lamūna","They know","(কেবল) তারা জানে"],["ظَـٰهِرًۭا","ẓāhiran","(the) apparent","বাহ্যিক দিক"],["مِّنَ","mina","of","থেকে"],["ٱلْحَيَوٰةِ","l-ḥayati","the life","জীবনের"],["ٱلدُّنْيَا","l-dun'yā","(of) the world","পার্থিব"],["وَهُمْ","wahum","but they","আর তারা"],["عَنِ","‘ani","about","সম্পর্কে"],["ٱلْـَٔاخِرَةِ","l-ākhirati","the Hereafter","আখেরাত"],["هُمْ","hum","[they]","তারা"],["غَـٰفِلُونَ","ghāfilūna","(are) heedless","অমনোযোগী"]],"t":"يَعْلَمُونَ <m>ظَٰ</>هِ<d>رًۭا مِّ</>نَ <h>ٱ</>لْحَيَ<s>وٰ</>ةِ <h>ٱ</><l>ل</>دُّنْيَا وَهُمْ عَنِ <h>ٱ</>لْءَاخِرَةِ هُمْ <m>غَٰ</>فِ<p>لُو</>نَ"},{"n":8,"w":[["أَوَلَمْ","awalam","Do not","কি না"],["يَتَفَكَّرُوا۟","yatafakkarū","they ponder","তারা চিন্তা করে (মনের)"],["فِىٓ","fī","within","মধ্যে"],["أَنفُسِهِم ۗ","anfusihim","themselves","নিজেদের তাদের"],["مَّا","mā","Not","না"],["خَلَقَ","khalaqa","Allah (has) created","সৃষ্টি করেছেন"],["ٱللَّهُ","l-lahu","Allah (has) created","আল্লাহ্‌"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশমন্ডলী"],["وَٱلْأَرْضَ","wal-arḍa","and the earth","ও পৃথিবী"],["وَمَا","wamā","and what","এবং যা (আছে)"],["بَيْنَهُمَآ","baynahumā","(is) between them","দু'য়ের মাঝে তাদের"],["إِلَّا","illā","except","ছাড়া"],["بِٱلْحَقِّ","bil-ḥaqi","in truth","ভাবে যথাযথ"],["وَأَجَلٍۢ","wa-ajalin","and (for) a term","এবং একটি কালের (জন্যে)"],["مُّسَمًّۭى ۗ","musamman","appointed","নির্দিষ্ট"],["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["كَثِيرًۭا","kathīran","many","অধিকাংশ"],["مِّنَ","mina","of","মধ্যে"],["ٱلنَّاسِ","l-nāsi","the people","মানুষের"],["بِلِقَآئِ","biliqāi","in (the) meeting","সম্পর্কে সাক্ষাৎ"],["رَبِّهِمْ","rabbihim","(with) their Lord","রবের তাদের"],["لَكَـٰفِرُونَ","lakāfirūna","surely (are) disbelievers","অবশ্যই অস্বীকারকারী"]],"t":"أَوَلَمْ يَتَفَكَّرُو<s>ا۟</> <o>فِىٓ</> أَ<k>نفُ</>سِ<y>هِم ۗ مَّ</>ا خَلَقَ <h>ٱ</>للَّهُ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضَ وَمَا بَيْنَهُ<o>مَآ</> إِلَّا بِ<h>ٱ</>لْحَقِّ وَأَجَ<d>لٍۢ مُّسَمًّۭى ۗ وَ</>إِ<g>نَّ</> كَثِي<d>رًۭا مِّ</>نَ <h>ٱ</><l>ل</><g>نَّ</>اسِ بِلِقَآئِ رَبِّهِمْ لَ<m>كَٰ</>فِ<p>رُو</>نَ"},{"n":9,"w":[["أَوَلَمْ","awalam","Have not","কি না"],["يَسِيرُوا۟","yasīrū","they traveled","তারা ভ্রমণ করে"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["فَيَنظُرُوا۟","fayanẓurū","and observed","তাহ'লে তারা দেখতে পেতো"],["كَيْفَ","kayfa","how","কেমন"],["كَانَ","kāna","was","ছিলো"],["عَـٰقِبَةُ","‘āqibatu","(the) end","পরিণাম"],["ٱلَّذِينَ","alladhīna","(of) those","(তাদের) যারা"],["مِن","min","before them","থেকে"],["قَبْلِهِمْ ۚ","qablihim","before them","পূর্ব তাদের (ছিলো)"],["كَانُوٓا۟","kānū","They were","তারা ছিলো"],["أَشَدَّ","ashadda","mightier","প্রবলতর"],["مِنْهُمْ","min'hum","than them","চেয়ে এদের"],["قُوَّةًۭ","quwwatan","(in) strength","শক্তিতে"],["وَأَثَارُوا۟","wa-athārū","and they dug","এবং তারা চাষ করতো"],["ٱلْأَرْضَ","l-arḍa","the earth","জমীন"],["وَعَمَرُوهَآ","wa‘amarūhā","and built (on) it","ও তারা আবাদ করতো তা"],["أَكْثَرَ","akthara","more","অনেক বেশি"],["مِمَّا","mimmā","than what","(তার)চেয়েও যা"],["عَمَرُوهَا","‘amarūhā","they have built (on) it","এরা আবাদ করেছে তা"],["وَجَآءَتْهُمْ","wajāathum","And came (to) them","এবং কাছে এসেছিলো তাদের"],["رُسُلُهُم","rusuluhum","their Messengers","রাসূলরা তাদের"],["بِٱلْبَيِّنَـٰتِ ۖ","bil-bayināti","with clear proofs","নিয়ে স্পষ্ট নিদর্শনাবলী"],["فَمَا","famā","So not","বস্তুতঃ না"],["كَانَ","kāna","was","ছিলেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ্‌"],["لِيَظْلِمَهُمْ","liyaẓlimahum","to wrong them","যাতে অন্যায় করবেন উপর তাদের"],["وَلَـٰكِن","walākin","but","কিন্তু"],["كَانُوٓا۟","kānū","they were","তারা ছিলো (এমন যে)"],["أَنفُسَهُمْ","anfusahum","themselves","নিজেদের তাদের (উপর)"],["يَظْلِمُونَ","yaẓlimūna","(doing) wrong","অন্যায় করতো"]],"t":"أَوَلَمْ يَسِيرُو<s>ا۟</> فِى <h>ٱ</>لْأَرْضِ فَيَ<k>نظُ</>رُو<s>ا۟</> كَيْفَ كَانَ <m>عَٰ</>قِبَةُ <h>ٱ</>لَّذِينَ مِ<k>ن قَ</><q>بْ</>لِهِمْ ۚ كَا<o>نُوٓ</><s>ا۟</> أَشَدَّ مِنْهُمْ قُوَّ<d>ةًۭ وَ</>أَثَارُو<s>ا۟</> <h>ٱ</>لْأَرْضَ وَعَمَرُو<o>هَآ</> أَكْثَرَ مِ<g>مَّ</>ا عَمَرُوهَا وَ<o>جَآ</>ءَتْهُمْ رُسُلُ<f>هُم بِ</><h>ٱ</>لْبَيِّ<m>نَٰ</>تِ ۖ فَمَا كَانَ <h>ٱ</>للَّهُ لِيَظْلِمَهُمْ وَ<m>لَٰ</>كِ<k>ن كَ</>ا<o>نُوٓ</><s>ا۟</> أَ<k>نفُ</>سَهُمْ يَظْلِ<p>مُو</>نَ"},{"n":10,"w":[["ثُمَّ","thumma","Then","এরপর"],["كَانَ","kāna","was","হলো"],["عَـٰقِبَةَ","‘āqibata","(the) end","পরিণাম"],["ٱلَّذِينَ","alladhīna","(of) those who","(তাদের) যারা"],["أَسَـٰٓـُٔوا۟","asāū","did evil ","মন্দকর্ম করেছিলো"],["ٱلسُّوٓأَىٰٓ","l-sūā","the evil","মন্দ"],["أَن","an","because","(এজন্যে) যে"],["كَذَّبُوا۟","kadhabū","they denied","তারা মিথ্যারোপ করেছিলো"],["بِـَٔايَـٰتِ","biāyāti","(the) Signs","প্রতি নিদর্শনাবলীর"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَكَانُوا۟","wakānū","and were","এবং তারা ছিলো"],["بِهَا","bihā","of them","সম্পর্কে তা"],["يَسْتَهْزِءُونَ","yastahziūna","making mockery","বিদ্রুপ করতো"]],"t":"ثُ<g>مَّ</> كَانَ <m>عَٰ</>قِبَةَ <h>ٱ</>لَّذِينَ أَ<o>سَٰٓـُٔ</>و<s>ا۟</> <h>ٱ</><l>ل</><o>سُّوٓأَىٰٓ</> أَ<k>ن كَ</>ذَّبُو<s>ا۟</> بِـَٔا<m>يَٰ</>تِ <h>ٱ</>للَّهِ وَكَانُو<s>ا۟</> بِهَا يَسْتَهْزِ<p>ءُو</>نَ"},{"n":11,"w":[["ٱللَّهُ","al-lahu","Allah","আল্লাহ"],["يَبْدَؤُا۟","yabda-u","originates","সূচনা করেন"],["ٱلْخَلْقَ","l-khalqa","the creation","সৃষ্টির"],["ثُمَّ","thumma","then","এরপর"],["يُعِيدُهُۥ","yu‘īduhu","He repeats it","পুনরাবৃত্তি করবেন তা"],["ثُمَّ","thumma","then","এরপর"],["إِلَيْهِ","ilayhi","to Him","দিকে তাঁরই"],["تُرْجَعُونَ","tur'ja‘ūna","you will be returned","তোমরা প্রত্যাবর্তিত হবে"]],"t":"ٱللَّهُ يَ<q>بْ</>دَؤُ<s>ا۟</> <h>ٱ</>لْخَلْقَ ثُ<g>مَّ</> يُعِيدُهُ<m>ۥ</> ثُ<g>مَّ</> إِلَيْهِ تُرْجَ<p>عُو</>نَ"},{"n":12,"w":[["وَيَوْمَ","wayawma","And (the) Day","এবং যেদিন"],["تَقُومُ","taqūmu","will (be) established","সংঘটিত হবে"],["ٱلسَّاعَةُ","l-sā‘atu","the Hour","ক্বিয়ামাত"],["يُبْلِسُ","yub'lisu","will (be in) despair","হতাশ হয়ে যাবে"],["ٱلْمُجْرِمُونَ","l-muj'rimūna","the criminals","অপরাধীরা"]],"t":"وَيَوْمَ تَقُومُ <h>ٱ</><l>ل</>سَّاعَةُ يُ<q>بْ</>لِسُ <h>ٱ</>لْمُ<q>جْ</>رِ<p>مُو</>نَ"},{"n":13,"w":[["وَلَمْ","walam","And not","এবং না"],["يَكُن","yakun","will be","হবে"],["لَّهُم","lahum","for them","জন্যে তাদের"],["مِّن","min","among","মধ্য থেকে (কেউ)"],["شُرَكَآئِهِمْ","shurakāihim","theirs partners","শরিকদের তাদের"],["شُفَعَـٰٓؤُا۟","shufa‘āu","any intercessors","সুপারিশকারী"],["وَكَانُوا۟","wakānū","and they will be","এবং তারা হবে"],["بِشُرَكَآئِهِمْ","bishurakāihim","in their partners","প্রতি শরিকদের তাদের(বানানো)"],["كَـٰفِرِينَ","kāfirīna","disbelievers","অস্বীকারকারী"]],"t":"وَلَمْ يَ<w>كُن لَّ</><y>هُم مِّ</><k>ن شُ</>رَ<o>كَآ</>ئِهِمْ شُفَ<o>عَٰٓ</>ؤُ<s>ا۟</> وَكَانُو<s>ا۟</> بِشُرَ<o>كَآ</>ئِهِمْ <m>كَٰ</>فِ<p>رِي</>نَ"},{"n":14,"w":[["وَيَوْمَ","wayawma","And (the) Day","এবং যেদিন"],["تَقُومُ","taqūmu","will (be) established","সংঘটিত হবে"],["ٱلسَّاعَةُ","l-sā‘atu","the Hour","ক্বিয়ামাত"],["يَوْمَئِذٍۢ","yawma-idhin","that Day","সেদিন"],["يَتَفَرَّقُونَ","yatafarraqūna","they will become separated","তারা বিভক্ত হয়ে যাবে"]],"t":"وَيَوْمَ تَقُومُ <h>ٱ</><l>ل</>سَّاعَةُ يَوْمَئِ<d>ذٍۢ يَ</>تَفَرَّ<p>قُو</>نَ"},{"n":15,"w":[["فَأَمَّا","fa-ammā","Then as for","অতঃপর (তাদের) ব্যাপার"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ءَامَنُوا۟","āmanū","believed","ঈমান এনেছে"],["وَعَمِلُوا۟","wa‘amilū","and did","ও কাজ করেছে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","righteous deeds","সৎ"],["فَهُمْ","fahum","so they","তখন তারা"],["فِى","fī","in","(হবে) মধ্যে"],["رَوْضَةٍۢ","rawḍatin","a Garden","বাগানের"],["يُحْبَرُونَ","yuḥ'barūna","will be delighted","আনন্দ করবে"]],"t":"فَأَ<g>مَّ</>ا <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ فَهُمْ فِى رَوْضَ<d>ةٍۢ يُ</>حْبَ<p>رُو</>نَ"},{"n":16,"w":[["وَأَمَّا","wa-ammā","But as for","আর (তাদের) ব্যাপার"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieved","অস্বীকার করেছে"],["وَكَذَّبُوا۟","wakadhabū","and denied","ও মিথ্যারোপ করেছে"],["بِـَٔايَـٰتِنَا","biāyātinā","Our Signs","প্রতি নিদর্শনাবলীর আমাদের"],["وَلِقَآئِ","waliqāi","and (the) meeting","ও সাক্ষাতকে"],["ٱلْـَٔاخِرَةِ","l-ākhirati","(of) the Hereafter","পরকালের"],["فَأُو۟لَـٰٓئِكَ","fa-ulāika","then those","তখন ঐসব (লোককে)"],["فِى","fī","in","মধ্যে"],["ٱلْعَذَابِ","l-‘adhābi","the punishment","শাস্তির"],["مُحْضَرُونَ","muḥ'ḍarūna","(will be) brought forth","উপস্থিত করা হবে"]],"t":"وَأَ<g>مَّ</>ا <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> وَكَذَّبُو<s>ا۟</> بِـَٔا<m>يَٰ</>تِنَا وَلِقَآئِ <h>ٱ</>لْءَاخِرَةِ فَأُ<s>و۟</><o>لَٰٓ</>ئِكَ فِى <h>ٱ</>لْعَذَابِ مُحْضَ<p>رُو</>نَ"},{"n":17,"w":[["فَسُبْحَـٰنَ","fasub'ḥāna","So glory be to","অতএব মহিমা ঘোষণা করো"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["حِينَ","ḥīna","when","যখন"],["تُمْسُونَ","tum'sūna","you reach the evening","তোমরা সন্ধ্যা করো(অর্থাৎ মাগরিব হয়)"],["وَحِينَ","waḥīna","and when","ও যখন"],["تُصْبِحُونَ","tuṣ'biḥūna","you reach the morning","তোমরা সকাল করো (অর্থাৎ ফজর হয়)"]],"t":"فَسُ<q>بْ</><m>حَٰ</>نَ <h>ٱ</>للَّهِ حِينَ تُمْسُونَ وَحِينَ تُصْبِ<p>حُو</>نَ"},{"n":18,"w":[["وَلَهُ","walahu","And for Him","এবং জন্যে  তাঁরই"],["ٱلْحَمْدُ","l-ḥamdu","(are) all praises","সকল প্রশংসা"],["فِى","fī","in","মধ্যে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশ মন্ডলীর"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীতে"],["وَعَشِيًّۭا","wa‘ashiyyan","and (at) night","এবং (মহিমা ঘোষণা করো) বিকেলে  (অর্থাৎ আসরে)"],["وَحِينَ","waḥīna","and when","ও যখন"],["تُظْهِرُونَ","tuẓ'hirūna","you are at noon","তোমরা দুপুরে উপনীত হও"]],"t":"وَلَهُ <h>ٱ</>لْحَمْدُ فِى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ وَعَشِ<d>يًّۭا وَ</>حِينَ تُظْهِ<p>رُو</>نَ"},{"n":19,"w":[["يُخْرِجُ","yukh'riju","He brings forth","তিনি বের করেন"],["ٱلْحَىَّ","l-ḥaya","the living","জীবন্তকে"],["مِنَ","mina","from","হ'তে"],["ٱلْمَيِّتِ","l-mayiti","the dead","মৃত"],["وَيُخْرِجُ","wayukh'riju","and He brings forth","ও তিনি বের করেন"],["ٱلْمَيِّتَ","l-mayita","the dead","মৃতকে"],["مِنَ","mina","from","হ'তে"],["ٱلْحَىِّ","l-ḥayi","the living","জীবন্ত"],["وَيُحْىِ","wayuḥ'yī","and He gives life","এবং জীবিত করেন"],["ٱلْأَرْضَ","l-arḍa","(to) the earth","পৃথিবীকে"],["بَعْدَ","ba‘da","after","পরে"],["مَوْتِهَا ۚ","mawtihā","its death","মৃত্যুর তার"],["وَكَذَٰلِكَ","wakadhālika","and thus","এবং এরূপেই"],["تُخْرَجُونَ","tukh'rajūna","you will be brought forth","তোমাদের বের করা হবে"]],"t":"يُخْرِجُ <h>ٱ</>لْحَىَّ مِنَ <h>ٱ</>لْمَيِّتِ وَيُخْرِجُ <h>ٱ</>لْمَيِّتَ مِنَ <h>ٱ</>لْحَىِّ وَيُحْىِ <h>ٱ</>لْأَرْضَ بَعْدَ مَوْتِهَا ۚ وَكَ<m>ذَٰ</>لِكَ تُخْرَ<p>جُو</>نَ"},{"n":20,"w":[["وَمِنْ","wamin","And among","এবং মধ্যে (রয়েছে)"],["ءَايَـٰتِهِۦٓ","āyātihi","His Signs","নিদর্শনাবলীর তাঁর"],["أَنْ","an","(is) that","(এও) যে"],["خَلَقَكُم","khalaqakum","He created you","তিনি সৃষ্টি করেছেন তোমাদেরকে"],["مِّن","min","from","হ'তে"],["تُرَابٍۢ","turābin","dust","মাটি"],["ثُمَّ","thumma","then","এরপর"],["إِذَآ","idhā","behold","এখন"],["أَنتُم","antum","You","তোমরা"],["بَشَرٌۭ","basharun","(are) human beings","মানুষ (হিসেবে)"],["تَنتَشِرُونَ","tantashirūna","dispersing","তোমরা ছড়িয়ে পড়ছো"]],"t":"وَمِنْ ءَا<m>يَٰ</>تِ<o>هِۦٓ</> أَنْ خَلَقَ<y>كُم مِّ</><k>ن تُ</>رَا<k>بٍۢ ثُ</><g>مَّ</> إِ<o>ذَآ</> أَ<k>نتُ</><f>م بَ</>شَ<k>رٌۭ تَنتَ</>شِ<p>رُو</>نَ"},{"n":21,"w":[["وَمِنْ","wamin","And among","এবং মধ্য হ'তে"],["ءَايَـٰتِهِۦٓ","āyātihi","His Signs","নিদর্শনাবলীর তাঁর"],["أَنْ","an","(is) that","এও (যে)"],["خَلَقَ","khalaqa","He created","তিনি সৃষ্টি করেছেন"],["لَكُم","lakum","for you","জন্যে তোমাদের"],["مِّنْ","min","from","মধ্যে হ'তে"],["أَنفُسِكُمْ","anfusikum","yourselves","তোমাদের নিজেদের"],["أَزْوَٰجًۭا","azwājan","mates","স্ত্রীদেরকে"],["لِّتَسْكُنُوٓا۟","litaskunū","that you may find tranquility","যেন তোমরা প্রশান্তি পাও"],["إِلَيْهَا","ilayhā","in them","কাছে তাদের"],["وَجَعَلَ","waja‘ala","and He placed","এবং সৃষ্টি করেছেন"],["بَيْنَكُم","baynakum","between you","মাঝে তোমাদের"],["مَّوَدَّةًۭ","mawaddatan","love","সম্প্রীতি"],["وَرَحْمَةً ۚ","waraḥmatan","and mercy","ও দয়া"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে (রয়েছে)"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَـٰتٍۢ","laāyātin","surely (are) Signs","অবশ্যই নির্দেশনাবলী"],["لِّقَوْمٍۢ","liqawmin","for a people","জন্যে সম্প্রদায়ের"],["يَتَفَكَّرُونَ","yatafakkarūna","who reflect","(যারা ) চিন্তা ভাবনা করে"]],"t":"وَمِنْ ءَا<m>يَٰ</>تِ<o>هِۦٓ</> أَنْ خَلَقَ لَ<y>كُم مِّ</>نْ أَ<k>نفُ</>سِكُمْ أَزْ<m>وَٰ</><w>جًۭا لِّ</>تَسْكُ<o>نُوٓ</><s>ا۟</> إِلَيْهَا وَجَعَلَ بَيْنَ<y>كُم مَّ</>وَدَّ<d>ةًۭ وَ</>رَحْمَةً ۚ إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَا<m>يَٰ</><w>تٍۢ لِّ</>قَوْ<d>مٍۢ يَ</>تَفَكَّ<p>رُو</>نَ"},{"n":22,"w":[["وَمِنْ","wamin","And among","এবং মধ্যে হ'তে"],["ءَايَـٰتِهِۦ","āyātihi","His Signs","নিদর্শনাবলীর তাঁর"],["خَلْقُ","khalqu","(is the) creation","সৃষ্টি"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশমন্ডলীর"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীর"],["وَٱخْتِلَـٰفُ","wa-ikh'tilāfu","and the diversity","এবং বৈচিত্র্য"],["أَلْسِنَتِكُمْ","alsinatikum","(of) your languages","ভাষাসমূহের তোমাদের"],["وَأَلْوَٰنِكُمْ ۚ","wa-alwānikum","and your colors","ও বর্ণসমূহের তোমাদের"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে (রয়েছে)"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَـٰتٍۢ","laāyātin","surely (are) Signs","অবশ্যই নিদর্শনাবলী"],["لِّلْعَـٰلِمِينَ","lil'‘ālimīna","for those of knowledge","জন্যে জ্ঞানীদের"]],"t":"وَمِنْ ءَا<m>يَٰتِهِۦ</> خَلْقُ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ وَ<h>ٱ</>خْتِ<m>لَٰ</>فُ أَلْسِنَتِكُمْ وَأَلْ<m>وَٰ</>نِكُمْ ۚ إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَا<m>يَٰ</><w>تٍۢ لِّ</>لْ<m>عَٰ</>لِ<p>مِي</>نَ"},{"n":23,"w":[["وَمِنْ","wamin","And among","এবং মধ্যে হ'তে"],["ءَايَـٰتِهِۦ","āyātihi","His Signs","নিদর্শনাবলীর তাঁর"],["مَنَامُكُم","manāmukum","(is) your sleep","ঘুম তোমাদের"],["بِٱلَّيْلِ","bi-al-layli","by night","বেলায় রাতের"],["وَٱلنَّهَارِ","wal-nahāri","and the day","ও দিনে"],["وَٱبْتِغَآؤُكُم","wa-ib'tighāukum","[and] your seeking","এবং অনুসন্ধান করা তোমাদের"],["مِّن","min","of","মধ্য হ'তে"],["فَضْلِهِۦٓ ۚ","faḍlihi","His Bounty","অনুগ্রহের তাঁর"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে (রয়েছে)"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَـٰتٍۢ","laāyātin","surely (are) Signs","অবশ্যই নিদর্শনাবলী"],["لِّقَوْمٍۢ","liqawmin","for a people","জন্যে সম্প্রদায়ের"],["يَسْمَعُونَ","yasma‘ūna","who listen","যারা (শুনে)"]],"t":"وَمِنْ ءَا<m>يَٰتِهِۦ</> مَنَامُ<f>كُم بِ</><h>ٱ</>لَّيْلِ وَ<h>ٱ</><l>ل</><g>نَّ</>هَارِ وَ<h>ٱ</><q>بْ</>تِ<o>غَآ</>ؤُ<y>كُم مِّ</><k>ن فَ</>ضْلِ<o>هِۦٓ ۚ</> إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَا<m>يَٰ</><w>تٍۢ لِّ</>قَوْ<d>مٍۢ يَ</>سْمَ<p>عُو</>نَ"},{"n":24,"w":[["وَمِنْ","wamin","And among","এবং মধ্য হ'তে"],["ءَايَـٰتِهِۦ","āyātihi","His Signs","নিদর্শনাবলীর তাঁর"],["يُرِيكُمُ","yurīkumu","He shows you","তিনি দেখান তোমাদের"],["ٱلْبَرْقَ","l-barqa","the lightning","বিদ্যুৎ"],["خَوْفًۭا","khawfan","(causing) fear","ভয় হিসেবে"],["وَطَمَعًۭا","waṭama‘an","and hope","ও আশারূপে"],["وَيُنَزِّلُ","wayunazzilu","and He sends down","এবং বর্ষণ করেন"],["مِنَ","mina","from","হ'তে"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশ"],["مَآءًۭ","māan","water","পানি"],["فَيُحْىِۦ","fayuḥ'yī","and gives life","অতঃপর জীবিত করেন"],["بِهِ","bihi","therewith","দিয়ে তা"],["ٱلْأَرْضَ","l-arḍa","(to) the earth","জমিনকে"],["بَعْدَ","ba‘da","after","পরে"],["مَوْتِهَآ ۚ","mawtihā","its death","মৃত্যুর তার"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে (রয়েছে)"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَـٰتٍۢ","laāyātin","surely (are) Signs","অবশ্যই নিদর্শনাবলী"],["لِّقَوْمٍۢ","liqawmin","for a people","জন্যে সম্প্রদায়ের"],["يَعْقِلُونَ","ya‘qilūna","who use intellect","(যারা) জ্ঞান-বুদ্ধি রাখে"]],"t":"وَمِنْ ءَا<m>يَٰتِهِۦ</> يُرِيكُمُ <h>ٱ</>لْبَرْقَ خَوْ<d>فًۭا وَ</>طَمَ<d>عًۭا وَ</>يُنَزِّلُ مِنَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ <o>مَآ</><k>ءًۭ فَ</>يُحْ<m>ىِۦ</> بِهِ <h>ٱ</>لْأَرْضَ بَعْدَ مَوْتِ<o>هَآ ۚ</> إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَا<m>يَٰ</><w>تٍۢ لِّ</>قَوْ<d>مٍۢ يَ</>عْقِ<p>لُو</>نَ"},{"n":25,"w":[["وَمِنْ","wamin","And among","এবং মধ্যে হ'তে"],["ءَايَـٰتِهِۦٓ","āyātihi","His Signs","নিদর্শনসমূহের তাঁর"],["أَن","an","(is) that","(এও) যে"],["تَقُومَ","taqūma","stands","প্রতিষ্ঠিত  রয়েছে"],["ٱلسَّمَآءُ","l-samāu","the heavens","আকাশ"],["وَٱلْأَرْضُ","wal-arḍu","and the earth","ও পৃথিবী"],["بِأَمْرِهِۦ ۚ","bi-amrihi","by His Command","নির্দেশক্রমে তাঁরই"],["ثُمَّ","thumma","Then","এরপর"],["إِذَا","idhā","when","যখন"],["دَعَاكُمْ","da‘ākum","He calls you","তিনি ডাক দিবেন তোমাদের"],["دَعْوَةًۭ","da‘watan","(with) a call","একটি ডাক"],["مِّنَ","mina","from","হ'তে"],["ٱلْأَرْضِ","l-arḍi","the earth","জমিন"],["إِذَآ","idhā","behold","তখন"],["أَنتُمْ","antum","You","তোমরা"],["تَخْرُجُونَ","takhrujūna","will come forth","বের হয়ে আসবে"]],"t":"وَمِنْ ءَا<m>يَٰ</>تِ<o>هِۦٓ</> أَ<k>ن تَ</>قُومَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءُ وَ<h>ٱ</>لْأَرْضُ بِأَمْرِ<m>هِۦ</> ۚ ثُ<g>مَّ</> إِذَا دَعَاكُمْ دَعْوَ<d>ةًۭ مِّ</>نَ <h>ٱ</>لْأَرْضِ إِ<o>ذَآ</> أَ<k>نتُ</>مْ تَخْرُ<p>جُو</>نَ"},{"n":26,"w":[["وَلَهُۥ","walahu","And to Him (belongs)","এবং জন্যে তাঁরই"],["مَن","man","whoever","যা কিছু"],["فِى","fī","(is) in","মধ্যে (আছে)"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশমন্ডলীর"],["وَٱلْأَرْضِ ۖ","wal-arḍi","and the earth","ও পৃথিবীর"],["كُلٌّۭ","kullun","All","সবকিছু"],["لَّهُۥ","lahu","to Him","প্রতি তাঁরই"],["قَـٰنِتُونَ","qānitūna","(are) obedient","অনুগত"]],"t":"وَلَهُ<m>ۥ</> مَ<k>ن فِ</>ى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ ۖ كُ<w>لٌّ