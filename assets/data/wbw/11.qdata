"কোন"],["فَضْلٍۭ","faḍlin","merit","শ্রেষ্ঠত্ব"],["بَلْ","bal","nay","বরং"],["نَظُنُّكُمْ","naẓunnukum","we think you","তোমাদের আমরা মনে করি"],["كَـٰذِبِينَ","kādhibīna","(are) liars","মিথ্যাবাদী\""]],"t":"فَقَالَ <h>ٱ</>لْمَلَأُ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> مِ<k>ن قَ</>وْمِ<m>هِۦ</> مَا نَرَ<m>ىٰ</>كَ إِلَّا بَشَ<d>رًۭا مِّ</>ثْلَنَا وَمَا نَرَ<m>ىٰ</>كَ <h>ٱ</>تَّبَعَكَ إِلَّا <h>ٱ</>لَّذِينَ هُمْ أَرَاذِلُنَا بَادِىَ <h>ٱ</><l>ل</>رَّأْىِ وَمَا نَرَىٰ لَكُمْ عَلَيْنَا مِ<k>ن فَ</>ضْ<i>لٍۭ بَ</>لْ نَظُ<g>نُّ</>كُمْ <m>كَٰ</>ذِ<p>بِي</>نَ"},{"n":28,"w":[["قَالَ","qāla","He said","সে বললো"],["يَـٰقَوْمِ","yāqawmi","O my people","\"হে আমার সম্প্রদায়"],["أَرَءَيْتُمْ","ara-aytum","Do you see","তোমরা কি (ভেবে) দেখেছো"],["إِن","in","if","যদি"],["كُنتُ","kuntu","I was","আমি হই (প্রতিষ্ঠিত)"],["عَلَىٰ","‘alā","on","উপর"],["بَيِّنَةٍۢ","bayyinatin","(the) clear proof","সুস্পষ্ট নির্দশনের"],["مِّن","min","from","পক্ষ থেকে"],["رَّبِّى","rabbī","my Lord","আমার রবের"],["وَءَاتَىٰنِى","waātānī","while He has given me","ও আমাকে দিয়ে থাকেন"],["رَحْمَةًۭ","raḥmatan","mercy","অনুগ্রহ"],["مِّنْ","min","from","হতে"],["عِندِهِۦ","‘indihi","Himself","তাঁর নিকট"],["فَعُمِّيَتْ","fa‘ummiyat","but (it) has been obscured","অথচ তা গোপন রাখা হয়েছে"],["عَلَيْكُمْ","‘alaykum","from you","কাছে তোমাদের"],["أَنُلْزِمُكُمُوهَا","anul'zimukumūhā","should We compel you (to accept) it","তা তোমাদের আমরা কি বাধ্য করতে পারি"],["وَأَنتُمْ","wa-antum","while you (are)","যখন তোমরা"],["لَهَا","lahā","averse to it","তা"],["كَـٰرِهُونَ","kārihūna","averse to it","অপছন্দ করছো"]],"t":"قَالَ <m>يَٰ</>قَوْمِ أَرَءَيْتُمْ إِ<k>ن كُنتُ</> عَلَىٰ بَيِّنَ<d>ةٍۢ مِّ</><w>ن رَّ</>بِّى وَءَاتَ<m>ىٰ</>نِى رَحْمَ<d>ةًۭ مِّ</>نْ عِ<k>ندِ</><m>هِۦ</> فَعُ<g>مِّ</>يَتْ عَلَيْكُمْ أَنُلْزِمُكُمُوهَا وَأَ<k>نتُ</>مْ لَهَا <m>كَٰ</>رِ<p>هُو</>نَ"},{"n":29,"w":[["وَيَـٰقَوْمِ","wayāqawmi","And O my people","এবং হে আমার সম্প্রদায়"],["لَآ","lā","not","না"],["أَسْـَٔلُكُمْ","asalukum","I ask (of) you","তোমাদের কাছে আমি চাই"],["عَلَيْهِ","‘alayhi","for it","এর বিনিময়ে"],["مَالًا ۖ","mālan","any wealth","কোন ধন-সম্পদ"],["إِنْ","in","Not","নয়"],["أَجْرِىَ","ajriya","(is) my reward","আমার পারিশ্রমিক"],["إِلَّا","illā","except","এছাড়া"],["عَلَى","‘alā","from","কাছে"],["ٱللَّهِ ۚ","l-lahi","Allah","আল্লাহর"],["وَمَآ","wamā","And not","এবং নই"],["أَنَا۠","anā","I am","আমি"],["بِطَارِدِ","biṭāridi","going to drive away","বিতাড়নকারী"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["ءَامَنُوٓا۟ ۚ","āmanū","believed","ঈমান এনেছে"],["إِنَّهُم","innahum","Indeed, they","তারা নিশ্চয়ই"],["مُّلَـٰقُوا۟","mulāqū","(will) be meeting","সাক্ষাত করবে"],["رَبِّهِمْ","rabbihim","their Lord","তাদের রবের"],["وَلَـٰكِنِّىٓ","walākinnī","but I","কিন্তু আমি"],["أَرَىٰكُمْ","arākum","see you","তোমাদেরকে দেখছি"],["قَوْمًۭا","qawman","(are) a people","(এমন) সম্প্রদায়"],["تَجْهَلُونَ","tajhalūna","ignorant","(যারা তোমরা) মূর্খতা করছো"]],"t":"وَ<m>يَٰ</>قَوْمِ <o>لَآ</> أَسْـَٔلُكُمْ عَلَيْهِ مَالًا ۖ إِنْ أَ<q>جْ</>رِىَ إِلَّا عَلَى <h>ٱ</>للَّهِ ۚ وَ<o>مَآ</> أَنَا۠ بِطَارِدِ <h>ٱ</>لَّذِينَ ءَامَ<o>نُوٓ</><s>ا۟</> ۚ إِ<g>نَّ</><y>هُم مُّ</><m>لَٰ</>قُو<s>ا۟</> رَبِّهِمْ وَ<m>لَٰ</>كِ<g>نِّ</><o>ىٓ</> أَرَ<m>ىٰ</>كُمْ قَوْ<k>مًۭا تَ</><q>جْ</>هَ<p>لُو</>نَ"},{"n":30,"w":[["وَيَـٰقَوْمِ","wayāqawmi","And O my people","আর হে আমার সম্প্রদায়"],["مَن","man","Who","কে"],["يَنصُرُنِى","yanṣurunī","would help me","সাহায্য করবে আমাকে"],["مِنَ","mina","against","থেকে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["إِن","in","if","যদি"],["طَرَدتُّهُمْ ۚ","ṭaradttuhum","I drove them away","তাদেরকে আমি তাড়িয়ে দিই"],["أَفَلَا","afalā","Then, will not","তবে কি না"],["تَذَكَّرُونَ","tadhakkarūna","you take heed","তোমরা শিক্ষা গ্রহণ করবে"]],"t":"وَ<m>يَٰ</>قَوْمِ <d>مَن يَ</><k>نصُ</>رُنِى مِنَ <h>ٱ</>للَّهِ إِ<k>ن طَ</>رَ<j>د</>تُّهُمْ ۚ أَفَلَا تَذَكَّ<p>رُو</>نَ"},{"n":31,"w":[["وَلَآ","walā","And not","এবং না"],["أَقُولُ","aqūlu","I say","আমি বলছি"],["لَكُمْ","lakum","to you","তোমাদেরকে (এ কথা যে)"],["عِندِى","‘indī","(that) with me","আমার কাছে (আছে)"],["خَزَآئِنُ","khazāinu","(are the) treasures","ধনভান্ডার"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَلَآ","walā","and not","এবং না"],["أَعْلَمُ","a‘lamu","I know","আমি জানি"],["ٱلْغَيْبَ","l-ghayba","the unseen","অদৃশ্য (সম্বন্ধে)"],["وَلَآ","walā","and not","এবং না"],["أَقُولُ","aqūlu","I say","আমি বলছি (এ কথা যে)"],["إِنِّى","innī","that I am","নিশ্চয়ই আমি"],["مَلَكٌۭ","malakun","an Angel","ফেরেশতা"],["وَلَآ","walā","and not","এবং না"],["أَقُولُ","aqūlu","I say","আমি বলছি"],["لِلَّذِينَ","lilladhīna","for those whom","যাদেরকে"],["تَزْدَرِىٓ","tazdarī","look down upon","নিতান্ত হীন মনে করে"],["أَعْيُنُكُمْ","a‘yunukum","your eyes","তোমাদের চোখগুলো"],["لَن","lan","never","কখনও না"],["يُؤْتِيَهُمُ","yu'tiyahumu","will Allah give them","তাদের দিবেন"],["ٱللَّهُ","l-lahu","will Allah give them","আল্লাহ"],["خَيْرًا ۖ","khayran","any good","কোন কল্যাণ"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["أَعْلَمُ","a‘lamu","knows best","সম্যক অবগত"],["بِمَا","bimā","what","ঐ বিষয়ে যা"],["فِىٓ","fī","(is) in","মধ্যে আছে"],["أَنفُسِهِمْ  ۖ","anfusihim","their souls","তাদের মনের"],["إِنِّىٓ","innī","Indeed, I","(এমন বললে) আমি নিশ্চয়ই"],["إِذًۭا","idhan","then","তখন"],["لَّمِنَ","lamina","(will be) surely of","অবশ্যই অন্তর্ভুক্ত হবো"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","সীমালঙ্ঘনকারীদের\""]],"t":"وَ<o>لَآ</> أَقُولُ لَكُمْ عِ<k>ندِ</>ى خَ<o>زَآ</>ئِنُ <h>ٱ</>للَّهِ وَ<o>لَآ</> أَعْلَمُ <h>ٱ</>لْغَيْبَ وَ<o>لَآ</> أَقُولُ إِ<g>نِّ</>ى مَلَ<d>كٌۭ وَ</><o>لَآ</> أَقُولُ لِلَّذِينَ تَزْدَ<o>رِىٓ</> أَعْيُنُكُمْ <d>لَن يُ</>ؤْتِيَهُمُ <h>ٱ</>للَّهُ خَيْرًا ۖ <h>ٱ</>للَّهُ أَعْلَمُ بِمَا <o>فِىٓ</> أَ<k>نفُ</>سِهِمْ ۖ إِ<g>نِّ</><o>ىٓ</> إِ<w>ذًۭا لَّ</>مِنَ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":32,"w":[["قَالُوا۟","qālū","They said","(শেষ পর্যন্ত) তারা বললো"],["يَـٰنُوحُ","yānūḥu","O Nuh","\"হে নূহ"],["قَدْ","qad","Indeed","নিশ্চয়ই"],["جَـٰدَلْتَنَا","jādaltanā","you disputed with us","আমাদের সাথে তুমি তর্ক করেছো"],["فَأَكْثَرْتَ","fa-aktharta","and you (have been) frequent","অতঃপর করেছো তুমি বড় বেশী"],["جِدَٰلَنَا","jidālanā","(in) dispute with us","আমাদের সাথে তর্ক"],["فَأْتِنَا","fatinā","So bring us","অতএব আস আমাদের কাছে"],["بِمَا","bimā","what","নিয়ে ঐ বিষয় যার"],["تَعِدُنَآ","ta‘idunā","you threaten us (with)","আমাদেরকে ভয় দেখাচ্ছো"],["إِن","in","if","যদি"],["كُنتَ","kunta","you are","তুমি হও"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلصَّـٰدِقِينَ","l-ṣādiqīna","the truthful","সত্যবাদীদের\""]],"t":"قَالُو<s>ا۟</> <m>يَٰ</>نُوحُ قَ<q>دْ</> <m>جَٰ</>دَلْتَنَا فَأَكْثَرْتَ جِ<m>دَٰ</>لَنَا فَأْتِنَا بِمَا تَعِدُ<o>نَآ</> إِ<k>ن كُنتَ</> مِنَ <h>ٱ</><l>ل</><m>صَّٰ</>دِ<p>قِي</>نَ"},{"n":33,"w":[["قَالَ","qāla","He said","সে বললো"],["إِنَّمَا","innamā","Only","\"প্রকৃতপক্ষে"],["يَأْتِيكُم","yatīkum","will bring it (on) you","তোমাদের কাছে আসবেন"],["بِهِ","bihi","will bring it (on) you","নিয়ে তা"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["إِن","in","if","যদি"],["شَآءَ","shāa","He wills","তিনি ইচ্ছে করেন"],["وَمَآ","wamā","and not","এবং নও"],["أَنتُم","antum","you (are)","তোমরা"],["بِمُعْجِزِينَ","bimu‘'jizīna","one who (can) escape (it)","ব্যর্থ করতে সক্ষম (আল্লাহকে)"]],"t":"قَالَ إِ<g>نَّ</>مَا يَأْتِي<f>كُم بِ</>هِ <h>ٱ</>للَّهُ إِ<k>ن شَ</><o>آ</>ءَ وَ<o>مَآ</> أَ<k>نتُ</><f>م بِ</>مُعْجِ<p>زِي</>نَ"},{"n":34,"w":[["وَلَا","walā","And (will) not","এবং না"],["يَنفَعُكُمْ","yanfa‘ukum","benefit you","তোমাদের উপকার দিবে"],["نُصْحِىٓ","nuṣ'ḥī","my advice","আমার সদুপদেশ"],["إِنْ","in","(even) if","যদি"],["أَرَدتُّ","aradttu","I wish","আমি চাইও"],["أَنْ","an","to","যে"],["أَنصَحَ","anṣaḥa","[I] advise","সদুপদেশ দিবো আমি"],["لَكُمْ","lakum","[to] you","তোমাদের জন্যে"],["إِن","in","if","যদি"],["كَانَ","kāna","it was Allah's","(এমন) হয়"],["ٱللَّهُ","l-lahu","it was Allah's","আল্লাহ"],["يُرِيدُ","yurīdu","will","চান"],["أَن","an","to","যে"],["يُغْوِيَكُمْ ۚ","yugh'wiyakum","let you go astray","তোমাদের বিভ্রান্ত করতে"],["هُوَ","huwa","He (is)","তিনিই"],["رَبُّكُمْ","rabbukum","your Lord","তোমাদের রব"],["وَإِلَيْهِ","wa-ilayhi","and to Him","এবং তাঁরই দিকে"],["تُرْجَعُونَ","tur'ja‘ūna","you will be returned","প্রত্যাবর্তিত হবে তোমরা\""]],"t":"وَلَا يَ<k>نفَ</>عُكُمْ نُصْ<o>حِىٓ</> إِنْ أَرَ<j>د</>تُّ أَنْ أَ<k>نصَ</>حَ لَكُمْ إِ<k>ن كَ</>انَ <h>ٱ</>للَّهُ يُرِيدُ <d>أَن يُ</>غْوِيَكُمْ ۚ هُوَ رَبُّكُمْ وَإِلَيْهِ تُرْجَ<p>عُو</>نَ"},{"n":35,"w":[["أَمْ","am","Or","অথবা কি"],["يَقُولُونَ","yaqūlūna","(do) they say","তারা বলে"],["ٱفْتَرَىٰهُ ۖ","if'tarāhu","He has invented it","\"তা সে রচনা করেছে\""],["قُلْ","qul","Say","(হে নাবী) বলো"],["إِنِ","ini","If","\"যদি"],["ٱفْتَرَيْتُهُۥ","if'taraytuhu","I have invented it","তা আমি রচনা করে থাকি"],["فَعَلَىَّ","fa‘alayya","then on me","তবে আমার উপর"],["إِجْرَامِى","ij'rāmī","(is) my crime","আমার অপরাধ"],["وَأَنَا۠","wa-anā","but I am","এবং আমি"],["بَرِىٓءٌۭ","barīon","innocent","দায়মুক্ত"],["مِّمَّا","mimmā","of what","তা হ'তে যা"],["تُجْرِمُونَ","tuj'rimūna","crimes you commit","তোমরা অপরাধ করছো\""]],"t":"أَمْ يَقُولُونَ <h>ٱ</>فْتَرَ<m>ىٰ</>هُ ۖ قُلْ إِنِ <h>ٱ</>فْتَرَيْتُهُ<m>ۥ</> فَعَلَىَّ إِ<q>جْ</>رَامِى وَأَنَا۠ بَ<o>رِىٓ</><d>ءٌۭ مِّ</><g>مَّ</>ا تُ<q>جْ</>رِ<p>مُو</>نَ"},{"n":36,"w":[["وَأُوحِىَ","waūḥiya","And it was revealed","এবং ওহী করা হলো"],["إِلَىٰ","ilā","to","প্রতি"],["نُوحٍ","nūḥin","Nuh","নূহের"],["أَنَّهُۥ","annahu","That","\"যে"],["لَن","lan","will never","কখনও না"],["يُؤْمِنَ","yu'mina","believe","কেউ ঈমান আনবে"],["مِن","min","from","মধ্য হ'তে"],["قَوْمِكَ","qawmika","your people","তোমার জাতির"],["إِلَّا","illā","except","এ ছাড়া"],["مَن","man","(those) who","যে"],["قَدْ","qad","have already","নিশ্চয়ই"],["ءَامَنَ","āmana","believed","ঈমান এনেছে"],["فَلَا","falā","So (do) not","অতএব না"],["تَبْتَئِسْ","tabta-is","(be) distressed","তুমি বিমর্ষ হয়ো"],["بِمَا","bimā","by what","ঐ বিষয়ে যা"],["كَانُوا۟","kānū","they have been","তারা ছিলো"],["يَفْعَلُونَ","yaf‘alūna","doing","তারা করে যাচ্ছে"]],"t":"وَأُوحِىَ إِلَىٰ نُوحٍ أَ<g>نَّ</>هُ<m>ۥ</> <d>لَن يُ</>ؤْمِنَ مِ<k>ن قَ</>وْمِكَ إِلَّا مَ<k>ن قَ</><q>دْ</> ءَامَنَ فَلَا تَ<q>بْ</>تَئِسْ بِمَا كَانُو<s>ا۟</> يَفْعَ<p>لُو</>نَ"},{"n":37,"w":[["وَٱصْنَعِ","wa-iṣ'na‘i","And construct","এবং নির্মাণ করো"],["ٱلْفُلْكَ","l-ful'ka","the ship","একটি নৌযান"],["بِأَعْيُنِنَا","bi-a‘yuninā","under Our Eyes","আমাদের পর্যবেক্ষণে"],["وَوَحْيِنَا","wawaḥyinā","and Our inspiration","ও আমাদের ওহী অনুসারে"],["وَلَا","walā","and (do) not","এবং না"],["تُخَـٰطِبْنِى","tukhāṭib'nī","address Me","আমাকে কিছু বলবে"],["فِى","fī","concerning","ব্যাপারে"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["ظَلَمُوٓا۟ ۚ","ẓalamū","wronged","সীমালঙ্ঘন করেছে"],["إِنَّهُم","innahum","indeed, they (are)","নিশ্চয়ই তারা"],["مُّغْرَقُونَ","mugh'raqūna","the ones (to be) drowned","ডুবে যাবে\""]],"t":"وَ<h>ٱ</>صْنَعِ <h>ٱ</>لْفُلْكَ بِأَعْيُنِنَا وَوَحْيِنَا وَلَا تُ<m>خَٰ</>طِ<q>بْ</>نِى فِى <h>ٱ</>لَّذِينَ ظَلَ<o>مُوٓ</><s>ا۟</> ۚ إِ<g>نَّ</><y>هُم مُّ</>غْرَ<p>قُو</>نَ"},{"n":38,"w":[["وَيَصْنَعُ","wayaṣna‘u","And he was constructing","এবং সে নির্মাণ করতে লাগলো"],["ٱلْفُلْكَ","l-ful'ka","the ship","একটি নৌযান"],["وَكُلَّمَا","wakullamā","and every time","এবং যখনই"],["مَرَّ","marra","passed","অতিক্রম করতো"],["عَلَيْهِ","‘alayhi","by him","তার পাশ দিয়ে"],["مَلَأٌۭ","mala-on","(the) chiefs","প্রধানেরা"],["مِّن","min","of","মধ্যকার"],["قَوْمِهِۦ","qawmihi","his people","তার জাতির"],["سَخِرُوا۟","sakhirū","they ridiculed","ঠাট্টা করতো"],["مِنْهُ ۚ","min'hu","[of] him","তার সাথে"],["قَالَ","qāla","He said","সে বলতো"],["إِن","in","If","\"যদি"],["تَسْخَرُوا۟","taskharū","you ridicule","তোমরা ঠাট্টা করো"],["مِنَّا","minnā","us","আমাদেরকে"],["فَإِنَّا","fa-innā","then we","তবে নিশ্চয়ই আমরাও"],["نَسْخَرُ","naskharu","can ridicule","আমরা ঠাট্টা করবো"],["مِنكُمْ","minkum","you","তোমাদেরকে"],["كَمَا","kamā","as","যেমন"],["تَسْخَرُونَ","taskharūna","you ridicule","ঠাট্টা করছো তোমরা"]],"t":"وَيَصْنَعُ <h>ٱ</>لْفُلْكَ وَكُلَّمَا مَرَّ عَلَيْهِ مَلَ<d>أٌۭ مِّ</><k>ن قَ</>وْمِ<m>هِۦ</> سَخِرُو<s>ا۟</> مِنْهُ ۚ قَالَ إِ<k>ن تَ</>سْخَرُو<s>ا۟</> مِ<g>نَّ</>ا فَإِ<g>نَّ</>ا نَسْخَرُ مِ<k>نكُ</>مْ كَمَا تَسْخَ<p>رُو</>نَ"},{"n":39,"w":[["فَسَوْفَ","fasawfa","And soon","অতঃপর শীঘ্রই"],["تَعْلَمُونَ","ta‘lamūna","you will know","তোমরা জানবে"],["مَن","man","(on) whom","কে (সেই)"],["يَأْتِيهِ","yatīhi","will come","তার উপর আসবে"],["عَذَابٌۭ","‘adhābun","a punishment","শাস্তি"],["يُخْزِيهِ","yukh'zīhi","(that) will disgrace him","যা তাকে লাঞ্ছিত করবে"],["وَيَحِلُّ","wayaḥillu","and will descend","ও অবশ্যম্ভাবী"],["عَلَيْهِ","‘alayhi","on him","তার উপর"],["عَذَابٌۭ","‘adhābun","a punishment","শাস্তি"],["مُّقِيمٌ","muqīmun","lasting","স্থায়ী\""]],"t":"فَسَوْفَ تَعْلَمُونَ <d>مَن يَ</>أْتِيهِ عَذَا<d>بٌۭ يُ</>خْزِيهِ وَيَحِلُّ عَلَيْهِ عَذَا<d>بٌۭ مُّ</><p>قِي</>مٌ"},{"n":40,"w":[["حَتَّىٰٓ","ḥattā","Till","অবশেষে"],["إِذَا","idhā","when","যখন"],["جَآءَ","jāa","came","আসলো"],["أَمْرُنَا","amrunā","Our command","আমাদের নির্দেশ"],["وَفَارَ","wafāra","and overflowed","এবং উথলে উঠলো"],["ٱلتَّنُّورُ","l-tanūru","the oven","চুলা"],["قُلْنَا","qul'nā","We said","আমরা বললাম"],["ٱحْمِلْ","iḥ'mil","Load","\"তুলে নাও"],["فِيهَا","fīhā","in it","তার মধ্যে (নৌযানে)"],["مِن","min","of","থেকে"],["كُلٍّۢ","kullin","every kind","প্রত্যেক"],["زَوْجَيْنِ","zawjayni","a pair","প্রকারের (জীব-জন্তু)"],["ٱثْنَيْنِ","ith'nayni","two","দুইটি (অর্থাৎ নর ও নারী)"],["وَأَهْلَكَ","wa-ahlaka","and your family","এবং তোমার পরিবারকে"],["إِلَّا","illā","except","ছাড়া"],["مَن","man","who","যার (সম্পর্কে)"],["سَبَقَ","sabaqa","has preceded","পূর্বে হয়েছে"],["عَلَيْهِ","‘alayhi","against him","তার বিরুদ্ধে"],["ٱلْقَوْلُ","l-qawlu","the word","(হুঁশিয়ারী) সিদ্ধান্ত"],["وَمَنْ","waman","and whoever","এবং (তাদেরকে) যারা"],["ءَامَنَ ۚ","āmana","believed","ঈমান এনেছে\""],["وَمَآ","wamā","And not","এবং না"],["ءَامَنَ","āmana","believed","ঈমান এনেছিলো"],["مَعَهُۥٓ","ma‘ahu","with him","তার সাথে"],["إِلَّا","illā","except","ছাড়া"],["قَلِيلٌۭ","qalīlun","a few","অল্প সংখ্যক লোক"]],"t":"حَتَّ<o>ىٰٓ</> إِذَا <o>جَآ</>ءَ أَمْرُنَا وَفَارَ <h>ٱ</><l>ل</>تَّ<g>نُّ</>ورُ قُلْنَا <h>ٱ</>حْمِلْ فِيهَا مِ<k>ن كُلٍّۢ زَ</>وْجَيْنِ <h>ٱ</>ثْنَيْنِ وَأَهْلَكَ إِلَّا مَ<k>ن سَ</>بَقَ عَلَيْهِ <h>ٱ</>لْقَوْلُ وَمَنْ ءَامَنَ ۚ وَ<o>مَآ</> ءَامَنَ مَعَهُ<o>ۥٓ</> إِلَّا قَ<p>لِي</>لٌۭ"},{"n":41,"w":[["۞ وَقَالَ","waqāla","And he said","এবং (নূহ) বললো"],["ٱرْكَبُوا۟","ir'kabū","Embark","\"তোমরা আরোহণ করো"],["فِيهَا","fīhā","in it","তার মধ্যে"],["بِسْمِ","bis'mi","in the name","সহ নাম"],["ٱللَّهِ","l-lahi","of Allah","আল্লাহর"],["مَجْر۪ىٰهَا","majrahā","(is) its course","তার গতি"],["وَمُرْسَىٰهَآ ۚ","wamur'sāhā","and its anchorage","ও তার স্থিতি"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["رَبِّى","rabbī","my Lord","আমার রব"],["لَغَفُورٌۭ","laghafūrun","(is) certainly Oft-Forgiving","অবশ্যই ক্ষমাশীল"],["رَّحِيمٌۭ","raḥīmun","Most Merciful","পরম দয়ালু\""]],"t":"۞ وَقَالَ <h>ٱ</>رْكَبُو<s>ا۟</> فِيهَا بِسْمِ <h>ٱ</>للَّهِ مَ<q>جْ</>ر۪<m>ىٰ</>هَا وَمُرْسَ<m>ىٰ</><o>هَآ ۚ</> إِ<g>نَّ</> رَبِّى لَغَفُو<w>رٌۭ رَّ</><p>حِي</>مٌۭ"},{"n":42,"w":[["وَهِىَ","wahiya","And it","এবং তা"],["تَجْرِى","tajrī","sailed","বয়ে চলে"],["بِهِمْ","bihim","with them","তাদের নিয়ে"],["فِى","fī","on","মধ্যে"],["مَوْجٍۢ","mawjin","the waves","ঢেউয়ের"],["كَٱلْجِبَالِ","kal-jibāli","like mountains","পাহাড়ের মতো"],["وَنَادَىٰ","wanādā","and Nuh called out","এবং ডাকলো"],["نُوحٌ","nūḥun","and Nuh called out","নূহ"],["ٱبْنَهُۥ","ib'nahu","(to) his son","তাঁর ছেলেকে"],["وَكَانَ","wakāna","and he was","এবং সে ছিলো"],["فِى","fī","[in]","মধ্যে"],["مَعْزِلٍۢ","ma‘zilin","apart","দূরবর্তী স্থানের"],["يَـٰبُنَىَّ","yābunayya","O my son","\"হে আমার পুত্র"],["ٱرْكَب","ir'kab","Embark","আরোহণ করো"],["مَّعَنَا","ma‘anā","with us","আমাদের সাথে"],["وَلَا","walā","and (do) not","এবং না"],["تَكُن","takun","be","তুমি থেকো"],["مَّعَ","ma‘a","with","সাথে"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","the disbelievers","কাফিরদের\""]],"t":"وَهِىَ تَ<q>جْ</>رِى بِهِمْ فِى مَوْ<k>جٍۢ كَ</><h>ٱ</>لْجِبَالِ وَنَادَىٰ نُوحٌ <h>ٱ</><q>بْ</>نَهُ<m>ۥ</> وَكَانَ فِى مَعْزِ<d>لٍۢ يَٰ</>بُنَىَّ <h>ٱ</>رْكَ<j>ب</> <g>مَّ</>عَنَا وَلَا تَ<d>كُن مَّ</>عَ <h>ٱ</>لْ<m>كَٰ</>فِ<p>رِي</>نَ"},{"n":43,"w":[["قَالَ","qāla","He said","সে বললো"],["سَـَٔاوِىٓ","saāwī","I will betake myself","\"আমি শীঘ্রই আশ্রয় নিবো"],["إِلَىٰ","ilā","to","দিকে"],["جَبَلٍۢ","jabalin","a mountain","এমন এক পাহাড়ের"],["يَعْصِمُنِى","ya‘ṣimunī","(that) will save me","যা আমাকে রক্ষা করবে"],["مِنَ","mina","from","থেকে"],["ٱلْمَآءِ ۚ","l-māi","the water","প্লাবন\""],["قَالَ","qāla","He said","(নূহ) বললো"],["لَا","lā","(There is) no","\"নেই"],["عَاصِمَ","‘āṣima","protector","কোন রক্ষাকারী"],["ٱلْيَوْمَ","l-yawma","today","আজ"],["مِنْ","min","from","থেকে"],["أَمْرِ","amri","the Command of Allah","নির্দেশ"],["ٱللَّهِ","l-lahi","the Command of Allah","আল্লাহর"],["إِلَّا","illā","except","এ ছাড়া"],["مَن","man","(on) whom","যাকে"],["رَّحِمَ ۚ","raḥima","He has mercy","তিনি দয়া করবেন\""],["وَحَالَ","waḥāla","And came","এ সময়ে আড়াল হয়ে দাড়ালো"],["بَيْنَهُمَا","baynahumā","(in) between them","তাদে্র দু'জনের মাঝে"],["ٱلْمَوْجُ","l-mawju","the waves","ঢেউ"],["فَكَانَ","fakāna","so he was","অতঃপর সে হলো"],["مِنَ","mina","among","অন্তর্ভুক্ত"],["ٱلْمُغْرَقِينَ","l-mugh'raqīna","the drowned","নিমজ্জিতদের"]],"t":"قَالَ سَـَٔا<o>وِىٓ</> إِلَىٰ جَبَ<d>لٍۢ يَ</>عْصِمُنِى مِنَ <h>ٱ</>لْ<o>مَآ</>ءِ ۚ قَالَ لَا عَاصِمَ <h>ٱ</>لْيَوْمَ مِنْ أَمْرِ <h>ٱ</>للَّهِ إِلَّا <w>مَن رَّ</>حِمَ ۚ وَحَالَ بَيْنَهُمَا <h>ٱ</>لْمَوْجُ فَكَانَ مِنَ <h>ٱ</>لْمُغْرَ<p>قِي</>نَ"},{"n":44,"w":[["وَقِيلَ","waqīla","And it was said","এবং বলা হলো"],["يَـٰٓأَرْضُ","yāarḍu","O earth","\"হে পৃথিবী"],["ٱبْلَعِى","ib'la‘ī","Swallow","শুষে দাও"],["مَآءَكِ","māaki","your water","তোমার পানি"],["وَيَـٰسَمَآءُ","wayāsamāu","and O sky","এবং হে আকাশ"],["أَقْلِعِى","aqli‘ī","Withhold","ক্ষান্ত হও\""],["وَغِيضَ","waghīḍa","And subsided","এবং শুষে নেয়া হলো"],["ٱلْمَآءُ","l-māu","the water","পানি"],["وَقُضِىَ","waquḍiya","and was fulfilled","এবং শেষ হয়ে গেলো"],["ٱلْأَمْرُ","l-amru","the Command","(যা হওয়ার) বিষয়"],["وَٱسْتَوَتْ","wa-is'tawat","And it rested","এবং স্থির হলো (নৌযান)"],["عَلَى","‘alā","on","উপর"],["ٱلْجُودِىِّ ۖ","l-jūdiyi","the Judi","জুদী (পাহাড়ের)"],["وَقِيلَ","waqīla","And it was said","এবং বলা হলো"],["بُعْدًۭا","bu‘'dan","Away","\"দূর হোক (ধ্বংস আসুক)"],["لِّلْقَوْمِ","lil'qawmi","with the people","জাতির জন্যে"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","সীমালঙ্ঘনকারীদের\""]],"t":"وَقِيلَ <o>يَٰٓ</>أَرْضُ <h>ٱ</><q>بْ</>لَعِى <o>مَآ</>ءَكِ وَ<m>يَٰ</>سَ<o>مَآ</>ءُ أَ<q>قْ</>لِعِى وَغِيضَ <h>ٱ</>لْ<o>مَآ</>ءُ وَقُضِىَ <h>ٱ</>لْأَمْرُ وَ<h>ٱ</>سْتَوَتْ عَلَى <h>ٱ</>لْجُودِىِّ ۖ وَقِيلَ بُعْ<w>دًۭا لِّ</>لْقَوْمِ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":45,"w":[["وَنَادَىٰ","wanādā","And Nuh called","এবং ডাকলো"],["نُوحٌۭ","nūḥun","And Nuh called","নূহ"],["رَّبَّهُۥ","rabbahu","(to) his Lord","তাঁর রবকে"],["فَقَالَ","faqāla","and said","অতঃপর সে বললো"],["رَبِّ","rabbi","O my Lord","\"হে আমার রব"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱبْنِى","ib'nī","my son","আমার ছেলে"],["مِنْ","min","(is) of","অন্তর্ভুক্ত"],["أَهْلِى","ahlī","my family","আমার পরিবারের"],["وَإِنَّ","wa-inna","and indeed","এবং নিশ্চয়ই"],["وَعْدَكَ","wa‘daka","Your promise","তোমার প্রতিশ্রুতি"],["ٱلْحَقُّ","l-ḥaqu","(is) true","সত্য"],["وَأَنتَ","wa-anta","and You","এবং তুমিই"],["أَحْكَمُ","aḥkamu","(are) the Most Just","উত্তম বিচারক"],["ٱلْحَـٰكِمِينَ","l-ḥākimīna","(of) the judges","(সব) বিচারকদের\""]],"t":"وَنَادَىٰ نُو<w>حٌۭ رَّ</>بَّهُ<m>ۥ</> فَقَالَ رَبِّ إِ<g>نَّ</> <h>ٱ</><q>بْ</>نِى مِنْ أَهْلِى وَإِ<g>نَّ</> وَعْدَكَ <h>ٱ</>لْحَقُّ وَأَ<k>نتَ</> أَحْكَمُ <h>ٱ</>لْ<m>حَٰ</>كِ<p>مِي</>نَ"},{"n":46,"w":[["قَالَ","qāla","He said","(আল্লাহ) বললেন"],["يَـٰنُوحُ","yānūḥu","O Nuh","\"হে নূহ"],["إِنَّهُۥ","innahu","Indeed, he","সে নিশ্চয়ই"],["لَيْسَ","laysa","(is) not","নয়"],["مِنْ","min","of","অন্তর্ভুক্ত"],["أَهْلِكَ ۖ","ahlika","your family","তোমার পরিবারের"],["إِنَّهُۥ","innahu","indeed, [he]","নিশ্চয়ই তা"],["عَمَلٌ","‘amalun","(his) deed","কাজ"],["غَيْرُ","ghayru","(is) other than","নয়/অ"],["صَـٰلِحٍۢ ۖ","ṣāliḥin","righteous","সৎ"],["فَلَا","falā","so (do) not","অতএব না"],["تَسْـَٔلْنِ","tasalni","ask Me","আমার কাছে অনুরোধ করো"],["مَا","mā","(about) what","যার"],["لَيْسَ","laysa","not","নেই"],["لَكَ","laka","you have","তোমার"],["بِهِۦ","bihi","of it","সে সম্বন্ধে"],["عِلْمٌ ۖ","‘il'mun","any knowledge","কোন জ্ঞান"],["إِنِّىٓ","innī","Indeed, I","নিশ্চয়ই আমি"],["أَعِظُكَ","a‘iẓuka","admonish you","তোমাকে উপদেশ দিচ্ছি"],["أَن","an","lest","যে (না)"],["تَكُونَ","takūna","you be","তুমি হয়ো"],["مِنَ","mina","among","অন্তর্ভুক্ত"],["ٱلْجَـٰهِلِينَ","l-jāhilīna","the ignorant","মূর্খদের\""]],"t":"قَالَ <m>يَٰ</>نُوحُ إِ<g>نَّ</>هُ<m>ۥ</> لَيْسَ مِنْ أَهْلِكَ ۖ إِ<g>نَّ</>هُ<m>ۥ</> عَمَلٌ غَيْرُ <m>صَٰ</>لِ<k>حٍۢ ۖ فَ</>لَا تَسْـَٔلْنِ مَا لَيْسَ لَكَ بِ<m>هِۦ</> عِلْمٌ ۖ إِ<g>نِّ</><o>ىٓ</> أَعِظُكَ أَ<k>ن تَ</>كُونَ مِنَ <h>ٱ</>لْ<m>جَٰ</>هِ<p>لِي</>نَ"},{"n":47,"w":[["قَالَ","qāla","He said","সে বললো"],["رَبِّ","rabbi","O my Lord","\"হে আমার রব"],["إِنِّىٓ","innī","Indeed, I","নিশ্চয়ই আমি"],["أَعُوذُ","a‘ūdhu","seek refuge","আশ্রয় চাচ্ছি"],["بِكَ","bika","in You","কাছে তোমার"],["أَنْ","an","that","যে"],["أَسْـَٔلَكَ","asalaka","I (should) ask You","তোমার কাছে আমি অনুরোধ করবো"],["مَا","mā","what","যার"],["لَيْسَ","laysa","not","নেই"],["لِى","lī","I have","আমার"],["بِهِۦ","bihi","of it","তা সম্বন্ধে"],["عِلْمٌۭ ۖ","‘il'mun","knowledge","কোন জ্ঞান"],["وَإِلَّا","wa-illā","And unless","এবং যদি না"],["تَغْفِرْ","taghfir","You forgive","মাফ করো তুমি"],["لِى","lī","me","আমাকে"],["وَتَرْحَمْنِىٓ","watarḥamnī","and You have mercy on me","এবং (না) আমাকে তুমি দয়া করো"],["أَكُن","akun","I will be","আমি হয়ে যাবো"],["مِّنَ","mina","among","অন্তর্ভুক্ত"],["ٱلْخَـٰسِرِينَ","l-khāsirīna","the losers","ক্ষতিগ্রস্তদের\""]],"t":"قَالَ رَبِّ إِ<g>نِّ</><o>ىٓ</> أَعُوذُ بِكَ أَنْ أَسْـَٔلَكَ مَا لَيْسَ لِى بِ<m>هِۦ</> عِلْ<d>مٌۭ ۖ وَ</>إِلَّا تَغْفِرْ لِى وَتَرْحَمْ<o>نِىٓ</> أَ<d>كُن مِّ</>نَ <h>ٱ</>لْ<m>خَٰ</>سِ<p>رِي</>نَ"},{"n":48,"w":[["قِيلَ","qīla","It was said","বলা হলো"],["يَـٰنُوحُ","yānūḥu","O Nuh","\"হে নূহ"],["ٱهْبِطْ","ih'biṭ","Go down","অবতরণ করো"],["بِسَلَـٰمٍۢ","bisalāmin","with peace","শান্তিসহ"],["مِّنَّا","minnā","from Us","আমাদের পক্ষ হ'তে"],["وَبَرَكَـٰتٍ","wabarakātin","and blessings","ও কল্যাণ (সহ)"],["عَلَيْكَ","‘alayka","on you","তোমার উপর"],["وَعَلَىٰٓ","wa‘alā","and on","এবং উপর"],["أُمَمٍۢ","umamin","the nations","(সে সব) সম্প্রদায়ের"],["مِّمَّن","mimman","from those","তাদের মধ্যে যারা"],["مَّعَكَ ۚ","ma‘aka","with you","তোমার সাথে (আছে)"],["وَأُمَمٌۭ","wa-umamun","But (to other) nations","ও অন্য কিছু সম্প্রদায়"],["سَنُمَتِّعُهُمْ","sanumatti‘uhum","We will grant enjoyment","তাদের আমরা জীবনোপকরণ দিবো"],["ثُمَّ","thumma","then","এরপর"],["يَمَسُّهُم","yamassuhum","will touch them","তাদের স্পর্শ করবে"],["مِّنَّا","minnā","from Us","আমাদের পক্ষ হ'তে"],["عَذَابٌ","‘adhābun","a punishment","শাস্তি"],["أَلِيمٌۭ","alīmun","painful","নিদারুণ\""]],"t":"قِيلَ <m>يَٰ</>نُوحُ <h>ٱ</>هْبِ<q>طْ</> بِسَ<m>لَٰ</><d>مٍۢ مِّ</><g>نَّ</>ا وَبَرَ<m>كَٰ</>تٍ عَلَيْكَ وَعَلَ<o>ىٰٓ</> أُمَ<d>مٍۢ مِّ</><g>مَّ</><d>ن مَّ</>عَكَ ۚ وَأُمَ<k>مٌۭ سَ</>نُمَتِّعُهُمْ ثُ<g>مَّ</> يَمَسُّ<y>هُم مِّ</><g>نَّ</>ا عَذَابٌ أَ<p>لِي</>مٌۭ"},{"n":49,"w":[["تِلْكَ","til'ka","This","(হে নাবী) এই"],["مِنْ","min","(is) from","অন্তর্ভুক্ত"],["أَنۢبَآءِ","anbāi","the news","সংবাদ সমূহ"],["ٱلْغَيْبِ","l-ghaybi","(of) the unseen","অদৃশ্যের"],["نُوحِيهَآ","nūḥīhā","(which) We reveal","যা ওহী করছি আমরা"],["إِلَيْكَ ۖ","ilayka","to you","তোমার প্রতি"],["مَا","mā","Not","না"],["كُنتَ","kunta","you were","তুমি ছিলে"],["تَعْلَمُهَآ","ta‘lamuhā","knowing it","তা জানতে"],["أَنتَ","anta","you","তুমি"],["وَلَا","walā","and not","আর না"],["قَوْمُكَ","qawmuka","your people","তোমার জাতি"],["مِن","min","from","থেকে"],["قَبْلِ","qabli","before","পূর্বে"],["هَـٰذَا ۖ","hādhā","this","এটার"],["فَٱصْبِرْ ۖ","fa-iṣ'bir","So be patient","অতএব ধৈর্য ধরো"],["إِنَّ","inna","indeed","নিশ্চয়ই"],["ٱلْعَـٰقِبَةَ","l-‘āqibata","the end","(শুভ) পরিণাম"],["لِلْمُتَّقِينَ","lil'muttaqīna","(is) for the God fearing","মুত্তাকীদের জন্যে\""]],"t":"تِلْكَ مِنْ أَ<i>نۢبَ</><o>آ</>ءِ <h>ٱ</>لْغَيْبِ نُوحِي<o>هَآ</> إِلَيْكَ ۖ مَا كُ<k>نتَ</> تَعْلَمُ<o>هَآ</> أَ<k>نتَ</> وَلَا قَوْمُكَ مِ<k>ن قَ</><q>بْ</>لِ <m>هَٰ</>ذَا ۖ فَ<h>ٱ</>صْبِرْ ۖ إِ<g>نَّ</> <h>ٱ</>لْ<m>عَٰ</>قِبَةَ لِلْمُتَّ<p>قِي</>نَ"},{"n":50,"w":[["وَإِلَىٰ","wa-ilā","And to","এবং প্রতি"],["عَادٍ","‘ādin","Aad","আদ-এর"],["أَخَاهُمْ","akhāhum","(We sent) their brother","তাদের ভাই"],["هُودًۭا ۚ","hūdan","Hud","হূদকে (পাঠিয়েছিলাম)"],["قَالَ","qāla","He said","সে বললো"],["يَـٰقَوْمِ","yāqawmi","O my people","\"হে আমার জাতি"],["ٱعْبُدُوا۟","u‘'budū","Worship","তোমরা ইবাদত করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহর"],["مَا","mā","not","নেই"],["لَكُم","lakum","(is) for you","তোমাদের জন্যে"],["مِّنْ","min","any","কোন"],["إِلَـٰهٍ","ilāhin","god","ইলাহ"],["غَيْرُهُۥٓ ۖ","ghayruhu","other than Him","তিনি ছাড়া"],["إِنْ","in","Not","নও"],["أَنتُمْ","antum","you","তোমরা"],["إِلَّا","illā","(are) but","ছাড়া"],["مُفْتَرُونَ","muf'tarūna","inventors","মিথ্যারচনাকারী"]],"t":"وَإِلَىٰ عَادٍ أَخَاهُمْ هُو<k>دًۭا ۚ قَ</>الَ <m>يَٰ</>قَوْمِ <h>ٱ</>عْبُدُو<s>ا۟</> <h>ٱ</>للَّهَ مَا لَ<y>كُم مِّ</>نْ إِ<m>لَٰ</>هٍ غَيْرُهُ<o>ۥٓ ۖ</> إِنْ أَ<k>نتُ</>مْ إِلَّا مُفْتَ<p>رُو</>نَ"},{"n":51,"w":[["يَـٰقَوْمِ","yāqawmi","O my people","হে আমার জাতি"],["لَآ","lā","Not","না"],["أَسْـَٔلُكُمْ","asalukum","I ask you","তোমাদের কাছে আমি চাই"],["عَلَيْهِ","‘alayhi","for it","এর বিনিময়ে"],["أَجْرًا ۖ","ajran","any reward","কোন পারিশ্রামিক"],["إِنْ","in","Not","নেই"],["أَجْرِىَ","ajriya","(is) my reward","আমার পারিশ্রমিক"],["إِلَّا","illā","except","ছাড়া"],["عَلَى","‘alā","from","উপর"],["ٱلَّذِى","alladhī","the One Who","(তাঁর) যিনি"],["فَطَرَنِىٓ ۚ","faṭaranī","created me","আমাকে সৃষ্টি করেছেন"],["أَفَلَا","afalā","Then will not","তবুও কি না"],["تَعْقِلُونَ","ta‘qilūna","you use reason","তোমরা বুদ্ধি কাজে লাগাবে"]],"t":"<m>يَٰ</>قَوْمِ <o>لَآ</> أَسْـَٔلُكُمْ عَلَيْهِ أَ<q>جْ</>رًا ۖ إِنْ أَ<q>جْ</>رِىَ إِلَّا عَلَى <h>ٱ</>لَّذِى فَطَرَ<o>نِىٓ ۚ</> أَفَلَا تَعْقِ<p>لُو</>نَ"},{"n":52,"w":[["وَيَـٰقَوْمِ","wayāqawmi","And O my people","এবং হে আমার জাতি"],["ٱسْتَغْفِرُوا۟","is'taghfirū","Ask forgiveness","তোমরা ক্ষমা চাও"],["رَبَّكُمْ","rabbakum","(of) your Lord","তোমাদের রবের (কাছে)"],["ثُمَّ","thumma","then","এরপর"],["تُوبُوٓا۟","tūbū","turn in repentance","ফিরে এসো তোমরা"],["إِلَيْهِ","ilayhi","to Him","তাঁরই দিকে"],["يُرْسِلِ","yur'sili","He will send","তিনি প্রেরণ করবেন"],["ٱلسَّمَآءَ","l-samāa","(from) the sky (rain)","আকাশ থেকে (বৃষ্টি)"],["عَلَيْكُم","‘alaykum","upon you","তোমাদের উপর"],["مِّدْرَارًۭا","mid'rāran","(in) abundance","মুষলধারে"],["وَيَزِدْكُمْ","wayazid'kum","and increase you","এবং তোমাদের বৃদ্ধি করবেন"],["قُوَّةً","quwwatan","(in) strength","শক্তি"],["إِلَىٰ","ilā","(added) to","উপর"],["قُوَّتِكُمْ","quwwatikum","your strength","তোমাদের শক্তির"],["وَلَا","walā","And (do) not","এবং না"],["تَتَوَلَّوْا۟","tatawallaw","turn away","তোমাদের মুখ ফিরিয়ে নিও"],["مُجْرِمِينَ","muj'rimīna","(as) criminals","অপরাধী হয়ে\""]],"t":"وَ<m>يَٰ</>قَوْمِ <h>ٱ</>سْتَغْفِرُو<s>ا۟</> رَبَّكُمْ ثُ<g>مَّ</> تُو<o>بُوٓ</><s>ا۟</> إِلَيْهِ يُرْسِلِ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءَ عَلَيْ<y>كُم مِّ</><q>دْ</>رَا<d>رًۭا وَ</>يَزِ<q>دْ</>كُمْ قُوَّةً إِلَىٰ قُوَّتِكُمْ وَلَا تَتَوَلَّوْ<s>ا۟</> مُ<q>جْ</>رِ<p>مِي</>نَ"},{"n":53,"w":[["قَالُوا۟","qālū","They said","তারা বলেছিলো"],["يَـٰهُودُ","yāhūdu","O Hud","\"হে হুদ"],["مَا","mā","You have not brought us","না"],["جِئْتَنَا","ji'tanā","You have not brought us","আমাদের কাছে তুমি এসেছো"],["بِبَيِّنَةٍۢ","bibayyinatin","clear proofs","নিয়ে সুস্পষ্ট প্রমাণ"],["وَمَا","wamā","and not","এবং না"],["نَحْنُ","naḥnu","we","আমরা"],["بِتَارِكِىٓ","bitārikī","(will) leave","পরিত্যাগকারী"],["ءَالِهَتِنَا","ālihatinā","our gods","আমাদের উপাস্যদেরকে"],["عَن","‘an","on","কারণে"],["قَوْلِكَ","qawlika","your saying","তোমার কথার"],["وَمَا","wamā","and not","এবং না"],["نَحْنُ","naḥnu","we (are)","আমরা"],["لَكَ","laka","in you","তোমার প্রতি"],["بِمُؤْمِنِينَ","bimu'minīna","believers","বিশ্বাসী"]],"t":"قَالُو<s>ا۟</> <m>يَٰ</>هُودُ مَا جِئْتَنَا بِبَيِّنَ<d>ةٍۢ وَ</>مَا نَحْنُ بِتَارِ<o>كِىٓ</> ءَالِهَتِنَا عَ<k>ن قَ</>وْلِكَ وَمَا نَحْنُ لَكَ بِمُؤْمِ<p>نِي</>نَ"},{"n":54,"w":[["إِن","in","Not","না"],["نَّقُولُ","naqūlu","we say","আমরা বলি"],["إِلَّا","illā","except (that)","ছাড়া"],["ٱعْتَرَىٰكَ","i‘'tarāka","have seized you","তোমাকে আচ্ছন্ন করেছে"],["بَعْضُ","ba‘ḍu","some","কেউ"],["ءَالِهَتِنَا","ālihatinā","(of) our gods","আমাদের উপাস্যদের"],["بِسُوٓءٍۢ ۗ","bisūin","with evil","দিয়ে মন্দ\""],["قَالَ","qāla","He said","সে বললো"],["إِنِّىٓ","innī","Indeed, I","\"নিশ্চয়ই আমি"],["أُشْهِدُ","ush'hidu","[I] call Allah to witness","সাক্ষী করছি"],["ٱللَّهَ","l-laha","[I] call Allah to witness","আল্লাহকে"],["وَٱشْهَدُوٓا۟","wa-ish'hadū","and (you) bear witness","এবং তোমরাও সাক্ষী থাকো"],["أَنِّى","annī","that I am","নিশ্চয়ই আমি"],["بَرِىٓءٌۭ","barīon","innocent","সম্পর্ক মুক্ত"],["مِّمَّا","mimmā","of what","তা হ'তে যা"],["تُشْرِكُونَ","tush'rikūna","you associate","তোমরা শরিক করছো"]],"t":"<d>إِن نَّ</>قُولُ إِلَّا <h>ٱ</>عْتَرَ<m>ىٰ</>كَ بَعْضُ ءَالِهَتِنَا بِ<o>سُوٓ</><k>ءٍۢ ۗ قَ</>الَ إِ<g>نِّ</><o>ىٓ</> أُشْهِدُ <h>ٱ</>للَّهَ وَ<h>ٱ</>شْهَ<o>دُوٓ</><s>ا۟</> أَ<g>نِّ</>ى بَ<o>رِىٓ</><d>ءٌۭ مِّ</><g>مَّ</>ا تُشْرِ<p>كُو</>نَ"},{"n":55,"w":[["مِن","min","Other than Him","ছাড়া"],["دُونِهِۦ ۖ","dūnihi","Other than Him","তাঁকে"],["فَكِيدُونِى","fakīdūnī","So plot against me","আমার বিরুদ্ধে এখন তোমরা ষড়যন্ত্র করো"],["جَمِيعًۭا","jamī‘an","all together","সকলে (মিলে)"],["ثُمَّ","thumma","then","এরপর"],["لَا","lā","(do) not","না"],["تُنظِرُونِ","tunẓirūni","give me respite","আমাকে তোমরা অবকাশ দিও"]],"t":"مِ<k>ن دُ</>ونِ<m>هِۦ</> ۖ فَكِيدُونِى جَمِي<k>عًۭا ثُ</><g>مَّ</> لَا تُ<k>نظِ</><p>رُو</>نِ"},{"n":56,"w":[["إِنِّى","innī","Indeed, I","নিশ্চয়ই আমি"],["تَوَكَّلْتُ","tawakkaltu","[I] put my trust","নির্ভর করছি"],["عَلَى","‘alā","upon","উপর"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["رَبِّى","rabbī","my Lord","(যিনি) আমার রব"],["وَرَبِّكُم ۚ","warabbikum","and your Lord","ও তোমাদের রব"],["مَّا","mā","(There is) not","নেই"],["مِن","min","of a moving creature","কোন"],["دَآبَّةٍ","dābbatin","of a moving creature","বিচরণশীল প্রণী"],["إِلَّا","illā","but","ছাড়া"],["هُوَ","huwa","He","তিনি"],["ءَاخِذٌۢ","ākhidhun","has grasp","ধারণকারী"],["بِنَاصِيَتِهَآ ۚ","bināṣiyatihā","of its forelock","তার সামনের কেশগুচ্ছকে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["رَبِّى","rabbī","my Lord","আমার রব"],["عَلَىٰ","‘alā","(is) on","উপর"],["صِرَٰطٍۢ","ṣirāṭin","a path","পথের"],["مُّسْتَقِيمٍۢ","mus'taqīmin","straight","সরল-সঠিক (অর্থাৎ এই পথেই তাঁকে পাবে)"]],"t":"إِ<g>نِّ</>ى تَوَكَّلْتُ عَلَى <h>ٱ</>للَّهِ رَبِّى وَرَبِّ<y>كُم ۚ مَّ</>ا مِ<k>ن دَ</><n>آ</>بَّةٍ إِلَّا هُوَ ءَاخِ<i>ذٌۢ بِ</>نَاصِيَتِ<o>هَآ ۚ</> إِ<g>نَّ</> رَبِّى عَلَىٰ صِ<m>رَٰ</><d>طٍۢ مُّ</>سْتَ<p>قِي</>مٍۢ"},{"n":57,"w":[["فَإِن","fa-in","So if","অতঃপর যদি"],["تَوَلَّوْا۟","tawallaw","you turn away","মুখ ফিরিয়ে নাও"],["فَقَدْ","faqad","then verily","তবে নিশ্চয়ই"],["أَبْلَغْتُكُم","ablaghtukum","I have conveyed to you","তোমাদেরকে আমি পৌঁছিয়েছি"],["مَّآ","mā","what","তাই"],["أُرْسِلْتُ","ur'sil'tu","I was sent","আমি প্রেরিত হয়েছি"],["بِهِۦٓ","bihi","with [it]","নিয়ে যা"],["إِلَيْكُمْ ۚ","ilaykum","to you","তোমাদের প্রতি"],["وَيَسْتَخْلِفُ","wayastakhlifu","And my Lord will give succession","স্থলাভিষিক্ত করবেন"],["رَبِّى","rabbī","And my Lord will give succession","আমার রব"],["قَوْمًا","qawman","(to) a people","(অন্য) সম্প্ররদায়কে"],["غَيْرَكُمْ","ghayrakum","other than you","তোমাদের ছাড়া"],["وَلَا","walā","and not","এবং না"],["تَضُرُّونَهُۥ","taḍurrūnahu","you will harm Him","তাঁকে তোমরা ক্ষতি করতে পারবে"],["شَيْـًٔا ۚ","shayan","(in) anything","কিছুমাত্র"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["رَبِّى","rabbī","my Lord","আমার রব"],["عَلَىٰ","‘alā","(is) on","উপর"],["كُلِّ","kulli","all","সব"],["شَىْءٍ","shayin","things","কিছুর"],["حَفِيظٌۭ","ḥafīẓun","a Guardian","রক্ষণাবেক্ষণকারী (নিয়ন্ত্রনকারী)\""]],"t":"فَإِ<k>ن تَ</>وَلَّوْ<s>ا۟</> فَقَ<q>دْ</> أَ<q>بْ</>لَغْتُ<y>كُم مَّ</><o>آ</> أُرْسِلْتُ بِ<o>هِۦٓ</> إِلَيْكُمْ ۚ وَيَسْتَخْلِفُ رَبِّى قَوْمًا غَيْرَكُمْ وَلَا تَضُرُّونَهُ<m>ۥ</> شَيْـًٔا ۚ إِ<g>نَّ</> رَبِّى عَلَىٰ كُلِّ شَىْءٍ حَ<p>فِي</>ظٌۭ"},{"n":58,"w":[["وَلَمَّا","walammā","And when","এবং যখন"],["جَآءَ","jāa","came","আসলো"],["أَمْرُنَا","amrunā","Our command","আমাদের নির্দেশ"],["نَجَّيْنَا","najjaynā","We saved","আমরা রক্ষা করলাম"],["هُودًۭا","hūdan","Hud","হূদকে"],["وَٱلَّذِينَ","wa-alladhīna","and those who","ও যারা"],["ءَامَنُوا۟","āmanū","believed","ঈমান এনেছিলো"],["مَعَهُۥ","ma‘ahu","with him","তার সাথে"],["بِرَحْمَةٍۢ","biraḥmatin","by a Mercy","অনুগ্রহ দিয়ে"],["مِّنَّا","minnā","from Us","আমাদের পক্ষ থেকে"],["وَنَجَّيْنَـٰهُم","wanajjaynāhum","and We saved them","এবং তাদেরকে আমরা রক্ষা করলাম"],["مِّنْ","min","from","হ'তে"],["عَذَابٍ","‘adhābin","a punishment","শাস্তি"],["غَلِيظٍۢ","ghalīẓin","severe","কঠিন"]],"t":"وَلَ<g>مَّ</>ا <o>جَآ</>ءَ أَمْرُنَا نَجَّيْنَا هُو<d>دًۭا وَ</><h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> مَعَهُ<m>ۥ</> بِرَحْمَ<d>ةٍۢ مِّ</><g>نَّ</>ا وَنَجَّيْ<m>نَٰ</><y>هُم مِّ</>نْ عَذَابٍ غَ<p>لِي</>ظٍۢ"},{"n":59,"w":[["وَتِلْكَ","watil'ka","And this","এবং এই (ছিলো)"],["عَادٌۭ ۖ","‘ādun","(was) Aad","আদ জাতি"],["جَحَدُوا۟","jaḥadū","they rejected","অস্বীকার করেছিল"],["بِـَٔايَـٰتِ","biāyāti","(the) Signs","নিদর্শনাবলীকে"],["رَبِّهِمْ","rabbihim","(of) their Lord","তাদের রবের"],["وَعَصَوْا۟","wa‘aṣaw","and disobeyed","এবং তারা অমান্য করেছিলো"],["رُسُلَهُۥ","rusulahu","His Messengers","তাঁর রাসূলদেরকে"],["وَٱتَّبَعُوٓا۟","wa-ittaba‘ū","and followed","এবং তারা অনুসরণ করেছিলো"],["أَمْرَ","amra","(the) command","নির্দেশের"],["كُلِّ","kulli","(of) every","প্রত্যেক"],["جَبَّارٍ","jabbārin","tyrant","উদ্ধত"],["عَنِيدٍۢ","‘anīdin","obstinate","স্বৈরাচারীর"]],"t":"وَتِلْكَ عَا<k>دٌۭ ۖ جَ</>حَدُو<s>ا۟</> بِـَٔا<m>يَٰ</>تِ رَبِّهِمْ وَعَصَوْ<s>ا۟</> رُسُلَهُ<m>ۥ</> وَ<h>ٱ</>تَّبَ<o>عُوٓ</><s>ا۟</> أَمْرَ كُلِّ جَبَّارٍ عَ<p>نِي</><q>دٍۢ</>"},{"n":60,"w":[["وَأُتْبِعُوا۟","wa-ut'bi‘ū","And they were followed","এবং তাদের পিছনে লাগিয়ে দেয়া হলো"],["فِى","fī","in","মধ্যে"],["هَـٰذِهِ","hādhihi","this","এই"],["ٱلدُّنْيَا","l-dun'yā","world","পৃথিবীর"],["لَعْنَةًۭ","la‘natan","(with) a curse","অভিশাপ"],["وَيَوْمَ","wayawma","and (on the) Day","এবং দিনেও"],["ٱلْقِيَـٰمَةِ ۗ","l-qiyāmati","(of) the Resurrection","ক্বিয়ামাতের"],["أَلَآ","alā","No doubt","সাবধান (জেনে রাখো)"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["عَادًۭا","‘ādan","Aad","আদ জাতি"],["كَفَرُوا۟","kafarū","disbelieved","অস্বীকার করেছিলো"],["رَبَّهُمْ ۗ","rabbahum","their Lord","তাদের রবকে"],["أَلَا","alā","So","সাবধান (জেনে রাখো)"],["بُعْدًۭا","bu‘'dan","away","ধ্বংসই (করা হলো)"],["لِّعَادٍۢ","li‘ādin","with Aad","জন্য আদের"],["قَوْمِ","qawmi","(the) people","(যা ছিলো) জাতি"],["هُودٍۢ","hūdin","(of) Hud","হূদ (নাবীর)"]],"t":"وَأُتْبِعُو<s>ا۟</> فِى <m>هَٰ</>ذِهِ <h>ٱ</><l>ل</>دُّنْيَا لَعْنَ<d>ةًۭ وَ</>يَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ ۗ أَ<o>لَآ</> إِ<g>نَّ</> عَا<k>دًۭا كَ</>فَرُو<s>ا۟</> رَبَّهُمْ ۗ أَلَا بُعْ<w>دًۭا لِّ</>عَا<k>دٍۢ قَ</>وْمِ <p>هُو</><q>دٍۢ</>"},{"n":61,"w":[["۞ وَإِلَىٰ","wa-ilā","And to","এবং প্রতি"],["ثَمُودَ","thamūda","Thamud","সামূদ জাতির"],["أَخَاهُمْ","akhāhum","(We sent) their brother","তাদের ভাই"],["صَـٰلِحًۭا ۚ","ṣāliḥan","Salih","সালিহকে (পাঠিয়েছিলাম)"],["قَالَ","qāla","He said","সে বললো"],["يَـٰقَوْمِ","yāqawmi","O my people","\"হে আমার জাতি"],["ٱعْبُدُوا۟","u‘'budū","Worship","তোমরা ইবাদত করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহর"],["مَا","mā","not","নেই"],["لَكُم","lakum","you have","তোমাদের জন্যে"],["مِّنْ","min","any","অন্য কোন"],["إِلَـٰهٍ","ilāhin","god","ইলাহ"],["غَيْرُهُۥ ۖ","ghayruhu","other than Him","তিনি ছাড়া"],["هُوَ","huwa","He","তিনিই"],["أَنشَأَكُم","ansha-akum","produced you","তোমাদের সৃষ্টি করেছেন"],["مِّنَ","mina","from","থেকে"],["ٱلْأَرْضِ","l-arḍi","the earth","মাটি"],["وَٱسْتَعْمَرَكُمْ","wa-is'ta‘marakum","and settled you","এবং তোমাদের বসবাস করিয়েছেন"],["فِيهَا","fīhā","in it","তার মধ্যে"],["فَٱسْتَغْفِرُوهُ","fa-is'taghfirūhu","So ask forgiveness of Him","অতএব তাঁর কাছে তোমরা ক্ষমা চাও"],["ثُمَّ","thumma","then","এরপর"],["تُوبُوٓا۟","tūbū","turn in repentance","তোমরা ফিরে এসো"],["إِلَيْهِ ۚ","ilayhi","to Him","তাঁর দিকে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["رَبِّى","rabbī","my Lord","আমার রব"],["قَرِيبٌۭ","qarībun","(is) near","নিকটেই (আছেন)"],["مُّجِيبٌۭ","mujībun","All-Responsive","যিনি ডাকের সাড়া দেন\""]],"t":"۞ وَإِلَىٰ ثَمُودَ أَخَاهُمْ <m>صَٰ</>لِ<k>حًۭا ۚ قَ</>الَ <m>يَٰ</>قَوْمِ <h>ٱ</>عْبُدُو<s>ا۟</> <h>ٱ</>للَّهَ مَا لَ<y>كُم مِّ</>نْ إِ<m>لَٰ</>هٍ غَيْرُهُ<m>ۥ</> ۖ هُوَ أَ<k>نشَ</>أَ<y>كُم مِّ</>نَ <h>ٱ</>لْأَرْضِ وَ<h>ٱ</>سْتَعْمَرَكُمْ فِيهَا فَ<h>ٱ</>سْتَغْفِرُوهُ ثُ<g>مَّ</> تُو<o>بُوٓ</><s>ا۟</> إِلَيْهِ ۚ إِ<g>نَّ</> رَبِّى قَرِي<d>بٌۭ مُّ</><p>جِي</><q>بٌۭ</>"},{"n":62,"w":[["قَالُوا۟","qālū","They said","তারা বলেছিলো"],["يَـٰصَـٰلِحُ","yāṣāliḥu","O Salih","হে সালিহ"],["قَدْ","qad","Verily","নিশ্চয়ই"],["كُنتَ","kunta","you were","তুমি ছিলে"],["فِينَا","fīnā","among us","আমাদের মধ্যে"],["مَرْجُوًّۭا","marjuwwan","the one in whom hope was placed","ভরসা"],["قَبْلَ","qabla","before","পূর্বে"],["هَـٰذَآ ۖ","hādhā","this","এর"],["أَتَنْهَىٰنَآ","atanhānā","Do you forbid us","আমাদেরকে কি নিষেধ করছো"],["أَن","an","that","যে"],["نَّعْبُدَ","na‘buda","we worship","আমরা উপাসনা করি"],["مَا","mā","what","যার"],["يَعْبُدُ","ya‘budu","our forefathers worshipped","ইবাদাত করেছে"],["ءَابَآؤُنَا","ābāunā","our forefathers worshipped","আমাদের পূর্বপুরুষেরা"],["وَإِنَّنَا","wa-innanā","And indeed we","এবং নিশ্চয়ই আমরা"],["لَفِى","lafī","surely (are) in","অবশ্যই মধ্যে আছি"],["شَكٍّۢ","shakkin","doubt","সন্দেহের"],["مِّمَّا","mimmā","about what","তা হ'তে"],["تَدْعُونَآ","tad‘ūnā","you call us","আমাদের তুমি আহ্বান করছো"],["إِلَيْهِ","ilayhi","to it","যার দিকে"],["مُرِيبٍۢ","murībin","suspicious","বিভ্রান্তিকর\""]],"t":"قَالُو<s>ا۟</> <m>يَٰصَٰ</>لِحُ قَ<q>دْ</> كُ<k>نتَ</> فِينَا مَرْجُ<k>وًّۭا قَ</><q>بْ</>لَ <m>هَٰ</><o>ذَآ ۖ</> أَتَنْهَ<m>ىٰ</><o>نَآ</> <d>أَن نَّ</>عْبُدَ مَا يَعْبُدُ ءَا<o>بَآ</>ؤُنَا وَإِ<g>نَّ</>نَا لَفِى شَ<d>كٍّۢ مِّ</><g>مَّ</>ا تَ<q>دْ</>عُو<o>نَآ</> إِلَيْهِ مُ<p>رِي</><q>بٍۢ</>"},{"n":63,"w":[["قَالَ","qāla","He said","সে বললো"],["يَـٰقَوْمِ","yāqawmi","O my people","\"হে আমার জাতি"],["أَرَءَيْتُمْ","ara-aytum","Do you see","তোমরা (ভেবে) দেখেছো কি"],["إِن","in","if","যদি"],["كُنتُ","kuntu","I am","আমি থাকি"],["عَلَىٰ","‘alā","on","উপর"],["بَيِّنَةٍۢ","bayyinatin","a clear proof","স্পষ্ট প্রমাণের"],["مِّن","min","from","পক্ষ হ'তে"],["رَّبِّى","rabbī","my Lord","আমার রবের"],["وَءَاتَىٰنِى","waātānī","and He has given me","এবং তিনি আমাকে দান করে থাকেন"],["مِنْهُ","min'hu","from Him","তাঁর পক্ষ হ'তে"],["رَحْمَةًۭ","raḥmatan","a Mercy","অনুগ্রহ"],["فَمَن","faman","then who","তবে কে"],["يَنصُرُنِى","yanṣurunī","(can) help me","আমাকে সাহায্য করবে"],["مِنَ","mina","against","থেকে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["إِنْ","in","if","যদি"],["عَصَيْتُهُۥ ۖ","‘aṣaytuhu","I (were to) disobey Him","তার আমি অবাধ্য হই"],["فَمَا","famā","So not","অতএব না"],["تَزِيدُونَنِى","tazīdūnanī","you would increase me","আমাকে বৃদ্ধি করবে তোমরা"],["غَيْرَ","ghayra","but","ছাড়া"],["تَخْسِيرٍۢ","takhsīrin","(in) loss","ক্ষতি"]],"t":"قَالَ <m>يَٰ</>قَوْمِ أَرَءَيْتُمْ إِ<k>ن كُنتُ</> عَلَىٰ بَيِّنَ<d>ةٍۢ مِّ</><w>ن رَّ</>بِّى وَءَاتَ<m>ىٰ</>نِى مِنْهُ رَحْمَ<k>ةًۭ فَ</><d>مَن يَ</><k>نصُ</>رُنِى مِنَ <h>ٱ</>للَّهِ إِنْ عَصَيْتُهُ<m>ۥ</> ۖ فَمَا تَزِيدُونَنِى غَيْرَ تَخْ<p>سِي</>رٍۢ"},{"n":64,"w":[["وَيَـٰقَوْمِ","wayāqawmi","And O my people","এবং হে আমার জাতি"],["هَـٰذِهِۦ","hādhihi","This","এই"],["نَاقَةُ","nāqatu","she-camel","উষ্ট্রী"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর (পক্ষ হ'তে)"],["لَكُمْ","lakum","(is) for you","তোমাদের জন্যে"],["ءَايَةًۭ","āyatan","a Sign","একটি নিদর্শন"],["فَذَرُوهَا","fadharūhā","so leave her","অতএব তাকে ছেড়ে দাও"],["تَأْكُلْ","takul","to eat","সে খাবে"],["فِىٓ","fī","in","মধ্যে"],["أَرْضِ","arḍi","the earth","জমির"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَلَا","walā","and (do) not","এবং না"],["تَمَسُّوهَا","tamassūhā","touch her","তাকে স্পর্শ করবে"],["بِسُوٓءٍۢ","bisūin","with harm","নিয়ে খারাপ উদ্দেশ্যে"],["فَيَأْخُذَكُمْ","fayakhudhakum","lest will seize you","তাহ'লে তোমাদেরকে ধরবে"],["عَذَابٌۭ","‘adhābun","a punishment","শাস্তি"],["قَرِيبٌۭ","qarībun","impending","শীঘ্রই\""]],"t":"وَ<m>يَٰ</>قَوْمِ <m>هَٰذِهِۦ</> نَاقَةُ <h>ٱ</>للَّهِ لَكُمْ ءَايَ<k>ةًۭ فَ</>ذَرُوهَا تَأْكُلْ <o>فِىٓ</> أَرْضِ <h>ٱ</>للَّهِ وَلَا تَمَسُّوهَا بِ<o>سُوٓ</><k>ءٍۢ فَ</>يَأْخُذَكُمْ عَذَا<k>بٌۭ قَ</><p>رِي</><q>بٌۭ</>"},{"n":65,"w":[["فَعَقَرُوهَا","fa‘aqarūhā","But they hamstrung her","অতঃপর তাকে তারা হত্যা করলো"],["فَقَالَ","faqāla","So he said","তখন সে বললো"],["تَمَتَّعُوا۟","tamatta‘ū","Enjoy (yourselves)","\"তোমরা জীবন উপভোগ করো"],["فِى","fī","in","মধ্যে"],["دَارِكُمْ","dārikum","your home(s)","তোমাদের ঘরের"],["ثَلَـٰثَةَ","thalāthata","(for) three","তিন"],["أَيَّامٍۢ ۖ","ayyāmin","days","দিন (পর্যন্ত)"],["ذَٰلِكَ","dhālika","That","এটা"],["وَعْدٌ","wa‘dun","(is) a promise","একটি প্রতিশ্রুতি"],["غَيْرُ","ghayru","not","নয়"],["مَكْذُوبٍۢ","makdhūbin","(to) be belied","মিথ্যা হওয়ার\""]],"t":"فَعَقَرُوهَا فَقَالَ تَمَتَّعُو<s>ا۟</> فِى دَارِكُمْ ثَ<m>لَٰ</>ثَةَ أَيَّا<k>مٍۢ ۖ ذَٰ</>لِكَ وَعْدٌ غَيْرُ مَكْ<p>ذُو</><q>بٍۢ</>"},{"n":66,"w":[["فَلَمَّا","falammā","So when","অতঃপর যখন"],["جَآءَ","jāa","came","আসলো"],["أَمْرُنَا","amrunā","Our command","আমাদের নির্দেশ (শাস্তি দেয়ার)"],["نَجَّيْنَا","najjaynā","We saved","আমরা রক্ষা করলাম"],["صَـٰلِحًۭا","ṣāliḥan","Salih","সালিহকে"],["وَٱلَّذِينَ","wa-alladhīna","and those who","ও যারা"],["ءَامَنُوا۟","āmanū","believed","ঈমান এনেছিলো"],["مَعَهُۥ","ma‘ahu","with him","তার সাথে (তাদেরকেও)"],["بِرَحْمَةٍۢ","biraḥmatin","by a Mercy","অনুগ্রহ দিয়ে"],["مِّنَّا","minnā","from Us","আমাদের পক্ষ থেকে"],["وَمِنْ","wamin","and from","এবং হ'তে"],["خِزْىِ","khiz'yi","(the) disgrace","লাঞ্ছনা"],["يَوْمِئِذٍ ۗ","yawmi-idhin","(of) that Day","সেদিনের"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["رَبَّكَ","rabbaka","your Lord","তোমার রব"],["هُوَ","huwa","He","তিনিই"],["ٱلْقَوِىُّ","l-qawiyu","(is) All-Strong","শক্তিমান"],["ٱلْعَزِيزُ","l-‘azīzu","All-Mighty","পরাক্রমশালী"]],"t":"فَلَ<g>مَّ</>ا <o>جَآ</>ءَ أَمْرُنَا نَجَّيْنَا <m>صَٰ</>لِ<d>حًۭا وَ</><h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> مَعَهُ<m>ۥ</> بِرَحْمَ<d>ةٍۢ مِّ</><g>نَّ</>ا وَمِنْ خِزْىِ يَوْمِئِذٍ ۗ إِ<g>نَّ</> رَبَّكَ هُوَ <h>ٱ</>لْقَوِىُّ <h>ٱ</>لْعَ<p>زِي</>زُ"},{"n":67,"w":[["وَأَخَذَ","wa-akhadha","And seized","এবং ধরলো"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["ظَلَمُوا۟","ẓalamū","wronged","সীমালঙ্ঘন করেছিলো"],["ٱلصَّيْحَةُ","l-ṣayḥatu","the thunderous blast","প্রচন্ড শব্দে"],["فَأَصْبَحُوا۟","fa-aṣbaḥū","then they became","অতঃপর তা হয়ে গেলো"],["فِى","fī","in","মধ্যে"],["دِيَـٰرِهِمْ","diyārihim","their homes","তাদের ঘরসমূহের"],["جَـٰثِمِينَ","jāthimīna","fallen prone","উপুড় হয়ে পড়া (নিস্পন্দ-নির্জীব)"]],"t":"وَأَخَذَ <h>ٱ</>لَّذِينَ ظَلَمُو<s>ا۟</> <h>ٱ</><l>ل</>صَّيْحَةُ فَأَصْبَحُو<s>ا۟</> فِى دِ<m>يَٰ</>رِهِمْ <m>جَٰ</>ثِ<p>مِي</>نَ"},{"n":68,"w":[["كَأَن","ka-an","As if","যেন"],["لَّمْ","lam","not","করেনি"],["يَغْنَوْا۟","yaghnaw","they (had) prospered","তারা বসবাস"],["فِيهَآ ۗ","fīhā","therein","তার মধ্যে"],["أَلَآ","alā","No doubt","সাবধান"],["إِنَّ","inna","indeed","নিশ্চয়ই"],["ثَمُودَا۟","thamūdā","Thamud","সামূদ জাতি"],["كَفَرُوا۟","kafarū","disbelieved","অস্বীকার করেছিলো"],["رَبَّهُمْ ۗ","rabbahum","(in) their Lord","তাদের রবের"],["أَلَا","alā","so","জেনে রাখো"],["بُعْدًۭا","bu‘'dan","away","ধ্বংস (করা হয়েছিলো)"],["لِّثَمُودَ","lithamūda","with Thamud","সামুদ জাতির জন্য"]],"t":"كَ<w>أَن لَّ</>مْ يَغْنَوْ<s>ا۟</> فِي<o>هَآ ۗ</> أَ<o>لَآ</> إِ<g>نَّ</> ثَمُودَ<s>ا۟</> كَفَرُو<s>ا۟</> رَبَّهُمْ ۗ أَلَا بُعْ<w>دًۭا لِّ</>ثَ<p>مُو</><q>دَ</>"},{"n":69,"w":[["وَلَقَدْ","walaqad","And certainly","মধ্যে নিশ্চয়ই"],["جَآءَتْ","jāat","came","এসেছিলো"],["رُسُلُنَآ","rusulunā","Our messengers","আমাদের ফেরেশতারা"],["إِبْرَٰهِيمَ","ib'rāhīma","(to) Ibrahim","ইবরাহীমের কাছে"],["بِٱلْبُشْرَىٰ","bil-bush'rā","with glad tidings","নিয়ে সুসংবাদ"],["قَالُوا۟","qālū","they said","তারা বলেছিলো"],["سَلَـٰمًۭا ۖ","salāman","Peace","\"সালাম (বর্ষিত হোক)\""],["قَالَ","qāla","He said","(ইবরাহীম) বললো"],["سَلَـٰمٌۭ ۖ","salāmun","Peace","\"সালাম (বর্ষিত হোক)\""],["فَمَا","famā","and not he delayed","অতঃপর না"],["لَبِثَ","labitha","and not he delayed","সে বিলম্ব করলো"],["أَن","an","to","যে"],["جَآءَ","jāa","bring","সে আসলো"],["بِعِجْلٍ","bi‘ij'lin","a calf","নিয়ে এক বাছুর"],["حَنِيذٍۢ","ḥanīdhin","roasted","ভুনা (মেহমানদারীর জন্যে)"]],"t":"وَلَقَ<q>دْ</> <o>جَآ</>ءَتْ رُسُلُ<o>نَآ</> إِ<q>بْ</><m>رَٰ</>هِيمَ بِ<h>ٱ</>لْبُشْرَىٰ قَالُو<s>ا۟</> سَ<m>لَٰ</><k>مًۭا ۖ قَ</>الَ سَ<m>لَٰ</><k>مٌۭ ۖ فَ</>مَا لَبِثَ أَ<k>ن جَ</><o>آ</>ءَ بِعِ<q>جْ</>لٍ حَ<p>نِي</>ذٍۢ"},{"n":70,"w":[["فَلَمَّا","falammā","But when","অতঃপর যখন"],["رَءَآ","raā","he saw","সে দেখলো"],["أَيْدِيَهُمْ","aydiyahum","their hands","তাদের হাতগুলো"],["لَا","lā","not","না"],["تَصِلُ","taṣilu","reaching","প্রসারিত হচ্ছে"],["إِلَيْهِ","ilayhi","to it","তার দিকে (খানা খেতে)"],["نَكِرَهُمْ","nakirahum","he felt unfamiliar of them","তাদেরকে সে সন্দেহ করলো"],["وَأَوْجَسَ","wa-awjasa","and felt apprehension","ও মনে সঞ্চার হলো"],["مِنْهُمْ","min'hum","from them","তাদের হ'তে"],["خِيفَةًۭ ۚ","khīfatan","[a fear]","ভয়"],["قَالُوا۟","qālū","They said","তারা বললো"],["لَا","lā","(Do) not","\"না"],["تَخَفْ","takhaf","fear","ভয় করো"],["إِنَّآ","innā","Indeed, we","নিশ্চয়ই আমরা"],["أُرْسِلْنَآ","ur'sil'nā","[we] have been sent","আমরা প্রেরিত হয়েছি"],["إِلَىٰ","ilā","to","প্রতি"],["قَوْمِ","qawmi","(the) people","জাতির"],["لُوطٍۢ","lūṭin","(of) Lut","লুতের\""]],"t":"فَلَ<g>مَّ</>ا رَ<o>ءَآ</> أَيْدِيَهُمْ لَا تَصِلُ إِلَيْهِ نَكِرَهُمْ وَأَوْجَسَ مِنْهُمْ خِيفَ<k>ةًۭ ۚ قَ</>الُو<s>ا۟</> لَا تَخَفْ إِ<g>نَّ</><o>آ</> أُرْسِلْ<o>نَآ</> إِلَىٰ قَوْمِ <p>لُو</><q>طٍۢ</>"},{"n":71,"w":[["وَٱمْرَأَتُهُۥ","wa-im'ra-atuhu","And his wife","এবং তার স্ত্রীও (সেখানে)"],["قَآئِمَةٌۭ","qāimatun","(was) standing","দন্ডায়মান ছিলো"],["فَضَحِكَتْ","faḍaḥikat","and she laughed","তখন সে হাসলো (কারণ ভয় দূর হলো)"],["فَبَشَّرْنَـٰهَا","fabasharnāhā","Then We gave her glad tidings","অতঃপর তাকে আমরা সুসংবাদ দিলাম"],["بِإِسْحَـٰقَ","bi-is'ḥāqa","of Isaac","ইসহাক সম্বন্ধে"],["وَمِن","wamin","and after","ও থেকে"],["وَرَآءِ","warāi","and after","পিছন"],["إِسْحَـٰقَ","is'ḥāqa","Isaac","ইসহাকের"],["يَعْقُوبَ","ya‘qūba","(of) Yaqub","ইয়াকুবের"]],"t":"وَ<h>ٱ</>مْرَأَتُهُ<m>ۥ</> <o>قَآ</>ئِمَ<k>ةٌۭ فَ</>ضَحِكَتْ فَبَشَّرْ<m>نَٰ</>هَا بِإِسْ<m>حَٰ</>قَ وَ<d>مِن وَ</><o>رَآ</>ءِ إِسْ<m>حَٰ</>قَ يَعْ<p>قُو</><q>بَ</>"},{"n":72,"w":[["قَالَتْ","qālat","She said","সে বললো"],["يَـٰوَيْلَتَىٰٓ","yāwaylatā","Woe to me","\"হায়, কি আশ্চর্য!"],["ءَأَلِدُ","a-alidu","Shall I bear a child","আমি কি সন্তান প্রসব করবো"],["وَأَنَا۠","wa-anā","while I am","অথচ আমি"],["عَجُوزٌۭ","‘ajūzun","an old woman","বৃদ্ধা"],["وَهَـٰذَا","wahādhā","and this","এবং এই"],["بَعْلِى","ba‘lī","my husband","আমার স্বামী"],["شَيْخًا ۖ","shaykhan","(is) an old man","বৃদ্ধ"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["هَـٰذَا","hādhā","this","এটা"],["لَشَىْءٌ","lashayon","(is) surely a thing","অবশ্যই ব্যাপার"],["عَجِيبٌۭ","‘ajībun","amazing","অদ্ভুত\""]],"t":"قَالَتْ <m>يَٰ</>وَيْلَتَ<o>ىٰٓ</> ءَأَلِدُ وَأَنَا۠ عَجُو<d>زٌۭ وَ</><m>هَٰ</>ذَا بَعْلِى شَيْخًا ۖ إِ<g>نَّ</> <m>هَٰ</>ذَا لَشَىْءٌ عَ<p>جِي</><q>بٌۭ</>"},{"n":73,"w":[["قَالُوٓا۟","qālū","They said","তারা বলেছিলো"],["أَتَعْجَبِينَ","ata‘jabīna","Are you amazed","\"তুমি বিস্মিত হচ্ছো কি"],["مِنْ","min","at","সম্পর্কে"],["أَمْرِ","amri","(the) decree of Allah","নির্দেশ"],["ٱللَّهِ ۖ","l-lahi","(the) decree of Allah","আল্লাহর"],["رَحْمَتُ","raḥmatu","The Mercy of Allah","অনুগ্রহ"],["ٱللَّهِ","l-lahi","The Mercy of Allah","আল্লাহর"],["وَبَرَكَـٰتُهُۥ","wabarakātuhu","and His blessings","এবং তার কল্যাণসমূহ (হ'তেও)"],["عَلَيْكُمْ","‘alaykum","(be) upon you","তোমাদের উপর"],["أَهْلَ","ahla","people","বাসিন্দারা"],["ٱلْبَيْتِ ۚ","l-bayti","(of) the house","ঘরের"],["إِنَّهُۥ","innahu","Indeed, He","তিনি নিশ্চয়ই"],["حَمِيدٌۭ","ḥamīdun","(is) All-Praiseworthy","প্রশংসিত"],["مَّجِيدٌۭ","majīdun","All-Glorious","মহান মহিমাময়\""]],"t":"قَا<o>لُوٓ</><s>ا۟</> أَتَعْجَبِينَ مِنْ أَمْرِ <h>ٱ</>للَّهِ ۖ رَحْمَتُ <h>ٱ</>للَّهِ وَبَرَ<m>كَٰ</>تُهُ<m>ۥ</> عَلَيْكُمْ أَهْلَ <h>ٱ</>لْبَيْتِ ۚ إِ<g>نَّ</>هُ<m>ۥ</> حَمِي<d>دٌۭ مَّ</><p>جِي</><q>دٌۭ</>"},{"n":74,"w":[["فَلَمَّا","falammā","And when","অতঃপর যখন"],["ذَهَبَ","dhahaba","(had) gone away","দূর হলো"],["عَنْ","‘an","from","হ'তে"],["إِبْرَٰهِيمَ","ib'rāhīma","Ibrahim","ইবরাহীম"],["ٱلرَّوْعُ","l-raw‘u","the fright","ভয়"],["وَجَآءَتْهُ","wajāathu","and had reached him","এবং তার কাছে আসলো"],["ٱلْبُشْرَىٰ","l-bush'rā","the glad tidings","সুসংবাদ"],["يُجَـٰدِلُنَا","yujādilunā","he argued with Us","আমাদের সাথে সে তর্ক করতে লাগলো"],["فِى","fī","concerning","ব্যাপারে"],["قَوْمِ","qawmi","the people","জাতির"],["لُوطٍ","lūṭin","of Lut","লুতের"]],"t":"فَلَ<g>مَّ</>ا ذَهَبَ عَنْ إِ<q>بْ</><m>رَٰ</>هِيمَ <h>ٱ</><l>ل</>رَّوْعُ وَ<o>جَآ</>ءَتْهُ <h>ٱ</>لْبُشْرَىٰ يُ<m>جَٰ</>دِلُنَا فِى قَوْمِ <p>لُو</><q>طٍ</>"},{"n":75,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["إِبْرَٰهِيمَ","ib'rāhīma","Ibrahim","ইবরাহীম (ছিলো)"],["لَحَلِيمٌ","laḥalīmun","(was) certainly forbearing","সহনশীল অবশ্যই"],["أَوَّٰهٌۭ","awwāhun","imploring","কোমল হৃদয়ের"],["مُّنِيبٌۭ","munībun","and oft-returning","(আল্লাহ) অভিমূখী"]],"t":"إِ<g>نَّ</> إِ<q>بْ</><m>رَٰ</>هِيمَ لَحَلِيمٌ أَ<m>وَّٰ</><d>هٌۭ مُّ</><p>نِي</><q>بٌۭ</>"},{"n":76,"w":[["يَـٰٓإِبْرَٰهِيمُ","yāib'rāhīmu","O Ibrahim","(বলা হলো) হে ইবরাহীম"],["أَعْرِضْ","a‘riḍ","Turn away","বিরত হও"],["عَنْ","‘an","from","থেকে"],["هَـٰذَآ ۖ","hādhā","this","এটা"],["إِنَّهُۥ","innahu","Indeed, it","নিশ্চয়ই তা"],["قَدْ","qad","certainly","অবশ্যই"],["جَآءَ","jāa","has come","এসে গেছে"],["أَمْرُ","amru","(the) Command","নির্দেশ"],["رَبِّكَ ۖ","rabbika","(of) your Lord","তোমার রবের"],["وَإِنَّهُمْ","wa-innahum","and indeed, [they]","এবং তারা নিশ্চয়ই (এমন যে)"],["ءَاتِيهِمْ","ātīhim","(will) come (for) them","তাদের উপর অাসবে"],["عَذَابٌ","‘adhābun","a punishment","শাস্তি"],["غَيْرُ","ghayru","(which) cannot","নয়"],["مَرْدُودٍۢ","mardūdin","(be) repelled","প্রতিহত হবার"]],"t":"<o>يَٰٓ</>إِ<q>بْ</><m>رَٰ</>هِيمُ أَعْرِضْ عَنْ <m>هَٰ</><o>ذَآ ۖ</> إِ<g>نَّ</>هُ<m>ۥ</> قَ<q>دْ</> <o>جَآ</>ءَ أَمْرُ رَبِّكَ ۖ وَإِ<g>نَّ</>هُمْ ءَاتِيهِمْ عَذَابٌ غَيْرُ مَرْ<p>دُو</><q>دٍۢ</>"},{"n":77,"w":[["وَلَمَّا","walammā","And when","এবং যখন"],["جَآءَتْ","jāat","came","আসলো"],["رُسُلُنَا","rusulunā","Our messengers","আমাদের ফেরেশতারা"],["لُوطًۭا","lūṭan","(to) Lut","লুতের কাছে"],["سِىٓءَ","sīa","he was distressed","সে মন খারাপ করলো"],["بِهِمْ","bihim","for them","ব্যাপারে তাদের"],["وَضَاقَ","waḍāqa","and felt straitened","ও সে অসমর্থ মনে করলো"],["بِهِمْ","bihim","for them","তাদের ব্যাপারে"],["ذَرْعًۭا","dhar‘an","(and) uneasy","রক্ষা করতে"],["وَقَالَ","waqāla","and said","এবং বললো"],["هَـٰذَا","hādhā","This","\"এই"],["يَوْمٌ","yawmun","(is) a day","দিন"],["عَصِيبٌۭ","‘aṣībun","distressful","ভয়ানক\""]],"t":"وَلَ<g>مَّ</>ا <o>جَآ</>ءَتْ رُسُلُنَا لُو<k>طًۭا سِ</><o>ىٓ</>ءَ بِهِمْ وَضَاقَ بِهِمْ ذَرْ<d>عًۭا وَ</>قَالَ <m>هَٰ</>ذَا يَوْمٌ عَ<p>صِي</><q>بٌۭ</>"},{"n":78,"w":[["وَجَآءَهُۥ","wajāahu","And came (to) him","এবং তার কাছে আসলো"],["قَوْمُهُۥ","qawmuhu","his people","তার (জাতির) লোকেরা"],["يُهْرَعُونَ","yuh'ra‘ūna","rushing","দ্রুত ছুটে"],["إِلَيْهِ","ilayhi","to him","তার দিকে"],["وَمِن","wamin","and before","এবং থেকে"],["قَبْلُ","qablu","and before","পূর্ব"],["كَانُوا۟","kānū","they (had) been","তারা ছিলো"],["يَعْمَلُونَ","ya‘malūna","doing","তারা কাজ করে"],["ٱلسَّيِّـَٔاتِ ۚ","l-sayiāti","the evil deeds","কুকর্ম (অর্থাৎ সমকামিতা)"],["قَالَ","qāla","He said","সে বললো"],["يَـٰقَوْمِ","yāqawmi","O my people","\"হে আমার সম্প্রদায়"],["هَـٰٓؤُلَآءِ","hāulāi","These","এরা"],["بَنَاتِى","banātī","(are) my daughters","আমার (জাতির) মেয়েরা (আছে)"],["هُنَّ","hunna","they","তারা"],["أَطْهَرُ","aṭharu","(are) purer","অধিক পবিত্র"],["لَكُمْ ۖ","lakum","for you","তোমাদের জন্যে"],["فَٱتَّقُوا۟","fa-ittaqū","So fear","অতএব তোমরা ভয় করো"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["وَلَا","walā","and (do) not","এবং না"],["تُخْزُونِ","tukh'zūni","disgrace me","আমাকে লজ্জিত করো"],["فِى","fī","concerning","ব্যাপারে"],["ضَيْفِىٓ ۖ","ḍayfī","my guests","আমার মেহমানের"],["أَلَيْسَ","alaysa","Is (there) not","নেই কি"],["مِنكُمْ","minkum","among you","তোমাদের মধ্যে"],["رَجُلٌۭ","rajulun","a man","কোন মানুষ"],["رَّشِيدٌۭ","rashīdun","right-minded","সবোধ\""]],"t":"وَ<o>جَآ</>ءَهُ<m>ۥ</> قَوْمُهُ<m>ۥ</> يُهْرَعُونَ إِلَيْهِ وَمِ<k>ن قَ</><q>بْ</>لُ كَانُو<s>ا۟</> يَعْمَلُونَ <h>ٱ</><l>ل</>سَّيِّـَٔاتِ ۚ قَالَ <m>يَٰ</>قَوْمِ <o>هَٰٓؤُلَآ</>ءِ بَنَاتِى هُ<g>نَّ</> أَ<q>طْ</>هَرُ لَكُمْ ۖ فَ<h>ٱ</>تَّقُو<s>ا۟</> <h>ٱ</>للَّهَ وَلَا تُخْزُونِ فِى ضَيْ<o>فِىٓ ۖ</> أَلَيْسَ مِ<k>نكُ</>مْ رَجُ<w>لٌۭ رَّ</><p>شِي</><q>دٌۭ</>"},{"n":79,"w":[["قَالُوا۟","qālū","They said","তারা বললো"],["لَقَدْ","laqad","Verily","\"নিশ্চয়ই অবশ্য"],["عَلِمْتَ","‘alim'ta","you know","তুমি জেনেছো"],["مَا","mā","(that) not","নেই"],["لَنَا","lanā","we have","আমাদের জন্যে"],["فِى","fī","concerning","ব্যাপারে"],["بَنَاتِكَ","banātika","your daughters","তোমার (জাতির) মেয়েদের"],["مِنْ","min","any","কোন"],["حَقٍّۢ","ḥaqqin","right","আগ্রহ"],["وَإِنَّكَ","wa-innaka","And indeed, you","এবং তুমি নিশ্চয়ই"],["لَتَعْلَمُ","lata‘lamu","surely know","অবশ্যই জানো"],["مَا","mā","what","কি"],["نُرِيدُ","nurīdu","we want","চাই আমরা\""]],"t":"قَالُو<s>ا۟</> لَقَ<q>دْ</> عَلِمْتَ مَا لَنَا فِى بَنَاتِكَ مِنْ حَ<d>قٍّۢ وَ</>إِ<g>نَّ</>كَ لَتَعْلَمُ مَا نُ<p>رِي</><q>دُ</>"},{"n":80,"w":[["قَالَ","qāla","He said","সে বললো"],["لَوْ","law","If","\"যদি"],["أَنَّ","anna","that","নিশ্চিত"],["لِى","lī","I had","আমার জন্যে"],["بِكُمْ","bikum","over you","তোমাদের উপর"],["قُوَّةً","quwwatan","power","কোন শক্তি"],["أَوْ","aw","or","অথবা"],["ءَاوِىٓ","āwī","I could take refuge","আমি আশ্রয় পেতাম"],["إِلَىٰ","ilā","in","কাছে"],["رُكْنٍۢ","ruk'nin","a support","কোন (আশ্রয়ের) স্তম্ভের"],["شَدِيدٍۢ","shadīdin","strong","শক্তিশালী\""]],"t":"قَالَ لَوْ أَ<g>نَّ</> لِى بِكُمْ قُوَّةً أَوْ ءَا<o>وِىٓ</> إِلَىٰ رُكْ<k>نٍۢ شَ</><p>دِي</><q>دٍۢ</>"},{"n":81,"w":[["قَالُوا۟","qālū","They said","(আগন্তুকরা) বললো"],["يَـٰلُوطُ","yālūṭu","O Lut","\"হে লুত"],["إِنَّا","innā","Indeed, we","নিশ্চয়ই আমরা"],["رُسُلُ","rusulu","(are) messengers","(সবাই) ফেরেশতা"],["رَبِّكَ","rabbika","(of) your Lord","তোমাদের রবের"],["لَن","lan","never","কখনও না"],["يَصِلُوٓا۟","yaṣilū","they will reach","তারা পৌঁছতে পারবে"],["إِلَيْكَ ۖ","ilayka","you","তোমার কাছে"],["فَأَسْرِ","fa-asri","So travel","অতএব তুমি বেরিয়ে পড়ো"],["بِأَهْلِكَ","bi-ahlika","with your family","নিয়ে তোমার পরিবার"],["بِقِطْعٍۢ","biqiṭ'‘in","in a part","এক অংশে"],["مِّنَ","mina","of","কোন"],["ٱلَّيْلِ","al-layli","the night","রাতের"],["وَلَا","walā","and (let) not","এবং না"],["يَلْتَفِتْ","yaltafit","look back","ফিরে তাকাবে"],["مِنكُمْ","minkum","anyone of you","তোমাদের মধ্যে"],["أَحَدٌ","aḥadun","anyone of you","কেউ"],["إِلَّا","illā","except","কিন্তু"],["ٱمْرَأَتَكَ ۖ","im'ra-ataka","your wife","তোমার স্ত্রী (সঙ্গে যাবে না)"],["إِنَّهُۥ","innahu","Indeed, it","তা নিশ্চয়ই (সিদ্ধান্ত)"],["مُصِيبُهَا","muṣībuhā","will strike her","তার পৌঁছবে (সেই শাস্তি)"],["مَآ","mā","what","যা"],["أَصَابَهُمْ ۚ","aṣābahum","will strike them","তাদের পৌঁছবে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["مَوْعِدَهُمُ","maw‘idahumu","their appointed time","তাদের নির্ধারিত সময়"],["ٱلصُّبْحُ ۚ","l-ṣub'ḥu","(is) morning","সকাল"],["أَلَيْسَ","alaysa","Is not","নয় কি"],["ٱلصُّبْحُ","l-ṣub'ḥu","the morning","সকাল"],["بِقَرِيبٍۢ","biqarībin","near","নিকটবর্তী\""]],"t":"قَالُو<s>ا۟</> <m>يَٰ</>لُوطُ إِ<g>نَّ</>ا رُسُلُ رَبِّكَ <d>لَن يَ</>صِ<o>لُوٓ</><s>ا۟</> إِلَيْكَ ۖ فَأَسْرِ بِأَهْلِكَ بِقِ<q>طْ</><d>عٍۢ مِّ</>نَ <h>ٱ</>لَّيْلِ وَلَا يَلْتَفِتْ مِ<k>نكُ</>مْ أَحَدٌ إِلَّا <h>ٱ</>مْرَأَتَكَ ۖ إِ<g>نَّ</>هُ<m>ۥ</> مُصِيبُهَا <o>مَآ</> أَصَابَهُمْ ۚ إِ<g>نَّ</> مَوْعِدَهُمُ <h>ٱ</><l>ل</>صُّ<q>بْ</>حُ ۚ أَلَيْسَ <h>ٱ</><l>ل</>صُّ<q>بْ</>حُ بِقَ<p>رِي</><q>بٍۢ</>"},{"n":82,"w":[["فَلَمَّا","falammā","So when","অতঃপর যখন"],["جَآءَ","jāa","came","আসলো"],["أَمْرُنَا","amrunā","Our Command","আমাদের নির্দে