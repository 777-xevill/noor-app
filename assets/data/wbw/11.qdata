{"n":11,"a":[{"n":1,"w":[["الٓر ۚ","alif-lam-ra","Alif Lam Ra","আলিফ-লাম-রা"],["كِتَـٰبٌ","kitābun","(This is) a Book","(এই) কিতাব"],["أُحْكِمَتْ","uḥ'kimat","are perfected","সুপ্রতিষ্ঠিত করা হয়েছে"],["ءَايَـٰتُهُۥ","āyātuhu","its Verses","তার আয়াতসমূহ"],["ثُمَّ","thumma","moreover","এরপর"],["فُصِّلَتْ","fuṣṣilat","explained in detail","বিশদভাবে বর্ণিত"],["مِن","min","from (he One Who)","থেকে"],["لَّدُنْ","ladun","from (he One Who)","পক্ষ"],["حَكِيمٍ","ḥakīmin","(is) All-Wise","(এমন সত্ত্বার যিনি) প্রজ্ঞাময়"],["خَبِيرٍ","khabīrin","All-Aware","সর্বজ্ঞ"]],"t":"ا<n>لٓ</>ر ۚ كِ<m>تَٰ</>بٌ أُحْكِمَتْ ءَا<m>يَٰ</>تُهُ<m>ۥ</> ثُ<g>مَّ</> فُصِّلَتْ <w>مِن لَّ</>دُنْ حَكِيمٍ خَ<p>بِي</>رٍ"},{"n":2,"w":[["أَلَّا","allā","That \"Not","(হুকুম হলো) না যে"],["تَعْبُدُوٓا۟","ta‘budū","you worship","তোমরা উপাসনা করো"],["إِلَّا","illā","but","ছাড়া"],["ٱللَّهَ ۚ","l-laha","Allah","আল্লাহ"],["إِنَّنِى","innanī","Indeed, I am","নিশ্চয়ই আমি"],["لَكُم","lakum","to you","তোমাদের জন্য"],["مِّنْهُ","min'hu","from Him","তাঁরই পক্ষ হ'তে"],["نَذِيرٌۭ","nadhīrun","a warner","সতর্ককারী"],["وَبَشِيرٌۭ","wabashīrun","and a bearer of glad tidings","ও সুসংবাদ বাহক\""]],"t":"أَلَّا تَعْبُ<o>دُوٓ</><s>ا۟</> إِلَّا <h>ٱ</>للَّهَ ۚ إِ<g>نَّ</>نِى لَ<y>كُم مِّ</>نْهُ نَذِي<d>رٌۭ وَ</>بَ<p>شِي</>رٌۭ"},{"n":3,"w":[["وَأَنِ","wa-ani","And that","এবং (এও) যে"],["ٱسْتَغْفِرُوا۟","is'taghfirū","Seek forgiveness","\"তোমরা ক্ষমা চাও"],["رَبَّكُمْ","rabbakum","(of) your Lord","তোমাদের রবের (কাছে)"],["ثُمَّ","thumma","and","এরপর"],["تُوبُوٓا۟","tūbū","turn in repentance","ফিরে আসো তোমরা"],["إِلَيْهِ","ilayhi","to Him","তাঁরই দিকে"],["يُمَتِّعْكُم","yumatti‘'kum","He will let you","তিনি তোমাদের উপভোগ করতে দিবেন"],["مَّتَـٰعًا","matā‘an","enjoy","জীবন সামগ্রী"],["حَسَنًا","ḥasanan","a good","উত্তম"],["إِلَىٰٓ","ilā","for","পর্যন্ত"],["أَجَلٍۢ","ajalin","a term","একটি কাল"],["مُّسَمًّۭى","musamman","appointed","নির্দিষ্ট"],["وَيُؤْتِ","wayu'ti","And give","ও দিবেন"],["كُلَّ","kulla","(to) every","প্রত্যেক"],["ذِى","dhī","owner","যোগ্য (ব্যক্তিকে)"],["فَضْلٍۢ","faḍlin","(of) grace","অনুগ্রহ পাওয়ার"],["فَضْلَهُۥ ۖ","faḍlahu","His Grace","তাঁর অনুগ্রহ"],["وَإِن","wa-in","But if","কিন্তু যদি"],["تَوَلَّوْا۟","tawallaw","you turn away","তোমরা মুখ ফিরিয়ে নাও"],["فَإِنِّىٓ","fa-innī","then indeed, I","তবে নিশ্চয়ই আমি"],["أَخَافُ","akhāfu","fear","আমি আশঙ্কা করছি"],["عَلَيْكُمْ","‘alaykum","for you","তোমাদের উপর"],["عَذَابَ","‘adhāba","(the) punishment","শাস্তির"],["يَوْمٍۢ","yawmin","(of) a Great Day","দিনের"],["كَبِيرٍ","kabīrin","(of) a Great Day","মহা"]],"t":"وَأَنِ <h>ٱ</>سْتَغْفِرُو<s>ا۟</> رَبَّكُمْ ثُ<g>مَّ</> تُو<o>بُوٓ</><s>ا۟</> إِلَيْهِ يُمَتِّعْ<y>كُم مَّ</><m>تَٰ</>عًا حَسَنًا إِلَ<o>ىٰٓ</> أَجَ<d>لٍۢ مُّسَمًّۭى وَ</>يُؤْتِ كُلَّ ذِى فَضْ<k>لٍۢ فَ</>ضْلَهُ<m>ۥ</> ۖ وَإِ<k>ن تَ</>وَلَّوْ<s>ا۟</> فَإِ<g>نِّ</><o>ىٓ</> أَخَافُ عَلَيْكُمْ عَذَابَ يَوْ<k>مٍۢ كَ</><p>بِي</>رٍ"},{"n":4,"w":[["إِلَى","ilā","To","দিকে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহরই"],["مَرْجِعُكُمْ ۖ","marji‘ukum","(is) your return","তোমাদের প্রত্যাবর্তন (হবে)"],["وَهُوَ","wahuwa","and He","এবং তিনি"],["عَلَىٰ","‘alā","(is) on","উপর"],["كُلِّ","kulli","every","সব"],["شَىْءٍۢ","shayin","thing","কিছুরই"],["قَدِيرٌ","qadīrun","All-Powerful","সর্বশক্তিমান\""]],"t":"إِلَى <h>ٱ</>للَّهِ مَرْجِعُكُمْ ۖ وَهُوَ عَلَىٰ كُلِّ <k>شَىْءٍۢ قَ</><p>دِي</>رٌ"},{"n":5,"w":[["أَلَآ","alā","No doubt","জেনে রাখো (লক্ষ্য করো)"],["إِنَّهُمْ","innahum","They","তারা নিশ্চয়ই"],["يَثْنُونَ","yathnūna","fold up","দু-ভাঁজ করে"],["صُدُورَهُمْ","ṣudūrahum","their breasts","তাদের অন্তরগুলোকে"],["لِيَسْتَخْفُوا۟","liyastakhfū","that they may hide","গোপন রাখার জন্যে (তাদের বিদ্বেষ)"],["مِنْهُ ۚ","min'hu","from Him","তাঁর থেকে"],["أَلَا","alā","Surely","জেনে রাখো"],["حِينَ","ḥīna","when","যখন"],["يَسْتَغْشُونَ","yastaghshūna","they cover (themselves)","তারা ঢেকে রাখে (নিজেদেরকে)"],["ثِيَابَهُمْ","thiyābahum","(with) their garments","তাদের কাপড় (দিয়ে)"],["يَعْلَمُ","ya‘lamu","He knows","(তখনও) তিনি জানেন"],["مَا","mā","what","যা"],["يُسِرُّونَ","yusirrūna","they conceal","তারা গোপন করে"],["وَمَا","wamā","and what","আর যা"],["يُعْلِنُونَ ۚ","yu‘'linūna","they reveal","তারা প্রকাশ করে"],["إِنَّهُۥ","innahu","Indeed, He","নিশ্চয়ই তিনি"],["عَلِيمٌۢ","‘alīmun","(is) All-Knower","সবিশেষ অবহিত"],["بِذَاتِ","bidhāti","of what","সম্পর্কে অবস্থা"],["ٱلصُّدُورِ","l-ṣudūri","(is in) the breasts","অন্তরসমূহের"]],"t":"أَ<o>لَآ</> إِ<g>نَّ</>هُمْ يَثْنُونَ صُدُورَهُمْ لِيَسْتَخْفُو<s>ا۟</> مِنْهُ ۚ أَلَا حِينَ يَسْتَغْشُونَ ثِيَابَهُمْ يَعْلَمُ مَا يُسِرُّونَ وَمَا يُعْلِنُونَ ۚ إِ<g>نَّ</>هُ<m>ۥ</> عَلِي<i>مٌۢ بِ</>ذَاتِ <h>ٱ</><l>ل</>صُّ<p>دُو</>رِ"},{"n":6,"w":[["۞ وَمَا","wamā","And not","এবং নেই"],["مِن","min","any","(এমন) কোন"],["دَآبَّةٍۢ","dābbatin","moving creature","বিচরণশীল জীব"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["إِلَّا","illā","but","এছাড়া"],["عَلَى","‘alā","on","উপর"],["ٱللَّهِ","l-lahi","Allah","আল্লাহরই"],["رِزْقُهَا","riz'quhā","(is) its provision","তার জীবিকার (দায়িত্ব)"],["وَيَعْلَمُ","waya‘lamu","And He knows","এবং তিনি জানেন"],["مُسْتَقَرَّهَا","mus'taqarrahā","its dwelling place","তার স্থায়ী অবস্থান"],["وَمُسْتَوْدَعَهَا ۚ","wamus'tawda‘ahā","and its place of storage","ও তার অস্থায়ী অবস্থান"],["كُلٌّۭ","kullun","All","সবই"],["فِى","fī","(is) in","মধ্যে (আছে)"],["كِتَـٰبٍۢ","kitābin","a Record","এক কিতাবের"],["مُّبِينٍۢ","mubīnin","clear","সুস্পষ্ট (লিখিত)"]],"t":"۞ وَمَا مِ<k>ن دَ</><n>آ</>بَّ<k>ةٍۢ فِ</>ى <h>ٱ</>لْأَرْضِ إِلَّا عَلَى <h>ٱ</>للَّهِ رِزْقُهَا وَيَعْلَمُ مُسْتَقَرَّهَا وَمُسْتَوْدَعَهَا ۚ كُ<k>لٌّۭ فِ</>ى كِ<m>تَٰ</><d>بٍۢ مُّ</><p>بِي</>نٍۢ"},{"n":7,"w":[["وَهُوَ","wahuwa","And He","এবং তিনিই (আল্লাহ)"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["خَلَقَ","khalaqa","created","সৃষ্টি করেছেন"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশ"],["وَٱلْأَرْضَ","wal-arḍa","and the earth","ও পৃথিবী"],["فِى","fī","in","মধ্যে"],["سِتَّةِ","sittati","six","ছয়"],["أَيَّامٍۢ","ayyāmin","epochs","দিনে"],["وَكَانَ","wakāna","and His throne was","এবং (এর পূর্বে) ছিলো"],["عَرْشُهُۥ","‘arshuhu","and His throne was","তাঁর আরশ"],["عَلَى","‘alā","on","উপর"],["ٱلْمَآءِ","l-māi","the water","পানির"],["لِيَبْلُوَكُمْ","liyabluwakum","that He might test [you]","যেন তিনি তোমাদের পরীক্ষা করতে পারেন"],["أَيُّكُمْ","ayyukum","which of you","তোমাদের মধ্যে কে"],["أَحْسَنُ","aḥsanu","(is) best","উত্তম"],["عَمَلًۭا ۗ","‘amalan","(in) deed","কাজকর্মে"],["وَلَئِن","wala-in","But if","এবং অবশ্যই যদি"],["قُلْتَ","qul'ta","you say","তুমি বলো"],["إِنَّكُم","innakum","Indeed, you","\"নিশ্চয়ই তোমরা"],["مَّبْعُوثُونَ","mab‘ūthūna","(will be) resurrected","উত্থিত হবে"],["مِنۢ","min","after","থেকে"],["بَعْدِ","ba‘di","after","পরে"],["ٱلْمَوْتِ","l-mawti","[the] death","মৃত্যুর\""],["لَيَقُولَنَّ","layaqūlanna","surely would say","অবশ্যই তারা বলবে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوٓا۟","kafarū","disbelieved","অস্বীকার করেছে"],["إِنْ","in","This is not","\"নয়"],["هَـٰذَآ","hādhā","This is not","\"এটা"],["إِلَّا","illā","but","এছাড়া"],["سِحْرٌۭ","siḥ'run","a magic","জাদু"],["مُّبِينٌۭ","mubīnun","clear","সুস্পষ্ট\""]],"t":"وَهُوَ <h>ٱ</>لَّذِى خَلَقَ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضَ فِى سِتَّةِ أَيَّا<d>مٍۢ وَ</>كَانَ عَرْشُهُ<m>ۥ</> عَلَى <h>ٱ</>لْ<o>مَآ</>ءِ لِيَ<q>بْ</>لُوَكُمْ أَيُّكُمْ أَحْسَنُ عَمَلًۭ<d>ا ۗ وَ</>لَئِ<k>ن قُ</>لْتَ إِ<g>نَّ</><y>كُم مَّ</><q>بْ</>عُوثُونَ <i>مِنۢ بَ</>عْدِ <h>ٱ</>لْمَوْتِ لَيَقُولَ<g>نَّ</> <h>ٱ</>لَّذِينَ كَفَ<o>رُوٓ</><s>ا۟</> إِنْ <m>هَٰ</><o>ذَآ</> إِلَّا سِحْ<d>رٌۭ مُّ</><p>بِي</>نٌۭ"},{"n":8,"w":[["وَلَئِنْ","wala-in","And if","এবং অবশ্যই যদি"],["أَخَّرْنَا","akharnā","We delay","আমরা স্হগিত রাখি"],["عَنْهُمُ","‘anhumu","from them","তাদের থেকে"],["ٱلْعَذَابَ","l-‘adhāba","the punishment","শাস্তি"],["إِلَىٰٓ","ilā","for","পর্যন্ত"],["أُمَّةٍۢ","ummatin","a time","একটি সময়"],["مَّعْدُودَةٍۢ","ma‘dūdatin","determined","নির্দিষ্ট"],["لَّيَقُولُنَّ","layaqūlunna","they will surely say","(তবে) অবশ্যই তারা বলবে"],["مَا","mā","What","\"কিসে"],["يَحْبِسُهُۥٓ ۗ","yaḥbisuhu","detains it","তা আটকে রেখেছে\""],["أَلَا","alā","No doubt","সাবধান"],["يَوْمَ","yawma","(On) the Day","যেদিন"],["يَأْتِيهِمْ","yatīhim","it comes to them","তাদের কাছে আসবে (তা)"],["لَيْسَ","laysa","not","না"],["مَصْرُوفًا","maṣrūfan","(will be) averted","ফিরানো যায়"],["عَنْهُمْ","‘anhum","from them","থেকে তাদের (সেই শাস্তি)"],["وَحَاقَ","waḥāqa","and will surround","এবং ঘিরে রাখবে"],["بِهِم","bihim","them","তাদেরকে"],["مَّا","mā","what","যা"],["كَانُوا۟","kānū","they used (to)","তারা ছিলো"],["بِهِۦ","bihi","mock at [it]","সম্বন্ধে সে"],["يَسْتَهْزِءُونَ","yastahziūna","mock at [it]","ঠাট্টা তামাশা করতো"]],"t":"وَلَئِنْ أَخَّرْنَا عَنْهُمُ <h>ٱ</>لْعَذَابَ إِلَ<o>ىٰٓ</> أُ<g>مَّ</><d>ةٍۢ مَّ</>عْدُودَ<w>ةٍۢ لَّ</>يَقُولُ<g>نَّ</> مَا يَحْبِسُهُ<o>ۥٓ ۗ</> أَلَا يَوْمَ يَأْتِيهِمْ لَيْسَ مَصْرُوفًا عَنْهُمْ وَحَاقَ بِ<y>هِم مَّ</>ا كَانُو<s>ا۟</> بِ<m>هِۦ</> يَسْتَهْزِ<p>ءُو</>نَ"},{"n":9,"w":[["وَلَئِنْ","wala-in","And if","এবং অবশ্যই যদি"],["أَذَقْنَا","adhaqnā","We give man a taste","আমরা আস্বাদন করাই"],["ٱلْإِنسَـٰنَ","l-insāna","We give man a taste","মানুষকে"],["مِنَّا","minnā","(of) Mercy from Us","আমাদের পক্ষ থেকে"],["رَحْمَةًۭ","raḥmatan","(of) Mercy from Us","কোন অনুগ্রহ"],["ثُمَّ","thumma","then","এরপর"],["نَزَعْنَـٰهَا","naza‘nāhā","We withdraw it","তা আমরা ছিনিয়ে নিই"],["مِنْهُ","min'hu","from him","তার থেকে"],["إِنَّهُۥ","innahu","indeed, he","(তবে) সে নিশ্চয়ই"],["لَيَـُٔوسٌۭ","layaūsun","(is) despairing","অবশ্যই হতাশ হয়"],["كَفُورٌۭ","kafūrun","(and) ungrateful","অকৃতজ্ঞ (হয়)"]],"t":"وَلَئِنْ أَذَ<q>قْ</>نَا <h>ٱ</>لْإِ<k>نسَٰ</>نَ مِ<g>نَّ</>ا رَحْمَ<k>ةًۭ ثُ</><g>مَّ</> نَزَعْ<m>نَٰ</>هَا مِنْهُ إِ<g>نَّ</>هُ<m>ۥ</> لَيَـُٔو<k>سٌۭ كَ</><p>فُو</>رٌۭ"},{"n":10,"w":[["وَلَئِنْ","wala-in","But if","এবং অবশ্যই যদি"],["أَذَقْنَـٰهُ","adhaqnāhu","We give him a taste","তাকে আমরা আস্বাদন করাই"],["نَعْمَآءَ","na‘māa","(of) favor","অনুগ্রহসমূহ"],["بَعْدَ","ba‘da","after","পরে"],["ضَرَّآءَ","ḍarrāa","hardship","দুঃখ-কষ্টের (যা)"],["مَسَّتْهُ","massathu","(has) touched him","তাকে স্পর্শ করেছিলো"],["لَيَقُولَنَّ","layaqūlanna","surely, he will say","অবশ্যই তারা বলবেই"],["ذَهَبَ","dhahaba","Have gone","\"কেটে গেছে"],["ٱلسَّيِّـَٔاتُ","l-sayiātu","the evils","বিপদ আপদ"],["عَنِّىٓ ۚ","‘annī","from me","আমার থেকে"],["إِنَّهُۥ","innahu","Indeed, he","নিশ্চয়ই সে"],["لَفَرِحٌۭ","lafariḥun","(is) exultant","অবশ্যই উল্লাসে ফেটে পড়ে"],["فَخُورٌ","fakhūrun","(and) boastful","অহংকারী (হয়ে উঠে)"]],"t":"وَلَئِنْ أَذَ<q>قْ</><m>نَٰ</>هُ نَعْ<o>مَآ</>ءَ بَعْدَ ضَ<o>رَّآ</>ءَ مَسَّتْهُ لَيَقُولَ<g>نَّ</> ذَهَبَ <h>ٱ</><l>ل</>سَّيِّـَٔاتُ عَ<g>نِّ</><o>ىٓ ۚ</> إِ<g>نَّ</>هُ<m>ۥ</> لَفَرِ<k>حٌۭ فَ</><p>خُو</>رٌ"},{"n":11,"w":[["إِلَّا","illā","Except","কিন্তু (ব্যতিক্রম)"],["ٱلَّذِينَ","alladhīna","those who","(তারা) যারা"],["صَبَرُوا۟","ṣabarū","(are) patient","ধৈর্য ধরেছে"],["وَعَمِلُوا۟","wa‘amilū","and do","ও কাজ করেছে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","the good deeds","সৎ"],["أُو۟لَـٰٓئِكَ","ulāika","those","ঐসব লোক"],["لَهُم","lahum","for them","তাদের জন্যে (রয়েছে)"],["مَّغْفِرَةٌۭ","maghfiratun","(will be) forgiveness","ক্ষমা"],["وَأَجْرٌۭ","wa-ajrun","and a reward","ও পুরস্কার"],["كَبِيرٌۭ","kabīrun","great","মহা"]],"t":"إِلَّا <h>ٱ</>لَّذِينَ صَبَرُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ أُ<s>و۟</><o>لَٰٓ</>ئِكَ لَ<y>هُم مَّ</>غْفِرَ<d>ةٌۭ وَ</>أَ<q>جْ</><k>رٌۭ كَ</><p>بِي</>رٌۭ"},{"n":12,"w":[["فَلَعَلَّكَ","fala‘allaka","Then possibly you","তবে যেন তুমি (না)"],["تَارِكٌۢ","tārikun","(may) give up","পরিত্যাগকারী (হয়ো)"],["بَعْضَ","ba‘ḍa","a part","কিছু অংশ"],["مَا","mā","(of) what","(তার) যা"],["يُوحَىٰٓ","yūḥā","is revealed","ওহী করা হয়েছে"],["إِلَيْكَ","ilayka","to you","তোমার প্রতি"],["وَضَآئِقٌۢ","waḍāiqun","and straitened","এবং (যেন না) সংকুচিত করো"],["بِهِۦ","bihi","by it","সম্পর্কে সে"],["صَدْرُكَ","ṣadruka","your breast","তোমার মন"],["أَن","an","because","(এজন্যে) যে"],["يَقُولُوا۟","yaqūlū","they say","তারা বলে"],["لَوْلَآ","lawlā","Why not","\"কেন না"],["أُنزِلَ","unzila","is sent down","অবতীর্ণ করা হলো"],["عَلَيْهِ","‘alayhi","for him","তার উপর"],["كَنزٌ","kanzun","a treasure","ধন ভান্ডার"],["أَوْ","aw","or","অথবা"],["جَآءَ","jāa","has come","(কেন না) আসে"],["مَعَهُۥ","ma‘ahu","with him","তার সাথে"],["مَلَكٌ ۚ","malakun","an Angel","কোন ফেরেশতা\""],["إِنَّمَآ","innamā","Only","মূলতঃ"],["أَنتَ","anta","you","তুমি"],["نَذِيرٌۭ ۚ","nadhīrun","(are) a warner","একজন সতর্ককারী (মাত্র)"],["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ"],["عَلَىٰ","‘alā","(is) on","উপর"],["كُلِّ","kulli","every","সব"],["شَىْءٍۢ","shayin","thing","কিছুর"],["وَكِيلٌ","wakīlun","a Guardian","কর্ম বিধায়ক"]],"t":"فَلَعَلَّكَ تَارِ<i>كٌۢ بَ</>عْضَ مَا يُوحَ<o>ىٰٓ</> إِلَيْكَ وَ<o>ضَآ</>ئِ<i>قٌۢ بِ</><m>هِۦ</> صَ<q>دْ</>رُكَ <d>أَن يَ</>قُولُو<s>ا۟</> لَوْ<o>لَآ</> أُ<k>نزِ</>لَ عَلَيْهِ كَ<k>نزٌ</> أَوْ <o>جَآ</>ءَ مَعَهُ<m>ۥ</> مَلَكٌ ۚ إِ<g>نَّ</><o>مَآ</> أَ<k>نتَ</> نَذِي<d>رٌۭ ۚ وَ</><h>ٱ</>للَّهُ عَلَىٰ كُلِّ <d>شَىْءٍۢ وَ</><p>كِي</>لٌ"},{"n":13,"w":[["أَمْ","am","Or","অথবা"],["يَقُولُونَ","yaqūlūna","they say","তারা বলে"],["افْتَرَاهُ ۖ","if'tarāhu","He has fabricated it","\"তা সে রচনা করেছে\""],["قُلْ","qul","Say","বলো"],["فَأْتُوا۟","fatū","Then bring","\"তবে তোমরা আনো"],["بِعَشْرِ","bi‘ashri","ten","নিয়ে দশটি"],["سُوَرٍۢ","suwarin","Surahs","সূরা"],["مِّثْلِهِۦ","mith'lihi","like it","তার মতো"],["مُفْتَرَيَـٰتٍۢ","muf'tarayātin","fabricated","স্বরচিত"],["وَٱدْعُوا۟","wa-id'‘ū","and call","এবং তোমরা ডাকো"],["مَنِ","mani","whoever","যাকে"],["ٱسْتَطَعْتُم","is'taṭa‘tum","you can","তোমরা পারো"],["مِّن","min","besides Allah","মধ্য হতে"],["دُونِ","dūni","besides Allah","ছাড়া"],["ٱللَّهِ","l-lahi","besides Allah","আল্লাহ"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you are","তোমরা হও"],["صَـٰدِقِينَ","ṣādiqīna","truthful","সত্যবাদী\""]],"t":"أَمْ يَقُولُونَ <h>ٱ</>فْتَرَ<m>ىٰ</>هُ ۖ قُلْ فَأْتُو<s>ا۟</> بِعَشْرِ سُوَ<d>رٍۢ مِّ</>ثْلِ<m>هِۦ</> مُفْتَرَ<m>يَٰ</><d>تٍۢ وَ</><h>ٱ</><q>دْ</>عُو<s>ا۟</> مَنِ <h>ٱ</>سْتَطَعْ<y>تُم مِّ</><k>ن دُ</>ونِ <h>ٱ</>للَّهِ إِ<k>ن كُنتُ</>مْ <m>صَٰ</>دِ<p>قِي</>نَ"},{"n":14,"w":[["فَإِلَّمْ","fa-illam","Then if not","অতঃপর যদি না"],["يَسْتَجِيبُوا۟","yastajībū","they respond","তারা ডাকে সাড়া দেয়"],["لَكُمْ","lakum","to you","তোমাদের"],["فَٱعْلَمُوٓا۟","fa-i‘'lamū","then know","তবে তোমরা জেনে রাখো"],["أَنَّمَآ","annamā","that","মূলতঃ"],["أُنزِلَ","unzila","it was sent down","অবতীর্ণ করা হয়েছে (এই কিতাব)"],["بِعِلْمِ","bi‘il'mi","with the knowledge of Allah","অনুসারে জ্ঞান"],["ٱللَّهِ","l-lahi","with the knowledge of Allah","আল্লাহর"],["وَأَن","wa-an","and that","এবং (এও) যে"],["لَّآ","lā","(there is) no","নেই"],["إِلَـٰهَ","ilāha","god","কোন ইলাহ"],["إِلَّا","illā","except","ছাড়া"],["هُوَ ۖ","huwa","Him","তিনি"],["فَهَلْ","fahal","Then, would","তবুও কি (না)"],["أَنتُم","antum","you","তোমরা"],["مُّسْلِمُونَ","mus'limūna","(be) Muslims","আত্মসমর্পণকারী (অর্থাৎ মুসলিম হবে)"]],"t":"فَإِلَّمْ يَسْتَجِيبُو<s>ا۟</> لَكُمْ فَ<h>ٱ</>عْلَ<o>مُوٓ</><s>ا۟</> أَ<g>نَّ</><o>مَآ</> أُ<k>نزِ</>لَ بِعِلْمِ <h>ٱ</>للَّهِ وَ<w>أَن لَّ</><o>آ</> إِ<m>لَٰ</>هَ إِلَّا هُوَ ۖ فَهَلْ أَ<k>نتُ</><y>م مُّ</>سْلِ<p>مُو</>نَ"},{"n":15,"w":[["مَن","man","Whoever [is]","যে"],["كَانَ","kāna","Whoever [is]","কেউ"],["يُرِيدُ","yurīdu","desires","কামনা করে"],["ٱلْحَيَوٰةَ","l-ḥayata","the life","জীবন"],["ٱلدُّنْيَا","l-dun'yā","(of) the world","পার্থিব"],["وَزِينَتَهَا","wazīnatahā","and its adornments","ও তার শোভা-সৌন্দর্য"],["نُوَفِّ","nuwaffi","We will repay in full","পূর্ণ ফল দিবো আমরা"],["إِلَيْهِمْ","ilayhim","to them","তাদেরকে"],["أَعْمَـٰلَهُمْ","a‘mālahum","(for) their deeds","তাদের কাজকর্মের"],["فِيهَا","fīhā","therein","তার মধ্যে (অর্থাৎ পৃথিবীতে)"],["وَهُمْ","wahum","and they","এবং তাদেরকে"],["فِيهَا","fīhā","in it","তার মধ্যে"],["لَا","lā","will not be lessened","না"],["يُبْخَسُونَ","yub'khasūna","will not be lessened","কম দেয়া হবে"]],"t":"مَ<k>ن كَ</>انَ يُرِيدُ <h>ٱ</>لْحَيَ<s>وٰ</>ةَ <h>ٱ</><l>ل</>دُّنْيَا وَزِينَتَهَا نُوَفِّ إِلَيْهِمْ أَعْ<m>مَٰ</>لَهُمْ فِيهَا وَهُمْ فِيهَا لَا يُ<q>بْ</>خَ<p>سُو</>نَ"},{"n":16,"w":[["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব লোক"],["ٱلَّذِينَ","alladhīna","(are) the ones who ","(তারাই) যারা"],["لَيْسَ","laysa","(is) not","নেই"],["لَهُمْ","lahum","for them","তাদের জন্যে"],["فِى","fī","in","মধ্যে"],["ٱلْـَٔاخِرَةِ","l-ākhirati","the Hereafter","পরকালের"],["إِلَّا","illā","except","এছাড়া"],["ٱلنَّارُ ۖ","l-nāru","the Fire","(জাহান্নামের) আগুন"],["وَحَبِطَ","waḥabiṭa","And (has) gone in vain","এবং পন্ড হয়েছে"],["مَا","mā","what","যা"],["صَنَعُوا۟","ṣana‘ū","they did","তারা করেছে"],["فِيهَا","fīhā","therein","তার মধ্যে"],["وَبَـٰطِلٌۭ","wabāṭilun","and (is) worthless","ও অর্থহীন গণ্য হয়েছে"],["مَّا","mā","what","যা"],["كَانُوا۟","kānū","they used (to)","তারা ছিলো"],["يَعْمَلُونَ","ya‘malūna","do","কাজকর্ম করে"]],"t":"أُ<s>و۟</><o>لَٰٓ</>ئِكَ <h>ٱ</>لَّذِينَ لَيْسَ لَهُمْ فِى <h>ٱ</>لْءَاخِرَةِ إِلَّا <h>ٱ</><l>ل</><g>نَّ</>ارُ ۖ وَحَبِطَ مَا صَنَعُو<s>ا۟</> فِيهَا وَ<m>بَٰ</>طِ<d>لٌۭ مَّ</>ا كَانُو<s>ا۟</> يَعْمَ<p>لُو</>نَ"},{"n":17,"w":[["أَفَمَن","afaman","Then is he who","তবে কি যে"],["كَانَ","kāna","is","হয় (প্রতিষ্ঠিত)"],["عَلَىٰ","‘alā","on","উপর"],["بَيِّنَةٍۢ","bayyinatin","a clear proof","সুস্পষ্ট প্রমাণের"],["مِّن","min","from","পক্ষ হ'তে"],["رَّبِّهِۦ","rabbihi","his Lord","তার রবের"],["وَيَتْلُوهُ","wayatlūhu","and recites it","ও তার অনুসরণ করে"],["شَاهِدٌۭ","shāhidun","a witness","এক সাক্ষী (কুরআন)"],["مِّنْهُ","min'hu","from Him","তাঁর পক্ষ হ'তে"],["وَمِن","wamin","and before it","এবং পূর্বেও"],["قَبْلِهِۦ","qablihi","and before it","তার (এসেছে)"],["كِتَـٰبُ","kitābu","(was) a Book","কিতাব"],["مُوسَىٰٓ","mūsā","(of) Musa","মূসার (সাক্ষী হিসেবে)"],["إِمَامًۭا","imāman","(as) a guide","যা পথপ্রদর্শক"],["وَرَحْمَةً ۚ","waraḥmatan","and (as) mercy","ও অনুগ্রহস্বরূপ"],["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐ সব লোক"],["يُؤْمِنُونَ","yu'minūna","believe","ঈমান আনে"],["بِهِۦ ۚ","bihi","in it","প্রতি তার"],["وَمَن","waman","But whoever","আর যে"],["يَكْفُرْ","yakfur","disbelieves","অস্বীকার করে"],["بِهِۦ","bihi","in it","তাকে"],["مِنَ","mina","among","মধ্যে হ'তে"],["ٱلْأَحْزَابِ","l-aḥzābi","the sects","অন্যান্য দলের"],["فَٱلنَّارُ","fal-nāru","then the Fire","তবে আগুন"],["مَوْعِدُهُۥ ۚ","maw‘iduhu","(will be) his promised (meeting) place","তার প্রতিশ্রুত স্থান"],["فَلَا","falā","So (do) not","সুতরাং না"],["تَكُ","taku","be","তুমি হয়ো"],["فِى","fī","in","মধ্যে"],["مِرْيَةٍۢ","mir'yatin","doubt","সন্দেহের"],["مِّنْهُ ۚ","min'hu","about it","তা হ'তে"],["إِنَّهُ","innahu","Indeed, it","নিশ্চয়ই তা"],["ٱلْحَقُّ","l-ḥaqu","(is) the truth","প্রকৃত সত্য"],["مِن","min","from","পক্ষ হ'তে"],["رَّبِّكَ","rabbika","your Lord","তোমার রবের"],["وَلَـٰكِنَّ","walākinna","but","কিন্তু"],["أَكْثَرَ","akthara","most","অধিকাংশ"],["ٱلنَّاسِ","l-nāsi","(of) the people","মানুষ"],["لَا","lā","(do) not","না"],["يُؤْمِنُونَ","yu'minūna","believe","তারা বিশ্বাস করে"]],"t":"أَفَمَ<k>ن كَ</>انَ عَلَىٰ بَيِّنَ<d>ةٍۢ مِّ</><w>ن رَّ</>بِّ<m>هِۦ</> وَيَتْلُوهُ شَاهِ<d>دٌۭ مِّ</>نْهُ وَمِ<k>ن قَ</><q>بْ</>لِ<m>هِۦ</> كِ<m>تَٰ</>بُ مُوسَ<o>ىٰٓ</> إِمَا<d>مًۭا وَ</>رَحْمَةً ۚ أُ<s>و۟</><o>لَٰٓ</>ئِكَ يُؤْمِنُونَ بِ<m>هِۦ</> ۚ وَ<d>مَن يَ</>كْفُرْ بِ<m>هِۦ</> مِنَ <h>ٱ</>لْأَحْزَابِ فَ<h>ٱ</><l>ل</><g>نَّ</>ارُ مَوْعِدُهُ<m>ۥ</> ۚ فَلَا تَكُ فِى مِرْيَ<d>ةٍۢ مِّ</>نْهُ ۚ إِ<g>نَّ</>هُ <h>ٱ</>لْحَقُّ <w>مِن رَّ</>بِّكَ وَ<m>لَٰ</>كِ<g>نَّ</> أَكْثَرَ <h>ٱ</><l>ل</><g>نَّ</>اسِ لَا يُؤْمِ<p>نُو</>نَ"},{"n":18,"w":[["وَمَنْ","waman","And who","এবং কে"],["أَظْلَمُ","aẓlamu","(is) more unjust","বড় সীমালঙ্ঘনকারী (হ'তে পারে)"],["مِمَّنِ","mimmani","than (he) who","তার চেয়ে যে"],["ٱفْتَرَىٰ","if'tarā","invents","রচনা করে"],["عَلَى","‘alā","against","সম্বন্ধে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর"],["كَذِبًا ۚ","kadhiban","a lie","মিথ্যা"],["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব লোককে"],["يُعْرَضُونَ","yu‘'raḍūna","will be presented","উপস্হিত করা হবে"],["عَلَىٰ","‘alā","before","কাছে"],["رَبِّهِمْ","rabbihim","their Lord","তাদের রবের"],["وَيَقُولُ","wayaqūlu","and will say","এবং বলবে"],["ٱلْأَشْهَـٰدُ","l-ashhādu","the witnesses","সাক্ষীরা"],["هَـٰٓؤُلَآءِ","hāulāi","These (are)","\"এসব লোকই"],["ٱلَّذِينَ","alladhīna","those who","(তারা) যারা"],["كَذَبُوا۟","kadhabū","lied","মিথ্যা বলেছে"],["عَلَىٰ","‘alā","against","বিরুদ্ধে"],["رَبِّهِمْ ۚ","rabbihim","their Lord","তাদের রবের\""],["أَلَا","alā","No doubt","সাবধান"],["لَعْنَةُ","la‘natu","(The) curse of Allah","অভিশাপ"],["ٱللَّهِ","l-lahi","(The) curse of Allah","আল্লাহর"],["عَلَى","‘alā","(is) on","উপর"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","(সেই) সীমালঙ্ঘনকারীদের"]],"t":"وَمَنْ أَظْلَمُ مِ<g>مَّ</>نِ <h>ٱ</>فْتَرَىٰ عَلَى <h>ٱ</>للَّهِ كَذِبًا ۚ أُ<s>و۟</><o>لَٰٓ</>ئِكَ يُعْرَضُونَ عَلَىٰ رَبِّهِمْ وَيَقُولُ <h>ٱ</>لْأَشْ<m>هَٰ</>دُ <o>هَٰٓؤُلَآ</>ءِ <h>ٱ</>لَّذِينَ كَذَبُو<s>ا۟</> عَلَىٰ رَبِّهِمْ ۚ أَلَا لَعْنَةُ <h>ٱ</>للَّهِ عَلَى <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":19,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["يَصُدُّونَ","yaṣuddūna","hinder","বাধা দেয়"],["عَن","‘an","from","থেকে"],["سَبِيلِ","sabīli","(the) way","পথ"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَيَبْغُونَهَا","wayabghūnahā","and seek (in) it","ও তাতে খোঁজ করে"],["عِوَجًۭا","‘iwajan","crookedness","দোষত্রুটি/বক্রতা"],["وَهُم","wahum","while they","এবং তারা"],["بِٱلْـَٔاخِرَةِ","bil-ākhirati","in the Hereafter","প্রতি আখিরাতের"],["هُمْ","hum","[they]","তারাই"],["كَـٰفِرُونَ","kāfirūna","(are) disbelievers","অবিশ্বাসী"]],"t":"ٱلَّذِينَ يَصُدُّونَ عَ<k>ن سَ</>بِيلِ <h>ٱ</>للَّهِ وَيَ<q>بْ</>غُونَهَا عِوَ<d>جًۭا وَ</><f>هُم بِ</><h>ٱ</>لْءَاخِرَةِ هُمْ <m>كَٰ</>فِ<p>رُو</>نَ"},{"n":20,"w":[["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব লোক"],["لَمْ","lam","not","না"],["يَكُونُوا۟","yakūnū","will be","তারা ছিলো (সক্ষম)"],["مُعْجِزِينَ","mu‘'jizīna","(able to) escape","(আল্লাহ-কে) অক্ষমকারী"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["وَمَا","wamā","and not","এবং না"],["كَانَ","kāna","is","ছিলো"],["لَهُم","lahum","for them","তাদের জন্যে"],["مِّن","min","besides","থেকে"],["دُونِ","dūni","besides","ছাড়া"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["مِنْ","min","any","কোন"],["أَوْلِيَآءَ ۘ","awliyāa","protectors","অভিভাবক"],["يُضَـٰعَفُ","yuḍā‘afu","And will be doubled","দ্বিগুণ করা হবে"],["لَهُمُ","lahumu","for them","তাদের জন্যে"],["ٱلْعَذَابُ ۚ","l-‘adhābu","the punishment","শাস্তি"],["مَا","mā","Not","না"],["كَانُوا۟","kānū","they were","ছিলো"],["يَسْتَطِيعُونَ","yastaṭī‘ūna","able","তারা সক্ষম"],["ٱلسَّمْعَ","l-sam‘a","(to) hear","শুনতে"],["وَمَا","wamā","and not","এবং না"],["كَانُوا۟","kānū","they used (to)","ছিলো (সক্ষম)"],["يُبْصِرُونَ","yub'ṣirūna","see","তারা দেখতে"]],"t":"أُ<s>و۟</><o>لَٰٓ</>ئِكَ لَمْ يَكُونُو<s>ا۟</> مُعْجِزِينَ فِى <h>ٱ</>لْأَرْضِ وَمَا كَانَ لَ<y>هُم مِّ</><k>ن دُ</>ونِ <h>ٱ</>للَّهِ مِنْ أَوْلِ<o>يَآ</>ءَ ۘ يُ<m>ضَٰ</>عَفُ لَهُمُ <h>ٱ</>لْعَذَابُ ۚ مَا كَانُو<s>ا۟</> يَسْتَطِيعُونَ <h>ٱ</><l>ل</>سَّمْعَ وَمَا كَانُو<s>ا۟</> يُ<q>بْ</>صِ<p>رُو</>نَ"},{"n":21,"w":[["أُو۟لَـٰٓئِكَ","ulāika","Those","ঐসব লোক"],["ٱلَّذِينَ","alladhīna","(are) the ones who","যারা"],["خَسِرُوٓا۟","khasirū","(have) lost","ক্ষতি করেছে"],["أَنفُسَهُمْ","anfusahum","their souls","তাদের নিজেদেরকে"],["وَضَلَّ","waḍalla","and lost","ও উধাও হয়েছে"],["عَنْهُم","‘anhum","from them","তাদের থেকে"],["مَّا","mā","(is) what","যা"],["كَانُوا۟","kānū","they used","করতেছিলো"],["يَفْتَرُونَ","yaftarūna","(to) invent","তারা রচনা"]],"t":"أُ<s>و۟</><o>لَٰٓ</>ئِكَ <h>ٱ</>لَّذِينَ خَسِ<o>رُوٓ</><s>ا۟</> أَ<k>نفُ</>سَهُمْ وَضَلَّ عَنْ<y>هُم مَّ</>ا كَانُو<s>ا۟</> يَفْتَ<p>رُو</>نَ"},{"n":22,"w":[["لَا","lā","No","নেই"],["جَرَمَ","jarama","doubt","কোন সন্দেহ"],["أَنَّهُمْ","annahum","that they","যে তারা"],["فِى","fī","in","মধ্যে"],["ٱلْـَٔاخِرَةِ","l-ākhirati","the Hereafter","পরকালের"],["هُمُ","humu","[they]","তারাই"],["ٱلْأَخْسَرُونَ","l-akhsarūna","(will be) the greatest losers","সর্বাধিক ক্ষতিগ্রস্ত (হবে)"]],"t":"لَا جَرَمَ أَ<g>نَّ</>هُمْ فِى <h>ٱ</>لْءَاخِرَةِ هُمُ <h>ٱ</>لْأَخْسَ<p>رُو</>نَ"},{"n":23,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ءَامَنُوا۟","āmanū","believe","ঈমান এনেছে"],["وَعَمِلُوا۟","wa‘amilū","and do","ও কাজ করেছে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","good deeds","সৎ"],["وَأَخْبَتُوٓا۟","wa-akhbatū","and humble themselves","ও তারা বিনয়াবনত হয়েছে"],["إِلَىٰ","ilā","before","প্রতি"],["رَبِّهِمْ","rabbihim","their Lord","তাদের রবের"],["أُو۟لَـٰٓئِكَ","ulāika","those","ঐসব লোক"],["أَصْحَـٰبُ","aṣḥābu","(are the) companions","অধিবাসী হবে"],["ٱلْجَنَّةِ ۖ","l-janati","(of) Paradise","জান্নাতের"],["هُمْ","hum","they","তারা"],["فِيهَا","fīhā","in it","তার মধ্যে"],["خَـٰلِدُونَ","khālidūna","(will) abide forever","চিরস্থায়ী হবে"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ وَأَخْبَ<o>تُوٓ</><s>ا۟</> إِلَىٰ رَبِّهِمْ أُ<s>و۟</><o>لَٰٓ</>ئِكَ أَصْ<m>حَٰ</>بُ <h>ٱ</>لْجَ<g>نَّ</>ةِ ۖ هُمْ فِيهَا <m>خَٰ</>لِ<p>دُو</>نَ"},{"n":24,"w":[["۞ مَثَلُ","mathalu","(The) example","উপমা"],["ٱلْفَرِيقَيْنِ","l-farīqayni","(of) the two parties","দলের"],["كَٱلْأَعْمَىٰ","kal-a‘mā","(is) like the blind","যেমন একজন অন্ধ"],["وَٱلْأَصَمِّ","wal-aṣami","and the deaf","ও বধির"],["وَٱلْبَصِيرِ","wal-baṣīri","and the seer","এবং (অপরজন) দৃষ্টিসম্পন্ন"],["وَٱلسَّمِيعِ ۚ","wal-samī‘i","and the hearer","ও শ্রবণশীল"],["هَلْ","hal","Are","কি"],["يَسْتَوِيَانِ","yastawiyāni","they equal","দু'টো সমান হয়"],["مَثَلًا ۚ","mathalan","(in) comparison","তুলনায়"],["أَفَلَا","afalā","Then, will not","তবুও কি না"],["تَذَكَّرُونَ","tadhakkarūna","you take heed","তোমরা শিক্ষা গ্রহণ করবে"]],"t":"۞ مَثَلُ <h>ٱ</>لْفَرِيقَيْنِ كَ<h>ٱ</>لْأَعْمَىٰ وَ<h>ٱ</>لْأَصَ<g>مِّ</> وَ<h>ٱ</>لْبَصِيرِ وَ<h>ٱ</><l>ل</>سَّمِيعِ ۚ هَلْ يَسْتَوِيَانِ مَثَلًا ۚ أَفَلَا تَذَكَّ<p>رُو</>نَ"},{"n":25,"w":[["وَلَقَدْ","walaqad","And verily","এবং নিশ্চয়ই"],["أَرْسَلْنَا","arsalnā","We sent","আমরা পাঠিয়েছি"],["نُوحًا","nūḥan","Nuh","নূহকে"],["إِلَىٰ","ilā","to","কাছে"],["قَوْمِهِۦٓ","qawmihi","his people","তাঁর জাতির"],["إِنِّى","innī","Indeed, I am","\"(সে বলেছিলো) আমি নিশ্চয়ই"],["لَكُمْ","lakum","to you","তোমাদের জন্যে"],["نَ