ُنتُم","kuntum","you are","তোমরা হও"],["مُّؤْمِنِينَ ۚ","mu'minīna","believers","ঈমানদার"],["وَمَآ","wamā","And not","এবং নই"],["أَنَا۠","anā","I am","আমি"],["عَلَيْكُم","‘alaykum","over you","তোমাদের উপর"],["بِحَفِيظٍۢ","biḥafīẓin","a guardian","কোন তত্ত্বাবধায়ক\""]],"t":"بَقِيَّتُ <h>ٱ</>للَّهِ خَيْ<w>رٌۭ لَّ</>كُمْ إِ<k>ن كُنتُ</><y>م مُّ</>ؤْمِنِينَ ۚ وَ<o>مَآ</> أَنَا۠ عَلَيْ<f>كُم بِ</>حَ<p>فِي</>ظٍۢ"},{"n":87,"w":[["قَالُوا۟","qālū","They said","তারা বললো"],["يَـٰشُعَيْبُ","yāshu‘aybu","O Shuaib","\"হে শুআইব"],["أَصَلَوٰتُكَ","aṣalatuka","Does your prayer","কি তোমার সালাত"],["تَأْمُرُكَ","tamuruka","command you","তোমাকে নির্দেশ দেয়"],["أَن","an","that","যে"],["نَّتْرُكَ","natruka","we leave","ছেড়ে দিবো আমরা"],["مَا","mā","what","(তা) যার"],["يَعْبُدُ","ya‘budu","worship","উপাসনা করতো"],["ءَابَآؤُنَآ","ābāunā","our forefathers","আমাদের পূর্ব পুরুষেরা"],["أَوْ","aw","or","অথবা"],["أَن","an","that","যেন (না)"],["نَّفْعَلَ","naf‘ala","we do","আমরা করি"],["فِىٓ","fī","concerning","মধ্যে"],["أَمْوَٰلِنَا","amwālinā","our wealth","আমাদের ধন-সম্পদের"],["مَا","mā","what","যা"],["نَشَـٰٓؤُا۟ ۖ","nashāu","we will","আমরা চাই"],["إِنَّكَ","innaka","Indeed you","নিশ্চয়ই তুমি"],["لَأَنتَ","la-anta","surely you","অবশ্যই তুমি"],["ٱلْحَلِيمُ","l-ḥalīmu","(are) the forbearing","ধৈর্যধারী"],["ٱلرَّشِيدُ","l-rashīdu","the right-minded","সদাচারী\""]],"t":"قَالُو<s>ا۟</> <m>يَٰ</>شُعَيْبُ أَصَلَ<s>وٰ</>تُكَ تَأْمُرُكَ <d>أَن نَّ</>تْرُكَ مَا يَعْبُدُ ءَا<o>بَآؤُنَآ</> أَوْ <d>أَن نَّ</>فْعَلَ <o>فِىٓ</> أَمْ<m>وَٰ</>لِنَا مَا نَ<o>شَٰٓ</>ؤُ<s>ا۟</> ۖ إِ<g>نَّ</>كَ لَأَ<k>نتَ</> <h>ٱ</>لْحَلِيمُ <h>ٱ</><l>ل</>رَّ<p>شِي</><q>دُ</>"},{"n":88,"w":[["قَالَ","qāla","He said","সে বললো"],["يَـٰقَوْمِ","yāqawmi","O my people","\"হে আমার জাতি"],["أَرَءَيْتُمْ","ara-aytum","Do you see","তোমরা কি (ভেবে) দেখেছো"],["إِن","in","if","যদি"],["كُنتُ","kuntu","I am","আমি হই"],["عَلَىٰ","‘alā","on","উপর"],["بَيِّنَةٍۢ","bayyinatin","a clear evidence","সুস্পষ্ট প্রমাণের"],["مِّن","min","from","কাছ থেকে"],["رَّبِّى","rabbī","my Lord","আমার রবের"],["وَرَزَقَنِى","warazaqanī","and He has provided me","এবং আমাকে জীবিকা‌ দিয়েছেন"],["مِنْهُ","min'hu","from Himself","তাঁর নিকট হ'তে"],["رِزْقًا","riz'qan","a good provision","জীবিকা"],["حَسَنًۭا ۚ","ḥasanan","a good provision","উত্তম"],["وَمَآ","wamā","And not","এবং না"],["أُرِيدُ","urīdu","I intend","আমি চাই"],["أَنْ","an","that","যে"],["أُخَالِفَكُمْ","ukhālifakum","I differ from you","তোমাদের বিরুদ্ধাচারণ করি"],["إِلَىٰ","ilā","in","(তার) প্রতি"],["مَآ","mā","what","যা"],["أَنْهَىٰكُمْ","anhākum","I forbid you","তোমাদের আমি নিষেধ করি"],["عَنْهُ ۚ","‘anhu","from it","তা হ'তে"],["إِنْ","in","Not","না"],["أُرِيدُ","urīdu","I intend","আমি চাই"],["إِلَّا","illā","except","এ ছাড়া"],["ٱلْإِصْلَـٰحَ","l-iṣ'lāḥa","the reform","সংশোধন"],["مَا","mā","as much as I am able","যতটুকু"],["ٱسْتَطَعْتُ ۚ","is'taṭa‘tu","as much as I am able","আমি করতে পারি"],["وَمَا","wamā","And not","এবং নেই"],["تَوْفِيقِىٓ","tawfīqī","(is) my success","আমার সামর্থ"],["إِلَّا","illā","except","এ ছাড়া (যা)"],["بِٱللَّهِ ۚ","bil-lahi","with Allah","(সংঘটিত হয়) সাহায্যে আল্লাহর"],["عَلَيْهِ","‘alayhi","Upon Him","তাঁরই উপর"],["تَوَكَّلْتُ","tawakkaltu","I trust","আমি ভরসা করেছি"],["وَإِلَيْهِ","wa-ilayhi","and to Him","ও তাঁরই দিকে"],["أُنِيبُ","unību","I turn","প্রত্যাবর্তন আমি করছি"]],"t":"قَالَ <m>يَٰ</>قَوْمِ أَرَءَيْتُمْ إِ<k>ن كُنتُ</> عَلَىٰ بَيِّنَ<d>ةٍۢ مِّ</><w>ن رَّ</>بِّى وَرَزَقَنِى مِنْهُ رِزْقًا حَسَ<d>نًۭا ۚ وَ</><o>مَآ</> أُرِيدُ أَنْ أُخَالِفَكُمْ إِلَىٰ <o>مَآ</> أَنْهَ<m>ىٰ</>كُمْ عَنْهُ ۚ إِنْ أُرِيدُ إِلَّا <h>ٱ</>لْإِصْ<m>لَٰ</>حَ مَا <h>ٱ</>سْتَطَعْتُ ۚ وَمَا تَوْفِي<o>قِىٓ</> إِلَّا بِ<h>ٱ</>للَّهِ ۚ عَلَيْهِ تَوَكَّلْتُ وَإِلَيْهِ أُ<p>نِي</><q>بُ</>"},{"n":89,"w":[["وَيَـٰقَوْمِ","wayāqawmi","And O my people","এবং হে আমার জাতি"],["لَا","lā","(Let) not cause you to sin","না (যেন)"],["يَجْرِمَنَّكُمْ","yajrimannakum","(Let) not cause you to sin","তোমাদেরকে অপরাধ করতে (উদ্বুদ্ধ করে)"],["شِقَاقِىٓ","shiqāqī","my dissension","আমার (সাথে) বিরোধ"],["أَن","an","lest","(এতদূর) যে"],["يُصِيبَكُم","yuṣībakum","befalls you","তোমাদের উপর আপতিত হয়"],["مِّثْلُ","mith'lu","similar","তেমনি (শাস্তি)"],["مَآ","mā","(to) what","যেমন"],["أَصَابَ","aṣāba","befell","আপতিত হয়েছিলো"],["قَوْمَ","qawma","(the) people of Nuh","জাতির (উপর)"],["نُوحٍ","nūḥin","(the) people of Nuh","নূহের"],["أَوْ","aw","or","বা"],["قَوْمَ","qawma","(the) people of Hud","জাতির (উপর)"],["هُودٍ","hūdin","(the) people of Hud","হূদের"],["أَوْ","aw","or","অথবা"],["قَوْمَ","qawma","people of Salih","জাতির (উপর)"],["صَـٰلِحٍۢ ۚ","ṣāliḥin","people of Salih","সালিহর"],["وَمَا","wamā","And not","এবং নয়"],["قَوْمُ","qawmu","(are the) people of Lut","জাতি"],["لُوطٍۢ","lūṭin","(are the) people of Lut","লুতের"],["مِّنكُم","minkum","from you","তোমাদের থেকে"],["بِبَعِيدٍۢ","biba‘īdin","far off","বহুদূরে"]],"t":"وَ<m>يَٰ</>قَوْمِ لَا يَ<q>جْ</>رِمَ<g>نَّ</>كُمْ شِقَا<o>قِىٓ</> <d>أَن يُ</>صِيبَ<y>كُم مِّ</>ثْلُ <o>مَآ</> أَصَابَ قَوْمَ نُوحٍ أَوْ قَوْمَ هُودٍ أَوْ قَوْمَ <m>صَٰ</>لِ<d>حٍۢ ۚ وَ</>مَا قَوْمُ لُو<d>طٍۢ مِّ</><k>نكُ</><f>م بِ</>بَ<p>عِي</><q>دٍۢ</>"},{"n":90,"w":[["وَٱسْتَغْفِرُوا۟","wa-is'taghfirū","And ask forgiveness","এবং তোমরা ক্ষমা চাও"],["رَبَّكُمْ","rabbakum","(of) your Lord","তোমাদের রবের কাছে"],["ثُمَّ","thumma","then","এরপর"],["تُوبُوٓا۟","tūbū","turn in repentance","তোমরা ফিরে এসো"],["إِلَيْهِ ۚ","ilayhi","to Him","তাঁর দিকে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["رَبِّى","rabbī","my Lord","আমার রব"],["رَحِيمٌۭ","raḥīmun","(is) Most Merciful","পরম দয়ালু"],["وَدُودٌۭ","wadūdun","Most Loving","প্রেমময়\""]],"t":"وَ<h>ٱ</>سْتَغْفِرُو<s>ا۟</> رَبَّكُمْ ثُ<g>مَّ</> تُو<o>بُوٓ</><s>ا۟</> إِلَيْهِ ۚ إِ<g>نَّ</> رَبِّى رَحِي<d>مٌۭ وَ</><p>دُو</><q>دٌۭ</>"},{"n":91,"w":[["قَالُوا۟","qālū","They said","তারা বলেছিলো"],["يَـٰشُعَيْبُ","yāshu‘aybu","O Shuaib","\"হে শুআইব"],["مَا","mā","Not","না"],["نَفْقَهُ","nafqahu","we understand","আমরা বুঝি"],["كَثِيرًۭا","kathīran","much","অনেক (কথাই)"],["مِّمَّا","mimmā","of what","তা হ'তে যা"],["تَقُولُ","taqūlu","you say","বলো তুমি"],["وَإِنَّا","wa-innā","and indeed, we","এবং নিশ্চয়ই আমরা"],["لَنَرَىٰكَ","lanarāka","surely [we] see you","আমরা অবশ্যই তোমাকে দেখছি"],["فِينَا","fīnā","among us","আমাদের মাঝে"],["ضَعِيفًۭا ۖ","ḍa‘īfan","weak","দুর্বল হিসেবে"],["وَلَوْلَا","walawlā","And if not","এবং যদি থাকত না"],["رَهْطُكَ","rahṭuka","for your family","তোমার স্বজনবর্গ"],["لَرَجَمْنَـٰكَ ۖ","larajamnāka","surely we would have stoned you","তোমাকে আমরা পাথর ছুড়ে মেরে ফেলতাম"],["وَمَآ","wamā","and you are not","এবং নও"],["أَنتَ","anta","and you are not","তুমি"],["عَلَيْنَا","‘alaynā","against us","আমাদের উপর"],["بِعَزِيزٍۢ","bi‘azīzin","mighty","শক্তিশালী\""]],"t":"قَالُو<s>ا۟</> <m>يَٰ</>شُعَيْبُ مَا نَفْقَهُ كَثِي<d>رًۭا مِّ</><g>مَّ</>ا تَقُولُ وَإِ<g>نَّ</>ا لَنَرَ<m>ىٰ</>كَ فِينَا ضَعِي<d>فًۭا ۖ وَ</>لَوْلَا رَهْطُكَ لَرَجَمْ<m>نَٰ</>كَ ۖ وَ<o>مَآ</> أَ<k>نتَ</> عَلَيْنَا بِعَ<p>زِي</>زٍۢ"},{"n":92,"w":[["قَالَ","qāla","He said","সে বললো"],["يَـٰقَوْمِ","yāqawmi","O my people","\"হে আমার জাতি"],["أَرَهْطِىٓ","arahṭī","Is my family","আমার স্বজনবর্গ কি"],["أَعَزُّ","a‘azzu","mightier","অধিক শক্তিশালী"],["عَلَيْكُم","‘alaykum","on you","তোমাদের কাছে"],["مِّنَ","mina","than","চেয়েও"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌র"],["وَٱتَّخَذْتُمُوهُ","wa-ittakhadhtumūhu","And you have taken Him","অথচ তাঁকে তোমরা রেখে দিয়েছো"],["وَرَآءَكُمْ","warāakum","behind your","তোমাদের পিছনে"],["ظِهْرِيًّا ۖ","ẓih'riyyan","backs","অবহেলা ভরে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["رَبِّى","rabbī","my Lord","আমার রব"],["بِمَا","bimā","of what","সে সম্বন্ধে যা"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা করছো"],["مُحِيطٌۭ","muḥīṭun","(is) All-Encompassing","পরিবেষ্টন করে আছেন"]],"t":"قَالَ <m>يَٰ</>قَوْمِ أَرَهْ<o>طِىٓ</> أَعَزُّ عَلَيْ<y>كُم مِّ</>نَ <h>ٱ</>للَّهِ وَ<h>ٱ</>تَّخَذْتُمُوهُ وَ<o>رَآ</>ءَكُمْ ظِهْرِيًّا ۖ إِ<g>نَّ</> رَبِّى بِمَا تَعْمَلُونَ مُ<p>حِي</><q>طٌۭ</>"},{"n":93,"w":[["وَيَـٰقَوْمِ","wayāqawmi","And O my people","এবং হে আমার জাতি"],["ٱعْمَلُوا۟","i‘'malū","Work","তোমরা কাজ করো"],["عَلَىٰ","‘alā","(according) to","উপর"],["مَكَانَتِكُمْ","makānatikum","your position","তোমাদের নিজ নিজ অবস্থানের"],["إِنِّى","innī","indeed, I am","নিশ্চয়ই আমিও"],["عَـٰمِلٌۭ ۖ","‘āmilun","working","কাজ করছি (আমার অবস্থানে)"],["سَوْفَ","sawfa","Soon","শীঘ্রই"],["تَعْلَمُونَ","ta‘lamūna","you will know","তোমরা জানবে"],["مَن","man","(on) whom","(যে) কে সেই"],["يَأْتِيهِ","yatīhi","will come","যার উপর আসবে"],["عَذَابٌۭ","‘adhābun","a punishment","শাস্তি"],["يُخْزِيهِ","yukh'zīhi","(that will) disgrace him","তাকে লাঞ্ছিত করে ছাড়বে"],["وَمَنْ","waman","and who","এবং কে"],["هُوَ","huwa","[he]","সে"],["كَـٰذِبٌۭ ۖ","kādhibun","(is) a liar","মিথ্যাবাদী"],["وَٱرْتَقِبُوٓا۟","wa-ir'taqibū","And watch","এবং তোমরা প্রতীক্ষা করো"],["إِنِّى","innī","indeed, I am","নিশ্চয়ই আমি"],["مَعَكُمْ","ma‘akum","with you","তোমাদের সাথে"],["رَقِيبٌۭ","raqībun","a watcher","প্রতীক্ষাকারী\""]],"t":"وَ<m>يَٰ</>قَوْمِ <h>ٱ</>عْمَلُو<s>ا۟</> عَلَىٰ مَكَانَتِكُمْ إِ<g>نِّ</>ى <m>عَٰ</>مِ<k>لٌۭ ۖ سَ</>وْفَ تَعْلَمُونَ <d>مَن يَ</>أْتِيهِ عَذَا<d>بٌۭ يُ</>خْزِيهِ وَمَنْ هُوَ <m>كَٰ</>ذِ<d>بٌۭ ۖ وَ</><h>ٱ</>رْتَقِ<o>بُوٓ</><s>ا۟</> إِ<g>نِّ</>ى مَعَكُمْ رَ<p>قِي</><q>بٌۭ</>"},{"n":94,"w":[["وَلَمَّا","walammā","And when","এবং যখন"],["جَآءَ","jāa","came","আসলো"],["أَمْرُنَا","amrunā","Our Command","আমাদের নির্দেশ"],["نَجَّيْنَا","najjaynā","We saved","আমরা রক্ষা করলাম"],["شُعَيْبًۭا","shu‘ayban","Shuaib","শুআইবকে"],["وَٱلَّذِينَ","wa-alladhīna","and those who","ও যারা"],["ءَامَنُوا۟","āmanū","believed","ঈমান এনেছিলো"],["مَعَهُۥ","ma‘ahu","with him","তার সাথে"],["بِرَحْمَةٍۢ","biraḥmatin","by a Mercy","অনুগ্রহ দিয়ে"],["مِّنَّا","minnā","from Us","আমাদের পক্ষ থেকে"],["وَأَخَذَتِ","wa-akhadhati","And seized","এবং ধরলো"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["ظَلَمُوا۟","ẓalamū","wronged","সীমালঙ্ঘন করেছিলো"],["ٱلصَّيْحَةُ","l-ṣayḥatu","the thunderous blast","মহাগর্জন"],["فَأَصْبَحُوا۟","fa-aṣbaḥū","then they became","তারা অতঃপর হয়ে গেলো"],["فِى","fī","in","মধ্যে"],["دِيَـٰرِهِمْ","diyārihim","their homes","তাদের ঘরগুলোর"],["جَـٰثِمِينَ","jāthimīna","fallen prone","উপুড় হয়ে পড়া (নির্জীব নিস্পন্দ)"]],"t":"وَلَ<g>مَّ</>ا <o>جَآ</>ءَ أَمْرُنَا نَجَّيْنَا شُعَيْ<d>بًۭا وَ</><h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> مَعَهُ<m>ۥ</> بِرَحْمَ<d>ةٍۢ مِّ</><g>نَّ</>ا وَأَخَذَتِ <h>ٱ</>لَّذِينَ ظَلَمُو<s>ا۟</> <h>ٱ</><l>ل</>صَّيْحَةُ فَأَصْبَحُو<s>ا۟</> فِى دِ<m>يَٰ</>رِهِمْ <m>جَٰ</>ثِ<p>مِي</>نَ"},{"n":95,"w":[["كَأَن","ka-an","As if","যেন"],["لَّمْ","lam","not","নি"],["يَغْنَوْا۟","yaghnaw","they (had) prospered","তারা বসবাস করেই"],["فِيهَآ ۗ","fīhā","therein","তার মধ্যে"],["أَلَا","alā","So","জেনে রাখো"],["بُعْدًۭا","bu‘'dan","away","ধ্বংস হলো"],["لِّمَدْيَنَ","limadyana","with Madyan","জন্যে মাদয়ানবাসীদের"],["كَمَا","kamā","as","যেমন"],["بَعِدَتْ","ba‘idat","was taken away","ধ্বংস করা হয়েছিলো"],["ثَمُودُ","thamūdu","the Thamud","সামূদ জাতিকে"]],"t":"كَ<w>أَن لَّ</>مْ يَغْنَوْ<s>ا۟</> فِي<o>هَآ ۗ</> أَلَا بُعْ<w>دًۭا لِّ</>مَ<q>دْ</>يَنَ كَمَا بَعِدَتْ ثَ<p>مُو</><q>دُ</>"},{"n":96,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["أَرْسَلْنَا","arsalnā","We sent","আমরা পাঠিয়েছিলাম"],["مُوسَىٰ","mūsā","Musa","মূসাকে"],["بِـَٔايَـٰتِنَا","biāyātinā","with Our Signs","দিয়ে আমাদের নিদর্শনাবলী"],["وَسُلْطَـٰنٍۢ","wasul'ṭānin","and an authority","এবং প্রমাণ (দিয়ে)"],["مُّبِينٍ","mubīnin","clear","সুস্পষ্ট"]],"t":"وَلَقَ<q>دْ</> أَرْسَلْنَا مُوسَىٰ بِـَٔا<m>يَٰ</>تِنَا وَسُلْ<m>طَٰ</><d>نٍۢ مُّ</><p>بِي</>نٍ"},{"n":97,"w":[["إِلَىٰ","ilā","To","প্রতি"],["فِرْعَوْنَ","fir'‘awna","Firaun","ফিরআউনের"],["وَمَلَإِي۟هِۦ","wamala-ihi","and his chiefs","এবং তার প্রধানব্যক্তিবর্গের (প্রতি)"],["فَٱتَّبَعُوٓا۟","fa-ittaba‘ū","but they followed","তারা অতঃপর অনুসরণ করলো"],["أَمْرَ","amra","(the) command of Firaun","কাজকর্মের"],["فِرْعَوْنَ ۖ","fir'‘awna","(the) command of Firaun","ফিরআউনের"],["وَمَآ","wamā","and not","এবং না"],["أَمْرُ","amru","(the) command of Firaun","কাজকর্ম (ছিলো)"],["فِرْعَوْنَ","fir'‘awna","(the) command of Firaun","ফিরআউনের"],["بِرَشِيدٍۢ","birashīdin","was right","ন্যায়সঙ্গত"]],"t":"إِلَىٰ فِرْعَوْنَ وَمَلَإِ<s>ي۟</><m>هِۦ</> فَ<h>ٱ</>تَّبَ<o>عُوٓ</><s>ا۟</> أَمْرَ فِرْعَوْنَ ۖ وَ<o>مَآ</> أَمْرُ فِرْعَوْنَ بِرَ<p>شِي</><q>دٍۢ</>"},{"n":98,"w":[["يَقْدُمُ","yaqdumu","He will precede","সে সামনে থাকবে"],["قَوْمَهُۥ","qawmahu","his people","তার জাতির লোকদের"],["يَوْمَ","yawma","(on the) Day","দিনে"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) the Resurrection","ক্বিয়ামাতের"],["فَأَوْرَدَهُمُ","fa-awradahumu","and lead them","অতঃপর তাদের উপস্থিত করবে"],["ٱلنَّارَ ۖ","l-nāra","(into) the Fire","(জাহান্নামের) আগুনে"],["وَبِئْسَ","wabi'sa","And wretched","এবং অতি জঘন্য"],["ٱلْوِرْدُ","l-wir'du","(is) the place","উপস্থিত স্থান"],["ٱلْمَوْرُودُ","l-mawrūdu","to which (they are) led","যেখানে তারা উপস্থিত  হবে"]],"t":"يَ<q>قْ</>دُمُ قَوْمَهُ<m>ۥ</> يَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ فَأَوْرَدَهُمُ <h>ٱ</><l>ل</><g>نَّ</>ارَ ۖ وَبِئْسَ <h>ٱ</>لْوِرْدُ <h>ٱ</>لْمَوْ<p>رُو</><q>دُ</>"},{"n":99,"w":[["وَأُتْبِعُوا۟","wa-ut'bi‘ū","And they were followed","এবং তাদেরকে অনুসরণ করলো"],["فِى","fī","in","মধ্যে"],["هَـٰذِهِۦ","hādhihi","this","এই (পৃথিবীর)"],["لَعْنَةًۭ","la‘natan","(by) a curse","অভিশাপ"],["وَيَوْمَ","wayawma","and (on the) Day","এবং (অভিশাপ) দিনে"],["ٱلْقِيَـٰمَةِ ۚ","l-qiyāmati","(of) the Resurrection","ক্বিয়ামাতের"],["بِئْسَ","bi'sa","Wretched","অতি জঘন্য"],["ٱلرِّفْدُ","l-rif'du","(is) the gift","পুরস্কার"],["ٱلْمَرْفُودُ","l-marfūdu","which (will) be given","(যা তাদেরকে) পুরস্কার দেয়া হবে"]],"t":"وَأُتْبِعُو<s>ا۟</> فِى <m>هَٰذِهِۦ</> لَعْنَ<d>ةًۭ وَ</>يَوْمَ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ ۚ بِئْسَ <h>ٱ</><l>ل</>رِّفْدُ <h>ٱ</>لْمَرْ<p>فُو</><q>دُ</>"},{"n":100,"w":[["ذَٰلِكَ","dhālika","That","এই (খবর)"],["مِنْ","min","(is) from","কিছু"],["أَنۢبَآءِ","anbāi","(the) news","সংবাদ"],["ٱلْقُرَىٰ","l-qurā","(of) the cities","জনপদসমূহের"],["نَقُصُّهُۥ","naquṣṣuhu","(which) We relate","তা আমরা বর্ণনা করছি"],["عَلَيْكَ ۖ","‘alayka","to you","তোমার কাছে"],["مِنْهَا","min'hā","of them","তার মধ্যে হ'তে"],["قَآئِمٌۭ","qāimun","some are standing","(কিছু) বিদ্যমান আছে"],["وَحَصِيدٌۭ","waḥaṣīdun","and (some) mown","আবার (কিছু) নির্মূল হয়েছে"]],"t":"<m>ذَٰ</>لِكَ مِنْ أَ<i>نۢبَ</><o>آ</>ءِ <h>ٱ</>لْقُرَىٰ نَقُصُّهُ<m>ۥ</> عَلَيْكَ ۖ مِنْهَا <o>قَآ</>ئِ<d>مٌۭ وَ</>حَ<p>صِي</><q>دٌۭ</>"},{"n":101,"w":[["وَمَا","wamā","And not","এবং না"],["ظَلَمْنَـٰهُمْ","ẓalamnāhum","We wronged them","তাদের উপর আমরা অত্যাচার করেছি"],["وَلَـٰكِن","walākin","but","কিন্তু"],["ظَلَمُوٓا۟","ẓalamū","they wronged","তারা অত্যাচার করেছিলো"],["أَنفُسَهُمْ ۖ","anfusahum","themselves","তাদের নিজেদের (উপর)"],["فَمَآ","famā","So not","অতঃপর না"],["أَغْنَتْ","aghnat","availed","কাজে লাগলো"],["عَنْهُمْ","‘anhum","them","তাদের জন্যে"],["ءَالِهَتُهُمُ","ālihatuhumu","their gods","তাদের উপাস্যরা"],["ٱلَّتِى","allatī","which","যাকে"],["يَدْعُونَ","yad‘ūna","they invoked","তারা ডাকত"],["مِن","min","other than Allah","থেকে"],["دُونِ","dūni","other than Allah","ছাড়া"],["ٱللَّهِ","l-lahi","other than Allah","আল্লাহ্‌কে"],["مِن","min","any","কোন"],["شَىْءٍۢ","shayin","thing","কিছুই"],["لَّمَّا","lammā","when","যখন"],["جَآءَ","jāa","came","আসলো"],["أَمْرُ","amru","(the) command (of) your Lord","নির্দেশ"],["رَبِّكَ ۖ","rabbika","(the) command (of) your Lord","তোমার রবের"],["وَمَا","wamā","And not","এবং না"],["زَادُوهُمْ","zādūhum","they increased them","তাদের তারা বৃদ্ধি করলো"],["غَيْرَ","ghayra","other than","ছাড়া"],["تَتْبِيبٍۢ","tatbībin","ruin","ধ্বংস"]],"t":"وَمَا ظَلَمْ<m>نَٰ</>هُمْ وَ<m>لَٰ</>كِ<k>ن ظَ</>لَ<o>مُوٓ</><s>ا۟</> أَ<k>نفُ</>سَهُمْ ۖ فَ<o>مَآ</> أَغْنَتْ عَنْهُمْ ءَالِهَتُهُمُ <h>ٱ</>لَّتِى يَ<q>دْ</>عُونَ مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ مِ<k>ن شَ</><w>ىْءٍۢ لَّ</><g>مَّ</>ا <o>جَآ</>ءَ أَمْرُ رَبِّكَ ۖ وَمَا زَادُوهُمْ غَيْرَ تَتْ<p>بِي</><q>بٍۢ</>"},{"n":102,"w":[["وَكَذَٰلِكَ","wakadhālika","And thus","এবং এভাবেই"],["أَخْذُ","akhdhu","(is) the seizure (of) your Lord","পাকড়াও (আসে)"],["رَبِّكَ","rabbika","(is) the seizure (of) your Lord","তোমার রবের"],["إِذَآ","idhā","when","যখন"],["أَخَذَ","akhadha","He seizes","তিনি পাকড়াও করেন"],["ٱلْقُرَىٰ","l-qurā","the cities","জনবসতিকে"],["وَهِىَ","wahiya","while they","এমতাবস্হায় তা"],["ظَـٰلِمَةٌ ۚ","ẓālimatun","(are) doing wrong","(ছিল) অত্যাচারী"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["أَخْذَهُۥٓ","akhdhahu","His seizure","তাঁর পাকড়াও"],["أَلِيمٌۭ","alīmun","(is) painful","যন্ত্রণাদায়ক"],["شَدِيدٌ","shadīdun","(and) severe","কঠোর"]],"t":"وَكَ<m>ذَٰ</>لِكَ أَخْذُ رَبِّكَ إِ<o>ذَآ</> أَخَذَ <h>ٱ</>لْقُرَىٰ وَهِىَ <m>ظَٰ</>لِمَةٌ ۚ إِ<g>نَّ</> أَخْذَهُ<o>ۥٓ</> أَلِي<k>مٌۭ شَ</><p>دِي</><q>دٌ</>"},{"n":103,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে (রয়েছে)"],["ذَٰلِكَ","dhālika","that","এর"],["لَـَٔايَةًۭ","laāyatan","(is) surely a Sign","অবশ্যই নিদর্শন"],["لِّمَنْ","liman","for (those) who","তার জন্য যে"],["خَافَ","khāfa","fear","ভয় করে"],["عَذَابَ","‘adhāba","(the) punishment","শাস্তির"],["ٱلْـَٔاخِرَةِ ۚ","l-ākhirati","(of) the Hereafter","আখিরাতের"],["ذَٰلِكَ","dhālika","That","এটা"],["يَوْمٌۭ","yawmun","(is) a Day","দিন"],["مَّجْمُوعٌۭ","majmū‘un","(will) be gathered","একত্র করার"],["لَّهُ","lahu","on it","তার (মধ্যে)"],["ٱلنَّاسُ","l-nāsu","the mankind","(সকল) মানুষকে"],["وَذَٰلِكَ","wadhālika","and that","এবং এটা"],["يَوْمٌۭ","yawmun","(is) a Day","দিন"],["مَّشْهُودٌۭ","mashhūdun","witnessed","সবার উপস্হিতির"]],"t":"إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَءَايَ<w>ةًۭ لِّ</>مَنْ خَافَ عَذَابَ <h>ٱ</>لْءَاخِرَةِ ۚ <m>ذَٰ</>لِكَ يَوْ<d>مٌۭ مَّ</><q>جْ</>مُو<w>عٌۭ لَّ</>هُ <h>ٱ</><l>ل</><g>نَّ</>اسُ وَ<m>ذَٰ</>لِكَ يَوْ<d>مٌۭ مَّ</>شْ<p>هُو</><q>دٌۭ</>"},{"n":104,"w":[["وَمَا","wamā","And not","এবং না"],["نُؤَخِّرُهُۥٓ","nu-akhiruhu","We delay it","তা আমরা স্হগিত করবো"],["إِلَّا","illā","except","এ ছাড়া"],["لِأَجَلٍۢ","li-ajalin","for a term","জন্যে একটি সময়ের"],["مَّعْدُودٍۢ","ma‘dūdin","limited","নির্দিষ্ট"]],"t":"وَمَا نُؤَخِّرُهُ<o>ۥٓ</> إِلَّا لِأَجَ<d>لٍۢ مَّ</>عْ<p>دُو</><q>دٍۢ</>"},{"n":105,"w":[["يَوْمَ","yawma","(The) Day","সেদিন"],["يَأْتِ","yati","(it) comes","(যখন) আসবে"],["لَا","lā","not","না"],["تَكَلَّمُ","takallamu","will speak","কথা বলতে পারবে"],["نَفْسٌ","nafsun","a soul","কোন ব্যক্তি"],["إِلَّا","illā","except","ছাড়া"],["بِإِذْنِهِۦ ۚ","bi-idh'nihi","by His leave","তাঁর অনুমতির মাধ্যমে"],["فَمِنْهُمْ","famin'hum","Then among them","অতঃপর তাদের মধ্যে কেউ"],["شَقِىٌّۭ","shaqiyyun","(will be the) wretched","হতভাগ্য (হবে)"],["وَسَعِيدٌۭ","wasa‘īdun","and (the) glad","আর সৌভাগ্যবান (হবে কেউ)"]],"t":"يَوْمَ يَأْتِ لَا تَكَلَّمُ نَفْسٌ إِلَّا بِإِذْنِ<m>هِۦ</> ۚ فَمِنْهُمْ شَقِ<d>ىٌّۭ وَ</>سَ<p>عِي</><q>دٌۭ</>"},{"n":106,"w":[["فَأَمَّا","fa-ammā","As for","অতঃপর"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["شَقُوا۟","shaqū","were wretched","হতভাগ্য হবে"],["فَفِى","fafī","then (they will be) in","তখন মধ্যে (হবে)"],["ٱلنَّارِ","l-nāri","the Fire","(জাহান্নামের) আগুনের"],["لَهُمْ","lahum","For them","তাদের জন্যে"],["فِيهَا","fīhā","therein","তার মধ্যে (থাকবে)"],["زَفِيرٌۭ","zafīrun","(is) sighing","আর্তনাদ"],["وَشَهِيقٌ","washahīqun","and wailing","ও চিৎকার"]],"t":"فَأَ<g>مَّ</>ا <h>ٱ</>لَّذِينَ شَقُو<s>ا۟</> فَفِى <h>ٱ</><l>ل</><g>نَّ</>ارِ لَهُمْ فِيهَا زَفِي<d>رٌۭ وَ</>شَ<p>هِي</><q>قٌ</>"},{"n":107,"w":[["خَـٰلِدِينَ","khālidīna","(Will be) abiding","তারা স্থায়ী হবে"],["فِيهَا","fīhā","therein","তার মধ্যে"],["مَا","mā","as long as remain","যতক্ষণ"],["دَامَتِ","dāmati","as long as remain","বিদ্যমান থাকবে"],["ٱلسَّمَـٰوَٰتُ","l-samāwātu","the heavens","আকাশসমূহ"],["وَٱلْأَرْضُ","wal-arḍu","and the earth","এবং পৃথিবী"],["إِلَّا","illā","except","তবে"],["مَا","mā","what your Lord wills","যা"],["شَآءَ","shāa","what your Lord wills","ইচ্ছে করেন"],["رَبُّكَ ۚ","rabbuka","what your Lord wills","তোমার রব (সেটা ভিন্ন কথা)"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["رَبَّكَ","rabbaka","your Lord","তোমার রব"],["فَعَّالٌۭ","fa‘‘ālun","(is) All-Accomplisher","নিশ্চিতভাবে সম্পাদনকারী"],["لِّمَا","limā","of what","যা"],["يُرِيدُ","yurīdu","He intends","তিনি চান"]],"t":"<m>خَٰ</>لِدِينَ فِيهَا مَا دَامَتِ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تُ وَ<h>ٱ</>لْأَرْضُ إِلَّا مَا <o>شَآ</>ءَ رَبُّكَ ۚ إِ<g>نَّ</> رَبَّكَ فَعَّا<w>لٌۭ لِّ</>مَا يُ<p>رِي</><q>دُ</>"},{"n":108,"w":[["۞ وَأَمَّا","wa-ammā","And as for","আর"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["سُعِدُوا۟","su‘idū","were glad","সৌভাগ্যবান হবে"],["فَفِى","fafī","then (they will be) in","তখন মধ্যে"],["ٱلْجَنَّةِ","l-janati","Paradise","জান্নাতের"],["خَـٰلِدِينَ","khālidīna","(will be) abiding","স্থায়ী বসবাসকারী"],["فِيهَا","fīhā","therein","তার মধ্যে (তারা থাকবে)"],["مَا","mā","as long as remains","যতক্ষণ"],["دَامَتِ","dāmati","as long as remains","বিদ্যমান থাকবে"],["ٱلسَّمَـٰوَٰتُ","l-samāwātu","the heavens","আকাশসমূহ"],["وَٱلْأَرْضُ","wal-arḍu","and the earth","ও পৃথিবী"],["إِلَّا","illā","except","এছাড়া"],["مَا","mā","what your Lord wills ","যা"],["شَآءَ","shāa","what your Lord wills ","ইচ্ছে করেন"],["رَبُّكَ ۖ","rabbuka","what your Lord wills ","তোমার রব"],["عَطَآءً","‘aṭāan","a bestowal","(তারা পাবে) পুরস্কার"],["غَيْرَ","ghayra","not","নয়"],["مَجْذُوذٍۢ","majdhūdhin","interrupted","বিছিন্ন হওয়ার"]],"t":"۞ وَأَ<g>مَّ</>ا <h>ٱ</>لَّذِينَ سُعِدُو<s>ا۟</> فَفِى <h>ٱ</>لْجَ<g>نَّ</>ةِ <m>خَٰ</>لِدِينَ فِيهَا مَا دَامَتِ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تُ وَ<h>ٱ</>لْأَرْضُ إِلَّا مَا <o>شَآ</>ءَ رَبُّكَ ۖ عَ<o>طَآ</>ءً غَيْرَ مَ<q>جْ</><p>ذُو</>ذٍۢ"},{"n":109,"w":[["فَلَا","falā","So (do) not","অতএব না"],["تَكُ","taku","be","তুমি থাকবে"],["فِى","fī","in","মধ্যে"],["مِرْيَةٍۢ","mir'yatin","doubt","সংশয়ের"],["مِّمَّا","mimmā","as to what","তা হ'তে যার"],["يَعْبُدُ","ya‘budu","worship","উপাসনা করে"],["هَـٰٓؤُلَآءِ ۚ","hāulāi","these (polytheists)","এসব (মুশরিকরা)"],["مَا","mā","Not","না"],["يَعْبُدُونَ","ya‘budūna","they worship","তারা উপাসনা করে"],["إِلَّا","illā","except","এ ছাড়া"],["كَمَا","kamā","as what","যেমন"],["يَعْبُدُ","ya‘budu","worshipped","উপাসনা করতো"],["ءَابَآؤُهُم","ābāuhum","their forefathers","তাদের পূর্বপুরুষেরা"],["مِّن","min","before","থেকে"],["قَبْلُ ۚ","qablu","before","পূর্ব"],["وَإِنَّا","wa-innā","And indeed, We","এবং নিশ্চয়ই আমরা"],["لَمُوَفُّوهُمْ","lamuwaffūhum","will surely pay them in full","অবশ্যই তাদের পুরোপুরি দিবো"],["نَصِيبَهُمْ","naṣībahum","their share","তাদের অংশ"],["غَيْرَ","ghayra","without","ছাড়া"],["مَنقُوصٍۢ","manqūṣin","being diminished","কম করা"]],"t":"فَلَا تَكُ فِى مِرْيَ<d>ةٍۢ مِّ</><g>مَّ</>ا يَعْبُدُ <o>هَٰٓؤُلَآ</>ءِ ۚ مَا يَعْبُدُونَ إِلَّا كَمَا يَعْبُدُ ءَا<o>بَآ</>ؤُ<y>هُم مِّ</><k>ن قَ</><q>بْ</>لُ ۚ وَإِ<g>نَّ</>ا لَمُوَفُّوهُمْ نَصِيبَهُمْ غَيْرَ مَ<k>نقُ</><p>و</>صٍۢ"},{"n":110,"w":[["وَلَقَدْ","walaqad","And verily","এবং নিশ্চয়ই"],["ءَاتَيْنَا","ātaynā","We gave","আমরা দিয়েছিলাম"],["مُوسَى","mūsā","Musa","মূসাকে"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","কিতাব"],["فَٱخْتُلِفَ","fa-ukh'tulifa","but differences arose","অতঃপর মতবিরোধ ঘটেছিলো"],["فِيهِ ۚ","fīhi","therein","মধ্যে তার"],["وَلَوْلَا","walawlā","And if not","এবং যদি না"],["كَلِمَةٌۭ","kalimatun","(for) a Word","একটি বাণী"],["سَبَقَتْ","sabaqat","(that) preceded","পূর্বে নির্ধারিত হতো"],["مِن","min","from","পক্ষ হ'তে"],["رَّبِّكَ","rabbika","your Lord","তোমার রবের"],["لَقُضِىَ","laquḍiya","surely would have been judged","অবশ্যই মীমাংসা করে দেয়া হতো"],["بَيْنَهُمْ ۚ","baynahum","between them","তাদের মাঝে"],["وَإِنَّهُمْ","wa-innahum","And indeed, they","এবং নিশ্চয়ই তারা"],["لَفِى","lafī","surely (are) in","অবশ্যই মধ্যে (আছে)"],["شَكٍّۢ","shakkin","doubt","সন্দেহের"],["مِّنْهُ","min'hu","concerning it","তা হ'তে"],["مُرِيبٍۢ","murībin","suspicious","বিভ্রান্তিকর (সন্দেহে)"]],"t":"وَلَقَ<q>دْ</> ءَاتَيْنَا مُوسَى <h>ٱ</>لْكِ<m>تَٰ</>بَ فَ<h>ٱ</>خْتُلِفَ فِيهِ ۚ وَلَوْلَا كَلِمَ<k>ةٌۭ سَ</>بَقَتْ <w>مِن رَّ</>بِّكَ لَقُضِىَ بَيْنَهُمْ ۚ وَإِ<g>نَّ</>هُمْ لَفِى شَ<d>كٍّۢ مِّ</>نْهُ مُ<p>رِي</><q>بٍۢ</>"},{"n":111,"w":[["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["كُلًّۭا","kullan","to each [when]","প্রত্যেককে (ব্যক্তিকে)"],["لَّمَّا","lammā","to each [when]","যখন (সময় আসবে)"],["لَيُوَفِّيَنَّهُمْ","layuwaffiyannahum","surely will pay them in full","অবশ্যই তাদের পুরোপুরি দিবেন"],["رَبُّكَ","rabbuka","your Lord","তোমার রব"],["أَعْمَـٰلَهُمْ ۚ","a‘mālahum","their deeds","তাদের কাজগুলোর (প্রতিফল)"],["إِنَّهُۥ","innahu","Indeed, He","নিশ্চয়ই তিনি"],["بِمَا","bimā","of what","ঐ বিষয়ে যা"],["يَعْمَلُونَ","ya‘malūna","they do","তারা কাজ করেছে"],["خَبِيرٌۭ","khabīrun","(is) All-Aware","খুব অবহিত"]],"t":"وَإِ<g>نَّ</> كُ<w>لًّۭا لَّ</><g>مَّ</>ا لَيُوَفِّيَ<g>نَّ</>هُمْ رَبُّكَ أَعْ<m>مَٰ</>لَهُمْ ۚ إِ<g>نَّ</>هُ<m>ۥ</> بِمَا يَعْمَلُونَ خَ<p>بِي</>رٌۭ"},{"n":112,"w":[["فَٱسْتَقِمْ","fa-is'taqim","So stand firm","অতএব সুদৃঢ় থাকো"],["كَمَآ","kamā","as","যেমন"],["أُمِرْتَ","umir'ta","you are commanded","তোমাকে আদেশ করা হয়েছে"],["وَمَن","waman","and (those) who","এবং যে"],["تَابَ","tāba","turn (in repentance)","ফিরে এসেছে (ঈমান ও আনুগত্যে)"],["مَعَكَ","ma‘aka","with you","তোমার সাথে"],["وَلَا","walā","and (do) not","এবং না"],["تَطْغَوْا۟ ۚ","taṭghaw","transgress","তোমরা সীমালঙ্ঘন করো"],["إِنَّهُۥ","innahu","Indeed, He","নিশ্চয়ই তিনি"],["بِمَا","bimā","of what","ঐ বিষয়ে যা"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা কাজ করছো"],["بَصِيرٌۭ","baṣīrun","(is) All-Seer","পূর্ণ দৃষ্টি রাখেন"]],"t":"فَ<h>ٱ</>سْتَقِمْ كَ<o>مَآ</> أُمِرْتَ وَمَ<k>ن تَ</>ابَ مَعَكَ وَلَا تَ<q>طْ</>غَوْ<s>ا۟ ۚ</> إِ<g>نَّ</>هُ<m>ۥ</> بِمَا تَعْمَلُونَ بَ<p>صِي</>رٌۭ"},{"n":113,"w":[["وَلَا","walā","And (do) not","এবং না"],["تَرْكَنُوٓا۟","tarkanū","incline","তোমরা ঝুঁকো"],["إِلَى","ilā","to","প্রতি"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["ظَلَمُوا۟","ẓalamū","do wrong","সীমালঙ্ঘন করেছে"],["فَتَمَسَّكُمُ","fatamassakumu","lest touches you","তাহ'লে স্পর্শ করবে তোমাদের"],["ٱلنَّارُ","l-nāru","the Fire","(জাহান্নামের) আগুন"],["وَمَا","wamā","and not","এবং না (হবে)"],["لَكُم","lakum","(is) for you","তোমাদের জন্যে"],["مِّن","min","besides Allah","মধ্য হতে"],["دُونِ","dūni","besides Allah","ছাড়া"],["ٱللَّهِ","l-lahi","besides Allah","আল্লাহ"],["مِنْ","min","any","কোন"],["أَوْلِيَآءَ","awliyāa","protectors","অভিভাবক"],["ثُمَّ","thumma","then","এরপর"],["لَا","lā","not","না"],["تُنصَرُونَ","tunṣarūna","you will be helped","তোমাদের সাহায্য করা হবে"]],"t":"وَلَا تَرْكَ<o>نُوٓ</><s>ا۟</> إِلَى <h>ٱ</>لَّذِينَ ظَلَمُو<s>ا۟</> فَتَمَسَّكُمُ <h>ٱ</><l>ل</><g>نَّ</>ارُ وَمَا لَ<y>كُم مِّ</><k>ن دُ</>ونِ <h>ٱ</>للَّهِ مِنْ أَوْلِ<o>يَآ</>ءَ ثُ<g>مَّ</> لَا تُ<k>نصَ</><p>رُو</>نَ"},{"n":114,"w":[["وَأَقِمِ","wa-aqimi","And establish","এবং প্রতিষ্ঠা করো"],["ٱلصَّلَوٰةَ","l-ṣalata","the prayer","সালাত"],["طَرَفَىِ","ṭarafayi","(at the) two ends","দুই প্রান্তে"],["ٱلنَّهَارِ","l-nahāri","(of) the day","দিনের"],["وَزُلَفًۭا","wazulafan","and (at) the approach","এবং (প্রথম) অংশে"],["مِّنَ","mina","of","থেকে"],["ٱلَّيْلِ ۚ","al-layli","the night","রাতের"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلْحَسَنَـٰتِ","l-ḥasanāti","the good deeds","সৎকাজগুলো"],["يُذْهِبْنَ","yudh'hib'na","remove","দূর করে দেয়"],["ٱلسَّيِّـَٔاتِ ۚ","l-sayiāti","the evil deeds","মন্দকাজগুলোকে"],["ذَٰلِكَ","dhālika","That","এটা"],["ذِكْرَىٰ","dhik'rā","(is) a reminder","উপদেশ"],["لِلذَّٰكِرِينَ","lildhākirīna","for those who remember","উপদেশগ্রহণকারীদের জন্যে"]],"t":"وَأَقِمِ <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةَ طَرَفَىِ <h>ٱ</><l>ل</><g>نَّ</>هَارِ وَزُلَ<d>فًۭا مِّ</>نَ <h>ٱ</>لَّيْلِ ۚ إِ<g>نَّ</> <h>ٱ</>لْحَسَ<m>نَٰ</>تِ يُذْهِ<q>بْ</>نَ <h>ٱ</><l>ل</>سَّيِّـَٔاتِ ۚ <m>ذَٰ</>لِكَ ذِكْرَىٰ لِل<m>ذَّٰ</>كِ<p>رِي</>نَ"},{"n":115,"w":[["وَٱصْبِرْ","wa-iṣ'bir","And be patient","এবং ধৈর্য ধরো"],["فَإِنَّ","fa-inna","for indeed","কারণ নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["لَا","lā","(does) not","না"],["يُضِيعُ","yuḍī‘u","let go waste","নষ্ট করেন"],["أَجْرَ","ajra","(the) reward","কর্মফল"],["ٱلْمُحْسِنِينَ","l-muḥ'sinīna","(of) the good-doers","সৎকর্মশীলদের"]],"t":"وَ<h>ٱ</>صْبِرْ فَإِ<g>نَّ</> <h>ٱ</>للَّهَ لَا يُضِيعُ أَ<q>جْ</>رَ <h>ٱ</>لْمُحْسِ<p>نِي</>نَ"},{"n":116,"w":[["فَلَوْلَا","falawlā","So why not","অতঃপর কেন না"],["كَانَ","kāna","had been","(বর্তমান) ছিলো"],["مِنَ","mina","of","মধ্য হ'তে"],["ٱلْقُرُونِ","l-qurūni","the generations","জাতিসমূহের"],["مِن","min","before you","থেকে"],["قَبْلِكُمْ","qablikum","before you","পূর্ব তোমাদের"],["أُو۟لُوا۟","ulū","those possessing a remnant","সম্পন্নরা"],["بَقِيَّةٍۢ","baqiyyatin","those possessing a remnant","অবশিষ্ট"],["يَنْهَوْنَ","yanhawna","forbidding","(যারা) নিষেধ করতো"],["عَنِ","‘ani","from","হ'তে"],["ٱلْفَسَادِ","l-fasādi","the corruption","বিপর্যয়"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["إِلَّا","illā","except","তবে ব্যতিক্রম"],["قَلِيلًۭا","qalīlan","a few","স্বল্প সংখ্যক লোক"],["مِّمَّنْ","mimman","of those","মধ্যকার তাদের"],["أَنجَيْنَا","anjaynā","We saved","আমরা রক্ষা করেছিলাম (যাদেরকে)"],["مِنْهُمْ ۗ","min'hum","among them","তাদের মধ্যে হ'তে"],["وَٱتَّبَعَ","wa-ittaba‘a","But followed","এবং অনুসরণ করতো"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["ظَلَمُوا۟","ẓalamū","did wrong","সীমালঙ্ঘন করেছিলো"],["مَآ","mā","what","(তারই) যা"],["أُتْرِفُوا۟","ut'rifū","luxury they were given","তাদের সুখ-সুবিধা দেয়া হয়েছিলো"],["فِيهِ","fīhi","therein","মধ্যে তার"],["وَكَانُوا۟","wakānū","and they were","এবং তারা ছিলো"],["مُجْرِمِينَ","muj'rimīna","criminals","অপরাধী"]],"t":"فَلَوْلَا كَانَ مِنَ <h>ٱ</>لْقُرُونِ مِ<k>ن قَ</><q>بْ</>لِكُمْ أُ<s>و۟</>لُو<s>ا۟</> بَقِيَّ<d>ةٍۢ يَ</>نْهَوْنَ عَنِ <h>ٱ</>لْفَسَادِ فِى <h>ٱ</>لْأَرْضِ إِلَّا قَلِيلًۭ<d>ا مِّ</><g>مَّ</>نْ أَ<k>نجَ</>يْنَا مِنْهُمْ ۗ وَ<h>ٱ</>تَّبَعَ <h>ٱ</>لَّذِينَ ظَلَمُو<s>ا۟</> <o>مَآ</> أُتْرِفُو<s>ا۟</> فِيهِ وَكَانُو<s>ا۟</> مُ<q>جْ</>رِ<p>مِي</>نَ"},{"n":117,"w":[["وَمَا","wamā","And not","এবং না"],["كَانَ","kāna","would","ছিলেন"],["رَبُّكَ","rabbuka","your Lord","তোমার রব (এমন যে)"],["لِيُهْلِكَ","liyuh'lika","destroy","যাতে তিনি ধ্বংস করবেন"],["ٱلْقُرَىٰ","l-qurā","the cities","জনবসতিগুলোকে"],["بِظُلْمٍۢ","biẓul'min","unjustly","ভাবে অন্যায়"],["وَأَهْلُهَا","wa-ahluhā","while its people","অথচ তার অধিবাসীরা (ছিলো)"],["مُصْلِحُونَ","muṣ'liḥūna","(were) reformers","সংশোধনকারী"]],"t":"وَمَا كَانَ رَبُّكَ لِيُهْلِكَ <h>ٱ</>لْقُرَىٰ بِظُلْ<d>مٍۢ وَ</>أَهْلُهَا مُصْلِ<p>حُو</>نَ"},{"n":118,"w":[["وَلَوْ","walaw","And if","এবং যদি"],["شَآءَ","shāa","your Lord (had) willed","ইচ্ছে করতেন"],["رَبُّكَ","rabbuka","your Lord (had) willed","তোমার রব"],["لَجَعَلَ","laja‘ala","surely He (could) have made","অবশ্যই বানাতে পারতেন"],["ٱلنَّاسَ","l-nāsa","the mankind","সব মানুষকে"],["أُمَّةًۭ","ummatan","one community","জাতি"],["وَٰحِدَةًۭ ۖ","wāḥidatan","one community","একই"],["وَلَا","walā","but not","কিন্তু (তবুও) না"],["يَزَالُونَ","yazālūna","they will cease","তারা সর্বদা হতো"],["مُخْتَلِفِينَ","mukh'talifīna","to differ","মতবিরোধকারী"]],"t":"وَلَوْ <o>شَآ</>ءَ رَبُّكَ لَجَعَلَ <h>ٱ</><l>ل</><g>نَّ</>اسَ أُ<g>مَّ</><d>ةًۭ وَٰ</>حِدَ<d>ةًۭ ۖ وَ</>لَا يَزَالُونَ مُخْتَلِ<p>فِي</>نَ"},{"n":119,"w":[["إِلَّا","illā","Except","তবে"],["مَن","man","(on) whom","যাকে"],["رَّحِمَ","raḥima","your Lord has bestowed Mercy","অনুগ্রহ করতেন"],["رَبُّكَ ۚ","rabbuka","your Lord has bestowed Mercy","তোমার রব (সেটা ভিন্ন কথা)"],["وَلِذَٰلِكَ","walidhālika","and for that","এবং এ কারণে"],["خَلَقَهُمْ ۗ","khalaqahum","He created them","তাদের সৃষ্টি করেছেন (স্বাধীনতা দিয়ে)"],["وَتَمَّتْ","watammat","And will be fulfilled","এবং (এভাবে) সম্পূর্ণ হলো"],["كَلِمَةُ","kalimatu","(the) Word of your Lord","একটি বাণী"],["رَبِّكَ","rabbika","(the) Word of your Lord","তোমার রবের (যে)"],["لَأَمْلَأَنَّ","la-amla-anna","Surely I will fill","\"অবশ্যই ভরে দিবো আমি"],["جَهَنَّمَ","jahannama","Hell","জাহান্নামকে"],["مِنَ","mina","with","দিয়ে"],["ٱلْجِنَّةِ","l-jinati","the Jinn","জিন"],["وَٱلنَّاسِ","wal-nāsi","and the men","এবং মানুষ"],["أَجْمَعِينَ","ajma‘īna","all together","একত্রেই\""]],"t":"إِلَّا <w>مَن رَّ</>حِمَ رَبُّكَ ۚ وَلِ<m>ذَٰ</>لِكَ خَلَقَهُمْ ۗ وَتَ<g>مَّ</>تْ كَلِمَةُ رَبِّكَ لَأَمْلَأَ<g>نَّ</> جَهَ<g>نَّ</>مَ مِنَ <h>ٱ</>لْجِ<g>نَّ</>ةِ وَ<h>ٱ</><l>ل</><g>نَّ</>اسِ أَ<q>جْ</>مَ<p>عِي</>نَ"},{"n":120,"w":[["وَكُلًّۭا","wakullan","And each","এবং সব (কিছুই)"],["نَّقُصُّ","naquṣṣu","We relate","আমরা বর্ণনা করছি"],["عَلَيْكَ","‘alayka","to you","তোমার কাছে"],["مِنْ","min","of","হ'তে"],["أَنۢبَآءِ","anbāi","(the) news","সংবাদ"],["ٱلرُّسُلِ","l-rusuli","(of) the Messengers","রাসূলদের"],["مَا","mā","(for) that","যা"],["نُثَبِّتُ","nuthabbitu","We may make firm","আমরা সুদৃঢ় করছি"],["بِهِۦ","bihi","with it","তা দিয়ে"],["فُؤَادَكَ ۚ","fuādaka","your heart","তোমার হৃদয়কে"],["وَجَآءَكَ","wajāaka","And has come to you","এবং তোমার কাছে এসেছে"],["فِى","fī","in","মধ্যে"],["هَـٰذِهِ","hādhihi","this","এর"],["ٱلْحَقُّ","l-ḥaqu","the truth","প্রকৃত সত্য"],["وَمَوْعِظَةٌۭ","wamaw‘iẓatun","and an admonition","এবং উপদেশ"],["وَذِكْرَىٰ","wadhik'rā","and a reminder","ও সাবধান বাণী"],["لِلْمُؤْمِنِينَ","lil'mu'minīna","for the believers","মু'মিনদের জন্যে"]],"t":"وَكُ<d>لًّۭا نَّ</>قُصُّ عَلَيْكَ مِنْ أَ<i>نۢبَ</><o>آ</>ءِ <h>ٱ</><l>ل</>رُّسُلِ مَا نُثَبِّتُ بِ<m>هِۦ</> فُؤَادَكَ ۚ وَ<o>جَآ</>ءَكَ فِى <m>هَٰ</>ذِهِ <h>ٱ</>لْحَقُّ وَمَوْعِظَ<d>ةٌۭ وَ</>ذِكْرَىٰ لِلْمُؤْمِ<p>نِي</>نَ"},{"n":121,"w":[["وَقُل","waqul","And say","এবং বলো"],["لِّلَّذِينَ","lilladhīna","to those who","(তাদের জন্যে) যারা"],["لَا","lā","(do) not","না"],["يُؤْمِنُونَ","yu'minūna","believe","ঈমান আনে"],["ٱعْمَلُوا۟","i‘'malū","Work","\"তোমরা কাজ করো"],["عَلَىٰ","‘alā","(according) to","উপর"],["مَكَانَتِكُمْ","makānatikum","your position","তোমদের জায়গার"],["إِنَّا","innā","indeed, we","নিশ্চয়ই আমরাও"],["عَـٰمِلُونَ","‘āmilūna","(are also) working","কাজ করে যাচ্ছি"]],"t":"وَقُل لِّلَّذِينَ لَا يُؤْمِنُونَ <h>ٱ</>عْمَلُو<s>ا۟</> عَلَىٰ مَكَانَتِكُمْ إِ<g>نَّ</>ا <m>عَٰ</>مِ<p>لُو</>نَ"},{"n":122,"w":[["وَٱنتَظِرُوٓا۟","wa-intaẓirū","And wait","এবং তোমরা অপেক্ষা করো"],["إِنَّا","innā","indeed, we","নিশ্চয়ই আমরাও"],["مُنتَظِرُونَ","muntaẓirūna","(are) ones who wait","প্রতীক্ষাকারী\""]],"t":"وَ<h>ٱ</><k>نتَ</>ظِ<o>رُوٓ</><s>ا۟</> إِ<g>نَّ</>ا مُ<k>نتَ</>ظِ<p>رُو</>نَ"},{"n":123,"w":[["وَلِلَّهِ","walillahi","And for Allah","এবং আল্লাহর (আছে জ্ঞান)"],["غَيْبُ","ghaybu","(is the) unseen","অদৃশ্যের"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশসমূহের"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীর"],["وَإِلَيْهِ","wa-ilayhi","and to Him","এবং তাঁরই দিকে"],["يُرْجَعُ","yur'ja‘u","will be returned","ফিরিয়ে আনা হবে"],["ٱلْأَمْرُ","l-amru","the matter","ব্যাপার"],["كُلُّهُۥ","kulluhu","all (of) it","সবই"],["فَٱعْبُدْهُ","fa-u‘'bud'hu","so worship Him","অতএব তাঁরই ইবাদত করো"],["وَتَوَكَّلْ","watawakkal","and put your trust","ভরসা করো"],["عَلَيْهِ ۚ","‘alayhi","upon Him","তাঁরই উপর"],["وَمَا","wamā","And your Lord is not","এবং নন"],["رَبُّكَ","rabbuka","And your Lord is not","তোমার রব"],["بِغَـٰفِلٍ","bighāfilin","unaware","অনবহিত"],["عَمَّا","‘ammā","of what","তা হ'তে যা"],["تَعْمَلُونَ","ta‘malūna","you do","তোমরা কাজ করছো"]],"t":"وَلِلَّهِ غَيْبُ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ وَإِلَيْهِ يُرْجَعُ <h>ٱ</>لْأَمْرُ كُلُّهُ<m>ۥ</> فَ<h>ٱ</>عْبُ<q>دْ</>هُ وَتَوَكَّلْ عَلَيْهِ ۚ وَمَا رَبُّكَ بِ<m>غَٰ</>فِلٍ عَ<g>مَّ</>ا تَعْمَ<p>لُو</>نَ"}]}