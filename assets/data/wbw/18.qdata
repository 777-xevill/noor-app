{"n":18,"a":[{"n":1,"w":[["ٱلْحَمْدُ","al-ḥamdu","All Praise","সকল প্রশংসা"],["لِلَّهِ","lillahi","(is) for Allah","জন্যে আল্লাহর"],["ٱلَّذِىٓ","alladhī","the One Who","যিনি"],["أَنزَلَ","anzala","(has) revealed","অবতীর্ণ করেছেন"],["عَلَىٰ","‘alā","to","উপর"],["عَبْدِهِ","‘abdihi","His slave","তাঁর দাসের"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","এই গ্রন্থ"],["وَلَمْ","walam","and not","এবং"],["يَجْعَل","yaj‘al","(has) made","রাখেননি"],["لَّهُۥ","lahu","in it","জন্যে তার"],["عِوَجَاۜ","‘iwajā","any crookedness","কোনো বক্রতা"]],"t":"ٱلْحَمْدُ لِلَّهِ <h>ٱ</>لَّ<o>ذِىٓ</> أَ<k>نزَ</>لَ عَلَىٰ عَ<q>بْ</>دِهِ <h>ٱ</>لْكِ<m>تَٰ</>بَ وَلَمْ يَ<q>جْ</>عَل لَّهُ<m>ۥ</> عِوَجَا ۜ"},{"n":2,"w":[["قَيِّمًۭا","qayyiman","Straight","দৃঢ়ভাবে প্রতিষ্ঠিত"],["لِّيُنذِرَ","liyundhira","to warn","জন্যে সতর্ক করার"],["بَأْسًۭا","basan","(of) a punishment","শাস্তি (সম্পর্কে)"],["شَدِيدًۭا","shadīdan","severe","কঠিন"],["مِّن","min","from","থেকে"],["لَّدُنْهُ","ladun'hu","near Him","তাঁর পক্ষ"],["وَيُبَشِّرَ","wayubashira","and give glad tidings","এবং সুসংবাদ দেয়"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","(to) the believers","মু'মিনদেরকে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["يَعْمَلُونَ","ya‘malūna","do","কাজ করে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","righteous deeds","সৎ"],["أَنَّ","anna","that","যে"],["لَهُمْ","lahum","for them","জন্যে তাদের আছে"],["أَجْرًا","ajran","(is) a good reward","পুরস্কার"],["حَسَنًۭا","ḥasanan","(is) a good reward","উত্তম"]],"t":"قَيِّ<w>مًۭا لِّ</>يُ<k>نذِ</>رَ بَأْ<k>سًۭا شَ</>دِي<d>دًۭا مِّ</><w>ن لَّ</>دُنْهُ وَيُبَشِّرَ <h>ٱ</>لْمُؤْمِنِينَ <h>ٱ</>لَّذِينَ يَعْمَلُونَ <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ أَ<g>نَّ</> لَهُمْ أَ<q>جْ</>رًا حَسَنًۭا"},{"n":3,"w":[["مَّـٰكِثِينَ","mākithīna","(They will) abide","তারা বসবাসকারী (হবে)"],["فِيهِ","fīhi","in it","মধ্যে তার"],["أَبَدًۭا","abadan","forever","চিরকাল"]],"t":"<m>مَّٰ</>كِثِينَ فِيهِ أَبَدًۭا"},{"n":4,"w":[["وَيُنذِرَ","wayundhira","And to warn","এবং সতর্ক করে"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["قَالُوا۟","qālū","say","বলে"],["ٱتَّخَذَ","ittakhadha","Allah has taken","\"গ্রহণ করেছেন"],["ٱللَّهُ","l-lahu","Allah has taken","\"আল্লাহ"],["وَلَدًۭا","waladan","a son","সন্তান\""]],"t":"وَيُ<k>نذِ</>رَ <h>ٱ</>لَّذِينَ قَالُو<s>ا۟</> <h>ٱ</>تَّخَذَ <h>ٱ</>للَّهُ وَلَدًۭا"},{"n":5,"w":[["مَّا","mā","Not","নেই"],["لَهُم","lahum","they have","কাছে তাদের"],["بِهِۦ","bihi","about it","সম্পর্কে সে"],["مِنْ","min","any","কোনো"],["عِلْمٍۢ","‘il'min","knowledge","জ্ঞান"],["وَلَا","walā","and not","এবং না (আছে)"],["لِـَٔابَآئِهِمْ ۚ","liābāihim","their forefathers","কাছে পিতৃপুরুষদের তাদের"],["كَبُرَتْ","kaburat","Grave (is)","সাংঘাতিক"],["كَلِمَةًۭ","kalimatan","the word","কথা"],["تَخْرُجُ","takhruju","(that) comes out","তা বের হয়"],["مِنْ","min","of","থেকে"],["أَفْوَٰهِهِمْ ۚ","afwāhihim","their mouths","মুখগুলোর তাদের"],["إِن","in","Not","না"],["يَقُولُونَ","yaqūlūna","they say","তারা বলে"],["إِلَّا","illā","except","ছাড়া"],["كَذِبًۭا","kadhiban","a lie","মিথ্যা"]],"t":"مَّا لَ<f>هُم بِ</><m>هِۦ</> مِنْ عِلْ<d>مٍۢ وَ</>لَا لِءَا<o>بَآ</>ئِهِمْ ۚ كَبُرَتْ كَلِمَ<k>ةًۭ تَ</>خْرُجُ مِنْ أَفْ<m>وَٰ</>هِهِمْ ۚ <d>إِن يَ</>قُولُونَ إِلَّا كَذِبًۭا"},{"n":6,"w":[["فَلَعَلَّكَ","fala‘allaka","Then perhaps you would (be)","তবে তুমি সম্ভবতঃ"],["بَـٰخِعٌۭ","bākhi‘un","the one who kills","বিনাশকারী হবে"],["نَّفْسَكَ","nafsaka","yourself","তোমার প্রাণ"],["عَلَىٰٓ","‘alā","over","থেকে থেকে"],["ءَاثَـٰرِهِمْ","āthārihim","their footsteps","পিছনে তাদের"],["إِن","in","if","যদি"],["لَّمْ","lam","not","না"],["يُؤْمِنُوا۟","yu'minū","they believe","তারা ঈমান আনে"],["بِهَـٰذَا","bihādhā","in this","উপর এই"],["ٱلْحَدِيثِ","l-ḥadīthi","[the] narration","কথার"],["أَسَفًا","asafan","(in) grief","দুঃখে"]],"t":"فَلَعَلَّكَ <m>بَٰ</>خِ<d>عٌۭ نَّ</>فْسَكَ عَلَ<o>ىٰٓ</> ءَا<m>ثَٰ</>رِهِمْ <w>إِن لَّ</>مْ يُؤْمِنُو<s>ا۟</> بِ<m>هَٰ</>ذَا <h>ٱ</>لْحَدِيثِ أَسَفًا"},{"n":7,"w":[["إِنَّا","innā","Indeed, We","নিশ্চয়ই আমরা"],["جَعَلْنَا","ja‘alnā","We have made","আমরা বানিয়েছি"],["مَا","mā","what","যা (আছে)"],["عَلَى","‘alā","(is) on","উপর"],["ٱلْأَرْضِ","l-arḍi","the earth","জমিনের"],["زِينَةًۭ","zīnatan","adornment","শোভা"],["لَّهَا","lahā","for it","জন্যে তার"],["لِنَبْلُوَهُمْ","linabluwahum","that We may test [them]","যাতে পরীক্ষা করি আমরা তাদেরকে"],["أَيُّهُمْ","ayyuhum","which of them","কে মধ্যে তাদের"],["أَحْسَنُ","aḥsanu","(is) best","উত্তম"],["عَمَلًۭا","‘amalan","(in) deed","কাজে"]],"t":"إِ<g>نَّ</>ا جَعَلْنَا مَا عَلَى <h>ٱ</>لْأَرْضِ زِينَ<w>ةًۭ لَّ</>هَا لِنَ<q>بْ</>لُوَهُمْ أَيُّهُمْ أَحْسَنُ عَمَلًۭا"},{"n":8,"w":[["وَإِنَّا","wa-innā","And indeed, We","এবং নিশ্চয়ই আমরা"],["لَجَـٰعِلُونَ","lajā‘ilūna","(will) surely make","অবশ্যই পরিণতকারী"],["مَا","mā","what","যা আছে"],["عَلَيْهَا","‘alayhā","(is) on it","উপর তার"],["صَعِيدًۭا","ṣa‘īdan","soil","ভূমি"],["جُرُزًا","juruzan","barren","বিরান"]],"t":"وَإِ<g>نَّ</>ا لَ<m>جَٰ</>عِلُونَ مَا عَلَيْهَا صَعِي<k>دًۭا جُ</>رُزًا"},{"n":9,"w":[["أَمْ","am","Or","কি"],["حَسِبْتَ","ḥasib'ta","have you thought","তুমি মনে করেছো"],["أَنَّ","anna","that","যে"],["أَصْحَـٰبَ","aṣḥāba","(the) companions","অধিবাসীরা"],["ٱلْكَهْفِ","l-kahfi","(of) the cave","গুহার"],["وَٱلرَّقِيمِ","wal-raqīmi","and the inscription","ও রাকীমের"],["كَانُوا۟","kānū","were","ছিলো"],["مِنْ","min","among","মধ্য থেকে"],["ءَايَـٰتِنَا","āyātinā","Our Signs","আমাদের নিদর্শনগুলোর"],["عَجَبًا","‘ajaban","a wonder","আশ্চর্যজনক"]],"t":"أَمْ حَسِ<q>بْ</>تَ أَ<g>نَّ</> أَصْ<m>حَٰ</>بَ <h>ٱ</>لْكَهْفِ وَ<h>ٱ</><l>ل</>رَّقِيمِ كَانُو<s>ا۟</> مِنْ ءَا<m>يَٰ</>تِنَا عَجَبًا"},{"n":10,"w":[["إِذْ","idh","When","যখন"],["أَوَى","awā","retreated","আশ্রয় নিয়েছিলো"],["ٱلْفِتْيَةُ","l-fit'yatu","the youths","যুবকরা"],["إِلَى","ilā","to","মধ্যে"],["ٱلْكَهْفِ","l-kahfi","the cave","গুহার"],["فَقَالُوا۟","faqālū","and they said","তখন তারা বলেছিলো"],["رَبَّنَآ","rabbanā","Our Lord","\"হে আমাদের রব"],["ءَاتِنَا","ātinā","Grant us","আমাদের দাও"],["مِن","min","from","থেকে"],["لَّدُنكَ","ladunka","Yourself","তোমার পক্ষ"],["رَحْمَةًۭ","raḥmatan","Mercy","অনুগ্রহ"],["وَهَيِّئْ","wahayyi","and facilitate","এবং ব্যবস্হা করে দাও"],["لَنَا","lanā","for us","জন্যে আমাদের"],["مِنْ","min","[from]","থেকে"],["أَمْرِنَا","amrinā","our affair","আমাদের কাজ"],["رَشَدًۭا","rashadan","(in the) right way","সুষ্ঠ ভাবে\""]],"t":"إِذْ أَوَى <h>ٱ</>لْفِتْيَةُ إِلَى <h>ٱ</>لْكَهْفِ فَقَالُو<s>ا۟</> رَبَّ<o>نَآ</> ءَاتِنَا <w>مِن لَّ</>دُ<k>نكَ</> رَحْمَ<d>ةًۭ وَ</>هَيِّئْ لَنَا مِنْ أَمْرِنَا رَشَدًۭا"},{"n":11,"w":[["فَضَرَبْنَا","faḍarabnā","So We cast","অতঃপর আমরা (ঘুমের পর্দা) দিলাম"],["عَلَىٰٓ","‘alā","over","উপর"],["ءَاذَانِهِمْ","ādhānihim","their ears","কানগুলোর তাদের"],["فِى","fī","in","মধ্যে"],["ٱلْكَهْفِ","l-kahfi","the cave","গুহার"],["سِنِينَ","sinīna","years ","বছর"],["عَدَدًۭا","‘adadan","a number","কয়েক"]],"t":"فَضَرَ<q>بْ</>نَا عَلَ<o>ىٰٓ</> ءَاذَانِهِمْ فِى <h>ٱ</>لْكَهْفِ سِنِينَ عَدَدًۭا"},{"n":12,"w":[["ثُمَّ","thumma","Then","এরপর"],["بَعَثْنَـٰهُمْ","ba‘athnāhum","We raised them up","আমরা জাগালাম তাদের"],["لِنَعْلَمَ","lina‘lama","that We make evident","যেন আমরা জানি"],["أَىُّ","ayyu","which","কোনটি"],["ٱلْحِزْبَيْنِ","l-ḥiz'bayni","(of) the two parties","দু'দলের"],["أَحْصَىٰ","aḥṣā","best calculated","হিসাব করেছিলো (সঠিক)"],["لِمَا","limā","for what","জন্যে যা"],["لَبِثُوٓا۟","labithū","(they had) remained","তারা অবস্থান করেছিলো"],["أَمَدًۭا","amadan","(in) time","সময়কাল"]],"t":"ثُ<g>مَّ</> بَعَثْ<m>نَٰ</>هُمْ لِنَعْلَمَ أَىُّ <h>ٱ</>لْحِزْبَيْنِ أَحْصَىٰ لِمَا لَبِ<o>ثُوٓ</><s>ا۟</> أَمَدًۭا"},{"n":13,"w":[["نَّحْنُ","naḥnu","We","আমরা"],["نَقُصُّ","naquṣṣu","narrate","বর্ণনা করছি"],["عَلَيْكَ","‘alayka","to you","কাছে তোমার"],["نَبَأَهُم","naba-ahum","their story","খবর তাদের"],["بِٱلْحَقِّ ۚ","bil-ḥaqi","in truth","ভাবে সঠিক"],["إِنَّهُمْ","innahum","Indeed, they (were)","নিশ্চয়ই তারা"],["فِتْيَةٌ","fit'yatun","youths","যুবক (ছিলো)"],["ءَامَنُوا۟","āmanū","who believed","ঈমান এনেছিলো"],["بِرَبِّهِمْ","birabbihim","in their Lord","উপর রবের তাদের"],["وَزِدْنَـٰهُمْ","wazid'nāhum","and We increased them","এবং আমরা বাড়িয়ে দিয়েছিলাম তাদের"],["هُدًۭى","hudan","(in) guidance","পথের দিশা"]],"t":"نَّحْنُ نَقُصُّ عَلَيْكَ نَبَأَ<f>هُم بِ</><h>ٱ</>لْحَقِّ ۚ إِ<g>نَّ</>هُمْ فِتْيَةٌ ءَامَنُو<s>ا۟</> بِرَبِّهِمْ وَزِ<q>دْ</><m>نَٰ</>هُمْ هُدًۭى"},{"n":14,"w":[["وَرَبَطْنَا","warabaṭnā","And We made firm","এবং আমরা দৃঢ় করেছিলাম"],["عَلَىٰ","‘alā","[on]","উপর"],["قُلُوبِهِمْ","qulūbihim","their hearts","অন্তরগুলো তাদের"],["إِذْ","idh","when","যখন"],["قَامُوا۟","qāmū","they stood up","তারা দাঁড়িয়েছিলো"],["فَقَالُوا۟","faqālū","and said","তখন তারা বলেছিলো"],["رَبُّنَا","rabbunā","Our Lord","\"আমাদের রব"],["رَبُّ","rabbu","(is) the Lord","রব"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশসমূহের"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","এবং পৃথিবীর"],["لَن","lan","Never","কখনও না"],["نَّدْعُوَا۟","nad‘uwā","we will invoke","আমরা ডাকবো"],["مِن","min","besides Him","ছাড়া"],["دُونِهِۦٓ","dūnihi","besides Him","তাকে"],["إِلَـٰهًۭا ۖ","ilāhan","any god","(অন্য) ইলাহকে"],["لَّقَدْ","laqad","Certainly","নিশ্চয়ই (যদি করি)"],["قُلْنَآ","qul'nā","we would have said","আমরা বলবো"],["إِذًۭا","idhan","then","তাহ'লে"],["شَطَطًا","shaṭaṭan","an enormity","গর্হিত (কথা)"]],"t":"وَرَبَ<q>طْ</>نَا عَلَىٰ قُلُوبِهِمْ إِذْ قَامُو<s>ا۟</> فَقَالُو<s>ا۟</> رَبُّنَا رَبُّ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ <d>لَن نَّ</><q>دْ</>عُوَ<s>ا۟</> مِ<k>ن دُ</>ونِ<o>هِۦٓ</> إِ<m>لَٰ</><w>هًۭا ۖ لَّ</>قَ<q>دْ</> قُلْ<o>نَآ</> إِ<k>ذًۭا شَ</>طَطًا"},{"n":15,"w":[["هَـٰٓؤُلَآءِ","hāulāi","These","এসব"],["قَوْمُنَا","qawmunā","our people","আমার স্বজাতির লোক"],["ٱتَّخَذُوا۟","ittakhadhū","have taken","গ্রহণ করেছে"],["مِن","min","besides Him","ছাড়া"],["دُونِهِۦٓ","dūnihi","besides Him","তাঁকে"],["ءَالِهَةًۭ ۖ","ālihatan","gods","বহু উপাস্য"],["لَّوْلَا","lawlā","Why not","কেন না"],["يَأْتُونَ","yatūna","they come","তারা আসে"],["عَلَيْهِم","‘alayhim","to them","কাছে তাদের"],["بِسُلْطَـٰنٍۭ","bisul'ṭānin","with an authority","নিয়ে প্রমাণ"],["بَيِّنٍۢ ۖ","bayyinin","clear","সুস্পষ্ট"],["فَمَنْ","faman","And who","অতঃপর কে"],["أَظْلَمُ","aẓlamu","(is) more wrong","অধিক সীমালঙ্ঘনকারী"],["مِمَّنِ","mimmani","than (one) who","তার চেয়ে যে"],["ٱفْتَرَىٰ","if'tarā","invents","আরোপ করে"],["عَلَى","‘alā","against","উপর"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌র"],["كَذِبًۭا","kadhiban","a lie","মিথ্যা"]],"t":"<o>هَٰٓؤُلَآ</>ءِ قَوْمُنَا <h>ٱ</>تَّخَذُو<s>ا۟</> مِ<k>ن دُ</>ونِ<o>هِۦٓ</> ءَالِهَ<w>ةًۭ ۖ لَّ</>وْلَا يَأْتُونَ عَلَيْ<f>هِم بِ</>سُلْ<m>طَٰ</><i>نٍۭ بَ</>يِّ<k>نٍۢ ۖ فَ</>مَنْ أَظْلَمُ مِ<g>مَّ</>نِ <h>ٱ</>فْتَرَىٰ عَلَى <h>ٱ</>للَّهِ كَذِبًۭا"},{"n":16,"w":[["وَإِذِ","wa-idhi","And when","এবং যখন"],["ٱعْتَزَلْتُمُوهُمْ","i‘'tazaltumūhum","you withdraw from them","তোমরা বিচ্ছিন্ন হয়েছো তাদের (থেকে)"],["وَمَا","wamā","and what","এবং যাদের"],["يَعْبُدُونَ","ya‘budūna","they worship","তারা উপাসনা করে"],["إِلَّا","illā","except","ছাড়া"],["ٱللَّهَ","l-laha","Allah","আল্লাহ্‌র"],["فَأْوُۥٓا۟","fawū","then retreat","তাহ'লে আশ্রয় নাও"],["إِلَى","ilā","to","মধ্যে"],["ٱلْكَهْفِ","l-kahfi","the cave","গুহার"],["يَنشُرْ","yanshur","Will spread","প্রশস্ত করবেন"],["لَكُمْ","lakum","for you","জন্যে তোমাদের"],["رَبُّكُم","rabbukum","your Lord","রব তোমাদের"],["مِّن","min","of","সাহায্যে"],["رَّحْمَتِهِۦ","raḥmatihi","His Mercy","তাঁর অনুগ্রহের"],["وَيُهَيِّئْ","wayuhayyi","and will facilitate","এবং তৈরি করে দিবেন"],["لَكُم","lakum","for you","জন্যে তোমাদের"],["مِّنْ","min","[from]","থেকে"],["أَمْرِكُم","amrikum","your affair","কাজ তোমাদের"],["مِّرْفَقًۭا","mir'faqan","(in) ease","ফলপ্রসূ\""]],"t":"وَإِذِ <h>ٱ</>عْتَزَلْتُمُوهُمْ وَمَا يَعْبُدُونَ إِلَّا <h>ٱ</>للَّهَ فَأْوُ<o>ۥٓا۟</> إِلَى <h>ٱ</>لْكَهْفِ يَ<k>نشُ</>رْ لَكُمْ رَبُّ<y>كُم مِّ</><w>ن رَّ</>حْمَتِ<m>هِۦ</> وَيُهَيِّئْ لَ<y>كُم مِّ</>نْ أَمْرِ<y>كُم مِّ</>رْفَقًۭا"},{"n":17,"w":[["۞ وَتَرَى","watarā","And you (might) have seen","এবং তুমি দেখবে"],["ٱلشَّمْسَ","l-shamsa","the sun","সূর্যকে"],["إِذَا","idhā","when","যখন"],["طَلَعَت","ṭala‘at","it rose","উদয় হয়"],["تَّزَٰوَرُ","tazāwaru","inclining away","সরে যায়"],["عَن","‘an","from","থেকে"],["كَهْفِهِمْ","kahfihim","their cave","গুহা তাদের"],["ذَاتَ","dhāta","to","পাশ দিয়ে"],["ٱلْيَمِينِ","l-yamīni","the right","ডান"],["وَإِذَا","wa-idhā","and when","এবং যখন"],["غَرَبَت","gharabat","it set","অস্ত যায়"],["تَّقْرِضُهُمْ","taqriḍuhum","passing away from them","তা অতিক্রম করে তাদেরকে"],["ذَاتَ","dhāta","to","পাশ দিয়ে"],["ٱلشِّمَالِ","l-shimāli","the left","বাম"],["وَهُمْ","wahum","while they","অথচ তারা"],["فِى","fī","(lay) in","মধ্যে"],["فَجْوَةٍۢ","fajwatin","the open space","প্রশস্ত চত্বরের"],["مِّنْهُ ۚ","min'hu","thereof","থেকে তা"],["ذَٰلِكَ","dhālika","That","এটা"],["مِنْ","min","(was) from","মধ্য থেকে"],["ءَايَـٰتِ","āyāti","(the) Signs","নিদর্শনাদির"],["ٱللَّهِ ۗ","l-lahi","(of) Allah","আল্লাহ্‌র"],["مَن","man","Whoever","যাকে"],["يَهْدِ","yahdi","Allah guides","পথ দেখান"],["ٱللَّهُ","l-lahu","Allah guides","আল্লাহ্‌"],["فَهُوَ","fahuwa","and he","অতঃপর সেই"],["ٱلْمُهْتَدِ ۖ","l-muh'tadi","(is) the guided one","সঠিক পথপ্রাপ্ত"],["وَمَن","waman","and whoever","এবং যাকে"],["يُضْلِلْ","yuḍ'lil","He lets go astray","পথভ্রষ্ট করেন"],["فَلَن","falan","then never","তখন কখনও না"],["تَجِدَ","tajida","you will find","তুমি পাবে"],["لَهُۥ","lahu","for him","জন্যে তার"],["وَلِيًّۭا","waliyyan","a protector","কোনো অভিভাবক"],["مُّرْشِدًۭا","mur'shidan","a guide","কোনো পথ প্রদর্শক"]],"t":"۞ وَتَرَى <h>ٱ</><l>ل</>شَّمْسَ إِذَا طَلَعَت تَّ<m>زَٰ</>وَرُ عَ<k>ن كَ</>هْفِهِمْ ذَاتَ <h>ٱ</>لْيَمِينِ وَإِذَا غَرَبَت تَّ<q>قْ</>رِضُهُمْ ذَاتَ <h>ٱ</><l>ل</>شِّمَالِ وَهُمْ فِى فَ<q>جْ</>وَ<d>ةٍۢ مِّ</>نْهُ ۚ <m>ذَٰ</>لِكَ مِنْ ءَا<m>يَٰ</>تِ <h>ٱ</>للَّهِ ۗ <d>مَن يَ</>هْدِ <h>ٱ</>للَّهُ فَهُوَ <h>ٱ</>لْمُهْتَدِ ۖ وَ<d>مَن يُ</>ضْلِلْ فَلَ<k>ن تَ</>جِدَ لَهُ<m>ۥ</> وَلِ<d>يًّۭا مُّ</>رْشِدًۭا"},{"n":18,"w":[["وَتَحْسَبُهُمْ","wataḥsabuhum","And you (would) think them","এবং তুমি মনে করবে তাদের"],["أَيْقَاظًۭا","ayqāẓan","awake","জাগ্রত"],["وَهُمْ","wahum","while they","অথচ তারা (ছিলো)"],["رُقُودٌۭ ۚ","ruqūdun","(were) asleep","ঘুমন্ত"],["وَنُقَلِّبُهُمْ","wanuqallibuhum","And We turned them","এবং পাশ ফেরাতাম আমরা তাদের"],["ذَاتَ","dhāta","to","পাশে"],["ٱلْيَمِينِ","l-yamīni","the right","ডান"],["وَذَاتَ","wadhāta","and to","ও পাশে"],["ٱلشِّمَالِ ۖ","l-shimāli","the left","বাম"],["وَكَلْبُهُم","wakalbuhum","while their dog","এবং (ছিলো) তাদের কুকুর"],["بَـٰسِطٌۭ","bāsiṭun","stretched","প্রসারিতকারী"],["ذِرَاعَيْهِ","dhirā‘ayhi","his two forelegs","তার সামনের দু'পা"],["بِٱلْوَصِيدِ ۚ","bil-waṣīdi","at the entrance","মধ্যে গর্তের মুখের"],["لَوِ","lawi","If","যদি"],["ٱطَّلَعْتَ","iṭṭala‘ta","you had looked","উঁকি মেরে দেখতে"],["عَلَيْهِمْ","‘alayhim","at them","দিকে তাদের"],["لَوَلَّيْتَ","lawallayta","you (would) have surely turned back","অবশ্যই তুমি পিঠ ফিরাতে"],["مِنْهُمْ","min'hum","from them","থেকে তাদের"],["فِرَارًۭا","firāran","(in) flight","পালিয়ে"],["وَلَمُلِئْتَ","walamuli'ta","and surely you would have been filled","এবং অবশ্যই সঞ্চার হতো"],["مِنْهُمْ","min'hum","by them","থেকে তাদের"],["رُعْبًۭا","ru‘'ban","(with) terror","ভয়"]],"t":"وَتَحْسَبُهُمْ أَيْقَا<d>ظًۭا وَ</>هُمْ رُقُو<d>دٌۭ ۚ وَ</>نُقَلِّبُهُمْ ذَاتَ <h>ٱ</>لْيَمِينِ وَذَاتَ <h>ٱ</><l>ل</>شِّمَالِ ۖ وَكَلْبُ<f>هُم بَٰ</>سِ<k>طٌۭ ذِ</>رَاعَيْهِ بِ<h>ٱ</>لْوَصِيدِ ۚ لَوِ <h>ٱ</>طَّلَعْتَ عَلَيْهِمْ لَوَلَّيْتَ مِنْهُمْ فِرَا<d>رًۭا وَ</>لَمُلِئْتَ مِنْهُمْ رُعْبًۭا"},{"n":19,"w":[["وَكَذَٰلِكَ","wakadhālika","And similarly","এবং এভাবেই"],["بَعَثْنَـٰهُمْ","ba‘athnāhum","We raised them","আমরা উঠালাম তাদের"],["لِيَتَسَآءَلُوا۟","liyatasāalū","that they might question","যেন তারা পরস্পরে জিজ্ঞেস করে"],["بَيْنَهُمْ ۚ","baynahum","among them","মাঝে তাদের"],["قَالَ","qāla","Said","বললো"],["قَآئِلٌۭ","qāilun","a speaker","একজন কথক"],["مِّنْهُمْ","min'hum","among them","মধ্য থেকে তাদের"],["كَمْ","kam","How long","\"কত (দিন)"],["لَبِثْتُمْ ۖ","labith'tum","have you remained","অবস্থান করেছিলে তোমরা\""],["قَالُوا۟","qālū","They said","তারা বলেছিলো"],["لَبِثْنَا","labith'nā","We have remained","\"অবস্থান করেছিলাম আমরা"],["يَوْمًا","yawman","a day","একদিন"],["أَوْ","aw","or","বা"],["بَعْضَ","ba‘ḍa","a part","কিছু অংশ"],["يَوْمٍۢ ۚ","yawmin","(of) a day","একদিনের\""],["قَالُوا۟","qālū","They said","তারা বলেছিলো"],["رَبُّكُمْ","rabbukum","Your Lord","\"রব তোমাদের"],["أَعْلَمُ","a‘lamu","knows best","খুব জানেন"],["بِمَا","bimā","how long","এ সম্বন্ধে যা"],["لَبِثْتُمْ","labith'tum","you have remained","অবস্থান করেছো তোমরা"],["فَٱبْعَثُوٓا۟","fa-ib'‘athū","So send","তোমরা এখন পাঠাও"],["أَحَدَكُم","aḥadakum","one of you","তোমাদের একজনকে"],["بِوَرِقِكُمْ","biwariqikum","with this silver coin of yours","দিয়ে তোমাদের মুদ্রা"],["هَـٰذِهِۦٓ","hādhihi","with this silver coin of yours","এই"],["إِلَى","ilā","to","দিকে"],["ٱلْمَدِينَةِ","l-madīnati","the city","শহরটির"],["فَلْيَنظُرْ","falyanẓur","and let him see","তবে সে যেন দেখে"],["أَيُّهَآ","ayyuhā","which is","কোনটি"],["أَزْكَىٰ","azkā","the purest","পবিত্রতম"],["طَعَامًۭا","ṭa‘āman","food","খাদ্য"],["فَلْيَأْتِكُم","falyatikum","and let him bring to you","অতঃপর তোমাদের কাছে আসবে"],["بِرِزْقٍۢ","biriz'qin","provision","নিয়ে খাদ্য"],["مِّنْهُ","min'hu","from it","তা থেকে"],["وَلْيَتَلَطَّفْ","walyatalaṭṭaf","and let him be cautious","এবং সে যেন সতর্ক হয়"],["وَلَا","walā","And let not be aware","এবং না"],["يُشْعِرَنَّ","yush'‘iranna","And let not be aware","টের পেতে দেয়"],["بِكُمْ","bikum","about you","সম্বন্ধে তোমাদের"],["أَحَدًا","aḥadan","anyone","কাউকে\""]],"t":"وَكَ<m>ذَٰ</>لِكَ بَعَثْ<m>نَٰ</>هُمْ لِيَتَ<o>سَآ</>ءَلُو<s>ا۟</> بَيْنَهُمْ ۚ قَالَ <o>قَآ</>ئِ<d>لٌۭ مِّ</>نْهُمْ كَمْ لَبِثْتُمْ ۖ قَالُو<s>ا۟</> لَبِثْنَا يَوْمًا أَوْ بَعْضَ يَوْ<k>مٍۢ ۚ قَ</>الُو<s>ا۟</> رَبُّكُمْ أَعْلَمُ بِمَا لَبِثْتُمْ فَ<h>ٱ</><q>بْ</>عَ<o>ثُوٓ</><s>ا۟</> أَحَدَ<f>كُم بِ</>وَرِقِكُمْ <m>هَٰ</>ذِ<o>هِۦٓ</> إِلَى <h>ٱ</>لْمَدِينَةِ فَلْيَ<k>نظُ</>رْ أَيُّ<o>هَآ</> أَزْكَىٰ طَعَا<k>مًۭا فَ</>لْيَأْتِ<f>كُم بِ</>رِزْ<d>قٍۢ مِّ</>نْهُ وَلْيَتَلَطَّفْ وَلَا يُشْعِرَ<g>نَّ</> بِكُمْ أَحَدًا"},{"n":20,"w":[["إِنَّهُمْ","innahum","Indeed, [they]","\"নিশ্চয়ই তারা"],["إِن","in","if","যদি"],["يَظْهَرُوا۟","yaẓharū","they come to know","তারা টের পায়"],["عَلَيْكُمْ","‘alaykum","about you","সম্পর্কে তোমাদের"],["يَرْجُمُوكُمْ","yarjumūkum","they will stone you","পাথর মেরে হত্যা করবে তোমাদের"],["أَوْ","aw","or","অথবা"],["يُعِيدُوكُمْ","yu‘īdūkum","return you","ফিরিয়ে আনবে তোমাদের"],["فِى","fī","to","মধ্যে"],["مِلَّتِهِمْ","millatihim","their religion","ধর্মের তাদের"],["وَلَن","walan","And never","এবং কখনও না"],["تُفْلِحُوٓا۟","tuf'liḥū","will you succeed","তোমরা সফল হবে"],["إِذًا","idhan","then ","তাহ'লে"],["أَبَدًۭا","abadan","ever","কখনও\""]],"t":"إِ<g>نَّ</>هُمْ <d>إِن يَ</>ظْهَرُو<s>ا۟</> عَلَيْكُمْ يَرْجُمُوكُمْ أَوْ يُعِيدُوكُمْ فِى مِلَّتِهِمْ وَلَ<k>ن تُ</>فْلِ<o>حُوٓ</><s>ا۟</> إِذًا أَبَدًۭا"},{"n":21,"w":[["وَكَذَٰلِكَ","wakadhālika","And similarly","এবং এভাবে"],["أَعْثَرْنَا","a‘tharnā","We made known","আমরা জানিয়ে দিলাম"],["عَلَيْهِمْ","‘alayhim","about them","সম্পর্কে তাদের"],["لِيَعْلَمُوٓا۟","liya‘lamū","that they might know","যেন তারা জানে"],["أَنَّ","anna","that","যে"],["وَعْدَ","wa‘da","(the) Promise","প্রতিশ্রুতি"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহ্‌র"],["حَقٌّۭ","ḥaqqun","(is) true","সত্য"],["وَأَنَّ","wa-anna","and that","এবং (এও) যে"],["ٱلسَّاعَةَ","l-sā‘ata","(about) the Hour","ক্বিয়ামাত আসবেই"],["لَا","lā","(there is) no","নেই"],["رَيْبَ","rayba","doubt","কোনো সন্দেহ"],["فِيهَآ","fīhā","in it","মধ্যে তার"],["إِذْ","idh","When","যখন"],["يَتَنَـٰزَعُونَ","yatanāza‘ūna","they disputed","তারা পরস্পরে বিতর্ক করছিলো"],["بَيْنَهُمْ","baynahum","among themselves","মাঝে তাদের"],["أَمْرَهُمْ ۖ","amrahum","about their affair","কাজে তাদের"],["فَقَالُوا۟","faqālū","and they said","তখন তারা বলেছিলো"],["ٱبْنُوا۟","ib'nū","Construct","\"তোমরা নির্মাণ করো"],["عَلَيْهِم","‘alayhim","over them","উপর তাদের"],["بُنْيَـٰنًۭا ۖ","bun'yānan","a structure","সৌধ"],["رَّبُّهُمْ","rabbuhum","Their Lord","রব তাদের"],["أَعْلَمُ","a‘lamu","knows best","ভালো জানেন"],["بِهِمْ ۚ","bihim","about them","সম্বন্ধে তাদের\""],["قَالَ","qāla","Said","বললো"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["غَلَبُوا۟","ghalabū","prevailed","প্রবল হয়েছিলো"],["عَلَىٰٓ","‘alā","in","উপর"],["أَمْرِهِمْ","amrihim","their matter","তাদের মতের"],["لَنَتَّخِذَنَّ","lanattakhidhanna","Surely we will take","\"অবশ্যই আমরা নির্মাণ করবো"],["عَلَيْهِم","‘alayhim","over them","উপর তাদের"],["مَّسْجِدًۭا","masjidan","a place of worship","মাসজিদ\""]],"t":"وَكَ<m>ذَٰ</>لِكَ أَعْثَرْنَا عَلَيْهِمْ لِيَعْلَ<o>مُوٓ</><s>ا۟</> أَ<g>نَّ</> وَعْدَ <h>ٱ</>للَّهِ حَ<d>قٌّۭ وَ</>أَ<g>نَّ</> <h>ٱ</><l>ل</>سَّاعَةَ لَا رَيْبَ فِي<o>هَآ</> إِذْ يَتَ<m>نَٰ</>زَعُونَ بَيْنَهُمْ أَمْرَهُمْ ۖ فَقَالُو<s>ا۟</> <h>ٱ</><q>بْ</>نُو<s>ا۟</> عَلَيْ<f>هِم بُ</>نْ<m>يَٰ</><w>نًۭا ۖ رَّ</>بُّهُمْ أَعْلَمُ بِهِمْ ۚ قَالَ <h>ٱ</>لَّذِينَ غَلَبُو<s>ا۟</> عَلَ<o>ىٰٓ</> أَمْرِهِمْ لَنَتَّخِذَ<g>نَّ</> عَلَيْ<y>هِم مَّ</>سْجِدًۭا"},{"n":22,"w":[["سَيَقُولُونَ","sayaqūlūna","They say","তারা শীঘ্রই বলবে"],["ثَلَـٰثَةٌۭ","thalāthatun","(they were) three","তিন (তাদের সংখ্যা)"],["رَّابِعُهُمْ","rābi‘uhum","the forth of them","চতুর্থটি (ছিলো) তাদের"],["كَلْبُهُمْ","kalbuhum","their dog","কুকুর তাদের"],["وَيَقُولُونَ","wayaqūlūna","and they say","এবং (কিছু লোক) বলবে"],["خَمْسَةٌۭ","khamsatun","(they were) five","পাঁচ (জন)"],["سَادِسُهُمْ","sādisuhum","the sixth of them","ষষ্ঠটি তাদের"],["كَلْبُهُمْ","kalbuhum","their dog ","কুকুর তাদের"],["رَجْمًۢا","rajman","guessing","আনুমানিক (কথা)"],["بِٱلْغَيْبِ ۖ","bil-ghaybi","about the unseen","বিষয়ে অজানা"],["وَيَقُولُونَ","wayaqūlūna","and they say","এবং (কিছু লোক) বলবে"],["سَبْعَةٌۭ","sab‘atun","(they were) seven","সাত (তাদের সংখ্যা)"],["وَثَامِنُهُمْ","wathāminuhum","and the eight of them","এবং অষ্টমটি তাদের"],["كَلْبُهُمْ ۚ","kalbuhum","their dog","কুকুর তাদের"],["قُل","qul","Say","বলো"],["رَّبِّىٓ","rabbī","My Lord","\"আমার রব"],["أَعْلَمُ","a‘lamu","knows best","ভালো জানেন"],["بِعِدَّتِهِم","bi‘iddatihim","their number","সম্পর্কে তাদের সংখ্যা"],["مَّا","mā","None","না"],["يَعْلَمُهُمْ","ya‘lamuhum","knows them","জানে তাদের"],["إِلَّا","illā","except","ছাড়া"],["قَلِيلٌۭ ۗ","qalīlun","a few","অল্প (লোক)"],["فَلَا","falā","So (do) not","অতএব"],["تُمَارِ","tumāri","argue","বিতর্ক করো না"],["فِيهِمْ","fīhim","about them","বিষয়ে তাদের"],["إِلَّا","illā","except","ছাড়া"],["مِرَآءًۭ","mirāan","(with) an argument","আলোচনা"],["ظَـٰهِرًۭا","ẓāhiran","obvious","মামুলি"],["وَلَا","walā","and (do) not","এবং না"],["تَسْتَفْتِ","tastafti","inquire","জিজ্ঞেস করবে তুমি"],["فِيهِم","fīhim","about them","বিষয়ে তাদের"],["مِّنْهُمْ","min'hum","among them","মধ্য থেকে তাদের"],["أَحَدًۭا","aḥadan","(from) anyone","কাউকে\""]],"t":"سَيَقُولُونَ ثَ<m>لَٰ</>ثَ<w>ةٌۭ رَّ</>ابِعُهُمْ كَلْبُهُمْ وَيَقُولُونَ خَمْسَ<k>ةٌۭ سَ</>ادِسُهُمْ كَلْبُهُمْ رَ<q>جْ</><i>مًۢا بِ</><h>ٱ</>لْغَيْبِ ۖ وَيَقُولُونَ سَ<q>بْ</>عَ<d>ةٌۭ وَ</>ثَامِنُهُمْ كَلْبُهُمْ ۚ قُ<r>ل</> رَّ<o>بِّىٓ</> أَعْلَمُ بِعِدَّتِ<y>هِم مَّ</>ا يَعْلَمُهُمْ إِلَّا قَلِي<k>لٌۭ ۗ فَ</>لَا تُمَارِ فِيهِمْ إِلَّا مِ<o>رَآ</><k>ءًۭ ظَٰ</>هِ<d>رًۭا وَ</>لَا تَسْتَفْتِ فِي<y>هِم مِّ</>نْهُمْ أَحَدًۭا"},{"n":23,"w":[["وَلَا","walā","And (do) not","এবং না"],["تَقُولَنَّ","taqūlanna","say","বলবে কখনও"],["لِشَا۟ىْءٍ","lishāy'in","of anything","কোনো কিছুকে"],["إِنِّى","innī","Indeed, I","\"নিশ্চয়ই আমি"],["فَاعِلٌۭ","fā‘ilun","will do","সম্পাদনকারী"],["ذَٰلِكَ","dhālika","that","এটা"],["غَدًا","ghadan","tomorrow","আগামীকাল\""]],"t":"وَلَا تَقُولَ<g>نَّ</> لِشَ<s>ا۟</>ىْءٍ إِ<g>نِّ</>ى فَاعِ<k>لٌۭ ذَٰ</>لِكَ غَدًا"},{"n":24,"w":[["إِلَّآ","illā","Except","ছাড়া"],["أَن","an","If","\"যে"],["يَشَآءَ","yashāa","Allah wills","ইচ্ছে করেন\""],["ٱللَّهُ ۚ","l-lahu","Allah wills","আল্লাহ্‌\""],["وَٱذْكُر","wa-udh'kur","And remember","এবং স্মরণ করো"],["رَّبَّكَ","rabbaka","your Lord","তোমার রবকে"],["إِذَا","idhā","when","যদি"],["نَسِيتَ","nasīta","you forget","তুমি ভুলে যাও"],["وَقُلْ","waqul","and say","এবং বলো"],["عَسَىٰٓ","‘asā","Perhaps","\"সম্ভবতঃ"],["أَن","an","[that]","যে"],["يَهْدِيَنِ","yahdiyani","will guide me","আমাকে পথ দেখাবেন"],["رَبِّى","rabbī","my Lord","আমার রব"],["لِأَقْرَبَ","li-aqrab