نَّتَهُۥ","jannatahu","his garden","তার বাগানে"],["وَهُوَ","wahuwa","while he","এবং এ অবস্থায় যে সে ছিলো"],["ظَالِمٌۭ","ẓālimun","(was) unjust","সীমালঙ্ঘনকারী"],["لِّنَفْسِهِۦ","linafsihi","to himself","উপর তার নিজের"],["قَالَ","qāla","He said","সে বললো"],["مَآ","mā","Not","\"না"],["أَظُنُّ","aẓunnu","I think","আমি মনে করি"],["أَن","an","that","যে"],["تَبِيدَ","tabīda","will perish","ধ্বংস হবে"],["هَـٰذِهِۦٓ","hādhihi","this","এই (সম্পদ)"],["أَبَدًۭا","abadan","ever","কখনও"]],"t":"وَدَخَلَ جَ<g>نَّ</>تَهُ<m>ۥ</> وَهُوَ ظَالِ<w>مٌۭ لِّ</>نَفْسِ<m>هِۦ</> قَالَ <o>مَآ</> أَظُ<g>نُّ</> أَ<k>ن تَ</>بِيدَ <m>هَٰ</>ذِ<o>هِۦٓ</> أَبَدًۭا"},{"n":36,"w":[["وَمَآ","wamā","And not","এবং না"],["أَظُنُّ","aẓunnu","I think","আমি মনে করি"],["ٱلسَّاعَةَ","l-sā‘ata","the Hour","ক্বিয়ামাত"],["قَآئِمَةًۭ","qāimatan","will occur","সংঘটিত হবে"],["وَلَئِن","wala-in","And if","এবং অবশ্যই যদি"],["رُّدِدتُّ","rudidttu","I am brought back","আমি প্রত্যাবর্তিত হই"],["إِلَىٰ","ilā","to","দিকে"],["رَبِّى","rabbī","my Lord","আমার রবের"],["لَأَجِدَنَّ","la-ajidanna","I will surely find","অবশ্যই আমি পাবো"],["خَيْرًۭا","khayran","better","উত্তম"],["مِّنْهَا","min'hā","than this","তাদের দু'টির চেয়েও"],["مُنقَلَبًۭا","munqalaban","(as) a return","প্রত্যাবর্তনস্থান\""]],"t":"وَ<o>مَآ</> أَظُ<g>نُّ</> <h>ٱ</><l>ل</>سَّاعَةَ <o>قَآ</>ئِمَ<d>ةًۭ وَ</>لَ<w>ئِن رُّ</>دِ<j>د</>تُّ إِلَىٰ رَبِّى لَأَجِدَ<g>نَّ</> خَيْ<d>رًۭا مِّ</>نْهَا مُ<k>نقَ</>لَبًۭا"},{"n":37,"w":[["قَالَ","qāla","Said","বললো"],["لَهُۥ","lahu","to him","তাকে"],["صَاحِبُهُۥ","ṣāḥibuhu","his companion","তার সাথী"],["وَهُوَ","wahuwa","while he","এমতাবস্হায় যে সে"],["يُحَاوِرُهُۥٓ","yuḥāwiruhu","was talking to him","তার সাথে আলোচনা করেছিলো"],["أَكَفَرْتَ","akafarta","Do you disbelieve","\"কি তুমি অস্বীকার করছো"],["بِٱلَّذِى","bi-alladhī","in One Who","(ঐ সত্ত্বা) কে যিনি"],["خَلَقَكَ","khalaqaka","created you","তোমাকে সৃষ্টি করেছেন"],["مِن","min","from","থেকে"],["تُرَابٍۢ","turābin","dust","মাটি"],["ثُمَّ","thumma","then","এরপর"],["مِن","min","from","থেকে"],["نُّطْفَةٍۢ","nuṭ'fatin","a minute quantity of semen","শুক্র"],["ثُمَّ","thumma","then","এরপর"],["سَوَّىٰكَ","sawwāka","fashioned you","তোমাকে সম্পূর্ণ করেছেন"],["رَجُلًۭا","rajulan","(into) a man","মানুষে"]],"t":"قَالَ لَهُ<m>ۥ</> صَاحِبُهُ<m>ۥ</> وَهُوَ يُحَاوِرُهُ<o>ۥٓ</> أَكَفَرْتَ بِ<h>ٱ</>لَّذِى خَلَقَكَ مِ<k>ن تُ</>رَا<k>بٍۢ ثُ</><g>مَّ</> <d>مِن نُّ</><q>طْ</>فَ<k>ةٍۢ ثُ</><g>مَّ</> سَوَّ<m>ىٰ</>كَ رَجُلًۭا"},{"n":38,"w":[["لَّـٰكِنَّا۠","lākinnā","But as for me","কিন্তু (আমি বলি)"],["هُوَ","huwa","He","তিনি"],["ٱللَّهُ","l-lahu","(is) Allah","আল্লাহ্‌"],["رَبِّى","rabbī","my Lord","আমার রব"],["وَلَآ","walā","and not","এবং না"],["أُشْرِكُ","ush'riku","I associate","শরিক করি আমি"],["بِرَبِّىٓ","birabbī","with my Lord","সাথে আমার রবের"],["أَحَدًۭا","aḥadan","anyone","কাউকে"]],"t":"<m>لَّٰ</>كِ<g>نَّ</>ا۠ هُوَ <h>ٱ</>للَّهُ رَبِّى وَ<o>لَآ</> أُشْرِكُ بِرَ<o>بِّىٓ</> أَحَدًۭا"},{"n":39,"w":[["وَلَوْلَآ","walawlā","And why (did you) not","এবং কেন না"],["إِذْ","idh","when","যখন"],["دَخَلْتَ","dakhalta","you entered","তুমি প্রবেশ করছিলে"],["جَنَّتَكَ","jannataka","your garden","তোমার বাগানে"],["قُلْتَ","qul'ta","say","তুমি বলেছিলে"],["مَا","mā","What","\"যা"],["شَآءَ","shāa","wills","চেয়েছেন"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ্‌ (তাই হয়েছে)"],["لَا","lā","(there is) no","নেই"],["قُوَّةَ","quwwata","power","কোনো শক্তি"],["إِلَّا","illā","except","ছাড়া"],["بِٱللَّهِ ۚ","bil-lahi","with Allah","আল্লাহ্‌\""],["إِن","in","If","যদি"],["تَرَنِ","tarani","you see me","আমাকে দেখো"],["أَنَا۠","anā","(me)","আমি"],["أَقَلَّ","aqalla","lesser","স্বল্পতর"],["مِنكَ","minka","than you","তোমার চেয়ে"],["مَالًۭا","mālan","(in) wealth","সম্পদে"],["وَوَلَدًۭا","wawaladan","and children","এবং সন্তানে"]],"t":"وَلَوْ<o>لَآ</> إِذْ دَخَلْتَ جَ<g>نَّ</>تَكَ قُلْتَ مَا <o>شَآ</>ءَ <h>ٱ</>للَّهُ لَا قُوَّةَ إِلَّا بِ<h>ٱ</>للَّهِ ۚ إِ<k>ن تَ</>رَنِ أَنَا۠ أَقَلَّ مِ<k>نكَ</> مَالًۭ<d>ا وَ</>وَلَدًۭا"},{"n":40,"w":[["فَعَسَىٰ","fa‘asā","It may be","তবে হয়তো"],["رَبِّىٓ","rabbī","that my Lord","আমার রব"],["أَن","an","that my Lord","যে"],["يُؤْتِيَنِ","yu'tiyani","will give me","আমাকে দান করবেন"],["خَيْرًۭا","khayran","better","উত্তম"],["مِّن","min","than","থেকে"],["جَنَّتِكَ","jannatika","your garden","তোমার বাগান"],["وَيُرْسِلَ","wayur'sila","and will send","এবং প্রেরণ করবেন"],["عَلَيْهَا","‘alayhā","upon it","উপর তার"],["حُسْبَانًۭا","ḥus'bānan","a calamity","বিপর্যয়"],["مِّنَ","mina","from","থেকে"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশ"],["فَتُصْبِحَ","fatuṣ'biḥa","then it will become","অতঃপর তা হয়ে যাবে"],["صَعِيدًۭا","ṣa‘īdan","ground","মাটি"],["زَلَقًا","zalaqan","slippery","উদ্ভিদশূন্য"]],"t":"فَعَسَىٰ رَ<o>بِّىٓ</> <d>أَن يُ</>ؤْتِيَنِ خَيْ<d>رًۭا مِّ</><k>ن جَ</><g>نَّ</>تِكَ وَيُرْسِلَ عَلَيْهَا حُسْبَا<d>نًۭا مِّ</>نَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ فَتُصْبِحَ صَعِي<k>دًۭا زَ</>لَقًا"},{"n":41,"w":[["أَوْ","aw","Or","অথবা"],["يُصْبِحَ","yuṣ'biḥa","will become","হয়ে যাবে"],["مَآؤُهَا","māuhā","its water","তার পানি"],["غَوْرًۭا","ghawran","sunken","শুষ্ক"],["فَلَن","falan","so never","অতঃপর কখনও না"],["تَسْتَطِيعَ","tastaṭī‘a","you will be able","তুমি সক্ষম হবে"],["لَهُۥ","lahu","to find it","জন্যে তার\""],["طَلَبًۭا","ṭalaban","to find it","খুঁজে বের করতে\""]],"t":"أَوْ يُصْبِحَ <o>مَآ</>ؤُهَا غَوْ<k>رًۭا فَلَن تَ</>سْتَطِيعَ لَهُ<m>ۥ</> طَلَبًۭا"},{"n":42,"w":[["وَأُحِيطَ","wa-uḥīṭa","And were surrounded","এবং (বিপর্যয়ে) পরিবেষ্টিত হলো"],["بِثَمَرِهِۦ","bithamarihi","his fruits","সহ তার ফল"],["فَأَصْبَحَ","fa-aṣbaḥa","so he began","ফলে সে শুরু করলো"],["يُقَلِّبُ","yuqallibu","twisting","মুচড়াতে"],["كَفَّيْهِ","kaffayhi","his hands","দু'হাত তার"],["عَلَىٰ","‘alā","over","এর উপর"],["مَآ","mā","what","যা"],["أَنفَقَ","anfaqa","he (had) spent","সে খরচ করেছে"],["فِيهَا","fīhā","on it","মধ্যে তার"],["وَهِىَ","wahiya","while it (had)","এবং তা"],["خَاوِيَةٌ","khāwiyatun","collapsed","উল্টে পড়েছিলো"],["عَلَىٰ","‘alā","on","উপর"],["عُرُوشِهَا","‘urūshihā","its trellises","তার মাচাগুলোর"],["وَيَقُولُ","wayaqūlu","and he said","এবং সে বললো"],["يَـٰلَيْتَنِى","yālaytanī","Oh! I wish","\"হায় (যদি)"],["لَمْ","lam","I had not associated","না"],["أُشْرِكْ","ush'rik","I had not associated","আমি শরিক করতাম"],["بِرَبِّىٓ","birabbī","with my Lord","সাথে আমার রবের"],["أَحَدًۭا","aḥadan","anyone","অন্য কাউকে\""]],"t":"وَأُحِيطَ بِثَمَرِ<m>هِۦ</> فَأَصْبَحَ يُقَلِّبُ كَفَّيْهِ عَلَىٰ <o>مَآ</> أَ<k>نفَ</>قَ فِيهَا وَهِىَ خَاوِيَةٌ عَلَىٰ عُرُوشِهَا وَيَقُولُ <m>يَٰ</>لَيْتَنِى لَمْ أُشْرِكْ بِرَ<o>بِّىٓ</> أَحَدًۭا"},{"n":43,"w":[["وَلَمْ","walam","And not","এবং না"],["تَكُن","takun","was","ছিলো"],["لَّهُۥ","lahu","for him","জন্যে তার"],["فِئَةٌۭ","fi-atun","a group","কোনো দল"],["يَنصُرُونَهُۥ","yanṣurūnahu","(to) help him","তাকে তারা সাহায্য করবে"],["مِن","min","other than","থেকে"],["دُونِ","dūni","other than","ছাড়া"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ্‌"],["وَمَا","wamā","and not","আর না"],["كَانَ","kāna","was","সে ছিলো"],["مُنتَصِرًا","muntaṣiran","(he) supported","প্রতিরোধকারী"]],"t":"وَلَمْ تَ<w>كُن لَّ</>هُ<m>ۥ</> فِئَ<d>ةٌۭ يَ</><k>نصُ</>رُونَهُ<m>ۥ</> مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ وَمَا كَانَ مُ<k>نتَ</>صِرًا"},{"n":44,"w":[["هُنَالِكَ","hunālika","There","এ ক্ষেত্রে (জানতে পারলো)"],["ٱلْوَلَـٰيَةُ","l-walāyatu","the protection","অভিভাবকত্বের (অধিকার)"],["لِلَّهِ","lillahi","(is) from Allah","জন্যে আল্লাহ্‌রই"],["ٱلْحَقِّ ۚ","l-ḥaqi","the True","তিনি সত্য"],["هُوَ","huwa","He","তিনিই"],["خَيْرٌۭ","khayrun","(is the) best","উত্তম"],["ثَوَابًۭا","thawāban","(to) reward","পুরস্কারদানে"],["وَخَيْرٌ","wakhayrun","and (the) best","ও উত্তম"],["عُقْبًۭا","‘uq'ban","(for) the final end","পরিণামে"]],"t":"هُنَالِكَ <h>ٱ</>لْوَ<m>لَٰ</>يَةُ لِلَّهِ <h>ٱ</>لْحَقِّ ۚ هُوَ خَيْ<k>رٌۭ ثَ</>وَا<d>بًۭا وَ</>خَيْرٌ عُ<q>قْ</>بًۭا"},{"n":45,"w":[["وَٱضْرِبْ","wa-iḍ'rib","And present","এবং পেশ করো"],["لَهُم","lahum","to them","জন্যে তাদের"],["مَّثَلَ","mathala","the example","একটি দৃষ্টান্ত"],["ٱلْحَيَوٰةِ","l-ḥayati","(of) the life","জীবনের"],["ٱلدُّنْيَا","l-dun'yā","(of) the world","পার্থিব"],["كَمَآءٍ","kamāin","like water","মতো পানির"],["أَنزَلْنَـٰهُ","anzalnāhu","which We send down","তা আমরা বর্ষণ করি"],["مِنَ","mina","from","থেকে"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশ"],["فَٱخْتَلَطَ","fa-ikh'talaṭa","then mingles","তখন ঘন হয়ে উঠে"],["بِهِۦ","bihi","with it","দিয়ে তা"],["نَبَاتُ","nabātu","(the) vegetation","উদ্ভিদ"],["ٱلْأَرْضِ","l-arḍi","(of) the earth","মাটির"],["فَأَصْبَحَ","fa-aṣbaḥa","then becomes","অতঃপর হয়ে যায়"],["هَشِيمًۭا","hashīman","dry stalks","ভুষি"],["تَذْرُوهُ","tadhrūhu","it (is) scattered","তা উড়িয়ে নিয়ে যায়"],["ٱلرِّيَـٰحُ ۗ","l-riyāḥu","(by) the winds","বাতাস"],["وَكَانَ","wakāna","And Allah","এবং হলেন"],["ٱللَّهُ","l-lahu","And Allah","আল্লাহ্‌"],["عَلَىٰ","‘alā","over","উপর"],["كُلِّ","kulli","every","সব"],["شَىْءٍۢ","shayin","thing","কিছুর"],["مُّقْتَدِرًا","muq'tadiran","(is) All Able","সর্বশক্তিমান"]],"t":"وَ<h>ٱ</>ضْرِ<q>بْ</> لَ<y>هُم مَّ</>ثَلَ <h>ٱ</>لْحَيَ<s>وٰ</>ةِ <h>ٱ</><l>ل</>دُّنْيَا كَ<o>مَآ</>ءٍ أَ<k>نزَ</>لْ<m>نَٰ</>هُ مِنَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ فَ<h>ٱ</>خْتَلَطَ بِ<m>هِۦ</> نَبَاتُ <h>ٱ</>لْأَرْضِ فَأَصْبَحَ هَشِي<k>مًۭا تَ</>ذْرُوهُ <h>ٱ</><l>ل</>رِّ<m>يَٰ</>حُ ۗ وَكَانَ <h>ٱ</>للَّهُ عَلَىٰ كُلِّ <d>شَىْءٍۢ مُّ</><q>قْ</>تَدِرًا"},{"n":46,"w":[["ٱلْمَالُ","al-mālu","The wealth","ধনসম্পদ"],["وَٱلْبَنُونَ","wal-banūna","and children","ও সন্তান-সন্ততি"],["زِينَةُ","zīnatu","(are) adornment","শোভা"],["ٱلْحَيَوٰةِ","l-ḥayati","(of) the life","জীবনের"],["ٱلدُّنْيَا ۖ","l-dun'yā","(of) the world","পার্থিব"],["وَٱلْبَـٰقِيَـٰتُ","wal-bāqiyātu","But the enduring","স্থায়ী"],["ٱلصَّـٰلِحَـٰتُ","l-ṣāliḥātu","good deeds","সৎ কাজসমূহ"],["خَيْرٌ","khayrun","(are) better","উত্তম"],["عِندَ","‘inda","near","কাছে"],["رَبِّكَ","rabbika","your Lord","তোমার রবের"],["ثَوَابًۭا","thawāban","(for) reward","প্রতিফল হিসেবে"],["وَخَيْرٌ","wakhayrun","and better","ও উত্তম"],["أَمَلًۭا","amalan","(for) hope","আকাঙ্ক্ষা হিসেবে"]],"t":"ٱلْمَالُ وَ<h>ٱ</>لْبَنُونَ زِينَةُ <h>ٱ</>لْحَيَ<s>وٰ</>ةِ <h>ٱ</><l>ل</>دُّنْيَا ۖ وَ<h>ٱ</>لْ<m>بَٰقِيَٰ</>تُ <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تُ خَيْرٌ عِ<k>ندَ</> رَبِّكَ ثَوَا<d>بًۭا وَ</>خَيْرٌ أَمَلًۭا"},{"n":47,"w":[["وَيَوْمَ","wayawma","And the Day","এবং যেদিন"],["نُسَيِّرُ","nusayyiru","We will cause (to) move","আমরা চালাবো"],["ٱلْجِبَالَ","l-jibāla","the mountains","পর্বতসমূহকে"],["وَتَرَى","watarā","and you will see","এবং তুমি দেখবে"],["ٱلْأَرْضَ","l-arḍa","the earth","পৃথিবীকে"],["بَارِزَةًۭ","bārizatan","(as) a leveled plain","খোলা মাঠ"],["وَحَشَرْنَـٰهُمْ","waḥasharnāhum","and We will gather them","এবং আমরা একত্র করবো তাদের"],["فَلَمْ","falam","and not","অতঃপর না"],["نُغَادِرْ","nughādir","We will leave behind","আমরা  ছাড়বো"],["مِنْهُمْ","min'hum","from them","মধ্য হ'তে তাদের"],["أَحَدًۭا","aḥadan","anyone","কাউকে"]],"t":"وَيَوْمَ نُسَيِّرُ <h>ٱ</>لْجِبَالَ وَتَرَى <h>ٱ</>لْأَرْضَ بَارِزَ<d>ةًۭ وَ</>حَشَرْ<m>نَٰ</>هُمْ فَلَمْ نُغَادِرْ مِنْهُمْ أَحَدًۭا"},{"n":48,"w":[["وَعُرِضُوا۟","wa‘uriḍū","And they will be presented","এবং তাদের পেশ করা হবে"],["عَلَىٰ","‘alā","before","কাছে"],["رَبِّكَ","rabbika","your Lord","তোমার রবের"],["صَفًّۭا","ṣaffan","(in) rows","সারিবদ্ধভাবে"],["لَّقَدْ","laqad","Certainly","\"নিশ্চয়ই"],["جِئْتُمُونَا","ji'tumūnā","you have come to Us","আমাদের কাছে তোমরা এসেছো"],["كَمَا","kamā","as","যেমন"],["خَلَقْنَـٰكُمْ","khalaqnākum","We created you","আমরা সৃষ্টি করেছিলাম তোমাদেরকে"],["أَوَّلَ","awwala","the first","প্রথম"],["مَرَّةٍۭ ۚ","marratin","time","বার"],["بَلْ","bal","Nay","বরং"],["زَعَمْتُمْ","za‘amtum","you claimed","তোমরা ভেবেছিলে"],["أَلَّن","allan","that not","যে কখনও না"],["نَّجْعَلَ","naj‘ala","We made","আমরা উপস্থিত করবো"],["لَكُم","lakum","for you","জন্যে তোমাদের"],["مَّوْعِدًۭا","maw‘idan","an appointment","প্রতিশ্রুত সময়\""]],"t":"وَعُرِضُو<s>ا۟</> عَلَىٰ رَبِّكَ صَ<w>فًّۭا لَّ</>قَ<q>دْ</> جِئْتُمُونَا كَمَا خَلَ<q>قْ</><m>نَٰ</>كُمْ أَوَّلَ مَرَّ<i>ةٍۭ ۚ بَ</>لْ زَعَمْتُمْ أَ<d>لَّن نَّ</><q>جْ</>عَلَ لَ<y>كُم مَّ</>وْعِدًۭا"},{"n":49,"w":[["وَوُضِعَ","wawuḍi‘a","And (will) be placed","এবং রাখা হবে"],["ٱلْكِتَـٰبُ","l-kitābu","the Book","(হিসেবের) কিতাব"],["فَتَرَى","fatarā","and you will see","অতঃপর তুমি দেখবে"],["ٱلْمُجْرِمِينَ","l-muj'rimīna","the criminals","অপরাধীদেরকে"],["مُشْفِقِينَ","mush'fiqīna","fearful","আতঙ্কগ্রস্ত"],["مِمَّا","mimmā","of what","তা থেকে যা"],["فِيهِ","fīhi","(is) in it","মধ্যে আছে তার"],["وَيَقُولُونَ","wayaqūlūna","and they will say","এবং তারা বলবে"],["يَـٰوَيْلَتَنَا","yāwaylatanā","Oh, woe to us","\"দুর্ভাগ্য হায়! আমাদের"],["مَالِ","māli","What (is) for","কেমন"],["هَـٰذَا","hādhā","this","এই"],["ٱلْكِتَـٰبِ","l-kitābi","[the] Book","(হিসেবের) কিতাব"],["لَا","lā","not","না"],["يُغَادِرُ","yughādiru","leaves","ছাড়ে"],["صَغِيرَةًۭ","ṣaghīratan","a small","ছোট"],["وَلَا","walā","and not","আর না"],["كَبِيرَةً","kabīratan","a great","বড়"],["إِلَّآ","illā","except","কিন্তু"],["أَحْصَىٰهَا ۚ","aḥṣāhā","has enumerated it","তা গুনে রেখেছে\""],["وَوَجَدُوا۟","wawajadū","And they will find","তারা পাবে"],["مَا","mā","what","যা"],["عَمِلُوا۟","‘amilū","they did","তারা কাজ করছে"],["حَاضِرًۭا ۗ","ḥāḍiran","presented","উপস্থিত"],["وَلَا","walā","And not","এবং না"],["يَظْلِمُ","yaẓlimu","deals unjustly","অন্যায় করবেন"],["رَبُّكَ","rabbuka","your Lord","তোমার রব"],["أَحَدًۭا","aḥadan","(with) anyone","কাউকে"]],"t":"وَوُضِعَ <h>ٱ</>لْكِ<m>تَٰ</>بُ فَتَرَى <h>ٱ</>لْمُ<q>جْ</>رِمِينَ مُشْفِقِينَ مِ<g>مَّ</>ا فِيهِ وَيَقُولُونَ <m>يَٰ</>وَيْلَتَنَا مَالِ <m>هَٰ</>ذَا <h>ٱ</>لْكِ<m>تَٰ</>بِ لَا يُغَادِرُ صَغِيرَ<d>ةًۭ وَ</>لَا كَبِيرَةً إِ<o>لَّآ</> أَحْصَ<m>ىٰ</>هَا ۚ وَوَجَدُو<s>ا۟</> مَا عَمِلُو<s>ا۟</> حَاضِ<d>رًۭا ۗ وَ</>لَا يَظْلِمُ رَبُّكَ أَحَدًۭا"},{"n":50,"w":[["وَإِذْ","wa-idh","And when","এবং (স্মরণ করো) যখন"],["قُلْنَا","qul'nā","We said","আমরা বলেছিলাম"],["لِلْمَلَـٰٓئِكَةِ","lil'malāikati","to the Angels","ফেরেশতাদেরকে"],["ٱسْجُدُوا۟","us'judū","Prostrate","\"তোমরা সিজদা করো"],["لِـَٔادَمَ","liādama","to Adam","আদমকে\""],["فَسَجَدُوٓا۟","fasajadū","so they prostrated","তখন তারা সিজদা করেছিলো"],["إِلَّآ","illā","except","ছাড়া"],["إِبْلِيسَ","ib'līsa","Iblis","ইবলীশ"],["كَانَ","kāna","(He) was","সে ছিলো"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلْجِنِّ","l-jini","the jinn","জিনদের"],["فَفَسَقَ","fafasaqa","and he rebelled","তাই সে অমান্য করলো"],["عَنْ","‘an","against","থেকে"],["أَمْرِ","amri","the Command","নির্দেশ"],["رَبِّهِۦٓ ۗ","rabbihi","(of) his Lord","তার রবের"],["أَفَتَتَّخِذُونَهُۥ","afatattakhidhūnahu","Will you then take him","কি তোমরা গ্রহণ করেছো তাকে"],["وَذُرِّيَّتَهُۥٓ","wadhurriyyatahu","and his offspring","ও তার বংশধরকে"],["أَوْلِيَآءَ","awliyāa","(as) protectors","অভিভাবকরূপে"],["مِن","min","other than Me","ছাড়া"],["دُونِى","dūnī","other than Me","আমাকে"],["وَهُمْ","wahum","while they","অথচ তারা"],["لَكُمْ","lakum","(are) to you","জন্যে তোমাদের"],["عَدُوٌّۢ ۚ","‘aduwwun","enemies","শত্রু"],["بِئْسَ","bi'sa","Wretched","বড়ই খারাপ"],["لِلظَّـٰلِمِينَ","lilẓẓālimīna","for the wrongdoers","জন্যে সীমালঙ্ঘনকারীদের"],["بَدَلًۭا","badalan","(is) the exchange","বিনিময় হিসেবে"]],"t":"وَإِذْ قُلْنَا لِلْمَ<o>لَٰٓ</>ئِكَةِ <h>ٱ</>سْجُدُو<s>ا۟</> لِءَادَمَ فَسَجَ<o>دُوٓ</><s>ا۟</> إِ<o>لَّآ</> إِ<q>بْ</>لِيسَ كَانَ مِنَ <h>ٱ</>لْجِ<g>نِّ</> فَفَسَقَ عَنْ أَمْرِ رَبِّ<o>هِۦٓ ۗ</> أَفَتَتَّخِذُونَهُ<m>ۥ</> وَذُرِّيَّتَهُ<o>ۥٓ</> أَوْلِ<o>يَآ</>ءَ مِ<k>ن دُ</>ونِى وَهُمْ لَكُمْ عَدُ<i>وٌّۢ ۚ بِ</>ئْسَ لِل<m>ظَّٰ</>لِمِينَ بَدَلًۭا"},{"n":51,"w":[["۞ مَّآ","mā","Not","নি"],["أَشْهَدتُّهُمْ","ashhadttuhum","I made them witness","তাদেরকে আমি সাক্ষী করি"],["خَلْقَ","khalqa","the creation","সৃষ্টিতে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশসমূহের"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীর"],["وَلَا","walā","and not","আর না"],["خَلْقَ","khalqa","the creation","সৃষ্টিতে"],["أَنفُسِهِمْ","anfusihim","(of) themselves","নিজেদের তাদের"],["وَمَا","wamā","and not","এবং না"],["كُنتُ","kuntu","I Am","আমি ছিলাম"],["مُتَّخِذَ","muttakhidha","the One to take","গ্রহণকারী"],["ٱلْمُضِلِّينَ","l-muḍilīna","the misleaders","বিভ্রান্তকারীদেরকে"],["عَضُدًۭا","‘aḍudan","(as) helper(s)","সাহায্যকারীরূপে"]],"t":"۞ <o>مَّآ</> أَشْهَ<j>د</>تُّهُمْ خَلْقَ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ وَلَا خَلْقَ أَ<k>نفُ</>سِهِمْ وَمَا كُ<k>نتُ</> مُتَّخِذَ <h>ٱ</>لْمُضِلِّينَ عَضُدًۭا"},{"n":52,"w":[["وَيَوْمَ","wayawma","And the Day","এবং যেদিন"],["يَقُولُ","yaqūlu","He will say","তিনি বলবেন"],["نَادُوا۟","nādū","Call","\"তোমরা ডাকো"],["شُرَكَآءِىَ","shurakāiya","My partners","আমার শরিকদেরকে"],["ٱلَّذِينَ","alladhīna","those who","যাদেরকে"],["زَعَمْتُمْ","za‘amtum","you claimed","মনে করেছিলে তোমরা\""],["فَدَعَوْهُمْ","fada‘awhum","then they will call them","তখন তারা ডাকবে তাদেরকে"],["فَلَمْ","falam","but not","কিন্তু না"],["يَسْتَجِيبُوا۟","yastajībū","they will respond","তারা ডাকে সাড়া দিবে"],["لَهُمْ","lahum","to them","তাদেরকে"],["وَجَعَلْنَا","waja‘alnā","And We will make","এবং আমরা রেখে দিবো"],["بَيْنَهُم","baynahum","between them","মাঝে তাদের"],["مَّوْبِقًۭا","mawbiqan","a barrier","ধ্বংসের স্থান"]],"t":"وَيَوْمَ يَقُولُ نَادُو<s>ا۟</> شُرَ<o>كَآ</>ءِىَ <h>ٱ</>لَّذِينَ زَعَمْتُمْ فَدَعَوْهُمْ فَلَمْ يَسْتَجِيبُو<s>ا۟</> لَهُمْ وَجَعَلْنَا بَيْنَ<y>هُم مَّ</>وْبِقًۭا"},{"n":53,"w":[["وَرَءَا","waraā","And will see","এবং দেখবে"],["ٱلْمُجْرِمُونَ","l-muj'rimūna","the criminals","অপরাধীরা"],["ٱلنَّارَ","l-nāra","the Fire","আগুন"],["فَظَنُّوٓا۟","faẓannū","and they (will be) certain","তখন তারা ভাববে"],["أَنَّهُم","annahum","that they","যে তারা"],["مُّوَاقِعُوهَا","muwāqi‘ūhā","are to fall in it","তাতে ফেলা হবে"],["وَلَمْ","walam","And not","এবং না"],["يَجِدُوا۟","yajidū","they will find","তারা পাবে"],["عَنْهَا","‘anhā","from it","থেকে তা"],["مَصْرِفًۭا","maṣrifan","a way of escape","ফিরার স্থান"]],"t":"وَرَءَا <h>ٱ</>لْمُ<q>جْ</>رِمُونَ <h>ٱ</><l>ل</><g>نَّ</>ارَ فَظَ<g>نُّ</><o>وٓ</><s>ا۟</> أَ<g>نَّ</><y>هُم مُّ</>وَاقِعُوهَا وَلَمْ يَجِدُو<s>ا۟</> عَنْهَا مَصْرِفًۭا"},{"n":54,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["صَرَّفْنَا","ṣarrafnā","We have explained","আমরা বিশদভাবে বর্ণনা করেছি"],["فِى","fī","in","মধ্যে"],["هَـٰذَا","hādhā","this","এই"],["ٱلْقُرْءَانِ","l-qur'āni","the Quran","কুরআনের"],["لِلنَّاسِ","lilnnāsi","for mankind","জন্যে মানুষদের"],["مِن","min","of","থেকে"],["كُلِّ","kulli","every","প্রত্যেক"],["مَثَلٍۢ ۚ","mathalin","example","দৃষ্টান্ত"],["وَكَانَ","wakāna","But is","অথচ হলো"],["ٱلْإِنسَـٰنُ","l-insānu","the man","মানুষ"],["أَكْثَرَ","akthara","(in) most","অধিকাংশ"],["شَىْءٍۢ","shayin","things","বিষয়ে"],["جَدَلًۭا","jadalan","quarrelsome","ঝগড়াটে"]],"t":"وَلَقَ<q>دْ</> صَرَّفْنَا فِى <m>هَٰ</>ذَا <h>ٱ</>لْقُرْءَانِ لِل<g>نَّ</>اسِ مِ<k>ن كُ</>لِّ مَثَ<d>لٍۢ ۚ وَ</>كَانَ <h>ٱ</>لْإِ<k>نسَٰ</>نُ أَكْثَرَ <k>شَىْءٍۢ جَ</>دَلًۭا"},{"n":55,"w":[["وَمَا","wamā","And nothing","এবং কি (জিনিস)"],["مَنَعَ","mana‘a","prevents","বাদা দেয়"],["ٱلنَّاسَ","l-nāsa","men","মানুষদেরকে"],["أَن","an","that","যে"],["يُؤْمِنُوٓا۟","yu'minū","they believe","তারা ঈমান আনবে"],["إِذْ","idh","when","যখন"],["جَآءَهُمُ","jāahumu","has come to them","এসেছে তাদের কাছে"],["ٱلْهُدَىٰ","l-hudā","the guidance","পথ নির্দেশ"],["وَيَسْتَغْفِرُوا۟","wayastaghfirū","and they ask forgiveness","এবং তারা ক্ষমা চাইতে"],["رَبَّهُمْ","rabbahum","(of) their Lord","রবের কাছে তাদের"],["إِلَّآ","illā","except","ছাড়া"],["أَن","an","that","যে"],["تَأْتِيَهُمْ","tatiyahum","comes to them","কাছ আসবে তাদের"],["سُنَّةُ","sunnatu","(the) way","অনুসৃত রীতি"],["ٱلْأَوَّلِينَ","l-awalīna","(of) the former (people)","পূর্ববর্তীদের"],["أَوْ","aw","or","অথবা"],["يَأْتِيَهُمُ","yatiyahumu","comes to them","কাছে আসবে তাদের"],["ٱلْعَذَابُ","l-‘adhābu","the punishment","শাস্তি"],["قُبُلًۭا","qubulan","before (them)","সামনাসামনি"]],"t":"وَمَا مَنَعَ <h>ٱ</><l>ل</><g>نَّ</>اسَ <d>أَن يُ</>ؤْمِ<o>نُوٓ</><s>ا۟</> إِذْ <o>جَآ</>ءَهُمُ <h>ٱ</>لْهُدَىٰ وَيَسْتَغْفِرُو<s>ا۟</> رَبَّهُمْ إِ<o>لَّآ</> أَ<k>ن تَ</>أْتِيَهُمْ سُ<g>نَّ</>ةُ <h>ٱ</>لْأَوَّلِينَ أَوْ يَأْتِيَهُمُ <h>ٱ</>لْعَذَابُ قُبُلًۭا"},{"n":56,"w":[["وَمَا","wamā","And not","এবং না"],["نُرْسِلُ","nur'silu","We send","আমরা প্রেরণ করি"],["ٱلْمُرْسَلِينَ","l-mur'salīna","the Messengers","রাসূলদেরকে"],["إِلَّا","illā","except","ছাড়া"],["مُبَشِّرِينَ","mubashirīna","(as) bearers of glad tidings","সুসংবাদদাতা"],["وَمُنذِرِينَ ۚ","wamundhirīna","and (as) warners","এবং সতর্ককারী (রূপে)"],["وَيُجَـٰدِلُ","wayujādilu","And dispute","এবং বিতর্ক করে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieve","অস্বীকার করেছে"],["بِٱلْبَـٰطِلِ","bil-bāṭili","with falsehood","দিয়ে মিথ্যা"],["لِيُدْحِضُوا۟","liyud'ḥiḍū","to refute","যেন তারা ব্যর্থ করতে পারে"],["بِهِ","bihi","thereby","দিয়ে তা"],["ٱلْحَقَّ ۖ","l-ḥaqa","the truth","সত্যকে"],["وَٱتَّخَذُوٓا۟","wa-ittakhadhū","And they take","এবং তারা গ্রহণ করেছে"],["ءَايَـٰتِى","āyātī","My Verses","আমার নিদর্শনগুলোকে"],["وَمَآ","wamā","and what","এবং (সেগুলোকে) যার"],["أُنذِرُوا۟","undhirū","they are warned","সতর্ক করা হয়েছে"],["هُزُوًۭا","huzuwan","(in) ridicule","বিদ্রূপরূপে"]],"t":"وَمَا نُرْسِلُ <h>ٱ</>لْمُرْسَلِينَ إِلَّا مُبَشِّرِينَ وَمُ<k>نذِ</>رِينَ ۚ وَيُ<m>جَٰ</>دِلُ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> بِ<h>ٱ</>لْ<m>بَٰ</>طِلِ لِيُ<q>دْ</>حِضُو<s>ا۟</> بِهِ <h>ٱ</>لْحَقَّ ۖ وَ<h>ٱ</>تَّخَ<o>ذُوٓ</><s>ا۟</> ءَا<m>يَٰ</>تِى وَ<o>مَآ</> أُ<k>نذِ</>رُو<s>ا۟</> هُزُوًۭا"},{"n":57,"w":[["وَمَنْ","waman","And who","এবং কে"],["أَظْلَمُ","aẓlamu","(is) more wrong","অধিক সীমালঙ্ঘনকারী"],["مِمَّن","mimman","than (he) who","(তার) চেয়ে যাকে"],["ذُكِّرَ","dhukkira","is reminded","স্মরণ করিয়ে দেয়া হয়েছে"],["بِـَٔايَـٰتِ","biāyāti","of the Verses","দিয়ে নিদর্শন"],["رَبِّهِۦ","rabbihi","(of) his Lord","রবের তার"],["فَأَعْرَضَ","fa-a‘raḍa","but turns away","তবুও সে মুখ ফিরিয়ে নিয়েছে"],["عَنْهَا","‘anhā","from them","থেকে তা"],["وَنَسِىَ","wanasiya","and forgets","ও ভুলে গিয়েছে"],["مَا","mā","what","যা"],["قَدَّمَتْ","qaddamat","have sent forth","আগে পাঠিয়েছে"],["يَدَاهُ ۚ","yadāhu","his hands","তার দু'হাত"],["إِنَّا","innā","Indeed, We","নিশ্চয়ই আমরা"],["جَعَلْنَا","ja‘alnā","[We] have placed","আমরা দিয়েছি"],["عَلَىٰ","‘alā","over","উপর"],["قُلُوبِهِمْ","qulūbihim","their hearts","তাদের অন্তরগুলোর"],["أَكِنَّةً","akinnatan","coverings","আবরণ"],["أَن","an","lest","যেন (না)"],["يَفْقَهُوهُ","yafqahūhu","they understand it","তা তারা বুঝে"],["وَفِىٓ","wafī","and in","ও মধ্যে"],["ءَاذَانِهِمْ","ādhānihim","their ears","কানগুলোর তাদের"],["وَقْرًۭا ۖ","waqran","(is) deafness","বধিরতা (দিয়েছি)"],["وَإِن","wa-in","And if","এবং যদি"],["تَدْعُهُمْ","tad‘uhum","you call them","তুমি ডাকো তাদেরকে"],["إِلَى","ilā","to","দিকে"],["ٱلْهُدَىٰ","l-hudā","the guidance","সৎপথে"],["فَلَن","falan","then never","তবুও না"],["يَهْتَدُوٓا۟","yahtadū","they will be guided","তারা সঠিক পথ পাবে"],["إِذًا","idhan","then","তাহ'লে"],["أَبَدًۭا","abadan","ever","কখনও"]],"t":"وَمَنْ أَظْلَمُ مِ<g>مَّ</><k>ن ذُ</>كِّرَ بِـَٔا<m>يَٰ</>تِ رَبِّ<m>هِۦ</> فَأَعْرَضَ عَنْهَا وَنَسِىَ مَا قَدَّمَتْ يَدَاهُ ۚ إِ<g>نَّ</>ا جَعَلْنَا عَلَىٰ قُلُوبِهِمْ أَكِ<g>نَّ</>ةً <d>أَن يَ</>فْقَهُوهُ وَ<o>فِىٓ</> ءَاذَانِهِمْ وَ<q>قْ</><d>رًۭا ۖ وَ</>إِ<k>ن تَ</><q>دْ</>عُهُمْ إِلَى <h>ٱ</>لْهُدَىٰ فَ<d>لَن يَ</>هْتَ<o>دُوٓ</><s>ا۟</> إِذًا أَبَدًۭا"},{"n":58,"w":[["وَرَبُّكَ","warabbuka","And your Lord","এবং তোমার রব"],["ٱلْغَفُورُ","l-ghafūru","(is) the Most Forgiving","ক্ষমাশীল"],["ذُو","dhū","Owner","অধিকারী"],["ٱلرَّحْمَةِ ۖ","l-raḥmati","(of) the Mercy","অনুগ্রহের"],["لَوْ","law","If","যদি"],["يُؤَاخِذُهُم","yuākhidhuhum","He were to seize them","পাকড়াও করতেন তিনি তাদের"],["بِمَا","bimā","for what","এ কারণে যা"],["كَسَبُوا۟","kasabū","they have earned","তারা অর্জন করেছিলো"],["لَعَجَّلَ","la‘ajjala","surely, He (would) have hastened","অবশ্যই তাড়াতাড়ি এগিয়ে আনতেন"],["لَهُمُ","lahumu","for them","জন্যে তাদের"],["ٱلْعَذَابَ ۚ","l-‘adhāba","the punishment","শাস্তি"],["بَل","bal","But","বরং"],["لَّهُم","lahum","for them","জন্যে রয়েছে তাদের"],["مَّوْعِدٌۭ","maw‘idun","(is) an appointment","প্রতিশ্রুত সময়"],["لَّن","lan","never","কখনও না"],["يَجِدُوا۟","yajidū","they will find","তারা পাবে"],["مِن","min","other than it","ছাড়া"],["دُونِهِۦ","dūnihi","other than it","তিনি"],["مَوْئِلًۭا","mawilan","an escape","পালানোর জায়গা"]],"t":"وَرَبُّكَ <h>ٱ</>لْغَفُورُ ذُو <h>ٱ</><l>ل</>رَّحْمَةِ ۖ لَوْ يُؤَاخِذُ<f>هُم بِ</>مَا كَسَبُو<s>ا۟</> لَعَجَّلَ لَهُمُ <h>ٱ</>لْعَذَابَ ۚ بَل لَّ<y>هُم مَّ</>وْعِ<w>دٌۭ لَّ</><d>ن يَ</>جِدُو<s>ا۟</> مِ<k>ن دُ</>ونِ<m>هِۦ</> مَوْئِلًۭا"},{"n":59,"w":[["وَتِلْكَ","watil'ka","And these","এবং এসব"],["ٱلْقُرَىٰٓ","l-qurā","[the] towns","জনপদগুলো"],["أَهْلَكْنَـٰهُمْ","ahlaknāhum","We destroyed them","আমরা ধ্বংস করেছি তাদের"],["لَمَّا","lammā","when","যখন"],["ظَلَمُوا۟","ẓalamū","they wronged","তারা সীমালঙ্ঘন করেছিলো"],["وَجَعَلْنَا","waja‘alnā","and We made","এবং আমরা নির্দিষ্ট করে রেখেছি"],["لِمَهْلِكِهِم","limahlikihim","for their destruction","জন্যে তাদের ধ্বংসের"],["مَّوْعِدًۭا","maw‘idan","an appointed time","একটা নির্দিষ্ট সময়"]],"t":"وَتِلْكَ <h>ٱ</>لْقُرَ<o>ىٰٓ</> أَهْلَكْ<m>نَٰ</>هُمْ لَ<g>مَّ</>ا ظَلَمُو<s>ا۟</> وَجَعَلْنَا لِمَهْلِكِ<y>هِم مَّ</>وْعِدًۭا"},{"n":60,"w":[["وَإِذْ","wa-idh","And when","এবং যখন"],["قَالَ","qāla","said","বলেছিলো"],["مُوسَىٰ","mūsā","Musa","মূসা"],["لِفَتَىٰهُ","lifatāhu","to his boy","তার যুবক (সেবক)-কে"],["لَآ","lā","Not","\"না"],["أَبْرَحُ","abraḥu","I will cease","আমি থামবো"],["حَتَّىٰٓ","ḥattā","until","যতক্ষণ না"],["أَبْلُغَ","ablugha","I reach","পৌঁছাবো আমি"],["مَجْمَعَ","majma‘a","the junction","সংগমস্থলে"],["ٱلْبَحْرَيْنِ","l-baḥrayni","(of) the two seas","দুই সাগরের"],["أَوْ","aw","or","বা"],["أَمْضِىَ","amḍiya","I continue","আমি চলতে থাকবো"],["حُقُبًۭا","ḥuquban","(for) a long period","যুগ যুগ (দীর্ঘকাল)\""]],"t":"وَإِذْ قَالَ مُوسَىٰ لِفَتَ<m>ىٰ</>هُ <o>لَآ</> أَ<q>بْ</>رَحُ حَتَّ<o>ىٰٓ</> أَ<q>بْ</>لُغَ مَ<q>جْ</>مَعَ <h>ٱ</>لْبَحْرَيْنِ أَوْ أَمْضِىَ حُقُبًۭا"},{"n":61,"w":[["فَلَمَّا","falammā","But when","অতঃপর যখন"],["بَلَغَا","balaghā","they reached","দু'জনে পৌঁছে গেলো"],["مَجْمَعَ","majma‘a","the junction","সংগমস্থলে"],["بَيْنِهِمَا","baynihimā","between them","দুই (সাগরের) মাঝের"],["نَسِيَا","nasiyā","they forgot","দু'জনে ভুলে গেলো"],["حُوتَهُمَا","ḥūtahumā","their fish","দু'জনের মাছকে"],["فَٱتَّخَذَ","fa-ittakhadha","and it took","অতঃপর (মাছ) করে নিলো"],["سَبِيلَهُۥ","sabīlahu","its way","পথ তার"],["فِى","fī","into","মধ্যে"],["ٱلْبَحْرِ","l-baḥri","the sea","সমুদ্রের"],["سَرَبًۭا","saraban","slipping away","সুড়ঙ্গ করে"]],"t":"فَلَ<g>مَّ</>ا بَلَغَا مَ<q>جْ</>مَعَ بَيْنِهِمَا نَسِيَا حُوتَهُمَا فَ<h>ٱ</>تَّخَذَ سَبِيلَهُ<m>ۥ</> فِى <h>ٱ</>لْبَحْرِ سَرَبًۭا"},{"n":62,"w":[["فَلَمَّا","falammā","Then when","অতঃপর যখন"],["جَاوَزَا","jāwazā","they had passed beyond","দু'জনে অতিক্রম করলো"],["قَالَ","qāla","he said","সে বললো"],["لِفَتَىٰهُ","lifatāhu","to his boy","তার যুবক (সেবক)-কে"],["ءَاتِنَا","ātinā","Bring us","\"আমাদেরকে দাও"],["غَدَآءَنَا","ghadāanā","our morning meal","আমাদের (নাশতা) খাবার"],["لَقَدْ","laqad","Certainly","নিশ্চয়ই"],["لَقِينَا","laqīnā","we have suffered","আমরা পেয়েছি"],["مِن","min","in","থেকে"],["سَفَرِنَا","safarinā","our journey","আমাদের ভ্রমণ"],["هَـٰذَا","hādhā","this","এই"],["نَصَبًۭا","naṣaban","fatigue","ক্লান্তি\""]],"t":"فَلَ<g>مَّ</>ا جَاوَزَا قَالَ لِفَتَ<m>ىٰ</>هُ ءَاتِنَا غَ<o>دَآ</>ءَنَا لَقَ<q>دْ</> لَقِينَا مِ<k>ن سَ</>فَرِنَا <m>هَٰ</>ذَا نَصَبًۭا"},{"n":63,"w":[["قَالَ","qāla","He said","সে বললো"],["أَرَءَيْتَ","ara-ayta","Did you see","\"কি আপনি লক্ষ্য করেছেন"],["إِذْ","idh","when","যখন"],["أَوَيْنَآ","awaynā","we retired","আমরা আশ্রয় নিয়েছিলাম"],["إِلَى","ilā","to","কাছে"],["ٱلصَّخْرَةِ","l-ṣakhrati","the rock","পাথরের"],["فَإِنِّى","fa-innī","Then indeed, I","তখন আমি নিশ্চয়ই"],["نَسِيتُ","nasītu","[I] forgot","ভুলে গিয়েছিলাম"],["ٱلْحُوتَ","l-ḥūta","the fish","মাছকে"],["وَمَآ","wamā","And not","এবং না"],["أَنسَىٰنِيهُ","ansānīhu","made me forget it","তা আমাকে ভুলিয়েছিলো"],["إِلَّا","illā","except","ছাড়া"],["ٱلشَّيْطَـٰنُ","l-shayṭānu","the Shaitaan","শয়তান"],["أَنْ","an","that","যে"],["أَذْكُرَهُۥ ۚ","adhkurahu","I mention it","তা উল্লেখ করবো আমি"],["وَٱتَّخَذَ","wa-ittakhadha","And it took","এবং করে নিলো (মাছ)"],["سَبِيلَهُۥ","sabīlahu","its way","পথ তার"],["فِى","fī","into","মধ্যে"],["ٱلْبَحْرِ","l-baḥri","the sea","সাগরের"],["عَجَبًۭا","‘ajaban","amazingly","আশ্চর্যভাবে\""]],"t":"قَالَ أَرَءَيْتَ إِذْ أَوَيْ<o>نَآ</> إِلَى <h>ٱ</><l>ل</>صَّخْرَةِ فَإِ<g>نِّ</>ى نَسِيتُ <h>ٱ</>لْحُوتَ وَ<o>مَآ</> أَنسَ<m>ىٰ</>نِيهُ إِلَّا <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نُ أَنْ أَذْكُرَهُ<m>ۥ</> ۚ وَ<h>ٱ</>تَّخَذَ سَبِيلَهُ<m>ۥ</> فِى <h>ٱ</>لْبَحْرِ عَجَبًۭا"},{"n":64,"w":[["قَالَ","qāla","He said","সে বললো"],["ذَٰلِكَ","dhālika","That","\"সেটাই"],["مَا","mā","(is) what","যা"],["كُنَّا","kunnā","we were","চেয়েছি"],["نَبْغِ ۚ","nabghi","seeking","আমরা\""],["فَٱرْتَدَّا","fa-ir'taddā","So they returned","অতঃপর দু'জনে ফিরে চললো"],["عَلَىٰٓ","‘alā","on","উপর"],["ءَاثَارِهِمَا","āthārihimā","their footprints","তাদের দু'জনের পায়ের চিহ্ন"],["قَصَصًۭا","qaṣaṣan","retracing","অনুসরণ করে"]],"t":"قَالَ <m>ذَٰ</>لِكَ مَا كُ<g>نَّ</>ا نَ<q>بْ</>غِ ۚ فَ<h>ٱ</>رْتَدَّا عَلَ<o>ىٰٓ</> ءَاثَارِهِمَا قَصَصًۭا"},{"n":65,"w":[["فَوَجَدَا","fawajadā","Then they found","তখন দু'জনে পেলো"],["عَبْدًۭا","‘abdan","a servant","এক দাসকে"],["مِّنْ","min","from","মধ্য হ'তে"],["عِبَادِنَآ","‘ibādinā","Our servants","আমাদের দাসদের"],["ءَاتَيْنَـٰهُ","ātaynāhu","whom We had given","তাকে আমরা দিয়েছিলাম"],["رَحْمَةًۭ","raḥmatan","mercy","অনুগ্রহ"],["مِّنْ","min","from","থেকে"],["عِندِنَا","‘indinā","Us","আমাদের নিকট"],["وَعَلَّمْنَـٰهُ","wa‘allamnāhu","and We had taught him","এবং তাকে আমরা শিখিয়েছিলাম"],["مِن","min","from","থেকে"],["لَّدُنَّا","ladunnā","Us","আমাদের"],["عِلْمًۭا","‘il'man","a knowledge","জ্ঞান"]],"t":"فَوَجَدَا عَ<q>بْ</><d>دًۭا مِّ</>نْ عِبَادِ<o>نَآ</> ءَاتَيْ<m>نَٰ</>هُ رَحْمَ<d>ةًۭ مِّ</>نْ عِ<k>ندِ</>نَا وَعَلَّمْ<m>نَٰ</>هُ <w>مِن لَّ</>دُ<g>نَّ</>ا عِلْمًۭا"},{"n":66,"w":[["قَالَ","qāla","Said","বললো"],["لَهُۥ","lahu","to him","তাকে"],["مُوسَىٰ","mūsā","Musa","মূসা"],["هَلْ","hal","May","\"কি"],["أَتَّبِعُكَ","attabi‘uka","I follow you","আপনাকে অনুসরণ করবো"],["عَلَىٰٓ","‘alā","on","(এ কথার) উপর"],["أَن","an","that","যে"],["تُعَلِّمَنِ","tu‘allimani","you teach me","আপনি আমাকে শিখাবেন"],["مِمَّا","mimmā","of what","তা হ'তে যা"],["عُلِّمْتَ","‘ullim'ta","you have been taught","আপনাকে শিখানো হয়েছে"],["رُشْدًۭا","rush'dan","(of) right guidance","সত্য জ্ঞান\""]],"t":"قَالَ لَهُ<m>ۥ</> مُوسَىٰ هَلْ أَتَّبِعُكَ عَلَ<o>ىٰٓ</> أَ<k>ن تُ</>عَلِّمَنِ مِ<g>مَّ</>ا عُلِّمْتَ رُشْدًۭا"},{"n":67,"w":[["قَالَ","qāla","He said","সে বললো"],["إِنَّكَ","innaka","Indeed, you","\"নিশ্চয়ই আপনি"],["لَن","lan","never","কখনও না"],["تَسْتَطِيعَ","tastaṭī‘a","will be able","পারবেন"],["مَعِىَ","ma‘iya","with me","আমার সাথে"],["صَبْرًۭا","ṣabran","(to have) patience","ধৈর্য ধরতে"]],"t":"قَالَ إِ<g>نَّ</>كَ لَ<k>ن تَ</>سْتَطِيعَ مَعِىَ صَ<q>بْ</>رًۭا"},{"n":68,"w":[["وَكَيْفَ","wakayfa","And how can","এবং কেমমন করে"],["تَصْبِرُ","taṣbiru","you have patience","ধৈর্য ধরবেন"],["عَلَىٰ","‘alā","for","(এ বিষয়ের) উপর"],["مَا","mā","what","যা"],["لَمْ","lam","not","নি করেন"],["تُحِطْ","tuḥiṭ","you encompass","আয়ত্ত্ব"],["بِهِۦ","bihi","of it","সম্পর্কে তা"],["خُبْرًۭا","khub'ran","any knowledge","অভিজ্ঞতায়\""]],"t":"وَكَيْفَ تَصْبِرُ عَلَىٰ مَا لَمْ تُحِ<q>طْ</> بِ<m>هِۦ</> خُ<q>بْ</>رًۭا"},{"n":69,"w":[["قَالَ","qāla","He said","সে বললো"],["سَتَجِدُنِىٓ","satajidunī","You will find me","\"অচিরেই আপনি পাবেন আমাকে"],["إِن","in","if","যদি"],["شَآءَ","shāa","Allah wills","চান"],["ٱللَّهُ","l-lahu","Allah wills","আল্লাহ্‌"],["صَابِرًۭا","ṣābiran","patient","ধৈর্যধারণকারীরূপে"],["وَلَآ","walā","and not","এবং না"],["أَعْصِى","a‘ṣī","I will disobey","আমি অবাধ্যতা করবো"],["لَكَ","laka","your","আপনার"],["أَمْرًۭا","amran","order","নির্দেশের\""]],"t":"قَالَ سَتَجِدُ<o>نِىٓ</> إِ<k>ن شَ</><o>آ</>ءَ <h>ٱ</>للَّهُ صَابِ<d>رًۭا وَ</><o>لَآ</> أَعْصِى لَكَ أَمْرًۭا"},{"n":70,"w":[["قَالَ","qāla","He said","সে বললো"],["فَإِنِ","fa-ini","Then if","\"তাহ'লে যদি"],["ٱتَّبَعْتَنِى","ittaba‘tanī","you follow me","আমার অনুসরণ করেন"],["فَلَا","falā","(do) not","তবে না"],["تَسْـَٔلْنِى","tasalnī","ask me","আমাকে প্রশ্ন করবেন"],["عَن","‘an","about","সম্বন্ধে"],["شَىْءٍ","shayin","anything","কোনো কিছু"],["حَتَّىٰٓ","ḥattā","until","যতক্ষণ না"],["أُحْدِثَ","uḥ'ditha","I present","আমি বলি"],["لَكَ","laka","to you","আপনার জন্য"],["مِنْهُ","min'hu","of it","তা থেকে"],["ذِكْرًۭا","dhik'ran","a mention","কিছু বর্ণনা\""]],"t":"قَالَ فَإِنِ <h>ٱ</>تَّبَعْتَنِى فَلَا تَسْـَٔلْنِى عَ<k>ن شَ</>ىْءٍ حَتَّ<o>ىٰٓ</> أُحْدِثَ لَكَ مِنْهُ ذِكْرًۭا"},{"n":71,"w":[["فَٱنطَلَقَا","fa-inṭalaqā","So they both set out","অতঃপর দু'জন চললো"],["حَتَّىٰٓ","ḥattā","until","এমনকি"],["إِذَا","idhā","when","যখন"],["رَكِبَا","rakibā","they had embarked","দু'জন চড়লো"],["فِى","fī","on","মধ্যে"],["ٱلسَّفِينَةِ","l-safīnati","the ship","একটি নৌকার"],["خَرَقَهَا ۖ","kharaqahā","he made a hole in it","তা সে ফুটো করে দিলো"],["قَالَ","qāla","He said","(মূসা) বললো"],["أَخَرَقْتَهَا","akharaqtahā","Have you made a hole in it","\"তা আপনি কি ফুটো করে দিলেন"],["لِتُغْرِقَ","litugh'riqa","to drown","জন্যে ডুবানোর"],["أَهْلَهَا","ahlahā","its people","তার আরোহীদেরকে"],["لَقَدْ","laqad","Certainly","নিশ্চয়ই"],["جِئْتَ","ji'ta","you have done","আপনি করে এসেছেন"],["شَيْـًٔا","shayan","a thing","কাজ"],["إِمْرًۭا","im'ran","grave","গুরুতর\""]],"t":"فَ<h>ٱ</><k>نطَ</>لَقَا حَتَّ<o>ىٰٓ</> إِذَا رَكِبَا فِى <h>ٱ</><l>ل</>سَّفِينَةِ خَرَقَهَا ۖ قَالَ أَخَرَ<q>قْ</>تَهَا لِتُغْرِقَ أَهْلَهَا لَقَ<q>دْ</> جِئْتَ شَيْـًٔا إِمْرًۭا"},{"n":72,"w":[["قَالَ","qāla","He said","সে বললো"],["أَلَمْ","alam","Did not","\"কি নি"],["أَقُلْ","aqul","I say","আমি বলি"],["إِنَّكَ","innaka","indeed, you","নিশ্চয়ই আপনি"],["لَن","lan","never","কখনও না"],["تَسْتَطِيعَ","tastaṭī‘a","will be able","পারবেন"],["مَعِىَ","ma‘iya","with me","আমার সাথে"],["صَبْرًۭا","ṣabran","(to have) patience","ধৈর্য ধরতে\""]],"t":"قَالَ أَلَمْ أَقُلْ إِ<g>نَّ</>كَ لَ<k>ن تَ</>سْتَطِيعَ مَعِىَ صَ<q>بْ</>رًۭا"},{"n":73,"w":[["قَالَ","qāla","He said","বললো (মূসা)"],["لَا","lā","(Do) not","\"না"],["تُؤَاخِذْنِى","tuākhidh'nī","blame me","ধরবেন আমাকে"],["بِمَا","bimā","for what","এ কারণে যা"],["نَسِيتُ","nasītu","I forgot","আমি ভুলে গিয়েছি"],["وَلَا","walā","and (do) not","এবং না"],["تُرْهِقْنِى","tur'hiq'nī","be hard (upon) me","আমার উপর আরোপ করবেন"],["مِنْ","min","in","মধ্যে"],["أَمْرِى","amrī","my affair","আমার কাজের"],["عُسْرًۭا","‘us'ran","(raising) difficulty","কঠোরতা\""]],"t":"قَالَ لَا تُؤَاخِذْنِى بِمَا نَسِيتُ وَلَا تُرْهِ<q>قْ</>نِى مِنْ أَمْرِى عُسْرًۭا"},{"n":74,"w":[["فَٱنطَلَقَا","fa-inṭalaqā","Then they both set out","অতঃপর দু'জনে চড়লো"],["حَتَّىٰٓ","ḥattā","until","এমনকি"],["إِذَا","idhā","when","যখন"],["لَقِيَا","laqiyā","they met","দু'জনে দেখা পেলো"],["غُلَـٰمًۭا","ghulāman","a boy","এক বালকের"],["فَقَتَلَهُۥ","faqatalahu","then he killed him","তখন সে হত্যা করলো তাকে"],["قَالَ","qāla","He said","(মূসা) বললো"],["أَقَتَلْتَ","aqatalta","Have you killed","\"কি আপনি হত্যা করলেন"],["نَفْسًۭا","nafsan","a soul","একটি জীবনকে"],["زَكِيَّةًۢ","zakiyyatan","pure","নিষ্পাপ"],["بِغَيْرِ","bighayri","for other than","ছাড়া (হত্যা)"],["نَفْسٍۢ","nafsin","a soul","কোনো জীবন"],["لَّقَدْ","laqad","Certainly","নিশ্চয়ই"],["جِئْتَ","ji'ta","you have done","করে এসেছেন"],["شَيْـًۭٔا","shayan","a thing","কাজ"],["نُّكْرًۭا","nuk'ran","evil","গুরুতর অন্যায়\""]],"t":"فَ<h>ٱ</><k>نطَ</>لَقَا حَتَّ<o>ىٰٓ</> إِذَا لَقِيَا غُ<m>لَٰ</><k>مًۭا فَ</>قَتَلَهُ<m>ۥ</> قَالَ أَقَتَلْتَ نَفْ<k>سًۭا زَ</>كِيَّ<i>ةًۢ بِ</>غَيْرِ نَفْ<w>سٍۢ لَّ</>قَ<q>دْ</> جِئْتَ شَ<d>يْـًۭٔا نُّ</>كْرًۭا"},{"n":75,"w":[["۞ قَالَ","qāla","He said","সে বললো"],["أَلَمْ","alam","Did not","\"কি নি"],["أَقُل","aqul","I say","আমি বলি"],["لَّكَ","laka","to you","আপনাকে"],["إِنَّكَ","innaka","that you","নিশ্চয়ই আপনি"],["لَن","lan","never","কখনও না"],["تَسْتَطِيعَ","tastaṭī‘a","will be able","পারবেন"],["مَعِىَ","ma‘iya","with me","আমার সাথে"],["صَبْرًۭا","ṣabran","(to have) patience","ধৈর্য ধরতে\""]],"t":"۞ قَالَ أَلَمْ أَقُل لَّكَ إِ<g>نَّ</>كَ لَ<k>ن تَ</>سْتَطِيعَ مَعِىَ صَ<q>بْ</>رًۭا"},{"n":76,"w":[["قَالَ","qāla","He said","(মূসা) বললো"],["إِن","in","If","\"যদি"],["سَأَلْتُكَ","sa-altuka","I ask you","আপনাকে আমি প্রশ্ন করি"],["عَن","‘an","about","সম্বন্ধে"],["شَىْءٍۭ","shayin","anything","কোনো কিছু"],["بَعْدَهَا","ba‘dahā","after it","এরপর"],["فَلَا","falā","then (do) not","তাহ'লে না"],["تُصَـٰحِبْنِى ۖ","tuṣāḥib'nī","keep me as a companion","আমাকে আপনি সঙ্গে রাখবেন"],["قَدْ","qad","Verily","নিশ্চয়ই"],["بَلَغْتَ","balaghta","you have reached","আপনি পৌঁছে গেছেন"],["مِن","min","from me","থেকে"],["لَّدُنِّى","ladunnī","from me","আমার পক্ষ"],["عُذْرًۭا","‘udh'ran","an excuse","অজুহাতের শেষ সীমায়\""]],"t":"قَالَ إِ<k>ن سَ</>أَلْتُكَ عَ<k>ن شَ</>ىْ<i>ءٍۭ بَ</>عْدَهَا فَلَا تُ<m>صَٰ</>حِ<q>بْ</>نِى ۖ قَ<q>دْ</> بَلَغْتَ <w>مِن لَّ</>دُ<g>نِّ</>ى عُذْرًۭا"},{"n":77,"w":[["فَٱنطَلَقَا","fa-inṭalaqā","So they set out","অতঃপর দু'জনে চললো"],["حَتَّىٰٓ","ḥattā","until","এমনকি"],["إِذَآ","idhā","when","যখন"],["أَتَيَآ","atayā","they came","দু'জনে আসলো"],["أَهْلَ","ahla","(to the) people","আধিবাসীদের কাছে"],["قَرْيَةٍ","qaryatin","(of) a town","এক জনপদের"],["ٱسْتَطْعَمَآ","is'taṭ‘amā","they asked for food","দু'জনে খাদ্য চাইলো"],["أَهْلَهَا","ahlahā","(from) its people","তার অধিবাসীদের কাছে"],["فَأَبَوْا۟","fa-abaw","but they refused","কিন্তু তারা অস্বীকার করলো"],["أَن","an","to","যে"],["يُضَيِّفُوهُمَا","yuḍayyifūhumā","offer them hospitality","তারা আতিথেয়তা করবে তাদের দু'জনকে"],["فَوَجَدَا","fawajadā","Then they found","অতঃপর দু'জন পেলো"],["فِيهَا","fīhā","in it","মধ্যে তার"],["جِدَارًۭا","jidāran","a wall","একটি দেয়াল"],["يُرِيدُ","yurīdu","(that) want(ed)","চাচ্ছিলো"],["أَن","an","to","যে"],["يَنقَضَّ","yanqaḍḍa","collapse","ভেঙ্গে পড়বে"],["فَأَقَامَهُۥ ۖ","fa-aqāmahu","so he set it straight","অতঃপর তা সে দাঁড় করিয়ে দিলো"],["قَالَ","qāla","He said","(মূসা) বললো"],["لَوْ","law","If","\"যদি"],["شِئْتَ","shi'ta","you wished","আপনি চাইতেন"],["لَتَّخَذْتَ","lattakhadhta","surely you (could) have taken","অবশ্যই আপনি নিতে পারতেন"],["عَلَيْهِ","‘alayhi","for it","এর বিনিময়ে"],["أَجْرًۭا","ajran","a payment","পারিশ্রমিক\""]],"t":"فَ<h>ٱ</><k>نطَ</>لَقَا حَتَّ<o>ىٰٓ</> إِ<o>ذَآ</> أَتَ<o>يَآ</> أَهْلَ قَرْيَةٍ <h>ٱ</>سْتَ<q>طْ</>عَ<o>مَآ</> أَهْلَهَا فَأَبَوْ<s>ا۟</> <d>أَن يُ</>ضَيِّفُوهُمَا فَوَجَدَا فِيهَا جِدَا<d>رًۭا يُ</>رِيدُ <d>أَن يَ</><k>نقَ</>ضَّ فَأَقَامَهُ<m>ۥ</> ۖ قَالَ لَوْ شِئْتَ لَتَّخَذْتَ عَلَيْهِ أَ<q>جْ</>رًۭا"},{"n":78,"w":[["قَالَ","qāla","He said","সে বললো"],["هَـٰذَا","hādhā","This","\"এটাই"],["فِرَاقُ","firāqu","(is) parting","(যাত্রা শেষ) বিচ্ছেদ"],["بَيْنِى","baynī","between me","মাঝে আমার"],["وَبَيْنِكَ ۚ","wabaynika","and between you","ও মাঝে আপনার"],["سَأُنَبِّئُكَ","sa-unabbi-uka","I will inform you","শীঘ্রই আপনাকে জানিয়ে দিবো"],["بِتَأْوِيلِ","bitawīli","of (the) interpretation","সম্পর্কে তাৎপর্য"],["مَا","mā","(of) what","যে বিষয়ে"],["لَمْ","lam","not","নি"],["تَسْتَطِع","tastaṭi‘","you were able","পারেন"],["عَّلَيْهِ","‘alayhi","on it","উপর তার"],["صَبْرًا","ṣabran","(to have) patience","ধৈর্য ধরতে"]],"t":"قَالَ <m>هَٰ</>ذَا فِرَاقُ بَيْنِى وَبَيْنِكَ ۚ سَأُنَبِّئُكَ بِتَأْوِيلِ مَا لَمْ تَسْتَطِع عَّلَيْهِ صَ<q>بْ</>رًا"},{"n":79,"w":[["أَمَّا","ammā","As for","ব্যাপার হলো"],["ٱلسَّفِينَةُ","l-safīnatu","the ship","নৌকাটির"],["فَكَانَتْ","fakānat","it was","অতঃপর সেটা ছিলো"],["لِمَسَـٰكِينَ","limasākīna","of (the) poor people","ক'জন গরীব ব্যক্তির"],["يَعْمَلُونَ","ya‘malūna","working","পরিশ্রম করতো"],["فِى","fī","in","মধ্যে"],["ٱلْبَحْرِ","l-baḥri","the sea","সমুদ্রের"],["فَأَرَدتُّ","fa-aradttu","So I intended","সুতরাং আমি চেয়েছি"],["أَنْ","an","that","যে"],["أَعِيبَهَا","a‘ībahā","I cause defect (in) it","তা ত্রুটিযুক্ত করি"],["وَكَانَ","wakāna","(as there) was","এবং ছিলো"],["وَرَآءَهُم","warāahum","after them","পিছনে তাদের"],["مَّلِكٌۭ","malikun","a king","এক রাজা"],["يَأْخُذُ","yakhudhu","who seized","নিয়ে নিতো"],["كُلَّ","kulla","every","প্রত্যেক"],["سَفِينَةٍ","safīnatin","ship","নৌকা"],["غَصْبًۭا","ghaṣban","(by) force","জোর করে"]],"t":"أَ<g>مَّ</>ا <h>ٱ</><l>ل</>سَّفِينَةُ فَكَانَتْ لِمَ<m>سَٰ</>كِينَ يَعْمَلُونَ فِى <h>ٱ</>لْبَحْرِ فَأَرَ<j>د</>تُّ أَنْ أَعِيبَهَا وَكَانَ وَ<o>رَآ</>ءَ<y>هُم مَّ</>لِ<d>كٌۭ يَ</>أْخُذُ كُلَّ سَفِينَةٍ غَصْبًۭا"},{"n":80,"w":[["وَأَمَّا","wa-ammā","And as for","আর ব্যাপার হলো"],["ٱلْغُلَـٰمُ","l-ghulāmu","the boy","ছেলেটির"],["فَكَانَ","fakāna","his parents were","অতঃপর ছিলো"],["أَبَوَاهُ","abawāhu","his parents were","তার পিতামাতা"],["مُؤْمِنَيْنِ","mu'minayni","believers","দু'জন মু'মিন"],["فَخَشِينَآ","fakhashīnā","and we feared","তখন আমরা আশঙ্কা করলাম"],["أَن","an","that","যে"],["يُرْهِقَهُمَا","yur'hiqahumā","he would overburden them","তাদের দু'জনকে সে কষ্ট দিবে"],["طُغْيَـٰنًۭا","ṭugh'yānan","(by) transgression","অবাধ্যতা করে"],["وَكُفْرًۭا","wakuf'ran","and disbelief","ও অবিশ্বাস (পথে চলে)"]],"t":"وَأَ<g>مَّ</>ا <h>ٱ</>لْغُ<m>لَٰ</>مُ فَكَانَ أَبَوَاهُ مُؤْمِنَيْنِ فَخَشِي<o>نَآ</> <d>أَن يُ</>رْهِقَهُمَا طُغْ<m>يَٰ</><d>نًۭا وَ</>كُفْرًۭا"},{"n":81,"w":[["فَأَرَدْنَآ","fa-aradnā","So we intended","সুতরাং আমরা চাইলাম"],["أَن","an","that","যে"],["يُبْدِلَهُمَا","yub'dilahumā","would change for them","দু'জনকে পরিবর্তে দিবেন"],["رَبُّهُمَا","rabbuhumā","their Lord","দু'জনের রব"],["خَيْرًۭا","khayran","a better","উত্তম"],["مِّنْهُ","min'hu","than him","তার চেয়ে"],["زَكَوٰةًۭ","zakatan","(in) purity","পবিত্রতায়"],["وَأَقْرَبَ","wa-aqraba","and nearer","এবং ঘনিষ্টতর"],["رُحْمًۭا","ruḥ'man","(in) affection","দয়ার দিক থেকে"]],"t":"فَأَرَ<q>دْ</><o>نَآ</> <d>أَن يُ</><q>بْ</>دِلَهُمَا رَبُّهُمَا خَيْ<d>رًۭا مِّ</>نْهُ زَكَ<s>وٰ</><d>ةًۭ وَ</>أَ<q>قْ</>رَبَ رُحْمًۭا"},{"n":82,"w":[["وَأَمَّا","wa-ammā","And as for","আর ব্যাপার (হলো)"],["ٱلْجِدَارُ","l-jidāru","the wall","দেয়ালটির (এই যে)"],["فَكَانَ","fakāna","it was","অতঃপর সেটা ছিলো"],["لِغُلَـٰمَيْنِ","lighulāmayni","for two orphan boys","দু'টি ছেলের"],["يَتِيمَيْنِ","yatīmayni","for two orphan boys","পিতৃহীন"],["فِى","fī","in","মধ্যে"],["ٱلْمَدِينَةِ","l-madīnati","the town","শহরটির"],["وَكَانَ","wakāna","and was","এবং ছিলো"],["تَحْتَهُۥ","taḥtahu","underneath it","নিচে তার"],["كَنزٌۭ","kanzun","a treasure","গুপ্তধন"],["لَّهُمَا","lahumā","for them","জন্যে দু'জনের"],["وَكَانَ","wakāna","and was","এবং ছিলো"],["أَبُوهُمَا","abūhumā","their father","তাদের দু'জনের পিতা"],["صَـٰلِحًۭا","ṣāliḥan","righteous","সৎ ব্যক্তি"],["فَأَرَادَ","fa-arāda","So intended","সুতরাং চাইলেন"],["رَبُّكَ","rabbuka","your Lord","আপনার রব"],["أَن","an","that","যে"],["يَبْلُغَآ","yablughā","they reach","দু'জনে পৌঁছবে"],["أَشُدَّهُمَا","ashuddahumā","their maturity","দু'জনের যৌবনে তাদের"],["وَيَسْتَخْرِجَا","wayastakhrijā","and bring forth","এবং দু'জনে উদ্ধার করবে"],["كَنزَهُمَا","kanzahumā","their treasure","গুপ্তধন দু'জনের"],["رَحْمَةًۭ","raḥmatan","(as) a mercy","(এটা) দয়া"],["مِّن","min","from","থেকে"],["رَّبِّكَ ۚ","rabbika","your Lord","আপনার রবের"],["وَمَا","wamā","And not","এবং না"],["فَعَلْتُهُۥ","fa‘altuhu","I did it","তা আমি করেছি"],["عَنْ","‘an","on","থেকে"],["أَمْرِى ۚ","amrī","my (own) accord","আমার ইচ্ছা"],["ذَٰلِكَ","dhālika","That","এটা"],["تَأْوِيلُ","tawīlu","(is the) interpretation","ব্যাখ্যা"],["مَا","mā","(of) what","যে বিষয়ে"],["لَمْ","lam","not","নি"],["تَسْطِع","tasṭi‘","you were able","পারেন"],["عَّلَيْهِ","‘alayhi","on it","উপর তার"],["صَبْرًۭا","ṣabran","(to have) patience","ধৈর্য ধরতে\""]],"t":"وَأَ<g>مَّ</>ا <h>ٱ</>لْجِدَارُ فَكَانَ لِغُ<m>لَٰ</>مَيْنِ يَتِيمَيْنِ فِى <h>ٱ</>لْمَدِينَةِ وَكَانَ تَحْتَهُ<m>ۥ</> كَن<w>زٌۭ لَّ</>هُمَا وَكَانَ أَبُوهُمَا <m>صَٰ</>لِ<k>حًۭا فَ</>أَرَادَ رَبُّكَ <d>أَن يَ</><q>بْ</>لُ<o>غَآ</> أَشُدَّهُمَا وَيَسْتَخْرِجَا كَ<k>نزَ</>هُمَا رَحْمَ<d>ةًۭ مِّ</><w>ن رَّ</>بِّكَ ۚ وَمَا فَعَلْتُهُ<m>ۥ</> عَنْ أَمْرِى ۚ <m>ذَٰ</>لِكَ تَأْوِيلُ مَا لَمْ تَسْطِع عَّلَيْهِ صَ<q>بْ</>رًۭا"},{"n":83,"w":[["وَيَسْـَٔلُونَكَ","wayasalūnaka","And they ask you","এবং তোমাকে প্রশ্ন করছে"],["عَن","‘an","about","সম্বন্ধে"],["ذِى","dhī","Dhul-qarnain","বিশিষ্ট"],["ٱلْقَرْنَيْنِ ۖ","l-qarnayni","Dhul-qarnain","দুই গুচ্ছ"],["قُلْ","qul","Say","বলো"],["سَأَتْلُوا۟","sa-atlū","I will recite","\"অচিরেই পাঠ করে শোনাবো"],["عَلَيْكُم","‘alaykum","to you","কাছে তোমাদের"],["مِّنْهُ","min'hu","about him","থেকে তা"],["ذِكْرًا","dhik'ran","a remembrance","(কিছু) বর্ণনা\""]],"t":"وَيَسْـَٔلُونَكَ عَ<k>ن ذِ</>ى <h>ٱ</>لْقَرْنَيْنِ ۖ قُلْ سَأَتْلُو<s>ا۟</> عَلَيْ<y>كُم مِّ</>نْهُ ذِكْرًا"},{"n":84,"w":[["إِنَّا","innā","Indeed, We","নিশ্চয়ই আমরা"],["مَكَّنَّا","makkannā","[We] established","আমরা কর্তৃত্ব দিয়েছিলাম"],["لَهُۥ","lahu","[for] him","তাকে"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["وَءَاتَيْنَـٰهُ","waātaynāhu","and We gave him","এবং তাকে আমরা দিয়েছিলাম"],["مِن","min","of","থেকে"],["كُلِّ","kulli","every","প্রত্যেক"],["شَىْءٍۢ","shayin","thing","বস্তু"],["سَبَبًۭا","sababan","a means","পথ নির্দেশ"]],"t":"إِ<g>نَّ</>ا مَكَّ<g>نَّ</>ا لَهُ<m>ۥ</> فِى <h>ٱ</>لْأَرْضِ وَءَاتَيْ<m>نَٰ</>هُ مِ<k>ن كُ</>لِّ <k>شَىْءٍۢ سَ</>بَبًۭا"},{"n":85,"w":[["فَأَتْبَعَ","fa-atba‘a","So he followed","অতঃপর সে অনুসরণ করলো"],["سَبَبًا","sababan","a course","এক পথ"]],"t":"فَأَتْبَعَ سَبَبًا"},{"n":86,"w":[["حَتَّىٰٓ","ḥattā","Until","শেষ পর্যন্ত"],["إِذَا","idhā","when","যখন"],["بَلَغَ","balagha","he reached","পৌঁছলো"],["مَغْرِبَ","maghriba","(the) setting place","অস্তাচলে"],["ٱلشَّمْسِ","l-shamsi","(of) the sun","সূর্যের"],["وَجَدَهَا","wajadahā","he found it","পেলো তা"],["تَغْرُبُ","taghrubu","setting","অস্ত যাচ্ছে"],["فِى","fī","in","মধ্যে"],["عَيْنٍ","‘aynin","a spring","জলাশয়"],["حَمِئَةٍۢ","ḥami-atin","(of) dark mud","পঙ্কিল"],["وَوَجَدَ","wawajada","and he found","এবং সে পেলো"],["عِندَهَا","‘indahā","near it","তার কাছে"],["قَوْمًۭا ۗ","qawman","a community","এক জাতিকে"],["قُلْنَا","qul'nā","We said","আমরা বললাম"],["يَـٰذَا","yādhā","O Dhul-qarnain","\""],["ٱلْقَرْنَيْنِ","l-qarnayni","O Dhul-qarnain","\"হে জুলকারনাইন"],["إِمَّآ","immā","Either","হয়"],["أَن","an","[that]","যে"],["تُعَذِّبَ","tu‘adhiba","you punish","তুমি শাস্তি দিবে"],["وَإِمَّآ","wa-immā","or","আর না হয়"],["أَن","an","[that]","যে"],["تَتَّخِذَ","tattakhidha","you take","তুমি অবলম্বন করো"],["فِيهِمْ","fīhim","[in] them","জন্যে তাদের"],["حُسْنًۭا","ḥus'nan","(with) goodness","সদ্ব্যবহার\""]],"t":"حَتَّ<o>ىٰٓ</> إِذَا بَلَغَ مَغْرِبَ <h>ٱ</><l>ل</>شَّمْسِ وَجَدَهَا تَغْرُبُ فِى عَيْنٍ حَمِئَ<d>ةٍۢ وَ</>وَجَدَ عِ<k>ندَ</>هَا قَوْ<k>مًۭا ۗ قُ</>لْنَا <m>يَٰ</>ذَا <h>ٱ</>لْقَرْنَيْنِ إِ<g>مَّ</><o>آ</> أَ<k>ن تُ</>عَذِّبَ وَإِ<g>مَّ</><o>آ</> أَ<k>ن تَ</>تَّخِذَ فِيهِمْ حُسْنًۭا"},{"n":87,"w":[["قَالَ","qāla","He said","সে বললো"],["أَمَّا","ammā","As for","\"ব্যাপারে"],["مَن","man","(one) who","(তার) যে"],["ظَلَمَ","ẓalama","wrongs","সীমালঙ্ঘন করেছে"],["فَسَوْفَ","fasawfa","then soon","অতঃপর শীঘ্রই"],["نُعَذِّبُهُۥ","nu‘adhibuhu","we will punish him","তাকে আমরা শাস্তি দিবো"],["ثُمَّ","thumma","Then","এরপর"],["يُرَدُّ","yuraddu","he will be returned","ফিরিয়ে আনা হবে"],["إِلَىٰ","ilā","to","দিকে"],["رَبِّهِۦ","rabbihi","his Lord","তার রবের"],["فَيُعَذِّبُهُۥ","fayu‘adhibuhu","and He will punish him","অতঃপর তিনি শাস্তি দিবেন তাকে"],["عَذَابًۭا","‘adhāban","(with) a punishment","শাস্তি"],["نُّكْرًۭا","nuk'ran","terrible","কঠিন"]],"t":"قَالَ أَ<g>مَّ</>ا مَ<k>ن ظَ</>لَمَ فَسَوْفَ نُعَذِّبُهُ<m>ۥ</> ثُ<g>مَّ</> يُرَدُّ إِلَىٰ رَبِّ<m>هِۦ</> فَيُعَذِّبُهُ<m>ۥ</> عَذَا<d>بًۭا نُّ</>كْرًۭا"},{"n":88,"w":[["وَأَمَّا","wa-ammā","But as for","আর ব্যাপারে"],["مَنْ","man","(one) who","(তার) যে"],["ءَامَنَ","āmana","believes","ঈমান আনবে"],["وَعَمِلَ","wa‘amila","and does","ও কাজ করে"],["صَـٰلِحًۭا","ṣāliḥan","righteous (deeds)","সৎ"],["فَلَهُۥ","falahu","then for him","তবে তার জন্যে"],["جَزَآءً","jazāan","(is) a reward","পুরস্কার (রয়েছে)"],["ٱلْحُسْنَىٰ ۖ","l-ḥus'nā","good","উত্তম"],["وَسَنَقُولُ","wasanaqūlu","And we will speak","এবং অচিরেই আমরা বলবো"],["لَهُۥ","lahu","to him","তাকে"],["مِنْ","min","from","মধ্য হ'তে"],["أَمْرِنَا","amrinā","our command","আমাদের নির্দেশের"],["يُسْرًۭا","yus'ran","(with) ease","যা সহজ\""]],"t":"وَأَ<g>مَّ</>ا مَنْ ءَامَنَ وَعَمِلَ <m>صَٰ</>لِ<k>حًۭا فَ</>لَهُ<m>ۥ</> جَ<o>زَآ</>ءً <h>ٱ</>لْحُسْنَىٰ ۖ وَسَنَقُولُ لَهُ<m>ۥ</> مِنْ أَمْرِنَا يُسْرًۭا"},{"n":89,"w":[["ثُمَّ","thumma","Then","এরপর"],["أَتْبَعَ","atba‘a","he followed","সে অনুসরণ করলো"],["سَبَبًا","sababan","(a) course","আরও এক পথ"]],"t":"ثُ<g>مَّ</> أَتْبَعَ سَبَبًا"},{"n":90,"w":[["حَتَّىٰٓ","ḥattā","Until","শেষ পর্যন্ত"],["إِذَا","idhā","when","যখন"],["بَلَغَ","balagha","he reached","পৌঁছে গেল"],["مَطْلِعَ","maṭli‘a","(the) rising place","উদয়াচলে"],["ٱلشَّمْسِ","l-shamsi","(of) the sun","সূর্যের"],["وَجَدَهَا","wajadahā","and he found it","সে তা পেলো"],["تَطْلُعُ","taṭlu‘u","rising","উদয় হ'তে"],["عَلَىٰ","‘alā","on","উপর"],["قَوْمٍۢ","qawmin","a community","এক জাতির"],["لَّمْ","lam","not","নি"],["نَجْعَل","naj‘al","We made","আমরা সৃষ্টি করি"],["لَّهُم","lahum","for them","জন্যে তাদের"],["مِّن","min","against it","ছাড়া"],["دُونِهَا","dūnihā","against it","তা"],["سِتْرًۭا","sit'ran","any shelter","কোনো আড়াল"]],"t":"حَتَّ<o>ىٰٓ</> إِذَا بَلَغَ مَ<q>طْ</>لِعَ <h>ٱ</><l>ل</>شَّمْسِ وَجَدَهَا تَ<q>طْ</>لُعُ عَلَىٰ قَوْ<w>مٍۢ لَّ</>مْ نَ<q>جْ</>عَل لَّ<y>هُم مِّ</><k>ن دُ</>ونِهَا سِتْرًۭا"},{"n":91,"w":[["كَذَٰلِكَ","kadhālika","Thus","এরূপ ছিলো"],["وَقَدْ","waqad","And verily","এবং নিশ্চয়ই"],["أَحَطْنَا","aḥaṭnā","We encompassed","আমরা পূর্ণ অবগত আছি"],["بِمَا","bimā","of what","ঐ বিষয় যা"],["لَدَيْهِ","ladayhi","(was) with him","তার সাথে ছিলো"],["خُبْرًۭا","khub'ran","(of the) information","বিবরণ"]],"t":"كَ<m>ذَٰ</>لِكَ وَقَ<q>دْ</> أَحَ<q>طْ</>نَا بِمَا لَدَيْهِ خُ<q>بْ</>رًۭا"},{"n":92,"w":[["ثُمَّ","thumma","Then","এরপর"],["أَتْبَعَ","atba‘a","he followed","সে অনুসরণ করলো"],["سَبَبًا","sababan","a course","(আরও) এক পথ"]],"t":"ثُ<g>مَّ</> أَتْبَعَ سَبَبًا"},{"n":93,"w":[["حَتَّىٰٓ","ḥattā","Until","অবশেষে"],["إِذَا","idhā","when","যখন"],["بَلَغَ","balagha","he reached","পৌঁছে গেলো"],["بَيْنَ","bayna","between","মাঝে"],["ٱلسَّدَّيْنِ","l-sadayni","the two mountains","দুই (পর্বত) প্রাচীরের"],["وَجَدَ","wajada","he found","সে পেলো"],["مِن","min","besides them","ছাড়াও"],["دُونِهِمَا","dūnihimā","besides them","তাদের দু'য়ের"],["قَوْمًۭا","qawman","a community","এক জাতিকে"],["لَّا","lā","not","না"],["يَكَادُونَ","yakādūna","who would almost","নিকটেও হতো"],["يَفْقَهُونَ","yafqahūna","understand","তারা বুঝার"],["قَوْلًۭا","qawlan","(his) speech","কথা"]],"t":"حَتَّ<o>ىٰٓ</> إِذَا بَلَغَ بَيْنَ <h>ٱ</><l>ل</>سَّدَّيْنِ وَجَدَ مِ<k>ن دُ</>ونِهِمَا قَوْ<w>مًۭا لَّ</>ا يَكَادُونَ يَفْقَهُونَ قَوْلًۭا"},{"n":94,"w":[["قَالُوا۟","qālū","They said","তারা বললো"],["يَـٰذَا","yādhā","O Dhul-qarnain","\""],["ٱلْقَرْنَيْنِ","l-qarnayni","O Dhul-qarnain","\"হে জুলকারনাইন"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["يَأْجُوجَ","yajūja","Yajuj","ইয়াজুজ"],["وَمَأْجُوجَ","wamajūja","and Majuj","এবং মাজুজ"],["مُفْسِدُونَ","muf'sidūna","(are) corrupters","অশান্তি সৃষ্টিকারী"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the land","পৃথিবীর (এ অঙ্গনে)"],["فَهَلْ","fahal","So may","তবে কি"],["نَجْعَلُ","naj‘alu","we make","আমরা দিবো"],["لَكَ","laka","for you","তোমার জন্যে"],["خَرْجًا","kharjan","an expenditure","কর"],["عَلَىٰٓ","‘alā","[on]","এই শর্তে"],["أَن","an","that","যে"],["تَجْعَلَ","taj‘ala","you make","তুমি বানাবে"],["بَيْنَنَا","baynanā","between us","মাঝে আমাদের"],["وَبَيْنَهُمْ","wabaynahum","and between them","এবং মাঝে তাদের"],["سَدًّۭا","saddan","a barrier","একটি প্রাচীর\""]],"t":"قَالُو<s>ا۟</> <m>يَٰ</>ذَا <h>ٱ</>لْقَرْنَيْنِ إِ<g>نَّ</> يَأْجُوجَ وَمَأْجُوجَ مُفْسِدُونَ فِى <h>ٱ</>لْأَرْضِ فَهَلْ نَ<q>جْ</>عَلُ لَكَ خَرْجًا عَلَ<o>ىٰٓ</> أَ<k>ن تَ</><q>جْ</>عَلَ بَيْنَنَا وَبَيْنَهُمْ سَدًّۭا"},{"n":95,"w":[["قَالَ","qāla","He said","সে বললো"],["مَا","mā","What","\"যা"],["مَكَّنِّى","makkannī","has established me","আমাকে ক্ষমতা দিয়েছেন"],["فِيهِ","fīhi","[in it]","মধ্যে তার"],["رَبِّى","rabbī","my Lord","আমার রব"],["خَيْرٌۭ","khayrun","(is) better","(তাই) উৎকৃষ্ট"],["فَأَعِينُونِى","fa-a‘īnūnī","but assist me","সুতরাং আমাকে তোমরা সাহায্য করো"],["بِقُوَّةٍ","biquwwatin","with strength","দিয়ে শ্রম"],["أَجْعَلْ","aj‘al","I will make","বানাবো আমি"],["بَيْنَكُمْ","baynakum","between you","মাঝে তোমাদের"],["وَبَيْنَهُمْ","wabaynahum","and between them","এবং মাঝে তাদের"],["رَدْمًا","radman","a barrier","শক্ত দেয়াল"]],"t":"قَالَ مَا مَكَّ<g>نِّ</>ى فِيهِ رَبِّى خَيْ<k>رٌۭ فَ</>أَعِينُونِى بِقُوَّةٍ أَ<q>جْ</>عَلْ بَيْنَكُمْ وَبَيْنَهُمْ رَ<q>دْ</>مًا"},{"n":96,"w":[["ءَاتُونِى","ātūnī","Bring me","আমাকে এনে দাও"],["زُبَرَ","zubara","sheets","পাতসমূহ"],["ٱلْحَدِيدِ ۖ","l-ḥadīdi","(of) iron","লোহার\""],["حَتَّىٰٓ","ḥattā","until","অবশেষে"],["إِذَا","idhā","when","যখন"],["سَاوَىٰ","sāwā","he (had) leveled","সমান হলো"],["بَيْنَ","bayna","between","মাঝে"],["ٱلصَّدَفَيْنِ","l-ṣadafayni","the two cliffs","পাহাড়ের ফাঁকা জায়গা দুই"],["قَالَ","qāla","he said","সে বললো"],["ٱنفُخُوا۟ ۖ","unfukhū","Blow","\"তোমরা (হাপরে) দম দাও\""],["حَتَّىٰٓ","ḥattā","until","অবশেষে"],["إِذَا","idhā","when","যখন"],["جَعَلَهُۥ","ja‘alahu","he made it","তা পরিণত করলো"],["نَارًۭا","nāran","fire","আগুনের মতো"],["قَالَ","qāla","he said","সে বললো"],["ءَاتُونِىٓ","ātūnī","Bring me","\"আমাকে এনে দাও"],["أُفْرِغْ","uf'righ","I pour","আমি ঢেলে দেই"],["عَلَيْهِ","‘alayhi","over it","উপর তার"],["قِطْرًۭا","qiṭ'ran","molten copper","গলানো তামা\""]],"t":"ءَاتُونِى زُبَرَ <h>ٱ</>لْحَدِيدِ ۖ حَتَّ<o>ىٰٓ</> إِذَا سَاوَىٰ بَيْنَ <h>ٱ</><l>ل</>صَّدَفَيْنِ قَالَ <h>ٱ</><k>نفُ</>خُو<s>ا۟ ۖ</> حَتَّ<o>ىٰٓ</> إِذَا جَعَلَهُ<m>ۥ</> نَا<k>رًۭا قَ</>الَ ءَاتُو<o>نِىٓ</> أُفْرِغْ عَلَيْهِ قِ<q>طْ</>رًۭا"},{"n":97,"w":[["فَمَا","famā","So not","অতঃপর না"],["ٱسْطَـٰعُوٓا۟","is'ṭā‘ū","they were able","তারা সক্ষম হলো"],["أَن","an","to","যে"],["يَظْهَرُوهُ","yaẓharūhu","scale it","তা তারা অতিক্রম করবে"],["وَمَا","wamā","and not","এবং না"],["ٱسْتَطَـٰعُوا۟","is'taṭā‘ū","they were able","তারা সক্ষম হলো"],["لَهُۥ","lahu","in it","মধ্যে তার"],["نَقْبًۭا","naqban","(to do) any penetration","ছিদ্র করতে"]],"t":"فَمَا <h>ٱ</>سْ<m>طَٰ</><o>عُوٓ</><s>ا۟</> <d>أَن يَ</>ظْهَرُوهُ وَمَا <h>ٱ</>سْتَ<m>طَٰ</>عُو<s>ا۟</> لَهُ<m>ۥ</> نَ<q>قْ</>بًۭا"},{"n":98,"w":[["قَالَ","qāla","He said","সে বললো"],["هَـٰذَا","hādhā","This","\"এটা"],["رَحْمَةٌۭ","raḥmatun","(is) a mercy","অনুগ্রহ"],["مِّن","min","from","পক্ষ হ'তে"],["رَّبِّى ۖ","rabbī","my Lord","আমার রবের"],["فَإِذَا","fa-idhā","But when","অতঃপর যখন"],["جَآءَ","jāa","comes","আসবে"],["وَعْدُ","wa‘du","(the) Promise","প্রতিশ্রুতি"],["رَبِّى","rabbī","(of) my Lord","আমার রবের"],["جَعَلَهُۥ","ja‘alahu","He will make it","তা করে দিবেন"],["دَكَّآءَ ۖ","dakkāa","level","চূর্ণবিচূর্ণ"],["وَكَانَ","wakāna","And is","এবং হলো"],["وَعْدُ","wa‘du","(the) Promise","প্রতিশ্রুতি"],["رَبِّى","rabbī","(of) my Lord","আমার রবের"],["حَقًّۭا","ḥaqqan","true","সত্য\""]],"t":"قَالَ <m>هَٰ</>ذَا رَحْمَ<d>ةٌۭ مِّ</><w>ن رَّ</>بِّى ۖ فَإِذَا <o>جَآ</>ءَ وَعْدُ رَبِّى جَعَلَهُ<m>ۥ</> دَ<o>كَّآ</>ءَ ۖ وَكَانَ وَعْدُ رَبِّى حَقًّۭا"},{"n":99,"w":[["۞ وَتَرَكْنَا","wataraknā","And We (will) leave","এবং আমরা ছেড়ে দিববো"],["بَعْضَهُمْ","ba‘ḍahum","some of them","তাদের কাউকে"],["يَوْمَئِذٍۢ","yawma-idhin","(on) that Day","সেদিন"],["يَمُوجُ","yamūju","to surge","তরঙ্গের মত পড়বে"],["فِى","fī","over","মধ্যে"],["بَعْضٍۢ ۖ","ba‘ḍin","others","কারও"],["وَنُفِخَ","wanufikha","and (will be) blown","এবং ফুঁ দেয়া হবে"],["فِى","fī","in","মধ্যে"],["ٱلصُّورِ","l-ṣūri","the trumpet","শিঙ্গার"],["فَجَمَعْنَـٰهُمْ","fajama‘nāhum","then We (will) gather them","অতঃপর আমরা একত্র করবো তাদেরকে"],["جَمْعًۭا","jam‘an","all together","একসঙ্গে"]],"t":"۞ وَتَرَكْنَا بَعْضَهُمْ يَوْمَئِ<d>ذٍۢ يَ</>مُوجُ فِى بَعْ<d>ضٍۢ ۖ وَ</>نُفِخَ فِى <h>ٱ</><l>ل</>صُّورِ فَجَمَعْ<m>نَٰ</>هُمْ جَمْعًۭا"},{"n":100,"w":[["وَعَرَضْنَا","wa‘araḍnā","And We (will) present","এবং আমরা পেশ করবো"],["جَهَنَّمَ","jahannama","Hell","জাহান্নামকে"],["يَوْمَئِذٍۢ","yawma-idhin","(on) that Day","সেদিন"],["لِّلْكَـٰفِرِينَ","lil'kāfirīna","to the disbelievers","জন্যে কাফিরদের"],["عَرْضًا","‘arḍan","(on) display","প্রত্যক্ষভাবে"]],"t":"وَعَرَضْنَا جَهَ<g>نَّ</>مَ يَوْمَئِ<w>ذٍۢ لِّ</>لْ<m>كَٰ</>فِرِينَ عَرْضًا"},{"n":101,"w":[["ٱلَّذِينَ","alladhīna","Those","যাদের"],["كَانَتْ","kānat","had been","ছিলো"],["أَعْيُنُهُمْ","a‘yunuhum","their eyes","চোখগুলোর তাদের"],["فِى","fī","within","মধ্যে"],["غِطَآءٍ","ghiṭāin","a cover","পর্দা"],["عَن","‘an","from","থেকে"],["ذِكْرِى","dhik'rī","My remembrance","আমার স্মরণ"],["وَكَانُوا۟","wakānū","and were","এবং তারা ছিলো"],["لَا","lā","not","না"],["يَسْتَطِيعُونَ","yastaṭī‘ūna","able","সক্ষম হতো"],["سَمْعًا","sam‘an","(to) hear","শুনতে"]],"t":"ٱلَّذِينَ كَانَتْ أَعْيُنُهُمْ فِى غِ<o>طَآ</>ءٍ عَ<k>ن ذِ</>كْرِى وَكَانُو<s>ا۟</> لَا يَسْتَطِيعُونَ سَمْعًا"},{"n":102,"w":[["أَفَحَسِبَ","afaḥasiba","Do then think","কি মনে করেছে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوٓا۟","kafarū","disbelieve","অস্বীকার করেছে"],["أَن","an","that","যে"],["يَتَّخِذُوا۟","yattakhidhū","they (can) take","তারা গ্রহণ করবে"],["عِبَادِى","‘ibādī","My servants","আমার দাসদেরকে"],["مِن","min","besides Me","ছাড়া"],["دُونِىٓ","dūnī","besides Me","আমাকে"],["أَوْلِيَآءَ ۚ","awliyāa","(as) protectors","অভিভাবকরূপে"],["إِنَّآ","innā","Indeed, We ","নিশ্চয়ই আমরা"],["أَعْتَدْنَا","a‘tadnā","We have prepared","আমরা প্রস্তুত করে রেখেছি"],["جَهَنَّمَ","jahannama","Hell","জাহান্নামকে"],["لِلْكَـٰفِرِينَ","lil'kāfirīna","for the disbelievers","জন্যে কাফিরদের"],["نُزُلًۭا","nuzulan","(as) a lodging","মেহমানদারী হিসেবে"]],"t":"أَفَحَسِبَ <h>ٱ</>لَّذِينَ كَفَ<o>رُوٓ</><s>ا۟</> <d>أَن يَ</>تَّخِذُو<s>ا۟</> عِبَادِى مِ<k>ن دُ</>و<o>نِىٓ</> أَوْلِ<o>يَآ</>ءَ ۚ إِ<g>نَّ</><o>آ</> أَعْتَ<q>دْ</>نَا جَهَ<g>نَّ</>مَ لِلْ<m>كَٰ</>فِرِينَ نُزُلًۭا"},{"n":103,"w":[["قُلْ","qul","Say","বলো"],["هَلْ","hal","Shall","\"কি"],["نُنَبِّئُكُم","nunabbi-ukum","We inform you","খবর দিবো আমরা তোমাদেরকে"],["بِٱلْأَخْسَرِينَ","bil-akhsarīna","of the greatest losers","সম্বন্ধে খুবই ক্ষতিগ্রস্তদের"],["أَعْمَـٰلًا","a‘mālan","(as to their) deeds","কর্মসমূহে"]],"t":"قُلْ هَلْ نُنَبِّئُ<f>كُم بِ</><h>ٱ</>لْأَخْسَرِينَ أَعْ<m>مَٰ</>لًا"},{"n":104,"w":[["ٱلَّذِينَ","alladhīna","Those ","যাদের"],["ضَلَّ","ḍalla","is lost","পন্ড হয়েছে"],["سَعْيُهُمْ","sa‘yuhum","their effort","তাদের প্রচেষ্টা"],["فِى","fī","in","মধ্যে"],["ٱلْحَيَوٰةِ","l-ḥayati","the life","জীবনের"],["ٱلدُّنْيَا","l-dun'yā","(of) the world","পার্থিব"],["وَهُمْ","wahum","while they","অথচ তারা"],["يَحْسَبُونَ","yaḥsabūna","think","মনে করে"],["أَنَّهُمْ","annahum","th