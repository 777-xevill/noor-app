لَمُ بِمَا لَبِثُو<s>ا۟ ۖ</> لَهُ<m>ۥ</> غَيْبُ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ ۖ أَ<q>بْ</>صِرْ بِ<m>هِۦ</> وَأَسْمِعْ ۚ مَا لَ<y>هُم مِّ</><k>ن دُ</>ونِ<m>هِۦ</> <d>مِن وَلِىٍّۢ وَ</>لَا يُشْرِكُ فِى حُكْمِ<o>هِۦٓ</> أَحَدًۭا"},{"n":27,"w":[["وَٱتْلُ","wa-ut'lu","And recite","এবং আবৃত্তি করো"],["مَآ","mā","what","যা"],["أُوحِىَ","ūḥiya","has been revealed","ওহী করা হয়েছে"],["إِلَيْكَ","ilayka","to you","প্রতি তোমার"],["مِن","min","of","থেকে"],["كِتَابِ","kitābi","the Book","কিতাব"],["رَبِّكَ ۖ","rabbika","(of) your Lord","তোমার রবের"],["لَا","lā","None","নেই"],["مُبَدِّلَ","mubaddila","can change","পরিবর্তনকারী"],["لِكَلِمَـٰتِهِۦ","likalimātihi","His Words","তাঁর কথাগুলোর"],["وَلَن","walan","and never","এবং কখনও না"],["تَجِدَ","tajida","you will find","তুমি পাবে"],["مِن","min","besides Him","ছাড়া"],["دُونِهِۦ","dūnihi","besides Him","তিনি"],["مُلْتَحَدًۭا","mul'taḥadan","a refuge","আশ্রয়স্থান"]],"t":"وَ<h>ٱ</>تْلُ <o>مَآ</> أُوحِىَ إِلَيْكَ مِ<k>ن كِ</>تَابِ رَبِّكَ ۖ لَا مُبَدِّلَ لِكَلِ<m>مَٰتِهِۦ</> وَلَ<k>ن تَ</>جِدَ مِ<k>ن دُ</>ونِ<m>هِۦ</> مُلْتَحَدًۭا"},{"n":28,"w":[["وَٱصْبِرْ","wa-iṣ'bir","And be patient","এবং স্থিতিশীল রাখবে"],["نَفْسَكَ","nafsaka","yourself","তোমার নিজেকে"],["مَعَ","ma‘a","with","সাথে"],["ٱلَّذِينَ","alladhīna","those who","(তাদের) যারা"],["يَدْعُونَ","yad‘ūna","call","ডাকে"],["رَبَّهُم","rabbahum","their Lord","রবকে তাদের"],["بِٱلْغَدَوٰةِ","bil-ghadati","in the morning","বেলায় সকাল"],["وَٱلْعَشِىِّ","wal-‘ashiyi","and the evening","ও সন্ধ্যায়"],["يُرِيدُونَ","yurīdūna","desiring","তারা চায়"],["وَجْهَهُۥ ۖ","wajhahu","His Face","তাঁর সন্তুষ্টি"],["وَلَا","walā","And (let) not","এবং না"],["تَعْدُ","ta‘du","pass beyond","ফিরিয়ে নিও"],["عَيْنَاكَ","‘aynāka","your eyes","তোমার দু'চোখ"],["عَنْهُمْ","‘anhum","over them","থেকে তাদের"],["تُرِيدُ","turīdu","desiring","তুমি চাও"],["زِينَةَ","zīnata","adornment","শোভা"],["ٱلْحَيَوٰةِ","l-ḥayati","(of) the life","জীবনের"],["ٱلدُّنْيَا ۖ","l-dun'yā","(of) the world","পার্থিব"],["وَلَا","walā","and (do) not","এবং না"],["تُطِعْ","tuṭi‘","obey","আনুগত্য করো"],["مَنْ","man","whom","(তার) যার"],["أَغْفَلْنَا","aghfalnā","We have made heedless","আমরা অমনোযোগী করে দিয়েছি"],["قَلْبَهُۥ","qalbahu","his heart","অন্তরকে তার"],["عَن","‘an","of","থেকে"],["ذِكْرِنَا","dhik'rinā","Our remembrance","আমাদের স্মরণ"],["وَٱتَّبَعَ","wa-ittaba‘a","and follows","এবং অনুসরণ করে"],["هَوَىٰهُ","hawāhu","his desires","তাদের খেয়াল-খুশির"],["وَكَانَ","wakāna","and is","এবং হয়েছে"],["أَمْرُهُۥ","amruhu","his affair","তার কাজ"],["فُرُطًۭا","furuṭan","(in) excess","সীমালঙ্ঘনমূলক"]],"t":"وَ<h>ٱ</>صْبِرْ نَفْسَكَ مَعَ <h>ٱ</>لَّذِينَ يَ<q>دْ</>عُونَ رَبَّ<f>هُم بِ</><h>ٱ</>لْغَدَ<s>وٰ</>ةِ وَ<h>ٱ</>لْعَشِىِّ يُرِيدُونَ وَ<q>جْ</>هَهُ<m>ۥ</> ۖ وَلَا تَعْدُ عَيْنَاكَ عَنْهُمْ تُرِيدُ زِينَةَ <h>ٱ</>لْحَيَ<s>وٰ</>ةِ <h>ٱ</><l>ل</>دُّنْيَا ۖ وَلَا تُطِعْ مَنْ أَغْفَلْنَا قَلْبَهُ<m>ۥ</> عَ<k>ن ذِ</>كْرِنَا وَ<h>ٱ</>تَّبَعَ هَوَ<m>ىٰ</>هُ وَكَانَ أَمْرُهُ<m>ۥ</> فُرُطًۭا"},{"n":29,"w":[["وَقُلِ","waquli","And say","এবং বলো"],["ٱلْحَقُّ","l-ḥaqu","The truth","\"(এসেছে) সত্য"],["مِن","min","(is) from","পক্ষ হ'তে"],["رَّبِّكُمْ ۖ","rabbikum","your Lord","রবের তোমার"],["فَمَن","faman","so whoever","অতএব যে"],["شَآءَ","shāa","wills ","ইচ্ছে করে"],["فَلْيُؤْمِن","falyu'min","let him believe","অতঃপর ঈমান আনুক"],["وَمَن","waman","and whoever","এবং যে"],["شَآءَ","shāa","wills ","ইচ্ছে করে"],["فَلْيَكْفُرْ ۚ","falyakfur","let him disbelieve","অতঃপর অস্বীকার করুক\""],["إِنَّآ","innā","Indeed, We","নিশ্চয়ই আমরা"],["أَعْتَدْنَا","a‘tadnā","have prepared","আমরা প্রস্তুত করে রেখেছি"],["لِلظَّـٰلِمِينَ","lilẓẓālimīna","for the wrongdoers","জন্যে সীমালঙ্ঘনকারীদের"],["نَارًا","nāran","a Fire","জাহান্নামের আগুন"],["أَحَاطَ","aḥāṭa","will surround","পরিবেষ্টন করেছে"],["بِهِمْ","bihim","them","সহ তাদেরকে"],["سُرَادِقُهَا ۚ","surādiquhā","its walls","তার শিখা"],["وَإِن","wa-in","And if","এবং যদি"],["يَسْتَغِيثُوا۟","yastaghīthū","they call for relief","তারা পান করতে চায়"],["يُغَاثُوا۟","yughāthū","they will be relieved","তাদের পানি দেয়া হবে"],["بِمَآءٍۢ","bimāin","with water","এমন পানি"],["كَٱلْمُهْلِ","kal-muh'li","like molten brass","মতো তেলের গাদের"],["يَشْوِى","yashwī","(which) scalds","ঝলসে দিবে"],["ٱلْوُجُوهَ ۚ","l-wujūha","the faces","মুখসমূহকে"],["بِئْسَ","bi'sa","Wretched","কত নিকৃষ্ট"],["ٱلشَّرَابُ","l-sharābu","(is) the drink","পানীয়"],["وَسَآءَتْ","wasāat","and evil","এবং অতিশয় খারাপ"],["مُرْتَفَقًا","mur'tafaqan","(is) the resting place","আশ্রয়স্থল"]],"t":"وَقُلِ <h>ٱ</>لْحَقُّ <w>مِن رَّ</>بِّكُمْ ۖ فَمَ<k>ن شَ</><o>آ</>ءَ فَلْيُؤْ<d>مِن وَ</>مَ<k>ن شَ</><o>آ</>ءَ فَلْيَكْفُرْ ۚ إِ<g>نَّ</><o>آ</> أَعْتَ<q>دْ</>نَا لِل<m>ظَّٰ</>لِمِينَ نَارًا أَحَاطَ بِهِمْ سُرَادِقُهَا ۚ وَ<d>إِن يَ</>سْتَغِيثُو<s>ا۟</> يُغَاثُو<s>ا۟</> بِ<o>مَآ</><k>ءٍۢ كَ</><h>ٱ</>لْمُهْلِ يَشْوِى <h>ٱ</>لْوُجُوهَ ۚ بِئْسَ <h>ٱ</><l>ل</>شَّرَابُ وَ<o>سَآ</>ءَتْ مُرْتَفَقًا"},{"n":30,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ءَامَنُوا۟","āmanū","believed","ঈমান এনেছে"],["وَعَمِلُوا۟","wa‘amilū","and did","এবং কাজ করেছে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","the good deeds","সৎ"],["إِنَّا","innā","indeed, We","নিশ্চয়ই আমরা"],["لَا","lā","will not let go waste","না"],["نُضِيعُ","nuḍī‘u","will not let go waste","আমরা বিনষ্ট করি"],["أَجْرَ","ajra","(the) reward","পুরস্কার"],["مَنْ","man","(of one) who","যে"],["أَحْسَنَ","aḥsana","does good","ভালো করে"],["عَمَلًا","‘amalan","deeds","কাজ"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ إِ<g>نَّ</>ا لَا نُضِيعُ أَ<q>جْ</>رَ مَنْ أَحْسَنَ عَمَلًا"},{"n":31,"w":[["أُو۟لَـٰٓئِكَ","ulāika","Those","এসব লোক"],["لَهُمْ","lahum","for them","জন্যে রয়েছে তাদের"],["جَنَّـٰتُ","jannātu","(are) Gardens","জান্নাতসমূহ"],["عَدْنٍۢ","‘adnin","of Eden","স্থায়ী"],["تَجْرِى","tajrī","flows","প্রবাহিত হয়"],["مِن","min","from","থেকে"],["تَحْتِهِمُ","taḥtihimu","underneath them","নিচ তার"],["ٱلْأَنْهَـٰرُ","l-anhāru","the rivers","ঝর্নাসমূহ"],["يُحَلَّوْنَ","yuḥallawna","They will be adorned","তাদের অলংকৃত করা হবে"],["فِيهَا","fīhā","therein","মধ্যে তার"],["مِنْ","min","[of] (with)","দিয়ে"],["أَسَاوِرَ","asāwira","bracelets","কঙ্কণ"],["مِن","min","of","তৈরী"],["ذَهَبٍۢ","dhahabin","gold","সোনার"],["وَيَلْبَسُونَ","wayalbasūna","and will wear","এবং তাদের পরানো হবে"],["ثِيَابًا","thiyāban","garments","পোষাক"],["خُضْرًۭا","khuḍ'ran","green","সবুজ"],["مِّن","min","of","তৈরি"],["سُندُسٍۢ","sundusin","fine silk","মিহি রেশমের"],["وَإِسْتَبْرَقٍۢ","wa-is'tabraqin","and heavy brocade","ও মোটা রেশমের"],["مُّتَّكِـِٔينَ","muttakiīna","reclining","হেলান দিয়ে বসবে"],["فِيهَا","fīhā","therein","মধ্যে তার"],["عَلَى","‘alā","on","উপর"],["ٱلْأَرَآئِكِ ۚ","l-arāiki","adorned couches","উঁচু আসনের"],["نِعْمَ","ni‘'ma","Excellent","কত সুন্দর"],["ٱلثَّوَابُ","l-thawābu","(is) the reward","প্রতিদান"],["وَحَسُنَتْ","waḥasunat","and good","এবং অতি উত্তম"],["مُرْتَفَقًۭا","mur'tafaqan","(is) the resting place","আশ্রয়স্থল"]],"t":"أُ<s>و۟</><o>لَٰٓ</>ئِكَ لَهُمْ جَ<g>نَّٰ</>تُ عَ<q>دْ</><k>نٍۢ تَ</><q>جْ</>رِى مِ<k>ن تَ</>حْتِهِمُ <h>ٱ</>لْأَنْ<m>هَٰ</>رُ يُحَلَّوْنَ فِيهَا مِنْ أَسَاوِرَ مِ<k>ن ذَ</>هَ<d>بٍۢ وَ</>يَلْبَسُونَ ثِيَابًا خُضْ<d>رًۭا مِّ</><k>ن سُندُ</><d>سٍۢ وَ</>إِسْتَ<q>بْ</>رَ<d>قٍۢ مُّ</>تَّكِـِٔينَ فِيهَا عَلَى <h>ٱ</>لْأَ<o>رَآ</>ئِكِ ۚ نِعْمَ <h>ٱ</><l>ل</>ثَّوَابُ وَحَسُنَتْ مُرْتَفَقًۭا"},{"n":32,"w":[["۞ وَٱضْرِبْ","wa-iḍ'rib","And set forth","এবং পেশ করো"],["لَهُم","lahum","to them","জন্যে তাদের"],["مَّثَلًۭا","mathalan","the example","একটি দৃষ্টান্ত"],["رَّجُلَيْنِ","rajulayni","of two men:","দু'ব্যক্তির"],["جَعَلْنَا","ja‘alnā","We provided","আমরা দিয়েছিলাম"],["لِأَحَدِهِمَا","li-aḥadihimā","for one of them","দু'জনের একজনকে তাদের"],["جَنَّتَيْنِ","jannatayni","two gardens","দু'বাগান"],["مِنْ","min","of","থেকে"],["أَعْنَـٰبٍۢ","a‘nābin","grapes","আঙ্গুরসমূহের"],["وَحَفَفْنَـٰهُمَا","waḥafafnāhumā","and We bordered them","এবং দু'টিকে আমরা ঘিরে দিয়েছিলাম"],["بِنَخْلٍۢ","binakhlin","with date-palms","দিয়ে খেজুর গা