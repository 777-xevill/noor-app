{"n":35,"a":[{"n":1,"w":[["ٱلْحَمْدُ","al-ḥamdu","All praises","সকল প্রশংসা"],["لِلَّهِ","lillahi","(be) to Allah","আল্লাহরই জন্যে"],["فَاطِرِ","fāṭiri","Originator","(যিনি) স্রষ্টা"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশের"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীর"],["جَاعِلِ","jā‘ili","(Who) makes","(তিনিই) নিয়োগকারী"],["ٱلْمَلَـٰٓئِكَةِ","l-malāikati","the Angels","ফেরেশতাদেরকে"],["رُسُلًا","rusulan","messengers","বাণীবাহক রূপে"],["أُو۟لِىٓ","ulī","having wings","বিশিষ্ট"],["أَجْنِحَةٍۢ","ajniḥatin","having wings","(বহু) ডানা"],["مَّثْنَىٰ","mathnā","two","দু'টি"],["وَثُلَـٰثَ","wathulātha","or three","ও তিনটি"],["وَرُبَـٰعَ ۚ","warubā‘a","or four","ও চারটি (করে)"],["يَزِيدُ","yazīdu","He increases","বৃদ্ধি করেন"],["فِى","fī","in","মধ্যে"],["ٱلْخَلْقِ","l-khalqi","the creation","সৃষ্টি (কাঠামোর)"],["مَا","mā","what","যেমন"],["يَشَآءُ ۚ","yashāu","He wills","ইচ্ছে করেন তিনি"],["إِنَّ","inna","Indeed","নিশ্চয়"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["عَلَىٰ","‘alā","(is) on","উপর"],["كُلِّ","kulli","every","সব"],["شَىْءٍۢ","shayin","thing","কিছুরই"],["قَدِيرٌۭ","qadīrun","All-Powerful","সর্বশক্তিমান"]],"t":"ٱلْحَمْدُ لِلَّهِ فَاطِرِ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ جَاعِلِ <h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةِ رُسُلًا أُ<s>و۟</><o>لِىٓ</> أَ<q>جْ</>نِحَ<d>ةٍۢ مَّ</>ثْنَىٰ وَثُ<m>لَٰ</>ثَ وَرُ<m>بَٰ</>عَ ۚ يَزِيدُ فِى <h>ٱ</>لْخَلْقِ مَا يَ<o>شَآ</>ءُ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ عَلَىٰ كُلِّ <k>شَىْءٍۢ قَ</><p>دِي</>رٌۭ"},{"n":2,"w":[["مَّا","mā","What","যা কিছু"],["يَفْتَحِ","yaftaḥi","Allah grants","খুলে দেন"],["ٱللَّهُ","l-lahu","Allah grants","আল্লাহ"],["لِلنَّاسِ","lilnnāsi","to mankind","মানুষের জন্যে"],["مِن","min","of","হ'তে"],["رَّحْمَةٍۢ","raḥmatin","Mercy","(তাঁর) অনুগ্রহ"],["فَلَا","falā","then none","সে ক্ষেত্রে নেই"],["مُمْسِكَ","mum'sika","(can) withhold","কোনো প্রতিরোধকারী"],["لَهَا ۖ","lahā","it","তার"],["وَمَا","wamā","And what","এবং যা কিছু"],["يُمْسِكْ","yum'sik","He withholds","তিনি বন্ধ করেন"],["فَلَا","falā","then none","তখনও নেই"],["مُرْسِلَ","mur'sila","(can) release","কোনো উন্মুক্তকারী (প্রেরণকারী)"],["لَهُۥ","lahu","it","তার"],["مِنۢ","min","thereafter","মধ্য হতে"],["بَعْدِهِۦ ۚ","ba‘dihi","thereafter","তাঁর পরে"],["وَهُوَ","wahuwa","And He","এবং তিনিই"],["ٱلْعَزِيزُ","l-‘azīzu","(is) the All-Mighty","পরাক্রমশালী"],["ٱلْحَكِيمُ","l-ḥakīmu","the All-Wise","প্রজ্ঞাময়"]],"t":"مَّا يَفْتَحِ <h>ٱ</>للَّهُ لِل<g>نَّ</>اسِ <w>مِن رَّ</>حْمَ<k>ةٍۢ فَ</>لَا مُمْسِكَ لَهَا ۖ وَمَا يُمْسِكْ فَلَا مُرْسِلَ لَهُ<m>ۥ</> <i>مِنۢ بَ</>عْدِهِۦ<m> ۚ</> وَهُوَ <h>ٱ</>لْعَزِيزُ <h>ٱ</>لْحَ<p>كِي</>مُ"},{"n":3,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O","হে"],["ٱلنَّاسُ","l-nāsu","mankind","মানব সম্প্রদায়"],["ٱذْكُرُوا۟","udh'kurū","Remember","তোমরা স্মরণ করো"],["نِعْمَتَ","ni‘'mata","(the) Favor","অনুগ্রহের (কথা)"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["عَلَيْكُمْ ۚ","‘alaykum","upon you","তোমাদের উপর"],["هَلْ","hal","Is","(আছে) কি"],["مِنْ","min","(there) any","কোন"],["خَـٰلِقٍ","khāliqin","creator","সৃষ্টিকর্তা"],["غَيْرُ","ghayru","other (than) Allah","ব্যতীত"],["ٱللَّهِ","l-lahi","other (than) Allah","আল্লাহ"],["يَرْزُقُكُم","yarzuqukum","who provides for you","তোমাদের জীবিকা দেয় (যে)"],["مِّنَ","mina","from","হ'তে"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশ"],["وَٱلْأَرْضِ ۚ","wal-arḍi","and the earth","ও পৃথিবী (হ'তে)"],["لَآ","lā","(There is) no","নেই"],["إِلَـٰهَ","ilāha","god","কোন ইলাহ"],["إِلَّا","illā","but","ছাড়া"],["هُوَ ۖ","huwa","He","তিনি"],["فَأَنَّىٰ","fa-annā","Then, how","তা হ'লে কেমন করে"],["تُؤْفَكُونَ","tu'fakūna","(are) you deluded","তোমাদের ফিরানো হচ্ছে"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</><l>ل</><g>نَّ</>اسُ <h>ٱ</>ذْكُرُو<s>ا۟</> نِعْمَتَ <h>ٱ</>للَّهِ عَلَيْكُمْ ۚ هَلْ مِنْ <m>خَٰ</>لِقٍ غَيْرُ <h>ٱ</>للَّهِ يَرْزُقُ<y>كُم مِّ</>نَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ وَ<h>ٱ</>لْأَرْضِ ۚ <o>لَآ</> إِ<m>لَٰ</>هَ إِلَّا هُوَ ۖ فَأَ<g>نَّ</>ىٰ تُؤْفَ<p>كُو</>نَ"},{"n":4,"w":[["وَإِن","wa-in","And if","এবং (হে নাবী) যদি"],["يُكَذِّبُوكَ","yukadhibūka","they deny you","তোমাকে তারা মিথ্যারোপ করে"],["فَقَدْ","faqad","then certainly","নিশ্চয়ই তবে"],["كُذِّبَتْ","kudhibat","were denied","মিথ্যারোপ করা হয়েছে"],["رُسُلٌۭ","rusulun","Messengers","রাসূলদেরকে"],["مِّن","min","before you","থেকে"],["قَبْلِكَ ۚ","qablika","before you","তোমার পূর্বেও"],["وَإِلَى","wa-ilā","And to","এবং দিকে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহরই"],["تُرْجَعُ","tur'ja‘u","return","ফিরিয়ে আনা হয়"],["ٱلْأُمُورُ","l-umūru","the matters","(সব) বিষয়"]],"t":"وَ<d>إِن يُ</>كَذِّبُوكَ فَقَ<q>دْ</> كُذِّبَتْ رُسُ<d>لٌۭ مِّ</><k>ن قَ</><q>بْ</>لِكَ ۚ وَإِلَى <h>ٱ</>للَّهِ تُرْجَعُ <h>ٱ</>لْأُ<p>مُو</>رُ"},{"n":5,"w":[["يَـٰٓأَيُّهَا","yāayyuhā","O","হে"],["ٱلنَّاسُ","l-nāsu","mankind","মানব সম্প্রদায়"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["وَعْدَ","wa‘da","(the) promise","প্রতিশ্রুতি"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["حَقٌّۭ ۖ","ḥaqqun","(is) true","সত্য"],["فَلَا","falā","So (let) not","সুতরাং না"],["تَغُرَّنَّكُمُ","taghurrannakumu","deceive you","তোমাদেরকে ধোঁকা দেয় (যেন)"],["ٱلْحَيَوٰةُ","l-ḥayatu","the life","জীবন"],["ٱلدُّنْيَا ۖ","l-dun'yā","(of) the world","পার্থিব"],["وَلَا","walā","and (let) not","এবং না"],["يَغُرَّنَّكُم","yaghurrannakum","deceive you","তোমাদের ধোঁকা দেয় (যেন)"],["بِٱللَّهِ","bil-lahi","about Allah","আল্লাহর ব্যাপারে"],["ٱلْغَرُورُ","l-gharūru","the Deceiver","কোনো বড় ধোঁকাবাজ (অর্থাৎ শয়তান)"]],"t":"<o>يَٰٓ</>أَيُّهَا <h>ٱ</><l>ل</><g>نَّ</>اسُ إِ<g>نَّ</> وَعْدَ <h>ٱ</>للَّهِ حَ<k>قٌّۭ ۖ فَ</>لَا تَغُرَّ<g>نَّ</>كُمُ <h>ٱ</>لْحَيَ<s>وٰ</>ةُ <h>ٱ</><l>ل</>دُّنْيَا ۖ وَلَا يَغُرَّ<g>نَّ</><f>كُم بِ</><h>ٱ</>للَّهِ <h>ٱ</>لْغَ<p>رُو</>رُ"},{"n":6,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلشَّيْطَـٰنَ","l-shayṭāna","the Shaitaan","শয়তান"],["لَكُمْ","lakum","(is) to you","তোমাদের জন্যে"],["عَدُوٌّۭ","‘aduwwun","an enemy","শত্রু"],["فَٱتَّخِذُوهُ","fa-ittakhidhūhu","so take him","সুতরাং তোমরা তাকে  গ্রহণ করো"],["عَدُوًّا ۚ","‘aduwwan","(as) an enemy","শত্রু হিসেবে"],["إِنَّمَا","innamā","Only","মূলতঃ"],["يَدْعُوا۟","yad‘ū","he invites","সে ডাকে"],["حِزْبَهُۥ","ḥiz'bahu","his party","তার দলবলকে"],["لِيَكُونُوا۟","liyakūnū","that they may be","তারা হয় যেন"],["مِنْ","min","among","অন্তর্ভুক্ত"],["أَصْحَـٰبِ","aṣḥābi","(the) companions","অধিবাসীদের"],["ٱلسَّعِيرِ","l-sa‘īri","(of) the Blaze","জাহান্নামের"]],"t":"إِ<g>نَّ</> <h>ٱ</><l>ل</>شَّيْ<m>طَٰ</>نَ لَكُمْ عَدُ<k>وٌّۭ فَ</><h>ٱ</>تَّخِذُوهُ عَدُوًّا ۚ إِ<g>نَّ</>مَا يَ<q>دْ</>عُو<s>ا۟</> حِزْبَهُ<m>ۥ</> لِيَكُونُو<s>ا۟</> مِنْ أَصْ<m>حَٰ</>بِ <h>ٱ</><l>ل</>سَّ<p>عِي</>رِ"},{"n":7,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["كَفَرُوا۟","kafarū","disbelieve","অস্বীকার করেছে"],["لَهُمْ","lahum","for them","তাদের জন্যে (রয়েছে)"],["عَذَابٌۭ","‘adhābun","(will be) a punishment","শাস্তি"],["شَدِيدٌۭ ۖ","shadīdun","severe","কঠোর"],["وَٱلَّذِينَ","wa-alladhīna","and those","আর যারা"],["ءَامَنُوا۟","āmanū","who believe","ঈমান এনেছে"],["وَعَمِلُوا۟","wa‘amilū","and do","ও কাজ করেছে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","righteous deeds","সৎকাজ"],["لَهُم","lahum","for them","তাদের জন্যে (রয়েছে)"],["مَّغْفِرَةٌۭ","maghfiratun","(will be) forgiveness","ক্ষমা"],["وَأَجْرٌۭ","wa-ajrun","and a reward","ও পুরস্কার"],["كَبِيرٌ","kabīrun","great","বড়"]],"t":"ٱلَّذِينَ كَفَرُو<s>ا۟</> لَهُمْ عَذَا<k>بٌۭ شَ</>دِي<d>دٌۭ ۖ وَ</><h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَعَمِلُو<s>ا۟</> <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ لَ<y>هُم مَّ</>غْفِرَ<d>ةٌۭ وَ</>أَ<q>جْ</><k>رٌۭ كَ</><p>بِي</>رٌ"},{"n":8,"w":[["أَفَمَن","afaman","Then is (he) who ","তবে কি যে"],["زُيِّنَ","zuyyina","is made fair-seeming","শোভন করে দেখানো হয়েছে"],["لَهُۥ","lahu","to him","তার কাছে"],["سُوٓءُ","sūu","(the) evil","মন্দ"],["عَمَلِهِۦ","‘amalihi","(of) his deed ","তার কাজকে"],["فَرَءَاهُ","faraāhu","so that he sees it","তা অতঃপর সে মনে করে"],["حَسَنًۭا ۖ","ḥasanan","(as) good","উত্তম হিসেবে (সে কি হেদায়াত পাবে?)"],["فَإِنَّ","fa-inna","For indeed","প্রকৃত পক্ষে নিশ্চয়"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يُضِلُّ","yuḍillu","lets go astray","বিভ্রান্ত করেন"],["مَن","man","whom","যাকে"],["يَشَآءُ","yashāu","He wills","ইচ্ছে করেন তিনি"],["وَيَهْدِى","wayahdī","and guides","এবং সৎ পথে পরিচালিত করেন"],["مَن","man","whom","যাকে"],["يَشَآءُ ۖ","yashāu","He wills","তিনি ইচ্ছে করেন"],["فَلَا","falā","So (let) not","সুতরাং না"],["تَذْهَبْ","tadhhab","go out","চলে যায় (অর্থাৎ শেষ করে দিও)"],["نَفْسُكَ","nafsuka","your soul","তোমার প্রাণ"],["عَلَيْهِمْ","‘alayhim","for them","তাদের জন্যে"],["حَسَرَٰتٍ ۚ","ḥasarātin","(in) regrets","আক্ষেপ করে"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["عَلِيمٌۢ","‘alīmun","(is) All-Knower","খুব অবহিত"],["بِمَا","bimā","of what","ঐ বিষয়ে যা"],["يَصْنَعُونَ","yaṣna‘ūna","they do","তারা তৈরি করছে"]],"t":"أَفَمَ<k>ن زُ</>يِّنَ لَهُ<m>ۥ</> <o>سُوٓ</>ءُ عَمَلِ<m>هِۦ</> فَرَءَاهُ حَسَ<k>نًۭا ۖ فَ</>إِ<g>نَّ</> <h>ٱ</>للَّهَ يُضِلُّ <d>مَن يَ</><o>شَآ</>ءُ وَيَهْدِى <d>مَن يَ</><o>شَآ</>ءُ ۖ فَلَا تَذْهَ<q>بْ</> نَفْسُكَ عَلَيْهِمْ حَسَ<m>رَٰ</>تٍ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ عَلِي<i>مٌۢ بِ</>مَا يَصْنَ<p>عُو</>نَ"},{"n":9,"w":[["وَٱللَّهُ","wal-lahu","And Allah","এবং আল্লাহ (তিনিই)"],["ٱلَّذِىٓ","alladhī","(is) the One Who","যিনি"],["أَرْسَلَ","arsala","sends","পাঠান"],["ٱلرِّيَـٰحَ","l-riyāḥa","the winds","বাতাস"],["فَتُثِيرُ","fatuthīru","so that they raise","অতঃপর (তা) সঞ্চালন"],["سَحَابًۭا","saḥāban","(the) clouds","মেঘমালা"],["فَسُقْنَـٰهُ","fasuq'nāhu","and We drive them","তা আমরা অতঃপর পরিচালনা করি"],["إِلَىٰ","ilā","to","দিকে"],["بَلَدٍۢ","baladin","a land","ভূখণ্ডের"],["مَّيِّتٍۢ","mayyitin","dead","(যা ছিলো) নির্জীব মৃত"],["فَأَحْيَيْنَا","fa-aḥyaynā","and We revive","আমরা এভাবে জীবিত করি"],["بِهِ","bihi","therewith","তা দ্বারা"],["ٱلْأَرْضَ","l-arḍa","the earth","মাটিকে"],["بَعْدَ","ba‘da","after","পরে"],["مَوْتِهَا ۚ","mawtihā","its death","তার মৃত্যুর"],["كَذَٰلِكَ","kadhālika","Thus","এভাবেই (হবে)"],["ٱلنُّشُورُ","l-nushūru","(will be) the Resurrection","উত্থান"]],"t":"وَ<h>ٱ</>للَّهُ <h>ٱ</>لَّ<o>ذِىٓ</> أَرْسَلَ <h>ٱ</><l>ل</>رِّ<m>يَٰ</>حَ فَتُثِيرُ سَحَا<k>بًۭا 