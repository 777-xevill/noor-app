d if","এবং যদি"],["تَدْعُ","tad‘u","calls","ডাকে"],["مُثْقَلَةٌ","muth'qalatun","a heavily laden","কোনো বোঝাভারাক্রান্ত ব্যক্তি"],["إِلَىٰ","ilā","to","দিকে"],["حِمْلِهَا","ḥim'lihā","(carry) its load","তার বোঝার (তা বইতে)"],["لَا","lā","not","না"],["يُحْمَلْ","yuḥ'mal","will be carried","বহন করা হবে"],["مِنْهُ","min'hu","of it","তার থেকে"],["شَىْءٌۭ","shayon","anything","(সামান্য) কিছুও"],["وَلَوْ","walaw","even if","এবং যদি"],["كَانَ","kāna","he be","সে হয়ও"],["ذَا","dhā","near of kin","আছে"],["قُرْبَىٰٓ ۗ","qur'bā","near of kin","কোন নিকট আত্মীয়"],["إِنَّمَا","innamā","Only","(তাই হে নাবী) কেবল"],["تُنذِرُ","tundhiru","you can warn","তুমি সতর্ক করো"],["ٱلَّذِينَ","alladhīna","those who","(তাদেরকে) যারা"],["يَخْشَوْنَ","yakhshawna","fear","ভয় করে"],["رَبَّهُم","rabbahum","their Lord ","তাদের রবকে"],["بِٱلْغَيْبِ","bil-ghaybi","unseen","না দেখা অবস্থায়"],["وَأَقَامُوا۟","wa-aqāmū","and establish","এবং প্রতিষ্ঠা করে"],["ٱلصَّلَوٰةَ ۚ","l-ṣalata","the prayer","সালাত"],["وَمَن","waman","And whoever","এবং যে"],["تَزَكَّىٰ","tazakkā","purifies himself","পবিত্র করে"],["فَإِنَّمَا","fa-innamā","then only","প্রকৃতপক্ষে"],["يَتَزَكَّىٰ","yatazakkā","he purifies","সে পবিত্র করে"],["لِنَفْسِهِۦ ۚ","linafsihi","for his own self","তার নিজের জন্যে"],["وَإِلَى","wa-ilā","And to","এবং দিকে"],["ٱللَّهِ","l-lahi","Allah","আল্লাহর-ই"],["ٱلْمَصِيرُ","l-maṣīru","(is) the destination","(তোমাদের হবে) প্রত্যাবর্তন"]],"t":"وَلَا تَزِرُ وَازِرَ<d>ةٌۭ وِ</>زْرَ أُخْرَىٰ ۚ وَإِ<k>ن تَ</><q>دْ</>عُ مُثْقَلَةٌ إِلَىٰ حِمْلِهَا لَا يُحْمَلْ مِنْهُ <d>شَىْءٌۭ وَ</>لَوْ كَانَ ذَا قُرْبَ<o>ىٰٓ ۗ</> إِ<g>نَّ</>مَا تُ<k>نذِ</>رُ <h>ٱ</>لَّذِينَ يَخْشَوْنَ رَبَّ<f>هُم بِ</><h>ٱ</>لْغَيْبِ وَأَقَامُو<s>ا۟</> <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةَ ۚ وَمَ<k>ن تَ</>زَكَّىٰ فَإِ<g>نَّ</>مَا يَتَزَكَّىٰ لِنَفْسِهِۦ<m> ۚ</> وَإِلَى <h>ٱ</>للَّهِ <h>ٱ</>لْمَ<p>صِي</>رُ"},{"n":19,"w":[["وَمَا","wamā","And not","এবং না"],["يَسْتَوِى","yastawī","equal","সমান হয়"],["ٱلْأَعْمَىٰ","l-a‘mā","(are) the blind","অন্ধ"],["وَٱلْبَصِيرُ","wal-baṣīru","and the seeing","ও চক্ষুষ্মান"]],"t":"وَمَا يَسْتَوِى <h>ٱ</>لْأَعْمَىٰ وَ<h>ٱ</>لْبَ<p>صِي</>رُ"},{"n":20,"w":[["وَلَا","walā","And not","এবং না"],["ٱلظُّلُمَـٰتُ","l-ẓulumātu","the darkness[es]","অন্ধকারসমূহ"],["وَلَا","walā","and not","আর না"],["ٱلنُّورُ","l-nūru","[the] light","আলো"]],"t":"وَلَا <h>ٱ</><l>ل</>ظُّلُ<m>مَٰ</>تُ وَلَا <h>ٱ</><l>ل</><g>نُّ</><p>و</>رُ"},{"n":21,"w":[["وَلَا","walā","And not","এবং না"],["ٱلظِّلُّ","l-ẓilu","the shade","ছায়া"],["وَلَا","walā","and not","আর না"],["ٱلْحَرُورُ","l-ḥarūru","the heat","রৌদ্র"]],"t":"وَلَا <h>ٱ</><l>ل</>ظِّلُّ وَلَا <h>ٱ</>لْحَ<p>رُو</>رُ"},{"n":22,"w":[["وَمَا","wamā","And not","এবং না"],["يَسْتَوِى","yastawī","equal","সমান হয়"],["ٱلْأَحْيَآءُ","l-aḥyāu","(are) the living","জীবিত"],["وَلَا","walā","and not","আর না"],["ٱلْأَمْوَٰتُ ۚ","l-amwātu","the dead","মৃত"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يُسْمِعُ","yus'mi‘u","causes to hear","শুনান"],["مَن","man","whom","যাকে"],["يَشَآءُ ۖ","yashāu","He wills","ইচ্ছে করেন তিনি"],["وَمَآ","wamā","and not","আর না"],["أَنتَ","anta","you","তুমি"],["بِمُسْمِعٍۢ","bimus'mi‘in","can make hear","শুনাতে সমর্থ"],["مَّن","man","(those) who","যে (আছে)"],["فِى","fī","(are) in","মধ্যে"],["ٱلْقُبُورِ","l-qubūri","the graves","কবরগুলোর"]],"t":"وَمَا يَسْتَوِى <h>ٱ</>لْأَحْ<o>يَآ</>ءُ وَلَا <h>ٱ</>لْأَمْ<m>وَٰ</>تُ ۚ إِ<g>نَّ</> <h>ٱ</>للَّهَ يُسْمِعُ <d>مَن يَ</><o>شَآ</>ءُ ۖ وَ<o>مَآ</> أَ<k>نتَ</> بِمُسْمِ<d>عٍۢ مَّ</><k>ن فِ</>ى <h>ٱ</>لْقُ<p>بُو</>رِ"},{"n":23,"w":[["إِنْ","in","Not","নও"],["أَنتَ","anta","you (are)","তুমি"],["إِلَّا","illā","but","এ ছাড়া"],["نَذِيرٌ","nadhīrun","a warner","একজন সতর্ককারী"]],"t":"إِنْ أَ<k>نتَ</> إِلَّا نَ<p>ذِي</>رٌ"},{"n":24,"w":[["إِنَّآ","innā","Indeed, We","নিশ্চযই় আমরা"],["أَرْسَلْنَـٰكَ","arsalnāka","[We] have sent you","তোমাকে আমরা পাঠিয়েছি"],["بِٱلْحَقِّ","bil-ḥaqi","with the truth","সত্যসহ"],["بَشِيرًۭا","bashīran","(as) a bearer of glad tidings","সুসংবাদদাতা রূপে"],["وَنَذِيرًۭا ۚ","wanadhīran","and (as) a warner","ও সতর্ককারী হিসেবে"],["وَإِن","wa-in","And not","এবং নেই"],["مِّنْ","min","(was) any","কোনো"],["أُمَّةٍ","ummatin","nation","(এমন) জাতি"],["إِلَّا","illā","but","এ ছাড়া যে"],["خَلَا","khalā","had passed","অতিক্রম করেছে"],["فِيهَا","fīhā","within it","তার মধ্যে"],["نَذِيرٌۭ","nadhīrun","a warner","কোনো সতর্ককারী"]],"t":"إِ<g>نَّ</><o>آ</> أَرْسَلْ<m>نَٰ</>كَ بِ<h>ٱ</>لْحَقِّ بَشِي<d>رًۭا وَ</>نَذِي<d>رًۭا ۚ وَإِن مِّ</>نْ أُ<g>مَّ</>ةٍ إِلَّا خَلَا فِيهَا نَ<p>ذِي</>رٌۭ"},{"n":25,"w":[["وَإِن","wa-in","And if","এবং যদি"],["يُكَذِّبُوكَ","yukadhibūka","they deny you","তোমাকে তারা মিথ্যারোপ করে"],["فَقَدْ","faqad","then certainly","তবে (নতুন কিছু নয়)"],["كَذَّبَ","kadhaba","denied","মিথ্যারোপ করেছে"],["ٱلَّذِينَ","alladhīna","those who","যারা (ছিলো)"],["مِن","min","(were) before them","পূর্বেও"],["قَبْلِهِمْ","qablihim","(were) before them","তাদের"],["جَآءَتْهُمْ","jāathum","Came to them","তাদের কাছে এসেছিলো"],["رُسُلُهُم","rusuluhum","their Messengers","তাদের রাসূলগণ"],["بِٱلْبَيِّنَـٰتِ","bil-bayināti","with clear signs","স্পষ্ট নিদর্শনসহ"],["وَبِٱلزُّبُرِ","wabil-zuburi","and with Scriptures","এবং ছোট ছোট সহীফাসহ"],["وَبِٱلْكِتَـٰبِ","wabil-kitābi","and with the Book","ও কিতাবসহ"],["ٱلْمُنِيرِ","l-munīri","[the] enlightening","দীপ্তিময়"]],"t":"وَ<d>إِن يُ</>كَذِّبُوكَ فَقَ<q>دْ</> كَذَّبَ <h>ٱ</>لَّذِينَ مِ<k>ن قَ</><q>بْ</>لِهِمْ <o>جَآ</>ءَتْهُمْ رُسُلُ<f>هُم بِ</><h>ٱ</>لْبَيِّ<m>نَٰ</>تِ وَبِ<h>ٱ</><l>ل</>زُّبُرِ وَبِ<h>ٱ</>لْكِ<m>تَٰ</>بِ <h>ٱ</>لْمُ<p>نِي</>رِ"},{"n":26,"w":[["ثُمَّ","thumma","Then","এরপর"],["أَخَذْتُ","akhadhtu","I seized","আমি পাকড়াও করেছি"],["ٱلَّذِينَ","alladhīna","those who","তাদেরকে (যারা)"],["كَفَرُوا۟ ۖ","kafarū","disbelieved","অস্বীকার করেছে"],["فَكَيْفَ","fakayfa","and how","অতঃপর কেমন (দেখো)"],["كَانَ","kāna","was","ছিলো"],["نَكِيرِ","nakīri","My rejection","আমার শাস্তি"]],"t":"ثُ<g>مَّ</> أَخَذْتُ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟ ۖ</> فَكَيْفَ كَانَ نَ<p>كِي</>رِ"},{"n":27,"w":[["أَلَمْ","alam","Do not","তুমি কি"],["تَرَ","tara","you see","দেখো নাই"],["أَنَّ","anna","that","যে"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["أَنزَلَ","anzala","sends down","বর্ষণ করেন"],["مِنَ","mina","from","থেকে"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশ"],["مَآءًۭ","māan","water","পানি"],["فَأَخْرَجْنَا","fa-akhrajnā","then We bring forth","অতঃপর আমরা উৎপন্ন করি"],["بِهِۦ","bihi","therewith","তা দিয়ে"],["ثَمَرَٰتٍۢ","thamarātin","fruits","ফল মূলসমূহ"],["مُّخْتَلِفًا","mukh'talifan","(of) various","বিচিত্র"],["أَلْوَٰنُهَا ۚ","alwānuhā","[their] colors","তার রংসমূহ"],["وَمِنَ","wamina","And in","এবং মধ্যেও"],["ٱلْجِبَالِ","l-jibāli","the mountains","পাহাড়সমূহের"],["جُدَدٌۢ","judadun","(are) tracts","রেখাপথ (রয়েছে)"],["بِيضٌۭ","bīḍun","white","সাদা"],["وَحُمْرٌۭ","waḥum'run","and red","ও লাল"],["مُّخْتَلِفٌ","mukh'talifun","(of) various","বিচিত্র"],["أَلْوَٰنُهَا","alwānuhā","[their] colors","তার রংসমূহ"],["وَغَرَابِيبُ","wagharābību","and intensely black","এবং নিকষ"],["سُودٌۭ","sūdun","and intensely black","কালো (রংও)"]],"t":"أَلَمْ تَرَ أَ<g>نَّ</> <h>ٱ</>للَّهَ أَ<k>نزَ</>لَ مِنَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ <o>مَآ</><k>ءًۭ فَ</>أَخْرَ<q>جْ</>نَا بِ<m>هِۦ</> ثَمَ<m>رَٰ</><d>تٍۢ مُّ</>خْتَلِفًا أَلْ<m>وَٰ</>نُهَا ۚ وَمِنَ <h>ٱ</>لْجِبَالِ جُدَ<i>دٌۢ بِ</>ي<d>ضٌۭ وَ</>حُمْ<d>رٌۭ مُّ</>خْتَلِفٌ أَلْ<m>وَٰ</>نُهَا وَغَرَابِيبُ <p>سُو</><q>دٌۭ</>"},{"n":28,"w":[["وَمِنَ","wamina","And among","এবং মধ্যে"],["ٱلنَّاسِ","l-nāsi","men","মানুষের"],["وَٱلدَّوَآبِّ","wal-dawābi","and moving creatures","ও জীব জন্তুগুলোর"],["وَٱلْأَنْعَـٰمِ","wal-an‘āmi","and the cattle","এবং গৃহপালিত পশুদের (মধ্যেও রয়েছে)"],["مُخْتَلِفٌ","mukh'talifun","(are) various","বিচিত্র"],["أَلْوَٰنُهُۥ","alwānuhu","[their] colors","তার রংসমূহ"],["كَذَٰلِكَ ۗ","kadhālika","likewise","এভাবেই"],["إِنَّمَا","innamā","Only","প্রকৃতপক্ষে"],["يَخْشَى","yakhshā","fear","ভয় করে"],["ٱللَّهَ","l-laha","Allah","আল্লাহকে"],["مِنْ","min","among","মধ্য হ'তে"],["عِبَادِهِ","‘ibādihi","His slaves","তাঁর দাসদের"],["ٱلْعُلَمَـٰٓؤُا۟ ۗ","l-‘ulamāu","those who have knowledge","জ্ঞানীগণই"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["عَزِيزٌ","‘azīzun","(is) All-Mighty","পরাক্রমশালী"],["غَفُورٌ","ghafūrun","Oft-Forgiving","ক্ষমাশীল"]],"t":"وَمِنَ <h>ٱ</><l>ل</><g>نَّ</>اسِ وَ<h>ٱ</><l>ل</>دَّ<n>وَآ</>بِّ وَ<h>ٱ</>لْأَنْ<m>عَٰ</>مِ مُخْتَلِفٌ أَلْ<m>وَٰ</>نُهُ<m>ۥ</> كَ<m>ذَٰ</>لِكَ ۗ إِ<g>نَّ</>مَا يَخْشَى <h>ٱ</>للَّهَ مِنْ عِبَادِهِ <h>ٱ</>لْعُلَ<o>مَٰٓ</>ؤُ<s>ا۟</> ۗ إِ<g>نَّ</> <h>ٱ</>للَّهَ عَزِيزٌ غَ<p>فُو</>رٌ"},{"n":29,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["يَتْلُونَ","yatlūna","recite","পাঠ করে"],["كِتَـٰبَ","kitāba","(the) Book","কিতাব"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["وَأَقَامُوا۟","wa-aqāmū","and establish","এবং প্রতিষ্ঠা  করে"],["ٱلصَّلَوٰةَ","l-ṣalata","the prayer","সালাত"],["وَأَنفَقُوا۟","wa-anfaqū","and spend","ও ব্যয় করে"],["مِمَّا","mimmā","out of what","তা হ'তে যা"],["رَزَقْنَـٰهُمْ","razaqnāhum","We have provided them","তাদেরকে আমরা জীবিকা দিয়েছি"],["سِرًّۭا","sirran","secretly","গোপনে"],["وَعَلَانِيَةًۭ","wa‘alāniyatan","and openly","ও প্রকাশ্যে"],["يَرْجُونَ","yarjūna","hope","তারাই আশা করতে পারে"],["تِجَـٰرَةًۭ","tijāratan","(for) a commerce ","(এমন) ব্যবসার"],["لَّن","lan","never","(যার) কখনও না"],["تَبُورَ","tabūra","it will perish","ব্যর্থ হবে"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ يَتْلُونَ كِ<m>تَٰ</>بَ <h>ٱ</>للَّهِ وَأَقَامُو<s>ا۟</> <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةَ وَأَ<k>نفَ</>قُو<s>ا۟</> مِ<g>مَّ</>ا رَزَ<q>قْ</><m>نَٰ</>هُمْ سِ<d>رًّۭا وَ</>عَلَانِيَ<d>ةًۭ يَ</>رْجُونَ تِ<m>جَٰ</>رَ<w>ةًۭ لَّ</><k>ن تَ</><p>بُو</>رَ"},{"n":30,"w":[["لِيُوَفِّيَهُمْ","liyuwaffiyahum","That He may give them in full","তাদের পূর্ণমাত্রায় (আল্লাহ) দেন যেন"],["أُجُورَهُمْ","ujūrahum","their rewards","তাদের প্রতিফলন"],["وَيَزِيدَهُم","wayazīdahum","and increase for them","এবং তাদের আরো বেশী দেন"],["مِّن","min","of","থেকে"],["فَضْلِهِۦٓ ۚ","faḍlihi","His Bounty","তাঁর অনুগ্রহ"],["إِنَّهُۥ","innahu","Indeed, He","তিনি নিশ্চয়ই"],["غَفُورٌۭ","ghafūrun","(is) Oft-Forgiving","ক্ষমাশীল"],["شَكُورٌۭ","shakūrun","Most Appreciative","গুণগ্রাহী"]],"t":"لِيُوَفِّيَهُمْ أُجُورَهُمْ وَيَزِيدَ<y>هُم مِّ</><k>ن فَ</>ضْلِهِ<o>ۦٓ</> ۚ إِ<g>نَّ</>هُ<m>ۥ</> غَفُو<k>رٌۭ شَ</><p>كُو</>رٌۭ"},{"n":31,"w":[["وَٱلَّذِىٓ","wa-alladhī","And (that) which","এবং(হে নাবী) যা"],["أَوْحَيْنَآ","awḥaynā","We have revealed","আমরা ওহী করেছি"],["إِلَيْكَ","ilayka","to you","তোমার প্রতি"],["مِنَ","mina","of","থেকে"],["ٱلْكِتَـٰبِ","l-kitābi","the Book","কিতাব"],["هُوَ","huwa","it","তাই"],["ٱلْحَقُّ","l-ḥaqu","(is) the truth","সত্য"],["مُصَدِّقًۭا","muṣaddiqan","confirming","(তা) সত্যায়নকারী ও সমর্থক"],["لِّمَا","limā","what (was)","তার যা"],["بَيْنَ","bayna","before it","পূর্বে (এসেছে)"],["يَدَيْهِ ۗ","yadayhi","before it","তার"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["بِعِبَادِهِۦ","bi‘ibādihi","of His slaves","তাঁর দাসদের সম্পর্কে"],["لَخَبِيرٌۢ","lakhabīrun","surely, (is) All-Aware","অবশ্যই সব জানেন"],["بَصِيرٌۭ","baṣīrun","All-Seer","সব দেখেন"]],"t":"وَ<h>ٱ</>لَّ<o>ذِىٓ</> أَوْحَيْ<o>نَآ</> إِلَيْكَ مِنَ <h>ٱ</>لْكِ<m>تَٰ</>بِ هُوَ <h>ٱ</>لْحَقُّ مُصَدِّ<w>قًۭا لِّ</>مَا بَيْنَ يَدَيْهِ ۗ إِ<g>نَّ</> <h>ٱ</>للَّهَ بِعِبَادِ<m>هِۦ</> لَخَبِي<i>رٌۢ بَ</><p>صِي</>رٌۭ"},{"n":32,"w":[["ثُمَّ","thumma","Then","এরপর"],["أَوْرَثْنَا","awrathnā","We caused to inherit","আমরা উত্তরাধিকার বানিয়েছি"],["ٱلْكِتَـٰبَ","l-kitāba","the Book","কিতাবের"],["ٱلَّذِينَ","alladhīna","those whom","( তাদেরকে ) যাদের"],["ٱصْطَفَيْنَا","iṣ'ṭafaynā","We have chosen","আমরা মনোনীত করেছি"],["مِنْ","min","of","মধ্য হ'তে"],["عِبَادِنَا ۖ","‘ibādinā","Our slaves","আমাদের দাসদের"],["فَمِنْهُمْ","famin'hum","and among them","অতঃপর তাদের মধ্যে"],["ظَالِمٌۭ","ẓālimun","(is he) who wrongs","(কেউ হয়েছে) অত্যাচারী"],["لِّنَفْسِهِۦ","linafsihi","himself","তার নিজের প্রতি"],["وَمِنْهُم","wamin'hum","and among them","আবার তাদের মধ্য (রয়েছে)"],["مُّقْتَصِدٌۭ","muq'taṣidun","(is he who is) moderate","(কেউ) মধ্যপন্থী"],["وَمِنْهُمْ","wamin'hum","and among them","আবার তাদের মধ্যে (রয়েছে)"],["سَابِقٌۢ","sābiqun","(is he who is) foremost","(কেউ) অগ্রগামী"],["بِٱلْخَيْرَٰتِ","bil-khayrāti","in good deeds","কল্যাণকর কাজসমূহে"],["بِإِذْنِ","bi-idh'ni","by permission","অনুমতিক্রমে"],["ٱللَّهِ ۚ","l-lahi","(of) Allah","আল্লাহর"],["ذَٰلِكَ","dhālika","That","এটাই"],["هُوَ","huwa","is","সেই"],["ٱلْفَضْلُ","l-faḍlu","the Bounty","অনুগ্রহ"],["ٱلْكَبِيرُ","l-kabīru","the great","মহা"]],"t":"ثُ<g>مَّ</> أَوْرَثْنَا <h>ٱ</>لْكِ<m>تَٰ</>بَ <h>ٱ</>لَّذِينَ <h>ٱ</>صْطَفَيْنَا مِنْ عِبَادِنَا ۖ فَمِنْهُمْ ظَالِ<w>مٌۭ لِّ</>نَفْسِ<m>هِۦ</> وَمِنْ<y>هُم مُّ</><q>قْ</>تَصِ<d>دٌۭ وَ</>مِنْهُمْ سَابِ<i>قٌۢ بِ</><h>ٱ</>لْخَيْ<m>رَٰ</>تِ بِإِذْنِ <h>ٱ</>للَّهِ ۚ <m>ذَٰ</>لِكَ هُوَ <h>ٱ</>لْفَضْلُ <h>ٱ</>لْكَ<p>بِي</>رُ"},{"n":33,"w":[["جَنَّـٰتُ","jannātu","Gardens","বেহেশতসমূহ (রয়েছে)"],["عَدْنٍۢ","‘adnin","(of) Eternity","স্থায়ী"],["يَدْخُلُونَهَا","yadkhulūnahā","they will enter them","তাতে তারা প্রবেশ করবে"],["يُحَلَّوْنَ","yuḥallawna","They will be adorned","অলংকৃত করা হবে(তাদেরকে)"],["فِيهَا","fīhā","therein","তার মধ্যে"],["مِنْ","min","with","দিয়ে"],["أَسَاوِرَ","asāwira","bracelets","বালা"],["مِن","min","of","দ্বারা (নির্মিত)"],["ذَهَبٍۢ","dhahabin","gold","স্বর্ণের"],["وَلُؤْلُؤًۭا ۖ","walu'lu-an","and pearls","ও মনি মুক্তার"],["وَلِبَاسُهُمْ","walibāsuhum","and their garments","এবং তাদের পোশাক (হবে)"],["فِيهَا","fīhā","therein","তার মধ্যে"],["حَرِيرٌۭ","ḥarīrun","(will be of) silk","রেশমের"]],"t":"جَ<g>نَّٰ</>تُ عَ<q>دْ</><d>نٍۢ يَ</><q>دْ</>خُلُونَهَا يُحَلَّوْنَ فِيهَا مِنْ أَسَاوِرَ مِ<k>ن ذَ</>هَ<d>بٍۢ وَ</>لُؤْلُ<d>ؤًۭا ۖ وَ</>لِبَاسُهُمْ فِيهَا حَ<p>رِي</>رٌۭ"},{"n":34,"w":[["وَقَالُوا۟","waqālū","And they (will) say","এবং তারা বলবে"],["ٱلْحَمْدُ","l-ḥamdu","All praises","\"সব প্রশংসা"],["لِلَّهِ","lillahi","(be) to Allah","আল্লাহর-ই জন্য"],["ٱلَّذِىٓ","alladhī","the One Who","যিনি"],["أَذْهَبَ","adhhaba","(has) removed","দূর করেছেন"],["عَنَّا","‘annā","from us","আমাদের থেকে"],["ٱلْحَزَنَ ۖ","l-ḥazana","the sorrow","দুশ্চিন্তা"],["إِنَّ","inna","Indeed","নিশ্চয়ই"],["رَبَّنَا","rabbanā","our Lord","আমাদের রব"],["لَغَفُورٌۭ","laghafūrun","(is) surely Oft-Forgiving","অবশ্যই ক্ষমাশীল"],["شَكُورٌ","shakūrun","Most Appreciative","গুণগ্রাহী"]],"t":"وَقَالُو<s>ا۟</> <h>ٱ</>لْحَمْدُ لِلَّهِ <h>ٱ</>لَّ<o>ذِىٓ</> أَذْهَبَ عَ<g>نَّ</>ا <h>ٱ</>لْحَزَنَ ۖ إِ<g>نَّ</> رَبَّنَا لَغَفُو<k>رٌۭ شَ</><p>كُو</>رٌ"},{"n":35,"w":[["ٱلَّذِىٓ","alladhī","The One Who","যিনি"],["أَحَلَّنَا","aḥallanā","has settled us","আমাদের জন্যে স্হান দিয়েছেন"],["دَارَ","dāra","(in) a Home","আরাম"],["ٱلْمُقَامَةِ","l-muqāmati","(of) Eternity","স্হায়ী"],["مِن","min","(out) of","অনুগ্রহের মাধ্যমে"],["فَضْلِهِۦ","faḍlihi","His Bounty","তাঁর"],["لَا","lā","Not","না"],["يَمَسُّنَا","yamassunā","touches us","আমাদের স্পর্শ করবে"],["فِيهَا","fīhā","therein","তার মধ্যে"],["نَصَبٌۭ","naṣabun","any fatigue","কোনো কষ্ট"],["وَلَا","walā","and not","আর না"],["يَمَسُّنَا","yamassunā","touches","আমাদেরকে স্পর্শ করবে"],["فِيهَا","fīhā","therein","তার মধ্যে"],["لُغُوبٌۭ","lughūbun","weariness","কোনো ক্লান্তি\""]],"t":"ٱلَّ<o>ذِىٓ</> أَحَلَّنَا دَارَ <h>ٱ</>لْمُقَامَةِ مِ<k>ن فَ</>ضْلِ<m>هِۦ</> لَا يَمَسُّنَا فِيهَا نَصَ<d>بٌۭ وَ</>لَا يَمَسُّنَا فِيهَا لُ<p>غُو</><q>بٌۭ</>"},{"n":36,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["كَفَرُوا۟","kafarū","disbelieve","অবিশ্বাস করেছে"],["لَهُمْ","lahum","for them","তাদের জন্যে (রয়েছে)"],["نَارُ","nāru","(will be the) Fire","আগুন"],["جَهَنَّمَ","jahannama","(of) Hell","জাহান্নামের"],["لَا","lā","Not","না"],["يُقْضَىٰ","yuq'ḍā","is decreed","আদেশ দেয়া হবে(মৃত্যু)"],["عَلَيْهِمْ","‘alayhim","for them","তাদের উপর"],["فَيَمُوتُوا۟","fayamūtū","that they die","যে তারা মরবে"],["وَلَا","walā","and not","আর না"],["يُخَفَّفُ","yukhaffafu","will be lightened","হাল্কা করা হবে"],["عَنْهُم","‘anhum","for them","তাদের থেকে"],["مِّنْ","min","of","কিছু"],["عَذَابِهَا ۚ","‘adhābihā","its torment","তার শাস্তি"],["كَذَٰلِكَ","kadhālika","Thus","এরূপে"],["نَجْزِى","najzī","We recompense","প্রতিফল দিই আমরা"],["كُلَّ","kulla","every","প্রত্যেকে"],["كَفُورٍۢ","kafūrin","ungrateful one","অকৃতজ্ঞকে"]],"t":"وَ<h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> لَهُمْ نَارُ جَهَ<g>نَّ</>مَ لَا يُ<q>قْ</>ضَىٰ عَلَيْهِمْ فَيَمُوتُو<s>ا۟</> وَلَا يُخَفَّفُ عَنْ<y>هُم مِّ</>نْ عَذَابِهَا ۚ كَ<m>ذَٰ</>لِكَ نَ<q>جْ</>زِى كُلَّ كَ<p>فُو</>رٍۢ"},{"n":37,"w":[["وَهُمْ","wahum","And they","এবং তারা"],["يَصْطَرِخُونَ","yaṣṭarikhūna","will cry","চিৎকার করে বলবে"],["فِيهَا","fīhā","therein","তার মধ্যে"],["رَبَّنَآ","rabbanā","Our Lord","\"হে আমাদের রব"],["أَخْرِجْنَا","akhrij'nā","Bring us out","আমাদেরকে বের করুন"],["نَعْمَلْ","na‘mal","we will do","আমরা কাজ করবো"],["صَـٰلِحًا","ṣāliḥan","righteous (deeds)","সৎ"],["غَيْرَ","ghayra","other than","(তা হ'তে)ভিন্নতর"],["ٱلَّذِى","alladhī","(that) which","যা"],["كُنَّا","kunnā","we used","আমরা"],["نَعْمَلُ ۚ","na‘malu","(to) do","করতেছিলাম\""],["أَوَلَمْ","awalam","Did not","(বলা হবে) নি কি"],["نُعَمِّرْكُم","nu‘ammir'kum","We give you life long enough","তোমাদের আমরা আয়ু বৃদ্ধি করেছি"],["مَّا","mā","that","যাতে"],["يَتَذَكَّرُ","yatadhakkaru","(would) receive admonition","শিক্ষা গ্রহণ করতে"],["فِيهِ","fīhi","therein","তার মধ্যে"],["مَن","man","whoever","কেউ"],["تَذَكَّرَ","tadhakkara","receives admonition","শিক্ষা নিতে (চাইলে)"],["وَجَآءَكُمُ","wajāakumu","And came to you","এবং তোমাদের (কাছে) এসেছিলেন"],["ٱلنَّذِيرُ ۖ","l-nadhīru","the warner","সতর্ককারী"],["فَذُوقُوا۟","fadhūqū","So taste","সুতরাং তোমরা স্বাদ নাও"],["فَمَا","famā","then not","অতঃপর নাই"],["لِلظَّـٰلِمِينَ","lilẓẓālimīna","(is) for the wrongdoers","সীমালঙ্ঘনকারীদের জন্যে"],["مِن","min","any","কোনো"],["نَّصِيرٍ","naṣīrin","helper","সাহায্যকারী"]],"t":"وَهُمْ يَصْطَرِخُونَ فِيهَا رَبَّ<o>نَآ</> أَخْرِ<q>جْ</>نَا نَعْمَلْ <m>صَٰ</>لِحًا غَيْرَ <h>ٱ</>لَّذِى كُ<g>نَّ</>ا نَعْمَلُ ۚ أَوَلَمْ نُعَ<g>مِّ</>رْ<y>كُم مَّ</>ا يَتَذَكَّرُ فِيهِ مَ<k>ن تَ</>ذَكَّرَ وَ<o>جَآ</>ءَكُمُ <h>ٱ</><l>ل</><g>نَّ</>ذِيرُ ۖ فَذُوقُو<s>ا۟</> فَمَا لِل<m>ظَّٰ</>لِمِينَ <d>مِن نَّ</><p>صِي</>رٍ"},{"n":38,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["عَـٰلِمُ","‘ālimu","(is the) Knower","অবগত"],["غَيْبِ","ghaybi","(of the) unseen","গোপন রহস্যের"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশের"],["وَٱلْأَرْضِ ۚ","wal-arḍi","and the earth","ও পৃথিবীর"],["إِنَّهُۥ","innahu","Indeed, He","তিনি নিশ্চযই়"],["عَلِيمٌۢ","‘alīmun","(is the) All-Knower","খুব অবহিত"],["بِذَاتِ","bidhāti","of what (is) in the breasts","অবস্থা সম্পর্কে"],["ٱلصُّدُورِ","l-ṣudūri","of what (is) in the breasts","অন্তরসমূহের"]],"t":"إِ<g>نَّ</> <h>ٱ</>للَّهَ <m>عَٰ</>لِمُ غَيْبِ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ ۚ إِ<g>نَّ</>هُ<m>ۥ</> عَلِي<i>مٌۢ بِ</>ذَاتِ <h>ٱ</><l>ل</>صُّ<p>دُو</>رِ"},{"n":39,"w":[["هُوَ","huwa","He","তিনিই (আল্লাহ)"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["جَعَلَكُمْ","ja‘alakum","made you","তোমাদেরকে বানিয়েছেন"],["خَلَـٰٓئِفَ","khalāifa","successors","প্রতিনিধি হিসেবে"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ ۚ","l-arḍi","the earth","পৃথিবীর"],["فَمَن","faman","And whoever","অতঃপর যে"],["كَفَرَ","kafara","disbelieves","অবিশ্বাস করলো"],["فَعَلَيْهِ","fa‘alayhi","then upon him","তার উপর তখন (পড়বে)"],["كُفْرُهُۥ ۖ","kuf'ruhu","(is) his disbelief","তার অবিশ্বাসের (শাস্তি)"],["وَلَا","walā","And not","এবং না"],["يَزِيدُ","yazīdu","increase","বৃদ্ধি করে"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","the disbelievers","কাফেরদেরকে"],["كُفْرُهُمْ","kuf'ruhum","their disbelief","অবিশ্বাস তাদের"],["عِندَ","‘inda","near","কাছে"],["رَبِّهِمْ","rabbihim","their Lord","তাদের রবের"],["إِلَّا","illā","except","এ ছাড়া"],["مَقْتًۭا ۖ","maqtan","(in) hatred","ক্রোধ"],["وَلَا","walā","and not","আর না"],["يَزِيدُ","yazīdu","increase","বৃদ্ধি করবে"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","the disbelievers","কাফেরদেরকে"],["كُفْرُهُمْ","kuf'ruhum","their disbelief","তাদের অবিশ্বাস"],["إِلَّا","illā","except","এ ছাড়া"],["خَسَارًۭا","khasāran","(in) loss","ক্ষতি"]],"t":"هُوَ <h>ٱ</>لَّذِى جَعَلَكُمْ خَ<o>لَٰٓ</>ئِفَ فِى <h>ٱ</>لْأَرْضِ ۚ فَمَ<k>ن كَ</>فَرَ فَعَلَيْهِ كُفْرُهُۥ ۖ وَلَا يَزِيدُ <h>ٱ</>لْ<m>كَٰ</>فِرِينَ كُفْرُهُمْ عِ<k>ندَ</> رَبِّهِمْ إِلَّا مَ<q>قْ</><d>تًۭا ۖ وَ</>لَا يَزِيدُ <h>ٱ</>لْ<m>كَٰ</>فِرِينَ كُفْرُهُمْ إِلَّا خَسَارًۭا"},{"n":40,"w":[["قُلْ","qul","Say","বলো"],["أَرَءَيْتُمْ","ara-aytum","Have you seen","\"তোমরা (ভেবে) দেখেছো কি"],["شُرَكَآءَكُمُ","shurakāakumu","your partners","তোমাদের শরীকদেরকে"],["ٱلَّذِينَ","alladhīna","those whom","যাদের"],["تَدْعُونَ","tad‘ūna","you call","তোমরা ডেকে থাকো"],["مِن","min","besides","মধ্য হতে"],["دُونِ","dūni","besides","ছাড়া"],["ٱللَّهِ","l-lahi","Allah","আল্লাহকে\""],["أَرُونِى","arūnī","Show Me","আমাকে দেখাও"],["مَاذَا","mādhā","what","কি"],["خَلَقُوا۟","khalaqū","they have created","তারা সৃষ্টি করেছে"],["مِنَ","mina","from","কিছু"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীতে"],["أَمْ","am","or","বা"],["لَهُمْ","lahum","for them","তাদের জন্যে (আছে)"],["شِرْكٌۭ","shir'kun","(is) a share","অংশ"],["فِى","fī","in","মধ্যে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশের"],["أَمْ","am","Or","অথবা"],["ءَاتَيْنَـٰهُمْ","ātaynāhum","have We given them","তাদেরকে আমরা দিয়েছি"],["كِتَـٰبًۭا","kitāban","a Book","কোনো কিতাব"],["فَهُمْ","fahum","so they","অতঃপর তারা"],["عَلَىٰ","‘alā","(are) on","(প্রতিষ্ঠিত) উপর"],["بَيِّنَتٍۢ","bayyinatin","a clear proof","প্রমাণের"],["مِّنْهُ ۚ","min'hu","therefrom","তা থেকে"],["بَلْ","bal","Nay","বরং"],["إِن","in","not","না"],["يَعِدُ","ya‘idu","promise","প্রতিশ্রুতি দেয়"],["ٱلظَّـٰلِمُونَ","l-ẓālimūna","the wrongdoers","সীমালঙ্ঘনকারীরা"],["بَعْضُهُم","ba‘ḍuhum","some of them","তাদের একে"],["بَعْضًا","ba‘ḍan","(to) others","অপরকে"],["إِلَّا","illā","except","এ ছাড়া"],["غُرُورًا","ghurūran","delusion","ধোঁকা"]],"t":"قُلْ أَرَءَيْتُمْ شُرَ<o>كَآ</>ءَكُمُ <h>ٱ</>لَّذِينَ تَ<q>دْ</>عُونَ مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ أَرُونِى مَاذَا خَلَقُو<s>ا۟</> مِنَ <h>ٱ</>لْأَرْضِ أَمْ لَهُمْ شِرْ<k>كٌۭ فِ</>ى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ أَمْ ءَاتَيْ<m>نَٰ</>هُمْ كِ<m>تَٰ</><k>بًۭا فَ</>هُمْ عَلَىٰ بَيِّنَ<d>تٍۢ مِّ</>نْهُ ۚ بَلْ <d>إِن يَ</>عِدُ <h>ٱ</><l>ل</><m>ظَّٰ</>لِمُونَ بَعْضُ<f>هُم بَ</>عْضًا إِلَّا غُرُورًا"},{"n":41,"w":[["۞ إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["يُمْسِكُ","yum'siku","upholds","স্হিরভাবে ধরে রেখেছেন"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশকে"],["وَٱلْأَرْضَ","wal-arḍa","and the earth","ও পৃথিবীকে"],["أَن","an","lest","যেন (না)"],["تَزُولَا ۚ","tazūlā","they cease","কক্ষচ্যুত হয়"],["وَلَئِن","wala-in","And if","আর অবশ্য যদি"],["زَالَتَآ","zālatā","they should cease","কক্ষচ্যুত হয়"],["إِنْ","in","not","না"],["أَمْسَكَهُمَا","amsakahumā","can uphold them","উভয়কে স্হিরভাবে ধরে রাখতে পারবে"],["مِنْ","min","any","মধ্য হতে"],["أَحَدٍۢ","aḥadin","one","কেউ"],["مِّنۢ","min","after Him","থেকে"],["بَعْدِهِۦٓ ۚ","ba‘dihi","after Him","তাঁর পরে"],["إِنَّهُۥ","innahu","Indeed, He","নিশ্চয়ই তিনি"],["كَانَ","kāna","is","হলেন"],["حَلِيمًا","ḥalīman","Most Forbearing","সহনশীল"],["غَفُورًۭا","ghafūran","Oft-Forgiving","ক্ষমাশীল"]],"t":"۞ إِ<g>نَّ</> <h>ٱ</>للَّهَ يُمْسِكُ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضَ أَ<k>ن تَ</>زُولَا ۚ وَلَئِ<k>ن زَ</>الَ<o>تَآ</> إِنْ أَمْسَكَهُمَا مِنْ أَحَ<d>دٍۢ مِّ</><i>نۢ بَ</>عْدِهِ<o>ۦٓ</> ۚ إِ<g>نَّ</>هُ<m>ۥ</> كَانَ حَلِيمًا غَفُورًۭا"},{"n":42,"w":[["وَأَقْسَمُوا۟","wa-aqsamū","And they swore","এবং তারা শপথ করে"],["بِٱللَّهِ","bil-lahi","by Allah","আল্লাহর (নামে)"],["جَهْدَ","jahda","(the) strongest","কড়া"],["أَيْمَـٰنِهِمْ","aymānihim","(of) their oaths","তাদের শপথসমূহ"],["لَئِن","la-in","that if","অবশ্যই যদি"],["جَآءَهُمْ","jāahum","came to them","তাদের কাছে আসেন"],["نَذِيرٌۭ","nadhīrun","a warner","কোনো সতর্ককারী"],["لَّيَكُونُنَّ","layakūnunna","surely, they would be","তারা হবে অবশ্যই"],["أَهْدَىٰ","ahdā","more guided","অধিকতর সৎপথে"],["مِنْ","min","than","চেয়েও"],["إِحْدَى","iḥ'dā","any","যে কোনোটির"],["ٱلْأُمَمِ ۖ","l-umami","(of) the nations","(অন্যান্য) জাতিগুলোর"],["فَلَمَّا","falammā","But when","অতঃপর যখন"],["جَآءَهُمْ","jāahum","came to them","তাদের কাছে আসলেন"],["نَذِيرٌۭ","nadhīrun","a warner","সতর্ককারী"],["مَّا","mā","not","না"],["زَادَهُمْ","zādahum","it increased them","তাদের বৃদ্ধি করেছে"],["إِلَّا","illā","but","এ ছাড়া"],["نُفُورًا","nufūran","(in) aversion","পালনো"]],"t":"وَأَ<q>قْ</>سَمُو<s>ا۟</> بِ<h>ٱ</>للَّهِ جَهْدَ أَيْ<m>مَٰ</>نِهِمْ لَئِ<k>ن جَ</><o>آ</>ءَهُمْ نَذِي<w>رٌۭ لَّ</>يَكُونُ<g>نَّ</> أَهْدَىٰ مِنْ إِحْدَى <h>ٱ</>لْأُمَمِ ۖ فَلَ<g>مَّ</>ا <o>جَآ</>ءَهُمْ نَذِي<d>رٌۭ مَّ</>ا زَادَهُمْ إِلَّا نُفُورًا"},{"n":43,"w":[["ٱسْتِكْبَارًۭا","is'tik'bāran","(Due to) arrogance","ঔদ্ধত্য প্রকাশ করে"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the land","পৃথিবীর"],["وَمَكْرَ","wamakra","and plotting","ও ষড়যন্ত্র (এঁটে)"],["ٱلسَّيِّئِ ۚ","l-sayi-i","(of) the evil","নিকৃষ্ট"],["وَلَا","walā","but not","অথচ না"],["يَحِيقُ","yaḥīqu","encompasses","ঘিরে ধরে"],["ٱلْمَكْرُ","l-makru","the plot","ষড়যন্ত্র"],["ٱلسَّيِّئُ","l-sayi-u","(of) the evil","নিকৃষ্ট"],["إِلَّا","illā","except","কিন্তু"],["بِأَهْلِهِۦ ۚ","bi-ahlihi","its own people","তার উদ্যোক্তাদেরই"],["فَهَلْ","fahal","Then do","তবে কি"],["يَنظُرُونَ","yanẓurūna","they wait","তারা অপেক্ষা করছে"],["إِلَّا","illā","except","এ ছাড়া যে"],["سُنَّتَ","sunnata","(the) way","বিধানের"],["ٱلْأَوَّلِينَ ۚ","l-awalīna","(of) the former (people)","পূর্ববর্তীদের (ক্ষেত্রে গৃহীত)"],["فَلَن","falan","But never","তখন কখনও না"],["تَجِدَ","tajida","you will find","পাবে তুমি"],["لِسُنَّتِ","lisunnati","in (the) way","বিধানের ক্ষেত্রে"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["تَبْدِيلًۭا ۖ","tabdīlan","any change","কোনো পরিবর্তন"],["وَلَن","walan","and never","এবং কখনও না"],["تَجِدَ","tajida","you will find","পাবে তুমি"],["لِسُنَّتِ","lisunnati","in (the) way","বিধানে"],["ٱللَّهِ","l-lahi","(of) Allah","আল্লাহর"],["تَحْوِيلًا","taḥwīlan","any alteration","ব্যতিক্রম"]],"t":"ٱسْتِكْبَا<k>رًۭا فِ</>ى <h>ٱ</>لْأَرْضِ وَمَكْرَ <h>ٱ</><l>ل</>سَّيِّئِ ۚ وَلَا يَحِيقُ <h>ٱ</>لْمَكْرُ <h>ٱ</><l>ل</>سَّيِّئُ إِلَّا بِأَهْلِهِۦ<m> ۚ</> فَهَلْ يَ<k>نظُ</>رُونَ إِلَّا سُ<g>نَّ</>تَ <h>ٱ</>لْأَوَّلِينَ ۚ فَلَ<k>ن تَ</>جِدَ لِسُ<g>نَّ</>تِ <h>ٱ</>للَّهِ تَ<q>بْ</>دِيلًۭ<d>ا ۖ وَ</>لَ<k>ن تَ</>جِدَ لِسُ<g>نَّ</>تِ <h>ٱ</>للَّهِ تَحْوِيلًا"},{"n":44,"w":[["أَوَلَمْ","awalam","Have they not","নি কি"],["يَسِيرُوا۟","yasīrū","traveled","তারা ভ্রমণ করে"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the land","পৃথিবীর"],["فَيَنظُرُوا۟","fayanẓurū","and seen","তারা তখন দেখে (নাই কি)"],["كَيْفَ","kayfa","how","কেমন"],["كَانَ","kāna","was","ছিলো"],["عَـٰقِبَةُ","‘āqibatu","(the) end","পরিণাম"],["ٱلَّذِينَ","alladhīna","(of) those who","তাদের (যারা)"],["مِن","min","(were) before them","পূর্বে ছিলো"],["قَبْلِهِمْ","qablihim","(were) before them","তাদের"],["وَكَانُوٓا۟","wakānū","And they were","অথচ তারা ছিলো"],["أَشَدَّ","ashadda","stronger","অনেক বেশী কঠোর"],["مِنْهُمْ","min'hum","than them","এদের চেয়েও"],["قُوَّةًۭ ۚ","quwwatan","(in) power","শক্তিতে"],["وَمَا","wamā","But not","এবং নন"],["كَانَ","kāna","is","ছিল"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ (এমন যে)"],["لِيُعْجِزَهُۥ","liyu‘'jizahu","that can escape (from) Him","তাঁকে অক্ষম করতে পারে"],["مِن","min","any","কোনো"],["شَىْءٍۢ","shayin","thing","কিছুই"],["فِى","fī","in","মধ্যেকার"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশের"],["وَلَا","walā","and not","আর না"],["فِى","fī","in","(কোন কিছু) মধ্যকার"],["ٱلْأَرْضِ ۚ","l-arḍi","the earth","পৃথিবীর"],["إِنَّهُۥ","innahu","Indeed, He","তিনি নিশ্চয়ই"],["كَانَ","kāna","is","হলেন"],["عَلِيمًۭا","‘alīman","All-Knower","মহাজ্ঞানী"],["قَدِيرًۭا","qadīran","All-Powerful","সর্বশক্তিমান"]],"t":"أَوَلَمْ يَسِيرُو<s>ا۟</> فِى <h>ٱ</>لْأَرْضِ فَيَ<k>نظُ</>رُو<s>ا۟</> كَيْفَ كَانَ <m>عَٰ</>قِبَةُ <h>ٱ</>لَّذِينَ مِ<k>ن قَ</><q>بْ</>لِهِمْ وَكَا<o>نُوٓ</><s>ا۟</> أَشَدَّ مِنْهُمْ قُوَّ<d>ةًۭ ۚ وَ</>مَا كَانَ <h>ٱ</>للَّهُ لِيُعْجِزَهُ<m>ۥ</> مِ<k>ن شَىْءٍۢ فِ</>ى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَلَا فِى <h>ٱ</>لْأَرْضِ ۚ إِ<g>نَّ</>هُ<m>ۥ</> كَانَ عَلِي<k>مًۭا قَ</>دِيرًۭا"},{"n":45,"w":[["وَلَوْ","walaw","And if","এবং যদি"],["يُؤَاخِذُ","yuākhidhu","Allah (were to) punish","পাকড়াও করতেন"],["ٱللَّهُ","l-lahu","Allah (were to) punish","আল্লাহ"],["ٱلنَّاسَ","l-nāsa","the people","মানুষকে"],["بِمَا","bimā","for what","এ কারণে যা"],["كَسَبُوا۟","kasabū","they have earned","তারা কামাই করেছে"],["مَا","mā","not","না"],["تَرَكَ","taraka","He would leave","রেহাই দিতেন"],["عَلَىٰ","‘alā","on","উপর"],["ظَهْرِهَا","ẓahrihā","its back","তার পৃষ্ঠের"],["مِن","min","any","কোনো"],["دَآبَّةٍۢ","dābbatin","creature","চলমান প্রাণীকেই"],["وَلَـٰكِن","walākin","But","কিন্তু"],["يُؤَخِّرُهُمْ","yu-akhiruhum","He gives them respite","তাদের অবকাশ দিয়ে থাকেন তিনি"],["إِلَىٰٓ","ilā","till","পর্যন্ত"],["أَجَلٍۢ","ajalin","a term","একটা সময়"],["مُّسَمًّۭى ۖ","musamman","appointed","নির্দিষ্ট"],["فَإِذَا","fa-idhā","And when","অতঃপর যখন"],["جَآءَ","jāa","comes","আসবে"],["أَجَلُهُمْ","ajaluhum","their term","তাদের সময়"],["فَإِنَّ","fa-inna","then indeed","নিশ্চযই় তখন"],["ٱللَّهَ","l-laha","Allah","আল্লাহ"],["كَانَ","kāna","is","হবেন"],["بِعِبَادِهِۦ","bi‘ibādihi","of His slaves","তাঁর দাসদের সম্পর্কে"],["بَصِيرًۢا","baṣīran","All-Seer","খুব দেখেন (অর্থাৎ দেখে নিবেন)"]],"t":"وَلَوْ يُؤَاخِذُ <h>ٱ</>للَّهُ <h>ٱ</><l>ل</><g>نَّ</>اسَ بِمَا كَسَبُو<s>ا۟</> مَا تَرَكَ عَلَىٰ ظَهْرِهَا مِ<k>ن دَ</><n>آ</>بَّ<d>ةٍۢ وَ</><m>لَٰ</><d>كِن يُ</>ؤَخِّرُهُمْ إِلَ<o>ىٰٓ</> أَجَ<d>لٍۢ مُّ</>سَ<k>مًّۭى ۖ فَ</>إِذَا <o>جَآ</>ءَ أَجَلُهُمْ فَإِ<g>نَّ</> <h>ٱ</>للَّهَ كَانَ بِعِبَادِ<m>هِۦ</> بَصِيرًۢا"}]}