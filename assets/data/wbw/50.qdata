۞ قَالَ قَرِينُهُ<m>ۥ</> رَبَّنَا <o>مَآ</> أَ<q>طْ</>غَيْتُهُ<m>ۥ</> وَ<m>لَٰ</>كِ<k>ن كَ</>انَ فِى ضَ<m>لَٰ</><i>لٍۭ بَ</><p>عِي</><q>دٍۢ</>"},{"n":28,"w":[["قَالَ","qāla","He will say","(আল্লাহ) বলবেন"],["لَا","lā","(Do) not","\"না"],["تَخْتَصِمُوا۟","takhtaṣimū","dispute","তোমরা তর্কাতর্কি করো"],["لَدَىَّ","ladayya","(in) My presence","আমার কাছে"],["وَقَدْ","waqad","and indeed","এবং নিশ্চয়ই"],["قَدَّمْتُ","qaddamtu","I sent forth","আমি পূর্বে পাঠিয়েছি"],["إِلَيْكُم","ilaykum","to you","তোমাদের প্রতি"],["بِٱلْوَعِيدِ","bil-wa‘īdi","the Warning","(খারাপ পরিণতির) সতর্কবাণী"]],"t":"قَالَ لَا تَخْتَصِمُو<s>ا۟</> لَدَىَّ وَقَ<q>دْ</> قَدَّمْتُ إِلَيْ<f>كُم بِ</><h>ٱ</>لْوَ<p>عِي</><q>دِ</>"},{"n":29,"w":[["مَا","mā","Not","না"],["يُبَدَّلُ","yubaddalu","will be changed","পরিবর্তন হয়"],["ٱلْقَوْلُ","l-qawlu","the word","কথার"],["لَدَىَّ","ladayya","with Me","আমার কাছে"],["وَمَآ","wamā","and not","এবং না"],["أَنَا۠","anā","I Am","আমি"],["بِظَلَّـٰمٍۢ","biẓallāmin","unjust","অবিচারক"],["لِّلْعَبِيدِ","lil'‘abīdi","to My slaves","বান্দাদেরকে/ দাসদেরকে\""]],"t":"مَا يُبَدَّلُ <h>ٱ</>لْقَوْلُ لَدَىَّ وَ<o>مَآ</> أَنَا۠ بِظَ<m>لَّٰ</><w>مٍۢ لِّ</>لْعَ<p>بِي</><q>دِ</>"},{"n":30,"w":[["يَوْمَ","yawma","(The) Day","সেদিন"],["نَقُولُ","naqūlu","We will say","বলব আমরা"],["لِجَهَنَّمَ","lijahannama","to Hell","জাহান্নামকে"],["هَلِ","hali","Are","\"কি"],["ٱمْتَلَأْتِ","im'talati","you filled","তুমি পূর্ণ হয়েছ\""],["وَتَقُولُ","wataqūlu","And it will say","এবং সে বলবে"],["هَلْ","hal","Are","\"(আছে) কি"],["مِن","min","(there) any","কিছু"],["مَّزِيدٍۢ","mazīdin","more","আরও\""]],"t":"يَوْمَ نَقُولُ لِجَهَ<g>نَّ</>مَ هَلِ <h>ٱ</>مْتَلَأْتِ وَتَقُولُ هَلْ <d>مِن مَّ</><p>زِي</><q>دٍۢ</>"},{"n":31,"w":[["وَأُزْلِفَتِ","wa-uz'lifati","And will be brought near","নিকটে আনা হবে"],["ٱلْجَنَّةُ","l-janatu","the Paradise","জান্নাত"],["لِلْمُتَّقِينَ","lil'muttaqīna","to the righteous","মুত্তাকীদের জন্যে"],["غَيْرَ","ghayra","not","না"],["بَعِيدٍ","ba‘īdin","far","দূরত্বে (থাকবে)"]],"t":"وَأُزْلِفَتِ <h>ٱ</>لْجَ<g>نَّ</>ةُ لِلْمُتَّقِينَ غَيْرَ بَ<p>عِي</><q>دٍ</>"},{"n":32,"w":[["هَـٰذَا","hādhā","This","\"(বলা হবে) এটা"],["مَا","mā","(is) what","(তাই) যার"],["تُوعَدُونَ","tū‘adūna","you were promised","তোমাদেরকে প্রতিশ্রুতি দেওয়া হয়েছিল"],["لِكُلِّ","likulli","for everyone","জন্যে প্রত্যেক"],["أَوَّابٍ","awwābin","who turns","প্রত্যাবর্তনকারীর (আল্লাহর দিকে)"],["حَفِيظٍۢ","ḥafīẓin","(and) who keeps","সংরক্ষণকারীর (আল্লাহর সীমার)"]],"t":"<m>هَٰ</>ذَا مَا تُوعَدُونَ لِكُلِّ أَوَّابٍ حَ<p>فِي</>ظٍۢ"},{"n":33,"w":[["مَّنْ","man","Who","যে"],["خَشِىَ","khashiya","feared","ভয় করত"],["ٱلرَّحْمَـٰنَ","l-raḥmāna","the Most Gracious","দয়াময়কে"],["بِٱلْغَيْبِ","bil-ghaybi","in the unseen","না দেখেই"],["وَجَآءَ","wajāa","and came","এবং এসেছে"],["بِقَلْبٍۢ","biqalbin","with a heart","অন্তরসহ"],["مُّنِيبٍ","munībin","returning","বিনীত"]],"t":"مَّنْ خَشِىَ <h>ٱ</><l>ل</>رَّحْ<m>مَٰ</>نَ بِ<h>ٱ</>لْغَيْبِ وَ<o>جَآ</>ءَ بِقَلْ<d>بٍۢ مُّ</><p>نِي</><q>بٍ</>"},{"n":34,"w":[["ٱدْخُلُوهَا","ud'khulūhā","Enter it","প্রবেশ করো তাতে"],["بِسَلَـٰمٍۢ ۖ","bisalāmin","in peace","শান্তি ও নিরাপত্তা সহ"],["ذَٰلِكَ","dhālika","That","(এটা) সেই"],["يَوْمُ","yawmu","(is) a Day","দিন"],["ٱلْخُلُودِ","l-khulūdi","(of) Eternity","চিরন্তন (জীবনের)\""]],"t":"ٱ<q>دْ</>خُلُوهَا بِسَ<m>لَٰ</><k>مٍۢ ۖ ذَٰ</>لِكَ يَوْمُ <h>ٱ</>لْخُ<p>لُو</><q>دِ</>"},{"n":35,"w":[["لَهُم","lahum","For them","তাদের জন্যে (থাকবে)"],["مَّا","mā","whatever","(তাই) যা"],["يَشَآءُونَ","yashāūna","they wish","তারা চাইবে"],["فِيهَا","fīhā","therein","তার মধ্যে"],["وَلَدَيْنَا","waladaynā","and with Us","এবং আমাদের কাছে (আছে)"],["مَزِيدٌۭ","mazīdun","(is) more","আরও অনেক"]],"t":"لَ<y>هُم مَّ</>ا يَ<o>شَآ</>ءُونَ فِيهَا وَلَدَيْنَا مَ<p>زِي</><q>دٌۭ</>"},{"n":36,"w":[["وَكَمْ","wakam","And how many","এবং কত"],["أَهْلَكْنَا","ahlaknā","We destroyed","আমরা ধ্বংস করেছি"],["قَبْلَهُم","qablahum","before them","তাদের পূর্বে"],["مِّن","min","of","থেকে"],["قَرْنٍ","qarnin","a generation","জনগোষ্ঠী"],["هُمْ","hum","they","তারা (ছিল)"],["أَشَدُّ","ashaddu","(were) stronger","অধিক প্রবল"],["مِنْهُم","min'hum","than them","তাদের চেয়েও"],["بَطْشًۭا","baṭshan","(in) power","শক্তিতে"],["فَنَقَّبُوا۟","fanaqqabū","so they explored","অতঃপর তারা  ভ্রমণ করত"],["فِى","fī","throughout","মধ্যে"],["ٱلْبِلَـٰدِ","l-bilādi","the lands","দেশ বিদেশের"],["هَلْ","hal","Is (there)","(ছিল) কি"],["مِن","min","any","কোনো"],["مَّحِيصٍ","maḥīṣin","place of escape","আশ্রয়স্থল (তাদের জন্যে)"]],"t":"وَكَمْ أَهْلَكْنَا قَ<q>بْ</>لَ<y>هُم مِّ</><k>ن قَ</>رْنٍ هُمْ أَشَدُّ مِنْ<f>هُم بَ</><q>طْ</><k>شًۭا فَ</>نَقَّبُو<s>ا۟</> فِى <h>ٱ</>لْبِ<m>لَٰ</>دِ هَلْ <d>مِن مَّ</><p>حِي</>صٍ"},{"n":37,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে (রয়েছে)"],["ذَٰلِكَ","dhālika","that","এর"],["لَذِكْرَىٰ","ladhik'rā","surely, is a reminder","অবশ্যই উপদেশ"],["لِمَن","liman","for (one) who","তার জন্যে"],["كَانَ","kāna","is ","আছে"],["لَهُۥ","lahu","for him","যার"],["قَلْبٌ","qalbun","a heart","অন্তর"],["أَوْ","aw","or","অথবা"],["أَلْقَى","alqā","(who) gives ear","নিবিষ্ট করে"],["ٱلسَّمْعَ","l-sam‘a","(who) gives ear","কান"],["وَهُوَ","wahuwa","while he","এমতাবস্থায় সে"],["شَهِيدٌۭ","shahīdun","(is) a witness","উপস্থিত (মনেপ্রাণে)"]],"t":"إِ<g>نَّ</> فِى <m>ذَٰ</>لِكَ لَذِكْرَىٰ لِمَ<k>ن كَ</>انَ لَهُ<m>ۥ</> قَلْبٌ أَوْ أَلْقَى <h>ٱ</><l>ل</>سَّمْعَ وَهُوَ شَ<p>هِي</><q>دٌۭ</>"},{"n":38,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["خَلَقْنَا","khalaqnā","We created","আমরা সৃষ্টি করেছি"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশ"],["وَٱلْأَرْضَ","wal-arḍa","and the earth","এবং পৃথিবীকে"],["وَمَا","wamā","and whatever","এবং যা কিছু (আছে)"],["بَيْنَهُمَا","baynahumā","(is) between both of them","উভয়ের মাঝে"],["فِى","fī","in","মধ্যে"],["سِتَّةِ","sittati","six","ছয়"],["أَيَّامٍۢ","ayyāmin","periods","দিনের"],["وَمَا","wamā","and (did) not","এবং না"],["مَسَّنَا","massanā","touch Us","আমাদের স্পর্শ করেছে"],["مِن","min","any","কোনো"],["لُّغُوبٍۢ","lughūbin","fatigue","ক্লান্তি"]],"t":"وَلَقَ<q>دْ</> خَلَ<q>قْ</>نَا <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضَ وَمَا بَيْنَهُمَا فِى سِتَّةِ أَيَّا<d>مٍۢ وَ</>مَا مَسَّنَا <w>مِن لُّ</><p>غُو</><q>بٍۢ</>"},{"n":39,"w":[["فَٱصْبِرْ","fa-iṣ'bir","So be patient","অতএব ধৈর্য ধরো"],["عَلَىٰ","‘alā","over","উপর"],["مَا","mā","what","যা"],["يَقُولُونَ","yaqūlūna","they say","তারা বলছে"],["وَسَبِّحْ","wasabbiḥ","and glorify","এবং পবিত্রতা ঘোষণা করো"],["بِحَمْدِ","biḥamdi","(the) praise","প্রশংসাসহ"],["رَبِّكَ","rabbika","(of) your Lord","তোমার রবের"],["قَبْلَ","qabla","before","পূর্বে"],["طُلُوعِ","ṭulū‘i","(the) rising","উদয়ের"],["ٱلشَّمْسِ","l-shamsi","(of) the sun","সূর্যের"],["وَقَبْلَ","waqabla","and before","ও পূর্বে"],["ٱلْغُرُوبِ","l-ghurūbi","the setting","(সূর্য) অস্তের"]],"t":"فَ<h>ٱ</>صْبِرْ عَلَىٰ مَا يَقُولُونَ وَسَبِّحْ بِحَمْدِ رَبِّكَ قَ<q>بْ</>لَ طُلُوعِ <h>ٱ</><l>ل</>شَّمْسِ وَقَ<q>بْ</>لَ <h>ٱ</>لْغُ<p>رُو</><q>بِ</>"},{"n":40,"w":[["وَمِنَ","wamina","And of","এবং কিছু অংশে"],["ٱلَّيْلِ","al-layli","the night","রাতের"],["فَسَبِّحْهُ","fasabbiḥ'hu","glorify Him","অতঃপর তাঁর পবিত্রতা ঘোষণা করো"],["وَأَدْبَـٰرَ","wa-adbāra","and after","এবং পরে"],["ٱلسُّجُودِ","l-sujūdi","the prostration","(নামাজের) সিজদাসমূহেরও"]],"t":"وَمِنَ <h>ٱ</>لَّيْلِ فَسَبِّحْهُ وَأَ<q>دْ</><m>بَٰ</>رَ <h>ٱ</><l>ل</>سُّ<p>جُو</><q>دِ</>"},{"n":41,"w":[["وَٱسْتَمِعْ","wa-is'tami‘","And listen","এবং শোনো"],["يَوْمَ","yawma","(The) Day","যে দিন"],["يُنَادِ","yunādi","will call","ডাকবে"],["ٱلْمُنَادِ","l-munādi","the caller","একজন ঘোষণাকারী"],["مِن","min","from","হতে"],["مَّكَانٍۢ","makānin","a place","স্থান"],["قَرِيبٍۢ","qarībin","near","নিকটবর্তী"]],"t":"وَ<h>ٱ</>سْتَمِعْ يَوْمَ يُنَادِ <h>ٱ</>لْمُنَادِ <d>مِن مَّ</>كَا<k>نٍۢ قَ</><p>رِي</><q>بٍۢ</>"},{"n":42,"w":[["يَوْمَ","yawma","(The) Day","সেদিন"],["يَسْمَعُونَ","yasma‘ūna","they will hear","তারা শুনতে পারবে"],["ٱلصَّيْحَةَ","l-ṣayḥata","the Blast","মহাগর্জন"],["بِٱلْحَقِّ ۚ","bil-ḥaqi","in truth","যথাযথভাবে"],["ذَٰلِكَ","dhālika","That","এটা"],["يَوْمُ","yawmu","(is the) Day","দিন"],["ٱلْخُرُوجِ","l-khurūji","(of) coming forth","(কবর হতে) বের হওয়ার"]],"t":"يَوْمَ يَسْمَعُونَ <h>ٱ</><l>ل</>صَّيْحَةَ بِ<h>ٱ</>لْحَقِّ ۚ <m>ذَٰ</>لِكَ يَوْمُ <h>ٱ</>لْخُ<p>رُو</><q>جِ</>"},{"n":43,"w":[["إِنَّا","innā","Indeed, We","নিশ্চয়ই আমরা"],["نَحْنُ","naḥnu","[We]","আমরাই"],["نُحْىِۦ","nuḥ'yī","[We] give life","জীবন দিই"],["وَنُمِيتُ","wanumītu","and [We] cause death","এবং মৃত্যু দিই আমরাই"],["وَإِلَيْنَا","wa-ilaynā","and to Us","এবং আমাদের দিকেই"],["ٱلْمَصِيرُ","l-maṣīru","(is) the final return","প্রত্যাবর্তনস্থল"]],"t":"إِ<g>نَّ</>ا نَحْنُ نُحْ<m>ىِۦ</> وَنُمِيتُ وَإِلَيْنَا <h>ٱ</>لْمَ<p>صِي</>رُ"},{"n":44,"w":[["يَوْمَ","yawma","(The) Day","যেদিন"],["تَشَقَّقُ","tashaqqaqu","will split","বিদীর্ণ হবে"],["ٱلْأَرْضُ","l-arḍu","the earth","পৃথিবী"],["عَنْهُمْ","‘anhum","from them","তাদের ভিতর হতে"],["سِرَاعًۭا ۚ","sirā‘an","hurrying","ত্রস্তব্যস্ত"],["ذَٰلِكَ","dhālika","That","এই"],["حَشْرٌ","ḥashrun","(is) a gathering","সমবেত করা"],["عَلَيْنَا","‘alaynā","for Us","আমাদের উপর"],["يَسِيرٌۭ","yasīrun","easy","খুবই সহজ"]],"t":"يَوْمَ تَشَقَّقُ <h>ٱ</>لْأَرْضُ عَنْهُمْ سِرَا<k>عًۭا ۚ ذَٰ</>لِكَ حَشْرٌ عَلَيْنَا يَ<p>سِي</>رٌۭ"},{"n":45,"w":[["نَّحْنُ","naḥnu","We","(হে নবী) আমরা"],["أَعْلَمُ","a‘lamu","know best","খুব জানি"],["بِمَا","bimā","[of] what","ঐ বিষয়ে যা"],["يَقُولُونَ ۖ","yaqūlūna","they say","তারা বলেছে"],["وَمَآ","wamā","and not","এবং না"],["أَنتَ","anta","(are) you","তুমি"],["عَلَيْهِم","‘alayhim","over them","তাদের উপর"],["بِجَبَّارٍۢ ۖ","bijabbārin","the one to compel","জবরদস্তিকারী"],["فَذَكِّرْ","fadhakkir","But remind","সুতরাং উপদেশ দাও"],["بِٱلْقُرْءَانِ","bil-qur'āni","with the Quran","কুরআনের সাহায্যে"],["مَن","man","whoever","(তাকে) যে"],["يَخَافُ","yakhāfu","fears","ভয় করে"],["وَعِيدِ","wa‘īdi","My threat","আমার সতর্কীকরণকে"]],"t":"نَّحْنُ أَعْلَمُ بِمَا يَقُولُونَ ۖ وَ<o>مَآ</> أَ<k>نتَ</> عَلَيْ<f>هِم بِ</>جَبَّا<k>رٍۢ ۖ فَ</>ذَكِّرْ بِ<h>ٱ</>لْقُرْءَانِ <d>مَن يَ</>خَافُ وَ<p>عِي</><q>دِ</>"}]}