{"n":50,"a":[{"n":1,"w":[["قٓ ۚ","qaf","Qaf","কা-ফ"],["وَٱلْقُرْءَانِ","wal-qur'āni","By the Quran","শপথ কুরআনের"],["ٱلْمَجِيدِ","l-majīdi","the Glorious","সম্মানিত"]],"t":"<n>قٓ</> ۚ وَ<h>ٱ</>لْقُرْءَانِ <h>ٱ</>لْمَ<p>جِي</><q>دِ</>"},{"n":2,"w":[["بَلْ","bal","Nay","বরং"],["عَجِبُوٓا۟","‘ajibū","they wonder","তারা অবাক হয়েছে"],["أَن","an","that","যে"],["جَآءَهُم","jāahum","has come to them","তাদের কাছে এসেছে"],["مُّنذِرٌۭ","mundhirun","a warner","একজন সতর্ককারী"],["مِّنْهُمْ","min'hum","from them","তাদের মধ্য হতে"],["فَقَالَ","faqāla","So say","বলে তাই"],["ٱلْكَـٰفِرُونَ","l-kāfirūna","the disbelievers","অস্বীকারকারীরা"],["هَـٰذَا","hādhā","This","\"এটা"],["شَىْءٌ","shayon","(is) a thing","ব্যাপার"],["عَجِيبٌ","‘ajībun","amazing","আজব"]],"t":"بَلْ عَجِ<o>بُوٓ</><s>ا۟</> أَ<k>ن جَ</><o>آ</>ءَ<y>هُم مُّ</><k>نذِ</><d>رٌۭ مِّ</>نْهُمْ فَقَالَ <h>ٱ</>لْ<m>كَٰ</>فِرُونَ <m>هَٰ</>ذَا شَىْءٌ عَ<p>جِي</><q>بٌ</>"},{"n":3,"w":[["أَءِذَا","a-idhā","What! When","যখন কি"],["مِتْنَا","mit'nā","we die","আমরা মারা যাব"],["وَكُنَّا","wakunnā","and have become","এবংআমরা হব"],["تُرَابًۭا ۖ","turāban","dust","মাটি (তখন পুনরুথিত হব)"],["ذَٰلِكَ","dhālika","That","সেই"],["رَجْعٌۢ","raj‘un","(is) a return","প্রত্যাবর্তন (হবে)"],["بَعِيدٌۭ","ba‘īdun","far","সুদূর পরাহত\""]],"t":"أَءِذَا مِتْنَا وَكُ<g>نَّ</>ا تُرَا<k>بًۭا ۖ ذَٰ</>لِكَ رَ<q>جْ</><i>عٌۢ بَ</><p>عِي</><q>دٌۭ</>"},{"n":4,"w":[["قَدْ","qad","Certainly","নিশ্চয়ই"],["عَلِمْنَا","‘alim'nā","We know","আমরা জানি"],["مَا","mā","what","যা"],["تَنقُصُ","tanquṣu","diminishes","ক্ষয় করে"],["ٱلْأَرْضُ","l-arḍu","the earth","মাটি"],["مِنْهُمْ ۖ","min'hum","of them","তাদের যে অংশ"],["وَعِندَنَا","wa‘indanā","and with Us","এবং আমাদের কাছে আছে"],["كِتَـٰبٌ","kitābun","(is) a Book","একটি কিতাব"],["حَفِيظٌۢ","ḥafīẓun","guarded","সংরক্ষণকারী"]],"t":"قَ<q>دْ</> عَلِمْنَا مَا تَ<k>نقُ</>صُ <h>ٱ</>لْأَرْضُ مِنْهُمْ ۖ وَعِ<k>ندَ</>نَا كِ<m>تَٰ</>بٌ حَ<p>فِي</>ظٌۢ"},{"n":5,"w":[["بَلْ","bal","Nay","বরং"],["كَذَّبُوا۟","kadhabū","they denied","তারা প্রত্যাখ্যান করেছে"],["بِٱلْحَقِّ","bil-ḥaqi","the truth","মহাসত্যকে"],["لَمَّا","lammā","when","যখন"],["جَآءَهُمْ","jāahum","it came (to) them","তাদের কাছে এসেছে"],["فَهُمْ","fahum","so they","তারা অতএব"],["فِىٓ","fī","(are) in","মধ্যে"],["أَمْرٍۢ","amrin","a state","এ বিষয়ের"],["مَّرِيجٍ","marījin","confused","সংশয়ে দোদুল্যমান"]],"t":"بَلْ كَذَّبُو<s>ا۟</> بِ<h>ٱ</>لْحَقِّ لَ<g>مَّ</>ا <o>جَآ</>ءَهُمْ فَهُمْ <o>فِىٓ</> أَمْ<d>رٍۢ مَّ</><p>رِي</><q>جٍ</>"},{"n":6,"w":[["أَفَلَمْ","afalam","Then do not","নি তবে কি"],["يَنظُرُوٓا۟","yanẓurū","they look","তারা লক্ষ্য করে"],["إِلَى","ilā","at","প্রতি"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশের"],["فَوْقَهُمْ","fawqahum","above them ","তাদের উপরে"],["كَيْفَ","kayfa","how","কিভাবে"],["بَنَيْنَـٰهَا","banaynāhā","We structured it","তা আমরা নির্মাণ করেছি"],["وَزَيَّنَّـٰهَا","wazayyannāhā","and adorned it","ও তা আমরা সুশোভিত করেছি"],["وَمَا","wamā","and not","এবং নেই"],["لَهَا","lahā","for it","তাতে"],["مِن","min","any","কোনো"],["فُرُوجٍۢ","furūjin","rifts","ফাটল"]],"t":"أَفَلَمْ يَ<k>نظُ</><o>رُوٓ</><s>ا۟</> إِلَى <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ فَوْقَهُمْ كَيْفَ بَنَيْ<m>نَٰ</>هَا وَزَيَّ<g>نَّٰ</>هَا وَمَا لَهَا مِ<k>ن فُ</><p>رُو</><q>جٍۢ</>"},{"n":7,"w":[["وَٱلْأَرْضَ","wal-arḍa","And the earth","এবং ভূমিকে"],["مَدَدْنَـٰهَا","madadnāhā","We have spread it out","তা আমরা বিস্তৃত করেছি"],["وَأَلْقَيْنَا","wa-alqaynā","and cast","এবং আমরা স্থাপন করেছি"],["فِيهَا","fīhā","therein","তাতে"],["رَوَٰسِىَ","rawāsiya","firmly set mountains","পর্বতমালা"],["وَأَنۢبَتْنَا","wa-anbatnā","and We made to grow","এবং আমরা উৎপন্ন করেছি"],["فِيهَا","fīhā","therein","তাতে"],["مِن","min","of","ধরণের"],["كُلِّ","kulli","every","প্রত্যেক"],["زَوْجٍۭ","zawjin","kind","(উদ্ভিদ) জোড়া জোড়া"],["بَهِيجٍۢ","bahījin","beautiful","নয়নজুড়ানো"]],"t":"وَ<h>ٱ</>لْأَرْضَ مَدَ<q>دْ</><m>نَٰ</>هَا وَأَلْقَيْنَا فِيهَا رَ<m>وَٰ</>سِىَ وَأَ<i>نۢبَ</>تْنَا فِيهَا مِ<k>ن كُ</>لِّ زَوْ<i>جٍۭ بَ</><p>هِي</><q>جٍۢ</>"},{"n":8,"w":[["تَبْصِرَةًۭ","tabṣiratan","Giving insight","ও (এসব কিছু) দৃষ্টিপ্রসারণকারী"],["وَذِكْرَىٰ","wadhik'rā","and a reminder","ও শিক্ষাপ্রদ"],["لِكُلِّ","likulli","for every","প্রত্যেকের জন্যে"],["عَبْدٍۢ","‘abdin","slave","বান্দার/ দাসের"],["مُّنِيبٍۢ","munībin","who turns","যে প্রত্যাবর্তনকারী (আল্লাহর দিকে)"]],"t":"تَ<q>بْ</>صِرَ<d>ةًۭ وَ</>ذِكْرَىٰ لِكُلِّ عَ<q>بْ</><d>دٍۢ مُّ</><p>نِي</><q>بٍۢ</>"},{"n":9,"w":[["وَنَزَّلْنَا","wanazzalnā","And We have sent down","এবং আমরা অবতীর্ণ করেছি"],["مِنَ","mina","from","থেকে"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশ"],["مَآءًۭ","māan","water","পানি"],["مُّبَـٰرَكًۭا","mubārakan","blessed","উপকারী"],["فَأَنۢبَتْنَا","fa-anbatnā","then We made to grow","এরপর আমরা  উৎপন্ন করেছি"],["بِهِۦ","bihi","thereby","তা দিয়ে"],["جَنَّـٰتٍۢ","jannātin","gardens","বাগানসমূহ"],["وَحَبَّ","waḥabba","and grain","ও শস্যাদি"],["ٱلْحَصِيدِ","l-ḥaṣīdi","(for) the harvest","কৃষিজাত"]],"t":"وَنَزَّلْنَا مِنَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ <o>مَآ</><d>ءًۭ مُّ</><m>بَٰ</>رَ<k>كًۭا فَ</>أَ<i>نۢبَ</>تْنَا بِ<m>هِۦ</> جَ<g>نَّٰ</><d>تٍۢ وَ</>حَبَّ <h>ٱ</>لْحَ<p>صِي</><q>دِ</>"},{"n":10,"w":[["وَٱلنَّخْلَ","wal-nakhla","And the palms trees","এবং খেজুর গাছসমূহ"],["بَاسِقَـٰتٍۢ","bāsiqātin","tall ","উঁচু"],["لَّهَا","lahā","for it","তার আছে"],["طَلْعٌۭ","ṭal‘un","(are) layers","খেজুর গুচ্ছ"],["نَّضِيدٌۭ","naḍīdun","arranged","থরে থরে সাজানো"]],"t":"وَ<h>ٱ</><l>ل</><g>نَّ</>خْلَ بَاسِ<m>قَٰ</><w>تٍۢ لَّ</>هَا طَلْ<d>عٌۭ نَّ</><p>ضِي</><q>دٌۭ</>"},{"n":11,"w":[["رِّزْقًۭا","riz'qan","A provision","জীবিকা"],["لِّلْعِبَادِ ۖ","lil'‘ibādi","for the slaves","দাসদের/ বান্দাদের জন্যে"],["وَأَحْيَيْنَا","wa-aḥyaynā","and We give life","এবং আমরা জীবিত করি"],["بِهِۦ","bihi","therewith","তা দিয়ে"],["بَلْدَةًۭ","baldatan","(to) a land","ভূমিকে"],["مَّيْتًۭا ۚ","maytan","dead","মৃত"],["كَذَٰلِكَ","kadhālika","Thus","এভাবেই"],["ٱلْخُرُوجُ","l-khurūju","(will be) the coming forth","উত্থান (হবে)"]],"t":"رِّزْ<w>قًۭا لِّ</>لْعِبَادِ ۖ وَأَحْيَيْنَا بِ<m>هِۦ</> بَلْدَ<d>ةًۭ مَّ</>يْ<k>تًۭا ۚ كَ</><m>ذَٰ</>لِكَ <h>ٱ</>لْخُ<p>رُو</><q>جُ</>"},{"n":12,"w":[["كَذَّبَتْ","kadhabat","Denied","মিথ্যা বলে  অস্বীকার করেছে"],["قَبْلَهُمْ","qablahum","before them","তাদের পূর্বে"],["قَوْمُ","qawmu","(the) people","জাতি"],["نُوحٍۢ","nūḥin","(of) Nuh","নূহের"],["وَأَصْحَـٰبُ","wa-aṣḥābu","and (the) companions","ও অধিবাসীরা"],["ٱلرَّسِّ","l-rasi","(of) Ar-Raas","কূপ"],["وَثَمُودُ","wathamūdu","and Thamud","ও সামুদ"]],"t":"كَذَّبَتْ قَ<q>بْ</>لَهُمْ قَوْمُ نُو<d>حٍۢ وَ</>أَصْ<m>حَٰ</>بُ <h>ٱ</><l>ل</>رَّسِّ وَثَ<p>مُو</><q>دُ</>"},{"n":13,"w":[["وَعَادٌۭ","wa‘ādun","And Aad","এবং আদ"],["وَفِرْعَوْنُ","wafir'‘awnu","and Firaun","ও ফিরআউন"],["وَإِخْوَٰنُ","wa-ikh'wānu","and (the) brothers","ও ভাইয়েরা"],["لُوطٍۢ","lūṭin","(of) Lut","লূতের"]],"t":"وَعَا<d>دٌۭ وَ</>فِرْعَوْنُ وَإِخْ<m>وَٰ</>نُ <p>لُو</><q>طٍۢ</>"},{"n":14,"w":[["وَأَصْحَـٰبُ","wa-aṣḥābu","And (the) companions","এবং অধিবাসীরা"],["ٱلْأَيْكَةِ","l-aykati","(of) the wood","আইকার"],["وَقَوْمُ","waqawmu","and (the) people","ও জাতি"],["تُبَّعٍۢ ۚ","tubba‘in","(of) Tubba","তুব্বা"],["كُلٌّۭ","kullun","All","প্রত্যেকে"],["كَذَّبَ","kadhaba","denied","মিথ্যা বলে অমান্য করেছে"],["ٱلرُّسُلَ","l-rusula","the Messengers","রাসূলদেরকে"],["فَحَقَّ","faḥaqqa","so was fulfilled","ফলে সত্য হয়েছে"],["وَعِيدِ","wa‘īdi","My Threat","আমার ভীতিপ্রদর্শন (শাস্তি পেয়েছে)"]],"t":"وَأَصْ<m>حَٰ</>بُ <h>ٱ</>لْأَيْكَةِ وَقَوْمُ تُبَّ<k>عٍۢ ۚ كُلٌّۭ كَ</>ذَّبَ <h>ٱ</><l>ل</>رُّسُلَ فَحَقَّ وَ<p>عِي</><q>دِ</>"},{"n":15,"w":[["أَفَعَيِينَا","afa‘ayīnā","Were We then tired","আমরা তবে অক্ষম হয়ে পড়েছি কি"],["بِٱلْخَلْقِ","bil-khalqi","with the creation","সৃষ্টিতে"],["ٱلْأَوَّلِ ۚ","l-awali","the first","প্রথম"],["بَلْ","bal","Nay","বরং"],["هُمْ","hum","they","তারা"],["فِى","fī","(are) in","মধ্যে আছে"],["لَبْسٍۢ","labsin","doubt","সন্দেহের"],["مِّنْ","min","about","সম্পর্কে"],["خَلْقٍۢ","khalqin","a creation","সৃষ্টি"],["جَدِيدٍۢ","jadīdin","new","নতুন"]],"t":"أَفَعَيِينَا بِ<h>ٱ</>لْخَلْقِ <h>ٱ</>لْأَوَّلِ ۚ بَلْ هُمْ فِى لَ<q>بْ</><d>سٍۢ مِّ</>نْ خَلْ<k>قٍۢ جَ</><p>دِي</><q>دٍۢ</>"},{"n":16,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["خَلَقْنَا","khalaqnā","We created","আমরা সৃষ্টি করেছি"],["ٱلْإِنسَـٰنَ","l-insāna","man","মানুষকে"],["وَنَعْلَمُ","wana‘lamu","and We know","এবং  আমরা জানি"],["مَا","mā","what","যা"],["تُوَسْوِسُ","tuwaswisu","whispers","কুমন্ত্রণা দেয়"],["بِهِۦ","bihi","to him","তা সম্পর্কে"],["نَفْسُهُۥ ۖ","nafsuhu","his soul","(অর্থাৎ) তার প্রবৃত্তি"],["وَنَحْنُ","wanaḥnu","and We","এবং আমরা"],["أَقْرَبُ","aqrabu","(are) nearer","অধিক নিকটে"],["إِلَيْهِ","ilayhi","to him","তার"],["مِنْ","min","than","চেয়েও"],["حَبْلِ","ḥabli","(his) jugular vein","ধমনী/ শিরার"],["ٱلْوَرِيدِ","l-warīdi","(his) jugular vein","ঘাড়ের"]],"t":"وَلَقَ<q>دْ</> خَلَ<q>قْ</>نَا <h>ٱ</>لْإِ<k>نسَٰ</>نَ وَنَعْلَمُ مَا تُوَسْوِسُ بِ<m>هِۦ</> نَفْسُهُ<m>ۥ</> ۖ وَنَحْنُ أَ<q>قْ</>رَبُ إِلَيْهِ مِنْ حَ<q>بْ</>لِ <h>ٱ</>لْوَ<p>رِي</><q>دِ</>"},{"n":17,"w":[["إِذْ","idh","When","যখন"],["يَتَلَقَّى","yatalaqqā","receive","গ্রহণ করে (অর্থাৎ লিখে)"],["ٱلْمُتَلَقِّيَانِ","l-mutalaqiyāni","the two receivers","দুজন গ্রহণকারী (লেখক)"],["عَنِ","‘ani","on","থেকে"],["ٱلْيَمِينِ","l-yamīni","the right","ডান দিক"],["وَعَنِ","wa‘ani","and on","ও থেকে"],["ٱلشِّمَالِ","l-shimāli","the left","ও বাম দিক"],["قَعِيدٌۭ","qa‘īdun","seated","বসে"]],"t":"إِذْ يَتَلَقَّى <h>ٱ</>لْمُتَلَقِّيَانِ عَنِ <h>ٱ</>لْيَمِينِ وَعَنِ <h>ٱ</><l>ل</>شِّمَالِ قَ<p>عِي</><q>دٌۭ</>"},{"n":18,"w":[["مَّا","mā","Not","না"],["يَلْفِظُ","yalfiẓu","he utters","সে উচ্চারণ করে"],["مِن","min","any","কোনো"],["قَوْلٍ","qawlin","word","কথা"],["إِلَّا","illā","but","এছাড়া যে"],["لَدَيْهِ","ladayhi","with him","তার কাছে (থাকে)"],["رَقِيبٌ","raqībun","(is) an observer","প্রহরী"],["عَتِيدٌۭ","‘atīdun","ready","তৎপর"]],"t":"مَّا يَلْفِظُ مِ<k>ن قَ</>وْلٍ إِلَّا لَدَيْهِ رَقِيبٌ عَ<p>تِي</><q>دٌۭ</>"},{"n":19,"w":[["وَجَآءَتْ","wajāat","And will come","এবং আসবে"],["سَكْرَةُ","sakratu","(the) stupor","যন্ত্রণা"],["ٱلْمَوْتِ","l-mawti","(of) death","মৃত্যুর"],["بِٱلْحَقِّ ۖ","bil-ḥaqi","in truth","সত্য সহকারে"],["ذَٰلِكَ","dhālika","That","\"(বলা হবে এটা) তাই"],["مَا","mā","(is) what","যা"],["كُنتَ","kunta","you were","তুমি ছিলে"],["مِنْهُ","min'hu","[from it]","তা হতে"],["تَحِيدُ","taḥīdu","avoiding","পাশ কাটাতে/ পালিয়ে থাকতে\""]],"t":"وَ<o>جَآ</>ءَتْ سَكْرَةُ <h>ٱ</>لْمَوْتِ بِ<h>ٱ</>لْحَقِّ ۖ <m>ذَٰ</>لِكَ مَا كُ<k>نتَ</> مِنْهُ تَ<p>حِي</><q>دُ</>"},{"n":20,"w":[["وَنُفِخَ","wanufikha","And will be blown","এবং ফুঁ দেওয়া হবে"],["فِى","fī","[in]","মধ্যে"],["ٱلصُّورِ ۚ","l-ṣūri","the trumpet","শিঙার"],["ذَٰلِكَ","dhālika","That","(এটাই) সেই"],["يَوْمُ","yawmu","(is the) Day","দিন (যার)"],["ٱلْوَعِيدِ","l-wa‘īdi","(of) the Warning","ভয় দেখানো হতো"]],"t":"وَنُفِخَ فِى <h>ٱ</><l>ل</>صُّورِ ۚ <m>ذَٰ</>لِكَ يَوْمُ <h>ٱ</>لْوَ<p>عِي</><q>دِ</>"},{"n":21,"w":[["وَجَآءَتْ","wajāat","And will come","এবং আসবে"],["كُلُّ","kullu","every","প্রত্যেক"],["نَفْسٍۢ","nafsin","soul","ব্যক্তি"],["مَّعَهَا","ma‘ahā","with it","তার সাথে (থাকবে)"],["سَآئِقٌۭ","sāiqun","a driver","একজন চালক"],["وَشَهِيدٌۭ","washahīdun","and a witness","ও একজন সাক্ষী"]],"t":"وَ<o>جَآ</>ءَتْ كُلُّ نَفْ<d>سٍۢ مَّ</>عَهَا <o>سَآ</>ئِ<d>قٌۭ وَ</>شَ<p>هِي</><q>دٌۭ</>"},{"n":22,"w":[["لَّقَدْ","laqad","Certainly","\"নিশ্চয়ই"],["كُنتَ","kunta","you were","তুমি ছিলে"],["فِى","fī","in","মধ্যে"],["غَفْلَةٍۢ","ghaflatin","heedlessness","উদাসীনতার"],["مِّنْ","min","of","হতে"],["هَـٰذَا","hādhā","this","এটা"],["فَكَشَفْنَا","fakashafnā","So We have removed","আমরা এখন সরিয়ে নিয়েছি"],["عَنكَ","‘anka","from you","তোমার হতে"],["غِطَآءَكَ","ghiṭāaka","your cover","তোমার পর্দা"],["فَبَصَرُكَ","fabaṣaruka","so your sight","ফলে তোমার দৃষ্টি"],["ٱلْيَوْمَ","l-yawma","today","আজ"],["حَدِيدٌۭ","ḥadīdun","(is) sharp","প্রখর\""]],"t":"لَّقَ<q>دْ</> كُ<k>نتَ</> فِى غَفْلَ<d>ةٍۢ مِّ</>نْ <m>هَٰ</>ذَا فَكَشَفْنَا عَ<k>نكَ</> غِ<o>طَآ</>ءَكَ فَبَصَرُكَ <h>ٱ</>لْيَوْمَ حَ<p>دِي</><q>دٌۭ</>"},{"n":23,"w":[["وَقَالَ","waqāla","And (will) say","এবং বলবে"],["قَرِينُهُۥ","qarīnuhu","his 