{"n":107,"a":[{"n":1,"w":[["أَرَءَيْتَ","ara-ayta","Have you seen","তুমি কি দেখেছ"],["ٱلَّذِى","alladhī","the one who","(তাকে) যে"],["يُكَذِّبُ","yukadhibu","denies","মিথ্যা অভিহিত করে"],["بِٱلدِّينِ","bil-dīni","the Judgment","বিচার দিনকে"]],"t":"أَرَءَيْتَ <h>ٱ</>لَّذِى يُكَذِّبُ بِ<h>ٱ</><l>ل</><p>دِّي</>نِ"},{"n":2,"w":[["فَذَٰلِكَ","fadhālika","Then that","সে তো সে-ই"],["ٱلَّذِى","alladhī","(is) the one who","যে"],["يَدُعُّ","yadu‘‘u","repulses","ধাক্কা দেয়"],["ٱلْيَتِيمَ","l-yatīma","the orphan","ইয়াতিমকে"]],"t":"فَ<m>ذَٰ</>لِكَ <h>ٱ</>لَّذِى يَدُعُّ <h>ٱ</>لْيَ<p>تِي</>مَ"},{"n":3,"w":[["وَلَا","walā","And (does) not","এবং না"],["يَحُضُّ","yaḥuḍḍu","feel the urge","উৎসাহিত করে"],["عَلَىٰ","‘alā","to","ব্যাপারে"],["طَعَامِ","ṭa‘āmi","feed","খাদ্যদানের"],["ٱلْمِسْكِينِ","l-mis'kīni","the poor","অভাবগ্রস্তকে"]],"t":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ <h>ٱ</>لْمِسْ<p>كِي</>نِ"},{"n":4,"w":[["فَوَيْلٌۭ","fawaylun","So woe","অতএব দুর্ভোগ"],["لِّلْمُصَلِّينَ","lil'muṣallīna","to those who pray","(ঐসব) সালাত আদায়কারীদের জন্য"]],"t":"فَوَيْ<w>لٌۭ لِّ</>لْمُصَ<p>لِّي</>نَ"},{"n":5,"w":[["ٱلَّذِينَ","alladhīna","Those who","যাদের (বৈশিষ্ট্য হলো)"],["هُمْ","hum","[they]","তারা"],["عَن","‘an","about","সম্বন্ধে"],["صَلَاتِهِمْ","ṣalātihim","their prayers","তাদের সালাত"],["سَاهُونَ","sāhūna","(are) neglectful","উদাসীন"]],"t":"ٱلَّذِينَ هُمْ عَ<k>ن صَ</>لَاتِهِمْ سَا<p>هُو</>نَ"},{"n":6,"w":[["ٱلَّذِينَ","alladhīna","Those who","যাদের (বৈশিষ্ট্য হলো)"],["هُمْ","hum","[they]","তারা"],["يُرَآءُونَ","yurāūna","make show","লোকদেখানোর (কাজ করে)"]],"t":"ٱلَّذِينَ هُمْ يُ<o>رَآ</><p>ءُو</>نَ"},{"n":7,"w":[["وَيَمْنَعُونَ","wayamna‘ūna","And they deny","এবং দেওয়া হতে বিরত থাকে"],["ٱلْمَاعُونَ","l-mā‘ūna","[the] small kindnesses","সংসারের প্রয়োজনীয় ছোটখাটো জিনিসের"]],"t":"وَيَمْنَعُونَ <h>ٱ</>لْمَا<p>عُو</>نَ"}]}