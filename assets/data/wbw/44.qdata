{"n":44,"a":[{"n":1,"w":[["حمٓ","hha-meem","Ha Meem","হা-মীম"]],"t":"ح<n>مٓ</>"},{"n":2,"w":[["وَٱلْكِتَـٰبِ","wal-kitābi","By the Book","শপথ (এই) কিতাবের"],["ٱلْمُبِينِ","l-mubīni","the clear","সুস্পষ্ট"]],"t":"وَ<h>ٱ</>لْكِ<m>تَٰ</>بِ <h>ٱ</>لْمُ<p>بِي</>نِ"},{"n":3,"w":[["إِنَّآ","innā","Indeed, We","নিশ্চয়ই আমরা"],["أَنزَلْنَـٰهُ","anzalnāhu","revealed it","তা আমরা অবতীর্ণ করেছি"],["فِى","fī","in","মধ্যে"],["لَيْلَةٍۢ","laylatin","a Night","এক রাতের"],["مُّبَـٰرَكَةٍ ۚ","mubārakatin","Blessed","সৌভাগ্যময়"],["إِنَّا","innā","Indeed, We","নিশ্চয়ই আমরা"],["كُنَّا","kunnā","[We] are","আমরা ছিলাম"],["مُنذِرِينَ","mundhirīna","(ever) warning","সতর্ককারী"]],"t":"إِ<g>نَّ</><o>آ</> أَ<k>نزَ</>لْ<m>نَٰ</>هُ فِى لَيْلَ<d>ةٍۢ مُّ</><m>بَٰ</>رَكَةٍ ۚ إِ<g>نَّ</>ا كُ<g>نَّ</>ا مُ<k>نذِ</><p>رِي</>نَ"},{"n":4,"w":[["فِيهَا","fīhā","Therein","তার মধ্যে(অর্থাৎ সেই রাতে)"],["يُفْرَقُ","yuf'raqu","is made distinct","স্থির করা হয়"],["كُلُّ","kullu","every","প্রত্যেক"],["أَمْرٍ","amrin","affair","বিষয়"],["حَكِيمٍ","ḥakīmin","wise","বিজ্ঞতাপূর্ণ"]],"t":"فِيهَا يُفْرَقُ كُلُّ أَمْرٍ حَ<p>كِي</>مٍ"},{"n":5,"w":[["أَمْرًۭا","amran","A command","নির্দেশক্রমে"],["مِّنْ","min","from","থেকে"],["عِندِنَآ ۚ","‘indinā","Us","আমাদের নিকট"],["إِنَّا","innā","Indeed, We","নিশ্চয়ই আমরা"],["كُنَّا","kunnā","[We] are","আমরা ছিলাম"],["مُرْسِلِينَ","mur'silīna","(ever) sending","(এক রাসূল) প্রেরণকারী"]],"t":"أَمْ<d>رًۭا مِّ</>نْ عِ<k>ندِ</><o>نَآ ۚ</> إِ<g>نَّ</>ا كُ<g>نَّ</>ا مُرْسِ<p>لِي</>نَ"},{"n":6,"w":[["رَحْمَةًۭ","raḥmatan","As Mercy","অনুগ্রহস্বরূপ"],["مِّن","min","from","পক্ষ হ'তে"],["رَّبِّكَ ۚ","rabbika","your Lord","তোমার রবের"],["إِنَّهُۥ","innahu","Indeed, He","নিশ্চয়ই তিনি"],["هُوَ","huwa","[He]","তিনিই"],["ٱلسَّمِيعُ","l-samī‘u","(is) the All-Hearer","সব কিছুই শুনেন"],["ٱلْعَلِيمُ","l-‘alīmu","the All-Knower","সবকিছু জানেন"]],"t":"رَحْمَ<d>ةًۭ مِّ</><w>ن رَّ</>بِّكَ ۚ إِ<g>نَّ</>هُ<m>ۥ</> هُوَ <h>ٱ</><l>ل</>سَّمِيعُ <h>ٱ</>لْعَ<p>لِي</>مُ"},{"n":7,"w":[["رَبِّ","rabbi","Lord","(তিনি) রব"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশের"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীর"],["وَمَا","wamā","and whatever","এবং যা কিছু"],["بَيْنَهُمَآ ۖ","baynahumā","(is) between both of them","উভয়ের মাঝে আছে"],["إِن","in","if","যদি"],["كُنتُم","kuntum","you are","তোমরা হয়ে থাকো"],["مُّوقِنِينَ","mūqinīna","certain","নিশ্চিত বিশ্বাসী"]],"t":"رَبِّ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ وَمَا بَيْنَهُ<o>مَآ ۖ</> إِ<k>ن كُنتُ</><y>م مُّ</>وقِ<p>نِي</>نَ"},{"n":8,"w":[["لَآ","lā","(There is) no","নেই"],["إِلَـٰهَ","ilāha","god","কোনো ইলাহ"],["إِلَّا","illā","except","ছাড়া"],["هُوَ","huwa","Him","তিনি"],["يُحْىِۦ","yuḥ'yī","He gives life","তিনি জীবন দেন"],["وَيُمِيتُ ۖ","wayumītu","and causes death","এবং মৃত্যুও ঘটান"],["رَبُّكُمْ","rabbukum","your Lord","তোমাদের রব"],["وَرَبُّ","warabbu","and (the) Lord","ও রব"],["ءَابَآئِكُمُ","ābāikumu","(of) your fathers","তোমাদের পিতৃপুরুষদের"],["ٱلْأَوَّلِينَ","l-awalīna","the former","পূর্বকালের"]],"t":"<o>لَآ</> إِ<m>لَٰ</>هَ إِلَّا هُوَ يُحْ<m>ىِۦ</> وَيُمِيتُ ۖ رَبُّكُمْ وَرَبُّ ءَا<o>بَآ</>ئِكُمُ <h>ٱ</>لْأَوَّ<p>لِي</>نَ"},{"n":9,"w":[["بَلْ","bal","Nay","বরং"],["هُمْ","hum","they","তারা"],["فِى","fī","(are) in","মধ্যে"],["شَكٍّۢ","shakkin","doubt ","সন্দেহের"],["يَلْعَبُونَ","yal‘abūna","playing","খেলা করছে"]],"t":"بَلْ هُمْ فِى شَ<d>كٍّۢ يَ</>لْعَ<p>بُو</>نَ"},{"n":10,"w":[["فَٱرْتَقِبْ","fa-ir'taqib","Then watch","সুতরাং অপেক্ষা করো"],["يَوْمَ","yawma","(for the) Day","সেই দিনের (যখন)"],["تَأْتِى","tatī","(when) will bring","আসবে"],["ٱلسَّمَآءُ","l-samāu","the sky","আকাশ"],["بِدُخَانٍۢ","bidukhānin","smoke","নিয়ে ধোঁয়া (আচ্ছন্ন হয়ে)"],["مُّبِينٍۢ","mubīnin","visible","সুস্পষ্ট"]],"t":"فَ<h>ٱ</>رْتَقِ<q>بْ</> يَوْمَ تَأْتِى <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءُ بِدُخَا<d>نٍۢ مُّ</><p>بِي</>نٍۢ"},{"n":11,"w":[["يَغْشَى","yaghshā","Enveloping","ঢেকে নিবে"],["ٱلنَّاسَ ۖ","l-nāsa","the people","মানুষকে"],["هَـٰذَا","hādhā","This","এটাই"],["عَذَابٌ","‘adhābun","(will be) a punishment","শাস্তি"],["أَلِيمٌۭ","alīmun","painful","নিদারুণ"]],"t":"يَغْشَى <h>ٱ</><l>ل</><g>نَّ</>اسَ ۖ <m>هَٰ</>ذَا عَذَابٌ أَ<p>لِي</>مٌۭ"},{"n":12,"w":[["رَّبَّنَا","rabbanā","Our Lord","\"(এখন তারা বলে) হে আমাদের রব"],["ٱكْشِفْ","ik'shif","Remove","দূর করো"],["عَنَّا","‘annā","from us","আমাদের থেকে"],["ٱلْعَذَابَ","l-‘adhāba","the punishment","শাস্তি"],["إِنَّا","innā","indeed, we","নিশ্চয়ই আমরা"],["مُؤْمِنُونَ","mu'minūna","(are) believers","বিশ্বাসী হবো (ঈমান আনবো)\""]],"t":"رَّبَّنَا <h>ٱ</>كْشِفْ عَ<g>نَّ</>ا <h>ٱ</>لْعَذَابَ إِ<g>نَّ</>ا مُؤْمِ<p>نُو</>نَ"},{"n":13,"w":[["أَنَّىٰ","annā","How can","কেমন করে হবে"],["لَهُمُ","lahumu","(there be) for them","তাদের জন্যে"],["ٱلذِّكْرَىٰ","l-dhik'rā","the reminder","উপদেশ গ্রহণ (সম্ভব হবে)"],["وَقَدْ","waqad","when verily","অথচ নিশ্চয়ই"],["جَآءَهُمْ","jāahum","had come to them","তাদের কাছে এসেছে"],["رَسُولٌۭ","rasūlun","a Messenger","একজন রাসূল"],["مُّبِينٌۭ","mubīnun","clear","সুস্পষ্ট"]],"t":"أَ<g>نَّ</>ىٰ لَهُمُ <h>ٱ</><l>ل</>ذِّكْرَىٰ وَقَ<q>دْ</> <o>جَآ</>ءَهُمْ رَسُو<d>لٌۭ مُّ</><p>بِي</>نٌۭ"},{"n":14,"w":[["ثُمَّ","thumma","Then","এরপরও"],["تَوَلَّوْا۟","tawallaw","they turned away","তারা ফিরে যায়"],["عَنْهُ","‘anhu","from him","তা হ'তে"],["وَقَالُوا۟","waqālū","and said","এবং তারা বললো"],["مُعَلَّمٌۭ","mu‘allamun","One taught","\"(সে একজন) প্রশিক্ষণপ্রাপ্ত"],["مَّجْنُونٌ","majnūnun","a mad man","পাগল\""]],"t":"ثُ<g>مَّ</> تَوَلَّوْ<s>ا۟</> عَنْهُ وَقَالُو<s>ا۟</> مُعَلَّ<d>مٌۭ مَّ</><q>جْ</><p>نُو</>نٌ"},{"n":15,"w":[["إِنَّا","innā","Indeed, We","নিশ্চয়ই আমরা"],["كَاشِفُوا۟","kāshifū","(will) remove","দূর করে দিই"],["ٱلْعَذَابِ","l-‘adhābi","the punishment","শাস্তি"],["قَلِيلًا ۚ","qalīlan","a little","কিছুটা (তবুও)"],["إِنَّكُمْ","innakum","indeed, you","তোমরা নিশ্চয়ই"],["عَآئِدُونَ","‘āidūna","(will) return","আগের অবস্হায় ফিরে যাও (যা পূর্বে করতে)"]],"t":"إِ<g>نَّ</>ا كَاشِفُو<s>ا۟</> <h>ٱ</>لْعَذَابِ قَلِيلًا ۚ إِ<g>نَّ</>كُمْ <o>عَآ</>ئِ<p>دُو</>نَ"},{"n":16,"w":[["يَوْمَ","yawma","(The) Day","যেদিন"],["نَبْطِشُ","nabṭishu","We will seize","আমরা পাকড়াও করবো"],["ٱلْبَطْشَةَ","l-baṭshata","(with) the seizure","পাকড়াও"],["ٱلْكُبْرَىٰٓ","l-kub'rā","the greatest","কঠিনভাবে"],["إِنَّا","innā","indeed, We","নিশ্চয়ই আমরা"],["مُنتَقِمُونَ","muntaqimūna","(will) take retribution","প্রতিশোধ গ্রহণকারী(সেহদিন)"]],"t":"يَوْمَ نَ<q>بْ</>طِشُ <h>ٱ</>لْبَ<q>طْ</>شَةَ <h>ٱ</>لْكُ<q>بْ</>رَ<o>ىٰٓ</> إِ<g>نَّ</>ا مُ<k>نتَ</>قِ<p>مُو</>نَ"},{"n":17,"w":[["۞ وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["فَتَنَّا","fatannā","We tried","আমরা পরীক্ষা করেছি"],["قَبْلَهُمْ","qablahum","before them","তাদের পুর্বে"],["قَوْمَ","qawma","(the) people","জাতিকে"],["فِرْعَوْنَ","fir'‘awna","(of) Firaun","ফিরআউনের"],["وَجَآءَهُمْ","wajāahum","and came to them","এবং তাদের কাছে এসেছিলো"],["رَسُولٌۭ","rasūlun","a Messenger","একজন রাসূল"],["كَرِيمٌ","karīmun","noble","মহান"]],"t":"۞ وَلَقَ<q>دْ</> فَتَ<g>نَّ</>ا قَ<q>بْ</>لَهُمْ قَوْمَ فِرْعَوْنَ وَ<o>جَآ</>ءَهُمْ رَسُو<k>لٌۭ كَ</><p>رِي</>مٌ"},{"n":18,"w":[["أَنْ","an","That","(সে বলেছিলো) যে"],["أَدُّوٓا۟","addū","Deliver","\"তোমরা সমর্পণ করো"],["إِلَىَّ","ilayya","to me","আমার কাছে"],["عِبَادَ","‘ibāda","(the) servants","দাসদেরকে"],["ٱللَّهِ ۖ","l-lahi","(of) Allah","আল্লাহ্‌র"],["إِنِّى","innī","Indeed, I am","নিশ্চয়ই আমি"],["لَكُمْ","lakum","to you","তোমাদের জন্যে"],["رَسُولٌ","rasūlun","a Messenger","রাসূল"],["أَمِينٌۭ","amīnun","trustworthy","বিশ্বস্ত"]],"t":"أَنْ أَ<o>دُّوٓ</><s>ا۟</> إِلَىَّ عِبَادَ <h>ٱ</>للَّهِ ۖ إِ<g>نِّ</>ى لَكُمْ رَسُولٌ أَ<p>مِي</>نٌۭ"},{"n":19,"w":[["وَأَن","wa-an","And that","এবং (এও বলেছিল) যে"],["لَّا","lā","(do) not","না"],["تَعْلُوا۟","ta‘lū","exalt yourselves","বড়াই করো"],["عَلَى","‘alā","against","উপর"],["ٱللَّهِ ۖ","l-lahi","Allah","আল্লাহ্‌র"],["إِنِّىٓ","innī","Indeed, I","আমি নিশ্চয়ই"],["ءَاتِيكُم","ātīkum","[I] have come to you","তোমাদের কাছে এসেছি"],["بِسُلْطَـٰنٍۢ","bisul'ṭānin","with an authority","নিয়ে প্রমাণ"],["مُّبِينٍۢ","mubīnin","clear","সুস্পষ্ট"]],"t":"وَ<w>أَن لَّ</>ا تَعْلُو<s>ا۟</> عَلَى <h>ٱ</>للَّهِ ۖ إِ<g>نِّ</><o>ىٓ</> ءَاتِي<f>كُم بِ</>سُلْ<m>طَٰ</><d>نٍۢ مُّ</><p>بِي</>نٍۢ"},{"n":20,"w":[["وَإِنِّى","wa-innī","And indeed, I","এবং নিশ্চয়ই আমি"],["عُذْتُ","‘udh'tu","[I] seek refuge","আশ্রয় নিয়েছি"],["بِرَبِّى","birabbī","with my Lord","আমার রবের (কাছে)"],["وَرَبِّكُمْ","warabbikum","and your Lord","এবং তোমাদের (প্রকৃত রবের)"],["أَن","an","lest","(এ হ'তে) যে"],["تَرْجُمُونِ","tarjumūni","you stone me","আমাকে তোমরা পাথর মেরে হত্যা করবে"]],"t":"وَإِ<g>نِّ</>ى عُذْتُ بِرَبِّى وَرَبِّكُمْ أَ<k>ن تَ</>رْجُ<p>مُو</>نِ"},{"n":21,"w":[["وَإِن","wa-in","And if","আর যদি"],["لَّمْ","lam","not","না"],["تُؤْمِنُوا۟","tu'minū","you believe","তোমরা ঈমান আনো"],["لِى","lī","me","আমার উপর"],["فَٱعْتَزِلُونِ","fa-i‘'tazilūni","then leave me alone","তবে আমার থেকে দূরে থাকো\""]],"t":"وَ<w>إِن لَّ</>مْ تُؤْمِنُو<s>ا۟</> لِى فَ<h>ٱ</>عْتَزِ<p>لُو</>نِ"},{"n":22,"w":[["فَدَعَا","fada‘ā","So he called","অবশেষে সে ডাকলো"],["رَبَّهُۥٓ","rabbahu","his Lord","তার রবকে"],["أَنَّ","anna","That","\"(এবং বললো) যে"],["هَـٰٓؤُلَآءِ","hāulāi","these","এসব"],["قَوْمٌۭ","qawmun","(are) a people","সম্প্রদায়"],["مُّجْرِمُونَ","muj'rimūna","criminals","অপরাধী (তাদের মীমাংসা করো)\""]],"t":"فَدَعَا رَبَّهُ<o>ۥٓ</> أَ<g>نَّ</> <o>هَٰٓؤُلَآ</>ءِ قَوْ<d>مٌۭ مُّ</><q>جْ</>رِ<p>مُو</>نَ"},{"n":23,"w":[["فَأَسْرِ","fa-asri","Then \"Set out","(বলা হলো) রওনা হও তাহ'লে"],["بِعِبَادِى","bi‘ibādī","with My slaves","আমার দাসদের নিয়ে"],["لَيْلًا","laylan","(by) night","রাতে"],["إِنَّكُم","innakum","Indeed, you","নিশ্চয়ই তোমাদের"],["مُّتَّبَعُونَ","muttaba‘ūna","(will be) followed","পিছনে (ধাওয়া) করা হবে"]],"t":"فَأَسْرِ بِعِبَادِى لَيْلًا إِ<g>نَّ</><y>كُم مُّ</>تَّبَ<p>عُو</>نَ"},{"n":24,"w":[["وَٱتْرُكِ","wa-ut'ruki","And leave","এবং ছেড়ে দাও"],["ٱلْبَحْرَ","l-baḥra","the sea","সাগরকে"],["رَهْوًا ۖ","rahwan","at rest","শান্ত অবস্হায়"],["إِنَّهُمْ","innahum","Indeed, they","তারা নিশ্চয়ই"],["جُندٌۭ","jundun","(are) an army","(অর্থাৎ ধাওয়াকারী) সৈন্যবাহিনী"],["مُّغْرَقُونَ","mugh'raqūna","(to be) drowned","ডুবে যাবে\""]],"t":"وَ<h>ٱ</>تْرُكِ <h>ٱ</>لْبَحْرَ رَهْوًا ۖ إِ<g>نَّ</>هُمْ جُن<d>دٌۭ مُّ</>غْرَ<p>قُو</>نَ"},{"n":25,"w":[["كَمْ","kam","How many","কতই না"],["تَرَكُوا۟","tarakū","(did) they leave","তারা ছেড়েছিলো"],["مِن","min","of","মধ্য হতে"],["جَنَّـٰتٍۢ","jannātin","gardens","বাগান"],["وَعُيُونٍۢ","wa‘uyūnin","and springs","ও ঝর্ণাসমূহ"]],"t":"كَمْ تَرَكُو<s>ا۟</> مِ<k>ن جَ</><g>نَّٰ</><d>تٍۢ وَ</>عُ<p>يُو</>نٍۢ"},{"n":26,"w":[["وَزُرُوعٍۢ","wazurū‘in","And cornfields","এবং শস্যক্ষেত"],["وَمَقَامٍۢ","wamaqāmin","and places","ও বাসস্থান"],["كَرِيمٍۢ","karīmin","noble","সুন্দর"]],"t":"وَزُرُو<d>عٍۢ وَ</>مَقَا<k>مٍۢ كَ</><p>رِي</>مٍۢ"},{"n":27,"w":[["وَنَعْمَةٍۢ","wana‘matin","And pleasant things","এবং বিলাস"],["كَانُوا۟","kānū","they used to","তারা ছিলো"],["فِيهَا","fīhā","therein","যার মধ্যে"],["فَـٰكِهِينَ","fākihīna","take delight","আনন্দকারী (সব ছেড়ে চলে গেলো)"]],"t":"وَنَعْمَ<k>ةٍۢ كَ</>انُو<s>ا۟</> فِيهَا <m>فَٰ</>كِ<p>هِي</>نَ"},{"n":28,"w":[["كَذَٰلِكَ ۖ","kadhālika","Thus","এভাবেই (পরিণাম হয়েছিলো)"],["وَأَوْرَثْنَـٰهَا","wa-awrathnāhā","And We made it (an) inherit(ance)","এবং তার আমরা উত্তরাধিকারী করেছিলাম"],["قَوْمًا","qawman","(for) a people","সম্প্রদায়কে"],["ءَاخَرِينَ","ākharīna","another","অন্য"]],"t":"كَ<m>ذَٰ</>لِكَ ۖ وَأَوْرَثْ<m>نَٰ</>هَا قَوْمًا ءَاخَ<p>رِي</>نَ"},{"n":29,"w":[["فَمَا","famā","And not","না অতঃপর"],["بَكَتْ","bakat","wept","কাঁদলো"],["عَلَيْهِمُ","‘alayhimu","for them","তাদের উপর"],["ٱلسَّمَآءُ","l-samāu","the heaven","আকাশ"],["وَٱلْأَرْضُ","wal-arḍu","and the earth","আর (না) পৃথিবী"],["وَمَا","wamā","and not","এবং না"],["كَانُوا۟","kānū","they were","তারা ছিলো"],["مُنظَرِينَ","munẓarīna","given respite","অবকাশপ্রাপ্ত"]],"t":"فَمَا بَكَتْ عَلَيْهِمُ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءُ وَ<h>ٱ</>لْأَرْضُ وَمَا كَانُو<s>ا۟</> مُ<k>نظَ</><p>رِي</>نَ"},{"n":30,"w":[["وَلَقَدْ","walaqad","And certainly","এবং নিশ্চয়ই"],["نَجَّيْنَا","najjaynā","We saved","আমরা উদ্ধার করেছিলাম"],["بَنِىٓ","banī","(the) Children of Israel","বনী"],["إِسْرَٰٓءِيلَ","is'rāīla","(the) Children of Israel","ইসরাঈলকে"],["مِنَ","mina","from","থেকে"],["ٱلْعَذَابِ","l-‘adhābi","the punishment","শাস্তি"],["ٱلْمُهِينِ","l-muhīni","the humiliating","অপমানজনক"]],"t":"وَلَقَ<q>دْ</> نَجَّيْنَا بَ<o>نِىٓ</> إِسْ<o>رَٰٓ</>ءِيلَ مِنَ <h>ٱ</>لْعَذَابِ <h>ٱ</>لْمُ<p>هِي</>نِ"},{"n":31,"w":[["مِن","min","From","দেওয়া"],["فِرْعَوْنَ ۚ","fir'‘awna","Firaun","ফিরআউনের"],["إِنَّهُۥ","innahu","Indeed, he","সে নিশ্চয়ই"],["كَانَ","kāna","was","ছিলো"],["عَالِيًۭا","‘āliyan","arrogant","পরাক্রান্ত"],["مِّنَ","mina","among","মধ্য হতে"],["ٱلْمُسْرِفِينَ","l-mus'rifīna","the transgressors","সীমালংঘনকারীদের"]],"t":"مِ<k>ن فِ</>رْعَوْنَ ۚ إِ<g>نَّ</>هُ<m>ۥ</> كَانَ عَالِ<d>يًۭا مِّ</>نَ <h>ٱ</>لْمُسْرِ<p>فِي</>نَ"},{"n":32,"w":[["وَلَقَدِ","walaqadi","And certainly","এবং নিশ্চয়ই"],["ٱخْتَرْنَـٰهُمْ","ikh'tarnāhum","We chose them","তাদেরকে (বনী ইসরাঈলকে) আমরা মনোনীত করেছিলাম"],["عَلَىٰ","‘alā","by","ভিত্তিতে"],["عِلْمٍ","‘il'min","knowledge","জ্ঞানের"],["عَلَى","‘alā","over","উপর"],["ٱلْعَـٰلَمِينَ","l-‘ālamīna","the worlds","বিশ্ববাসীর (অন্যান্য জাতির)"]],"t":"وَلَقَدِ <h>ٱ</>خْتَرْ<m>نَٰ</>هُمْ عَلَىٰ عِلْمٍ عَلَى <h>ٱ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":33,"w":[["وَءَاتَيْنَـٰهُم","waātaynāhum","And We gave them","এবং তাদেরকে আমরা দিয়েছিলাম"],["مِّنَ","mina","of","কিছু"],["ٱلْـَٔايَـٰتِ","l-āyāti","the Signs","নিদর্শনাবলী"],["مَا","mā","that","যার"],["فِيهِ","fīhi","in it","মধ্যে ছিলো"],["بَلَـٰٓؤٌۭا۟","balāon","(was) a trial","পরীক্ষা"],["مُّبِينٌ","mubīnun","clear","সুস্পষ্ট"]],"t":"وَءَاتَيْ<m>نَٰ</><y>هُم مِّ</>نَ <h>ٱ</>لْءَا<m>يَٰ</>تِ مَا فِيهِ بَ<o>لَٰٓ</><d>ؤٌۭا۟ مُّ</><p>بِي</>نٌ"},{"n":34,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["هَـٰٓؤُلَآءِ","hāulāi","these","এসব লোক"],["لَيَقُولُونَ","layaqūlūna","surely, they say","অবশ্যই বলে"]],"t":"إِ<g>نَّ</> <o>هَٰٓؤُلَآ</>ءِ لَيَقُو<p>لُو</>نَ"},{"n":35,"w":[["إِنْ","in","Not","\"নেই"],["هِىَ","hiya","it","তা"],["إِلَّا","illā","(is) but","এ ব্যতীত"],["