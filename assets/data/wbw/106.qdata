{"n":106,"a":[{"n":1,"w":[["لِإِيلَـٰفِ","liīlāfi","For (the) familiarity","যেহেতু আসক্তি আছে"],["قُرَيْشٍ","qurayshin","(of the) Quraish","কুরাইশদের"]],"t":"لِإِي<m>لَٰ</>فِ قُ<p>رَيْ</>شٍ"},{"n":2,"w":[["إِۦلَـٰفِهِمْ","īlāfihim","Their familiarity","আসক্তি আছে"],["رِحْلَةَ","riḥ'lata","(with the) journey","ভ্রমণে"],["ٱلشِّتَآءِ","l-shitāi","(of) winter","শীতের"],["وَٱلصَّيْفِ","wal-ṣayfi","and summer","ও গ্রীষ্মের"]],"t":"<m>إِۦلَٰ</>فِهِمْ رِحْلَةَ <h>ٱ</><l>ل</>شِّ<o>تَآ</>ءِ وَ<h>ٱ</><l>ل</><p>صَّيْ</>فِ"},{"n":3,"w":[["فَلْيَعْبُدُوا۟","falya‘budū","So let them worship","অতএব তারা ইবাদত করুক"],["رَبَّ","rabba","(the) Lord","রবের"],["هَـٰذَا","hādhā","(of) this","এই"],["ٱلْبَيْتِ","l-bayti","House","ঘরের"]],"t":"فَلْيَعْبُدُو<s>ا۟</> رَبَّ <m>هَٰ</>ذَا <h>ٱ</>لْ<p>بَيْ</>تِ"},{"n":4,"w":[["ٱلَّذِىٓ","alladhī","The One Who","যিনি"],["أَطْعَمَهُم","aṭ‘amahum","feeds them","তাদেরকে খাবার দিয়েছেন"],["مِّن","min","[from]","হতে"],["جُوعٍۢ","jū‘in","(against) hunger","ক্ষুধা"],["وَءَامَنَهُم","waāmanahum","and gives them security","এবং তাদের নিরাপত্তা দিয়েছেন"],["مِّنْ","min","from","হতে"],["خَوْفٍۭ","khawfin","fear","ভয়"]],"t":"ٱلَّ<o>ذِىٓ</> أَ<q>طْ</>عَمَ<y>هُم مِّ</><k>ن جُ</>و<d>عٍۢ وَ</>ءَامَنَ<y>هُم مِّ</>نْ <p>خَوْ</>فٍۭ"}]}