{"n":52,"a":[{"n":1,"w":[["وَٱلطُّورِ","wal-ṭūri","By the Mount","শপথ তূর (পাহাড়ের)"]],"t":"وَ<h>ٱ</><l>ل</><p>طُّو</>رِ"},{"n":2,"w":[["وَكِتَـٰبٍۢ","wakitābin","And by (the) Book","এবং (শপথ) কিতাবের"],["مَّسْطُورٍۢ","masṭūrin","written","(যা) লিখিত"]],"t":"وَكِ<m>تَٰ</><d>بٍۢ مَّ</>سْ<p>طُو</>رٍۢ"},{"n":3,"w":[["فِى","fī","In","মধ্যে"],["رَقٍّۢ","raqqin","parchment","চামড়ার কাগজের"],["مَّنشُورٍۢ","manshūrin","unrolled","উন্মুক্ত"]],"t":"فِى رَ<d>قٍّۢ مَّ</><k>نشُ</><p>و</>رٍۢ"},{"n":4,"w":[["وَٱلْبَيْتِ","wal-bayti","By the House","এবং (শপথ) ঘরের"],["ٱلْمَعْمُورِ","l-ma‘mūri","frequented","চির আবাদ"]],"t":"وَ<h>ٱ</>لْبَيْتِ <h>ٱ</>لْمَعْ<p>مُو</>رِ"},{"n":5,"w":[["وَٱلسَّقْفِ","wal-saqfi","By the roof","এবং (শপথ) ছাদের (অর্থাৎ আকাশের)"],["ٱلْمَرْفُوعِ","l-marfū‘i","raised high","সুউচ্চ"]],"t":"وَ<h>ٱ</><l>ل</>سَّ<q>قْ</>فِ <h>ٱ</>لْمَرْ<p>فُو</>عِ"},{"n":6,"w":[["وَٱلْبَحْرِ","wal-baḥri","By the sea","এবং (শপথ) সাগরের"],["ٱلْمَسْجُورِ","l-masjūri","filled","উত্তাল"]],"t":"وَ<h>ٱ</>لْبَحْرِ <h>ٱ</>لْمَسْ<p>جُو</>رِ"},{"n":7,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["عَذَابَ","‘adhāba","(the) punishment","শাস্তি"],["رَبِّكَ","rabbika","(of) your Lord","তোমার রবের"],["لَوَٰقِعٌۭ","lawāqi‘un","(will) surely occur","অবশ্যই ঘটবে"]],"t":"إِ<g>نَّ</> عَذَابَ رَبِّكَ لَ<m>وَٰ</>قِعٌۭ"},{"n":8,"w":[["مَّا","mā","Not","নেই"],["لَهُۥ","lahu","for it","তার জন্যে"],["مِن","min","any","কোনো"],["دَافِعٍۢ","dāfi‘in","preventer","প্রতিরোধকারী"]],"t":"مَّا لَهُ<m>ۥ</> مِ<k>ن دَ</>افِعٍۢ"},{"n":9,"w":[["يَوْمَ","yawma","(On the) Day","সেদিন"],["تَمُورُ","tamūru","will shake","কাঁপবে"],["ٱلسَّمَآءُ","l-samāu","the heaven","আকাশ"],["مَوْرًۭا","mawran","(with violent) shake","প্রবল কম্পনে"]],"t":"يَوْمَ تَمُورُ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءُ مَوْرًۭا"},{"n":10,"w":[["وَتَسِيرُ","watasīru","And will move away","এবং চলবে"],["ٱلْجِبَالُ","l-jibālu","the mountains","পাহাড়গুলো"],["سَيْرًۭا","sayran","(with an awful) movement","(দ্রুত) চলার মতো"]],"t":"وَتَسِيرُ <h>ٱ</>لْجِبَالُ سَيْرًۭا"},{"n":11,"w":[["فَوَيْلٌۭ","fawaylun","Then woe","অতঃপর দুর্ভোগ"],["يَوْمَئِذٍۢ","yawma-idhin","that Day","সেদিন"],["لِّلْمُكَذِّبِينَ","lil'mukadhibīna","to the deniers","মিথ্যারোপকারীদের জন্যে"]],"t":"فَوَيْ<d>لٌۭ يَ</>وْمَئِ<w>ذٍۢ لِّ</>لْمُكَذِّ<p>بِي</>نَ"},{"n":12,"w":[["ٱلَّذِينَ","alladhīna","Who","যারা (এমন যে)"],["هُمْ","hum","[they]","তারা"],["فِى","fī","in","মধ্যে"],["خَوْضٍۢ","khawḍin","(vain) discourse","অর্থহীন যুক্তি প্রদানের"],["يَلْعَبُونَ","yal‘abūna","are playing","খেলায় মেতে আছে"]],"t":"ٱلَّذِينَ هُمْ فِى خَوْ<d>ضٍۢ يَ</>لْعَ<p>بُو</>نَ"},{"n":13,"w":[["يَوْمَ","yawma","(The) Day","সেদিন"],["يُدَعُّونَ","yuda‘‘ūna","they will be thrust","তাদেরকে ধাক্কা দেওয়া হবে"],["إِلَىٰ","ilā","(in)to","দিকে"],["نَارِ","nāri","(the) Fire","আগুনের"],["جَهَنَّمَ","jahannama","(of) Hell","জাহান্নামের"],["دَعًّا","da‘‘an","(with) a thrust","জোর ধাক্কা"]],"t":"يَوْمَ يُدَعُّونَ إِلَىٰ نَارِ جَهَ<g>نَّ</>مَ دَعًّا"},{"n":14,"w":[["هَـٰذِهِ","hādhihi","This","\"(বলা হবে) সেই এই"],["ٱلنَّارُ","l-nāru","(is) the Fire","আগুন"],["ٱلَّتِى","allatī","which","যা"],["كُنتُم","kuntum","you used to","তোমরা ছিলে"],["بِهَا","bihā","[of it]","সে বিষয়ে"],["تُكَذِّبُونَ","tukadhibūna","deny","মিথ্যা মনে করতে"]],"t":"<m>هَٰ</>ذِهِ <h>ٱ</><l>ل</><g>نَّ</>ارُ <h>ٱ</>لَّتِى كُ<k>نتُ</><f>م بِ</>هَا تُكَذِّ<p>بُو</>نَ"},{"n":15,"w":[["أَفَسِحْرٌ","afasiḥ'run","Then is this magic","জাদু তবে কি"],["هَـٰذَآ","hādhā","Then is this magic","এটা"],["أَمْ","am","or","নাকি"],["أَنتُمْ","antum","you","তোমরা"],["لَا","lā","(do) not","না"],["تُبْصِرُونَ","tub'ṣirūna","see","চোখে দেখছ"]],"t":"أَفَسِحْرٌ <m>هَٰ</><o>ذَآ</> أَمْ أَ<k>نتُ</>مْ لَا تُ<q>بْ</>صِ<p>رُو</>نَ"},{"n":16,"w":[["ٱصْلَوْهَا","iṣ'lawhā","Burn in it","তাতে তোমরা প্রবেশ করো"],["فَٱصْبِرُوٓا۟","fa-iṣ'birū","then be patient","অতঃপর তোমরা সহ্য করতে পার"],["أَوْ","aw","or","বা"],["لَا","lā","(do) not","না"],["تَصْبِرُوا۟","taṣbirū","be patient","তোমরা সহ্য করতে পার"],["سَوَآءٌ","sawāon","(it is) same","(সবই) সমান"],["عَلَيْكُمْ ۖ","‘alaykum","for you","তোমাদের জন্যে"],["إِنَّمَا","innamā","Only","প্রকৃতপক্ষে (আজ)"],["تُجْزَوْنَ","tuj'zawna","you are being recompensed","তোমাদেরকে প্রতিফল দেয়া হচ্ছে"],["مَا","mā","(for) what","যা"],["كُنتُمْ","kuntum","you used to","তোমরা ছিলে"],["تَعْمَلُونَ","ta‘malūna","do","কাজ করছ\""]],"t":"ٱصْلَوْهَا فَ<h>ٱ</>صْبِ<o>رُوٓ</><s>ا۟</> أَوْ لَا تَصْبِرُو<s>ا۟</> سَ<o>وَآ</>ءٌ عَلَيْكُمْ ۖ إِ<g>نَّ</>مَا تُ<q>جْ</>زَوْنَ مَا كُ<k>نتُ</>مْ تَعْمَ<p>لُو</>نَ"},{"n":17,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلْمُتَّقِينَ","l-mutaqīna","the righteous","মুত্তাকীরা (অবস্থিত হবে)"],["فِى","fī","(will be) in","মধ্যে"],["جَنَّـٰتٍۢ","jannātin","Gardens","জান্নাতের"],["وَنَعِيمٍۢ","wana‘īmin","and pleasure","ও আরাম আয়েশে"]],"t":"إِ<g>نَّ</> <h>ٱ</>لْمُتَّقِينَ فِى جَ<g>نَّٰ</><d>تٍۢ وَ</>نَ<p>عِي</>مٍۢ"},{"n":18,"w":[["فَـٰكِهِينَ","fākihīna","Enjoying","সানন্দে উপভোগকারী হবে তারা"],["بِمَآ","bimā","in what","ঐ জিনিসের যা"],["ءَاتَىٰهُمْ","ātāhum","has given them","তাদের দান করবেন"],["رَبُّهُمْ","rabbuhum","their Lord","তাদের রব"],["وَوَقَىٰهُمْ","wawaqāhum","and protected them","এবং তাদের রক্ষা করবেন"],["رَبُّهُمْ","rabbuhum","their Lord","তাদের রব"],["عَذَابَ","‘adhāba","(from the) punishment","শাস্তি (হতে)"],["ٱلْجَحِيمِ","l-jaḥīmi","(of) Hellfire","জাহান্নামের"]],"t":"<m>فَٰ</>كِهِينَ بِ<o>مَآ</> ءَاتَ<m>ىٰ</>هُمْ رَبُّهُمْ وَوَقَ<m>ىٰ</>هُمْ رَبُّهُمْ عَذَابَ <h>ٱ</>لْجَ<p>حِي</>مِ"},{"n":19,"w":[["كُلُوا۟","kulū","Eat","\"(বলা হবে) তোমরা খাও"],["وَٱشْرَبُوا۟","wa-ish'rabū","and drink","ও তোমরা পান করো"],["هَنِيٓـًٔۢا","hanīan","(in) satisfaction","তৃপ্তির সাথে"],["بِمَا","bimā","for what","তার বদলে যা"],["كُنتُمْ","kuntum","you used to","তোমরা করছিলে"],["تَعْمَلُونَ","ta‘malūna","do","তোমরা কাজ করছিলে\""]],"t":"كُلُو<s>ا۟</> وَ<h>ٱ</>شْرَبُو<s>ا۟</> هَنِ<o>يٓـًٔۢ</><i>ا بِ</>مَا كُ<k>نتُ</>مْ تَعْمَ<p>لُو</>نَ"},{"n":20,"w":[["مُتَّكِـِٔينَ","muttakiīna","Reclining","তারা হেলান দিয়ে বসবে"],["عَلَىٰ","‘alā","on","উপর"],["سُرُرٍۢ","sururin","thrones","আসনসমূহের"],["مَّصْفُوفَةٍۢ ۖ","maṣfūfatin","lined up","সারিবদ্ধভাবে"],["وَزَوَّجْنَـٰهُم","wazawwajnāhum","and We will marry them","এবং তাদেরকে আমরা বিয়ে দিব"],["بِحُورٍ","biḥūrin","to fair ones","হূরদের সাথে"],["عِينٍۢ","‘īnin","(with) large eyes","(যারা হবে) আয়তলোচনা"]],"t":"مُتَّكِـِٔينَ عَلَىٰ سُرُ<d>رٍۢ مَّ</>صْفُوفَ<d>ةٍۢ ۖ وَ</>زَوَّ<q>جْ</><m>نَٰ</><f>هُم بِ</>حُورٍ <p>عِي</>نٍۢ"},{"n":21,"w":[["وَٱلَّذِينَ","wa-alladhīna","And those who","এবং যারা"],["ءَامَنُوا۟","āmanū","believed","ঈমান এনেছে"],["وَٱتَّبَعَتْهُمْ","wa-ittaba‘athum","and followed them","ও তাদেরকে অনুসরণ করেছে"],["ذُرِّيَّتُهُم","dhurriyyatuhum","their offspring","তাদের সন্তানরা"],["بِإِيمَـٰنٍ","biīmānin","in faith","ঈমানসহ"],["أَلْحَقْنَا","alḥaqnā","We will join","আমরা মিলিত করব"],["بِهِمْ","bihim","with them","তাদের সাথে"],["ذُرِّيَّتَهُمْ","dhurriyyatahum","their offspring","তাদের সন্তানদেরকে"],["وَمَآ","wamā","and not","এবং না"],["أَلَتْنَـٰهُم","alatnāhum","We will deprive them","তাদের আমরা কম করব"],["مِّنْ","min","of","হতে"],["عَمَلِهِم","‘amalihim","their deeds","তাদের আমল"],["مِّن","min","(in) any","কোনো"],["شَىْءٍۢ ۚ","shayin","thing","কিছুই"],["كُلُّ","kullu","Every","প্রত্যেক"],["ٱمْرِئٍۭ","im'ri-in","person","ব্যক্তি"],["بِمَا","bimā","for what","ঐ বিষয়ে যা"],["كَسَبَ","kasaba","he earned","সে অর্জন করেছে"],["رَهِينٌۭ","rahīnun","(is) pledged","দায়ী/ বন্ধক (আছে)"]],"t":"وَ<h>ٱ</>لَّذِينَ ءَامَنُو<s>ا۟</> وَ<h>ٱ</>تَّبَعَتْهُمْ ذُرِّيَّتُ<f>هُم بِ</>إِي<m>مَٰ</>نٍ أَلْحَ<q>قْ</>نَا بِهِمْ ذُرِّيَّتَهُمْ وَ<o>مَآ</> أَلَتْ<m>نَٰ</><y>هُم مِّ</>نْ عَمَلِ<y>هِم مِّ</><k>ن شَىْءٍۢ ۚ كُ</>لُّ <h>ٱ</>مْرِ<i>ئٍۭ بِ</>مَا كَسَبَ رَ<p>هِي</>نٌۭ"},{"n":22,"w":[["وَأَمْدَدْنَـٰهُم","wa-amdadnāhum","And We will provide them","এবং তাদেরকে আমরা বেশি করে দেব"],["بِفَـٰكِهَةٍۢ","bifākihatin","with fruit","ফল মূল"],["وَلَحْمٍۢ","walaḥmin","and meat","ও গোশত"],["مِّمَّا","mimmā","from what","তা হতে যা"],["يَشْتَهُونَ","yashtahūna","they desire","তারা পছন্দ করবে"]],"t":"وَأَمْدَ<q>دْ</><m>نَٰ</><f>هُم بِ</><m>فَٰ</>كِهَ<d>ةٍۢ وَ</>لَحْ<d>مٍۢ مِّ</><g>مَّ</>ا يَشْتَ<p>هُو</>نَ"},{"n":23,"w":[["يَتَنَـٰزَعُونَ","yatanāza‘ūna","They will pass to one another","তারা পরস্পরে নেবে"],["فِيهَا","fīhā","therein","তার মধ্যে"],["كَأْسًۭا","kasan","a cup","পানপাত্র"],["لَّا","lā","no","না"],["لَغْوٌۭ","laghwun","ill speech","অসার কথা (হবে)"],["فِيهَا","fīhā","therein","তার মধ্যে"],["وَلَا","walā","and no","এবং না"],["تَأْثِيمٌۭ","tathīmun","sin","পাপকর্ম"]],"t":"يَتَ<m>نَٰ</>زَعُونَ فِيهَا كَأْ<w>سًۭا لَّ</>ا لَغْ<k>وٌۭ فِ</>يهَا وَلَا تَأْ<p>ثِي</>مٌۭ"},{"n":24,"w":[["۞ وَيَطُوفُ","wayaṭūfu","And will circulate","এবং ঘুরতে থাকবে"],["عَلَيْهِمْ","‘alayhim","among them","তাদের কাছে"],["غِلْمَانٌۭ","ghil'mānun","boys","কিশোরেরা (সেবা করতে)"],["لَّهُمْ","lahum","for them","তাদের জন্যে"],["كَأَنَّهُمْ","ka-annahum","as if they (were)","(এত সুন্দর হবে) তারা যেন"],["لُؤْلُؤٌۭ","lu'lu-on","pearls","মুক্তা"],["مَّكْنُونٌۭ","maknūnun","well-protected","লুকিয়ে রাখা"]],"t":"۞ وَيَطُوفُ عَلَيْهِمْ غِلْمَا<w>نٌۭ لَّ</>هُمْ كَأَ<g>نَّ</>هُمْ لُؤْلُ<d>ؤٌۭ مَّ</>كْ<p>نُو</>نٌۭ"},{"n":25,"w":[["وَأَقْبَلَ","wa-aqbala","And will approach","এবং সামনাসামনি হয়ে"],["بَعْضُهُمْ","ba‘ḍuhum","some of them","তাদের একে"],["عَلَىٰ","‘alā","to","কাছে"],["بَعْضٍۢ","ba‘ḍin","others","অপরের"],["يَتَسَآءَلُونَ","yatasāalūna","inquiring","পরস্পরের জিজ্ঞাসাবাদ করবে (অতীত সম্পর্কে)"]],"t":"وَأَ<q>قْ</>بَلَ بَعْضُهُمْ عَلَىٰ بَعْ<d>ضٍۢ يَ</>تَ<o>سَآ</>ءَ<p>لُو</>نَ"},{"n":26,"w":[["قَالُوٓا۟","qālū","They will say","তারা বলবে"],["إِنَّا","innā","Indeed, we","\"নিশ্চয়ই আমরা"],["كُنَّا","kunnā","[we] were","ছিলাম"],["قَبْلُ","qablu","before","পূর্বে"],["فِىٓ","fī","among","মধ্যে"],["أَهْلِنَا","ahlinā","our families","আমাদের পরিবারের"],["مُشْفِقِينَ","mush'fiqīna","fearful","শঙ্কিত অবস্থায়"]],"t":"قَا<o>لُوٓ</><s>ا۟</> إِ<g>نَّ</>ا كُ<g>نَّ</>ا قَ<q>بْ</>لُ <o>فِىٓ</> أَهْلِنَا مُشْفِ<p>قِي</>نَ"},{"n":27,"w":[["فَمَنَّ","famanna","But Allah conferred favor","অবশেষে অনুগ্রহ করেছেন"],["ٱللَّهُ","l-lahu","But Allah conferred favor","আল্লাহ"],["عَلَيْنَا","‘alaynā","upon us","আমাদের উপর"],["وَوَقَىٰنَا","wawaqānā","and protected us","এবং আমাদেরকে রক্ষা করেছেন"],["عَذَابَ","‘adhāba","(from the) punishment","শাস্তি (হতে)"],["ٱلسَّمُومِ","l-samūmi","(of) the Scorching Fire","দগ্ধকারী হাওয়ার (যা ঝলসে দেয়)"]],"t":"فَمَ<g>نَّ</> <h>ٱ</>للَّهُ عَلَيْنَا وَوَقَ<m>ىٰ</>نَا عَذَابَ <h>ٱ</><l>ل</>سَّ<p>مُو</>مِ"},{"n":28,"w":[["إِنَّا","innā","Indeed, we","নিশ্চয়ই আমরা"],["كُنَّا","kunnā","[we] used to","ছিলাম"],["مِن","min","before","থেকে"],["قَبْلُ","qablu","before","পূর্বেও"],["نَدْعُوهُ ۖ","nad‘ūhu","call Him","তাঁকে ডাকতাম আমরা"],["إِنَّهُۥ","innahu","Indeed, He","নিশ্চয়ই তিনি"],["هُوَ","huwa","[He]","তিনিই"],["ٱلْبَرُّ","l-baru","(is) the Most Kind","বড় অনুগ্রহকারী"],["ٱلرَّحِيمُ","l-raḥīmu","the Most Merciful","পরম দয়ালু\""]],"t":"إِ<g>نَّ</>ا كُ<g>نَّ</>ا مِ<k>ن قَ</><q>بْ</>لُ نَ<q>دْ</>عُوهُ ۖ إِ<g>نَّ</>هُ<m>ۥ</> هُوَ <h>ٱ</>لْبَرُّ <h>ٱ</><l>ل</>رَّ<p>حِي</>مُ"},{"n":29,"w":[["فَذَكِّرْ","fadhakkir","Therefore remind","(হে নবী) তাই উপদেশ দাও"],["فَمَآ","famā","for not","না আর"],["أَنتَ","anta","you","তুমি"],["بِنِعْمَتِ","bini‘'mati","(are) by (the) grace","অনুগ্রহের কারণে"],["رَبِّكَ","rabbika","(of) your Lord","তোমার রবের"],["بِكَاهِنٍۢ","bikāhinin","a soothsayer","কোনো গণক"],["وَلَا","walā","and not","আর না"],["مَجْنُونٍ","majnūnin","a madman","পাগল"]],"t":"فَذَكِّرْ فَ<o>مَآ</> أَ<k>نتَ</> بِنِعْمَتِ رَبِّكَ بِكَاهِ<d>نٍۢ وَ</>لَا مَ<q>جْ</><p>نُو</>نٍ"},{"n":30,"w":[["أَمْ","am","Or","কি"],["يَقُولُونَ","yaqūlūna","(do) they say","তারা বলে"],["شَاعِرٌۭ","shā‘irun","A poet","\"(সে) একজন কবি"],["نَّتَرَبَّصُ","natarabbaṣu","we wait","অপেক্ষা করছি আমরা"],["بِهِۦ","bihi","for him","এ ব্যাপারে"],["رَيْبَ","rayba","a misfortune of time","বিপর্যয়ের\""],["ٱلْمَنُونِ","l-manūni","a misfortune of time","মৃত্যুর\""]],"t":"أَمْ يَقُولُونَ شَاعِ<d>رٌۭ نَّ</>تَرَبَّصُ بِ<m>هِۦ</> رَيْبَ <h>ٱ</>لْمَ<p>نُو</>نِ"},{"n":31,"w":[["قُلْ","qul","Say","(তুমি) বলো"],["تَرَبَّصُوا۟","tarabbaṣū","Wait","\"তোমরা অপেক্ষা করো"],["فَإِنِّى","fa-innī","for indeed I am","আর নিশ্চয়ই আমি"],["مَعَكُم","ma‘akum","with you","তোমাদের সাথে"],["مِّنَ","mina","among","অন্তর্ভুক্ত"],["ٱلْمُتَرَبِّصِينَ","l-mutarabiṣīna","those who wait","অপেক্ষাকারীদের\""]],"t":"قُلْ تَرَبَّصُو<s>ا۟</> فَإِ<g>نِّ</>ى مَعَ<y>كُم مِّ</>نَ <h>ٱ</>لْمُتَرَبِّ<p>صِي</>نَ"},{"n":32,"w":[["أَمْ","am","Or","(তবে) কি"],["تَأْمُرُهُمْ","tamuruhum","command them","নির্দেশ দেয় তাদেরকে"],["أَحْلَـٰمُهُم","aḥlāmuhum","their minds","তাদের বিবেকবুদ্ধি"],["بِهَـٰذَآ ۚ","bihādhā","this","এটা সম্বন্ধে"],["أَمْ","am","or","না কি (প্রকৃতপক্ষে)"],["هُمْ","hum","they","তারা"],["قَوْمٌۭ","qawmun","(are) a people","জাতি"],["طَاغُونَ","ṭāghūna","transgressing","সীমালঙ্ঘনকারী"]],"t":"أَمْ تَأْمُرُهُمْ أَحْ<m>لَٰ</>مُ<f>هُم بِ</><m>هَٰ</><o>ذَآ ۚ</> أَمْ هُمْ قَوْ<k>مٌۭ طَ</>ا<p>غُو</>نَ"},{"n":33,"w":[["أَمْ","am","Or","কি"],["يَقُولُونَ","yaqūlūna","(do) they say","তারা বলে"],["تَقَوَّلَهُۥ ۚ","taqawwalahu","He has made it up","\"তা সে রচনা করেছে\""],["بَل","bal","Nay","আসল কথা হল"],["لَّا","lā","not","না"],["يُؤْمِنُونَ","yu'minūna","they believe","তারা ঈমান আনতে চায়"]],"t":"أَمْ يَقُولُونَ تَقَوَّلَهُ<m>ۥ</> ۚ بَل لَّا يُؤْمِ<p>نُو</>نَ"},{"n":34,"w":[["فَلْيَأْتُوا۟","falyatū","Then let them bring","তারা আনুক তাহলে  (রচনা করে)"],["بِحَدِيثٍۢ","biḥadīthin","a statement","নিয়ে কোনো বাণী"],["مِّثْلِهِۦٓ","mith'lihi","like it","তার মতো (মর্যাদাবান)"],["إِن","in","if","যদি"],["كَانُوا۟","kānū","they are","তারা হয়"],["صَـٰدِقِينَ","ṣādiqīna","truthful","সত্যবাদী"]],"t":"فَلْيَأْتُو<s>ا۟</> بِحَدِي<d>ثٍۢ مِّ</>ثْلِ<o>هِۦٓ</> إِ<k>ن كَ</>انُو<s>ا۟</> <m>صَٰ</>دِ<p>قِي</>نَ"},{"n":35,"w":[["أَمْ","am","Or","কি"],["خُلِقُوا۟","khuliqū","they were created","তারা সৃষ্টি হয়েছে"],["مِنْ","min","of","কোনো"],["غَيْرِ","ghayri","nothing","ব্যতীতই"],["شَىْءٍ","shayin","nothing","কিছু (কোনো স্রষ্টা)"],["أَمْ","am","or","অথবা"],["هُمُ","humu","(are) they","তারা (নিজেরাই)"],["ٱلْخَـٰلِقُونَ","l-khāliqūna","the creators","(নিজেদের) সৃষ্টিকারী"]],"t":"أَمْ خُلِقُو<s>ا۟</> مِنْ غَيْرِ شَىْءٍ أَمْ هُمُ <h>ٱ</>لْ<m>خَٰ</>لِ<p>قُو</>نَ"},{"n":36,"w":[["أَمْ","am","Or","অথবা"],["خَلَقُوا۟","khalaqū","(did) they create","তারা সৃষ্টি করেছে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশ"],["وَٱلْأَرْضَ ۚ","wal-arḍa","and the earth","ও পৃথিবী"],["بَل","bal","Nay","বরং"],["لَّا","lā","not","না"],["يُوقِنُونَ","yūqinūna","they are certain","(কোনো কথায়) তারা বিশ্বাস করে"]],"t":"أَمْ خَلَقُو<s>ا۟</> <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضَ ۚ بَل لَّا يُوقِ<p>نُو</>نَ"},{"n":37,"w":[["أَمْ","am","Or","তবে কি"],["عِندَهُمْ","‘indahum","with them","তাদের আছে"],["خَزَآئِنُ","khazāinu","(are the) treasures","ধনভাণ্ডারসমূহ"],["رَبِّكَ","rabbika","(of) your Lord","তোমার রবের"],["أَمْ","am","or","নাকি"],["هُمُ","humu","(are) they","তারা"],["ٱلْمُصَۣيْطِرُونَ","l-muṣayṭirūna","the controllers","(তার উপর) নিয়ন্তা"]],"t":"أَمْ عِ<k>ندَ</>هُمْ خَ<o>زَآ</>ئِنُ رَبِّكَ أَمْ هُمُ <h>ٱ</>لْمُصَۣيْطِ<p>رُو</>نَ"},{"n":38,"w":[["أَمْ","am","Or","তবে কি"],["لَهُمْ","lahum","for them","তাদের আছে"],["سُلَّمٌۭ","sullamun","(is) a stairway","কোনো সিঁড়ি"],["يَسْتَمِعُونَ","yastami‘ūna","they listen","(তা চড়ে গোপন খবর) তারা শুনে নেয়"],["فِيهِ ۖ","fīhi","therewith","সেখানকার"],["فَلْيَأْتِ","falyati","Then let bring","আসুক তাহলে"],["مُسْتَمِعُهُم","mus'tami‘uhum","their listener","তাদের কোনো শ্রোতা"],["بِسُلْطَـٰنٍۢ","bisul'ṭānin","an authority","নিয়ে প্রমাণসহ"],["مُّبِينٍ","mubīnin","clear","সুস্পষ্ট"]],"t":"أَمْ لَهُمْ سُلَّ<d>مٌۭ يَ</>سْتَمِعُونَ فِيهِ ۖ فَلْيَأْتِ مُسْتَمِعُ<f>هُم بِ</>سُلْ<m>طَٰ</><d>نٍۢ مُّ</><p>بِي</>نٍ"},{"n":39,"w":[["أَمْ","am","Or","না কি"],["لَهُ","lahu","for Him","তাঁর জন্যে (নির্ধারণ করে)"],["ٱلْبَنَـٰتُ","l-banātu","(are) daughters","কন্যাসমূহ"],["وَلَكُمُ","walakumu","while for you","ও তোমাদের জন্যে (চাও)"],["ٱلْبَنُونَ","l-banūna","(are) sons","পুত্রসমূহ"]],"t":"أَمْ لَهُ <h>ٱ</>لْبَ<m>نَٰ</>تُ وَلَكُمُ <h>ٱ</>لْبَ<p>نُو</>نَ"},{"n":40,"w":[["أَمْ","am","Or","তবে কি"],["تَسْـَٔلُهُمْ","tasaluhum","(do) you ask from them","তাদের কাছে চাচ্ছ তুমি"],["أَجْرًۭا","ajran","a payment","কোনো পারিশ্রমিক"],["فَهُم","fahum","so they","তারা তাই"],["مِّن","min","from","কারণে"],["مَّغْرَمٍۢ","maghramin","a debt","জরিমানার"],["مُّثْقَلُونَ","muth'qalūna","(are) overburdened","ভারগ্রস্ত হয়ে আছে"]],"t":"أَمْ تَسْـَٔلُهُمْ أَ<q>جْ</><k>رًۭا فَ</><y>هُم مِّ</><d>ن مَّ</>غْرَ<d>مٍۢ مُّ</>ثْقَ<p>لُو</>نَ"},{"n":41,"w":[["أَمْ","am","Or","নাকি"],["عِندَهُمُ","‘indahumu","with them","আছে তাদের কাছে"],["ٱلْغَيْبُ","l-ghaybu","(is) the unseen","অদৃশ্যের জ্ঞান"],["فَهُمْ","fahum","so they","তারা ফলে"],["يَكْتُبُونَ","yaktubūna","write (it) down","লিখে দিতে পারে"]],"t":"أَمْ عِ<k>ندَ</>هُمُ <h>ٱ</>لْغَيْبُ فَهُمْ يَكْتُ<p>بُو</>نَ"},{"n":42,"w":[["أَمْ","am","Or","তবে কি"],["يُرِيدُونَ","yurīdūna","(do) they intend","তারা চাচ্ছে"],["كَيْدًۭا ۖ","kaydan","a plot","কোনো ষড়যন্ত্র (করতে)"],["فَٱلَّذِينَ","fa-alladhīna","But those who","যারা তাহলে"],["كَفَرُوا۟","kafarū","disbelieve","অস্বীকার করেছে"],["هُمُ","humu","themselves","তারাই"],["ٱلْمَكِيدُونَ","l-makīdūna","(are in) the plot","ষড়যন্ত্রের শিকার হবে"]],"t":"أَمْ يُرِيدُونَ كَيْ<k>دًۭا ۖ فَ</><h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> هُمُ <h>ٱ</>لْمَكِي<p>دُو</>نَ"},{"n":43,"w":[["أَمْ","am","Or","নাকি"],["لَهُمْ","lahum","for them","তাদের আছে"],["إِلَـٰهٌ","ilāhun","a god","কোনো উপাস্য"],["غَيْرُ","ghayru","other than","ব্যতীত"],["ٱللَّهِ ۚ","l-lahi","Allah","আল্লাহ"],["سُبْحَـٰنَ","sub'ḥāna","Glory be","মহান পবিত্র"],["ٱللَّهِ","l-lahi","(to) Allah","আল্লাহ"],["عَمَّا","‘ammā","from what","তা হতে যার"],["يُشْرِكُونَ","yush'rikūna","they associate (with Him)","তারা শরিক করছে"]],"t":"أَمْ لَهُمْ إِ<m>لَٰ</>هٌ غَيْرُ <h>ٱ</>للَّهِ ۚ سُ<q>بْ</><m>حَٰ</>نَ <h>ٱ</>للَّهِ عَ<g>مَّ</>ا يُشْرِ<p>كُو</>نَ"},{"n":44,"w":[["وَإِن","wa-in","And if","এবং যদি"],["يَرَوْا۟","yaraw","they were to see","তারা দেখে"],["كِسْفًۭا","kis'fan","a portion","এক অংশ"],["مِّنَ","mina","from","হতে"],["ٱلسَّمَآءِ","l-samāi","the sky","আকাশ"],["سَاقِطًۭا","sāqiṭan","falling","ভেঙে পড়তে"],["يَقُولُوا۟","yaqūlū","they will say","(তবুও) তারা বলবে"],["سَحَابٌۭ","saḥābun","Clouds","\"(সেটা) মেঘ"],["مَّرْكُومٌۭ","markūmun","heaped up","পুঞ্জীভূত\""]],"t":"وَ<d>إِن يَ</>رَوْ<s>ا۟</> كِسْ<d>فًۭا مِّ</>نَ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ سَاقِ<d>طًۭا يَ</>قُولُو<s>ا۟</> سَحَا<d>بٌۭ مَّ</>رْ<p>كُو</>مٌۭ"},{"n":45,"w":[["فَذَرْهُمْ","fadharhum","So leave them","(হে নবী) অতএব তাদেরকে ছেড়ে দাও"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["يُلَـٰقُوا۟","yulāqū","they meet","তারা সাক্ষাৎ করবে"],["يَوْمَهُمُ","yawmahumu","their Day","তাদের সেই দিনের"],["ٱلَّذِى","alladhī","which","যা (এমন যে)"],["فِيهِ","fīhi","in it","তার মধ্যে"],["يُصْعَقُونَ","yuṣ'‘aqūna","they will faint","তাদেরকে শাস্তির মধ্যে নিক্ষেপ করা হবে"]],"t":"فَذَرْهُمْ حَتَّىٰ يُ<m>لَٰ</>قُو<s>ا۟</> يَوْمَهُمُ <h>ٱ</>لَّذِى فِيهِ يُصْعَ<p>قُو</>نَ"},{"n":46,"w":[["يَوْمَ","yawma","(The) Day","সেদিন"],["لَا","lā","not","না"],["يُغْنِى","yugh'nī","will avail","কাজে আসবে"],["عَنْهُمْ","‘anhum","to them","তাদের জন্যে"],["كَيْدُهُمْ","kayduhum","their plotting","তাদের ষড়যন্ত্র"],["شَيْـًۭٔا","shayan","(in) anything","কিছুমাত্রও"],["وَلَا","walā","and not","এবং না"],["هُمْ","hum","they","তাদের"],["يُنصَرُونَ","yunṣarūna","will be helped","সাহায্য করা হবে"]],"t":"يَوْمَ لَا يُغْنِى عَنْهُمْ كَيْدُهُمْ شَ<d>يْـًۭٔا وَ</>لَا هُمْ يُ<k>نصَ</><p>رُو</>نَ"},{"n":47,"w":[["وَإِنَّ","wa-inna","And indeed","এবং নিশ্চয়ই"],["لِلَّذِينَ","lilladhīna","for those who","(তাদের) জন্যে যারা"],["ظَلَمُوا۟","ẓalamū","do wrong","সীমালঙ্ঘন করেছে"],["عَذَابًۭا","‘adhāban","(is) a punishment","শাস্তি (রয়েছে)"],["دُونَ","dūna","before","ছাড়াও"],["ذَٰلِكَ","dhālika","that","এটা"],["وَلَـٰكِنَّ","walākinna","but","কিন্তু"],["أَكْثَرَهُمْ","aktharahum","most of them","তাদের অধিকাংশই"],["لَا","lā","(do) not","না"],["يَعْلَمُونَ","ya‘lamūna","know","তারা জানে"]],"t":"وَإِ<g>نَّ</> لِلَّذِينَ ظَلَمُو<s>ا۟</> عَذَا<k>بًۭا دُ</>ونَ <m>ذَٰ</>لِكَ وَ<m>لَٰ</>كِ<g>نَّ</> أَكْثَرَهُمْ لَا يَعْلَ<p>مُو</>نَ"},{"n":48,"w":[["وَٱصْبِرْ","wa-iṣ'bir","So be patient","এবং (হে নবী) ধৈর্য ধর"],["لِحُكْمِ","liḥuk'mi","for (the) Command","সিদ্ধান্তের জন্যে"],["رَبِّكَ","rabbika","(of) your Lord","তোমার রবের"],["فَإِنَّكَ","fa-innaka","for indeed, you","অতঃপর তুমি নিশ্চয়ই"],["بِأَعْيُنِنَا ۖ","bi-a‘yuninā","(are) in Our Eyes","আমাদের চোখে (আছ)"],["وَسَبِّحْ","wasabbiḥ","And glorify","এবং পবিত্রতা ঘোষণা করো"],["بِحَمْدِ","biḥamdi","(the) praise","প্রশংসার সাথে"],["رَبِّكَ","rabbika","(of) your Lord","তোমার রবের"],["حِينَ","ḥīna","when","যখন"],["تَقُومُ","taqūmu","you arise","তুমি উঠবে"]],"t":"وَ<h>ٱ</>صْبِرْ لِحُكْمِ رَبِّكَ فَإِ<g>نَّ</>كَ بِأَعْيُنِنَا ۖ وَسَبِّحْ بِحَمْدِ رَبِّكَ حِينَ تَ<p>قُو</>مُ"},{"n":49,"w":[["وَمِنَ","wamina","And of","এবং কিছু অংশে"],["ٱلَّيْلِ","al-layli","the night","রাতের"],["فَسَبِّحْهُ","fasabbiḥ'hu","glorify Him","অতঃপর তার পবিত্র মহিমা ঘোষণা করো"],["وَإِدْبَـٰرَ","wa-id'bāra","and after","এবং অস্তগমনেও"],["ٱلنُّجُومِ","l-nujūmi","the stars","তারাদের"]],"t":"وَمِنَ <h>ٱ</>لَّيْلِ فَسَبِّحْهُ وَإِ<q>دْ</><m>بَٰ</>رَ <h>ٱ</><l>ل</><g>نُّ</><p>جُو</>مِ"}]}