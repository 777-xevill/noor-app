{"n":114,"a":[{"n":1,"w":[["قُلْ","qul","Say","বলো"],["أَعُوذُ","a‘ūdhu","I seek refuge","\"আমি আশ্রয় চাই"],["بِرَبِّ","birabbi","in (the) Lord","রবের নিকট"],["ٱلنَّاسِ","l-nāsi","(of) mankind","মানুষের"]],"t":"قُلْ أَعُوذُ بِرَبِّ <h>ٱ</><l>ل</><g>نَّ</><p>ا</>سِ"},{"n":2,"w":[["مَلِكِ","maliki","(The) King","মহা অধিপতির (নিকট)"],["ٱلنَّاسِ","l-nāsi","(of) mankind","মানুষের"]],"t":"مَلِكِ <h>ٱ</><l>ل</><g>نَّ</><p>ا</>سِ"},{"n":3,"w":[["إِلَـٰهِ","ilāhi","(The) God","ইলাহ্‌র (নিকট)"],["ٱلنَّاسِ","l-nāsi","(of) mankind","মানুষের"]],"t":"إِ<m>لَٰ</>هِ <h>ٱ</><l>ل</><g>نَّ</><p>ا</>سِ"},{"n":4,"w":[["مِن","min","From","হতে"],["شَرِّ","sharri","(the) evil","অমঙ্গল"],["ٱلْوَسْوَاسِ","l-waswāsi","(of) the whisperer","কুমন্ত্রণার"],["ٱلْخَنَّاسِ","l-khanāsi","the one who withdraws","আত্নগোপনকারী"]],"t":"مِ<k>ن شَ</>رِّ <h>ٱ</>لْوَسْوَاسِ <h>ٱ</>لْخَ<g>نَّ</><p>ا</>سِ"},{"n":5,"w":[["ٱلَّذِى","alladhī","The one who","যে"],["يُوَسْوِسُ","yuwaswisu","whispers","কুমন্ত্রণা দেয়"],["فِى","fī","in","মধ্যে"],["صُدُورِ","ṣudūri","(the) breasts","অন্তরসমূহের"],["ٱلنَّاسِ","l-nāsi","(of) mankind","মানুষের"]],"t":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ <h>ٱ</><l>ل</><g>نَّ</><p>ا</>سِ"},{"n":6,"w":[["مِنَ","mina","From","মধ্য হতে"],["ٱلْجِنَّةِ","l-jinati","the jinn","জিনের"],["وَٱلنَّاسِ","wal-nāsi","and men","ও মানুষের"]],"t":"مِنَ <h>ٱ</>لْجِ<g>نَّ</>ةِ وَ<h>ٱ</><l>ل</><g>نَّ</><p>ا</>سِ"}]}