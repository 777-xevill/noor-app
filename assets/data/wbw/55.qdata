{"n":55,"a":[{"n":1,"w":[["ٱلرَّحْمَـٰنُ","al-raḥmānu","The Most Gracious","অশেষ দয়ালু (আল্লাহ্‌)"]],"t":"ٱ<l>ل</>رَّحْ<p>مَٰ</>نُ"},{"n":2,"w":[["عَلَّمَ","‘allama","He taught","শিক্ষা দিয়েছেন"],["ٱلْقُرْءَانَ","l-qur'āna","the Quran","(এই) কুরআন"]],"t":"عَلَّمَ <h>ٱ</>لْقُرْ<p>ءَا</>نَ"},{"n":3,"w":[["خَلَقَ","khalaqa","He created","তিনি সৃষ্টি করেছেন"],["ٱلْإِنسَـٰنَ","l-insāna","[the] man","মানুষকে"]],"t":"خَلَقَ <h>ٱ</>لْإِ<k>نسَٰ</>نَ"},{"n":4,"w":[["عَلَّمَهُ","‘allamahu","He taught him","তাকে শিখিয়েছেন"],["ٱلْبَيَانَ","l-bayāna","[the] speech","ভাব প্রকাশ করতে"]],"t":"عَلَّمَهُ <h>ٱ</>لْبَ<p>يَا</>نَ"},{"n":5,"w":[["ٱلشَّمْسُ","al-shamsu","The sun","সূর্য"],["وَٱلْقَمَرُ","wal-qamaru","and the moon","ও চাঁদ"],["بِحُسْبَانٍۢ","biḥus'bānin","by (precise) calculation","একটি হিসাব অনুসরণ করেই চলে"]],"t":"ٱ<l>ل</>شَّمْسُ وَ<h>ٱ</>لْقَمَرُ بِحُسْ<p>بَا</>نٍۢ"},{"n":6,"w":[["وَٱلنَّجْمُ","wal-najmu","And the stars","এবং তারকা"],["وَٱلشَّجَرُ","wal-shajaru","and the trees","ও গাছপালা"],["يَسْجُدَانِ","yasjudāni","both prostrate","উভয়ে সিজদারত"]],"t":"وَ<h>ٱ</><l>ل</><g>نَّ</><q>جْ</>مُ وَ<h>ٱ</><l>ل</>شَّجَرُ يَسْجُ<p>دَا</>نِ"},{"n":7,"w":[["وَٱلسَّمَآءَ","wal-samāa","And the heaven","এবং আকাশকে"],["رَفَعَهَا","rafa‘ahā","He raised it","তা সমুন্নত করেছেন তিনি"],["وَوَضَعَ","wawaḍa‘a","and He has set up","ও স্থাপন করেছেন"],["ٱلْمِيزَانَ","l-mīzāna","the balance","মানদণ্ড"]],"t":"وَ<h>ٱ</><l>ل</>سَّ<o>مَآ</>ءَ رَفَعَهَا وَوَضَعَ <h>ٱ</>لْمِي<p>زَا</>نَ"},{"n":8,"w":[["أَلَّا","allā","That not","(ঐকান্তিক দাবি) না যেন"],["تَطْغَوْا۟","taṭghaw","you may transgress","তোমরা সীমা লঙ্ঘন কর"],["فِى","fī","in","মধ্যে"],["ٱلْمِيزَانِ","l-mīzāni","the balance","মানদণ্ডের"]],"t":"أَلَّا تَ<q>طْ</>غَوْ<s>ا۟</> فِى <h>ٱ</>لْمِي<p>زَا</>نِ"},{"n":9,"w":[["وَأَقِيمُوا۟","wa-aqīmū","And establish","এবং তোমরা প্রতিষ্ঠা করো"],["ٱلْوَزْنَ","l-wazna","the weight","ওজন"],["بِٱلْقِسْطِ","bil-qis'ṭi","in justice","ন্যায্য ভাবে"],["وَلَا","walā","and (do) not","এবং না"],["تُخْسِرُوا۟","tukh'sirū","make deficient","তোমরা কম দিয়ো"],["ٱلْمِيزَانَ","l-mīzāna","the balance","দাঁড়িপাল্লায়/ পরিমাপে"]],"t":"وَأَقِيمُو<s>ا۟</> <h>ٱ</>لْوَزْنَ بِ<h>ٱ</>لْقِسْطِ وَلَا تُخْسِرُو<s>ا۟</> <h>ٱ</>لْمِي<p>زَا</>نَ"},{"n":10,"w":[["وَٱلْأَرْضَ","wal-arḍa","And the earth","এবং পৃথিবীকে"],["وَضَعَهَا","waḍa‘ahā","He laid it","তা তিনি স্থাপন করেছেন"],["لِلْأَنَامِ","lil'anāmi","for the creatures","সৃষ্ট জীবের জন্যে"]],"t":"وَ<h>ٱ</>لْأَرْضَ وَضَعَهَا لِلْأَ<p>نَا</>مِ"},{"n":11,"w":[["فِيهَا","fīhā","Therein","তার মধ্যে (আছে)"],["فَـٰكِهَةٌۭ","fākihatun","(is) fruit","ফলমূল"],["وَٱلنَّخْلُ","wal-nakhlu","and date-palms","ও খেজুর গাছ"],["ذَاتُ","dhātu","having","আছে"],["ٱلْأَكْمَامِ","l-akmāmi","sheaths","আবরণ বিশিষ্ট (যার ফল)"]],"t":"فِيهَا <m>فَٰ</>كِهَ<d>ةٌۭ وَ</><h>ٱ</><l>ل</><g>نَّ</>خْلُ ذَاتُ <h>ٱ</>لْأَكْ<p>مَا</>مِ"},{"n":12,"w":[["وَٱلْحَبُّ","wal-ḥabu","And the grain","এবং শস্য"],["ذُو","dhū","having","আছে"],["ٱلْعَصْفِ","l-‘aṣfi","husk","ভুসি বিশিষ্ট (দানা)"],["وَٱلرَّيْحَانُ","wal-rayḥānu","and scented plants","ও সুগন্ধ (বিশিষ্ট উদ্ভিদ)"]],"t":"وَ<h>ٱ</>لْحَبُّ ذُو <h>ٱ</>لْعَصْفِ وَ<h>ٱ</><l>ل</>رَّيْ<p>حَا</>نُ"},{"n":13,"w":[["فَبِأَىِّ","fabi-ayyi","So which","অতএব কোন কোন"],["ءَالَآءِ","ālāi","(of the) favors","অনুগ্রহ সমূহকে"],["رَبِّكُمَا","rabbikumā","(of) your Lord","তোমাদের উভয়ের রবের"],["تُكَذِّبَانِ","tukadhibāni","will you both deny","উভয়ে অস্বীকার করবে"]],"t":"فَبِأَىِّ ءَا<o>لَآ</>ءِ رَبِّكُمَا تُكَذِّ<p>بَا</>نِ"},{"n":14,"w":[["خَلَقَ","khalaqa","He created","তিনি সৃষ্টি করেছেন"],["ٱلْإِنسَـٰنَ","l-insāna","the man","মানুষকে"],["مِن","min","from","থেকে"],["صَلْصَـٰلٍۢ","ṣalṣālin","clay","শুকনো ঠনঠনে মাটি"],["كَٱلْفَخَّارِ","kal-fakhāri","like the pottery","(যা) পোড়া মাটির মতো"]],"t":"خَلَقَ <h>ٱ</>لْإِ<k>نسَٰ</>نَ مِ<k>ن صَ</>لْ<m>صَٰ</><k>لٍۢ كَ</><h>ٱ</>لْفَ<p>خَّا</>رِ"},{"n":15,"w":[["وَخَلَقَ","wakhalaqa","And He created","এবং সৃষ্টি করেছেন"],["ٱلْجَآنَّ","l-jāna","the jinn","জিনকে"],["مِن","min","from","থেকে"],["مَّارِجٍۢ","mārijin","a smokeless flame","শিখা"],["مِّن","min","of","থেকে"],["نَّارٍۢ","nārin","fire","আগুনের"]],"t":"وَخَلَقَ <h>ٱ</>لْ<n>جَآ</><g>نَّ</> <d>مِن مَّ</>ارِ<d>جٍۢ مِّن نَّ</><p>ا</>رٍۢ"},{"n":16,"w":[["فَبِأَىِّ","fabi-ayyi","So which","অতএব"],["ءَالَآءِ","ālāi","(of the) favors","অনুগ্রহকে"],["رَبِّكُمَا","rabbikumā","(of) your Lord","তোমাদের উভয়ের রবের"],["تُكَذِّبَانِ","tukadhibāni","will you both deny","উভয়ে অস্বীকার করবে"]],"t":"فَبِأَىِّ ءَا<o>لَآ</>ءِ رَبِّكُمَا تُكَذِّ<p>بَا</>نِ"},{"n":17,"w":[["رَبُّ","rabbu","Lord","(তিনিই) মালিক"],["ٱلْمَشْرِقَيْنِ","l-mashriqayni","(of) the two Easts","দুই উদয়াচলের"],["وَرَبُّ","warabbu","and Lord","ও মালিক"],["ٱلْمَغْرِبَيْنِ","l-maghribayni","(of) the two Wests","দুই অস্তাচলের"]],"t":"رَبُّ <h>ٱ</>لْمَشْرِقَيْنِ وَرَبُّ <h>ٱ</>لْمَغْرِبَ<p>يْ</>نِ"},{"n":18,"w":[["فَبِأَىِّ","fabi-ayyi","So which","অতএব কোন কোন"],["ءَالَآءِ","ālāi","(of the) favors","অনুগ্রহকে"],["رَبِّكُمَا","rabbikumā","(of) your Lord","তোমাদের উভয়ের রবের"],["تُكَذِّبَانِ","tukadhibāni","will you both deny","উভয়ে অস্বীকার করবে"]],"t":"فَبِأَىِّ ءَا<o>لَآ</>ءِ رَبِّكُمَا تُكَذِّ<p>بَا</>نِ"},{"n":19,"w":[["مَرَجَ","maraja","He released","প্রবাহিত করেছেন"],["ٱلْبَحْرَيْنِ","l-baḥrayni","the two seas","দুই সমুদ্রকে"],["يَلْتَقِيَانِ","yaltaqiyāni","meeting","পরস্পরে মিলিত হয়"]],"t":"مَرَجَ <h>ٱ</>لْبَحْرَيْنِ يَلْتَقِ<p>يَا</>نِ"},{"n":20,"w":[["بَيْنَهُمَا","baynahumā","Between both of them","তাদের উভয়ের মাঝে (তবুও)"],["بَرْزَخٌۭ","barzakhun","(is) a barrier","অন্তরাল (আছে)"],["لَّا","lā","not","(যার) না"],["يَبْغِيَانِ","yabghiyāni","they transgress","উভয়ে সীমা অতিক্রম করে"]],"t":"بَيْنَهُمَا بَرْزَ<w>خٌۭ لَّ</>ا يَ<q>بْ</>غِ<p>يَا</>نِ"},{"n":21,"w":[["فَبِأَىِّ","fabi-ayyi","So which","অতএব কোন কোন"],["ءَالَآءِ","ālāi","(of the) favors","অনুগ্রহকে"],["رَبِّكُمَا","rabbikumā","(of) your Lord","তোমাদের উভয়ের রবের"],["تُكَذِّبَانِ","tukadhibāni","will you both deny","উভয়ে অস্বীকার করবে"]],"t":"فَبِأَىِّ ءَا<o>لَآ</>ءِ رَبِّكُمَا تُكَذِّ<p>بَا</>نِ"},{"n":22,"w":[["يَخْرُجُ","yakhruju","Come forth","বের হয়"],["مِنْهُمَا","min'humā","from both of them","তাদের উভয় হতে"],["ٱللُّؤْلُؤُ","l-lu'lu-u","the pearl","মুক্তা"],["وَٱلْمَرْجَانُ","wal-marjānu","and the coral","ও প্রবাল"]],"t":"يَخْرُجُ مِنْهُمَا <h>ٱ</><l>ل</>لُّؤْلُؤُ وَ<h>ٱ</>لْمَرْ<p>جَا</>نُ"},{"n":23,"w":[["فَبِأَىِّ","fabi-ayyi","So which","অতএব কোন কোন"],["ءَالَآءِ","ālāi","(of the) favors","অনুগ্রহকে"],["رَبِّكُمَا","rabbikumā","(of) your Lord","তোমাদের উভয়ের রবের"],["تُكَذِّبَانِ","tukadhibāni","will you both deny","উভয়ে অস্বীকার করবে"]],"t":"فَبِأَىِّ ءَا<o>لَآ</>ءِ رَبِّكُمَا تُكَذِّ<p>بَا</>نِ"},{"n":24,"w":[["وَلَهُ","walahu","And for Him","এবং তাঁরই নিয়ন্ত্রণে"],["ٱلْجَوَارِ","l-jawāri","(are) the ships","জাহাজ সমূহ"],["ٱلْمُنشَـَٔاتُ","l-munshaātu","elevated","উঁচু উঁচু (পালসহ)"],["فِى","fī","in","মধ্যে"],["ٱلْبَحْرِ","l-baḥri","the sea","সাগরের"],["كَٱلْأَعْلَـٰمِ","kal-a‘lāmi","like mountains","পাহাড়ের মতো"]],"t":"وَلَهُ <h>ٱ</>لْجَوَارِ <h>ٱ</>لْمُ<k>نشَـَٔ</>اتُ فِى <h>ٱ</>لْبَحْرِ كَ<h>ٱ</>لْأَعْ<p>لَٰ</>مِ"},{"n":25,"w":[["فَبِأَىِّ","fabi-ayyi","So which","অতএব কোন কোন"],["ءَالَآءِ","ālāi","(of the) favors","অনুগ্রহকে"],["رَبِّكُمَا","rabbikumā","(of) your Lord","তোমাদের উভয়ের রবের"],["تُكَذِّبَانِ","tukadhibāni","will you both deny","উভয়ে অস্বীকার করবে"]],"t":"فَبِأَىِّ ءَا<o>لَآ</>ءِ رَبِّكُمَا تُكَذِّ<p>بَا</>نِ"},{"n":26,"w":[["كُلُّ","kullu","Everyone","প্রত্যেক (জিনিস)"],["مَنْ","man","who","যা কিছু"],["عَلَيْهَا","‘alayhā","(is) on it","তার উপর (আছে)"],["فَانٍۢ","fānin","(will) perish","নশ্বর"]],"t":"كُلُّ مَنْ عَلَيْهَا <p>فَا</>نٍۢ"},{"n":27,"w":[["وَيَبْقَىٰ","wayabqā","But will remain","এবং অবশিষ্ট থাকবেন"],["وَجْهُ","wajhu","(the) Face","সত্তা"],["رَبِّكَ","rabbika","(of) your Lord","তোমার রবের"],["ذُو","dhū","(the) Owner","(যিনি) সম্পন্ন"],["ٱلْجَلَـٰلِ","l-jalāli","(of) Majesty","মহিমা"],["وَٱلْإِكْرَامِ","wal-ik'rāmi","and Honor","মহানুভবতা"]],"t":"وَيَ<q>بْ</>قَىٰ وَ<q>جْ</>هُ رَبِّكَ ذُو <h>ٱ</>لْجَ<m>لَٰ</>لِ وَ<h>ٱ</>لْإِكْ<p>رَا</>مِ"},{"n":28,"w":[["فَبِأَىِّ","fabi-ayyi","So which","অতএব কোন কোন"],["ءَالَآءِ","ālāi","(of the) favors","অনুগ্রহকে"],["رَبِّكُمَا","rabbikumā","(of) your Lord","তোমাদের উভয়ের রবের"],["تُكَذِّبَانِ","tukadhibāni","will you both deny","উভয়ে অস্বীকার করবে"]],"t":"فَبِأَىِّ ءَا<o>لَآ</>ءِ رَبِّكُمَا تُكَذِّ<p>بَا</>نِ"},{"n":29,"w":[["يَسْـَٔلُهُۥ","yasaluhu","Asks Him","তাঁরই কাছে প্রার্থনা করে"],["مَن","man","whoever","যা কিছু"],["فِى","fī","(is) in","মধ্যে (আছে)"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশ"],["وَٱلْأَرْضِ ۚ","wal-arḍi","and the earth","ও পৃথিবীর"],["كُلَّ","kulla","Every","প্রত্যেক"],["يَوْمٍ","yawmin","day","দিন"],["هُوَ","huwa","He","তিনি"],["فِى","fī","(is) in","থাকেন"],["شَأْنٍۢ","shanin","a matter","(এক বিশেষ) অবস্থায়"]],"t":"يَسْـَٔلُهُ<m>ۥ</> مَ<k>ن فِ</>ى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ ۚ كُلَّ يَوْمٍ هُوَ فِى شَأْنٍۢ"},{"n":30,"w":[["فَبِأَىِّ","fabi-ayyi","So which","সুতরাং কোন কোন"],["ءَالَآءِ","ālāi","(of the) favors","অনুগ্রহকে"],["رَبِّكُمَا","rabbikumā","(of) your Lord","তোমাদের উভয়ের রবের"],["تُكَذِّبَانِ","tukadhibāni","will you both deny","উভয়ে অস্বীকার করবে"]],"t":"فَبِأَىِّ ءَا<o>لَآ</>ءِ رَبِّكُمَا تُكَذِّ<p>بَا</>نِ"},{"n":31,"w":[["سَنَفْرُغُ","sanafrughu","Soon We will attend","অবসর হব আমরা শীঘ্রই"],["لَكُمْ","lakum","to you","তোমাদের জন্যে"],["أَيُّهَ","ayyuha","O you","হে"],["ٱلثَّقَلَانِ","l-thaqalāni","two classes","দুই ভার (জিন ও মানব)"]],"t":"سَنَفْرُغُ لَكُمْ أَيُّهَ <h>ٱ</><l>ل</>ثَّقَ<p>لَا</>نِ"},{"n":32,"w":[["فَبِأَىِّ","fabi-ayyi","So which","সুতরাং কোন কোন"],["ءَالَآءِ","ālāi","(of the) favors","দয়া অনুগ্রহকে"],["رَبِّكُمَا","rabbikumā","(of) your Lord","তোমাদের উভয়ের রবের"],["تُكَذِّبَانِ","tukadhibāni","will you both deny","উভয়ে অস্বীকার করবে"]],"t":"فَبِأَىِّ ءَا<o>لَآ</>ءِ رَبِّكُمَا تُكَذِّ<p>بَا</>نِ"},{"n":33,"w":[["يَـٰمَعْشَرَ","yāma‘shara","O assembly","হে সম্প্রদায়"],["ٱلْجِنِّ","l-jini","(of) the jinn","জিনের"],["وَٱلْإِنسِ","wal-insi","and the men","ও মানবের"],["إِنِ","ini","If","যদি"],["ٱسْتَطَعْتُمْ","is'taṭa‘tum","you are able","তোমরা পার"],["أَن","an","to","যে"],["تَنفُذُوا۟","tanfudhū","pass beyond","তোমরা অতিক্রম করে পালাও"],["مِنْ","min","[of]","থেকে"],["أَقْطَارِ","aqṭāri","(the) regions","সীমা সমূহ"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশের"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীর"],["فَٱنفُذُوا۟ ۚ","fa-unfudhū","then pass","তবে তোমরা অতিক্রম করো"],["لَا","lā","Not","না"],["تَنفُذُونَ","tanfudhūna","you (can) pass","তোমরা অতিক্রম করে পালাতে পারবে"],["إِلَّا","illā","except","ব্যতীত"],["بِسُلْطَـٰنٍۢ","bisul'ṭānin","by authority","শক্তি দিয়ে (যা তোমাদের নেই)"]],"t":"<m>يَٰ</>مَعْشَرَ <h>ٱ</>لْجِ<g>نِّ</> وَ<h>ٱ</>لْإِ<k>نسِ</> إِنِ <h>ٱ</>سْتَطَعْتُمْ أَ<k>ن تَنفُ</>ذُو<s>ا۟</> مِنْ أَ<q>قْ</>طَارِ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ فَ<h>ٱ</><k>نفُ</>ذُو<s>ا۟ ۚ</> لَا تَ<k>نفُ</>ذُونَ إِلَّا بِسُلْ<p>طَٰ</>نٍۢ"},{"n":34,"w":[["فَبِأَىِّ","fabi-ayyi","So which","অতএব কোন কোন"],["ءَالَآءِ","ālāi","(of the) favors","অনুগ্রহকে"],["رَبِّكُمَا","rabbikumā","(of) your Lord","তোমাদের উভয়ের রবের"],["تُكَذِّبَانِ","tukadhibāni","will you both deny","উভয়ে অস্বীকার করবে"]],"t":"فَبِأَىِّ ءَا<o>لَآ</>ءِ رَبِّكُمَا تُكَذِّ<p>بَا</>نِ"},{"n":35,"w":[["يُرْسَلُ","yur'salu","Will be sent","পাঠানো হবে"],["عَلَيْكُمَا","‘alaykumā","against both of you","তোমাদের উভয়ের উপর"],["شُوَاظٌۭ","shuwāẓun","a flame","শিখা"],["مِّن","min","of","থেকে"],["نَّارٍۢ","nārin","fire","আগুন"],["وَنُحَاسٌۭ","wanuḥāsun","and smoke","ও ধোঁয়া"],["فَلَا","falā","and not","না তখন"],["تَنتَصِرَانِ","tantaṣirāni","you will (be able to) defend yourselves","তোমরা প্রতিরোধ করতে পারবে"]],"t":"يُرْسَلُ عَلَيْكُمَا شُوَا<d>ظٌۭ مِّن نَّارٍۢ وَ</>نُحَا<k>سٌۭ فَ</>لَا تَ<k>نتَ</>صِ<p>رَا</>نِ"},{"n":36,"w":[["فَبِأَىِّ","fabi-ayyi","So which","সুতরাং কোন কোন"],["ءَالَآءِ","ālāi","(of the) favors","অনুগ্রহকে"],["رَبِّكُمَا","rabbikumā","(of) your Lord","তোমাদের উভয়ের রবের"],["تُكَذِّبَانِ","tukadhibāni","will you both deny","উভয়ে অস্বীকার করবে"]],"t":"فَبِأَىِّ ءَا<o>لَآ</>ءِ رَبِّكُمَا تُكَذِّ<p>بَا</>نِ"},{"n":37,"w":[["فَإِذَا","fa-idhā","Then when","যখন অতঃপর"],["ٱنشَقَّتِ","inshaqqati","is split","ছিঁড়েফেটে"],["ٱلسَّمَآءُ","l-samāu","the heaven","আকাশ"],["فَكَانَتْ","fakānat","and it becomes","অতঃপর হবে (তা)"],["وَرْدَةًۭ","wardatan","rose-colored","লাল"],["كَٱلدِّهَانِ","kal-dihāni","like murky oil","মতো লাল চামড়ার"]],"t":"فَإِذَا <h>ٱ</><k>نشَ</>قَّتِ <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءُ فَكَانَتْ وَرْدَ<k>ةًۭ كَ</><h>ٱ</><l>ل</>دِّ<p>هَا</>نِ"},{"n":38,"w":[["فَبِأَىِّ","fabi-ayyi","So which","তখন কোন কোন"],["ءَالَآءِ","ālāi","(of the) favors","অনুগ্রহকে"],["رَبِّكُمَا","rabbikumā","(of) your Lord","তোমাদের উভয়ের রবের"],["تُكَذِّبَانِ","tukadhibāni","will you both deny","উভয়ে অস্বীকার করবে"]],"t":"فَبِأَىِّ ءَا<o>لَآ</>ءِ رَبِّكُمَا تُكَذِّ<p>بَا</>نِ"},{"n":39,"w":[["فَيَوْمَئِذٍۢ","fayawma-idhin","Then (on) that Day","সেদিন অতঃপর"],["لَّا","lā","not","না"],["يُسْـَٔلُ","yus'alu","will be asked","জিজ্ঞেস করা হবে"],["عَن","‘an","about","সম্পর্কে"],["ذَنۢبِهِۦٓ","dhanbihi","his sin","তার পাপ"],["إِنسٌۭ","insun","any man","কোনো মানবকে"],["وَلَا","walā","and not","আর না"],["جَآنٌّۭ","jānnun","any jinn","কোনো জিনকে"]],"t":"فَيَوْمَئِ<w>ذٍۢ لَّ</>ا يُسْـَٔلُ عَ<k>ن ذَ</><i>نۢبِ</><o>هِۦٓ</> إِن<d>سٌۭ وَ</>لَا <n>جَآ</><g>نٌّۭ</>"},{"n":40,"w":[["فَبِأَىِّ","fabi-ayyi","So which","তখন কোন কোন"],["ءَالَآءِ","ālāi","(of the) favors","অনুগ্রহকে"],["رَبِّكُمَا","rabbikumā","(of) your Lord","তোমাদের উভয়ের রবের"],["تُكَذِّبَانِ","tukadhibāni","will you both deny","উভয়ে অস্বীকার করবে"]],"t":"فَبِأَىِّ ءَا<o>لَآ</>ءِ رَبِّكُمَا تُكَذِّ<p>بَا</>نِ"},{"n":41,"w":[["يُعْرَفُ","yu‘'rafu","Will be known","চেনা যাবে"],["ٱلْمُجْرِمُونَ","l-muj'rimūna","the criminals","অপরাধীদেরকে"],["بِسِيمَـٰهُمْ","bisīmāhum","by their marks","তাদের লক্ষণ দ্বারা"],["فَيُؤْخَذُ","fayu'khadhu","and will be seized","পাকড়াও করা হবে অতঃপর"],["بِٱلنَّوَٰصِى",