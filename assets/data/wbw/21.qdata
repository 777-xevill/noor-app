{"n":21,"a":[{"n":1,"w":[["ٱقْتَرَبَ","iq'taraba","(Has) approached","নিকটে এসেছে"],["لِلنَّاسِ","lilnnāsi","for [the] mankind","জন্যে মানুষের"],["حِسَابُهُمْ","ḥisābuhum","their account","তাদের হিসাব (নেয়ার সময়)"],["وَهُمْ","wahum","while they","অথচ তারা"],["فِى","fī","(are) in","মধ্যে"],["غَفْلَةٍۢ","ghaflatin","heedlessness","উদাসীনতার"],["مُّعْرِضُونَ","mu‘'riḍūna","turning away","পড়ে আছে বিমুখ হয়ে"]],"t":"ٱ<q>قْ</>تَرَبَ لِل<g>نَّ</>اسِ حِسَابُهُمْ وَهُمْ فِى غَفْلَ<d>ةٍۢ مُّ</>عْرِ<p>ضُو</>نَ"},{"n":2,"w":[["مَا","mā","Not","না"],["يَأْتِيهِم","yatīhim","comes to them","তাদের কাছে আসে"],["مِّن","min","of","কোন"],["ذِكْرٍۢ","dhik'rin","a Reminder","উপদেশ"],["مِّن","min","from","পক্ষ হ'তে"],["رَّبِّهِم","rabbihim","their Lord","তাদের রবের"],["مُّحْدَثٍ","muḥ'dathin","anew","নতুন"],["إِلَّا","illā","except","এ ছাড়া যে"],["ٱسْتَمَعُوهُ","is'tama‘ūhu","they listen to it","তা তারা শুনে"],["وَهُمْ","wahum","while they","এমতাবস্হায় যে তারা"],["يَلْعَبُونَ","yal‘abūna","(are at) play","খেলায় মেতে থাকে"]],"t":"مَا يَأْتِي<y>هِم مِّ</><k>ن ذِ</>كْ<d>رٍۢ مِّ</><w>ن رَّ</>بِّ<y>هِم مُّ</>حْدَثٍ إِلَّا <h>ٱ</>سْتَمَعُوهُ وَهُمْ يَلْعَ<p>بُو</>نَ"},{"n":3,"w":[["لَاهِيَةًۭ","lāhiyatan","Distracted","অমনোযোগী থাকে"],["قُلُوبُهُمْ ۗ","qulūbuhum","their hearts","তাদের অন্তরগুলো"],["وَأَسَرُّوا۟","wa-asarrū","And they conceal","এবং তারা গোপনে করে"],["ٱلنَّجْوَى","l-najwā","the private conversation","পরামর্শ"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["ظَلَمُوا۟","ẓalamū","[they] wronged","সীমালঙ্ঘন করেছে"],["هَلْ","hal","Is","\"(তারা বলে) নয় কি"],["هَـٰذَآ","hādhā","this","এই (ব্যক্তি)"],["إِلَّا","illā","except","এছাড়া"],["بَشَرٌۭ","basharun","a human being","একজন মানুষ"],["مِّثْلُكُمْ ۖ","mith'lukum","like you","তোমাদেরই মতো"],["أَفَتَأْتُونَ","afatatūna","So would you approach","তবে কি তোমরা এসে পড়বে"],["ٱلسِّحْرَ","l-siḥ'ra","the magic","জাদুর (খপ্পরে)"],["وَأَنتُمْ","wa-antum","while you","অথচ তোমরা"],["تُبْصِرُونَ","tub'ṣirūna","see (it)","দেখছো\""]],"t":"لَاهِيَ<k>ةًۭ قُ</>لُوبُهُمْ ۗ وَأَسَرُّو<s>ا۟</> <h>ٱ</><l>ل</><g>نَّ</><q>جْ</>وَى <h>ٱ</>لَّذِينَ ظَلَمُو<s>ا۟</> هَلْ <m>هَٰ</><o>ذَآ</> إِلَّا بَشَ<d>رٌۭ مِّ</>ثْلُكُمْ ۖ أَفَتَأْتُونَ <h>ٱ</><l>ل</>سِّحْرَ وَأَ<k>نتُ</>مْ تُ<q>بْ</>صِ<p>رُو</>نَ"},{"n":4,"w":[["قَالَ","qāla","He said","(নাবী) বললো"],["رَبِّى","rabbī","My Lord","\"আমার রব"],["يَعْلَمُ","ya‘lamu","knows","জানেন"],["ٱلْقَوْلَ","l-qawla","the word","(সেই সব) কথা"],["فِى","fī","in","(যা হয়) মধ্যে"],["ٱلسَّمَآءِ","l-samāi","the heavens","আকাশমন্ডলীর"],["وَٱلْأَرْضِ ۖ","wal-arḍi","and the earth","ও পৃথিবীর"],["وَهُوَ","wahuwa","And He","এবং তিনিই"],["ٱلسَّمِيعُ","l-samī‘u","(is) the All-Hearer","সবকিছু শুনেন"],["ٱلْعَلِيمُ","l-‘alīmu","the All-Knower","সবকিছু জানেন\""]],"t":"قَالَ رَبِّى يَعْلَمُ <h>ٱ</>لْقَوْلَ فِى <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءِ وَ<h>ٱ</>لْأَرْضِ ۖ وَهُوَ <h>ٱ</><l>ل</>سَّمِيعُ <h>ٱ</>لْعَ<p>لِي</>مُ"},{"n":5,"w":[["بَلْ","bal","Nay","বরং"],["قَالُوٓا۟","qālū","they say","তারা বলে"],["أَضْغَـٰثُ","aḍghāthu","Muddled","\"(এসব) অলীক"],["أَحْلَـٰمٍۭ","aḥlāmin","dreams","স্বপ্নসমূহ"],["بَلِ","bali","nay","বরং"],["ٱفْتَرَىٰهُ","if'tarāhu","he (has) invented it","তা সে উদ্ভাবন করেছে"],["بَلْ","bal","nay","বরং"],["هُوَ","huwa","he","সে"],["شَاعِرٌۭ","shā‘irun","(is) a poet","একজন কবি"],["فَلْيَأْتِنَا","falyatinā","So let him bring us","তাহ'লে আসুক আমাদের কাছে"],["بِـَٔايَةٍۢ","biāyatin","a sign","কোন নিদর্শন"],["كَمَآ","kamā","like what","যেমন"],["أُرْسِلَ","ur'sila","was sent","পাঠানো হয়েছিলো"],["ٱلْأَوَّلُونَ","l-awalūna","(to) the former","পূর্ববর্তীগণকে (নিদর্শনসহ)\""]],"t":"بَلْ قَا<o>لُوٓ</><s>ا۟</> أَضْ<m>غَٰ</>ثُ أَحْ<m>لَٰ</><i>مٍۭ بَ</>لِ <h>ٱ</>فْتَرَ<m>ىٰ</>هُ بَلْ هُوَ شَاعِ<k>رٌۭ فَ</>لْيَأْتِنَا بِـَٔايَ<k>ةٍۢ كَ</><o>مَآ</> أُرْسِلَ <h>ٱ</>لْأَوَّ<p>لُو</>نَ"},{"n":6,"w":[["مَآ","mā","Not","নি"],["ءَامَنَتْ","āmanat","believed","ঈমান আনে"],["قَبْلَهُم","qablahum","before them","তাদের পূর্বে"],["مِّن","min","any","কোন"],["قَرْيَةٍ","qaryatin","town","জনবসতিই"],["أَهْلَكْنَـٰهَآ ۖ","ahlaknāhā","which We destroyed","যাকে আমরা ধ্বংস করেছি"],["أَفَهُمْ","afahum","so will they","তবে কি এরা"],["يُؤْمِنُونَ","yu'minūna","believe","ঈমান আনবে (এখন)"]],"t":"<o>مَآ</> ءَامَنَتْ قَ<q>بْ</>لَ<y>هُم مِّ</><k>ن قَ</>رْيَةٍ أَهْلَكْ<m>نَٰ</><o>هَآ ۖ</> أَفَهُمْ يُؤْمِ<p>نُو</>نَ"},{"n":7,"w":[["وَمَآ","wamā","And not","এবং না (হে নবী)"],["أَرْسَلْنَا","arsalnā","We sent","আমরা পাঠিয়েছি"],["قَبْلَكَ","qablaka","before you","তোমার পূর্বে (কোন রাসূলকে)"],["إِلَّا","illā","except","এ ছাড়া যে"],["رِجَالًۭا","rijālan","men","(সে ছিলো) পুরুষ"],["نُّوحِىٓ","nūḥī","We revealed","ওহী করতাম আমরা"],["إِلَيْهِمْ ۖ","ilayhim","to them","তাদের কাছে"],["فَسْـَٔلُوٓا۟","fasalū","So ask","অতএব জিজ্ঞেস করো"],["أَهْلَ","ahla","(the) people","অধিকারীদের"],["ٱلذِّكْرِ","l-dhik'ri","(of) the Reminder","জ্ঞানের"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you","তোমরা"],["لَا","lā","(do) not","না"],["تَعْلَمُونَ","ta‘lamūna","know","জানো"]],"t":"وَ<o>مَآ</> أَرْسَلْنَا قَ<q>بْ</>لَكَ إِلَّا رِجَالًۭ<d>ا نُّ</>و<o>حِىٓ</> إِلَيْهِمْ ۖ فَسْـَٔ<o>لُوٓ</><s>ا۟</> أَهْلَ <h>ٱ</><l>ل</>ذِّكْرِ إِ<k>ن كُنتُ</>مْ لَا تَعْلَ<p>مُو</>نَ"},{"n":8,"w":[["وَمَا","wamā","And not","এবং নি"],["جَعَلْنَـٰهُمْ","ja‘alnāhum","We made them","তাদের আমরা বানাই"],["جَسَدًۭا","jasadan","bodies","(এমন) দেহ বিশিষ্ট"],["لَّا","lā","not","যে না"],["يَأْكُلُونَ","yakulūna","eating","তারা খেতো"],["ٱلطَّعَامَ","l-ṭa‘āma","the food","খাবার"],["وَمَا","wamā","and not","আর না"],["كَانُوا۟","kānū","they were","তারা ছিলো"],["خَـٰلِدِينَ","khālidīna","immortals","চিরস্থায়ী"]],"t":"وَمَا جَعَلْ<m>نَٰ</>هُمْ جَسَ<w>دًۭا لَّ</>ا يَأْكُلُونَ <h>ٱ</><l>ل</>طَّعَامَ وَمَا كَانُو<s>ا۟</> <m>خَٰ</>لِ<p>دِي</>نَ"},{"n":9,"w":[["ثُمَّ","thumma","Then","এরপর"],["صَدَقْنَـٰهُمُ","ṣadaqnāhumu","We fulfilled (for) them","তাদের প্রতি আমরা সত্য করে দেখালাম"],["ٱلْوَعْدَ","l-wa‘da","the promise","প্রতিশ্রুতি"],["فَأَنجَيْنَـٰهُمْ","fa-anjaynāhum","and We saved them","অতঃপর তাদেরকে আমরা রক্ষা করেছি"],["وَمَن","waman","and whom","ও যাদেরকে"],["نَّشَآءُ","nashāu","We willed","চেয়েছি আমরা"],["وَأَهْلَكْنَا","wa-ahlaknā","and We destroyed","এবং আমরা ধ্বংস করেছি"],["ٱلْمُسْرِفِينَ","l-mus'rifīna","the transgressors","সীমালঙ্ঘনকারীদেরকে"]],"t":"ثُ<g>مَّ</> صَدَ<q>قْ</><m>نَٰ</>هُمُ <h>ٱ</>لْوَعْدَ فَأَ<k>نجَ</>يْ<m>نَٰ</>هُمْ وَ<d>مَن نَّ</><o>شَآ</>ءُ وَأَهْلَكْنَا <h>ٱ</>لْمُسْرِ<p>فِي</>نَ"},{"n":10,"w":[["لَقَدْ","laqad","Indeed","নিশ্চয়ই"],["أَنزَلْنَآ","anzalnā","We (have) sent down","আমরা অবতীর্ণ করেছি"],["إِلَيْكُمْ","ilaykum","to you","তোমাদের প্রতি"],["كِتَـٰبًۭا","kitāban","a Book","কিতাব"],["فِيهِ","fīhi","in it","তার মধ্যে (রয়েছে)"],["ذِكْرُكُمْ ۖ","dhik'rukum","(is) your mention","তোমাদেরই বর্ণনা"],["أَفَلَا","afalā","Then will not","তবে কি না"],["تَعْقِلُونَ","ta‘qilūna","you use reason","তোমরা বুঝবে"]],"t":"لَقَ<q>دْ</> أَ<k>نزَ</>لْ<o>نَآ</> إِلَيْكُمْ كِ<m>تَٰ</><k>بًۭا فِ</>يهِ ذِكْرُكُمْ ۖ أَفَلَا تَعْقِ<p>لُو</>نَ"},{"n":11,"w":[["وَكَمْ","wakam","And how many","এবং কত"],["قَصَمْنَا","qaṣamnā","We (have) shattered","আমরা ধ্বংস করেছি"],["مِن","min","of","থেকে"],["قَرْيَةٍۢ","qaryatin","a town","জনবসতি"],["كَانَتْ","kānat","(that) was","যা ছিল"],["ظَالِمَةًۭ","ẓālimatan","unjust","সীমালঙ্ঘনকারী"],["وَأَنشَأْنَا","wa-anshanā","and We produced","এবং আমরা সৃষ্টি করেছি"],["بَعْدَهَا","ba‘dahā","after them","পরে তার"],["قَوْمًا","qawman","another people","জাতি"],["ءَاخَرِينَ","ākharīna","another people","অপর"]],"t":"وَكَمْ قَصَمْنَا مِ<k>ن قَ</>رْيَ<k>ةٍۢ كَ</>انَتْ ظَالِمَ<d>ةًۭ وَ</>أَ<k>نشَ</>أْنَا بَعْدَهَا قَوْمًا ءَاخَ<p>رِي</>نَ"},{"n":12,"w":[["فَلَمَّآ","falammā","Then when","অতঃপর যখন"],["أَحَسُّوا۟","aḥassū","they perceived","তারা অনুভবব করলো"],["بَأْسَنَآ","basanā","Our torment","আমাদের শাস্তি"],["إِذَا","idhā","behold","তখন"],["هُم","hum","they","তারা"],["مِّنْهَا","min'hā","from it","তা থেকে"],["يَرْكُضُونَ","yarkuḍūna","were fleeing","পালাতে লাগলো"]],"t":"فَلَ<g>مَّ</><o>آ</> أَحَسُّو<s>ا۟</> بَأْسَ<o>نَآ</> إِذَا <y>هُم مِّ</>نْهَا يَرْكُ<p>ضُو</>نَ"},{"n":13,"w":[["لَا","lā","Flee not","(বলা হলো) না"],["تَرْكُضُوا۟","tarkuḍū","Flee not","তোমরা পালাবে"],["وَٱرْجِعُوٓا۟","wa-ir'ji‘ū","but return","বরং তোমরা ফিরে যাও"],["إِلَىٰ","ilā","to","দিকে"],["مَآ","mā","what","তার"],["أُتْرِفْتُمْ","ut'rif'tum","you were given luxury","তোমাদের সম্ভোগ দেয়া হয়েছিলো"],["فِيهِ","fīhi","in it","যার মধ্যে"],["وَمَسَـٰكِنِكُمْ","wamasākinikum","and to your homes","ও ঘরবাড়িগুলোতে তোমাদের"],["لَعَلَّكُمْ","la‘allakum","so that you may","যাতে তোমাদের"],["تُسْـَٔلُونَ","tus'alūna","be questioned","জিজ্ঞাসাবাদ করা যেতে পারে"]],"t":"لَا تَرْكُضُو<s>ا۟</> وَ<h>ٱ</>رْجِ<o>عُوٓ</><s>ا۟</> إِلَىٰ <o>مَآ</> أُتْرِفْتُمْ فِيهِ وَمَ<m>سَٰ</>كِنِكُمْ لَعَلَّكُمْ تُسْـَٔ<p>لُو</>نَ"},{"n":14,"w":[["قَالُوا۟","qālū","They said","তারা বলেছিলো"],["يَـٰوَيْلَنَآ","yāwaylanā","O woe to us","\"হায় আমাদের দুর্ভোগ"],["إِنَّا","innā","Indeed, [we]","নিশ্চয়ই আমরা"],["كُنَّا","kunnā","we were","ছিলাম"],["ظَـٰلِمِينَ","ẓālimīna","wrongdoers","অত্যাচারী\""]],"t":"قَالُو<s>ا۟</> <m>يَٰ</>وَيْلَ<o>نَآ</> إِ<g>نَّ</>ا كُ<g>نَّ</>ا <m>ظَٰ</>لِ<p>مِي</>نَ"},{"n":15,"w":[["فَمَا","famā","Then not","অতঃপর"],["زَالَت","zālat","ceased","চলতে থাকে"],["تِّلْكَ","til'ka","[this]","এই"],["دَعْوَىٰهُمْ","da‘wāhum","their cry","তাদের আর্তনাদ"],["حَتَّىٰ","ḥattā","until","যতক্ষণ না"],["جَعَلْنَـٰهُمْ","ja‘alnāhum","We made them","তাদেরকে আমরা পরিণত করি"],["حَصِيدًا","ḥaṣīdan","reaped","কাটা শস্য"],["خَـٰمِدِينَ","khāmidīna","extinct","নেভানো আগুনের মতো"]],"t":"فَمَا زَالَت تِّلْكَ دَعْوَ<m>ىٰ</>هُمْ حَتَّىٰ جَعَلْ<m>نَٰ</>هُمْ حَصِيدًا <m>خَٰ</>مِ<p>دِي</>نَ"},{"n":16,"w":[["وَمَا","wamā","And not","এবং না"],["خَلَقْنَا","khalaqnā","We created","আমরা সৃষ্টি করেছি"],["ٱلسَّمَآءَ","l-samāa","the heavens","আকাশ"],["وَٱلْأَرْضَ","wal-arḍa","and the earth","ও পৃথিবীকে"],["وَمَا","wamā","and what","আর যা কিছু"],["بَيْنَهُمَا","baynahumā","(is) between them","উভয়ের মাঝে"],["لَـٰعِبِينَ","lā‘ibīna","(for) playing","খেলার ছলে"]],"t":"وَمَا خَلَ<q>قْ</>نَا <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءَ وَ<h>ٱ</>لْأَرْضَ وَمَا بَيْنَهُمَا <m>لَٰ</>عِ<p>بِي</>نَ"},{"n":17,"w":[["لَوْ","law","If","যদি"],["أَرَدْنَآ","aradnā","We intended","আমরা চাইতাম"],["أَن","an","that","যে"],["نَّتَّخِذَ","nattakhidha","We take","আমরা গ্রহণ করবো"],["لَهْوًۭا","lahwan","a pastime","(এসব সৃষ্টি) খেলা রূপে"],["لَّٱتَّخَذْنَـٰهُ","la-ittakhadhnāhu","surely We (could have) taken it","অবশ্যই তা আমরা (খেলা হিসেবে) নিতাম"],["مِن","min","from","থেকে"],["لَّدُنَّآ","ladunnā","Us","আমাদের কাছ (সীমাবদ্ধ রেখে)"],["إِن","in","if","যদি"],["كُنَّا","kunnā","We were","আমরা হতাম"],["فَـٰعِلِينَ","fā‘ilīna","doers","(খেলা) করার"]],"t":"لَوْ أَرَ<q>دْ</><o>نَآ</> <d>أَن نَّ</>تَّخِذَ لَهْ<w>وًۭا لَّ</><h>ٱ</>تَّخَذْ<m>نَٰ</>هُ <w>مِن لَّ</>دُ<g>نَّ</><o>آ</> إِ<k>ن كُ</><g>نَّ</>ا <m>فَٰ</>عِ<p>لِي</>نَ"},{"n":18,"w":[["بَلْ","bal","Nay","(ব্যাপার তা নয়) বরং"],["نَقْذِفُ","naqdhifu","We hurl","আঘাত হানি আমরা"],["بِٱلْحَقِّ","bil-ḥaqi","the truth","দিয়ে সত্য"],["عَلَى","‘alā","against","উপর"],["ٱلْبَـٰطِلِ","l-bāṭili","[the] falsehood","মিথ্যার"],["فَيَدْمَغُهُۥ","fayadmaghuhu","and it breaks its head","ফলে তাকে চূর্ণবিচূর্ণ করে দেয়"],["فَإِذَا","fa-idhā","behold","অতঃপর তখন"],["هُوَ","huwa","it (is)","তা"],["زَاهِقٌۭ ۚ","zāhiqun","vanishing","নিশ্চিহ্ন হয়ে যায়"],["وَلَكُمُ","walakumu","And for you","আর তোমাদের জন্যে আছে"],["ٱلْوَيْلُ","l-waylu","(is) destruction","দুর্ভোগ"],["مِمَّا","mimmā","for what","সে কারণে যা"],["تَصِفُونَ","taṣifūna","you ascribe","তোমরা রচনা করছো"]],"t":"بَلْ نَ<q>قْ</>ذِفُ بِ<h>ٱ</>لْحَقِّ عَلَى <h>ٱ</>لْ<m>بَٰ</>طِلِ فَيَ<q>دْ</>مَغُهُ<m>ۥ</> فَإِذَا هُوَ زَاهِ<d>قٌۭ ۚ وَ</>لَكُمُ <h>ٱ</>لْوَيْلُ مِ<g>مَّ</>ا تَصِ<p>فُو</>نَ"},{"n":19,"w":[["وَلَهُۥ","walahu","And to Him (belongs)","এবং তাঁরই (রয়েছে)"],["مَن","man","whoever","যা কিছু"],["فِى","fī","(is) in","মধ্যে আছে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশমন্ডলীর"],["وَٱلْأَرْضِ ۚ","wal-arḍi","and the earth","এবং পৃথিবীর"],["وَمَنْ","waman","And (those) who","এবং যারা আছে"],["عِندَهُۥ","‘indahu","(are) near Him","তাঁর কাছে"],["لَا","lā","not","না"],["يَسْتَكْبِرُونَ","yastakbirūna","they are arrogant","তারা অহংকার বশে বিরত থাকে"],["عَنْ","‘an","to","থেকে"],["عِبَادَتِهِۦ","‘ibādatihi","worship Him","তাঁর ইবাদাত"],["وَلَا","walā","and not","আর না"],["يَسْتَحْسِرُونَ","yastaḥsirūna","they tire","তারা পরিশ্রান্ত হয়"]],"t":"وَلَهُ<m>ۥ</> مَ<k>ن فِ</>ى <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ ۚ وَمَنْ عِ<k>ندَ</>هُ<m>ۥ</> لَا يَسْتَكْبِرُونَ عَنْ عِبَادَتِ<m>هِۦ</> وَلَا يَسْتَحْسِ<p>رُو</>نَ"},{"n":20,"w":[["يُسَبِّحُونَ","yusabbiḥūna","They glorify (Him)","তারা পবিত্রতা ঘোষণা করে"],["ٱلَّيْلَ","al-layla","[the] night","রাতে"],["وَٱلنَّهَارَ","wal-nahāra","and [the] day","ও দিনে"],["لَا","lā","not","না"],["يَفْتُرُونَ","yafturūna","they slacken","তারা থামে"]],"t":"يُسَبِّحُونَ <h>ٱ</>لَّيْلَ وَ<h>ٱ</><l>ل</><g>نَّ</>هَارَ لَا يَفْتُ<p>رُو</>نَ"},{"n":21,"w":[["أَمِ","ami","Or","কি"],["ٱتَّخَذُوٓا۟","ittakhadhū","(have) they taken","তারা বানিয়ে নিয়েছে"],["ءَالِهَةًۭ","ālihatan","gods","(অন্যান্যদেরকে) দেবতারূপে"],["مِّنَ","mina","from","মধ্য হ'তে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["هُمْ","hum","they","তারা"],["يُنشِرُونَ","yunshirūna","raise (the dead)","মৃতকে উঠাতে পারে (কি)"]],"t":"أَمِ <h>ٱ</>تَّخَ<o>ذُوٓ</><s>ا۟</> ءَالِهَ<d>ةًۭ مِّ</>نَ <h>ٱ</>لْأَرْضِ هُمْ يُ<k>نشِ</><p>رُو</>نَ"},{"n":22,"w":[["لَوْ","law","If","যদি"],["كَانَ","kāna","(there) were","হতো"],["فِيهِمَآ","fīhimā","in both of them","তাদের উভয়ের মধ্যে"],["ءَالِهَةٌ","ālihatun","gods","(আরো অনেক) ইলাহ"],["إِلَّا","illā","besides","ছাড়া"],["ٱللَّهُ","l-lahu","Allah","আল্লাহ"],["لَفَسَدَتَا ۚ","lafasadatā","surely they (would) have been ruined","অবশ্যই উভয়ই ধ্বংস হতো"],["فَسُبْحَـٰنَ","fasub'ḥāna","So glorified","অতএব পবিত্র"],["ٱللَّهِ","l-lahi","(is) Allah","আল্লাহ্‌"],["رَبِّ","rabbi","Lord","রব"],["ٱلْعَرْشِ","l-‘arshi","(of) the Throne","আরশের"],["عَمَّا","‘ammā","(above) what","তা হ'তে যা"],["يَصِفُونَ","yaṣifūna","they attribute","তারা বর্ণনা করে"]],"t":"لَوْ كَانَ فِيهِ<o>مَآ</> ءَالِهَةٌ إِلَّا <h>ٱ</>للَّهُ لَفَسَدَتَا ۚ فَسُ<q>بْ</><m>حَٰ</>نَ <h>ٱ</>للَّهِ رَبِّ <h>ٱ</>لْعَرْشِ عَ<g>مَّ</>ا يَصِ<p>فُو</>نَ"},{"n":23,"w":[["لَا","lā","Not","না"],["يُسْـَٔلُ","yus'alu","He (can) be questioned","তাঁকে জিজ্ঞেস করা হবে"],["عَمَّا","‘ammā","about what","ঐ বিষয়ে যা"],["يَفْعَلُ","yaf‘alu","He does","তিনি করেন"],["وَهُمْ","wahum","but they","বরং তারা"],["يُسْـَٔلُونَ","yus'alūna","will be questioned","জিজ্ঞাসিত হবে"]],"t":"لَا يُسْـَٔلُ عَ<g>مَّ</>ا يَفْعَلُ وَهُمْ يُسْـَٔ<p>لُو</>نَ"},{"n":24,"w":[["أَمِ","ami","Or","কি"],["ٱتَّخَذُوا۟","ittakhadhū","(have) they taken","তারা গ্রহণ করেছে"],["مِن","min","besides Him","মধ্য হতে"],["دُونِهِۦٓ","dūnihi","besides Him","তাঁকে ছাড়া"],["ءَالِهَةًۭ ۖ","ālihatan","gods","(অন্যান্যদেরকে) ইলাহরূপে"],["قُلْ","qul","Say","(হে নাবী) বলো"],["هَاتُوا۟","hātū","Bring","\"পেশ করো"],["بُرْهَـٰنَكُمْ ۖ","bur'hānakum","your proof","তোমাদের প্রমাণ"],["هَـٰذَا","hādhā","This","এটা"],["ذِكْرُ","dhik'ru","(is) a Reminder","উপদেশ (কিতাব)"],["مَن","man","(for those) who","(তাদের জন্য) যারা"],["مَّعِىَ","ma‘iya","(are) with me","আমার সাথে (আছে)"],["وَذِكْرُ","wadhik'ru","and a Reminder","উপদেশ (কিতাব)"],["مَن","man","(for those) who","(তাদেরও) যারা"],["قَبْلِى ۗ","qablī","(were) before me","আমার পূর্বে (ছিলো)\""],["بَلْ","bal","But","বরং"],["أَكْثَرُهُمْ","aktharuhum","most of them","অধিকাংশই তাদের"],["لَا","lā","(do) not","না"],["يَعْلَمُونَ","ya‘lamūna","know","জানে"],["ٱلْحَقَّ ۖ","l-ḥaqa","the truth","প্রকৃত সত্যকে"],["فَهُم","fahum","so they","ফলে তারা"],["مُّعْرِضُونَ","mu‘'riḍūna","(are) averse","মুখ ফিরিয়ে নেয়"]],"t":"أَمِ <h>ٱ</>تَّخَذُو<s>ا۟</> مِ<k>ن دُ</>ونِ<o>هِۦٓ</> ءَالِهَ<k>ةًۭ ۖ قُ</>لْ هَاتُو<s>ا۟</> بُرْ<m>هَٰ</>نَكُمْ ۖ <m>هَٰ</>ذَا ذِكْرُ <d>مَن مَّ</>عِىَ وَذِكْرُ مَ<k>ن قَ</><q>بْ</>لِى ۗ بَلْ أَكْثَرُهُمْ لَا يَعْلَمُونَ <h>ٱ</>لْحَقَّ ۖ فَ<y>هُم مُّ</>عْرِ<p>ضُو</>نَ"},{"n":25,"w":[["وَمَآ","wamā","And not","এবং না"],["أَرْسَلْنَا","arsalnā","We sent","আমরা পাঠিয়েছি"],["مِن","min","before you","থেকে"],["قَبْلِكَ","qablika","before you","পূর্ব তোমার"],["مِن","min","any","কোন"],["رَّسُولٍ","rasūlin","Messenger","রাসূলকে"],["إِلَّا","illā","but","এ ছাড়া যে"],["نُوحِىٓ","nūḥī","We reveal(ed)","ওহী করেছি আমরা"],["إِلَيْهِ","ilayhi","to him","তার কাছে"],["أَنَّهُۥ","annahu","that [He]","এই যে"],["لَآ","lā","(There is) no","\"নেই"],["إِلَـٰهَ","ilāha","god","কোন ইলাহ"],["إِلَّآ","illā","except","ছাড়া"],["أَنَا۠","anā","Me","আমি"],["فَٱعْبُدُونِ","fa-u‘'budūni","so worship Me","সুতরাং তোমরা আমারই ইবাদাত করো\""]],"t":"وَ<o>مَآ</> أَرْسَلْنَا مِ<k>ن قَ</><q>بْ</>لِكَ <w>مِن رَّ</>سُولٍ إِلَّا نُو<o>حِىٓ</> إِلَيْهِ أَ<g>نَّ</>هُ<m>ۥ</> <o>لَآ</> إِ<m>لَٰ</>هَ إِ<o>لَّآ</> أَنَا۠ فَ<h>ٱ</>عْبُ<p>دُو</>نِ"},{"n":26,"w":[["وَقَالُوا۟","waqālū","And they say","এবং তারা বলে"],["ٱتَّخَذَ","ittakhadha","Has taken","\"গ্রহণ করেছেন"],["ٱلرَّحْمَـٰنُ","l-raḥmānu","the Most Gracious","দয়াময়"],["وَلَدًۭا ۗ","waladan","a son","সন্তান\""],["سُبْحَـٰنَهُۥ ۚ","sub'ḥānahu","Glorified is He","তিনি মহান পবিত্র"],["بَلْ","bal","Nay","বরং"],["عِبَادٌۭ","‘ibādun","(they are) slaves","(ফিরিশতারা) দাস"],["مُّكْرَمُونَ","muk'ramūna","honored","সম্মানিত"]],"t":"وَقَالُو<s>ا۟</> <h>ٱ</>تَّخَذَ <h>ٱ</><l>ل</>رَّحْ<m>مَٰ</>نُ وَلَ<k>دًۭا ۗ سُ</><q>بْ</><m>حَٰ</>نَهُ<m>ۥ</> ۚ بَلْ عِبَا<d>دٌۭ مُّ</>كْرَ<p>مُو</>نَ"},{"n":27,"w":[["لَا","lā","Not","না"],["يَسْبِقُونَهُۥ","yasbiqūnahu","they (can) precede Him","তাঁর আগে বাড়ে তারা"],["بِٱلْقَوْلِ","bil-qawli","in word","কথার মাধ্যমে"],["وَهُم","wahum","and they","এবং তারা"],["بِأَمْرِهِۦ","bi-amrihi","by His command","তাঁর হুকুম অনুসারে"],["يَعْمَلُونَ","ya‘malūna","act","কাজ করে"]],"t":"لَا يَسْبِقُونَهُ<m>ۥ</> بِ<h>ٱ</>لْقَوْلِ وَ<f>هُم بِ</>أَمْرِ<m>هِۦ</> يَعْمَ<p>لُو</>نَ"},{"n":28,"w":[["يَعْلَمُ","ya‘lamu","He knows","তিনি জানেন"],["مَا","mā","what","যা (আছে)"],["بَيْنَ","bayna","(is) before them","মাঝে"],["أَيْدِيهِمْ","aydīhim","(is) before them","তাদের হাতের (সামনে)"],["وَمَا","wamā","and what","এবং যা (আছে)"],["خَلْفَهُمْ","khalfahum","(is) behind them","তাদের পিছনে"],["وَلَا","walā","and not","এবং না"],["يَشْفَعُونَ","yashfa‘ūna","they (can) intercede","তারা সুপারিশ করে"],["إِلَّا","illā","except","এ ছাড়া"],["لِمَنِ","limani","for whom","জন্যে তাদের (যাদের প্রতি)"],["ٱرْتَضَىٰ","ir'taḍā","He approves","(আল্লাহ্‌) সন্তুষ্ট হন"],["وَهُم","wahum","And they","এবং তারা"],["مِّنْ","min","from","কারণে"],["خَشْيَتِهِۦ","khashyatihi","fear of Him","তাঁর ভয়ের"],["مُشْفِقُونَ","mush'fiqūna","stand in awe","ভীত সন্ত্রস্ত"]],"t":"يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ وَلَا يَشْفَعُونَ إِلَّا لِمَنِ <h>ٱ</>رْتَضَىٰ وَ<y>هُم مِّ</>نْ خَشْيَتِ<m>هِۦ</> مُشْفِ<p>قُو</>نَ"},{"n":29,"w":[["۞ وَمَن","waman","And whoever","এবং কেউ"],["يَقُلْ","yaqul","says","(যদি) বলে"],["مِنْهُمْ","min'hum","of them","তাদের মধ্য হ'তে"],["إِنِّىٓ","innī","Indeed, I am","\"আমিও নিশ্চয়ই"],["إِلَـٰهٌۭ","ilāhun","a god","একজন ইলাহ"],["مِّن","min","besides Him","ছাড়া\""],["دُونِهِۦ","dūnihi","besides Him","তিনি\""],["فَذَٰلِكَ","fadhālika","Then that","তবে এ কারণে"],["نَجْزِيهِ","najzīhi","We will recompense","তাকে শাস্তি দিবো আমরা"],["جَهَنَّمَ ۚ","jahannama","(with) Hell","জাহান্নামে"],["كَذَٰلِكَ","kadhālika","Thus","এরূপে"],["نَجْزِى","najzī","We recompense","শাস্তি দিই আমরা"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","সীমালঙ্ঘনকারীদেরকে"]],"t":"۞ وَ<d>مَن يَ</>قُلْ مِنْهُمْ إِ<g>نِّ</><o>ىٓ</> إِ<m>لَٰ</><d>هٌۭ مِّ</><k>ن دُ</>ونِ<m>هِۦ</> فَ<m>ذَٰ</>لِكَ نَ<q>جْ</>زِيهِ جَهَ<g>نَّ</>مَ ۚ كَ<m>ذَٰ</>لِكَ نَ<q>جْ</>زِى <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":30,"w":[["أَوَلَمْ","awalam","Do not","কি নি"],["يَرَ","yara","see","ভেবে দেখে"],["ٱلَّذِينَ","alladhīna","those who","(তারা) যারা"],["كَفَرُوٓا۟","kafarū","disbelieved","অস্বীকার করেছে"],["أَنَّ","anna","that","যে"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","the heavens","আকাশমন্ডলী"],["وَٱلْأَرْضَ","wal-arḍa","and the earth","ও পৃথিবী"],["كَانَتَا","kānatā","were","উভয়ে ছিলো"],["رَتْقًۭا","ratqan","a joined entity","মিলিত অবস্থায়"],["فَفَتَقْنَـٰهُمَا ۖ","fafataqnāhumā","then We parted them","অতঃপর উভয়কে আমরা পৃথক করে দিয়েছি"],["وَجَعَلْنَا","waja‘alnā","and We made","এবং আমরা বানিয়েছি"],["مِنَ","mina","from","থেকে"],["ٱلْمَآءِ","l-māi","[the] water","পানি"],["كُلَّ","kulla","every","প্রত্যেক"],["شَىْءٍ","shayin","living thing","বস্তু"],["حَىٍّ ۖ","ḥayyin","living thing","জীবন্ত"],["أَفَلَا","afalā","Then will not","কি তবুও না"],["يُؤْمِنُونَ","yu'minūna","they believe","তারা বিশ্বাস করে"]],"t":"أَوَلَمْ يَرَ <h>ٱ</>لَّذِينَ كَفَ<o>رُوٓ</><s>ا۟</> أَ<g>نَّ</> <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضَ كَانَتَا رَتْ<k>قًۭا فَ</>فَتَ<q>قْ</><m>نَٰ</>هُمَا ۖ وَجَعَلْنَا مِنَ <h>ٱ</>لْ<o>مَآ</>ءِ كُلَّ شَىْءٍ حَىٍّ ۖ أَفَلَا يُؤْمِ<p>نُو</>نَ"},{"n":31,"w":[["وَجَعَلْنَا","waja‘alnā","And We (have) placed","এবং আমরা বানিয়েছি"],["فِى","fī","in","মধ্যে"],["ٱلْأَرْضِ","l-arḍi","the earth","পৃথিবীর"],["رَوَٰسِىَ","rawāsiya","firmly set mountains","পর্বতসমূহ"],["أَن","an","lest","যেন (না)"],["تَمِيدَ","tamīda","it (should) shake","তা ঢলে পড়ে"],["بِهِمْ","bihim","with them","নিয়ে তাদের"],["وَجَعَلْنَا","waja‘alnā","and We made","এবং আমরা বানিয়েছি"],["فِيهَا","fīhā","therein","তার মধ্যে"],["فِجَاجًۭا","fijājan","broad passes","প্রশস্ত"],["سُبُلًۭا","subulan","(as) ways","রাস্তাসমূহ"],["لَّعَلَّهُمْ","la‘allahum","so that they may","যেন তারা"],["يَهْتَدُونَ","yahtadūna","(be) guided","পথ পেতে পারে"]],"t":"وَجَعَلْنَا فِى <h>ٱ</>لْأَرْضِ رَ<m>وَٰ</>سِىَ أَ<k>ن تَ</>مِيدَ بِهِمْ وَجَعَلْنَا فِيهَا فِجَا<k>جًۭا سُ</>بُلًۭ<w>ا لَّ</>عَلَّهُمْ يَهْتَ<p>دُو</>نَ"},{"n":32,"w":[["وَجَعَلْنَا","waja‘alnā","And We made","এবং আমরা বানিয়েছি"],["ٱلسَّمَآءَ","l-samāa","the sky","আকাশকে"],["سَقْفًۭا","saqfan","a roof","ছাদস্বরূপ"],["مَّحْفُوظًۭا ۖ","maḥfūẓan","protected","সুরক্ষিত"],["وَهُمْ","wahum","But they","অথচ তারা"],["عَنْ","‘an","from","থেকে"],["ءَايَـٰتِهَا","āyātihā","its Signs","তাঁর নিদর্শনাবলী"],["مُعْرِضُونَ","mu‘'riḍūna","turn away","মুখ ফিরিয়ে নিচ্ছে"]],"t":"وَجَعَلْنَا <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءَ سَ<q>قْ</><d>فًۭا مَّ</>حْفُو<d>ظًۭا ۖ وَ</>هُمْ عَنْ ءَا<m>يَٰ</>تِهَا مُعْرِ<p>ضُو</>نَ"},{"n":33,"w":[["وَهُوَ","wahuwa","And He","এবং তিনিই"],["ٱلَّذِى","alladhī","(is) the One Who","যিনি"],["خَلَقَ","khalaqa","created","সৃষ্টি করেছেন"],["ٱلَّيْلَ","al-layla","the night","রাতকে"],["وَٱلنَّهَارَ","wal-nahāra","and the day","ও দিনকে"],["وَٱلشَّمْسَ","wal-shamsa","and the sun","এবং সূর্যকে"],["وَٱلْقَمَرَ ۖ","wal-qamara","and the moon","ও চাঁদকে"],["كُلٌّۭ","kullun","each","সবই"],["فِى","fī","in","উপর"],["فَلَكٍۢ","falakin","an orbit","কক্ষপথের"],["يَسْبَحُونَ","yasbaḥūna","floating","বিচরণ করছে"]],"t":"وَهُوَ <h>ٱ</>لَّذِى خَلَقَ <h>ٱ</>لَّيْلَ وَ<h>ٱ</><l>ل</><g>نَّ</>هَارَ وَ<h>ٱ</><l>ل</>شَّمْسَ وَ<h>ٱ</>لْقَمَرَ ۖ كُ<k>لٌّۭ فِ</>ى فَلَ<d>كٍۢ يَ</>سْبَ<p>حُو</>نَ"},{"n":34,"w":[["وَمَا","wamā","And not","এবং (হে নাবী) না"],["جَعَلْنَا","ja‘alnā","We made","আমরা বানিয়েছি"],["لِبَشَرٍۢ","libasharin","for any man","কোন মানুষের জন্যে"],["مِّن","min","before you","থেকে"],["قَبْلِكَ","qablika","before you","তোমার পূর্ব"],["ٱلْخُلْدَ ۖ","l-khul'da","[the] immortality","অমরত্ব"],["أَفَإِي۟ن","afa-in","so if","কি তবে যদি"],["مِّتَّ","mitta","you die","তুমি মৃতবরণ করো"],["فَهُمُ","fahumu","then (would) they","তারা তাহ'লে"],["ٱلْخَـٰلِدُونَ","l-khālidūna","live forever","অমর হবে কি"]],"t":"وَمَا جَعَلْنَا لِبَشَ<d>رٍۢ مِّ</><k>ن قَ</><q>بْ</>لِكَ <h>ٱ</>لْخُلْدَ ۖ أَفَإِ<s>ي۟</><d>ن مِّ</>تَّ فَهُمُ <h>ٱ</>لْ<m>خَٰ</>لِ<p>دُو</>نَ"},{"n":35,"w":[["كُلُّ","kullu","Every","প্রত্যেক"],["نَفْسٍۢ","nafsin","soul","প্রাণীই"],["ذَآئِقَةُ","dhāiqatu","(will) taste","স্বাদ গ্রহণকারী"],["ٱلْمَوْتِ ۗ","l-mawti","[the] death","মৃত্যূর"],["وَنَبْلُوكُم","wanablūkum","And We test you","এবং তোমাদের আমরা পরীক্ষা করি"],["بِٱلشَّرِّ","bil-shari","with [the] bad","দিয়ে মন্দ"],["وَٱلْخَيْرِ","wal-khayri","and [the] good","ও ভাল (দিয়ে)"],["فِتْنَةًۭ ۖ","fit'natan","(as) a trial","পরিক্ষা (স্বরুপ)"],["وَإِلَيْنَا","wa-ilaynā","and to Us","এবং আমাদেরই দিকে"],["تُرْجَعُونَ","tur'ja‘ūna","you will be returned","তোমাদের ফিরিয়ে আনা হবে"]],"t":"كُلُّ نَفْ<k>سٍۢ ذَ</><o>آ</>ئِقَةُ <h>ٱ</>لْمَوْتِ ۗ وَنَ<q>بْ</>لُو<f>كُم بِ</><h>ٱ</><l>ل</>شَّرِّ وَ<h>ٱ</>لْخَيْرِ فِتْنَ<d>ةًۭ ۖ وَ</>إِلَيْنَا تُرْجَ<p>عُو</>نَ"},{"n":36,"w":[["وَإِذَا","wa-idhā","And when","এবং যখন"],["رَءَاكَ","raāka","they see you","তোমাকে দেখে"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوٓا۟","kafarū","disbelieve","অস্বীকার করেছে"],["إِن","in","not","না"],["يَتَّخِذُونَكَ","yattakhidhūnaka","they take you","তোমাকে তারা গ্রহণ করবে"],["إِلَّا","illā","except","এ ছাড়া"],["هُزُوًا","huzuwan","(in) ridicule","বিদ্রুপের পাত্র রূপে"],["أَهَـٰذَا","ahādhā","Is this","\"(এবং বলে) এই কি"],["ٱلَّذِى","alladhī","the one who","(সেই ব্যক্তি) যে"],["يَذْكُرُ","yadhkuru","mentions","সমালোচনা করে"],["ءَالِهَتَكُمْ","ālihatakum","your gods","তোমাদের দেবদেবীদেরকে\""],["وَهُم","wahum","And they","অথচ তারা"],["بِذِكْرِ","bidhik'ri","at (the) mention","নিয়ে আলোচনা"],["ٱلرَّحْمَـٰنِ","l-raḥmāni","(of) the Most Gracious","রাহমানের"],["هُمْ","hum","[they]","তারাই"],["كَـٰفِرُونَ","kāfirūna","(are) disbelievers","অস্বীকারকারী"]],"t":"وَإِذَا رَءَاكَ <h>ٱ</>لَّذِينَ كَفَ<o>رُوٓ</><s>ا۟</> <d>إِن يَ</>تَّخِذُونَكَ إِلَّا هُزُوًا أَ<m>هَٰ</>ذَا <h>ٱ</>لَّذِى يَذْكُرُ ءَالِهَتَكُمْ وَ<f>هُم بِ</>ذِكْرِ <h>ٱ</><l>ل</>رَّحْ<m>مَٰ</>نِ هُمْ <m>كَٰ</>فِ<p>رُو</>نَ"},{"n":37,"w":[["خُلِقَ","khuliqa","Is created","সৃষ্টি করা হয়েছে"],["ٱلْإِنسَـٰنُ","l-insānu","the man","মানুষকে"],["مِنْ","min","of","দিয়ে"],["عَجَلٍۢ ۚ","‘ajalin","haste","তাড়াহুড়া প্রবৃত্তি"],["سَأُو۟رِيكُمْ","sa-urīkum","I will show you","শীঘ্রই তোমাদেরকে আমি দেখাবো"],["ءَايَـٰتِى","āyātī","My Signs","আমার নিদর্শনাবলী"],["فَلَا","falā","so (do) not","সুতরাং না"],["تَسْتَعْجِلُونِ","tasta‘jilūni","ask Me to hasten","আমার কাছে তোমরা তাড়াহুড়া করো"]],"t":"خُلِقَ <h>ٱ</>لْإِ<k>نسَٰ</>نُ مِنْ عَجَ<k>لٍۢ ۚ سَ</>أُ<s>و۟</>رِيكُمْ ءَا<m>يَٰ</>تِى فَلَا تَسْتَعْجِ<p>لُو</>نِ"},{"n":38,"w":[["وَيَقُولُونَ","wayaqūlūna","And they say","এবং তারা বলে"],["مَتَىٰ","matā","When (will be fulfilled)","\"কখন (পূর্ণ হবে)"],["هَـٰذَا","hādhā","this","এই"],["ٱلْوَعْدُ","l-wa‘du","promise","(হুমকির) প্রতিশ্রুতি"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you are","তোমরা হও"],["صَـٰدِقِينَ","ṣādiqīna","truthful","সত্যবাদী\""]],"t":"وَيَقُولُونَ مَتَىٰ <m>هَٰ</>ذَا <h>ٱ</>لْوَعْدُ إِ<k>ن كُنتُ</>مْ <m>صَٰ</>دِ<p>قِي</>نَ"},{"n":39,"w":[["لَوْ","law","If","(হায়) যদি"],["يَعْلَمُ","ya‘lamu","knew","জানতো"],["ٱلَّذِينَ","alladhīna","those who","যারা"],["كَفَرُوا۟","kafarū","disbelieved","অস্বীকার করেছে"],["حِينَ","ḥīna","(the) time","সে সময়ে (যখন)"],["لَا","lā","(when) not","না"],["يَكُفُّونَ","yakuffūna","they will avert","তারা প্রতিরোধ করতে পারবে"],["عَن","‘an","from","হ'তে"],["وُجُوهِهِمُ","wujūhihimu","their faces","তাদের মুখমন্ডলগুলো (সামনের দিক)"],["ٱلنَّارَ","l-nāra","the Fire","আগুনকে"],["وَلَا","walā","and not","আর না"],["عَن","‘an","from","হ'তে"],["ظُهُورِهِمْ","ẓuhūrihim","their backs","তাদের পৃষ্ঠসমূহ (পিছনেরর দিক)"],["وَلَا","walā","and not","আর না"],["هُمْ","hum","they","তাদের"],["يُنصَرُونَ","yunṣarūna","will be helped","সাহায্য করা হবে"]],"t":"لَوْ يَعْلَمُ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> حِينَ لَا يَكُفُّونَ <d>عَن وُ</>جُوهِهِمُ <h>ٱ</><l>ل</><g>نَّ</>ارَ وَلَا عَ<k>ن ظُ</>هُورِهِمْ وَلَا هُمْ يُ<k>نصَ</><p>رُو</>نَ"},{"n":40,"w":[["بَلْ","bal","Nay","বরং"],["تَأْتِيهِم","tatīhim","it will come to them","তাদের কাছে আসবে"],["بَغْتَةًۭ","baghtatan","unexpectedly","হঠাৎ করে"],["فَتَبْهَتُهُمْ","fatabhatuhum","and bewilder them","অতঃপর তাদেরকে হতভম্ব করে দিবে"],["فَلَا","falā","then not","তখন না"],["يَسْتَطِيعُونَ","yastaṭī‘ūna","they will be able","তারা সক্ষম হবে"],["رَدَّهَا","raddahā","to repel it","তা রোধ করতে"],["وَلَا","walā","and not","আর না"],["هُمْ","hum","they","তাদের"],["يُنظَرُونَ","yunẓarūna","will be given respite","অবকাশ দেয়া হবে"]],"t":"بَلْ تَأْتِي<f>هِم بَ</>غْتَ<k>ةًۭ فَ</>تَ<q>بْ</>هَتُهُمْ فَلَا يَسْتَطِيعُونَ رَدَّهَا وَلَا هُمْ يُ<k>نظَ</><p>رُو</>نَ"},{"n":41,"w":[["وَلَقَدِ","walaqadi","And verily","এবং নিশ্চয়ই"],["ٱسْتُهْزِئَ","us'tuh'zi-a","were mocked","বিদ্রুপ করা হয়েছে"],["بِرُسُلٍۢ","birusulin","Messengers","নিয়ে রাসূলদেরকে"],["مِّن","min","before you","থেকে"],["قَبْلِكَ","qablika","before you","তোমার পূর্ব"],["فَحَاقَ","faḥāqa","then surrounded","অতঃপর ঘিরে নিয়েছিলো"],["بِٱلَّذِينَ","bi-alladhīna","those who","সহ তাদেরকে"],["سَخِرُوا۟","sakhirū","mocked","ঠাট্টা করেছিল (যারা)"],["مِنْهُم","min'hum","from them","তাদের মধ্য হ'তে"],["مَّا","mā","what","ঐ জিনিস"],["كَانُوا۟","kānū","they used","তারা ছিলো"],["بِهِۦ","bihi","at it","যা নিয়ে"],["يَسْتَهْزِءُونَ","yastahziūna","(to) mock","বিদ্রুত করত"]],"t":"وَلَقَدِ <h>ٱ</>سْتُهْزِئَ بِرُسُ<d>لٍۢ مِّ</><k>ن قَ</><q>بْ</>لِكَ فَحَاقَ بِ<h>ٱ</>لَّذِينَ سَخِرُو<s>ا۟</> مِنْ<y>هُم مَّ</>ا كَانُو<s>ا۟</> بِ<m>هِۦ</> يَسْتَهْزِ<p>ءُو</>نَ"},{"n":42,"w":[["قُلْ","qul","Say","(হে নাবী) বলো"],["مَن","man","Who","\"কে"],["يَكْلَؤُكُم","yakla-ukum","(can) protect you","তোমাদেরকে রক্ষা করতে পারে"],["بِٱلَّيْلِ","bi-al-layli","in the night","বেলায় রাতের"],["وَٱلنَّهَارِ","wal-nahāri","and the day","বা দিনের"],["مِنَ","mina","from","থেকে"],["ٱلرَّحْمَـٰنِ ۗ","l-raḥmāni","the Most Gracious","রাহমান\""],["بَلْ","bal","Yet","বরং"],["هُمْ","hum","they","তারাই"],["عَن","‘an","from","হ'তে"],["ذِكْرِ","dhik'ri","(the) remembrance","স্বরণ"],["رَبِّهِم","rabbihim","(of) their Lord","তাদের রবের"],["مُّعْرِضُونَ","mu‘'riḍūna","turn away","মুখ ফিরিয়ে নেয়"]],"t":"قُلْ <d>مَن يَ</>كْلَؤُ<f>كُم بِ</><h>ٱ</>لَّيْلِ وَ<h>ٱ</><l>ل</><g>نَّ</>هَارِ مِنَ <h>ٱ</><l>ل</>رَّحْ<m>مَٰ</>نِ ۗ بَلْ هُمْ عَ<k>ن ذِ</>كْرِ رَبِّ<y>هِم مُّ</>عْرِ<p>ضُو</>نَ"},{"n":43,"w":[["أَمْ","am","Or","কি"],["لَهُمْ","lahum","have they","তাদের জন্যে (আছে)"],["ءَالِهَةٌۭ","ālihatun","gods","দেবদেবী"],["تَمْنَعُهُم","tamna‘uhum","(to) defend them","তাদের রক্ষা করতে পারে"],["مِّن","min","from","থেকে"],["دُونِنَا ۚ","dūninā","Us","আমাদের ছাড়া"],["لَا","lā","Not","না"],["يَسْتَطِيعُونَ","yastaṭī‘ūna","they are able","তারা সক্ষম"],["نَصْرَ","naṣra","(to) help","সাহায্য করতে"],["أَنفُسِهِمْ","anfusihim","themselves","তাদের নিজেদের"],["وَلَا","walā","and not","আর না"],["هُم","hum","they","তাদেরকে"],["مِّنَّا","minnā","from Us","আমাদের বিরুদ্ধে"],["يُصْحَبُونَ","yuṣ'ḥabūna","can be protected","সহযোগিতা দেয়া হবে"]],"t":"أَمْ لَهُمْ ءَالِهَ<k>ةٌۭ تَ</>مْنَعُ<y>هُم مِّ</><k>ن دُ</>ونِنَا ۚ لَا يَسْتَطِيعُونَ نَصْرَ أَ<k>نفُ</>سِهِمْ وَلَا <y>هُم مِّ</><g>نَّ</>ا يُصْحَ<p>بُو</>نَ"},{"n":44,"w":[["بَلْ","bal","Nay","বরং"],["مَتَّعْنَا","matta‘nā","We gave provision","আমরা ভোগসামগ্রী দিয়েছি"],["هَـٰٓؤُلَآءِ","hāulāi","(to) these","তাদেরকে"],["وَءَابَآءَهُمْ","waābāahum","and their fathers","ও পিতৃপুরুষদেরকে তাদের"],["حَتَّىٰ","ḥattā","until","এমনকি"],["طَالَ","ṭāla","grew long","দীর্ঘ হয়েছিলো"],["عَلَيْهِمُ","‘alayhimu","for them","তাদের জন্য"],["ٱلْعُمُرُ ۗ","l-‘umuru","the life","আয়ু"],["أَفَلَا","afalā","Then do not","কি তবে না"],["يَرَوْنَ","yarawna","they see","তারা দেখে"],["أَنَّا","annā","that We","যে আমরা"],["نَأْتِى","natī","We come","আনছি"],["ٱلْأَرْضَ","l-arḍa","(to) the land","জমিনকে"],["نَنقُصُهَا","nanquṣuhā","We reduce it","তা সংকুচিত করে আমরা"],["مِنْ","min","from","হ'তে"],["أَطْرَافِهَآ ۚ","aṭrāfihā","its borders","তার চারদিক"],["أَفَهُمُ","afahumu","So is (it) they","কি তবুও তারা"],["ٱلْغَـٰلِبُونَ","l-ghālibūna","(who will be) overcoming","বিজয়ী হবে"]],"t":"بَلْ مَتَّعْنَا <o>هَٰٓؤُلَآ</>ءِ وَءَا<o>بَآ</>ءَهُمْ حَتَّىٰ طَالَ عَلَيْهِمُ <h>ٱ</>لْعُمُرُ ۗ أَفَلَا يَرَوْنَ أَ<g>نَّ</>ا نَأْتِى <h>ٱ</>لْأَرْضَ نَ<k>نقُ</>صُهَا مِنْ أَ<q>طْ</>رَافِ<o>هَآ ۚ</> أَفَهُمُ <h>ٱ</>لْ<m>غَٰ</>لِ<p>بُو</>نَ"},{"n":45,"w":[["قُلْ","qul","Say","বলো"],["إِنَّمَآ","innamā","Only","\"মূলতঃ"],["أُنذِرُكُم","undhirukum","I warn you","তোমাদের সতর্ক করছি আমি"],["بِٱلْوَحْىِ ۚ","bil-waḥyi","by the revelation","দ্বারা ওহী\""],["وَلَا","walā","But not","কিন্তু না"],["يَسْمَعُ","yasma‘u","hear","শুনে"],["ٱلصُّمُّ","l-ṣumu","the deaf","বধির"],["ٱلدُّعَآءَ","l-du‘āa","the call","কোন আহ্বান"],["إِذَا","idhā","when","যখন"],["مَا","mā","when","যা"],["يُنذَرُونَ","yundharūna","they are warned","তাদের সতর্ক করা হয়"]],"t":"قُلْ إِ<g>نَّ</><o>مَآ</> أُ<k>نذِ</>رُ<f>كُم بِ</><h>ٱ</>لْوَحْىِ ۚ وَلَا يَسْمَعُ <h>ٱ</><l>ل</>صُّ<g>مُّ</> <h>ٱ</><l>ل</>دُّ<o>عَآ</>ءَ إِذَا مَا يُ<k>نذَ</><p>رُو</>نَ"},{"n":46,"w":[["وَلَئِن","wala-in","And if","আর যদি অবশ্যই"],["مَّسَّتْهُمْ","massathum","touches them","তাদের স্পর্শ করে"],["نَفْحَةٌۭ","nafḥatun","a whiff","একটা ঝাপটাও"],["مِّنْ","min","of","থেকে"],["عَذَابِ","‘adhābi","(the) punishment","শাস্তি"],["رَبِّكَ","rabbika","(of) your Lord","তোমার রবের"],["لَيَقُولُنَّ","layaqūlunna","surely they will say","অবশ্যই তারা বলবে"],["يَـٰوَيْلَنَآ","yāwaylanā","O woe to us","\"হায়! আমাদের দুর্ভোগ"],["إِنَّا","innā","Indeed, we","নিশ্চয়ই আমরা"],["كُنَّا","kunnā","[we] were","ছিলাম আমরা"],["ظَـٰلِمِينَ","ẓālimīna","wrongdoers","সীমালঙ্ঘনকারী\""]],"t":"وَلَ<d>ئِن مَّ</>سَّتْهُمْ نَفْحَ<d>ةٌۭ مِّ</>نْ عَذَابِ رَبِّكَ لَيَقُولُ<g>نَّ</> <m>يَٰ</>وَيْلَ<o>نَآ</> إِ<g>نَّ</>ا كُ<g>نَّ</>ا <m>ظَٰ</>لِ<p>مِي</>نَ"},{"n":47,"w":[["وَنَضَعُ","wanaḍa‘u","And We set","এবং স্থাপন করবো আমরা"],["ٱلْمَوَٰزِينَ","l-mawāzīna","the scales","মানদন্ডসমূহ"],["ٱلْقِسْطَ","l-qis'ṭa","(of) the justice","ন্যায়ের"],["لِيَوْمِ","liyawmi","for (the) Day","জন্য দিনের"],["ٱلْقِيَـٰمَةِ","l-qiyāmati","(of) the Resurrection","ক্বিয়ামাতের"],["فَلَا","falā","so not","ফলে না"],["تُظْلَمُ","tuẓ'lamu","will be wronged","অবিচার করা হবে"],["نَفْسٌۭ","nafsun","any soul","কাউকে"],["شَيْـًۭٔا ۖ","shayan","(in) anything","কিছুমাত্রও"],["وَإِن","wa-in","And if","এবং যদি"],["كَانَ","kāna","(there) be","হয় (কৃতকর্ম)"],["مِثْقَالَ","mith'qāla","weight","পরিমাণও"],["حَبَّةٍۢ","ḥabbatin","(of) a seed","একদানা"],["مِّنْ","min","of","থেকে"],["خَرْدَلٍ","khardalin","a mustard","সরিষার"],["أَتَيْنَا","ataynā","We will bring","আমরা আসবো"],["بِهَا ۗ","bihā","[with] it","নিয়ে তাকে (সামনে)"],["وَكَفَىٰ","wakafā","And sufficient","এবং যথেষ্ট"],["بِنَا","binā","(are) We","আমরাই"],["حَـٰسِبِينَ","ḥāsibīna","(as) Reckoners","হিসাবগ্রহণকারীরূপে"]],"t":"وَنَضَعُ <h>ٱ</>لْمَ<m>وَٰ</>زِينَ <h>ٱ</>لْقِسْطَ لِيَوْمِ <h>ٱ</>لْقِ<m>يَٰ</>مَةِ فَلَا تُظْلَمُ نَفْ<k>سٌۭ شَ</><d>يْـًۭٔا ۖ وَ</>إِ<k>ن كَ</>انَ مِثْقَالَ حَبَّ<d>ةٍۢ مِّ</>نْ خَرْدَلٍ أَتَيْنَا بِهَا ۗ وَكَفَىٰ بِنَا <m>حَٰ</>سِ<p>بِي</>نَ"},{"n":48,"w":[["وَلَقَدْ","walaqad","And verily","এবং অবশ্যই"],["ءَاتَيْنَا","ātaynā","We gave","আমরা দিয়েছি"],["مُوسَىٰ","mūsā","Musa","মূসাকে"],["وَهَـٰرُونَ","wahārūna","and Harun","ও হারূনকে"],["ٱلْفُرْقَانَ","l-fur'qāna","the Criterion","ফুরকান"],["وَضِيَآءًۭ","waḍiyāan","and a light","এবং আলো"],["وَذِكْرًۭا","wadhik'ran","and a Reminder","ও উপদেশ"],["لِّلْمُتَّقِينَ","lil'muttaqīna","for the righteous","জন্যে মুত্তাক্বীদের"]],"t":"وَلَقَ<q>دْ</> ءَاتَيْنَا مُوسَىٰ وَ<m>هَٰ</>رُونَ <h>ٱ</>لْفُرْقَانَ وَضِ<o>يَآ</><d>ءًۭ وَ</>ذِكْ<w>رًۭا لِّ</>لْمُتَّ<p>قِي</>نَ"},{"n":49,"w":[["ٱلَّذِينَ","alladhīna","Those who","যারা"],["يَخْشَوْنَ","yakhshawna","fear","ভয় করে"],["رَبَّهُم","rabbahum","their Lord","তাদের রবকে"],["بِٱلْغَيْبِ","bil-ghaybi","in the unseen","অবস্থায় অদৃশ্য"],["وَهُم","wahum","and they","এবং তারাই"],["مِّنَ","mina","of","সম্পর্কে"],["ٱلسَّاعَةِ","l-sā‘ati","the Hour","ক্বিয়ামাহ"],["مُشْفِقُونَ","mush'fiqūna","(are) afraid","ভীতসন্ত্রস্ত"]],"t":"ٱلَّذِينَ يَخْشَوْنَ رَبَّ<f>هُم بِ</><h>ٱ</>لْغَيْبِ وَ<y>هُم مِّ</>نَ <h>ٱ</><l>ل</>سَّاعَةِ مُشْفِ<p>قُو</>نَ"},{"n":50,"w":[["وَهَـٰذَا","wahādhā","And this","আর এই"],["ذِكْرٌۭ","dhik'run","(is) a Reminder","উপদেশ (ক্বুর'আন)"],["مُّبَارَكٌ","mubārakun","blessed","কল্যাণময়"],["أَنزَلْنَـٰهُ ۚ","anzalnāhu","which We (have) revealed","তা আমরা অবতীর্ণ করেছি"],["أَفَأَنتُمْ","afa-antum","Then are you","কি তোমরা তবুও"],["لَهُۥ","lahu","of it","জন্যে তার"],["مُنكِرُونَ","munkirūna","rejecters","অস্বীকারকারী হবে"]],"t":"وَ<m>هَٰ</>ذَا ذِكْ<d>رٌۭ مُّ</>بَارَكٌ أَ<k>نزَ</>لْ<m>نَٰ</>هُ ۚ أَفَأَ<k>نتُ</>مْ لَهُ<m>ۥ</> مُ<k>نكِ</><p>رُو</>نَ"},{"n":51,"w":[["۞ وَلَقَدْ","walaqad","And verily","এবং নিশ্চয়ই"],["ءَاتَيْنَآ","ātaynā","We gave","আমরা দিয়েছি"],["إِبْرَٰهِيمَ","ib'rāhīma","Ibrahim","ইবরাহীম কে"],["رُشْدَهُۥ","rush'dahu","his guidance","তার সৎপথের বুদ্ধি জ্ঞান"],["مِن","min","before","থেকে"],["قَبْلُ","qablu","before","ইতিপূর্ব"],["وَكُنَّا","wakunnā","and We were","এবং আমরা ছিলাম"],["بِهِۦ","bihi","about him","সম্পর্কে তার"],["عَـٰلِمِينَ","‘ālimīna","Well-Knowing","খুব অবহিত"]],"t":"۞ وَلَقَ<q>دْ</> ءَاتَيْ<o>نَآ</> إِ<q>بْ</><m>رَٰ</>هِيمَ رُشْدَهُ<m>ۥ</> مِ<k>ن قَ</><q>بْ</>لُ وَكُ<g>نَّ</>ا بِ<m>هِۦ عَٰ</>لِ<p>مِي</>نَ"},{"n":52,"w":[["إِذْ","idh","When","যখন"],["قَالَ","qāla","he said","সে বলেছিলো"],["لِأَبِيهِ","li-abīhi","to his father","তার পিতাকে"],["وَقَوْمِهِۦ","waqawmihi","and his people","ও তার জাতিকে"],["مَا","mā","What","\"কি"],["هَـٰذِهِ","hādhihi","(are) these","এসব"],["ٱلتَّمَاثِيلُ","l-tamāthīlu","[the] statues","মূর্তিগুলো"],["ٱلَّتِىٓ","allatī","which","যার"],["أَنتُمْ","antum","you","তোমরা"],["لَهَا","lahā","to it","জন্য তাদের"],["عَـٰكِفُونَ","‘ākifūna","(are) devoted","পূজায় ব্রত আছো\""]],"t":"إِذْ قَالَ لِأَبِيهِ وَقَوْمِ<m>هِۦ</> مَا <m>هَٰ</>ذِهِ <h>ٱ</><l>ل</>تَّمَاثِيلُ <h>ٱ</>لَّ<o>تِىٓ</> أَ<k>نتُ</>مْ لَهَا <m>عَٰ</>كِ<p>فُو</>نَ"},{"n":53,"w":[["قَالُوا۟","qālū","They said","তারা বললো"],["وَجَدْنَآ","wajadnā","We found","\"আমরা পেয়েছি"],["ءَابَآءَنَا","ābāanā","our forefathers","আমাদের পিতৃপুরুষদেরকে"],["لَهَا","lahā","of them","জন্য তাদের"],["عَـٰبِدِينَ","‘ābidīna","worshippers","উপাসনাকারীরূপে\""]],"t":"قَالُو<s>ا۟</> وَجَ<q>دْ</><o>نَآ</> ءَا<o>بَآ</>ءَنَا لَهَا <m>عَٰ</>بِ<p>دِي</>نَ"},{"n":54,"w":[["قَالَ","qāla","He said","সে বললো"],["لَقَدْ","laqad","Verily","\"নিশ্চয়ই"],["كُنتُمْ","kuntum","you are","তোমরা আছো"],["أَنتُمْ","antum","[you]","তোমরা"],["وَءَابَآؤُكُمْ","waābāukum","and your forefathers","ও তোমাদের পিতৃপুরুষরা (ছিলো)"],["فِى","fī","(were) in","মধ্যে"],["ضَلَـٰلٍۢ","ḍalālin","an error","পথভ্রষ্টতার"],["مُّبِينٍۢ","mubīnin","manifest","সুস্পষ্ট\""]],"t":"قَالَ لَقَ<q>دْ</> كُ<k>نتُ</>مْ أَ<k>نتُ</>مْ وَءَا<o>بَآ</>ؤُكُمْ فِى ضَ<m>لَٰ</><d>لٍۢ مُّ</><p>بِي</>نٍۢ"},{"n":55,"w":[["قَالُوٓا۟","qālū","They said","তারা বললো"],["أَجِئْتَنَا","aji'tanā","Have you come to us","\"আমাদের কাছে এসেছো কি"],["بِٱلْحَقِّ","bil-ḥaqi","with the truth","নিয়ে প্রকৃত সত্যকে"],["أَمْ","am","or","না"],["أَنتَ","anta","you","তুমি"],["مِنَ","mina","(are) of","অন্তর্ভুক্ত"],["ٱللَّـٰعِبِينَ","l-lā‘ibīna","those who play","কৌতুককারীদের\""]],"t":"قَا<o>لُوٓ</><s>ا۟</> أَجِئْتَنَا بِ<h>ٱ</>لْحَقِّ أَمْ أَ<k>نتَ</> مِنَ <h>ٱ</><l>ل</><m>لَّٰ</>عِ<p>بِي</>نَ"},{"n":56,"w":[["قَالَ","qāla","He said","সে বললো"],["بَل","bal","Nay","\"বরং"],["رَّبُّكُمْ","rabbukum","your Lord","তোমাদের রব (তিনিই)"],["رَبُّ","rabbu","(is the) Lord","(যিনি) রব"],["ٱلسَّمَـٰوَٰتِ","l-samāwāti","(of) the heavens","আকাশমন্ডলীর"],["وَٱلْأَرْضِ","wal-arḍi","and the earth","ও পৃথিবীর"],["ٱلَّذِى","alladhī","the One Who","যিনি"],["فَطَرَهُنَّ","faṭarahunna","created them","তাদেরকে সৃষ্টি করেছেন"],["وَأَنَا۠","wa-anā","and I am","এবং আমি"],["عَلَىٰ","‘alā","to","উপর"],["ذَٰلِكُم","dhālikum","that","এসবের উপর"],["مِّنَ","mina","of","অন্যতম"],["ٱلشَّـٰهِدِينَ","l-shāhidīna","the witnesses","সাক্ষীদাতাদের"]],"t":"قَالَ بَ<r>ل</> رَّبُّكُمْ رَبُّ <h>ٱ</><l>ل</>سَّ<m>مَٰوَٰ</>تِ وَ<h>ٱ</>لْأَرْضِ <h>ٱ</>لَّذِى فَطَرَهُ<g>نَّ</> وَأَنَا۠ عَلَىٰ <m>ذَٰ</>لِ<y>كُم مِّ</>نَ <h>ٱ</><l>ل</><m>شَّٰ</>هِ<p>دِي</>نَ"},{"n":57,"w":[["وَتَٱللَّهِ","watal-lahi","And by Allah","এবং শপথ আল্লাহর"],["لَأَكِيدَنَّ","la-akīdanna","surely, I will plan","অবশ্যই ব্যবস্থা নিবো আমি"],["أَصْنَـٰمَكُم","aṣnāmakum","(against) your idols","তোমাদের মূর্তিগুলোর"],["بَعْدَ","ba‘da","after","পরে"],["أَن","an","[that]","যে"],["تُوَلُّوا۟","tuwallū","you go away","তোমাদের চলে যাবে"],["مُدْبِرِينَ","mud'birīna","turning (your) backs","পিঠ ফিরিয়ে\""]],"t":"وَتَ<h>ٱ</>للَّهِ لَأَكِيدَ<g>نَّ</> أَصْ<m>نَٰ</>مَ<f>كُم بَ</>عْدَ أَ<k>ن تُ</>وَلُّو<s>ا۟</> مُ<q>دْ</>بِ<p>رِي</>نَ"},{"n":58,"w":[["فَجَعَلَهُمْ","faja‘alahum","So he made them","অতঃপর তাদেরকে সে করে দিলো"],["جُذَٰذًا","judhādhan","(into) pieces","টুকরো টুকরো"],["إِلَّا","illā","except","ছাড়া"],["كَبِيرًۭا","kabīran","a large (one)","বড়টা"],["لَّهُمْ","lahum","of them","তাদের"],["لَعَلَّهُمْ","la‘allahum","so that they may","যাতে তারা"],["إِلَيْهِ","ilayhi","to it","তার দিকে"],["يَرْجِعُونَ","yarji‘ūna","return","ফিরে আসে"]],"t":"فَجَعَلَهُمْ جُ<m>ذَٰ</>ذًا إِلَّا كَبِي<w>رًۭا لَّ</>هُمْ لَعَلَّهُمْ إِلَيْهِ يَرْجِ<p>عُو</>نَ"},{"n":59,"w":[["قَالُوا۟","qālū","They said","তারা বললো"],["مَن","man","Who","\"কে"],["فَعَلَ","fa‘ala","(has) done","করেছে"],["هَـٰذَا","hādhā","this","এটা"],["بِـَٔالِهَتِنَآ","biālihatinā","to our gods","সাথে আমাদের ইলাহগুলোর"],["إِنَّهُۥ","innahu","Indeed, he","সে নিশ্চয়ই"],["لَمِنَ","lamina","(is) of","অবশ্যই অন্তর্ভুক্ত"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","সীমালঙ্ঘনকারীদের\""]],"t":"قَالُو<s>ا۟</> مَ<k>ن فَ</>عَلَ <m>هَٰ</>ذَا بِـَٔالِهَتِ<o>نَآ</> إِ<g>نَّ</>هُ<m>ۥ</> لَمِنَ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":60,"w":[["قَالُوا۟","qālū","They said","তারা বললো"],["سَمِعْنَا","sami‘'nā","We heard","\"আমরা শুনেছি"],["فَتًۭى","fatan","a youth","এক যুবককেকে"],["يَذْكُرُهُمْ","yadhkuruhum","mention them","সমালোচনা করতে তাদের ব্যাপারে"],["يُقَالُ","yuqālu","he is called","বলা হয়"],["لَهُۥٓ","lahu","he is called","তার (নাম)"],["إِبْرَٰهِيمُ","ib'rāhīmu","Ibrahim","ইবরাহীম\""]],"t":"قَالُو<s>ا۟</> سَمِعْنَا فَ<d>تًۭى يَ</>ذْكُرُهُمْ يُقَالُ لَهُ<o>ۥٓ</> إِ<q>بْ</><m>رَٰ</><p>هِي</>مُ"},{"n":61,"w":[["قَالُوا۟","qālū","They said","তারা বললো"],["فَأْتُوا۟","fatū","Then bring","\"তাহ'লে আসো"],["بِهِۦ","bihi","him","নিয়ে তাকে"],["عَلَىٰٓ","‘alā","before","সামনে"],["أَعْيُنِ","a‘yuni","(the) eyes","চোখের"],["ٱلنَّاسِ","l-nāsi","(of) the people","লোকদের"],["لَعَلَّهُمْ","la‘allahum","so that they may","যাতে তারা"],["يَشْهَدُونَ","yashhadūna","bear witness","সাক্ষ্য দিতে পারে\""]],"t":"قَالُو<s>ا۟</> فَأْتُو<s>ا۟</> بِ<m>هِۦ</> عَلَ<o>ىٰٓ</> أَعْيُنِ <h>ٱ</><l>ل</><g>نَّ</>اسِ لَعَلَّهُمْ يَشْهَ<p>دُو</>نَ"},{"n":62,"w":[["قَالُوٓا۟","qālū","They said","তারা বললো"],["ءَأَنتَ","a-anta","Have you","\"কি তুমি"],["فَعَلْتَ","fa‘alta","done","করেছো"],["هَـٰذَا","hādhā","this","এটা"],["بِـَٔالِهَتِنَا","biālihatinā","to our gods","সাথে আমাদের ইলাহগুলোর"],["يَـٰٓإِبْرَٰهِيمُ","yāib'rāhīmu","O Ibrahim","হে ইবরাহীম\""]],"t":"قَا<o>لُوٓ</><s>ا۟</> ءَأَ<k>نتَ</> فَعَلْتَ <m>هَٰ</>ذَا بِـَٔالِهَتِنَا <o>يَٰٓ</>إِ<q>بْ</><m>رَٰ</><p>هِي</>مُ"},{"n":63,"w":[["قَالَ","qāla","He said","সে বললো"],["بَلْ","bal","Nay","\"বরং"],["فَعَلَهُۥ","fa‘alahu","(some doer) did it","তা করেছে"],["كَبِيرُهُمْ","kabīruhum","Their chief","প্রধান তাদের"],["هَـٰذَا","hādhā","(is) this","এটা"],["فَسْـَٔلُوهُمْ","fasalūhum","So ask them","তবে তাদেরকে জিজ্ঞেস করো"],["إِن","in","if","যদি"],["كَانُوا۟","kānū","they (can)","তারা ছিলো"],["يَنطِقُونَ","yanṭiqūna","speak","কথা বলতে পারে\""]],"t":"قَالَ بَلْ فَعَلَهُ<m>ۥ</> كَبِيرُهُمْ <m>هَٰ</>ذَا فَسْـَٔلُوهُمْ إِ<k>ن كَ</>انُو<s>ا۟</> يَ<k>نطِ</><p>قُو</>نَ"},{"n":64,"w":[["فَرَجَعُوٓا۟","faraja‘ū","So they returned","তখন তারা ফিরে এলো"],["إِلَىٰٓ","ilā","to","প্রতি"],["أَنفُسِهِمْ","anfusihim","themselves","তাদের মনের"],["فَقَالُوٓا۟","faqālū","and said","অতঃপর তারা বললো"],["إِنَّكُمْ","innakum","Indeed, you","\"তোমরা নিশ্চয়ই"],["أَنتُمُ","antumu","[you]","তোমরাই"],["ٱلظَّـٰلِمُونَ","l-ẓālimūna","(are) the wrongdoers","সীমালঙ্ঘনকারী\""]],"t":"فَرَجَ<o>عُوٓ</><s>ا۟</> إِلَ<o>ىٰٓ</> أَ<k>نفُ</>سِهِمْ فَقَا<o>لُوٓ</><s>ا۟</> إِ<g>نَّ</>كُمْ أَ<k>نتُ</>مُ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مُو</>نَ"},{"n":65,"w":[["ثُمَّ","thumma","Then","এরপর"],["نُكِسُوا۟","nukisū","they were turned","অবনত হয়ে গেলো"],["عَلَىٰ","‘alā","on","ওপর"],["رُءُوسِهِمْ","ruūsihim","their heads","তাদের মস্তকগুলোর"],["لَقَدْ","laqad","Verily","\"(এবং বলল) নিশ্চয়ই"],["عَلِمْتَ","‘alim'ta","you know","তুমি জেনেছো"],["مَا","mā","not","না"],["هَـٰٓؤُلَآءِ","hāulāi","these","এরা সব"],["يَنطِقُونَ","yanṭiqūna","(can) speak","কথা বলতে পারে\""]],"t":"ثُ<g>مَّ</> نُكِسُو<s>ا۟</> عَلَىٰ رُءُوسِهِمْ لَقَ<q>دْ</> عَلِمْتَ مَا <o>هَٰٓؤُلَآ</>ءِ يَ<k>نطِ</><p>قُو</>نَ"},{"n":66,"w":[["قَالَ","qāla","He said","সে বললো"],["أَفَتَعْبُدُونَ","afata‘budūna","Then do you worship","\"কি তবুও তোমরা ইবাদাত করবে"],["مِن","min","besides","থেকে"],["دُونِ","dūni","besides","ছাড়া"],["ٱللَّهِ","l-lahi","Allah","আল্লাহ"],["مَا","mā","what","যা"],["لَا","lā","(does) not","না"],["يَنفَعُكُمْ","yanfa‘ukum","benefit you","তোমাদের উপকার করতে পারে"],["شَيْـًۭٔا","shayan","(in) anything","কিছুমাত্র"],["وَلَا","walā","and not","আর না"],["يَضُرُّكُمْ","yaḍurrukum","harms you","তোমাদের ক্ষতি করতে পারে"]],"t":"قَالَ أَفَتَعْبُدُونَ مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ مَا لَا يَ<k>نفَ</>عُكُمْ شَ<d>يْـًۭٔا وَ</>لَا يَضُرُّكُمْ"},{"n":67,"w":[["أُفٍّۢ","uffin","Uff","ধিক"],["لَّكُمْ","lakum","to you","জন্যে তোমাদের"],["وَلِمَا","walimā","and to what","এবং (তাদের) জন্যেও যাদের"],["تَعْبُدُونَ","ta‘budūna","you worship","তোমরা উপাসনা করো"],["مِن","min","besides","থেকে"],["دُونِ","dūni","besides","ছাড়া"],["ٱللَّهِ ۖ","l-lahi","Allah","আল্লাহ"],["أَفَلَا","afalā","Then will not","কি তবুও না"],["تَعْقِلُونَ","ta‘qilūna","you use reason","তোমরা বুঝবে\""]],"t":"أُ<w>فٍّۢ لَّ</>كُمْ وَلِمَا تَعْبُدُونَ مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ ۖ أَفَلَا تَعْقِ<p>لُو</>نَ"},{"n":68,"w":[["قَالُوا۟","qālū","They said","তারা বললো"],["حَرِّقُوهُ","ḥarriqūhu","Burn him","\"তাকে পুড়িয়ে ফেলো"],["وَٱنصُرُوٓا۟","wa-unṣurū","and support","এবং তোমরা সাহায্য করো"],["ءَالِهَتَكُمْ","ālihatakum","your gods","তোমাদের দেবতাগুলোকে"],["إِن","in","if","যদি"],["كُنتُمْ","kuntum","you are","তোমরা ছিলে"],["فَـٰعِلِينَ","fā‘ilīna","doers","করতে পারো\""]],"t":"قَالُو<s>ا۟</> حَرِّقُوهُ وَ<h>ٱ</><k>نصُ</><o>رُوٓ</><s>ا۟</> ءَالِهَتَكُمْ إِ<k>ن كُنتُ</>مْ <m>فَٰ</>عِ<p>لِي</>نَ"},{"n":69,"w":[["قُلْنَا","qul'nā","We said","আমরা বললাম"],["يَـٰنَارُ","yānāru","O fire","\"হে আগুন"],["كُونِى","kūnī","Be","হয়ে যাও"],["بَرْدًۭا","bardan","cool[ness]","শীতল"],["وَسَلَـٰمًا","wasalāman","and safe[ty]","ও নিরাপদ"],["عَلَىٰٓ","‘alā","for","জন্যে"],["إِبْرَٰهِيمَ","ib'rāhīma","Ibrahim","ইবরাহীমের\""]],"t":"قُلْنَا <m>يَٰ</>نَارُ كُونِى بَرْ<d>دًۭا وَ</>سَ<m>لَٰ</>مًا عَلَ<o>ىٰٓ</> إِ<q>بْ</><m>رَٰ</><p>هِي</>مَ"},{"n":70,"w":[["وَأَرَادُوا۟","wa-arādū","And they intended","এবং তারা চেয়েছিলো"],["بِهِۦ","bihi","for him","সাথে তার"],["كَيْدًۭا","kaydan","a plan","এক ফন্দি আঁটতে"],["فَجَعَلْنَـٰهُمُ","faja‘alnāhumu","but We made them","কিন্তু তাদেরকে আমরা করে দিয়েছিলাম"],["ٱلْأَخْسَرِينَ","l-akhsarīna","the greatest losers","সর্বাধিক ক্ষতিগ্রস্ত"]],"t":"وَأَرَادُو<s>ا۟</> بِ<m>هِۦ</> كَيْ<k>دًۭا فَ</>جَعَلْ<m>نَٰ</>هُمُ <h>ٱ</>لْأَخْسَ<p>رِي</>نَ"},{"n":71,"w":[["وَنَجَّيْنَـٰهُ","wanajjaynāhu","And We delivered him","এবং তাকে আমরা উদ্ধার করলাম"],["وَلُوطًا","walūṭan","and Lut","ও লূতকে"],["إِلَى","ilā","to","দিকে"],["ٱلْأَرْضِ","l-arḍi","the land","(সেই) দেশের"],["ٱلَّتِى","allatī","which","যা"],["بَـٰرَكْنَا","bāraknā","We (had) blessed","আমরা কল্যাণ দিয়েছি"],["فِيهَا","fīhā","[in it]","তার মধ্যে"],["لِلْعَـٰلَمِينَ","lil'‘ālamīna","for the worlds","জন্যে বিশ্ববাসীর"]],"t":"وَنَجَّيْ<m>نَٰ</>هُ وَلُوطًا إِلَى <h>ٱ</>لْأَرْضِ <h>ٱ</>لَّتِى <m>بَٰ</>رَكْنَا فِيهَا لِلْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":72,"w":[["وَوَهَبْنَا","wawahabnā","And We bestowed","এবং আমরা দিয়েছি"],["لَهُۥٓ","lahu","on him","তার জন্যে"],["إِسْحَـٰقَ","is'ḥāqa","Isaac","ইসহাক (পুত্ররূপে)"],["وَيَعْقُوبَ","waya‘qūba","and Yaqub","ও ইয়াকুব (পৌত্ররূপে)"],["نَافِلَةًۭ ۖ","nāfilatan","(in) addition","অতিরিক্ত হিসেবে"],["وَكُلًّۭا","wakullan","and all","এবং প্রত্যেককে"],["جَعَلْنَا","ja‘alnā","We made","আমরা বানিয়েছে"],["صَـٰلِحِينَ","ṣāliḥīna","righteous","সৎকর্মপরায়ণ"]],"t":"وَوَهَ<q>بْ</>نَا لَهُ<o>ۥٓ</> إِسْ<m>حَٰ</>قَ وَيَعْقُوبَ نَافِلَ<d>ةًۭ ۖ وَ</>كُ<k>لًّۭا جَ</>عَلْنَا <m>صَٰ</>لِ<p>حِي</>نَ"},{"n":73,"w":[["وَجَعَلْنَـٰهُمْ","waja‘alnāhum","And We made them","এবং তাদেরকে আমরা বানিয়েছিলাম"],["أَئِمَّةًۭ","a-immatan","leaders","নেতৃবৃন্দ"],["يَهْدُونَ","yahdūna","they guide","তারা পথপ্রদর্শন করতো"],["بِأَمْرِنَا","bi-amrinā","by Our Command","আমাদের নির্দেশ অনুসারে"],["وَأَوْحَيْنَآ","wa-awḥaynā","And We inspired","এবং আমরা ওহী করেছিলাম"],["إِلَيْهِمْ","ilayhim","to them","তাদের প্রতি"],["فِعْلَ","fi‘'la","(the) doing","কাজ করতে"],["ٱلْخَيْرَٰتِ","l-khayrāti","(of) good deeds","ভালো ভালো"],["وَإِقَامَ","wa-iqāma","and establishment","ও প্রতিষ্ঠা করতে"],["ٱلصَّلَوٰةِ","l-ṣalati","(of) the prayer","সালাত"],["وَإِيتَآءَ","waītāa","and giving","ও প্রদান করতো"],["ٱلزَّكَوٰةِ ۖ","l-zakati","(of) zakah","জাকাত"],["وَكَانُوا۟","wakānū","and they were","এবং তারা ছিলো"],["لَنَا","lanā","of Us","জন্যে আমাদের"],["عَـٰبِدِينَ","‘ābidīna","worshippers","ইবাদাতকারী"]],"t":"وَجَعَلْ<m>نَٰ</>هُمْ أَئِ<g>مَّ</><d>ةًۭ يَ</>هْدُونَ بِأَمْرِنَا وَأَوْحَيْ<o>نَآ</> إِلَيْهِمْ فِعْلَ <h>ٱ</>لْخَيْ<m>رَٰ</>تِ وَإِقَامَ <h>ٱ</><l>ل</>صَّلَ<s>وٰ</>ةِ وَإِي<o>تَآ</>ءَ <h>ٱ</><l>ل</>زَّكَ<s>وٰ</>ةِ ۖ وَكَانُو<s>ا۟</> لَنَا <m>عَٰ</>بِ<p>دِي</>نَ"},{"n":74,"w":[["وَلُوطًا","walūṭan","And (to) Lut","এবং লূতকে"],["ءَاتَيْنَـٰهُ","ātaynāhu","We gave him","তাকে আমরা দিয়েছিলাম"],["حُكْمًۭا","ḥuk'man","judgment","প্রজ্ঞা"],["وَعِلْمًۭا","wa‘il'man","and knowledge","ও জ্ঞান"],["وَنَجَّيْنَـٰهُ","wanajjaynāhu","and We saved him","এবং তাকে আমরা উদ্ধার করেছিলাম"],["مِنَ","mina","from","থেকে"],["ٱلْقَرْيَةِ","l-qaryati","the town","জনপদ"],["ٱلَّتِى","allatī","which","যা"],["كَانَت","kānat","was","ছিলো"],["تَّعْمَلُ","ta‘malu","doing","করতে"],["ٱلْخَبَـٰٓئِثَ ۗ","l-khabāitha","wicked deeds","অশ্লীল কর্মসমূহে"],["إِنَّهُمْ","innahum","Indeed, they","নিশ্চয়ই তারা"],["كَانُوا۟","kānū","were","ছিলো"],["قَوْمَ","qawma","a people","জাতি"],["سَوْءٍۢ","sawin","evil","খারাপ"],["فَـٰسِقِينَ","fāsiqīna","defiantly disobedient","সত্যত্যাগী"]],"t":"وَلُوطًا ءَاتَيْ<m>نَٰ</>هُ حُكْ<d>مًۭا وَ</>عِلْ<d>مًۭا وَ</>نَجَّيْ<m>نَٰ</>هُ مِنَ <h>ٱ</>لْقَرْيَةِ <h>ٱ</>لَّتِى كَانَت تَّعْمَلُ <h>ٱ</>لْخَ<o>بَٰٓ</>ئِثَ ۗ إِ<g>نَّ</>هُمْ كَانُو<s>ا۟</> قَوْمَ سَوْ<k>ءٍۢ فَٰ</>سِ<p>قِي</>نَ"},{"n":75,"w":[["وَأَدْخَلْنَـٰهُ","wa-adkhalnāhu","And We admitted him","এবং তাকে আমরা প্রবেশ করিয়েছিলাম"],["فِى","fī","into","মধ্যে"],["رَحْمَتِنَآ ۖ","raḥmatinā","Our Mercy","আমাদের অনুগ্রহের"],["إِنَّهُۥ","innahu","Indeed, he","নিশ্চয়ই সে (ছিলো)"],["مِنَ","mina","(was) of","অন্যতম"],["ٱلصَّـٰلِحِينَ","l-ṣāliḥīna","the righteous","সৎকর্মশীলদের"]],"t":"وَأَ<q>دْ</>خَلْ<m>نَٰ</>هُ فِى رَحْمَتِ<o>نَآ ۖ</> إِ<g>نَّ</>هُ<m>ۥ</> مِنَ <h>ٱ</><l>ل</><m>صَّٰ</>لِ<p>حِي</>نَ"},{"n":76,"w":[["وَنُوحًا","wanūḥan","And Nuh","এবং নূহকে (স্মরণ করো)"],["إِذْ","idh","when","যখন"],["نَادَىٰ","nādā","he called","সে ডেকেছিলো"],["مِن","min","before","থেকে"],["قَبْلُ","qablu","before","ইতিপূর্ব"],["فَٱسْتَجَبْنَا","fa-is'tajabnā","so We responded","তখন আমরা সাড়া দিয়েছিলাম"],["لَهُۥ","lahu","to him","তার ডাকে"],["فَنَجَّيْنَـٰهُ","fanajjaynāhu","and We saved him","অতঃপর তাকে আমরা উদ্ধার করেছিলাম"],["وَأَهْلَهُۥ","wa-ahlahu","and his family","ও তার পরিবারকে"],["مِنَ","mina","from","হ'তে"],["ٱلْكَرْبِ","l-karbi","the affliction","সংকট"],["ٱلْعَظِيمِ","l-‘aẓīmi","[the] great","মহা"]],"t":"وَنُوحًا إِذْ نَادَىٰ مِ<k>ن قَ</><q>بْ</>لُ فَ<h>ٱ</>سْتَجَ<q>بْ</>نَا لَهُ<m>ۥ</> فَنَجَّيْ<m>نَٰ</>هُ وَأَهْلَهُ<m>ۥ</> مِنَ <h>ٱ</>لْكَرْبِ <h>ٱ</>لْعَ<p>ظِي</>مِ"},{"n":77,"w":[["وَنَصَرْنَـٰهُ","wanaṣarnāhu","And We helped him","এবং তাকে আমরা সাহায্য করেছিলাম"],["مِنَ","mina","from","বিরুদ্ধে"],["ٱلْقَوْمِ","l-qawmi","the people","(এমন) লোকদের"],["ٱلَّذِينَ","alladhīna","who","যারা"],["كَذَّبُوا۟","kadhabū","denied","মিথ্যারোপ করেছিলো"],["بِـَٔايَـٰتِنَآ ۚ","biāyātinā","Our Signs","আমাদের নিদর্শনাবলীকে"],["إِنَّهُمْ","innahum","Indeed, they","নিশ্চয়ই তারা"],["كَانُوا۟","kānū","were","ছিলো"],["قَوْمَ","qawma","a people","লোক"],["سَوْءٍۢ","sawin","evil","খারাপ"],["فَأَغْرَقْنَـٰهُمْ","fa-aghraqnāhum","so We drowned them","সুতরাং তাদের আমরা ডুবিয়ে দিই"],["أَجْمَعِينَ","ajma‘īna","all","সকলকেই"]],"t":"وَنَصَرْ<m>نَٰ</>هُ مِنَ <h>ٱ</>لْقَوْمِ <h>ٱ</>لَّذِينَ كَذَّبُو<s>ا۟</> بِـَٔا<m>يَٰ</>تِ<o>نَآ ۚ</> إِ<g>نَّ</>هُمْ كَانُو<s>ا۟</> قَوْمَ سَوْ<k>ءٍۢ فَ</>أَغْرَ<q>قْ</><m>نَٰ</>هُمْ أَ<q>جْ</>مَ<p>عِي</>نَ"},{"n":78,"w":[["وَدَاوُۥدَ","wadāwūda","And Dawud","এবং (স্মরণ করো) দাঊদকে"],["وَسُلَيْمَـٰنَ","wasulaymāna","and Sulaiman","ও সুলাইমানকে"],["إِذْ","idh","when","যখন"],["يَحْكُمَانِ","yaḥkumāni","they judged","উভয়ে বিচার করেছিলো"],["فِى","fī","concerning","সম্পর্কে"],["ٱلْحَرْثِ","l-ḥarthi","the field","এক ক্ষেত"],["إِذْ","idh","when","যখন"],["نَفَشَتْ","nafashat","pastured","রাতে ছড়িয়ে পড়েছিলো"],["فِيهِ","fīhi","in it","তার মধ্যে"],["غَنَمُ","ghanamu","sheep","মেষ"],["ٱلْقَوْمِ","l-qawmi","(of) a people","কিছু লোকের"],["وَكُنَّا","wakunnā","and We were","এবং আমরা ছিলাম"],["لِحُكْمِهِمْ","liḥuk'mihim","to their judgment","জন্যে তাদের বিচারের"],["شَـٰهِدِينَ","shāhidīna","witness","পর্যবেক্ষক"]],"t":"وَدَاوُ<m>ۥ</>دَ وَسُلَيْ<m>مَٰ</>نَ إِذْ يَحْكُمَانِ فِى <h>ٱ</>لْحَرْثِ إِذْ نَفَشَتْ فِيهِ غَنَمُ <h>ٱ</>لْقَوْمِ وَكُ<g>نَّ</>ا لِحُكْمِهِمْ <m>شَٰ</>هِ<p>دِي</>نَ"},{"n":79,"w":[["فَفَهَّمْنَـٰهَا","fafahhamnāhā","And We gave understanding of it","অতঃপর তা আমরা বুঝিয়ে দিই"],["سُلَيْمَـٰنَ ۚ","sulaymāna","(to) Sulaiman","সুলাইমানকে"],["وَكُلًّا","wakullan","and (to) each","অথচ প্রত্যেককেই"],["ءَاتَيْنَا","ātaynā","We gave","আমরা দিয়েছি"],["حُكْمًۭا","ḥuk'man","judgment","প্রজ্ঞা"],["وَعِلْمًۭا ۚ","wa‘il'man","and knowledge","ও জ্ঞান"],["وَسَخَّرْنَا","wasakharnā","And We subjected","এবং আমরা নিয়ন্ত্রিত করে দিয়েছিলাম"],["مَعَ","ma‘a","with","সাথে"],["دَاوُۥدَ","dāwūda","Dawud","দাঊদের"],["ٱلْجِبَالَ","l-jibāla","the mountains","পাহাড়গুলোকে"],["يُسَبِّحْنَ","yusabbiḥ'na","(to) glorify Our praises","তারা পবিত্রতা ঘোষণা করতো"],["وَٱلطَّيْرَ ۚ","wal-ṭayra","and the birds","এবং পাখিদেরকেও (নিয়ন্ত্রিত করেছিলাম)"],["وَكُنَّا","wakunnā","And We were","এবং আমরা ছিলাম"],["فَـٰعِلِينَ","fā‘ilīna","the Doers","(এসবের) সম্পাদনকারী"]],"t":"فَفَهَّمْ<m>نَٰ</>هَا سُلَيْ<m>مَٰ</>نَ ۚ وَكُلًّا ءَاتَيْنَا حُكْ<d>مًۭا وَ</>عِلْ<d>مًۭا ۚ وَ</>سَخَّرْنَا مَعَ دَاوُ<m>ۥ</>دَ <h>ٱ</>لْجِبَالَ يُسَبِّحْنَ وَ<h>ٱ</><l>ل</>طَّيْرَ ۚ وَكُ<g>نَّ</>ا <m>فَٰ</>عِ<p>لِي</>نَ"},{"n":80,"w":[["وَعَلَّمْنَـٰهُ","wa‘allamnāhu","And We taught him","এবং তাকে আমরা শিখিয়েছিলাম"],["صَنْعَةَ","ṣan‘ata","(the) making","শিল্প"],["لَبُوسٍۢ","labūsin","(of) coats of armor","বর্ম (নির্মাণ)"],["لَّكُمْ","lakum","for you","জন্যে তোমাদের"],["لِتُحْصِنَكُم","lituḥ'ṣinakum","to protect you","যেন তোমাদের রক্ষা করতে পারে"],["مِّنۢ","min","from","হ'তে"],["بَأْسِكُمْ ۖ","basikum","your battle","তোমাদের যুদ্ধের (আঘাত)"],["فَهَلْ","fahal","Then will","তবুও কি"],["أَنتُمْ","antum","you","তোমরা (না)"],["شَـٰكِرُونَ","shākirūna","(be) grateful","কৃতজ্ঞ হবে"]],"t":"وَعَلَّمْ<m>نَٰ</>هُ صَنْعَةَ لَبُو<w>سٍۢ لَّ</>كُمْ لِتُحْصِنَ<y>كُم مِّ</><i>نۢ بَ</>أْسِكُمْ ۖ فَهَلْ أَ<k>نتُ</>مْ <m>شَٰ</>كِ<p>رُو</>نَ"},{"n":81,"w":[["وَلِسُلَيْمَـٰنَ","walisulaymāna","And to Sulaiman","এবং জন্যে সুলাইমানের"],["ٱلرِّيحَ","l-rīḥa","the wind","বায়ুকে (নিয়ন্ত্রিত করেছিলাম)"],["عَاصِفَةًۭ","‘āṣifatan","forcefully","(যা ছিলো) তীব্র"],["تَجْرِى","tajrī","blowing","প্রবাহিত হতো"],["بِأَمْرِهِۦٓ","bi-amrihi","by his command","তার নির্দেশ অনুসারে"],["إِلَى","ilā","to","দিকে"],["ٱلْأَرْضِ","l-arḍi","the land","(সেই) দেশের"],["ٱلَّتِى","allatī","which","যা (ছিলো এমন)"],["بَـٰرَكْنَا","bāraknā","We blessed","আমরা কল্যাণ দিয়েছি"],["فِيهَا ۚ","fīhā","[in it]","তার মধ্যে"],["وَكُنَّا","wakunnā","And We are","এবং আমরা হলাম"],["بِكُلِّ","bikulli","of every","সম্পর্কে সব"],["شَىْءٍ","shayin","thing","বিষয়"],["عَـٰلِمِينَ","‘ālimīna","Knowers","খুব অবহিত"]],"t":"وَلِسُلَيْ<m>مَٰ</>نَ <h>ٱ</><l>ل</>رِّيحَ عَاصِفَ<k>ةًۭ تَ</><q>جْ</>رِى بِأَمْرِ<o>هِۦٓ</> إِلَى <h>ٱ</>لْأَرْضِ <h>ٱ</>لَّتِى <m>بَٰ</>رَكْنَا فِيهَا ۚ وَكُ<g>نَّ</>ا بِكُلِّ شَىْءٍ <m>عَٰ</>لِ<p>مِي</>نَ"},{"n":82,"w":[["وَمِنَ","wamina","And of","এবং মধ্য হ'তে"],["ٱلشَّيَـٰطِينِ","l-shayāṭīni","the devils","(জ্বিন) শয়তানদের"],["مَن","man","(were some) who","যারা"],["يَغُوصُونَ","yaghūṣūna","would dive","ডুবুরির কাজ করতো"],["لَهُۥ","lahu","for him","জন্যে তার"],["وَيَعْمَلُونَ","waya‘malūna","and would do","ও তারা করতো"],["عَمَلًۭا","‘amalan","work","কাজ"],["دُونَ","dūna","other than","ছাড়াও"],["ذَٰلِكَ ۖ","dhālika","that","এটা"],["وَكُنَّا","wakunnā","And We were","আমরা ছিলাম"],["لَهُمْ","lahum","of them","উপর তাদের"],["حَـٰفِظِينَ","ḥāfiẓīna","Guardians","সংরক্ষণকারী"]],"t":"وَمِنَ <h>ٱ</><l>ل</>شَّ<m>يَٰ</>طِينِ <d>مَن يَ</>غُوصُونَ لَهُ<m>ۥ</> وَيَعْمَلُونَ عَمَلًۭ<k>ا دُ</>ونَ <m>ذَٰ</>لِكَ ۖ وَكُ<g>نَّ</>ا لَهُمْ <m>حَٰ</>فِ<p>ظِي</>نَ"},{"n":83,"w":[["۞ وَأَيُّوبَ","wa-ayyūba","And Ayub","এবং আইয়ূবকে (স্মরণ করো)"],["إِذْ","idh","when","যখন"],["نَادَىٰ","nādā","he called","সে ডেকেছিলো"],["رَبَّهُۥٓ","rabbahu","(to) his Lord","তার রবকে"],["أَنِّى","annī","Indeed, [I]","\"নিশ্চয়ই আমি"],["مَسَّنِىَ","massaniya","has touched me","ধরেছে আমাকে"],["ٱلضُّرُّ","l-ḍuru","the adversity","দুঃখ কষ্টে (অসুখে)"],["وَأَنتَ","wa-anta","and You","আর তুমি"],["أَرْحَمُ","arḥamu","(are) Most Merciful","সর্বশ্রেষ্ঠ দয়ালু"],["ٱلرَّٰحِمِينَ","l-rāḥimīna","(of) the Merciful","সব দয়ালুদের\""]],"t":"۞ وَأَيُّوبَ إِذْ نَادَىٰ رَبَّهُ<o>ۥٓ</> أَ<g>نِّ</>ى مَسَّنِىَ <h>ٱ</><l>ل</>ضُّرُّ وَأَ<k>نتَ</> أَرْحَمُ <h>ٱ</><l>ل</><m>رَّٰ</>حِ<p>مِي</>نَ"},{"n":84,"w":[["فَٱسْتَجَبْنَا","fa-is'tajabnā","So We responded","তখন আমরা সাড়া দিলাম"],["لَهُۥ","lahu","to him","তার ডাকে"],["فَكَشَفْنَا","fakashafnā","and We removed","অতঃপর আমরা দূর করে দিলাম"],["مَا","mā","what","যা"],["بِهِۦ","bihi","(was) on him","তার সাথে (হয়েছিলো)"],["مِن","min","of","থেকে"],["ضُرٍّۢ ۖ","ḍurrin","(the) adversity","দুঃখ কষ্ট"],["وَءَاتَيْنَـٰهُ","waātaynāhu","And We gave him","ও তাকে আমরা ফেরত দিলাম"],["أَهْلَهُۥ","ahlahu","his family","তার পরিবারকে"],["وَمِثْلَهُم","wamith'lahum","and (the) like thereof","এবং তাদের অনুরূপ"],["مَّعَهُمْ","ma‘ahum","with them","তাদের সাথে"],["رَحْمَةًۭ","raḥmatan","(as) Mercy","অনুগ্রহ হিসেবে"],["مِّنْ","min","from Ourselves","হ'তে"],["عِندِنَا","‘indinā","from Ourselves","আমাদের পক্ষ"],["وَذِكْرَىٰ","wadhik'rā","and a reminder","এবং উপদেশস্বরূপ"],["لِلْعَـٰبِدِينَ","lil'‘ābidīna","for the worshippers","ইবাদাতকারীদের জন্যে"]],"t":"فَ<h>ٱ</>سْتَجَ<q>بْ</>نَا لَهُ<m>ۥ</> فَكَشَفْنَا مَا بِ<m>هِۦ</> مِ<k>ن ضُ</><d>رٍّۢ ۖ وَ</>ءَاتَيْ<m>نَٰ</>هُ أَهْلَهُ<m>ۥ</> وَمِثْلَ<y>هُم مَّ</>عَهُمْ رَحْمَ<d>ةًۭ مِّ</>نْ عِ<k>ندِ</>نَا وَذِكْرَىٰ لِلْ<m>عَٰ</>بِ<p>دِي</>نَ"},{"n":85,"w":[["وَإِسْمَـٰعِيلَ","wa-is'mā‘īla","And Ishmael","এবং (স্মরণ করো) ইসমাইলকে"],["وَإِدْرِيسَ","wa-id'rīsa","and Idris","ও ইদরীসকে"],["وَذَا","wadhā","and Dhul-Kifl","ও"],["ٱلْكِفْلِ ۖ","l-kif'li","and Dhul-Kifl","যুলকিফ্‌লকে"],["كُلٌّۭ","kullun","all","প্রত্যেকে (ছিলো)"],["مِّنَ","mina","(were) of","অন্তর্ভুক্ত"],["ٱلصَّـٰبِرِينَ","l-ṣābirīna","the patient ones","ধৈর্যশীলদের"]],"t":"وَإِسْ<m>مَٰ</>عِيلَ وَإِ<q>دْ</>رِيسَ وَذَا <h>ٱ</>لْكِفْلِ ۖ كُ<d>لٌّۭ مِّ</>نَ <h>ٱ</><l>ل</><m>صَّٰ</>بِ<p>رِي</>نَ"},{"n":86,"w":[["وَأَدْخَلْنَـٰهُمْ","wa-adkhalnāhum","And We admitted them","এবং তাদেরকে আমরা প্রবেশ করিয়েছি"],["فِى","fī","in","মধ্যে"],["رَحْمَتِنَآ ۖ","raḥmatinā","Our Mercy","আমাদের অনুগ্রহের"],["إِنَّهُم","innahum","Indeed, they","নিশ্চয়ই তারা (ছিলো)"],["مِّنَ","mina","(were) of","অন্তর্ভুক্ত"],["ٱلصَّـٰلِحِينَ","l-ṣāliḥīna","the righteous","সৎকর্মশীলদের"]],"t":"وَأَ<q>دْ</>خَلْ<m>نَٰ</>هُمْ فِى رَحْمَتِ<o>نَآ ۖ</> إِ<g>نَّ</><y>هُم مِّ</>نَ <h>ٱ</><l>ل</><m>صَّٰ</>لِ<p>حِي</>نَ"},{"n":87,"w":[["وَذَا","wadhā","And Dhun-Nun","আর অধিকারী"],["ٱلنُّونِ","l-nūni","And Dhun-Nun","মাছের (স্মরণ করো)"],["إِذ","idh","when","যখন"],["ذَّهَبَ","dhahaba","he went","চলে গিয়েছিলো"],["مُغَـٰضِبًۭا","mughāḍiban","(while) angry","রাগ করে"],["فَظَنَّ","faẓanna","and thought","অতঃপর মনে করেছিলো"],["أَن","an","that","যে"],["لَّن","lan","never","না"],["نَّقْدِرَ","naqdira","We would decree","ধড়-পাকড় করতে পারবো"],["عَلَيْهِ","‘alayhi","upon him","তার উপর"],["فَنَادَىٰ","fanādā","Then he called","অতঃপর সে ডেকেছিলো"],["فِى","fī","in","মধ্যে"],["ٱلظُّلُمَـٰتِ","l-ẓulumāti","the darkness(es)","অন্ধকারের"],["أَن","an","that","যে"],["لَّآ","lā","(There is) no","\"নেই"],["إِلَـٰهَ","ilāha","god","কোন ইলাহ"],["إِلَّآ","illā","except","ছাড়া"],["أَنتَ","anta","You","তুমি"],["سُبْحَـٰنَكَ","sub'ḥānaka","Glory be to You","তুমি পবিত্র মহান"],["إِنِّى","innī","Indeed, [I]","নিশ্চয়ই আমি"],["كُنتُ","kuntu","I am","ছিলাম"],["مِنَ","mina","of","অন্তর্ভুক্ত"],["ٱلظَّـٰلِمِينَ","l-ẓālimīna","the wrongdoers","সীমালঙ্ঘনকারীদের\""]],"t":"وَذَا <h>ٱ</><l>ل</><g>نُّ</>ونِ إِذ ذَّهَبَ مُ<m>غَٰ</>ضِ<k>بًۭا فَ</>ظَ<g>نَّ</> <w>أَن لَّ</><d>ن نَّ</><q>قْ</>دِرَ عَلَيْهِ فَنَادَىٰ فِى <h>ٱ</><l>ل</>ظُّلُ<m>مَٰ</>تِ <w>أَن لَّ</><o>آ</> إِ<m>لَٰ</>هَ إِ<o>لَّآ</> أَ<k>نتَ</> سُ<q>بْ</><m>حَٰ</>نَكَ إِ<g>نِّ</>ى كُ<k>نتُ</> مِنَ <h>ٱ</><l>ل</><m>ظَّٰ</>لِ<p>مِي</>نَ"},{"n":88,"w":[["فَٱسْتَجَبْنَا","fa-is'tajabnā","So We responded","তখন আমরা সাড়া দিলাম"],["لَهُۥ","lahu","to him","তার ডাকে"],["وَنَجَّيْنَـٰهُ","wanajjaynāhu","and We saved him","এবং তাকে আমরা উদ্ধার করেছিলাম"],["مِنَ","mina","from","হ'তে"],["ٱلْغَمِّ ۚ","l-ghami","the distress","দুশ্চিন্তা"],["وَكَذَٰلِكَ","wakadhālika","And thus","এরূপেই"],["نُـۨجِى","nunjī","We save","উদ্ধার করি আমরা"],["ٱلْمُؤْمِنِينَ","l-mu'minīna","the believers","মু'মিনদেরকে"]],"t":"فَ<h>ٱ</>سْتَجَ<q>بْ</>نَا لَهُ<m>ۥ</> وَنَجَّيْ<m>نَٰ</>هُ مِنَ <h>ٱ</>لْغَ<g>مِّ</> ۚ وَكَ<m>ذَٰ</>لِكَ نُۨجِى <h>ٱ</>لْمُؤْمِ<p>نِي</>نَ"},{"n":89,"w":[["وَزَكَرِيَّآ","wazakariyyā","And Zakariya","এবং যাকারিয়াকে (স্মরণ করো)"],["إِذْ","idh","when","যখন"],["نَادَىٰ","nādā","he called","সে ডেকেছিলো"],["رَبَّهُۥ","rabbahu","(to) his Lord","তার রবকে"],["رَبِّ","rabbi","My Lord","\"হে আমার রব"],["لَا","lā","(Do) not","না"],["تَذَرْنِى","tadharnī","leave me","আমাকে ছেড়ো"],["فَرْدًۭا","fardan","alone","একাকী"],["وَأَنتَ","wa-anta","while You","এবং তুমি"],["خَيْرُ","khayru","(are) [the] Best","উত্তম"],["ٱلْوَٰرِثِينَ","l-wārithīna","(of) the inheritors","উত্তরাধিকারীদের\""]],"t":"وَزَكَرِ<o>يَّآ</> إِذْ نَادَىٰ رَبَّهُ<m>ۥ</> رَبِّ لَا تَذَرْنِى فَرْ<d>دًۭا وَ</>أَ<k>نتَ</> خَيْرُ <h>ٱ</>لْ<m>وَٰ</>رِ<p>ثِي</>نَ"},{"n":90,"w":[["فَٱسْتَجَبْنَا","fa-is'tajabnā","So We responded","তখন আমরা সাড়া দিয়েছিলাম"],["لَهُۥ","lahu","to him","তার ডাকে"],["وَوَهَبْنَا","wawahabnā","and We bestowed","ও আমরা দিয়েছিলাম"],["لَهُۥ","lahu","on him","তার জন্যে"],["يَحْيَىٰ","yaḥyā","Yahya","ইয়াহইয়াকে"],["وَأَصْلَحْنَا","wa-aṣlaḥnā","and We cured","আমরা উপযোগী করে দিয়েছিলাম"],["لَهُۥ","lahu","for him","জন্যে তা"],["زَوْجَهُۥٓ ۚ","zawjahu","his wife","তার স্ত্রীকে"],["إِنَّهُمْ","innahum","Indeed, they","নিশ্চয়ই তারা"],["كَانُوا۟","kānū","used (to)","তারা ছিলো"],["يُسَـٰرِعُونَ","yusāri‘ūna","hasten","প্রাণপণ চেষ্টা করতো"],["فِى","fī","in","ব্যাপারে"],["ٱلْخَيْرَٰتِ","l-khayrāti","good deeds","সৎকাজসমূহের"],["وَيَدْعُونَنَا","wayad‘ūnanā","and they supplicate to Us","এবং আমাদেরকে ডাকতো"],["رَغَبًۭا","raghaban","(in) hope","আগ্রহ"],["وَرَهَبًۭا ۖ","warahaban","and fear","ও ভয়ের সাথে"],["وَكَانُوا۟","wakānū","and they were","এবং তারা ছিলো"],["لَنَا","lanā","to Us","কাছে আমাদের"],["خَـٰشِعِينَ","khāshi‘īna","humbly submissive","ভীত অবনত"]],"t":"فَ<h>ٱ</>سْتَجَ<q>بْ</>نَا لَهُ<m>ۥ</> وَوَهَ<q>بْ</>نَا لَهُ<m>ۥ</> يَحْيَىٰ وَأَصْلَحْنَا لَهُ<m>ۥ</> زَوْجَهُ<o>ۥٓ ۚ</> إِ<g>نَّ</>هُمْ كَانُو<s>ا۟</> يُ<m>سَٰ</>رِعُونَ فِى <h>ٱ</>لْخَيْ<m>رَٰ</>تِ وَيَ<q>دْ</>عُونَنَا رَغَ<d>بًۭا وَ</>رَهَ<d>بًۭا ۖ وَ</>كَانُو<s>ا۟</> لَنَا <m>خَٰ</>شِ<p>عِي</>نَ"},{"n":91,"w":[["وَٱلَّتِىٓ","wa-allatī","And she who","এবং (স্মরণ করো) (মারইয়ামকে) যে"],["أَحْصَنَتْ","aḥṣanat","guarded","রক্ষা করেছিলো"],["فَرْجَهَا","farjahā","her chastity","তার সতীত্বকে"],["فَنَفَخْنَا","fanafakhnā","so We breathed","অতঃপর আমরা ফুঁকে দিলাম"],["فِيهَا","fīhā","into her","তার মধ্যে"],["مِن","min","of","থেকে"],["رُّوحِنَا","rūḥinā","Our Spirit","আমাদের রূহ"],["وَجَعَلْنَـٰهَا","waja‘alnāhā","and We made her","এবং তাকে বানিয়েছিলাম"],["وَٱبْنَهَآ","wa-ib'nahā","and her son","ও তার পুত্রকে"],["ءَايَةًۭ","āyatan","a sign","একটি নিদর্শন"],["لِّلْعَـٰلَمِينَ","lil'‘ālamīna","for the worlds","জন্যে বিশ্ববাসীদের"]],"t":"وَ<h>ٱ</>لَّ<o>تِىٓ</> أَحْصَنَتْ فَرْجَهَا فَنَفَخْنَا فِيهَا <w>مِن رُّ</>وحِنَا وَجَعَلْ<m>نَٰ</>هَا وَ<h>ٱ</><q>بْ</>نَ<o>هَآ</> ءَايَ<w>ةًۭ لِّ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":92,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["هَـٰذِهِۦٓ","hādhihi","this","এই যে"],["أُمَّتُكُمْ","ummatukum","(is) your religion ","তোমাদের জাতি"],["أُمَّةًۭ","ummatan","religion","জাতি (প্রকৃতপক্ষে)"],["وَٰحِدَةًۭ","wāḥidatan","one","একই"],["وَأَنَا۠","wa-anā","and I Am","এবং আমি"],["رَبُّكُمْ","rabbukum","your Lord","তোমাদের রব"],["فَٱعْبُدُونِ","fa-u‘'budūni","so worship Me","সুতরাং তোমরা আমারই ইবাদাত করো"]],"t":"إِ<g>نَّ</> <m>هَٰ</>ذِ<o>هِۦٓ</> أُ<g>مَّ</>تُكُمْ أُ<g>مَّ</><d>ةًۭ وَٰ</>حِدَ<d>ةًۭ وَ</>أَنَا۠ رَبُّكُمْ فَ<h>ٱ</>عْبُ<p>دُو</>نِ"},{"n":93,"w":[["وَتَقَطَّعُوٓا۟","wataqaṭṭa‘ū","But they cut off","কিন্তু তারা টুকরা টুকরা করে ফেললো"],["أَمْرَهُم","amrahum","their affair","তাদের কার্যকলাপ (দ্বীন)"],["بَيْنَهُمْ ۖ","baynahum","among themselves","তাদের মাঝে"],["كُلٌّ","kullun","all","প্রত্যেককে"],["إِلَيْنَا","ilaynā","to Us","আমাদের দিকেই"],["رَٰجِعُونَ","rāji‘ūna","(will) return","প্রত্যাবর্তনকারী"]],"t":"وَتَقَطَّ<o>عُوٓ</><s>ا۟</> أَمْرَ<f>هُم بَ</>يْنَهُمْ ۖ كُلٌّ إِلَيْنَا <m>رَٰ</>جِ<p>عُو</>نَ"},{"n":94,"w":[["فَمَن","faman","Then whoever","তবে যে"],["يَعْمَلْ","ya‘mal","does","কাজ করবে"],["مِنَ","mina","[of]","থেকে"],["ٱلصَّـٰلِحَـٰتِ","l-ṣāliḥāti","[the] righteous deeds","সৎকাজসমূহের"],["وَهُوَ","wahuwa","while he","এ অবস্থায় যে সে"],["مُؤْمِنٌۭ","mu'minun","(is) a believer","মু'মিনও (হবে)"],["فَلَا","falā","then not","তখন না"],["كُفْرَانَ","kuf'rāna","(will be) rejected","অগ্রাহ্য হবে (তার কাজ)"],["لِسَعْيِهِۦ","lisa‘yihi","[of] his effort","জন্যে তার প্রচেষ্টার"],["وَإِنَّا","wa-innā","And indeed, We","এবং নিশ্চয়ই আমরা"],["لَهُۥ","lahu","of it","জন্যে তার"],["كَـٰتِبُونَ","kātibūna","(are) Recorders","লেখক (অর্থাৎ লিখে রাখি)"]],"t":"فَ<d>مَن يَ</>عْمَلْ مِنَ <h>ٱ</><l>ل</><m>صَّٰلِحَٰ</>تِ وَهُوَ مُؤْمِ<k>نٌۭ فَ</>لَا كُفْرَانَ لِسَعْيِ<m>هِۦ</> وَإِ<g>نَّ</>ا لَهُ<m>ۥ كَٰ</>تِ<p>بُو</>نَ"},{"n":95,"w":[["وَحَرَٰمٌ","waḥarāmun","And (there is) prohibition","এবং (প্রত্যাবর্তন) নিষিদ্ধ"],["عَلَىٰ","‘alā","upon","জন্য"],["قَرْيَةٍ","qaryatin","a city","কোন জনপদের"],["أَهْلَكْنَـٰهَآ","ahlaknāhā","which We have destroyed","আমরা ধ্বংস করেছি তাকে"],["أَنَّهُمْ","annahum","that they","তারা যে"],["لَا","lā","not","না"],["يَرْجِعُونَ","yarji‘ūna","will return","ফিরে আসতে পারবে"]],"t":"وَحَ<m>رَٰ</>مٌ عَلَىٰ قَرْيَةٍ أَهْلَكْ<m>نَٰ</><o>هَآ</> أَ<g>نَّ</>هُمْ لَا يَرْجِ<p>عُو</>نَ"},{"n":96,"w":[["حَتَّىٰٓ","ḥattā","Until","এমনকি"],["إِذَا","idhā","when","যখন"],["فُتِحَتْ","futiḥat","has been opened","খুলে দেয়া হবে"],["يَأْجُوجُ","yajūju","(for) the Yajuj","ইয়াজুজ"],["وَمَأْجُوجُ","wamajūju","and Majuj","ও মাজুজকে"],["وَهُم","wahum","and they","এবং তারা"],["مِّن","min","from","হ'তে"],["كُلِّ","kulli","every","প্রত্যেক"],["حَدَبٍۢ","ḥadabin","elevation","উচ্চভূমি"],["يَنسِلُونَ","yansilūna","descend","ছুটে আসবে"]],"t":"حَتَّ<o>ىٰٓ</> إِذَا فُتِحَتْ يَأْجُوجُ وَمَأْجُوجُ وَ<y>هُم مِّ</><k>ن كُ</>لِّ حَدَ<d>بٍۢ يَ</><k>نسِ</><p>لُو</>نَ"},{"n":97,"w":[["وَٱقْتَرَبَ","wa-iq'taraba","And has approached","এবং নিকটবর্তী হবে"],["ٱلْوَعْدُ","l-wa‘du","the promise","প্রতিশ্রুতি (ক্বিয়ামাতের)"],["ٱلْحَقُّ","l-ḥaqu","[the] true","সত্য"],["فَإِذَا","fa-idhā","then behold","অতঃপর যখন"],["هِىَ","hiya","[it]","তা"],["شَـٰخِصَةٌ","shākhiṣatun","(are) staring","বিস্ফোরিত হবে"],["أَبْصَـٰرُ","abṣāru","(the) eyes","চোখগুলো"],["ٱلَّذِينَ","alladhīna","(of) those who","(তাদের) যারা"],["كَفَرُوا۟","kafarū","disbelieved","অস্বীকার করেছিলো"],["يَـٰوَيْلَنَا","yāwaylanā","O woe to us","\"(এবং বলবে) হায় আমাদের দুর্ভোগ"],["قَدْ","qad","Verily","নিশ্চয়ই"],["كُنَّا","kunnā","we had been","আমরা ছিলাম"],["فِى","fī","in","মধ্যে"],["غَفْلَةٍۢ","ghaflatin","heedlessness","উদাসীনতার"],["مِّنْ","min","of","সম্পর্কে"],["هَـٰذَا","hādhā","this","এটা"],["بَلْ","bal","nay","বরং"],["كُنَّا","kunnā","we were","আমরা ছিলাম"],["ظَـٰلِمِينَ","ẓālimīna","wrongdoers","সীমালঙ্ঘনকারী\""]],"t":"وَ<h>ٱ</><q>قْ</>تَرَبَ <h>ٱ</>لْوَعْدُ <h>ٱ</>لْحَقُّ فَإِذَا هِىَ <m>شَٰ</>خِصَةٌ أَ<q>بْ</><m>صَٰ</>رُ <h>ٱ</>لَّذِينَ كَفَرُو<s>ا۟</> <m>يَٰ</>وَيْلَنَا قَ<q>دْ</> كُ<g>نَّ</>ا فِى غَفْلَ<d>ةٍۢ مِّ</>نْ <m>هَٰ</>ذَا بَلْ كُ<g>نَّ</>ا <m>ظَٰ</>لِ<p>مِي</>نَ"},{"n":98,"w":[["إِنَّكُمْ","innakum","Indeed, you","নিশ্চয়ই তোমরা"],["وَمَا","wamā","and what","ও যাদের"],["تَعْبُدُونَ","ta‘budūna","you worship","তোমরা ইবাদাত করতে"],["مِن","min","besides Allah","মধ্য হতে"],["دُونِ","dūni","besides Allah","ছাড়া"],["ٱللَّهِ","l-lahi","besides Allah","আল্লাহ"],["حَصَبُ","ḥaṣabu","(are) firewood","ইন্ধন (হবে)"],["جَهَنَّمَ","jahannama","(of) Hell","জাহান্নামের"],["أَنتُمْ","antum","You","তোমরা"],["لَهَا","lahā","to it","জন্যে তার"],["وَٰرِدُونَ","wāridūna","will come","প্রবেশকারী (হবে)"]],"t":"إِ<g>نَّ</>كُمْ وَمَا تَعْبُدُونَ مِ<k>ن دُ</>ونِ <h>ٱ</>للَّهِ حَصَبُ جَهَ<g>نَّ</>مَ أَ<k>نتُ</>مْ لَهَا <m>وَٰ</>رِ<p>دُو</>نَ"},{"n":99,"w":[["لَوْ","law","If","যদি"],["كَانَ","kāna","were","হতো"],["هَـٰٓؤُلَآءِ","hāulāi","these","এসব"],["ءَالِهَةًۭ","ālihatan","gods","উপাস্য"],["مَّا","mā","not","(তাহ'লে) না"],["وَرَدُوهَا ۖ","waradūhā","they (would) have come to it","তাতে প্রবেশ করতো"],["وَكُلٌّۭ","wakullun","And all","এবং প্রত্যেকে"],["فِيهَا","fīhā","therein","তার মধ্যে"],["خَـٰلِدُونَ","khālidūna","will abide forever","স্থায়ী হবে"]],"t":"لَوْ كَانَ <o>هَٰٓؤُلَآ</>ءِ ءَالِهَ<d>ةًۭ مَّ</>ا وَرَدُوهَا ۖ وَكُ<k>لٌّۭ فِ</>يهَا <m>خَٰ</>لِ<p>دُو</>نَ"},{"n":100,"w":[["لَهُمْ","lahum","For them","জন্যে তাদের"],["فِيهَا","fīhā","therein","তার মধ্যে থাকবে"],["زَفِيرٌۭ","zafīrun","(is) sighing","কান ফাটা আর্তনাদ"],["وَهُمْ","wahum","and they","কিন্তু তারা"],["فِيهَا","fīhā","therein","তার মধ্যে"],["لَا","lā","not","না"],["يَسْمَعُونَ","yasma‘ūna","will hear","শুনতে পাবে (কিছুই)"]],"t":"لَهُمْ فِيهَا زَفِي<d>رٌۭ وَ</>هُمْ فِيهَا لَا يَسْمَ<p>عُو</>نَ"},{"n":101,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["ٱلَّذِينَ","alladhīna","those","যাদের (জন্যে)"],["سَبَقَتْ","sabaqat","has gone forth","পূর্বেই নির্ধারিত হয়েছিলো"],["لَهُم","lahum","for them","জন্যে তাদের"],["مِّنَّا","minnā","from Us","আমাদের থেকে"],["ٱلْحُسْنَىٰٓ","l-ḥus'nā","the good","কল্যাণ"],["أُو۟لَـٰٓئِكَ","ulāika","those","ঐসব লোককে"],["عَنْهَا","‘anhā","from it","থেকে তা"],["مُبْعَدُونَ","mub'‘adūna","(will be) removed far","দূরে রাখা হবে"]],"t":"إِ<g>نَّ</> <h>ٱ</>لَّذِينَ سَبَقَتْ لَ<y>هُم مِّ</><g>نَّ</>ا <h>ٱ</>لْحُسْنَ<o>ىٰٓ</> أُ<s>و۟</><o>لَٰٓ</>ئِكَ عَنْهَا مُ<q>بْ</>عَ<p>دُو</>نَ"},{"n":102,"w":[["لَا","lā","Not","না"],["يَسْمَعُونَ","yasma‘ūna","they will hear","তারা শুনতে পাবে"],["حَسِيسَهَا ۖ","ḥasīsahā","(the) slightest sound of it","তার ক্ষীণতম শব্দও"],["وَهُمْ","wahum","and they","আর তারা (হবে)"],["فِى","fī","in","মধ্যে"],["مَا","mā","what","যা"],["ٱشْتَهَتْ","ish'tahat","desire","চাইবে"],["أَنفُسُهُمْ","anfusuhum","their souls","তাদের মন"],["خَـٰلِدُونَ","khālidūna","will abide forever","তারা স্থায়ী হবে"]],"t":"لَا يَسْمَعُونَ حَسِيسَهَا ۖ وَهُمْ فِى مَا <h>ٱ</>شْتَهَتْ أَ<k>نفُ</>سُهُمْ <m>خَٰ</>لِ<p>دُو</>نَ"},{"n":103,"w":[["لَا","lā","Not","না"],["يَحْزُنُهُمُ","yaḥzunuhumu","will grieve them","তাদেরকে চিন্তিত করবে"],["ٱلْفَزَعُ","l-faza‘u","the terror","ভয়"],["ٱلْأَكْبَرُ","l-akbaru","[the] greatest","মহা"],["وَتَتَلَقَّىٰهُمُ","watatalaqqāhumu","and will meet them","এবং তাদেরকে অভ্যর্থনা করবে"],["ٱلْمَلَـٰٓئِكَةُ","l-malāikatu","the Angels","ফেরেশতারা"],["هَـٰذَا","hādhā","This","\"এই"],["يَوْمُكُمُ","yawmukumu","(is) your Day","তোমাদের দিন"],["ٱلَّذِى","alladhī","which","সেই (যারা)"],["كُنتُمْ","kuntum","you were","তোমরা ছিলে"],["تُوعَدُونَ","tū‘adūna","promised","প্রতিশ্রুতি দেয়া হয়েছিলো\""]],"t":"لَا يَحْزُنُهُمُ <h>ٱ</>لْفَزَعُ <h>ٱ</>لْأَكْبَرُ وَتَتَلَقَّ<m>ىٰ</>هُمُ <h>ٱ</>لْمَ<o>لَٰٓ</>ئِكَةُ <m>هَٰ</>ذَا يَوْمُكُمُ <h>ٱ</>لَّذِى كُ<k>نتُ</>مْ تُوعَ<p>دُو</>نَ"},{"n":104,"w":[["يَوْمَ","yawma","(The) Day","সেদিন"],["نَطْوِى","naṭwī","We will fold","গুটিয়ে ফেলবো আমরা"],["ٱلسَّمَآءَ","l-samāa","the heaven","আকাশকে"],["كَطَىِّ","kaṭayyi","like (the) folding","মতো গুটানোর যেমন"],["ٱلسِّجِلِّ","l-sijili","(of) a scroll","খাতা"],["لِلْكُتُبِ ۚ","lil'kutubi","for records","(বিভিন্ন বিষয়ে) লিখিত"],["كَمَا","kamā","As","যেমন"],["بَدَأْنَآ","badanā","We began","আমরা সৃষ্টি করেছি"],["أَوَّلَ","awwala","(the) first","প্রথম"],["خَلْقٍۢ","khalqin","creation","সৃষ্টি"],["نُّعِيدُهُۥ ۚ","nu‘īduhu","We will repeat it","তা আমরা পুনরায় সৃষ্টি করবো"],["وَعْدًا","wa‘dan","a promise","প্রতিশ্রুতি (পালন)"],["عَلَيْنَآ ۚ","‘alaynā","upon Us","ওপর আমাদের (দায়িত্ব)"],["إِنَّا","innā","Indeed, We ","নিশ্চয়ই আমরা"],["كُنَّا","kunnā","We are","আমরা হলাম"],["فَـٰعِلِينَ","fā‘ilīna","(the) Doers","সম্পাদনকারী (তা)"]],"t":"يَوْمَ نَ<q>طْ</>وِى <h>ٱ</><l>ل</>سَّ<o>مَآ</>ءَ كَطَىِّ <h>ٱ</><l>ل</>سِّجِلِّ لِلْكُتُبِ ۚ كَمَا بَدَأْ<o>نَآ</> أَوَّلَ خَلْ<d>قٍۢ نُّ</>عِيدُهُ<m>ۥ</> ۚ وَعْدًا عَلَيْ<o>نَآ ۚ</> إِ<g>نَّ</>ا كُ<g>نَّ</>ا <m>فَٰ</>عِ<p>لِي</>نَ"},{"n":105,"w":[["وَلَقَدْ","walaqad","And verily","এবং নিশ্চয়ই"],["كَتَبْنَا","katabnā","We have written","আমরা লিখেছিলাম"],["فِى","fī","in","মধ্যে"],["ٱلزَّبُورِ","l-zabūri","the Scripture","যাবুর গ্রন্থে"],["مِنۢ","min","after","থেকে"],["بَعْدِ","ba‘di","after","পর"],["ٱلذِّكْرِ","l-dhik'ri","the mention","উপদেশের"],["أَنَّ","anna","that","যে"],["ٱلْأَرْضَ","l-arḍa","the earth ","পৃথিবীর"],["يَرِثُهَا","yarithuhā","will inherit it","তার উত্তরাধিকারী হবে"],["عِبَادِىَ","‘ibādiya","My slaves","(যারা) আমার দাস"],["ٱلصَّـٰلِحُونَ","l-ṣāliḥūna","the righteous","সৎকর্মশীল"]],"t":"وَلَقَ<q>دْ</> كَتَ<q>بْ</>نَا فِى <h>ٱ</><l>ل</>زَّبُورِ <i>مِنۢ بَ</>عْدِ <h>ٱ</><l>ل</>ذِّكْرِ أَ<g>نَّ</> <h>ٱ</>لْأَرْضَ يَرِثُهَا عِبَادِىَ <h>ٱ</><l>ل</><m>صَّٰ</>لِ<p>حُو</>نَ"},{"n":106,"w":[["إِنَّ","inna","Indeed","নিশ্চয়ই"],["فِى","fī","in","মধ্যে আছে"],["هَـٰذَا","hādhā","this","এর"],["لَبَلَـٰغًۭا","labalāghan","surely is a Message","অবশ্যই বার্তা"],["لِّقَوْمٍ","liqawmin","for a people","জন্যে লোকদের"],["عَـٰبِدِينَ","‘ābidīna","worshippers","ইবাদাতকারী"]],"t":"إِ<g>نَّ</> فِى <m>هَٰ</>ذَا لَبَ<m>لَٰ</><w>غًۭا لِّ</>قَوْمٍ <m>عَٰ</>بِ<p>دِي</>نَ"},{"n":107,"w":[["وَمَآ","wamā","And not","এবং না"],["أَرْسَلْنَـٰكَ","arsalnāka","We have sent you","তোমাকে আমরা পাঠিয়েছি"],["إِلَّا","illā","but","এছাড়া যে"],["رَحْمَةًۭ","raḥmatan","(as) a mercy","রহমত হিসেবে"],["لِّلْعَـٰلَمِينَ","lil'‘ālamīna","for the worlds","জন্যে বিশ্বজগতের"]],"t":"وَ<o>مَآ</> أَرْسَلْ<m>نَٰ</>كَ إِلَّا رَحْمَ<w>ةًۭ لِّ</>لْ<m>عَٰ</>لَ<p>مِي</>نَ"},{"n":108,"w":[["قُلْ","qul","Say","বলো"],["إِنَّمَا","innamā","Only","\"মূলতঃ"],["يُوحَىٰٓ","yūḥā","it is revealed","ওহী করা হয়েছে"],["إِلَىَّ","ilayya","to me","আমার প্রতি"],["أَنَّمَآ","annamā","that","যে"],["إِلَـٰهُكُمْ","ilāhukum","your god","তোমাদের ইলাহ (কেবল)"],["إِلَـٰهٌۭ","ilāhun","(is) God","ইলাহ"],["وَٰحِدٌۭ ۖ","wāḥidun","One","একই"],["فَهَلْ","fahal","so will","তাহ'লে কি"],["أَنتُم","antum","you","তোমরা"],["مُّسْلِمُونَ","mus'limūna","submit (to Him)","আত্মসমর্পণকারী হবে\""]],"t":"قُلْ إِ<g>نَّ</>مَا يُوحَ<o>ىٰٓ</> إِلَىَّ أَ<g>نَّ</><o>مَآ</> إِ<m>لَٰ</>هُكُمْ إِ<m>لَٰ</><d>هٌۭ وَٰ</>حِ<k>دٌۭ ۖ فَ</>هَلْ أَ<k>نتُ</><y>م مُّ</>سْلِ<p>مُو</>نَ"},{"n":109,"w":[["فَإِن","fa-in","But if","তবে যদি"],["تَوَلَّوْا۟","tawallaw","they turn away","তারা মুখ ফিরায়"],["فَقُلْ","faqul","then say","তাহ'লে বলো"],["ءَاذَنتُكُمْ","ādhantukum","I (have) announced to you","\"তোমাদের আমি সতর্ক করে দিয়েছি"],["عَلَىٰ","‘alā","equally","ভাবে"],["سَوَآءٍۢ ۖ","sawāin","equally","সমান (সকলকে)"],["وَإِنْ","wa-in","And not","এবং না"],["أَدْرِىٓ","adrī","I know","জানি আমি"],["أَقَرِيبٌ","aqarībun","whether is near","(ক্বিয়ামাত) কি নিকটে"],["أَم","am","or","বা"],["بَعِيدٌۭ","ba‘īdun","far","দূরে"],["مَّا","mā","what","যা"],["تُوعَدُونَ","tū‘adūna","you are promised","তোমাদেরকে প্রতিশ্রুতি দেয়া হয়েছে"]],"t":"فَإِ<k>ن تَ</>وَلَّوْ<s>ا۟</> فَقُلْ ءَاذَ<k>نتُ</>كُمْ عَلَىٰ سَ<o>وَآ</><d>ءٍۢ ۖ وَ</>إِنْ أَ<q>دْ</><o>رِىٓ</> أَقَرِيبٌ <f>أَم بَ</>عِي<d>دٌۭ مَّ</>ا تُوعَ<p>دُو</>نَ"},{"n":110,"w":[["إِنَّهُۥ","innahu","Indeed, He","নিশ্চয়ই তিনি (অর্থাৎ আল্লাহ)"],["يَعْلَمُ","ya‘lamu","knows","জানেন"],["ٱلْجَهْرَ","l-jahra","the declared","ব্যক্ত হয় (যা)"],["مِنَ","mina","[of]","মাধ্যমে"],["ٱلْقَوْلِ","l-qawli","[the] speech","কথার"],["وَيَعْلَمُ","waya‘lamu","and He knows","তিনিই জানেন"],["مَا","mā","what","যা"],["تَكْتُمُونَ","taktumūna","you conceal","তোমরা গোপন করো"]],"t":"إِ<g>نَّ</>هُ<m>ۥ</> يَعْلَمُ <h>ٱ</>لْجَهْرَ مِنَ <h>ٱ</>لْقَوْلِ وَيَعْلَمُ مَا تَكْتُ<p>مُو</>نَ"},{"n":111,"w":[["وَإِنْ","wa-in","And not","এবং না"],["أَدْرِى","adrī","I know","আমি জানি (এছাড়া যে)"],["لَعَلَّهُۥ","la‘allahu","perhaps it may be","সেটা হয়তো"],["فِتْنَةٌۭ","fit'natun","a trial","পরীক্ষা"],["لَّكُمْ","lakum","for you","তোমাদের জন্যে"],["وَمَتَـٰعٌ","wamatā‘un","and an enjoyment","ও জীবনোপভোগের (অবকাশ)"],["إِلَىٰ","ilā","for","পর্যন্ত"],["حِينٍۢ","ḥīnin","a time","কিছুকাল\""]],"t":"وَإِنْ أَ<q>دْ</>رِى لَعَلَّهُ<m>ۥ</> فِتْنَ<w>ةٌۭ لَّ</>كُمْ وَمَ<m>تَٰ</>عٌ إِلَىٰ <p>حِي</>نٍۢ"},{"n":112,"w":[["قَـٰلَ","qāla","He said","(শেষ পর্যন্ত রাসূল) বললো"],["رَبِّ","rabbi","My Lord","\"হে আমার রব"],["ٱحْكُم","uḥ'kum","judge","তুমি বিচার করে দাও"],["بِٱلْحَقِّ ۗ","bil-ḥaqi","in truth","ভাবে ন্যায়"],["وَرَبُّنَا","warabbunā","And our Lord","এবং আমাদের রব"],["ٱلرَّحْمَـٰنُ","l-raḥmānu","(is) the Most Gracious","দয়াময়"],["ٱلْمُسْتَعَانُ","l-mus'ta‘ānu","the One Whose help is sought","সহায়স্থল"],["عَلَىٰ","‘alā","against","উপর"],["مَا","mā","what","যা"],["تَصِفُونَ","taṣifūna","you attribute","তোমরা বলছো\""]],"t":"<m>قَٰ</>لَ رَبِّ <h>ٱ</>حْ<f>كُم بِ</><h>ٱ</>لْحَقِّ ۗ وَرَبُّنَا <h>ٱ</><l>ل</>رَّحْ<m>مَٰ</>نُ <h>ٱ</>لْمُسْتَعَانُ عَلَىٰ مَا تَصِ<p>فُو</>نَ"}]}