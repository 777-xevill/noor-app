# Copy to .env.local and fill in to switch on accounts and cloud sync (Supabase → Project Settings → API).
# The anon (publishable) key is meant to ship inside the app; row-level security protects the data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Noor Plus (RevenueCat → Project → API keys → public app-specific keys). Entitlement id: "plus".
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Where site/ is hosted (for the Privacy and Terms links), e.g. https://noor.example
EXPO_PUBLIC_SITE_URL=
