{
  "expo": {
    "name": "Noor",
    "slug": "noor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xevill.noor"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6EAEE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.xevill.noor"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      "expo-audio",
      "expo-localization",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/adhan.wav"
          ]
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.xevill.noor.widgets",
          "groupIdentifier": "group.com.xevill.noor",
          "widgets": [
            {
              "name": "PrayerTimes",
              "displayName": "Prayer times",
              "description": "The next prayer, a live countdown and today’s times.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/geist/400Regular/Geist_400Regular.ttf",
            "./node_modules/@expo-google-fonts/geist/500Medium/Geist_500Medium.ttf",
            "./node_modules/@expo-google-fonts/geist/600SemiBold/Geist_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/hind-siliguri/400Regular/HindSiliguri_400Regular.ttf",
            "./node_modules/@expo-google-fonts/hind-siliguri/500Medium/HindSiliguri_500Medium.ttf",
            "./node_modules/@expo-google-fonts/hind-siliguri/600SemiBold/HindSiliguri_600SemiBold.ttf"
          ],
          "widgets": [
            {
              "name": "PrayerTimes",
              "label": "Prayer times",
              "description": "The next prayer and today’s times",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "scheme": "noor",
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    }
  }
}
